[{"id":"weijin:1664","title":"还京诗","author":"魏晋 · 石崇","collection":"魏晋诗","notice":"","excerpt":"迅风翼华盖，飘遥若鸿飞。","body":{"start":1604,"hash":"46fdb2f0fd9dfecfdb8996baef30d2386c45c93d0b6936599f211e74b91d7d70"}},{"id":"weijin:1665","title":"懊侬歌","author":"魏晋 · 绿珠","collection":"魏晋诗","notice":"","excerpt":"丝布涩难缝，令侬十指穿。","body":0},{"id":"weijin:1666","title":"怨诗","author":"魏晋 · 翾风","collection":"魏晋诗","notice":"","excerpt":"春华谁不美，卒伤秋落时。","body":0},{"id":"weijin:1667","title":"答石崇赠诗","author":"魏晋 · 欧阳建","collection":"魏晋诗","notice":"","excerpt":"于铄我舅，明德塞违。","body":0},{"id":"weijin:1668","title":"临终诗","author":"魏晋 · 欧阳建","collection":"魏晋诗","notice":"","excerpt":"伯阳适西戎，孔子欲居蛮。","body":0},{"id":"weijin:1669","title":"洛水祖王公应诏诗","author":"魏晋 · 何劭","collection":"魏晋诗","notice":"","excerpt":"穆穆圣王，体此慈仁。","body":0},{"id":"weijin:1670","title":"赠张华诗","author":"魏晋 · 何劭","collection":"魏晋诗","notice":"","excerpt":"四时更代谢，悬象迭卷舒。","body":0},{"id":"weijin:1671","title":"游仙诗","author":"魏晋 · 何劭","collection":"魏晋诗","notice":"","excerpt":"青青陵上松。","body":0},{"id":"weijin:1672","title":"杂诗","author":"魏晋 · 何劭","collection":"魏晋诗","notice":"","excerpt":"秋风乘夕起，明月照高树。","body":0},{"id":"weijin:1673","title":"诗","author":"魏晋 · 何劭","collection":"魏晋诗","notice":"","excerpt":"亮无风云会。","body":0},{"id":"weijin:1674","title":"招隐诗二首 其二","author":"魏晋 · 陆机","collection":"魏晋诗","notice":"","excerpt":"寻山求逸民，穹谷幽且遐。","body":0},{"id":"weijin:1675","title":"答陆士衡诗","author":"魏晋 · 夏靖","collection":"魏晋诗","notice":"","excerpt":"大哉乾元，万品资生。","body":0},{"id":"weijin:1676","title":"答陆机诗","author":"魏晋 · 顾秘","collection":"魏晋诗","notice":"","excerpt":"恢恢太素，万物初基。","body":0},{"id":"weijin:1677","title":"答陆机诗","author":"魏晋 · 崔寔","collection":"魏晋诗","notice":"","excerpt":"栖息高丘。","body":0},{"id":"weijin:1678","title":"赠顾骠骑诗二首·思文 其二","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"文王在上，太姒思齐。","body":0},{"id":"weijin:1679","title":"赠顾骠骑诗二首·思文 其三","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"在虞之胄，实惟有姚。","body":0},{"id":"weijin:1680","title":"赠顾骠骑诗二首·思文 其四","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"其德伊何，和贞虔告。","body":0},{"id":"weijin:1681","title":"赠顾骠骑诗二首·思文 其五","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"羔羊执贽，玉帛有辉。","body":0},{"id":"weijin:1682","title":"赠顾骠骑诗二首·思文 其六","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"既曰归止，式扬好音。","body":0},{"id":"weijin:1683","title":"赠顾骠骑诗二首·思文 其七","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"昔周之隆，有任有姒。","body":0},{"id":"weijin:1684","title":"赠顾彦先 其一","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"玄黄挺秀，诞受至真。","body":0},{"id":"weijin:1685","title":"赠顾彦先 其二","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"皇皇明哲，应期继声。","body":0},{"id":"weijin:1686","title":"赠顾彦先 其三","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"悠悠山川，骁骁征遐。","body":0},{"id":"weijin:1687","title":"赠顾彦先 其四","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"邂逅相遇，良愿乃从。","body":0},{"id":"weijin:1688","title":"赠顾彦先 其五","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"幽幽东嵎，恋彼西归。","body":0},{"id":"weijin:1689","title":"失题","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"思乐芳林，言采其菊。","body":0},{"id":"weijin:1690","title":"为顾彦先赠妇往返诗四首 其二","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"悠悠君行迈，茕茕妾独止。","body":{"start":1690,"hash":"9b9b2dd11059103e0a47cad67f9683c823dd56deef5cf70ef043c72eb1306924"}},{"id":"weijin:1691","title":"为顾彦先赠妇往返诗四首 其三","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"翩翩飞蓬征，郁郁寒木荣。","body":26},{"id":"weijin:1692","title":"为顾彦先赠妇往返诗四首 其四","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"浮海难为水，游林难为观。","body":26},{"id":"weijin:1693","title":"芙蓉诗 其二","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"寝共织成被，絮以同攻绵。","body":26},{"id":"weijin:1694","title":"芙蓉诗 其三","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"夏摇比翼扇。","body":26},{"id":"weijin:1695","title":"芙蓉诗 其四","author":"魏晋 · 陆云","collection":"魏晋诗","notice":"","excerpt":"衣用双绢，寝无绛帱。","body":26},{"id":"weijin:1696","title":"答陆士龙诗四首·鸳鸯 其一","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"鸳鸯于飞，在江之浚。","body":26},{"id":"weijin:1697","title":"答陆士龙诗四首·鸳鸯 其二","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"鸳鸯于飞，载飞载吟。","body":26},{"id":"weijin:1698","title":"答陆士龙诗四首·鸳鸯 其三","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"鸳鸯于飞，乘云高翔。","body":26},{"id":"weijin:1699","title":"答陆士龙诗四首·鸳鸯 其四","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"鸳鸯于飞，或矫或游。","body":26},{"id":"weijin:1700","title":"答陆士龙诗四首·鸳鸯 其五","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"鸳鸯于飞，载和其鸣。","body":26},{"id":"weijin:1701","title":"答陆士龙诗四首·兰林","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"瞻彼兰林，有翘其秀。","body":26},{"id":"weijin:1702","title":"答陆士龙诗四首·南山","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"陟彼南山，言采其萧。","body":26},{"id":"weijin:1703","title":"答陆士龙诗四首·中陵","author":"魏晋 · 郑丰","collection":"魏晋诗","notice":"","excerpt":"瞻彼中陵，兰蕙猗猗。","body":26},{"id":"weijin:1704","title":"赠陆士龙诗","author":"魏晋 · 孙拯","collection":"魏晋诗","notice":"","excerpt":"五龙戢号，云鸟纂纪。","body":26},{"id":"weijin:1705","title":"赠石季伦诗","author":"魏晋 · 嵇绍","collection":"魏晋诗","notice":"","excerpt":"人生禀五常，中和为至德。","body":26},{"id":"weijin:1706","title":"悦晴诗","author":"魏晋 · 嵇含","collection":"魏晋诗","notice":"","excerpt":"劲风归巽林，玄云起重基。","body":26},{"id":"weijin:1707","title":"伉俪诗","author":"魏晋 · 嵇含","collection":"魏晋诗","notice":"","excerpt":"余执百两辔，之子咏采蘩。","body":26},{"id":"weijin:1708","title":"登高诗","author":"魏晋 · 嵇含","collection":"魏晋诗","notice":"","excerpt":"七月有七日，蠢动思登高。","body":26},{"id":"weijin:1709","title":"台中宴会诗","author":"魏晋 · 嵇含","collection":"魏晋诗","notice":"","excerpt":"殿中曰□□□□。","body":26},{"id":"weijin:1710","title":"宴曜武堂诗","author":"魏晋 · 牵秀","collection":"魏晋诗","notice":"","excerpt":"沐浴洪流，饮服清芳。","body":26},{"id":"weijin:1711","title":"祖孙楚诗","author":"魏晋 · 牵秀","collection":"魏晋诗","notice":"","excerpt":"受兹明命，作守西疆。","body":26},{"id":"weijin:1712","title":"四言诗","author":"魏晋 · 牵秀","collection":"魏晋诗","notice":"","excerpt":"乾道辅仁，坤德尚冲。","body":26},{"id":"weijin:1713","title":"诗","author":"魏晋 · 牵秀","collection":"魏晋诗","notice":"","excerpt":"高宗梦岩穴，姬文兆渭滨。","body":26},{"id":"weijin:1714","title":"赠山涛诗","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"苕苕椅桐树，寄生于南岳。","body":26},{"id":"weijin:1715","title":"赠山涛诗","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"翩翩野青雀，受性孤且微。","body":26},{"id":"weijin:1716","title":"诗","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"百草应节生，含气有深浅。","body":26},{"id":"weijin:1717","title":"诗 其一","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"玉出阆风侧，珠生南海滨。","body":26},{"id":"weijin:1718","title":"诗 其二","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"烈烈玄飙起，粲粲繁霜凝。","body":26},{"id":"weijin:1719","title":"诗 其三","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"秋节良可悲，百华咸萎落。","body":26},{"id":"weijin:1720","title":"诗 其四","author":"魏晋 · 司马彪","collection":"魏晋诗","notice":"","excerpt":"左揽又翠羁，右抚犀象鞍。","body":26},{"id":"weijin:1721","title":"上巳会诗","author":"魏晋 · 阮修","collection":"魏晋诗","notice":"","excerpt":"三春之季，岁惟嘉时。","body":26},{"id":"weijin:1722","title":"感离诗","author":"魏晋 · 左芬","collection":"魏晋诗","notice":"","excerpt":"自我去膝下，倏忽逾再期。","body":26},{"id":"weijin:1723","title":"赠张弋阳诗","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"时道玄旷，阶轨难寻。","body":26},{"id":"weijin:1724","title":"周小史诗","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"翩翩周生，婉娈幼童。","body":26},{"id":"weijin:1725","title":"杂诗三首 其一","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"暮春和气应，白日照园林。","body":26},{"id":"weijin:1726","title":"杂诗三首 其二","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"东邻有一树，三纪裁可拱。","body":26},{"id":"weijin:1727","title":"杂诗三首 其三","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"忽有一飞鸟，五杂英华华。","body":26},{"id":"weijin:1728","title":"思吴江歌","author":"魏晋 · 张翰","collection":"魏晋诗","notice":"","excerpt":"秋风起兮佳景时。","body":26},{"id":"weijin:1729","title":"赠司隶傅咸诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"皇灵阐曜，流英敷醇。","body":26},{"id":"weijin:1730","title":"诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"太谷石榴，木滋之最。","body":26},{"id":"weijin:1731","title":"登成都白菟楼诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"重城结曲阿，飞宇起层楼。","body":26},{"id":"weijin:1732","title":"赠虞显度诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"畴昔协兰芳，缱绻在华年。","body":26},{"id":"weijin:1733","title":"招隐诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"出处虽殊途，居然有轻易。","body":26},{"id":"weijin:1734","title":"七哀诗二首 其一","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"北芒何垒垒。","body":26},{"id":"weijin:1735","title":"七哀诗二首 其二","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"秋风吐商气，萧瑟扫前林。","body":26},{"id":"weijin:1736","title":"霖雨诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"霏雨馀旬朔，濛昧日夜坠。","body":26},{"id":"weijin:1737","title":"拟四愁诗四首 其一","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"我所思兮在南巢，欲往从之巫山高。","body":26},{"id":"weijin:1738","title":"拟四愁诗四首 其二","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"我所思兮在朔湄，欲往从之白雪霏。","body":26},{"id":"weijin:1739","title":"拟四愁诗四首 其三","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"我所思兮在陇原。","body":26},{"id":"weijin:1740","title":"拟四愁诗四首 其四","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"我所思兮在营州，欲往从之路阻修。","body":26},{"id":"weijin:1741","title":"述怀诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"跋涉山川，千里告辞。","body":26},{"id":"weijin:1742","title":"诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"灵象运天机，日月如激电。","body":26},{"id":"weijin:1743","title":"诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"白日随天回，皦皦圆如规。","body":26},{"id":"weijin:1744","title":"诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"气力渐衰损，鬓发终以皓。","body":26},{"id":"weijin:1745","title":"送钟参军诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"善见理不拔，阐道播徽容。","body":26},{"id":"weijin:1746","title":"赠棘子琰诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"輶车运在轮，飞骨须六翮。","body":26},{"id":"weijin:1747","title":"泛湖诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"春菰芽露碧，水荇叶连青。","body":26},{"id":"weijin:1748","title":"登台诗","author":"魏晋 · 张载","collection":"魏晋诗","notice":"","excerpt":"远望涕泗流。","body":26},{"id":"weijin:1749","title":"咏史","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"昔在西京时，朝野多欢娱。","body":26},{"id":"weijin:1750","title":"杂诗十首 其二","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"大火流坤维，白日驰西陆。","body":26},{"id":"weijin:1751","title":"杂诗十首 其三","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"金风扇素节，丹霞启阴期。","body":26},{"id":"weijin:1752","title":"杂诗十首 其五","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"昔我资章甫，聊以适诸越。","body":26},{"id":"weijin:1753","title":"杂诗十首 其六","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"朝登鲁阳关，狭路峭且深。","body":26},{"id":"weijin:1754","title":"杂诗十首 其七","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"此乡非吾地，此郭非吾城。","body":26},{"id":"weijin:1755","title":"杂诗十首 其八","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"述职投边城，羁束戎旅间。","body":26},{"id":"weijin:1756","title":"杂诗十首 其九","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"结宇穷冈曲，耦耕幽薮阴。","body":26},{"id":"weijin:1757","title":"杂诗十首 其十","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"墨蜧跃重渊，商羊舞野庭。","body":26},{"id":"weijin:1758","title":"杂诗","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"太昊启东节，春郊礼青祗。","body":26},{"id":"weijin:1759","title":"游仙诗","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"峥嵘玄圃深，嵯峨天岭峭。","body":26},{"id":"weijin:1760","title":"诗","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"天气清和，野有甘瓜。","body":26},{"id":"weijin:1761","title":"采菱鸿","author":"魏晋 · 张协","collection":"魏晋诗","notice":"","excerpt":"乘鹢舟兮为水嬉。","body":26},{"id":"weijin:1762","title":"三月三日应诏诗二首 其一","author":"魏晋 · 闾丘冲","collection":"魏晋诗","notice":"","excerpt":"暮春之月，春服既成。","body":26},{"id":"weijin:1763","title":"三月三日应诏诗二首 其二","author":"魏晋 · 闾丘冲","collection":"魏晋诗","notice":"","excerpt":"浩浩白水，泛泛龙舟。","body":26},{"id":"weijin:1764","title":"招隐诗","author":"魏晋 · 闾丘冲","collection":"魏晋诗","notice":"","excerpt":"大道旷且夷，蹊路安足寻。","body":26},{"id":"weijin:1765","title":"赠挚仲洽诗","author":"魏晋 · 杜育","collection":"魏晋诗","notice":"","excerpt":"之子于归，言秣其驹。","body":26},{"id":"weijin:1766","title":"金谷诗","author":"魏晋 · 杜育","collection":"魏晋诗","notice":"","excerpt":"既而慨而，感此离析。","body":26},{"id":"weijin:1767","title":"诗","author":"魏晋 · 杜育","collection":"魏晋诗","notice":"","excerpt":"临下览群动。","body":26},{"id":"weijin:1768","title":"答伏武仲诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"崇山栖凤，广泉含螭。","body":26},{"id":"weijin:1769","title":"赠褚武良以尚书出为安东诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"荡荡大晋，奄有八荒。","body":26},{"id":"weijin:1770","title":"赠李叔龙以尚书郎迁建平太守诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"我有良朋，时惟李生。","body":26},{"id":"weijin:1771","title":"答杜育诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"越有杜生，既文且哲。","body":26},{"id":"weijin:1772","title":"雍州诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"于皇先王，经启九有。","body":26},{"id":"weijin:1773","title":"逸骥诗","author":"魏晋 · 挚虞","collection":"魏晋诗","notice":"","excerpt":"逸骥无镳辔，胜陆从长川。","body":26},{"id":"weijin:1774","title":"三月三日诗","author":"魏晋 · 王赞","collection":"魏晋诗","notice":"","excerpt":"招摇启运，寒暑代新。","body":26},{"id":"weijin:1775","title":"侍皇太子宴始平王诗","author":"魏晋 · 王赞","collection":"魏晋诗","notice":"","excerpt":"亹亹圣胤，继明重体。","body":26},{"id":"weijin:1776","title":"侍皇太子祖道楚淮南二王诗","author":"魏晋 · 王赞","collection":"魏晋诗","notice":"","excerpt":"于明圣晋，仰统天绪。","body":26},{"id":"weijin:1777","title":"皇太子会诗","author":"魏晋 · 王赞","collection":"魏晋诗","notice":"","excerpt":"玄阴受谢，青阳启号。","body":26},{"id":"weijin:1778","title":"杂诗","author":"魏晋 · 王赞","collection":"魏晋诗","notice":"","excerpt":"朔风动秋草，边马有归心。","body":26},{"id":"weijin:1779","title":"献长安君安仁诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"峨峨嵩岳，有岩其峻。","body":26},{"id":"weijin:1780","title":"赠司空掾安仁诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"桓桓上宰，穆穆四门。","body":{"start":1780,"hash":"61ba999850aea547b4830750806bd92fcaa21826d378ab6c46992ca21f92616e"}},{"id":"weijin:1781","title":"赠陆机出为吴王郎中令诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"东南之美，曩惟延州。","body":116},{"id":"weijin:1782","title":"答陆士衡诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"顾兹蓬蔚，厕根兰陂。","body":116},{"id":"weijin:1783","title":"答傅咸诗并序","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"悠悠群吏，非子不整。","body":116},{"id":"weijin:1784","title":"七月七日侍皇太子宴玄圃园诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"商风初授，辰火微流。","body":116},{"id":"weijin:1785","title":"上巳日帝会天渊池诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"青春暮月，六气和理。","body":116},{"id":"weijin:1786","title":"皇太子上巳日诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"玉衡连极，招摇指辰。","body":116},{"id":"weijin:1787","title":"巳日诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"霭霭疏圃，载繁载荣。","body":116},{"id":"weijin:1788","title":"释奠诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"敦书请业，研几通理。","body":116},{"id":"weijin:1789","title":"诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"八珍代羞，六饭迭举。","body":116},{"id":"weijin:1790","title":"皇太子集应令诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"圣朝命方岳，爪牙司北邻。","body":116},{"id":"weijin:1791","title":"皇太子社诗","author":"魏晋 · 潘尼","collection":"魏晋诗","notice":"","excerpt":"太簇协青阳，履端发岁首。","body":116}]