[{"id":"song-era:82560","title":"题华山","author":"邵雍","collection":"宋","notice":"","excerpt":"域中有五岳，国家谨时祀。","body":{"start":82505,"hash":"e9cb964025a3af05161bef8c70dd35b4e8c5b1321b86c8c6cc966664324b3ebb"}},{"id":"song-era:82561","title":"题范忠献公真","author":"邵雍","collection":"宋","notice":"","excerpt":"范邵居洛阳，希夷居华山。","body":0},{"id":"song-era:82562","title":"燕堂闲坐","author":"邵雍","collection":"宋","notice":"","excerpt":"天网疏难漏，世网密莫通。","body":0},{"id":"song-era:82563","title":"燕堂暑饮","author":"邵雍","collection":"宋","notice":"","excerpt":"燕堂通高明，檐依断崖嵚。","body":0},{"id":"song-era:82564","title":"赠富公","author":"邵雍","collection":"宋","notice":"","excerpt":"天下系休戚，世间谁拟伦。","body":0},{"id":"song-era:82565","title":"辩谤吟","author":"邵雍","collection":"宋","notice":"","excerpt":"田丹功盖国，貂勃语回君。","body":0},{"id":"song-era:82566","title":"辩熊耳","author":"邵雍","collection":"宋","notice":"","excerpt":"昔禹别九州，导洛自熊耳。","body":0},{"id":"song-era:82567","title":"臂痛吟","author":"邵雍","collection":"宋","notice":"","excerpt":"先苦头风已病躯，新添臂痛又何如。","body":0},{"id":"song-era:82568","title":"霜露吟","author":"邵雍","collection":"宋","notice":"","excerpt":"天地有润泽，其降也瀼瀼。","body":0},{"id":"song-era:82569","title":"瞻礼孔子吟","author":"邵雍","collection":"宋","notice":"","excerpt":"执卷何人不读书，能知性者又何如。","body":0},{"id":"song-era:82570","title":"曝书吟","author":"邵雍","collection":"宋","notice":"","excerpt":"虫蠹书害少，人蠹书害多。","body":0},{"id":"song-era:82571","title":"蠹书鱼","author":"邵雍","collection":"宋","notice":"","excerpt":"形状类于鱼，其心好蠹书。","body":0},{"id":"song-era:82572","title":"一言感人","author":"邵雍","collection":"宋","notice":"","excerpt":"为女不嫁，为士不官，齐人一言，田子辞焉。","body":0},{"id":"song-era:82573","title":"丁宁吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人无忽略，事贵丁宁。","body":{"start":82573,"hash":"1884d56a19a6a9b78d1b1d005091797368c92851a5b026c0f9e694696b02e03a"}},{"id":"song-era:82574","title":"二说吟","author":"邵雍","collection":"宋","notice":"","excerpt":"治不变俗，教不易民。","body":13},{"id":"song-era:82575","title":"人事吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人有去就，事无低昂；迹有疏密，人无较量。","body":13},{"id":"song-era:82576","title":"人事吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人无取次，事莫因循。","body":13},{"id":"song-era:82577","title":"人情吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人达人情，无寡无广。","body":13},{"id":"song-era:82578","title":"力外吟","author":"邵雍","collection":"宋","notice":"","excerpt":"以少为多，以无为有。","body":13},{"id":"song-era:82579","title":"力穑吟","author":"邵雍","collection":"宋","notice":"","excerpt":"春时耕种，夏时耘耨。","body":13},{"id":"song-era:82580","title":"上下吟","author":"邵雍","collection":"宋","notice":"","excerpt":"自下观上，无限富贵。","body":13},{"id":"song-era:82581","title":"久旱吟","author":"邵雍","collection":"宋","notice":"","excerpt":"久旱望雨，久雨思晴。","body":13},{"id":"song-era:82582","title":"天时吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人作者事，天命者时。","body":13},{"id":"song-era:82583","title":"义利吟","author":"邵雍","collection":"宋","notice":"","excerpt":"意不若义，义不若利。","body":13},{"id":"song-era:82584","title":"义利吟","author":"邵雍","collection":"宋","notice":"","excerpt":"贲于丘园，束帛戋戋。","body":13},{"id":"song-era:82585","title":"义利吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子尚义，小人尚利。","body":13},{"id":"song-era:82586","title":"土木偶人","author":"邵雍","collection":"宋","notice":"","excerpt":"土木偶人，慎无相笑。","body":13},{"id":"song-era:82587","title":"大易吟","author":"邵雍","collection":"宋","notice":"","excerpt":"天地定位，否泰反类。","body":13},{"id":"song-era:82588","title":"大笔吟","author":"邵雍","collection":"宋","notice":"","excerpt":"有客无知，为性太质。","body":13},{"id":"song-era:82589","title":"小人吟","author":"邵雍","collection":"宋","notice":"","excerpt":"小人无耻，重利轻死。","body":13},{"id":"song-era:82590","title":"小人吟","author":"邵雍","collection":"宋","notice":"","excerpt":"小人无节，弃本逐末。","body":13},{"id":"song-era:82591","title":"小车吟","author":"邵雍","collection":"宋","notice":"","excerpt":"有客无知，唯知有家。","body":13},{"id":"song-era:82592","title":"小道吟","author":"邵雍","collection":"宋","notice":"","excerpt":"艺虽小道，事亦系人。","body":13},{"id":"song-era:82593","title":"不再吟","author":"邵雍","collection":"宋","notice":"","excerpt":"春无再至，花无再开。","body":13},{"id":"song-era:82594","title":"不同吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子之人，与己非比。","body":13},{"id":"song-era:82595","title":"不同吟","author":"邵雍","collection":"宋","notice":"","excerpt":"求者不得，辞者不能。","body":13},{"id":"song-era:82596","title":"不肖吟","author":"邵雍","collection":"宋","notice":"","excerpt":"不肖之人，志在游荡。","body":13},{"id":"song-era:82597","title":"不知吟","author":"邵雍","collection":"宋","notice":"","excerpt":"不知阴阳，不知天地。","body":13},{"id":"song-era:82598","title":"不善吟","author":"邵雍","collection":"宋","notice":"","excerpt":"不良之人，禀气非正。","body":13},{"id":"song-era:82599","title":"中原吟","author":"邵雍","collection":"宋","notice":"","excerpt":"中原之师，仁义为主。","body":13},{"id":"song-era:82600","title":"书亡弟殡所","author":"邵雍","collection":"宋","notice":"","excerpt":"后乎吾来，先乎吾往。","body":13},{"id":"song-era:82601","title":"六得吟","author":"邵雍","collection":"宋","notice":"","excerpt":"眼能识得，耳能听得，口能道得，手能做得，身能行得，心能放得。","body":13},{"id":"song-era:82602","title":"内外吟 其一","author":"邵雍","collection":"宋","notice":"","excerpt":"衣冠严整，谓之外修。","body":13},{"id":"song-era:82603","title":"内外吟 其二","author":"邵雍","collection":"宋","notice":"","excerpt":"衣冠不整，谓之外惰。","body":13},{"id":"song-era:82604","title":"内外吟","author":"邵雍","collection":"宋","notice":"","excerpt":"目耳鼻口，人之户牖。","body":13},{"id":"song-era:82605","title":"天人吟","author":"邵雍","collection":"宋","notice":"","excerpt":"天学修心，人学修身。","body":13},{"id":"song-era:82606","title":"天命吟","author":"邵雍","collection":"宋","notice":"","excerpt":"可委者命，可凭者天。","body":13},{"id":"song-era:82607","title":"心迹吟","author":"邵雍","collection":"宋","notice":"","excerpt":"圣人了心，贤人了迹。","body":13},{"id":"song-era:82608","title":"文武吟","author":"邵雍","collection":"宋","notice":"","excerpt":"既为文士，必有武备。","body":13},{"id":"song-era:82609","title":"无妄吟","author":"邵雍","collection":"宋","notice":"","excerpt":"耳无妄听，目无妄顾，口无妄言，心无妄虑。","body":13},{"id":"song-era:82610","title":"无疾吟","author":"邵雍","collection":"宋","notice":"","excerpt":"无疾之安，无灾之福。","body":13},{"id":"song-era:82611","title":"无腼吟","author":"邵雍","collection":"宋","notice":"","excerpt":"事曾经见，物曾持鍊。","body":13},{"id":"song-era:82612","title":"水旱吟 其一","author":"邵雍","collection":"宋","notice":"","excerpt":"尧水九年，汤旱七载。","body":13},{"id":"song-era:82613","title":"水旱吟 其二","author":"邵雍","collection":"宋","notice":"","excerpt":"九年洪水，七年大旱。","body":13},{"id":"song-era:82614","title":"王公吟","author":"邵雍","collection":"宋","notice":"","excerpt":"王公大人，天下具瞻；轻流薄习，重损威严。","body":13},{"id":"song-era:82615","title":"见义吟","author":"邵雍","collection":"宋","notice":"","excerpt":"见善必为，不见则已。","body":13},{"id":"song-era:82616","title":"去事吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子去事，民有馀祥。","body":13},{"id":"song-era:82617","title":"四不可吟","author":"邵雍","collection":"宋","notice":"","excerpt":"言不可妄，行不可隳。","body":13},{"id":"song-era:82618","title":"四公子吟","author":"邵雍","collection":"宋","notice":"","excerpt":"时去三王，事归五霸。","body":13},{"id":"song-era:82619","title":"四可吟","author":"邵雍","collection":"宋","notice":"","excerpt":"可勉者行，可信者言。","body":13},{"id":"song-era:82620","title":"四者吟","author":"邵雍","collection":"宋","notice":"","excerpt":"财色名势，为世所亲。","body":13},{"id":"song-era:82621","title":"处身吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子处身，宁人负己，己无负人。","body":13},{"id":"song-era:82622","title":"正性吟","author":"邵雍","collection":"宋","notice":"","excerpt":"未生之前，不知其然。","body":13},{"id":"song-era:82623","title":"民情吟","author":"邵雍","collection":"宋","notice":"","excerpt":"民情既乐，和气为祥。","body":13},{"id":"song-era:82624","title":"由听吟","author":"邵雍","collection":"宋","notice":"","excerpt":"由听而失，以听为宾。","body":13},{"id":"song-era:82625","title":"名实吟","author":"邵雍","collection":"宋","notice":"","excerpt":"内无是实，外有是名，小人故矜。","body":13},{"id":"song-era:82626","title":"多多吟","author":"邵雍","collection":"宋","notice":"","excerpt":"天下居常，害多于利。","body":13},{"id":"song-era:82627","title":"多事吟","author":"邵雍","collection":"宋","notice":"","excerpt":"多事招忧，多疑招闷。","body":13},{"id":"song-era:82628","title":"好胜吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人无好胜，事无过求。","body":13},{"id":"song-era:82629","title":"好恶吟","author":"邵雍","collection":"宋","notice":"","excerpt":"恶死好生，去害就利。","body":13},{"id":"song-era:82630","title":"安分吟","author":"邵雍","collection":"宋","notice":"","excerpt":"轻得易失，多谋少成。","body":13},{"id":"song-era:82631","title":"安乐吟","author":"邵雍","collection":"宋","notice":"","excerpt":"安乐先生，不显姓氏。","body":13},{"id":"song-era:82632","title":"师资吟","author":"邵雍","collection":"宋","notice":"","excerpt":"未知道义，寻人为师。","body":13},{"id":"song-era:82633","title":"当断吟","author":"邵雍","collection":"宋","notice":"","excerpt":"断以决疑，疑不可缓。","body":13},{"id":"song-era:82634","title":"成性吟","author":"邵雍","collection":"宋","notice":"","excerpt":"成性存存，用志不分。","body":13},{"id":"song-era:82635","title":"有时吟","author":"邵雍","collection":"宋","notice":"","excerpt":"龙不冬跃，萤能夜飞。","body":13},{"id":"song-era:82636","title":"有病吟","author":"邵雍","collection":"宋","notice":"","excerpt":"身之有病，当求药医；药之非良，其身必亏。","body":13},{"id":"song-era:82637","title":"欢喜吟","author":"邵雍","collection":"宋","notice":"","excerpt":"日往月来，终则有始。","body":13},{"id":"song-era:82638","title":"自作真赞","author":"邵雍","collection":"宋","notice":"","excerpt":"松桂操行，莺花文才。","body":13},{"id":"song-era:82639","title":"自适吟","author":"邵雍","collection":"宋","notice":"","excerpt":"郏鄏城中，凤凰楼下；风月庭除，莺花台榭。","body":13},{"id":"song-era:82640","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"一气才分，两仪已备。","body":13},{"id":"song-era:82641","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"画工状物，经月经年。","body":13},{"id":"song-era:82642","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"居暗观明，居静观动。","body":13},{"id":"song-era:82643","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"物不两盛，事难独行。","body":13},{"id":"song-era:82644","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"如鸾如凤，意思安详。","body":13},{"id":"song-era:82645","title":"观物吟","author":"邵雍","collection":"宋","notice":"","excerpt":"时有代谢，物有枯荣。","body":13},{"id":"song-era:82646","title":"邪正吟","author":"邵雍","collection":"宋","notice":"","excerpt":"贤人好正，奸人好邪。","body":13},{"id":"song-era:82647","title":"利害吟","author":"邵雍","collection":"宋","notice":"","excerpt":"兔犬俱毙，蚌鹬相持。","body":13},{"id":"song-era:82648","title":"君子吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子与义，小人与利；与义日兴，与利日废。","body":13},{"id":"song-era:82649","title":"君子吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子之去，亦如其来。","body":{"start":82649,"hash":"be93a0fbd71a9305d73fe9a3affaeac6a0f16bc72b339540ea781db91f42474b"}},{"id":"song-era:82650","title":"君子饮酒吟","author":"邵雍","collection":"宋","notice":"","excerpt":"父慈子孝，兄友弟恭。","body":89},{"id":"song-era:82651","title":"听天吟","author":"邵雍","collection":"宋","notice":"","excerpt":"上天生我，上天死我。","body":89},{"id":"song-era:82652","title":"应龙吟","author":"邵雍","collection":"宋","notice":"","excerpt":"龙者阳类，与时相须。","body":89},{"id":"song-era:82653","title":"忧梦吟","author":"邵雍","collection":"宋","notice":"","excerpt":"至人无梦，圣人无忧。","body":89},{"id":"song-era:82654","title":"把手吟","author":"邵雍","collection":"宋","notice":"","excerpt":"富贵把手，贫贱掣肘。","body":89},{"id":"song-era:82655","title":"时吟","author":"邵雍","collection":"宋","notice":"","excerpt":"骐骥壮时，千里莫追。","body":89},{"id":"song-era:82656","title":"灾来吟","author":"邵雍","collection":"宋","notice":"","excerpt":"灾自外来，犹可消除。","body":89},{"id":"song-era:82657","title":"忠厚吟","author":"邵雍","collection":"宋","notice":"","excerpt":"小人斯须，君子长久。","body":89},{"id":"song-era:82658","title":"性情吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子任性，小人任情。","body":89},{"id":"song-era:82659","title":"性情吟","author":"邵雍","collection":"宋","notice":"","excerpt":"践形治性，践迹治情。","body":89},{"id":"song-era:82660","title":"所学吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人之所学，本学人事。","body":89},{"id":"song-era:82661","title":"治心吟","author":"邵雍","collection":"宋","notice":"","excerpt":"心亲于身，身亲于人。","body":89},{"id":"song-era:82662","title":"治乱吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子小人，亦常相半。","body":89},{"id":"song-era:82663","title":"治乱吟","author":"邵雍","collection":"宋","notice":"","excerpt":"财利为先，笔舌用事。","body":89},{"id":"song-era:82664","title":"治乱吟五首 其四","author":"邵雍","collection":"宋","notice":"","excerpt":"火能胜水，火不胜水，其火遂灭。","body":89},{"id":"song-era:82665","title":"治乱吟五首 其一","author":"邵雍","collection":"宋","notice":"","excerpt":"乱多于治，害多于利。","body":89},{"id":"song-era:82666","title":"瓮牖吟","author":"邵雍","collection":"宋","notice":"","excerpt":"有客无知，唯知自守。","body":89},{"id":"song-era:82667","title":"经世吟","author":"邵雍","collection":"宋","notice":"","excerpt":"羲轩尧舜，汤武桓文；皇王帝伯，父子君臣。","body":89},{"id":"song-era:82668","title":"诧嗟吟","author":"邵雍","collection":"宋","notice":"","excerpt":"昨日炙手，今日张罗。","body":89},{"id":"song-era:82669","title":"贪义吟","author":"邵雍","collection":"宋","notice":"","excerpt":"贪人之恶，其过莫大。","body":89},{"id":"song-era:82670","title":"幽明吟","author":"邵雍","collection":"宋","notice":"","excerpt":"明有日月，幽有鬼神。","body":89},{"id":"song-era:82671","title":"思省吟","author":"邵雍","collection":"宋","notice":"","excerpt":"仲尼再思，曾子三省。","body":89},{"id":"song-era:82672","title":"思虑吟","author":"邵雍","collection":"宋","notice":"","excerpt":"思虑未起，鬼神莫知。","body":89},{"id":"song-era:82673","title":"是非吟","author":"邵雍","collection":"宋","notice":"","excerpt":"是短非长，好丹非素。","body":89},{"id":"song-era:82674","title":"畏爱吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人有正性，事事皆齐。","body":89},{"id":"song-era:82675","title":"盆池吟","author":"邵雍","collection":"宋","notice":"","excerpt":"有客无知，唯知不为。","body":89},{"id":"song-era:82676","title":"诫子吟","author":"邵雍","collection":"宋","notice":"","excerpt":"鸡能警旦，马能代行。","body":89},{"id":"song-era:82677","title":"贵贱吟","author":"邵雍","collection":"宋","notice":"","excerpt":"系自我者，可以力行。","body":89},{"id":"song-era:82678","title":"费力吟","author":"邵雍","collection":"宋","notice":"","excerpt":"事无巨细，人有得失。","body":89},{"id":"song-era:82679","title":"迷悟吟","author":"邵雍","collection":"宋","notice":"","excerpt":"君子改过，小人饰非。","body":89},{"id":"song-era:82680","title":"家国吟","author":"邵雍","collection":"宋","notice":"","excerpt":"邪正异心，家国同体。","body":89},{"id":"song-era:82681","title":"宽猛吟","author":"邵雍","collection":"宋","notice":"","excerpt":"宽则民慢，猛则民残。","body":89},{"id":"song-era:82682","title":"恩义吟","author":"邵雍","collection":"宋","notice":"","excerpt":"恩深者亲，义重者君。","body":89},{"id":"song-era:82683","title":"恩怨吟","author":"邵雍","collection":"宋","notice":"","excerpt":"人之常情，无重于死。","body":89},{"id":"song-era:82684","title":"能寐吟","author":"邵雍","collection":"宋","notice":"","excerpt":"大惊不寐，大忧不寐，大伤不寐，大病不寐，大喜不寐，大安能寐。","body":89},{"id":"song-era:82685","title":"偶书 其四","author":"邵雍","collection":"宋","notice":"","excerpt":"才高命寡，耻居人下。","body":89},{"id":"song-era:82686","title":"偶书 其二","author":"邵雍","collection":"宋","notice":"","excerpt":"贤德之人，所居之处。","body":89},{"id":"song-era:82687","title":"偶书","author":"邵雍","collection":"宋","notice":"","excerpt":"天生万物，各遂其一。","body":89}]