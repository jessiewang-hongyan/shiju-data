[{"id":"tang:2304","title":"翰林谏议语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"饶道斗上坡去，亦须却下坡来。","body":{"start":2168,"hash":"64a44a0545367288c6e4869eae19c74840460c98e35d13432b1c41a0e942cfa4"}},{"id":"tang:2305","title":"九龙帐歌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"谁谓九龙帐，惟贮一归郎。","body":0},{"id":"tang:2306","title":"二贺诗","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"学行可师贺德基，文质彬彬贺德仁。","body":0},{"id":"tang:2307","title":"八友语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"殷颜柳陆，李萧邵赵。","body":0},{"id":"tang:2308","title":"又号牛李","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"门生故吏，不牛则李。","body":0},{"id":"tang:2309","title":"又号李乂语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"李下无蹊径。","body":0},{"id":"tang:2310","title":"又示段文昌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"去日既逢梅蕊绽，来时应见杏花开。","body":0},{"id":"tang:2311","title":"又报王审知十字谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"不怕羊入屋，只怕钱入腹。","body":0},{"id":"tang:2312","title":"又遗钟传偈","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"但看来年二三月，柳条堪作打钟槌。","body":0},{"id":"tang:2313","title":"万年人语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"宁食三斗尘，无逢权怀恩。","body":0},{"id":"tang:2314","title":"三门谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"古无门匠墓。","body":0},{"id":"tang:2315","title":"上蓝和尚晋汉二代谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"石榴花发石榴开。","body":0},{"id":"tang:2316","title":"广州童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"羊头二四，白天雨至。","body":0},{"id":"tang:2317","title":"广明初都人语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"黄贼打黑贼。","body":0},{"id":"tang:2318","title":"马周疏引俚语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"贫不学俭，富不学奢。","body":0},{"id":"tang:2319","title":"中宗引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"冬至长于岁。","body":0},{"id":"tang:2320","title":"丹阳语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"待钱来，待钱来。","body":0},{"id":"tang:2321","title":"丹徒谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"生东吴，死丹徒。","body":0},{"id":"tang:2322","title":"天冲星占","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"天冲抱极泣帝前，血浊雾下天下冤。","body":0},{"id":"tang:2323","title":"天宝中京兆谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"欲得米麦贱，无过追李岘。","body":0},{"id":"tang:2324","title":"天宝初语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"义髻抛河里，黄裙逐水流。","body":0},{"id":"tang:2325","title":"天枢谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"一条麻索挽，天枢绝去也。","body":{"start":2325,"hash":"0b21045dfce26f138a3b6006d039cb78b7a4ddae0249e056e6be65e7fb42ca88"}},{"id":"tang:2326","title":"天祐中江南童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"东海鲤鱼飞上天。","body":21},{"id":"tang:2327","title":"牛口谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"豆入牛口，势不得久。","body":21},{"id":"tang:2328","title":"王山人为李卫公按冥","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"位极人臣，寿六十四。","body":21},{"id":"tang:2329","title":"王彦章引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"人死留名，豹死留皮。","body":21},{"id":"tang:2330","title":"长沙童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"鞭打马，马急走。","body":21},{"id":"tang:2331","title":"长沙童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"三羊五马，马子离群，羊子无舍。","body":21},{"id":"tang:2332","title":"韦氏语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"大郎罢相，小郎拜相。","body":21},{"id":"tang:2333","title":"冯翊谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"苦泉羊，洛水浆。","body":21},{"id":"tang:2334","title":"占年 其一","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"要见麦，见三白。","body":21},{"id":"tang:2335","title":"占年 其二","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"正月三白，田公笑赫赫。","body":21},{"id":"tang:2336","title":"占雨 其一","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"乾星照湿土，明日依旧雨。","body":21},{"id":"tang:2337","title":"占雨 其二","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"云行西，星照泥。","body":21},{"id":"tang:2338","title":"占雨 其三","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"朝霞不出门，暮霞行千里。","body":21},{"id":"tang:2339","title":"占雨 其四","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"天将雨，鸠逐妇。","body":21},{"id":"tang:2340","title":"卢求榜谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"裴头黄尾，三求六李。","body":21},{"id":"tang:2341","title":"台中谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"免巡未推，只得自知。","body":21},{"id":"tang:2342","title":"号沈宋语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"苏李居前，沈宋比肩。","body":21},{"id":"tang:2343","title":"号钱郎语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"前有沈宋，后有钱郎。","body":21},{"id":"tang:2344","title":"四俊语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"令君四俊，苗吕崔员。","body":21},{"id":"tang:2345","title":"宁茵事谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"鹁鸠树上鸣，意在麻子地。","body":21},{"id":"tang:2346","title":"永安渠石铭","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"百年为市后为池。","body":21},{"id":"tang:2347","title":"田承嗣诳李宝臣伪谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"二帝同功势万全，将田作伴入幽燕。","body":21},{"id":"tang:2348","title":"辽述律后谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"青牛妪，曾避路。","body":21},{"id":"tang:2349","title":"先天时京中语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"姜师度一心看地，傅孝忠两眼相天。","body":21},{"id":"tang:2350","title":"后唐军士谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"除去菩萨，扶立生铁。","body":21},{"id":"tang:2351","title":"吏人语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"不畏侯卿杖，惟畏尹卿笔。","body":21},{"id":"tang:2352","title":"吏部过官语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"麟之口，光庭手。","body":21},{"id":"tang:2353","title":"夷陵女郎鬼","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"鸾老头脑好，好头脑鸾老。","body":21},{"id":"tang:2354","title":"孙光宪琐言引古语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"乘船走马，去死一分。","body":21},{"id":"tang:2355","title":"孙光宪《北梦琐言》引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"小舅小叔，相追相逐。","body":21},{"id":"tang:2356","title":"安乐寺童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"可怜安乐寺，了了树头悬。","body":21},{"id":"tang:2357","title":"戏杜审权语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"座主审权，门生处权。","body":21},{"id":"tang:2358","title":"戏谏司语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"韩谏议虽分左右，归拾遗莫辨存亡。","body":21},{"id":"tang:2359","title":"曲江游人歌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"春光且莫去，留与醉人看。","body":21},{"id":"tang:2360","title":"江右四郡谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"筠袁赣吉，脑后插笔。","body":21},{"id":"tang:2361","title":"江淮间语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"贵如许郝，富若田彭。","body":21},{"id":"tang:2362","title":"羊头山谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"羊头山北作朝堂。","body":21},{"id":"tang:2363","title":"许氏碑阴谜","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"谈马砺毕，王田数七。","body":21},{"id":"tang:2364","title":"阴阳书语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"乔木先枯，众子必孤。","body":21},{"id":"tang:2365","title":"佛书引语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"停囚长智。","body":21},{"id":"tang:2366","title":"吴人歌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"朝判长洲暮判吴，道不拾遗人不孤。","body":21},{"id":"tang:2367","title":"员庄谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"上有天堂，下有员庄。","body":21},{"id":"tang:2368","title":"宋守敬引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"双陆无休势。","body":21},{"id":"tang:2369","title":"张权舆作裴度伪谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"非衣小儿坦其腹，天上有口被驱逐。","body":21},{"id":"tang:2370","title":"张果引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"娶妇得公主，平地生公府。","body":21},{"id":"tang:2371","title":"时人为刘毕语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"刘郎中松树孤标，毕庶子松根绝妙。","body":21},{"id":"tang:2372","title":"时人为李义甫语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"今日巨唐年，还诛四凶族。","body":21},{"id":"tang:2373","title":"时人为崔无诐语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"皇后嫁女，天子娶妇。","body":21},{"id":"tang:2374","title":"时人为黄筌语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"黄筌画鹤，薛稷减价。","body":21},{"id":"tang:2375","title":"时人号王丘崔沔语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"丘山岌岌连天峻，沔水澄澄彻底清。","body":21},{"id":"tang:2376","title":"李处郁语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"飧若入咽，百无一全。","body":21},{"id":"tang:2377","title":"李哲家怪引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"一鸡死，一鸡鸣。","body":21},{"id":"tang:2378","title":"李振引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"百岁奴事三岁主。","body":21},{"id":"tang:2379","title":"李绩引谚别张文瓘","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"千里相送，终于一别。","body":21},{"id":"tang:2380","title":"杜甫引俚语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"城南韦杜，去天尺五。","body":21},{"id":"tang:2381","title":"杜重威引俚语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"逢贼得命，更望复子。","body":21},{"id":"tang:2382","title":"杨氏谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"男不封侯女作妃，君看女却是门楣。","body":21},{"id":"tang:2383","title":"杨刺史语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"宁食三斗蒜，不逢杨德干。","body":21},{"id":"tang:2384","title":"杨柳谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"杨柳杨柳漫头驼。","body":21},{"id":"tang:2385","title":"汾晋间语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"欲作千箱主，问取黄金母。","body":21},{"id":"tang:2386","title":"沧洲语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"不戴金莲花，不得到仙家。","body":21},{"id":"tang:2387","title":"里闾诅语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"若违教，值三豹。","body":21},{"id":"tang:2388","title":"事狐神谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"无狐魅，不成村。","body":21},{"id":"tang:2389","title":"京兆府语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"不立两县令，不坐两少尹。","body":21},{"id":"tang:2390","title":"京西市放生池墓铭","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"龟言市，蓍言水。","body":21},{"id":"tang:2391","title":"周显德中齐州谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"蹋阳春，人间二月雨和尘。","body":21},{"id":"tang:2392","title":"孟蜀丐者语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"不得登，登便倒。","body":21},{"id":"tang:2393","title":"孟蜀桃符诗","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"新年纳馀庆，嘉节号长春。","body":21},{"id":"tang:2394","title":"岩腹棺铭","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"欲堕不堕逢王果，五百年中重收我。","body":21},{"id":"tang:2395","title":"建安语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"龙门一半在闽川。","body":21},{"id":"tang:2396","title":"昌明里中谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"欲知修续者，脚下是生毛。","body":21},{"id":"tang:2397","title":"明经进士语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"三十老明经，五十少进士。","body":21},{"id":"tang:2398","title":"武后时谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"张公吃酒李公醉。","body":21},{"id":"tang:2399","title":"河北语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"唯此两何，杀人最多。","body":21},{"id":"tang:2400","title":"河北谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"山东一条葛，无事莫撩拨。","body":21},{"id":"tang:2401","title":"郇公厨语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"人欲不饭筋骨舒，夤缘须入郇公厨。","body":21},{"id":"tang:2402","title":"郎吏语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"司门水部，入省不数。","body":21},{"id":"tang:2403","title":"金桥童谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"圣人执节度金桥。","body":21},{"id":"tang:2404","title":"举子语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"槐花黄，举子忙。","body":21},{"id":"tang:2405","title":"南中谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"秋收稻，夏收头。","body":21},{"id":"tang:2406","title":"南省北街人吟","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"放榜只应三月暮，登科又校一年迟。","body":21},{"id":"tang:2407","title":"昭潭谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"昭潭无底橘洲浮。","body":21},{"id":"tang:2408","title":"段成式《酉阳杂俎》引古语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"三守庚申三尸伏，七守庚申七尺灭。","body":21},{"id":"tang:2409","title":"洛城五凤楼中歌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"天津桥畔火光起，魏王堤上看洪水。","body":21},{"id":"tang:2410","title":"相书语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"目有四白，五夫守宅。","body":21},{"id":"tang:2411","title":"神龙中语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"崔冉郑，乱时政。","body":21},{"id":"tang:2412","title":"科目举人语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"未见王窦，徒劳漫走。","body":21},{"id":"tang:2413","title":"荆棺峡谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"九子不葬父，一女打荆棺。","body":21},{"id":"tang:2414","title":"选人语 其一","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"有钱石上好，无钱刘下好，士大夫张下好。","body":21},{"id":"tang:2415","title":"选人语 其二","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"硕学师刘子，儒生用与言。","body":21},{"id":"tang:2416","title":"选人语 其三","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"今年柿子并遭霜，为语石榴须早摘。","body":21},{"id":"tang:2417","title":"郝南容引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"三公后，出死狗。","body":21},{"id":"tang:2418","title":"闽人语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"欧阳独步，藻蕴横行。","body":21},{"id":"tang:2419","title":"闽人谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"风吹杨菜鼓山下，不得钱郎戈不罢。","body":21},{"id":"tang:2420","title":"唐旧谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"兔子上金床。","body":21},{"id":"tang:2421","title":"徐闻谚","author":"唐 · 佚名","collection":"唐诗","notice":"","excerpt":"欲拔贫，诣徐闻。","body":21},{"id":"tang:2422","title":"挽歌","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"红轮决定沈西去，未委魂灵往那方。","body":21},{"id":"tang:2423","title":"益阳谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"长沙益阳，一时相卬。","body":21},{"id":"tang:2424","title":"真人谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"有一真人在冀川，开口持弓向外边。","body":21},{"id":"tang:2425","title":"真源邑语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"南金口，明府手。","body":21},{"id":"tang:2426","title":"秦城芭蕉谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"花开来里，花谢也里。","body":21},{"id":"tang:2427","title":"称二王语","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"朝廷左相笔，天下右丞诗。","body":21},{"id":"tang:2428","title":"调露初京城民谣","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"侧堂堂，挠堂堂。","body":21},{"id":"tang:2429","title":"贾言忠引谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"军无媒，中道回。","body":21},{"id":"tang:2430","title":"钱处士李氏谶","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"髣髴之间一倍杨。","body":21},{"id":"tang:2431","title":"鸬鹚谚","author":"唐 · 不详","collection":"唐诗","notice":"","excerpt":"鸬鹚不打脚下塘。","body":21}]