[{"id":"ming-qing:15366","title":"铜雀台","author":"吕阳","collection":"明末清初","notice":"","excerpt":"珠帘穗帐等风流，歌吹犹闻溺妓舟。"},{"id":"ming-qing:15367","title":"之任东瓯道中","author":"吕阳","collection":"明末清初","notice":"","excerpt":"夙驾星言渡海疆，仙人羽葆上官装。"},{"id":"ming-qing:15368","title":"金蕉叶 陈后主","author":"吕阳","collection":"明末清初","notice":"","excerpt":"曾听玉树骊歌未。"}]