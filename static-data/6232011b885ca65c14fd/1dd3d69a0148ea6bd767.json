[{"id":"han:12","title":"天马歌","author":"汉 · 刘彻","collection":"汉诗","notice":"","excerpt":"太一贡兮天马下，沾赤汗兮沫流赭。"},{"id":"han:216","title":"天軿车铭","author":"汉 · 李尤","collection":"汉诗","notice":"","excerpt":"奚氏本造，后裔饰雍。"},{"id":"han:13","title":"西极天马歌","author":"汉 · 刘彻","collection":"汉诗","notice":"","excerpt":"天马徕兮从西极。"}]