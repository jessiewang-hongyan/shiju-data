[{"id":"han:18","title":"瓠子歌","author":"汉 · 刘彻","collection":"汉诗","notice":"","excerpt":"瓠子决兮将奈何。"},{"id":"han:132","title":"戒子孙诗","author":"汉 · 韦玄成","collection":"汉诗","notice":"","excerpt":"于肃君子，既令厥德。"},{"id":"han:15","title":"思奉车子侯歌","author":"汉 · 刘彻","collection":"汉诗","notice":"","excerpt":"嘉幽兰兮延秀。"}]