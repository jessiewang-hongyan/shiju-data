[{"id":"han:120","title":"【醉歌】","author":"汉 · 商丘成","collection":"汉诗","notice":"","excerpt":"出居安能郁郁。"},{"id":"han:131","title":"自劾诗","author":"汉 · 韦玄成","collection":"汉诗","notice":"","excerpt":"赫矣我祖，侯于豕韦。"},{"id":"han:132","title":"戒子孙诗","author":"汉 · 韦玄成","collection":"汉诗","notice":"","excerpt":"于肃君子，既令厥德。"}]