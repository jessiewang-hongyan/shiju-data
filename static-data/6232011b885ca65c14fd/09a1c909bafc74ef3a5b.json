[{"id":"weijin:800","title":"赠梅公明诗","author":"魏晋 · 繁钦","collection":"魏晋诗","notice":"","excerpt":"瞻我北园，有条者桑。"},{"id":"weijin:2032","title":"赠温峤诗","author":"魏晋 · 梅陶","collection":"魏晋诗","notice":"","excerpt":"巍巍有晋，道隆虞唐。"},{"id":"weijin:2033","title":"怨诗行","author":"魏晋 · 梅陶","collection":"魏晋诗","notice":"","excerpt":"庭植不材柳，苑育能鸣鹤。"}]