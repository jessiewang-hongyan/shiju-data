[{"id":"han:203","title":"吴永安五年镜铭","author":"汉 · 佚名","collection":"汉诗","notice":"","excerpt":"明镜百炼师命长。"},{"id":"han:23","title":"北方有佳人","author":"汉 · 李延年","collection":"汉诗","notice":"","excerpt":"北方有佳人。"},{"id":"han:24","title":"羽林郎诗","author":"汉 · 辛延年","collection":"汉诗","notice":"","excerpt":"昔有霍家奴，姓冯名子都。"}]