[{"id":"weijin:1116","title":"宋弘引语","author":"魏晋 · 无名氏","collection":"魏晋诗","notice":"","excerpt":"贫贱之知不可忘。"},{"id":"weijin:2229","title":"题宋纤石壁诗","author":"魏晋 · 马岌","collection":"魏晋诗","notice":"","excerpt":"丹崖百丈，青壁万寻。"},{"id":"weijin:1048","title":"临淮吏人为宋晖歌","author":"魏晋 · 无名氏","collection":"魏晋诗","notice":"","excerpt":"彊直自遂，南阳朱季。"}]