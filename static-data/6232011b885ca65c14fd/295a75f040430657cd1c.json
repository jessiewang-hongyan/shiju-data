[{"id":"han:11","title":"大风","author":"汉 · 刘邦","collection":"汉诗","notice":"","excerpt":"大风起兮云飞扬。"},{"id":"han:17","title":"秋风辞","author":"汉 · 刘彻","collection":"汉诗","notice":"","excerpt":"秋风起兮白云飞。"},{"id":"han:180","title":"越人土风歌","author":"汉 · 佚名","collection":"汉诗","notice":"","excerpt":"其山崔巍以嵯峨，其水溢遝而扬波，其人厽砢而英多。"}]