[{"id":"han:145","title":"安封侯诗","author":"汉 · 崔骃","collection":"汉诗","notice":"","excerpt":"戎马鸣兮金鼓震，壮士激兮忘身命。"},{"id":"han:230","title":"六安枕铭","author":"汉 · 崔骃","collection":"汉诗","notice":"","excerpt":"枕有规矩，恭一其德。"},{"id":"han:203","title":"吴永安五年镜铭","author":"汉 · 佚名","collection":"汉诗","notice":"","excerpt":"明镜百炼师命长。"}]