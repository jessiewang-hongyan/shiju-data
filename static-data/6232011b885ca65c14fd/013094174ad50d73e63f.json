[{"id":"weijin:2749","title":"八阵图","author":"魏晋 · 桓温","collection":"魏晋诗","notice":"","excerpt":"望古识其真，临源爱往迹。"},{"id":"weijin:2747","title":"释天地图赞","author":"魏晋 · 郭璞","collection":"魏晋诗","notice":"","excerpt":"祭地肆瘗，郊天致禋。"},{"id":"weijin:2591","title":"吟","author":"魏晋 · 佛图澄","collection":"魏晋诗","notice":"","excerpt":"殿乎殿乎。"}]