1398","title":"清心镜 本名红窗迥","author":"马钰","collection":"元","notice":"","excerpt":"我当初，为庵主。","body":87},{"id":"yuan-era:1399","title":"清心镜 瓜李喻","author":"马钰","collection":"元","notice":"","excerpt":"喜浮瓜，恐沉李。","body":87},{"id":"yuan-era:1400","title":"清心镜 示当厨造面者","author":"马钰","collection":"元","notice":"","excerpt":"造面人，听予属。","body":87},{"id":"yuan-era:1401","title":"清心镜 兴平郭姑来投全真堂下修行","author":"马钰","collection":"元","notice":"","excerpt":"郭姑姑，男子志。","body":87},{"id":"yuan-era:1402","title":"清心镜 华亭严因院主","author":"马钰","collection":"元","notice":"","excerpt":"刘子温，性通达。","body":87},{"id":"yuan-era:1403","title":"清心镜 弃家","author":"马钰","collection":"元","notice":"","excerpt":"解名缰，敲利锁。","body":87},{"id":"yuan-era:1404","title":"清心镜 戒华丽","author":"马钰","collection":"元","notice":"","excerpt":"出家儿，听仔细。","body":87},{"id":"yuan-era:1405","title":"清心镜 戒捏怪","author":"马钰","collection":"元","notice":"","excerpt":"做风狂，脱家累。","body":87},{"id":"yuan-era:1406","title":"清心镜 戒掉粉洗面","author":"马钰","collection":"元","notice":"","excerpt":"出家儿，贪美膳。","body":87},{"id":"yuan-era:1407","title":"清心镜 杨待韶求问","author":"马钰","collection":"元","notice":"","excerpt":"杨待韶，塑得好。","body":87}]