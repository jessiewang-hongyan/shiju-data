[{"id":"song-era:512","title":"失调名 其十六","author":"无名氏","collection":"宋","notice":"","excerpt":"倚风三喷横竹。","body":{"start":500,"hash":"1054834ce6e44a150f172b9104968016e43dc2dbe14c87258db7bdd9a82f0dd2"}},{"id":"song-era:513","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"自结成同心百索。","body":0},{"id":"song-era:514","title":"传言玉女 其二","author":"晁冲之","collection":"宋","notice":"","excerpt":"一夜东风，吹散柳梢残雪。","body":0},{"id":"song-era:515","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"东南妩媚，雌了男儿。","body":0},{"id":"song-era:516","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"须信道、颜色如花，命如秋叶。","body":0},{"id":"song-era:517","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"月移疏影上窗纱。","body":0},{"id":"song-era:518","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"五马游春，彩佩照人，光生南陌。","body":0},{"id":"song-era:519","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"何时一尊酒，重与细论文。","body":0},{"id":"song-era:520","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"有个秀才姓汪。","body":0},{"id":"song-era:521","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"入到春来转见愁。","body":0},{"id":"song-era:522","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"月到中秋偏莹。","body":0},{"id":"song-era:523","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"梧桐叶落雨潇潇。","body":0},{"id":"song-era:524","title":"失调名 其十三","author":"无名氏","collection":"宋","notice":"","excerpt":"云情雨意商量雪。","body":0},{"id":"song-era:525","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"只为情多病也多，省可思量我。","body":0},{"id":"song-era:526","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"箫鼓声声且莫催。","body":0},{"id":"song-era:527","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"落花点点绣苍苔。","body":0},{"id":"song-era:528","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"光生里闬，荣破天荒。","body":0},{"id":"song-era:529","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"瑞霞成绮。","body":0},{"id":"song-era:530","title":"木兰花 其五","author":"无名氏","collection":"宋","notice":"","excerpt":"金吾不禁元宵，漏声更莫催晓。","body":0},{"id":"song-era:531","title":"失调名 其七","author":"无名氏","collection":"宋","notice":"","excerpt":"金铺翠、蛾毛巧。","body":0},{"id":"song-era:532","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"花有重开月再圆。","body":0},{"id":"song-era:533","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"细雨乱如毛。","body":0},{"id":"song-era:534","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"夜来一阵催花雨。","body":0},{"id":"song-era:535","title":"鹊桥仙","author":"无名氏","collection":"宋","notice":"","excerpt":"海棠花谢清明后。","body":0},{"id":"song-era:536","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"双凤钗头，争带御书符。","body":0},{"id":"song-era:537","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"嫩草初抽匀细绿。","body":0},{"id":"song-era:538","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"莫怪沈腰易瘦。","body":0},{"id":"song-era:539","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"绿草茸茸媚柳芳。","body":0},{"id":"song-era:540","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"说与教知。","body":0},{"id":"song-era:541","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"君是园中杨柳，能得几时青。","body":0},{"id":"song-era:542","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"自有松篁为伴侣。","body":0},{"id":"song-era:543","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"双双飞燕柳边轻。","body":0},{"id":"song-era:544","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"春来长是病厌厌。","body":0},{"id":"song-era:545","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"寸心如铁不关愁。","body":0},{"id":"song-era:546","title":"失调名 瑞雪对江梅赋","author":"无名氏","collection":"宋","notice":"","excerpt":"须教相并檐前望，被飞絮、扑簌香腮。","body":0},{"id":"song-era:547","title":"失调名 其一","author":"无名氏","collection":"宋","notice":"","excerpt":"香野锦林谁是主。","body":0},{"id":"song-era:548","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"离情愁思，尽分付、眉头眼底。","body":0},{"id":"song-era:549","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"做园子，得数载。","body":0},{"id":"song-era:550","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"薰风时送芰荷香。","body":0},{"id":"song-era:551","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"满地榆钱，算来难买住春归。","body":0},{"id":"song-era:552","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"帘卷画堂人寂静。","body":0},{"id":"song-era:553","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"暗把归期数。","body":0},{"id":"song-era:554","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"伤怀长是蹙双眉。","body":0},{"id":"song-era:555","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"百紫千红开遍了。","body":0},{"id":"song-era:556","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"角黍厅前，祭天神、妆成异果。","body":0},{"id":"song-era:557","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"无情却被多情恼。","body":0},{"id":"song-era:558","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"为谁瘦、为谁癯。","body":0},{"id":"song-era:559","title":"失调名","author":"无名氏","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","excerpt":"花有重开日□圆。","body":0},{"id":"song-era:560","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"兽炭共围，通宵不寐，守尽残更待春至。","body":0},{"id":"song-era:561","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"好容仪、取次梳妆。","body":0},{"id":"song-era:562","title":"失调名","author":"无名氏","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","excerpt":"休休得也□，云深处、高卧斜阳。","body":0},{"id":"song-era:563","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"蟾辉兔影十分满。","body":0},{"id":"song-era:564","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"一寸柔肠，如丝千结，不奈愁如铁。","body":0},{"id":"song-era:565","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"缺月挂檐牙。","body":0},{"id":"song-era:566","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"瘦得脸儿两指大。","body":0},{"id":"song-era:567","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"来春高步过南宫，更答取龙头策。","body":0},{"id":"song-era:568","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"恐伊不信是龙头，和书寄与三题草。","body":0},{"id":"song-era:569","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"这愁绪、仗他谁。","body":0},{"id":"song-era:570","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"酒入柔肠似泪流。","body":0},{"id":"song-era:571","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"夜寒斗觉罗衣薄。","body":0},{"id":"song-era:572","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"更作句桃符。","body":0},{"id":"song-era:573","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"去不远，路无多。","body":0},{"id":"song-era:574","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"那得工夫送。","body":0},{"id":"song-era:575","title":"失调名 其十四","author":"无名氏","collection":"宋","notice":"","excerpt":"凤楼帘卷鳌山对。","body":0},{"id":"song-era:576","title":"失调名 其六 喷饶人词","author":"无名氏","collection":"宋","notice":"","excerpt":"尽啜情一饱，泪珠弹子重揾，背人睡也。","body":0},{"id":"song-era:577","title":"失调名 其二 巫山云雨歌词","author":"无名氏","collection":"宋","notice":"","excerpt":"便直饶、铁作心肠，也须是泪滴。","body":0},{"id":"song-era:578","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"深诚杳隔无疑。","body":0},{"id":"song-era:579","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"知他今夜，好好为谁梳洗。","body":0},{"id":"song-era:580","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"满庭箫鼓簇飞球。","body":0},{"id":"song-era:581","title":"失调名 其四","author":"无名氏","collection":"宋","notice":"","excerpt":"彩缕幡儿花枝小。","body":0},{"id":"song-era:582","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"万户与千门，驱傩鼎沸。","body":0},{"id":"song-era:583","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"南楼人未起。","body":0},{"id":"song-era:584","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"西楼独上等多时。","body":0},{"id":"song-era:585","title":"失调名 其二 古岩桂词","author":"无名氏","collection":"宋","notice":"","excerpt":"岩玉枝头金粟斗。","body":0},{"id":"song-era:586","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"巧画远山眉。","body":0},{"id":"song-era:587","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"语燕飞来绕画梁。","body":0},{"id":"song-era:588","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"喜则喜、得入手。","body":0},{"id":"song-era:589","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"夜深青女湿微妆。","body":0},{"id":"song-era:590","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"花开时节连风雨。","body":0},{"id":"song-era:591","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"晓日楼头残雪尽。","body":0},{"id":"song-era:592","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"恨江南塞北，鱼沈雁杳，空肠断、书难寄。","body":0},{"id":"song-era:593","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"妙手庖人，搓得细如麻线。","body":{"start":593,"hash":"154647c9a399e2189c921c865db3b0328ad8a57412e3ca94000fef203563d1c8"}},{"id":"song-era:594","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"待醉里小王，书写副、神荼郁垒。","body":81},{"id":"song-era:595","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"一庭影浸梧竹。","body":81},{"id":"song-era:596","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"玉泉清洁，正好浮瓜沈李。","body":81},{"id":"song-era:597","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"谁道酒能消恨。","body":81},{"id":"song-era:598","title":"卜算子","author":"无名氏","collection":"宋","notice":"","excerpt":"和尚性好耍，贪恋一枝花。","body":81},{"id":"song-era:599","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"东君去后花无主。","body":81},{"id":"song-era:600","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"五花心里看抛球。","body":81},{"id":"song-era:601","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"插黄花、对尊前，且看茱萸好。","body":81},{"id":"song-era:602","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"自家无好况。","body":81},{"id":"song-era:603","title":"失调名 其十七","author":"无名氏","collection":"宋","notice":"","excerpt":"卷上珠帘光。","body":81},{"id":"song-era:604","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"无计奈愁何。","body":81},{"id":"song-era:605","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"盻盻秋波。","body":81},{"id":"song-era:606","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"夜深帘幕静，一曲管弦清。","body":81},{"id":"song-era:607","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"要解心头愁闷，除非殢酒。","body":81},{"id":"song-era:608","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"黄叶无风自落，彩云不雨空归。","body":81},{"id":"song-era:609","title":"失调名 其十二","author":"无名氏","collection":"宋","notice":"","excerpt":"醉乡天广大。","body":81},{"id":"song-era:610","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"便是监商孟客儿。","body":81},{"id":"song-era:611","title":"失调名 休休得也□，云深处、高卧斜阳 又","author":"无名氏","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","excerpt":"单于若问君家世，说与教知。","body":81},{"id":"song-era:612","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"杏花著雨胭脂透。","body":81},{"id":"song-era:613","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"恩爱顿成离别恨。","body":81},{"id":"song-era:614","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"春光悭涩，风颠雨恶，未放晴天气。","body":81},{"id":"song-era:615","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"枕上偷垂泪眼流。","body":81},{"id":"song-era:616","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"频拭脸边新泪。","body":81},{"id":"song-era:617","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"竹爆当门庭，震门陛也。","body":81},{"id":"song-era:618","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"欲折花枝斜插鬓。","body":81},{"id":"song-era:619","title":"鹊桥仙 其二 琵琶行大曲","author":"无名氏","collection":"宋","notice":"","excerpt":"别有暗愁深意。","body":81},{"id":"song-era:620","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"三生春梦。","body":81},{"id":"song-era:621","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"枝头点检，退尽芳菲。","body":81},{"id":"song-era:622","title":"失调名 其十九","author":"无名氏","collection":"宋","notice":"","excerpt":"一种相思两地愁。","body":81},{"id":"song-era:623","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"郎马频嘶竟不来。","body":81},{"id":"song-era:624","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"花底倾杯，花影娇随人醉。","body":81},{"id":"song-era:625","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"燕子引雏飞。","body":81},{"id":"song-era:626","title":"番禺调笑 其十 清远峡","author":"洪适","collection":"宋","notice":"","excerpt":"明月。","body":81},{"id":"song-era:627","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"频歌覆手抛将过，两行人待看回筹。","body":81},{"id":"song-era:628","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"蹙损两眉峰。","body":81},{"id":"song-era:629","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"香阁寂寥。","body":81},{"id":"song-era:630","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"鸳鸯鸥鹭，浴乱一池春碧。","body":81},{"id":"song-era:631","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"添憔悴、看肌瘦损。","body":81},{"id":"song-era:632","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"断肠屈曲屏山。","body":81},{"id":"song-era:633","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"落花狼藉无行处。","body":81},{"id":"song-era:634","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"往来与月为俦，舒展和天也蔽。","body":81},{"id":"song-era:635","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"蝶意蜂情，恣还飘逸。","body":81},{"id":"song-era:636","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"倚遍阑干十二楼。","body":81},{"id":"song-era:637","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"问醉吟今夜，何处凤楼偏好。","body":81},{"id":"song-era:638","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"灯火楼高，移下一天星斗。","body":81},{"id":"song-era:639","title":"失调名","author":"无名氏","collection":"宋","notice":"","excerpt":"敧枕无眠又无寐。","body":81}]