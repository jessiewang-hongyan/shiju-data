[[9,42707,"题眄上人禅居","唐 · 储光羲"],[11,8441,"幺・引壶觞以自酌，眄庭柯以自怡。有酒盈樽，门设常关，景幽人寂。或","元 · 李致远"],[18,58960,"题九江徐使君眄柯亭","李处权"],[18,92913,"寄题康平老眄柯亭","陈与义"],[18,152181,"阮郎归 其一 曾敷文既眄陈湘，歌舞便出其类，学书亦进。来求小楷，作阮郎词付之","黄庭坚"],[18,219109,"题使园眄柯亭","释德洪"],[18,245383,"自题眄怡斋 其一","程迥"],[18,245384,"自题眄怡斋 其二","程迥"],[18,245385,"自题眄怡斋 其三","程迥"],[18,282788,"自题眄怡斋","程迥"]]