[[18,38065,"湖中蚬蚌甚佳村妇调羹名曰水菜余珍嗜之作水羹吟","孙锐"],[18,113027,"广南食槟榔先嚼蚬灰蒌藤叶津遇灰藤则浊吐出一口然后槟榔继进所吐津到地如血唇齿颊舌皆红初见甚骇而土人自若无贵贱老幼男女行坐咀嚼谓非此亦无以通殷勤焉于风俗珍贵凡姻亲之结好宾客之款集包苴之请托非此亦无以通殷勤焉余始至或劝食之槟榔未入口而灰汁藤浆隘其咽嗽濯逾时未能清赋此长韵","郑刚中"],[18,163097,"蚬子和尚赞 其二","释了惠"],[18,163134,"蚬子和尚赞 其一","释了惠"],[18,164103,"蚬子赞 其二","释心月"],[18,164234,"蚬子赞 其一","释心月"],[18,169167,"蚬子赞 其二","释师范"],[18,169289,"蚬子赞 其一","释师范"],[18,171630,"蚬子和尚赞","释法薰"],[18,172091,"蚬子和尚赞","释绍昙"],[18,176051,"蚬子赞","释普度"],[18,253117,"蚬子和尚赞","释广闻"],[18,283535,"蚬子和尚赞","释了惠"],[18,283633,"蚬子赞","释心月"],[18,283943,"蚬子赞","释师范"]]