[{"title":"游嵩山十三首 其七 龙潭","author":"杨奂","text":"壮哉昌黎笔，谈笑排佛祸。\n不言动鬼神，翻疑触雷火。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":781,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其八 五渡水","author":"杨奂","text":"几时落东溪，曲折卧天汉。\n语似登山人，可饮不可盥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":782,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其九 测影台","author":"杨奂","text":"一片开元石，愈知天地中。\n今宵北窗梦，或可见周公。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":783,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其十 箕山","author":"杨奂","text":"土阶堕渺茫，多少曹与马。\n底事住青山，近代无让者。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":784,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其十一 颍水","author":"杨奂","text":"邂逅洗耳翁，去饮上流水。\n此日傥相逢，黄犊应渴死。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":785,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其十二 卓锡泉","author":"杨奂","text":"大士传心要，诸方叩道玄。\n至今卓锡地，瑩彻有遗泉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":786,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游嵩山十三首 其十三 巢翁冢","author":"杨奂","text":"既知田间乐，焉知田间苦。\n惟是唐虞朝，所以有巢父。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":787,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"泊舟老鹳觜","author":"杨奂","text":"衮衮风生嘴，涓涓月印沙。\n船头平压浪，棹尾旋成花。\n老去长为客，愁来转忆家。\n双栖疏影里，羡杀柳桥鸦。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":788,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"青峰寺哭灿然弟","author":"杨奂","text":"长别惟生死，难忘是弟兄。\n但吾今到处，想汝昔曾行。\n乡社三年阻，兵戈一梦惊。\n青山风雨夜，此去更伤情。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":789,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"晚至青口","author":"杨奂","text":"长年困行役，短发易飘零。\n世事惊春梦，交亲散晓星。\n烧痕侵路黑，柳色夹堤青。\n落日明霞底，原情动鹡鸰。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":790,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"次答正卿二首 其一","author":"杨奂","text":"客愁青镜里，归梦白鸥边。\n故国人何在？\n新秋月又圆。\n米盐逢此日，诗酒负残年。\n长羡平林鸟，双飞入暮烟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":791,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"同完颜惟洪至楼观闻耗","author":"杨奂","text":"蓬莱隔沧海，虎豹护天关。\n白发知谁免，青牛竟不还。\n茶分丹井水，诗入草楼山。\n顾我负何事，区区鞍马间。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":792,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"宿草堂二首 其一","author":"杨奂","text":"百顷逍遥苑，千年罗什家。\n荒林藏屋小，细径逐溪斜。\n老桧今何在，瑞莲春自花。\n山灵憎俗驾，朝暮白云遮。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":793,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"宿草堂二首 其二","author":"杨奂","text":"废寺人踪断，幽溪野性便。\n鱼须分浪细，虎迹印沙圆。\n驯雀偷僧饭，饥蚊破客眠。\n献芹吾岂敢，直欲斸山田。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":794,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄商孟卿","author":"杨奂","text":"无穷唯永日，有尽是流年。\n白发谁能免，丹经恐妄传。\n会心人健否，到处冢累然。\n衮衮风波地，方思万里船。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":795,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"河道村","author":"杨奂","text":"官路人家少，边城驿使频。\n季鹰终去洛，王粲近归秦。\n天地群龙斗，泥沙尺蠖伸。\n亲朋应笑我，头白傍风尘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":796,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄朱生","author":"杨奂","text":"不知朱记室，岁晚竟如何。\n老舅家谁托，孀亲鬓已皤。\n林泉忧患少，京国是非多。\n为客几时了，悲凉弹铗歌。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":797,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"留别儒禅","author":"杨奂","text":"溪行鱼不畏，岩宿虎相随。\n怕客谈新事，逢人诵旧诗。\n衲轻聊覆体，米滑欲翻匙。\n僧腊知馀几，霜须已满颐。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":798,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"谢顾副言问疾","author":"杨奂","text":"久谢公家事，时劳长者车。\n可怜新病后，未觉故人疏。\n渭北偏饶梦，河南近得书。\n相忘吾岂敢，欲出怯篮舆。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":799,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"访耿君玉隐居","author":"杨奂","text":"居幽穿洞府，岸狭束溪流。\n细径邻翁熟，悬厓远客愁。\n桥明山月上，窗暗野云浮。\n世事何曾到，年侵亦白头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":800,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雨夜","author":"杨奂","text":"关河隔千里，笔研寄馀生。\n老觉乡心重，閒知世念轻。\n微风摇竹影，细雨簌檐声。\n落魄缘何事，吾今不用名。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":801,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雨夜","author":"杨奂","text":"窗秋风猎猎，檐夜雨频频。\n蛩韵愁于我，灯花笑向人。\n此身犹在洛，何日定归秦。\n不必黄粱熟，真惭白发新。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":802,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"未归","author":"杨奂","text":"渭水遥通洛，函关近隔秦。\n百年垂老日，千里未归身。\n梦寐嫌为客，妻孥不讳贫。\n一官无可恋，花气五陵春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":803,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"答京叔文季昆仲","author":"杨奂","text":"何处音书至，刘家好弟兄。\n科名先世在，诗律早年成。\n岭北饶风雪，淮南困甲兵。\n论文吾有意，尊酒阻同倾。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":804,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"饮山家","author":"杨奂","text":"为爱春风好，乘时把一杯。\n百年双眼在，万事寸心灰。\n花向坐中落，客从云外来。\n诗成无纸笔，画地惜苍苔。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":805,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"浮生一首怀裕之","author":"杨奂","text":"汉节飞云外，秦城落照边。\n浮生空自老，归计定何年？\n泪满陈蕃榻，心摇祖逖鞭。\n短诗聊遣兴，羞向故人传。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":806,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"抚州","author":"杨奂","text":"北界连南界，昌州又抚州。\n月明鱼泊夜，霜冷鼠山秋。\n为客无时了，劳生有许愁。\n残年婴世网，吾欲谢浮鸥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":807,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"至滑州堤","author":"杨奂","text":"旧事悲存没，残年厌往还。\n孤城晴雪底，双塔暮云间。\n马没长津在，龙归老井閒。\n隔林青数点，多是浚州山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":808,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出鸦路宿北石桥","author":"杨奂","text":"烧火连山暗，春云出谷迟。\n避人投野店，系马就疏篱。\n旧字颓垣在，新愁客枕知。\n清明无几日，细与数归期。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":809,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"宿南石桥","author":"杨奂","text":"江流平入楚，山势远连秦。\n岸柳犹含冻，溪花欲破春。\n石衔车辙古，沙印虎蹄新。\n晚境长为客，空山不见人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":810,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"承德亨见访","author":"杨奂","text":"世事元无定，人生只合閒。\n君今悲白发，我亦负青山。\n废郭官居冷，荒年旅食悭。\n最怜情意厚，朝至暮方还。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":811,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"次答正卿二首 其二","author":"杨奂","text":"何人依玉树，有客隐金华。\n老觉身为累，时劳梦到家。\n且骑山简马，谁识子阳蛙。\n日暮秋风起，飞尘满画叉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":812,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"次答伯直侍郎三首 其一","author":"杨奂","text":"家贫馀四壁，地胜接三乡。\n才赋狂司马，形容老遂良。\n画眉从尔阔，舞袖为谁长？\n生死交情在，书绅示不忘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":813,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"次答伯直侍郎三首 其二","author":"杨奂","text":"升斗贪微禄，关河隔故乡。\n咏归怀靖节，知足愧张良。\n不问黄金尽，犹怜白发长。\n江湖风浪急，相喣胜相忘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":814,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"次答伯直侍郎三首 其三","author":"杨奂","text":"汹汹何时定，飘飘著处乡。\n音书黄耳绝，兄弟白眉良。\n晚境情偏重，良宵话更长。\n旧游零落尽，别后实难忘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":815,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"冠氏留别赵帅","author":"杨奂","text":"主人情烂熳，客子自奔忙。\n不见犹频梦，相逢合断肠。\n秋凉抛药裹，夜雨倒壶觞。\n回首高城北，幽燕去路长。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":816,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送靳才卿之平阳","author":"杨奂","text":"却向他州去，萧萧雪满簪。\n丘园初到眼，儿女总关心。\n汾水野烟白，霍山寒雾深。\n得归归更好，吾亦爱秦音。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":817,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"呈君美","author":"杨奂","text":"上阳门外路，日暮独归时。\n齿发各衰谢，风尘仍别离。\n断云横紫阁，急雨掠苍陂。\n地胜饶新句，君将寄阿谁？","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":818,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"得邳大用书复寄","author":"杨奂","text":"百年真梦寐，万国久风尘。\n老去偏相忆，书来恨不频。\n季鹰犹在洛，王粲未归秦。\n谷口知何似，他时愿卜邻。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":819,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"□杨飞卿","author":"杨奂","text":"吾宗久零落，之子亦中年。\n紫逻堪高卧，玄经拟共传。\n前言非戏尔，旧处想依然。\n留著新诗笔，教随过海船。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":820,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"□文纪行赠以小步马","author":"杨奂","text":"洛水西头路，桃花夹岸香。\n偏宜红叱拨，小试紫游缰。\n雨径沙初软，春山草正长。\n杖藜犹过我，此别莫相忘。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":821,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"怀同祖卿","author":"杨奂","text":"东府仓皇别，西河迤逦回。\n元戎期坐啸，上客入行台。\n梦里惠连句，生前张翰杯。\n龙池清似染，应恨不归来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":822,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"答张君美","author":"杨奂","text":"我无茅一把，谁有橘千头。\n应物机仍拙，忧时涕欲流。\n谩违鱼鸟信，岂为稻粱谋。\n老去轻三仕，诗来抵《四愁》。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":823,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"宿重阳宫","author":"杨奂","text":"村落到山尽，轩窗临水多。\n野禽如旧识，邻叟渐相过。\n林静连官竹，篱疏补女萝。\n夜深眠不著，倚杖看星河。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":824,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陶君秀晋人尝为司竹监使因祖渊明尝游五柳庄为立五柳祠在县东西原方见有祠堂诗碑向禹城侯先生司竹时与扶风张明叙六曲李仲常凤翔董彦材从之学如白云楼海棠馆所谓胜游也兵后吾弟主之亦西州衣冠之幸感今慨昔不能不惘然也握手一笑知复何年敢先此以为质兼示鄠亭赵秀才 其一","author":"杨奂","text":"家世江头令，风流竹里仙。\n海棠烘晓霁，野笋淡春烟。\n尊俎违今日，弦歌记昔年。\n挂冠吾有意，送老白云边。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":825,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陶君秀晋人尝为司竹监使因祖渊明尝游五柳庄为立五柳祠在县东西原方见有祠堂诗碑向禹城侯先生司竹时与扶风张明叙六曲李仲常凤翔董彦材从之学如白云楼海棠馆所谓胜游也兵后吾弟主之亦西州衣冠之幸感今慨昔不能不惘然也握手一笑知复何年敢先此以为质兼示鄠亭赵秀才 其二","author":"杨奂","text":"违别亦已久，萧萧双鬓丝。\n自怜多病后，不似早年时。\n暮雨千山道，春风五柳祠。\n剩留溪上竹，到处刻新诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":826,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陶君秀晋人尝为司竹监使因祖渊明尝游五柳庄为立五柳祠在县东西原方见有祠堂诗碑向禹城侯先生司竹时与扶风张明叙六曲李仲常凤翔董彦材从之学如白云楼海棠馆所谓胜游也兵后吾弟主之亦西州衣冠之幸感今慨昔不能不惘然也握手一笑知复何年敢先此以为质兼示鄠亭赵秀才 其三","author":"杨奂","text":"不见长杨馆，人家只翠微。\n溪流环监署，林影入宫闱。\n花鸭夜方静，竹䶉秋更肥。\n青仙无处问，老泪日沾衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":827,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陶君秀晋人尝为司竹监使因祖渊明尝游五柳庄为立五柳祠在县东西原方见有祠堂诗碑向禹城侯先生司竹时与扶风张明叙六曲李仲常凤翔董彦材从之学如白云楼海棠馆所谓胜游也兵后吾弟主之亦西州衣冠之幸感今慨昔不能不惘然也握手一笑知复何年敢先此以为质兼示鄠亭赵秀才 其四","author":"杨奂","text":"老病乡心重，艰危世契疏。\n少年知自立，近日定何如。\n渭上千丛玉，陂头半尺鲈。\n往来元不恶，容我坐篮舆。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":828,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"读汝南遗事 其一","author":"杨奂","text":"轵道牵羊事已非，更堪行酒着青衣。\n里头婢子那知此，争逐君王烈焰归。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":829,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"读汝南遗事二首 其二","author":"杨奂","text":"六朝江水故依然，隔断中原又百年。\n长笑桓温无远略，竟留王猛佐苻坚。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":830,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"读通鉴","author":"杨奂","text":"风烟惨澹驻三巴，汉烬将燃蜀妇髽。\n欲起温公问书法，武侯入寇寇谁家？","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":831,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"紫阳阁","author":"杨奂","text":"碧瓦朱甍动紫烟，清风吹袂渺翩翩。\n梦回忆得三生事，悔落黄尘六十年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":832,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题二贤祠","author":"杨奂","text":"从经操懿狎孤儿，世事尤非扣马时。\n若道后人真可诳，空山焉有二贤祠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":833,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"涿南见蚕妇本汴梁贵家","author":"杨奂","text":"蚕月何曾出后堂，干戈流落客他乡。\n罗衣著尽无人问，自把荆篮摘野桑。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":834,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出郭作","author":"杨奂","text":"燕姬歌处啭莺喉，燕酒春来滑似油。\n自有五陵年少在，平明骑马过卢沟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":835,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过汤阴崇寿寺二首 其一","author":"杨奂","text":"城荒寺古冷于冰，绛帐谁烧照佛灯。\n閒绕空阶观石刻，偶闻音语得乡僧。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":836,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过汤阴崇寿寺二首 其二","author":"杨奂","text":"老僧七十六春秋，霜满修眉雪满头。\n见说故人揩病目，几时携杖入西州。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":837,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"忆君美","author":"杨奂","text":"寒雁明朝下五湖，长安西望独踌躇。\n无情谁似张公子，两见秋风不寄书。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":838,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄君美二首 其二","author":"杨奂","text":"铜柱从君泣堕鸢，鸱夷心事五湖船。\n头颅如此人间世，不得青山对暮年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":839,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"管宁濯足图","author":"杨奂","text":"踏遍辽东未是痴，藜床欲穴只心知。\n好留一掬黄泥水，墁却曹郎受禅碑。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":840,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"答客","author":"杨奂","text":"仕晚自知为学拙，家贫人道治生疏。\n满山薇蕨春风老，昨夜邻翁有报书。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":841,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"泛舟","author":"杨奂","text":"燕子迎风掠水飞，楼前杨柳绿依依。\n十年不作南塘梦，怕见残阳上客衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":842,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"长安感怀","author":"杨奂","text":"此心只欲作东周，再到长安已白头。\n往事无凭空击楫，故人何处独登楼。\n月摇银海秦陵夜，露滴金茎汉殿秋。\n落日酒醒双泪眼，几时清渭向西流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":843,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"延祥观","author":"杨奂","text":"长□谁遣降精魂，气应潜龙道自存。\n玄女式中消日月，春明门外转乾坤。\n诸王决计戡多难，睿主应期即至尊。\n天命有归赤符后，遗风犹记老人村。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":844,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"重阳观","author":"杨奂","text":"终南佳处小壶天，教启全真自此仙。\n道纪宏开山色里，通明高耸日华边。\n南连地肺花浮水，西望经台竹满烟。\n最爱云窗无事客，寂然心月照重玄。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":845,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"遇仙观","author":"杨奂","text":"一饮甘河万事休，唤回胡蝶梦庄周。\n口传铅汞五篇诀，神驭云龙八极游。\n寰海玄风开羽客，遇仙清迹想毡裘。\n百年更有何人酌，人自无缘水自流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":846,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]