[{"title":"黄华峪十绝句 其四","author":"元好问","text":"绝壁孤云仔细看，云间龙穴想高寒。\n碧澜寸寸横秋色，空对山灵说到难。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2224,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华峪十绝句 其五","author":"元好问","text":"玉立千峰画不如，天公自有范宽图。\n闾山要著黄华老，千尺珠帘得似无。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2225,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华峪十绝句 其六","author":"元好问","text":"团团石瓮琢青瑶，仰面看云觉动摇。\n谁著天瓢洒飞雨，半空翻转玉龙腰。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2226,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华峪十绝句 其九","author":"元好问","text":"落峡飞流散不收，湍声汹汹动高秋。\n也应嫌被红尘浣，才近山门便洑流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2227,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乡郡杂诗二首 其一","author":"元好问","text":"一沟流水几桥横，岸上人家种柳成。\n来岁春风一千树，绿烟和雨暗重城。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2228,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乡郡杂诗二首 其二","author":"元好问","text":"新堂缥缈接飞楼，云锦周遭霜树秋。\n若道使君无妙思，冠山移得近城头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2229,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"楚山清晓图","author":"元好问","text":"雨润烟浓十二峰，云间合有楚王宫。\n遥知别后西州梦，一抹春愁浅淡中。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2230,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"三乡杂诗二首 其一","author":"元好问","text":"梦寐沧洲烂熳游，西风安得钓鱼舟。\n薄云楼阁犹烘暑，细雨林塘已带秋。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2231,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"三乡杂诗二首 其二","author":"元好问","text":"尖新秋意晚晴中，六尺筇枝满袖风。\n草合断桥通暗绿，竹摇残照漏疏红。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2232,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杨秘监马图","author":"元好问","text":"天闲谁省识真龙，金粟堆前草色空。\n忽见画图疑是梦，东华驰道麝香骢。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2233,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岳山道中","author":"元好问","text":"野禾成穗石田黄，山木无风雨气凉。\n流水平冈尽堪画，数家村落更斜阳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2234,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雪岸鸣䳺","author":"元好问","text":"离离残雪点荒丛，更著幽禽惨淡中。\n笑杀画帘双燕子，秋千红索海棠风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2235,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"客意","author":"元好问","text":"雪屋灯青客枕孤，眼中了了见归途。\n山间儿女应相望，十月初旬得到无？","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2236,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"论诗三首 其一","author":"元好问","text":"坎井鸣蛙自一天，江山放眼更超然。\n情知春草池塘句，不到柴烟粪火边。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2237,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"论诗三首 其二","author":"元好问","text":"诗肠搜苦白头生，故纸尘昏枉乞灵。\n不信骊珠不难得，试看金翅擘沧溟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2238,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"论诗三首 其三","author":"元好问","text":"晕碧裁红点缀匀，一回拈出一回新。\n鸳鸯绣了从教看，莫把金针度与人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2239,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"风柳鸣蝉","author":"元好问","text":"轻明双翼晓风前，一曲哀筝续断弦。\n移向别枝谁画得，只留残响客愁边。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2240,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"僧寺阻雨","author":"元好问","text":"山气森岑入葛衣，砧声偏与客心期。\n僧窗连夜萧萧雨，又较归程几日迟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2241,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"王子文琴斋","author":"元好问","text":"天上秋风月底霜，求凰一曲鬓丝长。\n相如四壁消何物？\n直要文君典鹔鹴。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2242,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"旧与赵景温","author":"元好问","text":"浮云流水易西东，回首梁园似梦中。\n一别十年今又别，酒尊能得几回同。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2243,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雪谷早行图","author":"元好问","text":"画到天机古亦难，遗山诗境更高寒。\n贞元朝士今谁在？\n莫厌明窗百过看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2244,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"夜宿山中","author":"元好问","text":"月华人影共徘徊，未算归程梦已回。\n涧水悲鸣易愁绝，长松休送雨声来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2245,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"台山杂咏五首 其二","author":"元好问","text":"山上离宫魏故基，黄金佛阁到今疑。\n异时人读清凉传，应记诸孙赋《黍离》。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2246,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"台山杂咏五首 其三","author":"元好问","text":"一国春风帝子家，绿云晴雪间红霞。\n香绵稳藉僧溪草，蜀锦惊看佛钵花。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2247,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"台山杂咏五首 其四","author":"元好问","text":"沈沈龙穴贮云烟，百草千花雨露偏。\n佛土休将人境比，谁家随步得金莲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2248,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"台山杂咏五首 其五","author":"元好问","text":"灵蛇不与世相关，时复蜿蜒水石间。\n何处天瓢待霖雨？\n一龛香火梵仙山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2249,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乙卯二月二十一日归自汴梁二十五日夜久旱而雨偶记内乡一诗追录于此今三十年矣","author":"元好问","text":"桑条沾润麦沟青，轧轧耕车闹晓晴。\n老眼不随花柳转，一犁春事最关情。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2250,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"石勒问道图","author":"元好问","text":"轻比韩彭作李阳，高僧久已笑君狂。\n中原果有刘文叔，肯说铃声替戾冈。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2251,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"贞燕","author":"元好问","text":"杏梁双宿复双飞，海国争教只影归。\n想得秋风逼凉冷，谢家儿女亦依依。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2252,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"留赠丹阳王鍊师","author":"元好问","text":"敝尽貂裘白发新，京华旅食记前身。\n仙翁相见休相笑，同是邯郸枕上人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2253,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"元夕","author":"元好问","text":"花影灯光一万重，青衫骢马踏东风。\n彰阳旧事无人记，二十三年似梦中！","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2254,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"酴醾","author":"元好问","text":"枕帏馀韵最清真，梦里犹来著莫人。\n拟借浓阴作罗幕，玉缨多处卧残春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2255,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和德新丈","author":"元好问","text":"二年老眼暗兵尘，今日逢君喜事新。\n结伴还乡有成约，不应先作北归人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2256,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"倦绣图","author":"元好问","text":"香玉春来困不胜，啼莺唤梦几时应。\n可怜憔悴田家女，促织声中对晓灯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2257,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雪谷晓行图","author":"元好问","text":"漫漫长路几时休，风雪无情梦亦愁。\n羡杀田家老翁媪，瓦盆浊酒火炉头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2258,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"与西僧伦伯达","author":"元好问","text":"行云孤鹤万缘轻，遥见乡关眼便明。\n不似遗山元老子，尘埃风雨过平生。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2259,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"下太行","author":"李俊民","text":"山中日日伴云閒，不见閒云只见山。\n君去试从山下望，青山却在白云间。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2260,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄别","author":"李俊民","text":"马蹄踏破乱山青，送客风回酒半醒。\n归客莫将云外指，大都一十五长亭。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2261,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"香梅二首 其一","author":"李俊民","text":"被谁说破梦中梅，应有罗浮倒挂来。\n祇为怕愁贪睡后，返魂才向北枝开。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2262,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"香梅二首 其二","author":"李俊民","text":"一枝潇洒陇头香，分付新愁竹叶觞。\n纸帐不须寻短梦，天涯倦客已无肠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2263,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"集古十二首 其五","author":"李俊民","text":"谁家红袖倚江楼，白袷行人又远游。\n今夜不知何处泊？\n青山万里一孤舟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2264,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张礼部溪山真乐图","author":"王庭筠","text":"悠悠春天云，想见平时闲。\n朝游溪桥畔，暮宿山堂间。\n澹然不知愁，亦复忘所欢。\n出山初无心，既出还思山。\n人间待霖雨，欲归良独难。\n山堂怅何许，萧萧松桂寒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2265,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华亭 其五","author":"王庭筠","text":"道人邂逅一开颜，为借筇枝策我孱。\n幽鸟留人还小住，晚风吹破水中山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2266,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华亭 其四","author":"王庭筠","text":"挂镜台西挂玉龙，半山飞雪舞天风。\n寒云直上三千尺，人道高欢避暑宫。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2267,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送李山人之燕","author":"段克己","text":"与君把臂临黄河，缺壶声里度悲歌。\n玉缸酒半离筵起，千里东风射马耳。\n孰能忍饥学夷齐，看人鼻孔吹虹蜺。\n莫道书生成事少，男儿盖棺事乃了。\n雄心虽壮未能伸，客舍萧条逢暮春。\n卢沟河上千株柳，满地杨花愁杀人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2268,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"方平道中 其一","author":"段克己","text":"沙软新经雨，风轻不起尘。\n溪山随处好，花柳著行新。\n放浪聊终日，蹉跎又一春。\n行年已如此，犹复向来人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2269,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"方平道中 其二","author":"段克己","text":"病怯春衫薄，衰怜葛屦轻。\n平芜迷旧迹，幽鸟变新声。\n兴与云俱远，心同水共清。\n胶胶还扰扰，回首笑浮生。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2270,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岁己酉春正月十有一日吾友张君汉臣下世家贫不能葬乡邻办丧事诸君皆有吊章且邀余同赋每一忖思辄神情错乱秉笔复罢今忽四旬矣欲绝不言无以表其哀因作古意四篇虽比兴之不足观者足知予志之所在则进知吾汉臣也无疑 其一","author":"段克己","text":"高楼薄浮云，知是何人宅。\n卖诸轻薄儿，身为五侯客。\n日暮斗鸡回，车骑何翕赫。\n鼻息吹虹蜺，行路皆踧踖。\n岂知黔娄生，储粟无儋石。\n衣衾不掩尸，送我城东陌。\n寥寥百世下，谁分夷与蹠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2271,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岁己酉春正月十有一日吾友张君汉臣下世家贫不能葬乡邻办丧事诸君皆有吊章且邀余同赋每一忖思辄神情错乱秉笔复罢今忽四旬矣欲绝不言无以表其哀因作古意四篇虽比兴之不足观者足知予志之所在则进知吾汉臣也无疑 其二","author":"段克己","text":"北方有黄鹄，饱义气勇烈。\n天寒辞故巢，思欲近丹穴。\n吁嗟翅翎短，云海路隔绝。\n凤皇不相待，孤愤无由泄。\n耻与鸱鸢群，朝夕肆饕餮。\n一步两叫号，心摧口流血。\n侧头向苍昊，永与羁雌决。\n人皆尚鸱鸢，反谓黄鹄劣。\n世无弃瓢翁，轩轾定谁说。\n猿鹤与沙虫，泯泯同一辙。\n悲来结中肠，欲辩再三咽。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2272,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岁己酉春正月十有一日吾友张君汉臣下世家贫不能葬乡邻办丧事诸君皆有吊章且邀余同赋每一忖思辄神情错乱秉笔复罢今忽四旬矣欲绝不言无以表其哀因作古意四篇虽比兴之不足观者足知予志之所在则进知吾汉臣也无疑 其三","author":"段克己","text":"艺兰当清秋，生育胡不早。\n西风发微香，能得几时好。\n飞霜半夜来，灭没先百草。\n真宰独何心，吞声不复道。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2273,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岁己酉春正月十有一日吾友张君汉臣下世家贫不能葬乡邻办丧事诸君皆有吊章且邀余同赋每一忖思辄神情错乱秉笔复罢今忽四旬矣欲绝不言无以表其哀因作古意四篇虽比兴之不足观者足知予志之所在则进知吾汉臣也无疑 其四","author":"段克己","text":"驱车上太行，中道车轴折。\n停车卧辕下，骨断筋力折。\n抚膺呼苍天，淫淫涕如雪。\n古往与今来，此憾何时绝。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2274,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赠答封仲坚","author":"段克己","text":"念昔始读书，志本期王佐。\n时哉不我与，触事多坎坷。\n归来濯尘缨，羸装聊解驮。\n午芹多奇峰，流水出其左。\n誓求十亩田，于此养慵惰。\n种椒盈百区，栽竹仅万个。\n自谓得所依，心口默相贺。\n经营久未成，韫椟乏奇货。\n低徊不能去，借宅便高卧。\n始构茆三閒，榱桷久摧挫。\n暑雨畏霖潦，霜风苦掀簸。\n岂无富贵人，粟布救寒饿。\n耻随肥马尘，拥鼻不敢唾。\n淹延岁月深，十手指庸愞。\n尘埋剑锋?，弹铗悲无那。\n时当春之仲，桂魄月半破。\n丁丁闻啄门，有客来相过。\n探怀出新作，高唱成寡和。\n清辞丽卿云，齐梁那复课。\n蹇余鞭不前，踯躅蚁旋磨。\n枯肠藜苋苦，奇字厌搜罗。\n君乎真可人，沽酒酌通播。\n酒酣胆气粗，狂言惊四座。\n旧游渺何许，行路方轗轲。\n作诗寄同声，别离伤老大。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2275,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"兴上人驻锡姑射之麓他日邀余所居之净乐斋勉为赋此","author":"段克己","text":"我爱兴上人，閒处先著脚。\n虽有买山钱，难寻一丘壑。\n向来栖息地，龙象久寂寞。\n重寻林下径，竹石苦纷薄。\n溪水恣交流，岩花自开落。\n却埽丈室中，一瓶还一钵。\n净乐题其颜，尘缘聊解缚。\n寥寥千载下，此理谁发药。\n我今为拈出，未免一重错。\n有净必有垢，无苦亦无乐。\n浑沌元不死，七窍刚自凿。\n郑重庵中人，万法本无著。\n独有太古心，油然满寥廓。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2276,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赠刘润之","author":"段克己","text":"平生不愿万户侯，但愿一识刘荆州。\n荆州已远不可见，裔孙今幸从吾游。\n慨然议论吐肝胆，腰閒古剑鸣蛟虬。\n酒酣醉墨出险怪，笔势惝恍令人愁。\n世人争欲得一诺，黄金不用如山邱。\n结交以义不以利，乐人之乐忧其忧。\n自从管鲍死，此道今悠悠。\n岂忆流落中，忽见古人俦。\n古来贤哲士不达，饥寒不解为身谋。\n纷纷眼底知音少，几向西风叹白头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2277,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乙巳清明游青阳峡","author":"段克己","text":"东山气象太猛悍，万马骎骎来楚甸。\n中分不肯割鸿沟，锻砺戈矛期一战。\n西山折北如西汉，独馀绛灌奔而殿。\n谁为刘项决雌雄，赖有韩彭力相援。\n卢沟直下两山合，泯泯暗流通一线。\n突为瀑布出山口，流沫成轮浪成漩。\n前逾百步落石瓮，黛蓄膏渟那敢眄。\n沈沈南去若白虹，为屿为泜互隐现。\n凿开混沌几千秋，世俗虽见如不见。\n今人谁有笔如椽，为写佳名传㝢县。\n人閒佳节重清明，呼儿折简招诸彦。\n一生能著几两屐，佳处每欲经行遍。\n山灵著意劝人游，吞吐烟霞生万变。\n山阿玉女跪焚香，岩畔仙人一笑倩。\n居者俨若帝王尊，剑佩雍容侍开宴。\n植者磊落如钜人，聚立广庭议封禅。\n拱者矫矫如勇夫，执戈夹戺著綦弁。\n平滩浅濑乍可揭，溪路曲折随峰转。\n葛屦偏宜苔藓滑，行襟时被蔷薇罥。\n当面烟岚舞翠蛟，出岫閒云飘素练。\n群行不复事拘检，眼正明时脚还倦。\n班荆共坐溪上石，粔籹浊醪具时馔。\n良辰无奈夕阳催，羽觞正要清歌荐。\n醒心况复有寒泉，玉池遄返成三咽。\n三分春色二分休，风外飞花时一片。\n古人行乐欲及时，半百之年犹掣电。\n唯有爱山缘未断，梦寐孱颜添健羡。\n一穷到骨不自治，虚负胸中书万卷。\n漫向山林老却人，生来不识荆州面。\n肝胆槎枒须酒浇，顾我非狂亦非狷。\n纷纷世无真是非，弃置从渠若秋扇。\n归来新月偃林梢，寂寞衡门掩深院。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2278,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"戊申四月游禹门有感","author":"段克己","text":"黄河一线天上来，两山突兀屏风开。\n天生圣人为万世，惊涛拍岸鸣春雷。\n冷云直上三千丈，石颠古庙高崔巍。\n断碑岁月不可考，丹书剥落空莓苔。\n嗟乎去古盖已远，荒辞漫汗相惊猜。\n安居平土果谁力，愚民耳目诚可哀。\n一声渔笛起何处，沧洲雅兴还悠哉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2279,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"正月十六日夜雪","author":"段克己","text":"正月望夜夜气交，长空月辉生白毫。\n东风澹荡振林木，春云滃郁翻惊涛。\n望中已觉没河汉，坐中不见群山高。\n打窗雪片大如手，苍髯噤痒磔猬毛。\n我意天心厌诛戮，净洗战血除腥臊。\n方今廊庙已备具，左有夔龙右有皋。\n爱民亲贤急先务，朱轮皂盖驰英豪。\n遗黎幸脱疮痍阨，讴吟圣世心坚牢。\n驱牛负耒过门户，至死不复远遁逃。\n白头老儒最无用，天才鲁钝非时髦。\n日月消磨两蓬鬓，天地飘零一缊袍。\n诗书自足教稚子，藜藿犹能饫老饕。\n清晨喜有蔬圃润，而可暂息抱瓮劳。\n兰芽含甲未出土，萧艾覆陇已可薅。\n閒中事业澹无味，佳趣才如食蟹螯。\n兴来歌咏适情性，背痒似得麻姑搔。\n芹山冈崒寒玉瘦，芹水澄澈春蒲桃。\n直缘山水久留恋，日向溪头醉浊醪。\n青云富贵岂不愿，蟠木轮囷宁自韬。\n结构大厦要梁栋，操割清庙须鸾刀。\n功名傥可跂契稷，跳梁里巷誇儿曹。\n君不见昔在周王师吕望，快若逢尹弯乌号。\n大人虎变固莫测，运命由来有所遭。\n蓬莱方丈在何处，我将入海恣游遨。\n天风飘飘鲸背稳，下视尘世空嘈嘈。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2280,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"微雨后偶成 其一","author":"段克己","text":"孤愤凭谁诉，长歌聊自怡。\n整衣怜瘦减，扶杖觉衰迟。\n小饮非愁敌，轻寒与睡宜。\n今朝春雨好，稚子莫啼饥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2281,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"微雨后偶成 其二","author":"段克己","text":"寂寂春归后，悠悠梦觉时。\n病添花懊恼，愁耐酒禁持。\n瓶贮无多粟，囊封有许诗。\n倚床独成笑，此意几人知。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2282,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]