[{"title":"三害图 其二","author":"李俊民","text":"挟矢操弓短后衣，扬扬意气似男儿。\n欲凭一怒除民害，可惜为人自不知。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1724,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其一 陶唐春色","author":"李俊民","text":"松柏森森护帝宫，至今和气在河东。\n诗人不尽当时事，八景图中见国风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1725,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其二 广胜晴岚","author":"李俊民","text":"等闲过了万千峰，偃蹇相看意不浓。\n洗出青山真面目，祗疑海底有天龙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1726,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其三 平湖飞絮","author":"李俊民","text":"三月湖边祓禊亭，依依杨柳雨中青。\n晚来风起花如雪，春色都归水上萍。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1727,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其四 锦滩落花","author":"李俊民","text":"春风桃叶复桃根，相妒封姨似少恩。\n无限乱红随水去，人閒何处觅仙源。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1728,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其五 汾水孤帆","author":"李俊民","text":"古渡无人鸟迹多，眼前历历旧山河。\n片帆不是秋风客，谁向中流发棹歌。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1729,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其六 姑山晚照","author":"李俊民","text":"嫩寒篱落似江村，雪里精神月下魂。\n桥北桥南路分处，行人立马待黄昏。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1730,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其七 晋桥梅月","author":"李俊民","text":"物外神仙自一家，等闲不许占烟霞。\n只今冰雪人何处，惆怅山前日易斜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1731,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"平水八咏 其八 西蓝夜雨","author":"李俊民","text":"暮云深锁梵王家，楼阁峥嵘阅岁华。\n香火半残僧入定，卧听窗外落檐花。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1732,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"锦堂四咏 其一 春水满四泽","author":"李俊民","text":"一番雨过绿生肥，正是桃花欲浪时。\n掠地风来吹不皱，细看面面尽玻璃。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1733,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"锦堂四咏 其二 夏云多奇峰","author":"李俊民","text":"初见云从山里出，须臾云结势如山。\n一声霹雳催时雨，云不能闲山自闲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1734,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"锦堂四咏 其三 秋月扬明辉","author":"李俊民","text":"谁为天公洗眸子，试将把酒问姮娥。\n清光一片已如许，斫却桂时应更多。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1735,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"锦堂四咏 其四 冬岭秀孤松","author":"李俊民","text":"凛凛苍髯晚节孤，雪中倾盖若旁无。\n一经元亮盘桓后，气压秦时五大夫。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1736,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其一 熙熙堂","author":"李俊民","text":"眼前草木强争春，往日繁华一聚尘。\n山水中閒赏心在，不知谁是肯堂人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1737,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其二 翠兰亭","author":"李俊民","text":"蓬艾丛深特地藏，游蜂何处觅幽芳。\n楚人大段无分别，不识离骚传里香。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1738,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其三 暗香亭","author":"李俊民","text":"三两横斜鹤膝枝，一朝须有返魂时。\n试看今后黄昏月，得似西湖七字诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1739,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其四 七贤台","author":"李俊民","text":"放迹山阳志尚同，至今林下仰高风。\n欲将人物图中看，恐遇生前李卫公。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1740,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其五 漱玉池","author":"李俊民","text":"古人观水必观澜，一滴涓流一滴寒。\n放取黄陂千万顷，莫教龙口吐吞难。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1741,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其六 江源亭","author":"李俊民","text":"羽觞到处不容停，争看中流落酒星。\n彼此一时修禊事，未应人物愧兰亭。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1742,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其七 屏俗庵","author":"李俊民","text":"世上无人可立谈，眼前只有此君堪。\n当年借得谁家宅，疑是今来屏俗庵。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1743,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其八 清晖亭","author":"李俊民","text":"高山森似剑铓立，流水平如罗带舒。\n人在水光山色里，笑渠潘阆倒骑驴。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1744,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其九 富览亭","author":"李俊民","text":"天于万物岂私我，领略风光天不嗔。\n自古山阳景佳处，尽都分付与闲人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1745,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其十 桃园","author":"李俊民","text":"一时得意笑春风，不见春风满树空。\n老去惜花心尚在，为君留眼看蒸红。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1746,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其十一 意在亭","author":"李俊民","text":"绿水古今流不尽，好山前后势相连。\n适来荷蒉者谁子，应笑有心哉此贤。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1747,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"沁园十二咏 其十二 涌珠泉","author":"李俊民","text":"渊底睡龙徒有颔，沙中老蚌恐无胎。\n疾雷惊裂苍苔地，迸出鲛人泪颗来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1748,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落四景 其一 横峰卧云","author":"李俊民","text":"蛰龙起后愿相从，便有人閒润物功。\n一片青山是归处，无心更逐渡溪风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1749,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落四景 其二 阴壑积雪","author":"李俊民","text":"漠漠山阴雪拥门，何时天道变寒暄。\n虽然不是回光地，销得阳和几许恩。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1750,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落四景 其三 寒泉漱玉","author":"李俊民","text":"沥沥山泉枕畔鸣，六根先得一根清。\n从来只向琴中听，不识徽弦意外声。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1751,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落四景 其四 枯松挂月","author":"李俊民","text":"门前老树数难推，独有栽松道者知。\n夜半风催山月上，政当鹤睡觉来时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1752,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其一 吹笙","author":"李俊民","text":"旧曲闻来似敛眉，料应只恨赏音迟。\n梨园传得新翻谱，著意参差竹里吹。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1753,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其二 汲泉","author":"李俊民","text":"非关古井不波澜，祗恨银瓶一掬悭。\n欲助长流御沟水，再教红叶到人閒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1754,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其三 倦绣","author":"李俊民","text":"心情犹在未收时，却顾花閒影渐移。\n不道春来添几线，日长只与睡相宜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1755,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其四 捣衣","author":"李俊民","text":"一夕秋风雁过声，铁衣辛苦向边城。\n将军不用和戎计，双杵休辞月下鸣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1756,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其五 剪爪","author":"李俊民","text":"袖里纤纤只合存，如何春笋不嫌髡。\n金钗坠后无因见，藏得开元一捻痕。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1757,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其六 弹琴","author":"李俊民","text":"休言三尺是枯桐，大抵声音与政通。\n曾得王君意中事，便从弦上和薰风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1758,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其七 学书","author":"李俊民","text":"数幅云笺自卷舒，试教落笔看何如。\n休将彤管题闲句，正要班姬续汉书。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1759,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其八 按乐","author":"李俊民","text":"倚风无力见温柔，初下喧天羯鼓楼。\n犹向花阴理新曲，君王不惜锦缠头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1760,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周昉内人图 其九 览镜","author":"李俊民","text":"不教朱粉污天真，长对菱花顾影频。\n但把蛾眉埽来淡，尚嫌不似虢夫人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1761,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其一 古堤","author":"李俊民","text":"一决江源水自东，长堤隐隐卧如虹。\n不因传得襄阳操，人世何由见禹功。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1762,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二 白沙湖","author":"李俊民","text":"闻道沙堤水陷时，茫茫无处觅完堤。\n当时禹迹依然在，以壑为邻笑白圭。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1763,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三 戍逻垦田","author":"李俊民","text":"屯彻南阳井井田，剑牛刀犊两功全。\n石城惊落吴儿胆，野宿貔貅万灶烟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1764,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其四 樊城","author":"李俊民","text":"暂来朱序秦还守，初入曹仁汉复攻。\n颠倒江山今几主，樊侯依旧袭周封。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1765,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其五 汉高庙","author":"李俊民","text":"垓下未闻歌散楚，泽中已见哭亡秦。\n乾坤到底归真主，愁杀鸿门碎斗人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1766,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其六 光武庙","author":"李俊民","text":"海内英雄待一呼，云龙际会入东都。\n羯奴不识真人事，徼倖中原欲并驱。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1767,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其七 楚昭王庙","author":"李俊民","text":"一閒茅屋暗尘埃，香火凄凉几奠杯。\n故国到今如传舍，后人复使后人哀。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1768,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其八 宋玉宅","author":"李俊民","text":"离骚经里见文章，水绿山青是楚乡。\n往事一场巫峡梦，秋风摇落在东墙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1769,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其九 保汉公庙","author":"李俊民","text":"将将提兵气自扬，一朝翻为沐猴忙。\n得从虎口抽身去，不必雷霆怒假王。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1770,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十 酂城","author":"李俊民","text":"谁是兴刘第一功，我侯只合最先封。\n当时猎犬犹争甚，得鹿权都在指踪。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1771,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十一 三顾门","author":"李俊民","text":"将军命驾出门西，想见门从向日题。\n山下卧龙谁说破，赏音元直在檀溪。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1772,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十二 隆中","author":"李俊民","text":"一朝师出震关东，料敌曹吴几日功。\n未毕将军天下计，乾坤容易老英雄。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1773,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十三 关将军庙","author":"李俊民","text":"鼎足相吞势未分，谁能倾盖得将军。\n曹吴不是中原手，天下英雄有使君。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1774,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十四 鹿门山","author":"李俊民","text":"百年巢穴子孙安，十日长闻九日闲。\n说破姓名人不识，鹿门山是德公山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1775,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十五 庞士元宅","author":"李俊民","text":"鹰自养来饥肯去，龙从卧后顾须频。\n到头骥足非难展，祇在当时驾驭人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1776,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十六 徐庶宅","author":"李俊民","text":"谁知方寸去留初，尽把功名付葛庐。\n举目檀溪人不见，空传谷隐念交书。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1777,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十七 刘表祠","author":"李俊民","text":"天运端能卧可收，江山形势数荆州。\n当时若听韩嵩策，那得曹瞒享士牛。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1778,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十八 谷隐山","author":"李俊民","text":"衮斧留心汉晋閒，岂期谷隐避名难。\n一人有半随秦去，不得相离释道安。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1779,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其十九 庞公祠","author":"李俊民","text":"踏破衡山急急回，凤林尽是漉篱材。\n大家了得无生著，倾出团圞话里来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1780,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十 凤林","author":"李俊民","text":"天宝诗人去却回，果曾北阙上书来。\n若为耆旧无新语，明主何尝弃不才。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1781,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十一 斩蛟渚","author":"李俊民","text":"久愤江于投水俗，近忧泉室泣珠人。\n到头不是池中物，血溅惊波剑有神。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1782,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十二 夫人城","author":"李俊民","text":"见说韩门素识兵，故知西北势先倾。\n未应有子如豚犬，何在夫人自筑城。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1783,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十三 诫虎碑","author":"李俊民","text":"未除不必烦周处，欲刺何须待卞庄。\n入市如羊听命去，至今无害到襄阳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1784,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十四 杜甫故里","author":"李俊民","text":"不知故隐几时离，天宝年閒处处诗。\n过客不须寻世谱，万山山下看沈碑。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1785,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十五 尹氏一门四阙","author":"李俊民","text":"萱堂犹是忘忧地，乌屋相传反哺恩。\n一段家风谁出自，千年鼻祖守关门。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1786,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十六 武安君庙","author":"李俊民","text":"归去咸阳是老头，如何此地肯重游。\n分明祀典无交涉，只合英灵在杜邮。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1787,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十七 修禊亭","author":"李俊民","text":"相唤相呼上巳游，国人无日不思周。\n近来烽火遭三月，那得闲杯逐水流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1788,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十八 汉阴台","author":"李俊民","text":"怪来赐也多言甚，笑倒忘机老汉阴。\n巧拙大都归一溉，宁教劳力莫劳心。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1789,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其二十九 善谑驿","author":"李俊民","text":"皆因盂酒与豚蹄，致使他乡笑滑稽。\n无限驿亭来往客，独言齐赘不归齐。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1790,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十 沧浪歌","author":"李俊民","text":"江上扬扬一棹波，众中清浊笑怀沙。\n不知歌后沧浪曲，却入骚人屈宋衙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1791,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十一 竞渡","author":"李俊民","text":"憔悴沉湘楚大夫，魂招鱼腹肯来无。\n至今江上渔歌在，尚问何由得渡湖。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1792,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十二 抱玉岩","author":"李俊民","text":"特特来从抵鹊山，一心都在献芹閒。\n非关楚国真难辨，举世人皆厌等闲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1793,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十三 习家池","author":"李俊民","text":"日日山公载酒过，醒时常少醉时多。\n儿童拍手阑街笑，惊破沧浪一曲歌。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1794,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十四 的颅溪","author":"李俊民","text":"得雨蛟龙未易图，枉劳木禺用机谟。\n死生毕竟谁堪托，今日才方见的颅。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1795,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"襄阳咏史 其三十五 作乐山","author":"李俊民","text":"悠悠曾不倦登临，眼底何人为赏音。\n白雪一歌犹掩耳，安知梁父是龙吟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1796,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]