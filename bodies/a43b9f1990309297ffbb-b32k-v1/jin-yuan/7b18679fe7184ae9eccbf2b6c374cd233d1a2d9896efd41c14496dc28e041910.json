[{"title":"暮秋有感","author":"李俊民","text":"乱鸦无数噪寒林，林下风吹落叶深。\n惟有黄花枝上露，向人犹似泣残金。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1574,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"即事","author":"李俊民","text":"将军下马气如虹，书生折腰曲如弓。\n好山无限归未得，白云惭愧渡溪风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1575,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"即事","author":"李俊民","text":"秋色南山气势高，坐閒牛酒话粗豪。\n自怜萍梗天涯客，俯仰随人似桔槔。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1576,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陆浑佛髻山","author":"李俊民","text":"十步都无一步平，往来人似画图行。\n可怜一派温泉水，不与荒山洗恶名。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1577,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"汤下寺壁","author":"李俊民","text":"滚滚龙泉自吐吞，谁能个里混光尘。\n再三绕壁寻题句，饶舌山禽不避人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1578,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"跋背面弥勒","author":"李俊民","text":"万水千山特特来，谩劳皮袋走尘埃。\n横担柱杖明州去，世上谁能唤得回。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1579,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题断碑","author":"李俊民","text":"节角催残卧夕阳，岂无神物护文章。\n一从荐福雷轰后，片石犹争日月光。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1580,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游青莲□值巨川彦广二上人出","author":"李俊民","text":"寂寂荒庭落叶堆，与谁重上远公台。\n青山不解留人住，立尽秋风曦未来。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1581,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"戏曹汉臣 其一","author":"李俊民","text":"一见高僧话亦高，醉中往往爱禅逃。\n尔曹自谓曹溪后，不怕曹溪笑尔曹。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1582,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"戏曹汉臣 其二","author":"李俊民","text":"移得花将碧落栽，一枝开后百枝开。\n今生也有狂灵运，待入东林社里来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1583,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落院松","author":"李俊民","text":"霜干亭亭耸碧空，几年春雨养髯龙。\n也能说得菩提法，何处人閒有万松。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1584,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雪后送宝泉之碧落","author":"李俊民","text":"洒面轻风不觉寒，天花散落满人閒。\n慇勤行脚休辞远，出得城门是雪山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1585,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"陶学士烹茶图","author":"李俊民","text":"□□天寒对酪奴，竹閒雪鼎与风炉。\n书生事业真堪□，□谓粗人此景无。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1586,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"修武骞林观","author":"李俊民","text":"□□带雨阻登临，往事看碑或可寻。\n不是青牛洞中□，人閒何处有鶱林。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1587,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"射虎","author":"李俊民","text":"逐鹿中原鹿已无，功名那在一于菟。\n分明射中南山虎，李广元来不丈夫。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1588,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"答筹堂 其一","author":"李俊民","text":"休嫌堂上聚星迟，邂逅人生似有时。\n鸡黍恐忘今后约，预先报与巨卿知。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1589,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"答筹堂 其二","author":"李俊民","text":"秋凉急急授衣迟，便是霜林叶落时。\n夜听寒砧动离思，恨无针线小蛮知。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1590,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"参谋王君玉魏文侯冒雨出猎图","author":"李俊民","text":"□□冒雨入山林，毕竟驰驱获几禽。\n自是魏侯言不负，当时只合献虞箴。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1591,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"抱树石","author":"李俊民","text":"火馀介子身犹在，槁立鲍焦心愈坚。\n欲向前村问遗叟，石荒树老不知年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1592,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和王成之梅韵 其一","author":"李俊民","text":"踏雪寻芳路带沙，南枝初放两三花。\n高楼寄语休吹笛，留取春风与大家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1593,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和王成之梅韵 其二","author":"李俊民","text":"朝来一雪羃晴沙，行到前村始见花。\n驿使便将春色去，暗香今夜落谁家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1594,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"狂风","author":"李俊民","text":"春光著物酒如浓，白白红红眼界中。\n又是一场蝴蝶梦，能禁几度落花风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1595,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游锦堂后园","author":"李俊民","text":"妆点园林次第新，野花无数不知名。\n即时唤起闲中兴，惭愧陶家趣未成。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1596,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"袁景先东归丧马 其一","author":"李俊民","text":"汗血奔驰死即休，东郊骨骼有谁收。\n举鞭遥指前山路，野草闲花满地愁。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1597,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"袁景先东归丧马 其二","author":"李俊民","text":"长鞦短辔惯骑驴，今日徒行为的颅。\n得失从来等闲事，未知愁得塞翁无。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1598,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"玉李花","author":"李俊民","text":"盘根春后几枝分，似比树头花更新。\n落月试将颜色照，便如传得谪仙神。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1599,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"半丈红","author":"李俊民","text":"艳冷香清是就中，等闲不肯媚春风。\n东君也恨无颜色，染出枝头点点红。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1600,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"溪竹","author":"李俊民","text":"崎岖一径逐溪斜，泛泛溪流带落花。\n为问风前双燕子，衔泥飞去入谁家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1601,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"吴神","author":"李俊民","text":"山头多少往来人，香火争将瓦鼎焚。\n箫鼓下山人渐远，晚风吹起一溪云。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1602,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过古寨","author":"李俊民","text":"系马垂杨日半斜，荒村篱落两三家。\n可怜华屋生存处，瓦砾堆中几树花。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1603,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"大阳与诸友话旧","author":"李俊民","text":"寻芳来入杏花村，见客人人有典刑。\n不用看碑问前事，坐中一话即图经。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1604,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"听乐","author":"李俊民","text":"闻韶还似在齐时，三月犹然味不知。\n若要得他安乐法，请君听取四休诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1605,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"郜氏院看花","author":"李俊民","text":"□□花枝不耐寒，就中姚魏欲开难。\n赏心未惬空归去，更待明朝烂漫看。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1606,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"长平怀古","author":"李俊民","text":"赵括虽能读父书，长平一举见规模。\n纵横战国俱陈迹，只有青山似画图。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1607,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"枯松","author":"李俊民","text":"为嫌红紫污家风，故向春来学种松。\n祗恐等闲儿女辈，辄将斤斧损髯龙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1608,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"劝行","author":"李俊民","text":"谁肯收心醉六经，只言酒是在天星。\n若能读得离骚后，学取先生半日醒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1609,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游青莲分韵得春字","author":"李俊民","text":"四面山围故故青，茶烟榻畔坐忘身。\n与师贪论安心法，门外飞花送却春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1610,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"慈氏阁","author":"李俊民","text":"金碧相辉跨杳冥，凭高伫目记吾曾。\n劝君试倚栏干望，愧我今无脚力登。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1611,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出山 其一","author":"李俊民","text":"兴尽东山命驾忙，断云似与雨商量。\n出门卷地颠风起，送客何须尔许狂。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1612,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出山 其二","author":"李俊民","text":"东林景物画中诗，老恨因循著脚迟。\n背了青山却归去，头灰面土任风吹。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1613,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"水帘","author":"李俊民","text":"倒倾蛟室泻琼瑰，派落空岩雪浪堆。\n卷地封姨收不起，素娥垂下玉钩来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1614,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"柳 其一","author":"李俊民","text":"一年春色到溪头，展尽眉閒几点愁。\n才得东君暂时意，笑他张绪不风流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1615,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"柳 其二","author":"李俊民","text":"千丝万缕弄风柔，为爱春阴尽日留。\n杖屦重来有佳处，道人凿石沼清流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1616,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"临清台 其一","author":"李俊民","text":"忽惊平地一声雷，烁烁骄阳气欲回。\n安得霶?片时雨，临清台是望云台。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1617,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"临清台 其二","author":"李俊民","text":"登山兴尽早宜归，况是东风送客时。\n只有临清台下水，怪人来此不留诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1618,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"怀旧","author":"李俊民","text":"杖藜重到古招提，硖石云深一径迷。\n不见同来旧时伴，怕看双翠壁閒题。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1619,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"新安","author":"李俊民","text":"芳草原头一望空，村南村北落花风。\n可怜当日堆钱屋，寂寂无人晚照中。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1620,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过二圣王氏故居感战死者","author":"李俊民","text":"数仞墙围石作基，几年风雨长苔衣。\n英雄地迫难为计，血汗游魂不得归。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1621,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"东山道中","author":"李俊民","text":"采遍山城草木芽，百年老树尽枯槎。\n眼前多少闲田地，雨后春耕有几家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1622,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"掷笔台","author":"李俊民","text":"空山老却涅槃师，掷笔台前旦过稀。\n雉子岂知身后事，至今犹傍法堂飞。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1623,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太平泉 其一","author":"李俊民","text":"试从涧底觅根源，剔藓剜苔得旧泉。\n人事尽随流水去，几时复见太平年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1624,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太平泉 其二","author":"李俊民","text":"水边堪赋濯缨歌，来往游人分外多。\n为问太平何处是，等闲不识起风波。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1625,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"子荣过家上冢 其一","author":"李俊民","text":"班超万里归无期，张翰虽归如不归。\n君看昼锦堂中相，十五年前一布衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1626,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"子荣过家上冢 其二","author":"李俊民","text":"名遂功成不肯闲，故乡曾见几人还。\n百年扶杖华颠老，争看钱家锦绣山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1627,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"十七日送行","author":"李俊民","text":"悤悤又别故园春，花落犹随马后尘。\n相对离筵莫惆怅，送行人是欲行人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1628,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"勉和筹堂来韵 其一","author":"李俊民","text":"往古来今秋复春，嬴颠刘蹶总成尘。\n蜗牛角上争闲气，笑倒南华梦蝶人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1629,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"勉和筹堂来韵 其二","author":"李俊民","text":"气似阳和处处春，但随流俗混光尘。\n须知舌在为身累，非是是非何等人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1630,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"勉和筹堂来韵 其三","author":"李俊民","text":"四海男儿得志时，归来一段话新奇。\n野人不管兴亡事，饮恨闲看老杜诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1631,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"勉和筹堂来韵 其四","author":"李俊民","text":"汉祖龙兴自有时，未应六出计皆奇。\n采芝人向山中老，不见功名一首诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1632,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送颍阳史正之之邓州","author":"李俊民","text":"风俗相邻鴃舌蛮，杖藜南去早宜还。\n年今已近强而仕，捷径休离少室山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1633,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赠陈仲和","author":"李俊民","text":"百年浮世落花风，漆水荣华一梦空。\n拈起数珠都忘却，大千沙界入圆融。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1634,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和秦彦容韵","author":"李俊民","text":"花信风传阆苑香，腾空鹤驾望仙郎。\n当年谁为看炉鼎，曾得丹砂入药囊。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1635,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"碧落途中遇雪","author":"李俊民","text":"出郭山行十里馀，据鞍拥鼻一臞儒。\n飞花落在吟肩上，便是蓝关遇雪图。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1636,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"大阳值雪","author":"李俊民","text":"埽地阴云拨不开，北风吹落豆楷灰。\n相逢父老应相笑，直待山头白后来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1637,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"呈济之","author":"李俊民","text":"朝醒暮醉几时休，鸡黍人家见客留。\n闻道曲生行处有，西村明日趁扶头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1638,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"留别","author":"李俊民","text":"故人不寄一枝梅，亲到前村雪里来。\n兴未尽时还又去，为君更觅暖寒杯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1639,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"留别草堂诸友","author":"李俊民","text":"青山莫厌往来频，野鹤孤云自在身。\n客路傍春风色好，明朝便是远行人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1640,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和筹堂送别韵 其一","author":"李俊民","text":"山城望断首重回，犹劝春风马上杯。\n有似卫轩当日鹤，羽毛养就却归来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1641,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和筹堂送别韵 其二","author":"李俊民","text":"白发相逢得几回，离亭苦劝送行杯。\n元龙不识求田意，徒使青山笑往来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1642,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和河上送行韵","author":"李俊民","text":"沁南幕客尽诗豪，斧月斤云得句高。\n吏部文章笑东野，若为自比倚松蒿。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1643,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蚁战图 其一","author":"李俊民","text":"声势何劳斗似牛，看看一雨到山头。\n大家不肯勤王去，只待槐宫坏即休。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1644,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蚁战图 其二","author":"李俊民","text":"胶胶扰扰战争多，岁月循环得几何。\n树下老人观物化，梦魂应不到南柯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1645,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"画鹤","author":"李俊民","text":"两翅如轮骨己仙，昂昂只合在林泉。\n且休相逐乘轩去，自有人谋二顷田。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1646,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"海棠露","author":"李俊民","text":"轻风袅袅泛崇光，长恨司花不与香。\n春睡一声莺唤起，却教老眼见啼妆。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1647,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张氏肯堂","author":"李俊民","text":"百年兰玉水边村，万轴牙签席上珍。\n同队鱼中见头角，一朝富贵异于人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":1648,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]