[{"title":"昭君怨 江行","author":"王寂","text":"一曲清江环碧。\n两岸萧萧芦荻。\n烟雨暗西山。\n有无间。\n有酒须当痛饮。\n百岁黄粱一枕。\n瞰莫放愁閒。\n上眉端。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":507,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"洞仙歌 自为寿","author":"王寂","text":"先生老矣，饱阅人间世。\n磨衲簪缨等游戏。\n趁馀生强健、好赋归欤，收拾个，经卷药炉活计。\n辟寒金剪碎，漉蚁浮香，恰近重阳好天气。\n有荆钗举案、綵服儿嬉，随分地、且贵人生适意。\n也不愿、堆金数中书，愿岁岁今朝、对花沈醉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":508,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 上太夫人寿","author":"王寂","text":"阿母瑶池，梦回风露青冥晓。\n六宫仪表。\n曹大家风好。\n满眼儿孙，大国金花诰。\n头如葆。\n未尝闻道。\n冷笑西河老。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":509,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 闺思","author":"王寂","text":"疏雨池塘，一番雨过香成阵。\n海榴红褪。\n燕语低相问。\n冰簟纱幮，玉骨凉生润。\n沈烟喷。\n日长人困。\n枕破斜红晕。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":510,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"酒泉子 夫人生朝","author":"王寂","text":"禊饮连宵，帘捲晓风香鸭喷，儿孙罗拜捧金荷。\n沸笙歌。\n赤霜袍软髻嵯峨。\n名在仙班应不老，人间岁月尽飞梭。\n奈君何。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":511,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"减字木兰花","author":"王寂","text":"髻罗双绾。\n滟滟脩眸秋水剪。\n笑靥颦眉。\n无限閒愁总未知。\n虚檐月转。\n一曲未终肠已断。\n百斛明珠。\n买得樽前一醉无。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":512,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"减字木兰花","author":"王寂","text":"湖山明秀。\n豆蔻梢头春欲透。\n学画鸦儿。\n多少閒愁总未知。\n新声皓齿。\n恼损苏州狂刺史。\n一斛骊珠。\n许我樽前醉也无。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":513,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"减字木兰花 送春","author":"王寂","text":"羽书催去。\n落絮飞花萦不住。\n湖上流莺。\n欲别频啼三两声。\n刘郎未到。\n辜负东风何草草。\n今度重来。\n不放桃花取次开。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":514,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"望月婆罗门引 元夕","author":"王寂","text":"小寒料峭，一番春意换年芳。\n蛾儿雪柳风光。\n开尽星桥铁锁，平地泻银潢。\n记当时行乐，年少如狂。\n宦游异乡。\n对节物、只堪伤。\n冷落谯楼淡月，燕寝馀香。\n快呼伯雅，要洗我、穷愁九曲肠。\n休更问、勋业行藏。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":515,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"望月婆罗门引 怀古","author":"王寂","text":"笑谈樽俎，坐中惊叹谪仙人。\n乌丝落笔如神。\n唤起小鬟风味，学按古阳春。\n对琼枝璧月，朝暮长新。\n宦萍此身，叹别后、迹俱陈。\n独有芳温一念，红泪罗巾。\n凭谁妙手，为写寄、崔徽一幅真。\n聊慰我、老眼黄尘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":516,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"渔家傲 夫人生朝","author":"王寂","text":"前日河梁修禊罢。\n閒庭未拆秋千架。\n萱草堂深飞寿斝。\n香满把。\n綵衣兰玉森如画。\n海上麻姑亲命驾。\n玄霜乞得宜春夏。\n快约伯鸾冠早挂。\n筠窗下。\n团栾共说无生话。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":517,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"渔家傲 瑞香","author":"王寂","text":"岩秀不随桃李伴。\n国香未许幽兰换。\n小睡最宜醒鼻观。\n檐月转。\n紫云娘拥青罗扇。\n半世庐山清梦断。\n天涯邂逅春风面。\n茗椀不来羞自荐。\n空恋恋。\n野芹炙背谁能献。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":518,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"菩萨蛮","author":"王寂","text":"镇犀不动红炉窄。\n宿酲恼损金钗客。\n瑞鸭叆彫盘。\n白毫起鼻端。\n韩郎双鬓老。\n个里知音少。\n留取麝煤残。\n临鸾学远山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":519,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"菩萨蛮 回文题扇图","author":"王寂","text":"碧空寒露松枝滴。\n滴枝松露寒空碧。\n山远抱溪湾。\n湾溪抱远山。\n竹疏横岸曲。\n曲岸横疏竹。\n寒鹭宿平滩。\n滩平宿鹭寒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":520,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"菩萨蛮 春闺","author":"王寂","text":"回文锦字慇勤织。\n归鸿点破晴空碧。\n上尽最高楼。\n栏干曲曲愁。\n黄昏犹伫立。\n何处砧声急。\n强欲醉乌程。\n醒时月满庭。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":521,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"感皇恩 有赠","author":"王寂","text":"宝髻绾双螺，蹙金罗抹。\n红袖珍珠臂鞲匝。\n十三弦上，小小剥葱银甲。\n阳关三叠遍，花十八。\n雁行历历，莺声恰恰。\n洗尽歌腔旧讴哑。\n坐中狂客，不觉琉璃杯滑。\n缠头莫惜与，金钗插。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":522,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"感皇恩 漫兴","author":"王寂","text":"天地一浮萍，人生如寄。\n画饼功名竟何益。\n百年浑醉，三万六千而已。\n过了一日也，无一日。\n韶颜暗改，良辰易失。\n丝竹杯盘但随意。\n酴醾赏罢，更向牡丹丛里。\n戴花连夜饮，花前睡。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":523,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"瑞鹤仙 上高节度寿","author":"王寂","text":"辕门初射戟。\n看气压群雄，虹飞千尺。\n青云试长翮。\n拥牙旗金甲，掀髯横策。\n威行蛮貊。\n令万卒、纵横坐画。\n荡淮夷、献凯归来，斗印命之方伯。\n赫赫。\n功名天壤，历事三朝，许身忠赤。\n寒陂湛碧。\n容卿辈，几千百。\n看皇家图旧，紫泥催去，莫忘樽前老客。\n愿年年、满把黄花，寿君大白。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":524,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蓦山溪 退食感怀","author":"王寂","text":"山城块坐，空吊朋侪影。\n挝鼓放衙休，悄无人、日长门静。\n折腰五斗，所得不偿劳，松暗老，菊都荒，谁为开三径。\n及瓜不代，归计浑无定。\n羁客奈愁何，尽消除、诗魔酒圣。\n儿童蛮语，生怕闰黄杨，争左角，梦南柯，万事从今省。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":525,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"醉落魄 叹世","author":"王寂","text":"百年旋磨。\n等閒事莫教眉锁。\n功名画饼相谩我。\n冷暖人情，都在这些个。\n璠玙不怕经三火。\n莲花未信淤泥涴。\n而今笑看浮生破。\n禅榻茶烟，随分与他过。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":526,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"鹧鸪天","author":"王寂","text":"千顷玻璃锦绣堆。\n弄妆人对影徘徊。\n香薰木麝芳姿瘦，酒晕朝霞笑脸开。\n娇倚扇，醉翻杯。\n莫随云雨下阳台。\n平生老子风流惯，消得冰魂入梦来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":527,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"鹧鸪天","author":"王寂","text":"秋后亭皋木叶稀。\n霜前关塞雁南归。\n晓云散去山腰瘦，宿雨时来水面肥。\n吾老矣，久忘机。\n沙鸥相对不惊飞。\n柳溪父老应怜我，荒却溪南旧钓矶。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":528,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"江梅引","author":"李治","text":"陌头杨柳恨春迟。\n被寒欺。\n淡依依。\n瘦损王孙，青琐小腰围。\n墙外琼枝空照影，翠娥敛，游丝百丈飞。\n燕归雁归书问寂。\n月细风尖供怨笛。\n玉骨成灰圣得回。\n梦里音容，良是觉来非。\n多少江州司马泪。\n断肠曲，河声送落晖。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":529,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"摸鱼儿","author":"李治","text":"雁双双、正飞汾水，回头生死殊路。\n天长地久相思债，何似眼前俱去。\n摧劲羽。\n倘万一幽冥，却有重逢处。\n诗翁感遇。\n把江北江南，风嘹月唳，并付一丘土。\n仍为汝。\n小草幽兰丽句。\n声声字字酸楚。\n拍江秋影今何在，宰木欲迷堤树。\n霜魂苦。\n算犹胜、王嫱有冢贞娘墓。\n凭谁说兴。\n叹鸟道长空，龙艘古渡。\n马耳泪如雨。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":530,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"摸鱼儿","author":"李治","text":"为多情、和天也老，不应情遽如许。\n请君试听双蕖怨，方见此情真处。\n谁点注。\n香潋滟银塘，对抹胭脂露。\n藕丝几缕。\n绊玉骨春心，金沙晓泪，漠漠瑞红吐。\n连理树。\n一样骊山怀古。\n古今朝暮云雨。\n六郎夫妇三生梦，肠断目成眉语。\n须唤取。\n共鸳鸯翡翠、照影长相聚。\n西风不住。\n恨寂寞芳魂，轻烟北渚。\n凉月又南浦。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":531,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"鹧鸪天","author":"李治","text":"太一沧波下酒星。\n露醽秘诀出仙扃。\n情知天上莲花白，压尽人间竹叶青。\n迷晚色，散秋馨。\n兵厨晓溜玉泠泠。\n楚江云锦三千顷，笑杀灵均话独醒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":532,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"鹧鸪天","author":"李治","text":"十丈冰花太一峰。\n拍浮来赴酒船中。\n碧筒象鼻秋泉滑，泽国幽香笑卷空。\n云淡泞，月朦胧。\n醉乡千里鲤鱼风。\n冯夷击鼓休惊客，罗袜生尘恐恼公。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":533,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过云台","author":"李俊民","text":"夜半风吹霁色开，晓乘残月过云台。\n连山断处瞰平野，一线黄流掌上来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":534,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雨后","author":"李俊民","text":"春空霭霭暮云低，飞过山前雨一犁。\n明日却寻归去路，马蹄犹踏落花泥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":535,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太常引 刘君祥寿二月十五日","author":"李俊民","text":"区区州县肯徒劳。\n谁得似、卯金刀。\n一笑醉蟠桃。\n问何处、仙山可巢。\n两朝人物，积年阴德，心力过萧曹。\n门户便须高。\n看今后、君家凤毛。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":536,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太常引 同知崔仲明生日","author":"李俊民","text":"太行千里政声扬。\n问何处、是黄堂。\n遗爱几时忘。\n试听取、人歌召棠。\n锦衣年少，插花跃马，休负好风光。\n三万六千场。\n但暮暮、朝朝醉乡。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":537,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太常引 窦君瑞寿日","author":"李俊民","text":"燕山勋烈有馀光。\n问丹桂、几枝芳。\n阴德后来昌。\n但教子、应须义方。\n功名看破，黄冠野服，林下道家装。\n何处是仙乡。\n这日月、闲中最长。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":538,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"水龙吟 筹堂寿日","author":"李俊民","text":"一朝衣锦归来，高门不负于公望。\n恍然如旧，黄流万里，太行千丈。\n只比当时，添些气势，减些风浪。\n记采薇戍罢，分茅议定，凯歌动、声悲壮。\n元自山西出将。\n却从他、山东入相。\n兜鍪须待，貂蝉换了，凌烟画像。\n且把功名，暂都分付，浅斟低唱。\n但年年、看取三台长在，老人头上。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":539,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"水龙吟 翟端甫寿日十月一日","author":"李俊民","text":"胜游漫说山阴，算来不及山阳好。\n七贤林下，一时人物，何如安道。\n况有奇才，纵横笔阵，千军独埽。\n向碧油幢底，真儒事业，倚马看、檄书草。\n谁识平居隐操。\n遇江州、十分礼貌。\n世情交态，雀罗门外，几人曾到。\n且斗樽前，等闲休问，高山白早。\n赖姮娥，留得一枝丹桂，伴灵椿老。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":540,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"西江月 张堂臣寿日","author":"李俊民","text":"人比当年杨柳，六郎元似莲花。\n渔经猎史是生涯。\n那羡章台走马。\n鲈脍未归夙驾，斗牛尚客星槎。\n直教三战过崔家。\n伴取赤松林下。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":541,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"西江月 答亚之","author":"李俊民","text":"漠漠烟生碧树，溶溶水满芳溪。\n东风吹湿落花泥。\n忙杀营巢燕子。\n百字诗惭我寄，一壶酒望君携。\n休将闲事等闲题。\n且把眉头放起。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":542,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"西江月 筹堂寿","author":"李俊民","text":"落落琼林人物，飘飘鹤氅仙风。\n渡江已后见英雄。\n那在悬刀一梦。\n雾恰山中隐豹，云还天上从龙。\n太行直枕大河东。\n犹比声名不重。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":543,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"西江月 裴节度使寿（字怀诚）","author":"李俊民","text":"荐疏李誇精鉴，婿佳韦得贤侯。\n手如霹雳在同州。\n不让当时谈薮。\n但可称为劲草，莫教指作清流。\n归来绿野任沉浮。\n这个家风耐久。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":544,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"阮郎归 戏李子搢","author":"李俊民","text":"江南江北水连云。\n江山憔悴人。\n华簪犹拂洛阳尘。\n离筵何太频。\n歌近耳，酒盈樽。\n樽前见在身。\n昨朝骂坐灌将军。\n近前丞相嗔。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":545,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"阮郎归 杨彦明寿日筹堂之甥","author":"李俊民","text":"年来宅相有谁承。\n人誇似舅甥。\n带牛佩犊尽春耕。\n菟裘了一生。\n闲事业，寄丹青。\n笔端如有神。\n试看自写镜中真。\n老人南极星。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":546,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"阮郎归 郭延年诞日","author":"李俊民","text":"断蓬踪迹去依刘。\n试登王粲楼。\n此心安处即菟裘。\n尚何来往求。\n诗遣兴，酒消愁。\n竹林多胜游。\n与君何日共仙舟。\n相看应白头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":547,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南乡子 上夫人寿日","author":"李俊民","text":"香霭博山炉。\n罗绮森森奉燕居。\n昼锦归来冠盖里，当时。\n曾拜金花大国书。\n一旦得双珠。\n阿大中郎喜有馀。\n见说上天虽富贵，争如。\n平地仙家碧玉壶。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":548,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南乡子 李克绍生朝","author":"李俊民","text":"来往亦风流。\n曾伴仙翁衣锦游。\n闻道长平朱紫地，西楼。\n依旧人人说故侯。\n能得几春秋。\n未必灵椿老便休。\n自有枝枝丹桂在，何忧。\n宝月忙催玉斧修。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":549,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南乡子 锦堂寿日","author":"李俊民","text":"弓剑不离身。\n唾手功名马上成。\n见说人生为郡乐，班春。\n政事如棋局局新。\n熊梦庆佳辰。\n喜动山城击壤民。\n昼锦堂前争献寿，留宾。\n尽是蟠桃会上人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":550,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南乡子 锦堂碧落寿席","author":"李俊民","text":"爽气逼人寒。\n相对溪堂雪后山。\n赖有忘年林下友，盘桓。\n都把功名付等闲。\n尽道好休官。\n况在黄柑紫蟹閒。\n天意不随人事改，平安。\n愁莫能侵镜里颜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":551,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"洞仙歌 中秋","author":"李俊民","text":"秋光海底，涌出银盘烂。\n只怕微云淡河汉。\n料姮娥应笑、醉舞仙人，今夜里，空恁樽前撩乱。\n寻常三五夜，也有团圆，争柰人心未能满。\n记当初破镜、飞上天时，双照影、留得人閒一半。\n待仗他玉斧、再修成，问明月明年、共谁同看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":552,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"洞仙歌 汴梁与许道真郭伯诚刘光甫同赋","author":"李俊民","text":"百年富贵，一觉邯郸梦。\n识破中流退应勇。\n纵生前身后、得个虚名，褒贬处。\n一字由他南董。\n故园归去好，还肯同归，大厦如今有梁栋。\n对青天咫尺、列宿森然，君莫怪。\n不见少微星动。\n且拂袖、林泉作诗人，尽明月清风、笑人嘲弄。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":553,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"洞仙歌 谢杨成之寄梅","author":"李俊民","text":"陇头潇洒，辜负寻芳眼。\n浪蕊浮花问名懒。\n纵看看驿使、带得春来，祇恐怕，绿叶成阴子满。\n暗香无恙否，月落参横，惆怅罗浮梦魂短。\n赖故人情重、不减西湖，花上月、分我黄昏一半。\n更选甚、南枝与北枝，是一种春风、待争寒煖。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":554,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 重阳菊间小酌同申元帅等","author":"李俊民","text":"秋树风高，可怜憔悴门前柳。\n白衣去后。\n闲却持杯手。\n一笑相逢，落帽年时友。\n君知否。\n南山如旧。\n人比黄花瘦。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":555,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 王怀州寿日戊戌十月一日","author":"李俊民","text":"横槊将军，是他马上男儿事。\n河山表里。\n养就英雄气。\n衣锦归来，占尽人间贵。\n功名遂。\n神仙平地。\n学取留侯计。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":556,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 冯巨川南斋牡丹","author":"李俊民","text":"花恨开迟，为花迟后为花恼。\n问花开了。\n却恨花开早。\n人貌年年，不似花长好。\n还知道。\n年年人貌。\n却笑花先老。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":557,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 酒赠车元帅","author":"李俊民","text":"著甚乾忙，人生只合糟丘老。\n一杯软饱。\n从事齐能到。\n不读离骚，恐怕愁难埽。\n春光好。\n醉时便倒。\n何处无芳草。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":558,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"点绛唇 锦堂寿日","author":"李俊民","text":"马上功名，射雕谁似将军手。\n一朝肘后。\n金印悬如斗。\n锦绣山川，何似人长久。\n闲中友。\n为君添寿。\n共劝忘怀酒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":559,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"婆罗门引 重阳与元帅窦子温暨众友东城赏菊即席赋","author":"李俊民","text":"浮空霁色，江涵秋影雁初飞。\n相逢共绕东篱。\n点检樽前见在，人似晓星稀。\n对满山红树，叶叶堪题。\n大家露顶。\n任短发、被风吹。\n只恐黄花人貌，不似年时。\n杯添野水，更何用、频频望白衣。\n沉醉后、携手方归。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":560,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"清平乐 壬申岁六月十四日","author":"李俊民","text":"满斟绿醑。\n劝我千金寿。\n不住光阴催老丑。\n三十七年回首。\n镜中白发无多。\n缺壶安用长歌。\n有志封侯万里，列仙不柰臞何。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":561,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"清平乐 戏赠","author":"李俊民","text":"城南归路。\n信马随车去。\n家在白云楼下住。\n帘幕深沉庭户。\n不论天上人閒。\n到头此债须还。\n一枕行云梦觉，小楼却似巫山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":562,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"清平乐 闰重九宋翔卿席","author":"李俊民","text":"黄花今后。\n才是秋光暮。\n依旧满城风又雨。\n勾引锦囊诗句。\n东篱尚可重游。\n羡君来往风流。\n莫惜樽前健倒，这回节去蜂愁。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":563,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"清平乐 锦堂寿","author":"李俊民","text":"青云得路。\n休叹功名误。\n好在辋川堪画处。\n闻早抽身归去。\n任他千丈风波。\n光阴著酒消磨。\n识破落花浮世，笑看金狄摩挲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":564,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]