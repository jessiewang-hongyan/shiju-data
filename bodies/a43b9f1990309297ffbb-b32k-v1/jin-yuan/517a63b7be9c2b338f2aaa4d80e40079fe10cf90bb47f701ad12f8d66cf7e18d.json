[{"title":"杏花杂诗八首 其七","author":"元好问","text":"楚客离魂不易招，野春平碧水迢迢。\n垂杨也被多情恼，瘦损春风十万条。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2150,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杏花杂诗八首 其八","author":"元好问","text":"红妆翠盖惜风流，春动香生不自由。\n莫向芸斋厌閒冷，小诗供作锦缠头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2151,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出京","author":"元好问","text":"巫峡归云底处寻，高城渺渺暮烟沈。\n春风不剪垂杨断，系尽行人北望心。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2152,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"惠崇芦雁","author":"元好问","text":"寒沙折苇静相依，故国春风早晚归。\n意外羁栖谁画得？\n羽毛单薄稻粱微。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2153,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"铜雀台瓦砚","author":"元好问","text":"爱惜铅华洗又看，画阑桂树雨声寒。\n千年不作鸳鸯去，唤得书生笑老瞒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2154,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"步虚词三首 其一","author":"元好问","text":"阆苑仙人白锦袍，海山宫阙醉蟠桃。\n三更月底鸾声急，万里风头鹤背高。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2155,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"步虚词三首 其二","author":"元好问","text":"万神朝罢出通明，和气欢声满玉京。\n见说人间有新异，绿章封事谢升平。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2156,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"步虚词三首 其三","author":"元好问","text":"琪树明霞碧落宫，歌音袅袅度泠风。\n人间听得《霓裳》惯，犹恐钧天是梦中。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2157,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"风雨停舟图","author":"元好问","text":"老木高风作意狂，青山和雨入微茫。\n画图唤起扁舟梦，一夜江声撼客床。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2158,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"长寿山居元夕","author":"元好问","text":"微茫灯火共荒村，黄叶漫山雪拥门。\n三十九年何限事，只留孤影伴黄昏。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2159,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"右司正之家渭川千亩图","author":"元好问","text":"官街尘土雾中天，入眼荒寒一洒然。\n大似终南山下看，北风和雪卷苍烟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2160,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"山居二首 其一","author":"元好问","text":"斜阳高树挂晴虹，肃肃微凉雨气中。\n一道鹭鸶花不断，密香吹满马头风。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2161,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"山居二首 其二","author":"元好问","text":"诗肠搜苦怯茶瓯，信手拈书却枕头。\n檐溜滴残山院静，碧花红穗媚凉秋。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2162,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄女严","author":"元好问","text":"鹳崖鱼窟路间关，旬月无由一往还。\n寒食归宁见邻女，举家回首望西山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2163,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自邓州幕府暂归秋林","author":"元好问","text":"升斗微官不疗饥，中林春雨蕨芽肥。\n归来应被青山笑，可惜缁尘染素衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2164,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题省掾刘德润家骖鸾图并为同舍郎刘长卿记异刘在方城先有碧箫之遇如芙蓉城事云","author":"元好问","text":"千劫情缘万古期，楼中萧史姓名非。\n洞天花落秋云冷，肠断青鸾独自飞。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2165,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杂著三首 其一","author":"元好问","text":"青盖朝来帝座新，岂知卫瓘是忠臣。\n洛阳荆棘千年后，愁绝铜驼陌上人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2166,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杂著三首 其二","author":"元好问","text":"天上河源地上流，黄金浮世等閒休。\n埋愁不著重泉底，尽向人间种白头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2167,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杂著三首 其三","author":"元好问","text":"半纸虚名百战身，转头高冢卧麒麟。\n山间曾见渔樵说，辛苦凌烟阁上人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2168,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其一","author":"元好问","text":"洛阳城阙变灰烟，暮虢朝虞只眼前。\n为向杏梁双燕道，营巢何处过明年？","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2169,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其三","author":"元好问","text":"醇和旁近洞房环，碧瓦参差竹树閒。\n批奏内人轮上直，去年名姓在窗间。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2170,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其四","author":"元好问","text":"天上三郎玉不如，手中白羽趁花奴。\n御屏零落宣和笔，留得华清按乐图。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2171,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其五","author":"元好问","text":"诗仙诗鬼不谩欺，时事先教梦里知。\n禁苑又经人物散，荒凉台榭水流迟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2172,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其六","author":"元好问","text":"金缕歌词金曲卮，百年人事鬓成丝。\n重来未必春风在，更为梨花住少时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2173,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其七","author":"元好问","text":"杨柳随风散绿丝，桃花临水弄妍姿。\n无端种下青青竹，恰到湘君泪尽时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2174,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其八","author":"元好问","text":"琵琶心事曲中论，曾笑明妃负汉恩。\n明日天山山下路，不须回首望都门。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2175,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其九","author":"元好问","text":"炉薰浥浥带轻阴，翠竹高梧水殿深。\n去去旃车雪三尺，画罗休缕麝香金。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2176,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其十","author":"元好问","text":"苦才多思是春风，偏近骚人怅望中。\n啼尽杜鹃枝上血，海棠明日更应红。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2177,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其十一","author":"元好问","text":"暖日晴云锦树新，风吹雨打旋成尘。\n宫园深闭无人到，自在流莺哭暮春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2178,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"俳体雪香亭杂咏十二首 其十二","author":"元好问","text":"暮云楼阁古今情，地老天荒恨未平。\n白发累臣几人在，就中愁杀庾兰成。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2179,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"记梦","author":"元好问","text":"天上材官老不材，从教兀兀走尘埃。\n梦中望拜通明殿，曾见金书两字来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2180,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杂著二首 其一","author":"元好问","text":"六朝琼树掌中春，回首胡妆一面新。\n生羡石家金谷里，千年独有坠楼人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2181,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杂著二首 其二","author":"元好问","text":"燕语莺啼百啭新，长廊寂寂不逢人。\n东君去作谁家客？\n花柳无情各自春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2182,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"眉","author":"元好问","text":"石绿香煤浅淡间，多情长带楚梅酸。\n小诗拟写春愁样，忆著分明下笔难。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2183,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出都","author":"元好问","text":"春闺斜月晓闻莺，信马都门半醉醒。\n官柳青青莫回首，短长亭是断肠亭。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2184,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"姨母陇西君讳日作","author":"元好问","text":"宝镜煌煌照九州，埋藏曾及见诸刘。\n酆城今日无雷焕，紫气谁当辨斗牛。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2185,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自赵庄归冠氏","author":"元好问","text":"杏园红过雪披离，杨柳无风绿线齐。\n寒食人家在原野，乳鸦墙外尽情啼。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2186,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济南杂诗五首 其一","author":"元好问","text":"儿时曾过济南城，暗算存亡只自惊。\n四十二年弹指过，却疑行处是前生。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2187,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济南杂诗五首 其二","author":"元好问","text":"吴儿洲渚似神仙，罨画溪光碧玉泉。\n别有洞天君不见，鹊山寒食泰和年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2188,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济南杂诗五首 其三","author":"元好问","text":"石刻烧残宴集辞，雄楼杰观想当时。\n只应画戟清香地，多欠韦郎五字诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2189,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济南杂诗五首 其四","author":"元好问","text":"白烟销尽冻云凝，山月飞来夜气澄。\n且向波间看玉塔，不须桥畔觅金绳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2190,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济南杂诗五首 其五","author":"元好问","text":"荷叶荷花烂熳秋，鹭鸶飞近钓鱼舟。\n北城佳处经行遍，留著南山更一游。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2191,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题刘才卿湖石扇头","author":"元好问","text":"幽涧云凝雨未乾，曲池疏竹共荒寒。\n扇头唤起西园梦，好似熙春阁下看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2192,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"闻歌怀京师旧游","author":"元好问","text":"楼前谁唱《绿腰》催，千里梁园首重回。\n记得杜家亭子上，信之钦用共听来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2193,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出镇州","author":"元好问","text":"汾水归心日夜流，孤云飞处是松楸。\n无端行近还乡路，却傍西山入相州。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2194,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南关二首 其一","author":"元好问","text":"风里秋蓬不自由，一生几度过隆州。\n无情团柏关前水，流尽朱颜到白头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2195,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"南关二首 其二","author":"元好问","text":"路转川回失系舟，更教两驿过徐沟。\n多情团柏关前水，却共清汾一处流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2196,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"马坊冷大师清真道院","author":"元好问","text":"枯蒲折苇障清湾，十里风荷指顾间。\n安得西湖展江手，乱铺云锦浸青山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2197,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游天坛杂诗五首 其一","author":"元好问","text":"芳树阴阴鸟语哗，绿云晴雪映红霞。\n青山可是堪人恨，藏著中岩十里花。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2198,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游天坛杂诗五首 其二","author":"元好问","text":"漫山白白与红红，小树低丛看不供。\n总道楂花香气好，就中偏爱玉珑松。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2199,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游天坛杂诗五首 其三","author":"元好问","text":"溪童相对采椿芽，指似阳坡说种瓜。\n想得近山营马少，青林深处有人家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2200,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游天坛杂诗五首 其五","author":"元好问","text":"仙坛倒影凤麟洲，一道云光插素秋。\n也是天公閒不得，海东移著海西头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2201,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"初挈家还读书山杂诗二首 其一","author":"元好问","text":"天门笔势到閒閒，相国文章玉笋班。\n从此晋阳方志上，系舟山是读书山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2202,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"初挈家还读书山杂诗二首 其二","author":"元好问","text":"眼中华屋记生存，旧事无人可共论。\n老树婆娑三百尺，青衫还见读书孙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2203,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其一","author":"元好问","text":"老眼惊看节物新，今年更与酒杯亲。\n东山一道花如绣，从此他乡不是春。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2204,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其二","author":"元好问","text":"香中人道睡香浓，谁信丁香臭味同。\n一树百枝千万结，更应薰染费春工。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2205,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其三","author":"元好问","text":"生红点点弄娇妍，半拆花房更可怜。\n传语春风好将护，莫教容易作银钱。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2206,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其四","author":"元好问","text":"红抹兰膏绿染衣，绿娇红小两相宜。\n华边剩有清香在，木石痴儿自不知。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2207,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其五","author":"元好问","text":"素艳来从月姊家，温风淑气发清华。\n人间自有交枝玉，天上休开六出花。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2208,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其六","author":"元好问","text":"昨日桃花锦片新，兔葵今日到残春。\n低枝留得稀疏朵，比似全开更恼人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2209,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"赋瓶中杂花七首 其七","author":"元好问","text":"古铜瓶子满芳枝，裁剪春风入小诗。\n看看海棠如有语，杏花也到退房时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2210,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杜生绝艺","author":"元好问","text":"杜生绝艺两弦弹，穆护沙词不等閒。\n莫怪曲终双泪落，数声全似古《阳关》。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2211,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"德华小女五岁能诵予诗数首以此诗为赠","author":"元好问","text":"牙牙娇语总堪誇，学念新诗似小茶。\n好个通家女兄弟，海棠红点紫兰芽。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2212,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"春归","author":"元好问","text":"野杏溪桃三两枝，春归也作送春诗。\n东君自爱长安好，能住山城得几时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2213,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"发南楼度雁门关二首 其一","author":"元好问","text":"鸡声未动发南楼，涧水随人向北流。\n欲望读书山远近，雁门关上懒回头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2214,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"发南楼度雁门关二首 其二","author":"元好问","text":"棱磳石磴倚高梯，穹谷无人绿树齐。\n总为古来征戍苦，宿云常傍塞垣低。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2215,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自题中州集后五首 其一","author":"元好问","text":"邺下曹刘气尽豪，江东诸谢韵尤高。\n若从华实评诗品，未便吴侬得锦袍。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2216,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自题中州集后五首 其二","author":"元好问","text":"陶谢风流到百家，半山老眼净无花。\n北人不拾江西唾，未要曾郎借齿牙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2217,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自题中州集后五首 其三","author":"元好问","text":"万古骚人呕肺肝，乾坤清气得来难。\n诗家亦有长沙帖，莫作宣和阁本看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2218,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自题中州集后五首 其四","author":"元好问","text":"文章得失寸心知，千古朱弦属子期。\n爱杀溪南辛老子，相从何止十年迟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2219,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自题中州集后五首 其五","author":"元好问","text":"平世何曾有稗官，乱来史笔亦烧残。\n百年遗稿天留在，抱向空山掩泪看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2220,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"讲武城","author":"元好问","text":"作计千年复万年，似嫌蒸土不能坚。\n祇今讲武人何在？\n衰柳残阳有乱蝉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2221,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"药山道中","author":"元好问","text":"西风砧杵日相催，著破征衣整未回。\n白雁已衔霜信过，青林閒送雨声来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2222,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"黄华峪十绝句 其一","author":"元好问","text":"岱崧王屋旧经过，自倚胸中胜概多。\n独欠太行高绝处，青天白日看山河。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2223,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]