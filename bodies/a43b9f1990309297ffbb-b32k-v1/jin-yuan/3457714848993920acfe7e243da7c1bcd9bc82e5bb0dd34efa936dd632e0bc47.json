[{"title":"续小娘歌十首 其二","author":"元好问","text":"北来游骑日纷纷，断岸长堤是阵云。\n万落千村藉不得，城池留著护官军。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2023,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其四","author":"元好问","text":"青山高处望南州，漫漫江水绕城流。\n愿得一身随水去，直到海底不回头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2024,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其五","author":"元好问","text":"风沙昨日又今朝，踏碎鸦头路更遥。\n不似南桥骑马日，生红七尺系郎腰。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2025,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其七","author":"元好问","text":"竹溪梅坞静无尘，二月江南烟雨春。\n伤心此日河平路，千里荆榛不见人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2026,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其八","author":"元好问","text":"太平婚嫁不离乡，楚楚儿郎小小娘。\n三百年来涵养出，却将沙漠换牛羊。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2027,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其九","author":"元好问","text":"饥乌坐守草间人，青布犹存旧领巾。\n六月南风一万里，若为白骨便成尘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2028,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"续小娘歌十首 其十","author":"元好问","text":"黄河千里扼兵冲，虞虢分明在眼中。\n为向淮西诸将道，不须誇说蔡州功。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2029,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"怀益之兄","author":"元好问","text":"世故伊川叹，乡情越客音。\n天宜他日定，陆已向来沈。\n冉冉愁看老，源源事益侵。\n谁言易排遣，自分不胜任。\n鞭影惊疲马，钟声急暮禽。\n局中无旷迹，喧外有幽寻。\n梦失名家笔，书存遗子金。\n山田和石瘦，茅屋过云深。\n春雨蔬成圃，秋霜柿满林。\n树阴凉拂席，花气澹盈襟。\n宿鹭窥晨汲，孤猿伴暝吟。\n溪僧时问字，野客或知琴。\n抱璞休奇售，临觞得缓斟。\n阿兄团聚日，曾语百年心。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2030,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"汴禅师自斲普照石为研以诗见饷为和二首 其一","author":"元好问","text":"寺废瓦不毁，研奇功亦多。\n已知良斲少，更奈苦心何！\n挺挺刚无敌，津津润可呵。\n羽阳陵谷变，冰井字书讹。\n赠比黄金璞，辞惭紫石歌。\n遥知玉音在，洗耳俟研磨。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2031,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"汴禅师自斲普照石为研以诗见饷为和二首 其二","author":"元好问","text":"点化铅仍见，坚凝铁易穿。\n何年埋朽壤，此日睹青天。\n古色秋烟重，哀音夜雨悬。\n有刀堪切玉，是镜不名砖。\n佛荫沦空劫，书林结后缘。\n禅河一勺水，更拟就师传。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2032,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"癸巳除夜","author":"元好问","text":"鼎定周元重，薪安汉已然。\n不随南渡马，虚泛北归船。\n身并枯蜩化，心争脱兔先。\n尘埃嗟落泊，光景强留连。\n往事青灯里，浮生白发前。\n更残钟未动，犹属出京年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2033,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"病中","author":"元好问","text":"战胜颇自恃，宁知从外腴。\n文章工作祟，时运迫摧枯。\n止酒嗟何及，烧猪本不图。\n膏梁无急变，山泽有真臞。\n诗信藤条戏，方遭铁弹诬。\n盐红忘后顾，黧黑见前驱。\n眩入投床仆，晨淹伏枕呼。\n万钱惟呕泄，一脔尔乘除。\n静伏心仍悸，深调息亦粗。\n局嫌囚宇宙，渴忆卷江湖。\n风柳留蝉蜕，霜松映鹤孤。\n养和惩往失，扶老念时须。\n杯杓归神誓，垣墙任佛踰。\n回蹊且垂翅，望或在桑榆。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2034,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"老树","author":"元好问","text":"老树高留叶，寒藤细作花。\n沙平时泊雁，野迥已攒鸦。\n旋食秋看尽，行吟日又斜。\n干戈正飘忽，不用苦思家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2035,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"阳翟道中","author":"元好问","text":"长路伶俜里，羁怀苍莽中。\n千山分晚照，万籁入秋风。\n频见参旗缩，虚传朔幕空。\n故园归未得，细问北来鸿。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2036,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"太室同希颜赋","author":"元好问","text":"壮矣崧维岳，盘盘上窈冥。\n中天瞻巨镇，元气有遗形。\n雨入秦川黑，云开楚岫青。\n鳌掀一柱在，万古压坤灵。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2037,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送登封张令西上","author":"元好问","text":"罢县人称屈，悠悠复此行。\n渭城秋雁到，秦岭暮云平。\n道路衣从典，风尘剑已鸣。\n山西多侠客，莫说是书生。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2038,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送曹吉甫兼及通甫","author":"元好问","text":"意气羡君豪，怜君屈骑曹。\n安能事笔砚，且复混弓刀。\n风雪貂裘暗，关山马骨高。\n南飞见鸿雁，应为惜哀劳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2039,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"胜概","author":"元好问","text":"胜概烟尘外，新诗杖屦间。\n偶随流水去，澹与暮云还。\n吾道三缄口，时情一解颜。\n从今便高卧，已负半生閒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2040,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"落魄","author":"元好问","text":"落魄宜多病，艰危更百忧。\n雨声孤馆夜，草色故园秋。\n行役鱼赪尾，归期乌白头。\n中州遂南北，残息付悠悠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2041,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"长寿新居","author":"元好问","text":"地古村墟迥，川回县郭斜。\n蒲池馀老节，菊水引新芽。\n卜筑欣成趣，归耕觉有涯。\n迎门顾儿女，今日是山家。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2042,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"十二月六日二首 其一","author":"元好问","text":"伥鬼跳梁久，群雄结构牢。\n天机不可料，世网若为逃。\n白骨丁男尽，黄金甲第高。\n阊门隔九虎，休续楚臣骚。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2043,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"十二月六日二首 其二","author":"元好问","text":"海内兵犹满，天涯岁又新。\n龙移失鱼鳖，日食斗麒麟。\n草棘荒山雪，烟花故国春。\n聊城今夜月，愁绝未归人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2044,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"短日","author":"元好问","text":"短日砧声急，重云雁影深。\n风霜侵晚节，天地入归心。\n零落沟中断，酸嘶爨下音。\n五年朝与夕，清血几沾襟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2045,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送杨次公兼简秦彦容李天成","author":"元好问","text":"海国山如染，云堆草易荒。\n时危频虎穴，路绝更羊肠。\n吊影双蓬鬓，携家一药囊。\n殷勤秦与李，无惜借馀光。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2046,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"倪庄中秋","author":"元好问","text":"强饭日逾瘦，裌衣秋已寒。\n儿童漫相忆，行路岂知难。\n露气入茅屋，溪声喧石滩。\n山中夜来月，到晓不曾看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2047,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"阳兴砦","author":"元好问","text":"乱石通樵径，重冈拥戍城。\n山川带淳朴，鸡犬见升平。\n雨烂沙仍软，秋偏气自清。\n年年避营马，几向此中行。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2048,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"聚仙台夜饮","author":"元好问","text":"永夜留欢席，高怀远市尘。\n月凉衣有露，风细酒生鳞。\n乡社情亲旧，仙台姓字新。\n殷勤诗卷在，长记坐中人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2049,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"十月四日往关南","author":"元好问","text":"行路见新月，独行还独谣。\n劳生尘衮衮，晚色鬓萧萧。\n野旷无遗穗，林疏有堕樵。\n回头麦山岭，更觉马蹄遥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2050,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和仲梁","author":"元好问","text":"林影兼秋薄，云阴带晚凉。\n石潭鱼近藻，沙渚雁留霜。\n笑语无长路，登临岂异乡。\n一尊堪共醉，惜不是重阳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2051,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"感事","author":"元好问","text":"壮事本无取，老谋何所成？\n人皆传已死，吾亦厌馀生。\n潦倒封侯骨，淹留混俗情。\n百年堪一笑，辛苦惜虚名。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2052,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"同冀文明秀山行","author":"元好问","text":"暮景披横幅，山间二老同。\n云如愁戍苦，雪亦笑诗穷。\n古木冻欲折，断崖行复通。\n从今胡谷梦，时到水声中。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2053,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"庚子三月十日作","author":"元好问","text":"残梦忘书帙，馀寒殢酒杯。\n青铜元懒照，白纻更宽裁。\n水际时独往，花边知几回。\n殷勤双语燕，应自谢家来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2054,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"甲寅十二月四日出镇阳寄宰鲁伯","author":"元好问","text":"滹水晓光动，灞桥诗境同。\n冲寒骑瘦马，认影识衰翁。\n长路风声里，孤城雪意中。\n回头歌笑处，凄绝意何穷。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2055,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"同姚公茂徐沟道中联句","author":"元好问","text":"路转川涂阔，天低雨气昏。\n绵山连汉垒，汾水入并门。\n来往频鞍马，登临负酒樽。\n联诗强一笑，凄绝恐销魂。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2056,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"帝城","author":"元好问","text":"帝城西下望孤云，半废晨昏愧此身。\n世俗但知从仕乐，书生只合在家贫。\n悠悠未了三千牍，碌碌翻随十九人。\n预遣儿书报归日，安排鸡黍约比邻。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2057,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"仆射陂醉归即事","author":"元好问","text":"多生曾得江湖乐，每见陂塘觉眼明。\n诗酒共寻前日约，风阴新自夜来晴。\n春波澹澹沙鸟没，野色荒荒烟树平。\n醉踏扁舟浩歌起，不须红袖出重城。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2058,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"春日","author":"元好问","text":"里社春盘巧欲争，裁红晕碧助春情。\n忽惊此日仍为客，却想当年似隔生。\n贫里齑盐怜节物，乱来歌吹失欢声。\n南州剩有还乡伴，戎马何时道路清。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2059,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"野菊，座主閒閒公命作 其一","author":"元好问","text":"柴桑人去已千年，细菊班班也自圆。\n共爱鲜明照秋色，争教狼藉卧疏烟。\n荒畦断垄新霜后，瘦蝶寒螀晚景前。\n只恐春丛笑迟暮，题诗端为发幽妍。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2060,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"昆阳二首 其二","author":"元好问","text":"去日黄花半未开，南来忽复见寒梅。\n淹留岁月无馀物，料理尘埃有此杯。\n老马长途良惫矣，白鸥春水亦悠哉！\n商馀说有沧洲趣，早晚乾坤入钓台。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2061,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"叶县雨中","author":"元好问","text":"春旱连延入麦秋，今朝一雨散千忧。\n龙公有力回枯槁，客子何心叹滞留。\n多稼即看连楚泽，归云应亦到崧丘。\n兵尘浩荡乾坤满，未厌明河拂地流。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2062,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"山中寒食","author":"元好问","text":"小雨班班浥曙烟，平林簇簇点晴川。\n清明寒食连三月，颍水崧山又一年。\n乐事渐随花共减，归心长与雁相先。\n平生最有登临兴，百感中来只慨然。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2063,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"楚汉战处","author":"元好问","text":"虎掷龙挐不两存，当年曾此赌乾坤。\n一时豪杰多行阵，万古山河自壁门。\n原野犹应厌膏血，风云长遣动心魂。\n成名竖子知谁谓？\n拟唤狂生与细论。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2064,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"后湾别业","author":"元好问","text":"薄云晴日烂烘春，高柳清风便可人。\n一饱本无华屋念，百年今见老农身。\n童童翠盖桑初合，滟滟苍波麦已匀。\n便与溪塘作盟约，不应重遣濯缨尘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2065,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寄钦用","author":"元好问","text":"憔悴京华苜蓿盘，南山归兴夜漫漫。\n长门有赋人谁买？\n坐榻无毡客亦寒。\n虫臂偶然烦造物，獐头何者亦求官。\n故人东望应相笑，世路羊肠乃尔难。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2066,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"内乡县斋书事","author":"元好问","text":"吏散公庭夜已分，寸心牢落百忧熏。\n催科无政堪书考，出粟何人与佐军。\n饥鼠绕床如欲语，惊乌啼月不堪闻。\n扁舟未得沧浪去，惭愧舂陵老使君。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2067,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"除夜","author":"元好问","text":"一灯明暗夜如何，梦寐衡门在涧阿。\n物外烟霞玉华远，花时车马洛阳多。\n折腰真有陶潜兴，扣角空传宁戚歌。\n三十七年今日过，可怜出处两蹉跎。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2068,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"刘光甫内乡新居","author":"元好问","text":"廌冠平日凛秋霜，老去声名只闭藏。\n父老渐来同保社，儿童久已爱文章。\n蔬随隙地皆成圃，竹放新梢欲过墙。\n为向长安旧游道，世间元有北窗凉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2069,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"西斋夜宴","author":"元好问","text":"飘零无物慰天涯，酒伴相逢饮倍加。\n误谬君当略彭泽，回旋我亦笑长沙。\n金钗翠亸迎春髻，银烛光摇半夜花。\n只欠东山游录事，不来坚坐看纷哗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2070,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"出山","author":"元好问","text":"松门石径静无关，布袜青鞋几往还。\n少日漫思为世用，中年直欲伴僧闲。\n尘埃长路仍回首，升斗微官亦强颜。\n休道西山不留客，数峰如画暮云间。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2071,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岐阳三首 其一","author":"元好问","text":"突骑连营鸟不飞，北风浩浩发阴机。\n三秦形胜无今古，千里传闻果是非。\n偃蹇鲸鲵人海涸，分明蛇犬铁山围。\n穷途老阮无奇策，空望岐阳泪满衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2072,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岐阳三首 其三","author":"元好问","text":"眈眈九虎护秦关，懦楚孱齐几上看。\n禹贡土田推陆海，汉家封檄自天山。\n北风猎猎悲笳发，渭水萧萧战骨寒。\n三十六峰长剑在，倚天仙掌惜空闲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2073,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雨后丹凤门登眺","author":"元好问","text":"绛阙遥天霁景开，金明高树晚风回。\n长虹下饮海欲竭，老雁叫云秋更哀。\n劫火有时归变灭，神嵩何计得飞来。\n穷途自觉无多泪，莫傍残阳望吹台。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2074,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"怀秋林别业","author":"元好问","text":"茅屋萧萧淅水滨，岂知身属洛阳尘。\n一家风雪何年尽，二顷田园入梦频。\n高树有巢鸠笑拙，空墙无穴鼠嫌贫。\n西南遥望肠堪断，自古虚名只误人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2075,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"壬辰十二月车驾东狩后即事五首 其一","author":"元好问","text":"翠被匆匆见执鞭，戴盆郁郁梦瞻天。\n只知河朔归铜马，又说台城堕纸鸢。\n血肉正应皇极数，衣冠不及广明年。\n何时真得携家去，万里秋风一钓船。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2076,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"壬辰十二月车驾东狩后即事五首 其三","author":"元好问","text":"郁郁围城度两年，愁肠饥火日相煎。\n焦头无客知移突，曳足何人与共船。\n白骨又多兵死鬼，青山元有地行仙。\n西南三月音书绝，落日孤云望眼穿。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2077,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"壬辰十二月车驾东狩后即事五首 其五","author":"元好问","text":"五云宫阙露盘秋，银汉无声桂树稠。\n复道渐看连上苑，戈船仍拟下扬州。\n曲中青冢传新怨，梦里华胥失旧游。\n去去江南庾开府，凤凰楼畔莫回头。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2078,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"癸巳四月二十九日出京","author":"元好问","text":"塞外初捐宴赐金，当时南牧已骎骎。\n只知灞上真儿戏，谁谓神州竟陆沈。\n华表鹤来应有语，铜盘人去亦何心。\n兴亡谁识天公意？\n留著青城阅古今。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2079,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"喜李彦深过聊城","author":"元好问","text":"围城十月鬼为邻，异县相逢白发新。\n恨我不如南去雁，羡君独是北归人。\n言诗匡鼎功名薄，去国虞翻骨相屯。\n老眼天公只如此，穷途无用说悲辛。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2080,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"与张杜饮","author":"元好问","text":"故人寥落晓天星，异县相逢觉眼明。\n世事且休论向日，酒尊聊喜似承平。\n山公倒载群儿笑，焦遂高谈四座惊。\n轰醉春风一千日，愁城从此不能兵。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2081,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"秋夕","author":"元好问","text":"小簟凉多睡思清，一窗风雨送秋声。\n频年但觉貂裘敝，万古何曾马角生。\n寄食且依严尹幕，附书谁住邓州城？\n洗愁欲问东家酒，恨杀寒鸡不肯鸣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2082,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梦归","author":"元好问","text":"憔悴南冠一楚囚，归心江汉日东流。\n青山历历乡国梦，黄叶萧萧风雨秋。\n贫里有诗工作祟，乱来无泪可供愁。\n残年兄弟相逢在，随分齑盐万事休。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2083,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"淮右","author":"元好问","text":"淮右城池几处存，宋州新事不堪论。\n辅车谩欲通吴会，突骑谁当捣蓟门。\n细水浮花归别涧，断云含雨入孤村。\n空馀韩偓伤时泪，留与累臣一断魂。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2084,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"秋夜","author":"元好问","text":"九死馀生气息存，萧条门巷似荒村。\n春雷谩说惊坯户，皎日何曾入覆盆。\n济水有情添别泪，吴云无梦寄归魂。\n百年世事兼身事，尊酒何人与细论！","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2085,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]