[{"title":"赠琴士任先生","author":"段成己","text":"翛然天地一癯仙，误落红尘二十年。\n万事戏成云过眼，一身蹭蹬雪盈颠。\n扶头欲写卷中趣，洗耳试听徽外弦。\n他日遂君林下约，月明风露净娟娟。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2512,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乐郎中萱草堂","author":"段成己","text":"共道传家以义方，长留春色在萱堂。\n静宜有寿何须祝，乐自无忧不待忘。\n华萼先辉连二妙，琏琳照映列诸郎。\n要看靴笏床俱满，岁月灵椿未易量。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2513,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"容安轩","author":"段成己","text":"走遍人閒行路难，归来始觉此心安。\n半椽自覆人应笑，两膝足容吾已宽。\n阶下兰生犹可佩，篱边菊老尽供餐。\n微躯此外无多事，一炷清香篆曲盘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2514,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"总管陇西公归自赵城以雪途行役见命赋此以献","author":"段成己","text":"晓鞍催发五更钟，王事悤悤不易从。\n雪气空濛迷马首，霜威跋扈袭裘茸。\n谁家村落鸡频唱，到处园林鸟绝踪。\n却忆云山旧栖地，拥衾高卧养吾慵。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2515,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"万夫长李侯西觐回作诗为贺 其一","author":"段成己","text":"帷幄雍容拥万夫，雄襟英概汉臧吴。\n獠儿坐失重岩阻，战士争先九折驱。\n去日旌旂填蜀道，归时笳鼓竟尧都。\n谬为门下登龙客，拟颂勤劳愧腐儒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2516,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"万夫长李侯西觐回作诗为贺 其二","author":"段成己","text":"坐拥貔貅十万夫，雍容帷幄看投壶。\n威风栗烈前无敌，胆气轮囷大满躯。\n铜柱直期标百粤，连城潜觉失全吴。\n江南公事行将毕，愿献扁舟范蠡图。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2517,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乘兴杖屦山麓值梅始花裴回久之因折数枝置之几侧灯下漫浪成语简诸友一笑云 其二","author":"段成己","text":"漏泄春光人未知，轻红已透最高枝。\n洗妆自有天然态，尽道冰容不入时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2518,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"光得道中","author":"段成己","text":"行行不觉到斜阳，顾影频惊尔许长。\n返照此身还此是，莫因外景便承当。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2519,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和答陈子京 其一","author":"段成己","text":"扰扰浮生等聚嬉，风波千丈渺无涯。\n掩关一卷床头易，冷眼徒渠笑绝痴。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2520,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和答陈子京 其二","author":"段成己","text":"云山咫尺阻同嬉，望断音容天一涯。\n闻道城居最堪隐，想君为计未全痴。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2521,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其一 忆","author":"段成己","text":"初谒琼浆记昔年，迎门一笑想嫣然。\n夜来雪暗前村路，恨满东风意不传。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2522,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其二 梦","author":"段成己","text":"神久尘缘久未忘，飘然随月到高唐。\n欢情未接还惊觉，云雨阳台空断肠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2523,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其三 寻","author":"段成己","text":"玉想形容霞想裾，云英自与世姬殊。\n几年来往蓝桥路，捣尽玄霜得见无。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2524,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其四 探","author":"段成己","text":"未尝亲到谢家堂，风韵何由识谢娘。\n说与选花场上客，须知林下胜闺房。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2525,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其七 浸","author":"段成己","text":"洛浦飘飘信有神，淩波忽睹一枝春。\n摩挲老眼看微步，旎旎香生罗袜尘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2526,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其八 浴","author":"段成己","text":"洗尽铅华见玉环，肌肤冰雪照人寒。\n临风脉脉娇无力，轻裛香罗半未乾。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2527,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其九 惜","author":"段成己","text":"襟袂翛然风味酸，北人谁识蔡姬贤。\n可怜抛却清伊月，埋没边沙二十年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2528,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其一 海棠风","author":"段成己","text":"宿酒微醒不自持，君王催唤太真妃。\n醉红睡起依然在，忙倩罗纨为解围。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2529,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其二 杨柳烟","author":"段成己","text":"九原唤起李夫人，谁炷仙香为返魂。\n一捻宫腰浑瘦损，舞衣微带瑞云痕。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2530,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其七 梅花月","author":"段成己","text":"别后盟言不忍寒，旧官到底胜新官。\n情缘未断还相见，人复团圆镜复完。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2531,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其八 山茶雪","author":"段成己","text":"飘飘天上谪仙人，尝作金銮侍从臣。\n老大风流殊未减，锦袍如旧白头新。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2532,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其一 禹门雪浪","author":"段成己","text":"峡束洪流起怒涛，乱翻晴雪与云高。\n徐看行处元无事，小处区区枉用劳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2533,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其三 疏属晴岚","author":"段成己","text":"云拖残雨敛前峰，翠色寒光溢几重。\n应有诗人偏著眼，时施膏沐为渠容。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2534,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其四 双峰并秀","author":"段成己","text":"云外亭亭耸翠环，天荒地老两峰閒。\n若教工部尝经眼，未肯将诗誉玉山。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2535,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其五 神谷藏春","author":"段成己","text":"山閒草木四时新，一脉清溪不染尘。\n忽见渔郎惊借问，却疑侬是武陵人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2536,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其七 姑山夕照","author":"段成己","text":"日锁群峰欲下迟，茏葱一片冷胭脂。\n醉吟著我扁舟尾，画出坡游赤壁时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2537,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其一 蒲津晚渡","author":"段成己","text":"城下行舟一箭轻，城头落日半竿明。\n河流汹汹风仍急，时听浮空欸乃声。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2538,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其三 舜殿薰风","author":"段成己","text":"烦暑人閒不可支，暂来陊殿独委蛇。\n南风一拂清如水，犹似当年解愠时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2539,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其五 东林夜雨","author":"段成己","text":"烟雨濛濛古梵宫，院庭深悄若无僧。\n林梢一点荧荧碧，知是层楼供佛灯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2540,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其六 栖岩叠巘","author":"段成己","text":"山色荧青不染尘，何年精舍构嶙峋。\n也知遍入閒人眼，为现云閒清净身。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2541,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其七 妫汭夕阳","author":"段成己","text":"妫水桥边日下迟，笼葱一片冷胭脂。\n山川良是风犹古，想像英皇下嫁时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2542,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其八 玉官飞湍","author":"段成己","text":"冷云深处漾寒清，千仞悬流玉练明。\n车马往来山下路，何人到此濯尘缨。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2543,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"幽居奉借遁庵尊兄严韵呈隐之润之二英弟一粲 其一","author":"段成己","text":"解鞍借榻避风埃，净拂风轩待我开。\n诗句堕前还忘却，聊书岁月记曾来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2544,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"幽居奉借遁庵尊兄严韵呈隐之润之二英弟一粲 其二","author":"段成己","text":"浮荣过眼等浮埃，尊酒相逢一笑开。\n门外红尘高万丈，莫教一点鬓边来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2545,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"幽居奉借遁庵尊兄严韵呈隐之润之二英弟一粲 其三","author":"段成己","text":"小轩如斗静无埃，面向青山好处开。\n漫道幽人招不得，一尊今日为君来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2546,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张信夫梦庵 其一","author":"段成己","text":"忆昔邯郸道上行，半生回首梦初惊。\n而今始觉非真实，过眼浮云万事轻。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2547,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张信夫梦庵 其三","author":"段成己","text":"一身栩栩复蘧蘧，为蝶为周我自如。\n寤寐人閒第游戏，此身无地不华胥。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2548,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张信夫梦庵 其四","author":"段成己","text":"世味迷人又不知，纷纷蕉鹿竟奚为。\n山翁正坐山堂上，笑问黄粱第几炊。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2549,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其一","author":"段成己","text":"几年奔走趁槐黄，两脚红尘驿路长。\n梦破邯郸成独笑，半生回首只空忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2550,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其二","author":"段成己","text":"西风浩浩塞尘黄，白发缘愁若个长。\n客梦五更惊忽断，打门县吏索租忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2551,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其三","author":"段成己","text":"一裘谁为制玄黄，无可奈何秋夜长。\n我自忍穷方未暇，不知蛮触战争忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2552,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其四","author":"段成己","text":"一苇初航十里黄，故园归计渺何长。\n可怜兀兀青灯下，还似当年举子忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2553,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其五","author":"段成己","text":"小园苏茹待秋黄，不事姜盐味自长。\n口腹累人良可笑，可能终岁为渠忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2554,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和杨彦衡见寄之作 其六","author":"段成己","text":"幽迹无心学绮黄，荒才涉世本非长。\n年年来往燕然道，却为山林有限忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2555,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"古瓶梅花为总管李侯赋","author":"段成己","text":"锦帐银屏浸玉肌，风流应自有人知。\n夜深窗下横疏影，绝胜西湖月上时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2556,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送冯资深归西山 其五","author":"段成己","text":"别离最苦暮年时，百感中来不易支。\n此去故园行乐处，诗成毋吝寄相思。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2557,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"徽宗墨竹","author":"段成己","text":"野禽背立岁寒枝，想见当年落笔时。\n吮墨缀辞俱丧国，九泉笑杀李家儿。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2558,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"兰氏自然斋","author":"段成己","text":"万事荣枯一笑閒，情知使尼定谁关。\n编茅依石宽如斗，卧看溪云出岫还。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2559,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张世杰经历牧牛图 其一","author":"段成己","text":"绿阴深处戏童儿，牛自东西儿不知。\n休说儿狂无伎俩，人閒何事不儿嬉。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2560,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张世杰经历牧牛图 其二","author":"段成己","text":"断烟荒草淡无姿，写入人牛自在时。\n毁瓦一欢聊尔耳，不知何者是盈亏。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2561,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张世杰经历牧牛图 其三","author":"段成己","text":"儿自嬉游牛自眠，葛洪矶畔旧因缘。\n三生石上精魂在，一梦回头又几年。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2562,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杨茂之志适轩 其一","author":"段成己","text":"坐笑行吟困即眠，心游随处莫非天。\n是中真意何人会，隐几蓬窗正嗒然。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2563,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"杨茂之志适轩 其二","author":"段成己","text":"人心自有一羲皇，说著元来更话长。\n诗句堕前还忘却，坐看杯影转虚廊。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2564,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"秋日牡丹为友人赋病久无佳思姑作俳语三章以应命对觞一呼卢可也 其一","author":"段成己","text":"诉尽中情为两诗，可怜谁识汉文姬。\n归来已觉秋风晚，标格犹应似旧时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2565,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"秋日牡丹为友人赋病久无佳思姑作俳语三章以应命对觞一呼卢可也 其二","author":"段成己","text":"秋雨潇潇无限思，妄凭羽客觅环儿。\n蓬莱日月非人世，不记梧桐落叶时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2566,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"秋日牡丹为友人赋病久无佳思姑作俳语三章以应命对觞一呼卢可也 其三","author":"段成己","text":"公子初离季隗时，丁宁私语两心知。\n从渠岁律春秋变，一点真心死不移。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2567,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"暇日意行姑射山下奉借遁庵先生山堂听雨韵简诗社诸君","author":"段成己","text":"散策步幽岩，所遇良可喜。\n恋恋蝶绕衣，涓涓泉入耳。\n俯仰天地閒，一物莫非已。\n暄妍坐阅春事芳，飘飘思与春风长。\n呼童置酒饮花下，风来满袖携花香。\n白白红红纷涧谷，恍然身世如河阳。\n东风吹落山头雨，山鸟催归共人语。\n拂苔便欲枕流卧，却恐傍人笑孙楚。\n眼看六合尘土满，归袂翩翩去何所。\n乘风更拟淩清空，人閒无处寻方蓬。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2568,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送寻正道","author":"段成己","text":"江边杨柳才堪折，陌上行人还又别。\n春光不解苦留人，两岸杨花飞白雪。\n江风摇摇吹绿波，欲别未别伤如何。\n愿君少住听我歌，后日重来白发多。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2569,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"寿家弟诚之","author":"段克己","text":"道行不得且栖迟，一唯谁传鲁仲尼。\n瑞世不求麟凤质，急难空赋鹡鸰诗。\n玉堂金马知何处，白石清泉有素期。\n但使平生忠义在，乐天知命复奚疑。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2570,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乙未人日饮范君子和酒酣赋诗呈座上诸君","author":"段克己","text":"正月七日春欲动，拂面东风力尚微。\n且贪席上宾朋乐，未觉平生事业非。\n青山绿水俱可隐，白发苍颜胡不归。\n会须高揖浮邱袂，千仞冈头一振衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2571,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"诔双峰兴上人","author":"段克己","text":"试圆石上再生身，啸月吟风性益真。\n解脱莲花祛梦幻，忽惊野马逐埃尘。\n双峰莫遂幽栖志，一钵谁为嫡嗣人。\n便恐丛林无正脉，为君一哭涕横陈。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2572,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和家弟诚之诗社燕之作 其三","author":"段克己","text":"人皆笑我我忘机，我爱青山直得归。\n肯学班超谋肉食，更怜京兆泣牛衣。\n心非理义乌能悦，道胜纷华是故肥。\n独坐钩帘心语口，回头四十五年非。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2573,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"癸卯春二月有五日卫生袭之诞日也座中生捧卮酒乞言因用景纯寿日诗韵以答盛意兼谢不敏","author":"段克己","text":"压倒诗人白与元，淋漓醉墨出佳篇。\n心澄寒玉泉中水，衣惹霜岩顶上烟。\n岁晚相依清士瘦，穷途渐觉曲生贤。\n黄冠野服从人笑，自断此生休问天。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2574,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自讼","author":"段克己","text":"无将大车尘冥冥，无迩宵人恶易形。\n吏部有书惭荐李，莱公当轴谬推丁。\n慎交已昧书中戒，悔过聊书座右铭。\n自是昌阳堪引寿，不须辛苦进猪苓。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2575,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"彦衡丧子乡社诸君皆有诗以慰其哀余忝交游之长乌能无言因赋此以赠之","author":"段克己","text":"昔年曾读乐天诗，晚岁情钟玉雪儿。\n今日为君重感叹，片时何意便乖离。\n迎门犹记牵衣笑，抚榻空怀涨乳悲。\n梦里不知生死隔，旧嬉游处细寻推。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2576,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"丁未新正与诗社诸公园亭宴集彦衡有诗众皆属和一时樽酒宾席之胜殆可乐也余虽老顾不可虚盛意勉为赋此","author":"段克己","text":"秋去冬来春又催，昆明信有劫馀灰。\n心游碧落丝千尺，梦绕琼林日几回。\n处世祇宜同鹿豕，和羹谁复忆盐梅。\n老来笔力犹强健，一首新诗酒一杯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2577,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"冯弟自北山来出其旧所为诗百馀篇虽未暇尽读尝鼎一脔足知馀味吾弟离群索居无师友之益能自道其所志盖绝无而仅有者也虽然掘井九仞而不及泉犹为弃井耳适汉臣张君见过论文话旧以及吾弟之贤因作诗许其所已能而勉其所未至以寄之幸时复观览以自警省勿徒实箧笥而已","author":"段克己","text":"少年事业莫蹉跎，听我尊前一曲歌。\n铸剑必期经百鍊，为文固自要三多。\n凡胎须得丹砂换，壮志休辞铁砚磨。\n平地为山由一篑，词源他日看银河。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2578,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]