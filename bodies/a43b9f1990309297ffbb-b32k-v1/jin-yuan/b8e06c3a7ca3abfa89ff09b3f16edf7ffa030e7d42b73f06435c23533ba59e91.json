[{"title":"幽怀用梦庵张丈韵 其四","author":"段成己","text":"起来乘霁看年华，便著芒鞋代鹿车。\n白水明边镕落日，碧天尽处散馀霞。\n决明点检无多实，甘菊商量有数花。\n满酌一杯都不计，人閒万事足安蛇。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2336,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"自寿","author":"段成己","text":"霏霏晴雪点吟须，飒飒秋风恋客裾。\n计拙每为妻子笑，病多还觉友朋疏。\n行年如此事无几，破屋翛然家有馀。\n浊酒一杯吾自乐，人閒富贵不关渠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2337,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"雨后漫成 其一","author":"段成己","text":"羁思纷纷不易裁，晚凉扶病独登台。\n翩翩幽鸟避人去，殷殷雷声送雨来。\n已分此身閒里老，且将笑口酒边开。\n安车待聘非吾事，休作姑山隐逸猜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2338,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"再和 其一","author":"段成己","text":"凉月娟娟玉半裁，晓风吹梦下瑶台。\n笛兼邻杵相和切，秋共羁愁一并来。\n到处溪山容我懒，违时颜面向谁开。\n少陵可笑行藏拙，独倚危楼刚自猜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2339,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"四和 其二","author":"段成己","text":"林外炊烟细若裁，诗情引上赋诗台。\n萤从杨柳梢头堕，雨向梧桐叶上来。\n华发萧萧秋更老，衡门寂寂昼慵开。\n终南佳处吾将老，仕宦休为捷径猜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2340,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"五和 其一","author":"段成己","text":"世事浮云不受裁，羊裘重觅子陵台。\n随人明月娟娟静，吹面凉风特特来。\n多技漫劳宁似拙，两眉深锁不如开。\n床头忘却糟糠酒，误作萧萧夜雨猜。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2341,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乘兴杖屦山麓值梅始花裴回久之因折数枝置之几侧灯下漫浪成语简诸友一笑云 其一","author":"段成己","text":"戏蝶游蜂总未知，小窗低亚两三枝。\n夜阑灯下横疏影，浑似西湖月上时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2342,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"乘兴杖屦山麓值梅始花裴回久之因折数枝置之几侧灯下漫浪成语简诸友一笑云 其三","author":"段成己","text":"幽香不许俗人知，才是东风第一枝。\n误认文君新睡足，读书窗下立移时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2343,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其五 乞","author":"段成己","text":"漏泄春光洛水傍，紫云名字袭人香。\n可能惠我黄昏伴，休笑分司御史狂。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2344,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梅花十咏 其六 嗅","author":"段成己","text":"玉骨那堪瘴雾伤，好将经卷伴南荒。\n坡仙鼻孔清如水，老觉朝云道气长。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2345,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其三 荷叶露","author":"段成己","text":"泉客将归返故渊，西风渺渺碧波寒。\n主人情厚无他赠，一把真珠泣翠盘。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2346,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其四 葵花日","author":"段成己","text":"恋恋天光下玉阶，明妃初出汉宫来。\n情知至死归无路，一点芳心誓不回。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2347,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其五 菊花霜","author":"段成己","text":"六宫试手学梅妆，曾见飞英点额傍。\n香粉嚼馀浓不散，唾花误染缕金裳。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2348,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"花木八咏 其六 芭蕉雨","author":"段成己","text":"忆别春容巳十年，回文锦就倩谁传。\n都将一掬伤心泪，洒向蛮溪数幅笺。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2349,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其二 云中暮雨","author":"段成己","text":"古垒云藏一径微，河山依旧昔人非。\n贪徵往古兴亡事，不觉城头雨湿衣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2350,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其六 仙掌擎月","author":"段成己","text":"月出山头未数竿，仙人掌上玉团团。\n瑞光冷射三千丈，绝胜碧莲峰下看。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2351,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"龙门八题 其八 汾水秋风","author":"段成己","text":"一曲刘郎发棹歌，欢情未已奈悲何。\n只今回首空陈迹，依旧秋风卷素波。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2352,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其二 虞坂晓行","author":"段成己","text":"林下晨鸡第一声，陇头残月伴人行。\n未知局促盐车下，老骥萧萧又几鸣。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2353,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"蒲州八咏 其四 首阳晴雪","author":"段成己","text":"薇歌一曲对西山，万古清愁老翠峦。\n望断空岩人不见，光摇银海玉峰閒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2354,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"和李生湛然闻杜鹃有感之作","author":"段成己","text":"五更枕上梦魂清，初听催归第一声。\n我本无家更安往，任渠啼血不关情。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2355,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张信夫梦庵 其二","author":"段成己","text":"觉时常笑梦时讹，梦觉其閒争几何。\n聊尔藏身大槐国，閒看明月上南柯。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2356,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送冯资深归西山 其一","author":"段成己","text":"人閒蛮触日干戈，暮四朝三都几何。\n此去莫忧瓶粟罄，西山雨足蕨薇多。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2357,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送冯资深归西山 其二","author":"段成己","text":"萧萧华发老书生，久欲归田计未成。\n喜听日边消息好，故山容得子真耕。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2358,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送冯资深归西山 其三","author":"段成己","text":"几年思虑漫营营，重见西山眼倍青。\n胸次无尘元自好，床头况有洗心经。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2359,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送冯资深归西山 其四","author":"段成己","text":"候门稚子喜归来，暖热那无酒一杯。\n抖擞满身尘土尽，襟怀还对好山开。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2360,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"书师岩卿蒲中八咏图后 其一","author":"段成己","text":"老大溪山入梦频，聊凭图画写情真。\n归欤不及身强健，山有英灵恐笑人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2361,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题张郎中明皇小决图二首 其一","author":"段成己","text":"志在驰驱祸已胎，笑颜况更为谁开？\n贪争飞鞠鞭?去，不觉踰垣有鹿来。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2362,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题张郎中明皇小决图","author":"段成己","text":"天宝承平事久无，弄丸驴背恣驰驱。\n不期一笑宫中戏，传作人閒小决图。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2363,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周生景纯赠菊数本因拾旧事依韵答之 其一","author":"段成己","text":"陈国君臣醉宴时，可怜璧月照琼枝。\n蔷薇露湿仙裳重，笑殢君王索好诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2364,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"周生景纯赠菊数本因拾旧事依韵答之 其二","author":"段成己","text":"万里文姬去国时，秋霜也到岁寒枝。\n归来满面黄尘暗，恐入西风马上诗。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2365,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"梁国祥静乐堂","author":"段成己","text":"攘攘区中人，役心名与利。\n于身竟何有，乾没无少置。\n叔敬有耳孙，荦荦与时异。\n一官不肯觅，閒居养高志。\n筑室尘境中，中有尘外意。\n方其厌嚣湫，归来得小憩。\n床头一卷书，净洗纷华累。\n苟能乐其乐，宁复事吾事。\n见客不吝情，有酒即成醉。\n为问东华尘，何如北窗睡。\n清风吹我怀，万事觉无味。\n谁知方寸閒，自有清凉地。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2366,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"苏氏承颜堂","author":"段成己","text":"登仙不羡飞双凫，宰官不乐纡金珠。\n行年四十著綵服，悲啼效作儿声呱。\n丈夫岂无四方志，倚闾望望心何如。\n家国无事寿觞举，慈颜得酒增和舒。\n客来草具对客食，杀鸡奉母其贤乎。\n荣华富贵固所愿，有子能尽如君谟。\n至诚不动古未有，悦亲自得神明扶。\n茁哉冬生孟林笋，圉焉日出姜泉鱼。\n古来孝感有如此，今人盖以古为模。\n尝闻古有色难戒，爱深容色何愉愉。\n诗成不觉涕泪俱，尔有母遗伤独无。\n他年谁作孝友传，请录吾语为君书。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2367,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"题秋暮山行图","author":"段成己","text":"乱山嵂崒争清妍，寒林寂历相绵联。\n人閒黄尘千万丈，一点不到山林边。\n秋光淡薄秋气爽，浮云积翠何葱芊。\n高风凄其脱木叶，向来面目仍增娟。\n江流一曲抱山麓，孤舟斜日栖江湍。\n行人何适来，负担腰膂?。\n荦确石头路，蹇驴鞭不前。\n人家前涂渺何许，望之不及忧悁悁。\n问公何从得此本，笔势髣髴营丘传。\n我本山中人，见之心惘然。\n崁■历落真可笑，对画题诗思昔年。","collection":"金末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2368,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"送孙仲文行台之召","author":"段成己","text":"仲也何人斯，不满六尺长。\n言议閒英发，入耳音琅琅。\n胸怀湛秋水，面目严清霜。\n读书及城旦，寓迹凫鹥行。\n自公少馀暇，婉愉奉高堂。\n甘旨未及亲，有饭不敢尝。\n颜色或未怡，綵衣戏亲傍。\n执丧三年中，哀慕如新丧。\n回思顾复劳，此意何时忘。\n日闻辟书下，且喜还且伤。\n捧檄念吾亲，不觉涕泗滂。\n拔英外台选，列布皆圭璋。\n掾吏须几人，亦必求循良。\n世人岂无才，要以德自将。\n纠擿谁弗能，吾心恐无常。\n诗人有明诫，茹柔吐其刚。\n孝为百行先，子孝吾既详。\n苟能推此心，前路未易量。\n慇勤养云翼，行矣勿悤忙。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2369,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"醒心亭","author":"段成己","text":"窗前流水玉泠泠，窗下高人酒半醒。\n唤省邯郸枕中梦，如看王湛案头经。\n翛然自得天游趣，恍若那知地境灵。\n说似功名场上客，倦游时节一来听。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2370,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"跋三堂王自写真","author":"段成己","text":"解衣盘礴真画史，不待濡毛知可矣。\n葛巾草服常画我，意欲置我山岩里。\n虎头于今几百年，与渠谁后复谁先。\n翛然蜕迹乘风去，一笑相逢喜拍肩。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2371,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"跋秦得真墨","author":"段成己","text":"晴窗不用辨犀纹，墨妙秦郎已饫闻。\n翠饼瑩如鸦背净，玉图香鄙麝脐薰。\n永宁赐弟今犹少，易水无良古亦云。\n老我愧非挥翰手，两丸投赠负伊勤。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2372,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"羽林行","author":"杨果","text":"银鞍白马鸣玉珂，风花三月燕支坡。\n侍中女夫领军事，黄金买断青楼歌。\n少年羽林出名字，随从武皇偏得意。\n当时事少游幸多，御马御衣尝得赐。\n年年春水复秋山，风毛雨血金莲川。\n归来宴贺满宫醉，山呼摇动东南天。\n明昌太和承平久，北人岁献蒲萄酒。\n一声长啸四海空，繁华事往空回首。\n悬瓠月落城上墙，天子死不为降王。\n羽林零落只君在，白头辛苦趋路旁。\n腰无长剑手无鎗，欲语前事涕满裳。\n洛阳城下岁垂暮，秋风秋气伤金疮。\n龙门流出伊河水，北望临潢八千里。\n蔡州新起髑髅台，只合当年抱君死。\n君家父兄健如虎，一旦仓皇变为鼠。\n锦衣新贵见莫嗤，得时失时今又悲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2373,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"老牛叹","author":"杨果","text":"老牛带月原上耕，耕儿怒呼嗔不行。\n瘢疮满背股流血，力乏不胜空哀鸣。\n日暮归家羸欲倒，水冷萁枯豆颗少。\n半夜风霜彻骨寒，梦魂犹绕桃林道。\n服箱曾作千金犍，负重致远人所怜。\n而今弃掷非故主，饱食不如盗仓鼠。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2374,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"过狄仁杰墓","author":"杨果","text":"牝鸡声里紫宸寒，神器都归窃弄间。\n一语唤回鹦鹉梦，九霄夺得凤雏还。\n荒坟寂寞临官道，清节孤高重泰山。\n为问模棱苏相国，当时相见果何颜？","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2375,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"登北邙山二首 其一","author":"杨果","text":"干戈丛里过壬辰，原上累累冢墓新。\n寒食清明几家哭，问来都是陈亡人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2376,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"登北邙山二首 其二","author":"杨果","text":"魏家池馆姚家宅，佳卉而今采作薪。\n水北水南三二月，旧时多少看花人。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2377,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"村居二首 其一","author":"杨果","text":"草堂有燕贺新成，沙渚无鸥续旧盟。\n满径落红风扫静，一渠春碧雨添平。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2378,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"村居二首 其二","author":"杨果","text":"春波澹澹卷寒漪，长日萧萧静竹扉。\n村舍蚕催桑叶大，山田鹿食麦苗稀。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2379,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"岘山秋晚图","author":"杨果","text":"江水江花绕大堤，太平歌舞习家池。\n而今风景那堪画，落日空城鸟雀悲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2380,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"游裴公亭","author":"杨果","text":"裴公亭满竹林风，王屋天坛在眼中。\n月桂不随春共老，池波直与海相通。\n珍羞恐负将军腹，时雨休归社鬼功。\n天子仁明百灵助，连村箫鼓废年丰。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2381,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"济渎庙祷雨感应","author":"杨果","text":"醮坛人散碧云沈，天表吾君爱物心。\n一雨霶?三万里，成汤无用祷桑林。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2382,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"仲坚见和复用韵以答 其二","author":"段克己","text":"赋就惭辞拙，书成共笑迂。\n学传三世旧，用处一分无。\n衰鬓频看镜，流年付挈壶。\n悠悠身外事，目断塞云孤。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2383,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"仲坚见和复用韵以答 其三","author":"段克己","text":"避事尝辞剧，为儒不厌迂。\n能贫从古少，好学似君无。\n行李书填案，生涯药满壶。\n缇萦真孝子，犹足慰茕孤。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2384,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"野步仍用韵示封张二子 其二","author":"段克己","text":"信步不知晚，归途那计迂。\n一欢閒里足，万籁静中无。\n藉草便成席，酌泉聊代壶。\n娟娟林外树，江月伴人孤。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2385,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"李山人湛然始生之朝座客各赋诗为寿亦作四韵以期所未至不特称道而己庶几尽朋友相成之义云","author":"段克己","text":"脱迹豺狼外，容身鹜雁閒。\n虚舟元不系，倦翼自知还。\n饮水犹能乐，编茆足可跧。\n莫教方寸地，空负一生閒。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2386,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"封仲坚挽词 其一","author":"段克己","text":"但怪经过少，那知生死分。\n穗帷徒见像，尊酒罢论文。\n楄柎人为具，邱坟志共闻。\n世无韩吏部，为尔借卢殷。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2387,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"封仲坚挽词 其二","author":"段克己","text":"窀穸无时旦，行年甫过先。\n归心终莫遂，遗恨竟空填。\n伯道名虽著，中郎业不传。\n素书功未卒，谁为理残编。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2388,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"封仲坚挽词 其三","author":"段克己","text":"卖药安垂老，看书祗自资。\n依依姑射恨，渺渺奉先思。\n谁恤萧存后，徒昌东野诗。\n孤魂招不得，独坐涕垂颐。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2389,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"封仲坚挽词 其四","author":"段克己","text":"萧散青牛客，伊余有素期。\n诗成先取示，酒熟预令知。\n夜被尝同覆，朝筇复共支。\n岂期行乐地，回首总成悲。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2390,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"封仲坚挽词 其五","author":"段克己","text":"谁谓如胶漆，中年永别离。\n崩摧五内热，契阔一生悲。\n对月听歌处，围炉把酒时。\n凄然独不见，何以慰相思。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2391,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"张器之雄飞亭","author":"段克己","text":"落魄张公子，身贫志不凋。\n鸾栖辞枳棘，鹏翼上扶摇。\n季子终怀印，相如竟过桥。\n香名脍人口，诗句大牛腰。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2392,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"九日山园小宴取五柳公采菊东篱下为韵赋诗侑觞 其一","author":"段克己","text":"世无李元礼，谁容孔北海。\n长歌归去来，篱菊无人采。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2393,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"九日山园小宴取五柳公采菊东篱下为韵赋诗侑觞 其二","author":"段克己","text":"古来贤哲人，饿死填空谷。\n清杯幸不空，且醉篱边菊。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2394,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"九日山园小宴取五柳公采菊东篱下为韵赋诗侑觞 其三","author":"段克己","text":"风雨山城暮，黄花自满丛。\n幽怀若为写，正要玉西东。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2395,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"九日山园小宴取五柳公采菊东篱下为韵赋诗侑觞 其四","author":"段克己","text":"爱酒陶元亮，持杯对菊枝。\n醉时催客去，犹复有藩篱。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2396,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"九日山园小宴取五柳公采菊东篱下为韵赋诗侑觞 其五","author":"段克己","text":"饥餐秋菊英，采采不盈把。\n日落四山昏，独坐衡门下。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2397,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}},{"title":"仲冬之初家弟诚之自芹溪得红梅数枝作三诗以见意夜归枕上次韵简山中二三子 其一","author":"段克己","text":"十月梅花春未知，竹閒璀璨出斜枝。\n耐寒巧作新妆面，绝胜含章檐下时。","collection":"金末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金末元初.csv","pointer":2398,"sha256":"060690a7e31859907dbbb768048b96288d6bd9ea30711f108a14b8f9a874576e","dynasty":"金末元初"}}]