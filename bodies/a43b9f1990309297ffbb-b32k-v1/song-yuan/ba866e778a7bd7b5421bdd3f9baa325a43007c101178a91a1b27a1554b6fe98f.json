[{"title":"岁在丙辰元日立春是时先人守当涂郡斋宾客云集皆用元祐八年东坡和王仲至秦少游诗故事所谓省事天公厌雨回先人笑曰天公省事今乃多事耶今三十有九年矣追念感慨小诗聊记当时笑谈之语","author":"牟巘","text":"忆昨姑溪岁丙辰，老仙元日去班春。\n当家句子频催客，省事天公却笑人。\n紫凤天涯今已老，泥牛岁首又还新。\n笑谈谁记当时选，独立东风倍怆神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4843,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次姚子敬简高司丞","author":"牟巘","text":"西风小立对晴川，冷笑人间目圣颠。\n使事端因荔枝出，归期休在菊花前。\n平生漫说少陵老，终日谁陪上界仙。\n应是杜中鸥与鹭，诗情比旧更依然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4844,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵","author":"牟巘","text":"大海相环宛一洲，浮沤乍起已千秋。\n三壬笑向人间世，四癸时寻物外游。\n我辈安能知许事，平生未若乐斯丘。\n开窗翠竹时相对，更说诸馀总谬悠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4845,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵九日寄史推","author":"牟巘","text":"弁有山兮水有湄，登临舍此复何之。\n发疏帽脱狂嘲后，雁过江涵感慨时。\n盛府主宾俱好事，满城风雨苦吟诗。\n人生自可行乐耳，剑首功名但一吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4846,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵李千秋中秋","author":"牟巘","text":"节物诗情总索然，漫将梨栗当盘筵。\n堪怜永夜空樽月，记取衰翁断酒年。\n十日尚留花影在，两瓶便作竹根眠。\n分明破戒缘佳句，免使儿童诮禁烟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4847,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵李侯喜雨","author":"牟巘","text":"谁似当年召信臣，天教来此活疲民。\n水乡怕旱相传古，甘澍随车总是春。\n坐看丰登成乐岁，只将恺悌对明神。\n已闻宣布形歌咏，宾主殷勤用意新。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4848,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵寄史彦明","author":"牟巘","text":"等閒看尽弁衡毗，旁郡聊从捧檄驰。\n候管乍披新定志，邮筒忽见故人诗。\n君方清绝行明镜，我正摧颓据槁枝。\n为喜綵衣还膝下，椒柈趁得颂花时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4849,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和仲实秋兴","author":"牟巘","text":"金飙吹暑顿然清，闻早空庭一叶惊。\n拄颊偏宜对朝爽，挥毫正好赋秋声。\n镜中髯短休烦镊，壁上弦閒不受檠。\n志士由来多慷慨，何如百啭听莺鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4850,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和任东津山长","author":"牟巘","text":"吴兴学法遍诸华，吾道元无迩与遐。\n今日谁能留下马，古人犹自酹先茶。\n肯开燕豆惊流俗，共喜皋比得当家。\n入手新诗惟重拜，颉颃那得并飞霞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4851,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和汴教耶律伯明","author":"牟巘","text":"翩然来自旧京华，历数山河不谓遐。\n往事已空惟重黍，玄谈未了更浇茶。\n南游句好俄惊座，东道情深未忆家。\n也欲卫州门外去，一声长啸入烟霞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4852,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和陈无逸木犀","author":"牟巘","text":"秋旻金气正高张，并作西风一夜凉。\n何处杯中无白堕，如今扇底有黄香。\n自惭老蘖如犀秃，却笑春花为蝶狂。\n胜赏清吟两奇绝，吴山横过即仙乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4853,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"奉寄沈公介石老仙","author":"牟巘","text":"不贪富贵即神仙，茗椀香炉古易编。\n谁向急流能勇退，方知介石是几先。\n三危露下闻清唳，九锁山中断俗缘。\n喜有诗人相共住，何时一笑醉丹泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4854,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孤雁","author":"牟巘","text":"如何苦作断肠声，度尽关山失弟兄。\n万里他乡谁是伴，单栖半夜若为情。\n嘐嘐每叹众人薄，落落孤将一意行。\n只恐影沉湘水后，更无来者继高名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4855,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸卯人日送李千秋还杭","author":"牟巘","text":"喜闻罨画初回棹，便拟共公吟过春。\n何事客乡还送客，今朝人日更愁人。\n风吹杯面梅花老，路转裙腰草色新。\n只恐西湖留不住，重来好为活疲民。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4856,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵君宝宣慰别三十五年矣末由再晤近张倩仲实转似西湖诗图乃知吟啸湖山之乐辄为五诗奉答 其三 郑夫人传","author":"牟巘","text":"毅斋大老除新绶，名节尤偏无所尊。\n曾是胪传第一唱，却留衣付外诸孙。\n挹挼柳汁初承渥，称泛霞觞共拜恩。\n尚记吾家多夙契，何当握手得重论。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4857,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵君宝宣慰别三十五年矣末由再晤近张倩仲实转似西湖诗图乃知吟啸湖山之乐辄为五诗奉答 其五 小舟归","author":"牟巘","text":"平生知旧一李友，别后长关白板扉。\n偶有客来孤鹤起，也无人觉小舟归。\n尽渠俗子频相恼，只恐仙禽未肯飞。\n莫笑爨琴并煮鹤，醉眠林下两忘机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4858,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵君宝宣慰别三十五年矣末由再晤近张倩仲实转似西湖诗图乃知吟啸湖山之乐辄为五诗奉答 其二 西湖书院","author":"牟巘","text":"橘园亭畔市多尘，曲院桥边境转清。\n山色湖光精舍敞，笔床茶灶钓船轻。\n奈何一字不堪煮，且与三贤相并行。\n笑问寿藏何早计，不妨更学赵台卿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4859,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵君宝宣慰别三十五年矣末由再晤近张倩仲实转似西湖诗图乃知吟啸湖山之乐辄为五诗奉答 其四 四时春","author":"牟巘","text":"伯子尧夫豪杰人，四时佳致四时春。\n静能观动一机活，会复乘元千古淳。\n造物生生还化化，世情故故又新新。\n不妨长向亭中醉，自觉冲融气味真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4860,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵君宝宣慰别三十五年矣末由再晤近张倩仲实转似西湖诗图乃知吟啸湖山之乐辄为五诗奉答 其一 南屏书院","author":"牟巘","text":"南屏环拥翠云堆，谁遣精庐特地开。\n祭酒先生甘隐遁，燃藜太乙忽飞来。\n胸中礧磈五千卷，门外芙蕖十万栽。\n白日竟抛妻子去，群仙携手上瑶台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4861,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送程晋辅长和靖","author":"牟巘","text":"传家气脉固深长，挟策来登和靖堂。\n南渡金声元不泯，西庵草色可能荒。\n要知持守为涵养，好把精微重发扬。\n共喜慈帏得甘旨，他时远到未渠央。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4862,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送屠存博教授溧水","author":"牟巘","text":"直道方心古所难，任渠俗眼笑儒冠。\n子龙有屋犹黄壤，老郑无毡漫冷官。\n一片湖光清客署，三州鼎足屹书坛。\n只应翠绿迎人意，岁月功名正好看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4863,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宴公孙倅乐语口号","author":"牟巘","text":"后先相守是乡人，自有都梁见未曾。\n药玉船中频送酒，镂金胜畔又行灯。\n雁桥旧梦犹能记，凤阙新除自此升。\n一笑不妨追乐事，坐看诸县乐丰登。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4864,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宴交代杨寺丞乐语口号","author":"牟巘","text":"眉间黄色喜浮浮，天遣鸾皇为相攸。\n新绾丝纶归右掖，旧游泉石记南州。\n春风自满甘棠国，晓雪初晴杜若洲。\n乐饮更为三百住，邦人未许别贤侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4865,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宴交代赵寺丞乐语口号","author":"牟巘","text":"帝教云牧重云山，柱辄清朝玉立班。\n八月星槎来海上，九天藜杖照人间。\n烦公政事文章手，开此江山父老颜。\n若到西湖应记取，明年此日看徵环。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4866,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宴安抚洪尚书乐语口号","author":"牟巘","text":"雕戈红旆辔如丝，暂为君王镇左畿。\n下鹄池边新有诏，卧龙山畔又催归。\n共看阁老今黄闼，却笑门生也绣衣。\n起舞祝公千岁寿，蓬莱云气正霏霏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4867,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宴黄倅乐语口号","author":"牟巘","text":"向来南岳凤曾鸣，再驾缇屏又一星。\n文物君谟丹荔谱，江山白傅百花亭。\n舂容相与频呼斝，肯綮争看妙发硎。\n紫橐青毡吾旧物，孔鸾行矣集明廷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4868,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽王厚斋尚书 其三","author":"牟巘","text":"文献遗诸老，风霜鲁殿馀。\n斯人不可赎，吾道意何如。\n永念年家好，曾联选部居。\n无由陪缟送，东望泪沾裾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4869,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽王厚斋尚书 其二","author":"牟巘","text":"开庆言容悦，咸淳奏直前。\n每逢时宰怒，自保哲人全。\n垂世三千卷，归田二十年。\n汾亭有遗操，独拍泪潸然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4870,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽孙太监","author":"牟巘","text":"埋玉愁闻薤露歌，向来耆艾日消磨。\n平生所至棠阴在，晚岁其如麦秀何。\n洛社竟虚同甲会，鉴湖应改旧时波。\n四春手植烦调护，万感今犹忆烂柯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4871,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽师叔理 其三","author":"牟巘","text":"四海东坡老，平生秦太虚。\n神游已冥漠，坐念更欷歔。\n手墨看犹湿，心期炯未疏。\n堪怜畴昔语，腹痛勿驱车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4872,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽师叔理 其一","author":"牟巘","text":"卓尔见成鐻，超然惊绝尘。\n形骸脱边幅，肝膈炯精神。\n正自关天分，应难语俗人。\n谁收身后稿，隽逸更清新。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4873,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽师叔理 其二","author":"牟巘","text":"已饱忧患味，方收翰墨勋。\n龙飞新进士，猿臂老将军。\n千里推车轴，群工愧斧斤。\n天乎如有意，更为续斯文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4874,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽张师道 其二","author":"牟巘","text":"在昔台州守，先人事分多。\n通家能记忆，上冢每来过。\n老我病未死，送君情奈何。\n贤哉幸有子，健翮看云摩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4875,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽张师道 其一","author":"牟巘","text":"少日追杨晏，由来间气钟。\n两科无近比，万里有奇逢。\n正喜鳌扉重，俄惊鵩舍凶。\n輤车方远税，已见若堂封。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4876,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽杨知府 其二","author":"牟巘","text":"肮脏群飞外，康强七帙馀。\n耆年犹谨礼，细字每抄书。\n十载甘琳馆，三州奉板舆。\n挂冠天未可，双犊老康庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4877,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽杨知府 其一","author":"牟巘","text":"蜀有古爱直，公为令子孙。\n驻原曾婉画，治狱辄平反。\n槁落荣观尽，纡徐雅道存。\n灵光洞劫火，德齿晚弥尊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4878,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽杨知府 其三","author":"牟巘","text":"见说佳眠食，遗身疾自无。\n方期操几杖，俄已易床肤。\n久读耆旧传，仍联嫁娶图。\n湘岑望不到，洒泪向天隅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4879,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽陈本斋尚书 其二","author":"牟巘","text":"天俾公多寿，人知道不孤。\n超然一室内，不与万波俱。\n甲子新诗稿，烝尝旧布襦。\n何妨传遗老，文字照龟趺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4880,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽陈本斋尚书 其一","author":"牟巘","text":"在昔实斋老，公能继盛名。\n平生守师说，晚岁萃儒荣。\n禋赦原兵祸，台纲忤物情。\n抽身甬东去，腾上几公卿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4881,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽陈本斋尚书 其三","author":"牟巘","text":"有意超尘俗，无心爱夕晖。\n劝餐惟屡却，持璧竟全归。\n得正复奚憾，偷生良所非。\n传家孙子盛，端不坠前徽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4882,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽岳君举","author":"牟巘","text":"五十馀年事，都将作梦看。\n早方磨铁砚，老遂葬桐棺。\n蚁结途方戒，驹驰岁已阑。\n山前一片石，读者为悲酸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4883,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽亲家孟从吾","author":"牟巘","text":"东野哭其子，难存百感身。\n孤孙犹在抱，行路亦沾巾。\n满目家园树，何时泪叶春。\n诸生为执绋，良足化乡人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4884,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽姚景春","author":"牟巘","text":"昔在仙都世，人称善士门。\n丘山叹华屋，风雨长孤根。\n鹤瘦空馀影，鸿冥更断魂。\n植斋书万卷，喜有外孙存。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4885,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵止善 其二","author":"牟巘","text":"昔日三株树，彫容顿可惊。\n一癯危独坐，多难失孤撑。\n官舍煎茶梦，天涯裹饭情。\n无由送车后，抆泪愧平生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4886,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵止善 其一","author":"牟巘","text":"自处若素士，不知为贵游。\n多闻每是正，寡欲更清修。\n方借望郎重，已深宗国忧。\n嗟哉事竟尔，乔木委林丘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4887,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵春谷 其二","author":"牟巘","text":"子美转同谷，灵均怀此都。\n修名千载短，多难一臣孤。\n天意终难料，心期自不渝。\n西风吹更急，萧索间泉途。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4888,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵春谷 其三","author":"牟巘","text":"北弁方胥会，西崦遽莫追。\n津梁摩诘病，台沼雍门悲。\n鹤有还家梦，乌无反哺期。\n泷冈松槚近，足慰九原思。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4889,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵春谷 其一","author":"牟巘","text":"堕地追风骥，垂天驾海鹏。\n嗟哉中道止，藉甚到今称。\n几士待举火，一生甘饮冰。\n居然使蹠寿，念此拂人膺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4890,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽赵碧兰母刘氏","author":"牟巘","text":"苗裔真王后，仪型老监同。\n庭惟参玉树，气未感秋蓬。\n衣制先期具，舟藏半夜空。\n故应芳懿在，位刻贲幽宫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4891,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽唐学宾","author":"牟巘","text":"奕世诗书味，端知积庆长。\n于人不畦畛，为世作津梁。\n肯助鲁修泮，能令齐发棠。\n阴功天所相，食报在诸郎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4892,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄昌化孙梅泉","author":"牟巘","text":"挥手秦稽信宿然，未行俄已两周天。\n云缄尺素惟开后，雪辊双溪恐堕前。\n高谊谁能似孙宰，旧题应复记苏仙。\n何时布袜青鞋去，摘野芎苗古寺边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4893,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题陆起潜皆山楼","author":"牟巘","text":"醉翁朝暮四时景，谁遣描摹入此图。\n唤作皆山真个是，携来到处与之俱。\n也曾佳客相陪否，亦有清泉可酿无。\n更喜一般僧侣旧，高楼百尺俯尘区。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4894,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"燕交代□□乐语口号","author":"牟巘","text":"两君先后缔交承，一笑何妨玉斝倾。\n驰驲催人来异渥，卧龙留客自多情。\n告新听说三年最，叙旧欣寻再世盟。\n天上除书人已到，便看鹄立侍通明。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4895,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠陈东洲","author":"牟巘","text":"散发披襟颇自由，野麋见客忽惊投。\n新诗生怕将愁至，博学何妨与艺游。\n未说天边金弹子，试寻城外土馒头。\n不然且学伯伦醉，荷插相随死便休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4896,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山矾图","author":"牟巘","text":"玉殿何劳定等差，弟兄俱是老涪家。\n季方也与新名字，免得人呼作玚花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4897,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己巳秋七月不雨人心焦然乃戊午斋宿致城隍清源渠渡龙君嶅山五神于州宅以祷始至雨洗尘自是间微雨辄随止旱气转深苗且就槁要神弗获某忧惧不知所出越癸亥日亭午率郡僚吏申祷于庭未移顷雨大挚旄稚呼舞皆曰神之赐也某既拜贶又明日以神归念无为神报者乃作送神之诗七章以侈神功且又以祈焉 其二","author":"牟巘","text":"几度看云眼欲穿，不应气数总关天。\n去年兵又今年旱，守也于民自寡缘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4898,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己巳秋七月不雨人心焦然乃戊午斋宿致城隍清源渠渡龙君嶅山五神于州宅以祷始至雨洗尘自是间微雨辄随止旱气转深苗且就槁要神弗获某忧惧不知所出越癸亥日亭午率郡僚吏申祷于庭未移顷雨大挚旄稚呼舞皆曰神之赐也某既拜贶又明日以神归念无为神报者乃作送神之诗七章以侈神功且又以祈焉 其五","author":"牟巘","text":"神祐恭惟及物深，中间感应妙精勤。\n要知应处还为感，终始惟当秉一心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4899,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文性之惠蛤蜊绿橘","author":"牟巘","text":"二珍胥会到柴关，诗为高情趁早还。\n海上便如逢若士，橘中应不减商山。\n可人风味知渠隽，老我形容有许顽。\n快击黄包烹紫壳，为君呼酒一开颜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4900,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王梅泉生日惠诗次韵答之","author":"牟巘","text":"堪笑衰翁作计狂，又随笭箵到鱼梁。\n未秋早觉凋蒲柳，已老安能种豫章。\n谁似读骚仍饮酒，有时赞易自焚香。\n梅边有约君应记，但愧年来久覆觞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4901,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四安道中所见 其九","author":"牟巘","text":"木瓜已过折山来，黄帕封林未敢开。\n想见白沙红照里，绣纹冷落见奇瑰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4902,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]