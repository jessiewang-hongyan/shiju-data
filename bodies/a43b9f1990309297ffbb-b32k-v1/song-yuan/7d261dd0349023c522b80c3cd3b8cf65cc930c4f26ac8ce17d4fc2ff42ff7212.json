[{"title":"次韵志归十首 其十","author":"方回","text":"近城一耕叟，仅有使牛能。\n人似愚偏寿，家由俭故兴。\n不知求仕宦，未省结交朋。\n笑我儒冠误，今如退院僧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2158,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其九","author":"方回","text":"书盍多多读，诗须细细评。\n后生才染指，半道遽寒盟。\n直取珊瑚出，宁争熠耀明。\n伯牙弦已绝，举世喜筝声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2159,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其八","author":"方回","text":"谯国资深入，彭门纳晚成。\n至今为癖习，自幼有常程。\n朽老宁孤瘦，飞扬勿剽轻。\n悬知千载士，肯竞一时名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2160,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其七","author":"方回","text":"楸局堪谁对，铜壶拟共投。\n高轩能坐致，浊酒岂难谋。\n林鸟供歌吹，园蔬当馔羞。\n谓无忧不可，聊以此消忧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2161,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其六","author":"方回","text":"解语莺能巧，交飞蝶许狂。\n苔纹深碧毯，榴靥竞红妆。\n粗已成幽圃，犹当筑小堂。\n未妨无暑药，熟水紫苏香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2162,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其五","author":"方回","text":"添竹复添花，清阴一倍加。\n病身思灼艾，暑节近浮瓜。\n晚景今如许，初心岂有他。\n甘贫仍守拙，肯羡五侯家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2163,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其四","author":"方回","text":"还家五月初，倏忽又旬馀。\n凉剂医羸马，尘编磔蠹鱼。\n小迟延客饮，作急报儿书。\n歙睦频来往，何时永定居。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2164,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其三","author":"方回","text":"痴与狂皆有，贫兼病亦应。\n屡尝三斗醋，不梦一条冰。\n买药凭船贾，分茶谢冢僧。\n短衣射猛虎，老矣竟无能。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2165,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其二","author":"方回","text":"老不任时栋，穷犹宅士乡。\n端能甘澹泊，未觉厌荒凉。\n古井深泉冷，閒庭异草香。\n田翁来问字，略为说偏傍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2166,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵志归十首 其一","author":"方回","text":"远望舒长啸，幽跧发永叹。\n能诗今不少，得句古云难。\n涉世颠毛白，希贤寸腑丹。\n他乡仍故国，何处可求安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2167,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵李景安提学同过伯几 其一","author":"方回","text":"万卷芸香拥燕居，客来谈论汹淮湖。\n精言琴律根前辈，朗诵诗篇压老夫。\n胥谓买邻迁爽垲，祇应负郭欠膏腴。\n真能隐处非难事，恐有天边尺一呼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2168,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪以南归途见寄","author":"方回","text":"身轻更觉马蹄轻，倦听昕堂讲鼓声。\n示病早能效摩诘，赋归真复继渊明。\n食租近郭膏腴足，卜筑依山爽垲成。\n疾寄新诗似怜我，弃田捐宅不聊生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2169,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪以南教授美康使君新政因及贱迹四首 其四","author":"方回","text":"石壁峰前旧泮林，新培槐市绿成阴。\n川流决溃终归海，木德回环会守心。\n夷轨得朋殊未艾，长谣怀感抑何深。\n矧伊色笑逢民则，好续当年蹻蹻吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2170,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪以南教授美康使君新政因及贱迹四首 其三","author":"方回","text":"汉廷久已推三杰，鲁国终难致两生。\n云雨蛟龙真有势，风霜草木易无情。\n小迟玉玺徵黄霸，定许青门老邵平。\n勇据皋比作歌颂，依稀駉駜似难赓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2171,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪以南教授美康使君新政因及贱迹四首 其二","author":"方回","text":"溃蚁狂澜拔地来，日多事变少人才。\n鼎钟古篆盲谁识，布素轻缣拙易裁。\n夷甫风流空自命，子山词赋有馀哀。\n邦侯博雅难酬对，且向筵前覆酒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2172,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪以南教授美康使君新政因及贱迹四首 其一","author":"方回","text":"吾州今岁得儒臣，坐镇浮浇力万钧。\n月榭风台寻古迹，烟畦雨陇劳遗民。\n长庚往往诗无敌，子美云云笔有神。\n老懒未遑致三请，低回祇欲老垂纶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2173,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪庭芝投赠","author":"方回","text":"鱼龙仙派古来闻，南渡枢臣七世孙。\n幸不幸间身且隐，玄之玄处道常尊。\n惜閒剩读真书传，入静时思旧户门。\n送往恤孤尚留意，亦防公议恐无恩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2174,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫和西城吕全州见过四首 其四","author":"方回","text":"骤见累侯印，遄闻趣相装。\n相期终古事，未用暂时香。\n清论玉霏麈，高眠雷撼床。\n前鱼又堪笑，红袖泣龙阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2175,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫和西城吕全州见过四首 其三","author":"方回","text":"五鼎封君食，千金奉使装。\n傥来皆外物，不朽有真香。\n满酌圣贤酒，虚争上下床。\n细思诸葛事，只合卧南阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2176,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫和西城吕全州见过四首 其二","author":"方回","text":"闻道过从地，衣冠异俗装。\n小孙迎劝酒，后院出行香。\n贾客珠量斗，侯家笏满床。\n未如耆旧辈，庞马隐襄阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2177,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫和西城吕全州见过四首 其一","author":"方回","text":"想见花间路，篮舁草草装。\n叩门驯犬喜，入室蠹鱼香。\n蹑石苔粘屐，眠松露滴床。\n焉知人世事，积甲又宜阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2178,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫读予诗稿见寄二首 其二","author":"方回","text":"十年兵甲梦，投老卸戎装。\n有药医诗病，无花恼梦香。\n书明萤度几，簟冷竹遮床。\n属与公携酒，蹉跎换岁阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2179,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵汪翔甫读予诗稿见寄二首 其一","author":"方回","text":"我诗蒯侯剑，玉具谢华装。\n老矣三荒径，悠哉一瓣香。\n漫垂船子钓，懒下赵州床。\n忽忆高轩过，仙巾戴华阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2180,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沈茂实小园偶书 其一","author":"方回","text":"人因雅俗分高下，同是园林兴不同。\n时觉燕莺相尔汝，焉知蜂蝶有雌雄。\n岂惟酒可兼诗可，常在花中与竹中。\n秋老纱窗犹未换，要令深夜月华通。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2181,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沈茂实小园偶书 其二","author":"方回","text":"秋风粳稻又尝新，续食年年肯济贫。\n远学佺期响□□，近同东老致仙人。\n贵公勋业一杯水，俗子面颜三斛尘。\n流火授衣诵豳什，戒寒深恐雁来宾。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2182,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵灵鹫清长老二首 其二","author":"方回","text":"得句无僧字不清，公来一日两诗成。\n龙雷珠浦东坡和，海日江潮老宋惊。\n鲁直尚能推大国，长卿谁可诧长城。\n二桃三士抱吟膝，我所师兮葛孔明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2183,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵灵鹫清长老二首 其一","author":"方回","text":"粗读书难尽信书，世谁鲠直但阿谀。\n平生湖海悲游子，晚岁乾坤老腐儒。\n知己尚堪抬醉眼，从僧似欲剃吟须。\n何当灵鹫兼三竺，日伴猿饥侣鹤臞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2184,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵连伯正见赠","author":"方回","text":"古调于今底所寻，麟胶忽嗣绝弦音。\n骤观布置如平易，徐认萦回极杳深。\n露下九皋秋鹤唳，月寒三峡夜猿吟。\n宁为清绝更凄楚，肯弄文君户外琴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2185,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邵君以容名斋二首 其二","author":"方回","text":"我能容物天容我，容足元消地几多。\n结莫逆交聊尔汝，闻无义语勿谁何。\n飘零踪迹因循惯，冷淡光阴苟且过。\n人世政如蚕食叶，百年谁办茧成窝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2186,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邵君以容名斋二首 其一","author":"方回","text":"细读来诗窥所学，忘机忍事用功深。\n远同随笔洪公号，妙得吟窝邵子心。\n怀抱春浓重酝酒，语言渊嘿绝弦琴。\n我能容物天容我，无是无非镇似今。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2187,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵受益九日","author":"方回","text":"归欤岂少旧林塘，何用痡瘏陟彼冈。\n白发转添吾辈老，黄花不减去年香。\n每嫌佳节多风雨，犹喜炎陬缓雪霜。\n典尽寒衣偿酒债，衰翁聊以醉为乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2188,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵受益苦雨二首 其二","author":"方回","text":"甘泽关民命，随时不在多。\n滴穿檐下石，烂倒水中荷。\n天有凶荒岁，人无政事科。\n诚心能抚字，乖气转为和。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2189,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵受益苦雨二首 其一","author":"方回","text":"乃者黄梅近，朝朝以雨书。\n将无作人鲊，孰不困河鱼。\n近郡淹城郭，连村浸室庐。\n何当与奇术，辟谷驾飞车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2190,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵受益喜晴二首 其二","author":"方回","text":"高楼晓气清，钟鼓报新晴。\n乍睹阳乌色，频闻喜鹊声。\n纵难期上熟，差足慰深耕。\n忍见民穷极，唯宜岁事成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2191,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵受益喜晴二首 其一","author":"方回","text":"谁扶一轮日，与扫万重云。\n水已落数尺，田犹收几分。\n大钧回叶气，疏网削深文。\n尔饭堪糊口，忍为梁上君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2192,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵金汉臣五城道中","author":"方回","text":"郊行胸次爽于秋，岁稔天宽百姓忧。\n但有樵人歌陇上，永无廷尉望山头。\n最宜旷野开诗思，未觉他乡动客愁。\n想见霜林疏更好，绿阴时节忆曾游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2193,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵金汉臣雨后病起见寄","author":"方回","text":"一自蒲杯吊楚湘，倏成炎溽乍阴凉。\n恨无枥上如飞马，往问斋中独宿床。\n病起精神如雨止，怀归愁思与天长。\n何时共□□诗说，直上高峰看夕阳。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2194,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵金汉臣喜雨","author":"方回","text":"山高田易旱，已过一旬晴。\n岂止商饥饱，真成决死生。\n甘霖三尺透，病体十分轻。\n想见琴堂老，催诗意倍清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2195,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵金汉臣喜晴","author":"方回","text":"雨足秧畴始放晴，乡邻所至有欢声。\n宰公明察无冤狱，太守辛勤自劝耕。\n我昔黄童成白首，谁今赤子视苍生。\n定知米价秋来减，遍买村醪处处行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2196,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵俞好问庆予七十","author":"方回","text":"固穷早类从心孔，懒读今如便腹边。\n时制堪惊小戴记，初筵敢拟卫公篇。\n云何此老偏令寿，其或斯文遂有传。\n见一庵前碧溪在，花瓢归饮许仙泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2197,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵俞如问旅思送之游松江","author":"方回","text":"芰制荷纫未絮衣，溪船信宿自堪归。\n倚门尚尔嗟行役，抱瓮元来久息机。\n江阔天遥鸿雁断，日斜岁暮稻粱稀。\n芋炉有地煨风雪，骨肉团栾夜共围。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2198,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵前广德赵教授","author":"方回","text":"脩程万里未为赊，年少曾逢世运嘉。\n早擢高科题雁塔，合班迩列餍龙茶。\n宦情划似云归岫，时事惊如雨送花。\n书林宝藏饶词藻，肯羡青霄富贵家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2199,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵前住中竺希鉴上人五言","author":"方回","text":"中兴今佛法，百倍胜儒绅。\n达磨重初祖，观音再化身。\n此心元是道，何物不为尘。\n毂觫齐王眼，焉知一角麟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2200,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵胡正卿","author":"方回","text":"长途疾足讵容休，政是嘶风抹电秋。\n小复低回从吏隐，未应拘窘叹官囚。\n声名甫逐涛江起，魂梦空随沁水流。\n一顾即看逢伯乐，直须昼绣问刀头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2201,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵赵云中饮呈孟君复二首 其二","author":"方回","text":"可遨昆阆步瀛莱，祇爱钻腮笑靥开。\n暮雨朝云元易散，昏钟晓鼓故相催。\n身如病鹤犹遗骨，心似焦桐亦未灰。\n纵使吾曹不排闼，不应门阈上苍苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2202,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵赵云中饮呈孟君复二首 其一","author":"方回","text":"旧业田荒百顷莱，眉头长与醉怀开。\n春愁忍共金钗诀，夜禁偏嫌玉漏催。\n聚散有情都是梦，古今无物不成灰。\n何时再觅狭邪路，白骨谁非塌井苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2203,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵赵朴翁赴衍圣公峄山书院之招","author":"方回","text":"邹鲁相望击柝间，亦颜谁许独晞颜。\n同源泗水别沂水，接壤峄山连泰山。\n万世元勋辟杨墨，一时浮论主雍环。\n七篇事业君能讲，男子临岐泪肯潸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2204,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵赵达夫问疾","author":"方回","text":"烦君遣信问何如，霖雨无人叩陋居。\n孰信着绵当夏半，自惊伏枕已旬馀。\n百年未办书传后，一壑犹欣服返初。\n处约得衰更多病，从今誓与酒杯疏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2205,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵送张文焕 其一","author":"方回","text":"廊庙端非岩壑姿，慵庵未是可慵时。\n浮荣故自无心向，素抱其如有己知。\n天上要途终一武，江南绝景已千诗。\n欲从远祖赤松子，小待功成亦未迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2206,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵送郝同知还闽二首 其二","author":"方回","text":"字画多年逼献之，高材天赋岂人为。\n一枝秃笔无能敌，百尺名楼有所思。\n碛马塞鸿忘旧梦，建茶闽荔富新诗。\n皇天具眼终徼福，多病从来喜让夷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2207,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵送郝同知还闽二首 其一","author":"方回","text":"平生奔走遍区中，老尚流离作寓公。\n合坐黄堂称太守，愿求丹剂学仙翁。\n繄谁虎豹占文变，何限貂蝉出武功。\n可似有心随李耳，流沙西迈过崆峒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2208,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵郝元隐浙西山","author":"方回","text":"疏处温凉密处寒，未须向背问支干。\n猿闲配偶双嬉戏，树古根枝万屈盘。\n何限楼台荒宿草，几年歌舞罢鸣銮。\n赖天独肯扶僧刹，佛大泥多许共看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2209,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵唐师善见寄 其一","author":"方回","text":"闻风足使鄙夫宽，家世言诗自杏坛。\n万卷古书侔藏室，十年深谷隐王官。\n大材益厚楩楠植，至宝终垂琬琰刊。\n愧我老衰已无力，青云中道铩飞翰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2210,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵唐师善见寄 其二","author":"方回","text":"归来数亩小园宽，风有轩棂月有坛。\n总为才疏能忤俗，兼缘兴尽合休官。\n空山老死知无补，往代兴亡稍欲刊。\n洛下寄书藉黄犬，莼鲈终恐愧张翰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2211,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸令郎见示二首 其二","author":"方回","text":"老我泥涂久，郎君玉雪清。\n百年双鬓谢，一醉万缘轻。\n孰肯延枚叟，端难少贾生。\n脩程未可料，聊此慰诗情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2212,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸令郎见示二首 其一","author":"方回","text":"盛名从昔起寒微，逆旅萧条未必非。\n政可夜楼观月落，不应晓枕叹霜飞。\n妙年振鬣思千里，他日干霄会百围。\n通介随时有中道，稍容衰老擅渔矶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2213,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸斋中独坐五首 其五","author":"方回","text":"惯忍饥穷即圣贤，松心玉质未贞坚。\n苦无知己庸何憾，断不逢人便乞怜。\n龟鹤算高终老死，星辰位定有推迁。\n味公独坐诗中意，可惜侵寻绛县年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2214,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸斋中独坐五首 其四","author":"方回","text":"谁欤载笔掌丝纶，雾雨何伤隐豹文。\n绝望都俞参稷契，劣能损益记周殷。\n蠹残书册犹堪觑，草没阶除尽不耘。\n郑老襟期少陵解，从渠衮衮更纷纷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2215,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸斋中独坐五首 其三","author":"方回","text":"蚁溃金堤薄俗颓，圣门谁与嗣云来。\n良难托讽追风雅，只可微辞纪定哀。\n有志向能穿虎石，无疑今始悟蛇杯。\n掀天气燄吾尝见，转首空成一聚埃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2216,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸斋中独坐五首 其一","author":"方回","text":"舞燕歌莺子所无，不无灯照短檠书。\n酒来形影相酬酢，诗就烟霞共卷舒。\n八极渺茫供傲睨，一襟空洞极恢疏。\n世间底是英雄物，未许曹瞒笑本初。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2217,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵宾旸啼字犹字二首 其二","author":"方回","text":"往年灯火醉樊楼，月落吹箫未肯休。\n不惜黄金追胜事，肯回青眼顾时流。\n燕来鸿去春光在，死易生难病脉浮。\n更问西池赏花约，心虽欲往豫兮犹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2218,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]