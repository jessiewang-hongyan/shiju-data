[{"title":"挽黄思梅","author":"陈杰","text":"梦回残月堕觚棱，归棹沧浪自濯缨。\n城郭重来嗟隔世，江山如画忆初盟。\n当年阮瑀谁争长，千载相如凛若生。\n空复满襟馀老泪，临风三叫为君倾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6826,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史","author":"陈杰","text":"口体乃累人，寒饿事亦细。\n拥彗何为者，妨我雪中睡。\n先生死非令尹辱，彼四百家无罪哭。\n粟三钟，薪十束，天留先生雪楚狱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6827,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读邸报 其一","author":"陈杰","text":"战骨如山血未乾，补疮遮眼肉都剜。\n向来手诏真哀痛，间者人言已治安。\n夜访宰臣忧卧榻，昼延学士论危竿。\n祖宗全盛犹如此，半壁江风面面寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6828,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"阃下忽动归兴","author":"陈杰","text":"无端佩玉更长裾，衔袖人疑表饵疏。\n塞路连云痡仆马，辕门似海叹车鱼。\n那无定远封侯相，正有南涯种树书。\n久客土思吾亦动，明朝满意听骊驹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6829,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题兴国倅厅湖山伟观楼","author":"陈杰","text":"华表归威可手攀，新亭风景落眉间。\n千年宇宙千年事，万里湖山万里天。\n庭蠡水来仍水落，衡庐云起复云閒。\n古今只在斜阳外，安得凭高一破颜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6830,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"得菊花绝黄","author":"陈杰","text":"谁与凛秋料理悲，木樨香冷未梅时。\n直疑天上金茎露，全付篱间黄菊枝。\n佳色足陪陶令醉，落英还慰屈原饥。\n东风试问千红紫，曾有西风此段奇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6831,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望庐山","author":"陈杰","text":"去年山中行，未了庐山意。\n今年江上望，始尽庐山势。\n只道山中行，未识庐山面。\n那知江上望，已失庐山愿。\n人生出处前料难，向来窗下有此山。\n一行作吏事便废，十年读书早已悔。\n五老招人笑举头，三老催船不自由。\n柔橹一声天似水，无情飞起两沙鸥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6832,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"淮南听雨歌","author":"陈杰","text":"前檐看雨如银竹，后檐听雨如泻瀑。\n九衢对面起波涛，昨日黄埃一丈高。\n书生生无快意事，天公覆手为办此。\n邂逅一惬吾已多，千家万家丰年歌。\n三更不寐凉如水，清愁宛转秋风起。\n壮士天河更洗兵，皇威海岱一时清。\n幅巾归去江南好，长卧东皋听雨声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6833,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"淮南看雪歌","author":"陈杰","text":"出门看雪一万里，闭门读书一万年。\n读书只读三皇后，看雪还看太始前。\n洪濛以还初纪异，鍊石补天灰渗地，人虫森然盗元气。\n介鳞日深蹄迹多，阃抉垠开奈若何。\n千山忽绝万径灭，宇宙鹘崙无璺裂。\n夜灯太极强披图，清晓长淮初见雪。\n丁宁莫遣风日分，暂时大地皆瑶琨，我尔一醉琼花樽。\n明朝山河各异色，独在书生头上白。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6834,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清坐","author":"陈杰","text":"晨兴绝无思，清坐还复佳。\n夜气不啻存，俗氛殊未来。\n居然类禅定，正尔悟心斋。\n明发谢西爽，故山先梦回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6835,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"猛虎行","author":"陈杰","text":"北平山头羽穿石，将军醉眼横夜色。\n高堂白昼坐眈眈，想见负嵎俱辟易。\n铜镮锁深双古槐，霍地啸舞含风雷。\n三生得非故人积，变化为我腾空来。\n目光射庭威百步，童奴近前初不怒。\n再三未敢尺箠麾，生绡张罗红打围。\n头如可编须可捋，约莫留皮是浑脱。\n世上丹青得许神，向来叶公龙乃真。\n笑渠槛中直摇尾，不动齿牙犹咀尔。\n乾坤意气空峥嵘，饥鼠倒齧云母屏，论功有不如狸狌。\n人间猛者何暇像，韩公歌行最知状。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6836,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"维扬之役浩堂拨赐钜舟愿易小者","author":"陈杰","text":"美哉不济如此水，巨川有楫春万里。\n空贻魏瓠拙用大，谁谓河广航一苇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6837,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"菊畹秋香","author":"陈杰","text":"金茎馀孤标，青女满杀气。\n随地堪百畦，流芳亦千岁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6838,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪禁体","author":"陈杰","text":"南风导前北风续，仁气潜随杀机伏。\n初疑惨淡八表昏，忽变光明大千足。\n上天之载德如毛，帝力不知封比屋。\n垢污过眼俱衣被，枯朽何心亦膏沐。\n调治竹君折节下，表显梅兄受命独。\n于至严凝见温厚，有大包容分类族。\n是空非空色非色，在坑满坑谷满谷。\n铺张元化有许奇，收敛神功又何速。\n欲搜好句极形容，回首千章成浅俗。\n夜深兽红妓打围，雪消雪落何用知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6839,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"御风行送武夷道人谢叠山","author":"陈杰","text":"武夷山中有伏龙，鬣捲云雨深重重，化为白须一老翁。\n疾雷破山六丁取，置卫铜镮森守虎，云是健将雨下土。\n老翁一笑百不能，山中所读皆仙经，吾亦泠然御风行。\n洪崖道上逢老友，手举无何指翁口，翁已辟谷安事酒。\n青牛紫气关河咫，大鹏风斯九万里，回首蓬莱浅清水。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6840,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"琴窗夜雪","author":"陈杰","text":"寒更洞书幌，几上明素弦。\n满意宇宙曙，霏霏正漫天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6841,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"登岳阳楼","author":"陈杰","text":"扁舟小系画栏西，万里清光一拄颐。\n湖面欲包天外去，峤鬟疑割海中来。\n高空自泻轩皇乐，元气长涵老杜诗。\n庆历残碑重回首，此生何限退忧时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6842,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答李道士","author":"陈杰","text":"老子废吟恐妨道，道人学诗如学仙。\n探藏不惜藏诸密，试换黄庭内景篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6843,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"萱径携筇","author":"陈杰","text":"松下无喝道，言树聊蠲忧。\n谁知赤藤杖，独倚万古愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6844,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"滕王阁","author":"陈杰","text":"稍觉阑干远水漪，枉持钱贯去安之。\n湖山千古户庭内，帘栋几番鸾玉时。\n记好尽堪邕辍翰，序工且放颢题诗。\n西风何限凭高事，铁笛吹愁酒一卮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6845,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉乡","author":"陈杰","text":"酒亦有何好，离人而趣天。\n乾坤拨醅瓮，世界拍浮船。\n鲁赵移兵隙，淮渑互霸权。\n醉乡知许事，蜾蠃过吾前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6846,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王书史百雁图","author":"陈杰","text":"黄芦落木寒飕飗，平沙占断江天秋。\n嗷嗷累百来未休，宛颈相乐飞相求。\n其中各有稻粱谋，落旄海上霜满裘，不肯为渠作书邮。\n南去云峰有尽头，北归矰弋正多忧。\n冥鸿高哉独无俦，祁连将军生暮愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6847,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李生烟江万里图","author":"陈杰","text":"白鸥飞来类从汝，寒雁瞥起几导吾。\n未觉咫间能万里，曲肱残梦落东湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6848,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题点易窗道人苏门遗啸","author":"陈杰","text":"书来草木吾臭味，诗有胆气非黄冠。\n清溪研露一双鹤，苏门啸空千仞鸾。\n愁连青燐引觞醉，愤入白虹提剑看。\n谁识道人心最苦，半坛霜月夜漫漫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6849,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题寄傲轩","author":"陈杰","text":"富贵骄人拥庐儿，寒士不逊原壤夷。\n傲称凶德无适宜，长者寄尔渠得知。\n使袜聊为廷尉重，命履乃有帝师用，苟非其人千仞凤。\n鹦鹉洲前吊月明，归来痛饮师刘伶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6850,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠孙仙辈","author":"陈杰","text":"株峰紫翠边，仙已住三年。\n手有屠龙技，腰无跨鹤钱。\n地图藏尚秘，山屐著多穿。\n笑指青囊道，人家要福田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6851,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠蔡俊民挟雷法兼眼科北行","author":"陈杰","text":"乖龙捲雨焦土山，妖蟆蚀晴长夜漫。\n安得霹雳鞭龙起，取光还天磔蟆死。\n寥落风霆道术空，坐看短世入盲聋。\n南人巫医尚方满，一试两长君恨晚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6852,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"曩从玉泉道人见寿亭侯印大可方二寸并解池龙骨一枚云侯所下讨者今从玄潭道人见旌阳令剑长不过五六寸云令留以镇水妖者皆微物远不可考道人请予赋剑因并及印以起兴焉","author":"陈杰","text":"玉泉寺中三钮铜，十年解池讨业龙。\n当时何不佐取流马出，火德重开两都日。\n玄潭观中半圭铁，千年龙沙拟蛟孽。\n当时何不唤取泉阿归，汛洒河洛风雷飞。\n白衣摇橹天难料，鸡犬云中帝亲召。\n汉陵无树兮晋国成丘，待侯不来兮仙又竟去而莫留，徒使我百世而下生閒愁。\n荆州看印心尚烈，洪州看剑头如雪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6853,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"充善堂为吴氏题","author":"陈杰","text":"厥初生人，禀性受中。\n不患不善，患不能充。\n血气既刚，物我交战。\n不患不充，又患不善。\n充而善者，可鸾可凰。\n匪善而充，化为豺狼。\n其充为何，勿助勿害。\n鸡鸣而兴，善与利对。\n申严界限，审察毫釐。\n诚内伪外，理公欲私。\n充无穿窬，义不胜用。\n彼充孔扬，傲诞是从。\n故得其正，泉达火然。\n一有弗协，履冰临渊。\n呜呼道微，志远瞻卓。\n子如充之，明善守约。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6854,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江永","author":"陈杰","text":"江之永兮，朝宗于海。\n匪江永兮，洛水攸会。\n洛书其系兮，曷敢不爱。\n江之永兮，于海朝宗。\n匪江永兮，河水攸同。\n河图其系兮，曷敢不恭。\n江之永兮，我瞻禹迹。\n微江之永兮，三正几息。\n三极其系兮，曷敢不惕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6855,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与伯文同作生朝林母在闽","author":"陈杰","text":"翠竹西江我屋，白云南粤君家。\n当日设陈弧矢，今朝相对天涯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6856,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"述往二首 其二","author":"陈杰","text":"贞惠文子升士，睿圣武公好贤。\n晏平仲狐裘一，齐景公驷马千。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6857,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"述往二首 其一","author":"陈杰","text":"阿六生活大可，滕叔经纪自能。\n申生死为恭子，宁哥墓曰惠陵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6858,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题石泉渔歌","author":"陈杰","text":"渭川其钓莫钓，濠上知鱼非鱼。\n几曲清泠寄耳，一声欸乃归欤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6859,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题江山烟水图","author":"陈杰","text":"叠叠云山过尽，茫茫烟水安归。\n还君此画三叹，閒杀江南钓矶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6860,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠雪篷相士","author":"陈杰","text":"寒江独钓焉往，剡溪高兴久空。\n欲识梅花自色，小须雪霁开篷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6861,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昭君怨","author":"陈杰","text":"玉箸晕深宫领巾，金槽夜琤出塞新。\n风沙陇上岁摇碧，一掬犹残长乐春。\n六奇计丑书来慢，曾是控弦三十万。\n沼仇无术遣蛾眉，此日天骄更须豢。\n黄鹄传歌天为悲，边笳按拍鹊南飞。\n琵琶远恨无人省，灼面东家晓妆影。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6862,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"小园即事","author":"陈深","text":"淡黄杨柳著烟轻，细草茸茸衬屐行。\n行到水边心会处，夕阳一树杏花明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6863,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"邻圃求桂花并收坠英 其一","author":"陈深","text":"万里西风桂树秋，蟾宫云箔夜香浮。\n何当净洗红尘梦，乞取一枝遮醉眸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6864,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"邻圃求桂花并收坠英 其二","author":"陈深","text":"收拾残英捣作汤，小山风味不能忘。\n敢烦即遣苍头去，扫取黄金一斛强。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6865,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"南湖史君制暗香汤奇甚赋二绝求之 其二","author":"陈深","text":"雾阁云窗深闭春，微闻玉杵捣清声。\n玄霜祇许云英见，地上诗人渴梦生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6866,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"南湖史君制暗香汤奇甚赋二绝求之 其一","author":"陈深","text":"飞尽梅花重惜芳，仙房想像制新汤。\n犹疑清浅溪头汲，石鼎煎来水亦香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6867,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"济南赵君成南使羁留三纪得还其犹子录其遗事求诗为赋一绝","author":"陈深","text":"三十六回秋月明，年年望断雁南征。\n苏郎皓首还乡去，愧杀当年李少卿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6868,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送人远宦思亲还乡","author":"陈深","text":"堂有期颐母，天涯事远游。\n人生归养乐，薄宦一萍浮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6869,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏日南轩","author":"陈深","text":"并水轩窗宜夏居，夜凉如水似秋初。\n科头枕石卧明月，仰面迎风看太虚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6870,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋桂山","author":"陈深","text":"小山桂树碧云西，三叠琴心月未低。\n曲罢便乘苍凤去，广寒琼榜要新题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6871,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题山水扇 其二","author":"陈深","text":"江上层峰拥翠螺，人烟隐隐见岩阿。\n泊舟二子登平陆，遮莫风波奈尔何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6872,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画扇骑驴踏雪","author":"陈深","text":"雪没驴腰白，行行诗兴催。\n不因太清绝，那肯犯寒来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6873,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题秋塘图二首 其二","author":"陈深","text":"水落秋菰老，夕寒烟树微。\n绝怜双白鹭，飞去似知几。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6874,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题秋塘图二首 其一","author":"陈深","text":"寒塘净如镜，云冷水荭秋。\n溪鸟无情物，悠悠不解愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6875,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题秋塘小景","author":"陈深","text":"寒溪上下碧，水鸟去来轻。\n衰柳伤秋色，应知画不成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6876,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题唐圉人调马图","author":"陈深","text":"飞龙天厩隘云稠，一匹骄驰掣电流。\n枥下髯奴真厮养，眼中元不识骅骝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6877,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇上画 其一","author":"陈深","text":"老树千年古，精灵变化奇。\n纯阳有道士，犹且被渠知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6878,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇上画 其二","author":"陈深","text":"古木排山立，幽窗傍水开。\n直疑林处士，独棹小舟回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6879,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题钱舜举写生五首 其五 戏婴图","author":"陈深","text":"秘矣宫中戏，人间那得窥。\n开图付一笑，能不类儿嬉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6880,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题钱舜举写生五首 其四 菊花","author":"陈深","text":"百卉尽摇落，独傲清霜里。\n披榛见黄花，渊明元不死。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6881,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠恒斋葛太医 其二","author":"陈深","text":"人间无地不巇嵚，刺眼医门剑戟森。\n操术不为流俗变，始知夫子有恒心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6882,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠恒斋葛太医 其三","author":"陈深","text":"少小烟霞痼疾深，已将钟鼎等山林。\n年来更有耽玄癖，烦向膏肓为一针。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6883,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠恒斋葛太医 其一","author":"陈深","text":"吴下谦谦抱朴孙，妙年应遇长桑君。\n素心皦皦恒如月，一寸灵苗手自耘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6884,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又代挽","author":"陈深","text":"壮岁名登进士科，青云直上趁鸣珂。\n子真遐举神仙隐，玄晏闲居制作多。\n空掩高斋藏漫藁，竟无良药起沉疴。\n诸郎毁瘠衔哀切，为报门人废蓼莪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6885,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又代赋","author":"陈深","text":"狼藉风烟知几秋，巍巍杰阁焕然修。\n移来世外神仙宅，幻出云中天帝楼。\n眺远但知观万象，养生应悟解全牛。\n帝觞他日分馀沥，咫尺钧天得梦游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6886,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"从政和韵来谢复就答之 其二","author":"陈深","text":"墙东甘静处，诗思妙通灵。\n堂有慈亲奉，门无冗客经。\n佳儿诵书史，深巷类郊坰。\n应解庄周学，全生不近刑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6887,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"从政和韵来谢复就答之 其一","author":"陈深","text":"并州沈厚士，气质得天灵。\n吴下留三祀，军中讲六经。\n微云点霄汉，清月出林坰。\n载鼓汾亭曲，令人识典型。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6888,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"会霜晴诗 其二","author":"陈深","text":"朝暾上高树，雾卷海天遥。\n劲气乘寒凝，严威见日销。\n钟清出远寺，马滑恐危桥。\n稍逼南枝暖，疏花破寂寥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6889,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]