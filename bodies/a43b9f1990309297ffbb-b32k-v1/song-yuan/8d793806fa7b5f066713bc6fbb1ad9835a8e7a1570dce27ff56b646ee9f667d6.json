[{"title":"中秋同陈奎甫放舟","author":"仇远","text":"寻荷访桂远相过，载雨仙舟泛绿波。\n老眼已经秋若此，赏心莫问夜如何。\n金樽檀板逢欢伯，玉宇琼楼锁素娥。\n争得西风卷云幕，与君弄月扣舷歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":373,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋待月不见 其一","author":"仇远","text":"期修玩事在杭州，月夕那知常滞留。\n纵有侯芭常载酒，惜无李白共登楼。\n蛩催织妇贫非懒，云掩霜娥老似羞。\n应笑山翁痴守待，满身风露冷貂裘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":374,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋待月不见 其二","author":"仇远","text":"年年待月引壶觞，坐对中庭玉一方。\n静夜忽惊云作雨，索居空使客思乡。\n荒鸡声续檐花滴，蝴蝶梦回岩桂香。\n何处高楼见山阔，快予吹笛据胡床。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":375,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为如镜净上人赋","author":"仇远","text":"一片灵台月，圆明适中规。\n谁知相对者，曾悟未磨时。\n去垢元来净，观空了不疑。\n水边閒独立，照见白须眉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":376,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其十","author":"仇远","text":"豪气年来渐埽除，箪瓢自乐守臞儒。\n江头尽醉唐朝士，泽畔行吟楚大夫。\n万里鲲鹏何必羡，一官虮虱不如无。\n葛巾草履从人笑，莫问青衫似叶枯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":377,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其九","author":"仇远","text":"北风雨后忽南风，顷刻开晴又转东。\n后土未乾偏有恨，漏天难补太无功。\n小楼兀坐思猿鹤，好客相期避燕鸿。\n壁上墨兰香可掬，令人常忆所南翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":378,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其八","author":"仇远","text":"倦游懒著小乌巾，短发丝丝雪满簪。\n信手拈书聊慰眼，转头忘事太无心。\n笑他杜老频看镜，爱我昭文不鼓琴。\n喜有山林方外友，时携佳纸索新吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":379,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其六","author":"仇远","text":"笔砚生涯独善身，一区花竹四时春。\n无求莫问朝廷事，有耻难交市井人。\n帘外乌衣飞上下，窗前蜂蕊结轮囷。\n鉴如居士东邻住，肯借霜豪为写真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":380,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其五","author":"仇远","text":"宦海漂流四十年，老来默默守吾玄。\n艰危颇得文章力，嫁娶各随儿女缘。\n白饭充肠聊当肉，好书到手不论钱。\n閒心懒作邯郸梦，乐取西窗一枕眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":381,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其四","author":"仇远","text":"末俗由来不贵儒，愚夫愚妇恣揶揄。\n束书合向山林隐，绝迹莫登名利途。\n膝下有孙贫亦乐，门前无债醉如泥。\n咸平处士真堪羡，静守梅花住里湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":382,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其二","author":"仇远","text":"野鹤清高六翮轻，孤云万里去冥冥。\n汉科合应茂才选，唐士曾书遗教经。\n好趁江南诸老在，尽看蓟北众山青。\n锦衣归日春风满，期醉沙堤双玉瓶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":383,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五日","author":"仇远","text":"湘魄能传楚泽芳，何如倒载醉襄阳。\n夕阴空照栽葵圃，宿雨难乾打麦场。\n龙去涎留丹井湿，燕归泥落墨池香。\n枉将黍粽沉蛟窟，移与江村饷水荒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":384,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五月六日晴芮君节卞西仲诸友来泛蒲和韵","author":"仇远","text":"端午凄凉雨压城，忽然端六报新晴。\n素衣尘暗行人老，绿树阴浓曙日明。\n倦眼冥冥浑似雾，忧心悄悄只如酲。\n枇杷荐酒犹堪醉，杏子微酸尚带生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":385,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元夕放夜","author":"仇远","text":"绣衣玉节驻江城，放得元宵两夜晴。\n陆地金莲方滟滟，一天明月故盈盈。\n逻兵酣卧忘钟韵，游子欢呼趁鼓声。\n儿女看灯归较晚，老夫自剔读书檠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":386,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元夕恩霈即事","author":"仇远","text":"驲骑中宵至，圜扉彻晓空。\n天恩何旷荡，春意亦冲融。\n灯火千家市，弦歌一亩宫。\n明知和气聚，瑞雪舞东风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":387,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元友山南山新居 其二","author":"仇远","text":"幽居稳占南山下，人迹稀疏水竹村。\n转巷始知犹有路，傍湖更好别开门。\n酒尊尽日尝谋妇，诗课閒时略抱孙。\n孤鹤不来高士少，暗香且伴月黄昏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":388,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元友山南山新居 其一","author":"仇远","text":"桃柳参差出短墙，小楼突兀看湖光。\n出门便与青山对，读易能消白日长。\n砚石洗来如玉润，药苗晒得似茶香。\n邻僧亦有通文者，常把诗来恼漫郎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":389,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"公退曝日","author":"仇远","text":"公退无营懒读书，出门佳客费招呼。\n閒搔短发身将老，独坐长檐日未晡。\n溪女卖鱼随市价，村夫骑马纳官租。\n劳生役役知何益，却笑今吾即故吾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":390,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"六月雨","author":"仇远","text":"骤雨忽终日，高田知有秋。\n斜风驱溽暑，平地作交流。\n屋漏忙移坐，泥深懒出游。\n美哉今夕睡，凉意已浮浮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":391,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"凤凰山故宫","author":"仇远","text":"渐无南渡旧衣冠，尚有西湖风雨寒。\n凤鸟不来山寂寂，鸱夷何在海漫漫。\n荒陵樵采官犹禁，故苑烟花客自看。\n惟恨馀杭门外柳，长年不了送征鞍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":392,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"勾龙爽毛女","author":"仇远","text":"曾是阿房学舞人，玉箫旧谱尚随身。\n喜归商岭寻仙药，忍见秦宫化劫尘。\n松蜜春腴差可饱，槲衣秋碎不须纫。\n凭谁唤起勾龙爽，更写湘妃与洛神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":393,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忆西坡梅","author":"仇远","text":"杖藜久不到西坡，苔上梅花积渐多。\n野屋荒凉谁管领，酒尊期会竟蹉跎。\n韶光二月已强半，乐事一生能几何。\n赖有邻园春可折，洗瓶斜插在行窝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":394,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忆畅庆玉如四上人","author":"仇远","text":"腊中晴色久，霜月冷森森。\n可但思元度，惟应忆道林。\n三更难得晓，一片欲归心。\n有约分苔石，南山苍树阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":395,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"方万里史敬舆陈孝先龚圣予胡穆仲相继沦没令人感怆","author":"仇远","text":"诸老俱尘土，令予双泪流。\n几年能再见，一气故应休。\n江左衣冠尽，人间翰墨留。\n空山茅屋底，野史属谁修。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":396,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"方竹杖","author":"仇远","text":"劲节棱棱瘦且坚，形模界尺出天然。\n山翁甚爱资扶老，村衲无知误削圆。\n偏称深衣同此矩，漫誇长笛大如椽。\n有时閒为吟诗出，徙倚中庭月一砖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":397,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"长昼","author":"仇远","text":"閒官少公出，长日足高眠。\n律己惟三尺，埋头又两年。\n虽无乞米帖，安得买山钱。\n莫听閒唇舌，行藏任老天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":398,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"风起","author":"仇远","text":"朔风连夕起，浩荡厉严寒。\n远势惊春梦，微权属冷官。\n云行和月暗，木落打窗乾。\n因忆吴船客，波涛寝不安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":399,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"代步","author":"仇远","text":"羸骖聊代步，按辔且徐行。\n凹凸惊前路，驱驰羡后生。\n晓回天尚闇，路滑雨初晴。\n得似肩舆稳，归来醉不惊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":400,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬日小斋即事","author":"仇远","text":"芦苇周遭旧楮糊，就中穴地砌砖炉。\n儒酸官冷浑相称，草卧毡眠本不拘。\n窗外十分西日照，帘间半点北风无。\n一瓶雪水煎茶熟，清气真能压武夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":401,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北村吴园雨中赏牡丹主人留饮","author":"仇远","text":"不谓村园见此花，娇红数朵眩晴霞。\n可怜国色天香种，竟落田夫野老家。\n略具杯盘供笋蕨，已拚杖屦污泥沙。\n莫愁乳鹿衔春去，自有蓬蒿尽力遮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":402,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四月十六夜月蚀","author":"仇远","text":"盛服拜清夜，中庭朝太阴。\n凡来仰天者，俱有爱君心。\n目断山河影，耳闻钟磬音。\n还光俄顷易，涕泗漫沾襟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":403,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"处暑后风雨","author":"仇远","text":"疾风驱急雨，残暑扫除空。\n因识炎凉态，都来顷刻中。\n纸窗嫌有隙，纨扇笑无功。\n儿读秋声赋，令人忆醉翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":404,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月二十四日送廉使出郊 其二","author":"仇远","text":"野店当官道，村醪唤客留。\n偶因乘早出，故作探春游。\n芳意林梢静，晴光水面浮。\n人言有龙洞，近在石山头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":405,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月二十四日送廉使出郊 其一","author":"仇远","text":"閒骑羸马出，远饯绣衣行。\n爱此川原迥，欣然风日晴。\n隔篱梅半落，断陇麦初生。\n每恨微官缚，茅山负夙盟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":406,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"永迥观赏桂刘君佐黄景岩治酒","author":"仇远","text":"双桂峥嵘万竹间，云枝露粟缀高寒。\n轩窗日日吹香过，冠盖时时载酒看。\n月里曾舂金杵臼，雨馀乱点石棋盘。\n乘槎仙子清如鹤，一曲霓裳舞素鸾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":407,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"生日和洪山甫见赠韵","author":"仇远","text":"雪云无罅霁无期，勾引春光入泮池。\n师道幸为文学掾，尧夫喜见太平时。\n典衣沽酒从儿笑，闭户吟诗只子知。\n甚欲相随强歌舞，却怜多病觉衰迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":408,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"用韵答萧济翁","author":"仇远","text":"想君不欠买山钱，要学骑驴孟浩然。\n拂袖径行轻万里，著书直待后千年。\n林泉短褐凄将老，斋馆孤灯耿不眠。\n明旦履霜何所向，大茅峰顶看芝田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":409,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"石屋洞","author":"仇远","text":"谁擘空青露石坳，游龙伸臂下南高。\n鬼神穿凿地脉碎，风雨支撑天柱牢。\n峭壁苍苔侵佛髻，悬崖滴乳湿僧袍。\n伽蓝闻是香山叟，灯暗荒池没野蒿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":410,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"交山龙祠祷雨","author":"仇远","text":"晓入荒蹊陟断冈，多年庙食白龙王。\n要添溪上半篙水，不远山中一瓣香。\n灌木云昏旌旆出，高田土渴桔槔忙。\n莫疑栖隐无深洞，且得随车雨送凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":411,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再和卞仲祥","author":"仇远","text":"待月东扉外，一枝明烛残。\n谁将丹桂子，种在碧云端。\n病叶依窗湿，饥鸿集渚寒。\n婵娟为雨妒，怊怅又更阑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":412,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再寄子野","author":"仇远","text":"霜力风威各逞强，老夫絮被不离床。\n一贫已幸官将满，百计无如归最长。\n别后交朋难得信，梦中文字不成章。\n从来心似梅花白，莫入东风桃李场。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":413,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再叠 其四","author":"仇远","text":"雪溪渔隐者，郊岛是前身。\n乍见犹疑傲，相逢不说贫。\n鹤招穷处士，梅伴老诗人。\n时共论文酒，衰颜少借春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":414,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再叠 其三","author":"仇远","text":"老景存三乐，浮生付六如。\n是非忘马指，憎爱任乌胥。\n故里仍饥馑，清流例阔疏。\n有人风雪外，诗在断桥驴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":415,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再叠 其二","author":"仇远","text":"世态年年改，穷居事事难。\n予怀虽浩荡，此地本酸寒。\n古濑浮贞女，空斋贮冷官。\n枯肠与藜苋，岁久颇相安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":416,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再叠 其一","author":"仇远","text":"醉眠春一榻，不记梦伊何。\n落月明红叶，寒厅暗绿莎。\n敝袍为客久，高枕阅人多。\n未有匡时策，无心中甲科。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":417,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"刘伶墓","author":"仇远","text":"凤浦鸳湖西有坟，此茔寂寞海边村。\n落花红雨鬼仙句，淡月黄昏酒圣魂。\n有锸已随棺椁化，无碑空信艾刍言。\n螟蛉蜾蠃今何在，起为先生酹一尊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":418,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同陈彦国汎湖","author":"仇远","text":"斜堤高柳绿连天，且系閒人书画船。\n花事已空三月后，湖光还似十年前。\n洛阳园囿惟诗在，江左英雄托酒传。\n亦欲扣舷歌小海，恐惊沙上白鸥眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":419,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同室","author":"仇远","text":"同室过百指，一官寖四年。\n幸无乞米帖，何取买山钱。\n止酒陶元亮，思归孟浩然。\n乾鱼兼菜把，颇胜酌贪泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":420,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"如上人归问浙中友信","author":"仇远","text":"何年驻锡下山中，既见匆匆又欲东。\n燕去鸿来俱是客，云生月落不离空。\n冷泉亭上参吟畅，飞雪岩前哭老同。\n方外友朋询近况，为言已作木鸡翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":421,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙康侯北归","author":"仇远","text":"淮海十年别，北归今几时。\n镜中无旧发，囊底有新诗。\n每恨为官缚，翻令见面迟。\n清都游历事，还许俗人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":422,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岁穷早睡","author":"仇远","text":"骥尾流光不可追，山中小草合知非。\n腊馀四日春先到，官满三年客早归。\n暗雨随风茅屋漏，荒城争米燎盆稀。\n明朝又赴公筵贺，灯下醒眠懒解衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":423,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岁除志喜","author":"仇远","text":"郊居守岁若为情，一岁中间百事经。\n建业长男方入拜，桐江小女又归宁。\n蒙头被暖先高卧，婪尾杯空且独醒。\n席上梅花开胜雪，寒香尽足慰飘零。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":424,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岁晏迁居","author":"仇远","text":"借榻青安恰一年，年穷何事复谋迁。\n官閒空绾文章印，水浅难移书画船。\n稚子欢呼新入屋，老夫叹息早归田。\n人生聚散如凫雁，极目江湖万里天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":425,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"庆孝僧自金陵回虎林","author":"仇远","text":"白下长干住几年，西风入梦即飘然。\n断桥梅柳全非旧，古刹钟鱼大胜前。\n万里岂宜常作客，一箪且可稳栖禅。\n沧江东去风波恶，亦欲湖山结数椽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":426,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"有感","author":"仇远","text":"腐儒乖世用，作事例迂疏。\n浪走长安道，欲投光范书。\n悬知成漫尔，可笑赋归与。\n寄语陈言者，毋轻出草庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":427,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次日归舟和南仲","author":"仇远","text":"?山渺渺点青螺，古濑澄澄似绛河。\n尘世不知秋过半，水乡但觉月明多。\n轻舟傲兀鱼龙窟，夹岸横陈早晚禾。\n一笑跃身烟雾表，醉归何恤夜行诃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":428,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次西和韵","author":"仇远","text":"贫是儒家事，生平畏四知。\n灯花空送喜，瓶粟不供炊。\n湖海心终在，田园计未迟。\n愿同华山叟，驴背倒能骑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":429,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次彦功韵","author":"仇远","text":"春早风驱雪，天寒竹映门。\n灯前终夜读，笈内故书存。\n尚觉文章贵，那矜齿爵尊。\n向平愁未了，女嫁与儿昏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":430,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次胡苇杭韵","author":"仇远","text":"曾识清明上巳时，懒能游冶步芳菲。\n梨花半落雨初过，杜宇不鸣春自归。\n双冢年深人祭少，孤山日晚客来稀。\n江南尚有馀寒在，莫倚东风褪絮衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":431,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次萧饶州韵 其四","author":"仇远","text":"数椽西郭外，元不异村居。\n官冷谋升斗，头童怯比疏。\n莫愁书费纸，肯叹出无车。\n也胜焦徵士，蜗牛卧雪庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":432,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次萧饶州韵 其一","author":"仇远","text":"爱山如爱士，交友竟忘年。\n未老先辞禄，能閒始是仙。\n清谈真药石，雅志乐林泉。\n笑看衡门外，随风柳絮颠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":433,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次萧饶州韵 其二","author":"仇远","text":"谦谦贤太守，止止乐閒居。\n健笔凌三谢，高风继二疏。\n家犹传故笏，梦不到安车。\n何处溪山好，相从结草庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":434,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次萧饶州韵 其三","author":"仇远","text":"寓舍已三迁，闲官又一年。\n酒杯时乐圣，茶椀欲通仙。\n爱笋从穿壁，浇花自汲泉。\n谁能问前代，刘蹶与秦颠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":435,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]