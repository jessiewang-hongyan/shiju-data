[{"title":"湖州歌九十八首 其五十三","author":"汪元量","text":"宝应城南柳数枝，葭墙艾席是民居。\n眼前境逆没诗兴，忽有小舟来卖鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5563,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十四","author":"汪元量","text":"船泊邳州古岸傍，斜风细雨送昏黄。\n美人十二船中坐，犹把金猊炷好香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5564,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十五","author":"汪元量","text":"徐州城上觅黄楼，四壁诗章读不休。\n更欲登台看戏马，州官携酒共嬉游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5565,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十六","author":"汪元量","text":"歌风台畔水沄沄，地面官人馈酒荤。\n宫女上船嬉一霎，不禁尘土污衣裙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5566,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十七","author":"汪元量","text":"新济州来旧济州，柳门西畔两三鸥。\n酒边笑谑消长日，弄竹弹丝尽胜流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5567,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十八","author":"汪元量","text":"一更船泊郓州城，城外巡军夜柝鸣。\n如此月圆如此客，犹能把酒到天明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5568,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十九","author":"汪元量","text":"琵琶切切更嘈嘈，高柳群蝉遂不号。\n一片夕阳无限好，汶河西上酒楼高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5569,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十","author":"汪元量","text":"锦帆百幅碍斜阳，遥望陵州里许长。\n车马争驰迎把盏，走来船上看花娘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5570,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十一","author":"汪元量","text":"兀兀篷窗坐似禅，景州城外更凄然。\n官河宛转无风力，马曳驴拖鼓子船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5571,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十二","author":"汪元量","text":"灌州河水曲如弓，青草坪边路向东。\n船过州南忽奇绝，一如湖上藕花风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5572,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十三","author":"汪元量","text":"船到沧州且少留，客来同上酒家楼。\n沿河树折枣初剥，满地藤枯瓜未收。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5573,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十四","author":"汪元量","text":"牙樯暂住献州城，鹭去鸥来管送迎。\n卧笑宫人掷骰子，金钱痴咒卜输赢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5574,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十五","author":"汪元量","text":"日中转柁到河间，万里羁人强自宽。\n此夜此歌如此酒，长安月色好谁看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5575,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十六","author":"汪元量","text":"长芦转柁是通津，尽是东西南北人。\n日暮烟花箫鼓闹，红楼烂醉楚州春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5576,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十七","author":"汪元量","text":"恰到杨村旧马头，北风吹雨便成秋。\n呜呜鬼物败人兴，掩却篷窗且睡休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5577,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十八","author":"汪元量","text":"满朝宰相出通州，迎接三宫晏不休。\n六十里天围锦帐，素车白马月中游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5578,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六十九","author":"汪元量","text":"会同馆里紫蒙茸，兰麝飘来阵阵风。\n箫鼓沸天回雁舞，黄罗帐幔燕三宫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5579,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十","author":"汪元量","text":"皇帝初开第一筵，天颜问劳思绵绵。\n大元皇后同茶饭，宴罢归来月满天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5580,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十一","author":"汪元量","text":"第二筵开入九重，君王把酒劝三宫。\n驼峰割罢行酥酪，又进雕盘嫩韭葱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5581,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十二","author":"汪元量","text":"第三筵开在蓬莱，丞相行杯不放杯。\n割马烧羊熬解粥，三宫宴罢谢恩回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5582,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十三","author":"汪元量","text":"第四排筵在广寒，葡萄酒酿色如丹。\n并刀细割天鸡肉，宴罢归来月满鞍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5583,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十四","author":"汪元量","text":"第五华筵正大宫，辘轳引酒吸长虹。\n金盘堆起胡羊肉，禦指三千响碧空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5584,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十五","author":"汪元量","text":"第六筵开在禁庭，蒸麋烧鹿荐杯行。\n三宫满饮天颜喜，月下笙歌入旧城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5585,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十六","author":"汪元量","text":"第七筵排极整齐，三宫游处软舆提。\n杏浆新沃烧熊肉，更进鹌鹑野雉鸡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5586,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十七","author":"汪元量","text":"第八筵开在北亭，三宫丰燕已恩荣。\n诸行百戏都呈艺，乐局伶官叫点名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5587,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十八","author":"汪元量","text":"第九筵开尽帝妃，三宫端坐受金卮。\n须臾殿上都酣醉，拍手高歌舞雁儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5588,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七十九","author":"汪元量","text":"第十琼筵敞禁庭，两厢丞相把壶瓶。\n君王自劝三宫酒，更送天香近玉屏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5589,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十","author":"汪元量","text":"一人不杀谢乾坤，万里来来谒帝阍。\n高下受官随品从，九流艺术亦沾恩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5590,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十一","author":"汪元量","text":"僧道恩荣已受封，上庠儒者亦恩隆。\n福王又拜平原郡，幼主新封瀛国公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5591,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十二","author":"汪元量","text":"金屋妆成物色新，三宫日用御厨珍。\n其馀宫女千馀个，分嫁幽州老斲轮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5592,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十三","author":"汪元量","text":"每月支粮万石钧，日支羊肉六千斤。\n御厨请给葡萄酒，别赐天鹅与野麇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5593,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十四","author":"汪元量","text":"三宫寝室异香飘，貂鼠毡帘锦绣标。\n花毯褥裀三万件，织金凤被八千条。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5594,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十五","author":"汪元量","text":"客中忽忽又重阳，满酌葡萄当菊觞。\n谢后已叨新圣旨，谢家田土免输粮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5595,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十六","author":"汪元量","text":"雪里天家赐炕羊，两壶九酝紫霞觞。\n三宫夜给千条烛，更赐高丽黑玉香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5596,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十七","author":"汪元量","text":"三殿加餐强自宽，内家日日问平安。\n大元皇后来相探，特赐丝紬二百单。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5597,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十八","author":"汪元量","text":"万里修途似梦中，天家赐予意无穷。\n昭仪别馆香云煖，自把诗书授国公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5598,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八十九","author":"汪元量","text":"万里羁孤夜忆家，边城吹角更吹笳。\n须臾敕使传言语，今日天庭赏雪花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5599,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十","author":"汪元量","text":"雪子飞飞塞面寒，地炉石炭共团栾。\n天家赐酒十银瓮，熊掌天鹅三玉盘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5600,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十一","author":"汪元量","text":"江南郡守列金阶，内里华筵日日排。\n文武官僚多二品，还乡尽带虎头牌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5601,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十二","author":"汪元量","text":"四川昝帅尚粗豪，万马来燕贡一遭。\n奏授虎符三百面，内家更赐织金袍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5602,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十三","author":"汪元量","text":"九重蕡烛照帘栊，三殿乘舆去贺冬。\n金面垂慈多喜色，史官书瑞奏年丰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5603,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十四","author":"汪元量","text":"晓望燕云正雪天，闭门毡帐恣高眠。\n内家遗钞三千锭，添赐三宫日用钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5604,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十五","author":"汪元量","text":"东宫雪里燕三宫，妃子殷勤把酒钟。\n百十箜篌弹玉指，两行珠翠击金镛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5605,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十六","author":"汪元量","text":"夜来酒醒四更过，渐觉衾裯冷气多。\n踏雪敲门双敕使，传言太子送天鹅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5606,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十七","author":"汪元量","text":"两下金襕障御阶，异香缥缈五门开。\n都人罢市从容立，迎接南朝驸马来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5607,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九十八","author":"汪元量","text":"杭州万里到幽州，百咏歌成意未休。\n燕玉偶然通一笑，歌喉宛转作吴讴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5608,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"琴台","author":"汪元量","text":"文园多病厌文君，恨入金徽不忍闻。\n寂寞高台留古迹，来牛去马自成群。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5609,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答同舍杜德机","author":"汪元量","text":"北风吹我上金台，忍见蛾眉堕马嵬。\n宴罢蟠桃王母去，江南肠断贺方回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5610,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答林石田","author":"汪元量","text":"南朝千古伤心事，每阅陈编泪满襟。\n我更伤心成野史，人看野史更伤心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5611,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越女","author":"汪元量","text":"越女为驱虏，朝来揽镜慵。\n欲梳新堕马，忍□□□□。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5612,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其六","author":"汪元量","text":"师相平章误我朝，千秋万古恨难销。\n萧墙祸起非今日，不赏军功在断桥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5613,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其二","author":"汪元量","text":"东南半壁日昏昏，万骑临轩趣幼君。\n三十六宫随辇去，不堪回首望吴云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5614,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其八","author":"汪元量","text":"鲁港当年傀儡场，六军尽笑贾平章。\n三声锣响三更后，不见人呼大魏王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5615,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十九","author":"汪元量","text":"年年宫柳好春光，百啭黄鹂绕建章。\n冶杏夭桃红胜锦，牡丹屏里燕诸王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5616,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十六","author":"汪元量","text":"昨梦吴山阆苑开，风吹仙乐下瑶台。\n翠围红阵知多少，半揭珠帘看驾来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5617,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十","author":"汪元量","text":"贾庙巍巍尽敕封，秦齐两国受恩同。\n木棉庵下无依鬼，合策麒麟第一功。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5618,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十八","author":"汪元量","text":"内湖三月赏新荷，锦缆龙舟缓缓拖。\n醉里君王宣乐部，隔花教唱采莲歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5619,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十四","author":"汪元量","text":"丝风毛雨共凄凉，燕子楼空恨恨长。\n今日客逢新酒熟，夜来春去落花忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5620,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十五","author":"汪元量","text":"月夜湖歌歌正长，船来船去水茫茫。\n上塘歌了下塘唱，更唱吴王与越王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5621,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其二十","author":"汪元量","text":"昔梦吴山列御筵，三千宫女烛金莲。\n而今莫说梦中梦，梦里吴山只自怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5622,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其七","author":"汪元量","text":"苍生恸哭入云霄，内苑琼林已作樵。\n打断六更天未晓，禁庭两桁籸盘烧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5623,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其三","author":"汪元量","text":"一阵西风满地烟，千军万马浙江边。\n官司把断西兴渡，要夺渔船作战船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5624,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十二","author":"汪元量","text":"群臣上疏纳忠言，国害分明在目前。\n只论平章行不法，公田之后又私田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5625,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其九","author":"汪元量","text":"脱却黄袍心莫欺，魏王事业止于斯。\n孤舟走过扬州去，表奏朝廷乞太师。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5626,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其十三","author":"汪元量","text":"甲子初秋柳宿乖，皇天无雨只空雷。\n正当七月初三夜，帝劝长星酒一杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5627,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其五","author":"汪元量","text":"秋风吹雨暗天涯，越鸟巢翻何以家。\n岭上万松都斫尽，西湖新路欲排叉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5628,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州歌二十首 其四","author":"汪元量","text":"两峰云锁几时开，昨夜京城战鼓哀。\n渔父生来载歌舞，满头白发见兵来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5629,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蓟北春望","author":"汪元量","text":"江南二月蕨笋肥，江北客行殊未归。\n怕上西楼洒乡泪，东风吹雨湿征衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5630,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蜀主芙蓉城","author":"汪元量","text":"芙蓉城上草萋萋，吊古徘徊日欲西。\n帝子不来花蕊去，荒宫无主乱鸦啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5631,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蜀道","author":"汪元量","text":"蜀道难行高接天，秦关勒马望西川。\n峨眉崒嵂知何处，剑阁崔巍若个边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5632,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"嘉定府","author":"汪元量","text":"郡楼著眼蜀天宽，分得巴江水一湾。\n大小峨眉相对立，梨花山接海棠山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5633,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其五","author":"汪元量","text":"乱点连声杀六更，荧荧庭燎待天明。\n侍臣已写归降表，臣妾佥名谢道清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5634,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其七","author":"汪元量","text":"北师要讨撒花银，官府行移逼市民。\n丞相伯颜犹有语，学中要拣秀才人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5635,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]