[{"title":"饯怡斋胡宪使","author":"王义山","text":"不是胸中熟吕刑，如何议谳极详明。\n严于三尺古来法，宽以一分天好生。\n仁意满腔皆恻隐，政声交口说廉平。\n玉堂本是青毡旧，跳过郎星向上行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3925,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日即事二首 其二","author":"王义山","text":"步屧随风过柳川，眼前气象觉熙然。\n勾萌甲拆皆春意，鱼跃鸢飞遂性天。\n绿草方浓山尽发，紫芽新迸蕨初拳。\n自形自色何容巧，禀赋元来物得偏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3926,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日即事二首 其一","author":"王义山","text":"朔气棱棱带雪吹，凝阴四面锁寒枝。\n自回造化微和后，如再洪濛未判时。\n天遣江山醒醉眼，春将景色入新诗。\n乡晨一部箫韶奏，草绿花红山鸟嬉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3927,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蚤起斋檐独坐","author":"王义山","text":"轻寒测测雨冥冥，不觉閒中春一庭。\n老竹似欺窗草绿，落梅微间翠苔青。\n倏听莺语调新曲，默看蛛丝网碎屏。\n物意人情两相得，莫容尘俗挠中扃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3928,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送云游瑩上人","author":"王义山","text":"从前身不染飞埃，雪窦云峰任往来。\n石路滑时宜驻锡，浪头危处且浮杯。\n眼高桑下肯三宿，脚健山中能万回。\n四大空虚何底止，信渠钻得纸窗开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3929,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送余仲谦赴江州教","author":"王义山","text":"广文要饭又何难，所在侏儒烂饱餐。\n热选尽教众人取，冷官要耐五更寒。\n田园彭泽菊三径，意思濂溪草一般。\n湓浦依然遗迹在，道源须是静中看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3930,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送奉使翰林颁降历日回","author":"王义山","text":"历家差只在毫釐，有诏清台子细推。\n三代以来宗夏正，溥天之下再尧时。\n暂烦英节来将命，归对薇花好赋诗。\n夜直禁林如有问，江南民力正疮痍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3931,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送按察魏经历","author":"王义山","text":"公论难磨口似碑，肯将虚誉博人诗。\n心常近厚元非弱，职在详刑安忍施。\n两载依然如始至，一廉岂是要人知。\n怕闻骢马骑将去，惹起西人无限思。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3932,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送按察王佥事除行台察院 其一","author":"王义山","text":"漠漠天高不可呼，斯民何处诉无辜。\n从来鹰隼肯驱雀，除却豺狼安问狐。\n霹雳一声碎奸胆，风霜八路击贪夫。\n得公数辈遍天下，民命从今盍少苏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3933,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送按察王佥事除行台察院 其二","author":"王义山","text":"夺去江西一福星，维扬无地著先声。\n数千百里人相贺，二十四桥风便清。\n祇为外台要精采，更烦辣手大支撑。\n劝君放缓骑骢马，怕有人来境上争。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3934,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽山居刘侯官 其三","author":"王义山","text":"雪坡仙去又山居，凋谢堪为世道悲。\n师鲁仅存遗集在，乐天无限故人思。\n追怀把酒论文日，忍读停云对雨诗。\n千里有书报埋玉，衔哀莫写泪交颐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3935,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽山居刘侯官 其二","author":"王义山","text":"赋埒相如轧子云，词场几度策奇勋。\n不卑铜绶肯为宰，须是玉堂方著君。\n准拟日边行接武，奈何地下要修文。\n试将六稿从头读，羞杀时流把砚焚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3936,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽山居刘侯官 其一","author":"王义山","text":"渥洼生出此骅骝，父子当今第一流。\n争道老泉生二秀，最难锦水又三刘。\n悫亡明道碑东洛，塾死文公哭婺州。\n留得一家书脉在，郎君见说突烟楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3937,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽云屋徐侍郎 其二","author":"王义山","text":"雁塔题名墨尚鲜，九州四海此同年。\n故人直上青云路，凡俗那能白骨仙。\n不善巧图真个拙，祇因方处久些圆。\n万钟不博箪瓢乐，有命何如有性焉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3938,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽云屋徐侍郎 其一","author":"王义山","text":"阖朝奔逸荡无关，夜半潇潇风雨寒。\n世乱争先寻活路，时贫输与做穷官。\n平生自谓学无事，一死谅非君所难。\n到此徬徨犹不忍，国亡那敢计身安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3939,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽介堂胡知郡 其二","author":"王义山","text":"六馆诸生伏下风，少年声价在黉宫。\n交游湖海天下士，规矩乾坤心匠中。\n竹使分符春坱圠，棠阴匝地昼朦胧。\n新昌人所难为事，人到于今说介翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3940,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽介堂胡知郡 其一","author":"王义山","text":"忆昨云从东野时，天街携手话心知。\n澹庵往矣谁其嗣，文定今之学者师。\n德邵年高前辈行，山摧木坏哲人萎。\n虎头城下艰难共，古道如公更有谁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3941,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽白鹿洞宾吕善居","author":"王义山","text":"元是双峰门下士，席间参请到源头。\n鲁人知有乐正子，汉世曾称马少游。\n白鹿洞宾儒领袖，紫阳教主道源流。\n有儿曾斫月中桂，家学相传卒未休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3942,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽竹芗龚侍郎 其二","author":"王义山","text":"一木难支大厦倾，阖门拚却赴波鲸。\n归来止为寻坟陇，隐去不教知姓名。\n剩有诗篇传不朽，相从野老话生平。\n翩翩只鹤扶云去，群玉峰头籍大清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3943,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽竹芗龚侍郎 其一","author":"王义山","text":"犹记乌台第一章，当年物论忒雌黄。\n人心自有公非是，天理岂能终晦亡。\n奸魄虽生名已死，弹文尚湿墨犹香。\n偷生宁复百年活，地下何颜见竹芗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3944,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽李教授","author":"王义山","text":"偏是书生赋分悭，生平受用只儒酸。\n非无热处可炙手，禁得寒时做冷官。\n乃父向年已科目，好儿今日又衣冠。\n期颐上寿古来少，归去关山雾雨漫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3945,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽苏少章","author":"王义山","text":"曾趁当年桂子秋，烦公引领广寒游。\n春官报罢笑归去，底事无成付命休。\n诗又江湖一家数，学寻伊洛到源头。\n忍将感兴篇来读，望断修江无限愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3946,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽实斋刘尚书 其二","author":"王义山","text":"节麾仍帅阃，三道福星临。\n政澈寒潭底，人行明镜心。\n船中不留月，童背也无琴。\n谁憩甘棠下，无穷蔽芾阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3947,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽实斋刘尚书 其一","author":"王义山","text":"紧官都做了，只欠到台司。\n言路古之直，经筵帝者师。\n极中五福备，天下达尊推。\n方曳星辰履，商山已茹芝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3948,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽松麓李佥判","author":"王义山","text":"手拈老笔眇词场，馀子如何敢颉颃。\n疑是前身真贺白，不然今世又苏黄。\n片文落处人争诵，一第欠于天取偿。\n造物却教二郎做，立身既好又名扬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3949,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽度宗 其一","author":"王义山","text":"道隆兼德厚，民庶乐难名。\n宫合府中一，身修天下平。\n有条皆快活，无事不清明。\n长乐天将晚，如闻问寝声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3950,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽胡经干","author":"王义山","text":"手画兵家八阵图，儿时此志已吞吴。\n英雄豪杰所同者，将相王侯有种乎。\n事竟无成空感慨，天胡不忍死须臾。\n东南留得斯人在，半壁乾坤只手扶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3951,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽家溪危知郡","author":"王义山","text":"当家旧只说骊塘，近代家溪名又香。\n仁智扁斋天动静，正邪抗疏界阴阳。\n伤哉所到方丹毂，惜也斯人不玉堂。\n孤负锦江人望断，使君已在白云乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3952,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽贾平章生母 其一","author":"王义山","text":"有子万事足，相与乐湖山。\n花径板舆稳，萱庭衮服斑。\n轲亲荣鼎养，鲁国忽丧还。\n元气极之母，生贤奠两间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3953,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽贾平章生母 其二","author":"王义山","text":"修龄踰八帙，五福萃诸身。\n翟服仪容旧，鸾绫谥诰新。\n艰难共淮楚，褒表建齐秦。\n曾听呼儿道，仲华能笑人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3954,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽鹿泉贾参政二首 其二","author":"王义山","text":"一老皤皤六十馀，直从苦硬做工夫。\n可怜爵齿啬于德，惟有诗书付尔孤。\n后学失师谁主此，斯文坠地果天乎。\n榇归只借帆风力，最是舟中麦也无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3955,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽鹿泉贾参政二首 其一","author":"王义山","text":"夺得公来镇古洪，武昌棠荫蔼春融。\n生民立命学有用，活佛救人天大功。\n上帝遣符徵范镇，斯民失怙哭温公。\n山横抱犊人何在，草木悲号一夜风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3956,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽黄松涧","author":"王义山","text":"少陵元是谁家数，衣钵当初自审言。\n松涧于何寻的派，涪翁之后又仍孙。\n几篇忧国诗奚寄，一念爱君天所根。\n不比骚人弄光景，读君遗稿死犹存。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3957,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽善庆堂黎朝奉","author":"王义山","text":"闻孙姓字魁天下，知是堂中积善深。\n天岂有私惟福善，公于责报本无心。\n方来诸少庭森玉，管取明科榜又金。\n他日貂蝉食家庙，一门青紫列如林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3958,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽遂初陈尚书","author":"王义山","text":"到得咸淳国步艰，几回抗疏动天颜。\n丈夫那肯死牖下，馀子从教活草间。\n有分珠厓终着去，无心白发望生还。\n故人目断暮云处，雾雨濛濛山外山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3959,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽溪园周知郡 其一","author":"王义山","text":"英英玉立已班行，地位如何不庙堂。\n久合飞腾上华要，祇缘抱负太刚方。\n阶庭竞秀誇诸少，衣钵先传属长郎。\n最是一家古三代，棣华今尚有馀芳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3960,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽溪园周知郡 其二","author":"王义山","text":"记得年时试别头，得君引我上瀛洲。\n当场独步眇馀子，好手先拈第一筹。\n锦水曾寻香戟梦，洪崖去伴赤松游。\n瓣香遥致生刍敬，渺渺螺川涕泗流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3961,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽熊县丞","author":"王义山","text":"三叹丞哉不负余，阶庭兰玉又森如。\n乡邻称道有是子，祖父传来只此书。\n勇上璧流逼霄汉，相将金榜到门闾。\n从前不朽惟家学，不必籯金自有馀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3962,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽熊墨庄","author":"王义山","text":"积谷翁家诧富强，千斯仓与万斯箱。\n尽教此辈更多蓄，输与先生这一庄。\n身已九京名不朽，家藏万卷字犹香。\n向来有子曾充赋，赢得此田常不荒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3963,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽横海曾朝议","author":"王义山","text":"父子眉山多一苏，衣冠盛事再堪图。\n岫云懒出官情薄，霖雨未成舆望孤。\n横海仅存遗藁在，临川有此老师无。\n瓣香久欠南丰敬，东望灵车天一隅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3964,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斋居杂兴 其一","author":"王义山","text":"道理须从妙处寻，静中观物了吾心。\n一时俯仰成朝暮，万变纷纭几古今。\n蠖屈蛇伸非矫揉，鸢飞鱼跃自升沉。\n莫随名利相牵引，方寸胶舟泥寸涔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3965,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斋居杂兴 其四","author":"王义山","text":"木曳斜晖抹淡红，薄窗微惹一帘风。\n水如银样浸新月，山耸翠标撑碧穹。\n天为骚人开眼界，酒寻好句入杯中。\n兴来点检江山罢，顷刻阴晴笑化工。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3966,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斋居杂兴 其五","author":"王义山","text":"天根分上下，月窟几晴阴。\n老树吹来古，流芳直到今。\n四时花不断，一本理尤深。\n记得南轩说，要观生物心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3967,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斋居杂兴 其二","author":"王义山","text":"一身自有一乾坤，拍拍阳和禀得淳。\n诗思已随春意动，夜衾不怕晓寒新。\n未应云谷成辽邈，常把沧洲入想因。\n觅句看书无个事，清泉可饮便非贫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3968,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斋居杂兴 其三","author":"王义山","text":"山水之中足可娱，田园数亩任荒芜。\n论交惟有诗知己，把酒相忘月与吾。\n秀石漱泉清可砚，孤峰挂日景堪图。\n可怜直节如松劲，刚被秦封作大夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3969,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯长白李左丞","author":"王义山","text":"往来不特地之灵，西有长庚一点星。\n九路大开行省府，几人争看小朝廷。\n只消馀力镇衡岳，许大先声到洞庭。\n净洗甲兵从此去，烦公更为挽沧溟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3970,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯申屠御史归扬州行台","author":"王义山","text":"僻在江南天一隅，烦公原隰遍驰驱。\n数元结辈已多矣，百子骏今安得乎。\n风力喧传真御史，霜台勇在去贪夫。\n翩翩只鹤骑将去，若问腰缠一孔无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3971,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯张宣慰三首 其三","author":"王义山","text":"种了甘棠打叠回，遮留竞凑辙辕来。\n只存诗檐作行李，若问归囊清过梅。\n抵为运筹咨汉杰，传闻近日筑燕台。\n为言民力东南竭，好趁层霄阊阖开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3972,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯张宣慰三首 其二","author":"王义山","text":"贵介而能大耐官，留心翰墨此为难。\n龙蛇现影笔端活，风雨惊人纸上寒。\n教子一经文墨续，读书万卷夜灯残。\n一门数世衣冠盛，曾把君家家传看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3973,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯张宣慰三首 其一","author":"王义山","text":"奉宣德意慰群生，曾未□年政已成。\n乃父勋名在彝鼎，当家衣钵合钧衡。\n如何归隐山林得，不管从来利禄轻。\n裴度淮西功业了，伫乘驲传上神京。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3974,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶成 其二","author":"王义山","text":"良贵由天赋，欺心天可欺。\n功名皆梦幻，道理厌新奇。\n枫叶敲窗际，梅花对月时。\n个般清趣味，料得少人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3975,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶成 其一","author":"王义山","text":"五性感而动，其间善恶萌。\n危微相对立，体认要研精。\n大学静而得，中庸诚则明。\n原头不参透，何以约其情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3976,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿安仁县市","author":"王义山","text":"安仁斗来大，地窄瞰官途。\n吏散晚衙早，人稀夜市无。\n山多田占少，涧曲水来迂。\n犹道茅包锦，县官来索租。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3977,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题黄静斋","author":"王义山","text":"静中乐处是琴书，此乐输君二美俱。\n明镜无尘佛关捩，内丹养火夜工夫。\n梅花窗下参同契，翠草庭前太极图。\n探得黄庭真诀了，不须更看养生符。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3978,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒中斋杨左丞","author":"王义山","text":"向来曾拜紫宸衙，亲见先班奉日霞。\n帝室馆甥贵公子，王姬下嫁旧儒家。\n执中默契心传妙，勤有无穷学问加。\n带取孤山来作伴，清吟尚可趁梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3979,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒参政张献子","author":"王义山","text":"曾侍龙楼晓色催，真仙那肯下蓬莱。\n离方共睹重光日，震位欣闻长子雷。\n奉使祇应天上去，运筹暂作幄中来。\n老夫羞把诗怀袖，只为明公是秀才。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3980,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒按察马佥事 其一","author":"王义山","text":"黩货无厌政贿成，几年蔀屋不曾晴。\n击奸霹雳从天降，烛物晶明揭日行。\n曩在乌台已风采，特烦龙节更澄清。\n儿童走卒更相顾，夹道传呼司马名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3981,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒按察马佥事 其二","author":"王义山","text":"化瑟新更击巨贪，六条察吏首言赃。\n划开云睹青天日，全藉风闻白简霜。\n佥谓激扬须獬豸，如何放过此豺狼。\n诸生饥欲死难忍，惟有广文餍稻粱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3982,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题吴此民远游集","author":"王义山","text":"偪仄怀居非丈夫，吾今语子好游乎。\n沅湘到处有司马，嵩华至今谈小苏。\n事会无穷闲宇宙，山川有尽眇江湖。\n奇闻壮观多收拾，刮目他时看阿吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3983,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题杜氏匏瓜亭","author":"王义山","text":"道包众妙起经纶，粒粟中藏天地仁。\n五石匏徒誇彼大，一瓢饮有乐之真。\n从来硕果存生意，吾岂匏瓜系此身。\n文穆此心唯念旧，还能续得馑亭春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3984,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题陈宗阳梅花全韵诗集","author":"王义山","text":"骚经比兴殆无遗，何独于梅靳一辞。\n从逊以来方有句，到逋而后愈难诗。\n形容虽巧迹之浅，吟状愈多天者漓。\n独在孤山孤绝处，定交惟有雪相知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3985,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]