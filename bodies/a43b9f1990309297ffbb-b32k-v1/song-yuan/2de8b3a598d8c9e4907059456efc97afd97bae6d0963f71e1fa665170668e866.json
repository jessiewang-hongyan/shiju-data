[{"title":"丁亥寿药房先生四首 其一","author":"陆文圭","text":"贺客门关刺莫传，日高厨传尚萧然。\n遥知独鹤苍苔舞，自点丹砂注内篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5985,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丁丑元夕","author":"陆文圭","text":"入夜不闻箫鼓声，千门月色为谁明。\n无端逻骑阶前过，错认戎家枥马鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5986,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"入京二首 其一","author":"陆文圭","text":"觚棱栖雀五云深，此日江湖向阙心。\n朽骨不堪重拂拭，涓人莫枉费黄金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5987,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又口号四首 其四","author":"陆文圭","text":"幼安伯可号文雄，词寿秦韩枉自工。\n贤相肯交穷处士，何如魏野祝莱公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5988,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又口号四首 其三","author":"陆文圭","text":"华堂捧劝紫霞杯，红粉回头御史来。\n直道素知嫌妩媚，羞将白鹤放笼开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5989,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又口号四首 其二","author":"陆文圭","text":"仁挟翔风勇驾霆，皇华使者出祥刑。\n福星一夕迁吴分，却向龙山现寿星。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5990,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大茅峰四绝句 其二","author":"陆文圭","text":"风吹天朗见秋毫，足力穷时所历高。\n老子何曾烦一步，舆夫攀陟不辞劳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5991,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大茅峰四绝句 其四","author":"陆文圭","text":"一家兄弟入仙门，谁把名山鼎足分。\n我读儒书知长幼，瓣香先礼大茅君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5992,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大茅峰四绝句 其三","author":"陆文圭","text":"羊肠九折路盘岖，不觉腾身上太虚。\n失脚从知高处险，西风斜日早回车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5993,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大茅峰四绝句 其一","author":"陆文圭","text":"悬崖石磴刷苔青，空谷无仙鬼亦灵。\n闻说游人多好事，谁能扶直半山亭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5994,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"小铜屏铸渊明归去诗并坡和章以赠子华侑以绝句","author":"陆文圭","text":"五斗区区肯折腰，眉山早计不如陶。\n小屏一枕还乡梦，五柳门前月正高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5995,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山村示暮春三绝句和韵 其一","author":"陆文圭","text":"怀哉春晚故山薇，冉冉江云日暮低。\n为问柳桥看燕舞，何如松岭听猿啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5996,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山村示暮春三绝句和韵 其三","author":"陆文圭","text":"画帘朱箔燕为家，青草门庭只产蛙。\n一树樱桃红半落，园丁愁杀雨如麻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5997,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山村赠礼敬龙泽上人诗有几年不踏澄江路耆旧唯存陆子方之句和之二首 其二","author":"陆文圭","text":"西山爽气入吾诗，拄颊含毫有所思。\n欲把求田语玄德，莫因学圃笑樊迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5998,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山村赠礼敬龙泽上人诗有几年不踏澄江路耆旧唯存陆子方之句和之二首 其一","author":"陆文圭","text":"西抹东涂衒一乡，阿婆羞忆少年妆。\n如今闭户无人识，旋学仙翁却老方。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5999,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己巳新春 其一","author":"陆文圭","text":"鞭春已罢烧灯近，十日西风未转东。\n料得化工无别意，祇因不放小桃红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6000,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己巳新春 其二","author":"陆文圭","text":"年年春色先催柳，万紫千红次第开。\n零落墙阴人不问，可怜残雪一株梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6001,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"井竭","author":"陆文圭","text":"坎蛙晓渴上苔栏，石甃泥浑底欲乾。\n焦稼不为箪食计，一瓢饮水亦良难。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6002,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文安县","author":"陆文圭","text":"平生知己富欧韩，辛苦修书博一官。\n自是朝廷重科目，且教主簿到文安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6003,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王祈伊中秋不见月四首 其四","author":"陆文圭","text":"开元以后可堪忧，秋雨霪霖稼不收。\n此际霓裳歌一曲，君王正在月宫游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6004,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王祈伊中秋不见月四首 其三","author":"陆文圭","text":"中秋万里共阴晴，曾记坡翁最善评。\n谁信九霄风雨外，群仙正赏月华明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6005,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王祈伊中秋不见月四首 其二","author":"陆文圭","text":"家家望月试停杯，怪底浓云拨不开。\n身入广寒人不见，却从袖里裹将来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6006,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王祈伊中秋不见月四首 其一","author":"陆文圭","text":"秋空碾上一轮冰，积雨连宵洗更清。\n纵有浮云容易散，吹开不待管弦声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6007,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丘庄多稼楼二首 其二","author":"陆文圭","text":"万亩耕耘卒岁勤，可曾一饱慰农人。\n催租令急如风火，输入官仓化腐尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6008,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丘庄多稼楼二首 其一","author":"陆文圭","text":"楼上西风野望时，冥冥禾黍没高低。\n劝农使者来行水，还凭朱栏忆旧题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6009,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"写竹","author":"陆文圭","text":"传神疑有月，著色淡无烟。\n此是诗人笔，胸中有渭川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6010,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"古意四首寄张可与孙晋卿 其一","author":"陆文圭","text":"长安城头红日斜，王孙金弹打乌鸦。\n寄声翠凤穿云去，霜寒莫恋梧桐花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6011,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"古意四首寄张可与孙晋卿 其四","author":"陆文圭","text":"牧儿狭径碍樵枝，樵儿格斗暮不归。\n于菟一声啸篁谷，两儿惊散走如飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6012,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四时佳兴题徐景阳园堂五首 其五","author":"陆文圭","text":"半奁玉镜照须眉，长笑东坡与水嬉。\n直下琤然投小石，一波先动万波随。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6013,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四时佳兴题徐景阳园堂五首 其四","author":"陆文圭","text":"华阳洞口金泉水，流入宫墙作小渠。\n任转秦淮出江去，不应久住化龙鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6014,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四时佳兴题徐景阳园堂五首 其二","author":"陆文圭","text":"门前车马客方散，堂下樽罍酒半醒。\n不信镜中添白发，君山依旧去年青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6015,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四时佳兴题徐景阳园堂五首 其一","author":"陆文圭","text":"溶溶川上花光午，冉冉窗前草色春。\n能识此中真乐处，圣门只有两三人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6016,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宁华张尉卫辉人也因寇失官妻子为掳行乞归乡赠以二绝句 其一","author":"陆文圭","text":"葛藟绵绵长道边，独行踽踽亦堪怜。\n邯郸正近君乡里，好借仙翁一枕眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6017,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宁华张尉卫辉人也因寇失官妻子为掳行乞归乡赠以二绝句 其二","author":"陆文圭","text":"南来憔悴一身存，归雁哀鸣久失群。\n莫怪夜行人不问，形容岂似故将军。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6018,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旧题","author":"陆文圭","text":"剩得清明一半春，蜂衙蝶使往来频。\n东风自动鞦韆索，不见海棠花下人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6019,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"石湖留题三绝 其二","author":"陆文圭","text":"高筑诗坛据越城，醉呼杨陆主文盟。\n至今月下苍苔石，时有先生杖履声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6020,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"石湖留题三绝 其一","author":"陆文圭","text":"仙子骖鸾不可呼，故园花石久应芜。\n不知绿野何人买，试问平泉有子无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6021,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"仲冬雪夜偶书三绝句 其二","author":"陆文圭","text":"拥衾危坐夜沉沉，门外谁知雪寸深。\n掩卷不言空太息，静中忽见古人心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6022,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"仲冬雪夜偶书三绝句 其三","author":"陆文圭","text":"长廊风紧雨冥冥，花落寒灯酒半醒。\n但觉晨光何太早，不知飞霰集窗棂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6023,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"刘澹斋求米船谩赋二绝 其一","author":"陆文圭","text":"文士清高数米颠，蔡公门下讵能贤。\n探囊万一逢江盗，错认真州发运船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6024,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"危金仙示容斋清晖堂诗求跋洪景卢乃危骊塘之座主也因成二首 其二","author":"陆文圭","text":"清晖何处有园堂，消得先生句发扬。\n百世空留遗墨在，后生并不识骊塘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6025,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"危金仙示容斋清晖堂诗求跋洪景卢乃危骊塘之座主也因成二首 其一","author":"陆文圭","text":"卷中人物想乾淳，老笔题诗意转新。\n却怪洪杨交不合，诚斋亦自是诗人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6026,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戏题听琴手卷","author":"陆文圭","text":"流水高山不用弹，巴人下里众皆欢。\n只今何处求钟子，多向文闱作考官。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6027,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江阴有桃源图方圆尺许宫室人物如针粟可数相传有仙宿民家刻桶板为之一夕而成明日遁去友人以本遗余戏题二绝 其二","author":"陆文圭","text":"人说桃源是隐民，神仙幻景即非真。\n如何谷口渔舟路，不许人间再问津。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6028,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江阴有桃源图方圆尺许宫室人物如针粟可数相传有仙宿民家刻桶板为之一夕而成明日遁去友人以本遗余戏题二绝 其一","author":"陆文圭","text":"不自柴桑记里来，似传晨肇入天台。\n世间多少荒唐事，何独神仙有是哉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6029,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其十","author":"陆文圭","text":"草堂未可便移文，自煮清香碧涧芹。\n更向白云深处宿，山头回首谢诸君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6030,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其九","author":"陆文圭","text":"科斗临池学篆文，燕雏带雨掠香芹。\n春闺应恨归来晚，南浦当时错送君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6031,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其八","author":"陆文圭","text":"虎溪何必与禅谈，唯有东篱菊味甘。\n束带肯为儿辈屈，悠然兴在此山南。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6032,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其七","author":"陆文圭","text":"客至从容奉笑谈，晚知蔗境味尤甘。\n曲江进士题名遍，安用山人起水南。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6033,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其五","author":"陆文圭","text":"乍别亲朋似久违，西风尘起染缁衣。\n不须杜宇声声劝，如此江山胡不归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6034,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其四","author":"陆文圭","text":"草色青青没烧痕，山川满目酒盈樽。\n只愁逋客回家日，先被春风紧闭门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6035,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其三","author":"陆文圭","text":"莫惜春衫污酒痕，欲将遗恨寄芳樽。\n清明客里匆匆过，不记桃花笑倚门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6036,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其二","author":"陆文圭","text":"清江漠漠漾晴沙，门对青山买酒家。\n樯外一声金弹子，流莺惊起落庭花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6037,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟中追和逊卿早春即事十首 其一","author":"陆文圭","text":"柳色鹅黄蘸碧沙，隔溪遥指四娘家。\n故园春事如今晚，可见东栏芍药花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6038,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西苑","author":"陆文圭","text":"雪花剪白忘安蒂，霜叶雕红不恋枝。\n争似隋家宫树上，四时锦綵不曾离。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6039,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"启山扫松","author":"陆文圭","text":"一妻一妾閟泉扃，老柏苍苍蔓草青。\n我肯墦间求餍足，魂归不必讪中庭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6040,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"折梅寿宋春卿","author":"陆文圭","text":"南枝春早为谁容，远供寒香寿乃翁。\n不信广平心似铁，能禁索笑倚东风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6041,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和史药房三绝 其一","author":"陆文圭","text":"莫倚承恩赋上林，记曾薄倖托琴心。\n白头又欲轻相背，令蹙山眉作苦吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6042,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和史药房三绝 其三","author":"陆文圭","text":"春被山颠与水涯，尽供物料入诗家。\n陆刘近世升沉异，一为梅花一杏花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6043,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和史药房三绝 其二","author":"陆文圭","text":"出处何如汉二疏，返耕聊以遂吾初。\n虎头未可轻摇笔，牛角何妨且读书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6044,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和张仲实绝句四首 其三","author":"陆文圭","text":"十年讲席坐无毡，尽把行藏付与天。\n策马已甘之反后，著鞭莫竞祖生先。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6045,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和张仲实绝句四首 其二","author":"陆文圭","text":"平生梦不到黄扉，安得京尘染素衣。\n只把一竿江海去，相看鸥鸟亦忘机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6046,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和张仲实绝句四首 其一","author":"陆文圭","text":"江梅岁晚独清妍，南国相逢亦偶然。\n料得知心有寒月，不消重雾与轻烟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6047,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜宿何庄唐主事宅","author":"陆文圭","text":"扶风豪士不知名，樽酒相逢意便倾。\n争似何庄今夜宿，梅花烛影照三更。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6048,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜宿范以善提举云林清远风大作偶成二绝句 其二","author":"陆文圭","text":"云峰顶上玉仙家，误入修廊一径斜。\n夜半月寒风力劲，满山松影走龙蛇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6049,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜宿范以善提举云林清远风大作偶成二绝句 其一","author":"陆文圭","text":"猿啼夹涧声逾远，鹤啄荒苔迹更清。\n身在千林头上立，忽从脚底白云生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6050,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜得二绝寄子华 其一","author":"陆文圭","text":"送客征衫秋八月，怀人病枕夜三更。\n床头稚子呼不觉，窗外潇潇风雨声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6051,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜得二绝寄子华 其二","author":"陆文圭","text":"鸡鸣风雨思君子，雁过潇湘忆故人。\n别去情怀浑欲醉，梦回诗笔已如神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6052,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"临山谷帖不似","author":"陆文圭","text":"曾草华清妙入神，涪翁以后更无人。\n捧心终是西施好，里妇何缘辄效颦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6053,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"临沂沂水道中尘沙眯目不可行闻东北有温泉即浴沂处不及往","author":"陆文圭","text":"临沂以北沂水东，行人扬袂尘沙中。\n纵有温泉能自洁，雩坛安得可乘风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6054,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"枯松","author":"陆文圭","text":"谁见当年长发须，变成龙虎卧交衢。\n虽然拥肿无人问，投老犹堪作大夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6055,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]