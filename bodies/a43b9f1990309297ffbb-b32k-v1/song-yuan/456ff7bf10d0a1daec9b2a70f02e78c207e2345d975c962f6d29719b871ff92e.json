[{"title":"春晴","author":"方回","text":"饕风虐雪到家林，才喜春晴春已深。\n花片纷纷飞蝶乱，树阴渐渐早蝉吟。\n贫宁不仕元知命，老尚能诗懒用心。\n忽喜客来对棋局，旋沽村酒与同斟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2533,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"是日大雨水涨","author":"方回","text":"三桥北畔清湖水，双塔西边晓日楼。\n展转愈知吾事拙，因循复作半年留。\n海风石首随潮上，梅雨航船入市浮。\n时节不殊荣悴异，腐儒杯酒暂忘忧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2534,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"栅堰二叹","author":"方回","text":"船行三五日，不得不思家。\n索米开桥栅，徵钱运堰车。\n于官何所补，为客自堪嗟。\n况复饥荒后，群偷沸似麻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2535,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其十","author":"方回","text":"身起真寒士，名成老腐儒。\n暂时金马署，终世石鱼湖。\n旧种花犹有，新畬粟已无。\n傍人忧饿死，吾自典衣酤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2536,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其九","author":"方回","text":"格磔禽穿户，延缘蚁上衣。\n雨来山气润，花过树阴肥。\n去去春如梦，行行暮独归。\n偶无宾友至，自取一杯挥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2537,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其八","author":"方回","text":"春雨溪桥断，才晴又浅流。\n端能操古节，何至堕穷愁。\n冯衍尝为郡，田丰不愿侯。\n吾儿犹未解，馀子复奚尤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2538,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其七","author":"方回","text":"底用春风急，诗肩暖亦寒。\n儿曹如笋长，吾事只梅酸。\n后死犹容健，馀生愈觉难。\n一瓢自穷巷，何止此堪叹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2539,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其六","author":"方回","text":"果熟携竿扑，禽鸣挟弹窥。\n自怜多病叟，无奈近邻儿。\n排闼宁容锁，踰垣更问篱。\n牡丹才半拆，摘去最红枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2540,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其五","author":"方回","text":"学易何须博，乾坤第一爻。\n两仪能细察，万象已并包。\n枯秸供羸马，纤鳞喂乳猫。\n吾衰有三韭，端胜易牙庖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2541,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其四","author":"方回","text":"登高高处望，万嶂一溪横。\n不满千家市，今休十载兵。\n训狐号永夜，猛虎迫荒城。\n此亦关人事，忧端未易平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2542,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其三","author":"方回","text":"青简兴亡骤，苍规代谢频。\n悬知千古恨，政似一年春。\n甫换钟馗旧，俄闻杜宇新。\n梨花自寒食，谁酹石麒麟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2543,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其二","author":"方回","text":"守郡艰危日，还家老病时。\n僮奴惊逝谢，宾客听分离。\n耨草泥沾手，煎茶火燎髭。\n固穷终不怨，百鍊出新诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2544,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残春感事十首 其一","author":"方回","text":"寒暑元如故，乾坤岂不宽。\n时情工刻薄，生理转艰难。\n遑恤诸儿笑，终凭后代看。\n渊明咏贫士，感慨异悲酸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2545,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"洛社晓行","author":"方回","text":"船摇不能卧，起问夜如何。\n煜煜明邻火，遥遥起暗歌。\n暖知残雪尽，晴见大星多。\n良喜前程稳，无风水不波。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2546,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独酌有感","author":"方回","text":"破窗枯叶共秋声，寒近贫人共喜晴。\n守道故知终有命，感时焉得便无情。\n今年浙右全伤水，何日天涯尽寝兵。\n闻道街头卖黄雀，且须沽酒作南烹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2547,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独游塘头五首 其五","author":"方回","text":"雊雉古原侧，归牛荒潦滨。\n炊烟已昏野，花气更留人。\n剩欲培幽筑，端容买近邻。\n向来惟有梦，今此岂非真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2548,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独游塘头五首 其四","author":"方回","text":"密树窥青果，方塘数绿荷。\n久晴田水细，向晚野烟多。\n兀坐几忘起，成诗费屡哦。\n归鞍犹觉早，再欲叩烟萝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2549,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独游塘头五首 其三","author":"方回","text":"蒲藕上塘种，养鱼于下塘。\n积泥春粪树，储水岁浇秧。\n未藉知章敕，堪浮逸少觞。\n扫松须憩此，系马古垂杨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2550,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独游塘头五首 其二","author":"方回","text":"诗必城之外，胡为不出城。\n渐逢人少处，初听水流声。\n异卉栀香酽，纤梢笋粉明。\n是中亦堪隐，浪出误平生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2551,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"独游塘头五首 其一","author":"方回","text":"纳谒心全懒，紬书眼倍昏。\n偶思行药圃，独往叩柴门。\n湿岸凫梳羽，颓塍枣露根。\n元来好诗句，只在数家村。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2552,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸巳元日年六十七","author":"方回","text":"生平矻矻短檠窗，晚节灰心殢酒缸。\n百岁三分新过二，十行一目旧无双。\n又惊客枕听春雨，即合归舟上浙江。\n未必樊迟劣颜子，故应学稼胜为邦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2553,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸巳生日二首 其二","author":"方回","text":"倚楼历历算行藏，艰阻颠危暗自伤。\n垂近七旬天所借，孰怜三岁父云亡。\n岭南蛊毒千山雾，燕北毡寒六月霜。\n殿榜郡符皆画饼，空馀骨痛似金疮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2554,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸巳生日二首 其一","author":"方回","text":"夜来终日雨如倾，晓起楼头喜渐晴。\n血气衰微吾道胜，欲心死绝此身生。\n一区宅愧先人业，万首诗垂后世名。\n蚊喙收声蛙不吠，忽闻邻柳送啼莺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2555,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未九日","author":"方回","text":"芙蓉一雨烂枝繁，篱落纷披菊满园。\n岁月少恩寒事迫，乾坤多难老身存。\n酒逢我辈何拘节，山在吾家不出门。\n高可常登亦常醉，独能此日与销魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2556,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其十","author":"方回","text":"云无可书者，泥屦隔墙声。\n小市扃虚肆，荒庖绝美烹。\n流涎淮蟹紫，入梦海柑赪。\n莫殢闭关卦，兵戈商不行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2557,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其九","author":"方回","text":"古道古君子，今于何处求。\n每闻栀马箠，不虑檗驴鞦。\n贾药全多伪，医钱卒易酬。\n头岑姑止酒，或恐自然瘳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2558,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其八","author":"方回","text":"家人簪珥旧，草草亦梳妆。\n雪几茶花雅，风炉柿叶香。\n乃翁时自笑，此辈讵吾量。\n免贺俱休拜，新正一并偿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2559,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其七","author":"方回","text":"重报莺花信，谁司铁炭权。\n更经三度节，即满六旬年。\n豪动书千纸，穷难致一钱。\n不忧无穴葬，惟喜有诗传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2560,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其六","author":"方回","text":"贫家无节物，何况此荒城。\n村妓闻来贺，山翁懒出迎。\n头疡连耳肿，夜雨杂风鸣。\n政尔堪高卧，床香菊枕成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2561,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其五","author":"方回","text":"老子家风旧，从来节是常。\n糟姜三盏酒，桕烛一炉香。\n今岁适多病，吾儿犹异乡。\n十分无意绪，檐雨晓淋浪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2562,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其四","author":"方回","text":"此老谁能画，蒙头一破巾。\n有杯常设客，无局不饶人。\n仆醉邻翁怒，儿啼乳媪嗔。\n佯聋付一笑，莫漫耗精神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2563,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其三","author":"方回","text":"忍事宁生瘿，今谁似我能。\n缺钱分灶婢，赊米乞庵僧。\n恶语闻皆恕，凡诗见亦称。\n平生楼百尺，非复旧陈登。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2564,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其二","author":"方回","text":"屋少未成宅，地宽聊作园。\n吾能甘菜食，或颇送花根。\n莳喜阳坡暖，浇怜冻井温。\n丁宁三径客，缓步惜苔痕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2565,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未至节以病晚起走笔戏书纪事排闷十首 其一","author":"方回","text":"遇节何其窘，治家乃尔难。\n谷生舂苦碎，薪贵灶嫌宽。\n病体危狼狈，时情畏触蛮。\n拥衾闻客至，强整旧衣冠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2566,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋风","author":"方回","text":"剩喜秋风起，空庭老树间。\n夜凉瞻北斗，晨爽对南山。\n□□黄花近，今年白羽閒。\n未妨缺耕敛，尚觉老躯顽。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2567,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋到","author":"方回","text":"秋到山居僻，贫无异味尝。\n擘黄新栗嫩，炊白早籼香。\n渐减家人病，徐添夜气凉。\n凭谁理荒秽，篱落菊苗长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2568,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚感怀","author":"方回","text":"脱絺著褐事如何，啬暖饶寒岁易过。\n□喜晚芳怜早谢，细看园菊验塘荷。\n风霜天地秋声急，老病心情醉日多。\n读破少年三万卷，枉将身世堕南柯。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2569,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋暑家多病者","author":"方回","text":"酷暑端何物，穷居值此辰。\n交秋六七月，连病两三人。\n虚屈名医至，深怜老子贫。\n婢慵吾亦愧，煮药缺乌薪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2570,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"种花","author":"方回","text":"平生无嗜好，有地种花看。\n万玉梅成列，千金菊作团。\n秋宜鸿后冷，春惜燕前寒。\n更喜薰风好，青青笋上竿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2571,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"美许孝子","author":"方回","text":"圣善已云远，义方犹此亲。\n须尝许止药，未老窦郎椿。\n竹院深床稳，烟庖垢面尘。\n曾参养曾皙，剩阅舞雩春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2572,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"说诗","author":"方回","text":"齿发侵寻落，风霜取次秋。\n口须湔乳臭，川合向东流。\n沈宋中尝悔，江湖晚更羞。\n此声专老杜，犹俟到夔州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2573,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贺陈正之得男","author":"方回","text":"初喜明珠入掌中，良由善念与天通。\n吉祥预报长庚梦，福德应临长子宫。\n急写贺书端不错，滥叨佳集顾何功。\n此诗特为高门庆，大似麟经记鲁同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2574,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵宾旸唐师善见和涌金城望次韵五首 其五","author":"方回","text":"胪唱曾叨殿上传，末班遥望御炉烟。\n貂蝉公不施霖雨，虮虱臣能补漏天。\n羞见稗官成野史，懒携草具问湖船。\n旧街灯火元宵近，无复遨头夜市穿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2575,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵宾旸唐师善见和涌金城望次韵五首 其三","author":"方回","text":"玉斧难脩旧月轮，凄凉沙鸟犯钩陈。\n总因燕颔多庸将，却误蛾眉事别人。\n一纪于今兵粗定，四民莫若士犹贫。\n酒垆高李能同醉，老眼昏花暂觉春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2576,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵宾旸唐师善见和涌金城望次韵五首 其二","author":"方回","text":"颓城砖甓堕平湖，禁籞彫残故苑芜。\n戚畹换班言肯用，边庭入相事应无。\n福威玉食欺孤主，诗礼金椎党盗儒。\n丧乱谁怜杜陵老，娇儿短褐倒天吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2577,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赵宾旸唐师善见和涌金城望次韵五首 其一","author":"方回","text":"犹存径菊已无荷，城上霜风疋马过。\n厮养前行疑叵可，徼巡侧睨暗谁何。\n感时诗客推敲苦，逃俗编氓剃落多。\n祇为湖山豢佳丽，水犀十万竞投戈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2578,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其六","author":"方回","text":"七十翁非浪走时，夜窗自恨赋归迟。\n睡稀枕上无春梦，吟苦楼前有月知。\n茅索愿追田畯喜，瓜薪遥念室人悲。\n却须天上纶言手，小为农氓缓茧丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2579,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其五","author":"方回","text":"岁岁花时是病时，不争春早与春迟。\n阴晴谩复题窗记，节气还因检历知。\n杜若荐芳聊可采，秭归啼苦未须悲。\n老翁堪与少年竞，勤把青铜照颔丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2580,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其四","author":"方回","text":"即是黄莺紫燕时，稍晴肯放百花迟。\n酒来尚许颜红借，春好何容鬓雪知。\n扶杖可从灵寿赐，闻琴肯作孟尝悲。\n山深粗有延年药，归老松根掘兔丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2581,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其三","author":"方回","text":"物有先时有后时，天工无早亦无迟。\n饱禁夜雨元非恶，暗受春风或未知。\n一死频烦衰白报，三生不为落红悲。\n解纷忆得吾家学，径与挥刀截乱丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2582,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其二","author":"方回","text":"名臣汲黯郑当时，笔阵秦王将尉迟。\n疾电震雷千里起，乖龙老蜃九渊知。\n诸公犹羡归田乐，老我终无叩角悲。\n补衮得人卧桑野，可愁二月卖新丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2583,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追用徐廉使参政子方申屠侍御致远张御史鹏飞元日倡酬韵六首 其一","author":"方回","text":"万马鸣鞭欲晓时，閒人盥漱未妨迟。\n儿童贺喜休多拜，卿相迁除不预知。\n随分乍醒仍乍醉，放怀无喜亦无悲。\n新年自爱新诗好，歙砚梅边洗刷丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2584,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追次仇仁近韵谩成三首 其三","author":"方回","text":"风云乘变化，微贱忽公孤。\n内足穷过达，多求智返愚。\n谈锋椎衍奭，笔阵扫孙吴。\n时彦当如此，吾归钓雪鲈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2585,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追次仇仁近韵谩成三首 其二","author":"方回","text":"卧思身世事，无夜不更深。\n脱难泅登岸，逃名影就阴。\n樽中醉鲁酒，弦外自陶琴。\n诗就谁能赏，徒劳太古吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2586,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追次仇仁近韵谩成三首 其一","author":"方回","text":"儒冠谁使著，何至动言贫。\n此事须吾党，相期到古人。\n衰颜犹可镜，短发仅堪巾。\n举世无知者，孤灯夜独亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2587,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追怀甲戌清明宇文信仲知郡大卿同尤张二倅过予小园赏花","author":"方回","text":"甲戌清明鬓未翁，邦君过我小园中。\n牡丹初喜开千朵，劫火何知付一空。\n展转干戈春梦断，凄凉风雨客途穷。\n九原可作应垂涕，今日前时事不同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2588,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追怀秋崖吏部知郡宗伯","author":"方回","text":"崖仙终牖下，壑鬼死漳南。\n人品谁今识，朝端汝岂堪。\n杞崩溶子口，鲧殛木绵庵。\n犹忆弄权日，湖山极宴酣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2589,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追和艮轩俞同年题程一甫诗卷","author":"方回","text":"人物真高绝，何徒上下床。\n转头异今古，翻手变炎凉。\n应候禽虫语，知时草树香。\n吾曹能不朽，宇宙与俱长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2590,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送江泰发晦庵书院小学教谕","author":"方回","text":"翩然归去两芒鞋，朱子书堂小学斋。\n好向四书寻骨髓，敢辞五岭役筋骸。\n晦传可是终无愧，遁筮谁知晚□佳。\n前哲持身但如此，知时岂不有吾侪。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2591,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送广信山长赵然明","author":"方回","text":"宅本词人杰，祠今学者宗。\n才华明斧藻，师范服章缝。\n竭力钻书蠹，乘时补衮龙。\n勉旃企乡达，徽国荷尧封。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2592,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送天台杨仲儒秀才如北","author":"方回","text":"送君诗者悉豪雄，男子身穷道不穷。\n为问何凭游海内，唯应所恃在胸中。\n渡过淮水即河水，路背南风多北风。\n谁料褐衣抱珠璧，九霄夜月贯长虹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2593,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送天目吴君实馆越 其二","author":"方回","text":"试问推潮鬼定知，几吴几越几西施。\n八千又见阴陵散，十九终存曲水之。\n我辈不当争外物，如君可用要人诗。\n勉哉往学南山豹，端复深藏雾雨姿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2594,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]