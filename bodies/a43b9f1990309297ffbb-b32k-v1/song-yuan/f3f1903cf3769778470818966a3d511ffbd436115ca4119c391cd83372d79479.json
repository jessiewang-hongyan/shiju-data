[{"title":"牟德范题范石湖墨迹次韵","author":"方回","text":"亨衢进补华虫衮，暮景归调姹女炉。\n此老笔端今或有，乾淳蹉了后来无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1306,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"红蔷薇花","author":"方回","text":"月桂金沙各斗春，蔷薇红透更精神。\n虽然面似佳人笑，满体锋铓解刺人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1307,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其六","author":"方回","text":"心情诗卷无佳句，时节梅花有好枝。\n较似后山更平澹，一生爱诵石湖诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1308,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其五","author":"方回","text":"客子光阴诗卷里，杏花消息雨声中。\n我谓简斋此奇句，元来出自后山翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1309,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其四","author":"方回","text":"莼羹鲈鲙鉴湖风，想像依稀老放翁。\n惜为平原多一出，诗名元已擅无穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1310,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其三","author":"方回","text":"灯前一影客中身，鸡未鸣时起已频。\n每日盆梅千百担，倚楼閒作看花人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1311,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其二","author":"方回","text":"征羌汉将赵充国，赐履齐侯周太公。\n虚叟纪年亦云尔，五湖四海一诗穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1312,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至节前一日六首 其一","author":"方回","text":"少陵早是沧浪客，马援真成矍铄翁。\n四十五年忝科第，一生心与布衣同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1313,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其十二","author":"方回","text":"歙州民与睦州民，比似吴儿大较贫。\n为问山中有何好，山中剩有读书人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1314,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其十一","author":"方回","text":"蕨拳欲动茗抽芽，节近清明路近家。\n五日缓行三百里，夹溪随处有桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1315,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其十","author":"方回","text":"青溪元是歙东乡，吾祖于时肯宝黄。\n避地江南结庐处，同时邻舍有严光。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1316,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其九","author":"方回","text":"花间预想到家时，笋蕨堆盘荐酒卮。\n点检儿童参小学，招呼朋友说新诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1317,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其八","author":"方回","text":"野桃篱落鹊双鸣，春晓微寒放嫩晴。\n汛扫松楸家已近，犹馀七日是清明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1318,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其七","author":"方回","text":"刺桐花发草如蓝，欲卸绵袍剪纻衫。\n一夜春霜忽如雪，江南天气不宜蚕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1319,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其六","author":"方回","text":"夜寒如觉有猿吟，积翠重苍万壑深。\n下水轻舟弦脱箭，盘山细路线穿针。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1320,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其五","author":"方回","text":"晚风微劲喜新晴，夜半船窗漏月明。\n卧看孤篷摇水影，悠然枕上一诗成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1321,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其四","author":"方回","text":"水杨梢上欲绵飞，犹觉春寒未解围。\n为怕江风吹客梦，船篷缺处塞蓑衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1322,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其三","author":"方回","text":"乘时盗贼起风尘，战血苔痕几度春。\n古庙仅能存大树，荒山犹自少行人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1323,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其二","author":"方回","text":"立岸儿童看客过，人烟近处放牛多。\n万株漫自栽桑柘，一缕何曾织绮罗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1324,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"舟行青溪道中入歙十二首 其一","author":"方回","text":"覆野春阴不肯晴，舟中无酒亦无饧。\n故教客子知寒食，时有梨花一树明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1325,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"芍药花","author":"方回","text":"眼中不复见姚黄，从古扬州亚洛阳。\n何止中郎虎贲似，政堪花相相花王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1326,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"行于潜县南田中","author":"方回","text":"曾蹑危桥入县行，萧然无处觅诗情。\n不如涉浅田南过，天目山长一抹横。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1327,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"行宫西门","author":"方回","text":"翠华东幸缔和盟，从此君王罢北征。\n宿卫周庐无处所，野人畦菜傍宫城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1328,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西斋","author":"方回","text":"偶得西斋字，向西开此斋。\n人间诗眼少，天下夕阳佳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1329,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖答","author":"方回","text":"浓妆淡抹比蛾眉，多谢苏仙内翰诗。\n若使朝廷无宰嚭，未妨宫掖有西施。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1330,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观丧事","author":"方回","text":"悠悠谁到百年身，百万杭民一聚薪。\n棺内棺前争几许，挽郎自是白须人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1331,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观蚁迁知雨","author":"方回","text":"行行密密复疏疏，衔子沿阶粟粒如。\n几夜夏寒疑未雨，槐安国有五行书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1332,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过长安市","author":"方回","text":"算橘租菱小市哗，堰头桥尾约千家。\n人家已尽无人处，时见芙蓉一岸花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1333,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过石门","author":"方回","text":"麦田下种稻田乾，秋尽江南亦未寒。\n水净风微船牵慢，莼花蕴草尽堪看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1334,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过临平二首 其二","author":"方回","text":"行在名存一梦惺，西湖路近六长亭。\n陈桥驿与临平镇，兴废何人了汗青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1335,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过临平二首 其一","author":"方回","text":"临平山下汎归船，何必荷花五月天。\n记取五更霜□□，□芳桥买小鱼鲜。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1336,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过临平镇","author":"方回","text":"楼船载甲晓闻钲，知是何营将校行。\n百五十年兴废事，韩家军马战临平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1337,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过崇德县","author":"方回","text":"枯柳无风影不摇，败墙颓屋意萧萧。\n忽然唤醒承平梦，犹有红栏夹画桥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1338,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过湖口望庐山","author":"方回","text":"江行初见雪中梅，梅雨霏微棹始回。\n莫道无人肯相送，庐山犹自过湖来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1339,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闭户","author":"方回","text":"闭户瓶梅满屋香，小楼微醉月昏黄。\n三更独坐犹无寐，更欲移花近枕傍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1340,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"问西湖","author":"方回","text":"谁将西子比西湖，旧日繁华渐欲无。\n始信坡仙诗是谶，捧心国色解亡吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1341,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"两邻家一主人群姬歌饮至夜半一母妻哭官检魇死者","author":"方回","text":"歌喉弦指粉红腮，群拥山翁醉玉颓。\n政恐真欢犹是假，不如邻妇哭真哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1342,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"别后","author":"方回","text":"朋簪连日醉如泥，别后临流意自迷。\n语燕驻空相尔汝，飞花吹岸各东西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1343,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其十","author":"方回","text":"船头船尾唱歌声，苏秀湖杭总弟兄。\n喝拢喝开不相照，阿牛贼狗便无情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1344,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其九","author":"方回","text":"赌钱输了阿侬哥，黄草单衫破孔多。\n相趁缩砂红豆客，霜风九月上淮河。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1345,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其八","author":"方回","text":"南姚村打北姚村，鬼哭谁怜枉死魂。\n争似梢工留口吃，秀州城外鸭馄饨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1346,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其七","author":"方回","text":"雇载钱轻载不轻，阿郎拽牵阿奴撑。\n五千斤蜡三千漆，宁馨时年欲夜行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1347,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其六","author":"方回","text":"南到杭州北楚州，三江八堰水通流。\n牵板船篙为饭碗，不能辛苦把锄头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1348,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其五","author":"方回","text":"十千债要廿千偿，债主仍须数倍强。\n定是还家被官缚，且将贯百寄妻娘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1349,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其四","author":"方回","text":"四千五百魏塘船，结拆船牙解半千。\n一千修柁贯三米，三日盘缠无一钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1350,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其三","author":"方回","text":"家住斜塘大户边，时荒米贵欠他钱。\n从此驾船归不得，无钱且驾小航船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1351,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其二","author":"方回","text":"莫笑船家生事微，新红米饭绿蓑衣。\n一声欸和一声乃，谁识人间有是非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1352,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听航船歌十首 其一","author":"方回","text":"北来南去雁还飞，四十年间万事非。\n惟有航船歌不改，夜深老泪欲沾衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1353,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其九","author":"方回","text":"向来人唤老梢工，解使帆樯八面风。\n今日钓鱼亦无力，劣能听雨卧船篷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1354,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其一","author":"方回","text":"岸人胆落傍船看，鼍吐鲸吞一叶寒。\n鬼伯神官莫狂荡，灵台无愧自平安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1355,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其二","author":"方回","text":"南北东西四面看，舸轩虽窄自心宽。\n永无金马门边梦，岂有黄牛峡里滩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1356,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其六","author":"方回","text":"心许天知不愧天，酣风醉月仰天眠。\n自疑略似知章马，人道还如太乙莲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1357,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其八","author":"方回","text":"人间踏地有风波，归老山林莫问他。\n身是我船心是柁，早寻岸泊奈侬何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1358,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其三","author":"方回","text":"春浓面面透花香，秋皎团团转月光。\n窗户总空天是壁，如吾肺腑没遮藏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1359,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其七","author":"方回","text":"不须有客问张凭，且要无人觅庾冰。\n好是夜寒风浪静，月明空载一孤僧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1360,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其五","author":"方回","text":"傍石横陈八柱亭，一篷撱矮似船形。\n松声浪作风涛吼，何处风涛不惯经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1361,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孚舟亭新成赋十绝 其四","author":"方回","text":"六爻虚实相为用，二位高卑各有宜。\n顺抚说随心不爽，风漂罗刹有还时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1362,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寿昌郑生入天目山礼僧","author":"方回","text":"欲作空门补处人，如何头上裹头巾。\n曹溪一夜传衣钵，元是当年行者身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1363,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张棕仲实见惠江阴丘本","author":"方回","text":"绝喜他乡见似人，颇如画手善传神。\n忽思今昔无穷事，十五回经癸丑春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1364,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李仲宾墨竹四首 其四","author":"方回","text":"渭川千亩入毫端，子美临风野色寒。\n不是画师即诗客，可能收拾与人看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1365,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李仲宾墨竹四首 其三","author":"方回","text":"心空节劲翠筠浓，冷笑凡花诲冶容。\n可是人间秋水碧，东方七宿应苍龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1366,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李仲宾墨竹四首 其二","author":"方回","text":"春生夏长出墙头，含箨新梢玉版抽。\n宜雪宜霜无不可，如椽且与貌宜秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1367,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李仲宾墨竹四首 其一","author":"方回","text":"乾坤各各变三爻，坎兑相依似泰交。\n认得易中甘节卦，箨龙贞干写烟梢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1368,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李花","author":"方回","text":"仙根判耦得无差，春对夭桃夏对瓜。\n此岂轻浮閒果子，白花亦复胜红花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1369,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"村女","author":"方回","text":"青荷叶伞茜裙红，随母归宁省外翁。\n莫笑梳装未京样，兵馀犹见太平风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1370,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"村路有呼予老朝奉者","author":"方回","text":"真公真相自难诬，非相非公亦好谀。\n谁忽谓予老朝奉，心知不是赝称呼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1371,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杨花","author":"方回","text":"燕忙莺懒听芳词，忆醉西湖画舫时。\n山墅不知春早晚，隔墙数点堕书帷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1372,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"泛浙江二首 其二","author":"方回","text":"海门山到富春山，碍石冲沙水几湾。\n不是此江故盘屈，雪涛何得诧吴蛮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1373,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"泛浙江二首 其一","author":"方回","text":"不为潮从海上生，元来水浅浪波平。\n屈曲盘旋船百转，始知从古浙江名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1374,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"纸窗","author":"方回","text":"梅水仙花插古铜，纸窗通日不通风。\n天香何假龙涎爇，地暖无劳兽炭烘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1375,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"辛丑九日五首 其五","author":"方回","text":"往岁金台屡据鞍，居庸雁字仰天看。\n中秋蟹断□花绝，红叶西山九日寒。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1376,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"辛丑九日五首 其四","author":"方回","text":"何事清秋已衣绵，微寒最怯倚楼天。\n江南今岁黄花早，醉嚼重阳半月前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1377,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"辛丑九日五首 其三","author":"方回","text":"五度秋光过古希，节名良是叹人非。\n吾州大火前辛丑，问政山头伐木归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1378,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"辛丑九日五首 其二","author":"方回","text":"世间何事不空无，万古年年九日徂。\n最忆吾家先叔父，塘头一树紫茱萸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1379,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]