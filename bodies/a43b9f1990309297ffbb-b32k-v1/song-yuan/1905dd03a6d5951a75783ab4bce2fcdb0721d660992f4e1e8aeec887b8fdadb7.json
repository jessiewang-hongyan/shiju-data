[{"title":"二十八日残雪不消怀旧","author":"方回","text":"老眼今犹见雪明，几番绝景慰生平。\n三高祠畔吴江棹，百战军前鄂汉城。\n颠沛艰难垂欲死，登临慷慨谩多情。\n骆驼乳紫青貂暖，老矣无由再玉京。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1728,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二十三日天气绝佳西军还二十四日东如绩溪","author":"方回","text":"独坐绿阴下，追思秋日春。\n眠蚕方放大，早麦欲尝新。\n岂意贼生贼，忍闻人食人。\n何时兵遂解，纵遣上城民。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1729,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十一日晓发龙山风顺","author":"方回","text":"繁华销歇市朝空，此地何堪著固穷。\n久似坎蛙居井底，忽如野鹤出笼中。\n宿酲夜解催花雨，归棹春乘上水风。\n及得清明到家否，新芽茶绿牡丹红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1730,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十七日偕宾旸市饮二首 其二","author":"方回","text":"无官岂畏犯金科，饮量真能海纳河。\n人老自于春色淡，花开最恨雨声多。\n向来伴侣今都尽，乃后光阴复几何。\n更挈残樽趋曲巷，小姬摘阮和燕歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1731,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十七日偕宾旸市饮二首 其一","author":"方回","text":"误著儒冠玷甲科，休官重到旧沙河。\n未妨缓步微行好，犹恐傍观窃议多。\n我辈相逢唯酒可，桃花如许奈春何。\n雪儿人物今难得，一曲离骚醉自歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1732,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十五晚吴江二亲携酒","author":"方回","text":"今日山城好事新，客来誇说齿生津。\n喜晴郊外多游女，归暮溪边尽醉人。\n鲜笋紫泥开玉版，嘉鱼碧柳贯金鳞。\n一壶就请衰翁饮，亦与花朝报答春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1733,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十六日夜独酌思归四首 其四","author":"方回","text":"楼前春水欲生蛙，楼上无眠夜忆家。\n官道靴鸣知有雨，故溪船去好移花。\n耆年极荷神祇借，直性难禁世俗哗。\n便可真归不须梦，烂烹新笋煮新茶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1734,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十六日夜独酌思归四首 其三","author":"方回","text":"不谢车尘觅饷偎，前行后指亦危哉。\n一贫牵绊似绳缚，百怪攻攒如箭来。\n自倚此中惟拙直，未知何故每惊猜。\n是尧非桀俱尘土，且可深杯更浅杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1735,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十六日夜独酌思归四首 其二","author":"方回","text":"聊复埋身面糵昏，倘来倘去肯销魂。\n瓦犹幸有三间屋，绢可全无二丈裈。\n壮士笑谈跻将相，寒儒衰老误儿孙。\n社公雨作春灯暗，独尽花前酒一樽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1736,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月十六日夜独酌思归四首 其一","author":"方回","text":"閒忆山中一片云，归欤莫待草风薰。\n老身岂可为形役，俗语何堪著耳闻。\n乍醉乍醒终郁郁，孰非孰是几纷纷。\n颠寒踣饿男儿事，已办渊明自祭文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1737,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二月三十日","author":"方回","text":"酒病专欺老，诗材苦欠新。\n客窗庐阜雨，故圃洛花春。\n岁运江声急，家人夜梦频。\n遥知扫松处，笋茗正芳辛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1738,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"入五月病二七日","author":"方回","text":"病已捐蒲酒，寒犹拥絮衣。\n形骸元自劣，气候每相违。\n人死朝朝有，吾衰事事非。\n尪羸存喘息，聊复信天机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1739,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十日天晓","author":"方回","text":"清晓潮初过，西风猎弊裘。\n肯为贫士地，偏觉老人愁。\n蟋蟀声弥急，梧桐色渐愁。\n残星馀几点，吾独倚吾楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1740,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十日赵西湖携酒夜醒二更记事 其一","author":"方回","text":"社袄初穿暑气收，今朝五日过中秋。\n隔湖我每思□□，□市公能顾小楼。\n斗酒只鸡承厚意，扁舟匹马约閒游。\n吾侪不与人间事，肯挂眉头一点愁。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1741,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十日赵西湖携酒夜醒二更记事 其二","author":"方回","text":"酒醒更深独倚楼，天清地静俯河流。\n梧桐影转三更月，蟋蟀声催万象秋。\n自古有生皆有死，即今无喜亦无忧。\n更著四年当八十，我于人世复何求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1742,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十四日宾旸华父同登秀亭二首 其二","author":"方回","text":"两公诗思欲飞扬，颇似繁台俯大梁。\n潇洒道装衣袖阔，昂藏寿相耳毫长。\n持身未惯全随俗，玩世何嫌略放狂。\n我有平生八叉手，兴来举酒尚洋洋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1743,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十四日宾旸华父同登秀亭二首 其一","author":"方回","text":"垂垂三径晚香开，二妙端能为我来。\n老瓦尚堪沽浊酒，破鞋何惜上高台。\n十年心事霜髯短，万□秋声画角哀。\n海内诗人有公等，悬崖待与斸苍苔。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1744,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十二夜对月","author":"方回","text":"胡床正面紫阳山，净扫晴阶掩夜关。\n金气渐寒风露下，冰轮欲满斗牛间。\n衰怀突兀来千感，暮齿逍遥保一閒。\n天役万形仍自役，何为西堕又东还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1745,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十八日天晓二首 其二","author":"方回","text":"河中船已动，岸亦有人行。\n城北钟声断，楼东鬼宿明。\n倚□□酒醒，搔首小诗成。\n□□中秋热，今朝始渐清。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1746,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十八日天晓二首 其一","author":"方回","text":"木犀花正盛，吹入满楼香。\n不是人无寐，焉知夜已长。\n树鸣秋雨急，潮过海天凉。\n自觉衣裘少，侵寻近肃霜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1747,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十五夜对月","author":"方回","text":"散发披襟一再窥，未甘兀兀守书痴。\n月圆照尽天圆处，秋半凉当夜半时。\n人世无灯方作梦，山翁有酒更能诗。\n此心除却嫦娥外，惟许崚嶒瘦影知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1748,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月三十日晓晴","author":"方回","text":"高树号风始欲丹，秋晴诗老试凭栏。\n食贫破砚惊犹在，身瘦寒衣觉渐宽。\n家里儿孙音问好，客中僮仆使令难。\n雪前霜后归吾圃，瘦菊疏梅尽耐看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1749,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月五日病中","author":"方回","text":"于心敢自欺，但恐不精思。\n未觉扶颠易，方惊悔过迟。\n病堪长作客，贫可荐招医。\n观井如彭祖，闻诸丱角时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1750,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月初一日","author":"方回","text":"吾生遽如此，六十一衰翁。\n功过差相掩，时几大不同。\n冥冥终日雨，忽忽半秋风。\n食尽囊无物，今年始是穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1751,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月初一日","author":"方回","text":"秋风几日尚无诗，政坐炎歊转赫曦。\n閒被贫为魔搅挠，病须凉当药医治。\n薄田董穫收新粟，老圃开包献巨梨。\n顾此亦差胜穷宦，回头何啻十年迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1752,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月初二日","author":"方回","text":"蝉声渐渐怯西风，閒撚青枝玩菊丛。\n老去一身都是病，寤来万梦总成空。\n喜分果饵小儿女，浪费薪蔬顽仆僮。\n严濑家人报船至，更营樽酒恼衰翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1753,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月朔后雨昼夜不止","author":"方回","text":"□蔑丝毫暑，何庸一再霖。\n秋阴酸病骨，夜滴碎归心。\n剧盗应旁睨，馀田或尽沉。\n无灯黑如漆，臆度近更深。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1754,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"力学","author":"方回","text":"力学衰犹进，治生晚不雠。\n操心元自定，忤俗果何由。\n涂抹馀千纸，浮沉等一沤。\n忍穷兼耐辱，失笑未包羞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1755,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月二十九日壬子喜雪","author":"方回","text":"撚冰惊起冻髯翁，一色楼台晓未融。\n酤肆定应昂酒价，篙工是处打船篷。\n读书窗上纸偏白，跃马街头尘不红。\n忧国愿丰心绝喜，可能儿女絮因风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1756,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月二十日南至二首 其二","author":"方回","text":"至节今年始得归，祀先牲酒亦无几。\n儿孙长大衣装少，婢仆顽慵廪饩微。\n交阯虞翻犹不死，荆州王粲竟何依。\n玉筒已想黄钟动，只有心灰自懒飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1757,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月二十日南至二首 其一","author":"方回","text":"风吹六十二年春，又见阳和一夜新。\n兴废亲更三国事，死生暗易万城人。\n种花纵好谁同赏，置酒良难自惯贫。\n今独身为本宗长，思兄临节倍悲辛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1758,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月十五日","author":"方回","text":"倏忽何庸诘，参差未易齐。\n树枯元不死，雪尽竟为泥。\n岂谓身才老，从来意欲西。\n一穷宁骨立，九殒未头低。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1759,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月十五夜","author":"方回","text":"竟与鳏鱼似，无由浊蚁持。\n百为元有命，一往复何疑。\n残梦终难续，深忧暗自知。\n邻雏夜啼急，吾亦忆吾儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1760,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月十四夜听雨为霰听霰为雪久之雪后为骤雨自昏达旦无寐","author":"方回","text":"雨声更霰雪，昏听达清晨。\n自笑能吟客，常为不寐人。\n絮寒勤拭涕，箦响惧翻身。\n苦语知谁会，应堪泣鬼神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1761,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月初八日观雨","author":"方回","text":"重阳晴过小春天，忽复萧骚雨可怜。\n响入竹林全似雪，湿蒸茅舍最宜烟。\n战尘洗净无传箭，客路泥深亦著鞭。\n三月聚粮岂容易，临风殊觉意茫然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1762,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十七十八日犹雨","author":"方回","text":"浮云几万里，白日闷晴晖。\n稍觉波涛缩，犹闻点滴微。\n两旬捐破扇，五月著寒衣。\n老病忧时事，高门马自肥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1763,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十九日甲戌晴己卯晚又雨二首 其二","author":"方回","text":"吴郡传犹庶，严滩报可惊。\n田中车水出，城上驾船行。\n旅屋仍筛漏，穷檐用盎盛。\n幸而有雷电，此雨不难晴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1764,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十九日甲戌晴己卯晚又雨二首 其一","author":"方回","text":"稍复桥痕旧，俄惊础汗非。\n岂宜真汹涌，止可略霏溦。\n河伯毋流毒，云师幸霁威。\n劣能驱暑气，即愿吐晴晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1765,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十九日始晴","author":"方回","text":"今日檐仍滴，何人胆不寒。\n晒帆船尚湿，扫市路才乾。\n造化玄机转，生灵死命完。\n传闻睦东馆，楼阁付惊湍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1766,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十九日斩贼十二人始明正典刑","author":"方回","text":"兵兴欲两旬，三载气初伸。\n汝既甘从贼，官非乐杀人。\n早知膏白刃，何忍效黄巾。\n拙速无奇策，登城悉市民。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1767,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十二月十三日三桥小雪","author":"方回","text":"晓楼衾薄梦回频，辟户寒光绝点尘。\n各各一篷船未动，差差万瓦屋如新。\n高门定有丰醪饩，下里畴能馈粲薪。\n邻叟踏泥共煎茗，早云多有望晴人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1768,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十二月十五日去年以此日归","author":"方回","text":"日月相望夕，西归昔问途。\n焉知穷岁迫，重寓客楼孤。\n压雪弥河舫，胶冰噤树乌。\n遥怜万山里，儿女乏寒襦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1769,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十二月十五日晚宿馀杭步","author":"方回","text":"孰令牵率到钱塘，朝暮随人作酒狂。\n蜕壳喜离城市路，发蒙惊见水云乡。\n四方上下乾坤阔，万里东西日月望。\n向来楼居不得句，此夕叶舟吟兴长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1770,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十六日","author":"方回","text":"来往江复浙，扰扰一年间。\n有子犹相隔，无官亦未閒。\n病嫌真药少，债准旧书还。\n霁雪楼前立，依依忆故山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1771,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十六日水退雨不已次受益韵二首 其二","author":"方回","text":"七年逢四潦，苟活到于今。\n每值月离毕，难逢木守心。\n江兼湖共满，忧与恨俱深。\n万顷青秧没，田家泪湿襟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1772,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十六日水退雨不已次受益韵二首 其一","author":"方回","text":"暑雨民咨怨，由来直匪今。\n湿能蒸病骨，滴欲碎归心。\n积水连村郭，前途昧浅深。\n雄风楚台上，谁且独披襟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1773,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十月三日秀亭二首 其二","author":"方回","text":"乱峰古垒一荒台，自笑衰翁去复来。\n石怪更宜添薜荔，树枯犹许寄莓苔。\n四天无壁供诗眼，万古皆空付酒杯。\n惆怅远惭羊叔子，秋阴欲暮角声哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1774,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十月三日秀亭二首 其一","author":"方回","text":"天怜迟莫与清閒，閒上高山看远山。\n世味已如玄酒淡，名场肯复左轮殷。\n千争万竞尘埃里，古恨今愁莽苍间。\n□□谁来问诗叟，应输老树识苍颜。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1775,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十月六日小酌以自宝此身方有寿分韵得身字","author":"方回","text":"一从鼙鼓沸烟尘，十士相逢八九贫。\n梦境谁能为达者，醉乡犹幸属閒人。\n剩留佳句传来世，谨护风寒养病身。\n归去吾家有何物，岂无江水濯缁巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1776,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又用前韵赋夜坐","author":"方回","text":"酒醒招得醉魂归，深护炉熏键夕扉。\n渴舌恶甜勤漱茗，癯肩耐冻懒添衣。\n颇闻空暗无星出，小待更深定雪飞。\n一字不圆终不寐，癖诗如我自应稀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1777,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又次韵张御史鹏飞","author":"方回","text":"休致衰年暗自惊，閒呼张丈唤殷兄。\n马尘往往逢新贵，鸥梦依依忆旧盟。\n洛社绘图惭九老，汉庭绵蕝付诸生。\n绣衣御史烦推毂，我有蓑衣永不更。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1778,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又雨","author":"方回","text":"霞红疑太早，果不是晴天。\n市涨危侵户，村流喜入田。\n昏昏邻寺鼓，滃滃晚厨烟。\n明日应犹雨，宵甜一枕眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1779,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"万山堂呈史察使 其二","author":"方回","text":"质肃英声盖九州，名孙吾获与之游。\n胸中所学万青简，堂上有亲双黑头。\n买砚新添行橐重，抄书勤过野庐幽。\n雕鞍长剑纷纷是，人物如斯岂易求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1780,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"万山堂饮归","author":"方回","text":"追怀往者数贤侯，得得经营续续脩。\n依旧夜栏低北斗，几番春絮委东流。\n同游尽道山能好，半醉谁知我独愁。\n乃后吾徒身亦死，题诗更有昔人不。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1781,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三十年吟","author":"方回","text":"三十年为世，吾今迫六旬。\n儿时前辈尽，乱后善人贫。\n未测前途闇，空追往迹陈。\n所亲化埃土，犹入梦魂频。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1782,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月二十九日饮杭州路耿同知花园","author":"方回","text":"巢燕春泥久已融，虞弦节近鼓薰风。\n枝枝烂熟樱桃紫，朵朵争妍芍药红。\n冠豸霁威贤御史，雕虫得隽老诗翁。\n十分蚕麦今年稔，我辈何妨酒一中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1783,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月八日百五节林敬舆携酒约盛元仁戴帅初方万里访赵仲实宣慰于西湖第五桥之曲港南山书院五首 其五","author":"方回","text":"后生谁识旧西湖，除却山僧树总无。\n何至梅仙坟亦掘，惟应葛岭鬼当诛。\n红裙鞭镫追游女，白首端章笑腐儒。\n两盏三杯更多感，不如烂醉眼模糊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1784,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月八日百五节林敬舆携酒约盛元仁戴帅初方万里访赵仲实宣慰于西湖第五桥之曲港南山书院五首 其四","author":"方回","text":"生长西湖死葬湖，兴言舟子与农夫。\n全家衣食凭摇橹，历世儿孙学荷锄。\n布衲劣兼蓑笠有，齑汤恐并酱醯无。\n金盘玉箸环歌舞，午鬨昏空一任渠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1785,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月八日百五节林敬舆携酒约盛元仁戴帅初方万里访赵仲实宣慰于西湖第五桥之曲港南山书院五首 其三","author":"方回","text":"暮年无不与心违，节物过从事总非。\n何处青梅尝煮酒，谁家红药试单衣。\n半酣便合拿舟去，骤热犹容借扇归。\n忽忆向来独立处，雪天閒看白鸥飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1786,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月八日百五节林敬舆携酒约盛元仁戴帅初方万里访赵仲实宣慰于西湖第五桥之曲港南山书院五首 其二","author":"方回","text":"湖山春色已如斯，城市原来了不知。\n百五韶华全似画，二三名胜总能诗。\n忽惊我辈相携处，谁识吾人始到时。\n五十四年前弱冠，设盆犹忆唱闽词。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1787,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]