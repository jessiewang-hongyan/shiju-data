[{"title":"唐律寄呈父凤山提举 其五","author":"汪元量","text":"昔年去国大苍黄，同舍诸生半死亡。\n春别浙江花似雾，秋行碛地草如霜。\n时沽市酒借馀景，屡宿官邮悲故乡。\n满目故人皆厚禄，吾侪添得两奚囊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5763,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐律寄呈父凤山提举 其四","author":"汪元量","text":"锦帆浩荡湿龙鸾，乐指三千粉泪寒。\n万里远行看日近，一人不杀见天宽。\n玉关屡沐军罗拜，金殿时蒙上问安。\n宴罢御香携满袖，醉归环佩月中看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5764,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐律寄呈父凤山提举 其三","author":"汪元量","text":"燕山只在乱云边，过了黄河便豁然。\n鼠帽蒙头车上坐，貂裘拥鼻草间眠。\n秋砧捣落千营月，晓寨炊残万灶烟。\n说与奚奴休笑我，诗人要看好山川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5765,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐律寄呈父凤山提举 其二","author":"汪元量","text":"黄帽催人急放舟，荻花枫叶共飕飕。\n天公作恶云翻手，河伯为妖风打头。\n接翅野鸦围古堞，断行孤雁落中州。\n吴山只隔淮山路，江北江南处处愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5766,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐律寄呈父凤山提举 其一","author":"汪元量","text":"西兴渡口乱啼鸦，锦缆牵江目力赊。\n六馆衣冠沦道路，三宫珠玉走风砂。\n山川不尽心难老，岁月忧煎发渐华。\n行到湘南归不得，倚门应是望天涯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5767,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"徐州","author":"汪元量","text":"白杨猎猎起悲风，满目黄埃涨太空。\n野壁山墙彭祖宅，塺花粪草项王宫。\n古今尽付三杯外，豪杰同归一梦中。\n更上城楼见城郭，乱鸦古木夕阳红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5768,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓行","author":"汪元量","text":"痴坐书窗待晓钟，背灯无语意无穷。\n一家骨肉正愁绝，四海弟兄如梦同。\n西舍东邻今日别，北鱼南雁几时通。\n行行忍见御沟水，流出满江花片红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5769,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"柴秋堂越上寄诗就韵柬奚秋崖","author":"汪元量","text":"越王台上我同游，越女楼中君独留。\n燕子日长宜把酒，鲤鱼风起莫行舟。\n江山有待伟人出，天地不仁前辈休。\n何处如今觅巢许，欲将心事与渠谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5770,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"泰山","author":"汪元量","text":"敕使联镳上翠岑，飞泉跃涧吼雷音。\n凌高一览知天远，迂曲千蹊觉洞深。\n龙蛰沧溟蛟舞壑，枭横碧落凤归林。\n山灵护得神祠在，苔蚀秦碑古树阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5771,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"浙江亭别客","author":"汪元量","text":"诸公来此欲凭阑，秃树粘云湿不乾。\n小燕正嫌三月雨，老莺又受一春寒。\n楼头呼酒尽情饮，江上遇花随意看。\n莫怨人生有离别，人生到此别离难。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5772,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"浙江亭和徐雪江","author":"汪元量","text":"朱甍突兀倚云寒，潮打孤城寂寞还。\n荒草断烟新驿路，夕阳古木旧江山。\n英雄聚散阑干外，今古兴亡欸乃间。\n一曲尊前空击剑，西风白发泪斑斑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5773,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"真定官舍","author":"汪元量","text":"使君数问夜如何，灯烛高张照绮罗。\n白酒千杯浇客醉，红妆一面恼人多。\n风烟漠漠庭前树，霜月娟娟沼内荷。\n驿吏出门相语及，城南便是滹沱河。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5774,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秦岭","author":"汪元量","text":"峻岭登临最上层，飞埃漠漠草棱棱。\n百年世路多翻覆，千古河山几废兴。\n红树青烟秦祖陇，黄茅白苇汉家陵。\n因思马上昌黎伯，回首云横泪湿膺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5775,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读李鹤田钱塘百咏","author":"汪元量","text":"南浦亭边话别时，扁舟东下浙江湄。\n遍将越国千年事，吟作钱塘百咏诗。\n无火可能烧莽卓，有刀恨不斩高斯。\n五陵佳气飞扬尽，泪洒西风两鬓丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5776,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾魏公出师","author":"汪元量","text":"奏罢出师表，翻然辞庙堂。\n千艘空宝玉，万马下钱塘。\n□许命真主，欺孤欲假王。\n可能清海岱，宗社再昌唐。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5777,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"钱塘","author":"汪元量","text":"踯躅吞声泪暗倾，杖藜徐步浙江行。\n青芜古路人烟绝，绿树新墟鬼火明。\n事去玉环沈异域，愁来金盌出佳城。\n十年草木都糜烂，留得南枝照浅清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5778,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"商山庙","author":"汪元量","text":"蹇柏枯松枕庙门，独瞻遗像酹清尊。\n紫芝奕奕浮香气，碧草纤纤没烧痕。\n羽翼已成犹有说，腹心相视更何言。\n高歌一曲归来隐，静看山禽哺子孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5779,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄李鹤田","author":"汪元量","text":"文江别后又三年，别后三年诗几篇。\n老去莫思身外事，命穷甘作饮中仙。\n天阴雨湿龙归海，云淡风轻鹤在田。\n回首西湖湖上路，新蒲细柳为谁妍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5780,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"常州","author":"汪元量","text":"渡头风起柳摇丝，丁卯桥边屋已稀。\n河草青青淮马健，江花冉冉海鸥肥。\n一樽酒对三人饮，八字帆分两岸飞。\n天末有人难问讯，仲连东去不须归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5781,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涪州","author":"汪元量","text":"晓立验樯乌，时闻鸟兽呼。\n斯须风力健，遮莫水程迂。\n赤岸石稠叠，白盐山独孤。\n眼前犹有险，不尽更危途。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5782,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"淮安水驿","author":"汪元量","text":"薄暮舟维杨柳堤，手攀杨柳立多时。\n汉儿快意歌荷叶，越女含愁舞柘枝。\n月湿江花和露泫，潮摇淮树带风悲。\n长亭一夜浑无寐，与客传杯更和诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5783,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隆州","author":"汪元量","text":"歇马隆州借夕凉，壶中薄酒似酸汤。\n城濠寨屋偏栽柳，市井人家却种桑。\n官逼税粮多作孽，民穷田土尽抛荒。\n年来士子多差役，隶籍盐场与锦坊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5784,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄金台和吴实堂韵","author":"汪元量","text":"把酒上金台，伤心泪落杯。\n君臣难再得，天地不重来。\n古木巢苍鹘，残碑枕碧苔。\n倚阑休北望，万里起黄埃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5785,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"彭州","author":"汪元量","text":"我到彭州酒一觞，遗儒相与话凄凉。\n渡江九庙归尘土，出塞三宫坐雪霜。\n岐路茫茫空望眼，兴亡滚滚入愁肠。\n此行历尽艰难处，明日繁华是锦乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5786,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"御宴蓬莱岛","author":"汪元量","text":"晓入重闱对冕旒，内家开宴拥歌讴。\n驼峰屡割分金盌，马奶时倾泛玉瓯。\n禁苑风生亭北角，寝园日转殿西头。\n山前山后花如锦，一朵红云侍辇游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5787,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"惠山值雨","author":"汪元量","text":"惠山寺里北人过，古柏茎茎伐尽柯。\n三世佛身犹破相，一泓泉水亦生波。\n山林虽乐元非乐，尘世多魔未是魔。\n举似于人何以故，坐檐閒看雨霶?。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5788,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"曾平山招饮","author":"汪元量","text":"老貌不随俗，固穷而隐居。\n一坞百竿竹，八窗千卷书。\n酌以旋篘酒，荐之新网鱼。\n兴尽出门去，晚凉山雨馀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5789,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖山堂","author":"汪元量","text":"高堂寂寞半开门，草没颓墙竹满园。\n雨过湖天笼白昼，云归山市锁黄昏。\n忘机今古鸥来往，说梦兴亡燕语言。\n行尽六桥吟更好，万松岭上一声猿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5790,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"登蓟门用家则堂韵","author":"汪元量","text":"蓟门高处小凝眸，雨后林峦翠欲流。\n车笠自来还自去，笳箫如怨复如愁。\n珍珠络臂誇燕舞，纱帽蒙头笑楚囚。\n忽忆旧家行乐地，春风花柳十三楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5791,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答林石田见","author":"汪元量","text":"偶携降帜立诗坛，剪烛西窗共笑欢。\n落魄苏秦今席煖，猖狂阮籍尚毡寒。\n山中客老干茎白，海上人归一寸丹。\n世事本来愁不得，乾坤只好醉时看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5792,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答徐雪江","author":"汪元量","text":"十载高居白玉堂，陈情一表乞还乡。\n孤云落日渡辽水，匹马西风上太行。\n行橐尚留官里俸，赐衣犹带御前香。\n只今对客难为答，千古中原话柄长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5793,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鲁港","author":"汪元量","text":"博徒无计解其纷，夜半鸣钲溃万军。\n鲁港朔风掀恶浪，吴山寒日翳愁云。\n周褒媚己终亡国，孟德欺孤忍负君。\n大木已颠天柱折，钱塘江上雁成群。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5794,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鲁港败北","author":"汪元量","text":"夜半槌金鼓，南边事已休。\n三军坑鲁港，一舸走扬州。\n星殒天应泣，江喧地欲流。\n欺孤生异志，回首愧巢由。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5795,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感慈元殿事","author":"汪元量","text":"翠华扶辇出彤庭，蜜炬星繁天未明。\n鹓鹭分行江上别，熊罴从驾雨中行。\n绿波淼淼浮三殿，紫禁沈沈断六更。\n惟有周遭山似洛，不堪回首泪纵横。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5796,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"筠溪王奉御寄诗次韵呈崖松卢奉御","author":"汪元量","text":"新诗蒙远寄，客路不胜秋。\n同谷歌臣甫，新丰醉客周。\n君今嫌作吏，我已厌封侯。\n何日西湖曲，红船上下游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5797,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蓝田","author":"汪元量","text":"寒更客起卷花毡，又勒青骢过玉田。\n一匊归心千涧外，十分秋思两峰前。\n蓝关月冷猿啼木，秦岭风高雁贴天。\n北望茂陵应咫尺，髑髅沙白草芊芊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5798,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬方塘赵待制见赠","author":"汪元量","text":"久谓儒冠误，穷愁方弃书。\n十年心不展，万里意何如。\n司马归无屋，冯驩出有车。\n吾曹犹未化，烂醉且穹庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5799,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦江蜀先主庙","author":"汪元量","text":"国破人何在，宫名喜尚存。\n虽云蜀先主，犹是汉诸孙。\n吴魏不相下，关张岂少恩。\n崩年在三峡，遗恨满乾坤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5800,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"歌风台","author":"汪元量","text":"百尺荒台禾黍悲，沈思往事似轮飞。\n洛中车驾秦皇去，沛上风云汉帝归。\n鹰入塞榆冲雁阵，鹘穿城树破鸦围。\n东徐多少英雄恨，留与行人歌是非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5801,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"歌妓许冬冬携酒郊外小集","author":"汪元量","text":"益州歌妓许冬冬，客里相逢似燕鸿。\n醉拥蜀琴抽白雪，舞回班扇割西风。\n山炰野馔荒山里，浪蕊浮花古寺中。\n偶尔留连借馀景，出门一笑夕阳红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5802,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"歌楼感事","author":"汪元量","text":"昔年同辇载花仙，此日登楼籍妓员。\n恩赐舞衣香未歇，御书歌扇墨犹鲜。\n碧云翼翼金钗滑，红雪翩翩玉佩圆。\n却把向来供奉曲，酒边对客续朱弦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5803,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潼关","author":"汪元量","text":"蔽日乌云拨不开，昏昏勒马度关来。\n绿芜径路人千里，黄叶邮亭酒一杯。\n事去空垂悲国泪，愁来莫上望乡台。\n桃林塞外秋风起，大漠天寒鬼哭哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5804,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潼州府","author":"汪元量","text":"潼江待我洗吟眸，如此江山是胜游。\n红袖斗歌才拍手，绿鬟对舞尽缠头。\n箜篌急撚风生座，鼙鼓连挝月上楼。\n一夜不眠鸡戒晓，又骑铺马过绵州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5805,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"燕山九日","author":"汪元量","text":"九日凄凉戏马台，龙山高会亦尘埃。\n天翻地覆英雄尽，暑往寒来岁月催。\n人隔关河归未得，客逢时节转堪哀。\n十年旧梦风吹过，忍对黄花把酒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5806,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"燕山送黄千户之旴江","author":"汪元量","text":"万里关河道路迂，出门一笑意何如。\n来时雨雪侵驼褐，归日风云蔼驷车。\n玉座喜闻黄石策，金台荣拜紫泥书。\n野人无以效芹献，一斗酒边双鲤鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5807,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"瀛国公入西域为僧号木波讲师","author":"汪元量","text":"木老西天去，袈裟说梵文。\n生前从此别，去后不相闻。\n忍听北方雁，愁看西域云。\n永怀心未已，梁月白纷纷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5808,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夔门驿","author":"汪元量","text":"宿酲未解据胡床，亭午披衣望麝香。\n三峡夜来天似水，百蛮秋后月如霜。\n洲前橘柚垂垂实，石上藤萝细细长。\n又欲拿舟过滟滪，黄牛白狗接高唐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5809,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"凤州","author":"汪元量","text":"凤州山馆有清辉，古木扶疏散陆离。\n红尾锦鸡鸣古埭，绿头花鸭荡幽池。\n荷声策策秋来后，桂影团团月上时。\n病马啮荄思故枥，惊乌绕树宿何枝。\n三分割据人如梦，满目兴亡客自痴。\n走笔成诗聊纪实，岷峨风土出蹲鸱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5810,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重访草堂","author":"汪元量","text":"放棹花溪去，重来访草堂。\n菰蒲依静渚，杨柳绕回塘。\n野堑棨高下，山墙竹短长。\n槁梧含古色，瘦菊减清香。\n鼙鼓檛三叠，旌旗列两行。\n花娘纷舞袖，座客竞飞觞。\n酱蘸生葱白，齑浇熟韭黄。\n洪炉催捲饼，匕首割烧羊。\n大笑诸公醉，高谈小子狂。\n城关犹未掩，冠盖已飞扬。\n鸟语青松里，人行锦树傍。\n杜陵轻出峡，千古隔潇湘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5811,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬隐者刘桃冈","author":"汪元量","text":"食既弹长铗，囊悬少错刀。\n功名须汝辈，诗酒且吾曹。\n强项贫而乐，扬眉气自豪。\n北来鱼字密，南去雁书高。\n拟折渊明柳，重寻梦得桃。\n明珠忽委赠，价重九方皋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5812,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七月初七夜渡黄河","author":"汪元量","text":"长河界破东南天，怒涛日夜如奔川。\n此行适逢七月夕，妖氛散作空中烟。\n牛郎织女涉清浅，支机石上今何年。\n扬帆一纵万里目，身世恍若槎中仙。\n仰看银河忽倒泻，月明风露何娟娟。\n狂来拔剑斫河水，欲与祖逖争雄鞭。\n扣舷把酒酹河伯，低头细看河清涟。\n平生此怀具已久，到此欲说空回旋。\n嗟予不晓神灵意，咫尺雷雨心茫然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5813,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"女道士王昭仪仙游词","author":"汪元量","text":"吴国生如梦，幽州死未寒。\n金闺诗卷在，玉案道书闲。\n苦雾蒙丹旐，酸风射素棺。\n人间无葬地，海上有仙山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5814,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"小桃源入三岩观鱼","author":"汪元量","text":"眉州城外小桃源，行入三岩涧水喧。\n人近碧潭才抚掌，唤鱼出洞跳龙门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5815,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山东飞放","author":"汪元量","text":"天子出猎山之东，臂鹰健卒豪且雄。\n我欲从之出云中，坐看万马如游龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5816,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"云安闻鹃","author":"汪元量","text":"云安风景愚能说，苍峡风掀浪如雪。\n杜鹃叫得口流血，染遍山花归不得。\n臣甫再拜哦新诗，诗成甫也成愁绝。\n都人重是古帝魂，敬重此鸟心不辍。\n不知此鸟知不知，四时叫得巴山裂。\n却忆群姬左右趋，三十六宫醉花月。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5817,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天山观雪王昭仪相邀割驼肉","author":"汪元量","text":"北征已十年，抑郁悲局促。\n拄杖看天山，雪光皎如玉。\n满目鹯鹰飞，晴天猎鸿鹄。\n羁人灶无炊，竟夕枵其腹。\n美人塞边来，邀我分豆粥。\n手持并铁刀，欣然割驼肉。\n勿诮草堂翁，一饱死亦足。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5818,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天坛山","author":"汪元量","text":"我登天坛山，洒然清吟目。\n群峰如儿孙，罗列三十六。\n支藤陟曾巅，中有少室屋。\n山人化飞仙，庭除生苜蓿。\n古碑野火烧，剥落字难读。\n雏鹿卧幽岩，孤鸟响空谷。\n解鞍小迟留，偷閒半日足。\n长啸归去来，题诗纪幽独。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5819,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太华峰","author":"汪元量","text":"华山山木乱纷纷，铁锁垂垂袅袅猿。\n石齿齿前光烁烁，壁岩岩后势奔奔。\n奇奇怪怪云根耸，郁郁葱葱雾气昏。\n上上上头仍上上，最高高处有乾坤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5820,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"巴陵","author":"汪元量","text":"重到巴陵秋正清，岳阳城下系孤舲。\n江湖万里水云阔，天地一凉河汉明。\n月出洞庭鱼婢舞，气蒸云梦雁奴腥。\n篙工又鼓潇湘柁，渔笛渔榔上下鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5821,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"开平","author":"汪元量","text":"冷霰撒行车，呻吟独搔首。\n须臾大如席，风卷半空走。\n母子鼻酸辛，依依自相守。\n书生倒行囊，沽来一樽酒。\n暂时借温和，耳热岂长久。\n万木舞阴风，言语冰在口。\n毡房耿无眠，兀兀听刁斗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5822,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忆湖上","author":"汪元量","text":"我忆西湖断桥路，雨色晴光自朝暮。\n燕去鸿来今几度，梅花万里水云隔。\n日夜思家归不得，偶然醉归文姬侧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5823,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]