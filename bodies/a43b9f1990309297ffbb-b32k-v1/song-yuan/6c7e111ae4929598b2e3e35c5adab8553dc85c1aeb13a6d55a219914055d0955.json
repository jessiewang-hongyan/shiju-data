[{"title":"探梅四绝 其二","author":"刘辰翁","text":"钧天远远月斜斜，归客迢遥未到家。\n一色白云天似雪，和衣和雪宿梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9503,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"探梅四绝 其三","author":"刘辰翁","text":"后五百年无放翁，狂歌醉舞与谁同。\n渔人入得桃花洞，犹有梅花路未通。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9504,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"探梅四绝 其四","author":"刘辰翁","text":"冷蕊何心识老逋，芳名从此落西湖。\n风霜未改幽坚操，弟立花前讳玉奴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9505,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题宣和双蟹图卷","author":"刘辰翁","text":"讲馀机暇谏书空，艮岳江湖入眼中。\n郭索能令天一笑，画图何必面春风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9506,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题虎丘","author":"陈普","text":"干将化龙飞上天，寒崖古木俱苍然。\n大星西殒化盘石，银河倒流通剑泉。\n山鬼夜啸或风雨，坡仙浩气凌云烟。\n行人慎勿歌团扇，谁识风流晋代贤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9507,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋风词","author":"甘泳","text":"昨夜西风来，人间雨如海。\n山摇摇，秋洒洒。\n早起□□轮，老红竟何在，惟有残云漠漠弄凉态。\n千林万叶，淅沥作声。\n岂无绿色，奈何凋零。\n四时更变化，宋玉胡为愁，直须痛饮千斛酒。\n亦不知有春，亦不知有秋，鸿濛适我汗漫游。\n绝怜九辨大萧索，争与虫声起篱落。\n东溪子，今夕呼月当中天，看我大醉西风前。\n便令秋满八千岁，我醉依然月下眠。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9508,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自述","author":"甘泳","text":"总角希闻道，残生乃付诗。\n未曾前辈识，敢辱近人知。\n飘泊身馀健，萧閒鬓欲衰。\n一帘书四壁，寒日在清池。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9509,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晚立黄洲","author":"甘泳","text":"今度阑干倚，苍茫入暮天。\n碧溪分市井，华屋乱云烟。\n钟隔春来树，灯流夜去船。\n惜哉题柱壮，琴动凤凰弦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9510,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陪完颜御史行金石台分韵得丞字","author":"甘泳","text":"胜景踰千载，吾人得共登。\n五峰交地势，一水合沙棱。\n荆国成何事，浮丘无异能。\n山头有田父，未必识中丞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9511,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"归来","author":"甘泳","text":"谓我犹羁旅，归与已的然。\n风霜高枕外，江海小诗边。\n达摩移华夏，庄周侮圣贤。\n向来知此事，未敢弃予年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9512,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过南湖","author":"甘泳","text":"忽有一事碍胸次，摆脱不去呼酒来。\n溟溟濛濛混沌在，坦坦荡荡虚空开。\n精神一生留笔墨，形骸昨夜为尊罍。\n年年看梅今白发，晴日江路行莓苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9513,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与危见心同和完颜御史沂联步踏月韵","author":"甘泳","text":"明月送人归，明月照人宿。\n月落梦醒时，清霜压寒屋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9514,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"小绝","author":"甘泳","text":"一夜睡不著，小窗天忽明。\n林塘寒鸟聚，听得最初声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9515,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐","author":"甘泳","text":"林风自潇潇，山雨时洒洒。\n丈夫七尺躯，地炉使吾矮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9516,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"早睡","author":"甘泳","text":"病来贪睡早，推月出山前。\n月色不相舍，小窗还自妍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9517,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酒醒","author":"甘泳","text":"酒醒桂花发，狂歌对花前。\n邻家大骂我，夜半惊人眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9518,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书生","author":"甘泳","text":"踉蹡趣讲席，读诵斗高声。\n我亦曾如此，而今白发生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9519,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"暂憩","author":"甘泳","text":"平生湖海游，南北东西路。\n几度梦残时，云深不知处。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9520,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"归舟二首 其一","author":"甘泳","text":"片帆悬空秋满腹，凉月淡淡天无波。\n平生湖海元龙意，早入西风渔棹歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9521,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"归舟二首 其二","author":"甘泳","text":"天壤岂无苏季子，恨我不识韩荆州。\n遥山苍苍暮云碧，何许一笛芦花秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9522,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"下豫州","author":"甘泳","text":"壮怀忍共白云閒，孤负僧房屋半间。\n卖却牢愁三万斛，载将明月入西山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9523,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"托意","author":"甘泳","text":"旧时灯火不知年，托意篇章末世传。\n胸次只今无此事，听风听雨过残年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9524,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"新春","author":"甘泳","text":"花红柳绿也逢时，润色青春有小时。\n人世苦无吾辈在，东风寥落亦堪悲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9525,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"看梅","author":"甘泳","text":"独坐匆匆不自适，出门偶见梅花开。\n自从开辟到今日，此是东风第几回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9526,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"渔父词七首 其七","author":"毛直方","text":"溪桥竹边有沽酒，携鱼换酒满胡芦。\n蓬头月上不觉醉，自卷芦叶吹呜呜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9527,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖上观春","author":"汤炳龙","text":"闭门五日雨，出门万山春。\n湖光忽见我，摇荡白雪新。\n九节瘦筇杖，一幅故葛巾。\n桃花忽相笑，聊复此红尘。\n有钱困鞭算，有官絷卯申。\n洞然宇宙间，馀此自在身。\n但恨不能饮，我亦无事人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9528,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题高尚书夜山图","author":"汤炳龙","text":"人知丽日江山奇，月中更奇人不知。\n古今画手不能画，高侯能画兼能诗。\n风流文采乃如此，笔意所到神莫窥。\n琉璃宇宙入万象，清寒周匝天四垂。\n群鸦已息漙露下，一雁不度行云迟。\n龙飞凤舞又千里，一起一伏相追随。\n潮来不见江吸海，但见夜壑寂寂舟无遗。\n废宫隐约认孤塔，长竿高下标丛祠。\n俯观下界万屋如鳞次，其间醉梦觉者谁。\n金城树老岁月往，昆明劫尽天地移。\n匆匆吴越已陈迹，丹青先写兴亡悲。\n虞山禹穴会稽路，苍苍凉凉隔烟雾。\n平生惯向图中游，老我卧游无胜具。\n昏花疑是雪欲晴，剡溪直在无山处。\n何人说与李将军，太清岂必微云□。\n毫端巽巽肯一扫，清光应更馀几分。\n天然人境两相值，楼头白也思不群。\n胸中云梦可八九，呼吸沆瀣归雄文。\n虎头著我坐岩壑，书窗半席一诣君。\n舟中不须觅谢尚，诗成三诵君尝闻。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9529,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"范文正公书伯夷颂并扎卷","author":"汤炳龙","text":"退之尝作《伯夷颂》，纲常更为文章重。\n小范老子翰墨香，吹醒首阳千古梦。\n尔来宇宙三百年，劫灰不坏宁非天。\n姑苏李侯贤太守，为将手泽归云玄。\n因忆右军修禊叙，智永藏之固其所。\n今比萧翼谁贤愚，豪夺何如能乐与。\n君子于物不留意，好德终然胜好古。\n剑许徐君自有心，书还孔氏非无故。\n粟可不食国可辞，较之一纸真毫釐。\n闻风廉立遽如许，信哉圣人百世师。\n西山之薇何独美，向微二子一草耳。\n东海鲁连死犹生，中书冯道生犹死。\n承平文献传至今，品题先后如盍簪。\n就中何人合愧死，九锡不是夷齐心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9530,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白海青","author":"汤炳龙","text":"皂雕赤鹘世纷纷，羽翮何如白线纹。\n东海飞来一片雪，西风透入万重云。\n老拳独击顽鹅恼，俊目宁看狡兔群。\n玉食所需谁可得，夜来丹诏赐元勋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9531,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绣毬花","author":"汤炳龙","text":"谁掷流苏满小园，无心花萼密相联。\n唐宫玉蝶团风软，后土琼花簇月圆。\n妖态欲来裍上舞，异香宜在帐中悬。\n试看有物浑成处，如在东风太素天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9532,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题水晶宫道人瓮牖图","author":"汤炳龙","text":"一从辞宰粟，饥饿隐空山。\n货殖门前客，先生不启关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9533,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题姚静斋女柔德一日三刲股救其兄云","author":"汤炳龙","text":"女生他人妇，兄死谁养亲。\n刲股与紾臂，孰仁孰不仁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9534,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖杂咏","author":"汤炳龙","text":"马塍鸡唱曙初回，几处严关次第开。\n多少卖花人已到，剩将春色入城来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9535,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题莫景行松竹梅图","author":"汤炳龙","text":"一客风流云水际，两侯潇洒雪霜时。\n如今三友交情密，不到岁寒人不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9536,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题竹梅图","author":"汤炳龙","text":"岁晚江空见此图，竹梅相伴占全湖。\n如何不与松为友，应怪人间作大夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9537,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杏坛","author":"黄元实","text":"相羊道德囿，爱此杏坛春。\n碧溪落青嶂，绿树空红尘。\n缅怀洙泗乐，千载意如新。\n从容二三子，援琴咏天真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9538,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其一 洋背春烟","author":"黄元实","text":"平芜百亩敞南郭，四散人家隐篱落。\n翳翳桑麻晓色浓，霏霏竹树晴光薄。\n大厦微茫垂柳边，残烧杳蔼苍山前。\n侍郎故园渺何许，玉涧日煖流寒泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9539,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其二 河潭秋月","author":"黄元实","text":"苍涯倒浸太阴黑，倾动变化在倏忽。\n玉盘一夜出龙宫，金波万顷涵蟾窟。\n木犀香湿露满山，斗角光动风生澜。\n何人拔剑插桥柱，直通银河上广寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9540,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其三 东川梵宇","author":"黄元实","text":"碧空直耸石桥杪，一径林间几萦绕。\n不窥城市入境中，上梯宫殿出尘表。\n潮师咸道雁塔高，三分留记龟石牢。\n此地令人忆谢傅，何当携手同游遨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9541,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其四 铙山晴雪","author":"黄元实","text":"嵬嵬圣石倚霄汉，障断濉南山一半。\n荒郊冰柱尽消融，霁日琼崖尚璀璨。\n鹤仙剪木飞云端，玉女弄月坐石盘。\n可怜射猎人物远，瀑凌万壑弓旌寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9542,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其五 湖障夕阳","author":"黄元实","text":"溪西诸峰崒且壮，一峰秀出横屏幛。\n晴川落日漾馀波，碧树红霞闪清涨。\n青山咫尺常相望，旸谷万里昭回光。\n谁能乘风度绝顶，空陵倒影观扶桑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9543,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其六 南郭渡船","author":"黄元实","text":"宏博坊前望溪曲，沙平岸涧水深绿。\n孤舟妥帖若乘槎，短棹咿哑如转毂。\n行□憧憧风雨忙，济川滚滚流泽长。\n谁谓江河渺空阔，半篙一苇俱可航。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9544,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其七 长吉晓钟","author":"黄元实","text":"沈沈绀宇据城阜，屹屹云楼挹星斗。\n画廊风静木鱼閒，青山日出华鲸吼。\n蒲山蒲谷俱闻声，随叩随应何容情。\n唤回迷途有归客，一滩月色浮空明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9545,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"濉阳八景 其八 迎釐午磬","author":"黄元实","text":"凤山胜绝三不见，竹木苍苍隔台殿。\n仙宫云构接丹梯，清昼璆声袅香篆。\n步虚讽彻瑶草凉，朝真斋罢紫芝香。\n侍宸白日骑鹤去，雷符绕壁馀神光。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9546,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其一 午窗山色","author":"黄元实","text":"门外青溪溪外山，山光长在有无间。\n白云飞尽晴窗午，喜见遥峰露一班。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9547,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其二 晚桡鸣月","author":"黄元实","text":"春江雨过水溶溶，短棹孤篷有钓翁。\n钓罢归来天向晚，一桡咿嘎月鸣中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9548,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其三 晚渡撑烟","author":"黄元实","text":"漠漠江烟晓未开，行人唤渡过江来。\n一篙不见水清浅，撑散眠鸥石畔苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9549,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其四 沙晴睡鸭","author":"黄元实","text":"熟睡晴沙爱暖曦，鸬鹚鸂鶒莫相疑。\n江花江草春将遍，我亦忘机总不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9550,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其五 夹堤杨柳","author":"黄元实","text":"杨柳青青夹岸垂，含烟带雨总相宜。\n苏公十里湖边树，谁遣东风一夜移。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9551,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春江十咏 其六 斜阳牧笛","author":"黄元实","text":"芳草平原日带曛，数声牧笛隔江闻。\n江空馀响随风起，剡剡归鸦落暮云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9552,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见率斋王廉使 其二","author":"刘鉴","text":"樽俎折冲贤甲胄，衣裳定伯胜兵车。\n先生学谱河汾嫡，礼乐须还贞观初。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9553,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见率斋王廉使 其四","author":"刘鉴","text":"千载河汾两夫子，一家洙泗几生徒。\n升堂房社俱先达，还许程元后至无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9554,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见率斋王廉使 其六","author":"刘鉴","text":"汉唐礼乐成三代，南北车书又一家。\n鸣鹿歌诗将意厚，臣忠端出自宾嘉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9555,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见率斋王廉使 其八","author":"刘鉴","text":"田园仅了都人役，事业全抛进士诗。\n白发见公曾感慨，深衣重有道行时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9556,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽度宗 其二","author":"王义山","text":"建隆成帝业，肇造宋乾坤。\n永穆昔传子，慈元今抱孙。\n羹墙有尧在，谟训即汤存。\n血染攀髯泪，哀缠彻九阍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9557,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"登青山太白墓文并歌","author":"王奕","text":"芦笔书空兮风凄凄。\n竹墨泌地兮雨垂垂。\n青枫黑塞兮梦公者谁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9558,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日","author":"陈杰","text":"春日悠悠，春风载条，春酒思柔。\n念我农人，种秫在畴。\n春日迟迟，春风载时，春服有晖。\n念我蚕女，勚于桑畴。\n翩翩黄鸟，载好其羽。\n鲜鲜游子，式歌且舞。\n曾孙万年，敬我有土。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9559,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"明月","author":"陈杰","text":"悠悠明月，载盈载缺，我酒在室。\n皎皎明月，载缺载盈，我酒在庭。\n白日苦短，而夜苦长。\n迟尔不来，明月靡常。\n载脂我车，载秣我马。\n煌煌于征，明月在下。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9560,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读邸报 其二","author":"陈杰","text":"钻刺逢迎状似奴，是非羞恶一毫无。\n盖间老犬曾共嗾，韝上新鹰正待呼。\n递趱庸回联鼎食，长排耆俊在泥途。\n一朝政事渠何算，可惜倾人好国都。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9561,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"坐白水寺门亭","author":"方回","text":"百病今朝愈，城南野寺滨。\n石崖阴欲冻，沙路瑩无尘。\n松老枝垂地，溪清水见人。\n僧瓶送煎茗，泉冽味尤新。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9562,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"暑中閒咏六首 其六","author":"方回","text":"篱门矮复斜，乌桕发枯槎。\n曾守诸侯土，还同百姓家。\n葛囊悬苣子，梅卤渍栀花。\n臧获修时事，分衣缺布纱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9563,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀秋崖","author":"方回","text":"崖仙忆昔手予携，音响如钟气吐蜺。\n槐国诸公千梦蚁，瓮天馀子一醯鸡。\n满浮芳酒春梅动，朗诵新诗夜月低。\n倏三十年如一瞬，东坡门下愧双溪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9564,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"生日戏歌","author":"方回","text":"予生宝庆之三岁，五月十一日己未。\n五十有八甲申年，其日己未亦复然。\n天支地干标六秀，四柱得一文且寿。\n阳火在天为太阳，阴火为月受日光。\n将望之前四日夕，十分圆光已八七。\n常闻人生不满百，何幸七十且八十。\n文章学问七八分，亦胜愚夫老无闻。\n古之五月而生者，后有胡广前田文。\n予贱不敢望汉相，贫亦不能孟尝君。\n借使时人不比数，自有诗名照千古。\n垂弧之月至于今，适逢前五仍后五。\n稚女簪榴花，小儿著艾虎。\n宿酲困不解，依旧醉起舞。\n不妨一年两度作生朝，更造菖蒲酒，饮过闰端午。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9565,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]