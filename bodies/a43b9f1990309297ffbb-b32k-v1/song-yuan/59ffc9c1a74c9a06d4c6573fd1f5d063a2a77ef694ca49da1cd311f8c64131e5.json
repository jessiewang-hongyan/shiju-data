[{"title":"次韵仇仁近至日","author":"方回","text":"浪说春回地底阳，驼裘正怯北风凉。\n未来事甚云难测，已老身无日再长。\n紫逻招魂千里雪，彤庭待漏五更霜。\n閒人幸脱拘挛外，客枕何庸早起忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近梅雨","author":"方回","text":"客心何日渡桑乾，琐琐良难雨更难。\n途潦家家踰户限，檐声夜夜过更阑。\n归舟屡阻千滩涨，暑簟频惊五月寒。\n会许灯花报晴信，书帷新照玉虫丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近晴窗二首 其二","author":"方回","text":"往时淟涊玷蕃宣，处士名闻积有年。\n甚欲同倾彭泽酒，未能略送始兴钱。\n细看好句无疵处，时出名言亦自然。\n苦海爱河争没溺，禅窗一榻篆茶烟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近晴窗二首 其一","author":"方回","text":"涧毛足可继晨羞，窗暗窗明日去留。\n古道海深磐石坠，时情风缓暖丝游。\n天渊有间终何恨，人我相违各不求。\n四顾茫然欲焉往，一寒端为效忠谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近谢诗跋","author":"方回","text":"羁角朋从饰帨觿，成人可更戏桐圭。\n万钧致力终能举，一字争工未易题。\n鲁颂向来睎考父，雩风元自异公西。\n长江破浪输君手，肯学村船逆上溪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵元煇中秋雨","author":"方回","text":"良辰合与一樽酬，有酒无朋也自愁。\n万事只堪花老眼，一年又过雨中秋。\n鸣砧处处凄邻巷，击柝相望起戍楼。\n更著乱蛩环独榻，平生天地付神游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵元煇昨游","author":"方回","text":"藕花茭叶忽明眼，此地聊乘解愠风。\n无酒尚堪翻作有，苍颜终不变为红。\n虚声浪漫盈天下，急景奔腾过日中。\n万事可容著心力，迩来诗句亦匆匆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近暑中二首 其二","author":"方回","text":"瞬息凉炎代谢频，沉冥自养静中身。\n读书快意如抓痒，得句言怀当写真。\n幸不与闻当世事，可须常作半途人。\n忽思秦汉干戈际，商岭犹堪避战尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵仇仁近暑中二首 其一","author":"方回","text":"初减官河几许深，向来惟恐百城沈。\n晴阶近喜收檐滴，暑屋殊嫌乏树阴。\n妾妇齿牙工斗阋，比邻疟疠厌呻吟。\n悬知壮士无颜色，赖有同心可断金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵文蔚约梅上人来访","author":"方回","text":"惭非好客郑当时，猥荷高人不见遗。\n顿悟可能参佛理，淡交谁是喜僧诗。\n过从未许泥行数，属和多因险韵迟。\n彼此缄縢各收拾，他年开卷两相知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵方去言用予喜归韵见寄三首 其三","author":"方回","text":"野鸟呼风金粟堆，曲江宫殿委荒苔。\n是非谁办笔褒贬，鸿燕屡惊春去来。\n偃月人今奸骨朽，浣花翁未醉眉开。\n吟君诗罢登山崦，立尽斜阳尚懒回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵方去言用予喜归韵见寄三首 其二","author":"方回","text":"笔法君追宝晋斋，禅机我愧老蒲鞋。\n尝僚台阃相知旧，得友江山到处佳。\n铁马尘高频极目，锦鳞音断岂忘怀。\n亦思竹底陪溪逸，人品终疑未易侪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵方去言用予喜归韵见寄三首 其一","author":"方回","text":"秋高亲见老崖来，险阻嵚崎付一杯。\n万古悬知名不夜，九泉谁免骨为灰。\n轻鸥熟与风波狎，劲柏宁资粪壤栽。\n却笑诸儿浪生死，大都暮落枉朝开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵王君偕子同来访","author":"方回","text":"愧子初来坞路赊，曾微酒旨与殽嘉。\n答诗辄便拈枯笔，接话才能供淡茶。\n膝上佳儿如玉雪，山中春事几风花。\n良畴世世勤菑播，终待明时遇宅家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵王俊甫山长九日登乌聊二首 其二","author":"方回","text":"江边危阜俯江皋，去马来牛细若毛。\n古道向来元寂寂，俗流何处不滔滔。\n漫拈老笔雕空阔，径命芳樽洗郁陶。\n天地年年有摇落，悲秋端谢楚人骚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵王俊甫山长九日登乌聊二首 其一","author":"方回","text":"山色初明小雨开，可容无地拓襟怀。\n荒寒试与登临去，奇崛能随感慨来。\n何限诗愁关世故，终凭烂醉了生涯。\n风流二谢犹堪恨，俯首刘郎戏马台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其七","author":"方回","text":"昭谏先生宅，咸平处士庐。\n大名无死朽，外物几乘除。\n岁月勤稽古，山林永遂初。\n能诗直馀事，焉不蔺相如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其六","author":"方回","text":"以逊而绵者，居然古性情。\n温恭瞻道貌，响浪听心声。\n施药痊诸病，留田与后耕。\n日予拜嘉惠，欲报乏连城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其五","author":"方回","text":"子将今月旦，可否判生枯。\n高论真能借，羁怀未觉孤。\n竹吟风拂席，花饮月当垆。\n甚愿陪游屐，唯惭老杜殊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其四","author":"方回","text":"我听髯张作，清于月夜笳。\n曹思先七子，杜老到三巴。\n有力能推拉，无疵可汰沙。\n文潜遗论在，霜露老蒹葭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其三","author":"方回","text":"今代邓元侯，书窗不外求。\n寡言良有味，节用绝无愁。\n真是温如玉，兼能爽似秋。\n銮坡宜趣召，夜直结邻楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其二","author":"方回","text":"老怀饶感慨，无一可欢娱。\n久矣还初服，胡然落半途。\n流年苏武雁，往事左慈鲈。\n莫笑腰围减，还堪作酒壶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之书怀七首 其一","author":"方回","text":"二十八回见，天门阖左扉。\n不嫌笔端退，但骇镜中非。\n自爱希声瑟，谁知尚絅衣。\n人生年七十，肯复壮心飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵邓善之论诗","author":"方回","text":"未极皮毛落，端难颊舌传。\n夔音谐柷敔，岐脉按钩弦。\n举目常如见，关心或不眠。\n江湖无正色，龋齿亦嫣然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵休宁程君圉来访","author":"方回","text":"秋崖劲笔敌黄陈，贽卷当年许望尘。\n十载江湖春雁断，万山烟雨石羊新。\n馀生敢忘尊前话，先正曾同席上宾。\n今日相逢两家子，可无努力继前人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵全君玉元日二首 其二","author":"方回","text":"春攽诸郡国，汉守喜惟良。\n旦宿重中尾，时花竞向阳。\n古今新旧历，老少后先觞。\n万事皆如此，无如且醉狂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵全君玉元日二首 其一","author":"方回","text":"五更皆早起，惟我是閒人。\n展镜须仍雪，添杯脸暂春。\n有终还复始，无旧不成新。\n万古烧痕意，陈根岂尽陈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵刘元煇飞雪数片之作","author":"方回","text":"六幕垂同冻不埃，舞霙呼我燕窗开。\n已从衣上霏微见，未肯檐前汗漫来。\n就砌拾看呵指笋，隔帘迎数斗妆梅。\n衰髯却怪全相似，且置閒愁拨蚁醅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵刘元煇元日","author":"方回","text":"九十日春已十日，清晨閒步小园中。\n池痕欲涨去年水，柳色渐回东畔风。\n砥道歌游全似梦，专槃生化本无穷。\n阴晴寒暖频占相，世事唯宜岁事丰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵刘元煇初寒夜坐","author":"方回","text":"山肩寒耸月随归，榾柮炉红闭板扉。\n跨灶郎来温课册，齐眉人为摺深衣。\n花传喜信灯如语，草就佳篇字欲飞。\n旧日声名刘夜坐，能传家钵似君稀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵刘君鼎见赠二首 其二","author":"方回","text":"真复多多穷传记，端能亹亹著诗文。\n名场早捷千军阵，胪陛应符五色云。\n乱后湖山今稍稍，閒中宾主几醺醺。\n衰迟亦欲陪赓唱，未必当筵逮所闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵刘君鼎见赠二首 其一","author":"方回","text":"厌闻世态已如聋，旧雨人来久绝踪。\n自笑云萍无定止，不图针芥有奇逢。\n侯门列鼎三牲奉，田舍巾车一鹿容。\n试问吟怀欲何向，定应羞傍马医钟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2128,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵吕肖卿讲学三首 其三","author":"方回","text":"忽复机锋对，真堪底里倾。\n果能成伏老，时许唤殷兄。\n可惜兹逢晚，相期不计程。\n受恩凡两世，焉敢恝无情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2129,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵吕肖卿讲学三首 其二","author":"方回","text":"玄珠在掌握，一失永难寻。\n岂不求成道，谁其办苦心。\n待时花结果，著力杵磨针。\n何幸忘年去，能鸣治世音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2130,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵吕肖卿讲学三首 其一","author":"方回","text":"平生但力田，岂计不逢年。\n吾道桴浮海，斯文笔补天。\n早能丹点铁，曾用白嘲玄。\n万虑今亡矣，焚香易一编。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2131,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵夹谷子括吴山晚眺 其三","author":"方回","text":"落木萧萧泽国宽，偶舒岩啸纵川观。\n六鳌海阔征帆远，万象天低步屧寒。\n旅泊馀生箪食菲，宦游旧味瓮齑残。\n达人不堕牛山泪，何待将心与汝安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2132,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵夹谷子括吴山晚眺 其一","author":"方回","text":"诗眼书胸碧宙宽，暮天摇落纵遐观。\n霜明枫叶红于染，春点梅梢玉不寒。\n北望遥迎书雁至，南烹屡餍鲙鱼残。\n一规明月悬江海，几许人家夜枕安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2133,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵夹谷子括吴山晚眺 其二","author":"方回","text":"鹘飞欲没海天宽，万动盈虚静处观。\n一画微阳迎日至，九畴休徵验时寒。\n世间劫火灰何限，物外仙棋局未残。\n好与苍生司性命，五风十雨报平安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2134,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵孙元京见过言诗 其一","author":"方回","text":"骚坛争长各称兵，未卜谁欤霸业成。\n欲疗左盲治谷废，合除白俗扫元轻。\n屡更落落心犹壮，常恐空空气骤盈。\n据险作难终未是，赖公指示轨图平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2135,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵孙元京见过言诗 其二","author":"方回","text":"眼底惊嗟见此流，祇嫌接对未云稠。\n苏门逸响追长啸，湘浦馀情续远游。\n新息今须乘果下，襄阳谁漫钓槎头。\n吾衰久矣公犹健，好控飞车跨九州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2136,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵权季玉枕上偶成","author":"方回","text":"迩日屡闻亲药鼎，客怀沈郁与谁论。\n细参素问心无病，勤剔青灯眼未昏。\n九折政思为孝子，七襄未用乞天孙。\n察君诗味如枯淡，中有无穷古意存。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2137,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵许大初见赠二首 其二","author":"方回","text":"风灯雪屋话艰难，各喜诗成咳唾间。\n早幸渊骞同阙里，终当园季隐商山。\n草玄执戟空投阁，枕面参军善闭关。\n祇恐傍人足嘲讶，如泥烂醉不知还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2138,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵许大初见赠二首 其一","author":"方回","text":"相逢未觉道途难，把酒论诗数夕间。\n磊落胸襟开古谊，从容色笑借和颜。\n长年役役鱼千里，末俗悠悠虎九关。\n赖是同乡复同味，一寒如此遽春还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2139,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵许瑞石送邵容斋见寄","author":"方回","text":"款段馀生谢伏波，咏归心事竟云何。\n藕花又趁榴花发，诗债仍兼酒债多。\n击壤先生黄色论，卖薪老子翠微歌。\n吾侪胸次元相似，谁道金章胜钓蓑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2140,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵齐君见过","author":"方回","text":"从容谈笑猎文场，焉用椎锋更挽强。\n政使成功能裂土，未如闻道许登堂。\n勇捐将印机心息，深隐书帷古味长。\n我亦暮年懒干禄，肯来同醉简编香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2141,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵伯田见酬四首 其四","author":"方回","text":"六桥久客旧湖滨，春日花开不似春。\n游学顿无福建子，科名更说梓潼神。\n暗惊渊实丘夷事，枉作书痴传癖人。\n辛苦湘累辨兰艾，庄生齐物等埃尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2142,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵伯田见酬四首 其三","author":"方回","text":"半年洄溯越江滨，每愧羊裘老富春。\n归隐尚能联比长，出游复肯祭行神。\n枯肠近饱三爻梦，宿齿宜肩四豆人。\n能顾寒斋共芳茗，蠹编时为拂蛛尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2143,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵伯田见酬四首 其二","author":"方回","text":"世故吾其问水滨，向来不合典班春。\n一从去作沧浪客，几度重题郁垒神。\n垂死岂堪思往事，忍穷方欲作閒人。\n喜公强健犹如故，未有清樽可祓尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2144,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵伯田见酬四首 其一","author":"方回","text":"久缺笺筒到霅滨，相逢依旧气如春。\n深藏尺璧元无价，时击圆蓍尚有神。\n桑梓兵戈三峡路，衣冠文物五朝人。\n片时略得陪清话，一扫胸中万斛尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2145,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵君泽夜坐示子侄三首 其三","author":"方回","text":"雨脚如麻坐到明，雨楼听尽五更声。\n无人共唱寻寻觅，有子聊教仄仄平。\n凌室不能藏腊冻，稼场或至误秋成。\n谁知忧世书生意，惟愿天阶正玉衡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2146,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵君泽夜坐示子侄三首 其二","author":"方回","text":"一样乾坤几样人，甑生尘异袜生尘。\n寒窗黄卷青灯雨，暖阁金钗玉斝春。\n谁同公子梦方魇，我与先生诗又新。\n□□儿曹供笔墨，为言不是写真真。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2147,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵君泽夜坐示子侄三首 其一","author":"方回","text":"灯影稀疏两岸楼，市声已寂睡声齁。\n几家梦断三更过，此老心穷八极游。\n服气仙人吾不学，坐禅释子彼何求。\n夜思昼读诸郎识，俯仰青春鬓忽秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2148,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张中白元日","author":"方回","text":"瓣香清晓肃冠绅，户外遥山展翠颦。\n瘦影自怜耽醉叟，欢声何限喜晴人。\n匆匆节序梅花老，衮衮尘埃世事新。\n自有天来至今日，不知芳草几番春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2149,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张文焕慵庵万山堂即事二首 其二","author":"方回","text":"新晴钟鼓暮楼台，人与清空两不埃。\n日已顿无宣子畏，云应全为退之开。\n夜凉河汉牛初渡，秋爽关山雁欲来。\n好向丰年作张主，未须松鼎煮丹胎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2150,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张文焕慵庵万山堂即事二首 其一","author":"方回","text":"张侯诗思涌如泉，吟榻横陈翠麓巅。\n十雨五风今乐国，千村万落几人烟。\n赏心眺览知何算，转首音尘竟弗传。\n句勒口碑天共远，不虚佳月佐觥船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2151,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张仲实见赠","author":"方回","text":"久縻官务费爬梳，一旦投閒得自如。\n紫绶金章已高阁，青鞋布袜是安车。\n漫郎心事诗能说，散圣禅流发未除。\n物我重轻中了了，可能秤象待苍舒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2152,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张仲实岁晚","author":"方回","text":"老穷胜夭达，敢惜岁时迁。\n食玉多忧死，披蓑且醉眠。\n西湖非昔者，南雪尚春前。\n稍足陶瓶粟，诸公不用怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2153,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张仲实读予近稿","author":"方回","text":"平生穷到骨，不受世人怜。\n肠倒三江洗，诗凭万口镌。\n旂常无可纪，衣钵尚堪传。\n今日如斯者，输君独妙年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2154,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张慵庵立秋有怀","author":"方回","text":"西风一叶未为稠，积雨寒添客思秋。\n试以物情观燕垒，可无心事寄菟裘。\n砚何堪办三钱水，竹岂能踰十稔楼。\n真是先生有归兴，不应如我雪盈头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2155,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张慵庵观予奕棋","author":"方回","text":"与牧猪奴可不同，嗟予老矣尚心童。\n戏拈玉子鸣飞雹，良喜青裾驻织葱。\n浪设机关何所益，仅存边角未为雄。\n小鬟有着能相恕，冷被傍人笑此翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2156,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵张慵庵言别就送","author":"方回","text":"屡陪幽话探玄关，虚往无何已实还。\n远眺每穷千里外，佳吟时见一联间。\n致身霄汉名方起，回首林泉意欲閒。\n闻说姑溪卜新筑，会须容访郭青山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2157,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]