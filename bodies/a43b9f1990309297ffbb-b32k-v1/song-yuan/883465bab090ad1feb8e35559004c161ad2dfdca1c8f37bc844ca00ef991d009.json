[{"title":"次韵宾旸啼字犹字二首 其一","author":"方回","text":"醉眼看东误作西，衣缁巾醭屦拖泥。\n身无却少心徒壮，花自重开草更萋。\n信马旧痕今已灭，干虹老气似宜低。\n楼中是日喧呼甚，闻说邻儿亦止啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2219,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵徐子英江楼二首 其二","author":"方回","text":"娱老曾微燕子楼，谋生又欠木奴洲。\n不无造物司行止，岂与齐民系戚休。\n幸际乾龙亨庶物，故希晋马锡康侯。\n妙龄今日如公等，声气方当叶应求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2220,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵徐子英江楼二首 其一","author":"方回","text":"虚器浮名蜃结楼，潮痕才落水添舟。\n医工药不关生死，詹尹蓍宁究咎休。\n华盖天临批凤诰，长杨日侍射熊侯。\n是人有命皆能致，终许难凭智力求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2221,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵徐子英读予所抄赵章泉诗","author":"方回","text":"陈隋馀习尚尘飞，可乏诗坛白羽挥。\n凡物晚成华者实，如吾素论是耶非。\n三生不堕扬州梦，一笑应知佛祖机。\n苦学若人亦馀事，真源向上更深微。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2222,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵徐容斋赠丘通甫","author":"方回","text":"绝如山谷赠初君，奇绝新诗妙绝文。\n斥逐三彭精异术，破除二竖奏元勋。\n千茎白雪难重少，一匕玄霜幸见分。\n可惜向来缺参请，按摩搬运漫辛勤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2223,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵袁提学题皇甫真人清虚庵二首 其二","author":"方回","text":"犹忆清虚下云汉，转头劫堑已灰飞。\n三山恍惚惊鳌动，千岁凄凉望鹤归。\n风度羡君仙骨瑩，年华迫我世缘微。\n岂无道侣歌招隐，许脱红尘卧碧霏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2224,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵袁提学题皇甫真人清虚庵二首 其一","author":"方回","text":"清地虚天渺何许，芒鞋未往意先飞。\n山中叱石初平隐，月下吹笙子晋归。\n不死真人千劫在，无垠浊世一尘微。\n何当日咽丹池水，长共寒猿啸月霏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2225,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵高子明投赠二首 其二","author":"方回","text":"四时天地共成春，千古羲黄寸壤邻。\n空复飞车行万里，本无弱水隔三神。\n大人尺蠖同伸屈，俗物群狙易喜嗔。\n子欲从吾参此妙，倒翻银汉洗尘巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2226,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵高子明投赠二首 其一","author":"方回","text":"中原从昔信多艰，尚有文才与古班。\n诗律规随元好问，乐章隽永蔡萧閒。\n要知精会神全处，须到声销色泯间。\n此话无人胶凤觜，一蓑烟雨紫阳山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2227,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵寄川无竭并送所撰旃檀林记二首 其一","author":"方回","text":"彭门不记旧楼黄，吟社参寥未肯忘。\n更著雪添双短鬓，早惊秋隔两重阳。\n遥知剩种旃檀树，便拟同焚艾纳香。\n勉为龟蚨驱兔颖，愧无雄健亢三长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2228,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵寄题堪上人云外轩","author":"方回","text":"万重云外一蘧庐，想见降龙长者居。\n溪上过桥谁觅路，峰头飞锡已凌虚。\n汉台列像焉知许，陶岫吟归孰起予。\n傥憩夜炉煨芋处，可能更读邺侯书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2229,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵康庆之秋夜客怀自述","author":"方回","text":"遁肥久已远罝罗，独慨流年老易过。\n宦学向来千龃龉，功言竟复两蹉跎。\n是山可隐在人耳，今雨不来如彼何。\n群蛰闭关迫摇落，未须轻奋怒蝇戈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2230,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵康总管庆之和碑字韵二首 其二","author":"方回","text":"山游灵运屐，寺乞简栖碑。\n岁计多栽菜，流年懒问蓍。\n醉眠书当枕，禅戏偈成诗。\n鬓白非今日，何劳晓镜知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2231,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵康总管庆之和碑字韵二首 其一","author":"方回","text":"周颂岐阳鼓，秦铭泰岳碑。\n览观明古镜，推测妙神蓍。\n真复登三事，何如赋万诗。\n江湖频作郡，棠荫有人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2232,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵曹清父营生坟追和范石湖韵四首 其四","author":"方回","text":"杀心奕局响纹楸，鸡肋何如酒德刘。\n世事但堪常袖手，人生政要早回头。\n谁能卒办鱼千里，自笑终成貉一丘。\n□□明年才七十，商山剩饫紫芝秋。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2233,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵曹清父营生坟追和范石湖韵四首 其三","author":"方回","text":"□□如斯举一隅，谁非长夜閟金乌。\n裹尸马革真□□，□□□山浅丈夫。\n羽化苦无仙伎俩，茶毗别是佛规模。\n□□彭祖终须尔，匪悟浮休肯豫图。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2234,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵曹清父营生坟追和范石湖韵四首 其二","author":"方回","text":"古来奕世保松楸，八百姬周四百刘。\n今代未闻□□□，□时尚想引魌头。\n干戈蒿里无完穴，□□兰亭有□□。\n□□□□谁可免，一杯聊□祝千秋。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2235,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵曹清父营生坟追和范石湖韵四首 其一","author":"方回","text":"桑榆未迫尚东隅，诸子盈前返哺乌。\n早检青囊营□□，□□丹灶著工夫。\n无生话可忘言了，自祭文能信手摸。\n□□□年未遑办，一抔□□□良图。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2236,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵象山书院山长汪德载垂访","author":"方回","text":"古学非如进士场，渊乎深处海难量。\n善藏未用争饴利，中立悬知异狷狂。\n度远出寒公案在，渐修顿悟话头长。\n公□与我评兹事，一洗人间粉黛妆。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2237,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵雪后","author":"方回","text":"檐澌馀滴溅风棂，三日晴犹剩半庭。\n足使蝗蝻俱屏迹，未妨莺燕尚潜形。\n调盐冻字难为墨，透瓦炊烟渐放青。\n共笑爱梅痴老子，夜深温水换铜瓶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2238,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵景安提学谩成三首 其一","author":"方回","text":"敢着寻常白眼看，壑冰峰雪照人寒。\n言诗已是登坛将，劝学聊为祭酒官。\n士类相推无异论，亲颜遥觉有馀欢。\n即今人物皆公等，岂不忧时意稍宽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2239,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵景安提学谩成三首 其二","author":"方回","text":"豪釐俗事不留情，诗律峥嵘骨骼清。\n初仅传闻心已服，每当展玩眼尤明。\n笑谈足使千军扫，移斡真能九鼎轻。\n焉得夜檠对吟影，同听急雪打窗声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2240,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵程以忠同饮 其一","author":"方回","text":"饮湿自嫌无圣酒，摘鲜犹幸有真茶。\n艰危昔偶分侯竹，老病今还龁庶瓜。\n已约社鸥盟水石，尚惊征马困风沙。\n醉人不管傍人笑，瘦影伶俜乱鬓髿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2241,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵程以忠同饮 其二","author":"方回","text":"风云变化世常有，丘壑盘旋谁与同。\n驾驭孟嘉真得势，滑稽方朔浪言工。\n律严诗友何妨少，租薄秋田亦幸丰。\n两手搔头指欲秃，犹堪举酒吸长虹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2242,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢王君","author":"方回","text":"妙年富才藻，亹亹迫渊云。\n逸势波澜阔，神功混沌分。\n百为争细故，一笑付微醺。\n天地江河在，终垂万古文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2243,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢平心胡秘监见惠生日五首 其五","author":"方回","text":"风追电逐角材贤，我独从公息担肩。\n野旷杖藜临绝景，山寒采梠度层巅。\n淡汤煮饭身无病，小秤收租岁有年。\n臭橐腐仓死兵火，何如清节保生全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2244,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢平心胡秘监见惠生日五首 其四","author":"方回","text":"酒可吾中孰圣贤，定开愁眼耸吟肩。\n共怜雪鬓双垂叟，时到花屏万仞巅。\n暂借松阴消永日，敢求药诀觊长年。\n风惊尘愕奔车跌，醒者苍黄醉者全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2245,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢平心胡秘监见惠生日五首 其三","author":"方回","text":"势途勇退似差贤，焉用鸿门切盾肩。\n早赐辒辌埋厚夜，宁扶楖栗走荒巅。\n泥龟不羡鹍鹏路，粪菌徒输栝柏年。\n我谓是身如尺璧，深藏短褐庶能全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2246,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢平心胡秘监见惠生日五首 其二","author":"方回","text":"五朝遗老冠时贤，家祭犹无掩豆肩。\n文采春花洛阳苑，精神秋隼华峰巅。\n难兄共对三千字，晚境今开九十年。\n富贵朱门百杂碎，先生归卧故庐全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2247,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢平心胡秘监见惠生日五首 其一","author":"方回","text":"晚生何敢跂前贤，夫子宫墙赐及肩。\n忆枉朝车十官宅，喜成邻舍万山巅。\n尚堪湖学生徒齿，恰少汾阳考第年。\n想得囊中有仙诀，形容枯槁但神全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2248,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢严养晦酒边说易","author":"方回","text":"四正为奇偶四隅，旧窥七七古河图。\n易虽未画元知有，极果何形孰识无。\n方寸天开通造化，半生夜坐下工夫。\n老衰多学精专少，病体抠趋但要扶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2249,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢吴太初","author":"方回","text":"落笔谁云古意赊，四灵何得擅东嘉。\n跨鸾未斫吴刚桂，对鹤频烹魏野茶。\n商略春词犀堕雪，留连夜酌烛生花。\n如君三世工文墨，江左于今有几家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2250,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢李寅之鄂渚见寄 其二","author":"方回","text":"叩户惊传千里使，开缄快睹七言诗。\n古希年迫公犹健，不仕风高我所思。\n儿大知书聊慰意，家贫食粥亦随时。\n迩来稍喜休兵革，赛社秋场醊祭釐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2251,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢周兄见访","author":"方回","text":"弱壮之间几辈流，不凡已与老成侔。\n笔端可挽千钧弩，胸次如登百尺楼。\n良木政须资长养，芳兰未厌□□□。\n□□衰晚不闻道，幸早专心似奕秋。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2252,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢河内张明府来访","author":"方回","text":"此老良高谊，能来问故侯。\n人清严濑水，家住沁园州。\n兀坐元无事，閒谈幸少留。\n重逢定何日，归梦在瓜畴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2253,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢俞山长见赠","author":"方回","text":"年衰才尽懒挥毫，定有移文责鲁皋。\n学到紫阳今欲绝，诗如清老子能高。\n栖迟矮屋官犹冷，傲睨芳樽气自豪。\n试遣俚音辱聪听，未应堪比郁轮袍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2254,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢胡子游学正二首 其二","author":"方回","text":"泮宫分席佐邦侯，免使诗人讽不求。\n九转定应能点铁，一泓何可着吞舟。\n稍知今是山林晚，独奈吾衰岁月流。\n径欲为君赋招隐，朝簪窃恐未容抽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2255,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢胡子游学正二首 其一","author":"方回","text":"瞻紫阳山日仰高，此翁暮景亦云劳。\n一爻变卦逢初遁，万古哀心寄续骚。\n倬彼大贤犹蠖屈，矧予小技仅蝉号。\n竹林书在吾能读，不厌千周更百遭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2256,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢夏自然见寄四首 其四","author":"方回","text":"士气兼文脉，湮微复几年。\n浅肤专徇俗，高亢类谈禅。\n春动霆声起，云开月体全。\n古人方册在，达者以心传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2257,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢夏自然见寄四首 其三","author":"方回","text":"通经闻大道，馀事始为诗。\n初或无人识，终须有己知。\n真能深造否，孰谓晚成迟。\n小袖朱弦手，何忧乏子期。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2258,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢夏自然见寄四首 其二","author":"方回","text":"门人浮小艇，不比旧专城。\n自愧频来往，何烦数送迎。\n病身缘畏饮，去路似贪程。\n别后君诗进，他时定有名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2259,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢夏自然见寄四首 其一","author":"方回","text":"与子俱逢掖，寒瓢共碧流。\n歙今全似鲁，睦亦盛于邹。\n竹屋南溪外，风帆古渡头。\n相寻欠相遇，遄复堕音邮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2260,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢曹之才见赠","author":"方回","text":"崦嵫苒苒迫斜晖，梦断铭功十二旂。\n邻曲过从穿不借，故乡书问寄当归。\n固穷敢向中途悔，小隐无令始愿违。\n万境皆空心已死，沾泥落絮肯重飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2261,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢喻岩叟","author":"方回","text":"妙年璧水播英辞，半世闻声鬓未丝。\n赐姓远从梁武日，家风复见喻凫诗。\n九霄空阔飞腾势，万卷纵横讲授师。\n重到庐山亦何喜，喜君知我我君知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2262,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢喻岩叟读予近作二首 其二","author":"方回","text":"鬓须全是雪，政坐癖于诗。\n老不谋丹穴，贫犹泥墨池。\n今年逢旅卦，何日赋归辞。\n得句求君诀，时容诣讲帷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2263,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢喻岩叟读予近作二首 其一","author":"方回","text":"观君于势利，如帚扫丝窠。\n阅世云翻雨，持心济贯河。\n端居冠必整，閒赋砚频磨。\n我岂无新作，何堪对雅歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2264,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢董君读予诗稿 其二","author":"方回","text":"宇宙茫茫战马尘，中原文献不无人。\n诗裁綵笔天公妒，书拥青灯夜气神。\n筛雨簸风六月冷，磔云裂雾千峰新。\n何当君病早勿药，共倒松阴百瓮春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2265,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢遁翁吴山长孔昭三首 其三","author":"方回","text":"降原陟巘敢嫌赊，风物元从僻处嘉。\n晴日缓行果下马，春山初试雨前茶。\n野桥潇洒泉如雪，石壁巉岩藓自花。\n剩欲移居此中住，便依诗老作邻家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2266,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢遁翁吴山长孔昭三首 其二","author":"方回","text":"乾淳一老去非赊，里社游谈亦孔嘉。\n仙驭不还缑氏鹤，禅机空说赵州茶。\n神农为我先尝药，迦叶谁今又笑花。\n欲向君侯问端的，流风应谢鲁东家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2267,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢遁翁吴山长孔昭三首 其一","author":"方回","text":"笔追古作未云赊，正始遗音到永嘉。\n谏列合骑沙苑马，从臣宜赐壑源茶。\n吟边彭泽先生柳，梦里长安进士花。\n不朽故知非爵位，文章海内旧名家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2268,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢魏公辅二首 其二","author":"方回","text":"男儿初嗜学，如日晓行天。\n意气无馀子，诗书有夙缘。\n果能知此道，深欲候吾船。\n梦寐心常在，孤灯可不传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2269,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵谢魏公辅二首 其一","author":"方回","text":"之子如天马，终归十二闲。\n相期作名士，不厌坐穷山。\n师席抠趋际，亲庭定省间。\n鹤仙门户冷，今喜一珠还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2270,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵感学事二首 其二","author":"方回","text":"战鼙惊倒白头翁，慨想青衿旧日风。\n或厌三场争小技，孰知一目网群雄。\n齑盐此地涵濡久，藻鉴他时赏拔公。\n松老槐颠异畴昔，定应穷极道还通。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2271,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵感学事二首 其一","author":"方回","text":"风雩谁识旧童儿，法令今惟柱后师。\n刻枣谁书惊荡尽，踏槐遗老叹崩离。\n堂中授讲亡高座，庑下题名剩续碑。\n奎壁不存斋舍改，端能为泯少年诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2272,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬刘彦直","author":"方回","text":"稷下先生旧老成，十年江表耸雄名。\n观星南极孤槎远，赏月西湖独榻横。\n笔底篇章追梦得，樽前风味胜公荣。\n酒楼一诵惊人句，四座如闻霹雳声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2273,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬吴僧一山行魁","author":"方回","text":"为僧应胜我，可惜堕禅林。\n铸错剪须发，书痴雕肺心。\n闻名梅止渴，晤语旱逢霖。\n一句诗传世，猿边几夜吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2274,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬赵无己","author":"方回","text":"文才因学进，名誉待时隆。\n定有仙能遇，元无鬼可穷。\n刚贞侔铁石，猥琐笑蒿蓬。\n百尺楼头目，时时没去鸿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2275,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬郝润甫二首 其二","author":"方回","text":"幸君三复甫田诗，髀肉空消万里驰。\n直与群飞争勇往，可能小退入深思。\n古人未必成功易，智士宁无见事迟。\n海阔天长一翘想，抟鹏岂料竟低垂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2276,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬郝润甫二首 其一","author":"方回","text":"与君山泽两臞仙，浪走尘埃汩市廛。\n老貌相逢今又别，馀生更觉不如前。\n孰追赤制春秋笔，稍悟黄庭内外篇。\n俯仰此心了无愧，冷看举世售栀鞭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2277,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵僧自文见赠四首 其四","author":"方回","text":"莫诧横磨剑，宁为没字碑。\n问花惊兔麦，赋药护羊蓍。\n今我都无事，非公不作诗。\n夜窗各坚坐，两地月明知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2278,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]