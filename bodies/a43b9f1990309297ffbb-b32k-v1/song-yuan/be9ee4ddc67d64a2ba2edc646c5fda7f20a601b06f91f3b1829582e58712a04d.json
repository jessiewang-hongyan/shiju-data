[{"title":"寄陈南翔张伯成主宾","author":"仇远","text":"山水未游遍，其如归梦何。\n独怜黄渚月，相隔白沤波。\n秋尽那无雁，霜迟尚有荷。\n终期共灯火，插架异书多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":562,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄武康王居正","author":"仇远","text":"曾向清溪采白蘋，江东日暮别经春。\n投金濑上思归客，浮玉山前忆故人。\n千里云萍应念我，一庭风树敢忘亲。\n挂蓑石暖苔衣厚，拟买渔舠作近邻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":563,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赵春洲莫两山","author":"仇远","text":"湖山满目旧游空，风景荒凉客路穷。\n雨意忽生桐叶外，秋光都在木樨中。\n乾坤混混多游骑，江汉寥寥有断鸿。\n自古隐人多嗜酒，却怜无酒醉新丰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":564,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄屠存博","author":"仇远","text":"三年尘土白须眉，拟向西湖濯客衣。\n林下杜鹃犹劝去，海边鸥鸟亦知几。\n及瓜将得葵丘代，存菊须寻栗里归。\n见说中山屠博士，乡心也趁白云飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":565,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄戚子云","author":"仇远","text":"七不能堪一不成，閒云自恨出山轻。\n柳枝骆马爱心断，莼菜鲈鱼归兴生。\n薄宦栖栖留泮水，故人渺渺隔台城。\n对床风雨何时卜，共剪青灯话到明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":566,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄梁中砥","author":"仇远","text":"句曲峰峦翠倚天，琳宫琼馆宴神仙。\n水程才隔一百里，脚债未偿三十年。\n几拟看山携酒去，相期听雨对床眠。\n何当拨遣尘间事，一试松根喜客泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":567,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄鄂渚王子文教授","author":"仇远","text":"笑把青藜杖，远游黄鹤城。\n雨消战伐气，春生弦诵声。\n相从未有约，久别难为情。\n东望思渺渺，江长秋月明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":568,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄潘怀古","author":"仇远","text":"园林摇落夜，静独奈秋何。\n黄叶下不止，青苔埽更多。\n回风喧地籁，浓露洗天河。\n怀楚思无极，长箫按九歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":569,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题如镜上人房","author":"仇远","text":"吴城久卜居，归梦只西湖。\n花木四时有，尘埃一点无。\n看经常戒酒，得句少催租。\n尽日坐相对，壁间莲社图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":570,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"屠存博教授赴溧水任留饮寓舍","author":"仇远","text":"只隔山中一日程，书船暂泊溧阳城。\n儒冠喜见贤翁季，道眼相看老弟兄。\n酒量吞江凉更阔，蝉声送客晚争鸣。\n青衫肯为琵琶湿，笑向天涯看月明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":571,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"惊蛰日雷","author":"仇远","text":"坤宫半夜一声雷，蛰户花房晓已开。\n野阔风高吹烛灭，电明雨急打窗来。\n顿然草木精神别，自是寒暄气候催。\n惟有石龟并木雁，守株不动任春回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":572,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"授时历以丁未为一岁 其一","author":"仇远","text":"仇山村叟始生辰，六帙平头又见春。\n检历今年交一岁，乘槎有日到三神。\n文章翰墨聊从好，富贵功名莫认真。\n且醉市桥新熟酒，红梅花插白纶巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":573,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"授时历以丁未为一岁 其二","author":"仇远","text":"一从妻子累心身，役役劳劳春复春。\n苦被长贫难择禄，宁甘渐老不如人。\n广文冷坐非无饭，张翰思归岂为莼。\n莫问当初弧矢事，祗今笔砚亦生尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":574,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"敝车","author":"仇远","text":"汝自骑高马，予宁坐敝车。\n功名输俊茂，天地著迂疏。\n漫说痴人梦，仍看后世书。\n谪仙酒楼在，不醉欲何如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":575,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晦日携幼湖上","author":"仇远","text":"葛岭苏堤昼寂然，东风吹我过湖船。\n江山信美无人会，儿女情多只自怜。\n柳色染匀春淡荡，杨花落尽日暄妍。\n麦秋天气浑如此，却笑征衫未脱绵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":576,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梦得墨四片一差短戏呈廷玉","author":"仇远","text":"昔贤曾梦笔，梦墨定何如。\n应使山中隐，重研世上书。\n磨人惊老大，饮汁笑空疏。\n长短无庸较，三螺已有馀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":577,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"移床诗","author":"仇远","text":"莞簟轻轻卷，藤床故故移。\n暑尘无避处，客舍有凉时。\n开帐迎风易，钩帘看雨宜。\n绿阴更清绝，旧竹长新枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":578,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"萧饶州见寄次韵","author":"仇远","text":"夜来听雨梦仇溪，梦觉招邀客赋诗。\n我自不分官冷热，子须能别酒淳漓。\n江头风顺鲈鱼到，天外春归杜宇知。\n十日菊花元不减，恰如六月见蒲葵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":579,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蛇山","author":"仇远","text":"閒寻石涧列云扉，树影生凉怯苧衣。\n静碧轩窗聊寄傲，软红尘土竟忘归。\n满倾竹叶春霞滑，轻折蕉花晓露晞。\n禅意法乘俱莫问，且谈旧事更依依。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":580,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪花","author":"仇远","text":"仙人初剪水，欲下复迟迟。\n半夜忽自落，东风竟不知。\n无香黏客袖，有意补春枝。\n却忆江南柳，飘绵送子时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":581,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪晴","author":"仇远","text":"腊尾春头半月期，寒欺人日雪销迟。\n才升晴旭扶桑树，便拂东风细柳枝。\n和气满城真可掬，丰年击壤已先知。\n侏儒温饱皇天赐，行续中和乐职诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":582,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄渚舟中 其一","author":"仇远","text":"夕晴殊可喜，小作川原游。\n水岸菰蒋合，野田鸿雁留。\n云烟易得晚，城市那知秋。\n落叶塞破屋，逃亡令我愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":583,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜晴","author":"仇远","text":"新岁连朝喜遇晴，宜人宜谷最关情。\n郊原尚觉春光薄，市井先传米价平。\n趁暖飞虫生灭易，向阳征雁去留轻。\n北门冷掾无公事，閒看官梅野柳争。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":584,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜晴复雨","author":"仇远","text":"早起方誇甲子晴，夜分忽又似盆倾。\n黑云冉冉连灯暗，白浪滔滔与岸平。\n芹未出泥先有燕，花都委地尚无莺。\n东桥沙觜多舟楫，直下荆溪不待撑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":585,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓舍在青安门外由是出郊不数里群山献状如游龙如奔马如踞虎豹深秀坡陀不一而足似有招引赋诗之意遂约子野再用韵 其二","author":"仇远","text":"山列瑶簪束不齐，过云舒卷树高低。\n孟郊李白曾行处，泰华琅琊尽向西。\n瘦马自穿幽径去，老莺犹恋落花啼。\n岂无崖壁平如削，留与诗人醉墨题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":586,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓舍在青安门外由是出郊不数里群山献状如游龙如奔马如踞虎豹深秀坡陀不一而足似有招引赋诗之意遂约子野再用韵 其一","author":"仇远","text":"西望宽平倦眼开，风收云翳扫烟埃。\n谁能白日捲帘坐，尽看青山排闼来。\n合沓断冈如引蔓，盘陀大石不生苔。\n此中林壑多仙迹，何必吹箫更楚台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":587,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"棕庄","author":"仇远","text":"幽径秋阴合，青渠草色深。\n肯教木叶落，直见夕阳沉。\n独客逢来雁，新寒集远砧。\n芙蓉花似锦，有意媚高林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":588,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"渡越","author":"仇远","text":"苍烟迷古道，白水满平畴。\n落雁湘湖月，孤砧粤树秋。\n壮心消蜡屐，老泪入貂裘。\n市饮成凄断，何人识马周。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":589,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游士","author":"仇远","text":"游士登门索裹粮，尘埃冉冉化衣裳。\n老夫也自饭不饱，童子聊沽酒共尝。\n彼此身谋宁枉道，古今乐事是归乡。\n家徒四壁侯千户，梦里谁能较短长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":590,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游天竺二首 其二","author":"仇远","text":"登览欣逢胜日闲，苍松九里费跻攀。\n行过绿水尽头路，步入白云生处山。\n猿鸟尚能知异境，仙凡原不隔重关。\n几时拂袖逃尘网，野衲村樵共往还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":591,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游天竺二首 其一","author":"仇远","text":"行遍山巅又水涯，尚无红叶与黄花。\n长松夹道六七里，小墅通村十数家。\n竺国云深僧寂寞，草堂洞古石嵯牙。\n野翁共醉官垆酒，扶醉归来已暮鸦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":592,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游智果寺","author":"仇远","text":"独径苍苔引瘦筇，墙阴修竹碧玲珑。\n青山犹见及坡老，小雨何须问社公。\n云冷石藏烹茗雪，日长门掩落花风。\n定知神扈题梁字，不与当时劫火同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":593,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖上","author":"仇远","text":"岚雾濛濛晓未收，青红窗户失飞楼。\n雨添芳草侵官道，水涨浮萍入御舟。\n苏小只传身后曲，江淹曾赋别时愁。\n杏花风急清明近，已觉新寒似麦秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":594,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖上值雨","author":"仇远","text":"波痕新绿草新青，有约寻芳芳不晴。\n莎径泥深双燕湿，柳桥烟淡一莺鸣。\n山围故苑春常锁，泉落低畦暖未耕。\n十载旧踪时入梦，画船多处看倾城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":595,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"窗外梅方开","author":"仇远","text":"淡月江南树，香奇影亦奇。\n春前十二月，雪后两三枝。\n冷蕊疏堪数，孤根稳不移。\n西湖老仙宅，清梦夜何其。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":596,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答赵源仲","author":"仇远","text":"人到中年万事慵，我今况是六旬翁。\n归心已薄西湖水，馀力重修古泮宫。\n官里简书尤可畏，案头笔砚岂无功。\n迩来士习殊轻峭，愿与醇儒振义风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":597,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答徐恕宣城寄别","author":"仇远","text":"怀古潸然老泪流，依稀见月喘吴牛。\n客乡时序留如燕，学舍风波小似舟。\n已恨浮云无巧夕，未知后月可中秋。\n徐卿忽寄新诗札，正倚双溪叠嶂楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":598,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"董静传挂冠四圣观","author":"仇远","text":"静挼秋渌洗荷衣，问隐孤山只鹤随。\n得酒可谋千日醉，挂冠犹恨十年迟。\n云和家有仙人谱，石鼎今无道士诗。\n莫对梅花谈世事，此花曾见太平时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":599,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赏桂","author":"仇远","text":"秋来常为桂花忙，叶叶西风粟粟凉。\n奎甫宅中开四树，儒珍园后粲孤芳。\n小山招隐人空老，朗月当庭影亦香。\n可必明年能赏得，一觞且醉此花旁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":600,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"道场山","author":"仇远","text":"山行龟背路羊肠，伏虎禅师古道场。\n老木阴中安御座，白云堆里抚僧床。\n勺泉清澈涵秋味，尖塔孤撑界夕阳。\n笑月亭空人影散，松风和雨动天簧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":601,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雁","author":"仇远","text":"四郊皆积水，鸣雁一何多。\n随处沙头宿，常时月下过。\n弟兄求口食，羁旅困风波。\n寄语支更者，芦深有网罗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":602,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雁去","author":"仇远","text":"离群野雁在中庭，驯养经年羽翼成。\n因为哀鸣殊可念，岂知飞去太无情。\n天阴月黑多机阱，岁晚山空少弟兄。\n愿尔水田常饱煖，春风早问北归程。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":603,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"集虚书院","author":"仇远","text":"筑室东皋野水滨，室中生白坐生春。\n了知空洞元无物，须信清明自有神。\n幽径草花聊适趣，閒窗笔砚不留尘。\n酒经丹诀非吾事，万卷书藏一老身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":604,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鲁庵尊师以彝斋白描四芗命作韵语","author":"仇远","text":"淡墨英英妙写真，一花一叶一精神。\n繁香曾入庐山梦，遗佩如行湘水春。\n小白凝珠还胜雪，轻黄承袜不生尘。\n老僧懒作浮华想，空谷犹疑见似人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":605,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黑兔","author":"仇远","text":"何年偷舐玄霜鼎，变却蟾宫玉雪姿。\n毛颖未封先试墨，褐衣乍著便披缁。\n移来旸谷乌相对，跃入阴山鬼不知。\n踪迹分明予甚爱，正当秋晓月明时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":606,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"廉公子家藏元石名武夷春雨","author":"仇远","text":"至宝忽横道，峰峦高复低。\n数尖灵壁石，一曲武夷溪。\n黛色春浮玉，黄流雨曳泥。\n遥知千载下，名与岘山齐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":607,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"新秋","author":"仇远","text":"双星方卜夜，载宿已交秋。\n未觉炎凉改，先为草木忧。\n雁来催燕去，火老让金柔。\n阮籍知何事，江东尚滞留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":608,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"跨马","author":"仇远","text":"跨马入城去，驱鸡上屋飞。\n閒官差可乐，徒步未为非。\n杜老平明出，山公倒载归。\n晚汀沙水阔，野鹜得相依。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":609,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"遣意 其二","author":"仇远","text":"抖擞老精神，飘蓬又一春。\n敢言惟有我，每恨不如人。\n文字须称韵，功名莫认真。\n青铜杖头在，留与买乌薪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":610,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"遣意 其一","author":"仇远","text":"衮衮岁年晚，冥冥车马尘。\n饥乌方畏雪，冻草已矜春。\n乡老知谁健，儒官自古贫。\n明朝除夜近，市井悄无人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":611,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"遣意 其三","author":"仇远","text":"宦游今倦矣，岁晚意何如。\n腊雪不到地，春风先满闾。\n邻翁寒乞炭，溪女晓供鱼。\n多有梅花处，吾将卜隐居。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":612,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦城方天瑞玄英先生后人得白云山居图彷佛桐庐山中隐所钱舜举真迹别有一种风致漫系以诗","author":"仇远","text":"翼翼山千朵，萧萧屋数间。\n石崖不可度，门径几曾关。\n绿树经秋在，白云终日閒。\n依稀镜湖曲，西岛水回环。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":613,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鼓角","author":"仇远","text":"五更相次晓，一曲有馀清。\n忽醒山林梦，遥闻鼓角声。\n背风还迤逦，带月最分明。\n莫作边城看，长淮久息兵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":614,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"韶华","author":"仇远","text":"韶华已如此，冉冉积芳尘。\n石润先知雨，山浓浑是春。\n钓鱼临积水，隔柳见行人。\n应有忘归者，扁舟采白蘋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":615,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潦雨排闷二首 其二","author":"仇远","text":"宿雨涨溪流，江南四月秋。\n市无粮得粜，田有麦难收。\n官况全然冷，民饥绝可忧。\n沙鸥应笑我，何日放归舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":616,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潦雨排闷二首 其一","author":"仇远","text":"淫雨喧中夜，羁人积隐忧。\n葵倾那有日，麦腐欲无秋。\n小市浑如洗，前溪漫不流。\n林鸠兼垤鹳，聒聒几时休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":617,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潮","author":"仇远","text":"一痕初见海门生，顷刻长驱作怒声。\n万马突围天鼓碎，六鳌覆背雪山倾。\n远朝魏阙心犹在，直上严滩势始平。\n寄语吴儿休踏浪，天吴罔象正纵横。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":618,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉闻杜宇","author":"仇远","text":"几日冥迷醉梦中，醒来衣袖裹春风。\n杜鹃未歇鸟声碎，芍药已开花信空。\n差胜跨驴愁杜老，尽教骑马笑山公。\n卑官安得金貂换，尚有杖头三百铜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":619,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉闻杜宇","author":"仇远","text":"家家酒似池，日日醉如泥。\n海燕聊为客，杜鹃何苦啼。\n狂那知帽落，归不为花迷。\n信笔成诗句，苔笺小草题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":620,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌三首 其三","author":"仇远","text":"清狂歌窈窕，微醉困瞢腾。\n酒薄多疑水，官閒一似僧。\n已知灯即火，不愿谷为陵。\n百事俱能了，惟馀饮未能。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":621,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌三首 其二","author":"仇远","text":"客居真易过，凡事不如仪。\n惟有閒寻睡，浑无趣作诗。\n晚晴行数步，日午酌三卮。\n系马庭阶下，人多借去骑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":622,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌三首 其一","author":"仇远","text":"金渊醇酒贱，足可醉亡何。\n日觉醒时少，其如饮不多。\n人生间调笑，俗事暗消磨。\n此意神仙会，山童亦解歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":623,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"镇海亭","author":"仇远","text":"海塘三十里，此屋独巍然。\n有浪方知水，无云总是天。\n苔痕封石柱，帆影下楼船。\n閒忆童男女，悠悠去几年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":624,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题小阁","author":"仇远","text":"斲窗黏纸著方床，四面虚明取向阳。\n毡席坐来终日暖，皮帘揭动北风凉。\n挂瓶水满梅花活，折鼎汤鸣芋子香。\n布被蒙头昼眠熟，不知门外雪洋洋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":625,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]