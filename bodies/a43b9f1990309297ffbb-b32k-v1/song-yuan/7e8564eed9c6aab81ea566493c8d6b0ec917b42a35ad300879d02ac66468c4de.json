[{"title":"野步十首 其五","author":"陈普","text":"白日长绳难系，青帘浊酒堪赊。\n归鹤苍山云际，故人锦字天涯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7737,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"野步十首 其四","author":"陈普","text":"愁思冥鸿杳杳，吟情败叶纷纷。\n归去满身溪雨，醉眠半枕山云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7738,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"野步十首 其三","author":"陈普","text":"黄犊眼中荒草，鹭鸶立处枯荷。\n宦海风涛舟楫，故山烟雨松萝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7739,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"野步十首 其二","author":"陈普","text":"潇洒枯藤老屦，行行只复行行。\n泥路野人屐迹，石桥流水琴声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7740,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"野步十首 其一","author":"陈普","text":"南雁数声嘹唳，西风双鬓䰐鬖。\n病叶夕阳满树，断云残雨归岩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7741,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠南丰姚敬仲","author":"陈普","text":"孔门缧绁可妻，董生孝慈有翁。\n天与仲尼不恕，人间处处流通。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7742,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冲虚观","author":"单县君","text":"雄峰峻峙焕朱明，元圣清虚此耀真。\n地静无心閒日月，山高举首近星辰。\n金坛露冷青鸾舞，丹灶风清白鹤驯。\n时有仙人绿云上，九霄飘忽响韶钧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7743,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄逍遥子","author":"郑玠","text":"自从夫子仙山去，闻说山中分外清。\n半夜洞天松月白，野猿吟和读书声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7744,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"葛仙行祠","author":"郑玠","text":"身为俗吏趋行部，手爇名香祝有年。\n五色雀飞应荐祉，七星松古自通仙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7745,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初至罗浮","author":"郑玠","text":"长说罗浮欲到难，清游今作字民官。\n分明蓬岛三山色，占得飞云六月寒。\n宝轴几函青贝叶，玉兰无限碧琅玕。\n此来更拟询遗事，记与灵踪石上看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7746,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丹灶","author":"郑玠","text":"灵迹曾传葛稚川，至今丹灶尚依然。\n谁云碧海三山岛，别是朱明一洞天。\n龙出玉京成往事，鹤来华表是何年。\n尘埃勿叹空回首，到得仙山亦有缘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7747,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白云庵","author":"郑玠","text":"罗浮山头老松树，中夜长吟送风雨。\n病夫幽独枕书眠，静听松声默无语。\n壁间画像对书灯，耿耿残油下饥鼠。\n梦觉跏趺不成寐，要伴禅和听二鼓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7748,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观源洞","author":"郑玠","text":"麻姑峰头黄鹤归，稚川灶上丹霞栖。\n寒猿啸木山月白，正是仙人朝斗时。\n壶天景象何灵杳，松门石径茸芳草。\n落花满院香沈沈，缘似刘郎应解到。\n碧溪数声连暮钟，梦回已觉松窗晓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7749,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潮阳东山","author":"郑玠","text":"暮天凉雨急霏霏，十二巫峰高复低。\n醉魂不受风飘断，只恐行云自湿衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7750,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"卞和泣玉图","author":"郑思肖","text":"大璞中函天地精，卞和抱出愈分明。\n一番刖足一番哭，哭杀世人无眼睛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7751,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"巴山橘中图","author":"郑思肖","text":"剖破浑沦一壳宽，二仙飞去已云端。\n须知橘里封疆别，莫作凡间胜负看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7752,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"车武子聚萤读书图","author":"郑思肖","text":"武子耽书不暂忘，练囊终夜照凄凉。\n读来读去东方白，笑杀流萤数点光。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7753,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"毕卓瓮间图","author":"郑思肖","text":"醉玉颓来欲化仙，一洼和气蔼芳妍。\n终宵自向华胥去，吏部何曾瓮下眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7754,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"伯牙绝弦图","author":"郑思肖","text":"终不求人更赏音，只当仰面看山林。\n一双閒手无聊赖，满地斜阳是此心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7755,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"伯乐相马图","author":"郑思肖","text":"冀地群中不可留，如龙走地绝无俦。\n何劳伯乐一相顾，抹过西风数百州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7756,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"补梦中所作","author":"郑思肖","text":"鸿雁流离梦亦惊，满怀凄怨足秋声。\n此身不死胡儿手，留与君王取太平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7757,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五忠咏 制置李公","author":"郑思肖","text":"举家自杀尽忠臣，面仰青天哭断声。\n听得北人歌里唱，潭州城是铁州城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7758,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日登城","author":"郑思肖","text":"城头啼鸟隔花鸣，城外游人傍水行。\n遥认孤帆何处去，柳塘烟重不分明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7759,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"逋仙探梅图","author":"郑思肖","text":"雪压咸平处士家，冻云锁暝苦相遮。\n欲知天上春消息，只觅南枝第一花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7760,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"巢父洗耳图","author":"郑思肖","text":"万事喧喧杂响中，细参巢父意无穷。\n须还半掬溪边水，方始教君耳不聋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7761,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五忠咏 察使姜公","author":"郑思肖","text":"杀气盘空白昼阴，始终不变似精金。\n直疑碧落三更月，来作将军一片心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7762,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画菊","author":"郑思肖","text":"花开不并百花丛，独立疏篱趣未穷。\n宁可枝头抱香死，何曾吹堕北风中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7763,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八砺三首 其三","author":"郑思肖","text":"愤气填膺奈若何，千生万死不消磨。\n夷齐道丧纲常坏，汤武兵兴叛逆多。\n天外游心穷碧落，风前注目寄苍波。\n此时此意那容说，环顾斜阳一浩歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7764,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八砺三首 其二","author":"郑思肖","text":"生得贞心铁石坚，肯将识见与时迁。\n泪如江水流成海，恨似山峰插入天。\n慷慨歌声闻屋外，婆娑剑影落灯前。\n篇篇字字皆盟誓，莫作空言只浪传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7765,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八砺三首 其一","author":"郑思肖","text":"黄道霾阴昼蚀光，野浮冤气白冥茫。\n世无圣主天应哭，时有忠臣国不亡。\n万刃攒身终莫变，一诚铭骨岂能忘。\n休嫌重复叨叨说，未奏肤公正断肠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7766,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哀刘将军","author":"郑思肖","text":"万重围里脱兵氛，匹马勤王志不分。\n既抱忠贞仇敌国，莫于成败议将军。\n身前名照江南月，地下心衔塞北云。\n为痛英雄并消没，托诗为史笔传闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7767,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送友人归","author":"郑思肖","text":"年高雪满簪，唤渡浙江浔。\n花落一杯酒，月明千里心。\n凤凰身宇宙，麋鹿性山林。\n别后空回首，冥冥烟树深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7768,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"德祐二年岁旦二首 其一","author":"郑思肖","text":"力不胜于胆，逢人空泪垂。\n一心中国梦，万古下泉诗。\n日近望犹见，天高问岂知。\n朝朝向南拜，愿睹汉旌旗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7769,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"德祐二年岁旦二首 其二","author":"郑思肖","text":"有怀长不释，一语一酸辛。\n此地暂胡马，终身只宋民。\n读书成底事，报国是何人。\n耻见干戈里，荒城梅又春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7770,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北望","author":"郑思肖","text":"紫塞风高直北秋，黄河水自向东流。\n穆王御马还宫日，海内封疆只属周。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7771,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"别故人","author":"郑思肖","text":"拍马又登程，馀酣尚未醒。\n曙蟾消淡白，秋汉覆空青。\n江走游龙势，山蟠睡虎形。\n飘零毋感叹，天地亦浮萍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7772,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"爱竹歌","author":"郑思肖","text":"此君气节极伟特，令人爱之舍不得。\n遍造山水有竹处，不问主人识不识。\n朝朝暮暮看不足，感得碧光透双目。\n一旦心空忽归去，挺身特立化为玉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7773,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"避暑入古寺","author":"郑思肖","text":"避暑入古寺，暂尔遣骚屑。\n心静凉于秋，倏然适清悦。\n彼哉谁氏子，对弈气争杰。\n惜其二低手，彼此蔑奇著。\n旁观发冷笑，连呼错错错。\n救之不可及，流视入寥廓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7774,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"餐菊花歌","author":"郑思肖","text":"道人四时花为粮，骨生灵气身吐香。\n闻到菊花大欢喜，拍手歌笑频颠狂。\n忆昔我为混沌王，洞见末劫寿不长。\n尽召群仙列殿下，敕宣餐菊长生方。\n我今化身游下土，一嚼清凉彻肺腑。\n顿令心地豁然开，迸出明珠耀今古。\n普入变化妙如意，能为一切主中主。\n尘尘刹刹黄金身，永救娑婆众生苦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7775,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书扇二首 其一","author":"赵文","text":"明月何时掇，秋风几日还。\n若教人不热，敢怨我长闲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7776,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太真入宫图二首 其二","author":"赵文","text":"夹道千花护綵云，三郎马上不胜情。\n谁知绣幰深深许，中有渔阳百万兵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7777,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太真入宫图二首 其一","author":"赵文","text":"未舞霓裳宝髻斜，流苏帐里再盘鸦。\n君王细看春风面，终是香云减一些。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7778,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东兴铺二首 其二","author":"赵文","text":"老老堂前寿酒杯，乡人曾羡锦衣回。\n那知此日还乡处，剩有东轩长老来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7779,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东兴铺二首 其一","author":"赵文","text":"老人无泪与君啼，梦里相逢路竟迷。\n二十三年崇胜寺，对床今夜是江西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7780,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十四日大雪上信国公冢 其四","author":"赵文","text":"十年目与肠俱断，不见延平病雁回。\n若不从公天上去，定应随我雪中来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7781,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十四日大雪上信国公冢 其一","author":"赵文","text":"哭得愁云转不晴，山风吹泪欲成冰。\n两年不过西州路，今日来登下马陵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7782,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十四日大雪上信国公冢 其二","author":"赵文","text":"气概堂堂压九州，谁知零落此荒丘。\n却烦野老编松叶，怕有牛羊上冢头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7783,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十四日大雪上信国公冢 其三","author":"赵文","text":"共出长汀恰此朝，荒山露宿草萧萧。\n如今踏雪来看冢，回首当时未寂寥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7784,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"禾川归途","author":"赵文","text":"天亦寒痴日易曛，客情黯黯似春云。\n不知细雨止还作，自倚篮舆看水纹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7785,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"伤逝三首 其三","author":"赵文","text":"老去真无泪可挥，断肠三十八年非。\n忍看乳者携孙揖，怕见亲情别柩归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7786,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"伤逝三首 其二","author":"赵文","text":"老人不哭自销魂，况复长号病眼昏。\n终日哭声那可听，一声声有一般言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7787,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"伤逝三首 其一","author":"赵文","text":"昨日相扶尚自存，今朝痛哭奠清尊。\n如何一夜音容隔，便有纷纷说梦魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7788,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"朱湖","author":"赵文","text":"高低榉柳绿如苔，三两柴门傍竹开。\n此处定无人挟弹，青青乳燕出溪来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7789,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"灯前咏诗","author":"赵文","text":"青春苦留不肯住，白发不招还自来。\n闲看灯前写诗手，百年端是窖中埃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7790,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹枝词 其一","author":"赵文","text":"终日望君君不来，为谁犹住郁孤台。\n幸自一年无梦到，谁教昨日有书回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7791,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"两峰睡觉","author":"赵文","text":"宿酒初醒唤梦回，起来诗句暗敲推。\n山童熟睡呼不应，枥马龁刍风雨来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7792,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听儿童歌船作竹枝助之","author":"赵文","text":"田舍儿童走似獐，踏歌椎鼓斗颠狂。\n元宵乞汝闲几日，元宵过后种田忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7793,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张司空庙","author":"赵文","text":"式乾殿久化烟埃，忠壮祠犹立水隈。\n当日早如龙剑逝，免将分拆累三台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7794,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昔年二首 其二","author":"赵文","text":"少年如此已成枯，我亦重来白鬓须。\n正使冥冥有知识，不知还认阿兄无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7795,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昔年二首 其一","author":"赵文","text":"昔年携汝赴闽京，此日深儿尚未生。\n今日携儿收叔骨，一如当日共伊行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7796,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其三","author":"赵文","text":"平生二老最怜君，今日相随在九京。\n汝得从亲吾孑立，不知谁死复谁生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7797,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其五","author":"赵文","text":"说与辽东丁令威，天长海阔不须归。\n中郎便有重还日，肠断生妻已去帏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7798,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其四","author":"赵文","text":"如此情钟少梦君，绝疑魂断已无魂。\n新兴道士传消息，知共乘云玉帝门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7799,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其八","author":"赵文","text":"怕看杜老怀观颖，厌见东坡说子由。\n每读渠诗先掩卷，旁人怪我泪双流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7800,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其一","author":"赵文","text":"自出延平十八年，年年谁与酹荒阡。\n若为化得衰翁骨，去作圹中三百砖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7801,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其二","author":"赵文","text":"舜卿墓表屹东禅，却恐如今不得全。\n崇胜山中一堆土，故应汝骨尚依然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7802,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其七","author":"赵文","text":"妻子相宽亦偶然，老人何用许悲煎。\n沉忧若解令人死，何至相疏十八年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7803,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其六","author":"赵文","text":"十八年来老眼枯，只今白尽旧髭须。\n假饶梦里重相遇，知汝犹能认我无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7804,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗九首托南剑刘教寻亦周墓焚之 其九","author":"赵文","text":"刺血题诗寄阿侬，断肠五十五衰翁。\n此诗到是衰翁到，此血由来与汝同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7805,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨后","author":"赵文","text":"雨后临池草色浮，小楼欲上又还休。\n儿童问我悲何事，忽见山茶长一头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7806,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春风高","author":"赵文","text":"报楚彊吴一世豪，属镂夜赐竟徒劳。\n繁华极处能回首，惟有春风第一高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7807,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]