[{"title":"西湖访古","author":"白珽","text":"隐约湖山一点青，秋风归去阻云程。\n贝宫珠阙无寻处，夜夜凌波哭月明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4190,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过东寺","author":"白珽","text":"倚空楼阁竞翚飞，铁凤金铃一望齐。\n多少流民无片瓦，江南四月雨凄凄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4191,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"积雪峰访梁道士","author":"白珽","text":"惊羽穿林看细碎，健舆绕石听攲斜。\n道人住近茅峰北，一簇楼台五色霞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4192,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其八","author":"白珽","text":"八珍殽龙凤，此出龙凤外。\n荔枝配江䖴，徒誇有风味。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4193,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其五","author":"白珽","text":"西狩获白麟，至死意不吐。\n代北有角端，能通诸国语。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4194,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其三","author":"白珽","text":"谁令珠玉唾，出彼藜藿肠。\n仁人不为宝，良贾宜深藏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4195,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其九","author":"白珽","text":"滦人薪巨松，童山八百里。\n世无奚超勇，惆怅渡易水。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4196,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其二","author":"白珽","text":"草食押不芦，虽死元不死。\n未见涤肠人，先闻弃箦子。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4197,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其七","author":"白珽","text":"羯尾大如斛，坚车载不起。\n此以不掉灭，彼以不掉死。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4198,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其四","author":"白珽","text":"婴啼闻木枝，羝乳见茅茹。\n何如百年身，反尔无根据。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4199,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其一","author":"白珽","text":"海青羽中虎，燕燕能制之。\n小隙沈大舟，关尹不吾欺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4200,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其十","author":"白珽","text":"两驼侍雪立，终日饥不起。\n一觉沙日黄，肉屏那足拟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4201,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续演雅十诗 其六","author":"白珽","text":"才脱海鹤啄，已登方物舆。\n仰面勿啾啾，我长非侨如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4202,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其七","author":"白珽","text":"车鱼人散水风腥，雨色凉分柳外晴。\n回首夕阳都落尽，忽然东向数峰明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4203,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其八","author":"白珽","text":"万树芙蓉两蕊宫，秋风开遍水边丛。\n白墙遮尽红墙出，只见红墙一半红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4204,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其六","author":"白珽","text":"三贤犹得仰高风，冠服虽殊气味同。\n后五百年无继者，桃花含笑夕阳中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4205,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其五","author":"白珽","text":"雨后林塘夏亦秋，一葫芦酒在船头。\n醉来深入荷花去，卧看青天飞白鸥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4206,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其四","author":"白珽","text":"相国平泉水竹居，吴山花石世间无。\n游人马上休回首，一半春风在里湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4207,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其三","author":"白珽","text":"龙舟晓发断桥西，别有轻舟两两随。\n春色可人晴较稳，酒家争出柳梢旗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4208,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其二","author":"白珽","text":"脉脉吹香屋角梅，背风移烛小帘开。\n凤城几日元宵近，一片箫声水上来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4209,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖居杂兴八首 其一","author":"白珽","text":"御舟初出赏春霏，传是诸王与后妃。\n香雾渐深帘幕暗，日斜微见淡黄衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4210,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"翔泳堂酒边","author":"白珽","text":"瑰辞度得雪儿歌，浓墨斜书碧玉柯。\n醉折芙蓉薰酒盏，里湖凉似外湖多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4211,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题江贯道百牛图","author":"白珽","text":"几年散放桃林后，馀四百蹄犹可骑。\n揽镜挂书多自在，能骑惟有一凝之。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4212,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题龚翠岩中山出游图","author":"白珽","text":"何处张弧鬼一车，中山曾见夜蒐图。\n纷纷眼底朱成碧，后乘钟家有此姝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4213,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题碧桃折枝","author":"白珽","text":"玄都千树欲无枝，全得春风烂漫吹。\n晓露未晞红郁郁，仙源长在日迟迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4214,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山中怀友","author":"白珽","text":"几年音问绝，此夕更关情。\n寒雨人孤坐，残灯雁一声。\n干戈犹故国，贫病自空城。\n惟有琴堪诉，愁深弹不成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4215,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉清宫与赵达夫鲜于枢联句二首 其二","author":"白珽","text":"巾子峰头舣钓船，初阳台上坐鸣弦。\n出云高树明残日，过雨苍苔泫细泉。\n绝俗谁能继遐躅，凌空我欲学飞仙。\n还家正恐乡人问，化鹤重来知几年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4216,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吊林处士墓","author":"白珽","text":"千古西湖见一贤，断碑犹在草芊芊。\n人间岂少题梅者，石上谁来酹菊泉。\n陈柏墓门疑是宅，唐衣庙貌望如仙。\n可怜辽鹤无消息，寂寞春风二百年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4217,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹阴","author":"白珽","text":"占断人间潇洒地，全身水墨画筼筜。\n非烟非雾一林碧，似雨似晴三径凉。\n翠袖佳人黯空谷，白髭道士隐南塘。\n数竿醉日君须记，移向西窗补夕阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4218,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"馀杭四月","author":"白珽","text":"四月馀杭道，一晴生意繁。\n朱樱青豆酒，绿草白鹅村。\n水满船头滑，风轻袖影翻。\n几家蚕事动，寂寂昼关门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4219,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"灵隐寺暮归","author":"白珽","text":"山色晚苍苍，山门下夕阳。\n栴林飘槲叶，新月到禅床。\n径出千峰秀，亭回一涧长。\n淹留不可及，露湿薜衣裳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4220,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"净慈禅寺","author":"白珽","text":"奎额昭回龙屈盘，入门已觉厌尘寰。\n何当白发三千丈，来寄清风五百间。\n帝子釜摇金潋滟，家人卦剔翠孱颜。\n西湖日日船如织，半在南屏第一山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4221,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岳武穆精忠庙","author":"白珽","text":"国势已如此，孤忠天地知。\n死生同父子，奸宄系安危。\n偃月无封桧，栖霞有谥碑。\n中原遗老在，岁岁梦王师。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4222,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"河南妇","author":"白珽","text":"从军古云乐，获罪祷应难。\n母望明珠复，夫求破镜完。\n押衙逢义士，公主奉春官。\n为报河南妇，天刑不可干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4223,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日田园杂兴","author":"白珽","text":"雨后散幽步，村村社鼓鸣。\n阴晴虽不定，天地自分明。\n柳处风无力，蛙时水有声。\n几朝寒食近，吾事及躬耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4224,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日重过如镜上人房","author":"白珽","text":"忆昔敲门赋瑞筠，鹿园佳话又重新。\n屋头能拓三三径，林下知非陆陆人。\n凿沼何须晋康乐，种荪还忆楚灵均。\n老师鍊得心如镜，更把高台比月轮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4225,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酒边赠朱处士","author":"白珽","text":"乌葛唐巾白苧裘，扫庭终夕共淹留。\n醉中谈论心犹壮，老去歌欢泪亦流。\n对客呈诗如献佛，课儿收橘当封侯。\n明年好理西风棹，重约三吴烂漫游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4226,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿上天竺","author":"白珽","text":"名山倦游历，挂起手中藤。\n佛国三生石，天岩百岁僧。\n定回松院磬，吟苦雪龛灯。\n愧我心犹杂，何因问二乘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4227,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄天香庵恬上人","author":"白珽","text":"门掩天香竹树丛，了无尘翳此心同。\n东林社散图空在，南国山多梦不通。\n白草秋閒支遁马，黄沙春断子卿鸿。\n思君记得逢君处，一片归云海树空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4228,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清和","author":"白珽","text":"白苧渐相便，因知物候迁。\n空山一雨后，小槛绿阴前。\n莺在留春思，人幽减昼眠。\n此时风日好，元不似梅天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4229,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游宜兴张公洞","author":"白珽","text":"天开福地据雄尊，果老张公几代孙。\n一窍通天才直上，千崖转石已平吞。\n山头白鹤来无影，石上青骡去有痕。\n我欲放身如脱屣，仙凡一辙隔重阍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4230,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖楼玩雪","author":"白珽","text":"上湖十里捲帘中，幻出瑶华第一宫。\n山势蹴天银作浪，柳行扑地玉为虹。\n渔蓑鹤氅同为我，爵舌羊羔不负公。\n明日凤池朝退蚤，一鞭曾约试吟骢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4231,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题如镜净讲师房","author":"白珽","text":"娱老林房世路赊，尘埃飞不到袈裟。\n西湖草木虽同土，北寺烟霞自一家。\n静敞白间翻贝叶，閒输赤仄养椒花。\n鉴光炯炯辉今古，身后何须用五车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4232,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题苏东坡书楚颂并菩萨蛮满庭芳词卷后","author":"白珽","text":"南荒九死幸生还，种树书成手自删。\n赤壁梦难同楚颂，洞庭乐不减商山。\n人生堕地少如意，老子对天无愧颜。\n千古菟裘有遗恨，断圭残璧自人间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4233,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题松雪临郭河阳溪山渔乐图","author":"白珽","text":"远山近山何历历，下有长溪横一碧。\n溪中亦有钓鳌手，此手不遮长安目。\n野桥烟树接草庐，飞流如练悬空虚。\n截山白云凝不去，要人写作岩居图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4234,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题洞霄宫药圃","author":"白珽","text":"仙翁曾播植，琼圃尚敷荣。\n春日祥光满，秋风瑞实成。\n黄精宜益寿，萱草足忘情。\n候采灵芝服，还应羽翼生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4235,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题惠山","author":"白珽","text":"名山名刹大佳处，绀殿翠宇开云霞。\n陆羽乃事已千载，九龙诸峰元一家。\n雨前茶有如此水，月里树岂寻常花。\n奇奇怪怪心语口，无根拄杖任横斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4236,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠张知府周卿","author":"白珽","text":"人品中原说此翁，雄文直气耿心胸。\n几年天上张公子，今日云间陆士龙。\n来暮已闻歌五裤，平反何翅禄千钟。\n相从愧落诸公后，拭目西岩第一峰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4237,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠青龙任月山","author":"白珽","text":"倾盖相逢意已亲，风流儒雅迈同伦。\n曾来东阁观奇士，又向西湖见伟人。\n放棹小溪梅皪皪，敲棋深院烛燐燐。\n悬知后夜相怀切，帆落胥山月一轮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4238,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山居怀林处士","author":"白珽","text":"昔有林处士，结庐邻峰巅。\n年年不入城，梅花有佳联。\n童鹤三数口，负郭十亩田。\n弟侄列朝裾，咸平好时年。\n人品既已高，奉养常充然。\n嗟我何为者，日用买山钱。\n爱诗不能佳，未了区中缘。\n空有一寸心，羡杀处士贤。\n饱看贵人面，不若饥看天。\n搥床呼伯雅，且此相周旋。\n有田足几时，卓哉坡翁言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4239,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"击蛇笏","author":"白珽","text":"孔明庙前柏，手版贼其枝。\n枯秭无生气，众目炫一时。\n何如孔公笏，铁面含霜姿。\n虺蛇何足道，正气屡奸欺。\n祥符庆历间，岂无纤人斯。\n闻之胆为落，不在彼在兹。\n圣学亿万年，圣源浩无涯。\n八传得巨源，愤学求似之。\n遗经与遗物，保护如婴儿。\n万里去复远，见者咸赍咨。\n况此一尺槐，千载孔林思。\n非无原壤杖，非无少正铍。\n用舍各有时，小大各有施。\n畴能起段公，共赋甘棠诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4240,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同陈太博诸公登六和塔","author":"白珽","text":"龙山古化城，浮屠峙其巅。\n开殿生妙香，金碧森贝筵。\n应真俨若生，倒飞青金莲。\n头陀绀林丛，导我丹梯缘。\n初犹藉佛日，閟境鯈已玄。\n回头失谁何，叫啸衣相牵。\n且复忍须臾，当见快意天。\n娇儿诧先登，网户相钩连。\n炯若蚁在珠，九曲随盘旋。\n烂烂沧海开，落落云气悬。\n群峰可俯拾，背阅黄鹄骞。\n奇观兴懦夫，便欲凌飞仙。\n绝顶按坤维，始见南纪偏。\n神京渺何许，王气须停躔。\n舟车集百蛮，岛屿通人烟。\n一为帝王州，气压三大千。\n罡风洒毛发，铎语空蝉联。\n红红杏园花，愧乏慈恩篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4241,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冷泉亭","author":"白珽","text":"灵山本清净，一泉渟其中。\n灵山孤飞来，此水将无同。\n山影压不尽，照见天玲珑。\n分明千尺冰，不独疑寒虫。\n京洛多风尘，到此一洗空。\n炎寒无二心，凛有操者风。\n泊然守空梵，万劫岂终穷。\n骊山有温泉，虚筑华清宫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4242,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴季子墓","author":"白珽","text":"圣人如日月，下照无党私。\n藏珠与韫玉，所得自华滋。\n恭惟吴季子，夙禀明睿姿。\n近取子臧节，远绍泰伯基。\n两以大国让，廉风起蛮夷。\n观乐义已烛，挂剑心如饴。\n时方尚诈力，子独恪且祇。\n时方事寇攘，子独甘弃遗。\n孔子不到吴，闻风重赍咨。\n佳城介申浦，采地亦在兹。\n特书寄馀哀，岂不遐迩思。\n惋惋龙蛇翥，皎皎星日垂。\n禹世怀道义，取舍实系之。\n寄言邦之人，无但岘首悲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4243,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李翰林墓","author":"白珽","text":"出城得佳山，两峰特奇诡。\n一如植躬圭，一峰拱而侍。\n我见犹爱之，而况谪仙子。\n孤坟在其下，政尔直一死。\n谪仙真仙人，出处见诸史。\n岂敢傲吾君，辛苦植唐祀。\n嗟予侃侃者，尘土正如此。\n停车不忍发，载拜颡有泚。\n仰止青山高，清风与终始。\n孰谓千载人，不在天地里。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4244,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蛾眉亭","author":"白珽","text":"秦赭凿填石，不受鞭箠考。\n零落楚江浒，相峙矗三岛。\n穿松得细径，据一陵二小。\n奔流浩浩来，五色烂华藻。\n至宝地不惜，绝境天所造。\n谁言两蛾黛，功夺京兆巧。\n终朝对颦蹙，似为今古恼。\n然犀矶沉沉，跨鲸月皎皎。\n丝纶三千丈，蒙冲百万棹。\n天风吹过梦，多忧只空老。\n今者吾与子，所惬在幽讨。\n供帐莫匆匆，槃觞从草草。\n雅琴鼓一再，领此风日好。\n临崖发清啸，倚树或颠倒。\n礼存玉帛外，纵弛或一道。\n兴极不知归，白鸥破晴昊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4245,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王大令保母帖","author":"白珽","text":"大令书法美少年，玉函金籥随飞烟。\n累累一百又五字，岂意近出黄閍砖。\n字奇文古两超绝，保母从兹倾众帖。\n谁将瓦合嘲玉碎，一片孤衷本相接。\n快剑横斫铁山摧，戏龙猛蹴银河攲。\n方庭无月天地黑，仰视别有星离离。\n浪言贞石志千载，不及永和洼砚在。\n白石已仙千里死，千百人中几人爱。\n兰亭信美如捕风，贵耳贱目人响从。\n三日呕血饥搥胸，叶公画龙惧真龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4246,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题斩蛟桥","author":"白珽","text":"桓桓周将军，英烈照千祀。\n少年知自艾，成人不惜死。\n射虎南山下，斫潜北桥底。\n腾拿三日夜，洒血四十里。\n激波为岳立，挥刃电亦驶。\n想当批鳞初，见义不见水。\n及其立人朝，矫矫中不倚。\n文学既英发，武事复霆起。\n歼儿善丑正，甘作忠义鬼。\n至今有生气，耿耿耀青史。\n苏公百世豪，气味有相似。\n泊舟蛟川下，洗石题所以。\n平生疾恶意，十有二言里。\n丰碑刻祠宇，词翰晋二美。\n二美固足珍，吾取不在是。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4247,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郑子真画四季诗意 其一","author":"白珽","text":"红杏绿杨，永昼野服。\n柴门散仙，莫道无人。\n知处东风，都在吟笺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4248,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郑子真画四季诗意 其二","author":"白珽","text":"莲叶吹香，澹澹扁舟。\n撑港斜斜，惊散一行。\n白鹭西风，捲起梨花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4249,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"仙掌峰","author":"刘边","text":"铜盘捧露几何年，渭水秋风泪泫然。\n已向山中閒袖手，为谁半壁更擎天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4250,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉女峰","author":"刘边","text":"不作巫阳云雨羞，风鬟雾鬓乱萧飕。\n行人莫问当年事，独立寒潭空几秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4251,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"钓矶石","author":"刘边","text":"百尺台矶瞰碧流，紫阳仙子几经秋。\n游鱼何事偏深逝，不道人间有直钩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":4252,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]