[{"title":"咏史 周公","author":"陈普","text":"仲尼齿发正强时，夜夜神交似故知。\n话到子孙郊禘处，几回对榻共攒眉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7158,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 周亚夫","author":"陈普","text":"西来三十六将军，业业孤城势欲焚。\n细柳不逢豪杰主，当时已验口从文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7159,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 季札","author":"陈普","text":"鸑鷟无声皇极差，消磨人物百千家。\n姑苏无限骚人楚，不罪延陵罪浣沙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7160,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 审配","author":"陈普","text":"谋袁大似为曹谋，却道辛毗破冀州。\n五夜邺沟深二丈，袁公神武一时休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7161,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 审配","author":"陈普","text":"独拥残兵守邺城，伫儒袁尚去擒兄。\n一时天地方翻覆，安把人伦罪审荣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7162,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 陈宫","author":"陈普","text":"何物曾奴董太师，原陵青草正萋萋。\n一时翔集多知处，独恨公台不择栖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7163,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 沮授","author":"陈普","text":"袁曹相与隔王路，四世三公恩海深。\n当时惟有管宁是，谩对黄河叹此心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7164,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 尚父伯夷","author":"陈普","text":"春来秋叶在枯枝，底用端蓍更拂龟。\n二老东来元并辔，马前何害不相知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7165,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 屈原","author":"陈普","text":"仲尼死后百年期，定把离骚继四诗。\n占断江南烟雨绿，历山穷子与湘累。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7166,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 武帝","author":"陈普","text":"鼎食诸公尽鼎烹，闾阎豪杰剑纵横。\n帝王自击南山豕，惭愧端非听董生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7167,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 武帝","author":"陈普","text":"二十嫖姚风火飞，銮舆夜夜过焉支。\n茂陵不费凌云气，解见蟠桃著子时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7168,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其六 武帝","author":"陈普","text":"几多爱子出萧关，山积胡沙骨未还。\n好把望思台上泪，随风北去洒阴山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7169,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其七 武帝","author":"陈普","text":"文帝端能杀少翁，景皇不解斩常融。\n正心数语深加意，位在三皇五帝中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7170,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 武帝","author":"陈普","text":"生子曾知置齐鲁，自身却爱受何罗。\n六鳌不戴林光瑟，覆辙相寻似火蛾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7171,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其十 武帝","author":"陈普","text":"五十馀年四海波，建元三载尽征和。\n中央寸土才无血，沃日浇天瓠子河。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7172,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 武帝","author":"陈普","text":"商车不足算缗来，桑孔咸阳悉茂材。\n一撮茂陵无觅处，建章门户至今开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7173,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 武帝","author":"陈普","text":"先帝斋宫内弄儿，阿娇金屋篡歌姬。\n披香博士真才子，刘氏家传却未知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7174,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其八 武帝","author":"陈普","text":"起上林苑赏方朔，发会稽兵惜虎符。\n君侧此时三四辈，盍移东海换江都。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7175,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 河间献王","author":"陈普","text":"礼乐将兴汉德凉，活麟天把付锄商。\n周官千载埋黄壤，两汉如今几献王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7176,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 金日磾","author":"陈普","text":"牵马胡儿共拥昭，同功同德不同骄。\n麒麟阁上尘埃面，羞见芬芳七叶貂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7177,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 宣帝","author":"陈普","text":"不将法律作春秋，安得河南数国囚。\n莫道汉家杂王霸，十分商鞅半分周。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7178,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 宣帝","author":"陈普","text":"孝宣不召山阳守，痛在糟糠不下堂。\n家国莫先笞己子，汉人空识抱成王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7179,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 宣帝","author":"陈普","text":"使民澒澒哭韩杨，郡国纷纷上凤凰。\n太子好儒几坐废，王阳何用苦谈王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7180,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 宣帝","author":"陈普","text":"斗鸡走狗登皇极，览德毛从何许来。\n汉室欲开新室业，王阳分合守蒿莱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7181,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 战国","author":"陈普","text":"千秋万古定于一，岂有乾坤属虎狼。\n六印苏秦寿如石，山东终作一阿房。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7182,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 皇甫嵩","author":"陈普","text":"几多孟德总欺孤，底事山头独望夫。\n不听阎忠听梁衍，未应魏阙便当涂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7183,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 祢衡","author":"陈普","text":"铜雀罗纨涴汗青，芳洲鼓史骨如生。\n羯奴礌落若日月，大雅那堪祢正平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7184,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 荀息","author":"陈普","text":"三怨盈朝积不舒，奚齐卓子釜中鱼。\n区区荀叔若乳妪，智略无称信有馀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7185,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 赵充国","author":"陈普","text":"五万消磨作四千，羌人杀尽汉人全。\n并生虽愧征苗旅，比似嫖姚却大贤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7186,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 项羽","author":"陈普","text":"试手襄城意未怡，赤城稍觉味如饴。\n必亡定死终无救，断自朱殷海岱时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7187,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 项羽","author":"陈普","text":"枭性狼心亦有常，青齐仍复似咸阳。\n遗黎到处无馀类，欲为何人作霸王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7188,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 项羽","author":"陈普","text":"牧羊义帝实妨贤，犹有三纲共畏天。\n树楚击秦宜奋发，恶名何事苦争先。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7189,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 项羽","author":"陈普","text":"倚强恃力却诬天，一样人心万万年。\n广武十条逃得过，乌江政自不须船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7190,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 倪宽","author":"陈普","text":"亲媚张汤似谒居，阿谀天子过相如。\n汉儒个个公孙子，不坠遗经一仲舒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7191,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 夏后氏","author":"陈普","text":"执法庭坚亦太坚，两朝窃负总无缘。\n何人有子如崇伯，祓涤犁牛陟配天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7192,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 夏侯胜","author":"陈普","text":"夏葛冬裘事已殊，茂陵礼乐议何迂。\n去周未远真淳在，莫把公孙例汉儒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7193,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 晁错","author":"陈普","text":"谁人能夺伯氏邑，何德敢隳三子都。\n内史自侵汉家庙，未须削楚更衰吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7194,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 桓荣","author":"陈普","text":"明帝天姿可禹汤，周公不梦梦空王。\n当年紫绶金章客，何德何功坐太常。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7195,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 班超","author":"陈普","text":"三十六人抚西域，六头火炬走匈奴。\n古今参合坡头骨，尽是离披见鹘乌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7196,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 秦皇","author":"陈普","text":"江神返璧事何新，海若湘君亦伐秦。\n一炬东来烧不了，更劳墓上牧羊人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7197,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 秦皇","author":"陈普","text":"闵道飞翚拂若枝，东门看日浴咸池。\n生前有力移天地，死后无人予席帷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7198,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 袁绍","author":"陈普","text":"弟北兄南竞效尤，邺中半邺半青州。\n身分家裂无全理，终使辽东送二头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7199,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 袁绍","author":"陈普","text":"田丰袭许计非良，沮授安民策最长。\n己克百安牢按甲，足鞿曹操到分香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7200,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 袁绍","author":"陈普","text":"许中四面尽仇雠，曹弱袁强正是愁。\n一日四州都奉予，安闲犹遣定徐州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7201,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 贾生","author":"陈普","text":"落日长沙被鵩惊，愁来强把死生轻。\n洛阳才子何多涕，太息沾襟过一生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7202,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 贾生","author":"陈普","text":"衣绨英主首祠汾，他日燕齐尽羡门。\n玉漏声中闻底事，反将前席待新垣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7203,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 贾逵","author":"陈普","text":"经术何曾得暂行，汉家空有表章名。\n石渠但把雷霆压，焉用低帷凿壁生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7204,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 贾董","author":"陈普","text":"贾董声名甲汉儒，到头事业有差殊。\n五年大傅何飘忽，不告梁王肆夏趋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7205,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 商鞅","author":"陈普","text":"此天此地此经文，学者何尝溺所闻。\n尽道李斯焚典籍，不知吹火是商君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7206,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 曹参","author":"陈普","text":"人彘风腥起两宫，艾豭歌唱满秦中。\n酒壶不但容齐狱，时事方宜用盖公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7207,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 萧何","author":"陈普","text":"三人断尽楚关梁，一诎雄吞十七王。\n高帝功臣总功狗，汉家无爵赏萧张。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7208,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 萧张","author":"陈普","text":"晦迹功曹不受徵，兴亡事已若丹青。\n世间尽有文章客，谁信龙蛇尺蠖形。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7209,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 萧张","author":"陈普","text":"汉高礼义入陵夷，械到萧何更有谁。\n惟有子房云外客，不称名字冠当时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7210,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 萧望之","author":"陈普","text":"石显深持两世枢，尚书何苦恋中书。\n九原若遇韩延寿，祇共咨嗟叹两疏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7211,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 赧王","author":"陈普","text":"世历绵延四百秋，死蚿枯竹附诸侯。\n末年隆准生丰沛，谁道嬴秦是继周。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7212,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 彭宣","author":"陈普","text":"法度名儒奉束脩，帝师礼数亦宜优。\n公卿股慄朱云剑，白首门生忍不羞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7213,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 景帝","author":"陈普","text":"宗庙谁开内使门，临江依样又穿垣。\n爱妻娇子如泥土，晁错何知独恃恩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7214,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 景帝","author":"陈普","text":"赐帛宽租泽未休，四方缓急有条侯。\n馀威不赖刳蛇剑，仓卒谁枭老濞头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7215,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 董仲舒","author":"陈普","text":"孟轲死后惟董子，道义两言扩古今。\n性善七篇何落落，千秋不遇一知音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7216,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 董仲舒","author":"陈普","text":"鹤发东宫体孝文，明堂服色谩云云。\n力行到底终何似，不逮躬行万石君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7217,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 董仲舒","author":"陈普","text":"好古刘安岂逆俦，左吴枚赫满诸侯。\n仲舒到处皆狼虎，妥帖驯良独到头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7218,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 韩信","author":"陈普","text":"蹀血中原不用骄，论功何似禹乘橇。\n始终两汉无留葛，谁与尘编慰寂寥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7219,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 韩信","author":"陈普","text":"群龙共帝牧羊儿，缟素能开四百基。\n蒯彻亦生天地里，欲将口舌夺民彝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7220,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 韩信","author":"陈普","text":"良日登坛计策行，酸咸甘苦共杯羹。\n不须握手师陈豨，脩武高眠已合烹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7221,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 廉颇蔺相如","author":"陈普","text":"长年霜骨白皑皑，廉蔺羞颜似湿灰。\n白起杀心如未谢，二家随璧献章台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7222,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 楚元王交","author":"陈普","text":"荒芜新语不堪听，猛士凄凄北鄙声。\n楚醴不延风雅客，诗书犹未脱秦坑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7223,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 蒙恬","author":"陈普","text":"劈碎崤潼坼太行，才通腥鲍到咸阳。\n地后山灵思报德，故教蒙毅去辒辌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7224,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 管宁","author":"陈普","text":"中州白日虎狼嗥，越海鲸鲵更浪高。\n化日尺书归故里，依然逃董不逃曹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7225,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 臧洪","author":"陈普","text":"帝家安邑棘篱中，贼靡奸渠四面雄。\n汉士当时惟北海，一朝青史见臧洪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7226,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 蔡邕","author":"陈普","text":"万岁黄金欲散时，柯亭风笛尚堪吹。\n一时谋卓人无数，不遣中郎一个知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7227,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 蔡邕","author":"陈普","text":"不际明时论石渠，空将薄命仕鸿都。\n天公似把词人戏，父死然脐子坠胡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7228,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 豫让","author":"陈普","text":"三晋峥嵘虎战墟，中涓学语正坑儒。\n石家礼法从何出，甲乙诸郎尽鲤趋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7229,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 豫让","author":"陈普","text":"荀息无裨晋献公，豫生如许智宗空。\n古人才德难求备，大节初心要始终。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7230,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 豫让","author":"陈普","text":"几多砺节与轻生，犹有丝毫在利名。\n青史千年惟豫子，诚心大义最分明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7231,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 豫让","author":"陈普","text":"义士忠臣不二君，漆身吞炭欲成仁。\n若谋委质求亲幸，又抱奸心贼大伦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7232,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 霍光","author":"陈普","text":"井田学校竟终天，盐铁舟车讫万年。\n隔绝古今萧与霍，空劳孔壁出尘编。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7233,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]