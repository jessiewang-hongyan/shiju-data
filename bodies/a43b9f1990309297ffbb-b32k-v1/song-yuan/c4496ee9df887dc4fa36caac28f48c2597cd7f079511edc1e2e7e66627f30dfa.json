[{"title":"王古樵观予苦疮鄙句遂自赋眉遭二韵各二首因次其韵为戏 其二","author":"方一夔","text":"吾衰端不为蛾眉，不假霜铅补漏卮。\n无恙感君频寄语，不龟愧我未逢医。\n命穷渐退星临木，书误无凭病发梨。\n康济自身犹未辨，敢将苏息问民痍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9999,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王古樵观予苦疮鄙句遂自赋眉遭二韵各二首因次其韵为戏 其三","author":"方一夔","text":"无端痁疥适相遭，空苦无成似嚼螯。\n瘢疻着身犹刻画，垢腥满爪费爬搔。\n行吟谩想歌愁绝，坐食空惭饱老饕。\n偶见新诗还技痒，寒窗细字认牛毛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10000,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王古樵观予苦疮鄙句遂自赋眉遭二韵各二首因次其韵为戏 其四","author":"方一夔","text":"命灾况复与穷遭，真似蟛蜞缚两螯。\n鳞甲棱棱便净浴，发须种种快频搔。\n瓮头轑酒何妨醉，松下餐肪不厌饕。\n快写田家剜肉句，夜阑秃尽管城毛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10001,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"田家 其一","author":"方一夔","text":"近来不复应差科，生计无成奈老何。\n漆种十年虽恨晚，牛生百犊未嫌多。\n春耕着我扶犁手，社饮还渠击壤歌。\n闻道溪头新长水，偷閒试着旧渔蓑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10002,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"田家 其二","author":"方一夔","text":"数间茅屋占林塘，二顷田园幸未荒。\n蒿叶正长蚕卧起，莺声渐老麦青黄。\n壁间龙骨流泉活，筐载豚蹄白酒香。\n春事年年閒过去，欲将拥肿问庚桑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10003,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚杂兴","author":"方一夔","text":"暂凭高处豁双明，独上谯楼倚晚晴。\n烟岫齐纨千万叠，落梅羌管两三声。\n秋风世路客凄楚，流水年光独老成。\n吟兴未如归兴切，萧萧落叶满山城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10004,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题洪复翁诗卷后二首 其一","author":"方一夔","text":"袖中光燄照崖垠，诗律雄浑远有源。\n近藁自成新句法，束书不叛旧游门。\n折芳梅下人双屦，话别沙头酒一樽。\n健笔世间谁措手，老夫先拟举降幡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10005,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题洪复翁诗卷后二首 其二","author":"方一夔","text":"诗里人传大小贤，自怜同业不同年。\n白云孺子诗千首，黄石老人书一编。\n冷眼危途风竹乱，知心旧事雪松坚。\n别愁去作星桥梦，长傍河西牛斗边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10006,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春晚杂兴四首 其二","author":"方一夔","text":"懒向风轩扫落花，暮年情态惜韶华。\n春盘脆响供雷笋，夜焙芳藓摘露芽。\n蚕老住眠催作茧，燕来新乳贺成家。\n狂游无复少年梦，聊遣清吟送日斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10007,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春晚杂兴四首 其四","author":"方一夔","text":"欲逐芳菲寄病身，莺花不管老年人。\n幽寻但见肥牛地，胜赏难追骏马尘。\n薄酒似饧聊取醉，青梅如豆正尝新。\n清欢未足还休去，日落汀洲又暮春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10008,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽尚书先生","author":"方一夔","text":"前代衣冠第一人，老来鸣道振遗音。\n勋庸臣子平生志，书易圣贤千古心。\n士愿执经来鹿洞，客求挟册售鸡林。\n飞仙虽去斯文在，山阁神光照斗参。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10009,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"食菜","author":"方一夔","text":"日食何曾费万钱，畦丁辛苦斸风烟。\n墙阴吠狗硬如铁，山下蹲鸱大似拳。\n忍弃毛锥飞食肉，空怜匿服卧餐毡。\n茶瓯气味堪相配，更汲源头活水煎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10010,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅后久雨","author":"方一夔","text":"自入梅天气力微，不堪暑湿互蒸炊。\n鬓边衰白三千丈，雨后昏黄十二时。\n积润图书供火焙，新裁罗褐覆香匜。\n小占定有朝晴喜，忽听黄莺语柳枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10011,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"田家杂兴三首 其三","author":"方一夔","text":"不嫌饭豆与蒸藜，饱脱衣衫挂竹篱。\n问酒亭前旗影市，系船屋角藕花陂。\n踏车挂壁閒龙骨，生药当庭蔓兔丝。\n我自耦耕非避世，姓名休使外人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10012,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"避暑夜坐 其一","author":"方一夔","text":"一跌风波困败鳞，年来是事不如人。\n醉吹羌管惊栖鸟，閒倚胡床阁病身。\n安得旃檀除热恼，自将纨扇障风尘。\n新凉渐近渺云水，分席鸥群占白蘋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10013,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"避暑夜坐 其二","author":"方一夔","text":"北窗幽绝梦初圆，一叶秋声醒客眠。\n雌霓半空收暮雨，杜鹃六月熟高田。\n稻陂别注鱼池水，石洞分承茗鼎泉。\n聊借旧书栖旧隐，夜凉新入短檠边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10014,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游南山天宁寺","author":"方一夔","text":"客里尘騑未着鞭，短篷送我访幽禅。\n横空云冒临江寺，夹岸山随下濑船。\n谩借一觞追胜概，暂分半日洗尘缘。\n城头梅角声孤起，掉首空归又晚天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10015,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送客出城","author":"方一夔","text":"逐逐区中未了缘，此生飘泊是年年。\n片时枕上思归梦，万里江头送别船。\n寒角吹残低戍火，暮鸦冲断远村烟。\n我行在处成诗话，点化尘凡即是仙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10016,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过耜岩先师墓","author":"方一夔","text":"取数多时物所嫌，有才无命恨难全。\n纵横虽扫三千字，富贵才终五十年。\n幸有菟裘栖旧隐，愧无鸡絮酹新阡。\n茫茫大块谁能料，狐老成精鼠化仙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10017,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"即事","author":"方一夔","text":"纷纷宠辱几时休，朝上青云暮作囚。\n能可将军宿亭下，不堪廷尉望山头。\n浮云过眼难抟控，世事冥心任去留。\n涅亦不缁磨不磷，至今遗教首轲邱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10018,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送人赴学官二首 其一","author":"方一夔","text":"生平讲贯为知几，世好从渠与我违。\n天下无如书益智，人生惟有仕当归。\n青灯夜雨虫鱼注，碧水西风鲈鲙肥。\n莫道尺前难寸退，古来富贵触危机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10019,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送人赴学官二首 其二","author":"方一夔","text":"清时岩穴下弓旌，儒馆翘才尽至公。\n诗记行程囊古锦，剑装新饰?花骢。\n莫因贵宦负远志，当为饥民念鞠躬。\n欲问故人在何处，旧山桂树正丛丛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10020,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏杂兴四首 其三","author":"方一夔","text":"作计吟诗逐故贫，欺人鬼子转情亲。\n案头日饮三升墨，铛底时空五合陈。\n烧麦旋教供野饭，贯杨准拟买溪鳞。\n苏君端为无田出，近日田多更累人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10021,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏杂兴四首 其四","author":"方一夔","text":"雨打梅头麦半枯，出门步步困泥涂。\n世情何但恶溪恶，野性聊同愚谷愚。\n儿可读书供日课，妇如有酒待时须。\n兴来方试吟诗笔，西舍催钱吏索租。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10022,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重午二首 其一","author":"方一夔","text":"画鹢鸣鼍水满湖，千年遗恨渺平芜。\n累臣水底沉鱼冢，玉女钗头缀虎符。\n双鬓点斑羞绿艾，一樽凝碧怯香蒲。\n楚乡旧俗生悽怆，愧杀人间懦丈夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10023,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重午二首 其二","author":"方一夔","text":"苦疮战马倦风沙，伏枥无心万里赊。\n老去手风从妇展，愁来背痒倩儿爬。\n人情反覆好生羽，世味差殊嗜食痂。\n一卷方书初读罢，小窗惊怪日西斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10024,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观物","author":"方一夔","text":"静中群动互飞奔，扰扰谁能脱世尘。\n蝇虎案头新得隽，螳螂枝上忽忘身。\n平生攻苦味无味，举世争雄人食人。\n安得洗心无一物，碧波鸥鸟自相亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10025,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"仁甫次弟余韵","author":"方一夔","text":"造物儿戏多猜嫌，百年丑好两能全。\n眠牛才封一抔土，鹤归已怪三千年。\n乐天永叹北邙冢，后山恸哭南阳阡。\n从来贤达总如此，谁能羽化随飞仙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10026,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋兴二首 其一","author":"方一夔","text":"水花风叶乱萧萧，凉入秋衣怯寂寥。\n桑落寒香初出市，蓼花新涨欲平桥。\n半篷烟雨渔家傲，匹马关山客路遥。\n拍手西风无一事，未妨横笛向耕樵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10027,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋兴二首 其二","author":"方一夔","text":"不堪老病缚閒身，面目峥嵘岁月新。\n半世略无如意事，五年惯作在家贫。\n悠悠怀抱希知我，诩诩交游喜负人。\n俯仰世情都勘破，西风独立岸纶巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10028,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐","author":"方一夔","text":"全家久住白云窝，贪看疏梅夜景多。\n帘角花阴和月捲，墨池水冻带冰磨。\n寒欺驼褐吟肩耸，暖入鹅黄醉面酡。\n笑挹暗香人不寐，不辞百匝绕前坡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10029,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵徐子声采桑","author":"方一夔","text":"唤起飞来说晓晴，先生无处问归津。\n转头岁月如流水，满眼交游少故人。\n槲叶老樵担玉束，菜花飞蝶护香尘。\n隔溪绿暗歌声杳，点点青山入梦频。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10030,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送春","author":"方一夔","text":"春从此去不踌躇，渺渺寒波接碧芜。\n想逐风帆归阆苑，又传云驭赴遮须。\n此生岁月随泡影，末路功名等雉卢。\n归向西窗听幽弄，一樽浊酒对提壶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10031,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忆复翁","author":"方一夔","text":"垂杨渡口小舟横，我涉清溪君独行。\n未许马群空冀北，自怜墨派过彭城。\n鳞鸿乏便书难到，蝴蝶无情梦不成。\n可是孤吟清绝处，高山谁识断肠声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10032,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴","author":"方一夔","text":"溪上寒窗面绿漪，孤踪漂泊渺天涯。\n愁听火令抛长檠，醉折花筹记小诗。\n莺语难寻春去处，乡心偏等梦回时。\n文章满腹知何用，落得奔波两鬓丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10033,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重午","author":"方一夔","text":"楚乡节物又今朝，老大催人不肯饶。\n岁久菖花初见面，病多艾叶已盈腰。\n浪涛何处寻沉魄，菰黍无心逐画桡。\n莫到独醒空过了，旗亭风急又相招。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10034,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵稼隐上徐云岫喜复贡举","author":"方一夔","text":"天阙谁推破旱雷，蚁封鼠壤一时开。\n云飞远岫无心出，春逐行人有脚来。\n桂窟旧游空雨露，棘闱前度没蒿莱。\n短衣傥逐前麾去，解向淮头破贼回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10035,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"沃祥卿次前韵见寄和以答之","author":"方一夔","text":"羡君古洗刻云雷，苞裹珍奇秘不开。\n亭枕寒流随浪动，楼横空翠约云来。\n吟笺题满投囊贺，寿斝光浮戏綵莱。\n欲洗炎埃无处所，玉梅泉下日千回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10036,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵通甫喜复贡举","author":"方一夔","text":"当年涂抹笑东施，群动儇儇各自飞。\n不分前程移岸谷，至今遗恨满庭闱。\n文章老去攻诗律，富贵年来发祸机。\n世上英雄君与操，谁甘终老故山归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10037,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋兴","author":"方一夔","text":"笑呼筇竹过溪东，摵摵秋声到井桐。\n落日远山疑有雨，孤村古树欲攒空。\n贪嘶马饱衔花草，趁食鱼肥堕水虫。\n归对书檠人不寐，乡愁怕入梦魂中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10038,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"木犀 其三","author":"方一夔","text":"绿衣年少正风流，手折高枝喜气浮。\n三树独标仙窟种，四花分占玉壶秋。\n浓薰药杵长舂捣，清逼诗肝巧斲锼。\n世上红儿那可比，试将此句问罗虬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10039,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"景德观陈道士圃多菊觅其种栽并寄以诗","author":"方一夔","text":"爱药仙人醉不归，秋光次第入玄都。\n蝶随露蘤移花垡，风逼寒香落酒壶。\n老去君方空结习，兴来我欲斸荒芜。\n和篇应与花俱到，换得骊龙百斛珠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10040,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵雪冈徐景星二首 其一","author":"方一夔","text":"阿咸秀出竹林边，千古风流有此贤。\n独向诗盟参古律，不随世态异憎怜。\n夜光照耀需他日，汗血奔腾出少年。\n乞我飞霞与青玉，夜深环佩韵璆然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10041,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵雪冈徐景星二首 其二","author":"方一夔","text":"穷腹便便诧老边，敢将文字压前贤。\n愁怀不作功名想，衰鬓从教儿女怜。\n客路知心惟有月，书灯话旧更何年。\n欲投名字来吟社，已湿寒灰不复然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10042,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今岁吾乡颇稔而收成值雨夜坐有怀二首 其一","author":"方一夔","text":"千步平场筑杵齐，西风墟落转凄迷。\n要教岁计收霜稻，不分时长弄雨粞。\n曩祝污邪酬愿望，近居畏垒费推挤。\n先生莫恋无钱饭，定把长镵理旧畦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10043,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今岁吾乡颇稔而收成值雨夜坐有怀二首 其二","author":"方一夔","text":"萧萧疏雨未调霜，空向寒阶滴夜长。\n风激木围如撼枕，虫号土穴欲扶床。\n蚁倾清浊香浮瓮，蟹劈尖圆黄戴筐。\n独背残灯眠未稳，梦寻归路到枌乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10044,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵陈道士和徐星韵见寄 其一","author":"方一夔","text":"寄迹琳宫绛阙边，聚星家世楚先贤。\n但留法界寸田在，不要穷途众目怜。\n谈客由来无负郭，诗盟此去定忘年。\n吾衰有分非君独，休羡千金有计然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10045,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵陈道士和徐星韵见寄 其二","author":"方一夔","text":"不将书剑奋穷边，药裹君臣酒圣贤。\n笑我文章全乏用，从渠心目两相怜。\n参同颠倒长生诀，大衍推寻过去年。\n莫把诗狂压师服，兴来还解赋超然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10046,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃祥卿见谢 其一","author":"方一夔","text":"屡缘倦翼发虚弹，抛掷明珠不惮难。\n但见云烟归笔下，不知风雨做秋阑。\n枌乡人在依馀热，桑落春浓压早寒。\n时鼓梅花无谱曲，坐中惊倒董庭兰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10047,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃祥卿见谢 其二","author":"方一夔","text":"有道论心知己少，世情开口向人难。\n滴愁细雨惊秋暮，照睡青灯伴夜阑。\n文席知君容孔暖，孤吟愧我胜郊寒。\n浮花浪蕊何须数，岁晚归来看石兰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10048,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游碧沼寺","author":"方一夔","text":"古寺萧萧昼闭房，我来无处觅春阳。\n门前绿静江湖汛，松下清阴暑月凉。\n空寄郭公留旧隐，愁听望帝断离肠。\n借君拍板都无用，看尽伶优老戏场。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10049,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"接花","author":"方一夔","text":"枝头信手夺春工，要借并州一割功。\n瓜柳皮粘混金碧，梅桃根换变铅红。\n笑谈自分求孙叔，形似应难想孟公。\n却怪后皇同种橘，过淮便隔马牛风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10050,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明游塔山","author":"方一夔","text":"海山鳌骨白如银，况是青山溟涬君。\n不见黄泉沽纪酿，但惊红雨落刘坟。\n百年尘土锁连骨，一幅功名碑刻文。\n欲返断魂呼不醒，归涂宾从醉纷纷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10051,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明后一日","author":"方一夔","text":"老年光景转风轮，惆怅清明又一春。\n飞燕双双新旧恨，长亭五五往来人。\n揩磨病眼朱成碧，补接新花假像真。\n要觅西江千斛水，拂衣径去洗缁尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10052,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游苦竹徐坟值雨","author":"方一夔","text":"数声呼我竹溪鹴，烟雨苍茫苦竹冈。\n半径暮山浮翠滑，一渠春水落红香。\n无人羞乞墦间肉，有酒空浇地下郎。\n万化尽时终闭骨，醉来谁复算彭殇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10053,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵通甫至日","author":"方一夔","text":"先生熨眼洗浮埃，共看梅边节物来。\n破闷好诗胜搔背，浇寒新酒似淋灰。\n宾主风裁推滕阁，弟子声名咏有台。\n怜我岁华相逐老，应将暖律发枯荄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10054,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"别通甫","author":"方一夔","text":"归途渺渺迫年华，回马如飞不用挝。\n遥指荒村沽竹叶，独行残月看梅花。\n不嫌问路征夫冷，颇讶迎门稚子哗。\n为报江边羁客道，投林莫作后栖鸦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10055,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春归杂兴三首 其一","author":"方一夔","text":"白首青灯滞一乡，不将迟暮照韶光。\n经风魏紫埋倾国，破晓离黄殒折杨。\n老去功名随梦断，别来云水隔天长。\n此生聚散何时了，定计归锄五亩荒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10056,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春归杂兴三首 其二","author":"方一夔","text":"双丸不肯驻颓光，宇宙悠悠万物长。\n寂寞饯春风雨里，笑歌赌命绮罗乡。\n破衾自卧三椽月，枯砚犹耕万卷庄。\n未脱书生穷口债，向人时复说文章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10057,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春归杂兴三首 其三","author":"方一夔","text":"东皇歌阕祖青宫，借我?旗并送穷。\n茧栗润含萌竹露，枪旗香过焙茶风。\n花残来岁须重发，日却何时定再中。\n惆怅浮踪底处所，梦随飞絮故园东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10058,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]