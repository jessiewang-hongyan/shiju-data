[{"title":"程公明家玉蕊花","author":"仇远","text":"招隐山中有此花，仙人曾住七香车。\n可怜一架开如雪，冷落西门处士家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":305,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"落桂","author":"仇远","text":"养成花魄是轻阴，风露凄凄已满林。\n到底难磨秋富贵，一庭香粟万黄金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":306,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"溧水道中 其二","author":"仇远","text":"五峰合沓拥东庐，泉落芳塘旱不枯。\n空凿秦淮三百里，六朝王气几曾无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":307,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"溧水道中 其一","author":"仇远","text":"步屧春风白马桥，车沟泥滑路迢遥。\n眼前未识千红紫，但见新黄上柳条。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":308,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"猿图","author":"仇远","text":"天竺寒泉夜月明，洞深曾听两三声。\n秋风木叶图中见，比似前回太瘦生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":309,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题马秀卿郊墅","author":"仇远","text":"仙人朝去莫知还，野色风光一草庵。\n少室何妨高索价，莫教轻指作终南。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":310,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题五牧蒋氏所藏阎次平小景","author":"仇远","text":"绿芜红叶照秋明，白雁孤飞我独行。\n谁识草堂穷杜老，江南江北正关情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":311,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题天寿观清隐山房","author":"仇远","text":"紫极秋声竹满轩，一尘飞不涴琴樽。\n白云自逐秋风去，卧看青山懒出门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":312,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题史寿卿二画 其二","author":"仇远","text":"少年曾读在原诗，忽见飞鸣傍竹枝。\n忆著江南好兄弟，岁寒风雪欲何之。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":313,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题史寿卿二画 其一","author":"仇远","text":"香草何时号水仙，翠翘罗袜步蹁跹。\n风标宜作梅花伴，不入离骚亦偶然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":314,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题江贯道雨溪晚钓卷后","author":"仇远","text":"雨后沧波泯泯流，樵夫归去有渔舟。\n江郎缩地能如此，何必双溪叠嶂游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":315,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题汤松年画卷 其一","author":"仇远","text":"貌得人间真乘黄，曹将军后有韦郎。\n奚官牵挽犹西望，似忆春风苜蓿长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":316,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题汤松年画卷 其二","author":"仇远","text":"紫蜡团心栗玉松，荼蘼香色似同宗。\n因思弄蕊攀条处，花刺勾人晓露浓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":317,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题吴远秋塘双禽","author":"仇远","text":"昔年曾听雪儿歌，此日池塘见败荷。\n寄语鹣鹣春已去，白蘋红蓼奈秋何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":318,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李成寒鸦图","author":"仇远","text":"老树枯苔雪乍晴，饥乌飞集噤无声。\n蒺藜沙上花开早，且让春风与燕莺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":319,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李益师谦所藏和靖吟梅图","author":"仇远","text":"瓶插梅花一两枝，逋仙隐几自吟诗。\n北风酿作西湖雪，不顾山童冻得痴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":320,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题和靖先生观梅图无怀上人徵予作","author":"仇远","text":"痴童癯鹤冷相随，笑指南枝傍小溪。\n到处一般香影色，孤山只在断桥西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":321,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题孟浩然图","author":"仇远","text":"风吹衿帽不知寒，款段奚奴冻亦顽。\n缩项鳊鱼无可钓，归鞭遥指鹿门山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":322,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画 其二","author":"仇远","text":"天上高飞地上行，终难万里附鹏程。\n鹭鸶股肉无人割，老守菰蒲过一生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":323,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画 其一","author":"仇远","text":"纷纷鸡鹜一冥鸿，全放全收旦暮同。\n各为稻粱飞不起，偶然相聚小池中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":324,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画竹 其四","author":"仇远","text":"新笋箨半含，节下粉犹绿。\n指日南风来，吹作阶庭玉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":325,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵仲穆山水二首 其二","author":"仇远","text":"王孙遗迹在桐乡，留意当年翰墨香。\n回首西风多感慨，不辞援笔赋嵇康。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":326,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵仲穆山水二首 其一","author":"仇远","text":"绿林红树石峥嵘，有客携琴访友生。\n今夜西轩风月好，殷勤为我鼓商声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":327,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵希贤所藏墨竹 其一","author":"仇远","text":"一竿千百叶，凤尾翠交加。\n曾向仙坛种，和风扫落花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":328,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵希贤所藏墨竹 其二","author":"仇远","text":"新梢雾如沐，断节霜不枯。\n西窗夕阳下，此君何可无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":329,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵希贤所藏墨竹 其三","author":"仇远","text":"谢家庭下玉，化此青琅玕。\n风标夐不俗，谁谓骨相寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":330,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵松云竹石幽兰","author":"仇远","text":"旧时长见挥毫处，修竹幽兰取次分。\n欲把一竿苕水上，鸥波千顷看秋云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":331,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵松云迷禽竹石图","author":"仇远","text":"锦石倾攲玉树荒，雪儿无语恋斜阳。\n百年花鸟春风梦，不是钱塘是汴梁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":332,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵信国墨梅后书宋广平赋 其二","author":"仇远","text":"素衣喜不污缁尘，贞女江头见似人。\n桃李门墙零落尽，江南犹有一枝春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":333,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇 其四 郎景韦","author":"仇远","text":"红紫委尘土，绿窗清昼长。\n安知两三竹，风已作秋凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":334,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇 其三 翟益之","author":"仇远","text":"泉急喧溪碓，山深怯瘦驴。\n翟汤如肯隐，来此卜幽居。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":335,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇 其一 程公明","author":"仇远","text":"溪山隔岸好，风雨过桥危。\n何似高楼上，停云且赋诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":336,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇 其五 张德远","author":"仇远","text":"攲枕闻春雨，闭门见绿阴。\n可人歌扇底，犹有惜春心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":337,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题烟竹图","author":"仇远","text":"楚山晴雨未分明，淡锁苍筠晓更清。\n浑是一江秋色染，只疑无处著秋声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":338,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题燕肃画卷","author":"仇远","text":"溪路迢迢绕碧峰，白云迷却旧行踪。\n买舟归去山中住，终日茆亭坐听松。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":339,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠圭上人","author":"仇远","text":"一尘不染俗难干，百事无能心自閒。\n我道老僧痴未绝，有时采菊见南山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":340,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丁未元日","author":"仇远","text":"花甲喜循环，风霜变老颜。\n閒身留泮水，归梦满湖山。\n雪冻蝗应避，春暄雁欲还。\n桃符随手写，祸福不相关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":341,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七夕 其一","author":"仇远","text":"河鼓天孙各老成，无愁可解任秋声。\n痴儿笑月羞眉曲，稚女穿针斗眼明。\n夜半且分瓜果供，天中岂识别离情。\n未能免俗消光景，醉卧西风梦亦清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":342,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七夕 其二","author":"仇远","text":"岁岁今宵乞巧楼，疏星如弈月如钩。\n莫将寒信侵房屋，肯把閒情问女牛。\n儿笑无书空晒腹，妇言有酒可浇愁。\n鹊慵竟失河桥约，尽日喳喳古树头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":343,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七月梨花","author":"仇远","text":"紫薇红槿外，忽见此花娇。\n纵被秋阳暴，何愁香雪消。\n梦回云冉冉，春远夜寥寥。\n魂隔梧桐雨，时吹玉笛招。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":344,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日次程公明韵","author":"仇远","text":"风帘猎猎傍檐斜，问酒来投野老家。\n佳节已逢重九日，东篱未见两三花。\n科头坐石从吹帽，拭眼看山似隔纱。\n七里冈前归路闇，月悬破镜忆秦嘉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":345,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日诸友屏峰上方登高得登字","author":"仇远","text":"天借重阳一日晴，因过竹院远寻僧。\n翠屏晚对无人共，画栋朝飞与客登。\n旋摘菊花浮腊酝，待分贝叶读秋灯。\n馀生有暇须行乐，漫向松冈叹废陵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":346,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九月八日持螯","author":"仇远","text":"趁晴明日拟登高，十里龙山肯惮劳。\n但愿有钱堪对菊，莫愁无手可持螯。\n虱官只合辞归去，鼠腹安能赋老饕。\n行见白衣人送酒，已拚痛饮读离骚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":347,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"二十五日东风少定辛丑夜西风再作","author":"仇远","text":"东风已扫九衢埃，何事飙轮去复回。\n秋信蘋洲凉渐迫，人家蓬户昼难开。\n低田受水祥禾偃，乱石飞空巨木摧。\n见说长淮旱无雨，蜚蝗几欲渡江来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":348,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月二十三日三溪书房赏桂二花","author":"仇远","text":"二花香更烈，不与一花同。\n曾记和云折，惟愁著雨空。\n旧游明月窟，古意小山丛。\n十日中秋过，浑疑秋未中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":349,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十四夜月下闻秋声","author":"仇远","text":"中秋才一宿，此夜已圆明。\n星斗何曾见，云烟不敢生。\n黄花千万粟，白发两三茎。\n愁听东南角，奔腾风雨声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":350,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十一月十六日学宫对酒","author":"仇远","text":"客况冬晴足自宽，招邀春意入毫端。\n浮云蔽日俄生暝，急雨随风故作寒。\n诗酒相寻忘尔汝，古今难必是悲欢。\n茫茫山岳蘧蘧梦，不了梅花冷眼看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":351,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十日与侯伯用谢元焘诸友汎菊得头字","author":"仇远","text":"西风吹发冷飕飕，赖有多情帽裹头。\n九日已知成昨夜，绿樽聊复集清流。\n山房霜菊偏能耐，客路云萍故自浮。\n欲识岁寒心皎洁，一方月色十分秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":352,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"卜居白龟池上","author":"仇远","text":"一琴一鹤小生涯，陋巷深居几岁华。\n为爱西湖来卜隐，却怜东野又移家。\n荒城雨滑难骑马，小市天明已卖花。\n阿母抱孙閒指点，疏林尽处是栖霞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":353,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又送程公礼侍父归蜀用方万里韵","author":"仇远","text":"远从溧里上潼川，渚宿岩栖约半年。\n老子情怀原不浅，扁舟风景浩无边。\n故乡兵后几人在，明月秋中何处圆。\n母氏悬悬兄弟望，顺流及早理归船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":354,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三月二十六日书所闻","author":"仇远","text":"从来赛社说金渊，鼓笛钲旗隘市廛。\n地上鬼神行白昼，夜中风雨洗青天。\n妖氛旱魃驱无迹，和气欢声兆有年。\n车马纵观儿女事，老夫闭户读韦编。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":355,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三更汎舟谢达剨 其二","author":"仇远","text":"一望四十里，瀰漫白浸天。\n何年围此水，为我垦成田。\n风使帆船疾，云和竹苇连。\n末流溪转狭，浮沫带蛟涎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":356,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三更汎舟谢达剨 其一","author":"仇远","text":"渰水不盈尺，大舟行水中。\n朦胧微有月，潋滟寂无风。\n时序三秋半，阴晴万里同。\n山歌与村笛，醉卧听渔童。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":357,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三叠 其二","author":"仇远","text":"为贫干寸禄，匏系欲归难。\n雁字谁能寄，鸥盟久已寒。\n自怜秦博士，何似卫伶官。\n终觉家居乐，高眠一枕安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":358,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三叠 其三","author":"仇远","text":"在昔金渊地，烟花锦不如。\n衣冠尊史祖，山水识灵胥。\n富岁人多赖，前修日以疏。\n洪崖仙可问，愿乞雪精驴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":359,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三叠 其一","author":"仇远","text":"禁酤限十日，亡何能几何。\n流光徒荏苒，老眼自挼莎。\n江浙归心切，山林醒眼多。\n富家忧劝率，役后欲重科。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":360,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与子野过永仙观循西城以归邂逅李戒甫夕山西爽诗料满目子野明发诗来予次韵 其二","author":"仇远","text":"一笑相逢李伯时，树阴匝地绿云低。\n林梢落日犹馀丈，天下好山多在西。\n我醉欲归须客送，君装已趣尚鹃啼。\n明朝定有新诗句，且让溪翁向上题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":361,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与子野过永仙观循西城以归邂逅李戒甫夕山西爽诗料满目子野明发诗来予次韵 其一","author":"仇远","text":"坏垣荒径入蒿莱，不惹康衢半点埃。\n赏静偏怜雏笋长，趁凉自引瘦筇来。\n杯馀漱齿呼新茗，石上题诗剥古苔。\n试问依檐双老桧，何如列柏在乌台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":362,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与李孔言上舍谈星命","author":"仇远","text":"辟雍人物已无多，奈此江湖落拓何。\n鹤表只宜归井邑，雁程不必度关河。\n诗书志气存司马，言语功名付祝鮀。\n炙輠谈天非我事，雨灯聊和醉时歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":363,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"之金陵","author":"仇远","text":"文学本閒官，长年愧素餐。\n出门还自笑，行路有何难。\n风日幽怀畅，江山望眼宽。\n六朝遗迹在，随喜一游观。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":364,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"子野雪后寄和却寄廷玉 其三","author":"仇远","text":"平明跨马晚方归，偃仰行窝早见几。\n馀子祗宜床下卧，诗人顿觉眼中稀。\n堂堂白璧埋黄壤，冉冉缁尘染素衣。\n得酒便须开口笑，雪畦紫芋胜秋肥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":365,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"子野雪后寄和却寄廷玉 其二","author":"仇远","text":"琴书笔砚伴閒身，斗室依然不觉贫。\n野犬自来能吠雪，土牛此去且迎春。\n一毡辗转衾无絮，四壁凄凉甑有尘。\n昨夜东风先破冻，江梅冷眼笑何人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":366,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"子野雪后寄和却寄廷玉 其四","author":"仇远","text":"素琴挂壁已多时，政尔难逢钟子期。\n腹有精神方学道，面无尘土始言诗。\n山童隔壁沽村酝，田叟登门送墓碑。\n小市饥氓争籴米，青州太守可能知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":367,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"子野雪后寄和却寄廷玉 其一","author":"仇远","text":"渊明白发满头生，肯赋閒情未老成。\n自笑冷官租屋住，每因来使出郊迎。\n横经空忝先生号，解印仍呼处士名。\n惟有溪干隐君子，知予的的愿归耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":368,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"广教寺","author":"仇远","text":"三门当驿道，四壁启僧房。\n颇有千竿竹，能令六月凉。\n撞钟山鹳起，煮茗石罂香。\n岸曲盘涡急，人言古濑阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":369,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中元","author":"仇远","text":"初秋当望夜，平楚带斜曛。\n暑气能昏月，砧声不隔云。\n华灯浮白水，老衲诵冥文。\n漫说中元节，儒书惜未闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":370,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋月出复雨有怀叶子文汤明叔","author":"仇远","text":"三秋此夕恰平分，城市人家半闭门。\n正忆紫云吹玉笛，忽惊皓月照金樽。\n宦情素薄鸿初到，诗兴方浓雨又昏。\n不是桂花香自慰，倚栏无语易销魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":371,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋月出复雨有怀叶子文汤明叔","author":"仇远","text":"溧滨三度见中秋，感叹光阴逐水流。\n常是浮云妒佳月，不容老子醉高楼。\n鲈香易动张翰兴，鲸背难追李白游。\n遥忆诗人豪气在，湖天空阔放扁舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":372,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]