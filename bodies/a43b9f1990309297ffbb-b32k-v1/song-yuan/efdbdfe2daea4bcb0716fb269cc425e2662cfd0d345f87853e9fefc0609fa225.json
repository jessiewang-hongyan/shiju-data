[{"title":"哭川无竭禅师二首 其二","author":"方回","text":"几登潇洒阁，共坐听松风。\n异骨癯僧健，多魔老守穷。\n是身终有死，何物不成空。\n岂料龙钟老，题诗先哭公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2720,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭川无竭禅师二首 其一","author":"方回","text":"师令题画像，圆寂十朝前。\n拙句应曾见，微痾竟不痊。\n笑谈犹可想，偈颂总堪传。\n千柱攒金碧，辛勤二十年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2721,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭方碧山前惠州同知 其一","author":"方回","text":"同宗多两岁，官学幸同门。\n去夏才相别，踰旬遽□□。\n□□淹逆旅，公已见曾孙。\n二子言将葬，惊嗟欲断魂。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2722,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭方碧山前惠州同知 其二","author":"方回","text":"四年登八十，寿过古来稀。\n辞郡非关瘴，思亲自合归。\n千诗存老笔，二纪掩閒扉。\n鸡絮临筵几，随潮夜梦飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2723,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭鲍景翔鲁斋 其二","author":"方回","text":"高年开八帙，细字尚亲抄。\n已矣蝇头笔，谁其凤觜胶。\n能传言外意，始识画前爻。\n此老埋黄壤，纷纷叹面交。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2724,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唁织蓑翁","author":"方回","text":"系马篱边树，春初此叩扉。\n行人求茗饮，老父售蓑衣。\n忽已空无物，云何去不归。\n杵亡石臼破，残麦化蛾飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2725,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐閤门挽诗三首 其三","author":"方回","text":"异日烟霄梦，终身水竹居。\n早交天下士，尽读世间书。\n汉祚金刀末，江流玉树馀。\n兴亡较功罪，元不涉樵渔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2726,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐閤门挽诗三首 其二","author":"方回","text":"儿子与门生，东篱忆送迎。\n吾虽愧光禄，独幸识渊明。\n爱酒终成疾，工诗早得名。\n晁家鸡肋集，已足继新城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2727,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐閤门挽诗三首 其一","author":"方回","text":"除布何飘骤，偾亡足败伤。\n宁歌紫芝曲，自老白云乡。\n兵息潢池弄，书全屋壁藏。\n铭碑端不愧，今代蔡中郎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2728,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏日","author":"方回","text":"多病情怀懒，新晴草木光。\n倦骸扶老瘦，幽径息阴凉。\n家瘠盘餐俭，村荒籴价昂。\n岂无可忧者，得句暂能忘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2729,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏自然惠五言古体久之以律体和谢","author":"方回","text":"古五言诗今罕见，把看愈久愈精神。\n何能笔下有斯作，似觉眼中无此人。\n政用整严藏细润，元从冷淡出清新。\n著鞭更与追陶谢，莫向齐梁踵后尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2730,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏夜闻雨","author":"方回","text":"可以逃袢暑，征徒盍少休。\n病多全为老，醉极暂无愁。\n雨气昏灯夜，蛬声古屋秋。\n钱塘湖上路，到日与谁游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2731,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏商","author":"方回","text":"牛下悲哀宁戚讴，捐汤置禹此何由。\n父初传子风差薄，臣至干君德转輶。\n归启旧家犹几在，升陑众旅已相仇。\n何人得似彭铿寿，见夏为殷复见周。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2732,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"家书","author":"方回","text":"倚楼閒看雨，已下又重登。\n困入春深剧，愁逢日暮增。\n家书闻子病，时事说兵兴。\n流汗才挥扇，风寒忽似冰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2733,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"徐制准挽辞","author":"方回","text":"纷纭钟鼎误公卿，孰与山林保令名。\n不共鹄袍争举业，早令熊辔绍诗声。\n人间倏忽惊兴废，物外从容了死生。\n何限貂蝉无葬地，一丘风月自佳城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2734,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"徐逊绵题三贤祠堂诗有云士死惟留姓与名天下第一议论也再赋二首 其二","author":"方回","text":"黉宇祠堂塑像新，两朝邦伯间邦民。\n没身不朽缘何事，异世相知自有人。\n梅魄鹤魂招处士，松心凤咮吊累臣。\n宫墙数仞严香火，似胜萧萧野水滨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2735,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"徐逊绵题三贤祠堂诗有云士死惟留姓与名天下第一议论也再赋二首 其一","author":"方回","text":"殷仁周寿缺圆形，释宝仙清笑乞灵。\n何限台阶隆爵位，谁堪鼎足并仪形。\n岁寒臭味松梅竹，乾象光芒日月星。\n野服不殊人品似，年年蘋藻荐芳馨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2736,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"悔少作","author":"方回","text":"崛强轮囷谓绝奇，刮摩剔抉更多疑。\n彭门峻步勤除道，栗里高风晚得师。\n乃后容赊十年死，定应全废一生诗。\n根柯直待如铜石，始是参天溜雨时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2737,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽分水柳溪何处士二首 其二","author":"方回","text":"历数更端后，英雄崛起间。\n子真逃谷口，角里老商颜。\n德共三槐远，名堪五柳攀。\n知贤惭拙守，论撰幸藏山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2738,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽分水柳溪何处士二首 其一","author":"方回","text":"太学师名士，初踰志学年。\n树萱竭甘旨，肯室擅林泉。\n盗踵兵戈起，家并里社全。\n陈蕃旧悬榻，惜未致斯贤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2739,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽吕襄阳","author":"方回","text":"将军报国寸心丹，满眼儿孙尽好官。\n一品已颁新印绶，九重犹许旧衣冠。\n碑存岘首怀羊祜，箭著浮图恨贺兰。\n公论百年应自定，且留忠节后人看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2740,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽艮岩梅府卿 其一","author":"方回","text":"庚午昔同朝，权臣狠且骄。\n至尊俱芥视，大物遽冰消。\n密勿毗廊肆，艰难驾使轺。\n丝毫心有愧，寿肯到今朝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2741,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽艮岩梅府卿 其三","author":"方回","text":"改卜龟图后，閒居二十年。\n商颜才聘币，剡曲竟回船。\n□□无虚日，粢盛有薄田。\n何须似裴李，绿野及平泉。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2742,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽艮岩梅府卿 其二","author":"方回","text":"往事括囊坤，元魁罪忍论。\n咸淳君蔑有，德祐国能存。\n委曲都司笔，侵寻亚从门。\n惟公独不肯，手板倒桓温。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2743,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅况戏题","author":"方回","text":"行役亦何聊，听予旅况谣。\n水须分岭顶，路必过山腰。\n早问人求店，无轻马度桥。\n衣袍不解带，侧卧几寒宵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2744,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅穷中报生孙名曰守","author":"方回","text":"瘦面皴肌暗自扪，薪殚粲尽复空樽。\n浪言官至同三品，且喜家生第四孙。\n孰谓将军骓不逝，其如处士菊犹存。\n忍穷守道吾心定，胙土专城莫更论。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2745,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其十","author":"方回","text":"浩浩观今古，憧憧角利名。\n学如未闻道，死似不曾生。\n琐碎禽虫语，芳鲜草树荣。\n过时随变灭，历代几公卿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2746,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其九","author":"方回","text":"升沉元有命，不在巧谋身。\n政使魁廷彦，兼能位谏臣。\n一时侪恶党，百世号憸人。\n所得都能几，风花瞬息春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2747,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其八","author":"方回","text":"西湖西畔路，死魅复游魂。\n早作千年调，能容一尺浑。\n国刑修己怨，王爵报私恩。\n纵许留遗孽，终无令子孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2748,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其七","author":"方回","text":"运启奎占瑞，途殚彗告危。\n晚生违盛际，后死值衰期。\n何啻三归备，宁虞九鼎移。\n焉知专夜妾，竟孕别人儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2749,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其六","author":"方回","text":"年饥身复病，食尽药无良。\n此老何其窘，于诗自不妨。\n暑窗从纸破，晴井放绳长。\n稍觉愁眉展，初秋夜欲凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2750,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其五","author":"方回","text":"吟窗委巷间，四顾尽尘阛。\n屋角才孤树，楼西仅远山。\n群饥乌谩噪，高举鹄容攀。\n夜静看星斗，秋风喜渐还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2751,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其四","author":"方回","text":"彼姝复此粲，人面外堪看。\n鹦鹉虽能语，芙蓉岂耐寒。\n舌甜元可畏，背毁更多端。\n昵昵徒为耳，云龙许控抟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2752,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其三","author":"方回","text":"旧观繁华绝，馀风巧伪滋。\n人穷何不至，俗薄故堪嗤。\n敝帚犹艰借，劳薪自暗炊。\n扶摇九万里，遥谢庶风雌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2753,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其二","author":"方回","text":"久閒仍久客，焉敢罪奴僮。\n灶下横蛇蜕，门前积马通。\n分衣犹恶敝，彻馔即闻空。\n儿子扶行好，秋溪望乃翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2754,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅闷十首 其一","author":"方回","text":"病恐医难谢，贫惊籴愈昂。\n未甘频饵药，只欲暂休粮。\n暑殆无凉处，饥容有熟乡。\n归欤谋藿食，不敢畏秋阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2755,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓发秀州城南","author":"方回","text":"较似苏湖郡，无山四渺然。\n近城先见塔，出户即乘船。\n晓泽升红日，秋光际碧天。\n稻粱无不足，最忆旧丰年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2756,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓枕","author":"方回","text":"春来何事客江城，攲枕怀人意屡惊。\n遥夜欲明风雨止，老人无睡鼓钟清。\n苦难辞酒真成病，强欲酬诗曲徇情。\n竹密花浓归去好，万山深处听莺声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2757,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓思","author":"方回","text":"霜天钟鼓趣晨兴，老我无毡脚似冰。\n千骑马尘跑玉勒，一枝梅影伴香灯。\n年当致仕元无位，心亦怀归苦未能。\n政用括囊保衰暮，可劳妒妇愤填膺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2758,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓起","author":"方回","text":"夜凉无寐起吟诗，正是秋风欲动时。\n百尺楼高蟾独挂，五更钟过马交驰。\n道怀了了元无事，世故纷纷总不知。\n但欠山头埋骨穴，归欤分付与诸儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2759,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涌金门城望五首 其五","author":"方回","text":"风入松词万口传，翻成馀恨寄湖烟。\n难寻旧梦花阴地，剩放新愁雪意天。\n战罢閒堤眠老马，宴稀荒港泊空船。\n此心拟欲为僧去，政恐袈裟未惯穿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2760,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涌金门城望五首 其四","author":"方回","text":"曾向西湖醉写诗，衰年六十叹飙驰。\n一毫无补承平世，万事俱非老死时。\n三竺禅窗猿已化，八梅吟冢鹤应悲。\n花秾月艳今如梦，卧听长桥笛夜吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2761,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涌金门城望五首 其三","author":"方回","text":"天回地转事云轮，湖葑山榛色渐陈。\n坠珥遗钿如隔世，攲楼倾榭最愁人。\n一钱物变千钱直，十户民惊九户贫。\n犹有沙河塘上路，卖花声作旧时春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2762,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涌金门城望五首 其二","author":"方回","text":"左看城阙右看湖，辗翠蹄红路欲芜。\n君子颇闻梁上有，丽人何至水边无。\n他时公论谁良史，往日虚名几腐儒。\n地下西施应冷笑，不缘红粉解亡吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2763,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"涌金门城望五首 其一","author":"方回","text":"萧条垂柳映枯荷，金碧楼空水鸟过。\n略剩繁华犹好在，细看冷淡奈愁何。\n遥知堤上游人少，渐觉城中空地多。\n回首太平三百载，钱王纳土免干戈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2764,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"烟雨楼","author":"方回","text":"楼压重湖实壮哉，楼前图画若天开。\n鸥从沙际冲烟去，燕向花边捲雨来。\n傍柳一桥相掩映，隔林双塔共崔嵬。\n栏干倚尽催诗处，晴日须来三四回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2765,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"留钱塘十二年","author":"方回","text":"一纪钱塘去未能，寒梅凉菊暑天冰。\n春风七宝山头寺，夜雨三茅阁上灯。\n和靖不生无隐士，道潜如在可诗僧。\n大船相聚惟歌舞，小舫渔翁采芡菱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2766,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"留题槃隐高士王子由书斋","author":"方回","text":"万宇横陈碧瓦齐，浓岚淡霭总诗题。\n隔江烟树窗中细，过海风樯槛外低。\n琴仅可弦星半缺，壁应欲画雪新泥。\n《南华》卧读两三卷，犹喜晴檐日未西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2767,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病中夜思","author":"方回","text":"垂及七旬叟，行将三伏时。\n归期秋未定，病势夜尤危。\n眼困终难寐，心明尚可医。\n阴寒伺阳燠，间隙不容丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2768,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其十","author":"方回","text":"一切牵缠断孟劳，何金为带紫为袍。\n老从杨柳樱桃去，醉肯螟蛉蜾蠃豪。\n共庆龙从乾五会，谁工雉食鼎三膏。\n折腰彭泽不归去，未必东坡肯和陶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2769,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其九","author":"方回","text":"妙年刚谓世无愁，汗漫猖狂万里游。\n梦里讲经天竺国，醉中横笛岳阳楼。\n散花女已无踪矣，老树精今尚在不。\n咋舌噬脐更摇手，颜瓢曾瑟外何求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2770,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其八","author":"方回","text":"富儿肥马跃雕鞍，同伴何由识木兰。\n拄杖扶携元未老，交床随逐本无官。\n三叉路口人心异，百尺楼头客眼寒。\n黠鬼老狐足妖怪，架中閒摘旧书看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2771,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其七","author":"方回","text":"今年春夏极穷忙，日检医书校药方。\n甫得木瓜治膝肿，又须荆芥沐头疡。\n一生辛苦身多病，四至平和脉尚强。\n寿及龟堂老睦守，不难万首富诗囊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2772,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其六","author":"方回","text":"六年三潦困馀黎，谁识他年旧浙西。\n靡有孑遗何可忽，不知归去果安之。\n属方理屋又闻漏，垂欲出门仍畏泥。\n家在穷山乱云外，自惭无策救儿饥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2773,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其五","author":"方回","text":"初扫蚕今欲茧时，无朝无暮雨垂垂。\n渔家长价蓑衣贵，种户流涎麦饭迟。\n跬步过从难跋涉，等閒脱著系安危。\n肉芝石髓身中有，可向山灵遽朵颐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2774,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其四","author":"方回","text":"客楼卧病过花时，老态如狂复似痴。\n甚欲不餐烟火食，颇能时赋草茅诗。\n馀生自晓寸关尺，他日谁传髓骨皮。\n少许青梅倾斗酒，心醒貌醉尔焉知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2775,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其三","author":"方回","text":"骎骎七十保馀龄，鱼眼无眠夜夜醒。\n魂梦不迷神女雨，形容欲似老人星。\n参同契注房中术，归去来辞座右铭。\n却笑空王太肤浅，张皇浪说八师经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2776,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其二","author":"方回","text":"怯寒重著旧绵裘，已见盆栽坼绛榴。\n自厌一春常服药，忽惊半月不梳头。\n画评懒与痴儿辨，诗序难禁晚进求。\n带砺有盟犹未保，当时谁识种瓜侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2777,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病后夏初杂书近况十首 其一","author":"方回","text":"含桃豌豆喜尝新，罂粟花边已送春。\n岂谓单衣挥扇手，仍为败絮拥炉身。\n唾壶甫换痰仍满，药贴多誇料不真。\n火热冰寒但绝欲，世间疫疠本无神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2778,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"真定路教授鹿泉李君丁亥五月十二日巳时生紫阳虚叟方回丁亥五月十一日巳时生相遇旅邸同登酒楼各出新诗遂成老友","author":"方回","text":"邂逅相逢两秃翁，亥年巳月巳时同。\n偶先一日敢争长，各及七旬俱固穷。\n尘世谁能吟鬓白，少年莫笑醉颜红。\n累朝南北兴亡事，合徵公为太史公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2779,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"袁兴国挽词二首 其二","author":"方回","text":"气化神如在，名高志未伸。\n文章坡老笔，丰度华阳巾。\n恺悌州符屡，旬宣阃画频。\n鼎台袖吾手，覆餗彼何人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2780,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"袁兴国挽词二首 其一","author":"方回","text":"忆昔予初筮，南楼丈席陪。\n观星忧世事，玩日叹时才。\n稍讶无周梦，悬知有郢哀。\n魂今招不得，天尚鉴灵台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2781,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读子游近诗复次前韵二首 其一","author":"方回","text":"江湖流辈互相高，刻楮抟沙漫自劳。\n孰肯剖肠湔垢滓，始能落笔近风骚。\n通疏障碍河东注，剔抉幽微鬼夜号。\n汉魏以来数人耳，曲须和寡始为遭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2782,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]