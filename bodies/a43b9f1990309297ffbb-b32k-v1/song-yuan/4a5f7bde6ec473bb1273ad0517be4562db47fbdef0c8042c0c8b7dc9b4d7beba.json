[{"title":"昌州海棠有香 其一","author":"汪元量","text":"我到昌州看海棠，恰逢时节近重阳。\n人言好种亦难得，只有州衙一树香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5490,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"明皇庙","author":"汪元量","text":"三郎幸蜀大琅珰，夜雨闻铃欲断肠。\n遗庙至今香火闹，女巫调笑舞霓裳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5491,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"采石","author":"汪元量","text":"夜泊青山下，江空不受尘。\n只看波底月，便是谪仙人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5492,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"降香回燕","author":"汪元量","text":"一从得玉旨，勒马幽燕起。\n河北与河南，一万五千里。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5493,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"峡边山寺","author":"汪元量","text":"寺近阴崖多雾雨，峡边灵窦忽风雷。\n松间白足携诗板，石上苍头把酒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5494,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"幽州歌","author":"汪元量","text":"汉儿辫发笼毡笠，日暮黄金台上立。\n臂鹰解带忽放飞，一行塞雁南征急。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5495,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昝舍人锦江泛舟","author":"汪元量","text":"舍人与客放船开，网得鲸鱼饷酒杯。\n西川锦雀甜如蜜，录事相分二百枚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5496,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"神女祠","author":"汪元量","text":"野庙凄凉向峡中，断崖无路一从容。\n楚王神女知何在，云锁巫山十二峰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5497,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"药市","author":"汪元量","text":"蜀乡人是大医王，一道长街尽药香。\n天下苍生正狼狈，愿分良剂救膏肓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5498,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送琴师毛敏仲北行 其三","author":"汪元量","text":"苏子瞻吃惠州饭，黄鲁直度鬼门关。\n今日君行清泪落，他年勋业勒燕山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5499,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送琴师毛敏仲北行 其二","author":"汪元量","text":"五里十里亭长短，千帆万帆船去来。\n请君收泪向前去，要看幽州金筑台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5500,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送琴师毛敏仲北行 其一","author":"汪元量","text":"西塞山前日落处，北关门外雨来天。\n南人堕泪北人笑，臣甫头低拜杜鹃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5501,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蚕丛祠","author":"汪元量","text":"西蜀风烟天一方，蚕丛古庙枕斜阳。\n茫然开国人天主，彷佛鸿荒盘古王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5502,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蚕市","author":"汪元量","text":"成都美女白如霜，结伴携筐去采桑。\n一岁蚕苗凡七出，寸丝那得做衣裳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5503,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾魏公雪中下湖","author":"汪元量","text":"冻木号风雪满天，平章犹放下湖船。\n兽炉金帐羔儿美，不念襄阳已六年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5504,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄李鹤田","author":"汪元量","text":"南泉多载夜光还，健步移梅种玉山。\n八十二翁犹矍铄，苦吟不放此心闲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5505,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赵青山同舍 其四","author":"汪元量","text":"谢傅东山喜劫棋，刘生南岳怕联诗。\n君侯自有通身胆，用舍行藏且顺时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5506,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赵青山同舍 其三","author":"汪元量","text":"聚嘲丛谤腐儒痴，江海漂零酒一卮。\n闲把至音调绿绮，朗吟新句写乌丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5507,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赵青山同舍 其二","author":"汪元量","text":"短褐离披紫凤图，非扬非墨亦非儒。\n独怜后辈欺前辈，自笑今吾即故吾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5508,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赵青山同舍 其一","author":"汪元量","text":"六馆风流不可寻，形骸土木泪痕深。\n有时咄咄空书字，俗子宁知我辈心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5509,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隆庆府","author":"汪元量","text":"雁山突兀插青天，剑阁西来接剑泉。\n如此江山快人意，满船载酒下潼川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5510,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其一","author":"汪元量","text":"丙子正月十有三，挝鞞伐鼓下江南。\n皋亭山上青烟起，宰执相看似醉酣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5511,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二","author":"汪元量","text":"万马如云在外间，玉阶仙仗罢趋班。\n三宫北面议方定，遣使皋亭慰伯颜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5512,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三","author":"汪元量","text":"殿上群臣默不言，伯颜丞相趣降笺。\n三宫共在珠帘下，万骑虬须绕殿前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5513,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四","author":"汪元量","text":"谢了天恩出内门，驾前喝道上将军。\n白旄黄钺分行立，一点猩红似幼君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5514,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五","author":"汪元量","text":"一匊吴山在眼中，楼台累累间青红。\n锦帆后夜烟江上，手抱琵琶忆故宫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5515,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其六","author":"汪元量","text":"北望燕云不尽头，大江东去水悠悠。\n夕阳一片寒鸦外，目断东西四百州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5516,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其七","author":"汪元量","text":"十数年来国事乖，大臣无计逐时挨。\n三宫今日燕山去，春草萋萋上玉阶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5517,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其八","author":"汪元量","text":"锦帆高揭绣帘开，鼍鼓声悲凤管哀。\n月子纤纤云里见，吴江不尽暮潮来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5518,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其九","author":"汪元量","text":"一出宫门上画船，红红白白艳神仙。\n山长水远愁无那，又见江南月上弦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5519,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十","author":"汪元量","text":"太湖风起浪头高，锦柁摇摇坐不牢。\n靠著篷窗垂两目，船头船尾烂弓刀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5520,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十一","author":"汪元量","text":"昨夜三更泪湿腮，伍胥何事梦中来。\n三宫从此相分别，自勒潮头白马回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5521,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十二","author":"汪元量","text":"受降城下草离离，寒食清明只自悲。\n汉寝秦陵何处在，莺花无主雨如丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5522,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十三","author":"汪元量","text":"金陵昨夜有降书，更说扬州一战输。\n淮北淮南清未了，又添军马下东吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5523,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十四","author":"汪元量","text":"铁瓮城头马乱嘶，金陵城下炮如飞。\n黑风捲地鼓鼙急，昨夜常州又受围。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5524,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十五","author":"汪元量","text":"晓来宫棹去如飞，掠削鬟云浅画眉。\n风雨凄凄能自遣，三三五五坐弹棋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5525,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十六","author":"汪元量","text":"暮雨潇潇酒力微，江头杨柳正依依。\n宫娥抱膝船窗坐，红泪千行湿绣衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5526,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十七","author":"汪元量","text":"晓鬓鬅松懒不梳，忽听人说是南徐。\n手中明镜抛船上，半揭篷窗看打鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5527,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十八","author":"汪元量","text":"京口沿河卖酒家，东边杨柳北边花。\n柳摇花谢人分散，一向天涯一海涯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5528,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其十九","author":"汪元量","text":"满船明月夜鸣榔，船上宫人烧夜香。\n好是烧香得神力，片帆稳送到渔阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5529,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十","author":"汪元量","text":"一片淮山落照中，开船忽遇打头风。\n行军元帅传言语，别拨官军下浙东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5530,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十一","author":"汪元量","text":"扬子江头潮退迟，三宫船傍钓鱼矶。\n须臾风定过江去，不奈林间杜宇啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5531,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十二","author":"汪元量","text":"一半淮江半浙江，怒潮日夜自相撞。\n扬州昨夜军书至，说道淮安未肯降。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5532,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十三","author":"汪元量","text":"晓来潮信暂相留，满耳惊涛愁复愁。\n月殿不知何处在，锦帆摇曳到扬州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5533,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十四","author":"汪元量","text":"金屋煌煌丽九天，朝歌夜舞艳神仙。\n寻常只道西湖好，不识淮南是极边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5534,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十五","author":"汪元量","text":"风雨声中听棹歌，山炰野馔奈愁何。\n雪花淮白甜如蜜，不减江珧滋味多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5535,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十六","author":"汪元量","text":"九出琼花一夜开，无双亭曲小徘徊。\n可怜后土空祠宇，望断韦郎不见来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5536,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十七","author":"汪元量","text":"两淮战鼓不停挝，万骑精兵赛夜叉。\n破阵焚舟弹指顷，汉人犹误夏爷爷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5537,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十八","author":"汪元量","text":"官军两岸护龙舟，麦饭鱼羹进不休。\n宫女垂头空作恶，暗抛珠泪落船头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5538,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其二十九","author":"汪元量","text":"都人不识有干戈，罗绮丛中乐事多。\n一夜月明天漠漠，汉人歌罢楚人歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5539,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十","author":"汪元量","text":"太皇太后过江都，遥指淮山似画图。\n抛却故家风雨外，夜来归梦绕西湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5540,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十一","author":"汪元量","text":"万骑横江泣鼓鞞，千枝画角一行吹。\n淮南今夜好明月，船上美人空泪垂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5541,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十二","author":"汪元量","text":"芦荻飕飕风乱吹，战场白骨暴沙泥。\n淮南兵后人烟绝，新鬼啾啾旧鬼啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5542,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十三","author":"汪元量","text":"不堪回首泪盈盈，万里淮河听雨声。\n莫问萍齑并豆粥，且餐麦饭与鱼羹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5543,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十四","author":"汪元量","text":"宰执连镳向北行，淮南夜夜鬼灯青。\n虽然适意无南北，生死难逃筛下星。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5544,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十五","author":"汪元量","text":"更阑炙烛绣檐遮，卸却金钿与翠花。\n心似乱丝眠不得，江楼中夜咽悲笳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5545,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十六","author":"汪元量","text":"两淮极目草芊芊，野渡灰馀屋数椽。\n兵马渡江人走尽，民船拘敛作官船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5546,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十七","author":"汪元量","text":"宫人清夜按瑶琴，不识明妃出塞心。\n十八拍中无限恨，转弦又奏广陵音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5547,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十八","author":"汪元量","text":"青天澹澹月荒荒，两岸淮田尽战场。\n宫女不眠开眼坐，更听人唱哭襄阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5548,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其三十九","author":"汪元量","text":"翠鬟半亸倦梳妆，杨柳风前阵阵凉。\n弦索懒拈缩纤手，龙涎犹嚼口脂香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5549,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十","author":"汪元量","text":"凤管龙笙处处吹，都民欣乐太平时。\n宫娥不识兴亡事，犹唱宣和御制词。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5550,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十一","author":"汪元量","text":"可怜河畔草青青，锦缆牵江且缓行。\n爱此淮南山水好，问天乞得片时晴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5551,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十二","author":"汪元量","text":"丞相催人急放舟，舟中儿女泪交流。\n淮南渐远波声小，犹见扬州望火楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5552,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十三","author":"汪元量","text":"拨尽琵琶意欲悲，新愁旧梦两依依。\n江楼吹笛三更后，细雨灯前醉玉妃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5553,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十四","author":"汪元量","text":"篷窗倚坐酒微酣，淮水无波似蔚蓝。\n双橹咿哑摇不住，望中犹自是江南。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5554,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十五","author":"汪元量","text":"销金帐下忽天明，梦里无情亦有情。\n何处乱山可埋骨，暂时相对坐调笙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5555,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十六","author":"汪元量","text":"宫人夜泊近人家，瞥见红榴三四丫。\n犹说初离行在所，玉阑无数牡丹花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5556,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十七","author":"汪元量","text":"丝雨绵云五月寒，淮堧遗老笑儒冠。\n行军元帅来相探，折送驼峰炙一盘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5557,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十八","author":"汪元量","text":"江头杨柳舞婆娑，万马成群啮短莎。\n北客醉中齐拍手，隔船又唱采茶歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5558,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其四十九","author":"汪元量","text":"长淮风定浪涛宽，锦棹摇摇上下湾。\n兵后人烟绝稀少，可胜战骨白如山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5559,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十","author":"汪元量","text":"使臣开闸过高邮，杨柳丝丝拂去舟。\n宫女开篷犹自笑，閒抛金弹打沙鸥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5560,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十一","author":"汪元量","text":"邵伯津头闸未开，山城鼓角不胜哀。\n一川霞锦供行客，且掬荷香进酒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5561,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州歌九十八首 其五十二","author":"汪元量","text":"北风吹雨入篷间，宫女腰肢瘦怯寒。\n阿监隔船相借问，计程今日到淮安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5562,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]