[{"title":"夏景 行云递崇高","author":"刘辰翁","text":"自不容无雨，行云尽日劳。\n来来方汗漫，递递看崇高。\n一气埋飞鸟，层阴压戴鳌。\n前驱淝水阵，后至浙江涛。\n羊角天帆席，龙身海桔槔。\n鸿蒙惊久别，握手重相遭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10244,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 讼风伯","author":"刘辰翁","text":"岂敢讼穹穹，何堪败愿丰。\n云乎难致雨，伯也实司风。\n长是垂将合，吹之使不同。\n不思商怨后，但霸楚称雄。\n已脱知臣罪，不诛无岁功。\n皇恩惩使悔，终念小心仝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10245,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 亭深到芰香","author":"刘辰翁","text":"十里荒寒地，亭空暑不侵。\n能令尘土外，更到芰荷深。\n水阁临风迥，莲舟隔浦寻。\n红妆风四面，翠倚月中心。\n此处闲搔首，何人泣露襟。\n拍浮宜有酒，乱挽碧筒斟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10246,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 蝉声集古寺","author":"刘辰翁","text":"此寺创何年，人间几变迁。\n山空千万古，声集两三蝉。\n振木缲馀茧，凭风咽断弦。\n助成骚国晚，惊破少林禅。\n喧寂闻尘外，炎凉落照边。\n客来悲世事，虫语暮钟连。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10247,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 绿荷雨跳珠","author":"刘辰翁","text":"荷外雨潇潇，舟如泊断桥。\n忽惊红粉乱，又见绿珠跳。\n万叶明苍水，轻风问步摇。\n疏疏沾羽盖，点点溅鲛绡。\n玉露明金掌，红妆湿翠翘。\n佩痕留不得，立地使魂销。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10248,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 扇枕","author":"刘辰翁","text":"千古一黄香，庭萱昼日长。\n枕闲非受热，扇举欲先凉。\n畏暑侵支发，摇风愿满堂。\n恨无寒水玉，琢在碧纱床。\n泉涧心如棘，瑶池鬓已霜。\n如何荀奉倩，只在玉人傍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10249,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 云雨觉虚无","author":"刘辰翁","text":"天欲今朝雨，云如满八区。\n居然同愿望，如此竟虚无。\n鹏运风犹黑，龙光电又驱。\n遂成神女梦，误拟阿香呼。\n酷吏踰前憯，馀民绝望苏。\n皇心终不测，变化属须臾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10250,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 高风动秋声","author":"刘辰翁","text":"万窍忽争号，南风动地豪。\n此声何处起，到地似秋高。\n草木波颓靡，乾坤暑战鏖。\n有人推户外，无叶下庭皋。\n寒扇怜孤影，征鞍感二毛。\n豪鹰双角耸，无计剪蓬蒿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10251,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 清风左右至","author":"刘辰翁","text":"风于万里外，飞动故人情。\n如许殷勤至，居然左右清。\n吹潮成雪色，入竹已秋声。\n佩玉丁丁起，台襟翼翼生。\n玉川从此去，列子御之行。\n邂逅浮丘老，相携上五城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10252,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 乞巧文","author":"刘辰翁","text":"能拙吾无比，高灵昔有闻。\n不知天下巧，乞以世间文。\n果列空庭露，香浮入汉云。\n天孙何冉冉，柳子盖云云。\n有说能要我，无才可赠君。\n绛衣持节后，穷达竟何分。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10253,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 晒书","author":"刘辰翁","text":"芸香天上宴，不到野人居。\n见说星期夕，闲将腹晒书。\n笑人操犊鼻，容我辟蟫鱼。\n小勿欺椰子，中从著石渠。\n从他便是懒，乞汝巧相如。\n此日何堪负，馀暄献纳疏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10254,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 牛女年年渡","author":"刘辰翁","text":"牛女是谁传，灵桥不待船。\n昔年曾此渡，每渡似初年。\n此夕须停织，何人更服牵。\n星期无了日，河水尚依然。\n岁晚长疏隔，人间早弃捐。\n瑶池人独处，搔首待君还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10255,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 机丝虚夜月","author":"刘辰翁","text":"不见机边女，当时独月知。\n坐令如此夜，虚却理残丝。\n缲得扶桑茧，张成锦字词。\n弦光空到晓，花影不侵帷。\n尺寸知何用，须臾即别离。\n小窗思妇懒，不是恤周嫠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10256,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 秋空日凌凌","author":"刘辰翁","text":"最是秋空恝，秋田诉不应。\n夜占常悄悄，日复觉凌凌。\n何似春工恻，无端地气腾。\n双眉频望极，八翼愈难升。\n其雨今若此，如云亦未曾。\n小心风不上，涕泗日沾膺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10257,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 吹笛月明中","author":"刘辰翁","text":"何处吹长笛，千年恨未终。\n关山人去后，秋夜月明中。\n旷野参差久，寒江滉漾通。\n曲终郿县坞，怨彻广寒宫。\n海外阴晴异，天涯慷慨同。\n江南回首处，歌罢水流东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10258,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 清辉玉臂寒","author":"刘辰翁","text":"待得清辉满，中秋两地看。\n丹心空自苦，玉臂故应寒。\n银汉成冰水，金波满露盘。\n西风罗袖薄，落月杵声残。\n身世谁知苦，裳衣客最单。\n关山同杜老，垂泪忆长安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10259,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 月满秋夜长","author":"刘辰翁","text":"尘世如天海，团团共月光。\n一轮秋正满，百刻夜偏长。\n端正惟三五，空明更十方。\n萃台犹卓午，梧井欲飞霜。\n箭漏迷青海，阑干转上阳。\n雪痕留得在，何用促扶桑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10260,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其一 月色醉远客","author":"刘辰翁","text":"明月有佳色，客中迷远游。\n自应眠不得，更似醉时留。\n玉屑凉堪吸，金波香欲浮。\n顿忘乡国恨，如在酒家楼。\n鸾镜惊相对，霓裳卒未休。\n天风扶我起，不用典貂裘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10261,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其二 月色醉远客","author":"刘辰翁","text":"远客坐长夜，缠绵月色留。\n明知不是醉，为尔更无愁。\n玉雪三千界，金波十二楼。\n谪仙迷采石，小杜在扬州。\n雁背如流水，蛾眉也白头。\n一声长啸起，满眼故山秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10262,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 卿月升仙掌","author":"刘辰翁","text":"卿在郎星上，瑶台第一层。\n已如金掌迥，又得月华升。\n近与公相似，清如贵未曾。\n铜仙千尺表，玉指一轮冰。\n天下名公子，秋风老茂陵。\n衰兰千里道，垂泪记觚棱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10263,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 把钓待秋风","author":"刘辰翁","text":"长夏如年日，萧然把钓终。\n欲知临水意，政自待秋风。\n岂是羊裘者，相从渔社中。\n何心思觅鲙，极目望来鸿。\n天下无知己，溪边自老翁。\n六鳌闲入手，不是学任公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10264,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 秋风白云飞","author":"刘辰翁","text":"风起秋尘外，山空海又围。\n疏疏黄叶外，渺渺白云飞。\n扫地驱残暑，林烟带落晖。\n空明仙仗过，夭矫玉龙归。\n中野悲游子，苍梧迎帝妃。\n回首汾水上，不觉泪沾衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10265,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 秋风思鲈莼","author":"刘辰翁","text":"秋风已如此，游子复何为。\n蕉鹿空形役，莼鲈绕梦思。\n凉天新雁过，旅思白鸥知。\n雪色松江鲙，银光笠泽丝。\n人生归去好，乡味寄来迟。\n尚觉姜难致，令人忆左慈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10266,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 闭门感秋风","author":"刘辰翁","text":"世路故当穷，兴亡一转蓬。\n闭门羞俗子，仰屋感秋风。\n旧日施行马，如今掩候虫。\n瞭然一叶下，从此万山空。\n岁月玄蝉槁，乾坤白雁通。\n荒凉今又在，吹笛月明中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10267,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 秋高风怒号","author":"刘辰翁","text":"万里秋风下，还惊扫地高。\n不因茅屋怒，全向树梢号。\n寥廓归云尽，荒寒晚吹豪。\n黑摧淝水阵，白卷浙江涛。\n过耳鸣鹘羽，连山掣戴鳌。\n空林无落叶，拾得海凫毛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10268,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 夜雨更秋风","author":"刘辰翁","text":"世事惟孤枕，吾生尚转蓬。\n共谁堪夜雨，何意更秋风。\n已是霖铃苦，何当刻漏终。\n又闻翻溟滓，不是滴梧桐。\n衰壑鸣蛩外，寒灯落叶中。\n忽明天似水，万里附冥鸿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10269,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 秋风生桂枝","author":"刘辰翁","text":"又胜春风处，秋芳宇宙清。\n由来天路远，几许桂枝生。\n古道寒云色，空山落叶声。\n忽看金粟缀，如在蕊宫行。\n香入铜盘饮，根愁玉斧惊。\n小山人倚袖，延伫不胜情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10270,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 疏雨滴梧桐","author":"刘辰翁","text":"疏雨兼长夜，巴山信未通。\n寥寥深院落，滴滴在梧桐。\n泪与檐相续，听如漏未终。\n寒飘金井上，愁入碧阶空。\n楚水孤蓬暝，吴宫落叶红。\n霖铃南内晓，今古此声中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10271,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 风雨近重阳","author":"刘辰翁","text":"白发惊秋晚，青云认故乡。\n乾坤愁老眼，风雨近重阳。\n吹得沾衣湿，寒添落帽狂。\n未知明日是，还忆去年将。\n北阙风流远，东篱世故长。\n无人知叔子，登览自怜伤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10272,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 于今九日至","author":"刘辰翁","text":"九日各堪爱，西风岁岁深。\n长因思往事，忽已至于今。\n不谓秋将晚，几如老见侵。\n篱边成独往，天际起轻阴。\n此会知谁健，明朝肯重寻。\n山高休更上，别自有伤心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10273,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 窗空雨声晚","author":"刘辰翁","text":"枕上闻秋雨，愁声万古同。\n孰知残夜晓，冷浸一窗空。\n窈窕闲筝雁，交疏结网虫。\n卧听千叶雨，不似五更风。\n渭水人分内，巴山客梦中。\n山城清漏断，惟是滴梧桐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10274,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 悠然见南山","author":"刘辰翁","text":"异代羲皇上，馀生晋宋间。\n悠然无一事，政尔见南山。\n西曲风流远，东篱意思闲。\n吹衣凉浩荡，矫首碧孱颜。\n双蝶来何晚，白云相与还。\n是中秦博士，相识少相关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10275,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 寒城菊自花","author":"刘辰翁","text":"菊满荒城道，馀生一笑难。\n地非行乐旧，花自向人寒。\n风雨何登览，江山共屈蟠。\n无人簪帽去，有蝶绕篱看。\n此处尤堪赏，明朝已是残。\n渊明生晋晚，不及禊高兰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10276,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 十日菊","author":"刘辰翁","text":"一年看九九，十日见炎凉。\n菊有霜前操，人无节后香。\n就令无宿酒，也不似重阳。\n一夜寒英老，多情旧雨黄。\n帽如前度落，蝶更几时忙。\n我不知何夕，相收足晚凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10277,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 客愁连蟋蟀","author":"刘辰翁","text":"梧桐惊客梦，去住两茫然。\n晓觉鸡鸣未，愁惟蟋蟀连。\n江湖无汉地，家世本秦川。\n唧唧月共语，涓涓人独眠。\n青灯寒四壁，衰鬓织千年。\n唐晋他人有，荒凉故殿前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10278,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 蛩响乱秋阴","author":"刘辰翁","text":"蛩响何千百，人情自不禁。\n馀哀动邻壁，最苦乱秋阴。\n泣尽相思梦，惊残劝织心。\n露深虫语语，月黑雁沈沈。\n坏壁岁年远，长门日夜深。\n手摩铜雀雨，和汝一长吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10279,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 鹤唳清露垂","author":"刘辰翁","text":"一叶寒金井，惟应独鹤知。\n空山今夕泪，清露满空垂。\n华表归来后，琴心感慨时。\n寥寥天不问，湛湛夜何其。\n富贵朝田薤，琅玕月地芝。\n人间长似水，搔首梦为谁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10280,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其一 门掩候虫秋","author":"刘辰翁","text":"四壁可谁语，一年将次休。\n村行落叶晚，门掩候虫秋。\n影有斜灯吐，贫无过客偷。\n蚓号残月冷，蛩语故宫愁。\n馆驿邻机叹，关山古戍留。\n幽人推梦起，江海有孤舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10281,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其二 门掩候虫秋","author":"刘辰翁","text":"候虫鸣寂寂，秋老独何村。\n怨语动行路，居人卧掩门。\n无谁倚朱户，随意闭黄昏。\n岁暮已如此，蛩声胡与言。\n孤灯销驿梦，残月落空垣。\n白雁来天地，何由见泪痕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10282,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 天清木叶闻","author":"刘辰翁","text":"天意清如水，何曾染世氛。\n秋风何处起，木叶朅来闻。\n野有牛羊下，高无鸿雁群。\n凉惊枝上坠，声向静中分。\n霜井婵娟泪，冰沟冥漠君。\n断肠题柿湿，一半是行云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10283,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其一 出逢危叶落","author":"刘辰翁","text":"举眼秋萧索，乾坤岂不容。\n叶因危后落，身是出时逢。\n古木犹当道，西风小倚筇。\n峥嵘如解羽，零乱复寒蛩。\n薄似佳人命，飘如去国踪。\n小山留我止，香月自重重。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10284,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其二 出逢危叶落","author":"刘辰翁","text":"四顾欲何之，逢秋出自悲。\n万山青未了，一叶落何危。\n未肯哀穷巷，还因立别歧。\n有风惊槁木，如鸟坠高枝。\n梧柳同如此，江湖事可知。\n月明疏影出，踏踏露巢攲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10285,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 远客坐长夜","author":"刘辰翁","text":"身是秋风客，游梁更赋梁。\n此时家在远，独坐夜偏长。\n岁月黑貂晚，江湖白雁霜。\n乌皮人兀兀，蟾影海茫茫。\n扣角馀三叹，闻鸡悄四荒。\n炉烟秋伏枕，谁念待班行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10286,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 芙蓉红岸湿","author":"刘辰翁","text":"岸柳似衰容，高花忽数重。\n红光荡人意，清露湿芙蓉。\n秾丽秋深见，攀翻木末逢。\n便疑江濯锦，不是隰游龙。\n寒倚惊裙溅，云归悄梦踪。\n霜风多意思，残日挂高舂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10287,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 庭榴剖朱实","author":"刘辰翁","text":"榴压中庭坠，冰盘荐玉壶。\n西风吹转绿，嘉实剖来朱。\n摘向栏干近，安除海外无。\n微醺揎绛袖，一笑灿明珠。\n酸彻邻机齿，凉生浴锦肤。\n冷思当日艳，血色盛罗襦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10288,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 雁南归","author":"刘辰翁","text":"天阔雁何之，沈云字字稀。\n明知从北至，又说是南归。\n兵气侵行急，河声背影微。\n江湖霜信远，城郭主人非。\n不惜惊弦得，惟忧系帛遗。\n河梁人惜别，似尔不能飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10289,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其一 鹭于飞","author":"刘辰翁","text":"沧洲开晚景，莽苍更依稀。\n有鹭从中起，于天尽处飞。\n数丝风冉冉，一片雪晖晖。\n外路迷乡国，天风起我衣。\n远游寻鹤侣，近不为鱼肥。\n西塞山边雨，渔蓑独自归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10290,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 其二 鹭于飞","author":"刘辰翁","text":"鹭闲如可语，飞去复何图。\n但见振兮振，不知于此于。\n难令公子浊，似是列仙癯。\n近逼孤云小，遥看点雪无。\n沧洲何尔我，白发自江湖。\n风雨鱼歌外，玄真逝与俱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10291,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 时菊委严霜","author":"刘辰翁","text":"论菊何心傲，生时失众芳。\n未须多晚节，政似委严霜。\n北地飞飞击，东篱冉冉黄。\n屑冰和露下，薄命有谁当。\n客去重阳远，花寒一夜长。\n朝来有佳色，未放早梅香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10292,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 江动月移石","author":"刘辰翁","text":"石是龙眠处，终无石可扛。\n未应江动月，自是月移江。\n本似岷山雪，今为岭表泷。\n是谁惊兔杵，失却钓鱼矼。\n投渚天为碎，蹲磻影忽双。\n桂轮无侧匿，眼眼似窥窗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10293,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 日出篱东水","author":"刘辰翁","text":"雨以田为壑，疏篱野水中。\n忧天沈到底，有日出其东。\n或谓扶桑巧，谁知梦峡空。\n勿朝蓬海白，满眼菊花红。\n屐响初来客，墙暄到老翁。\n洗光吾镜曲，一笑弄丸同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10294,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 夕阳如有意","author":"刘辰翁","text":"又自欲昏黄，高高上夕阳。\n殷勤如有意，迟暮起相望。\n牛背笛三弄，桑榆锦一张。\n向人添晼晚，容我更疏狂。\n过雨天如改，穿花日尚长。\n鲁阳三舍远，人世未须忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10295,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋景 山园细路高","author":"刘辰翁","text":"不是终南径，山中取遁逃。\n小园何所有，细路未应高。\n已恨锄荒菊，何堪弹种桃。\n梯飙那可上，镵雪误相遭。\n石卧当途虎，藤穿汲涧猱。\n天机分瀑布，应念瓮畦劳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10296,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬景 冬日可爱","author":"刘辰翁","text":"此日荷天公，宁须挟纩重。\n一寒偏更老，可爱莫如冬。\n不恨乘驹隙，犹愁闭烛龙。\n身如花正午，春入眼偏浓。\n有喜融霜鬓，何堪借酒容。\n至尊何处在，流涕献无从。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10297,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬景 负暄","author":"刘辰翁","text":"虽霜晴可爱，容我俯前轩。\n纵是围燕玉，何如负赵暄。\n自怜鲐背痒，敢负太阳恩。\n已觉曲身直，犹胜挟纩温。\n衰年知潦倒，造物足温存。\n尚有葵心在，何因献至尊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10298,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬景 地炉煨榾柮","author":"刘辰翁","text":"片地为炉古，长镵斫雪来。\n蒲团容膝坐，榾柮向人煨。\n凿破昆山璞，方如煖阁开。\n一根深雨露，四壁涨烟煤。\n光怪浮螭吻，云星拨芋魁。\n朱门香兽拥，何意早成灰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10299,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬景 舟雪洒寒灯","author":"刘辰翁","text":"舟雪那知重，惊沙洒未乾。\n暮云千里合，远客一灯寒。\n飞絮漫空起，推蓬倚醉看。\n风缸青闪闪，水驿白漫漫。\n隔岸如渔火，无人共钓滩。\n闭门安道梦，月黑溯归难。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10300,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]