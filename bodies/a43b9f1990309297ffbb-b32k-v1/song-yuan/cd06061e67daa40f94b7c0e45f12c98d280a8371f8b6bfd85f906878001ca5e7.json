[{"title":"次刘晓窗九日韵 其七","author":"杨公远","text":"菊花偏作道家妆，开遍重岩与断冈。\n醉后折来簪短鬓，老夫翻学少年狂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5032,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次刘晓窗九日韵 其八","author":"杨公远","text":"黄花堆积若钱流，妆点诗家富贵秋。\n元亮不将渠贳酒，空留遗恨尚悠悠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5033,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次刘晓窗九日韵 其一","author":"杨公远","text":"门前何用白衣来，旋买官醪亦可杯。\n笑问黄花前日事，未生陶令为谁开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5034,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次江草塘","author":"杨公远","text":"西堂梦彻草塘春，得句浑无半点尘。\n却喜寥寥千古后，只今分付与诗人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5035,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次吴友梅假山韵","author":"杨公远","text":"石骨嵌岩耸怪形，主人对此快诗情。\n若教老笔来模仿，盘礴终朝画不成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5036,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次吴篁屿山行","author":"杨公远","text":"诘曲深林小径斜，杖藜徐步访山家。\n老翁□□无祗待，禁酒官严又禁茶。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5037,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋七夕雨 其一","author":"杨公远","text":"自笑生来作么为，百无一解太痴愚。\n今宵欲觅天孙巧，未审天孙乞我无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5038,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋七夕雨 其三","author":"杨公远","text":"人言此夕会双星，騃女痴儿竞乞灵。\n学织学耕非我事，何如牛角自横经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5039,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋七夕雨 其二","author":"杨公远","text":"织女河边渡鹊桥，风吹仙袂举飘飘。\n洗车一夜霶?雨，图得人间起旱苗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5040,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋菊花五绝 其四","author":"杨公远","text":"千花万卉已俱亡，独占秋光点点黄。\n露冷霜浓难著脚，甘心宁耐此荒凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5041,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋菊花五绝 其五","author":"杨公远","text":"万木归根叶渐空，淡烟斜照有无中。\n客怀对此无情思，赖有知心老菊丛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5042,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋菊花五绝 其一","author":"杨公远","text":"东篱粲处正秋高，气骨清寒等孟郊。\n试问群芳谁是侣，梅花差可作平交。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5043,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋菊花五绝 其三","author":"杨公远","text":"细嚼芳英清肺腑，离骚一语传千古。\n灵均去后谁知心，幸有柴桑人作主。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5044,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋菊花五绝 其二","author":"杨公远","text":"凡卉徒妖迥不同，输渠篱下自丛丛。\n趋时未肯隐君子，毕竟依然带晋风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5045,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其七","author":"杨公远","text":"战伐已闻初卸甲，耘耔却喜近添丁。\n明年小稔应堪望，雪后平畴宿麦青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5046,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其五","author":"杨公远","text":"尝稻翻匙誇白雪，腰镰荷担刈黄云。\n逢人谩说空辛苦，偿债输官费九分。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5047,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其四","author":"杨公远","text":"趁雨足时翻畎亩，插秧遍后便耔耘。\n愿天频把甘霖霔，伫看丰年万顷云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5048,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其三","author":"杨公远","text":"迟日丽时秧刺水，午风暄处麦掀髯。\n一村桃杏红如锦，旋数青铜傍酒帘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5049,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其二","author":"杨公远","text":"林下攲倾茅草屋，门前诘曲竹笆篱。\n数声清笛知何处，牛背斜阳牧竖吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5050,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其一","author":"杨公远","text":"买酒割鸡祠社后，踏歌搥鼓闹清明。\n柔桑叶长蚕苗出，从此关门禁客行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5051,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其五","author":"杨公远","text":"爱玄真子吟佳句，笑老姜公用直钩。\n一片水乡供活计，四时风月在扁舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5052,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其八","author":"杨公远","text":"风紧岸边安钓艇，云浓空里散杨花。\n披蓑顶笠携鱼去，遥指前村问酒家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5053,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其七","author":"杨公远","text":"那有清霜来鬓上，略无閒事上眉头。\n傍人借问家何处，一叶轻舟水面浮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5054,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其四","author":"杨公远","text":"经行苇荻沙头熟，出没风涛胆气粗。\n博得酒归明月夜，呼儿作脍旋批鲈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5055,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其三","author":"杨公远","text":"醉来要把鹏为饵，夜后长将月作钩。\n浮利浮名浑不问，数声欸乃转船头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5056,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其二","author":"杨公远","text":"篙撑舴艋閒来往，手把丝纶自卷舒。\n妻子已谙风露惯，篷窗便可当茅庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5057,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次敏斋陈先生月艇","author":"杨公远","text":"小池新舣野航轻，分得江湖一段清。\n最是好天良月夜，婵娟冷浸入窗明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5058,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵塞下曲","author":"杨公远","text":"貂裘毡帽紫骅骝，挟弹弯弧架铁矛。\n飞放归来天欲暮，数声羌笛起高楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5059,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬孙艮斋 其三","author":"杨公远","text":"想倚危楼十二阑，诗成可是过方干。\n好风吹堕寒窗底，胜得仙翁九转丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5060,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬孙艮斋 其二","author":"杨公远","text":"风竹萧萧密掩门，苔封支径曲通村。\n野人自有家林趣，那得荣华入梦魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5061,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵酬孙艮斋 其一","author":"杨公远","text":"抱膝孤吟欠范模，愿随鸡犬藉丹炉。\n傥能化得尘凡骨，差胜无声水墨图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5062,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江天莫雪","author":"杨公远","text":"垂垂四幕冻云顽，万木号风晚更寒。\n系缆渔人归去后，乱飞柳絮满江干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5063,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"池塘生春草","author":"杨公远","text":"燕寝凝香梦更清，梦回得句快吟情。\n可怜人化辽天鹤，池上年年草自生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5064,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"红梅","author":"杨公远","text":"特立孤高耐岁寒，渥丹颜貌带儒酸。\n荆公诗句休拈出，北地人今已熟看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5065,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观中桃花次友人韵","author":"杨公远","text":"琳宫深处小桃红，当日玄都事已空。\n今见花开浑似旧，不知又隔几春风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5066,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观梅","author":"杨公远","text":"东阁观梅效少陵，巡檐索笑面生春。\n试将心事从渠道，恰又无言领略人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5067,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"许侯赠诗借韵谢 其二","author":"杨公远","text":"政彻宸旒久有声，何消入梦更图形。\n行看大展经纶手，整顿乾坤万国宁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5068,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"许侯赠诗借韵谢 其一","author":"杨公远","text":"挥洒云烟笔有神，衮褒字字烛吾真。\n从今诗画多增重，寒谷顿回天地春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5069,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"访梅","author":"杨公远","text":"荒寒茅屋是谁家，独木桥横小径斜。\n却是无人行到处，春风先已到梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5070,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"折梅","author":"杨公远","text":"折时须拣带苔枝，两蕊三花尽自奇。\n簪向银瓶全俗了，古铜瓶浸恰相宜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5071,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"迓王书史六邑劝课回四绝 其三","author":"杨公远","text":"杜鹃声里莫春天，桑柘村村绿似烟。\n分茧称丝将有日，吴蚕今已起三眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5072,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"迓王书史六邑劝课回四绝 其二","author":"杨公远","text":"一犁雨足快耕农，可卜今年岁事丰。\n喜见四郊生意好，秧针刺水麦梳风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5073,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"迓王书史六邑劝课回四绝 其一","author":"杨公远","text":"雕鞍骏马骤如飞，正是春风柳絮时。\n夹道居民争看处，青红小队曳旌旗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5074,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"迓王书史六邑劝课回四绝 其四","author":"杨公远","text":"匆匆出郭又经旬，和气薰蒸处处春。\n料得锦囊诗拍塞，寄来曾拜一篇新。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5075,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"远浦归帆","author":"杨公远","text":"江山胜处簇人家，楼阁重重枕水涯。\n试倚阑干凝望眼，帆归远浦隔芦花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5076,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"迟梅","author":"杨公远","text":"尽道孤根逗暖回，缘何春至未胚胎。\n东皇想是怜孤独，留与群芳作伴开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5077,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闰九日","author":"杨公远","text":"九日重逢恼肺肠，世情底事便炎凉。\n今朝有酒还堪醉，不信黄花不复香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5078,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"始生书怀 其三","author":"杨公远","text":"一片閒云出岫迟，诗情画思老来宜。\n莫言末技浑无用，传入鸡林未可知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5079,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"始生书怀 其二","author":"杨公远","text":"浮生六十度春秋，无辱无荣尽自由。\n但得此身强健在，明年花甲又从头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5080,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"始生书怀 其一","author":"杨公远","text":"连年客里度生朝，自草新诗慰寂寥。\n却喜窗前风景好，梅花初放雪初消。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5081,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗坛","author":"杨公远","text":"突兀骚坛依汉立，英豪元帅凛霜威。\n四时景物知多少，一一投降听指挥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5082,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗狂","author":"杨公远","text":"掬取长江供砚水，借将碧汉作蛮笺。\n兴来拈起如椽笔，大咏高吟欲上天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5083,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗将","author":"杨公远","text":"草木森罗归队伍，溪山辽绕作城池。\n运筹决胜应无敌，郊岛从旁作鼓旗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗家","author":"杨公远","text":"松下云根迂菊径，梅边竹外著茆茨。\n天教管领閒风月，得句无非妙色丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗笔","author":"杨公远","text":"银管空虚藏兔颖，冰怀磊磈吐天葩。\n有时挥扫浑无碍，尽道毫锋自有花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗牌","author":"杨公远","text":"閒亭虚阁多标揭，旧句新篇各斗工。\n为拂尘埃题数语，敢期他日碧沙笼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗筒","author":"杨公远","text":"短篇吟了长篇续，旧韵酬成新韵催。\n一节此君缄锦绣，奚奴携去又携来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗壁","author":"杨公远","text":"一方素壁龙蛇走，几首新诗冰雪清。\n语好惊人看不足，教侬技痒动吟情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗癖","author":"杨公远","text":"生来性癖耽佳句，吟得诗成似有神。\n险语岂惟惊鬼胆，直须字字要惊人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"促织","author":"杨公远","text":"促人机杼意殊深，彻夜啾啾不绝吟。\n莫入五侯庭院去，青蛾红粉少知心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宫词","author":"杨公远","text":"燕语莺啼日正长，六宫桃李闹春光。\n妾身虽未承恩泽，却喜君恩泽万方。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其十","author":"杨公远","text":"雪霁风犹万窍号，微吟拥鼻袖无羔。\n一寒如此还风味，和得诗成句法高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其九","author":"杨公远","text":"一色寰区水墨天，了无尘翳自天然。\n惜乎官禁瓶无酒，胜赏空辜药玉船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其八","author":"杨公远","text":"数声爆竹入新年，万紫千红信息传。\n巽二搀先施妙手，花开顷刻更堪怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其七","author":"杨公远","text":"仙禽洒羽半天飞，疑是归来老令威。\n妆点江乡堪入画，渔翁披得满蓑衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其六","author":"杨公远","text":"琼林玉树竞奢华，老眼光摇眩有花。\n莫是幻成银色界，楼台胜处梵王家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其五","author":"杨公远","text":"茆檐堆积未消除，仔细观来半尺馀。\n腊后春前知几白，丰年可卜史官书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其四","author":"杨公远","text":"江梅带雪状模糊，梅雪相逢意不孚。\n雪逊无香梅逊白，雪消梅现旧头颅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其三","author":"杨公远","text":"诗梦关情草满池，东皇已向岁前归。\n怪渠杨柳摇金未，底事漫空絮便飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其二","author":"杨公远","text":"向晓披衣更拥衾，略无一事恼胸襟。\n起来点检窗前雪，地上无多屋上深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜雪再用韵 其一","author":"杨公远","text":"东风怒撼树梢鸣，冻住顽云黯不明。\n兀坐炉边閒侧耳，春虫撩乱扑窗声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残梅","author":"杨公远","text":"可惜梢头烂漫芳，无心要趁寿阳妆。\n宁教片片随风去，点在苔痕骨也香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"残梅","author":"杨公远","text":"暗香消歇粉妆残，点点虚庭碧藓间。\n却怪贫家新富贵，地茵纯用鹿胎斑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"洞庭秋月","author":"杨公远","text":"月色湖天浸岳城，芦花渺渺白铺汀。\n玻瓈万顷清无滓，只有君山一点青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]