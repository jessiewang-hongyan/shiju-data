[{"title":"绝句二首寄绍堂求巧石 其一","author":"陆文圭","text":"篱根怪石起层云，浅带春泥碧藓纹。\n乞与诗人时醒酒，也胜豪夺任监军。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6056,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句二首寄绍堂求巧石 其二","author":"陆文圭","text":"几年石友卧苍苔，曾受南宫雅拜来。\n老子暮年行脚倦，只宜窗里看崔嵬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6057,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句三首 其三","author":"陆文圭","text":"杜欲诛云师，韩将讼风伯。\n水旱不由天，那是诗人责。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6058,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句三首 其二","author":"陆文圭","text":"买丝绣平原，儗金铸子期。\n君子病无能，不病人不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6059,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句三首 其一","author":"陆文圭","text":"车薪胜杯水，舆羽重钩金。\n物理元无定，权衡只在心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6060,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句留别善之仲实并呈松涧云仲无逸四首 其四","author":"陆文圭","text":"老桧荣枯不计春，好花开落止经旬。\n莫将文翰誇馀子，共拟勋名及古人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6061,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句留别善之仲实并呈松涧云仲无逸四首 其三","author":"陆文圭","text":"江上春云生暮寒，故城回首离长安。\n残桃剩柳应无分，留与诸君取次看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6062,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句留别善之仲实并呈松涧云仲无逸四首 其二","author":"陆文圭","text":"手拈花草弄春愁，儿女安知稼穑秋。\n山北山南游未遍，归欤且复事西畴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6063,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"绝句留别善之仲实并呈松涧云仲无逸四首 其一","author":"陆文圭","text":"今夜征帆浅渚边，何时樽酒落花前。\n白云绕舍归心切，不为春林听杜鹃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6064,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追和四绝 其三","author":"陆文圭","text":"三十寻思拟学仙，蹉跎已过古稀年。\n一生只作邯郸梦，枕上奇方秘不传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6065,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追和四绝 其一","author":"陆文圭","text":"文士多婴疾与贫，浩然东野即其人。\n唱酬从此诗筒简，炮炙时于药裹亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6066,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追和四绝 其四","author":"陆文圭","text":"卧看山云起石根，意行随犬至前村。\n廛居自是无人识，何必移家上鹿门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6067,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送吴仲鲁回乌江二首 其二","author":"陆文圭","text":"黄田西望历阳城，风水萧萧数日程。\n纸上陈言刊落尽，沧浪时听棹歌声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6068,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送吴仲鲁回乌江二首 其一","author":"陆文圭","text":"老人白帽子青衿，二水相滋兑泽深。\n易学已随丁氏去，金兰何日慰同心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6069,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送李义夫出游二首 其二","author":"陆文圭","text":"三千丈发从渠脱，九十日春须我游。\n出却草堂三五里，囊中无得一钱留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6070,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送李义夫出游二首 其一","author":"陆文圭","text":"梅花卸玉春寒浅，柳色描金雪意消。\n老子偶然诗兴动，又挑行李过溪桥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6071,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送祝君晟湖州提领案牍","author":"陆文圭","text":"幕府今何处，青山水绕城。\n乌程有美酒，还肯饷春耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6072,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送唐孟方教授三首 其三","author":"陆文圭","text":"城东老圃旧书生，紧闭柴门懒送迎。\n独袖篇诗与君别，相看白首不胜情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6073,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送唐孟方教授三首 其二","author":"陆文圭","text":"禦儿溪北浣征衣，重拂苍苔旧钓矶。\n有弟对床思久别，呼儿置酒话迟归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6074,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送唐孟方教授三首 其一","author":"陆文圭","text":"泮水三年惟饮水，不知芹藻味何如。\n群鸮无故争桑葚，挟弹何人莫问渠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6075,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送留君玉高云卿自江阴迁松江四绝 其四","author":"陆文圭","text":"暨州风土今非昔，安得珠犀贾客船。\n莫笑归装无一物，江头鱼蟹亦论钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6076,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送留君玉高云卿自江阴迁松江四绝 其二","author":"陆文圭","text":"江浦买鲈秋正美，山亭闻鹤夜尤清。\n送君此去因怀古，海水东来意未平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6077,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送留君玉高云卿自江阴迁松江四绝 其一","author":"陆文圭","text":"二君才斡俱优裕，数载相从意未休。\n短棹西风吹过泖，相思霜月落南州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6078,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夕二首呈北溪 其二","author":"陆文圭","text":"杯盘今日偶相逢，客路飘飘过一冬。\n为问玉堂春帖子，不知学士有谁供。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6079,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桂松岩以子平星禽二术推人多验戏赠二绝 其二","author":"陆文圭","text":"异类于人总不干，止闻列宿应郎官。\n区区女蝠并危燕，却与蛟龙一例看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6080,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桃源县","author":"陆文圭","text":"张家桥西车马尘，北风刮地眯行人。\n篱落枯桃三五树，不应此地可逃秦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6081,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"留别袁伯长待制凌德庸少监周南翁待制诸公三绝句 其三","author":"陆文圭","text":"狞狞虎豹守天关，月殿蟾宫不可攀。\n归路春风无限好，一声啼鸟破青山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6082,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病中四绝 其二","author":"陆文圭","text":"老去无憀病转多，樱桃杨柳奈情何。\n故人又比佳人薄，莫怪门前雀可罗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6083,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病中四绝 其一","author":"陆文圭","text":"南山处士老尤贫，颇恨故交无一人。\n若使知心得良友，更因多病转相亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诸生和韵复吟三绝 其一","author":"陆文圭","text":"荒城戍卒打残更，道上无人天未明。\n一似衔枚蔡州去，只无鹅鸭混军声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史六首 其五","author":"陆文圭","text":"晓看嵩少玉嶙峋，枉驾应怜处士贫。\n令尹若能为保障，长衾尽覆洛城人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史六首 其四","author":"陆文圭","text":"广陵琴与山阳笛，哀怨千年尚未平。\n正始诸贤零落尽，山王去作晋公卿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史六首 其三","author":"陆文圭","text":"旷怀雅思人人有，济世经邦事事无。\n终日醉眠呼不醒，明朝典午代当涂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史六首 其二","author":"陆文圭","text":"暮年百事已心降，床下无人拜老庞。\n病眼欲开还又闭，偷看日影下西窗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读史六首 其一","author":"陆文圭","text":"逐鹿纷纷尽向秦，东门牵犬亦无人。\n月宫稳上青冥去，桂树秋风老此身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶书","author":"陆文圭","text":"忧时耿耿丹心在，无事悠悠白日过。\n万里山河音信少，一春风雨闷怀多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶作","author":"陆文圭","text":"奸雄往往堕危机，成败安能论是非。\n空笑狂生投益智，绝怜老母遗当归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿黄村土人索诗 其一","author":"陆文圭","text":"尘沙终日意昏昏，落日炊烟又一村。\n客子倦游求止宿，主翁搔首更无言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿黄村土人索诗 其二","author":"陆文圭","text":"黄村落日下山低，宿鸟归林亦倦飞。\n夜半驱车投北去，谁能慷慨泣牛衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望三峰","author":"陆文圭","text":"笋舆咿轧下山田，遥指三峰返照边。\n安得肉身生两翅，霎时飞过此山前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梨花","author":"陆文圭","text":"粉香初试晓妆匀，花貌参差是玉真。\n茅屋诗人嗟老去，东风勿送一枝春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"深山佳处子昂为宣城友人书 其二","author":"陆文圭","text":"岩花半识玄晖面，溪声细和谪仙诗。\n行云流水自今古，渔叟樵童了不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明日泊舟甲马营","author":"陆文圭","text":"细柳东风甲马营，鞦韆花下笑相迎。\n舟中自有伤春客，暗数归家几日程。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"渊明像","author":"陆文圭","text":"宋文心腹寄王宏，来刺江州却有声。\n不怪孤臣书甲子，时时送酒赏渊明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"移居图二首 其二","author":"陆文圭","text":"细君散髻抱婴儿，底事移家不皱眉。\n有句曾嘲穷处士，四婆元自解吟诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"移居图二首 其一","author":"陆文圭","text":"潜夫两跋最穷研，通老安身是契玄。\n偶向晴窗展临本，无人当日扣龙眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪夜不寐偶成短句十首用渭北春天树江东日暮云为韵 其三","author":"陆文圭","text":"缟素制野服，误染京华尘。\n旧业在何处，梅花江上春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪夜不寐偶成短句十首用渭北春天树江东日暮云为韵 其七","author":"陆文圭","text":"此身如断蓬，飘萧随北风。\n钱塘一望地，家住西湖东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜客泉二首 其二","author":"陆文圭","text":"一饮怀金出岭南，莲花峰下绝清甘。\n我来欲与流泉约，独喜廉人莫喜贪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜客泉二首 其一","author":"陆文圭","text":"幽篁夹道少人居，山骨清寒草木疏。\n泉见客来空自喜，春怀渺渺正愁余。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋归四绝呈句容诸友 其三","author":"陆文圭","text":"我与茅君宿有缘，四年五度过山前。\n元符直下崇禧路，回首三峰意怆然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋归四绝呈句容诸友 其二","author":"陆文圭","text":"故里青松百尺强，亭亭三径俨成行。\n东篱雨后无人葺，旧菊多应一半荒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋归四绝呈句容诸友 其一","author":"陆文圭","text":"兴尽归期渐有涯，梦中昨夜已还家。\n儿童笑引池西去，菡萏犹馀一朵花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋归四绝呈句容诸友 其四","author":"陆文圭","text":"一见诸贤盖便倾，秋风犹动故乡情。\n馀生无复重来日，再世何当结弟兄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"窥园","author":"陆文圭","text":"先生日日好窥园，学圃工夫细讨论。\n卖李不须先去核，耘瓜只恐误伤根。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鉴止堂","author":"陆文圭","text":"流水涓涓止水停，要令漱玉结层冰。\n深溪不泛桃花出，谁识仙源在武陵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题二乔手卷二绝 其二","author":"陆文圭","text":"小郎斫案怒生嗔，亚婿提兵算若神。\n借使横江风不便，可能铜雀锁佳人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李义夫无锁亭二首 其二","author":"陆文圭","text":"昨日苍溪叟，曾来斫钓竿。\n山童寻鹤去，失却报平安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李义夫无锁亭二首 其一","author":"陆文圭","text":"清风四无边，旷然此君宅。\n可不问主人，不可容俗客。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李兄课卷","author":"陆文圭","text":"集中有句尽堪传，一梦科名十二年。\n音好空闻永嘉末，命乖不遇竟陵前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画白雁二首 其二","author":"陆文圭","text":"未曾至雁门，安知食雁美。\n若读潜夫论，当不保此纸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题画白雁二首 其一","author":"陆文圭","text":"芦花秋半黄，三两下寒塘。\n北风正萧瑟，书远不曾将。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题昭君画卷五绝 其二","author":"陆文圭","text":"妍丑何须问画工，美人终日侍宫中。\n奉春初计真堪恨，欲望单于敬外翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题昭君画卷五绝 其四","author":"陆文圭","text":"己恨丹青误妾身，何消更与妾传神。\n那知塞北风尘貌，不似昭阳殿里人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题禹庙","author":"陆文圭","text":"来寻禹穴何容易，却上龙门得许劳。\n拟借梅梁浮海去，坐登三级浪头高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵子德修屋疏二首 其二","author":"陆文圭","text":"神有青囊号救贫，如何无术自谋身。\n道南大宅今安在，欲向龙舒觅主人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵子德修屋疏二首 其一","author":"陆文圭","text":"公子王孙逞富豪，连云甲第竞相高。\n谁是锦里秋风客，不办三重屋上茅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题扇有所赠","author":"陆文圭","text":"圆如宝月洁如霜，素手轻摇玉体凉。\n报道明朝秋节至，婕妤无复望专房。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题碧桃手卷","author":"陆文圭","text":"烂枝空有色，飞羽本无情。\n独立春风里，如闻三两声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠复初二首 其二","author":"陆文圭","text":"有客袖中怀短刺，何人门下曳长裾。\n每评陆子毁茶论，大胜颜公乞米书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠复初二首 其一","author":"陆文圭","text":"昨夜春风到柳枝，客衣偏爱薄寒欺。\n囊锥颖脱无人见，欲绣平原未有丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠星禽赵显微诗三绝 其一","author":"陆文圭","text":"显微元是紫微仙，天上星辰手斡旋。\n为向人间多漏泄，谪下茅峰五百年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠星禽赵显微诗三绝 其二","author":"陆文圭","text":"莫把行藏问斗牛，年将八十更何求。\n愿言奎宿长明健，文治从今遍九州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6128,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]