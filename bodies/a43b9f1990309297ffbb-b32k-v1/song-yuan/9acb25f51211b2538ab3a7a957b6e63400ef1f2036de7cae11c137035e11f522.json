[{"title":"次黄山中山居韵 其一","author":"杨公远","text":"山居无一事，所得趣何深。\n阅世秋声赋，存心夜气箴。\n步徐携葛杖，兴逸鼓嵇琴。\n最喜疏篱下，悠然见翠岑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5237,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次黄山中首尾吟","author":"杨公远","text":"双井源流绰有声，襟期一片玉壶清。\n吟成物外风骚句，付与人间月旦评。\n随柳问花知雅兴，论心握手见交情。\n英雄标致真难敌，双井源流绰有声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5238,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其十","author":"杨公远","text":"诗骨清臞甚，几如沈隐侯。\n自编篱象眼，为护笋猫头。\n日有丘园乐，身无世俗愁。\n怜渠名利客，汩汩几时休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5239,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其九","author":"杨公远","text":"生来疏拙甚，怕与俗流同。\n颇识一丁字，宁牵两石弓。\n夜敲筛柳月，晓对落花风。\n但得身无事，何消效送穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5240,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其八","author":"杨公远","text":"村疃多幽趣，谁言景象稀。\n云攲山卸帽，苔长石添衣。\n一岁惊春老，千林觉绿肥。\n可怜双蛱蝶，又傍菜花飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5241,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其七","author":"杨公远","text":"山中閒宰相，日日有蜂衙。\n剑戟门前竹，枪棋鼎内茶。\n莺歌喉宛转，蝶舞翅攲斜。\n只此堪娱乐，何消解语花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5242,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其六","author":"杨公远","text":"茅结两间月，白云分半间。\n利名俱拚舍，云月共清閒。\n来辙元无俗，论交赖有山。\n谢渠梁上燕，社后又飞还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5243,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其五","author":"杨公远","text":"搔头无别想，得句但长吟。\n懒到风波地，坚存铁石心。\n人情从冷热，世态任浮沈。\n却喜虚檐外，清吹满竹林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5244,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其四","author":"杨公远","text":"融和天气好，携杖作清游。\n景物自消长，禽言或去留。\n人登山际寺，花映水边楼。\n欲写归吟卷，敲推手不休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5245,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其三","author":"杨公远","text":"山势主宾立，溪流泾渭分。\n景幽诗易得，兴逸酒难醺。\n有累营家燕，无心出岫云。\n若言朝市事，毫发不曾闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5246,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其二","author":"杨公远","text":"萧洒园池上，依然一故庐。\n苍苔封曲径，老鹤伴閒居。\n计拙身还逸，颜酡鬓任疏。\n日长无个事，穷达尽教渠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5247,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山村居韵 其一","author":"杨公远","text":"隐迹深村里，年今四十馀。\n谩携三寸管，欠读几行书。\n爱竹和烟种，移梅带月锄。\n箪瓢还自乐，饭糗茹青蔬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5248,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程斗山韵","author":"杨公远","text":"口作蛩吟肩耸山，了无萦系一生閒。\n梦回春草池塘外，诗在梅花烟雨间。\n但得双眸长炯炯，从教两鬓自斑斑。\n此身穷达何消问，天道乘除去复还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5249,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程国舍","author":"杨公远","text":"欲坐春风欠宿缘，识荆琳宇忆当年。\n初逢脱略知心地，再见从容值暑天。\n万卷诗书君有种，一犁烟雨我无田。\n晓来喜报檐前鹊，忽得珠玑璨两篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5250,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程直学对镜","author":"杨公远","text":"青铜频启看，瘦劣沈东阳。\n鬓染秋霜色，身期晚节香。\n閒情耽水石，幽梦绕池塘。\n何似伊川脉，渊源道味长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5251,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程南仲韵 其五","author":"杨公远","text":"剩喜壶中别是天，诛茆结屋竹梅边。\n伴人有意一泓砚，笑我无缘二顷田。\n半醉半醒知酒圣，非空非色悟僧禅。\n门前青嶂浑如画，云去云来树倚巅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5252,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程南仲韵 其四","author":"杨公远","text":"倒指头颅六十馀，尤堪抱瓮灌园蔬。\n生来自得江山趣，身后何消竹帛书。\n无事关怀心寂寂，有时敲句意徐徐。\n乘閒问柳寻花去，缓步安然当小车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5253,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程南仲韵 其二","author":"杨公远","text":"生意窗前草不除，翛翛苍玉自扶疏。\n贫将入骨谁怜我，富欲掀天命属渠。\n学圃频观种树传，杜门几似绝交书。\n有时间有过从者，分席非樵即是渔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5254,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程南仲韵 其一","author":"杨公远","text":"老来鹤发更鸡皮，计解曾无六出奇。\n耕钓云烟三寸管，剪裁风月几联诗。\n逢人多谢开青眼，顾我惟惭匪白眉。\n世路近来虽著脚，不如退步学聋痴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5255,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵立秋","author":"杨公远","text":"白帝交承下令时，蒲葵絺葛竖降旗。\n书亲灯火儿曹喜，雁过沙场士卒悲。\n夜月一帘虽旧识，西风半榻是新知。\n从今景物皆清致，多办吟笺剩赋诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5256,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵别黄山中","author":"杨公远","text":"相逢祇在万山阿，每愧才疏藉琢磨。\n昨日忽来明日去，会时常少别时多。\n茶聊当酒匆匆话，诗为言怀细细哦。\n折得梅花须寄我，不然携杖早相过。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5257,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵郑山长九日","author":"杨公远","text":"诗逢佳节应酬忙，三斗何妨效汝阳。\n帽任攲斜双鬓白，菊无今古数枝黄。\n龙山景物自消长，栗里琴书今在亡。\n往事莫谈添感慨，醒时也作次公狂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5258,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵凌义山 其二","author":"杨公远","text":"眼前诗料底消寻，移入蛮笺别浅深。\n无斧凿痕方造妙，超尘俗表始堪吟。\n物情体状须留意，句眼推敲好用心。\n试看咏梅千万首，影香独数老逋林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5259,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵凌义山 其一","author":"杨公远","text":"自怜老境渐侵寻，检点头颅雪旋深。\n无酒浇愁还独啸，有时得句但长吟。\n一天月色涵秋意，四壁蛩声恼客心。\n好是夜凉清似水，萧萧风度古松林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5260,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵黄仲宣九日","author":"杨公远","text":"又逢重九日，七载寓僧庐。\n送酒人何在，迎风帽自如。\n萸肥含味远，菊瘦著花疏。\n祇么酬佳节，诗成茧纸书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5261,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江天晓望次南仲韵","author":"杨公远","text":"江天向晓缊轻寒，雾捲云收眼界宽。\n雁起沙头兵出戍，鹭翘柳上雪成团。\n数声柔橹船初发，一片寒芦叶半乾。\n无奈满前诗料富，耽吟几致废朝餐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5262,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"池上芙蓉","author":"杨公远","text":"小池擎雨已无荷，池上芙蓉映碧波。\n初试晨妆铜镜净，未醒卯醉玉颜酡。\n一秋造化全钟此，十月风光尚属他。\n除却篱边丛菊伴，别谁能奈晓霜何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5263,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹夫人","author":"杨公远","text":"羞领青奴号，由来节操刚。\n有生惟具眼，不妒为无肠。\n恋恋言何寂，娟娟体自凉。\n弃捐知素分，那敢望专房。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5264,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自述","author":"杨公远","text":"年踰半百颇酸心，眼底朋俦试选抡。\n松竹梅花三益友，诗书画卷一閒人。\n北窗高卧那非乐，南阮甘贫只任真。\n却喜生无荣辱事，底须姓字动朝绅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5265,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自笑 其二","author":"杨公远","text":"东郊结屋恰三间，景物供吟要细参。\n红日射芒穿密树，青山倒影浴寒潭。\n樵虽分席当时话，客为同心尽日谈。\n最是北窗高卧处，如雷鼻息睡偏酣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5266,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自笑 其一","author":"杨公远","text":"自笑人生立世难，甘辛滋味饱曾参。\n头颅潦倒梅横雪，心地通明月印潭。\n诗欠惊人徒著意，事多忤俗更休谈。\n何如领略三杯酒，不必如泥只半酣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5267,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观梅","author":"杨公远","text":"老来宠辱两无闻，才见梅花喜十分。\n冰雪相看虽属我，乾坤独步却输君。\n受知和靖黄昏月，入梦昌龄落寞云。\n从此暗香来不断，何消更把水沈焚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5268,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初度","author":"杨公远","text":"行止由来不自如，八年初度寓僧庐。\n半生閒逸云无定，两鬓萧骚雪尚疏。\n岂愿身荣如卫鹤，祇惭技拙类黔驴。\n今朝六十从头起，数到稀年更有馀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5269,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初度寓郡","author":"杨公远","text":"得失荣枯付分休，康强之外复何求。\n灵台洞彻天无夜，银海精明月正秋。\n谩赋律章酬诞节，旋沽官酝破羁愁。\n生来结得梅花伴，长占春风第一筹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5270,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏旅中 其五","author":"杨公远","text":"每忆吾庐隐者居，天然景物足清娱。\n树林阴翳莺求友，帘幕深沈燕引雏。\n可钓可耕盘谷序，堪诗堪画辋川图。\n何当归去北窗卧，能胜羲皇以上无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5271,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏旅中 其四","author":"杨公远","text":"吟髭细撚祇堪伤，几度徘徊立夕阳。\n诗不疗饥徒著意，酒能作病莫持觞。\n此心轩豁出云月，浮世间关逆水航。\n多谢老天怜我在，长教穷健又何妨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5272,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏旅中 其三","author":"杨公远","text":"往来萧寺几经年，时向僧窗听说禅。\n一事不成空老去，三椽聊寓幸安眠。\n诗篇冰雪无蔬气，粥饭齑盐有道缘。\n欲卜归期犹未定，况闻绿树有啼鹃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5273,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏旅中 其二","author":"杨公远","text":"早起窗前拥弊裘，鬓毛萧散冷飕飕。\n葵榴花发已云夏，竹树风生却似秋。\n骤雨乍晴双港涨，宿云初敛四山幽。\n客怀顿觉添萧洒，且放吟情出一头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5274,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初夏旅中 其一","author":"杨公远","text":"乌兔双飞去若梭，又逢天气正清和。\n绿空桑柘蚕成茧，青遍田畴犊卧莎。\n好景常供诗料足，浮生每叹客愁多。\n家山不是无风月，斗粟区区可奈何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5275,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"听涧泉琴次赵丞韵","author":"杨公远","text":"来谒涧泉琴，都忘利与名。\n初闻心地爽，饱听耳根清。\n三峡流波势，九皋鸣鹤声。\n更期明月夜，共此畅幽情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5276,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈许使君 其二","author":"杨公远","text":"蒙泉清彻底，更不著纤尘。\n滕阁曾逢月，花屏又遇春。\n采芹尊秀士，拔薤抑强民。\n祇恐芝泥召，催归侍紫宸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5277,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈许使君 其一","author":"杨公远","text":"河岳中原地，英贤间世生。\n气雄虹万丈，心净月三更。\n韩柳文同妙，龚黄政共清。\n新安人有分，月旦愿推评。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5278,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈康总管相公","author":"杨公远","text":"古汴文章伯，来为我郡侯。\n一心天不夜，千里月长秋。\n政压龚黄辈，诗侪李杜俦。\n雷门持布鼓，肯瞩电光不。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5279,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寿许侯","author":"杨公远","text":"冬孟犹馀一叶蓂，中原贤哲此时生。\n星辉南极躔吴分，月出东山照歙城。\n耐与寒花香晚节，清如冷蕊味和羹。\n童颜鹤发神仙骨，便是崆峒老广成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5280,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寿许侯","author":"杨公远","text":"星辉南极彩云边，律转黄钟一日前。\n河岳间生贤太守，椿松齐算老神仙。\n心犹秋月烛千里，人在春风度两年。\n祇恐练溪难久驻，行看飞诏下尧天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5281,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张道士山房次程南仲韵","author":"杨公远","text":"丹房萧洒绝纤埃，石径萦纡辟草莱。\n窗外果从猿摘去，山中芝藉鹤衔回。\n一瓯白雪汤轻注，三尺青蛇匣不开。\n如许清虚尘世隔，明朝再约抱琴来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5282,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"花朝","author":"杨公远","text":"花朝恰了一分春，雨雪阴霾占两旬。\n物态未妍寒瑟缩，人生易老事因循。\n洗瓷杯酌浮蛆酒，拥地炉烧带叶薪。\n翻忆昔年成感慨，长官出郭劭耕民。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5283,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"芳溪閒步","author":"杨公远","text":"竹杖芒鞋度断冈，崎岖小径绕寒塘。\n野梅照水初含白，山菊支霜未委黄。\n对景每番成感慨，把杯几度放疏狂。\n此生但只安吾分，无辱无荣寿且康。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5284,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闷书","author":"杨公远","text":"闷来咄咄向空书，怪底年来每事疏。\n著脚左如旋磨蚁，进身难似上竿鱼。\n不逢贤者休弹铗，谩说侯门可曳裾。\n毕竟归农为上策，买将蓑笠去耕锄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5285,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闷书 其二","author":"杨公远","text":"客里因循断送春，况逢天气半晴阴。\n生来百事少如意，老去千般都上心。\n长铗空弹冯氏剑，良材还斲蔡翁琴。\n愁怀正此无分付，多谢黄鹂送好音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5286,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闷书 其一","author":"杨公远","text":"转眼才馀五日春，东奔西走废光阴。\n一泓砚里谋生意，几句诗中写客心。\n贯斗冲牛雷焕剑，高山流水伯牙琴。\n莫将未遇添惆怅，自有名公为赏音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5287,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐 其二","author":"杨公远","text":"相伴青灯坐矮窗，老来计拙负年光。\n画灰有句羞才短，就枕无眠畏夜长。\n世路难跻缘峻崄，人情易见为炎凉。\n知心却藉风和月，时度梅花一线香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5288,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐 其一","author":"杨公远","text":"门外霜风猎猎声，拥炉坐对一灯明。\n閒思浮世古今事，倦听荒城长短更。\n满榻诗书终有味，半生名利竟无成。\n从人笑我衣冠别，虽不趋时却自清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5289,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"学圃","author":"杨公远","text":"萧然身世尽宽舒，剩有工夫学种蔬。\n每汲清泉勤抱瓮，旋锄荒圃谩携书。\n绿葵紫芥香尤美，春韭秋菘味有馀。\n时撷鲜苗烹石铫，朱门肉食不如渠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5290,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"学渔","author":"杨公远","text":"年来懒问是和非，谩向沧浪理钓矶。\n折取绿荷充蒻笠，收将红芰缉蓑衣。\n秋风莼菜鲈堪脍，春水桃花鳜正肥。\n身逐烟波逃世虑，沙鸥汀鹭共忘机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5291,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"学樵","author":"杨公远","text":"因嫌踪迹混尘嚣，腰斧高歌去采樵。\n欲效买臣无贵骨，何如王质有仙标。\n丁丁伐木空山外，轧轧肩薪小径遥。\n一任雪天霜月夜，且将带叶地炉烧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5292,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"学稼","author":"杨公远","text":"尘埃面目半生勤，去住浑如出岫云。\n腹馁谩挥求米帖，囊空徒诵送穷文。\n诗书满架何堪煮，稌黍盈畴政乐闻。\n欲办烟蓑并雨笠，愿随田叟学耕耘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5293,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"拙稿呈许侯","author":"杨公远","text":"拙稿携将谒使君，区区那敢冀知闻。\n编成初卷如终卷，赋就三分诵七分。\n妄意僭干修月斧，删芜端藉运风斤。\n一经题品便佳士，庶别丛间莸与薰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5294,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦雨","author":"杨公远","text":"滴碎空阶颇厌听，恼人况又近清明。\n三分春忽二分过，十日天无一日晴。\n寒沁柳眉愁寂寂，湿凝花脸泪盈盈。\n苍穹好悯云霓望，留作甘霖助有成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5295,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗谒按察疏斋赐贱号二大字赋诗以谢","author":"杨公远","text":"幸披云雾睹青天，尽道山人有宿缘。\n得坐春风才半日，胜居尘世已千年。\n槎枯许到银河畔，葭老容依玉树边。\n两字光芒关不住，私心犹敢觅新篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5296,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨后 其二","author":"杨公远","text":"沛然倾霔战骄阳，飒飒风来作晚凉。\n吹散浮云澄玉宇，敲残枯叶堕银床。\n韩檠擢用因书荐，班扇投閒被雨妨。\n自此吟情辜不得，一秋景物要平章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5297,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨后 其一","author":"杨公远","text":"春色相将老，幽禽百样吟。\n一犁新雨骤，满地落花深。\n麦秀风翻浪，秧青水透针。\n年登应可卜，稍稍慰侬心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5298,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨过閒步","author":"杨公远","text":"霏微雨过不成泥，小步何妨曳杖藜。\n半露好山云断续，轻笼淡日树高低。\n池塘有梦春生草，桃李无言下自蹊。\n政此新晴犹未定，那堪又听竹鸡啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5299,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]