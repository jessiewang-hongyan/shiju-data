[{"title":"咏史 王允","author":"陈普","text":"事成一让一矜功，一吉分明对一凶。\n青琐门前招不去，相期犹不负林宗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7083,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 王昭君","author":"陈普","text":"呼韩骨冷复雕陶，夜夜穹庐朔月高。\n为问琵琶弦底话，得无一语诉腥臊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 王昭君","author":"陈普","text":"宁胡名号正当时，且有安栖得哺儿。\n胡草似人空好色，青青合为故阏氏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 王昭君","author":"陈普","text":"昭阳柘馆贮歌儿，恨杀陈汤斩郅支。\n胡草似人空好色，春光不到二阏氏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 王昭君","author":"陈普","text":"出嫁毡裘得几时，昭阳柘馆贮歌儿。\n蛾眉莫怨毛延寿，好怨陈汤斩郅支。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 王褒","author":"陈普","text":"彭祖呼嘘不可为，碧鸡使节岂堪持。\n区区含糗羹藜厚，聊似相如衣锦时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 丙吉","author":"陈普","text":"污茵驭吏习边方，阿保宫人畏霍光。\n丞相马前人蹀血，病牛何足累阴阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 四皓","author":"陈普","text":"长乐卮前露雪眉，岩花乱笑出山时。\n有人拍手瓜田里，来往青门总不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 左承祖","author":"陈普","text":"汉室犹馀北海城，左生何惧便怔营。\n至令鲁国奇男子，反得当年杀士名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其八 汉高帝","author":"陈普","text":"欲来不解自操持，白日明庭抱爱姬。\n世降的从何处起，醉眠王母二家时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其七 汉高帝","author":"陈普","text":"一带阴山浪引弓，运移婚媾一朝通。\n英雄白首消磨尽，甘与枭雏作妇翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其六 汉高帝","author":"陈普","text":"羽未禽时胆屡寒，羽禽不得一朝闲。\n卯金四百年天下，却在双娥一笑间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 汉高帝","author":"陈普","text":"扶创裹血过家乡，四顾何人守四方。\n梁楚淮南残一国，山河争属将狼羊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 汉高帝","author":"陈普","text":"金创可愈不容医，应念丁公相厄时。\n不赖西风吹楚卒，千龙万虎亦何为。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 汉高帝","author":"陈普","text":"煨烬三王不复收，子孙大辱辟阳侯。\n无边智力皆骑虎，高绝还能四百秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 汉高帝","author":"陈普","text":"诗书礼乐敢忘钦，自是而翁力不任。\n莫把溺冠轻议论，要观过鲁太牢心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 汉高帝","author":"陈普","text":"气力才胜野外仪，情怀颇乐汉中儿。\n两生礼乐留侯箸，此事而翁却自知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 田畴","author":"陈普","text":"徐元宛似历山中，义气人间窄不容。\n不为犬羊残士类，肯教曹操识卢龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 田横","author":"陈普","text":"宗族几为孔子焚，为秦未几又为尘。\n田横更欲横河岳，不把英雄让与人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 申公","author":"陈普","text":"片言不合去何迟，又似当年在楚时。\n束帛蒲轮无报效，至今天子不迎师。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 申屠嘉","author":"陈普","text":"汉四十年几丞相，蹶张丞相冷如冰。\n两京礼乐何堪自，薄有申屠与宋弘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 文帝","author":"陈普","text":"性习由来系正邪，古今谁不道蓬麻。\n无人说与吹箫相，窦薄淮刘本一家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 伏生","author":"陈普","text":"撑肠拄肚总聱牙，汉室龙兴发乍华。\n掌故不来光景暮，尚书再火伏生家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 伏生","author":"陈普","text":"嬴蹶刘兴齿舌存，百篇大义尽堪闻。\n孝文无意脩王制，古典重遭伏胜焚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 文帝","author":"陈普","text":"文杏沙棠代代殃，露台不作作阿房。\n古来尧禹卑宫室，不为丹朱与太康。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 文帝","author":"陈普","text":"二儿并辔入公门，博局纷纷启祸原。\n不及贾生何处是，弗将礼法教儿孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 文帝","author":"陈普","text":"邓氏铜钱张武金，至公终浅爱终深。\n东西两子皆称跸，未餍怜儿老妪心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 光武","author":"陈普","text":"丙夜沈沈讲未停，故人重话旧时灯。\n半篇说命良依约，舜典周官总未曾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 光武","author":"陈普","text":"腹上能容严子陵，面前何不著韩歆。\n迭兴知与人何事，陇蜀才平便易心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 光武","author":"陈普","text":"赤符交锡帝心移，不似初来岸帻时。\n浪泊壶头终落落，羊裘男子殆先知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 光武","author":"陈普","text":"经邦论道职何卑，又是前朝卖饼儿。\n十乱五臣无煖席，三王四代是何时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 光武","author":"陈普","text":"金匮哀章正共哀，又将符命议灵台。\n太山千古黄泉路，底事銮舆爱上来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 明帝","author":"陈普","text":"后宫任姒古今希，前殿弦歌凤已知。\n孔子孟轲真薄命，不生建武永平时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 明帝","author":"陈普","text":"盘木白狼纷贡毛，龟兹侍子荐蒲萄。\n满朝虎拜南山寿，无一人能作旅獒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 祭遵","author":"陈普","text":"琤琤壶矢柳营春，十万貔貅不动尘。\n世祖功臣三十六，谁为韦裤布衣人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 刘歆","author":"陈普","text":"秀国师公雄大夫，梓枝何用叹扶疏。\n刘歆父子无瓜葛，何怪昌言毁仲舒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 刘虞","author":"陈普","text":"疽溃中平甲子年，蒲蠃桑椹亦萧然。\n幽州别是神仙土，谷石人间三十钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 刘虞","author":"陈普","text":"曲盖华旗起益荆，幽州臣节独分明。\n汉家福分无周旦，天遣忠贤不习兵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 华歆","author":"陈普","text":"拈起黄金岂可疑，斩关发壁复何为。\n辽东不洗巢由耳，痛切初年割席迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 吕后","author":"陈普","text":"酌酖樽前气似虹，朱虚酒令却相容。\n王陵平勃浑无策，安汉当年一触龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 成帝","author":"陈普","text":"元帝斋宫纳弁儿，阿娇金屋篡歌姬。\n披香博士多才学，刘氏家传有未知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 扬雄","author":"陈普","text":"德宅神庭孰与游，董贤舜禹莽伊周。\n馀腥用尽桐江水，重费寒潭九曲流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 扬雄","author":"陈普","text":"展禽未必非龚胜，孤竹犹将笑薛方。\n可怪扬雄非桀犬，一生终倚桀门墙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 汲黯","author":"陈普","text":"东北民思齑主父，西南人欲粉唐蒙。\n汉家社稷何依倚，黯直粗疏一病翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 老子","author":"陈普","text":"瓜葛非徒李世民，牵藤引蔓百千身。\n周时柱下霜眉客，今作书符咒水人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 齐桓公","author":"陈普","text":"葵丘霸气若虹霓，东略何缘遽不知。\n宰孔晋侯相遇处，齐桓已作在床尸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7128,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 齐桓公","author":"陈普","text":"关雎泽竭自师陉，直到瓜丘烬六经。\n户外流虫争掩鼻，当年已作鲍鱼腥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7129,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 两生","author":"陈普","text":"少年贾谊空多口，老大申公缪一行。\n曾识当年二君子，闭门不受叔孙生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7130,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 何进","author":"陈普","text":"龙骧虎步反狐疑，解事陈琳却似痴。\n灭火不关千里草，汉家社稷付屠儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7131,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 即墨大夫","author":"陈普","text":"清浅蓬莱几度桑，纷纷斫石底心肠。\n项梁刘季相逢日，即墨大夫头未霜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7132,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 宋共姬齐孝公夫人","author":"陈普","text":"火来秉节正如山，茀丧何心在世间。\n身似泥沙心似玉，水中火里即浑閒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7133,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 张汤公孙弘","author":"陈普","text":"茂材异等竟无闻，教耨明耕却有人。\n能旱能风须记取，汉家元气太宗仁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7134,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 张汤公孙弘","author":"陈普","text":"汉武秦皇代有俦，奸人常缓钓鱼钩。\n公孙不但能牵纵，巧计犹工毒上流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7135,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 张汤公孙弘","author":"陈普","text":"汉朝独有舒与黯，何物枭心欲食之。\n六经千载无生气，断自齐人作相时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7136,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 张汤公孙弘","author":"陈普","text":"张汤绝似公孙子，一样奴颜裹祸心。\n不赖汲生如日月，汉廷谁与破幽阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7137,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 张良","author":"陈普","text":"太公行辈赤松流，伍叔孙通了不羞。\n好谢君王深体识，不将身后累刘侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7138,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 张良","author":"陈普","text":"本是山东忠孝门，卯金社稷暂相烦。\n君王良会青云意，长乐钟中无一言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7139,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 张良","author":"陈普","text":"撩乱龙蛇掌上争，罢来閒掉四先生。\n一棚儿女皆烟散，留得松风万古清。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7140,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 张良","author":"陈普","text":"乳口摇牙向白蛇，一朝电拂博浪沙。\n下邳不得编书读，帷幄何妨佐汉家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7141,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 张敞","author":"陈普","text":"章台陌上试金鞍，文君镜中描远山。\n黄霸功隳王吉老，五日京兆得偷闲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7142,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 张敞","author":"陈普","text":"西汉长安周镐京，终南天秀八流清。\n赵张无异曹参醉，总不能平二国争。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7143,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 张释之","author":"陈普","text":"尘编今古几咿嚘，多少君王共御囚。\n自古君难臣不易，释之片语误千秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7144,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 张释之","author":"陈普","text":"帝舜登天四海臣，可怜生杀不由身。\n持平第一张廷尉，更听君王误杀人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7145,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 张释之","author":"陈普","text":"瓦器山陵刑措时，释之而后固无之。\n公车不作他年计，聊使君王识教儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7146,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 张骞","author":"陈普","text":"风沙霜雪十三年，城郭山川万二千。\n汉马死亡宛马到，万人怨怒一人怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7147,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 李广李陵","author":"陈普","text":"茂陵无奈太仓陈，槐里家传本助秦。\n万落千村荆杞满，陇西桃李亦成薪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7148,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 李斯","author":"陈普","text":"李斯何敢妄坑儒，但作逢君固位图。\n造物欲为儒报德，故教草草杀扶苏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7149,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 李斯","author":"陈普","text":"抛却韩卢把虎骑，诸生莫讶正忙时。\n鱼龙不隔蓬莱路，方有东门逐兔期。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7150,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 李斯","author":"陈普","text":"太华终南只磨青，渭流一日肯为泾。\n豺狼不食茅焦肉，水火安能熄六经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7151,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 李膺范滂","author":"陈普","text":"凤麟自古待明时，虮虱何堪论是非。\n可是首阳可埋骨，争知人怨首阳希。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7152,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 苏武","author":"陈普","text":"伏匿穷庐煖意回，子卿一夜梦阳台。\n归来不与曾孙议，未必麒麟生面开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7153,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 贡禹","author":"陈普","text":"杀傅囚师不敢言，奸人致意遂昏昏。\n明经洁行人如梦，莫把优游议孝元。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7154,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 辛庆忌","author":"陈普","text":"虎豹深宫风自寒，未央前殿拜呼韩。\n二边无事将军老，犹得馀閒救比干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7155,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 邴原","author":"陈普","text":"无数潜龙不肯藏，炎精展转遂无光。\n间关鲸海缘何事，更问辽东作范滂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7156,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 邹衍","author":"陈普","text":"六月咸阳霜亦飞，五行正是水昌时。\n族秦自有谈天衍，不用陶朱与仲尼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7157,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]