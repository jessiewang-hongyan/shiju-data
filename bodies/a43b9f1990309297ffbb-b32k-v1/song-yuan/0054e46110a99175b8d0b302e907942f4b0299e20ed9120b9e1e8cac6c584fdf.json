[{"title":"醉歌 其九","author":"汪元量","text":"南苑西宫棘露芽，万年枝上乱啼鸦。\n北人环立阑干曲，手指红梅作杏花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5636,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其二","author":"汪元量","text":"援兵不遣事堪哀，食肉权臣大不才。\n见说襄樊投拜了，千军万马过江来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5637,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其十","author":"汪元量","text":"伯颜丞相吕将军，收了江南不杀人。\n昨日太皇请茶饭，满朝朱紫尽降臣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5638,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其一","author":"汪元量","text":"吕将军在守襄阳，十载襄阳铁脊梁。\n望断援兵无信息，声声骂杀贾平章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5639,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其四","author":"汪元量","text":"六宫宫女泪涟涟，事主谁知不尽年。\n太后传宣许降国，伯颜丞相到帘前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5640,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其八","author":"汪元量","text":"涌金门外雨晴初，多少红船上下趋。\n龙管凤笙无韵调，却挝战鼓下西湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5641,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其六","author":"汪元量","text":"衣冠不改只如先，关会通行满市廛。\n北客南人成买卖，京师依旧使铜钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5642,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉歌 其三","author":"汪元量","text":"淮襄州郡尽归降，鞞鼓喧天入古杭。\n国母已无心听政，书生空有泪成行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5643,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王导像","author":"汪元量","text":"秦淮浪白蒋山青，西望神州草木腥。\n江左夷吾甘半壁，只缘无泪洒新亭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5644,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"燕子楼","author":"汪元量","text":"楼颠瓦解草如鬣，燕子不来风猎猎。\n倚筇搔首重徘徊，野花丛里飞蝴蝶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5645,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日次周义山","author":"汪元量","text":"杜陵清瘦不禁寒，白发萧萧强笑欢。\n阶下决明难独立，庭前甘菊好谁看。\n一钱留得囊羞涩，九日沽来酒带酸。\n却忆大明朝谒罢，紫萸擎出赐千官。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5646,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"万安殿夜直","author":"汪元量","text":"凤衔紫诏下云端，千载明良际会难。\n金阙早朝天表近，玉堂夜直月光寒。\n宫衣屡赐恩荣重，御宴时开礼数宽。\n却忆玄都人去后，桃花零落倚阑干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5647,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三衢官舍和王府教","author":"汪元量","text":"十年牢落走穷荒，万里归来行路长。\n坐上佳宾能鼓瑟，窗前细雨好烧香。\n武淹某泽常思汉，甫寓鄜州只念唐。\n秉烛相看真梦寐，夜阑无语意茫茫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5648,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"凤凰台","author":"汪元量","text":"草没高台凤不游，大江日夜自东流。\n齐梁地废鸦千树，王谢家空蚁一丘。\n骑马僧争淮口渡，捕鱼人据石头洲。\n玉箫声断悲风起，不见长安李白愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5649,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太皇谢太后挽章 其一","author":"汪元量","text":"羯鼓喧吴越，伤心国破时。\n雨阑花洒泪，烟苑柳颦眉。\n事去千年速，愁来一死迟。\n旧臣相吊后，寒月堕燕支。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5650,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太皇谢太后挽章 其二","author":"汪元量","text":"大漠阴风起，羁孤血泪县。\n忽闻天下母，已赴月中仙。\n哀乐浮云外，荣枯逝水前。\n遗书乞骸骨，归葬越山边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5651,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孔子旧宅","author":"汪元量","text":"奉出天家一瓣香，著鞭东鲁谒灵光。\n堂堂圣像垂龙衮，济济贤生列雁行。\n屋壁诗书今绝响，衣冠人物只堪伤。\n可怜杏老空坛上，惟有寒鸦噪夕阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5652,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"少室山","author":"汪元量","text":"岩岩路径入空濛，中有幽人旧日宫。\n野草败垣供暮雨，断碑古木管秋风。\n山川融结千年秀，天地包笼一世雄。\n从此不须高索价，高名过眼总飘蓬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5653,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文山丞相丙子自京口脱去变姓名作清江刘洙今日相对得非梦耶","author":"汪元量","text":"昔年变姓走淮滨，虎豹从横独怆神。\n青海茫茫迷故国，黄尘黯黯泣孤臣。\n魏雎张禄梦中梦，越蠡陶朱身后身。\n今日相看论往事，刘洙元是姓文人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5654,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文山道人事毕壬午腊月初九日","author":"汪元量","text":"崖山禽得到燕山，此老从容就义难。\n生愧夷齐尚周粟，死同巡远只唐官。\n雪平绝塞魂何往，月满通衢骨未寒。\n一剑固知公所欠，要留青史与人看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5655,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"长沙","author":"汪元量","text":"洞庭过了浪犹高，河伯欣然止怒涛。\n傍岸买鱼仍问米，登楼呼酒更持螯。\n湘汀暮雨幽兰湿，野渡寒风古树号。\n诗到巴陵吟不得，屈原千古有离骚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5656,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东平官舍","author":"汪元量","text":"晓鞭驿马入东州，瘦骨棱嶒怯素秋。\n天地不仁人去国，江山如待客登楼。\n市沽鲁酒难为醉，座咽胡笳易得愁。\n日暮凭阑穷目力，一行征雁塞边头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5657,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬至日同舍会拜","author":"汪元量","text":"燕市人争看秀才，团栾此日会金台。\n葡萄酒熟浇驼髓，萝卜羹甜煮鹿胎。\n砚笔寂寥空洒泪，管弦呜咽自生哀。\n雪寒门户宾朋少，且拨红炉守泰来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5658,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北师驻皋亭山","author":"汪元量","text":"钱塘江上雨初乾，风入端门阵阵酸。\n万马乱嘶临警跸，三宫垂泪湿铃鸾。\n童儿空想追徐福，疠鬼终朝灭贺兰。\n苦议和亲休练卒，婵娟剩遣嫁呼韩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5659,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北岳降香呈严学士","author":"汪元量","text":"万里溟濛起战埃，翩翩勒马出金台。\n同君远使山头去，如朕亲行岳顶来。\n野庙横斜挨老树，古碑颠倒枕荒苔。\n瞻天只有丹心在，香篆炉熏达九垓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5660,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"卢奉御自上都回见访","author":"汪元量","text":"诗人骑马接官回，解后居庸怀抱开。\n冷地不禁风聒聒，炎天长见雪堆堆。\n昨宵我梦中南去，今日君从直北来。\n说尽穷阴无限事，呼童携酒上金台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5661,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"平原郡公夜宴月下待瀛国公归寓府","author":"汪元量","text":"春事阑珊梦里休，他乡相见泪空流。\n柳摇楚馆牵新恨，花落吴宫忆旧游。\n渴想和羹梅已熟，饥思进饭麦初收。\n瀛洲归去琅玕长，月朗风熏十二楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5662,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"平原郡公赵福王挽章","author":"汪元量","text":"大王无起日，草木尽伤悲。\n生在太平世，死当离乱时。\n南冠流远路，北面幸全尸。\n旧客行霜霰，呼天泪湿麾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5663,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旧内曲水池","author":"汪元量","text":"锦沟引水入觞池，两两金船上下驰。\n春季夫人扶辇疾，玉堂学士带花迟。\n当时行乐虽然秘，此日遗踪自可悲。\n回首支郎新栋宇，浮屠千尺白差差。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5664,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"汉州","author":"汪元量","text":"马踏巉岩缓著鞭，汉州城外看青天。\n云横叠嶂吞残日，风捲崇冈起晓烟。\n地拔翠峰森似笋，溪明锦石小如钱。\n官邮睡足出门去，信口语言诗未圆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5665,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"石头城","author":"汪元量","text":"石头城上小徘徊，世换僧残寺已灰。\n地接汴淮山北去，江吞吴越水东来。\n健鱼奋鬣随蛟舞，快鹘翻身猎雁回。\n一片降旗千古泪，前人留与后人哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5666,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"全太后为尼","author":"汪元量","text":"南国旧王母，西方新世尊。\n头颅归妙相，富贵悟空门。\n传法优婆域，诵经孤独园。\n夜阑清磬罢，趺坐雪花繁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5667,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"兴元府","author":"汪元量","text":"秋风吹我入兴元，下马荒邮倚竹门。\n诗句未成云渡水，酒杯方举月临轩。\n山川寂寞非常态，市井萧条似破村。\n官吏不仁多酷虐，逃民饿死弃儿孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5668,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"后主庙","author":"汪元量","text":"汉贼不两立，英雄恨不平。\n孔明劳已死，仲达走还生。\n双剑鹰鹯急，三秦虎豹横。\n东南无霸气，恢复恐难行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5669,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吕梁","author":"汪元量","text":"吕梁三十仞，县水莫知源。\n雨歇山如沃，波狂岸欲翻。\n黄云扑古塞，青草织平原。\n最是关情处，秋霜一夜猿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5670,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"多景楼","author":"汪元量","text":"多景楼中昼掩扉，画梁不敢住乌衣。\n禅房花木兵烧杀，佛寺干戈僧怕归。\n山雨欲来淮树立，潮风初起海云飞。\n酒尊未尽登舟急，更过金焦看落晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5671,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙殿帅从魏公出师","author":"汪元量","text":"我宋麒麟阁，公当向上名。\n出师休背主，誓死莫偷生。\n社稷逢今日，英雄在此行。\n忽为儿女态，一笑欲倾城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5672,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岁暮过信州灵溪","author":"汪元量","text":"不弹长铗叹无车，独倚枯筇面碧虚。\n兵破乡村人住少，火烧桥道客行疏。\n云低天阔鹰呼隼，水落溪喧獭趁鱼。\n东骛西驰归未得，明朝又是岁将除。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5673,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戏马台","author":"汪元量","text":"台空马尽始知休，枳棘丛边鹿自游。\n泗水不关兴废事，佛峰空锁古今愁。\n风吹野甸稻花晚，雨暗山城枫叶秋。\n欲吊英灵何处在，髑髅无数满长洲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5674,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"成都","author":"汪元量","text":"锦城满目是烟花，处处红楼卖酒家。\n坐看浮云横玉垒，行观流水荡金沙。\n巴童栈道骑高马，蜀卒城门射老鸦。\n见说近来多盗蹠，夜深战鼓不停挝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5675,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"扬子江","author":"汪元量","text":"扬子津头客子愁，孤舟欲渡意绸缪。\n蛟龙汹汹争新穴，鸥鹭轻轻下故洲。\n水捲岸沙连地去，风掀江浪接天流。\n试披陆羽图经看，洗鼎煎茶更少留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5676,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"扬州","author":"汪元量","text":"重到扬州十载馀，画桥雨过月模糊。\n后皇庙里花何在，炀帝堤边柳亦枯。\n陂麦青青嘶乱马，城芜冉冉落群乌。\n人生聚散愁无尽，且小停鞭向酒垆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5677,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"扬州","author":"汪元量","text":"江都王气逐浮沤，旧说维扬第一州。\n银烛夜攒喧凤吹，金鞍晓织卫龙舟。\n绿芜城上军声合，红药阶前客泪收。\n云散月明天在水，误疑身世落瀛洲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5678,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江上","author":"汪元量","text":"太学诸斋拣秀才，出门何处是金台。\n楝花风紧子规急，杨柳烟昏黄鸟哀。\n潮落潮生天外去，人歌人哭水边来。\n推篷坐对吴山月，几度关门击柝回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5679,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江陵","author":"汪元量","text":"月到荆江上，轻帆莫远扬。\n水摇龙影动，风送雁声长。\n北斗回秋柄，南辰耿夜光。\n徘徊舒一啸，诗兴落潇湘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5680,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观鱼台","author":"汪元量","text":"高台留古迹，不见隐公游。\n白日悲风起，清河逆水流。\n潜鱼投别浦，狡兔据荒丘。\n应笑臧僖伯，何如谏得休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5681,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"阴山观猎和赵待制回文","author":"汪元量","text":"围猎看人放海青，黑山峡口路交横。\n飞鸿雨湿云天远，去马风寒雪塞平。\n归客北边关柝击，过军西畔寨灯明。\n巍巍殿帐毡房煖，衣铁冷深更鼓鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5682,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"严郑公故宅","author":"汪元量","text":"蜀山突兀接青天，郑公故宅城相连。\n深深古木哀黄鸟，漠漠荒烟哭杜鹃。\n舞罢遗钿流水外，战馀折戟落花前。\n将军好武通文墨，割据操心未必然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5683,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初庵傅学士归田里","author":"汪元量","text":"燕台同看雪花天，别后音书雁不传。\n紫阁笑谈为职长，彤闱朝谒在班前。\n挥毫屡扫三千字，把酒时呼十四弦。\n闻已挂冠归故里，尚方宣赐钞成船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5684,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"利州","author":"汪元量","text":"云栈遥遥马不前，风吹红树带青烟。\n城因兵破悭歌舞，民为官差失井田。\n岩谷搜罗追猎户，江湖刻剥及渔船。\n酒边父老犹能说，五十年前好四川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5685,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴山","author":"汪元量","text":"海枯龙去雨淋淋，羯鼓諠哗山禁林。\n虎士堕韬兵力倦，鸡人罢箭漏声沈。\n莺摇御柳春犹闹，燕蹴宫花雾转深。\n肠断木绵庵里客，可怜郿坞筑黄金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5686,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴山晓望","author":"汪元量","text":"城南城北草芊芊，满地干戈已惘然。\n燕燕莺莺随战马，风风雨雨渡江船。\n小儒愁剧吟如哭，老子歌阑醉欲眠。\n一夜春寒花命薄，乱飘红紫下平川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5687,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴江","author":"汪元量","text":"吴江潮水化虫沙，两岸垂杨噪乱鸦。\n舟子鱼羹分宰相，路人麦饭进官家。\n莫思后事悲前事，且向天涯到海涯。\n回首尚怜西去路，临平山下有荷花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5688,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苏台","author":"汪元量","text":"阖闾门外草如霜，到此踌躇欲断肠。\n红阵教成人已去，黄池会罢事堪伤。\n将雏野鹿衔枯荠，挟子宫乌噪夕阳。\n越蠡扁舟漭无所，五湖风浪白茫茫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5689,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苏台怀古","author":"汪元量","text":"灵岩寺古树森罗，满目兴亡落逝波。\n越相舟中西子去，楚王宫里北人过。\n歌台日暖游麋鹿，禁苑风高走骆驼。\n却羡老僧无一事，自携瓶锡入烟萝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5690,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"邳州","author":"汪元量","text":"身如传舍任西东，夜榻荒邮四壁空。\n乡梦渐生灯影外，客愁多在雨声中。\n淮南火后居民少，河北兵前战鼓雄。\n万里别离心正苦，帛书何日寄归鸿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5691,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"京口野望","author":"汪元量","text":"傍岸人家插酒旗，受降城下客行稀。\n南徐白昼虎成阵，北固黄昏鸦打围。\n乱后江山元历历，愁边杨柳极依依。\n棹歌渔子无些事，网得时鱼换酒归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5692,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"函谷关","author":"汪元量","text":"西风吹我度函关，古壑泉声静自閒。\n老子骑牛沙上去，仙人化鹤苑中还。\n断崖木脱悬残日，绝域云横失好山。\n旧说度关珠履客，一声鸡唱翠微间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5693,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和徐雪江即事","author":"汪元量","text":"万里起青烟，旌旗若涌泉。\n国家开气数，陵谷见推迁。\n避难浑无地，偷生赖有天。\n夜来闻大母，已自纳降笺。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5694,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孟津","author":"汪元量","text":"寒芦风飒飒，时节近昏黄。\n木脱千山瘦，江空一水长。\n云高鹏北运，天阔雁南翔。\n读尽焚舟赋，持觞酹子桑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5695,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孤山和李鹤田","author":"汪元量","text":"湖上悲风舞白杨，英雄凋尽只堪伤。\n花飞废苑怜铜马，草没荒坟卧石羊。\n人在醉中春已晚，客于愁处日偏长。\n林西楼观青红湿，又逊僧官燕梵王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5696,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"庚辰正月旦早朝呈留忠斋","author":"汪元量","text":"庭燎明如昼，金壶漏水平。\n炉烟摇晓色，櫩□□□声。\n三祝圣人寿，一忠臣子情。\n新元奏封事，□□□苍生。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5697,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"易水","author":"汪元量","text":"芦苇萧森古渡头，征鞍卸却上孤舟。\n烟笼古木猿啼夜，月印平沙雁叫秋。\n砧杵远闻添客泪，鼓鼙才动起人愁。\n当年击筑悲歌处，一片寒光凝不流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5698,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杭州杂诗和林石田 其十八","author":"汪元量","text":"世变长椎髻，时更短后衣。\n魏庭翁仲泣，唐殿子孙非。\n树秃鸦争集，梁空燕自归。\n断桥春已暮，无赖柳花飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5699,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]