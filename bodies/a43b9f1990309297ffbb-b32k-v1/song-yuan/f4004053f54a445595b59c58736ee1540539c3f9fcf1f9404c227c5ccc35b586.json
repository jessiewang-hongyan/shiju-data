r/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7333,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 钟会","author":"陈普","text":"诸葛风流尚未休，山川为斩邓钟头。\n至今青史忧吴蜀，莫把知人责夏侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7334,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 钟会","author":"陈普","text":"身在成都已孟津，霎时飞首过函秦。\n子房智勇裁如此，不悟诛秦灭项人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7335,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 唐太宗","author":"陈普","text":"文皇仁义播敷天，李氏无伦三百年。\n末路荒唐如炀帝，蜀江更起度辽船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7336,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 夏侯令女","author":"陈普","text":"诸公竞起灭彝伦，特立当年一女身。\n尽付轻尘栖弱草，便从正始断无人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7337,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 夏侯玄","author":"陈普","text":"十家血染市朝红，更涨馀波及李丰。\n老子庄生真毒手，子元子上即而翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7338,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 夏侯玄","author":"陈普","text":"一日天诛正始馀，百年曹马两丘墟。\n景王似见铜驼祸，究极根源杀太初。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7339,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 徐邈","author":"陈普","text":"东第山成乱亦成，长星映酒甚分明。\n分劳太保惟徐邈，谁道能言独许营。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7340,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 晋武帝","author":"陈普","text":"宫中掷戟又飞刀，谢玖兢兢命若毛。\n岂是君王轻社稷，天教炽业谢芳髦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7341,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 晋武帝","author":"陈普","text":"杳杳羊车转掖庭，夕阳亭上北风腥。\n纷纷羔羯趋河洛，为见深宫竹叶青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7342,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 晋武帝","author":"陈普","text":"斥出维垣令太师，尽留群小凤凰池。\n争知暗里牵裾子，元是屠家揣肉儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7343,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 桓范","author":"陈普","text":"和血淆骸赤洛阳，绮疏应共枕红妆。\n乾坤无地容何邓，何必舁尸赴许昌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7344,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 殷浩","author":"陈普","text":"王濛谢尚不堪论，庾翼桓温亦浪言。\n两晋士风真可笑，尽将管葛许深源。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7345,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其八 诸葛孔明","author":"陈普","text":"面黑头黄味似饴，孔明伐贼妾蚕机。\n生前桑柘八百树，死后甘棠四十围。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7346,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其七 诸葛孔明","author":"陈普","text":"轲死无传直至今，孔明曾一正人心。\n拔刀斫石今犹愤，何况当年感激深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7347,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其六 诸葛孔明","author":"陈普","text":"飞羽凋零又秭归，卯金馀息孔明知。\n春秋两字诛千古，不用当年磔操丕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7348,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 诸葛孔明","author":"陈普","text":"郭淮岂得为许历，曹献敢言如亚夫。\n祁山再见伐崇旅，凤鸟不来嗟已夫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7349,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 诸葛孔明","author":"陈普","text":"关羽不能当一面，魏延何敢比淮阴。\n流星只缓身徂落，一木终能作邓林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7350,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 诸葛孔明","author":"陈普","text":"苍苍石穴五百里，炎热寒凉一汉家。\n绛灌萧韩同故道，关张不共出褒斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7351,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 诸葛孔明","author":"陈普","text":"褒斜邸阁可一饭，河渭安流漕九州。\n天乎马谡又霖雨，倍费心思作木牛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7352,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 诸葛孔明","author":"陈普","text":"不凭潼华驱曹马，试出褒斜馘合双。\n深念永安枕前语，横行河洛又临江。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7353,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 诸葛诞","author":"陈普","text":"义旗照日映淮流，不为曹孤为夏侯。\n麾下诸君底心性，海中五百又扬州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7354,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 贾诩","author":"陈普","text":"崩奔尧后一孤儿，蹠狗成群共肆欺。\n贾诩未投曹操日，自为汉贼已多时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7355,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 陶侃","author":"陈普","text":"苏峻鲸奔正可忧，翻令王室备荆州。\n五陵松柏无遗种，谩为桓温拾竹头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7356,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 陶潜","author":"陈普","text":"谢瞻屋里立篱墙，似水弘微粪也尝。\n康乐始兴门户尽，聿脩祖德独柴桑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7357,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 顾和","author":"陈普","text":"唤起鲸鲵满北州，过江仍复漏吞舟。\n一时共爱恢恢网，不悟三纲乱不收。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7358,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 顾荣","author":"陈普","text":"石勒王弥尚未昌，东南先有顾丹阳。\n顾荣持易淳于首，未必江东只许长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7359,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 高欢","author":"陈普","text":"段韶谷刹千金铸，彭乐丁公七宝装。\n虎子得来成底事，何如抱犊卧云岗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7360,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 高堂隆","author":"陈普","text":"负土衣冠乱满园，不知曹德是轩辕。\n土山白尽忠臣发，何似初来莫妄言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7361,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 曹丕","author":"陈普","text":"侏儒一节足亡身，衰绖三年笑杀人。\n不逐猇亭天子便，龙舟何用到江滨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7362,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 曹丕","author":"陈普","text":"鹊搆觚棱偶似诗，鸡栖庭树已当时。\n公车坐使诸侯急，却是奸人篡夺资。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7363,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 曹丕","author":"陈普","text":"春华建安曹子建，秋实西京张释之。\n父事邢颙奴七子，黄初便作万年期。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7364,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 曹爽","author":"陈普","text":"四聪八达免官时，仲达含香拜玉墀。\n二鬼不来同壑谷，未愁寡妇与孤儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7365,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 曹爽","author":"陈普","text":"眼中鸾凤悉豺枭，一日翩翩忽满朝。\n死近天教为吕禄，罪深地不著良宵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7366,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其七 曹操","author":"陈普","text":"英姿萧飒发硎刀，除却无君事事高。\n孟德文王能几许，只争谦退与矜豪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7367,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其六 曹操","author":"陈普","text":"迁都避宇岂男儿，子翼私行更可悲。\n四顾次且天狱里，蚤如仲达卤城时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7368,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 曹操","author":"陈普","text":"刘备孙权岂可忘，南来举趾遽扬扬。\n刘琮脱用王威计，送死何须到武昌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7369,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其四 曹操","author":"陈普","text":"濮阳火里又潼关，几度鲸牙虎口间。\n铜雀台前闲极目，惊魂犹绕白狼山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7370,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 曹操","author":"陈普","text":"无限英雄睨许都，到头倖免岂天乎。\n平生邂逅都经念，曾识篁中许贡奴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7371,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 曹操","author":"陈普","text":"扬旌北向顾南州，牧马东行向北愁。\n乱世奸雄还自叹，景升直与本初谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7372,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其一 曹操","author":"陈普","text":"横槊南来气吐霓，北归裁得景升儿。\n谁言孟德乌林日，全似本初官渡时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7373,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 梁武帝","author":"陈普","text":"戒舍工夫老未圆，百双鸡子送残年。\n一生般若成何事，赢得江头载荻船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7374,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 嵇绍","author":"陈普","text":"佞舌如簧乱孝思，竹林人物固猖披。\n御衣烱烱嵇生血，不似王生泪著枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7375,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 嵇康","author":"陈普","text":"铜驼荆棘夜深深，尚想清谈撼竹林。\n南渡百年无雅乐，当年犹惜广陵音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7376,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其六 谢安","author":"陈普","text":"封胡羯末皎琳琅，岁久浑无忆洛阳。\n江左家居照江水，谢安元为宋齐梁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7377,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其五 谢安","author":"陈普","text":"安石深源不共朝，共嫌俎豆不逍遥。\n无边赤子皆延颈，掩口胡卢独李辽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7378,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其八 谢安","author":"陈普","text":"宣元社稷等沉沦，不了昌明道子身。\n夺得桓苻二贼手，付与赵牙张贵人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7379,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其七 谢安","author":"陈普","text":"何国严刑禁老庄，有人拔剑斩韦郎。\n氐羌本自无天运，为有人心得暂狂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7380,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其三 谢安","author":"陈普","text":"临安猿鹤共清吟，犹作投机叩齿音。\n商鞅禹文无辨别，冶城数语是何心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7381,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其二 谢安","author":"陈普","text":"军中如意挥诸将，依约东山啸咏兄。\n不遣君王湛酒色，市朝犹足肆王甥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7382,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 其十 谢安","author":"陈普","text":"夷甫登朝日月昏，争知安石亦深源。\n当时赤子何无禄，直自高曾误到孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7383,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]