[{"title":"檐马","author":"缪鉴","text":"铮铮金铁夜交锋，酷敌秋声杀气雄。\n战退晓天尘不动，依然横槊待西风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8578,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鬼灯檠花","author":"缪鉴","text":"老死儒生习未除，残膏分得燎原馀。\n一枝冷焰摇清夜，要读生前未了书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8579,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"海棠","author":"缪鉴","text":"滴滴妖娆睡未醒，碎花犹带马嵬尘。\n少年正抱忧时恨，更有因花比太真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8580,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄刘澹斋","author":"缪鉴","text":"闻说商山有隐仙，刘郎引入洞中天。\n谁知白石苍苔客，独守孤灯夜不眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8581,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"月屋","author":"缪鉴","text":"一室虚明万境宽，水晶帘映玉阑干。\n不从此处逢仙子，争信人间有广寒。\n梅影夜窥霜镜满，桂香秋吸酒壶乾。\n客来试问推敲字，笑指湖光上下看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8582,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白发","author":"缪鉴","text":"老矣无心竞寸阴，不知公道为何人。\n晴梳栉齿千丝雪，静掩梨花一镜春。\n镊处痴儿愁是种，染来因药怪无嗔。\n儿曹共日誇头角，笑说非熊有渭滨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8583,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏围棋","author":"缪鉴","text":"午香帘影静浮华，对面机心万里赊。\n夹骑倒戈窥虎穴，乱乌横阵占鸥沙。\n当人不让争先著，袖手须饶老作家。\n欲访烂柯山下客，洞深春染碧桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8584,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏妓","author":"缪鉴","text":"谁去江云问牧之，玉楼人醉半离披。\n烛摇窗影三更月，人醉花阴十二时。\n访杜秋娘惟我老，梦扬州鹤有谁知。\n临风笑却垂杨下，重解连环寄所思。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8585,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春雪","author":"缪鉴","text":"撩乱春风作阵飞，晓来馀片尚离披。\n细看山色空明处，应似乾坤混沌时。\n一转阳和回土脉，十分清气入诗脾。\n芒鞋蹋碎琼瑶窟，问著梅花总不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8586,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花","author":"缪鉴","text":"铁石槎牙玉粒姿，诗中图画画中诗。\n半棱山色初晴后，一截溪烟欲暝时。\n流水带云栖瘦影，小窗和月上横枝。\n老来自觉吟情拙，莫遣孤山怨鹤知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8587,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"解嘲","author":"缪鉴","text":"莫笑诗翁懒出门，诗翁乐事在山村。\n莺啼杨柳金歌舞，蝶宿梨花雪梦魂。\n罨画丹青分曙色，压醅?醁涨溪痕。\n燕帘风里茶烟外，自选唐诗教子孙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8588,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题竹","author":"缪鉴","text":"甚矣吾衰矣，深居不用名。\n瘦因诗思苦，贫为利心轻。\n有竹堪医俗，无花可问盟。\n醉眠閒听雨，饥鼠齧书檠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8589,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题悟空寺","author":"缪鉴","text":"不到招提二十霜，眼明犹识鲁灵光。\n云餐已供伊蒲塞，风铎犹传替戾冈。\n新寺金汤龙化远，旧家王谢燕飞忙。\n行人指点簪犀地，十里春风土尚香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8590,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏妓","author":"缪鉴","text":"花木最无情，春风一番好。\n人怜新态度，一岁一回老。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8591,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏菊","author":"缪鉴","text":"谁去东篱号菊庄，饥来三嗅饱诗肠。\n何如陶令归南圃，天赐西风万斛香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8592,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春题","author":"缪鉴","text":"江云漠漠水悠悠，望断春风燕子楼。\n书寄碧云千里雁，镜分明月半奁秋。\n来时杨柳阴连陌，归路蘋花雪满洲。\n遥想琐窗挑锦字，泪珠如粉冷银钩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8593,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"得女","author":"缪鉴","text":"得驹未必真权奇，中雀未必有淑姿。\n男儿未必勋鼎彝，女子未必光门楣。\n吾今素发纷如丝，得此一笑春生眉。\n苍苍天道不我遗，犹胜伯道全无儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8594,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"端居","author":"缪鉴","text":"修竹垂杨映户栽，清风长送午阴来。\n门因好客时时扫，窗为看山面面开。\n此乐恐于儿辈觉，长贫能免俗情猜。\n儒衣不似牛衣好，叮嘱糠妻放窄裁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8595,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠僧","author":"缪鉴","text":"两脚行来铁石坚，相逢去住总随缘。\n谈空舌本原无语，打破机关不用拳。\n山槛看云斋鼓后，竹窗听雨夜灯前。\n客来瀹茗煨寒柮，味胜庐峰第一泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8596,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自题小像","author":"缪鉴","text":"白发苍颜，溪藤兔颖。\n水月光中，梅花弄影。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8597,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其一","author":"缪鉴","text":"雁沈秋驿雨，鸡送晓窗灯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8598,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"缪鉴","text":"门因好客时时扫，窗为看山面面闭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8599,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其二","author":"缪鉴","text":"门当车马道，帘隔利名尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8600,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其五","author":"缪鉴","text":"既能事汉识真主，何必下齐求假王。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8601,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"缪鉴","text":"病独有药扶持老，贫为无人心俯仰人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8602,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九月西城无涧同陈道士衡上人 其二","author":"戴表元","text":"巾衣三客不须同，泉石相看我亦翁。\n最惜一轩秋烂熳，芙蓉池上木犀风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8603,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九月西城无涧同陈道士衡上人 其一","author":"戴表元","text":"仙翁面带江海色，释子口融冰雪浆。\n同是西风未归客，烧香煮茗作重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8604,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"入杭","author":"戴表元","text":"曾江白酒樊江饭，处处当年客似家。\n垂老重来旧相识，春风只有野桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8605,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"马浩秀才携秋日海棠诗见过","author":"戴表元","text":"山城八月有春风，一树嫣红淡又浓。\n纵使失时无态度，也胜茉莉与芙蓉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8606,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五云山图","author":"戴表元","text":"林庐深插紫孱颜，一点渔舟带暝还。\n但得身閒无俯仰，人间处处五云山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8607,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"水墨梅花","author":"戴表元","text":"江海归来见似人，离披犹自少风尘。\n何如淡月山庄夜，百幅清溪乱写真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8608,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其三 大小横山","author":"戴表元","text":"小横欲尽大横来，万壑千岩汹涌开。\n闻道洞天深几许，紫云深处有楼台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8609,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其七 木兰","author":"戴表元","text":"七里黄泥红树冈，西风果熟一村香。\n居人只道山深好，三百年来是战场。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8610,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其八 仙山","author":"戴表元","text":"仙在人间不易寻，当时已道是山深。\n可怜华表标题处，夜夜猿啼枫树林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8611,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其四 北溪","author":"戴表元","text":"乱云穿尽得平芜，一段冰寒碧玉壶。\n犹是春风未相弃，山前吹长万龙须。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8612,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其十 白水","author":"戴表元","text":"刘郎一去杳无踪，水白山青只故宫。\n欲问岩前老松树，人间禁得几秋风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8613,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其九 羊额岭","author":"戴表元","text":"两颊棱棱额下分，更无坳处可藏云。\n西风怕夺行人眼，荞麦满山铺锦云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8614,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其一 枫树坑","author":"戴表元","text":"雁飞不断楚天长，云路霜林级级黄。\n何处人烟有墟落，北风高垄散牛羊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8615,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其二 茶焙","author":"戴表元","text":"山深不见焙茶人，霜日清妍树树春。\n最有风情是岩水，味甘如乳色如银。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8616,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其六 莽广溪","author":"戴表元","text":"怪石惊湍吼不休，时时岩客饮寒牛。\n谁知此水明州去，浸作琉璃万顷秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8617,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中十绝 其五 韩采岩","author":"戴表元","text":"洞深烟树碧氤氲，只采灵苗不采薪。\n闻着踪由多懒说，相逢莫有姓韩人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8618,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戊戌清明杭邸坐雪","author":"戴表元","text":"思乡处处只愁生，正好春游又不晴。\n雪是梨花云是柳，马婆巷口过清明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8619,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玄庙二道士俱以酒死","author":"戴表元","text":"张髯好客月千壶，余吃清贫逐斗沽。\n二子若逢仙宴会，化成一对酒葫芦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8620,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同曹泰宇赋宝化凤花二首 其二","author":"戴表元","text":"凤皇不出几何年，莫怪山花惜杜鹃。\n一样春风好毛羽，回头曾管蜀山川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8621,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同曹泰宇赋宝化凤花二首 其一","author":"戴表元","text":"花开难得年年看，住近须还日日来。\n古壁危阑自颜色，不烦高筑凤皇台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8622,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吕氏六桂堂","author":"戴表元","text":"年少奔驰有底忙，棘闱兰署梦茫茫。\n白头鞍马风沙里，听说燕山六桂堂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8623,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"因营张村蛮窝并书所见 其二","author":"戴表元","text":"头白西来不买田，时时却费买山钱。\n一丘一壑吾归矣，待得田多是几年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8624,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"因营张村蛮窝并书所见 其三","author":"戴表元","text":"男儿三十气吞牛，漏尽钟鸣走未休。\n不问征西并处士，山中一样土馒头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8625,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"因营张村蛮窝并书所见 其一","author":"戴表元","text":"老子来无一把茅，居然得此好洼坳。\n开塘谨避蛟龙窟，伐树须存乌鹊巢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8626,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"有人示山水画卷以为元晖作求诗","author":"戴表元","text":"砚山山下小于菟，文彩斓斑今亦无。\n一坞乱云浓似潻，春风吹梦过西湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8627,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其六","author":"戴表元","text":"舍南舍北种田郎，唱得田歌曲曲长。\n莫学傍村游侠辈，茜红抹额臂擎苍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8628,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其五","author":"戴表元","text":"三间瓦屋数弓园，旋学桑麻又一年。\n村酒沾唇频得酒，山歌出口即成篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8629,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其四","author":"戴表元","text":"剡源田舍谁能识，只此桃源有路通。\n草长岸漫渔堑北，月明人语纸槽东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8630,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其三","author":"戴表元","text":"祝鸡归后放牛初，小立溪梁看打鱼。\n渐喜村邻尽相识，向来朋旧却无书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8631,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其二","author":"戴表元","text":"炊成日影三竿直，睡起溪流十尺高。\n懵懂不知何岁月，山风吹白镜中毛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8632,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵答邻友近况六首 其一","author":"戴表元","text":"十百琅玕接屋山，麦花淡白菜花班。\n村园富贵谁消得，更看溪南墨牡丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8633,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"百雁图","author":"戴表元","text":"近看分明远欲无，水天空阔好江湖。\n幸然不入虞人眼，又被閒中画作图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8634,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"百鹭图","author":"戴表元","text":"苇折荷枯可奈何，西风吹影净婆娑。\n微君作此超摇趣，一个江天也厌多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8635,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西兴马上","author":"戴表元","text":"去时风雨客匆匆，归路霜晴水树红。\n一抹淡山天上下，马蹄新出浪花中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8636,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西塞山图","author":"戴表元","text":"空中生业寄鱼蓑，云是亲情水是家。\n便有踪由无处觅，春风岸岸野桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8637,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过姑苏","author":"戴表元","text":"水天弥望接青芜，云气漫漫近又无。\n一色好风三百里，挂帆安坐过姑苏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8638,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过鄮山祠塾作","author":"戴表元","text":"沧江城阔三叉口，白日弦歌数亩宫。\n犹有祠宫旧杨柳，向人离立管春风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8639,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张骞乘槎图","author":"戴表元","text":"数尺枯槎底易骑，海风吹浪白瀰瀰。\n如今市上君平少，曾到天河也不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8640,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李元中秀才岁晚游诸公间","author":"戴表元","text":"愁中待醉何曾醉，梦里还家不是家。\n输与山行穷学究，一筇一笠看梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8641,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"汪济秀才饭牛稿","author":"戴表元","text":"冰雪玲珑汪太中，吟诗十叶有家风。\n天寒日暮江东道，逢此颦呻牛口翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8642,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"灼艾戏呈阮使君","author":"戴表元","text":"鬓毛秋后转漂零，愁坐穷檐展灸经。\n得似画堂歌吹里，硫黄钟乳按娉婷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8643,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苏李图","author":"戴表元","text":"塞北中郎雪满头，陇西壮士泪沾裘。\n人生百岁能多少，直至如今说未休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8644,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陈公哲梅花百咏 其二","author":"戴表元","text":"雪后西湖空碧波，酒徒消散也无多。\n白头醒眼春风里，奈此梅花百咏何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8645,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陈公哲梅花百咏 其一","author":"戴表元","text":"梅下故人呼不应，石桥溪寺水泠泠。\n回头听得陈惊坐，一似春风吹梦醒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8646,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"周秀才惠猫","author":"戴表元","text":"狸儿轻捷豹儿斑，作势擒生也不难。\n渐觉形神欲相贺，青奴黄奶夜平安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8647,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"奉化城西三溪口","author":"戴表元","text":"青林白石三溪口，斑笋黄梅四月头。\n正好清游谁懒得，幸无公事且归休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8648,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"茅斋","author":"戴表元","text":"红杏园林雨过花，远陂深草乱鸣蛙。\n春风不问茅斋小，自向阶前长笋芽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8649,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨中过泉教张子开 其二","author":"戴表元","text":"衣冠颠倒君休怪，筋力过从我有馀。\n却笑秋风洛阳掾，得归犹望食鲈鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8650,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]