[{"title":"春景 寒尽怕春销","author":"刘辰翁","text":"飞絮新烟外，东风托信遥。\n春犹有寒否，寒尽怕春销。\n画阁围红兽，行鞭裹黑貂。\n便无三月雨，也不再花朝。\n倚翠还轻扇，飞红共落潮。\n少年宜秉烛，莫负可怜宵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10187,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 山归万古春","author":"刘辰翁","text":"万古山如此，青青岁岁新。\n自怜看到老，未有不归春。\n云树曾经别，莺花不弃贫。\n自迎东太乙，重作葛天民。\n一烧迷千仞，三开见几秦。\n八公花下饮，仍是少年人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10188,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 池塘生春草","author":"刘辰翁","text":"满眼成新趣，池塘午梦惊。\n青春何日到，芳草满前生。\n縠縠东风起，波波两剪横。\n翠钿如可拾，仙药不知名。\n转步玉钩合，几时珠履行。\n平陂青似海，无处认昆明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10189,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 春风花草香","author":"刘辰翁","text":"高下花成谷，烟绵草际空。\n以香为世界，布馥是春风。\n骀荡蛛丝外，颠狂蝶梦中。\n汀洲仙药市，天地锦薰笼。\n澧浦遗余绿，昌州绝世红。\n馀芳犹可藉，应恨耿匆匆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10190,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 闲院绿阴生","author":"刘辰翁","text":"花院苔空积，游丝若有情。\n断无珠履迹，闲见绿阴生。\n缥缈朱帘悄，丁东玉漏鸣。\n隔窗梅子落，绕屋笋竿成。\n几日落红雨，数声深处莺。\n午鸡人睡起，绕水看鱼行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10191,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 阊阖开黄道","author":"刘辰翁","text":"阊阖祥光起，班行好语催。\n青郊随候应，黄道似初开。\n梦绕天门去，风从震地回。\n东西行白日，南北验清台。\n晓殿分龙角，春城转斗魁。\n中天符四七，人物万方来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10192,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 衣冠拜紫宸","author":"刘辰翁","text":"万古衣冠旧，三朝历数新。\n青皇来远道，紫袖拜严宸。\n花日明簪冕，槐云舞佩绅。\n昭容当槛晓，宰相贺班春。\n索令分同列，传呼掖老臣。\n汉仪当日事，江汉四朝人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10193,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其一 新年贺太平","author":"刘辰翁","text":"乱向残年定，东风息战尘。\n太平如可待，相见贺从新。\n自笑屠苏我，谁吹画角秦。\n几人天宝旧，重赏后元春。\n卖钏犹堪醉，簪花不恨贫。\n渊明今甲子，犹是晋时人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10194,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其二 新年贺太平","author":"刘辰翁","text":"相过贺新元，干戈且息肩。\n不图垂老日，还见太平年。\n灰向昆明尽，春从待漏传。\n衣冠禾黍地，箫鼓杏花天。\n灯市嬉遗老，旗亭卧醉仙。\n山林闻好语，天下米三钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10195,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 明月逐人来","author":"刘辰翁","text":"人影光相乱，月明灯市开。\n依依随马去，故故逐人来。\n胜赏春三五，流光酒一杯。\n为君分绮席，同我上瑶台。\n扶路倾相就，分襟逝却回。\n玉山人醉矣，健到莫惊猜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10196,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 风起春灯乱","author":"刘辰翁","text":"故是春风起，香尘暖未曾。\n暮寒惊翠袖，春影乱华灯。\n泠浸朱门月，吹成碧海冰。\n沙河三五夜，火树几千层。\n金炬开莲岛，银花飐玉绳。\n一声清跸远，冷落内前棚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10197,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 溪壑回春姿","author":"刘辰翁","text":"云拥千溪断，霜溪万壑衰。\n自从回煖景，依旧是春姿。\n晴日云千叠，东风雨一池。\n还他新岁好，似我少年时。\n锦水桃千障，巫山柳十眉。\n时同天一笑，不敢恨衰迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10198,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 暗水流花径","author":"刘辰翁","text":"日出习池游，晴檐水不收。\n几回经草暗，一径带花流。\n汩汩何从至，青青自欲浮。\n但疑红雨涨，不似御沟愁。\n静听鸣金谷，行迷失玉钩。\n凌波罗袜润，大是断桥头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10199,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其一 小水细通池","author":"刘辰翁","text":"过雨山泉润，悠悠小水同。\n未嫌来脉细，更与曲池通。\n花径频违湿，苔沟暗入丛。\n却看萍破碧，未觉叶流红。\n涧壑千枝曲，乾坤一镜中。\n所嗟瓜地远，不得灌连筒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10200,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其二 小水细通池","author":"刘辰翁","text":"小小回堤水，花阴寸步随。\n细难为灌圃，长是曲通池。\n乳窦仍从出，云根触处滋。\n又添晴滴沥，欲涨碧涟漪。\n新绿常如雨，流红未见诗。\n昆明鲸背浅，尽日絮沟迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10201,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 仰蜂粘落絮","author":"刘辰翁","text":"采采香无据，游蜂与絮兼。\n轻吹无影落，仰抱有时粘。\n攲蕊栖难稳，垂跗采未嫌。\n花须纷更辨，柳雪误相沾。\n未碍餐能饱，贪看咽欲甜。\n吟安时失笑，往往似吾髯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10202,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 绿阴生昼寂","author":"刘辰翁","text":"深院停春雨，庭空鸟不鸣。\n自然清昼寂，尽是绿阴生。\n满眼成青幄，无人惜绛英。\n轻风低鼎篆，迟日上帘旌。\n远水明鸂鶒，平栏绕杜蘅。\n小窗临晋帖，误落剪刀声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10203,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 燕子家家入","author":"刘辰翁","text":"燕子来何晚，城春换物华。\n逢人能语语，随意入家家。\n故宇何堪恋，朱帘可得遮。\n王门深巷悄，谢墅夕阳斜。\n是处随芳草，无情似柳花。\n兴亡真阅遍，尽是主人差。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10204,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 春燕巢林","author":"刘辰翁","text":"燕子故依人，重来迹已陈。\n主楼空舞地，林木自巢春。\n无复郊迎乙，惟应语诉辛。\n乾坤一枝土，风雨画梁身。\n荒草歌尘远，颓松社屋新。\n寻常空巷里，忆着旧家贫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10205,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 浙江花木深","author":"刘辰翁","text":"游子江南老，美人浙水阴。\n风光何冉冉，花木自深深。\n蘋渚藏妃怨，兰皋寄屈吟。\n飘香迷去路，种子约青林。\n远浦归帆兴，芳洲来暮心。\n天寒人倚竹，目断去鸿沈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10206,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其一 孤舟乱春华","author":"刘辰翁","text":"天地孤舟客，东风是处家。\n偶然乘兴远，不拟乱春华。\n牢落无茶具，飘零自钓槎。\n误将青箬笠，撑入碧桃花。\n路断云相觅，溪深柳又斜。\n忽闻鸡犬近，随处有桑麻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10207,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其二 孤舟乱春华","author":"刘辰翁","text":"罨画来兼往，孤舟自若耶。\n悠悠信溪路，籍籍乱春华。\n今古三高客，乾坤一叶家。\n泛桃冲雨过，穿柳带烟斜。\n下水随飞燕，移梢为惜花。\n日斜归兴急，恐或见胡麻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10208,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其三 孤舟乱春华","author":"刘辰翁","text":"晴日孤舟好，溪流带岸斜。\n浮游忘世虑，烂熳乱春华。\n朝共渔穿港，暮随鸥宿沙。\n却知桃有路，惟见柳无涯。\n蓑舞村村酒，罾歌处处花。\n群仙惊再见，留宿武陵家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10209,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 其四 孤舟乱春华","author":"刘辰翁","text":"有客孤舟里，风平日又嘉。\n未须怜岁晚，从此乱春华。\n自扣舷三版，相将水一涯。\n前村随柳色，昨夜宿桃花。\n鸥浴波翻锦，渔歌影入霞。\n江头稠杏暗，子美四娘家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10210,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 游丝白日静","author":"刘辰翁","text":"静似长门里，初晴未暑时。\n悠悠销白日，冉冉上游丝。\n白发因风起，青虫映户垂。\n墙阴双蝶远，花影一帘迟。\n新垒乾泥絮，晴衙散蜜脾。\n鸟惊梅子落，深院客争棋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10211,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 柳叶暗金沟","author":"刘辰翁","text":"辇路垂垂柳，昆明寂寂流。\n近天高翠叶，映日暗金沟。\n眠起当前殿，萎蕤拂御舟。\n锁成三阁暮，流出六宫愁。\n桐影题难立，杨花宕不收。\n至今寒食雨，堕泪曲江头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10212,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 花飞减却春","author":"刘辰翁","text":"老子情如海，花无醉后新。\n飞来如许雪，减却不多春。\n轻薄随流水，颠狂落近邻。\n犹寒犹未晚，半雨半成尘。\n拾翠危无路，残红老得人。\n清晨添酒量，日日是芳辰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10213,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 城春草木深","author":"刘辰翁","text":"春又不知暮，城荒独至今。\n楼台花下远，草木雨中深。\n寒食无烟绿，颓垣有月侵。\n荒苔随意古，落子又成阴。\n邻笛残兵泪，胡琴故国心。\n废兴天不语，钟鼓遍园林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10214,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 春色在邻家","author":"刘辰翁","text":"春色阑珊去，朱门懒梦华。\n悠悠看蝶翅，往往在邻家。\n暖日明金谷，光风媚浣沙。\n似闻携手笑，疑有隔墙花。\n望眼穿银汉，香尘透绿纱。\n是谁窥宋玉，憔悴一枝斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10215,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 吹面受和风","author":"刘辰翁","text":"寒曾欺我倒，今日是和风。\n吹面浓春酒，开怀受化工。\n未知来暖律，政似识癯翁。\n大袖犹堪满，衰颜欲更红。\n鬓如新柳动，鼻与暗香通。\n天上知何信，千花一笑中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10216,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春景 火树银花合","author":"刘辰翁","text":"星炬乱林鸦，火城标赤霞。\n端门开璧月，散树合银花。\n光燄摇千尺，扶疏转九华。\n昭回三阁近，凿落万枝斜。\n玉李迷天象，金莲出内家。\n龙光如海蜃，犹有误连车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10217,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 薰风自南来","author":"刘辰翁","text":"当年唐殿阁，何似道人庵。\n闲日长如此，薰风来自南。\n清香吹不断，大暑故如惔。\n静见花阴午，凉添竹径三。\n客遮前席坐，人卧北窗酣。\n别墅棋边急，闲将赤壁谈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10218,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其一 夏雨生众绿","author":"刘辰翁","text":"入夏可曾晴，阴阴众绿成。\n但惊春尽去，谁信雨中生。\n一月须梅润，千林但叶声。\n荷边蒲猗傩，桑外笋峥嵘。\n芳草非无恨，新条各向荣。\n秧田禾似浪，满眼几时平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10219,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其二 夏雨生众绿","author":"刘辰翁","text":"无人嫌夏雨，众木共欣荣。\n已办黄梅熟，还将绿叶生。\n送春无物色，尽日是檐声。\n处处桑麻长，阴阴桃李成。\n风翻蒲水白，烟共草天平。\n山色沈冥久，朝来两黛横。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10220,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 雨过苔花润","author":"刘辰翁","text":"雨过残春远，晴天半入梅。\n草根馀落照，花润只深苔。\n山共朱帘捲，庭无蜡屐来。\n翠钱流地满，珠靥照人开。\n寂寂承残霤，青青绕废台。\n唾茸宫壁在，残月照馀哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10221,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 既雨晴亦佳","author":"刘辰翁","text":"既雨失阴霾，天怜万灶蛙。\n是虽犹暑润，亦自觉晴佳。\n早见瓢翻海，今无漏透阶。\n但能开晚景，粗足慰人怀。\n山翠光浮玉，涂泥软衬鞋。\n一帘花露影，醉眼为渠揩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10222,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 树湿风凉进","author":"刘辰翁","text":"树晚晴犹湿，好风如故长。\n翛然林下意，进似雨时凉。\n坐觉茅容徙，来看吕政忙。\n飘萧初似暑，淅沥转成霜。\n倚袖岚添翠，题秋叶欲黄。\n不知兼露下，河汉芰荷香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10223,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其一 松凉夏健人","author":"刘辰翁","text":"松影夏天云，凉开一院新。\n若无如此暑，可以健于人。\n风外潮声起，林间客欠伸。\n自怜三伏日，重得百年身。\n鹤唳如轻举，儿扶更怒嗔。\n下山逢急雨，为洗覆车尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10224,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其二 松凉夏健人","author":"刘辰翁","text":"天地若为容，凉阴何处逢。\n困人惟夏日，健我是云松。\n雨立三千丈，风生一万重。\n如餐华峰藕，不藉葛陂龙。\n脱帽苍虬笑，披衣病鹤松。\n月明天似水，归路踏芙蓉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10225,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 露顶洒松风","author":"刘辰翁","text":"野处阙过逢，投巾仰露空。\n萧萧松下老，洒洒顶门风。\n暑不容章甫，天犹念秃翁。\n昂霄潮汹汹，落雪鬓蓬蓬。\n搔首平生事，忘形半醉中。\n蓬莱归去路，潦倒笑臣同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10226,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 清风松下来","author":"刘辰翁","text":"狭世清风少，清风不受催。\n惟应松下有，肯向坐间来。\n襟袖元如水，山林自少埃。\n遂惊弘景宅，不是楚王台。\n柳巷无人扫，柴门尽日开。\n是谁前喝道，空遣鹤飞回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10227,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 林风凉不绝","author":"刘辰翁","text":"不可居无竹，清风动满林。\n长无如夏日，凉不绝予襟。\n安得秋如许，能令午正阴。\n两间何舋舋，三径自深深。\n簟玉翻如水，檐冰语至今。\n故人千万里，明月两知心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10228,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 乔木生夏凉","author":"刘辰翁","text":"何可无乔木，多年雨露成。\n是间凉意别，长夏绿阴生。\n日度云旗影，风含涧水声。\n能令霜六月，不待月三更。\n翠幄宜琴枕，枯棋就石枰。\n五楸朝又暮，故国可胜情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10229,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 清室夏含霜","author":"刘辰翁","text":"一室兰香满，阴阴夏木成。\n炎光虽自酷，霜意自含清。\n佩玉传风马，钩帘下水精。\n燕台无六月，楚户忽三更。\n冷袖藏冰藕，凉蟾满露茎。\n江湖无雁信，诗鬓自先惊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10230,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 凉引簟先秋","author":"刘辰翁","text":"八尺横斜簟，寒光凝不流。\n引教凉到我，坐觉意先秋。\n溽暑收梅雨，清风度竹楼。\n湘纹殊似水，班扇未应愁。\n冷逼金茎润，温便玉臂柔。\n颇哀城市悄，斗米换衾裯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10231,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 盛夏火为日","author":"刘辰翁","text":"日在天无二，明明夏盛时。\n到今虽可爱，非火孰能为。\n谩把薰弦语，难禁坐甑炊。\n未应一杯水，能沃九华枝。\n王屋飞犹在，昆冈事可知。\n未须频梦灶，倏忽看崦嵫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10232,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 莲房坠粉红","author":"刘辰翁","text":"莲欲成房去，三三两两空。\n摘来中有子，坠处粉尤红。\n已镂冰为藕，谁将翠作蓬。\n半妆摇越棹，一水腻秦宫。\n濯濯含秋露，亭亭立晓风。\n么荷因见忆，憔悴感青铜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10233,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 竹影金琐碎","author":"刘辰翁","text":"竹可淋漓画，难将竹影临。\n寂寥谁布地，琐碎总如金。\n密处开为径，疏时舞又阴。\n汗青销作字，翡翠屑成林。\n弄月平分破，临风凿落斟。\n锵然声入耳，忽认是徽琴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10234,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 炎赫衣流汗","author":"刘辰翁","text":"暑绤衣能几，长流汗似痁。\n惶惶何慄慄，赫赫复炎炎。\n安得三庚度，犹如十日兼。\n坐惊惭背浃，不是泪襟沾。\n汤饼何堪试，煎茶可更添。\n可人娇熨玉，频起立风檐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10235,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 梦回莲叶雨","author":"刘辰翁","text":"万叶胜花开，莲香雨送来。\n欲知凉可爱，政是梦初回。\n未拟华胥转，谁将绣户推。\n棹歌摇别浦，裙影湿阳台。\n天上霓裳断，人间羯鼓催。\n酒醒茎露渴，狂引碧筒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10236,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其一 衣冷欲装绵","author":"刘辰翁","text":"老厌人间热，单衣就冷泉。\n不知清到骨，故欲转装绵。\n萝月满襟雪，松风半臂仙。\n顿疏桃竹瑩，拟就柳花眠。\n倚倦思燕玉，全生愿蜀毡。\n温汤无去路，搔首听潺湲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10237,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 其二 衣冷欲装绵","author":"刘辰翁","text":"石洞元无暑，泉声洒面凉。\n衣疑中夜冷，绵欲此时装。\n洒洒惊荷雨，披披变葛霜。\n拟将洴澼絖，换却薄罗裳。\n中道怜班女，温言忆楚王。\n骊山在何许，我更念温汤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10238,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 褦襶子","author":"刘辰翁","text":"俗子高门走，那知物意嫌。\n婆娑中避暑，褦襶早趋炎。\n楚楚朝衣格，峨峨古帽檐。\n夤缘三伏谒，瞻仰上官严。\n尚说毛寒慄，宁辞背汗沾。\n寄言乡里者，贷我北窗眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10239,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 清泉洁尘襟","author":"刘辰翁","text":"是事不堪闻，清泉独可亲。\n翛然携鬓影，聊以洁尘襟。\n帘泻千年雨，蓝拖百尺绅。\n能令肝肺雪，更遣芰荷新。\n京洛昏沈梦，江湖淡荡身。\n一瓢明月燕，并洗脱靴嗔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10240,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 涉江采芙蓉","author":"刘辰翁","text":"梦破芙蓉雨，蛾眉琐绿窗。\n悠悠思远道，采采涉长江。\n北渚浮湘水，西兴渡越邦。\n波穿红锦乱，影转画桡双。\n花路迷相问，菱歌远失腔。\n扣舷惊水鸟，晼晚笑吴憃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10241,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 公子调冰水","author":"刘辰翁","text":"盛世佳公子，明光避暑曾。\n调冰初入水，和水亦成冰。\n鸣佩朝仪凤，扬鞲夕臂鹰。\n汲来金碗脱，搅碎玉崚嶒。\n一吸风林壑，重倾雪肺膺。\n琼姬持袖举，疑饮露盘升。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10242,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夏景 炎宵恶明烛","author":"刘辰翁","text":"畏日才宵匿，谁教烛又添。\n明虽无可恶，看得故成炎。\n漏永风如禁，膏残饮未厌。\n万枝何用许，一点有人嫌。\n蛾命那知惜，虫花懒复占。\n吴牛应自笑，何事畏银蟾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10243,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]