[{"title":"贺山房先生得孙","author":"方一夔","text":"晚节归来绿野堂，传家衣钵付诸郎。\n喜存千载古罍洗，初听九苞雏凤凰。\n春蚤桐枝新濯秀，日长棣萼剩流芳。\n公家好事联翩在，首寄诗篇写弄璋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10059,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃梅泉见寄咏稼隐相过之乐并督作诗 其一","author":"方一夔","text":"星聚何曾奏少微，浮萍桂海偶相随。\n掺袪东阁吟梅处，眵目寒窗点易时。\n自叹两翁馀口业，悬知千载有心期。\n啼猿唳鹤初无事，怕有行人怪说诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10060,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃梅泉见寄咏稼隐相过之乐并督作诗 其二","author":"方一夔","text":"梅压沧浪密复疏，临流几度濯緌絇。\n侯封富贵归千首，身计行装挂一壶。\n文饮暂教吾辈共，骚坛谁道我军孤。\n汾亭洗尽筝琵耳，重理丝桐縆老梧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10061,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次对稼隐病后见寄","author":"方一夔","text":"自怜数米续晨炊，饥火空时万想虚。\n富贵由来如梦鹿，江湖是处可羹鱼。\n风轮岁月催人老，水镜襟怀与世殊。\n书信柴胡俱不到，空惭多病马相如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10062,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦热五首 其一","author":"方一夔","text":"夏来樊圃隔阴晴，谁与天工管不平。\n一窟蛟龙时作怪，千年草木偶成精。\n政疑沙界熬焦釜，未倒银河洗太清。\n谁是苍生霖雨手，普将禹甸酿西成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10063,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦热五首 其二","author":"方一夔","text":"绛节彤幢禦火精，世间那是水晶城。\n醉横蕲竹愁重醒，睡落齐纨惜屡惊。\n家口飞蚊儿女语，乡心过雁弟兄情。\n更阑谁撼千章木，误作连床夜雨声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10064,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦热五首 其三","author":"方一夔","text":"午醉醒来濯碧泉，水亭况是晚凉天。\n横眠莲叶半晞发，静对杨枝双袒肩。\n蹇蝘声乾林更静，碧梧阴转月初圆。\n茶瓯更试纤纤手，不仗清风送玉川。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10065,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦热五首 其四","author":"方一夔","text":"六龙无计驻双丸，壮志摧颓似倒澜。\n万里不成游客梦，半生祇办腐儒餐。\n谁怜打草衰麻答，不羡画松杨契丹。\n世上纷纷誇秃发，到头那肯着南冠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10066,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桂花","author":"方一夔","text":"服食生平屑辟邪，死埋金粟或金沙。\n忽惊秋骨开成雪，谁遣香魂化作花。\n云外孤芳吟舞鹫，月中半影匿妖蟆。\n先生幽佩乘风去，独向仙堂看织纱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10067,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐月下","author":"方一夔","text":"残云点点四飞扬，万里离人共此光。\n谁铸水银悬绛阙，独留姹女捣玄霜。\n窟中蟾兔双灰劫，影底山河几战场。\n欲驻颓晖无意计，何人楼角韵伊凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10068,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读赤壁赋","author":"方一夔","text":"万舸浮江互荡磨，一番蛟鳄战盘涡。\n中天日月悲分影，对局英雄付逝波。\n形胜空传二赤壁，文章谁肯百东坡。\n荆州风景今何似，秋夜时闻窈窕歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10069,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晚眺二首 其二","author":"方一夔","text":"隔江斗入白云村，分我閒云伴绮园。\n月鹊自惊翻舞影，露虫相吊洗啼痕。\n穷通蜍玉横书案，得失枭卢转采盆。\n可惜床头枕客道，萧萧奔马醒吟魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10070,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵王蒙泉见寄并和鄙作","author":"方一夔","text":"夜雨连床忆旧时，鳞鸿难寄故人诗。\n怜君不察抱心久，写我何如问信迟。\n两地云萍无定迹，一庭风月不分岐。\n寸衣换得天吴锦，岂是骚盟一字师。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10071,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"菊花","author":"方一夔","text":"不入萎红烂紫场，萧然清苦凛风霜。\n客中衰鬓随秋老，篱下寒枝似旧香。\n千载有陶期汗漫，几人后屈话凄凉。\n每愁摇落知谁在，只有黄花守死黄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10072,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄何稼隐","author":"方一夔","text":"忆昔相逢霜露寒，再三与我返乡关。\n溪行散乱飞蓬鬓，旅泊凄凉落日颜。\n活计独传鸿宝苑，清游重上鹿门山。\n崇朝触石需滂沛，笑我閒云苦未閒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10073,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶作","author":"方一夔","text":"结缘无成谩学书，倦飞犹自拣庭梧。\n不离文字添衰鬓，已外声名谢壮图。\n伯略莫教累恩泽，儒诗何事污裙襦。\n从今便觉高抬眼，不要奄奄学志蝓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10074,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃梅泉见寄并见和鄙韵 其一","author":"方一夔","text":"谩道萍踪日夜浮，自惭迟钝恋菟裘。\n圣传杯里兰亭帖，婢熟山中笠泽秋。\n有信付将来去燕，无心寄与没浮鸥。\n去年曾记梅花下，细雨离魂阻胜游。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10075,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵沃梅泉见寄并见和鄙韵 其二","author":"方一夔","text":"散仙自在步如飞，络脑黄金不受羁。\n篱菊清香须把酒，京尘红涨不缁衣。\n倚楼看剑浮名逼，闭户寻诗过客稀。\n水击枪榆俱有得，不妨着我子陵矶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10076,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至日","author":"方一夔","text":"九地穷阴迸稚阳，万家起早拜迎长。\n梅将暖信迎青帝，橘子真心服后皇。\n耳药肯涂银盒雪，牙硝自踏板桥霜。\n诗情只会如工部，至日年年客异乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10077,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和府尹虚谷先生和徐子英韵并寄徐子英 其一","author":"方一夔","text":"千峰苍翠拥城楼，着我宗英七里洲。\n昔日松楸相伴住，暮年湖海未归休。\n咏诗遥认穷司马，骑竹争迎旧细侯。\n莫为梅花长挽却，好将绳削订由求。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10078,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"兵革后初出邑郭","author":"方一夔","text":"无数青山对坐衙，读书林下静无哗。\n如今风景那须说，坊郭无民吏数家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10079,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"红梅","author":"方一夔","text":"霜月娟娟午夜寒，酒酣来此凭阑干。\n满枝艳色惊愁眼，宣主当年唾未乾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10080,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"世言有问脩短之数于希夷者曰好来好去因观落叶有感前语","author":"方一夔","text":"芳菲桃李雨新肥，绯绿园林露已凄。\n自道好来还好去，到头总是涴尘泥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10081,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"震泽市","author":"方一夔","text":"石峰叠叠小桥西，昔日人家桃李蹊。\n无限欢娱俱寂寞，珠玑锋镝逐春犁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10082,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐评史 史记","author":"方一夔","text":"迁史驰驱纵复横，不烦绳削自天成。\n后来纵欲修良史，法度森严敢变更。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10083,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐评史 西汉书","author":"方一夔","text":"班固师迁亦步趋，末容后进造庭隅。\n半生描摸龙门像，虽乏精神貌却腴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐评史 东汉书","author":"方一夔","text":"羡渠二子着先鞭，未把文章许范传。\n远出孟坚畦径下，谩誇笔势舞翩翩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐评史 顺宗实录","author":"方一夔","text":"韩老文章不减迁，中山一传更增妍。\n如何实录二三卷，气薾言卑不类前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐评史 五代史","author":"方一夔","text":"自许精严独有欧，庸奴班马法春秋。\n文章虽到精神露，殆与二书争一筹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"客有善谈谑者曰鳅鲇鱼龟皆水族也一日聚议谒河伯求职事鳅先去河伯授以右相鲇鱼次之授以左相龟行迟欲以翰林处之龟不愿曰好官二子俱做但愿河伯注长寿看二子做到何处其言虽谑可为发一笑也谩记其事","author":"方一夔","text":"佣耕陈胜假为鬼，烂斧王乔诈得仙。\n若见渊明为我道，并从金母乞长年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"富贵","author":"方一夔","text":"怀清台废娇娥怨，醉白堂空过客愁。\n若向此时回首看，生平富贵一齐休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读刘阮事用元微之韵","author":"方一夔","text":"层层楼阁锁娇鬟，要伴朝云出远山。\n紫府神仙行世上，深宫妃媵落人间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"商妇","author":"方一夔","text":"扬子江头水几篙，匆匆思梦越波涛。\n征人无信西风起，落叶满庭虫夜号。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戍妇","author":"方一夔","text":"去岁辞家戍陇西，玉关消息渺天涯。\n深秋别恨向谁诉，挂壁空靴生网丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜读刘梦得别夔州官吏诗遂赋一绝","author":"方一夔","text":"死称柳水柳侯庙，老守扬州扬子津。\n莫计当时同党籍，一般诗句一般人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诸生多以船夫入监房","author":"方一夔","text":"水程何日到瓜州，谩说儒家冠九流。\n已与官船充水手，更从廷尉望山头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元日","author":"方一夔","text":"鬼物从来著论无，题门安用换桃符。\n呼儿记日开书读，为说濂溪太极图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春行口占","author":"方一夔","text":"杨柳青摇穷裤带，樱桃红滴守宫砂。\n春风不解留诗鬓，只解年年媚物华。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"甄夫人杨贵妃","author":"方一夔","text":"少台赐妲怜玄发，马驿诛褒死曲眉。\n自古文章多触罪，我当并按北征诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张丽华","author":"方一夔","text":"玉树歌残月上弓，谁将白刃斩春风。\n妄言若不惩高叟，断案如何服太公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寒食上冢","author":"方一夔","text":"我是卿家老寡妻，哭卿墓下草凄凄。\n纸钱乱挂浇残酒，人去黄昏鸦正啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日酒罢独坐有怀","author":"方一夔","text":"篱边初未见黄花，满眼青山故国赊。\n午醉醒来人正远，悠悠落日独思家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五绝 其一","author":"方一夔","text":"不识梅花不识诗，空将色相较铢锱。\n美人立尽黄昏月，细看枝枯叶脱时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五绝 其二","author":"方一夔","text":"一日微阳积一分，看看积得一阳成。\n夜来迸出梅花里，天地初心只是生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五绝 其三","author":"方一夔","text":"罗浮仙子月中归，三叠谁歌绝妙辞。\n便是梅花难着笔，老逋只有七分诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五绝 其四","author":"方一夔","text":"风味酸寒冰齿牙，谁知烟雨送诗家。\n删前不是无题品，未有文章说到花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五绝 其五","author":"方一夔","text":"白鹤峰头着缟衣，醉骑鹤去几时归。\n蛮诗数首传谁相，写出杭州玉雪妃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"插柳","author":"方一夔","text":"曾记来时割伏雌，相思头绪乱如丝。\n自怜春尽腰肢瘦，更向庭前插柳枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其一 莲花","author":"方一夔","text":"十里红裙间绿衣，西风吹乱碧参差。\n佳人日暮秋裳薄，怕有天霜磬折时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其二 桂花","author":"方一夔","text":"仙府分根饱月光，百车金粟撒瑶房。\n夜来东壁西风劲，三万牙签字字香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其三 旋覆花","author":"方一夔","text":"一串金铺簇碧丛，野田高下状童童。\n凭君洗我读书眼，收入公门药笼中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其四 蓼花","author":"方一夔","text":"似是根株食辣虫，知君苦梗老霜风。\n功名莫道全无意，火气腾腾浮面红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其五 蘋花","author":"方一夔","text":"风急从衡木叶飞，寒花摇曳水中低。\n褰裳不采空归去，谁识江南季女饥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其六 兰花","author":"方一夔","text":"步马西风冠切云，欲从九畹问秋芬。\n自原未死香都变，老尽山人况识君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其七 菊花","author":"方一夔","text":"篱下花逢少酒钱，何如潭上酌芳泉。\n颓龄此去凭料理，四百添书甲子年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其八 牵牛花","author":"方一夔","text":"河鼓无灵帝遣来，野篱竹屋手亲栽。\n仙姑咳唾随风去，染作琉璃八角杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其九 芙蓉花","author":"方一夔","text":"露冷霜清日已凄，淡妆素服满前溪。\n涉江一段荒凉意，弱国孤臣寒士妻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋花十咏 其十 芦花","author":"方一夔","text":"寒芦飒飒响风沙，直待秋来雁作家。\n夜擘饥翎搏未起，一汀撩乱雪飞花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄洪复翁","author":"方一夔","text":"月色横窗涌烂银，空房独卧悄无邻。\n五更记梦浑无数，半是还家半故人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"征人怨 其一","author":"方一夔","text":"辞家泊水几番秋，流浪天南海角头。\n此去千鹅三万里，凭君马上寄离愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"征人怨 其二","author":"方一夔","text":"前年赴急合梁山，一岁征行一岁还。\n待到故乡能几月，明朝又出雁门关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其一","author":"方一夔","text":"松下相逢雪雨乖，人生何必泥形骸。\n竹篱一醉休惆怅，只么神交自是佳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其二","author":"方一夔","text":"褪粉残妆对镜慵，楚踪秦迹恨匆匆。\n芳心不被春风折，谁揉香肌满籍红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其三","author":"方一夔","text":"欲洗年年堕谪心，仙人空返白云岑。\n飞花欲落频回首，老去风情尚不禁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其四","author":"方一夔","text":"寂寞幽香圣得知，醉来树下酹冰肌。\n更须呼我碧花唾，听唱新翻一剪词。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其五","author":"方一夔","text":"只在溪桥野屋边，霜饕雪虐不能干。\n可人风韵元萧散，莫道花仙骨相寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其六","author":"方一夔","text":"约束寒梅作主张，此花解事助凄凉。\n暗香月下熏诗骨，怪见吟来句句香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续梅花七绝 其七","author":"方一夔","text":"屐痕印雪不粘尘，去采南枝茧栗春。\n待得杏桃蹊树下，我家风味已生仁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"别梅二首 其一","author":"方一夔","text":"葛仙溪上一株梅，我到家时花正开。\n后夜月明风露冷，横枝休遣上窗来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]