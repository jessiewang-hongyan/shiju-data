[{"title":"塞翁吟 黄园感事","author":"赵文","text":"又海棠开后，楼上倍觉春寒。\n绿叶润，雨初乾。\n爱远树团团。\n当时剩买名花种，那信付与谁看。\n十载事，土花漫。\n但青得阑干。\n悲欢。\n思人世、真如一梦，留不住、城头日残。\n看眼底、西湖过了，又还见、赵舞燕歌，抹粉涂丹。\n凭君更酌，后日重来，直是晴难。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7970,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"瑞鹤仙 刘氏园西湖柳","author":"赵文","text":"绿杨深似雨。\n西湖上、旧日情丝恨缕。\n风流似张绪。\n羡春风依旧，年年眉妩。\n宫腰楚楚。\n倚画阑、曾斗妙舞。\n想而今似我，零落天涯，却悔相妒。\n痛绝长秋去后，杨白花飞，旧腔难谱。\n年年暗度。\n凄凉事，不堪诉。\n记菩提寺路，段家桥水，何时重到梦处。\n况柔条老去，争奈系春不住。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7971,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题石勒问道图","author":"钱选","text":"磊落为人天下奇，来参佛法始知机。\n一言能悟圆通理，却笑刘聪事事非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7972,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题宫姬戏婴图","author":"钱选","text":"殿阁森森气自清，不知人世有蓬瀛。\n日长无事宫中乐，閒与诸姬伴戏婴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7973,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题观梅图","author":"钱选","text":"不见西湖处士星，俨然风月为谁明。\n当时寂寞孤山下，两句诗成万古名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7974,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题杨妃上马图","author":"钱选","text":"唐室开元致太平，年年十月幸华清。\n当时马上多娇态，不相驱驰蜀道行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7975,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题孤山图","author":"钱选","text":"一童一鹤两相随，閒步梅边赋小诗。\n疏影暗香真绝句，至今谁复继新辞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7976,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题金碧山水卷四首 其四","author":"钱选","text":"胸中得酒出孱颜，木叶森森岁暮残。\n落墨不随岚气暝，几重山色几重澜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7977,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题金碧山水卷四首 其三","author":"钱选","text":"烟云出没有无间，半在空虚半在山。\n我亦閒中消日月，幽林深处听潺湲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7978,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题金碧山水卷四首 其一","author":"钱选","text":"目穷千里笔不到，自是馀生坐太凡。\n一日兴来何可遏，开窗写出碧嵓嵓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7979,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题复州裂本兰亭","author":"钱选","text":"鼠须注砚写流觞，一入书林久复藏。\n二十八行经进字，回头不比在尘梁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7980,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题秋江待渡图","author":"钱选","text":"山色空濛翠欲流，长江清澈一天秋。\n茅茨落日寒烟外，久立行人待渡舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7981,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题秋茄图","author":"钱选","text":"忆昔毗山爱写生，瓜茄任我笔纵横。\n自怜老去翻成拙，学圃今犹学不成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7982,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题唐三学士图","author":"钱选","text":"唐三学士粲三英，挺挺人才艺术精。\n无事围棋春昼永，至今画笔尚传名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7983,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题桃源图","author":"钱选","text":"始信桃源隔几秦，后来无复问津人。\n武陵不是花开晚，流到人间却暮春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7984,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七言绝句三首 其三","author":"钱选","text":"眼前触物动成冰，冻笔频枯字不成。\n独坐火炉煨酒吃，细听扑簌打窗声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7985,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七言绝句三首 其一","author":"钱选","text":"子猷安道何为者，自是相忘意最真。\n千载寥寥风雪夜，始知乘兴更无人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7986,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋月","author":"钱选","text":"皎皎无边白玉盘，年年此夕带愁看。\n松枝积翠欺人老，桂影浮香入鬓寒。\n常记醉来多谬误，又逢秋至辄悲酸。\n疏桐清露中庭下，泪洒西风为一弹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7987,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂诗 其一","author":"钱选","text":"地僻秋深戎马閒，一尊随处且开颜。\n谁思铜雀埋黄土，但忆金人出汉关。\n六合茫茫天共远，五湖杳杳雁飞还。\n中年陶写无丝竹，王谢风流莫强攀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7988,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂诗 其二","author":"钱选","text":"青春跃马两山间，溪柳岩花动客颜。\n日落孤城金铎振，草深荒冢石人閒。\n庾郎赋就元无味，阮籍途穷且未还。\n江左风流半摧谢，白头犹自绕乡关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7989,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜宿南山僧寺","author":"钱选","text":"高楼一日赏新晴，白羽停挥倚绣楹。\n尘世可怜人易老，海门还见月长生。\n蓬瀛缥缈南山小，殿阁森罗北斗横。\n今古登临尽如此，不须游子独含情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7990,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日即事","author":"钱选","text":"十日春风暄且妍，溪头花柳竞相鲜。\n美人遥隔山川外，社雨忽来尊俎前。\n白发青春犹故我，夕阳幽草自新阡。\n五陵公子莫相笑，曾散黄金乐少年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7991,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山居图卷","author":"钱选","text":"山居惟爱静，白日掩柴门。\n寡合人多忌，无求道自尊。\n鴳鹏俱有意，兰艾不同根。\n安得蒙庄叟，相逢与细论。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7992,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题友人判太平归来诗卷","author":"钱选","text":"宫锦翩翩五色麟，如君端合侍枫宸。\n山中老去陶弘景，湖曲归来贺季真。\n上界神仙足官府，此身城郭旧人民。\n还乡我结同盟社，只看桃花莫问春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7993,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"水仙花图","author":"钱选","text":"帝子不沉湘，亭亭绝世妆。\n晓烟横薄袂，秋濑韵明珰。\n洛浦应求友，姚家合让王。\n殷勤归水部，雅意在分香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7994,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪晴知宫周济川和余杯字韵诗作此奉酬","author":"钱选","text":"乱山积雪郁崔嵬，对景惭无倡和才。\n晴日旧曾梅下饮，好怀今为竹林开。\n仙人千劫能居此，俗客三生始一来。\n未许扁舟落我手，明朝相约共传杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7995,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七言律诗一首","author":"钱选","text":"倚天苍弁独崔嵬，仙阙遨游愧不才。\n揽镜频嗟双鬓改，推窗三见六花开。\n山中酒户冲寒去，城里行人蹋雪来。\n安得时晴风日好，竹林深处且衔杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7996,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"连雪可畏再赋律诗一首","author":"钱选","text":"阶檐积雪动经旬，犹自霏霏夜向晨。\n四望莫分天地色，一时遮尽海山尘。\n舞风不住缘何事，见日还销亦快人。\n独欠故交来叩户，洛中高卧是前身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7997,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"韩左军马图卷","author":"钱选","text":"韩公胸次有神奇，写得天闲八尺驹。\n曾为岐王天上赐，不随都护雪中驱。\n霜蹄奋迅追飞电，凤首昂藏似渴乌。\n春草青青华山曲，三边今日已无虞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7998,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五君咏 刘伶","author":"钱选","text":"刘公善闭关，怀情灭闻见。\n鼓钟不足欢，容色岂能眩。\n韬精日沉饮，谁知非荒宴。\n颂酒虽短章，深衷自此见。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":7999,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五君咏 阮咸","author":"钱选","text":"仲容青云器，实禀生民秀。\n达音何用深，识微在金奏。\n郭奕巳心醉，山公非虚觏。\n屡荐不入官，一麾乃出守。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8000,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天台杂书","author":"钱选","text":"灵境无人桃自花，东风吹散赤城霞。\n山容对我横天末，柳色将春到水涯。\n王粲忆秦空有恨，杜陵入蜀更无家。\n干戈满眼何年定，回雁悠悠白日斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8001,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春暮","author":"钱选","text":"晴日溪光动草堂，两峰浮翠瞰沧浪。\n独挥羽扇成何事，更叹芒鞋为底忙。\n一水澄清鱼避影，万红狼藉蝶分香。\n东风自是无情物，白日杨花莫漫狂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8002,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"仇书图","author":"钱选","text":"两两挟策游康衢，聚戏不异同队鱼。\n忽然儿态起争竞，捐弃箧笥仇诗书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8003,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"归去来图","author":"钱选","text":"衡门植五柳，东篱采丛菊。\n长啸有馀清，无奈酒不足。\n当世宜沉酣，作色召侮辱。\n乘兴赋归欤，千载一辞独。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8004,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题竹林七贤图","author":"钱选","text":"昔人好沉酣，人事不复理。\n但进杯中物，应世聊尔尔。\n悠悠天地间，媮乐本无愧。\n诸贤各有心，流俗毋轻议。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8005,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题金碧山水卷四首 其二","author":"钱选","text":"江南北苑出奇才，千里溪山笔底回。\n不管六朝兴废事，一樽且向画图开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8006,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题洪厓先生像卷","author":"钱选","text":"神驾驭景飙，太虚时总辔。\n玄道不可分，直悟天人际。\n群从皆成仙，玩世不计年。\n何当事神游，许我笑拍肩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8007,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题浮玉山居图","author":"钱选","text":"瞻彼南山岑，白云何翩翩。\n下有幽栖人，啸歌乐徂年。\n丛石映清泚，嘉木澹芳妍。\n日月无终极，陵谷从变迁。\n神襟轶寥廓，兴寄挥五弦。\n尘彯一以绝，招隐奚足言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8008,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"霅溪翁雪霁望弁山图","author":"钱选","text":"弁山之阳冠吴兴，峮嶙巀?望不平。\n焕然仙宫隐其下，众山所仰青复青。\n雪花夜积山如换，乘兴行舟须放缓。\n平生不识五老峰，且写吾乡一奇观。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8009,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七言绝句三首 其二","author":"钱选","text":"一冬飞雪又将春，能报年丰不救贫。\n我亦曾闻散花手，不知天女意何勤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8010,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五言古体一首","author":"钱选","text":"城市我所居，遥看弁山雄。\n积雪最先见，皓彩照诸峰。\n我今远城市，薄游留此中。\n忽焉岁云暮，更觉尊屡空。\n开门未然烛，飞花舞回风。\n万木同一缟，四野变其容。\n恨无登山屐，幽讨何由穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8011,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潇湘神 端午竞渡棹歌十首 其十","author":"黄公绍","text":"月明中，月明中，满湖春水望难穷。\n欲学楚歌歌不得，一场离恨两眉峰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8012,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"汉宫春 郡圃赏白莲","author":"黄公绍","text":"身到瑶池。\n正□永芙蓉，跕素鸾飞。\n绿云淡笼波面，鸳影差差。\n青冥世界，向龙宫、涌出江妃。\n凝望久，夜凉如水，人间惆怅芳时。\n池上方壶仙伯，是珊珊月佩，绰绰冰肌。\n重来碧环胜处，笑引琼卮。\n谁歌白雪，坐中客、赛过玄晖。\n醉归也，玉绳低转，晓风轻拂荷衣。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8013,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"花犯 木芙蓉","author":"黄公绍","text":"翠奁空、红鸾蘸影，嫣然弄妆晚。\n雾鬟低颤。\n飞嫩藕仙裳，清思无限。\n象床试锦新翻样，金屏连绣展。\n最好似、阿环娇困，云酣春帐暖。\n寻思水边赋娟娟，新霜□旧约，西风庭院。\n肠断处，秋江上、彩云轻散。\n凭谁向、一筝过雁。\n细说与、眉心杨柳怨。\n且趁此、菊花天气，年年寻醉伴。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8014,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇 月","author":"黄公绍","text":"山围宽碧，月十分圆满，十分春暮。\n匹似涌金门外看，添得绿阴佳树。\n野阔星垂，天高云敛，不受红尘污。\n徘徊水影，闲中自有佳处。\n乘兴著我扁舟，山阴夜色，渺渺流光溯。\n望美人兮天一角，我欲凌风飞去。\n世事浮沈，人生圆缺，得似烟波趣。\n兴怀赤壁，大江千古东注。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8015,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"明月棹孤舟/夜行船 木樨","author":"黄公绍","text":"雁带愁来寒事早。\n西风把鬓华吹老。\n猛省中秋，都来几日，先自木樨开了。\n淰淰轻阴天弄晓。\n平白地、被花相恼。\n一枕云闲，半窗秋晓，时有阵香吹到。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8016,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"青玉案","author":"黄公绍","text":"年年社日停针线。\n怎忍见、双飞燕。\n今日江城春已半。\n一身犹在，乱山深处，寂寞溪桥畔。\n春衫著破谁针线。\n点点行行泪痕满。\n落日解鞍芳草岸。\n花无人戴，酒无人劝，醉也无人管。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8017,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"洞仙歌 刘守之任","author":"黄公绍","text":"银菟分竹，是君王亲付。\n州在扶舆最清处。\n紫云楼、记取天语丁宁，襦绔手，好好为吾摩拊。\n望公如望月，见说郴江，父老多时问来暮。\n旌旆试初凉，紫马西来，青丝络、秋风满路。\n早橘井丹成入仙班，有乔木前芳，事须公做。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8018,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"莺啼序 吴江长桥","author":"黄公绍","text":"银云卷晴缥缈，卧长龙一带。\n柳丝蘸、几簇柔烟，两市帘栋如画。\n芳草岸、弯环半玉，鳞鳞曲港双流会。\n看碧天连水，翻成箭样风快。\n白露横江，一苇万顷，问灵槎何在。\n空翠湿衣不胜寒，日华金掌沆瀣。\n甃花平、绿文衬步，琼田涌出神仙界。\n黛眉修，依约雾鬟，在秋波外。\n阁嘘青蜃，楼啄彩虹，飞盖蹴鳌背。\n灯火暮，相轮倒影，偷睇别浦，片片归帆，远自天际。\n舞蛟幽壑，栖鸦古木，有人剪取松江水，忆细鳞巨口鱼堪鲙。\n波涵笠泽，时见静影浮光，霏阴万貌千态。\n蒹葭深处，应有闲鸥，寄语休见怪。\n倩洗却、香红尘面，买个扁舟，身世飘萍，名利微芥。\n阑干拍遍，除东曹掾，与天随子是我辈，尽胸中、著得乾坤大。\n亭前无限惊涛，总把遥吟，月明满载。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8019,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南/忆江南 其一 雨","author":"黄公绍","text":"思晴好，去上竹山窠。\n自古常言光霁好，如今却恨雨声多。\n奈此坐愁何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8020,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜迁莺 荼","author":"黄公绍","text":"乱红飞雨。\n怅春心一似，腾腾闷暑。\n密绾柔情，暗传芳意，人在垂杨深宇。\n晓雪一帘幽梦，半点檀心知否。\n春不管，想粉香凝泪，翠颦含趣。\n谁念芳径小，新绿笺笺，问讯今何许。\n玉冷钗头，罗宽带眼，缥缈青鸾难遇。\n望断碧云深处，倚遍画阑将暮。\n空惆怅，更江头桃叶，溜横波渡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8021,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜迁莺 和老人咏梅","author":"黄公绍","text":"世情冰尽。\n算耐久祗是，陇头芳信。\n惆怅人间，几千年□，留得陆郎馀韵。\n朔云解识花意，遮断疏狂蝶粉。\n岁寒了，狂风传香远，月移影近。\n清润。\n无点涴，不曰坚乎，如玉真难尽。\n除宋广平，与林和靖，肉眼有谁能认。\n仙丰道骨如许，相对霜髯雪鬓。\n长健也，好年年管领，春光随分。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8022,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满江红 花朝雨作","author":"黄公绍","text":"客子光阴，又还是、杏花阡陌。\n敧枕听、一窗夜雨，怎生禁得。\n银蜡痕消珠凤小，翠衾香冷文鸳拆。\n叹人生、时序百年心，萍踪迹。\n声不断，楼头滴。\n行不住，街头屐。\n倩新来双燕，探晴消息。\n可煞东君多著意，柳丝染出西湖色。\n待牡丹、开处十分春，催寒食。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8023,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其四","author":"黄公绍","text":"驾灵鼍，驾灵鼍，几年翠舞与珠歌。\n看到日斜犹未足，涌金门外涌金波。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8024,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其九","author":"黄公绍","text":"踏青青，踏青青，西泠桥畔草连汀。\n扑得龙船儿一对，画阑倚遍看游人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8025,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其八","author":"黄公绍","text":"建云斿，建云斿，土风到处总相犹。\n朝了霍山朝岳帝，十分打扮是杭州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8026,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其二","author":"黄公绍","text":"斗轻桡，斗轻桡，雪中花捲棹声摇。\n天与玻璃三万顷，尽教看得几吴舠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8027,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其三","author":"黄公绍","text":"看龙舟，看龙舟，两堤未斗水悠悠。\n一片笙歌催闹晚，忽然鼓棹起中流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8028,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其一","author":"黄公绍","text":"望天湖，望天湖，绿杨深处鼓??。\n好是年年三二月，湖边日日看划船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8029,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其六","author":"黄公绍","text":"绣周张，绣周张，楼台帘幕絮高扬。\n谁赋珠宫并内阙，怀王去后去沉湘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8030,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竞渡棹歌 其五","author":"黄公绍","text":"马如龙，马如龙，飞过苏堤健斗风。\n枊下系船青作缆，湖边荐酒碧为筒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8031,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]