[{"title":"梦江南","author":"仇远","text":"花雾湿，黯黯覆庭芜。\n十二阑干空见月，谁教凉影伴人孤。\n素被带香铺。\n情荏苒，金屋又笙竽。\n天际有云难载鹤，墙东无树可啼乌。\n春梦绕西湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"长相思","author":"汪元量","text":"阿哥儿。\n阿姑儿。\n两个天生一对儿。\n偷吹玉琯儿。\n笑些儿。\n话些儿。\n罗带同心双绾儿。\n团团似月儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丁无悔","author":"汪元量","text":"待考。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠制笔生许文瑶","author":"刘辰翁","text":"许生精艺谁可及，材用刚柔以制笔。\n水盆洗出紫兔毫，便觉文章生羽翼。\n蒙恬将军为动色，为是秦王旧时物。\n丞相斯曾从驾行，载此篆书封禅碣。\n从秦至今几千载，兔尚存皮竹可采。\n利济天下功不有，入手千人万人爱。\n我昔为郎居粉署，用笔唯于许生取。\n轻衫日对紫薇花，写遍江淹梦中句。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读杜拾遗百忧集行有感","author":"刘辰翁","text":"余生行年将六十，不知何者为忧戚。\n富贵不骄贫贱安，以此存心度朝夕。\n往年承乏佐中书，大官羊膳供堂食。\n只今赐老作编氓，衣食信天无固必。\n陋巷箪瓢如素居，不管茅茨春雨湿。\n门前载酒求赋诗，锦轴牙签日堆积。\n在官不置负郭田，既老翻得稽古力。\n毁誉都忘月旦评，姓名不上春秋笔。\n朝米不烦邻僧送，暮米不烦太仓籴。\n我亦一饭不忘君，文人相轻所不及。\n伤哉白首杜拾遗，入蜀还秦劳辙迹。\n文章盖世亦何为，妻子相看百忧集。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏岳王孙县尉复栖霞坟田","author":"龚璛","text":"岳鄂诸孙复墓田，清明寒食起新烟。\n道傍为我除苍桧，山下如今哭杜鹃。\n高庙神灵应悔此，中原父老尚悽然。\n西湖靡靡行人去，却望栖霞转可怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"盛庶斋先生初见于维扬程雪楼学士坐中再见练溪学官诗见遗次韵","author":"龚璛","text":"尘世重逢惊鬓须，世人不满笑谈馀。\n从渠胃脯亦连骑，顾我纬萧宁锻珠。\n白雪共闻楼上曲，青藜谁照阁中书。\n淮南桂树相携隐，千首新诗酒百壶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"嘉定州道中寄庶斋","author":"龚璛","text":"客梦孤云散，渔翁一帆投。\n人行江路晚，花绕槿篱秋。\n有酒谁同醉，还家此暂留。\n中年发尽白，岂必为离忧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为白香岩州判赋茅亭","author":"龚璛","text":"手结茅亭隐涧阿，香岩行住得婆娑。\n乾坤鳌足立四极，风雨渔翁安一蓑。\n旧与幽人同此屋，秋来杜老为谁歌。\n宦途想忆衡门事，可奈晴檐曝背何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送钱仲昭任永春簿","author":"龚璛","text":"紫帽云横天宇高，掀髯为我拂征袍。\n瘴乡处处槟榔唾，番市年年翡翠毛。\n王化本随沧海阔，县官常念远民劳。\n极知簿领非能事，试看廉台旧掾曹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"记梦二首 其一","author":"龚璛","text":"渺渺东西南北路，扁舟重载老侵寻。\n夜凉破梦秋虫语，一笑平生万里心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"记梦二首 其二","author":"龚璛","text":"睡时作梦觉时醒，更欲哦诗恼性灵。\n缓步行来良久坐，秋槐花落露初零。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"姑苏驿","author":"龚璛","text":"閒官此地有逢迎，且向姑苏台上行。\n更与黄花期九日，能消几屐了平生。\n秋田垂老岁功急，野树著寒烟景横。\n我忆吴都旧时赋，栖乌渺渺堕江城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孟潜心先生挽诗","author":"龚璛","text":"昂昂鹤骨老深衣，耆旧年来积渐稀。\n京室先传太任德，海滨今见伯夷归。\n士林长望风尘表，心易独潜天地机。\n家世源流不胜远，锡山新垄照秋晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送漕府王子方经历","author":"龚璛","text":"燕北吴南一万艘，顺风天外翼鸿毛。\n碧涛渺渺云帆稳，红腐陈陈廪粟高。\n此日朝廷多妙选，何人幕府最贤劳。\n共知饷馈须刘晏，且为明时坐省曹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次贡仲坚教授污湾行","author":"龚璛","text":"沧海蜃化楼台生，琐碎一一不可名。\n夜如何其夜六更，是中精异方冥行，忽然钟鼓声轰铿。\n我恰混沌死来觉，浊恶泥沙埋龌龊。\n珠玑金碧视性命，黩货聊堪付官榷。\n洞房蛛网镂象床，重门藓铺撼仓琅，魂兮归来知在亡。\n纵令僵立倚桥柱，忍见逝者相为忙。\n百尔君子须远猷，公私漫藏多后忧。\n官库诃护竟失守，岂以尤物无庸留。\n传闻顷刻飞烟尘，天夺鬼偷希世珍。\n重云宝构亦变灭，况复区区迷幻身，积苏累块惊盲人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送石仁卿南康知事","author":"龚璛","text":"嗟我与君相会少，半生识面不知心。\n如今握手俱头白，避暑携书共竹阴。\n长为人材论弃置，肯从幕府坐侵寻。\n重闻台省须佳士，且寄匡山大雅音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为胡则大赋飞鸿轩","author":"龚璛","text":"飞鸿踏雪本忘机，一举冥冥何处飞。\n随地能无矰缴在，此身肯逐稻粱肥。\n士生独立万物表，尘世相看千古希。\n为谢心期嵇叔夜，雅琴随手不妨挥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"姚筠庵之越教题云山图送之","author":"龚璛","text":"春烟春雨染溪云，此意正堪持赠君。\n异日筠庵有相忆，千岩秀色却平分。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次筠庵题花光梅南卷","author":"龚璛","text":"岁晚可怜冰雪姿，风流隐约未开枝。\n此花南畔幽人住，每记阳春初到时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次邓善之修撰","author":"龚璛","text":"一室贫逾陋，南州暑正烦。\n故人相会处，幽草自生萱。\n别梦江湖在，浮云车马奔。\n寥寥扬子宅，玄白定忘言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"菖蒲石","author":"龚璛","text":"梦随凉月过清都，绿发仙人白玉壶。\n尘世何知用无用，石田如掌种菖蒲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送方韶卿先生","author":"龚璛","text":"处士白云源，槃歌矢弗谖。\n韶成犹及见，雅废更能存。\n偶渡秦淮月，相逢吴市门。\n山川又秋晓，此意欲谁论。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题石民瞻兰石邓觉非画兰","author":"龚璛","text":"石子画石，积墨如山。\n化为邓林，兰生竹间。\n我怀古人，见此粲者。\n草木臭味，日月潇洒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次张菊存送陈无逸澧阳教","author":"龚璛","text":"浮云日东征，大江泻秋晴。\n一仕四千里，公无离别情。\n如何我辈人，后此百年生。\n茫茫古人饥，种葵不盈烹。\n校官非要务，顾足烦经营。\n聊为三径资，殆误举烛明。\n欣然便成往，分甘为穷并。\n腹书不及口，久矣君不惊。\n儒生坐常格，夫岂争功名。\n亦有下禄隐，何妨卿自卿。\n台阁习汉事，谁当慕黄琼。\n今日南士望，我方观顾荣。\n相与任时运，终期白鸥盟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送盛庶斋任衢教","author":"龚璛","text":"淮南木叶纷然堕，大江君挟清秋过。\n远游意气今其始，万折浙江须一苇。\n钱唐看尽生色图，乱山勿辨越与吴。\n老子西湖诗未了，钓台烟雨是前途。\n雨馀悬瀑玉练飞，杂花隐树芳菲菲。\n经行我忆好晴景，碧波漾人青嶂围。\n地皇滩底骇浪翻，篙师歘急争木猿。\n水亭门外君系缆，此地可著殷渊源。\n石格仙家对谁弈，木奴迎霜斗如实。\n携二三子挥墨汁，书来扬州千里难。\n乡之贤侯主衣冠，日传西安安问安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郑子实所藏燕穆之龙图山水及牛戬雁图 其一","author":"龚璛","text":"八月望夜题此画，莲花漏冷秋沈沈。\n仁人义士不可见，万叠好山千古心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郑子实所藏燕穆之龙图山水及牛戬雁图 其二","author":"龚璛","text":"飞来两雁不成字，偶得一滩相并眠。\n南国江天秋欲雨，西风木叶夜如年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偕林彦达天平即事","author":"龚璛","text":"篮舆过西郊，故指长松树。\n幽寻得清深，古藤蛟蛇聚。\n聊为取径来，复作循涧去。\n峨峨天门山，僧坊掩其处。\n稽首忠烈祠，兹游有神助。\n违世常独行，会心即同趣。\n手?白云泉，一洗儒者腐。\n跻攀龙门上，沧海欲竟渡。\n狂啸风雨飞，血肉那可住。\n俯观大千界，莽苍尽回互。\n病夫杖藜还，数息安窘步。\n之子凌绝顶，相失不相遇。\n脩廊把臂笑，物色方受句。\n跏趺赞公房，茶瓯要深注。\n蹇余每多艰，沮洳沾两屦。\n肩仆亦已痡，重负宁少恕。\n前途更回首，空翠洒岚雾。\n持此将安归，济胜自非具。\n知津问长沮，无泪洒羊祜。\n平生樽酒期，中秋月当户。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晚对桂花开","author":"龚璛","text":"閒与碧云暮，恍然金粟堆。\n风香不自食，月影为谁来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"史监兰谷图郑氏画","author":"龚璛","text":"晼晚幽人佩，江南水石间。\n红尘没马耳，此意政相关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9128,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为陶吉甫赋心山","author":"龚璛","text":"世事关心心在山，爱山终欲共高閒。\n三茅岭上白云晚，五柳篱边飞鸟还。\n与物生来无住着，何时到处便跻攀。\n幽人雅处吾能识，隐几原非似石顽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9129,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送汪鹤舟之华亭","author":"龚璛","text":"仙人之远游，跨鹤以为舟。\n闲与白云侣，俯观沧海流。\n翩然万里小，大抵此生浮。\n后夜华亭唳，寥寥天九秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9130,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题林彦达临老米云山","author":"龚璛","text":"海岳山前路不分，无穷天地几氤氲。\n形形色色今犹古，长待幽人卧白云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9131,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题陆氏晓嶂图","author":"龚璛","text":"平生王马曹，爽气在今朝。\n未了山林事，人之意也消。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9132,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋宋文璧伯牙禅","author":"龚璛","text":"亹亹高山调，灵灵桥木禅。\n何人以气听，此事岂心传。\n悟入终于寂，声闻各自圆。\n昭文元不鼓，陶令久无弦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9133,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次周方溪韵","author":"龚璛","text":"谢老外诸孙，因君观九原。\n犹疑古人在，转使薄夫敦。\n臭味偶萍聚，风流如玉温。\n江东二三策，此道久忘言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9134,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送周山□趣瑞安州同知","author":"龚璛","text":"江头雨意湿宾鸿，千里东瓯浙最东。\n碧树渔矶山水窟，朱衣象笏簿书丛。\n吾民又遇时更化，此地今闻岁屡丰。\n若得曾游谢灵运，官闲诗好和清风。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9135,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题邓觉非云山图","author":"龚璛","text":"云欲行兮时止，山将闇兮日章。\n渺太虚而观化，载神气以无方。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9136,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王君章山水","author":"龚璛","text":"山中古寺秋阴，有客携筇独寻。\n归来自可一榻，江南落尽枫林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9137,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题刘文伟府判收藏山庄夜归图","author":"龚璛","text":"盘桓长松树，莽苍归薄暮。\n惟应门外山，见我蹇驴去。\n泠泠野水声，候子庄山路。\n亦有东邻僧，分卧清寒处。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9138,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题春江别意图","author":"龚璛","text":"春生南浦上，自子棹歌声。\n今古邮亭恨，一卮君有行。\n相望日以远，山色写离情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9139,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游桃花坞次郭祥卿陆友元二首 其一","author":"龚璛","text":"三月西城多少花，暖风吹雨过晴霞。\n海棠昨日开时路，山鸟清阴到处家。\n长袖挽春携手去，小舆舁醉一肩斜。\n闲人好在江湖酒，只办年年赏物华。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9140,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游桃花坞次郭祥卿陆友元二首 其二","author":"龚璛","text":"野水自行路，松风谁掩关。\n仙家忘日永，老圃得春悭。\n梦已投林下，生当出世间。\n玄同二三友，大智本閒閒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9141,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日寄怀书台","author":"龚璛","text":"阊门柳如带，中有别离在。\n当时官河船，飘摇忍相待。\n二月东风吹暮寒，追送百里问河干。\n破屋残灯人去住，欲语不语千万端。\n竹鸡钩辀啼梦阑，九江道中雨漫漫。\n已恨金华六年别，当时再鼓荆江楫，七年又恨潇湘阔。\n人生贫窭北门忧，我一思之生白发。\n白发生，何足惊，志士潦倒俱无成。\n酒浇磊块浇不平，况复不饮难为情。\n长歌短歌无新声，念我独兮在吴城。\n今年石湖好清明，数树梨花香雪晴，夫君不来湖上亭。\n昨朝见家信，纸尾烦相问。\n是亲不可疏，既远不可近。\n此身江海事多违，往往旧交零落尽。\n我亦徘徊看舞讴，谁家欢宴及春游。\n越王郊台踏芳草，危弦二七弹箜篌。\n箜篌嘈杂儿女语，绣柱朱弦生眼雾。\n感物逢时重怀古，悠悠我行处，总是衰迟路。\n待君归来问君故，各天一涯水东注。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9142,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨中简韩竹閒二首 其一","author":"龚璛","text":"拥被寒逾峭，雨声遥夜来。\n蛙鸣东阶下，柴门犹未开。\n寂寞秋在念，芳菲发先衰。\n昔我二三友，晤语初阳台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9143,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨中简韩竹閒二首 其二","author":"龚璛","text":"采采一寸芹，靡靡不食饱。\n王孙从何来，芳年亦同老。\n徒忧侵病颜，积霭迷远抱。\n犹能尊酒期，共语山中好。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9144,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"拟游仙诗","author":"龚璛","text":"清风振南海，桂树山之幽。\n仙人立于独，浩浩逍遥游。\n长袖拂尘几，下视万蚁丘。\n此道真富贵，高情谢公侯。\n广居在何许，浩气标琼楼。\n隐映云母屏，错落珊瑚钩。\n煖笙双紫鸾，飞车驷苍虬。\n朝余鉴灵渊，夕余撷芳洲。\n执手木羽御，世我相为浮。\n醉翻九霞觞，一笑三千秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9145,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次张菊存韵送翁舜咨归金陵","author":"龚璛","text":"知音我亦恨钟期，闻士谁曾得赵咨。\n北海疑乾荐祢墨，东都不采适吴诗。\n三秋菊酒同行乐，一路家山各坐驰。\n江国相逢送萧瑟，病身无赖倚筇枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9146,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈高显卿参政二首 其一","author":"龚璛","text":"人材并用几相投，法度难持每独忧。\n众味调和羹一鼎，此身屹立柱中流。\n时贤幸际升平福，世事深烦久远谋。\n满眼江湖又丰岁，汉廷行拜富民侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9147,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈高显卿参政二首 其二","author":"龚璛","text":"支离无状获升堂，旧事惊嗟重永伤。\n葛帔令人愧刘峻，鸡群往日见嵇康。\n车书混一谁东道，风树凄迷此异方。\n文献北来今咫尺，敢从公衮借馀光。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9148,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题简蕙画","author":"龚璛","text":"满堂美人芳菲菲，如此食墨何能肥。\n古今兰蕙不一种，兄弟夷齐无二薇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9149,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虞韶卿以谢叠山请谥立祠北上","author":"龚璛","text":"万叠山中足旧闻，只今谁使意勤勤。\n周人颇义伯夷事，晋代行收诸葛文。\n九死本无荣谥愿，一香终为老师焚。\n黄金台上逢知己，袖有江东日暮云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9150,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"方子玄为钱德钧作水村图","author":"龚璛","text":"太湖三万六千顷，分得一村如断槎。\n独立苍茫子玄子，故将秋色画诗家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9151,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送史德甫任昆山教","author":"龚璛","text":"世家馀漫仕，名籍几经年。\n之反马独后，祖生鞭已先。\n提携离选海，晼晚熟书田。\n此地分迎送，玉峰秋朗然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9152,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和王录事次卢疏斋送饶教诗","author":"龚璛","text":"白发冷官来学校，江上秋蘋催雨棹。\n居然閒寂竟何为，升木之猱那复教。\n官长毋庸责功效，大府参军同好乐。\n我尝技痒得渠搔，醉眼却将高下较。\n贫无才能食家稍，寤寐九关多虎豹。\n天寒钟鼓不分明，剥啄送诗惊睡觉。\n传闻汉诏重儒流，雅欲文章存大较。\n分付王维孟浩然，明主时呼玉堂儤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9153,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题陆梅南雪滩图","author":"龚璛","text":"岁晚空江一滩雪，伊人何处渺蒹葭。\n扁舟乘兴不可极，见说南泾梅渐花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9154,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题邓觉非观兰图二首 其一","author":"龚璛","text":"小桥流水曲阑西，悄悄寒鸦意欲迷。\n九畹滋兰香一国，茶烟禅榻是幽栖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9155,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题邓觉非观兰图二首 其二","author":"龚璛","text":"玉渊桥下别君处，明月海边生乱云。\n独自归来坐无寐，长空云尽月如君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9156,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]