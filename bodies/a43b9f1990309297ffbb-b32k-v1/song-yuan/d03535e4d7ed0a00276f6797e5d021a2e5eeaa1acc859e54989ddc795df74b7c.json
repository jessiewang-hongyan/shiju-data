[{"title":"秋思七言八首 其一","author":"方回","text":"久不作诗诗律废，时须饮酒酒皆悭。\n翠微云外宣平宅，一棹归欤隐此山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1454,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"荠菜花","author":"方回","text":"斗草吴王眩越娃，终然输与老陶家。\n雪挑霜煮春无尽，不似吾园荠菜花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1455,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虽然吟五首 其五","author":"方回","text":"屋上炊烟屋下灯，客来汲井具瓶绳。\n虽然此是寻常物，不是承平见不能。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1456,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虽然吟五首 其四","author":"方回","text":"大妇银钗小绿裙，采茶洗菜踏溪云。\n虽然此是寻常物，一旦无踪为过军。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1457,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虽然吟五首 其三","author":"方回","text":"桑柘阴阴间苧麻，店前下马便斟茶。\n虽然此是寻常物，乱后空村没一家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1458,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虽然吟五首 其二","author":"方回","text":"沽酒人家短竹篱，门前三两牧牛儿。\n虽然此是寻常物，军马才过不见之。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1459,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虽然吟五首 其一","author":"方回","text":"林下机声复碓声，时时犬吠又鸡鸣。\n虽然此是寻常物，村落闻之即太平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1460,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送方岩夫四首 其四","author":"方回","text":"紫阳山下一灯寒，曾守桐庐七里滩。\n空手去官□一物，诗名聊得继方干。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1461,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送方岩夫四首 其三","author":"方回","text":"巨山蒙仲昔同官，对峙诗家两将坛。\n昭武即今闻有子，文星高照七闽寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1462,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送方岩夫四首 其二","author":"方回","text":"同姓同年绾左符，岭南万里送孀孤。\n先君遗墨今犹在，为问封州有后无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1463,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送方岩夫四首 其一","author":"方回","text":"河南徙歙徙浮光，逮徙莆田派愈长。\n六出长官刺史百，端平最数铁庵方。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1464,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送李震鹤田侄就题其诗集","author":"方回","text":"驷马未多疏受去，竹林且拟阮咸游。\n想见天风鹤鸣和，月临蕙帐夜山秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1465,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送汪庭芝高士如严州 其二","author":"方回","text":"书符咒水空多事，辟谷熬铅苦用心。\n閒读异书痛饮酒，佳时亦复一弹琴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1466,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送汪庭芝高士如严州 其三","author":"方回","text":"我致仕年死期近，汝出家时生理难。\n沧海桑田何可料，一杯别酒莫留残。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1467,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送汪庭芝高士如严州 其一","author":"方回","text":"四海无家只一身，桐江西上访仙真。\n七年太守吾聊尔，况汝穷山管道人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1468,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送徐似之归新城","author":"方回","text":"趁潮小缓转船头，不枉湖山十日留。\n喜得阎徐二学士，为传佳句过中州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1469,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送黟县学官江归上饶石湖精舍","author":"方回","text":"小桃源住饭不足，夜鹤传声趣驾还。\n细嚼紫阳山色饱，馋涎犹睨应天山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1470,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳后绝句五首 其五","author":"方回","text":"九月重阳菊未开，十月小春梅又来。\n赏过日长添一线，一瓶菊伴一瓶梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1471,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳后绝句五首 其四","author":"方回","text":"难开笑口忆小杜，今岁江湖雁未飞。\n政使菊花无可□，□当烂醉更忘归。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1472,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳后绝句五首 其三","author":"方回","text":"九日若无诗与酒，人生如此定凡人。\n我师子美牧之者，郪县齐山句尚新。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1473,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳后绝句五首 其二","author":"方回","text":"昨朝卯酒醉至酉，不记满斟凡几巡。\n莫问担头青蕊菊，且迎座上白衣人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1474,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳后绝句五首 其一","author":"方回","text":"梧桐疏叶间微黄，年例江南未肯凉。\n菊自此花三两月，樽前日日是重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1475,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳吟五首 其五","author":"方回","text":"战尘漠漠草荒荒，兵过村空菊自黄。\n死尽亲知身偶在，干戈丛里见重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1476,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳吟五首 其四","author":"方回","text":"衣冠南渡紫微郎，流落天涯事可伤。\n不是诗人终不会，乱山深处过重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1477,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳吟五首 其三","author":"方回","text":"此身生死国兴亡，摇落年年本是常。\n无奈潘郎解悽怨，满城风雨近重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1478,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳吟五首 其二","author":"方回","text":"心炎何处不南荒，瘴海烟深有玉堂。\n随地著身无得丧，菊花开日即重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1479,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳吟五首 其一","author":"方回","text":"射蛇戏马老刘郎，不为乾坤减战场。\n三径寒华空怅望，閒居无酒对重阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1480,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重赠王相士","author":"方回","text":"是人家有些儿屋，何处山无这个云。\n浪走江湖□□□，□边云肯强随君。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1481,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻谤","author":"方回","text":"脩身可用要人知，暗室孤灯敢自欺。\n赤口烧城市有虎，熨平寸地听群儿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1482,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"倚楼二首 其二","author":"方回","text":"楼头独立到昏鸦，尽日丝空小雨斜。\n何补乾坤浪生死，青青无数瓦松花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1483,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"倚楼二首 其一","author":"方回","text":"西风迎面晚凉新，略展青铜正幅巾。\n独倚阑干偶无事，閒看楼下奕棋人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1484,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐侯举摹刊诗卷牟献之文赵子昂字","author":"方回","text":"金马文章坡颍氏，玉堂字画献羲之。\n得兼裒施枣此刻，价倍湖州校正诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1485,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓发富阳县","author":"方回","text":"长山砻石片帆斜，小雨初晴日眩沙。\n回首遥看富阳县，青烟低罩一丛花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1486,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桐花","author":"方回","text":"怅惜年光怨子规，王孙见事一何迟。\n等閒春过三分二，凭仗桐花报与知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1487,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"浙西园苑","author":"方回","text":"壁间墨客扫龙蛇，所写诗佳字亦佳。\n忽见一诗增感慨，吾家宗伯老秋崖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1488,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"海棠花","author":"方回","text":"锦城春色万人迷，饭颗无心著品题。\n实不如华谩秾艳，秋霜谁觑海棠梨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1489,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"索云叔新茶","author":"方回","text":"谷雨已过又梅雨，故山犹未致新茶。\n清风两腋玉川句，三百团应似太誇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1490,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"衮绣毬花","author":"方回","text":"舞姬初试薄罗衣，趁蝶随蜂玩午晖。\n各折一枝入深院，欢声赢得绣毬归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1491,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其一 一曰秋菊盈园而持醪靡由","author":"方回","text":"陶公爱菊满园秋，甚欲持醪竟靡由。\n世事重华那复尔，无钱更觉少陵愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1492,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其七 七曰秋菊有佳色裛露掇其英","author":"方回","text":"饮酒成诗二十篇，诗成多在菊花边。\n秋英掇取枝头露，想见朝朝起卯前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1493,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其二 二曰空服九华","author":"方回","text":"金英足可换君骨，绿醑宁当腐我肠。\n空服九华无九酝，帝乡何似醉为乡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1494,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其八 八曰松菊犹存","author":"方回","text":"种松今世见松老，种菊常年见菊开。\n十一月霜花欲槁，巾车岂可更迟回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1495,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其三 三曰菊为制颓龄","author":"方回","text":"自性不随黄落去，始能为尔制颓龄。\n涪翁具眼曾拈出，我为重吟换鬼听。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1496,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其五 五曰芳菊开林耀青松冠岩列怀此贞秀姿卓为霜下杰","author":"方回","text":"人间红叶去无踪，膏沐谁为百草容。\n霜杰同时谥贞秀，抗衡惟许老蟠龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1497,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陶集爱其致意于菊者八因作八首 其四 四曰尘爵耻虚罍寒华徒自荣","author":"方回","text":"杯空无酒非瓶耻，耻在虚罍敢怨嗟。\n想见此翁不憔悴，天寒犹自有荣花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1498,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读魏鹤山先生渠阳集五首 其五","author":"方回","text":"瀛登湘渡偶皆同，一了乾坤此两翁。\n前后身吾虽未信，俱遭权孽肆奸凶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1499,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读魏鹤山先生渠阳集五首 其四","author":"方回","text":"投荒弥远凶徒炽，出督清之狡计行。\n得柄欺君例如此，国亡徒剩正人名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1500,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读魏鹤山先生渠阳集五首 其三","author":"方回","text":"汉唐台阁画功臣，何似宣尼从祀人。\n欲绘两贤继张吕，临邛魏老建安真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1501,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读魏鹤山先生渠阳集五首 其二","author":"方回","text":"濂翁传到紫阳朱，复见嘉端此大儒。\n一论道原一原道，他求伦拟汉唐无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1502,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读魏鹤山先生渠阳集五首 其一","author":"方回","text":"登门四十九年多，细读公书百遍过。\n今岁摘抄靖州作，遁翁堪配不传轲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1503,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"钱舜举瓜画","author":"方回","text":"老钱工作赵昌花，残绿依稀姤五瓜。\n正叔晦翁凡六说，始知辅嗣大争差。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1504,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶书二首 其二","author":"方回","text":"一昨悬车后，蹉跎又五年。\n常书乞米帖，犹费买花钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1505,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶书二首 其一","author":"方回","text":"磊落终休矣，艰难晚见之。\n罔知当世事，殊悔少年时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1506,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题五言绝句五首 其五","author":"方回","text":"自古有治乱，谁家无是非。\n晓床听邻语，琐琐诉寒饥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1507,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题五言绝句五首 其四","author":"方回","text":"为客弹长铗，□□□短衣。\n奈何年不肯，五过古来希。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1508,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题五言绝句五首 其三","author":"方回","text":"春秋踰致仕，南北粗知名。\n有客来相问，如何不治生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1509,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题五言绝句五首 其二","author":"方回","text":"落木包生意，来鸿定去期。\n如何萧瑟气，有许楚臣悲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1510,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题五言绝句五首 其一","author":"方回","text":"不寐常攲枕，无言独倚楼。\n江淹犹匪恨，庾信始为愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1511,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄同年宗兄桐江府判去言五首 其五","author":"方回","text":"好山多处说严陵，官事閒时定一登。\n野寺岂无僧十百，爱僧须是爱诗僧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1512,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄同年宗兄桐江府判去言五首 其四","author":"方回","text":"子陵滩上一诗翁，七十四年双耳聋。\n第一老穷吟第一，一樽时与酹江风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1513,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄同年宗兄桐江府判去言五首 其三","author":"方回","text":"不识康庐真刺史，可怜德祐假平章。\n木绵老鬼死遗臭，万古秋崖姓字香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1514,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄同年宗兄桐江府判去言五首 其二","author":"方回","text":"秋崖犹子蛟峰弟，同榜三人老弟兄。\n君玉中尝辞直指，去言晚乃佐专城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1515,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄同年宗兄桐江府判去言五首 其一","author":"方回","text":"联翩同挂别闱名，尚得秋崖病体轻。\n三十四年如一瞬，梦中时见老先生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1516,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄阎承旨靖轩","author":"方回","text":"相逢偶值寄梅人，今岁江南暖未匀。\n报与玉堂真学士，小诗聊当一枝春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1517,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题休宁赵氏云屋省心翠侍问道亭有有堂五首 其五","author":"方回","text":"贯朽青钱粟腐红，何如心不愧天公。\n一方寸里无馀物，却笑敖仓武库穷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1518,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题休宁赵氏云屋省心翠侍问道亭有有堂五首 其四","author":"方回","text":"三叉路口驻车轮，莫讶知津更问津。\n何限出门向西笑，忙行不似慢行人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1519,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题休宁赵氏云屋省心翠侍问道亭有有堂五首 其三","author":"方回","text":"青疏老瘦碧孱颜，杳杳深深万翠间。\n侍坐侍行仍侍立，雪松霜竹雨馀山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1520,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题休宁赵氏云屋省心翠侍问道亭有有堂五首 其二","author":"方回","text":"心属何人省者谁，自家主宰自家知。\n从来此地惺惺处，不要医工用药医。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1521,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题休宁赵氏云屋省心翠侍问道亭有有堂五首 其一","author":"方回","text":"不品官班但品人，深云藏屋屋藏身。\n就中别有难藏者，名震京师郑子真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1522,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题陈公辅听雨轩","author":"方回","text":"知时润物最关心，不作珠帘暮捲吟。\n龙过惊回攲枕梦，檐声点点是商霖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1523,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄题感应夫人庙","author":"方回","text":"观世音化马郎妇，西王母嘲方朔儿。\n乾坤大幻万千变，□我敬之而远之。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1524,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄赠介石沈高士 其一","author":"方回","text":"荦确崎岖峭壁间，险过巫峡更潼关。\n石头莫待微相磕，便合收心早早还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1525,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]