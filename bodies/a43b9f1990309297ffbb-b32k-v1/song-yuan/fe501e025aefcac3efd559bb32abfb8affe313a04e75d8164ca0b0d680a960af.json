[{"title":"陈君祥参政挽诗","author":"龚璛","text":"混一谋猷早，承平属任繁。\n躬行儒不及，阴德狱无冤。\n草木知遗爱，人林痛达尊。\n双珠掌中见，宦业绍家门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9284,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"广微龙","author":"龚璛","text":"红光掣电墨雨入，谁袖轰霆起春蛰。\n絪缊之际物化醇，九天下垂海拱立。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9285,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"林彦达山水","author":"龚璛","text":"看山头拄背，结屋树随缘。\n一水盈盈隔，閒云在在眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9286,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"人生","author":"龚璛","text":"生人本同体，弱肉强之食。\n方其恣奸险，从尔言籍籍。\n相为舞官法，未几遭鬼责。\n是非予夺间，一二堪指迹。\n此固可以戒，犹搔寿考额。\n彼哉幸而免，至竟心不测。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9287,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天平道中二首 其一","author":"龚璛","text":"望荼䕷好雪䰐鬖，暖日和风信去帆。\n寂寂馀香花数点，晴波欲动嫩凫搀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9288,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天平道中二首 其二","author":"龚璛","text":"鼓声依约分鱼市，不负侬家白酒鲜。\n粳稻新秧及时插，苧衣清楚入梅天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9289,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"分荷字","author":"龚璛","text":"酒为新凉饮，诗来酒意歌。\n微风万个竹，过雨一陂荷。\n窈窕初开径，涟漪不起波。\n明年避暑录，何处共婆娑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9290,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山水画","author":"龚璛","text":"窍于山川载神气，开辟而来画何异。\n无隐乎尔观尔志，子敬为子敬敬识。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9291,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白云阡为张祥卿作","author":"龚璛","text":"物外方絪缊，白云山之巅。\n匡庐下马坟，是家卜牛眠。\n人子岂不养，生人无百年。\n至今心眼孤，皎如香炉烟。\n人人有此云，回望俱可怜。\n霜降春雨濡，何独君拳拳。\n终身知孝慕，体受当归全。\n一举足出言，而亲长在前。\n因君与世人，死生安者天。\n不见南阳行，荒哉原巨先。\n但威太行险，勿羡怀英贤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9292,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谢陈壶天惠蟹","author":"龚璛","text":"寒蒲缚来肠已无，枯骨裹肉肉自腴。\n为君唤醒江湖梦，孤篷细雨声相濡。\n贫家不办满眼沽，糟床溜溜红真珠。\n起来为立西风里，一径晴寒菊数株。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9293,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题横披竹","author":"龚璛","text":"竹影平寻月落时，小舟移岸半蒿迟。\n参差化作一匹练，我独寒篷亲见之。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9294,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题岳仲远所藏坡翁焦墨枯木竹石","author":"龚璛","text":"坡仙胸中非酒浇，吐出苍玉秋寥寥。\n忽然变化不可极，怒龙倒海拔沃焦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9295,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蓬莱音琴铭","author":"龚璛","text":"蓬莱仙人佩霞飞，縆我朱弦明玉徽。\n千古万古大音希，海深深兮山巍巍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9296,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次赵可大见赠二首 其一","author":"龚璛","text":"江浦有捐佩，幽兰共芳馨。\n解后展良晤，习容观玉声。\n翱翔谁与偕，即之溯修名。\n友士常来足，蹇予车盖倾。\n寒宵念邻居，皎月临中庭。\n信知西坡翁，老眼千载明。\n士生有穷达，不辱斯为荣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9297,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次赵可大见赠二首 其二","author":"龚璛","text":"美哉慈乌诗，倚歌鼻酸辛。\n矫矫寸草微，茫茫天地恩。\n人人有此乐，回看亲舍云。\n何如奉菽水，晼晚严晨昏。\n但云谷口耕，名为京师闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9298,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读汉书","author":"龚璛","text":"张汤多巧诋，公孙但从谀。\n甚恶刀笔吏，亦鄙章句儒。\n在廷无党偏，惟有汲长孺。\n徒为右内史，几以不悦诛。\n武帝欲云云，顾问当何如。\n陛下内多欲，奈何效唐虞。\n申生言力行，较之得皮肤。\n惜不能用黯，为御史大夫。\n丞相取充位，不用董仲舒。\n对策最纯正，尚忧书自书。\n六经日表章，儒效旧阔疏。\n治道固有本，千载一长吁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9299,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次干寿道陪曹许二丞山行","author":"龚璛","text":"西郊凛风快冬晴，南州落木先春荣。\n骅骝并辔来幽并，天上丞弼山中行。\n山如削华水环瀛，观山玩水宽作程。\n海鸥忽来立虚明，翛然更觉富贵轻。\n路傍初植析羽旌，道从肯令僧定惊。\n涵空俯瞰吴王泾，当时射越飞鹘鸣。\n入贡施女如娇莺，亡国不在黄池兵。\n吁嗟斯人为物灵，岂随血肉同腐腥。\n故有戒心无放情，尔培尔栽覆尔倾。\n姑苏范公自高平，庆历执政用六经。\n是能才全德不形，一代治化非难成。\n二公酌泉倚云屏，古今事业相峥嵘。\n栋梁松柏森森青，忠烈寺下谁将迎。\n有客新列慈恩名，何假禅悦谈无生。\n促坐参语酒未冷，焉得閒日留双清。\n归途寥旷嵯峨城，林薄万籁皆琴筝。\n洞庭慑伏波涛声，英雄废台呼旧鹰。\n鱼龙末技不敢呈，惟见夕照寒烟横。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9300,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"香林长老为其师叔祝香求诗","author":"龚璛","text":"故纸堆中唤师叔，香林花叶续传灯。\n寻思四十年前事，只为茶毗一个僧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9301,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬至","author":"龚璛","text":"有约佳人殊未来，地炉孤坐画寒灰。\n今年物色得春早，一夜梅花如雪开。\n阅世徘徊九节杖，凌风缥缈百层台。\n江南若个山中树，几许阴晴生绿苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9302,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书台像","author":"龚璛","text":"荆江亭诗长沙酒，浩浩东流泻南斗。\n守德之宅扬子云，疾恶如风朱伯厚，仕虽可久耕欲耦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9303,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"周氏野泉别墅图","author":"龚璛","text":"皋陶旧国群山里，寂寂野泉山谷底。\n试寻山脉问泉源，定有蛟龙拔湫起。\n城郭犹堪万家汲，芜秽适从何代理。\n大雨不溢旱不枯，育德渊然古君子。\n簿领三年报政成，习俗能谙风土美。\n桐乡爱我爱桐乡，旧日劝农曾到此。\n身闲却作负耒来，愿与吾民同井里。\n安仁已种环县花，伯道惟饮吴中水。\n毋勤父老歌去思，此处枕流方洗耳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9304,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五柳图","author":"龚璛","text":"吾友石民瞻，平生书画忺。\n曾为彭泽令，柳下识陶潜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9305,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游桃花坞次郭祥卿陆友元韵喜善之赴召","author":"龚璛","text":"黄堂邓公直，金匮史迁书。\n朝野太平久，文章全盛初。\n北方多宿老，南士有新除。\n此事须公等，秋江晚执袪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9306,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题了堂所藏郭天锡作乱山烟雨图","author":"龚璛","text":"南郭山人隐几处，青山白云无所住。\n万壑度尽松风声，更向了堂参一句。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9307,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和静春赠唐心月韵 其一","author":"龚璛","text":"白苧萧然凉意回，清尊不共故人开。\n江湖水满雁鸿过，天地秋高风雨来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9308,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和静春赠唐心月韵 其三","author":"龚璛","text":"我看浙江无数山，尽携明秀与俱还。\n平生此复兴不浅，宛转小诗料理间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9309,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和静春赠唐心月韵 其四","author":"龚璛","text":"越来溪头烟水秋，绵绵洲渚忆曾游。\n城下荷花望不极，城上乌栖乐未休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9310,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和静春赠唐心月韵 其五","author":"龚璛","text":"旧雨人来今不来，柴门自为晚凉开。\n平生所得二三子，一日须来一百回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9311,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"茶屋","author":"龚璛","text":"世事有馀味，心交多淡成。\n树依寒舍种，诗为蚤春萌。\n谷雨排檐滴，松风泛鼎鸣。\n就中留小径，饱饭得閒行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9312,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨篷二首 其一","author":"龚璛","text":"黄篾江南舫，风烟春水波。\n轻推横画卷，薄暮理渔蓑。\n俛首安身了，浮生涉世多。\n庾冰正在此，潇洒扣舷歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9313,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨篷二首 其二","author":"龚璛","text":"正在籧篨下，犹疑箬笠前。\n凄迷不寐客，飘泊未归船。\n枕藉无馀地，江湖有漏天。\n平生万里意，风趁一帆悬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9314,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题兰花二首 其一","author":"龚璛","text":"绿叶兮紫茎，数花香正足。\n为我语涪翁，山矾水仙俗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9315,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题兰花二首 其二","author":"龚璛","text":"孤竹皆殷墨，两龚真楚清。\n试凭兰与蕙，难弟复难兄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9316,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽蔡山长","author":"龚璛","text":"仙游分望族，相叶肇嘉名。\n古道见师法，平生无宦情。\n雪林惊岁晚，门巷逼林清。\n万卷藏书远，何当继老成。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9317,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读元祐党籍碑","author":"龚璛","text":"彼狂曰予圣，莫辨乌雄雌。\n安知百世公，乃在党籍碑。\n在昔汉唐末，所无恐为之。\n安真或敢侮，自是宋德衰。\n空令大梁人，至今歌黍离。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9318,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与照元晦月夜闻人读诸葛武侯传得南字","author":"龚璛","text":"繄惟诸葛公，谋国雅性耽。\n怀宝世不售，龙卧南阳庵。\n风雨耒耜底，忧国如焚惔。\n自比管与乐，关张渠得谙。\n平生益州牧，枉顾至于三。\n君臣天作合，鲲鲸钜海涵。\n堂堂汉丞相，大星在西南。\n斯文出师表，奸贼安足戡。\n典午何人斯，巾帼诚不男。\n天自不祚汉，论功可无惭。\n星陨尚千载，耿耿在立谈。\n九原不可作，有泪浊如泔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9319,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苦雨","author":"龚璛","text":"玉帛端如委，山川已遍宗。\n苍生容有罪，昊宰忍妨农。\n南亩犹须问，东溟恐不容。\n畴能补天漏，匪石耿吾胸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9320,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜晴","author":"龚璛","text":"积涝从旁午，新晴破郁陶。\n乾坤还日月，民社脱波涛。\n不怕漂庐舍，何妨用桔槔。\n从今且粒食，勿用想蟠桃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9321,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"复雨","author":"龚璛","text":"雨势仍可畏，天心竟若何。\n未应妨稼穑，只欲喜蛟鼍。\n野色归长夜，檐声决大河。\n无钱买小艇，肠断鞠藭歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9322,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送僧归仙居","author":"龚璛","text":"一雨暑气熸，秋声著梧叶。\n故山入幽梦，晨起事远涉。\n故家仙人居，矗矗山如楼。\n三林与海通，我家林边头。\n功名不救死，文字不乐饥。\n开门风雨夕，且食故山薇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9323,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"用元微之寄乐天韵奉怀元晦","author":"龚璛","text":"十宵九梦遣分身，世事翻腾可具陈。\n天意何时能悔祸，吾徒到处不如人。\n雨声历历侵残夜，风物凄凄入小春。\n缩地无方臂不羽，倚楼东望独伤神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9324,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题宋杨大年山景二首 其一","author":"龚璛","text":"漠漠云连远水，荻湾舂锄成双。\n误随绛城叶影，王孙本愿秋江。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9325,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题宋杨大年山景二首 其二","author":"龚璛","text":"蒲柳萧条秋晚，错漠江南远村。\n碛月照人无寐，翻江要湔泪痕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9326,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖晚意","author":"龚璛","text":"天赋幽人事事幽，西湖佳处七年留。\n荷香欲老茭如臂，得意斜阳一小舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9327,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张清夫心远堂","author":"龚璛","text":"张君旷士惺，逸翮辞笼樊。\n天游绝有待，旁魄造化原。\n春风菰蒲影，璧月湖上村。\n归栖度华搆，敛翅寂不喧。\n床敷学僧跏，梵夹手自翻。\n神交匡山远，遗烈千载存。\n华榱见芳扁，雅意识素敦。\n何时载茗盌，妙理迟细论。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9328,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送李孔言上舍北游","author":"龚璛","text":"士也今安用，何为志必行。\n将无因技术，亦可遂功名。\n漫把□□历，还称国子生。\n悠然燕市酒，此日看升平。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9329,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次贡仲章登虎丘韵","author":"龚璛","text":"远客喜旧交，相逢乘兴游。\n轻帆不用楫，出郭望林丘。\n旭日时来暑，春服何清修。\n涉世儒生腐，寻芳僧寺幽。\n红尘避人远，绿阴入山稠。\n奕奕文翰英，于于江海陬。\n凭高剧吊古，濯缨便临流。\n蒸郁变雷风，倚徙客迟留。\n取凉尽酒尊，沾湿坏诗篝。\n空濛驾归舸，起灭波中沤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9330,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"郭祥卿同游虎丘","author":"龚璛","text":"弱植有缓步，同游无杂宾。\n清阴山寺古，红树石楠春。\n丘垄埋吴国，园林阅晋人。\n不应系舟处，犹是去年津。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9331,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴中寒食","author":"龚璛","text":"寒食清明卖酒家，酒瓶乱插红白花。\n江南蚕子非一种，日暖蜂房报午衙。\n八十渔翁罾半破，往来醉客路三叉。\n村中女伴无忙事，疏雨小塘收漾纱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9332,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中山夜游图","author":"龚璛","text":"岁云莫矣索鬼神，九首山人生怒嗔。\n猎取群祅如猎犬，驱傩归去作新春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9333,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文泉","author":"龚璛","text":"泉者水之原，其初果何适。\n泓澄末沄沄，取辟人畜德。\n畜德唯其深，行道亦在兹。\n以彼周流意，于焉文命之。\n噫古所谓文，即礼乐法制。\n从世将奈何，而非此之谓。\n华身习口语，逢时贵词章。\n油油青山云，不到白玉堂。\n文者理而已，循理属君子。\n谓予言不信，法看逝川水。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9334,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题龚圣子画马","author":"龚璛","text":"人问能有几天马，试问来从西极者。\n二十万匹从贰师，攻破大宛仅得之。\n执驱校尉奏妙选，帝闲自此收权奇。\n未央宫门铜作式，矫矫如此龙八尺。\n绊者自绊逸者逸，不是老龚谁貌得。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9335,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"岁残","author":"龚璛","text":"岁残春雨初，晨兴人意舒。\n萱草侵阶绿，慈鸦巢树疏。\n耕锄馀几垄，门巷爱吾庐。\n休笑玄晏病，时翻架上书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9336,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"马虚中柳城春色图","author":"龚璛","text":"城中尘头十丈高，欲画春风风怒号。\n佩霞仙人骑鹤背，却度太虚观乐郊。\n当时丹青争出色，借与天公动摇碧。\n上流老子馀旧踪，恒大将军亦曾植。\n树犹如此我何堪，莫学江南系船客。\n雉堞平成天下平，有情有思弄春晴，隔叶睍睆黄鹂声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9337,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"海底眼歌为陆茂林作","author":"龚璛","text":"海底宁有眼，幽暗鱼龙渊。\n海底若无眼，何为腾腾光。\n烛天定有明珠在，其下能令世间长不夜。\n试看露出珊瑚枝，神物效灵纷变化。\n吴门别驾理伯雍，卜肆从谁问吉凶。\n陆姓森名特奇验，识高见远术非浅，以此喻之名遂显。\n扬火以致墨，冢宰总列职。\n其法今不传，太史载龟筴。\n足臑彷佛意颇遗，南士按书犹或知。\n九江纳锡不闻矣，偻句成欺皆弃之。\n流俗沈沦海波底，藉子一言与提耳。\n我作好歌以赠子，会访茂林谈物理。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9338,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玄天妙景歌","author":"龚璛","text":"光阴过去留驹隙，海宇微茫起蜃楼。\n梦境清都真帝所，仙人一室有天游。\n珠如黍米悬何许，掌上胭脂烂不收。\n飞佩超然凌倒景，拟将变化问洪丘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9339,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送宋梅隐","author":"龚璛","text":"黄鹤山中醉几回，山中良是梦徘徊。\n流水青蘋杏华影，晴江绿涨蒲萄醅。\n滟滟西湖汎春去，奕奕好风吹子来。\n门外酒船挝鼓过，何如同上姑苏台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9340,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪樵","author":"龚璛","text":"伊川门下已齐腰，清苦谁如雪里樵。\n浩荡山林行靡靡，低迷蓑笠影飘飘。\n枯梢一夜号寒堕，野菜寻春待冻消。\n炙手故应犹可恝，高人尘甑尽无聊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9341,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王园玉蕊开后作","author":"龚璛","text":"南园玉蕊玉敷腴，十日不来花已无。\n此地绿阴浑欲满，平生清兴不能孤。\n香随小径寻前梦，老待閒门种一株。\n过眼年华犹把玩，人间留在辋川图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9342,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次赵书台荆州见寄","author":"龚璛","text":"江水滔滔不系舟，一官已作五年留。\n诗从别后多清气，梦拟归来到白头。\n骨肉几人如此在，林泉何处晚来休。\n皋桥佣作犹堪忆，一饱平生本不谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9343,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次张仲实送项桂山韵","author":"龚璛","text":"昔时闻隐处，桂树满岩幽。\n凉雨飘归梦，江湖万里秋。\n我亦翛然客，相逢恋一游。\n鲈鱼政堪鲙，无酒为君谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9344,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]