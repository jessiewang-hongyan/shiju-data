[{"title":"菩萨蛮 其一","author":"仇远","text":"翠鸾不隔巫山路。\n无人肯指行云处。\n徙倚最高楼。\n秋波春望愁。\n先来愁似雾。\n更下丝丝雨。\n芳径溅香泥。\n苔花滑马蹄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":901,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒金门","author":"仇远","text":"但病酒。\n愁对清明时候。\n不为吟诗应也瘦。\n坐久衣痕皱。\n曾约花间携手。\n空忆洛阳耆旧。\n道不相逢还却又。\n海棠开厮句。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":902,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪狮儿 梅","author":"仇远","text":"武林春早，乘兴试问，孤山枝南枝北。\n见说椒红，初破芳苞犹绿。\n罗浮梦熟。\n记曾有、幽禽同宿。\n依稀是、缟衣楚楚，佳人空谷。\n娇小春意未足。\n甚娇羞，怕入玉堂金屋。\n误学宫妆，粉额蜂黄轻扑。\n江空岁晚，最难是、旧交松竹。\n忒幽独。\n笛倚画楼西曲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":903,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"渡江云","author":"仇远","text":"流莺啼怨粉，嫩寒著柳，语尚困东风。\n问荒垣旧藓，烟雨何时，溅泪瘗危红。\n□愁不尽，对乱花、芳草茸茸。\n嗟绮尘、漂零无定，绡幕燕巢空。\n匆匆。\n玉銮声杳，绣屋香消，谩精神入梦。\n记旧家、定场声价，曾冠深宫。\n香魂彷佛留环佩，正淡月、春雾朦朦。\n花影底，长年恨锁云容。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":904,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越山青/长相思","author":"仇远","text":"四月时。\n五月时。\n柳絮无风不肯飞。\n卷帘看燕归。\n雨凄凄。\n草凄凄。\n及早关门睡起迟。\n省人多少诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":905,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"塞翁吟","author":"仇远","text":"风柳吹残醉，惟枕梦便难寻。\n小院静，曲屏深。\n剪不断轻阴。\n新蚕乍扫鹅毛细，纤手镂叶如针。\n又负了，赏花心。\n听高树鸣禽。\n千金。\n嗟难买，飘红坠粉，怕容易、愁痕暗侵。\n但惜取、婵娟好在，任千里、杳杳鸿迷，渺渺鱼沈。\n相如未老，尽把衷肠，分付瑶琴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":906,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"塞翁吟","author":"仇远","text":"短绿抽堤草，芳信未许花知。\n尚留冻梗冰枝。\n藓石雪消迟。\n方塘水浅鸳鸯冷，沙际水翼相依。\n拾翠约，踏青期。\n终是乐游稀。\n相思。\n江南远，渔汀渺渺，还又是、梅花谢时。\n有多少、旧愁新恨，纵罗虬、妙曲风流，怎比红儿。\n何时再得，画鹢摇春，丰乐楼西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":907,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"摸鱼儿 其一 答二隐","author":"仇远","text":"爱青山、去红尘远，清清谁似巢许。\n白云窗冷灯花小，夜静对床听雨。\n愁不语。\n念锦屋瑶筝，却伴闲云住。\n莲心尚苦。\n谩自折兰苕，答书蕉叶，都是断肠句。\n鸥沙外，还笑失群鸳鹭。\n凄凉烟水深处。\n碧笺空寄江南弄，鸦墨乱无行数。\n梅半树。\n怅未识、佳人日暮情谁与。\n何时辇路。\n共系柳游鞯，印苔金屐，湖曲步春去。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":908,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"摸鱼儿 其二 柳絮","author":"仇远","text":"恼晴空、日长无力，风吹不尽愁绪。\n马头零乱流光转，粟粟巧黏红树。\n闲意度。\n似特地、随他燕子穿帘去。\n徘徊不语。\n谩彷佛眉尖，留连眼底，芳草正如雾。\n冥濛处。\n独凭阑干凝伫。\n翠蛾今在何许。\n隔花箫鼓春城暮。\n肠断小窗微雨。\n休更舞。\n明日看、池萍始信低飞误。\n长桥短浦。\n怅不似危红，苍苔点遍，犹涩马蹄驻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":909,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满江红","author":"仇远","text":"脂雨东流，觉春去、绿阴如幄。\n尝记得、桃花碧径，自怜幽独。\n日暮碧云空冉冉，摘花小袖犹依竹。\n望江南、草色欲连天，人江北。\n谁共剪，西窗烛。\n谁共度，西园曲。\n甚采香情懒，楚骚谁续。\n海远休寻双燕信，夜长争忍孤鸾宿。\n夹缃签、曾有旧题诗，镫前读。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":910,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满庭芳","author":"仇远","text":"寒食无情，阳春如客。\n晚风吹尽繁枝。\n落红堆径，小槛立移时。\n乐事不堪再省，吴乡远、愁思依依。\n谁家燕，斜穿绣幕，轻惹画梁泥。\n还知。\n人寂寞，殷勤软语，来说差池。\n怕王孙归去，芳草离离。\n倚翠屏山梦断，无心听、啼鸟催归。\n何时向，溪流练带，一舸载鸱夷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":911,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"睡花阴令/醉花阴","author":"仇远","text":"愁云歇雨，净洗一奁秋霁。\n枝上鹊、欲栖还起。\n曲阑人独倚。\n持杯酌月，月未醉、笑人先醉。\n忘醉倚、木犀花睡。\n满衣花影碎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":912,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"虞美人","author":"仇远","text":"满城风雨消凝处。\n谁是潘郎句。\n萧萧杨柳□凋黄。\n醉渡官桥瘦马、踏轻霜。\n旧时都道游春好。\n不似秋光小。\n菊花过了海棠来。\n定是催归锦字、不须开。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":913,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"解连环","author":"仇远","text":"绮疏人独。\n记芙蓉院宇，玉箫同宿。\n尚隐约、屏窄山多，□衾暖浪浮，帐香云扑。\n步袜蹁然，又何处、秦筝金屋。\n□柔簪易折，破镜难留，断缕难续。\n斜阳谩穷倦目。\n甚天寒袖薄，犹倚修竹。\n待听雨、闲说前期，奈心在江南，人在江北。\n老却休文，自笑我、腰围如束。\n莫思量，寻花傍柳，旧时杜曲。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":914,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"解佩令","author":"仇远","text":"浅莎深苑，流萤暗度。\n问霜纨、藏在何处。\n一自西风，乱剪剪、枝头红露。\n怕因循、彩鸾尘蠹。\n歌台香散，离宫烛暗，谩消凝、凌波微步。\n最怕黄昏，小楼外、零云残雨。\n把相思、共青镫诉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":915,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酹江月/念奴娇 其二","author":"仇远","text":"片云凝墨，看荷花才湿，依然无雨。\n水槛空明人少到，恰恰幽禽相语。\n曲几横陈，长琴高挂，自奏南风谱。\n俄闻刀尺，隔窗人剪霜苎。\n因念西子湖边，闹红一舸，曾宿鸳鸯浦。\n翠羽不传沧岛信，日暮闲情□与。\n懒拂鸾笺，懒拈象管，秀句同谁赋。\n孤鸿程杳，夕阳低下平楚。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":916,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酹江月 其一 梅和彦国","author":"仇远","text":"探春消息，觉南枝开遍，北枝犹阙。\n越女娉婷天下白，堪与冰霜争洁。\n孤影棱棱，暗香楚楚，水月成三绝。\n行云不动，素波轻浣尘袜。\n回首雪里关山，玉龙吹怨，似替人幽咽。\n溪上园林应满树，一径莓苔萦折。\n金马疏篱，玉堂茅舍，终是风光别。\n寻花欲语，对花却又无说。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":917,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蝶恋花 其一","author":"仇远","text":"碧树残鹃啼未歇。\n昨夜春归，不与行人别。\n留得绿杨枝上月。\n晓风吹作晴天雪。\n龟甲屏低红叠叠。\n火暖萸烟。\n罗荐鸳鸯热。\n一插宝簪云妥贴。\n下阶先拣花枝折。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":918,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蝶恋花 其二","author":"仇远","text":"深院萧萧梧叶雨。\n知道秋来，不见秋来处。\n云压小桥人不渡。\n黄芦苦竹愁如雾。\n四壁秋声谁更赋。\n人只留春，不解留秋住。\n秋又欲归天又暮。\n斜阳红影随鸦去。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":919,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蝶恋花","author":"仇远","text":"燕燕楼空帘意静。\n露叶如啼，红沁胭脂井。\n浅约深盟期未定。\n木犀风里鸳鸯径。\n楚岫秦眉相入映。\n私倚云阑，淡月笼花顶。\n今夕兰釭空吊影。\n绣衾罗荐馀香冷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":920,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉公子","author":"仇远","text":"晓入蓬莱岛。\n松下锄瑶草。\n贪看碧桃花。\n误游金母家。\n一酌洼尊露。\n醉失归来路。\n不见董双成。\n隔花闻笛声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":921,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉落魄/一斛珠","author":"仇远","text":"水西云北。\n锦苞泫露无颜色。\n夜寒花外眠双鶒。\n莫唱江南，谁是鹧鸪客。\n薄情青女司花籍。\n粉愁红怨啼螀急。\n月明倦听山阳笛。\n渺渺征鸿，千里楚天碧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":922,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"燕归来/喜迁莺","author":"仇远","text":"三叠曲，四愁诗。\n心事少人知。\n西风未老燕迟归。\n巢冷半乾泥。\n流红句，回文字。\n除燕知，谁能记。\n一声恰到画楼西。\n云压小鸿低。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":923,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"糖多令/唐多令","author":"仇远","text":"凉露湿秋芜。\n空庭啼蟪蛄。\n紫苔衣、犹护金铺。\n疏箔翠眉人不见，流水急，泣鳏鱼。\n恨草倩谁锄。\n西风吹鬓疏。\n问刘郎、别后何如。\n纵有桃花千万树，也不似，旧玄都。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":924,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"薄幸","author":"仇远","text":"眼波横秀。\n乍睡起、茸窗倦绣。\n甚脉脉、阑干凭晓，一握乱丝如柳。\n最恼人、微雨悭晴，飞红满地春风骤。\n记帕折香绡，簪敲凉玉，小约清明前后。\n昨梦云何处，应只在，春城迷酒。\n对溪桃羞语，海棠贪困，莺声唤醒愁仍旧。\n劝花休瘦。\n看钗盟再合，秋千小院同携手。\n回文锦字，寄与知他信否。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":925,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"霜天晓角","author":"仇远","text":"绮帷高揭。\n风动流苏结。\n兴在夜凉多处，兰烬短、半明灭。\n醉彻。\n香未绝。\n紫箫声乍歇。\n声入碧云堆里，还起舞、桂花月。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":926,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其二","author":"仇远","text":"高荷不受雨，倾泻与低荷。\n低荷强自持，聚雨倾入波。\n朝雨尚滴沥，晚雨忽滂沱。\n临池卧以听，雨声静中多。\n两耳本自清，奈此荷叶何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":927,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其五","author":"仇远","text":"风雨不出户，儿孙共读书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":928,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其三","author":"仇远","text":"萤火惟知夜，灯花不待春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":929,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其四","author":"仇远","text":"割蒲分坐具，贮瀑入军持。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":930,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其一","author":"仇远","text":"久欲脱尘网，未有辟谷方。\n释然山中游，世虑可暂忘。\n鸥鹭亦知几，深入菰蒲藏。\n卧舟放中流，吾不如渔郎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":931,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八景胜概 其八 龙门飞瀑","author":"方凤","text":"飞雪溅?砑，流云当面起。\n邂逅绿毛仙，临流同洗髓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":932,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八景胜概 其六 卦尖望鼎","author":"方凤","text":"遥岑谁画卦，置此荆山鼎。\n乍可姹女飞，千秋觇溟涬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":933,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八景胜概 其五 剑峡迟鸾","author":"方凤","text":"峡中候帝子，青鸟空徘徊。\n搔首叩玄律，何当化鹤来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":934,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三吴漫游集唐 其六","author":"方凤","text":"塞上风云接地阴，万方多难此登临。\n坐中有老沙场客，霄汉长悬捧日心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":935,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂咏十首 其八","author":"方凤","text":"猿啼不窥窗，牛驯常露地。\n伏虎与降龙，此理元无二。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":936,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂咏十首 其五","author":"方凤","text":"小哉蛮触战，鄙甚蛙黾怒。\n达人能大观，本以和平故。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":937,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂咏十首 其四","author":"方凤","text":"蜂房开户牖，蚁穴有官守。\n究竟物皆然，梦幻君知否。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":938,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄云林上人","author":"方凤","text":"竹杖芒鞋去未能，鞅尘十丈苦相仍。\n去来今了三生事，输尔寒岩宴坐僧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":939,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日同皋羽子善游白石龙湫用杜老九日蓝田韵","author":"方凤","text":"尘埃隔处地天宽，选胜携觞且笑欢。\n不惜逍遥投杖屐，何妨磅礴解衣冠。\n晴馀岚重雨犹落，秋老天高酒易寒。\n世事悠悠双眼外，与君飞瀑醉中看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":940,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"八月十四寿吴良贵","author":"方凤","text":"四十强而仕，斯言著礼经。\n抟鹏宜运海，振鹭且充庭。\n后夜中秋月，今朝南极星。\n耄夫频献酢，留眼看袍青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":941,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书示同志","author":"方凤","text":"尚觉浮名累，樵渔寄此身。\n寻盟潜勖德，证业喜知新。\n气谊生无间，文章合有神。\n毋徒涉城市，出处任风尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":942,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北山道中","author":"方凤","text":"起犯春霜一径寒，清游乘兴约吟鞍。\n眼中最恨友朋少，尘外频闻山水宽。\n溪落旧痕枯野埠，树浮空翠湿危栏。\n岩头几处悬冰白，已作群羊化石看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":943,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北山道中","author":"方凤","text":"拂衣去城市，信步踏晴泥。\n草意春风蚤，松阴野日西。\n语长忘路远，行近觉山低。\n更欲迟来此，穿林听鸟啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":944,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同胡汲仲兄弟登香远楼","author":"方凤","text":"策杖探幽胜，同登况二难。\n江山双极目，宇宙一凭栏。\n春色啼莺破，孤城拥浪寒。\n遥遥烟霭里，犹作故宫看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":945,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次陈浦泉教授渡江韵","author":"方凤","text":"笑拂湖亭柳，春归客亦归。\n塔云连岫暗，帆雨绝江飞。\n老觉游非壮，癯应遁却肥。\n有诗充古锦，尚不愧林扉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":946,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西鹿田寺听雨","author":"方凤","text":"禅栖投倦客，山雨起更阑。\n窗叶散幽响，石林生峭寒。\n洞深犹暗瀑，江远忽飞湍。\n想像云萝外，应宜晓色看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":947,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴良贵雪中归","author":"方凤","text":"别时黄菊映郊扉，转眼寒风刮毳衣。\n丰瑞正当三白见，修程适自四明归。\n因思水国银兼浪，胜看山乡玉作围。\n老去羊羔总陈迹，坐毡犹喜客堪依。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":948,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈皋羽","author":"方凤","text":"依依莲社客，斗酒共相酬。\n臭味语中得，荣名杯上浮。\n世情馀百变，吾道合千秋。\n肯信张平子，穷居但四愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":949,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和张子良","author":"方凤","text":"寤寐溪山好，相过不厌频。\n诗留曾宿客，月照乍归人。\n率尔呼盘粲，凭谁辨主宾。\n未须陈咫尺，高谊总秋旻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":950,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏霜叶寄皋羽善父","author":"方凤","text":"秋尽吴江道，丹枫树树奇。\n叶为诗者色，霜乃画之师。\n望似醉乡近，疑犹花事迟。\n停云俄在念，倚杖未归时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":951,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冒雨渡浦阳江","author":"方凤","text":"痴云千顷压江堧，寂寂篮舆破午烟。\n树杪楼台看近郭，渡头波浪忽滔天。\n舟依曲港难回楫，径转高陵每得筌。\n谁向龙山誇海国，一声铁笛女墙边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":952,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"客有问金华胜游者以诗叙其概","author":"方凤","text":"赤松上下雨霏微，八咏楼头重拂衣。\n西港晴来汀草长，北岩幽处洞泉飞。\n风敲定磬鹿春过，月满丹台鹤夜归。\n历览因知古词客，盛誇云梦未全非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":953,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日集张元吉兄弟宅","author":"方凤","text":"衔杯不让阮家风，况复阳春白雪融。\n调合西堂琴欲响，情深北海酒难空。\n诗题历历诸名迹，酬和年年几醉翁。\n未尽清狂尚期约，同看灯火月明中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":954,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭馀之张教授","author":"方凤","text":"吾怜张仲蔚，青草少人行。\n晓帐萤犹湿，空山鹤自惊。\n徒馀八斗望，谁筑五言城。\n莽莽孤村外，王孙挂剑情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":955,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"哭陆丞相秀夫","author":"方凤","text":"祚微方拥幼，势极尚扶颠。\n鳌背舟中国，龙胡水底天。\n巩存周已晚，蜀尽汉无年。\n独有丹心皎，长依海日悬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":956,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读西峰寺壁间诗","author":"方凤","text":"出郭幽探约里程，竹篱小语忽云生。\n寺藏密树磬声得，客染流霞暑气清。\n煮茗每闻松湍落，长苔半与石床平。\n何来老衲吟魂尽，满壁多题世外情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":957,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯续古赘赵氏","author":"方凤","text":"年华冠带玉辉辉，本悟秦风出赘扉。\n为要权宜就家室，不妨暂时别庭帏。\n化推正始馀麟厚，占协和鸣待凤飞。\n老我相亲垂十载，指期观子共于归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":958,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿保安寺","author":"方凤","text":"扪萝山径迥，流水石桥分。\n一雨过秋寺，千峰生暮云。\n望穷迷野色，沙远见鸥群。\n烟霭苍茫外，寥寥清磬闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":959,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄吴善父","author":"方凤","text":"啧啧不得意，兴怀偏为君。\n犹为乞米帖，不作送穷文。\n纵酒长违俗，挥毫自出群。\n相思今夜雨，滴沥未堪闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":960,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄梁隆吉","author":"方凤","text":"羡尔英年早息机，罗衣脱却著荷衣。\n黄醪白酿供吟咏，野史稗官漫是非。\n旧事横看东涧水，新餐谁共北山薇。\n金闺玉树思君甚，采药春华归未归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":961,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]