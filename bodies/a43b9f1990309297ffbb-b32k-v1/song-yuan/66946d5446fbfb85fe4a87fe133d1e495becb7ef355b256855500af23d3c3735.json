[{"title":"田园杂兴","author":"方一夔","text":"半生灯火误牛衣，晚岁才能悟昨非。\n雨笠半攲将犊去，丝车细捲趁蛾飞。\n粟生烧地山宜老，草烂新畬水正肥。\n莫道劳生何日息，迩来是事喜忘机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9938,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观物","author":"方一夔","text":"彭殇颜蹠不相齐，秋悴春荣各有时。\n共种花分红白色，同根木有死生枝。\n悲欣自是人情异，赋予宁非造物私。\n却笑庄生未谙此，安排齐物费言辞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9939,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"木犀花 其一","author":"方一夔","text":"此花习气爱巉岩，不受红尘点碧衫。\n地把鹫峰移境界，天教蟾窟堕尘凡。\n瑶林摵摵敲残玉，金屑霏霏贮满函。\n月影徘徊花影乱，待携双盏与君衔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9940,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"木犀花 其二","author":"方一夔","text":"招隐谁招到碧岩，自嫌黄绶映青衫。\n月光童子分根柢，金粟如来混圣凡。\n胜赏莫辞空百盏，丽酬不记达千函。\n竦身便脱尘埃去，径上清虚谢辔衔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9941,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"木犀花 其三","author":"方一夔","text":"秋风吹梦绕千岩，偷看天宫云锦衫。\n色尚红黄定崔李，花从开谢识荆凡。\n试教月老排芳谱，更听仙童诵玉函。\n剩有辟寒金粟树，丁宁栖鸟莫教衔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9942,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"耜岩连和六首予与汪子新亦各再和二首 其二","author":"方一夔","text":"风韵孤高百尺岩，敝袍争得似荷衫。\n久知郤氏声名远，自愧宾王骨相凡。\n閒捣香涎供玉杵，戏题綵帖拂尘函。\n醉来为问姮娥信，更倩鱼传与雁衔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9943,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚杂兴","author":"方一夔","text":"白藕花残暑气收，凭高更欲上层楼。\n蒹葭淅沥水天晚，禾黍高低风雨秋。\n鸡瓮豕零更佐使，狗屠狐叫或王侯。\n世间万事祇如许，莫把閒愁枉白头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9944,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"以书院课治事留杭十日竟为小吏所阻","author":"方一夔","text":"倦看世态变凉炎，老觉诗书味更严。\n与世不谐多枘凿，谋生甚拙欠齑盐。\n抟风肯羡鹍鹏化，署纸偏憎雁鹜钳。\n从使小儿轻我辈，只今归去问陶潜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9945,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过钱塘旧京","author":"方一夔","text":"曾逐东风过曲江，人间俯仰隔兴亡。\n江头潮涸趋渔浦，山下城空失凤凰。\n漠漠黄埃昏草棘，悠悠陈迹阅星霜。\n由来离黍游麋地，不分铃鸣替戾冈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9946,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再点陶金户计","author":"方一夔","text":"万里云程阻便风，孤鸿痛定再伤弓。\n徵求多出儒冠外，飞走难逃世网中。\n不分事情多倚仗，厌看人面诉贫穷。\n生平豪气难磨折，时向毫端吐白虹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9947,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明二首 其二","author":"方一夔","text":"一去昭阳入朔台，羁魂流落不归来。\n葬从胡地留妃骨，死向南方飏后灰。\n鸦噪莫看耘墓迹，酒香谁把洒陵杯。\n茫茫草地人稀到，风急棠梨落又开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9948,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵洪复翁食蕨","author":"方一夔","text":"花叶根茎种种香，谁知山草宿舂粮。\n筠篮净洗倾银粉，瓦釜狂搜冻蔗浆。\n爽口如兼三鼎味，疗饥不试五仓方。\n西山饿死真馀事，安有冥鸿为稻粱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9949,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"别弟","author":"方一夔","text":"欲去相看手重携，寒波芳草助凄迷。\n无人传业空多子，有弟持家老得妻。\n风雨灯前频入梦，诗文酒后共分题。\n孤飞不羡冥鸿举，只羡南归羽翼低。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9950,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其一","author":"方一夔","text":"前程在处暗危机，脱迹红尘入翠微。\n清水一竿张钓具，白云四壁挂樵衣。\n马惟画骨空嗟瘦，龙不点睛那解飞。\n差有陈编相伴住，时将诗句洗前非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9951,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其五","author":"方一夔","text":"紫绶绯裳印佩金，我于数子总无情。\n傍人门户传书客，投老田园识字氓。\n世变委怀无逆顺，事机到手即功名。\n子房收敛英雄迹，谁说神仙在谷城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9952,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其六","author":"方一夔","text":"人境无缘断俗喧，丁宁牢闭两柴门。\n五更孤枕客怀恶，半世青灯书眼昏。\n有日空为无日计，醉时还道醒时言。\n白云久有南山梦，不待他年毕嫁婚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9953,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其七","author":"方一夔","text":"骎骎镜里鬓霜侵，偶占溪东十亩阴。\n风雨四时无尽藏，松篁终夜有馀音。\n家藏为米难糊口，日课除诗罕用心。\n谁说仓曹任窖谷，近来家富屡千金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9954,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其九","author":"方一夔","text":"不仙不释不居官，久狎渔樵作往还。\n细雨饱眠一黄犊，白云秀拔几青山。\n浮生往事真成梦，举世谁人最得閒。\n惆怅伏波粗意气，暮年犹向五溪蛮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9955,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴十首 其十","author":"方一夔","text":"生平缪计百无成，衰白如期入镜明。\n鸟不惊猜无忤物，人多怒骂渐逃名。\n襟怀落落怜孤影，岁月悠悠过半生。\n老去自知无处用，只留双眼待升平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9956,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春晚即事二首 其一","author":"方一夔","text":"纷泊杨花逐晚风，杜鹃声彻故园东。\n百千种事孤愁外，四十馀年一笑中。\n血作公文缘分定，膊成山字坐诗穷。\n少时怀抱今寥落，惆怅西窗夕照红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9957,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春晚即事二首 其二","author":"方一夔","text":"匆匆尘里换时光，春去夤缘底事忙。\n鸠已居巢晴逐妇，蜂方出穴暖分王。\n唱耕农起催秧绿，打供僧来趁麦黄。\n今岁先生贫到骨，时时为米籴官仓。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9958,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"妾薄命","author":"方一夔","text":"薄命佳人玉绝瑕，不随缘分落民家。\n悲风古冢生青草，落日深宫唱白花。\n万里思情馀蹋鞠，一生旧恨付琵琶。\n雄蜂雌蝶难相并，莫向春风怨岁华。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9959,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其一","author":"方一夔","text":"自合林泉着散仙，虎蛟在处卧山渊。\n未秋已拟偿新谷，计月先愁欠子钱。\n冷眼惯看平地险，薄情谁念死灰然。\n人生还有相逢处，昨日淮阴召少年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9960,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其二","author":"方一夔","text":"漫向松边倚瘦筇，一生襟抱与谁同。\n照人不老古今月，送客多情南北风。\n才尽悬知诗作祟，数奇莫与命争穷。\n冶金百炼今无几，休向人前说事功。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9961,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其三","author":"方一夔","text":"经秋春蕙叹时过，归卧南窗竹一坡。\n世味甚轻贪欲少，交情稍重怨恩多。\n羞从绿酒看霜剑，悔把青灯误雨蓑。\n技痒未能忘习气，新诗写罢更长歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9962,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"神仙","author":"方一夔","text":"扰扰争趋陌路尘，好閒平地即蓬瀛。\n青羊石化紫烟客，白鹤松成老树精。\n夹岸碧桃春水阔，满山落叶暮云横。\n神仙不用寻行迹，只向渔樵混姓名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9963,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹","author":"方一夔","text":"当年知己晋参军，画手分传老可文。\n碎影贴金初得月，寒梢耸翠欲干云。\n平生自是轻馀子，一日那能无此君。\n解为南风却炎暑，拟封清渭答殊勋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9964,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐二首 其一","author":"方一夔","text":"人间无处避红炉，急扫风轩醉一壶。\n泉冷月涵沉水璧，荷香雨跳走盘珠。\n神游曾到清凉境，幽讨如横绿野图。\n醉发醒松吟骨耸，从人笑绝道诗癯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9965,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜坐二首 其二","author":"方一夔","text":"呼奴薙草火攻蚊，与客高谈到夜深。\n风辨雌雄分别想，岁占牡牝喜嗔心。\n尘生渴肺须狂饮，寒耸诗肩更苦吟。\n秋色满怀人不寐，坐看落月与横参。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9966,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"术者谓予清淡镃基不贫不富而有寿","author":"方一夔","text":"谁甘清淡厌轻肥，命薄那堪不值时。\n插架简编家四壁，蟠胸梗概鬓千丝。\n狂图入梦空骑鹤，寿相生芒欲斗龟。\n莫讶时鱼更多骨，从来万事有参差。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9967,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"看笋","author":"方一夔","text":"丁宁莫采箨龙儿，造物成材各有时。\n寸碧纵横牛戴角，一斑缠裹豹留皮。\n长身上水夜深看，直干干云岁晚知。\n名节为君描画尽，清吟堪继菉猗诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9968,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初秋杂兴三首 其一","author":"方一夔","text":"利欲驱人看罢休，人间岁月不停留。\n别愁万里沧江水，归梦五更黄叶秋。\n贮腹谩誇李书簏，烂肠难拟董糟丘。\n老怀抑塞无人会，徙倚西风百尺楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9969,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初秋杂兴三首 其二","author":"方一夔","text":"守困书帷滞土牛，谁挥尺箠浴寒流。\n旧人不了新人事，今日那知明日愁。\n一雁惊飞湘水浦，孤蟾空挂岳阳楼。\n江南总解单于曲，吹彻残梅故国秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9970,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初秋杂兴三首 其三","author":"方一夔","text":"田怕秋阳老怕贫，谁能肮脏拔风尘。\n穷年兀坐少生计，末路相逢无故人。\n自爱漂摇栖倦翼，谁分浩荡慰穷鳞。\n区区温饱何须较，莫负秋来风月身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9971,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"有怀洪复翁入郡城纳金课","author":"方一夔","text":"故人东下濯沧浪，见说金沙作斗量。\n昔想万钱还跨鹤，晚知六博亦亡羊。\n诗传剑阁烟霞藁，地入桐庐云水乡。\n潇洒满怀无处着，归程何况接新凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9972,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其一","author":"方一夔","text":"老去时光渐不禁，那堪风景入秋深。\n文章何啻建安骨，议论能无元祐心。\n旧日交游谁可托，中年忧患苦相寻。\n致身稷契非轻许，末路无成学苦吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9973,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其二","author":"方一夔","text":"做事英雄竟不成，飞鸿何处避弓矰。\n杲卿有舌骂阿荦，叔夜无头传广陵。\n祸福难知随命值，才名太盛取天憎。\n江流渺渺无回势，独向西风倚瘦藤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9974,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴三首 其三","author":"方一夔","text":"穷守空山两鬓蓬，老饕有分过年丰。\n珠玑推上稻花水，金铁敲残梧叶风。\n兴寄小窗诗卷里，梦回别墅笛声中。\n俗缘相逐何时了，一笑人间万虑空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9975,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"社日思家","author":"方一夔","text":"晓鼓鼕鼕露未收，老翁鸡彘祝瓯篓。\n家家酒绿枌榆社，处处霜红柿栗秋。\n笑别比邻包祭肉，醉呼童稚认归牛。\n一年两度村田乐，不羡人间万户侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9976,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晚秋","author":"方一夔","text":"萧萧两鬓竟苍然，况近重阳风雨天。\n欲暝江村烟四起，渐寒山馆客孤眠。\n叶题旧恨在何处，菊折寒香仍去年。\n为忆故人三叹息，东篱沽酒已无钱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9977,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"菊","author":"方一夔","text":"矫首春风独后时，冰霜自厉占东篱。\n悲如屈子凄凉意，清似陶翁平澹诗。\n寂寞秋香怜向晚，徘徊寒蝶笑生迟。\n蹇予气味差相似，采采金英尽一卮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9978,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴四首 其一","author":"方一夔","text":"我亦山林澹荡人，笼禽饮啄失天真。\n客求妙墨多辞病，儿欠寒衣屡诉贫。\n夜雨书檠翻汗竹，秋风野饭配丝莼。\n文章固是平生志，赢得萧萧两鬓尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9979,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴四首 其二","author":"方一夔","text":"江上千峰缺复遮，疏林点点噪归鸦。\n短篷细网船回浦，快马青衫客到家。\n酒味春风生竹叶，笛愁寒月老梅花。\n丈夫处世便疏豁，莫买虚名斗角蜗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9980,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴四首 其三","author":"方一夔","text":"满目风埃落日低，拳支醉颊面山西。\n平堤树密欲藏寺，古渡舟横不碍溪。\n渺渺几竿秋水净，哑哑三匝夜乌啼。\n老来独有诗情在，口占新晴付小溪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9981,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴四首 其四","author":"方一夔","text":"又是山村秋暮天，蹉跎身世惜流年。\n风鸣浅濑高还下，山碍浮云断复连。\n豪气尚馀孤剑里，眵眸合老短檠边。\n心期蟠屈凭谁说，尽是巾箱千万编。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9982,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"续遣疟鬼","author":"方一夔","text":"老天难料倏炎凉，水帝游魂未伏藏。\n子喜朋俦餍口腹，我愁冰炭置肝肠。\n力持正论明无鬼，醉读离骚祓不祥。\n惟有五穷推不去，主人改事屏车樯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9983,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江村晚望","author":"方一夔","text":"江上孤村日欲斜，秋光淡淡渺天涯。\n几多田舍隐林薄，三两渔舟出荻花。\n归路负樵劳息树，乱流浴马怒喷沙。\n凭谁剪出机中素，图入人间富贵家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9984,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春雪","author":"方一夔","text":"薝卜林中忍辱仙，春来戏作散花天。\n晓山寒劲云迷色，夜帐光生月斗妍。\n北海无书羝不乳，朝阳有路马难前。\n从知造物憎贤达，拥絮高吟更自怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9985,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨霁二首 其一","author":"方一夔","text":"次第寻春不恨迟，春光偏在雨晴时。\n风林窍暖山飞鸟，潭洞门开惊卧螭。\n酒冽万家供笑语，土牛千耦乐耘耔。\n物华又逐年华转，惟有诗人老更衰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9986,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨霁二首 其二","author":"方一夔","text":"谁传春涨没溪毛，又喜朝晴暖土膏。\n箬裹旋生新接树，花窠重发旧栽桃。\n扫蜂上彗经营早，通燕归帘结构牢。\n莫道山中勋业少，等閒善类入钧陶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9987,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵胡柳塘夏自然春游","author":"方一夔","text":"邂逅相逢玷俊游，共临清泚看横舟。\n野情潇洒便僧寺，尘事嚣烦远市楼。\n倚杖有诗追和韵，折花随酒记行筹。\n归来散步斜阳下，休笑浮云等幻沤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9988,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大水","author":"方一夔","text":"长时烟雨弄梅黄，身似枯株守破窗。\n云气冒山天失昼，水声撼屋浪翻江。\n田通小涧频障土，船上高原屡徙桩。\n举世滔滔何日息，笑倾床下古罂缸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9989,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴五首 其一","author":"方一夔","text":"由来势退不英雄，谁怨天公苦不公。\n虫臂鼠肝俱造化，草妖木怪尽神通。\n百年身世浮沤里，大地山河旷劫中。\n巧拙贤愚俱莫问，此生元只似虚空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9990,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴五首 其二","author":"方一夔","text":"老骨槎牙不入时，可看霜雪点须眉。\n短披樵褐形如鹤，长把农书手欲龟。\n饥饱生前皆有定，文章死后竟何禆。\n凭高欲说无人会，早暮南窗盼绿猗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9991,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴五首 其三","author":"方一夔","text":"冷看风涛起怒鹏，自惭无力逐飞腾。\n林泉襟韵清如水，儒素门墙淡似僧。\n凉与竹奴分半榻，夜将书奶伴孤灯。\n人生适意祇如许，玉署金门不用登。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9992,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴五首 其四","author":"方一夔","text":"六月犹披紫绮裘，酸咸世味不相投。\n清泉绕屋声声冷，高竹依檐叶叶秋。\n挥汗读书如有慕，撚髭安字更何求。\n向无二事消閒日，谁遣先生一段愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9993,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杂兴五首 其五","author":"方一夔","text":"甘死蓬窗笑我痴，兴来况值夜凉时。\n閒中不觉年华促，归去方知宦路危。\n酒瓮沉沉倾玉瀣，簟筠细细蹙风漪。\n月残梦醒诗初就，枯笔长抛网蟢丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9994,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"莲花","author":"方一夔","text":"水仙微步碧玻璃，家在湘湖西复西。\n清欲濯缨长在水，妙曾斲鼻不污泥。\n已知净社曾参问，合是濂溪善品题。\n欲采远香无觅处，拿舟惊起两凫鹥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9995,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"府城别任惠叔表兄","author":"方一夔","text":"乘兴来为两月留，廿年踪迹叹萍浮。\n衔杯清话灯前雨，对榻羁魂枕上秋。\n倦矣悲鸣双客鸟，归欤浩荡一渔舟。\n吟边若值孤飞雁，频寄新诗慰别愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9996,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪","author":"方一夔","text":"北帝宫中亿万姝，天花散尽满天衢。\n蓬山宫阙白禽兽，秦地山河银雁凫。\n寒耸吟肩呵滴砚，春回醉颊宴开炉。\n梅花半树南枝早，梦绕孤山访老逋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9997,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王古樵观予苦疮鄙句遂自赋眉遭二韵各二首因次其韵为戏 其一","author":"方一夔","text":"老去疮残拟炙眉，暂凭酒力引风卮。\n久疏朋友惭多病，薄买田园费学医。\n吟罢肩寒生轸粟，坐来形槁似枯梨。\n浮生自笑多磨障，画癖书痴发旧痍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9998,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]