[{"title":"饯王书史","author":"杨公远","text":"揽辔来时柳未烟，榴花又见火初然。\n一春人坐冰霜国，四野农歌蚕麦天。\n教雨仁风弥歙境，屏山练水入吟编。\n明朝马首东归去，伫看清名到日边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5300,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯卢按察","author":"杨公远","text":"轺车至日岁将更，又趁薰风理去程。\n历遍山城留好句，苏回民瘼快舆情。\n人言但有官如此，世道应无事不平。\n祇恐江东难久驻，看看诏趣秉钧衡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5301,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯赵可斋朝京","author":"杨公远","text":"秋高秣马理征鞍，琴鹤相随上帝关。\n已有声名闻草木，又将诗句动夷蛮。\n金銮未赐金莲炬，玉陛将催玉笋班。\n管取来年三二月，定看昼著锦衣还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5302,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯康侯 其二","author":"杨公远","text":"古歙何多幸，民叨抚育恩。\n清声冠今古，浩气满乾坤。\n夜月一船载，秋风三径存。\n莫能攀去辙，恋恋劝金樽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5303,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饯康侯 其一","author":"杨公远","text":"报政三年满，还容借寇么。\n丝纶来帝幄，襦裤蔼民歌。\n遗爱棠阴茂，留传锦句多。\n苍生今有待，霖雨早滂沱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5304,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昨携拙稿呈康使君郢正以诗促之","author":"杨公远","text":"昨携拙稿乞挥斤，安敢颙颙觊赏音。\n明月清风聊寓意，孤峰绝岸颇留心。\n驽逢伯乐方增重，剑遇张华免陆沈。\n肯把灵丹攻鄙俗，珍藏何啻万黄金。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5305,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未中秋","author":"杨公远","text":"凉入郊墟暑渐微，奈何节序暗推移。\n景逢三五秋分夜，光异寻常月满时。\n按舞霓裳仙绰约，长舂灵药兔迷离。\n广寒宫桂花空发，近世无人折一枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5306,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"癸未元日","author":"杨公远","text":"桃板休题只任真，也无艰苦与悲辛。\n屠苏后饮身虽老，毛颖频挥道不贫。\n昨夜灯花今岁兆，今朝元日昨宵春。\n迩来时俗全非古，乌帽长衫能几人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5307,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"省斋寄诗用韵走笔以谢 其二","author":"杨公远","text":"竟日昏昏醉梦中，俄惊绿暗石榴红。\n两三个月书全杳，四五篇诗信忽通。\n身世愧无鸿鹄志，交情叹作马牛风。\n如今暂效相如计，较著无声迥不同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5308,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"省斋寄诗用韵走笔以谢 其一","author":"杨公远","text":"每思分袂岁寒天，又见荷钱贴水圆。\n月落梁间清夜后，云生江上晚风前。\n题诗茧纸无由达，结梦花屏又复还。\n会晤未龟空怅恨，何时握手共欢然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5309,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"览镜","author":"杨公远","text":"览镜颜非昔，相将老态催。\n青春弹指去，白雪上头来。\n兴逸三杯酒，诗清百咏梅。\n襟期除此外，万事付悠哉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5310,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳已过半月菊花方开 其二","author":"杨公远","text":"西风转北又旬馀，才见黄花粲短篱。\n底事不开重九日，何心却趁小春时。\n芳传栗里陶潜径，香入离骚屈子辞。\n不肯趋时真隐逸，岂教尘世俗人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5311,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳已过半月菊花方开 其一","author":"杨公远","text":"过了重阳半月馀，菊花方见放东篱。\n香清不减登山日，色好偏过泛酒时。\n餐落英真成浪语，存荒径岂是虚辞。\n生来宁耐风霜挫，晚节腾芳满世知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5312,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻鹃 其二","author":"杨公远","text":"春阑闻杜宇，归去意难禁。\n蜀道连天崄，郫城隐雾深。\n差池当日事，懊恨此生心。\n阅世多兴废，君休忆故林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5313,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻鹃 其一","author":"杨公远","text":"帝魄声声切，教侬听不禁。\n都缘伤国破，岂是怨春深。\n枕上幽人思，灯前逆旅心。\n花枝疑恨血，到处映山林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5314,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夜","author":"杨公远","text":"檐溜声中送旧年，团圞笑语不成眠。\n忽惊雷吼三更后，始悟春回半月前。\n桃板欲题诗未稳，灯花频结兆开先。\n明朝贺客无祗待，汲水煎茶当酒传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5315,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夜","author":"杨公远","text":"老境渐相干，饶侬鬓未斑。\n岁华今夜换，天道此时还。\n累重家常俭，身轻心自閒。\n莫愁生计薄，笔底有青山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5316,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借吴直轩韵别黄仲宣","author":"杨公远","text":"世路间关迥不同，生涯淡薄砚池中。\n买蓑去伴玄真子，著句来违黄石公。\n虽慰晓猿兼夜鹤，却嗟社燕与秋鸿。\n从今雪月交光夜，乘兴当思泛短篷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5317,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借张山长韵呈方虚谷 其三","author":"杨公远","text":"楼台寂寂白云堆，三径萦迂锁翠苔。\n怪得菊松多喜色，祇缘琴鹤已归来。\n人瞻北斗光尤灿，门对南山掩复开。\n野客再持漫刺谒，不应袖手又空回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5318,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借张山长韵呈方虚谷 其二","author":"杨公远","text":"归来默坐似心斋，南北曾穿几緉鞋。\n踏遍关河才思古，名知草木宦情佳。\n桐江胜景归吟卷，练水寒云入壮怀。\n试数时贤谁敢并，苏黄端的是同侪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5319,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借张山长韵呈方虚谷 其一","author":"杨公远","text":"幡然何事赋归来，领略黄山酬玉杯。\n敲月几编虽满世，泽民一念未宜灰。\n笑呼臞鹤梅边去，旋买寒花竹外栽。\n襟度汪汪千万顷，眼青应为野人开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5320,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其一","author":"杨公远","text":"钟鼎箪瓢信宿缘，且将閒逸度馀年。\n诗敲雪月风花夜，画捲江湖烟雨天。\n三尺焦桐方外友，一泓老砚郭边田。\n自惭野趣无拘束，敢和清吟一十篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5321,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其八","author":"杨公远","text":"吾庐近野却依城，弹压风光藉酒兵。\n山色可供图画趣，泉流聊当管弦声。\n眼前无事方安逸，天下丰年即太平。\n权势从来难倚仗，祇宜孤立度浮生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5322,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其三","author":"杨公远","text":"幽事知谁可共论，烟浮清晓月黄昏。\n吟梅细味逋仙句，植蕙閒招楚客魂。\n暴富小池蛙奏乐，安贫陋室席为门。\n吾生幸自无荣辱，一任傍人笑作村。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5323,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其五","author":"杨公远","text":"失笑如何了此生，须教日日醉乌程。\n是非不较人情好，穷达休论世路平。\n钓月耕云何限乐，枕流漱石有馀清。\n近来转觉身强健，剩喜双瞳炯炯明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5324,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其二","author":"杨公远","text":"竹马才抛又是翁，年来自觉转疏慵。\n欲开竹下三三径，还借毫端六六峰。\n处世竟无非理事，对人那有可惭容。\n浮沈聊尔从吾好，却笑南阳说卧龙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5325,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其七","author":"杨公远","text":"一生不把两眉愁，厌听瓢声笑许由。\n愿荷锄来翻畎亩，懒携刺去谒公侯。\n酒倾明月清风夜，诗琢空山落木秋。\n坎止流行俱莫问，自然霜雪未蒙头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5326,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其九","author":"杨公远","text":"身世悠悠岁月侵，儿时历练到如今。\n梅臞元禀冰霜操，松老犹坚铁石心。\n世道任从渠否泰，人情岂为我辰参。\n欲知卜隐在何处，寂寞荒村烟树深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5327,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其十","author":"杨公远","text":"径曲通村深复深，听莺吟歇听蝉吟。\n园林幽雅已成趣，朝市纷华岂到心。\n匣冷冯驩长铗剑，壁悬元亮不弦琴。\n故知忤世皆缘直，有口从今只合瘖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5328,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚翁涌金门城望五诗韵以写幽居之兴 其四","author":"杨公远","text":"细撚吟髭谩赋诗，骚人那敢与争驰。\n倾杯对月风清夜，倚杖观山云敛时。\n世事安危浑莫问，人生得失底须悲。\n何当琢就梅花句，付与高楼画角吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5329,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚翁涌金门城望五诗韵以写幽居之兴 其三","author":"杨公远","text":"时光迅速走双轮，忽忆前朝事已陈。\n门外难交骑马客，竹边惟结话诗人。\n生来岂羡陶朱富，老去宁甘原宪贫。\n处世自怜浑不解，江山聊助笔头春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5330,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚翁涌金门城望五诗韵以写幽居之兴 其一","author":"杨公远","text":"数竿脩竹半池荷，密掩柴门少客过。\n笔底画能希李郭，囊中诗欠似阴何。\n一心夜月炯长在，两鬓秋霜积未多。\n花甲明年重数起，幸逢尘世息兵戈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5331,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚翁涌金门城望五诗韵以写幽居之兴 其五","author":"杨公远","text":"堂标野趣岂虚传，坐看朝岚与夕烟。\n支径萦迂斜傍竹，幽池清浅倒涵天。\n少年心付沾泥絮，晚景身犹顺水船。\n却喜传家惟老砚，麝煤磨尽可曾穿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5332,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚翁涌金门城望五诗韵以写幽居之兴 其二","author":"杨公远","text":"半生迹未历江湖，辟地东郊旋剪芜。\n结屋池边尘自少，莳梅窗外俗全无。\n偶来啜茗谢良友，不肯趋时愧腐儒。\n却笑一寒难措手，欲裨短褐拆天吴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5333,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旅寓","author":"杨公远","text":"忆昔离家日，村村煮茧香。\n因循淹五月，次第过重阳。\n排闷诗多感，怀归梦最长。\n君言名利事，都只付亡羊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5334,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病起 其三","author":"杨公远","text":"病起觉痴聋，徐行脚蹑空。\n杖能供半力，药已奏全功。\n整顿身仍健，优游道未穷。\n呼儿涤泓颖，拂素貌渔翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5335,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病起 其二","author":"杨公远","text":"弹指叹吟身，悭悭满六旬。\n维摩宁久病，孺子岂长贫。\n虽欠诗边兴，还存笔底春。\n莫言憔悴损，梅瘦越精神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5336,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病起 其一","author":"杨公远","text":"一病已兼旬，朝来试整襟。\n眼前惊雾散，耳底怪蝉吟。\n检点尘侵砚，爬搔雪满簪。\n春归浑未省，绿树又成阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5337,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病腰","author":"杨公远","text":"偶病腰疼失步伤，艰行终日坐胡床。\n非干骑鹤因钱重，岂是悬鱼为带长。\n倒屣蔡邕那敢效，休官陶令却相当。\n名方细检无良剂，祇好频频酌酒浆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5338,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"荷花","author":"杨公远","text":"竹边窗外小池塘，青盖亭亭拥靓妆。\n莫把仙娥相比拟，合将君子为平章。\n凋时堪供真人艇，老去犹充楚客裳。\n几夜月明风露下，输侬受用许清香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5339,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贽雨村施权宰","author":"杨公远","text":"旌旆来时桂未华，如今烟柳又藏鸦。\n一尘不著千家月，万象无私满县花。\n草茂圜扉春寂静，吏閒庭院燕諠哗。\n剩膺当路飞腾剡，玉笋催班已有涯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5340,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"高斋韩东尉用前韵见寄次韵谢","author":"杨公远","text":"世间名利我无缘，饱看黄花又一年。\n鬓有几根从带雪，心无一事可欺天。\n筑居易办观梅阁，取醉难谋种秫田。\n欲谒昌黎论此意，那知先已寄新篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5341,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶成","author":"杨公远","text":"世路崎岖蜀道难，长年兀兀坐柴关。\n诗才得句心先喜，事不萦怀梦亦閒。\n已种苍竿环碧沼，旋营矮屋傍青山。\n倘来轩冕虽无分，赢得优游天地间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5342,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶成","author":"杨公远","text":"抱膝长吟更短歌，百年身世易蹉跎。\n事逢如意从来少，诗不惊人空自多。\n暖日烘时花著子，东风吹后草成莎。\n看渠天道无私覆，寒谷阳春有脚么。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5343,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶得李竹屋居士摘和靖先生梅诗四联演成八韵句工而韵险似难继和愧不自揣僭敢续貂珠玉在傍觉我形秽 其五","author":"杨公远","text":"池水倒窥疏影动，任渠羌管吹三弄。\n碧波清浅净无痕，老干槎牙坚耐冻。\n花放羞同桃李场，香来偏恼诗人梦。\n当年曾醉老师雄，翠羽双双疑作凤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5344,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶得李竹屋居士摘和靖先生梅诗四联演成八韵句工而韵险似难继和愧不自揣僭敢续貂珠玉在傍觉我形秽 其四","author":"杨公远","text":"水边篱落忽横枝，不受狂蜂浪蝶知。\n万紫千红俱寂寞，三花五蕊自新奇。\n风号浪涌连天起，雪作云凝拂地垂。\n此景此时难著脚，输渠耐冷立江湄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5345,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶得李竹屋居士摘和靖先生梅诗四联演成八韵句工而韵险似难继和愧不自揣僭敢续貂珠玉在傍觉我形秽 其三","author":"杨公远","text":"雪后园林才半树，支筇细认孤山路。\n云顽未敛风更严，木冻且僵天欲莫。\n冷蕊依稀无处寻，清香髣髴暗中度。\n翻思立马老坡翁，月上黄昏方得句。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5346,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶得李竹屋居士摘和靖先生梅诗四联演成八韵句工而韵险似难继和愧不自揣僭敢续貂珠玉在傍觉我形秽 其二","author":"杨公远","text":"暗香浮动月黄昏，斗转参横月闯门。\n香一线通清晓梦，影千枝写悄诗魂。\n荒寒老屋疏篱处，寂寞断桥流水村。\n青女横陈鸡唱彻，悬知烟雾暝云根。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5347,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶得李竹屋居士摘和靖先生梅诗四联演成八韵句工而韵险似难继和愧不自揣僭敢续貂珠玉在傍觉我形秽 其一","author":"杨公远","text":"疏影横斜水清浅，冰容不比寻常见。\n若非采石谪仙魂，定是汨罗骚客面。\n鹤膝枝低俯镜奁，鸭头波静澄江练。\n凭谁说与老孤山，敢续君诗君莫厌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5348,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶题","author":"杨公远","text":"鹅黄又染柳丝丝，自笑劳生作么为。\n雨耒云耕三寸管，风棂月牖一联诗。\n酒逢知己何妨醉，事不如人且待时。\n祇恁眼前随分去，展开怀抱豁双眉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5349,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄东麓赵赞府 其二","author":"杨公远","text":"黄花开后骤征鞍，再见黄花秋又残。\n只字未能通间阔，长笺先辱问平安。\n共看明月隔千里，独对西风愧一寒。\n祇有麓翁知我者，何时会面话辛酸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5350,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄东麓赵赞府 其一","author":"杨公远","text":"佐邑■阳绰有声，文章政事冠群英。\n南墙松想乘閒咏，北海樽闻已戒倾。\n横笛倚楼襟度逸，携琴带鹤宦情轻。\n结知当路交飞剡，行看除书下玉京。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5351,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄陆同府","author":"杨公远","text":"忆昔轻舟衣锦还，青红旗帜满江边。\n正逢时节梅将潦，又见池塘柳欲绵。\n千古棠阴思召伯，一封芝诏下尧天。\n行看大展经纶手，霖雨苍生四海传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5352,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄饯东麓赵赞府之官湖南","author":"杨公远","text":"忆昔鸣驺闯草庐，欢然把酒话襟期。\n自从六月袂分后，又是重阳节过时。\n江左英贤姑佐邑，湖南松竹助哦诗。\n饯违不及空惆怅，傥或逢梅寄一枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5353,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"康使君惠诗借韵谢","author":"杨公远","text":"几幅生绡扫麝煤，枯梢黏藓石封苔。\n布成野水云山去，博得金章玉句来。\n眉白自惭非我有，眼青多藉为侬开。\n一经题品多增价，古锦光芒亦壮哉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5354,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"探梅","author":"杨公远","text":"傍水寻梅步水湄，轻寒轻暖日斜时。\n不辞二里还三里，且看南枝又北枝。\n蕊胜珠圆香胜脑，花如玉洁蒂如脂。\n绝怜疏影横清浅，欲为题诗未敢诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5355,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五首 其五","author":"杨公远","text":"半黏残雪不胜清，可惜梢头欠月明。\n影不横斜冰未泮，香微漏泄晓初晴。\n餐毡苏武应同调，披氅王恭想再生。\n忍冻保全清节在，为渠从此定交盟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5356,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五首 其四","author":"杨公远","text":"横隔片烟争向静，深藏翠幕全真性。\n霞拖数缕日初沉，月挂一眉天未暝。\n问讯频敲碧玉枝，觅诗踏遍苍苔径。\n有时小醉倚幽窗，只藉清香闻得醒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5357,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五首 其三","author":"杨公远","text":"屋檐斜入一枝低，欲为形容颇费思。\n萧洒花裁冰脑缀，横斜干倚斗杓垂。\n风浮香动更阑后，窗映枝横月转时。\n最是孤高难著语，只宜索笑莫言诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5358,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五首 其二","author":"杨公远","text":"高标独立岁寒时，不受狂蜂浪蝶知。\n树百千年枯更好，花三两点少为奇。\n暗香疏影孤山句，却月凌风水部诗。\n顾我对渠吟未稳，且将淡墨貌横枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5359,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]