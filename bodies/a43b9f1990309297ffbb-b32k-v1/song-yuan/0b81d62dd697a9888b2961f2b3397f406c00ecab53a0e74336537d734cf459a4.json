[{"title":"胡蝶","author":"戴表元","text":"春山处处客思家，淡日村烟酒旆斜。\n胡蝶不知人事别，绕廧閒弄紫藤花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8651,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"荀陈聚星图","author":"戴表元","text":"州里相过未厌频，居然踪迹动星辰。\n当时多少辉煌者，不画诸公画此人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8652,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送陈养晦谒阆风舒先生四首 其四","author":"戴表元","text":"无诗莫入阆风里，到却阆风那有诗。\n拾取松风作新曲，归来时向梦中吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8653,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桃花寺石台","author":"戴表元","text":"台前藤藓碧交加，台下清流直又斜。\n待得丹成知几日，春风随分野桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8654,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"班婕妤题扇图","author":"戴表元","text":"时情任销歇，闺思转慇勤。\n也胜山阴媪，挥毫托右军。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8655,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读书有感 其二","author":"戴表元","text":"最爱徐生欲避秦，海天东去不通津。\n绝知胜似桃源境，男女同行五百人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8656,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读书有感 其一","author":"戴表元","text":"鲁女悲嗟起夜深，当年枉却泪沾襟。\n如今已免邻人笑，老大知无欲嫁心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8657,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄陆子方","author":"戴表元","text":"清江一日走千艘，独有闲仙不喜遨。\n几处白云思暮合，数行红树又秋高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8658,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梁楷画雪寒游骑图","author":"戴表元","text":"耸脰攒蹄一驻鞍，毡衣韦帽白漫漫。\n祇应田舍骑牛者，无此风沙踏雪寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8659,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梦中作","author":"戴表元","text":"晴霞冠领朝红洁，新涨连空晚绿酣。\n惆怅春风倦游梦，木兰亭上望淮南。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8660,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"萧照春江烟雨图","author":"戴表元","text":"波痕如树树如烟，更是春阴小雨天。\n何处得鱼何处醉，笋皮蓬底解蓑眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8661,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"铜山寺口初见梅花书寄何则颜二首 其二","author":"戴表元","text":"沙疏石瘦水涓涓，折得梅花费两年。\n更与何人说潇洒，香中行坐水中眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8662,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"铜山寺口初见梅花书寄何则颜二首 其一","author":"戴表元","text":"吴歌楚舞送年华，忆著终还不似家。\n今日春风吹梦醒，铜山寺口见梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8663,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州 其一","author":"戴表元","text":"山从天目成群出，水傍太湖分港流。\n行遍江南清丽地，人生只合住湖州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8664,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"湖州 其二","author":"戴表元","text":"一饱悬天不待求，几人乾白少年头。\n君看滚滚东流水，到海成渊始懒流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8665,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谢邻友陈仲学秀才惠玉芎苗二首 其二","author":"戴表元","text":"君家自有头风药，种在青青竹素园。\n此物但堪供暑啜，肯来相就发清言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8666,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谢邻友陈仲学秀才惠玉芎苗二首 其一","author":"戴表元","text":"坊州杜若自堪羞，沛国青粘亦懒求。\n那似一丛苍凤尾，等閒收味古瓷瓯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8667,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋董氏双岐竹","author":"戴表元","text":"山庄一对青青玉，潇洒天然同干生。\n说与人间好兄弟，时来林下听风声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8668,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬陈秀才","author":"戴表元","text":"一春一百二十日，日日开眉得几人。\n直与破除风雨去，今年浑似不添春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8669,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题子昂照夜白","author":"戴表元","text":"风前新解锦鞍鞯，雪色模糊雾色寒。\n此物人间无处著，千金祗得画图看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8670,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题东玉师府所藏潇湘图","author":"戴表元","text":"少年魂梦底曾閒，多在江湖烟水间。\n今日精蓝方丈地，倚窗眠看洞庭山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8671,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题伏生授书图","author":"戴表元","text":"白头不死见时清，子女相依解授经。\n何用生男作鼌错，乃翁一语不曾听。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8672,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题江干初雪图","author":"戴表元","text":"断树寒云古岸隈，渔翁初拨小船开。\n看渠风雪忙如许，还有鱼儿上钓来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8673,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题苏李泣别图二首 其二","author":"戴表元","text":"沙云如雪雪如尘，握手相看语语真。\n多少世间无泪面，一生错笑陇西人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8674,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题苏李泣别图二首 其一","author":"戴表元","text":"弓疲矢尽三千里，节弊衣穿十九年。\n流落天涯有离别，当时谁拟画图传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8675,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题孟浩然霜晓吟行图","author":"戴表元","text":"霜风飒飒搅吟鞍，童怖驴愁作许难。\n便使玉堂遭遇去，朝参更是五更寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8676,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵大年芦雁","author":"戴表元","text":"寒更索索警霜丛，兄弟当年意自同。\n犹是江湖太平处，未妨沈著卧秋风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8677,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵子昂叠岫图 其一","author":"戴表元","text":"百折云颠路尽通，无名怪木淡书空。\n相逢无问秋江客，不是巴中是剡中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8678,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵子昂叠岫图 其二","author":"戴表元","text":"白石青林底处无，侵云亦有小屠苏。\n桔花飞尽不归去，挥汗江城看画图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8679,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题番阳徐氏双头牡丹图","author":"戴表元","text":"天公幻化不经意，双萼忽然枝叶同。\n一似人间好兄弟，朱鞍锦辔踏春风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8680,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠陆相师","author":"戴表元","text":"江南江北路漫漫，七十九翁能往还。\n今代贵人容易识，卧龙不在草庐间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8681,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠屋西小陈秀才 其二","author":"戴表元","text":"毛锥自是今无用，铁砚还知古可穿。\n不惜日抄三万字，胜储百亩剡中田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8682,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠屋西小陈秀才 其一","author":"戴表元","text":"年少饥寒不足忧，笑谈有味自风流。\n等閒辍赠两兔颖，待看修成五凤楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8683,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丁丑岁初归鄞城","author":"戴表元","text":"城郭三年别，风霜两鬓新。\n穷多违意事，拙作背时人。\n雁迹沙场信，龙腥瀚海尘。\n独歌心未已，笔砚且相亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8684,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"七月初五夜养正堂示诸友","author":"戴表元","text":"客里犹多事，秋来又一旬。\n青天星斗净，白露稻粱新。\n留落空存节，炎凉莫问人。\n儒堂得佳伴，吟讽动比邻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8685,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十月朔旦寄贵白兄弟","author":"戴表元","text":"黄牛村前秋叶飞，青螺峰外海云归。\n故人相思雪满鬓，客子独行风举衣。\n乌鹊定占谁屋喜，鲈鱼知比去年肥。\n当时歌酒江湖上，百里音书今亦稀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8686,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又作散愁","author":"戴表元","text":"说穷人不信，欲说更何为。\n日永书肠觉，霜浓病骨知。\n□家兵溃后，交绝廪空时。\n头白风尘境，消磨尚有诗。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8687,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三次韵寄戴祖禹","author":"戴表元","text":"同分剡溪派，自喜小王书。\n野服调骁马，浓香薰蠹鱼。\n岁时趋阙里，早晚上公车。\n与我真兄弟，风流但不如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8688,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"下郝长塘小憩示陈养晦","author":"戴表元","text":"野水通田白，村山贴县青。\n兵荒犹古道，暑暍且长亭。\n稻地晴耕犊，瓜田昼扑萤。\n吾诗不寂寞，细讽与君听。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8689,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"久客且归留别郭于昭宪掾","author":"戴表元","text":"久客令人厌，初春乍许寒。\n飞蓬妨览镜，脱粟愧加餐。\n坐有誇年酩，门谁住马鞍。\n重来会相见，老性忍悲欢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8690,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"久客鹿顶承张景山寄诗次韵奉答","author":"戴表元","text":"但得无拘束，身轻处处仙。\n清谈煨芋夜，陈梦种花年。\n水窦羊肠折，山篱麂眼编。\n诗来正清绝，松下忽闻鹃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8691,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"乡君子肯堂董君分教贵溪作诗奉寄","author":"戴表元","text":"舟车赤日千馀里，笔砚清风二百年。\n开口人知宗洛派，举头身欲近闽天。\n絺袍凉拥松皮几，桂酒春浮药玉船。\n犹有英髦卧空谷，閒将名字访华颠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8692,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"于杭州九月送袁太初赴宁海教官","author":"戴表元","text":"怜君跋涉走风沙，九月江城飞雪花。\n黄蝶终归穿砚手，青藜曾照聚书家。\n吟圆坐石题山叶，讲退登楼看海槎。\n年少交游浑好在，何时相伴访烟霞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8693,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山中","author":"戴表元","text":"野水晴犹涨，春雷晚始鸣。\n地闲无堠逻，山远有蚕耕。\n身世通寒暑，交游半死生。\n方知一杯酒，真胜百年名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8694,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己丑正月六日袁季源家遭燬次韵书闷","author":"戴表元","text":"邺侯家里书千架，杜老尊前屋万间。\n此事吾堪慰流落，迩来天亦妒穷閒。\n反风待祷真虚语，噀雨无方自厚颜。\n间挈残家过西坞，风流还许几生还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8695,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己卯岁初葺剡居","author":"戴表元","text":"休言声迹转沉沦，百折江湖乱后身。\n穷未卖书留教子，饥宁食粥省求人。\n坐来齿避樵苏长，往处踪迷木石邻。\n翻笑古来逃世者，标名先制隐衣巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8696,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"己亥岁归过泉口紫芝山伤谨讲师","author":"戴表元","text":"行路梦犹在，入门人已非。\n山青古佛顶，云墨祖师衣。\n赌弈曾同拙，看真似欠肥。\n百年谁免此，只合早忘机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8697,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"以家事付诸儿惟不得姑苏陆氏女子消息","author":"戴表元","text":"祇怜地僻少过从，更许年衰养惰慵。\n行健有时寻近局，起迟尝日到高舂。\n鹿皮冠野频频戴，鹅顶蔬粗款款供。\n儿女团栾俱在眼，独怜无信过吴松。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8698,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"六月朔日再会再次韵与胡氏谦避暑","author":"戴表元","text":"台屋深难暑，湖林近易风。\n高歌送长日，醉眼睨凉空。\n雀舌纤纤碧，鸡头淡淡红。\n行藏数子别，谈笑一樽同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8699,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"壬午六月八日书怀","author":"戴表元","text":"怀人故国鳞鸿绝，避地春园草树长。\n四壁空存医俗具，千金难售卖呆方。\n共儿坐诵修吴语，有客行歌衒楚装。\n昨夜见花摇作梦，南风吹海白茫茫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8700,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"壬午清明","author":"戴表元","text":"节序愁中都忘却，见人插柳是清明。\n登陴戍出吹弹乐，上冢船归语笑声。\n解事浊醪相料理，当权团扇正施行。\n悲欢寒暑君休问，花鸟年年管送迎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8701,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太学冬至日同斋朋友先以兄弟叙拜讫遍诣诸斋行礼出遂置酒湖上衣冠谈笑之乐至今栩栩在念间也因至日去近二十九和为正仲道之","author":"戴表元","text":"画阁东炉早，黄帘晓烛迟。\n名函僮仆满，齿拜弟兄疑。\n歌酒神仙舫，衣冠宰相碑。\n如今穷海上，逆旅话襟期。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8702,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"无题","author":"戴表元","text":"板屋骤喧飞白蚁，纸窗欲雨暗苍蝇。\n长劳井臼惭妻子，近绝音书惜友朋。\n夜半苦吟堪泣鬼，日高甘寝祗输僧。\n意衰俗物何难败，才薄天公却未憎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8703,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"火后","author":"戴表元","text":"当年歌酒留连处，火后来看一惘然。\n傍水几家初饮马，入春三月未闻鹃。\n炎凉世事残城树，歌哭人声去客船。\n不是危肠拚醉得，颠狂无处著诗篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8704,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王丞自鄞城归又许入剡","author":"戴表元","text":"江城醉别太匆匆，风雪家园一笑同。\n尽健不妨天予老，绝清那许鬼欺穷。\n简书异日关谁事，灯火寒乡赖此翁。\n几度丁宁鸡黍约，扫关拂榻误儿童。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8705,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"风雨游小大浦","author":"戴表元","text":"海坞秋风里，无悰眼亦开。\n潮冲乌屿长，雨过象山来。\n畬父收牛种，渔丁拾螷胎。\n乘桴吾岂敢，人说近蓬莱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8706,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙子除夜","author":"戴表元","text":"富贵如今似骇机，漂流未遣壮心违。\n乡邻有酒贫能醉，村落无医病亦稀。\n客任低头从狗窦，妻休掩面对牛衣。\n十年涉世浑如此，除却躬耕事事非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8707,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东离湖州泊南浔","author":"戴表元","text":"张帆出东郭，沽酒问南浔。\n画屋芦花净，红桥柳树深。\n鱼艘寒满港，橘市昼成林。\n吾道真迂阔，浮家尚越吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8708,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杖锡寺","author":"戴表元","text":"仙草漫漫路不分，钟鱼那许外间闻。\n凉天九月已飞雪，晴日西山犹带云。\n火后客誇新屋样，兵前僧惜旧碑文。\n藤湖只去招提顶，见说滮田可种耘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8709,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"史亨父挽诗","author":"戴表元","text":"玉食婵娟非寿资，清怀犹胜几男儿。\n壶觞竹寺寻秋月，灯火荷斋听雨时。\n补衲有衣曾礼佛，吞舟无诀莫凭医。\n平生潇洒王文学，地下相逢且说诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8710,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"史昭甫招陈宗鲁之长兴","author":"戴表元","text":"之子沧浪去，三吴西更西。\n白盐莼菜脍，红酒稻花鸡。\n地少惊云满，天空见日低。\n锦囊看烂熳，佳客醉留题。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8711,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四十","author":"戴表元","text":"四十不解事，真成无用人。\n交游青草尽，途路白云新。\n渐觉名妨静，难将学济贫。\n堂堂楚龚传，犹有隐流嗔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8712,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四明山中逢晴","author":"戴表元","text":"一冈一涧一萦隈，新岁新晴始此回。\n莎坂南风寅蛤出，茅檐西日一禽来。\n人迷白路羊群石，水捲青天雪里雷。\n犹是深山有寒食，梨花无数绕岩开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8713,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"旧里火后多有筑宅者太平客户也","author":"戴表元","text":"人说离乡贱，归乡更莫论。\n许询家莫干，杜甫客东屯。\n废井微踪出，新邻杂语喧。\n平生江海意，岁晚白榆村。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8714,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正仲今年鄞城之约不就因次韵慰悦之","author":"戴表元","text":"莫怪诗翁不出山，诗多那得是山间。\n清溪欲暖莺啼树，白日无人犬卧关。\n不惜野花簪素发，时凭春酒转朱颜。\n当年阮籍何曾达，直到途穷始哭还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8715,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白岩山","author":"戴表元","text":"漠漠溪风吹路尘，白岩山下几穷身。\n秋深竹色老于树，昼静鸟群喧胜人。\n何处人家藏剡录，有时行客裹唐巾。\n平生笑杀禾翁子，刚为乘车弃负薪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8716,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"亚尹黄侯虑囚温处婺三州","author":"戴表元","text":"金华瑰秀抵仙都，雁宕石门天下无。\n眼见朱幡出云雾，手提丹笔洗焦枯。\n海鱼味爽休多食，岭马程艰合缓驱。\n定有车前投贽者，幅巾麻褐是真儒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":8717,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]