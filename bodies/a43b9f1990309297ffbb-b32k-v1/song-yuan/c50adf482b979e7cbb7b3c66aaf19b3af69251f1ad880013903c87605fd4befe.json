[{"title":"严子陵垂钓图","author":"郑思肖","text":"新莽纷纷未有涯，桐江山水颇为嘉。\n无心偶向一丝上，钓得清风满汉家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10371,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"袁安卧雪图","author":"郑思肖","text":"飞玉堆寒二丈过，杜门僵卧养天和。\n不愁屋外六花大，但觉胸中清气多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10372,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"高凤读书漂麦图","author":"郑思肖","text":"癖爱诗书苦未休，肯将俗事挂心头。\n等閒痛快语言外，那见雨来和麦流。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10373,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张天师飞升图","author":"郑思肖","text":"玉局曾经拜老君，子孙今尚宝玄文。\n要知龙虎山前意，但看空中数片云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10374,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王粲覆棋图","author":"郑思肖","text":"鸦鹭争飞局局殊，便生国手亦难图。\n未曾落子有一著，王粲还能覆得无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10375,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"先主三顾草庐图","author":"郑思肖","text":"抱膝高吟梁父时，卧龙致雨未为迟。\n若无三顾草庐意，剖出心肝卖与谁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10376,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孔明出师表图","author":"郑思肖","text":"一身英气射光芒，北定中原事转长。\n落得两篇出师表，至今只是汉文章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10377,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孔明成都八阵图","author":"郑思肖","text":"孔明抱义耻偏安，不道中兴事业难。\n赖有石头知落处，任从人换八门看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10378,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王祥卧冰图","author":"郑思肖","text":"母病杯羹意未谐，解衣竟欲卧冰开。\n有心直透清波下，安得无鱼跃出来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10379,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王衍举阿堵物图","author":"郑思肖","text":"口不言钱早不同，何须相试苦相攻。\n今朝叱去阿堵物，一室玲珑分外空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10380,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹林七贤图","author":"郑思肖","text":"清谈何补晋江山，谁与中原了岁寒。\n惟有白云三四片，飞来自向古琅玕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10381,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王子猷看竹图","author":"郑思肖","text":"秋沁徽之骨亦清，翠光如水漾空明。\n只图一见此君面，谁更问人閒姓名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10382,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王子猷访戴图","author":"郑思肖","text":"雪夜怀人泛剡溪，造门而返是还非。\n不曾相见犹相见，满载清风独自归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10383,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"阮籍醉眠酒家图","author":"郑思肖","text":"少妇当垆应怪人，陶陶一觉了残更。\n无情不作如花想，梦见醉乡生月明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10384,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"刘伶荷锸图","author":"郑思肖","text":"酒国韶光无际涯，大人境界绝朋侪。\n生来自有一方地，何待醉终才始埋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10385,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戴安道破琴图","author":"郑思肖","text":"独抱洋洋太古心，王门何苦欲相寻。\n狂来宁可破琴去，不许俗人闻此音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10386,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙康映雪读书图","author":"郑思肖","text":"孙康苦志惜居诸，雪夜无灯兴有馀。\n冷地白光生破屋，自然开眼见诗书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10387,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张翰思莼鲈图","author":"郑思肖","text":"名爵虽荣心最苦，莼鲈有味食无厌。\n后来京洛风尘暗，转觉吴淞江水甜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10388,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙楚枕流漱石图","author":"郑思肖","text":"孙楚匆匆误答时，说来颇与事相违。\n枕流漱石翻为妙，活弄胸中倒一机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10389,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"庾亮登南楼图","author":"郑思肖","text":"老子情怀颇滑稽，登楼恰喜月明时。\n虽然于此兴不浅，要且诸人知不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10390,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"周处除三害图","author":"郑思肖","text":"一朝周处奋英豪，三害皆除岂惮劳。\n若是不能降自己，纵屠龙虎不为高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10391,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王羲之兰亭图","author":"郑思肖","text":"犹记兰亭三月三，流觞曲水畅清酣。\n分明一段永和意，好向羲之笔外参。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10392,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桓伊三弄图","author":"郑思肖","text":"倾盖相逢不问谁，知音那肯露心机。\n一声吹破清秋影，惊散闲云各自飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10393,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陆绩怀橘遗母图","author":"郑思肖","text":"独荐霜丸意不安，谁供甘旨侍团圞。\n蓦然忆著娘生面，万树黄金尽喜欢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10394,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴隐之饮贪泉图","author":"郑思肖","text":"外物终难换肺肠，隐之清介顿生狂。\n便教饮尽贪泉水，只觉通身白雪香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10395,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"郝隆晒腹书图","author":"郑思肖","text":"七夕庭中罗绮乾，邻家应是鄙儒冠。\n文章满腹无人识，铺与青天白日看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10396,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陶渊明三径图","author":"郑思肖","text":"老气苍寒松树活，閒情幽淡菊花开。\n一条古路无人走，还且与人相往来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10397,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陶渊明对菊图","author":"郑思肖","text":"彭泽归来老岁华，东篱尽可了生涯。\n谁知秋意凋零后，最耐风霜有此花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10398,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王孝伯痛饮读离骚图","author":"郑思肖","text":"名士天生磊落才，只耽痛饮罄樽罍。\n谁传一味解酲法，歌断离骚眼自开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10399,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"许真君飞升图","author":"郑思肖","text":"铁柱遗踪尚俨然，五陵后必出群仙。\n当时谌姆说甚么，四十二人都上天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10400,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙登长啸图","author":"郑思肖","text":"碧眼空空照九州，阮公不是我同流。\n划然长啸谁听得，独有苏门山点头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10401,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王烈餐石髓图","author":"郑思肖","text":"五百年方开此山，寒光浮暖湿而乾。\n明明正是洪濛髓，只恐凡人不肯餐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10402,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"桃源图","author":"郑思肖","text":"长城徭役苦咨嗟，澧水偷春隐岁华。\n有耳不闻秦汉事，眼前日日赏桃花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10403,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"烂柯图","author":"郑思肖","text":"日出樵柴日落归，几年黑白梦纷飞。\n看来直待斧柯烂，始悟老仙棋外机。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10404,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"延平跃剑图","author":"郑思肖","text":"白昼平津涌似雷，尽惊灵物出尘埃。\n倒翻三尺挥空去，对舞双龙破浪来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10405,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陶弘景三层楼听松风图","author":"郑思肖","text":"弘景层楼掉太清，万龙捲翠响泠泠。\n此心不出三界看，一片秋声何处听。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10406,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"文选阁图","author":"郑思肖","text":"太子奢华能几年，尽将春梦付荒烟。\n错听古调一两拍，空嗅斯文数百篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10407,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐明皇游月宫图","author":"郑思肖","text":"玉仗飞行驭太空，须臾径到广寒宫。\n三郎胸次无高见，落眼蟾蜍光影中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10408,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李靖天瓢图","author":"郑思肖","text":"梦里骑龙出八荒，扫空热恼作清凉。\n不消数滴天瓢雨，净洗娑婆透骨香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10409,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王勃滕王阁记图","author":"郑思肖","text":"王勃清才俊不禁，烂铺艳锦赏知音。\n空馀高阁青云里，谁识落霞秋水心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10410,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"狄仁杰白云亲舍图","author":"郑思肖","text":"驻马回头眺碧空，河阳在望去匆匆。\n吾亲虽舍白云下，岂出梁公一念中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10411,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孟浩然归隐图","author":"郑思肖","text":"明主怜才若赐官，奔驰微禄负家山。\n狂吟搔首笑归去，满路秋光上醉颜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10412,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李太白砚靴图","author":"郑思肖","text":"斗酒未乾诗百篇，篇篇奇气走云烟。\n自从捧砚脱靴后，笑看唐家万里天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10413,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杜子美茅屋为秋风所破歌图","author":"郑思肖","text":"雨捲风掀地欲沈，浣花溪路似难寻。\n数间茅屋苦饶舌，说杀少陵忧国心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10414,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"杜子美骑驴图","author":"郑思肖","text":"饭颗山前花正妍，饮愁为醉弄吟颠。\n突然骑过草堂去，梦拜杜鹃声外天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10415,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"子美孔明庙古柏行图","author":"郑思肖","text":"诸葛甘棠岁月深，霜皮黛色郁沉沉。\n尚垂清荫蜀国里，一树风霜千载心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10416,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"韩昌黎祭鳄鱼图","author":"郑思肖","text":"朝奏空言暮远途，蓝关飞雪渍衣裾。\n岂期去国八千里，此意犹能化鳄鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10417,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"柳子厚赋寒江钓雪图","author":"郑思肖","text":"空玄影外渺孤舟，不与渔翁意思侔。\n万顷风涛一天雪，且看谁解下金钩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10418,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"卢仝煎茶图","author":"郑思肖","text":"月团片片吐苍烟，破帽笼头手自煎。\n七椀不妨都吃了，恣开笑口骂群仙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10419,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陆龟蒙茶灶笔床图","author":"郑思肖","text":"笠泽往来无定期，煮茶垂钓醉吟诗。\n一船清致终难画，不是散人应不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10420,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"公孙大娘舞剑图","author":"郑思肖","text":"织手生风搅昼寒，好花翻影艳清欢。\n试看不犯锋铓处，舞碎晴空雪一团。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10421,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张果老倒骑驴图","author":"郑思肖","text":"云是尧时丙子生，狂踪怪迹恣幽情。\n拗驴面目不须看，一任骑来颠倒行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10422,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"张志和渔父图","author":"郑思肖","text":"苕霅春深花满溪，一钩翻动碧琉璃。\n蓑衣箬笠尽有意，不到斜风细雨知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10423,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蓝采和踏踏歌图","author":"郑思肖","text":"踏踏歌中天地开，红颜春树莫相催。\n蓝袍转破转奇特，别看仙人舞一回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10424,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"钟吕传道图","author":"郑思肖","text":"钟吕喃喃手指空，应谈玄牝妙无穷。\n都来造化只半句，不在丹经文字中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10425,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吕洞宾卖墨图","author":"郑思肖","text":"链就玄玄一块金，朝磨暮写愈精神。\n先生此墨初无价，不识谁为买墨人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10426,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"沈东老遇吕洞宾图","author":"郑思肖","text":"东老忘怀相遇时，洞宾烂醉以为期。\n聊题不涉毫端句，早被石榴皮得知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10427,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋苦雨赵知微登天柱峰赏月图","author":"郑思肖","text":"人爱中秋月色同，忽惊凉雨翳昏钟。\n如何只隔一重膜，不见仙家天柱峰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10428,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"南柯蚁梦图","author":"郑思肖","text":"忘了堂堂六尺身，鬼花生艳幻微春。\n绝怜蚁窟无分晓，迷尽古今多少人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10429,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"崔护觅水图","author":"郑思肖","text":"哭断东风转有情，俄惊满面笑容新。\n当时饮水今犹醉，别是桃花半点春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10430,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"倩女离魂图","author":"郑思肖","text":"有心谁怕铁为墙，直透虚空未易量。\n若问合离真伪事，满池绿水笑鸳鸯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10431,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"崔智韬虎妻图","author":"郑思肖","text":"佳人睡觉失青山，恶毒心肠卖笑颜。\n认得皮毛一归去，花枝无艳虎全斑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10432,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉川长须赤脚图","author":"郑思肖","text":"惯立煎茶屋角头，低眸频候雪花浮。\n一奴一婢亦作怪，不为先生破屋愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10433,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陈抟睡图","author":"郑思肖","text":"五季干戈乱似麻，慵将醒眼阅年华。\n齁齁一觉华山里，谁问春开几度花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10434,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"苏东坡前赤壁赋图","author":"郑思肖","text":"泛舟赤壁痛衔杯，孟德英豪安在哉。\n何似江山风月妙，不从自己外边来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10435,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"李伯时所画太一真人莲叶舟图","author":"郑思肖","text":"太一真人妙出神，聊乘莲叶下南冥。\n若人欲识空凉境，但诵薰风一卷经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10436,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"无名氏巡檐数修竹图","author":"郑思肖","text":"四檐玉立碧重重，终日相看眼亦空。\n何啻数来千万个，不知那个弄清风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10437,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其一","author":"郑思肖","text":"有时业一笑，清于万壑冰。\n有时吐一语，浊于三月春。\n所以天地閒，不著如是人。\n任之波波走，永劫长沉沦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10438,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其二","author":"郑思肖","text":"昔有古先生，忒杀不唧溜。\n拈得一枝花，失却一张口。\n白昼叫不醒，徒尔打筋斗。\n若欲了此意，但饮一杯酒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10439,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其三","author":"郑思肖","text":"晚年阖闾国，侨寓陋巷屋。\n屋中无所有，事事不具足。\n终不借人口，伸舌觅饭吃。\n以此大恣纵，骂人笑吃吃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10440,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其四","author":"郑思肖","text":"山中一溪水，绝与众水别。\n不解饮清风，只解醉明月。\n一片清泠意，活动流不彻。\n何劳濯缨人，再三苦饶舌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10441,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其五","author":"郑思肖","text":"我家南山南，日月最相爱。\n清光泼面来，只是无人买。\n我昔买淂之，翻手恣买卖。\n山北诸草木，也只得礼拜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10442,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其六","author":"郑思肖","text":"佯狂真佯狂，踏碎东风影。\n一任东风吹，花意乱不定。\n闹闹人丛中，人人唤不应。\n借问老先生，莫教是姓郑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10443,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锦钱馀笑 其七","author":"郑思肖","text":"头戴烂纱巾，脚踏破鞋底。\n不知以何道，琮琤宇宙里。\n或恐是达人，毋乃是痴子。\n我亦欲问之，面冷似铁鬼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10444,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]