[{"title":"江上送友","author":"仇远","text":"知尔怀亲忆故州，相逢沽酒且迟留。\n夕阳有恨荒荒白，江水无声泯泯流。\n孤鸟出潮投渚尾，野芦飞雪压船头。\n却愁明月中秋近，不得同登庾亮楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":436,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江阴何仲礼相访和答","author":"仇远","text":"月照空梁几梦中，翩然环佩下天风。\n十年不到澄江上，一棹能来濑水东。\n湖海交游今渐少，英豪见识略相同。\n旧时东野吟诗处，何日携壶酹此翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":437,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"约山中友","author":"仇远","text":"望极秋空无片云，前山历历见遥岑。\n新鸿渐到边城静，旧雨不来汀草深。\n仙李有时曾入梦，伯桃死后少知心。\n如君真是忘机者，海上鸥盟便可寻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":438,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"自爱","author":"仇远","text":"金渊岂爱我，我自爱金渊。\n似蜜醪尤美，如珠米更圆。\n携家踰八口，窃禄又三年。\n书册盈归箧，毋嫌载月船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":439,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至日用张伯举韵","author":"仇远","text":"博士无毡卧冷斋，有朋喜自远方来。\n腊前一信春先到，陇首数枝梅已开。\n少忍年荒须辟谷，尚迟酒禁且衔杯。\n山中茅屋不归去，空想秋风暗绿苔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":440,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至日怀罗国宾 其一","author":"仇远","text":"官冷谁能送酒钱，江乡节物倍萧然。\n容颜一日老一日，人事一年经一年。\n野仆竹舆侵晓出，病妻布被抱愁眠。\n甘心归隐青岩下，閒共残农理废田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":441,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至日怀罗国宾 其二","author":"仇远","text":"群阴剥尽一阳回，霜日烘晴宿雾开。\n闭户读书差自乐，载肴问字莫须来。\n荣枯易了观芸草，冷暖相忘付酒杯。\n得似山居酬应少，昼长閒坐看寒梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":442,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至后 其一","author":"仇远","text":"凭高欲验晓云黄，东际红光见太阳。\n便觉池芹春滟滟，俄惊檐竹昼琅琅。\n君师百拜恩难报，文史三冬志未偿。\n吾道千钧悬一缕，愿同绣线日添长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":443,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至后 其三","author":"仇远","text":"霜华如雪著乌巾，染鬓粘须白未匀。\n人羡久生趋老境，日随长至到新春。\n投金濑上能容我，贡玉堂中自有人。\n溧酒清醇鱼菜美，不妨频日宴嘉宾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":444,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至后 其二","author":"仇远","text":"阳和昨夜到梅边，喜得春风一信传。\n同舍团栾齐贺岁，异乡飘泊又经年。\n梦中归路忘舟楫，客里生涯倚俸钱。\n纸帐布衾差稳睡，不愁独冷坐无毡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":445,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"至后 其四","author":"仇远","text":"了知五十九年非，景薄崦嵫合见几。\n夜半虽当泉脉动，腊前未见雪花飞。\n客程鸿雁骎骎老，家养鸡豚处处肥。\n千日及瓜今过半，未知何日定言归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":446,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"观雨","author":"仇远","text":"雨师殿后疾雷先，风捲浮云似擘绵。\n大点成沤添黑潦，浓阴匝地暗青天。\n崦中暴长弥漫水，圩上平沉沮洳田。\n米直顿增车戽急，早推红日丽金渊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":447,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过介卿溪南隐居","author":"仇远","text":"卜宅溪南远市喧，一经教子守田园。\n邵平未老瓜先熟，靖节能閒菊自存。\n无白丁来多酿酒，放青山入别开门。\n朝衣曾侍天香满，得似荷衣带露痕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":448,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"过李山人居","author":"仇远","text":"数椽竹屋傍秋江，屋外疏篱隔柳桩。\n客至旋分垂钓石，雨来自掩读书窗。\n痴儿弄镜时翻背，小妇弹筝不识腔。\n自古渔樵有遗逸，未应只说鹿门庞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":449,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"问赵元父病","author":"仇远","text":"裹饭无因绝往还，惟应帖子报平安。\n山公马向花前放，岐伯书从枕上看。\n贸易近来多北药，支持强欲著南冠。\n有时泥醉西园月，只欠梅花共倚阑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":450,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"何山","author":"仇远","text":"溪转峰回一径平，田头白水照人清。\n寺因何氏封山姓，客把坡诗證地名。\n萝月长随行道影，杉风犹带读书声。\n云津桥下潺湲急，僧濯袈裟客濯缨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":451,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冷坐","author":"仇远","text":"冷官宜静坐，借屋近荒村。\n无酒可延客，未昏先闭门。\n水明知月上，木落见梅尊。\n满目凄凉者，相逢不必言。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":452,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初冬郊行 其二","author":"仇远","text":"懒向南园拜石兄，肯寻村叟傍溪行。\n黄云覆亩金穰熟，白露横江红叶明。\n彭泽归来辞内景，康衢击壤曲中声。\n一丁不识多牛者，应笑书田事笔耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":453,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"初冬郊行 其一","author":"仇远","text":"喜闻颍弟与坡兄，趁小春晴野外行。\n独树荒村生处僻，落霞孤鹜去边明。\n豳风酒食归田乐，韶部埙篪打稻声。\n从此广文差饭足，素餐祇愧老农耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":454,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"利交","author":"仇远","text":"一自仪秦去，从衡直到今。\n士缘贫失节，交以利知心。\n乍可昏求火，何堪昼见金。\n狂澜回已倒，犹幸有山林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":455,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"君子堂小集","author":"仇远","text":"乐岁欣逢节序新，公堂称兕集嘉宾。\n衣冠尚想江东旧，芹藻初回泮水春。\n无事聊为文字饮，相看总是老成人。\n且须饱吃圭田饭，朝市山林各致身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":456,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴成季尊师与其弟元初会于维扬即还金陵成季寄诗因和","author":"仇远","text":"初平兄弟总神仙，化石为羊入上天。\n万里相期云上下，一江不隔水渊潫。\n对床夜雨吟诗烛，归棹春风载酒船。\n此是人生真乐事，岸花汀草意无边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":457,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈王元亨佥事","author":"仇远","text":"三槐郁郁德之符，喜向金渊识大儒。\n早读父书明体用，夙将使指厉廉隅。\n动摇山岳威犹在，收敛风霜寂似无。\n人道鲁公来辨狱，行看霖雨泽焦枯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":458,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈王达之御史","author":"仇远","text":"西晋文章伯，南台法令师。\n常因行部日，记得从游时。\n敏手除三害，贞心畏四知。\n何由侍王导，挥麈话襟期。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":459,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈王直卿御史","author":"仇远","text":"金渊宝地阅金经，朝夕追随骢马行。\n激浊扬清真御史，即温听厉老先生。\n衣冠文物今无几，车笠交游最有情。\n早愿明时相司马，他年洛社会耆英。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":460,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"巫云九峰","author":"仇远","text":"谁割巫山一片云，峰峦罗列比儿孙。\n嵌空自是天生穴，剥蚀无非水渲痕。\n霜削秋清连竹色，露腴晓翠及蒲根。\n九峰九锁参差似，永镇仇溪第一村。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":461,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀方严州 其一","author":"仇远","text":"八十一年前，科名已袖然。\n依刘王粲檄，入洛贺循船。\n受禅碑谁上，閒情赋自传。\n江山英气歇，堪恨亦堪怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":462,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀方严州 其二","author":"仇远","text":"八十一年终，堪嗟旅衬穷。\n胸中元耿耿，身外竟空空。\n白首太玄草，紫阳虚谷翁。\n平生有遗恨，五马未乘骢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":463,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀方严州 其四","author":"仇远","text":"八十一年身，栖迟客馆贫。\n登门曾有我，铭墓竟何人。\n醉梦高楼月，悲歌故国春。\n可能函玉骨，归葬练溪滨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":464,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀方严州 其三","author":"仇远","text":"八十一年亡，哀哉老紫阳。\n佳儿方戒道，小妾漫专房。\n每忆先生被，常怀太守章。\n桐江诗万首，端可及龟堂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":465,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀古","author":"仇远","text":"吹杀青灯炯不眠，满衿怀古恨绵绵。\n江东曾识桓司马，沧海难追鲁仲连。\n吴岫月明吟木客，汉宫露冷泣铜仙。\n何时一酌桃源酒，醉倒春风数百年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":466,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀张似之","author":"仇远","text":"少日登山屐，中年上水船。\n黄花犹自绿，白发若为玄。\n但觉杯行速，那知帽影偏。\n南峰深秀处，回首重潸然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":467,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怀盛元仁","author":"仇远","text":"年过耳顺欲何如，臂膝酸寒齿发疏。\n千里驱驰还倦矣，数椽卜筑合归与。\n山衔落日谁能系，海涨平田自可锄。\n寄语虎林诸道伴，江湖处处有鲈鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":468,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒步","author":"仇远","text":"村径桑麻合，扶筇信所之。\n绿阴晴冉冉，白日步迟迟。\n野茧粘高树，山雌入破篱。\n岂无款段马，常是小儿骑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":469,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陆君实挽诗","author":"仇远","text":"乾坤那可问，至痛老臣心。\n甘抱白日没，不知沧海深。\n忠魂随上下，义骨肯浮沈。\n草木长淮泪，秋风起莫阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":470,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陈明远书塾与蒋平仲张伯成清话","author":"仇远","text":"霜晴泛渚狎轻鸥，人物欣逢古太丘。\n乔木故家犹昨日，寒花老圃正清秋。\n尊开北海心先醉，烛尽西窗话不休。\n笑我一身閒未得，又随新雨上归舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":471,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饮陆静复山房分韵得时字","author":"仇远","text":"连辔行春自作期，寻芳却笑我来迟。\n三杯云液花前酌，一曲琼箫竹下吹。\n沧海桑田非旧日，石泉槐火有新诗。\n山中道士閒于鹤，门外红尘总不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":472,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野四首 其四","author":"仇远","text":"诡遇非吾事，支离笑我身。\n文章宁可拙，仕宦岂宜贫。\n乡故多新鬼，年荒少佚民。\n休嗟华黍废，阳谷易回春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":473,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野四首 其三","author":"仇远","text":"亨涂即畏涂，暮境欲何如。\n索米多贫士，钞诗欠小胥。\n自缘乡梦熟，顿与世情疏。\n会约逃名者，山间倒跨驴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":474,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野四首 其二","author":"仇远","text":"穷冬霜霰集，行路古今难。\n举眼看浮世，何人耐岁寒。\n弃瓢将止酒，脱冕拟休官。\n一室能容膝，吾生亦易安。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":475,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野四首 其一","author":"仇远","text":"旅食无生计，卑栖奈若何。\n饭惟供脱粟，衣未补香莎。\n户外履常满，床头金不多。\n老为文学掾，一似旧恩科。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":476,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野郊居见寄 其一","author":"仇远","text":"知君标格眼前稀，暂别令人入梦思。\n铗有可弹何必叹，书如肯借本非痴。\n且看平子归田赋，更和渊明述酒诗。\n我劝山中多种漆，收功莫恨十年迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":477,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野郊居见寄 其二","author":"仇远","text":"论心握手到忘形，性癖耽诗各瘦生。\n美酒三升差可恋，良田二顷不如耕。\n溪晴正熟眠鸥梦，门静那惊吠犬声。\n泉石烟霞能自乐，弃予高举得无情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":478,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野郊居见寄 其四","author":"仇远","text":"因子洮湖归钓鱼，西湖我亦念吾庐。\n途穷但觉知心少，性直由来料事疏。\n爱把琴弹招隐操，忍拈笔写绝交书。\n人间喜怒须臾事，暮四朝三任众狙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":479,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和子野郊居见寄 其三","author":"仇远","text":"归去来兮意趣长，幽居远隔水云乡。\n花粘石几吟诗笔，风度溪房煮药香。\n把酒有时思太白，下车何日见元方。\n云萍暂聚还分散，可是先生铁石肠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":480,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和卞仲祥","author":"仇远","text":"我爱中秋月，行歌荒野中。\n乱云催薄暮，乔木易高风。\n镜里花难折，樽中酒不空。\n南飞有乌鹊，未见北来鸿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":481,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和友人洮湖韵","author":"仇远","text":"落日洮湖自放舟，诗筒特为寄交游。\n征夫独寐难为夜，老我多愁不但秋。\n清兴何人联石鼎，虚名无梦到金瓯。\n黄鸡白酒田家乐，止有躬耕愿未酬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":482,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和友人韵","author":"仇远","text":"山林空入梦，诗酒未忘怀。\n老兴自不浅，卿言亦大佳。\n封侯无骨相，学道有心斋。\n安乐行窝在，栖栖且避乖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":483,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和仲祥大风韵 其二","author":"仇远","text":"非雨非雷势可乘，柔枝弱叶力难胜。\n疾于健将追奔马，豪似吟仙赋大鹏。\n柱砥潜移黄蚁穴，山屏尽启白云縢。\n直须少霁飞廉怒，水落圩田谷再登。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":484,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和仲祥大风韵 其一","author":"仇远","text":"正忧蕴蕴与隆隆，怪得连朝起大风。\n酷日从今宜敛暑，大王自古解称雄。\n中庭老树吹将折，破屋重茅卷已空。\n可是南溟茝欲化，爰居先避鲁门东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":485,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和刘君佐韵寄董静传高士","author":"仇远","text":"雪暗江湖入暮年，何人苇外小延缘。\n水痕不动玉平岸，春意欲回花满天。\n懒出恐消桐屐蜡，醉吟忘上苧袍船。\n行当归学林和靖，结屋梅根伴鹤眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":486,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和西仲秋日闻莺诗","author":"仇远","text":"不待风霜剪碧林，柳阴忽见一梭金。\n似传西帝宸游信，空惹东窗梦觉心。\n暂辍笙歌聊试听，既无桃杏莫须吟。\n旧交燕子归何处，好倩宾鸿为嗣音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":487,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和两山二首 其一","author":"仇远","text":"世事枰棋入角危，有人袖手只攒眉。\n路通巴蜀那须檄，马立澶渊更要诗。\n公竟醉耶从汝笑，树犹如此信吾衰。\n传闻双珥消兵气，犹把葵心向郁仪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":488,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和吴东升","author":"仇远","text":"知君豹隐白云村，杖履春风忽过门。\n独立幸无妻子累，老成喜有典型存。\n冰悬古树花尤隽，雪涨寒江水不浑。\n冷落十年灯火读，何时窗下约重温。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":489,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和张辅之赠别","author":"仇远","text":"夜雨溪头泊客船，檐花沟溜亦涓涓。\n灯前诗酒留三宿，纸上功名付百年。\n寒雁叫霜投木末，晴云扶日出山巅。\n欲归苦被微官缚，不得相从酌冷泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":490,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和范爱竹三首 其二","author":"仇远","text":"秉烛追游忆盛时，欢悰终较昔年稀。\n柳多客折凉阴薄，薇少人餐雨绿肥。\n胡蝶觉来方识梦，海鸥飞去未忘机。\n相逢且可谈风月，莫话兴亡与是非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":491,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和南仲见寄 其二","author":"仇远","text":"我本西湖一散人，偶来溪上濯乌巾。\n波光绿映台城柳，山色青回句曲春。\n客舍相亲那忍别，交情到老愿如新。\n江南天气偏宜暖，满目东风起曲尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":492,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和南仲见寄 其一","author":"仇远","text":"儒冠误我欲投簪，抱膝聊为陇上吟。\n故里未归先入梦，新交虽好少知心。\n清光湛湛溪中月，遗迹沉沉濑底金。\n闻道雪晴丰荠麦，行看放犊满桃林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":493,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和胡定甫 其一","author":"仇远","text":"几年野水倚扁舟，风雪尘埃暗绮裘。\n齐鲁青山恒北望，江湖白鸟共东流。\n杜陵骑马寻征路，李白题诗遍酒楼。\n文学卑官何足说，直须揽辔觅封侯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":494,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和胡定甫 其二","author":"仇远","text":"淡泊相逢古溧州，世情客况两悠悠。\n腐儒都不通人事，冷掾何曾似宦游。\n轻薄成风虽可畏，廉勤律己每无愁。\n他时重会西湖上，把酒联诗日自由。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":495,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和费廷玉 其一","author":"仇远","text":"我昔南徐讲席分，知君肥遁白云村。\n草深能使芝兰没，木落方推竹柏尊。\n试问上书投魏阙，何如解组守衡门。\n西风吹醒槐安梦，斜日悠悠半隐垣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":496,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和费廷玉 其二","author":"仇远","text":"笑人狗走鹿斯奔，父子瓜畦手自耘。\n不愿青黄施断木，且将苍白看浮云。\n山巾聊友华阳鹤，野饭时羹古涧芹。\n显宦何如廉贾好，茜卮千石鲚千斤。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":497,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和曹之才","author":"仇远","text":"山林不可住，欲隐更何之。\n春去已多日，客愁无了时。\n斜阳依树下，明月到门迟。\n閒事谁消遣，陶潜一卷诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":498,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]