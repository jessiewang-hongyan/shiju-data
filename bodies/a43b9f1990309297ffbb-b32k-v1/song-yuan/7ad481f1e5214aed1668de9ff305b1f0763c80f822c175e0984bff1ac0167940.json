[{"title":"送林一甫试浙漕二首 其一","author":"陈杰","text":"关防秋暑双蕉叶，商略时宜十兔毫。\n赠别不须嗔语浅，如君正复坐名高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6574,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻须溪坐午谢客用所寄绝句韵叶宋英先容","author":"陈杰","text":"日晏到门三斗尘，隔帘午暝托朝真。\n乘肩鼻涕关何事，试看斤风向郢人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6575,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夕对梅花烛花二首 其二","author":"陈杰","text":"顷刻开花剪复成，大如菡萏小朱樱。\n一年岁事占来日，知为先生报晓晴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6576,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夕对梅花烛花二首 其一","author":"陈杰","text":"花与先生共岁寒，坐来不管漏声残。\n移瓶更转横枝影，贴在窗扉作画看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6577,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽周溪园国史三首 其三","author":"陈杰","text":"钜笔曾编两大藩，江山如画朔风酸。\n如何地下修文手，还要南朝旧史官。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6578,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽周溪园国史三首 其二","author":"陈杰","text":"一瞬风云宇宙新，一家中外几朱轮。\n归来却就千钟养，赢得深衣处士身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6579,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽周溪园国史三首 其一","author":"陈杰","text":"壮岁高科晚一麾，江涛如此幅巾归。\n书生何限经纶意，曾共危阑送落晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6580,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"柴桑图","author":"陈杰","text":"消磨甲子门前柳，傲睨羲皇膝上桐。\n晋宋一杯无认处，先生万古此山中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6581,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"浙江潮","author":"陈杰","text":"只道潮声落，潮来复有声。\n何当机事息，暂遣海门平。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6582,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"破屋","author":"陈杰","text":"江头风雨连年恶，破屋惊秋复惜春。\n天上金瓯足时栋，人间白发是閒身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6583,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读书三首 其三","author":"陈杰","text":"汝以为多学，吾犹及阙文。\n忧端已秦誓，糟粕尚三坟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6584,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读书三首 其二","author":"陈杰","text":"书初说包贡，礼有献民虏。\n末流尚忍闻，作俑叫千古。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6585,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读书三首 其一","author":"陈杰","text":"画前逃弧马，井法开赋役。\n圣人本仁民，何意重利蹠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6586,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其十","author":"陈杰","text":"故园三亩淡生涯，雨横风狂缩似蜗。\n从此亦称萧相客，合无稳种邵平瓜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6587,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其九","author":"陈杰","text":"释老新来各有宗，四民最惜一民穷。\n挽回世道能无在，主张斯文尽属公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6588,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其八","author":"陈杰","text":"诏旨丁宁画一颁，尽驱黠吏革贪官。\n若行两事无他事，民命那无一线宽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6589,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其七","author":"陈杰","text":"南北风殊久未谙，乱离更值旱如惔。\n斗升试酌西江水，应有汤年一溉甘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6590,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其六","author":"陈杰","text":"上都仁问远如天，人望公来望岁然。\n正有郇模三十字，含毫欲愬复难宣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6591,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其五","author":"陈杰","text":"世变峥嵘可奈何，鱼龙杂袭故应多。\n风休云定须臾事，惟有高贤炯不磨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6592,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其四","author":"陈杰","text":"兵前创建教条新，鞍马丛中玉雪身。\n揭起先牌一廉字，十州草木亦回春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6593,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其三","author":"陈杰","text":"悃愊无华忧世深，十诗直写古人心。\n也教穷谷敲推士，一识中原正大音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6594,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其二","author":"陈杰","text":"河洛声名莽旧墟，百年消息孕真儒。\n南方只道足文史，今见北方行秘书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6595,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾鹿泉屡约一出小诗代行十首 其一","author":"陈杰","text":"故家文献世公台，直为遗黎万里来。\n应念颠崖最辛苦，更移鄂省近南开。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6596,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"博弈观人二首 其二","author":"陈杰","text":"等閒移作塞，郑重喝成卢。\n莫看文怀瘦，胸吞几寄奴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6597,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"博弈观人二首 其一","author":"陈杰","text":"西军严驾后，北府捷书前。\n胜负岂人与，两公天已全。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6598,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寒梦","author":"陈杰","text":"寒梦初回斗帐深，清辉忽破小窗阴。\n若为推上松萝月，展尽梅花一寸心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6599,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬别孙道人存心归上饶二首 其二","author":"陈杰","text":"短些几回无寄处，一声归鹤落江东。\n两行老泪千年恨，问讯骑鲸太白翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6600,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬别孙道人存心归上饶二首 其一","author":"陈杰","text":"消得刚风三日夜，吹开正色泬寥天。\n苏门月朗君长啸，太华云高我昼眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6601,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题子胥庙","author":"陈杰","text":"吴以让长国，让亡吴亦随。\n属镂天讨贼，鱼剑祸阶谁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6602,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题汤隽溪留远法师莲社图","author":"陈杰","text":"无复斯人过虎溪，溪上朝朝新虎蹄。\n江左风流却回首，几曾极乐在天西。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6603,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题老杜巡檐索笑图","author":"陈杰","text":"茫端寒燠关生物，一粲疏花可得禁。\n香影天机行世浅，风骚古思不言深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6604,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题和靖祠","author":"陈杰","text":"欲将心事梅边说，放鹤经年去不还。\n寒日碧云无限意，却成喑哑对湖山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6605,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题驿壁","author":"陈杰","text":"骅骝捕鼠不如狸，镆干缀履不如锥。\n过都历块成何事，剸虎裁蛟彼一时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6606,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题宣和御画芦禽","author":"陈杰","text":"芦边晚吹冷飕飕，背立孤禽有许愁。\n可是殿庭无事笔，已含原野十分秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6607,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题梅坛毛庆甫道士云悦楼","author":"陈杰","text":"白衣苍狗无情物，翻手悲欢变古今。\n输与道人长快活，看渠起灭不关心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6608,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题傅道士鹤鸣泉","author":"陈杰","text":"梦回华表千年远，思入庐山三叠寒。\n绿发道人知许事，山中自写鹤泉看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6609,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠玉壶相士","author":"陈杰","text":"黄金取印斗来大，白玉作壶冰样寒。\n子号甚清堪自照，吾诗愈淡欲谁看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6610,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠冰月相士","author":"陈杰","text":"十年已往如冰冷，千载方来似月明。\n唐许何尝关世事，人间正有一书生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6611,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠徐先辈星命课","author":"陈杰","text":"三命横铺下点星，风雷歘起斗牛灵。\n正堪持献云霄士，不中山间倦客听。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6612,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠熊易课","author":"陈杰","text":"宿雨初收水满村，断桥千事不相闻。\n隔篱试写流年影，手种山田熟几分。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6613,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"乙丑元日寿昌拜表","author":"陈杰","text":"盛服黎明起，瞻天咫尺东。\n舒迟寅出日，清淑艮来风。\n阴尽恰亭午，景长疑再中。\n初元调玉烛，勉勉圣神功。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6614,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"人日立春极寒","author":"陈杰","text":"綵鞭点雨斧如雷，头上顽云打不开。\n冬序方随人日尽，春愁却载土牛来。\n几多漕运留冰解，何限耕桑要暖回。\n惟有上林花自早，天公羯鼓更频催。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6615,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十二月二十六日蔡叔庸至剪烛听雨","author":"陈杰","text":"水气昏昏接海边，清江狂客系吴船。\n天风十日河冰碎，夜雨三更瀑布悬。\n寂寂春光归柳上，匆匆离色在花前。\n故人著屐能相过，剪烛西窗话昔年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6616,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"又登南楼","author":"陈杰","text":"缥渺层峦出画阑，半空长锁白云閒。\n一弓斜摺蜀江水，八字平分汉渚山。\n眼入中原鸿去迥，手摩华表鹤飞还。\n好天谁遣成南北，遗限悠悠落照间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6617,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"三朝书窗","author":"陈杰","text":"爆声唤醒鼻中雷，宿溜初停晓色开。\n云落小须新日上，雪消剩放好春回。\n老人自写题门帖，稚子先尝得岁杯。\n明暖一窗聊引笔，东风折尽胆瓶梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6618,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"与节东归和同幕送行之作","author":"陈杰","text":"来参军事久无功，宜黜而升愧在中。\n揽辔登车宁有是，过家祭灶略相同。\n送人万里鸥波白，回首千山骑火红。\n待得故园高卧日，诸君剑佩一时东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6619,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大享先玄酒","author":"陈杰","text":"大享先玄酒，嘉宾贵食蒿。\n不无笾豆实，正有涧溪毛。\n岁未登三釜，家安取百牢。\n充庭君试数，一一是民膏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6620,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大阃拨醅于园亭坐上文武各半恰西师捷至用同官韵","author":"陈杰","text":"花气深迷院，湖光曲抱城。\n浅春烽火暇，细雨笑谈清。\n舁瓮看浮蚁，飞书报斩鲸。\n渔阳回席处，半著鲁诸生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6621,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寸禄","author":"陈杰","text":"同游鼎贵佩鸣珂，寸禄中年不啻过。\n方朔犹须设非有，爰丝正可饮无何。\n山前华表书官大，江上邮亭送使多。\n草草百年勋业梦，插天浯石未曾磨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6622,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山村","author":"陈杰","text":"乔木藏村古，枯藤取径微。\n落红随蜡屐，空翠近荷衣。\n抱瓮云间出，吹箫月下归。\n桃源吾酷慕，何必此间非。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6623,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山居","author":"陈杰","text":"深僻山居自在身，似僧有发俗无尘。\n读残贝叶都忘世，看足梅花不要春。\n啧啧树间黄口小，悠悠道上白头新。\n足非何与先生事，閒倚枯藤一欠伸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6624,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中兴事迹","author":"陈杰","text":"瑶编每读愤填膺，始末权奸托罢兵。\n初渡已诛双烈士，小吏更坏一长城。\n齧毡大老投荒死，借剑孤忠窜岛生。\n长与东南羞汗简，更堪西北望神京。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6625,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中斋生朝","author":"陈杰","text":"当家勋阀旧巍煌，天女裁云为制裳。\n胸饱治朝周典礼，箧馀内苑汉词章。\n经行禾黍关河远，指点蓬莱日月长。\n故国风流一回首，不妨鸾玉小徜徉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6626,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"予以甲寅冬过弋阳石桥戊辰正月重过","author":"陈杰","text":"周行淮汉万山川，重此经过十五年。\n野老眉间新世事，蹇驴背上旧吟鞭。\n几分春色梅花后，一片归心杜宇前。\n深谷有人难问信，石桥倚遍晚晴天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6627,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五日江亭即事","author":"陈杰","text":"五日江城因远望，画桡不动美哉洋。\n人间昌歜谁同嗜，地下离骚只自香。\n折得玉蕖冰照坐，飞来鸥鸟雪为裳。\n一番节物忙收拾，客舍题诗生晚凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6628,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元旦南郊庆成","author":"陈杰","text":"熙朝政化谨三元，有事郊南典礼全。\n嗣圣万年初见帝，小臣十起夜瞻天。\n想回玉辂红云晓，更揭金鸡暖雨前。\n但愿庆成天下福，赋诗岂必从甘泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6629,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元宵","author":"陈杰","text":"老去何心说看灯，一年还要此宵晴。\n暖风忽断檐间溜，繁吹初过枕上声。\n谁变惨悽成笑语，定回离乱作清平。\n不应淡薄梅花月，偏照诗人白发生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6630,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天人","author":"陈杰","text":"天上分明暗，人间浪喜嗔。\n及鱼殃本妄，得马福非真。\n酒薄还围赵，渠成适利秦。\n圣贤惟任道，两不系天人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6631,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天基节特晴","author":"陈杰","text":"东风特地奇，阁雨放朝曦。\n历数归仁寿，乾坤表诞弥。\n愿敷皇极福，重立太平基。\n忠爱无疏贱，新年第一诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6632,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"太上务德","author":"陈杰","text":"太上务为德，后来纷立言。\n谁非托邹鲁，宁复得羲轩。\n吾爱黄叔度，人称李仲元。\n典刑如可作，庶用约文烦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6633,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孔明","author":"陈杰","text":"千载生诸葛，馀才了十丕。\n百年巴蜀佐，三代渭滨师。\n礼乐无兴日，乾坤有闰时。\n空留文字在，不愧说兼伊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6634,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"斗牛山登高","author":"陈杰","text":"佳节一消忧，携壶上斗牛。\n乾坤有今日，江汉自东流。\n乱后不多菊，看来无限秋。\n凭高未能已，更为夕阳留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6635,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见邸报","author":"陈杰","text":"正徯朝阳听凤鸣，忽传鹈鴂作秋声。\n百年事会纷成毁，一日光阴屡晦明。\n张霸安能识时务，翟公久自见交情。\n人间快意真难待，茅屋看山了此生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6636,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"风沙","author":"陈杰","text":"清野风沙觉更长，谪仙此日尚能狂。\n一株残柳专春事，两箔颓篱共夕阳。\n过鹢去空江浪白，归鸿没尽塞云黄。\n酒醒何处吹羌笛，未省吴儿有石肠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6637,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东湖","author":"陈杰","text":"重游如隔世，露雨暗池台。\n蓬岛又浅水，昆明几劫灰。\n苍鹅飞底去，白雁集何来。\n万古南州土，荒祠一造哀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6638,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东湖夜坐松间","author":"陈杰","text":"夜深仍露坐，湖曲小迷藏。\n松月半身影，藕花三面香。\n虽忘入城府，终拟卜林塘。\n何日清逋贼，妖星渐不芒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6639,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬至摄献于郊","author":"陈杰","text":"夙驾恭深诏，圆坛俨博临。\n献班公位亚，册捧帝书钦。\n星象开明曜，神灵毕顾歆。\n极知祈永命，犹愿戒难谌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6640,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬晴散步","author":"陈杰","text":"入夜朔风烈，出门黄叶深。\n霜曦开畅月，雪蘤动阳林。\n冬暖儿童色，时和父老心。\n百年吾此日，乘健数经寻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6641,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"出关和雷侍郎送行无魔不成佛观过始知仁之句","author":"陈杰","text":"事来思烂熟，罪去得深循。\n天壤嗟微义，风霜本至仁。\n十年江社梦，一道雪梅春。\n回首无他嘱，当言莫爱身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6642,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"出郊","author":"陈杰","text":"飞盖笼晴昼，行厨帐远林。\n柳塘风度絮，花径日移阴。\n翠袖穿红迥，清歌绕绿深。\n独将衰晚意，危坐数云岑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":6643,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]