[{"title":"和黄晋卿金陵见寄","author":"仇远","text":"台城为客久，书札竟寥寥。\n山水舟车近，风霜岁月遥。\n穷猿犹择木，威凤合冲霄。\n曾有论文约，应须折简招。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":499,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜闻秋声","author":"仇远","text":"西南振响使人惊，未必秋声作此声。\n万骑奔驰鼙鼓动，千夫翻踏桔槔鸣。\n初疑潮汐还疑雨，只在山林不在城。\n人道今年丰稔兆，灯前起舞待天明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":500,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"奉寄田上人","author":"仇远","text":"竹筇轻健草鞋宽，野外消磨半日閒。\n病叶已霜犹恋树，片云欲雨又归山。\n灯分寺塔晴偏见，水隔渔家夜不关。\n愧我莫如霜上鹭，霎时飞去便飞还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":501,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"官冷","author":"仇远","text":"不负平生下泽车，宦游卜宅亦村墟。\n家贫累重须干禄，官冷身閒可读书。\n高柳每闻莺娅姹，破篱时度竹萧疏。\n西南林壑堪娱晚，静看飞云自卷舒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":502,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"抱膝","author":"仇远","text":"抱膝坐终日，澹然忘是非。\n纵令官未满，已与世相违。\n古道平芜合，谁家新燕归。\n年荒烟火歇，空老一山薇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":503,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"明朝","author":"仇远","text":"秋风袅袅雨潇潇，兀兀郊居出市遥。\n未欠三杯通大道，且欣九日是明朝。\n篱边旧菊犹堪摘，天末新鸿不可招。\n莫恨登高无脚力，强支湘竹造山椒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":504,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"朋酒","author":"仇远","text":"朋酒朝朝乐，乡心夜夜愁。\n朱云难作吏，宋玉易悲秋。\n陵谷何曾改，田园未可求。\n南来几鸿雁，亦为稻粱谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":505,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"畅师同玉上人游茅阜 其一","author":"仇远","text":"朝辞二竺寺，暮宿三茅峰。\n红树落一叶，白云深几重。\n远游喜无雨，清兴尤宜冬。\n遥知天坛上，会与仙人逢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":506,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"钓鳌亭","author":"仇远","text":"俯瞰秦淮水，前瞻鲁泮宫。\n明知倚阑者，不是钓鱼翁。\n古石棱棱长，春潮脉脉通。\n状元真宰相，千古一吴公。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":507,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨","author":"仇远","text":"才放庚申一日晴，天明一日雨如倾。\n乌云覆地阴阴合，白浪侵田滟滟平。\n屋漏未乾连础润，桥低欲压碍舟行。\n桔槔不是閒家具，会听溪边鹅鹳鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":508,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨馀","author":"仇远","text":"两两鸣鸠语画檐，雨馀芳草欲生烟。\n瓮头酒熟常留客，象外诗成颇类仙。\n扬子有才犹执戟，渊明无事合归田。\n地偏时事人传少，收拾琴书且醉眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":509,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨坐 其一","author":"仇远","text":"梅霖寒似麦秋天，风葛凄凄未脱绵。\n金弹落池卢橘熟，红裙委地石榴鲜。\n汨罗遗恨空千载，濑水閒居尚一年。\n蒲酒相邀须径醉，归寻枕席付高眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":510,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨坐 其二","author":"仇远","text":"两年蒲节雨霏微，误我中山采药期。\n骑马出门随所寓，看花酌酒复奚疑。\n量悭未易胜金盏，臂弱犹堪系綵丝。\n追忆侯家陪宴赐，素纨红葛翠交枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":511,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"南仲以潘老句约赋","author":"仇远","text":"秋声浩荡夜凄凉，却喜田家熟稻粮。\n千里江湖随薄宦，满城风雨近重阳。\n菊花渐拆青青蕊，桂树独飘粟粟香。\n幸是催租人未至，尊前聊为足成章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":512,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宦海","author":"仇远","text":"黄帽棕鞋隐者便，青衫槐笏我家传。\n一生碌碌空多事，六帙骎骎欠二年。\n安乐窝中閒有味，温柔乡里老无缘。\n浮沉宦海终非愿，早葺山南屋数椽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":513,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"拜孙花翁墓下","author":"仇远","text":"水仙分地葬诗人，一片荒山野火焚。\n荐菊有亭今作圃，埽松无地漫留坟。\n蜗牛负壳黏碑石，老鹳携雏入陇云。\n欲把长箫歌楚些，却怜度曲不如君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":514,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"拜霞屿待制伯祖墓下","author":"仇远","text":"难寻华表与丰碑，三尺坟台山四围。\n翁仲多年苍佩剥，子孙寒食纸钱稀。\n瘦藤拔地长蛇走，灌木维垣野鼠肥。\n远也久违乡族去，忍将椒酒酹斜晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":515,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"树叶","author":"仇远","text":"不知何树叶，红润极鲜明。\n一片风吹落，几番霜染成。\n止啼诚诳语，题字亦閒情。\n把玩真堪惜，携归予绣枰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":516,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"形影","author":"仇远","text":"形影自相问，追随六十年。\n冷官真漫尔，归梦亦蘧然。\n但觉寒风暖，难令素发玄。\n可能学陶令，家去有园田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":517,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋日怀吾子行","author":"仇远","text":"秋高天阔雁南翔，游子愀然思故乡。\n重阳正当风雨近，三径故应松菊荒。\n酒酣耳热狂无益，江空目短愁何长。\n青山在望有晴日，我欲振衣千仞冈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":518,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋怀和子野 其二","author":"仇远","text":"自笑酸寒老孟郊，厌看俗事聚牛毛。\n故乡甚爱鲈鱼美，冷掾何嫌马骨高。\n少日宦情原淡泊，凉风客鬓转刁骚。\n荷衣槐笏徒拘束，不似芒鞋白纻袍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":519,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋怀和子野 其一","author":"仇远","text":"霜纨如月胜吴纱，彷佛蟾宫路未赊。\n涤暑自宜斟瑞露，凭虚谁肯乞飞霞。\n荒城蔓草生萤火，古濑西风起浪花。\n梦里仇山归未得，竹篱茅屋趁溪斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":520,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚斋居 其二","author":"仇远","text":"校官既与庙官同，胡不移家在泮宫。\n暮四朝三嫌有累，岁糜月费愧无功。\n致身馆阁须公等，曝背庭除任老翁。\n却喜北窗新植竹，行看玉立向南风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":521,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚斋居 其四","author":"仇远","text":"奇字生来识不多，莫烦载酒日相过。\n廊空尽有叶堪扫，门冷浑无雀可罗。\n肯为功名亏道义，常因课讲费吟哦。\n苔荒茅屋归期远，细雨檐花且醉歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":522,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋晚斋居 其一","author":"仇远","text":"君子堂西屋数间，但能容膝敢求安。\n悄无人迹如深井，惯听秋声是冷官。\n系马阶前慵夜秣，种蔬墙下助朝餐。\n携来书卷犹堪读，好共青灯了岁寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":523,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋感 其一","author":"仇远","text":"明朝交白露，此夜起金风。\n灯下倚孤枕，篱根语百虫。\n梧桐何处落，杼轴几家空。\n客意惊秋半，炎凉信转蓬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":524,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋感 其二","author":"仇远","text":"蛩依莎底露，萤堕树头风。\n秋已来多日，人谁念二虫。\n火流豳月应，云散楚天空。\n摇落年年事，吾生鬓亦蓬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":525,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"追和陈去非宣和甲辰重九韵","author":"仇远","text":"世态炎凉不足忧，吾生赢得日优游。\n九日忽惊枫叶落，百年几见菊花秋。\n忘形诗酒新丰客，满目溪山古溧州。\n闻道市桥骑马滑，山公归醉得无愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":526,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送田道士归茅阜","author":"仇远","text":"我爱孟东野，君师田子方。\n放舟游濑水，飞舄返华阳。\n有酒须同酌，真情不可忘。\n仙源桥下径，何日共徜徉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":527,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送汤希贤晦庵书院山长","author":"仇远","text":"文公阙里女星源，手泽遗书尚有传。\n精舍三年常作主，修程千里若登仙。\n青衫槐笏存家谱，练带花屏拥客船。\n故老或询予出处，为言索米向金渊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":528,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送许君起赴馀干教授 其二","author":"仇远","text":"兰佩蓉裳似倦游，东隅虽失尚堪收。\n君骑漱玉亭前马，我舣投金濑上舟。\n八品一官俱独冷，两州千里隔三秋。\n南溟鲲化君能事，甘分西湖侣白鸥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":529,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送许君起赴馀干教授 其一","author":"仇远","text":"当年而父同吾父，各罄籯金共教儿。\n可惜两翁黄壤下，不知二子绿衣时。\n著鞭虽已撞楼破，列鼎宁无负米思。\n千里送君何以赠，长歌泮水蓼莪诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":530,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送张巨川归崇德","author":"仇远","text":"三载金渊入幕宾，转当繁剧转精神。\n高堂多有承颜乐，巨室都无切齿人。\n此日吏民争卧辙，他时事业继埋轮。\n语儿溪上沧浪水，有约征衣共浣尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":531,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送张叔夏游金陵","author":"仇远","text":"肯向金渊暂泊舟，相逢衮衮别方休。\n移宫换羽周郎顾，咏月吟风太白游。\n床上无金犹好客，尊中有酒可消愁。\n明朝又作台城客，细看青山似洛州。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":532,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送杨刚中赴淮安教授","author":"仇远","text":"西蜀杨君子，才为博士优。\n儒官清似水，学舍小于舟。\n吴地仍多潦，淮田薄有收。\n虽非温饱计，足解友朋忧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":533,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送峿侍者游茅山","author":"仇远","text":"云开三茅古洞天，借风一棹荆溪船。\n所思绵绵常在梦，此行冉冉如登仙。\n汲泉净洗黄独雪，斸石深耕瑶草烟。\n蕙帐香凝蒲坐暖，共读南华秋水篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":534,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送郭君贤使君赴建德任 其一","author":"仇远","text":"天边久下紫泥书，日日东津望使车。\n最爱小儿骑竹马，也随迓吏过桐庐。\n良民吐气心方快，宿弊盘根力为锄。\n祗恐声名满朝著，春坊宾客又新除。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":535,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送郭君贤使君赴建德任 其二","author":"仇远","text":"先朝日近侍明光，步武骎骎政事堂。\n玉宇承恩沾湛露，金渊遗爱托甘棠。\n江山此去分风月，门户从来凛雪霜。\n虎兕枭狐宜敛迹，丈夫原不畏豪强。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":536,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送程子方归蜀 其一","author":"仇远","text":"薄葺田园溧泽边，乡心常梦蜀山川。\n梨花知几逢寒食，麦饭谁能洒墓田。\n矍铄老翁轻客路，扶携稚子上江船。\n东还莫为亲朋恋，自古云安有杜鹃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":537,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送程子方归蜀 其二","author":"仇远","text":"风雪飘萧季子裘，大江西溯过荆州。\n浑家无计归葱肆，岁晚何人付麦舟。\n长子应门宽后虑，轻帆入峡及春游。\n明年归趁梅花发，共醉䲔仙旧酒楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":538,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"重阳见菊占冬晴上熟","author":"仇远","text":"满城风日酿轻霜，昨夜东篱菊尽黄。\n正月自非添一闰，此花安得及重阳。\n新鸿远到愁无信，螃蟹中虚怕有芒。\n浊酒醒来闻吉语，晴过冬至兆丰穰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":539,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻杨大受凌吉叟吴次山诸友讣音有感二首 其二","author":"仇远","text":"少长皆吾友，相期满百龄。\n生分青白眼，死隔短长亭。\n蕉本身为幻，藤床梦是醒。\n中山醇酒在，且醉学刘伶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":540,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻杨大受凌吉叟吴次山诸友讣音有感二首 其一","author":"仇远","text":"落落霜馀树，疏疏晓后星。\n经年才契阔，故友半凋零。\n有梦怀风采，何人作墓铭。\n老孤无限泪，空望浙山青。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":541,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻鸡","author":"仇远","text":"今夕知何夕，此声非恶声。\n窗前疑月色，枕上误天明。\n未必皆三唱，惟应只四更。\n姑苏城外寺，此际已钟鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":542,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"闻金之一邓牧心叶去文皆羽化山中","author":"仇远","text":"独居学道坐枯禅，鹿豕交游七十年。\n能以幻躯当雨雪，终无虚腹坐神仙。\n平生文字知谁爱，老死山林绝可怜。\n他日钱塘耆旧传，三高宜入画图传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":543,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夕前一日雪","author":"仇远","text":"江城腊尽渐春来，三白呈祥不待催。\n和气已知随处满，梅花正用此时开。\n寒香冷艳相吞吐，月斧风斤巧剪裁。\n布絮寝衣烘未透，炉边酒熟且衔杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":544,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夜新居 其三","author":"仇远","text":"茅檐盈尺雪，真是冷官居。\n穷巷稀人迹，今朝是岁除。\n聒厅无鼓吹，消夜足琴书。\n晓冻冰桥滑，邻家借板舆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":545,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夜新居 其二","author":"仇远","text":"籸盆夹道明，爆竹小儿惊。\n但听窗前雪，不知楼上更。\n流年双羽急，深夜一鸡鸣。\n浅醉和衣睡，明朝要贺正。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":546,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"除夜新居 其一","author":"仇远","text":"避喧迁出郭，岁晚尚担簦。\n陋室大于斗，长途滑似冰。\n岂无问字酒，共守读书灯。\n老病须微禄，归田恨未能。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":547,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"圆通峰顶","author":"仇远","text":"结亭孤绝处，登眺不辞劳。\n万木俯在下，一峰如此高。\n山围湖面小，藤络树根牢。\n挥手红尘表，天风欲跨鳌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":548,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"悟上人同过史氏隐居","author":"仇远","text":"经时少暇出郊游，野旷山遥易见秋。\n祗怪朝来多爽气，似缘我辈是清流。\n荒台古井平芜湿，斜日西风乱叶愁。\n莫笑田翁无款待，绿菱新摘酒新篘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":549,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓出西城","author":"仇远","text":"閒官閒不尽，晓出古城阴。\n斗柄已插地，秋声将满林。\n故园三亩宅，落月几家砧。\n为报柴桑令，予今亦委心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":550,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晓霜","author":"仇远","text":"重衾惊骤冷，万瓦见浓霜。\n夹岸蒹葭白，空庭橘柚黄。\n宦情真淡泊，岁晚转荒凉。\n野寺钟声早，何人仆马忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":551,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"润州许使君寄饷新酿以流金笺为贽且供诗藁","author":"仇远","text":"浮玉乘壶香似桂，流金方絮滑如苔。\n报投且致相思意，酬唱须寻应猝才。\n君喜旌幢开使府，我贪花竹作春台。\n明年准拟游招隐，莫放遮山绣幕来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":552,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"真如寺","author":"仇远","text":"一桥夭矫界双湖，野径沿流到佛庐。\n石塔残灯犹闪烁，相家乔木已萧疏。\n苔封古井晴逾滑，骨冷荒山草不除。\n长水法师痴□甚，□根人定欲何如。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":553,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"衰年","author":"仇远","text":"衰年六十喜平头，微禄虚名老可羞。\n自笑一生同蝜蝂，了知万事等蜉蝣。\n寡欢元亮须归去，老病相如已倦游。\n只忆西湖春涨绿，柳边雪外舣兰舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":554,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"读陈去非集","author":"仇远","text":"简斋吟集是吾师，句法能参杜拾遗。\n宇宙无人同叫啸，公卿自古叹流离。\n穷途劫劫谁怜汝，遗恨茫茫不在诗。\n莫道墨梅曾遇主，黄花一绝更堪悲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":555,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偶作","author":"仇远","text":"元亮真止酒，昭文不鼓琴。\n文章成小伎，道德负初心。\n故友凋零尽，中年感慨深。\n从来麋鹿性，只是爱山林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":556,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄子野","author":"仇远","text":"西窗隐几读南华，颇悟亡羊与战蜗。\n住久不知身是客，归休谁谓女无家。\n向阳野竹先抽笋，待雪官梅欲试花。\n我爱睡乡真乐地，底须频吃玉川茶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":557,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄邓善之","author":"仇远","text":"几年不寄子公书，忽向燕南遗鲤鱼。\n天远地遥归未得，男婚女嫁事何如。\n壮游自致青云上，漫仕谁怜白发馀。\n西浙林泉俱可隐，毋忘旧约共閒居。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":558,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄朱饮冰","author":"仇远","text":"欲共谭诗一解颐，停云望极思依依。\n梅花赋就广平老，杨柳门閒靖节归。\n驿路数程征马瘦，家书千里过鸿稀。\n思君怕倚阑干北，拄笏看山竟落晖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":559,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄吴元初道录","author":"仇远","text":"桃花两度见青春，梦里玄都隔几尘。\n升斗自怜为客久，舟车每惜寄书频。\n君如当日陶弘景，我亦他时贺季真。\n东望冶城空恋恋，西湖非晚作归人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":560,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄陈仲麟","author":"仇远","text":"槜李城边送客船，梅花一别又三年。\n清风朗月思元度，骏马名姬羡谪仙。\n湖海倦游予白发，园林真乐子青毡。\n楚生卜宅平生志，归日相从学力田。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":561,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]