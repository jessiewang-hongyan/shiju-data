[{"title":"清明","author":"杨公远","text":"清明又向客中过，忆著家山事若何。\n未及扫松徒怅恨，偶因得句漫吟哦。\n六旬身世忧怀少，九十春光阴雨多。\n对景岂宜虚负却，把杯须拚醉颜酡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5360,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明日雨中闻鹃 其二","author":"杨公远","text":"家轻授鳌灵，不拟再寻盟。\n故业成荒址，中心饮恨声。\n废兴犹反掌，今古总伤情。\n最是初闻处，令人泪欲倾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5361,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明日雨中闻鹃 其一","author":"杨公远","text":"蜀魄抑何灵，年年不负盟。\n才过百五日，便作两三声。\n渠自怀归计，人因恼别情。\n凄凉无处著，那更雨如倾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5362,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"萤","author":"杨公远","text":"飞萤生腐草，熠耀暗中游。\n贴水灯相照，穿林火独幽。\n风前疑烬落，雨里讶星流。\n映读除车胤，今人肯效不。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5363,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒和靖先生墓借斗山韵","author":"杨公远","text":"孤山仙冢草菲菲，姓字留将后世知。\n遣稿文无封禅事，名家梅有影香诗。\n祇惭老子携琴晚，不见苍头放鹤时。\n一瓣心香聊敢敬，寒泉自掬酹瓷卮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5364,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谒秋崖先生方吏部墓借斗山韵","author":"杨公远","text":"崖翁底事姓名香，照世文章日月光。\n葭坞留荷啼晓露，茧窝埋玉黯斜阳。\n碑刊地记生前撰，甃蚀苔痕去后荒。\n一炷炉薰瞻敬罢，教人空结九回肠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5365,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"铜瓶簪梅","author":"杨公远","text":"梅花点点自清真，雪虐风饕苦且辛。\n白玉堂开虽是贵，古铜瓶浸亦非贫。\n爱渠夜写灯前影，类我时挥笔底春。\n雅趣有谁能领会，华光已后更无人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5366,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其六","author":"杨公远","text":"一味幽閒了此生，那曾怀刺谒公卿。\n无官可署名虽晦，有句堪吟思自清。\n棋要藏机何用著，琴能识趣底须声。\n何当办取青蓑笠，去趁农夫学耦耕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5367,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其九","author":"杨公远","text":"槎牙诗骨等梅臞，试启青铜失故吾。\n啖蔗祇应佳境近，解袍那想故人无。\n推排景物归吟卷，安顿江山入画图。\n只此可堪供活计，底须舍瑟学齐竽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5368,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其七","author":"杨公远","text":"萧然天地一吟身，著向荒村野水滨。\n耳底松声风奏乐，窗间竹影月传神。\n无田种秫难谋醉，有砚遗家未是贫。\n除却推敲无别事，襟怀拍塞四时春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5369,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其四","author":"杨公远","text":"生计新来喜有涯，莳菘栽韭树桑麻。\n惯眠纸帐三竿日，饱听萍池两部蛙。\n往事真成看堕甑，凡身安敢望乘槎。\n一般受用还官样，门外黄蜂为报衙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5370,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其二","author":"杨公远","text":"身世悠悠付等閒，卢仝破屋恰三间。\n暂时结伴窗前月，耐久论交户外山。\n竹鼎篆香消更爇，锦囊诗卷改还删。\n是非荣辱俱乌有，翻笑人间两触蛮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5371,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其五","author":"杨公远","text":"髼松两鬓欲成丝，又是桃红李白时。\n百岁光阴须藉酒，一生志趣莫过诗。\n世情因向贫中识，画思方知老后宜。\n却喜半犁新雨过，旋分菊本莳东篱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5372,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其十","author":"杨公远","text":"诘曲通村小径开，依山结屋任低隈。\n无从问字高人过，有不嫌贫长者来。\n煮茗烧残柴带叶，脱巾漉起酒和醅。\n绝怜笔砚香犹在，集句曾赓百咏梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5373,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪","author":"杨公远","text":"怪得云顽冻不开，漫空忽搅豆秸灰。\n青留一半窗前竹，白胜三分屋外梅。\n剡曲舟应撑月去，灞桥驴想得诗回。\n吾侬喜有煎茶兴，不羡销金帐底杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5374,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪月梅","author":"杨公远","text":"寒梅开后雪初晴，敛尽残云月又生。\n月映雪时梅更好，梅横月处雪争明。\n羡渠结伴成三白，添我相亲即四清。\n今夕细吟诗说与，来年此际莫寒盟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5375,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪消","author":"杨公远","text":"风姨剪水作花钿，铺遍乾坤惜不坚。\n滑滑淤泥溶暖日，潺潺檐溜滴晴天。\n山头白了青还在，梅脸肥添瘦复前。\n倒指兼旬犹是腊，愿期再作兆丰年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5376,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄山中用省斋韵见寄次韵谢 其二","author":"杨公远","text":"幽窗兀兀坐愁中，忽拜山中小篆红。\n心事尽从诗里见，交情全在帖间通。\n从容笑语知何日，老草赓酬寄便风。\n多谢绨袍尤恋恋，个般襟度有谁同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5377,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄山中用省斋韵见寄次韵谢 其一","author":"杨公远","text":"话别匆匆二月天，回眸两见月亏圆。\n数声乾鹊才闻后，一幅鸾笺忽堕前。\n风雨对床何日遂，雁鱼传信几时还。\n每逢骚客论心处，说著山中意悄然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5378,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄盆渡次友人韵","author":"杨公远","text":"到得黄盆九月天，呼童弛担驻征鞯。\n迢迢江水天连楚，漠漠淮乡稻满田。\n酒旆风翻疏柳外，渔家网晒夕阳边。\n买将郭索倾杯处，对景诗成恰一篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5379,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"喜晴","author":"杨公远","text":"厌听滴檐声，风回喜乍晴。\n润添新柳重，瘦损落花轻。\n山翠云初敛，溪浑水渐清。\n野人无别事，杖策又郊行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5380,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓乾明观 其五","author":"杨公远","text":"月色上窗纱，移来竹影斜。\n夜深人已寂，更转鼓频挝。\n杜宇惊幽梦，银釭坠细花。\n一时浑不记，身在羽人家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5381,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓乾明观 其四","author":"杨公远","text":"丹室白云深，红尘不受侵。\n鸣琴惊鹤梦，弹铗恐龙吟。\n只有清虚事，全无名利心。\n谢渠为下榻，买酒共侬斟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5382,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓乾明观 其三","author":"杨公远","text":"多谢老弥明，金芽石鼎烹。\n一瓯浮雪白，两腋觉风清。\n齿颊回真味，诗联悟道情。\n北窗高卧处，魂梦到蓬瀛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5383,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓乾明观 其二","author":"杨公远","text":"无奈雨潺潺，驱除恶况难。\n三杯官酒薄，一掬客心酸。\n画卷慵拈起，书编谩展看。\n更谁堪与话，时对老黄冠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5384,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓乾明观 其一","author":"杨公远","text":"梗迹寄琳宫，萧然万虑空。\n观棋评胜负，拂剑认雌雄。\n香篆消还续，瓶花白间红。\n自怜閒雅趣，恰共羽流同。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5385,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寓婺源紫虚观","author":"杨公远","text":"书卷携来寓紫虚，凭高凝眺更无馀。\n五山结邑龙盘踞，一水依城带卷舒。\n旦暮鼓钟喧梵宇，高低楼阁壮神居。\n年时除却酬香者，阛阓行人往复疏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5386,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游水西次吴秋涧韵","author":"杨公远","text":"松阴石径绝纤埃，缓步行春得得来。\n风景一川诗料足，楼台两岸画图开。\n山花乱插髼松鬓，村酒频倾潋滟杯。\n扶醉归来天欲莫，数声鼓角又相催。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5387,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游南山次刘晓窗韵二首 其二","author":"杨公远","text":"李白曾来问姓名，宣平疑是古初平。\n负薪出处天将曙，沽酒归时月又生。\n鸡啄遗丹非有意，瓢悬老树寂无声。\n寒泉满沼依然在，静夜长涵星斗明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5388,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游南山次刘晓窗韵二首 其一","author":"杨公远","text":"神仙窟宅白云扃，山径迂回峻复平。\n烟冷恐遗丹灶在，草深不向斗坛生。\n市廛尘隔二三里，岩谷禽啼一两声。\n莫讶此来仙不见，遥岑寸碧眼增明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5389,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"谢许侯特顾","author":"杨公远","text":"传呼门外骇还惊，忙著荷衣倒屣迎。\n皂盖朱幡人从简，雕鞍绣勒马蹄轻。\n群中驽顿增高价，爨下桐方有烈声。\n多谢使君青顾后，免教汩没度浮生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5390,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感怀 其二","author":"杨公远","text":"长吟抱膝更欷歔，较著前时迥不如。\n世事看来巢幕燕，人生勘破上竿鱼。\n投非所好缘工瑟，见匪相知懒曳裾。\n造物岂应私困我，还须水到自成渠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5391,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感怀 其一","author":"杨公远","text":"桂薪玉米转煎熬，口体区区不胜劳。\n今日难谋明日计，老年徒羡少年豪。\n皮肤剥落诗方熟，鬓发沧浪画愈高。\n自顾一寒成感慨，有谁能肯解绨袍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5392,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"酬黄仲宣见寄","author":"杨公远","text":"倦走南州与北州，竹篱茅舍足清幽。\n但教有酒名从事，何必为官见督邮。\n谢友寄诗通间阔，拂笺泚笔细赓酬。\n虽然可写胸中意，难写胸中半点愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5393,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"蜡梅","author":"杨公远","text":"一种孤芳别样奇，化工镕蜡雪霜时。\n正怜粉蝶归何处，却怪黄蜂集满枝。\n衣效道妆香惹袖，面侔佛相脸无脂。\n清名也受梅花号，底事林逋不赠诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5394,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题徐氏聚秀楼","author":"杨公远","text":"轮奂危危百尺楼，阑干徙倚豁双眸。\n插天万仞黄山耸，绕郭千寻练水流。\n风月不消钱可买，主宾须要味相投。\n四时景物俱收敛，引得诗人竞唱酬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5395,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"懒","author":"杨公远","text":"疏懒春来分外添，蒲团兀坐地炉边。\n关心事少夜悭梦，酌酒杯多昼亦眠。\n琴有徽弦姑挂壁，诗无眼目谩成篇。\n自怜不似门前柳，才得东风翠拂天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5396,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鹭","author":"杨公远","text":"飘然片雪下晴空，终日盘旋浅濑中。\n行近鸥凫风致别，立依蒲蓼画图同。\n数茎丝发心何虑，一世鱼餐体不丰。\n历遍江湖真漫浪，前身应想是渔翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5397,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借汪路教韵题赵东麓判丞临清堂","author":"杨公远","text":"结屋俯清溪，萧然迥出奇。\n书藏千万卷，梅浸两三枝。\n入竹风声细，移花日影迟。\n乐山仍乐水，何虑复何思。\n菊有陶潜逸，兰无屈子悲。\n娱情琴上操，遣兴局间棋。\n对客频倾酒，临流剩赋诗。\n要将閒度日，只恐道关时。\n触目多幽致，留题总色丝。\n细吟增敬羡，貂续匪佳辞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5398,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"黄山","author":"杨公远","text":"古今墨客兼骚客，推许黄山甲众山。\n三十六峰层汉外，百千万岫乱云间。\n鍊丹帝往名长在，捣药仙归臼已閒。\n叶落花开人寂寂，雄鸣雌和鸟关关。\n瀑湍岩罅常飞沫，砂现崖巅未带殷。\n水畔青牛眠正稳，源头白鹿去仍还。\n清潭易见鱼翻锦，幽洞难窥豹露斑。\n著罢棋枰留嶂顶，流来桃片点溪湾。\n鸾翔弄影非无侣，鹤唳冲天岂类鹇。\n空谷伐柯樵父远，平川唤犊牧儿顽。\n石瓶倾注泉那竭，瑶草敷荣地匪悭。\n老桧络藤缠夭矫，苍苔蚀径绕回环。\n遥知衲子明空苦，应笑贪夫竞触蛮。\n断续小桥艰跋涉，崎岖绝磴费跻攀。\n枝头果熟猿争取，树杪梢枯鹊为删。\n虎踞风前疑啸吼，龙潜潭底想盘跧。\n水帘珠贯何曾捲，石室云封底用?。\n对峙容浮高耸峭，合流曹院响湲潺。\n汤泉浴起能轻骨，药鼎餐遗可驻颜。\n胜概不穷吟不尽，一时模写在人寰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5399,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"一溪赵宰惠诗次韵谢","author":"杨公远","text":"古歙遭逢定宿缘，作成和气致丰年。\n一溪浪静一溪月，百里民安百里天。\n草茂圜扉花满县，雨馀村落水通田。\n正惭欠识荆州愿，忽拜雕冰镂玉篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5400,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九日登高次宋省斋韵","author":"杨公远","text":"久出尝思赋式微，半生心事少人知。\n登高且泛寒花酒，扶老须凭劲竹枝。\n樵径缓跻山诘曲，羁怀难琢句新奇。\n绝怜万里澄秋霁，辜负潘郎风雨诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5401,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十二月二十九夜大雪 其一","author":"杨公远","text":"六出霏霏饯岁华，终宵撩乱扑窗纱。\n未言造化工夫巧，且看乾坤景象奢。\n□□□□□□□，□□□□□□花。\n明朝正旦常年别，琼户瑶阶一样誇。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5402,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"十日宋省斋有诗谓不及同登南山独步乌聊山","author":"杨公远","text":"我辈登高崄更遥，闻君独步上乌聊。\n休嗟昨日浑无兴，须信明年尚有条。\n节后黄花香未减，年高黑鬓雪偏饶。\n拂笺续罢新诗句，回首重阳越一朝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5403,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山市晴岚","author":"杨公远","text":"横岚髣髴抹高冈，村市人家酿秫香。\n溪上晓来争渡急，裹盐沽酒趁虚忙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5404,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"友梅吴编校寿宫之侧筑庵曰全归有诗十咏敬次之 其九","author":"杨公远","text":"颜貌元非借酒红，那堪和气更春风。\n梅边索笑閒吟处，句法清圆字字工。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5405,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"冬晴","author":"杨公远","text":"岁序从教自改更，老天有意活苍生。\n一冬晴暖雨全少，三日阴寒雪不成。\n谩拥地炉然榾柮，每忧时事验欃枪。\n庭前问讯枯梅树，怕有南枝绽玉英。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5406,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"龙金庵次壁间韵","author":"杨公远","text":"续得远公派，结庵千仞巅。\n利名俱拚舍，寒暑任推迁。\n供佛燃香篆，餐松咽石泉。\n个中三昧处，克广自无边。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5407,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再韵 其一","author":"杨公远","text":"听彻茶烹蚓窍声，挑灯开卷眼能明。\n□□□□□□□，过了残冬岁又更。\n世事间关人易老，容怀萧索寐难成。\n推窗且对梅花月，便觉尘襟一晌清。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5408,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孙芝田见示吟编一诗捲锦","author":"杨公远","text":"细诵芝田诗一编，了无斧凿自天然。\n豪雄虹抹斜阳外，雅淡梅横缺月边。\n点石化金非是幻，脱胎换骨欲成仙。\n个般才调真难敌，行看鸡林声价传。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5409,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋立秋","author":"杨公远","text":"才见春花荣，又见春花谢。\n花谢绿成阴，瞬目逢炎夏。\n谁知俯仰间，祝融便回驾。\n却喜西风来，美矣难酬价。\n且效柴桑人，寄傲南窗下。\n此意自领会，那许傍人借。\n所愿无荣辱，静中观物化。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5410,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次宋省斋避暑","author":"杨公远","text":"何处避炎威，好是幽人屋。\n拂拂来清风，苍松间脩竹。\n坐久细哦诗，惜不疗饥腹。\n念彼田舍翁，桔槔声断续。\n谁知汉阴老，抱瓮灌园谷。\n顾我本无机，所愿年谷熟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5411,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次罗梅谷诗画总观","author":"杨公远","text":"梅谷梅应占作魁，不论时节遣花开。\n传真旧说华光老，诗到林逋俱压倒。\n华光去后谁逼真，补之笔底生阳春。\n月香水影许多态，竹外斜枝奇且怪。\n后来若问谁解无声兼有声，须还梅谷野趣相与共推评。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5412,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其八","author":"杨公远","text":"妇作生涯勤杼轴，夫营活计在桑田。\n老翁榾柮炉边坐，幼稚檐前负日暄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5413,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园农家杂咏 其六","author":"杨公远","text":"四郊䆉稏高低熟，几处连耞澎湃声。\n妇饷区区无寸暇，绩麻犹趁月华明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5414,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次金东园渔家杂咏 其一","author":"杨公远","text":"系缆旋编新箬笠，喜晴仍晒旧蓑衣。\n岸飞柳絮河鲀上，春涨几添一尺肥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5415,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次省斋桂花","author":"杨公远","text":"羡君诗句正而葩，閒对西风赋桂花。\n可惜分来蟾窟种，如今开遍野人家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5416,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次省斋韵觅友梅索笑集不蒙见惠再借韵","author":"杨公远","text":"巨编藏古锦，风雅续遗音。\n雷电欲下取，辟易不敢侵。\n真趣谁领会，一如陶潜琴。\n所言正而大，讵比郑声淫。\n疑有造化炉，炼铁成黄金。\n个是绝世宝，何必问西琛。\n有时吟竹外，竹影弄清阴。\n有时歌梅边，梅香散水沈。\n所以形之句，毋乃得之心。\n俗子敢再请，幸尔勿沈吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5417,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次黄山中进退韵以饯","author":"杨公远","text":"会聚浑无定，云萍一样观。\n今朝酬俚句，明日隔重山。\n鸿便书须寄，秋期盟莫寒。\n算来无远别，底用唱阳关。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5418,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次程直学秋雨感","author":"杨公远","text":"一雨战秋阳，风生衣袂举。\n更不假蒲葵，秋阳眇何许。\n浑如赫赫人，其技只鼯鼠。\n须信有循环，凉生屏烦暑。\n此意默领会，何劳向人语。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5419,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]