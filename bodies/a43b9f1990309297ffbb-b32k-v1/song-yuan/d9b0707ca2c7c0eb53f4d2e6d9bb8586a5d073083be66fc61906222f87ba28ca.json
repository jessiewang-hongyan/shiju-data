[{"title":"次程南仲韵 其三","author":"杨公远","text":"兴来呼酒乏瓷卮，自笑醄醄作么为。\n细诵坡仙前后赋，更歌元亮去来辞。\n一心湛彻长如水，两鬓髼松半欲丝。\n毕竟不消惆怅得，苍松独傲岁寒时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5420,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"江草塘袖诗言别次韵以饯","author":"杨公远","text":"数日君不来，欲赋莫云诗。\n今朝忽过我，欢然如先期。\n谈论已忘倦，坐卧犹忘机。\n正尔踌躇间，袖出言别诗。\n且知束锦囊，届途无多时。\n使我心为感，使我心为悲。\n此意竟何如，写作送行诗。\n君不鄙我句，喜色形须眉。\n明朝天一方，胥会知何时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5421,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"呈赵提领","author":"杨公远","text":"从容依绿泛莲红，吾郡生民有幸逢。\n政事分明天外月，风标翘楚雪中松。\n携琴领鹤宦情好，横笛倚楼诗兴浓。\n腾茂蜚英闻帝里，行看宠锡禄千钟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5422,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"还刘晓窗吟卷就用卷端韵","author":"杨公远","text":"细观吟卷压阳春，字字新奇绝点尘。\n既已学诗兼学礼，底须忧道更忧贫。\n鸟啼花落萧閒日，月白风清自在身。\n内景通明谁会得，窗寒曙色正精神。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5423,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饮归次南仲韵","author":"杨公远","text":"霜后枫林浑似缬，篱边菊老香初歇。\n昏昏醉梦了时光，一任头颅堆白雪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5424,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"到陈村","author":"杨公远","text":"半日脩途适到陈，因思尼父倍伤神。\n行囊抖擞幸馀半，旅馆萧条苦乏薪。\n唤仆买杯苏脚倦，拂尘题句效眉颦。\n孤村落日黄昏后，一觉明朝又问津。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5425,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和靖","author":"杨公远","text":"湖上吟翁道味长，孤坟今已草成荒。\n姓名犹寄梅花上，一度开时一度香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5426,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"始生书怀","author":"杨公远","text":"非贤非智半痴聋，性禀天然雅淡中。\n閒阅废兴槐国梦，细思得失楚人弓。\n事无欺世心何愧，诗为伤时句不工。\n却谢梅花开几点，年年此日伴山翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5427,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"泊浙江东岸次斗山韵","author":"杨公远","text":"渺渺江空阔，停帆首屡回。\n渔家编苇荻，蜃气幻楼台。\n逸少亭应在，鸱夷棹不来。\n一钩新月上，时把篾篷推。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5428,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗匠","author":"杨公远","text":"吴刚运斧惟修月，轮扁挥斤妙斲轮。\n好句何须劳斧凿，无痕无迹自天真。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5429,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"促织用前韵","author":"杨公远","text":"儿童探穴戏搜寻，隐迹苔阶深复深。\n见敌有时能勇斗，无情终夜只清吟。\n唤回枕上羁人梦，恼碎闺中织妇心。\n莫向当今机局去，抛梭络纬已林林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5430,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春夜听雨","author":"杨公远","text":"小楼炙烛未成眠，好雨知时听不厌。\n风急斜敲窗上纸，檐高微洒楯边帘。\n花应憔悴啼丹脸，麦定惺愡磔翠髯。\n添得明朝诗兴好，池塘草长水渐渐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5431,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其六","author":"杨公远","text":"书剑谋生总不成，效渠东野以诗鸣。\n未知唐宋源流异，却喜江湖句法轻。\n肩耸每同臞鹤立，口吟端似冷蛩声。\n自怜绝少惊人句，生怕人传浪得名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5432,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"借虚谷太博狂吟十诗韵书怀并呈太博 其四","author":"杨公远","text":"头颅搭飒一山翁，万事随宜敢讳穷。\n不结东华尘土梦，何干北海马牛风。\n半生踪迹从容里，一片襟期冷淡中。\n兀坐有时参世味，古今兴废转头空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5433,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贽林路教","author":"杨公远","text":"千载孤山处士星，只将閒逸了平生。\n一联好句香犹在，几世闻孙声最清。\n泮水工夫施教雨，梅花标格待和羹。\n不知野叟何缘分，邂逅城闉幸识荆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5434,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"逗春海棠","author":"杨公远","text":"蜀地名花迥出奇，玉环卯醉未醒时。\n只开春暖二三月，偶冒冬寒四五枝。\n晓带清霜浓傅粉，晚迎红日淡匀脂。\n惜渠未敢轻攀折，子美如何少得诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5435,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"梅花五首 其一","author":"杨公远","text":"草木根荄暖未回，□□□□□□□。\n□□□□□□□，老干槎牙一半摧。\n水急可曾流影去，雪深还不碍香来。\n赤松孤竹真渠友，万紫千红总皂台。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5436,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明后旬日不闻鹃","author":"杨公远","text":"过了清明又一旬，不闻杜宇免伤情。\n算渠会得羁人意，应向山林僻处鸣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5437,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其三","author":"杨公远","text":"老屋荒寒亦自清，柴门虽设只长扃。\n数行古隶閒居赋，半壁行书陋室铭。\n□□□□□□□，研朱滴露勘黄庭。\n此生与世虽无补，笔底青山到了青。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5438,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其一","author":"杨公远","text":"碧云深处著吾庐，远却喧嚣尽自如。\n呵砚磨冰朝鍊句，拥炉烧叶夜观书。\n人生穷达乘轩鹤，世事盈虚赋芧狙。\n勘破已无朝市梦，软红端不上衣裾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5439,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"隐居杂兴 其八","author":"杨公远","text":"篱编红槿障蓬茅，半近城闉半近郊。\n苔绣曲蹊千万点，梅窥碧沼两三梢。\n閒将今古浇胸臆，懒把荣枯问卦爻。\n一自渔樵分席后，清泉白石与论交。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5440,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"避暑次叶教授韵","author":"杨公远","text":"炎天无处涤烦心，拂拭苍苔坐茂林。\n贪撚吟髭搜好句，不知日转已移阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5441,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"勉无咎 其二","author":"熊鉌","text":"唤作三才祇此躯，乾坤一日可无儒。\n稍馀礼义存馀脉，亟把诗书教小雏。\n黑窣窣时鱼是鲁，声呜呜处虎为菟。\n祇今时节当如此，可笑迂生独向隅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5442,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"端午次韵和徐改之 其二","author":"于石","text":"涛头洒泪眼难乾，鱼腹沉冤骨未寒。\n楚些一章招莫返，曹碑八字好难看。\n水流不尽湘江恨，俗奠空陈蘋藻盘。\n我亦逢时增感慨，凛然忠孝孰能干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5443,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"孤雁","author":"于石","text":"流落天涯偶失群，何心饮啄到江城。\n一身去就分南北，四海飘零孰弟兄。\n无伴月明惟顾影，欲鸣风惨不成声。\n明年回首关山路，依旧团圞骨肉情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5444,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋思 其二","author":"于石","text":"草堂何必仿卢鸿，水色苍茫山色浓。\n待月轩窗留客话，隔篱灯火起邻舂。\n虫鸣终夕如相语，燕去知时不苟容。\n一片吟情渺何许，西风吹入乱云重。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5445,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九月九日赏红叶 其二","author":"汪元量","text":"凤凰山上少人家，红叶漫山映落霞。\n却笑陶潜归栗里，东篱寂寞对黄花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5446,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"九月九日赏红叶 其一","author":"汪元量","text":"天平山木似花开，青女裁成锦绣堆。\n暂借秋光作春色，白衣解遣曲生来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5447,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"万州","author":"汪元量","text":"槎牙鸟道没人烟，狼虎交横马不前。\n回首青山藏白蹠，万州城下草连天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5448,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大元皇后游蓬莱岛","author":"汪元量","text":"午夜红云满太清，晓来王母下瑶京。\n日从万岁山头出，人在九重天上行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5449,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"马嵬坡","author":"汪元量","text":"霓裳惊破出宫门，马上香罗拭泪痕。\n到此竟为山下鬼，不堪鞞鼓似招魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5450,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"乌江","author":"汪元量","text":"平生英烈世无双，汉骑飞来肯受降。\n早与虞姬帐下死，不教战血到乌江。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5451,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"云台","author":"汪元量","text":"荒亭驻马酌金罍，风卷黄埃丑上来。\n满地山河无汉业，赵州留得古云台。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5452,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"凤州歌 其一","author":"汪元量","text":"凤州南去是南岐，大散横盘势更危。\n跃马紫金河畔路，万株杨柳撒金丝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5453,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"凤州歌 其二","author":"汪元量","text":"去路迢迢入两当，三千三百到华阳。\n黄花川上黄花驿，千百猿声断客肠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5454,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"天津桥","author":"汪元量","text":"白杨猎猎柳青青，怒浪高低不肯平。\n一自尧夫分手后，更无人听杜鹃声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5455,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"巴江","author":"汪元量","text":"巴□鼓棹兴悠悠，野鹿衔花出峡头。\n网得巨鱼堪切脍，携觞重上荔枝楼。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5456,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北邙山","author":"汪元量","text":"芒芒北邙山，高坟尽无主。\n惟有石麒麟，相向立秋雨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5457,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"永康军","author":"汪元量","text":"锦城飞马过青城，无奈风声更雨声。\n一夜不眠何似者，筹花赌酒到天明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5458,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉局诗","author":"汪元量","text":"联骑来登卯酉山，老君玉局护阑干。\n步虚殿上香云绕，空翠萧森北斗寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5459,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"华清池","author":"汪元量","text":"一夜春寒事可知，海棠无地避风吹。\n温泉自向东流去，不管飞红出禁池。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5460,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戎州 其四","author":"汪元量","text":"锦树高枝种万窠，岁收百斛足生涯。\n八钱买得一斤重，鲁直诗中特地誇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5461,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戎州 其二","author":"汪元量","text":"锦荔戎州第一奇，大如鸡子压枝垂。\n金刀剪下三千颗，对客从容把酒卮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5462,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戎州 其三","author":"汪元量","text":"害马劳人事已灰，长安无复使臣来。\n满园蓊蔚千千树，尽是杨妃死后栽。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5463,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"戎州 其一","author":"汪元量","text":"豪士家园为我开，树头树底锦堆堆。\n书生大嚼真快意，不枉戎州走一回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5464,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"百花潭","author":"汪元量","text":"万里扬鞭到益州，旌旗小队锦江头。\n红船载酒环歌女，摇荡百花潭水秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5465,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹枝歌 其十","author":"汪元量","text":"天上人间一梦过，春来秋去奈愁何。\n铜仙有泪如铅水，不似湘妃竹上多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5466,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹枝歌 其五","author":"汪元量","text":"落木萧萧风怒号，平沙漠漠雁腥臊。\n湘江秋水澄如练，山鬼嚣时山月高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5467,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹枝歌 其四","author":"汪元量","text":"柘枝舞罢竹枝歌，风烛须臾奈尔何。\n马玉池中鸿雁密，定王台上骆驼多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5468,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"竹枝歌 其一","author":"汪元量","text":"快风吹我入三巴，桂棹兰桡倚暮花。\n一道月明天似水，湘灵鼓瑟下长沙。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5469,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其五","author":"汪元量","text":"溶溶漾漾碧粼粼，船去船来不碍人。\n日午中官传上旨，内家宣赐玉堂春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5470,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其二","author":"汪元量","text":"如此湖山正好嬉，游人船上醉如泥。\n黄莺不入垂杨柳，却立海棠花上啼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5471,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其一","author":"汪元量","text":"南高峰对北高峰，十里荷花九里松。\n烟雨楼台僧占了，西湖风月属吾侬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5472,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其六","author":"汪元量","text":"月香水影逋梅白，雨色晴光坡柳青。\n一个销金锅子里，舞裙歌扇不曾停。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5473,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其十","author":"汪元量","text":"六花飞舞似鹅毛，丞相身穿御赐袍。\n不念长安有贫者，下湖打鼓饮羊羔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5474,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其九","author":"汪元量","text":"芙蓉照水桂香飘，车马纷纷度六桥。\n锦幔笼船人似玉，隔花相对学吹箫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5475,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其四","author":"汪元量","text":"嵯峨云髻簇金钿，血色罗裙湿晓烟。\n陌上相逢通一笑，第三桥下是奴船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5476,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其八","author":"汪元量","text":"王孙挟弹打鸳鸯，红藕花前世界凉。\n揭起蓬窗弄湖水，潜螭双眼射金光。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5477,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其三","author":"汪元量","text":"红桡绿舫荡清波，露脚斜飞湿芰荷。\n回首涌金门外望，里河犹自沸笙歌。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5478,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"西湖旧梦 其七","author":"汪元量","text":"帝城官妓出湖边，尽作军装斗画船。\n夺得锦标权遗喜，金银关会赏婵娟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5479,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴儿","author":"汪元量","text":"玉貌儿童泪盈把，辫发垂肩行酒斝。\n将军又去打苏州，出门指使教牵马。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5480,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"牡丹平","author":"汪元量","text":"长平山上紫云封，蜀老相传隐者宫。\n高树蔽天三十里，开花十丈舞春风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5481,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"花石纲","author":"汪元量","text":"假山虽假总非真，未必中间可隐身。\n若使此山身可隐，上皇不作远行人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5482,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"花蕊夫人故宅 其二","author":"汪元量","text":"宅前宅后好青山，零落重门半掩关。\n玉貌久归天上去，宫词百首落人间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5483,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"花蕊夫人故宅 其一","author":"汪元量","text":"千古风流一梦中，江山阅尽几英雄。\n芙蓉城里家何在，花蕊夫人宅已空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5484,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"废宅","author":"汪元量","text":"王侯多第宅，草满玉阑干。\n纵有春光在，人谁看牡丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5485,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"废苑见牡丹黄色者","author":"汪元量","text":"西园兵后草茫茫，亭北犹存御爱黄。\n晴日暖风生百媚，不知作意为谁香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5486,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忠州荔枝楼小憩","author":"汪元量","text":"竟日扬鞭不暂闲，畏途叠叠是青山。\n西风吹落忠州去，锦绣窠中屋万间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5487,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"忠武侯庙","author":"汪元量","text":"夔门春水拍天流，人日倾城踏碛游。\n古庙虫蛇穿画壁，竹风溪雨共啾啾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5488,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"昌州海棠有香 其二","author":"汪元量","text":"香霏堂上树婆娑，不见嫣然亦可嘉。\n且向秋风一杯酒，枝头的的两三花。\n夜梦花仙索我诗，他山别种世间稀。\n一年四季花如锦，莫把娇姿比贵妃。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":5489,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]