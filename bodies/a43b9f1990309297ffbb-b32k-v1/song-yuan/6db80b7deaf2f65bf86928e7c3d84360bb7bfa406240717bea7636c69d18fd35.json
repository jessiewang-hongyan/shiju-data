[{"title":"留别袁伯长待制凌德庸少监周南翁待制诸公三绝句 其一","author":"陆文圭","text":"待诏明廷百有馀，一人释褐向江都。\n诸生对策无奇语，田窦何曾不喜儒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10804,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"留别袁伯长待制凌德庸少监周南翁待制诸公三绝句 其二","author":"陆文圭","text":"书生骨相太邅迍，地位还须有福人。\n老我终身友麋鹿，看君他日上麒麟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10805,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四时佳兴题徐景阳园堂五首 其三","author":"陆文圭","text":"穷秋破屋檐头雨，残腊征夫陌上霜。\n公子閒居无一事，可能忧乐两相忘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10806,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题园亭","author":"陆文圭","text":"把酒看花贫亦乐，携琴对竹静相宜。\n客来若问朝家事，回首东风谢不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10807,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鹤皋诗为振之作","author":"陆文圭","text":"鹳鸣于垤妇长叹，鸿渐于陆夫远征。\n何似山亭闻鹤唳，无人静坐月三更。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10808,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"刘澹斋求米船谩赋二绝 其二","author":"陆文圭","text":"灵宝生平爱虎头，每傍战舰系轻舟。\n晚无书画真无益，洗手莫嫌寒具油。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10809,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题敬威卿参政赠许正卿针诗卷末敬公之章许卿之艺诸君发挥尽矣终以二绝貂续尾蛇添足乎 其二","author":"陆文圭","text":"正人一脉系安危，温公身事亦付医。\n此身强健无著处，不如枕卧看儿嬉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10810,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题昭君画卷五绝 其一","author":"陆文圭","text":"当时随例与黄金，不遣君王有悔心。\n近使来传延寿死，回思终是汉恩深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10811,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题昭君画卷五绝 其三","author":"陆文圭","text":"青冢千年恨不埋，琵琶马上几时回。\n宇文高氏争雄日，突厥柔然献女来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10812,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题二乔手卷二绝 其一","author":"陆文圭","text":"国色娇娆画不如，风流二婿尽消渠。\n阿承丑女无人聘，自挈衣装过草庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10813,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题牡丹梨花手卷","author":"陆文圭","text":"沉香宴罢索人扶，重向银屏睹雪肤。\n一笑不偿千古恨，玉环当日倚阑图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10814,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题补之梅","author":"陆文圭","text":"含章殿里雪中开，曾共君王索笑来。\n著在荒蹊枯竹畔，可知准敕号村梅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10815,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"亭下玉兰花开","author":"陆文圭","text":"初如春笋露纤娇，拆似红莲白羽摇。\n亭下吟翁步明月，玉人虚度可怜宵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10816,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句 其三","author":"缪鉴","text":"病犹有药扶持老，贫为无心俯仰人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10817,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴市售药","author":"陈深","text":"山夫聊作市廛居，漫学壶公计已疏。\n收卷向来经济策，案头唯集古方书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10818,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"咏史 刘表","author":"陈普","text":"无正文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10819,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雨夜雪意","author":"方回","text":"汹涌风如战，萧骚雨欲残。\n遥峰应有雪，半夜不胜寒。\n吾道孤灯在，人寰几枕安。\n何当眩银海，清晓倚楼看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10820,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"挽委顺子王防禦","author":"方回","text":"温饱逍遥八十馀，稗官元自汉虞初。\n世间怪事皆能说，天下鸿儒有弗如。\n耸动九重三寸舌，贯穿千古五车书。\n哀江南赋笺成传，从此韦编锁蠹鱼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10821,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"甲午元日","author":"方回","text":"端平甲午臣八岁，甲午今年又一周。\n六十八年多少事，几人已死一人留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10822,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怅惋诗二首 其一","author":"方回","text":"鹦鹉笼开綵索宽，一宵飞去为谁欢？\n早知黠妪心肠别，肯作佳人面目看。\n忍著衣裳辜旧主，便涂脂粉事新官。\n丈夫能举登科第，可得妖雏胆不寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10823,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"怅惋诗二首 其二","author":"方回","text":"一牝犹嫌将两雄，趋新背旧片时中。\n陡忘前主能为叛，乍事他人更不忠。\n玉椀空亡无易马，绛桃犹在未随风。\n何须苦问沙吒利，自是红颜薄老翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10824,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"方回","text":"菊花与汝作生日，螃蟹唤吾入醉乡。\n诸公未许子为政，万事无如髯绝伦。\n糟姜三盏酒，柏烛一瓯茶。\n跳上岸头须记取，秀州门外鸭馄饨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10825,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"方回","text":"何许中原惟雁见，不多吾辈只鸥知。\n人生不作湖州守，亦合移居住霅滨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10826,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"李思衍","text":"土暗尘昏天水碧，风惊雨过女真黄。\n鬼火光中遗石马，仙盘柱下泣铜人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10827,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"严陵钓台","author":"于石","text":"抛却羊裘入汉庭，偶然高卧两忘形。\n先生无处可伸足，太史何烦奏客星。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10828,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"于石","text":"一局残棋双鹤去，石枰空倚白云寒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10829,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"贾似道","author":"刘埙","text":"三百馀年历数更，东南万里看升平。\n黄金台上麒麟阁，混一元勋是贾生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10830,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"王义山","text":"诗思已随春意动，夜衾不怕晓寒新。\n一枝潇洒无尘涴，半夜高寒对月明。\n满斟绿斝安排醉，牢裹乌纱照顾吹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10831,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"句","author":"刘边","text":"耕锄晓雨有馀地，应接东风无暇时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10832,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感旧歌者","author":"戴表元","text":"牡丹红豆艳春天，檀板朱丝锦色笺。\n头白江南一尊酒，无人知是李龟年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10833,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"武陵胜集得春字","author":"白珽","text":"今日知何日，谈诗得伟人。\n闭门方掩雪，老砚自回春。\n湖海清尊乐，乾坤白屋贫。\n时时看云色，吹落紫纶巾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10834,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四季六言诗","author":"白珽","text":"红杏绿杨永昼，野服柴门散仙。\n莫道无人知处，东风都在吟笺。\n莲叶吹香澹澹，扁舟撑影斜斜。\n惊散一行白鹭，东风捲起梨花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10835,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"春日田园杂兴","author":"仇远","text":"一湾新绿护茅庐，草细泥松已可锄。\n野老但知分社酒，地官宁复进农书。\n莺花眼界人烟外，蚕麦生涯谷雨馀。\n我爱赋归陶令尹，柳边时见小篮舆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10836,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同段吉甫泛湖","author":"仇远","text":"西湖春碧净无泥，画舫珠帘傍岸移。\n寒食清明初过后，杏花杨柳乍晴时。\n从教西日催歌鼓，莫放东风转酒旗。\n只恐明朝成雨去，暗惊浓绿上高枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10837,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"秋日西湖园亭","author":"仇远","text":"西湖一曲百泉通，漠漠青山绕梵宫。\n故国园林秋色净，明朝风雨桂花空。\n银笙玉笛清歌外，画舫珠帘落照中。\n人物风光两相称，儿童遮莫笑山翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10838,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"武陵胜集得林字","author":"仇远","text":"城中十日雪，山中三尺深。\n我从吴都来，颇畏寒见侵。\n亦念子在野，相从讵无心。\n缅怀梁园游，岂不胜竹林？\n落落岁寒友，历历瑶华音。\n重期春日和，飞盖西园阴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10839,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其一","author":"仇远","text":"我本迂疏落拓人，满头霜雪满怀春。\n登山有屐身恒健，挂壁无弦趣更真。\n往岁效官殊慢浪，老来学佛离贪嗔。\n却怜卫鹤齐鸡辈，空费心机不庇身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10840,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其三","author":"仇远","text":"懒学羊裘汉子陵，亦非解印晋渊明。\n好山好水恒相对，浮利浮名不愿争。\n诗酒每寻朋友共，田园都付子孙耕。\n野心真与閒云似，却笑孤云出岫轻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10841,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其四","author":"仇远","text":"末俗由来不贵儒，小夫小妇恣揶揄。\n束书合问山林隐，绝迹莫登名利涂。\n膝上有孙贫亦乐，门前无债醉如愚。\n咸平处士真堪羡，死守梅花住里湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10842,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"书与士瞻上人十首 其七","author":"仇远","text":"难得心交左伯桃，亦无善相九方皋。\n而今贱子多儒误，自古山人索价高。\n众雀岂能知鹄志，一鸡何足用牛刀。\n独醒独醉俱堪乐，妙理依然有浊醪。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10843,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北窗","author":"仇远","text":"北窗隐几乐吾天，莫遣新愁到耳边。\n一帽好花供醉舞，半床凉月伴闲眠。\n故人自欲辞文叔，明主何尝弃浩然。\n留取长安遮日手，养成指甲理朱弦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10844,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"高卧","author":"仇远","text":"人生天地一蘧庐，耕凿虽劳乐有馀。\n因阅杜诗删旧稿，为观羲帖习行书。\n山公醉后犹骑马，渭叟闲来只钓鱼。\n世道秋风总萧索，何如高卧白云居。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10845,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"答胡苇杭","author":"仇远","text":"久矣相期物外游，长风吹不断闲愁。\n两山翼翼青如舞，双鬓颾颾白始休。\n蕉鹿梦回天地枕，莼鲈兴到水云舟。\n旧藏方镜明如月，看去看来又一秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10846,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送王仙麓使君赴道州暂归三山","author":"仇远","text":"家山小为离支留，征旆催行莫待秋。\n应有矮奴骑竹马，相随迓吏拜兰舟。\n舜山如画当楼见，楚水浮香绕郡流。\n念我有亲头雪白，云龙追逐恨无由。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10847,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"阎氏园池","author":"仇远","text":"真妃已返凤台仙，独立池亭思怆然。\n海岳不传青鸟信，石房谁伴白云眠？\n宫桃移种难生实，院箨初翻又引鞭。\n凝碧荒凉弦管静，萍花浮满钓鱼船。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10848,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送刘竹间归庐陵","author":"仇远","text":"驿路梅花漠漠寒，绒衫絮帽出长安。\n悬知客久归心切，自觉交深别语难。\n春入西江随马去，山留残雪待人看。\n青原白鹭如相问，十载湖滨只钓竿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10849,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"新安郡圃","author":"仇远","text":"亭榭凌空眼界宽，得闲来此独凭阑。\n春浮练水蒸城润，雪被黄山入座寒。\n古树巢空群鸟散，荒池沙满碎薸乾。\n白云在望归期定，不见青油护牡丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10850,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"兵间有歌舞者","author":"仇远","text":"边尘未定苦无谋，年少金多绝不忧。\n野战已酣红帕首，涂歌犹醉锦缠头。\n蛾贪银烛那知死，月恋金尊不照愁。\n亦欲避秦高隐去，桃花源上觅渔舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10851,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"寄董无益","author":"仇远","text":"邮铃带箭发纷纷，何日山深耳不闻。\n迁客无乡难避祸，饥民失业半充军。\n马蹄乱踏湖西雪，雁阵平拖塞北云。\n我亦懒谈今世事，自看吊古战场文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10852,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"刘悦心入道三茅观","author":"仇远","text":"鹖冠高挂九松巅，去结三茅香火缘。\n相国向犹为道士，将门今又出神仙。\n坐看红日生沧岛，吟寄青衣入洞天。\n跨鹤归来云舍近，西风井邑只依然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10853,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"同杨心卿过孤山访静传不遇自游和靖祠下明日奉寄二高士","author":"仇远","text":"飞仙又向别峰游，竹下閒房且小留。\n满鬓朔风吹客帽，倚阑落日在渔舟。\n梅花路冷难寻冢，葑草田荒半作洲。\n独往独来沙鸟怪，山空木短使人愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10854,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"不应聘高士","author":"仇远","text":"束书入谷起徵君，盥耳渊栖似不闻。\n知有故人来问字，喜无逋客为移文。\n忍贫羞说黄金尽，爱老慵将白发芸。\n独倚高楼南北望，青天依旧有閒云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10855,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和范爱竹三首 其一","author":"仇远","text":"半生豪气学元龙，湖海惟知敬数公。\n徒有贞心招隐逸，恨无巨眼识英雄。\n天衢骑马衣冠异，雨屋鸣鸡杼轴空。\n西崦东屯何日了，定应愁老浣花翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10856,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和范爱竹三首 其三","author":"仇远","text":"风雨萧萧白昼昏，肃襟受此一凉恩。\n丘园不作轩裳梦，陵谷空遗斧凿痕。\n乍可扣舷歌楚泽，何堪抱瑟立齐门。\n有时散步西原上，共醉田家老瓦盆。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10857,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠金荪壁","author":"仇远","text":"黄纸红旗事已休，莫思入谷有鸣驺。\n天开东壁图书府，人立西湖烟雨楼。\n林浅易寻和靖隐，菊荒空忆魏公游。\n客来把玩新题扇，半似钟繇半似欧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10858,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"再答元父","author":"仇远","text":"騕袅龙媒去未还，独骑款段客长安。\n青黄谁采沟中断，黑白当从局外看。\n尊俎风流陈日月，山林人物古衣冠。\n桂花满袖王孙远，空倚天风十二阑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10859,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和两山二首 其二","author":"仇远","text":"穷乡何处觅新丰，身世悠悠醉梦中。\n未学伏波尸马革，且随甫里问龟蒙。\n檐头喜有桑榆日，兵后那无草木风。\n亦欲飞神游八极，扁舟坦卧不须篷。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10860,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其一","author":"仇远","text":"阶前紫蔓金丝草，篱角红垂锦带花。\n梓泽平泉易销歇，春留富贵与诗家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10861,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其二","author":"仇远","text":"树隔残钟远欲无，野云漠漠雨疏疏。\n飞蚊尽逐南风去，父子灯前共读书。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10862,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其三","author":"仇远","text":"仰屋著书无笔力，闭门觅句费心机。\n不如花下冥冥坐，静看蜻蜓蛱蝶飞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10863,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其四","author":"仇远","text":"莺花韦曲旧时游，老去闲情已五休。\n却笑东风无检束，又随飞絮过南楼。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10864,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其五","author":"仇远","text":"鸟雀喧秋未肯栖，狂风吹树影离披。\n屋边尚有斜阳在，更看山人一局棋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10865,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其六","author":"仇远","text":"风挟浓云起炮车，捎窗雨脚乱如麻。\n山中茆屋应安稳，不向溪声送落花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10866,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其七","author":"仇远","text":"新竹修修绿覆墙，读书门外亦阴凉。\n道人清福不肯受，却入西山看夕阳。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10867,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其八","author":"仇远","text":"翠袖佳人倚暮寒，双禽踏破玉阑干。\n空山月落春风换，直作罗浮梦里看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10868,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其九","author":"仇远","text":"茶瓯纱帽惯迎宾，不是诗人即道人。\n细雨斜风君莫出，绿云门外有红尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10869,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"閒居十咏 其十","author":"仇远","text":"珠帘玉栅绮罗丛，犹有承平京洛风。\n饮罢归来游骑少，一庭明月夜方中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10870,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"纪事","author":"仇远","text":"圩田平没石田枯，秋暑如蒸雨竟无。\n六十年前曾记得，步行一直过西湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":10871,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]