[{"title":"次年大卿赠张菊存","author":"龚璛","text":"借得才名重此州，州人共看菊花秋。\n从来游刃有馀地，如此佞山能拔不。\n前辈风流犹可作，一官岁月不胜遒。\n和诗若寄陵阳老，说与平生为道谋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9157,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为周静境赋玉芝","author":"龚璛","text":"双凤祥光芝盖軿，仙人来听诵黄庭。\n佩环为我飞零乱，霜露当时下杳冥。\n太华移莲秋一色，三年刻楮地通灵。\n世间久服轻身药，未用神农本草经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9158,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题赵大年小景","author":"龚璛","text":"风流文采王孙梦，景物当时处处同。\n杨柳烟轻飞燕子，芰荷水煖浴凫翁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9159,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"惠崇小景","author":"龚璛","text":"物外道人方晏坐，身如枯木倚寒江。\n鸦鸦雁雁集禅观，何似鸳鸯画一双。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9160,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"雪吟","author":"龚璛","text":"江云写愁霰，诗鬓共侵寻。\n瑞应腊前语，寒生天外心。\n冥搜归一色，兀坐了玄阴。\n玩我玉如意，微茫太古音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9161,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"饮沧浪园得红字","author":"龚璛","text":"携酒盈樽烦小童，翩然丘壑试东风。\n分畦菜本丰年玉，二月桃花一雨红。\n官事閒忙适相半，世人忧乐岂无同。\n古来乔木今谁在，濯足沧浪曲未终。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9162,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"访别郑鹏南佥事","author":"龚璛","text":"借屋青山下，移舟百里程。\n我惭徐孺子，君是郑康成。\n夜语破春梦，天寒闻霰声。\n行藏一尊酒，岁晚更同倾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9163,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵房晦叔自京口来访","author":"龚璛","text":"我愧德璋能勒文，却因久别慰辛勤。\n家乡故老来今雨，客路春阴结暮云。\n二月酒樽寒悄悄，少年心事白纷纷。\n江山只在君归处，回首无声写离群。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9164,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"物外轩分韵得饮字","author":"龚璛","text":"俗气何由来，开径入萧凛。\n驱马一日休，授以游仙枕。\n是名物外轩，分别正当审。\n万物同此生，距我不远甚。\n旦旦出世间，诊梦犹在寝。\n东风吹故衣，众客坐敛衽。\n城南学者家，九畹告春稔。\n伊谁相与娱，折兰侑清饮。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9165,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"诗会分韵得万字","author":"龚璛","text":"士生适江湖，岂必甚高论。\n天下本无事，过许无乃慁。\n君看古商君，扰扰终辕轘。\n不如渊明酒，悉索钱二万。\n于焉永今朝，良晤极缱绻。\n旭日敷春阳，爱雨满众愿。\n诸公美采芹，我亦竟忘献。\n既闻召故老，世治复何恨。\n膏雨当及时，物态竞滋蔓。\n吴侬得丰登，饱吃残年饭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9166,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋兰分韵得服字","author":"龚璛","text":"至人委蛇道，风雨化清淑。\n滨纷从何来，偃蹇灵姣服。\n采芳孰同心，可近不可俗。\n举觞对兹花，沅湘浩然绿。\n陶陶醉为醒，亹亹众所独。\n岁晏深相期，种德如种玉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9167,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"社集分韵得生字","author":"龚璛","text":"桃李向来蹊自成，閒身半见绿阴生。\n每随晓梦换时事，犹记春寒闻雨声。\n满坐嘉宾须北海，三升美酒似东平。\n清和风日江湖好，相伴长歌复短行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9168,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赋圆荷分韵得细字","author":"龚璛","text":"幽人岂无衣，遇物思芰制。\n甘脆相本根，帖妥谁点缀。\n池光展更开，雨声打还细。\n坐看青春改，不叹绿波逝。\n葺之湘累盖，抗之洛神珶。\n泥涂久甲子，铅汞方既济。\n世纷晚若遗，水中采薜荔。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9169,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偕杜懋修魏飞卿昆仲饮尊相寺前康家桃园","author":"龚璛","text":"醉倒春风酒百壶，桃花一色一千株。\n除是武陵溪上有，决定玄都观里无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9170,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次郑佥事送于寿道之慈湖长","author":"龚璛","text":"樽酒南薰别意凉，慈湖宛在象山阳。\n人生莫恨书檠短，地褊何堪舞袖长。\n亲舍云飞千里白，客篷雨涨一川黄。\n昔贤了了经行处，草木留君发旧香。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9171,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"留岳仲远处欲归赋","author":"龚璛","text":"客怀迷积阴，归梦理前路。\n筱岸散清漪，秧畴生绿雾。\n蚓鸣沮洳夜，鸠唤苍茫曙。\n我本江海人，安得扁舟去。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9172,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为邓觉非赋倦篷","author":"龚璛","text":"倦游已学渔翁，渔舟倦来掩篷。\n虾蟆䱥鱼天气，菰羹莼菜秋风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9173,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清风","author":"龚璛","text":"清风鸣禽竹解箨，窗下枕书还看书。\n老去不能知世事，向来端合爱吾庐。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9174,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王伯仪往洞庭祭龙祠同游不暇赋四绝因记昔游 其一","author":"龚璛","text":"幽洞髯龙老不眠，眼明初识醉乡仙。\n来参缥缈峰头句，付与齐州九点烟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9175,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王伯仪往洞庭祭龙祠同游不暇赋四绝因记昔游 其二","author":"龚璛","text":"石塘小泊欲三更，商估归船唱月明。\n睡觉方知过湖去，晓风芦苇作滩声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9176,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王伯仪往洞庭祭龙祠同游不暇赋四绝因记昔游 其三","author":"龚璛","text":"仙翁释子杂渔樵，容我游人问路遥。\n种树园林看驯鹿，采菱风日荡轻桡。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9177,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王伯仪往洞庭祭龙祠同游不暇赋四绝因记昔游 其四","author":"龚璛","text":"湖上西山青一螺，白头人怕白头波。\n春来秋去扁舟在，园客相邀种橘窠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9178,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"吴侬行","author":"龚璛","text":"吴侬畏雨如畏虎，不道梅霖是时雨。\n江湖占水多作田，雨来水涨无坚土。\n年年相戒筑岸围，州县施行督田主。\n纷纷何益耕者劳，鼕鼕还听踏车鼓。\n乡风种麦属农家，拾穗泥中镰不举。\n公私上下望西成，儿女插秧深没股。\n饥荒却忆四年前，百货如今尚高估。\n惟有斗米八十钱，虽贱伤农未为苦。\n此事犹应费将护，因民所利物无迕。\n诸贤炼石天可补，肯使穷阎怨寒暑。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9179,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"分韵得柳字","author":"龚璛","text":"小年不畏暑，赫日抗尘走。\n中岁得早衰，受热坐不偶。\n炎官不贷人，焦火十日久。\n一凉谢天公，物极出援手。\n不知檐间雨，为洗池上柳。\n便荫赤藤簟，来倾碧筒酒。\n此身付阴阳，了了鱼在笱。\n相逢取意醉，是名无何有。\n夷犹太平时，自称江南叟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9180,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送黄易岩访商廉访","author":"龚璛","text":"天地清溪鹤不群，百年文献足知闻。\n外家自是朱元晦，今代岂无扬子云。\n太极异同须共载，连山真伪可难分。\n故人江右三千里，荔子红时政忆君。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9181,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其一","author":"龚璛","text":"芒芒九土大，赫赫初日临。\n迢迢江之南，斯民有呻吟。\n伊谁分顾忧，志通亦惟深。\n将令被其泽，王道由仁心。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9182,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其二","author":"龚璛","text":"冗官固当汰，一手挥万蝇。\n群类虽难除，臭腐宁久凭。\n致治固有要，必去世所憎。\n彼物无已害，天民本蒸蒸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9183,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其三","author":"龚璛","text":"斯民如良苗，岂堪食根蟊。\n抵冒取其财，不尽有不休。\n汉人附五行，周家先九畴。\n正直方世用，万古清风留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9184,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其四","author":"龚璛","text":"唐人作丞相，分当食万羊。\n不知苦辛者，但取充饥肠。\n祇今天下宰，圣明登俊良。\n勿言公孙俭，布被意何长。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9185,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其五","author":"龚璛","text":"粳糯三百万，连樯发南溟。\n岁计给浩穰，来音倾耳听。\n明公顺天道，坐镇鱼龙腥。\n未羡蒋漕使，风旂立中庭。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9186,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其六","author":"龚璛","text":"菁莪正乐育，泮水涵至清。\n自公勖多士，非时无所争。\n垂帘昼閒寂，岂无读书声。\n口耳四寸间，慎思辨宜明。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9187,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其七","author":"龚璛","text":"编氓召往役，破产纳宫中。\n吁嗟不均患，兼并遂成风。\n义米可救弊，上下当齐同。\n譬如山有林，众木成其丛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9188,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次马唐卿与高参政八诗 其八","author":"龚璛","text":"吴市昔繁盛，酒垆器铮铮。\n子钱永为额，官榷久不行。\n干办责府城，醉梦相死生。\n损多以予少，人心刻嘉名。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9189,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"偕陆季道钱德钧陆友元叶彦思张仲容饮府庠荷花池上既而又自韩园至邓觉非家饮观莲分得色字韵","author":"龚璛","text":"清樽如有期，初凉意俱适。\n肯来寂寞滨，菡萏亦净植。\n陶然转乘兴，径度一圃碧。\n遥指城南家，临水更展席。\n酒狂易为仙，风便香堪食。\n空宇无能尘，物我皆醉色。\n谁言鬓已秋，始得痛饮力。\n愿将花上露，为洗坐中客。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9190,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜凉偶题寄子中弟 其一","author":"龚璛","text":"夜凉细雨枇杷树，相送无眠到枕前。\n何时酿熟山中酒，却数东游二十年。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9191,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜凉偶题寄子中弟 其二","author":"龚璛","text":"岁岁言归归未得，家书不复送归期。\n看云忆弟在何许，三百里程长别离。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9192,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜凉偶题寄子中弟 其三","author":"龚璛","text":"石门小坞五州南，二父遗基履见庵。\n租户田间斲秧马，墓人雨过扫松蚕。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9193,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜凉偶题寄子中弟 其四","author":"龚璛","text":"五岳名山终遍游，今人那复晋风流。\n向来婚嫁无难事，及至中州见白头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9194,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"夜凉偶题寄子中弟 其五","author":"龚璛","text":"吴中粳稻甲天下，我种薄田当水涯。\n梅霖本为岁太旱，百亩其如数口家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9195,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王得臣护亲丧归平阳卷","author":"龚璛","text":"北人莫作江南土，陟屺之悲贫莫伤。\n辛苦平阳王孝子，三千里外护亲丧。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9196,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题高氏诗卷","author":"龚璛","text":"景德禦戎渡河时，王曰曷不吟一诗。\n逮其后世富有作，共维圣母元祐脚，国破家亡出古壁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9197,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"日夕佳为义上人赋","author":"龚璛","text":"朝来常见山，不暇为山计。\n日夕山最佳，山僧此时睡。\n牛羊久下来，飞鸟泊林际。\n寄语陶渊明，是真即非意。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9198,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李飞卿所藏郑子实竹石","author":"龚璛","text":"归来乎山中，荆薪煮白石。\n周碧恍已化，殷墨久不食。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9199,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次陆梅南兰桂玉簪三花卷","author":"龚璛","text":"偃蹇淮山隐，离骚楚国清。\n玉簪凝思冷，香墨扫秋横。\n一水空明净，三花色界轻。\n人间较多品，于此已忘情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9200,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题丁生所藏钱舜举山水","author":"龚璛","text":"寒溪深无鱼，扁舟小如屐。\n举世相为浮，更用一篙力。\n画彼山中人，憩此松下石。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9201,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"病起试笔十韵","author":"龚璛","text":"积雨弥空阔，翩翩多去舟。\n将家值卑湿，无事得清幽。\n安石非高卧，文园已倦游。\n壮心释如意，短发寄搔头。\n病约山容瘦，闲窥雁影浮。\n双扉寒自语，一榻澹相留。\n香篆纡萦晚，画屏潇洒秋。\n黄花荒古道，白月起沧洲。\n不死千年药，平生百尺楼。\n暂分仙枕梦，遥访羽人丘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9202,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王宽斋送菊 其一","author":"龚璛","text":"闭门伏枕重阳过，病起谁来伴病夫。\n王家园里秋光好，须送黄花三两株。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9203,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王宽斋送菊 其二","author":"龚璛","text":"忆与诸贤入醉乡，黄金得意买秋光。\n微红淡白相辉映，遮莫雨来深院荒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9204,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王宽斋送菊 其三","author":"龚璛","text":"今朝无事要花开，盛酒老盆移菊栽。\n若觅庾冰犹在此，信知陶令早归来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9205,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉茶二首 其一","author":"龚璛","text":"窗外西风开玉茶，春山传味更传花。\n年年冰雪通红火，纵不同时总一家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9206,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"玉茶二首 其二","author":"龚璛","text":"乳白晴云瀹嫩茶，秋江一色赋奇花。\n鬓丝禅榻看花笑，惟有玉川真当家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9207,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"白扁豆","author":"龚璛","text":"小园闲种药，白豆近花篱。\n蔓草浑相亚，酴醾不自持。\n我衰方采采，秋实正离离。\n幸约繁香在，平生见事迟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9208,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山药歌","author":"龚璛","text":"绿薜紫藤缃色子，种玉绵延春透髓。\n晴虹岁晚寒不起，托命长镵山谷里。\n小隐墙东整药栏，斸土政得才槃槃。\n服食相传养生诀，茂陵刘郎和露啜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9209,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"牟大卿挽诗","author":"龚璛","text":"宦业遭时运，儒先保寿龄。\n来徵宋文献，竟是蜀沈冥。\n清节衣冠古，吉人山水灵。\n高门久阴德，诸子用遗经。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9210,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"藩邸洪子深参军得旨江南印儒书归国次韵张清夫所赠以赠之","author":"龚璛","text":"闻君结客满金台，多是贤王推挽来。\n汉殿早朝分使节，扬州春兴动官梅。\n海东贸易鸡林贾，天下文明凤诏开。\n归载图书广恩赐，新正同赴万年杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9211,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题黄葵卷","author":"龚璛","text":"谁念相如渴，仙盘露正寒。\n秋风茂陵客，不见紫金丹。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9212,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次仇山村见寄","author":"龚璛","text":"故旧相望怜索居，病身禅榻了无馀。\n从知聚散等成梦，却要寒温多寄书。\n四海定交吾靡靡，浮云方驾自鱼鱼。\n唯君尊酒论量好，出口他人得我徂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9213,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"送杜义方台掾","author":"龚璛","text":"物我相忘杜德机，阊门别意立霜威。\n春前春后梅初白，巷北巷南人渐稀。\n社里诗章常直草，台端掾史最褒衣。\n升平气象身亲见，执法光辉拱太微。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9214,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次张正卿平江伯见赠","author":"龚璛","text":"车马匆匆不我过，诗书亹亹奈君何。\n邻墙烛影夜未艾，客路梅花春渐和。\n佳士逢时文苑传，小人有分力田科。\n支颐送远阳湖上，急雪回风生意多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9215,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郑子实著色溪山渔乐图","author":"龚璛","text":"东风忽来吹绿雨，闲云更学苕花舞。\n山中之人归未归，溪上渔舟泛春渚。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9216,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"社集陈行之家不能往分韵得几字","author":"龚璛","text":"气如牵丝汗如水，小窗长凭乌皮几。\n六合一甑蒸雨山，矫然欠伸望诗垒。\n城南城北三十里，出门何之茧余趾。\n平生投辖是谁家，岂不相寻醉乡里。\n昨朝疏食常见邀，已怕青鞋在泥滓。\n高堂众彦集清风，脱略边幅去臧否。\n况我从来有成约，往又不勇嗟委靡。\n江湖虽宽暑雨深，彼蒲与荷美人美。\n安得提携冰雪仙，直上虚空驰騄駬。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9217,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"分得牖字","author":"龚璛","text":"南州候炎蒸，端居启窗牖。\n及兹窘繁阴，时雨无乃久。\n凉朝掩书坐，霁旭閒门守。\n雅集登高堂，爽朗在俎豆。\n旷怀何以娱，新筠绿于酒。\n生物趋化功，我亦非敢后。\n愿言玉烛和，岁事望农亩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9218,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题小米云山","author":"龚璛","text":"分流冈下石门湾，日日白云如此山。\n薄暮米坟松枥暗，扶筇曾与一僧还。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9219,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"锡山道中","author":"龚璛","text":"忆昨理征棹，郊源微绿初。\n一水霁寒碧，前村生远墟。\n何如带笭箵，政复在籧篨。\n客里问啼鴂，江南人欲锄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9220,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]