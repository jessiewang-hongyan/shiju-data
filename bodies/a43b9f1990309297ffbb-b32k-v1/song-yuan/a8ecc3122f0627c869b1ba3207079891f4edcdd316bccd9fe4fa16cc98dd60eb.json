[{"title":"道山座主先生平章吕公挽歌辞五首 其四","author":"方回","text":"昔仆叨名第，繄谁极作成。\n首捐登仕诰，误掇别闱□。\n□□人皆喜，权臣独不平。\n可怜身欲死，无以报平生。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2971,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"道山座主先生平章吕公挽歌辞五首 其三","author":"方回","text":"□公三十岁，死守汉阳城。\n焉得江陵阃，能支鄂渚兵。\n椿庭才不起，槐府已无情。\n最恨木绵鬼，乾坤一掷轻。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2972,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"道山座主先生平章吕公挽歌辞五首 其二","author":"方回","text":"乃翁同此老，两柱共擎天。\n初作二千石，才生十九年。\n汉阳□最大，岭外帅何缘。\n极恨湖滨相，奸臣喜弄权。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2973,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"道山座主先生平章吕公挽歌辞五首 其一","author":"方回","text":"一门真将相，天地间生之。\n表海太公望，封王郭子仪。\n□□堪袭阃，跨灶早持麾。\n福寿完终始，人□□□□。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2974,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感叹三首 其三","author":"方回","text":"孰识维摩病，犹疑子夏肥。\n少曾逢顺境，动辄履危机。\n奕局雨斜湿，吟笺风急飞。\n夜寒逢恶客，酒尽未云归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2975,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感叹三首 其二","author":"方回","text":"长歌归去来，无乃已迟哉。\n遇事佯如聩，从人唤作呆。\n胡僧需酒肉，戍卒借亭台。\n岂不二千石，闲居自可咍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2976,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感叹三首 其一","author":"方回","text":"浪说千军战，空登二纪名。\n乾坤恩甚大，毫发事无成。\n长日柴门掩，閒人俗眼轻。\n窃花无力护，笑道近专城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2977,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感旧","author":"方回","text":"春暖莺簧绝，宵寒鬼燐微。\n美人应骨朽，华屋已灰飞。\n巷陌名空在，毗邻事总非。\n昔贤歌麦秀，不必泪沾衣。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2978,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感事","author":"方回","text":"直道难容世，深言易绝交。\n但称司马好，勿解子云嘲。\n彼自盟黄棘，吾宁藉白茅。\n一竿至清水，归去老江郊。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2979,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"感昔","author":"方回","text":"古郡峰峦拥，吾家望最奇。\n水疑无去处，树少不阴时。\n岘首名犹在，西州意自悲。\n典刑与风景，宁复后人知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2980,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"数日项颊颧咽肿痛发中有疮","author":"方回","text":"有生必死理之常，酒到何为不举觞。\n未问刘伶坟上土，何妨张咏鬓边疮。\n叔和解诀行尸脉，仲景工言越婢汤。\n知命吾当谢医药，服膺参也战兢章。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2981,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"新晴过张村旧巡检寨","author":"方回","text":"干戈踰一纪，几度此江边。\n近觉全无盗，仍欣粗有年。\n炊烟生古屋，晴日照新船。\n犹忆纷纭际，偷生尽可怜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2982,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"楼夜","author":"方回","text":"危栏空阔上，牛斗转天心。\n为底常无寐，频来故独临。\n船声终夜静，楼影半河阴。\n诗就忘工拙，随宜莫苦吟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2983,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"溪阁呈陆太初","author":"方回","text":"临水看山日百回，等閒收拾有诗才。\n老松于我几年长，啼鸟无名何处来。\n病发渐应彫翠葆，衰踪那复梦金台。\n鹔鹴未敝犹堪典，聊挽秋花荐酒杯。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2984,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"溪涨","author":"方回","text":"立春犹二日，涨雨一何深。\n秀足明吟眼，危如撼旅心。\n仆愁前店闭，马怯小桥临。\n不见兵氛起，溪西好竹林。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2985,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"简张中白","author":"方回","text":"畴昔兵兴岂料今，朱幡犹忆对青衿。\n棠郊自愧无遗爱，芹泮遥知有好音。\n练水招予归旧隐，锦峰输子擅清吟。\n岂无樽酒能娱客，黄浦门头一再斟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2986,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"简郑高士二首 其二","author":"方回","text":"再见湖东岸，迁居傍废城。\n鹭群窥钓石，荷气馥棋枰。\n歉岁难羁旅，泥途厌步行。\n幽怀徯清话，岂不向君倾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2987,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"简郑高士二首 其一","author":"方回","text":"忆昔西湖北，闲寻隐士庐。\n水滨维舴艋，屋角认棕榈。\n红出仙人酒，黄披老氏书。\n写真元有约，隔岁定何如。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2988,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"简赵宾旸","author":"方回","text":"书生豪侠味终酸，诗客颠狂骨本寒。\n趋就坦夷非不欲，屈蟠老硬亦良难。\n故将军已编民伍，冷广文犹齿学官。\n何处浊醪谋一斗，能来相送上严滩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2989,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"解闷","author":"方回","text":"苦吟成癖习，多难迫衰年。\n生理终无赖，诗名似许专。\n刚肠百鍊劲，老笔万钧悬。\n得失元相半，乾坤本不偏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2990,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"频醉","author":"方回","text":"红尘谪堕侍晨仙，屈指明年六十年。\n身后不营埋骨地，春来频醉赏花天。\n屡闻汉相诛东市，深羡周农服下田。\n烜赫岂如常寂静，山中幸有酒如泉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2991,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"慵起","author":"方回","text":"慵起披衣出户迟，今年最喜免招医。\n粗容破灶炊云子，可用芳筵佐雪儿。\n醉后作诗多不记，梦中读易了无疑。\n雨晴风爽园林密，独立清阴过午时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2992,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鄱阳道中","author":"方回","text":"舟楫仍鞍马，年年事远征。\n长禁波浪恶，罕见道途平。\n诗酒唯疏放，乾坤尚甲兵。\n吾衰甘已矣，正尔负平生。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2993,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"鲜于伯几举近诗有一官屡厄黄杨闰之句忘其全联因赋呈之","author":"方回","text":"与世相违已背驰，樽前各举近吟诗。\n一官屡厄黄杨闰，万卷难充画饼饥。\n浪说炎蒸今可畏，悬知摇落即堪悲。\n山潜涧蛰吾当去，自有髯侯奋迅时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2994,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉题二首 其二","author":"方回","text":"卖花人憩小楼前，买几枝看日典钱。\n诗向梦中频□□，□才醉后便如仙。\n贫閒略比陶元亮，老寿将过白乐天。\n□□定为林下计，严滩西向练溪船。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2995,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉题二首 其一","author":"方回","text":"倏忽侵寻八十翁，平生学问见诗中。\n可因道术仙能到，何用禅言佛不同。\n是是非非双鬓白，莺莺燕燕百花红。\n太岁壬寅题此句，小楼买酒酹东风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2996,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"醉醒","author":"方回","text":"酒所春归暮，醒时已五更。\n被惊横盖短，灯喜再挑明。\n小雨馀残滴，群蛙动暖声。\n故园花正好，谁料客湓城。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2997,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题一家清雅集送植芸胡直内","author":"方回","text":"累朝科第总名臣，四世能诗才二人。\n参透雄深兼雅健，锻成俊逸更清新。\n马班翁季羞前躅，王谢云仍踵后尘。\n颇恨昔叨桐濑守，未能绣梓励儒绅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2998,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题三苏先生族谱后","author":"方回","text":"眉山万古老苏仙，坡颍儿孙世世贤。\n尚想九关排虎豹，□须七叶珥貂蝉。\n何人不作无穷地，今日才知已定□。\n绍述奸朋市朝挞，剡源学士笔如椽。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":2999,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题文文山天祥遗墨","author":"方回","text":"年踰弱冠唱枫宸，海内文章第一人。\n孰谓国家无厄运，从来天地有忠臣。\n此声不朽垂千古，今岁犹存仅七旬。\n二十五年九原底，刚风夜夜薄星辰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3000,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题王瓛王圭母郭氏义节记","author":"方回","text":"老儒致聘女师儒，二十言归四十夫。\n令弟阶庭骈两玉，贤郎门户俨双珠。\n摽梅迨吉年虽浅，汎柏维仪志不踰。\n冠帔笏袍相照映，称觞真可画成图。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3001,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题立上舍草意","author":"方回","text":"万派江河尽向东，秋风摇落又春风。\n性灵根本元相似，躯壳胚胎偶不同。\n蝼蚁阶前藏窟穴，蜘蛛檐外挂虚空。\n家中子女兼鸡犬，尔我无非乐意中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3002,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题孙元京近诗","author":"方回","text":"后生如猬总能诗，骨弱瞳昏俗不治。\n忽似再生萧德藻，已应突过李之仪。\n扫红紫阵观黄落，悬万千钧系一丝。\n精刮洁磨犹未已，直须陶谢与同时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3003,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题观妙轩","author":"方回","text":"前身恐是靖庐公，手擘崔嵬栋此宫。\n拔地三三屏特起，藏天六六洞潜通。\n渊明山气忘言外，太白秋声静坐中。\n一洗丹玄童子眼，待看鸾鹤下晴空。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3004,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题李提举心远轩","author":"方回","text":"心远渊明拟问之，悠然身世见山时。\n强名真意元无物，缘底忘言更有诗。\n宇宙襟怀千斛酒，王侯勋业一枰棋。\n古来大隐在朝市，可待休官办菊篱。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3005,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题汪氏孝节堂","author":"方回","text":"三从分定付之天，捧案曾无月再圆。\n莱子方同綵衣舞，鄘风忽赋柏舟篇。\n频年兵革经多难，奕世门闾喜独全。\n孝节从来足阴相，儿孙衮衮寿眉前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3006,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题沈克己无名庵","author":"方回","text":"姓字人能说，无名意谓何。\n厌称穷学究，佯作老头陀。\n宗炳疑相似，韩康定见诃。\n有来问谁某，祇是笑呵呵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3007,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题陈仲良宅观古物及徐熙来禽卷","author":"方回","text":"车书一统混乾坤，福地钱塘户口蕃。\n治世故□□巨室，吉人宜尔保名门。\n金玉印章文物古，丹青图画典刑存。\n来禽几颗徐熙笔，欲摘红鲜荐酒樽。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3008,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题苦竹港寓壁","author":"方回","text":"三十年前此路行，来车去马唱歌声。\n旗亭沽酒家家好，驿舍开花处处明。\n白羽宵驰四川道，青楼春接九江城。\n如今何事无人住，移向深山说避兵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3009,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题金明府平易堂","author":"方回","text":"桑畴麦陇颂声欢，竞说琴书政事宽。\n方寸惟知存岂弟，丝毫不肯作艰难。\n爱民何啻如儿子，行路休教避长官。\n来往星源凡几岭，从今都作坦途看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3010,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题徐子愚道悦堂二首 其二","author":"方回","text":"高门可旌表，潇洒郡城西。\n沼有王祥鲤，埘无郭泰鸡。\n寒衣催妇织，奇字课儿题。\n堂上慈颜近，家人语亦低。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3011,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题徐子愚道悦堂二首 其一","author":"方回","text":"往年辞膝下，侯頖领儒冠。\n远忆门闾望，遄归涧谷盘。\n即今惟教子，不肯更求官。\n何限公台贵，亲颜未必欢。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3012,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题郭元德寓意斋藁后","author":"方回","text":"一砚随身一棹轻，斗南斗北仰诗名。\n岂真寓意不留意，□恐无情还有情。\n瘦岛独敲逢尹诘，癖陵宁死要人惊。\n□□自号异商隐，妥律平平仄仄平。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3013,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题程氏麟嘉寿域","author":"方回","text":"当年此地瑞麒麟，预卜佳城寿槚春。\n早把一官为长物，永期千岁作全人。\n盈消虚息知时命，战履兢临保性真。\n马革裹尸空志大，宁骑款段了閒身。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3014,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题魏公辅诗卷","author":"方回","text":"年少学诗歌，悲欢忌太过。\n未能全劲瘦，已觉近平和。\n嫩檗随时摘，微瑕极力磨。\n成名待三十，存藁不须多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3015,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"憩老","author":"方回","text":"憩老千山里，投閒五载馀。\n直令艰日籴，何用恋乡居。\n白傅欲卖宅，虞卿空著书。\n秋园菊篱好，荒草欠人锄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3016,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠山翁","author":"方回","text":"箐果崖芝日足餐，卖薪时亦下云端。\n邻家有酒常同醉，晚岁无衣不叹寒。\n黑白石充棋子用，青黄树当历头看。\n须眉不愧商山皓，可待为人作羽翰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3017,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠方太初三首 其三","author":"方回","text":"秋崖元不死，梦寐想仪刑。\n纵使长松倒，终殊众草零。\n群儿夺朱紫，之子出蓝青。\n可惜科场废，难徼笔砚灵。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3018,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠方太初三首 其二","author":"方回","text":"秋崖仙去久，犹有竹溪君。\n合草金銮诏，频惊铁马群。\n川遥鱼素断，风急雁行分。\n贺忽翻为吊，伤心寄些文。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3019,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠方太初三首 其一","author":"方回","text":"秋崖宗老在，馀子眇乡原。\n奎壁悬文宿，嵩衡镇厚坤。\n求田饶许汜，叱驭笑王尊。\n贤与愚俱尽，天难问九门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3020,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠吕肖卿三首 其一","author":"方回","text":"虽未登三十，知君已几年。\n先师斧脩月，名父柱擎天。\n失怙初周晬，耽吟早极玄。\n孤身能自立，万卷绝芸编。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3021,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠吕肖卿三首 其二","author":"方回","text":"千万人丛里，应难一一寻。\n政须真具眼，始可与关心。\n匠手斤忘垩，禅机芥遇针。\n绝弦吾欲理，忽复有知音。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3022,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠地理齐君龙吉","author":"方回","text":"积善出公侯，今于葬地求。\n樊崇如叵测，郭璞殆徒谋。\n折臂终难验，控颐自可忧。\n未抛金锁甲，焉问土馒头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3023,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠存古杨茂盛卿","author":"方回","text":"卷轴年深碎破时，我能补苴以完之。\n惊逢大桁重华典，喜见由庚束皙诗。\n王会周篇汲郡冢，儒生秦颂泰山碑。\n装潢作手今无敌，消得朝天驲骑驰。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3024,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠孙元京近以诗见示二首 其二","author":"方回","text":"举世无高见，斯文有正音。\n稍工仍要拙，宁古不为今。\n末俗难容喙，空言苦用心。\n未妨全瘦劲，却恐太幽深。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3025,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠孙元京近以诗见示二首 其一","author":"方回","text":"道岂与身穷，相逢两秃翁。\n高怀真悃悃，薄艺愧空空。\n同谷吟山雪，愚溪感候虫。\n斯人何可作，尚获见馀风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3026,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠朱师裕","author":"方回","text":"相府违离二十年，弁兮突见外孙贤。\n故因高韵如袁粲，岂但雄文似史迁。\n兵甲喧豗征马地，音书断阻去鸿天。\n因君略得平安信，诸老无多重怆然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3027,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠相士雷月篷","author":"方回","text":"肯着双瞳子，来看一秃翁。\n短篷君载月，孤屋我吟风。\n篯耳终遗骨，松乔竟落空。\n痴人喜甜舌，谁悟大槐宫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3028,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠相士蔡槐","author":"方回","text":"肠腹自蝉龟，从渠作庙牺。\n讵应身食肉，乃使世攒眉。\n子勿工皮相，吾终欠口医。\n华亭唳秋鹤，今复几人思。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3029,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠胡直内并寄夏自然","author":"方回","text":"直内苦吟今贾孟，自然近作欲韦陶。\n曩时场屋犹无恙，前辈科名许独高。\n诗句孰能传海内，官衔仅足诧儿曹。\n雁门太守何为者，为道深衣胜紫袍。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3030,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠胡端本显伯教谕二首 其二","author":"方回","text":"芙蓉岭外矮窗开，夜读灯从祖父来。\n四海八荒□□□，□山一壑绝尘埃。\n生涯晚节香黄菊，世德清阴映绿槐。\n□□仲车教乡里，何时除目下行台。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3031,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠胡端本显伯教谕二首 其一","author":"方回","text":"星□□□□诸胡，乡里人人仰范模。\n韬养沉潜求大□，□挥□□号通□。\n□生不出跧吟屋，垂老□□□□□。\n□□旧坑砚中觅，浮溪汪氏遁翁朱。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3032,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"赠送鹤田李元晖","author":"方回","text":"一别九寒暑，乾坤事事新。\n老身馀长物，故友尽穷人。\n汩汩犹群盗，时时有战尘。\n少陵诗眼在，试觅曲江春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":3033,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]