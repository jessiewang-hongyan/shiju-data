[{"title":"句 其一","author":"戴表元","text":"酣歌待约东邻伴，泼面晴风涨酒澜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9040,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"潇江亭","author":"于石","text":"背依古塔面层峰，曲曲阑干峻倚空。\n万屋参差江色外，片帆出没树阴中。\n五更钟鼓半山月，两岸渔樵一笛风。\n极目子陵台下路，滔滔惟有水流东。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9041,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次胡苇杭韵","author":"仇远","text":"连作湖山五日游，沙鸥惯识木兰舟。\n清风寒日荒城晚，燕子梨花细雨愁。\n赐火恩荣皆旧梦，禁烟风景似初秋。\n凤丝龙竹繁华意，犹为西林落日留。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9042,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"陪戴祖禹汎湖分韵得天字","author":"仇远","text":"冉冉夕阳红隔雨，悠悠野水碧连天。\n山分秋色归红叶，风约蘋香入钓船。\n钟鼓园林已如此，衣冠文物故依然。\n当歌对酒肠堪断，倒著乌巾且醉眠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9043,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"集庆寺","author":"仇远","text":"平生三宿此招提，眼底交游更有谁。\n顾恺漫留金粟影，杜陵忍赋玉华诗。\n旋烹紫笋犹含箨，自摘青茶未展旗。\n听彻洞箫清不寐，月明正照古松枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9044,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"田家杂兴三首 其二","author":"方一夔","text":"两两苍髯笑杖藜，茜裙儿女隔笆篱。\n斜阳鸦噪烧钱社，细雨牛眠放牧陂。\n酒熟十千沽玉瀣，面香三丈捲银丝。\n客来偶及兴亡事，说与衰翁也自知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9045,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"田家杂兴三首 其一","author":"方一夔","text":"樵路通村暗蒺藜，数椽茅蕝护疏篱。\n阴阴清樾风生树，拍拍苍鹅水满陂。\n记日旋锄烧地粟，上时新卖落车丝。\n晚晴惭愧逢端午，醉卧黄昏自不知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9046,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"早行","author":"方一夔","text":"早行理归装，残灯耿曙光。\n开门半山月，立马一庭霜。\n钟响知云寺，波声认石梁。\n脩途留不住，去去出山庄。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9047,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"晚眺二首 其一","author":"方一夔","text":"依稀风景小羌村，不欠东屯稻菽园。\n阿魏捣香风送响，雕胡擘玉水开痕。\n招邀紫翠山当座，摽拨红黄菊上盆。\n世上去来俱是客，随风吹送梦归魂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9048,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"游天竺后山","author":"白珽","text":"山转龙泓一径深，岚烟吹润扑衣巾。\n松萝掩映似无路，猿鸟往来如有人。\n讲石尚存天宝字，御梅尝识建炎春。\n城中遮日空西望，自与长安隔两尘。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9049,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"和刘朔斋海棠","author":"牟巘","text":"人物当今第一流，以花为屋玉为舟。\n晓妆未许褰帏看，夜醉何妨秉烛游。\n锦里宣华思旧梦，黄州定惠起新愁。\n何如归伴徐公饮，稳结一巢花上头。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9050,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"水龙吟","author":"陆文圭","text":"燕芹香老春深，微风飐动新篁翠。\n惊敲梦断，忙呼小玉，故人来未。\n香缕筛帘，游丝堕几，暖薰花气。\n问春随莺到，又随燕去，谁解得，东君意。\n涧水流红影里。\n小楼东、有人孤倚。\n残桃着雨，鬓容撩乱，未堪妆洗。\n冉冉年光，悠悠时事，不如沉醉。\n更韦娘一曲，司空惯见，也应回睇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9051,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"水龙吟 次药房韵","author":"陆文圭","text":"西州玉局飞仙，霓裳曾侍槐龙翠。\n飞花丽句，雅音犹在，有人赓未。\n千载峨峰，一江川练，又练清气。\n叹瀛洲路近，刚风吹断，漫自有，凌霄意。\n草碧寒窗静里。\n折琼枝、小栏同倚。\n新吟婉美，西施态度，慵梳洗。\n按羽调丝，雪儿薄相，为君心醉。\n恨高楼暮隔，江城花暗，碧云遥睇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9052,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"阮郎归 舟中赋所见","author":"陆文圭","text":"风吹一捻柳腰轻。\n春柔力未胜。\n眉儿喜学远山青。\n终朝画不成。\n娇滴滴，笑盈盈。\n雏莺叶底声。\n花梢雨过夕阳明。\n无情渐有情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9053,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"沁园春 送李同知之官邺都","author":"陆文圭","text":"东西二都，史载循良，不五六人。\n记南阳有召，颍川有霸，并州如郭，河内如恂。\n直比朱弦，清伴古镜，吏自秋霜民自春。\n如公者，守廉平二字，近古名臣。\n棠阴手种方新。\n又五马翩翩邺水滨。\n想台高铜雀，尚留遗迹，堂深画锦，空锁凝尘。\n琴瑟从容，雅歌缓带，美政遥知达紫宸。\n期年后，看快行宣召，班冠廷绅。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9054,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"沁园春 送杨伯可","author":"陆文圭","text":"雨足江皋，月满中秋，使客将归。\n看扁舟空载，贫无长物，破囊收贮，富有新诗。\n清白传家，怀金不受，洁已从来畏四知。\n民何幸，尽相安南里，乐业熙熙。\n谁知经界良规。\n是三代相传古法遗。\n要讲明有素，施行不扰，宽严相济，表里无私。\n惭愧偏州，久淹老子，却怪朝家选用迟。\n公子去，定致身鹓序，接武龙墀。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9055,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇","author":"陆文圭","text":"延年有术，飧古松根下，茯苓千岁。\n纵是延年如何益，命也道之将废。\n思古之人，词章节行，杲杲行当世。\n遗风流韵，渊然尚有余味。\n无奈先哲凋零，后生坦率，多以儒为戏。\n每笑唐人书不读，直把黄金买贵。\n山泽奇才，云林真隐，没齿何曾遇。\n人生如梦，江流日夜东去。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9056,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇","author":"陆文圭","text":"茂林修竹，自山阴散后，几番陈迹。\n修禊年年春故事，懊恨风流非昔。\n当日兰台，后来菊圃，苗裔江南北。\n睹君雅号，恍然旧事重忆。\n岁晚木落天寒，黑貂将敝，尚作新丰客。\n星斗胸中空灿烂，磨蝎空名何益。\n袁吕相逢，知音一笑，肉眼无人识。\n访予梅屋，谈天聊慰孤寂。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9057,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇 洛阳耆英会二首 其一","author":"陆文圭","text":"戴花刘监，算耆英会上，与吾同岁。\n伊洛山川今如古，人事几番兴废。\n梦枕初残，黄粱未熟，已换人间世。\n箪瓢钟鼎，看来一等滋味。\n天上赤白双凡，东来西往，出没真儿戏。\n惟有神仙长年诀，长似功名富贵。\n欲捣玄霜，难寻玉杵，何日蓝桥遇。\n裴郎老矣，云英那肯随去。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9058,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇 送幕职","author":"陆文圭","text":"残花剩柳，正啼鹃声里，邮亭别馆。\n三叠阳关听未彻，手执离杯引满。\n政坐诸君，久烦老子，今日才萧散。\n翩然归去，故园绿树春晚。\n人世苍白浮云，自舒自卷，不入高人眼。\n官事如麻何日了，输与闲中不管。\n翠柏台高，紫薇省近，别有清华选。\n功名岁晏，江城回首天远。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9059,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"念奴娇 赠王道人性初归茅山","author":"陆文圭","text":"芙蓉城郭，有羽仙骑鹤，来从何处。\n曾拉茅君峰顶会，瑶佩随风吹去。\n玉笈偷开，青囊拾得，笑看人间世。\n藏身壶里，个中别有天地。\n共约手种蟠桃，缀花结实，已是三千岁。\n欲脍长鲸麟作脯，倒海聊供一醉。\n偶忆寒梅，更惭小草，拂袖怀归计。\n蓬莱清浅，云帆他日相遇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9060,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"金缕曲 代送同僚","author":"陆文圭","text":"乍到蓉城路。\n听儿童歌谣德政，感恩如父。\n好人西京循吏传，谁道今人非古。\n留遗爱、甘棠佳树。\n节操冰霜清凛凛，看和风、吹作阳春雨。\n程去速，遽如许。\n我来不见空怀伫。\n望彼美、碧云暮合，草萋南浦。\n信是有才供世用，敢择东西何处。\n又谁念、婴儿思乳。\n不恨使君吾不识，恨使君不与吾相辅。\n聊寄意，短长句。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9061,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"临江仙","author":"陆文圭","text":"听得雅歌珠一串，飒然吹动梁尘。\n尊前重见旧时人。\n主人情未重，情重是嘉宾。\n飞絮落花无定在，近前遮莫谁嗔。\n文园倦客最伤神。\n野亭何处泊，空忆画堂春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9062,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"点绛唇","author":"陆文圭","text":"永夜无聊，更堪点滴听檐溜。\n枕寒难就。\n堆乱床衾绣。\n人面桃红，还忆擎将手。\n君知否。\n倚门独守。\n又是清明后。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9063,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"点绛唇","author":"陆文圭","text":"闷托香腮，泪痕一线红膏溜。\n将身错就。\n枉把鸳鸯绣。\n柳带青青，攀向行人手。\n天知否。\n白头相守。\n破镜重圆后。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9064,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"点绛唇","author":"陆文圭","text":"笑靥多羞，低头不觉金钗溜。\n凭媒将就。\n凤枕回双绣。\n月地云阶，何日重携手。\n心坚否。\n齐眉相守。\n愿得从今后。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9065,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"点绛唇","author":"陆文圭","text":"小立娉婷，歌声低遏行云住。\n不胜珠翠。\n玉面慵梳洗。\n除却姚黄，魏紫谁堪比。\n君描取。\n卷中人美。\n得似崔徽未。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9066,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"点绛唇 情景四首","author":"陆文圭","text":"玉体纤柔，照人滴滴娇波溜。\n填词未就。\n迟却窗前绣。\n一幅花笺，适与何人手。\n还知否。\n孤灯坐守。\n渐入黄昏后。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9067,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐多令","author":"陆文圭","text":"花下笑声微。\n莺喉高又低。\n怪穿花、粉蝶成围。\n唯有禅心清似水，相对坐，两忘机。\n莫道絮沾泥。\n狂风也解飞。\n恨残春、九十将归。\n回首阳台云缥缈，愁薄暮，雨霏霏。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9068,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"唐多令 寄远","author":"陆文圭","text":"明艳注秋波。\n轻松绾髻螺。\n怕逢人、先敛双蛾。\n怯雨羞云情未稳，佳会少，远离多。\n梁绕忆清歌。\n兰舟肯再过。\n为他垂泪染香罗。\n欲倩鳞鸿将锦字，知别后，意如何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9069,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"浣溪沙 次伯机","author":"陆文圭","text":"翠玉峰高鹭点明。\n縠纹波动鸭雏生。\n湖山宜雨又宜晴。\n越女荡舟莲叶碧，裴郎驻马柳阴青。\n折花调客诉衷情。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9070,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"减字木兰花","author":"陆文圭","text":"双鬟耸翠。\n低护金莲裙窣地。\n铁石心肠。\n无奈梅花一点香。\n歌声梁绕。\n流水泠泠云杳杳。\n白发刘郎。\n对景须拚醉一场。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9071,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"减字木兰花慢 和心渊春雪词","author":"陆文圭","text":"怪东风太早，未灯夕放琼花。\n是何处瑶姬，来看玉树，光彩交加。\n野人但知三白，喜新年、天意荐休嘉。\n肯念兵屯北塞，谁上表，贺南衙。\n西斜日影檐牙。\n又被黑云遮。\n叹病骨支离，别怀萧索，空负年华。\n鳌山已成春梦，归去来，空谷卧烟霞。\n却笑昌黎才子，浪吟逐马随车。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9072,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"减字木兰花慢 滕王阁","author":"陆文圭","text":"九皋明月夜，跨一鹤赴仙都。\n听佩玉锵鸣，骖鸾小住，高阁凭虚。\n萋萋草生南浦，兴未阑、归去东吴。\n笑指尊前二客，昨宵良会非欤。\n庄周蝴蝶两蘧如。\n变化一华胥。\n叹物换星移，壶中日月，镜里头颅。\n芳洲独醒人在，采芙蕖，岁晏孰华予。\n欲泛兰舟容与。\n烟沙漠漠重湖。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9073,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"减字木兰花 即席赠歌者夏奴","author":"陆文圭","text":"香肌玉润。\n花前忽听流莺韵。\n移步金莲。\n斜转清眸踏舞筵。\n因娇无力。\n蜀锦缠头拚百尺。\n安处奴乡。\n且住容山过夏凉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9074,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"探春慢 和心渊己巳元夕韵","author":"陆文圭","text":"细草黏冰，疏林补雪，衰翁未觉春暖。\n曝背低檐，燎衣破灶，谁识舞台歌馆。\n乐事如今懒。\n谢邻伴、东招西唤。\n何消看试华灯，月光今夕圆满。\n念昔繁华帝里，侍凤辇夜游，棚晓人散。\n迓鼓方催，韵箫正美，忽被西风吹断。\n簌簌梅花落，忍听得、一声羌管。\n怀古伤情，泪痕湿，春衫短。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9075,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满江红","author":"陆文圭","text":"试检春光，都不在、槿篱茅屋。\n荒城外、牯眠衰草，鸦啼枯木。\n黄染菜花无意绪，青描柳叶浑粗俗。\n忆繁华、不似少年游，伤心目。\n棠坞锦，梨园玉。\n燕衣舞，莺簧曲。\n艳阳天输与，午桥金谷。\n行处绮罗香不断，归时弦管声相逐。\n怕夕阳、影散近黄昏，烧银烛。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9076,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满江红 送理伯雍同知改除转运判官","author":"陆文圭","text":"双桧堂深，想前日、清风犹在。\n才半载、政声传播，与人称快。\n鞠草圜扉无滞讼，憩棠田舍留遗爱。\n问方今、循吏几何人，公为最。\n明而恕，廉而介。\n官易进，身难退。\n苦簿书业委，米盐繁碎。\n雁鹜自怜群里聚，龙猪不计儿时会。\n望美人、又向碧云西，徒增慨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9077,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"满江红 赠歌者","author":"陆文圭","text":"儿女多情，颇自恨、风云气少。\n春梦里、莺啼燕语，瞥然惊觉。\n寸寸凌波莲步稳，弯弯拭黛山眉峭。\n似红云、一朵罩江梅，天然好。\n舞腰细，歌喉巧。\n锦茵退，梁尘绕。\n更盈盈笑靥，樱唇红小。\n金盏爱从心里换，玉山偏向怀中倒。\n奈刘郎、前度看桃花，如今老。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9078,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"次韵子封承之游桃花坞二首 其二","author":"陈深","text":"闾门行乐送韶华，闲访城阴野老家。\n黄蝶得晴飞菜叶，翠禽隔浦啄桃花。\n衡门倒屣临官路，古渡横舟阁浅沙。\n亦有诗人时一到，醉吟行尽夕阳斜。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9079,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"题吴实斋北山别业","author":"黄庚","text":"北山佳景胜南山，乘兴登临眼界宽。\n樵斧伐云春谷暗，渔榔敲月夜溪寒。\n一区池占林泉胜，四面天开图画看。\n竹屋数间尘不到，主人日日凭阑干。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9080,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"泊舟","author":"龚璛","text":"小舟寻夜泊，明月散风澜。\n故人相别处，双鹭立前滩。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9081,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"郡楼","author":"龚璛","text":"久客有远思，肩舆登郡楼。\n聊为避暑饮，更学御风游。\n叠翠城南面，双虹水北流。\n流将五湖去，叶叶采蘋舟。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9082,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"越州道中","author":"熊鉌","text":"野田秋溜正潺潺，新翠乔林绕舍环。\n淡日凝烟横别浦，斜风吹雨过前山。\n柴扉初放牛羊出，渔艇方携蟹蛤还。\n自笑平生爱游览，天教长在水云间。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9083,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"宿福海寺","author":"戴表元","text":"斲岩苍龙角，汲流紫云根。\n道人不绝俗，自然无耳喧。\n屋脊挂修岭，一日过千辕。\n此中但高卧，松风有清言。\n听之亦无有，风定松在门。\n炊成我欲去，独鹤鸣朝暾。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"清明次韵周君会 其二","author":"于石","text":"墓祭非经古未闻，年来拜扫隘车尘。\n谁怜原上千年冢，且醉樽前百岁身。\n榆火欲燃行客晚，梨花不减故园春。\n石泉浇醒浮生梦，耿耿孤怀孰与亲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"法驾导引 其一 代寿丹山","author":"刘辰翁","text":"东风雨，东风雨，河汉洗蓬莱。\n只见丹山高万丈，不知古驿路傍埃。\n到海几时回。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"法驾导引 其二 代寿丹山","author":"刘辰翁","text":"二月八，二月八，长见醉桃腮。\n天上玉堂怀旧草，面前金鼎又无梅。\n除是老翁来。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"法驾导引 其一 寿刘仲简","author":"刘辰翁","text":"五月五，五月五，细雨绿菖蒲。\n早是高花开九节，花堪结子节堪扶。\n持此揆□初。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"法驾导引 其二 寿刘仲简","author":"刘辰翁","text":"长命缕，长命缕，儿女漫区区。\n何似屏星南极里，清如寒露在冰壶。\n一府号仙儒。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"最高楼 寿刘介叔","author":"赵文","text":"春小小，和气满仙家。\n喜渐近春华。\n彩衣明媚人如玉，金杯潋滟酒成霞。\n寿诗翁，翁饮少，更添些。\n便万里传宣谁不羡。\n便万里封侯谁不愿。\n适意处，退为佳。\n田园尽可渊明栗，弓刀何似邵平瓜。\n但年年，清浅水，看梅花。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其三","author":"黄公绍","text":"思晴好，小驻岂无因。\n花上半旬春社雨，松间三宿暮山云。\n转住是愁人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其四","author":"黄公绍","text":"思晴好，春透海棠枝。\n刻惜许多过时了，可怜生是我来迟。\n不见软红时。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其五","author":"黄公绍","text":"思晴好，天运几乘除。\n只为晴多还又雨，谁知雨过是晴初。\n那得绿阴乎。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其七","author":"黄公绍","text":"思晴好，我欲问花神。\n刚道社公瞋旧水，一回旧也一回新。\n不是两般春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其八","author":"黄公绍","text":"思晴好，松路翠光寒。\n夜夜竹窠常梦到，天天后土几时干。\n极目雾漫漫。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其九","author":"黄公绍","text":"思晴好，日影漏些儿。\n油菜花间蝴蝶舞，刺桐枝上鹁鸠啼。\n闲坐看春犁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"望江南 其十","author":"黄公绍","text":"思晴好，晨起望篱东。\n毕竟阴晴排日子，大都行止听天公。\n且住此山中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":9097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]