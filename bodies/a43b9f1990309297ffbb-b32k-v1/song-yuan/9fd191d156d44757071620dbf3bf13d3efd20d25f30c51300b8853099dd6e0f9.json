[{"title":"大衍易吟四十首 其二十四","author":"方回","text":"艮上戒舌驷，震初羞指鼋。\n细观颐内外，口是祸之门。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1084,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其二十三","author":"方回","text":"无妄均所与，大畜患不多。\n性岂无知者，心如未尽何。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1085,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其二十二","author":"方回","text":"午月至子复，书云七日来。\n六日七分说，观天何隘哉。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1086,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其二十一","author":"方回","text":"仁道成已极，体元乾长人。\n独休不远复，当且学回仁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1087,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其二十","author":"方回","text":"剥三与复四，皆处五阴中。\n自拔弃其类，吾推道是从。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1088,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十九","author":"方回","text":"离明用狱四，噬嗑贲旅丰。\n中孚夹离卦，两画玩虚中。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1089,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十八","author":"方回","text":"俯下知临吉，其如仰观何。\n相孚不待荐，一盥已为多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1090,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十七","author":"方回","text":"泰变即为蛊，否变仅为随。\n元祐绍圣事，至今心骨悲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1091,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十六","author":"方回","text":"谦卑六位得，豫乐四爻非。\n庄敬与安肆，冥冥祸福几。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1092,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十五","author":"方回","text":"大有同人盛，离柔寓戒辞。\n无威斯近弱，不广即为私。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1093,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十四","author":"方回","text":"盛夏靡草死，岁寒松柏贞。\n泰须防陂复，否有大人亨。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1094,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十三","author":"方回","text":"履若蹈虎尾，五刚亨厥躬。\n乾三独柔变，是以咥人凶。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1095,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十二","author":"方回","text":"小畜过无坎，胡为以雨云。\n互观藏兑泽，止水亦兴云。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1096,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十一","author":"方回","text":"讼吉观西伯，师中验太公。\n得人师不战，反己讼无终。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1097,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其十","author":"方回","text":"德盛时逢险，乾刚坎在前。\n谚云姑少待，乐饮岂徒然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1098,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其九","author":"方回","text":"屯初康险难，蒙上觉昏童。\n开辟乾坤后，君师大有功。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1099,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其八","author":"方回","text":"十年女乃字，守节以胜情。\n凡诸卦用六，观兹利永贞。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1100,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其七","author":"方回","text":"用九不为首，阳画位屯初。\n百八十五变，刚爻可舍诸。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1101,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其六","author":"方回","text":"六阴升已极，坤下战乎乾。\n建亥阳生处，居然复卦前。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1102,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其五","author":"方回","text":"阳爻极六位，进退贵因时。\n德则何忧亢，神而不可知。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1103,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其四","author":"方回","text":"乾坤用九六，义例析为三。\n朱子申欧说，开编请细探。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1104,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其三","author":"方回","text":"谓今三画卦，不自偶奇生。\n便指三为八，徒劳口舌争。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1105,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其二","author":"方回","text":"太极元无极，先天异后天。\n今人不识此，读易岂其然。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1106,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"大衍易吟四十首 其一","author":"方回","text":"卦下观一彖，卦中求六爻。\n今人仅知此，著眼未为高。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1107,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"小本兰亭二种","author":"方回","text":"子云可拟易论无，颇似兰亭细字模。\n始信圣经非小艺，不羞依样画葫芦。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1108,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"山茶花","author":"方回","text":"石楠岩桂万年枝，方驾分花占四时。\n犀甲鹤头傲霜雪，入春犹见岁寒姿。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1109,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋雨","author":"方回","text":"瘴疠干戈脱此生，一隅略见旧承平。\n上元灯火中秋月，但苦人心不肯晴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1110,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋前夕三首 其三","author":"方回","text":"山头月到天心小，林下秋生夜半寒。\n不待明朝已三五，四更仍续五更看。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1111,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋前夕三首 其二","author":"方回","text":"稍穿疏树残光碎，徐碾晴空素艳流。\n交过子时是明日，搀先半夜赏中秋。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1112,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中秋前夕三首 其一","author":"方回","text":"中秋无酒定醒然，清赏今宵月已圆。\n喜我小儿才五岁，犹能倚户望高天。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1113,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"中望吴山下一汀是为杭州","author":"方回","text":"秦皇系缆北山头，一抹江边海变洲。\n百万生人无葬处，蜗争蚁战不如休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1114,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为孙同签瓒题赵子昂马","author":"方回","text":"画马当年李伯时，长怀鲁直子瞻诗。\n朝廷□道人才盛，元祐风流再见之。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1115,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为牟德范题石湖遗墨意有未尽复赋五首 其五","author":"方回","text":"日长饥雀窥铛釜，雨过跳蛙上灶炉。\n莫笑晒书亡玉轴，荆州还识半人无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1116,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为牟德范题石湖遗墨意有未尽复赋五首 其四","author":"方回","text":"传道府中浇茗碗，灵坚陇畔炷薰炉。\n银钩茧纸闲舒卷，锥也无时未是无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1117,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为牟德范题石湖遗墨意有未尽复赋五首 其三","author":"方回","text":"不寻蓬岛求仙药，肯羡铜山侈赐炉。\n独有平生嗜古癖，谁知东郭履全无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1118,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为牟德范题石湖遗墨意有未尽复赋五首 其二","author":"方回","text":"汉陵往事馀金碗，湘步空名尚铁炉。\n地下中郎今不作，典刑真属虎贲无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1119,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为牟德范题石湖遗墨意有未尽复赋五首 其一","author":"方回","text":"青春日月羁尘鞅，朱夏乾坤炽暑炉。\n略对风檐紬古卷，閒愁吹得一星无。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1120,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为吴太初题初邻斋二首 其二","author":"方回","text":"三两茅庐一径深，略知住处未知心。\n元来有物先天地，难向君家屋畔寻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1121,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为吴太初题初邻斋二首 其一","author":"方回","text":"此宅元无一物遮，问君隔壁是谁家。\n伏羲未画前头事，篱落傍边靠得些。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1122,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为徐企题李伯时马","author":"方回","text":"此画良真李伯时，形容飞动卒难诗。\n但将元祐苏黄作，开卷焚香朗诵之。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1123,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为魏塘王居士留三日二首 其二","author":"方回","text":"魏塘酒贱蟹螯肥，久要人情忍重违。\n呼妓访僧俱不必，醉三昼夜可言归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1124,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"为魏塘王居士留三日二首 其一","author":"方回","text":"水乡熟处未全饥，舟楫安行盗亦稀。\n乘兴聊为三日客，魏塘酒贱蟹螯肥。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1125,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"予丁亥生壬寅年七十六留杭十二年","author":"方回","text":"吾生已是三分过，此地胡为一纪留。\n万事无心偶然耳，久将身世付浮休。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1126,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"五月二夜闻雨大□□日至杭","author":"方回","text":"□凉唤起酒醒人，听雨更阑得句新。\n儿子远来作生□，□□□十六年身。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1127,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今春苦雨初有春半曾无十日晴之句去立夏无几日愈雨足成五诗 其一","author":"方回","text":"小楼欲下怕泥行，春半曾无十日晴。\n老眼看花如隔雾，只消卧听卖花声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1128,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今春苦雨初有春半曾无十日晴之句去立夏无几日愈雨足成五诗 其三","author":"方回","text":"青梅未了已朱樱，春尽曾无十日晴。\n稍欲出城问蚕麦，生愁城外杜鹃声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1129,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今春苦雨初有春半曾无十日晴之句去立夏无几日愈雨足成五诗 其四","author":"方回","text":"湖头准拟赏新晴，雨过风号万马声。\n宋玉未誇巫峡梦，杜陵翻作渼陂行。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1130,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今春苦雨初有春半曾无十日晴之句去立夏无几日愈雨足成五诗 其二","author":"方回","text":"今年草草过清明，春莫曾无十日晴。\n担上牡丹犹许见，城中浑不识莺声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1131,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"今春苦雨初有春半曾无十日晴之句去立夏无几日愈雨足成五诗 其五","author":"方回","text":"读书听雨过三更，定是明朝又不晴。\n就枕未鼾饥鼠出，掀书舐砚上灯檠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1132,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元夕前雨不已二首 其二","author":"方回","text":"兰膏画炬出贫民，宝马香车属贵人。\n月姊雨师暗商榷，不须妆点上元春。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1133,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"元夕前雨不已二首 其一","author":"方回","text":"节届烧灯奈若何，客楼三夜听霶?。\n春风有意催花信，小雨如酥不用多。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1134,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"午节","author":"方回","text":"年年节与物相符，笋已成竿燕欲雏。\n客里不知端午近，卖花担上见菖蒲。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1135,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"月月红花","author":"方回","text":"十二循环换律筒，芳葩长是笑春风。\n山家不识尧蓂荚，日历聊凭月月红。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1136,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"木香花","author":"方回","text":"海南药物木香重，何似?松高架花。\n春晚日长香满院，天教富贵属诗家。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1137,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"水仙花画","author":"方回","text":"□绘水仙陪鲁直，梅边更有子瞻形。\n苏兄黄弟神游处，重筑人间顿有亭。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1138,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"王干三岭","author":"方回","text":"澄练平皋水屈盘，青苍松栎拥峰峦。\n霜晴村落全如画，一见都忘上岭难。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1139,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"见梅","author":"方回","text":"翠竹阴森护槿篱，玉梅庭院粉墙攲。\n几年避地无人住，犹有花开一两枝。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1140,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙申元日五绝 其二","author":"方回","text":"五更春雨细无声，石路溅泥齿屐鸣。\n后饮屠苏懒奔走，可能也喜鹁鸠晴。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1141,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙申元日五绝 其五","author":"方回","text":"案上瓶梅阅两年，添花未有买花钱。\n东风恰似怜穷客，吹到新诗四五篇。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1142,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙申元日五绝 其一","author":"方回","text":"新年仍著旧年衣，老健深惭七十希。\n一炷炉香拜天地，今春早早买船归。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1143,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙申元日五绝 其三","author":"方回","text":"雪馀连雨满城泥，喝道宵行万马蹄。\n昨夜隔年书未点，瓶梅灯畔一枝低。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1144,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"丙申元日五绝 其四","author":"方回","text":"送寒迎暖柳梢知，风自东来著意吹。\n百万人家贺新岁，几家荼垒有新诗。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1145,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"东坡真迹","author":"方回","text":"欧苏一代两文忠，赖是滁阳起醉翁。\n谁欲儋州杀坡老，靖康战血鼓腥风。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1146,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"兰花","author":"方回","text":"雪尽深林出异芬，枯松槁槲乱纷纷。\n此中恐是兰花处，未许行人著意闻。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1147,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"兰亭","author":"方回","text":"细看僧字永和碑，谁见山阴落笔时。\n想像捧心□□□，□间几本话西施。","collection":"宋末元初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1148,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"出城","author":"方回","text":"久病欣初愈，长忙爱暂閒。\n出城因送客，沿路得看山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1149,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北本兰亭","author":"方回","text":"一千年想永和会，十九之传贞观摹。\n此本中原今第一，真成一字一骊珠。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1150,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"北高峰屡欲登而辍","author":"方回","text":"拟上高峰最上头，篮舆已赁又还休。\n旧来诗眼如今别，添与江南一段愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1151,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四月一日早闻莺","author":"方回","text":"客里花都尽，初闻晓树莺。\n莺声虽已老，毕竟是莺声。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1152,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四月十二日饮陆君用见山堂","author":"方回","text":"砚几书床茂树间，花深竹密地宽閒。\n绿阴正是浓时节，遮尽人家只见山。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1153,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"四月初二日出兵恰满一月百姓未得下城","author":"方回","text":"久谓兵当解，何知战未休。\n属方甜笋蕨，遽已艳葵榴。\n骨痛金疮作，心烦火色浮。\n满城俱闭户，不但一人愁。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1154,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十九日四更起读朱文公年谱至天大明赋十二首 其十二","author":"方回","text":"开禧嘉定擅权臣，地下眉头想更颦。\n侂远传衣至亡国，止缘不用读书人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1155,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十九日四更起读朱文公年谱至天大明赋十二首 其十一","author":"方回","text":"考官蔡兹取三策，三奏赏音汪应辰。\n天下未尝无识者，近来识者亦无人。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1156,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}},{"title":"正月十九日四更起读朱文公年谱至天大明赋十二首 其十","author":"方回","text":"澹庵老荐此诗人，屈道何妨可致身。\n负鼎干汤公岂肯，本来馀事压黄陈。","collection":"宋末元初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末元初.csv","pointer":1157,"sha256":"472d136ba142938f73d71ca3d2fd7a0fa6b2908290001e25e5a7e4a562b239b8","dynasty":"宋末元初"}}]