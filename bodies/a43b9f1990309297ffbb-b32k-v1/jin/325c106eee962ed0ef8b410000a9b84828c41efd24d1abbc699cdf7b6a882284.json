[{"title":"春赏","author":"毛麾","text":"润入梅天雨乍晴，唤回春意有新莺。\n云霞照眼青山近，罗绮吹香白昼明。\n翠勺银罂沽酒市，暖风迟日卖花声。\n人人共喜华胥世，何用鳌头羡锦城。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2011,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒食不出","author":"朱澜","text":"地偏无客过吾庐，寒食清明入燕居。\n骥子捧瓯仍腊茗，孟光举按只春蔬。\n蝇沾香篆浑伤字，蜂蹙瓶花半堕书。\n习气未除还自笑，却将佳节付三馀。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2012,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"黄筌雀蝶","author":"朱澜","text":"饥雀喧争蛱蝶孤，锦宫城阙见丘墟。\n老筌妙意谁知解，丹粉图中有谏书。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2013,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宫词","author":"朱澜","text":"太一芙蓉上下天，秋波澹澹白生烟。\n采莲宫女分花了，笑把兰篙学刺船。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2014,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元夜雪","author":"王琢","text":"宝灯楼阁澹连云，转盼俄惊糁玉尘。\n游伎行歌俱失意，蔬畦麦垄自知春。\n良宵不肯平平过，造物应誇着着新。\n独有中天端正月，一尊梅影属閒人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2015,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和张仲宗雪诗不用体物诸字","author":"王琢","text":"天人应卜岁，出此当佳占。\n无巧穿幽隙，堆寒压短檐。\n閒门谁拥彗，醉馆自开帘。\n比兴非无物，诗人正避嫌。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2016,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同漕使赵中宪对雪","author":"王琢","text":"投隙穿窗苦见侵，向无湘酎若为禁。\n花多不入贫家眼，岁好方知造物心。\n跃马共思追兔迹，抱戈谁与置羊斟。\n新诗与雪争奇峭，拥褐空斋得细吟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2017,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"癸酉岁大热","author":"王琢","text":"似动不动云蒸空，欲雨未雨天无风。\n时时日脚蹴云破，一射万土红炉中。\n纤絺挂体剧重铠，大屋仅可为樊笼。\n积冰为丘坐自溃，轻箑况得微凉通。\n山林亦闻有暍死，城市偪侧宜无容。\n吾生于热亦屡度，此热尽可并前镕。\n虽然一气播常令，顿作骇异疑非公。\n曾闻天南有祝融，出入毒雾骑双龙。\n自从鼎去昧神怪，无乃煽处行心胸。\n手摇斗柄酌炎海，力逐熛怒乘离宫。\n喜为郁蒸怒为火，流烁金石乾河洪。\n炽昌自欲弄朱夏，骄蹇未肯官炎农。\n霞烟灼灼燥昏晓，鸟兽喘喘茫西东。\n此而不制满三伏，遂恐百物随枯蓬。\n太白之兵攒万锋，银河之浪滔无穷，可洗虐焰夷奸凶。\n我欲呼愬烦神功，耽耽九虎天关重。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2018,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"辛未九月二十一日雪","author":"王琢","text":"几日西郊雾，连宵北牖风。\n菊花犹汎酒，雪片忽填空。\n草树秋容失，河关晓气濛。\n听初疑落叶，仰不辨高鸿。\n烂漫三冬意，凭凌百圃功。\n披裘赴鸡黍，埽径惜篱丛。\n岂料玄英巧，来争白帝雄。\n剪裁浑草草，飞舞太匆匆。\n秪作干时令，非关兆岁丰。\n冬雷怪相似，春雹冷应同。\n安得蛟龙蛰，何由翳霭通。\n日华升赤壁，天色湛青铜。\n尚有登临兴，宁无赋咏工。\n烟霞狂醉啸，一发醉颜红。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2019,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨夕感寓","author":"王琢","text":"漠漠初灯后，森森细点飘。\n繁声入遥夜，冷簟恍秋宵。\n起欲吟相和，吁无客可招。\n何曾洗兵马，但觉漏薪荛。\n雷电初无预，炎蒸遂不骄。\n泻檐锵未歇，欹枕兀无聊。\n涧已山输潦，堤应水没桥。\n长林倦今夕，孤鸟撼惊条。\n似我缠忧戚，因贫堕寂寥。\n避人犹虺蜴，择宿等鹪鹩。\n共世难曹祢，无才匹管萧。\n苦心还自笑，末俗本多嚣。\n未老愁摧鬓，长饥带剩腰。\n床寒少陵被，饮陋子渊瓢。\n射策初游汉，潜山敢傲尧。\n盐车竟垂耳，风鹢忌干霄。\n一室元空埽，千钟岂易要。\n芳兰逼憔悴，尺鴳失逍遥。\n字对诸生识，诗烦众手雕。\n搜求劳肾胃，戛击谢咸韶。\n旧弄新弦掩，穷途拙目摇。\n争为壮夫篆，只使古风浇。\n血指甘时巧，包羞怆道消。\n优游能卒岁，三四尽论朝。\n故幔幽霖透，长檠暗烬挑。\n不辞墙出菌，傥见谷抽苗。\n餍饫贪夫腹，翻腾乐岁谣。\n晴楼交燕雀，凉树沸蝉蜩。\n坐快虹蜺出，忧无萍梗漂。\n浩歌弥激烈，兴在海门潮。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2020,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"小景","author":"吕中孚","text":"青芜平野四围山，山郭依依紫翠间。\n村远路长人去少，一竿斜日酒旗閒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2021,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春月","author":"吕中孚","text":"柳塘漠漠暗啼鸦，一镜晴飞玉有华。\n好是夜阑人不寐，半庭寒影在梨花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2022,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"水声","author":"吕中孚","text":"长陂千顷碧淙淙，浪卷秋风过石矼。\n记得夜来愁听处，一灯明灭照寒窗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2023,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪","author":"吕中孚","text":"随风拂拂玉花飘，入夜寒窗更寂寥。\n炉火已残灯未烬，一帘疏竹白萧萧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2024,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送李嘉甫信都令耘甫之弟","author":"吕中孚","text":"溪水碧于草，溪边送客行。\n写诗传别意，把酒听歌声。\n去路青天远，归心白羽轻。\n尊前折杨柳，一一是离情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2025,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梨花","author":"吕中孚","text":"等待清明得得芳，团枝晴雪暖生香。\n洗妆自有风流态，却笑红深睡海棠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2026,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"集句","author":"吕中孚","text":"骚人吟罢起乡愁，百感中来不自由。\n一种人间太平日，满衣尘土避公侯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2027,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"柳","author":"吕中孚","text":"风外丝丝袅绿烟，轻花初破不成绵。\n却嫌官路逢寒食，恼乱离愁似去年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2028,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"青冢","author":"王元节","text":"环佩魂归青冢月，琵琶声断黑山秋。\n汉家多少征西将，泉下相逢也合羞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2029,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"与党世杰军判丁亭会饮","author":"王元节","text":"望断西州万里家，又将新火试新茶。\n青油幕下成何事，两见常山山杏花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2030,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"古镇道中","author":"王元节","text":"秀拔诸峰镇海墩，海天水气两昏昏。\n鸥飞翠竹白沙地，人宿黄鱼紫蟹村。\n向背云山行处路，浅深潮浦涨来痕。\n同游幸有能诗客，不倦跻攀到石门。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2031,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"太白扇头","author":"李端甫","text":"岩冰涧雪谪仙才，碧海骑鲸望不回。\n今日霜纨见遗像，飘然疑自月中来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2032,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"成皋道中","author":"杨庭秀","text":"瘦马成皋道阻长，峥嵘冰雪老年光。\n九关欲上虎豹怒，三径未归松菊荒。\n嵩少云烟聊驻马，汉唐宫殿两亡羊。\n郑南岭下梅花发，千里相思空断肠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2033,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"李简之莲池集句","author":"杨庭秀","text":"一月衰颜几笑开，生前相遇且衔杯。\n莲塘十里花如锦，有底忙时不肯来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2034,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"许氏双桂堂","author":"孙镇","text":"许家二桂联翩秀，孙氏三枝次第春。\n盛事若将相比并，输君堂上拜双亲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2035,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日","author":"张著","text":"雨沐天容霁欲流，好山誇翠出墙头。\n黄花憔悴东篱晚，一段陶家冷淡秋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2036,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨后","author":"张著","text":"西风无意嫪纤云，埽尽千峰雨脚痕。\n一片秋光清似水，家家空翠满柴门。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2037,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"感事","author":"景覃","text":"兰芳切禁当门种，李苦何伤并道生。\n自古英雄足猜忌，莫教身外有浮名。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2038,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梨花","author":"段继昌","text":"一林轻素媚春光，透骨浓薰百和香。\n消得太真吹玉笛，小庭人散月如霜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2039,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"一溪","author":"段继昌","text":"一溪流水走青蛇，春在江边渔父家。\n竹外寒梅看欲尽，清香移入小桃花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2040,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春早二首 其一","author":"段继昌","text":"鱼儿水汎鸭头绿，野马尘飞羊角风。\n西崦山家篱落背，杏梢初见一分红。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2041,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春早二首 其二","author":"段继昌","text":"断冰销尽荻芽尖，冻垄苏来白荠添。\n几片野云飞不去，晚风吹作雨纤纤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2042,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读纪信传","author":"段继昌","text":"鹿走中原两虎争，荥阳围解事堪惊。\n当时拔剑论功者，矢口何人说纪生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2043,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"谢人惠二小漆冠","author":"岳行甫","text":"规制新翻出杜郎，最宜闺子夜烧香。\n不争宝髻峨宫样，自与霓裳配道装。\n细拢翠鬟云易满，浅衔牙栉月难藏。\n水衡双寄非无意，要买杨枝恼孟光。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2044,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"立春日","author":"岳行甫","text":"银线青丝翠椀堆，争牛击鼓欲惊雷。\n翻风斗巧春头胜，漉雪浮香臈尾杯。\n迎暖梢梢金著柳，逗寒叶叶粉飘梅。\n不成一事人空老，半百光阴又七回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2045,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"箸诗","author":"周驰","text":"矢束形何短，筹分色尽红。\n骈头斯效力，失偶竟何功。\n比数槃盂侧，经营指掌中。\n蒸豚挑项脔，汤饼拌油葱。\n正使遭谗口，何尝废直躬。\n上前如许借，犹足沃渊?。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2046,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"□子","author":"周驰","text":"勿以微才弃，安危任不轻。\n谁怜一片小，能使四方平。\n几案由吾正，槃㿻免尔倾。\n何当遇夷坦，沈默更何营。","collection":"金","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2047,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三阳述怀","author":"刘铎","text":"蚁穴吾犹梦，蜗庐此仅容。\n一川青霭合，半岭白云封。\n地僻宜藏拙，官閒足养慵。\n只惭无补报，潦倒不归农。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2048,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事","author":"刘铎","text":"地与中州迥，民馀上古淳。\n峡长深束渭，路险曲通秦。\n烟柳千家晓，风花百里春。\n一官如自择，閒处著閒身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2049,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"渑池驿舍用苑极之郎中韵","author":"刘铎","text":"惯从鞍马作生涯，宿处依依认是家。\n炉火相看衣袖暖，盘餐未办驿廚哗。\n淹留岁月头如雪，汩没风尘眼更花。\n永夜如何得消遣，新诗吟罢自煎茶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2050,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日","author":"刘铎","text":"翠微深处几人家，风飏轻烟雨压沙。\n寒勒野桃开较晚，向阳才有两三花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2051,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"所见","author":"刘铎","text":"纶竿老子绿蓑衣，细雨斜风一钓矶。\n正是邻家社醅熟，柳条穿得锦鳞归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2052,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读李训郑注传二首 其一","author":"刘铎","text":"谁教阉宦作权臣，肃代优游到敬文。\n三子谋疏谁不道，泄机也合罪刘蕡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2053,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读李训郑注传二首 其二","author":"刘铎","text":"棋医入侍本防猜，偶失机权亦可哀。\n陈窦至今佳传在，莫从成败论人材。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2054,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"渔父","author":"李节","text":"举世从谁话独醒，短蓑轻箬寄馀生。\n半篙春水世尘远，一笛晚风山雨晴。\n稚乳满船生事简，鱼虾到市利源轻。\n旁人莫怪机心少，曾与沧洲白鸟盟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2055,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"有感","author":"李节","text":"乱离何事最堪伤，孝子陵前段氏庄。\n铸铁作门贻鬼笑，堆金齐斗买天亡。\n春风草满藏书壁，落日狐鸣打麦场。\n惆怅贤郎一丘土，过车肠痛独难忘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2056,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读张仲扬诗因题其上","author":"刘勋","text":"布衣一日见明君，俄有诗名四海闻。\n枫落吴江真好句，不须多示郑参军。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2057,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"偶作","author":"刘勋","text":"将军马跃五挝鼓，客子车行三唱鸡。\n白发书生无伎俩，满窗红日醉如泥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2058,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杜善甫乞炭","author":"刘勋","text":"笔口酸嘶解说穷，寒炉随手变春红。\n因君大笑涪翁拙，费尽奇香得马通。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2059,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"呈吕陈州唐卿","author":"刘勋","text":"警盗何烦鼓夜挝，丽谯清昼卷高牙。\n春回和气一千里，雪与丰年十万家。\n逋赋稍宽新得帖，军书不至早休衙。\n新年载酒须行乐，次第东风绕郡花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2060,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋凉","author":"刘勋","text":"桃笙乘势献微凉，纨扇无功送暑光。\n老病不嫌风露冷，莫教添作鬓边霜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2061,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"爱诗李道人嵩阳归隐图","author":"刘勋","text":"脱却儒冠已自閒，更令家事勿相关。\n百钱便挂青藜杖，不看先生纸上山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2062,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元夜阴晦","author":"刘勋","text":"逐逐雕鞍趁画轮，年芳乐事一番新。\n芙蓉城暖东风夜，杨柳楼深笑语春。\n两鬓愁添新白雪，十年梦到软红尘。\n空庭不见梅花月，寂莫春阴最恼人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2063,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"伤曹吉甫之死","author":"刘勋","text":"官职虽低首不低，争教有志竟空赍。\n向人指画将何语，卧壁糊涂不解题。\n小女绕床犹戏剧，老兵伏地亦悲啼。\n春风系马庭前树，只想东斋醉似泥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2064,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同赵宜之赋梨花月","author":"刘勋","text":"雪树生香淡月边，相媒相合斗清妍。\n空庭冷落秋千影，虚度良宵亦可怜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2065,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"不寐","author":"刘勋","text":"酪奴作祟搅秋眠，追咎前非四十年。\n一夜虫声相计会，并催白发到愁边。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2066,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"戏郑秀才","author":"刘勋","text":"张老豆新频见饷，郑家米凿不须赊。\n客来粥熟吾能办，要与齐奴斗咄嗟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2067,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日","author":"刘勋","text":"粉蝶耽香梦正迷，黄峰和蜜计何痴。\n小轩无事谁如我，卧看杨花点砚池。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2068,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"答仲和","author":"刘勋","text":"此身安处苦难寻，常羡归鸦易满林。\n望远真成广武叹，得诗空作洛生吟。\n逢人放适村村酒，感物悲哀岁岁心。\n想得济南花正好，抱城春水一篙深。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2069,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"漫书","author":"李澥","text":"胸怀平日窗八达，伎俩只今龟六藏。\n唯有閒情如老菊，寒花自信晚能香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2070,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"二老雪行图","author":"李澥","text":"雪明万仞邺西山，杖履平生几往还。\n满眼京尘空对画，何时真似两翁閒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2071,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秘书张监墨梅图","author":"李澥","text":"眼中只有梅千树，不挂世间蜂蝶花。\n十载江南春梦断，至今清影在君家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2072,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"灯下梅影","author":"李澥","text":"丁年夜坐眼如鱼，老矣而今不读书。\n墙角短檠还有用，瓦瓶相对一枝疏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2073,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"拳秀峰","author":"秦略","text":"平滑石之俗，其俗资磨砻。\n磊丑石之秀，其秀在丑中。\n正如古丈夫，貌寝气质雄。\n又如圣人心，孔窍虚明通。\n大都一拳许，含蓄华与嵩。\n大巧本若拙，足见造化功。\n好处元更多，摹写不易工。\n君其善调护，抵击防儿童。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2074,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪行","author":"秦略","text":"匹马东来冰雪天，苍山手冷堕吟鞭。\n烟中髣髴闻鸡犬，不觉人家到眼前。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2075,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鸟影过寒塘","author":"秦略","text":"著眼分明莫作疑，从来形影本同归。\n不应水底青天上，更有飞禽仰面飞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2076,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"悼亡","author":"秦略","text":"自古生离足感伤，争教死别便相忘。\n荒陂何处坟三尺，老眼他乡泪数行。\n多事春风吹梦散，无情寒月照更长。\n还家恰是新寒节，忍见堂空纸挂墙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2077,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元日","author":"秦略","text":"新历从头数，残冬与我违。\n不知垂老至，但觉拜人稀。\n汲水泥融井，看书暖入帏。\n浅情墙外柳，新绿已依依。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2078,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠赵宜之","author":"秦略","text":"年时见君行路难，喜于长安新得官。\n日来见君邻妇哭，惊似蓝田寻得玉。\n爱官爱玉乐有涯，爱君之诗无尽期。\n古人骨冷不复作，主张骚雅非君谁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2079,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]