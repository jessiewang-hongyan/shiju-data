[{"title":"柳","author":"赵达夫","text":"杨柳搀春不耐秋，十分憔悴尽风流。\n水边沙际风烟冷，收拾残阳合暮愁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2350,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杨花","author":"邢安国","text":"细点轻团转复飘，隋家堤岸灞陵桥。\n非绵非絮寒无用，如雪如霜暖不消。\n狂惹客衣知有恨，巧寻禅榻故相撩。\n陂塘回首浮萍满，依旧春风摆翠条。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2351,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过唐州西李口","author":"邢安国","text":"白沙翠竹溪上村，渔家卖鱼唤行人。\n西风吹皱一溪水，水光日影金鳞鳞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2352,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"感怀一首","author":"张温","text":"弥月不出门，出门沙涨东风昏。\n老树摆撼轰雷奔，鬼物叫啸山前村。\n侨居客子惊心魂，归来绕屋寻兰荪。\n兰荪落索灵苗髡，主人醉倒老瓦盆，衣袖半带淋漓痕。\n芸芸萧艾同归根，天生天杀何怨恩。\n糟床与翁共清浑，绝胜被发叫帝阍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2353,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"会州道中","author":"马舜卿","text":"山腰薄雪眩朝暾，未放阳和入烧痕。\n一片长安世情月，梨花院落几黄昏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2354,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"尘","author":"杜充","text":"汩汩劳生为尔忙，只除不到白云乡。\n步回洛浦生罗袜，歌断秦楼蔌杏梁。\n閒扑衣襟迷远望，静穿窗隙锁斜阳。\n帝城别有风流在，辇路春风十里香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2355,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪花","author":"虞仲文","text":"琼英与玉蕊，片片落前池。\n问著花来处，东君也不知。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2356,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春溪一首","author":"张汝霖","text":"黯黯春愁底处消，小桃无语半含娇。\n东风不管前溪水，暖绿溶溶拍画桥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2357,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"通叔以诗送古镜为长言生日之寿次韵谢之","author":"刘长言","text":"綵衣禄隐非臞仙，犹有向来文字缘。\n都城一别两岁晚，寄声劳苦常相先。\n人间始生俗礼重，而我永感方颓然。\n远凭诗句致奇物，欲挽暮景回虞渊。\n规摹九寸函大方，古制不作菱花妍。\n开奁拂拭愧陋质，但喜虹气浮晴天。\n夫君久要心不迁，期与铁杖论清坚。\n保身赖此孤月圆，明年上印归行田。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2358,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"史院从事日感怀","author":"耶律履","text":"不学知章乞鉴湖，不随老阮醉黄垆。\n试从麟阁诸贤问，肯屑兰台小史无。\n一战得侯输妄尉，长身奉粟愧侏儒。\n禁城钟定灯花落，坐拊尘编惜壮图。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2359,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"戊戌二月中旬登稷山清榭","author":"张万公","text":"问囚推案朝还暮，危坐不知春浅深。\n今日檐间看风色，一株红杏暗惊心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2360,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"自临洮还","author":"董师中","text":"临潭仍是汉家城，积石相望十驿程。\n西略河源东并海，此身何地不经行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2361,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"癸亥清明日","author":"孙铎","text":"翛然一室暗尘凝，兀兀端如打坐僧。\n习气未除私自笑，短檠还对读书灯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2362,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留题长平驿","author":"梁?","text":"秦赵均为失霸图，起何残忍括何愚。\n杀降未见无祸者，累将其能有种乎。\n日暮悲风噎丹水，夜深寒月照头颅。\n快心千载杜邮剑，人所诛耶鬼所诛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2363,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠答史院从事","author":"贾益谦","text":"见说才名自妙年，多惭政府旧妨贤。\n物华天宝无今古，凤阁鸾台孰后先。\n郑圃道尊何敢望，济南书在子当传。\n莫言老眼昏花满，及见风鹏上九天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2364,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨后","author":"高汝砺","text":"时雨雨三日，田家家万金。\n有年天子庆，忧国老臣心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2365,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"右丞文献公所画张果像","author":"张行中","text":"古来人物画为难，惊见仙公树石间。\n莫把丹青名右相，太平勋业在人寰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2366,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过司竹监有怀王监正之","author":"杨慥","text":"不见崧丘跨鹤仙，才名留得万人传。\n春郊渍酒伤今日，夜雨论文记昔年。\n宰树谩悬公子剑，高山已绝伯牙弦。\n故居修竹青青在，寂莫终南落照边。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2367,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"乾陵","author":"杨慥","text":"牝鸡一啄血波流，天下何缘不姓周。\n今日阿婆心力尽，乾陵秃似老僧头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2368,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事","author":"郑子聃","text":"一钱不直程卫尉，五斗解酲刘伯伦。\n读罢离骚解衣卧，门前花柳自争春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2369,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"龚平甫森玉轩","author":"孟宗献","text":"古人借宅亦种竹，大是饕奇心未足。\n高斋闻有万琅玕，坐对怀山饮秋绿。\n官閒胜日无一事，尊酒不空仍有肉。\n他时剥啄叩君门，高枕矮床容我宿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2370,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"旧蓄一琴弃置者久矣李君仲通为张弦料理仍鼓数曲以诗赠之","author":"孟宗献","text":"我家筝奴忧乐同，尘埃满面鬓发蓬。\n徽弦不具挂墙壁，似惭无以娱衰翁。\n夫君一见为披拂，坐使寒谷为春融。\n中含太古意味足，杂以新态来无穷。\n繁声流水不可喻，直与造化相冥通。\n形神久已坐灰槁，一旦抉剔驱盲聋。\n寂然反听杳难诘，但觉万窍俱玲珑。\n千金不得和扁力，谁谓起废由枯桐。\n曲终玄旨竟谁会，非弦非指仍非空。\n拂衣欲往君且止，为我乘兴弹悲风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2371,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"张仲山枝巢","author":"孟宗献","text":"达人孤高与世疏，百年直寄犹须臾。\n归来掩关聊自如，人之不足等有馀。\n乐哉下视濠梁鱼，逍遥自契蒙庄书。\n异时驭气游太虚，我知枝巢亦蘧庐。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2372,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"柳塘","author":"孟宗献","text":"摇摇风影漾寒塘，静里亭台日月长。\n不似隋家堤岸上，乱鸦残照管兴亡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2373,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"苏门花坞","author":"孟宗献","text":"绕舍云山慰眼新，看花差后洛阳尘。\n从君小筑繁香坞，不负长腰玉粒春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2374,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰月九日","author":"孟宗献","text":"南崖烘暖贮秋光，胜处相沿釂一觞。\n俚谚难逢两寒食，闰馀今值小重阳。\n头风比似常年愈，菊面浑如去岁黄。\n老矣欢游定能几，佳时此乐最难忘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2375,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"早赴北宫","author":"赵摅","text":"苍龙双阙郁层云，湖水鳞鳞柳色新。\n绝似江行看清晓，不知身是趁朝人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2376,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"探春","author":"赵承元","text":"冰底流泉匹练飞，曲尘著柳不禁吹。\n杖藜恰到春生处，已有人家插酒旗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2377,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"六月二十九日北宫朝回","author":"张行简","text":"疏柳衰荷又一时，清波飞叶梦灵芝。\n年年踏尽溪边路，不觉吴霜点鬓丝。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2378,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"酬郭光秀才","author":"张行简","text":"畴昔君来事已睽，岂知今我又羁栖。\n波臣傥不辞升斗，鹄卵终当遇鲁鸡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2379,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋兴","author":"张楫","text":"飘零千里道，牢落半生愁。\n残月如新月，今秋似去秋。\n露浓花气重，风细竹声幽。\n何日清溪上，烟蓑一钓舟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2380,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"客中","author":"张楫","text":"绛唇花不语，青眼柳初眠。\n尘去寻芳马，香来载酒船。\n归期仍雁后，野兴已鸥边。\n惆怅无家客，春风又一年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2381,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"莲实","author":"张楫","text":"水妃擎出绀珠囊，玉笋彫槃喜乍尝。\n肤白已搀新藕嫩，心青犹带小荷香。\n斗馀翠鸟零珍羽，飞尽黄蜂露蜜房。\n口腹累人良可笑，此身便欲老江乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2382,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"初夏","author":"张楫","text":"小园绿笋间朱樱，点缀年华似有情。\n露浥葛巾晨气润，风随竹簟晚凉生。\n閒窥黠鼠潜身处，静厌飞蚊绕鬓声。\n安得冷泉幽石畔，解衣盘礴树阴清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2383,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北齐行","author":"阎长言","text":"天保大人袭世贵，未待齐成已无魏。\n谶里方传近水羊，梦中先兆攻城猬。\n六君三世都能几，二十八年翻手里。\n细思孝静灵运诗，天道好还非妄矣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2384,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"应制中秋","author":"阎长言","text":"璧月当秋夜未阑，汉宫高会浃宸欢。\n块苏尘世三千界，珠翠瑶光十二栏。\n桂实飘香浮寿斝，露华零润溢仙槃。\n都人侧听云韶奏，共指天家是广寒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2385,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"婆速道中书事","author":"阎长言","text":"此地先经战，人生苦未聊。\n泉源疏地脉，田垄上山腰。\n败石平危径，枯柴补短桥。\n晓烟明远爨，暮雪暗归樵。\n履滑心频悸，梯危骨欲消。\n解鞍空倒卧，无梦讫通宵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2386,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送丽酒丽橙与秀实御史","author":"阎长言","text":"骢马朝回画閤深，遥知春意领梅心。\n丽橙娇软丽樽小，聊助风流对浅斟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2387,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"阎立本职贡图","author":"阎长言","text":"谔谔昌周此一书，形容獒贡写成图。\n宁知右相无深意，莫指丹青便厚诬。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2388,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"盘山招隐图","author":"阎长言","text":"画出中盘望隐归，鸣珂朝马尚迟迟。\n赋诗未敢轻相诮，却恐吾山也勒移。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2389,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三门集津图","author":"阎长言","text":"津门未为天下险，勿作骇相观兹图。\n偃月堂中李林甫，有人能写此心无。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2390,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丁氏思祖亭","author":"阎长言","text":"鹤野三千里，凫函五百年。\n人间仍旧德，龟筮得新阡。\n族属东州望，衣冠鼻祖传。\n异时谁式墓，应识子孙贤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2391,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"观音院书阁","author":"李著","text":"门巷蓬蒿一尺深，小轩岑寂似山林。\n鸟声落枕有高下，山色阅人无古今。\n客里三年侵老境，床头一易浣尘襟。\n晚凉痴坐忘言里，满地西风白玉簪。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2392,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题裕之乐府后","author":"王中立","text":"常恨小山无后身，元郎乐府更清新。\n红裙婢子那能晓，送与凌烟阁上人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2393,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"禅颂三首 其一","author":"王彧","text":"昧已全抛大事忧，为渠刚揽等閒愁。\n桑榆晚景无多子，针芥人身岂易投。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2394,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"禅颂三首 其二","author":"王彧","text":"閒日搆来忙日用，此生迷却再生休。\n鼻头捩转从今始，看作回程火里牛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2395,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"禅颂三首 其三","author":"王彧","text":"吾身非我底为情，说著尘劳特地惊。\n五九尽时山更好，涧泉云鸟自春声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2396,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"又颂","author":"王彧","text":"放下情怀触处安，生涯取取没多般。\n褐衣褴褛聊遮赤，短发鬅鬙底用冠。\n一榻省缘资困歇，二匙随分了饥餐。\n也知苦涩人人笑，烈曰初心不敢谩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2397,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋夜","author":"董文甫","text":"见即如无炉上雪，淡而有味水中盐。\n齐行定慧千灯焰，净识乾坤一镜奁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2398,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"昼眠","author":"董文甫","text":"庄周先我复天真，化蝶飞来管领春。\n我亦庄周周亦蝶，不知若个是真身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2399,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"审是堂","author":"董文甫","text":"按剑人人骇夜光，蜀鸡合道胜鸾凰。\n飞蛾可是无分别，直道油灯是太阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2400,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"文中子续经","author":"董文甫","text":"纷纷述作史才雄，听似秋来百草虫。\n不是春雷轰蛰窟，蚓蛇会得化成龙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2401,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终诗四首 其一","author":"董文甫","text":"无情丧主没钱僧，送上城南无事人。\n捡尽传灯无尽录，更无公案遮番新。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2402,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终诗四首 其二","author":"董文甫","text":"生有地，死有处，万牛不能移一步。\n一轮明月印天心，此是渠侬住处住。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2403,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终诗四首 其三","author":"董文甫","text":"白发三千丈，红尘六十年。\n只今无见在，虚费草鞋钱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2404,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终诗四首 其四","author":"董文甫","text":"今古一轮月，分明印碧霄。\n门门蟾影到，处处桂香飘。\n不起眼中晕，何劳指上标。\n真空浑照破，归去杖头挑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2405,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日感怀","author":"薛继先","text":"衰年易感我今知，无讶骚人动楚悲。\n故国久抛兵劫后，佳辰多负菊花期。\n一时兰艾同凋落，两鬓雪霜仍别离。\n高世输他陶靖节，悠然高兴满东篱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2406,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过洛阳","author":"薛可","text":"西来东去洛阳城，千尺浮图了送迎。\n十日酒旗歌板地，白头孤客可怜生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2407,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄人宰县","author":"薛潜","text":"县务无难易，人才自异同。\n割鸡良暂屈，制锦要专工。\n积弊奸赃后，遗黎喘汗中。\n不存忧世志，底用读书功。\n嫉恶看平日，知君有古风。\n莫教循吏传，独载鲁山翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2408,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"白发感怀","author":"薛珏","text":"少年豪举气如虹，今日萧然一病翁。\n晓镜祇添头上雪，春风不绿鬓边蓬。\n文章那作一钱直，灯火空劳半世功。\n拟筑糟丘便归老，醉乡何者是穷通。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2409,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"陜州","author":"李汾","text":"黄河城下水澄澄，送别秋风似洞庭。\n李白形骸虽放浪，并州豪杰未凋零。\n十年道路双蓬鬓，万里乾坤一草亭。\n八月崤陵霜树老，伤心休折柳条青。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2410,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"州北","author":"李汾","text":"州北光风艳绮罗，南来扈从北人多。\n梨园法曲怀奴舞，月窟新声倩女歌。\n紫禁衣冠出金马，青楼阡陌瞰铜驼。\n薄游却忆开元日，常逐春风醉两坡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2411,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再过长安","author":"李汾","text":"细柳斜连长乐坡，故宫今日重经过。\n一时人物存公论，万里云山入浩歌。\n白发归来几人在，青门依旧少年多。\n自怜季子貂裘敝，辛苦灯前读揣摩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2412,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"汴梁杂诗四首 其一","author":"李汾","text":"天津桥上晚凉天，郁郁皇州动紫烟。\n长乐觚棱青似染，建章驰道直于弦。\n犬牙磐石三千国，圣子神孙亿万年。\n一策治安经济了，汉庭谁识贾生贤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2413,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"汴梁杂诗四首 其二","author":"李汾","text":"琪树明霞五凤楼，夷门自古帝王州。\n衣冠繁会文昌府，旌戟森罗部曲侯。\n美酒名讴陈广座，凝笳咽鼓送华辀。\n秦川王粲何为者，憔悴嚣尘坐白头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2414,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"汴梁杂诗四首 其三","author":"李汾","text":"楼外风烟隔紫垣，楼头客子动归魂。\n飘萧蓬鬓惊秋色，狼藉麻衣涴酒痕。\n天堑波光摇落日，太行山色照中原。\n谁知沧海横流意，独倚牛车笑孝孙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2415,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"汴梁杂诗四首 其四","author":"李汾","text":"寥落关山对月明，客窗遥夜梦魂惊。\n二年岐下音书绝，八月河南风露清。\n冉冉暮愁生草色，迢迢秋思入虫声。\n谁知广武英雄叹，老却穷途阮步兵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2416,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"上清宫三首 其一","author":"李汾","text":"忆昔秋风从茂陵，词臣忝预汉公卿。\n瑶池宴罢西王母，翠辇归来北斗城。\n石马嘶残人事改，劫灰飞尽海山平。\n唯馀太一池边月，伴我骖鸾上玉京。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2417,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"上清宫三首 其二","author":"李汾","text":"苍梧云气赤城霞，绵络钧天帝子家。\n仙掌高承九霄露，霓旌遥驻五云车。\n昆明火劫惊人世，瀛海风涛撼客槎。\n醉里忽逢王子晋，玉笙吹上碧桃花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2418,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"上清宫三首 其三","author":"李汾","text":"千劫尘缘谢吏曹，道山仙阙事游遨。\n楼台缥缈沧溟阔，宫殿森罗紫极高。\n几代云孙接仙李，千年王母醉蟠桃。\n诗成便欲还山去，犹待君王赐锦袍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2419,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]