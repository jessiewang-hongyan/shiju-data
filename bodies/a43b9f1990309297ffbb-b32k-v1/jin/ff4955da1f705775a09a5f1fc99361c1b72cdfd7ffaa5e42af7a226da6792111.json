[{"title":"集东坡诗赠程大本","author":"高士谈","text":"十围便腹贮天真，谋道从来不计身。\n公业有田常乏食，陶潜无酒亦从人。\n异同更莫疑三语，饥饱终同寓一尘。\n待我南游载君去，扁舟归钓五湖春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1000,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晓起戏集东坡句二首 其一","author":"高士谈","text":"簟纹如水帐如烟，一榻清风直万钱。\n困卧北窗呼不起，老夫风味也堪怜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1001,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晓起戏集东坡句二首 其二","author":"高士谈","text":"清风终日自开帘，吏散空庭雀噪檐。\n午醉醒来无一事，地偏心远似陶潜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1002,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋兴","author":"高士谈","text":"鼓角边城暮，关河古塞秋。\n渊明方止酒，王粲亦登楼。\n摇荡伤残岁，栖迟忆故丘。\n乾坤尚倾仄，吾敢叹淹留。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1003,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋晚书怀","author":"高士谈","text":"肃肃霜秋晚，荒荒塞日斜。\n老松经岁叶，寒菊过时花。\n天阔愁孤鸟，江流悯断槎。\n有巢相唤急，独立羡归鸦。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1004,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"早起","author":"高士谈","text":"晓起先乌鹊，愁多竟不眠。\n风霜严塞草，星月淡秋天。\n落叶亲携帚，垂瓶自汲泉。\n禁门朝万马，魂断忆当年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1005,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日","author":"高士谈","text":"迟日回轻暖，东风扫积阴。\n客愁眉上见，春意柳边寻。\n健犊躬耕计，归鸿去国心。\n醉乡如可隐，会放酒杯深。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1006,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次伯坚韵","author":"高士谈","text":"公道向来惟白发，浮生何处用黄金。\n东风吹散三年恨，春色惊回万里心。\n急景只教人貌改，沧溟不放酒杯深。\n异时傥及公荣酌，准拟归来卧柳阴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1007,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵饮嵓夫家醉中作","author":"高士谈","text":"月中招得饮中仙，草露吹风洒净便。\n地有溪山真可乐，人如冰雪自无眠。\n清新李白诗能胜，勃窣张凭理最玄。\n功业本非吾辈事，此身聊复斗尊前。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1008,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚登辽海亭","author":"高士谈","text":"登临酒面洒清风，竟日凭栏兴未穷。\n残雪楼台山向背，夕阳城郭水西东。\n客情到处身如寄，别恨他时梦可通。\n自叹不如华表鹤，故乡常在白云中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1009,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"棣棠","author":"高士谈","text":"閒庭随分占年芳，袅袅青枝淡淡香。\n流落孤臣那忍看，十分深似御袍黄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1010,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪","author":"高士谈","text":"蔌蔌天花落未休，寒梅疏竹共风流。\n江山一色三千里，酒力消时正倚楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1011,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"苦竹","author":"高士谈","text":"密叶脩茎雨后新，肯因憔悴损天真。\n清如南国纫兰客，瘦似西山采蕨人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1012,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"睡起","author":"高士谈","text":"平生心性乐疏慵，多病追欢兴亦空。\n睡起不知春巳老，一帘红雨杏花风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1013,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"道中","author":"高士谈","text":"鸣鸠逐妇妇欲去，燕子引雏雏不来。\n树底树头千点雨，山南山北一声雷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1014,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丙寅刑部中二首 其一","author":"高士谈","text":"世事邯郸枕，归心渭上舟。\n衅来无朕兆，意外得俘囚。\n忠信天堪仗，清明泽自流。\n藜羹犹火食，永愧绝粮丘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1015,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丙寅刑部中二首 其二","author":"高士谈","text":"幽囚四十日，坐稳穴藜床。\n缧绁元非罪，艰难巳备尝。\n全家音顿阻，孤枕梦难忘。\n会有相逢日，牵衣话更长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1016,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"二月十一日见桃花","author":"高士谈","text":"鸣鸠天色半晴阴，竹屋松窗老寸心。\n闭户不知春早晚，桃花红浅柳青深。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1017,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"志隐轩","author":"高士谈","text":"家居潇洒似江村，花草侵阶水映门。\n元亮结庐山挂眼，孔融好客酒盈尊。\n肯教轩冕移心志，未厌林泉入梦魂。\n我亦平生倦游客，一廛无处问东屯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1018,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"偶题","author":"高士谈","text":"羡他田父老于农，远是庄西与舍东。\n不似宦游情味恶，半生常在别离中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1019,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿田舍","author":"马定国","text":"狂风作帚扫春阴，投宿田庐话古今。\n尊俎只如平日事，干戈方识古人心。\n凄凉一树梅花发，迤逦千门柳色深。\n天子蒙尘终不返，酒酣相对泪沾襟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1020,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"清平道中","author":"马定国","text":"棘林苦苣野花黄，一马骎骎渡漯阳。\n别墅酒旗依古柳，点溪花片落新香。\n伏波事业空归汉，都护田园不记唐。\n今日清明过寒食，又将书剑客他乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1021,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"长相思","author":"马定国","text":"历历春阳被群木，白沙浅水明如鹄。\n结庐聊可障雨风，学道未能充耳目。\n故人家居紫翠傍，枳篱日落青山长。\n岁云晏矣不可见，望尽楚天飞鸟行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1022,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"招康元质","author":"马定国","text":"此生依著定何如，不傍耕畴即钓蓑。\n北阜平芜随鸟远，东湖新涨与天多。\n诗成重墨题飞叶，睡起轻芒踏软莎。\n犹有客愁销不尽，风轩茶灶待君过。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1023,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨晴离开化寺","author":"马定国","text":"涧谷流秋水，楼台入暮寒。\n连城遭雨积，一日得泥乾。\n利剑青鲨室，名驹白铁鞍。\n回头栖隐地，风树响珊珊。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1024,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋日书事","author":"马定国","text":"南山悠悠去天尺，雀寒未晚争投棘。\n野人篱落不胜荒，溪欲绝流堆乱石。\n小园蔬药知有无，未免杖藜烦两屐。\n雾蒙甘菊细茎紫，风动牵牛晚花碧。\n邻舍翁归竹几空，秋天日落松窗寂。\n小杯翻酒足自娱，闾巷浮沈真可惜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1025,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读庄子","author":"马定国","text":"吾读漆园书，秋水一篇足。\n安用十万言，磊落载其腹。\n北风熟柤梨，冷日照鸿鹄。\n人生固多事，端坐至秉烛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1026,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪霁","author":"马定国","text":"高岩旭日吐深赪，雪霁楼台白玉京。\n独往南塘探春色，枇杷花下竹鸡鸣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1027,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒食","author":"马定国","text":"燕泥半落乌衣巷，柳色全添绿绮窗。\n且伴丁香过寒食，弄晴蝴蝶一双双。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1028,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游何氏园","author":"马定国","text":"八尺龙蛇薜荔墙，瘦松疏竹更苍凉。\n梅花映水无人见，隔岸飞来片片香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1029,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"四月十日遇周永昌二首 其一","author":"马定国","text":"竹里涓涓雨未晴，日高窗牖受虚明。\n数家燕雀青雏出，是处园林绿颗成。\n贫觉酒杯真有味，病思丘壑岂无情。\n东山旧隐许相过，他日秋原看耦耕。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1030,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"四月十日遇周永昌二首 其二","author":"马定国","text":"幼时种木巳巢鸢，犹向花前作酒颠。\n郭外青山招晓出，圃中明月照春眠。\n世无苏黄六七子，天断文章三十年。\n今日逢君如旧识，醉持杯杓望青天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1031,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过李湘","author":"马定国","text":"数树高槐散乳鸦，时于缺处见黄花。\n凉风不断如流水，相对胡床坐日斜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1032,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪","author":"马定国","text":"红楼翠瓦不禁寒，欲剪梅花去路难。\n净扫竹亭聊饮酒，恰如明月照金盘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1033,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"怀高图南","author":"马定国","text":"刘叉一狂士，尚得韩愈知。\n君才百刘叉，知者果其谁。\n三随计吏贡，蹑履游京师。\n文章善变化，不以一律持。\n碧海涵万类，青天行四时。\n去年高唐别，河柳摇风枝。\n今年清明饮，高花见辛夷。\n兹来又几日，军檄忽四驰。\n尺书无处寄，相见果何期。\n白日斗龙蛇，黄尘笳鼓悲。\n春风独无忧，吹花发江湄。\n一杯送归雁，万里寄相思。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1034,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送王松年之汶上","author":"马定国","text":"去去东平道，飞辕不可攀。\n地邻邾子国，天近穆陵关。\n问俗徵前事，移家卜好山。\n溪堂醉花月，春兴几时还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1035,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"香严病中","author":"马定国","text":"九州四海尽行路，万户千门非我家。\n金弹不徒惊燕雀，春雷终待起龙蛇。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1036,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题崇子中庵","author":"马定国","text":"羡君高节似陶潜，五亩园林老不添。\n遁世人情虽淡薄，开门秋色自清严。\n案头黄卷香终日，砌下苍苔雨一檐。\n后夜中秋更应好，隔窗云木看飞蟾。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1037,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"村居五首 其二","author":"马定国","text":"蚕蛹成蛾桑柘稀，海棠花发照窗扉。\n离骚读罢无人会，独立溪南看夕晖。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1038,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"村居五首 其三","author":"马定国","text":"五月南风化蟪蛄，野塘晚笋未成蒲。\n柽花落尽红英细，沙渚鸳鸯半引雏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1039,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"村居五首 其四","author":"马定国","text":"柿叶经霜菊在溪，天寒落日见鸡栖。\n西家有客篘新酒，红叶萧萧盖芋畦。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1040,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"村居五首 其五","author":"马定国","text":"岁暮行人竟不来，空吟溪树觅寒梅。\n何时消尽关山雪，收拾春风入酒杯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1041,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宣政末所作","author":"马定国","text":"山杏山桃取次开，红红白白上楼台。\n移将海底珊瑚树，乞与人家也不栽。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1042,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"舟次丹阳","author":"祝简","text":"船头东下趁晨钟，船外清霜气暗通。\n断雁声归烟霭里，孤帆影落月明中。\n隋河波浪千年急，梁苑池台一半空。\n试问碧堤无限柳，败条衰叶几秋风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1043,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"下第鱼台东寺","author":"祝简","text":"病眼逢花亦倦开，流莺飞去误相猜。\n多情却爱僧堂燕，才得春风却再来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1044,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"青奴","author":"祝简","text":"名实于人不可诬，马牛我亦受人呼。\n世间物化多难晓，谁谓此君为此奴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1045,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗二首 其一","author":"祝简","text":"雨后清寒满袖风，雁声南去暮云浓。\n秋来杞菊能多少，欲助盘餐自不供。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1046,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗二首 其二","author":"祝简","text":"榴花娇欲斗罗裙，石竹开成碎缬文。\n更有戎葵亦堪爱，日烘红脸酒初醺。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1047,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"虚极斋独坐","author":"祝简","text":"虚斋长铗短灯檠，明月当窗夜气清。\n却掩尘编时闭目，胡床独坐听秋声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1048,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"相国寺钟","author":"祝简","text":"寒鸡缩颈未鸣晨，已听舂容入梦频。\n未必佛徒知警悟，祗能唤起利名人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1049,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日","author":"祝简","text":"莺语相喧浩荡春，落花细点禁街尘。\n游丝飞絮狂随马，迟日和风欲醉人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1050,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夏雨","author":"祝简","text":"电掣雷轰雨覆盆，晚来枕簟颇宜人。\n小沟一夜水三尺，便有蛙声喧四邻。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1051,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和常祖命二首 其一","author":"祝简","text":"著书不得自名家，卷里蝇头散眼花。\n未用一杯张翰酒，正须七椀玉川茶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1052,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和常祖命二首 其二","author":"祝简","text":"操笔文章学古风，平生羞与腐儒同。\n相如虽有凌云赋，不及东方射守宫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1053,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"检旱","author":"祝简","text":"草树连云绿间黄，年饥村落自荒凉。\n晚蝉抱树声声急，野菊迎人细细香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1054,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游龙门访潜溪僧舍","author":"张子羽","text":"入谷访精舍，钟声先远闻。\n阳光时翳竹，泉脉俄当门。\n山僧禁足久，瞑目诵微言。\n要知鹿台寺，但指山头云。\n策杖御栝西，幽兰秀荆榛。\n风烟浩难及，薄暮花纷纷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1055,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿宝应","author":"张子羽","text":"重岩烟霭合，宝閤春风暮。\n山深月影迟，坐久识归路。\n伊昔府中彦，征骖同夜驻。\n徂年能几时，变灭等轻雾。\n禅房伴茗饮，岂待酒中趣。\n卧来清不寐，瘦鹤惊宿露。\n黎明觅旧题，松间宛如故。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1056,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寿张和滑益之","author":"张子羽","text":"理发秋庭趁夕阳，静中谁可共传觞。\n云横故国三年别，水绕孤村六月凉。\n病眼只贪书味永，渴心频梦橘奴香。\n鱼山早有终焉计，少日应容解印章。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1057,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"南越行","author":"朱之才","text":"南越太后邯郸女，皓齿明眸照蛮土。\n珊瑚为帐象作床，锦伞高张击铜鼓。\n太液池内红芙蓉，自怜谪堕蛮烟中。\n灞陵故人杳无耗，深宫独看南飞鸿。\n随儿作帝心不愿，惟愿西朝柏梁殿。\n茂陵刘郎亦可人，遣郎海角来相见。\n金猊夜燎龙涎香，明珠火齐争煌煌。\n番禺秦甸隔万里，今夕得遂双鸳鸯。\n白首相君佩银印，干戈欲起萧墙衅。\n莫言女子无雄心，置酒宫中潜结阵。\n汉家使者懦且柔，纤手自欲操霜矛。\n孤鸾竟落老枭手，可怜空奋韩千秋。\n楼船戈鋋师四起，或出桂阳下漓水。\n越郎追斩吕嘉头，九郡同归汉天子。\n尉□坟草几番青，霸业犹与炎洲横。\n玉玺初从真定得，黄屋却为邯郸倾。\n五羊江连湘浦竹，娇魂应伴湘娥哭。","collection":"金","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1058,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"后薄薄酒二首 其一","author":"朱之才","text":"薄酒可以谋醉，不必霞滋玉味。\n粗布可以御冬，不必狐貉蒙茸。\n丑妇可以肥家，不必楚女吴娃。\n独夫长夜商祚讫，羲和湎淫紊天历。\n李白跌宕三百杯，阮籍沈醟六十日。\n眠瓮吏部寡廉耻，解貂常侍隳法律。\n傥使饮薄酒，未见有此失。\n秦昭狐腋几丧首，郑臧鹖冠贻厥咎。\n尨裘金玦岂不哀，绣衣朱襮固无取。\n皆缘粗衣恶不御，贾祸招讥亦何有。\n夏姬灭两国，骊姬祸五世。\n捧心颦眉亡夫差，堕髻啼妆败梁冀。\n丑妇似可恶，终不至颠沛。\n劝君饮薄衣粗娶丑妇，此乐人间最长久。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1059,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"后薄薄酒二首 其二","author":"朱之才","text":"薄酒粗衣吾何悲，丑妇自丑吾不知。\n道眼混圆宜不二，美恶妍陋无殊归。\n瓦罍石臼斟吾酒，脱粟藜羹皆可口。\n醉境陶然无后忧，玉盌浮蛆彼何有。\n汉文天子犹弋绨，士服粗布乃所宜。\n要绳屐葛同一暖，雾縠冰纨徒尔为。\n无盐如漆后齐桓，孟光举臼配伯鸾。\n古来倾城由哲妇，有国乃令家国安。\n我能遣妇缝粗对妇饮薄，傍人大笑吾不恶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1060,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寓言二首 其一","author":"朱之才","text":"兽有善触邪，草有能指佞。\n兽草非有心，不移本天性。\n前王著臣冠，俾尔效端鲠。\n如何不称服，触指反忠正。\n吾欲取二物，豢植列台省。\n一令邪佞徒，奔逃亟深屏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1061,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寓言二首 其二","author":"朱之才","text":"风雨晦时夜，鸡鸣有常声。\n霜雪枯万干，松柏有常青。\n内守初已定，外变终难更。\n若人束世利，浮沈无定情。\n俯仰效?槔，低昂甚权衡。\n反出木鸟下，徒为万物灵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1062,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"谢孙寺丞惠梅花","author":"朱之才","text":"我来泗水上，居与墟墓邻。\n弥望多枣栗，碍眼皆荆榛。\n忽忽度岁月，不知时已春。\n朝来佳公子，遗我梅花新。\n秀色照窗几，妙香袭衣巾。\n莽如瓦砾场，惊睹琼瑶珍。\n念昔客江南，千树临江津。\n吴侬不知贵，但与桃李伦。\n自从堕东土，梦绕江之滨。\n叹彼和鼎实，亦复生不辰。\n穷愁坐空山，豺虎杂凤麟。\n此赠意不浅，难为俗子陈。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1063,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵东坡跋周昉所画欠申美人","author":"朱之才","text":"巫峡昭君有奇色，毛生欲画无由得。\n但作东风背面身，看来已可倾人国。\n朝来睡起鬓发垂，手如春笋领蝤蛴。\n绣帷幽梦断难续，想像翠黛颦修眉。\n春光三月浓于酒，燕燕双飞莺唤友。\n不教腻脸露桃花，且喜腰支似杨柳。\n君不见汉宫多病李夫人，转面不顾君王嗔。\n古来画工画意亦自足，烟雾玉质何由真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1064,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"暴雨","author":"朱之才","text":"掣电奔雷晻霭间，崩腾白雨袭人寒。\n颓山黑雾倾浓墨，倒海冲风泻急湍。\n势似阳侯夸海若，声如项籍破章邯。\n炎歊一濯须臾耳，已看天围碧玉宽。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1065,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿闲厩","author":"朱之才","text":"澹烟衰草慵回首，晚日残霞欲断魂。\n脱帽卸鞍投逆旅，萧萧黄叶水边村。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1066,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]