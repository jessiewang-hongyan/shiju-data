[{"title":"饮密国公诸子家","author":"王郁","text":"宣平坊里榆林巷，便是临淄公子家。\n寂莫画堂豪贵少，时容词客醉琵琶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2206,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"出塞","author":"邢具瞻","text":"楼外青山半夕阳，寒鸦翻墨点林霜。\n平沙细草三千里，一笛西风人断肠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2207,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"江天秋晚图","author":"王绘","text":"万顷波间踏浪儿，潇湘秋晚趁归时。\n四山红叶风声健，散入侬家欸乃词。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2208,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉使江左读同官萧显之西湖行记因题其后","author":"王竞","text":"云烟浓淡费临摹，行记看来即画图。\n云梦不妨吞八九，笔头滴水了西湖。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2209,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"马嵬道中","author":"杜佺","text":"垂柳阴阴水拍堤，春晴茅屋燕争泥。\n海棠正好东风恶，狼藉残红送马蹄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2210,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"望瀛台春望","author":"边元勋","text":"晴云如困柳如痴，丹杏开残碧草齐。\n一派望瀛台下水，煖风迟日浴凫鹥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2211,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"七夕","author":"边元勋","text":"高楼人散酒樽空，漫拟新文送五穷。\n独倚南窗夜岑寂，一钩凉月下疏桐。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2212,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书呈仲孚","author":"李之翰","text":"造物固难量，谁能计寒饿。\n失马乃为福，梦牛翻作祸。\n长溪霜练静，脩岭苍龙卧。\n魂梦吾已安，不劳歌楚些。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2213,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题密云州学壁","author":"李之翰","text":"崎岖到此兴何堪，况复风谣意未谙。\n旅舍萧条空自遣，胸怀磊落向谁谈。\n留连暮雨侵疏牖，宛转飞云埽翠岚。\n因忆林泉归去好，一灯幽梦绕春潭。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2214,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中京遇因长老","author":"李之翰","text":"天涯流落偶生还，古刹相逢语夜阑。\n叹我归途千里远，喜君禅榻一身安。\n松声不断风吟细，月影无边露气寒。\n分手山堂更寥索，冷云衰草伴征鞍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2215,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"岁暮","author":"李之翰","text":"休怪年来白发新，天涯三载困埃尘。\n偶离沙碛穷阴地，收得桑榆老病身。\n对雪莫吟秦岭句，拨醅且醉汉江春。\n此生自断无馀事，何必区区问大钧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2216,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题平阴僧寺","author":"三兴居士","text":"三吴家近水晶宫，行坐红香绿影中。\n今日异乡僧寺里，一盆荷叶战西风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2217,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"出剑门","author":"杨兴宗","text":"呕哑鸣橹下长川，万叠青峰只眼前。\n山鹧啄残红杏粉，杜鹃啼破绿杨烟。\n梦回蜀栈云千片，醉枕巴江月一船。\n物色谁分杜陵老，风骚牢落剑南天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2218,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"甘露寺","author":"赵亮功","text":"郑南峰下寺，泉石间疏篁。\n飞雨度山阁，閒云生野塘。\n檐前松子落，廚际柏烟香。\n别后闻钟磬，山阴空夕阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2219,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题安生僧寺","author":"贾泳","text":"重来已是五年游，忧患相仍欲白头。\n翻羡亭亭两奇树，不知风雨过春秋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2220,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"红梅","author":"元日能","text":"天上琼儿白玉肌，吴妆略约更相宜。\n认桃辨杏由君眼，自有溪风山月知。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2221,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和高子初梅","author":"范墀","text":"春风也自惜流光，只放寒梅一树芳。\n玉粉更妆前夜雪，口脂犹注昔年香。\n江湖昨梦谁同记，诗酒风流岂易忘。\n东阁何郎未全老，花枝休笑鬓丝长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2222,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送客","author":"王仲通","text":"措足疑无地，扪心幸有天。\n故人成邂逅，残喘见哀怜。\n落日惊䰟外，孤云泪眼边。\n西归万里梦，今夕到君船。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2223,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄元真同年","author":"韩汝嘉","text":"十年尘土鬓毛斑，杖屦还来踏故山。\n叶寄残红春尚在，云酣湿翠雨仍悭。\n不堪倚树追前事，更恐临溪见病颜。\n一日暂来千日去，何时倦鸟得真还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2224,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王右辖许送酒久而不到以诗戏之","author":"王启","text":"燕酒名高四海传，兵厨许送已经年。\n青看竹叶应犹浅，红比榴花恐更鲜。\n枕上未消司马渴，车前空堕汝阳涎。\n不如便约开东閤，一看长鲸吸百川。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2225,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杜鹃","author":"晁会","text":"杜宇啼声枕上来，一声哀似一声哀。\n千哀万怨无今古，唤得行人若个回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2226,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游太宁寺","author":"王璹","text":"西山踏破万层青，与客携壶上太宁。\n泉石有情容避俗，轩裳无术可逃形。\n云萦屋角僧禅静，露下松梢鹤梦醒。\n明日却寻尘镜去，晓猿啼月若为听。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2227,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"清水寒食感怀","author":"李献可","text":"桃花零乱柳成阴，人到春深思更深。\n芳草戍楼天不尽，异乡寒食故乡心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2228,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"召还过故关山","author":"李献可","text":"过关天日正晴明，谁道山神不世情。\n远客得归心绪别，陇泷閒作断肠声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2229,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"佛岩寺","author":"魏道明","text":"虎谷西垠北口南，横桥过尽见松庵。\n旧游新梦犹能记，般若真如得遍参。\n霜圃撷蔬充早供，石泉煮茗荐馀甘。\n残年便拟依僧住，过眼空花久已谙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2230,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"退食","author":"魏道明","text":"竿头犊鼻清贫在，梦里槐安旧习空。\n退食归来澹无事，水边长啸看晴虹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2231,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"食松子","author":"雷思","text":"千岩玉立尽长松，半夜珠玑落雪风。\n休道东游无所得，岁寒梁栋满胸中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2232,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"乌子秀自左司员外郎左迁上京幕官","author":"王翛","text":"楚山白玉点蝇头，正坐胸中有九流。\n同部吏郎皆五马，不知山鬼解揶揄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2233,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"马嵬","author":"高有邻","text":"事去君王不奈何，荒坟三尺马嵬坡。\n归来枉为香囊泣，不道生灵泪更多。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2234,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"还紫云寺素扇且题诗其上","author":"宋楫","text":"吴绫便面小团团，信手拈来亦厚颜。\n障尽驿尘三十里，却还明月紫云间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2235,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庭槐","author":"宋楫","text":"庭槐先人手所植，再世清阴方满台。\n惭愧儿孙种桃李，花枝准拟当年开。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2236,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"坐忘女","author":"高德裔","text":"结习销来性自圆，去留元不间人天。\n消摇自是忘形蝶，枯寂宁同委蜕蝉。\n无碍真空常荡荡，若存馀息尚绵绵。\n立亡坐脱皆游戏，定力何尝有变迁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2237,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杨秘监释迦出山像","author":"路仲显","text":"自从此老出山隅，恼乱苍生底事无。\n他日若逢杨处士，只教画个涅槃图。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2238,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同新进士吕子成辈宴集状元楼","author":"张大节","text":"鹦鹉新班宴杏园，不妨老鹤也乘轩。\n龙津桥上黄金榜，三见门生是状元。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2239,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"拟古","author":"赵悫","text":"春风动地来，依依烧痕青。\n王孙行不归，离恨何时平。\n翩翩谁家儿，晓猎开红旌。\n彫弓插白羽，怒马悬朱缨。\n围合意气雄，厮养厌庖烹。\n人生一春草，时至何足荣。\n君看五陵树，日暮悲风生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2240,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"蜀山晓发","author":"赵悫","text":"晓发蜀山道，山深人自迷。\n残星数徽小，斜月一梳低。\n隔舍缲车响，遥林杜宇啼。\n区区事行役，何日得安栖。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2241,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒斋雪中书呈许守","author":"赵悫","text":"剪水作花开，纷纷天上来。\n声清偏傍竹，艳冷欲欺梅。\n积润滋牟麦，馀膏丐草莱。\n穷阎休叹息，数日是春回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2242,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"义师院丛竹","author":"郭长倩","text":"南轩移植自西坛，瘦玉亭亭十数竿。\n得法未应输老柏，植根兼得近幽兰。\n虽无秾艳包春色，自许贞心老岁寒。\n百草千花尽零落，请君来向此中看。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2243,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"偶得","author":"郭用中","text":"参遍丛林懒出游，指端孤月照高秋。\n大千界里閒窥掌，不二门中暗点头。\n埽地烧香聊自遣，栽花种竹尽风流。\n庄蒙抵死谈齐物，无物齐时也合休。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2244,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"许道宁群峰暮雪","author":"赵之杰","text":"道士平生林野人，醉中拈出雪峰真。\n为君疗却烟霞癖，比似青囊药更神。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2245,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题济源龙潭寺","author":"赵之杰","text":"树围修竹竹围庵，庵下泓然碧一潭。\n极目荷花半秋色，小横图上看江南。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2246,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"除夜","author":"赵之杰","text":"日月不肯留，岁历倏云毕。\n僧坊见节物，新正在明日。\n夜半拊枕叹，半百又加七。\n形骸念念改，膂力能不失。\n经言男数八，此去才有一。\n健者未可期，况乃常衰疾。\n物情忌盈满，君子慎名实。\n行矣安退閒，吾其保终吉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2247,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿来同堡","author":"赵鼎","text":"渭北洮南过却春，穷边冰雪更愁人。\n来同驿里题诗处，破屋青灯一病身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2248,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿万安寺","author":"田特秀","text":"长途鞍马倦黄尘，喜见空岩万叠云。\n漫漫野烟迷去鸟，萧萧林叶带残曛。\n苔封老桧龙鳞起，石碍流泉燕尾分。\n夜敞松窗耿无寐，一庭萝影月纷纷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2249,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"歌扇","author":"赵文昌","text":"媚娘巧作贯珠㗋，画扇团团半掩羞。\n唱到春山小颦处，一轮明月为花愁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2250,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"裴氏西园","author":"高公振","text":"簿领沉迷倦不禁，偶从名胜此幽寻。\n竹阴疏处见潭影，人语定时闻鸟音。\n陈迹谩留千古恨，欢游聊慰十年心。\n多情一片梁园月，送我垂鞭出上林。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2251,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"石淙","author":"张彀","text":"颍水洗馀高士耳，是非犹恐污人牛。\n区区武媚何为者，水上磨崖纪宴游。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2252,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"漫书","author":"宗端修","text":"冷面宜教冷眼看，只惭索米向长安。\n阴崖何限枯松树，望见屏帏尽牡丹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2253,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠石德固","author":"张翰","text":"西湖之月清无尘，橘中之乐犹避秦。\n向来所见止此耳，渠亦岂是真知津。\n如君眼孔乃许大，万事付之尘甑堕。\n儿能诗书又肯播，著脚世间看踏破。\n青巾玉带桃李花，日斜空望紫云车。\n布衣谁识隐君子，一马㿉然何处家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2254,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再过回公寺","author":"张翰","text":"山州风土极边头，二十年中复此游。\n青鬓已随人事改，碧溪犹绕寺门流。\n轻寒剪剪侵驼褐，小雪霏霏入蜃楼。\n为问劳生几时了，不成长抱异乡愁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2255,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"万宁宫朝回","author":"张翰","text":"宿雨初收变晓凉，宫槐恰得几花黄。\n鹊传喜语留鞘尾，泉打空山辊鞠场。\n已觉云林非俗境，更从衣袖得天香。\n太平朝野欢娱在，不到莲塘有底忙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2256,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉使高丽过平州馆","author":"张翰","text":"昨日龙泉已自奇，一峰寒翠压檐低。\n兼并未似平州馆，屋上层峦屋下溪。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2257,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"金郊驿","author":"张翰","text":"山馆萧然尔许清，二更枕簟觉秋生。\n西窗大好吟诗处，听了松声又雨声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2258,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"邵智夫同游南城","author":"李好复","text":"园林晴昼蔚如烟，林外支流尽水田。\n落日趁墟人已散，鹭鸶飞上渡头船。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2259,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨中与客饮","author":"李好复","text":"门外平桥一水分，数声渔唱隔溪闻。\n暖风落絮飘香雪，小雨沾花湿梦云。\n酿具未甘名长物，诗坛聊欲张吾军。\n相逢莫惜通宵饮，明日閒身不属君。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2260,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"墨梅","author":"杨邦基","text":"粉蝶如知合断魂，啼妆先自怨黄昏。\n花光笔底春风老，寂莫岭南烟雨痕。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2261,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"广平道中","author":"吕子羽","text":"风色著黧面，霜华侵老须。\n昏埃埋故驿，积雪缟脩途。\n冻岫新诗句，寒林古画图。\n夜寒孤月上，天地一冰壶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2262,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿章义广胜寺","author":"吕子羽","text":"小邑本无事，我来劳简书。\n路长频问马，人静厌烹鱼。\n钟冷僧参外，灯残客梦馀。\n此心谁领会，松月夜窗虚。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2263,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"至日","author":"吕子羽","text":"岁晏多风雪，官閒深屋庐。\n小诗穷则变，美酒数斯疏。\n未草归田赋，空翻引睡书。\n窗明添眼力，已觉日光舒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2264,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"李白醉归图","author":"吕子羽","text":"春风醉袖玉山颓，落魄长安酒肆回。\n忙煞中官寻不得，沉香亭北牡丹开。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2265,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"军中寄亲旧","author":"赵文昌","text":"军中从事鬓丝垂，把钓江湖与愿违。\n红叶关河为客久，黄花时节寄书归。\n霜天不尽孤云远，秋意无聊一雁飞。\n乡社故人应念我，岂知南望更依依。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2266,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终二诗 其一","author":"韩玉","text":"客自朝那戍，东过古郑原。\n衰年会凶运，奇祸发流言。\n白骨将为土，青蝇且在樊。\n仰呼天外恨，沉思地中冤。\n母丧半途鬼，儿孤千里䰟。\n此心终不灭，有路诉天阍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2267,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临终二诗 其二","author":"韩玉","text":"天下无双士，军中有一韩。\n才名两相累，世道一何艰。\n旅次穷冬暮，囚孤永夜寒。\n身亡家亦破，巢覆卵宁完。\n矍铄鞍仍在，惊呼铗屡弹。\n丈夫忠义耳，无惜感歌还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2268,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题神霄宫清心轩","author":"王扩","text":"纷纷百虑自心生，方寸清来百虑平。\n未了此心私自笑，更忧时世欲澄清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2269,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"蜡梅二首 其一","author":"赵伯成","text":"冻蕾含香蜡点匀，古来幽谷有佳人。\n诗家只怨和羹晚，不道红梅别是春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2270,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"蜡梅二首 其二","author":"赵伯成","text":"冷艳疏香寂莫滨，欲持何物向时人。\n东风自是清狂手，办作竹篱茅舍春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2271,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元弟以所业见投赋诗为赠","author":"赵伯成","text":"耆旧隔存殁，为君重叹嗟。\n人门得嵇绍，文赋见张华。\n夙有凌云笔，方乘犯斗槎。\n忘年即吾友，未可论通家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2272,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"江天暮雪图","author":"梁仲新","text":"南雪不到地，霏霏满竹楼。\n沙河灯市里，春在木绵裘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2273,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"閒咏","author":"卢元","text":"天近苍龙阙，居连白马堂。\n松声得邻舍，山色出宫墙。\n巷陋轮蹄少，庭閒日月长。\n九衢红雾里，亦有白云乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2274,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"纸鸢","author":"石抹世绩（一首","text":"鸱鸢雕鹗谁雌雄，假手成形本自同。\n果物戏人人戏物，为风乘我我乘风。\n扶摇漫拟层霄上，高下都归半纸中。\n儿辈呶呶方伫目，岂知天外有冥鸿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2275,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠韶山退堂聪和尚","author":"范中","text":"郎当舞袖少年场，线索机关似郭郎。\n今日棚前閒袖手，却从鼓笛看人忙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2276,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"呈同官崔伯善李顺之","author":"赵思文","text":"睡起松阴鸟雀哗，忽惊霜果堕檐牙。\n简书迫促全疏酒，眼力眵昏只费茶。\n不学道人餐柏叶，却随举子踏槐花。\n提衡文字非吾事，崔李风流有故家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2277,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]