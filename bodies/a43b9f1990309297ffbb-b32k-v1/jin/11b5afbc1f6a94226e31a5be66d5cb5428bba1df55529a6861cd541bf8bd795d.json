[{"title":"和韦苏州二十首 其十三 游开元精舍","author":"赵秉文","text":"松轩风扫静，终日闭门居。\n犬卧青苔地，鸟衔红柿初。\n瓶残夜禅起，经润雨翻馀。\n自是少人迹，非关往来疏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":437,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十四 答中山道士","author":"赵秉文","text":"行转青溪又别峰，马蹄终日认樵踪。\n翠微深处无人住，寺在深山何处钟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":438,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十五 西楼","author":"赵秉文","text":"十去龙沙雁，年年九不归。\n烟尘犹未息，莫近塞云飞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":439,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十六 琅琊万寿寺","author":"赵秉文","text":"兹寺废已久，经构昔未遑。\n一朝焕金碧，煌煌耀东岗。\n文母开大施，天厨来众香。\n萦回转佛阁，窈窕閟禅房。\n平地俯归鸟，高斋在上方。\n宿云不归山，野水自成塘。\n道人如水镜，见者心清凉。\n理胜是非遣，虑淡形迹忘。\n归鞍惜清境，伫立暮天苍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":440,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十七 漠漠来帆重冥冥去鸟迟","author":"赵秉文","text":"薄暮潇潇雨，何人独倚栏。\n濛濛山气重，漠漠水纹寒。\n草际光犹泫，松梢滴未乾。\n灯前未归客，无梦到长安。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":441,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十八 何时风雨夜复此对床眠","author":"赵秉文","text":"幽居少人事，有客来不速。\n炉内火正红，尊中酒新绿。\n高斋始闻雁，隔窗时动竹。\n何当风雪夜，抱被还同宿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":442,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其十九 绿阴生昼寂孤花表春馀","author":"赵秉文","text":"了无车马迹，终日掩禅关。\n不下溪头路，坐看檐际山。\n好鸟破午寂，幽花淡春闲。\n簪组方为累，来游不知还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":443,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和韦苏州二十首 其二十 兵卫森画戟燕寝凝清香","author":"赵秉文","text":"冠带事朝谒，清坐弹鸣琴。\n以彼尘外趣，远我遗世心。\n岸帻送归鸟，隐几见遥岑。\n聊得静者乐，岂必居山林。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":444,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送麻徵君知几","author":"赵秉文","text":"丹山五色凤，一举眇天隅。\n文采瑞圣世，不为竹与梧。\n渥洼汗血种，逸气淩九区。\n可见不可絷，白璧谁敢沽。\n夫君号神童，七岁能草书。\n二十上词赋，下笔淩紫虚。\n三十富经学，两魁天下儒。\n蛾眉众女嫉，反畏知名誉。\n一朝相舍去，愿以道自娱。\n闲观养性书，洞究先天图。\n姓字闻天朝，相公借吹嘘。\n从容拜恩命，移疾还里闾。\n诸公惜其去，乞留侍玉除。\n掉头不肯住，一饭吾岂无。\n君看泽中雉，饮啄良自如。\n一旦畜樊中，意气惨不舒。\n又如田间牛，腾掷适有馀。\n被之以文绣，顾影反踟蹰。\n君恩岂不重，力疾须人扶。\n旁观信美矣，违已非病欤。\n不如本无累，还我田园居。\n喜君节独高，知君功名疏。\n可以激颓俗，可以励贪夫。\n异时高士传，名与西山俱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":445,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"饮马长城窟行","author":"赵秉文","text":"饮马长城窟，泉腥马不食。\n长城城下多乱泉，多年冷浸征人骨。\n单于吹落关山月，茫茫原上沙如雪。\n十去征夫九不回，一望沙场心断绝。\n胡人以杀戮为耕作，黄河不尽生人血。\n木波部落半萧条，羌妇翻为胡地妾。\n圣皇震怒下天兵，天弧夜射旄头灭。\n九州复禹迹，万里还耕桑。\n但愿猛士守四方，更筑长城万里长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":446,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"猛虎行","author":"赵秉文","text":"孤虎在深山，一怒风林披。\n朝食千牛羊，暮食千熊罴。\n虎暴尚可制，人还寝其皮。\n旄头飞精光，落地为积尸。\n焚山赭草木，血积成污池。\n万灵泣上诉，生民将何为。\n帝怒敕六丁，雷电下取之。\n埋魂九地底，压以泰山坻。\n然后天下人，颇得伸其眉。\n寄言颠越者，毋得育种遗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":447,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"仿老杜无家","author":"赵秉文","text":"弟妹他乡隔，无家问死生。\n兵戈尘共暗，江汉月偏清。\n落日黄牛峡，秋风白帝城。\n中原消息断，何处是秦京。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":448,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"仿刘长卿出塞二首 其一","author":"赵秉文","text":"上山摇白旗，下马驻旌麾。\n虏骑数重合，汉人三日围。\n天寒短兵接，日暮战声微。\n万里天山北，招魂葬不归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":449,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"仿刘长卿出塞二首 其二","author":"赵秉文","text":"初从召募军，麾下点行频。\n衣上两行泪，灯前万里身。\n鼓声青海振，战骨黑山尘。\n落日边风起，萧萧愁杀人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":450,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杨妃墓","author":"赵秉文","text":"灼灼陌上花，青青路傍草。\n人心任荣悴，过眼无丑好。\n马嵬三尺坟，西出剑门道。\n如何倾国颜，伤心不同老。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":451,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"李夫人墓","author":"赵秉文","text":"夫人临诀时，掩面羞人主。\n空馀返魂香，默默不得语。\n千秋百岁后，粉黛化为土。\n一笑不成妍，春风花自舞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":452,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"延安滋戒师余初主安塞堡簿时相识也今戊子岁春被命作醮平凉偶得相会以四十三年之旧故集句以赠之","author":"赵秉文","text":"五城何迢迢，关河茫茫隔波浪。\n与君别来今几时，翰林白发三千丈。\n形容变尽语音存，闲思往事是前身。\n四十三年如电抹，欲谈前事恐无人。\n庞眉皓首无住著，臂上念珠如皎月。\n架上楞严已不看，更看脚根参一节。\n人生何处不相逢，犹恐相逢是梦中。\n仝是行人更分首，明朝车马各西东。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":453,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"塞上四首 其一","author":"赵秉文","text":"穷边四十里，野户两三家。\n山腹过云影，波光战日华。\n汲泉寻涧曲，樵路入云斜。\n随分坡田罢，还簪野草花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":454,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"塞上四首 其二","author":"赵秉文","text":"因寻射雕垒，偶到杀狐川。\n卤地牛羊瘦，边沙草木膻。\n废城馀井臼，古戍断烽烟。\n自说无征战，经今六十年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":455,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"塞上四首 其三","author":"赵秉文","text":"薄宦边城里，经年无客过。\n一川平地少，四面乱山多。\n野色连秋塞，边声入暮河。\n旧貂寒更薄，飘寄欲如何。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":456,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"塞上四首 其四","author":"赵秉文","text":"树霭连山郭，林烟接塞垣。\n断崖悬屋势，涨水没沙痕。\n烽火云间戍，牛羊岭外村。\n太平闲檄手，文字付清樽。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":457,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒夜","author":"赵秉文","text":"岁晏寒无那，夜深清欲饥。\n竹风惊梦断，雪意听窗知。\n稍稍鹊翻树，萧萧人语篱。\n虚明满吾室，何许月来时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":458,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三山渡口","author":"赵秉文","text":"春水三山渡，斜阳八字堤。\n河淤树身短，沙截草痕齐。\n地纳黄流大，天衔浚泽低。\n故人不我见，愁思使人迷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":459,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西陵","author":"赵秉文","text":"蔼蔼西陵树，萧条歌吹声。\n客愁连断雁，地古更荒城。\n山色娇新雨，河流怒不平。\n浮云台上起，不尽古今情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":460,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"柏人光武庙","author":"赵秉文","text":"真人开有汉，帝业肇无蒌。\n洒落君臣契，艰危庙社图。\n山川扶鄗邑，日月拱东都。\n社稷千秋里，风云四达衢。\n北风吹雨雪，西日照桑榆。\n旧物馀翁仲，荒祠老祝巫。\n功臣遗像在，时有鼠衔须。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":461,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"正觉院","author":"赵秉文","text":"西日转廊腰，疏钟送泬寥。\n坏墙缘苦竹，破屋上淩霄。\n白发知僧腊，青灯更客宵。\n叶声风外尽，窗雨续萧萧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":462,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"开元寺","author":"赵秉文","text":"岁久开元寺，槐花落石龙。\n僧瓶深碧甃，蜗壁篆金容。\n窗影年年塔，禽栖夜夜钟。\n平生睡秋雨，竹阁味偏浓。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":463,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"散策","author":"赵秉文","text":"解鞍成小憩，散策遂幽欣。\n偶拂水边石，坐看嵓上云。\n桑麻深畏景，水竹淡斜曛。\n兴寄方自得，清凉谁与分。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":464,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梁园中秋","author":"赵秉文","text":"今夜梁园月，相逢酒一尊。\n他时千里共，此会几人存。\n老我追随尽，怜渠笑语温。\n不眠瞻玉兔，终夕露荷翻。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":465,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梅和尚节使挽词二首 其一","author":"赵秉文","text":"鏖战群奔外，申威一呼间。\n功名归死事，义勇鄙生还。\n矢向胡天尽，弓犹汉月弯。\n君王思战苦，起冢象天山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":466,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梅和尚节使挽词二首 其二","author":"赵秉文","text":"走卒知虎将，儿童说义州。\n甘心轻白羽，苦战脱兜鍪。\n援绝挥戈地，创馀振臂秋。\n英魂知不泯，结草抗邦仇。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":467,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"温妃挽词二首 其一","author":"赵秉文","text":"白日森容卫，青春忽夜台。\n鼎湖龙已去，禖馆燕空回。\n仙驾随天远，妆奁恻圣哀。\n祗应彤史上，遗美不尘埃。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":468,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"温妃挽词二首 其二","author":"赵秉文","text":"容卫三春肃，如何一旦殊。\n妃星沦紫极，帝子没苍梧。\n卜地陪长乐，升天后鼎湖。\n皇情何以慰，彤管载嫔虞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":469,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和西溪思归","author":"赵秉文","text":"好在西溪隐，人今白玉堂。\n兴来看画本，梦去拂诗墙。\n旧竹多年合，新松几许长。\n从渠黄石老，独占白云乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":470,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"狱中","author":"赵秉文","text":"处顺初无累，安时故不忧。\n敢遗身后虑，甘向死前休。\n有姊如工部，无儿似邓攸。\n悠悠天地意，还许望松楸。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":471,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"徙倚","author":"赵秉文","text":"徙倚秋原上，长吟动所思。\n草荒天马瘦，日落野鹰饥。\n多病亲朋改，中年齿发衰。\n功名付公等，才力况明时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":472,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒食遥奠西山寺二首 其一","author":"赵秉文","text":"榆中无草色，春水稍渐车。\n野祭一盂饭，乡愁千里馀。\n年年寒食客，日日故园疏。\n莫讶交亲绝，嵇康懒寄书。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":473,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒食遥奠西山寺二首 其二","author":"赵秉文","text":"年来百事废，渐与世情疏。\n案上一杯酒，床头几册书。\n春风疑混沌，水月似空虚。\n顷刻翻晴晦，吾心淡久如。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":474,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赴宁化宿王道","author":"赵秉文","text":"山屋如鸡栅，才容卸马鞍。\n风吹四山雪，月照一川寒。\n不敢侵星起，惟愁上岭难。\n中宵问前路，安枕若为安。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":475,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"观音院","author":"赵秉文","text":"栋宇悬崖上，风烟胜槩中。\n寒通沙渚月，清带雪山风。\n茗水垂瓶得，棋灯凿牖通。\n仍闻马头寺，别业乱山丛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":476,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北垞","author":"赵秉文","text":"驱马北垞上，山光淡复深。\n夕岚无远近，返照有晴阴。\n泉落莓苔石，风吹松栎林。\n悠然成独酌，啼鸟是知音。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":477,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"芦芽山","author":"赵秉文","text":"荷叶平初尽，芦芽势渐分。\n朝来知宿雨，谷底见归云。\n日上松犹滴，风来草自薰。\n临溪归路险，万筏下河汾。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":478,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"荷叶平","author":"赵秉文","text":"平生惯山水，见之如等闲。\n朅来惊老眼，何处无名山。\n崷崒千峰外，苍茫一雨间。\n山神应解事，为我洗孱颜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":479,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"管州道中","author":"赵秉文","text":"龟手酸风里，寒多酒不胜。\n马蹄荒店雪，人迹断桥冰。\n瘦骨成山字，霜髯作戟棱。\n绿窗三丈日，政尔梦腾腾。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":480,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"代郡张氏瑞柏堂","author":"赵秉文","text":"郁郁何年植，盘盘兀老苍。\n文章深篆籀，忠义抱风霜。\n子舍占乌鹊，孙枝托凤皇。\n主人廊庙具，会见拂云长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":481,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"谒北岳","author":"赵秉文","text":"四大神仪一，群山太茂尊。\n奠方荒冀宅，视礼配天孙。\n西送虞渊暮，东瞻碣石暾。\n宝符临代郡，巨镇扼并门。\n控赵襟形壮，包燕气象浑。\n九河探禹迹，万里叫虞魂。\n在昔登封始，初无羽卫烦。\n千官骈部曲，万骑隘山樊。\n卜地恒阳曲，移祠泰始元。\n荒碑刓岁月，飞石?乾坤。\n帝秩加黄屋，宫居象紫垣。\n云楣朽芝瑞，雨砌裂槐根。\n天业恢弘大，山灵翊卫屯。\n巫闾归帝制，长白发金源。\n九庙龙盘接，三邦蛇势吞。\n云烟浮近甸，日月绕中原。\n款谒天香重，封题御署存。\n银镠诸产富，雷雨万灵奔。\n神听羞回德，天聪纳正言。\n负时身九死，去国泪双痕。\n日近趋天阙，生还托圣恩。\n许身空稷契，无术补羲轩。\n帝箓长桑洞，仙岩张果村。\n卜居如可近，重整北山辕。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":482,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过黄崖二首 其一","author":"赵秉文","text":"患难惊身在，龙钟感岁新。\n山川愁倦鸟，岁月老行人。\n落日黄崖古，东风白霫春。\n伤心潢水北，无乃久风尘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":483,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过黄崖二首 其二","author":"赵秉文","text":"落日逢人恐，深秋动旅怀。\n乳鹰家碧嶂，饥虎吼黄崖。\n此道将何适，吾生尚未谐。\n伤心墟落里，犬舐有残骸。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":484,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"桃花岛回寄王伯宜","author":"赵秉文","text":"冰破村桥拥，春寒旅雁低。\n远山封雾小，高浪与云齐。\n岛寺明松雪，潮船溅藕泥。\n诗情吟不尽，寄与画中题。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":485,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"咸平道中","author":"赵秉文","text":"道坏缘冈远，村流自作塘。\n夕阳开野色，秋水纳山光。\n雨住林逾黑，鸟归天更苍。\n冥搜无好句，淡墨写微茫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":486,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庆云道中","author":"赵秉文","text":"对岸青山隔，孤城碧浪开。\n绿芜天际合，白鸟日边回。\n渡口呼舟急，沙头立马催。\n夕烟生极浦，欲上客衣来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":487,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中秋金河感怀","author":"赵秉文","text":"金山今夜月，辽水一尊同。\n雁影不复北，马蹄犹向东。\n山川新战血，宇宙旧飘蓬。\n扰扰馀生事，愁来醉眼中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":488,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登巢云楼","author":"赵秉文","text":"烽火三年戍，沙陀几战场。\n自予甘薄宦，与子各殊方。\n寒木锢春色，高楼倾夕阳。\n如闻洗兵马，失喜问临潢。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":489,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨子元二首 其一","author":"赵秉文","text":"红叶如人老，黄花与世疏。\n物华行婉娩，天宇迥澄虚。\n山作屏风画，雁成人字书。\n相逢一杯酒，秋兴各何如。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":490,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨子元二首 其二","author":"赵秉文","text":"小雨班班落，庭槐槭槭疏。\n秋涵山骨冷，天入水痕虚。\n多病难忘酒，穷愁强著书。\n深惭灵感老，时复问何如。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":491,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"松下独酌","author":"赵秉文","text":"行人隐微径，古寺带平冈。\n山势依城断，河流入野长。\n树欹枝坏道，草卧压颓墙。\n独酌无人共，松风荐一觞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":492,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"松山道中","author":"赵秉文","text":"松漠三百里，飘然一日中。\n山长云不断，地迥雪无穷。\n远岭贪残照，深林贮晚风。\n烟村一回首，独鹤下晴空。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":493,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"叠翠岩三首 其一","author":"赵秉文","text":"枯蘖似黔突，断崖如削瓜。\n林深自风雨，地古更烟霞。\n脚力行将尽，云山殊未涯。\n试穷千里目，直北际龙沙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":494,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"叠翠岩三首 其二","author":"赵秉文","text":"飞身清旷外，著眼有无间。\n崖断疑无地，云开更有山。\n鸟随天影没，人自日边还。\n归梦扶清境，诗情不得闲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":495,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"叠翠岩三首 其三","author":"赵秉文","text":"帐殿临清嶂，苍崖襞翠烟。\n孤根盘厚地，秀色入苍天。\n并有四时雪，岩垂万古泉。\n皇情非暇豫，问俗到山川。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":496,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"陪李舜咨登悯忠寺阁","author":"赵秉文","text":"日月缠双栱，风烟纳寸眸。\n云山浮近甸，宇宙有高楼。\n鸟外馀残照，天边更去舟。\n登临有如此，况接李膺游。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":497,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿崔家庄","author":"赵秉文","text":"野次寒山外，人家霁雨中。\n饥鹰蹲落照，危叶颤西风。\n墙缺青山补，桥欹白水通。\n丰年闻好语，倚杖问蓑翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":498,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过滹水","author":"赵秉文","text":"夕阳山豁处，平照大河流。\n漠漠云间树，悠悠天际舟。\n黄尘随匹马，白水自双鸥。\n会得闲中趣，浮生半白头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":499,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"通许道中","author":"赵秉文","text":"晓逐三军发，清寒苦不禁。\n征骖过野店，寒犬出疏林。\n宿火留行客，霜枝滑冻禽。\n据鞍觅闲句，愁些不成吟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":500,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庐州城下","author":"赵秉文","text":"月晕晓围城，风高夜斫营。\n角声寒水动，弓势断鸿惊。\n利镞穿吴甲，长戈断楚缨。\n回看经战处，惨淡暮烟生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":501,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]