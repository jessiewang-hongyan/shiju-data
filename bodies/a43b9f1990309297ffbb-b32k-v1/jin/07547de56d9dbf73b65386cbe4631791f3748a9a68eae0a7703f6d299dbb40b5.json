[{"title":"赠中山杨正卿","author":"李遹","text":"士道彫丧愁天公，阴霾惨惨尘濛濛。\n三冬不雪春未雨，野桃无恙城西红。\n春光为谁作骀荡，造物若我哀龙钟。\n数行墨浪合眼死，一包閒气终身穷。\n中山公子文章雄，雅随童稚为雕虫。\n祢衡不遇孔文举，坡老懒事陈元龙。\n唯之与阿将无同，乾坤万里双飞蓬，飘飘南北东西风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1710,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"江村","author":"李遹","text":"陆地无根客，江村有发僧。\n两盂残喘粥，一寸苦吟灯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1711,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"集句题广宁胜览亭","author":"李遹","text":"檐前无数好峰峦，醉眼诗肠冰雪寒。\n不识闾山真面目，请君来此凭阑干。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1712,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"狮子峰","author":"李遹","text":"解脱眼光三界静，端公伎俩一时休。\n云开正使金毛现，子细看来是石头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1713,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送穷","author":"李遹","text":"昔年曾作送穷诗，结柳赍粮拟退之。\n送去还来还复语，君家犹有读书儿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1714,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"使高丽","author":"李遹","text":"去国五千里，马头犹向东。\n宦情蕉叶鹿，世味蓼心虫。\n倦枕三更梦，征衫八月风。\n山川秋满眼，归思寄孤鸿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1715,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送雷御史希颜罢官南归","author":"陈规","text":"五事前陈志拂劘，屹如砥柱阅颓波。\n一麾共惜延年去，三黜何伤柳季和。\n连蹇仕途如我老，激昂衰俗在君多。\n扁舟南去知难恋，万顷烟波一钓蓑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1716,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过骊山","author":"陈规","text":"丰镐无由问故基，三章只见黍离诗。\n而今多少华清石，都与行人刻艳辞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1717,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"郾城道中","author":"冯延登","text":"北风惨澹扬沙尘，郾西三日无行人。\n十村九村鸡犬静，高田下田狐兔驯。\n昨朝屏息过溪口，知有白额藏深榛。\n赤子弄兵更可恻，路旁僵尸衣血新。\n野叟伛偻行拾薪，欲语辟易如惊麇。\n瘦梅疏竹未慰眼，只有清泪沾衣巾。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1718,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元日隆安道中","author":"冯延登","text":"山冈重复三竿日，溪路萦回一席天。\n老境飘零情更恶，又从马上得新年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1719,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿三冢寺","author":"冯延登","text":"老柏苍苍缠老藤，招提牢落有残僧。\n瞑禽自入藏经阁，饥鼠时窥照佛灯。\n未得安心如北秀，却思觅法趁南能。\n濛濛雨暗门前路，更得云房一曲肱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1720,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"代郡杨黻之与余同辰月日时亦然渠有诗因为次韵","author":"冯延登","text":"阴阳亹亹定何如，自信祥金先有模。\n曾见唐生谈跃马，岂知阮籍哭穷途。\n倦游笑我衰髯白，弄笔怜君醉袖乌。\n便欲移书与欧九，略分馀论为嘘枯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1721,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄笏青柯平","author":"冯延登","text":"飞雪惊沙捲屋茅，清寒泼水透绨袍。\n松风度壑江声远，萝月当轩扇影高。\n敢对名山谈世事，不妨空腹贮离骚。\n且将手版牢藏起，政恐山人识马曹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1722,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"射虎得山字","author":"冯延登","text":"田翁太息论三害，猎骑俄惊见一斑。\n涎口风生雷吼怒，角弓寒劲月痕弯。\n柳营共许千人敌，鱼服仍馀一矢还。\n我欲残年赏神骏，短衣匹马梦南山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1723,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪","author":"冯延登","text":"屋破寒无那，庭空雪已深。\n山川非旧观，松柏见贞心。\n冻雀争遗粒，栖鸦点莫林。\n携琴访溪友，清兴忆山阴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1724,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"华清故宫","author":"冯延登","text":"宠贵羊羔退曲江，华清雾阁对云窗。\n层峦未了霓裳舞，迁客俄惊羯鼓腔。\n檐际疏星疑晓镜，天边晴树认高幢。\n游人尚喜风流在，白石涵波皂荚双。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1725,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西园得西字","author":"冯延登","text":"芳径层峦百鸟啼，芝廛兰畹自成蹊。\n仙舟倒影涵鱼藻，画栋销香落燕泥。\n淑景晴薰红树暖，蕙风轻汎碧丛低。\n冈头醉梦俄惊觉，歌吹谁家在竹西。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1726,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"八月十四日宿官塔下院二首 其一","author":"冯延登","text":"野僧引客看脩竹，拄杖入林惊暝禽。\n一道细泉鸣藓磴，恍如閒听颖师琴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1727,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"八月十四日宿官塔下院二首 其二","author":"冯延登","text":"乔松脩竹翠交阴，凉月玲珑地布金。\n老懒无诗酬节物，夜凉閒听候虫吟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1728,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"探春得波字","author":"冯延登","text":"好雨新晴景气和，东陂冰尽水增波。\n茅茨影里燕双语，桃李梢头春几何。\n霁霭未收芳陌润，斜阳偏傍小楼多。\n雕鞍画毂方争道，更得留连藉绿莎。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1729,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春雨二首 其一","author":"冯延登","text":"山市人归暮雨飞，倚筇久立看檐霏。\n乍来势若悬麻密，暂止声如鼓瑟希。\n砌下蚁归低赤帻，帘间燕入湿乌衣。\n今宵客梦知安稳，厌浥新凉到枕帏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1730,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春雨二首 其二","author":"冯延登","text":"小雨濛濛润土膏，谷风习习不惊条。\n晨烟半湿低平野，春水初生没断桥。\n已见鹅黄匀柳麦，更看檀紫上榆椒。\n从今乐事知相继，栉比云平看陇苗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1731,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"藤花得春字","author":"冯延登","text":"白白红红委暗尘，苍藤次第着花新。\n龙蛇奋起三冬蛰，缨络分垂百尺身。\n见说紫云偏得意，不知翠幄巧藏春。\n斋厨晚甑清香满，未信侯门有八珍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1732,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"兰子野晚节轩","author":"冯延登","text":"华颠益信寸心丹，直道宁论末路难。\n不叹士元淹骥足，但忧仲叔累猪肝。\n篱根佳菊分秋色，檐外长松耐岁寒。\n几有琴书尊有酒，却愁儿辈觉清欢。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1733,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"洮石砚","author":"冯延登","text":"鹦鹉洲前抱石归，琢来犹自带清辉。\n芸窗尽日无人到，坐看玄云吐翠微。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1734,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雅集图","author":"刘祖谦","text":"翠雀翩翩野鹤孤，玉京人物会仙图。\n后来且莫轻题品，席上挥毫有大苏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1735,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"崆峒山图为横溪翁赋二首 其一","author":"刘祖谦","text":"好奇仍有客相㩦，绝顶披云快一跻。\n三十六峰青似染，五年拄笏羡横溪。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1736,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"崆峒山图为横溪翁赋二首 其二","author":"刘祖谦","text":"独占名山每羡渠，京尘今日污吟须。\n西州十载经行处，惆怅云烟是画图。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1737,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元夕无灯","author":"高宪","text":"九陌无灯夜悄然，小红时见点春烟。\n多情惟有梅梢月，拍酒楼头照管弦。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1738,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄李天英","author":"高宪","text":"稻秸苍苍陂巳枯，西风剪剪弄楸梧。\n蒹葭水落鱼梁迥，蟋蟀声高山驿孤。\n社瓮新成元亮酒，并刀细落季鹰鲈。\n作诗远寄霜前雁，人在海东天一隅。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1739,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题新山寺壁","author":"高宪","text":"列壑攒峰发兴新，落花飞絮舞馀春。\n虚堂坐视三千界，冠者相从五六人。\n涧草软宜承屐齿，溪泉清可濯缨尘。\n静听山鸟松风里，始悟人间乐未真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1740,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"焚香六言四首 其一","author":"高宪","text":"抹利花心晓露，蔷薇萼底温风。\n洗念六根尘外，忘情一炷烟中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1741,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"焚香六言四首 其二","author":"高宪","text":"满地落花春晓，一帘微雨轻阴。\n正要金蕉引睡，不妨玉陇知音。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1742,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"焚香六言四首 其三","author":"高宪","text":"纸帐收烟密下，松灰卷火常虚。\n午寂春閒小睡，人间自有华胥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1743,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"焚香六言四首 其四","author":"高宪","text":"沈水浓薰甲煎，宫梅细点波津。\n奕奕非烟非雾，依依如幻如真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1744,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"长城","author":"高宪","text":"秦人一铩连鸡翼，六国萧条九州一。\n祖龙跋扈侈心开，牛豕生民付砧礩。\n诗书简册一炬空，欲与三五争相雄。\n阿房未了蜀山上，石梁拟驾沧溟东。\n生人膏血俱枯竭，更筑长城限裘褐。\n卧龙隐隐半天下，首出天山尾辽碣。\n岂知亡秦非外兵，宫中指鹿皆庸奴。\n骊原宿草犹未变，咸阳三月为丘墟。\n黄沙白草弥秋塞，惟有坡陁故基在。\n短衣匹马独归时，千古兴亡成一慨。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1745,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"沁源山中","author":"王特起","text":"野夫不识武城宰，问之无言色微改。\n但说今年秋雨多，黄芪满谷无人采。\n踏遍西城锦石盘，莫投佛屋解征鞍。\n隔林依约见灯火，山谷人家初夜寒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1746,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"挽张代州词","author":"王特起","text":"砥柱堂堂阅溃川，谏书一纸力回天。\n两朝眷倚传龟玉，五郡欢谣被管弦。\n茇舍棠阴馀旧绿，夜台松月耿孤圆。\n行人漫洒碑前泪，谁识颜公是地仙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1747,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"漫作","author":"王特起","text":"有时幽鸟话心事，无限秋虫誇口才。\n北阙上书吾老矣，东篱把菊思悠哉。\n竹林留得巨源在，莲社招入渊明来。\n不然馀子败人意，怀抱耿耿胡为开。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1748,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"偶作","author":"王特起","text":"人情争胜似争棋，死怕输人一著迟。\n黑白不分傍袖手，年来吾亦爱吾痴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1749,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"绝句二首 其一","author":"王特起","text":"山势奔腾如逸马，水流委曲似惊蛇。\n溪灵不欲露天巧，眼力未到云先遮。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1750,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"绝句二首 其二","author":"王特起","text":"鸟语留春春巳回，落花随意卧苍苔。\n清明寒食因循过，萱草蔷薇次第开。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1751,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"下第","author":"王特起","text":"人间万事等摴蒱，敢谓何人不得卢。\n胜负到头俱偶尔，狂夫安用绕床呼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1752,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗五首 其一","author":"李经","text":"长河老秋冻，马怯冰未牢。\n河山吟鞭底，日莫风更号。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1753,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗五首 其二","author":"李经","text":"晨井冻不爨，谁疗壮士饥。\n天厩玉山禾，不救我马尵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1754,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗五首 其三","author":"李经","text":"尘埃汩没伺候工，离骚不振矜鱼虫。\n风云谁复话蓍蔡，不图履狶哀屠龙。\n挟笺搦管坐书空，咿嚘堂上酣歌钟。\n乃知造物戏儿童，不妨远目送归鸿。\n莫怪魏瓠无所容，此去未许江船东。\n五经不埽途辙穷，门庭日月生皇风。\n太阿剖室砺以石，坐埽鹳鹤摇天雄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1755,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗五首 其四","author":"李经","text":"岩椒郁云，日夕生阴。\n雨雪缟夜，秋黄老林。\n人烟墨突，樵径云深。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1756,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂诗五首 其五","author":"李经","text":"造物开岩地，岩帐掩剑壁。\n苔花张古锦，霜苦老秋碧。\n日夕云窦阴，风鼓泉涌石。\n马蹄忌硗确，樵道生枳棘。\n盘盘出井底，回首怅如失。\n长老不耐事，底事挂尘迹。\n披云出山椒，白鸟表林隙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1757,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"海棠","author":"梁持胜","text":"野杏山桃委路尘，芳华都属锦城春。\n只缘造物偏留意，任使无香亦可人。\n粉白漫誇妆样巧，胭脂难染睡痕新。\n沈香亭子勾栏畔，消得君王比太真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1758,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"邻妇哭","author":"赵元","text":"邻妇哭，哭声苦，一家十口今存五。\n我亲问之亡者谁，儿郎被杀夫遭虏。\n邻妇哭，哭声哀，儿郎未埋夫未回。\n烧残破屋不暇葺，田畴失锄多草莱。\n邻妇哭，哭不停，应当门户无馀丁。\n追胥夜至星火急，并州运米云中行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1759,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"渡洛口","author":"赵元","text":"一脉寒流两岸冰，断桥无力强支撑。\n忘机羡杀沙鸥好，不省人间有战争。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1760,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书怀继元弟裕之韵四首 其一","author":"赵元","text":"蓍龟不须问，我命只自知。\n多生堕宿业，世网缠绵之。\n骅骝受羁衔，大笑跛鳖迟。\n跛鳖亦复笑，缩首甘自卑。\n何必参漆园，物理本自齐。\n槟榔可消谷，志士常苦饥。\n穆之万人雄，犹不免此讥。\n我懦更多病，区区欲何为。\n钟鼎不可倖，藜藿分所宜。\n安能如黄蜂，为人填蜜脾。\n清白傥少污，后人何所贻。\n初学悔大谬，篆刻工文辞。\n年来厌酸咸，淡爱陶潜诗。\n爱诗固自佳，其如未忘机。\n回头四十年，言动俱成非。\n谁能逐世利，日久常规规。\n惟当种溪田，与子常相期。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1761,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书怀继元弟裕之韵四首 其二","author":"赵元","text":"窗扉有生意，山间春到时。\n长安冠盖尘，游哉不如兹。\n西畴将有事，老农真吾师。\n不见元鲁山，梦寐役所思。\n遗山乃其后，僻处政坐诗。\n时复一相过，照眼珊瑚枝。\n奇书多携来，为子卧听之。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1762,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书怀继元弟裕之韵四首 其三","author":"赵元","text":"少从白衫游，气与山峥嵘。\n一念堕文字，肠腹期拄撑。\n多机天所灾，室暗灯不荧。\n拈书枕头睡，鼻息春雷鸣。\n泰山与鸿毛，何者为重轻。\n蹄泓与渤澥，谁能较亏盈。\n如能平其心，一切当自平。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1763,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书怀继元弟裕之韵四首 其四","author":"赵元","text":"嵩箕有奇姿，出云何悠然。\n云山足佳处，留客今几年。\n有子罢读书，求种山间田。\n栗里愧渊明，香山惭乐天。\n二老已古人，相望云泥悬。\n得酒邀月来，对影空自怜。\n摄衣欲起舞，稚子不须牵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1764,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"喜霁","author":"赵元","text":"片段溪云破，纵横野水淙。\n人閒泥塞路，蝇动日烘窗。\n绕壁苔痕满，侵阶树影双。\n还思酿新黍，瓮面挹秋江。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1765,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"诗送辛敬之东归二首 其一","author":"赵元","text":"风埃憔悴旧霜袍，老去新诗价转高。\n橡栗漫山犹可煮，不须低首向儿曹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1766,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"诗送辛敬之东归二首 其二","author":"赵元","text":"文章无力命有在，一点浩然天地閒。\n风雪满头人不识，又㩦诗藁出西山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1767,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"修城去","author":"赵元","text":"修城去，劳复劳，途中哀叹声嗷嗷。\n几年备外敌，筑城恐不高。\n城高虑未固，城外重三壕。\n一锹复一杵，沥尽民脂膏。\n脂膏尽，犹不辞，本期有难牢护之。\n一朝敌至任推击，外无强援中不支。\n倾城十万户，屠灭无移时。\n敌兵出境已踰月，风吹未乾城下血。\n百死之馀能几人，鞭背驱行补城缺。\n修城去，相对泣，一身赴役家无食。\n城根运土到城头，补城残缺终何益。\n君不见得一李绩贤长城，莫道世间无李绩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1768,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"田间秋日三首 其一","author":"赵元","text":"好雨知时便放晴，天和酝酿作西成。\n秋收但得官军饱，未怕输租远十程。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1769,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"田间秋日三首 其二","author":"赵元","text":"禾穗累累豆角稠，崧前村落太平秋。\n熙熙多少丰年意，都在农家社案头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1770,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"田间秋日三首 其三","author":"赵元","text":"皤翁伛偻负薪行，稚子跳梁剥枣声。\n不似二姑忙更杀，晚春堆髻脱钗荆。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1771,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"客况","author":"赵元","text":"庐山踏遍却归崧，世事悠悠付老慵。\n乐近僧居非佞佛，苦无田种强为农。\n菊花雨似人情冷，梨叶霜如酒力浓。\n一十五秋河表客，合教节物笑龙钟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1772,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"学稼","author":"赵元","text":"不堪炊煮一箱书，十口东西若可糊。\n食禄已惭中隐吏，垦山聊作下农夫。\n藁遗场圃无多积，子入官仓困远输。\n近日愚轩睡眠少，打门时复有追胥。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1773,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"立秋日","author":"赵元","text":"况味年来老比丘，禅房三伏得迟留。\n连宵雨作垂垂晓，十口家贫盻盻秋。\n熟未先须伺禾黍，有无何暇问衣裘。\n半生枉却亲灯火，一事不成空白头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1774,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"村居夏日","author":"赵元","text":"官府不著名，散迹村落深。\n白云自朝暮，青山无古今。\n爱此夏日永，门巷多繁阴。\n呼儿具绳床，不履亦不簪。\n殷勤好风来，为我消烦襟。\n一饱万事了，何用腰黄金。\n羁勒困名马，网罗多珍禽。\n何如山鹿痴，呦呦恋长林。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1775,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵答裕之","author":"赵元","text":"薄莫敲门喜客佳，水萍风絮共天涯。\n行藏一话倾心肺，古律三诗淬齿牙。\n朱研不妨閒度日，青山终得共餐霞。\n扶持老病须君辈，满地豺狼万里家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1776,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]