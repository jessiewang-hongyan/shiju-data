[{"title":"山行四绝 其四","author":"赵秉文","text":"玉柱峰前紫翠堆，道人架竹引泉来。\n穿云络石无人见，下赴龙门作怒雷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":790,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨晴","author":"赵秉文","text":"一春无雨作泥香，碧瓦朝来泛霁光。\n留得紫薇花上露，几招渴燕下雕梁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":791,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"一雨","author":"赵秉文","text":"遥望丛林一塔孤，蹇骑日转古城隅。\n夜来一雨添新涨，潋滟滩头渐欲无。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":792,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨尚书之美韵四绝 其一","author":"赵秉文","text":"河南夫子两程子，要与洙泗继后尘。\n濂溪先生为张本，舞雩风里浴沂春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":793,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨尚书之美韵四绝 其二","author":"赵秉文","text":"东莱两本不朽计，读书原委有来因。\n伤哉绝笔大事记，续经未了已亡身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":794,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨尚书之美韵四绝 其三","author":"赵秉文","text":"诸公辨论助怪惊，削去训传非人情。\n大公至正本无我，吾道初如日月明。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":795,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和杨尚书之美韵四绝 其四","author":"赵秉文","text":"汉儒俗学欺盲聋，独有一士超樊笼。\n君家子云晚治易，圣人门户见重重。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":796,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题刘德温画湖山丰夏横幅四绝 其一","author":"赵秉文","text":"闻道神仙郭恕先，曾将清夏写湖山。\n而今宝墨归天上，时许刘郎见一斑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":797,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题刘德温画湖山丰夏横幅四绝 其二","author":"赵秉文","text":"湖山清夏不应丰，一径林阴水石中。\n六月凉生清蒻底，钓鱼船上一丝风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":798,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题刘德温画湖山丰夏横幅四绝 其三","author":"赵秉文","text":"风来山脚水沦涟，林影参差舞镜天。\n袖里长安遮日手，绿阴多处弄潺湲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":799,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题刘德温画湖山丰夏横幅四绝 其四","author":"赵秉文","text":"远处微茫近处浓，岸容林意两溶溶。\n夏山如醉无人画，更倩刘郎作几峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":800,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题东坡画古柏怪石图三首 其一","author":"赵秉文","text":"荒山老柏蘖拥肿，相伴丑石反成妍。\n有人披图笑领似，不才如我终天年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":801,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题东坡画古柏怪石图三首 其二","author":"赵秉文","text":"人生散材如散木，槁死深山病益奇。\n放出参天二千尺，安用荒藤缠绕为。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":802,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题东坡画古柏怪石图三首 其三","author":"赵秉文","text":"东坡戏墨作树石，笔势海上驱风涛。\n画师所难公所易，未必此图如此高。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":803,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪望","author":"赵秉文","text":"吹面风来受雪寒，宝花楼阁五云端。\n船移忽破琼瑶影，丹凤桥边驻马看。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":804,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"蝉","author":"赵秉文","text":"薄薄秋云两翼轻，淤泥脱迹便恢声。\n可能枵腹凉阴底，受尽人间风露清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":805,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三苏帖二首 其一","author":"赵秉文","text":"他年鸿雁各分飞，风雨潇潇有所思。\n犹记读书怀远驿，夜深灯火对床时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":806,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三苏帖二首 其二","author":"赵秉文","text":"君家一日会三苏，翰墨人间今古无。\n时向明窗展横幅，不须更写德星图。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":807,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事","author":"赵秉文","text":"楼头不见暮山重，遥认青林雨意浓。\n一阵风来忽吹散，断云还补两三峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":808,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿朱家寺","author":"赵秉文","text":"撤幕风来远更清，窗开野旷见云生。\n夜深古殿无灯烛，画壁时因掣电明。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":809,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"金水河","author":"赵秉文","text":"金水河边驻马时，熙春阁外夕阳微。\n旧时同乐园前水，曾照寒鸦几度归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":810,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚登太史台二首 其一","author":"赵秉文","text":"云镂残阳一线金，西风吹雨破层阴。\n归鸦怪得红翻背，返照依依在远林。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":811,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚登太史台二首 其二","author":"赵秉文","text":"市桥落日与波平，返照前湾别舸明。\n不觉城头来溟色，回看天际暮烟生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":812,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"管幼安濯足图","author":"赵秉文","text":"道丧何人识重轻，白头不作魏公卿。\n沧浪濯足知君意，浊水那能浼我清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":813,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庞才卿画长江图","author":"赵秉文","text":"青山隐隐水悠悠，何处长江是尽头。\n欸乃一声人不见，忽从天际下归舟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":814,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"净安寺紫蜡梅","author":"赵秉文","text":"倩谁传语主林神，莫以时宜斗斩新。\n只是旧时黄面老，而今现作紫金身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":815,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题移刺右丞画双鹿图二首 其一","author":"赵秉文","text":"忘言老人写双鹿，笔力不减东丹王。\n右相丹青乃馀事，向来勋业扶明昌。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":816,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题移刺右丞画双鹿图二首 其二","author":"赵秉文","text":"当年扈从直长杨，想见秋山槲叶黄。\n沙外小滩圆似月，眼明双鹿噍斜阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":817,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"坡阳归隐图","author":"赵秉文","text":"年过六秩尚蹉跎，奈此坡阳归隐何。\n不是不归归未得，家山虽好虎狼多。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":818,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日繁台寺","author":"赵秉文","text":"九日登临一散怀，繁台寺下插花回。\n空明衣上波光动，知是扁舟泛月来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":819,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"道傍古槐","author":"赵秉文","text":"虬枝盘屈尚百尺，不肯为人充栋梁。\n六月行人汗如洗，尚能于世作清凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":820,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"昭君出塞图","author":"赵秉文","text":"无情汉月解随人，羞向天涯照妾身。\n闻道将军侯万户，已将功业上麒麟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":821,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"子卿归汉图","author":"赵秉文","text":"节旄落尽始归来，白发龙钟老可哀。\n犹胜生降不归汉，将军空有望乡台。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":822,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庞才卿画春山归隐图","author":"赵秉文","text":"了无车马到山家，门外东风扫落花。\n春入山閒人不见，无时无处不烟霞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":823,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同乐园二首 其一","author":"赵秉文","text":"春归空苑不成妍，柳影毵毵水底天。\n过却清明游客少，晚风吹动钓鱼船。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":824,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同乐园二首 其二","author":"赵秉文","text":"石作墙垣竹映门，水回山复几桃源。\n毛飘水面知鹅栅，角出墙头认鹿园。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":825,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫四首 其一","author":"赵秉文","text":"阴阴垂柳净朝晖，城郭山林果是非。\n步绕仙坛香露湿，紫玟瑰刺骨人衣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":826,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫四首 其二","author":"赵秉文","text":"醮罢琳宫日更长，坐看幡影午悠扬。\n幽人唤起青童睡，苔径扫花筠帚香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":827,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫四首 其三","author":"赵秉文","text":"细细薰风淡淡阴，过云抛雨上花心。\n黄莺渴咮沾微润，飞上高枝作好音。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":828,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫四首 其四","author":"赵秉文","text":"细雨薰风未熟梅，仙禽啄实下莓苔。\n夏芳将尽无多景，红白葵花相背开。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":829,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中牟阳冰篆","author":"赵秉文","text":"龙蛇起陆虫蚀木，商盘周鼓秦刻馀。\n中牟三异今分四，断碑残缺阳冰书。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":830,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过杨太尉坟","author":"赵秉文","text":"直道从来自不容，断碑千载尚尘封。\n潼关关下坟三尺，清节高于太华峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":831,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过长安二首 其一","author":"赵秉文","text":"汉苑秦宫半夕阳，年年春色管兴亡。\n霸桥折尽青青柳，不为行人也断肠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":832,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过长安二首 其二","author":"赵秉文","text":"茂陵玉盌苔痕土，魏帝金盘月泫津。\n独有乾陵陵上柏，年来风雨不能神。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":833,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"草堂","author":"赵秉文","text":"几家篱落掩柴关，尽在浮岚涌翠间。\n稻垄明边通白水，竹梢缺处补青山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":834,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过咸阳二首 其一","author":"赵秉文","text":"独立桥边望白云，摩挲古冢石麒麟。\n千秋万古功名骨，尽作咸阳原上尘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":835,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过咸阳二首 其二","author":"赵秉文","text":"上林池籞锁芳尘，直抵南山不属人。\n世上千年陵谷变，千村桑柘鹁鸪春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":836,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题东坡与佛印帖","author":"赵秉文","text":"鲁公食粥已数月，苏子探囊无一钱。\n身后胡椒八百斛，尔曹堪笑亦堪怜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":837,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"呼群鸣鹿图二首 其一","author":"赵秉文","text":"麑班剥落错古锦，麚角轮囷生肉芝。\n呦呦谁见呼群态，忆在秋山扈从时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":838,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"呼群鸣鹿图二首 其二","author":"赵秉文","text":"霜林枫叶动秋山，谁道呦呦物性闲。\n同类呼群更媒祸，世间何处不黄间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":839,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"五岳观四绝 其一 昼","author":"赵秉文","text":"浏浏清风下曲阿，亭亭午影转庭柯。\n帘钩不捲通明处，时有流莺趁蝶过。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":840,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"五岳观四绝 其二 夜","author":"赵秉文","text":"愔愔小雨一灯荧，犹记灵宫夜叩扃。\n绕树惊乌栖不定，踏翻柏子落阶庭。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":841,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"五岳观四绝 其三 晓","author":"赵秉文","text":"一声鹎鵊唤年芳，底事惊回蝶梦长。\n独倚栏干梳白发，满襟清快晓风凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":842,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"五岳观四绝 其四 暮","author":"赵秉文","text":"移床坐到晚凉时，手弄清泉似小儿。\n古观无人苍柏暗，偶看宿鸟暮争枝。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":843,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"荔支图","author":"赵秉文","text":"雨滴铃声蜀道长，都缘一曲荔支香。\n宣和无限丹青手，好画当年花石纲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":844,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临韩干马","author":"赵秉文","text":"秋日平原看肉飞，千金市骨眼中稀。\n世间赖有丹青手，韩干丹青又已非。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":845,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"载梅","author":"赵秉文","text":"满车饱载梅花共，车声㗀㗀不成弄。\n月落参横画角哀，横眠正作梅花梦。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":846,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鸿沟","author":"赵秉文","text":"山川依旧霸图空，楚汉分沟一峡中。\n金翅鸟王分海立，却应筦尔笑英雄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":847,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其一","author":"赵秉文","text":"西邻鸟鼠北朝那，泾水东流入大河。\n一上参云亭上望，山川满目夕阳多。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":848,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其二","author":"赵秉文","text":"金汤形胜满秦中，战鼓惊飞北塞鸿。\n为向崆峒山试道，可能高枕听松风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":849,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其三","author":"赵秉文","text":"断碑零落任苔封，想像当时问道宫。\n烟锁洞天三十六，时人空礼白云中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":850,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其四","author":"赵秉文","text":"万松声里暮涛寒，尽在参云一望间。\n只欠悬流二千尺，天风吹下翠屏山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":851,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题东岩道人读书堂","author":"赵秉文","text":"山头佛屋三五间，山势相连石岭关。\n名字不妨从我改，便称元子读书山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":852,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"哀李平父","author":"赵秉文","text":"妙画清诗绝点尘，丹青才了已无身。\n钓台即是西州路，长使羊昙泪满巾。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":853,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"洮石砚","author":"赵秉文","text":"何年洮石鸭头绿，磨研来伴中书公。\n乞与玉堂挥翰手，便欲草檄系西戎。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":854,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"跋黄华墨竹二首 其一","author":"赵秉文","text":"老可能为竹写真，东坡解与竹传神。\n墨君有语君知否，须信黄华是可人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":855,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"跋黄华墨竹二首 其二","author":"赵秉文","text":"淡墨闲临谢女真，萧然林下自风神。\n世间亦有丹青手，只解寻常写市人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":856,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰八月十八日会同馆诸公同赋绝句五首 其一","author":"赵秉文","text":"一年十二度圆月，及到中秋此夜偏。\n天意自怜风露爽，更教明月十三圆。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":857,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰八月十八日会同馆诸公同赋绝句五首 其二","author":"赵秉文","text":"闰年都未有新霜，探借秋花十日香。\n径约同僚同一醉，有花有酒即重阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":858,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰八月十八日会同馆诸公同赋绝句五首 其三","author":"赵秉文","text":"太平胜事古难并，且尽清欢伴醉醒。\n座上少年三馆秀，也知傍有老人星。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":859,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰八月十八日会同馆诸公同赋绝句五首 其四","author":"赵秉文","text":"老去追欢强不能，少时思酒似痴蝇。\n佩刀左右更相笑，我已年来绝爱憎。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":860,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闰八月十八日会同馆诸公同赋绝句五首 其五","author":"赵秉文","text":"宾主相忘间浊清，坐中谈笑杂歌声。\n道人嘿坐无分别，总是秋风万籁鸣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":861,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"马上见桃花","author":"赵秉文","text":"可怜马上逢春色，不得明窗贮古瓶。\n只恐东风易零落，兔葵燕麦又青青。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":862,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"列子庙二首 其一","author":"赵秉文","text":"天禄雠书已断编，枉将放荡杂真筌。\n如何得似东皋子，删却杨朱力命篇。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":863,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"列子庙二首 其二","author":"赵秉文","text":"东土西天一幻缘，先生古佛岂其仙。\n攓蓬指处无生死，勘破髑髅未兆前。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":864,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠微寺二首 其一","author":"赵秉文","text":"南山常怀退之诗，未说云烟润色之。\n要见山光如泼黛，更须留待雨晴时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":865,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠微寺二首 其二","author":"赵秉文","text":"南山深锁翠微宫，寺在山南十里东。\n祇怪朝来衫袖湿，不知身在翠微中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":866,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿索水","author":"赵秉文","text":"楚汉相随京索间，路人指点旧河关。\n英雄成败一邱土，云自高飞水自闲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":867,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"平泉店逢夏使","author":"赵秉文","text":"穹庐毳服异华风，马上相逢一笑同。\n赠我何劳绕朝策，贺兰千里已胸中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":868,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]