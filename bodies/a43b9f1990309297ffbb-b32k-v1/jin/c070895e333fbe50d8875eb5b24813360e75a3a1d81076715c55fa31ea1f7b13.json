[{"title":"郎山杂咏十首 其八 泓云泉","author":"赵秉文","text":"蔼蔼春云滋，岩溜滴泉乳。\n独留一泓碧，去作人间雨。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":573,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"郎山杂咏十首 其九 上龙门","author":"赵秉文","text":"南北两石门，上下一灵鹫。\n仰看莲峰立，忽见天门透。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":574,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"郎山杂咏十首 其十 下龙门","author":"赵秉文","text":"乱峰排鸟道，一水会龙门。\n禹力不到处，犹如沧海尊。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":575,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉命奏告山陵四首 其一","author":"赵秉文","text":"祗命款园陵，俶装事行役。\n黄叶宿几程，青山馆三日。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":576,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉命奏告山陵四首 其二","author":"赵秉文","text":"西山积翠气，空外摩青天。\n飞筇不到处，独鸟冲寒烟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":577,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉命奏告山陵四首 其三","author":"赵秉文","text":"山前红树合，山顶白云封。\n山中有兰若，日暮闻疏钟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":578,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"奉命奏告山陵四首 其四","author":"赵秉文","text":"山月出未高，林深鸟犹梦。\n霜落人未知，寒添觉声重。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":579,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其一 青龙峒","author":"赵秉文","text":"青龙不可见，云自洞中出。\n为雨济人间，归时杳无迹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":580,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其二 仙人桥","author":"赵秉文","text":"绝涧初无路，通仙忽有桥。\n偶携青竹杖，平步到云霄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":581,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其三 翠屏山","author":"赵秉文","text":"山作屏风样，其如空翠何。\n不遮秋塞尽，空障夕阳多。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":582,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游崆峒四绝 其四 参云亭","author":"赵秉文","text":"鸟语山更静，松声风自寒。\n不嫌云气湿，来此凭栏干。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":583,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春山诗意图","author":"赵秉文","text":"何年身入画图传，似是三生孟浩然。\n诗句工夫驴背上，醉乡田地酒旗边。\n一川芳草绿堪染，夹路杏花红欲然。\n想见归来泥样醉，却如醮水柳三眠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":584,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日即事","author":"赵秉文","text":"支颐偶到野人家，总把深心付物华。\n鸟毳馀情闲日月，花心深蠹半尘沙。\n游丝逆上风中柳，乱沫分屯水际楂。\n且共年光暂观化，直须美酒送生涯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":585,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"酷暑二首 其一","author":"赵秉文","text":"林鸦开咮忘飞腾，天地为炉万象蒸。\n冰井汤鏖几千尺，塔铃风閟十三层。\n梦魂正绕云帆客，画本閒临雪麓僧。\n一枕雨窗惟静胜，不须赤脚踏层冰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":586,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"酷暑二首 其二","author":"赵秉文","text":"石枕绳床夏簟藤，慢肤终日厌歊蒸。\n梦飞楚泽三千里，人在秦楼十二层。\n松顶露凉时警鹤，山房泉冷独输僧。\n人间膏火鏖城市，世外清凉胜饮冰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":587,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"棕扇","author":"赵秉文","text":"犀甲龙鳞倚半空，抱归掌握自清风。\n山精附木须髯古，回禄煽炎尾鬣红。\n何处青蝇千里外，向来白羽一挥中。\n水边石上应须此，乞与文园病肺翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":588,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三台怀古","author":"赵秉文","text":"人道奸雄君似鬼，奸雄我道鬼输君。\n身犹北面魏基建，骨入西陵汉鼎分。\n贪与卯金成舜禹，不知典午笑桓文。\n清漳不洗前朝恶，日绕三台送夕曛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":589,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄王学士","author":"赵秉文","text":"寄语雪溪王处士，年来多病复何如。\n浮云世态纷纷变，秋草人情日日疏。\n李白一杯人月影，郑虔三绝画诗书。\n情知不得文章力，乞与黄华作隐居。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":590,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登友云亭","author":"赵秉文","text":"友云飞观郁崔嵬，落木萧萧听者哀。\n九日朱弦和雁断，开年黄菊费诗催。\n淮天雨露橙千里，梁地风烟酒一杯。\n此日此生人共醉，明年重健与谁来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":591,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"除夜二首 其一","author":"赵秉文","text":"梅花无信报平安，又听谯门画角残。\n荒郡人烟穷腊外，上方楼阁晚云端。\n沉沉鸟没天无尽，漠漠烟昏山更寒。\n日暮数峰犹带雪，城头霁色入栏干。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":592,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"除夜二首 其二","author":"赵秉文","text":"龙钟三十九年春，讳说新年似讳贫。\n醉白名堂甘后进，小坡著号似前身。\n自怜耐辱称居士，人笑无机是道人。\n断送生涯一枝足，不须长物扰天真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":593,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"娱晖轩","author":"赵秉文","text":"石晋地形今日眼，几人亭榭几人诗。\n数州山水有穷处，万古风烟无尽时。\n天逐南帆秋雁远，峰遮西望夕阳迟。\n客来欲问忘归意，挂起僧轩君自知。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":594,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"马头山清居院","author":"赵秉文","text":"每逢佳处辄安跧，及到清居半日悭。\n晓壁撼钟云离石，夜泉洗钵月摇山。\n人生能作几时客，林下都无一个闲。\n不信试看题壁字，明朝多是马头还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":595,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"松声","author":"赵秉文","text":"飞廉作意怒髯龙，万壑千岩气象雄。\n独鹤梦中摇夜月，七弦徽外寄秋风。\n石坛醮罢支筇里，天竺斋馀隐几中。\n想见纷纷吹子落，山堂一枕耳偏聪。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":596,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"抹里湛酒","author":"赵秉文","text":"乍坼香泥瓮酿成，一鞭先到日边城。\n玻璃色映蔷薇露，沆瀣光浮金菊英。\n偶说中州先酒谱，赖传后世以诗名。\n相如病渴焉能赋，久矣吾衰畏后生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":597,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"连云岛望海","author":"赵秉文","text":"壮观天东第一游，晓披绝岛寄冥搜。\n烟中熊岳随潮没，天际辽江入海流。\n地绝四维那辨树，风来万里忽通舟。\n我从析木西南境，回望中原四百州。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":598,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庚申元日","author":"赵秉文","text":"一从禁苑别花塼，四度山城自作年。\n愁里椒盘双泪落，坐中岁酒几人先。\n此心不动吾何敢，老去知非理固然。\n白发无儿何足道，且收见在斗尊前。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":599,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送张仲山","author":"赵秉文","text":"千山飞雪白硙硙，袖里吟鞭送客来。\n须出冰霜年貌改，眼藏狐貉语音猜。\n风吹阴磴鱼鳞卷，日曝阳坡龟兆开。\n北去人烟山店远，且煨新火煖离杯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":600,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和林卿锦波亭韵","author":"赵秉文","text":"使君兴寄本翛然，爱此澄波清且涟。\n杨柳阴中黄鸟地，芙蓉香底白鸥天。\n凉通帘幌风生座，露浥琴尊月满船。\n相见仙裾乘一叶，恍疑太乙下云边。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":601,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其二 南园","author":"赵秉文","text":"黑山潢水解弓刀，茅屋朝来听伯劳。\n万里马辞边雪苦，一声雁拂朔云高。\n关山落日家何在，诗酒春风气尚豪。\n试上荒城望乡国，重来清镜镊霜毛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":602,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其三 翠微轩","author":"赵秉文","text":"千里风烟栋宇间，地形西去接松关。\n尊前奚霫来朝地，云外幽营不断山。\n故垒芜城人物换，断云落日古今闲。\n百年兴废人空老，水自东西鸟自还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":603,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其四 镇国寺","author":"赵秉文","text":"灵鹫飞来处处尊，绿云细路络城根。\n百年楼殿倚天末，万井风烟当寺门。\n五月微凉清佛界，六时豪吹动祗园。\n四山放入无多力，乞与西南构一轩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":604,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其五 七金山寺","author":"赵秉文","text":"刳檐篆额蠹蜗涎，像教尘埃阅百年。\n殿栋犹题辽日月，图经不载禹山川。\n荒碑盘屈蜿蜒古，坏壁参覃罔象拳。\n想见当时崇奉日，无边花雨散诸天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":605,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其六 野香亭","author":"赵秉文","text":"半空栏槛倚云根，暇日登临付一樽。\n山上青莲惟见塔，水边绿树定知村。\n花枝低拂寻春骑，杜宇频伤久客魂。\n过尽芳时游客少，一轩风雨送黄昏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":606,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其七 灵感寺","author":"赵秉文","text":"徒河岸北白莲东，法鼓惊飞碣石鸿。\n塔上风烟高鸟路，山头云雨化人宫。\n松林碍日蜂房冷，石砌颓沙蚁穴空。\n欲尽休公挥麈乐，鬓丝羞对落花风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":607,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其八 兰若院","author":"赵秉文","text":"传经兰若岁时同，绣毂珠帘处处逢。\n花院鸟归深殿磬，雨楼人散隔城钟。\n长空淡淡吞平野，落日微微见远峰。\n年去年来人自老，空馀坏衲挂长松。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":608,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其九 金河寺","author":"赵秉文","text":"何处人间六月秋，金河寺外水西头。\n坐分游客青天幕，醉倒诗仙白玉舟。\n万里南风双老鬓，百年心事一沙鸥。\n王侯蝼蚁俱尘土，一笑从来万事休。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":609,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杂兴十首 其十 赵园","author":"赵秉文","text":"佳木千章曲岸南，此园阅世似飞禽。\n地幽花晚春兼夏，山近岚昏晴似阴。\n溪雨断桥愁渡水，樵风吹帽怯穿林。\n马头纳纳沙边路，霜叶浓时忆重寻。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":610,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"扈跸万宁宫","author":"赵秉文","text":"一声清跸九天开，白日雷霆引仗来。\n花萼夹城通禁籞，曲江两岸尽楼台。\n柳阴罅日迎雕辇，荷气分香入酒杯。\n遥想薰风临水殿，五弦声里阜民财。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":611,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"琵琶岭","author":"赵秉文","text":"晓拂朱栏满袖风，支颐吟望翠微中。\n薄云漏日岩开碧，浅露离花涧滴红。\n马散平坡临水聚，人来盘路到山穷。\n子云老大无才思，懒赋长杨五柞宫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":612,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"拂云坪","author":"赵秉文","text":"万叠云山最上头，千官影里侍宸游。\n翠岩秀色来天地，黄岭岚光上冕旒。\n帐殿影临眠鹿地，箫韶声入射熊秋。\n翠华指日东巡狩，回望中原第一州。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":613,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"金莲川","author":"赵秉文","text":"一望天莲五色中，离宫风月满云龙。\n向来菡萏香销尽，何许蔷薇露染浓。\n秋水明边罗袜步，夕阳低处紫金容。\n长杨猎罢回天仗，万烛煌煌下翠峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":614,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"五月牡丹","author":"赵秉文","text":"好事天公养露芽，阳和趁及六龙车。\n天香护日迎朱辇，国色留春待翠华。\n谷雨曾沾青帝泽，薰风又卷赤城霞。\n金盘荐瑞休嗟晚，犹是人间第一花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":615,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和王正之寄远二首 其一","author":"赵秉文","text":"人生会合少知音，一榻高悬肯重寻。\n后日相逢应老大，何时一笑共登临。\n三年京国尘埃梦，千里故人离别心。\n想见诗来愁擘纸，倚栏清快北风襟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":616,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和王正之寄远二首 其二","author":"赵秉文","text":"钟鼎功名自有时，如公才力不嫌迟。\n且寻彭泽篱边菊，莫赋玄都观里诗。\n昼寝执经童子问，春游赍印吏人随。\n悬知山县无公事，好续琴高第二碑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":617,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"甲子元日大安早朝","author":"赵秉文","text":"阙角苍龙建斗杓，衣冠万国大安朝。\n使臣未入分班立，殿陛将升按笏招。\n彩殿中间瞻北极，丹墀侧畔听箫韶。\n太初甲子天元朔，万岁常瞻玉烛调。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":618,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"红梨花应制","author":"赵秉文","text":"染根日日费天工，眼底梅花梦不同。\n春色似怜啼夜雨，天恩特许醉春风。\n袖障翡翠馀轻碧，雪点胭脂晕小红。\n汉主蕊宫三十六，溶溶和气月明中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":619,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"辕门不寐","author":"赵秉文","text":"萧萧传柝月三更，欹枕辕门听鼓声。\n战马不肥淮甸草，征人愁望历阳城。\n兵戈荏苒音书绝，行李萧条虮虱生。\n早晚楼船下扬子，满天风雨洗蛮荆。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":620,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄怀","author":"赵秉文","text":"不问山林与市朝，大都鹏鴳各逍遥。\n归心老去投林鸟，壮志春来挂壁弨。\n坐处工夫惟易可，闲中日月以琴消。\n十年镜里功名事，白发年来渐不饶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":621,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赋雪和张子野巡字韵","author":"赵秉文","text":"翰林风骨玉为神，天遣檐花送酒巡。\n侍从骅骝应白凤，神仙官府不红尘。\n悬知颍尾风流旧，不及鳌头句法新。\n天上玉堂谁得见，风光衮衮笔头春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":622,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"杨秘监画高士过关图","author":"赵秉文","text":"三生自是竹林游，写出荒寒意外愁。\n世事尽如翻著袜，人生刚笑倒骑牛。\n关山风月诗千首，富贵豪华土一丘。\n独有文章磨不得，至今图画想风流。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":623,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"重阳后雪寄马柔克","author":"赵秉文","text":"朝来飞雪白模糊，城郭山川入画图。\n一色乾坤还太素，万家楼阁化清都。\n狐裘貂帽将军骑，金帐羊羔太尉姝。\n何似吾家正清绝，晓窗吟撚冻髭须。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":624,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过代","author":"赵秉文","text":"金波曾醉雁门州，端有人间六月秋。\n万古河山雄朔部，四时风月入南楼。\n汉家战伐云千里，唐季英雄土一丘。\n系马曲栏搔首望，晓来闲杀钓鱼舟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":625,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"静阳道中","author":"赵秉文","text":"路转山腰步步迷，高林浅水下回溪。\n荞花酿蜜蜂贪腹，柏叶储香麝养脐。\n不觉困来寻短梦，偶逢佳处入新题。\n何时更到园林寺，看遍峰峦处处低。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":626,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题郝运使荣归堂","author":"赵秉文","text":"翰墨声名四十年，归来还作地行仙。\n柴桑问路陶元亮，洛社休官白乐天。\n拄杖扶儿还客拜，画图归老听人传。\n穷秋雨霁陂田出，想见骑驴兴渺然。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":627,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游郤家泺二首 其一","author":"赵秉文","text":"山崦人家半夕阳，倚墙争看骑红妆。\n野泉自入他州界，古碣犹存旧姓乡。\n蛇出庙壖神古柳，牛寻沙泺憩柔桑。\n蝉声抵死催归骑，辜负亭阴一枕凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":628,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游郤家泺二首 其二","author":"赵秉文","text":"水际林间杖屦香，纶巾野服道家妆。\n妇姑䌟纩欣同社，翁仲扶筇不出乡。\n拜跪使君嗟老大，逢迎地主问耕桑。\n今秋一饱天难必，且快新苗雨后凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":629,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题近侍局使聚扇","author":"赵秉文","text":"早朝携入紫薇宫，日月都归掌握中。\n运动枢机真有道，卷藏怀袖不言功。\n宸庭永日更番暇，水殿微凉侍宴终。\n愿以微躯奉清燕，仁声宣播舜弦风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":630,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"张清献公庆八十寿","author":"赵秉文","text":"富贵康宁寿八旬，明时乞得自由身。\n宦途班列联三事，家法中朝第一人。\n疏傅未归东海郡，白公独享洛城春。\n籯金换得传经业，留与玄成赞化钧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":631,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"上方","author":"赵秉文","text":"山近西台易夕烟，东台占得夕阳偏。\n贪看归鸟过林隙，不觉奇峰堕眼前。\n土灶夜烧松叶火，石盆晓漱菊花泉。\n丹梯横绝青山路，劝子先参鸟道玄。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":632,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题右丞画荷蓧图","author":"赵秉文","text":"杏花菖叶雨声春，甘作明时荷蓧身。\n只道乌鸦犹父子，岂知蝼蚁亦君臣。\n杖头日月挑周器，松下衣冠自舜民。\n好在丹青王右辖，解回枯槁入陶钧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":633,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫二首 其一","author":"赵秉文","text":"霜叶萧萧覆井栏，朝元阁上玉筝寒。\n千年辽鹤归华表，万里宫车泣露盘。\n日上雾尘迷碧瓦，夜深月露洗荒坛。\n断碑脍炙人何在，吏部而今不姓韩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":634,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游上清宫二首 其二","author":"赵秉文","text":"暇日登临近吹台，夷门城下访寒梅。\n鳌头它日几人在，樽酒而今一笑开。\n秋潦渗馀村径出，夕舂鸣处野禽来。\n醉归扶路人争看，知是诗仙阆苑回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":635,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送月上人赴少林","author":"赵秉文","text":"只臂伽黎不作难，将心到处遣人安。\n瓶离汴水秋风冷，锡入嵩峰夜月寒。\n箧里赠诗更雨晒，囊中施钵对风餐。\n心知拟就东林宿，已向林梢荐刹竿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":636,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登定安阁","author":"赵秉文","text":"翚飞高阁迥淩虚，中有盘盘一塔孤。\n千里河山随指顾，诸天日月绕弥卢。\n神超罔象遗身世，眼入苍茫一有无。\n便欲乘风游汗漫，幡然回首念南都。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":637,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"许州襄城县进嘉禾合颖应制","author":"赵秉文","text":"襄城城下壤歌传，驿奏嘉禾到日边。\n颖合周王新雨露，亩分黄帝旧山川。\n太平气象联珠琲，明德馨香列豆笾。\n万国和同归帝治，古书愿献补遗编。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":638,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"陇州进黄鹦鹉应制","author":"赵秉文","text":"陇鸟明时亦效祥，天教合侍赭袍黄。\n九重城里骈莺舌，百子池边借鹄裳。\n夜臂翠帘条脱重，春笼珠殿荔枝香。\n紫宸朝退鸣鞘远，偷学山称万岁觞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":639,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]