[{"title":"书怀","author":"赵元","text":"懒退无心廪与庖，愿㩦诸子斸山硗。\n閒消白日醒吟醉，猛省浮生梦幻泡。\n窈窕云山三兔窟，漂摇风树一鸠巢。\n联名便入村家社，莫认公卿是故交。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1777,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄裕之二首 其一","author":"赵元","text":"汩没兵尘满鬓霜，买邻心乐古清凉。\n閒陪老秀春行脚，闷欠臞元夜对床。\n正欲脱身求兔窟，谁能随世转羊肠。\n南阳未比嵩阳好，满眼交游即故乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1778,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄裕之二首 其二","author":"赵元","text":"老懒愚轩百不能，饱谙人意冷于冰。\n清狂旧日耽诗客，灰朽而今有发僧。\n梦裹纸衾三丈日，话延雪屋一龛灯。\n新开一径通兰若，斩尽清凉旧葛藤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1779,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿少林寺","author":"赵元","text":"双轮走鸡栖，下岭分间道。\n行行得精舍，翠崦作回抱。\n诸峰知客来，故故颜色好。\n征衫满尘土，惭愧方丈老。\n殷勤一瓣香，为我除热恼。\n世缘如落花，篱裀迹俱埽。\n个中有佳处，行脚恨不早。\n一庵祖师傍，异日亲结草。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1780,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚出","author":"赵元","text":"坐久卧还起，畏此夏日长。\n出门鬓蓬松，西日明半墙。\n鸠鸣舍东柳，雌和墙南桑。\n十日暑烦苦，一雨方论量。\n偶然释忧抱，露坐移绳床。\n群儿莫相催，老子便晚凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1781,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵裕之见寄二首 其一","author":"赵元","text":"鱼入深渊鹤在阴，飞潜何幸远庖砧。\n乾坤万里云无迹，冰雪三冬柏有心。\n故国钩留清夜梦，岁华分付白头吟。\n莘川拟作桃源隐，共与青山阅古今。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1782,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵裕之见寄二首 其二","author":"赵元","text":"古屋飕飕四壁尘，不堪幽独足吟呻。\n瓶储看客常年惯，家具为农近日新。\n世味饱尝惟可睡，诗情漫苦不医贫。\n相从分我西山半，欲乞臞元伴老身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1783,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题裕之家山图","author":"赵元","text":"系舟盘盘连石岭，牧马澄澄倒山影。\n山光水气相混涵，中有元家旧庐并。\n雁门一开豺虎场，驾言投迹嵩之阳。\n青山偃蹇不可将，十年竟堕兵尘黄。\n东岩风物知犹在，说与寄庵神已会。\n一挥淡墨能似之，清辉远寄形骸外。\n元家故山吾与邻，梦见不如画图真。\n旧曾行处聊经眼，未得归时亦可人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1784,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"早发宝应龙门道中有感","author":"赵元","text":"山僧送客客行东，回首云寮梦寐中。\n人语咿呦村店火，帽檐欹侧石门风。\n伊川远映春冰绿，少顶先搀晓日红。\n为问年来几还往，只应乌鹊识衰翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1785,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"钦若遽有商于之行作长语为别兼简仲泽弟一笑","author":"赵元","text":"庐山铓然深可居，洛水蚓然清可渔。\n嘉哉山水有如此，不能留客如蘧庐。\n楚茅不入干王诛，大帅分阃临商于。\n谋参帷幄渴英俊，蒐罗远到山间癯。\n陇西四钦出将种，人爱若也温而愉。\n朅来谁飞荐鹗书，枕前堕檄催驰驱。\n行参幕宾亦大可，把酒当为帅君贺。\n王家仲泽如仲宣，共看吐奇飞玉唾。\n一军号令雅歌中，声落荆蛮胆先破。\n愚轩退居如甑堕，閒暇多君时见过。\n明朝笑语隔关山，一月须?面墙卧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1786,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丁亥三月二十五日雪","author":"赵元","text":"夬变乾将至，阴凝阳不流。\n雨飞犹带雪，风急似号秋。\n草木无春意，关河惨客愁。\n天心宁易测，三叹索冬裘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1787,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"大暑","author":"赵元","text":"旱云飞火燎长空，白日浑如堕甑中。\n不到广寒冰雪窟，扇头能有几多风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1788,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读乐天无可奈何歌","author":"赵元","text":"凫胫苦太短，蚿足何其多。\n物理斩不齐，利剑空自磨。\n老蹠富且寿，元恶天不诃。\n伯夷岂不仁，饿死西山阿。\n天意寓冥邈，人心徒揣摩。\n不如且饮酒，流年付蹉跎。\n酒酣登高原，浩歌无奈何。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1789,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"哀古道","author":"赵元","text":"山深道坏水纵横，怪得春来少客行。\n不信天教人迹断，水乾更遣蒺藜生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1790,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"薛鼎臣罢登封","author":"赵元","text":"弄人鼓笛不相疑，便著当场傀儡衣。\n终日抱饥唯饮水，也和醉客一时归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1791,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋郊雨中","author":"密璹","text":"羸骖破盖雨淋浪，一抹烟林覆野塘。\n不著沙禽閒点缀，只横秋浦更凄凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1792,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宴息二首 其一","author":"密璹","text":"宴息春光晚，閒眠昼景虚。\n冥心居大道，达理契真如。\n乐对忘形友，欣逢未见书。\n世间幽隐者，何必尽樵渔。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1793,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宴息二首 其二","author":"密璹","text":"日日閒窗下，箪瓢乐不殊。\n花魁秾且艳，湖玉秀而臞。\n忆友寻诗卷，思山展画图。\n丹青传六逸，能著老夫无。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1794,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梁台","author":"密璹","text":"汴水悠悠蔡水来，秋风古道野花开。\n行人惊起田间雉，飞上梁王鼓吹台。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1795,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"自适","author":"密璹","text":"晴昼摇凉光，长空澹虚碧。\n燕鸿亦何为，老翅南又北。\n衰柳堕残叶，庭户觉岑寂。\n幽人诵佛书，清香萦几席。\n西方病维摩，东皋醉王绩。\n俱到忘言地，佳处略相敌。\n小斋蜗角许，夜卧膝仍屈。\n能以道眼观，宽大犹四极。\n有书贮实腹，无事梗虚臆。\n谢绝声利徒，尚友古遗直。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1796,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"城西","author":"密璹","text":"雁带边声远，牛横废垄长。\n人居似河朔，冈势接荥阳。\n禾短新村墅，沙平古战场。\n悠然望西北，莫色起悲凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1797,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送王生西游","author":"密璹","text":"紫陉仙人今渊云，骑风御气七尺身。\n丈夫耻与哙等伍，故作野鹤昂鸡群。\n往年书剑游梁日，咳唾中间满珠璧。\n温子徒劳手八叉，苏老犹迷日五色。\n慨然拂袖游嵩阳，西南陌上书传香。\n仲宣堂堂舍我去，举杯却愁愁更长。\n去程相近黄花节，三十六峰如玉列。\n龙门枫叶堕红绡，洛浦芦花舞晴雪。\n勋名细事犹秋毫，政可痛饮读离骚。\n天津月照紫绮裘，缑岭风吹青玉箫。\n我无羽翼随君起，浩歌相送秋光里。\n凭高西望青茫茫，落日无情下寒水。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1798,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王生以秋骚见示复以此谢之","author":"密璹","text":"三年京国与君游，每恨知君尚未周。\n始露雄文陵楚些，又登长陌佩吴钩。\n灯残茅店鸡催晓，霜落金风雁唤秋。\n后夜文星出西洛，仲宣知在水南楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1799,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"自题写真","author":"密璹","text":"枯木寒灰久亦神，因缘来现胙公身。\n只缘酷爱东坡老，人道前身赵德麟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1800,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书龙德宫八景亭","author":"密璹","text":"刻桷朱楹堕绀纱，裙腰草色趁阶斜。\n谁知剥落亭中石，曾听宣和玉树花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1801,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"思归","author":"密璹","text":"四时唯觉漏声长，几度吟残蜡烬缸。\n惊梦故人风动竹，催春羯鼓雨敲窗。\n新诗淡似鹅黄酒，归思浓如鸭绿江。\n遥想翠云亭下水，满陂青草鹭鸶双。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1802,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"如庵乐事","author":"密璹","text":"人间最美安心睡，睡起从容盥漱终。\n七卷莲经爇沈水，一杯汤饼泼油葱。\n因循默坐规禅老，取次拈诗教小童。\n炕煖窗明有书册，不知何者是穷通。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1803,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题晋卿王诜图绘","author":"密璹","text":"顾陆张吴宝绘堂，风花雪月保宁坊。\n锦囊玉轴三千幅，翠袖金钗十二行。\n数笔丹青参李范，一时迁谪为苏黄。\n太原珍玩名天下，旧迹犹凭古印章。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1804,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"得友人书","author":"密璹","text":"闻有书来喜欲狂，紫芝眉宇久难忘。\n别离惟叹我头白，诗句屡成君马黄。\n公干羁栖犹洛下，孔明高卧尚南阳。\n冷官领取閒中趣，远胜区区梦蚁忙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1805,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"内族子锐归来堂","author":"密璹","text":"一旦能知梦里真，平生看破主中宾。\n归来堂上忘形友，名利场边税驾人。\n东郭风烟宜蕙帐，南山猿鹤识纶巾。\n清尊雅趣閒棋味，盏盏冲和局局新。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1806,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题潘阆夜归图","author":"密璹","text":"不是诗人灞水壖，又非野老曲江边。\n风姿便认王摩诘，蕴藉还疑李谪仙。\n驴背倒骑莲岳下，牛腰稳跨竹林前。\n掀髯对月馀高兴，明日佳篇几处传。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1807,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"漫赋","author":"密璹","text":"贫知囊底一钱无，老觉人间万事虚。\n富贵傥来终作么，勋名便了又何如。\n季鹰未饱松江鲙，鲁望将成笠泽书。\n自是杜门无客过，不关多病故人疏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1808,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寓迹","author":"密璹","text":"寓迹中山记昔年，西溪卜筑欲终焉。\n飘零何在五株柳，离乱难归二顷田。\n漫叟未能忘野寺，道人犹解识林泉。\n吾乡巳宅无何有，一笑醯鸡尽瓮天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1809,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋晚出郭閒游","author":"密璹","text":"尘中俗事海漫漫，暂出城闉借眼宽。\n沙麓去边群牧小，野云平处一雕盘。\n残荷露水秋光晚，衰柳摇风古渡寒。\n此幅大年横景画，鲁冈图上似曾看。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1810,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"老境","author":"密璹","text":"老境唯禅况，幽居似宝坊。\n酒杯盛砚水，经卷贮诗囊。\n懒甚书弥少，閒多梦自长。\n不知何处雨，径作夜来凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1811,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北郊晚步","author":"密璹","text":"陂水荷凋晚，茅檐燕去凉。\n远林明落景，平麓淡秋光。\n群牧归村巷，孤禽立野航。\n自谙閒散乐，园圃意尤长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1812,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"閒咏","author":"密璹","text":"岁晚陶元亮，平生马少游。\n凋残半枯木，浩荡一虚舟。\n鹤望尘迷眼，鸡栖屋打头。\n瓶储尚萧索，焉敢计菟裘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1813,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"池莲","author":"密璹","text":"轻轻姿质淡娟娟，点缀圆池亦可怜。\n数点忽飞荷叶雨，莫香分得小江天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1814,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"梁园","author":"密璹","text":"一十八里汴堤柳，三十六桥梁苑花。\n纵使风光都似旧，北人见了也思家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1815,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"释迦出山息轩画","author":"密璹","text":"庞眉袖手出岩阿，及至拈花事巳讹。\n千古雪山山下路，杖藜无处避藤萝。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1816,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过胥相墓","author":"密璹","text":"亭亭华表映朱门，始见征西宰相尊。\n下马读碑人不识，夷山高处望中原。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1817,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋日小雨","author":"密璹","text":"白鹭裴佪花鸭游，城南城北几汀洲。\n绿荷风底飞来雨，做弄今年甲子秋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1818,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"东郊瘦马","author":"密璹","text":"此岁无秋?亩空，病骖难遣齧枯丛。\n仓储自益驽骀肉，独尔空嘶苜蓿风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1819,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"枕上听雨","author":"密璹","text":"卧听羯鼓打凉州，元是芭蕉细雨秋。\n庭际玉簪开几许，小窗特地莫香幽。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1820,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"溪景","author":"密璹","text":"飞飞鸥鸟自徜徉，也解新秋受用凉。\n日莫碧溪微雨过，满风都是藕花香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1821,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题纸衣道者图","author":"密璹","text":"紫袍披上金横带，藜杖拖来纸掩襟。\n富贵山林争几许，万缘唯要总无心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1822,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春半喜晴","author":"密璹","text":"阴寒二月雪含云，两日开晴淑景新。\n借问海棠红几许，杏花杨柳不曾春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1823,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"马伏波","author":"密璹","text":"可叹迂疏一老翁，岂堪床下拜梁松。\n明珠薏苡犹难辨，万里争教论杜龙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1824,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留侯","author":"密璹","text":"辟谷轻身慕赤松，不知谁举傅春宫。\n君方避溺犹居水，忍使馀波及四翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1825,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"对镜二首 其一","author":"密璹","text":"镜中色相类吾深，吾面终难镜里寻。\n明月印空空受月，是他空月本无心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1826,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"对镜二首 其二","author":"密璹","text":"明明非浅亦非深，何事痴人泥影寻。\n照见大千真法体，不关形相不关心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1827,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夏晚登楼","author":"密璹","text":"登楼晚暑复相攻，快意清风忽此逢。\n云似碧山天似水，霁波平浸两三峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1828,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"华亭","author":"密璹","text":"世尊遗法本忘言，教外别传意已圆。\n只履携将葱岭去，不妨来上月明船。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1829,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同裕之再过会善有怀希颜","author":"冯璧","text":"寺元魏离宫，十日来凡两。\n前与髯卿偕，斋奠少林往。\n其时巳薄暮，诸胜不暇访。\n今同魏诸孙，再到风烟上。\n寺僧导升殿，雄深肃瞻仰。\n柱础门限砧，追琢成大壮。\n不见磨琢痕，瑩滑明滉朗。\n摩挲三叹息，后世无此匠。\n晚登西南亭，碧玉对千丈。\n如王官天柱，如太华仙掌。\n留宿赞公房，秀色梦馀想。\n夜静耿不眠，泉溜琴筑响。\n惜髯今不来，联诗共清赏。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1830,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和希颜","author":"冯璧","text":"虎守天门未易通，庾尘无扇障西风。\n主人何负盗憎主，公论不明私害公。\n老伏固非千里骥，冥飞似是五噫鸿。\n纷纷往事渠知几，都付崧巅一笑中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1831,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送国医仪师颜企贤得请归关中次朝贤韵","author":"冯璧","text":"心平穷富恐欺天，面有阴功盖有年。\n归去青山仁者乐，秘来丹诀老而传。\n尚医冗食渠百辈，公论共推君十全。\n技道精微仍远引，就非轻举亦几仙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1832,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"河山形胜图","author":"冯璧","text":"书剑丁年记昔游，中条之麓过蒲州。\n地形西控三秦远，河势南吞二华秋。\n晋魏兵争一春梦，汉唐坛祀几荒丘。\n披图吊古令人慨，不必重登鹳雀楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1833,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雒帅觅兰作诗以寄","author":"冯璧","text":"云插高牙画戟森，春移宝槛燕堂深。\n水南红药初退舍，嵩麓紫兰今嗣音。\n茧足赪肩坐香累，高梁华栋岂渠心。\n使君有问花应语，玉树诚佳非故林。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1834,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"明皇击梧桐图","author":"冯璧","text":"三郎耳谱趁花奴，风调才情信有馀。\n天宝错来非一拍，霓裳中节亦区区。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1835,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送人出使","author":"冯璧","text":"阳春有脚苏疲瘵，水镜无心照洁污。\n九道澄清天意切，人才一一似君无。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1836,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"习池醉归图","author":"冯璧","text":"襄汉方屯十万兵，习池日往不曾醒。\n纷纷误晋皆渠辈，何独王家一宁馨。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1837,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"东坡海南烹茶图","author":"冯璧","text":"讲筵分赐密云龙，春梦分明觉亦空。\n地恶九钻黎洞火，天游两腋玉川风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1838,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"阴晦中忽见华山","author":"冯璧","text":"吏部能开衡岳云，坡仙曾借海宫春。\n莲峰清晓忽自献，二公何人予何人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1839,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"草堂春莫横披","author":"冯璧","text":"迁客倚楼家万里，五陵飞鞚酒千金。\n草堂澹与春山对，幽鸟一声春巳深。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1840,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元光间予在上龙潭每春秋二仲月往往与元雷游历嵩少诸蓝禅师汴公方事参访每相遇辄挥毫赋诗以道閒适之乐今犹梦寐见之儿子渭近以公故抵任城禅师附寄诗以叙畴昔未几驻锡东庵因造谒间出示裕之数诗醉笔纵横亦略道嵩游旧事感叹之馀漫赋长句二首 其一","author":"冯璧","text":"性理诸方巳遍参，归来一锡驻东庵。\n山中莲社旧招隐，旅舍阿戎新对谈。\n诗笔如君僧有几，文章愧我老无堪。\n绫书大字拈香疏，须趁微之酒半酣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1841,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元光间予在上龙潭每春秋二仲月往往与元雷游历嵩少诸蓝禅师汴公方事参访每相遇辄挥毫赋诗以道閒适之乐今犹梦寐见之儿子渭近以公故抵任城禅师附寄诗以叙畴昔未几驻锡东庵因造谒间出示裕之数诗醉笔纵横亦略道嵩游旧事感叹之馀漫赋长句二首 其二","author":"冯璧","text":"少林脩竹欲天参，竹外幽閒草结庵。\n顾我虽存惟白发，与君曾此共玄谈。\n干戈横绝境犹梦，草树荒残人岂堪。\n腊瓮春醪髯莫预，商歌悲壮不能酣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1842,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]