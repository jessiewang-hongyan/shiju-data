[{"title":"溪南","author":"周昂","text":"小径通沙稳，清溪带树深。\n岸危低白屋，云近没青岑。\n洒落高秋气，飞腾志士心。\n云台与麟阁，莫遣二毛侵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1380,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"继人韵","author":"周昂","text":"高兴秋方逸，幽居晚见过。\n欢交宁厌数，诗好不论多。\n五字含风雅，千篇费琢磨。\n自知才力拙，相报欲如何。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1381,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送李天英下第","author":"周昂","text":"不须寂寞恨东归，洗眼三年看一飞。\n试捲波澜入毫颖，莫教欧九识刘几。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1382,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿西蓝","author":"周昂","text":"闻道西蓝好，能来定有缘。\n青山避乔木，流水信平田。\n步屧迷深竹，题诗惜莫烟。\n尘心厌翻倒，一室暂安禅。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1383,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北湖清明","author":"周昂","text":"碧水随时酒，春风著处花。\n欢娱万国本，富贵五侯家。\n金动楼头管，香回日莫车。\n老夫唯欲睡，儿女莫相誇。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1384,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中秋夜高阳对月","author":"周昂","text":"端正高阳月，空庭又见过。\n清风禁睡得，白发奈愁何。\n尚识王良策，难知织女梭。\n金波流汩汩，应为照滹沲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1385,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丘家庄早发","author":"周昂","text":"渡马危桥立，村鸡暗树号。\n星稀白水阔，雾重黑山高。\n外物谁能必，人生会有劳。\n鹍鹏终变化，早晚借风涛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1386,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"边月","author":"周昂","text":"边月弓初满，山城角尚孤。\n中天看独立，永夜兴谁俱。\n未觉风生晕，空怀斗转隅。\n含情知白兔，欲下更踟蹰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1387,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"侍祠太室","author":"周昂","text":"设燎彤庭敞，悬灯玉殿深。\n星河含爽朗，城阙动阴沈。\n祗慄诚初荐，馨香德巳歆。\n清风动云幕，有喜见神心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1388,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夜步","author":"周昂","text":"击柝邻居静，开门宿鸟惊。\n西风秋半急，北斗夜深明。\n独立乾坤大，徐行杖屦轻。\n遥怜汉宫阙，重露湿金茎。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1389,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宋文贞公庙","author":"周昂","text":"开元四荒不动尘，柱石中原有老臣。\n襄土一丘松柏暗，长安三日荔枝新。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1390,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读陈后山诗","author":"周昂","text":"子美神功接混茫，人间无路可升堂。\n一斑管内时时见，赚得陈郎两鬓苍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1391,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"偶书","author":"周昂","text":"幽阴不放终年树，好味仍馀尽日茶。\n诗业未降心有种，世缘初尽眼无花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1392,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"失子","author":"周昂","text":"白发飘萧老病身，几因儿女泪沾巾。\n虚谈误世王夷甫，只有情钟语最真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1393,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北行即事二绝句 其一","author":"周昂","text":"闻道昆崙北，风尘避仆洼。\n至今悲汉节，不合度流沙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1394,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北行即事二绝句 其二","author":"周昂","text":"五月分衣节，三军受甲时。\n莫教麟阁将，频发羽林儿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1395,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"边月","author":"周昂","text":"驱车宿双浦，极目耿金波。\n不有中秋景，其如永夜何。\n沙分疑白雪，练失想明河。\n桂树元无意，南倾独好柯。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1396,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晨起","author":"周昂","text":"鼓声随晓角，合沓起平荒。\n宿火连冈小，寒星堕水长。\n鲸翻惊日动，马食快宵凉。\n白首登坛将，功名好自强。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1397,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西城道中","author":"周昂","text":"草路幽香不动尘，细蝉初向叶间闻。\n溟濛小雨来无际，云与青山淡不分。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1398,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"醉经斋为虞乡麻长官赋","author":"周昂","text":"诗书读破自融神，不羡云安曲米春。\n黄卷至今真味在，莫将糟粕待前人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1399,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"清放斋","author":"周昂","text":"平生眼白嫌物俗，此身谁要冠带束。\n茶瓯饭饱一饮足，卧听松风仰看屋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1400,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"孙资深岁寒堂","author":"周昂","text":"世态浮云日夜移，春兰秋菊各争时。\n此心铁石无人会，唯有庭前柏树知。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1401,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登绵山上方","author":"周昂","text":"环合青峰插剑长，小平如掌寄禅房。\n危阑半出云霄上，秘景尽收天地藏。\n野阔群山惊破碎，云低沧海认微茫。\n九华籍甚因人显，迥秀可怜天一方。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1402,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"谒先主庙","author":"周昂","text":"暗粉陈丹半在亡，短垣残日共悲凉。\n不须古碣书绵竹，自有荒村纪葆桑。\n尘土衣冠曾系马，岁时歌舞亦称觞。\n不应巴蜀江山丽，能使英灵忘故乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1403,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送客","author":"周昂","text":"相见席不暖，送行情更牵。\n只愁人面隔，不放马蹄前。\n塞迥云垂地，溪平水接天。\n山川后期阔，把臂两茫然。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1404,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"莫州道中","author":"周昂","text":"大陵河东古莫州，居人小屋如蜗牛。\n屋边向外何所有，唯见白沙累累堆山丘。\n车行沙中如倒拽，风惊沙流失前辙。\n马蹄半跛牛领穿，三步停鞭五步歇。\n鸡声人语无四邻，晚风萧萧愁杀人。\n人有祷，沙应神，辽东老兵非使臣，何必埋却双行轮。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1405,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其一","author":"周昂","text":"忧患年来坐读书，田园抛却任荒芜。\n目前却得晨昏力，碌碌无由似阿奴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1406,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其二","author":"周昂","text":"远目伤心千里馀，凛然真觉近狼须。\n云边处处是青冢，马上人人皆白须。\n正忆荒村临古道，不堪独树点平芜。\n谁人与话西园路，梅竹而今似画图。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1407,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"感秋","author":"周昂","text":"秋气入行帐，愁人中夜知。\n鸡声与人语，耿耿异常时。\n清晨起危坐，感难不自持。\n羲和驭飞毂，往返无停期。\n春草如昨日，已复悲离离。\n顾谓镜中发，尔衰安得迟。\n结束媚鞍马，荒山去委蛇。\n黄花泫宵露，绿野含晨曦。\n吾事久不谐，悠悠随所之。\n有怀南涧约，敢赋北山诗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1408,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"对月","author":"周昂","text":"月满秋仍早，台高夜未徂。\n水光先剡淡，星影失踟蹰。\n玉帐传更急，荒城击柝孤。\n去年双泪眼，依旧入平芜。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1409,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鹊山","author":"周昂","text":"西征疲短服，北望惨衰颜。\n再宿殊鸡舍，相看独鹊山。\n旆沾新雨过，鸟逐莫云还。\n白首瞻星汉，何时鼓角閒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1410,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"望山中松","author":"周昂","text":"地险蟠根古，人稀小径消。\n雨皴开白雪，风响入青霄。\n未畏斧斤逼，惟愁霹雳烧。\n解鞍那避远，冷色故相招。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1411,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其一","author":"周昂","text":"不堪华发半头生，老去偏添爱嫪情。\n新得家书来报喜，旧时龟子绕床行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1412,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其二","author":"周昂","text":"一床安置似僧居，白发忘梳动月馀。\n懒性渐成愁把笔，小诗常拟倩人书。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1413,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日","author":"周昂","text":"不堪马上逢佳节，况是天涯望故乡。\n高会未容陪戏马，旧游空复忆临香。\n痴云黯黯方垂地，小雪霏霏欲度墙。\n犹赖多情数枝菊，肯留金蕊待重阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1414,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"对月","author":"周昂","text":"万里寥天月，相随不惮劳。\n屡添华发满，曾傍黑山高。\n影动新琼杵，光含旧宝刀。\n常娥应见讶，独宿弊绨袍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1415,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其一","author":"周昂","text":"去岁翠屏下，东流看涌波。\n愁将新鬓发，还对旧关河。\n翅健翻秋隼，峰高并晚驼。\n草深饶虎迹，夜黑欲谁过。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1416,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其二","author":"周昂","text":"地拥河山壮，营关剑甲重。\n马牛来细路，灯火出寒松。\n刁斗方严夜，羔裘欲禦冬。\n可怜天设险，不入汉提封。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1417,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其三","author":"周昂","text":"玉帐初鸣鼓，金鞍半偃弓。\n伤心看寒水，对面隔华风。\n山去何时断，云来本自通。\n不须惊异域，曾在版图中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1418,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其四","author":"周昂","text":"野蔓梢驼架，轻泥溅马鞍。\n径斜来险石，溪急上清滩。\n羽檄千山静，羔裘六月寒。\n长松空夹道，萧飒不成看。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1419,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其五","author":"周昂","text":"旌节曕前帐，风尘识旧坡。\n眼平青草短，情乱碧山多。\n晚起方投笔，前驱效执戈。\n马蹄须爱惜，留渡北流河。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1420,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其六","author":"周昂","text":"万里来崩豁，终年气惨悽。\n地穷清涧断，天近玉绳低。\n孛窟黄沙北，昆崙白雪西。\n故园何处觅，搔首意空迷。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1421,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"翠屏口七首 其七","author":"周昂","text":"塞古秋风早，山昏落日低。\n积云鸦度久，荒岸马归齐。\n灯火看时出，茅茨渐欲迷。\n尘沙恨于役，况乃对鸡栖。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1422,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"边俗","author":"周昂","text":"返阖看平野，斜垣逐慢坡。\n马牛虽异域，鸡犬竟同窠。\n木杵舂晨急，糠灯照夜多。\n淳风今巳破，征敛为兵戈。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1423,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其一","author":"周昂","text":"秋日山田熟，山家趣转奇。\n垄苞银栗缀，墙蔓绿云垂。\n野饭留佳客，青钱付小儿。\n主人愁丧乱，数数问边陲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1424,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其二","author":"周昂","text":"萧飒晚风凉，高杠引旆长。\n岭云残宿阵，陵日湛晨光。\n已作依刘表，终须问葛疆。\n俯身驰万里，未觉鬓毛苍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1425,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其三","author":"周昂","text":"年深师欲老，秋至敌还轻。\n但使财思义，犹多死易生。\n指挥无险阻，感激在精诚。\n万古麒麟阁，何曾浪得名。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1426,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其四","author":"周昂","text":"简易军中事，川原入望多。\n草平铺碧锦，山远出青螺。\n远愧桃花水，重临杏子河。\n去年关塞意，萧䬃起悲歌。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1427,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其五","author":"周昂","text":"赤涧蟠双阙，青山壮一门。\n放歌游远目，箕踞得高原。\n地险劳天设，边戈厌日屯。\n庙谋新控扼，万里可雄吞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1428,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其六","author":"周昂","text":"官舍暂投辖，塞垣还着鞭。\n路移新岁月，心醉好山川。\n方丈何由到，桃源恐浪传。\n相看不隔水，遗恨惜他年。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1429,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山家七首 其七","author":"周昂","text":"翡翠长松秀，氍毹细草斑。\n屡经新渡水，不数旧看山。\n太华愁登陟，终南费引攀。\n岂知图画景，长在马蹄间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1430,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北行二首 其一","author":"周昂","text":"卸鞍休马倦，解橐罢驼鸣。\n细雨侵衣急，长郊入卧平。\n溪喧看水满，山黑厌云生。\n莫怪龙行数，应知欲洗兵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1431,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北行二首 其二","author":"周昂","text":"比岁频分甲，今年贺息兵。\n竞誇新战士，谁识旧书生。\n北塞甘长别，南天欲远征。\n二年迎复送，空愧泰州城。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1432,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山丹花","author":"周昂","text":"浪蕊谁能记，山丹旧所闻。\n卷花翻碧草，低地落红云。\n塞雨沾衣久，溪风入把勤。\n莫言羌妇丑，谁识汉昭君。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1433,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日即事","author":"周昂","text":"冻柳僵榆未改容，狐裘貂帽尚宜风。\n欲寻把酒浑无处，春在鸣鸠谷谷中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1434,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄金山老","author":"周昂","text":"庭前双柏树，作别似晨朝。\n书信随溪茗，音声落海潮。\n岭云閒可玩，边月苦无憀。\n相见愁他日，风沙两鬓凋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1435,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄王子明","author":"周昂","text":"病起身仍懒，眠多意尚迷。\n笔成今夕把，书似隔年题。\n久恨心期阻，难邀物理齐。\n灯花应解事，岑寂向人低。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1436,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"无题","author":"周昂","text":"西风吹白水，日暮动寒威。\n野帐收旗尽，奚儿饮马归。\n梢梢闻鸟过，惨惨见云飞。\n夜黑多豺虎，荒村定敢依。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1437,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"萱草","author":"周昂","text":"万里黄萱好，风烟接路傍。\n迹疏虽异域，心密竟中央。\n染练成初色，移瓶得细香。\n客愁无路遣，始为看花忘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1438,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"得家书","author":"周昂","text":"穷愁非昔境，白发有深根。\n泪破孤城郡，书来万里村。\n雁声寒日夜，秋色老乾坤。\n为问游方子，何时慰倚门。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1439,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书斋","author":"周昂","text":"夜雨书斋冷，西风木叶抛。\n暗蛩侵坏壁，低雁落寒郊。\n壮志初尝胆，吾生岂系匏。\n草玄虽闭户，未用客相嘲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1440,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"闻蝉","author":"周昂","text":"冥机辞委蜕，天籁发幽嘶。\n迥露增晨洗，清风借晚携。\n暂成千里隔，还作一枝低。\n客思饶相触，愁时故不齐。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1441,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚阴不成","author":"周昂","text":"落日明西极，高云暗朔方。\n楼台分照耀，宇宙一苍茫。\n不借蛟龙便，虚成燕雀忙。\n何须遣雷怒，郁郁绕高梁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1442,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"窦氏园亭二首 其一","author":"周昂","text":"云树春秋色，风泉日夜声。\n过庭高幕暗，吹簟转雷惊。\n翠袖擎诗罢，银壶得酒倾。\n平生耽野趣，到此眼偏明。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1443,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"窦氏园亭二首 其二","author":"周昂","text":"磴凿苍崖破，池通碧涧流。\n憩深怜洞室，吟稳忆扁舟。\n谷口堪高隐，河梁厌远游。\n卜居真此地，幽寂更何求。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1444,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其一","author":"周昂","text":"南苑霓旌动缭墙，天街莲烛照脩廊。\n斗南绛气风吹尽，小雨濛濛湿建章。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1445,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其二","author":"周昂","text":"杨花颠倒入帘栊，睡鸭香残碧雾空。\n尽日寻诗寻不得，鹁鸪声在梦魂中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1446,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"代书寄大元伯","author":"周昂","text":"南园腊蚁记同倾，一纸书来万里情。\n日夜愁心随柳色，东风吹满大梁城。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1447,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和路宣叔梅","author":"周昂","text":"月底明肌粲寿阳，道人呼入竹西堂。\n安排腊味千钟酒，消破春风万斛香。\n花鸟有情应见惜，蛾眉倾国故难藏。\n西湖骨朽东坡远，又为君诗恼一场。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1448,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"新秋","author":"周昂","text":"畏日经时暑，清秋一夕凉。\n真堪近灯火，不复病衣裳。\n宋玉悲摇落，安仁愧老苍。\n鄙夫那及此，睡美百忧忘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1449,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"靳子温款春亭","author":"周昂","text":"曾数花须傍药阑，春风不到酒杯宽。\n自怜白首荒三径，桃李年年檐上看。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1450,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"底柱图","author":"周昂","text":"鬼门幽险深百篙，人门逼窄逾两牢。\n舟人叫渡口流血，性命咫尺轻鸿毛。\n开图顿觉风雷怒，素发飘箫激衰腐。\n河来天上石不移，安得此心如底柱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1451,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寒林七贤","author":"周昂","text":"苦寒如此欲何之，雪帽风裘意自奇。\n纵有清诗三百首，未应肯得党家儿。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1452,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]