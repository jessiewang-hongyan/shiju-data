[{"title":"赵桥","author":"赵秉文","text":"天垂旷野初疑合，地转深岩忽似穷。\n偶向高崖闻笑语，寒舂一带夕阳中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":709,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鸡鸣山","author":"赵秉文","text":"烟蒸山腹晴犹湿，河带冰澌暖渐流。\n独上鸡鸣看日出，五云多处是皇州。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":710,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"卢沟","author":"赵秉文","text":"河分桥柱如瓜蔓，路入都门似犬牙。\n落日卢沟沟上柳，送人几度出京华。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":711,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"渔阳道中","author":"赵秉文","text":"盘山曾借上方眠，落月苍苍响石泉。\n夜半峰头听鸣鹿，半崖松子落阶前。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":712,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"达北京","author":"赵秉文","text":"小车日日碾征尘，卧即看书坐欠伸。\n露宿风餐二千里，青山无处不随人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":713,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"龙山怪松","author":"赵秉文","text":"自笑书生骨相穷，倒骑驴看两三峰。\n天东稍喜无碑读，踏雪还来看怪松。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":714,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"东京见梅","author":"赵秉文","text":"二月天东冻未苏，梅花有骨也青癯。\n一枝萼绿来千里，为问东君管得无。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":715,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"辽东","author":"赵秉文","text":"几家篱落枕江边，树外秋明水底天。\n日暮沙禽忽惊起，一痕冲破浪花圆。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":716,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北都雪望","author":"赵秉文","text":"千山雪尽出樵车，一径云迂去似蛇。\n小屋平头墟落里，吹烟起处是人家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":717,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北都小雪","author":"赵秉文","text":"边城小雪试年华，烟冷貔貅十万家。\n探使不来人半醉，将军毡帐卓平沙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":718,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"袭香亭二首 其一","author":"赵秉文","text":"小桥虹影截波光，面面荷花镜里妆。\n风月要知无尽处，一亭分作两亭香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":719,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"袭香亭二首 其二","author":"赵秉文","text":"黄堂公退吏人稀，露下西溪鹤未知。\n一榻清香无著处，晓风残月独来时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":720,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"锦波亭","author":"赵秉文","text":"柳影移堤步晚凉，清溪放月水泱泱。\n胸中经纬天机锦，闲却小亭风露香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":721,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨晴二首 其一","author":"赵秉文","text":"东风时送瓦沟声，欹枕幽窗梦自惊。\n睡起不知云已散，夕阳偏向柳梢明。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":722,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨晴二首 其二","author":"赵秉文","text":"一抹平林媚夕晖，山烟漠漠燕飞飞。\n倚栏遥认天边电，何处行人带雨归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":723,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"灵感寺二首 其一","author":"赵秉文","text":"斜廊深院断人行，雪聚松了立鸟清。\n僧腊数残门乍启，惊飞谇语独含情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":724,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"灵感寺二首 其二","author":"赵秉文","text":"青青隐隐入烟微，一日看山坐水涯。\n何事晚来风截断，偶看白鸟过林时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":725,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鸡鸣山下桥","author":"赵秉文","text":"两山相对翠屏开，一水中流碍石回。\n桥北桥南路分处，红尘一骑日边来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":726,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和舜元杂诗二首 其一","author":"赵秉文","text":"瘦马龙钟两鬓华，敲门避雨野人家。\n门前篱落犹悬露，十里晚风吹断霞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":727,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和舜元杂诗二首 其二","author":"赵秉文","text":"三五残星阙角东，淡黄杨柳月明中。\n贪看稚子收残叶，驻马天街满袖风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":728,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"圣安小集","author":"赵秉文","text":"松轩却扇风仍好，苔径无花雨亦香。\n门外市声鏖午枕，老僧元不下禅床。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":729,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和子约立春","author":"赵秉文","text":"唐虞礼乐岁元新，齐鲁中书有大臣。\n泰和三年调玉烛，衣冠万国拜王春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":730,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"二青图","author":"赵秉文","text":"大青天骥之云仍，小青八尺犹龙腾。\n三十年来无汗马，不将遗像铸兴陵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":731,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"古北口","author":"赵秉文","text":"几家墟落兵戈外，数亩荒田谷涧中。\n日暮围场来野鹿，令人长忆笔头公。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":732,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"抚州二首 其一","author":"赵秉文","text":"萧寺金风动刹竿，西城北斗挂栏干。\n一虫不响夜更静，片月未高山已寒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":733,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"抚州二首 其二","author":"赵秉文","text":"燕赐城边春草生，野狐岭外断人行。\n沙平草远望不尽，日暮惟有牛羊声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":734,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"北苑寓直","author":"赵秉文","text":"柳外宫墙粉一围，飞尘障面捲斜晖。\n潇潇几点莲塘雨，曾上诗人下直衣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":735,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寓望","author":"赵秉文","text":"蒲根閤閤乱蛙鸣，点水杨花半白青。\n隔岸风来闻鼓吹，柳阴深处有园亭。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":736,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"戴花","author":"赵秉文","text":"病来杯酒懒重持，强为残花折一枝。\n人老易悲花易落，东风休近鬓边吹。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":737,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"玉堂二首 其一","author":"赵秉文","text":"玉堂看到午阴移，日暮春风下直迟。\n误喜交番旗脚转，隔墙送过小桃枝。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":738,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"玉堂二首 其二","author":"赵秉文","text":"玉堂阴合冷窗纱，雨过银泥引篆蜗。\n萱草茙葵俱不见，蜂声满院采槐花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":739,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西溪","author":"赵秉文","text":"山垠西北尘沙少，水际东南风月宽。\n尽日朱门人不到，凫鹥引子傍栏干。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":740,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夏直","author":"赵秉文","text":"玉堂睡起苦思茶，别院铜轮碾露芽。\n红日转阶帘影薄，一双蝴蝶上葵花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":741,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过邯郸","author":"赵秉文","text":"十五年来黍一炊，丛台重觅旧题诗。\n而今马上行人老，不似当初过赵时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":742,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"临洺","author":"赵秉文","text":"聪山洺水送还迎，世事浮云几变更。\n白发重来相识尽，逢人欲问小时名。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":743,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"真际柏","author":"赵秉文","text":"赵州东院庭前柏，二百年来屈铁柯。\n莫怪两株缠欲死，后来禅客葛藤多。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":744,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"滹沱","author":"赵秉文","text":"滹沱一箭截天来，六月砅雷打土崖。\n一夜北风吹岸改，直从中渡牵船回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":745,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题阎立本职贡图临本二首 其一","author":"赵秉文","text":"周王职贡朝万邦，右相丹青古无双。\n好本不应天下独，解如明月印千江。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":746,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题阎立本职贡图临本二首 其二","author":"赵秉文","text":"金犀剺面觇天庭，王会图中见典刑。\n已了宣威沙漠事，更烦右相写丹青。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":747,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"墨梅","author":"赵秉文","text":"画师不作胭脂面，却恐傍人嫌我真。\n相逢莫道不相识，夏馥从来琢玉人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":748,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"香山","author":"赵秉文","text":"山秀薰人欲破斋，临行别语更徘徊。\n笔头滴下烟岚句，知是香山境里来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":749,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夏日","author":"赵秉文","text":"树木交阴鸟自呼，蘧蘧残梦破华胥。\n虚檐一道风如水，展尽床头几叶书。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":750,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"太宁吟诗台雨中","author":"赵秉文","text":"易州山水甲天下，一日太宁如死灰。\n山意似羞人识面，雨昏丞相赋诗台。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":751,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"涞阳道中","author":"赵秉文","text":"石头荦确水纵横，人在青山影里行。\n忽悟过溪惊笑语，断崖茅屋暮舂声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":752,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"昌平狄梁公庙","author":"赵秉文","text":"力扶沧海将颓日，目送西山不尽云。\n一邑岂能专惠爱，至今天下不名君。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":753,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"灵峰院","author":"赵秉文","text":"天门划断两崖青，拄杖灵峰顶上行。\n一片白云岩下起，不教眼力尽东溟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":754,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"燕","author":"赵秉文","text":"宦游怜我食官仓，赢得青青两鬓苍。\n不识无情双燕子，南来北去为谁忙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":755,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"涌云楼雨二首 其一","author":"赵秉文","text":"片云头上一声雷，欲到冠山风引回。\n窗外忽传林叶响，坐看飞雨入楼来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":756,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"涌云楼雨二首 其二","author":"赵秉文","text":"帘雨风斜不上钩，栏干吹湿怕人愁。\n雷声驱雨东山去，留下斜阳恰半楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":757,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"楼上二首 其一","author":"赵秉文","text":"楼头四面好风生，下与遥山一样平。\n睡起沙幮欹枕处，恰如水底看云行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":758,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"楼上二首 其二","author":"赵秉文","text":"山城过雨怯衣单，清晓楼头六月寒。\n却唤奚奴添半臂，要乘凉气倚栏干。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":759,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登晋阳阁","author":"赵秉文","text":"陂陀势尽晋川开，一线汾河掌上来。\n斜日西风倚高阁，白乌飞过天门回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":760,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中山会故人","author":"赵秉文","text":"三十二年役梦魂，故人老尽一身存。\n灯前细讲当时话，别后相思谁与论。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":761,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"下直","author":"赵秉文","text":"绿槐影里鸟呼风，退食凉生襟袖中。\n满地绿苔承步幛，楸花无蒂落深宫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":762,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"潭上二首 其一","author":"赵秉文","text":"倒影花枝照水明，三三五五岸边行。\n今年潭上游人少，不是东风也世情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":763,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"潭上二首 其二","author":"赵秉文","text":"日斜飞尽往来尘，为怕春愁恋酒樽。\n醉里不知归去晚，先声留著颢华门。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":764,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿王佐寺","author":"赵秉文","text":"鞍山柘水事茫茫，犹记同游宿上方。\n老大重寻窗下宿，残经挂壁故人亡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":765,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"燕子图三首 其一","author":"赵秉文","text":"一别天涯十见春，重来白发一番新。\n心知话尽春愁处，相对依依如故人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":766,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"燕子图三首 其二","author":"赵秉文","text":"祝尔区区万里身，锦书回寄莫辞频。\n而今塞北看双翼，多少中原失意人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":767,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"燕子图三首 其三","author":"赵秉文","text":"交亲消息两何如，满眼兵戈不得书。\n为问南来新燕子，衔泥曾复到吾庐。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":768,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送人之河中","author":"赵秉文","text":"功名蚁穴梦南柯，投老空门不较多。\n试看铁牛无用处，横身终古负黄河。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":769,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题李平父画黄山蹇驴诗图二首 其一","author":"赵秉文","text":"浮光林杪水参差，意想先生得句时。\n千古黄山山下路，蹇驴不是少人骑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":770,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题李平父画黄山蹇驴诗图二首 其二","author":"赵秉文","text":"三十年前济水东，诗人曾识蹇驴翁。\n而今画出推敲势，却恐相逢是梦中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":771,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中秋日郊外遇雨","author":"赵秉文","text":"斜风吹雨水生寒，荷盖倾珠下芡盘。\n惊起鹭鸶眠不得，冲烟飞过蓼花滩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":772,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"登定安阁","author":"赵秉文","text":"春风吹袖著栏干，薄雾初收雪未残。\n拟折梅花遮远日，愁看直北是长安。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":773,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"荥阳古槐","author":"赵秉文","text":"荥阳县东千占槐，人言曾见汉朝来。\n不知几觉南柯梦，直至如今唤不回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":774,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"虎牢","author":"赵秉文","text":"两崖峡束枕洪涛，自古英雄争虎牢。\n苍天胡为设此险，长使战骨如山高。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":775,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"新安道中","author":"赵秉文","text":"草根啾唧候虫鸣，月黑山腰信马行。\n夹路水声长在耳，六根先得一根清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":776,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游华山四绝 其一","author":"赵秉文","text":"石头荦确水纵横，过雨山閒草屦轻。\n未到上方先满意，倚天青壁看云生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":777,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游华山四绝 其二","author":"赵秉文","text":"我与青山有旧盟，淡云微雨忽渝平。\n朝来自献三峰出，真个山神不世情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":778,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游华山四绝 其三","author":"赵秉文","text":"仙人仙去有仙掌，袖中掷下青芙蓉。\n遗与杨羲书一纸，暂留笙鹤驻中峰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":779,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"游华山四绝 其四","author":"赵秉文","text":"玉龟山下古仙真，许我天台一化身。\n拟把岳莲骑白鹤，下看浮世尽红尘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":780,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"河上公庙","author":"赵秉文","text":"河上丈人忘姓名，一编道德了一生。\n时来河上观物化，投胶欲变黄河清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":781,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"稠桑谷遇雨","author":"赵秉文","text":"穷秋两渡稠桑谷，马滑还经险路过。\n骑上下山三十里，天教冲雨看黄河。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":782,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"济源四绝 其一","author":"赵秉文","text":"歌管年年乐太平，而今钲鼓替欢声。\n裴公祠下无穷水，好乞馀波为洗兵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":783,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"济源四绝 其二","author":"赵秉文","text":"祠前缭绕无穷水，竹杪参差不尽山。\n极目水穷山尽处，天坛犹在白云间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":784,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"济源四绝 其三","author":"赵秉文","text":"树映楼台水映空，溪容林意两溶溶。\n夏山如醉无人画，远处微茫近处浓。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":785,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"济源四绝 其四","author":"赵秉文","text":"毵毵云木晓相参，寺枕龙蟠十顷潭。\n一径通幽竹深处，居人指似侍中庵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":786,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山行四绝 其一","author":"赵秉文","text":"终日看云不忍还，马蹄荦确两山间。\n雨声欲到诗人耳，云气先濛一半山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":787,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山行四绝 其二","author":"赵秉文","text":"漠漠青田鹭啄苔，背人飞去又飞回。\n青山影里衔青稻，知是济源枋口来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":788,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山行四绝 其三","author":"赵秉文","text":"树根系筏水沦漪，雨里看山也大奇。\n不见文公陈迹在，摩挲苔壁认题诗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":789,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]