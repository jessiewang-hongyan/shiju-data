[{"title":"过省冤谷","author":"周昂","text":"婴儿偃蹇正堪孩，换得山西老将回。\n往者不追来不戒，莫将家世论人材。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1453,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鲁直墨迹","author":"周昂","text":"诗健如提十万兵，东坡真欲避时名。\n须知笔墨浑閒事，犹与先生抵死争。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1454,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读柳诗","author":"周昂","text":"功名翕忽负初心，行和骚人泽畔吟。\n开卷未终还复掩，世间无此最悲音。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1455,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"忆刘及之","author":"周昂","text":"千株何处封君橘，二顷谁家负郭田。\n长路风尘空费日，故园书札动经年。\n未能免俗真聊尔，不为怀忧亦悄然。\n襟抱何人与开释，论文除得老臞仙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1456,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"家园","author":"周昂","text":"五亩园连竹，三间屋向阳。\n气和春浩荡，心静日舒长。\n花鸟成相识，琴书付两忘。\n陶然一尊酒，谁复记羲皇。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1457,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚望","author":"周昂","text":"独立孤城上，关山望不休。\n异乡惊绝域，远目豁清秋。\n未拟登楼作，空歌出塞愁。\n故园飞鸟外，溪水正南流。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1458,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"水南晚眺","author":"周昂","text":"小径通沙稳，清溪带树深。\n岸危低白屋，云近没青岑。\n洒落高秋气，飞腾志士心。\n赋诗增感激，流水是知音。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1459,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"正月大风雨","author":"周昂","text":"风如渤澥势凌虚，寒破貂裘力尚馀。\n不是化工难倚赖，也知青帝有驱除。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1460,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"吊张益之","author":"周昂","text":"当年读书山堂中，夜喜与君灯火同。\n尘编壤简如蠹攻，弱质鄙钝烦磨砻。\n新诗如洗露芒锋，逸气欲倒浮云骢。\n轻裘肥马世上雄，吾徒一饭尝未充。\n君如孔翠愁彫笼，我亦哀鸿避鸣弓。\n孤城一别天西东，几见黄叶飞霜风。\n寄书无由魂梦通，西望落日衔千峰。\n他时云雨傥相逢，犹思惊雷起池龙。\n鬼神无赖欺天公，哀哉若人竟死穷。\n自闻君亡阜生胸，上诉九关无路从。\n百年过眼如转蓬，梦时忧乐觉即空。\n长夜漫漫何时终，作诗寄哀投殡宫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1461,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晚宿山寺","author":"赵沨","text":"松门明月佛前灯，庵在孤云最上层。\n犬吠一山秋意静，敲门时有夜归僧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1462,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"仙和尚坐脱","author":"赵沨","text":"识得从来觉性圆，西归只履更翛然。\n永嘉稳步曹溪路，临济饱参黄檗禅。\n桶底脱时无一物，机轮转处有三玄。\n火中留得一茎草，依旧光明烁大千。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1463,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"黄山道中","author":"赵沨","text":"小谷城荒路屈蟠，石根寒碧涨秋湾。\n千章秀木黄公庙，一点飞云白塔山。\n好景落谁诗句里，蹇驴驼我画图间。\n膏肓泉石真吾事，莫厌乘閒数往还。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1464,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"郊外","author":"赵沨","text":"迥野饶秋色，高台半夕阳。\n鸥眠沙渚静，鸟没岭云长。\n薄宦违幽兴，浮生更异乡。\n岁华成白首，丘壑愈难忘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1465,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"贡院中怀山中故居","author":"赵沨","text":"岁晚西溪路，谁过旧草堂。\n苔纹侵柱础，竹色度邻墙。\n白首光阴疾，青山意绪长。\n相思老兄弟，夜夜梦还乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1466,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"贡院闻雨","author":"赵沨","text":"灯暗风翻幔，蛬吟叶拥墙。\n人如秋巳老，愁与夜俱长。\n滴尽阶前雨，催成镜里霜。\n黄花依旧好，多病不能觞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1467,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"聚远台","author":"赵沨","text":"独上平台上，风云万里来。\n青山一尊酒，落日未能回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1468,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋日感怀","author":"赵沨","text":"岁月不相饶，秋风䬃巳至。\n蚊雷稍收声，团扇且复置。\n久雨不宜人，新凉差快意。\n数篇东皋诗，引我北窗睡。\n林泉久隔阔，尘土作憔悴。\n但有适人适，何尝事吾事。\n一贫既忘怀，所好无不遂。\n世无陶靖节，何人知此味。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1469,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"用仲谦元夕诗韵","author":"赵沨","text":"闻道蓝田辋口庄，欹湖前日具飞航。\n李膺定巳回仙棹，王绩无由入醉乡。\n薄宦系人如坐井，穷愁染鬓欲成霜。\n早知上界多官府，只向人间作酒狂。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1470,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和茂才韵","author":"赵沨","text":"十年为客未还家，赢得毵毵两鬓华。\n别后故人应念我，不来踏雪看梅花。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1471,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留题西溪三绝 其一","author":"赵沨","text":"谁开玉鉴泻天光，占断人间六月凉。\n日落沙禽犹未散，也知受用藕花香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1472,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留题西溪三绝 其二","author":"赵沨","text":"波光湛碧冷无痕，眇眇轻风起縠纹。\n认得朝来疏雨过，却因水底见飞云。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1473,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留题西溪三绝 其三","author":"赵沨","text":"总道西溪画不如，岂知造物用功夫。\n蟾光忽作灵犀透，表里通明两玉壶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1474,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日怀尹无忌","author":"赵沨","text":"茅屋秋萧索，幽居尽日閒。\n碧云看欲暮，远客几时还。\n书剑成何事，风尘只强颜。\n思君千里梦，夜夜到燕山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1475,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"立秋","author":"赵沨","text":"日月如川流，去矣不复回。\n万物各有营，荣悴更相催。\n馀生苦多艰，壮志久摧颓。\n念欲学还丹，郁纡殊未谐。\n今朝立新秋，庭树西风来。\n举首望天宇，飞云独徘徊。\n呼儿且沽酒，浩歌豁秋怀。\n醉中得妙理，逸兴何悠哉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1476,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和崔深道春寒","author":"赵沨","text":"长风忽落青林端，风声汹若江声寒。\n太阴盘礴乱天序，推书扑笔成长叹。\n美人何许媚幽独，使我不见心无欢。\n颇闻隐居诵庄屈，篷窗坐拥尘编残。\n琴歌酒赋两寂莫，悬知此兴殊未阑。\n迟君一来吐款要，举杯放目云天宽。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1477,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西城观水","author":"赵沨","text":"西山秋水来天地，巨野横流浩无际。\n长风蹙浪鳞甲生，两角斜分半山际。\n缭堤北去接飞桥，鼓鼙汹汹翻惊涛。\n中流突兀玉山起，直疑河伯驱灵鳌。\n冷光摇荡秋云白，浑似梦中游震泽。\n隔林我欲唤渔郎，孤帆忽如过鸟翼。\n安得酒船常拍浮，四时甘味置两头。\n何人与我同此乐，颍阳试觅元丹丘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1478,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"盆池荷花","author":"赵沨","text":"一泓寒碧甃波光，雨后妖红独自芳。\n不许纤尘污天质，政须清吹发幽香。\n洛神初试凌波袜，妃子来从礜石汤。\n休笑埋盆等儿戏，要令引梦水云乡。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1479,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"扈从车驾至荆山","author":"赵沨","text":"海上飞来碧玉峰，瑶林琪树更青葱。\n参差楼观浮云表，颠倒山光落镜中。\n侍从有臣司碧落，笑谈无处不清风。\n好分灵沼为膏泽，乞与人间作岁丰。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1480,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"中秋","author":"赵沨","text":"秋气平分月正明，蕊珠宫阙对蓬瀛。\n巳驱急雨消残暑，不遣微云点太清。\n帘外清风飘桂子，夜深凉露滴金茎。\n圣朝不奏霓裳曲，四海歌讴即乐声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1481,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题齐物堂","author":"赵沨","text":"至人识破浮生理，万变何尝有不同。\n果蝶梦周周梦蝶，为风乘我我乘风。\n得时未必全无识，穷处方知却有通。\n毕竟欲齐齐底物，世间元是一虚空。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1482,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"秋郊晚望","author":"赵沨","text":"桃竹犹堪杖，幽寻兴颇嘉。\n池荷能几叶，篱菊不多花。\n地坼成龟兆，林枯出犬牙。\n村农庆丰岁，社鼓巳三挝。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1483,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"元日","author":"赵沨","text":"马上逢元日，东风送客愁。\n滹沲春水渡，瀛海夕阳楼。\n雪照潘郎鬓，尘侵季子裘。\n劳生巳强半，更欲玷清流。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1484,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过良乡县学","author":"赵沨","text":"儒宫宜地僻，竟日有馀清。\n殿古碑仍在，庭空草自生。\n风高时脱木，云重欲摧城。\n客兴巳消洒，秋堂更雨声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1485,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和诜上人雪诗","author":"赵沨","text":"贫巷仍飞雪，空庭迥绝尘。\n照窗疑不夜，着树忽惊春。\n枕冷梦魂短，山明天宇新。\n赋诗分气象，定有灞陵人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1486,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"涧上","author":"赵沨","text":"远径留残照，疏林出小园。\n山川半豺虎，岁月且琴尊。\n杜老新鸡栅，庞公旧鹿门。\n不才真忝窃，人道典刑存。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1487,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"新凉","author":"赵沨","text":"颇觉小眠快，便知秋意真。\n清风论世旧，老圃得时新。\n移竹观君子，翻书访古人。\n可人陶靖节，随意葛天民。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1488,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过蓨县董大夫庙","author":"赵沨","text":"汉朝元不用真儒，岂信忠嘉益帝图。\n贾谊长沙晁错死，不须独恨老江都。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1489,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寓居写怀","author":"赵沨","text":"平陆温风雪半消，孤烟篱落隔溪桥。\n趁墟人去林皋静，时有晚鸦衔堕樵。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1490,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"醉后","author":"刘昂","text":"禅僧劝读传灯录，道士教行进火功。\n今日兴来俱破戒，黄花篱落醉西风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1491,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山中雨","author":"刘昂","text":"嵩高山下逢秋雨，破伞遮头过野桥。\n此景此时谁会得，清如窗下听芭蕉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1492,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"都门观别","author":"刘昂","text":"买酒消閒愁，剪刀剪流水。\n閒愁不可消，流水无穷已。\n悠悠窗下断肠波，总是行人堕泪多。\n门外马嘶思远道，小嚬犹唱渭城歌。\n歌声未断征鞍发，望断垂杨人影灭。\n斜阳照影却归来，两地相望今夜月。\n阅人多矣主人翁，离别都归一笑中。\n陌上行人终不悟，年年杨柳怨春风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1493,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"客亭","author":"刘昂","text":"折尽官桥杨柳枝，春风依旧绿丝丝。\n啼莺为向行人道，离别何时是尽时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1494,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山堂","author":"刘昂","text":"山雨溪边过，山堂夜独吟。\n悠悠松上月，照见壁间琴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1495,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"吊张维翰维中兄弟","author":"刘昂","text":"莲幕清曹粉署仙，福兮祸倚岂其天。\n座隅异物鵩来止，地底佳城马不前。\n万里青云今巳矣，两枝丹桂竟徒然。\n阿奴莫爱声名好，碌碌持家亦自贤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1496,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其一","author":"刘昂","text":"雨洗明河画扇收，胡床露冷药阑秋。\n墙阴未得中庭月，一点萤光草际流。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1497,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事二首 其二","author":"刘昂","text":"山花山雨相兼落，溪水溪云一样閒。\n野店无人问春事，酒旗风外鸟关关。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1498,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"歌风台","author":"刘昂","text":"刘顷兴亡转烛过，乱蝉吟破汉山河。\n长陵卧老咸阳月，沛上犹传击筑歌。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1499,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"吊李仲坦","author":"刘昂","text":"文章巧与世相违，身后新恩事巳非。\n不及萋萋原上草，一番春雨绿如衣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1500,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王官谷","author":"刘昂","text":"潜溪时照尘埃客，微雨不遮天柱峰。\n斜日落花人去尽，淡烟楼阁数声钟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1501,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送河南府尹张寿甫赴阙","author":"魏抟霄","text":"夜半恩纶出汉宫，朝家虚席待燕公。\n春风巳遍湖山外，元气还归鼎鼐中。\n侍从定谁陪白凤，低回空自惜冥鸿。\n洛川万顷蒲萄碧，长与清愁日夜东。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1502,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"田若虚游龙门宝应用天随子体赋诗因次其韵二首 其一","author":"魏抟霄","text":"少室右臂禹所断，开排清伊来高寒。\n土肉养石自古秀，山腰流泉无时乾。\n佛髻滴滴染湿翠，松风飕飕鸣惊湍。\n白傅巳矣不可见，予谁从之投归鞍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1503,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"田若虚游龙门宝应用天随子体赋诗因次其韵二首 其二","author":"魏抟霄","text":"阙塞若厩马，奔腾多奇厖。\n悫尔不可沮，西来何悾悾。\n骏足忽勒破，英才如拘庞。\n有客善体物，新诗留僧窗。\n晏辈岂足道，微澜生盆缸。\n径续杞菊意，来浮玻璃江。\n吏部昔窜谪，犹能题临泷。\n况此六大寺，磓堂时鸣桩。\n紫翠出万瓦，天风旋珠幢。\n兴寄百斛鼎，无才谁其扛。\n会听项籍约，吾将从之降。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1504,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"小雪","author":"刘涛","text":"黄紬被暖起还慵，小雪经檐落旋空。\n旧馆簿书宽半饷，冷官庭户满西风。\n马遭萁窘三山瘦，人坐诗工五鬼穷。\n安得东风嘱桃李，也教春色到衰翁。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1505,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和德卿雪","author":"刘涛","text":"南华香火是真依，不学呼鹰雪打围。\n梁苑旧游荒径改，颍滨新唱綵笺飞。\n春生东阁酣朝饮，寒入西邻泣夜机。\n梦寐扁舟钓江水，重嗟白发此心违。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1506,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"井陉","author":"刘涛","text":"寒压岁峥嵘，山阴日少晴。\n败眠鸡小梗，劝坐火多情。\n便面堪长路，牵头破老兵。\n谁教恋升斗，尽室此途行。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1507,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿平遥集福寺","author":"刘涛","text":"院僻和僧静，门閒与昼长。\n燕泥朝雨淖，蝶蕊晚风香。\n野兴煎诗思，乾愁绕客肠。\n青奴如解事，供我莫窗凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1508,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送王纯叔守曹州","author":"刘涛","text":"柏路人看御史骢，年来眼落簿书丛。\n单车乍别金銮月，五马频嘶玉勒风。\n故国山河连小郐，旧家鸡犬识新丰。\n遥知别夜诗成处，醉袖淋浪蜜炬红。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1509,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"戏用前人语题天平别墅","author":"刘涛","text":"表圣当年绢五千，休休亭下买林泉。\n黄华面目君还见，天柱峰高不直钱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1510,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"冷嵓公柳溪","author":"刘中","text":"斗印轻抛系肘金，故园风物动归心。\n柳含烟翠丝千尺，水写天容玉一寻。\n山色只于閒里好，风波不似向来深。\n人间桃李栽培满，换得溪南十亩阴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1511,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"龙门石佛","author":"刘中","text":"凿破苍崖已失真，又添行客眼中尘。\n请君看取他山石，不费工夫总法身。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1512,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"书州驿壁","author":"路铎","text":"雉堞俯已见，羊肠行尚难。\n炊烟界沮水，老木识桥山。\n畤废无人吊，台高有鸟还。\n客怀秋馆雨，未老鬓先斑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1513,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"庆寿寺晚归","author":"路铎","text":"九陌黄尘没马头，眼明佛界接仙洲。\n清溪照影红蕖晚，禅榻生凉碧树秋。\n少室宗风开木义，裕陵遗墨烂银钩。\n对谈不觉山衔月，只为松风更少留。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1514,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赋丈室碧玉壶善甫赋诗铎亦奉和二首 其一","author":"路铎","text":"心知云路等榆枋，戏作方壶当玉堂。\n虚静自应详止止，逍遥均是一苍苍。\n心含宝月无中外，身著青霞可颉颃。\n政尔天游到疑始，觉知谁送竹风香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1515,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赋丈室碧玉壶善甫赋诗铎亦奉和二首 其二","author":"路铎","text":"随人作计鱼千里，知命无忧鸟一天。\n碧落云深堪避世，九华烟暖可忘年。\n平章万有归玄览，收拾方心入大圆。\n上界真人自官府，不妨聊作橘中仙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1516,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"次韵答季通","author":"路铎","text":"华颠何意软红尘，霄汉聊收退鹢身。\n方喜长松倚东野，又从净社得遗民。\n高山流水知音少，霁月光风发兴新。\n赖有好诗相慰藉，不然开口欲谁亲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1517,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨中","author":"路铎","text":"月翳有时吐，风薰俄自清。\n云回暑天影，雨进夜窗声。\n眠听参天籁，神游得化城。\n觉来还故处，饥鼠撼灯檠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1518,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"辋川","author":"路铎","text":"画图风景是，亭榭岁年非。\n秋色半黄落，人烟深翠微。\n暗溪鱼得计，杳霭鸟忘机。\n触物增惆怅，吾庐早晚归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1519,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"高唐刘氏驻春园","author":"路铎","text":"风光去人无咫尺，人有尘劳不相及。\n此心既定境从之，雪树霜林亦春色。\n刘翁有道久陆沈，十年种树今成阴。\n醉乡天地白日永，鶗鴂栗留皆好音。\n良辰行乐今已矣，依旧东流泛兰芷。\n谁道青春挽不留，鲤庭看取新桃李。\n膏车秣马吾将归，誓与清景相追随。\n安用苦求三径资，明月常满千家墀。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":1520,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]