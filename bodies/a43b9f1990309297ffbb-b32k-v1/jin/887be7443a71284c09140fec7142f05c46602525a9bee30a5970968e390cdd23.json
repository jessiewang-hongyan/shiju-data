[{"title":"暮春用寒字韵二首 其一","author":"赵秉文","text":"柳阴彩舰系朱栏，楼外鞦韆搭画杆。\n祓禊人归池馆静，吹花风急皱波寒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":869,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"暮春用寒字韵二首 其二","author":"赵秉文","text":"一年芳物已阑珊，年少春愁为牡丹。\n村落人家雨前后，蓬窗罩纸护蚕寒。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":870,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"初闻雁","author":"赵秉文","text":"嘱尔南来新雁群，封书好寄未归人。\n天涯憔悴多风雪，回首中原又一春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":871,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宿遂初园","author":"赵秉文","text":"病身三日园亭主，自庆还须把一杯。\n犹胜西邻王学士，金门到老不曾来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":872,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"别春","author":"赵秉文","text":"年年春去归何处，今日须为别一番。\n把酒问花花不语，夜来风雨泪珊珊。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":873,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"贫士叹","author":"王若虚","text":"甑生尘，瓶乏粟，北风萧萧吹破屋。\n入门两眼何悲凉，稚子低目老妻哭。\n世无鲁子敬、蔡明远之真丈夫，故应饿死填沟谷。\n苍天生我亦何意，盖世功名实不足。\n试将短剌谒朱门，甲第纷纷厌梁肉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":874,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"白发叹","author":"王若虚","text":"清晨梳短发，巳见数茎白。\n妻拿惊且吁，谓我应速摘。\n我时笑而荅，区区亦何必。\n此身终委形，毁弃无足惜。\n况尔毛发閒，乃欲强修饰。\n毕竟满头时，复将安所择。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":875,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题渊明归去来图 其一","author":"王若虚","text":"靖节迷途尚尔赊，苦将觉悟向人誇。\n此心若识真归处，岂必田园始是家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":876,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题渊明归去来图 其二","author":"王若虚","text":"孤云出岫暮鸿飞，去住悠然两不疑。\n我自欲归归便了，何须更说世相遗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":877,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题渊明归去来图 其三","author":"王若虚","text":"抛却微官百自由，应无一事挂心头。\n销忧更借琴书力，借问先生有底忧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":878,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题渊明归去来图 其四","author":"王若虚","text":"得时草木竞欣荣，颇为行休惜此生。\n乘此乐天知浪语，看君于世未忘情。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":879,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题渊明归去来图 其五","author":"王若虚","text":"名利醉心浓似酒，贪夫衮衮死红尘。\n折腰不乐翻回去，此老犹为千载人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":880,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赵内翰求城南访道图诗辞不获巳乃作绝句以戏复为解之云 其一","author":"王若虚","text":"得道由来不必劳，痴儿舍父漫逋逃。\n闲闲老子还多事，时向伽蓝打一遭。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":881,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赵内翰求城南访道图诗辞不获巳乃作绝句以戏复为解之云 其二","author":"王若虚","text":"竹木萧森荫绿苔，幽襟自爱北轩开。\n主人无说吾何问，乘兴而来兴尽回。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":882,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"荅郑州辨禅师见戏代高防禦","author":"王若虚","text":"酒肆淫房即道场，一时作戏亦何妨。\n吾师自堕泥犁狱，更笑春风柳絮狂。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":883,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再致故园述怀五绝 其一","author":"王若虚","text":"日日天涯恨不归，归来老泪更沾衣。\n伤心何啻辽东鹤，不独人非物亦非。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":884,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再致故园述怀五绝 其二","author":"王若虚","text":"荒陂依约认田园，松菊存亡不必论。\n我自无心更怀土，不妨犹有未招魂。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":885,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再致故园述怀五绝 其三","author":"王若虚","text":"山杏溪桃化棘蓁，舞台歌馆堕灰尘。\n春来底事堪行处，门外流莺枉唤人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":886,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再致故园述怀五绝 其四","author":"王若虚","text":"回思梦里繁华事，幸及当年乐此身。\n闲立斜阳看儿戏，怜渠虚作太平人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":887,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"再致故园述怀五绝 其五","author":"王若虚","text":"艰危尝尽鬓成丝，转觉繁华不可期。\n几度哀歌仰天问，何如还我未生时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":888,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山谷于诗每与东坡相抗门人亲党遂谓过之而今之作者亦多以为然予尝戏作四绝云 其一","author":"王若虚","text":"骏步由来不可追，污流馀子费奔驰。\n谁言直待南迁后，始是江西不幸时。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":889,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山谷于诗每与东坡相抗门人亲党遂谓过之而今之作者亦多以为然予尝戏作四绝云 其二","author":"王若虚","text":"信手拈来世巳惊，三江滚滚笔头倾。\n莫将险语誇勍敌，公自无劳与若争。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":890,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山谷于诗每与东坡相抗门人亲党遂谓过之而今之作者亦多以为然予尝戏作四绝云 其三","author":"王若虚","text":"戏论谁知是至公，蝤蛑信美恐生风。\n夺胎换骨何多样，都在先生一笑中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":891,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"山谷于诗每与东坡相抗门人亲党遂谓过之而今之作者亦多以为然予尝戏作四绝云 其四","author":"王若虚","text":"文章自得方为贵，衣钵相传岂是真。\n巳觉祖师低一著，纷纷法嗣复何人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":892,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王子端云近来徒觉无佳思纵有诗成似乐天其小乐天甚矣予亦尝和为四绝 其一","author":"王若虚","text":"功夫费尽漫穷年，病入膏肓不可镌。\n寄语雪溪王处士，恐君犹是管窥天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":893,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王子端云近来徒觉无佳思纵有诗成似乐天其小乐天甚矣予亦尝和为四绝 其二","author":"王若虚","text":"东涂西抹斗新妍，时世梳妆亦可怜。\n人物世衰如鼠尾，后生未可议前贤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":894,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王子端云近来徒觉无佳思纵有诗成似乐天其小乐天甚矣予亦尝和为四绝 其三","author":"王若虚","text":"妙理宜人入肺肝，麻姑搔痒岂胜便。\n世閒笔墨成何事，此老胸中具一天。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":895,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王子端云近来徒觉无佳思纵有诗成似乐天其小乐天甚矣予亦尝和为四绝 其四","author":"王若虚","text":"百斛明珠一一圆，丝毫无恨彻中边。\n从渠屡受群儿谤，不害三光万古悬。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":896,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宫女围棋图","author":"王若虚","text":"尽日羊车不见过，春来雨露向谁多。\n争机决胜元无事，永日消磨不柰何。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":897,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"摅愤","author":"王若虚","text":"非存骄謇心，非徼正直誉。\n浩然方寸閒，自有太高处。\n平生少偕合，举足逢怨怒。\n礼义初不愆，谤讪亦奚顾。\n孔子自知命，桓魋非所惧。\n孟轲本不逢，岂为臧氏沮。\n天命有穷达，人情私好恶。\n以此常泰然，不作身外虑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":898,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠王士衡","author":"王若虚","text":"王生非狂者，乃以善哭称。\n每至欲悲时，不閒醉与醒。\n音词初恻怆，涕泗随纵横。\n问之无所言，坐客笑且惊。\n王生不暇恤，若出诸其诚。\n嗟我与生友，此意犹未明。\n丝染动墨悲，麟亡伤孔情。\n韩哀峻岭陟，阮感穷途行。\n涕流贾太傅，音抗唐衢生。\n古来哭者多，其哭非吾名。\n生其偶然欤，何苦摧神形。\n如其果有为，为尔同发声。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":899,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"感秋","author":"王若虚","text":"西风撼庭柯，疏叶鸣策策。\n天地一萧条，羁怀亦岑寂。\n青春恍如昨，转盻年半百。\n自从长大来，转觉日月迫。\n功名非所慕，老大不足恤。\n怛然感时心，自亦不能释。\n清晨梳短发，巳见数茎白。\n刀镊虽可施，殆似儿子剧。\n此身委蜕耳，毁弃无足惜。\n况于毛发閒，而乃强脩饰。\n青青如陆展，星星行复出。\n毕竟白满头，复将何所摘。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":900,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"生日自祝","author":"王若虚","text":"空囊无一钱，羸躯兼百疾。\n况味何萧条，生意浑欲失。\n清晨问喧呼，亲旧作生日。\n我初未免俗，随分略脩饰。\n举觞聊自祝，醉语尽情实。\n神仙恐无从，富贵安可必。\n脩短卒同归，何足喜与戚。\n一祈粗康强，二愿早闲适。\n衣食无大望，但要了晨夕。\n万事不我撄，一心常自得。\n优游终吾身，志愿从此毕。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":901,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"失子","author":"王若虚","text":"妍妍掌中儿，舍我一何遽。\n其来谁使之，而复奄然去。\n平生三举子，随灭如朝露。\n顾我能无悲，其如天有数。\n自从学道来，众苦颇易度。\n有后固所期，诚无亦何惧。\n人生得清安，政以累轻故。\n婚娶眼前劳，记遗身后虑。\n百年曾几何，为此雏稚误。\n顾语长号妻，此理亦应谕。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":902,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"复寄 其一","author":"王若虚","text":"志大言高与世违，拂衣真作竹林归。\n黄尘道口风波恶，未必先生自处非。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":903,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"复寄 其二","author":"王若虚","text":"自笑趋尘自强颜，食谋未免敢言闲。\n紫芝果可充饥腹，从子玉屏岩石间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":904,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"病中 其一","author":"王若虚","text":"学道今何得，谋生久不成。\n蓝衫几弃物，绛帐亦虚名。\n事拙应天意，交疏即世情。\n烦忧时自解，感触又还生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":905,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"病中 其二","author":"王若虚","text":"郁郁穷愁意，营营久病身。\n诗情浑欲减，药物但相亲。\n未得驱穷鬼，终须问大钧。\n三时劳慰抚，甚愧故人真。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":906,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"感怀","author":"王若虚","text":"枉却全家仰此身，书生那是治生人。\n百忧耿耿填胸臆，强作欢颜慰老亲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":907,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"自笑","author":"王若虚","text":"酒得数杯还巳足，诗过两韵不能神。\n何须豪逸攀时杰，我自世间随分人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":908,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"别家","author":"王若虚","text":"到了身安是本图，何须身外觅浮虚。\n谁能置我无饥地，却把微官乞与渠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":909,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"慵夫自号","author":"王若虚","text":"身世飘然一瞬间，更将辛苦送朱颜。\n时人莫笑慵夫拙，差比时人得少闲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":910,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西城赏莲呈晦之","author":"王若虚","text":"旧赏回头已隔年，高花又见出新妍。\n偶成浊酒狂歌会，恰又斜风细雨天。\n乐事适来偏有兴，闲身当得分无缘。\n作诗莫怪多誇语，差比放翁先著鞭。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":911,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"高阳道中","author":"刘汲","text":"杏花开过野桃红，榆柳中间一径通。\n禽鸟不呼村坞静，满川烟雨淡濛濛。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":912,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"丙子夏卧病汗后有作","author":"赵元","text":"枯肠得水若通灵，涣汗周身一雨零。\n行客筋骸困方歇，醉人心骨唤初醒。\n病蝉移梦入新壳，老鹤息神梳旧翎。\n乞得残骸对儿女，不愁无粟贮陶瓶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":913,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"蓦山溪","author":"金山","text":"苍苍千仞，看大江东注。\n昼夜走蛟龙，喜金山、不随波去。\n潮生潮落，不识几何年，京口驿，瓜洲渡。\n南北虚舟路。\n风流苏子，暇日寻僧语。\n解带镇山门，谈笑间、禅床何处。\n妙高台上，听水调歌头，月横江，风满树。\n搔首青天暮。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":914,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"咸阳怀古","author":"李庭","text":"连鸡势尽霸图新，兀兀宫墙压渭滨。\n指鹿只能欺二世，沐猴那解定三秦！\n倚天楼观馀焦土，落日河山几战尘。\n今古悠悠同一辙，不须作赋吊前人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":915,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过太原赠高天益","author":"王遵古","text":"辽海渺千里，风尘今二毛。\n心能如笔正，官不称才高。\n筦库非君事，山林必我曹。\n相期老乡国，拂石弄云璈。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":916,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"野菊","author":"王庭坚","text":"斗鸡台下秋风里，白白黄黄无数花。\n日暮城南城北道，半随榛棘上樵车。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":917,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"失题","author":"王明伯","text":"钓鳌公子铁心胸，兴在三山碧海东。\n千尺云帆己高揭，不知何日得秋风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":918,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晓云次子端韵","author":"党怀英","text":"滦溪经雨浪生花，晓碧翻光漾晓霞。\n川上风烟无定态，尽供新意与诗家。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":919,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"利涉道中寄子端","author":"周昂","text":"行武昌，望利涉。\n高青烟，低白雪，冈陵瀰漫沟浍灭。\n氤氲冷日从东来照我，清影忽作溪水卧明月。\n凌兢羸马猬毛缩，诘曲微行蛇腹裂。\n遗鞭脱镫初不知，指僵欲堕骨欲折。\n毡裘毛袜良可念，我自无备谁从辍。\n人家土榻借微暖，坐久清冰落须颊。\n黄花臞仙怯风驭，久向笙歌窟中蛰。\n径须持此远相饷，一洗夜堂花酒热。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":920,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王子端挽辞","author":"路铎","text":"才名如此不偿穷，再入承明一病翁。\n白发光阴文字里，黄华林麓画图中。\n谪仙犹想屋梁月，荆产空怀松下风。\n聊应世缘缘故在，会看归鹤语辽东。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":921,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"挽黄华诗","author":"冯璧","text":"诗名摩诘画绝世，人品右军书入神。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":922,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"子端山水同裕之赋","author":"李纯甫","text":"辽鹤归来万事空，人间无地著诗翁。\n只留海岳楼中景，长在经营惨淡中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":923,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"哭黄华","author":"李纯甫","text":"士价五羊皮，人生黍一炊。\n盖棺那可忍，挂剑不胜悲。\n向上谁曾到，而今渠得知。\n侍臣伤立本，老姥怒羲之。\n作病无如酒，穷愁正坐诗。\n中郎犹有女，少傅竟无儿。\n散落真行帖，飘零骚雅辞。\n儒林顿憔悴，未敢哭吾私。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":924,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"黄华画古柏","author":"密璹","text":"黄华老人画古柏，铁简将军挽大弨。\n意足不求颜色似，荔支风味配江瑶。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":925,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题黄华江皋烟树二首 其一","author":"雷渊","text":"疏柳静茅亭，亭下长江路。\n不见亭中人，萧萧烟景莫。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":926,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题黄华江皋烟树二首 其二","author":"雷渊","text":"江山万里眼，一亭略约之。\n黄华未死在，看出画中诗。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":927,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题子端雪溪小隐图","author":"张行简","text":"出处皆天岂自由，仙标终合冠鳌头。\n不妨貌取黄华景，时向铃斋作卧游。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":928,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题黄华幽居图","author":"李献甫","text":"层层佛屋贴山腰，山下幽居胜午桥。\n物外人家无税后，閒中生理足渔樵。\n雁踰远障凌虚迥，人与高秋共寂寥。\n何处人间景如此，便应归隐不须招。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":929,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"王元仲海岳楼同诸公赋","author":"王珦","text":"十二朱栏倚半空，元龙高卧定谁雄。\n檐楹翠湿蓬山雨，枕簟凉生弱水风。\n物色横陈诗卷里，云涛飞动酒杯中。\n谪仙会有骑鲸便，八极神游路可通。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":930,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日月中对菊同禧伯郎中赋六首 其一","author":"张本","text":"花上清光花下阴，素娥惜此万黄金。\n一杯寒露三更后，谁信幽人更苦心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":931,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日月中对菊同禧伯郎中赋六首 其二","author":"张本","text":"九日馀香伴月明，一觞亦足畅幽情。\n青楼夜半琵琶语，不说人间有此清。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":932,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"九日月中对菊同禧伯郎中赋六首 其三","author":"张本","text":"子山牢落去江南，赋主悲哀尚一堪。\n只恐秋天闻亦苦，并催红雨下霜岩。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":933,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"观音阁","author":"玫璨章","text":"壮心期不负今游，大士相招到上头。\n仙境岂容人久坐，非因崄巘不能留。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":934,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"河决开封有怀洪生彦先","author":"金贡","text":"饥饿出门去，偏逢河决时。\n存亡浑未卜，生死况分离。\n怜尔尚年少，如何辞故枝。\n征衣傥无恙，须早定归期。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":935,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"吊李仲坦","author":"刘昂","text":"文章巧与世相违，身后新恩事已非。\n不及萋萋原上草，一番春雨绿如衣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":936,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赐石右相琚生日之寿","author":"完颜允恭","text":"黄阁今姚宋，青宫旧绮园。\n绣絺归里社，冠盖画都门。\n善训怀师席，深仁寄寿尊。\n所期河润溥，馀福被元元。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":937,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"阙题","author":"完颜允恭","text":"心与寥寥太古通，手随轻籁入天风。\n山长水阔无寻处，声在乱云空碧中。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":938,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]