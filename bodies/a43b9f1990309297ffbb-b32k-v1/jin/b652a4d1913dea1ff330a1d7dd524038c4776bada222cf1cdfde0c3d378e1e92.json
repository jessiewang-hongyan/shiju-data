[{"title":"侯相浪溪岁寒堂","author":"赵思文","text":"静中台榭隔红尘，水色山光日日新。\n不用沿溪种松竹，主人元是岁寒人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2278,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"捕蝗感草虫有作二首 其一","author":"赵思文","text":"虽是形模不苦争，汝能伤稼我能鸣。\n谁知竟有长平祸，玉石填来共一坑。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2279,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"捕蝗感草虫有作二首 其二","author":"赵思文","text":"草虫悲咽不能言，乱逐螟蝗瘗古原。\n水底痴龙正贪睡，瓮中蝎虎更衔冤。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2280,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"嵩山承天谷又云逍遥谷","author":"赵思文","text":"烟霞直上逍遥谷，路转山腰咫尺迷。\n已觉洞天分圣境，更疑石磴是仙梯。\n霜添红叶黄花好，天与金壶玉柱齐。\n醉倚西风正南望，暮云烟草一时低。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2281,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"吊同年杨礼部之美","author":"赵思文","text":"海内文章选，人中道德师。\n争教衰病足，不到凤皇池。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2282,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"留别","author":"李芳","text":"禄食愧踰量，智困念归愚。\n符竹恒为累，幸及引年初。\n驱马国西门，初服返田庐。\n金闺富才彦，绝足駃高衢。\n眷我谢朝迹，冠盖宠归途。\n归途岂不荣，顾瞻亦踟蹰。\n煌煌丹山凤，览德萃清都。\n行人得栖止，老鹤青天孤。\n石楼俯清伊，旁有野人居。\n傥逢经过便，山水足相娱。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2283,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"零口早行","author":"刘昂","text":"马上兀残梦，沉沉天向晨。\n行云如妒月，古道不逢人。\n野旷耕声远，山高露气新。\n哦诗无好语，聊尔一吟呻。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2284,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读三国志二首 其一","author":"刘昂","text":"虎视鲸吞卒未休，一时人物尽风流。\n妇翁正得黄承彦，儿子当如孙仲谋。\n乳臭蒙孙真寄坐，齿寒邻国莫分忧。\n阿瞒狐媚无多罪，谁作桓文得到头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2285,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读三国志二首 其二","author":"刘昂","text":"泣汉遗黎血未乾，繁昌新筑受终坛。\n天球宝鼎私臧获，坎井拗堂局凤鸾。\n地易主宾穷赤壁，势成螳雀事乌丸。\n陈言衮衮令人厌，枉就输棋覆旧槃。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2286,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪中同周臣内翰赋二首 其一","author":"王仲元","text":"天上端花散不收，温温叶气浃皇州。\n横溪月澹梅宜腊，平野风閒麦有秋。\n清兴雅高东武会，孤吟谁似灞陵游。\n西山玉立三千丈，好句都输赵倚楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2287,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雪中同周臣内翰赋二首 其二 雪","author":"王仲元","text":"初稀时拂拂，稍密自纷纷。\n老树晓迷月，瘦峰寒帖云。\n色从空际得，声向静中闻。\n客枕清无梦，哦诗彻夜分。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2288,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"赠青柯平隐者","author":"王仲元","text":"太华神明观，青柯小有天。\n大哉霄壤内，无此弟昆贤。\n齐物三千行，栖云二百年。\n初平初起后，又得两臞仙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2289,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"白沟","author":"卢洵","text":"白沟清浅不容舟，辽宋封疆限此沟。\n到了山河无定主，碧波依旧只东流。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2290,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"渭水","author":"刁白","text":"渭水秋天白，骊山晚照红。\n行人迷古道，老马识新丰。\n霜雪满归鬓，乾坤犹转蓬。\n愁来成独酌，醉袖障西风。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2291,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"物质","author":"刁白","text":"物质方圆定，营营止自疲。\n鹤凫伤断续，鹏鴳失高卑。\n巧宦多成拙，徐行未必迟。\n可怜筝上雁，来往听人移。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2292,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送花","author":"刁白","text":"纵横诗酒少年曾，老矣追欢谢不能。\n种出好花无用处，东邻乞与坐禅僧。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2293,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"寄陈正叔雷希颜","author":"刘光谦","text":"东南形胜古徐州，人物休评第几流。\n落落陈雷天下士，故应连榻卧黄楼。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2294,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题崞县郝子玉此君轩","author":"毛端卿","text":"桂林名姓一枝新，万竹青青德有邻。\n渭上风烟分别派，山阳诗酒属閒人。\n心期已到冰霜窟，眼界不知花柳尘。\n萱背从今看辉映，嫩香新粉四时春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2295,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"按部南阳有赠","author":"康锡","text":"鲁山佳政沾邻邑，白水欢谣见路人。\n县务清谈君自了，农郊夙驾我何勤。\n星河直上冰轮转，桃李前头玉树春。\n海㝢疲民望他日，草堂那得遽移文。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2296,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"叔能见过","author":"张德直","text":"度岭千峰阔，沿溪一径微。\n山寒花发晚，村迥客来稀。\n强饮酬佳节，悲歌送夕晖。\n平生爱欢聚，衰病与心违。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2297,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"雨后","author":"冯辰","text":"东风花外锦鸠啼，唤起西山雨一犁。\n绿满蔬畦人不到，桔槔閒立夕阳低。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2298,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"过华州","author":"王世昌","text":"拔地三峰冷翠微，落岩飞瀑喷珠玑。\n吟鞭落托骑驴过，战刃韬藏牧马归。\n十丈玉莲秋不谢，半楞掌月昼还飞。\n地灵人杰无遗逸，未分蟠螭老布衣。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2299,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"方城东寺海棠","author":"王世昌","text":"苦茝如针草有芒，桃花轻薄絮颠狂。\n少陵例有诗沾丐，只枉无言到海棠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2300,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读公孙?传","author":"李过庭","text":"古来好客数平津，我道真龙未必真。\n一个仲舒容不得，不知开閤为何人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2301,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"牧牛图","author":"田锡","text":"干戈扰扰遍中州，挽粟车行似水流。\n何日承平如画里，短蓑长笛一川秋。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2302,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"故县别业","author":"田锡","text":"九折驱车梦易惊，一廛老计喜初成。\n园蔬不借将军地，宅券何劳宰相名。\n山入平檐供远翠，水环钓石得深清。\n漫郎聱叟琦玕子，谁悟他生与此生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2303,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"读天宝遗事","author":"张介","text":"不但昨非今亦非，上皇骑马泪沾衣。\n曲江死后无忠谏，却忆词人秋雁飞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2304,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"终南溪","author":"庞汉","text":"冷云低压万长杨，十顷秋阴锁北堂。\n门外兵尘涨秦楚，水边烟景似湖湘。\n荷翻山雨僧窗晚，竹汎溪风客枕凉。\n早晚初平遂真隐，绕陂閒牧石头羊。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2305,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"河阴望河朔感寓一首","author":"宋景萧","text":"南来边报日骎骎，思禹亭高泪满襟。\n野烧为谁留白草，荒城空自隔疏林。\n雁声不断天连水，山色无情古又今。\n离合兴亡只如此，往年争识少陵心。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2306,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春雪用上官明之韵","author":"宋景萧","text":"啑啑春虫闹扑窗，地炉茶鼎蚓声长。\n诗中有味清于酒，只欠冰梢数点香。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2307,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"还家三首 其一","author":"李天翼","text":"幽花杂草满城头，华屋唯残土一丘。\n乡社旧人何处在，语音强半是陈州。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2308,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"还家三首 其二","author":"李天翼","text":"牡丹树下影堂前，几醉春风谷雨天。\n二十六年浑一梦，堂空树老我华颠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2309,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"还家三首 其三","author":"李天翼","text":"殊音异服不相亲，独倚荒城泪满巾。\n秪有青山淡相对，似怜我是此乡人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2310,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"积雨","author":"张澄","text":"积雨生顽痹，新晴意自怡。\n幽花依小径，野蔓媚疏篱。\n发少从梳懒，年衰与杖宜。\n腐儒惭用拙，粝食复何辞。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2311,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和林秋日感怀寄张丈御史二首 其一","author":"张澄","text":"塞草枯黄秋未残，北风裘褐日生寒。\n田园政忆遂初赋，冰雪莫吟行路难。\n囊颖露锥徒自苦，蒯缑有剑秪空弹。\n南窗明暖无尘到，惭愧高人老鹖冠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2312,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"和林秋日感怀寄张丈御史二首 其二","author":"张澄","text":"别家六见月牙新，万里风霜老病身。\n块坐毡庐心悄悄，远怀茅屋梦频频。\n瓜田无取终成谤，市虎相传久是真。\n乡国归程应岁暮，火炉煨栗话情亲。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2313,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"辊马图","author":"张澄","text":"飞堑乘城力亦优，不应伏枥便垂头。\n而今世上无良乐，兀兀黄尘辊得休。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2314,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春柳应制得城字","author":"刘微","text":"翠纽圆匀绿线轻，著行排立弄新晴。\n更看三月春风里，散作飞花满凤城。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2315,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送同舍张耀卿补掾中台","author":"郭宣道","text":"摩云头角看昂藏，意外升沉岂易量。\n取士皆知有科举，进身初不在文章。\n关心雁塔功名晚，试手乌台岁月忙。\n此去一官先有路，独怜灯火夜窗凉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2316,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"下第","author":"张仲宣","text":"主司头恼旧冬烘，更著书郎骨相穷。\n晓赋得官何足道，直须遮马困吴融。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2317,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"戏题石鹿蜂猴画卷","author":"张仲宣","text":"横槊将军马足尘，判花学士笔头春。\n功名果属丹青手，造物如何戏得人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2318,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"阙题","author":"胡汲","text":"休笑参军靴不袜，休嗟门客食无鱼。\n燕鸿来去端谁使，鹏鴳逍遥本自如。\n潦倒渊明三径菊，荒唐惠子五车书。\n古人淡里求真味，身外纷华不羡渠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2319,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"黄叶行送祖唐臣归柘县","author":"王修龄","text":"送君黄叶山，黄叶纷不埽。\n上有萧萧之风树，下有漫漫之衰草。\n山中黄叶行复青，髀肉一消人自老。\n酒尽意不尽，执手临古道。\n古道连延走锦襄，锦襄日暮浮云翔。\n一灯孤馆相思处，寒雁一声秋夜长。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2320,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"三河道中","author":"王枢","text":"十载归来对故山，山光依旧白云閒。\n不须更读元通偈，始信人间是梦间。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2321,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"暮春","author":"赵晦","text":"压枝梅子半青黄，叶底残红雨褪香。\n翠钿舞风榆落荚，绿针浮水稻抽秧。\n酒浓犹觉春酲困，睡美方便午梦长。\n苦被啼莺诉花老，挥毫聊作送春忙。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2322,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"立春后十日登楼","author":"王世赏","text":"今日登楼眼，风烟倍觉新。\n溪梅初破萼，屋雪半融银。\n雁外天逾碧，鸥边水自春。\n儿曹应见笑，吟望独伤神。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2323,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春雪","author":"王世赏","text":"只谓春天暖，宁知雪霰飞。\n龙蛇且深蛰，花柳不胜威。\n糁糁凌风细，纷纷带雨稀。\n谁当问穹昊，生杀果何机。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2324,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"探梅","author":"王世赏","text":"候得南枝破玉腮，心颜今日为君开。\n细看苔径无行迹，先赏应输我独来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2325,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"称善斋","author":"王世赏","text":"宦途驰逐只堪羞，何意须封万户侯。\n平日少游真可念，绝胜辛苦驻壶头。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2326,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"西子放瓢图","author":"靖天民","text":"髻鬟萧飒苧萝秋，千古香溪水自流。\n吴越兵争竟何得，风流输与五湖舟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2327,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"白发","author":"桑之维","text":"白发近年见，十中三两茎。\n半因愁攒出，多为病添成。\n梳里有时落，镊馀还又生。\n老知无可避，何处是功名。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2328,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"下第过榆次","author":"步元举","text":"栖迟零落未归人，已坐无成更坐贫。\n意气敢论题柱客，晨昏多负倚门亲。\n囊空渐觉钱馀贯，衣敝翻饶虱满身。\n遥望秦关独惆怅，一天风雨落花春。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2329,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"客舍","author":"冯文叔","text":"秃襟纳褐破书囊，十五年来客异乡。\n生事阱中摇虎尾，穷途天上转羊肠。\n三朝不遇冯唐老，半夜悲歌宁戚狂。\n独倚牛车望辽海，西风尘土鬓苍苍。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2330,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"即事","author":"张庭玉","text":"乌鸢绕树山梨熟，蝴蝶穿花木槿开。\n赤脚城中借米去，苍头原上负薪来。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2331,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"宝岩僧舍","author":"宗道","text":"寂寂钟鱼柏满轩，午风轻飏煮茶烟。\n西堂竟日无人到，只许山人借榻眠。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2332,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"鲁村道中","author":"鲜于溥","text":"小桥沙路已堪图，更著衰翁跨蹇驴。\n暮霭似催寒日短，秋容仍带远林疏。\n雕盘平野黄榆落，兔走横冈白草枯。\n渐喜閒身远朝市，一年强半在村墟。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2333,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"春日仿旧诗体","author":"鲜于溥","text":"年老逢春莫等閒，逢春能得几回看。\n插花尽要花枝满，把酒休辞酒盏乾。\n好向酒边留舞袖，不妨花外驻吟鞍。\n闻身健在须行乐，燕语莺啼春又残。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2334,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"早发","author":"鲜于溥","text":"灯前梦断家千里，马上诗成月一痕。\n晨粥未烹官路远，隔林烟火是渔村。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2335,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"超化","author":"史士举","text":"石根寒溜迸珠玑，寻丈惊看雪浪飞。\n我是玉川烟水客，暂来盘礴亦忘归。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2336,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"晋祠","author":"史士举","text":"小桥流水竹萧森，竹里人家一径深。\n只欠东风小篱落，梅花疏淡月笼阴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2337,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"同东岩元先生论诗","author":"王敏夫","text":"林逋仙去几来年，惊见梅花第二篇。\n千岁冰霜松骨瘦，九秋风露鹤声圆。\n腾辉定出连城上，得趣知从太古前。\n邂逅茅斋话终夕，只疑人世改桑田。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2338,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"李氏友云楼","author":"王敏夫","text":"雾幕烟迷十二栏，壶觞招我一跻攀。\n黄帘卷起湘川竹，分得西州数点山。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2339,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"题扇头","author":"王利宾","text":"轻纱画竹雀，柄短不盈握。\n暑气正凭陵，清风一何邈。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2340,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送张安中还云中","author":"孙益","text":"相送还相送，临分手重分。\n骅骝欣得路，鸿雁惜离群。\n木落黄华露，城低紫塞云。\n中秋月正好，千里漫思君。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2341,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送门生赴省闱","author":"郝天挺","text":"青出于蓝青愈青，小年场屋便驰声。\n未饶徐淑早求举，却笑陆机迟得名。\n嗟我再衰空眊氉，喜君初筮已峥嵘。\n此行占取鳌头稳，平地烟霄属后生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2342,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"烧笋","author":"孙邦杰","text":"煨茁旧闻山谷语，劝耕还忆大苏诗。\n传将火候无多诀，留得天真又一奇。\n未放锦绷开束缚，已看玉版證茶毗。\n白麻初拜惊烧尾，见此应惭富贵痴。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2343,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"送侯道士","author":"张瓛","text":"十年走南北，黄尘污人衣。\n翩翩夜啼乌，一枝无可依。\n问君何所如，凫舄东南飞。\n恨我不得往，失脚阱与机。\n从君知不能，一笑人间非。\n何水无蒲鱼，何山无蕨薇。\n终当拂衣去，往叩云山扉。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2344,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"龙门","author":"徐好问","text":"疏凿而来道路通，行人万古翠微中。\n南山山寺题诗满，一字何曾到禹功。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2345,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"夏日","author":"吕大鹏","text":"旋移石枕拂藤床，细洒槐阴趁晚凉。\n大地嗷嗷困炉鼎，老天不肯下残阳。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2346,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"跋贾天升所藏段志宁山水","author":"高永","text":"苍壁云气涌，长松风雨寒。\n湍流擘山出，玉虹饮溪湾。\n胸中无云梦，笔底无江山。\n想见破墨初，布袖蛟龙蟠。\n壮观骇心魄，万象本自閒。\n寒斋静相对，远意空追攀。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2347,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"忆旧","author":"曹用之","text":"花鸟巡檐唤晓晴，唤来和气满春城。\n春风二十年前客，煮酒青梅也后生。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2348,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}},{"title":"红梅","author":"赵达夫","text":"西湖句好已成尘，蜡点都能几许春。\n乞与琼儿薄梳洗，才情留待月中人。","collection":"金","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"金.csv","pointer":2349,"sha256":"724ca7dd3a8c08bfe97f7192826eb2a445ec85c4fac0eab34147ef577ba45ec0","dynasty":"金"}}]