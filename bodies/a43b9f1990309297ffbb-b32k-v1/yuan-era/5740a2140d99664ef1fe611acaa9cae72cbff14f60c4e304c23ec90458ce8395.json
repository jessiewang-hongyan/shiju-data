[{"title":"寄周平叔就求苍耳子","author":"成廷圭","text":"周侯久不通书问，夜夜沧江入梦频。\n五月采来苍耳子，几时分送白头人。\n沙头酒熟田毛足，港上船来海错新。\n南北相望千百里，老来幽独倍伤神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再题郜彦清万壑松涛","author":"成廷圭","text":"秋入空山万窍鸣，山前山后乱潮生。\n不知天籁非人籁，却认风声似海声。\n直干也随羊角旋，高枝唯恐鹤巢倾。\n毕宏韦偃还听否，惨淡经营画得成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台晚望","author":"成廷圭","text":"野色苍茫落照中，荒台扶杖倚秋风。\n延陵百里吴封旧，震泽三江禹迹空。\n浊酒更须浇磊磈，黄金不解铸英雄。\n侧身北望中原近，几处神州正朔同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送谢太守平江省亲回武林就送鹅酒之贶","author":"成廷圭","text":"五马既秣车载脂，上堂欲别还迟迟。\n拜家已得阿母喜，还郡即慰邦人思。\n几年东阁旧倾盖，今日西湖谁赋诗。\n野翁惭无一字补，辄敢笼鹅临墨池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张师廉归富春","author":"成廷圭","text":"读书不逢万乘尊，献策岂傍诸侯门。\n放歌苏台晚山碧，濯足太湖秋水浑。\n千金未易买骏骨，一饭何足哀王孙。\n风尘拂衣且归去，高卧桐江云水村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题海上积善庵水竹轩","author":"成廷圭","text":"水阁云廊深复深，开轩绿雾常阴阴。\n凉宵濯足月在港，清昼读书风满林。\n食笋也胜鱼肉味，截筒谁作凤凰吟。\n清凉更在声尘外，夜夜海潮生妙音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题何永孚瓶斋","author":"成廷圭","text":"井湄须问扬雄酒，松下空藏智永书。\n一日挈之来市肆，百年将汝置斋居。\n龙泉旧物魁名在，鹤发仙翁手泽馀。\n我亦有瓶谁抚玩，新诗题罢转愁予。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月久阴十日甲子复大雨","author":"成廷圭","text":"七月十日甲子雨，彻夜檐溜无休时。\n野老惊呼后土湿，秋田仰望皇天慈。\n饥乌觅食亦散漫，病鹤顾影空缡?。\n青泥没屐不可出，虾菜何以供晨炊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄冈贾彦德碧梧轩","author":"成廷圭","text":"贾谊井西梧十寻，百年秀发根株深。\n银床分润长新叶，翠竹交枝成好音。\n季春花香自零落，高秋雨气相萧森。\n何当临轩坐白石，为子再歌孤凤吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题松江徐君瑞柳堂","author":"成廷圭","text":"稚柳一岁高于母，濯濯风流健似人。\n九烈效灵连送客，三眠扶起并留春。\n状如车盖生来异，色比宫袍染更新。\n入对长杨应未晚，马前飞絮扑香尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送韩仲让都司梁溪督兵防秋","author":"成廷圭","text":"今人勋业古人心，立马梁溪恨满襟。\n兵谶谩传山有锡，军装端信橐无金。\n风高古垒黄花晚，霜落平原白草深。\n南省相君方倚重，边廷穷虏敢相侵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺毅刚中长老住承天禅寺诗二首 其一","author":"成廷圭","text":"十刹亲题请疏开，法筵击鼓动春雷。\n自离南楚传灯后，重为东吴倡道来。\n两柱承天行日月，六鳌从地涌楼台。\n灵山诸佛生欢喜，散作祥风遍九垓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺毅刚中长老住承天禅寺诗二首 其二","author":"成廷圭","text":"海上东来转法轮，祖衣传久色逾新。\n携将天目山中雨，洒向蛾眉石上尘。\n行道要从无佛处，开堂须著有缘人。\n等閒拈出菩提子，百草千花不当春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月一日寄谢太守","author":"成廷圭","text":"出入侯门五见春，每承分粟济清贫。\n托交独喜君知我，临老犹将子累人。\n公论几时令捧檄，私恩有日效扶轮。\n鱼书一札珍藏在，白发西湖愿卜邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢王左丞鹅酒之惠","author":"成廷圭","text":"深巷曾经显者过，春风披拂到松萝。\n右军墨沼笼鹅在，左相官瓶送酒多。\n乡井未忘生处乐，江湖犹赋醉时歌。\n阶墀久不投名刺，奈此衰翁老病何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题觉报寺茂元长老白云窝","author":"成廷圭","text":"白云窝里烂如银，不住虚空着幻身。\n趺坐也教龙入定，巢居还许鹤为邻。\n自缘色界闲来往，谁与天香作主宾。\n若问吾家安乐法，老夫曾学避秦人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送松江朱焕章之乌程令尹","author":"成廷圭","text":"新除令尹乌程去，霜落湖田十月初。\n貂帽锦衣怀印绶，青帘白舫载图书。\n到官先谒将军府，省俗仍陪太守车。\n东望吴淞三百里，莫因莼鲙赋归欤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题元上人怡云轩","author":"成廷圭","text":"白云本是山中物，暂与山僧作主宾。\n尔解自舒还自捲，我能无喜亦无嗔。\n半间莫惜分馀地，一笼犹思赠远人。\n句曲有家空在望，卜居何日许为邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王唯贤东里草堂","author":"成廷圭","text":"平安一桥吾旧游，君屋乃在桥东头。\n晚山得月更宜酒，春水到门还放舟。\n太守诗成写素壁，老夫兴发思沧洲。\n淮南丛桂不得往，抚卷因之生远愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送黄观澜尚书吴伯尚廉使之江西征讨 其一","author":"成廷圭","text":"白发儒臣著武冠，公卿相送出朝端。\n恭承斧钺行天讨，喜见旌旗拥夏官。\n直北声名从此振，平南筹策有人看。\n虎皮会见包戈甲，十郡苍生奠枕安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送黄观澜尚书吴伯尚廉使之江西征讨 其二","author":"成廷圭","text":"江西寇盗本王民，正赖诸公为解纷。\n使者精忠悬白日，尚书高义抗浮云。\n喜传天上旌旗出，肯使山中玉石焚。\n千古鲁连高世士，尚将谈笑却秦军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送罗成之移居崇明其子季通亦之本州校官","author":"成廷圭","text":"先生八月乘烟雾，妻子同随海上槎。\n太守宾筵先肃客，广文官舍即为家。\n波涛浩荡藏阴火，岛屿微茫接太霞。\n闻说三洲多药草，可能无意到丹砂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送罗季通之崇明学政","author":"成廷圭","text":"海上孤舟作冷官，也知清选重儒冠。\n秋潮好掣珊瑚网，晓日休歌苜蓿盘。\n士子几家能食禄，汝翁早岁已遗安。\n老人亦有乘桴意，僦屋西沙度岁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月三日书所见","author":"成廷圭","text":"青军黄军日自斗，西城南城门不开。\n诸侯相对面似土，今我不乐心如灰。\n饥乌在树噤无语，苍蝇满案从何来。\n年衰但愿饱粝食，意到聊且持吾杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日登甘露寺晚眺","author":"成廷圭","text":"醉里摩挲望眼开，江天寥落暗风埃。\n犹闻西府兵麾满，不见中原驿马来。\n今日贾生须痛哭，当时祖逖是英才。\n翩然一笑下山去，试看高僧话劫灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孔士瞻宪史考满归曲阜","author":"成廷圭","text":"素王之后多贤者，清稼今为几代孙。\n能以纪纲持宪法，每将节义答君恩。\n江淮一道风霜肃，汝颍三秋雾雨昏。\n不有俊良当世用，可无章疏达天阍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张明善归武昌随又移家眷入蜀","author":"成廷圭","text":"对酒悲歌泪满衣，楚天摇落又斜晖。\n风尘万里与君别，江海一舟何处归。\n老去且留吾舌在，愁来长惜壮心违。\n临岐不尽平生意，沙苑无云鹤自飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南安周知事瑞雀","author":"成廷圭","text":"岁岁双栖傍主人，昔年谁与号嘉宾。\n应图夜半衔环报，不比阶前得食驯。\n公干题诗犹未远，不疑作颂秪如新。\n东风更得周郎便，看尔翩翩上苑春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送广东帅郎郑彦昭贡香药入京诗一首","author":"成廷圭","text":"万里番禺入贡来，过淮一日到蓬莱。\n海中药草无人识，天上桃花有处栽。\n圣代宾兴方重士，星郎年少况多才。\n也知白璧虞卿礼，犹在黄金郭隗台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢冯仁伯送米与舒雁","author":"成廷圭","text":"短发晨梳雪几茎，老来那复爱虚名。\n只凭药饵扶衰朽，更藉诗篇写性情。\n天地此心唯报主，江淮多事尚闻兵。\n香粳分得谁相送，舒雁笼来未忍烹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送马士瞻帅掾高擢","author":"成廷圭","text":"风尘如此送君行，念尔才华独老成。\n军旅未闻忘俎豆，掾曹多见到公卿。\n沧江日射旌旗影，紫阁风悲鼓角声。\n玉麈谈玄何事业，云台图像是功名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄静逸处士顾仲庸","author":"成廷圭","text":"环堵萧然一室宽，只除诗酒寄清欢。\n瓶中有粟分寒士，袖里无书上热官。\n扬子暮年空识字，庞公早岁已遗安。\n先生独卧风尘表，吾欲相从接羽翰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周子端恻隐斋","author":"成廷圭","text":"此心随感与天同，念尔斯人水火中。\n拯溺未能空下涕，救焚何以自成功。\n百年底事多残忍，四海于今喜扩充。\n将见运之于掌上，世间无物不春风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吾欲卜居海上未有定止先作诗寄紫步刘子彬","author":"成廷圭","text":"满目风尘秪自怜，轻装已办有行缠。\n也知避乱依城郭，更欲移家傍渚田。\n紫步于今无士马，沧溟何处有神仙。\n桃源只在人间世，还许渔郎放钓船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送遆思诚出盱眙教谕","author":"成廷圭","text":"年年送人作校官，也知当代重儒冠。\n固因学舍人才盛，自觉戎藩礼数宽。\n一县士风今日见，百年师道后来看。\n淮山堂上清于水，莫遣惊尘到杏坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张仲举博士见寄至日诗","author":"成廷圭","text":"衡门风雪人稀到，一个幽轩竹四围。\n半子送年将旧酒，诸孙迎岁索新衣。\n惊鸿此日犹南去，老鹤何年共北飞。\n却忆太常张博士，天香携袖早朝归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题渔乐手卷","author":"成廷圭","text":"江湖如此两閒人，除是玄真与季真。\n长笛自吹皆古调，短篷相并即比邻。\n科头不异今渔者，托迹空闻古逸民。\n亦有渌阳湖上客，买舟来约理丝纶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十一月十四日有感寄江州太守李子威 其一","author":"成廷圭","text":"清朝如此盛公卿，何以摅忠答圣明。\n数月未收蕲水贼，一时谁散武昌兵。\n朱门旧邸空文藻，黑夜归舟有哭声。\n独使状元贤太守，至今犹捍九江城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十一月十四日有感寄江州太守李子威 其二","author":"成廷圭","text":"边报传来实失惊，妖氛独不犯湓城。\n义兵一日同生死，信史千年托姓名。\n别戍几人回士马，沧江通夜走公卿。\n九州尽得如公者，始信文儒有老成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋吴陵凤凰池送陈子成","author":"成廷圭","text":"蓬莱阁前春水生，丹邱之凤双飞鸣。\n沧波照见云锦色，碧落散作箫韶声。\n岂无仙人下刷羽，亦有隐者来濯缨。\n池上于今望吾子，一曲阳春歌太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张仲举五月荐樱桃之作","author":"成廷圭","text":"四月上林蒲笋出，玉堂风致一时新。\n也知天上樱桃宴，不致山中草莽臣。\n皂帽醉归当此日，金盘分赐共何人。\n吾家一树红堪摘，取荐春醪莫笑贫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送傅德润陪将作同知武昌买马回京","author":"成廷圭","text":"维扬馆里送轺车，却算分携八载馀。\n天使出求沙苑马，星郎厌食武昌鱼。\n数鞭已报充华厩，上冢毋忘过旧庐。\n老我平生无骏骨，可从郭隗借吹嘘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送霍仲皋还京","author":"成廷圭","text":"驿程万里入皇都，还过梁城取别途。\n天下军需何日了，淮南民瘼几时苏。\n求田问舍非良策，忧国忘家是壮图。\n黄阁相君应有问，愿闻一语赞嘉谟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送盛克明辟掾浙省移家吴兴","author":"成廷圭","text":"十年三送沧江别，此日分携又不同。\n辟掾远趋青锁闼，移家喜近水晶宫。\n勿论后会知何地，且念离群独老翁。\n幕府郎君应问讯，为言憔悴坐诗穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和周子通助教同张元祯倡和诗卷子","author":"成廷圭","text":"懒性何堪接贵游，松江之下每科头。\n不能取友山中社，更欲移家海上州。\n老去生涯清似水，兴来诗思淡于秋。\n玉堂杰作难为和，白首狂吟秪自愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄李子洁宪副时湖北残破却于太平开司","author":"成廷圭","text":"武昌遗老望旌旗，正是诸君报国时。\n令弟九江全死节，明公南海有生祠。\n台中妙选邱山重，湖北先声草木知。\n一道宪纲还旧睹，真儒端可佩安危。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题崔原亭竹深处予家有竹数竿人号曰居竹轩原亭城西别墅有竹亦数竿则又号之曰竹深处予与崔君通家来往所好相同故及之","author":"成廷圭","text":"居竹轩中也自宽，不愁无地著琅玕。\n文公胸次空千亩，李洞门前只一竿。\n天与老夫医恶俗，日凭童子报平安。\n崔家别墅尤高致，迟子归来守岁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经山法城禅师高弟善上人以楚章为号因题卷后","author":"成廷圭","text":"从向经山礼法城，善端开后愈分明。\n千年楚国非无宝，一个吴僧得此名。\n江月自随行道影，风林犹听读书声。\n旧家白雪亲曾和，处处丛林得散行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题丹阳邹隐君自得斋","author":"成廷圭","text":"天宇清明淑气微，昔年曾约试春衣。\n傍花随柳无人识，弄月吟风只自归。\n达士一生空好饮，老夫六十始知非。\n陶然不得从君乐，注目沧江白鸟飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题阳学训曹元秉归溧水","author":"成廷圭","text":"先生武惠之子孙，粹然言貌如春温。\n清门为庶忽老大，白首穷经犹讨论。\n诸生分题候堂试，二膳击鼓供盘餐。\n今晨拂衣不肯住，兴在江南山水村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题苏文仲中宣使宝善斋","author":"成廷圭","text":"星郎自是鲁璠玙，宝善称之信不诬。\n岂与黄金同日语，合登清庙应时须。\n渑池漫诧连城璧，沧海空传照乘珠。\n何似人中无价者，君家先世有三苏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送娄所性归溧水","author":"成廷圭","text":"大学小学列六斋，先生讲席多英才。\n公堂昕鼓会食罢，门榜月录分题来。\n清时如此教养备，老夫一见心神开。\n束书胡为赋归去，石田未必荒苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次陈养吾见寄韵","author":"成廷圭","text":"我本沧江樵牧人，却怜垂老见风尘。\n边城笳鼓伤心近，野寨旌旂入望新。\n四海正歌垂拱日，百年犹忆至元春。\n艰难未改心如铁，潦倒空悲发似银。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尹敬思令尹归青州并序 其一","author":"成廷圭","text":"玉雪丰神未七旬，江淮谁识旧儒臣。\n眼空四海归何早，胸著千年汲愈新。\n从学王门唯此老，发挥朱子更何人。\n青州门外京华近，吾欲相从一问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尹敬思令尹归青州并序 其二","author":"成廷圭","text":"宪签被旨方修律，令尹归田独著书。\n一代仪刑留制作，十章条目补遗馀。\n青州高起耆英社，白发同乘泽下车。\n不得清风接芳躅，可凭短札问何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月十日浙省有警怀罗善先掾史后闻使闽未回","author":"成廷圭","text":"淮楚风尘可奈何，南州又复动干戈。\n三山城郭故人远，八月江湖夜雨多。\n白发满头同老境，沧洲何处可行窝。\n裁书欲问平安否，海阔天高雁未过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蒋文甫以其祀亲之室扁曰思斋时余方哭母故及之","author":"成廷圭","text":"老去思亲十二时，灯前犹诵蓼莪诗。\n烝尝彷佛归来也，颜色分明梦见之。\n问寝不忘晨起早，倚门谁念暮归迟。\n多君苦行多于我，忍听长原楚些词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送娄所性回金陵别业","author":"成廷圭","text":"楚甸惊尘满客衣，古之贤达在知几。\n山中桂树我将老，江上草堂君独归。\n刁斗连城严肃肃，旌旗垂野净辉辉。\n金陵酒熟还相忆，莫遣诗筒信使稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简江西宋子与令尹杨翼之李斯立二先生","author":"成廷圭","text":"八月凉风催早寒，家山空忆路漫漫。\n沧江无处问书信，白日何人生羽翰。\n晓雾瘴天迷故国，夜潮流月到长干。\n诸君莫责王夷甫，我辈深惭管幼安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题海陵张孝子传","author":"成廷圭","text":"汝翁早岁值风尘，与母分离三十春。\n远道求之疑隔世，高堂喜极转伤神。\n干戈满地方多事，骨肉全家有几人。\n甚欲题诗歌孝子，老怀兴感恐沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭江州太守李子威","author":"成廷圭","text":"将帅怆惶忽弃城，孤忠何以独支撑。\n尚闻传檄诛狂寇，犹自开仓举义兵。\n千古报君心未死，九江图像面如生。\n至今月黑匡庐下，彷佛悲风有战声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭湖广省郎中刘遵道","author":"成廷圭","text":"百年正气此销沈，空使诸公泪满襟。\n厚地无人收白骨，皇天有眼识丹心。\n亲王兵卫终难倚，太尉楼船不可寻。\n一自岳阳开省后，更无消息到于今。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]