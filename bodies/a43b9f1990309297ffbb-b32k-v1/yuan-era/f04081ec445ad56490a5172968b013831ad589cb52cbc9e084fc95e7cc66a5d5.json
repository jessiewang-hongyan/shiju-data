[{"title":"孟母断机图","author":"凌云翰","text":"慈亲教子意何如，直至三迁始定居。\n一自寒机初断后，经纶都在七篇书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张骞出使图","author":"凌云翰","text":"漫从西域度流沙，八月虚回奉使槎。\n天上白榆那可摘，归时只得带榴花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳塘春水图","author":"凌云翰","text":"杨柳池塘春昼迟，画船犹记听黄鹂。\n飞花又逐东流去，消尽年光总不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桂月凭阑","author":"凌云翰","text":"银屏深掩烛烧残，金粟枝头玉露寒。\n阵阵西风吹不断，肯教闲却画阑杆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江雁阵图","author":"凌云翰","text":"江流东去雁南翔，波影涵秋一两行。\n不待平沙观落处，便从图画认潇湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒江钓雪图","author":"凌云翰","text":"风满空江雪满舟，一竿波面自夷犹。\n钩丝更放长三尺，不信寒鱼不上钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舜举桃花二首 其一 碧桃","author":"凌云翰","text":"花开记得涌金池，一片枝头不受吹。\n十万人家春似海，瑶笙谁向月中归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舜举桃花二首 其二 绯桃","author":"凌云翰","text":"晴日蒸红烂若霞，一枝如影绿窗纱。\n去年花里寻诗处，错认溪桥卖酒家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏长桥","author":"凌云翰","text":"飞梁压水跨虹腰，知是吴江第一桥。\n安得鲈鱼共樽酒，秋风亭上酹三高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅仙图","author":"凌云翰","text":"曾向松林梦美人，雪肤花貌认来真。\n一声横玉惊么凤，枝北枝南总是春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"美人图 其一","author":"凌云翰","text":"白玉搔头压鬓垂，困人天气觉来迟。\n帘前一任杨花过，爱惜春纤不画眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"美人图 其二","author":"凌云翰","text":"渊明谩尔赋闲情，托物如何写得成。\n欲识春风无限意，樱桃花下背人行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跨驴图","author":"凌云翰","text":"曾见洪崖降雪图，寒云四野正模糊。\n何如驴背驮诗去，濡岸桥头酒可沽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江图","author":"凌云翰","text":"极目沧浪映翠微，钓船初放客船归。\n渔歌一曲长烟外，惊起沙鸥隔树飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之一 其一","author":"凌云翰","text":"夜听檐声似雨声，晚窗操笔喜诗成。\n东风消尽门前雪，又见墙阴荠菜生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之二 其二","author":"凌云翰","text":"桃杏何曾羯鼓催，春风先后自吹开。\n为怜红影临清泚，不惜芒鞋得得来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之三 其三","author":"凌云翰","text":"草芽雨后一番青，处处郊原趁雨耕。\n我亦村居聊避俗，傍人错比晋渊明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之四 其四","author":"凌云翰","text":"村扉寂寂掩荆柴，雨阻清明客少来。\n自把新茶试新火，喜看榆柳变炉灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之五 其五","author":"凌云翰","text":"连宵急雨送轻雷，又见郊原草色回。\n此去城门三十里，踏青能有几人来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之六 其六","author":"凌云翰","text":"花柳村村社鼓喧，花含宿雨柳含烟。\n野夫何处堪行乐，不是花边即柳边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之七 其七","author":"凌云翰","text":"高陂分水出湾头，宿雨晴时好放舟。\n闻说春山多胜事，几时寻壑入经丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之八 其八","author":"凌云翰","text":"筠笼采摘小童回，樱豆堆盘杂笋梅。\n正尔客怀寥落甚，不妨频覆掌中杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之九 其九","author":"凌云翰","text":"野蔌村醪暂遣怀，每呼邻叟尽馀杯。\n醉来却倚柴门立，闲数昏鸦几个回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之十 其十","author":"凌云翰","text":"春日田家始作劳，下乡胥吏苦频搔。\n如何学得仙源隐，不种桑麻只种桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之十一 其十一","author":"凌云翰","text":"断岸防颓费石包，雨声又听响中宵。\n杏花零落飘香远，明日扶筇度石桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 春日十二首之十二 其十二","author":"凌云翰","text":"积雨初乾理菜畦，味含膏土胜酥肥。\n野夫不厌根频嚼，惭愧村童日摘归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之一 其十三","author":"凌云翰","text":"木奴花发四邻香，静里偏知日晷长。\n坐久出门看野色，乱山平处是钱唐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之二 其十四","author":"凌云翰","text":"狂蜂浪蝶尚飞翻，春去浑无一点痕。\n秪有东风知客意，乱吹花片拥篱根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之三 其十五","author":"凌云翰","text":"春色相将到楝花，柴门深掩似山家。\n日长无事琴书罢，纱帽笼头自煮茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之四 其十六","author":"凌云翰","text":"林绕方塘水绕洲，杖藜随处得迢游。\n却嫌薄暮东风急，便觉经寒似麦秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之五 其十七","author":"凌云翰","text":"田头纵步午风凉，陂水青青浸稻秧。\n爱杀檐前双燕子，落花多处得泥香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之六 其十八","author":"凌云翰","text":"蚕事忙时三月中，苍苔门径少人踪。\n抱篮知是谁家女，偶向柔柔陌上逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之七 其十九","author":"凌云翰","text":"水村高下自成围，处处人家白板扉。\n榆荚杨花正无赖，等闲又欲送春归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之八 其二十","author":"凌云翰","text":"门外都无车马尘，绿阴幽草与时新。\n小窗日日风兼雨，赖有蔷薇占得春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之九 其二十一","author":"凌云翰","text":"水面秧针长绿茸，雨馀樱颗染深红。\n东皋伫想生盈陌，西蜀应知赠满笼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之十 其二十二","author":"凌云翰","text":"晴云满户日光迟，柏子烧残火渐微。\n人在小轩闲读易，一双蝴蝶上阶飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之十一 其二十三","author":"凌云翰","text":"酴醾压架雪成堆，一日须看一百回。\n满袖清香浑不记，却怜蜂蝶趁人来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 晚春十二首之十二 其二十四","author":"凌云翰","text":"雨中红迤晓来稀，愁见花飞镇掩扉。\n不是杜鹃啼彻夜，无人知道又春归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之一 其二十五","author":"凌云翰","text":"重重绿叶障林肥，点点黄花入麦稀。\n绝似辋川图画里，水田时有鹭鹚飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之二 其二十六","author":"凌云翰","text":"乱蛙声急雨声寒，坐拥衾裯尚觉单。\n畎亩却思天下事，几时民受一分宽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之三 其二十七","author":"凌云翰","text":"闲看行蚁上苔钱，日永依稀似小年。\n麦饭正香葵菜熟，祗将耕凿报尧天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之四 其二十八","author":"凌云翰","text":"稻秧新插绿如波，正值田头雨一蓑。\n未到秋成先有望，差科不比去年多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之五 其二十九","author":"凌云翰","text":"人生出处在知几，西塞山空鹭自飞。\n学取玄真归隐好，钓船闲理绿蓑衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之六 其三十","author":"凌云翰","text":"略彴歌斜跨浅流，茅茨萧洒枕清沟。\n绿阴满地无来客，忽听蝉声起树头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之七 其三十一","author":"凌云翰","text":"屋后方池可沤麻，暗分流水过邻家。\n人间有地皆堪隐，不独青门好种瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之八 其三十二","author":"凌云翰","text":"水亭傍午好追凉，白鸟飞来玉一双。\n脩竹似嫌炎暑近，并移清影过南窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之九 其三十三","author":"凌云翰","text":"浊酒倾来白似浆，葛中新漉手犹香。\n溪泉冷浸荷筒饮，共向槐阴纳晚凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之十 其三十四","author":"凌云翰","text":"角巾微服恣游嬉，偶值溪翁得缓归。\n独有蜻蜓如对客，一双时掠钓丝飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之十一 其三十五","author":"凌云翰","text":"千亩荒烟傍晓锄，源头水少每忧枯。\n何如老子书田好，纵使丰年不上租。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 夏日十二首之十二 其三十六","author":"凌云翰","text":"人间三伏畏骄阳，我独观书爱日长。\n为问此时何所乐，暑风凉簟竹方床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之一 其三十七","author":"凌云翰","text":"东轩睡足日初红，起汲清泉灌菊丛。\n不是幽人勤种植，要看佳卉傲秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之二 其三十八","author":"凌云翰","text":"晚凉何处听秋声，脩竹千竿翠绕扃。\n自起开窗看微月，风萤撩乱一池星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之三 其三十九","author":"凌云翰","text":"巧夕争看织女机，彩云销尽不成衣。\n如何村落柴门外，乌鹊都无一个飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之四 其四十","author":"凌云翰","text":"坐对疏林日渐低，闲看归鸟正高飞。\n野夫自为吟诗苦，不是悲秋减带围。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之五 其四十一","author":"凌云翰","text":"行道真如行路难，归来依旧客毡寒。\n灯前笑对家童说，恰似琴川作冷官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之六 其四十二","author":"凌云翰","text":"雨后晴空碧四垂，斜阳却与乱山宜。\n怪来举目浑无碍，正是秋风落叶时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之七 其四十三","author":"凌云翰","text":"一棹夷犹任野夫，苕乡人号小西湖。\n鸡头菱角随时有，桂子荷花此地无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之八 其四十四","author":"凌云翰","text":"田家望望待升平，甲子欣逢烂熳晴。\n茅舍竹篱还自好，此身不愿谒承明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之九 其四十五","author":"凌云翰","text":"酿酒盈缸粟满仓，秪将辛苦度星霜。\n诗书教子如何似，羡杀燕山窦十郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之十 其四十六","author":"凌云翰","text":"自笑迷方著处家，去年犹记客天涯。\n今朝又是重阳节，鐏有新醪菊有花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之十一 其四十七","author":"凌云翰","text":"琴川官舍漫多鱼，却忆松江巨口鲈。\n偶见秋风动归兴，不知还是季鹰无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 秋日十二首之十二 其四十八","author":"凌云翰","text":"欲避兵尘不厌深，远携琴剑到梅林。\n绿樽紫蟹聊消日，喜有床头未尽金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之一 其四十九","author":"凌云翰","text":"新居添得屋茅高，梅柳栽成似蜀郊。\n岁晚归来无一事，小窗闲看鹊营巢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之二 其五十","author":"凌云翰","text":"年来读易太冬烘，赖有先贤为启蒙。\n三十六宫都历遍，眼中物物是春风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之三 其五十一","author":"凌云翰","text":"新筑书堂荫白茅，萧然终胜老禅寮。\n雪天最爱风敲竹，似向瑶台听凤箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之四 其五十二","author":"凌云翰","text":"门外沙寒月半笼，柴荆元不置帘栊。\n年来闲气都消尽，坐对书灯一点红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之五 其五十三","author":"凌云翰","text":"归隐方谋一亩宫，论交溪友与园公。\n春风会到门前柳，好插长条满屋东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之六 其五十四","author":"凌云翰","text":"溪头冻合雪风晴，寒袭重裘一气凝。\n谁把玻瓈都击碎，定知渔榜晚收冰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之七 其五十五","author":"凌云翰","text":"紫芥九宜配白菘，响生牙颊味偏浓。\n拟同坡老残年饱，肯教何曾一日供。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之八 其五十六","author":"凌云翰","text":"久客偏谙闾里情，每逢邻叟即班荆。\n浊醪酿得邀人吃，为喜今秋万宝成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之九 其五十七","author":"凌云翰","text":"晓起惊看雪拥门，地炉火煖自添春。\n交游岁晚俱零落，谁复扁舟访故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵范石湖田园杂兴诗六十首 冬日十二首之十 其五十八","author":"凌云翰","text":"不眠吟苦爱更长，石鼎煎茶满注汤。\n诗句欲成缘底事，梅花隔屋暗吹香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]