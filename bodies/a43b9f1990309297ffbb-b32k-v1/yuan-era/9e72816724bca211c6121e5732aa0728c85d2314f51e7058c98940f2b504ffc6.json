e":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次崇禧真人徐景周韵送茅山镇长冯秦卿","author":"李孝光","text":"与君游久最知我，借问谁能似我閒。\n即买扁舟过淮去，舒州城上望钟山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨天锡韵","author":"李孝光","text":"江上杨柳又青青，双橹复作鹅鹳鸣。\n中流击楫渡江去，夜半啼鸡非恶声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起用伯循御史韵二首 其一","author":"李孝光","text":"何言痛饮是吾师，病覆壶觞亦废诗。\n客久自应甘寂寞，独怜夜雨打窗时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起用伯循御史韵二首 其二","author":"李孝光","text":"病起无聊带减围，看花惊有未开枝。\n主家十二楼中见，烂熳春风祇自知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王士让御史所藏画卷 其一 风雨回舟","author":"李孝光","text":"天昏地黑蛟龙恶，风雨如山擘不开。\n舟中自有刺蛟手，笑杀舟师捩舵回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王士让御史所藏画卷 其二 古庙折碑","author":"李孝光","text":"山上荒祠山下溪，系牲断石是谁题？\n落日行人更回首，青枫树里鹧鸪啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送茂上人二首 其一","author":"李孝光","text":"五湖春水绿溶溶，两岸花开斗白红。\n欲买扁舟随汝去，卧听疏雨打南篷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送茂上人二首 其二","author":"李孝光","text":"二月狂风已不禁，天笼大野日阴阴。\n高斋一夜听新雨，想见城东柳色深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中","author":"李孝光","text":"日夜东风相荡磨，故应地上落红多。\n更须病起能拈酒，可奈东池芍药何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书岳法师屏","author":"李孝光","text":"眼中有客久不见，长见白云成往还。\n风著纸窗疑是雨，酒醒忽忆在南山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿枣树湾","author":"李孝光","text":"枣树湾西乱石矼，萧萧落木见秋江。\n渔郎击楫悲歌意，不道风吹上客窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江头春日","author":"李孝光","text":"江头杨柳弄黄金，柳下春江绿已深。\n可见东风能富贵，吹将红紫上园林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送上虞黄万石作天台教","author":"李孝光","text":"昔年曾向天台去，走上璚楼看日生。\n跳出海波三丈许，始闻山下一鸡鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君六合诗韵二首 其一","author":"李孝光","text":"瞿塘雪解水初回，浪触金山怒转雷。\n惟有诗人天亦爱，迎船怪雨为君开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君六合诗韵二首 其二","author":"李孝光","text":"梦驱枢郎发船去，两舷成与岐龙撞。\n醒时呼童开户看，月在青天天在江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用志能台郎韵寄萨使君今为江南诸道御史台令史","author":"李孝光","text":"金尽壮士安足惜，酒多好怀聊复开。\n昨夜东家借生马，升州高处望君来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道枯木竹石图","author":"李孝光","text":"谪仙夜入雷电室，捕得飞来石上梭。\n却斫灵槎挂明月，横吹玉笛上天河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十二月十三日登凤凰台望淮南雪中诸山兼书道上所见二首 其一","author":"李孝光","text":"雪花一丈欲齐楼，人住凤凰台上头。\n雪隔淮南数千里，青山断处是滁州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十二月十三日登凤凰台望淮南雪中诸山兼书道上所见二首 其二","author":"李孝光","text":"貂帽金鞲绿裤襦，骑童自狎小毡车。\n黄金博得歌姬笑，却笑先生夜读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次梁有章韵","author":"李孝光","text":"谁怜范叔老犹寒，客里兼旬酒榼乾。\n天若无情天亦老，自调绿绮向君弹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀萨使君二首 其一","author":"李孝光","text":"憎夜还闻蟋蟀吟，定知秋色上青林。\n坐看黄叶落四五，记得题诗入绿阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀萨使君二首 其二","author":"李孝光","text":"山雨萧萧到楚回，夜凉鸿雁渐应来。\n题诗满壁无人看，墙下玉簪花又开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送谢仲连小□巡检","author":"李孝光","text":"承平已久桴鼓息，事简官清只煮茶。\n山崦东西足僧寺，时时骑马看黄花。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送卫县尹","author":"李孝光","text":"轩辕羽仗上云霄，天上璚台绛节朝。\n桂树阴阴明月出，画屏西畔听吹箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静轩卷","author":"李孝光","text":"沈沈院落无人语，燕子归来柳絮初。\n行绕东池日卓午，春风吹乱一床书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中","author":"李孝光","text":"化工弄春手未滑，虚负几番花信风。\n自倚东园花未遍，故将小病恼诗翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丙子五日雪","author":"李孝光","text":"南土冬暄又无雨，今年春雪没行车。\n夜深户下如月白，自起开窗读汉书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送冯秦卿","author":"李孝光","text":"天下承平边事小，将军卧治莫谈兵。\n公庭吏散无来客，自数阶前挝鼓声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宋武官尉安康之桐城","author":"李孝光","text":"令人作恶惟离别，今日江头送客还。\n赢得秋风斜照里，倚篷满意看青山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宋武臣之桐城","author":"李孝光","text":"欲霜江气已飕飕，鸿雁南飞木叶愁。\n好为故人连夜饮，平明笳鼓出扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用观志能韵寄萨使君","author":"李孝光","text":"杏花落后见辛夷，烈士无歌忆别离。\n春草池塘蛙吹早，斜阳巷陌燕归迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过贾元寔宅","author":"李孝光","text":"共过故人溪上宅，春风野水欲绵绵。\n先生半月无诗思，恐有新诗在雪边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵汝甫枯木竹石卷","author":"李孝光","text":"中林黄叶净沄沄，眼底峥嵘见此君。\n清晓东池看黄菊，凤毛无数落春云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姑苏台","author":"李孝光","text":"阊门杨柳自春风，水殿幽花泣露红。\n飞絮年年满城郭，行人不见馆娃宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]