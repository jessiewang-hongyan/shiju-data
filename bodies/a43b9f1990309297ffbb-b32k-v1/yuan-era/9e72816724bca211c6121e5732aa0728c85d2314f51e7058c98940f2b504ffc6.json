[{"title":"春风","author":"李孝光","text":"春风随处作春晴，杨柳依依绿未成。\n昨夜池塘新雨足，蛙声刚乱读书声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27922,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过钓台","author":"李孝光","text":"赤龙已挟故人飞，却爱清江理钓丝。\n入觐匆匆谋去就，当时犹悔见机迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27923,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"农事","author":"李孝光","text":"落日蜻蜓处处飞，槿花门巷豆花篱。\n行逢野老问农事，稻雨湿衣香未知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27924,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台道中闻天香写赠胡仲宾","author":"李孝光","text":"万斛天香夜气收，晓风凉月酿清秋。\n诗人试与评花品，定是人间第一流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27925,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李仲羽归江东因寄伯循御史","author":"李孝光","text":"江中八月雨如烟，去买徐州送客船。\n采石山头送李白，身骑明月上青天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27926,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送蔡飞卿之维扬","author":"李孝光","text":"送君直渡秦淮水，风急桃花飞过江。\n自有行人回首处，升州山色满船窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27927,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送缑山侯氏宅","author":"李孝光","text":"海东月明九万里，照见山头白鹤还。\n竹几匡床清似雪，不知门外是缑山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27928,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠灵岩秀禅师","author":"李孝光","text":"北林日午煖如烘，尽日溪行曲折中。\n自爱敲冰看鱼上，山头树影落溪红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27929,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪屋为通上人作","author":"李孝光","text":"倒挽天河转翠微，玉虬鳞甲满天飞。\n道人结屋东边住，爱看晴花不掩扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27930,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶书所感","author":"李孝光","text":"钟鼎山林易地难，丈夫出处正相关。\n绣鞍大马都门道，却忆西楼看碧山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27931,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明郊行","author":"李孝光","text":"清明处处麦风斜，诗老得閒长在家。\n远树小村千瓦雪，不知落日上梨花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27932,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠胡仲宾","author":"李孝光","text":"九月风多裋褐单，剑光抱月忽飞还。\n人言华顶峰前路，正在白云飞处山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27933,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送辅贤出山作首尾吟二首 其一","author":"李孝光","text":"儒官不畏简书催，拄杖休惊石上苔。\n行到水穷云起处，路从四十九盘来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27934,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送辅贤出山作首尾吟二首 其二","author":"李孝光","text":"路从四十九盘来，树底看云首独回。\n客里不知身是客，向人犹爱话箫台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27935,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人","author":"李孝光","text":"江上晚山无数青，行人草草似流萍。\n水边灯火官船发，五十长亭第一亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27936,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君韵四首 其一","author":"李孝光","text":"乌几绳床诗梦熟，惊闻风雨欲翻江。\n酒醒忆是长芦寺，半夜松声绕北窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27937,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君韵四首 其二","author":"李孝光","text":"大江北岸望南岸，山色微茫似破罾。\n石马麒麟竟何有，南公空说晋诸侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27938,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君韵四首 其三","author":"李孝光","text":"使客匆匆感岁华，杏花消息又桃花。\n江南佳丽春风见，柳絮楼台十万家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27939,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨使君韵四首 其四","author":"李孝光","text":"江气萧萧如过雨，起看北斗挂船头。\n犹忆前年称使客，卧听笳鼓入扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27940,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新月","author":"李孝光","text":"光中新见仙人迹，桂树初生影未浓。\n仰望青天如止水，西头一瓣玉芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27941,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九霞听松图","author":"李孝光","text":"不到茅山又五年，煮茶更试碧云泉。\n山中百事便静者，惟苦松声搅醉眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27942,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜梦老人身长而峨冠自称住钓台仆意其为严子陵居旁者曰此朱元晦也梦中作诗遗之既觉犹能成诵","author":"李孝光","text":"赤龙飞起九天开，缘底先生住钓台。\n昨夜月明烟水阔，白鸥飞去又飞来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27943,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简古元瑞上人","author":"李孝光","text":"竹扉花牖雨声新，一榻清风不著尘。\n石笋山中旧时客，幸来相就说前身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27944,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过青枫岭王贞妇庙","author":"李孝光","text":"山下江流幸自清，山头明月已无情。\n此心若愧王贞节，莫向清枫岭上行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27945,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄朱希颜二首 其一","author":"李孝光","text":"城头鼓鼜雨凄凄，溪子牵船上恶溪。\n会有行人回首处，两边枫树郭公啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄朱希颜二首 其二","author":"李孝光","text":"江边鸿雁下年年，客子何由两鬓玄。\n七十二滩秋月白，荻花风落钓鱼船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄达兼善","author":"李孝光","text":"城上乌啼欲闭门，萧萧风雨又黄昏。\n无端画角连云起，铁铸梅花亦断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄萨天锡二首 其一","author":"李孝光","text":"月子纤纤青海头，使君昨夜过扬州。\n城中高结琼花样，去听吹箫何处楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄萨天锡二首 其二","author":"李孝光","text":"二月江城未见花，笛声哀怨起谁家？\n曲中大半伤离别，马上无人写琵琶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祠宇观登楼三首 其一","author":"李孝光","text":"先生长出访丹砂，去入何宫道士家。\n不是山南即山北，款门先觅看黄花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27951,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祠宇观登楼三首 其二","author":"李孝光","text":"凤凰台前看明月，姓名从此落人间。\n西风昨夜吹庭树，又逐閒云过别山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27952,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祠宇观登楼三首 其三","author":"李孝光","text":"祠宇观前斸茯苓，偶登高阁眼为青。\n西南到江三百里，只此案头双砚屏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27953,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟过吴江二首 其一","author":"李孝光","text":"十五女郎可怜生，牵挽百丈踏泥行。\n洗脚上船歌《白苧》，春风吹过阖闾城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27954,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟过吴江二首 其二","author":"李孝光","text":"二十四番花信老，溪头红减绿初肥。\n东君也是多情思，尽日扶持柳絮飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀萨使君","author":"李孝光","text":"人到中年畏别离，况逢多病转相思。\n夜深风雨满高竹，自起挑灯读寄诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"华山图","author":"李孝光","text":"紫髯绿发如飞仙，白驴偷吃种芝田。\n二月三月春气盛，山头桃花红入天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莱上人弱水颂","author":"李孝光","text":"岂无船筏奈君何，生怕无风水自波。\n碧海倒流三万里，手提明月上银河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵萨天锡杂咏四首 其一","author":"李孝光","text":"题门人至从书凤，写字谁怜可博鹅。\n独露亭中未归客，懒闻