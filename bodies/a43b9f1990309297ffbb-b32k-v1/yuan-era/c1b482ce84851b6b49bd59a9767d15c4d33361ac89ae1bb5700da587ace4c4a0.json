[{"title":"次韵虞侍讲游何尚书山庄","author":"黄复圭","text":"尚书致政卧青山，笑傲中林竟不还。\n野叟徒能谈旧事，孤云何处觅苍颜。\n哀湍振壑龙移久，曲崦藏风鹤梦閒。\n喜逐三朝黄阁老，昔贤陈迹共追攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金碧山水图","author":"黄复圭","text":"狂风捲尽夜来云，万壑千崖锦绣纹。\n占日楼台平树见，吼雷春瀑入溪闻。\n岂无花洞留莺语，应有芝田下鹤群。\n清绝松阴二三子，不知谁是紫阳君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饯别杨友直总管","author":"黄复圭","text":"双凫飞蹻历金天，五马閒游款玉鞭。\n隶篆共参邦伯印，制书曾拜祖皇宣。\n严城鼓角连云度，护水鱼龙枕月眠。\n无限舞衫歌扇意，路人遥识使君船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送潘希隐归闽省亲","author":"黄复圭","text":"道人骑鹤入闽邦，梦绕慈闱一念长。\n红压锦云收荔子，绿攒香树摘槟榔。\n晓侵雾露黄冠重，春透山林綵服光。\n剩有大丹并妙药，三光凋后鬓应霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿饶大有","author":"黄复圭","text":"骊驹塘上玉生烟，麟角峰前乐事偏。\n花里桥亭春每早，竹间书庋日如年。\n雕龙细雨金壶墨，宝雁轻调锦瑟弦。\n椿树绿时誇五伯，桃花红处祝三千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燮御史","author":"黄复圭","text":"红杏碧桃鳌顶开，青年白皙马蹄回。\n本随鸾凤冲霄去，却为豺狼按辔来。\n铁铸冠梁临画省，绣裁衫表照霜台。\n使骢往复东西道，欲候旌旄愧不才。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜薛外史春日自京师寄经至","author":"黄复圭","text":"蓬莱坊畔五云边，七尺长身汉薛宣。\n花压铜街驰厩马，水生瑶海放楼船。\n仙曹共作窗间戏，吏部相邀瓮里眠。\n果老山头逢野鹤，雪笺时奉寄来篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白云山刘道士","author":"黄复圭","text":"紫华阳巾白羽衣，幼辞家舍入岩扉。\n灵书注就参同契，绝字修成杜德机。\n著屐看松逢伴少，荷锄栽果到城稀。\n萧萧落叶空山夜，独礼寒星待鹤归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"破帽","author":"黄复圭","text":"破帽多情却恋头，草残丝断素尘浮。\n烟笼长是煎茶日，风落多逾把菊秋。\n顶漏疏星窥短发，檐垂缺月露双眸。\n桃尖楼子青罗辨，相对宁知故旧愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酒","author":"黄复圭","text":"曲糵生香出小槽，几人耽酗日陶陶。\n笑吞鹦鹉杯中月，贫与鹔鹴花下袍。\n内府腊传红琥珀，西京秋压紫葡萄。\n杜康仪狄今安在，回首丘陵半是糟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪知州致事归","author":"黄复圭","text":"酒扫林庐理旧书，某山某水足嬉娱。\n尚应馈醑虞庠礼，谩入耆英洛社图。\n花里醉眠从客去，竹间移步遣孙扶。\n后人自有田园趣，无愧疏家两丈夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉赠吴宗师","author":"黄复圭","text":"使节光华礼乐崇，皇华原隰辔玲珑。\n五风十雨祠三岛，万岁千秋祝两宫。\n醮起碧鸡山月白，仗移黄鹄禁云红。\n召南庶类深仁泽，行见驺虞发五豵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿上官夫人","author":"黄复圭","text":"水沈烟煖翠云低，婺女星高斗转移。\n百子帐中青玉案，群仙会上紫金卮。\n乐成彩凤《将雏》曲，礼尚嘉鱼《式燕》诗。\n基构有堂高数尺，绿衣白发两相宜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春明楼","author":"黄复圭","text":"公子楼居剩得春，四时花气敌浓薰。\n书声高下闻长日，舞袖婆娑拂彩云。\n蛱蝶新图开雁爪，狻猊古鼎隔龙纹。\n近来每爱东风赏，折简常邀越鄂君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠舍农叟春耕者","author":"黄复圭","text":"六角黄牛二顷田，晓蓑星月晚犁烟。\n治墉布谷清明后，伐鼓烧钱社日边。\n急雨放宽科斗水，乱云遮断鹭鹚天。\n太平四海无征役，念此安居不偶然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游崇禧寺","author":"黄复圭","text":"好山藏在白云隈，天历君王手自开。\n木魅尽惊金钁震，地灵潜献宝瓶来。\n林香万叶垂甘露，峰霁诸花散石台。\n莫道神游事绵邈，六龙应解此徘徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题草堂寺","author":"黄复圭","text":"草堂禅寺北山陲，想见鸣驺入谷时。\n猿鹤如怀海盐令，鱼龙犹护绍兴碑。\n排岩树老秋来早，上殿僧稀晓散迟。\n我亦于今抗尘土，临风惭读孔璋移。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"威显庙","author":"黄复圭","text":"南唐忠烈桂司空，三百馀年气贯虹。\n上国勋劳明大节，故家文献挹遗风。\n云中结构孙修庙，石上褒崇史论功。\n词客冀窥松柏路，弋阳西畔贵溪东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂咏寄友人","author":"黄复圭","text":"绿漪池沼燕交飞，深院重门客到稀。\n柳絮不知春去尽，尚随风起点人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送友","author":"黄复圭","text":"云锦江边送玉郎，江边折柳柳丝长。\n柳丝若挽行人住，更向东风种几行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"亭前荼蘼","author":"黄复圭","text":"杏园芳草雨霏霏，亟折千秋卷画旗。\n自过清明多病酒，不知花落到荼蘼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉题李学士幽篁古木图","author":"黄复圭","text":"岁历居庸万仞山，词臣供奉有馀閒。\n试看翠竹丹枫画，犹似金风玉露间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫花二首 其一","author":"黄复圭","text":"连理枝头并蒂红，中官采献未央宫。\n可怜春色非人世，天上风光似酒浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫花二首 其二","author":"黄复圭","text":"金阑芍药紫重胎，上苑移来遍殿栽。\n正顶绣苞三十朵，羊车停处一齐开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人入上京","author":"黄复圭","text":"觅得清风谒紫微，临川脱却故山衣。\n似知云锦江头水，专照邦人昼锦归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄高元博","author":"黄复圭","text":"故人招我出山来，一去城闉更不回。\n无数青松满池月，可怜深夜独徘徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题襄阳拍手图","author":"黄复圭","text":"爱酒山翁倒接䍦，花间日日醉如泥。\n只今池馆风流在，不见拦街拍手儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送琴士归杭","author":"黄复圭","text":"云中歌断《紫芝》歌，不奈周君欲去何。\n十里湖山好明月，却怜随处故人多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虎丘三首郑君明德偕廉夫伯雨诸公同赋次东坡先生韵 其一","author":"陈谦","text":"篙师郭西门，矫首霞外岭。\n森秀未及探，荒苔吊秋井。\n剑精沉夜白，漆炬翳馀耿。\n嗟哉龙虎威，零落等虫黾。\n一峰直海涌，破地出魁矿。\n流观劈坼状，髣髴神工猛。\n授此窟室雄，能无霸图骋。\n让王东采药，为态本栖哽。\n焉知牧野捷，吴业就已顷。\n风尘阅成败，宗社属衰冷。\n不遣忠勇臣，相符带河永。\n词场亦何为，发嘅当晚景。\n高贤惜地灵，倦鹤顾山影。\n愿买阳羡田，早从居吴请。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虎丘三首郑君明德偕廉夫伯雨诸公同赋次东坡先生韵 其二","author":"陈谦","text":"客游九龙冈，道出白虎岭。\n拄杖谙独登，煎茶汲僧井。\n歌客寡俦匹，历览思弥耿。\n昆礏抵乌鹊，燕金掷蛙黾。\n差将第一义，喻彼山下矿。\n坡公诗家豪，性具佛勇猛。\n山川与笔力，神鬼助奔骋。\n搜冥百怪穷，吊冢孤鹤哽。\n宁容沟浍雨，汪洋敌千顷。\n情深事偶从，魂在骨未冷。\n寒泉兼古木，笼络归隽永。\n盘陀延小酌，反照藉馀景。\n誓须浮海航，回望孤塔影。\n名不系除书，山林恣参请。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虎丘三首郑君明德偕廉夫伯雨诸公同赋次东坡先生韵 其三","author":"陈谦","text":"昔游第一峰，遍数东南岭。\n传闻吴阖闾，曾照山上井。\n谁期此一杯，玉雁閟孤耿。\n夫差小儿态，踊跃类蛙黾。\n眼看双龙剑，迹寄山石矿。\n再鼓气已衰，功亏前王猛。\n成名乞敌竖，车辙断遐骋。\n青青土中血，似托仙题哽。\n中原泣诸姬，大业弃俄顷。\n青荧溪泉动，蔽翳山木冷。\n往事何足谈，飘花日初永。\n湛卢有馀辉，中夜凌倒景。\n好奇谁往候，微月照人影。\n正恐化蜿蜒，飞扬讵容请。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"学士山怀古","author":"陈谦","text":"枕湖列层岑，葱郁聚云族。\n出郭才三里，方舟渐通麓。\n曾邀昔贤赏，名胜皆可录。\n双峰夹亭榭，崇阜富杉竹。\n我家世结邻，数椽依古木。\n怀钦索遗址，半与松根伏。\n碑缺篆无存，揣文须穆卜。\n坡仙岂遂往，或寓幽人屋。\n据梧缅高风，秋阴吹肃肃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游子吟","author":"陈谦","text":"母爱儿，比瑶草，百花□头春浩浩，结绿悬黎总非宝。\n朝居目前暮怀抱，顷刻相违作忧恼。\n儿兮劝尔无出游，忍令母心日夜忧。\n纫衣一针一度钩，针线不比心绸缪。\n儿嬉斗草拈春缕，绿缛青葱不堪数。\n楚人只解歌王孙，萋萋乃有子母恩。\n徂徕松，淇园竹，人生长生胜他木，千年万年春草绿。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过吴江","author":"陈谦","text":"第四桥下风水恶，千斛舟中心骨惊。\n蛟龙有时就庙食，鸿雁每岁不南征。\n松江太湖会合地，暮雨寒涛交战声。\n独客倚篷归叹息，崎岖世路何由平！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游虎丘次仲举韵","author":"陈谦","text":"虎丘虎踞仍龙蟠，出郭先见翠巑岏。\n金玉黄炉灰劫远，旃檀古林风雨寒。\n僧来引绠动春涧，人醉拂花眠石坛。\n为语金坡王学士，巨然曾画此山看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧桐月","author":"陈谦","text":"琪树西风露井傍，镜寒移影度银床。\n凤枝清切元疑昼，鹤梦凄凉不待霜。\n点笔诗人题夜绿，知更宫女怨秋黄。\n莫教一叶轻摇落，珍重千门被耿光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"陈谦","text":"楼下摊钱还上楼，花前夜醉晓扶头。\n不知命犯何星宿，一日猖狂百日愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄鹤山人芝兰室图","author":"宇文公谅","text":"紫芝采为食，幽兰纫作佩。\n聊复助熏修，庶几堪傲世。\n一室静生香，诸尘自融会。\n蒲团禅燕馀，经卷了空外。\n嗒然吾我忘，谁云有三际？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春草轩诗","author":"宇文公谅","text":"春阳播淑气，百卉生华滋。\n光风一披拂，蔼蔼浮云晖。\n幽芳澹露晓，秀色含烟霏。\n乃知造化心，玄泽无停机。\n伊人早失怙，抚育仰母慈。\n高门赖扶植，况复蕃孙枝。\n清时表宅里，巨扁揭华榱。\n门轩俯平绿，每怀贞曜诗。\n念慈恩罔极，欲报心无涯。\n堂前树萱草，堂下罗斑衣。\n愿言勤爱日，永与庄椿期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菊山诗","author":"宇文公谅","text":"秋菊兮青青，丛生兮山下。\n绿叶兮欣荣，纷金英兮楚楚。\n白露降兮百草蘦，蹇孤芳兮孰伍。\n若有人兮苕东，企元亮兮高风。\n苟中情兮永契，旷百世兮相从。\n琴无弦兮尊有醑，南山为宾兮花为侣。\n归来兮归来，微斯人兮谁与！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王叔明破窗风雨图","author":"宇文公谅","text":"刘郎读书如学仙，朝不出户夜不眠。\n时闻破窗风雨夜，正是澄心对圣贤。\n苕溪王子图景象，敬亭山色青连天。\n执经念子最清苦，亹亹论道心相传。\n鸡鸣喈喈天欲曙，疏棂萧飒寒声度。\n庭前漂麦总不知，屋上捲茅宁复顾。\n人生穷达那可知，玉堂金马自有期。\n青藜他日夜相访，却忆破窗风雨时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送复见心住定水","author":"宇文公谅","text":"定水招提鸣鹤东，鉴湖归去泛孤篷。\n钵衣不湿荷花露，玉麈遥生桂子风。\n山静祇看云自动，江澄莫讶水如空。\n沃州有约寻支遁，还许清谈共野翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵承旨玄真观图次易道韵","author":"宇文公谅","text":"天庆重归白发年，儒冠便脱卷吟毡。\n苍龙复佩游三岛，玄鹤还期朝九天。\n灵运谁云先作佛，稚川自信后来仙。\n逍遥今出尘寰外，应笑扬雄尚草玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题小米戏墨卷","author":"宇文公谅","text":"山气郁巃嵷，流云涨林谷。\n乞我茅三间，读书贫亦足。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题仲穆看云图","author":"宇文公谅","text":"横杖坐松下，看云起遥岑。\n惟应陶靖节，会得此时心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其一","author":"宇文公谅","text":"赤栏桥低官柳斜，粉墙短短阿谁家？\n女郎恰抱琵琶出，早有小船来卖花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其二","author":"宇文公谅","text":"奴唱吴歌郎扣舷，明朝郎去有谁怜。\n恨杀吴山遮望眼，不见江头郎去船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其三","author":"宇文公谅","text":"断霞洒洒鱼尾红，清唱一声吴山东。\n阿奴只在绣帘里，隔著荷花无路通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其四","author":"宇文公谅","text":"湖里茭青日日多，苏小门前无客过。\n今来古往只如此，休说当年贾八哥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其五","author":"宇文公谅","text":"湖上交秋风露凉，湖中莲藕试新尝。\n莲心恰似妾心苦，郎意争似藕丝长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词六首 其六","author":"宇文公谅","text":"菱花菱叶间水泓，采莲入港与郎逢。\n劝君挟弹休打鸭，鸳鸯飞起杳无踪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题海岳后人烟峦晓景图二首 其一","author":"宇文公谅","text":"过云含雨湿层峦，江树和烟晓色寒。\n何似清秋凌绝顶，山青云白望长安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题海岳后人烟峦晓景图二首 其二","author":"宇文公谅","text":"米家父子擅名流，一纸千金未足酬。\n本与苏黄为后进，岂知章蔡是同游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵魏公幼舆丘壑图二首 其一","author":"宇文公谅","text":"浊世公子何翩翩，风流丘壑妙当年。\n无端却被邻娃恼，不废啸歌犹自贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵魏公幼舆丘壑图二首 其二","author":"宇文公谅","text":"小斋松雪对青山，波上閒鸥自往还。\n文采风流今不见，空馀粉墨落人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠刘禹玉","author":"刘汶","text":"刘郎方朔徒，游戏紫泥海。\n千年华表非，唯有寸心在。\n向来浙河西，雄辩吞虹霓。\n手携九节杖，东入蓬莱栖。\n我时探禹穴，同看山阴雪。\n千人万人中，怪子独超越。\n朝骑白鼻騧，暮逐油壁车。\n得钱即付酒，携妓颜如花。\n踏翻豪侠窟，醉狎山人家。\n或嘲狂处士，或诮报恩子。\n从渠立名多，讵识子奇伟。\n一朝去乡国，北上争吹嘘。\n家无十金产，袖有万言书。\n所陈果何事，为国非自计。\n宁遭丞相嗔，肯负丈夫志。\n蹉跎十数秋，甘与黄冠俦。\n善藏倚天剑，未暇磨斗牛。\n幡然走山东，隐迹随壶公。\n还寻岱宗去，绝壑凌天风。\n鸡鸣上日观，眼乱扶桑红。\n窥临事未已，逸气横万里。\n行歌齐鲁间，兴为庐山起。\n庐山秀可餐，怡此冰雪颜。\n挥毫洒瀑布，五老开云关。\n远公拍手笑，喜见遗民还。\n乃知士不偶，正可游名山。\n去年卧衡岳，聊憩四海脚。\n厌垂君平帘，懒卖伯休药。\n却呼魏夫人，共把流霞酌。\n今年与山辞，下走湘水湄。\n临风吊贾傅，酹月招湘累。\n文章本疏荡，强忍终技痒。\n光怪不可收，倏忽又千丈。\n有时遇知音，朗咏山中吟。\n复恐儿辈觉，不得容山林。\n兹辰忽聚首，慰我别来久。\n辛勤四十霜，所获竟何有。\n却怀居东时，勇以功名期。\n焉知尚漂泊，筋力供路歧。\n举杯置往念，此去安所之。\n南窥古云阳，更了山川奇。\n山川固娱目，慎勿过幽独。\n奈何白云歌，再送刘十六。\n乾坤渺苍茫，回首眷空谷。\n我将秣其驹，乃不受羁束。\n愿子无遐心，归哉返初服。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸酉除夕","author":"刘汶","text":"此夕何多感，明朝过六旬。\n乾坤又元统，人物少咸淳。\n酒厌山杯渌，梅伤水国春。\n灯前曾戏綵，马首一沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春述怀","author":"刘汶","text":"春与年年别，穷随日日增。\n眼明贪夜读，事少忘晨兴。\n倦鸟犹迁木，潜鱼已陟冰。\n栖迟唯故辙，无梦到飞腾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张伯雨蕉池积雪诗二首 其一","author":"刘汶","text":"铜驼陌上得铜洗，曾见汉朝风露零。\n寒光未变劫灰黑，古色犹带宫苔青。\n金人堕泪漫怀古，玉女洗头真寓形。\n与君作池媚蕉雪，何以报之双玉瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张伯雨蕉池积雪诗二首 其二","author":"刘汶","text":"仙掌金盘列风露，人间琛宝多飘零。\n忽看铜洗土花碧，侧想玉女云鬟青。\n千年偶在聊寓意，万物终毁无逃形。\n吾徒汲古宁玩物，愿子及泉资绠瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄赠华阳洞隐者","author":"刘汶","text":"一日书成四海传，华阳始信有儒仙。\n神交弘景吹笙夜，心在留侯辟谷年。\n重碧拈春瓢贮月，硬黄临帖研分泉。\n山中物色清无限，便拟凌云到洞天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]