ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢伯庸宰水图","author":"凌云翰","text":"桃李家山春欲无，草堂留得望西湖。\n墓门宰木今如许，惆怅临风展画图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅 其一","author":"凌云翰","text":"墨作南枝却耐看，北枝何似怯馀寒。\n诗人不用劳区别，开到春来总一般。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅 其二","author":"凌云翰","text":"飞来峰下雪垂垂，近水人家玉两枝。\n燕子春寒来不得，却教鸿雁见开时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海棠白头翁鸟图","author":"凌云翰","text":"驷马桥边忆旧游，海棠红湿雨初收。\n春禽似识文园令，也向花前叹白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高房山画","author":"凌云翰","text":"尚书京口住经年，每写云山出自然。\n此幅得来如有意，虹光曾射米家船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏海棠","author":"凌云翰","text":"春色三分已二分，海棠红软半梨云。\n银缸休照东风树，愁杀杨州杜使君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三香图","author":"凌云翰","text":"淮山彭泽与沅湘，几度经行揽众芳。\n梦觉广寒环佩远，却将吟笔写秋香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹并梅兰图 其一","author":"凌云翰","text":"卖珠不惜买芳春，山暮天寒翠袖新。\n竹外一枝谁貌得，分明空谷见佳人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹并梅兰图 其二","author":"凌云翰","text":"江上寒梅已报春，幽兰还与斗清新。\n纤毫解把明珠赠，信有湘皋解佩人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画扇面 其一","author":"凌云翰","text":"阿母蟠桃花又红，七香车下五云中。\n群仙奏罢霓裳曲，春满瑶台第一宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画扇面 其二","author":"凌云翰","text":"万户千门锦绣堆，沉香亭北看花开。\n真妃睡足初扶起，更待君王玉辇来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为方仲敏题白云深处","author":"凌云翰","text":"千山万水入登临，犬吠鸡鸣杳莫寻。\n试问白云深几许，仙家更在白云深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"温日观墨蒲萄 其一","author":"凌云翰","text":"风飘露洒一棚秋，路入沧江忆旧游。\n凭伏金壶翻墨汁，老禅胸次有凉州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"温日观墨蒲萄 其二","author":"凌云翰","text":"天风动地拂苍须，摇落骊龙颔下珠。\n一斗竟须浇渴吻，道人从此厌醍醐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋林才子图","author":"凌云翰","text":"木落山林秋满天，蹇驴背上耸吟肩。\n濡桥郑綮曾如此，况是襄阳孟浩然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鉴仲明上人画","author":"凌云翰","text":"老禅曾隐虎跑泉，笔底山林似巨然。\n此是太平真气象，家家茅屋起炊烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画菜","author":"凌云翰","text":"谁写春菘入画图，借如挑得付庖厨。\n此根咬得知滋味，方是人间士大夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诗意扇面","author":"凌云翰","text":"采药仙人去未还，偶逢童子问松间。\n何人解写云山意，不放青团扇影闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题墨菊有怀王士中","author":"凌云翰","text":"采菊东篱事已非，按图长是惜芳菲。\n西斋谩有盈樽酒，惆怅何由见白衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨菊为杨复初赋","author":"凌云翰","text":"黄花韵与墨花同，一洗人间万卉空。\n不许陶潜都占断，守玄聊且效杨雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"裴日英写红梅翠竹","author":"凌云翰","text":"空谷佳人翠袖单，红颜长是怯天寒。\n河东邂逅绯衣子，写作疏花竹里看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张师夔思意图","author":"凌云翰","text":"花木禅房常建诗，吴兴曾为写幽姿。\n龙溪渔子天机熟，见画令人忆旧时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁寒三友图","author":"凌云翰","text":"岁暮天寒雪四垂，竹边松下出斜枝。\n似人又向图中见，方信山阴有戴逵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庄子观泉图","author":"凌云翰","text":"秋水成河灌百川，濠梁何必更观泉。\n欲知无限逍遥意，总在南华第一篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋授之遗墨","author":"凌云翰","text":"宋玉多才赋远游，曾拈彩笔写清秋。\n西风吹断南州梦，翡翠兰苕总是愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二乔观兵书图","author":"凌云翰","text":"不为师婚不动心，肯教铜雀锁春深。\n书中谩识孙吴意，何似同观女史箴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"豳风图","author":"凌云翰","text":"蚕月条桑为茧丝，筑场纳稼应天时。\n欲知王业艰难处，尽在豳风七月诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行春图","author":"凌云翰","text":"野桥村店见青旗，玉勒雕鞍且缓驰。\n十日春光浓似酒，等闲开尽小桃枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨菊","author":"凌云翰","text":"淋漓浓墨染香云，秋色秋光总不分。\n醉眼只疑乌帽落，令人重忆孟参军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忠孝图","author":"凌云翰","text":"葵萼倾心向太阳，萱花树背在高堂。\n忠臣孝子如佳卉，凭伏丹青为发扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]