":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20945,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画  其二 少陵诗意","author":"凌云翰","text":"谁写江村枫树林，草堂如有客相寻。\n野船怪得轻如叶，秋水今朝五尺深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五花马图","author":"凌云翰","text":"八尺乌骓散五花，披图一见重咨嗟。\n何人笔底藏风雨，解使神龙起渥洼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张复初松下垂钓图","author":"凌云翰","text":"春雨朝朝长绿波，桃花时节鳜鱼多。\n遥知松下投竿者，定是当年老志和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐陵墨梅","author":"凌云翰","text":"尽道徐熙似赵昌，墨花有韵却无香。\n诗人又动杨州兴，春色真疑到玉堂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扇面山水","author":"凌云翰","text":"溪抱重山曲曲通，野航长得载诗翁。\n旧时纨扇丹青在，不入凉风箧笥中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"俞碧窗画紫菊","author":"凌云翰","text":"菊有黄花秋满篱，谁看紫艳半开时。\n碧窗分得研朱露，写出无声赵嘏诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"