[{"title":"清心镜 赠马守清","author":"马钰","text":"马姑姑，后归去。\n日用无为，清闲养素。\n休讲论、女姹婴娇，更虎龙斗处。\n屏尘缘，得真趣。\n火灭烟消，气神坚固。\n内云游、功满三田，上蓬莱仙路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠马彦寿","author":"马钰","text":"两亲家，各开悟。\n把从前爱底，观如猛虎。\n认无为、清净家风，并无些作做。\n不悭贪，不喜怒。\n调息均匀，绵绵内补。\n待一朝、行满功成，共携云归去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠王庵主","author":"马钰","text":"养家时，甚情况。\n被妻男逼得，有如心恙。\n竞利名、来往奔波，忒劳嚷劳嚷。\n学道来，常坦荡。\n除性命二字，别无妄想。\n占清闲、自在逍遥，好豁畅豁畅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠长安李先生","author":"马钰","text":"李先生，忒执拗。\n全真堂下，最难训教。\n学修行、不尚扶犁，道我咱偏好。\n再三劝，再四告。\n认取五色祥云，自然耕道。\n种紫芝、灿烂灵光，便得归蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠韦先生","author":"马钰","text":"公清，火戏虚。\n寂寂虎随龙憩。\n莲绽、胜似群花，缘行周济。\n悟回头，真自喜。\n诀无为清净，自然通秘。\n自得、休别追求，人免不讳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠刘小官","author":"马钰","text":"一青牛，二条尾。\n三双眼儿，仰观俯视。\n四个蹄、雪白如银，五方中嬉戏。\n六欲七情俱总废。\n八味琼浆，饮来光明遍体。\n九鼎内、变作神丹，十分功圆备。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠刘先生","author":"马钰","text":"个青牛，引白犊。\n向曹溪深处，往来相逐。\n更时时、卧月眠云，疏凡间草木。\n餐三阳，投九畜。\n子母温柔，免劳看牧。\n待一朝、得赴蓬瀛，显本来面目。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠华亭十殿试","author":"马钰","text":"尹虞卿，樊祖训。\n明仲季蒙，子恂子润。\n汉卿共、信仲官人，乃清河一姓。\n程德容，李汉臣。\n十个吾侪，尽皆文俊。\n劝诸公、名利灰心，早修完性命。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠孙可道","author":"马钰","text":"孙先生，能放下。\n兀兀腾腾，通真弃假。\n处心与、万物无私，略无些谄诈。\n乐清贫，得清雅。\n逗引灵童，惺惺洒洒。\n到如今、好结善缘，水云游行化。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠老程先生","author":"马钰","text":"这程公，顿然悟。\n家有六子，六贼之数。\n细寻思、总是冤家，便不宜团聚。\n弃纱巾，冠戴取。\n捉住马猿，易调龙虎。\n待一朝、丹药灵灵，跨祥鸾归去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠严先生","author":"马钰","text":"大丈夫，真烈士。\n斩钉截铁，一心无二。\n做修行、誓不还乡，遇危难发志。\n清净中，玄妙至。\n日月交光，虎龙参时。\n饮刀圭、保养神丹，应重阳奥旨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠灵一子","author":"马钰","text":"何先生，听仔细。\n未到蓬头，且梳丫髻。\n亦未至、求乞残馀，待悟来许你。\n得定慧，入初地。\n凭仗无染无著，无为活计。\n心清净、通妙通玄，得永成仙契。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠灵阳子李大乘","author":"马钰","text":"灵阳子，来告别。\n送行不似，相迎时节。\n听予嘱、游必有方，待孀毋紧切。\n我人除，烟火灭。\n莫忘初志，旋添决烈。\n行大道、开阐亘初，邀清风明月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠京兆周七官","author":"马钰","text":"周官人，家豪富。\n长安通检，最为上户。\n十年间、兴废何如，无札锥去处。\n叹利名，不坚固。\n使我灰心，转生开悟。\n行大道、一志无移，修不来不去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠侯明一","author":"马钰","text":"侯姑姑，心开悟。\n六旬有九，才方修补。\n众人言、晚了时光，马风道未暮。\n气不断，神可固。\n先把马猿，用功擒住。\n自然得、性命停停，管成仙归去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠荔菲大隐","author":"马钰","text":"修行人，休失错。\n仔细寻思，外乐不如内乐。\n常清净、自有清欢，本来真踊跃。\n无忧愁，无染著。\n自在逍遥，气神辉霍。\n行功成、显个胎仙，便舞归碧落。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠益都府李进","author":"马钰","text":"陇西公，名去病。\n表德去华，道号去尘最紧。\n待悟来、去尽般般，当修完性命。\n心常清，意常净。\n法名更作，谷神相应。\n号通一、亦是相宜，字仙卿相称。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠铁李先生","author":"马钰","text":"陇西公，苦得别。\n六月炉头，掉锤打铁。\n养浑家、都要清闲，独自受炙熁。\n火烧疮，汗滴血。\n万苦千辛，何时是彻。\n马风风、诱引回头，向道门中休歇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠寂然子","author":"马钰","text":"修行人，听子细。\n斋食不可，美之又美。\n更何须、异馔多般，但一味而已。\n恬淡中，常遂意。\n万神调畅、姹婴欢喜。\n得自然、结就金丹，占蓬瀛仙位。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠鄠县小杨仙","author":"马钰","text":"修行人，先禁眼，见他妇女，不宜顾盼。\n牢擒捉、意马心猿，休缓缦缓缦。\n我人除，事情简。\n清贫柔弱，逍遥散诞。\n谨遵依、国法天条，永不犯不犯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠裴大器","author":"马钰","text":"修行人，要心善。\n奈业障相魔，裂他不转。\n十二时、马劣猿颠，没巴避恶念。\n办坚志，常锻炼。\n剿除绝迹，永无征战。\n气神和、清净丹成，得胎仙出现。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠薛道清","author":"马钰","text":"做修行，细搜刷。\n清净家风，便是大乘妙法。\n下无为、无作真功，心镜上摋抹。\n自然明，自然达。\n把九玄七祖，尽行救拔。\n向蓬瀛、坦荡逍遥，冠裳似菩萨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠鞠得一","author":"马钰","text":"河州鞠，听予说。\n把般般术法，便当一撇。\n论自然、大道无为，岂在乎细捏。\n清心镜，常莹彻。\n照破万缘，无生无灭。\n这本来、一点元明，便朗如秋月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清心镜 赠魏害风","author":"马钰","text":"风姑姑，怀秘奥。\n意净心清，头头是道。\n自然得、真乐真欢，并无些烦恼。\n不谄诈，不倨傲。\n玉花丛里，结成金宝。\n便等候、紫诏来宣，应通明仙号。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲","author":"马钰","text":"七十光阴能几日。\n大都二万五千日。\n过了一日无一日。\n无一日。\n看看身似西山日。\n不做修行虚度日。\n悟来岂肯经终日。\n斡运洞天真月日。\n真月日。\n蟾宫里面擎红日。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲","author":"马钰","text":"牛驾重车逢恶路。\n奈人不顾艰难处。\n加力用鞭鞭不住。\n鞭不住。\n牛儿忽作人言语。\n你为养家予受苦。\n我今怜汝须词诉。\n你若今生心不悟。\n心不悟。\n我身便是将来汝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲","author":"马钰","text":"叮嘱庖人常作善。\n殷勤供养人休倦。\n莫把煎汤倾地面。\n摊凉冷。\n恐伤虫蚁行方便。\n日用柴薪并米面。\n无抛无撒无奢俭。\n内外净清忘俗念。\n真堪羡。\n将来决得居仙院。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲 自觉","author":"马钰","text":"梦见娇妻称是母。\n又逢爱妾还称女。\n因为前生心不悟。\n心不悟。\n改头换面为夫妇。\n从此山侗常恐惧。\n那堪更得风仙度。\n决要净清清净做。\n清净做。\n紫芝彼岸通玄路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲 赠众师兄","author":"马钰","text":"奉劝同流听仔细。\n断荤戒酒全容易。\n不恋浮财浑小事。\n深可畏。\n轻轻独著无明起。\n大抵色心难拚弃。\n算来断制须由你。\n便把如雠如活鬼。\n宜远离。\n至于梦寐须回避。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔家傲 赠孙姑","author":"马钰","text":"奉劝孙姑修大道。\n时时只把心田扫。\n杀了三尸并六耗。\n无烦恼。\n常清常净知玄奥。\n休问异名炉与灶。\n冲和上下通颠倒。\n铅汞自然成至宝。\n非常好。\n霞光簇拥归蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菊花新","author":"马钰","text":"碧洞深藏真景致。\n黄白花开金玉异。\n不住有祥云，甘露降、瑞中增瑞。\n孟嘉落帽陶潜志。\n又争知、这头瞻视。\n日日庆重阳，功行满、六铢衣赐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河清 继重阳韵","author":"马钰","text":"师父专专封闭户，非干固济云洞。\n亦非夸衒，能受三冬饥冻。\n为我遇顽恋俗，用机化、玄言必中。\n等待子自悟知其愚，舍家物外拿弄。\n怡然顿觉元初，捐尘累，便烹铅更烹汞。\n于澄湛中，保养神珠为贡。\n直待功成行满，恁时节、携云跨凤。\n赴蓬莱岛，仙童远远来迎羾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河清 继重阳韵","author":"马钰","text":"九曲黄河流转九，阳阴逆顺清净。\n九池之内，涌出龙泉端正。\n九会亘初湛寂，九关现、灵波永定。\n美芝祥瑞天然秀，九茎自是无影。\n九霞覆鼎澄辉，九还火，炼神丹转光莹。\n九玄神，先要救，攀仙肩并。\n九九重阳口诀，暗传得、非凡游泳。\n累真功行将来去，九霄参圣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙","author":"马钰","text":"终日驾盐车，鞭棒时时打。\n自数精神久屈沉，如病马。\n怎得优游也。\n伯乐祖师来，见后频嗟呀。\n巧计多方赎了身，得志马。\n须报师恩也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 咏瓦罐继重阳韵","author":"马钰","text":"瓦罐真真实，须假良工造。\n十二时中下火烧。\n自有三光照。\n大肚物能容，圆正通明道。\n清净法身牢护持，不敢破坏了。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 俗卜算子继重阳韵","author":"马钰","text":"得遇无思算。\n自是能明彖。\n极谢风仙特地来，把我专专唤。\n要脱轮回难，锻炼神光灿。\n真乐真欢永没愁，愿作云霞伴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"因遇出嚣尘，终日常颠耍。\n狂舞狂歌任自然，无意马。\n收得灵灵帕。\n真水涌来高，真火降来下。\n黄鹤洞中仙要成，扶风马。\n两曜交光射。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"清将功夫做，自是生玄露。\n密洒灵苗溉紫芝，渐觉气神住。\n谨谨须当诉。\n决定参随去。\n物外勤修大药成，同上蓬莱路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"大悟明明也。\n大智闲闲也。\n大道行行应自然，风风马。\n永永逍遥也。\n大水高高也。\n大火炎炎也。\n大药辉辉晃宝瓶。\n真真马。\n得得长生也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"一个本来容，妙手应难尽。\n风貌清严神彩英，无意马。\n永永安闲也。\n浮利与浮名，心上何曾挂。\n黄鹤洞中仙子成，乘云马。\n出入常游冶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"不敢心狂走。\n极谢师真守。\n芋栗今番六次餐，美味常甘口。\n不作东牟叟。\n不恋东风柳。\n参从风仙物外游，共饮长生酒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"拯救扶风活。\n逗引扶风耍。\n故遣扶风颠更狂。\n扶风马。\n家累扶风舍。\n业火扶风洒。\n云鹤扶风跨。\n这个扶风灵更灵，扶风马。\n真称扶风也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"传得清虚剑。\n心内深深点。\n木上金丝来往牵。\n马风占。\n更把风摇飐。\n卦象常推渐。\n功行时时检。\n黄鹤沿中仙要成，马风赡。\n日有真灵验。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"火院须当远。\n尘事难为染。\n因遇风仙弃冤亲，做个投真马，得得超彼岸。\n既达逍遥岸。\n炼气如素练。\n专下工夫分假真，做个惺惺马。\n悟道何愁晚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"身是精神店。\n无个人曾叹。\n舍漏垣颓主翁行，也不见他马，怎得闻嘶喊。\n我悟尘头偃。\n富贵无心羡。\n离坎相交玄更玄，搬运动也马，来往如同战。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵","author":"马钰","text":"知味又闻香，因得非凡遇。\n更说祖师两个来，教我修行赋。\n一志访秦川，乡井宁回觑。\n火灭烟消心死灰，名挂神仙簿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵前后各喝马一声","author":"马钰","text":"癸卯到人间，本是非凡兔。\n因为玲珑罚下来，马氏住。\n愿再修行做。\n复遇害风仙，传得深深趣。\n黄鹤洞中仙道成，马风去。\n直指蓬莱路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵藏头","author":"马钰","text":"里悟传灯，炼真如镜。\n把光辉，满载驱风省。\n视风轮莹。\n内显琼釭面。\n灵童静。\n肯婪尘复载驰。\n风惺月仙家景。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄鹤洞中仙 继重阳韵藏头","author":"马钰","text":"日风仙活。\n我惺惺洒。\n去关西阐妙玄，么马。\n宅须当舍。\n利子无价。\n事心难挂。\n德方而著德圆，口马。\n月齐高下。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登仙门","author":"马钰","text":"难也难也。\n舍家难也。\n绝爱憎，屏尘难也。\n处无为清静，有始终难也。\n譬如死，又何难也。\n论玄元，谈微妙，要人听也。\n但小童，肯来询也。\n便须当，开言路，与其进也。\n我不能，保其往也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登仙门","author":"马钰","text":"师也师也。\n重阳师也。\n处玄机，静中清也。\n起金莲，玉花社，有谁知也。\n化人人，渐归道也。\n这扶风，非开悟，亦非愚也。\n辨假真，稍能明也。\n细寻思，心豁畅，略无疑也。\n想师范，没人过也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"超彼岸 继重阳韵","author":"马钰","text":"家缘不藉。\n遇风仙传得，修补清虚之架。\n懒里寻慵，慵里更寻闲暇。\n上街来，除我相，先乞化。\n木人箭指云溪射。\n觉正中周，天通明八卦。\n见粒神丹，灿烂果然无价。\n水云游，访秦川，行教化。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙亭 继重阳韵","author":"马钰","text":"喜喜蓬头。\n达达根由。\n永永誓不贪求。\n渐渐归于正觉，申申燕处优游。\n万万尘缘识破，专专志做持修。\n遇遇风仙传口诀，疑疑涤尽更何搜。\n灿灿不昏幽。\n玉玉金光结，心心愿做渡人舟。\n累累功成行满，真真去访瀛洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙槎","author":"马钰","text":"名成好息心，利遂堪回首。\n猿马不轻狂，龙虎相交媾。\n常教玉户开，莫使金关漏。\n九转大丹成，万劫神清秀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙槎 和师韵","author":"马钰","text":"三光固下元，六度清中阙。\n九转上元灯，照见长生月。\n无分昼夜明，光彩连绵发。\n显出个胎仙，生死今番越。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙槎 继重阳韵","author":"马钰","text":"迷迷苦海游，缘甚尘抛摆。\n深谢本师钩，钓向关西界。\n心无喜与忧，化道崇真快。\n未敢上丹霄，且结金莲会。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙槎 寄晏公","author":"马钰","text":"休心绝是非，灭意除人我。\n酒色气财无，生死轮回躲。\n祥光结宝花，玄露成珠颗。\n自是遇仙槎，便得携云朵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇仙槎 赠清风散人","author":"马钰","text":"勤勤物外修，谨谨心中扫。\n渐渐绝尘缘，细细通玄奥。\n灵灵大药成，灿灿神光好。\n得得遇仙槎，稳稳归蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道成归","author":"马钰","text":"阮郎归改道成归。\n修行人喜知。\n松峰影里乐希夷。\n何须唱艳词。\n姹婴动，虎龙随。\n云耕坎与离。\n三千功满赴瑶池。\n神光相貌奇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道成归 藏头赠岳秀才","author":"马钰","text":"年苦志不求奇。\n公寻者希。\n夷猛悟笑微微。\n华枉用机。\n予偃，婴肥。\n宫祥瑞围。\n传心印谨相依。\n灵神自飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雁灵妙方 本名双雁儿谨继重阳师父韵","author":"马钰","text":"幸遇风仙别东州。\n无萦系，纵云游。\n得真欢乐恣情讴。\n这尘缘，一旦休。\n仿效田单用火牛。\n驾金木，倒颠流。\n大丹光显不持修。\n在迷津，作渡丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感皇恩 继重阳韵","author":"马钰","text":"钟吕遣风仙，专行教化。\n故锁庵门即非假。\n用机诱我，暗剔灵明惺洒。\n脱家风狂做，弃儒雅。\n真个内容，难描难画。\n六铢衣光彩，体披挂。\n手擎丹颗。\n莹莹光明无价。\n盖因传得些，非常话。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]