[{"title":"赠朱万初二首 其二","author":"虞集","text":"延阁晨趋接佩声，又纡朱绂向江城。\n丹心要似东阳水，酿作官壶彻底清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪后偶成","author":"虞集","text":"晓来残雪在陂陁，远似羊群或似鹅。\n忆踏春泥看柳色，驼裘貂帽度冰河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自赞题白云求陈可复所写像","author":"虞集","text":"归来江上一身轻，野服初成拄杖行。\n祗好白云相伴住，天台庐阜听松声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂竹","author":"虞集","text":"忆昔吴兴写竹枝，满堂宾客动秋思。\n诸公老去风流尽，相对茶烟飏鬓丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八骏图","author":"虞集","text":"瑶池积雪与天平，西极空闻八骏名。\n玉殿重来人世换，萧萧苜蓿汉宫城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋前偶赋四首 其一","author":"虞集","text":"一室萧然绝蔽亏，桂香初发自先知。\n已无热恼仍无梦，坐到空林月落时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋前偶赋四首 其二","author":"虞集","text":"空林月落大如盘，鸡犬无声晓气寒。\n童子儗谋朝一食，玉杯盛得露漙漙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋前偶赋四首 其三","author":"虞集","text":"一杯浓露滑如饴，灌溉清凉可疗饥。\n毕力石田嗟已晚，空山何处采灵芝？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋前偶赋四首 其四","author":"虞集","text":"采芝不觉过前山，偶答樵歌莫却还。\n人影自行残照外，雨云先入翠微间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答鲁子晕参政二首 其一","author":"虞集","text":"海风吹雨散晨曦，纨扇高堂两鬓丝。\n想见东南宾客盛，临江酾酒看潮时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答鲁子晕参政二首 其二","author":"虞集","text":"病鹤前年下玉京，空巢聊寄一毛轻。\n白云千载悠悠外，自照寒溪野水清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉龙图","author":"虞集","text":"贝阙澄澄海月生，水晶帘影接空明。\n鲛绡剪得霓裳就，却拥冰髯上太清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠閒白云","author":"虞集","text":"白云东去又经春，每想飞鸿到水滨。\n几个遮山松树子，凭君洒雨洗埃尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"虞集","text":"贝阙珠宫夜不眠，露华浩浩月娟娟。\n不应又作人间梦，窈窕吹箫度碧烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻机杼","author":"虞集","text":"咿哑机杼隔林幽，梦觉江湖忆旧游。\n满地月明凉似水，数声柔橹过扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"溪桥踏雪","author":"虞集","text":"万竹孤亭积雪明，冲寒先到寄高情。\n过桥不是寻常客，共听空山裂帛声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋范德机诗后","author":"虞集","text":"玉堂妙笔交游尽，投老江南隔死生。\n最忆崖州相忆处，华星孤月海波清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送程以文兼简揭曼硕","author":"虞集","text":"故人不肯宿山家，半夜驱车踏月华。\n寄语旁人休大笑，诗成端的向谁誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸酉岁晚留上方观三首 其一","author":"虞集","text":"灯前自了读残经，风入疏帘月入棂。\n坐到夜深谁是伴，数枝梅萼一铜瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸酉岁晚留上方观三首 其二","author":"虞集","text":"偶行幽径岂寻春，忽见丛兰紫茁新。\n幸自林深可终日，莫将香引路行人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸酉岁晚留上方观三首 其三","author":"虞集","text":"山中积雪到檐端，独对篝灯坐夜阑。\n不是梅花心似铁，如何禁得许多寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"田舍","author":"虞集","text":"晨昏车马乱云烟，花下追游亦偶然。\n百舌无声春亦去，萧萧田舍日高眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别燮玄圃后重寄","author":"虞集","text":"郭西山路有寒梅，想见临行首重回。\n夜听雨声知水长，满船明月几时开？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古桧","author":"虞集","text":"根到深泉石作身，疏疏香叶不知春。\n海波不动天风远，千岁寒蛟作老人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万户张公庙堂诗","author":"虞集","text":"于赫世皇，并用豪杰。\n一定宇内，櫜厥戈甲。\n既久既安，成宗继之。\n祖功莫加，道在守持。\n狂夫兴谋，以动相国。\n曰昔祖宗，咸尚战克。\n万方悉来，史皆前能。\n我独无名，曷称继承。\n蠢彼西南，翳丛负固。\n聚落八百，各统女妇。\n人强善骄，马具竞豪。\n豢豕于牢，黄金饰槽。\n取而有之，富可足用。\n赫乎功多，以世智勇。\n相臣以闻，天子曰嘻！\n有是言哉，汝其试之。\n狂谋既售，谏言不入。\n既赋军实，弓钺仍戢。\n馈饟启行，万里骚然。\n饥危蹈毒，未战已捐。\n番番名将，天子爪士。\n镇于江浒，天子所使。\n狂夫忌之，承制驱之。\n讵思国谋，徒逞厥私。\n将军慨言，死我臣职。\n可陷者身，不陷吾直。\n见制鄙庸，岂我召凶。\n心知无还，况冀立功。\n与其矫诬，死彼狂手。\n孰与奋击，不丧吾守。\n孤旅转战，身入不回。\n杀戮既多，身卒死之。\n三军失声，万士丧气。\n孰明公心，君门万重。\n裹革东归，遥遥江壖。\n部曲候迎，悲风旆缠。\n民怀其忠，士感其义。\n虎奋鹰扬，如见其至。\n卜庙得吉，东望际海。\n神来妥之，有永无坏。\n狂夫辱国，天子震怒。\n立呼狂竖，斩以大斧。\n狂罪则诛，死事奈何。\n褒封哀荣，百世不磨。\n岂惟不磨，元嗣御史。\n既有兄弟，又多孙子。\n奕奕勋门，秩秩良材。\n天之报忠，岂有涯哉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金人出塞图","author":"虞集","text":"海风吹沙如捲涛，高为陁碛深为壕。\n筑垒其上严周遭，名王专居气振豪。\n肉食湩饮田为遨，八月草白风飕颾。\n马食草实轻骨毛，加弦试弓复置櫜。\n今日不乐心慅慅，什什伍伍呼其曹。\n银黄兔鹘明绣袍，鹧鸪小管随鸣鼗。\n背孤向虚出北皋，海东之鸷王不骄。\n锦鞲金镞红绒绦，按习久蓄思一超。\n是时皛清天翳绝，鴐鹅东来云帖帖。\n去地万仞天一瞥，离娄属望目力竭。\n微如闻音鸷一掣，束身直上不回折。\n遂使孤飞一片雪，顷刻平芜洒毛血。\n争誇得隽顿足悦，挂兔县狼何足说。\n旌旗先归向城阙，落日悲风起萧屑。\n烟尘满城鼓微咽，大酋要王具甘歠。\n王亦欣然沃焦热，阏支出迎骑小驖，琵琶两姬红颧颊。\n歌舞迭进醉烛灭，穹庐斜转氍毹月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题花鸟图","author":"虞集","text":"吴中女儿颜色好，洗面看花花为悄。\n调朱弄粉不自施，写作窗间雪衣鸟。\n绿窗沈沈春昼迟，半生心事花鸟知。\n花残鸟去人不归，细雨梅酸愁画眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸少监四首 其一","author":"虞集","text":"仍岁从巡幸，山川识重临。\n讲帏来济济，驰道止骎骎。\n五月衣裘薄，诸生坐席深。\n归耕何待老，莫问二疏金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸少监四首 其二","author":"虞集","text":"移跸宫城曙，烟花绕阁重。\n来王俱属籍，称使不传烽。\n赐席还亲问，囊书更手封。\n恐烦宣室召，视日转苍龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸少监四首 其三","author":"虞集","text":"臣甫多愁思，长歌拜杜鹃。\n凿崖通阁道，积水放楼船。\n惆怅霜横野，栖迟雪满颠。\n经行看宿草，碧色自年年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸少监四首 其四","author":"虞集","text":"太平知永日，渐老惜芳晨。\n论说惭孤学，推扬负相臣。\n退思常感慨，拜赐每逡巡。\n郊薮多閒地，馀生托凤麟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉别阿鲁灰东泉学士游瓯越","author":"虞集","text":"忆昔同经幄，春明下玉除。\n挂冠俄去国，连舸总盛书。\n笋脯尝红稻，莼羹斫白鱼。\n莫言江海远，咫尺玉堂庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋山图","author":"虞集","text":"峰迥留深隐，天清袭素袍。\n栖身断人迹，游目送鸿毛。\n树挂栖厓鸷，藤悬饮子猱。\n龙眠石涧冷，虎撼树根牢。\n木客吟时共，山樵弈处遭。\n浮云过水尽，孤月挟霜高。\n羽使来三岛，胎仙舞九皋。\n左招玉斧饮，右揽赤松遨。\n空色收寥廓，虚声起绎骚。\n弹琴遗古散，载酒棹轻舠。\n遂向图中见，谁能世外逃。\n乘槎几月至，一泛九秋涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朱生南归","author":"虞集","text":"喜子南归盱水上，经过为我问临川。\n几家橘柚霜垂屋，何处蒹葭月满船。\n应有交游怜远道，试从父老说丰年。\n寒机早晚成春服，一一平安报日边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归蜀","author":"虞集","text":"我到成都住五日，驷马桥下春水生。\n过江相送荷主意，还乡不留非我情。\n鸬鹚轻筏下溪足，鹦鹉小窗呼客名。\n赖得郫筒酒易醉，夜深冲雨汉州城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自仁寿回成都","author":"虞集","text":"还乡思速去乡迟，王事相縻敢后期。\n里父留看题壁字，山僧打送舍田碑。\n胡桃筇竹南方要，卢橘枇杷上国知。\n此日君亲俱在望，徘徊三顾欲何之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄福建佥宪马叔惠","author":"虞集","text":"荔子枝头火齐红，高堂纨扇坐薰风。\n湘筠簟冷鱼波合，海柏梁深燕雨通。\n络纬岂知秋袂薄，扊扅长忆晓餐同。\n禁城来看花如锦，谁道清霜解恼公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端午节饮客与赵伯高","author":"虞集","text":"龙沙冰井夏初融，簪笔长随避暑宫。\n蜡烛烟轻留贾谊，铜盘露冷赐扬雄。\n南村久病思求艾，北客多情问转蓬。\n忽听满船歌《白苧》，翻疑昔梦倚春鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周昉画美人图","author":"虞集","text":"岛上云生日转櫩，海风吹面暮寒尖。\n春明玉色遗芗泽，夜定珠光入镜奁。\n织得鸳鸯成绿皱，教成鹦鹉啄红甜。\n试令鼓瑟应无语，目断归帆思未忺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋雪洲","author":"虞集","text":"江上经年忆雪多，长洲化作玉坡陀。\n旧时射虎迷蹲石，薄暮归渔认拥蓑。\n河伯作宫龙献璧，湘灵遗佩凤停梭。\n凫鹥容与江花发，更待春来生水波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠道士","author":"虞集","text":"神室谁开自洞微，紫烟为户玉为扉。\n春容淡薄胎仙舞，夜景虚明脉望飞。\n绕指风雷龙睡醒，满囊云锦虎驮归。\n犹嫌长物烦闻见，更上高台一振衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠无尘道人","author":"虞集","text":"云雾为衣月作裳，天坛独自礼虚皇。\n龙收古剑沈秋水，鹤识神丹起夜光。\n金井有声惟坠露，玉阶无色乍凝霜。\n无端下界松风动，又欲飘然上凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉华山","author":"虞集","text":"何处清江拥玉华，手题名榜寄仙家。\n光凝石殿千年雪，影动银河八月槎。\n藏药宝函腾玉气，说诗瑶席散天葩。\n奎章阁吏无能赋，得似新官蔡少霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王庶山水","author":"虞集","text":"蜀人偏爱蜀江山，图画苍茫咫尺间。\n驷马桥边车盖合，百花潭上钓舟閒。\n亦知杜甫贫能赋，应叹扬雄老不还。\n花重锦官难得见，杜鹃啼处雨斑斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画虎图赠真一先生","author":"虞集","text":"猎猎霜风木叶乾，月明曾过越王山。\n青龙久待蟠仙鼎，赤豹相呼守帝关。\n终岁采芝茅阜曲，丰年收谷杏林间。\n谁家稚子能为御？\n长与桃椎共往还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕王阁","author":"虞集","text":"城头高阁插苍茫，百尺阑干背夕阳。\n秋雨鱼龙非故物，春风蛱蝶是何王。\n帆樯急急来彭蠡，车盖童童出豫章。\n灯火夜归湖上路，隔篱呼酒说干将。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京师秋夜","author":"虞集","text":"风竹撼秋声，天寒梦不成。\n如何今夜月，偏照客窗明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王朋梅东凉亭图延祐中奉敕所作草也","author":"虞集","text":"滦水东流紫雾开，千门万户起崔嵬。\n坡陀草色如波浪，长是銮舆六月来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯礼部考试次韵二首 其一","author":"虞集","text":"忆昔坡头接锦袍，深堂披卷效微劳。\n三年重得同清夜，宫烛风帘见月高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯礼部考试次韵二首 其二","author":"虞集","text":"袍鹄锵锵赴晓闱，分庐陈艺别东西。\n凭教红杏休开彻，早晚开关蹋雪泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东家四时词四首 其一","author":"虞集","text":"临流洗砚见长身，白苧宽衣短葛巾。\n纨扇自题新得句，水亭分送倚阑人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东家四时词四首 其二","author":"虞集","text":"摩挲旧赐碾龙团，紫磨无声玉井寒。\n鹦鹉不知谁是客，学人言语近阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东家四时词四首 其三","author":"虞集","text":"澄波千顷拥高鬟，手折芙蓉月下还。\n解忆高堂风露冷，衲衣先送碧云山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东家四时词四首 其四","author":"虞集","text":"贺雪宫门上表归，貂裘犹带六花飞。\n海南新送收香鸟，转觉清寒入翠帷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠傅与砺","author":"虞集","text":"水玉空青不易求，兰苕翡翠擅清秋。\n才情岂是人间少，不到高唐梦未休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪厓桥","author":"虞集","text":"澄江如练碧悠悠，一色芦花覆远洲。\n无尽春天归雁急，月明寒影不曾留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张希孟凝云石","author":"虞集","text":"海口不盈握，隤然如委云。\n危岑集远思，虚窦栖微熏。\n天高泰华断，日出香炉分。\n几研袭清润，文章互絪缊。\n潜雷起神谷，震惊天上闻。\n亟视恐无及，化为九龙文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"朱秀之杞菊轩","author":"虞集","text":"高轩何所植，杞菊交根枝。\n紫实既秋熟，黄花亦晚滋。\n嘉名信共爱，何以疗予饥。\n此邦号富庶，士贾志怀资。\n萧条山石间，谁复见茕嫠。\n遗脱兼并馀，椎剥无完肌。\n纵彼百亩受，岂得安耘耔。\n种此顷步内，庶无征夺思。\n采撷勿违节，烹芼贵有宜。\n三咽可千岁，逍遥奉天随。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送豫章熊太古兼寄苏伯修参政","author":"虞集","text":"豫章有家学，礼乐不见收。\n为养不择禄，凄凉向炎州。\n揽结桂树枝，谁为玉雪谋。\n十年一再见，我老君白头。\n古剑光陆离，系以珊瑚钩。\n激昂文史间，未愧班马俦。\n苏君天下士，定价琳琅球。\n江汉方渺然，为我观素秋。\n长吟以相送，明月在高楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李伯时九歌图","author":"虞集","text":"太乙神君号东皇，玉质要妙含和阳。\n生生气始通微茫，绵绵蒸空神中央。\n浮英上罗文天章，覆冒下满谷与坑。\n旁塞无间灵无方，灵来乘柔往乘刚。\n湘君夫人镇相望，清温静好非淫伤。\n司命元老元气昌，手执藜杖色老苍。\n历劫寿命不可量，少君之寿同其长。\n离无异体合有常，出入万化终不亡。\n晶明发晨上榑桑，海天赫赫真金芒。\n质鍊不灭长垂光，河源混混流汤汤。\n伯也坐视无迎将，千古万古何堂堂。\n彼幽为厉为强梁，朝狸暮豹方鸱张。\n精魂熠耀志意荒，招之不反巫无良。\n屈生作歌沈九湘，世人传声罕寻详。\n祝融仙子调玄黄，九神出图百怪藏。\n不信请视虞公章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吕教授还临川","author":"虞集","text":"黄金作台留好客，好客不留秋月白。\n东风吹雪满衣襟，却赋长歌送行客。\n辽东之山医巫闾，六月五月雪不除。\n昨朝遣使降香去，五尺冰上行飞车。\n知君江上惯舟楫，快马如龙亦徒设。\n束取来时一卷书，还向江波对明月。\n我本蜀人随水来，结屋与子相邻隈。\n白发京尘不归去，临风相送兴悠哉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城南春晓图","author":"虞集","text":"天台先生有山癖，卧起无山朝不食。\n几年骑马听朝鸡，磊磈诸峰拄胸臆。\n陈生受意不受辞，竟拈秃笔为扫之。\n既安楼观对奇石，复著梁栈横清漪。\n游吾旧游钓吾钓，隔林彷佛闻幽鸟。\n琼台何处无桃花，此是城南暮春晓。\n夜来天子传诏呼，先生直上銮坡趋。\n盘盘回复一万里，无限好山并好水。\n如从岛上见陈生，尽写归来画堂里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金马图","author":"虞集","text":"贾胡自骑千金马，解囊小憩荒城下。\n平原无树起秋风，梦到阴山雪横野。\n太平疆宇大无外，外户连城无闭夜。\n不然安有独行人，怀宝安眠如画者。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]