[{"title":"未开牡丹","author":"张弘范","text":"包藏国色与天香，尽使游蜂自在狂。\n直待百花零落后，旋誇魏紫共姚黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"红梨花","author":"张弘范","text":"嫣然带雨湿胭脂，却似去年霜叶时。\n说与谪仙浑不识，向人谁咏雪香诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅雨","author":"张弘范","text":"轻云薄薄暗江干，几阵纱窗送嫩寒。\n浓醉呼童新摘得，未黄梅子已微酸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送春","author":"张弘范","text":"东君回驭欲何之，把酒江头话别离。\n流水泛红留不住，尽教沈醉不须思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"垂丝海棠","author":"张弘范","text":"环儿宴罢沈香下，困奇东风绿树阴。\n可是醉头扶不起，低垂芳脸谩沈吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拆鞦韆","author":"张弘范","text":"画柱青苔卧寂寥，綵绳无计恋春娇。\n可怜明月梨花院，閒煞春风第一宵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"花落","author":"张弘范","text":"流水无情来洞口，狂风何意恋枝头。\n惜花人在东风外，更比莺儿燕子愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"红叶","author":"张弘范","text":"怪来清晓霜如雪，一夜千林染猩血。\n豪气如虹酒似川，直教醉脸红如叶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚归","author":"张弘范","text":"笑谈尊俎兴何穷，鲸吸琉璃琥珀浓。\n沈醉戟门归去晚，月明街静一声钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"压沙怀古 其一","author":"张弘范","text":"秦宫汉苑为功名，梵寺何由也废兴。\n试问雪香庭上月，向人脉脉不能应。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"压沙怀古 其二","author":"张弘范","text":"桃花惯听玄都观，万树梨花是压沙。\n一夕春风俱埽地，雪香庭下尽桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春寒","author":"张弘范","text":"去岁清明花簇檐，今年寒食尚凝严。\n往来忙煞蜂儿翅，偷采崖花酿蜜甜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚凉","author":"张弘范","text":"绿阴庭院半昏黄，月窟风来桂子香。\n好挈一壶呼李白，扁舟归去醉沧浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"榴花","author":"张弘范","text":"猩血谁教染绛囊，绿云堆里润生香。\n游蜂错认枝头火，忙驾薰风过短墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"效吕洞宾步虚词 其一","author":"张弘范","text":"紫微朝罢下天关，稳跨青鸾落世间。\n两袖春风何处去，洞庭东畔有三山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9885,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"效吕洞宾步虚词 其二","author":"张弘范","text":"踏遍尘寰天外天，兴亡万劫入幽玄。\n尽教鸡晓钟催夜，一点虚名日月先。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9886,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"效吕洞宾步虚词 其三","author":"张弘范","text":"俯视王侯一介轻，愚聋人世可怜生。\n阴阳纵有难拘束，惟恨人间落姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9887,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚蝉","author":"张弘范","text":"三生齐女旧精魂，哭断残阳雨后村。\n千古闺愁无处著，断肠声里又黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9888,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落霞","author":"张弘范","text":"夕阳红影衬云衣，一段龙文锦不机。\n诗在滕王高阁下，半天孤鹜与齐飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9889,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骤雨 其一","author":"张弘范","text":"沧海龙飞霹雳惊，云间电影万蛇明。\n六丁怒挽天河水，特为人间洗甲兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9890,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骤雨 其二","author":"张弘范","text":"风拥黄云龙驾海，雷驱紫电雨翻盆。\n长虹千丈忽截断，一片风波起市门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9891,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪谷早行图 其一","author":"张弘范","text":"短衣匹马五更寒，老雪荒山去路难。\n为问此行成底事，要携春色下长安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9892,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪谷早行图 其二","author":"张弘范","text":"马驼残梦过前溪，云锁空山雪四垂。\n勋业本从辛苦得，可怜歌酒富家儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"问梅","author":"张弘范","text":"东风桃李竞春光，何苦前村雪里芳。\n孤洁不教尘眼涴，野桥斜月自昏黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆梅","author":"张弘范","text":"记得年时雪后村，月明诗酒共黄昏。\n自从别后无消息，一片相思入梦魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春信","author":"张弘范","text":"庾岭梅花喷雪香，灞桥烟柳弄鹅黄。\n故乡望断无消息，独倚东风雁数行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读书灯","author":"张弘范","text":"半窗寒雨夜深深，烧断兰膏一寸金。\n莫笑十年尘壁上，也曾明破圣贤心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋张伯宁义士图","author":"张弘范","text":"刺襄豫让不日死，立武程婴冠青史。\n燕山义士张伯宁，千古英名高二子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"张弘范","text":"气吐长虹志未摅，剑华生涩土模糊。\n收藏好在甘无用，夜半荒鸡待一呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泛舟","author":"张弘范","text":"半岸澄波雨后平，一篙软绿信流行。\n满船明月双瓶酒，歌入荷花深处横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水鸥","author":"张弘范","text":"万里长江两白鸥，溶溶泄泄恣沈浮。\n一般都在春风里，反不如他得自由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落花","author":"张弘范","text":"莫为春归怨子规，百花开尽是飞时。\n算来只是东君罪，不合当时着力吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题采莲图","author":"张弘范","text":"小娃采得白莲还，此个工夫有底难。\n多少桑间辛苦妇，谁人移向画图看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"投宿","author":"张弘范","text":"荒村投宿马悤悤，暂歇离鞍古院中。\n酒尽一杯春日暮，吟鞭轻袅兴无穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9904,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题曹娥庙","author":"张弘范","text":"一夕为亲犹尽孝，若为男子事君何。\n江淮多少英雄将，厚禄肥家学倒戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9905,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"霜月早行","author":"张弘范","text":"霜满溪桥月满山，哦诗驴背怯清寒。\n那知年少青楼客，醉拥芙蓉梦未阑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9906,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"压沙怀古","author":"张弘范","text":"巳闻春日雪生香，更着秋来叶醉霜。\n到此春秋无一物，不堪回首吊兴亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9907,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过江","author":"张弘范","text":"磨剑剑石石痕裂，饮马长江江水竭。\n我军百万战袍红，尽是江南儿女血。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9908,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春月","author":"张弘范","text":"分破黄昏绿柳烟，娟娟落影卧鞦韆。\n休誇八月中秋夜，桃杏香中更苦怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9909,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳眉 其一","author":"张弘范","text":"似敛还舒嫩觉羞，隋堤如为古今忧。\n翠尖管取传春意，莫向长亭管别愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9910,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳眉 其二","author":"张弘范","text":"睡起纱窗对晓奁，暂时初识远山尖。\n多情笑煞张京兆，应恐香螺涴玉纤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9911,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海棠","author":"张弘范","text":"风卷晴霞空树头，东皇西去太真愁。\n可怜零落胭脂色，绿叶争如枝上稠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9912,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白莲","author":"张弘范","text":"洒泪湘妃不喜妆，和烟迷月涨秋塘。\n翠盘影里呈妍白，恨煞诗人玉有香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9913,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"佳人昼寝图","author":"张弘范","text":"午枕风微雾縠凉，日长睡损玉霓裳。\n此生幸免春蚕苦，何事无心到绣床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9914,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"守一卷头","author":"张弘范","text":"世事翻腾尽万般，一心长拟泰山安。\n酒壶书卷林泉意，更要诗人仔细看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9915,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 题亳州武津关","author":"张弘范","text":"忆谯都风物，飞一梦，过千年。\n羡百里溪程，两行堤柳，数万人烟。\n伤心旧家遗迹，谩斜阳，流水接长天。\n冷落故祠香火，白云泪眼潸然。\n行藏好向故人传，椽笔舞蛮笺。\n总纠纠貔貅，秋风江上，高卧南边。\n功名笑谈尊俎，问锦江何必上楼船。\n他日武津关下，春风骄马金鞭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9916,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 征南三首 其一","author":"张弘范","text":"混鱼龙人海，快一夕，起鹍鹏。\n驾万里长风，高掀北海，直入南溟。\n生平许身报国，等人閒、生死一毫轻。\n落日旌旗万马，秋风鼓角连营。\n炎方灰冷已如冰，馀烬淡孤星。\n爱铜柱新功，玉关奇节，特请高缨。\n胸中泠然冰雪，任蛮烟瘴雾不须惊。\n整顿乾坤事了，归来虎拜龙庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9917,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 征南三首 其二","author":"张弘范","text":"功名归堕甑，便拂袖，不须惊。\n且书剑蹉跎，林泉笑傲，诗酒飘零。\n人间事、良可笑，似长空、云影弄阴晴。\n莫泣穷途老泪，休怜儿女新亭。\n浩歌一曲饭牛声。\n天际暮烟冥，正百二河山。\n一时冠带，老却升平。\n英雄亦应无用，拟风尘、万里奋鹏程。\n谁忆青春富贵，为怜四海苍生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9918,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 征南三首 其三","author":"张弘范","text":"乾坤秋更老，听鼓角，壮边声。\n纵马蹙重山，舟横沧海，戮虎诛鲸。\n笑入蛮烟瘴雾，看旌麾、一举要澄清。\n仰报九重圣德，俯怜四海苍生。\n一尊别后短长亭。\n寒日促行程，甚翠袖停杯。\n红裙住舞，有语君听。\n鹏翼岂徒高举，卷天南地北日升平。\n记取归来时候，海棠风里相迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9919,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"满江红 襄阳寄顺天友人","author":"张弘范","text":"奔驿南来，拥貔貅，且趋江右。\n良自愧，劣才微渺，圣恩洪厚。\n万里长江今我有，百年坚壁非他守。\n看虎牙，飞上万山头，诛群丑。\n风雨梦，乡关友。\n南北事，君知否。\n寄一缄梅信，小春时候。\n夜静戟门严鼓角，月明莲幕閒诗酒。\n怕故人，相忆问归期，平蛮后。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9920,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 其一","author":"张弘范","text":"千古武陵溪上路，桃花流水潺潺。\n可怜仙侣剩浓欢，黄鹂惊梦破，青鸟唤春还。\n回首旧游浑不见，苍烟一片荒山。\n玉人何处倚阑干，紫箫明月底，翠袖暮云寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9921,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 其二","author":"张弘范","text":"爱煞林泉风物好，羡他归去来兮。\n世缘相挽又还思，功名当壮岁，疏懒记当时。\n肝胆自知尘辈异，凤池麟阁须期。\n风云满目任时宜，东山高卧处，丝竹醉吴姬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9922,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 其一 咏海棠","author":"张弘范","text":"醉脸匀红，向人无语誇颜色。\n一枝春雪，犹染嵬坡血。\n庭院黄昏，燕子来时节。\n芳心折，露垂香颊，羞对开元月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9923,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 其二","author":"张弘范","text":"庭院黄昏，子规啼破开元梦。\n晚风吹动，似舞霓裳弄。\n有色无香，好著诗人讽。\n和谁共，月廊烟重，烧彻兰膏凤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9924,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 其三","author":"张弘范","text":"星斗文章，词源落落倾胸臆。\n十年南北，几度空相忆。\n把酒留君，后会知何夕。\n愁如织，一鞭行色，春雪梅花驿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9925,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 其四","author":"张弘范","text":"春日前村，一枝香彻江头路。\n月明风度，清煞西湖句。\n昨夜幽欢，梦里谁呼去。\n愁如许，觉来无语，青鸟啼芳树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9926,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 其五","author":"张弘范","text":"独上高楼，恨随春草连天去。\n乱山无数，隔断巫阳路。\n信断梅花，惆怅人何处。\n愁无语，野鸦烟树，一点斜阳暮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9927,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 其一","author":"张弘范","text":"深院日初长，万卷诗书一炷香。\n竹掩茅斋人不到，清凉，茶罢西轩读老庄。\n世事莫论量，今古都输梦一场。\n笑煞利名途上客，乾忙。\n千丈红尘两鬓霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9928,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 其二 送刘仲泽寿","author":"张弘范","text":"天地萃英灵，秀出人龙问世生。\n不只文章为第一，峥嵘，气吐虹霓万丈横。\n白褐黑头卿，埋灭黄尘气未平。\n昨夜长庚高似月，分明，光照乾坤彻五更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9929,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 其三 赠歌妓","author":"张弘范","text":"浅淡汉宫妆，扇底春风玉有香。\n特地向人歌一曲，非常，纵使无情也断肠。\n宝髻绣霓裳，云雨巫山窈窕娘。\n好著千金携得去，何妨，丝竹东山醉玉觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9930,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 其四 送友人刘仲泽北归","author":"张弘范","text":"烟草入重城，马首关山接去程。\n几度留君留不住，伤情，一片秋蝉雨后声。\n无语泪纵横，别酒和愁且强倾。\n后会有期须记取，叮咛，莫负中秋夜月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9931,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 其五 寄刘仲泽","author":"张弘范","text":"音信怪来稀，世态时情固自宜。\n莫比红尘儿女辈，须知，义士交情死不移。\n应是占花期，箫鼓东城醉玉姬。\n谁念书生寒屋底，伤悲，忍泪窗前听子规。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9932,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引","author":"张弘范","text":"晚凉庭院锁黄昏，鼓角静谯门，酒兴恋诗魂。\n清绕断，梅梢月痕。\n胸中豪气，壶中春色，醉眼小乾坤，今古不须论。\n且更尽，花前几尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9933,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 其一","author":"张弘范","text":"山掩人家水绕坡，野猿岩鸟太平歌，黄鸡白酒兴偏多。\n幸自琴书消日月，尽教名利走风波，钓台麟阁竟如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9934,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 其二","author":"张弘范","text":"一片西风画不成，无人来此结茅亭，野猿山鸟乐升平。\n名利著人浓似酒，肝肠熟醉不能醒，黄尘奔走过浮生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9935,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 其三","author":"张弘范","text":"新卜西山崦下庄，疏篱编竹草苫堂，门前流水柳成行。\n满目烟岚诗酒地，十年鞍马是非场，虚名半纸几多忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9936,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青玉案 寄刘仲泽","author":"张弘范","text":"西风天际征鸿去，问曾过，燕山路，叶落虚庭空绿树。\n一川秋意，满怀愁绪，楼外潇潇雨。\n天涯望断行云暮，好著蛮笺寄情句，底是相思断肠处。\n吟风赋月，论文说剑，无个知音侣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9937,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐四首 其一","author":"张弘范","text":"关河南北，有雁无消息，落日楼头人正忆，啼鸟一声山碧。\n莺莺燕燕争春，红尘马足车轮，惟有新丰豪客，东风老泪沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9938,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐四首 其二","author":"张弘范","text":"高眠窗北，偃卧喧雷息，依约关山归路忆，梦绕池塘春碧。\n功名负我青春，悤悤日月奔轮，且把琴书归去，山林道发儒巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9939,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐四首 其三","author":"张弘范","text":"天南地北，何日兵尘息，四海升平归老忆，凤远岐山空碧。\n衣冠滚滚争春，谁能卧辙攀轮，一剑风云未遂，几回怒发冲巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9940,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐四首 其四","author":"张弘范","text":"穷冬冷落，客思添萧索，浊酒沽来须强酌，要把閒愁推却。\n时间荣辱何惊，胸中气象休更，且匣风云长剑，天容两鬓青青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9941,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜春来","author":"张弘范","text":"金装宝剑藏龙口，玉带红绒挂虎头。\n旌旗影里骤骅骝，得志秋，喧满凤凰楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9942,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"殿前欢 襄阳战","author":"张弘范","text":"鬼门关，朝中宰相五更寒。\n锦衣绣袄兵十万，拔剑摇环，定输嬴，此阵间。\n无辞惮舍性命，争功汗，将军战敌，宰相清閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9943,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]