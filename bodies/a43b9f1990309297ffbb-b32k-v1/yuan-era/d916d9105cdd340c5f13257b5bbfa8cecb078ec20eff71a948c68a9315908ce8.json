[{"title":"题叠山卷","author":"丁复","text":"江山老骨归元亮，今古何心两伯夷。\n半夜寒增霜院酒，一编孤愤雪楼辞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题春山晓行","author":"丁复","text":"短棹冲烟钓碧沙，疏钟开曙散群鸦。\n早年曾是匡庐道，下马春厓问酒家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦游仙","author":"丁复","text":"春风捲席苍鳌近，夜月笙箫紫凤鸣。\n童女三千发如黛，碧桃花下笑相迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马德昭席上赋","author":"丁复","text":"江上重逢邹大娘，桃花红嫩染纤裳。\n蔓青溪上曾相见，犹记胡麻饭颗香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵江南 其一","author":"丁复","text":"斗酒十千即可赊，斜窗短篱谁为遮。\n大妇相迎问买酒，十五小姑方主家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵江南 其二","author":"丁复","text":"东山断雨拂青龙，江饮倒垂千丈虹。\n忽地北风狂作恶，小波高涌白银宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵江南 其三","author":"丁复","text":"长干城南越王台，长干桥下客船来。\n桥边有人问书信，罗裙小步踏青苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和山行兼次韵","author":"丁复","text":"山鹊翅翻红两两，野花香并翠双双。\n倦行有客春伤酒，笑索无题昼倚窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因刘思绩过江寄□诚之","author":"丁复","text":"泽国无官寄老□，淮方有客借寒驴。\n早知到死难干禄，何用平生苦读书。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵泐上人 其一","author":"丁复","text":"薝卜花时风雨急，苾刍丛里脊令寒。\n丹沙自古有方术，白日今谁生羽翰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵泐上人 其二","author":"丁复","text":"白发萧骚日夜生，玄云消尽雪霜明。\n新栽花木可怜长，旧著衣裳不忍更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋蕙花次韵岳上人","author":"丁复","text":"香满松房夜月虚，紫蕤悬露泣方诸。\n湘魂故恼维摩定，起和离骚扫壁书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱舜举画马 其一","author":"丁复","text":"玉禾久饫出天闲，引看时常占舞班。\n四十年来太平日，属车无数剑中山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱舜举画马 其二","author":"丁复","text":"二十年前燕市客，黄尘蔽天相逐来。\n中有出头先一丈，山中彷佛忆龙媒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道山水","author":"丁复","text":"层峰高出云树外，飞溜直下天河悬。\n江南老客肠空断，旧宅不归三十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题雪水茶卷子","author":"丁复","text":"驿舍情孤兰自花，貂冠骨相袖中麻。\n党家婢子陶家妾，学士方惭雪水茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶题","author":"丁复","text":"一事不能方近古，六经何用更知新。\n唐虞时世君臣会，李杜文章宰相嗔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酒间赠贾西白","author":"丁复","text":"思入东风白雨边，暮云春树两茫然。\n不因绛灌轻新进，未必长沙识少年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题唐马图","author":"丁复","text":"凤膺龙脊渥洼姿，正是奚官得意时。\n野老步行身自稳，诏书新下不教骑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题子昂竹石图为赵叔敬作","author":"丁复","text":"大雅堂前第一峰，廉纤小雨养新浓。\n前年醉把湖州酒，坐对萧萧日下舂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题壁上山水","author":"丁复","text":"老年归思不堪行，苦忆江城万里程。\n须写绿醅三百盏，恐添白发数千茎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题美人卷","author":"丁复","text":"玉山横管泪痕光，绣褥双回綵凤凰。\n百巧心情题不得，九疑云冷隔三湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道","author":"丁复","text":"仙客鲸鱼没海涛，绿梢清夜月还高。\n或传骑去招丹凤，想见归来掣六鳌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙远晴波浅漾金鱼苗初上小如针将船载酒江头饮水柳千株满岸阴 其一","author":"丁复","text":"自爱江头著雨蓑，山光倒染鸭头波。\n蛮商即似天上下，打鼓向人帆侧过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙远晴波浅漾金鱼苗初上小如针将船载酒江头饮水柳千株满岸阴 其二","author":"丁复","text":"江蓠初长杜若新，紫蕙红兰洲渚春。\n楚天正远欲有遗，江上独行逢故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf91