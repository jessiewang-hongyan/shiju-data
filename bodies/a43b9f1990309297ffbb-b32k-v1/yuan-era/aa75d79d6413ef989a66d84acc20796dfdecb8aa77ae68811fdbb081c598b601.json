[{"title":"折梅","author":"李孝光","text":"短棹扁舟泊钓台，寒梅一树倚云开。\n折花非为添题品，要看春从何处来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜闻开经筵口号","author":"李孝光","text":"封事如蚕照绿函，九关虎豹静眈眈。\n天垂赤县神州外，地入黄旗紫盖南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人兼简丁仲容","author":"李孝光","text":"忽忆龙河水西寺，两株桂树绕千回。\n若见阿苏烦借问，汝耶何日浙东来？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹","author":"李孝光","text":"翠袖临风一怅然，雨馀草木亦娟娟。\n东头夜半明月出，照见蛟龙石上眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日登应天塔","author":"李孝光","text":"宝林寺里应天塔，老子题诗最上头。\n九日登高望南北，青天咫尺是神州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳桥渔唱","author":"李孝光","text":"杨柳桥头杨柳青，西边即是越王城。\n城中大官听艳曲，半是美人肠断声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴王纳凉图","author":"李孝光","text":"六月长洲水殿凉，酒酣挥袖倚新妆。\n芙蓉露冷秋云薄，回首西风响屧廊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游艮岳","author":"李孝光","text":"一沼何堪役万民，一峰将使九州贫。\n江山假设方成就，真个江山已属人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕中怀古章贡侍御","author":"成廷圭","text":"娉婷二八女，绝色妙难画。\n新妆薄铅华，照影修竹下。\n盛年事夫婿，锦玉耀精舍。\n虽非伯鸾妻，惓惓惜春夜。\n琴馀月当轩，默默倚风榭。\n寄语东家儿，红颜莫轻嫁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李子威代祀嵩衡淮海","author":"成廷圭","text":"群生望甘泽，五岳云气通。\n天香落岩谷，瑞霭春冥濛。\n海潮天际来，金碧森万峰。\n划落紫翠堆，亭亭玉芙蓉。\n古庙丝竹存，迎神奏黄钟。\n空山递馀响，落花舞青童。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人归桐江","author":"成廷圭","text":"读书不谒万乘君，挟策肯傍诸侯门。\n啸歌苏台晚山碧，濯足洞庭秋水浑。\n千金未易买骏骨，一饭岂足哀王孙。\n风尘拂衣且归去，高卧桐江烟水村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王止善归茅山","author":"成廷圭","text":"句曲仙人止善君，乱离何处避尘氛。\n独乘一苇淩沧海，谁共三茅管白云。\n丹井洗瓢分石髓，宝函封检秘天文。\n他年定有方壶约，几夜苏台候鹤群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游平江瑞光寺","author":"成廷圭","text":"水殿云廊取次开，不论庐阜与天台。\n窗间燕雀驯相近，池上龟鱼唤亦来。\n春雨久荒红药圃，香烟遍烧碧莲台。\n上方似可容吾隐，也伴高僧坐石苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送学无遇长老归江南","author":"成廷圭","text":"新赐袈裟染茜红，拈花消息悟灵峰。\n大开海会容三教，远致嵩呼祝九重。\n贝叶有书驮白马，葛藤无语问黄龙。\n湖船满载燕山月，归照招提万树松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱万户归泉南","author":"成廷圭","text":"八月归来下泽车，将军此意复何如。\n十年不佩封侯印，万卷惟收教子书。\n风月祇今尊有酒，江湖何处食无鱼。\n建溪为谢罗从事，久不题诗寄竹居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊顾野王故居","author":"成廷圭","text":"宝云寺里旧祠堂，自汲清泉酬野王。\n白马有神嘶古道，青衣无梦到禅床。\n尘销坏壁书千卷，土蚀残碑字几行。\n欲借《玉篇》遗稿看，山僧无语立斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈朝桧","author":"成廷圭","text":"千年老桧上青霄，三阁花飞不动摇。\n香骨自来盘左纽，苦心未忍弃前朝。\n蛟龙并立江云黑，鸾凤双啼海雾消。\n想得龟蒙题咏处，殿头风雨正萧条。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪幻霞云松图","author":"成廷圭","text":"九峰只在泖云西，松下来寻隐者栖。\n隐者不归空见画，满山风雨夜猿啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正二十一年春三月二日同孙大雅张孟肤縻仲明登虎丘访居中禅师不遇留题平远堂","author":"成廷圭","text":"三月二日春增华，泛舟也到王珣家。\n山中碧泉似?醁，岩下绿草如袈裟。\n荒坟无人见白虎，新城有树啼青鸦。\n居中老禅不得会，空索剑池同煮茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠绫锦墩隐者钱庆馀","author":"成廷圭","text":"手拄乌藤五尺长，山行时著古衣裳。\n缺文自补云间志，卖药多收海上方。\n茆屋秋风催酿秫，锦墩春雨看移桑。\n野人笑指长安路，马足车尘有底忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王晋卿蜀道寒云","author":"吴镇","text":"蜀道何年辟，猿猱若畏攀。\n云依□木静，梵呗禅关閒。\n野店市未散，斜傍河梁间。\n行人自南北，飞鸟互往还。\n鸡鸣遍村落，舟行溜潺潺。\n青松纷满目，夕阳并在山。\n谁云画图表？\n徒然见一班。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王晋卿万壑秋云","author":"吴镇","text":"众山互回绕，芳丛满苍壁。\n墅猿啼树红，林鸟巢筠碧。\n云来拥翠鬟，泉泻激古石。\n吟翁自拘拘，行人走役役。\n归舟向东去，炊烟上空灭。\n前村未掩门，不知日将夕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里山水长幅","author":"吴镇","text":"宋室有千里，疑自蓬莱宫。\n绘事发天性，深研境益工。\n山高藏石磴，洞古青蒙丛。\n秋风遍林壑，万树叶欲空。\n唯有松与石，不改岁寒穷。\n行行何处客，岂是商山翁。\n临江有虚阁，一望波溶溶。\n轻舟徐荡漾，西岭夕照红。\n荆关为揖让，二李堪与同。\n庸物奚足数，新图不易逢。\n当年置长府，珍秘更为崇。\n书竟发长啸，两腋来清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马远虚亭渔篴图","author":"吴镇","text":"虚阁延凉飔，唯闻芳草气。\n渔艇出沧浪，弄笛仍遗世。\n山鸟为飞鸣，游鱼顺流去。\n幽人午睡馀，翛然信高致。\n何物马生图，会得其中趣。\n展阅不能忘，赋得工五字。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹自题","author":"吴镇","text":"图画书之绪，毫素寄所适。\n垂垂岁月久，残断争宝惜。\n始由笔研成，渐次忘笔墨。\n心手两相忘，融化同造物。\n轩窗云霭溶，屏障石突兀。\n林麓缪槎牙，禽鸟翥翰翮。\n可怜俗浇漓，摸摩竟纷出。\n装禠杂真赝，丹粉誇绚赫。\n千金易敝帚，十袭宝燕石。\n米也百世士，赏会神所识。\n伶伦世无有，奇响竟寥寂。\n良乐难再遇，抱恨长太息。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"招仙词题高彦敬云山卷","author":"吴镇","text":"空山兮寂历，石气蒸兮茏葱。\n人家兮水末，望鸡犬兮云中。\n水流兮花谢，淹冬春兮无穷。\n江亭兮石濑，漱霭兮深松。\n山中人兮归来，飒长啸兮天风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"右丞春溪捕鱼","author":"吴镇","text":"前滩罾兮后滩网，鱼兮鱼兮何所往。\n桃花锦浪绿杨村，浦溆忽闻渔笛响。\n我行笠泽熟此图，顿起桃源鸡犬想。\n不如归向茅屋底，老瓦盆中醉春酿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪谷子楚山秋晚","author":"吴镇","text":"洪谷仙去五百年，丹青流落何翛然。\n九疑之山何突兀，乱云惨澹秋风前。\n寻幽忽有蓬莱仙，歌声隐约清溪边。\n萧萧木叶下无际，不见归来张季船。\n前村后村高复下，远渚近渚断又连。\n夕照迟迟俯西川，树底人家起碧烟。\n卷中妙境无穷已，挥毫聊尔纪新篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"董源夏山深远","author":"吴镇","text":"北苑时翻砚池墨，叠起烟云隐霹雳。\n短缣尺楮信手挥，若有蛟龙在昏黑。\n南唐画院称圣功，好事珍藏裹数重。\n崇山突兀常疑雨，碧树萧森迥御风。\n鸟啼花落不知处，渔唱樵歌遐迩度。\n展舒不尽古今情，未容肉眼轻将赋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕夏山仙馆","author":"吴镇","text":"苍厓过雨流青玉，万朵芙蕖红间绿。\n松枝摇动碧帘风，兰舟徐度回塘曲。\n画阁朱楼设翠褕，银床冰簟上流苏。\n美人绣倦频来往，仙侣长吟聊自娱。\n羽扇不挥尘不到，博山麝脑香犹袅。\n新蝉惊破北窗眠，幽禽啼断林间巧。\n竹烟浮翠荐龙团，树影当庭映日圆。\n晚来两两寻幽客，应识溪声六月寒。\n图中景物非人世，如此丹青谁得似。\n屈指流传四百年，宣和赏识标忠恕。\n人间何处无炎歊，火云照耀未能消。\n高斋展对殊未已，一片凉飔落素绡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李成江村秋晚","author":"吴镇","text":"咸熙画图无与共，传世希微爱者众。\n二李之后已寥寥，宣和当日尤珍重。\n新图一旦落人间，神宫寂寞何时还。\n经营意匠出尘表，上下五百谁能攀。\n水回中有渔舟泊，山顶崇台招白鹤。\n篱根浮出水潺潺，万竹琳琅奏天乐。\n霜飞木落一天秋，栖禽向晚声啾啾。\n柳溪错认渊明宅，过桥岂是王弘俦。\n景色萧条如太古，路僻村深贮烟雾。\n分明再见辋川人，芜词何敢轻为附。\n清容自是鉴赏家，持将却向天之涯。\n几回试展未能去，落尽庭前无数花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"米友仁画卷","author":"吴镇","text":"元章笔端有奇趣，时洒烟云落缣素。\n峰峦百叠倚晴空，人家掩映知何处。\n归帆直入青冥濛，曲港荷香有路通。\n更爱涪翁清绝句，相携飞上蓬莱宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"米元晖画卷","author":"吴镇","text":"烟光与山色，缥缈想为容。\n不知山色澹，为复烟光浓。\n虎儿断入图画中，凭阑展卷将无同。\n但令绝景长在眼，从渠绝霭随春风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李昭道春江图","author":"吴镇","text":"晴江一望春山高，日光荡漾翻银涛。\n白云冉冉向空落，长天漠漠归鸿号。\n岸上垂杨覆瑶草，征帆直指长安道。\n蛟龙不动两耳清，花落莺啼人自老。\n鸱夷当日溯烟波，凉风万里来天河。\n李侯久向层冥去，丹青散逸将如何？\n宣和当日珍藏固，三百馀年撚指过。\n危君不让米南宫，置之武库尤加护。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里画","author":"吴镇","text":"猗欤千里诸王孙，画图犹见二李存。\n盘回虚阁凌空起，苍郁长林来雨繁。\n仙姬仙客居绝境，试展殊觉晴云翻。\n持向故山茅屋底，咫尺却拟蓬莱根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居深趣图","author":"吴镇","text":"猗欤太史诸王孙，生绡画出昆仑根。\n枯槎菌蠹厄野火，溪园秋雨琅玕繁。\n天寒岁暮碣石馆，囊书日见玄云翻。\n持向故山茅屋底，倚看屈曲大江奔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹窝","author":"吴镇","text":"阿香怒鞭箨龙尾，班鳞蚀去痕未洗。\n天风吹作万琅玕，翠压修林收不起。\n林深有客栖寒烟，玉版已悟禅中禅。\n人间赤日迥不到，著我六月秋泠然。\n青云欲飞霖雨急，佩环声里双蛾泣。\n玉箫惊起老龙眠，夜染潇湘半江碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水竹山居图","author":"吴镇","text":"结茅山阴溪之曲，最爱轩窗对修竹。\n四时谡谡动清风，三径萧萧戛寒玉。\n也知一日不可无，彼且恶乎免尘俗。\n夜深飞梦绕湘江，廿五清弦秋水绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陆探微层峦曲坞","author":"吴镇","text":"六法斯图见，神奇指掌分。\n万峰凝翠霭，一水弄清纹。\n树密猿啼苦，桥回鸟唤群。\n溪边有茅屋，处处挂斜曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阎立本西岭春云","author":"吴镇","text":"西山高五台，缥缈出蓬莱。\n春半花争发，宵征客倦来。\n短桥流曲水，危壁覆苍苔。\n宣庙曾留赏，临风愧匪材。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋岭归云","author":"吴镇","text":"峰色秋还好，云容晚更亲。\n瀑泉落霄汉，霜树接居邻。\n静处耽奇尚，消閒觅旧因。\n悠悠桥畔路，终日少风尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴道玄五云楼阁","author":"吴镇","text":"碧树围青幄，群峰列嶂来。\n卿云分五色，鹊观倚三台。\n仙客乘春至，山翁向暮回。\n高深无限思，之子总神材。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王右丞雪溪图二首 其一","author":"吴镇","text":"晓径沾衣湿，登台试屐危。\n乾坤增壮观，江海得深期。\n历乱瑶华吐，纷披玉树枝。\n精微谁与并？\n顾陆颇相宜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王右丞雪溪图二首 其二","author":"吴镇","text":"碧树拥江扉，朱帘卷翠微。\n崇朝无客过，傍晚有渔归。\n岭耀梅重白，堤萦絮正飞。\n若留清夜赏，铅粉更光辉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"右丞辋川图三首 其一","author":"吴镇","text":"潇洒开元士，神图绘辋川。\n树深疑垞小，溪静见沙圆。\n径竹分青霭，庭槐敛暮烟。\n此中有高卧，敧枕听飞泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"右丞辋川图三首 其二","author":"吴镇","text":"画里诗仍好，萦回自一川。\n湖晴岚气爽，浪静柳阴圆。\n赋咏成珠玉，经营起雾烟。\n当年满朝士，若个在林泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李昭道画卷","author":"吴镇","text":"人爱山居好，何如此际便。\n家规仍小异，幽致更超然。\n暮霭映高树，柴扉绕细泉。\n新图不可再，展阅忆唐贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关仝秋山凝翠","author":"吴镇","text":"绝壁孤亭迥，千峰落日曛。\n沙明江上树，客带洞前云。\n市散鸡鸣远，村荒犬吠闻。\n一天秋色好，多向此中分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵大年秋村暮霭","author":"吴镇","text":"曲磴平冈外，遥峰落照沈。\n人家三径僻，烟树几村深。\n渔唱流寒碧，樵歌步夕阴。\n悠然怀旧侣，山馆散清音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵松雪重江叠嶂二首 其一","author":"吴镇","text":"江色千重碧，烟光无限青。\n数峰横翠黛，一径入层扃。\n倚市柳为幄，迎人花自馨。\n征帆遥点点，渔唱起沧溟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵松雪重江叠嶂二首 其二","author":"吴镇","text":"摩诘诗兼画，斯图若比肩。\n江深烟浪接，山出晓云连。\n柳市疏钟断，花林青旆悬。\n鸥波风日好，瞻对使人怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子久为危太朴画","author":"吴镇","text":"子久丹青好，新图更擅长。\n浮空烟水阔，倚岸树阴凉。\n咫尺分浓澹，高深见渺茫。\n知君珍重意，愈久岂能忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王维终南草堂","author":"吴镇","text":"昔人谢政后，生事此山中。\n树洒虚堂雨，泉飞隔浦风。\n喜无舟楫至，旋有鹤猿通。\n应识无声妙，临窗展未穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕仙山楼观","author":"吴镇","text":"叠嶂云仍起，崇山境转幽。\n溪云千顷雪，松籁一林秋。\n长啸临朱阁，清游卧石楼。\n桥回泉溜远，消尽古今愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李成寒林图","author":"吴镇","text":"岭高霜自结，风劲入寒时。\n日落晚山碧，林空流水悲。\n栖鸦寻树早，瘦蹇下冈迟。\n无限黄尘满，幽栖总不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野望","author":"吴镇","text":"平林方漠漠，野水正汤汤。\n苍莽日欲暮，年华客异乡。\n草店月初冷，村路迂更长。\n渡头人散后，渔父正鸣榔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"董源小幅","author":"吴镇","text":"烟水冥迷山远近，高山临水更清寒。\n茆堂深倚林中搆，商舶遥从海岛还。\n云起乱峰生巧思，鸟飞残照入遐观。\n生绡仅尺无穷意，谁识经营惨澹间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顾恺之秋江晴嶂","author":"吴镇","text":"从来六法重长康，染得新图更郁苍。\n万顷远横秋镜阔，千重林立彩云长。\n村村鸡犬鸣晴昼，两两樵渔话夕阳。\n无限风烟谁得似？\n欲将此处付行藏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陆探微员峤仙游","author":"吴镇","text":"梅阁重重翠绕遮，时时云气飐平沙。\n千峰树色藏朝雨，百道江声送晚霞。\n洞古数留仙子迹，溪回深护羽人家。\n遨游每忆无尘地，咫尺仍堪阅岁华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张僧繇翠嶂瑶林","author":"吴镇","text":"前峰突兀后峰攒，万木彫残景色阑。\n仙馆无人清磐杳，瑶蹊有客碧萝寒。\n一缣点染空青远，六法精深秀色团。\n寄语故人珍袭处，僧繇还属画中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张僧繇霜林云岫","author":"吴镇","text":"六朝画史知无几，吴下僧繇独擅场。\n百叠苍峦浮障起，千林绀叶入云长。\n低回野渡钟声远，寂寞荒村树影凉。\n咫尺披图更萧瑟，短词何敢遂揄扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢鸿仙山台榭","author":"吴镇","text":"尘踪何得此中游，无数青山绕殿头。\n炉篆浮烟朝霭霭，溪云连树晚油油。\n花香曲径群麛聚，芸芷平田独鹤游。\n欲识仙家真乐处，一泓清濑四山秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵干春林曲坞","author":"吴镇","text":"亭下人家带远岑，乔林无处不沈沈。\n垂杨拂岸青归候，繁杏依村鸟度音。\n桥外行人寻旧侣，湖边逸客散幽心。\n江南绝胜应难纪，何似图中景更深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]