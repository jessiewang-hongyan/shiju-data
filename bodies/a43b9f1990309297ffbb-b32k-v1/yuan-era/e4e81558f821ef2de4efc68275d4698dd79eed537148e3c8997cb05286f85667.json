[{"title":"南乡子","author":"王哲","text":"富贵与身贫。\n肯把荣华只取仁。\n前定缘由今世用，心纯。\n自是阴功福自臻。\n休更苦中辛。\n恶业休贪作善因。\n奉劝愚迷须省悟，休嗔。\n万事由天不在人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"王哲","text":"百载镜中容。\n仰手为祥覆手凶。\n生死荣华今在目，休逢。\n疾速回心认祖宗。\n得得妙相从。\n灭尽三尸九个虫。\n一气浩然调养正，冲融。\n免击精蓝过世钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 于公索幻化","author":"王哲","text":"幻化色身绕。\n电脚余光水面泡。\n忽有忽无遄速甚，如飙。\n过隙白驹旋旋飘。\n何不悟虚嚣。\n早早回头养玉苗。\n苗上金丹光泼泼。\n彰昭。\n透过云衢入碧霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 风琴","author":"王哲","text":"妙手喜新成。\n十六条弦别有名。\n挂在宫中云外路，风迎。\n便许能招自己声。\n不入俗人聆。\n占得仙音讲道经。\n唯我傍边全善听。\n叮咛。\n携尔蓬莱在玉庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 邵公索要下手修行","author":"王哲","text":"我命不由天。\n熟耨三田守妙玄。\n甘雨泽深先布种，金钱。\n遍地黄芽最色鲜。\n养就玉花莲。\n叶叶分明永永坚。\n琼蕊被风吹撒动，香传。\n一道灵光任自然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子 诫人礼拜","author":"王哲","text":"堪叹这顽夫。\n空恁区区用力粗。\n五体相逢投地面，休遇。\n尚自劳劳礼假躯。\n在道本虚无。\n玄里藏玄妙不敷。\n内有元光人不识，唯吾。\n日日观瞻自吸呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南柯子","author":"王哲","text":"会叹风中烛，能嗟水上沤。\n一生一灭几时休。\n恰似轮回，来往业沦流。\n知有驴和马，非无骡与牛。\n等闲扑入怎抽头。\n幸得人身，急急做真修。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南柯子","author":"王哲","text":"白鹭江心立，乌龟水底钻。\n红鸡翡翠竹间攒。\n四件将来，锅内炼成丹。\n五味调和美，重楼信任餐。\n充盈六腑得宁康。\n养就真神，跳跃入仙坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恨欢迟","author":"王哲","text":"名哲排三本姓王。\n字知明、子号重阳。\n似菊花、如要清香吐，缓缓等浓霜。\n学易年高便道装。\n遇渊明、语我嘉祥。\n指蓬莱、云路如归去，慢慢地休忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挂金灯 刘蒋庵","author":"王哲","text":"好池亭，华丽于中莹。\n善修外景。\n装成内景。\n这两事、谁能省。\n谨按黄庭缉整。\n表里通贤圣。\n水心炎炎，火焰猛劲。\n溉炼出真清净。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昭君怨","author":"王哲","text":"奉报早离火院。\n弃了一家攀恋。\n自在水云前。\n乐安然。\n便结长生煅炼。\n得做上仙亲眷。\n搜出碧潭玄。\n月团圆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昼夜乐","author":"王哲","text":"百炼青铜圆又小。\n平平正吐灵耀。\n向人前、相对相观，别辨容颜分晓。\n好丑□妍并老少。\n尘凡一齐勘校。\n彼此假中来，怎生通内貌。\n别有辉辉亲密要。\n焕心镜、主玄妙。\n偏能会、显古腾今，又能鉴、从前虚矫。\n艳艳光辉宜自效。\n把当初、性珠返照。\n里面得全真，永明明了了。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昼夜乐 藏头","author":"王哲","text":"金相隔休教错。\n年间怎生作。\n前头说甚惺惺，辰下重安手脚。\n被蟾光晷运交，平时从根摸索。\n事有神功，清强气跃。\n下于予寻倚托。\n文上没丹药。\n天知命惟高，中谈谈中别著。\n公决要觅清凉，兆府城南登阁。\n各得其宜，昼欢暮乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳梢青","author":"王哲","text":"天然米精麦髓。\n谁得快悟予知奥旨。\n保养冲和，增添灵慧。\n更兼神水。\n三光秀气通传，应助正、真阳本始。\n结作金丹，明明归去，亘初家里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"王哲","text":"可惜娇儿，惺惺伶俐聪明作。\n灵台廓。\n圆明光烁。\n我许蓬莱约。\n断却麻绳，正好修丹药。\n如今却。\n买条铜索。\n缚住踏云脚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 赠友人","author":"王哲","text":"观公形貌，青春伶俐真惺洒。\n偏幽雅。\n自然婴姹。\n莫放猿儿耍。\n认取清闲，异日成佳话。\n之乎者，便休书写，养就丹无价。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祝英台 咏骷髅","author":"王哲","text":"无事闲行郊野过。\n见棺函板破。\n里头白白一骷髅。\n独潇洒愁愁。\n为甚因缘当路卧。\n往来人诽谤，在生昧昧了真修。\n这回却休休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神光灿","author":"王哲","text":"金关叩户，玉锁扃门，闲里不做修持。\n杳默昏冥，谁会舞弄婴儿。\n睡到擒猿捉马，醒来后、复采琼芝。\n每依时，这功夫百日，只许心知。\n自在逍遥做就，唯舒展红霞，光彩敷披。\n罩定灵明，方见本有真葱。\n一粒神丹结正，三重焰、紧紧相随。\n过瑶池。\n透青霄，顶上无为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绛都春","author":"王哲","text":"天然省悟，此一遇转增，清凉尤憬。\n定里铅汞结就，都缘壬逢丙。\n元初面目成琼颈。\n返照长生安静。\n速令归去，前程已许，久通坚永。\n好景。\n光传焕炳。\n见空外万门道，银霞齐整。\n渐渐近来，相接相迎，须臾顷。\n蓬莱路阐神仙境。\n有个金童邀请。\n谨持玉诏，亲教害风受领。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耍蛾儿","author":"王哲","text":"不会修行空养肚。\n肾肺心肝脾祖。\n五团臭肉怎为主。\n先把黄婆咄去。\n赶退青龙兼白虎。\n不用婴儿姹女。\n诸公要觅长生路。\n别有一般门户。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耍蛾儿","author":"王哲","text":"如会修行寻捷路。\n开阐全真门户。\n汞知铅见作宗祖。\n管取性停命住。\n便是阴阳颠倒数。\n今日分明说谕。\n只依四个字儿做。\n指日得归仙去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茶瓶儿","author":"王哲","text":"孝顺先知金母。\n更无能、背爹寻父。\n朝朝供养排簋簠。\n便认得、自家宗祖。\n呼儿女。\n骑龙虎。\n正好与神为主。\n惺惺奉侍归紫府。\n也管录、姓名仙簿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺圣朝","author":"王哲","text":"修行须是身衣布。\n受寂寥餐素。\n道心不与众心同，绝忧愁思虑。\n内中认取金乌聚。\n并开明玉兔，赤鸾抱住黑龟精，这些儿谁悟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺圣朝","author":"王哲","text":"仲冬佳节，灵童来报，阳气初升。\n黄芽齐吐，玉浆浇溉，荣布层层。\n甲方琼秀，庚方金彩，相间星能。\n把明珠祥艳，瑞光迎在，云外腾腾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"迷神引","author":"王哲","text":"偶暇追游，无凝碍。\n独望锦波青岱。\n回头处、忽见荒林外。\n一堆儿，骷髅卧，绿莎内。\n孤惨谁为主，与排赛。\n空衒双眸阐，上尘塞。\n雨洒风吹，日晒星光对。\n转业增添，重重载。\n异乡域，甚方客，何年代。\n遭遇迷神引，怎生奈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山会","author":"王哲","text":"白光生，青□至，红辉总好。\n腾玄耀妙黄深奥。\n般般彩色，把明珠覆焘。\n晴空外、来往仙道。\n封成永号。\n便受玉皇宣诏。\n云霞里、上真唯到。\n香山会聚，发琼方阐道。\n同归去、长住三岛。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"剔银灯","author":"王哲","text":"今与重添惺惺。\n只是那亘初元性。\n急急修持，盈盈圆满，子细剔开周正。\n通玄传令。\n炼煅出、自然清静。\n一颗明珠堪敬。\n就上揩磨精莹。\n不则本师，三真共至，更有虚空贤圣。\n齐来俱庆。\n这仙子、此中前定。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏云峰","author":"王哲","text":"做修持。\n应不在、端坐子午双时。\n铅汞自然要结，只用真慈。\n捷中玄径，谁会得、独我怡怡。\n密妙放、闲闲坦荡，微细推移。\n渐令灵曜吐奇。\n变霞彩、光艳还照相随。\n盖缘昔堪宜。\n白云深处，元正是、地肺明师。\n便许共、丹霄直上，同处无为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏云峰","author":"王哲","text":"守株林。\n无作用、空处独卧高岑。\n石枕草衣偃仰，极目观临。\n水桃山杏，随分吃、且盗阳阴。\n款款脱、尘躯俗状，三叠琴心。\n舞胎仙论浅深。\n自然见、不须重恁搜寻。\n已通玄妙，得步琼林。\n玉花丛里，从此便、养透真金。\n莹静与、清风皓月，长做知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恣逍遥","author":"王哲","text":"气全神神燕坐。\n来与四方聚课。\n说灵根坤对过。\n平恁么。\n么妙自无人我。\n戟锋交，平相贺。\n中宝结成一颗。\n是惺惺，清没和。\n津负荷。\n须用这个那个。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恣逍遥","author":"王哲","text":"若要修行，须当子细，把金关玉门牢闭。\n上下冲和，位交溉济。\n得来后，惺惺又同猜谜。\n混入虚空，却投根蒂。\n亳光在、烂饮霞际。\n五彩新鲜，真灵莹腻。\n分明彻，净清阒然细细。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恣逍遥","author":"王哲","text":"物物拈来，般般打破。\n惺惺用、玉匙金锁。\n沥沥澄源，炎炎焰火。\n盈盈处，上下倒颠换过。\n妙妙神机，玄玄性果。\n清清做、静中堪可。\n现现虚空，灵灵真个，明明衮，光莹宝珠一颗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恣逍遥","author":"王哲","text":"摆脱浊醪，凭传清水。\n这滋味、香甜真美。\n过得重楼，全无滓秽。\n五门开、浇淋就中忒锐。\n七宝滋荣，三田溉济。\n十分用、刀圭和秘。\n结作真晶，明明殊丽。\n山峰上、风月共邀出世。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恣逍遥 承杜先生传语","author":"王哲","text":"识攒上身憔悴。\n难解怎生远体。\n元固壮还养气。\n精麦髓。\n骰润任缘欢喜。\n诵经书，捐名利。\n圭法且休整理。\n锤金锁，窠紧闭。\n关要洗。\n须认分中闲贵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悟南柯","author":"王哲","text":"芋栗今番彻，贤愚两共餐。\n一能阳气做团圆。\n一个沉沦阴魄，愈摧残。\n来者归清净，迷人俗冗盘。\n通全跳入好仙坛。\n恰恰同居。\n吉吉永相看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"换骨骰","author":"王哲","text":"幼慕清闲，长年间、便登道岸。\n上高坡细搜修炼。\n遇明师，授秘诀，分开片段。\n堪赞。\n真性灵灿灿。\n也兀底。\n功行双全，占逍遥、出尘看玩。\n睹长天、化成仙观。\n向云中，有一个，青童来叫唤。\n风汉。\n凡骨骰换换。\n也兀底。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"换骨骰 叹贪婪","author":"王哲","text":"叹彼人生，百岁七旬已罕。\n皆不悟、光阴似箭。\n每日家，只造恶，何曾作善。\n难劝。\n酒色财气恋。\n也兀底。\n福谢身危，忽尔年龄限满。\n差小鬼、便来追唤。\n当时间，领拽到，阎王前面。\n憨汉。\n和骨骰软软。\n也兀底。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"换骨骰 叹脱祸不改过","author":"王哲","text":"昨遇饥年，为甚累增劝教。\n怎奈向、人人忒□。\n越贪心，生狠妒，百端奸巧。\n计较。\n骋风流卖俏，也兀底。\n忽尔临头，却被阎王来到。\n问罪过、讳无谈矫。\n当时间，令小鬼，将业镜前照。\n失尿。\n和骨骸软了。\n也兀底。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"换骨骰 赠道友王十四郎","author":"王哲","text":"一斩红崖，按阔狭、方能及丈。\n横染架、细如秆杖。\n在中间，谁做下，柴窝圆样。\n被拉浪。\n里面把龟儿放。\n也兀底。\n拟欲前行，恐失脚、怎生敢向。\n退后来、全无抵当。\n谩摇头。\n空摆尾，万般惆怅。\n转悒怏。\n和壳儿软胀。\n也兀底。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"捣练子，害风哥。\n一身跃出死生波。\n哩啰凌，哩啰凌。\n便是逍遥真自在，没人拘管信吟哦。\n哩啰凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"开心月。\n圆皎洁。\n人前教我怎生说。\n啰哩凌，哩啰凌。\n净清水，玲珑雪。\n交光朗照知明哲。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"水中金。\n忒幽深。\n玄玄妙妙怎生寻。\n啰哩凌，哩啰凌。\n从初得，到如今。\n西风时复送清音。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"潭底月，雪中霜。\n有人会得便风狂。\n啰哩凌，哩啰凌。\n泉底樚，水中金。\n尖竿尖上细搜寻。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"捣练子，十怎生。\n闲来闲去好修行。\n啰哩凌，哩啰凌。\n若逢迎，得圆成。\n从头一一说前程。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"名利海，是非河。\n王风出了上高坡。\n哩啰凌，哩啰凌。\n才候十年功行满，白云深处笑呵呵。\n哩啰凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"一为人。\n做凡身。\n四般假合怎生真。\n啰哩凌，哩啰凌。\n搜玄路，出迷津。\n静中调养气精神。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"搜芳翠，哂轻盈。\n蓦然听得卖花声。\n艳阳天，气候明。\n朝云白，晚风清。\n遮藏吹转蕊珠精。\n放馨香，满树荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"重阳子。\n全真理。\n阴阳颠倒怎生使。\n啰哩凌，哩啰凌。\n这头行，那头止。\n冲和上下分明是。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"此圆通。\n住虚空。\n冥冥杳杳怎生穷。\n啰哩凌，哩啰凌。\n分南北，看西东。\n悟来只在笑谈中。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"三丹宝。\n难分剖。\n昏昏默默怎生保。\n啰哩凌，哩啰凌。\n在虚空，长怀抱。\n绯衫裹了新乌帽。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"猿骑马，呈颠傻。\n难擒难捉怎生舍。\n哩啰凌，哩啰凌。\n慧刀开，齐下杀。\n教君认得根源也。\n哩啰凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"用刀圭。\n剖昏迷。\n合和一处怎生携。\n啰哩凌，哩啰凌。\n人头落，现红霓。\n白莲花朵出青泥。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"从来性，本来命。\n无形无质怎生惺。\n啰哩凌，哩啰凌。\n汞中明，铅中莹。\n霞光里面通贤圣。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"水兼火，坎和离。\n两般消息怎生知。\n啰哩凌，哩啰凌。\n休烧炼，莫修持。\n元来只是这些儿。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子","author":"王哲","text":"捣练子，真了了。\n闲行闲坐任歌叫。\n啰哩凌，哩啰凌。\n我咱知，人难晓。\n曲中有个三光照。\n啰哩凌，哩啰凌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃园忆故人","author":"王哲","text":"琉璃枝上琼花皓。\n蓓蕾间成玛瑙。\n乌玉叶儿偏好。\n四件谁能讨。\n静中认得真家宝。\n艳彩诚非草草。\n唯有个人知道。\n共得归蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"会看虚空七宝圆。\n能开寂静六华轩。\n希夷微妙在坤乾。\n理透阴符三百字，搜通道德五千言。\n害风一任害风虔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"浮世都怜假合身。\n劝人认取里头人。\n本来面目好相亲。\n返照回光知去处，逍遥自在乐天真。\n锐然颖脱出嚣尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"空里追声枉了贤。\n水中捉月事同然。\n隔靴抓痒越孜煎。\n纽石作弦何日抚，钻木待火几时然。\n恰如撅地觅寻天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"一个词儿十二金。\n修行谨按日时寻。\n急将猿马紧牢擒。\n五户自然开阐尽，玉花丛里洞门深。\n旧来那个是知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"大道无名似有名。\n达磨面壁九年清。\n释迦坐雪六年精。\n夺得真空真妙用，一通门里出圆明。\n大罗天上聚圆成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"耕熟晶阳一段田。\n九还七返五光全。\n清清净净显新鲜。\n物外闲人云外客，虚中真性洞中仙。\n晴空来往步金莲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"王哲","text":"绿水傍边上雪山。\n锐然跳出玉门关。\n虚中空外一开颜。\n渺邈那边归正路，的端便是稳居间。\n白云难比此清闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]