[{"title":"读史 其四","author":"吴当","text":"灭仇报主已成功，还定三秦众策同。\n西楚能存韩社稷，赤松无迹到关中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其五","author":"吴当","text":"四海为家辨本支，大封同姓奠邦基。\n留侯漫使储君固，遗毒无端及爱儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其六","author":"吴当","text":"女祸几令社稷危，安刘一语已先知。\n良平无术强根本，功在诸君左袒时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其七","author":"吴当","text":"盖世功名意气雄，楚齐国大势难容。\n从容进退知天道，一邑封留事赤松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其八","author":"吴当","text":"先汉雄词后世无，子云学业冠西都。\n大醇难掩终身玷，直笔凄凉莽大夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其九","author":"吴当","text":"草罢玄经雪满头，美新兴颂不深谋。\n千年遗恨曾投阁，金谷何人肯坠楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其十","author":"吴当","text":"桐江波上有渔蓑，东汉流风节义多。\n大器已移名独在，犹将公论作干戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其十一","author":"吴当","text":"九夷辟地识遗贤，白帽端居木榻穿。\n卓行至今推有道，建安词藻漫流传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其十二","author":"吴当","text":"天自西倾水自东，三分割据识英雄。\n仲谋有子曹郎在，盖世功名仅汉中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其十三","author":"吴当","text":"一方僻险控孙曹，兵术相疑治道高。\n尚父鹰扬身未死，讵应典午得称豪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其十四","author":"吴当","text":"六朝才气苦厌厌，归去辞高义独严。\n忧世乐天真有道，千年处士晋陶潜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"礼乐 其一","author":"吴当","text":"束帛难招鲁两生，奉常绵蕞乱纵横。\n满朝将相轻年少，治道难因礼乐行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"礼乐 其二","author":"吴当","text":"伦纪无章古道昏，哇声乱耳讵堪论。\n千年不睹真儒效，空忆河间礼乐存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"连旬大雪 其一","author":"吴当","text":"瘦骨棱层病未安，江天风雪夜漫漫。\n布衾铁石浑无寐，难得梅花入梦看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"连旬大雪 其二","author":"吴当","text":"平施翠壑与丹崖，风磴云门处处埋。\n直待东风花尽发，却寻布袜踏青鞋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"可叹 其一","author":"吴当","text":"忠义曾书宋两都，一时直笔共描摹。\n万方顺逆苍天在，遗臭难称莽大夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"可叹 其二","author":"吴当","text":"汉水生波郡邑墟，空传楚魄葬江鱼。\n前年节钺秋江上，满纸祈哀逐客书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"可叹 其三","author":"吴当","text":"碧桃红杏艳阳天，礼聘相期举按贤。\n肠断关河时听雁，琵琶却在卖茶船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩题 其一","author":"吴当","text":"上林高处凤凰栖，羽翮垂云五色辉。\n黄竹雪深梧影落，山鸡临水炤毛衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩题 其二","author":"吴当","text":"日出扶桑海不惊，曾将巨钓掣鲵鲸。\n一蓑回首秋江上，卧听兰苕翡翠鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩题 其三","author":"吴当","text":"香炉峰色白巉巉，黄独无苗雪满镵。\n燕子经年江上别，东风回首听呢喃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五老峰","author":"吴当","text":"五老峰前雪未消，烟岚染处夕阳挠。\n沽来尊酒寻梅树，钓得江鱼上柳条。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日感旧 其一","author":"吴当","text":"南楼谯鼓北楼钟，楼外泥牛綵仗丛。\n黄道泰阶春浩荡，苍龙观阙晓曈昽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日感旧 其二","author":"吴当","text":"麒麟烟树凤凰毛，列侍趋朝礼独劳。\n中使传宣排内宴，御园春动乐声高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日感旧 其三","author":"吴当","text":"春盘生菜翠如丝，内赐金幡映白髭。\n前度桃花何处去，故园花草不胜思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日感旧 其四","author":"吴当","text":"照眼榴花酒入唇，愁颜衰鬓又逢春。\n御沟冰泮河鱼美，惆怅江波有钓纶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春思","author":"吴当","text":"虎迹烟村少室墟，羊肠尘路太行车。\n上林应射春归羽，江海累臣有帛书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夕","author":"吴当","text":"几年别却帝城傩，种树书传郭橐驼。\n华盖芙蓉秋色里，钓竿犹伴旧时蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其一","author":"吴当","text":"东驱海若百年傩，尚度龙沙几两驼。\n春雨莘郊留负耒，秋风渭水起渔蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其二","author":"吴当","text":"燕歌赵舞国人傩，塞下牛羊塞上驼。\n烟草随营飞猎骑，毡城无地挂耕蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其三","author":"吴当","text":"紫髯都护气降傩，姬妾毡车橐载驼。\n马挏浓於燕市酒，貂裘多似野人蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其四","author":"吴当","text":"金目横戈夜进傩，锦幪负毂晓鸣驼。\n灯前尽理朝天佩，林下谁缝钓雪蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其五","author":"吴当","text":"仪凤青娥杂戏傩，肉峰翠釜荐珍驼。\n碧桃天上云千树，白发江头雪一蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其六","author":"吴当","text":"未踏猖狂举世傩，长安紫陌望铜驼。\n陶公门外犹存菊，严子滩前不解蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其七","author":"吴当","text":"尘眼争看楚俗傩，书灯独对汉时驼。\n歌声无复渔家傲，处处金章换绿蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其八","author":"吴当","text":"赤子妖成绛帻傩，皇都尘接紫关驼。\n故人风雪谁联骑，野老江湖独拥蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与同馆戏续前韵 其九","author":"吴当","text":"蛮隶横过绝类傩，海艘任载岂烦驼。\n杜鹃花外春连屋，布谷声中雨一蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦登书阁","author":"吴当","text":"匡卢晴雪自㠝岏，万里清江一棹寒。\n自笑老来情思别，九天楼阁梦中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏归 其一","author":"吴当","text":"看云不用买山钱，带雨宜翻种秫田。\n白发数茎非故态，青山何日是归年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏归 其二","author":"吴当","text":"荷花香里白鸥飞，绿树浓阴拂石矶。\n一枕清风长夏簟，云边何日钓船归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏归 其三","author":"吴当","text":"稻畦黄处树多红，山色岚光紫翠通。\n茅屋数间流水外，一丝何日对秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏归 其四","author":"吴当","text":"苍松翠竹映溪沙，溪上寒梅树树花。\n十月瓮头春酒熟，杖藜何日到山家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"讲仪","author":"吴当","text":"山城马足动红尘，杂沓晨趋服色新。\n绵蕞草仪谁所具，伤心半是大廷臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长生院作寿 其一","author":"吴当","text":"蓬莱云气合从龙，肠断关山几万重。\n水落城空山未晓，长生院里鼓逢逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长生院作寿 其二","author":"吴当","text":"天秩民彝不可磨，伤心蚁穴与蜂窠。\n无端紫绶红尘里，犹说先朝第几科。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李节妇田氏 其一","author":"吴当","text":"仙李移根雨露边，青春江汉共风烟。\n千年事往蟠桃熟，黄竹歌传阿母筵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李节妇田氏 其二","author":"吴当","text":"绿鬓飞蓬四岁儿，寒机对月夜眠迟。\n碧梧翠竹春云合，斜日慈乌返哺时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李节妇田氏 其三","author":"吴当","text":"江上莺花满目春，冰霜皎皎百年身。\n自从破镜留孤影，锦瑟无声落燕尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李节妇田氏 其四","author":"吴当","text":"朋酒升堂着舞衣，忘忧草色动春晖。\n贻谋曾授三迁教，断缕犹存旧织机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李节妇田氏 其五","author":"吴当","text":"廉耻风移士节隳，壸仪犹足正民彝。\n世情无限伤心地，惆怅琵琶掩面时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋对月口号 其一","author":"吴当","text":"古木昏鸦接翅飞，扶桑顾兔倍光辉。\n广寒梦到嫦娥殿，新剪红霓制舞衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋对月口号 其二","author":"吴当","text":"静听新人笑语声，天寒翠袖若为情。\n举头不辨山河影，坐看儿童斗眼明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋对月口号 其三","author":"吴当","text":"豫章城头百尺楼，三年明镜炤人愁。\n五老峰前秋色里，寸心折尽大刀头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归舟湖中梦至上都","author":"吴当","text":"归舟日日向南风，积雨初收浪拍空。\n梦入龙冈清暑地，夜凉万斛水晶宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月二十四日","author":"吴当","text":"丑夜城头烈炬红，数声笳起戍楼空。\n江山如旧豪华去，无食无衣一病翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宣圣庙","author":"吴当","text":"百年如见鲁灵光，一炬堪怜瓦砾场。\n秋水满池门独在，古槐依旧带斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丑月六日见迫趋升抗论力争复絷于小舟龙开河口累夕惊风怒涛中六日夜至十有二日大雪冱冻病卧赋此 其一","author":"吴当","text":"长夜漫漫雪一篷，有衾如铁卧如弓。\n窖中犹拥胡姬暖，未信当年属国穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丑月六日见迫趋升抗论力争复絷于小舟龙开河口累夕惊风怒涛中六日夜至十有二日大雪冱冻病卧赋此 其二","author":"吴当","text":"曾忆黄河守冻船，鱼肥肉美酒如泉。\n半生辛苦成何事，衰病饥寒雪里眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"朱矶除夕","author":"吴当","text":"骇浪惊风动楚天，乡心羁思漫年年。\n鲈鱼不受寒江钓，今夜朱矶雪满船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"吴当","text":"繁华一夕怨西风，金雁钿蝉镜影空。\n咫尺关山春梦里，桃花又向别人红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"衡山春游图","author":"吴当","text":"雁书不到祝融峰，怅望苍梧驻六龙。\n尚欲暮年专一壑，白云深处寄行踪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"美人昔燕赵","author":"周霆震","text":"美人昔燕赵，岁久江汉间。\n轩窗粲明霞，被服罗绮纨。\n頩怒恒有持，含魂讵敢攀。\n一朝强暴陵，相从即欢颜。\n倾身作歌舞，豫恐恩意阑。\n新声与娇态，取媚巧百端。\n主家隔风尘，庭宇深且完。\n岂无昔共处，永夜青灯寒。\n魂梦各所依，宁复相往还。\n沉沉九秋霜，履屦思蒯菅。\n娟娟中天月，照影留空山。\n盛时概无虞，末路良独难。\n弃置勿重陈，使人摧肺肝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"濯濯江汉女","author":"周霆震","text":"濯濯江汉女，幽贞出良家。\n十年守空帏，夫婿天之涯。\n良夜秉明烛，悉心务丝麻。\n忆昨秋风起，河洛昏尘沙。\n伤彼朱丝弦，逸响趋淫哇。\n朝为御沟柳，暮作陌上花。\n世态固应尔，委置勿复嗟。\n所悲在新春，雨露凝朝华。\n感此深闭门，渊冰虑弥加。\n藏玉万仞冈，守护盘龙蛇。\n投珠千顷波，光燄惊鱼虾。\n夫婿会有期，岂问岁月赊。\n寸心如皦日，终始宜无瑕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山万里雪","author":"周霆震","text":"燕山万里雪，不作黄河冰。\n玄德专所司，曷为失其凭。\n赤云窃乘间，遂逐炎风兴。\n连延土山焦，反更繁青蝇。\n毛炰列饔饩，臭腐日以升。\n禋祀古有严，孰与存芳馨。\n昨梦观圜丘，玉辂苍龙乘。\n正气六合周，瑞花反严凝。\n坐见昆冈火，瞬息投淄渑。\n愿言哀江南，尽洗毒雾蒸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潮生浙江白","author":"周霆震","text":"潮生浙江白，积水何其多。\n悠悠子胥魂，千古终不磨。\n东南溢潢潦，污渎纷旁罗。\n独此障百川，昼夜激海波。\n力排坤轴转，正气通天河。\n从星趣好雨，浴日阳之阿。\n苍苍紫微垣，弁冕锵鸣珂。\n宜蒙湛露恩，领袖湔甲戈。\n云阵声万雷，银山势嵯峨。\n吹嘘蛟龙翔，奋起驱鲸鼍。\n功推五行首，朝宗谅无他。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种瓜南山下","author":"周霆震","text":"种瓜南山下，实晚霜落之。\n冒寒拾瓜仁，生意或在兹。\n收藏箧笥中，恒恐鼠蠹窥。\n群儿顾窃笑，痴绝将奚为。\n昨闻北里富，晨昏厌甘肥。\n祸机隐骄溢，瞬息靡子遗。\n嗟我食无肉，藜藿每晏炊。\n俟时启包裹，瓜地审所宜。\n殷勤谢春雨，庶以忘朝饥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十五纪怀","author":"周霆震","text":"止酒已多日，当秋病连绵。\n一窗此寄傲，晏起仍早眠。\n岂不念佳节，负此明月圆。\n叩门客语我，蚤作星尚悬。\n白气出东北，横贯西南天。\n夜凉步中庭，所见还依然。\n力疾起语客，丧乱今十年。\n谓天盖无情，垂象在目前。\n谓天其有知，吉语皆虚传。\n未遑悉吴越，况敢谈幽燕。\n须臾报军出，明日攻富田。\n焚掠先近郊，斩艾无愚贤。\n咫尺成俘囚，妻子畴能全。\n戒客姑罢休，世事从推迁。\n客去深掩耳，闭关涕潸焉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大风发屋雨雹交集","author":"周霆震","text":"大风西北来，屋瓦去如走。\n丽谯双阙壮，关键决枢纽。\n苍苍泮宫柏，枝叶互纷纠。\n移时折偃蹇，巧力无措手。\n西禅铁浮图，摧仆如拉朽。\n临江战楼飞，夹巷坊额剖。\n恍疑会群龙，奋发交怒吼。\n泰山恐崩裂，宁复计培塿。\n老夫闭门卧，雨雹散窗牖。\n仓皇正衣冠，力疾坐良久。\n天威俄咫尺，性命亦何有？\n默悟贵存心，渊冰慎吾守。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁暮简张梅閒","author":"周霆震","text":"忆昔慕远游，朝华沐春露。\n焉知丧乱后，林杪秋叶蠹。\n閒关西州门，寒日收踽步。\n尚馀平生友，示我广平赋。\n耿耿河汉辉，幽幽冰雪度。\n终惭媚求悦，宁悔贞取妒。\n朗吟发孤音，明月落庭户。\n世事殊未涯，岁年忽云暮。\n有美君子心，永言金石固。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夜书怀","author":"周霆震","text":"一榻陋容膝，老身兀枯株。\n淹留恒鲜悰，况兹岁云徂。\n儿女虽苟完，丧乱多异居。\n同也久乡曲，奔走一饭驱。\n凤也妻女累，近亦反故庐。\n拙谋康最少，甥馆横溪隅。\n阿巽孀七载，忍弃吴氏孤。\n靓家食指繁，绩纴勤养姑。\n市廛病株守，环偶锥刀趋。\n顾我此相守，出入孙符俱。\n孩乌颇机警，戏弄聊与娱。\n止酒动经年，宿病无由祛。\n晚餐率减半，夜枕气始舒。\n宴游多却避，礼节那能拘。\n亲友既少存，存者亦暗疏。\n骎骎齿发敝，勉勉筋力馀。\n抚事百感集，来岁知何如。\n存亡且未测，艰苦焉足虞。\n骨肉姑眼前，开怀尽斯须。\n地炉熟春茶，明烛散郁纡。\n忽忆孤山梦，风雪随吟驴。\n梅花千载心，皎若沧海珠。\n服之配明月，阅时终无渝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和萧仲仪","author":"周霆震","text":"十年树桑柘，结屋山涧旁。\n辛苦蚕丝成，将备公子裳。\n缁尘一朝起，冠盖纷劻勷。\n飘零落绮纨，翕忽归渺茫。\n鲜鲜皮卉服，摇曳凌空翔。\n感此桑下心，临风时自伤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]