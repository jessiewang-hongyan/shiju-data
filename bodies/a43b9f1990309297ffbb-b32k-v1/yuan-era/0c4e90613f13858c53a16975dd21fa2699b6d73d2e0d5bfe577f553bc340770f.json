[{"title":"题王元章梅","author":"张渥","text":"照水疏花冰有晕，横窗瘦影玉无痕。\n孤山月冷黄昏后，拄杖曾敲处士门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵翰林画兰","author":"张渥","text":"白鸥波点研池清，楚畹香风笔底生。\n记得弁峰春雨后，拨云移种向南荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因颜陋隐寄上清外史薛玄卿","author":"李瓒","text":"仙人薛外史，高隐在幽閒。\n碧云上清镜，皓月琼林坛。\n博疋坐虚室，飞神修大丹。\n弹琴松树里，吹箫清夜间。\n几时访山馆，相与游三山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜怀豫章倪中岂并太原王本中二子皆客京师故诗及之","author":"李瓒","text":"耿耿春夜永，迢迢更漏残。\n美人隔千里，清月在江关。\n举杯不能乐，援琴孰为欢。\n怅望五云外，目送双飞翰。\n王子经纬学，紬绎茫无端。\n倪生富文史，落笔回狂澜。\n古剑没丰城，大璞昧荆山。\n奇材每不识，万古一长叹。\n而我困畎亩，漂流吴楚间。\n釜鱼独恒饥，衣鹑每怀单。\n慷慨念二子，频年事征鞍。\n庶几抱琴志，不愧齐门弹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江浦送别","author":"李瓒","text":"协风吹冰泮，水色茫微绿。\n沙融文禽集，波暖白鸥浴。\n之子逝将别，分手愁局促。\n离觞一何频，征舸嗟去速。\n今日江浦东，明朝关山北。\n棹歌不堪闻，悽然泪盈掬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种葵","author":"李瓒","text":"种葵南轩下，葵长不盈尺。\n芃芃初叶茂，挺挺交柯直。\n匪以花为美，有取心向日。\n孤忠类臣子，恒性若有德。\n只恐秋风至，兰蕙同萧瑟。\n虽然遇彫落，凡草孰可匹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"袁南宫江西归吴门隐居短句奉寄","author":"李瓒","text":"江国徂春暮，兰苕生蕙风。\n佳人天之末，高隐林泉中。\n有怀不能伸，愁思渺无穷。\n朱弦发清响，大吕振黄钟。\n依依阊门柳，去去塞北鸿。\n永言寄歌诗，用以慰幽悰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山佳处以夜阑更秉烛相对如梦寐分韵得对字","author":"李瓒","text":"日夕南窗云，水生东北汇。\n开筵草堂接，拄笏玉山对。\n泂酌兴未央，清吟心每醉。\n酒香鹦鹉满，琴韵凤凰碎。\n崔蔡有雄才，邹枚富佳制。\n笑谈可冥身，出处当拔萃。\n慨慷宁废歌，栖迟何足累。\n天高星汉移，夜久鸿雁逝。\n投笔惭鬓丝，长啸风尘际。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳枝词","author":"李瓒","text":"吴江绿水生春明，江上柳枝今渐青。\n栖乌哑哑中夜鸣，愁绝东风长短亭。\n柳枝当户森成束，思妇正倚阑干曲。\n别情有恨不可解，万里相思泪盈掬。\n愁多不织流黄机，织得回文更憯悽。\n功名误人不足恃，稿砧稿砧何日归！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春草曲","author":"李瓒","text":"春风百草生何许，伊流之洲澧之浦。\n荃蘅兰蕙与芳杜，馨香采色纷无数。\n鶗鴂先鸣众芳举，万绿如烟花欲语。\n王孙游子去湘楚，蘼芜斗谢山之阻。\n春草无情情独苦，别离恨深乃终古。\n春草生，泪如雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归鸿曲","author":"李瓒","text":"高秋鸿雁来，仲春鸿雁归。\n关河道路远，沙场声韵悲。\n去年曾寄帛书去，回文织就相思句。\n稿砧远在边城戍，高楼不见绝心绪。\n愁多别久泪阑干，何日归来再合欢。\n一听归鸿一生怨，杨子江南春雨寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关河柳","author":"李瓒","text":"关河春初官柳青，上有栖乌哑哑鸣。\n千树万树恨如织，水远山长无限情。\n柳丝忽换黄金色，当时忆送游侠客。\n去年惊心杨子南，今年又恨沙场北。\n关河柳，管别离。\n离人一去何时归？\n折枝千里寄相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沧浪亭","author":"李瓒","text":"苏公昔在宋盛时，文采才名动天地。\n暮年筑居向沧浪，草圣相传世尤贵。\n积书为林墨为池，长歌散发鬓如丝。\n风流百岁不泯灭，及此士论无磷淄。\n忆昔尝为吴下客，刺船携酒访陈迹。\n却思重游不可得，临风悽然念畴昔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"击楫行","author":"李瓒","text":"日华悠悠江色清，碧波万里生春明。\n商妇琵琶别怨生，击楫渡江舟正行。\n美人美人既无情，澧兰沅芷扬芳馨，欲见不见心怦怦。\n轻风吹罗裳，击楫且勿忙。\n恐惊菰蒲中，交颈双鸳鸯。\n莫学桃根与桃叶，渡江一去音信绝。\n江上春来复春去，对此流光泪盈睫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再题渔庄","author":"李瓒","text":"五湖之东烟水长，高人于此构渔庄。\n开轩垂钓吟丽藻，泛舸吹笛窥扶桑。\n金尊满注蒲萄酒，醉看吴姬小垂手。\n荣名耳热何足誇，几见秋风落杨柳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春原","author":"李瓒","text":"林樾□初协，村原泥正融。\n香芜连野碧，冶杏过墙红。\n塞雁归天末，巴莺出谷中。\n春光浓若酒，欢赏兴何穷。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春初奉寄海虞山北声九皋上人","author":"李瓒","text":"杖锡虞山北，春风忆旧游。\n翠厓云每集，丹壑水争流。\n染翰超怀素，哦诗继惠休。\n何当上湖夜，相与汎扁舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴","author":"李瓒","text":"迟迟当丽日，冉冉及阳春。\n草色连烟翠，柳条垂曲尘。\n哦诗红杏馆，漉酒白纶巾。\n欲写江淹赋，悽然寄远人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春半","author":"李瓒","text":"水国春将半，丛篁映白沙。\n檐楹皆燕雀，径术接桑麻。\n吟啸分江色，登临爱日华。\n何当学郑子，谷口问山家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴","author":"李瓒","text":"客舍沙南蒲子堈，流光愁思共微荒。\n落林翠竹含溪影，小树红梅播野芳。\n解乐师襄方入海，乘舟张翰谩归乡。\n不如却学南山牧，叩角浩歌清夜长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳花","author":"李瓒","text":"泽国春馀江树尽，柳花无数没凫翁。\n每当白日飞晴雪，似与游丝逐惠风。\n灞上啼莺孤驿外，隋堤归马夕阳中。\n离人欲折还惊叹，空对桑条恨不穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀玉山西墅","author":"李瓒","text":"西墅幽期每自知，晚来无物不宜诗。\n白蘋点缀秋波远，红树留连落照迟。\n亲老正当贫贱日，身轻唯荷圣明时。\n可能便把投竿手，来问渔庄觅钓丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹一章奉寄玉山公子","author":"李瓒","text":"巷南亭馆春风树，魏紫姚黄取次开。\n翠羽当窗林影丽，红云绕坐国香来。\n凝酥煖汎金壶酿，群玉晴笼锦帐埃。\n洧外何能夸芍药，番禺自足愧玫瑰。\n竟须高宴烦燕女，左手持花右酒杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山草堂","author":"李瓒","text":"羡君家住玉山傍，地势江流接草堂。\n书卷已传秦伏胜，钓竿还学汉严光。\n溪毛秋冷珊瑚小，野竹寒深翡翠长。\n酌酒几思援北斗，濯缨还拟汎沧浪。\n圣明此日兴贤急，才子那能滞远方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山佳处","author":"李瓒","text":"玉山亭子仙人筑，小似桃源隐者家。\n天近方壶知剑气，水从清汉接星槎。\n参差凤吹空歌迥，烂熳龙香醉墨斜。\n金椀细倾新竹叶，银瓶还出小琼华。\n荣名何事头如雪，亦欲羊裘钓白沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春二绝句 其一","author":"李瓒","text":"水生泽国徂春暮，倚杖汀洲立惠风。\n千树梅花红雨落，满林竹笋绿阴浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春二绝句 其二","author":"李瓒","text":"牡丹满楹红于锦，柳絮随风白胜绵。\n何日扁舟钓湖上，沧波深处一丝烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石民瞻作县彭泽集贤赵子昂画马赠别后为他人持去二十年后复得之题诗以识之","author":"陆友","text":"朝踏长安尘，暮倾渭城酒。\n风流赵集贤，画马当折柳。\n晚凉池上洗马归，圉人控鞍不受羁。\n此马自是玉龙种，想见明窗貌得时。\n题诗人物不可作，北雁南云总离索。\n旧游回首二十年，今日重看宛如昨。\n春尽江头生绿波，春山满眼故人多。\n惟有当时陶令在，奈此萧萧白发何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宋江三十六人画赞","author":"陆友","text":"忆昔熙宁全盛日，百年曾未识干戈。\n江南丞相变法度，不恤人言新进多。\n蔡家京卞出门下，首乱中原倾大厦。\n睦州盗起□连北，谁挽长江洗兵马。\n京东宋江三十六，白日横行大河北。\n官军追捕不敢前，悬赏招之使擒贼。\n后来报国收战功，捷书夜奏甘泉宫。\n楚龚如古在画赞，不敢区区逢圣公。\n我尝舟过梁山泺，春水方生何渺漠。\n或云此是碣石村，至今闻之犹褫魄。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桂之树","author":"陆友","text":"桂之树，褰我衣。\n秋风昨夜起，游子送将归。\n明年春水盛，鼓楫下江矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵季文之湖州知事","author":"陆友","text":"共说佳公子，翩翩清且贤。\n传家存旧笏，载世有遗编。\n沤鸟冲波去，苕花带雨牵。\n纠曹官事少，挥麈看山川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴桓王墓","author":"陆友","text":"见说桓王墓，名因父老传。\n如何汉社稷，竟作魏山川。\n壤隧秋风入，荒丘暮雨悬。\n唯馀碑上字，隐隐赤乌年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵子期使交趾","author":"陆友","text":"万里交州道，还闻虎节驰。\n天王颁正朔，使者护蛮夷。\n瘴雨侵榕叶，腥风度竹枝。\n奉辞存大体，定服远人思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"见说","author":"陆友","text":"幽并豪侠士，新拜羽林郎。\n夕按秦娥曲，朝薰荀令香。\n折花当阁道，射柳傍宫墙。\n见说红城下，今年春草长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送国王朵儿只就国","author":"陆友","text":"奕世名王策骏功，远分茅土镇辽东。\n玉符金印传孙子，铁券丹书誓始终。\n沧海断霞通虎帐，黑河飞雪暗雕弓。\n莫忘圣武艰难日，四杰从容陟客同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次张贞居所赋云林","author":"陆友","text":"松花新酿碧琳腴，洗杓何妨起病夫。\n菌阁下帘修隐诀，云林扫榻挂仙图。\n旋移竹近文书案，自汲泉添刻漏壶。\n闻说华阳多玉食，洞中燕肉腻如酥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊虎丘","author":"陆友","text":"晚泊虎丘山下村，小舟摇荡一溪浑。\n游人车马各已散，宿鸟池台故不喧。\n初月出林光照地，乱云入寺影当门。\n□□□□□□□，□□□□□□□。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖画山水","author":"陆友","text":"翳翳云中树，亭亭江上山。\n秋风生柁尾，荡漾碧波间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪幻霞良常草堂图","author":"陆友","text":"家住华阳洞，长松映草堂。\n平生有高致，不似贺公狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠诸葛子熙三首 其一","author":"陆友","text":"闻道长安异昔时，秋风落日草离离。\n九成宫阙无寻处，空有人来拂断碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠诸葛子熙三首 其二","author":"陆友","text":"百二山河路欲迷，荒林败冢转悽悽。\n夜深曾过昭陵下，风雨犹疑石马嘶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠诸葛子熙三首 其三","author":"陆友","text":"北堂萱草绿朵朵，白发慈颜不解忧。\n尽卖刻辞供菽水，谁怜蹀足遍长洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋翠微","author":"顾盟","text":"倚山为宅似城闉，耕凿悬知可疗贫。\n政想绿阴当瓮牖，但愁翠雨湿纶巾。\n投林鼠雀终无角，出谷峰峦半似人。\n浊世无忧惟隐者，愿分藜藿老天民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送樊仲宜","author":"顾盟","text":"樊郎昔补太常掾，郊祀通天致敬时。\n先过罘罳张鼓乐，复从卤簿建旌旗。\n颁宣即用金书刻，读祝还令玉版持。\n今日江南见樵者，命渠歌作赠行诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送谢子方归临川","author":"顾盟","text":"连雨淋浪不耐秋，江行已试木棉裘。\n侍中无梦思通籍，肘后有书能校雠。\n身坐米船歌灌口，眼明瀑布是江州。\n到家先谒虞夫子，定作芝亭一月留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月十三日自鸿山归吴舟中赋","author":"顾盟","text":"扁舟风轻稳如马，容我领览秋气清。\n横塘水深白鸟下，敧树雨湿青苔生。\n东曹掾史有高兴，太乙真人无俗情。\n去□吹箫唤孤鹤，明夜月满姑苏城。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"红梅","author":"顾盟","text":"九疑山中得道女，春寒石上饮流霞。\n不知遗却玉条脱，独倚东风暮竹斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄学可二首 其一","author":"顾盟","text":"九龙之山第几峰，曾看飞雪下长松。\n小楼日夜听春雨，忘却溪头寻暮钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄学可二首 其二","author":"顾盟","text":"石上一杯清泠水，传是若冰小洞天。\n借渠茗器登山去，春雪正与梅争妍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其一","author":"顾盟","text":"姑苏城北桃花坞，日日敲门去问春。\n自是狂夫被花恼，求之不得亦愁人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其二","author":"顾盟","text":"醉舞花前倒接䍦，双双燕子共差池。\n留连只恐春光暮，芳露湿衣人不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其三","author":"顾盟","text":"石湖春水如酒浓，玻瓈万顷开龙宫。\n我时泛舟过湖曲，无数桃花发旧丛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其四","author":"顾盟","text":"近得玄洲餐玉法，不用采石登昆仑。\n景纯解道游仙句，海上鹤来传到门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其五","author":"顾盟","text":"江城雪夜深一尺，欲问梅花马不前。\n袁生此时正高卧，不知春江有钓船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其六","author":"顾盟","text":"玉壶春酒碧于海，客至纵饮宁伤廉。\n已无俗事恼真趣，只有清香散宝奁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其七","author":"顾盟","text":"绿晕双蛾新画眉，风流堪赋比红儿。\n绣窗无人解春意，行傍辛夷折柳枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杨廉夫冶春口号八首 其八","author":"顾盟","text":"吴姬殷勤折简呼，青锦坐褥花中敷。\n听唱梨园供奉曲，新声一串骊龙珠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云林生远山涌翠图","author":"顾盟","text":"偶因涤砚写从容，点染那能似画工。\n千载风流谁可拟，令人猛忆米南宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈履元画玉山草堂图","author":"卫仁近","text":"万木阴阴覆草堂，湘帘低下净琴张。\n逶迤万里桥南路，彷佛百花潭上庄。\n白鸟向人飞个个，好山当户立苍苍。\n披图想见人清绝，为写新诗并晚凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词","author":"卫仁近","text":"九重春色绕金銮，龙渴宫壶午漏残。\n犀押帘垂红雾暝，兽炉香尽碧云寒。\n隔楼度曲多西子，别院吹笙是内官。\n见说羊车明日过，旋栽杨柳护雕阑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄杨铁厓","author":"卫仁近","text":"白发扬雄三泖上，楼船日日载青娥。\n骊珠泣月夜光冷，象管叫云秋思多。\n问字诸生频载酒，购书道士为笼鹅。\n玄霜台上凉如水，好著吾侬拍手歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘王事北上","author":"卫仁近","text":"晓漏沈沈禁籞清，内班初进佩环鸣。\n九重日月明金殿，四海车书会玉京。\n天子龙飞乾道正，宰臣鹄立泰阶平。\n几时我亦观光去，醉插宫花出凤城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜曲二首 其一","author":"卫仁近","text":"谁家女儿青结螺，花前双歌舞婆娑。\n湘帘在钩明月多，奈此迢迢凉夜何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜曲二首 其二","author":"卫仁近","text":"银河流光夜初静，姮娥娟娟度鸾影。\n绮疏美人醉方醒，倚阑吹箫更漏永。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送粹上人还天台养母读书","author":"彭罙","text":"逝川无停波，浮云时独飞。\n十年出家去，早著游子衣。\n朝帆南海航，暮采北山薇。\n孰云方外乐，倚门有遐思。\n丸丸赤城山，中有乌乌慈。\n娱嬉在昕昔，况适静者期。\n朔风吹大江，越树淡寒晖。\n顾瞻东归屐，梦绕玉溪湄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]