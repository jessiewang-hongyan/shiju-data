[{"title":"和西湖竹枝词","author":"陆元泰","text":"桃花巷口春水波，梅花墓下竹枝歌。\n桃花开处春光老，梅花开处月明多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"马稷","text":"与郎别久梦相思，不作西园蝴蝶飞。\n化作春深鶗鴂鸟，一声声是劝郎归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"缪侃","text":"初三月子似弯弓，照见花开月月红。\n月里蟾蜍花上蝶，怜渠不到断桥东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"蒋克勤","text":"题诗秋叶手新裁，好似阿侬红颊腮。\n寄与钱塘江上水，早潮回去晚潮来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"周溥","text":"西湖西畔上清家，美人有如绿萼华。\n七星道冠拜星斗，万一琼台乘紫霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"钱大有","text":"淡黄裙子缕金衫，长髻垂肩短凤簪。\n不愿燕京嫁官去，花枝草蔓自江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"留睿","text":"湖上南风六月凉，采莲惊起双鸳鸯。\n妾心恰似莲心苦，郎心不似藕丝长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"张师贤","text":"孤山脚下路三叉，孤山墓上好梅花。\n不似马塍桃李树，随春供送别人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"顾敬","text":"楼船儿女日晚歌，莲心结子绾双螺。\n湖水潇潇湖月白，奈尔湖中凉夜何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"朱庸","text":"小姑疑郎去不归，为郎打瓦复钻龟。\n青山尚有飞来日，不信人无相见时。\n阿奴采莲湖上舟，阿郎贩豆辽东州。\n一心愿逐东流水，流送辽东古渡头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其一","author":"陈枢","text":"且莫唱君杨白花，听我西湖竹枝歌。\n竹枝青青多竹节，杨花轻白奈君何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"庄蒙","text":"日出里湖烟水开，初阳台下抱琴来。\n夜深弹罢乌啼曲，明月自照高高台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"张世昌","text":"秦皇石头三丈高，云是秦皇系船标。\n侬心只似系船石，莫比郎心船易摇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其一","author":"马贯","text":"吴姬轧轧小车红，争来陌上看春风。\n不敢高声唱歌去，恐惊丞相在船中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其二","author":"马贯","text":"百花楼头闻马嘶，郎从花里斗金鸡。\n朝朝捲起珠帘望，不是郎归不下梯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"冯士颐","text":"与郎情重为郎容，南北相看只两峰。\n请看双投桥下水，新开两朵玉芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"不花帖木儿","text":"玉楼珠箔晚天凉，秋色依稀满建章。\n金井梧桐霜叶尽，自随流水出宫墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"掌机沙","text":"南北峰头春色多，湖山堂下来棹歌。\n美人荡桨过湖去，小雨细寒生绿波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词","author":"聂镛","text":"九重天上日初和，翡翠帘垂午漏过。\n闻到南闽新入贡，雕笼进上白鹦哥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其一","author":"郭庸","text":"日落平湖艇子迟，岸花汀草伴人归。\n鸳鸯惊散东西去，唯有蜻蜓蛱蝶飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"郭庸","text":"流光昨日又今朝，犹忆当年醉六桥。\n金鹊翠蕤纷在眼，生红七尺系郎腰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其一","author":"熊进德","text":"金丝络索双凤头，小叶尖眉未著愁。\n大姑昨夜苕溪过，新歌学得唱湖州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"熊进德","text":"销金锅边玛瑙玻，争似侬家春最多。\n蝴蝶满园飞不去，好花红到剪春罗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"熊进德","text":"木怪鬼欲出，山空岩自鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"徐哲","text":"尽说卢家好莫愁，不知天上有牵牛。\n剩抛万斛燕支水，溜向银河一色秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其一","author":"韦圭","text":"湖中艇子风徐徐，秋水荡漾金芙蕖。\n钓鱼不是贪双鲤，为恐腹中藏素书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其二","author":"韦圭","text":"苏小门前月漾波，牵牛织女挂秋河。\n恨妾如星圆处少，恐郎如月缺时多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"吴礼","text":"湖上鸳鸯相对飞，春寒著人郎未归。\n莫捲珠帘看行路，杨花撩乱扑人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其一","author":"张守中","text":"西湖女儿似西施，瓜皮小船歌竹枝。\n郎心如月有时黑，妾身如山无动时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"张守中","text":"苏公堤上柳枝枝，月子弯弯似妾眉。\n记得双双拜新月，只今独有影相随。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32216,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"燕不花","text":"湖头春满藕花香，夜深何处有鸣榔？\n郎来打鱼三更里，凌乱波光与月光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32217,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"林谏","text":"泪写血书寄吾弟，早令昂侄继吾宗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32218,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"邓定","text":"松窗朝听雨，石碓夜舂云。\n涧光接树影，石甃沁□□。\n野水流花出，松云载雨还。\n看山曾到寺，隔水忽□□。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32219,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题长江伟观图","author":"董旭","text":"龟书出洛水，神禹膺九畴。\n岂伊彝伦叙，洪涛亦安流。\n惟岷西南隅，金火相绸缪。\n江源发其侧，微茫不容舟。\n浅滀渊遂涂，道远势乃遒。\n辛勤逾青城，愤怒脱黄牛。\n汉水?两川，彭蠡会七州。\n劬劬朝宗心，自可无滞留。\n屹彼金与焦，相望仅一沤。\n离立当要冲，不没亦不浮。\n大类武安西，震荡不得谋。\n神奇北山捷，乃以一卒收。\n又似寻邑兵，兕虎杂貔貅。\n气贮百文叔，草草就俘囚。\n叵测天地心，平地陈险幽。\n我疑东海若，力据江上游。\n于此战不胜，奔迸若兜矛。\n不然江神薨，厥妇义从游。\n天吴役秘怪，负石奠双丘。\n九思苦未得，物理谅难求。\n因悲英雄人，争此若射侯。\n伟哉韩将军，铁锁掣万艘。\n向非天与灵，万骑真杵投。\n至今江之波，犹负脱鼠羞。\n我昔曾过之，啧啧泪盈眸。\n中流一长啸，宇宙争百忧。\n东顾无津涯，赤日出海头。\n西望赤壁矶，尚想孙曹刘。\n正北维扬城，楼橹郁相纠。\n寒烟际衰草，日落风飕飗。\n近闻事益殊，沙户逮称酋。\n舳舻夹鸼䑠，浩荡剧长虬。\n萧瑟但一气，焉能辨邗沟。\n向来金碧堆，一炬十二楼。\n诸天尽星散，死树生清秋。\n时事翻覆间，桑海变蜉蝣。\n安知亿劫外，伟观宁此不？\n取我金叵罗，披我红锦裘。\n酹此一杯酒，净洗千古愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32220,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄玉山草堂","author":"黄文德","text":"玄圃仙人吾未识，闻说吴山种春色。\n昨夜洞云天际来，明月空斋坐相忆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32221,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"敬和草玄内翰先生台字韵并呈世寿堂贤乔梓过目","author":"林世济","text":"铁史新移淞上屋，子云住蜀小亭台。\n窗涵九朵山尖出，门对百花潭水开。\n月下文箫骑虎去，云间青鸟送书来。\n高年自得养生术，政似婴儿初未孩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32222,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴一首奉怀草玄先生","author":"林世济","text":"噬牙不可摩，颔鳞不可婴。\n所以明哲士，婉娈逃其生。\n埳蛙既聒聒，陵苕亦荣荣。\n怀哉一壶酒，南山最高层。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32223,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画梅","author":"贡性之","text":"王郎胸次亦清奇，写尽孤山雪后枝。\n老我江南无俗事，为渠日日赋新诗。\n王郎日日写梅花，写遍杭州百万家。\n向我题诗如索债，诗成赢得世人誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32224,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈思","text":"传家忍学韩为贾，失国惊闻莒灭鄫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32225,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题芦花被图","author":"吴敬夫","text":"秋风吟就芦花被，一落人间知几年？\n泽国江山今入画，诗人毛骨久成仙。\n高情已落沧洲外，旧梦犹迷白鸟边。\n展卷不知时世换，水光山色故依然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32226,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思子","author":"吴敬夫","text":"剑阁凌云鸟道边，路难闻说上青天。\n山川万里身如寄，鸿雁三秋信不传。\n落叶打窗风似雨，孤灯背壁夜如年。\n老怀一掬钟情泪，几度沾衣独泫然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32227,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴敬夫","text":"阑干苜蓿先生饭，颠倒天吴稚子衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32228,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤傍牡丹图","author":"吕玄英","text":"牡丹花畔鹤精神，飞并云林似倚人。\n万里青霄不归去，洛阳能有几时春？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32229,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正丁酉冬督役城虎丘连月馀赋诗八首录呈居中禅师 其一","author":"周南","text":"捧檄趋功城虎丘，因高据险互相缪。\n湛卢一跃寒潭底，夜半光芒射斗牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32230,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正丁酉冬督役城虎丘连月馀赋诗八首录呈居中禅师 其二","author":"周南","text":"四叠新城绕涧隈，剑池池上碧崔嵬。\n于菟夜吼山灵振，仙鬼哀吟风雨来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32231,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正丁酉冬督役城虎丘连月馀赋诗八首录呈居中禅师 其三","author":"周南","text":"平林惨淡日沈西，百万城舂落杵齐。\n努力相歌歌未彻，回头仰羡鸟归栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32232,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"张翼","text":"南高北高峰顶齐，钱塘江水隔湖西。\n不得潮头到湖口，郎船今夜泊西溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32233,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忠徐倡诗","author":"张翼","text":"西神峨峨，睢孽蔓乘，兵涂氓膏，国武乏兴。\n唶尔尸素营贿朋，城弗典守妖狐凌。\n彼章缝之徒，冠伦魁能，蒲伏詟服，倒授太阿傔以承。\n天廓不白暑雨冰，纲常沦隳，线绝罔凭。\n胡为优徐倡，冶容倚市矜。\n鬕妖驱之俾侑乐，頩玉肆詈无陵竞。\n噤讴褫舞馀，怒鬟植鬅鬙。\n铅为钢，刃划膺，载营霸，灼上升，顾守臣钜儒，汗恧衔愧死莫惩。\n二仪磅礴忠义气，犹出下里孰可仍。\n桓桓执夷徒，乃反经沟塍。\n尔倡丹衷烛日月，易粉黛，誉声绳绳。\n污渎流，回清澄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32234,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"鲁渊","text":"九州文轨车书混，万里梯航玉帛齐。\n越裳翡翠供输少，辽海云航漕运通。\n杜鹃山外家千里，姑恶声中泪两行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32235,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张思孝","text":"意当极快处，心有不平时。\n少忍应无患，欲言宜再思。\n绮窗花落东风软，曾读曹家女诫无。\n一眼浊黄天堑阔，半眉老翠太行昏。\n敢效子陵辞汉爵，愿同巢父乐尧年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"邓雅","text":"鳌足立四极，钟山蟠一龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"卞元亨","text":"牡丹曾是手亲栽，十度春风九不开。\n多少繁华零落尽，一枝犹待主人来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补侍郎谢瑰诗","author":"谢理","text":"东温散晴旭，灌水浮嘉阴。\n良辰事修禊，我友欣盍簪。\n方池注清流，可以濯烦襟。\n一觞复一咏，畅情忘古今。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补王献之诗","author":"王霖","text":"华发宴馀春，微风宿云散。\n兰皋野气芳，桐冈日初旦。\n群贤集崇丘，临流水光涣。\n酌酒清湍曲，俯泉嘅长叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补府曹劳夷诗","author":"诸絅","text":"丛木翳林薄，构亭俯涧滨。\n旭日散晴彩，光风媚芳春。\n临流转轻觞，于以乐嘉宾。\n咏歌意自适，酣畅趣益真。\n兹游敦所尚，庶足酬令辰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补府主簿后绵诗","author":"徐昭文","text":"兹辰天气佳，驾言写我忧。\n衣冠盛良会，祓禊俯长流。\n川容澹疏雨，树色翳崇丘。\n清风接千载，复此逍遥游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补山阴令虞国诗","author":"郑彝","text":"夙驾税幽麓，泛醴循流澜。\n芳蕤被岩濑，葩萼耀林端。\n靡靡时运近，期焉抚岏巑。\n主欣远宾集，陶然有馀欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"续兰亭会补镇国大将军掾卞迪诗","author":"张溥","text":"兹辰暮春初，散策临泉石。\n云渠引微波，浮觞薄前席。\n伊人既已去，古今同一适。\n眷兹修禊地，遥岑澹空碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西山夜雨","author":"吴彻","text":"莫厌西山夜雨多，也应添起洞庭波。\n东风肯与周郎便，直上金陵奏凯歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题留连亭","author":"芝麻李","text":"忆昔曾为海上豪，胭脂马上赤连刀。\n此地斩分陈总管，彼时斫断莫军曹。\n固知今日由天定，方信当年漫自劳。\n英雄每每无常在，战袍著尽又方袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"口占诗","author":"西昌寇","text":"头戴血淋漓，负母沿街走。\n遇我慈悲人，与汝一杯酒。\n我亦有家儿，雪色同冰藕。\n亦欲如汝贤，未知天从否？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题靖节图","author":"白君举","text":"咄哉灵运辈，竟坐衣冠辱。\n谁知五柳家，春雨东皋绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬元遗山","author":"白君举","text":"梦里薰风湛露歌，花开汉苑旧经过。\n拾遗老去青春暮，司马归来白发多。\n横槊赋诗吾岂敢，短衣扣角夜如何。\n相逢未尽相思话，草色连云水碧波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"白君举","text":"欲搜春草池塘句，药裹关心梦不成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"空村谣","author":"杨弘道","text":"凄风羊角转，旷野埃尘腥。\n膏血夜为火，望际光青荧。\n颓垣俯积灰，破屋仰见星。\n蓬蒿塞前路，瓦砾堆中庭。\n杀戮馀稚老，疲羸行欲倾。\n居空村问汝，何以供朝昏？\n气息仅相属，致词难遽言。\n往时百馀家，今日数人存。\n顷筐长镵随日出，树木有皮草有根。\n舂磨沃饥火，水土仍君恩。\n但恨诛求尽地底，官吏有时还到门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄皇甫庭","author":"赵复","text":"寄语江南皇甫庭，此行无虑隔平生。\n眼前漫有千行泪，水自东流月自明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自遗","author":"赵复","text":"醉乘鸾驭到仙家，彩笔云笺赋落霞。\n老去空山秋寂寞，自锄明月种梅花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32253,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦中作","author":"林景熙","text":"珠亡忽震蛟龙睡，轩弊宁忘犬马情。\n亲拾寒琼出幽草，四山风雨鬼神惊。\n一抔自筑珠丘土，双匣亲传竺国经。\n独有春风知此意，年年杜宇哭冬青。\n昭陵玉匣走天涯，金粟堆寒起暮鸦。\n水到兰亭转呜咽，不知真帖落谁家。\n珠凫玉雁又成埃，斑竹临江首重回。\n犹忆年时寒食节，天家一骑奉香来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32254,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"招魂词","author":"谢翱","text":"魂来兮何极，魂去兮江水黑。\n化为朱鸟兮，其咮焉食！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32255,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀邓牧心","author":"谢翱","text":"谢豹花开桑叶齐，戴胜芊生草药肥，九锁山人归未归？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32256,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"郑思肖","text":"此世但除君父外，不曾别受一人恩。\n禦寒不藉水为命，去国自同金铸心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32257,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]