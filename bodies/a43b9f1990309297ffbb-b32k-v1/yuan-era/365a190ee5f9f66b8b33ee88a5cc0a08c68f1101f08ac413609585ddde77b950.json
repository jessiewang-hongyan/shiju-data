[{"title":"江心寺赠唐博士","author":"李孝光","text":"银浪舞轻航，天风赴石塘。\n六鳌扶地势，万象发天光。\n树涌中流碧，莲生隔浦香。\n潭龙莫深卧，一雨九州凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送萨郎中赋得新亭","author":"李孝光","text":"登高望吴楚，芳草满汀洲。\n离别安足念，英雄翻百忧。\n山河吞故国，江汉入秦州。\n今日新亭饮，因君感滞留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代友人送于彦明之鄞","author":"李孝光","text":"诗舸几时发，秋风海水腥。\n云分雁宕路，江绕蛣䗁亭。\n大府文星聚，名山僧气灵。\n凭君道问讯，无恙读书萤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送裕上人归仪兴","author":"李孝光","text":"行寻桂树隐，已与菊花期。\n江永鱼龙夕，风高鸿雁饥。\n独怜相见晚，况复欲归时。\n楚雨枫林黑，劳予入梦思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送客","author":"李孝光","text":"出门严鼓后，送客入舟时。\n己自伤羁旅，令人畏别离。\n江蟠全楚地，山掩小姑祠。\n岁晏多风雪，题诗寄所思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨天锡韵题铁塔寺壁","author":"李孝光","text":"平生谢太傅，胜日得重临。\n地势吞吴尽，江流入楚深。\n金汤非旧国，栋宇尚青林。\n野露漙黄菊，独为游子吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东林寺","author":"李孝光","text":"骑马过东林，当阶入绿阴。\n路斜瑶草合，云去落花深。\n老至况独立，兴来时一吟。\n数来成故旧，相对挽重临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"匡济","author":"李孝光","text":"春风起天际，游子若为情。\n多病仍羁旅，令人白发生。\n山连三楚壮，地入九江平。\n匡济宁无术，栖迟敢自名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄劳于彦明自吴归","author":"李孝光","text":"去及花时暖，归涂暑雨沾。\n树凉人憩午，江热马行盐。\n不畏黄金尽，祇愁白发添。\n君看双燕子，随意入人帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题留侯庙","author":"李孝光","text":"感慨留侯庙，曾闻客下邳。\n手扶仁义主，身是帝王师。\n兴汉功居最，存韩志可悲。\n如何劫高后，反使卯金卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄夏友伯","author":"李孝光","text":"长忆浣花宅，醉君双玉瓶。\n春风吹白发，山雨隔青灯。\n卧病从无客，居閒欲似僧。\n何时溪上路，倚杖看鱼罾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张子约","author":"李孝光","text":"系铗高歌里，丈夫轻别离。\n鸡鸣裹行橐，灯暗覆残棋。\n行矣复何适，嗟哉我所思。\n且归慰妻子，莫学五羊皮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋岑","author":"李孝光","text":"更觉秋岑碧，能寻胜日跻。\n树凉来鹳鹤，山断见虹霓。\n稚子行相问，幽人去不迷。\n雨馀天姥出，吾欲涉丹梯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"远山","author":"李孝光","text":"楼前万里月，窈窕碧峰孤。\n江上自浓淡，云间疑有无。\n行人穿乱树，落日界平芜。\n伫立有真意，阴阴鸟自呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绿水","author":"李孝光","text":"青春足新雨，漪绿上鱼矶。\n积翠疑摇眼，拖蓝欲染衣。\n云行天影动，风飐日光微。\n伫立无人见，沙禽背艇飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五马呈昂夫大尹","author":"李孝光","text":"五马何时发，聊逢胜日留。\n天晴占鼓角，地湿谨衣裘。\n愿试匡时画，归余理钓舟。\n浮云浩今古，别地望神州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送公子赵去疾二首 其一","author":"李孝光","text":"绵绵万里道，利涉有方舟。\n城郭通吴会，江源起益州。\n图经闻白帝，祠祭遇黄牛。\n他日浣花老，犹能作胜游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送公子赵去疾二首 其二","author":"李孝光","text":"辞吴向三楚，送远指秦川。\n高雁忧离罟，轻鸥不避船。\n天青微露下，江黑大星悬。\n郢曲长多怨，闻歌祇自怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次天锡题畅曾伯幽居","author":"李孝光","text":"淮水清瀰瀰，好山多近村。\n市收僧乞米，舟舣客过门。\n灯火邻家夕，风沙泺水昏。\n卜居谙土俗，野老旧能言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冯秦卿藏书","author":"李孝光","text":"荣中富贵传，宾客尽能文。\n属世方櫜武，无人学解纷。\n剑成猿接木，围合鹿号群。\n官作清时好，长吟生白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和蔡石云县尉","author":"李孝光","text":"西岑路滑不可上，我此曾支六尺藤。\n塔顶云凝明似鹤，松根石老瘦于僧。\n玉箫冉冉飞春县，画舸眈眈飐夜灯。\n闻有丹霞旧门户，欲参大意与谁升。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺梅","author":"李孝光","text":"水落山空百草乾，天公玉女耐高寒。\n松根云煖客吹笛，竹外月高谁倚门？\n岁晚王孙犹怨色，天寒公主欲归魂。\n北风端是春消息，吹得雪多花更繁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊舟姑苏台下","author":"李孝光","text":"霸主吞雄事莽然，空遗陈迹向千年。\n天寒笛起孤城里，日暮舟行积水边。\n万里飞鸿如识路，故园黄菊不胜妍。\n吴王台沼连衰草，惟有西山出断烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冶城飞龙亭诗卷","author":"李孝光","text":"翠盖鸾旂殷绣墙，南公挥涕话先皇。\n鸿宫望气成龙虎，法驾吹箫引凤凰。\n今日画图看御幄，当时草木识天香。\n先生曾对明光殿，奏报新松似鹤长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送青玄观道士玉泉","author":"李孝光","text":"淮南道士传鸿宝，眸子照人双电光。\n贯日白虹生玉气，出山青髓射天浆。\n去年蹋雪寻丹井，连日题诗满画廊。\n长忆青玄送客处，柳花无数绕衣裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈玉林归集庆永寿宫","author":"李孝光","text":"天绕龙宫日月低，六龙曾驻冶城西。\n祠光午夜入牛斗，玉气千年成虹霓。\n承恩已报紫旌节，奉使屡上黄金闺。\n神眷灵官守桂树，银榜碧镂自天题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王伯循","author":"李孝光","text":"使者楼船鼓三叠，犹见车前白鹭翿。\n莫嗔惜别把衣袖，他日为谁沽酒醪。\n龙蛇未蛰江水壮，鸿雁欲动秋风高。\n槐树东头读书处，更忆君家双凤毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送仲亨文学精舍山长","author":"李孝光","text":"子合谈经上石渠，更从文学住精庐。\n到家为觅言偃宅，弛担先藏笠泽书。\n日落青天犹过雁，雪消新水欲生鱼。\n传闻圣世求遗士，倘召君乘谒者车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游双峰赠觉上人","author":"李孝光","text":"茶具酒壶从两童，入山慎莫作匆匆。\n雪消新水鸭头绿，沙暖小桃猩血红。\n吾意生人行乐耳，只今杯酒与君同。\n依依蓝玉亭前路，他日重来忆远公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代人送友","author":"李孝光","text":"别离未是寻常事，要见丈夫儿女情。\n太傅中年犹作恶，阿蒙三日即知名。\n北风鸿雁天笼野，落日牛羊路绕城。\n我亦平生四方愿，先生未可办归耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登平山堂故址","author":"李孝光","text":"蜀山有堂已改作，骑马出门西北行。\n日落牛羊散平楚，风高鸿雁过三城。\n山河已失金汤固，汗竹空遗带砺盟。\n骆驼坡头孔融墓，令人忆尔泪纵横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寘磁瓯于砚池旁以蓄水十馀日前得桂花二枝插瓶中数日花叶皆萎落戊辰早乍闻香气满室视之两枝皆再作花叶亦鲜碧佛书云天风吹萎花更雨新好者感之为赋诗云","author":"李孝光","text":"六六画栏生晚凉，青鸾对舞渡银潢。\n十分天上山河□，万斛人间雨露香。\n珠佩风清生□□，玉壶冰薄吐蟾光。\n白银金阙红云合，金粟缤纷七宝床。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用前韵寄张尊师","author":"李孝光","text":"鸿雁南飞草木零，放歌重上草玄亭。\n坐深狂客俄吹帽，语久清童屡触屏。\n晏岁风多衣自短，空山月出酒初醒。\n江南客子归来得，漂泊何须影问形。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次张伯雨韵寄徐闻远真士","author":"李孝光","text":"好閒还寻幽子庐，习静自与外人疏。\n牛羊半下日夕后，鸿雁大来宿雨初。\n黄菊未疏急酿酒，碧山可数聊停车。\n眼中之人美无度，十日不见九寄书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登石头城二首 其一","author":"李孝光","text":"登高怅望谢家墩，千古风流酒一尊。\n城郭已非空故国，英雄垂尽只游魂。\n天围建业山形断，日落淮南海气昏。\n未信浮云能蔽日，欲占北斗问乾坤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登石头城二首 其二","author":"李孝光","text":"石头遗堞满苍苔，前日英雄安在哉。\n芳草离离为谁绿？\n野花漠漠向人开。\n鼎湖云暗龙先去，建业城荒凤不来。\n二月江南梅未发，北风日夜涨黄埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过□□□□□□","author":"李孝光","text":"何日先生起九原，已将灵气返山川。\n论诗转觉庾陶近，佐主终惭稷契贤。\n拱木笙竽犹落日，荒丘翁仲只寒烟。\n当时故物青山在，说到英雄意惘然。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鄱江寺拥翠楼","author":"李孝光","text":"缥缈新居一握天，好山将绿到楼前。\n烟霏入闼清谈麈，紫气薰人湿坐毡。\n未放白云分榻住，爱看青雨映帘悬。\n自怜华发江南客，也为登临忆仲宣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日陪赵相国家宴","author":"李孝光","text":"红光瑞气起曚曈，元日尊罍对上公。\n转午东风生渤澥，指寅北斗直崆峒。\n天垂紫盖黄旌外，人在琼林玉树中。\n喜□承平新气象，三□合侍大明宫。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送伯循御史天锡照磨至龙湾留别","author":"李孝光","text":"西日杲杲马萧萧，君行不行手屡招。\n舟人夜语见月出，客子别愁须酒浇。\n霜天欲雨鸿雁去，秋风未落河汉摇。\n寄语扬州张仲举，月明何处闻吹箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同吴明之在灵峰作","author":"李孝光","text":"人言万壑争流胜，故作雨中藤一枝。\n枫树朝来青鼠出，竹根日暮白鹇飞。\n要看云起水穷处，正在峰回路转时。\n莫道白鸥机事少，只今野老亦忘机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次陈辅贤游雁山韵","author":"李孝光","text":"竹杖棕鞋去去赊，一春红到杜鹃花。\n山椒雨暗蛇如树，石屋春深燕作家。\n老父行寻灵运屐，道人唤吃赵州茶。\n明朝尘土芙蓉路，犹忆山僧饭一麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤","author":"李孝光","text":"胎化有鸟今千年，俯啄璚枝饮醴泉。\n缟带长身通夜白，丹砂涂顶入秋圆。\n山空蕙帐客初去，月落竹房僧未眠。\n高气出尘如玉雪，长风万里趁飞仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发舟钱唐","author":"李孝光","text":"五年羁客留荆楚，今日江头把绣衣。\n鸿雁夜飞天气白，蛟龙昼蛰水妖微。\n弹冠终坐王阳起，敝褐何年季子归。\n一舸南游真胜事，幽期未与故人违。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次达公晚过钓台韵","author":"李孝光","text":"杳杳青枫江水暗，客星遗庙映江花。\n空闻使者来持节，犹有祠官祼聚沙。\n平日故人多礼数，终身高谊厌纷华。\n汉家九鼎如山重，霜露凄然在菼葭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为陈师复赋喜白发之什","author":"李孝光","text":"畎亩平生足忧患，爱将短发照沧浪。\n意怜得见从渠白，却笑缘愁祇自长。\n秦羽终惭头有帻，冯唐未负老为郎。\n角巾小制聊容世，漫向春风舞欲狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"避风龙潭五日登岸即事","author":"李孝光","text":"建业放舟下京口，候风三老正高眠。\n歌长且复忘羁旅，游远何如归力田。\n茅屋晨炊系牛犊，丛祠社祭落乌鸢。\n故乡风动浑相似，祇忆南溪蹋钓船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送客","author":"李孝光","text":"携手出门倍惆怅，北风吹丹枫树林。\n栅中鸡鸣天地醒，城头雁去江湖深。\n行人万里少归梦，烈士向来多苦心。\n东西相望道路远，一书会抵双南金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人还鄱阳","author":"李孝光","text":"东西湖水百花洲，行子归时雪已收。\n明月可能随客去，浮云自足使人愁。\n重来柳树应千尺，相见梅花隔数州。\n我亦高歌望吾子，春风好在仲宣楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同萨天锡饮凤皇台","author":"李孝光","text":"凤凰高飞横四海，锦袍犹赋凤凰游。\n天随没鹘低淮树，江学巴蛇入楚流。\n勋业何如饮名酒，衣冠未省识神州。\n天涯芳草萋萋绿，王粲归来更倚楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨天锡登石头城","author":"李孝光","text":"西州门外石头寺，共说英雄绿鬓凋。\n王气黄旗千岁尽，水声广乐六时朝。\n白鼯裘坏埋珠柙，玉燕钗飞坠藻翘。\n重到谢家携妓处，维舟寂寞听春潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送国侍者","author":"李孝光","text":"离别还同箭离弦，题诗修竹记他年。\n芦人楚语时相问，估客巴歌也自传。\n遥望牵帆上南斗，正逢飞雁出青天。\n绵绵远道劳归梦，忽见梅花意惘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送鲁公还秦南","author":"李孝光","text":"锦衣树纛向秦川，有客将离独黯然。\n日食犹分丞相饼，传呼自愧孝廉船。\n春风过雁青天外，暮雨行人积水边。\n应到清湘闻欸乃，楚侬此曲至今传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月十四夜宿巢县","author":"李孝光","text":"旅食荆吴改岁年，春风远道思绵绵。\n青山故绕周瑜墓，明月犹窥亚父泉。\n楚县城荒馀画角，巢湖日落有归船。\n天涯芳草萋萋绿，想见登楼忆仲宣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送鄞县尹","author":"李孝光","text":"秋风吹汝鬓成丝，移病还家竟不疑。\n官是伯强曾补处，身如元亮已归时。\n青山老去浑相识，黄菊平生最受知。\n我亦相从上吴会，夕阳骑马看残碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题本觉寺空翠亭","author":"李孝光","text":"琅玕十亩映江渚，天籁沈沈欲下来。\n已见凤毛沾雨露，长疑龙气挟风雷。\n树团车盖春阴合，月射金银夜色开。\n中野白云如白石，不辞一日到千回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六日宿芜湖县","author":"李孝光","text":"芜湖县南泊船夜，欲霜天色已苍苍。\n云山欲曙江流紫，洲渚初昏烧火黄。\n自笑头颅向华发，尚为羁旅适他乡。\n东船西舫无人语，可惜窗中明月光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜雨次神字韵录呈达兼善","author":"李孝光","text":"净洗烦冤六合新，清晨沙路绝轻尘。\n太山自古兴云雨，淫祀何劳走鬼神。\n淝水急流舟欲起，巢湖浮黛画初匀。\n客游甚忆鱼羹饭，归到江南及暮春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张颜乐秋夜闻蛩","author":"李孝光","text":"西风蟋蟀共悲凉，病木飘残托腐肠。\n邻媪秋来借灯火，行人夜语怨参商。\n啼残红叶催霜雨，吟傍黄花饮露香。\n商榷秋风与秋月，腹中那有许雌黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人游雁山家字韵二首 其一","author":"李孝光","text":"北雁山中路诘曲，夕阳木杪见人家。\n笋舆穿树惊霜叶，桐杖敲云损土花。\n白雁秋高还荡顶，流萤月黑出檐牙。\n匆匆但得皮肤耳，出外逢人莫浪誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人游雁山家字韵二首 其二","author":"李孝光","text":"峡中钟磬十八寺，山腹茅茨三两家。\n雨后乱溪清似发，霜前病叶赤于花。\n悬厓万仞涂猩血，怪石千株插犬牙。\n牢绊芒鞋行一月，出山慎勿向人誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"入雁荡山","author":"李孝光","text":"兴国年间路始开，前朝碑墨半苍苔。\n雁横宕月知秋到，僧踏湫云看瀑来。\n一岭未教灵运识，万松谁道了翁栽。\n此山曾共秋风约，说与山猿不用猜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹","author":"李孝光","text":"富贵风流拔等伦，百花低首拜芳尘。\n画栏绣幄围红玉，云锦霞裳蹋翠裀。\n天上有香能盖世，国中无色可为邻。\n名花也自难培植，合废天公万斛春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松风阁","author":"李孝光","text":"谡谡长松作人语，开门出听又千回。\n海潮欲上寒江动，瓦屋微鸣小雨来。\n不用吹笙随燕婉，如聆广乐上蓬莱。\n往年曾向三茅听，饷我丹砂满玉杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人游天台","author":"李孝光","text":"此去兰亭修褉后，平明驱马试征衣。\n海边山尽天无尽，花底春归人未归。\n一浦潮生鱼入市，千山月上鹤投扉。\n追游二十年前路，孤负东风赋《式微》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]