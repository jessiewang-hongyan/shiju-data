[{"title":"游香山","author":"撖降","text":"石栈天梯落日红，谁开青壁削芙蓉？\n扪参历井来何暮，佩玉鸣銮更不逢。\n僧去古潭云渡水，鹤阴清露月平松。\n世间骨相谁潘阆？\n误打金陵半夜钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郭祐之","author":"撖降","text":"南口青山北口云，天涯何地又逢君。\n陌头杨柳西行马，画角三声不忍闻！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"撖降","text":"气淩太华五千仞，诗绕国风三百篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"郑云表","text":"形如槁木因诗苦，眉锁苍山得酒开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史","author":"刘因","text":"纪录纷纷已失真，语言轻重在词臣。\n若将字字论心术，恐有无边受屈人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏曾点","author":"刘因","text":"独向舞雩风下来，心斋门外欲生苔。\n归时过著颜家巷，说与城南花正开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冯道","author":"刘因","text":"亡国降臣固位难，痴顽老子几朝官。\n朝梁暮晋浑閒事，更舍残骸与契丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"方存心","text":"村酒仅数行，野蔬不盈掬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荷花辞","author":"叶梅峤","text":"未花叶自香，既花香更别。\n雨过吹细风，独立池上月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先生命题追和古柏行","author":"许古清","text":"夔府羁怀悲病柏，更寻庙柏摩牲石。\n惠陵遗恨国三分，丞相英姿身八尺。\n伊人虽往寸心在，大义未伸千载惜。\n月暗丛祠鬼火青，霜寒藓树龙鳞白。\n巴江滔滔日夜东，荆榛萧瑟永安宫。\n虎蛇行阵顽不动，鱼水际会俱成空。\n老柯暗泣英雄雨，香叶尚鼓旌旗风。\n乃知扶持殆天意，未必呵护勤神功。\n侯生合作明堂栋，侯没犹为雪山重。\n魏宫晋殿总销沈，楚舞巴歌代迎送。\n悠悠华表愁归鹤，黯黯苍梧栖老凤。\n犹恐风霆撼石根，卧龙奋起当天用。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送程君俊学正归浔阳","author":"程钜夫","text":"五老催归客，天寒道路长。\n残冬涉易水，几日到浔阳？\n学见吾宗盛，身随圣道昌。\n未应嗟晚达，松菊近柴桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠汪郎中","author":"程钜夫","text":"此老今年八十三，江滨独擅汉衣冠。\n文章衔袖龙蛇字，须发如霜虎豹颜。\n耆旧于今足尘土，典型留此重家山。\n醴牢略具高年礼，万一神丹乞九还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七贤过关图","author":"程钜夫","text":"长庚自是谪仙人，子美逢时稷契臣。\n风雪茫茫五君子，醉吟犹得继清尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春盛雪戏作","author":"元淮","text":"玉漏城头报打春，连宵积雪蔽园林。\n颁春亭畔千夫扫，鼓角楼前五尺深。\n老守拈香几坠笏，营军攘土胜争金。\n击鞭不见牛踪迹，旋叱衙兵拨雪寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昭君出塞","author":"元淮","text":"西风吹散旧时香，收起宫装换北装。\n绒帽貂裘同锦绮，翠眉蝉鬓怯风霜。\n草白云黄金勒短，旧愁新恨玉鞭长。\n一天怨在琵琶上，试倩征鸿问汉皇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨妃入蜀","author":"元淮","text":"杨妃亡国祸根芽，刚道宫中解语花。\n惯得禄山谋不轨，酿成中国乱如麻。\n马嵬坡下东风恶，龙凤旂前战士哗。\n吹落海棠红满地，至今犹作画图誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"元淮","text":"问归行理轻如羽，沿路吟诗有一船。\n渭川湘水多烟雨，我欲垂钓过一生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"元淮","text":"截发搓绳联断铠，扯旗作带系金创。\n卧薪尝胆经营了，更理毛锥治溧阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"僦居","author":"董恢","text":"白发苍头一腐儒，行无辙迹住无庐。\n邓林万顷青青木，肯为鹪鹩借一株？\n翠阁朱楼锁掩扉，寻巢燕子不能归。\n落花吹泥东风雨，绕遍芳檐无处依。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"杜伯高","text":"山围花柳春风地，水浸楼台夜月天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宾月堂诗","author":"许献臣","text":"人生自是人间月，客亦天边寄此身。\n彼此虚空无著处，谁欤是主复谁宾？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至道宫","author":"叶林","text":"犹存鼎镬记熙丰，翠霭春深古路通。\n千百舂锄一株树，野田吹下雪花风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"叶林","text":"金粟花前风细细，宝阶地上月辉辉。\n梦回不属红尘境，凉露满衣人醉归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"叶林","text":"芙蓉摇风柳挂月，醉来健倒梨花堆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四贤祠次韵","author":"傅定保","text":"四杰唐遗迹，千年此妥灵。\n草荒丞相冢，云锁隐君亭。\n助教衣犹绿，翰林山尚青。\n因怀水南令，愁思绕春汀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张伯淳","text":"瘦筇支彳亍，狭路写之玄。\n才从国子先生出，曾是分司御史来。\n一廉宜得能官誉，垂去还如始至时。\n曾观海者难为水，自出山来无此游。\n幕中颇见此客不？\n江左喧传某掾来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"洪德章","text":"有子定知吾事足，贫家颇觉此声佳。\n风露对檠逼诗父，云烟落纸凛群儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊琼花","author":"赵棠","text":"名擅无双气色雄，忍将一死报东风。\n他年我若修花史，合传琼花烈女中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"刘汝钧","text":"草坪间见乌犍点，畬水飞来白鹭双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"翁合老","text":"韶华到处入冥搜，郭外人家事更幽。\n土脉正融催觳觫，林阴微合听钩辀。\n谁家酒熟社公醉，明日桑空蚕妾愁。\n祇恐春工忙里度，又吟风雨满城秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"赵必范","text":"卜岁聊凭六壬课，有生未识五辛盘。\n幸有渔樵同此乐，苦无车马自相諠。\n几点飞花芳径雨，一双新燕荻帘风。\n茭白生苗藏蛤地，桑黄含椹浴蚕天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"陈君用","text":"春风冗我田园务，野思芳情约不齐。\n检点瓜丘仍芋垄，按行桑墅更秧畦。\n偶陪灵运山前屐，或学东坡雨外犁。\n薄暮倦归专一事，旋诛生菜瓮黄齑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈君用","text":"芽谷验仁脉，浇花趱化工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"刘应龟","text":"耕馀树有牛磨痒，税足溪无人照瘢。\n青春却付鸣鸠管，白日全输卧犊閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"刘存行","text":"麦苗花下绿，犊子草边黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"傅宣山","text":"生意满腔秧出谷，飞花有絮柳飘绵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"柳耆","text":"野犊正忙犁晓雨，谷莺才出管东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"俞如山","text":"鸟随牛后窥秧谷，蝶趁蜂来恋菜花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"翁自适","text":"鸦趁犁翻争啄食，蜂黏絮落苦贪香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"郭建德","text":"烟连草色迷平野，雨趁鸠声过别村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"骆侕宾","text":"烹罢箨龙新上箸，修来秧马尚依墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"陈帝臣","text":"清晓蛙声引啼鴂，夕阳牛背立归鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"俞野山","text":"郎罢耕田呼囝牧，阿翁眠起问姑蚕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"林泉生","text":"桃李公门者，将芜胡不归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日田园杂兴","author":"傅九万","text":"笑他思著莼鲈者，却感秋风始去官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白鹇诗","author":"章彬","text":"草暖蘋香月上迟，白鹇黄鹤往来时。\n云山隔断一千里，日日相过人不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"豫章铁柱宫","author":"熊朋来","text":"九牧失贡金，司空不行水。\n蛟龙弄波涛，魑魅入城市。\n吁嗟清谈者，万事谩不理。\n遂令千载人，稽首旌阳子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴澄","text":"百年竹木青春在，一院香花白昼閒。\n屋头月上元无夜，树杪风来若有期。\n花香静昼微风里，草色深春一树馀。\n金镜南飞光欲半，银潢西去寂无声。\n定非战国谈天衍，疑是仙家缩地房。\n秋陇故园迷蝶梦，晓窗客枕厌鸡声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴澄","text":"浩歌归去浑无事，栖碧山前月上东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"倪南杰","text":"夕阳影里行人远，春鸟声中归兴忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"胡长孺","text":"薄糜不继袄不里，讴吟犹是钟球鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"黄泰亨","text":"久约竹松坚晚节，病逢蒲柳望秋时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题琵琶亭","author":"龙仁夫","text":"老大蛾眉负所天，尚留馀韵入哀弦。\n江心正好看明月，却抱琵琶过别船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席作","author":"龙仁夫","text":"菡萏池边风满衣，木樨亭下雨霏霏。\n老夫记得坡仙语，病体难禁玉带围。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题水村图","author":"罗志仁","text":"长爱秦郎绝妙词，荒寒暗合辋川诗。\n斜阳万点寒鸦处，流水孤村又一奇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武陵集得飞字","author":"张瑛","text":"雪天纵游集，四顾娱清辉。\n豪家挽不去，悠悠款柴扉。\n青阳时未来，乃见花絮飞。\n欢颜既一破，酒至不复回。\n客马俨在门，主歌毋庸归。\n古来盍簪地，荆棘牵人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武陵胜集得是字","author":"俞伯奇","text":"朔风何崩腾，大雪午未止。\n高人乘兴来，远自数千里。\n解鞯敞四斋，风采照屏几。\n新诗一挥洒，遑惜雪到纸。\n僻居寡宾送，俎豆聊复尔。\n乐我山林友，政尔不在是。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"鲁仕能","text":"万劫灰中藏世界，千层浪里惜儒珍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴釿","text":"阮籍摩挲青眼旧，邹阳感慨白头新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李应春","text":"象绘耆英希五老，鹤归华表认千年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"罗太岊","text":"素丝不改衣冠旧，黄道从教日月新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八音诗","author":"林清","text":"金紫何曾一挂怀，石田茅屋自天开。\n丝竿钓月江头住，竹杖挑云岭上来。\n匏实晓收栽药圃，土花春长读书台。\n革除一点浮云虑，木笔题诗酒数杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"讥留梦炎诗","author":"赵孟頫","text":"状元曾受宋家恩，国困臣强不尽言。\n往事已非那可说，且将忠直报皇元。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠子敬","author":"赵孟頫","text":"吾爱子姚子，风流如晋人。\n白眼视四海，清谈无一尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题所画梅竹赠石民瞻 其一","author":"赵孟頫","text":"故人赠我江南句，飞尽梅花我未归。\n欲寄相思无别语，一枝寒玉澹春晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万柳堂即席","author":"赵孟頫","text":"万柳堂前数亩池，平铺云锦盖涟漪。\n主人自有沧洲趣，游女仍歌白雪词。\n手把荷花来劝酒，步随芳草去寻诗。\n谁知咫尺京城外，便有无穷万里思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题圆泽三生公案","author":"赵孟頫","text":"川上清风非有著，松间明月本无尘。\n不知二子缘何事，苦恋前身与后身？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"赵孟頫","text":"轻轻踏破白云堆，半为寻僧半探梅。\n僧不逢兮梅未放，野猿笑我却空回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题息斋竹","author":"赵孟頫","text":"李侯写竹有清气，满纸墨光浮翠筠。\n萧郎已远丹渊死，欲写此君惟此人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题屏","author":"鲜于枢","text":"廨舍如僧舍，官曹似马曹。\n头巾终日岸，手板或时操。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武陵胜集得总字","author":"鲜于枢","text":"穷冬十日雪，户外曾未踵。\n念我平生友，欲往恨不勇。\n兹晨剧命驾，相对腹一捧。\n促招东林远，共念北海孔。\n把酒望六合，琼瑶纷总总。\n兴极不知休，严城钟鼓动。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"窦璧诗","author":"鲜于枢","text":"谁言河水浊，鸣镝约秦境。\n官军闹如蚁，城守申严警。\n窦璧一匹夫，欲汲困短绠。\n慷慨愿自效，行台可其请。\n从徒二十八，设伏独园静。\n逻骑百蹄翻，倏来落电影。\n勇士贵一决，犹豫失马猛。\n赏功不踰日，箫鼓喧市井。\n英风激衰软，胡以倍凄冷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"吾丘衍","text":"烹茶茅屋掩柴扉，双耸吟肩更撚髭。\n策杖逋仙山下去，骚人正是兴来时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举画花","author":"陈俨","text":"霅翁夙号老词客，乱后却工花写生。\n寓意岂求颜色似？\n钱唐风物记升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题江山归兴图","author":"黄玠","text":"秦望东南远欲无，依稀禹穴向姚虞。\n几时把酒鄞江上，却对乡山看此图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"方夔","text":"自郑有谋归华氏，舍湘无地托王琳。\n尔身不恤无埋地，此耻奚容更戴天。\n春盘脆响供雷笋，夜焙芳鲜摘露芽。\n蚕老任眠催作茧，燕来新乳贺成家。\n画角吹残低戍火，暮鸦横断远烟村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]