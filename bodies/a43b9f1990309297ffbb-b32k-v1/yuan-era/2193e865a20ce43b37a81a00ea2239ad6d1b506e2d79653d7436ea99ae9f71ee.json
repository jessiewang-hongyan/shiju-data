[{"title":"除夕偶成 其二","author":"周伯琦","text":"随缘合蜡答年除，桃板新书两两符。\n久直承明思保障，敢尘郎府列依乌。\n椒盘遂有邻人送，尊酒还将禄米沽。\n白发慈亲应远念，庭前诸弟綵衣娱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁甲申三月陪平章喀喇公子山展墓作","author":"周伯琦","text":"东风拂面又清明，共揖西山晓出城。\n杨柳数村烟外过，杏花十里雪中行。\n凤毛世表贤臣瑞，马踣人传故相茔。\n展罢归涂无限思，一尊松下重班荆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送平章喀喇公子山之官浙省三首 其一","author":"周伯琦","text":"宸心简注久金瓯，分陕东南第一州。\n夙望遂谐多士愿，先声已解远人忧。\n百年版籍承平久，故国城池景物幽。\n周翰暂纡申甫步，虞廷终待益皋谋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送平章喀喇公子山之官浙省三首 其二","author":"周伯琦","text":"讲帷启沃寸心丹，赤舄居东鼻吸酸。\n家学于今扬世美，庙堂自昔叹才难。\n湖山时雨沾封内，锦绣春风散履端。\n知己三生唯晋国，大书勋业肯惭韩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送平章喀喇公子山之官浙省三首 其三","author":"周伯琦","text":"中庭玉树戏斑衣，红药阶前对紫微。\n铁石广平新赋就，风流太傅一枰围。\n六经议论回天地，平日情怀在布韦。\n环召固知前席近，高名留共浙山巍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闰二月八日入直宣文阁上命陈阁中前代礼器赐问制作之由具对称旨纪事二首 其一","author":"周伯琦","text":"桃花开遍杏花开，星仗侵晨幸阁来。\n云绕香猊腾绮井，春随天步上瑶台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闰二月八日入直宣文阁上命陈阁中前代礼器赐问制作之由具对称旨纪事二首 其二","author":"周伯琦","text":"尧日堂中诏小臣，尊彝圭璧席前陈。\n诏稽制度论三代，却笑当年问鬼神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兴圣殿进讲即事是日赐酒饮杏花下","author":"周伯琦","text":"穆穆西清讲幄重，黄封赐饮杏花中。\n晴开步障衣笼锦，香沁流霞颊晕红。\n千载奇逢酣圣泽，一时凡骨尽仙风。\n相看天上无它愿，与物为春四海同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西内进讲即事 其一","author":"周伯琦","text":"牡丹苞栗药抽茧，曲槛飞香绿渐多。\n宿雨初收西掖静，青琴共奏汉廷歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西内进讲即事 其二","author":"周伯琦","text":"游蜂趁煖雀相呼，青杏县珠碧草腴。\n天上春风浓似酒，来禽花底倒宫壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东便殿进讲赐酒时牡丹盛开作 其一","author":"周伯琦","text":"片云飞雨晓濛濛，高下宫妆掩映中。\n已染异香朝北极，更依芳影立东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东便殿进讲赐酒时牡丹盛开作 其二","author":"周伯琦","text":"天颜每为讲经怡，锦绣丛中酒一卮。\n因笑沉香亭畔客，清狂只解赋新词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏西内芍药 其一","author":"周伯琦","text":"芳心有待却含羞，独殿群芳弄媚柔。\n不是红云连阆苑，定应绛雪积昆丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏西内芍药 其二","author":"周伯琦","text":"赭袍重拥翠云裘，尚有春风数日留。\n天女移来天上种，从今更不数扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜对月闻玉簪花香","author":"周伯琦","text":"虚馆金猊歇晚薰，碧纱如水透幽芬。\n素娥缓步多羞涩，微露搔头拥翠云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送巴克实彦卿尚书监宪浙东","author":"周伯琦","text":"浙东使相旧天官，绣斧风霜白昼寒。\n山耸金华蟠野岸，星明宝婺射秋湍。\n江头揽辔芙蓉艳，洞口题诗柿叶丹。\n指日澄清歌载路，斑衣趋召振台端。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河东宪司聘考试贡士过井陉关二首 其一","author":"周伯琦","text":"井陉如隧道，平地立巑岏。\n斗壁千寻峻，羊肠百折盘。\n泥深崖石滑，雨急野河湍。\n犹有淮阴迹，荒祠古树寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河东宪司聘考试贡士过井陉关二首 其二","author":"周伯琦","text":"晋赵分形胜，危关独耸然。\n缘坡频入谷，越岭复登天。\n土沃尤宜菜，民勤尽力田。\n居庸当北望，绵亘共山川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河东试院即事三首 其一","author":"周伯琦","text":"虚堂静院昼垂帘，朱墨分曹宪令严。\n兵卫重行皆雨立，文场何处覆星占。\n岂无威凤翔寥廓，定有神蛟起蛰潜。\n自古河汾多俊乂，会看异业佐轩炎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河东试院即事三首 其二","author":"周伯琦","text":"老槐俨立拂穹苍，庭户森然白昼长。\n地绕汾流常沮洳，山违松汉半微茫。\n西河旧是诗书里，曲沃今为农圃场。\n蟋蟀在堂秋欲暮，绝怜俭俗尚陶唐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河东试院即事三首 其三","author":"周伯琦","text":"井陉西抵古并州，千里迢迢亦壮游。\n出将承平忘习气，求贤尺一贵林丘。\n披沙思见河东赋，佩印空惭季子裘。\n文物低昂占世运，谁能借箸为前筹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太原道中即事","author":"周伯琦","text":"表里山河号盛强，太平民力尽耕桑。\n原田高下鱼鳞比，村舍横斜鸟翼张。\n稚子负薪依曲径，老翁牧犊卧前冈。\n恍然风物皆吴楚，只欠茅庐对夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过太行山","author":"周伯琦","text":"太行苍翠插秋旻，叠岭重关自昔闻。\n战国东西分晋赵，中原南北带河汾。\n帝王都邑青青草，豪杰勋名点点坟。\n鸟道盘空频立马，便从高处望飞云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵赵子期侍郎延春晓直作","author":"周伯琦","text":"天门金榜日华东，百辟趋朝仰六龙。\n玉食前羞常及旰，功裘列献又迎冬。\n云深螭陛凝朱草，露缀鸾旂滴翠松。\n直阁儒臣今稷契，丹心炯炯皂囊封。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送参议王君实之任燕南宪使","author":"周伯琦","text":"儒冠平步上青云，壮岁遭逢世罕闻。\n三辅共迎新刺史，六书元数右将军。\n滹沱雨后波无际，恒岳窗前草自薰。\n日报平反怡寿母，庙堂虚席伫奇勋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题大别山禹柏图","author":"周伯琦","text":"大别山前古柏寺，神禹当年手自栽。\n精灵上天宰溟漠，根荄得地形崔嵬。\n蛟龙作枝辰角化，金石为骨元气胚。\n谁其配之鲁庭桧，空中云雾时往来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁乙酉元旦早朝大明宫","author":"周伯琦","text":"玉帛朝元万国同，衮旒南面对春风。\n花明殿榻窗含雾，香泛壶筹渚绕虹。\n九奏云门黄帝乐，半空华盖太微宫。\n青规播物金禳兆，长戴尧天颂屡丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春入直四首 其一","author":"周伯琦","text":"春云淡淡雨霏霏，翠柏苍松十里围。\n晓漏催朝鱼钥启，时看黄鸟隔帘飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春入直四首 其二","author":"周伯琦","text":"草芽未绿柳先黄，曲槛重门辇路长。\n冰雪初销流禁禦，羊沟又见水汤汤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春入直四首 其三","author":"周伯琦","text":"溶溶太液涨新波，鸂?凫鹥点嫩莎。\n百尺飞虹通步辇，东西别馆得春多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春入直四首 其四","author":"周伯琦","text":"广寒宫阙插青冥，一带西山簇画屏。\n霁雪光风融上苑，满城春意护龙庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄吕仲实侍御","author":"周伯琦","text":"冠山主讲绣衣君，里塾弦歌到处闻。\n石室旧编应入梦，草堂新构更移文。\n桥头柳絮飘流水，谷口榆钱缀白云。\n千里相望春又暮，坐怀书带有清芬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月八日上京慈仁宫进讲纪事","author":"周伯琦","text":"黼扆临西内，文臣侍大廷。\n曙光团露瓦，暑气散风棂。\n香案陈群玉，彤惟对六经。\n精微恭奏御，渊默静垂听。\n共际天颜怿，因承圣德馨。\n琼浆能洗髓，霞酝可延龄。\n臞体深沦浃，丹心欲镂铭。\n锦铺川草碧，龙绕甸山青。\n芍药摇樊槛，枌榆护迾軿。\n巡方虞典礼，讲学汉宫庭。\n道统齐天地，彝伦炳日星。\n八荒暨声教，万国永仪刑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月七日慈仁宫进讲","author":"周伯琦","text":"清都虎豹肃重关，文石晨趋讲席班。\n傍阙云容开宝靥，隔帘山影拥青鬟。\n芸编缃帙分章进，玉斝金罍特诏颁。\n圣学有传光大业，前星在侍舞斓斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明日慈仁宫进讲毕钦承特命改授崇文监丞参检校书籍事是日同僚邀复游西山举酒为寿赋二首简谢雅意 其一","author":"周伯琦","text":"沙明潦尽路萦回，僧舍埋云石点苔。\n山影四围青欲合，草花五色锦成堆。\n起瞻北阙天光近，坐醉西风野兴催。\n好是清欢醇是酒，不须海上访蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明日慈仁宫进讲毕钦承特命改授崇文监丞参检校书籍事是日同僚邀复游西山举酒为寿赋二首简谢雅意 其二","author":"周伯琦","text":"故人意气厚难忘，况在皇州滦水阳。\n管鲍于今无一二，皋夔自昔比寻常。\n冯高喜隔尘嚣远，拂坐时闻草树香。\n便指南山同献寿，直倾北斗累千觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越四日供职拜觐慈仁宫谢恩作","author":"周伯琦","text":"碧树风微紫殿清，衣冠鹄立侍前楹。\n遗经毕讲陈愚戆，特命中颁拜宠荣。\n久污清华多士骇，独怜驽怯圣君明。\n同文昌运齐天寿，誓益涓埃罄此生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵宋显夫学士马上偶成","author":"周伯琦","text":"西望高榆夹岸垂，行人六月着绵衣。\n苑沙饱雨晴含湿，露草迎阳晓散辉。\n华阙中天当北极，穹庐千帐列重围。\n玉堂仙伯消长日，佳句盈囊发渐稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元章画青山白云","author":"周伯琦","text":"南宫神迈将军李，写丹青如泼墨水。\n川云江树指顾间，只尺吴山数千里。\n小楼接栋山之阳，孤舟㰕棹渡者将。\n桃源有路堪结隐，欲排大粒观圜方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月廿日钦承特命以崇文丞兼经筵参赞官进讲慈仁宫谢恩作","author":"周伯琦","text":"五云深护碧帘栊，面锡纶音简帝衷。\n两被特恩旬浃内，三登讲席五年中。\n风光荡荡乾坤大，寸草依依犬马忠。\n既醉流霞春浃髓，卷阿拭目凤栖桐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越三日恩赐衣币纪恩作","author":"周伯琦","text":"香罗叠腻织春云，色币含光涌浪文。\n扈从清华皆近侍，讲筵荣宠异前闻。\n恩颁在笥隆嚬笑，学乏明经守典坟。\n服拜深惭濡翼刺，垂衣共仰绍华勋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓舍紫菊","author":"周伯琦","text":"来时关北草初匀，去日滦阳白露新。\n窗下紫蕤颜色好，独延清兴款诗人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月廿八日己酉台臣传旨拜广东佥宪赐四品服入觐谢恩作 其一","author":"周伯琦","text":"侍经屡得被恩纶，特命乘轺纠外臣。\n敢用六条明汉典，要令百粤沐尧仁。\n绣衣春蔼萱花茂，金带光浮荔子新。\n圣德如天何以报，愿持寸念答严宸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月廿八日己酉台臣传旨拜广东佥宪赐四品服入觐谢恩作 其二","author":"周伯琦","text":"皇华遣使见成周，直指巡行汉礼优。\n岂意非才登此选，共知渊虑遍南州。\n严乡公论应多忝，乌鸟私情得少酬。\n万里举头天只尺，能忘珥笔侍前旒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"受除南行有日作","author":"周伯琦","text":"朝听敕目夕治装，眼底斑衣拜北堂。\n便养颇纡皇上念，叨荣亦列宪臣行。\n深秋雁影湖边月，初腊梅花岭上霜。\n平日齑盐今日试，羊城回首是明光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云州老人刘寿云诗卷 其一","author":"周伯琦","text":"云州州在万山间，万骑年年来往喧。\n独向白云深处住，不知人世有高轩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云州老人刘寿云诗卷 其二","author":"周伯琦","text":"东阡种粟西畦菜，凿石得泉如蜜甜。\n土酥瀹羹可供客，绕膝孙曾挽白?。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题舒噜存道元帅招安云南彻里国部诗卷","author":"周伯琦","text":"文武全材信丈夫，奇哉述律策勋殊。\n铜标界海光东汉，卉服浮江格有虞。\n日月照临蝼蚁穴，丹青点染犬羊图。\n还朝自草平南表，刻石燕然得比无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月廿四日起行驿至通州作","author":"周伯琦","text":"圣恩优异许陈情，苑驷南扬使者旌。\n薄技岂堪陪侍从，乏才因得直承明。\n亲庭遥忆经年别，官驿初行第一程。\n礼乐光华今日盛，长看海晏与河清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁戊子五月将赴闽宪徵擢翰林待制兼国史院编修官九月驿至京师送季长弟之任山南宣慰照磨二首 其一","author":"周伯琦","text":"间岁淮南送北征，今从燕北饯南行。\n三年一会难为别，万里相思可奈情。\n候馆霜晴荒草白，官河风尽片帆轻。\n高堂延伫斑衣切，安得联翩奉寿觥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁戊子五月将赴闽宪徵擢翰林待制兼国史院编修官九月驿至京师送季长弟之任山南宣慰照磨二首 其二","author":"周伯琦","text":"荆南巨镇雄全楚，控带中原自古然。\n江汉东流横宇宙，岷峨西望接云烟。\n城环鹤泽流风在，台耸龙山盛事传。\n已侍朝仪明大典，要陈幕议继前贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送冯公励大学士致政归太原","author":"周伯琦","text":"中外扬名五十年，安车一旦赋归田。\n德星移次天光近，老圃宜秋晚节全。\n滹沱冰坚桥路稳，井陉雪霁驿程便。\n午庄未许裴公隐，淇澳重歌卫武贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送巴克实彦卿学士之任燕南宪使得云字","author":"周伯琦","text":"风纪端治本，宵旰期忧分。\n甸畿严首选，部封慑先闻。\n桓桓梁栋具，煜煜黼黻文。\n全才古云难，显用今所欣。\n玩弛日已甚，栉耨得辞勤。\n淑邪自泾渭，雅俗何莸薰。\n凤鸾一瑞世，鸱鸮不能群。\n滹沱无惊波，恒岳常丰云。\n春风吹玉节，骢马镳朱幩。\n仓庚集乔木，草色迷川垠。\n私怀惜暂别，众愿树奇勋。\n庙堂久虚席，泚笔扬清芬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日同翰林远至道待制颜元卿经历危太朴应奉钑鸣谦编修游长春宫","author":"周伯琦","text":"休沐同真赏，清明雪霁馀。\n都城瞻壮丽，仙阁挹高虚。\n亭馆烟霞合，园林锦绣舒。\n桃源归路稳，烂醉任狂疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送侍御余廷心佥宪浙东三首 其一","author":"周伯琦","text":"春云阴似幂，春雨细于丝。\n史馆承恩日，都门祖道时。\n星轺行浙左，采服照江湄。\n忠孝应兼尽，同深别后思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送侍御余廷心佥宪浙东三首 其二","author":"周伯琦","text":"紬书功未竟，持节命方隆。\n已擅雄文誉，还扬肃政风。\n杨花飞雪白，芍药舞云红。\n咨度多馀力，新诗寄便鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送侍御余廷心佥宪浙东三首 其三","author":"周伯琦","text":"天台环海岸，雁荡插云霄。\n胜槩东南绝，才人玉雪标。\n访游清暇足，题咏逸怀超。\n旅食京华客，因君意也消。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁己丑天寿节拜赐御酒作","author":"周伯琦","text":"前岁尧尊被海隅，今年亲拜帝觞馀。\n已将雨露苏封部，复立云霄直禁庐。\n此日河清占混一，万方春育囿吹嘘。\n长歌既醉微生幸，金鉴贞符更并书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送经历巴延图元卿佥宪河南","author":"周伯琦","text":"去年同赴金銮召，今日占君绣斧行。\n治最吴公留旧爱，名优朱博慑先声。\n梁园柳暗灵台寂，汲水荷香列馆清。\n揽辔长途多逸兴，幸将秀句寄遐情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月八日升除崇文少监兼经筵官拜觐行殿二首 其一","author":"周伯琦","text":"诏移闽节入紬书，凡例森严愧学疏。\n执简七旬陈薄技，循墙三命拜新除。\n南薰歌蔼无为治，东壁光遥太乙居。\n身际承平恩遇渥，敢将经术赞华胥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月八日升除崇文少监兼经筵官拜觐行殿二首 其二","author":"周伯琦","text":"内阁重叨侍从班，侵晨幄殿觐天颜。\n丝纶垂问怜疏远，樗栎无遗激钝顽。\n华盖云容笼阁道，居庸御气绕燕山。\n都俞不减唐虞盛，舆颂中原沸九关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日阁中入直五首 其一","author":"周伯琦","text":"金铺蹲兽钥衔鱼，碧树沈沈白玉除。\n留后命严番直肃，五云深处掌图书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日阁中入直五首 其二","author":"周伯琦","text":"冰盘堆果进流霞，中秘翻馀夕景斜。\n画舫径从圜殿过，凤麟洲上数荷花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日阁中入直五首 其三","author":"周伯琦","text":"东西二阙赤霄间，百尺金茎万岁山。\n一道银河天上出，遥分光润散人寰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]