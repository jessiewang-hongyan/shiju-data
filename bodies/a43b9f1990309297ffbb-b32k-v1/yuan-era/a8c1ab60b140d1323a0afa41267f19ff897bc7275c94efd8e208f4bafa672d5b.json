[{"title":"次韵刚父即事绝句 其一","author":"赵孟頫","text":"玉树凋伤众草黄，夜虫时语怨流光。\n美人望望隔秋水，不寄相思书一行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刚父即事绝句 其二","author":"赵孟頫","text":"凄凉鼓角北风传，嘈杂琵琶思远天。\n白雪有谁知幼眇，翠蛾空自惜联娟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刚父即事绝句 其三","author":"赵孟頫","text":"摇落山川树影稀，陇云时逐雁南飞。\n苦无渌酒酬佳节，犹有黄花媚夕晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题僧惟尧墨梅","author":"赵孟頫","text":"萧洒孤山半树春，素衣谁遣化缁尘。\n何如澹月微云夜，照影西湖自写真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题范蠡五湖杜陵浣花 其一","author":"赵孟頫","text":"功名自古是危机，谁似先生早拂衣。\n好向五湖寻一舸，霜黄木叶雁初飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题范蠡五湖杜陵浣花 其二","author":"赵孟頫","text":"春色醺人苦不禁，蹇驴驮醉晚骎骎。\n江花江草诗千首，老尽平生用世心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花","author":"赵孟頫","text":"潇洒江梅似玉人，倚风无语澹生春。\n曲中桃叶元非侣，梦里梨花恐未真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王子庆诏檄浙东收郡县图籍 其一","author":"赵孟頫","text":"木落江南天地秋，西风吹子过东州。\n试开图籍寻佳处，便命舟车作胜游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龚圣予山水图 其一","author":"赵孟頫","text":"泽雉樊中神不王，白鸥波上梦相亲。\n黄尘没马归来晚，只有西山小慰人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龚圣予山水图 其二","author":"赵孟頫","text":"当年我亦画云山，云白山青只尺间。\n今日看山还自笑，白头输与楚龚闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭州雨中","author":"赵孟頫","text":"江南十日九阴雨，花柳欲开无好春。\n却忆京城二三月，秋千风暖涨香尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题舜举折枝桃","author":"赵孟頫","text":"醉里春归寻不得，眼明忽见折枝花。\n向来飞盖西园夜，万烛高烧照烂霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀德清别业 其一","author":"赵孟頫","text":"阳林堂下百株梅，傲雪凌寒次第开。\n枝上山禽晓啁哳，定应唤我早归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"部中暮归寄周公谨 其一","author":"赵孟頫","text":"日莫空街生白烟，归来羸马不胜鞭。\n明朝又逐鸡声起，孤负日高花影眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"部中暮归寄周公谨 其二","author":"赵孟頫","text":"三年谩仕尚书郎，梦寐无时不故乡。\n输与钱唐周老子，浩然斋里坐焚香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都南张氏园寓居","author":"赵孟頫","text":"尺五城南迹似幽，乡心空折大刀头。\n杏花飞尽燕脂雪，日日东风未肯休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和黄景杜雪中即事 其二","author":"赵孟頫","text":"雪寒凄切透书帷，极目南云入望低。\n欲报平安无过雁，忽惊残梦有鸣鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和黄景杜雪中即事 其三","author":"赵孟頫","text":"君说江南苦未归，香橙新酒蟹螯肥。\n何当与子扁舟去，共挽清溪浣客衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和黄景杜雪中即事 其四","author":"赵孟頫","text":"客里相从意最亲，高歌快饮见天真。\n明年去学潘怀县，满县栽花做好春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和黄景杜雪中即事 其五","author":"赵孟頫","text":"当年临水照春衫，浮玉山前水似蓝。\n归计未成羁思恶，为君飞梦到城南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖上莫归 其一","author":"赵孟頫","text":"春阴柳絮不能飞，雨足蒲芽绿更肥。\n政恐前呵惊白鹭，独骑款段绕湖归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事三绝 其一","author":"赵孟頫","text":"湘帘疏织浪纹稀，白苧新裁暑气微。\n庭院日长宾客退，绕池芳草燕交飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事三绝 其二","author":"赵孟頫","text":"古墨轻磨满几香，研池新浴照人光。\n北窗时有凉风至，闲写黄庭一两章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其三","author":"赵孟頫","text":"驱车秣驽马，吾将适齐国。\n闻有鲁连子，俶傥好奇画。\n一谈秦师走，再说聊城拔。\n功成不受赏，高举振六翮。\n布衣终其身，岂复为世役。\n茫茫千载远，安往访遗迹。\n踌躇东海上，向风长太息。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其四","author":"赵孟頫","text":"四时相代谢，荣耀何足恃。\n瓜田引新蔓，不见桃与李。\n知士解其会，遇坎当复止。\n邵生故秦吏，乃亦睹兹理。\n贤哉感我怀，三叹不能巳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其五","author":"赵孟頫","text":"子真初亦仕，岁晚乃逃之。\n区区南昌尉，上疏忘其卑。\n忠言不见用，耿耿当告谁。\n飘然弃妻子，终身与世辞。\n抱关甘贫贱，所贵莫我知。\n至今九江濆，清风激群黎。\n神仙信茫昧，此士独不疑。\n孤云无定在，逝水何时归。\n遐思一矫首，怅望无由期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其六","author":"赵孟頫","text":"悠悠空山云，泱泱长江流。\n廊庙意不屑，山泽聊淹留。\n故人在天位，高步追巢由。\n岂曰子无衣，辛苦被羊裘。\n东京多节义，之子乃其尤。\n穷居虽独善，辅世岂不优。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其七","author":"赵孟頫","text":"汪汪千顷陂，不为人浊清。\n道周言行表，荡然无得名。\n谁言牛医儿，乃是人中英。\n当时无间言，后世流德声。\n思之不可见，使我鄙吝萌。\n淳风久已漓，此意岂复明。\n时无君子者，虽贤宁见称。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其八","author":"赵孟頫","text":"南州有高士，食力事耕稼。\n优游聊卒岁，不矫亦不隘。\n大木行欲颠，绋纚岂足赖。\n何为诸老翁，栖栖不遑舍。\n斯言非无见，明哲自高迈。\n谁能悬一榻，待子来税驾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其九","author":"赵孟頫","text":"鹿门何亭亭，下有辟世贤。\n凤雏隐中林，卧龙蟠其渊。\n一朝起高翔，斯人独深潜。\n功名不可为，我志久已安。\n一闻耆旧传，使我心悠然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其十","author":"赵孟頫","text":"黄鹄羽翼长，一举思千里。\n幼安本中原，乘桴走东海。\n举世方尚同，远引存吾志。\n流风渐异俗，敦礼化邻鄙。\n子鱼平生友，胡乃不相委。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其十一","author":"赵孟頫","text":"尘事非所便，田园久见招。\n归来三径中，蔚蔚长蓬蒿。\n虽有荷锄倦，浊酒且自陶。\n茫茫大化中，委运将焉逃。\n唐虞去已远，由来非一朝。\n粲粲霜中菊，采采忘其劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次袁学士上都诗韵","author":"赵孟頫","text":"晓日夹云树，春风吹雪山。\n飞鹰玄兔碛，饮马白狼湾。\n宝带吴钩迥，金矛汉节閒。\n将军万里外，不怕二毛斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈都事云南铨选兼简李廉访","author":"赵孟頫","text":"送君铨选使滇池，部落诸夷自品题。\n明月梦回夔子北，长风吹度夜郎西。\n山连塞雨骅骝滑，花落蛮云杜宇啼。\n为问霜台李学士，白头官满尚羁栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭州拱北楼","author":"赵孟頫","text":"城上高楼接太霞，令严钟鼓静无哗。\n提封内向三千里，比屋同封百万家。\n心在江湖存魏阙，身随牛斗泛仙槎。\n举头便觉长安近，时倚阑干望日华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠脱帖木儿总管","author":"赵孟頫","text":"将军铁马拥雕弓，壮岁分符镇越中。\n山水多情留贺监，儿童拍手爱山公。\n紫髯似戟君犹健，白发如丝我巳翁。\n悦礼敦诗殊不忝，看君真有古人风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和姚子敬韵","author":"赵孟頫","text":"同学故人今已稀，重嗟出处寸心违。\n自知世事都无补，其奈君恩未许归。\n沧洲白鸟时时梦，玉带金鱼念念非。\n准拟明年乞身去，一竿同理旧苔矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题孙登长啸图","author":"赵孟頫","text":"在涧幽人乐考槃，南山白石夜漫漫。\n空林无风万籁寂，长啸一声山月寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史","author":"赵孟頫","text":"酒酣斫剑气如云，屠狗吹箫尽策勋。\n汉室功臣谁第一，黄金合铸纪将军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫中口号 其一","author":"赵孟頫","text":"日照黄金宝殿开，雕阑玉砌拥层台。\n一时侍卫回身立，天步将临玉斧来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四画 其三 四皓","author":"赵孟頫","text":"白发商岩四老翁，紫芝歌罢听松风。\n半生不与人间事，亦堕留侯计术中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成 其一","author":"赵孟頫","text":"竹林深处小亭开，白鹤徐行啄紫苔。\n羽扇不摇纱帽侧，晚凉青鸟忽飞来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事 其一","author":"赵孟頫","text":"庭槐风静绿阴多，睡起茶馀日影过。\n自笑老来无复梦，閒看行蚁上南柯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜曲","author":"赵雍","text":"去年美人未还家，绿窗青春桃始花。\n桃花今年只依旧，美人别后长咨嗟。\n芳心欲传向谁愬，卷却罗袖弹琵琶。\n琵琶声哀思欲绝，衣上啼痕几时灭。\n共君别久胡不来，菱花宝镜生尘埃。\n君隔扬子江，妾居黄金台。\n台虽高，望无极，人万里兮天咫尺。\n春水绿波春草碧，来鱼去雁无消息。\n日既暮兮月色寒，相思如梦彫朱颜。\n青灯炯炯照不寐，揽衣起坐空愁叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春","author":"赵雍","text":"高卷珠帘日渐长，梅花庭院雪飘香。\n闲倚阑干看新柳，不知谁为染鹅黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"结羊肠","author":"赵雍","text":"孟春之月春始和，陌头柳色黄如鹅。\n落梅纷纷稍觉多，白日炯炯曜绮罗。\n曜绮罗，日渐长，春风庭院花草香。\n十六初过上元节，家家女儿结羊肠。\n含情暗卜心自语，何时得似双鸳鸯。\n结成羊肠肠反断，惆怅春闺坐长叹。\n强持薄怒娇且羞，折花倒插金钗头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"美人曲","author":"赵雍","text":"美人如花花不如，翠滑难胜碧玉梳。\n道修且阻无音书，蛾眉长颦未曾舒。\n春风吹衣裳，黯然泪沾襟。\n莺啼出无心，转添愁海深。\n窗前红梅花，落尽不可簪。\n玉台明镜如秋水，疑有人间两西子。\n美人未可彫朱颜，朱颜但愿长如此。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"千里思","author":"赵雍","text":"颜如花，肤如雪，秋水双眸面如月。\n千里相思不相见，当时却恨轻离别。\n美人美人颦蛾眉，绿窗寂寂春风微。\n巫山梦断君何处，化作朝云缥缈飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有所思","author":"赵雍","text":"纷纷落花飘，美人在何许？\n相思杳如梦，寂莫春已暮。\n一别久不见，一往久不还。\n相望虽咫尺，如隔千万山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕二首 其一","author":"赵雍","text":"初月纤纤照露台，枉将瓜果闹婴孩。\n今宵自有经年约，何暇閒情送巧来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕二首 其二","author":"赵雍","text":"牵牛河东织女西，相望千古几时期。\n夜深只恐天轮转，地底相逢未可知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗","author":"赵雍","text":"我居水精宫，远游来朔方。\n离家近十载，兄弟遥相望。\n始见世情薄，纷纷名利场。\n富贵不可期，人生难忖量。\n乾坤本无私，江山叹兴亡。\n蝉声噪落日，露草啼寒螀。\n明月如有情，照我肝与肠。\n西风动林东，萧然秋意凉。\n回首岁云暮，信美非吾乡。\n展转复展转，愁多知夜长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思归","author":"赵雍","text":"袅袅秋风动客怀，啾啾猿鹤苦相催。\n鲁侯不遇关天意，臧氏焉能沮我才。\n万里驱驰离旧国，十年奔走在尘埃。\n吴兴山水何清远，一棹扁舟归去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初秋夜坐二首 其一","author":"赵雍","text":"夜深庭院寂无声，明月流空万影横。\n坐对荷花两三朵，红衣落尽秋风生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋声","author":"赵雍","text":"邕邕鸣雁复南征，十载栖迟在帝京。\n黄叶未零寒未应，秋声偏动故乡情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"赵雍","text":"独坐对明月，遥遥千古情。\n西风两三日，庭树已秋声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山佳处分得解字","author":"赵奕","text":"我从姑苏来，高台逢吕豸。\n共坐话当年，日昃不能罢。\n回瞻玉山青，百里风帆挂。\n维舟草堂前，梧竹自潇洒。\n一别逾三秋，相见各惊骇。\n开筵出红妆，持杯擘紫蟹。\n黄花照白发，流光岂能买。\n兹辰且尽乐，一醉百忧解。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日书怀","author":"赵奕","text":"忙里过韶华，东风日易斜。\n黄粱应未熟，白酒尚堪赊。\n蝶魄迷幽梦，蛛丝绊落花。\n百年能有几，随分度生涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山与郯九成自姑苏来吴兴僧可传邀余陪游弁山之黄龙洞时有紫霞同席遂分韵得花字","author":"赵奕","text":"盘屈度埼礒，嵚崟复谽谺。\n龙居潜石洞，花暖护蜂衙。\n峭壁生苍藓，清泉长赤砂。\n松涛响云壑，竹翠滴桃花。\n杖屦丹梯险，篮舆绿磴遮。\n攀藤啸猿狖，并草卧麇麚。\n绝顶望笠泽，倾溟想女娲。\n遥天连岛屿，远水接蒹葭。\n道士来邀坐，仙童为煮茶。\n林深多虎迹，地僻少人家。\n对景诗情逸，寻芝道气遐。\n窗幽尘不到，境胜兴无涯。\n堪种茅山术，宜栽邵圃瓜。\n宝书传正法，灵剑挂青蛇。\n径滑崎尤峻，苔荒突又洼。\n淙淙流暗涧，聒聒叫鸣蛙。\n下岭日欲落，登舟路更赊。\n平田飞白鹭，别墅宿归鸦。\n犬吠柴门近，鹃啼野树斜。\n菜畦黄扑簌，麦垄碧交加。\n老态倦跋涉，衰形独叹嗟！\n山翁荷锄锸，村妇倚篱笆。\n驻舫携红袖，停杯挟紫霞。\n金炉薰笃耨，玉手弄琵琶。\n错落倾香酿，玻瓈插艳葩。\n歌姬声缥缈，醉客笑喧哗。\n击柝城将闭，吹笳鼓尚挝。\n卷帘风灭烛，湿幔雨垂麻。\n今日虽云乐，他年还共誇。\n更阑归去速，灯影照笼纱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨窗写怀","author":"赵奕","text":"幽窗谈笑话平生，三十年间几度更。\n白发满头今已老，青山排闼故多情。\n桃花灼灼应无语，春雨萧萧尚未晴。\n明日扁舟携好酒，南村笋蕨正堪烹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送闻梅涧住弁山祥应宫","author":"赵奕","text":"石磴悬崖人迹稀，林深地僻绝尘机。\n井边丹灶千年冷，窗外山云尽日飞。\n老虎每来廊下走，黄龙常向洞中归。\n先生有道开门坐，松响瑶笙月满衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游玉山佳处写赠仲瑛","author":"赵奕","text":"我爱玉山奇绝处，碧梧翠竹映阑干。\n轩窗傍水琴书静，楼阁连云宇宙宽。\n山色溟濛还淡淡，湖光潋滟自漫漫。\n登临纵目无穷处，落日西风作暮寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"赵奕","text":"湖头日日水光波，两两吴娃打桨过。\n笑隔芙蓉不相识，向人犹自唱吴歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]