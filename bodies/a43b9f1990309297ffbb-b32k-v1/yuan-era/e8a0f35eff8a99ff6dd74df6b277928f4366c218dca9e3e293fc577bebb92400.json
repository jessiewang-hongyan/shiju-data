[{"title":"三台怀古 其二","author":"杜瑛","text":"白鸟飞边望眼宽，兴来一吸酒杯乾。\n土花渍雨铁梁涩，蔓草接秋冰井寒。\n树拂晓风摇北土，水涵落日蹴西山。\n书生岂识兴亡事，片瓦摩挲认建安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"征南口号","author":"杜瑛","text":"春早云南麦已黄，泸江蒸雾水如汤。\n马蹄半带阴山雪，变作人间六月凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和信之板桥路中古风二首 其一","author":"杜仁杰","text":"岸风坼枯凌，野日明远烧。\n山晚云烟深，游子悲崄峭。\n平生文字僻，所历入吟啸。\n急景不贷人，佳处领其要。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和信之板桥路中古风二首 其二","author":"杜仁杰","text":"木杪来江光，中途憩消摇。\n佳人在空谷，尺素昔见招。\n徒老黄尘中，愧尔渔与樵。\n永怀《梁父吟》，日暮风萧萧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发黄有感","author":"杜仁杰","text":"飘萧中年发，既少何用白。\n苍黄未甚丝，明知不更黑。\n妻孥恐生悲，劝我课锄摘。\n眷然抚镜镊，青山堕虚席。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"禹城道中","author":"杜仁杰","text":"自发醯鸡覆，蓬心得少瘳。\n乾坤一尺箠，今古几全牛。\n岁月怜丹灶，云山笑白头。\n此生真欲上，何地不菟裘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中枕上","author":"杜仁杰","text":"忽忽卧几月，遂成疏懒名。\n却因久病后，更觉万缘轻。\n月落窗影动，夜寒灯晕生。\n狸奴似相慰，分坐守残更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送信云父","author":"杜仁杰","text":"居士身轻日，秋天木落时。\n山青云冉冉，川白草离离。\n涉世心将破，怀人鬓已丝。\n相逢琴酒乐，应怪久违期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中忆坦夫兄","author":"杜仁杰","text":"共脱壬辰乱，他乡见愈亲。\n论才唯有子，知己更无人。\n避世相看老，通家未拟贫。\n竹林平日约，早晚得为邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"从军","author":"杜仁杰","text":"野阔牛羊小，天低草树平。\n吴疆连晋境，汉卒杂番兵。\n月合围城晕，风酣战阵声。\n中原良苦地，上古错经营。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中寄高无尘","author":"杜仁杰","text":"久客饶孤闷，连阴动浃旬。\n行云应已倦，细雨亦伤频。\n飘泊嗟吾道，饥寒任此身。\n人家酒应熟，谁为问南邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪后书事","author":"杜仁杰","text":"雪罢山原净，日晴风景新。\n一川花气午，万壑水声春。\n天地开华国，关河失战尘。\n无边春色里，惆怅独行人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至日","author":"杜仁杰","text":"松竹浣花里，桑麻杜曲田。\n苍茫辞蜀地，辛苦见秦天。\n死去谁怜汝，生还事偶然。\n但甘终垄亩，待聘岂前贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿金线泉","author":"杜仁杰","text":"官舍值淫雨，客衣惊早秋。\n泄云迷灌木，行潦带清流。\n蛛网翻新霁，蝉声咽暮愁。\n古今何限事，白首对沧洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋夜宿普照喜周卿至","author":"杜仁杰","text":"久客厌孤寂，跫然闻子来。\n夜凉风缩瑟，云破月徘徊。\n旧事休重说，新诗且细裁。\n几年无此夕，独欠两三杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"杜仁杰","text":"老泪河源竭，忧端泰华齐。\n苦吟知有恨，细写却无题。\n事与孤鸿北，身携片影西。\n催归烟树外，不用向人啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沧浪亭观雨","author":"杜仁杰","text":"萧萧北风吹北窗，浪浪秋雨泻秋江。\n痴蝇不飞集枯几，饥鼠屡出翻空缸。\n杂花叶底开无数，佳木门前立自双。\n散地自知心地远，赏音谁解足音跫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中呈裕之","author":"杜仁杰","text":"十载犹能复笑谈，归来重觅读书龛。\n耒阳白酒君应具，勾漏丹砂我自惭。\n民讼几时消自苦，山城虽小得穷探。\n也知清俭难持久，好趁秋风酒菊潭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自遣二首 其一","author":"杜仁杰","text":"少日襟怀悔自豪，暮年志节讵须高。\n敢将议论轻疑孟，閒得工夫细和陶。\n酒尽枯肠还磊礧，诗成白发转刁骚。\n皇天汲汲诚何意，也共人生一体劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自遣二首 其二","author":"杜仁杰","text":"畚筑家园手自操，虽无多景足偿劳。\n十年种竹翻嫌密，一日栽松恨不高。\n是处求田消二顷，尚谁有梦到三刀。\n得名身后良痴计，尽拟浮沈付浊醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读前史偶书","author":"杜仁杰","text":"杨彪不著鹿皮冠，元亮还书甲子年。\n此去乱离何日定，向来名节几人全。\n中原消息苍茫外，故里山河涕泪边。\n六国帝秦天暂醉，鲁连休死海东壖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"解嘲呈元明府","author":"杜仁杰","text":"江气冥冥江雨飞，潜夫四月著冬衣。\n野荼蘼谢蔷薇发，山鹧鸪啼杜宇归。\n青鬓渐随愁共减，素心长与慢相违。\n四方糊口非君事，自识飘零有是非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延津待渡寄仲温参议","author":"杜仁杰","text":"一望河平一慨然，战尘如雾水如天。\n要知别后思君处，长在孤城落日边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜宿郓城","author":"杜仁杰","text":"残月和灯照弊帷，疏风乘隙入征衣。\n恰逢远客思归日，正是家人说梦时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长门怨","author":"杜仁杰","text":"天上神仙也别离，人间那得镇相随。\n不须贵买临邛赋，只想君王未见时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲁郊","author":"杜仁杰","text":"六十衰翁更莫閒，好将华发映青山。\n穆生自合寻归计，不在区区醴酒间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王魏二学士应聘","author":"杨云鹏","text":"三十年来只用兵，蒲轮才始聘贤英。\n已将药石除危疾，政要文章致太平。\n天子飞龙方启运，华阳归马岂无程。\n会须先下山东诏，癃老思观德化成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送元遗山","author":"杨云鹏","text":"三馆才名天下闻，乱来俗议漫纷纭。\n两朝文笔谁争长，一代诗人独数君。\n南浦春深愁送别，西山晚翠约平分。\n何时并坐龙潭上，野水添杯看白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至日","author":"杨云鹏","text":"又见葭灰动一阳，岂堪卧病客殊方。\n老怀不似少年好，短景始从今日长。\n黄犬既难遥附信，玄龟何用苦支床。\n恨无羽翼高飞去，六六峰前望故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张雄飞赴河阳令","author":"杨云鹏","text":"祖帐行将出汝州，先声已过孟津头。\n鸣琴但要追循吏，束带何妨见督邮。\n二室风烟连赤县，三城鼓角隔黄州。\n遥知乱后农耕废，卖剑应须剩买牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张器玉归闽中","author":"杨云鹏","text":"十载流离避战尘，白头憔悴始归秦。\n霜前渭水有归雁，乱后长安无故人。\n不惮北邙迁榇远，莫忘东鲁寄书频。\n明年我亦崧南去，拟买黄牛种汝滨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送殷献臣北上","author":"杨云鹏","text":"毳锦模糊覆橐驼，骎骎征骑度沙陀。\n寒冲绝漠戎装重，夜绕中华汉梦多。\n诗健每因横槊赋，曲豪长爱击壶歌。\n勒功会待平吴策，万仞西山尚可磨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵维道北上","author":"杨云鹏","text":"干戈流落鬓毛焦，千里穷途著弊貂。\n老去少陵悲橡食，乱来王粲逐蓬飘。\n朔庭云涨龙沙冷，南斗尘昏象阙遥。\n从此分携相见少，旅魂飞断不胜招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋晚登宪陵台","author":"杨云鹏","text":"落日荒陵百尺台，登临高兴亦悠哉。\n泰山云尽千峰出，汶水霜晴一雁来。\n白发还乡惟有梦，青云当路岂无媒。\n布衣谁识新丰客，独对秋风酒一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"真定龙兴寺阁","author":"杨云鹏","text":"插天飞构郁嵯峨，栏角涛声转暮河。\n孤鸟去边沧渚阔，落霞明处碧山多。\n伤时未遂陈三策，吊古犹堪赋《九歌》。\n安得天丁挽天汉，倒倾京洛洗干戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白乐天影堂","author":"杨云鹏","text":"晚慕浮屠伴衲衣，至今高榜揭岩扉。\n梦中身世元无有，壁上形容果是非。\n但得蓬蒿犹可住，何须兜率是真归。\n渺茫两地知何在，满眼春波白鹭飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日西城","author":"杨云鹏","text":"山城二月媚晴晖，破暖轻风试裌衣。\n雨后杏花浑放尽，社前燕子尚来稀。\n孤怀不奈千愁积，往事真成一梦非。\n却羡西桥桥畔柳，年年翠色自依依。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东原除夜","author":"杨云鹏","text":"客舍无人静掩扉，小窗灯火独相依。\n一年残腊今宵尽，千里故乡何日归。\n鬓发半随春雪白，交游浑似晓星稀。\n乱离不得中州信，肠断云间雁北飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日游何氏园","author":"杨云鹏","text":"旋引溪流环小苑，出墙袅袅见长虹。\n临风遥听有人语，隔水却疑无路通。\n尘迹尽抛双屦外，春光别贮一壶中。\n当门羡杀南塘好，拟买扁舟学钓翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送演上人归方山寺","author":"杨云鹏","text":"为爱岚光画里秋，西风归梦日悠悠。\n卧云未了三生债，飞锡何烦万里游。\n山削碧城围寺合，泉鸣苍佩入池流。\n遥知一室安禅处，更在诸峰最上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张汉臣归保塞兼简张万户","author":"杨云鹏","text":"十年文笔远从戎，籍籍名香幕府中。\n鞍马不教生髀肉，檄书端可愈头风。\n地连三赵山河壮，城镇三关鼓角雄。\n若见投壶祭征虏，为言白首坐诗穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王希仲北归","author":"杨云鹏","text":"高歌行采北山薇，回首兵尘满帝畿。\n龙去鼎湖中国换，鹤归华表昔人非。\n后期何处伤心切，远别从今见面稀。\n莫道尺书千里隔，年年沙塞雁南飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雁","author":"杨云鹏","text":"远客思乡未得归，征鸿又见度斜晖。\n黄芦洲渚霜前至，红叶关河画里飞。\n别后望君消息久，乱来哀我弟兄稀。\n凭高此日堪肠断，那复江城捣暮衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别萧高凤","author":"刘将孙","text":"惜与可人别，又贪归路长。\n人生有离别，吾事属閒忙。\n沽酒浇芳草，垂鞭看夕阳。\n眼前听鹤语，世路剧茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱方立游荆二首 其一","author":"刘将孙","text":"岘山西上楚天头，书剑区区事远游。\n岁月如流方作客，江山信美莫登楼。\n百年耆旧谁家传，一代衣冠又古丘。\n乱后题诗诗即史，未应轻付水东流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱方立游荆二首 其二","author":"刘将孙","text":"不辞跋涉恨崎呕，如此飘飘一丈夫。\n新雨惊秋鸣草树，行人随雁落江湖。\n岁年宁向长途老，天地何堪一室拘。\n几世中原今复合，更陪九石作鹏图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子固兰蕙卷","author":"郭麟孙","text":"写兰以左笔为难，此图笔笔皆向左。\n香风一夕从西来，数片湘云忽吹堕。\n天真满前呈烂熳，晴烟低叶分娿娜。\n紫茎缥缈散曾华，翠带交加藏侧朵。\n初观骇目若零乱，缔视凝神还帖妥。\n想翁落笔风雨疾，不待解衣盘薄裸。\n但觉书纸如书空，唯知有兰那有我。\n胸中所在皆众芳，变化纵横无不可。\n他人一二已云多，翁今能事一何夥。\n嗟予作画虽不能，知兰之趣亦颇颇。\n再观品题惊绝倒，照眼骊珠十六颗。\n清气袭人肌骨寒，手之不置行与坐。\n陶君珍重秘藏之，玉轴牙签善封裹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高尚书秋山暮霭图","author":"郭麟孙","text":"长江万里流滔滔，风平如席静不涛。\n老枫疏柳澹云影，敧岸侧岛明秋毫。\n红尘一点飞不到，何人结屋江之皋。\n霜清水落沙屿出，芦叶瑟瑟鸿南翱。\n一峰崒嵂耸峨髻，俯视培嵝如儿曹。\n晴岚朝爽滴空翠，树林露沐滋流膏。\n心融造化意惨澹，笔挟风雨声萧骚。\n淋漓元气犹带湿，收拾万象无能逃。\n扶舆清淑聚胸次，固应独擅人间豪。\n未容小米诧能事，千古且说文昌高。\n世间神物不易得，牙签玉轴归时髦。\n我来坐窗疲不遨，展卷顿觉舒郁陶。\n何烦蜡屐跻攀劳，崦西小红寻野桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题苏子瞻翰墨","author":"郭麟孙","text":"山头崒嵂侵霄汉，片幅之间据其半。\n河水盘旋寒玉贯，云气濛濛中截断。\n峰峦回合平若接，山城嵯峨耸楼观。\n下有森森林木灌，隐约浮空露纤巘。\n沙平野旷征途远，行人凌竞马欲汗。\n天机满前呈烂熳，浓墨如新笔凌乱。\n浑沌凿空太极判，元气淋漓风雨散。\n若非定以范宽断，谁能展此奇手段。\n玉堂老仙重称赏，绝笔当为古之冠。\n牙签玉轴宜倒看，纵得千金慎勿换。\n老眼摩挲获珍玩，不敢留题只惊叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵荣禄水村图","author":"郭麟孙","text":"泽国净秋色，远山横夕烟。\n水田群雁起，芦渚一罾悬。\n林树几间屋，君家若个边。\n扁舟何日去，相伴白鸥眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与龚子敬同赋","author":"郭麟孙","text":"清游及新霁，缓步得嘉宾。\n古木寒泉寺，鸣鸠乳燕春。\n山行六七里，舟受两三人。\n总是曾经处，何须更问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月三日重游虎丘二首 其一","author":"郭麟孙","text":"三月三日天气好，一年一度虎丘游。\n枇杷岩下频呼酒，杨柳桥边旋系舟。\n春事固知欺白发，山灵元不厌清流。\n祇今觞咏成陈迹，何用兰亭俯仰愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龚子敬同游桃花坞赵中时适至","author":"郭麟孙","text":"麦光晓郭摇香浪，花气浮空散紫霞。\n小院碧桃留客醉，隔林修竹又谁家。\n清明过了春将暮，浊酒倾残日又斜。\n一笑相逢诚不易，人生看得几韶华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再题水村图","author":"郭麟孙","text":"分湖新卜筑，适与此词同。\n如今不是画，真在水村中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和戴帅初陪廉宪副游三天洞韵二首 其一","author":"王圭","text":"胜迹三天洞，清游五字诗。\n悬泉垂马乳，暗谷隐龙池。\n坐久禽声集，吟残树影移。\n贤侯兴不浅，应有后来期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和戴帅初陪廉宪副游三天洞韵二首 其二","author":"王圭","text":"黄叶荒溪满，青莲绀宇开。\n阑干盘石树，方丈出氛埃。\n洞古游人识，岩高倦翼回。\n祇因山下叟，常说绣衣来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴止水总管入燕","author":"王圭","text":"西风万里送长镳，木落天高秋寂寥。\n季子贤名闻上国，望之雅意在中朝。\n燕台此日千金骏，汉署当年七叶貂。\n圣代忧时须共理，一麾江海莫辞遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵云仲诸君见访小酌次韵","author":"王圭","text":"长杨旖旎绿阴晴，小阁芳菲接谢城。\n乐事良辰真具美，酒徒诗伴旧知名。\n春阴忽散林光变，晓露未晞花气清。\n有兴时来共幽赏，暂时风雨莫寒盟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈公辅迁居","author":"王圭","text":"大隐何尝厌市闾，新迁端为好楼居。\n坐来叠嶂云生麓，住近双溪客有鱼。\n二顷可供投辖饮，五车争羡载行书。\n门前怕有西台使，未许兴公赋《遂初》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李廉使之荆南二首 其一","author":"王圭","text":"火落金天爽气浮，澄江练净引仙舟。\n霜威此去清三楚，霖雨行看遍九州。\n银汉星槎当好夜，渚宫烟树正高秋。\n熙朝国任须元老，未许周南此滞留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李廉使之荆南二首 其二","author":"王圭","text":"儒林分席春生座，射圃旋车月满溪。\n暂憩棠阴人爱树，无言李下自成蹊。\n恩光新拜宫壶赐，姓字多因御笔题。\n但得明良千载遇，腐儒何恨老幽栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘有之还京口简梁中砥知宫","author":"王圭","text":"为谢诗家尘外人，别来消息断无闻。\n如何占得三峰住，不寄山中一片云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春草","author":"王圭","text":"和烟和雨碧萋萋，岁岁长亭照客衣。\n春风陌上轮蹄满，莫问王孙归不归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送高罗谷赴德安教","author":"王璋","text":"水驿夜初寒，风帆向德安。\n青枫三楚路，白首一儒官。\n梦泽尊前赋，巫山雨外看。\n未须嫌独冷，兰菊政堪餐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵郭祥卿雪霁见怀","author":"王璋","text":"雪岭留初日，高斋照眼明。\n禽声交晓树，马迹上春城。\n有客怀幽赏，题诗问友生。\n青鞋得来往，更待数朝晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]