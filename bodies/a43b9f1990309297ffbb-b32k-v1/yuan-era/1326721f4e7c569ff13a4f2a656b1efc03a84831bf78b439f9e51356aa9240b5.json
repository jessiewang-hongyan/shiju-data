[{"title":"题怡乐堂为赠善夫良友","author":"高克恭","text":"君家华堂号怡乐，已见檐楹佳致作。\n时张图画玩江山，晴敞窗棂咏风月。\n有书教子知义方，有席延宾酬斝觞。\n天壤不知更何乐，松门醉倚看斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仿老米云山图","author":"高克恭","text":"青山半晴雨，遥现行云底。\n佛髻欲争妍，政恐勤梳洗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松涛轩题画为邓善之","author":"高克恭","text":"春雨欲晴时，山光弄烟翠。\n林间有高人，笑语落天外。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静观阁早兴寄怀善之先生","author":"高克恭","text":"君官近九列，我画将二米。\n不虚五年别，胜进各如此。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过京口","author":"高克恭","text":"北来朋友不如鸿，几个西飞几个东。\n多少登临旧台观，阑干閒在夕阳中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过弋阳","author":"高克恭","text":"雷声驱雨过山西，山腹云根似削齐。\n日暮牧儿归不得，料应白水涨前溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拍洪楼","author":"高克恭","text":"仰有岚光俯有溪，轩窗初不计东西。\n云峰两岫安排定，松竹林林自整齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拍洪楼","author":"高克恭","text":"山腰涧曲绕短垣，百怪老树龙蛇蜿。\n山翁有时抱琴至，雪霁月明开此轩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"满目云山楼","author":"高克恭","text":"溪头白鹭来相安，溪上红桃雨打残。\n满目云山为谁好？\n一川晴色上楼看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"高克恭","text":"古木阴中生白烟，忽从石上见流泉。\n閒随委曲寻源去，直到人家竹坞边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠英上人","author":"高克恭","text":"为爱吟诗懒坐禅，五湖归买钓鱼船。\n他时如觅云踪迹，不是梅边即水边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题道院二首 其一","author":"高克恭","text":"绿阴无际压苍苔，为爱幽深手自栽。\n风月早知烦耳目，不教春笋过墙来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题道院二首 其二","author":"高克恭","text":"草色琅玕逼两楹，早阴才过午阴清。\n斜阳又送西轩影，一就移床待月生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无锡山中留题","author":"高克恭","text":"山深自昔无车马，道在何曾畏虎狼。\n祇恐閒人来看竹，淋漓醉墨污新墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜山图","author":"高克恭","text":"万松岭畔中秋夜，况是楼居最上方。\n一片江山果奇绝，却看明月似寻常。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂为袁清容画春景仿小李","author":"高克恭","text":"春林如染缀溪容，几处幽居倚碧峰。\n不是两翁情话久，白云深杳未能逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋南岳寿宁观碑后","author":"元明善","text":"朱陵灵台天柱巍，太虚空洞绿烟扉。\n上馆赤帝朱鸟飞，祝融宅南参与旗。\n羲娥两曜愁蔽亏，象纬冷逼嗟位迷。\n四观燕吴与秦齐，恒嵩泰华孰崇卑。\n五气顺布百志熙，流祥阜物宣后祇。\n雨风露雷岂其私，惠尔下土尸者谁。\n中有异人餐玉芝，夜眠秋霞昼天倪。\n衣以青云裳白霓，风车八极参两螭。\n七十二峰足幽栖，琳宫贝阙辉陆离。\n潜光炼魄如婴儿，大丹入咽无渴饥。\n谁其思之吴宗师，神变倏忽方张施。\n泠然御风渺何之，太君岁晏嘉予期。\n千秋万岁受鸿釐，星图景运永以丕。\n手持芙蓉朝紫微，旋飙天阖此来归。\n彰灵答贶达尔垂，磨崖镌我《瑶华碑》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题息斋墨竹图","author":"元明善","text":"玄卿口哦子昂诗，手持仲宾墨竹枝。\n此诗此画真两奇，似为玄卿写幽姿。\n日光不下云扃暗，元气歘忽寒人肌。\n枫林青青少陵梦，无乃泽畔逢湘累。\n楚江小月晃初夜，淇园苦雨秋竹迷。\n二妃弹瑟泪如雨，幽壑龙潜春欲飞。\n天路迢遥独后来，黑雨挟风山鬼啼。\n老气盘空根彻泉，地灵上诉玄冥悲。\n摩挲老眼久知画，恍然吾与□物移。\n挥杯三叫我非狂，墨沈翻江江竹辞。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题天冠山","author":"元明善","text":"仙翁昔住天冠山，夜呵鬼神卫炉丹。\n丹成飞去杳不还，药池丹井犹山间。\n翩翩学子鸣佩环，华榱巨丽青云端。\n思玄寻躅果安访，鹤归月落前溪湾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄直夫","author":"元明善","text":"岳云低接使君舟，湘水无波桂树稠。\n井冽自涵千古月，弦清谁写一帘秋。\n青枫路暗空多梦，白雁天遥不见愁。\n闻说匡庐当税驾，策勋殊未到沧洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄翰苑诸公","author":"元明善","text":"苍烟绿树满汀沙，负手行吟日又斜。\n江水有时穷地脉，海云何处是天涯。\n生前几醉尊中酒，梦里曾乘海上槎。\n惆怅怀人重回首，晚风吹尽紫薇花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书湖广省中壁","author":"元明善","text":"鼎湖龙去欲无天，臣抱乌号泪作泉。\n四海重瞻尧日月，万年长履禹山川。\n恩波浩荡沾民物，文运休明属圣贤。\n窃禄四朝无寸补，何堪西掖进经筵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京师送玉虚宗师还山","author":"元明善","text":"句曲山高奠楚氛，神仙初祖大茅君。\n遥天归鹤盘秋月，幽壑潜蛟吟夜云。\n丹鼎神光松桂室，酒壶春色涧溪芹。\n一从待诏西清阁，石发梳香得梦闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送湖南李直夫宪使","author":"元明善","text":"君去湖南我上京，思君欲见又芜城。\n沧波留月能归海，江雁拖云不到衡。\n一代豪华谁远识，百年惊畏护灵名。\n好来不作男儿事，有水可渔山可耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送董慎斋左丞讨贼","author":"元明善","text":"负剑先驱意气閒，也胜局蹐著儒冠。\n古来每说从军乐，此去不辞行路难。\n使节再临民志定，兵锋一举贼心寒。\n书生奋力效驰逐，要写功名久远看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵危虚室过居庸","author":"元明善","text":"一山万里限中原，神凿居庸百二川。\n峰势陡回愁障日，地形高出欲扪天。\n风沙漠漠龙庭远，云物沈沈鸟道穿。\n眼底兴亡谁解写，石琴秋水学冰弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒先主庙二首 其一","author":"元明善","text":"合散扶倾老益坚，荒祠重过为悽然。\n君臣洒落知无恨，庸蜀崎岖亦可怜。\n一县山阳尧故事，三年章武魏长编。\n锦官羽葆今何处？\n半夜楼桑叫杜鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒先主庙二首 其二","author":"元明善","text":"一军南北几扶伤，长坂安行气已王。\n豪杰尽思为汉用，江山初不假吴强。\n两朝元老心虽壮，再世中兴事可常。\n寂寞永安宫畔土，争教安乐似山阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祖孝子求母诗","author":"元明善","text":"冷月酸风夜，长年闻哭声。\n母今犹在隶，儿亦欲无生。\n岐路固多阻，人神孚至情。\n相逢还细认，悲喜此时并。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"介春堂","author":"元明善","text":"真常真人若冰雪，大年夜食清溪月。\n谁知袖里閟初阳，散作玄元春满堂。\n髯龙宵吼石坛秋，老竹风生翻陆江。\n天籁已沈群妙集，隐几嗒然今坐忘。\n云扃不钥瞰虚白，挥谢万象俱行客。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送祥饯梦符行","author":"张伯淳","text":"古交重气谊，不为势位隔。\n会少别离多，志士深所惜。\n骢马东南来，来暮去何亟。\n留连苦无计，杯酒聊永日。\n绝嫌城市喧，一舸访荒寂。\n孤山芳意歇，青子渐堪摘。\n凄凄风雨横，黯黯杨柳碧。\n天公岂有意，助我动秋色。\n重来定何时，慰此长相忆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题董承旨野庄图","author":"张伯淳","text":"古人志道义，但觉利禄轻。\n朝市亦足隐，何必求郊坰。\n论心不论迹，乃称人物评。\n董公廊庙器，一门富簪缨。\n石张汉世冑，崔郭唐家声。\n笔下翻波澜，胸中韬甲兵。\n黄阁政柄举，乌台公道行。\n征谋与治法，和气与威棱。\n随施无不宜，因物以赋形。\n词林日月閒，班高地望清。\n公馀扫俗轨，窗草阶苔青。\n楼台虽无地，诗礼胜金籯。\n田园虽荒薄，松菊还欣荣。\n有诗论国事，胆张目增明。\n使公遁江湖，秉心亦朝廷。\n所志真在隐，非必身归耕。\n野庄视绿野，他年定齐名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题程雪楼黄庭经","author":"张伯淳","text":"雪楼之中有至人，手持一卷《黄庭经》。\n閒居无事心太平，审能行之可长生。\n鼠须吐英玉螭蟠，山阴书仙脱尘凡。\n传之琬琰坚且完，拓以茧素资陈玄。\n白黑粲粲久可观，双瞳炯炯常凝注。\n天君泰定归俗虑，自然神全守深固。\n门中五城十二楼，粉黛当前身之蟊。\n被服《黄庭》急回头，长生之方勿外求。\n古今日月车两轮，昆仑蓬莱无晨昏。\n深藏巾笥培灵根，君能宝之可长生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽杨忠斋","author":"张伯淳","text":"五年新召綍，六馆旧儒冠。\n枌社年来好，棠阴种处难。\n家贫书簏富，居隘酒尊宽。\n郡府多咨问，阎闾遂妥安。\n少游乡誉蔼，老杜士心欢。\n盘屈千军笔，迟回四品官。\n使车将秣马，仙驭已鞭鸾。\n忆昔亲师范，论交在岁寒。\n离群虽苦早，为善每相观。\n顷日留班著，临风欠羽翰。\n嗣音无间断，满纸话辛酸。\n归恨幽明隔，时将简牍看。\n殊方悲宿草，馀庆属庭兰。\n身世谁能驻，声名死不□。\n涉江传楚些，有泪湿毫端。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠彭莱山","author":"张伯淳","text":"总是江南倦客，君平到处生涯。\n老去黄尘没马，襟期付与莺花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病齿二首 其一","author":"张伯淳","text":"萧萧一室老维摩，风日佳时电影过。\n病里不分春早晚，子规啼处夕阳多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病齿二首 其二","author":"张伯淳","text":"宿有愆尤在齿牙，闭门经月卧沈疴。\n杏园旧梦还重醒，无奈红绫饼餤何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居","author":"张伯淳","text":"兀兀山居觉日长，旧时松槚又成行。\n本无世虑何须遣，一缕晴窗柏子香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为范君泽赋梅屋","author":"张伯淳","text":"壑谷周遭万玉妃，当时茅舍映疏篱。\n祇今便作槐堂看，不问南枝与北枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题单吉甫携示江孝乡书卷","author":"张伯淳","text":"单君昔佐吾乡幕，垂去还如到郡初。\n今日都门重晤语，筐中惟贮古人书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萧兰英","author":"张伯淳","text":"翠袅腰肢绛点唇，楚兰买断四时春。\n丁宁莫向游尘老，却顾萧郎是后身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄蔡复斋二首 其一","author":"张伯淳","text":"美人秋水隔丰标，老树阴森锁画桥。\n几度经过须舣棹，不缘茅店酒旗招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄蔡复斋二首 其二","author":"张伯淳","text":"夜雨西窗铦岁寒，云萍自昔聚时难。\n殷勤不在同衾处，长作西窗夜雨看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舞马图","author":"张伯淳","text":"独立天衢骨相奇，缣缃犹记写真时。\n开元天宝今陈迹，舞破中原马不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洗马图","author":"张伯淳","text":"萧萧雾鬣与风騣，扑面征尘一洗空。\n相愿倍增神骏气，恍疑初在渥洼中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳村","author":"张伯淳","text":"千丝万缕拂章台，陌上行人几去来。\n何事结根荒寂处，东风青眼为谁开？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"皇甫松竹梅图","author":"张伯淳","text":"三友亭亭岁晚时，政缘冷澹易相知。\n何须近舍今皇甫，却向图中觅补之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举青骢图","author":"张伯淳","text":"翠鬣朱缨骨相殊，贡来名种出单于。\n唐韩宋李都休论，且看钱家进马图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李公略","author":"张伯淳","text":"风雪满吟鞍，长江望眼宽。\n宦情腾踏易，聚久别离难。\n人去鹤应怨，冬深梅不寒。\n暮云依旧碧，几度倚阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与刘伯宣","author":"张伯淳","text":"屈指六年别，关心万里长。\n重来深愿见，久病欲相忘。\n风物随人老，秋光似旧香。\n公门桃李满，多愧一庄荒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张永锡","author":"张伯淳","text":"台阁文书静，相过眼倍明。\n澹交还有□，远别若为情。\n行色随秋薄，扁舟载月轻。\n书邮如可寄，休付石头城。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赴浙东","author":"张伯淳","text":"涉水是东州，江南记旧游。\n中年偏苦别，薄宦欲何求？\n岸北雪仍在，岭头云未收。\n阴晴元不定，且泛剡溪舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送峄山邓同知","author":"张伯淳","text":"邓君名谱系，邂逅软红间。\n解组邮京阙，题舆向峄山。\n秋清行色好，地僻宦情閒。\n已熟云霄路，何时报政还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵安野内翰梨花","author":"张伯淳","text":"玄景穷阴候，春林早著花。\n素妆临晓镜，红粉涴轻纱。\n胜赏怀京洛，吟情轶永嘉。\n泥中妨载酒，咫尺路头赊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈仲孚赴天台教谕","author":"张伯淳","text":"除书出紫微，百里较增辉。\n又趣横经去，应如衣锦归。\n乡枌迷驿柳，泮藻胜山薇。\n问讯诸亲友，秋高雁字稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠富翠屏","author":"张伯淳","text":"人海偶相逢，凄凉共客中。\n笑谈良不恶，去住若为同。\n春草池塘夜，梨花院落风。\n乡人如问讯，即此是诗筒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽赵太监","author":"张伯淳","text":"贵宦犹韦布，能声在荐绅。\n当时供奉曲，晚岁义熙人。\n白首廛间隐，黄粱梦里身。\n阶庭珠树密，曾不染微尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽张梅轩","author":"张伯淳","text":"每侍吾兄话，乡闾称善人。\n未华班武旧，皂盖姓名新。\n岩壑何曾老，阶庭总是春。\n梅花香韵歇，云黯浙江滨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽鲜于伯机二首 其一","author":"张伯淳","text":"福星推乃祖，济美旧家声。\n浙水分乡社，湖山合墓茔。\n词华推哲匠，幕府负平生。\n犹想池亭上，高谈□座倾。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽鲜于伯机二首 其二","author":"张伯淳","text":"廿载论□稔，閒中屡盍簪。\n北来凝望眼，西□报归音。\n□好空遗墨，人亡不问琴。\n幽明从此隔，庭树看成阴。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王廷用","author":"张伯淳","text":"满城风雨怕催租，赖有诸贤素望孚。\n农色载颁新号令，毗陵犹颂旧规模。\n江山入眼马蹄疾，南北关情雁影孤。\n客里不堪斟别酒，梦随流水到西湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送林德隐","author":"张伯淳","text":"同年君是早归人，多羡乾坤自在身。\n客舍歌残朝雨后，扁舟兴尽雪溪滨。\n渊明入社何妨酒，摩诘怀乡祇为亲。\n若会东州诸故旧，莫将羊酪配羹莼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食","author":"张伯淳","text":"春雨松楸望眼赊，春城杨柳舞腰斜。\n四千里地江南客，五百风光陌上车。\n儿为归迟稀遣信，仆多愠见苦思家。\n公馀少慰凄凉意，蓓蕾一枝红杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪同佥座上次韵","author":"张伯淳","text":"万里同晴八月秋，耆英想像洛中游。\n相逢笔底翻三峡，共诧人间有十洲。\n舞袖卷回云又过，禁钟催散月还留。\n将诗酬酒吾何敢，早已输公第一筹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄柳老","author":"张伯淳","text":"旅食京华两载同，钱唐邂逅苦匆匆。\n曾将漫刺投铃下，又报危樯过浙东。\n天阔云飞俱暮景，雪凝冰冱易春风。\n关情总在阑干曲，明月双溪徙倚中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"共北楼","author":"张伯淳","text":"缥缈楼台十二阑，举头人在凤池班。\n天风不隔寻常眼，辰极长依咫尺天。\n更点分明关政事，规模雄丽厌江山。\n东南民物瞻尧日，乞得馀光万里还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]