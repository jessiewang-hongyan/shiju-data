[{"title":"谨次尊大人领省怀梅溪诗韵","author":"耶律铸","text":"好将元亮林泉兴，澹写王维水墨图。\n心远地偏人不到，闭门读尽五车书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谨次尊大人领省题灵春园诗韵","author":"耶律铸","text":"万壑云烟增壮观，一壶天地入雄歌。\n公侯何物堪人老，自是儿童为揣摩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南行寄呈尊大人领省","author":"耶律铸","text":"一梦黄粱不待炊，若为流泪满征衣。\n目前西塞身南渡，肠断东风心北飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄呈 其一","author":"耶律铸","text":"神咏人歌不忍闻，若为天地净妖氛。\n重封一纸匡时策，哀乞兰台款奏君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄呈 其二","author":"耶律铸","text":"搔首踌蹰泪满衣，东风浑不管相思。\n相思一树梨花发，立到黄昏月上时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"护先妣国夫人丧南行奉别尊大人领省","author":"耶律铸","text":"泪满云笺未怆神，高楼望不见飞尘。\n重重门户无人到，深锁桃花一院春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕城之北垂三十里有瓮山原先妣国夫人坟室在焉予过之哀感不已而贮之诗仍寄呈尊夫大领省以慰其感云 其一","author":"耶律铸","text":"仙佩飘飘驾彩鸾，白云深锁瓮山寒。\n自从好梦风吹断，谁念孤儿泪不乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕城之北垂三十里有瓮山原先妣国夫人坟室在焉予过之哀感不已而贮之诗仍寄呈尊夫大领省以慰其感云 其二","author":"耶律铸","text":"彩鸾飞去几时回，望断青天望不来。\n二十二年恩与爱，若为心地不成灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕城之北垂三十里有瓮山原先妣国夫人坟室在焉予过之哀感不已而贮之诗仍寄呈尊夫大领省以慰其感云 其三","author":"耶律铸","text":"醮台霜冷纸钱灰，醮罢秋风独自回。\n满面尘埃人不识，缓驱灰马入城来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆尊大人领省二首 其一","author":"耶律铸","text":"一上居庸万里心，居庸关上望和林。\n和林城远望不见，日落云明山水深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆尊大人领省二首 其二","author":"耶律铸","text":"欲回兰棹更夷犹，事出沈思得自求。\n霜雁不来书断绝，水寒烟淡倚高楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆尊大人领省二首 其一","author":"耶律铸","text":"一声长笛野云秋，思上高台最上头。\n红叶暮烟人北望，青山落日水东流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆尊大人领省二首 其二","author":"耶律铸","text":"一度思量一度秋，一回伤极一低头。\n踌蹰搔首无人会，待下楼来却上楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拜书尊大人领省瓮山原茔域寝园之壁","author":"耶律铸","text":"太平与乱俱无象，先觉分明尽有閒。\n閒气欲常游帝所，旱霖终不沃人寰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓闻行宫迁居","author":"耶律铸","text":"曙色将分梦欲残，一天星斗冷阑干。\n揽衣推枕出门去，扬子江豪怒晓寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惜别","author":"耶律铸","text":"忆昔相逢各少年，几临风月醉华筵。\n悠悠别后空回首，风起杨花雪满天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴","author":"耶律铸","text":"谁曾煎得胶黏日，谁解拽将绳系风。\n岂道花枝与人面，大都都得几时红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信笔","author":"耶律铸","text":"自从得践老成域，曾不更登年少场。\n空赋乌栖夜啼曲，可怜谁是贺知章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感怀","author":"耶律铸","text":"屈尽人閒薄宦情，千钟从此一毫轻。\n人心直要平如水，水面风来更不平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"所思","author":"耶律铸","text":"望外青山断复连，望中明月缺还圆。\n碧云暮合横长笛，目送归鸿不尽天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述所思","author":"耶律铸","text":"忍竭声华足笑林，也须当问若为心。\n可怜一自施行马，更说重门似海深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自笑","author":"耶律铸","text":"独醉仙居独醉亭，只缘耽味洗心经。\n可能却使谈天口，唯诵金人背上铭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青山","author":"耶律铸","text":"青山不伴青春老，万古千秋色自新。\n休去西园桃李醉，晚来风起易愁人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无何醉隐","author":"耶律铸","text":"白石先生何日老，青莲居士几时醒。\n若须要得留灵景，索与除忧旧福庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对酒吟","author":"耶律铸","text":"莫劳邹律唤春回，雪尽北山空自来。\n还笑独醒成底事，壮怀须对酒杯开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独自来","author":"耶律铸","text":"日日楼头独自来，别离情事若为裁。\n东风倚遍栏干曲，人在天涯回未回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春词二首 其一","author":"耶律铸","text":"晚兰香露泣愁红，睡起沈吟绕露丛。\n荡子不来花落去，教人怎不怨东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春词二首 其二","author":"耶律铸","text":"空恨勒花春事晚，及开零落却生嫌。\n春风若不曾相识，何事频来揭画帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初阅仙音乐","author":"耶律铸","text":"催花白雨衒芳春，香湿霓裳入梦云。\n曾是长安年少客，天津桥上月中闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因阅乐戏赠友人","author":"耶律铸","text":"蔷薇露渍霓裳润，桂子风飘月殿香。\n犹是蛙鸣耸醉梦，欲教人说是归昌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金乐歌","author":"耶律铸","text":"百花气色虽千变，万劫光阴只一般。\n金乐既和行乐在，我将天地结心欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明妃二首 其一","author":"耶律铸","text":"汉使却回凭寄语，汉家三十六将军。\n劝君莫话封侯事，触拨伤心不愿闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明妃二首 其二","author":"耶律铸","text":"散花天上散花人，谁说香名更未闻。\n薄命换移仙寿在，不须青冢有愁云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"征妇怨","author":"耶律铸","text":"锦织回文织过秋，千丝万缕织成愁。\n停梭心口私相问，谁在淩烟阁上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新溪书堂诗","author":"胡炳文","text":"宇胡曰宙，古往来今。\n往者不滞，来者方新。\n阳升於旦，帝出乎春。\n日日岁岁，新新相因。\n兹水有溪，胡以是名。\n蒙泉不竭，坎流不盈。\n前一汲过，后一汲生。\n生生相易，新新不停。\n戴氏池塘，居溪之际。\n观水有术，於道有契。\n旧学未忘，新功相继。\n能濯旧见，以来新意。\n有子有孙，以书以诗。\n如溪之新，朝斯夕斯。\n自彊不息，慎独母欺。\n新而又新，请视兹溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠鹤庵相士四言","author":"胡炳文","text":"我相尔鹤，风骨卓荦。\n九皋幽漠，九霄寥廓。\n尔性孤洁，尔音清彻。\n夜月梅花，松梢晓雪。\n鹤亦相予，谓予心古。\n寿当九十，伏生卫武。\n我闻而笑，鹤起而舞。\n须臾飞去，莫知尔所。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李生诗","author":"胡炳文","text":"行行能远来，匆匆辄辞去。\n谓有新知乐，乃成离别苦。\n青春固所欣，子当怀深惧。\n菲菲弄芳妍，匆匆伤迟暮。\n人子三加冠，责以为人父。\n收心戒外驰，回光宜内顾。\n有屈乃有伸，何思复何虑。\n志帅能自持，气卒敢轻骛。\n畜极亨天衢，动初辟乾户。\n青云第一程，出门慎勿误。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其一 锦屏春色","author":"胡炳文","text":"方山峨峨万山丛，红红紫紫开东风。\n谁遣罘罳倚半空，为嫌下界尘埃濛。\n提起韶华千万叠，移来蜀城炫奇绝。\n千工百巧花自如，万古一机天不裂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其二 绣水秋波","author":"胡炳文","text":"星源沄沄从东来，逶逦弯北势欲回。\n水上无风自成谷，星溪此观何奇哉。\n化工妙手元不露，刺破练溪能几步。\n世间儿女巧己多，楼头针线月中度。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其三 龙井晓云","author":"胡炳文","text":"华光殿东泉有灵，下穴空洞神功冥。\n当时忽见苍虬精，年年箫鼓来相迎。\n五风十雨今年好，灵物不要人祈祷。\n非烟非雾腾清晨，五色祥光焕晴昊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其四 仙岩夜月","author":"胡炳文","text":"谁凿太阴开四洞，蟾光照破人间梦。\n灵源千层石髓香，金鸡一唱岩花动。\n白玉柱边眠苍虬，绛花桥下行青牛。\n我来绝爱读书堂，石圆水冷天风秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其五 北寺昏钟","author":"胡炳文","text":"日斜一路红阑干，日落四山苍翠寒。\n云深不见招提处，一声两声起林端。\n遥度前溪声欲绝，溪上渔舟撑未歇。\n众鸟栖定树头云，一僧归踏松间月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其六 西湖水榭","author":"胡炳文","text":"蚺城谁筑溪之涯，层楼簇簇排人家。\n两岸春风好杨柳，一池霁月芙蓉花。\n香与清风远方觉，污泥不染尘不著。\n小亭红瞰碧波心，着我中间看飞跃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其七 廖坞鹤烟","author":"胡炳文","text":"一泓香泉流不涸，一洞幽花自开落。\n夜半月明松上声，知公乘云下寥廓。\n公去不知几何年，公归犹认丹炉烟。\n炉烟已冷春风暄，花流洞口泉涓涓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"星源八景 其八 朱塘鸥雨","author":"胡炳文","text":"鸣凤不肯鸣晚周，鸥鸟相随九曲幽。\n星源是公鲁洙泗，东池历历梦中游。\n一夜水痕高几许，鸟也忘机淡无语。\n朝来晴碧更好看，天光云影源头水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吴桂芳所藏张即之墨迹","author":"胡炳文","text":"张公笔法工奇诡，盈丈大书神愈伟。\n飞来峰头海日红，□虎岩边龙象舞。\n巨灵血掌擘太岳，雷椎迸火挥电雹。\n今见小字又不然，层霄闲云淡无脚。\n桃花春水满唾壶，家园新笋丰雪瘦。\n故人此饷自不恶，况有一斛明月珠。\n吴君好奇入骨髓，我学不成空浪许。\n好待滕光酌酒来，元气淋漓题辞语。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拜岳鄂王墓","author":"胡炳文","text":"有公无此日，再拜泪交颐。\n大义君臣重，孤忠天地知。\n鸩毛何太毒，龙渡只如斯。\n坟畔休留桧，行人欲斧之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张秋辉","author":"胡炳文","text":"造化妙璇玑，谁能测奥微。\n万星皆夜现，孤月最秋辉。\n子术如今少，吾年且古稀。\n相期犹未艾，白发在渔机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"严先生祠次胡敬存韵","author":"胡炳文","text":"鸿飞冥冥不可弋，当时肯入搜罗中。\n暂往自为故人屈，竟归不与馀子同。\n眇视富贵意谁识，大关名教功奚穷。\n近来士气颇卑懦，舣舟祠下歌清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题富山汪王庙","author":"胡炳文","text":"虬髯人出鹿归唐，多少英雄失故乡。\n昔日六州曾捲土，此邦千载尚尊王。\n高陵夜雨鸣弓剑，原庙春风洁豆觞。\n灯火万家元夕夜，谁悲狐兔满连昌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题治平寺","author":"胡炳文","text":"二十年前到治平，青山历历记吾曾。\n花因百五有孤注，寺过十三无一僧。\n云影长昏天外日，榆烟谁换佛前灯。\n新安山水依然在，不为空门管废兴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送汪又善之宗文山长","author":"胡炳文","text":"源流活水看鹅湖，诸老曾谈太极图。\n吃紧辨时非好辨，开端无字岂虚无。\n绝弦琴尚遗音响，跃冶金须正范模。\n学计区区无足问，斯文一脉要人扶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自强斋诗","author":"胡炳文","text":"励志先须异众儿，观乾之象大哉词。\n莫轻操几从师乐，正是加餐努力时。\n黄卷圣贤宜静对，青衿城阙戒荒嬉。\n昼为夜息何曾息，邻屋鸡鸣正仰思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题叶氏烈女卷","author":"胡炳文","text":"烈女夫天不载移，诰花犹忆被恩时。\n未同冀缺如宾敬，夐出共姜守义诗。\n一水星沉秋月皎，半岩松老晚风悲。\n朅来行实俱名笔，应为流芳勒墓碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题扬州琼花","author":"胡炳文","text":"扬州观里琼花树，何代人间得此栽。\n素质偏宜琳馆护，灵根端自玉京来。\n九天甘露曾亲浥，三月群芳敢并开。\n折得一枝春正好，纶巾斜插下瑶台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽休宁黄秋江先生母","author":"胡炳文","text":"五十馀年鸾影孤，今时谁谓柏舟无。\n平生辛苦训诸子，百计甘鲜餋老姑。\n名彻紫霄门外表，德书彤管阃中模。\n哀荣千古无穷事，增美江山十景图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽句容北村先生","author":"胡炳文","text":"孝是人生百行源，先生於此道弥敦。\n白头犹作婴儿慕，青佩咸知师表尊。\n几十百年绍书种，一方寸地植仁根。\n霜馀硕果今凋谢，重为斯文忆北村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽黄陂主簿秋圃赵公","author":"胡炳文","text":"故家人物说新塘，文学能传百世芳。\n圃有寒香存老菊，邑留遗爱美甘棠。\n青灯夜雨藏书阁，绿酒春风戏綵堂。\n明日金溪源上路，千人会葬泪如滂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题休宁夏氏双应堂","author":"胡炳文","text":"几尺坟高手自培，终天无复餋南陔。\n松楸在望长兴叹，草木无情亦见哀。\n哭裂碧筠双干起，泪含红药并头开。\n诗人秪是誇祥瑞，孝感那知心上来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽毕梧山","author":"胡炳文","text":"族望云仍姓此村，公由科第大其门。\n蚤年璧水驰英誉，方寸春风拥善根。\n身后籯金书有种，堂中刻木母如存。\n谁将幽德铭千古，老笔当今有达尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"查氏山居五咏 其一 孝善桥","author":"胡炳文","text":"有孝乃有德，多善必多祥。\n水面看虹影，俯仰相与长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"查氏山居五咏 其二 濠观亭","author":"胡炳文","text":"鱼不知子乐，何必濠上观。\n子乐子自知，月白秋江寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"查氏山居五咏 其三 霜杰所","author":"胡炳文","text":"严霜不可欺，凄风不能折。\n隐逸传中人，往往皆豪杰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"查氏山居五咏 其四 深净轩","author":"胡炳文","text":"净不污泥染，清无片尘侵。\n外直丈夫节，中虚君子心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"查氏山居五咏 其五 内乐室","author":"胡炳文","text":"我有安乐窝，春风方寸地。\n收拾早归来，此中有深味。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送董深山 其一","author":"胡炳文","text":"远林无限春意，幽谷自涵太空。\n行到水源穷处，犹闻鸡犬云中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送董深山 其二","author":"胡炳文","text":"洞口桃花易见，源头活水难寻。\n欲知云尽不尽，须到山深更深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠命卜法术周生","author":"胡炳文","text":"非相自无□□，凭君自相心塘。\n心事源头活水，相如云影天光。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山头二齐生以乃祖之命来请予许之二生先往赋六言","author":"胡炳文","text":"二生芒鞋去去，老子风袂悠悠。\n有约相随花外，定须同到山头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠图书胡松友","author":"胡炳文","text":"我有餋生四印，从渠□□双传。\n推出一窗明月，梅花枝上先天。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]