[{"title":"李遵道新竹","author":"郑元祐","text":"逗土细行鞭，苔茵暖透穿。\n生生无限意，都属蓟丘仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈抟像","author":"郑元祐","text":"十年营一睡，醒起欲安民。\n忽睹金乌彩，还山遂老臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云林小景","author":"郑元祐","text":"云起野桥西，层峰翠隔溪。\n欲寻清閟阁，古木压檐低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王元章梅","author":"郑元祐","text":"明月西湖上，清光儗旧时。\n东风露消息，香雪满南枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂兰","author":"郑元祐","text":"孤臣万古愁，湘渚水东流。\n江芷汀蓠满，空令泣楚囚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子固水仙","author":"郑元祐","text":"仙姿艳玉肌，轻拂五铢衣。\n罗袜凌波去，香尘蹙步飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柯敬仲竹","author":"郑元祐","text":"羁栖江梅姿，飞墨鬓如丝。\n天远鸾留影，筼筜雨后枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子庭古木","author":"郑元祐","text":"巨材千稔资，特立僵挺挺。\n东风吹不回，雪崖冰壑冷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明雪窗兰","author":"郑元祐","text":"结跏向双峨，濡毫成九畹。\n袭佩芳馨多，怀人江浦远。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆杭","author":"郑元祐","text":"湖山今古妍丽，寝园此际荒凉。\n春晚花开花落，故交谁在谁亡？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渊明像","author":"郑元祐","text":"弃官亟返柴桑，家资日付壶觞。\n莫道先生长醉，义熙年号不忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画二首 其一","author":"郑元祐","text":"六椽僦居避世，一瓢澹饮怡情。\n短褐少陵已往，小冠子夏复生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画二首 其二","author":"郑元祐","text":"雪喷满溪泉溜，云屯匝地松阴。\n隔岸芙蓉千叠，助我吟诗抚琴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀徐士弘","author":"郑元祐","text":"钱唐湖上筱骖游，一榻长为孺子留。\n头白无成两漂泊，输君天地一沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀张天民","author":"郑元祐","text":"金坛郭里扫尘斋，移向宜兴傍古槐。\n孙子读书儿致养，更无尘杂到苔阶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张贞居神光楼看雨三首 其一","author":"郑元祐","text":"东风吹雨弄新晴，仙子楼居吹玉笙。\n不是春阴在帘幕，已应颠倒落红英。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张贞居神光楼看雨三首 其二","author":"郑元祐","text":"濛濛灵雨向东来，曙色轩窗面面开。\n为爱条风吹润绿，莫教人迹印苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张贞居神光楼看雨三首 其三","author":"郑元祐","text":"碧云千仞紫阳山，都在东风化雨间。\n细与阳春同霢霂，岸花汀柳亦斑斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠制笔温生二首，并引 其一","author":"郑元祐","text":"神光楼上春联句，醉里纵横笔屡挥。\n归到吴中见蒙子，斯文徵艺有神机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠制笔温生二首，并引 其二","author":"郑元祐","text":"温生有子能传业，郑老无书可寄君。\n他日制成壸领记，尚凭毛颖话慇勤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中寄王叔明","author":"郑元祐","text":"跌宕王郎天马驹，胸蟠百箧外家书。\n雨窗卧病三十日，裹饭何曾见子舆？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陶靖节像","author":"郑元祐","text":"袖里惭无博浪槌，酒醒空赋稚桑诗。\n悲凉一曲山阳笛，满眼山河是义熙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢太傅像","author":"郑元祐","text":"秦兵百万压东南，宗社安危已独担。\n却置捷书棋局底，诸君犹认罪清谭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中寄光孝禅翁","author":"郑元祐","text":"我病在床身欲飞，棋锋何日赌神机？\n想应近日翻经后，只有青山到竹扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其一","author":"郑元祐","text":"舒啸风林云满溪，白驹空谷草萋萋。\n相逢不作苏门听，应有长松鹤未栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其二","author":"郑元祐","text":"濯足清溪水已寒，青山犹有此衣冠。\n黄尘三尺乌靴底，谁与归来把钓竿？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其三","author":"郑元祐","text":"水缭山回深复深，白云茅屋住溪阴。\n溪南十亩堪耕种，何必囊中季子金？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其四","author":"郑元祐","text":"桂树连蜷山石幽，萧然冠屦白云秋。\n只愁畏垒无尸祝，不愧长年为尔留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其五","author":"郑元祐","text":"桃花源上蝶飞飞，误却渔郎苦欲归。\n云白山青一回首，落红如雨点春衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画六首 其六","author":"郑元祐","text":"仙人楼观隔层霞，隐者烟萝便作家。\n万壑千岩何处是？\n停桡试问碧桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"肥、瘦二马 其一","author":"郑元祐","text":"狮子花骄蹴暖风，满臕如瓠气如虹。\n年来恣饱天闲粟，朔漠当收血战功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"肥、瘦二马 其二","author":"郑元祐","text":"百战才馀骨与毛，枯株倚着费抓搔。\n何人终惠还刍秣？\n拂拭风鬉气尚豪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丛竹图","author":"郑元祐","text":"赋诗何处极幽探，多在青山海岳庵。\n一片绿云尘迹断，万竿烟雨大江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游鱼图","author":"郑元祐","text":"泼剌春波藻荇深，方池容得五湖心。\n砚坳更有神龙在，难邈商岩旱岁霖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题文山佩刀帖","author":"郑元祐","text":"径露刀金柄属谁，空闻断指血淋漓。\n杜鹃啼暗江南月，臣甫年年泪雨垂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂临东坡竹","author":"郑元祐","text":"戏墨王孙似子瞻，鸡栖石上着毵毵。\n汴京回首西风急，流落江南共海南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东坡笠屐图","author":"郑元祐","text":"得嗔如屋谤如山，且看蛮烟瘴雨间。\n白月遭蟆蚀不尽，清光依旧满人寰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伏生授经图","author":"郑元祐","text":"老无牙齿语音讹，断简残编缺字多。\n不赖闺中贤弱息，帝王典则竟消磨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏武牧羊图","author":"郑元祐","text":"飞鸿历历度天山，何处孤云是汉关？\n不滴望思台下血，君王犹及见生还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岳王庙","author":"郑元祐","text":"复得中原后杀身，将军未必恨奸秦。\n甘将三百年宗社，君相偷安葬塞尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武侯像","author":"郑元祐","text":"鱼水君臣百世师，风云鱼鸟识旌旗。\n三分天下何经意？\n恨未中原复本支。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读碑图","author":"郑元祐","text":"摩挲汉鼎朵馋颐，臣道为忠孝可移。\n枉使南来五千里，越江漫读孝娥碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其一 赵宛丘","author":"郑元祐","text":"剡剡台躔映五云，通明殿上玉宸君。\n今宵赏月延秋桂，满袖天香不见分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19216,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其二 张贞居","author":"郑元祐","text":"月华浮海绿烟收，曾照神光湖上楼。\n惆怅尘生白玉麈，诗盟从此负闲鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19217,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其三 李云中","author":"郑元祐","text":"屋角冰盘拥烂银，清光千里不疏亲。\n弃官归去轻如叶，应念沧江有钓纶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19218,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其四 倪云林","author":"郑元祐","text":"览古楼高桂影寒，飞觞不厌接清欢。\n天香落尽黄金粟，软语何由接夜阑？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19219,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其五 张文德","author":"郑元祐","text":"每念道人张一无，京尘填眼髑髅枯。\n师资贼害无人理，负子清光白玉壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19220,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其六 刘张掖","author":"郑元祐","text":"汳水秋风吹雁声，一时分省有更生。\n登高吊古中秋近，盖有危言答圣明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19221,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其七 泰白野","author":"郑元祐","text":"天章阁下月孤明，仍是中秋此夜情。\n便到蓬莱宫里住，谢安元自念苍生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19222,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其八 草堂、宾主","author":"郑元祐","text":"芝云如盖拥冰盘，携得王珣午夜看。\n山色湖光秋十里，诗成应更刻琅玕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19223,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其九 陈敬初兄弟","author":"郑元祐","text":"阖闾城里寄闲身，四壁秋蛩语近人。\n何异京华旧时月？\n清光且照白头亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19224,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其十 黄金华","author":"郑元祐","text":"月上溪头树影长，婆娑老子据胡床。\n九天风露归来后，桑落园林酒正香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19225,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其十一 王季野、钱伯行","author":"郑元祐","text":"飞云楼上月华明，几度中秋在帝京？\n却有钱郎挥翰手，倚阑横笛最含情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19226,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜怀十五友，并引 其十二 张京兆","author":"郑元祐","text":"南来看月异常年，身在仙岩溪水边。\n名简帝心归想近，清歌莫惜杖头钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19227,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张贡士","author":"郑元祐","text":"睢阳世绪邈如云，君独胸蟠锦绣文。\n莫为书裙散香墨，好摅三策表奇勋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19228,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送处州杜同知三首 其一","author":"郑元祐","text":"见说吾家光禄坟，长松万个入青云。\n子孙为庶杭头住，应立车尘候使君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19229,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送处州杜同知三首 其二","author":"郑元祐","text":"含辉天上少微星，曾照苍苍古括城。\n山水高深民俗险，不忘辛苦事岩耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19230,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送处州杜同知三首 其三","author":"郑元祐","text":"谁如别驾杜侯贤，纯吏心肠铁石坚。\n山坂高低时雨足，郡斋篝火看畬田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19231,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠丽水治农少府二首 其一","author":"郑元祐","text":"一寸山坳一寸田，高低岩溜接山泉。\n论升起税斤称谷，此是山城大有年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19232,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠丽水治农少府二首 其二","author":"郑元祐","text":"牛羊日夕下山时，出穴耽耽虎正饥。\n不是仁侯护羸畜，麒麟折角獍枭肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19233,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄颜元卿院判二首 其一","author":"郑元祐","text":"户外梅花落峭寒，窗前银烛剪更阑。\n贾生只为忧明主，华发萧萧镜里看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19234,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄颜元卿院判二首 其二","author":"郑元祐","text":"年华汨汨可相饶，鱼跃春冰逆上潮。\n畎亩怀君不忘处，汲生难远武皇朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19235,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄王可矩宗伯二首 其一","author":"郑元祐","text":"江上羊裘把钓翁，一竿烟雨致时雍。\n客星祠下山千尺，不在云台彩画中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄王可矩宗伯二首 其二","author":"郑元祐","text":"昔年簪笔上瀛洲，万里青云映黑头。\n相业要知霜后柏，烝徒有楫济川舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄沈存斋","author":"郑元祐","text":"终惠长歌瘦马行，杜陵头白泪纵横。\n风云满地无春草，顷刻难忘向主鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄倪云林","author":"郑元祐","text":"经锄斋外月娟娟，尝照梅花纸帐眠。\n回首三年几圆缺？\n尘埃堆垛白云篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘功父汉川亭","author":"郑元祐","text":"玉峰深隐汉川君，安稳书巢卧白云。\n天禄校书儿辈在，青山留为客书裙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞学士小像，为其侄孙堪题二首 其一","author":"郑元祐","text":"光岳英灵盖世雄，九天象纬贯心胸。\n六经文字关时运，韩柳孙丁又及公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞学士小像，为其侄孙堪题二首 其二","author":"郑元祐","text":"紫芝眉宇凤麟姿，自是文章百世师。\n何必凌烟画冠剑？\n云仍翼翼奉烝祠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭天锡云山","author":"郑元祐","text":"飞墨来从海岳庵，春风吹雨满江南。\n青山肯被云遮尽，时耸尖奇一两簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"朱泽民山水","author":"郑元祐","text":"楼观参差山涧坳，渔舟远啸出林梢。\n白云度尽千峰碧，鬻石幽人始定交。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次泰监司提兵东广，留别吴中诸友韵二首 其一","author":"郑元祐","text":"万里南征瘴岭过，夜闻何处竹枝歌？\n貂蝉原自兜鍪出，盍斩鲸鲵靖海波？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次泰监司提兵东广，留别吴中诸友韵二首 其二","author":"郑元祐","text":"白发萧萧尚草元，故人江海慰衰年。\n功成伫俟归来日，只在城南尺五天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄宇文国相","author":"郑元祐","text":"精思亭上李文饶，且袖经纶镇海潮。\n相业从容龙尾道，唐家复数中兴朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄贡泰甫授经二首 其一","author":"郑元祐","text":"姑苏台下雨声寒，舍馆青灯语夜闲。\n父子日为师友处，遗经不厌静中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄贡泰甫授经二首 其二","author":"郑元祐","text":"风风雨雨百花洲，何日春晴一醉游？\n满日青山吟藉草，鸱夷未许独扁舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈玄礼之杭二首 其一","author":"郑元祐","text":"钱唐湖上雁声秋，凉入明公紫绮裘。\n庾信清贫何逊老，登临难写古人愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈玄礼之杭二首 其二","author":"郑元祐","text":"青山绕郭候潮过，今古兴怀意绪多。\n到夜令人尚无寐，弯弯月子竹枝歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送何举人北上二首 其一","author":"郑元祐","text":"练川文学旧从游，户屦儒生学最优。\n北上神京当六月，凉风桂子已含秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]