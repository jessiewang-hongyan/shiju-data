[{"title":"摘红英 春雨惜花","author":"张翥","text":"莺声寂。\n鸠声急。\n柳烟一片梨云湿。\n惊人困。\n教人恨。\n待到平明，海棠应尽。\n青无力。\n红无迹。\n残香剩粉那禁得。\n天难准。\n晴难稳。\n晚风又起，倚阑争忍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蝶恋花 柳絮","author":"张翥","text":"陌上垂杨吹絮罢。\n愁杀行人，又是春归也。\n点点飞来和泪洒。\n多情解逐章台马。\n瘦尽柔丝无一把。\n细叶青颦，闲却当时画。\n惆怅此情何处写。\n黄昏淡月疏帘下。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"踏莎行","author":"张翥","text":"雨涧天寒，孤山雪后。\n美人空谷谁为友。\n香林有路玉烟深，瀛洲无梦朝云瘦。\n照影冰壶，含情翠袖。\n写生合在徐黄手。\n仙家花月镇长春，与君岁晚同三寿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"踏莎行 江上送客","author":"张翥","text":"芳草平沙，斜阳远树。\n无情桃叶江头渡。\n醉来扶上木兰舟，将愁不去将人去。\n薄劣东风，夭邪落絮。\n明朝重觅吹笙路。\n碧云红雨小楼空，春光已到销魂处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天","author":"张翥","text":"乍学琵琶已断肠。\n锦绦银甲玉悬珰。\n春风琼树声逾稳，秋水芙蓉字亦香。\n微敛笑，浅句妆。\n何须重觅杜韦娘。\n休教月底清歌去，怕趁行云上凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天","author":"张翥","text":"一曲吴歌酒半酣。\n声声字字是江南。\n书凭仙苑青鸾递，花助妆楼粉蝶衔。\n飞燕瘦，宝儿憨。\n已妍还慧更岩岩。\n无因剪得湘江水，与蘸春云作舞衫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天 为朱氏小妓绣莲赋三首","author":"张翥","text":"半臂京绡稳称身。\n玉为颜面水为神。\n一痕头导分云绾，两点眉山入翠颦。\n丹杏小，碧桃新。\n雏莺恰啭上林春。\n平生惯是听歌耳，除却莲儿只一人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天 赠泉南琵琶妓","author":"张翥","text":"玉手琵琶半醉中。\n从容慢拈复轻拢。\n青衫司马情偏感，翠袖红莲艺更工。\n花淡泞，月朦朦，归来无语立东风。\n汗巾红渍槟榔液，错认窗前唾绣绒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"露华 玉簪","author":"张翥","text":"瀛洲种玉。\n总付与花神，月底深斸。\n琢就瑶笄，光映鬓云斜矗。\n几度借取搔头，别试汉宫妆束。\n风露冷，幽香半襟，淡伫阑曲。\n亭亭雪艳愁独。\n爱粉沁冰筒，须拈金粟。\n石上那回磨断，争忍轻触。\n一自楚客归来，珠履旧游谁续。\n秋梦起，残妆半簪坠绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"踏莎行","author":"张□","text":"檐宿吴云，风经楚袂。\n门深不似春宵闭。\n碧疏吹溜湿灯花，客卿无梦寻珂里。\n剪韭吟边，听潮浪里。\n江悬漏杳归心碎。\n相思鸠外绿蓑寒，一帘蕉响秋如水。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐","author":"李仁山","text":"瑶英轻洒。\n姑射飘仙驾。\n巧夺孤山能变化。\n夭娇飞来白下。\n绝怜玉骨清姿。\n不随红紫芳时。\n要识天然标格，竹篱茅舍横枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 和元遗山","author":"李天翼","text":"南去北来人自老，落花飞絮悠悠。\n思君一度一登楼。\n无穷烟水里，何处认并州。\n忽见姓名双泪落，新诗聊浣离愁。\n若为重醉绣江秋。\n芙蓉明月下，来往一扁舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"人月圆 马嵬效吴彦高","author":"李齐贤","text":"五云绣岭明珠殿，飞燕倚新妆。\n小颦中有，渔阳胡马，惊破霓裳。\n海棠正好，东风无赖，狼藉春光。\n明眸皓齿，如今何在，空断人肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大江东去 过华阴","author":"李齐贤","text":"三峰奇绝，尽披露、一掬天悭风物。\n闻说翰林曾过此，长啸苍松翠壁。\n八表游神，三杯通道，驴背须如雪。\n尘埃俗眼，岂知天上人杰。\n犹想居士胸中，倚天千丈气，星虹闲发。\n缥缈仙踪何处问，箭筈天光明灭。\n安得联翩，云裾霞佩，共散麒麟发。\n花间玉井，一樽轰醉秋月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引 暮行","author":"李齐贤","text":"栖鸦去尽远山青。\n看暝色、入林坰。\n灯火小于萤。\n人不见、苔扉半扃。\n照鞍凉月，满衣白露，系马睡寒厅。\n今夜候明星。\n又何处、长亭短亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 书李将军家壁","author":"李齐贤","text":"将军真好士，识半面、足吾生。\n况西自岷峨，北来燕赵，并辔论情。\n相牵挽，归故里，有门前稚子候渊明。\n对酒欢酣四坐，挑灯话到三更。\n高歌伐木鸟嘤嘤。\n怀抱向君倾。\n任客路光阴，欲停归骑，更尽飞觥。\n人间世逢与别，似浮云聚散月亏盈。\n但使金躯健在，白头会得寻盟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 长安怀古","author":"李齐贤","text":"骚人多感慨，况故国、遇秋风。\n望千里金城，一区天府，气势清雄。\n繁华事，无处问，但山川景物古今同。\n鹤去苍云太白，雁嘶红树新丰。\n夕阳西下水流东。\n兴废梦魂中。\n笑弱吐强吞，纵成横破，鸟没长空。\n争如似犀首饮，向蜗牛角上任穷通。\n看取麟台图画，□余马鬣蒿蓬。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水调歌头 过大散关","author":"李齐贤","text":"行尽碧溪曲，渐到乱山中。\n山中白日无色，虎啸谷生风。\n万仞崩崖叠嶂，千岁枯藤怪树，岚翠自蒙蒙。\n我马汗如雨，修径转层空。\n登绝顶，览元化，意难穷。\n群峰半落天外，灭没度秋鸿。\n男子平生大志，造物当年真巧，相对孰为雄。\n老去卧丘壑，说此诧儿童。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水调歌头 望华山","author":"李齐贤","text":"天地赋奇特，千古壮西州。\n三峰屹起相对，长剑凛清秋。\n铁锁高垂翠壁，玉井冷涵银汉，知在五云头。\n造物可无物，掌迹宛然留。\n记重瞳，崇祀秩，答神休。\n真诚若契真境，青鸟引丹楼。\n我欲乘风归去，只恐烟霞深处，幽绝使人愁。\n一啸蹇驴背，潘阆亦风流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉漏迟 蜀中中秋值雨","author":"李齐贤","text":"一年唯一日。\n游人共惜，今宵明月。\n露洗霜磨，无限金波洋溢。\n幸有瑶琴玉笛，更是处、江楼清绝。\n邀俊逸。\n登临一醉，将酬佳节。\n岂料数阵顽云，忽掩却天涯，广寒宫阙。\n失意初筵，唯听秋虫呜咽。\n莫恨姮娥薄相，且吸尽、杯中之物。\n圆又缺。\n空使早生华发。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城子 七夕冒雨到九店","author":"李齐贤","text":"银河秋畔鹊桥仙。\n每年年。\n好因缘。\n倦客胡为，此日却离筵。\n千里故乡今更远，肠正断，眼空穿。\n夜寒茅店不成眠。\n一灯前。\n雨声边。\n寄语天孙，新巧欲谁传。\n懒拙只宜闲处着，寻旧路，卧林泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 北山烟雨","author":"李齐贤","text":"万壑烟光动，千林雨气通。\n五冠西畔九龙东。\n水墨古屏风。\n岩树浓凝翠，溪花乱泛红。\n断虹残照有无中。\n一鸟没长空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 山市晴岚","author":"李齐贤","text":"远岫螺千点，长溪玉一围。\n日高山店未开扉。\n岚翠落残霏。\n隐隐楼台远，蒙蒙草树微。\n市桥曾记买鱼归。\n一望却疑非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 山市晴岚","author":"李齐贤","text":"海气蒸秋热，山容媚晓晴。\n森森万树立无声。\n空翠袭人清。\n镜里双蛾敛，机中匹练横。\n隔溪何处鹧鸪鸣。\n云日翳还明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 长湍石壁","author":"李齐贤","text":"插水云根耸，横空黛壁开。\n鱼龙吹浪转隅隈。\n百里绿徘徊。\n日浸玻璃色，花分锦绣堆。\n画船载酒管弦催。\n一日绕千回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 长湍石壁","author":"李齐贤","text":"瘦骨千年立，苍根百里盘。\n横张侧展绿波间。\n一带玉孱颜。\n猎骑何曾顾，渔郎只漫看。\n诗人强欲状天悭。\n赢得鬓毛斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 北山烟雨","author":"李齐贤","text":"澹澹青空远，亭亭碧巘重。\n忽惊雷雨送飞龙。\n欲洗玉芙蓉。\n稍认岩间寺，都迷壑底松。\n良工吮笔未形容。\n疑是九疑峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 平沙落雁","author":"李齐贤","text":"醉墨疏还密，残棋整复斜。\n料应遗迹在泥沙。\n来往岁无差。\n水暖仍菰米，霜寒尚苇花。\n心安只合此为家。\n何事客天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 白岳晴云","author":"李齐贤","text":"菖杏春风后，茅茨野水头。\n晴云弄色蔼林丘。\n雨意未能休。\n京县民无赋，郊田岁有秋。\n明朝去学种瓜侯。\n身世寄菟裘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 白岳晴云","author":"李齐贤","text":"晓过青郊驿，春游白岳山。\n提壶劝酒语关关。\n一听一开颜。\n村舍疏林外，田畦乱水间。\n郊原雨足信风还。\n羡杀岭云间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 朴渊瀑布","author":"李齐贤","text":"绝壁开嵌窦，长川挂半天。\n跳珠喷玉几千年。\n爽气白如烟。\n岂学然犀客，谁期驻鹤仙。\n淋衣暑汗似流泉。\n到此欲装绵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 朴渊瀑布","author":"李齐贤","text":"日照群峰秀，云蒸一洞深。\n人言玉辇昔登临。\n盘石在潭心。\n白练飞千尺，青铜彻万寻。\n月明笙鹤下遥岑。\n吹送水龙吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 江天暮雪","author":"李齐贤","text":"向夕回征棹，凌寒上酒楼。\n江云作雪使人愁。\n不见古潭洲。\n声紧云边雁，魂清水上鸥。\n千金骏马拥貂裘。\n何似卧渔舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 江天暮雪","author":"李齐贤","text":"风紧云容惨，天寒雪势严。\n筛寒洒白弄纤纤。\n万屋尽堆盐。\n远浦回渔棹，孤村落酒帘。\n三更霁色妒银蟾。\n更约挂疏帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 西江风雪","author":"李齐贤","text":"过海风凄紧，连云雪杳茫。\n落花飘絮满江乡。\n偷放一春狂。\n渔市关门早，征帆入浦忙。\n酒楼何处咽丝簧。\n愁杀孟襄阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 西江风雪","author":"李齐贤","text":"雪压江边屋，风鸣浦口樯。\n时登草阁挂南窗。\n云海杳茫茫。\n斫脍银丝细，开尊绿蚁香。\n高歌一曲礼成江。\n肠断贺头网。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 远浦归帆","author":"李齐贤","text":"南浦寒潮急，西岑落日催。\n云帆片片趁风开。\n远映碧山来。\n出没轻鸥舞，奔腾阵马回。\n船头浪吐雪花堆。\n画鼓殷春雷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 远浦归帆","author":"李齐贤","text":"解缆离淮甸，扬舲指楚乡。\n风声飒飒水茫茫。\n帆席上危樯。\n断送浮云影，惊回过雁行。\n江楼红袖倚斜阳。\n远引客心忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 松都八景紫洞寻僧","author":"李齐贤","text":"傍石过清浅，穿林上翠微。\n逢人何更问僧扉。\n午梵出烟霏。\n草露沾芒屦，松花点葛衣。\n鬓丝禅榻坐忘机。\n山鸟漫催归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 青郊送客","author":"李齐贤","text":"野寺松花落，晴川柳絮飞。\n临风白马紫金袜，欲去惜芳菲。\n聚散今犹古，功名梦也非。\n青山不语暗相讥。\n谁见二疏归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 青郊送客","author":"李齐贤","text":"芳草城东路，疏松野外坡。\n春风是处别离多。\n祖帐簇鸣珂。\n村暖鸡呼屋，沙晴燕掠波。\n临分立马更婆娑。\n一曲渭城歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 洞庭秋月","author":"李齐贤","text":"衡岳宽临北，君山小近南。\n中开北百里湖潭。\n吴楚入包含。\n银汉秋相接，金波夜正涵。\n举杯长啸待鸾骖。\n且对影成三。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 洞庭秋月","author":"李齐贤","text":"万里天浮水，三秋露洗空。\n冰轮辗上海门东。\n弄影碧波中。\n荡荡开银阙，亭亭插玉虹。\n云帆便欲挂西风。\n直到广寒宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 烟寺晚钟","author":"李齐贤","text":"楚甸秋霖卷，湘岑暮霭浓。\n一春容罢一春容。\n何许日沉钟。\n摇月传空谷，随风渡远峰。\n溪桥有客倚寒筇。\n一径入云松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 渔村落照","author":"李齐贤","text":"雨霁长江碧，云归远岫青。\n一边残照在林坰。\n绿网晒苔扃。\n波影明重绮，沙痕射远星。\n鲈鱼白酒醉还醒。\n身世任浮萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 渔村落照","author":"李齐贤","text":"远岫留残照，微波映断霞。\n竹篱茅舍是渔家。\n一径傍林斜。\n绿岸双双鹭，青山点点鸦。\n时闻笑语隔芦花。\n白酒换鱼虾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 黄桥晚照","author":"李齐贤","text":"旷望菰田路，嵯峨柳院楼。\n夕阳行路却回头。\n红树五陵秋。\n城郭遗基壮，干戈往事悠。\n村家童子不知愁。\n横笛倒骑牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 黄桥晚照","author":"李齐贤","text":"隐见溪流转，纵横野垄分。\n隔林人语远堪闻。\n村径绿如裙。\n鸢集蜈山树，鸦投鹄岭云。\n来牛去马更纷纷。\n城郭日初曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 紫洞寻僧","author":"李齐贤","text":"老喜身犹健，闲知兴更添。\n芒鞋竹杖度千岩。\n迎送有苍髯。\n坐久云归岫，谈余月挂檐。\n但教沽酒引陶潜。\n来往意何厌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 潇湘八景平沙落雁","author":"李齐贤","text":"玉塞多缯缴，金河欠稻粱。\n兄兄弟弟自成行。\n万里到潇湘。\n远水澄拖练，平沙白耀霜。\n波头人散近斜阳。\n欲下更悠扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 潇湘夜雨","author":"李齐贤","text":"潮落蒹葭浦，烟沉橘柚洲。\n黄陵祠下雨声秋。\n无限古今愁。\n漠漠迷渔火，萧萧滞客舟。\n个中谁与共清幽。\n唯有一沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巫山一段云 潇湘夜雨","author":"李齐贤","text":"暗澹青枫树，萧疏斑竹林。\n篷窗夜雨冷难禁。\n敧枕故乡心。\n二女湘江泪，三闾楚泽吟。\n白云千载恨沉沉。\n沧海未为深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沁园春 将之成都","author":"李齐贤","text":"堪笑书生，谬算狂谋，所就几何。\n谓一朝遭遇，云龙风虎，五湖归去，月艇烟蓑。\n人事多乖，君恩难报，争柰光阴随逝波。\n缘何事，背乡关万里，又向岷峨。\n幸今天下如家，顾去日无多来日多。\n好轻裘快马，穷探壮观，驰山走海，总入清哦。\n安用平生，突黔席暖，空使毛群欺卧驼。\n休肠断，听阳关第四，倒卷金荷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洞仙歌 杜子美草堂","author":"李齐贤","text":"百花潭上，但荒烟秋草。\n犹想君家屋乌好。\n记当年，远道华发归来，妻子冷，短褐天吴颠倒。\n卜居少尘事，留得囊钱，买酒寻花被春恼。\n造物亦何心，枉了贤才，长羁旅、浪生虚老。\n却不解消磨尽诗名，百代下，令人暗伤怀抱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 早行","author":"李齐贤","text":"旅枕生寒夜惨凄。\n半庭明月露凄迷。\n疲僮梦语马频嘶。\n人世几时能少壮，宦游何处计东西。\n起来聊欲舞荒鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 黄帝铸鼎原","author":"李齐贤","text":"见说轩皇此炼丹。\n乘龙一去杳难攀。\n鼎湖流水自清闲。\n空把遗弓号地上，不蒙留药在人间。\n古今无计驻朱颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菩萨蛮 舟中夜宿","author":"李齐贤","text":"西风吹雨鸣江树。\n一边残照青山暮。\n系缆近渔家。\n船头人语哗。\n白鱼兼白酒。\n径到无何有。\n自喜卧沧洲。\n那知是宦游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菩萨蛮 舟次青神","author":"李齐贤","text":"长江日落烟波绿。\n移舟渐近青山曲。\n隔竹一灯明。\n随风百丈轻。\n夜深篷底宿。\n暗浪鸣琴筑。\n梦与白鸥盟。\n朝来莫漫惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"满江红 相如驷马桥","author":"李齐贤","text":"汉代文章，谁独步、上林词客。\n游曾倦、家徒四壁，气吞七泽。\n华表留言朝禁闼，使星动彩归乡国。\n笑向来、父老到如今，知豪杰。\n人世事，真难测。\n君亦尔，将谁责。\n顾金多禄厚，顿忘畴昔。\n琴上早期心共赤，镜中忍使头先白。\n能不改、只有蜀江边，青山色。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蝶恋花 汉武帝茂陵","author":"李齐贤","text":"石室天坛封禅了。\n青鸟含书，细报长生道。\n宝鼎光沉仙掌倒。\n茂陵斜日空秋草。\n百岁真同昏与晓。\n羽化何人，一见蓬莱岛。\n海上安期今亦老。\n从教吃尽如瓜枣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天","author":"李齐贤","text":"乐府曾知有此堂。\n路人犹解说欧阳。\n堂前杨柳经摇落，壁上龙蛇逸杳茫。\n云澹泞，月荒凉。\n感今怀古欲沾裳。\n胡僧可是无情物，毳衲蒙头入睡乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹧鸪天","author":"李齐贤","text":"未用真珠滴夜风。\n碧筒醇酎气相通。\n舌头金液凝初满，眼底黄云陷欲空。\n香不断，味难穷。\n更添春露吸长虹。\n饮中妙诀人如问，会得吹笙便可工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]