[{"title":"落梅风","author":"马致远","text":"夕阳下，酒旆闲。\n两三航未曾着岸。\n落花水香茅舍晚，断桥头卖鱼人散。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落梅风","author":"马致远","text":"实心儿待，休做谎话儿猜。\n不信道为伊曾害。\n害时节有谁曾见来？\n瞒不过主腰胸带。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落梅风","author":"马致远","text":"心间事，说与他。\n动不动早言两罢。\n罢字儿碜可可你道是耍，我心里怕那不怕？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"小桃红","author":"马致远","text":"画堂春暖绣帏重，宝篆香微动。\n此外虚名要何用？\n醉乡中。\n东风唤醒梨花梦。\n主人爱客，寻常迎送，鹦鹉在金笼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双调·寿阳曲","author":"马致远","text":"渔灯暗，客梦回，一声声滴人心碎。\n孤舟五更家万里，是离人几行情泪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双调·拨不断","author":"马致远","text":"叹寒儒，谩读书，读书须索题桥柱。\n题柱虽乘驷马车，乘车谁买长门赋。\n且看了长安回去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双调·拨不断","author":"马致远","text":"酒杯深，故人心。\n相逢且莫推辞饮，君若歌时我慢斟。\n屈原清死由他恁，醉和醒争甚！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四块玉","author":"马致远","text":"美貌娘，名家子，自驾着个私奔车儿。\n汉相如便做文章士，爱他那一操儿琴，共他那两句儿诗。\n也有改嫁时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四块玉","author":"马致远","text":"绿鬓衰，红颜改，羞把尘容画麟台。\n故园风景依然在；三顷田，五亩宅，归去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四块玉","author":"马致远","text":"酒旋沽，鱼新买，满眼云山画图开。\n清风明月还诗债。\n本是个懒散人，又无甚经济才，归去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四块玉","author":"马致远","text":"带月行，披星走。\n孤馆寒食故乡秋，妻儿胖了咱消瘦。\n枕上忧，马上愁，死后休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乔木查","author":"马致远","text":"想秦宫汉阙，都做了衰草牛羊野。\n不恁渔樵无话说。\n纵荒坟横断碑，不辨龙蛇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拨不断","author":"马致远","text":"名利竭，是非绝。\n红尘不向门前惹，绿树偏宜屋角遮，青山正补墙头缺，竹篱茅舍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拨不断","author":"马致远","text":"菊花开，正归来。\n伴虎溪僧、鹤林友、龙山客；似杜工部、陶渊明、李太白；有洞庭柑、东阳酒、西湖蟹。\n哎，楚三闾休怪！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南吕·四块玉","author":"马致远","text":"雁北飞，人北望，抛闪煞明妃也汉君王。\n小单于把盏呀刺刺唱。\n青草畔有收酪牛，黑河边有扇尾羊，他只是思故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离亭宴煞","author":"马致远","text":"蛩吟一觉方宁贴，鸡鸣万事无休歇。\n争名利，何年是彻？\n密匝匝蚁排兵，乱纷纷蜂酿蜜，闹攘攘蝇争血。\n裴公绿野堂，陶令白莲社。\n爱秋来那些：和露摘黄花，带霜烹紫蟹，煮酒烧红叶。\n人生有限杯，几个登高节？\n嘱咐俺顽童记者：便北海探吾来，道东篱醉了也。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清江引","author":"马致远","text":"林泉隐居谁到此，有客清风至。\n会作山中相，不管人间事。\n争甚么半张名利纸！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清江引","author":"马致远","text":"西村日长人事少，一个新蝉噪。\n恰待葵花开，又早蜂儿闹，高枕上梦随蝶去了。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清江引","author":"马致远","text":"樵夫觉来山月底，钓叟来寻觅。\n你把柴斧抛，我把鱼船弃。\n寻取个稳便处闲坐地。\n绿蓑衣紫罗袍谁为你，两件儿都无济。\n便作钓鱼人，也在风波里。\n则不如寻个稳便处闲坐地。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七宝玲珑 继重阳韵","author":"马钰","text":"至愚至鲁，怎晓妙中玄。\n便再拜、告风仙。\n口诀金身长丈六，二十八宿会圣贤。\n此理方知合自然。\n坎虎离龙，蟠绕五方莲。\n渐渐得、好因缘。\n火里木人能采药，海底泥牛会种田。\n迸出灵光入洞天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二郎神慢","author":"马钰","text":"应仙举。\n便下手、先除色欲。\n好玉洁冰清大丈夫。\n更休任、泥拖水漉。\n一失人身难再复。\n莫等闲、把前程失误。\n今略诉。\n长生久视，五件堪为凭据。\n听取。\n第一要、涤除念虑。\n第二要、忘贪戒酒肉。\n第三要、济贫拔苦。\n第四要、常行慈善。\n第五要、精神保护。\n依此五件，功成行满，得赴蓬莱仙路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗五愿报师恩。\n酒色气财誓不侵。\n便把日乌先赶退，次将月兔更牢擒。\n月轮重显无圆缺，日色增辉没缩沉。\n功满丹成何处去，得超云汉绝阳阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗三愿报师恩。\n锻炼灵胎在玉京。\n铅汞烹煎先有验，虎龙交媾岂无声。\n三光并秀超三味，五岳同峰出五行。\n三五丹成真造化，自然云步访蓬瀛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"一从得遇乐清贫。\n忻住环墙怕惹尘。\n炼气气和神恋气，愿神神爽气安神。\n宰公请我求追荐，小子慈心奉善因。\n救拔亡灵超上界，孤魂滞魄总朝真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗七愿报师恩。\n掌握虚无死水银。\n满目牛羊当道卧，一轩风月证人纯。\n清清净净难迷假，净净清清易见真。\n龙虎丹成无九转，自然永永做仙人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗十愿报师恩。\n劈碎金枷玉杻情。\n久视门中修久视，长生路上得长生。\n昏昏默默澄澄湛，杳昔冥冥净净清。\n响喨丹成蓬岛去，重阳师父远来迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗二愿报师恩。\n立誓修行志炼心。\n火焰灭除火养木，水银枯尽水生金。\n木金三间通玄路，水火同流结宝岑。\n久视大丹成不漏，携云归去绝升沉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"青牛白鹿与黄羊。\n稳驾云舆昼夜忙。\n运载乾坤常会合，推般日月永交光。\n法轮响喨投玄窟，云辂玎珰入道场。\n九转功夫如省悟，自然得继马丹阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗九愿报师恩。\n意净心清路坦平。\n便把无为为造化，不凭有作作经营。\n恰如逗引龙和虎，还似般调姹与婴。\n活乐丹成蓬岛去，和公师叔远来迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"昆嵛三髻马风歌。\n得遇修仙厌事多。\n我处无为酬本愿，人求追荐苦相魔。\n加持助醮居环堵，救拔亡灵上大罗。\n滞魄孤魂诚有幸，一齐超度喜无过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗八愿报师恩。\n返覆阴阳仗炼烹。\n火降水升抛雪浪，龙吟虎啸发雷声。\n玉炉瑞雪重重结，金鼎祥光霭霭生。\n无价丹成无老死，长生路上法身轻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗四愿报师恩。\n天地收来入宝瓶。\n日月山川添壮观，虎龙婴姹得安宁。\n清轻浊重阴阳正，博厚高明品物灵。\n赫赤丹成全性命，超然跨鹤过天庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩","author":"马钰","text":"山侗六愿报师恩。\n坦荡逍遥不惹尘。\n识破假躯端的假，研穷真性的端真。\n方知可道非常道，始觉不神所以神。\n清净丹成乘赤凤，大罗天上赏长春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 上街求乞","author":"马钰","text":"人人休惜一文钱。\n好与贫儿且结缘。\n暗暗还贤增万倍，明明助我养三田。\n舍悭自是开心地，割爱方能达妙玄。\n一日悟来离苦海，逍遥物外共修仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 本名瑞鹧鸪","author":"马钰","text":"山侗一愿报师恩。\n物外生涯世罕闻。\n锻炼玉炉三涧雪，修完金鼎一溪云。\n蛟龙宜向火中溉，猛虎堪于水里焚。\n一粒神丹光透壁，不神神彩独超群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 述怀","author":"马钰","text":"利名场上没萦牵。\n人我丛中绝焰烟。\n举意游山山岭上，兴心乐水水云边。\n往来飘逸孤如鹤，去住安闲静似蝉。\n据此逍遥能有几，从教人道活神仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 勉门人","author":"马钰","text":"道人活计不相侵。\n各自衣餐各自寻。\n莫为闲言闲斗气，休争俗事俗萦心。\n搜玄绝虑龙随虎，索隐记机水养金。\n清净色身全法体，一炉丹熟步瑶岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 遇禁烟道友索","author":"马钰","text":"禁烟禁火禁心猿。\n真息调来永永绵。\n云水不游芳草径，身心岂著杏花天。\n为人勿作坟中鬼，学我能修物外仙。\n异日大丹成九转，腾空何必打秋千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 道友问在家能修行否","author":"马钰","text":"神仙要做恋妻男。\n忙里偷闲道上参。\n清净门庭无意认，淫情术法入心贪。\n欲求家道两全美，怎悟寂寥一著甘。\n莫待酆都追帖至，早归物外住云庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 赠李校尉","author":"马钰","text":"一身便做个丹丘。\n于内常常云水游。\n离坎交宫真子午，甲庚易位没春秋。\n五行四象皆无用，三岛十洲却有由。\n功行无亏云鹤引，大罗天上列仙俦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 赠陉阳张书表","author":"马钰","text":"六旬有四卦将休。\n猛悟灰心离俗游。\n访我搜真归正觉，搜玄索隐做持修。\n头分丫髻云霞友，手显擎拳风月俦。\n稽首更明珍重理，自然得去赴瀛洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十报恩 赠段先生","author":"马钰","text":"公物外好生涯，火相逢结大砂。\n女盘桓看大药，牛哮吼戏灵葩。\n云铺地丹炉赫，子观天碧眼华。\n有三生君省悟，中无事步烟霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"师父重阳号。\n炼就重阳宝，紫诏重阳赴玉京，方显重阳好。\n我为重阳到。\n庵为重阳造。\n特为重阳守服居，符合重阳道。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"我遇重阳悟。\n曾得重阳趣。\n炼就重阳绝尽阴，阴就重阳著。\n性命重阳聚。\n三曜重阳辅。\n不到重阳不做仙，仙自重阳做。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"天地水三官，下界吹龙笛。\n蓦听开元虎啸声，风伯雨师寂。\n至孝养孀亲，红锦蛇吞鳖。\n六路青牛驾宝车，显圣功端的。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":885,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"我为中秋说。\n休赏中秋节。\n外景中秋不益人，内景中秋别。\n心到中秋歇。\n尘自中秋绝。\n金遇中秋结大丹，性似中秋月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":886,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"干禄已无心，唯应三清举。\n钟吕天差作试官，取舍非诗赋。\n考校实修持，功行三千数。\n相应希夷得自然，名录神仙簿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":887,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"人识山侗字。\n谁晓山侗意。\n大貌山侗人倚山，故作山侗谜。\n财色山侗弃。\n玄妙山侗秘。\n一日侗乐道成，永占山侗位。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":888,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"洒扫阳关路。\n开阐阳关户。\n此个阳关无点尘，堪饯阳关侣。\n既得阳关趣。\n怎肯阳关住。\n放出阳关成道人，起自阳关悟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":889,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子","author":"马钰","text":"燕至清明近。\n花到清明盛。\n奉劝清明游赏人，别有清明景。\n我得清明永。\n旷劫清明净。\n一点清明无价珍，便是清明性。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":890,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜算子 和师韵","author":"马钰","text":"业重多思算。\n岂悟爻和象。\n深谢风仙特地来，便把顽遇唤。\n忿怒常思难。\n性烛须教灿。\n真乐真欢散尽愁，师弟常为伴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":891,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"人人学道总劳劳，个个心高志不高。\n烟火靡除生怨恶，尘情不断起贪饕。\n欲搜玄妙消三业，猛向根芽下一刀。\n常净常清常忍辱，无为无作列仙曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":892,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"堪叹人人，波波劫劫贪名利。\n何时已。\n眼光落地。\n到此才方悔。\n虽有儿孙，要替应难替。\n辞生泪。\n甚家滋味。\n想着心先碎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"自己园亭。\n无分昼夜宜重构。\n黄芽秀。\n欲携云母。\n那里须垂手。\n无相人人，蓦地开金口。\n明先后。\n须当遗旧。\n拿出元初走。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"昔年常被利名枷，苦海波中喜戴枷。\n常下儿孙如玉杻，眼前妻妾似金枷。\n至迷马钰因何悟，得遇风仙便脱枷。\n闲里寻闲得闲趣，如今宁肯复投枷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"道人财色酒虽无。\n一点无明著甚除。\n恶念不生归莹素，触来勿竞证元初。\n我人起处愁无极，烟火消时乐有馀。\n欲学神仙须忍辱，莫交烧了那真如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"风仙风害得真风，留下家风要害风。\n通密丘仙能继踵，山侗马钰应扶风。\n劝人休作梦中梦，学我能寻风里风。\n或问风因亲说破，投玄远俗做心风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"冬至阳生，迎春拨雪黄芽好。\n人惊早。\n香如芝草。\n玉碾胜磨捣。\n神水烹煎，自是除阴耗。\n金童报。\n绝品珍宝。\n啜罢游蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"劝人休要问前缘，但肯回头是宿缘。\n不想浮生难猛悟，稍知虚患近良缘。\n无心入道须无分，有意投玄是有缘。\n自古神仙皆出离，在家怎得好因缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"缘甚修持，风仙钓出侵云构。\n灵苗秀。\n斡运真母。\n非是调羹手。\n小过谁无，语失当缄口。\n班行后。\n怎生依旧。\n除是随风走。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"奉劝人人，尘中莫竞锥刀利。\n心先已。\n勿欺天地。\n事在前头悔。\n欲免轮回，休望儿孙替。\n休垂泪。\n道家真味。\n把恩爱先锤碎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"秦川胜景果非常，最好终南珍藏乡。\n竹径梅溪生秀气，凤巢龙窟吐祥光。\n云庵处处成云集，道友多多论道长。\n刘蒋村名今改变，人人传说会仙庄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春","author":"马钰","text":"斩钉截铁不思家，永绝孤疑永弃家。\n足履白云寻羽客，杖挑明月返仙家。\n乡中园馆非吾宅，物外蓬瀛是我家。\n自在逍遥无宿虑，何须重话旧时家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春 劝道友","author":"马钰","text":"去去来来，来来去去何时了。\n堪失笑。\n利名缠倒。\n衣换知多少。\n奉劝人人，早把元阳保。\n休虚耗。\n结成珍宝。\n得赴蓬莱岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":904,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春 宁解元许却庵门以词督之","author":"马钰","text":"谭马丘刘，专专卓个庵儿住。\n修行处。\n未知门户。\n有个先生许。\n翘俟嘉音，万里垂青顾。\n如无误。\n决登云路。\n岂敢忘恩府。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":905,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春 咏李公慵轩","author":"马钰","text":"物外慵轩，闲居放坦无为作。\n无为作。\n自然期约。\n心肾相交错。\n二气成形，结就灵丹药。\n灵丹药。\n银霞覆却。\n展起腾云脚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":906,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春 咏李实庵名静乐","author":"马钰","text":"常守行庵，常清常静常常快。\n常搬载。\n日常宁耐。\n自是常交泰。\n真乐真欢，应物真常在。\n真无坏。\n真如光彩。\n得做真良价。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":907,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万年春 继重阳韵","author":"马钰","text":"悟彻梨分，常清常净新营构。\n神添秀。\n食其真母。\n展出拿星手。\n从此收心，磨琢慵开口。\n通前后。\n始知元旧。\n参从风仙走。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":908,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]