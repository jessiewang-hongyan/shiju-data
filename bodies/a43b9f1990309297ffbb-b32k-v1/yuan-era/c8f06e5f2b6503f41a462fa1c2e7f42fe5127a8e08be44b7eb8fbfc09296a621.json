[{"title":"寅夫示再登鼓山四诗仆虽不获同游然来诗不可虚辱次韵奉谢且致归班之饯 其二","author":"程钜夫","text":"眼前培塿足萦缠，去去瀛洲大洞天。\n一息南溟能几月，再行东海定何年？\n江淮巨浪千堆雪，榆柳中原万里烟。\n解视归装还不俗，有诗曾酌瘴乡泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寅夫晚凉感事","author":"程钜夫","text":"初夏微风作嫩凉，伤春一夜鬓毛苍。\n红芳寂历午阴绿，白昼须臾晚照黄。\n溅泪露葵空滴滴，锁愁烟柳自行行。\n绝怜熠耀仓庚羽，曾带千门丽日光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题采莲舟杯","author":"程钜夫","text":"攀翻叶上露，酿作杯中酒。\n可能君不醉，负此掺掺手。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题仲经家江贯道潇湘八景图 其一 烟寺晚钟","author":"程钜夫","text":"僧定钟声缓，依稀听不真。\n渡头风正忽，唤醒未归人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题仲经家江贯道潇湘八景图 其二 洞庭秋月","author":"程钜夫","text":"万顷玻璃上，辉辉玉一环。\n望中青似粟，约莫是君山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题仲经家江贯道潇湘八景图 其三 潇湘夜雨","author":"程钜夫","text":"昏昏风浪里，瑟瑟打篷声。\n骚客千年恨，灵妃万古情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十一日浯畬登舟十绝 其一","author":"程钜夫","text":"濑头流水绿如油，急取春芽试一瓯。\n扬子江心堪伯仲，茶经从此合重修。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十一日浯畬登舟十绝 其二","author":"程钜夫","text":"江清照见石粼粼，貌得游鱼态度真。\n说与长年轻荡桨，放他深处著潜鳞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22253,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"板桥午食","author":"程钜夫","text":"县郭二十里，板桥三五家。\n西风熟禾黍，陆地富桑麻。\n去岁遭洪水，高林带旧槎。\n他乡岂不好，无奈此生涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22254,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为曹仲坚题渔父图","author":"程钜夫","text":"风烟浩渺浪拍天，百帆齐开争一先。\n轻舠荡漾自来去，诗人曾赏古渔父。\n山围别浦树参差，水净沙明人迹稀。\n大罾小罟较得失，鲂鱮暗作枯鱼泣。\n直针为钩饵亦无，烟波不见真钓徒。\n林中茅屋是谁子？\n袖手无言方隐几。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22255,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送余率翁职满谒选并寄容斋承旨肯堂学士","author":"程钜夫","text":"江南四月梅子黄，衣袖已试荷风香。\n出门有客欲万里，使我忆得西山苍。\n西山何处云半发？\n夜深斗极回寒芒。\n磴泉自红涧自碧，楼倚白雪歌沧浪。\n容斋遂慵两相好，剑气耿耿龙腾骧。\n我曾握手极千古，逢之满腹生琳琅。\n晓天一笑江水长，燕鸣岸雨催牙樯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22256,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉饯学舟老先生之武陵","author":"程钜夫","text":"疾风吹云云不裂，南纪酣酣三日雪。\n辰阳冷掾故不冷，破帽棕鞋来作别。\n先生自是我辈人，锦袍丹绂曾青春。\n黄金筑台不肯上，水晶宫中一角麟。\n一朝忽著儒冠起，泛宅浮家五千里。\n系船花岸茹蒸霞，为展皋比说诗礼。\n宣尼未始三年淹，我亦鸣榔下湘水。\n萧云曹志上所知，铨量当遣教五溪。\n先生行止无不可，瓜期况尔来迟迟。\n问君此行何所之，武陵思我还当归。\n是间少长致足乐，采花食实薪桃枝。\n落日天低洞庭野，木叶萧萧风上下。\n留君小住君掉头，前有十浆先馈者。\n苍苍烟水解迷人，莫倚川原物色新。\n汉家会有蒲轮使，珍重修程稳致身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22257,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄阎子静唐静卿二翰长","author":"程钜夫","text":"故人天上近何如，白玉堂中足宝书。\n烛彻宫莲三鼓后，露漙仙掌九秋初。\n江湖政共丹心老，鱼雁全如绿鬓疏。\n西北阑干天咫尺，欲乘黄鹤却踌躇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22258,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵卢疏斋就以赠别二首 其一","author":"程钜夫","text":"百川昼夜流，万折不能止。\n群山势崩奔，终古乃在此。\n人生费推挽，三叹中夜起。\n潇湘有佳人，朗月鉴秋水。\n思之不可见，旷若隔千祀。\n相逢在岁晏，使我寝食美。\n又言当远别，东去数千里。\n何由小踌躇，招招彼舟子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵卢疏斋就以赠别二首 其二","author":"程钜夫","text":"芥拾琥珀针，不言自相得。\n留君我无辞，送君我无力。\n愿君加餐饭，努力崇明德。\n江空馀深寒，出入慎扶翼。\n梅花照清颍，梦寐耿玉色。\n矫首东南云，金门幸回忆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舜举画棠梨练雀","author":"程钜夫","text":"霜晕棠梨脸，风梳练雀翎。\n含毫心欲醉，开卷眼还醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尹生归江西","author":"程钜夫","text":"江汉秋深雁过稀，悠悠归思梦先知。\n输君去住无多事，顾我留行待几时。\n野岸晓光千棹急，平湖寒影数峰欹。\n拍肩试向洪崖说，傥有黄花觅一枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乔达之画江山秋晚图二首 其一","author":"程钜夫","text":"遮日西来正暮秋，买鱼沽酒醉船头。\n如今见画浑疑梦，知是南湖第几洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乔达之画江山秋晚图二首 其二","author":"程钜夫","text":"别来事事可名家，独我空添两鬓华。\n天际有山归未得，远峰休著淡云遮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22264,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔翁图","author":"程钜夫","text":"渔翁牵纑渔妇纺，膝上儿看掉车响。\n溪南溪北趁冬晴，水急船多欠新网。\n祝儿休啼手正忙，网成得鱼如汝长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22265,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送完颜总管赴平阳","author":"程钜夫","text":"汾水西南古晋州，双旌五马汉诸侯。\n庭无坐吏官班重，地有遗民帝化留。\n荆树春风誇列士，甘棠清荫羡高秋。\n征騑莫叹长安远，回首朝阳是蓟丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22266,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢学士诗卷","author":"程钜夫","text":"渺渺蒲江远，年年桂树秋。\n空馀诗卷在，天地与长留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22267,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七真山洞云观","author":"程钜夫","text":"七真之山白云里，绛阙神宫半空起。\n祁君有志于君成，更赐雄材自天子。\n东临沧海西昆崙，森森翠节排天门。\n三更日射芙蓉色，六月石挂冰霜痕。\n山头髣髴清虚府，洞底阴岑太行路。\n青苔能识六龙车，明月长悬万年树。\n峰盘涧复气絪缊，瑶草金芝日日新。\n君王自有长生药，端拱无为万国春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22268,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上赐潘司农龙眠拂菻妇女图","author":"程钜夫","text":"拂菻迢迢四万里，拂菻美人瑩秋水。\n五代王商画作图，龙眠后出尤精致。\n手持玉钟玉为颜，前身应住补陀山。\n长眉翠发四维列，白氎覆顶黄金环。\n女伴骈肩拥孤树，背把閒花调儿女。\n一儿在膝娇欲飞，石榴可怜故不与。\n凉州舞彻来西风，琵琶檀板移商宫。\n娱尊奉长各有意，风俗虽异君臣同。\n百年承平四海一，此图还从秘府出。\n司农潘卿拜赐归，点染犹须玉堂笔。\n天门荡荡万国臣，驲骑横行西海滨。\n闻道海中西女种，女生长嫁拂菻人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22269,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵一德季润忠孝诗","author":"程钜夫","text":"南昌赵氏子，早岁遭艰虞。\n骨肉不相保，万国为囚俘。\n释缚燕赵间，遂为郑家奴。\n荡荡天宇阔，亹亹日月徂。\n转瞬四十年，朝夕劳且劬。\n主翁岂无恩，不得齐民俱。\n主翁父子没，悉力持且扶。\n有客南昌来，解后谈厥初。\n问知家中事，五内犹摧刳。\n父兄死未葬，有母八十馀。\n再拜主母前，涕泗下涟如。\n委曲陈其情，愿母哀其愚。\n主母为之悲，暂许奉康娱。\n星言整去装，策马登长途。\n山川日以异，旬朔奄相踰。\n日暮不留行，忽已臻其庐。\n升堂拜慈母，再世得相于。\n恸哭父兄前，邻里皆欷歔。\n生者幸少慰，死者归黄垆。\n主恩不可忘，母养不可虚。\n黾勉与母辞，复返郑氏居。\n主母惊且喜，左右咸欢呼。\n赵子令至前，授以咫尺书。\n汝孝通神明，汝义薄天衢。\n永为故乡民，汝去初踌躇。\n赵子再拜谢，洒血满襟裾。\n主恩一未报，何用早归欤。\n主翁积忠劳，封谥焉可无。\n穹碑表墓毕，逝将还故墟。\n主翁有遗嗣，无罪倏见诛。\n奋身伏王庭，誓死诉冤诬。\n白日回其光，天道划昭苏。\n岂独全郑门，高风动皇都。\n滔滔天下者，回首成榛芜。\n安知磊落人，沦此氓隶徒。\n飞檄下九天，大字旌其闾。\n郁郁文献邦，盛事映梅徐。\n母寿涉千龄，闻有驷马车。\n吾闻善必报，此理天不渝。\n我作忠孝诗，永激顽懦夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22270,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和陶诗","author":"程钜夫","text":"秋风吹庭树，密叶潜销落。\n玄燕宁久翔，白雁纷南泊。\n清晨得樽酒，冥然还独酌。\n年运倏徂谢，春秋焉能托。\n依依仰先哲，缅邈空述作。\n江汉日东流，寒花绕丛薄。\n开卷抚休运，振衣望丘壑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早行图","author":"程钜夫","text":"万山回合路纡萦，独策羸骖款款行。\n却忆麻源三谷里，画桥携酒听溪声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿李秋谷","author":"程钜夫","text":"微省星辰近，銮坡日月迟。\n上公开瑞旦，旧学蔚明时。\n玉琯微阳动，宫壶喜气随。\n已应萧应昴，复说傅骑箕。\n琥珀苍松液，珊瑚碧树枝。\n茂生豪杰士，来作太平基。\n忆昔公初起，方时事已隳。\n艰虞身保障，谋议国蓍龟。\n赤手除蛟虎，丹心见藿葵。\n一朝周典礼，万世汉官仪。\n宗庙重钟簴，乾坤再柱维。\n秦阶寒耿耿，遐壤日熙熙。\n大小陈纲纪，神奸铸鼎彝。\n桂枝增秀发，蔓草极芟夷。\n乡校惟闻颂，朝廷总得宜。\n端由天子圣，亦在哲人推。\n昭代才何盛，斯文柄独持。\n立言成准范，析理贯书诗。\n馀事归青史，新篇蔼素期。\n朝趋双阙内，夕梦北山陲。\n顾问常前席，论思每执规。\n力援寒畯溺，已视庶民饥。\n姓字喧童稚，仁恩被等衰。\n功高门似水，心静爵空縻。\n报主期尧舜，为臣志吕伊。\n山河分陕地，勋业太常旂。\n早达谦盈理，居多宠禄辞。\n战兢存夙夜，赑屃负安危。\n即此观天道，宜能永福绥。\n直为天下祝，不是老夫私。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孤云","author":"程钜夫","text":"渺渺从何起，亭亭只自飞。\n朝随风鹤去，暮逐雨龙归。\n几度超沧海，多应点翠微。\n何时能借我？\n裁作羽人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送武当张真人赴召祈雨南归","author":"程钜夫","text":"圣主忧凶岁，真人下碧岑。\n云辞武当黑，雨入蓟门深。\n独抱回天力，常存济物心。\n两宫宣赐罢，归鹤杳沈沈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长江归棹图","author":"程钜夫","text":"蔼蔼天始晴，苍苍景将晚。\n江波日东流，游子何时返？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江钓月","author":"程钜夫","text":"荷蓑非避世，持竿不求赏。\n夙抱江海心，宁为利名鞅。\n天明紫烟里，日暮清波上。\n四顾无人知，孤舟自来往。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题许仲仁墨迹","author":"程钜夫","text":"残雪词林退食时，小窗开卷鬓如丝。\n音传正始谁同调？\n气逼元和稍自持。\n文字不随前辈尽，风流却许后人知。\n霜清日冷梅花瘦，独对炉熏看欲痴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汪忠卿御史梅庵","author":"程钜夫","text":"家住新安生虎林，绣衣风节老梅心。\n客来若问封侯事，笑指庵前月色深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送札法经历赴山西幕","author":"程钜夫","text":"我昔居南台，与君日相从。\n回首三十年，谓君已飞翀。\n及兹复相见，微名不偿功。\n虽蒙圣主知，进退何从容。\n好爵谁不縻，君视如飘风。\n宁为正直穷，不为壬巧通。\n歘起佐西幕，激烈孝与忠。\n别我升车行，念我双鬓蓬。\n君行展高材，一罄平生胸。\n我志在丘壑，眷焉息微躬。\n冥冥朝阳凤，夏雨生梧桐。\n寂寂涧底松，苍然岁寒中。\n勖哉君子心，庶用存始终。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邓教授致仕还江东","author":"程钜夫","text":"积学今成老，遗荣不待年。\n归心彭蠡外，客思蓟门前。\n孤棹随飞鸟，长河合暮蝉。\n知几诚可尚，忽别独悽然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵解安卿石假山","author":"程钜夫","text":"夜瞻光怪昼生辉，数尺嵌岩旧见稀。\n欲献楚王忧刖足，怕逢织女误支机。\n斜当明月偏宜照，近逼红尘不敢飞。\n中庆堂中蓬岛客，相看不觉恋柴扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春江小景","author":"程钜夫","text":"翠柳红桃春满天，鸳鸯鸂鷘乱平川。\n东风阅遍閒花草，惟有人无再少年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送戴道士住天台","author":"程钜夫","text":"君承恩命住天台，万壑千峰绕绛台。\n门外霞川浮溟涬，杯中云海接蓬莱。\n时同野鹤看桃去，或领山猿采药回。\n三十年前吾亦到，旧题应入白云堆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重送戴道士","author":"程钜夫","text":"被命将居越，扁舟指会稽。\n海云迎棹起，江月照人低。\n有道蟠龙虎，无生混鹜鸡。\n霞川随处是，何必武陵溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李伯时马","author":"程钜夫","text":"龙眠画马真是马，一匹犹当万金价。\n参差粉墨见龙媒，渴饮长江柳阴下。\n我今老病无所求，但愿早赐归林丘。\n肩舆饱饭百不忧，閒看稚子骑犁牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵大年小景","author":"程钜夫","text":"匹马冲寒踏落花，杏园深处曲江涯。\n何如相对风轩坐，唤得渔船傍酒家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题诸葛武侯画像","author":"吴澄","text":"含啸沔阳春，孙曹不敢臣。\n若无三顾主，何地著斯人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题渔舟风雨图","author":"吴澄","text":"蓑笠寒飕飕，一篙背拳曲。\n有人方醉眠，酒醒失茅屋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张尹书巢","author":"吴澄","text":"醯鸡瓮里天，露蝉壳外身。\n此巢何处著？\n六合一微尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吕公干谒不遇手卷","author":"吴澄","text":"持钵空归雪满天，地炉几日断炊烟。\n妻儿不作啼号态，刚信炉灰冷复然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题伯时马","author":"吴澄","text":"骁壮云连力气粗，惯看驰突暗中都。\n如何得此真龙种，消得千金买画图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋牧樵子蒲萄","author":"吴澄","text":"芸香楼上汗成珠，起趁清风为扫除。\n见此西凉甘露乳，泠然齿颊出寒酥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题雪洲图","author":"吴澄","text":"向来洲上雪漫漫，僵倒诗人一屋寒。\n洲上雪消人亦徙，画图犹作雪中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题无波亭","author":"吴澄","text":"长江远壑几飙回，雪屋银山巨浪摧。\n最喜此中澄一镜，微风不动月常来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题皮如心行囊中画竹图","author":"吴澄","text":"畴昔江乡识此君，清风凛凛动霜筠。\n被谁点染移将去，也受京华半面尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山水图","author":"吴澄","text":"远树疏林映晚霞，江心雁影度平沙。\n谁人写我村居乐？\n付与岩前处士家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题和靖观梅图","author":"吴澄","text":"一枝春信到孤山，冰雪肌肤不觉寒。\n月下水边看未足，折来更向手中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭泽遇成之之京都","author":"吴澄","text":"人海茫茫名利场，盛年快意一观光。\n顾予白发归来晚，羞过渊明五柳庄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"建康西江避暑用滕玉霄韵","author":"吴澄","text":"石头城下看淮山，羡杀白云终日閒。\n寄语醉中彭泽令，如何飞倦始知还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送富州尹刘秉彝如京","author":"吴澄","text":"六载心如一，今朝船欲东。\n我来期数数，公去忽匆匆。\n别意万里外，交情片语中。\n自怜栖病鹤，不得逐长风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送唐教导往见乡先达","author":"吴澄","text":"谓余将有适，暂此辍弦歌。\n城市嚣尘远，山林遗逸多。\n树膏苏隰稻，凉意到庭柯。\n为问躬耕者，忧饥思若何？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"豫章贡院即事奉和云林提举晚春閒居旧韵","author":"吴澄","text":"客里秋光好，归心不厌迟。\n墙低孤塔见，院静一帘垂。\n隔纸闻风怒，临阶看日移。\n宛然似三径，未负菊花期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与张仲美别仍用前韵二首 其一","author":"吴澄","text":"乡邻应怪我，何以独归迟？\n木末芙蓉发，帘前果裸垂。\n夜寒知露重，秋老验星移。\n南浦今番别，重来傥可期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与张仲美别仍用前韵二首 其二","author":"吴澄","text":"已了公家事，归寻小洞天。\n友吟留别句，官办送归船。\n夜月各千里，秋风又一年。\n但当频寄字，悃恳问安眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"歌风台","author":"吴澄","text":"黄屋巍巍万乘尊，千秋游子故乡魂。\n韩彭自取夷三族，平勃那堪托后昆。\n湛露迄今王迹熄，大风终古霸心存。\n当时尽自规模远，谁起河汾与细论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕城","author":"吴澄","text":"燕络中原东北去，吴通上国古今奇。\n五千里外只如此，数百年来幸见之。\n吊望诸坟吾有泪，击渐离筑世无知。\n西山绵亘三关险，日日毡车铁马驰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]