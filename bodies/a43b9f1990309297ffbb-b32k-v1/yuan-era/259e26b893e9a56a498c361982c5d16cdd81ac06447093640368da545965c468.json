[{"title":"送邓庆长衍从宦吴中","author":"范梈","text":"闻说吴中郡，青山万叠开。\n云霞通井邑，水木映楼台。\n子去嗟何恨！\n吾生念却回。\n辛勤官下养，书记合频来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月三日，海子泛舟","author":"范梈","text":"晓日明如茜，春波凝不流。\n浴凫浮断梗，过雁折危楼。\n颇敬吴儿狎，何伤楚客囚？\n沙边萦小楫，初慰玉京游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送云知事赴余杭","author":"范梈","text":"一舸发春濑，涓涓沙鹭明。\n官烦南郡佐，礼重北城迎。\n海浦潮声暗，山城日气清。\n宗卿怀故掾，蚤晚荐高名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暑夕","author":"范梈","text":"烦暑不能寐，望乡忆宵征。\n开门海月白，高枕林风清。\n不饮畏投辖，将歌思濯缨。\n谁家横短笛？\n吹尽楚关情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕词","author":"范梈","text":"天上新秋节，人间巧夕祠。\n不成儿女笑，空负岁时悲。\n璧月当轩堕，银河带阙垂。\n低头愧乌鹊，宁为绕南枝？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和巽初得子","author":"范梈","text":"喜事平安使，家书远见贻。\n正愁行路子，新得称家儿。\n白璧无劳羡，青云日与期。\n庭阶人事意，眼冷念含饴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其一","author":"范梈","text":"盛君江海士，直气轧霄峥。\n翻为诗书苦，焉知印绶荣？\n度辽曾万里，走越更千城。\n便是来难得，乡关近慰情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官","author":"范梈","text":"首路向朱夏，出关犹到官。\n麦收风涨暑，梅熟雨留寒。\n气候随方异，才名自古难。\n岂容贤若尔，教授老江干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其三","author":"范梈","text":"江浦见黄鹂，石榴花满枝。\n欲攀犹屡惜，已去复何疑？\n蚤畏红英乱，还当绛帐移。\n驿程动易隔，留待寄相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其四","author":"范梈","text":"娟娟沙尾鹤，毛羽映江鲜。\n去住长如此，飞鸣岂偶然？\n仙家应汗漫，侯判莫留连。\n忆得东门事，须君正壮年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其五","author":"范梈","text":"闽南荔子熟，问客倘能来。\n暂为诸生屈，宁伤独茂才？\n云飞绝寒落，雨过行平台。\n赋就新诗别，扁舟且莫催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其六","author":"范梈","text":"昔向辽东郡，长歌觅管宁。\n此行无赠策，故事有谈经。\n豆实登朱荔，虹光照紫萍。\n龟山文物在，未用叹凋零。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其七","author":"范梈","text":"跃马问入郭，解龟听报衙。\n江沙侵细竹，墙蔓覆疏花。\n政不离书阁，吟应上钓槎。\n有怀当皓月，玉署听啼鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其八","author":"范梈","text":"碧草津头郡，虽偏是胜游。\n野人频识剑，稚子亦能舟。\n稍定传衣怪，聊资宦秩周。\n南来说风物，有待细询求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其九","author":"范梈","text":"杯酒莫停手，路长思八闽。\n精灵深狎客，瘴雾簿侵人。\n海近渔船集，山空鸟道邻。\n来京书一束，赖尔老随身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离席合赋赠南剑教授盛复之之官，凡十首 其十","author":"范梈","text":"黄帽催晨发，邮签报旅程。\n溯风斜帽举，虚日乱弦鸣。\n异俗从谁变？\n真才不自成。\n倘于高第内，岁久得欧生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄淮东宪孔知事二首 其一","author":"范梈","text":"日有乌台使，因君问合肥。\n熊章官下食，虎略幕中威。\n易政听时报，交深念日迟。\n知音偕上列，须假绣为衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄淮东宪孔知事二首 其二","author":"范梈","text":"昔在东门别，相离数岁星。\n一官何委折？\n万里独飘零。\n楚树春频落，燕云晚自停。\n几时淮浦月？\n仍与共扬舲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣怀","author":"范梈","text":"柳影侵门暗，桃枝亚竹高。\n年深诗并进，春在酒争豪。\n吏隐嗟何择，行藏信所遭。\n斯文如未丧，端合付吾曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过西芹","author":"范梈","text":"路隐岩崖迥，桥通屋舍重。\n鸟啼黄叶寺，泉注白云峰。\n市贩赊柑柿，畲耕间竹松。\n行人报山郡，失喜问萍踪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延平江阁","author":"范梈","text":"山势包平险，津流合众源。\n讵知从事剑？\n不类大夫魂。\n光彩潜犹见，精忠死尚存。\n幽灵如可问，吾意岂忘言？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉同廉访使君洎寮友游爱同寺","author":"范梈","text":"闽粤古城东，千岩半梵宫。\n冒寒寻水石，尽日倚虚空。\n钟鼓何须急？\n壶觞亦有终。\n翩翩北海寺，碑版翠无穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武夷杜征君","author":"范梈","text":"洞居清隐士，时接武夷君。\n旆影岩前见，山香石上闻。\n不为圭组累，焉有市朝分？\n暂得同麋鹿，终朝试与群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月节日，上宝历寺行礼，退述事","author":"范梈","text":"朝参不见承明庐，梦想三更尚是初。\n窅窅重山遮列炬，泠泠流水逐行车。\n柴关响接群僧磬，草泽心驰上帝居。\n圣寿延长天广大，固应涵养及樵渔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚经皮使君江居不见，赋简二首 其一","author":"范梈","text":"使君直节更无双，又拜浓恩出海邦。\n绝域朱幡兼皂盖，名园碧树倚清江。\n山明残雪当松坞，岸断斜晖射石矼。\n愧杀会稽王子敬，过门未遂此心降。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚经皮使君江居不见，赋简二首 其二","author":"范梈","text":"忆得去年寻药圃，甚怜此日负花时。\n拿舟况说看灯及，叩阁应烦把酒思。\n浩浩古今奚我独？\n悠悠江海是吾师。\n西墙倘遂残年愿，来往风流或可期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松湖渡亭子夕眺，怀西山朱炼师","author":"范梈","text":"不解无愁祇遣愁，凭高试看水东流。\n一天鹭影摩仙阙，两岸蝉声送客舟。\n肯信先生居锦里，不将夫子敬丹丘。\n如闻旧按蓬莱节，松下时时省钓游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题阮茂材诗卷","author":"范梈","text":"炳炳人间阮嗣宗，能诗飞动每愁侬。\n九霄丽日开鸣凤，六月深渊起卧龙。\n前辈文章工祖述，后生师友系遭逢。\n一编欲返明珠寄，宝匣看君不敢封。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠熊处士还山房","author":"范梈","text":"尚书旧隐在匡庐，乱后传闻宅已墟。\n祠宇祇今谁荐鞠，鬼神犹自护遗书。\n石泉宛宛输池细，川树茫茫映日疏。\n不识海昏熊处士，冥栖消息近何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠傅汝砺北游","author":"范梈","text":"十年身不到瀛洲，江上逢君又素秋。\n行李祇今何处在？\n看花须及俊年游。\n沧波远去浮三坞，白日高悬照九州。\n大旱若将敷说命，贤良记取旧弓裘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠熊文学","author":"范梈","text":"江东阀阅冠群伦，多士如君复几人？\n庠序弦歌时雨润，庙堂俎豆德风淳。\n尝因矫举思鸿鹄，何幸升平睹凤麟？\n黄叶蓟门寒色早，伫看天上紫泥新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送马掾迁湖南","author":"范梈","text":"闻君暂与故交违，去逐西风落叶飞。\n看剑未成今夕会，拿舟定复几时归。\n云开帝子黄陵庙，月过将军赤壁矶。\n事业还须各努力，收名即用绣为衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月二十日晚，试院得雨，次时作","author":"范梈","text":"彤廷下诏简贤良，大府新开艺战场。\n一道风雷严号令，九霄星斗焕文章。\n求材正合隆天爵，发策应当急岁荒。\n昨夜雨声传数点，争烧银烛待新凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠李宣使","author":"范梈","text":"故园云卧四三年，府署依然念子贤。\n莫为驰驱伤远道，但将忠孝感皇天。\n湖南政誉闻争荐，日下丝纶伫近传。\n为报津头黄菊蕊，明当照我上江船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大明殿退朝","author":"范梈","text":"晓星寥落动晴霄，双阙香烟近眼飘。\n警跸西来天影近，衣冠北上海光摇。\n间因正笏知春漏，忽报箫声押昼朝。\n忝后词人虽寡陋，极知圣主体轩尧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清宴奉教","author":"范梈","text":"日上高城烟雾多，玉箫前路散鸣珂。\n开筵迥出清川上，对酒其如绿树何！\n南极有星朝玉阙，中天佳气掖銮坡。\n长年不负经纶寄，愿及昌时养太和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月十六日诣东华门奉迎香舆","author":"范梈","text":"天香晓报出宫城，已办隅头合乐迎。\n黄鸟低斜冲队过，紫骝疏荡著班行。\n百王盛祀无遗典，万乘深居有至情。\n失喜快传汤沐赐，礼官识姓未知名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"礼成，还斋宫","author":"范梈","text":"九重雅有舜仪刑，犹遣精神接杳冥。\n朱户瞻星扶帝座，清天分月下斋庭。\n周旋宛若羹墙见，荐祼遥闻黍稷馨。\n归舍何人发新咏？\n郤兼鸣佩两边听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至夏庄怀平坡旧游","author":"范梈","text":"平坡谷前桃杏花，年时著屐到君家。\n祇今可买惟村酒，无复能来试石茶。\n帘幕高高通紫燕，溪流款款伏青蛇。\n同游昨有虞公子，却为卢郎得浪誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠王主事如上都","author":"范梈","text":"天官幕府盛诸卿，又从皇舆赴上京。\n邂逅同为远道客，比邻犹有故乡情。\n秋风响近弹琴峡，夜月悬当直斗城。\n须记今年上马日，菖蒲杯里试长生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长春瓢，奉同夏、杨二编修为九宫道人作","author":"范梈","text":"妙绝新亭九宫下，似杯非杓异山罍。\n昔从树杪泠风去，今向天边洒雨来。\n芥子量应容宇宙，黍珠境不外楼台。\n从师斟酌行藏事，小阅冥灵一万回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送梁知事之婺州","author":"范梈","text":"皓月青云若个边，送行恨不共吴船。\n新官浙下皆名郡，旧宅山东有赐田。\n礼乐固应张盛代，簿书勿用叹流年。\n经时不见曹员外，今日因君重惘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追和卢修撰张平章园亭观花饮","author":"范梈","text":"白藕花边香已秋，西郊风物野亭幽。\n未须短杖扶持病，且遣孤尊断送愁。\n紫气近连飞凤阙，青山遥隔钓鱼舟。\n胜游纵在招要外，犹解因诗颂醉侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其一","author":"范梈","text":"古蓟城边白露零，秋声不任旅人听。\n差差乳燕朝辞舍，呖呖高鸿暮过庭。\n以病酬閒翻自恶，将愁抵醉祇难醒。\n何人解拟匡庐赋，千仞冈头瀑泻瓴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其二","author":"范梈","text":"将身跳出市间壶，美贾由来不用沽。\n大地骑鹏须共化，中宵上鸐倩谁扶？\n庶几未老投簪去，尚可长生折简呼。\n此辈终非尘土物，明朝种橘学诸苏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其三","author":"范梈","text":"生也无涯死有涯，抛书几拟问南华。\n要知立志非多事，但使成言自一家。\n寒树接天霜映鹘，湿芜满地雨生蛙。\n相过傥遂携尊酒，检按墙东野菊花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其四","author":"范梈","text":"迥无江左管夷吾，谁复能称晋宋书。\n运本关天聊尔耳，力能盖世复奚欤。\n百年草草云龙地，四海悠悠法象庐。\n曾向钟山酹芳草，至今心死及菑畬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其五","author":"范梈","text":"流落移家白帝都，低头愧尽马相如。\n题桥一字终何益，卖赋千金竟或无。\n风月长留前辈咏，尘沙满载古人书。\n此身泛寄空江上，已异当时旧鬓须。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其六","author":"范梈","text":"浮世有由虚尺寸，明时无伎答涓埃。\n偶随青琐须高步，欲缀丹书甚寡才。\n断壁云过溪笛逝，虚林雨映寺钟来。\n几年闲却持螯手？\n强为清秋送酒杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其七","author":"范梈","text":"潘公墙角树连庭，曾是笙簧昼夜听。\n门巷祇今埋粪壤，轮蹄自昔走雷霆。\n长因午睡思茶灶，却为朝吟款竹扃。\n若续济南名士录，莫令憔悴鹊湖亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其八","author":"范梈","text":"李侯高朗若空晴，议论诗书满腹撑。\n期接仙舟应少便，偶分宫砚亦多情。\n蛮荒异俗中年历，河汉频秋向夕倾。\n此去暂烦南郡守，旗旄勿用野人惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其九","author":"范梈","text":"浦君高价本璠玙，多幸蒹葭得所于。\n学道初轻千里骥，收功直到九州鱼。\n诗探饭颗尤难测，赋拟兰陵定不虚。\n月月西垣更夜直，还应共我惜居诸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日集咏奉和潘李二使君浦编修诸公十首 其十","author":"范梈","text":"秋入江山锦绣开，白云红叶尽诗才。\n句成底用三年得，槎在应须八月回。\n自是每为浮客累，非关不受故人催。\n凭将寄语词林老，风雨重阳又近来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送白无咎太守之郡","author":"范梈","text":"潇洒中书旧省郎，排云曾揽舜衣裳。\n一麾况复守名郡，万事不如归故乡。\n马首渐违燕阙雨，雁声欲度晋城霜。\n汉廷择相皆良吏，早奉潘舆谒建章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉同陈应奉访友人不遇","author":"范梈","text":"翰林小暇出西城，京国馀秋晚更明。\n鸥度折矶心已熟，马逢危石眼偏生。\n疾风稍定楼台色，微照犹含鼓角声。\n会合何因得惆怅，潜夫祇愧未潜名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐，有怀舍弟在江右，别来凡阅九冬至矣","author":"范梈","text":"天边此夜逢冬至，江表频年望客还。\n谬戴词林深雨露，却怜棣萼远河山。\n周流本已违长策，趋走那堪益厚颜？\n何日求田归计定？\n一尊松下咏间关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄别倪大同","author":"范梈","text":"知君久住玉真坛，日与飞仙弄紫环。\n从此便令行地缩，逢谁不说上天难。\n鹤边红日浮觞送，马首青山抱檄看。\n相好何因不相别，寄诗应到暮云端。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"将赴雷阳送罗提举之任广东","author":"范梈","text":"松滋暂泊蓟门船，复指番阳路几千。\n茉莉香深和酒露，桄榔叶暗煮盐烟。\n齐人旧算无遗策，汉史新藏有剩钱。\n莫为遐荒心力怠，珠崖更在海南边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"休日出郊三首 其一","author":"范梈","text":"上方钟鼓昼依稀，出定诸僧绾法衣。\n迎客犹能下殿走，访人更有待寻归。\n秃鹙近水行仍啄，危燕当梁乳更飞。\n自古旅怀烦慰藉，并游万事莫相违。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"休日出郊三首 其二","author":"范梈","text":"丞相祠西椰子园，新开湖馆见遥村。\n风含碎羽珊珊过，浪涌长干剡剡翻。\n止息幸然无鹤爵，去来应或有鹏鹍。\n江边柳树晴相倚，祇为行人作断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"休日出郊","author":"范梈","text":"歇马高林烟雾开，感今怀古独登台。\n迁臣逐客皆前辈，幕长郎官尽上才。\n放浪已闻穷九域，飞腾终合近三台。\n谢公自有青云屐，且与从容步紫苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄友人","author":"范梈","text":"绣衣行部直南州，幕府英名早岁收。\n如此一台兼二妙，令人万里破千愁。\n桄榔叶暗潮声暮，薜荔花悬岳影秋。\n此去三湘宁久住，近天须应玺书求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题燕山佥事彩绣堂","author":"范梈","text":"海康城下白云飞，南部观风使者归。\n督郡须持直指斧，历阶尚挂老莱衣。\n高堂见月思丹檄，远路逢春忆翠微。\n赖有胜流词翰在，定随华榜照林扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠余使君致仕还江东","author":"范梈","text":"九华山下女萝丛，使者旌旗发粤中。\n昔至本膺丹诏重，今归惟颂白头公。\n百年自喜行藏定，千里何当语笑同？\n门口侍船应有待，大江西即大江东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]