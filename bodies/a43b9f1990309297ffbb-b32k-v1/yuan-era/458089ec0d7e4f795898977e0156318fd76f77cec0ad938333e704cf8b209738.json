[{"title":"浣溪沙 赠药赵仙","author":"马钰","text":"一志投玄绝利名。\n二无尘事气神清。\n三光攒聚永安宁。\n四序不分真造化，五般霞彩结成形。\n六铢衣挂鹤来迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠赵公","author":"马钰","text":"万种全般教得人。\n怎生教你绝心尘。\n悟来方可得良因。\n怕死自然恩爱断，忘机决定气神淳。\n无为清净合天真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠郝先生","author":"马钰","text":"大悟浮生不恋家。\n大乘体调不奢华。\n大通玄妙不矜夸。\n大德建修真活计，大丹烹炼好生涯。\n大丹成就步烟霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠堂下道人","author":"马钰","text":"舍了家缘更舍身。\n即非喂虎济饥鹰。\n幻躯识破自忘形。\n无耻无羞无染著，逍遥坦荡气神清。\n心中真佛现光明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠堂下道人","author":"马钰","text":"闲是闲非不可听。\n那堪日日自谈论。\n暗伤功行损氤氲。\n舌是祸根牢锁闭，寻常省启祸之门。\n自然性命得长存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠堂下道人","author":"马钰","text":"意恶心顽烟火生。\n口张舌举是非生。\n伤人害己过潜生。\n辩者自然为不善，善人不辩善芽生。\n无争上士得长生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠清风散人明月散人","author":"马钰","text":"炼到无心正用功。\n玉堂深处弄清风。\n倒颠颠倒结殷红。\n万派寒泉枯药鼎，一轮明月出圭峰。\n本来面目赴仙宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠阎先生","author":"马钰","text":"舍了荣华物外居。\n的端妙处用功夫。\n坎离宫内弄清虚。\n猛虎口中调玉齿，骊龙颔下夺神珠。\n这般手段称吾徒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠解刘仙","author":"马钰","text":"奉劝须看清静经。\n脱仙模子好搜寻。\n湛然常寂理幽深。\n常处真常常应物，自然无欲亦无心。\n运行日月作知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"真欢乐 继重阳韵","author":"马钰","text":"酒色气财关远钥。\n事务简、当而略。\n方堪可、水里寻金，固元初、修持仙药。\n锻炼须教明更灼。\n祥烟自然磅礴。\n这个好功夫，并无些为作。\n昏昏默默无依托。\n湛澄中，有期约。\n真消息、只在灵台，对云霞、琼林花萼。\n灿烂光辉真渐烁。\n性灵灵、有何佳作。\n阐大道清吟，显清欢清乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离苦海 本名离别难谨继重阳师父韵","author":"马钰","text":"缘遇离苦海，修真寂真寥。\n向真风里捉真飙。\n种琪瑶真真，瑞满青霄。\n引真个玉兔，真个金难，自是能消。\n更收聚真龙真虎，缭绕真象肯偏饶。\n真恍惚，直彰昭。\n见真婴真姹相招。\n访真离真坎真处，要真真相济服灵苗。\n忽结亘古真容，因真清净，功力和调。\n蓬岛去，拜礼重阳师父，永逍遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莫思乡 继重阳韵","author":"马钰","text":"意马下功收。\n不放心猿暂出头。\n一点灵明归太素，何求。\n通六幽微罢运筹。\n芋栗更闲搜。\n知味闻香识破□。\n须向空中寻响亮，无休。\n真乐真欢散尽愁。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"调笑令","author":"马钰","text":"山峭。\n彩霞照。\n一颗神珠常吐耀。\n无穷瑞气长笼罩。\n更有祥烟袅袅。\n三清专遣青童诏。\n报道无为功要。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"调笑令 和师韵赠张马二公","author":"马钰","text":"调笑。\n论微妙。\n月内银蟾端千跳。\n中宵日里金鸡叫。\n坎虎离龙围绕。\n忽然撞著姹婴召。\n共守丹炉了了。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"谭仙通正。\n悟彻长真修玉性。\n马钰山侗。\n豁豁洋洋似害风。\n刘仙通妙。\n把握长生真了了。\n通密丘仙。\n修养长春不夜天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"诗词作孽。\n妨我清闲仙举业。\n猛悟心惊。\n如向深渊履薄冰。\n便疏笔砚。\n却与气神相眷恋。\n懒里寻慵。\n无作无为是马风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"山侗马钰。\n学道宜乎除爱欲。\n却殢诗词。\n怎得功成现紫微。\n如何猛悟。\n减字木兰花里诉。\n百拜诗魔。\n休似从前返倒何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"丘刘谭马。\n幸遇风仙亲教化。\n一别山东。\n云水秦川兴不穷。\n清贫快乐。\n自在逍遥无做作。\n清净门庭。\n阐出家风合圣经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"丘仙通密。\n隐迹磻溪人不识。\n通妙刘仙。\n永住终南屏万缘。\n谭仙通正。\n志在清贫修大定。\n三髻山侗。\n愿处环墙也放慵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花","author":"马钰","text":"处端通正。\n道号长真真上认。\n自在逍遥。\n摵碎岩前汲水瓢。\n处玄通妙。\n道号长生真了了。\n慎勿先归。\n且伴长春丘处机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花 过静远镇","author":"马钰","text":"兵辱我。\n戟丛中谁解祸。\n辩如锋。\n木和同是夏公。\n今清脱。\n兔日乌同作活。\n底然香。\n谢恩人鱼鼓张。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花 别南京拆字","author":"马钰","text":"今拜别。\n住逍遥金玉宅。\n处门开。\n里人人不复来。\n金成宝。\n脉婴儿擎玛瑙。\n与山侗。\n去蓬瀛礼吕公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花 赠徐玄之","author":"马钰","text":"神翁苗裔。\n骨格非凡人怎比。\n猛舍家缘。\n物外搜寻玄上玄。\n天长地久。\n走玉飞金常在手。\n营养黄芽。\n道号从今称碧霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"减字木兰花 赠烟霞散人","author":"马钰","text":"谪仙猛悟。\n富贵荣华都不顾。\n改变衣装。\n道服云包傲带长。\n擒猿捉马。\n不骋容仪多娅姹。\n玉性无尘。\n相称烟霞一散人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"步蟾宫","author":"马钰","text":"清清净净祥云脚。\n九窍内、往来交错。\n谁知妙用缘无作，自然理炼成丹药。\n骊龙吐出神珠烁。\n现万道霞光罩却。\n虚堂莹彻添光灼，蓬莱路、有些期约。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惜芳时 赠李官人","author":"马钰","text":"伊子癸卯同生世，不觉流年五十二。\n我先入道搜玄理。\n自然不敢相遗你。\n无分昼夜常留意。\n诗曲谩书千幅纸。\n劝公早把家缘弃。\n免交失脚黄泉底。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惜黄花 和师韵赠长安范公","author":"马钰","text":"弃财戒酒。\n药囊系肘。\n常清静，便把虎龙引逗。\n心起大慈悲，人人尽欲救。\n化愚迷、诗词如咒。\n休要攀花柳。\n速修神秀。\n玉壶中，有个自然红狗。\n日日吠青霄，谁知合著口。\n更披云、能飞解走。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"探春令 赠王知玄","author":"马钰","text":"洞天几阵清清雨。\n遥指琼林堪睹。\n一条玉杖，随行探得，性内金莲吐。\n婴娇女姹来相聚。\n更有真龙虎。\n自然显出，祥光覆载，一个灵明主。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，独自赏元宵。\n剔正命灯胜白昼，放开心月透青霄。\n掌握紫芝苗。\n金童舞，玉女更吹箫。\n酒饮琼浆虽是美，有些闲事不逍遥。\n惟恨少知交。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"修大道，何必住深山。\n混俗和光都看破，万千尘冗不相干。\n别有一般般。\n马风子，闲里更寻闲。\n见个木牛哮吼走，路逢石女笑痴顽。\n喝去入长安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，创置屋三间。\n动土兴工经一载，杀伤虫蚁命须还。\n死堕鬼门关。\n错中错，追悔亦应难。\n造下业缘须受苦，刀山剑树定跻攀。\n怎得列仙班。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，忽想在家时。\n火院熬煎无限苦，心惊胆战哭声悲。\n悔恨出离迟。\n号啕罢，感谢我真师。\n钓出凡笼修不二，逍遥自在处玄机。\n有分看瑶池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，业障忒愚顽。\n不认洞天真供养，却迷俗礼假修完。\n心意怎清闲。\n著外境，欲要塑师颜。\n建塔修堂并立石，不思施主出钱难。\n罪业积成山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"外颠倒，爱欲似冤雠。\n富贵荣华都不顾，人情浓处急抽头。\n物外做持修。\n内颠倒，真火戏清流。\n六月降霜麻麦秀，三冬时雨润丹丘。\n云步访瀛洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，昔日在迷津。\n寻个出期真没计，欲知山上路儿真。\n须问去来人。\n风仙至，端的话良因。\n指我一条真捷径，无差无错越红尘。\n昼夜感师恩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"寻大道，不在路迢迢。\n云水清闲真自在，姹婴相伴做逍遥。\n此理有谁消。\n马风子，悟彻十分乔。\n两脚轻狂街上舞，往来独许弄风飙。\n明月杖头挑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱","author":"马钰","text":"马风子，因遇弃荣华。\n乞觅残馀为活计，真清真净做生涯。\n烹炼白朱砂。\n人莫笑。\n一志实堪夸。\n大道朝闻甘夕死，水清玉洁绝纤瑕。\n不敢辱师家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 九日吟","author":"马钰","text":"酬佳节，争赏菊花忙。\n尽说陶潜深得趣，孟嘉落帽兴偏长。\n终久落空亡。\n马风子，别有好风光。\n阳里养阳阳养处，水牛牵向牧牛场。\n永永庆重阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 八日","author":"马钰","text":"来朝九，今日访龙山。\n预赏黄花先落帽，免教郑谷叹多端。\n终要久长难。\n马风子，别话一般般。\n性结重阳花馥郁，万年千载不凋残。\n永永有馀欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 十七首首化姚玹","author":"马钰","text":"破故纸，缀袄可防风。\n坐卧不愁寒水石，雪中敢采麦门冬。\n从此得苁蓉。\n浪荡子，常有自然铜。\n鼎内朱砂烹炼就，天仙子入白云中。\n蝉壳显山侗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 十日吟","author":"马钰","text":"今朝菊，人见意阑珊。\n只是秋香经一夜，致令郑谷叹多端。\n终要久长难。\n马风子，别有一般般。\n万顷白云知去处，金莲花朵不教残。\n永永道人欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 罗公上树隔环墙乞词","author":"马钰","text":"马风子，不悟坏修行。\n虽在环墙居处稳，诗词引出假声名。\n惹得不安宁。\n夸伶俐，却是不惺惺。\n自愧隐身身不密，空成潦倒白头生。\n怎得赴蓬瀛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 春日□县道友索","author":"马钰","text":"真消息，律管定春期。\n应候土牛先击碎，芒儿闲散独何之。\n此理有谁知。\n马风子，凭仗做修持。\n恰到人牛俱不见，澄澄湛湛入无为。\n正是月明时。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 闻蝉","author":"马钰","text":"秋蝉噪，声细又声长。\n饮罢餐风声不困，声声都了显行藏。\n使我起凄惶。\n堪嗟叹，模样是蜣螂。\n尚自超然蝉退去，为人宁忍昧三光。\n急急养铅霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 继重阳韵","author":"马钰","text":"通真九，通真九，个内下功裁。\n便使龙蛇腾地去，却教云鹤下天来。\n晨看暮潮回。\n白莲绽，白莲绽，自有碧莲开。\n清净门中通出入，无为路上免抟猜。\n定是到蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望蓬莱 道友修庵","author":"马钰","text":"丘与马，入道绝贪求。\n欲报师恩常念念，三年守服岂能休。\n何处好藏头。\n旧居址，深谢许同修。\n但愿我公同我志，同心同德做同流。\n同步访瀛洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花引 赠白先生","author":"马钰","text":"脱尘子。\n逃生死。\n物外逍遥云水似。\n起真慈。\n起真慈。\n暗助真功，常常得自知。\n逗引蛟龙归虎兕。\n水里灯光明久视。\n结灵芝。\n结灵芝。\n携去蓬瀛，专专献我师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花引 赠众师兄","author":"马钰","text":"子端提。\n龙蟠虎。\n莫使马猿偷眼睹。\n气神苏。\n气神苏。\n海底灵龟，依从鼻吸呼。\n女姹婴娇云里聚。\n欲赴蓬瀛路上去。\n炼江湖。\n炼江湖。\n结就金丹，方知玉性孤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花引 赠老李先生","author":"马钰","text":"怎分晓。\n迷虚矫。\n爱恋家缘何日了。\n著尘嚣。\n著尘嚣。\n铁做人人，遭他火院销。\n猛悟无常非事小。\n跳出凡笼搜密妙。\n乐逍遥。\n乐逍遥。\n坎虎离龙，降来入玉瓢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"添字丑奴儿","author":"马钰","text":"悟来修炼身中宝，不骋髯掀。\n唯喜沉烟。\n施布仁风无党偏。\n愿心坚。\n劝人识破浮生梦，恋甚华轩。\n更不观帘。\n随我扶摇入洞天。\n做神仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"添字丑奴儿","author":"马钰","text":"世人个个便宜爱，争要便宜。\n半使心机