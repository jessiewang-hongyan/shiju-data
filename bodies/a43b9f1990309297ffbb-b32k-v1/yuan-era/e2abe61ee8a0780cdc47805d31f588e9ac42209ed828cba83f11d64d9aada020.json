pointer":13622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题岩门","author":"尹廷高","text":"嵌空元不费敲推，弹指能令铁锁开。\n莫学寒山避人去，千年岩缝合苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"欧阳希古读书楼","author":"尹廷高","text":"道上红尘利欲乡，天风吹下韵琅琅。\n阑干四面秋声起，一晕青灯夜正长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赞达摩画像","author":"尹廷高","text":"莫听番僧说是非，滔滔流水不西归。\n自从拆断茎芦后，白浪翻天无了时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋天窗","author":"尹廷高","text":"玉片鳞鳞月一方，能于暗室泄天光。\n有时急雨敲诗梦，尚带波涛海气香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北关买舟","author":"尹廷高","text":"北关门外柳青青，闲寄江南第一程。\n别酒未阑山鸟唱，短篷撑梦过临平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前村晚泊","author":"尹廷高","text":"清晨买饭鲈鱼市，薄暮停舟杜宇村。\n更有浮家江海客，一生蓬底长儿孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姑苏台","author":"尹廷高","text":"姑苏台下水茫茫，麋鹿不来春草长。\n柳外阑干谁独倚，玉箫吹怨满斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"馆娃宫","author":"尹廷高","text":"金绣鸳鸯绿锦裀，水精帘底净无尘。\n君王醉枕香红软，人隔重江正卧薪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒山寺","author":"尹廷高","text":"路接枫桥一径通，渔郎遥荅隔河舂。\n自从夜禁行人绝，不信乌啼城外钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惠山泉","author":"尹廷高","text":"石乱香甘凝不流，何人品第到茶瓯。\n可能一勺长安水，瞒得文饶老舌头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常州","author":"尹廷高","text":"百万西来势莫撄，孤危甘死战尘腥。\n欲询往事无遗老，日暮城头鬼火青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"甘露寺","author":"尹廷高","text":"宝阁高横玉宇寒，分明脚底踏焦山。\n长淮渺渺三千里，祇在僧窗一榻间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中冷泉","author":"尹廷高","text":"衮衮鱼龙浪气腥，江心何处认中灵。\n茶边滋味人知少，世上空疑陆羽经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扬州后土祠琼花","author":"尹廷高","text":"无双亭下万人看，欲觅残英一片难。\n夜静月明猿鹤唳，误翻玉雪堕阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山阳泊舟","author":"尹廷高","text":"南枕湖光北枕淮，百年形势画图开。\n黄昏鼓角孤城闭，尚记秋风万马来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟过彭城","author":"尹廷高","text":"黄河三面绕城流，云压荒台冷不收。\n千古英雄只如此，手遮斜日看徐州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城夏日","author":"尹廷高","text":"燕去楼空事已非，柱头白鹤昔曾归。\n彭门五月薰风起，夹道椿花似雪飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山九日","author":"尹廷高","text":"老气横吞万里秋，不堪白发对人羞。\n一枝黄菊无情极，冷看西风捲客愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山寒二首 其一","author":"尹廷高","text":"地穴玲珑石炭红，土床芦簟觉春融。\n一窗明月江南梦，恍在重帘暖閤中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山寒二首 其二","author":"尹廷高","text":"孤鸿破晓雪霏霏，起整归装莫悔迟。\n幸有北风能逐客，山灵不用费文移。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出都门","author":"尹廷高","text":"都门晓出兴悠悠，一片归心逐海鸥。\n马上不吟风雪句，扬鞭指塔认通州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中夜兴","author":"尹廷高","text":"枯苇萧萧搅客眠，夜深灯火照邻船。\n□□□□□□□，风雪蓬窗万里天。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊舟淮阳","author":"尹廷高","text":"孤舟夜泊倚皇城，天际归心促晓程。\n二十四桥霜月冷，卧听钟鼓送人行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北归渡扬子","author":"尹廷高","text":"狠石年深已绿苔，金焦千古画图开。\n浪花半角残阳里，曾见乾坤百战来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四瑞名山古佛","author":"尹廷高","text":"琉璃光里人间晓，俨若灵山未散时。\n不是青衣轻漏泄，个中消息有谁知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"圣钟","author":"尹廷高","text":"千夫赤手缚渊龙，俄听洪音吼梵宫。\n醉衲不回消息断，高楼残月五更钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观音石","author":"尹廷高","text":"磨尽当年杀气醒，石间髣髴见珠缨。\n自从放下屠刀后，江上寒潮几度生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莲经放光","author":"尹廷高","text":"七卷流传自李唐，夜深古纸发光芒。\n高人宴坐都无见，寂寂中庭月一方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宣仁太后遗像","author":"尹廷高","text":"谤史欺天祗自欺，母能改子更何疑。\n女中今识真尧舜，愁绝年年社饭时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]