[{"title":"客星阁","author":"尹廷高","text":"万古严滩万古清，秋风杜若老寒汀。\n一江斗宿沉天影，那个中间是客星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中中秋无酒","author":"尹廷高","text":"丹桂飘香玉宇清，笛声隐隐度江城。\n客楼醒眼看明月，虚负天风吹晚晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书斋即事","author":"尹廷高","text":"看了床头半日书，闲眠欲下静工夫。\n女童学画宫妆额，偷抹窗前点易朱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"见一人家以书叶糊窗读之乃张巡传因戏题","author":"尹廷高","text":"坐守睢阳当豹关，江淮赖此得全安。\n至今青史虽零落，犹障窗风一面寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏菊","author":"尹廷高","text":"渊明贪卧北窗凉，篱下无心为发扬。\n开向薰风根种别，不知晚节有重阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中秋社","author":"尹廷高","text":"社日伤心在客中，凄然涕泪落秋风。\n故乡田土荒芜尽，枉向他州说岁丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"翁村思归","author":"尹廷高","text":"一年归计又蹉跎，落尽梨花春不多。\n昨夜翠微深处宿，月明无奈子规何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发信安","author":"尹廷高","text":"卧忆家山意转迷，十年踪迹几东西。\n出门无限阳关思，月落孤城鸡乱啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒先君墓","author":"尹廷高","text":"十载流离东复西，岁时霜露独凄凄。\n子规似识终天恨，飞上松梢尽日啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送无外僧弟归奉庐墓二首 其一","author":"尹廷高","text":"石田茅屋且随宜，更种梅花满翠微。\n诵罢楞伽清磬歇，倚松闲看白云归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送无外僧弟归奉庐墓二首 其二","author":"尹廷高","text":"踏遍名山眼界宽，归闲且得一身安。\n泥牛入海无消息，万壑千嵓空翠寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕云寮即事三首 其一","author":"尹廷高","text":"避风自笑学鶢鶋，别买青山结草庐。\n幸有薄田可饘粥，闭门且读旧时书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕云寮即事三首 其二","author":"尹廷高","text":"石板桥连白竹扉，云深转觉俗尘稀。\n静中看尽天机动，木落寒塘水鸟飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕云寮即事三首 其三","author":"尹廷高","text":"松风远觉瀑声来，池畔明窗对竹开。\n睡醒方知凉是雨，凤仙花落满苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"叶法善天师故宅茅山","author":"尹廷高","text":"云间玉笛夜飞霜，宫府清虚翠色凉。\n淫乐早知能乱国，月宫不遣奏霓裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"项羽","author":"尹廷高","text":"多疑难逞拔山雄，失道阴陵计已穷。\n更恐舣舟人见绐，不缘无面见江东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"范增","author":"尹廷高","text":"毕竟知人愧酂侯，数公仗剑自归刘。\n腹心牙爪皆资敌，一老如何佐沐猴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"靖康北狩","author":"尹廷高","text":"舟楫江南方运石，兵车漠北又通金。\n唤回艮岳游仙梦，五国城中夜雪深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚归道中","author":"尹廷高","text":"落日蒸烟起乱山，烟光山色有无间。\n一绷水墨无人识，分付归鸦自带还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昭君二首 其一","author":"尹廷高","text":"身落天涯恨未平，昏昏漠月度龙城。\n琵琶马上千年意，只有诗人画得成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昭君二首 其二","author":"尹廷高","text":"草色犹能白变青，怪渠妍丑一毫争。\n自缘谋国无长策，枉使毛生受恶名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金山怀古","author":"尹廷高","text":"元公当日好机锋，问倒眉山犊眼翁。\n玉带围腰谁缚汝，一场公案笑谈中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞允文拒完颜亮","author":"尹廷高","text":"金甲红旗已瞰江，车船三绕势俄张。\n立功反出毛锥子，愧死酒中刘四厢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庚子营又青旧业四首 其一","author":"尹廷高","text":"二十年前此战场，隔溪野燐尚凄凉。\n儿童生长他山久，却把家乡作客乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庚子营又青旧业四首 其二","author":"尹廷高","text":"谁识当年老令威，去家千载尚知归。\n交游散尽邻人少，只有诸峰绕四围。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7