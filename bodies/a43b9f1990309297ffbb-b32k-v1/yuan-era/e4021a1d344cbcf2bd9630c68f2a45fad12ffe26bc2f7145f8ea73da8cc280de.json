[{"title":"野宿 其二","author":"耶律铸","text":"北风作恶晚犹寒，征雁一声云汉閒。\n归梦暗随天际月，清辉皎洁满关山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马上偶得","author":"耶律铸","text":"谁念天涯久倦游，可堪回首又惊秋。\n登高极目莫云碧，衰草荒山不尽头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中吟 其一","author":"耶律铸","text":"旅怀夜永梦偏饶，明灭残灯独自挑。\n云外五更征雁尽，帐寒风冷雨潇潇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中吟 其二","author":"耶律铸","text":"白雁飞晴秋夜长，玉兰黄菊傲寒霜。\n寸心万里云山梦，一日三秋铁石肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中吟 其三","author":"耶律铸","text":"万里故人寒旧盟，一尊薄酒正含情。\n梦回星斗阑干夜，肠断西风征雁声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中次人韵","author":"耶律铸","text":"塞鸿飞尽野云收，羌笛悠悠漳水秋。\n有客北来归未得，倚门长啸看吴钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中次郭器之诗韵","author":"耶律铸","text":"典尽征衣出醉乡，一回头处九回肠。\n黄花满地秋风老，坐数飞鸿到夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中二首 其一","author":"耶律铸","text":"几度求归不放休，翩翩蝴蝶思悠悠。\n梦回三径黄花老，题遍一林红叶秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中二首 其二","author":"耶律铸","text":"咽咽霜笳吹底怨，泠泠山溜泻何愁。\n和林望断白云莫，愁入水云东尽头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苍官台","author":"耶律铸","text":"层台重到记登临，物态熙熙春意深。\n手抚长松望西北，晚云千顷似归心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山台","author":"耶律铸","text":"诘曲千层近碧霄，苍松无数绕山腰。\n何当一值炎天候，卧听风涛吼夜潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铜雀台","author":"耶律铸","text":"铜雀台荒野草花，阿瞒无复示雄誇。\n愁烟忍锁西陵地，向日须曾属汉家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸卯春莫经驻跸院废殿","author":"耶律铸","text":"野粉不留天日表，梦回龙去鼎湖空。\n东君若是繁华主，满院落英何处风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经丽珍园卫绍王兰香殿故基","author":"耶律铸","text":"国橐危时足藉辞，国香消歇自当时。\n教人普结司花恨，恨不留心植佞枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游玉泉山废宫故基口号","author":"耶律铸","text":"殿阁人稀树草荒，旧游空记五云乡。\n劫前天地兴亡梦，借问山灵是几场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日游玉泉道院","author":"耶律铸","text":"露桃香汎冷胭脂，低映相思玉树枝。\n看取广寒宫殿去，涌金香汎月来时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莫春过故宫","author":"耶律铸","text":"柳陌风来雪满沙，锦宫春老野人家。\n莺莺燕燕空饶舌，明日西园自落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过庖丁故居","author":"耶律铸","text":"青山坐对幽人老，依旧春风绿庭草。\n骑鲸一去不再来，愁看落花曾未埽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过万松老人故居有感","author":"耶律铸","text":"忆埽香云谒上方，一天花雨扑禅床。\n云归雨敛香花冷，窣堵波沈替戾冈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过刘氏园","author":"耶律铸","text":"黄鸟含啼怨未休，露桃倾泪洗凝愁。\n多情好在今成燕，双宿双飞直到头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莫春过刘氏亭","author":"耶律铸","text":"垂垂帘箔映重门，不避贪飞燕子嗔。\n桃李晚来无藉在，乱随风雨并残春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太极宫","author":"耶律铸","text":"步虚声入海山寒，并觉空香绕露盘。\n天浸月波秋似水，翠鸾飞满玉华坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太和宫","author":"耶律铸","text":"故人心事鬓成丝，犹指颓垣语所思。\n元自道陵全盛日，见游麋鹿已多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过大明宫","author":"耶律铸","text":"草展荒凉辇路开，牡丹花谢已葑苔。\n苔钱不买春光住，枉了衔花鹿又来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"琼华岛","author":"耶律铸","text":"万岁山头万树松，万年基业一朝空。\n如何太液池中水，依旧罗纹起细风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重题燕都玄都观壁","author":"耶律铸","text":"兔葵燕麦尽风埃，何事消沈不再开。\n忆得桃花凝笑处，怨春愁篆满苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重题隗台玄都观壁","author":"耶律铸","text":"洞锁荒烟藉绿苔，桃花红尽更难开。\n刘郎依旧春风里，又到玄都观里来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游龙岩寺 其一","author":"耶律铸","text":"上方钟磬隔花闻，便觉仙凡势自分。\n争信草灵堂也笑，笑他猿鹤恋松云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游龙岩寺 其二","author":"耶律铸","text":"错落岩花是醉茵，景因人胜画难真。\n林泉盛迹幽栖地，谁分松云不恋人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"尝游北禅院鼓子花特盛邻观且有琵琶音后游其所赋此","author":"耶律铸","text":"鼓子花迷香世界，鼙婆声振玉楼台。\n郁轮袍竟销沈了，优钵昙空取次开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过怀来香山院","author":"耶律铸","text":"院染晴岚树染烟，锦屏花障抱斜川。\n不知日莫前途远，为爱青山忘著鞭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登吹台凝翠亭偶成","author":"耶律铸","text":"春逐花枝落酒杯，草随春色上高台。\n殷勤更把重帘捲，放入青天白日来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天津早春","author":"耶律铸","text":"玉京桃李待花仙，培养根芽又一年。\n春事动人应不浅，绿莎侵到水傍边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春宴上次高丽国使人诗韵","author":"耶律铸","text":"白玉堂前一树梅，为谁零落为谁开。\n人生颜色不常好，且尽生前有限杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉津池早春","author":"耶律铸","text":"嫩漪縠皱浴鸳鸯，信逐轻鸥下野塘。\n红入小桃花绽处，绿莎针短柳丝长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白莲池","author":"耶律铸","text":"翠扇平遮罨画楼，玉兰倾露避兰舟。\n何如解语花长在，花界长生殿里头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无尘亭","author":"耶律铸","text":"白莲自处无尘境，不惜香风隔岸闻。\n绝是冰纹珍簟下，水仙潜著水沈薰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题霏香亭","author":"耶律铸","text":"为延花事带香霏，弥月兼旬醉不归。\n休道未知今日是，当知四十九年非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","