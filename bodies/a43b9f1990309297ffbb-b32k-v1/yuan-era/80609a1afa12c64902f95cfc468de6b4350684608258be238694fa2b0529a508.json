repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其一","author":"傅若金","text":"河中日日水悠悠，谁道人心似水流。\n河水湾回有时直，人心屈曲几时休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其二","author":"傅若金","text":"朝朝风雨送船行，白日无晴夜有晴。\n东岸□灯西岸见，中间犹自不分明。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其三","author":"傅若金","text":"待船日日恨船迟，船头水声无断时。\n昨夜天清好新月，谁家学得画蛾眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其四","author":"傅若金","text":"攀柳莫攀当路柳，系船须系上风船。\n当路人行无好树，上风浪小得安眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其五","author":"傅若金","text":"去年船里逢端午，今年船里又端阳。\n九节菖蒲本仙药，如何曲曲似愁肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棹歌六首 其六","author":"傅若金","text":"宁向泥中弃莲子，莫向水上种桃花。\n莲子出泥终见藕，桃花随水不还家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"魏元君坛戏和陈彦高","author":"傅若金","text":"衡岳仙成只可闻，南昌何处觅夫君。\n邻儿狡似东方朔，偷得金桃不见分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"傅若金","text":"迢递云山隔远溪，微茫烟水带长堤。\n秋来木叶多摇落，日暮寒鸦不肯栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双燕图赠王惟中","author":"傅若金","text":"玄鸟飞时绿树春，湖南烟际往来频。\n明年社日君何处，逢著新巢忆故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题饮马图","author":"傅若金","text":"一斛寒泉照紫骝，萧萧骏尾动高秋。\n夜来枥上西风满，忆傍寒云饮陇头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简杨好问","author":"傅若金","text":"湖亭初得寄来诗，几度长吟恨别离。\n近日扁舟洞庭野，雨中多是忆君时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画松","author":"傅若金","text":"遥忆商颜松色青，女萝枝上醉眠醒。\n自从四皓安刘后，岁暮何人采茯苓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题松庵上人墨蒲桃二首 其一","author":"傅若金","text":"汉苑寻常露下时，月明高架影参差。\n上林近日无来使，肠断江南见一枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题松庵上人墨蒲桃二首 其二","author":"傅若金","text":"露颗含香近客衣，蜜蜂蝴蝶绕藤飞。\n夜来应值骊龙睡，探得明珠月下归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山家山景二首 其一","author":"傅若金","text":"万壑苍苍云气昏，石泉斜落古松根。\n前林欲暝僧归晚，应听钟声到寺门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山家山景二首 其二","author":"傅若金","text":"雁起秋空树色遥，行人江上驻归桡。\n海门东去应千里，白日微茫见落潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼亡四首 其一","author":"傅若金","text":"惊飙吹罗幕，明月照阶戺。\n春草忽不芳，秋兰亦同死。\n斯人蕴淑德，夙昔明诗礼。\n灵质奄独化，孤魂将安止。\n迢迢湘西山，湛湛江中水。\n水深有时极，山高有时已。\n忧思何能齐，日月从此始。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼亡四首 其二","author":"傅若金","text":"皇天平四时，白日一何遽。\n勤俭毕婚姻，新人忽复故。\n衾裳敛遗袭，棺椁无完具。\n送葬出北门，徘徊怛归路。\n玉颜不可恃，况乃纨与素。\n累累花下坟，郁郁茔西树。\n他人亮同此，胡为独哀慕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼亡四首 其三","author":"傅若金","text":"新婚誓偕老，恩义永且深。\n旦暮为夫妇，哀戚奄相寻。\n凉月烛西楼，悲风鸣北林。\n空帷奠巾栉，中房虚织纴。\n辞章馀婉娈，琴瑟有馀音。\n眷言瞻故物，恻怆内不任。\n岂无新人好，焉知谐我心。\n掩穴抚长暮，涕下沾衣襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼亡四首 其四","author":"傅若金","text":"人生贵有别，室家各有宜。\n贫贱远结婚，中心两不移。\n前日良宴会，今为死别离。\n亲戚各在前，临诀不成辞。\n傍人拭我泪，令我要裁悲。\n共尽固人理，谁能心勿思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感独","author":"傅若金","text":"幽幽蕙草晚，靡靡兰芳断。\n皎皎夜泉人，冥冥不复旦。\n流尘栖暗壁，凉吹经虚幔。\n无论欢意消，日复愁思乱。\n魂伤夕方永，气变秋将晏。\n当窗惨断素，捐箧悲柔翰。\n忆初成好合，誓且同忧患。\n何言遂长终，独处增永叹。\n寤寝忽如在，展转惊复散。\n念兹何嗟及，哀至聊自判。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百日","author":"傅若金","text":"人生悲死别，矧在心相知。\n新婚未及久，杳杳遽何之。\n昔为连理木，今为断肠枝。\n相去时几何？\n百日奄在兹。\n亏月有圆夕，逝永无还期。\n弃置非人情，何以为我思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"入室二首 其一","author":"傅若金","text":"妆阁闭长夜，幽兰坐复春。\n犹疑挑锦字，不见掩罗巾。\n故物空在目，萧条生网尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"入室二首 其二","author":"傅若金","text":"虚窗明月满，芳砌绿苔滋。\n花间时染翰，尚忆解题诗。\n寂寞幽泉下，贞心空自知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追和蕙兰二首 其一","author":"傅若金","text":"小窗开尽碧桃枝，忆得青鸾化去时。\n昨夜秋风妒幽怨，梦中吹断素琴丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追和蕙兰二首 其二","author":"傅若金","text":"江上愁时复值春，带围宽尽不宜身。\n阶前旧种樱桃树，日暮飞花故著人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"驾发","author":"傅若金","text":"天门晓启黄金锁，路马遥翻碧玉蹄。\n银烛荧荧花外出，翠蕤冉冉柳边迷。\n千官剑佩屯云合，五卫旌旗拥日齐。\n后夜龙沙驻清跸，侍臣不寝听晨鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日朝贺后闻赦","author":"傅若金","text":"紫殿风云会缙绅，荣光又逐岁华新。\n近时铁马清南海，昨夜金鸡动北辰。\n法令已行秦郡县，礼仪仍见汉君臣。\n独劳圣主哀黔首，还以殊恩慰远人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安南使馈香分送诸公","author":"傅若金","text":"南越名香屑异才，远人持赠比璚瑰。\n采经铜柱秋云湿，薰对珠崖夕照开。\n入朝喜见朱鸢定，充贡还随白雉来。\n久忆诸公喜分送，却愁薏苡误相猜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送蒙古潘学士","author":"傅若金","text":"奎宿凝华协帝符，龟图呈画照坤舆。\n衣冠治定通重译，竹帛文词变六书。\n分教已从官独冷，致身宁论术犹疏。\n朝来鼓棹潇湘去，处处秋粳荐白鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王氏山庄","author":"傅若金","text":"茅堂闻在断厓居，耕凿真疑与世疏。\n黄石洞依秋树冷，子房祠映古苔虚。\n山人自述《潜夫论》，吏部空留处士庐。\n见说田间多野兴，每惭为客负犁锄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄王君实","author":"傅若金","text":"北望衣冠忆省郎，又随车驾幸滦阳。\n苑中苜蓿空骐骥，池上梧桐起凤凰。\n中使有时传送酒，近臣何处避含香。\n上林此日无来雁，吟罢题诗欲断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送林彦广祠南北镇","author":"傅若金","text":"中使传香下玉墀，儒臣代祀出金闺。\n幡幢北起开恒岳，舟楫东回入会稽。\n望海也知晨驻马，渡江休信夜燃犀。\n名山见说多仙气，应得从容散杖藜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和孔学文从奏延春閤","author":"傅若金","text":"宫漏沈沈晓仗移，衮衣当殿听朝时。\n风含鸡舌飘青琐，日射龙鳞动赤墀。\n奏对御筵多密近，退趋春院总委蛇。\n喜闻近日稀游幸，閤下儒臣出每迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送贺尚书致仕后赴召","author":"傅若金","text":"使者徵行立晓风，宰臣传诏守离宫。\n关中旧忆留萧相，江左今看起谢公。\n路经琴峡秋声满，天绕滦河御气通。\n闻说至尊劳睿想，莫令行色后宾鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大都杂诗四首 其一","author":"宋本","text":"抛却渔竿沧海边，拂衣来看九重天。\n画阑九陌桥如月，绿影千门树似烟。\n南国佳人王幼玉，中朝才子杜樊川。\n紫云楼上如渑酒，孤负东风二十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大都杂诗四首 其三","author":"宋本","text":"卢沟晓月堕苍烟，十二门开日色鲜。\n海上神仙非弱水，人间平地有钧天。\n宝幢珠珞瞿昙寺，豪竹哀丝玳瑁筵。\n春雨如膏三万里，尽将嵩呼祝尧年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大都杂诗四首 其四","author":"宋本","text":"形势全燕拥地灵，梯航万国走王城。\n狗屠已仕明天子，牛相宁知别太平。\n玄武钩陈腾王气，白麟赤雁入新声。\n近来朝报多如雨，不见河南召贾生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"殿试罢赋","author":"宋本","text":"玉堂松桧带晨霞，遥望宸严共拜嘉。\n逢掖诸生袍立鹄，未央清问墨翻鸦。\n扶摇九万风斯下，礼乐三千日未斜。\n从此君王识名姓，烟波惭愧旧渔家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉旨降香天妃谢翰林诸公赠诗","author":"宋本","text":"皇帝甘泉受计时，宝奁亲授走冰夷。\n今朝朝著张骞出，后夜天文李合知。\n云绕勾吴分贝阙，春生英簜下龙墀。\n深惭礼乐光华外，剩得曹刘祖道诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山水翁","author":"宋本","text":"野屋不知今世，山色似含古春。\n岑寂浑无啼鸟，荒寒略有行人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其一","author":"宋本","text":"江华江月要才情，多病堪怜马长卿。\n莫向都门折杨柳，帝乡春色不南行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其二","author":"宋本","text":"琉球真蜡接阇婆，日本辰韩秽貊倭。\n番船去时遗碇石，年年到处海无波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其三","author":"宋本","text":"朱张死去十年过，海寇凋零海贾多。\n南风六月到岸酒，花股篙丁奈乐何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其四","author":"宋本","text":"涌金门外是西湖，堤上垂杨尽姓苏。\n作得《吴趋》阿谁唱？\n小卿坟上露兰枯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其五","author":"宋本","text":"旧时家近黑桥街，三十馀年不往来。\n凭仗使君一问讯，杨梅银杏几回开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其六","author":"宋本","text":"闽中父老白髭须，老子风流记得无。\n昔日郎君骑竹马，如今使者驾轺车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其七","author":"宋本","text":"素馨华畔十八娘，炎云瑞露酌天浆。\n一日供厨三百颗，使君馆券莫支羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其八","author":"宋本","text":"薰陆胡椒腽肭脐，明珠象齿骇鸡犀。\n世间莫作珍奇看，解使英雄价尽低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其九","author":"宋本","text":"东海澄清南海凉，公厨海错照壶觞。\n郎君鲞好江珧脆，水母线明乌贼香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舶上谣送伯庸以番货事奉使闽浙十首 其十","author":"宋本","text":"明年归路蹋阳和，缺胯轻衫剪越罗。\n春风通惠河头路，还与官家得宝歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送欧阳炳四首 其一","author":"宋本","text":"暖翠空濛故国山，梦中慈母美连环。\n文明门外春才好，百尺吴船漾绿湾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送欧阳炳四首 其二","author":"宋本","text":"乐圣衔杯李适之，十年春梦疾如飞。\n苍头零落郎君小，祖帐无知上客归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送欧阳炳四首 其三","author":"宋本","text":"曾侍先皇法从臣，故教给札纪华勋。\n名山久已藏名姓，莫作区区世上文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送欧阳炳四首 其四","author":"宋本","text":"去年清问下青云，曾把文章付与君。\n眼见皇恩绊渔隐，江湖烦报白鸥群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海子","author":"宋本","text":"渡桥西望似江乡，隔岸楼台罨画妆。\n十顷玻瓈秋影碧，照人骑马入宫墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦河吟","author":"宋本","text":"滦河上游陕，涓涓仅如带。\n偏岭下横渡，复绕行都外。\n颇闻会众潦，既远势滂沛。\n虽为禹贡道，独与东海会。\n乃知能自致，天壤无广大。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵赋春词二首 其一","author":"宋褧","text":"象口香销冷瑞烟，锦衾罗荐恋朝眠。\n一心要续怀春梦，不管啼莺绕槛边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云山辞","author":"王士熙","text":"山氲氲兮出云，又泠泠兮以雨。\n倏日出兮云飞，山青青兮极浦。\n横浮云兮水粼粼，褰杜若兮采白蘋。\n葺荷宇兮桂为栋，临江皋兮怅怀人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]