[{"title":"题米元晖画云山图二首 其一","author":"吴全节","text":"溪上青山过雨浓，分明倒满玉芙蓉。\n令人却忆匡庐顶，百丈银河下碧峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖画云山图二首 其二","author":"吴全节","text":"雨外夕阳摇树明，山云吞吐乱阴晴。\n飞帆一点知谁子？\n疑在元晖画里行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中岳庙投龙简","author":"吴全节","text":"阳城天地中，坤灵奠神岳。\n积翠千层霄，元气远盘礴。\n降神生申甫，形势控伊洛。\n谽谺虎豹蹲，偃蹇蛟龙跃。\n猛士横戈矛，奇阵出帏幄。\n簇簇罗旌旗，巍巍耸台阁。\n玉镜为谁开，金匮为谁钥。\n远近列画图，周遭峙郛郭。\n万状不可名，起伏互连络。\n皇皇圣帝居，历代重封爵。\n老柏浮苍烟，古殿蚀丹雘。\n天朝混华夏，秩礼特优渥。\n皇庆二载春，宵旰轸民瘼。\n有旨醮长春，玉简命新琢。\n诏臣走登封，香币致虔恪。\n邃洞藏宝符，琼音降笙鹤。\n三呼今复闻，祥风度天乐。\n小臣奉明祀，三使陟云崿。\n箕山胜可家，颍水清可涿。\n遐想饮牛人，高风动寥廓。\n赐玦知何时，分我云半壑。\n歌诗勒嵩珉，用赞圣人作。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿庆堂","author":"吴全节","text":"堂成仙子捧流霞，文物衣冠见世家。\n江上青山如玉垒，山中白石亦金华。\n云连寿栎千年树，日映蟠桃几度花。\n天府归荣传锦里，行看丹凤降黄麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵欧阳检阅濠池观荷","author":"薛玄曦","text":"行行濠池上，亭亭见长荷。\n琼葩耀初日，碧芰卷轻波。\n深蒲晓色乱，微雨晚香多。\n方舟时自移，高轩或来过。\n岂无河朔饮，那复发商歌。\n商歌一慷慨，此物奈君何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野宿山简虞博士王待制","author":"薛玄曦","text":"迢迢野宿山，峰峦何崔嵬。\n朝登猛虎啸，暮宿玄猿哀。\n高风四面发，花鸟为谁开？\n传闻章皇帝，此地昔徘徊。\n龙驾竟不还，浮云空往来。\n秀色九天外，巨灵不敢摧。\n飘摇散襟带，览结何悠哉！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高尚书夜山图","author":"薛玄曦","text":"高李风流仕西浙，共倚危楼望吴越。\n吴越江山千万里，高侯画对中秋月。\n生纸经营入董源，朦胧烟树迷宫阙。\n玉露沈沈四泬寥，潮声已息箫声咽。\n不写思陵全盛时，空遗白塔堪愁绝。\n君不见王子猷，亦向山阴弄雪舟。\n谁拈秃笔埽清游，古今嘉致总悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕粟总管玩芳亭子","author":"薛玄曦","text":"粟氏林亭好，飘飘借马游。\n药阑当户密，花径近城幽。\n未许朝参懒，聊为逸兴留。\n使君行乐处，风物为春柔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送文郎中奉使交趾","author":"薛玄曦","text":"天子龙飞统万邦，玉符封检下殊方。\n远人尽是雕题獠，奉使唯应粉署郎。\n翡翠飞时铜柱湿，鹧鸪啼处石门荒。\n炎风苦雨烦珍重，蒌叶槟榔取次尝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈都事使云南兼寄李仲渊廉访","author":"薛玄曦","text":"送君铨选使滇池，部落诸贤想自题。\n明月先经夔子北，长风却度夜郎西。\n山横塞雨骅骝滑，花发蛮云杜宇啼。\n为问霜台李廉访，白头官满尚羁栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋显父秘书惠海子北门之什次韵答之","author":"薛玄曦","text":"得君佳句见君情，春半閒从海上行。\n红杏啼莺沙苑邃，绿杨嘶马汉堤平。\n玉山地势连双阙，金水河流注夹城。\n万乘以仁怀远迩，游观宜著鲁诸生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朱本初之玉隆堂","author":"薛玄曦","text":"西山紫翠簇芙蓉，师住逍遥第一峰。\n慎勿挽弓思射鹿，祇须铸铁学降龙。\n閒穿晓月锄灵药，醉拂秋风卧古松。\n应忆京华旧游处，蓬莱访畔五云重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游张公洞简常守刘道中","author":"薛玄曦","text":"赤乌二载发奇空，古洞深沈道路危。\n翠窦下攒山瀑落，紫岩中廓石膏垂。\n铁船通海时难遇，金鼎调元事可期。\n祇恐使君同变化，白螺来往少人知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题刘京叔归潜室","author":"薛玄曦","text":"独搆茅堂养道真，满前俗事罢纷纭。\n磻溪夜钓波心月，汾曲春耕陇上云。\n长笑熊罴劳应梦，直教猿鹤怨《移文》。\n近来传得安心法，万壑松风枕上闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"攸宁庵","author":"薛玄曦","text":"高兴何如向子平，男昏女嫁一身轻。\n白云在望频登陇，黄发为期少入城。\n茧室已营身后计，凤笙时听月中声。\n江淮十载风尘满，回首谁应似独醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万岁山次韵","author":"薛玄曦","text":"万岁仙山耸碧空，广寒春殿最当中。\n桥连绮石通三岛，路绕银河接两宫。\n柳拂甘泉巢翡翠，花凝太液下冥鸿。\n年年此地经游辇，自是承平乐未终。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简畅廉访","author":"薛玄曦","text":"名家世代产贤臣，清白流芳迈等伦。\n柏叶拂阶迎廌角，红云拥殿识龙鳞。\n畅当诗律知无敌，薛稷才华愧不纯。\n江左扫清虽一道，里行犹赖济斯民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"华素台","author":"薛玄曦","text":"银台错落照长春，泰宇清明绝点尘。\n星斗九天分楚越，山河万里界瓯闽。\n花边绛节招猿鹤，云里丹梯驻凤麟。\n戏马歌风何足数，初阳今古对天人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张舍人遥碧楼","author":"薛玄曦","text":"西北高楼入九天，楚云吴树净娟娟。\n玉浮翡翠流青草，金削芙蓉列紫烟。\n方椟尚藏周典礼，故家犹继汉神仙。\n想应公子登临处，明月吹笙彩凤旋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆黄晋卿任江浙儒学提举","author":"薛玄曦","text":"忆昨追随到上台，鳌头先夺锦标回。\n道人独宝笼鹅帖，天子曾惊倚马才。\n礼以二仪宗太极，名因三赋重蓬莱。\n只今教雨司吴越，绝胜文翁化蜀来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大驾度居庸关","author":"薛玄曦","text":"居庸雄据万重山，南北门分作汉关。\n鼓角动时森虎卫，旌旗行处识龙颜。\n禅宫路转风烟合，御苑春深草树閒。\n待得长杨围猎罢，又随车骑此中还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王侍郎上都见寄","author":"薛玄曦","text":"滦水东风净物华，石鳌峰下驻仙车。\n清明草检归黄阁，胜日开筵近紫霞。\n万户砧声闻别馆，九天秋色落谁家？\n仙郎赋罢长回首，南去还乘八月槎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄赠华阳洞隐者","author":"薛玄曦","text":"归去华阳古洞天，高情萧爽绝凡缘。\n牵萝石壁书红叶，散发云林卧紫烟。\n长史玉经何日降，隐居真诀至今传。\n江东却拟寻君去，合景回风问上玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高远堂","author":"薛玄曦","text":"数椽茅屋云中出，一抹青山坐上看。\n读罢《黄庭》春雨后，刺桐花落鸟声寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠聂尊师","author":"薛玄曦","text":"青山寂寂雨潇潇，一个长松翠欲飘。\n白发道人年八十，小楼閒坐说前朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云林子南村隐居图","author":"薛玄曦","text":"山高白石秀，竹密绿阴浓。\n窗映风光扫，溪流月影重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简高佥事尧臣","author":"薛玄曦","text":"宪府开江左，清风肃百曹。\n朝廷任隐逸，郡县睹英豪。\n必使民情直，须除吏弊牢。\n马周为善政，今古尚持操。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29216,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李理问赴岭北省二首 其一","author":"薛玄曦","text":"君向龙沙去，迢迢不计程。\n关山殊汉苑，河陇异秦城。\n青草明妃冢，黄云属国营。\n盛年经此地，往事肯伤情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29217,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李理问赴岭北省二首 其二","author":"薛玄曦","text":"画省开边鄙，郎官选俊才。\n臂鹰过雁碛，走马上龙堆。\n气候调中律，星辰接上台。\n何当瓜及日，却向晋陵回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29218,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送黄元深游浙","author":"薛玄曦","text":"南宫朝殿锁蓬莱，芳草春深梦不回。\n只有海门青一点，月明犹送旧潮来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29219,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春尽北行留别吴大修撰","author":"薛玄曦","text":"万柳千花拂酒旗，南陵北苑草离离。\n居庸关下泉呜咽，又是东风欲去时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29220,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵卢疏亭廉使见寄","author":"薛玄曦","text":"西风吹老敬亭秋，回首江云近涿州。\n记得少年陪剑履，麒麟閤上凤池头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29221,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自麻仙至笔架道中作","author":"黄石翁","text":"三步五步歇，六日七日晴。\n岂不念我归，春色相送迎。\n前宵社酒散，行将返清明。\n红紫小零落，嘤嘤相和鸣。\n丛薄山矾花，玩之有馀馨。\n亦欲寄所思，归鸿已宵征。\n悠悠不可极，恻恻难为情。\n荒荒谁与语，脉脉曳杖行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29222,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望云","author":"黄石翁","text":"日出五丈高，白云浩如海。\n城郭在云中，山人在云外。\n望云云气深，入云云气浅。\n亦欲入深云，不知云近远。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29223,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖湖山烟雨图","author":"黄石翁","text":"江南旧物澄心纸，百数十年谁得此。\n挥毫无复老元章，付与承家大儿子。\n展开素幅作湖山，点染兴入苍烟间。\n偶然墨云起霮䨴，风雨偃林生暮寒。\n笔端奋迅有疾急，雨气淋漓纸犹湿。\n世人藏画尚精微，到此精微下风立。\n流寓东南谁与邻？\n倾怀付与李家亲。\n忽因缴駮论资格，纸上数峰微笑人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29224,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饭山道院","author":"黄石翁","text":"万钟鼎食不到我，正自不必西山饿。\n饭山云气如炊烟，三餐而返肠果然。\n临川丞相有素愿，何处独无鱼羹饭。\n劝君饭客先饭穷，往往乞丐皆英雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29225,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送高丽五明马","author":"黄石翁","text":"海波不动关梁通，虬髯使者来吴中。\n名骓额间挂明月，四蹄犹带龙堆雪。\n仰秣不受田家刍，太官之羊五味俱。\n贤才万里不难致，糠秕不充旴老矣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29226,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客语","author":"黄石翁","text":"旧时供奉曲，歌者亦无人。\n但感岁年晚，不知天地春。\n客犹谈宝庆，吾亦及咸淳。\n何处杨花过，飞来照角巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29227,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午日","author":"黄石翁","text":"世故一炊黍，吾生百炼铜。\n客情伤发白，醒眼对榴红。\n远岫冥冥雨，疏衣细细风。\n欲论千古恨，不见楚南公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29228,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵谢新荔","author":"黄石翁","text":"海国仙人剪绛霞，年年一朵到仙家。\n眼中玉色如何晏，席上风流得孟嘉。\n野客不分唐殿带，老臣并按建溪茶。\n醉来往事都休问，且擘轻红对晚花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29229,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食客中二首 其一","author":"黄石翁","text":"明朝便典黑貂裘，寒食宁无数日留。\n烟断旧尝悲介子，火衰今不祀商丘。\n百年尽付风吹柳，一雨远随山入楼。\n安有五侯鲭到我，自修茶事试香篝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29230,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食客中二首 其二","author":"黄石翁","text":"惨澹微茫断客魂，最难忘处最难言。\n南陵不可避风雨，麦饭何如托子孙。\n往事沧江推白鸟，谁家铁拨送清尊。\n欲寻隐者相倾倒，烟柳深深不见门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29231,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春计筹山中寄句曲山人","author":"黄石翁","text":"松花落粉啼子规，山人燕坐春昼迟。\n石泉岂非《大韶》乐，日色犹是鸿荒时。\n筠篮竹杖烟中语，青纸丹书林下诗。\n应谢钱塘旧知识，白云独往无还期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29232,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"碧桃","author":"黄石翁","text":"洗尽娇红出翠帷，玉人无语背斜晖。\n绿华前度通仙谱，天水何年染素衣。\n宴罢瑶池春梦断，影寒姑射夜深归。\n禁烟时节多风雨，莫遣繁英一片飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29233,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨梅","author":"黄石翁","text":"去年曾访林君复，烟水苍茫鹤未归。\n不似对君横小幅，一枝和雪照柴扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29234,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二银女祠","author":"查居广","text":"银冶二女祠，抚州之金溪。\n其家姓葛氏，无字年未笄。\n羞颜不出户，宛娈守礼仪。\n在唐宝历岁，其父为胥吏。\n官家起银场，日夜遭箠楚。\n勤红问父苦，玉颊啼朱雨。\n父命斯易活，誓以死相许。\n禽兽尚知义，报父宁死心。\n投身入银冶，遂化成白金。\n郡县惊且叹，奏名上朝端。\n下诏罢炉冶，鸡犬皆平安。\n已经五百岁，历历人犹传。\n荒祠俯流水，像设还俨然。\n世间尽儿女，此事谁能前？\n缇萦费娥去，未有堪比伦。\n可比惟英皇，双魂抱烦冤。\n至今湘江竹，出土含泪痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29235,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"□□□□□□□","author":"查居广","text":"汲汲岁年徂，惨惨冰霜厉。\n君子不遑舍，明发戒行李。\n南台雄且高，国家所仗倚。\n辟掾无凡材，今子足称是。\n谔谔锄奸贪，轩轩摄悍鸷。\n风俗归之正，郡邑得以治。\n御史不敢争，简书岂非议。\n捣空狐狸穴，动有鹰隼气。\n仕宦等一掷，名节在万世。\n皇皇吾君业，正朔越裳被。\n今岁一再敢，求言弭灾异。\n况子得言秋，盍体尧舜意。\n吾师范德机，每与论兹事。\n露坐山月高，抚剑各流涕。\n我本沧浪人，鼓枻从此始。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孝子行","author":"查居广","text":"丰城昔在至元岁，寇贼纷纷乱如鬼。\n是时廖生抱母行，不死白刃天有情。\n固知至愿天必感，母子全活见太平。\n廖生虽死犹未死，往往遗民言此事。\n有如江革遭乱离，负母逃潜经险阻。\n情词恻恻贼舍之，孝德还堪耀今古。\n乌乎薄俗?獍同，墓上请看纯孝子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"胡波斯引为丹阳氏作","author":"查居广","text":"紫凤檀瓢剖鸣玉，■斑镜面蚺蛇腹。\n银丝四索挂寒冰，中有骊珠三万斛。\n丹阳老人今乐师，当筵一曲《胡波斯》。\n太罕新声变哈失，曹纲缩手昭君悲。\n捩轴抽弦弹曳乐，历乱金盘撒飞雹。\n贝宫月冷泣雌蛟，瑶汉秋清叫孤鷟。\n玉壶水咽铜龙哀，绕指忽作盘空雪。\n剑光迸火玉斗碎，马蹄飞蹴河冰裂。\n洪牙促羽调声转，壮士气酣毛发立。\n蹋歌起舞劝一觞，不惜花袍酒淋湿。\n老人波斯技绝伦，出入侯门三十春。\n银鸾半臂紫貂帽，光动主翁筵上人。\n繁华转眼成今古，独技波斯向谁鼓。\n归来醉卧锦氍毹，高楼一夜梨花雨。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送危方逸之京","author":"查居广","text":"石门江上送危郎，好上神京北斗旁。\n汉代文章须贾马，周家道德并虞唐。\n柳林马过沉云黑，沙碛驼鸣落日黄。\n为计游程二千里，朔风吹雪正茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其一","author":"明本","text":"醉乘白鹤登银阙，梦跨青鸾入绛宫。\n酒醒眼开俱不见，一川桃李自春风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其二","author":"明本","text":"白玉琢成西子骨，黄金铸就伍员心。\n莲宫人醉歌声咽，月落吴江泪满襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其三","author":"明本","text":"斧烂柯销局未阑，天风吹鹤下瑶坛。\n满盘黑白轻翻转，袖拂苍梧玉佩寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其四","author":"明本","text":"天生富贵称雄才，织翠华裾拥不开。\n一簇管弦声未绝，醉扶公子上楼台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其五","author":"明本","text":"三冬枯木遇春阳，翠萼寒英喷古香。\n雪鬓老婆情未瞥，冷看花树哭檀郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其六","author":"明本","text":"叶卷西风树树寒，乱蛩吟砌梦初残。\n情怀自是不堪听，又把琵琶月下弹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颂古七首 其七","author":"明本","text":"赤脚波斯叩海门，黑风吹浪暗昏昏。\n三更掣断青霞锁，笑看骊龙戏子孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自赞","author":"明本","text":"截断红尘石万寻，冲开碧落松千尺。\n岩花朵朵水泠泠，杨柳一瓶甘露滴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吉上人之江西下高峰和尚遗书","author":"明本","text":"寒岩一夜风雷恶，师子迸断黄金索。\n骅骝万里追不回，声沈宇宙空山岳。\n君今去去持此音，十八滩头探麟角。\n君不见马师一口吸西江，波腾浪沸烟茫茫。\n又不见集云峰下四藤条，雨洗风磨恨未消。\n生耶死耶俱不道，铁壁银山齐靠倒。\n有问禅，血染溪花春正妍。\n有问道，两岸夕阳对芳草。\n千差万别任纵横，瞥转一机何处讨。\n玄沙白纸脱或举，似时更须莫谤西峰好。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和皖山隐者","author":"明本","text":"野人原上十五里，寒厓白日啼山鬼。\n万峰重叠路回旋，半间箬屋青松底。\n老僧和锸入烟霞，满林摇落朱藤华。\n烧田种寒粟，斸地栽胡麻。\n云根拨笋，涧底寻茶。\n粪火深埋魁芋种，砂瓶烂煮黄箐芽。\n人谓隐者閒不足，何故山翁事驱逐。\n山翁笑指溪上桃，庭前竹，春风几度更新绿。\n香严不作灵云死，徒有是非喧两耳。\n争似侬家百不知，从教少室分皮髓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]