[{"title":"和西湖竹枝词二首 其一","author":"于立","text":"侬家住在涌金门，青见高峰白见云。\n岭上已无丞相宅，湖边犹有岳王坟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"贡师泰","text":"芙蓉叶底双鸳鸯，飞来飞去在横塘。\n人生多少不如意，水远山长难见郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"张渥","text":"长簪高髻画双鸦，多在湖船少在家。\n黄衣少年不相识，白日敲门来索茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扇面画竹","author":"凌云翰","text":"故人清风，美人明月。\n胡为来哉，君子之节。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭景谅画","author":"凌云翰","text":"月来中天，琴声以和。\n爰有君子，于焉咏歌。\n松风递清，石泉流响。\n顾瞻白云，入我遐想。\n有道之裔，媲美林宗。\n假此图画，像此从容。\n云月无穷，松泉有待。\n善琴弗鼓，万境斯在。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旭斋诗","author":"凌云翰","text":"九日为旭，羿不能射。\n荒唐之言，孰有知者。\n旭日始旦，出日东方。\n君子昭德，如彼朝阳。\n以诚而倾，类葵与藿。\n日入日出，我息我作。\n惟刘氏子，志于高明。\n爰有斋居，以旭自名。\n日新又新，用之曷匮。\n其休以德，其拙以伪。\n我作此诗，惟明自资。\n孰传草圣，为汝书之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅 其一","author":"凌云翰","text":"老枝如屈铁，陡觉数花新。\n若露真消息，能令大地春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅 其二","author":"凌云翰","text":"吐花当暮景，结实待炎风。\n无限调和意，都归笔砚中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四皓图","author":"凌云翰","text":"松下紫芝曲，宫中鸿鹄歌。\n谁知四皓力，还比酂侯多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松云图为吴以道赋","author":"凌云翰","text":"云闲常尽日，松老不知年。\n甚似匡庐下，开亭待谪仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太白像","author":"凌云翰","text":"正尔吟秋浦，如何谪夜郎。\n尚疑颜色在，落月满空梁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东坡像","author":"凌云翰","text":"雨笠有时借，雪堂从此闲。\n眉山秋夜月，清影在人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋授之所画扇","author":"凌云翰","text":"楼拥千章木，山横一段云。\n夕阳遮不尽