89","path":"元.csv","pointer":20710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"俞文辅竹石","author":"凌云翰","text":"怪石玄云立，修篁翠雨垂。\n虽非与可笔，消得子瞻诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云松观瀑图","author":"凌云翰","text":"悬崖见飞瀑，界破一天秋。\n松密云深处，巢居在上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝二鸟图","author":"凌云翰","text":"二鸟占丛竹，喧啾春雨时。\n朝阳有鸣凤，栖老碧梧枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枯木立雀图","author":"凌云翰","text":"木杪怜孤雀，蓬蒿亦可依。\n好于生处乐，何用履危机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鼠衔芦菔图","author":"凌云翰","text":"太仓多积粟，任汝穴其间。\n何事衔芦菔，生红破一班。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹扇面 其一","author":"凌云翰","text":"剪得责鸾尾，凉阴欠被分。\n山风一披拂，扫动石坛云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹扇面 其二","author":"凌云翰","text":"山幽多美竹，不畏雪霜寒。\n好共丛生桂，移来月里看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦竹石","author":"凌云翰","text":"翠雨何曾湿，苍云本自低。\n湘山不可到，转觉望中迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨菊","author":"凌云翰","text":"谁写鹅毛菊，垐开或半开。\n露华如许湿，都向墨池来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钩勒竹为沈景王赋 其一","author":"凌云翰","text":"钩勒筼筜叶，浑疑雪压枝。\n全胜东老壁，诗写石榴皮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钩勒竹为沈景王赋 其二","author":"凌云翰","text":"孤竹生来瘦，挥毫欲动摇。\n双溪风月夜，想像沈郎腰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画扇 其一","author":"凌云翰","text":"水阔秋光变，乡心在客船。\n高楼见红柚，诗意写樊川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画扇 其二","author":"凌云翰","text":"三泖有佳处，孤舟无定居。\n秋风纨扇底，归兴起鲈鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/