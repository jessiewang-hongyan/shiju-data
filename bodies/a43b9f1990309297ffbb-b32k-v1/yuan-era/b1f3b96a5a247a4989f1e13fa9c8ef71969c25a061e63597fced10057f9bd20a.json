[{"title":"中秋有感四首 其四","author":"傅若金","text":"翠华游幸地，怅望感清尘。\n洒竹啼宫女，持弓泣野臣。\n金盘残月露，玉座倚星辰。\n独有龙鸾气，长令草木春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事 其一","author":"傅若金","text":"目断虞渊日，心伤魏阙秋。\n霍光元在汉，周勃固安刘。\n庙社多佳气，公卿足远猷。\n宸居终不改，羁旅莫深忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事 其二","author":"傅若金","text":"未有龙庭使，犹严虎卫兵。\n云山秋塞远，星月夜楼明。\n逆旅多防盗，迁居竞入城。\n窃闻定神器，且可慰群情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诘陈宗道酒不至淹留高刘诸公坐","author":"傅若金","text":"酒许今晨至，灯从昨夜花。\n遣人听系马，留客过栖鸦。\n高适邀同至，刘伶兴转赊。\n不成投辖饮，怅望隔风沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得天际舟送兵部张孟功治河","author":"傅若金","text":"日下行人发，春晨去鹢催。\n缆侵斜月解，帆向断云开。\n度鸟窥诗卷，垂虹映酒杯。\n寻源不可尽，奉使几时回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居即事","author":"傅若金","text":"地僻连高树，庭虚集晚烟。\n鸟衔朱果落，虫曳碧丝悬。\n扣户鸣空盎，开渠得古钱。\n深惭穷巷客，时枉故人笺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次孙伯刚鹤雏诗韵","author":"傅若金","text":"弱羽为人养，卑栖每自归。\n步苔依坐石，窥竹映开扉。\n绝岛秋云迥，空庭夕露微。\n纷纷野田雀，终日稻粱肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题余泰享隐居","author":"傅若金","text":"闻说幽栖处，遥连郁木天。\n径开移竹地，渠引灌花泉。\n坐客留倾酿，邻人访草玄。\n京华远游子，那得共盘旋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢沟桥","author":"傅若金","text":"古道旷秋色，平桥卧夕阳。\n水声西下急，山气北来长。\n数骑凌空阔，孤烟入渺茫。\n人传耕种地，宿昔战争场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拒马河","author":"傅若金","text":"落日苍茫里，秋风慷慨多。\n燕云馀古色，易水尚寒波。\n岸绝船通马，沙交路入河。\n行人悲旧事，含愤说荆轲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萨天锡画屏","author":"傅若金","text":"入坐闻流水，开屏见远山。\n路通烟树窈，门对野桥閒。\n拄杖晴俱出，渔舟暝独还。\n祇惭万里客，尘土污朱颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延津渡河","author":"傅若金","text":"驿路南征远，河津晓渡危。\n风雷划簸荡，云日互参差。\n鸣橹中流急，悬帆上洑迟。\n交州却回日，应及水清时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金竹道中书题桃花驿","author":"傅若金","text":"征南万里使，行道畏蹉跎。\n平壤踰淮少，青山入楚多。\n田依深谷转，路迫断崖过。\n后夜南楼月，羁离奈尔何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"港口晓行","author":"傅若金","text":"早起星犹在，前行路稍分。\n人家隔树见，山鸟过桥闻。\n涧响多于雨，林昏半是云。\n晓逢力田者，愧尔一朝勤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临湘","author":"傅若金","text":"宿雨愁泥滑，长途畏日斜。\n黄归幽径犊，青聚古祠鸦。\n野屋时依竹，山园各种茶。\n巴陵看渐近，遥识故人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳先生祠","author":"傅若金","text":"江抱零陵郡，山藏钴鉧潭。\n古人如水去，祠树与天参。\n述作笼诸子，风骚迫二南。\n后来窃时誉，吾辈得无惭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桂林","author":"傅若金","text":"桂林南望远，山路与云连。\n浅水清涵石，攒峰乱刺天。\n干戈仍岁月，瘴疠接风烟。\n蛮寇何能定，边氓亦可怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宾州","author":"傅若金","text":"过岭冬犹热，缘山夜未宁。\n树残兵后赭，草发烧馀青。\n西寇迷仙雾，南人候使星。\n民居日稀少，惟见短长亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊日入安南","author":"傅若金","text":"冬入安南国，云迎使者轺。\n郡闻秦日置，柱想汉时标。\n江路篁犹箨，山田稻始苗。\n皇恩函远迩，行役不辞遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冯高","author":"傅若金","text":"世祖初开业，安南早贡琛。\n国蟠蜗角小，地接犬牙深。\n使节犹频入，蛮兵莫见侵。\n数州须拯恤，万感寄登临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答别龙州萧从事韶","author":"傅若金","text":"使节明金虎，腰弓偃画蛇。\n蛮夷趋号令，原隰见光华。\n边树犹含绿，江梅久放花。\n忆君依幕府，何日定还家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"还闻柳州破道阻将溯江","author":"傅若金","text":"交阯方通使，宾州忽被围。\n还闻山路塞，径就水程归。\n上府空金椀，前军老铁衣。\n谁能平政化，不事总戎机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别静江文学诸公","author":"傅若金","text":"乍见先愁去，将行未忍分。\n字期归后寄，歌畏别时闻。\n驿树过春雨，江船隔夜云。\n驱驰念吾弟，羽翼待诸君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浯溪","author":"傅若金","text":"舣棹依江岸，寻桥过寺门。\n竹深题字满，苔古刻文昏。\n石色兼云冷，溪声杂雨喧。\n吾亭正何处，为觅漫郎孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长沙见严亲","author":"傅若金","text":"游子方春至，严亲尽日怜。\n别来忧道路，喜定问山川。\n百粤元过岭，三湘总入天。\n归朝诫努力，江上莫留连。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月二十八日至京","author":"傅若金","text":"使节违双阙，天书下百蛮。\n雨蒸归日路，云合去时山。\n岭表兵犹动，滦阳驾未还。\n安边数策在，不得犯龙颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京师守岁","author":"傅若金","text":"日月催时序，乾坤隔晦明。\n残年万里梦，今夕几人情。\n久客烦朋友，双亲倚弟兄。\n深惭须薄禄，不得谢浮名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发通州","author":"傅若金","text":"燕骑经旬发，吴船此日行。\n树知风起色，帆识雨来声。\n骤转长林暗，斜分绝塞明。\n河流今夜满，无复滞归程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水村","author":"傅若金","text":"野树茏葱合，官桥屈曲通。\n入天迷远近，看日得西东。\n酒旆青摇水，渔罾白映空。\n时还问村落，何必似城中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河西务","author":"傅若金","text":"驿路通畿甸，敖仓俯漕河。\n骑瞻西日去，帆听北风过。\n燕蓟舟车会，江淮贡赋多。\n近闻愁米价，素食定如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长芦","author":"傅若金","text":"水国常含卤，沙场业煮盐。\n转输分使出，征榷置官监。\n桥坏仍通市，船来总落帆。\n依依道傍柳，无那拂征衫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秦邮","author":"傅若金","text":"缥缈平湖白，微茫远树青。\n田分高下水，道俯短长亭。\n鹅鸭烟中乱，鱼虾雨里腥。\n秦邮看渐近，城郭记曾经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初归","author":"傅若金","text":"远道趋乡国，中宵梦弟兄。\n松篁数里见，桑柘十年成。\n慈母惊相问，邻儿笑共迎。\n无钱未足恨，骨肉慰离情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常宁刘百户园林 其一","author":"傅若金","text":"颇爱将军第，幽同处士园。\n石浮春雨翠，溪抱夕阳暄。\n虎韔空悬壁，熊车数过门。\n遥疑花树底，鸡犬近仙源。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常宁刘百户园林 其二","author":"傅若金","text":"少壮从戎事，归休遂野情。\n鹖冠时自著，龙剑夜犹鸣。\n竹下思羊仲，瓜前感邵平。\n知君纵幽赏，心已薄浮名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常宁刘百户园林 其三","author":"傅若金","text":"春日名园好，常时俗客稀。\n树间斜引径，花外别开扉。\n沙鸟随行熟，池鱼上钓肥。\n往来祇适兴，出处已忘机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和赠陈与之","author":"傅若金","text":"午日清江道，南风满白蘋。\n暮年为客健，长路对人贫。\n忆弟馀双鬓，还家称一身。\n有孙堪慰眼，莫厌把杯频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源图","author":"傅若金","text":"闻说避秦地，花间忘岁年。\n偶逢渔父问，长使世人传。\n丘壑浑疑幻，林庐或近仙。\n至今图画里，惆怅武陵船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道士矶阻风过吕相墓","author":"傅若金","text":"危樯风急晚相依，间谒荒坟吊落晖。\n白酒暂谋同辈饮，青山因感昔人非。\n荆襄万里空残堞，吴楚千帆掠断矶。\n今古高门总丘墓，英雄何用苦沾衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"韩淮阴庙","author":"傅若金","text":"淮阴万古英雄恨，楚树荒荒夕照残。\n水夹废城春草合，云昏遗庙野花寒。\n封齐安用真王印，兴汉空馀大将坛。\n高帝旌旗俱寂寞，断碑零落后人看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"会通河伯祠晚眺","author":"傅若金","text":"水神祠下晚维舟，閒倚穹碑诵《远游》。\n西日射云明兽几，北风吹土集貂裘。\n漳川近绕幽燕出，汶水分兼济漯流。\n过客岂知疏凿苦，当时荷锸几人愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀","author":"傅若金","text":"一春风浪淹行客，六月尘堆满上京。\n邻馆朝烟同杵臼，故园暮雨隔柴荆。\n西州近日犹防寇，南诏经年久用兵。\n独夜起瞻龙虎气，五云终绕凤凰城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴五首 其一","author":"傅若金","text":"天上旌旗卷暮寒，人间鼓角送悲酸。\n瑶池落日回青鸟，月殿浮云掩素鸾。\n杨柳渐稀秋瑟瑟，芙蓉已老露漙漙。\n砧声苦近南邻客，寥落羁怀强自宽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴五首 其二","author":"傅若金","text":"落木萧萧满帝畿，候虫处处趣寒机。\n客星入斗秋深见，神女行云日晏归。\n复喜诸公扶社稷，祇怜弱弟奉庭闱。\n短章讽罢频回首，目送江南鸿雁飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴五首 其三","author":"傅若金","text":"梧桐树晚细含烟，阊阖门深总映天。\n龙去鼎湖云漠漠，鹤吟华表月娟娟。\n东都日望金舆发，南徼犹惊羽檄传。\n只在忠良勤夙夜，五陵佳气故依然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴五首 其四","author":"傅若金","text":"白日遥看锦绣悬，重重楼阁隐青烟。\n化城或在诸天外，方丈长疑积水边。\n每说神僧飞杖锡，更闻童女上楼船。\n西风日暮何萧瑟，一度登高一惘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴五首 其五","author":"傅若金","text":"弊裘已畏早寒侵，岁月祇惊久客心。\n莫倚长卿能作赋，始知李子故多金。\n天门守虎星辰冷，云气从龙雾雨深。\n直北关山时极目，背人聊复短长吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"崇天门朝贺","author":"傅若金","text":"辇路尘清列羽林，侍臣星向肃森森。\n风含凤吹青冥阔，日射龙旗紫极深。\n两庑佩趋临水玉，九门诏出映泥金。\n从来汤武须传业，更在伊周老尽心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中次元茂才","author":"傅若金","text":"北阙今晨雪满墀，腐儒忧国畏人知。\n月寒弱水迷三岛，云暗苍梧失九疑。\n瑞木细飘天上叶，梅花潜发岭南枝。\n山阴那得乘佳兴，起绕前轩自咏诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杜德常御史赴西台 其一","author":"傅若金","text":"御史才华旧省郎，翩翩云路起鹓行。\n天回紫阁明奎壁，地切乌台动雪霜。\n分陕定存周礼乐，过秦犹有汉文章。\n欲因巡郡还搜访，别酒临风意独长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杜德常御史赴西台 其二","author":"傅若金","text":"绣衣此别近如何，骢马西行处处过。\n驿树苍茫连灞浐，江花浩荡过岷峨。\n三秦久诉诛求尽，六诏仍闻警急多。\n早听封章切肝胆，为怜编户困干戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵元日朝贺","author":"傅若金","text":"宫漏催朝烛影斜，千官鸣玉动晨鸦。\n交龙拥日明丹扆，飞凤随云绕画车。\n宴罢戴花经苑路，诗成传草到山家。\n小儒未得随冠冕，遥听钧天隔綵霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日巡山和王君实四首 其一","author":"傅若金","text":"巡山千骑接神都，谷满秋田雾下初。\n烽火不闻乘夜警，人烟多见入云居。\n百年礼乐成周典，万古山河列汉书。\n喜有新诗继风雅，诸公才气总凌虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27354,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日巡山和王君实四首 其二","author":"傅若金","text":"衣冠如雨耀神都，郊甸新凉拂马初。\n日月近临黄阁贵，风云遥限紫宸居。\n少陵漫拟陈三赋，司马先能著八书。\n想见九关严守虎，玉堂金殿最清虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27355,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月十一日赴安南","author":"傅若金","text":"燕城秋早五云开，路入南交几月回。\n奉使始从天上出，行人即看日边来。\n班超万里终投笔，郭隗千金更筑台。\n圣主恩深极炎海，伏波铜柱任苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27356,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"涿州楼桑村先主庙","author":"傅若金","text":"先主君臣并材杰，天倾炎汉苦须扶。\n曹瞒力尽才分国，葛亮谋成竟托孤。\n道路只今通陇蜀，山河无复限荆吴。\n行人为指楼桑庙，肠断西风散白乌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"磁州","author":"傅若金","text":"晓出邯郸露满空，武安红树起西风。\n鼓山路向云间落，滏水船从地底通。\n秋草尚疑曹氏冢，野花无复赵王宫。\n古来富贵皆黄土，莫笑行人忆梦中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汴梁","author":"傅若金","text":"汴上荒城绕故宫，山头危石堕秋风。\n夷门市起闻嘶马，梁苑樵归见断鸿。\n斗草尚馀残后碧，进花无复盛时红。\n欲登高处肠先断，满目閒愁赋未工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登岳","author":"傅若金","text":"万壑千峰次第开，祝融最上气崔嵬。\n九江水尽荆扬去，百粤山连翼轸来。\n入树恐侵玄帝宅，牵萝思上赤灵台。\n明年更拟寻春兴，应及潇湘雁北回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泸江","author":"傅若金","text":"泸江之水发南诏，龙编古城居下流。\n冯夷伐鼓迎汉节，泉客弄珠随越舟。\n鲸海遥连白日动，鳌山近戴青天浮。\n层波莫据鼋鼍险，日夜东归未敢休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题天使馆","author":"傅若金","text":"元统三年颁正朔，诏书远到极南开。\n使旌入馆青云动，仙盖临江白日回。\n谕蜀岂劳司马檄，朝周终见越裳来。\n还家耆旧应相问，文化如今遍九垓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"却侍姬","author":"傅若金","text":"夜宿安南天使馆，主人供帐烂相辉。\n宝香烬起风过席，银烛花偏月照帏。\n王母谩劳青鸟至，文箫先放綵鸾归。\n书生自是心如铁，莫遣行云乱湿衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"崇仁峡","author":"傅若金","text":"扁舟夜宿鱼龙窟，久客长怀虎豹关。\n岁暮思家成白发，天涯持酒得青山。\n张骞浪喜蒲萄入，马援终嫌薏苡还。\n天子只今多遣使，将军何日遂平蛮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桂林喜吕仲实佥宪至","author":"傅若金","text":"正月交州奉使归，忽闻鞍马发王畿。\n岭南瘴雨开铜柱，江上春云逐绣衣。\n草热虫蛇常并出，树深豺虎近皆肥。\n明朝按节劳咨访，边郡于今未解围。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过故妻墓","author":"傅若金","text":"湘皋烟草绿纷纷，洒泪东风忆细君。\n每恨姮娥工入月，虚疑神女解为云。\n花阴午坐閒金剪，竹里春愁冷翠裙。\n留得旧时残绣在，伤心不忍读回文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙翔寺","author":"傅若金","text":"梵王宫殿倚青冥，先帝旌幢拥百灵。\n宝网自鸣空里乐，琅函时出赐来经。\n近山凤去花仍碧，遥海龙归树独青。\n玉辇宸游竟寥廓，行人挥泪读新铭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤凰台","author":"傅若金","text":"太白题诗凤游处，古台萧索换流年。\n风流偶出齐梁后，文藻犹含晋宋前。\n淮水夜明沧海月，石城春暗秣陵烟。\n古来宫殿俱无迹，风雨凭高独黯然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送笃御史之南台","author":"傅若金","text":"旅馆天寒尽日空，绣衣临访走儿童。\n已闻俗客惊题凤，更访邻人失避骢。\n短刺实愁归后见，清樽虚拟别时同。\n明朝挟策秦淮道，惆怅燕云隔断虹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]