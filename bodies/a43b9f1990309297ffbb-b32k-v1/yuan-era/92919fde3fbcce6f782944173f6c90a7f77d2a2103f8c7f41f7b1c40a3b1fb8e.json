[{"title":"哭尊大人领省","author":"耶律铸","text":"孤儿泪眼空流血，一夜不知浑白发。\n宝灯轮毕新记成，梦断疏钟吼残月。\n白云隐隐入青冥，生死悠悠两长诀。\n人閒天上父子情，遗愤有身终尽雪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"瑞井行","author":"耶律铸","text":"赤子半入井，宁无恻隐心。\n急走掣其足，啼号嗄以喑。\n其亲即偕来，翕然集四邻，将谓相谢不世恩。\n忿呼恚诘渠何人，令我儿哭声酸辛。\n中心自誓救颠坠，孰顾若辈怨且嗔，君子谋道不谋身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"去妇怨","author":"耶律铸","text":"最苦人生生别离，匆匆轻别几时归。\n紫箫吹落燕南月，丽泽门开马似飞。\n雨晴不定云来去，老雁叫云云不住。\n琵琶拨尽断肠声，断弦声断秋云莫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄赵虎岩吕龙山","author":"耶律铸","text":"年来缘底事，不复出柴关。\n兀兀千杯酒，萧萧两鬓斑。\n月明河汉淡，天阔水云閒。\n目断故人远，去鸿犹未还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄高仲杰","author":"耶律铸","text":"一枕功名梦，半年风雨床。\n地高秋易老，人去夜偏长。\n悲赋伤鹦鹉，哀琴怨凤凰。\n晚风吹落日，明月满寒塘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄人","author":"耶律铸","text":"空翠扑晴影，轻黄著柳枝。\n春风恋游子，浑似纵游时。\n除醉更无事，忆君方有诗。\n如何一片月，两地照相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送元遗山行","author":"耶律铸","text":"燕北秋风起，幽花满地开。\n既邀今日别，合道几时来。\n白玉烟沈阁，黄金草暗台。\n不须伤老大，珍重掌中杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李敬斋行","author":"耶律铸","text":"一代文章老，素车归故山。\n露浓山月净，荷老野塘寒。\n茆屋已知足，布衣甘分閒。\n世人学不得，须信古今难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送完颜奏差行","author":"耶律铸","text":"君侯诣关日，款曲为慈亲。\n故国少知己，旧山多逸民。\n林园随分雨，天地自然春。\n四海满桃李，惜花无一人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送正夫行","author":"耶律铸","text":"岁穷风景恶，萍梗客天涯。\n咫尺辞兰省，优游出凤墀。\n霜寒笳韵切，天远雁声迟。\n瘦马长途晚，凝云雪欲垂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日怀赵超然","author":"耶律铸","text":"万里故乡梦，五更残月钟。\n去鸿书断绝，归燕语朦胧。\n流水艳春态，好山呈晓容。\n是谁将怨笛，吹断绿杨踪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄郭隐君辅之","author":"耶律铸","text":"寄傲人閒世，潜真计未疏。\n鸟行恬豹隐，惊食澹鹑居。\n座列清谈客，门屯好事车。\n不应驰素谒，坚待偃波书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜对月赠唐臣","author":"耶律铸","text":"寒水摇空碧，西风满一琴。\n孤光万家月，一寸百年心。\n白雁惊残叶，青霜急乱砧。\n故山休挂梦，无地可投簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中寄怀李先生九山居士","author":"耶律铸","text":"相忆复相忆，登临百感生。\n河山分野色，风雨混松声。\n白雁书秋思，苍苔篆古情。\n如何千万里，独自计归程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚集瑶华殿","author":"耶律铸","text":"月浸瑶华殿，云垂素女帏。\n水晶帘半捲，火玉烛交辉。\n紫气游清晏，休光下太微。\n不知留帝所，疑执化人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日即事","author":"耶律铸","text":"迟日照青春，游风荡紫宸。\n雪霜无气力，桃李有精神。\n幽思平欺酒，閒愁自避人。\n忘机殊不恶，鱼鸟看来驯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泛太液池","author":"耶律铸","text":"烂纵飞龙驭，凝神入醉乡。\n烟霞生缥缈，丝竹袅微茫。\n蒲剑割秋水，荷盘倾夕阳。\n莫轻年少日，青鬓易惊霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伯哩行","author":"耶律铸","text":"胜气横千里，欢声洽万夫。\n虎牙为后拒，犀首是前驱。\n金练鸦光队，银枪雁子都。\n率然乘伯哩，二战下崲峹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老将","author":"耶律铸","text":"结发究韬略，驰驱四十年。\n长征秦五岭，苦战汉三边。\n万死奋不顾，一生今幸全。\n云台无住处，何日上淩烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"平南将","author":"耶律铸","text":"江淮平圮裂，原不事梯冲。\n锐气吞坚阵，威声挫战锋。\n高昂地上虎，王浚水中龙。\n讵可同年语，论功与定封。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南征奏捷","author":"耶律铸","text":"宸算将雄断，天然是美谈。\n一征平漠北，再举下江南。\n须不闻漂杵，何曾见溺骖。\n元和歌圣德，恐未免怀惭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西征","author":"耶律铸","text":"白首征西将，封侯尽未贪。\n远离穷发北，深入不毛南。\n笑解重围困，威延转战酣。\n若须求虎子，虎穴是当探。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻北耗诏发大军进讨","author":"耶律铸","text":"护军承诏日，骠骑佐轻车。\n投豹韬攘恶，教龙钤辟邪。\n除狼还得虎，养虺竟成蛇。\n致使云台将，如云过涿邪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经扼狐岭得胜口会河战场","author":"耶律铸","text":"乌兔纵飞步，急于寒女梭。\n扼狐名好在，得胜事如何。\n暮雨连芳草，秋风捲素波。\n战尘如可洗，当与侍中过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"居庸关","author":"耶律铸","text":"秀拔延天险，寒盘万古根。\n东西躔日月，南北限乾坤。\n影落梅山冷，气摇星斗昏。\n如何战尘下，荆棘暗重门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仙居亭","author":"耶律铸","text":"意匠惊难状，天然醉饮图。\n两行风外柳，一册枕边书。\n云锦薰沈水，莺簧脱串珠。\n烟光将胜概，特贮在仙居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题虚白斋","author":"耶律铸","text":"可待留灵锁，方期得驻颜。\n久虚生白室，长启扣玄关。\n放浪形骸外，逍遥天地閒。\n要当知雾豹，依旧在南山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书后堂壁","author":"耶律铸","text":"放浪形骸外，寄乡杯酒中。\n催归有情鸟，促织可怜虫。\n落日隔疏雨，断云垂渴虹。\n弋人何所慕，霄汉点冥鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"迎风馆","author":"耶律铸","text":"涤暑迎风馆，雄风袭玉扉。\n云开天乙网，霞捲羽人衣。\n倒景摇清禁，飞烟拥翠微。\n泛阑将转急，须更入罗帷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"司春园","author":"耶律铸","text":"地偏饶胜事，花事迥标奇。\n春自长须在，人谁尽得知。\n笑宜教捧腹，醉不解攒眉。\n未那司春子，腾讥释二疑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪香亭月下偶得名酒径醉为赋","author":"耶律铸","text":"琼露融云液，金泉涌月波。\n带花浮绿蚁，和月卷红螺。\n夜色依香雪，春容动绮罗。\n是须轰玉笛，倚弄玉龙歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟西昆体后阁","author":"耶律铸","text":"夜枕雨声细，晓窗花气浓。\n玉尘挂秋月，绣幕生春风。\n藻井翠盘凤，画阑金走龙。\n上名是何物，只合付儿童。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读新乐府集","author":"耶律铸","text":"揽尽江山秀，珠玑咳唾新。\n艳浮天上锦，情动月中人。\n花鸟音容冶，风云气象频。\n郢歌将白雪，憔悴对阳春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋闺","author":"耶律铸","text":"供给深闺怨，秋声又捣衣。\n鸳鸯不独宿，燕子自双飞。\n尘暗芙蓉帐，风寒翡翠帷。\n驰心属明月，将此照金微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晓月下观白牡丹","author":"耶律铸","text":"小立犹痴睡，凝情出翠笼。\n玉盘承晓露，金镜挂春风。\n岂为素娥妒，不呈青帝功。\n万花推弟一，谁更忌专宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏雪二首 其一","author":"耶律铸","text":"楼晓倚阑干，天低欲压阑。\n削冰封岳色，飞席下云端。\n风阵迟寒夜，星铓摇夜寒。\n岭梅应见怨，何惮一来看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏雪二首 其二","author":"耶律铸","text":"日淡隔云幕，地虚铺雪毡。\n捲帘看不见，如画旧山川。\n岂忆三杯酒，能回六月天。\n一声何处笛，吹裂野梅边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"圆福院竹","author":"耶律铸","text":"虚心虽涉世，贞节自孤坚。\n翠梢挂明月，锦绷披紫烟。\n岂无仪凤日，别有化龙年。\n玉质捎云里，唯须著列仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答座客","author":"耶律铸","text":"千红将万紫，剪染尽冰蕤。\n莫晓谁施巧，惟春自出奇。\n向阳花易发，伴老病难治。\n若得如人意，除天是国医。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"调人幽居","author":"耶律铸","text":"瑟瑟苔封径，萋萋草暗阶。\n莲舟浮太乙，玉笛喷洪崖。\n巾漉糊涂酒，炉煨榾柮柴。\n莫将千古计，取次却沈埋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺人飞泉幽居","author":"耶律铸","text":"万斛惊珠冷，银河落翠微。\n自歌还自舞，谁是复谁非。\n高鸟知何处，浮云去未归。\n好风将落叶，著意认柴扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倦夜","author":"耶律铸","text":"展转延清漏，开帘纳月光。\n西风恋残叶，终夕伴啼螀。\n静柝沈蛮徼，疏钟撼客床。\n六龙应振辔，飞日上扶桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无何狂醉隐三首 其一","author":"耶律铸","text":"无何狂醉隐，慢訑更痴蒙。\n虽涉人间世，殊参塞上翁。\n只须推倚杖，不必论穷通。\n且把无边事，横陈在酒中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无何狂醉隐三首 其二","author":"耶律铸","text":"无何狂醉隐，拙直更疏慵。\n花鸟閒情外，江山醉眼中。\n涉江搴薜荔，缘木采芙蓉。\n待把人閒事，从头说化工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无何狂醉隐三首 其三","author":"耶律铸","text":"无何狂醉隐，耕适是生涯。\n驯护能言鸟，调笼解语花。\n不应抛蝶梦，须与趁蜂衙。\n谁佐杯中酒，仙人萼绿华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"穷庐篇","author":"耶律铸","text":"巢燕年年客，山河日日新。\n窗分一镜晓，门掩满庭春。\n栖鸟羁笼影，行蜗游壁尘。\n故园虽好在，楼观几荆榛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓居灵州北村","author":"耶律铸","text":"野色荒烟暗，氛霾昼影昏。\n客情纷若絮，尘事乱如云。\n杨柳春风渡，梨花暮雨春。\n不如归去鸟，著意唤谁闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双溪月下戏赠触热冲暴雨者","author":"耶律铸","text":"夐入清虚府，轻河漾月舟。\n冰天通色净，水月杂波流。\n雨横蚁兵溃，日熇山市收。\n若然閒意况，原不到心头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊申己酉北中大风","author":"耶律铸","text":"冲风回白日，飞砾洒青天。\n富贵城西畔，珍珠河北边。\n阳冰原不冶，阴火更潜然。\n直澈龙荒外，萧条是野烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过东山县有怀","author":"耶律铸","text":"忆昨惊尘下，肠回望眼穿。\n计程虽信宿，恨别似经年。\n自致青云上，谁来白月边。\n万金游子信，空与梦牵缠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追悼大人领省","author":"耶律铸","text":"税驾知何处，仙游阅古今。\n英灵千载气，松柏一生心。\n白日空寒色，苍天更暮阴。\n志终伸不得，遗恨海长深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春色浮山外","author":"耶律铸","text":"春色无高下，宁分泽与邱。\n世间依旧好，山外若为浮。\n桃李花争拆，池塘草自抽。\n绿涵峰势合，红带烧痕收。\n迟日千钟酒，东风百尺楼。\n夜来甘雨足，溪谷已成流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春二首 其一","author":"耶律铸","text":"东帝施恩似恤贫，严凝时节唤回春。\n未知和气先归柳，便觉寒威不著人。\n上苑三冬梅正发，和林五月草初新。\n世閒公道惟春色，春色年来也不均。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春二首 其二","author":"耶律铸","text":"节物惊心若见催，一年还见两春来。\n腊寒自向人閒尽，春色却从天上回。\n乍暖柳条先易绿，向阳花树不难开。\n高歌买断西城酒，更对东风尽此杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日寓怀","author":"耶律铸","text":"燕语鸾啼怯晚阴，蝶狂蜂乱更关心。\n冥鸿空自运寒暑，骇浪为谁淘古今。\n每纵思吟轻万户，但言眉笑抵千金。\n闭门不出近十日，忽到水边春已深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月和林道中未见草萌","author":"耶律铸","text":"不觉清明梦里惊，问人人道过清明。\n须知上苑花飞树，谁信和林草未萌。\n绿水归鸿空自感，淡烟啼鸟若为情。\n翩翩瘦马荒山路，衰草斜阳正独行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园春兴因赠雪庭上人兼简张公讲师","author":"耶律铸","text":"万丈虹霓络紫烟，笙歌清沸雨馀天。\n满庭芳草翠如积，一洞碧桃明欲然。\n流水引来梅坞底，春风吹到酒垆边。\n散花唤起毗邪梦，从此无心号谪仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明","author":"耶律铸","text":"寒食清明失旧期，踌躇搔首日沈西。\n风生杨柳鸦先觉，寒过梧桐凤不栖。\n山色雪迷春意老，雁声云遏暮天低。\n苏门二月春光好，好逐东风发马蹄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重和惜春诗韵余时经始西园","author":"耶律铸","text":"惜春情味旧情缘，依旧中情似去年。\n怪得玉音殊郑重，想将花事易唐捐。\n白莲已结为诗社，翠水唯浮载酒船。\n谁谓惜花人老大，买花输得买山钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谨用尊大人领省十六夜月诗韵","author":"耶律铸","text":"黄鸡白酒管弦和，一任浮生岁月磨。\n银管题诗应远客，玉箫吹恨忆秦娥。\n人言皓魄今宵减，我见清光依旧多。\n一十二时争几许，人閒柰此世情何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋对月","author":"耶律铸","text":"银烛煌煌十二衢，冷金波浸酒仙居。\n由来物外通明殿，只是人閒不夜珠。\n玉女窗扉唯白晓，素娥庭院更清虚。\n桂花香陌无尘景，全入壶翁碧玉壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日即事 其一","author":"耶律铸","text":"征鸿南渡老年华，渐觉冬来眼界多。\n寒雪狂风颤林木，冻云残照锁关河。\n高低山势黄沙碛，远近人家白草坡。\n极目碧天长万里，醉邀明月一高歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日即事 其二","author":"耶律铸","text":"蜡栀五万酬鞭直，洴絖百金且食封。\n萧散不萌争闹趣，真醇缪觊养生慵。\n涤清研里憨凡笔，磨彻鉴中嚬窘容。\n伤到玄冥潜春令，狐裘羔酒贮严冬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"日南至","author":"耶律铸","text":"猎猎严风正酷寒，一阳潜动旧关山。\n人情徒怨融和晚，天意何曾造化悭。\n暗逐寒威归汉外，渐回春色到人间。\n明年桃李知多少，莫把东风作等閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谨用尊大人领省龙庭风雪诗韵 其一","author":"耶律铸","text":"登高何处是燕然，极目关山塞草边。\n落日几峰寒带雪，西风一雁冷横天。\n冬居冰谷赖酮酒，夜宿沙堤借草毡。\n为向中州豪杰道，天涯如此过年年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谨用尊大人领省龙庭风雪诗韵 其二","author":"耶律铸","text":"冻折瑶琴三两弦，起来孤坐忆成连。\n可堪此世成何事，了却生平莫问天。\n门外共传三尺雪，帷中赖有四围毡。\n遥思千古功名辈，回首西风不记年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月道中遇雪","author":"耶律铸","text":"密密痴云晚自凝，飘零踪迹断蓬轻。\n幽禽底事啼长咽，流水何缘浪不平。\n清梦未回人换世，黄花应怨我寒盟。\n故园回首肠堪断，雪满荒山瘦马行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"途中值雪","author":"耶律铸","text":"不禁风色避穷庐，寂寞行人正半途。\n日暮关河云黯淡，晚来天地雪模糊。\n千山未霁寒尤重，一鸟不飞人更孤。\n旅拨寒炉一尊酒，故人知我此情无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]