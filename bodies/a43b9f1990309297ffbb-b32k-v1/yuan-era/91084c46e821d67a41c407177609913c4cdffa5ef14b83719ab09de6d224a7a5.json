"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 自咏","author":"马钰","text":"昔日施为狡猾心。\n闻人活路向前侵。\n暗生荆棘闹如林。\n不顾伤神并损气，欲求积玉更堆金。\n行尸走骨作知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 过渼陂道友索词","author":"马钰","text":"若非云游到渼陂。\n争知此处隐瑶池。\n人人怪我不留题。\n壁上珠玑碑上玉，交光灿烂有馀辉。\n何须马钰再吟诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 述怀","author":"马钰","text":"外乐何曾内动心。\n个中无口会哦吟。\n声声清雅透琼林。\n善听要听听不得，如聋似瞽可追寻。\n恁时仙佛作知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 复用前韵","author":"马钰","text":"养就三丹未得闲。\n化人入道认清闲。\n真欢真乐应真闲。\n更把三丹通一炼，行功圆满显神丹。\n胎仙捧出紫金丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 思胡子金","author":"马钰","text":"好个中条胡讲师。\n通儒明道达禅机。\n自然悟解这些儿。\n石女醉归金虎窟，铁牛耕入火龙池。\n胎仙采得紫灵芝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 思郝仙","author":"马钰","text":"决裂修持是郝仙。\n孤云野鹤最翛然。\n我虽环堵望齐肩。\n日日炼心烹药鼎，时时运火补丹田。\n功成同上大罗天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 起慈悲","author":"马钰","text":"马钰常凭佛作为。\n无为心内起慈悲。\n寻声救苦做行持。\n一切女男如父母，见他生死十分危。\n须当立个上天梯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 寄呈道众","author":"马钰","text":"澹泊修行不肯行。\n常忧冻馁逞多能。\n岂知饱暖欲性生。\n且恁寂寥潇洒过，休迷尘事与华荣。\n常清常静大丹成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 寄南京道友","author":"马钰","text":"自愧无缘去大梁。\n亦无心意学贤良。\n夷门道友我思量。\n予在环墙调水火，诸公何日绝炎凉。\n山侗叮嘱悟黄粱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 寄赵居士","author":"马钰","text":"净净清清净净清。\n澄澄湛湛湛澄澄。\n冥冥杳杳杳冥冥。\n永永坚坚坚永永，明明朗朗朗明明。\n灵灵显显显灵灵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠于瓦罐","author":"马钰","text":"瓦罐先生俗姓于。\n三千里路乞残馀。\n逍遥坦荡称吾徒。\n常认此般真活计，自然不受世情拘。\n修完性月照冰壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠于先生","author":"马钰","text":"性烛光辉见玉壶。\n心香馥郁袅金炉。\n刀圭烂饮醉真如。\n花萼楼前横走马，华阴县里倒骑驴。\n五灵年少捧神珠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠马姑姑","author":"马钰","text":"玉女瑶仙佩玉瓢。\n芰荷香里弄风飙。\n西江月内采芝苗。\n九转功成长寿乐，三田宝结恣逍遥。\n迎仙客去上清霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠王公","author":"马钰","text":"玄上玄玄且莫寻。\n日常除划我人心。\n清闲欢乐作知音。\n莫向灵台留一物，自然结正水中金。\n恁时云步上瑶岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠王刘二先生","author":"马钰","text":"莫把修行作等闲。\n身闲不似放心闲。\n运行日月莫教闲。\n保养下丹无漏泄，方迁绛阙炼中丹。\n上灵宫满得三丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠宁海于瓦罐","author":"马钰","text":"水狗喷烟罩玉轩。\n火牛入海种芝田。\n白莲花朵间青莲。\n碧眼胡僧眉拂地，霜毛兔子角冲天。\n如来圆相本来圆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠甘张二先生","author":"马钰","text":"清净无为锁密机。\n金波玉滟结刀圭。\n奇哉妙矣至幽微。\n捉住杳冥昏默处，能餐能饮更能携。\n无中养就化生儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠刘处玄","author":"马钰","text":"无作无为道庶几。\n不须把钓坐渔矶。\n常清常净好根基。\n玉液通传心绝虑，金光溉济性忘机。\n处玄通妙合三机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠华亭李济川","author":"马钰","text":"十一吾侪一个来。\n十人缘绊未心灰。\n莫教失脚落轮回。\n早早投玄离苦海，闲闲炼气养灵胎。\n功成同去赴蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠朱先生","author":"马钰","text":"一饱馨香野菜羹。\n临溪对竹自吟赓。\n不妨斡运甲和庚。\n何是道人真活计，日当卓午打三更。\n连云和月一齐耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠张山老","author":"马钰","text":"休羡罗帏与绛绡。\n红炉跳出碧尘销。\n玄中玄妙有缘消。\n颠倒阴阳真了了，不分白昼与清宵。\n一轮性月上丹霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙 赠张仙","author":"马钰","text":"决烈修持大丈夫。\n专心致志免三涂。\n冰清玉洁个尘无。\n空里人头欢笑落，壶中斗柄斡旋舒。\n丹成九转驾云舆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]