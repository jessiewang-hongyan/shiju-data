[{"title":"捣练子 赠文登马彦高","author":"马钰","text":"长寿酒，安乐杯。\n能医百病正当时。\n助清吟，乐道归。\n将进酒，凤衔杯。\n香山会上惜芳时。\n醉仙吟，月下归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠宁海州于清一","author":"马钰","text":"玄中妙，没言传。\n劝君休纵马猿颠。\n爇心香，达圣贤。\n圣贤喜，赐良缘。\n暗中细细剔根源。\n性灵灵，得做仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠华亭完颜知县","author":"马钰","text":"知县女，个真真。\n年将二六乐天真。\n敢求乞，任求真。\n天赋性，慕修真。\n将来功满内全真。\n跨祥云，礼上真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠张无尘先生","author":"马钰","text":"擒云马，纵云骖。\n行歌蹈舞放婪耽。\n任傍人，笑我憨。\n明六六，悟三三。\n三三六六味香甘。\n广收拾，不属贪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠李舍人","author":"马钰","text":"张都料，最奔波。\n盖因手作忒偻儸，惹偻儸，没奈何。\n听予劝，离巢窝。\n闲闲闲里炼冲和。\n得真修，止大罗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠京兆蓝党谢敬人","author":"马钰","text":"休执著，莫贪求。\n心头休要起闲愁。\n住行处，常自由。\n能如此，应真修。\n擒猿捉马炼霜球。\n行功成，赴十洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠终南三道友","author":"马钰","text":"张谦天，慕子迁。\n李公实等恋家缘。\n怎生得，通妙玄。\n离俗海，水云边。\n会仙庄上种金莲。\n行功成，性月圆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠清净散人","author":"马钰","text":"休执拗，莫痴顽。\n休迷假相莫悭贪。\n休起愁，莫害惭。\n听予劝，访长安。\n逍遥坦荡得真欢。\n守清净，结大丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"捣练子 赠醴泉三毕先生","author":"马钰","text":"外休著，外休搜。\n外边并没好因由。\n外无真，外事休。\n内堪补，内填修。\n内中清净水云游。\n内光明，内貌周。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"马风得遇修仙举。\n不羡人间富贵。\n筑个环墙居住。\n且避风霜雨。\n灵光昼夜常修补。\n异日功成归去。\n得住蓬莱洞府。\n侍奉吾师父。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"道家攀送呈玄趣。\n膝上自然琴抚。\n声透九霄妙处。\n引下青鸾舞。\n流霞满酌休辞诉。\n九节灵枝携去。\n相助亘初行步。\n直上蓬莱路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"昆嵛山迎蓬莱廓。\n连接蓬莱云脚。\n异景蓬莱辉霍。\n霞变蓬莱鹤。\n金风吹转蓬莱阁。\n自有蓬莱丹药。\n仙子蓬莱真乐。\n不负蓬莱约。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"在生已是为来错。\n死后形骸丑恶。\n合避三光寥廓。\n埋了休拾掇。\n子孙办孝如媒妁。\n迁葬分明嬉谑。\n并骨共同棺椁。\n显露贪欢乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"鸳鸯未老头先白。\n有甚因缘难测。\n说破自然会得。\n盖为贪迷色。\n人还省悟溪山蓦。\n物外专修道德。\n清净神仙法则。\n得住蓬莱宅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"马钰","text":"悟来顿觉从前错。\n怎敢起心生恶。\n斡运蓬莱银廓。\n个内如抬掇。\n无中婴姹凭媒妁。\n须用黄婆为谑。\n和会出离琼椁。\n天上长安乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 五台月长老来点茶","author":"马钰","text":"五台月老通三要。\n便把三彭除剿。\n运用三车皎皎。\n般载三乘妙。\n龙华三会心明晓。\n顿觉三光并照。\n个内三坛设醮。\n自己三清了。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 劝长安三坛李法师","author":"马钰","text":"李公知观听予劝。\n只恁未为长便。\n悟取水云清浅。\n玄妙心通显。\n木人手段非凡箭。\n便把三乘救援。\n射透个中宫殿。\n得见如来面。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 自悟","author":"马钰","text":"父兄未老先亡过。\n已后不须发课。\n决定轮排到我。\n生死如何躲。\n悟来便做飍飍么。\n一任人猜心破。\n认正个中些个。\n有分携云朵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1253,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 思辽阳高巨才","author":"马钰","text":"桃源忆故人归去。\n别后常怀无绪。\n未审官游何处。\n忘了当初遇。\n我今物外修行做。\n但愿他家开悟。\n猛弃荣华贵富。\n共结云霞侣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1254,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 赴黄箓醮赠道众","author":"马钰","text":"寻神救苦酬予愿。\n海角天涯心遍。\n暗诱人离火院。\n物外真修炼。\n寻思地狱心寒颤。\n救拔亡灵经念。\n枷锁自然脱免。\n总赴蓬莱宴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1255,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 重阳师父相引登蓬莱阁","author":"马钰","text":"风仙同我蓬莱宴。\n□玩蓬莱清浅。\n海市蓬莱出现。\n虎啸蓬莱苑。\n龙吟蟠绕蓬莱殿。\n鹤驭蓬莱凤辇。\n丹显蓬莱九转。\n堪应蓬莱选。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1256,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 桃源遁客问道","author":"马钰","text":"桃源遁客专来到。\n问我些儿玄妙。\n说破坎离颠倒。\n水火同炉灶。\n虎龙蟠绕成丹宝。\n五色祥云开导。\n引出胎仙不耄。\n得住蓬莱岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1257,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 寄主薄王彦文","author":"马钰","text":"前程合有修仙契。\n分外难求名利。\n所措莫能如意。\n激出修行志。\n算来生死无人替。\n肯把自身家累。\n要占十洲仙位。\n清净功夫累。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1258,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 寄张知观联珠","author":"马钰","text":"岐阳镇上丹霞观。\n主张公手段。\n段丹田照管。\n顾常明灿。\n然内景真堪看。\n透性无紊乱。\n道祝贤遐算。\n得神仙伴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 寄赵公绰殿试","author":"马钰","text":"今朝传出些修炼。\n外把万缘锻炼。\n炼过更宜重炼。\n识破何劳炼。\n才方向里闲烹炼。\n六贼三尸频炼。\n镜灭心忘丹炼。\n得得成真炼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 寄谭刘郝三师友","author":"马钰","text":"谭凤刘郝云霞友。\n自在逍遥闲走。\n兴尽好归陕右。\n共话无中有。\n常清常净常无漏。\n便觉虎龙交媾。\n个内不神神秀。\n得饮长生酒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 得遇","author":"马钰","text":"马风曩日肥家子。\n缘甚黜妻屏子。\n便做飘蓬贫子。\n因遇重阳子。\n从斯道号丹阳子。\n尘事并无些子。\n悟彻男儿产子。\n决定成仙子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 赠孔庵主昆仲","author":"马钰","text":"孔翁四个亲兄弟。\n小者二人倾逝。\n已后不须卜筮。\n想着先垂泪。\n死生生死如何避。\n早把家缘猛弃。\n物外行功积累。\n得得成仙位。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人 赠古刘二先生","author":"马钰","text":"前程合有修仙分。\n竞利争名吃顿。\n遏意逆情愁闷。\n逼得