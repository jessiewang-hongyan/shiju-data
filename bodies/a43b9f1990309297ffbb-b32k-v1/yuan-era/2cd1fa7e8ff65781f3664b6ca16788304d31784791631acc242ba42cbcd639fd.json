[{"title":"寄子昂君墨竹","author":"管道升","text":"夫君去日竹初栽，竹已成林君未来。\n玉貌一衰难再好，不如花落又花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"管道升","text":"春晴今日又逢晴，閒与儿曹竹下行。\n春意近来浓几许，森森稚子石边生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自题画竹","author":"管道升","text":"罢宴归来未夕阳，锁衣犹带御炉香。\n侍儿不用频挥扇，修竹萧萧生嫩凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"管道升","text":"山回新绮阁，竹掩旧朱门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题壁","author":"万俟蕙柔","text":"夫官湖右妾江东，三载孤帏日夕空。\n葵萼有心终向日，柳花无力苦随风。\n两行血泪孤灯下，万里家乡一枕中。\n雁到衡阳身即返，有书难倩子卿鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北行诗","author":"杜氏妇","text":"北行幼女别乡闾，一似昭君远嫁胡。\n默默一身离故国，区区千里逐征夫。\n慵拈箫管吹羌曲，懒系罗裙舞鹧鸪。\n多少眼前悲泣事，不堪花柳旧江都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋庭柏","author":"刘氏","text":"群卉枯落时，挺节成孤秀。\n既保岁寒心，不在遐年寿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中漫成","author":"陆蕙奴","text":"耶娘重利妾身轻，独抱琵琶万里行。\n弹后月明人拍手，不知元是断肠声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄申生","author":"王娇红","text":"云重月难见，风狂雨不成。\n尺书从寄意，倾泪若为情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送别","author":"王娇红","text":"绿叶阴浓花正稀，声声杜宇劝君归。\n相如千里悠悠去，不道文君泪湿衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永别","author":"王娇红","text":"合欢带上真珠结，个个团圆又无缺。\n当时把向掌中看，岂意今为千古别。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄别申生二首 其一","author":"王娇红","text":"如此钟情古所稀，吁嗟好事到头非。\n汪汪两眼西风泪，独向阳台作雨飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄别申生二首 其二","author":"王娇红","text":"月有阴晴与圆缺，人有悲欢与会别。\n拥炉细语鬼神知，拚把红颜为君绝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄夫诗","author":"余氏","text":"妾谁怨兮薄命，一气孔神兮化生若甑。\n春山娟兮秋水净，秉贞洁兮妾之性。\n聊复歌兮遣兴。\n夜梦兮食梨，命灵氛兮与子占之。\n曰行道兮迟迟，敛角枕兮粲如。\n风动帷兮心而悲。\n云黯黯兮雪飞棘，夫子介兮如石。\n苦复留兮不得，望平原兮太息。\n涕泗横兮沾臆。\n送子去兮春树青，望子来兮秋树零。\n树有枝兮枝有英，我胡为兮茕茕？\n孑在此兮山城。\n织女兮牛郎，岂谓化兮为参商。\n欲径度兮河无梁。\n霜露侵袭兮，病偃在床。\n嗟嗟夫子兮，谁与缝裳？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑生","author":"吴氏","text":"慈亲未识意如何，不肯令君画翠蛾。\n自是杏花开较晚，梅花占得旧情多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"孙蕙兰","text":"露下庭梧叶，风吹月桂花。\n登楼闻过雁，开户见栖鸦。\n绣帘当雪捲，银烛背风然。\n雪晴山显翠，风暖水生纹。\n萱草当阶绿，樱桃落地红。\n芍药开时病，荼蘼落处愁。\n玉钗簪茉莉，罗扇绣芙蓉。\n窗前垂柳分春色，镜里幽兰对晓妆。\n花间影过那知燕，柳外声来不见莺。\n慈亲教婢回金剪，娇妹嗔人夺绣针。\n妆成宝镜杨花过，行出珠帘燕子归。\n自倾瓮里春泉水，亲灌阶前石竹花。\n海棠带雨胭脂重，杨柳凝烟翡翠浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄衣诗","author":"刘氏","text":"情同牛女隔天河，又喜秋来得一过。\n岁岁寄郎身上服，丝丝是妾手中梭。\n剪声自觉和肠断，线脚那能抵泪多。\n长短只依先去样，不知肥瘦近如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答外","author":"韩氏","text":"碧纱窗下折缄封，一纸从头彻底空。\n料想仙郎无别意，忆人长在不言中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巴家富","author":"李氏","text":"谁道巴家窘，巴家十倍邹。\n池中罗水马，庭下列蜗牛。\n燕麦纷无数，榆钱散不收。\n夜来添骤富，新月挂银钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏枕上绣梅","author":"万氏","text":"洒潇英标别一奇，岁寒心事有谁知？\n妾心正欲同贞白，枕上殷勤绣一枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄外","author":"吴氏","text":"昔君曾奏三千牍，凛凛文风谁敢触？\n乡老荐贤亲献书，邦侯劝驾勤推毂。\n马头三控登长途，谓君此去离场屋。\n整顿罗裳出送君，珠泪盈盈垂两目。\n枕前一一向君言，马头犹自叮咛嘱。\n青衫寸禄早荣归，莫遣妾心成局促。\n秋天冬暮风雪寒，对镜懒把金蝉簇。\n梦魂夜夜到君边，觉来寂寞鸳鸯独。\n此时行坐閒窗纱，忍泪含情眉黛蹙。\n古人惜别日三秋，不知君去几多宿？\n山高水阔三千里，名利使人复尔尔。\n昔年曾拨伯牙弦，未遇知音莫怨天。\n去年又奏相如赋，汉殿依前还不遇。\n时人不知双字讹，平川倏忽起风波。\n当时南宫罢捷音，教妾沉吟杵中心。\n为君滴下红粉泪，红罗帐里湿鸳衾。\n愤愤调琴蝉鹊噪，默默吟诗怨桂林。\n千调万拨不成曲，争那胸中气相掬。\n千思万想不成诗，心如死灰自得知。\n料得君心当此际，已拚抛却閒田地。\n朝朝暮暮望君归，日在东隅月在西。\n碧落翩翩飞雁过，青山切切子规啼。\n望尽一月复一月，不见音容寸肠结。\n又闻君自河东来，夜夜不教红烛灭。\n鸡鸣犬吠侧耳听，寂寂不闻车马音。\n自此知君无定止，一片情怀冷如水。\n既无黄耳寄家书，也合随时寄雁鱼。\n日月逡巡又一年，何事归期竟杳然？\n堂上双亲发垂白，用尽倚门多少力。\n孟郊曾赋游子行，陟岵如何不见情。\n室中儿女亦双双，频问如何客异乡？\n异乡知是育才处，人情不免且契慕。\n低头含泪告儿女，游必有方况得所。\n八月凉风满道途，好整征鞍寻旧路。\n吾乡虽多俊秀才，往往怕君头角露。\n圣朝飞诏下来春，青毡早早慰双亲。\n飞龙公道取科第，男儿事业公卿志。\n笔下密密为君言，书中重重写妾意。\n秋林有声秋夜长，愿君莫把斯文弃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花","author":"盛贞一","text":"古枝点点类璚瑰，不假天工为剪裁。\n月夜孤标怜晚景，冰溪瘦骨绝尘埃。\n寒香泣雨魂难返，贞节凌霜志莫回。\n桃李未曾争艳冶，半窗疏影自徘徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢世诗","author":"赵氏","text":"九重缥缈黄金阙，十二玲珑白玉楼。\n明朝了却人间梦，独跨青鸾自在游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻雁","author":"陈氏","text":"浪喜灯花落又生，夜寒频放剪刀声。\n游鸿不寄征夫信，顾影娉婷无限情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊泰不华","author":"范秋蟾","text":"江头沙碛正交舟，江上怀人百战忧。\n力屈杲卿生骂贼，功成诸葛死封侯。\n波涛汹汹鲸横海，天地寥寥鹤怨秋。\n若使临危图苟免，读书端为丈夫羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙剑合曲","author":"贾蓬莱","text":"龙剑埋没狱间久，巨灵昼卫鬼夜守。\n蛟螭藏，魍魉走，紫焰煌煌射牛斗。\n影含秋水刃拂霜，司空照之识早有。\n丰城发函留其良，千岁纯钩始分首。\n龙剑灵，是龙精，瑩如鹇尾摇清冰。\n雄作万里别，雌复千古情。\n会当逐风雷，相寻入延平。\n天遣雷焕儿，佩之大泽滨。\n铿然一跃同骏奔，骇浪惊涛白昼昏。\n始知神物自有偶，千秋万岁肯离群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悲笳四拍","author":"赵鸾鸾","text":"我生之初尚无为，我生之后元运衰。\n夫与妻兮忽仳离，父与母兮生死安可知！\n狼烟四起兮沸鼓颦，锋镝成林兮盛旌旗。\n人民涂炭兮城郭坏，礼义灭亡兮法度隳。\n身流落兮天一涯，肠欲绝兮心孔悲！\n山可平兮河可塞，妾怨苦兮无穷期。\n蜂蚁屯聚兮豺虎嘷，心毒狠兮体腥臊。\n烟尘澒洞兮人窜逃，寒沙暴骨兮没蓬蒿。\n亡家遇乱兮伤吾曹，义重命轻兮如鸿毛。\n誓捐此生兮期弗辱，仰天俯地兮独烦劳。\n弃贤俊兮逐凶愚，东西转徙兮卒无宁居。\n贪淫是乐兮杀戮是娱，所在剽掠兮所过为墟。\n发坟墓兮焚燬室庐，闺门孱弱兮被虏驱。\n舍生取义兮捐微躯，谁云女妇兮丈夫弗如？\n行处坐处兮，思念我乡曲。\n地角天涯兮，不见我骨肉！\n姑亡舅殁兮家倾覆，逃窜苟活兮被驱逐。\n伉俪离背兮何时复？\n幸兹陋躯兮得免污辱。\n谁为义士兮挥金玉？\n歌行路兮妾身赎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和金生","author":"刘翠翠","text":"平生每恨祝英台，怀抱何为不早开？\n我愿东君勤用意，早移花树向阳栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"缝衣领诗","author":"刘翠翠","text":"一自乡关动战锋，旧愁新恨几重重。\n肠虽已断情难断，生不相从死亦从。\n长使德言藏破镜，终教子建赋游龙。\n绿珠碧玉心中事，今日谁知也到侬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题壁","author":"旷家妇","text":"泾渭能分浊与清，妾身岂肯堕风尘！\n孤儿未必从他姓，一女何曾侍二人。\n白刃自伤心似铁，黄泉要见骨如银。\n深山落日猿啼处，过客闻之亦惨神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"被掠诗","author":"徐綵鸾","text":"万水千山去路赊，青鞋踏破几层沙。\n登山绝顶重逢岭，渡水尤深又复涯。\n雁字只传夫与子，鱼书难寄母和爷。\n回头遥望乡关处，云下峰前是我家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"徐綵鸾","text":"惟有桂林桥下水，千年照见妾心清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"裂帛题诗","author":"何氏","text":"妾长朱门十九春，岂期今逐虏囚奔。\n失身无补君王事，死节难酬夫婿恩。\n江静从教沈弱质，月明谁与吊归魂！\n只愁父母难相见，愿与来生作子孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"啮指题壁","author":"胡妙端","text":"弱质空怀漆室忧，搜山千骑入深幽。\n旌旗影乱天同惨，金鼓声淫鬼亦愁。\n父母劬劳何日报，夫妻恩爱此时休。\n九泉有路还归去，那个云边是越州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"托歌","author":"董淑贞","text":"天苍苍兮不吾家造，地茫茫兮不吾身容。\n不造不容，托乎火以相从！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏天花板","author":"元氏","text":"补天手段暂施张，不许纤尘落画堂。\n寄语新来双燕子，移巢别处觅雕梁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题管夫人长明庵图","author":"妙湛","text":"双树阴阴落翠岩，一灯千古破幽关。\n也知诸法皆如幻，甘老烟霞水石间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅花","author":"梅花尼","text":"终日寻春不见春，芒鞋踏破岭头云。\n归来笑撚梅花嗅，春在枝头已十分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"座上题诗","author":"徐氏","text":"平康巷里掌中身，翠舞珠歌玉树春。\n不得籍除今义死，天教娼妇愧降臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌虚阁避暑玩月四首 其一","author":"罗爱卿","text":"画阁东头纳晚凉，红莲不似白莲香。\n一轮明月天如水，何处吹箫引凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌虚阁避暑玩月四首 其二","author":"罗爱卿","text":"月出天边水在湖，微澜倒浸玉浮图。\n搴帘欲共嫦娥语，却恨林间鸟乱呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌虚阁避暑玩月四首 其三","author":"罗爱卿","text":"手弄双头茉莉枝，曲终不觉鬓云欹。\n佩环响处飞仙过，愿借青鸾一只骑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌虚阁避暑玩月四首 其四","author":"罗爱卿","text":"曲曲栏干正正屏，六铢衣薄懒来凭。\n夜深风露凉如许，身在瑶台第一层。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"暨氏","text":"多情樵牧频簪髻，无主峰莺任宿房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"愁愤诗","author":"阿?主","text":"吾家住在雁门深，一片閒云到滇海。\n心悬明月照青天，青天不语今三载。\n欲随明月到苍山，误我一生踏里彩。\n吐噜吐噜段阿奴，施宗施秀同奴歹。\n云片波鳞不见人，押不芦花颜色改。\n肉屏独坐细思量，西山铁立霜潇洒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题壁","author":"杨渊海","text":"半纸功名百战身，不堪今日总红尘。\n死生自古皆由命，祸福于今岂怨人！\n蝴蝶梦残滇海月，杜鹃啼破点苍春。\n哀怜永诀云南土，锦酒休教洒泪频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄梁王","author":"段宝","text":"烽火狼烟信不符，骊山举戏是支梧。\n平章枉死红罗帐，员外虚题粉壁图。\n凤别岐山祥兆隐，麟游郊薮瑞光无。\n自从界限鸿沟后，成败兴衰不属吾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄兄诗二首 其一","author":"段僧奴","text":"珊瑚勾我出香闺，满目潸然泪湿衣。\n冰鉴银台前长大，金枝玉叶下芳菲。\n乌飞兔走频来往，桂馥梅馨不暂移。\n惆怅同胞未忍别，应知含恨点苍低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄兄诗二首 其二","author":"段僧奴","text":"何彼秾秾花自红，归车犹别洱河东。\n鸿台燕苑难经目，风刺霜刀易塞胸。\n云旧山高连水远，月新春叠与秋重。\n泪珠却似通宵雨，千里关河几处逢？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"段明","text":"方今天下平犹易，自古云南守独难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈日照","text":"池鱼便作鹍鹏化，燕雀安知鸿鹄心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游天长故乡","author":"陈日烜","text":"景清幽物亦清幽，一十仙洲此一洲。\n百部笙歌禽百舌，千行奴仆橘千头。\n月无事照人无事，水有秋涵天有秋。\n四海已清尘已净，今年游胜旧年游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅","author":"陈日焌","text":"五出圆葩金撚须，珊瑚沈影海鳞浮。\n个三冬白枝前面，此一瓣香春上头。\n甘露歌凝痴蝶醒，夜光如水渴禽愁。\n嫦娥若识花佳处，桂冷蟾寒只么休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山房漫兴","author":"陈日焌","text":"谁缚更将求解脱，不凡何必觅神仙。\n猿閒马倦人应老，依旧云庄一榻禅。\n是非言逐朝花落，名利心随夜雨寒。\n花尽雨晴山寂寂，一声啼鸟又春残。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"口占","author":"陈日焌","text":"红润剥龟脚，黄香炙马鞍。\n山僧持净戒，同坐不同餐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赐范迈","author":"陈日煃","text":"台乌久矣噤无声，整顿朝纲事匪轻。\n殿上昂藏鹰虎气，男儿到此是功名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"世子","text":"自顾不才惭锡土，只缘多病欠朝天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈遂","text":"古来何物不成土，死后惟诗可胜金。\n山岂忍埋成器玉，月空自照少年魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈遂","text":"蓑笠五湖荣佩印，桑麻数亩胜封侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈秀峻","text":"三世八丧千古痛，一身万里百年孤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄台中寮友","author":"陈元旦","text":"台端一去便天涯，回首伤心事事违。\n九陌尘埃人易老，五湖风雨客思归。\n儒风不振回无力，国势如悬去亦非。\n今古兴亡真可鉴，诸公何忍谏书稀？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句二首 其一","author":"陈爱山","text":"宝鼎香销沈水烟，碧纱春帐薄如蝉。\n洞章吟罢愁成海，人在阑干月在天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句二首 其二","author":"陈爱山","text":"窗畔香云暗碧纱，平分午睡不禁茶。\n相思在望登楼怯，一树木棉红尽花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送友人使元","author":"黎括","text":"驿路三千君据鞍，海门二十我还山。\n中朝使者沧江客，君得功名我得閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝笔","author":"范迈","text":"自从谪落下人间，六十馀年一瞬看。\n白玉楼前秋夜月，朝真依旧傍阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追挽陈岑楼","author":"阮忠彦","text":"平生恨不识岑楼，一读遗编一点头。\n蓑笠五湖荣佩印，桑麻数亩胜封侯。\n世间此语谁能道？\n万古斯文去已休。\n欲酹骚魂何处是？\n烟波万顷使人愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"阮忠彦","text":"介轩先生庙廊器，茂龄已有吞牛志。\n年方十二太学生，才登十六充廷试。\n二十有四入谏官，二十有六燕京使。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]