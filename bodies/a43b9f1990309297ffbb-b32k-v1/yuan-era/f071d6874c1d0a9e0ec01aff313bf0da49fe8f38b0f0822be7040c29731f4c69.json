[{"title":"赵中丞折枝图 其二 石榴","author":"马祖常","text":"乘槎使者海西来，移得珊瑚汉苑栽。\n只待绿阴芳树合，蕊珠如火一时开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵中丞折枝图 其三 芙蓉","author":"马祖常","text":"馆娃宫里醉西施，不觉秋生水殿时。\n酒病却嫌丹粉恶，洗妆天上影娥池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵中丞折枝图 其四 山茶","author":"马祖常","text":"火齐珠红拂翠翘，石家步障晓寒消。\n千枝蜡炬烧春夜，羯鼓催花打六么。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏月词","author":"郑奎妻","text":"芭蕉叶展青鸾尾，萱草花含金凤嘴。\n一双乳燕出雕梁，数点新荷浮绿水。\n困人天气日长时，针线慵拈午漏迟。\n起向石榴阴畔立，戏将梅子打莺儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"缺题 其一","author":"陈继儒","text":"草绿蘋香縠水纹，秋山寂寂冷斜曛。\n庭前双桂窗留影，时宿寒鸦与断云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"缺题 其二","author":"陈继儒","text":"秋老江濒漾夕空，萧萧枫叶挂疏红。\n那知三泖清秋思，偏寄芦花一寺中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬月词","author":"郑奎妻","text":"山茶未开梅先吐，风动帘旌雪花舞。\n金盘冒冷塑狻猊，绣幕围春护鹦鹉。\n倩人呵笔画双眉，脂水凝寒上脸迟。\n妆罢扶头重照镜，凤钗斜压瑞香枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢人送杏子诗","author":"马祖常","text":"杏子黄金色，筠笼出蓟丘。\n味甘醒午寝，可是督诗邮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有感 其二","author":"许衡","text":"狐死知首丘，人生恋乡土。\n我心久焦劳，宿疾安能愈。\n所贵还故乡，微骸近先祖。\n他事足叹嗟，西风动寰宇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有感 其三","author":"许衡","text":"归兴不可遏，归程待何时？\n悠悠故乡心，一夕千里驰。\n西风动霄汉，惨惨令人悲。\n况我多病身，天涯久栖迟。\n交游义难忘，岂忍轻别离。\n重念丘陇远，娇儿正愚痴。\n因循死异邑，后世将何遗。\n所愿经营日，及此未全衰。\n树桑墙以下，开畦水之湄。\n既得舒困难，且可为镃基。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有感 其四","author":"许衡","text":"幼无孝悌称，老无恩泽施。\n唯有近先茔，一死乃其宜。\n诸君苦留连，雅意金兰期。\n我自无遐福，形骸变焦痿。\n生平尚求友，得友还差池。\n中怀起愁叹，欲别难为辞。\n试将问吾庐，何日当西之？\n缓急有拟议，行止更无疑。\n作诗叙恳款，为报吾亲知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"余山林多暇瞌睡之馀偶成偈语自娱纸墨少便不欲记之云衲禅人请书盖欲知我山中趣向于是静思随意走笔不觉盈帙故掩而归之复嘱慎勿以此为歌咏之助当须参意则有激焉 其十三","author":"清珙","text":"四十馀年独隐居，不知尘世几荣枯。\n夜炉助煖烧松叶，午钵充饥摘野蔬。\n坐石看云閒意思，朝阳补衲静工夫。\n有人问我西来旨，尽把家私说向渠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"余山林多暇瞌睡之馀偶成偈语自娱纸墨少便不欲记之云衲禅人请书盖欲知我山中趣向于是静思随意走笔不觉盈帙故掩而归之复嘱慎勿以此为歌咏之助当须参意则有激焉 其十四","author":"清珙","text":"茅屋青山绿水边，往来年久自相便。\n数株红白桃李树，一片青黄菜麦田。\n竹榻夜移听雨坐，纸窗晴启看云眠。\n人生无出清閒好，到得清閒岂偶然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"余山林多暇瞌睡之馀偶成偈语自娱纸墨少便不欲记之云衲禅人请书盖欲知我山中趣向于是静思随意走笔不觉盈帙故掩而归之复嘱慎勿以此为歌咏之助当须参意则有激焉 其十五","author":"清珙","text":"浮世光阴有几何，谁能挈挈又波波。\n厨空旋去寻黄独，衲破方思剪绿荷。\n麈尾罢拈言语断，佛经忘看蠹鱼多。\n可怜身在袈裟下，趣境攀缘事事过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观物 其一","author":"许衡","text":"行路纷如缕，间关权与数。\n翻成拙者谋，一往竟不悟。\n我始窥其端，居宽尚盘桓。\n盘桓非怯尔，后事当无难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观物 其二","author":"许衡","text":"万物备吾身，身贫道未贫。\n观时见物理，主静得天真。\n心爽星辰夜，情欣草木春。\n自怜离乱后，能作太平人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观物 其三","author":"许衡","text":"事物形虽同，中间势各异。\n推迁无宁期，倏忽已易位。\n智者识机微，安焉处平易。\n人生贵无私，莫使闻见累。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆贾君玉","author":"许衡","text":"贾君清介士，吾辈鲜能群。\n守志王元伯，甘贫范史云。\n铜台书废读，东郡酒方醺。\n何日寻先约，青灯共夜分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟赠曹彦泽","author":"许衡","text":"益友重曹君，标孤出世氛。\n壮怀期远术，高谊薄层云。\n恶乱求山隐，亲贤愿德薰。\n我生良有幸，岁晚此同群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登东城","author":"许衡","text":"步履上东城，秋风晚更清。\n乱云随日下，荒草过堤平。\n野迥宽凝伫，诗成促后生。\n何当常似此，慰我病中情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游北观","author":"许衡","text":"扶杖古城荒，飘然意可伤。\n道宫烟锁树，农舍雨颓墙。\n捕吏翻疑寇，平人却笑狂。\n长吁空仰首，天际正苍苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂言二首 其一","author":"许衡","text":"磊落青山万仞高，虚崖绝险骇猿猱。\n从谁得上岩龛住，免我从来俗事劳。\n晓日烟霞明涧壑，霁天霏霭散林皋。\n休言只好宽凝伫，满地干戈学善逃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用行甫韵","author":"许衡","text":"蛟鼍不肯脱渊深，鸟雀还知宿茂林。\n笑我羁孤成蹇蹇，于今衰老复骎骎。\n愁多未易追前事，病久犹当屈壮心。\n闻道西溪田可得，安栖从此得追寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答董瑞卿","author":"许衡","text":"何人竖起掌中坚，檐稳推高与顷连。\n涉世更谁如我拙，保身从昔慕君贤。\n青山有约期终老，白日无功阅旧编。\n惭负新诗酬未得，祗容竭力效耕田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登天王台","author":"许衡","text":"楼阁荆榛几变更，登临祗见古人情。\n当年胜迹无人问，依旧春风草又生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿卓水 其二","author":"许衡","text":"水自清声竹有风，我来端欲豁尘蒙。\n明朝杖履西城路，怅望家山翠霭中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题罗汉过海图","author":"吴澄","text":"阿谁解衣盘礴裸，作此中乘第一果。\n等閒地狱骇屠沽，如许风波无不可。\n巨浸弥天灵怪百，现前幻境元非我。\n腾蹈逍遥容易去，只有虚空无障裹。\n般若岸，金刚山，超登只在霎时间。\n为吾说与诸尊者，更有海门关外关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张道人开华盖山路","author":"吴澄","text":"我家紫玄洞天前，洞天仰与天相连。\n羊肠诘曲石荦确，每欲飞上愁攀缘。\n道人可是坚愿力，开辟大道何坦然。\n一跻从此出世外，着我直透昆崙巅。\n浮丘握手莞尔笑，与子别去何千年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四皓图","author":"吴澄","text":"皓首出山谷，从容定储宫。\n储皇已御极，论赏将谁同。\n飘然拂衣去，讵敢贪天功。\n饱茹石上芝，坐荫岩下松。\n商颜郁嵯峨，千载馀清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送邻人元德之武昌","author":"吴澄","text":"读律已三世，能诗新有声。\n忽辞亲舍去，远作武昌行。\n江汉秋风起，孙曹故月明。\n旧游曾感慨，送子倍关情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和林提举韵","author":"吴澄","text":"昼日閒庭步，秋云万里天。\n眼前俱实际，身外一随缘。\n得意浑忘老，论交岂问年。\n此中真乐在，不要华山眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为舒景春赋东皋","author":"吴澄","text":"东皋种杏者，今住杏花村。\n收谷虎卫道，衔珠蛇报恩。\n窗红开晓沴，草碧验春温。\n岂待閒舒啸，柏湖真有孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠裴子晋","author":"吴澄","text":"怪子抛家去，归来非故吾。\n阅人如水镜，知己慎江湖。\n宿雨添新涨，春风满旧庐。\n匆匆又言别，聊为赋骊驹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖山水","author":"吴澄","text":"一水两山间，水如练带山如阛。\n昔见江山似图画，今观图画如江山。\n米家下笔亦等閒，卢家珍袭同瑶环。\n一朝身后落人手，又为好者开欢颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿王讲师","author":"吴澄","text":"欲雪未雪云黯黑，不知此日神仙谪。\n桃实今经几度红，梅花仍似当年白。\n厌向闽山食荔蕉，喜来江浦访鸾箫。\n广文客舍寒如许，自有春风长药苗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用赠李粲然韵述怀","author":"吴澄","text":"故里香粳滑欲流，归田计晚愧迟留。\n悬知海上三山客，尘视人间万户侯。\n南去日寻吴市卒，北来欢共李仙舟。\n玄翁一室浑无白，谁识王龚贡鲍优。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贡院中和张仲美","author":"吴澄","text":"墙外浮屠压古城，案头文字浩纵横。\n不辞霜鬓年华老，又办天朝岁贡英。\n秋陇故园迷蝶梦，晓窗客枕厌鸡声。\n何当孺子亭前去，省想高风浣俗情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日登楼","author":"吴澄","text":"黄叶黄花竞献新，德星来聚此相亲。\n云烟暮色楼头眼，风雨秋声客里人。\n诗兴悠悠千载事，酒杯盎盎一时春。\n其期白首各自爱，莫负乾坤七尺身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠金精丁葬师","author":"吴澄","text":"古哲安坟遗旧踪，后人得术绍真宗。\n毒眸远赛天边鹘，健足生拿地上龙。\n何处无神司采择，谁家有福定遭逢。\n结庐亦欲娱吾老，试为云间觅一峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送空山雷讲师门人丹陵胡道士游京师","author":"吴澄","text":"远游谁为赋新篇，来自丹陵小洞天。\n拂日一鞭聊复尔，御风双袂已飘然。\n快看鹏海三千里，早證龙沙八百仙。\n莫恋射熊春梦乐，赠诗人在斗牛边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵胡器之问病","author":"吴澄","text":"莺声睍睆燕差池，春到閒中日更迟。\n偶蹑清都陪净侣，谁知胜境即良医。\n屋头月上元无夜，树杪风来似有期。\n坐客屡谈浑忘答，问余还职在何时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王学士七夕新秋","author":"吴澄","text":"煌煌桴鼓引双旌，道是天孙大礼成。\n金镜南飞光欲半，银潢西去寂无声。\n佳期一夕人谁见，别思千年恨未平。\n最怪河东五星丽，应嫌抱拙要中更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵息窝道人","author":"吴澄","text":"三年只影落天涯，望极南云眼欲花。\n道上已惊仙枕梦，河边误泛客星槎。\n枣梨秋熟供新饭，桃李春荣满旧家。\n喜得息窝消息好，黄金粲粲待披沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中即事次韵元复初郊行 其一","author":"吴澄","text":"急雨连宵井也浑，城居寥落似山村。\n停披尽看书堆案，绝饮空馀酒满樽。\n日有虚皇相伴侣，时逢嘉客细评论。\n青灯一室长如昼，未觉门前四野昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用鲁山段录事和李佥士丁麻姑韵时段奉宪檄赈济","author":"吴澄","text":"咿轧篮舆从事衫，泥途滑滑石巉巉。\n急援野莩填沟壑，敢避行难似陇函。\n春气顿回萎草木，长林惊见古松杉。\n一夫弗获真吾愧，谁道鲁山非傅岩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送几泉石上人南归","author":"吴澄","text":"春风吹醒泉石梦，一锡飞来到日边。\n世界空花俱幻尔，家山老木故依然。\n飘飘去住云归岫，处处圆明月在天。\n亦欲从师了耕种，县南村外有良田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九皋亭","author":"吴澄","text":"亭皋界分与天宽，小小园林望转安。\n门外图书聊作府，庭前花卉静宜栏。\n清怀不遣尘埃到，好句留将久远看。\n放鹤从教云里去，也应回顾此江干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道山作","author":"吴澄","text":"回环湖水带溪湾，彷佛瀛洲海岛间。\n地上云烟接天界，壶中日月照人寰。\n百年竹木青春在，一院香风白昼閒。\n只怕名缰牵引出，双成怅望几时还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山水手卷","author":"吴澄","text":"家在江南山水村，黄尘陌上两眸昏。\n偶然此景梦中见，归路迢迢欲断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题桃源春晓图","author":"吴澄","text":"朦胧晓色破初春，一洞桃花树树新。\n此景世间真个有，只今云作捕鱼人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉题樵云吟藁以畀其子","author":"吴澄","text":"读尽樵云野叟诗，樵歌犹似入云时。\n歌声未共樵柯烂，底处樵家有此儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题溪南烟雨图","author":"吴澄","text":"小小溪南五亩宫，等閒袖手睇遥空。\n春风杨柳梧桐月，绝似垂竿烟雨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和逯公谨","author":"吴澄","text":"萧然非俗亦非僧，尚被红尘浣姓名。\n辜负东篱今岁菊，客窗晨树听鸡鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方壶图 其一","author":"吴澄","text":"信是苍厓画作仙，等閒幻出小罗天。\n太师铁画家藏旧，云黯烟昏四十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方壶图 其二","author":"吴澄","text":"忠臣死去去成仙，住在方壶大洞天。\n此境移来落尘世，也留遗迹伴千年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠碧溪相","author":"吴澄","text":"溪水无心管是非，临溪照影笑山鸡。\n满身文彩翻成误，虚影何堪炫碧溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭泽遇成之之京都","author":"吴澄","text":"人世茫茫名利场，青年快意一观光。\n顾余白发归来晚，羞过渊明五柳庄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明皇春宫按乐图","author":"龙从云","text":"华清宫殿春沈沈，宫门杨柳垂黄金。\n玉环新度霓裳曲，曲声酣动君王心。\n融融污体生春困，芙蓉露白桃花嫩。\n可怜飞燕在昭阳，李白文章有遗恨。\n树头花暖莺啼早，满院嫔妃总含笑。\n门外千官进入朝，三郎沈醉不知晓。\n渔阳回首飘胡尘，花钿委地徒沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪花曲","author":"龙从云","text":"枯篁漠漠吹北风，黄河水流凝不通。\n大孙手持白鸾尾，扫尽琪花舞碧空。\n昆山玉碎琼楼裂，老龙起舞惊明月。\n应是游魂不觉寒，醉吟纸帐春云热。\n东家娇娘厌桃李，学绣宫花锁窗里。\n冷袖擎来欲细观，隔帘火气催成水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"美人纱带","author":"龙从云","text":"满眼春娇倚绣床，玉钩新绾藕丝长。\n鸳鸯机上舒晴雪，翡翠帘前蹴晓霜。\n拾翠不知罗袜润，踏花犹隔绣鞋香。\n几回暗忆吹箫侣，背立东风咏凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仙坛","author":"龙从云","text":"碧坛纛影荫龙蛇，骑鹤归来枣似瓜。\n仙语风前飘玉屑，道衣天上剪云霞。\n寒潭六月犹无暑，老木千年尚有花。\n采药青童来借问，苍烟起处是谁家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天游亭","author":"贡奎","text":"凉秋马肥健，山行快閒心。\n斜阳众峰出，岂待穷追寻。\n兹亭独崔嵬，超然散尘襟。\n瑶汉湛虚碧，灵飙荡幽阴。\n滉漾连沃野，苍茫俯乔林。\n真游本无驭，妙道悟匪深。\n麻姑去何年，楼居集华簪。\n栋宇墠高下，薜萝径萧森。\n玄蝉解新蜕，嘒嘒高树吟。\n物理感时迁，世辙徒骎骎。\n怀哉学仙术，孤云度遥岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虎林玄妙观","author":"贡奎","text":"琳宫古崔嵬，独㨿山胜绝。\n天光垂帝座，照耀金碧色。\n修廊接层崖，俯目视深泽。\n阴阴木叶暗，石削苍壁冽。\n流泉出嵌空，六月洒飞雪。\n平生功名谋，洗我肝肺热。\n同游得幽人，再拜摩断碣。\n兴亡见唐汉，高爽了吴越。\n更拟穷幽探，驰景忽西灭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城客馆","author":"贡奎","text":"公宇日无事，阅书稍怡情。\n浩漫罔穷极，静定悟始明。\n笼禽动幽响，庭草遂微生。\n俯念节物变，宴处常惧盈。\n宁复辞劳苦，王事驱我行。\n雨馀夕阳漏，空雷殷残声。\n暄爽倏未定，云势方纵横。\n访遇当获趣，及兹烦抱婴。\n何时故园友，浊酒与同倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云东轩","author":"贡奎","text":"城中纷华地，借屋得佳处。\n居然俗士驾，欲诣不知路。\n门前柳阴深，溪水清可度。\n我行万里倦，颇觉懒成趣。\n有时忽来坐，谈笑竟忘去。\n孤云遂閒适，怅望心所寓。\n平生旷荡怀，落笔题幽素。\n要当居轩冕，此理常自悟。\n酒兴方未阑，青山任朝暮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]