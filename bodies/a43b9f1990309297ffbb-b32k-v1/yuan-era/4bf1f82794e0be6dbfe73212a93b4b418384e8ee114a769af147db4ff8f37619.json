[{"title":"百香诗 其九十四 农","author":"郭居敬","text":"一年生计一春忙，男力锄禾女采桑。\n粒粒盘中云子白，丝丝机上雪纨香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十五 牧","author":"郭居敬","text":"自裁竹笛取宫商，牛背闲吹过夕阳。\n几度草坡春梦觉，满身带得野花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十六 渔","author":"郭居敬","text":"小小扁舟一叶长，平生活计水云乡。\n夜寒独拥蓑衣睡，风送溪花入梦香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十七 樵","author":"郭居敬","text":"清晨腰斧白云乡，山路萧萧落叶黄。\n折得梅花皈去晚，担头斜插一枝香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十八 风","author":"郭居敬","text":"扫除炎暑作清凉，意气飘飘远奉扬。\n几度广寒宫里过，桂花吹动满天香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十九 花","author":"郭居敬","text":"花底经论孰主张，千红万紫竞低昂。\n洛阳城里春三月，薰透东风处处香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其一○○ 雪","author":"郭居敬","text":"万里遥山翠色藏，玉为茅舍粉为墙。\n无端堆积前村里，减却梅花一半香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其一○一 月","author":"郭居敬","text":"天上嫦娥试晚妆，团团一镜照清光。\n蟾宫果有长生药，乞与诗人一粒香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题刘如村昭忠逸咏","author":"王介夫","text":"炎祚当年去不还，欲成良史恨无官。\n一朝人物归吟兴，千古纲常纪笔端。\n林下董狐坚直节，山中杜甫老忠肝。\n后来多少偷生者，掩面西风不敢看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王月友归杭州 其一","author":"赵孟頫","text":"社燕秋鸿各自飞，我来君去苦相违。\n西湖西畔梅如雪，应有亲朋待子归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬罗伯寿 其一","author":"赵孟頫","text":"江西水清石凿凿，士生其间多异才。\n今去欧黄未为远，要须力挽古风回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"己卯腊八日雪为魏伯亮赋 其二","author":"虞集","text":"漫空飞絮散轻绵，所异寒威欲折弦。\n县令温存僵卧叟，词人解颂太平年。\n剪云为叶烦相寄，种玉成田不受怜。\n丹鼎温温千岁熟，乐天事业在知天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登岳","author":"李简","text":"三峰突兀与天齐，天门未到劳攀跻。\n层层石磴出林杪，萦回百折青云梯。\n盘石暂憩舒清眺，涧壑风来号万窍。\n水声俄在树梢头，疑有于菟天外啸。\n向晓才登日观峰，手披云雾开鸿濛。\n火轮欲上海波赤，金霞翻动苍龙宫。\n黄河一线几千里，吴越山川真地底。\n为数齐州九点青，更将伏槛窥东溟。\n李白不遇安期生，安得羽翼飞蓬瀛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"华山","author":"张翔","text":"三峰云满紫芝田，十丈花开玉井莲。\n白帝真源深固地，金精灏气远浮天。\n一杯沧海波摇月，九点齐州树带烟。\n千首新诗百壶酒，醉来骑鹤访群仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游补陀","author":"赵孟頫","text":"缥缈云飞海上山，挂帆三日上潺湲。\n两宫福德齐千佛，一道恩光照百蛮。\n涧草岩花多瑞气，石林水府隔尘寰。\n鲰生小技真荣遇，何幸凡身到此间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游补陀","author":"盛熙明","text":"惊起东华尘土梦，沧洲到处即为家。\n山人自种三株树，天使长乘八月槎。\n梅福留丹赤似橘，安期送枣大于瓜。\n金仙对面无言说，春满幽岩小白花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔浦春潮","author":"钱惟善","text":"江涨夜来高几寻，轻涛拍岸失蹄涔。\n迟明帆发星滩远，尽日舟横雨渡深。\n杜若风回赪鲤上，桃花浪起白鸥沈。\n越人艇子来何处，欸乃时闻空外音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒月泉","author":"杜本","text":"齧冰激齿颊，咽雪涤胃肠。\n此水若寒月，饮之年命长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大明殿早朝","author":"欧阳元","text":"扶摇万里上青霄，凤阙龙池步步瑶。\n驼背负琛金络索，象身备驾玉逍遥。\n衣冠俯伏传呼岳，千羽低徊看舞韶。\n湖海布衣瞻盛事，他时田野梦天朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久画","author":"贡性之","text":"此老风流世所知，诗中有画画中诗。\n晴窗笑看淋漓墨，赢得人呼作大痴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牧牛图","author":"贡性之","text":"郊原春草绿茸茸，牛背如舟卧牧童。\n自是太平新气象，错将画意属良工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居诗","author":"清珙","text":"一天红日晓东南，自拔青苗插瘦田。\n布䄌半沾泥水湿，归来脱晒竹房前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉堂读卷","author":"虞集","text":"玉堂策士诏儒臣，御笔亲题墨色新。\n省树坐移帘底日，宫壶驰赐殿头春。\n虞庭制作夔龙盛，汉代文章董贾醇。\n书阁暮年偏感遇，但歌天保播皇仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"御书雪林二字赐赵中丞应制","author":"揭傒斯","text":"圣主挥毫临秘阁，亲臣执法坐崇台。\n祥云五色从天下，彩凤双飞映日来。\n政欲清如林上雪，巳闻声奋地中雷。\n君臣千载明良会，咫尺薇垣接上台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题紫微老人大字歌","author":"欧阳元","text":"紫微老人射生手，挽强竟取黄金斗。\n骠骑营中拜骁勇，凤凰池上称耆旧。\n时平腕力无所施，筋骨犹能学颜柳。\n纵横戎略结构体，杀活兵机屈伸肘。\n山庄刘氏得最多，当日䄡䄖驻应久。\n高楼大扁曰明远，况又爱山并尚友。\n我来后公五十年，主人酌我楼中酒。\n平田野水凫雁集，重冈复岭蛟龙走。\n登高欲赋乏佳兴，忽睹台躔照窗牖。\n家藏有此希世珍，取酒当为主人寿。\n想当洗砚韬笔时，羽箑生风剑龙吼。\n焉知今人正传玩，名与麒麟同不朽。\n峤南鼪鼯十五秋，老将如今安得有。\n鄂公九原如可作，养寿清商为公奏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代柬曾小轩谢冯笔蜡纸之贶","author":"吴澄","text":"束缚山中豪，寸管入时操。\n几微见锋锐，可敌古铅刀。\n江人有妙悟，匪直取价高。\n坡公诧葛吴，蔡澡朱所褒。\n迩来浙西冯，声实相朋曹。\n小技足名世，屠龙宁自劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"破砚","author":"杨载","text":"彼美端溪石，家藏岁月多。\n廉隅皆破缺，筋力尽研磨。\n玉亦坚而已，星如粲者何。\n向来曾自诡，持用掇高科。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢书巢送宣和泸石砚","author":"虞集","text":"巢翁新得泸州砚，拂拭尘埃送老樵。\n毁璧复完知故物，沈沙俄出认前朝。\n毫翻夜雨天垂藻，墨泛春冰夜应潮。\n恐召相如令草檄，为怀诸葛渡军遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"残画","author":"杨载","text":"破裂无边幅，华堂弃置馀。\n苍松深踞地，白鹤上凌虚。\n风格犹森若，丹青总翳如。\n苦心绝人事，谁见用功初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋画归去来辞","author":"吴澄","text":"当时归去意，难与世人知。\n未信千年后，心期有画师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题彦敬越山图","author":"赵孟頫","text":"越山隔涛江，风起不可渡。\n时於图中看，居然在烟雾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十八学士图","author":"贡性之","text":"闻说瀛洲尺五天，会中宾客总成仙。\n分明一段风流梦，犹向人间画里传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神凤琴","author":"虞集","text":"鸣鸟人间久不闻，遗弦欲托断琴纹。\n曾看土鼓歌朝日，亦共陶尊醉夜分。\n五色云中迎太乙，九疑山下望湘君。\n采诗应被唐风谱，早晚楼船或祀汾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"获周丰鼎见博古图第三卷铭六字","author":"赵孟頫","text":"丰鼎制特小，周人风故淳。\n摩挲玉质润，拂拭翠光匀。\n铸法观来妙，铭文考更真。\n平生䔍好古，对此兴弥新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倭扇","author":"贡性之","text":"外番巧艺夺天工，笔底丹青智莫穷。\n好似越裳供翡翠，也从中国被仁风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"筇竹杖赠天圣长老仁公仁有诗次其韵","author":"赵孟頫","text":"瘦节苍骨耸，腻肤黄玉温。\n苔间时卓地，月下屡敲门。\n持赠松庐老，携寻水竹村。\n归来倚空壁，夜气与俱存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水晶笔架","author":"张翥","text":"三峰近列砚池头，光照文房烂不收。\n冰壑夜寒龙独卧，雪山春煖兔群游。\n彩毫倚阁功应就，银管依栖价未酬。\n别有珊瑚新琢样，策勋毕竟是谁优。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居","author":"清珙","text":"离众多年无坐具，入山长久没袈裟。\n单单有个铁铛子，留得人间煮瀑花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"贡性之","text":"马足车轮尽日忙，梦魂不到水云乡。\n閒人自识閒边趣，小簟疏帘坐晚凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纸帐","author":"陆景龙","text":"溪藤?雪净无瑕，素箔围风绝可嘉。\n梦入清虚明月照，倦游广汉白云遮。\n茧窝春煖浮银色，鲛室宵分散玉华。\n警鹤一声天巳豁，老夫诗思绕梅花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"楮帐","author":"郑允端","text":"昔随阿母上蓬莱，香气如云拂面来。\n今日梦中犹是见，梅花相对一床开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"榾柮窝","author":"陆景龙","text":"安乐窝中兴澹然，灵根斫得自樵仙。\n地炉伏火春如海，雪屋围风夜似年。\n香透玉酥和芋拨，脂流琥珀带松燃。\n绝胜沈水烧金鸭，吹彻参差恼醉眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仙居吟","author":"清珙","text":"山风吹破故窗纸，片片雪花飞入来。\n添尽布裘浑不煖，拾枯深拨地炉灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居诗","author":"清珙","text":"钁头添铁屋头悬，健即锄云倦即眠。\n红日正中黄独熟，甘香不在火炉边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绿阴垂钓","author":"贡性之","text":"茅屋人家隔薜萝，绿阴窗户晚凉多。\n日长借得南风便，时送沧浪一曲歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钓鱼图","author":"贡性之","text":"溪树苍茫带晚烟，溪流逆上似登天。\n归来钓得鲈鱼美，只博西窗一觉眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"采桑曲","author":"赵孟頫","text":"野雉朝雊雊且飞，谁家女儿采桑归。\n欲折花枝插丫髻，还愁草露湿裳衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏二十二首 其二 洗药池","author":"赵孟頫","text":"真人栖隐处，洗药有清池。\n金丹要沐浴，玉水自生肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画马 其三","author":"贡性之","text":"奚官牵出莫归迟，丰草甘泉御苑西。\n记得晓趋金殿直，百花深处听骄嘶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松鼠葡萄画 其二","author":"贡性之","text":"野鼠公然不避人，立当高树竟忘身。\n世间嗜欲多如此，寄语园丁莫浪嗔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题捕鱼图","author":"欧阳元","text":"太湖三万六千顷，灵槎倒压青天影。\n大鱼吹浪高如山，小鱼卷鬣为龙盘。\n群鱼联腴伐桴鼓，势同三军战强卤。\n长网大罟三百尺，拦截中流若环堵。\n吴王宫中宴未阑，银丝斫脍飞龙鸾。\n太官八珍奉公子，猩猩赪唇鲤鱼尾。\n洞庭木落天南秋，黄芦满天飞白鸥。\n江头吹笛唤渔舟，与君大醉岳阳楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"韩奕","text":"丰年稻熟村如画，南国莼生水亦香。\n官清便似居高品，任久长如在故乡。\n树影不随流水去，荷香常带远风来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自仙源过祇陀怀元镇","author":"范致大","text":"扁舟荡桨出东城，最爱新流拍岸平。\n霁雨兰苕来翡翠，晚风杨柳送鹂庚。\n盈盈溪水临沙浣，历历郊农备陇耕。\n谬倚林斋望山郭，忆君清话不胜情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题麻监州坟","author":"范致大","text":"一日孤坟起翠微，空山草木亦生辉。\n贺兰竟后霁云死，杜季宁迟马援归。\n义魄不随黄土化，英灵长共白云飞。\n笃交恤幼端奇事，惭愧梁溪一布衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱舜举硕鼠图","author":"陈颢","text":"苦尽谷才黄，将收欲上场。\n农夫未到口，田鼠已盈仓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王朋梅金明池图并题卷","author":"陈颢","text":"画人胸次见忠贞，意气规模一味清。\n想象当时同乐日，披图似有旧欢声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王孤云渍墨角抵图","author":"陈颢","text":"鬼墨不胜奇，胸中生百戏。\n参差有鬼头，人鬼元无二。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄庭坚松风阁诗卷","author":"陈颢","text":"涪翁词翰气横秋，自古如君能几个。\n高阁一诗四远闻，知音自有松风和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诗寄刘清卿都事","author":"王恽","text":"朋簪才盍脱荷囊，兰到升庭见独芳。\n毳幕夜书称快梦，冰壶孤抱映秋霜。\n十年紫禁烟花近，四海金华姓字香。\n南北相望固迢递，久要情在恐难忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纪梦","author":"王恽","text":"刘使君，跨苍驎，翩然而来空际云。\n腰间宝玦佩两剑，青蛇跃出光粼粼。\n谁谓昧平昔，款语情何亲。\n复为袖出先书一卷，纸色黯惨皆奇文。\n大如离堆几百字，钩络朱墨殆似髹漆新。\n残梦忽随风雨断，破泉惊听怒涛奔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兴济县","author":"张之翰","text":"兴济县城下，扁舟不敢行。\n树连云脚动，风卷浪头生。\n只道甘霖作，谁知乱雹倾。\n我方为郡去，不觉暗心惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"流河驿","author":"瞿佑","text":"河水滔滔不尽流，今来古往几春秋。\n波涛不覆渔翁艇，馆舍常迎使客舟。\n青眼有情惟岸柳，白头无闷是沙鸥。\n从今解却尘缨去，一任沧波孺子讴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳青谣四首 其一","author":"瞿佑","text":"昔闻杨柳青，今见杨柳黄。\n三秋既迫暮，五更仍飞蝗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳青谣四首 其二","author":"瞿佑","text":"黄叶辞旧枝，青眼存生意。\n稍待阳春回，又看柔荑翠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳青谣四首 其三","author":"瞿佑","text":"枯荣互乘除，气运常相参。\n在物尚如此，在人何以堪？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳青谣四首 其四","author":"瞿佑","text":"乔林蔽日高，古树停云密。\n为作短歌行，聊备乐府什。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青县","author":"瞿佑","text":"来饮青州酒，先乘青县风。\n川原通赵北，境界入山东。\n馔设河鱼白，筵供野枣红。\n沿屯禾黍熟，饱饭乐年丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏天池","author":"丘处机","text":"三峰并起插云寒，四壁横陈绕涧盘。\n雪岭界天人不到，冰池耀日俗难观。\n岩深可避刀兵害，水众能滋稼穑乾。\n名镇北方为第一，无人写向画图看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送奉化州判薛仲杰","author":"徐宪","text":"酒阑初上甬东船，春入乾坤已晏然。\n石首迎潮喧海市，麦苗带雨暗畲田。\n卷帘晴看扶桑日，退食时分雪窦泉。\n引领未为千里隔，政成须使万人传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春暮泛湖","author":"尤玘","text":"楝花风暖黄鹂语，万花错落飞红雨。\n接䍦倒着意迷离，快摇艇子穿芳树。\n湖边十里水潆浻，淡荡空明天倒开。\n四围绿净不容睡，一望波纹孰剪裁。\n湍流迥合向山抱，青鬟掩映烟光绕。\n停桡竟日尚淹留，便思卜筑长凭眺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]