[{"title":"太原修夫子庙疏","author":"耶律楚材","text":"并门连岁不年丰，证父攘羊礼义空。\n既倒狂澜扶不起，直须急手建庠宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和林建佛寺疏","author":"耶律楚材","text":"龙沙玄教未全行，故筑精蓝近帝城。\n须仗檀那垂手力，一轮佛日焕然明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨霁登楼","author":"张弘范","text":"楼外雨初霁，乾坤望眼明。\n岸高秋涨满，帘捲暮霞生。\n燕入泥香润，龙归海气清。\n阑干残照底，一片古今情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜独酌","author":"张弘范","text":"白酒谁同饮，青尊秪自开。\n山风吹雨去，海月上天来。\n雅兴高千古，狂歌复一杯。\n何当呼李白，同醉凤凰台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳塘避暑","author":"张弘范","text":"避暑溪塘上，悠然世虑疏。\n挂冠疑过鸟，濯足碍行鱼。\n雨过波纹细，风来树影虚。\n消磨长日事，棋罢数行书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莲湖泛舟","author":"张弘范","text":"载酒扁舟稳，平湖绮绣乡。\n半竿残月暮，十里晚风香。\n桂楫分云锦，荷杯吸露浆。\n浩歌明月底，惊起宿鸳鸯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"携妓泛舟遇雨","author":"张弘范","text":"醉漾扁舟去，欢生尽棹迟。\n舞回风过处，歌罢雨来时。\n凤斝传琼液，鸾刀脍玉丝。\n池塘烟树外，一一画中诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日道中","author":"张弘范","text":"六月长安道，功名两字催。\n云头烘赤日，马首渗黄埃。\n汗额挥淫雨，饥肠转殷雷。\n输他河朔客，冰酒泻荷杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"远烟","author":"张弘范","text":"惨澹微风外，氤氲老树头。\n乍惊香雾薄，遥认断云浮。\n日落山腰暮，雨晴天际秋。\n清明藏不得，一片晋家羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枕上","author":"张弘范","text":"客怀苦长夜，欹枕冷掀髯。\n半壁荒灯暗，穷途老泪淹。\n惊乌疑月树，窃鼠怯风帘。\n百虑秋中集，无由到黑甜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其一","author":"张弘范","text":"把酒莫辞频，呼童更疾温。\n清明三月节，庭院又黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其二","author":"张弘范","text":"把酒莫辞霎，休教尊酒空。\n光阴不复得，流水只流东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其三","author":"张弘范","text":"酒兴唯诗赖，诗怀实酒因。\n高吟到佳处，满酌岸清巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其四","author":"张弘范","text":"满酌莫宜侧，高歌不论声。\n醉时狂起舞，何必待鸡鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其五","author":"张弘范","text":"酒尽兴不尽，心奇诗亦奇。\n更沽一斗酒，须到百篇诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中遣兴 其六","author":"张弘范","text":"饮酒莫妨事，吟诗休费心。\n酒从閒里饮，诗向兴来吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"瓶中桃竹","author":"张弘范","text":"竹同君子操，花胜丽人妆。\n洞里神仙客，谁教嫁阮郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"花影","author":"张弘范","text":"明月招春魄，移痕上小窗。\n暗香浮枕簟，乘兴灭银釭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄刘仲泽","author":"张弘范","text":"已负中秋约，休愆九日期。\n东篱把菊坐，共赋南山诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"张弘范","text":"太古一轮月，浮云几度漫。\n阴晴从万态，桂影自高寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"张弘范","text":"巳著戎衣十载过，江南未了鬓先皤。\n前生应欠路途债，今世故教离别多。\n功业千年须好在，荣华一笑待如何。\n几时得遂归欤志，高咏渊明岁暮歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赴大名路任","author":"张弘范","text":"诏引春风下帝庭，恩教迁镇大名城。\n天寒日短催行色，雾重霜浓接去程。\n鹏翼垂天今日志，马头洒泪故乡情。\n深承父老殷勤送，何日儿童竹马迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚凉楼饮","author":"张弘范","text":"携壶信步曳长筇，来趁楼头满面风。\n龙驾金乌啼海北，鲸吹璧月上天东。\n愁空浊酒襟怀豁，气入新诗句法雄。\n此意谁人能会得，古今好个谪仙翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初夏","author":"张弘范","text":"醉窗睡足碧纱凉，帘卷薰风燕子忙。\n满地落花惊晚吹，一溪流水带斜阳。\n等閒岁月过难再，牢落功名拙自伤。\n青镜秪愁霜鬓改，光阴空老郭汾阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新蝉","author":"张弘范","text":"齐宫怨女梦初惊，犹对薰风诉别情。\n一自返魂遗旧壳，便将秋恨入新声。\n断桥高柳天将暮，落日空山雨乍晴。\n铁石肝肠人听得，也应白发为君生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雏燕","author":"张弘范","text":"羽毛香润态含痴，睡足云兜力尚微。\n唤母但能啾唧语，恋巢犹倦往来飞。\n薰风庭院帘初捲，落日池台人乍归。\n白凤赤龙浑异事，争如随分著乌衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑云表初夏","author":"张弘范","text":"一年好处艳阳天，风絮苔红意惨然。\n寂寂妍春空造化，炎炎畏日乍威权。\n香盈脾蜜蜂衙歇，泥足梁巢燕寝便。\n旋坼酒香浇郁气，园林青杏落诗笺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"射柳","author":"张弘范","text":"年少将军耀武威，人如轻燕马如飞。\n黄金箭落星三点，白玉弓?月一围。\n箫鼓声中惊霹雳，绮罗筵上动光辉。\n回头笑煞无功子，羞对薰风脱锦衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"打毬","author":"张弘范","text":"锦绣衣分上下朋，画门双柱耸亭亭。\n半空綵仗翻残月，一点绯毬迸落星。\n翠柳小厅喧鼓吹，玉鞭骄马蹙雷霆。\n少年得意风流事，可胜书生对夜萤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"假山","author":"张弘范","text":"性癖佳山未得亲，旋移远石象天真。\n峰峦草树安排好，岩壑风烟领略新。\n路转柳遮青隐约，雨馀苔渍碧嶙峋。\n尽教做尽千奇怪，时下窗前爱主人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"张弘范","text":"春风满鬓绿鬅松，落落胸怀气吐虹。\n节操自知坚雪竹，行藏未必属秋蓬。\n歌终牛角两行泪，舞彻鸡声一剑雄。\n肯似少年场上客，笙箫日醉软香中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过双塔","author":"张弘范","text":"千丈黄尘倦客途，林梢遥认两浮图。\n数家荒店留行李，一带遥山入酒壶。\n勋业壮年劳梦寐，等閒老境寄江湖。\n前途黯黯深沧海，惆怅西楼日向晡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿龙门","author":"张弘范","text":"落日苍崖列翠屏，翠屏围宿暮云横。\n溪声清入诗人耳，山势斜盘客子程。\n青草路凉羸马饱，碧林月冷倦乌惊。\n明朝飞过龙门去，直挽春风下赤城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遇雨未发","author":"张弘范","text":"寒侵诗梦晓初回，风雨长松撼半崖。\n绝岫黑云笼古殿，虚檐玉柱碎空阶。\n纱窗正熟佳人睡，石磴应伤客子怀。\n鞍马待晴行未得，木鱼声里过晨斋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀 其一","author":"张弘范","text":"飘零孤影寄天涯，梦断春风二鼓挝。\n闷上心来须赖酒，愁驱睡去胜如茶。\n龙潜北海收雷迹，豹隐南山养雾花。\n天产我材应有意，不成空使二毛华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀 其二","author":"张弘范","text":"梅时又过牡丹期，昼掩重门坐似痴。\n为擘愁眉须赖酒，欲言雅志岂无诗。\n浮云暖日阴晴里，残梦春风富贵时。\n一片肝肠坚玉石，肯随风絮入狂吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀 其三","author":"张弘范","text":"思量閒里百优游，只得寻常两事忧。\n中酒未醒过似病，搜诗不得胜如愁。\n便教酒病凭诗解，纵有诗愁着酒酬。\n此外谁无名利念，红尘千丈尽悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"襄阳答王仲思","author":"张弘范","text":"昼夜干戈备不虞，等閒诗酒兴全疏。\n承君西属三词至，愧我东回一字无。\n麾下雄兵山有虎，目中穷寇釜奔鱼。\n秋风咫尺襄樊了，好约扁舟泛五湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初夏","author":"张弘范","text":"好在薰风入舜弦，杨花飞去了三眠。\n迎眸新绿初长日，回首残红又隔年。\n香满蜜脾蜂翅懒，泥乾画栋燕巢全。\n多情无奈春归去，赖是园林煮酒天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅雨","author":"张弘范","text":"犀浦光风四月新，一天细雨弄寒温。\n丝丝檐外难成滴，湛湛江心不见痕。\n煮酒园林妨饮兴，暮云楼阁入吟魂。\n尽教燕子衔春去，半湿纱窗睡正昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春阴","author":"张弘范","text":"轻云薄薄锁峰峦，微暗书窗觉嫩寒。\n寂寞梨花浑欲湿，颠狂柳絮尚犹乾。\n争泥燕子情应喜，抱蕊游蜂意欲阑。\n说与密云休吝雨，一犁早足老农欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风柳","author":"张弘范","text":"澹澹池塘近楚宫，绿腰袅娜学盘中。\n乱摇荒草飞轻白，细搭朱阑拂落红。\n枝上娇莺啼恰恰，树边舞蝶意悤悤。\n东君应着吹嘘力，要把春愁一埽空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题保定抱阳山寺","author":"张弘范","text":"山僧掣脱利名缰，特去幽岩搆一堂。\n兀坐忘机禅榻静，高吟纵意竹窗凉。\n奔驰世外心千里，参透人间梦一场。\n终日杜门稀万事，此中滋味少人尝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题池州九华山 其一","author":"张弘范","text":"萍浦波平两岸风，群山争妒九华雄。\n城头秋日掀髯里，槛外诗成极目中。\n霞日晚时山更翠，江鸥潜处蓼偏红。\n楼间多少前贤句，惆怅烟岚自古同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题池州九华山 其二","author":"张弘范","text":"客逢佳节若为酬，地主相邀上北楼。\n满目奇观风日晚，一襟清兴不胜秋。\n笑倾琥珀欢无极，醉指芙蓉看未休。\n莫怪群山竟遮映，数峰高处愈风流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南征 其一","author":"张弘范","text":"百战归来气未松，紫泥又起作元戎。\n楼船万艓三山外，塞马千群百粤中。\n举目山川浑各异，伤心风景不相同。\n明年事了朝天去，铜柱东边第一功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南征 其二","author":"张弘范","text":"离多会少古皆然，惟我平生苦太偏。\n已是十年驱战马，又还万里驾征船。\n相思回首南天角，独许倾心北阙边。\n寄语故人知道否，戮鲸沈海在来年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张孝先","author":"张弘范","text":"乘驿归来气未停，江头还又送君行。\n少年鞍马峥嵘路，暮岁笙歌富贵程。\n半纸荒诗千里赆，一杯别酒十分情。\n故乡为向诸公道，功业悠悠白发生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读韩信传","author":"张弘范","text":"一怒燕齐楚赵收，将军今古果谁俦。\n后来肯为陈豨计，先日何辞蒯彻谋。\n自是多年惭哙等，何能轻举学留侯。\n可怜一片肝肠铁，却使终遗万古羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"共赋行田","author":"张弘范","text":"不屑人间事业忙，日迷歌舞少年场。\n楼台夜月延佳客，花竹春风拥谢娘。\n笑倩钗金挑烛影，醉嫌杯玉擘橙香。\n谁知原上农家子，鞭袅残星晓露凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄枢密院郭良弼","author":"张弘范","text":"三百年基数战休，君臣束手愿归囚。\n上天有命圣皇福，下国无谋贤相筹。\n笑我青蝇随骥尾，看人沧海据鳌头。\n此行幸见太平了，收拾琴书觅旧游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春雪","author":"张弘范","text":"馀寒料峭黄昏暮，惊见东风吹柳絮。\n杜陵野老独归来，却入灞陵桥上路。\n黄莺愁立花深处，恨湿金衣寒两羽。\n园林浑似晚春时，一片琼花飞玉树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"槐井","author":"张弘范","text":"翠浮石甃雨苔青，影落寒泉堕月明。\n酒醒渴怀无处着，绿阴风送辘轳声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席赠别","author":"张弘范","text":"离筵不必奏笙簧，说剑论诗醉一场。\n别后有期期不定，水萍风絮雨茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游春","author":"张弘范","text":"閒逐东风信马蹄，一鞭诗思曲江堤。\n行行贪咏梨花雪，却被桃花约帽低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读李广传","author":"张弘范","text":"弧矢威盈塞北屯，汉家飞将气如神。\n但教千古英名在，不得封侯也快人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老子送西游图","author":"张弘范","text":"玄教渊源自广成，五千文字总忘情。\n先生本是无为者，何苦青牛万里行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中 其一","author":"张弘范","text":"玉液流春畅白鸥，醉时不觉有离愁。\n轩昂两袖乾坤窄，疑是阴阳之外游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉中 其二","author":"张弘范","text":"金杯潋滟涨蒲萄，玉颊潮红意气豪。\n一撮乾坤是何物，古今只解戏儿曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹","author":"张弘范","text":"麝墨云香小木丛，淡烟横月翠玲珑。\n小屏春锁绿窗梦，也胜江湖烟雨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"射虎","author":"张弘范","text":"黑风高骑卷空山，怒吼岩林出锦斑。\n得意将军飞铁镞，忽惊一点草梢殷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出猎","author":"张弘范","text":"臂鹰携犬裤腰弓，四野长围马疾风。\n恨煞棘林狐兔走，肯教容易出围中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新燕","author":"张弘范","text":"海棠开后月黄昏，王谢楼台寂寂春。\n柳外东风花外雨，香泥高垒画堂新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕语","author":"张弘范","text":"入户穿帘语画梁，几惊春睡恼人肠。\n争如凭此呢喃舌，说与东君莫去忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青杏","author":"张弘范","text":"落尽残红绿满枝，青青如豆酿酸时。\n佳人摘得新尝怯，一点春愁锁画眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳絮","author":"张弘范","text":"东风殢煞柳梢头，吹去香绵得自由。\n不到池塘成翠靥，颠狂飞入酒家楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳绵","author":"张弘范","text":"暗织千丝了不忙，不须蚕茧不须桑。\n请君试看春风外，杨柳枝头喷雪香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诗魂","author":"张弘范","text":"渺渺幽怀与月高，花前醉里兴增豪。\n也曾天外搜佳句，又逐东风到酒槽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻角","author":"张弘范","text":"戍楼一曲老龙嘶，霜满秋空月影西。\n客里梦回听不得，残灯明灭伴人啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食后","author":"张弘范","text":"家家钻火露新烟，花褪残红柳吐绵。\n底是游人肠断处，杏桃影里拆鞦韆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自遣","author":"张弘范","text":"独对西风酒一尊，可怜庭院正黄昏。\n何当钓出沧浪月，豁我诗魂伴醉魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"碧桃花","author":"张弘范","text":"应是玄都观里仙，为嫌白淡厌红蔫。\n故栽一种新颜色，疑是飞仙坠翠钿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烛泪","author":"张弘范","text":"惜别终宵话不休，煌煌灯烛照离愁。\n蜡花本是无情物，特向人前也泪流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]