92fe5294295f79689","path":"元.csv","pointer":18779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送僧南归 其一","author":"成廷圭","text":"门外青山翠作堆，好怀能为故人开。\n浮杯不渡清淮水，却过西轩看竹来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送僧南归 其二","author":"成廷圭","text":"芒履犹香楚地花，一瓶随处是生涯。\n不须乞食游女去，舍利城多长者家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青山白云图","author":"成廷圭","text":"不见茅斋旧隐君，绕溪烟树暮纷纷。\n断桥水满无人渡，谁向青山管白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨梅","author":"成廷圭","text":"东阁冲寒雪一枝，巡檐偏解索题诗。\n何郎老去风情减，羞见疏花照鬓丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜宿野城","author":"成廷圭","text":"露气涓涓欲二更，小舟犹向月中行。\n前村知有人家近，隔浦微闻犬吠声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"草虫卷子 其一","author":"成廷圭","text":"蜗名蝶梦总成空，络纬徒知纺绩功。\n何似螳螂化蝉去，最高枝上吸清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"草虫卷子 其二","author":"成廷圭","text":"鸣蜩织女共惊秋，嗟尔微虫死即休。\n瞋目斗蛙犹未已，请看粘壁缀蜗牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月晦日","author":"成廷圭","text":"问余何事日匆匆，把卷题诗转不工。\n捡历又看正月过，一分春在酒杯中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画马","author":"成廷圭","text":"圉人争喜得骅骝，拨入天闲早见收。\n今日有谁怜骏骨，西风沙苑蕨藜秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之武林","author":"成廷圭","text":"白鼻骄騧紫绮裘，涌金门外醉瀛洲。\n君家若有平安字，寄在春风第几楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四明太守丁宴学官卷子","author":"成廷圭","text":"庄严七宝供西僧，甲第纷纷竞割烹。\n独有四明贤太守，杏坛春酒宴诸生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武林客舍","author":"成廷圭","text":"窗外青山啼子规，吟魂正被酒禁持。\n小楼一夜雨声恶，落尽碧桃人未知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绿杨桥","author":"成廷圭","text":"长溪春涨碧溶溶，烟雨空濛湿采虹。\n何事吹箫度清夜，断堤杨柳月明中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清泉寺","author":"成廷圭","text":"何人泉上记清游，茶具横陈晚未收。\n木叶尽随风扫去，万山清立寺门秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高房山墨竹","author":"成廷圭","text":"黄花山主澹游翁，写竹依稀篆籀工。\n独有高侯知此趣，一枝含碧动秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张天民移居图","author":"成廷圭","text":"旧隐荆溪第几村，手栽松桧至今存。\n大茅峰下千年鹤，迟汝重来问子孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同郑德明访宝昙上人不遇赋此二绝 其一","author":"成廷圭","text":"白云林下诵经寮，隔岸香风远更飘。\n欲就禅床吃茶处，倩人扶过木长桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同郑德明访宝昙上人不遇赋此二绝 其二","author":"成廷圭","text":"打门来访宝昙僧，松下云深唤未应。\n谁识三生旧行路，断崖苍藓络枯藤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题邓毅夫所藏青山白云图","author":"成廷圭","text":"山后山前暝不分，草堂无径觅徵君。\n惟馀玉气无藏处，散入空青作白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高昌王所画蒲萄熊九皋藏","author":"成廷圭","text":"玉关西去火州城，五月蒲萄无数生。\n今日江南池馆里，万株联络水晶棚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]