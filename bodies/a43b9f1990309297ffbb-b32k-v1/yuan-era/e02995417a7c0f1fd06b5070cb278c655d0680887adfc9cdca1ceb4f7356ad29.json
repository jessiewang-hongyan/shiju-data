[{"title":"病中书怀","author":"萨都剌","text":"欲向江湖去，何年理钓蓑。\n城山入楼近，邻竹过墙多。\n春瓮浮红酒，晴天戏白鹅。\n闭门且消病，俗吏莫相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中寄了上人二首 其一","author":"萨都剌","text":"鹤林四月路，佳景集芳辰。\n花落石桥水，鸟啼山树春。\n吟归山似画，醉卧草如茵。\n衲子清游处，何妨问病人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中寄了上人二首 其二","author":"萨都剌","text":"日长草木茂，古寺乐芳辰。\n野衲归时晚，山泉滴夜春。\n清吟联石鼎，病酒吐车茵。\n不是天涯客，林泉一故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11370,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆鹤林即休翁","author":"萨都剌","text":"城南鹤林寺，幽境脱尘烦。\n地僻藤花落，窗虚贝叶翻。\n池塘浮野鸭，竹树挂山猿。\n病起借禅榻，高眠避市喧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11371,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登山亭","author":"萨都剌","text":"山上新亭好，红尘不可侵。\n雨阶幽草合，风径落花深。\n野水浮晴色，平田下夕阴。\n城中公子少，日日就登临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11372,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之金陵","author":"萨都剌","text":"之子金陵去，黄梅细雨天。\n晚钟近萧寺，野水急吴泉。\n枕有思家梦，囊无买酒钱。\n凤台动诗兴，落笔授蛮笺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11373,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高秋泉诗卷","author":"萨都剌","text":"美矣高夫子，能文武亦全。\n横琴弹夜月，洗剑动秋泉。\n酒熟春如海，诗閒日似年。\n纶巾北窗下，倦可枕书眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野潜堂","author":"萨都剌","text":"高隐有深意，情閒直万金。\n溪鱼鲜作鲙，竹笋长成林。\n鹤有还巢梦，云无出岫心。\n读书风雨夜，灯火野堂深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题朱泽民画雪谷晓行","author":"萨都剌","text":"茆店冲寒出，永厓拂曙来。\n磴危留虎迹，萝密隐猿哀。\n行李一檐重，疏梅几树开。\n阳乌在何处，不照雪盈腮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋暮过吴值雨感怀","author":"萨都剌","text":"长啸拂吴钩，篷窗起白鸥。\n江山同逆旅，风雨忽穷秋。\n乐矣陶潜酒，高哉范蠡舟。\n一簪吾有雪，道路尚悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道中风雨","author":"萨都剌","text":"野水池塘满，泥涂愁问程。\n小车冲雨去，曲路绕山行。\n恁地沾衣冷，谁家压酒声。\n飘零江海客，汲汲事南征。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初到闽","author":"萨都剌","text":"旧说榕乡好，来游鬓已丝。\n片云山对户，一雨水平墀。\n绿袖持蕉叶，丹林压荔枝。\n城闉南有市，灯火夜眠迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登金山雄跨亭","author":"萨都剌","text":"朱栏六曲倚高秋，元气茫茫日夜浮。\n客去客来天地老，潮生潮落古今愁。\n疏钟水国前朝寺，落日海门何处舟。\n更拟黄昏尽馀兴，却从灯火望扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒夜怀京口韵","author":"萨都剌","text":"帝京久别梦相同，鸿濛佳气凌青空。\n石麟铜雀动凉月，玉楼珠箔摇天风。\n宫壶龙渴晚漏尽，御街马滑春雪融。\n绣衣貂帽少年子，银瓮索酒蒲萄宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马上偶成","author":"萨都剌","text":"秋水芙蓉淡淡妆，平湖昨夜有新霜。\n人间女子空自好，马上郎君不暇狂。\n十二玉楼空薄命，三千客路尽他乡。\n上林白雁无消息，欲向何人寄断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送管十班监宪除广西宣慰使","author":"萨都剌","text":"持节曾临江汉上，分符又入瘴云间。\n花骢一日行千里，金虎三珠照百蛮。\n露帐旌旗天接水，星营鼓角月连山。\n九重应有平猺诏，日听将军奏凯还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偕侍御郭翰卿过钟山大崇禧万寿寺文皇潜邸所建御榻在焉侍御索诗因为赋此","author":"萨都剌","text":"虎踞龙蟠王气多，云深石磴碧嵯峨。\n珠峰独占金陵胜，宝地尝经翠辇过。\n花草旧曾沾雨露，殿台今已近星河。\n登高愿效封人祝，万岁千秋保太和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送欣上人笑隐住龙翔寺","author":"萨都剌","text":"江南隐者人不识，一日声名动九重。\n地湿厌看天竺雨，月明来听景阳钟。\n衲衣香暖留春麝，石钵云寒卧夜龙。\n何日相从陪杖屦，秋风江上采芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜宿池阳石墨驿纳凉溪桥文皇南幸江陵驻跸所也徘徊久之赋诗未就忽雷电晦冥风雨大作急趋驿舍秉烛写东壁时至顺壬申五月","author":"萨都剌","text":"圣明天子南巡日，尚想溪桥洗马时。\n雷电神光犹警跸，草茅贱士敢言诗。\n山河夜黑鬼神护，雨露春深草木知。\n松柏如龙入霄汉，行人谓是万年枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高邮城晓望","author":"萨都剌","text":"城上高楼城下湖，城头画角晓呜呜。\n望中灯火明还灭，天际星河淡欲无。\n隔水人家暗杨柳，带霜凫雁起菰蒲。\n短衣匹马非吾事，拟向烟波觅钓徒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤凰台为御史大夫易释董公同赋","author":"萨都剌","text":"六朝歌舞豪华歇，商女犹能唱《后庭》。\n千载江山围故国，几番风雨入空城。\n凤凰飞去梧桐老，燕子归来杨柳青。\n白面书生空吊古，日陪骢马绣衣行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再过钟山大禧万寿寺有感","author":"萨都剌","text":"紫翠烟霞出上方，游人登览忆先皇。\n石阑空见岩花落，翠辇不来山路荒。\n此日风云消王气，旧时草木染天香。\n夜深行殿无人到，应有山灵护御床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸除南台中丞时仆驰驿远迓至京复改徽政以诗赠别","author":"萨都剌","text":"江南驿使路遥遥，远赴龙门望海潮。\n桂殿且留修月斧，银河未许度星轺。\n隔花立马听更漏，带月鸣珂趁早朝。\n祇恐淮南春色动，万竿烟雨绿相招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三益堂芙蓉","author":"萨都剌","text":"斑帘十二卷轻碧，秋水芙蓉隔画阑。\n绣扇摇风霞透影，锦袍弄月夜生寒。\n湘魂翠袖留江浦，仙掌红云湿露盘。\n只恐淮南霜信早，绛纱笼烛夜深看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次学士卢疏斋题赠句容唐别驾","author":"萨都剌","text":"疏斋落落谪仙才，句曲名山数往来。\n日读茶经医酒病，春从邻舍觅花栽。\n昔年奏对含鸡舌，今日登临独凤台。\n赖有閒居唐别驾，寻诗猿鹤莫惊猜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿曲阳仙馆","author":"萨都剌","text":"天际三峰横紫烟，山前山后尽芝田。\n楼台木末疑无路，鸡犬云中半是仙。\n白石经年皆化玉，青松尽日只闻泉。\n曲林三馆幽深处，一夜重楼听雨眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题元符宫东秀轩又名日观","author":"萨都剌","text":"茅君山下种玉田，道士辟为东秀轩。\n五色晓霞开日观，万株秋露滴云根。\n竹园笋出穿龙角，松树年深长鹤孙。\n一道天河横屋过，奎光垂地夜当门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统乙亥岁集贤学士济尔噶台奉旨代祀真定路玉华宫睿宗仁圣景襄皇帝影堂仆备监礼","author":"萨都剌","text":"大帝天香出内宫，孝思与世总无穷。\n百年礼乐行三献，一派箫韶起半空。\n使者领班云气里，女仙摇佩月明中。\n小臣监礼陪清列，两袖葵花映烛红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登镇阳龙兴寺阁观铜铸观音像","author":"萨都剌","text":"眼中楼观见应稀，铁凤栖檐势欲飞。\n天半宝花飘阁道，月中桂子落僧衣。\n高擎玉露仙人掌，上碍银河织女机。\n全赵堂堂遗物在，山川良是昔人非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄进士野仙不花仲实除侍仪通事舍人","author":"萨都剌","text":"舍人楚楚好容仪，玉立清朝白玉墀。\n紫袖窄衫花萼绕，黄金小带荔枝垂。\n綵旗拂柳春班卷，宫漏穿花午仗移。\n朝罢太平无事日，芙蓉叶上好题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仆官燕南照磨大名文济王重赐綵二端赋诗以谢","author":"萨都剌","text":"夜梦东南五色云，晓闻使者已临门。\n府中重遣年前赐，幕下多承望外恩。\n芝草暖霞浮露綵，藕丝秋水织霜痕。\n何因得侍西园宴，宫锦淋漓献寿樽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄文济王府教授郭尚之","author":"萨都剌","text":"闻君客食贤王府，剪地芙蓉赐坐温。\n不爱时名题雁塔，愿将苦学授龙孙。\n中官送酒银瓶小，前席谈经绛帐尊。\n却笑冯驩事干谒，无鱼弹铗尚侯门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统乙亥余除闽宪知事未行立春十日参政许可用惠茶赋此以谢","author":"萨都剌","text":"春到人间才十日，东风先过玉川家。\n紫薇书寄斜封印，黄阁香分上赐茶。\n秋露有声浮薤叶，夜窗无梦到梅花。\n清风两腋归何处？\n直上三山看海霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别江州总管真定王克绍","author":"萨都剌","text":"我识文章王太守，不知几日上浔阳。\n琵琶亭前好明月，香炉峰头多夜光。\n吟诗写字午衙静，打鼓劝农春社忙。\n万一公馀颇相忆，寄诗应到荔枝乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再过界首驿","author":"萨都剌","text":"二月好风吹渡淮，满湖春水绿如苔。\n官船到岸人多识，楚馆题诗客又来。\n近水人家杨柳暗，禁烟时节杏花开。\n一官迢递三山远，海上星槎几日回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姑苏台奉别侍御王继学","author":"萨都剌","text":"骢马霜台好使君，碧罗衫色透春云。\n帘垂绶带虾须细，烛剪金钗燕尾分。\n四海名高瞻北斗，五弦调古和《南薰》。\n姑苏台下人无数，争看门生拜主文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浮云道院诗二十二首，并引 其一","author":"刘鹗","text":"读书冀闻道，何必竞荣名？\n主宾辨内外，物我孰重轻？\n崎岖更尝馀，愈觉兹理明。\n浮云视富贵，悠然悟深情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠陈众仲","author":"萨都剌","text":"江南少识陈众仲，阙下才名北斗齐。\n直阁每从花底过，挥毫曾向御前题。\n观鱼小海凤新浴，立马上林莺乱啼。\n今日西湖湖上路，独骑款段踏春泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴山女道士","author":"萨都剌","text":"不见辽东丁令威，旧游城郭昔人非。\n镜中春去青鸾老，华表山空白鹤归。\n石竹泪乾斑雨在，玉箫声断綵云飞。\n洞门花落无人扫，独坐苍苔补道衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过鹅湖寺","author":"萨都剌","text":"十里苍松对寺门，四围翠滴露纷纷。\n湖心水满通银汉，山顶鹅飞化白云。\n玉井芙蓉天上露，剑池雪浪月中闻。\n石床茶灶如招隐，还许閒人一半分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鸦浴池","author":"萨都剌","text":"天池霹雳斧斤馀，天风万劫吹不枯。\n白云石面化青雨，落日海眼翻金乌。\n银河灵鹊渡夜影，月窟老兔时濡须。\n太平海上锦袍客，跨鹤来看浴凤雏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠仁王讲师达上人","author":"萨都剌","text":"香山居士美如玉，亭亭秋水开芙蓉。\n承恩长揖紫宸殿，飞锡遥挂乌石峰。\n散花天女绕经阁，出海神龙闻讲钟。\n攒眉入社笑陶令，载酒三生石上逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石夫人","author":"萨都剌","text":"危危独立向江滨，四伴无人水作邻。\n绿鬓懒梳千载髻，朱颜不改万年春。\n雪为腻粉凭风傅，霞作胭脂仗日匀。\n莫道脸前无宝镜，一轮明月照夫人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安分","author":"萨都剌","text":"心求安乐少思钱，无辱无荣本自然。\n春日赏花惟贳酒，冬天踏雪旋添绵。\n频将棋局消长日，时爇香薰篆细烟。\n万事皆由天理顺，何愁衣禄不周全。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯及第谢恩奉天门","author":"萨都剌","text":"禁柳青青白玉桥，无端春色上宫袍。\n卿云五彩中天见，圣泽千年此日遭。\n虎榜姓名书綵纸，羽林冠盖竖旌旄。\n朝回龙尾频回首，玉漏花深紫殿高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赐恩荣宴","author":"萨都剌","text":"内侍传宣下玉京，四方多士被恩荣。\n宫花压帽金牌重，舞妓当筵翠袖轻。\n银瓮春分官寺酒，玉杯香赐御厨羹。\n小臣涓滴皆君赐，惟有丹心答圣明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同克明曹生清明日登北固山和韵","author":"萨都剌","text":"三月二日风日暖，千家万家桃李开。\n少年白日骑马去，满城红雨拂面来。\n共君且饮酒一斗，处世不必歌七哀。\n孙刘事业果何在，百年断石生莓苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄呈江东廉使王继学","author":"萨都剌","text":"瓜步遥闻鼓角声，淮船夜过石头城。\n当年岭海家何在，此日江湖梦亦清。\n紫塞秋风初度雁，玉堂夜月旧闻莺。\n秪应王谢风流在，卧治山东足令名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中","author":"萨都剌","text":"烟树云林半有无，野人行李更萧疏。\n堠长堠短逢官马，山北山南闻鹧鸪。\n万里关河成传舍，五更风雨忆呼卢。\n寂寥一点寒灯底，酒熟邻家许夜酤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"萨都剌","text":"客程去住与身违，误掷渔竿下钓矶。\n好客不来门户俗，远亲相弃信音稀。\n青春背我堂堂去，黄叶无情片片飞。\n遥望家山搔短发，故园酒熟蟹螯肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句曲赠清玄道士陈玉泉朝京还山复拜广陵观","author":"萨都剌","text":"清玄道士骑黄鹤，曾向春班趁早朝。\n香动螭头云气暗，路回龙尾佩声遥。\n还山去采泉中玉，洗耳终亡树上瓢。\n闻说淮南招桂隐，渡江明月听吹箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望金陵","author":"萨都剌","text":"行人雨霁金陵去，萧寺钟声又远听。\n五月潮声方汹涌，六朝文物已凋零。\n春风玉树留歌韵，暮日青山立画屏。\n干古兴亡堪一笑，买花载酒赏心亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"季子庙","author":"萨都剌","text":"公子不来春草绿，故宫禾黍亦离离。\n沸原尚有千年井，古篆犹存十字碑。\n去国一身轻似叶，归田两鬓细如丝。\n李家兄弟一朝暮，羞见延陵季子祠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题扬州驿","author":"萨都剌","text":"银烛高烧照不眠，呼儿饮马吸清泉。\n寒砧万户月如水，塞雁一声霜满天。\n《金缕》款歌来枕上，银瓶索酒到亭前。\n明朝走马燕山道，赢得红楼说少年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪米","author":"萨都剌","text":"万斛珠玑泻大荒，六丁谁为发天仓。\n云孙捧出南箕簸，月姊春来北斗量。\n狼戾也知逢稔岁，贮储尤不济饥肠。\n风流灞上寻诗客，千古无人说秕糠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"移梅","author":"萨都剌","text":"几夜幽香恼梦魂，殷勤来倩陇头人。\n凿开东阁窗前地，分得西湖雪里春。\n瘦影番来新体态，疏枝犹带旧精神。\n今朝伴我清吟处，不许诗怀更有尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都门元日","author":"萨都剌","text":"元日都门瑞气新，层层冠盖羽林军。\n云边鹄立千官晓，天上龙飞万国春。\n宫殿日高腾紫霭，箫韶风细入青云。\n太平天子恩如海，亦遣椒觞到小臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄马昂夫总管","author":"萨都剌","text":"衢州太守文章伯，酒渴时敲玉井冰。\n径造竹床忘是客，横拖藜杖去寻僧。\n人传绝句工唐体，自恐生前是薛能。\n日暮江东怀李白，凤凰台上几回登。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送僧归庐山","author":"萨都剌","text":"扬子江头木叶风，上人归兴白云重。\n净瓶满贮蓬莱水，客舫遥听精舍钟。\n到家自笑门前鹤，洗钵不惊潭底龙。\n珍重匡庐山畔路，逢人应问旧栽松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次张举韵题皖山金氏绣野亭","author":"萨都剌","text":"南冠犹有旧风流，说看舒州处处幽。\n最喜园林动花竹，不妨城郭带林丘。\n一樽浊酒青山暮，三径晚香黄菊秋。\n未识孤高金处士，杖藜应许约同游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠莫州同年县尹米思泰","author":"萨都剌","text":"倦客重来忆去年，荒城斜日淡炊烟。\n民居星散无官讼，里巷秋深尽水田。\n禾稼半生城郭里，槐花乱落县门前。\n路傍父老头如雪，共道文章令尹贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘照磨之桂林","author":"萨都剌","text":"一官未厌马蹄遥，要使南荒识凤毛。\n幕府红莲开白昼，辕门碧草映青袍。\n牙旗晓湿蛮烟重，羽箭宵鸣岭月高。\n努力平猺当第一，剖符悬印赐勋劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马昂夫赏心亭怀古","author":"萨都剌","text":"景阳宫井绿芜深，空有杨花暗御林。\n一自朝云归寺里，几回明月到楼心。\n陈台露冷蛩声苦，楚水波寒雁影沈。\n白发词臣多感慨，长歌对酒向谁斟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马昂夫登楼有感","author":"萨都剌","text":"倚遍阑干忆往年，南朝民物已萧然。\n空遗故国山如画，依旧长江浪拍天。\n市井笙歌今渐少，御街灯火夜相连。\n青青门外秦淮柳，几度飞花送客船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]