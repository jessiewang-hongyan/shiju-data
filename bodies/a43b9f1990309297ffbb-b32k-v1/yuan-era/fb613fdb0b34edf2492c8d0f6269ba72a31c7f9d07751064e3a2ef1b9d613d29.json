[{"title":"寄诸台掾二首 其一","author":"萨都剌","text":"天上霜台耸百寻，诸郎不为簿书禁。\n遥知閒倚东廊柱，看尽杨花过绿阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄诸台掾二首 其二","author":"萨都剌","text":"天上故人频寄语，江南倦客只吟诗。\n梨花开尽东廊雪，又过梅黄杏熟时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠谢舜咨羽士","author":"萨都剌","text":"扬子江头春水动，三茅洞里碧桃开。\n道人不问天南北，夜半月明骑鹤来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送武侍御朝章","author":"萨都剌","text":"枫林湛湛草斑斑，御史青骢响玉环。\n日暮酒醒人已去，不堪回首见青山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次程宗赐二首 其一","author":"萨都剌","text":"一冬雨雪天涯客，千里云山马上诗。\n记得小红楼畔梦，杏花春雨早寒时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次程宗赐二首 其二","author":"萨都剌","text":"扬州正月雨如丝，江上梅花已尽时。\n谁识能诗老何逊，晓寒明镜撚吟髭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠来复上人四首 其一","author":"萨都剌","text":"北口雪深毡帐暖，紫驼声切夜思盐。\n上人起饮黄封酒，可胜醍醐乳酪酣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠来复上人四首 其二","author":"萨都剌","text":"燕山风起急如箭，驰马萧萧苜蓿枮。\n今日吾师应不念，毳袍冲雪过中都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠答来复上人","author":"萨都剌","text":"手持一钵走京华，乞食王侯宰相家。\n今日归来如作梦，自锄明月种梅花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠来复上人四首 其四","author":"萨都剌","text":"五云楼阁碧玲珑，口吐莲花入紫宫。\n十二珠帘捲秋月，霏霏凉露下梧桐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏王功甫","author":"萨都剌","text":"王郎酒醒倚脩竹，雪后重檐拥毳衣。\n亦有江南未归客，青山影里马如飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏赠王本中柳枝词","author":"萨都剌","text":"日高燕语捲帘迟，独倚东风看柳枝。\n三月柳花飞欲尽，远人凉露未归时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城南偶兴二首 其一","author":"萨都剌","text":"桃杏花开红映人，池塘水暖绿粼粼。\n典衣沽酒入城去，报道江南二月春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城南偶兴二首 其二","author":"萨都剌","text":"断桥芳草生含路，隔水杨花飞度城。\n客里不知春早晚，年年杯酒过清明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿洞神宫春晓书事","author":"萨都剌","text":"道人睡起窗月白，饭熟黄粱鸡乱啼。\n门外卖花声已过，街头春雨竟成泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冶城三月晦日","author":"萨都剌","text":"雨前雨后莺乱啼，城南城北花交飞。\n江南儿女裁苧衣；燕京游子何时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄浙东聂经历","author":"萨都剌","text":"一片暮云千里隔，石头城上望天台。\n夜深婺女明如镜，雁荡山前雁尽回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成二首 其一","author":"萨都剌","text":"归到江南才一月，短衣匹马又京尘。\n明朝拟下江东去，晴日柳花飞送人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成二首 其二","author":"萨都剌","text":"水绕池塘朝饮马，月明苍柏夜鸣乌。\n年来南北几千里，却笑书生无远图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春望","author":"萨都剌","text":"丹阳郭里春濛濛，骑马出郭诗思浓。\n江南二月风雨过，梅花开尽杏花红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春暮","author":"萨都剌","text":"柳花扑帘春欲尽，绿阴满窗莺乱啼。\n秪愁明日送春去，风雨满林闻竹鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端居书事答翟志道知事见寄韵二首 其一","author":"萨都剌","text":"短褐诗人瘦十分，平生不作送穷文。\n几时结屋孤山下，为觅梅花种白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端居书事答翟志道知事见寄韵二首 其二","author":"萨都剌","text":"瘦马春城曙色分，长年奔走愧移文。\n几时黄鹤山房下，松火茶铛煮白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"镇江寄王本中台掾","author":"萨都剌","text":"梅花落尽空吹笛，正月半头思远人。\n两岸好山青不断，一江微雨鹧鸪春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和友人招饮","author":"萨都剌","text":"山人开瓮满园香，短简招呼白面郎。\n瘦马踏泥春巷去，一林烟雨杏梅黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄即休翁三首 其一","author":"萨都剌","text":"苔老应无屐齿痕，旧游历历眼中存。\n秋深南国行人少，落叶萧萧满寺门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄即休翁三首 其二","author":"萨都剌","text":"北窗终日对竹坐，老却参军不入城。\n秋径山风多落叶，隔林疑是马蹄声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄即休翁三首 其三","author":"萨都剌","text":"鹤林老子久不见，应是山门长绿苔。\n几日城南风雨过，村村无处不黄梅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"未归","author":"萨都剌","text":"白岩老子城中去，骢马游人寺里来。\n城外风流城里少，岩花落尽野花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏仲书景","author":"萨都剌","text":"阶前萱草花开尽，堂上主人消百忧。\n门外凉风吹树急，江南五月似凉秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起戏笔奉答御史王文休","author":"萨都剌","text":"江南倦客好清斋，炼得身形瘦似梅。\n不到清溪三四日，藕花无数水中开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成","author":"萨都剌","text":"买鱼酤酒消长日，高树清风燕子閒。\n却倚天南望天北，隔江青处是谁山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成三首 其二","author":"萨都剌","text":"自许痴儿了公事，肯教俗子议清流。\n明日醉骑五花马，吹箫踏月过扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成三首 其三","author":"萨都剌","text":"疏帘日午花阴直，高柳清风语燕閒。\n默坐焚香点周易，软红不到小屏山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"层楼即事","author":"萨都剌","text":"浴罢焚香扫阁眠，过墙新竹翠娟娟。\n半空云气层楼暗，四月江东欲雨天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纳凉","author":"萨都剌","text":"桂枝叶密阴覆地，栀子花开香满廊。\n古寺纳凉过半日，葛衣石枕竹方床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄鹤林休上人","author":"萨都剌","text":"上人才思塞胸次，强欲禁之无不鸣。\n一日相望吐奇句，满林光彩照山精。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿丹阳普照院 其一","author":"萨都剌","text":"闭门三月听秋雨，酒醒丹阳客未归。\n明日新晴练湖去，藕花无数落红衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿丹阳普照院 其二","author":"萨都剌","text":"灯火僧房伴寂寥，小凉天气入青袍。\n夜深为倚西廊柱，药杵一声秋月高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"逢托克托景颜","author":"萨都剌","text":"市酒泻糟清似水，湖鱼出网白如银。\n买鱼沽酒丹阳郭，落日江南逢故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠歌者号梅芳二首 其一","author":"萨都剌","text":"露骨江南冰雪肌，断肠塞上锦绷儿。\n春酸一点留无住，却是成阴结子时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠歌者号梅芳二首 其二","author":"萨都剌","text":"玉骨冰清过岁寒，可怜蜂蝶已成团。\n如何不解相如渴，散尽江南一点酸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓栖云四首 其一","author":"萨都剌","text":"一尊未尽有馀兴，二子不来无可人。\n满地凤仙落红雨，江南八月似残春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓栖云四首 其二","author":"萨都剌","text":"盆池万点浮萍草，秋雨欲来无定踪。\n好是诗人漂泊态，丹阳郭里夜间钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓栖云四首 其三","author":"萨都剌","text":"潇潇风雨客心孤，且尽尊前酒一壶。\n夜半酒醒愁又到，一声白雁下平湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓栖云四首 其四","author":"萨都剌","text":"白面道人门不出，晚凉倚树听秋风。\n最怜八月江南好，老雁叫云霜叶红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题隐上人房","author":"萨都剌","text":"练湖秋水霜眼碧，坐对茅盈山色青。\n白日散花天女降，夜深钟磬尚闻经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄金坛元鲁宣差行操二年兄","author":"萨都剌","text":"苍茫迥野冻云低，马上遥山玉四围。\n自是诗人有清气，出门千树雪花飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿陵口寺","author":"萨都剌","text":"西风落叶陵口寺，薄暮钟声送夕阳。\n酒醒不知过夜半，开门满地月如霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郑谷驿","author":"萨都剌","text":"谁处江东郑老家，自锄谷口种烟霞。\n远山三月多归思，晴日东窗见杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠张道士","author":"萨都剌","text":"道人新戴竹皮冠，头上星摇北斗寒。\n一夜凉风吹发乱，半窗鹤梦绕琅玕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吕城葛观二首 其一","author":"萨都剌","text":"诸葛仙翁七十馀，吕蒙城下筑幽居。\n来从方外求丹诀，且乞人间教子书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吕城葛观","author":"萨都剌","text":"吕公城下葛仙家，洞府春深锁暮霞。\n过客不知天畔月，小风吹落凤仙花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延陵曲","author":"萨都剌","text":"延陵庙西落日低，延陵庙前春草齐。\n千金公子去不返，淡云苦竹斑鸠啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿延陵昌国寺书于上人房二首 其一","author":"萨都剌","text":"旧日延陵客子家，只今门巷满桑麻。\n姑苏回首神游处，无限春风野荠花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿延陵昌国寺书于上人房二首 其二","author":"萨都剌","text":"东风吹水碧粼粼，雨过村村野色新。\n小艇延陵庙前去，荇花开尽野塘春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢人惠茶","author":"萨都剌","text":"送茶将军扣门急，惊觉秋深梦一窗。\n半夜竹炉翻蟹眼，只疑风雨下湘江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李蓟丘画松","author":"萨都剌","text":"平生恨不识遵道，忽见此图如梦间。\n安得羲之九泉底，枯林风雨似初还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴僧子庭古木竹","author":"萨都剌","text":"岁寒古木性所爱，况有此君初附之。\n江湖眼明世无几，太息不生元祐时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和韵寄吴城陈敬初","author":"萨都剌","text":"吴江酒熟照行人，春江小雨波粼粼。\n一樽未尽忽晴日，江头柳花撩乱春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"席上次顾玉山韵","author":"萨都剌","text":"画墙班鸠啼绿树，白日紫燕穿朱帘。\n昼长深院弄瑶瑟，吴姬十指行春纤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"去吴留别于寿道陈子平诸友 其一","author":"萨都剌","text":"吴堤杨柳雨霏霏，四月犹寒总夹衣。\n此去孤舟无好伴，空江惟见白鸥飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"去吴留别干寿道陈子平诸友","author":"萨都剌","text":"一尊判袂阖闾城，莫指青山管送行。\n芳草绿波千万里，不闻杜宇也伤情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"季夏游杭灵隐诸峰","author":"萨都剌","text":"佛国群山快我登，烟霞踏破几层层。\n三天竺畔全无暑，六月松阴尺五冰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日寓钱塘","author":"萨都剌","text":"小楼一榻钱塘客，况味凄凉序属秋。\n安得江淹赋予笔，因而书作半生愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青松林","author":"萨都剌","text":"一点两点过云雨，千株万株临路松。\n五月江南好风景，行人马上不从容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿经山寺二首 其一","author":"萨都剌","text":"野人一宿经山寺，十里松声半夜潮。\n何日挂冠寻旧隐，山中应有故人招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿经山寺二首 其二","author":"萨都剌","text":"山中酒熟客初至，正是东林月上时。\n痛饮不知过夜半，深山风露下松枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹院壁","author":"萨都剌","text":"门外好山青入户，阶前芳草绿侵帘。\n山僧应笑游人醉，头上花枝压帽檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书高贤坊","author":"萨都剌","text":"穿松翠滴青骢马，过雨凉生白苧衣。\n三月已过四月半，柳花开尽楝花飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常山纪行 其一","author":"萨都剌","text":"绿阴门巷掩柴扉，五月江南笋蕨肥。\n何处清香来马上，满山开遍野蔷薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常山纪行 其二","author":"萨都剌","text":"山溜涓涓山雨晴，村南村北鹁鸠鸣。\n行人五月不知倦，喜听农家打麦声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常山纪行 其三","author":"萨都剌","text":"石羊华表草离离，古木残阳立断碑。\n马上不知何代冢，鹧鸪飞上野棠枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常山纪行 其四","author":"萨都剌","text":"石壁飞泉作雨声，野花满路酒初醒。\n吾侬何事不归去，一带长山马上青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"常山纪行 其五","author":"萨都剌","text":"蚕妇携筐入桑柘，野猿抱子挂松萝。\n绿阴门巷客呼酒，黄犊山村人唱歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过浦城","author":"萨都剌","text":"人家鸡犬隔痴岚，城郭微茫见塔尖。\n一片轻云笼马首，熟梅时节雨纤纤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"到闽二首 其一","author":"萨都剌","text":"朔雪蛮烟总备尝，白头才到荔枝乡。\n浮云不阻怀贤意，得扫寒芜拜紫阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"到闽二首 其二","author":"萨都剌","text":"潮水通城蚬蛤肥，万株红荔艳晴晖。\n守臣只恐山飞去，高筑闉阇锁翠微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次繁昌邑宰梅双溪韵","author":"萨都剌","text":"矍铄繁昌宰，曾充观国宾。\n儒冠犹破帽，礼服尚垂绅。\n澹泊心无愧，清癯目有神。\n老随朱绂贵，惊见白头新。\n抚字三年政，歌谣百里民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]