[{"title":"送赵左丞之湖广省二首 其一","author":"卢挚","text":"十年关陇得春偏，户有城南尺五天。\n昨夜台躔照吴楚，梦中黄鹤亦欣然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵左丞之湖广省二首 其二","author":"卢挚","text":"江空岁晚不堪愁，鹦鹉洲寒鬓欲秋。\n留著梅花莫开尽，为公吹玉过南州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壁鲁洞二绝 其一","author":"卢挚","text":"南山采药北山棋，把断阆风天不知。\n试问龛中二三子，烂柯人是向来谁？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壁鲁洞二绝 其二","author":"卢挚","text":"万古仙岩两羽衣，一瓢秋水送将归。\n欲知后夜相思梦，月满空山鹤与飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宝陀寺","author":"卢挚","text":"老子扁舟日暮回，眼花不甚见如来。\n凭谁揭取罗浮月，挂向胥江玉镜台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅都官宅","author":"卢挚","text":"一上高斋忆谢公，云间江柳有无中。\n诗家政有都官宅，肠断荒山落叶风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠画梅孙道士","author":"卢挚","text":"夜梦孤山放鹤翁，道人忙打五更钟。\n觉来摸索□□月，笑指枯藤问晓风。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题叶孝子丹泉庐墓诗卷二首 其一","author":"卢挚","text":"偶营玄宅近丹泉，岂是谈空为稚川。\n地下衣衾能不朽，鼎中龙虎若为仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题叶孝子丹泉庐墓诗卷二首 其二","author":"卢挚","text":"昼衽缞粗夕卧苫，晓霜不似礼经严。\n夺哀朝士归来晚，花满兰堂月满帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集句饯张知事子中","author":"卢挚","text":"和泽周三春，桃李罗堂前。\n劲风无荣木，于我若浮烟。\n与子相遇来，倾盖定前言。\n岁月好已积，玉石乃非坚。\n一朝辞吏归，悠然见南山。\n从我颍水滨，虚室有馀閒。\n故人赏我趣，赖古多此贤。\n吾驾不可回，怅恨独策还。\n靡靡秋已夕，亭亭月将圆。\n青松冠岩列，白云宿檐端。\n此中有真意，弱毫多所宣。\n登高饯将归，路遐无由缘。\n良才不隐世，来会在何年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其一","author":"滕斌","text":"宇宙忽空阔，饮马万里流。\n平生负两眼，及此行寓州。\n天清健鹘运，木脱饥鹰投。\n长风吹海雨，濯我紫绮裘。\n相逢半游侠，把酒髯如虬。\n慷慨说《史记》，历历山川秋。\n向来衣带水，目短何无舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其二","author":"滕斌","text":"吾爱东方朔，高揖金马门。\n向非玩六合，安肯来昆崙。\n昂昂九尺身，谈辩黄河翻。\n谁知上书意，蛾眉非自婚。\n不见马相如，俛首狗监恩。\n人生非桃李，何故不自言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其三","author":"滕斌","text":"吾爱李太白，玩世如游龙。\n自知天上谪，何必人间容。\n海风吹绿发，萧萧卧云松。\n我昔梦见之，遗以金芙蓉。\n清辉恍在眼，日落蛾眉峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其四","author":"滕斌","text":"西风桂花落，我上天台山。\n仙子扶我手，泠然苍水环。\n乘鸾者谁子？\n飞烟渺难攀。\n三坐此游戏，弄影银河湾。\n空山忽风瀑，四顾鸣潺湲。\n长揖马子微，此岂非人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其五","author":"滕斌","text":"春风如绿浪，淡荡洛阳柳。\n高楼语锦瑟，落花泛绿酒。\n何人白鼻騧，蒙茸紫貂袖。\n一字或未识，银菟悬两肘。\n煌煌贝宫珠，乃落纬萧手。\n爰居偶钟鼓，牺牛竟文绣。\n终然同一尽，岂复论好丑。\n谁知草玄者，穷巷闭白首。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其六","author":"滕斌","text":"步出涌金门，所见土花碧。\n徘徊衣上月，感此美人夕。\n美人胡不归，月落江水白。\n寒潮已复去，海马晓无迹。\n万弩射鲸鱼，骇浪接天赤。\n空闻鲁仲连，孤感横八极。\n哀哀精卫石，填海竟何益。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其七","author":"滕斌","text":"赠客黄金羁，劝客白玉卮。\n昔我亦为客，得此慨不辞。\n小草戏其出，槟榔笑其饥。\n相识何所无，所乐心相知。\n平生数公子，腰下珊瑚枝。\n冥冥或相隔，寤寐恍见之。\n无丝绣平原，无金铸钟期。\n秋风山阳笛，泪落不自持。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其八","author":"滕斌","text":"赠我火浣席，报君吉光裘。\n一笑结意气，呼酒黄鹤楼。\n神交岂待语，与子为天游。\n携手阆风观，濯发扶桑洲。\n下俟侠少年，笑嬉藏怨尤。\n世无羊尤烈，风雪且自谋。\n东井不可酌，天驷岂服辀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感寓九首 其九","author":"滕斌","text":"船头书十乘，船尾酒百壶。\n酒尽书在眼，落月如明珠。\n忽悟八阵法，纵横如河图。\n惜哉经世士，未有窥唐虞。\n季子相六国，所见惟阴符。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题东坡书楚颂卷","author":"滕斌","text":"欧公家颍川，坡老田阳羡。\n是皆非吾土，而乃此留恋。\n种橘知何时，何时归去兮？\n归而谋之妇，惜无李衡妻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠弓秋蟾","author":"滕斌","text":"琼花十里小楼红，醉吞牛斗眠长虹。\n十年四海分萍蓬，一笑邂逅滕王洪。\n床头回首黄金空，但觉耿耿盘心胸。\n问蟾何不归蟾宫，自有老月留身中。\n谁受一粒金丹红，学得纸上画墨龙。\n白昼呼吸风云从，顷刻雾暗天濛濛。\n妙处巧夺造化工，不复知有陈所翁。\n君不见金陵壁上不点瞳，点瞳霹雳惊江东。\n我欲烦君具毫楮，画一小龙回顾母。\n普令天下生孝心，不向江湖长验雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"□□□□□□□□□□","author":"滕斌","text":"合星移次福江西，万马攒蹄夜不嘶。\n鼓角声随山月上，旌旗影拂海云低。\n心唯一正千官肃，事不多言万物齐。\n带得天边新雨露，晓看春意满锄犁。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日对雨","author":"滕斌","text":"冷云卷雨宿岩阿，又见东风长薜萝。\n宇宙千年光霁少，关河百战乱离多。\n铁心不入利名冷，绿鬓堪供岁月梭。\n试笔寻诗诗未稳，梅花树下少婆娑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖西小楼","author":"滕斌","text":"不如载酒此凭阑，水色山光蔚可餐。\n紫翠挟春排坐湿，玻瓈涌月入窗寒。\n苍茫白鸟鸣幽屿，掩染飞花漾碧湍。\n但令风光入吟啸，画船绮袖不须看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"所见","author":"滕斌","text":"何时结屋亦云根，隔水人家可辋川。\n万仞云山凝晓碧，一弓风日弄秋妍。\n虚名岂用传身后，侠气犹能累眼看。\n料理寒香微雨外，已判萧散待流年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吟到","author":"滕斌","text":"吟到西风黄叶枯，新愁几点落寒芦。\n乾坤万象俱吾有，烟雨一阑何处无。\n流水悠悠吾道在，浮云扰扰世情疏。\n午窗唤醒华胥梦，古木岩头闻鹧鸪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭东园","author":"滕斌","text":"人间八十岁吟翁，一转头来梦幻空。\n化鹤何心归世外，骑鲸无信到江东。\n香名合列仙班上，老气犹横诗卷中。\n如此英灵元不死，梅梢月落响松风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"呈孙郎中","author":"滕斌","text":"独立梅花恨最多，江西夜雨涨恩波。\n仙翁已矣客犹在，天意不然人奈何！\n抚剑有时撑老眼，衔杯无路发悲歌。\n先生闭户何为者？\n我亦从今理钓蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其一","author":"滕斌","text":"石冷龙蟠，风高鹤瘦。\n一片白云，勿落襟袖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其二","author":"滕斌","text":"月佩霞裾，雾襦云幄。\n白鹤一声，秋风老壑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其三","author":"滕斌","text":"本无尘埃，何事乎浴。\n千仞飞泉，所濯吾足。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其四","author":"滕斌","text":"谁言桃实，可以疗饥。\n何为武陵，迷不自知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其五","author":"滕斌","text":"万山雪瀑，一叶莲舟。\n世人指似，泰华峰头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其六","author":"滕斌","text":"如剑斯泉，如瓮斯石。\n夜横紫箫，吹散寒碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其七","author":"滕斌","text":"瑶草低云，苍松洒雪。\n何人举酒，酹我明月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵泉翀举自有诗十八章留人间今止存五遂续之 其八","author":"滕斌","text":"天低绛阙，月满瑶台。\n玉鸾何许，尽归去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金精山","author":"滕斌","text":"天风吹送玉鸾回，洞口桃花几度开。\n何物痴儿不知量，敢将俗念涴仙台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其一 读书岩","author":"滕斌","text":"巉岩石室潋江东，昔隐唐官越国公。\n胜迹不磨遗像在，书声时落半天风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其二 试剑石","author":"滕斌","text":"来访书岩有异踪，镆铘剖石试霜锋。\n石悬形带青蛇色，怪欲乘风化作龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其三 灵湖","author":"滕斌","text":"岩窦中开一瓮天，蛟龙潜蓄此成渊。\n盘旋石壁水晶殿，神物朝朝作雨烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其四 石笋峰","author":"滕斌","text":"石森如笋峙岩前，天地栽培几百年。\n也合成竿长枝叶，清阴乔郁庇山川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其五 石舫","author":"滕斌","text":"仙境清虚别有天，岩中一石似横船。\n向来恐有问津者，亡却渔舟在此悬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其六 笔架山","author":"滕斌","text":"俯揖前山如笔架，笔尖高插五云生。\n我来欲蘸沧溟水，仰手摩天写太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其七 鎍泉","author":"滕斌","text":"层崖峭壁接天高，一线龙泉玉索绹。\n今古风刀裁不断，月钩悬可钓金鳌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其八 铜镮鲤","author":"滕斌","text":"当年曾把铜镮券，串却金鱼挂壁间。\n一夜风雷作霖雨，化龙飞去不知还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其九 瀑布泉","author":"滕斌","text":"飞泉瀑布自高岩，玉撒珠跳绿绮弹。\n净洗令公朝市耳，银河长泻九天寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龛岩十咏 其十 僧寺","author":"滕斌","text":"僧开寺接东龛近，人读书和梵语闻。\n时见楼台烟雾锁，数声钟鼓报朝曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访隐","author":"滕斌","text":"西风短褐飞黄埃，何不从我游蓬莱。\n狂歌醉舞下山去，后夜月明骑鹤来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜雨","author":"滕斌","text":"未到黄昏紧闭门，怒雷挟雨过前村。\n老夫熟睡浑不觉，风捲涛声入梦魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"半生","author":"滕斌","text":"半生独受春风残，万感相随秋夜长。\n隐几无眠听落叶，松梢摇雨溅山房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"僧舍","author":"滕斌","text":"一枕松风入梦清，空庭夜雨暗禅灯。\n山中酷爱僧居好，得似山中不著僧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谪会昌二首 其一","author":"滕斌","text":"莫为文章不直钱，布衣亲到玉皇前。\n好诗未足三千首，又为梅花入瘴烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谪会昌二首 其二","author":"滕斌","text":"锦衣来作夜郎客，纨扇忽逢春梦婆。\n太平宰相知我者，谁使醉后狂言多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中","author":"滕斌","text":"拍拍有怀天可语，落落不遇吾何归。\n芦山苍苍江水急，明日鹤背西风飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吟人","author":"滕斌","text":"吟人瘦倚曲阑干，酒醒香销午梦残。\n燕子不来春社去，一帘疏雨杏花寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"广贤曾堂宾出示先世手墨敬题廿八字","author":"滕斌","text":"西风吹老宾根霜，几度青山送夕阳。\n回首渊明今已矣，黄花犹带晋时香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钮处士隐居","author":"冯子振","text":"太湖光烂银，日上眩朝彩。\n幽人住此中，浩荡增?嵬。\n亦有千林橘，柯叶霜不改。\n仙翁留丹灶，五色精璀璀。\n我欲从之游，芝田为君采。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游报恩寺读东坡石刻","author":"冯子振","text":"老石经劫坏，神物在处留。\n元丰苏长公，有倡当须酬。\n莫作分别想，沧海粟影浮。\n□生宇宙间，何许更九州。\n文字千古映，醉墨楷法遒。\n愿杳五百年，华屋真山丘。\n且从蓟子训，铜狄三千秋。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉皇姊大长公主命题王孤云渍墨角抵图","author":"冯子振","text":"年来鬼弄人，狡狯出幻戏。\n崖公亦儿嬉，队伍连鼓吹。\n兽?魑魅颐，颠倒垂舞袂。\n擎梯旋注椀，骇汗增妙意。\n跳踯向虚空，浑如履平地。\n生蛇缚樊笼，鳞鬣尚黏缀。\n猎围鏖虎貙，贾勇雷电沸。\n戈旗誇战斗，狞卒弥胆气。\n最后大将麾，胡床专尊贵。\n代閒铁门限，失笑讵玩世。\n罔两曾问景，庄周语言继。\n幽冥一理耳，分别自愚智。\n百龄千万龄，伸诎肘不易。\n悬知碧桃花，长恋老仙辔。\n五穷莫移檄，文字安敢祟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠铁脚刘道人","author":"冯子振","text":"道人铁脚更铁冠，山人铁面仍铁肝。\n道人山人两相值，面色脚色俱苍寒。\n道人锋棱厓骨削，山人剑气星斗干。\n山空人去夜猿别，一苇北渡黄河乾。\n卢沟月湿波荡潏，太行云皛峰巑岏。\n古来豪杰数燕代，长毂騕袅榴花鞍。\n呼鹰射雁逐鸡狗，脱手拓弹排金丸。\n璧门双阙照燕碣，虎豹蹲踞蛟龙盘。\n布衣一语动万乘，不识宰相为何官。\n云飞气起对紫檀，血指沥沥衷如丹。\n尚方百奉谄骨裂，山人九死圣度宽。\n万里放还真堕甑，回视岁月惊流湍。\n南山清渭一梦觉，但见落叶吹长安。\n道人槌札未弃置，欲刻朽骨为荣观。\n野麋岂是麟阁具，沧海自分终鱼竿。\n穷林尺鴳无处著，岂意思想南溟抟。\n人间新贵夺纨绮，曲眉婉娈浮山峦。\n为渠向作白玉盘，眼耳鼻舌浑热瞒。\n刘郎他日高眼看，归来取铗歌冯驩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉皇姊大长公主命题展子虔游春图卷","author":"冯子振","text":"春漪吹鳞动轻澜，桃蹊李径葩未残。\n红桥瘦影迷远近，缓勒仰面何人看。\n高岩下谷韶景媚，瑟瑟芳菲韵纤细。\n层青峻碧草树腾，照野氍毹摊绣被。\n李唐岁月脚底参，杨隋能事笔不惭。\n东风晴陌苕复颖，浓绿正要君停骖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭主簿模摩诘本辋川图卷","author":"冯子振","text":"开元宇宙承平日，华子冈头曾宴适。\n至今自貌辋川图，下有幽人交莫逆。\n辛夷坞外萸沜隔，亦复扁舟春荡潏。\n竹君冰霰岁寒傲，未便申椒能辨屈。\n平生雅志厌朝市，醒醉悠哉眷泉石。\n是间山水无限趣，况乃佳宾得裴迪。\n规模想像郭忠恕，垂四百年留妙迹。\n莺啼花落香句在，谁信长安叹凝碧。\n后来拊卷意迷茫，且复追维三太息！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钟馗图","author":"冯子振","text":"老馗兀舆二鬼肩，一鬼勃窣袋影悬。\n一鬼负剑帽带旃，一鬼顶颅双角骈。\n老馗之妇舆蹁跹，其荷舆者鬼婢虔。\n猫抱掌握鬼妾妍，提其奁具雌袂玄。\n携枕而从服饰鲜，鼠蠍黏缀裤亦然。\n擎担最缓行李便，鬼之婴孺盛穿联。\n囊包橐裹琴能仙，瓠壶穹挂吁可怜。\n揭竿之魅愁攀缘，最后瓮鬼束缚椽。\n尸而行者犹能前，肌肉消尽骨骼缠。\n物怪种种来无边，神禹铸鼎今几年。\n罔两在此犹翩翩，吁嗟吁嗟问老天！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉皇姊大长公主命题王鹏梅金明池图","author":"冯子振","text":"金明池上张水嬉，百棹贾勇建鼓旗。\n按栏切云人俯砌，但觉汹汹鸣春漪。\n东西夹岸瞠万目，黄帽长年看不足。\n是时拾值宣和全盛时，消得轻绡写晴渌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米敷文楚山清晓图","author":"冯子振","text":"冥冥濛濛方寸天，不知所以然而然。\n无根老槎湿风烟，霾云懜懂栖苍玄。\n晴窗开卷作三叫，看得米家神气小。\n浓兰涂墨幻东西，污我潇湘山色晓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]