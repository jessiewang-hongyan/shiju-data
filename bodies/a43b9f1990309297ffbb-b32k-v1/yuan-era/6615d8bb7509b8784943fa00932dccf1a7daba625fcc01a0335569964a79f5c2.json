[{"title":"题溪楼","author":"余阙","text":"溪水绿悠悠，高楼在溪上。\n日暮望江南，舟中采菱唱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送康上人往三城","author":"余阙","text":"尝登大龙岭，横槊视四方。\n原野何萧条，白骨纷交横。\n维昔休明日，兹城冠荆扬。\n芳郊列华屋，文纕被五章。\n乘车衣螭绣，贵拟金与张。\n此祸谁所为？\n念之五内伤。\n竖儒谬乘障，永赖天降康。\n枞阳将解甲，皖邑寖开疆。\n耕夫缘南亩，士女各在桑。\n念子中林士，振策亦有行。\n我闻三城美，龙岭在其傍。\n连林积修阻，下有澄湖光。\n明当洗甲兵，从子卧石床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七哀","author":"余阙","text":"《殷武》诵罙阻，周鲁歌东征。\n圣哲则有然，我何敢留行。\n斩牲祀好畤，衅鼓起前旌。\n野布鱼丽阵，山鸣铙吹声。\n函关何用塞，受降行已城。\n路逢故乡人，取书寄东京。\n寄言东京友，勉树千载名。\n一身未足惜，妻子非无情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"葛编修挽歌","author":"余阙","text":"昔别情何乐，今还语向谁？\n幽房通贝阙，空馆罥芜丝。\n未过徐公墓，徒怀有道碑。\n扁舟望湖曲，清泪湿江离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得钜野泽送宋显夫佥事之南山","author":"余阙","text":"堤上柳沈沈，春蒲泛渚禽。\n济田东汇阔，汶水北流深。\n落日依中沚，浮云积太阴。\n微茫看不尽，浑似别时心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张有恒赴安庆郡经历","author":"余阙","text":"晓路通高嶂，春城入大江。\n草生垂钓浦，人语读书窗。\n肃客移茶鼎，行田载酒缸。\n幕寮谁得似，高步绝纷庞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李伯寔下第还江西","author":"余阙","text":"之子不得意，南行无怨辞。\n官河人杳杳，客路雨丝丝。\n古木淮阴市，春城孺子祠。\n悽然千里别，为赋《小星》诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云松楼","author":"余阙","text":"初日高楼上，卷幔对黄山。\n黄山出霄汉，烂熳发青莲。\n参差非一状，朝夕看屡妍。\n九华承双舄，敬亭附骈筵。\n漫漫云羃岭，沈沈松覆泉。\n清飙坐中起，如闻帝女弦。\n静有幽事乐，动无尘虑牵。\n消摇悦心目，兹道可长年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨平章崇德楼","author":"余阙","text":"重城控秋塞，丹楼耀芳甸。\n赪霞上氛氲，苍林下葱茜。\n长河城边急，积岨窗中见。\n远雁灭居延，行云归鄯善。\n大贤谢卿相，垂帏化乡县。\n春虫触宝瑟，馀花飘玉研。\n方从董园乐，陋彼歌梁转。\n伊予去山泽，寒斋秋草遍。\n载览登楼篇，益重临渊羡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长安陌","author":"余阙","text":"浩浩长安陌，琼楼夹广廛。\n鸳鸯御沟上，芍药吹楼前。\n骏马追韩嫣，金尊约郑虔。\n功名有时有，且得乐当年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得君子泉送彭公权为黄州教","author":"余阙","text":"君子没已久，遗井郡斋中。\n本寓思人意，兼全泽物功。\n银床驳故藓，玉甃落寒桐。\n几日趋官舍，横经诵养蒙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得春雁送司执中江西宪幕","author":"余阙","text":"春风起蘋末，旅雁尚回翔。\n乳鸭娇同睫，新蒲短可藏。\n应怀洞庭水，非避塞垣霜。\n客路频怀旧，题诗寄帝乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得蛾眉亭送王德常御史赴南台","author":"余阙","text":"江亭望华崿，望望似修眉。\n扫黛偏能巧，含颦知为谁？\n娟娟微雨里，脉脉夕阳时。\n千里乘骢去，因之伤别离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南归偶书二首 其一","author":"余阙","text":"帝城南下望江城，此去乡关半月程。\n同向春风折杨柳，一般离别两般情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南归偶书二首 其二","author":"余阙","text":"二月不归三月归，已将行箧捲征衣。\n殷勤未报家园树，缓缓开花缓缓飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别樊时中廉使","author":"余阙","text":"光禄桥西惜解携，春星欲傍露盘低。\n自来官柳多离思，更著城乌在上啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饮散答卢使君","author":"余阙","text":"契阔思相见，留连及此辰。\n长江映酒色，细雨若歌尘。\n所喜襟怀共，由来态度真。\n何时洗兵马，得与孟家邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得琵琶峰送人降香龙虎山","author":"余阙","text":"琼峰毓奇态，高高出先天。\n柄超琳阙迥，盘影渌池圆。\n别□标苍樾，回窗蓄紫烟。\n淙流如度曲，藤蔓似长弦。\n肖像生仪始，希颜太古前。\n虽无罗袖拂，常映涧花妍。\n子有灵侯技，能弹《大道》篇。\n函香一临眺，天际意飘然。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"可惜吟","author":"余阙","text":"春风吹人上妆楼，楼头画眉望池州。\n平生倚君似山海，十年不见胡不愁。\n东家买红聘小女，西家迎鸾夜击鼓。\n眼看拾翠同年人，今又堂堂作人母。\n良人良人固家贫，妾身待君亦苦辛。\n只愁明镜生白发，有钱难买而今春。\n此心悬知燕堪托，裁书系渠左边脚。\n愿将妾言入其幕，缬纹资装亦不恶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扬州客舍","author":"余阙","text":"船头浇酒祀神龙，手掷金钱撒水中。\n百尺楼船双夹橹，唱歌齐上吕梁洪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李白玩月图","author":"余阙","text":"春池细雨柳纤纤，手倦挥毫日上帘。\n想得停杯江海夜，月明照见水晶盐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题洪氏舫轩","author":"郑玉","text":"山人爱舟屋亦舟，山中便作沧海游。\n何须风帆冒险远，东西南北穷遐陬。\n向来此是荆棘地，今日遂作江湖秋。\n门前岚雾霭苍翠，浑疑江上烟波浮。\n云旋日动屋移影，舟行岸转曲江头。\n主人自是济川手，坐令涉险如安流。\n复有佳客天下士，作记写出清绝幽。\n王先生诗继二雅，五字万里争追求。\n徐公翰墨妙当世，夜深光彩射斗牛。\n世间尤物自足贵，安用航海珠玉谋。\n谁当共此乐朝夕，窗外忘机两白鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黟坑桥亭次以文韵二首 其一","author":"郑玉","text":"擢笔题高柱，披襟挹好风。\n剖瓜苏渴客，采药识仙翁。\n飞鸟连云白，幽花点水红。\n相从问归路，疑误入崆峒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黟坑桥亭次以文韵二首 其二","author":"郑玉","text":"结屋依山麓，衣冠尚古风。\n醉人千日酒，扶杖百年翁。\n云起山松绿，风回野烧红。\n谁云避世者，犹自在崆峒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中寄兄弟","author":"郑玉","text":"苦热已无计，那堪与病俱。\n过从无好客，遣兴有新书。\n世事炎凉态，人生骨肉躯。\n何当寄伯仲，相与问何如？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题天目山","author":"郑玉","text":"势压东南万象低，溟濛空翠望中迷。\n龙飞凤舞川原秀，地下天高日月齐。\n武肃百年钟霸气，文忠千古欠留题。\n客来欲问青云路，凿破崚嶒便作梯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"婺源胡氏屏山楼","author":"郑玉","text":"楼外青山列翠屏，矮窗放入眼增明。\n丹青花草春描画，水墨林泉秋写成。\n变化四时无俗韵，登临千古有馀清。\n高人对此不容语，独倚阑干看晚晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白岳","author":"郑玉","text":"名冠江南第一山，乾坤故设石门关。\n重重烟树微茫里，簇簇峰峦缥缈间。\n五夜松声惊鹤梦，半龛灯影伴人閒。\n忽闻环佩珊珊度，知是神仙月下还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师山书楼成唐长孺先生赋诗见寄次韵","author":"郑玉","text":"居山日夕见山容，环堵萧然一亩宫。\n我喜烟云来几上，人看楼阁出空中。\n夜深月色偏明朗，晓起岚光更郁葱。\n若比羊裘轩上景，临江惟欠一丝风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵述怀","author":"郑玉","text":"家住江南黄叶村，绳枢瓮牖席为门。\n自罹盗贼人传死，重见交游我幸存。\n焦土更无遗简策，供厨惟有旧匏尊。\n黄巾迎拜何为者，自愧疏庸不足论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月十四夜玩月岑山次鲍伯原韵","author":"郑玉","text":"夜深云散碧天开，月影沈沈入酒杯。\n风露半天成颢气，干戈满目起尘埃。\n分明沧海浮双岛，隐约严滩见两台。\n今日有怀须尽兴，明朝无雨约重来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游覆船山宿草堂","author":"郑玉","text":"眠云石下屋三间，瀑布当檐坐卧看。\n怪底岩前龙忽起，夜来风雨不胜寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登师山诸生有书二首 其一","author":"郑玉","text":"城上钟声度远溪，扶桑破曙海云低。\n披衣欲起还敧枕，山下晨鸡四面啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登师山诸生有书二首 其二","author":"郑玉","text":"山前村落乱高低，云意模糊远近迷。\n万叠峰峦如画展，黄山正在小楼西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"覆船山樵歌 其一 家童磡","author":"郑玉","text":"路入黄茅剑断蛇，疏篱石磡野人家。\n山深地冷春难老，五月岩前见落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"覆船山樵歌 其二 响泉","author":"郑玉","text":"历尽崎岖上碧岑，高山流水似鸣琴。\n何须水乐寻幽洞，自有岩前太古音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"覆船山樵歌 其三 金婆店","author":"郑玉","text":"常忆当年武肃王，金婆店里月华光。\n山中十月桃应熟，未荐仙人不敢尝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵诗用仲安韵五首 其一","author":"郑玉","text":"对簇鳌山十万人，皇都今夕几分春。\n六街三市浑如昼，寄语金吾莫夜巡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵诗用仲安韵五首 其二","author":"郑玉","text":"神前儿女舞妖娆，社下游人弄管箫。\n到处人家说元夕，不知元夕是今宵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵诗用仲安韵五首 其三","author":"郑玉","text":"赏罢花灯步月归，自将拄杖扣柴扉。\n回头形影惊相吊，但觉从前百事非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵诗用仲安韵五首 其四","author":"郑玉","text":"天下承平近百年，歌姬舞女出朝鲜。\n燕山两度逢元夕，不见都人事管弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵诗用仲安韵五首 其五","author":"郑玉","text":"市上灯张玉井莲，门前箫鼓更喧天。\n先生懒向儿童语，闭户高居但欲眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扫室","author":"陈高","text":"日日扫居室，既扫尘复生。\n性癖颇爱净，去尘心乃清。\n居间虽少事，处世岂无营。\n弱子在襁褓，几时堪使令。\n蹉跎叹光景，困守限户庭。\n非无四方志，边隅未休兵。\n遥闻官军出，尽毁徐州城。\n朱门与碧牖，回首成榛荆。\n江淮及闽越，寇盗之所经。\n人民苟全活，奔走不得宁。\n眷兹蓬庐下，栖迟聊慰情。\n但当勤洒扫，读书饱藜羹。\n万事委天运，何必求荣名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚归","author":"陈高","text":"西崦日初没，远树生夕阴。\n晚步草露湿，独归松径深。\n入室载言笑，稚子牵衣襟。\n尊中有浊醪，可以酌复斟。\n坐来窗牖白，佳月出东林。\n幽情寄觞咏，适意忘华簪。\n自得间居理，宁忧外患侵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"迁居","author":"陈高","text":"迁居城南村，幽情意所适。\n室庐颇虚敞，结构自畴昔。\n倒桧护周垣，修竹荫奇石。\n涓涓井泉清，霭霭檐云白。\n去郭二三里，迥与嚣尘隔。\n于兹载寝兴，朝暮靡所迫。\n读书南窗下，奉食老亲侧。\n褰裾戏童稚，煮茗待宾客。\n身閒贫亦佳，机忘心已寂。\n旋种园中蔬，春叶庶堪摘。\n时危幸安处，生理宁复识。\n虽非旷达夫，玩世聊自得。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊馆头步","author":"陈高","text":"朝发芳林岭，夜依馆头泊。\n厌兹跋涉劳，怀哉田园乐。\n生理苦艰难，归耕叹悠邈。\n贫窭何足忧，甘旨焉所托。\n栖栖道路中，素心负丘壑。\n行年三十馀，齿牙半摇落。\n良由筋骨疲，岂但质衰弱。\n忧思耿不寐，起观众星白。\n群鸡鸣江皋，已复戒行客。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"近山轩燕集","author":"陈高","text":"幽轩近青山，层檐荫高木。\n兹晨天气佳，凉雨破袢燠。\n鸣蝉度新声，丛蕙散馀馥。\n几席具陈列，笾豆进殽蔌。\n故人吴中归，举酒喜相属。\n微酣各忘形，起坐命棋局。\n好乐初匪荒，笑语胜丝竹。\n人生百年内，光景犹转毂。\n况当艰虞际，欢会情愈笃。\n酒阑复何言，长歌《紫芝曲》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过冯公岭","author":"陈高","text":"绝壁倚霄汉，千峰势如驰。\n何年五丁士，凿石连天梯。\n萦纡不可上，髣髴登峨眉。\n白石齧我足，霜风吹我衣。\n前途政迢递，我已筋力疲。\n寒花道傍开，幽鸟林间啼。\n彷徨俯自慰，少憩日已西。\n浮生浪奔走，困踣胡尔为。\n他年履坦道，慎勿忘崄巇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其一","author":"陈高","text":"唐虞邈以远，禹汤亦悠悠。\n周辙一东狩，王纲遂漂流。\n春秋更五霸，日日寻戈矛。\n陵夷逮七国，斯民益无聊。\n战血满沟堑，杀星入云霄。\n商君佐嬴秦，变法开田畴。\n积强至六世，虎视吞诸侯。\n宰割天下地，郡县罗九州。\n焚香任法律，儒士咸虔刘。\n汉皇起丰沛，三尺诛民雠。\n开基四百年，烈烈壮鸿猷。\n惜哉英明主，不学遗远谋。\n一时侩狗徒，赞业非伊周。\n遂使皇王政，废堕不复修。\n此机一以失，馀恨空千秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其二","author":"陈高","text":"青山或可移，白石尚可转。\n志士怀苦心，九死不愿返。\n首阳饿仁贤，至今激贪愞。\n汩罗沈楚累，千载悲忠蹇。\n人生谁不死，身没名贵显。\n胡为草玄人，美新思苟免。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其三","author":"陈高","text":"豪家列华第，被金饭珠玉。\n茅屋耕田夫，衣食常不足。\n均为羲皇民，胡焉异荣辱。\n远怀雍熙世，宁复有兹俗。\n谁与开井田，吾思食其肉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其四","author":"陈高","text":"缥缈浮图宫，俨若王者居。\n列徒二三千，僮仆数百馀。\n饱食被纨素，安坐谈空虚。\n秋来入租税，鞭朴耕田夫。\n不恤终岁苦，徵求尽锱铢。\n野人不敢怒，泣涕长欷歔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其五","author":"陈高","text":"客从北方来，少年美容颜。\n绣衣白玉带，骏马黄金鞍。\n捧鞭揖豪右，意气轻丘山。\n自云金张冑，祖父皆朱幡。\n不用识文字，二十为高官。\n市人共咨嗟，夹道纷骈观。\n如何穷巷士，埋首书卷间。\n年年去射策，临老犹儒冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其六","author":"陈高","text":"步出城门道，忽见群车驰。\n车中何所有？\n文贝光陆离。\n美娃载后乘，销金灿裳衣。\n问之何如人？\n云是官满归。\n闻者交叹息，清名复奚为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴七首 其七","author":"陈高","text":"悲风西北来，树木声萧萧。\n蟋蟀鸣四壁，鸿雁飞层霄。\n时光忽已异，四序如更徭。\n人生无百年，转瞩朱颜凋。\n胡不崇明德，早使勋业昭。\n空悲千载下，身死名寂寥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陆有章分题得巽山","author":"陈高","text":"巽山如层台，积翠俯城郭。\n古木秀松槠，玄鸟隐楼阁。\n雨散飞素云，风静语丹鹤。\n游人日跻攀，杖屦相绎络。\n陆郎吴中来，雅志好丘壑。\n哦诗松间题，携酒石上酌。\n我性亦爱山，方期结幽约。\n兹焉送子去，登陟惨不乐。\n远别已伤怀，真境况寥落。\n伫立睇大江，孤舟入冥邈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留别诸友分韵得日字","author":"陈高","text":"寒色满大江，北风吹落日。\n停舟别诸彦，中怀抱湮郁。\n夤缘结金兰，深固比胶漆。\n佳会不可常，岁晏政寥慄。\n居者成淹留，行者念家室。\n分携在俄顷，东西永相失。\n俯视流波去，仰看飞鸟疾。\n人生如浮萍，乾坤渺萧瑟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青田山房为刘养愚赋","author":"陈高","text":"幽幽青田山，积翠高千寻。\n大溪经其南，白云在山阴。\n下有隐者居，卜筑邃以深。\n开门面石壁，结构依松林。\n墙古薜荔长，砌閒苔藓侵。\n檐间戏驯鹿，户外鸣幽禽。\n花卉春佳冶，竹木夏萧森。\n秋宵月照牖，冬晨雪明岑。\n尘坌讵能到，车马绝过临。\n其中何所有，乃有书与琴。\n逍遥足忘世，俯仰可娱心。\n酒熟聊自醉，兴来时独吟。\n永谢城市喧，何用怀缨簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"征妇怨","author":"陈高","text":"征夫出门时，征妇泪垂垂。\n把酒劝夫饮，执手问归期。\n归期今已过，更无消息归。\n朝朝倚楼望，只见雁南飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落梅曲","author":"陈高","text":"梅花开满枝，无奈晓风吹。\n风吹花落尽，争似未开时。\n花开终有落，非关晓风恶。\n愁杀爱花人，城头复吹角。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"商妇吟","author":"陈高","text":"嫁夫嫁商贾，重利不重恩。\n三年南海去，寄信无回言。\n妾身为妇人，不敢出闺门。\n缝衣待君返，请君看泪痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]