[{"title":"挽宝哥参政","author":"鲁至道","text":"香魂俊骨坠深渊，无智无谋亦可怜。\n妖寇猖狂如有祟，生民凋瘵似无天。\n芳名苟得千年在，死节应当二日先。\n欲向西湖酹尊酒，凄风冷雨浪无边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"方澜","text":"以诗为佛事，随地学山居。\n煖容时借酒，寒力晓欺绵。\n万事集双鬓，百年堪几愁。\n江流拍岸阔，海气入城凉。\n疏钟出烟寺，新月入人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"濮彦仁","text":"丈人夜开关，凉月在松顶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜偶成","author":"朱守谅","text":"两围江水薄城闉，地僻民稀俗化醇。\n暂止熊罴消大暑，秋深云合殄妖氛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扇上诗","author":"黄德广","text":"东风一曲浣溪纱，客子行吟对日斜。\n犹记金陵贳春酒，小姬能唱后庭花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道山亭联句首联","author":"申屠駉","text":"追陪偶上道山亭，叠障层峦绕郭青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次联","author":"僧家奴","text":"万井人家铺地锦，九衢楼阁画帏屏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三联","author":"僧家奴","text":"波摇海日添诗兴，座引天风吹酒醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"结联","author":"奥鲁赤","text":"久立危栏须北望，无边秋色杳冥冥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"钱惟善","text":"笠泽水寒鱼尾赤，洞庭霜落树头红。\n汉史丁公那及齿，陶诗甲子不书元。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"钱惟善","text":"生前母应金钱梦，死后人称铁笛仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"卢琦","text":"岚气满林晴亦雨，溪声近驿夜如秋。\n潮生远浦孤帆小，雨过苍崖古木寒。\n小桥跨涧村舂急，老树吹花野店香。\n暮云松径僧归寺，夜雨篷窗客在船。\n门掩落花春去后，梦回残月酒醒时。\n梧叶几番深夜雨，梅花一树短篱霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乱后","author":"孔皖","text":"故居烧后拾残编，留得陶诗一两篇。\n彭泽岂堪犹作令，义熙何忍再书年？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箕山操和铁雅先生首唱","author":"李孝光","text":"箕山之阳兮，其木樛樛。\n箕之冢兮，白云幽幽。\n彼世之人兮，孰能遗我以忧。\n虽欲从我兮，其路无田。\n朝有人兮，来饮其牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖冰合","author":"张翥","text":"西湖雪厚冰彻底，行人径度如长川。\n风吹盐池结阴卤，日射玉田生暖烟。\n鱼龙穴里寒更缩，鸥鹭沙头饥可怜。\n安得长冰通沧海，我欲三岛求神仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋丞相信国公上巳诗","author":"吴师尹","text":"崖山云寒海舟覆，六载孤臣老燕狱。\n东风杜宇三月三，五云望断春芜绿。\n墨花煌煌五十六，写出江南愁万斛。\n当时下笔眼如虎，日落天低鬼神哭。\n扬帆昔走仪真船，手持鳌柱擎南天。\n间关岭海血洒檄，回首家国随飞烟。\n六宫粉黛黄埃里，汉火无烟吹不起。\n全躯肯效褚渊生，嚼舌甘为杲卿死。\n蓟门碧草春悽悽，为官不换西山薇。\n哀吟一曲肝肠裂，劲气万丈蛟龙飞。\n当年恨杀葛岭贼，恨不刳心饮其血。\n堂堂忠义行宇宙，白日青天照遗墨。\n再拜酬公金屈卮，有酒不读兰亭诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鉴湖风月","author":"方子京","text":"贺仙归去隐沧浪，万顷晴波一镜光。\n龙瑞尚存古时迹，鸿禧犹带晋馀芳。\n两堤杨柳三更影，千树芙蕖五月凉。\n后数百年无问处，云山烟水共苍茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自题其像","author":"周志远","text":"十年尘土变形容，惟有丹心日月同。\n北海子卿羝不乳，未应已在画图中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"勉学诗","author":"陈谦","text":"黄河西北来，云是昆崙丘。\n经行非一山，回薄半九州。\n上有不测源，下有无尽流。\n万化同此机，不知几春秋。\n分明天地心，不为浅狭谋。\n痴人用小计，颠倒若无求。\n安得申韩氏，化为古伊周。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"贡师泰","text":"红莲日涌神仙幕，翠柏霜飞御史台。\n千金海上求骐骥，五色云间下凤凰。\n貔貅万灶新趋幕，虎豹千门旧直庐。\n小雨挟云行断岸，乱山排浪入孤城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云林画","author":"黄公望","text":"远望云山隔秋水，近看古木拥陂陀。\n居然相对六君子，正直特立无偏颇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云林六君子图","author":"钱云","text":"黄公别去已多年，忽见云林画里传。\n二老风流辽鹤语，悠然展卷对江天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自题画","author":"吴镇","text":"枝枝自参差，叶叶无限量。\n不根而自生，换却诸天相。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题贞期为杨竹西草亭图卷","author":"杨谦","text":"翠玉萧萧在屋东，主人号作竹西翁。\n品题莫说扬州梦，好写閒云入卷中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"不碍云山楼歌","author":"杨谦","text":"海之云兮油油，雨我田兮有秋。\n海之山兮离离，障我流兮东之。\n云之动兮跹跹，吾与云动兮动而不迁。\n山之静兮层层，吾与山静兮静而不停。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王叔明仿董北苑风雨萧寺图","author":"沈良","text":"墨云拥高山，顷刻风雨至。\n划然海潮声，草木争偃地。\n旷野少人行，山僧独归寺。\n衲衣尽沾湿，敲户何急事。\n仓皇前村民，乘屋一何亟。\n一婢已抱瓮，一妇更持器。\n重茅惜被卷，破屋家所寄。\n戴笠者渔郎，理网屈双臂。\n老翁若望家，担物终不弃。\n陆走尚甚危，水行可无畏？\n前溪风雨恶，篙折水流驶。\n行者当早归，居者不豫备。\n北苑为此图，黄鹤师其意。\n想见晚来晴，云净山横翠。\n始信霎时间，真宰特相戏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秀野轩图","author":"张监","text":"我忆天池与玉遮，幽轩水木澹清华。\n笙竽远振风林竹，锦绮晴连晓径花。\n山罽敷床朝看雨，涧泉漱石夜分茶。\n番阳大篆睢阳画，不负舂陵处士家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题破窗风雨图","author":"沈廷圭","text":"刘君性嗜学，孜孜事三馀。\n孤灯破窗下，简编自卷舒。\n潇潇风雨来，吾伊声自知。\n安贫人所难，味道心常愉。\n我闻颜子渊，箪瓢陋巷居；千载称亚圣，声价重璠玙。\n又闻陶渊明，所处亦敝庐；萧然环堵间，左右惟图书。\n吁嗟世之人，惟乐耳目娱。\n华居美饮食，所务安其躯。\n良心日以斲，畴能返厥初？\n勖哉刘孝廉，圣贤以为徒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题破窗风雨图","author":"钟虞","text":"一室萧然谁与同，清如独鹤寄樊笼。\n诗成春草池塘上，梦绕玉堂云雾中。\n花气每随岚气入，书声时与竹声通。\n从容更觅新晴好，卧看东林日影红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题破窗风雨图","author":"何恒","text":"一室萧然四壁空，客怀况复雨兼风。\n湿沾衣服愁仍重，清到肌肤句转工。\n知命肯随时变化，甘贫宜为道污隆。\n夜深尚对羲皇易，应怪寒灯不耐红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题刘孟功竹深处","author":"石宇","text":"高风远市门，植竹千筼筜。\n苍雪下庭砌，玄阴翳齐房。\n晴旭仙聚岛，鲜飙凤鸣阳。\n碧滋润简编，翠浥浮冠裳。\n披图有真趣，夙抱非羁寓。\n游踪自南北，梦寐还相遇。\n朝哦栖遁词，暮诵琳琅句。\n恍即故园居，森森竹深处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹深处诗","author":"黄仲瑶","text":"乐彼数亩园，青青万竿竹。\n中有读书人，开轩伴幽独。\n轩前轻阴埽不开，轩后繁声疑雨来。\n春风淡荡拂翠羽，白露泠泠生莓苔。\n入窗无尘从不埽，吐蓐在地琼花老。\n夜深对月任光微，昼永乘风觉凉好。\n有时早起坐石床，口中吹笙鹅管长。\n有时枕书卧轩中，清兴窅入蓬莱宫。\n蓬莱宫阙几千里，红尘不到看书几。\n彩鸾紫凤情翩翩，一段清光照流水。\n昨日我来造竹下，主人开门笑相迓。\n山肴满盘酒满壶，醉歌一曲为君谢。\n岂不见园中桃，又不见道旁柳，昔日媚春华，今日成衰朽！\n何如此君含彩故青青，独向轩楹托根久。\n劝君更种松与梅，岁寒清绝成三友。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹深处诗","author":"邓资深","text":"种得筼筜数百竿，筑亭深处伴秋寒。\n危梢滴露清堪掬，密叶笼云翠作团。\n夜月虚涛翻素壁，晚风清佩响雕栏。\n漪漪绝胜淇园好，会看窗前宿凤鸾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹深处诗","author":"倪维哲","text":"吴门烟雨掩荆扉，湘楚清兮一径微。\n丛覆蔽空忘昼永，凉生入夜觉寒归。\n王猷疏散人皆仰，刘向操持世不违。\n儒业已闻沾宠渥，休将宦思恋初衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹深处诗","author":"赵次进","text":"高人适幽趣，羡此琅玕清。\n新梢和露滴，旧叶迎风鸣。\n结屋住深处，时见茶烟横。\n焚香手遗编，讵有尘虑萦。\n一自绾章绶，梦入吴中行。\n觉来尚幽意，满抱凉吹生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹深处诗","author":"金灏","text":"碧琅玕下觅幽踪，行尽斋居路始通。\n烟歛月梢金琐碎，风生云干玉琤琮。\n秋光满座阴长合，靛色清神暑自空。\n净扫苍苔夜留客，解衣磅礴兴无穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"潘纯","text":"阿翁作画如说法，信手拈来种种佳。\n好水好山涂抹尽，阿婆脸上不曾搽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卖花声","author":"谢宗可","text":"春光叫尽费千金，紫艳红香藉好音。\n几处唤回游冶梦，谁家不动惜芳心。\n韵传杨柳门庭晚，响彻鞦韆院落深。\n忽被捲帘人唤住，蝶蜂随担过墙阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"谢宗可","text":"筛影细分云缕滑，棋文斜界雪丝乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题西泠隐居","author":"叶广居","text":"瘿木裁冠鹤氅轻，十年尘土厌飘零。\n小山旧隐云封户，大药新栽月满庭。\n丹井夜交龙虎气，碧霄春蹑凤凰翎。\n西风客舍炎歊净，拟读琴心内景经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨铁崖","author":"叶广居","text":"闻道西湖载酒还，飞琼弱翠拥归鞍。\n可无私梦登金马，剩有春声到玉銮。\n异国顿消乡井念，小堂新作画图看。\n野人未纳彭宣履，独向清溪把钓竿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"吴复","text":"官河绕湖湖绕城，河水不如湖水清。\n不用千金酬一笑，郎恩才重妾身轻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴复","text":"江花多自落，天籁或时鸣。\n云归沙屿白，日出水城黄。\n云气上天星剑湿，龟文入地石幢深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"卫仁近","text":"江水深深碧，梨花淡淡明。\n九农劳畚锸，三泖足风波。\n亚夫旧是将军子，贾谊初传太傅官。\n玉人娇列锦步障，银笔醉调金缕衣。\n醉吹银笛五老洞，閒拾瑶草三神山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"胡布","text":"斧斲云根木，瓢探石窦泉。\n旭日千门晓，春花万树明。\n穴深留禹迹，松古受秦封。\n夕嶂兼空净，秋江得月多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨菊","author":"胡布","text":"彭泽归来日，缁尘点素丝。\n乌纱漉酒后，挂在菊花枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王士毅","text":"陶潜千载友，相望老东皋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪后读杜诗","author":"朱子范","text":"十年乡国乱，几卷杜陵诗。\n闭户挑灯夜，深山积雪时。\n紫阳誇入蜀，双井喜居夔。\n歧路终何适，吾将有所思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"韩奕","text":"水国秋来少见晴，夕阳忽映小窗明。\n西风飒飒林间叶，乍听犹疑是雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"讽兄诗","author":"沈贵","text":"锦衣玉食非为福，檀板金樽可罢休。\n何事子孙长久计，瓦盆盛酒木绵裘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题扉上","author":"周必达","text":"海角愚夫不自斟，妄起关中逐鹿心。\n命运由来非力致，项羽英雄亦就擒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"何景福","text":"绣床渐觉香毬满，鱼艇初疑雪片多。\n龙吟五夜霜飞瓦，鼍吼三更月满城。\n青山自此诗名重，采石如今酒价低。\n荒祠昼掩无人到，苦木丛中春鸟啼。\n风景不殊豪杰尽，新亭谁复泪沾衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"罗蒙正","text":"儒冠不是将军具，只作当年措大看。\n愿赐一廛閒养病，简编灯火伴青衿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"栽芋","author":"陈德载","text":"区里饶田早下来，绿芽才发旋锄开。\n添泥善护儿孙长，看取秋高掇大魁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"栽桂","author":"陈德载","text":"云边移得数株来，人老花应次第开。\n傥到儿孙攀折日，也须道是阿公栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双洲","author":"程从龙","text":"涉水逾山窜草莱，乱离怀抱几时开？\n元家运变黄河徙，汉土兵兴赤帜来。\n夜寂堠亭烽火盛，月明江舰角声哀。\n风沙满目乡关异，日暮愁登江上台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"韩友直","text":"泉出珠玑千眼沸，花开锦绣一庭春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐一夔独树轩","author":"潘时雍","text":"潇洒幽轩面水开，轩前老树倚云栽。\n閒来倚杖过三市，醉后支颐看百回。\n风雨欲随龙化去，云霄常听鹤飞来。\n结邻拟共荣枯事，遮莫人知是散材。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"顾素","text":"家人不笑营生拙，野老空嘲历聘忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乐神曲录三 其一 太湖神","author":"沈贞","text":"波震荡兮具区，既底定兮奠神之居。\n芙盖兮菱车，导翠鼋兮文鱼。\n神之来兮孰俱？\n后子皮兮前灵胥。\n与神游兮湖之浒，冲风息兮极浦。\n有倡兮妙舞，有冽兮清酤。\n神饱聿归兮或返而顾，灌吾田兮受神之祜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乐神曲录三 其二 乡厉","author":"沈贞","text":"雄何为兮厉于乡，祀有时兮享有尝。\n赭白马兮青盖，明而无兮晦而在。\n屏方相兮去傩，神巫进兮舞且歌。\n雄欣欣兮远逝，不水旱兮不疵厉。\n乐吾民兮世世。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乐神曲录三 其三 青苗神","author":"沈贞","text":"两旗兮分张，舞轻风兮悠扬。\n神之司兮我疆。\n原田每每兮立我青秧，不稂不莠兮无虸无蚄。\n时雨兮时旸，俾百谷兮登场。\n维神兮降康，报之肴兮蒸腯羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲张仲举","author":"韩介玉","text":"垂柳阴阴拂翠檐，倚栏红袖玉纤纤。\n先生掉臂长街过，十里朱楼尽下帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"食丁蕈戏作","author":"程渠南","text":"头子光光脚似丁，祇宜豆腐与波棱。\n释伽见了呵呵笑，煮杀许多行脚僧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"口占","author":"鲁琪琳","text":"三百五篇风雅颂，世人能读少人观。\n吟哦须得自情性，雕琢反愁失肺肝。\n春草池塘中造化，梅花香影外波澜。\n熟参熟究工夫到，始信仙凡共一丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王祯","text":"一行已见光如拭，再过都无迹可寻。\n本拟助禾轻著力，却凭偃草重于风。\n禹门似是崇三级，巫峡还同束众流。\n花径有同流暗水，桃源误认出残红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"高志道","text":"流水落花西子宅，故家乔木范家祠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蔡九娘诗","author":"陈乾富","text":"一笑花前醉似泥，绮筵欢剧不闻鸡。\n马蹄到此空归去，不是花迷是酒迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉环诗","author":"陈乾富","text":"使台归骑准鸣笳，花气茶烟竞院奢。\n禽慧不须云板约，好窥人意唤琵琶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]