[{"title":"和马伯庸御史春游","author":"张雨","text":"山巾垫角雨仍斜，岁岁春风换鬓华。\n湖口水香鱼在藻，江南食冷客思家。\n鹫峰扫石翻经叶，龙洞分符调井花。\n游骑却归城郭暮，醉红犹带脸文霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"广陵有寄璚花诗丐余次韵","author":"张雨","text":"未信人间日易斜，携春来问列仙家。\n情知后土无双树，迷杀江都是此花。\n芍药谩吟红茧粟，璚儿从眄玉兰芽。\n一壶能共樊川老，醉写乌丝侧帽纱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自笑","author":"张雨","text":"自笑摧颓如病鹤，羽衣仍复会婆娑。\n已裁斑竹将扶老，更剪蟠枝作养和。\n骤雨欲来移蚁穴，落花多罢分蜂窠。\n裹头多上春官老，不道丘园自一科。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朱伯贤茂才之金陵","author":"张雨","text":"句容山邑长官清，此日况逢贤友生。\n案牍劳人烦慰藉，风尘为客话经行。\n宽裁白苧游萧寺，近觅青骡过冶城。\n能赋钟英怀古昔，一时骢马尽知名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈琳摹董源渔乐图","author":"张雨","text":"小笔谁临北苑图，兰亭玉枕最难模。\n连峰秀树□□□，□□荒云远欲无。\n泊向小孤缘爱石，望从青草别名湖。\n□□□□如相借，暂卸南风十幅蒲。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孤山即事","author":"张雨","text":"笑抚湖山迹易陈，先贤祠宇一番新。\n玉鱼蔓草多无主，白鹄秋天迥有神。\n曲港穿冲花外骑，赤阑扶约水边人。\n冈头□□枯梅蘖，独是先生肺腑亲。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"素华台","author":"张雨","text":"素华台榭压昆丘，况近仙家十二楼。\n白里深蟠龙虎气，空中遥接凤凰游。\n琉璃研水偏盛月，云母屏风不隔秋。\n姑射山中有冰雪，神人愿与国同休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月六日步过白莲峰眠食尽日而回","author":"张雨","text":"沥沥阶除走暗泉，入厨新溜动厨烟。\n早来燕坐斋中饭，梦在山光寺里眠。\n石脚尽盘千个竹，树头未动一声蝉。\n此中长日谁为伴？\n海岳庵诗在枕边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"猿臂笛","author":"张雨","text":"三峡家山已隔生，一枝玉骨尚堪横。\n攀援远似穿云曲，吟啸高于喷竹声。\n栗叶霜黄天竺梦，梅花春老玉关情。\n伶伦且为相娱乐，谁问将军善射名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏商隐还京师","author":"张雨","text":"扈跸行营三十载，王门不肯曳长裾。\n閒从角里先生饮，与说圯桥父老书。\n花外飞丸红叱拨，月中采药玉蟾蜍。\n残骸尚有刀圭分，会向南山访弊庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和率性大涤十咏 其一 云根石","author":"张雨","text":"石色斑斑野鹿胎，石身浑裹夜明苔。\n直将瑞气穿龙洞，不比游尘汗马嵬。\n岩下松枝同不朽，月中鹤驾合频来。\n君看怪石英雄坐，寂寞于今卧草莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和率性大涤十咏 其二 龙洞","author":"张雨","text":"怪石蜿蜒驱不动，自从开辟镇重坤。\n雨声多在南山殷，云气都令白昼昏。\n百尺潜虬窥海眼，一杯流水浸松根。\n有时急□天符下，故遣灵人夜叩阍。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和率性大涤十咏 其三 凤洞","author":"张雨","text":"第几峰前苍玉洞，何年于此凤求皇。\n梧枝宿久毛皆变，竹实餐多髓亦香。\n露湿紫苔春似锦，月明丹穴夜生光。\n我亦鹓行旧俦侣，云中有路共回翔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和率性大涤十咏 其四 翠蛟亭","author":"张雨","text":"谁见苍龙劈石开，此峰元自胜飞来。\n阑干截断山头雨，赑屃翻将地底雷。\n寒甚祇疑云是雪，霜馀每恨叶成堆。\n坡仙独对无言说，惭愧搜诗日几回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祀五先生景行莫君为遨头诗以记之","author":"张雨","text":"洛中诸老今谁识，饮少年高听细论。\n百五日前花送雨，十三楼下水侵门。\n岭霞栖向仇池穴，春鸟啼将蜀客魂。\n方外归来羞秃鬓，也容乡社割鸡豚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵僧来闻笑隐住持事繁风雨有怀","author":"张雨","text":"忆曾共坐翻经石，语我松华压酒方。\n一自宜城居辅国，几时天竺话连床。\n栖栖春草元桑楚，历历风铃替戾冈。\n乞得江东今夕雨，与君聊洗梦中忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闰三月三日北山看花不与盟","author":"张雨","text":"应笑黄花厄闰时，后三仍复负芳期。\n老无刘几簪花分，閒有陶潜止酒诗。\n谷雨林中先紫笋，郁罡山口足黄鹂。\n韩湘自倩奴星去，袖得瑶台第一枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"形影","author":"张雨","text":"形影胡为乐此留，山川映发思绸缪。\n歌长杯酒毋多酌，世短何人第一流。\n弟子受经犹北面，樵青分屋自西头。\n下方误识金银气，直倚崆峒一剑秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王若水梨花山鹊","author":"张雨","text":"山鹊语查查，惊飞白雪花。\n清明人载酒，寒食客思家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"芍药白兔图","author":"张雨","text":"妥帖红云朵，迷离玉兔儿。\n扬州行乐地，惆怅鬓成丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"张雨","text":"二山环合一水，中有老木参天。\n不著幽人草阁，谁收无限云烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊尽","author":"张雨","text":"小雪初晴腊尽时，无穷梅柳怨开迟。\n人间不觉春来早，只有吾家布被知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中客夜","author":"张雨","text":"鞍马南州五日程，岂知物外有茅亭。\n尘埃暑困人如醉，月露夜凉天亦醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其一","author":"张雨","text":"白玉之盘沧海东，苍苍下视远如空。\n请看端正山河影，不满坳堂杯水中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其二","author":"张雨","text":"鸿宝枕函云积叠，芝台炉火暖氤氲。\n子能试吃青精饭，我亦聊书白练裙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其三","author":"张雨","text":"夜久扶桑海色分，珠宫望拜赤龙君。\n洞庭未省君山在，元是昆仑一朵云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其四","author":"张雨","text":"藤萝石上寻长迹，金粟图中见小身。\n抖擞几重衣裓看，情知不□散花人。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其五","author":"张雨","text":"庞见《霓裳》舞广庭，罢看三十九章经。\n道人腰著金鸦嘴，自向松根洗茯苓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其六","author":"张雨","text":"右股清池足沤麻，池中肥水是松花。\n早知魏帝一丸药，肯信东门五色瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其七","author":"张雨","text":"耻作深山服食仙，伐毛洗髓故依然。\n木兰坠露研朱写，只写南华《秋水》篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其八","author":"张雨","text":"脚底琴生三尺鲤，袖中阿母一双桃。\n别时身动凌波袜，烂月如银照夜涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其九","author":"张雨","text":"眼中自小薄蓬瀛，日日双飞下始青。\n□□明窗尘仿佛，定知草创大丹成。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明德游仙词十首用天柱山传来依韵继作云林道气者观之亦足自拔于埃壒矣 其十","author":"张雨","text":"玉格金科自有期，赤城何待远寻师。\n壁梭也解为龙去，樵斧如何只看棋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听琴图","author":"张雨","text":"袅烟石壁对孤桐，与和长松瑟瑟风。\n不为野夫清两耳，为君留目送飞鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"史局先生示以季境□□赠行卷辄题一绝卷锦","author":"张雨","text":"校书苦借青藜杖，下马笑拈金屈卮。\n好是淮南师弟子，钱唐相见落花时。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三香图","author":"张雨","text":"凌波仙子尘生袜，空谷佳人玉鍊容。\n不奈天寒风露早，日高犹傍锦熏笼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"张雨","text":"白足过桥三峡雪，苍头吹笛满林风。\n狂花也有凌霄意，飞上松颠烂熳红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题理妆士女","author":"张雨","text":"谁见新妆出绣帏，辛夷花下六铢衣。\n莫教蜂蝶知踪迹，閒与邻娃斗草归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玄览堂绝句","author":"张雨","text":"帘栊低亚小梅枝，快雪时晴绿满池。\n铃索不摇鹦鹉睡，客来假寐亦多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张溪云画钩勒竹","author":"张雨","text":"为爱风篁手自摹，不烦把烛倩官奴。\n须当白战筼筜谷，羞杀江南没骨图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金人出猎图","author":"张雨","text":"小队鸣笳晓出围，地椒狼藉兽应肥。\n上皇久厌猩羊粉，故遣萧郎击豕归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵岩寺","author":"张雨","text":"我欲搜林觅砚材，谁将奇石半岩栽。\n胸中故有涵空阁，好借君王避暑来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵怀友","author":"张雨","text":"秋衣零落补纫多，剪尽西兴半亩荷。\n寒到故人殊未到，不消湖上雁来过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春菜","author":"张雨","text":"土甲离离宿雨痕，畦蔬小摘当盘飧。\n红绫饼餤残牙齿，合向岩头嚼菜根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春药","author":"张雨","text":"紫甲红牙玉满阑，时分花雨润斑斑。\n茯苓乍可来归笼，远志从来不出山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登善精舍葺治苟完七小诗以写予怀 其一","author":"张雨","text":"故山破屋谁来补，辛苦经营拾燕泥。\n几树桃花相送老，不消更著子规啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登善精舍葺治苟完七小诗以写予怀 其二","author":"张雨","text":"涧中采石重铺径，坡上移花小筑墩。\n深结云岚为保障，剩培松竹当儿孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登善精舍葺治苟完七小诗以写予怀 其三","author":"张雨","text":"梓柳都移五十栽，稚松千个绿毰毸。\n旁人莫笑千年计，万一他时化鹤来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登善精舍葺治苟完七小诗以写予怀 其四","author":"张雨","text":"玉钩桥水如凝碧，才过床头写瀑雷。\n恰是东风太薄劣，逆流花片出墙来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云林画","author":"张雨","text":"望见龙山第一峰，一峰一面水如弓。\n水边亭子无人到，犹有前时蹑屐踪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李商隐学仙","author":"张雨","text":"谁云有分不关情，沦谪千年为底名。\n消得权儿羊浣布，诗中唯数玉溪生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京师答薛玄卿","author":"张雨","text":"重重城阙乱烟花，只拟将身乞酒家。\n试听御沟冰下水，与君持底驻年华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三衢道中三首 其一","author":"张雨","text":"大溪中道放船流，船压山光泻碧油。\n三百里滩攲枕过，买鱼酾酒下严州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三衢道中三首 其二","author":"张雨","text":"东风恶剧雨飞花，被底春寒水涨沙。\n兰茝溪香小回首，一峰晴雪是金华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三衢道中三首 其三","author":"张雨","text":"界道飞流山翠重，杜鹃无语杜鹃红。\n归人一舸贪新水，浑堕丹青便面中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灯花联句","author":"张雨","text":"星阁迎寒閟，霜钟动夜摐。\n酒深燔朮火，漏下续兰釭。\n寸草荧芝小，丹葩瑞带双。\n金枝交婉娈，银粟乱鬃鬞。\n蜡结飞蛾笑，膏融吐凤愯。\n汞珠光透镜，火齐幻垂幢。\n的的煇青琐，淫淫飐玉缸。\n烛龙擎紫盖，翘燕缀红䝄。\n邻眼书窥隙，仙眉墨晕窗。\n狂吟心蕊发，喜听足音跫。\n折堲风吹座，钩帘月堕江。\n青藜如见遇，挥手出纷厖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集太白语酬僧净月","author":"张雨","text":"主人碧岩里，为余话幽栖。\n真诀自从茅氏得，风流还与远公齐。\n满堂空翠如可扫，而君解来一何好。\n白玉麈尾谈重玄，琉璃砚水常枯槁。\n苍苍云松，拂彼白石。\n世人闻此皆掉头，就中与君心莫逆。\n袖拂紫烟去，空中闻天鸡。\n借问苏耽鹤，早晚向江西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集王摩诘书语六言二首 其一","author":"张雨","text":"寒犬吠声如豹，夜春相应疏钟。\n华子冈头清月，照人独坐山中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集王摩诘书语六言二首 其二","author":"张雨","text":"夜深僮仆静默，月明辋水沦涟。\n独与山僧饭讫，寒林远火初然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重登牛头峰","author":"圆至","text":"霜叶黄蝶飞，崖泉白蛇挂。\n行行寻故迹，往物已屡化。\n高步万石上，独立一木下。\n悠然顾吾影，残日在林罅。\n古来遗世士，泯观混真假。\n所视既已齐，乘险意亦暇。\n智愚相与夺，得失纷代谢。\n吾欲营力耕，穿岩树茅舍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪","author":"圆至","text":"窗鸣风片乱，溜冻冰条直。\n夜久忽无声，傍檐时淅沥。\n青薪焰方吐，红灯花欲滴。\n闭阁有馀温，蒙衾兀重席。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送勤灭宗","author":"圆至","text":"出家旅殊乡，同里为骨肉。\n况乃情所厚，而兹忽分躅。\n清霜彫广野，露立冻群木。\n日暮行子身，溪谷映餐宿。\n吾闻含德者，凝视养玄瞩。\n疾进气虽锐，久践途乃熟。\n岁晏能复来，青灯共寒屋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠玉龙曾道士画龙头","author":"圆至","text":"乖龙逃雨走，急落西山陬。\n缩入画仙笔，雷公不能搜。\n画仙有墨池，尺水涵十洲。\n俗龙作玄骨，骑入尘寰游。\n我求写龙真，画仙许我否？\n形全恐飞去，为君且画头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵陪星子胡主簿游报先寺","author":"圆至","text":"木栖与渊蟠，所性各有适。\n顾余丘壑恋，大药不医癖。\n青山亦可人，乍见如素识。\n森然一窗下，献此万丈碧。\n簿领三秦英，轩昂谢尘迹。\n壮龄已叠组，旧阀况列戟。\n洁身粉黛侧，僧榻群面壁。\n国鼎笔可扛，天机锦自织。\n停骖偶相值，顾问借颜色。\n东风吹芳原，众卉竞春日。\n远郊农饷起，烟屋香芋栗。\n牛鸣雨陇寒，释耒泥溅膝。\n良时一游豫，能不念民疾。\n二宫山水窟，屦钵恬食息。\n含羞目崭绝，讵意陪履屐。\n终期凌苍巅，一视空八极。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送建昌黄绮秀才踰淮教授","author":"圆至","text":"还山羞听紫芝歌，旅馆千门讲四科。\n绛帐未悬知己少，黑裘渐敝阅人多。\n秋风白下沾巾别，落日青淮照影过。\n莫对饭盘嗔苜蓿，桑榆虽暖易蹉跎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"义冢科","author":"圆至","text":"城阙千棺瘗此斜，古堆新穴满平畬。\n春丛乱哭鳏寡鸟，雨树杂开啼笑花。\n散骨已枯苔作肉，痴魂犹认土为家。\n何人薄暮焚钱去，风卷残灰满柏丫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答许府判见嘲诗癖之什","author":"圆至","text":"君不见蓬莱仙人五云深，兴来忽起尘寰心。\n手拈造化作一剧，世上瓦砾皆黄金。\n又不见珠宫灵娥睡新起，赛吃云浆赌骰子。\n蓦然发笑成电光，不料阴阳嘘颊齿。\n道人文章亦如斯，落笔心手不相知。\n岂如曲士拾蠹纸，尧桀满腹堆群疑。\n愿君闭口毗耶室，竺贝孔韦皆长物。\n著鞭捷出灵运前，莫斗生天斗成佛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]