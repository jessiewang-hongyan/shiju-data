[{"title":"墨梅","author":"吴当","text":"粲粲冰肌雪未暾，萧萧疏影写黄昏。\n情深西子湖边树，梦入罗浮月下村。\n万斛春光归笔力，一枝云气沁香魂。\n清江寂寞杨丞远，无限风流此日存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄隐士相过次韵","author":"吴当","text":"吾家华盖郁嵯峨，数亩蓬茅长薜萝。\n愧我菲才宜隐退，知君有道幸相过。\n风清杖屦迎岚出，春尽犁锄带雨歌。\n架上有书尊有酒，相逢不乐又如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞先生寿京师贾姑诗韵","author":"吴当","text":"慈颜九帙鬓如鸦，世族前朝宰相家。\n天近县官时赐帛，春深孙子日扶车。\n麻姑酒是长生药，阿母桃应几度花。\n学士诗成无限思，五千里外望京华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈道士奉香归四明","author":"吴当","text":"暖烟芳草路迢迢，又送天香下九霄。\n洞口桃花春欲笑，山头桂树晚难招。\n麻姑酒榼藏丹室，徐福楼船驾海潮。\n何日乘桴远相问，讵应无地老渔樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听雨堂","author":"吴当","text":"兄弟多情有别离，昔年惆怅大苏诗。\n青山听雨相思处，白日看云独坐时。\n慈竹绕檐春瑟瑟，梧桐当户夜迟迟。\n投簪未觉归来晚，尽散囊金对酒卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"强仲贤赴广东师帅幕","author":"吴当","text":"元戎分阃握兵符，筹昼须君答庙谟。\n千里车来天北极，五羊城在海东隅。\n香云荔子丹砂颗，清露芙蓉锦绣图。\n早立勋名重邦国，莫令妖气傍江湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日燕南禁酒简赵子威佥宪","author":"吴当","text":"又与黄花负夙期，天南霜露满人衣。\n酒尊有禁逢佳节，纱帽无情对落晖。\n俯听秋声从树起，仰看云影送鸿飞。\n登临不用增惆怅，咫尺承恩上紫微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕南龙兴寺阁晚眺","author":"吴当","text":"倚天楼阁贮金仙，层栋犹题赵宋年。\n混一南方今宇宙，英雄百战旧山川。\n鱼龙水落秋江外，刍牧人归夕照边。\n总为悲歌生慷慨，凭阑极目思凄然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关西道士求赋雪巢","author":"吴当","text":"一间素壁倚秋风，却拟巢林雪半空。\n鍊得身形清似鹤，望来剑气白于虹。\n洞箫窅窕留云住，牖户绸缪许月通。\n更识船如天上坐，孤飞只合剡溪中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上巳日次韵","author":"吴当","text":"忆昨追随苑外车，风光九市见纷奢。\n并儿玉带双龙佩，燕女金袍五凤花。\n天乐声高仙仗肃，宸旌影动禁林赊。\n当时讲席尊诸老，人到于今喜诵夸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"欧阳建寅赴松江巡检","author":"吴当","text":"京华久客宦情微，身到江南即是归。\n虎士刺船迎逻鼓，鲛人停杼望云扉。\n蒹葭夜月风连海，粳稌春云水绕围。\n自笑白头犹恋阙，何时五马借光辉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20253,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵伯友韵 其一","author":"吴当","text":"白发衰翁怜病久，青春游子叹归迟。\n感君曾奏匡衡疏，怀国长吟杜甫诗。\n苍海鱼龙仍衮衮，孤城花柳自熙熙。\n千年遗恨同谁语，百世高情与尔期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20254,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵伯友韵 其二","author":"吴当","text":"百年道脉细于丝，长夜漫漫待旦迟。\n先进常从周礼乐，专门仍授汉书诗。\n微躬独步思绳武，大介重光仰缉熙。\n已忍凄凉成病久，寸诚惟与古人期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20255,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游西湖承天寺赠月潭上人","author":"吴当","text":"中天台阁禁城西，春日游人出御堤。\n满地落花驯鹿卧，千条弱柳乱莺啼。\n窗涵水影金镛净，幡倚晴云绛节齐。\n最喜上人能爱客，乘船仍约酒频携。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20256,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋枢密权公葬婺源之麓八世孙居都昌者作楼以望其丘陇于千里之外名曰寓思虞学士尝为赋诗今楼已废矣九世孙缉来求余诗赋此","author":"吴当","text":"异乡丘陇近蓬莱，层构当年望眼开。\n千里江山遗刻在，百年霜露远孙来。\n已无化鹤归华表，空有饥乌下碧苔。\n寂寞孝思何所寓，断云衰草两堪哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20257,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日紫极宫次戴懋和韵 其一","author":"吴当","text":"老去杯悭易劝酬，年年挥泪望神州。\n凤凰城阙金汤在，龙虎亭台翠辇游。\n牛斗寒光通紫极，蓬莱弱水隔玄洲。\n乌纱不受西风急，高阁凭江倚素秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20258,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日紫极宫次戴懋和韵 其二","author":"吴当","text":"忆昨追游禁苑寒，陇头红叶醉中看。\n青蒲曾伏麒麟殿，白发能胜獬豸冠。\n天上玉堂惟有梦，田间瓦缶竟无欢。\n殊方久病悲摇落，笑啜茱萸强自宽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄康宗武","author":"吴当","text":"一自承恩乞鉴湖，几回清梦谒神都。\n蒲萄天马穷边徼，粳稻云帆转越吴。\n旸谷吠晨惊蜀犬，神祠鸣夜诧城狐。\n隆中高卧空筹策，万里云霄羽翮孤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕处会灵宫次姜步德韵","author":"吴当","text":"江上烟岚接地阴，仙家庭宇自云林。\n玉堂金马成尘梦，草服黄冠称野心。\n沧海鱼龙秋水落，瑶台风露夜寒深。\n肯从世外寻丹诀，何事人间叹陆沉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浔阳舟中三首 其三","author":"吴当","text":"伏枕移床向小舟，江头渔父问何由？\n风波接棹鱼龙冷，烟草迷津雁鹜秋。\n往事几年怀内顾，狂澜百折任东流。\n草玄不守扬雄宅，垂白空添宋玉愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九江冬至日","author":"吴当","text":"愁坐孤城对日长，葭灰动处识微阳。\n八方云物瞻新候，几树梅花忆故乡。\n黄道春回天北陆，紫烟时想殿中央。\n频年凤历催颁朔，曾插金貂侍玉皇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵示从学","author":"吴当","text":"东度关山马迹长，南浮江海雁随阳。\n丹书玉篆发天语，金节绣衣辞帝乡。\n放臣泣血竟何益，羁客哀吟殊未央。\n故园云谷杂豺虎，寒木何枝依凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20264,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高昌喜山近仁在江州为太常院使礼部尚书新其堂构各有名扁为赋三题馀未暇也 其一","author":"吴当","text":"江上小堂仍种竹，浑如一棹住江间。\n芙蓉秋水三千顷，翠黛春云十二鬟。\n凤管制来新谱在，渔竿留得钓丝閒。\n牧羊庭远寒无树，裘马轻肥客未还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20265,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高昌喜山近仁在江州为太常院使礼部尚书新其堂构各有名扁为赋三题馀未暇也 其二","author":"吴当","text":"冥鶤化翮向南飞，栖息安危各有时。\n秋入梧桐晴影薄，寒通牖户晓光迟。\n青山是处瞻龙气，紫阁何年睹凤仪。\n自叹蓬莱常五色，上林曾宿最高枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20266,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高昌喜山近仁在江州为太常院使礼部尚书新其堂构各有名扁为赋三题馀未暇也 其三","author":"吴当","text":"飞花如席拂庐低，不辨行踪径已迷。\n竟夕有书分户映，几年无榻见岩栖。\n秦关拥道难容马，汉节禁寒尚牧羝。\n曾忆钓蓑归旧隐，洞天高与白云齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20267,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浔阳舟中三首 其一","author":"吴当","text":"百年头上著乌纱，一日江边踏钓槎。\n病似相如空有赋，贫于杜甫更无家。\n渔歌楚楚蒹葭月，樵笛村村踯躅花。\n事业已随兵燹尽，青门惟守邵平瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20268,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九江杂咏书怀 其二","author":"吴当","text":"天地无情泪眼枯，故园松菊久荒芜。\n秋风茅屋从谁葺，春日村醪只自沽。\n万里关河迷宇宙，孤舟烟雨满江湖。\n渥洼老骨空相顾，云汉高飞不易呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20269,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬至后九日","author":"吴当","text":"绣窗添线琯浮灰，玉烛迎阳晷影回。\n雁度关河随朔气，龙依江海蛰神雷。\n渐开柳眼窥春色，未放梅腮送酒杯。\n药裹书签随处有，乡心岁事漫相催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20270,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄友 其一","author":"吴当","text":"旸谷东飞陆海灰，灵杓北顾帝车回。\n波涛寒涌江间月，草木春移地底雷。\n九奏钧天犹梦乐，十洲弱水不胜杯。\n山楼笳鼓时时急，晏岁冰霜日日催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄友 其二","author":"吴当","text":"几年野烧着寒灰，此日楼船向海回。\n万叠云烟秋似黛，一江风浪夜如雷。\n歌残玉树浮空棹，梦入金茎渴露杯。\n想待上林花未发，春光应得鼓声催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日","author":"吴当","text":"年年此日客殊方，谁拟今年住九江。\n花鸟春愁诗漫兴，乾坤元气酒难降。\n乡心华盖云千里，病目匡庐雪一窗。\n到处青山薇可食，老来何必泪双双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夕有感 其一","author":"吴当","text":"渔竿长在楚天涯，龙节虚随汉使槎。\n世路风尘迷杞棘，故园烟雨忆桑麻。\n两行泪对椒盘酒，一树春生蜡炬花。\n人事乡书俱寂寞，不堪江上鼓频挝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夕有感 其二","author":"吴当","text":"华盖芙蓉翠倚天，高堂綵服忆长年。\n家人共守迎春酒，童稚争分压岁钱。\n香雾煖浮金鸭动，蜡虹晴隔绛纱然。\n鹤书一去无消息，白发沧江对雪眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辛丑元日夜坐试笔","author":"吴当","text":"扶桑晓色压春云，江上香炉留夕曛。\n坐来白日有佳兴，雪后青山无垢氛。\n蛰龙三冬成久卧，鸣鸟百年今不闻。\n遗经独在共谁语，太乙吹藜来夜分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠聂克敬兼简宗武","author":"吴当","text":"岁晏匡庐积雪深，高松老鹤苦能禁。\n海尘杳杳生春态，江水沄沄流夕阴。\n无事庾楼留客赋，向来梁甫为谁吟。\n渔樵旧侣如相问，鸥鹭寒盟尚可寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜月","author":"吴当","text":"处处关山泪眼明，悲笳又送断肠声。\n芙蓉水冷秋无际，乌鹊枝寒夜屡惊。\n黄道帝车还北极，紫垣天驷接南瀛。\n多情不用悲摇落，万里江波月夕清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕大风","author":"吴当","text":"江头风急客衣凉，瓜果谁家月满堂。\n五色在天曾补衮，七襄报日不成章。\n机丝停杼空成绪，星汉乘槎竟杳茫。\n自叹红颜今白发，人间养拙更何乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅权纬","author":"吴当","text":"江湖波浪接鹍溟，牛斗光寒动客星。\n兰芷风暄谁结佩，芙蓉水冷自扬舲。\n周官礼乐先王度，汉代文章后世型。\n衰病独怜头尽白，故人相见眼终青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋樊氏茅屋","author":"吴当","text":"闻君茅屋住樊川，水影山光接几筵。\n花径约来寻酒伴，柴门系着钓鱼船。\n晴檐兴在从谁赋，秋树高风只自编。\n亦有数椽华盖下，杖藜何日白云边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠刘懋观写真","author":"吴当","text":"萧萧霜鬓隔风尘，却有刘郎为写真。\n金马玉堂成昔梦，苍松白鹤伴閒身。\n伤心南土衣冠少，极目中天日月新。\n更许苏卿老归国，便应黄阁画麒麟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之西涧山长","author":"吴当","text":"巍巍宫庙涧之西，松桧萧森夹殿齐。\n白屋衣冠存伏腊，青云步武见阶梯。\n江湖夜月寒惊棹，桃李春阴雨满蹊。\n昭代急贤无枉路，未应重席叹羁栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老士安治书为使江东时尝构参云亭在京师属赋之","author":"吴当","text":"参云亭在宛溪头，持斧仙翁昔所游。\n日月星辰天北极，山川草木地南洲。\n门前车骑秋来好，竹上题诗醉后留。\n回首江村烟树阔，至今犹忆旧风流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉堂公宴次周学士韵","author":"吴当","text":"扈跸新随帝辇回，宾筵秩秩玉堂开。\n禁庐下直辞天仗，内使传宣送御醅。\n舞女分行花影动，歌工閒奏鼓声催。\n衰年感遇惭无补，赖有诸公济世才。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冯氏藏书堂","author":"吴当","text":"乔木依堂数亩阴，买书不惜散黄金。\n简编总许儒生读，碑帖还从墨客临。\n芸阁牙签晴睒睒，练囊萤火夜沉沉。\n只今许下多贤士，始信君侯惠泽深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邓汝贞买妾得子南归云林","author":"吴当","text":"云林三十六峰齐，独振京尘向旧栖。\n天上桃花新结子，水边杨柳已生稊。\n浊醪对客秋三径，啼鸟催人雨一犁。\n亦欲投簪江上去，为君移棹过金溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠日本诗僧","author":"吴当","text":"偶来金阙信相从，笑指扶桑浴日红。\n处处写诗扬海屿，时时飞锡振天风。\n归云每共经函在，行橐常因酒盏空。\n吾道获麟惟掩涕，乘桴相问有谁同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅康宗武胡伯文","author":"吴当","text":"百年勋业鬓星星，又听流莺绿满庭。\n茶与仙人分石鼎，酒从豪客索银瓶。\n一犁春雨苏公圃，半曲湖光孺子亭。\n更肯烟霞空寂寞，未应尘土叹飘零。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留岩峰寺 其一","author":"吴当","text":"扁舟飘泊苦西东，此日栖迟野寺中。\n岚气常疑庐岳雨，秋声还似大江风。\n辋川花木图犹在，杜曲茅茨赋未工。\n人事萧条乡土近，几时回首白云通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留岩峰寺 其二","author":"吴当","text":"岩谷风多秋叶飘，一径荒草凉萧萧。\n已无幽芳媚野色，惟有老树存高标。\n青山冉冉列鬟黛，白日往往逢渔樵。\n仰天长叹竟何补，荷蓧长歌谁可招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄乡友 其一","author":"吴当","text":"伤心一视天无外，病目长怀日再中。\n猎骑合袪云梦泽，楼船直驾海潮风。\n二仪高下悲人力，万类枯荣识化工。\n衰晚祗惭何报补，艰危终不拟穷通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄乡友 其二","author":"吴当","text":"风尘冉冉似蓬飘，犹有衡门拥艾萧。\n锦里几家红叶树，华峰千仞碧云标。\n晓因童子坡头牧，夕约邻翁谷底樵。\n秋月春花随地有，归来莫待楚辞招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南溪精舍","author":"吴当","text":"前代遗墟浏水上，南溪栋宇见新题。\n开山种药云千本，傍舍移秧雨一犁。\n白鹤时从檐下宿，黄莺只在竹间啼。\n尚方近觉声华起，却向金门听晓鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽余忠宣公","author":"吴当","text":"沔阳舟楫势如飞，安庆孤城屹不支。\n诸葛智谋天地閟，杲卿忠义鬼神知。\n纵然身活到今日，未必人生无死期。\n一片精忠元不改，男儿到此是男儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题古木","author":"吴当","text":"铁石皆生色，冰霜有岁华。\n春雷龙启蛰，星汉客乘槎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其一 玉溪桥","author":"吴当","text":"玉溪浮采鹢，金锁贯晴虹。\n自是知津者，能成利涉功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其二 积果堂","author":"吴当","text":"几树枣如瓜，千年桃始华。\n渠通沧海水，门倚赤城霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其三 十二区","author":"吴当","text":"拣地循环种，名花取次开。\n藏春何待坞，按律且衔杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其四 梅竹庄","author":"吴当","text":"天香生玉树，云影动琅玕。\n对酒惊春事，开门识岁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其五 缉云亭","author":"吴当","text":"琴罢月生渚，鹤归松满坡。\n葺亭无尸牖，应是白云多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其六 招隐亭","author":"吴当","text":"书从北阙上，文自北山移。\n樵牧俱生怨，耕锄已过时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其七 渊泉亭","author":"吴当","text":"秀出千黛螺，飞来半空雪。\n天光净渟渟，秋声来淅淅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天台玉汉桥道院八咏 其八 外墅","author":"吴当","text":"山光分远近，云气异朝晡。\n过客俱能赋，开轩即是图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋山山景图","author":"吴当","text":"茅屋倚秋树，山楼延夕曛。\n流来桥下水，半是洞中云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漉酒图","author":"吴当","text":"头上巾堪脱，尊中酒不空。\n衡门松菊在，归卧北窗风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画龙","author":"吴当","text":"天用莫如龙，渊潜閟神功。\n一朝起平陆，八表皆雷风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅月窗","author":"吴当","text":"曾到西湖上，闻香不见梅。\n推窗窥月色，竹外一枝开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]