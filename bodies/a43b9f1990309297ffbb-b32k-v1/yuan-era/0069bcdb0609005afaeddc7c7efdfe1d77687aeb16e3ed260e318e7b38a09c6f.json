[{"title":"秋晓","author":"吕诚","text":"鸡号天未明，柝静四邻寂。\n疏星如联珠，残月悬毁璧。\n风清鹤在林，露重水成滴。\n危坐绝百非，嗒然丧形质。\n大明启东方，云霞半空赤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大庾岭留题二首 其一","author":"吕诚","text":"晨兴散策云封寺，岩岫天开紫翠图。\n一水南来分百粤，大江东下入三吴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大庾岭留题二首 其二","author":"吕诚","text":"霜旭开晴晓出关，冲寒驴子猬攒攒。\n西风百里南雄道，绿树丹枫满意看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南行舟中三首 其一","author":"吕诚","text":"春开冬开岩下花，朝虚暮虚溪里家。\n白帽渔郎衫色瘦，青裙樵女髻鬟丫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南行舟中三首 其二","author":"吕诚","text":"荔枝花发暗蛮村，孔雀惊寒减翠纹。\n也有北人开眼处，碧山无数插红云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南行舟中三首 其三","author":"吕诚","text":"小舫行无车马喧，短桡轻桨破江烟。\n无由远逐轩皇驾，素瑟重听五十弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浈阳峡山飞来寺","author":"吕诚","text":"峡山山上飞来寺，绀阁层层树里开。\n僧璧不随猿女化，梵钟曾逐蜃楼回。\n万松夹道时闻雨，众壑奔流夜殷雷。\n犹有昔贤珠玉在，断碑剥落委莓苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"番禺谩兴 其一","author":"吕诚","text":"炎方吊古易兴衰，知是昆明几劫灰。\n黄木湾围南海庙，白云山拥粤王台。\n百年此地衣冠尽，五月南风舶艑来。\n游览尚馀高兴在，匆匆莫遣二毛催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"番禺谩兴 其二","author":"吕诚","text":"莫言南海是天涯，远客何妨岁月赊。\n岂谓居夷忘故土，直须浮海上灵槎。\n药洲日卧仙羊去，蕃塔风高铁凤斜。\n白首飘零谁慰藉，几回松菊梦还家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其一","author":"吕诚","text":"象郡大藩当百粤，羊城方面镇南州。\n环山雉堞云霞晓，落日旌旗海峤秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其二","author":"吕诚","text":"荒服未尝沾政化，岛衣今始识衣冠。\n船来争市龙鱼鲊，客至先需荔子盘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其三","author":"吕诚","text":"谁家女儿高髻妆，行春踏花屐齿香。\n留客不将茶当酒，铜盘蒌叶进槟榔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其四","author":"吕诚","text":"看春客里逢元夕，大市小市烧灯红。\n女郎手鼓如杯大，半夜答歌明月中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其五","author":"吕诚","text":"炎方物色异东吴，桂蠹椰浆代酪奴。\n十月煖寒开小阁，张灯团坐打边炉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南海口号六首 其六","author":"吕诚","text":"儋万夷人不著衣，缬花藜布满身围。\n轻舟似叶争飘海，载得槟榔换米归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越楼观灯","author":"吕诚","text":"午夜冰轮烂不收，又看春色满南州。\n沈香火底鳌山柱，翠幕星前羯鼓楼。\n小队《天魔》花作阵，初筵云醴玉为舟。\n要知此景非人世，何必罗公作幻游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"粤王台怀古","author":"吕诚","text":"神剑当时断白蛇，华夷悉入卯金家。\n徒怜南海居蛙坎，未识中原制犬牙。\n献璧称藩真得计，橐金满载已堪嗟。\n荆榛满目荒台下，独倚东风听暮笳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游白云诸山三首 其一","author":"吕诚","text":"半空苍翠薄层崖，万木森森碍日车。\n八十老禅延客坐，九龙井上试新茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游白云诸山三首 其二","author":"吕诚","text":"后岩岩上看飞泉，蒲涧曾闻降五仙。\n黄竹断碑前代烬，禹粮尧韭昔人传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游白云诸山三首 其三","author":"吕诚","text":"瑶草春深白鹿眠，丹霞楼阁翠生烟。\n偶来石上寻棋局，犹恐归时不记年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诃林光孝寺方丈","author":"吕诚","text":"斜日荒凉噪乳鸦，菩提新叶小于茶。\n石廊久雨无人到，落尽閒庭诃子华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"小孤山夜泊","author":"吕诚","text":"彭浪矶头江水深，小孤祠前风满林。\n秋山青青秋月白，霜里吹箫龙夜吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪武辛亥南归重度梅关二首 其一","author":"吕诚","text":"去年窜逐下南溟，万里归来鬓已星。\n望入西州天一发，香炉长绕九江青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪武辛亥南归重度梅关二首 其二","author":"吕诚","text":"归路篮舆鹤背轻，保昌东下过长亭。\n今朝又向梅关度，此是江南第一程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中望庐山","author":"吕诚","text":"庐山昔在图中见，落星渚前今始逢。\n云岭半藏红叶寺，霜风遥递翠微钟。\n龙君或居彭蠡泽，仙人爱住香炉峰。\n双凫之舄傥可借，飞入前头听玉淙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太湖晚泊","author":"吕诚","text":"震泽三万六千顷，日月出没波涛中。\n冰壶寒浸林屋洞，青壁下嵌冯夷宫。\n霜林人家橘子熟，晚饭柁楼菰米红。\n羽仙黄鹤时相过，知是银河一窍通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月下独酌闻桂香","author":"吕诚","text":"今宵风月尽清酣，碧海寒光万丈涵。\n天上散花香第一，尊前舞袖影成三。\n方诸玉露清于醥，崖蜜金橙小胜柑。\n老兴此时原不浅，高歌犹忆《望江南》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之潮兼简乡友","author":"吕诚","text":"瘴雨蛮风晚更寒，揭扬山色满征鞍。\n临行谩写相思句，好与东吴故旧看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月十五夜对月分得楼字","author":"吕诚","text":"东池月满重开席，不减当年庾亮楼。\n每谓人生须纵饮，固知物色总难留。\n萤光过幔还星散，云气行天似水流。\n高兴无穷秋满眼，山阴何处有行舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题墨梅图","author":"吕诚","text":"凌霄峰顶雪初乾，煖逼繁枝玉作团。\n三尺溪藤散香影，绛纱笼烛夜深看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江晚霁图","author":"吕诚","text":"长天敛尽落霞红，草屋炊烟野渡东。\n一带寒沙秋水白，荻花吹老鲤鱼风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南归遣怀","author":"吕诚","text":"海南每忆越王楼，可奈乡关万里愁。\n对客花前椰子酒，看山马上木绵裘。\n羁縻此日生还喜，准拟归耕老去休。\n愧我无家怜晚岁，卜邻终在瀼西头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安庆","author":"吕诚","text":"市楼突兀凌波起，楼上女儿未梳洗。\n短篷初泊酒家门，新酿玉壶香十里。\n买鱼沽酒挂蒲帆，九月淮村风日美。\n回头遥望大龙山，翠屏灭没寒烟紫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归来","author":"吕诚","text":"徒步归来海上城，荆榛满路不堪行。\n问人倏忽更贫富，访友凄凉半死生。\n乌宝无神悲积帑，青松有泪对空茔。\n逆流一片门前水，犹对青山落日明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南归海上访友","author":"吕诚","text":"北风吹雁渡江烟，访旧东吴晚泊船。\n野水似龙争入海，大星如月独当天。\n羌村梦寐青灯下，蜀道间关白发年。\n兵革漂流无倚著，眇余何处赋归田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春感怀","author":"吕诚","text":"春雨屋上鸣，流泉竹间泻。\n清晨望原隰，新绿或可藉。\n维时春夏交，节序惊代谢。\n悠悠念陈迹，默默观蠹化。\n人生夫如可，胡不税尘驾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"露坐","author":"吕诚","text":"虚庭坐凉夕，宵永觉衣薄。\n犬吠古塔铃，乌啼野城柝。\n感旧心孔哀，怀人兴殊恶。\n仰视斗杓倾，西林月初落。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱道士游武当","author":"吕诚","text":"武当诸峰何壮哉，大朵小朵青莲开。\n玄圣高居天地户，赤日下照金银台。\n神龟六眼电光走，山鬼一足云头来。\n道人再拜望北极，应带满身星斗回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄廉夫","author":"吕诚","text":"杨子十年官不调，如此永州文力何？\n洞庭铁笛龙吹得，天上琼书鹤寄多。\n车子看花将一雨，雪儿行酒艳双歌。\n时时对客教弦索，绣领单衫月色罗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和顾玉山诗韵","author":"吕诚","text":"春来世事益艰危，怪底间情强赋诗。\n杨柳愁空陶令宅，荷花吟遍白家池。\n眼前陵谷惊迁变，客里江山喜护持。\n两度寄书烦慰藉，相从深愧负幽期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题美人图","author":"吕诚","text":"绣床风煖郁金裙，晓起蛾眉八字分。\n翠管成龙吹怨曲，云梭衔凤织回纹。\n荼蘼酒熟春江雪，豆蔻花开晓树云。\n照槛扶桑红日透，自援綵笔赋东君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题极目亭","author":"吕诚","text":"海虞亭子层阑上，高与清秋爽气俱。\n历历吴山明落照，茫茫淮甸入平芜。\n兴亡千古看棋局，晴雨四时开画图。\n日日凭阑瞻北固，仙人借得一双凫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"既白水轩","author":"吕诚","text":"水轩如笠大，聊作一枝栖。\n晚饭长腰米，朝盘短股齑。\n江湖双短鬓，日月两醯鸡。\n徙倚郊原望，王孙草又迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"首夏田家雨中","author":"吕诚","text":"细雨朝来湿白沙，风前整整复斜斜。\n林蕉间展琉璃叶，野蔓竞发金银花。\n田父扶犁驱一犊，稚女踏车垂两丫。\n年年梅熟愁蒸暑，却爱小池鸣乱蛙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"田居书怀","author":"吕诚","text":"僻居娄西村，岁月嗟屡过。\n桑麻八口家，仅示免饥饿。\n公田倩牛耕，痴儿固慵惰。\n虽乏甘脆供，所赖出舂磨。\n前荣荫高榆，后坡竹千个。\n薰风飒然来，自足偿高卧。\n念无谢傅才，甘受娄公唾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观刈晚归","author":"吕诚","text":"堪笑南塘野老家，客来无酒只烹茶。\n池荒莲蛹青房子，霜老鸡人绛帻花。\n海气东连瑶浦暗，江流西绕玉山斜。\n扶藜缓步归来晚，閒看污邪载满车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月下怀友","author":"吕诚","text":"秋庭夜泬寥，云影绝纤毫。\n月转青霄迥，星临紫极高。\n蚁醅金错落，凤吹《郁轮袍》。\n不举山阴棹，空孤一世豪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食郊行","author":"吕诚","text":"草软沙平步履轻，百钱日日系乌藤。\n市桥风旆梨花酒，游女春衫柿蒂绫。\n乌帽飘萧明素发，石麟攲侧卧荒陵。\n百年俯仰须臾事，游览匆匆愧未能。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三江祠戏赠二首 其一","author":"吕诚","text":"三江口头日欲晡，三江女儿自当垆。\n今朝南浦送郎去，望断东风樯上乌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三江祠戏赠二首 其二","author":"吕诚","text":"樯头五两逐风轻，听得吴歌惨别情。\n一片刘家河上月，照郎直到定辽城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴三首 其一","author":"吕诚","text":"寂寂高门大道边，东风愁锁绿杨烟。\n大儿已入滇池戍，嫠妇空耕陇上田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴三首 其二","author":"吕诚","text":"赭服从戎万里行，风餐水宿事宵征。\n金沙江绕乌蛮砦，越巂山连孟获城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴三首 其三","author":"吕诚","text":"雨馀江色碧浮空，一发青山落照中。\n去棹休歌《桃叶渡》，行人愁杀柳花风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六夜对月","author":"吕诚","text":"月夕浮云变苍狗，无术因之彻其蔀。\n海风今夜东南来，尽捲飞埃绝纤垢。\n碧天万里开冰壶，清光落我持杯手。\n宿羽联翩翻露巢，寒兔迷离捣霜臼。\n嘉宾况尔平生欢，如此良宵宁可负。\n邻家曲生好风味，三百青钱呼一斗。\n桂香正熟菊未莏，莼羹烂煮橙可剖。\n清樽倒射白兽光，绿波荡摇金虬走。\n老侬断荤不止酒，喜客和月吞入口。\n兴酣且致舋舋谈，歌成自答呜呜缶。\n百年此乐能几何？\n瓢空更起谋诸妇。\n身间无事古所贵，有客无酒时则不。\n但愿月光长入杯，岁岁年年为君寿。\n明朝更上文笔峰，探支西风作重九。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双清诗二首 其一","author":"吕诚","text":"怪得荒寒野水滨，疏花冷蕊看横陈。\n歌翻《玉树》多嫌俗，梦唤梨云却久真。\n半点不烦春刻画，一分犹仗雪精神。\n腊团新萼虽同出，未免韩公议小醇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双清诗二首 其二","author":"吕诚","text":"湘魂懒上木兰舟，沦落江南草莽丘。\n澹色幽香羞自献，江空岁晚若为俦。\n素罗微步盈盈月，翠袖寒分寸寸秋。\n隔竹似闻灵瑟语，吴云楚雨不胜愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"觅菊花二绝句 其一","author":"吕诚","text":"已过秋风九日秋，篬筤池上若为游。\n似闻嘉菊黄于鹄，乞我双栽照白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"觅菊花二绝句 其二","author":"吕诚","text":"洲上黄花满意开，倩人更为觅奇栽。\n小桃源里秋如水，分取清香一半来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其一","author":"吕诚","text":"上思下思十万山，左海右江如月弯。\n江边神女长留佩，天上仙人早赐环。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其二","author":"吕诚","text":"铜柱山前铜鼓声，野花蛮果不知名。\n却喜土人能爱客，蒌蒂槟榔相送行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其三","author":"吕诚","text":"云开沙净水洄洄，越鸟啼边朱槿开。\n峒里蛮丁不畏瘴，朝朝冲雾趁虚来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其四","author":"吕诚","text":"客棹愁行湘水波，凭郎莫唱《竹枝》歌。\n好山好水春更好，不见閒人载酒过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其五","author":"吕诚","text":"春云好墨瘴烟中，鹦鹉群飞荔子红。\n男儿守家妇当戍，粤俗古来成土风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌六首寄胡定安 其六","author":"吕诚","text":"春草湖头春日晖，苧萝山上白云飞。\n行人莫听鹧鸪怨，陌上花开缓缓归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"采莲曲","author":"吕诚","text":"采莲落日下双舟，白縠风轻易觉秋。\n浅浅溪流齐鹤膝，青青荷叶过人头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题翠涛轩为则铭作","author":"吕诚","text":"七尺乌藤手自操，鲤鱼风起月轮高。\n带将一个城南树，五贾冈头看翠涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢惠菜","author":"吕诚","text":"江乡正月尾，菜薹味胜肉。\n茎同牛乳腴，叶映翠钗绿。\n每辱邻家赠，颇慰老夫腹。\n囊中留百钱，一日买一束。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过麋洲书舍寄葛青城","author":"吕诚","text":"重来问讯东桥竹，竹里锄云结草堂。\n隔草淮山当雁汊，半陂春水护麋场。\n交游契阔频搔首，今古兴亡一断肠。\n田野不妨聊卒岁，宦途何处是康庄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月廿日过桐巷陆氏故居感而有赋","author":"吕诚","text":"昔年曾醉陆家池，白首重来有所思。\n野哭邻鸡如昨日，陆迁谷变异当时。\n喧林众鸟偷樱子，卧石群羊没兔葵。\n莫说华亭千古事，故宫禾黍正离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吹笙仙女二图 其一","author":"吕诚","text":"森森羽节导云軿，鸾背微闻缥缈笙。\n小队《霓裳》多似雨，众中谁是董双成？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吹笙仙女二图 其二","author":"吕诚","text":"鳌背三峰水殿虚，天香吹满六铢衣。\n青禽忽报麻姑信，独是吹笙月下归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]