[{"title":"福宁州谣三首 其三","author":"无名氏","text":"山巍巍兮无麦原，白面细粉常盈盆。\n林森森兮无桑柘，锦绣绫罗色相亚。\n出门见岭不见江，案前罗列皆鲈鲂。\n儿童吼鬨南山下，剩逐牛羊与驴马。\n山妻嘻笑临堂前，满头珠翠垂翩翩。\n自言获功始三载，胜如仕宦数十年。\n但愿魁寇未殄灭，与我增财广置山间田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安乡谣","author":"无名氏","text":"罗长卿，罗长卿，朝朝打鼓捷蛮兵。\n一朝打发蛮兵去，千门万户乐太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲许敬仁","author":"无名氏","text":"祭酒许敬仁，入门鞑靼唤。\n出门传圣旨，口口称先人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绩溪歌","author":"无名氏","text":"前有苏黄门，后有叶令君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书楮衾语","author":"无名氏","text":"的的的，孰令尔纸被似钞角。\n问我何处住，五色云中住。\n问我是何姓，杓子少个柄。\n尔也错，我也错，不如归去！\n的的的。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元末湖湘中童谣","author":"无名氏","text":"不怕水中鱼，只怕岸上猪。\n猪过水，见糠止。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵烈妇歌","author":"无名氏","text":"四月三日兵挠湖，妇女多被辱与驱，殉节伊谁天水姝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萧彝翁书衣带语","author":"无名氏","text":"男子之贞，犹女之烈。\n一有玷焉，万善难雪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"羊儿年谣","author":"无名氏","text":"富汉莫起楼，贫汉莫起屋。\n但看羊儿年，便是吴家国。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄菜叶谣","author":"无名氏","text":"张王做事业，只凭黄蔡叶。\n一夜西风来，乾瘪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陆贽","author":"宋无","text":"诏下山东感泣来，谪归门巷锁苍苔。\n奉天以后谁持笔，不用当时陆九才。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋宫人王婉容","author":"宋无","text":"贞烈那堪黠虏求，玉颜甘没塞垣秋。\n孤坟若是邻青冢，地下昭君见亦羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京道中杂诗十二首 其二 刘蕡祠堂","author":"黄溍","text":"刘君古遗直，祠堂在丘园。\n嗟此豪杰窟，文雄歘孤骞。\n平生二三策，匪徼明主恩。\n琐琐谈得失，无乃市井言。\n凭高一长望，若厌车马喧。\n微风过疏雨，青山满前轩。\n阴晴倏异态，浮云实无根。\n悠悠千载心，去去勿复论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京道中杂诗十二首 其四 榆林","author":"黄溍","text":"崇崇道旁土，云是古长城。\n却寻长城窟，饮马水不腥。\n斯人亦何幸，生时属休明。\n向来边陲地，今见风尘清。\n禾黍被行路，牛羊散郊坰。\n儒臣忝载笔，帝力猗难名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京道中杂诗十二首 其八 龙门","author":"黄溍","text":"竦身望龙门，缓辔行兀兀。\n溪回愁屡渡，雨横惊暴溢。\n两崖俨相向，百水怒争出。\n人言马上郎，快意每多失。\n自非渥洼种，不得矜捷疾。\n飘飘虮虱臣，凛凛鼋鼍窟。\n皇灵重覆冒，利涉用终吉。\n回睨向所经，千嶂隐朝日。\n青林外盘纡，黄流中荡潏。\n后来渠未央，君子宜战栗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京道中杂诗十二首 其十一 李陵台","author":"黄溍","text":"日暮官道边，土室容小憩。\n汉将安在哉？\n荒台犹髣髴。\n低徊为之久，怀古增歔欷。\n长风吹旷野，飞雨千里至。\n萧条苍山根，草木馀爽气。\n常怜司马公，予夺多深意。\n奏对实至情，论录存大义。\n史臣司述作，遗则敢失坠！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄华墨竹","author":"姚燧","text":"湖州再变到黄华，两竹离披自一家。\n万斛颠风掣旗脚，军民吹屈最高牙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王澹游墨竹","author":"袁桷","text":"阴阴密叶铁钩锁，淡淡疏柯水玉簪。\n客向流离浑老尽，临风题笔望江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王澹游岁寒三友图卷","author":"欧阳玄","text":"黄华山中夜气清，月明风定闻吹笙。\n梅花开向竹松里，雪香零乱墨光生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王澹游岁寒三友图卷","author":"王蒙","text":"房山仙人清似水，醉倚长松吹玉笙。\n梅花如雪孤凤冷，明月丹霄天籁生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和渊明饮酒","author":"安熙","text":"我本山泽癯，殊非廊庙英。\n妄意羲黄上，千载有深情。\n岂无尊中酒，持杯向谁倾。\n遥怜昆丘凤，朝阳亦孤鸣。\n愿言蹑高躅，要不负此生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病卧穷庐咏静修仙翁和陶诗以自遣适辄效其体和咏贫士七篇非敢追述前言聊以遣兴云耳 其二","author":"安熙","text":"我惭未闻道，雅志慕羲轩。\n力学非董生，三年不窥园。\n团茅借幽栖，土锉寒无烟。\n诗书化乡邻，宁免朱墨研。\n紫阳继绝学，汗简多微言。\n虽愚莫自弃，感慨追前贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病卧穷庐咏静修仙翁和陶诗以自遣适辄效其体和咏贫士七篇非敢追述前言聊以遣兴云耳 其四","author":"安熙","text":"渊明守穷贱，生平慕黔娄。\n富贵如浮云，万变纷相酬。\n世运自兴丧，常恐德未周。\n羲黄不可见，日暮怅离忧。\n乾坤一东篱，百代无与俦。\n寄语狂驰子，扰扰将焉求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病卧穷庐咏静修仙翁和陶诗以自遣适辄效其体和咏贫士七篇非敢追述前言聊以遣兴云耳 其五","author":"安熙","text":"颛孙游圣门，尚思禄可干。\n所以后世士，忘生慕荣官。\n我生初未贫，传经易朝餐。\n妻不解啼饥，儿不知号寒。\n水菽非甘旨，吾亲亦怡颜。\n箪瓢存至乐，不须求抱关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病卧穷庐咏静修仙翁和陶诗以自遣适辄效其体和咏贫士七篇非敢追述前言聊以遣兴云耳 其六","author":"安熙","text":"子云辱天禄，原思乐蒿蓬。\n贫贱固易居，贵盛诚难工。\n士生或不偶，高节追两龚。\n世道有隆污，卷舒自不同。\n万古先天图，消长理谁通。\n怀人今已矣，叹息将焉从。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病卧穷庐咏静修仙翁和陶诗以自遣适辄效其体和咏贫士七篇非敢追述前言聊以遣兴云耳 其七","author":"安熙","text":"被褐守长夜，虚名愧中州。\n举杯对明月，顾影念同俦。\n消中虽有长，四海嗟横流。\n不赖固穷节，孰知身后忧。\n商歌咏停云，奈此志莫酬。\n三复渊明诗，邈哉此前修。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"是春久阙膏泽而连日大风不见天日晚登西皋归而有作","author":"安熙","text":"风霾连昼夕，登临望还迷。\n空馀衔山日，隐隐留清辉。\n周嫠不恤纬，鲁女争忧葵。\n曳杖归去来，且掩荒园扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其一 龙耳峰","author":"安熙","text":"奇峰千仞高，突兀倚天表。\n神龙几何年，俛首效苍峭。\n我行费跻攀，坐睨寒木杪。\n放怀聊极目，巳觉尘寰小。\n尚恨世累拘，未许谢纷扰。\n会有赏心人，相期拾瑶草。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其五 中溪书院","author":"安熙","text":"炎氛绝高岑，悲风振林丘。\n吟台一以眺，动我怀古愁。\n李公英妙年，于焉此藏修。\n坐令山中民，莘莘洙泗俦。\n规模未云远，芜秽馀嵓陬。\n圣像空复存，荒凉几经秋。\n不遇敬斋翁，遗迹谁能求。\n亦赖明主恩，遂兹圣泽流。\n今皇复神圣，丕承拟西周。\n弦歌独不嗣，嵓壑知应羞。\n怀贤既伊郁，抚事增绸缪。\n悠然发孤咏，远思浩难收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其六 西溪书院废址","author":"安熙","text":"世道有升降，乾坤几清磨。\n谁知昔年中，师生此弦歌。\n我来爱佳名，杖策时经过。\n深寻得遗经，山经信非讹。\n龙首东昂藏，玉石西嵯峨。\n高寒枕天井，俯瞰无金科。\n清泉下深池，悬崖据阳坡。\n浮野众麓奇，夹岸桑麻多。\n对此奇绝境，令人忆沧波。\n誓将尘土踪，兹焉老渔蓑。\n安得白鹿翁，乐育如菁莪。\n古人不可作，叹息将如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其七 蒙泉","author":"安熙","text":"作圣有奇功，谁知在蒙养。\n宣尼赞周经，妙旨存彖象。\n千年紫阳翁，人文再宣朗。\n工夫益精密，为我重指掌。\n迂愚抑何幸，久矣绝群想。\n果行复育德，服膺未云爽。\n兹焉得佳名，悠然惬幽赏。\n时至一濯缨，无言道心长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其八 李相读书龛","author":"安熙","text":"嵓壑有奇胜，缥缈馀风烟。\n石室谁所留，尚倚苍崖巅。\n慨想龛中人，于今几何年。\n遗迹虽未泯，山深月空悬。\n伊予陋庸姿，复苦尘务牵。\n此道难坐进，低头愧前贤。\n尚幸忝私淑，静修有薪传。\n终当谢浮世，于兹订遗编。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封龙十咏 其十 敬斋祠","author":"安熙","text":"桂树徒芬芳，祠宇亦荒废。\n弦歌无馀响，香火谁复继。\n前修日以远，令人发深喟。\n举觞酹飞泉，悲风起横吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高节妇诗","author":"安熙","text":"绝道丧，今几年，善俗如灰不得然。\n士知苟禄为得计，偷生忍耻不自怜。\n嗟嗟此妇乃尔贤，不本教育由天全。\n信兹秉彝不可泯，直与天地相后先。\n太行西北黄云边，平芜落日生寒烟。\n高节凛凛谁当传，后人歌我节妇篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏夜即事","author":"安熙","text":"未遂平生志，求田拟种瓜。\n天游华表鹤，井坐子阳蛙。\n世事一场梦，俗情三月花。\n兴亡天不问，阅尽几年华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次鄂屯遂初韵","author":"安熙","text":"沧海终成陆，灵椿会有秋。\n百年真梦境，八表欲神游。\n恶木除难尽，惊波逝不留。\n年来万事懒，直拟付休休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅王仲安","author":"安熙","text":"林宗自忧世，宋玉祇悲秋。\n病鹤尘中老，冥鸿天外游。\n羡君巳超逸，愧我尚迟留。\n不为西风起，莼鲈兴未休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中斋居杂诗次和仲韵 其一","author":"安熙","text":"深居苦羸疾，谁与破愁颜。\n世态浮云外，交情暮两间。\n襟怀期齐月，胸次要全山。\n梦寐神峰久，何时恣往还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中斋居杂诗次和仲韵 其三","author":"安熙","text":"静中观四子，掩卷慕朱公。\n所幸斯文在，殊非吾道穷。\n众星元拱北，万水自朝东。\n远意无人会，芳樽谁与同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中斋居杂诗次和仲韵 其四","author":"安熙","text":"故人南郡去，高隐近隆中。\n雅志希前哲，深惭接下风。\n疏狂聊自适，衰懒欲谁同。\n且莫鲸吞惯，床头酒易空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日大雪饮斋中","author":"安熙","text":"不愁饥苦互相侵，念此愆阳与伏阴。\n饮系经纶须畅饮，斟存燮理要平斟。\n舞雩自有春风乐，茅屋难忘魏阙心。\n杯酒空持讵能醉，商歌聊尔发悲吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李枢判容安亭诗韵五首 其一","author":"安熙","text":"问舍求田计未成，登临搔首愧平生。\n联名丹阙浑无望，招隐洪崖久寄声。\n短笛长歌樵牧事，浮云流水古今情。\n相君许借容安住，拟向南阳约孔明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李枢判容安亭诗韵五首 其二 李公见和复次答之","author":"安熙","text":"少年学道竟何成，章句区区已半生。\n不向静深观物理，却从摇落听秋声。\n过门载酒乡贤意，授室传经邑宰情。\n从此嘉阳风景别，太行山色看增明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李枢判容安亭诗韵五首 其三 奉寄仲章兄","author":"安熙","text":"世事悠悠岂易量，眼中存没几参商。\n诗书有得将谁语，菽水无从亦自伤。\n春色池塘想同梦，暮云楼阁渺相望。\n何时樽酒篷窗底，风雨潇潇夜对床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李枢判容安亭诗韵五首 其四 寓馆秋日即事","author":"安熙","text":"多病筋骸久痹顽，柴荆终昼掩重关。\n诗书讵可资耕钓，杖屦元非绝往还。\n莫遣浮云蔽白日，尽教秋色对南山。\n平生愿学程夫子，惭愧春风满座间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李枢判容安亭诗韵五首 其五 和王尚书独坐诗韵","author":"安熙","text":"栖迟蓬荜养慵疏，虚室焚香静掩书。\n坐进工夫元自尔，心斋意味果何如。\n圣贤名世几千载，皇极经年十万馀。\n至理悠然与心会，恍疑身在先天初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"尊兄仲举父典教石州乡郡","author":"安熙","text":"纷纷世累苦相牵，抚事悲歌惜壮年。\n卜隐未成长往计，伤时空赋远游篇。\n林宗雅志伊谁识，张翰孤怀亦自贤。\n见说家山风物好，几时同倚暮云巅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答友见赠","author":"安熙","text":"高山流水趣何深，万古千秋一素琴。\n白石清泉成雅志，光风齐月负初心。\n伏龙应羡云生谷，独鹤不惊鸦满林。\n无用野夫宜揣分，商家元自有甘霖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和仲弟生朝","author":"安熙","text":"兄弟趍庭雁影翩，祗今痴绝尚依然。\n竞阴莫废经纶业，爱日当知喜惧年。\n颜乐自怜乖夙志，南陔谁解补遗篇。\n几时得遂求田计，晨夕相将理断编。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饶阳小山诗卷","author":"安熙","text":"胸中有全山，华嵩亦自小。\n孤坐对嵓姿，肝肠倚天表。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日斋居杂诗 其一","author":"安熙","text":"忆昔趍庭讲诵初，慨然不复向迷途。\n只今回首还思省，力学工夫尚尔疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日斋居杂诗 其二","author":"安熙","text":"千载传心百世师，周程授受想当时。\n乾坤万古春风在，空向篷窗事仰思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日斋居杂诗 其三","author":"安熙","text":"生平不见李延平，俛首孳孳亦谩生。\n每诵斯言多感慨，区区辛苦竟何成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日斋居杂诗 其四","author":"安熙","text":"拥彗抠衣志未酬，哲人已矣更何求。\n微言尚省蒙私淑，愿得终身事远游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日斋居杂诗 其五","author":"安熙","text":"圣门道大若天然，小智区区见自偏。\n谩抱遗编时自惜，光阴去矣又中年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"文山隐居诗卷","author":"安熙","text":"西山缘底澹无姿，便拟从君问所知。\n告我云烟最佳处，眼中连栋有深期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子温贤友临别求言不容以病废辞勉书二诗为赠后篇兼简王君仪伯一笑 其一","author":"安熙","text":"平生踪迹叹孤危，尚友千年谩所思。\n才气如君更知己，可能分手易前期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子温贤友临别求言不容以病废辞勉书二诗为赠后篇兼简王君仪伯一笑 其二","author":"安熙","text":"谁遣林宗解隐忧，更堪摇落对清秋。\n凭君寄问观光客，底事哦诗拟四愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杜才卿韵","author":"安熙","text":"病躯疏散愧非才，只办求田问舍来。\n说似幽花应解语，为谁零落为谁开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿李翁八十诗 其一","author":"安熙","text":"洛畴五福古难并，四福还因好德生。\n开秩九龄从此始，更期寿域看升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿李翁八十诗 其二","author":"安熙","text":"馀庆悬知积德深，昭昭神理古犹今。\n寄言戏綵贤孙子，食息无忘爱日心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿李翁八十诗 其三","author":"安熙","text":"近亲自合存忠养，涉世高年亦我师。\n平昔行窝还有几，并留陈迹记它时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杏花始开连日大风不获一赏晨起携筇往观之归而小酌得三绝句 其二","author":"安熙","text":"白白红红春意深，恶风吹折五更心。\n化工自与时消息，莫负清吟酒满斟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"友人西城探梅折一枝来赠求诗为赋二首 其一","author":"安熙","text":"愁烟苦雾锁春光，谁遣边城有艳阳。\n珍重故人相赠意，可无佳句为平章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"友人西城探梅折一枝来赠求诗为赋二首 其二","author":"安熙","text":"俗草凡花久乱真，小窗惊见一枝春。\n凭君欲问调羹信，只恐幽香不认人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别赋一首","author":"安熙","text":"铁石心肠冰玊姿，此生惟许岁寒知。\n兴来欲草梅花赋，不解能书婉媚词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]