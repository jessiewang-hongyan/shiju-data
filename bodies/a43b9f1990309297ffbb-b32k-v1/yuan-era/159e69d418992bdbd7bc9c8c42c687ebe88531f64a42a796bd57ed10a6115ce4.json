etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"缥缈峰","author":"吴镇","text":"洞庭黛色几重重，缥缈维称第一峰。\n曾上昆崙瞻八极，具区烟水混鸿濛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明月湾","author":"吴镇","text":"月华滟滟水悠悠，圆月沈时曙色浮。\n自笑驱驰亦如月，东来西去几时休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古藤","author":"吴镇","text":"古藤阴阴抱寒玉，时向晴窗伴我独。\n青青不改四时容，绝胜凌霄倚凡木。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泽山","author":"吴镇","text":"茫茫震泽拥孤山，人在山间是泽间。\n安得相携山逸侣，丹梯碧磴共跻攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青浮山","author":"吴镇","text":"孤山七十布西东，水面奇形独不同。\n几向崚嶒高处望，青螺浮在太湖中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其九","author":"吴镇","text":"忆昔相逢武水头，行行送上木兰舟。\n遥怜落日蒸溪上，野色风声几许愁？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18308,"sha256":"83a