[{"title":"春近","author":"吴当","text":"颇觉边尘净，仍看昼刻添。\n江风寒透屋，野日暧窥檐。\n病减寻书帙，春来忆酒帘。\n归心何日遂，谈笑听闾阎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"积雪","author":"吴当","text":"积雪山河净，昏霾宇宙迷。\n雁声来漠北，兵气自征西。\n海雾浮龙影，关寒惬马蹄。\n时危增愤结，衰病属羁栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庐岳","author":"吴当","text":"庐岳不可极，山深宜养恬。\n松巢邻李白，菊径似陶潜。\n秀色云千仞，秋光雨一帘。\n渔樵与麋鹿，於我更无嫌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阳九","author":"吴当","text":"厄会符阳九，沉痾阅岁三。\n苏卿吟漠北，庾信赋江南。\n山影开晴黛，湖光接暮岚。\n艰危心不展，俯仰事何惭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日得乡信","author":"吴当","text":"旅思春江上，乡山宿雾中。\n鬓毛难再黑，花蕊转添红。\n病减诗囊在，愁多酒盏空。\n衣冠俱散走，何地哭途穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"释闷","author":"吴当","text":"世乱复为客，衰颜对物华。\n江城年节酒，野树岁寒花。\n雪岭明残照，烟汀带落霞。\n为谁添白发，何计问丹砂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兵交","author":"吴当","text":"虎狼犹搆祸，四海苦兵交。\n鼓动霜飞剑，笳鸣月拂弰。\n川红依壁垒，林黑避橧巢。\n野老仍羁旅，何乡可结茅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戒守","author":"吴当","text":"戒守时鸣鼜，传更夜击刁。\n乱山青拂眼，衰柳绿垂髫。\n略阵楼船壮，先锋越骑骁。\n军中称汉将，谁是霍嫖姚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十有一月至于正月连雪不已","author":"吴当","text":"气合冰天址，光连雪岭西。\n愁来望不极，诗罢思俱迷。\n澌冻江淮远，昏霾岭峤齐。\n饥寒春事迫，何以慰蒸黎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虚橐","author":"吴当","text":"世已声华改，身兼老病侵。\n几年沧海梦，一旦白头吟。\n旅馆惊虚橐，寒城急暮砧。\n固穷知义命，何用较升沉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中移居 其一","author":"吴当","text":"江水东流去，庐山北向来。\n孤城新第宅，浮世旧风埃。\n久病频移榻，多情数举杯。\n乡心犹未已，春色苦相催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中移居 其二","author":"吴当","text":"扰扰人间世，萧萧物外身。\n江山如有态，草树暗生春。\n自笑新巢燕，谁怜旧主贫。\n旅怀相慰藉，真率见情亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜筑","author":"吴当","text":"水外十三坡，居人总荷戈。\n烟营江树尽，霜木陇云多。\n樵爨村村屋，斧斤旦旦柯。\n白驹空谷在，何事卜行窝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"战士","author":"吴当","text":"战士屯边垒，家人问繇爻。\n寒堂悲蟋蟀，月户怨蟏蛸。\n巷有招魂帛，林无返哺巢。\n干戈何日洗，倒载虎皮包。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烽烟","author":"吴当","text":"烽烟寒转急，丧乱岁难休。\n野老无家别，遗畦尽力求。\n关河多骑气，江海自渔舟。\n世事由天运，何须涕泗流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中","author":"吴当","text":"何乡能遁迹，天地有渔翁。\n沽酒时曾醉，探囊岁屡空。\n衰年双鬓白，长日一丝风。\n谈笑兵戈外，兴亡俛仰中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日辛丑","author":"吴当","text":"两度黄花酒，尊空思转伤。\n去年留病榻，今日复虚樯。\n粝饭依人爨，疏衣透骨凉。\n干戈天意在，去住更何乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"群情","author":"吴当","text":"社稷生奇变，关河入战图。\n楼前朱汗马，城上白头乌。\n国步分光岳，江流接蜀吴。\n群情思伯业，佳气瞩皇都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"所思","author":"吴当","text":"舆图真混一，廊庙乏才贤。\n得失轻千虑，奸雄起九廛。\n阴霾迷岁月，战地起风烟。\n洒涕江湖外，渔舟白日眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天意","author":"吴当","text":"僣窃千家郭，颠连一病夫。\n虎狼相啖噬，齿爪及茕孤。\n冻馁民何赖，分争霸易图。\n物情知厌乱，天意启祯符。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"远客","author":"吴当","text":"远客又遘患，其如头白何。\n系舟沙岸久，闭户水寒多。\n喜气闻关塞，军声接汉沱。\n废兴知运数，海内厌兵戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钞掠","author":"吴当","text":"钞掠民何赖，孤穷痛不禁。\n江山惨寒色，鸿雁有哀音。\n白发三年病，青霄万里心。\n路迷尘冉冉，肠断暮骎骎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孤舟","author":"吴当","text":"牛斗缠兵气，江湖隐使星。\n客头元自白，天眼为谁青。\n夕照留渔屋，寒芜接雁汀。\n孤舟风水阔，百计问柴扃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悲歌","author":"吴当","text":"世乱人多暴，魂惊客屡过。\n采薇春事远，席秸夜寒多。\n凉月侵萝薜，清霜看芰荷。\n荒墟唯痛哭，野老亦悲歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子月午日壬子夜半雷雨","author":"吴当","text":"客愁随日度，寒律向东排。\n黎庶干戈暴，苍天号令乖。\n江雷宵送雨，山雾晓生霾。\n安得氛埃净，春光接泰阶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐氏园亭","author":"吴当","text":"河山锦绣帝城中，更辟名园在屋东。\n满地绿阴三月雨，数声黄鸟百花风。\n轩楹有席渔樵对，樽酒多情父老同。\n逸兴已无朝市梦，相逢往往说年丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈廷佐高州路教授","author":"吴当","text":"江州义门天下传，君今分教岛云边。\n百蛮俎豆先王学，列坐弦歌弟子员。\n鹦鹉园林春似海，秭归风雨夜如年。\n宦情莫叹微班冷，禄米分时蚌蛤田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送归彦温河西宪使","author":"吴当","text":"阳关东出接西凉，皂盖朱轓陇路长。\n五郡人烟无堡塞，千村部落有牛羊。\n休屠庭远曾归汉，都尉城荒尚护羌。\n四海舆图真浑一，祗将声教答时康。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送苏伯脩由礼部侍郎赴淮东宪使","author":"吴当","text":"东曹礼乐竦朝端，忽奏皇华遣豸冠。\n五色文章金匮富，九天风露玉壶寒。\n江头画舫迎潮去，海上青山立马看。\n二十四桥春似锦，飞花不到使君鞍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"看云亭为慈溪匡上人赋","author":"吴当","text":"盘结松萝四壁空，静看云影坐从容。\n风清时送归岩鹤，雨散常依在钵龙。\n野水带潮微辨树，山光敛暮只闻钟。\n杖藜欲去分禅榻，知隔慈溪苐几重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉雪坡为周学士赋","author":"吴当","text":"曾识罗浮山下树，苍茫白石共烟萝。\n几年种玉云千尺，镇日花开雪一坡。\n酒熟谷中春事早，诗成湖上月明多。\n青绫夜向金銮直，疏影黄昏奈尔何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丘参军妻守节","author":"吴当","text":"紫髯不见旧参军，桓表旌门墨色新。\n云雨几时同穴梦，冰霜百岁未亡身。\n香奁有泪迷鸾影，锦瑟无声落燕尘。\n萱草堂前今种柏，翰林留记写精神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"保定王氏母九十得赐帛乡人合燕为寿","author":"吴当","text":"皇家赐帛出郊圻，王母光荣九十时。\n仙露酿成千日酒，春风来自万年枝。\n旧颁官诰从儿贵，新制恩袍与体宜。\n已是八荒开寿域，城南咫尺接天墀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毕氏子韶州访翁李知事","author":"吴当","text":"蜑雨收岚海气凉，陇船迎浪粤山长。\n杜鹃乱叫杨梅熟，鹦鹉低飞荔子香。\n筹幕望云依北极，琴台延月对东床。\n宫岩石乳?于玉，服食应须远寄将。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋梅竹轩寄太史杨公","author":"吴当","text":"湖上开轩接浪波，映阶梅竹更婆娑。\n润留翠黛春云合，寒入冰绡夜月多。\n嘉实可供调鼎餗，长竿终自伴渔蓑。\n清风三径人如玉，越水吴山奈尔何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘成德之京师","author":"吴当","text":"玉溪杨柳绿依依，新着丹袍陟帝畿。\n江上马蹄春蹀?，日边龙角晓依微。\n禁墀香近神仙佩，御苑花开锦绣围。\n亦欲乘槎问星使，祗愁老却故山薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题桐木韩氏族谱","author":"吴当","text":"韩家相业当时重，盛德名昆集凤池。\n章佩并县金错落，宣麻同拜玉淋漓。\n梧桐春雨江南梦，松柏秋风海内悲。\n孙子尚馀宗谱在，更传遗事后人知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨公明徐志可贻诗次韵荅之 其一","author":"吴当","text":"几杖曾陪上玉京，几回听漏酒初醒。\n琳琅春盍朝天佩，云母时开迎御屏。\n银瓮赐馀莲子白，金鱼恩重荔枝青。\n不才犹欲承先泽，樗散何堪辱在庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨公明徐志可贻诗次韵荅之 其二","author":"吴当","text":"南州榻在长留客，北海樽空未易醒。\n台馆四时如锦绣，云霞长日作帷屏。\n桃成秋实千年碧，橘待霜肥万颗青。\n闻说临池多逸兴，笼鹅时与换黄庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宋蕲之广济簿尉黄刚中脩水人也至元天兵渡江中十九矢而死妻刘被掠子甫十岁既长求其母凡十年知已没入官迎驾哀诉得旨使为母子如初","author":"吴当","text":"临危百箭忠臣血，流落孤踪孝子心。\n霜露年年秋草碧，关河处处暮云深。\n仰天已觉恩如海，爱日常怀泪满襟。\n继述好留青史传，凄凉更赋白头吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20216,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"环青堂","author":"吴当","text":"黔南泉石尽烟霞，幽夐偏宜隐者家。\n四坐春山有秋色，一川流水见桃花。\n樵歌窈窕穿云去，眉黛婵娟对日斜。\n更说官閒松菊在，芒鞋应许踏轻莎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20217,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"翰林上直次周伯温韵 其一","author":"吴当","text":"宫庭白日静相宜，铃索无声谩自讥。\n云近帘栊秋影薄，香飘殿阁晚风微。\n典谟事业千年册，黼黻文章五色机。\n每叹小臣怀补报，寸衷何计达宵衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20218,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"翰林上直次周伯温韵 其二","author":"吴当","text":"金鸭香分石鼎茶，日长宫署寂无哗。\n庭前草树皆生意，壁上丹青有岁华。\n禁直夜凉初赐被，讲筵秋近又宣麻。\n神光郁郁冲牛斗，河汉层阴莫漫遮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20219,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"史院秋祀三朝神御殿用郑编脩韵","author":"吴当","text":"银烛金莲禁署深，香飘秘殿碧沉沉。\n鼎湖弓剑千年在，黼座衣冠五夜临。\n帘外雨云飞野鸟，殿中燎火起巢禽。\n悲丝急管俱增感，谁识朱颜白发心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20220,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彦脩秘监作亭阶前栽竹一个名一竿亭咸为赋诗","author":"吴当","text":"公子孤标绝世奇，亭前栽竹静相宜。\n苍龙垂影云千尺，翠袖临风玉一枝。\n特操不随春色改，高情只许岁寒知。\n江头留得扁舟在，何日从君独钓时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20221,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送达天山融州大守","author":"吴当","text":"五马翩翩渡五溪，玉融更在桂林西。\n连山晴黛分岩洞，列戍昏烟叠鼓鼙。\n陇上梅花无雁过，庭前榕叶有莺啼。\n使君自是金闺彦，暂为分忧及远黎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20222,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宜春盘龙寺","author":"吴当","text":"岩峰三十六盘通，塔殿高低翠谷中。\n传法有宗僧业白，安身无语佛灯红。\n松杉种得云千本，泉瀑飞来雪半空。\n最喜老龙泓下卧，肯将霖雨致年丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20223,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蓬轩","author":"吴当","text":"幽居轩槛越江边，鸿雁凫鹥在目前。\n春涨还如天上坐，雪时浑是剡中船。\n一枝梅月寒堪画，几树松涛夜不眠。\n总把平生湖海兴，斫鱼酾酒赋诗篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20224,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"史馆上直次王应奉韵","author":"吴当","text":"玉堂高迥不宜冬，古木回廊浩荡风。\n华盖紫微天咫尺，泰阶黄道日当中。\n捷书迅急时闻奏，退食从容每自公。\n衰晚腐儒何补报，祗须制作示无穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20225,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送逯善上海道万户","author":"吴当","text":"帅符新拜紫髯翁，国饟深贤转漕功。\n海水八荒浮地轴，云帆万斛动天风。\n东吴民力今时困，中土军储昔自充。\n报政归朝参大议，经邦事业属豪雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20226,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"筠庭","author":"吴当","text":"老屋城南倚翠屏，萧萧脩竹满前庭。\n笋因夜雨侵苔长，枝共春云覆槛青。\n深处石閒留客坐，隔林莺啭抚杯听。\n故人诗句应题遍，藜杖何时一叩扃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20227,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄福建魏廉使","author":"吴当","text":"御沟冰泮水初流，绣斧朱幡上綵舟。\n北极关河真壮观，南州风物总离忧。\n花明苑树莺声晓，枫落吴江雁影秋。\n眷注定知宣室召，归来应得从春游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20228,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浮云道院","author":"吴当","text":"道院孤高古翠微，满间山气静霏霏。\n晓随白鹤迎风出，春共苍龙作雨归。\n浮世纷华空在目，閒情舒卷自忘机。\n无端却上蓬莱住，五色成章向日飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20229,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鸡山隐居","author":"吴当","text":"自是山深好隐居，白云千亩在庭除。\n凫飞每候仙人舄，酒熟时停长者车。\n春尽草根俱是药，秋来柿叶总堪书。\n旧家猿鹤多生怨，久欲从君卜里闾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20230,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代祀过信州苍岩贰守贻诗次韵以谢","author":"吴当","text":"群飞凡羽见孤凰，胸臆皆成五色章。\n奕世公侯存故国，先朝相业踵遗芳。\n银筝自度新调曲，金鸭时焚旧赐香。\n惭愧相逢即相别，江东云树寸心长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20231,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都秋日登眺","author":"吴当","text":"客里年光似水流，满城砧杵动羁忧。\n沙头白露牛羊夕，塞上黄云鸿雁秋。\n千里关河通王气，两都宫阙壮神州。\n多情不用悲摇落，更为斜阳独倚楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20232,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"环翠楼","author":"吴当","text":"碧梧翠竹倚孱颜，故筑层楼与客攀。\n剑气每留星汉上，山光只在雨帘间。\n娟娟晓日开眉黛，蔼蔼春云拥髻鬟。\n便欲买舟江海去，杖藜应许叩岩关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20233,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鳌峰石","author":"吴当","text":"鳌峰石在玉堂前，近与蓬莱御阁连。\n积润出云秋漠漠，孤根承露夜娟娟。\n土花剥尽生光怪，海峤移来阅岁年。\n艮岳遗墟归草莽，金题犹识旧时镌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20234,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上官氏南楼","author":"吴当","text":"层轩百尺倚高秋，萧爽浑如庾亮楼。\n云影每依帘侧畔，溪声只在树东头。\n仙人岩石通霄汉，太乙藜灯直斗牛。\n总道登临多雅兴，何时借鹤试相求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20235,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东安陈氏慕亲堂","author":"吴当","text":"城外云连郭隗台，草堂寂寞傍坟开。\n碑铭有字人常读，宰树成行手自栽。\n雊雉春迎寒食出，哺乌晴逐夕阳来。\n百年霜露无穷思，击筑酬歌总是哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"坦明堂","author":"吴当","text":"东南佳丽独钱塘，君向青郊结草堂。\n几曲云山分野色，满池秋水纳天光。\n松阴落处琴书润，柳絮飞来枕簟凉。\n衮衮京华尘土梦，好因鲈鲙踏吴航。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戴宣使以差出建康因得过家","author":"吴当","text":"杨柳新条拂酒杯，都门望望百花开。\n元臣建国罗群彦，使者宣劳出上台。\n云路渐看华盖逼，乡关初见锦衣回。\n此行不为鲈鱼鲙，莫待秋风击棹来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李氏义聚堂","author":"吴当","text":"锦里堂成聚弟兄，门门雍睦见仪型。\n桑麻绕屋春千亩，风雨连床夜六经。\n折去荆花依旧紫，种来慈竹镇长青。\n贻谋更有无穷感，时向尊前赋鹡鸰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萧閒外舍次许可用承旨韵","author":"吴当","text":"东郊结屋川光近，内相题诗墨色新。\n庭草常留青鹿卧，渚云惟许白鸥邻。\n傍帘种竹秋声近，带石移花夕露匀。\n野马尘埃浑不到，萧然门巷自家春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺存堂","author":"吴当","text":"龙泉江上卜幽居，题扁当楣学士书。\n堂下白花吹采凤，窗间锦瑟咏关雎。\n猗兰有态春云近，棣萼多情昼日舒。\n朋酒升堂家庆在，相看不乐更何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至日和仲宝大学士韵","author":"吴当","text":"御扆当阳扇影回，乐声齐起殿前雷。\n行天黄道常依日，报国丹心未许灰。\n金锡衮衣归黼黻，琼楼玉宇尚崔嵬。\n谢安再为苍生起，调化真宜法斗魁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]