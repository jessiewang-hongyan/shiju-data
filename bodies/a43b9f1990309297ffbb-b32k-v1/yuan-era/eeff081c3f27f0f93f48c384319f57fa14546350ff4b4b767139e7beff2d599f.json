[{"title":"滦京杂咏一百首 其七十五","author":"杨允孚","text":"海红不似花红好，杏子何如巴榄良。\n更说高丽生菜美，总输山后?菰香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十六","author":"杨允孚","text":"四月东风渐渐和，流波细细出官河。\n诗人策马红桥过，御柳今朝丝较多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十七","author":"杨允孚","text":"偶因试马小盘桓，明德门前御道宽。\n楼下绿杨楼上酒，年年万国会衣冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十八","author":"杨允孚","text":"怪得家僮笑语回，门前惊见事奇哉。\n老翁携鼠街头卖，碧眼黄髯骑象来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十九","author":"杨允孚","text":"一曲琵琶可奈何，昭君青冢恨消磨。\n可怜西地黄云起，不似连天芳草多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十","author":"杨允孚","text":"翠楼紫阁尽崔巍，花落花开不用催。\n最是多情天上月，照人西去又东来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十一","author":"杨允孚","text":"承恩留守是何王，锦帐成围促宴忙。\n却怪西风浑不顾，一般吹送满头霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十二","author":"杨允孚","text":"不须白粲备晨炊，乳酪羊酥塞北奇。\n泥土炕床银瓮酒，佳人椎髻语侏离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十三","author":"杨允孚","text":"东风亦肯到天涯，燕子飞来相国家。\n若较内园红芍药，洛阳输却牡丹花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十四","author":"杨允孚","text":"卖酒人家隔巷深，红桥正在绿杨阴。\n佳人停绣凭阑立，公子簪花倚马吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十五","author":"杨允孚","text":"白白毡房撒万星，名王酣宴惜娉婷。\n李陵台北连天草，直到开平县里青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十六","author":"杨允孚","text":"东风吹暖柳如烟，寄语行人缓著鞭。\n燕舞巧防鸦鹘落，马嘶惊起骆驼眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十七","author":"杨允孚","text":"时雨初肥芍药苗，脆甘味压酒肠消。\n扬州帘卷东风里，曾惜名花第一娇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十八","author":"杨允孚","text":"霜寒塞月青山瘦，草实平坡黄鼠肥。\n欲问前朝开宴处，白头宫使往还稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八十九","author":"杨允孚","text":"虽然玉宇桂无花，秋比江南分外佳。\n弦管画楼人散去，舍郎携妓劝尝瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十","author":"杨允孚","text":"御馔官厨不较馀，金门掌膳意勤如。\n更分光禄瓶中酒，烂醉归时月上初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十一","author":"杨允孚","text":"别却郎君可奈何，教坊有令趣兴和。\n当时不信邮亭怨，始觉邮亭怨转多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十二","author":"杨允孚","text":"窈窕谁家女未笄，日高停绣出帘帷。\n背人笑指青霄上，认得宫庭白鸽飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十三","author":"杨允孚","text":"滦京九月雪花飞，香压萸囊与梦违。\n雁字不来家万里，狐裘旋买换征衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十四","author":"杨允孚","text":"雪深连月与檐齐，谁把新吟向客题。\n一字成时笔如铁，不如载酒画楼西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十五","author":"杨允孚","text":"出塞书生瘦马骑，野云片片故相随。\n冻生耳鼻雪堪理，冷入肝肠酒强支。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十六","author":"杨允孚","text":"宫监何年百念消，冠簪惊见髻萧萧。\n挑灯细说前朝事，客子朱颜一夕凋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十七","author":"杨允孚","text":"买得香梨铁不如，玻瓈椀里冻潜苏。\n书生半醉思南土，一曲灯前唱《鹧鸪》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十八","author":"杨允孚","text":"强欲驱愁酒一卮，解鞍閒看古祠碑。\n居庸千载兴亡事，惟有天中月色知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九十九","author":"杨允孚","text":"塞边羝牧长儿孙，水草全枯乳酪存。\n不识江南有阡陌，一犁烟雨自黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其一○○","author":"杨允孚","text":"试将往事记从头，老鬓征衫总是愁。\n天上人间今又昔，滦河珍重水长流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有所思","author":"潘音","text":"中心有所思，蹙损双蛾眉。\n美人竟长往，使我叹离居。\n寂寞就孤枕，强眠谁得知。\n夜深清露重，飞梦欲何之。\n觉来日迟迟，分照上罗帏。\n妆台理云鬓，种种尽成丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"远游","author":"潘音","text":"圣人久不作，大道将已矣。\n吾生既无之，惟有幸夕死。\n殷勤谢良友，远涉西江水。\n方从草庐公，共究鹅湖旨。\n纷纷朱陆议，窃幸窥端倪。\n奈何执德偏，一聘翻然起。\n春秋严内外，乾坤定冠履。\n西蜀已空亭，箕山仍洗耳。\n迢迢返岩阿，惟当随鹿豕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"往清轩","author":"潘音","text":"殷本高辛裔，六七起圣君。\n受王一剥丧，高贤尽隐沦。\n坐待天下清，用沽席上珍。\n况兹黄袍破，我生当其辰。\n衣冠归□□，海国陷黄尘。\n宁有人间世，能逃率土滨。\n结茅菩提顶，浑忘虎豹邻。\n寤寐祇思晋，幽沈迥避秦。\n何时启昌运，□□产圣人。\n愿言同二老，荷杖还归仁。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中寄友人","author":"潘音","text":"我来卧白云，潭影清华发。\n经岁无稻粱，侵晨采薇蕨。\n峰头天籁鸣，陇上樵歌发。\n还拟醉浊醪，与君弄山月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"反北山嘲","author":"潘音","text":"达人知进退，曲士岂同谋。\n尽使藏身去，谁当为国忧？\n烟霞成痼癖，声价藉巢由。\n虎啸雄心在，胡为鹤唳愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"友人夜宿","author":"潘音","text":"云山多乐事，丛桂共君攀。\n别去十年久，归来两鬓斑。\n倚窗邀素月，把酒慰离颜。\n醉后松堂卧，涛声落枕间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南洲丁氏草堂","author":"潘音","text":"仙客栖真处，衡门枕曲流。\n地偏三岛接，天迥万山浮。\n匣剑星霜久，函书洞壑幽。\n忘机对鸥鸟，华发老沧洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼杨侍郎","author":"潘音","text":"屈指汉遗老，如君复几何。\n凤池冠剑近，铃阁典章多。\n国已成禾黍，人还隐薜萝。\n那堪川上水，东逝乏回波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居阻雨","author":"潘音","text":"霏霏风雨暗郊原，有客含凄独掩门。\n山鬼啸云移峭壁，毒龙将海浸孤村。\n愁来自洒青枫泪，战罢谁招绝漠魂。\n茧足空斋无一语，不因岑寂怨黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东溪水涨","author":"潘音","text":"积雨经时苦自长，东溪回首意凄凉。\n连山巨浪飞春雪，数点惊鸥下夕阳。\n神女含情愁洛浦，美人挥泪洒潇湘。\n欲寻舟楫无由渡，咫尺天涯共渺茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登楼秋望","author":"潘音","text":"木落霜清雁影流，偶来长啸独登楼。\n笳鸣薄暮寒鸦集，剑倚遥空紫电流。\n万里胡尘连大漠，一樽汉月醉高秋。\n深闺少妇思征戍，何处闻砧不动愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"真觉寺访蔡上人","author":"潘音","text":"为寻支遁扣禅关，趺坐观空出宇寰。\n净土无尘劳白拂，天花如雨落青山。\n龙皈宝座香云满，鸽绕经台佛日閒。\n谁谓陶潜偏嗜酒，从今莲社未应还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庞德公","author":"潘音","text":"高士遗踪尚可寻，襄阳城外閟幽林。\n久知轩冕浮荣薄，已卜耕锄乐趣深。\n麟阁不图丘壑相，鹿门应遂白云心。\n千秋事与人俱往，满目松楸带夕阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读岳武穆传","author":"潘音","text":"万里浮云入望阴，千山落日正沈沈。\n当朝自馁中兴志，出塞徒劳上将心。\n臣子终天仇未复，奸邪设险计殊深。\n惟馀一箧精忠传，挥泪频看不自禁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼文丞相","author":"潘音","text":"回首中原已陆沈，捐躯朔漠气萧森。\n恐吹馀烬成炎汉，未许黄冠返故林。\n社稷忽生千古色，纲常无忝百年心。\n总?清骨萦荒草，不复胡沙掩素襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻鹃","author":"潘音","text":"子规声切月轮斜，起望诸陵忆汉家。\n妇女寻芳浑不解，鬓云争插杜鹃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对月酌酒","author":"钱惟善","text":"对月不饮酒，何以陶吾生。\n明辉散空白，照我千载情。\n泠然辄忘寐，但觉风露清。\n寒蛩杂群籁，天地皆秋声。\n流光不可驻，长江终夜鸣。\n酒尽月欲堕，浩歌倚层城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送酸斋学士之西川","author":"钱惟善","text":"蓟北文章客，风流迥不群。\n潮声秋别梦，月色夜留君。\n三峡吞秦树，千峰抹楚云。\n形骸捐水石，来往更殷勤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵壁手印篇","author":"钱惟善","text":"汉香飞入乌孙国，踰白龙堆行绝域。\n万里穷愁天一方，曾驻鸣镳倚灵壁。\n灵壁亭亭立空雪，石痕不烂胭脂节。\n神飙吹影高撩秋，提云欲补中原月。\n穹庐作室墙以旃，佩环魂托胡歌传。\n当时双泪洒成血，血成碧色苔花坚。\n青冢相望去不归，归时定化黄鹄飞。\n千年恨隔毡城梦，汉使者过空沾衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王氏节妇诗","author":"钱惟善","text":"昔年襄阳贾尚书，儿媲韩氏身葬鱼。\n当以血溅云锦襦，至今波荡青琼琚。\n啮指堂堂丈夫气，乃见苍茫甲兵际。\n倚舷不忍渡中流，翻然直向龙宫逝。\n嗟嗟赤城王氏妻，青枫岭滑愁云低。\n?江水黑幽魂啼，峭壁万仞无由梯。\n望夫不来归路迷，石痕雨碧风凄凄。\n君臣失国时所偶，儿女丧家我何有。\n丹精贯日昭不朽，朝廷立庙?江口。\n荆扬孰谓风俗媮，呜呼贞节无与俦。\n二女允也忠义流，他年太史须编收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月十五夜风雨后见月有怀","author":"钱惟善","text":"天柱峰高月华碧，自古人间风雨隔。\n飘然欲探蟾窟游，万里阴霾妒良夕。\n玄云忽开黄道明，顾兔涵秋抱冰魄。\n嫦娥偷药长少年，桂子芗霏羽衣湿。\n飞仙挟我凌太清，万丈寒光湛虚白。\n美人不来空夜凉，《白纻》歌阑露花积。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送曹克明员外之湖广省","author":"钱惟善","text":"钱塘西望武昌城，天际飞艎几日程。\n三峡波涛下江汉，九疑云雾接巫衡。\n笑谈落落萧曹佐，登览苍苍屈宋情。\n更把文风变丹徼，不须铜柱纪南征。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杜甫麻鞋见天子图","author":"钱惟善","text":"四郊多垒未还乡，又别潼关谒凤翔。\n九庙君臣同避难，十年弟妹各殊方。\n中兴百战洗兵甲，万里一身愁虎狼。\n寂寞当时穷独叟，按图怀古恨茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发葑门得风直抵皂林泊","author":"钱惟善","text":"白龙庙前风浪生，扁舟初离阖闾城。\n婵娟霜月雁千里，颠倒衣裳鸡五更。\n橹答渔歌江入梦，帆迎野色树移程。\n苇间何限秋萧瑟，愁绝胡笳出塞声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"钱惟善","text":"倦游湖海十年馀，人物如云想国初。\n贞观名臣重房杜，建安才子数应徐。\n闻鸡起舞关河壮，射虎归来事业疏。\n便欲巢松寻五老，短檠依旧满床书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词二首和符安理镇抚韵 其一","author":"钱惟善","text":"放生池上月沈钩，掖树如云易得秋。\n钟动景阳梳洗早，辘轳声转井干楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词二首和符安理镇抚韵 其二","author":"钱惟善","text":"梦惊鸳瓦落宫墙，殿锁长秋怨夜凉。\n教授后庭今白发，旧时博士汉披香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀陈子敬王子仁","author":"钱惟善","text":"倦游年少滞江南，忧患惊心百不堪。\n韶海有人遗白葛，洞庭无客寄黄甘。\n凉风拂衽听喉啭，夜雨移灯覆手谈。\n寂寞岁寒梅共我，月明索笑碧云檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洛阳陌","author":"钱惟善","text":"驱车洛阳陌，周道何逶迟。\n玉帛走侯甸，金汤固城池。\n潘令好桃李，阮生多路歧。\n铜驼卧荆棘，索靖独先知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长安道","author":"钱惟善","text":"车马如流水，楼台结彩虹。\n王孙来戚里，豪士遇扶风。\n不睹衣冠盛，空闻意气雄。\n鸢肩亦何事，日暮醉新丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关山月","author":"钱惟善","text":"落落汉时月，萧萧古战场。\n扬辉子卿节，逐影细君装。\n高映玉关外，低沈青海傍。\n不似闺中夜，祇照绣鸳鸯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"折杨柳","author":"钱惟善","text":"何处好杨柳，攀条赠远行。\n花飞渡江水，客醉蹋歌声。\n秋色彫榆塞，春阴接凤城。\n一枝不敢折，为近亚夫营。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湘泪竹管","author":"钱惟善","text":"黄陵庙前捐佩玦，龙影摇文织湘血。\n翠帷尘滴不乾云，湘水无声楚魂咽。\n蛮娘弄作吴娥吟，五音嘹亮生枯节。\n一声直向天上闻，手挟飞仙挽秋月。\n呜呜似向烟中语，十二螺鬟排律吕。\n黄鹤楼空人不还，断肠声里招神女。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早起","author":"钱惟善","text":"披衣起危坐，心清闻晓钟。\n流光入窗白，月澹西南峰。\n游鱼跃风藻，幽禽翻水松。\n青山如膏沐，远树烟为容。\n舟人与渔子，菰蒲深处逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"保叔塔","author":"钱惟善","text":"金刹天开画，铁檐风语铃。\n野云秋共白，江树晚逾青。\n凿屋岩藏雨，黏崖石坠星。\n下看湖上客，歌吹正沈冥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送著作兼善赴奎章典签","author":"钱惟善","text":"龙飞天子中兴年，使者弓旌集俊贤。\n阊阖早朝班玉笋，瀛洲夜直赐金莲。\n五经同异须刘向，三绝才名数郑虔。\n黼黻当时遗老在，长歌《黄鹄》送楼船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金明池图","author":"钱惟善","text":"金明池涌橐驼虹，驾幸琼林岁岁同。\n貔虎羽仪陈卤簿，《鱼龙》角抵戏珠宫。\n乐游台殿今成沼，习战旌旗昔蔽空。\n寂寞画图传后鉴，六飞回首塞尘红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼西山猿","author":"钱惟善","text":"老衲敲松唤不还，黑衣何处落潺湲。\n惯曾索果西湖上，无复号弓楚峡间。\n挂月影沈千尺树，啸云声断万重山。\n羁雌寂寞成孤怨，更约他生献玉环。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题广微天师升龙图","author":"钱惟善","text":"嘘气乘云薄太清，墨卿灵怪砚池腥。\n波涛光彩失双剑，风雨晦冥驱六丁。\n朱火腾空超碧落，翠鳞垂水捲沧溟。\n真人上挟飞仙去，安得攀髯过洞庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春游曲和傅子通韵","author":"钱惟善","text":"蛾眉晓压黛云冷，蚁波渌泛秋蛇影。\n千金难买能赋人，辘轳声沈旧宫井。\n青丝不梳慵早起，十二螺鬟翠相倚。\n鹦鹉解言天上愁，红雨香漂御沟水。\n羲车急急催飞光，杯中浅深愁短长。\n东邻谁唱断肠曲，游丝落絮春茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]