[{"title":"山閒山水手卷","author":"欧阳玄","text":"十年京国看图画，半幅云烟亦恼侬。\n今日身行屏障里，却思移住最高峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武三思双陆","author":"欧阳玄","text":"上阳无子局方阑，又到乘龙第一盘。\n饼餤未来聊乐耳，郎君好好点筹看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其一","author":"欧阳玄","text":"玉堂集日列金羁，学士新兼祭酒时。\n五百书生签讲遍，八砖花影最来迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其二","author":"欧阳玄","text":"丽正门当千步街，九重深处五云开。\n鸡人三唱万官集，应制须迎学士来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其三","author":"欧阳玄","text":"白玉堂前夜合花，高高绿树散朱霞。\n朝来如见唐人画，系著谁家白鼻騧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其四","author":"欧阳玄","text":"龙笙凤管舞轻盈，步障游看花满城。\n行到琼林春更好，新来进士唱名声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其五","author":"欧阳玄","text":"鳌山宴罢月溶溶，太液池边湛露浓。\n不用金莲送归院，水晶宫出玉芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城杂咏七首 其六","author":"欧阳玄","text":"京城走马听晨钟，我亦宵征仆兴慵。\n却忆江南春睡美，小楼攲枕听村舂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"逢江易艺芳于赋芳洲","author":"欧阳玄","text":"杨柳垂垂拂钓矶，平沙雨过绿生衣。\n王孙斗草归来晚，扑漉鸳鸯带水飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东山春景","author":"欧阳玄","text":"春光淡淡日迟迟，正是名园扑蝶时。\n却忆小桥流水过，东山春色在桃枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蒲萄","author":"欧阳玄","text":"宛马西来贡帝乡，骊珠颗颗露凝光。\n只今移植江南地，蔓引龙须百尺长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山庄所藏东坡画古木图","author":"欧阳玄","text":"眉山昔日生三苏，一山草木为之枯。\n后来笔端挟春腴，却令生意回枯株。\n树经公笔无老丑，天以春工付公手。\n谁云辈行龙眠翁？\n奚必法嗣洋州守。\n山庄刘氏富清玩，家有苏公旧挥翰。\n恍惊湿藓粘怪石，惯见倒根生断岸。\n涪翁对此煮春茶，为公梢上挂长蛇。\n灯窗细读假山记，秀气终属眉山家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏春闺怨","author":"欧阳玄","text":"东风园林花草香，芳闺寂寞春昼长。\n佳人独守情默默，银床锦被閒鸳鸯。\n终朝倦绣拈针指，怕向花前听莺语。\n唤回旧事千万端，杏脸蛾眉泪如雨。\n玉郎去年辞家时，绿杨红杏娇春晖。\n绿杨红杏色如旧，怅望玉郎犹未归。\n一春鱼雁音书绝，雪肤消瘦千肠结。\n断肠独立几黄昏，那更青山苦啼鴂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之舞姬脱鞋吟","author":"欧阳玄","text":"宫袍绣蹙金花绮，红绡紧衬双鸾尾。\n盈盈慢服舞腰轻，綵云飞处香风起。\n藕丝掣断春云松，瑞莲双结并头红。\n夭夭曲曲玉弯卷，翠凫飞去天欲软。\n玉阶秀茁兰笋长，琼沙迸出芦牙浅。\n徘徊困倚东风力，湿砌香云坠无迹。\n无限娇羞不自持，君王唤起扶花立。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠画工黎仲瑾","author":"欧阳玄","text":"吾闻苌弘之忠裂金石，精气千年化为碧。\n人生赖有方寸妙，万变神奇从此出。\n又闻西方梵僧名法能，能令两眼碧色晶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"度闽关二首 其一","author":"萨都剌","text":"晓度分水岭，身在云雾中。\n手扣天上关，声落山下风。\n雷霆走涧壑，神人过虚空。\n既讶奔丰隆，亦可招祝融。\n顷刻开万象，赤乌飞岭东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"度闽关二首 其二","author":"萨都剌","text":"白云下千峰，尽入怀袖里。\n振衣度闽关，洒作山下水。\n仰登天无梯，俯视井无底。\n古来守关人，豪杰存有几。\n寒食百草青，春风吹不起。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过岭至崇安方命棹之建溪","author":"萨都剌","text":"人生天地间，驰马历大块。\n行乐须及时，流光逝难再。\n役役功名羁，历历山水迈。\n伟哉东南区，奇险闽粤最。\n车书四海同，风气一岭界。\n肩舆度层霄，手棹下急濑。\n四山抱回流，环合如束带。\n玉井莲叶飘，仰高天作盖。\n倏驰丹峰前，却在紫岭背。\n微云间烟霞，疏雨洒松桧。\n深林樵牧归，落日山鬼会。\n雪瀑挂冰帘，林风响天籁。\n石梯驾仙岩，往往遗骨在。\n瑶草石上生，丹药市中卖。\n巍巍考亭祠，过客祠下拜。\n溪水自成文，上接洙泗派。\n唤渡云门僧，貌古清可爱。\n手把青松枝，趺坐溪石罅。\n悬崖虹栈危，插竹渔网晒。\n山高人蚁旋，下视舟一芥。\n轻舫类飞鳅，宛转乱石隘。\n峥嵘龙角尖，磊砢鼋首癞。\n槎牙激颓波，出没如水怪。\n万古槌地雷，三峡泻泙湃。\n峰峦争送迎，奔走万马快。\n箭过耳生风，开口不暇咳。\n峭壁起冲流，恍若巨鳌戴。\n山有旧题名，岁久字刻坏。\n岂无姓名存，彷佛年月载。\n览此前人踪，徒为后人慨。\n天气易寒暄，光阴倏明晦。\n浩荡三日程，应接千万态。\n会登天柱峰，一览宇宙大。\n少吐胸中豪，神游八方外。\n题诗赠山灵，清气留胜概。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游吴山紫阳庵","author":"萨都剌","text":"天风吹我登鳌峰，大山小山石玲珑。\n赤霞日烘紫玛瑙，白露夜滴青芙蓉。\n飘绡云起穿石屋，石上凉风吹紫竹。\n挂冠何日赋《归来》，煮茗篝灯洞中宿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"快雪轩","author":"萨都剌","text":"吴刚粉月成琼屑，洒向人间沃春热。\n门外青山不得青，刮地东风翻挞末。\n梨花云湿飞难起，晓来化作湘江水。\n娟娟美人耐高寒，对此心开几千里。\n山阴夜冷沙棠小，归来狂兴犹孤悄。\n古春吹到矮茅茨，香浮茗椀滋诗脾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明皇击梧图","author":"萨都剌","text":"华清池头凉思动，绿桐击去朝阳凤。\n阿环起学飞燕轻，笑唤三郎作供奉。\n羯腔打彻《西凉州》，锦茵蹴踏双鸳钩。\n彩鸾吟细朱樱破，一叶忽飘天下秋。\n愁声换出铎铃语，三十六宫散秋雨。\n曲江宫晓清露寒，零乱瑶阶逐风舞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜京口","author":"萨都剌","text":"铁瓮城头刻漏迟，凉霜如雪扑帘飞。\n雁声到地梦回枕，月色满船人捣衣。\n塞北将军犹索战，江南游子苦思归。\n呼鹰腰箭纵围猎，苜蓿秋深马正肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同曹克明清明日登北固山次韵 其二","author":"萨都剌","text":"三月二日风日暖，千家万家桃杏开。\n白日少年骑马过，红雨满城排面来。\n共君且须饮一斗，处世不必歌《七哀》。\n孙刘事业今何在，百年狠石生莓苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和参政王继学海南初还韵","author":"萨都剌","text":"飘零南北与东西，倦鸟投林未许栖。\n灯下冷风山鬼到，岭南春雨竹鸡啼。\n炎天海国瘴烟合，深夜蛮乡客语低。\n昔日持书乌府上，五花骢马凿霜蹄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游崇禧寺有感","author":"萨都剌","text":"紫翠云中出雨堂，老僧挥泪忆先皇。\n赤阑相映苔花落，翠辇不来山路荒。\n此日山河消王气，旧时草木识天香。\n夜深行殿无人到，应有山云护御床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偕廉公亮游钟山","author":"萨都剌","text":"十里松风吹酒醒，马头云气碧崚嶒。\n空山落叶时闻雨，古塔疏林夜见灯。\n胜地难逢今日会，旧游却记向年曾。\n使君五老峰前去，应有新诗寄病僧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同吴郎饮道院","author":"萨都剌","text":"三月江南飞柳花，松间童子脸如霞。\n旋酤采石仙人酒，来访山阴道士家。\n落日下城人影散，东风吹马帽檐斜。\n吴郎今夜孤舟渡，回首江心月半沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆观驾春蒐二首 其二","author":"萨都剌","text":"日奏云间紫凤箫，春随天上赭黄袍。\n仗前虎将千斤斧，架上鹰儿五色绦。\n猎士开弓黄犬疾，宫官击鼓紫驼高。\n侍游亦有中书令，七宝雕盘看绿毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城春日","author":"萨都剌","text":"燕姬白马青丝缰，短鞭窄袖银镫光。\n御沟饮马重回首，贪看杨花飞过墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山客舍","author":"萨都剌","text":"落日西山闻禁钟，梦回远客在卢龙。\n江南飞尽千株雪，孤负梅花过一冬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏四首 其一","author":"萨都剌","text":"城下黄河去不回，四山依旧翠屏开。\n无人会得登临意，独上将军戏马台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏四首 其三","author":"萨都剌","text":"黄河三面绕孤城，独倚危阑眼倍明。\n柳絮飞飞三月暮，楼头犹有卖花声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与弟别渡淮二首 其二","author":"萨都剌","text":"东南风送渡淮船，过雁声哀水拍川。\n落日淡霞收未尽，又随明月荡秋天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清凉亭衰柳","author":"萨都剌","text":"清凉亭上几株霜，脱叶难遮夕照光。\n依旧明年二三月，小童山下看鹅黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句容道中遇雪","author":"萨都剌","text":"何处吴姬压酒家，短衣匹马路盘斜。\n东风不识陈宫恨，一路吹开玉树花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和全子仁","author":"萨都剌","text":"毗陵公子醉昏昏，白面迎风散酒痕。\n几度小红楼畔月，有人吟倚掩重门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"萨都剌","text":"绿树阴藏野寺，白云影落溪船。\n遮却青山一半，只疑僧舍茶烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四时宫人图四首 其一","author":"萨都剌","text":"紫宫风暖百花香，玉人端坐七宝床。\n凤凰小架悬夜月，一女侍镜观浓妆。\n背后一女冠乌帽，茶色宫袍靴色皂。\n手持团扇不动尘，一掬香弯立清晓。\n一女浅步腰半驼，小扇轻扑花间蛾。\n淡阴桐树一女立，手抱胡床眼转波。\n床头细锁悬金钟，白鹤双飞花影重。\n词人见此神恍惚，巫山梦里曾相逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四时宫人图四首 其二","author":"萨都剌","text":"金猊吐烟清昼长，美人坐倚白玉床。\n蓝衫一女髻垂耳，手持方扇立坐傍。\n一女最小不会妆，高眉短发耀漆光。\n玉纤绿笋握金剪，柳下轻挽宫人裳。\n金盘玉瓮左右列，红桃碧藕冰雪凉。\n冰壶之傍立一女，背后随以双白羊。\n手拱金瓶泻水忙，酒翅洒雪惊鸳鸯。\n鸳鸯得水自双浴，美人抱膝空断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四时宫人图四首 其三","author":"萨都剌","text":"盆池露冷荷半枯，碧波风细双游鱼。\n美人坐此碧玉椅，屏山方案碧蟾蜍。\n椅后二女执缨立，案前二女娇滴滴。\n大女手扶小女腰，小女娇倚大女膝。\n凉风入树落翠槐，秋深不见羊车来。\n金铃响处吠黄犬，美人笑托芙蓉腮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四时宫人图四首 其四","author":"萨都剌","text":"锦屏三面围绣床，沈香椅上凤褥光。\n美人端坐袖双手，临眉半蹙愁夜长。\n椅后一女摇白羽，一女执缨更回顾。\n一女乌帽金缕衣，玉指纤纤携小女。\n小女手挽大女腰，笑看孔雀双翠翘。\n可怜美人独自坐，翠竹雪响风前梢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏九首 其二","author":"萨都剌","text":"秋风吹白波，秋雨鸣败荷。\n平湖三十里，过客感秋多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏九首 其五","author":"萨都剌","text":"白鹭爱秋水，独立仍自行。\n得鱼固偶尔，惊飞亦常情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝词","author":"萨都剌","text":"湖上美人弹玉筝，小莺飞度绿窗楞。\n沈郎虽病多情在，倦倚屏山不厌听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其一","author":"萨都剌","text":"涌金门外上湖船，狂客风流忆往年。\n十八女儿摇艇子，隔船笑掷买花钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其二","author":"萨都剌","text":"少年豪饮醉忘归，不觉湖船旋旋移。\n水面夜凉银烛小，越娘低唱月生眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其三","author":"萨都剌","text":"紫骝骄蹋落花泥，二月江城雨过时。\n拂晓市河春水满，小船多半载吴姬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其四","author":"萨都剌","text":"惜春曾向吴船宿，酒渴吴姬夜破橙。\n蓦听郎君呼小字，转头含笑背银灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其五","author":"萨都剌","text":"待得郎君半醉时，笑将纨扇索题诗。\n小红帘卷春波绿，度水杨花落砚池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖绝句六首 其六","author":"萨都剌","text":"垂柳阴阴苏小家，满湖飞燕趁杨花。\n繁华一去风流减，今日横堤几树鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王侍郎游湖","author":"萨都剌","text":"绮席新凉舞袖偏，赏心输与使君专。\n螺杯注酒摇红浪，綵扇题诗染绿烟。\n一镜湖光开晓日，万家花气涨晴天。\n涌金门外春如海，画舫笙歌步步仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纪事","author":"萨都剌","text":"当年铁马游沙漠，万里归来会二龙。\n周氏君臣空守信，汉家兄弟不相容。\n祇知奉玺传三让，岂料游魂隔九重。\n天上武皇亦洒泪，世间骨肉可相逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"废宅","author":"宋无","text":"金谷花开得几春，东风吹逐路傍尘。\n蛙鸣私地为官地，燕认新人是故人。\n珠履卖钱豪客散，玉钗乘传舞娥颦。\n兽环一锁歌钟断，时有鸮声恐四邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春愁","author":"宋无","text":"金雁尘香暗凤弦，红绳风紧阁秋千。\n园林寂寞无莺燕，一段春愁是杜鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨梅寄因上人 其二","author":"宋无","text":"梦觉霜林堕月，眼明野水浮枝。\n横玉不吹春去，断缣閒写相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉环病齿图","author":"宋无","text":"一点春寒入瓠犀，海棠花下独颦眉。\n内厨几日无宣唤，不问君王索荔枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老马","author":"宋无","text":"瘦蹄生入玉门关，病放沙场战骨閒。\n归龁残刍应有泪，将军头白戍天山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老牛","author":"宋无","text":"草绳穿鼻系柴扉，残喘无人问是非。\n春雨一犁鞭不动，夕阳空送牧儿归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"宋无","text":"花影玲珑满绣床，自调绿绮背红窗。\n惆怅佳期学弦线，七条哀怨不成双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游三茅华阳诸洞 其二","author":"宋无","text":"玉案清香彻夜焚，紫烟成盖覆茅君。\n数声金磬秋坛霁，敲碎遥天一缕云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游三茅华阳诸洞 其三","author":"宋无","text":"书满琅函秘不开，云窗雾阁锁青苔。\n门前白鹿将麑过，定是避秦人引来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游三茅华阳诸洞 其四","author":"宋无","text":"淡染云霞五色衣，杏坛朝罢对花披。\n洞中养只千年鹤，长被仙人来借骑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词 其二","author":"宋无","text":"条脱金寒翠袖冰，羊车梦里辘轳声。\n薰炉宿得沈香火，暖却春纤暖玉笙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题效李商隐","author":"宋无","text":"妆浅颦深凭绮疏，小郎新拜执金吾。\n弦中言语分明怨，裀上腰肢准拟扶。\n翠履鸳寒慵斗草，红牙马暖罢樗蒱。\n无人商略心头事，潜向花间卜紫姑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旱乡田父言","author":"宋无","text":"疲牛病喘饿桑间，碌碡閒眠麦地乾。\n残税驱将儿子去，豆畦却倩草人看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"啽呓集诗王蠋","author":"宋无","text":"全齐拱手受燕兵，义士谁为国重轻？\n七十二城皆北面，一时发愤独书生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"甘罗","author":"宋无","text":"函谷关中富列侯，黄童亦僭上卿谋。\n此时园绮犹年少，甘隐商山到白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曹瞒","author":"宋无","text":"奸雄睥睨鼎终移，筑舍谯东志竟赍。\n若使人生尽如意，墓门应表汉征西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]