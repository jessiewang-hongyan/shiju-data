[{"title":"十一月二十七日冬至","author":"朱德润","text":"捲地颠风响怒雷，一宵天上报阳回。\n日光绣户初添线，雪意屏山欲放梅。\n双阙倚天瞻象魏，五云书彩望灵台。\n江南水暖不成冻，溪叟穿鱼换酒来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又和顾仁甫观潮","author":"朱德润","text":"候潮翻雪响泷泷，砥柱中流势激撞。\n岂有明珰遗洛浦，欲投圆璧誓长江。\n雪涛杂沓蜃楼起，海峤微茫雁字双。\n莫讶伍胥遗恨在，越山南去未成降。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题子明雪泉","author":"朱德润","text":"万壑轻澌渡薄寒，碧云深处互漫漫。\n六花溅沫成天巧，一脉潜流激暮湍。\n石鼎茶温风味冽，玉壶冰皎露华乾。\n荆溪白石天寒夜，误作山阴道上看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江","author":"朱德润","text":"堤边古木风，江上飞鸿影。\n秋江待渡人，立到前山暝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过西山","author":"朱德润","text":"黄尘飞白日，黑雨洗青山。\n水静渔舟渡，林深倦鸟还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓晴","author":"朱德润","text":"天寒欲晴犹雨，晓色将明未明。\n万里碧云平野，一林落叶无声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访刘道士","author":"朱德润","text":"春入山坳长蕨芽，青童邀我饭胡麻。\n野桃开处仙家近，閒向溪头数落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵仲穆揩痒马图","author":"朱德润","text":"渥洼天马骨如龙，散步春郊苜蓿中。\n揩遍玉鬉尘未落，日斜宫树影摇风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王信仲过淮阳","author":"朱德润","text":"春江拍拍去帆孤，树底人家燕引雏。\n曾向秦淮登暮阁，碧云低处认三吴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李□古御史柏山","author":"朱德润","text":"缑山无侣共吹笙，金碧楼台拂晓行。\n帝子不来春又暮，野棠开尽绿阴生。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪竹双雉图","author":"朱德润","text":"雪压林梢竹倒垂，石边双雉欲惊飞。\n天寒野静寻馀粟，犹胜樊笼刺锦衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹鹁鸽图","author":"朱德润","text":"深院朱阑覆锦裀，百花开尽牡丹春。\n粉毛双鸽多驯狎，对浴金盆不避人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮阴梅鼎画蜀山图","author":"朱德润","text":"西望巴江隔锦官，青泥黄栈细盘盘。\n人间到处羊肠险，何必长歌《蜀道难》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题甘泉宫图","author":"朱德润","text":"汉郊五畤答鸿禧，草木甘泉夜色移。\n昨日长安道傍过，故宫无奈黍离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梨花折枝","author":"朱德润","text":"玉压帽檐花底春，惜无花下洗妆人。\n阿娇一掬东风泪，聊仗丹青为写真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月二十日送姜侍郎南游","author":"朱德润","text":"京城花雨晓沾沾，陌上红娘已浴蚕。\n无奈金鞍少年客，携将春色过江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西兴","author":"朱德润","text":"八月海门天气凉，潮头如雪上钱塘。\n斜阳更比归人急，又引轻帆入富阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宜兴山行值雨","author":"朱德润","text":"溪行六月不知暑，竹鸡飞度鸣钩辀。\n黑云行天捲雨去，老树忽作千山秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元二年二月八日陈子善范昭甫同游虎丘四首 其一","author":"朱德润","text":"东望吴山紫翠缠，凭阑忽坐小吴轩。\n石桥杨柳半塘寺，修竹梨花金氏园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元二年二月八日陈子善范昭甫同游虎丘四首 其二","author":"朱德润","text":"蔓木丛篁古梵寒，凿开崖窦见波澜。\n莫邪久化苍龙去，犹作东吴剑气看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元二年二月八日陈子善范昭甫同游虎丘四首 其三","author":"朱德润","text":"碧鸡银甃锁吴娃，台阁千年属梵家。\n不见金精化为虎，日斜荒冢乱啼鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元二年二月八日陈子善范昭甫同游虎丘四首 其四","author":"朱德润","text":"野色空濛锦鴂啼，东风吹雨湿罗衣。\n一堤芳草花开遍，落日马嘶人醉归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拜郊台晚渡","author":"朱德润","text":"风飏松花落涧滨，荻芽洲渚水鳞鳞。\n莫教行到崇台上，忘却山前唤渡人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"朱德润","text":"索索西风白露零，隔林砧杵助秋声。\n欲寻隐者门前路，落叶漫山碍屐行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郝道□","author":"朱德润","text":"长江日夜向东流，送子西津晓渡头。\n却忆望京楼下路，一宵风雨酿新秋。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天岳图歌","author":"陈泰","text":"知君重毫素，好手不可遇。\n壮哉昆崙方壶图，对此兴与精灵聚。\n云来气接巫峡长，影动倒景摇潇湘。\n湘妃汉女出歌舞，矫如群帝参龙翔。\n大江东流去，忽在天一方。\n初月出不高，照我征衣裳。\n忆昔北寻小有洞，青枫叶赤天雨霜。\n先生有道出羲皇，晚有弟子传芬芳。\n神仙中人不易得，今我不乐思岳阳。\n蔡侯静者意有馀，戚联豪贵耽文儒。\n致身福地何萧爽，几岁寄我空中书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题薛玄卿琼林台","author":"杜本","text":"上清山灵都，凡山无与俦。\n况兹琼林台，云气接神州。\n岳祇扶地轴，鬼神动天球。\n珠树粲瑶墄，玉衡悬清秋。\n层冰积高寒，梯构靡其由。\n外史洞玄化，于焉采真游。\n珊珊紫霞佩，皎皎明月钩。\n手携千岁藤，足弄万里流。\n仰观玄圃运，俯视八极周。\n缅彼大瀛海，变灭多浮沤。\n悠然发舒啸，永矣此夷犹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武当山张真人奉诏祷雨有应","author":"杜本","text":"祈禳致风雨，传说自古先。\n京师大旱连二年，地蒸热气如云烟。\n林林嘉木尽槁死，毋论黍稷生秋田。\n武当真人张洞渊，为道有心如铁坚。\n粗衣恶食夜不眠，两眼奕奕光射天。\n天子有敕丞相宣，诏君祷雨纾忧煎。\n君坐默不语，奏达虚皇前。\n将吏驱蛟龙，雷电相后先。\n童童雨脚昼夜悬，平地涌水如通川。\n稚禾出土芃芃然，小草大木争芳妍。\n都人士女喜欲颠，谓君直是真神仙。\n我今为作喜雨篇，勒诸厓石千年传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山同诸学士为祝丹阳赋 其一 鍊丹井","author":"杜本","text":"凿石通泉脉，铸鼎鍊丹砂。\n丹成骑鹤去，满地生云霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山同诸学士为祝丹阳赋 其二 逍遥岩","author":"杜本","text":"鹏抟九万里，篱鴳飞咫尺。\n所以达观人，亦各适其适。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山同诸学士为祝丹阳赋 其三 玉帘泉","author":"杜本","text":"灿烂金为屋，玲珑玉作帘。\n飞泉来百道，定有老龙潜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山同诸学士为祝丹阳赋 其四 石人峰","author":"杜本","text":"临风衣自整，对月影偏长。\n独立经寒暑，真成石作肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山同诸学士为祝丹阳赋 其五 小隐岩","author":"杜本","text":"山深人寂寂，涧曲水沄沄。\n顾尔非忘世，遗身在白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吉学士墨梅","author":"杜本","text":"冰雪肌肤铁石肠，翩翩和月按《霓裳》。\n临窗喜见横斜影，却有王孙翰墨香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题江村图","author":"杜本","text":"树林蓊蔚水萦环，知是江南何处山。\n几载幽并倦行役，按图欲借屋三间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题小景","author":"杜本","text":"秋云满地夕阳微，黄叶萧萧雁正飞。\n最是江南好天气，村醪初熟蟹螯肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题道士许冰壶游维扬诗卷","author":"杜本","text":"淮南秋月漾清波，照彻冰壶秋气多。\n二十四桥春似海，羡君骑鹤数经过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和何得之岁暮见寄","author":"杜本","text":"篱下菊斑斑，犹能傲岁寒。\n春风谁主宰，客梦自清安。\n此老怜才乏，何人惜夜阑。\n管宁如可友，浮海竟谁叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题竹轩","author":"杜本","text":"绿竹翛翛处，华轩楚楚深。\n莫留雏凤宿，晓听蛰龙吟。\n月进窗棂影，云移几席阴。\n居然淇澳趣，莫使俗尘侵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和潘明之","author":"杜本","text":"欲试淮南术，难期海上翁。\n自为吴地客，不记楚人风。\n蒲黍随时白，葵榴过眼红。\n独醒还独醉，至竟与谁同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春遣怀","author":"杜本","text":"东风吹尽满林花，底用无涯始有涯。\n饮量素悭难止酒，客怀虽恶少思家。\n已谙世味荼如荠，未信仙人枣似瓜。\n为爱绿阴春昼永，出门转觉换年华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋寄高混朴","author":"杜本","text":"去年见月转添愁，满地于戈未肯休。\n动有万人涂草莽，岂论斗米换衾裯。\n今宵相对还青眼，后夜相逢又白头。\n尤恨故人难会合，若为把酒独登楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴","author":"杜本","text":"两峰高耸并秋霄，双涧分流送晚潮。\n月冷谁家频捣练，风清何处细吹箫。\n七闽荔子丹砂颗，五岭梅花玉雪标。\n黄鹄不来空怅望，自歌雅曲和渔樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李伯循","author":"杜本","text":"已闻盘谷最深幽，便欲从君遂此游。\n春气和柔朝采药，秋风清彻夜行舟。\n岩花冉冉难留客，汀草纤纤独倚楼。\n杨柳新条不堪折，只须买酒换离愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵伯常归扬州","author":"杜本","text":"往年初记抵京师，正类机云入洛时。\n未说鳌头分赤管，先传马首控青丝。\n琼楼旧醉家家酒，金刹新题处处诗。\n此日扬州归去路，锦衣光采照城池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨仲弘","author":"杜本","text":"老来自爱黄叔度，少日真期鲁仲连。\n高卧独无田二顷，曳裾谁有客三千。\n苍波渺渺浮鸥鹭，白日翩翩换岁年。\n却忆江东杨少尹，剧谈终夜不成眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬虞伯生","author":"杜本","text":"满窗风雨夜沈沈，独对青灯万古心。\n徒有故人怜白发，自无奇骨换黄金。\n茅檐暖日须看献，竹简遗经正用寻。\n岂愧执鞭非所好，甘随麋鹿放山林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周南翁悠然阁","author":"杜本","text":"大江之东彭蠡南，周家高阁与云参。\n秋风猿狖啼青嶂，暮雨蛟龙起碧潭。\n绕屋千丛生杞菊，过檐百尺长楩楠。\n何时共此登临乐，指点山川与纵谈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"廉州阻风","author":"杜本","text":"自因三宿致绸缪，岂为狂风殢客舟。\n乡国十年思旧雨，河山千里记前游。\n黄云酿雪禾将刈，绿雾笼霞橘渐收。\n离别不堪成怅望，雁孤飞起白蘋洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔隐图诗为程子纯赋","author":"杜本","text":"山下白云缥缈，水边红树依稀。\n信有桃源深处，渔人今亦忘归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题柯敬仲梅","author":"杜本","text":"点点苔枝缀玉，疏疏檀蕊凝香。\n还记当年月色，箫声暗度宫墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渊明","author":"方澜","text":"郑声与雅乐，今我并无弦。\n尚不归莲社，谁能爱秫田。\n青山栗里宅，白发义熙年。\n嵇阮能逃世，终非出自然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆轲","author":"方澜","text":"计出不可测，襟期相激昂。\n悲风寒易水，侠气小咸阳。\n六国群谋失，三军一匕当。\n英雄幸不幸，愁入代云长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金山寺","author":"方澜","text":"江心胜绝处，人饮不知源。\n楚浪夜喧寺，浙山晴到门。\n清寒入僧梦，太古结云根。\n欲问前朝事，松风若有言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早秋夜坐","author":"方澜","text":"万星都让月，势不并光芒。\n尘陌闻钟静，风庭洒顶凉。\n明河西落野，飞露下沾裳。\n但息人间累，仙乡不离房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日钱塘纪事二首 其一","author":"方澜","text":"吴越南去远，万峰青照杭。\n江流拍岸阔，海气入城凉。\n落日菰蒲暗，行人禾黍香。\n天开地辟后，知历几兴亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日钱塘纪事二首 其二","author":"方澜","text":"阜物家家市，濒湖处处园。\n童时今父老，梦里古乾坤。\n佛石千像在，风潮万马奔。\n谁予指新路，梧落故宫垣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夕有感","author":"方澜","text":"摇落秋渐晚，露香篱下花。\n疏钟出烟寺，新月入人家。\n蛩语日夜急，雁飞天汉斜。\n蹇余不能去，尘世事如麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初冬作","author":"方澜","text":"泬寥萧瑟后，霁色却怡人。\n霜已千林曙，天犹十月春。\n黄花蝶过晚，白苇雁衔新。\n野性自夷旷，非关绝世尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海陵道中","author":"方澜","text":"漠漠平楚远，扣舷歌昔游。\n风颠碧海岸，春老绿蘋洲。\n自古利名急，更东天地浮。\n客心不自得，落日傍渔舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石门夜泊","author":"方澜","text":"积雨暮天豁，炊烟隔林起。\n人喧落帆处，野语新月里。\n桑径绿如沃，麦风寒不已。\n一夕舟相衔，扰扰利名子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日遣怀","author":"方澜","text":"陆续画船去，晓风料理人。\n泥香燕嘴草，路煖马蹄尘。\n海色曈昽日，花光撩乱春。\n浮生孰无事，惜取自由身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幻住庵听松轩","author":"方澜","text":"不与俗同调，风生高树林。\n老僧无法说，满院但潮音。\n人静野禽下，雨凉山叶深。\n悠然悦天籁，宛自是閒人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过吴江","author":"方澜","text":"离离远村落，晴不见炊烟。\n秋水涨无岸，野舟撑入田。\n天留新稼穑，人恋旧山川。\n不待鸿飞定，西风已肃然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玄妙观访刘澹然","author":"方澜","text":"仙扉晓更寂，香霭石狻猊。\n日出松杉外，风来殿角西。\n筼筜沐雾湿，薜荔压墙低。\n林下非无趣，浮生万不齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴四首 其一","author":"许谦","text":"秋日常苦短，秋夜不可阑。\n叶鸣迅风晚，虫怨零露寒。\n月白天炯炯，振衣起盘桓。\n山川出浮滓，翳彼明不完。\n幽兴中道绝，百感来无端。\n何当诛丰隆，致身无羽翰。\n清光亦何私，不照方寸丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴四首 其二","author":"许谦","text":"猗猗澧有兰，馥馥沅有芷。\n猎猎石上蒲，泛泛水中芰。\n鲜鲜三径菊，旎旎百亩蕙。\n采掇集众芳，粲烂成杂佩。\n佩服何所从，将以待君子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴四首 其三","author":"许谦","text":"春风荣众芳，秋露悴百草。\n羲和策日月，疾急两飞鸟。\n枯桑号天风，俯仰波浩渺。\n气流物随化，金石不自保。\n人生寄蜉蝣，时迈胡不老。\n天地有终穷，微眇何足道。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴四首 其四","author":"许谦","text":"乾坤无停运，清气日夜生。\n人居覆载閒，所息能不萌。\n握机养天和，持守如捧盈。\n得丧固有命，宠辱何足惊。\n一身磐石重，万钟浮云轻。\n丈夫有志愿，谁为吾无成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"华盖山","author":"许谦","text":"群山如斗形，华盖气独壮。\n奋身地势高，目极天宇旷。\n周回万象澄，一一来献状。\n中江漾孤屿，濒海横叠嶂。\n楼台市中居，棋列相背向。\n烈风搅沧林，落日鸣白浪。\n蜃气薄浮云，溟濛杳东望。\n长濠浸寒水，短楫起渔唱。\n同游岂特达，竟尔忘得丧。\n山下出蒙泉，夷坐待清涨。\n一掬襟怀空，自谓羲皇上。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]