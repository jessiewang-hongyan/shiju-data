[{"title":"岳阳楼待渡","author":"高思恭","text":"楚水凝千里，湘云隔万层。\n城高秋浦月，星杂夜船灯。\n旅况天谁管，年光雁可凭。\n殷勤淡山色，相送过巴陵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有怀袁季源","author":"周密","text":"江楼深夜倚，凉入鬓萧萧。\n人隔东西浙，心随早晚潮。\n风高孤月晕，河澹万星摇。\n欲寄今宵意，新鸿不可招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渊明画像","author":"顾济","text":"无钱犹爱菊，有酒即横琴。\n万石醉不了，一名閒到今。\n径松存老节，门柳积秋阴。\n人画归来像，谁传归去心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客舍怀余成季","author":"汪仁立","text":"夕阳在青山，山高夕阳早。\n美人未归来，山外浮云好。\n稚子候门前，酒熟黄花老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江桥树","author":"阮鲁瞻","text":"江桥树，荏苒年华暮。\n迎得行人来，送得行人去。\n落叶成秋风，秋风在何处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"歌白苧","author":"李仲南","text":"娇如花，美如玉，越溪女儿十五六。\n光风入帘睡初足，起画脩眉远山绿。\n飞香走红三月心，一声白苧千黄金。\n高堂客散灯火深，醉鬓斜钗夜沈沈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜夜曲","author":"李仲南","text":"玉窗结怨歌幽独，弦绝鸾胶几时续。\n铜龙漏促春夜长，冷雨酸风乱心曲。\n閒薰翠被郁金香，拂拭绣枕屏山绿。\n飞飞乳燕归复迟，寂寞流苏帐前烛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏小小歌","author":"辛文房","text":"东流水底西飞鱼，衔得钱唐纹锦书。\n几回错认青骢马，著处閒乘油壁车。\n鹦鹉杯残春树暗，葡萄衾冷夜窗虚。\n莲子种成南北岸，苦心相望欲何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晓行","author":"张嗣行","text":"梦魂短短春宵残，喈喈鸡语催征鞍。\n东方彷佛淡烟晓，柳露细拂征衫寒。\n僮仆前行指予路，那个长亭经某处。\n离情莽莽不分明，黯澹孤村半烟树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日","author":"唐玉潜","text":"万花正开风雨恶，晓起新晴花正落。\n老夫未起失芳期，赏心但觉随年薄。\n今年花落明年开，去年看花人不来。\n死生荣悴俱可哀，绿阴满地成苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江南曲","author":"史紫薇","text":"风凄露冷江南岸，瑟瑟寒波秋练练。\n采莲歌断红云空，蘋叶芦花结新怨。\n鸳鸯鸂鶒俱可怜，相呼相倚沙觜眠。\n白头渔父摇苍烟，一双飞上枯树巅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王守之断肠曲","author":"杜元","text":"桃花夹堤春水滑，棹歌三叠行舟发。\n行舟去去东复西，几度桃花二三月。\n花前一别一回老，相思日多欢乐少。\n君重黄金轻别离，黄金买得少年时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得金盘露送宋显夫佥事之山南","author":"程益","text":"凤城仙客来扬州，便当解此千金裘。\n丹丘夜出玛瑙瓮，洞庭春泛瑶华舟。\n看花路入竹西寺，吹箫人倚桥边楼。\n船头对月且独饮，锦袍明日金陵游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄雪窦寺生书记","author":"印秋海","text":"清泉白芦八月秋，宽鞋瘦策十日游。\n石床风冷夜不寐，冰丝绕指白雪流。\n身名杳杳云间鹄，世事纷纷蕉下鹿。\n雨晴春暖即相寻，千尺岩头看飞瀑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其一 翠袖啼痕","author":"黄伯旸","text":"石竹绣罗双袂单，绮窗日暮笼轻寒。\n秋波滉漾落铅水，相思几点春斑斑。\n脂浓粉腻半尘土，玉臂娇柔懒轻举。\n东风十日吹不乾，六曲阑边海棠雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其二 黛眉颦色","author":"黄伯旸","text":"落花雨歇春日西，杨柳锁烟莺乱啼。\n玉人缄恨不能语，两蛾对蹙春山低。\n离愁一味如尝胆，额上兰煤香半减。\n风流京兆知不知，他日归来看浓淡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其三 月奁匀面","author":"黄伯旸","text":"扬州青铜出深井，粉绵拂拭冰光冷。\n妆楼笋指揉红玉，素娥飞出娇相并。\n樱唇敛气不敢呵，脂浓粉淡劳揩磨。\n双鸾掩罢出门去，一阵落花红雨过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其四 水盆沐发","author":"黄伯旸","text":"井花满注玻瓈绿，一片春澌瑩如玉。\n晴窗解下十八鬟，三尺青丝漾寒渌。\n兰膏洗尽香腻消，满手绿苔新带潮。\n露蝉翅湿飞不起，花雾晓收红日高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其五 绣床凝思","author":"黄伯旸","text":"碧纱如雾针如芒，茜红绒索三尺长。\n越罗幅宽金缕细，绿波飞起双鸳鸯。\n匿兰含蕙春无语，一寸柔肠千万绪。\n青鸾锦字期不来，恨满城南杏花雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其六 金钱卜欢","author":"黄伯旸","text":"宝猊爇香蟠紫烟，玉葱拈出双团圆。\n春心一点怕人识，举头暗语苍苍天。\n欲掷未掷还再祝，声动瓠犀三十六。\n小桃开后是归期，分付阴阳莫翻覆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其七 香尘春迹","author":"黄伯旸","text":"七宝方床冰漾洁，软粉半铺紫檀屑。\n凌波小袜晓痕轻，一钩浅印纤纤月。\n金莲衬步身欲浮，雁沙踏破春应羞。\n赢得纤腰柳枝瘦，珍珠百斛知谁收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其八 霜杵秋声","author":"黄伯旸","text":"青娥筛空冰粉乾，石光如镜歊清寒。\n更长月白响不绝，碧梧惊起双栖鸾。\n堂上阿姑身未煖，千音万韵劳玉腕。\n要使离人枕上听，凭仗西风莫吹断。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁曲 其一","author":"黄伯旸","text":"与君生别离，朱帘长不开。\n春风故相撩，燕子双归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁曲 其三","author":"黄伯旸","text":"昨夜海棠花，睡足西窗雨。\n春梦若无凭，知在阿谁处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁曲 其四","author":"黄伯旸","text":"下阶拜新月，空庭夜如水。\n相思隔千里，未有团圆意。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其一 金盆沐发","author":"钱抠","text":"一片香云湿不飞，翠光浮动影娥池。\n盈盈蝉翅含风冷，剪剪鸦翎带雨垂。\n泉沫乱跳珠错落，指尖微露玉参差。\n妆成倦把阑干倚，滑堕金钗不自知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其二 月奁匀面","author":"钱抠","text":"春尽花枝瘦几分，晓妆不觉暗销魂。\n羞娥谩自横眉黛，薄粉何由掩泪痕。\n青岁不留人易老，翠鸾飞去影空存。\n愁来拍塞成长叹，嘘得清光惨欲昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其三 玉颊啼痕","author":"钱抠","text":"愁思无心整玉容，几番花下立东风。\n渍残娇靥娟娟翠，界破蜂黄缕缕红。\n罗袂揾时香欲溢，春纤抹处晕微融。\n小环欲解人憔悴，笑指梨花暮雨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其四 黛眉颦翠","author":"钱抠","text":"闷拽罗裙下玉除，小桃花下立踟蹰。\n几分春色伤心处，一点梅酸溅齿初。\n山蹙空青浑欲暝，柳缄寒绿未全舒。\n龙沙北睇三千里，倚遍阑干思有馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其五 芳尘春迹","author":"钱抠","text":"按舞霓裳点拍频，紫鸾箫底步香尘。\n故将罗袜双钩玉，踏破红云一片春。\n残月淡笼烟漠漠，并鸳交卧水粼粼。\n莫教燕子衔将去，留向东风拟洛神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其六 云窗秋梦","author":"钱抠","text":"桂花香冷夜沈沈，睡熟银屏小凤衾。\n杳杳不辞湘水远，悠悠直过楚云深。\n红椒树底鸳鸯比，黄叶风前蟋蟀吟。\n预报砧声莫惊觉，暂容摅尽别离心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其七 绣床凝思","author":"钱抠","text":"绿窗人静昼厌厌，抛却金针懒再拈。\n香脸托残红一线，黛眉颦蹙翠双尖。\n愁如乱絮随风落，恨似飞花带雨粘。\n小玉谩将帘幕捲，忍看双燕拂雕檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香奁八咏 其八 金钱卜欢","author":"钱抠","text":"宝鸭香飘篆缕浮，金钱倒掷思悠悠。\n云边昨夜闻归雁，花外何时听紫骝。\n幸得如期犹慰意，若为归晚更添愁。\n无凭莫似檐前鹊，几度空教倚画楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春昼","author":"梁彦中","text":"溪水摇光动綵墙，云山倒影蘸霞觞。\n一庭芳树清阴薄，千尺游丝白日长。\n风细柳塘莺语滑，泥融花径燕飞忙。\n乾坤俯仰窥难尽，花柳无私种种香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潮","author":"仇仁远","text":"一痕初见海门生，顷刻长驱作怒声。\n万马笑围天鼓碎，六鳌翻背雪山倾。\n远朝魏阙心犹壮，直到严滩势始平。\n寄语吴儿休踏浪，天吴罔象正纵横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅","author":"仇仁远","text":"为怕缁尘著素衣，冻痕封蕊放香迟。\n月来忽送阑干影，春到不分南北枝。\n唤梦翠禽依树宿，销魂玉笛隔花吹。\n从他万片随风去，须有青青叶底时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泪","author":"施钧","text":"獭髓空劳补旧痕，离筵歌罢忽沾巾。\n半江湘竹斑斑雨，三月杨花点点春。\n字湿锦机啼戍妇，珠明绡室泣鲛人。\n琵琶滴罢情深处，洗尽青衫几掬尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武昌南楼","author":"施钧","text":"鹦鹉洲边舣客舟，宪君邀我上南楼。\n胡床老子三更月，铁笛仙人一曲秋。\n流水白云吴夏口，西风黄鹤晋矶头。\n如今尽属王孙草，添得江南几许愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人归天台","author":"施钧","text":"君去丹山伴赤霞，忍分书剑各天涯。\n交情十载共为客，归梦几番同到家。\n一路暖云蒸药气，半溪流水引桃花。\n金庭好问长生诀，莫待秋风两鬓华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"红梅","author":"金德启","text":"醉卧西湖处士家，梦回惟见赤城霞。\n纵然冷艳随春变，依旧疏枝映日斜。\n姑射冰姿凝绛蜡，罗浮雪骨换丹砂。\n北人惯在江南住，犹说前村有杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"猫","author":"唐珙","text":"觅得狸奴太有情，乌蝉一点抱唇生。\n牡丹架暖眠春昼，薄荷香浓醉晓晴。\n分唾掌中频洗面，引儿窗下自呼名。\n溪鱼不惜朝朝买，赢得书斋夜太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过洞庭","author":"唐珙","text":"玉箫吹老洞庭波，一夜湘君白发多。\n醉后不知天在水，满船清梦压星河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都中寒食","author":"杨鹏翼","text":"芳草青青湖上路，少年游冶不知回。\n烟花一望春无尽，云水相参雨欲来。\n夕浪放船重听乐，天风吹酒独登台。\n看图万里逢寒食，车马倾城起暮埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤骨笛","author":"贾策","text":"九皋声断楚天秋，玉顶丹砂一夕休。\n枯朽挽回生死调，凄凉吹尽古今愁。\n魂归辽海云迷树，曲罢江城月满楼。\n惆怅主人三弄罢，杳无消息到扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"碧筒酒","author":"赵君谟","text":"擎波老干折苍璚，酣饮何如吸海鲸。\n象鼻捲冰收玉醴，翠盘承露落金茎。\n几丝香溜葡萄滑，九窍春浓琥珀倾。\n莫恋醉乡心更苦，独醒衣上为谁清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绿阴","author":"周石原","text":"万紫千红梦已休，眼中惊见翠光浮。\n数声啼鸟无寻处，几度斜阳不入楼。\n润透琴书浑欲雨，凉生衣袂已先秋。\n此时蒲柳还多感，莫遣西风一夜愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉武帝","author":"徐秋云","text":"万户千门禁漏迟，建章花发锦成帏。\n瑶池有信青鸾至，金屋无人白燕飞。\n风起轮台春寂寂，露零仙掌月辉辉。\n楼前箫鼓繁华梦，汾上年年只雁归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唐明皇","author":"徐秋云","text":"太平风月属三郎，羯鼓声中思转长。\n天子锦缠娱虢国，贵妃音律教宁王。\n人归巫峡山空在，花落温泉水更香。\n谁信蓬莱青鸟使，回来无语怨渔阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"商山四皓图","author":"普彦明","text":"刘氏何如吕氏安，尺书便尔闯重关。\n空将鬓雪惊隆准，不道啼红惨玉颜。\n鸿鹄声寒悲晓殿，紫芝香冷怨秋山。\n千年犹昧深根术，又落巴童橘树间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乙未二月十九日喜雪适间道有赍至托克托太师出征诏因赋","author":"袁泮","text":"纷纷朔雪南飞夜，万里山河总汉朝。\n铁马渡江春阵合，玉龙吹海曙光摇。\n中天气正妖氛豁，南国春深瘴疠消。\n最喜天威行肃杀，布衣无分乐渔樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送许鲁斋归山","author":"张易","text":"语相累累入省闱，先生何事独西归。\n心随道隐贫非病，老得身閒古亦稀。\n行色一杯燕市酒，春风二月楚山薇。\n到家已及蚕生日，布谷催耕陇麦肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送复上人游吴","author":"熊太古","text":"二月钟陵花满烟，袈裟东上木兰船。\n地浮彭蠡江声转，山入姑苏海气连。\n千里从师应未晚，五湖为客谩多年。\n遥知后夜相思处，坐看中天好月圆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送妓入道","author":"段天佑","text":"歌舞当年第一流，洗妆今日别青楼。\n便从南岳夫人去，肯为苏州刺史留。\n琳馆月明箫凤下，锁窗花老镜鸾收。\n却怜愁绝浔阳妇，嫁得商人已白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄道士甘益谦","author":"江中称","text":"梅花满树雪晴初，短发经秋不奈梳。\n匣拂绿尘看古剑，朱研清露勘残书。\n霜寒楚岫猿声远，月冷秦关雁影疏。\n却忆道人无一事，紫云深处好楼居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陇头水","author":"周到坡","text":"陇头水，呜咽鸣。\n行人听，断肠声。\n陇头水，鸣呜咽。\n行人泪，眼中血。\n月薄塞云低，行人到此心伤悲。\n世间万水东流去，陇水分流独向西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四禽言 其一","author":"梁栋","text":"不如归去，锦官宫殿迷烟树。\n天津桥上一两声，叫破中原无住处。\n不如归去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四禽言 其二","author":"梁栋","text":"脱却布裤，贫家能有几尺布。\n织尽寒机无得裁，可人不来廉叔度。\n脱却布裤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四禽言 其三","author":"梁栋","text":"行不得也哥哥，湖南湖北春水多。\n九疑山前叫虞舜，奈此乾坤无路何。\n行不得也哥哥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江州庾楼","author":"贺复孙","text":"宿鸟归天尽，浮云薄暮开。\n淮山青数点，不肯过江来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水仙花 其一","author":"商挺","text":"海上三山璧月明，人间谁识许飞琼。\n秋风吹上青鸾背，未散天香与素英。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水仙花 其二","author":"商挺","text":"明月珠衣翡翠裳，冰肌玉骨自清凉。\n不随王母瑶池去，来侍维摩病几旁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山峡图","author":"滕斌","text":"萧萧十二峰前路，月落猿啼霜外树。\n半夜谁家上水船，竹枝歌入瞿塘去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"冯翼","text":"竹外斜阳卖酒家，雨馀红杏压枝斜。\n天涯无限伤春意，自向风前拾落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶书","author":"孟芾","text":"锦衣公子马如龙，射雁归来半醉中。\n过尽好春浑不管，扬鞭閒弄柳花风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日杂咏","author":"图克坦公履","text":"东风帘幕半尘埃，歌舞台空昼不开。\n试问双飞新燕子，今年社日为谁来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋思","author":"孙存吾","text":"雁落西风字字沈，嫩凉偷入藕花心。\n眼前多少关心事，付与寒螀彻夜吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏李泣别图","author":"李竹所","text":"我去君留可奈何，明朝烟雨隔关河。\n当年胡妇分携处，想见中郎泪更多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关山风雨图","author":"张础","text":"山雨凝寒气不开，江涛拍岸雪成堆。\n渔翁惯识风波恶，天际孤舟已早回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄余承庆","author":"杨元正","text":"衮衮红尘客未归，秋风吹老芰荷衣。\n几回欲寄相思字，不见潇湘一雁飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]