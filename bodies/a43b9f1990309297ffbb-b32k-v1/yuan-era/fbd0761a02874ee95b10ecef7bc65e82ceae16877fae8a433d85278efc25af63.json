[{"title":"绿珠","author":"宋无","text":"红粉捐躯为主家，明珠一斛委泥沙。\n年年金谷园中燕，衔取香泥葬落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李三郎","author":"宋无","text":"独跨青骡栈阁间，华清休忆夜鸣銮。\n空教万马盘旋舞，不济崎岖蜀道难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐佐卿","author":"宋无","text":"化作辽东羽翼回，适逢沙苑猎弦开。\n宁知万里青城客，直待他年箭主来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张建封妾盼盼","author":"宋无","text":"妾未成灰鬓已霜，啼红十载唾茸窗。\n香魂若作楼中燕，一世孤飞不肯双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李国主","author":"宋无","text":"春花秋月满雕阑，便到江南亦梦间。\n近日何尝事汤沐，只将清泪洗朱颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王介甫","author":"宋无","text":"投老归耕白下田，青苗犹未罢民钱。\n半山春色多桃李，无奈花飞怨杜鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖","author":"宋无","text":"故都日日望回銮，锦绣湖山醉里看。\n恋著销金锅子暖，龙沙忘了两宫寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秦少游女","author":"宋无","text":"郎罢藤阴老泪潸，黄金谁赎蔡姬还。\n看来山抹微云恨，直送蛾眉出汉关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岳武穆王","author":"宋无","text":"尅复神州指掌间，永昌陵侧诏师还。\n丹心一片栖霞月，犹照中原万里山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陆君实","author":"宋无","text":"六鳌海上失乘舆，天柱臣难只手扶。\n应有二妃魂尚在，至今何处望苍梧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贾琼妻韩氏","author":"宋无","text":"国破家亡泣血吟，千年不与妾同沈。\n中流定有当时泪，滴作江声哭到今。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题龚翠岩中山出游图","author":"宋无","text":"酆都山黑阴雨秋，群鬼聚哭寒啾啾。\n老馗丰髯古幞头，耳闻鬼声馋涎流。\n鬼奴舆馗夜出游，两魑剑笠逐舆后。\n槁形蓬首枯骸瘦，妹也黔面被裳绣。\n老馗回观四目斗，料亦不嫌馗丑陋。\n后驱鬼雌荷衾枕，想馗倦行欲安寝。\n挑壶抱瓮寒凛凛，毋乃榨鬼作酒饮。\n令我能言口为噤，执缚魍魉血洒胯。\n毋乃剁鬼□鬼䱹，令我有手不能把。\n神閒意定元是假，始信吟翁笔挥洒。\n翠岩道人心事平，胡为识此鬼物情。\n看来下笔众鬼惊，诗成应闻鬼泣声。\n至今卷上阴风生，老馗氏族何处人？\n托言唐宫曾见身，当时身色相沈沦。\n阿瞒梦寐何曾真，宫妖已残马嵬尘。\n倏忽青天飞霹雳，千妖万怪遭诛击，酆都山摧见白日。\n老馗忍饥无鬼吃，冷落人间守门壁。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郑所南推篷竹卷","author":"宋无","text":"要写秋光写不成，愁凝苦竹淡烟横。\n叶间尚有湘妃泪，滴作江南夜雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"商人妇","author":"宋无","text":"日日湖头望，望夫夫未回。\n无情春水恨，祇送别船来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其一 梢水","author":"宋无","text":"拔碇张篷岂暂停，为贪薄利故轻生。\n几宵风雨船头坐，不脱蓑衣卧月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其二 莺游山","author":"宋无","text":"崖倚波涛顶接空，黄莺游处树成丛。\n莫言山上人希住，多少楼台烟雨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其三 日出","author":"宋无","text":"金乌摇上浪如堆，万象分明海色开。\n遥望扶桑岸头近，小舟撑出柳阴来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其四 东洋","author":"宋无","text":"东溟云气接蓬莱，徐福楼船此际开。\n应是秦皇望消息，采芝何处未归来？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其五 揍沙","author":"宋无","text":"万乘龙骧一叶轻，逆风寸步不能行。\n如今阁在沙滩上，野渡无人舟自横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其六 海鸥","author":"宋无","text":"群飞独宿水中央，逐浪随波羽半伤。\n莫去西湖花里睡，芰荷翻雨打鸳鸯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其七 乳岛","author":"宋无","text":"远望浑如两乳同，近前方信两高峰。\n端相不似鸡头肉，莫遣三郎解抹胸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其八 沙门岛","author":"宋无","text":"积沙成岛浸苍空，古祀龙妃石崦东。\n亦有游人记曾到，去年今日此门中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其九 莱州洋","author":"宋无","text":"莱州洋内浪频高，碇铁千寻系不牢。\n传与海神休恣意，二三升水作波涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十 水程","author":"宋无","text":"九日滩头不可移，九滩一日尚嫌迟。\n何须频问程多少，路上行人口是碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十一 寻䑸","author":"宋无","text":"万舰同䑸在海心，一时相离不知音。\n夜来欲问平安信，明月芦花何处寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十二 抛碇","author":"宋无","text":"千斤铁碇系船头，万丈滩中得挽留。\n想见夜深抛掷处，惊鱼错认月沈钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十三 出火","author":"宋无","text":"前船去速后䑸忙，暗里寻䑸认火光。\n何处笙歌归棹晚，高烧银烛照红妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十四 落篷","author":"宋无","text":"潮信篷留风力悭，落篷少歇浪中间。\n殷勤为向梢人道，又得浮生半日閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十五 走风","author":"宋无","text":"夜飓颠狂浪卷天，深渊多少走风船。\n一宵行尽波涛险，只在芦花浅水边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十六 橹歌","author":"宋无","text":"浪静船迟共一䑸，橹声齐起响连空。\n要将檀板轻轻和，又被风吹别调中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十七 大浪","author":"宋无","text":"吞天高浪雪成堆，摇荡惊心眼怕开。\n深谢波神费工力，几回风雨送将来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十八 探浅","author":"宋无","text":"探水行船逐步寻，忽逢沙浅便惊心。\n蓬莱近处更难遍，扬子江头浪最深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其十九 讨水","author":"宋无","text":"海波咸苦带流沙，岛上清泉味最佳。\n莫笑行人不风韵，一瓶春水自煎茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其二十 讨柴","author":"宋无","text":"海树年深成大材，一时斧伐作薪来。\n山人指点长松说，尽是刘郎去后栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其二十一 直沽","author":"宋无","text":"直沽风月可消愁，标格燕山第一楼。\n细问花名何处出，扬州十里小红楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鲸背吟二十二首 其二十二 自题","author":"宋无","text":"乘兴风波万里游，清如王子泛扁舟。\n早知鲸背推敲险，悔不来时只跨牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢徵君松巢","author":"陈旅","text":"昔闻徵君在天目，松间结巢成久留。\n南荣北郭井里近，西枝东柯村谷幽。\n蕙帐眠深翠露落，石泉酿熟缃花浮。\n拟借丹梯到高处，枳勾桐乳非吾求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"友人记余少作因录之","author":"陈旅","text":"溪村积水生寒烟，书庐睡起清明天。\n隔溪莫哭人饭鬼，塍间烧钱野风起。\n酒旗山前雨疏疏，来禽花低飞鹧鸪。\n荒坟累累出新草，草长如人人又老。\n东门大道青杨间，可怜车马无时閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵毗陵吴寅夫见寄","author":"陈旅","text":"季子江海居，胜友园池赏。\n临水咏新诗，轻飙送流响。\n丹花阳林吐，绮翼幽竹上。\n云澜阻尘躅，离思徒浩漭。\n杪秋辞京邑，寒郭舣吴榜。\n宗兄念行役，旨酒劳鞅掌。\n承子共清悰，论文发豪爽。\n我贫久侨栖，所至类乐广。\n愿得阳羡田，宁惭五湖长。\n夙昔诒约言，迟暮婴世网。\n众仙谅超遥，楼观满方丈。\n馀霞散文席，斜月生翠幌。\n芳夕令人思，思之不能往。\n晨兴即高冈，引睇写孤想。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵陈景忠见寄","author":"陈旅","text":"用世已无伎，高人方据梧。\n词林忝供奉，客舍候徵呼。\n拓落需微禄，骞腾失壮图。\n为文下枚孺，力穑后孙愉。\n春草生湖曲，暮云飞屋隅。\n论交尊有蚁，忆别履非凫。\n拟汎鸱夷舸，重游泰伯都。\n山泉?雪乳，石荈瀹琼酥。\n作鲙溪庖近，听猿野磴纡。\n松风吹绿鬓，花雨落红毹。\n佳什勤相赠，幽期愧独踰。\n烦君语宗长，为我谢寅夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为萧元泰题龙虎山岩图","author":"陈旅","text":"龙虎之山仙所寰，我昔梦寐游其间。\n乾坤风气结冲秀，中有正一玄都坛。\n羽人授我九节杖，林磴窈窕穷幽攀。\n金宫药殿起寥廓，翠崖丹巘深回环。\n峰头时飘白菡萏，石上尽种青琅玕。\n诸岩一览二十四，总似瀛渚蓬莱山。\n清溪浮空引雪练，远岫隔水来烟鬟。\n就中仙岩更奇绝，上有玉树皆檀栾。\n虹光半夜出林杪，云是石室韬神丹。\n欲求刀圭已衰疾，羽人去我如飞翰。\n褰裳涧曲采芳草，断猿疏雨春山寒。\n觉来俗事日满眼，岁月冉冉随惊湍。\n会稽萧氏忽相访，笑以此图令我看。\n梦中羽人貌真似，而我别后鬓毛斑。\n题诗聊复纪畴昔，愿拂尘服齐骖鸾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖上分韵得春字","author":"陈旅","text":"君子佩明信，相期湖水滨。\n时欣宿雨霁，画舸送游人。\n轻鸥集兰渚，佳树变莺晨。\n山远烟容淡，日出水光新。\n美人含丽思，艳曲歌阳春。\n暌携会弥欢，酣适趣益真。\n兹游敦德谊，况乃及芳辰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋山图","author":"陈旅","text":"之子托冲隐，秋山楼观深。\n矧兹及霜晨，遐瞩沈氛阴。\n翠巘含白云，丹枫映青林。\n灵溪鸣石溜，野屋负层岑。\n趋喧事多违，即旷恒惬心。\n何哉芳月宴，而我阻幽寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵许左丞从车驾游承天护圣寺是日由参政升左丞","author":"陈旅","text":"银瓮呈山麓，銮舆际水乡。\n离宫疑馺娑，行殿仿飞翔。\n细浪鱼鳞袭，轻飙鹢首骧。\n扶桑明远岸，析木度高樯。\n屏翳时清跸，丰隆夙启行。\n卫兵环越棘，舞女蹋吴航。\n渐觉仙楼近，微闻梵铎扬。\n石坛登案衍，琼佩杂璆锵。\n夕渚休兰棹，春壶泻桂浆。\n伊蒲颁内供，薝卜散林香。\n罢宴蜺旌动，开帆兽锦张。\n弄田低碧树，驰道出金塘。\n畿甸严车辅，臣邻重室厢。\n方欣麟在棷，复喜凤鸣阳。\n圣主需贤急，嘉猷赖弼良。\n从容承顾问，舄奕拜恩光。\n文采堪华国，芳菲正满堂。\n协忠成泰治，流泽遍遐荒。\n援古言应切，匡时虑更长。\n谁哉疲土木，况乃象为廊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安福李氏临溪亭","author":"陈旅","text":"结屋负南郭，清溪流屋前。\n端居尘事少，水木自幽妍。\n涤砚弄寒泚，鸣琴写潺湲。\n沙鸟时近人，汀云相往还。\n烹鲜芼溪毛，留客坐前轩。\n逝川道体著，观物悟微言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖溧阳溪山图","author":"陈旅","text":"宿雨散层巘，林麓翳烟霏。\n遥山断复连，川上初昕微。\n我昔困行役，溧阳秋未归。\n幽子乔松流，邂逅启郊扉。\n抚景正若此，别离嗟愿违。\n览卷遂终日，溪云欲生衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题天台桃源图","author":"陈旅","text":"天台一溪绿周遭，溪南溪北都种桃。\n东风吹花开复落，游人不来春水高。\n钱塘道士张彦辅，画图送得刘郎去。\n昨夜神鹊海上来，洞里胡麻欲成树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏伯修往上京王君实以高丽笠赠之且有诗伯修徵和章因述往岁追从之悰与今兹暌携之叹云耳","author":"陈旅","text":"往年饮马滦河秋，滦水斜抱石城流。\n青城丈人来水上，揭谢苏王皆与游。\n顾予滥倚桥门席，日斜去坐鳌峰石。\n夜凉共饮明月尊，醉眠更听高楼笛。\n滦河九曲流溅溅，自我不见今三年。\n苏郎又扈属车去，伫望弗及心茫然。\n龙门峡中云气湿，山雨定洒高丽笠。\n别意遥怜柳色深，归心莫为鹃声急。\n不才未许收词垣，赋成何日奏《甘泉》。\n人言凡骨难变化，为我致意青城仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题胡氏杀虎图","author":"陈旅","text":"沙河野黑秋风粗，枣阳戍卒车载孥。\n道旁老虎夕未餔，车中健妇不见夫。\n仓皇下车持虎足，呼儿授刀剚其腹。\n夫骨已断不可续，泣与孤儿餐虎肉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"小混沌","author":"陈旅","text":"大圜县?含清滓，倏忽多事中央死。\n玄精散作万星繠，天椽不堪参堕趾。\n日化七十皇有虺，蜀霤难苴绚材委。\n杀妖壶涿惊弗燬，剡剡灵光照寒汜。\n老龙乘碛用师纪，俾作鱼丽阵中士。\n风云往来江落水，虎臂滩回玉生子。\n缃文素肌温栗理，方叔得之惊且喜。\n羃蒙错绮鐍髹篚，闭门乍观戒贪褫。\n呜呼混沌乃若此，吾终乞之还汝始。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢氏祖孙创澧阳桥","author":"陈旅","text":"涔阳极目云气昏，冲风扬波鼍窟翻。\n湘妃抱琴望虞舜，日暮江竹多啼痕。\n木兰为舟不可渡，谁幻层渊作平路。\n天横夜静牛渚长，海市朝晴蜃楼吐。\n祖孙移山山可移，昔人不信今见之。\n千年犹有召伯埭，白面聚敛嗟何为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海谷","author":"陈旅","text":"归墟谷在渤海东，八纮之水注其中。\n不盈不缩浩无际，吞吐日月含空濛。\n灵鳌于此负山出，上有缥缈金银宫。\n人间相去几万里，弱水满眼多回风。\n琴高来时踏赤鲤，少君归去乘白鸿。\n秦皇到老不得渡，嗟我欲往将焉从。\n子房有孙海谷子，告我有路非难通。\n只随云气相上下，与子共谒扶桑公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"分题得车摇摇送方叔高之官","author":"陈旅","text":"车摇摇，蓟门路。\n高丽骄马不受鞭，方郎得官上车去。\n蓟门南头卢水流，燕姬十五居酒楼。\n弹筝唱歌《折杨柳》，落日车前劝郎酒。\n南陌行人往复来，几人似郎得官回。\n郎车莫驱伤马足，车中本载连城玉。\n车摇摇，邬子洲。\n卖车买船载旗鼓，晴湖风轻闻棹讴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题蒙泉吏隐图","author":"陈旅","text":"世皇昔日收云南，鲸鲵伾伾手所戡。\n乌蒙乌撒腹心地，不有军府谁其监。\n汉廷遣将非充国，累岁屯田无善绩。\n兵骄民犷土不畬，国帑空曾糜万亿。\n大名刘侯文武才，承诏万里诛蒿莱。\n豪蛮尽戢戎垒立，窜卒复还农亩开。\n有泉远出蒙山下，日夜清冰鸣石罅。\n渠分浍决来纵横，土脉浮膏作秋稼。\n府中偫积多如山，陂池种鱼无暵乾。\n已闻舂硙响林际，仍为蓏蔬流圃间。\n刘侯暇日游泉上，宾吏追从意冲畅。\n步随凉影傍高松，坐看晴云起孤嶂。\n朱轓奕奕来瓯闽，丧车遄返黄河津。\n云南战骨横四野，布谷声中荒草春。\n刘侯虽死应愁绝，吟魂空咽泉头月。\n祇今宁谧重谋帅，九原人去无归辙。\n荔支台馆开樽时，剧谈每及西南陲。\n凄凉遗像画图里，对此流涕将奚为？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭陈元麒","author":"陈旅","text":"阿麒能读书，八岁贡京国。\n翱翔公卿间，声誉颇籍籍。\n我家越山南，汝家越山北。\n及我官桥门，见汝长五尺。\n翩翩丹穴雏，五采作毛翮。\n昆崙上瑶树，上有实可食。\n汝胡不此留，而去不可即。\n乃翁携汝来，为汝头尽白。\n辛苦携骨归，江蓠黯愁夕。\n可怜东门吴，任达乃彊释。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈新甫生日出红玉杯饮为赋","author":"陈旅","text":"昆崙东阿含海日，石中玉子如日赤。\n神工夜发昆吾刀，剜作金杯盛酒吃。\n蟠桃初开缑母家，丹露滴如芙蓉花。\n广陵公子酒如海，年年颜色衬朝霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其一 洞庭秋月","author":"陈旅","text":"轩后不张乐，白月照野水。\n泠泠水影中，瑶瑟泣湘鬼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其二 烟寺晚钟","author":"陈旅","text":"西崦生夕霏，归僧度林巘。\n但觉山路长，不觉钟声远。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其三 山市晴峦","author":"陈旅","text":"百货集亥市，莫猺偏买盐。\n山日出未高，翠雨湿酒帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其四 平沙落雁","author":"陈旅","text":"倦翮久欲下，凉风起湖北。\n官客多挟弓，暮近白沙驿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其五 渔村夕照","author":"陈旅","text":"落日楚江深，倒景在高树。\n晒网茅屋头，分鱼石梁步。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其六 远浦帆归","author":"陈旅","text":"南浦草仍碧，高楼日易斜。\n归帆傍水庙，箫鼓下神鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈氏潇湘八景图 其七 潇湘夜雨","author":"陈旅","text":"江气行云暮，忽失巴陵树。\n一夕洞庭波，都向篷上注。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]