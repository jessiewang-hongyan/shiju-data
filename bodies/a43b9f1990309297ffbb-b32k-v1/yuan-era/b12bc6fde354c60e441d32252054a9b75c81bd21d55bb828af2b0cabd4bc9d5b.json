[{"title":"白马篇","author":"何中","text":"冥冥子规林，萧萧绿杨路。\n白马谁家儿，扬鞭西南去。\n去去知何为，不辞还泞苦。\n阴阳速相禅，乾坤几新故。\n丈夫慎驰骛，出门已艰步。\n悠悠独鸟没，雾暗连村树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发东阿午经东平晚宿汶上是日雪","author":"何中","text":"严装齐地晓，投馆鲁乡暮。\n天寒客心速，雪下车声去。\n迷兽出桑畦，流人披野路。\n浅霭须城山，斜桥汶津树。\n前圣有遗业，惝惘经行处。\n荷蓧与耦耕，何其得深趣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登李白酒楼","author":"何中","text":"当时谪仙人，四海蜚英声。\n偶然此一醉，遂有无穷名。\n叔世尊放旷，中度翻为轻。\n颓波浩难返，忧思谁能平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"何中","text":"文藻风流尽，天机定偶然。\n自怜有今日，犹复望他年。\n道远云千里，楼危雪满川。\n春还问消息，好去落梅边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月五日吾族诸老儒服纵游","author":"何中","text":"纵游二十士，远赏物华新。\n好是小兰若，一来中圣人。\n桃源在何处，流水不胜春。\n归路狂歌甚，欹斜乌角巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽寻","author":"何中","text":"意适可幽寻，天空晚气沈。\n鸥飞一川迥，花落五云深。\n庾子江南恨，琼奴柱下吟。\n野风吹我老，鸿雁有馀音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚兴","author":"何中","text":"雁背霜花落，吟悲兴自如。\n天虚鳞甲动，山老鬓毛疏。\n断陇暮归客，寒溪人自渔。\n苍茫闭篱落，政尔缓羊车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春郊 其一","author":"何中","text":"湖海独垂钓，风云入短蓑。\n燕来春已去，花少雨偏多。\n一饮捐愁却，千杯奈醉何。\n青山如有意，对我独高歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜雨","author":"何中","text":"云叶来西北，风声乍疾徐。\n冥冥天下雨，湛湛圃中蔬。\n书传堪经世，乾坤且助锄。\n欲言无与领，独立看芙蕖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈家源 其一","author":"何中","text":"恐是仙源里，山从洞口开。\n茅檐无客到，稚子怪人来。\n塘绿鱼迎日，林清鸟啄苔。\n欲令幽赏足，石道溯萦回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行乐","author":"何中","text":"行乐当幽赏，晴峰带雪欹。\n水香梅落处，沙润草生时。\n事识心仍累，生添疾早衰。\n深村红叶路，樵牧转相知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠李仲元","author":"何中","text":"曾逢偏意悟，颜面费追思。\n把酒忽相语，计年深自悲。\n乱山藏路远，秋水去城迟。\n若到寒溪上，教儿护菊篱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别唐仲谦","author":"何中","text":"记名长似识，相见始惭非。\n每到极言罢，却欣幽听稀。\n日明山气改，江静水痕归。\n添得今朝别，城阴空掩扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴仲谷来喜雨","author":"何中","text":"山居难适俗，到县动经年。\n偶出成奇事，相看各粲然。\n酒深孤匊外，灯淡小楼偏。\n草草荀陈夕，他时倘有传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用欧阳文忠公神清洞韵题罗士鼎所藏米元晖神清洞图","author":"何中","text":"颖阳之山翠烟深，仙人不见劳我心。\n丛峰峨峨照空廓，白云时飞石欲落。\n此中不到人间客，采药归来花满石。\n想当飞舄堕层崖，数声清啸惊瑶台。\n缑山苍苍今在眼，举手招之殊未来。\n颖阳之山夜鹤飞，仙人不见归何时。\n神清之洞有幽客，应向洞中煮白石。\n洞前岩下仙家春，几片落花杂飞溜。\n高下楼台缥缈霞，绿树不老青山寿。\n王生邢子意殊勤，恨我隔此浮空尘。\n安得碧云千万叠，栖此人间谪堕身。\n元晖昔作西江客，夜飞墨花晓无迹。\n春风留此二百年，幸是山中至人识。\n有千黄金双白璧，鹅溪白茧才数尺。\n颖阳山高风露寒，几处高堂挂生色。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河道","author":"何中","text":"黄河道，漠漠黄沙覆枯草。\n依然南北两空堤，堤上耕人长桑枣。\n人心百计当若为，古来河水今南移。\n平原县前好沽酒，车夫鞭驴莫回首。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李仲章远游","author":"何中","text":"风笛无声笑指空，出门谁碍更求通。\n一帆千里客何远，王气雄图江自东。\n赤壁惊乌飞夜月，衡阳归雁落秋风。\n人间兴废不须问，诗在江潭柳影中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋怀 其一","author":"何中","text":"万壑东归昼夜流，人间自是本无愁。\n不悲白骨塌秋井，尚恨华屋归山丘。\n此事直须一杯酒，只今何用万里侯。\n明朝且可寻黄独，荷锸径往西山秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中 其一","author":"何中","text":"雨满寒空风满林，闭门十日长悲吟。\n不知补衮从谁语，尚许倾阳见寸心。\n书史轩窗云气润，蕙兰蹊径藓花深。\n好风为我吹晴未，欲钓清溪坐柳阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中 其二","author":"何中","text":"炎夏如秋气已迁，老天奇变亦多端。\n山横北牖阴云合，人对南山暮雨寒。\n江海穷居无米易，古今随意得诗难。\n岩花落尽幽禽语，坐拥千林俯碧栏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月二十八日","author":"何中","text":"黄竹哀歌世偶传，佳期应待后千年。\n曲江宫外看蒲柳，凝碧池边听管弦。\n古往今来人化鹤，天长地久帝为鹃。\n蓬莱水浅应闻似，徐福归舟已失仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜立","author":"何中","text":"冥冥无复辨秋毫，天映诸峰涌翠涛。\n万里明河流眼去，三更独雁倚风高。\n南邻絺绤秋难贷，隔舍歌呼夜更豪。\n只有殷勤木上坐，共听枯叶响萧骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓晴","author":"何中","text":"雨意将阑天自休，频穿诘曲听钩辀。\n千山欲曙微霞吐，万木含春湿翠浮。\n孤塔远知城尚近，空江犹似古来流。\n绕汀花落白于雪，掠地风来严似秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵彭希爽吴景传约游穆山","author":"何中","text":"穆山祗在白云隈，擘石为门任去来。\n两涧寒声通法席，数峰秋影散香台。\n林藏僧梵含风远，岭隔山樵戴月回。\n此地能令高兴别，中秋时近桂初开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中","author":"何中","text":"竦立去帆波渺渺，深笼寒霭树稀稀。\n象牙潭上风初急，龙雾洲前雪乱飞。\n山掩孤钟分响到，沙明丛雁逐行归。\n雕房炽炭行时令，阿那痴渔拥断矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送族弟元迪","author":"何中","text":"老去逢人怯送行，弟兄分手若为情。\n明时难使高才隐，为客当令远业成。\n桂岭寒烟通郢树，逍遥夜雨入彭城。\n明朝便自堪回首，不待秋风过雁声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题崔伯明诗卷","author":"何中","text":"海底珊瑚不易收，俄然在手醒双眸。\n娲皇炼石天无璺，织女机丝月共秋。\n一草作花生自别，三年刻楮巧堪羞。\n客窗灯影谁为伴，雨响空栏彻夜流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"由清江赤城观至宝塔寺暮归樟镇","author":"何中","text":"自笑野人多野思，并村随处意閒閒。\n赤城观里折丹桂，宝塔寺前迎晚山。\n隔水归樵分路散，冲岚飞鸟认林还。\n秪言十里街头近，不计黄昏便掩关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜独立有怀","author":"何中","text":"秋老溪贫独夜时，邛枝移遍响虫飞。\n山城鼓叠月生海，林屋灯寒风动扉。\n带雪关河人别久，隔天书札雁来稀。\n忘情每有难忘者，黄叶一庭霜满衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陈虚一尊师山房雨后","author":"何中","text":"一片閒心倚石坛，千峰向背碧当轩。\n海门雨气悬虹影，洞府香风粲鹤言。\n绝艳槿花深映户，生红荔子密围村。\n早知千里移家近，久办黄冈十亩园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34354,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"得家信","author":"何中","text":"俗尚难公不取谐，木阴深处玩苍苔。\n身抛世累终相著，心怯乡书重一开。\n极目云天鸦阵黑，满林风雨雁声来。\n平生最有看花癖，何处溪头发早梅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34355,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閤皂山福地","author":"何中","text":"两崖松竹绿萧萧，时听岩阴响野樵。\n鹤信蚤归题箓客，蜂房分缀鍊丹寮。\n晋时月在淦源浅，粤国云通勾漏遥。\n仙驭肯忘桥鼎地，风笙清夜落璿霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34356,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟夜","author":"何中","text":"拓去篷窗月满襟，萧萧惊雁堕哀音。\n不知天意何仓卒，数叠寒云万里阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海棠","author":"何中","text":"冥鸿衔子锦川来，袅袅柔红无数开。\n花睡未醒春未透，半空飞雨暗苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江行","author":"何中","text":"悠悠行客渐黄昏，隔浦人家已掩门。\n谁与飞沤游海上，乱鸦无数下西村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪","author":"何中","text":"天风摇动玉京移，九野苍茫竟大奇。\n老树细观犹似昔，好山无处不堪疑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋原","author":"何中","text":"稻花香里听潺湲，路入高原犊草閒。\n生长太平无所用，且随残照看秋山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初春","author":"何中","text":"年华将去野梅知，春色初来柳眼移。\n偶到前村閒指点，数峰残雪淡晴时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中遣兴","author":"何中","text":"万里千岩梦寂寥，飞淙落涧夜萧萧。\n觉来忽听儿童语，昨日榕阴在石桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题潇湘秋色图","author":"何中","text":"瑶瑟无声水自流，黄芦红叶满汀洲。\n蘋花欲采无寻处，一片閒情万古愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自笑","author":"何中","text":"世情多识事多谙，长对云山共笑谈。\n煮石采芝随意足，凭君莫唱望江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延祐六年九月廿二日渡扬子江","author":"朱德润","text":"驱车丹阳麓，津吏迎晓渡。\n击鼓动连艘，楫急浪花舞。\n水深蛟龙蛰，日落鸥鸟度。\n金山天畔楼，双塔逾青楸。\n黄金铸古像，岁月逐江流。\n谁云限南北，停桡歌壮游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞先生榆林中秋对月","author":"朱德润","text":"关前节候早，秋半毳衣出。\n牛羊散原隰，渐告农务毕。\n山空众木下，栖鸟已喧唧。\n日昏在牵牛，魄月如昼白。\n茫茫觇六合，况敢事一室。\n仰观浮云变，清晖易升没。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵贡仲章学士题仙山图","author":"朱德润","text":"浮生三十馀，失志堕尘鞅。\n南吴与北燕，所历如翻掌。\n山中猿鹤期，别路成榛莽。\n瑶草霜未凋，灵芝日应长。\n久闻东王公，御气九霄上。\n缥缈星霞裾，虚室绝华想。\n欲从道无因，写此寄清旷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为张畴斋承旨作仙山晚渡","author":"朱德润","text":"十月之交，朔风其飘。\n我来自南，于以游遨。\n清霜著乔木，落叶洒江皋。\n野桥驾略彴，苍石浴寒潮。\n客子暮担簦，蹀蹑上轻舠。\n澄江静可渡，不惮前山遥。\n闻有列仙人，炼玉遗丹膏。\n凤音虽寂寞，素鹤可相招。\n愿寻长生道，白日登云霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为仪凤山作","author":"朱德润","text":"物灵不自显，凤兮在山楸。\n文章日益著，律吕音相求。\n山川何岧峣，摇落关河秋。\n征雁度空碧，乌鸟集林丘。\n仲尼久已往，郊薮谁能留。\n行看太平日，君臣协成周。\n瑞世当一见，孤鸣扬九州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34370,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"葺旧庐作","author":"朱德润","text":"先人昔处世，行义如鲁黔。\n衰年当薄俗，历此忧患深。\n敝庐隔风雨，高歌忘古今。\n蔬食乐晨夕，得殽良盍簪。\n床头置周易，牖下莓苔侵。\n临云析疑义，言论众所钦。\n皇天不少假，悲风起长林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34371,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和柯敬仲博士幽兰","author":"朱德润","text":"阳和遍岩谷，猗兰发初芳。\n幽姿不自媚，随风忽飘香。\n宁辞雨露恩，感此岁月长。\n愿随郎官握，得上中书堂。\n不惭山泽姿，高贵比金张。\n灵芝在宣室，岂独怀沅湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34372,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题唐明皇幸骊山图","author":"朱德润","text":"骊山西北高，万乘东南至。\n霓旌苍翠中，阁道丹青里。\n忆昔上林游，春寒多并辔。\n羯鼓召花奴，黄门催力士。\n霓裳曲未终，惊动渔阳骑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34373,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和龚子敬先生游春韵","author":"朱德润","text":"烹茶热旨酒，坐石得嘉宾。\n好鸟时鸣昼，幽花不放春。\n山遗今古事，诗著往来人。\n楚地龚夫子，诸生数问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠黄竹村老儒画梅竹","author":"朱德润","text":"烟水旴江渺，丹阳度雪寒。\n久怜梅淡泊，先问竹平安。\n夜月清诗思，春风彩笔端。\n北来知己少，岁暮欲弹冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李益斋之临洮","author":"朱德润","text":"绿阴满京畿，送子之临洮。\n临洮何茫茫，流出长城壕。\n长城岸阻玉关阨，于阗葱岭河凉高。\n羌氐儿郎走带箭，哀笳风起斗击刁。\n良人西征二三载，宝幢车马声尘遥。\n如今不用酒泉郡，岂必坐使朱颜凋。\n蒲萄苜蓿味虽美，异方土俗殊乡里。\n避地犹当似管宁，受封应得论箕子。\n愿从列骑拥旌旄，归来燕处华堂里。\n却话人情翻掌难，曾浥征袍泪如洗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王编修邀游西山海子","author":"朱德润","text":"晴川低回山苍苍，涵烟夹溪千里长。\n山腰涧曲细泉响，下激石窦为微潢。\n枯梢挽风秋色里，修林落叶随长江。\n林疏石露见茅屋，时有小径通微茫。\n招提横截翠微上，栏干九曲云飞扬。\n自从束书离故乡，脚头青鞋走山梁。\n山川悠长日月速，跻攀分寸何能强。\n太原高人知我意，请列纨素书沧浪。\n丹青不关名利眼，虎头痴绝非王郎。\n百年有怀良可哂，还拂长松思道场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠张鍊师游京师","author":"朱德润","text":"鍊师家住茅山窈，玉泉为池翠云绕。\n丹成不随笙鹤去，酒酣击剑思燕赵。\n古称燕赵多义士，京师贵官皆倒屣。\n君今挟策远寻师，闻道王公新奉旨。\n黄金殿下拜天子，绛节朝元从此始。\n他年云外听山呼，茅山合在东封里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除日","author":"朱德润","text":"日行三百六十五，今夕方除岁云暮。\n人生忧乐百年期，又见日除当此度。\n养和适情宜及时，古今中寿七十稀。\n自非金石不可永，刀圭谁保长生期。\n彭宣老?亦何之，不须更作送穷诗。\n客闻此辞莫伤咨，樽前且醉黄金卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺张景亮知州致仕","author":"朱德润","text":"角巾归里旧儒冠，宦辙驰驱涉万端。\n杨柳碧溪春昼永，梅花白雪夜窗寒。\n朝廷有道容辞老，田野无羁得尽欢。\n幸喜玉堂遗业在，安居留待后人看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘德璋提点还宜兴通真观","author":"朱德润","text":"通真仙观欲凌虚，牝谷先生昼隐居。\n玄鹤不归华表柱，白云长护紫泥书。\n桐棺已化人徒仰，铁锁高悬孰可舒。\n便欲束书阳羡路，青牛春晚又回车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王继学治书","author":"朱德润","text":"驹隙流光一镜悬，虚明直与绮窗连。\n凿开混沌知身外，别有山川在眼前。\n蓬岛秋深稽汉使，桃源春暖避秦仙。\n敬亭山色看如画，熊枕围屏稳昼眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题豫章山房","author":"朱德润","text":"豫章林老色参天，拥护山僧丈室前。\n岂为法身同草木，要驱尘虑出风烟。\n茶瓯香篆晨斋后，竹几蒲团夜榻边。\n独有浏阳欧学士，题诗遥问不空禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞先生题武当山张真人别业","author":"朱德润","text":"岚雨初晴绿树新，松萝夹屋净无尘。\n洞花幽鸟时时别，野鹤孤云日日亲。\n红雾半窗丹火候，青山万古百年人。\n从君更觅方平宅，玄武门前作近邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天宫寺僧寅叔恭藏宋王元之诗因次韵","author":"朱德润","text":"隔屋长松覆满斋，童年竹马记频来。\n讲堂经罢僧修史，京国人归袖惹埃。\n古佛岁深花蠹铁，长廊春净雨生苔。\n尘缘未结东林社，禅榻留茶日暮回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陶渊明归去来图","author":"朱德润","text":"甲子题年玩物华，门前栗里自桑麻。\n从他晋史书刘宋，别有黄花处士家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过岳鄂王庙","author":"朱德润","text":"汴宋南迁社稷忧，忠魂应念国包羞。\n钱塘千载英雄恨，古木残阳掩暮秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赓郭祥卿饮酒图","author":"朱德润","text":"昔人好酒名虽在，死灰万劫谁能全。\n我今悼昔复须饮，翻恨不生中古前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]