[{"title":"河中春游有感五首 其三","author":"耶律楚材","text":"坎止流行以待终，幽人射隼上高墉。\n穷通世路元多事，艰险机关有几重。\n百尺苍枝藏病鹤，三冬蛰窟闭潜龙。\n琴书便结忘言友，治圃耘蔬自养慵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河中春游有感五首 其四","author":"耶律楚材","text":"西域渠魁运已终，天兵所指破金墉。\n崇朝驲骑驰千里，一夜捷书奏九重。\n鞭策不须施犬马，庙堂良算足夔龙。\n北窗高卧薰风里，尽任他人笑我慵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河中春游有感五首 其五","author":"耶律楚材","text":"重玄叩击数年终，大道难窥万仞墉。\n旧信不来青鸟远，故山犹忆白云重。\n自知勋业输雏凤，且学心神似老龙。\n忙里偷闲谁似我，兵戈横荡得疏慵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过闾居河四首 其一","author":"耶律楚材","text":"河冰春尽水无声，靠岸钩鱼羡击冰。\n乍远南州如梦蝶，暂游北海若飞鹏。\n隋堤柳絮风何处，越岭梅花信莫凭。\n试暂停鞭望西北，迎风羸马不堪乘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过闾居河四首 其二","author":"耶律楚材","text":"北方寒凛古来称，亲见阴山冻鼠冰。\n战斗檐楹翻铁马，穷通棋势变金鹏。\n五车经史都无用，一鹗书章谁可凭。\n安得冲天畅予志，云舆六驭信风乘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过闾居河四首 其三","author":"耶律楚材","text":"一圣龙飞德足称，其亡凛凛涉春冰。\n千山风烈来从虎，万里云垂看举鹏。\n尧舜徽猷无阙失，良平妙算足依凭。\n华夷混一非多日，浮海长桴未可乘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过闾居河四首 其四","author":"耶律楚材","text":"自愧声名无可称，贤愚混世炭和冰。\n窃盐仓鼠初成蝠，喷浪溟鲲未化鹏。\n卖剑学耕食粗遣，买山归老价难凭。\n秋江月满西风软，何日扁舟独自乘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感事四首 其一","author":"耶律楚材","text":"富贵荣华若聚沤，浮生浑似水东流。\n仁人短命嗟颜氏，君子怀疾叹伯牛。\n未得鸣珂游帝阙，何能骑鹤上扬州。\n几时摆脱闲缰锁，笑傲烟霞永自由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感事四首 其二","author":"耶律楚材","text":"当年元拟得封侯，一误儒冠入士流。\n赫赫凤鸾捐腐鼠，区区蛮触战蜗牛。\n未能离欲超三界，必用麾旄混九州。\n致主泽民元素志，陈书自荐我无由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感事四首 其三","author":"耶律楚材","text":"得不欣欣失不忧，依然不改旧风流。\n深藏凤璧无投鼠，好蓄龙泉候买牛。\n山寺幽居思少室，梅花归梦绕扬州。\n萱堂温凊十年阙，负米供亲愧仲由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感事四首 其四","author":"耶律楚材","text":"人不知予我不尤，濯缨何必拣清流。\n良材未试聊耽酒，利器深藏俟割牛。\n旧政欲传新令尹，新朝不识旧荆州。\n眉山云迈归商路，痛恪新诗寄子由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壬午元日二首 其一","author":"耶律楚材","text":"西域风光换，东方音问疏。\n屠苏聊复饮，郁垒不须书。\n旧岁昨宵尽，新年此日初。\n客中今十载，孀母信何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壬午元日二首 其二","author":"耶律楚材","text":"万里西征出玉关，诗无佳思酒瓶乾。\n萧条异域年初换，坎轲穷途腊已残。\n身过碧云游极乐，手遮东日望长安。\n年光迅速如流水，不管诗人两鬓斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过沁园有感","author":"耶律楚材","text":"昔年曾赏沁园春，今日重来迹已陈。\n水外无心修竹古，雪中含恨瘦梅新。\n垣颓月榭经兵火，草没诗碑覆劫尘。\n羞对覃怀昔时月，多情依旧照行人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用刘正叔韵","author":"耶律楚材","text":"参叩松轩积有年，光尘融泄一愚贤。\n视民每羡如刍狗，治国常思烹小鲜。\n只道牛边休执杖，谁知琴上亦忘弦。\n湛然稍异香山老，不学空门不学仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域家人辈酿酒戏书屋壁","author":"耶律楚材","text":"西来万里尚骑驴，旋借葡萄酿绿醑。\n司马捲衣亲涤器，文君挽袖自当炉。\n元知沽酒业缘重，何奈调羹手段无。\n古昔英雄初未遇，生涯或亦隐屠沽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其一","author":"耶律楚材","text":"积年不啜建溪茶，心窍黄尘塞五车。\n碧玉瓯中思雪浪，黄金碾畔忆雷芽。\n卢仝七椀诗难得，谂老三瓯梦亦赊。\n敢乞君侯分数饼，暂教清兴绕烟霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其二","author":"耶律楚材","text":"厚意江洪绝品茶，先生分出蒲轮车。\n雪花滟滟浮金蕊，玉屑纷纷碎白芽。\n破梦一杯非易得，搜肠三椀不能赊。\n琼瓯啜罢酬平昔，饱看西山插翠霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其三","author":"耶律楚材","text":"高人惠我岭南茶，烂赏飞花雪没车。\n玉屑三瓯烹嫩蕊，青旗一叶碾新芽。\n顿令衰叟诗魂爽，便觉红尘客梦赊。\n两腋清风生坐榻，幽欢远胜泛流霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其四","author":"耶律楚材","text":"酒仙飘逸不知茶，可笑流涎见曲车。\n玉杵和云舂素月，金刀带雨剪黄芽。\n试将绮语求茶饮，特胜春衫把酒赊。\n啜罢神清淡无寐，尘嚣身世便云霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其五","author":"耶律楚材","text":"长笑刘伶不识茶，胡为买锸谩随车。\n萧萧暮雨云千顷，??春雷玉一芽。\n建郡深瓯吴地远，金山佳水楚江赊。\n红炉石鼎烹团月，一椀和香吸碧霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其六","author":"耶律楚材","text":"枯肠搜尽数杯茶，千卷胸中到几车。\n汤响松风三昧手，雪香雷震一枪芽。\n满囊垂赐情何厚，万里携来路更赊。\n清兴无涯腾八表，骑鲸踏破赤城霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域从王君玉乞茶因其韵七首 其七","author":"耶律楚材","text":"啜罢江南一椀茶，枯肠历历走雷车。\n黄金小碾飞琼屑，碧玉深瓯点雪芽。\n笔阵陈兵诗思勇，睡魔卷甲梦魂赊。\n精神爽逸无馀事，卧看残阳补断霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其一","author":"耶律楚材","text":"垂亡圣道赖君鸣，坎轲休嗟道不行。\n须信诗魔降笔阵，好将酒战破愁城。\n滔滔秋水如人志，薄薄闲云似世情。\n一举冲霄知有日，垂天万里看鹏程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其二","author":"耶律楚材","text":"古今兴废不堪听，宠辱都如梦一惊。\n韬略欣然推后进，琴书足以了馀生。\n既知物物头头是，谁问朝朝暮暮情。\n散尽迷云何所有，一轮秋月普天明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其三","author":"耶律楚材","text":"天涯索寞正穷秋，衰草寒烟无尽头。\n叶底哀蛩空促织，云间征雁祗供愁。\n酪浆满引浇羊胛，粝食随缘荐鹿脩。\n试暂回光乐真觉，人閒万法一时收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其四","author":"耶律楚材","text":"星星华发镜中惊，好赋归欤接淅行。\n重位宁贪高一品，故园无惮远千程。\n晴天花络春山色，落日松和秋水声。\n无恙闾峰三百寺，遨游吟啸老馀生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其五","author":"耶律楚材","text":"古木残阳映矮岗，雁行天际写秋光。\n霜蓑带雨添愁色，晚菊和风送冷香。\n浊酒三年浑未试，黄粮九月得初尝。\n龙沙且喜身强健，南望幽人天一方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄韵五首 其六","author":"耶律楚材","text":"不见高阳旧酒徒，临风惆怅几踟蹰。\n无穷真味思焦尾，有限浮生叹白驹。\n德望服人输二陆，文章重世愧三苏。\n散材潦倒浑无用，空作昂藏一丈夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9354,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄十月桃花韵二首 其一","author":"耶律楚材","text":"桃源仙子忆刘郎，不惮严冬雨雪凉。\n红雨已先初夏落，妖魂重对小春芳。\n冷侵绿萼刚舒脸，寒彻朱衣强喷香。\n谁向荒园慰萧索，数枝无语映斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9355,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和冲霄十月桃花韵二首 其二","author":"耶律楚材","text":"春生秋杀乃天常，来往推迁炎与凉。\n晚节正当阴气塞，穷冬忽见小桃芳。\n岂知卜枣能成实，僭与江梅敢并香。\n自愧备员调鼎鼐，不知何事谬阴阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9356,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用薛正之韵","author":"耶律楚材","text":"无德惭为天下先，湖山归计好加鞭。\n霜深尚有篱边菊，风劲全无叶底蝉。\n三弄瑶琴歌素月，一樽浊酒醉苍烟。\n凤池分付夔龙去，万顷潇湘属湛然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤见寄","author":"耶律楚材","text":"龙冈参透后三三，髣髴前人何所惭。\n妙笔照人惊老字，新诗入手想清谈。\n尘中名利予难出，梦里荣华君不耽。\n准拟归时便归去，闾山珍重旧禅庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用刘润之乞冠韵","author":"耶律楚材","text":"隐逸养幽慵，飘萧两鬓蓬。\n角巾折暮雨，醉帽落秋风。\n避暑挂石上，衔杯鹿酒中。\n忘机任真率，露顶向王公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其一","author":"耶律楚材","text":"寂寞河中府，连甍及万家。\n葡萄亲酿酒，杷榄看开花。\n饱啖鸡舌肉，分餐马首瓜。\n人生唯口腹，何碍过流沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其二","author":"耶律楚材","text":"寂寞河中府，临流结草庐。\n开樽倾美酒，掷网得新鱼。\n有客同联句，无人独看书。\n天涯获此乐，终老又何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其三","author":"耶律楚材","text":"寂寞河中府，遐荒僻一隅。\n葡萄垂马乳，杷榄灿牛酥。\n酿春无输课，耕田不纳租。\n西行万馀里，谁谓乃良图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其四","author":"耶律楚材","text":"寂寞河中府，生民屡有灾。\n避兵开邃穴，防水筑高台。\n六月常无雨，三冬却有雷。\n偶思禅伯语，不觉笑颜开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其五","author":"耶律楚材","text":"寂寞河中府，颓垣绕故城。\n园林无尽处，花木不知名。\n南岸独垂钓，西畴自省耕。\n为人但知足，何处不安生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其六","author":"耶律楚材","text":"寂寞河中府，西流绿水倾。\n冲风磨旧麦，悬碓杵新粳。\n春月花浑谢，冬天草再生。\n优游聊卒岁，更不望归程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其七","author":"耶律楚材","text":"寂寞河中府，清欢且自寻。\n麻笺聊写字，苇笔亦供吟。\n伞柄学钻笛，宫门自斲琴。\n临风时适意，不负昔年心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其八","author":"耶律楚材","text":"寂寞河中府，西来亦偶然。\n每春忘旧闰，随月出新年。\n强策浑心竹，难穿无眼钱。\n异同无定据，俯仰且随缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其九","author":"耶律楚材","text":"寂寞河中府，声名昔日闻。\n城隍连畎亩，市井半丘坟。\n食饭秤斤卖，金银用麦分。\n生民怨来后，箪食谒吾君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域河中十咏 其十","author":"耶律楚材","text":"寂寞河中府，遗民自足粮。\n黄橙调蜜煎，白饼糁糖霜。\n漱旱河为雨，无衣垄种羊。\n一从西到此，更不忆吾乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其一","author":"耶律楚材","text":"年来深欲买湖山，贫病难酬绢五千。\n归去不从陶令请，知音未遇孟尝贤。\n排愁器具思欢伯，送老生涯乏货泉。\n惟有诗魂常伴我，閒吟陶写个中玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9370,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其二","author":"耶律楚材","text":"一发燕然晓日边，寒云叠叠乱山千。\n万重沙漠犹逢友，十室荒村亦有贤。\n留客芳樽思北海，惊人奇语忆南泉。\n思量万事多浑错，勉力轮锤好扣玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9371,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其三","author":"耶律楚材","text":"君侯乘兴写佳篇，我得琼琚价倍千。\n妙笔一挥能草圣，新诗独惠过称贤。\n半瓶浊酒斟琼斝，七椀清茶泛玉泉。\n万里西行真我幸，逢君时复一谈玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9372,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其四","author":"耶律楚材","text":"健羡金鞍美少年，盈门剑客列三千。\n须知执德元非德，况是无贤敢自贤。\n不解弯弓射石虎，谁能击剑跃龙泉。\n黑头勋业今何在，壮岁功成愧谢玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9373,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其五","author":"耶律楚材","text":"云龙相感本乎天，会合君臣岁一千。\n西伯已亡谁老老，卜商何在肯贤贤。\n鹓雏未必轻餐鼠，蚯蚓犹知下饮泉。\n巧拙是非无定据，到头谁解辨黄玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其六","author":"耶律楚材","text":"奔走红尘积有年，深思雪涧竹竿千。\n谁能世上全三乐，好向林间伴七贤。\n笔下风生诗似锦，瓮头春涨酒如泉。\n诗成酒罢寂无事，净几明窗诵太玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其七","author":"耶律楚材","text":"竹径风来自破禅，修篁青剑叶垂千。\n烂吟风月元无碍，高卧烟霞未是贤。\n迷处无由逃绊锁，悟来何处不林泉。\n纵横触目皆真理，坐卧经行鸟路玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其八","author":"耶律楚材","text":"无灭无生不论年，谁誇桃熟岁三千。\n休将真宰陪司命，莫使明星动进贤。\n有道不妨居闹市，无心奚碍酌贪泉。\n何能远遁尘嚣去，且向人间养素玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其九","author":"耶律楚材","text":"从他豪俊领时权，指顾貔貅数百千。\n碌碌馀生甘养拙，明明圣代岂遗贤。\n且图混世啜醨酒，勿谓濯缨弃浊泉。\n莫道无为云便了，有为何处不逢玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十","author":"耶律楚材","text":"浮生瞬息度流年，唐汉兴亡不半千。\n清洁采薇输二子，英雄济世有三贤。\n未能海上寻芝草，且向尘中泛醴泉。\n醉兴陶陶略相似，无何乡里亦通玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十一","author":"耶律楚材","text":"成败兴亡事可怜，劳生扰扰几千千。\n调心莫若先离欲，治世无如不尚贤。\n小褚岂能怀大器，短绳那得汲深泉。\n直须箭透威音外，不用无为不用玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十二","author":"耶律楚材","text":"得得清欢乐自然，不辞去国客程千。\n翻腾旧案因君玉，唱和新诗有景贤。\n每遇开樽邀素月，常因盥手掬寒泉。\n衰翁自揣何多幸，未死中间乐此玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十三","author":"耶律楚材","text":"几回午枕不成眠，幽鸟关关近数千。\n安世不知安世计，隐居常慕隐居贤。\n几行石榻围松径，一簇茅斋绕涧泉。\n挂起西轩风似水，閒将羲易索幽玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十四","author":"耶律楚材","text":"农隐生涯乐自天，药畦香垄仅盈千。\n蝇营累世真堪笑，狗苟劳生未若贤。\n带月扶犁耕暮野，冲云荷锸拨春泉。\n耘耔馀暇蓬窗底，独抱遗经考至玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十五","author":"耶律楚材","text":"闲闲个事本明圆，一念才兴路八千。\n生死既知皆是幻，功名犹恋岂能贤？\n兴来畅饮斟晴月，醉后高歌枕碧泉。\n触处逢渠何所碍，不玄玄处亦玄玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十六","author":"耶律楚材","text":"物物头头总是禅，观音应现化身千。\n杜门晏坐无伤道，遁世幽居也是贤。\n祗为看山开翠竹，偶因煎茗汲清泉。\n灵云检点真堪笑，不见桃花不悟玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十七","author":"耶律楚材","text":"蓑衣狂脱暮江边，一醉宁论价十千。\n老矣冯唐何所往，归与陶令最为贤。\n灵苗细细初盈圃，春水涓涓渐满泉。\n酒醒梦回无个事，澄心忘虑体三玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十八","author":"耶律楚材","text":"九重阊阖列群官，曳佩鸣珂及万千。\n云水偷将属野叟，功名回施与时贤。\n好凭定慧超三界，不恋轮回没九泉。\n迅速光阴莫虚度，回光返照静参玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域和王君玉诗二十首 其十九","author":"耶律楚材","text":"不学经书不说禅，谁论芥子纳三千。\n忘形诗句追先觉，适意琴书慕昔贤。\n白雪阳春吟雅调，高山流水奏鸣泉。\n平生受用元无尽，参透真空未是玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]