[{"title":"分题得秦淮送杜士能","author":"凌云翰","text":"春波城下自涟漪，一舸夷犹任所之。\n月过女墙潮落后，烟笼寒水夜分时。\n双双堂燕衔沉见，白白淮鱼入馔知。\n期子有才如杜牧，此行莫惜重题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21219,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱塘邑丞宋章甫","author":"凌云翰","text":"治世人才气自豪，起身应不愧萧曹。\n春秋有学经曾试，铁石为心赋最高。\n百里岂能栖凤棘，三年聊复试牛刀。\n送君又到销魂处，南浦新波映去袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21220,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大方圆上人有亭扁客航在越上远林先生索赋","author":"凌云翰","text":"老禅杯渡恐鸥惊，聊结虚亭喻物情。\n春水祗疑天上坐，晚风还想月中行。\n此身江海长为客，彼岸舟航浪得名。\n夜半壑中谁负去，欲将此语问庄生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21221,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郝德新又新字说卷后","author":"凌云翰","text":"一篇虺诰炳丹青，九字汤铭灿日星。\n不是菜朱曾有语，安能子墨重书铭。\n乾坤纳纳应无外，江汉滔滔岂暂停。\n绝爱郝隆书满腹，命名称字必尊经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21222,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"瑞竹杖诗","author":"凌云翰","text":"朝晖轩与竹为邻，煮笋时时得奉亲。\n因见同根分二干，欲将寸草报三春。\n夷齐比节无馀子，权绰连枝有后人。\n扶老凭兹足流憩，莫疑五柳是前身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21223,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东圆分题七叶坡为王景周赋","author":"凌云翰","text":"森森佳木映阳坡，不比槐阴十讼多。\n谁见一花如菡萏，人传七叶是娑罗。\n漠貂谩藉金张业，月兔空涵海水波。\n昨夜虚堂闻子落，定知仙客费吟哦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21224,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳氏双婺卷","author":"凌云翰","text":"姑妇孀居守寂寥，闭门风雨任飘摇。\n柳因秋早惊先落，松到岁寒知后凋。\n一寸丹心同耿耿，百年华发共萧萧。\n由来节义关名教，看取曹娥庙下潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21225,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种菊庵为无锡钱子义赋","author":"凌云翰","text":"绕庵种菊待秋先，不道春苗已厌尝。\n酒效少陵拈重碧，花怜惟演进姚黄。\n满城风雨重阳意，三径荒芜几处香。\n况有惠山泉可试，拟同桑苧对幽芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21226,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月六日病起偶成","author":"凌云翰","text":"卧病经时莫叹嗟，起来犹可岸乌纱。\n药囊屡检看题遍，书帖重临作字斜。\n秪觉风光吹白发，不知秋意满黄花。\n自怜江海垂纶手，却倚衡门数暮鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21227,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送诏使还京","author":"凌云翰","text":"南闽西浙路犹赊，顷刻思光遍海涯。\n五夜星辰呈贯索，九天雨露逐皇华。\n归期已过清明节，行色将迎紫禁花。\n风虎云龙当此日，颂成须献帝王家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21228,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨宗元分教海宁","author":"凌云翰","text":"闭户读书谁与邻，翻然分席海之滨。\n太玄准易知先世，清白传家见后人。\n蝌蚪文漫思复古，蝤蛑市近喜尝新。\n独怜载酒河桥别，抍得梅花是小春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21229,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思云轩为罗师尚赋","author":"凌云翰","text":"思亲长日看云生，亲殁因轩寓旧名。\n先世独推罗仲素，今人重见狄怀英。\n心关瞑色随乌集，目极秋容与雁征。\n每为三山歌陟岵，萧萧风雨候鸡鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21230,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游孤山和靖祠","author":"凌云翰","text":"山有梅花山不孤，先生甘与鹤同癯。\n一杯黄土留前宋，千古清风映里湖。\n疏影暗香曾入咏，淡妆浓抹自成图。\n水仙祠下多秋菊，谁把寒泉当酒壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21231,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳庄为会稽薛德明赋","author":"凌云翰","text":"几年种柳绕村庄，翠色参天百尺长。\n垂叶正当高士宅，飞花还过别人墙。\n能诗杜甫憎春晓，嗜酒陶潜爱午凉。\n何日棹航来鉴曲，据舷吹笛看湖光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21232,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松隐为屠景祥赋","author":"凌云翰","text":"馀杭溪上多长松，雪气遥连天柱峰。\n蓝田自有韩子记，苍官不受秦人封。\n风传虚籁清俗耳，日食扶苓延好容。\n按图若遂归隐计，杖策许我来相从。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21233,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴玉林分教富阳","author":"凌云翰","text":"家住双溪溪水滨，误将书剑走风尘。\n散论文学过游夏，为爱山川到富春。\n梦破小楼江月白，诗成古邑野梅新。\n明朝又拥皋比坐，诗易那能让昔人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21234,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上元会饮次俞紫芝先辈韵","author":"凌云翰","text":"中年行乐遇新年，触目风光更接连。\n夜色遥通鳷鹊观，春声先泛凤凰弦。\n云中花乱疑瀛海，月下人归是洞天。\n鬓点吴霜嗟老矣，踏歌槌鼓让童颠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21235,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼王壶父","author":"凌云翰","text":"行藏多寄一壶中，枕上功名觉后空。\n长吉诗多鬼仙气，宗师文有古人风。\n笙悲夜月伤归鹤，弦绝春冰怨去鸿。\n飞舄不知何处所，芙蓉城阙暮云红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21236,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"真率斋诗为杨懋臣赋","author":"凌云翰","text":"真率应知出自如，会名又复到斋居。\n举觞便可频开燕，溉釜何妨更煮鱼。\n画为品题交互看，诗因分韵接连书。\n子云识字无人问，白首玄经守敝庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21237,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼黄氏父子次周元亮韵","author":"凌云翰","text":"善人不得归乡里，此事端为识者哀。\n客死忽惊枯骨返，人生那得好怀开。\n眼中无复驱羊起，身后犹疑化鹤来。\n丹井西颜松树在，空山斜日尚低徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21238,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠笔工杨均显","author":"凌云翰","text":"翁在相溪溪上居，偶因缚笔致名誉。\n已烦猎者擒秋兔，更助文人校鲁鱼。\n毛援犹能利天下，心殚宁肯不中书。\n玉堂新样须重赠，拟效相如赋子虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21239,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双鹤轩为鲁嗣衡赋","author":"凌云翰","text":"开轩正在西湖上，双鹤偶来能守扉。\n复陂似托两黄鹄，过我疑多一羽衣。\n秪道在阴其子和，宁知去郭昔人非。\n仙家楼子曾相近，好伴孤云自在飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21240,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"如存堂为程进珉赋","author":"凌云翰","text":"外家宅相不须论，且筑书堂磅故园。\n珠玉照人甥在侧，琼瑰赠舅母如存。\n心同白水伤投璧，自极柯山念倚门。\n三复渭阳诗意好，为观小序却销魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21241,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵执中会试","author":"凌云翰","text":"圣主求贤在养民，儒生睹国早充宾。\n一千里外知鸿鹄，四十人中见凤麟。\n画舸溯风瓜渡晚，青袍沾雨杏园春。\n泥金帖子须先寄，好向高堂慰二亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21242,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送崔彦晖分教临安","author":"凌云翰","text":"临安古邑带山溪，送客西行意欲迷。\n高适故人怜子美，崔群交友愧昌黎。\n弯弓射圃秋观雁，看剑灯窗夜听鸡。\n昭代英才初乐育，离觞不用惜分携。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21243,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香橼即枸橼也康雪庭上人用赠紫芝上人因而有作予偶见之遂次其韵仍简紫芝","author":"凌云翰","text":"图寔如瓜尚得霜，老禅相赠杂青黄。\n韵欺薝卜熏狮座，巧学流苏映象床。\n蜡烛照来微弄影，金盆浴罢暗生香。\n南州士女争雕镂，浸密涂脂取次妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21244,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东山书隐为郑原宜赋郑本越人居东山先世徙杭遂家焉尝筑室西湖上从徐勉庵授书经因以为扁示不忘本也原直事亲以孝闻及筮仕都卫尤有声誉故赋长句以美之","author":"凌云翰","text":"东山读书隐居处，如何只在西湖边。\n拟岘作记昔闻耳，思越寓吟今信然。\n蔷薇花落忆李白，书带草生疑郑玄。\n近闻去作幕下士，忠孝要看光简编。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21245,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万竹轩诗为沈亮赋","author":"凌云翰","text":"种得筼筜得岁寒，数竿便作万竿看。\n云闲不觉侵书幌，雪细从教点画阑。\n纵有长丝牵紫鲤，可无明镜著青鸾。\n东阳已赋郊居久，一任新来带眼宽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21246,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郭子理归庐陵","author":"凌云翰","text":"严亲兵乱久相违，亲殁殊方骨未归。\n苕水殡时先友盛，麦舟遗后故人稀。\n已于名教能关系，况有文章为发挥。\n此别会成迁葬计，免教空望白云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21247,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湘湖草堂为贡友初赋","author":"凌云翰","text":"湘湖卜宅似江郊，梅柳同栽已放稍。\n春雨漏时愁在屋，秋风怒处忆飞茅。\n莼丝流滑羹长用，荷叶分香饭屡包。\n买得扁舟梭样大，呼童系在石塘坳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21248,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画菜次米仲谊韵","author":"凌云翰","text":"菘韭堪为早晚谋，老夫正欲拔其尤。\n园葵自觉能防夏，野苋谁知亦有秋。\n偶为画图思鲁直，肯因齑臼说杨修。\n少陵莫道贫如庾，露薤盈筐不待求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21249,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送逯宏希远","author":"凌云翰","text":"上书曾达圣明朝，充贡仍随使者轺。\n蝌蚪光生周与籍，凤凰声应舜箫韶。\n杨雄献赋才无敌，逯石传家曾已遥。\n抍得梅花当杨柳，春风又送木兰桡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21250,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送湛璿文衡","author":"凌云翰","text":"采绿曾看在泮池，飞黄况复值明时。\n风霜雨露无非教，草木虫鱼总入诗。\n把酒梅边春尚小，停车林下晚偏宜。\n临行又欲歌棠棣，转忆同年是汝师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21251,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王明善","author":"凌云翰","text":"月满西斋夜不扃，读书相对短檠青。\n虫鱼草木资多识，敦厚温柔擅一经。\n鹗荐此时虽衮衮，鸿飞他日更冥冥。\n送行为子思王式，一曲骊驹仔细听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21252,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送沈仲名","author":"凌云翰","text":"沈约才华足起予，又因充贡别郊居。\n好将言行同居寔，莫倚文章教子虚。\n荐表他时称一鹗，尺书何日寄双鱼。\n老夫重拭眵昏目，遥睇青云逐去车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21253,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云卧楼为卢宗文赋","author":"凌云翰","text":"金罍山色满庭除，偃仰长因饱食馀。\n神女有时行雨过，仙人自昔好楼居。\n龙归不觉衣裳润，蝶去方惊枕席虚。\n莫向招提频借宿，且留丹壑待天书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21254,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张伯雨天一井阑诗元金荪璧积庆冈物后在开元宫黄蔑楼今在王景周东圃万文远先作予因和之","author":"凌云翰","text":"玉阑铁画任歌斜，岂有人讥挂树蛇。\n曾见坠星疑此石，相随落月是谁家。\n辘轳声动晨牵绠，沆瀣光生夜浴砂。\n阅尽开元到东圃，红楼翠幕不须誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21255,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脑月见白牡丹为吕仲善长司赋","author":"凌云翰","text":"无边生意见荄滋，岁晚归来喜可知。\n万木正当摇落后，一花如在艳阳时。\n雪中不假转湘术，月下须吟李白诗。\n若比玉杯真入用，疑盛春酒献瑶池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21256,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行素斋诗为韩性孜赋","author":"凌云翰","text":"海昌亦有平原裔，晚节斋居足养恬。\n坐树濯泉唐李愿，经丘寻壑晋陶潜。\n青衿日与谈章句，素履时能玩象占。\n卖药归来人不识，杏花春雨满疏帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21257,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旸谷轩为刘道明知事赋","author":"凌云翰","text":"扶桑暾出犹苍凉，轩楹照耀瞳眬光。\n金矿铸橘一点火，丹心倾葵方寸长。\n如中朱乌秩东作，似鸣仓庚眷载扬。\n凤凰千仞览辉下，梧桐况复生高冈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21258,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静庵诗为德清知县陈彦荣赋","author":"凌云翰","text":"辟户为乾阖户坤，由来静者动之根。\n宇安泰定天光发，肤达黄中地道尊。\n谩说吉祥惟止止，须知成性本存存。\n治心治事谁能此，独有希夷后世孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨香亭","author":"凌云翰","text":"轻雷送雨闹池蛙，藕叶生香胜似花。\n但觉繁声鸣屋瓦，不须清气逼窗纱。\n桐江如著高人钓，盘谷深藏隐者家。\n想得亭中称寿日，碧筒杯里酌流霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁巳午日忽忆乙未有作追录之","author":"凌云翰","text":"江雨肥梅未作霖，天时人事日侵寻。\n三年文叶能医国，五月葵花不易心。\n唐殿赐衣犹有葛，扬州铸镜久无金。\n投书欲吊沉湘魄，间说干戈楚地深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"布谷篇","author":"凌云翰","text":"每向豳居玩物情，却怜野鸟解催耕。\n雨收江上一犁足，风动林梢两个鸣。\n如入画图供赋咏，莫将思怨起阴晴。\n纪官此日无人问，秪问今秋万宝成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼王观用宾","author":"凌云翰","text":"修短由来不可期，未应天道竟无知。\n将闻司马终传史，犹记伯鱼初学诗。\n江阻钱塘何限恨，山埋玉笥有馀悲。\n老怀正复成多感，况值梅黄雨细时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"友恭堂为胡拱衡赋","author":"凌云翰","text":"峨嵋山色扫晴空，中有高堂号友恭。\n诗礼相传知岁久，埙篪迭奏觉春融。\n枝连棣萼亲情似，树著荆花乐意同。\n湖学育才先世事，子孙殊有古人风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21264,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五弦琴","author":"凌云翰","text":"闻说琴调天下治，直弦况值未加时。\n在床被袗曾遭象，解愠颁侯更得夔。\n和气尽从元气出，南风还类凯风诗。\n缅怀千古岩廊上，爱物仁民本孝思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21265,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南屏对雪宿简公房次王子中韵","author":"凌云翰","text":"远近湖山淡复浓，此时浑失旧时容。\n天寒故把瓶梅浴，雪冻难将野菜供。\n东阁又吟年后句，南屏同听晚来钟。\n翻疑一舸长桥过，重叠云衣护玉峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21266,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为吴以道题红梅翠竹图","author":"凌云翰","text":"寒梅宜与竹交加，没骨图新对客誇。\n翡翠剪翎分作叶，守宫流血点成花。\n美人君子同千里，明月清风自一家。\n威凤不来么凤悄，却因客鬓惜年华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21267,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽邹母李恭人","author":"凌云翰","text":"恭人身殁已经年，子孝方知母氏贤。\n空有杯棬存口泽，了无稊稗到心田。\n一门节义谁能及，七月光阴自可怜。\n好写断机投杼意，未须重补白华篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21268,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓望","author":"凌云翰","text":"晓日登临眼界宽，秋来随处好盘桓。\n燕鸿也自关时序，松柏端如保岁寒。\n伏阙惟天知对越，还家有竹报平安。\n陈情一表须留藁，要与忠臣孝子看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21269,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋对月次张行中韵","author":"凌云翰","text":"桂树悬香四散飘，金风玉露满璇霄。\n中秋有月偏澄澈，万里无云倍泬寥。\n壮志每从诗上见，闲愁都向酒边消。\n美人莫道音尘绝，只隔盈盈一水遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21270,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠铁符道人","author":"凌云翰","text":"乾刚比德行中孚，从此人间号铁符。\n学道正同关尹子，传家元自管夷吾。\n鹖冠礼斗天威近，龙剑飞空月影孤。\n偶出市廛归去晚，桂花如雪点青芜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鸡冠花","author":"凌云翰","text":"花号鸡冠类剪裁，一丛却映凤仙开。\n裹头绛帻非筹报，缠项红罗似斗回。\n久养真能同槁木，恒饥宁肯啄苍苔。\n亡陈不识孳孳意，玉树歌残后世哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"愚轩诗为上虞应信可赋","author":"凌云翰","text":"华轩结构地图雄，不似箪瓢陋巷中。\n溪姓尚能随柳子，山灵端合避愚公。\n衣冠此日何曾异，杖屦他时或与同。\n樽有春醪堪独酌，更栽佳菊待西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁巳岁腊月二十日喜雪","author":"凌云翰","text":"快雪连朝遍海涯，眼明无处著尘沙。\n腊前正欲呈三白，天下方知是一家。\n今岁连云宜宿麦，何人剪水作飞花。\n晚晴便觉春波阔，明日江头理钓槎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻钟有感次荣子仁韵 其一","author":"凌云翰","text":"曾将锦瑟思华年，追忆当年重惘然。\n五夜钟声来石枕，半生心事在韦编。\n高楼明月狂呼酒，古道西风快著鞭。\n赖有故人能过我，檐花细雨话灯前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻钟有感次荣子仁韵 其二","author":"凌云翰","text":"欲觉闻钟记昔年，老怀多感益凄然。\n轩前高柘当时种，屋上重茅近日编。\n已悟达人遗破甑，还嗤市价鬻枯鞭。\n目昏头白残灯里，始信聪明不及前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"草庭为周元亮赋","author":"凌云翰","text":"无边风月满幽居，嬴得庭前草不除。\n犹忆耳提因学礼，尚存手泽在诗书。\n傍人错比康成宅，此地真疑葛亮庐。\n我尔有轩曾种柘，宁知意思复何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼融上人","author":"凌云翰","text":"显明古刹化烟霞，甘露泉头即是家。\n薝卜结成霜后寔，枇杷开到雪中花。\n也知寂灭方为乐，始信浮生自有涯。\n写得旧时行道影，不教尘土污袈裟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清江文会诗为崔驿丞赋","author":"凌云翰","text":"清江之水如练澄，盍簪此地皆良朋。\n一钱尚怀会稽守，二松好放蓝田丞。\n忘机鸥鸟偶到座，入馔鲈鱼还可罾。\n兰亭陈巡在图画，新诗莫惜传溪藤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙仲文奉亲图","author":"凌云翰","text":"敬亭山远白云层，如此高堂岂易升。\n举足不能忘父母，介眉犹可及宾朋。\n夏萱傍砌欣同赏，春酒盈觞忆自称。\n锡类极知谁考叔，夜窗看画重挑灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林塘幽乃会稽陈惟贤轩扁又号西畴因赠诗 其一","author":"凌云翰","text":"贺监湖头一曲开，林塘幽处著亭台。\n青山在上水在下，黄鸟自啼鸥自来。\n棋局不移长对奕，酒船才放即衔杯。\n会稽我昔曾游地，杖履何时得重陪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]