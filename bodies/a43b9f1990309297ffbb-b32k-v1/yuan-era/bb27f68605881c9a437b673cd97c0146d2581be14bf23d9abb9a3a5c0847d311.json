[{"title":"和润之韵","author":"耶律楚材","text":"疏笋篱边正脱绷，故山清处便宜行。\n镜湖他日应属我，好向湖边访四明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠景贤","author":"耶律楚材","text":"茶邻药物成邪气，琴伴箫声变郑音。\n可惜龙冈老居士，却教邪教污真心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄东林","author":"耶律楚材","text":"东林已秀两三枝，覆荫人天正此时。\n贪向龙宫翻贝叶，恼人不寄玉泉诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄万寿润公禅师","author":"耶律楚材","text":"林泉人笑凤凰枝，我慕林泉叹后时。\n盼得人来问消息，太平和尚又无诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄甘泉慧公和尚","author":"耶律楚材","text":"东林枝胜桂林枝，不惜甘泉济旱时。\n铁额钢头含笑面，可人能字更能诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遗龙冈鹿尾二绝 其一","author":"耶律楚材","text":"秋水清声忽变商，龙冈曾遗二山羊。\n今年祗奉诗三首，为报先生鹿尾浆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遗龙冈鹿尾二绝 其二","author":"耶律楚材","text":"去岁山羊酬过价，今年鹿尾不值钱。\n龙冈药物都竭底，只得髯翁诗数篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤赠鹿尾二绝 其一","author":"耶律楚材","text":"日暮长杨猎骑归，西风弓硬马初肥。\n今年鹿尾休嫌少，且喜君王不合围。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤赠鹿尾二绝 其二","author":"耶律楚材","text":"禁脔酷思浓鹿汁，香蔬久厌小儿拳。\n龙冈采得班龙尾，一串穿来寄玉泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋召景贤饮","author":"耶律楚材","text":"中秋北海景凄凄，好拚今宵醉似泥。\n快请龙冈疾过我，与君同泛玉东西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"请定公住大觉疏","author":"耶律楚材","text":"龙龛宝藏照人寒，奥老功成住圣安。\n却请定公来领略，收拾香火礼旃檀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"补大藏经板疏","author":"耶律楚材","text":"十年天下满兵埃，可惜经文半劫灰。\n欲析微尘出经卷，随缘须动世间财。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武川摩诃院创建瑞像殿疏","author":"耶律楚材","text":"邦人创刻旃檀像，寺众新修窣堵波。\n两段因缘非细事，成功须仗大檀那。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"请奥公住崇寿院","author":"耶律楚材","text":"泥湫昔日隐蛰龙，一震重新大觉宫。\n却请收云归旧壑，晨昏香火礼师翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄圣安澄老乞药","author":"耶律楚材","text":"登高回首望燕山，试道新诗怨圣安。\n赚得护身符子去，二年不寄大还丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信之和余酬贾非熊三字韵见寄因再赓元韵以复之 其一","author":"耶律楚材","text":"鴳鹑徒羡大鹏南，驽马终须后袅骖。\n至理犹删万归一，庸儒刚说二生三。\n透关活眼嫌金屑，恋土痴人宿草庵。\n寄与云川贤太守，洗心涤虑与君参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信之和余酬贾非熊三字韵见寄因再赓元韵以复之 其二","author":"耶律楚材","text":"恼人捷径起终南，虚忝沙堤相国骖。\n幻术莫惊殷七七，真诠谁识后三三。\n家邻荆水宜裁竹，缘在香山好结庵。\n斫断葛藤窠已后，闲家破具不须参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信之和余酬贾非熊三字韵见寄因再赓元韵以复之 其三","author":"耶律楚材","text":"鸿雁翩翩自北南，归欤何日驾归骖。\n潜龙在下宜初九，即鹿无虞戒六三。\n洛下好游白傅寺，济源重觅侍中庵。\n衰翁自揣何多幸，昨梦斋中得罢参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信之和余酬贾非熊三字韵见寄因再赓元韵以复之 其四","author":"耶律楚材","text":"旧隐翳闾白霫南，故山佳处好停骖。\n贪嗔痴者元无一，诗酒琴之乐有三。\n菱芡香中横短艇，松筠声里称危庵。\n有人问道来相访，一碗清茶不放参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云汉远寄新诗四十韵因和而谢之","author":"耶律楚材","text":"兑爻符太一，天相忝文昌。\n泛海难追蠡，封留欲学良。\n秽形伴珠玉，朽木厕松樟。\n直节心虽赤，衰年鬓已苍。\n伴食居相府，无德报君王。\n草甲濡春雨，葵心倾太阳。\n大权归禁阙，成算出岩廊。\n自北王师发，平南上策长。\n皇朝将革命，亡国自颓纲。\n汉水偏师渡，长河一苇航。\n股肱无敢惰，元首载歌康。\n号令传诸域，英雄守四方。\n大勋虽已集，遗命未尝忘。\n万国来驰币，诸侯敬奉璋。\n兆民涵舜德，百郡仰天光。\n大有威如吉，重乾体自强。\n硕贤起编户，良将出戎行。\n太庙陈笾豆，明堂服冕裳。\n宋朝微寖灭，皇嫡久成戕。\n政乱人思变，君愚自底亡。\n右师潜入剑，元子直临襄。\n杀气侵南斗，长庚壮玉堂。\n弓犹藏宝玉，剑未识干将。\n皇业超千古，天威耸八荒。\n元戎施虎略，勇士展鹰扬。\n武继元封迹，文联贞观芳。\n宫庭敢谏鼓，帷幄上书囊。\n伫待卿云见，行观丹凤翔。\n武文能迭用，威德足相当。\n多士思登用，遗贤肯退藏。\n诗书搜鸟篆，功业抑龙骧。\n国用恒无缺，民财苦不伤。\n八音歌颂雅，百戏屏优倡。\n圣泽传朝露，明刑肃暮霜。\n永垂尘劫祚，一混九州疆。\n重任司钧石，微才匪栋梁。\n思归心似醉，感愧泪如滂。\n严子终辞汉，黄公合隐商。\n穷通真有数，忧乐实难量。\n虽受千钟禄，何如归故乡。\n乙未闰月上旬日，玉泉书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"德新先生惠然见寄佳制二十韵和而谢之","author":"耶律楚材","text":"当年职都水，曾不入其门。\n德重文章杰，年高道义尊。\n虽闻传国士，恨不识王孙。\n韵语如苏武，离骚类屈原。\n烟霞供好句，江海入雄吞。\n意气轻三杰，才名冠八元。\n著述归至赜，议论探深源。\n藉藉名虽重，区区席不温。\n家贫谒鲁肃，国难避王敦。\n北鄙来云内，西边退吐蕃。\n勉将严韵继，不得细论文。\n远害虽君智，全身亦圣恩。\n大才宜应诏，豪气傲司阍。\n学识光先哲，风流遗后昆。\n莫寻三岛客，好谒万松轩。\n六度真光发，三毒妄影奔。\n素丝忘染习，古镜去尘昏。\n炉上飞寒雪，胸中洗热烦。\n到家浑不识，得象固忘言。\n心月孤圆处，澄澄泯六根。\n乙未闰月上休日，玉泉书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子铸生朝润之以诗为寿予因继其韵以遗之","author":"耶律楚材","text":"岩松傲岁寒，枝干腾千尺。\n男儿若稽古，功名垂竹帛。\n我祖东丹王，施仁能善积。\n我考文献公，清白遗四壁。\n盛名流万世，馨香光赫赫。\n余生叹不辰，西域十年客。\n贫困志不渝，未肯忘平昔。\n昔日出燕然，辰当摄提格。\n鹑尾得凤毛，续后予无责。\n汝知学不学，何啻云泥隔。\n为山亏一篑，龙门空点额。\n远袭周孔风，近追颜孟迹。\n优游礼乐方，造次仁义宅。\n继夜诵诗书，废时毋博弈。\n勤惰分龙猪，三十成骨骼。\n孜孜寝食废，安可忘朝夕。\n行身谨而信，于礼顺而摭。\n祥麟具五蹄，溟鹏全六翮。\n为人备五常，奚忧仕与谪。\n成功不自满，始知谦受益。\n慎毋忘此诗，吾言真药石。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扈从旋师道过东胜秦帅席上继杜受之韵","author":"耶律楚材","text":"去国十年久，还乡两鬓皤。\n三川犹梗涩，百越正干戈。\n东胜城无恙，西征事若何。\n凭高吟望久，樽酒酹长河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用梁斗南韵","author":"耶律楚材","text":"丁年学道道难成，却得中原浪播名。\n否德自惭调鼎鼐，微才不可典玑衡。\n谁知东海潜姜望，好向南阳起孔明。\n收拾琴书作归计，玉泉佳处老馀生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠侄正卿","author":"耶律楚材","text":"辽室东丹九叶芳，曾陪剑佩侍明昌。\n学书写尽千林叶，习射能穿百步杨。\n兴废人间战白蚁，荣枯枕上梦黄粱。\n故山咫尺宜归去，莫使因循三径荒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄张鸣道","author":"耶律楚材","text":"张君宗派自留侯，壮岁成名入士流。\n一代诗声如玉振，千钧笔力挽银钩。\n平山邂逅初青眼，汴水伶仃已白头。\n遥想荷花好时节，故人吟倚仲宣楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送省掾郭仲仁行","author":"耶律楚材","text":"兰省而今已预名，还乡衣锦也为荣。\n辽阳干事须详悉，速驾星轺上玉京。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送燕京高庆民行","author":"耶律楚材","text":"国事烦多我政忧，上章清选倅徵收。\n好陪刘晏勤王事，早使钱如地上流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和赵庭玉子贽韵","author":"耶律楚材","text":"万里龙庭白草秋，时时归梦旧渔舟。\n酌残白酒难成醉，老尽黄花无限愁。\n久识人心多厌政，喜逢天下已归刘。\n而今子入中州去，莫惜寒梅寄陇头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠东平主事王玉","author":"耶律楚材","text":"圣主方思治，边臣未奉行。\n凭君达此意，无得负苍生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周敬之修夫子庙","author":"耶律楚材","text":"天皇有意用吾儒，四海钦风尽读书。\n可爱风流贤太守，天山创起仲尼居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄万寿堂头乞湖山","author":"耶律楚材","text":"削玉剜琼出自然，依晞岩窦吐云烟。\n禅师手段掀山岳，便好移来向玉泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄东林同参","author":"耶律楚材","text":"东林屡有寄来诗，忙里何尝报一辞。\n岂是玉泉生吝惜，言无滋味不宜时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄简堂头","author":"耶律楚材","text":"巨川生下此村牛，千百头中祗一头。\n鼻孔撩天无主伴，不风流处也风流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄孔雀便面奉万松老师","author":"耶律楚材","text":"风流彩扇出西州，寄与白莲老社头。\n遮日招风都不碍，休从侍者索犀牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答倪公故人","author":"耶律楚材","text":"玉泉回报故人书，问子参玄着意无。\n且趁万松炉?热，疾忙索取护身符。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王璘行","author":"耶律楚材","text":"天涯九日出龙沙，冬后冬前却到家。\n馈运功成须报我，好游天汉上浮槎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"继介丘穆景华韵","author":"耶律楚材","text":"北海慵倾北海樽，予怀为向景华伸。\n奇才管葛堪为匹，何事唐虞不得臣。\n行道欲期丹凤出，忘机且与白鸥亲。\n龙庭万里休辞远，六出奇画正赖陈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"继平陶张才美韵","author":"耶律楚材","text":"才美风流自一时，因风来寄湛然诗。\n新朝制度知将近，晚节功名未是迟。\n识子固为天下士，微君孰抚我民痍。\n援毫欲继清新句，笑我却无黄绢辞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"德柔尝许作鞍玉辔且数年矣作诗以督之","author":"耶律楚材","text":"异物当时许晋卿，几年思渴动诗情。\n龙庭风细沙堤软，玉辔雕鞍正好行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卜邻一绝寄郑景贤","author":"耶律楚材","text":"龙沙幽隐子真家，自拨寒泉出浅沙。\n我愿卜邻穹帐侧，旋分清酌煮新茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄岳君索玉博山","author":"耶律楚材","text":"玉炉精巧若裁肪，寄与髯翁也不妨。\n古庙多年无气息，直消一炷返魂香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云中重修宣圣庙","author":"耶律楚材","text":"槐宫悉混玉石焚，庙貌依然惟古云。\n须仗吾侪更脩葺，休教风世丧斯文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄光祖","author":"耶律楚材","text":"渔阳光祖冠当时，笔法词源我独知。\n君有家鸡君自厌，为何偏爱玉泉诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送德润南行","author":"耶律楚材","text":"燕然民庶久疮痍，摩抚疮痍正此时。\n暴吏猾胥谄君日，开缄三复味予诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和万寿润禅师书字韵五首 其一 忧道","author":"耶律楚材","text":"不肯参禅不读书，徒喧口鼓说真如。\n未能即色明真色，只道无馀已有馀。\n法眼凋残浮海去，沩山寂寞少人居。\n一从三圣承当后，季世寥寥无瞎驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和万寿润禅师书字韵五首 其二 述怀","author":"耶律楚材","text":"宝藏翻穷贝叶书，方知真理本如如。\n一心不动无生灭，万古长空岂欠馀。\n妙药更灵难忌口，长安虽贵不堪居。\n毛吞大海浑闲事，谁讶瓢中出白驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和万寿润禅师书字韵五首 其三 警世","author":"耶律楚材","text":"看尽人间万卷书，较量佛法总难如。\n本无妄疾刚寻药，幸有回波好乞馀。\n方丈名山真碧海，含元古殿是皇居。\n行人半老家何在？\n终日骑驴却觅驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和万寿润禅师书字韵五首 其四 伤时","author":"耶律楚材","text":"金马门前数上书，子虚新赋笑相如。\n万言警策才无敌，六国纵横智有馀。\n千里兵车讨奸宄，五更朝马候兴居。\n功名赚得头如雪，不悟团团如磨驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和万寿润禅师书字韵五首 其五 投老","author":"耶律楚材","text":"囊里瑶琴驾上书，个中真味更何如。\n伴闲美竹千竿许，养老田园二顷馀。\n睡起焚香诵圆觉，兴来缓轸品幽居。\n夕阳半下山偏好，吟入烟霞稳跨驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠景贤玉涧鸣泉琴","author":"耶律楚材","text":"玉泉珍惜玉泉琴，不遇高人不许心。\n素轸四三排碧玉，明徽六七粲黄金。\n临风好奏朝飞曲，对月宜弹清夜吟。\n赠与龙冈老居士，须教下指便知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丙申元日为景贤寿","author":"耶律楚材","text":"龙沙一住二十年，独识龙冈郑景贤。\n诗笔饶君甘在后，琴棋笑我强争先。\n冷官何啻广文乐，归计犹存谷口田。\n劫外壶天寿无量，请公勤叩祖师禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"景贤作诗颇有思归意因和元韵以勉之","author":"耶律楚材","text":"我访龙冈老，珠玑咳唾间。\n酒熟香馥馥，琴滑水潺潺。\n王吉中栽菊，和林也有山。\n但能心放下，何处不安闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"景贤召予饮以事不果翌日予访景贤值出予开樽尽醉而归留诗戏之","author":"耶律楚材","text":"昨朝命我初无兴，今日寻君不在家。\n不问主人都饮尽，醉吟倒载黑毡车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤召饮韵","author":"耶律楚材","text":"书满穹庐酒满樽，龙冈召我谢殷勤。\n琴中别有无弦曲，醉里开怀举似君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丙申上元夜梦中有得","author":"耶律楚材","text":"超佛越祖透真空，也与沩山说梦同。\n面貌眼睛鼻孔里，大千沙界一沤中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送门人刘德真征蜀","author":"耶律楚材","text":"门弟辽阳刘德真，刚直木讷近乎仁。\n怜君粗有才学术，师我精通天地人。\n今日从军征两剑，他时拥旆入三秦。\n三辰测验须吾子，创作天朝宝历新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送门人刘复亨征蜀","author":"耶律楚材","text":"诚之识我二十年，不读经书不学禅。\n误尔儒冠好投笔，过人勋业好加鞭。\n浣花溪畔春如画，濯锦江边酒似川。\n壮岁从军真乐事，邓侯遗躅勉争先。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵州柏树颂","author":"耶律楚材","text":"古佛犹存旧道场，庭前依旧柏苍苍。\n莫谤诸州无此语，禅林奔走错商量。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄龙三关颂 其一 我手何似佛手","author":"耶律楚材","text":"称头斤两须端的，短少毫釐不可欺。\n函关辨认合同券，未肯轻轻放过伊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄龙三关颂 其二 我脚何似驴脚","author":"耶律楚材","text":"行令如同车脚圆，你三文后我三钱。\n直饶道底分明是，也是当年鹦鹉禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄龙三关颂 其三 如何是上座生缘","author":"耶律楚材","text":"只打野盘无寺宿，不供糊口趁村斋。\n上户莫桩虚物力，僧司无得错推排。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和太原元大举韵","author":"耶律楚材","text":"魏帝儿孙气似龙，而今飘泊困尘中。\n君游泉石初无闷，我秉钧衡未有功。\n元氏从来多慷慨，并门自古出英雄。\n李唐名相沙堤在，好与微之继旧风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜和林新居落成","author":"耶律楚材","text":"登车凭轼我怡颜，饱看和林一带山。\n新构幽斋堪偃息，不闲闲处得闲闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题新居壁","author":"耶律楚材","text":"旧隐西山五亩宫，和林新院典刑同。\n此斋唤醒当年梦，白昼谁知是梦中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]