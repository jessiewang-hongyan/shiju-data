95f79689","path":"元.csv","pointer":7958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午憩村落竹溪上","author":"范梈","text":"竹连流水水缘村，上有青山荫苎园。\n此处不容居士住，短墙午暑特侵门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"日晏","author":"范梈","text":"昨日相期早出村，今朝日晏未开门。\n可人一夜东风雨，绿遍天街旧草痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月三日，蚤作，访夏编修","author":"范梈","text":"晓穿甲仗抵晴沙，桥角垂杨乱映花。\n春色于人元不薄，将诗勾引到君家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答赠晚春","author":"范梈","text":"懒向佳人说翠微，长安陌上见春晖。\n谁家门巷花狼藉？\n吹作漫天白雪飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初六日，在院中，僚友无人至","author":"范梈","text":"乘舆闻喜达皇都，自此玉堂宣锁无。\n闲杀幕中挥翰手，日长独坐数花须。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因杜右父编修赠痔医","author":"范梈","text":"舐痔曾闻获乘车，王卿妙艺复何如？\n祇应杜老波澜笔，绝似齐人治验书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"院中夜直","author":"范梈","text":"此身只似到南州，莎草寒鸡一片秋。\n后夜玉堂谁上直？\n料应少睡更多愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠黄道士别","author":"范梈","text":"二十四岩烟雾幽，轻舟横笛戏清流。\n万人举手风尘下，怪杀仙人学远游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邻灯","author":"范梈","text":"星星远映孤村外，炯炯微穿落木间。\n知有邻姬思远道，绩麻应待夜深还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"休日","author":"范梈","text":"暂解晨参不出关，有时持酒忆南山。\n无端却被诗牵引，断送先生此日闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十一月十六夜","author":"范梈","text":"本是圆时半不明，非缘掩冗复何情！\n更无云表真消息，钟鼓盆罂乱自鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题二牛","author":"范梈","text":"燕山丈人年九十，戏笔扫此双犁牛。\n江南夜半春雨作，老农惊起为君愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离扬州","author":"范梈","text":"孤篷如磨绕汀沙，叶满平湖藕未花。\n回首竹西亭渐远，一江烟雨酒旗斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠裴氏二子","author":"范梈","text":"有后深知晋国贤，伤心不为海南边。\n相逢莫笑无多赠，犹是词垣旧俸钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过三合驿","author":"范梈","text":"一春归计又蹉跎，穷粤风光奈病何。\n总有青山千万叠，行人长少鹧鸪多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江阁雨望图","author":"范梈","text":"高阁秋风树半枯，连山更带雨馍糊。\n幽人把钓空江上，纵有扁舟不受呼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"见观西人家石榴","author":"范梈","text":"石榴始华实已红，橘柚照日青玲珑。\n自来南州感风物，赖得邻人生意同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月十一夜，东署闻雁","author":"范梈","text":"久别云林旧草亭，南江都邑岁雕零。\n可怜此夜长空雁，正在青松树底听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诘朝，进书西宫，问卢九修撰借马戏奉绝句","author":"范梈","text":"作书太史具有喜，徒步拾遗方可忧。\n明日待朝天上去，何由赠我紫骅骝？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高斋","author":"范梈","text":"俗客过门应有数，祇言浑似野人家。\n小斋高接万林杪，坐见城南城北花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"候孔校书","author":"范梈","text":"承闻舟楫向河干，久别深思再见难。\n已具一尊林下酌，好来共慰百华寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]