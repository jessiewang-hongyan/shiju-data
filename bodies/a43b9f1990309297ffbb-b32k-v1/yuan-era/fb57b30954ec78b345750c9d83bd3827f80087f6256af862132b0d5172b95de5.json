[{"title":"客遗木香酝","author":"黎伯元","text":"黄封恩赐梦寥寥，胸次何时磊落浇。\n才士日新惭楚酝，酒徒星散守颜瓢。\n霞生双脸衰能壮，春透三池渴渐消。\n酝酿太平谁曲蘖，弓旌未许傅岩招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饮后","author":"黎伯元","text":"入髓无声春气骄，填胸幽愤赖渠消。\n玉山此际何妨倒，坟土他年不用浇。\n北海坐宾常故满，少陵社日岂辞邀。\n惊秋客意偏宜饮，得句还堪慰寂寥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读敲月集","author":"张文斋","text":"小山先生信英杰，蚤岁穷经诣丹阙。\n太学游歌姓字香，京华旅食乡心切。\n一朝拂袖辞金门，归隐山林计非拙。\n乐道能存颜子风，干时肯掉苏张舌。\n筑庵喜延湖海士，大书华匾名敲月。\n花晨露夕多胜事，对饮豪吟未尝辍。\n长篇短句每惊人，律吕和鸣珠玉洁。\n建安七子当并驾，唐室诸贤可同列。\n才名奕奕闻海隅，家世遥遥在南越。\n倏然竟赴玉楼招，西风吹老岩阿蕨。\n我疑先生列仙侣，一段情怀尽冰雪。\n暂来林壑学巢由，不向朝廷随稷契。\n嗟我胡为生较晚，不得抠趋受诗诀。\n几回窗下读遗篇，敲碎唾壶歌激烈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答邑伯何公","author":"袁德裕","text":"天南保障仗元戎，智略渊深识窦融。\n儿女姻娅还爱我，英雄事业不如公。\n閒鸥惯睡江头月，战马频嘶岭上风。\n百战山河终有主，伫看麟阁纪肤功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其一","author":"袁德裕","text":"白沙翠树绕江村，曲水湾湾绿到门。\n我已廿年耽小隐，避秦何必武陵源。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其二","author":"袁德裕","text":"好雨初晴两岸风，一溪春涨泛桃红。\n夕阳欲坠江亭晚，卧看渔师拾钓筒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其三","author":"袁德裕","text":"江南江北绿成烟，野水分秧上暮田。\n频报芷溪春雨足，荷蓑人竞策乌犍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其四","author":"袁德裕","text":"黄鹂才唤午眠醒，閒检茶经户半扃。\n好是昼长天气困，朦胧烟雨暗沙亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其五","author":"袁德裕","text":"薰风骀荡景悠悠，几树鸣蝉白雨收。\n夹岸红云舟一叶，有人啖荔到湾头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其六","author":"袁德裕","text":"菰蒲黯淡水云居，又是凉风白露馀。\n红树半江人晚渡，上滩齐唤买鲈鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其七","author":"袁德裕","text":"江田千顷晒黄云，共说今年稔十分。\n合煮长鎗酿春酒，古松林下醉斜曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沙亭杂咏 其八","author":"袁德裕","text":"著书年月等闲过，弹指光阴奈老何。\n水竹幽居无历日，梅花空记岁寒多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春吟","author":"马桂逊","text":"青山去郭六七里，绿树拂檐三两家。\n山静冲寒幽鸟起，金樱藤上有残花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初夏","author":"张撝","text":"何事愁春去，微薰生日斜。\n梅黄初著雨，莺老未残花。\n便汲悬泉水，閒烹废寺茶。\n逢僧谈五乘，摩诘已无家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"厓门怀古","author":"张撝","text":"渔翁知我閒无事，拉我乘舟访鼎湖。\n野草闲花春寂寞，蛮烟瘴雨昼模糊。\n磨厓可羡张弘范，把酒惟浇陆秀夫。\n兴废由来总天命，临风何必更长吁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"飓风","author":"张撝","text":"火云夹日已西驰，骤雨惊风此一时。\n万里怒涛泛断梗，千家矮屋失疏篱。\n悬炊破釜侵飘屋，护圃枯榽压嫩枝。\n最是畬田收未得，不堪狼戾子离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题观翠亭","author":"张撝","text":"亭前积翠景新添，瞻眺还堪养静恬。\n排闼青山悬叠嶂，翳林瑞霭隔疏帘。\n入图雁荡徒飞梦，绚碧罗浮那得兼。\n天趣也知随处有，閒来相赏莫相嫌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"芝山别意","author":"张撝","text":"晚山黄菊满山房，送客郊原野气凉。\n十幅布帆随鸟影，一川图画载舲航。\n秋风祖道归心急，夜雪催诗赏兴狂。\n好事歌成碑在口，王家父子正相当。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题柱","author":"葛道人","text":"罗浮山下策枯藜，琪树琼林属品题。\n两腋天风何处去，锦岩西更碧云西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登腊岭顶","author":"李鼎","text":"披云千仞顶，纵目万重山。\n归鸟来三楚，飞霞出百蛮。\n南经秦代郡，北是汉时关。\n今古兴亡事，纷纷一梦间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画壁诗残句","author":"陈大娘","text":"百年尘事浑如梦，留与丹心照汗青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉歌","author":"梁彦明","text":"子陵去兮已千秋，江湖渔乐兮谁与俦。\n富贵显达兮将焉求，溪歌野舞兮聊以忘忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上指挥俞良辅引","author":"郭贞顺","text":"将军开国之武臣，早附凤翼攀龙鳞。\n烟云惨淡蔽九野，半夜捧出扶桑轮。\n前年领兵下南粤，眼底群雄尽流血。\n马蹄带得淮河冰，洒向江南作晴雪。\n潮阳僻在南海濒，十载不断干戈尘。\n客星移处万里外，天子亦念遐方民。\n将军高名迈前古，五千健儿猛如虎。\n轻裘缓带踏地来，不减襄阳晋羊祜。\n此时特奉圣主恩，金印斗大龟龙纹。\n大开藩卫制方面，期以忠义酬明君。\n宣威布德民大悦，把菜一笠谁敢夺。\n黄犊春耕万陇云，氂尨夜卧千秋月。\n去岁壶阳戍守时，下车爱民如爱儿。\n壶山苍苍壶水碧，父老至今歌咏之。\n欲为将军纪勋绩，天家自有麒麟笔。\n愿续壶民歌太平，磨崖勒尽韩山石。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归宁自叙时年已一百二十馀岁。伯玉与季子先作，已祀乡贤","author":"郭贞顺","text":"天甲年来度二周，暮桑榆景雪盈头。\n五经立业儒家雅，三子成名壮志售。\n桥梓有光联俎豆，柏舟无憾泛横流。\n阶前兰玉森森秀，斑綵扶来到首丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔","author":"郭贞顺","text":"朝泛苍浪水，暮归鹦鹉洲。\n一丝抛下处，牵动海天秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵","author":"郭贞顺","text":"脚踏千峰雪，肩担万里云。\n斜阳归去路，挑入燧人村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕","author":"郭贞顺","text":"身处茅茨陋，天开绿野宽。\n因天分地利，春雨一犁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牧","author":"郭贞顺","text":"目断羊肠险，身骑牛背安。\n夕阳芳草外，短笛数声寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和忠佑庙咏韩木韵","author":"张智甫","text":"死生种木昉于唐，木到于今色倍苍。\n有大才名蜀相柏，无穷教思召公棠。\n人怀遗爱谁甘斧，天鉴孤忠不忍霜。\n愿与灵株长不朽，韩山山上一炉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"歇甘露寺","author":"张智甫","text":"额分甘露自枫宸，偶作郊行认不真。\n屋讶天台小方丈，僧疑石室老功臣。\n半霄云雾闻人语，一块虚空挂佛身。\n要识此山奇绝处，石间诗句最精神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山行有感","author":"张智甫","text":"菜一盆儿饭一锅，间关石窍作生涯。\n山林纯是欢娱鸟，天地不开烦恼花。\n荒草田园元亮屋，浮萍弟妹少陵家。\n此身不得如微物，有触令人重叹嗟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中忆故友","author":"张智甫","text":"自从学舍厄戈矛，畴昔文盟一霎休。\n不见新诗来饭颗，似闻哀诔满瓜丘。\n未寒梦绕梅边驿，才暮心悬雪里舟。\n愿入东都名节党，如今尚有几人不。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题翠香楼","author":"张智甫","text":"危楼独上几咨嗟，望眼何由见翠华。\n一水空流残月去，万山枉被乱云遮。\n士夫不运中原甓，将帅谁鸣半夜笳。\n衰草寒烟凝睇望，何人犹唱后庭花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"省官命诸生为守城马发挽诗欲为申奏立庙","author":"洪必元","text":"伏波裹尸还，马璘苦战死。\n至今骨犹香，勋名照青史。\n桓桓马将军，或疑其孙子。\n逾月婴孤墉，四面集飞矢。\n生不为降俘，死期为厉鬼。\n小卒窃开关，大兵遂劘垒。\n满城血为池，全家脑涂地。\n英雄为痛心，三十馀年矣。\n阴房野燐青，坏道丛祠圮。\n天朝未旌忠，谁为血其祀。\n名公访古迹，立马斜阳里。\n临风叫英魂，月寒天在水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万卷楼登高","author":"黄惟贤","text":"潮州书楼天下稀，摩插云汉吞秋晖。\n人间健步方到得，世上弱羽安能飞。\n诸君于此兴不浅，乐士与我心无违。\n拍阑长啸饮义酒，一览众山拳石微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潮人朝京道中","author":"黄益","text":"何事若波查，翻令忆在家。\n乱山随去马，落日认栖鸦。\n田野生涯尽，关河去路赊。\n断桥人不渡，拂石看黄花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿黄芦站","author":"黄益","text":"古道树叉丫，青帘认酒家。\n有山无树色，多雪少梅花。\n雁影云垂地，鸡声月在沙。\n百年兴废尽，何处问桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢郡守王宁轩","author":"莫肃震","text":"泮水溶溶，新庙有颙。\n飞柳罗星，栋梁揭虹。\n黝垩丹青，百堵皆崇。\n东西从祀，有睟其容。\n冠佩裘舄，几几雍雍。\n千古万古，圣道尊隆。\n泮水漪漪，芹藻其碧。\n青青子衿，斯游斯息。\n顾谓余言，伊谁之力。\n曰我王侯，丰功硕德。\n可镌可镵，彝鼎金石。\n与庙齐休，垂之罔极。\n思乐泮水，薄采芹藻。\n王侯戾止，其马蹻蹻。\n我有子弟，侯训教之。\n我有老贫，侯廪稍之。\n我人好之，何以报之。\n既富且贵，永锡难老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏何节妇","author":"张彦谦","text":"江戈落落瘴江涯，多少佳人忍辱时。\n独尔舍生能一死，洁身泉下见男儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"坠齿示儿孙","author":"马德龙","text":"齿坠中庭未足尊，留传后代子和孙。\n珍珠财宝随时有，睹物思人若个存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东山庙新兴","author":"林宗山","text":"直气神如在，常为此地灵。\n拓开千仞峻，巍镇一峰青。\n剑戟依瑶砌，龙蛇蛰翠屏。\n愆阳或时作，凭仗起雷霆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忠景庙德庆","author":"蔡尽忠","text":"不受生前辱，应荣身后封。\n竹抽忠义节，雨过大夫松。\n长洒英雄泪，空浇磊落胸。\n倚空长剑在，千古仰高风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七星岩","author":"施昌祚","text":"巍峨石壁镇端州，与客登临最上头。\n树色空濛山雨过，岩光摇落水云浮。\n参天绝巘亭亭立，环壑清泉细细流。\n驰逐宦途耽吏隐，临风偏羡赤松游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"葫芦石","author":"泰圃华","text":"当年移檄致山灵，凿破苍苔一段青。\n树映高低云上下，杯流潋滟水清泠。\n草茵铺地天为幕，林障排空山作屏。\n石上醉馀无一事，朗吟閒步翠岩亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题九成台","author":"李齐贤","text":"凤不来兮辽东海，高台已荒天未改。\n当时别舜返昆丘，如何一去三千载。\n人间岂无青琅玕，孤栖未必天霜寒。\n致君尧舜我有术，来仪好向虞廷间，凤兮凤兮今当还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"圆明庄","author":"黄子长","text":"圆明庄在海之隈，老我寻幽始一来。\n自是好山藏世界，非关弱水隔蓬莱。\n鸥沙鹭渚皆宜稼，粉壁雕墙半是苔。\n笑问檀那黄氏子，许多因果为谁栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南恩州古谣","author":"佚名","text":"汀洲青草连，南恩出状元。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古碑诗词","author":"佚名","text":"嘉树拂五云，大鹏垂万里。\n海门浪汹涌，春龙从此起。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"峡山飞来寺","author":"李质","text":"两峰对峙拥苍虬，绿水湾边系綵舟。\n古寺飞来山色老，野猿啼破月明秋。\n林间采药知仙近，物外看云悟世浮。\n珍重同游二三友，一杯聊复暂时留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山乾明寺","author":"李质","text":"只履西归不可寻，祇馀足迹踏岩阴。\n法留正印灯传远，字记名公石刻深。\n蓊若黄云腾瑞气，跫然空谷继遗音。\n千年赏识惟朝使，即此登临见佛心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵云五景诗 其一 悠然佳趣","author":"李质","text":"南轩山色最宜秋，积翠千峰宿雨收。\n对客无言心自得，看云忽悟世俱浮。\n风烟变态朝还暮，景物娱人去复留。\n不待淮南去招隐，便应从此赋归休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵云五景诗 其二 翠暖长春","author":"李质","text":"面面晴岚列画屏，东君着意去经营。\n十分冰雪寒难到，万古烟霞染不成。\n雨暗莓苔云气合，天开金壁日华明。\n何时得共逍遥侣，来此吹箫引凤鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵云五景诗 其三 翠微清晓","author":"李质","text":"空翠蒙茸月影微，晨光淡荡照窗扉。\n遥瞻旸谷羲和驭，怅望西河织女机。\n烟草星沉收熠耀，露荷风动泻珠玑。\n幽人久住看山色，不觉寒生白苧衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵云五景诗 其四 枕流琼响","author":"李质","text":"洗耳巢由不可招，偶听流水到溪桥。\n泠泠似恨知音少，脉脉应怜出壑遥。\n湘女冰弦凝欲咽，鲛人珠泪滴还消。\n微涓混混无晨夕，此去终当大海潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵云五景诗 其五 息肩馀暇","author":"李质","text":"日午樵归已觉疲，每来亭下坐移时。\n歌声谷口如相答，柯烂腰间总不知。\n寂寂心灰吾独冷，营营形役予何痴。\n白头名士投簪晚，输与寻常牧竖儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三洲岩","author":"李质","text":"海外三洲隔弱流，凭谁移近锦江头。\n天开混沌应重设，地拥穹窿不计秋。\n岩溜储精凝玉乳，崖松笼月走金虬。\n我来几度寻幽赏，谩把新诗记胜游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒李忠简公祠诗","author":"李质","text":"传胪早已擅英声，疏草忠勋答圣明。\n解组独悬归梓里，下帷曾忆驻蓬瀛。\n云霞一片祠宫色，伏腊千年俎豆情。\n海内共推瞻北斗，高风何但重乡评。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄怀龙江麦德贞","author":"李质","text":"旷怀殊未倦，壮思忘奔走。\n对月卧吹箫，看花坐呼酒。\n百年大造中，荣华易凋朽。\n我及少年日，托身在林薮。\n常怀居山念，忆尔烟霞叟。\n独倚南窗前，长歌延伫久。\n兴发促扁舟，乘流下江口。\n云山忽过眼，僮仆立门候。\n自恨归来迟，将言谢亲友。\n怅望夕阳寒，白云远还岫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"康山旧隐","author":"李质","text":"老樵家住康山巅，别来回首今十年。\n红尘汨没馀白发，欲寻旧隐归无缘。\n绣衣仙人妙探玄，怜我老病思林泉。\n笑驱六丁截坤轴，康山移置高台悬。\n丹崖翠壁回翔鸾，寒藤古木含风蟾。\n樵云径行涧底路，青苔白石溪溅溅。\n苍松手植初齐眉，灵虬夭矫将参天。\n云间数椽旧茅屋，至今风雨犹依然。\n小桥当门度流水，窗扉倒影涵清涟。\n雨馀风日问晴轩，林霏空翠飘兰荃。\n平生知己二三友，相过不待相招延。\n把书对弈坐终日，纶巾羽服沧洲仙。\n杖藜扶衰一老年，采芝长入藤萝烟。\n意行常与鹿为伴，兴来渴想杯如川。\n某山某水钓游处，摩挲历历俱眼前。\n乃知尘世等梦幻，百岁一枕槐根眠。\n倘蒙圣恩赐归田，拟办布袜青行缠。\n山中故人不遐弃，定有招我归来篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题胡将军虞山秋猎图","author":"李质","text":"虎头将军人中英，六年总制南州城。\n蛮烟扫尽民安堵，闲来训练三厢兵。\n是时天高秋色晶，元戎小队临郊坰。\n出奇应变有成算，长围蹴踏虞山平。\n挥戈日回羲和驭，饮马水落黄芦汀。\n西猰逐兽奔流星，落羽电掣辽东鹰。\n妖狐狡兔何足顾，等閒刺虎屠长鲸。\n争誇得隽笳鼓清，抚剑叱吒风云生。\n旌旗归来日未落，毛血满载驼峰腥。\n分甘设宴享多士，雄吞直欲杯沧溟。\n将军文武能兼并，十年从事天王征。\n定功行赏协舆论，遐荒重镇须老成。\n花村月夜犬不吠，闾阎歌颂腾欢声。\n左参好事驰令名，题诗作画扬芳旌。\n观风万一言采择，写入麒麟垂汗青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和刘三吾所寄","author":"李质","text":"水馆曾留奉使槎，至今粉壁灿天葩。\n题诗旋擘芭蕉叶，中酒常呼茉莉茶。\n夜月半窗怀旧雨，春风一榻属谁家。\n人生百岁青槐梦，莫向流年空自嗟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过淮西山","author":"李质","text":"长江天堑限西南，过客推篷酒半酣。\n日出林扉晴作雾，雨馀烟树晚生岚。\n八公草木今无恙，五老云松久不堪。\n王气钟灵豪杰出，谁从年少识龙髯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独秀山","author":"李质","text":"自有乾坤有此山，青天削出玉孱颜。\n风云朝夕相摩荡，日月东西互转还。\n秀拔重门当北斗，尊居五岭镇南蛮。\n欲凭高处穷双目，绝顶崚嶒不可攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]