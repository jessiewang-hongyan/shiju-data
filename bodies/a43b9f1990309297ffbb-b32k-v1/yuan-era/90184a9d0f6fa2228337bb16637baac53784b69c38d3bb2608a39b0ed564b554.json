[{"title":"楚楼镇志曰：汉大将焚船处也，今为文昌县。怀古，奉简邑文学","author":"范梈","text":"龙节迢迢去不归，汉家将军建国威。\n当时曾见楼橹集，异代空闻尘土飞。\n风压春潮吞乱屿，岸分古木转斜晖。\n旁人犹解祠神女，何故功臣庙貌稀？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日","author":"范梈","text":"今辰春节喜新晴，况是山堂此日成。\n畦菜拨余传叶美，径桃留在着花明。\n云开葛井蛟龙动，雪尽萧岩鹳鹤鸣。\n失喜浪传京邑信，未闻邻舍识高情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题何处士竹阁","author":"范梈","text":"吴汉仙翁丹井西，君家高阁俯清溪。\n泠泠修竹莺时到，井井空烟鹳昼啼。\n解带欲围苍雪远，敲门待看绿阴齐。\n何当试答登临愿？\n系马宅前杨柳枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"屈原庙前观雨，雨止，渡口观鱼","author":"范梈","text":"乍来倏去峰前雨，半落未开沙际花。\n春远客怀淹燕雀，年荒民命假鱼虾。\n徒闻黄霸能为郡，岂识张骞苦泛槎。\n早谓仙人无世虑，山深往往饭胡麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毛炼师奉祠礼成还京","author":"范梈","text":"仙官持节下青冥，海渎严祠卫百灵。\n行为治平循禹服，礼从禋祀想虞廷。\n东风到处随神雨，南极归来奏寿星。\n致福要当宣室问，鹤书先报白云扃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鼋潭墋","author":"范梈","text":"征夫鱼贯涉秋唇，树底照见石磷磷。\n攀缘惟有千古意，摇落独如三月春。\n天清过涧猿饮子，日宴噪林鸡警人。\n七曲棹歌谁按得？\n他年重问墋头津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄隐君秋江钓月图","author":"范梈","text":"旧识先生隐者流，偶因图画想沧洲。\n断云满路碧窗晚，明月何年青嶂秋。\n世故风尘双短屐，生涯天地一扁舟。\n何由白石空矶畔，招得人间万户侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄上甘肃吴右丞三首 其一","author":"范梈","text":"要使唐虞化远覃，玉门关下屈征骖。\n多忧总为民心苦，有喜惟闻郡姓甘。\n日晚边沙黄浼浼，天晴陇树碧毵毵。\n国风不系秦州外，自此西人识召南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄上甘肃吴右丞三首 其二","author":"范梈","text":"历数先朝辅弼贤，如公孰可语同年？\n二童一马临荒镇，百感千忧倚上天。\n深厚已闻鸾诏趣，平安不用雁书传。\n别来濯濯春城柳，谁信秋风慰目前？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄上甘肃吴右丞","author":"范梈","text":"塞上孤鹰白雪毛，塞门风物静萧骚。\n黄河西去从天下，泰华东来拔地高。\n枸杞莫将如薏苡，醍醐足饮胜蒲萄。\n遥瞻圭衮还朝日，正属江湖心绪劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭茂才要饮舍下，忽报董中丞灵柩自上都至，出城迎之，遂负此约，戏题奉谢","author":"范梈","text":"相期把酒对秋晖，忽报中丞旅榇归。\n遂逐城东朝骑发，遥怜江口夕鸿飞。\n陶潜宅隐波吞石，谢傅山寒雨打扉。\n人事虽殊风物在，笑谈岂可眼中稀？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月十九日京东门与董右军诸公别至通州还寄在京朋游","author":"范梈","text":"临分强颜作笑言，上马恸哭投烟村。\n十年总仗旧交力，万里独怀明主恩。\n南极下头星象少，东风近便柳梅繁。\n时人祗怪丹砂令，曾以虚名细讨论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山斋","author":"范梈","text":"山斋朝雨竹光匀，茶灶催添石火新。\n对语黄鹂真不俗，飞来白鹭净无邻。\n辞荣岂敢要时论，赏静犹应愧古人。\n报道林河春涨起，少须重理旧丝纶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山斋二首 其二","author":"范梈","text":"幽栖自是少经过，药裹书囊奈癖何！\n仙井朝来云气重，洞房夜尽雨声多。\n江湖耆旧深思忆，台馆风威尚琢磨。\n自尔索居增固陋，负苓谁问首阳阿？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈从事归江东二首 其一","author":"范梈","text":"长年京下送人归，初及扁舟指翠微。\n岂意遂闻鸿鹄操？\n却须同制芰荷衣。\n清江碧树重重见，紫燕黄鹂处处飞。\n如此交游二三辈，何因中岁每相违？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈从事归江东二首 其二","author":"范梈","text":"吴侬呼剑每通神，铸作由来极苦辛。\n天下纵无增价士，夜中须有识光人。\n即今况蹑青云地，何日重翻紫陌尘？\n令弟两街清显甚，定应携手接星辰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"傅之经历谒告还湘中，未语别而宵征。翌日，与僚友追送生居亭中二首 其一","author":"范梈","text":"美人归思落沧波，昨者论心肯重过。\n寒尽极知春意在，夜深无奈月明何。\n海隅虽暂违霜幕，天上应须接玉珂。\n如此才贤移病去，瘴烟端的为谁多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"傅之经历谒告还湘中，未语别而宵征。翌日，与僚友追送生居亭中二首 其二","author":"范梈","text":"北风尽日破南溟，行路经年倚寿星。\n子自全家依翠岳，我犹万里隔青冥。\n山田鹿下投书去，水馆猿啼却坐听。\n王事驰驱知有素，何由重见此邮亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月九日诣天光门上进三朝实录","author":"范梈","text":"仪鸾簇仗满云端，玉钥初开众乐攒。\n三后龙光周典册，群臣鹄立汉衣冠。\n炉香著日浮晴霭，宫树斑霜试晓寒。\n千骑前头都不避，祇传学士拜金銮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画马","author":"范梈","text":"一自房星下渥洼，龙媒多在玉皇家。\n赤毛洒血微生汗，黑晕团云整作花。\n不待老能知失道，固应来是涉流沙。\n如今岂少真神骏，犹有丹青纸上誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石氏寿母","author":"范梈","text":"鹤发西风尚健身，彩衣天上四麒麟。\n尔门皆可二千石，此母何妨五百春？\n露下齐山红树晓，雨生滦浦绿波匀。\n胜筵偶睹诸贤咏，尽敬东州学士醇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归来","author":"范梈","text":"十载归来问草堂，入门喜见葛山苍。\n慈亲已慰占乌鹊，稚子行堪咏凤凰。\n新理园池几创物，小移松柏且分行。\n卜居未是居难卜，为恐傍人议楚狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和柳提学赠危太朴","author":"范梈","text":"伐木丁丁秋满山，诗筒忽到与开颜。\n当时有客谙花洞，此地经年上竹关。\n绝域尚怀身倚剑，深居曾梦手持环。\n文章政类龙多变，识察能通豹几斑？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题新喻吴氏浩然堂遗事","author":"范梈","text":"钓矶西畔问宜州，回首空山又数秋？\n曾见龙蛇飞败壁，每疑鱼鸟逐扁舟。\n风云一变衣冠地，城郭重来水石幽。\n传得眉山遗记在，吴家子弟更风流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过邻人园林","author":"范梈","text":"隐者园林昼不哗，冠山楼阁护青霞。\n平安日上琅玕竹，富贵春行锦绣花。\n高鸟时排朱槛过，远溪正带白云斜。\n江城只解听丝管，何处能来玉女车？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金凤","author":"范梈","text":"金凤阶前只漫生，移栽行列甚方平。\n新来两本当轩出，各吐幽花照眼明。\n夏雨要将苏众槁，朝阳端已瑞先鸣。\n勿云小草精神短，每论韶箫记尔名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠杨茂才","author":"范梈","text":"西风淅淅风雨生，南塘萧萧楼观清。\n玄蝉抱树一时息，老鹤怀山终夜鸣。\n放形海岳等云水，托好音书犹弟兄。\n未知此别会何日？\n为子商歌无限情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠王文学","author":"范梈","text":"法乐洞天曾一游，君家闻在水西头。\n石潭密映藤萝月，山叶深藏虎豹秋。\n岂意吴城祠下路？\n共寻扬子岸边舟。\n胸中富有天官学，莫为东南久滞留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"到京之七日，亲祀礼成，闻喜有作，简曹奉常","author":"范梈","text":"南征被命过柴荆，瘴土归来湿病婴。\n行拨烟霞归上界，卧听风雪打长更。\n侍祠想重鸣珂密，出次知先警鼓清。\n拂晓斋宫闻好语：谁人不贺泰阶平？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辛酉岁元日","author":"范梈","text":"西山千仞郁崔嵬，山下楼台紫翠开。\n玉帛会同来万国，玑衡悬运属三台。\n尝闻海客谈金鼎，更见祠官进玉杯。\n惭愧词臣今白首，久无赋颂献蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵送人之五羊","author":"范梈","text":"豫章远接五羊城，白鸟飞还道路明。\n昔我乘桴游汗漫，今君揽辔度峥嵘。\n湖堧夕下潮声转，斗角寒深宝气横。\n总为观风扬职业，有诗才不负兹行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月一日，度毛竹山","author":"范梈","text":"毛竹山高风物幽，夜宿白云新雨收。\n沿溪而上钟鼓导，自昔以来仙圣游。\n久知地迥飞猿黠，新喜天空鸣鸟稠。\n折险萦危尽吾力，此行聊不负司秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曾教授赴韶州","author":"范梈","text":"荔子红边五月初，广文去住定何如？\n报恩岂恋将军马，治盗聊迂太守车。\n多近藤萝安吏舍，少凭椒葛附音书。\n到官定有佳声荐，瘴雨蛮烟细祓除。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"获鹿西郊，在樵舍下十里。鹿脱阱走山麓，余驱骑者踣之，以缚自随。时藩兵方燎原，靡得观者传讶","author":"范梈","text":"猎人大火布江矶，准备平章旦出闱。\n麀鹿齐看赤手获，鸷鹰犹傍碧云飞。\n呦呦尚想山居纵，麌麌宁忘野食肥？\n天上神仙不得力，心安束缚从吾归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"靖海县","author":"范梈","text":"海县春深沙气暄，居人生事不离村。\n上梯取斧料桑尾，抽橛移舟系柳根。\n已过清明违帝里，不妨红白遍江园。\n持杯试与酬风物，深愧樊迟学圃言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百丈春日纪怀三首 其一","author":"范梈","text":"江墅群芳手自栽，春前相次斸苍苔。\n邻僧昨许山兰送，社妪新分圃药来。\n本为圣情思共济，更饶生事得相催。\n粤王溪畔韶光好，谁想经年逝不回？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百丈春日纪怀","author":"范梈","text":"东风久不到新堂，生意虽微未卒荒。\n草上葫荽偏挺特，花间芦菔故高长。\n时来岂尽栽培力，物化须知长养方。\n葵藿有心终莫夺，每闻支笏照沧浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百丈春日纪怀三首 其三","author":"范梈","text":"飞飞燕子守绳枢，爱尔由来似凤雏。\n肯谓撩人嗔坐对，向曾去我忆巢孤。\n涂泥须责经营苦，爪觜无供啄哺娱。\n春社风光时有再，天生品汇各悬殊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太朴缄至君静清诗，读之慰快。斯文凋敝之余，安得见此杰然者？敬叹敬叹。一诗寄谢并简君瑞，要知于二贤倾倒之至也","author":"范梈","text":"元丰宗匠是吾师，幽梦江湖每见之。\n在昔才名真盖代，祇今子弟好能诗。\n六经更待黄麻拟，双剑终因紫气知。\n衰疾连秋犹长物，扁舟未到谢相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊张炼师","author":"范梈","text":"名家接武依丹陛，壮岁招魂入翠微。\n遂使老聃成自吊，不知丁令竟何归？\n蛇蝉岂恋寻山蜕？\n鸡犬曾闻挟日飞。\n独有皇恩无以报，昨传天语慰松扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李原李翁","author":"范梈","text":"鲁国先生九十余，百年消息定何如？\n世情看作东流水，天地留恩下泽车。\n陇西供奉岂无酒？\n河上丈人空有书。\n见说乡邻问何事？\n扣门语及莫钟初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题集贤周司直悠然阁","author":"范梈","text":"番阳东下万山围，魁阁峥嵘面翠微。\n云接大荒回古色，波涵落木动晴晖。\n宦情静与游鱼逝，诗思长随夕鸟飞。\n久待倚阑成独酌，痴儿了事各须归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐闻县怀京下旧游","author":"范梈","text":"平生不识张廷尉，中岁方逢马伏波。\n昨见山川皆胆落，稍侵霜露始心和。\n皇恩远荷优隆至，旅况深惭慨惜多。\n天上故人安好在，西风迟暮意如何？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泰定二年丙寅岁元日","author":"范梈","text":"闽藩杰构入青云，箫鼓声高万壑闻。\n瓯粤谁存封建业？\n唐虞真是圣明君。\n蓬莱瑞气皇居正，太液恩波御席分。\n身远祇怀归委佩，丝纶阁近最缤纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7885,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自戎府出还珠门，晚归廨舍","author":"范梈","text":"光迎署府千花树，秀入河桥万柳梢。\n春日楼台围翠巘，夜晴灯火接青郊。\n升平旧俗今犹在，浩荡流年又过交。\n董奉接官何处宅？\n相依愿与结衡茅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7886,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闽山神光寺西崖上观唐李阳冰篆，篆为山僧架屋所坏，存者始二十二字云","author":"范梈","text":"城西有寺忽如林，伏地卬霄苔藓侵。\n古人题字看欲遍，今我杖藜来相寻。\n潜蛟在壑不多见，飞鸟过岩时一吟。\n斫破荒祠山鬼怪，祇饶游览重千金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7887,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游南涧寺，寺乃唐节度使王审知所建","author":"范梈","text":"闽山东面启松门，梯石层层见梵尊。\n题表尚存唐节镇，地图浑似洛林园。\n亭因聚远开幽径，栈至临危出小轩。\n最是跻攀宜健步，病身无羽亦飞鶱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7888,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伏睹中书以内郡饥遍行拯救新令，感激有作","author":"范梈","text":"江南往岁旱连州，河北今年水逆流。\n恭体朝廷宽大意，少纾田里散离忧。\n表章有道诚长策，衣食无功本拙谋。\n国制由来重农亩，太平政不在他求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7889,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宪司双榕轮囷数十围，其庇数亩，雨止，观白鹭","author":"范梈","text":"榕树庭中翠欲昏，飞来白鹭动如云。\n每当弹射思伤物，忽到徘徊感离群。\n护子乌鸦来辟易，附人鹳鹊漫缤纷。\n要知得失都何与？\n含育无由报圣君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7890,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归思","author":"范梈","text":"陶公归思定如何，山郭春风长薜萝。\n直道当官惟任拙，庸才负禄祗惭多。\n江山实自辞家隔，日月虚随闭户过。\n点点飞鸿向天末，忧端不类泽中歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7891,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"到官","author":"范梈","text":"陶公到官八十日，今我到官逾半期。\n劝农省俗了无补，暖衣饱食将何为？\n常思在山深虎豹，几曾当道假狐狸？\n英雄见义犹饥渴，可使文人有愧辞？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7892,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风止闻鹊","author":"范梈","text":"荒山远水放轻舠，顿雨颠风戒弊袍。\n五六月馀乡问绝，二千里外客心劳。\n树间乌鹊声频好，天上麒麟格自高。\n独有武夷看未了，野人寄语压香醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和吴宗师退朝","author":"范梈","text":"柳外朝冠古进贤，云间观户旧通仙。\n蓬莱岂隔三千里？\n华颂宜过一万年。\n香并衮龙浮瑞日，声随箫凤下晴天。\n文臣不愿金茎赐，但想黄封到竹边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉观郊庙礼成，简曹礼部元用","author":"范梈","text":"西山半壁影钩陈，晴雪新销路马尘。\n两岁通行三大礼，千官中称一闲身。\n伊皋事业何当下？\n管乐才名不用真。\n遥忆南宫旧词伯，退歌清庙属生民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马贡士元夕同观灯之作","author":"范梈","text":"已戒金吾夜不哗，西山又被雪微遮。\n饥年禁酿知谁力？\n到处看灯似我家。\n旅梦比尝经赤甲，病身尤欲恋黄芽。\n云端此日烟霏暖，遥想仙人立露华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答李泂","author":"范梈","text":"客居离索感芳晨，颇耐物色恼诗人。\n花心尽逐阳和动，柳眼宜于故旧新。\n万里清江家共远，九春皓月梦兼频。\n鹿门自有庞夫子，长往烟林秋复春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"调马君","author":"范梈","text":"平时有酒不解醉，愁至方知酒道尊。\n一万里程兼雪霰，三千年事隔朝昏。\n何因洗盏花间屿？\n更与停鞭柳下墩。\n寄语东邻马贡士，今晨琴筑好温存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独立","author":"范梈","text":"能诗不得静中师，又是天涯独立时。\n高阁夕阳人影乱，曲河新水棹声迟。\n一身慷慨家仍远，十口凄凉岁荐饥。\n偶尔凭阑感风物，临流先被白鸥知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张留公母","author":"范梈","text":"山风遥引紫云车，楼阁春深阿母家。\n更五十周重甲子，后三千岁一桃华。\n彩衣故绾封留印，白璧新随使蜀查。\n见说麻姑旧行处，至今源上有丹砂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和王继学怀济南旧游四首 其一","author":"范梈","text":"前辈风流逐断澌，济南旧录故人诗。\n遥知灵运初游日，正是元方后载时。\n青社寥寥成异物，丹丘皛皛属遐思。\n壮年易动离居感，缱绻花前金屈卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和王继学怀济南旧游四首 其二","author":"范梈","text":"楼上看山翠黛浮，楼前沽酒锦缠头。\n登临试与询湖雁，豪杰亲曾侣海鸥。\n沙岭晓晴云散出，野亭春尽水交流。\n意中故旧那能得，强拟偷生赋远游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和王继学怀济南旧游四首 其三","author":"范梈","text":"每愁大手不如燕，多见公侯胜昔年。\n计拙欲求千户等，心劳政类十洲仙。\n几回见月思归去，暂到临风复惘然。\n剪尽绿杨三万树，多因无处著啼鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]