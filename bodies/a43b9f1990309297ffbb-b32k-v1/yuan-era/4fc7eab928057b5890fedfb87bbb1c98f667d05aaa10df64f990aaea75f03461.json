[{"title":"雨","author":"赵孟頫","text":"摵摵众叶响，滋滋生意新。\n知谁实挥洒，解使尽圆匀。\n蛛网悬珠络，荷盘泻汞银。\n喜凉生枕簟，愁润逼衣巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵观复表兄见简 其二","author":"赵孟頫","text":"载酒无人到，山园昼掩门。\n泥深妨步屧，雨暗只空村。\n每忆文园渴，难忘北海尊。\n何当来就饮，听我抚桐孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送董参政赴召","author":"赵孟頫","text":"丹极飞明诏，锋车召老臣。\n仲舒经术䆳，贾谊谠言陈。\n偃革怀殊俗，安田慰远人。\n公心如皦日，江国自熙春。\n散乱堆床帙，萧飕满案尘。\n诡随吾不忍，高卧理还伸。\n入奏能回主，当言莫爱身。\n衮衣瞻望重，丈席侍趍频。\n铅椠工无益，樵渔意巳亲。\n白鸥波万里，浩荡未能驯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"投赠刑部尚书不忽木公","author":"赵孟頫","text":"胄子何多士，明公特妙年。\n诗书师法在，簪绂相门传。\n曳履星辰上，分光日月边。\n帝心知俊彦，群望属英贤。\n大木明堂器，朱丝清庙弦。\n吉人词自寡，君子德为先。\n断狱阴功厚，优儒礼数偏。\n我非天下士，人谓地行仙。\n山好双游屐，溪清一钓船。\n赋诗时遣兴，好客恨无钱。\n政尔韦编绝，俄闻束帛戋。\n风尘驱驲骑，霜雪洒鞍鞯。\n别妇经春夏，离乡整四千。\n家书愁展读，旅食困忧煎。\n郎位蒙超擢，官曹幸接联。\n屡闻哦鄙句，信或有前缘。\n知己诚难遇，扪心益自怜。\n樊中淹泽雉，春晚怨啼鹃。\n骥病思丰草，鸿冥羡远天。\n仁言如借便，白首向林泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送夹谷公分省陕西","author":"赵孟頫","text":"忆从长杨猎，于时始识公。\n堂堂九尺干，落落万夫雄。\n补衮弥缝密，能书点画工。\n劳谦延士类，岂弟到儿童。\n黄阁归人望，青云有父风。\n驱驰常扈从，奏对每留中。\n暂辍尚书履，荣分陕右弓。\n秦山依昼锦，燕雪感秋蓬。\n粉署趍承旧，瀛洲忝窃同。\n因公动乡思，飞梦过江东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杨司农宅刘伯熙画山水图","author":"赵孟頫","text":"移得山川胜，坐来烟雾空。\n窗中列远岫，堂上见青枫。\n岩树参差绿，林花掩冉红。\n鸟飞天路回，人去野桥通。\n村晚留迟日，楼高纳快风。\n琴尊会仙侣，几杖从儿僮。\n疑听孙登啸，将无顾恺同。\n微茫看不足，潇洒兴难穷。\n碧瓦开莲宇，丹楼耸竹宫。\n乱泉鸣石上，孤屿出江中。\n藉甚丹青誉，益知书画功。\n烦渠添钓艇，着我一渔翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和姚子敬秋怀五首 其一","author":"赵孟頫","text":"铜爵春深汉苑空，邯郸月冷照秦宫。\n烟花楼阁西风里，锦绣湖山落照中。\n河水南来非禹迹，冀方北去有唐风。\n溪城秋色催迟莫，愁对黄云没断鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和姚子敬秋怀五首 其二","author":"赵孟頫","text":"落日孤城动鼓鼙，愁中画角不胜吹。\n山川萧瑟秋云净，草木凋伤莫雨悲。\n多病马卿聊假日，数奇李广不逢时。\n卷帘白水青山里，隐几无言有所思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和姚子敬秋怀五首 其四","author":"赵孟頫","text":"吴宫烟冷水空流，惨澹风云暗九秋。\n禾黍故基曾驻辇，芙蓉高阁迥添愁。\n绣楹锦柱蛟龙泣，金沓瑶阶鹿豕游。\n宋玉平生最萧索，欲将《九辩》赋离忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和姚子敬秋怀五首 其五","author":"赵孟頫","text":"野旷天高木叶疏，水清沙白鸟相呼。\n胡笳处处军麾满，鬼哭村村汉月孤。\n新亭举目山河异，故国伤神梦寐俱。\n黄菊欲开人卧病，可怜三径巳荒芜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登飞英塔","author":"赵孟頫","text":"梯飙直上几百尺，俯视层空鸟背过。\n千里湖山秋色净，万家烟火夕阳多。\n鱼龙衮衮危舟楫，鸿雁冥冥避网罗。\n谁种山中千树橘，侧身东望洞庭波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刚父无逸游南山作","author":"赵孟頫","text":"绝顶清秋凌翠烟，登临应费酒如川。\n平生能着几两屐，负郭何须二顷田。\n初日出云光射地，双溪入湖波接天。\n升高望远我所爱，青壁有路何当缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵舜举春日感兴","author":"赵孟頫","text":"沙头春日已喧妍，细柳新蒲色共鲜。\n世事底须求分外，人生何物胜尊前。\n飞花冉冉催华发，宿草青青失古阡。\n回首旧欢如梦过，不知今日是何年！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵章得一同原父侄游兰泽","author":"赵孟頫","text":"绿树闇闇草接天，已愁春尽更闻鹃。\n落花飞絮都成恨，痛饮狂歌浑欲颠。\n起舞有人如谢尚，著书无意似伶玄。\n绣筵宝瑟何时会，割锦缠头不计钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"见章得一诗因次其韵二首 其二","author":"赵孟頫","text":"片片飞花欲送春，萋萋碧草正愁人。\n黄蜂酿蜜经营急，紫燕衔泥来去频。\n才似茂陵非晚遇，美如曲逆不长贫。\n久知求富都无益，但喜论诗若有神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和帅初雨中见赠 其一","author":"赵孟頫","text":"阴雨凄凄生夏寒，故人望望惜清欢。\n停云底事能相阻，后土何时可得乾。\n无事甘为犀首饮，切云聊着屈平冠。\n闭门客散且高卧，户外泥深没马鞍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和帅初雨中见赠 其二","author":"赵孟頫","text":"正坐清谈与世违，交情如子定应稀。\n图书跌宕心犹在，裘马清狂意巳非。\n黄鹤未知何日返，饥乌故作傍人飞。\n溪南流水清如玉，终拟归休理钓矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"多景楼","author":"赵孟頫","text":"层颠官阁几时脩，绕槛长江万古流。\n白露巳零秋草绿，斜阳虽好莫云稠。\n平南筹策张华得，治内人才葛亮优。\n景物未穷登览兴，角声孤起瓮城秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东阳八咏楼","author":"赵孟頫","text":"山城秋色净朝晖，极目登临未拟归。\n羽士曾闻辽鹤语，征人又见塞鸿飞。\n西流二水玻瓈合，南去千峰紫翠围。\n如此山川良不恶，休文何事不胜衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵雨花台遂至故人刘叔亮墓","author":"赵孟頫","text":"雨花台上看晴空，万里风烟入望中。\n人物车书南北混，山川襟带古今同。\n昆虫未蛰霜先陨，凤鸟不鸣江自东。\n绿发刘伶缘醉死，往寻荒冢酹西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蛾眉亭","author":"赵孟頫","text":"天门日涌大江来，牛渚风生万壑哀。\n青眼故人携酒共，两眉今日为君开。\n苍崖直下蛟龙吼，白浪横空鹅鹳回。\n南眺青山怀李白，沙头官渡苦相催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大都红门外海子上即事","author":"赵孟頫","text":"白水青林引兴多，红裙翠黛奈愁何。\n底从暮醉兼朝醉，聊复长歌更短歌。\n轻燕受风迎落絮，老鱼吹浪动新荷。\n馀不溪上扁舟好，何日归休理钓蓑？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠周景远田师孟","author":"赵孟頫","text":"与子同客帝王州，一日不见如三秋。\n风高气肃雁声急，天青日暖蛛丝游。\n篱下黄花为谁好，水边红树令人愁。\n世间万事可拨遣，日日痛饮醉即休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送缪秀才教授真州","author":"赵孟頫","text":"髯生别我将安适，言向真州作教官。\n但使清风生绛帐，何妨朝日照空槃。\n东园草木因人胜，北固江山隔岸看。\n才近中年巳伤别，可堪南望送归鞍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵左辖相公","author":"赵孟頫","text":"昔年闾里自浮沉，郎省那知遂有今。\n老去冯唐堪底用，愁来庄舄向谁吟。\n上林柳色春犹浅，西塞桃花水正深。\n知己如公居鼎鼐，不应长此泣南音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵左辖相公奉寄行台中丞徐公","author":"赵孟頫","text":"尽日沉迷簿领书，何时重得赋閒居。\n已无梦想悬金印，岂有文章到石渠。\n白发故人霜柏在，黄尘游子断蓬如。\n旧游忆在吴兴日，自采溪毛脍白鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴思可总管汀州","author":"赵孟頫","text":"七闽南去路崎岖，五马承恩出帝都。\n地气喜闻今有雪，民生宁似昔无襦。\n山城酒美倾鹦鹉，雨馆春深听鹧鸪。\n他日相思应怅恨，离筵不忍赋骊驹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元庚辰繇集贤出知济南暂还吴兴赋诗书怀 其一","author":"赵孟頫","text":"五年京国误蒙恩，乍到江南似梦魂。\n云影时移半山黑，水痕新涨一溪浑。\n宦途久有曼容志，㛰娶终寻尚子言。\n政为疏慵无补报，非干高尚慕丘园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至元庚辰繇集贤出知济南暂还吴兴赋诗书怀 其二","author":"赵孟頫","text":"多病相如巳倦游，思归张翰况逢秋。\n鲈鱼莼菜俱无恙，鸿雁稻粱非所求。\n空有丹心依魏阙，又携十口过齐州。\n闲身却羡沙头鹭，飞去飞来百自由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘端父御史见和初到济南诗次韵荅之","author":"赵孟頫","text":"少日居多隐遁情，微官犹喜得山城。\n腹中洞视浑无物，身外何因更有名。\n忽忆放船苕水去，终期背郭草堂成。\n故乡一别三千里，看见池塘草又生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"趵突泉","author":"赵孟頫","text":"泺水发源天下无，平地涌出白玉壶。\n谷虚久恐元气泄，岁旱不愁东海枯。\n云雾润蒸华不注，波涛声震大明湖。\n时来泉上濯尘土，冰雪满怀清兴孤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"继郑鹏南书怀","author":"赵孟頫","text":"岂不怀归苦未闲，宦情羁思不成欢。\n可能治郡如龚遂，只合临流似幼安。\n棋局懒从先处着，医方留取用时看。\n夜来梦到苕溪上，一枕清风五月寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"德清闲居","author":"赵孟頫","text":"巳无新梦到清都，空有高情学隐居。\n贫尚典衣贪购画，病思弃研厌求书。\n圉人焚积夜防虎，溪女叩扉朝卖鱼。\n困即枕书饥即饭，谋生自笑一何疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山堂","author":"赵孟頫","text":"手种青松一万栽，山堂留得翠屏隈。\n推窗绿树排檐入，临水红桃对镜开。\n山雉雊迎朝日去，野禽啼傍夕阳来。\n老妻亦有幽栖意，数日迟留不肯回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海子上即事与李子构同赋","author":"赵孟頫","text":"小姬劝客倒金壶，家近荷花似镜湖。\n游骑等閒来洗马，舞靴轻妙迅飞凫。\n油云判污缠头锦，粉汗生怜络臂珠。\n只有道人尘境静，一襟凉思咏风雩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重用韵","author":"赵孟頫","text":"更从何处访蓬壶，花满平堤水满湖。\n韩嫣金丸落飞鸟，王乔仙履下双凫。\n姬姜自爱千金貌，游侠轻量一斛珠。\n我老不知年少事，水边行散似春雩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杜伯玉四川行省都事","author":"赵孟頫","text":"浣花溪上草堂存，今见能诗几代孙。\n橘刺藤梢隐丛竹，椒浆桂酒荐芳荪。\n日长画省文书静，春近岷江雪浪奔。\n我向东吴君向蜀，别离从古解销魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵李秀才见赠","author":"赵孟頫","text":"曾是先皇侍从班，龙髯飞去竟难攀。\n重来赤日黄尘里，梦到清泉白石间。\n岂有文章供世用，久判渔钓与云閒。\n何当便理南归棹，呼酒登楼看弁山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送岳德敬提举甘肃儒学","author":"赵孟頫","text":"苦欲留君君不留，奋髯跨马走甘州。\n功名到手不可避，富贵逼人那得休。\n春酒蒲萄歌窈窕，秋沙苜蓿饱骅骝。\n儒冠也有封侯相，万里归来尚黑头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠放烟火者","author":"赵孟頫","text":"人间巧艺夺天工，鍊药燃灯清昼同。\n柳絮飞残铺地白，桃花落尽满阶红。\n纷纷灿烂如星陨，㸌㸌喧豗似火攻。\n后夜再翻花上锦，不愁零乱向东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题温雪峰诗迹","author":"赵孟頫","text":"出拥旌麾一俊臣，归寻松竹作闲人。\n龙蛇留遗人间世，泉石逍遥物外身。\n自古神仙皆旷达，由来豪杰岂埃尘。\n山川良是诸孙老，华表归来又几春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"胜槩楼","author":"赵孟頫","text":"楼下寒泉雪浪惊，楼前山色翠屏横。\n登临何必须吾土，啸傲聊因得此生。\n檐外白云来托宿，梁间紫燕语开情。\n济南胜槩天下少，试倚阑干眼自明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老态","author":"赵孟頫","text":"老态年来日日添，黑花飞眼雪生髯。\n扶衰每藉齐眉杖，食肉先寻剔齿櫼。\n右臂拘挛巾不裹，中肠惨戚泪常淹。\n移床独就南荣坐，畏冷思亲爱日檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"弁山佑圣宫次孟君复韵","author":"赵孟頫","text":"意行骑马到林间，晴雾都沈远近山。\n琼树著花春自早，翠禽双语意相关。\n一杯到手先成醉，万事无心触处閒。\n犹欠抱琴来托宿，静中规写水潺潺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉后同张刚父清风楼联句","author":"赵孟頫","text":"碧树未黄风露秋，晚云萧瑟乱山愁。\n千家疏雨催砧杵，两岸残阳入钓舟。\n画角吹残人罢市，清尊饮散客登楼。\n古今回首俱陈迹，唯有溪声日夜流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋山行旅图","author":"赵孟頫","text":"老树叶似雨，浮岚翠欲流。\n西风驴背客，吟断野桥秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题萱草蛱蝶图","author":"赵孟頫","text":"丛竹无端绿，幽花特地妍。\n飞来双蛱蝶，相对意悠然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄葵词","author":"赵孟頫","text":"仙掌郁金衣，朝阳风露晞。\n可怜蜂与蝶，秪解弄春晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题太白酒船图 其二","author":"赵孟頫","text":"萧洒稽山道，风流贺季真。\n相思不相见，愁杀谪仙人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题真定明远亭","author":"赵孟頫","text":"未到新亭上，先题明远诗。\n云间归雁小，山外夕阳迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独夜","author":"赵孟頫","text":"秋风动林叶，夜雨滴池荷。\n孤客睡不着，乱蛩鸣更多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李仲宾野竹图","author":"赵孟頫","text":"偃蹇高人意，萧疏旷士风。\n无心上霄汉，混迹向蒿蓬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏二十二首 其一 龙口岩","author":"赵孟頫","text":"峭石立四壁，寒泉飞两龙。\n人间苦炎热，仙境已秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏二十二首 其四 长廊岩","author":"赵孟頫","text":"脩岩如长廊，下有流泉注。\n山中古仙人，步月自来去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏二十二首 其五 金沙岭","author":"赵孟頫","text":"攀萝缘石磴，步上金沙岭。\n露下色荧荧，月生光炯炯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏二十二首 其九 寒月泉","author":"赵孟頫","text":"我尝游惠山，泉味胜牛乳。\n梦想寒月泉，携茶就泉煮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天冠山题咏 其六 一线天","author":"赵孟頫","text":"醯鸡舞瓮中，井蛙居坎底。\n莫作一线看，开眼九万里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周秀才此山堂 其一","author":"赵孟頫","text":"青青云外山，烱烱松下石。\n顾此山中人，风神照松色。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓起闻莺","author":"赵孟頫","text":"暑气晓来清，时时闻远莺。\n还思故园路，松下绿苔生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牧废苑","author":"赵孟頫","text":"一片中原地，纷纷几战争。\n至今将不去，留与后人耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄清夫秋江钓月图","author":"赵孟頫","text":"尘土染人衣袂，烟波着我船窗。\n为问行歌都市，何如钓月秋江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王子庆所藏大年墨雁","author":"赵孟頫","text":"鸿雁栖栖遵渚，黄芦索索鸣秋。\n羡杀承平公子，笔端万里沧洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初至都下即事 其二","author":"赵孟頫","text":"尽日车尘马足间，偶来临水照愁颜。\n故乡兄弟应相忆，同看溪南柳外山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王月友归杭州 其二","author":"赵孟頫","text":"云本无心漫出山，归来依旧与云闲。\n何当从子东南去，扫地焚香昼掩关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清胜轩绝句","author":"赵孟頫","text":"小草幽香动碧池，暖风晴日长新荑。\n南窗昼倚绿阴静，听尽行人过马蹄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题东野平陵图","author":"赵孟頫","text":"骑驴渺渺入荒城，积水空林坐自清。\n政使不容投劾去，也胜尘土负平生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]