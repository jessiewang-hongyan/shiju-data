"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题商寿岩画山水","author":"柯九思","text":"集贤曾画嘉熙服，敕赐黄金拜舞归。\n从此人间重山水，清泉白石转晴晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题明雪窗画兰","author":"柯九思","text":"清事相过日应酬，山僧信笔动新秋。\n王孙遗法风流在，解使平台石点头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"笔生沈日新来求书就写旧诗以寄","author":"柯九思","text":"沈生笔妙能随意，曾记蓬莱应制时。\n三十六宫花漠漠，玉阶研露写新词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨工林松泉来求荐就写寄","author":"柯九思","text":"先朝谁进林家墨，曾试龙楼凤饼新。\n玉砚光华云彩动，殿中书诏赐功臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠相士王生","author":"柯九思","text":"不见王生二十年，武夷山下看清泉。\n南柯梦里犹相问，台贮黄金可赴燕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"就寄笔生温国宝","author":"柯九思","text":"千金当日赋《长门》，温老中书预选抡。\n江上秋霜飞鬓影，怕拈湘管见啼痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠周信之教授","author":"柯九思","text":"霞蒸春暖丹初熟，许我刀圭未暇寻。\n只在鸳鸯湖上住，杏花种得满园林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题雪溪逵上人像于玉山草堂","author":"柯九思","text":"道人曾宿灵隐寺，能画寺前山意秋。\n古木立猿啼夜月，下有清泉如玉流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明月歌送僧东游","author":"柯九思","text":"上人忤世祇好游，蹴蹋空翠凌清秋。\n时人问之寂无语，明月在天惟点头。\n吴山越峤皆明月，桂树相随渡东浙。\n烦师问讯吾故居，山近琼台瞰双阙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠匡庐山人","author":"柯九思","text":"道人欲筑希夷室，自向身中炼火丹。\n何日朝元游绛阙，九霄回首月华寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题匡庐山人所藏云松图于玉山书舍","author":"柯九思","text":"幽人结屋庐山侧，卧看九江天际来。\n白云万壑青松老，时抚丝桐坐绿苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周文矩画太真攀鞍图","author":"柯九思","text":"春风别院奏笙歌，妃子攀鞍转晓波。\n不信开元太平日，香魂沦落马嵬坡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵松雪画扶弹图","author":"柯九思","text":"夜合花开昼漏迟，王孙游骑出平堤。\n玉鞭缓策青林下，回首风前听子规。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵松雪春山图","author":"柯九思","text":"落花飞絮春日间，散策深林独往还。\n□成应对□人语，好似西湖西畔山。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵仲穆画","author":"柯九思","text":"山头应是馆娃宫，锦绣楼台路可通。\n年年长见五湖水，万斛舟行白浪中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道春山图","author":"柯九思","text":"江上兰桡倚绿波，江头听唱《竹枝》歌。\n使君多少伤春意，新画青山作髻螺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道画扇","author":"柯九思","text":"江清地僻野人家，门外桥通石径斜。\n不信东华尘十丈，万山晴雪看梨花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王孤云界画山水图","author":"柯九思","text":"满地山河如绣，回岩楼阁凌风。\n几度春花秋雨，不知秦苑吴宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题道士黄松瀑诗帖后","author":"柯九思","text":"道人下笔重黄金，尚忆宫墙古木深。\n独倚阑干挥老泪，江山风雨动哀吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题达兼善书渔庄篆文","author":"柯九思","text":"閒居正忆龙头客，喜见秦人小篆文。\n便到山中看摹勒，已?十日卧寒云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元章海岳庵图","author":"柯九思","text":"我弃朝归海岳庵，千岩万壑绕江南。\n先生预拟归来计，不待临风雪满簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖山水","author":"柯九思","text":"帝乡春日曾舒卷，溪馆秋风每见之。\n处处云生山似画，年年老去鬓如丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题渔父图","author":"柯九思","text":"黄金不用买骅骝，十丈红尘没马头。\n好买扁舟逐渔父，一江春雨看浮沤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张萱画横笛士女","author":"柯九思","text":"纤手锵宫徵，纱痕薄暮霞。\n画眉人去后，深院落梅花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄筌画红蕉十二红","author":"柯九思","text":"故国三千里，名禽十二红。\n白头供奉在，挥泪湿东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题芙蓉画眉","author":"柯九思","text":"谁道秋容澹，名花带露秾。\n画眉声欲碎，莫放晓妆慵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题边武画苍松图","author":"柯九思","text":"疏竹摇秋雨，苍松凝晚烟。\n王孙归未得，谁复效春妍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]