[{"title":"仆射山人山中四时词 其一","author":"汪珍","text":"春风破寒入幽谷，残雪消时烧痕绿。\n林花斗日媚于颊，野蕨登盘甘胜肉。\n南漪新渌晴满湖，春来行乐何处无。\n一樽我欲就花饮，花下啼禽能劝沽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仆射山人山中四时词 其二","author":"汪珍","text":"草泥聒聒吠蝼蝈，枣花落尽桐阴密。\n舍南舍北棹缲车，山后山前闻打麦。\n新篁解箨来薰风，脱巾露坐双鬓鬔。\n清泉白石足佳处，人世炎炎如甑中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仆射山人山中四时词 其三","author":"汪珍","text":"西风萧萧群木槁，天外秋云净如扫。\n豆叶半枯鸿雁来，粳稻俱登鸡鹜饱。\n白云夜下天雨霜，破篱衰草啼寒螀。\n芋魁如盎茭白老，床头酒熟浮蛆香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仆射山人山中四时词 其四","author":"汪珍","text":"千林怒号北风恶，阶下纷纷堆败箨。\n野田日出散牛羊，茅屋天寒喧鸟雀。\n湿云筛下豆秸灰，谷口梅花开未开。\n明朝积玉深一丈，高卧闭门谁复来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居夏日","author":"汪珍","text":"草长荒三径，桐阴满四邻。\n青春如过客，白日属閒人。\n迸笋争篱出，残花落地新。\n几时寻要术，吾亦学齐民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"迓卢疏斋肃政使","author":"汪珍","text":"去年幕府雪晴时，诵得齑辛绝妙词。\n溪树迎人寒欲醒，春阳行处本无私。\n轮埋当道豺狼避，月到空山魍魉移。\n白发遗民思旧德，相看绣斧重褰帷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29951,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次程子英金陵怀古","author":"汪珍","text":"桃叶桃根乐府词，江南千里旧封畿。\n黄旗紫盖关兴废，东府西州有是非。\n故苑半随秋草没，征帆犹趁暮潮归。\n宝鞭夺得蛇矛断，梦破重营绕日晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29952,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀呈殿干碧梧友云","author":"汪珍","text":"门巷萧萧叶拥篱，僻居尤自畏人知。\n读书未及半袁豹，问士谁当甲蔡尼。\n万壑风号天欲雪，一溪梅发梦寻诗。\n百年将半犹羁旅，可待麻鞋受拾遗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29953,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次答兑峰殿干见寄","author":"汪珍","text":"题得新诗寄所思，从公始恨十年迟。\n灯残暗壁虫催织，月满空庭鹊绕枝。\n客路飘零秋易感，老年情味夜偏知。\n江烟一舸芦花雪，还忆往年相别时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29954,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春雨留胡振甫","author":"汪珍","text":"故园春合早莺栖，堂下溪深水拍堤。\n十里桑畦蚕脱纸，一帘花雨燕争泥。\n年饥畎亩还堪隐，世难功名莫厌低。\n寂寞淮南门下士，赠君惟有数行啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题从兄希深书堂","author":"汪珍","text":"衡檐睥睨压疏棂，平割黄山一半青。\n落日捲云随鹘没，黑风吹雨带龙腥。\n人间轩冕驹閒皂，身外乾坤水载萍。\n我政江湖子林壑，客星未减少微星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陵阳歌","author":"汪珍","text":"陵阳城头落日黄，陵阳城下水茫茫。\n楼中少妇吹羌管，时有北人思故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城南","author":"汪珍","text":"春阴黯淡蔽人家，野水新生尚露沙。\n客子未归寒食近，满城风雨落梨花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游无为庵","author":"汪珍","text":"竹埤杉垣记昔游，洞门花落石床幽。\n白云飞尽四山碧，黄鹤一声天地秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其一","author":"柯九思","text":"万国贡珍罗玉陛，九宾传赞捲珠帘。\n大明前殿筵所秩，勋贵先陈祖训严。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其三","author":"柯九思","text":"亲王上玺宴西宫，圣祚中兴庆会同。\n争捲珠帘齐仰望，瑞云捧日御天中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其四","author":"柯九思","text":"四海升平一事无，常参已散集诸儒。\n传宣群玉看名画，先进开元纳谏图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其六","author":"柯九思","text":"官家明日庆生辰，准备龙衣熨帖新。\n奉御进呈先取旨，隋珠错落间奇珍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其七","author":"柯九思","text":"传宣太府颁宫锦，近侍承恩拜榻前。\n制得袍成天未晓，著来香殿贺新年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其八","author":"柯九思","text":"凤城女乐拥祥烟，梵座春游浃管弦。\n齐望綵楼呼万岁，祥云只在五云边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其九","author":"柯九思","text":"花明昼锦柳摇丝，仙岛陪銮濯禊时。\n曲水番成飞瀑下，逶迤银汉接清池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十","author":"柯九思","text":"儒臣春直奎章阁，玉陛牙牌报未时。\n仙仗已回东内去，牡丹花畔得围棋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十一","author":"柯九思","text":"玉椀调冰涌雪花，金丝缠扇绣红纱。\n綵笺御制题端午，敕送皇姑公主家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十二","author":"柯九思","text":"观莲太液汎兰桡，翡翠鸳鸯戏碧苕。\n说与小娃牢记取，御衫绣作满池娇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十三","author":"柯九思","text":"珠宫锡宴庆迎祥，丽日初随綵线长。\n太史院官新进历，榻前一一赐诸王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十五","author":"柯九思","text":"玉漏藏机水暗流，真珠射日动灯毬。\n偶人自解开青琐，高拱龙床报晓筹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其一","author":"柯九思","text":"徽仪阁内制春衣，日长倦绣立彤闱。\n奚官折送杏花去，笑看玉阶胡蝶飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其三","author":"柯九思","text":"奉常告吉礿初冬，太室精禋一念通。\n传旨外廷休奏事，今朝天子坐斋宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其四","author":"柯九思","text":"□华阁后春归早，百种名花腊日开。\n为是君王行不到，园官讲殿进盆梅。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其五","author":"柯九思","text":"千嵓雨过翠玲珑，太液池边看綵虹。\n何处蓬莱通弱水，仪天殿在画桥东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其六","author":"柯九思","text":"中书已奏新除了，押宝还催内閤开。\n斜插白麻龙篆湿，近臣当殿谢恩来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其八","author":"柯九思","text":"皇心简注勋臣旧，未有人知拟拜除。\n宣索綵笺濡玉笔，榻前先命小臣书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其九","author":"柯九思","text":"夜深回步玉阑东，香烬龙煤火尚红。\n折得海棠无觅处，依然遗却月明中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其十","author":"柯九思","text":"小时歌舞擅宫庭，长忆先皇酒半醒。\n白发如今垂两鬓，佛前学得念《心经》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长信宫秋词","author":"柯九思","text":"羊车声远意徒劳，望断长门月影高。\n犹恐九霄风露早，明朝拟送衮龙袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和许彦温宫词","author":"柯九思","text":"暖吹生香花半吐，三十六宫传笑语。\n雕阑并倚弄新春，翠裕不管沾微雨。\n小娃相对学吹簧，云母屏风白玉堂。\n中贵传宣日将暮，不省秋闺断寸肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉长门词四首 其一","author":"柯九思","text":"阿娇初入汉宫时，金屋承欢春昼迟。\n欲学新妆重览镜，如今羞画翠蛾眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉长门词四首 其二","author":"柯九思","text":"翠华明日游仙苑，为报春风候六龙。\n妾貌如花翻被妒，莫教花貌似奴容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉长门词四首 其三","author":"柯九思","text":"梧桐秋雨滴昭阳，不忿灯花故近床。\n欲下罗帏宫漏永，细看当日绣鸳鸯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉长门词四首 其四","author":"柯九思","text":"名花倾国占宫闱，香损僝风傍路飞。\n却忆夜来宫里事，箧中未熨衮龙衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题风雨泊舟图","author":"柯九思","text":"春风桂楫木兰舟，欲采芳蘅不自由。\n浅濑潾潾吹暮雨，苍梧云冷易生愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题虢国走马图","author":"柯九思","text":"月淡花浓酒半消，沈香亭暖度箫韶。\n传宣趣赐飞龙马，虢国夫人早入朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金国端箭人马卷","author":"柯九思","text":"毡帐雪花寒，单于夜不还。\n分弓传令肃，明日猎天山。"