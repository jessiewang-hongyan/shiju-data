[{"title":"樵风庙","author":"韩性","text":"朝南暮北樵风径，遗庙千年尚乞灵。\n山瘦不知如许事，闭门新注相牛经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读三国志","author":"韩性","text":"玉垒浮云尚惨然，兴亡自古总由天。\n渭川星殒嗟何早，却遣谯周七十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子固墨兰","author":"韩性","text":"镂琼为佩翠为裳，冷落游蜂试采香。\n烟雨馆寒春寂寂，不知清梦到沅湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其一","author":"薛汉","text":"茫茫穹壤间，环溪大州九。\n壮游不及辰，坐待迫蒲柳。\n穷通付分定，达识当顺受。\n但愿薰风诗，在在民物阜。\n一瓢安菽水，吾计亦良厚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其二","author":"薛汉","text":"当年东山翁，笑傲聊永日。\n弓旌一朝下，万里赴星驿。\n回头故山友，十见秋柏实。\n峨峨东观中，大书黑如漆。\n想见日暮归，沙轻马蹄疾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其三","author":"薛汉","text":"淳风散已久，青黄陋洼樽。\n婉娈争媚好，役智空自昏。\n岂知葛天民，无言道弥敦。\n我有《白云操》，泠泠寄桐孙。\n调古识者寡，幽探万化源。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其四","author":"薛汉","text":"驱车涉远道，日晏不知疲。\n一见嵩华高，始觉培塿卑。\n吾道丽天壤，昭昭匪难知。\n千金买刀圭，但为方士欺。\n嬴粮往问道，去结汗漫期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其五","author":"薛汉","text":"志士方盛时，危冠怒冲发。\n猛心石为开，壮气山可拔。\n安知横江鲸，中路蝼蚁狎。\n所以巢居子，商歌竟不辍。\n歌竟寂无言，坐听天籁发。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑应奉杂诗六首 其六","author":"薛汉","text":"宦游梦入槐，宴坐肘生柳。\n出处亦何常，临岐一分手。\n光阴不可玩，岁月坂丸走。\n轩裳百年间，竹帛千载后。\n永愿坚素心，旧学安敢负。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送曹学士草诏毕还大都","author":"薛汉","text":"日毂始巡幸，风伯前汛扫。\n宸衷自警畏，廷论各至到。\n黼饰资旧臣，优渥发新号。\n四方听纶綍，千载仰训诰。\n言归玉堂署，送别龙庭道。\n恋阙信马行，及门闻鹊噪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞先生上京夏凉韵","author":"薛汉","text":"登台美皆春，覆盆惨长夜。\n谁能均苦乐，世道勤汛洒。\n滦京逼穹昊，重纩度朱夏。\n下方正喘汗，歊赫在炉冶。\n南北各异宜，敢讶行化者。\n倦游念苕霅，渔竿自堪把。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞先生箸香","author":"薛汉","text":"奇芬祷精微，纤茎挺修直。\n灺轻雪消睆，火细萤耀夕。\n素烟袅双缕，暗馥生半室。\n鼻观静里参，心原坐来息。\n有客臭味同，相看终永日。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送马少卿伯庸南祀嵩恒淮渎","author":"薛汉","text":"总章盛金德，斋明赫当宁。\n皇皇遣天使，肃肃承圣语。\n三熏礼岳渎，万里涉梁楚。\n祝釐归尧舜，降神出申甫。\n南斗迎文星，西风起仪羽。\n乐张洞庭月，旆湿湘岸雨。\n壮吟鄙骚怨，高谈洗儒腐。\n过家猿鹤喜，揽辔鸿雁聚。\n青闱闵贤劳，黄屋深记注。\n归骑慎勿徐，席虚玉堂署。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张仲实秋夜感旧","author":"薛汉","text":"古道日绵邈，何由探羲轩。\n六籍载绪馀，攻凿日已烦。\n岂无奇士志，寻枝或忘根。\n忽闻孤凤凰，百鸟寂不喧。\n邀我浇古胸，泠然酌洼尊。\n既感气类殊，况复德义敦。\n秋风江海上，英材昔同门。\n载咏《伐木》章，清夜劳梦魂。\n斯文傥未磨，馀事安足论。\n萧萧蒲柳姿，含英伺春暄。\n皓首崇明德，怀哉昔人言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送牟伯厚还霅","author":"薛汉","text":"西风起双鸿，渺渺度万山。\n空林霜霰落，各念饮啄难。\n中涂忽相失，独留谅无欢。\n极目送冥飞，风云逸修翰。\n低回守矰网，自顾形影单。\n奋翅念远举，天路浩漫漫。\n空想五湖水，春风涨波澜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书墨竹","author":"薛汉","text":"当年文湖州，爱竹骨已朽。\n祇今高李笔，可继湖州后。\n何人裂霜纨？\n写此三五叶。\n想见翠琅玕，萧然挺清节。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画马","author":"薛汉","text":"渥洼龙媒少人识，世上驽骀日充斥。\n班生画马画两匹，骏骨雄姿殊未得。\n赭袍乌帻坐奚官，似出春风十二闲。\n掩图不语三太息，我方垂耳盐车间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都城晓起和张汉杰韵","author":"薛汉","text":"扶桑日射蓬莱顶，下视瑶都森万井。\n金门未启曙光寒，月落觚棱微有影。\n枕上游士梦未回，喔喔邻鸡为呼醒。\n知君晓约谷城翁，再拟铭功汉钟鼎。\n杏村天近易为春，莫厌西斋官独冷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题刘理之木石","author":"薛汉","text":"木石山人枕溪曲，尽日看山如不足。\n一朝木石真到眼，昔者寓言今实录。\n何年老楠生长空山中，枯根入地蟠蛟龙。\n嵌窦玲珑削苍璧，宛如当年苏老之三峰。\n浪齧沙沿岁时久，岂知竟落渔人手。\n渔人好饮君好奇，驼入君家博升斗。\n君不见嗜石相国李与牛，不惜千金购罗搜。\n岂知山人奄有一丘壑，只费平原五督邮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪山盘车图","author":"薛汉","text":"车焞焞，石径荦确轮欲摧。\n疲牛分寸挽莫前，前车后车相逐来。\n大府城门倚天开，群山雪深白皑皑。\n卒夫鞭牛冻堕指，转输号令如风雷。\n官中委积等尘土，黔黎膏血无复回。\n君不见明时屡散粟与帛，桃林之牛亦悠哉。\n不知何代画此景，我自一见令心哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和袁德平","author":"薛汉","text":"世路不可涉，风霜苦见侵。\n园庐长入梦，岁月易惊心。\n木落秋容瘦，云昏雨意深。\n登楼试长望，烟水晚沈沈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄余希声","author":"薛汉","text":"寄语中林友，相思又几朝。\n书虽为路阻，梦不怕山遥。\n风定落花漫，雨深青草骄。\n人情谅难必，不似往来潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"摇落","author":"薛汉","text":"摇落岁华晚，萧条门巷空。\n黄花数点雨，红叶五更风。\n挽镜徒催老，耽书漫得穷。\n亲朋顿乖隔，幽意若为同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枉渚","author":"薛汉","text":"枉渚倚孤棹，意行随杖藜。\n鸥边渔艇小，牛后牧童低。\n秋色多因树，寒声半是溪。\n何当买茅屋，此地卜幽栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和伯雍夜坐","author":"薛汉","text":"月落夜方半，江空岁又阑。\n浮生知易老，久客欲归难。\n漏静忽闻笛，楼高谁倚阑。\n呼灯更小酌，起舞戏盘跚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸御史效义山无题四首 其一","author":"薛汉","text":"羽林垂彩动天江，幕府光联白虎幢。\n吏法有章皆画一，将坛得士故无双。\n台中长夏霜凝简，掖内通宵雾锁窗。\n若使九门容径入，肯思岩隐听流淙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸御史效义山无题四首 其二","author":"薛汉","text":"良人执戟待明光，谁与金炉共夕香。\n妆镜晓寒凝蝶粉，舞衣春暖卸莺黄。\n渡江桃叶应怜我，照水荷花似见郎。\n太息蹇脩无复理，空思掺手为缝裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸御史效义山无题四首 其三","author":"薛汉","text":"乘槎准拟逐秋潮，却访成都万里桥。\n沧海有山皆缥缈，青云无路不迢遥。\n閒居潘岳惊斑鬓，归去陶潜懒折腰。\n后夜相期明月上，露台高处弄笙箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸御史效义山无题四首 其四","author":"薛汉","text":"骥服盐车两耳垂，臂空九折未成医。\n欲寻箕颍终逃世，苦恨章逢不入时。\n金井蛩鸣知露冷，银河鹊度看星移。\n长贫久客应无补，拟挽沧江塞漏卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马元博下第归松江省觐","author":"薛汉","text":"木落蓬飞天已寒，束书火急出燕山。\n霜蹄暂蹶终超忽，风翮高抟祇等閒。\n文度且应归膝上，士龙能久在云间。\n深秋送尽南辕客，一夜思家鬓欲斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杜清碧入京二首 其一","author":"薛汉","text":"玉笥峰前久白云，铜驼陌上暂红尘。\n有书未肯干时宰，命驾惟应访故人。\n沧海鱼龙波浪阔，颠厓草木雪霜频。\n逢时少试经纶手，回首山林迹未陈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杜清碧入京二首 其二","author":"薛汉","text":"风雨蓬蒿病已侵，那堪送远更秋深。\n离情不断千寻绠，高义难磨百鍊金。\n乔木参天元有节，閒云出岫本无心。\n湖山摇落关河杳，后夜相思遣梦寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨仲弘编修","author":"薛汉","text":"今代扬雄更绝伦，布衣一出便词臣。\n眼空四海谭无底，胸著千年汲愈新。\n芸暖图书蓬阁晓，花明剑佩凤池春。\n传闻贾傅初归国，亦有当年共策人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和柳道传感怀","author":"薛汉","text":"已无言语可为阶，野性那兼不好排。\n买笑谁挥金似土，浇愁空想酒如淮。\n仪庭鹓鹭多乘运，失水鳣鲸自感怀。\n物我本无何得丧，且随达士共谈谐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送柳汤佐","author":"薛汉","text":"太行盘踞势严严，五马初行众具瞻。\n他日去思应借寇，此时来暮正歌廉。\n七贤旧竹风流在，万善新茶岁贡兼。\n莫谓名邦天稍远，飞龙曾向此中潜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵虚一降香至南海庐山会稽","author":"薛汉","text":"天香分下殿西头，处士今乘使者驺。\n曾是骑麟骖北斗，真成跨鹤过扬州。\n山中五老应相识，海上三神亦易求。\n勾越东南仙柱观，神光依旧贯林丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭子昭淮东经历","author":"薛汉","text":"蹛林前岁偶同游，话旧知经五五秋。\n未厌群乌栖柏府，又骑一鹤上扬州。\n受书此日名方起，奏最他时考更优。\n尘里初衣方皎洁，岂令大幕久淹留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵显卿友义卷后","author":"薛汉","text":"古称燕赵多豪俊，今向燕山得赵君。\n中岁挂冠心似水，閒时说剑气如云。\n埙篪每为家声合，囊橐曾因友谊分。\n七十长年天所相，名驹汗血更超群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"睡起","author":"薛汉","text":"卷帘春色上苔衣，新水相看近竹扉。\n风动树枝鸣宿鸟，云收山崦放晴晖。\n举杯竹叶扫愁去，攲枕杨花约梦飞。\n肠断碧苔溪上路，暖风晴日钓鱼矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜归","author":"薛汉","text":"有客有客胡未归，长安三见秋叶飞。\n警霜老鹤夜不寐，吊月孤雁寒无依。\n纷纷北里厌粱肉，落落西山甘蕨薇。\n人生穷达各有命，何须中夜泣牛衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题医学李教授归隐图","author":"薛汉","text":"一官归隐绛山阳，山色苍苍接太行。\n自古终南多捷径，只今盘谷是康庄。\n仙家虎卖林中杏，洞府龙传海上方。\n吾友玉堂称二妙，为君图写烂生光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿承旨张畴斋","author":"薛汉","text":"钟王书法得精微，每日霜毫不厌挥。\n相业曲江金鉴录，幽怀西塞绿蓑衣。\n蟠桃开日三千岁，古柏参天四十围。\n应与赤松相伴约，他年名遂早知几。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閒閒宗师生朝","author":"薛汉","text":"天正子月一阳回，春入环枢已放梅。\n寿酒淋漓倾九酝，仙阶缥缈接三台。\n函关昔日青牛度，华表他年白鹤来。\n更向何方觅鳌岛，帝垣东畔是蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题桶底图","author":"薛汉","text":"蕊珠宫阙见毫釐，中有群仙按羽衣。\n莫讶此图天地窄，黍珠境界更希微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四马图","author":"薛汉","text":"世上驽骀眩凡目，祇今谁识马中龙。\n昂头振鬣长鸣处，似向秋风诉未逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"糟豚蹄东阳酒送理之","author":"薛汉","text":"彭生失足落糟丘，醉入肌肤味更优。\n亦有曲生差可意，伴君倚槛看春流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月晦日二首 其一","author":"薛汉","text":"九月晦日终夜雨，酒醒无处著閒愁。\n起闻更张有明诏，实与万国同戚休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月晦日二首 其二","author":"薛汉","text":"今年年丰谷差贱，白米应饥翳桑夫。\n飞蝗是处有遗孽，未省腊前能雪无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古","author":"潘伯脩","text":"芙蓉袅秋水，中夜生清露。\n乞君白玉盘，明珠已无数。\n虽无白玉盘，月在水中央。\n莲房脱紫菂，种在浮泥香。\n仙人蹑素鳞，吸此秋月光。\n岁晏憺忘归，天际肃微霜。\n谁能为此曲？\n高歌水云乡。\n稽首无极翁，可念不可忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古意","author":"潘伯脩","text":"空中望海水，日暮动微澜。\n神州何偪仄，半落烟霞间。\n少小戏嵩华，南鱼落星湾。\n七泽一朝枯，我亦非朱颜。\n道逢两白鹄，欲下昆仑山。\n写书寄西母，早遣君王还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"起坐叹","author":"潘伯脩","text":"丈夫七尺躯，而无一金资。\n内怀千年意，外有万里思。\n终朝闭关坐，辛苦不敢辞。\n身长不肯屈，何以慰亲慈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"君子有所思三首 其一","author":"潘伯脩","text":"海日萧条云雪冈，追锋百里逐天狼。\n云罗四面伏不动，金错旌竿风簸扬。\n侍臣结束鸿雁行，玉阶鸣鞘立翠黄。\n君子有所思，雕弓既韔姑置之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"君子有所思三首 其二","author":"潘伯脩","text":"天青海绿黄金闺，明星绣户弱柳迷。\n阳春从中荡八极，花迎剑佩黄鸟啼。\n万方献寿来侏鞮，吉云宝露榑桑西。\n君子有所思，羽觞重持姑置之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"君子有所思三首 其三","author":"潘伯脩","text":"黄衣洒扫明光宫，银床玉井牵铜龙。\n风帘如烟不可极，水殿晚立秋芙蓉。\n美人吹笙明月中，曲台央央兰露红。\n君子有所思，云和欲御姑置之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"结客少年场","author":"潘伯脩","text":"黄金千，白璧双。\n东燕市，秦舞阳。\n西咸京，张辟疆。\n舞阳言死即死耳，执策驱之类犬羊。\n辟疆任智持两端，为虎傅翼加之冠。\n汉廷诸老失措手，大节为之久不完。\n英雄俯仰伤今古，成败论人何足数。\n我今绝交谢少年，西山拂石卧秋烟。\n丈夫未遇亦徒尔，渑池奋翼龙鸾鶱。\n由来万事付天道，为蛇为龙身已老，结屋青厓傍林鸟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"麦青青","author":"潘伯脩","text":"大麦青青三月中，东邻欲尽西邻空。\n几人忍死待麦熟，麦方掉头摇晚风。\n嗟来麦语汝，天已一月雨。\n麦今不自保，况乃未秋先易主。\n岂不闻二月卖新丝，麦苗典尽秋无期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石龟潭","author":"潘伯脩","text":"柔川有潭名石龟，石潭见底行斑鱼。\n中有小儿累十馀，爷娘困剧弃黄口。\n不忍面儿疾返走，脱儿饥大著水中，宛转呼啼亦何有。\n儿幸俦侣众，精魂未能消。\n散作飞虫上树木，黑为谢豹黄鸱枭。\n爷娘语精魂，毋烦啄我脑。\n三日五日吾当来，共汝相呼春树杪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"下第京师别诸乡友","author":"潘伯脩","text":"风纷客怀乡思起，吹作长云行万里。\n蛟龙春归恋窟泽，虹霓昼动含阴雨。\n忆昨路绕彭城来，酒酣独上歌风台。\n青天无云野草白，高帝事业安在哉！\n丈夫挟策干一命，忍耻随人作奔竞。\n道上能无屠狗人，戏作悲歌君莫听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万岁山","author":"潘伯脩","text":"龙首冈前玉树林，丹青万点紫烟深。\n广寒台殿秋如水，太液波涛晚向阴。\n西北云山凉冉冉，东南星海气湛湛。\n麟帘不卷空良夜，水鹤翛翛警露心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"积水","author":"潘伯脩","text":"白鹭群飞积水寒，怪鳞收雨渐泥蟠。\n冲风自散凉波上，落日犹明高树端。\n晚色无人聊伫立，秋声何处起丛攒。\n他年幸愿青山筑，拄杖穿云戴鹖冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆昨四首 其一","author":"潘伯脩","text":"忆昔西陵桥下路，彩舟初试一莲红。\n菱花妆镜春鸥里，杏子单衫玉笛中。\n郡国三年烽火入，楼台万井劫烟空。\n江湖何预人间事，沙合重洲不遣通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆昨四首 其二","author":"潘伯脩","text":"灵岩好在涵空谷，图画天开两洞庭。\n云日长天摇积水，蛟龙九月弄飞霆。\n舟归范蠡江湖远，兵压阊门草木腥。\n欲就吴王借秋剑，砚池星月洗秋萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆昨四首 其三","author":"潘伯脩","text":"二十四桥寒草绿，广陵无复见人家。\n解将明月金盘露，相劝春风玉蕊花。\n城苑西颓馀斥堠，衣冠南渡浑泥沙。\n登临俯仰千年迹，流水孤村属暮鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]