t":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼亡姬","author":"魏初","text":"草堂一觉巫山梦，行雨行云今不知。\n半夜青灯两行泪，催妆犹记去年时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"廉泉","author":"魏初","text":"廉泉乔木出氛埃，闻道平章手自栽。\n一巷绿衣人不见，依依如待相公来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕州王直卿父母八十之寿","author":"魏初","text":"人生偕老古犹稀，八十相看一与齐。\n有子有孙家事了，千年双鹤上天梯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"成美堂","author":"魏初","text":"偃蹇昂藏颇自奇，与人成美不求知。\n黄金铸就官街屋，不及传家一轴诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子午渡早发","author":"魏初","text":"五叶葵花盌口平，虎蹄新过树无声。\n三年按部成何事，才见山王远避行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汝郎川","author":"魏初","text":"汝郎川阔草油油，秃尾河淤一漫流。\n行上沙冈人不见，黍田平碧澹生秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江晚景","author":"魏初","text":"老树苍崖渍雨秋，布帆风满夕阳舟。\n生平一半江湖梦，不到元龙百尺楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"佚老堂为庸斋薛先生题","author":"魏初","text":"人海抽身得自由，只随耆旧见风流。\n而今冠盖长安道，老死黄尘不肯休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书王伯坚尚书海棠诗卷","author":"魏初","text":"柏乡花好入诗传，梦里石家锦障鲜。\n记与使君曾共醉，江郊亭下水如天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"甘泉","author":"魏初","text":"羊牛几点土空黑，尽日人烟不数家。\n赖得甘泉城外道，洛波如练带川斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"府谷","author":"魏初","text":"行行春雨复秋烟，西去长安又几千。\n落日空庭望南北，黄河城下水连天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"解仲杰景陶轩","author":"魏初","text":"梨花澹澹柳丝丝，午梦醒来半醉时。\n门外红尘三百丈，至人高卧看陶诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"愚轩","author":"魏初","text":"床头白酒屋头山，数册閒书竹两竿。\n张目不知人说似，门前骑马是高官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萧御史公琰","author":"魏初","text":"章章绵蕝叔孙通，矫矫麒麟御史骢。\n四海升平有今日，更须危论沃宸聪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其一","author":"魏初","text":"谱牒从姬旧有传，移家桑水忆当年。\n只缘遗泽今仍在，留得诸孙拜墓前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其二","author":"魏初","text":"菽水承颜尽所欢，传家风土占高寒。\n力田桑梓供租了，孝弟读书事最难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其三","author":"魏初","text":"袖里春风事蔼然，不争功利不争贤。\n苏州一说天机在，南北无兵四十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其四","author":"魏初","text":"不爱君家亿万赀，求师教子动京师。\n春风丹桂三千尺，秀出十郎更两枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其五","author":"魏初","text":"操艺逢时与命违，恬然心思不求知。\n两魁文赋今仍在，正是诸孙堕泪碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其六","author":"魏初","text":"河北兵尘拨不开，河南撑住数奇才。\n郏城一死人争惜，不到褒忠庙里来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其七","author":"魏初","text":"羽书南北无消息，山压孤城破卵时。\n一片丹心倚天地，未应巡远是男儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其八","author":"魏初","text":"危节中间奉节行，堂堂忠义见平生。\n归来杖屦林泉下，谁遣天朝识姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其九","author":"魏初","text":"诗礼庭闱少日情，乱来风雨一灯青。\n慇勤著就三千字，留与诸孙见典刑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顺圣先垄拜祀后有述十首 其十","author":"魏初","text":"丘山零落愧何穷，堂构空存惨澹中。\n倚日青松一千树，石鲸鳞甲动秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东峡","author":"魏初","text":"青崖直上耸苍烟，东峡中边尽水田。\n卖剑买牛吾有意，会须桑梓似当年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马谦甫颐贞斋","author":"魏初","text":"不必区区名利场，恰将真伪试论量。\n扪心有愧秋风屋，便与山雷是两乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蓄川 其一","author":"杨弘道","text":"蓄川膴膴，闲田可耕。\n孰非人子，耕我先茔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蓄川 其二","author":"杨弘道","text":"蓄川膴膴，闲田可艺。\n孰非人子，艺我茔域。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蓄川 其三","author":"杨弘道","text":"皇天后土，日月照临。\n汝耕汝艺，行者伤心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蓄川 其四","author":"杨弘道","text":"奸回自终，可按可考。\n利见大人，全我孝道。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古兴 其一","author":"杨弘道","text":"贞松千岁质，挺生乔岳阴。\n青崖樵径绝，斤斧胡能侵。\n来者不可测，祸福常相寻。\n狂风吹暴雨，倒泻江海深。\n霹雳根半断，直干犹森森。\n无人为扶持，默伤仁者心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古兴 其二","author":"杨弘道","text":"平原陷为湖，浩荡迷津步。\n中有断缆舟，楫舵失先具。\n风涛无定期，浮沉付冥数。\n忽忽已三年，未知止泊处。\n余生天地间，正可以此喻。\n春郊麦将枯，吁嗟望云雾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴","author":"杨弘道","text":"庭草泫晨露，孝心悽以悲。\n清溪有蘋藻，谁当采撷之。\n黄金入富室，务积不务施。\n孤鸟东南飞，巢在西北枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂兴","author":"杨弘道","text":"槐檀出新火，金鼎羹大胾。\n萤尾有微明，谁责烹饪事。\n日月澈层波，老蚌含珍异。\n采之光照乘，鱼目难拟议。\n李白桃夭夭，上苑春明媚。\n雨露成嘉实，燕赏歌既醉。\n无名閒草花，开落自荣悴。\n庄周谈天倪，坰野非弃置。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽怀久不写一首效韩子此日足可惜赠彦深","author":"杨弘道","text":"幽怀久不写，郁纡在中肠。\n为君一吐之，慷慨缠悲伤。\n辞直非谤讦，辞誇非颠狂。\n流出肺腑中，无意为文章。\n儿时捧书卷，十日读一箱。\n少年弄柔翰，开口吐凤凰。\n正月号悲风，穗帷挂萱堂。\n先君官汝阴，九月飞严霜。\n累累二十口，丹旐回南方。\n有叔不读书，但知禽色荒。\n呼卢畜鹰犬，置我游戏场。\n珠璧不受污，拂拭增耿光。\n郁郁弭南溪，绛帐县郡庠。\n组绣合尺度，道业传诸生。\n抠衣无几何，叉手一韵成。\n南溪具酒馔，列坐子侄行。\n青绫覆我身，醉卧家人傍。\n云间陆士龙，秋试独腾骧。\n明年桂枝春，兄弟双翱翔。\n半途失明师，欲济无舟航。\n故人何元理，白日照忠诚。\n劝我从延赏，然后学明经。\n三年走辽碣，险阻实备尝。\n鲸翻地轴倾，狼狈归故乡。\n铁马逐人来，蹴踏般溪冰。\n朔风振屋瓦，巷陌尸纵横。\n鸣镝射回雁，冰消溪水清。\n亲朋半凋落，残月依长庚。\n婉婉两稚子，面黥刀剑疮。\n田园幸无恙，出郭依农桑。\n锄耰干戈里，三稔无积仓。\n一官调神京，妻子不得将。\n风尘复澒洞，齐鲁多豺狼。\n赓歌无家别，挥泪哭途穷。\n李侯艺九畹，早播芝兰香。\n奇字来无趾，侧耳属垣墙。\n妆钿剪翠羽，堕珥舍明珰。\n缀缉不惮烦，既成衣与裳。\n一朝忽变化，头角高轩昂。\n男儿可如此，陋质倾高风。\n庶几困而学，否极承变通。\n师说无贤鄙，事业有专工。\n苟欲为贸易，入市审鞠躬。\n恩袍映野草，道与人俱东。\n负笈远方来，岐路无修长。\n拂衣叩君门，树屏遮长廊。\n温言当八珍，令色充壶觞。\n远来诚饥渴，蔓说辞乞浆。\n秉心在黑白，掉舌谈青黄。\n脸红眼尾斜，引手摩匡床。\n自惟珷玞石，不中圭与璋。\n君家杵臼閒，何事舂秕糠。\n乃知畜奇货，韫椟方深藏。\n仕途得捷径，改辙归大商。\n纷纷轻薄子，仁义久已亡。\n彼非仁义器，仁义何可当。\n夫子青云姿，疑似令人惊。\n在我固自存，为君惜清名。\n冰雪正凝冱，屈指回春阳。\n皓鹤毛骨轻，云静天苍苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游宁山寺入小敷谷","author":"杨弘道","text":"层层窣堵波，建标梵王家。\n宝殿倚绝壁，柏径通门斜。\n入山石巃嵷，峡路衔犬牙。\n长溪转白龙，架溜行青蛇。\n迅激巨轮翻，溅湿生石花。\n出山望平野，天钻蒺藜沙。\n暝色自远至，青林欲栖鸦。\n蝉声促归思，乱响如缲车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大名赠员善卿","author":"杨弘道","text":"小年尝学诗，中年多诗友。\n员子豪于诗，而复豪于酒。\n不知何所见，爱我心过厚。\n报之以新诗，金石非坚久。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠李正甫","author":"杨弘道","text":"富贵侈车服，鲜丽生光辉。\n贫贱窃慕之，勉强终亦非。\n东家借骏马，西家借新衣。\n顾盼骄路人，识者多笑讥。\n贫贱当勤劬，富贵起细微。\n俸秩既丰厚，不复布与韦。\n诗人有佳句，剽盗相因依。\n逮其能已出，此道方庶几。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠季尊师","author":"杨弘道","text":"季君本神人，冥晦居山中。\n还丹九转成，颜色如儿童。\n致虚感元气，语默与天通。\n频岁伤水旱，下民食不充。\n祈求降雨泽，呼召生雷风。\n上帝闻其贤，行事多阴功。\n策名紫虚府，进位称仙公。\n骑龙上天去，此乐无终穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城隅有一士","author":"杨弘道","text":"南山一何高，北渚青茫茫。\n可怜佳丽地，荆棘三十霜。\n芟夷营大宅，列肆来群商。\n倡优日歌舞，鞍马照地光。\n城隅有一士，垝垣缭茅堂。\n习坎失生理，家人知义方。\n貌言外卑逊，节行中贞刚。\n荒凉众所弃，上帝歆其香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洛阳别友","author":"杨弘道","text":"群居人间世，品汇各相索。\n性外更无物，乐处当自识。\n东州有诗翁，西州有文伯。\n欲往不计程，相逢心莫逆。\n茗酪以为饮，粱肉以为食。\n古今入商订，经传争辩析。\n西风旦夕来，面上无畏日。\n何以诧妻孥，归装满诗什。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"般水","author":"杨弘道","text":"般水出南山，辈行渑与淄。\n虽然未知名，亦有神司之。\n惟人神之主，主乱荒神祠。\n冥冥西南去，河伯多礼仪。\n溯流接伊洛，泾渭同遨嬉。\n漆沮品秩下，不敢相追随。\n朅来通汉沔，增大西南时。\n泓澄潜怪珍，名号遐方知。\n冯夷御白马，导我朝天池。\n长淮涌巨浪，阴兽翻修鬐。\n蹭蹬返故溪，岁旱流如丝。\n敢论尾闾泄，甘受蹄涔欺。\n三山兴云气，拥掩从灵旗。\n云是东海君，按节巡方维。\n不言恐失人，自献诚非宜。\n二者当处一，故作般水诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经历司北轩外新竹房","author":"杨弘道","text":"高人例爱竹，居必置左右。\n此君有雅操，凛凛岁寒后。\n黑水埋荒烟，川阔多胤胄。\n楚山昏瘴雨，石罅挺纤瘦。\n风俗视樵苏，斤斧莫恕宥。\n莲幕地深严，得所逾静秀。\n青苔春雨足，黄壤潜阳透。\n瑶桢扑霜粉，稚子解衣绣。\n羲伯歌朱华，新绿郁滋茂。\n群贤赞威德，堡障息烽候。\n北轩洒苍雪，饮奕破清昼。\n我本性介特，礼法以自囿。\n行年涉强仕，怀玉贾不售。\n何用羡此君，更积文行富。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玄鸟","author":"杨弘道","text":"太牢祠高禖，坠典今谁修。\n何处王谢堂，烧痕草芽抽。\n玄鸟亦自至，故垒不可求。\n衔泥营新巢，云海浮蜃楼。\n甲第金台傍，过者疑王侯。\n晨曦明画栋，珠箔上银钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石盆石菖蒲","author":"杨弘道","text":"山回溪流清，瘦茎生九节。\n参桂伯仲间，芝兰媲芳洁。\n重城烟尘昏，客土膏液绝。\n灵药不可活，我心方蕴结。\n巧匠刳云根，汲井注寒冽。\n青青渐滋荣，岁晚堪采撷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"橙实蜡梅","author":"杨弘道","text":"清霜洞庭实，万里登君筵。\n香肤缕黄金，粲粲明秋泉。\n馀子甘弃置，使与梅争妍。\n管库七十家，用则成才贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郏城僧院二首示县令 其一","author":"杨弘道","text":"君昔为高陵，其治在渭北。\n烽火照西郊，栖山避锋镝。\n东辕改郏城，浩荡弄春色。\n莫厌公事繁，客来方退食。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郏城僧院二首示县令 其二","author":"杨弘道","text":"清晨出都门，西望小峨眉。\n中途复徘徊，试来一见之。\n授馆萧寺中，花木荣春熙。\n竟日无人至，虚庭看游丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张县令赴任符离","author":"杨弘道","text":"兴定纪年后，治道日修饬。\n县令选尤重，非人莫轻得。\n东陲控淮泗，隐见吴山碧。\n尝获白兔瑞，贺书出韩笔。\n百里今付君，阳关歌祖席。\n和风翻行裾，花光照长陌。\n十年宿重兵，涉春微雨泽。\n鲸鲵虽陆死，馀孽尚狼藉。\n二事俱可忧，军食与民力。\n君名在兰省，安能淹此职。\n勿谓不久留，而遗后人责。\n常思君子居，一日必加葺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阀阅子","author":"杨弘道","text":"我本阀阅子，结发事文章。\n处世逢厄运，坎轲徒自伤。\n鸡鸣狗盗间，溷迹潜辉光。\n凶年大兵后，荒城守空仓。\n负担非我事，徒步昔未尝。\n四肢不胜劳，憩息坐道傍。\n仰观云悠悠，俯视尘茫茫。\n东风吹叹声，丽日为苍凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌霄","author":"杨弘道","text":"凌霄失高树，体弱无所依。\n幽禽辞其巢，万里将雏飞。\n故园霜雪繁，野水稻粱微。\n孤根幸不死，会有重芳菲。\n刷羽待高风，要趁花时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酂县道中","author":"杨弘道","text":"京东千里平，孟冬如季春。\n寸草不蔽日，汗滴途中尘。\n异哉中州地，若与穷发邻。\n谁持种树书，遍授东京人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]