[{"title":"高荣禄筑南城别墅，苍松老柏，异花时果，蔚然成林。公与夫人乘小车，携二孙，来往其间。徵余赋，遂次杜公何将军山林十首云 其七","author":"刘鹗","text":"自从辞禁闼，不复梦含香。\n地僻尘机息，心清六月凉。\n烟霞供笑傲，琴鹤共行藏。\n所喜身长健，从教鬓发苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高荣禄筑南城别墅，苍松老柏，异花时果，蔚然成林。公与夫人乘小车，携二孙，来往其间。徵余赋，遂次杜公何将军山林十首云 其八","author":"刘鹗","text":"百年半风雨，五世此台池。\n阴满蒲萄架，春浮木槿篱。\n持家还有妇，继志岂无儿？\n身外忧何事？\n惟教酒榼随。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高荣禄筑南城别墅，苍松老柏，异花时果，蔚然成林。公与夫人乘小车，携二孙，来往其间。徵余赋，遂次杜公何将军山林十首云 其九","author":"刘鹗","text":"对客歌金缕，家儿爱庆云。\n茂陵须病渴，太守尚能文。\n云映山光近，烟开柳色分。\n无边閒富贵，馀子苦纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高荣禄筑南城别墅，苍松老柏，异花时果，蔚然成林。公与夫人乘小车，携二孙，来往其间。徵余赋，遂次杜公何将军山林十首云 其十","author":"刘鹗","text":"宦海久无迹，风霜将奈何！\n起看天尺五，敢谓地无多。\n往事谁能忆？\n高情自可歌。\n年年当此日，载酒一相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎台肃驾","author":"刘鹗","text":"俯仰城空是，凄凉事已非。\n虚传天仗至，不见祖龙归。\n地迥风霜惨，云深日月微。\n高堂一惆怅，弱泪不胜挥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月十四日，崇天门听诏，有喜二首 其一","author":"刘鹗","text":"听罢龙飞诏，扬休万口俱。\n公忠赖伊霍，揖让见唐虞。\n礼乐开平治，衣冠协赞谟。\n祖宗遗泽在，千载巩皇图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十月十四日，崇天门听诏，有喜二首 其二","author":"刘鹗","text":"义理推明易，君臣庆会难。\n乾坤归历数，社稷重丘山。\n天意舒晴霁，人心溢喜欢。\n客愁浑为解，驴背永歌还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭饶上溪","author":"刘鹗","text":"霜蹄惊再蹶，绿鬓忽华颠。\n国子诸生集，膏肓二竖缠。\n死生人有命，京洛客无毡。\n归骨知何日？\n思君苦泪悬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致和参议吴彦洪，天历龙飞，以罪贬。既行，薄俗欲求君夫人孔氏为室家，孔闻之即自刎，流血被面，誓死不辱，或闻而止。越四年，诏雪君罪，且徵南还，遂与夫人相见如初。呜呼！视彼一易节，不见答于良人者，槩可感矣","author":"刘鹗","text":"夫妇天伦重，翻云世变深。\n秋霜持素节，颈血见丹心。\n岭外梅花瘦，闺中月影沈。\n归来情更苦，喜极重沾襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋晚溪上","author":"刘鹗","text":"忽忽年华度，茫茫野水流。\n西风杨柳雨，残照菊花秋。\n万事蕉中鹿，浮云海上鸥。\n功名遂意好，何处有扁舟？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜思家","author":"刘鹗","text":"清夜思家立，中庭片月流。\n惟忧故园菊，还似昔年秋。\n为口长怜雁，知机独愧鸥。\n明年二三月，烟水五湖舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孔与之赴乐安尉二首 其一","author":"刘鹗","text":"祖帐东门道，青山得意归。\n山城花泛泛，客路柳依依。\n地僻经过少，世平警逻稀。\n有诗频寄远，云忆别时飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孔与之赴乐安尉二首 其二","author":"刘鹗","text":"行旅清晨发，柴扉过夜扃。\n桑麻随地绿，苍藓上阶青。\n威武存三略，词华本六经。\n圣门家法在，随意忆过庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高氏十里庄","author":"刘鹗","text":"乘风高柳下，扪虱老松林。\n浊酒陶真趣，清泉洗此心。\n晚花偏有态，落日故多阴。\n揭厉宜深浅，行藏自酌斟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿阳城 时腊月九日，辱和尚司乡访，还因赋","author":"刘鹗","text":"但知为久住，何用即能归？\n客子亦良苦，官曹如此稀。\n繁霜吹老鬓，斜日照征衣。\n岁晚乡心切，长途恨不飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宁戚叩角图","author":"刘鹗","text":"月色夜轇轕，开门溪水明。\n天机閒始得，诗思静还生。\n柳影临流活，钟声傍夜清。\n频醒尘土梦，飞步欲登瀛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"居庸关","author":"刘鹗","text":"形势自雄壮，古来番汉分。\n千年有今日，四海喜同云。\n木落楼台出，山深鸡犬闻。\n危阑閒立马，壮气扫千军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪行简由伴读除江陵教授，谭玄之集贤掾除南雄经历。命既下，二公皆死于道，闻之有感","author":"刘鹗","text":"南风久不竞，天岂薄斯文？\n宦辙方云远，哀音遽忍闻。\n秋空残叶露，夜月断鸿云。\n苦泪无从洒，题诗独吊君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭友兄陈养志二首 其一","author":"刘鹗","text":"用世有远志，读书多苦心。\n花残偏值雨，云薄不成霖。\n翰墨风流尽，兴亡感慨深。\n池边老松树，无复共长吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭友兄陈养志二首 其二","author":"刘鹗","text":"讲习常同席，间关共出山。\n青霄鹤背稳，白昼锦衣还。\n雕鹗思腾汉，芝兰竟化菅。\n知君有遗恨，重我泪潸潸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐有感四首 其一","author":"刘鹗","text":"稍稍月当户，萧萧风满林。\n夜寒香梦远，霜重漏声沈。\n孝子终身泪，忠臣到死心。\n承平春似海，岂料有如今？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐有感四首 其二","author":"刘鹗","text":"祸福当求已，行藏欲问天。\n干戈今更盛，涂炭愈堪怜。\n痛恨储胥缺，何由郡国圆？\n恨无双羽翼，飞诉至尊前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐有感四首 其三","author":"刘鹗","text":"礼乐将兴日，干戈独盛时。\n圣躬无失德，天道苦难知。\n嗟尔民何负，甘心贼忍为？\n不平徒怏怏，推枕起裁诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐有感四首 其四","author":"刘鹗","text":"大厦将倾日，徒劳一木擎。\n揆时难与祸，避位敢忘君？\n无术能平寇，持威谩张军。\n中宵时念此，老气欲干云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"报获寇首","author":"刘鹗","text":"方建优升议，旋收斩馘功。\n老夫殊矍铄，诸将尽英雄。\n麾下人如虎，行间马似龙。\n渠魁今就戮，邻寇势应穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王棣诗卷后","author":"刘鹗","text":"白鹭从师日，高凉发轫时。\n正当供子职，勿负故人期。\n志在青云远，心清白日迟。\n少年宜努力，勉汝强题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十二月，桃花盛开，有感赋之","author":"刘鹗","text":"梅花犹在树，桃蕊已盈枝。\n岭外惊春早，江南得暖迟。\n好风吹锦绣，细雨湿胭脂。\n前度刘郎老，无心为赋诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄雄州监郡","author":"刘鹗","text":"既往那容咎，方来尚可追。\n好将功折过，直以勇忘私。\n董卓诚堪鄙，张巡岂是痴？\n凭君当静夜，仰屋试深思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄雄州太守谭元凯","author":"刘鹗","text":"幸际风云会，青云纵靶初。\n山川融间气，父子并司徒。\n勋业千年在，金珠过眼虚。\n期君师卜式，庶可遂良图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王志亮元帅草庵","author":"刘鹗","text":"中原方致力，那复以家为？\n结草聊为屋，编花谩作篱。\n招降多善策，横槊有新诗。\n文武才全备，王孙自一奇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曾惟吉所藏杨宗瑞赠其师张仲儒卷","author":"刘鹗","text":"诸老风流尽，遗经孰与论？\n携持文墨在，隐约父师存。\n世远情何极！\n人亡道愈尊。\n感君多古意，珍重付诸孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲宜以所植菊花见贻，以诗答之","author":"刘鹗","text":"新移初种菊，送与老夫看。\n粲粲黄金盏，煇煇白玉盘。\n虽迟偏有趣，欲罢更凭阑。\n乌府多松柏，相期共岁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经居庸北","author":"刘鹗","text":"峡束石如斗，山回路渐高。\n涧寒流水死，衣冷北风鏖。\n败屋兵戈惨，危途客旅劳。\n晤人多出塞，恨杀紫花袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宗性性庵","author":"刘鹗","text":"至理俱明彻，澄澄海不波。\n尚须妨蔽诱，直欲致中和。\n水面风光好，天心月色多。\n是庵清兴足，随意得婆娑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送胡宗性归武宁二首 其一","author":"刘鹗","text":"江湖多薄恶，兵甲更纵横。\n失意青云远，思亲白发生。\n畏途宜得友，随寓莫兼程。\n堂上思君切，持身勿自轻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送胡宗性归武宁二首 其二","author":"刘鹗","text":"文章追古作，挥洒与时新。\n可惜当衰运，何由识伟人？\n心坚无远道，孝感有神明。\n华屋斑衣酒，悬知笑语生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽刘原耕并刘母黄氏宜人","author":"刘鹗","text":"我母忝同姓，为儿犹弟兄。\n亲方悲夭折，母独喜恩荣。\n紫诰金花烂，斑衣鹤发明。\n暮年三釜养，重我泪如倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日","author":"刘鹗","text":"天门荡荡开黄道，丹陛雍雍肃晓班。\n御气拥云蟠凤阙，春风随酒上龙颜。\n君臣庆会赓歌际，礼乐升平揖让间。\n四海朝元无一事，华封但祝寿如山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓起","author":"刘鹗","text":"休官彭泽真忘世，捧檄庐江喜为亲。\n荐福自缘渠薄命，筑台敢谓世无人？\n但明一艺俱登仕，独拥群书不疗贫。\n竽瑟相违每如此，且须珍重百年身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铁马","author":"刘鹗","text":"伊谁巧铸渥洼姿，檐外鏦铮一线羁。\n带甲有声如击刺，凭鞍无力任驱驰。\n湘妃环佩天风急，蜀道霖铃夜雨悲。\n漫尔哀鸣求一顾，奈何钝质本无奇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"盆池","author":"刘鹗","text":"池中地窄一泓多，满注流泉复几何？\n皓月初圆先得影，微风虽动了无波。\n可容赪鲤十数辈，仅种圆荷三两窠。\n兀坐小窗炯相对，眼明时见白云过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苦雨独坐有感","author":"刘鹗","text":"白黑贤愚混是非，诙谐调笑足投机。\n平原具眼犹轻遂，延赏何人解识韦？\n红杏碧桃应懒种，孤云野鹤自高飞。\n世间处处鱼羹饭，好及秋凉早赋归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭泽","author":"刘鹗","text":"江汉朝宗第一门，擎天老树碧璘珣。\n乾坤设此宁无意？\n鬼物因之遂有神。\n一曲湖山知几劫？\n千年风致属何人？\n渊明老矣遗祠在，他日归来愿卜邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白雁","author":"刘鹗","text":"稻粱寒暑老营营，赢得秋霜满背明。\n夜月芦花空有影，江天雪暮但闻声。\n鲜鲜固与常禽异，皦皦尤为俗眼惊。\n珍重素衣须自爱，缁尘近日满江城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双陆","author":"刘鹗","text":"摴蒱小戏只消忧，但恨无人为点筹。\n几个疏星榆塞晓，半弯残月雁门秋。\n六军先满俱成列，单马如飞肯少留？\n迟疾知几应甚速，不知何日取封侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"射虎","author":"刘鹗","text":"弓强矢劲马初肥，猎得南山白额归。\n势力顿穷甘就戮，爪牙虽具果何为？\n深山百兽应无恐，绝壑幽狐莫假威。\n笑取髑髅横作枕，壮哉殊足快当时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅信","author":"刘鹗","text":"破雪争春喜夺魁，好音到我亦悠哉！\n孤山久渴诗人想，庾岭初逢驿使来。\n风细暗传香迤逦，月明难觅影徘徊。\n来朝著意勤寻问，只在前村野水隈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻新事","author":"刘鹗","text":"平原草木几无主，金谷楼台半是尘。\n已信齐桓能辅国，焉知陈胜足亡秦？\n国家自昔明刑宪，天地由来有鬼神。\n太息渠侬终不悟，翛然吾自爱吾贫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪作，萧同可有诗，次韵","author":"刘鹗","text":"风高海水化为石，天迥野云俱是冰。\n访戴何人复乘兴？\n平吴当日孰先登？\n清和月影明无奈，寒入梅花瘦不胜。\n大地无尘车马寂，晓来胸次尚澄澄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大明殿观元旦朝仪","author":"刘鹗","text":"云开日上黄金殿，地迥风鸣碧玉珂。\n虎豹关临仪仗肃，鱼龙海护俊良多。\n霓裳按曲身轻举，天乐逢春律自和。\n鹓鹭陪班臣子事，观时且赋太平歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨后","author":"刘鹗","text":"雨馀新水钓鱼船，残日西风树树蝉。\n间忆平生如昨日，不知急景已中年。\n姓名未辱当时识，德业犹堪异代传。\n拔剑悲歌频起舞，茫然欲绝伯牙弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋","author":"刘鹗","text":"又此中秋百恨生，频年骨肉尚飘零。\n独援北斗酌明月，閒看银河感客星。\n极目关河归白昼，满怀风露立青冥。\n眼前咫尺清虚府，未许乘鸾叩玉扃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"广寒殿，在万岁山上。山在水中，高数十丈。怪石古木，蔚然如天成。殿在山两傍，稍下，复建两亭，正当山半。又有殿萦然竹石间，山下积石为门。门前有桥，桥有石阑如玉。前有石台，上建圆殿，缭以黑粉墙，如太湖石状。台东西皆板桥，桥东接皇城，西接兴圣宫。水光云影，恍惚天上。喜而遂赋二首 其一","author":"刘鹗","text":"万岁之山天半青，广寒宫殿倚空晴。\n云生桧柏岩峦暝，日射蒲荷海水明。\n白玉阑深仙仗隐，绿杨桥锁小舟横。\n人间天上神飞越，恍惚霓裳第一声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"广寒殿，在万岁山上。山在水中，高数十丈。怪石古木，蔚然如天成。殿在山两傍，稍下，复建两亭，正当山半。又有殿萦然竹石间，山下积石为门。门前有桥，桥有石阑如玉。前有石台，上建圆殿，缭以黑粉墙，如太湖石状。台东西皆板桥，桥东接皇城，西接兴圣宫。水光云影，恍惚天上。喜而遂赋二首 其二","author":"刘鹗","text":"怪石疏林远艮岑，经营已近百年今。\n楼台白日神仙集，雨露青春草木深。\n游豫无忘前圣度，登临还忆上皇心。\n广推此乐同天下，四海讴歌岁旱霖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵家西隐叔见寄","author":"刘鹗","text":"前人硕德集隆禧，二百馀年运未衰。\n薄劣何堪文学掾？\n登庸幸际圣明时。\n蹇驴破帽随缘好，淡饭黄齑到处宜。\n三读来诗殊有感，贻名善恶敢忘思？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"来诗","author":"刘鹗","text":"毡寒绂冷宋天禧，十世中间几盛衰？\n青紫每由稽古力，公侯端有复初时。\n不能拔俗惭痴叔，足以光前赖阿宜。\n见说除书新入手，锦还何日慰吾思？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙锡种盆菊，列为河图","author":"刘鹗","text":"菊布河图眼自宽，缁衣如海不相干。\n幽姿过雨秋逾好，清意冰人夏亦寒。\n晚节独宜高自重，落英虽美竟谁餐？\n春风桃李非知己，珍重瑶琴勿浪弹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月三日，龙虎台接驾，晚宿新店","author":"刘鹗","text":"关南九月草凄凄，又见征人扈跸归。\n日落毡车团野宿，天寒塞马觅群嘶。\n徬徨恋阙孤忠在，俯仰随人百计非。\n犹幸诸公同笑语，归来茅店谩鸡栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日，次韵","author":"刘鹗","text":"京华四载倦为客，乐事良辰岂得兼？\n官况甚于纱帽薄，酒怀聊为菊花添。\n文章无用甘牢落，刀笔随宜谩伏潜。\n忽得新诗破孤闷，为君一笑起巡檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日，以公事随官曹之西山新寺，与宋良卿遍游诸寺","author":"刘鹗","text":"京城西北地多幽，依约江南九月秋。\n湖岸草枯霜欲下，野田水落稻初收。\n乡心无奈还随雁，机事相缠独愧鸥。\n犹喜簿书今颇静，追随官长赋清游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西山即事","author":"刘鹗","text":"鳌头突兀黄金殿，水面空明翡翠楼。\n锦绣山河天有待，帝王宫苑地长留。\n烟迷柳影三山晓，月浸荷花十里秋。\n更一登临多胜槩，五云南上即神州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉泉山二首 其一","author":"刘鹗","text":"杨柳芙蕖接断岑，流泉如玉本源深。\n四时潋滟无晴暖，一派清泠有古今。\n石井分甘供御膳，湖波流润洗尘心。\n我来正值秋将晚，独坐长吟雪满襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉泉山二首 其二","author":"刘鹗","text":"孤塔苍崖结搆牢，岿然俯视世滔滔。\n烟云连野心同远，楼阁依山步渐高。\n性本虚明宜自得，无经悟入亦徒劳。\n可怜有客勤三礼，不见灵光现玉毫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿安山","author":"刘鹗","text":"汉皇遗寺在人间，长使忠臣带泪看。\n六曲楼台殊壮丽，九天风露愈高寒。\n乘舆血污黄金辇，圆殿苔生碧玉阑。\n利益福田真浪语，当年共想寿而安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]