[{"title":"题周文矩画熨帛士女","author":"柯九思","text":"熨开香雾细裁缝，蜀锦吴绫五色秾。\n云母屏前秋冷澹，自将纤手折芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题拜石图","author":"柯九思","text":"麾斥烟霞世莫俦，须江太守独清流。\n庭前见石即下拜，石若有情应点头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王仁寿画驼","author":"柯九思","text":"西域降王朝正朔，名驼载玉晓连山。\n两峰残雪随羌鼓，万里流沙攲汉关。\n仗内垂铃珠错落，驾头蒙背锦斓斑。\n汝南粉本□□□，宁识如今满世间。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题姚娄东所藏平台寒林图","author":"柯九思","text":"古木寒林欲断魂，家山落日近黄昏。\n相从便问桃源路，绝顶人行何处村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子固画墨兰","author":"柯九思","text":"王子当时倚玉楼，飘萧翰墨足风流。\n人间自有清香种，不逐湘累一样愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题所藏赵仲穆画江山秋霁图","author":"柯九思","text":"国朝名画谁第一，只数吴兴赵翰林。\n高标雅韵化幽壤，断缣遗楮轻黄金。\n忆昔京华陪胜集，郎君妙年才二十。\n江南春雨又相逢，笔底秋山那可及。\n便欲追踪僧巨然，破墨烂熳还清妍。\n倚阑人待沧海月，悬崖树拂潇湘烟。\n老夫□爱扁舟趣，风静波深疑可渡。\n顾生痴绝忽大叫，指点前峰问归路。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李息斋画竹 其一","author":"柯九思","text":"仙客挥毫不可招，绿云犹绕翠蕤飘。\n天风吹醒丹渊梦，冉冉青鸾下九霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李息斋画竹 其二","author":"柯九思","text":"深宫雨过长苔痕，谁忆羊车旧日恩。\n惟有集贤癯学士，一枝漠漠记黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李息斋画竹 其三","author":"柯九思","text":"笔端随意长清标，疏叶生风剪剪飘。\n羸马城南看新笋，雨馀初散集贤朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李息斋画竹 其四","author":"柯九思","text":"使君弭节毗陵日，屏障家家有画图。\n何似小窗横幅好，青鸾双过洞庭湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭元方画海棠蛱蝶","author":"柯九思","text":"名花楚楚近清尊，蛱蝶春生五色痕。\n金屋琼窗无锁钥，蓬莱飞坠太真魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题苏叔党画竹石","author":"柯九思","text":"别墅促煎茶，溪边路不赊。\n蓝桥曾种玉，春笋出仙家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题武洞清阿罗汉像","author":"柯九思","text":"天厨送食鹿衔花，口诵恒河沙复沙。\n独立虚空无所住，石桥西畔老夫家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱舜举画杏花","author":"柯九思","text":"一枝繁杏逞妖娆，曾向东风杨柳腰。\n金水河边三十里，落红如雨玉骢骄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张叔厚白描乘鸾仙","author":"柯九思","text":"秦台缥缈近天涯，红露霏霏隔绛纱。\n萧史不归春欲老，吹箫祇在碧桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周昉画荔枝宫女图","author":"柯九思","text":"骊山宫殿九天开，盘出轻红破玉腮。\n中使传宣催驿骑，宫娥报道荔枝来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李遵道画竹","author":"柯九思","text":"秋风满纸老黄华，元气淋漓攲复斜。\n应是黄岩癯太守，青鞋时过野人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题温日观画蒲萄","author":"柯九思","text":"学士同趋青琐闼，中人捧出赤瑛盘。\n丹墀拜赐天颜喜，翠袖携归月色寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题从子伦写生芍药于玉山佳处","author":"柯九思","text":"九十春光事已非，翻阶红药尚天机。\n画工点染成生色，说与东君少待归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王元章写红梅花","author":"柯九思","text":"姑射燕支衬露华，一枝楚楚进天家。\n君王不作梁园梦，金水河边厌杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题冯子振横幅荷花图","author":"柯九思","text":"水殿风生酒力微，三千宫女绿荷衣。\n美人应妒花随去，月上瑶阶未肯归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题卢益脩画水仙花","author":"柯九思","text":"煖琼柔翠晓慵妆，香损鸳鸯瓦上霜。\n帝子愁多春梦远，佩摇明月近潇湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宋好古绿竹图","author":"柯九思","text":"仙子相邀驾綵鸾，瑶池玄圃拾琅玕。\n却怜宋玉多才思，貌得森森翠羽寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宋徽宗画柔条雨燕","author":"柯九思","text":"双双紫燕承恩重，立尽柔条活欲栖。\n莫忘六宫春雨暮，珠帘捲处不曾低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春直奎章阁二首 其一","author":"柯九思","text":"旋拆黄封日铸茶，玉泉新汲味幽嘉。\n殿中今日无宣唤，閒捲珠帘看柳花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春直奎章阁二首 其二","author":"柯九思","text":"春来琼岛花如锦，红雾霏霏张九天。\n底事君王稀幸御，儒臣日日待经筵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日会朝大明宫","author":"柯九思","text":"轩冕朝元涌翠埃，中天鸡唱内门开。\n云开五凤层楼矗，日绕群龙法驾来。\n谒者引班联宝带，上公称寿进金杯。\n撞钟告罢宫花侧，人指儒冠锡宴回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杜德常典签玉泉寺秋日感怀韵五首 其一","author":"柯九思","text":"万骑时巡九月回，年年望幸寺门开。\n儿童不识髯龙远，犹问君王几日来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杜德常典签玉泉寺秋日感怀韵五首 其二","author":"柯九思","text":"玉殿珠楼漾水光，翠华来幸拂天香。\n高皇魂魄应思沛，时有祥云护此方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杜德常典签玉泉寺秋日感怀韵五首 其三","author":"柯九思","text":"贝叶空闻驮白马，金根不复驾苍虬。\n当时迎日花如锦，一片人间逐水流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杜德常典签玉泉寺秋日感怀韵五首 其四","author":"柯九思","text":"锦缆牙樯天上移，美人争挽绿杨枝。\n如今泪洒西风急，采尽蘋花晚欲吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杜德常典签玉泉寺秋日感怀韵五首 其五","author":"柯九思","text":"萦波翠荇牵秋恨，泣露红蕖落晓芳。\n惟有旧时西岭月，自移阁影过朱墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尚医林邦献归天台省亲","author":"柯九思","text":"尝药事亲师华扁，玉函方秘得真传。\n采芝曾斸琼台月，煮朮时飘碧海烟。\n几载尚医留帝里，一朝归省上江船。\n五云阁吏今华发，为报桃花洞里仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠医者徐复庵","author":"柯九思","text":"人说徐卿有奇术，京华视病觅诗酬。\n能知梦里钧天乐，戏作壶中遁世游。\n客馆守丹和月坐，名山采药带云收。\n有人来问阳初复，杜若春风江上洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王诚夫赴无锡知州","author":"柯九思","text":"黄金横带烂辉光，出守宁辞道路长。\n鹓序久陪苍水使，凤池曾赴紫薇郎。\n双旌坐镇清溪月，列戟看凝宴寝香。\n肯汲惠山泉见寄，青春煮茗当还乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题安僧元帅远景亭","author":"柯九思","text":"东河亭子凭高爽，俯瞰平原绕茂林。\n沧海月生朱栱湿，秦山云起绣帘阴。\n梦回春渚钟声小，目倦晴空雁影沈。\n谁似诗书老元帅，清时于此写丹心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潞阳客舍和储生韵","author":"柯九思","text":"逆旅栖迟笔砚香，柳车底事恋文章。\n云拖鸿雁生秋色，月冷鱼龙涌夜光。\n恸哭有谁怜贾谊，形容已老似冯唐。\n风沙忽遇江南客，佳句犹期万里骧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送秘书掾李道济之峡州知事","author":"柯九思","text":"馆閤论交久，都门出饯迟。\n同为游宦客，忍赋送行诗。\n蜀道传鹦鹉，江亭叫子规。\n地偏公事少，峡外看舟移。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李教授之湖州","author":"柯九思","text":"水精宫里寻春处，天目山前看月时。\n隔岸园亭俱可爱，旧时风物未全衰。\n广文游宦诗如锦，博士淹留鬓欲丝。\n欲谢君恩无寸补，他年杜牧去应迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送达兼善赴南台御史","author":"柯九思","text":"杨花满堤春已暮，况是都门送客时。\n共陪鳷鹊方自慰，远乘骢马令人思。\n汀州水阔生杜若，山驿云深啼子规。\n东南此去须行志，斗米七千人苦饥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"俞希声置竹石于几案间名曰小山阴山阴吾之故乡不能无题","author":"柯九思","text":"昔年曾在山阴住，不谓山阴到此堂。\n苍苔翠竹汝所好，白石清泉吾故乡。\n禹穴有怀游太史，鉴湖无复赐知章。\n张帆明日竟东下，雨过西兴树影凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱舜举画梨花","author":"柯九思","text":"洛阳城西千树雪，走马看花遍阡陌。\n金鞭换酒为沈□，烂醉花前扶不得。\n粉香薰透诗人脾，思入吴笺洒残墨。\n别来风雨难为春，客怀几度孤清明。\n壮游回首已陈迹，一声啼鸟心魂惊。\n苕溪居士获天趣，造化潜移不知处。\n玉容寂寞澹春寒，犹记香山旧时句。\n羡君好古清有馀，励志耻作黄金奴。\n梅边握手恨不早，老眼半世空江湖。\n画图诗笔耀当代，大嚼屠门意殊快。\n更须什袭为珍藏，静里春光常自在。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画蕙","author":"柯九思","text":"一干生数花，春风折香玉。\n持之赠所思，幽人在空谷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题灵壁石","author":"柯九思","text":"翠滑烟虚小洞天，一辞泗水不知年。\n君王半醉宣和殿，曾见惊尘落舞筵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵承旨墨竹","author":"柯九思","text":"阊阖风来玉佩珊，洞庭秋入泪痕斑。\n至元朝士今谁在？\n翰墨风流满世间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题唐子华画秋江亭子","author":"柯九思","text":"林皋霜老红初冷，岩畔烟虚翠欲消。\n记得山阴曾访隐，一筇秋色度溪桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题从子伦画南山晓霁图","author":"柯九思","text":"少年曾殢南山胜，画舫笙歌日日来。\n第二桥边春水满，晓晴芳树散轻埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山谷咏马诗帖后","author":"柯九思","text":"道山书困下阶立，曾见先朝十二闲。\n紫翠楼台秋雨后，清诗零落向人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺中词写寄三首 其一","author":"柯九思","text":"阶前萱草可忘忧，底事王孙尚远游。\n却笑去年新种竹，锦绷已露竹根头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺中词写寄三首 其二","author":"柯九思","text":"物华生意隔湘帘，睡起残妆思更酣。\n微笑竟穿花畔去，背人低语折宜男。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺中词写寄三首 其三","author":"柯九思","text":"四月新笋长，五月萱草开。\n日长深院静，独自步苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乌夜啼写寄","author":"柯九思","text":"故宫芳草春日□，高林漠漠乌夜啼。\n乌啼不断愁深闺，万里封侯安足道，玉颜如花梦中老。\n东方欲曙乌飞去，门外落花红不扫。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成三绝写上就□匡庐山人 其一","author":"柯九思","text":"□华云影漾中郊，光曜纷纭动翠旓。\n玉笛夜吹山石裂，有人骑鹤过三茅。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成三绝写上就□匡庐山人 其二","author":"柯九思","text":"放日轻霞破晓阴，北窗徙倚听龙吟。\n光摇翡翠蓬山远，浪拥玻瓈贝阙深。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成三绝写上就□匡庐山人 其三","author":"柯九思","text":"青鸟当时养得驯，碧梧露下覆清晨。\n纱窗忽见秋如许，应有蛾眉忆远人。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓题寄玉山","author":"柯九思","text":"溪行何处是仙家，谷口逢君日未斜。\n隔岸云深相借问，青松望极有桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山书画楼口占","author":"柯九思","text":"红颜欲醉倚高楼，玉管声中桂子秋。\n如此江山不归去，冷云风急卧扁舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成戏简玉山人","author":"柯九思","text":"爱君谈笑俱清绝，昨日相逢是几回。\n春色不将尘事恼，杏花移得上窗来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姚娄东往武林和玉山韵以送","author":"柯九思","text":"我欲从君马首东，钱塘湖上看东风。\n六桥歌舞欢娱地，万井楼台深淡中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午日有感书寄","author":"柯九思","text":"红葵翠艾动千门，惟有苍梧雾雨昏。\n《离骚》歌舞湘妃怨，宋玉如花合断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至顺初上尝御奎章阁太禧使明理董阿中书左丞赵世安大司农卿哈剌八儿侍上从容询求江南之士臣九思以韩性张翥应诏上曰俟修皇朝经世大典毕卿至江南刊梓时可亲为朕召此二人者来试之馆阁臣九思再拜曰幸甚后有近臣自南使还者上问此二人其人亦曰佳士上颇悦后竟因循遂隔今举事玉山思之泫然流涕玉山请诗以纪因为四十字以寄二子云","author":"柯九思","text":"二美人间少，胡为沧海涯。\n文章联璧贵，声誉九重知。\n宣室今无召，丘园谩有诗。\n苍梧云叆叆，回首泪空垂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄筌梅花山茶野禽图","author":"柯九思","text":"萼绿仙人白玉冠，霞裙辉映碧云团。\n芳禽惯听吹箫暖，偎遍春丛午睡阑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵昌画牡丹鹁鸽","author":"柯九思","text":"雕阑玉砌旧承恩，轻吹凝香瑞霭温。\n宫女传言妃子笑，笑看驯鸽出金盆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"余旧为顾长卿作梅竹图明年其弟仲瑛于姚子章席上索题遂成口号云","author":"柯九思","text":"晴雪禁梅蕊，春风袅竹枝。\n美人应失笑，记得捲帘时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬陆友仁城南杂诗十首 其一","author":"柯九思","text":"尺五城南瑞霭浮，曾陪玉辂祀圜丘。\n太平礼乐逢昌运，亲见嘉禾屡有秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬陆友仁城南杂诗十