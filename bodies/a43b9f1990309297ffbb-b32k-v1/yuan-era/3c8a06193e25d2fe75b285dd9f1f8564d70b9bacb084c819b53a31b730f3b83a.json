y","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青宫受宝朝贺日次韵 其八","author":"吴当","text":"宫臣侍侧近炉熏，衣上龙乘五绣云。\n鸣玉锵金俱鼎食，早思偃武与修文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青宫受宝朝贺日次韵 其九","author":"吴当","text":"殿阁薰风奏舜弦，大明宫树不凝烟。\n圣人恭默惟思治，日历凭谁细细编。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青宫受宝朝贺日次韵 其十","author":"吴当","text":"深宫无处不开花，玉烛调阳运帝车。\n不是人间春易老，风光长只在天家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自然亭","author":"吴当","text":"盘结松萝覆顶青，云山四面作帏屏。\n秋风棋局无人看，夜月琴声有鹤听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月十日出城","author":"吴当","text":"病耄犹知发出狂，卧嗔恶少强移床。\n丈夫死义无悲泪，市上傍观为两行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出湖","author":"吴当","text":"鸿雁声低日己晡，扁舟渺渺出平湖。\n何时却为鲈鱼脍，写作寒江独钓图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六日舁床入城","author":"吴当","text":"舟子舁床入市廛，病躯仰面看青天。\n不知城郭还何似，听得行人叹昔年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成 其一","author":"吴当","text":"豫章城里听秋风，却向匡庐去住冬。\n白发数行非俗骨，青山千仞有云松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成 其二","author":"吴当","text":"十洲麒凤落江湖，遗老相逢说旧都。\n春日琼林看锡宴，天门金榜听传胪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成 其三","author":"吴当","text":"昔年策士奏题名，西内传宣御仗迎。\n金织承筐怀旧赐，白头何以荅升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成 其四","author":"吴当","text":"战骨生尘塞草长，将军己拜右贤王。\n节旄落尽苏卿老，渤海沙飞尚牧羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成 其五","author":"吴当","text":"霜月横空雁不眠，夜寒边燧尚传烟。\n伤心江上垂纶客，不为鲈鱼系钓船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏","author":"吴当","text":"江头雄锁控东西，长叹忠臣效节时。\n满目山川天险在，不将版锸虑安危。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20370,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忠臣","author":"吴当","text":"万里江淮接楚舒，连云楼橹见储胥。\n睢阳不独张巡死，汗简应留太史书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20371,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宪使储布哈守楚元帅余阙守舒 其一","author":"吴当","text":"万方海宇一封疆，郡邑胥豪玩宪章。\n寂寞荒城今第宅，家家故牍满新墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20372,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宪使储布哈守楚元帅余阙守舒 其二","author":"吴当","text":"败苇萧萧故垒秋，江山如画一渔舟。\n怪来不起临濠兴，病久愁深泪易流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20373,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宪使储布哈守楚元帅余阙守舒 其三","author":"吴当","text":"庐岳层层耸碧空，仙岩佛塔白云通。\n几多楼阁青红地，尽在寒烟野蔓中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀","author":"吴当","text":"昔贤讲道秩宾筵，五老香炉蔼紫烟。\n前代衣冠今寂寂，故溪风月自年年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先子讲道濂溪书院今四十馀年 其一","author":"吴当","text":"关雎麟趾久无声，谁共周官识治平。\n独抱遗经身己老，空山落月梦魂惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先子讲道濂溪书院今四十馀年 其二","author":"吴当","text":"江头风月夜萧萧，旅馆寒灯共寂寥。\n三月病来忘肉味，九天清夜听箫韶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先子讲道濂溪书院今四十馀年 其三","author":"吴当","text":"春雨黄精似玉?，东风漠漠紫山薇。\n饥来白石还堪煮，自叹时人服食稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先子讲道濂溪书院今四十馀年 其四","author":"吴当","text":"柳外郊墟旧战场，寒芜秋燐暮云黄。\n渐看三月莺花里，陌上新苗陇上桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"先忌日","author":"吴当","text":"云谷烟村事事非，凫飞不到雁来稀。\n楸梧几个人千里，不独今朝泪满衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观大明殿图","author":"吴当","text":"大明宫阙五云端，簪笔趋朝老从官。\n白发十年江海外，人间写作画图看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其一","author":"吴当","text":"周业凌迟伯失宗，纷纷功利起衡从。\n时君不识真王佐，卿禄宁辞十万钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其二","author":"吴当","text":"牛酒争迎暴已除，沛中屠贩漫高车。\n鸿沟更举真筹策，圮上功成一卷书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史 其三","author":"吴当","text":"受命趋关定约时，鄛翁多算竟何为。\n可怜空碎鸿门玉，天下雄雌亦易知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]