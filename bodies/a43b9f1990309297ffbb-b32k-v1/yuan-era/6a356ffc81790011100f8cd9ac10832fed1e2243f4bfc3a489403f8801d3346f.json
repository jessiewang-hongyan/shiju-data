[{"title":"百香诗 其十七 酒帘","author":"郭居敬","text":"勾引游人入醉乡，风中摇曳自飞忙。\n一竿斜出高楼外，大字矜夸竹叶香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其十八 胭脂","author":"郭居敬","text":"燕赵佳人独擅场，临鸾梳掠细端相。\n歌唇点破樱珠艳，笑脸□开杏蕊香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其十九 粉","author":"郭居敬","text":"清如翡翠帘前雪，白似鸳鸯瓦上霜。\n镜里妆成花□艳，指尖勾破玉生香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十 龙","author":"郭居敬","text":"天渊上下任行藏，岁旱为霖泽八荒。\n领下珠光金甲冷，潭心日暖玉涎香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十一 马","author":"郭居敬","text":"龙池飞去快腾骧，上应房星一点光。\n千里归来天未晚，满身云湿五花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十二 鱼","author":"郭居敬","text":"同队嬉游一镜塘，往来戏弄碧波光。\n不知谁洗芸窗砚，吞得胸中墨水香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十三 雁","author":"郭居敬","text":"万里云衢羽□长，寒潭影落两三行。\n江南满目烟波阔，处处西风菰米香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十四 莺","author":"郭居敬","text":"宛转歌喉春昼长，高迁乔木占风光。\n朝来飞入花深处，露滴金衣点点香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十五 燕","author":"郭居敬","text":"阴落东风又海棠，重来营垒语雕梁。\n小池水涨芹芽知，衔得春泥一点香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十六 蝶","author":"郭居敬","text":"东风花国是吾乡，一点春心日日忙。\n昨夜牡丹丛里宿，满庭风露梦魂香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十七 蜂","author":"郭居敬","text":"日暖西园队队忙，闲随胡蝶度邻墙。\n几回飞向吟窗过，花外风来带蜜香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十八 瓜","author":"郭居敬","text":"西域星槎远取将，青门五色想难方。\n金刀切落水花冷，沁透相如渴脉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其二十九 李","author":"郭居敬","text":"绿阴亭上午风凉，旋摘枝头荐酒觞。\n颗颗登盘青玉瑩，金盆沉浸井泉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十 橄榄","author":"郭居敬","text":"纷纷青果荔枝乡，八月寒风九月霜。\n莫怪渔樵轻弃掷，未知回味齿牙香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十一 槟榔","author":"郭居敬","text":"南海单传辟瘴方，朝朝咀嚼润枯肠。\n绿藤翠叶明人眼，白玉盘中玛瑙香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十二 茶","author":"郭居敬","text":"东风买勇武夷乡，抽出先春第一枪。\n战退眠魔无避处，瓦瓯汹涌雪涛香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十三 酒","author":"郭居敬","text":"江头杜老典衣醉，垆畔吴姬唤客尝。\n拍拍满怀春意足，真珠红滴小槽香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十四 牡丹","author":"郭居敬","text":"千古芳名出洛阳，身居花国合称王。\n玉栏干外东风软，日映红云一朵香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十五 芍药","author":"郭居敬","text":"红灯烁烁映春光，绿叶团团近画廊。\n青琐仙郎一题品，至今翰墨尚遗香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十六 海棠","author":"郭居敬","text":"高烧银烛照红妆，不与花神入睡乡。\n外酒未醒春思重，君王带笑坐沉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十七 蔷薇","author":"郭居敬","text":"亭亭画架倚东墙，叶引芳条近绿杨。\n帘额低垂春昼永，一庭红雪暖气香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十八 木香","author":"郭居敬","text":"细细鳞鳞引蔓长，暖风帘幕燕飞忙。\n吟边多谢司花女，新织一机黄锦香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其三十九 梨花","author":"郭居敬","text":"皎如玉树出雕墙，好举清樽为洗妆。\n寂寞一枝春雨里，马嵬坡下返魂香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十 桃花","author":"郭居敬","text":"蜂蝶纷纷过短墙，千枝万蕊占年芳。\n仙花自与凡花别，流出武陵春水香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十一 柳花","author":"郭居敬","text":"雪落纷纷莫比方，吟边输与谢家娘。\n春春三月金陵市，可爱春风满店香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十二 真珠花","author":"郭居敬","text":"颗颗铺排翠叶光，春回合浦价难量。\n晓来三□花间露，犹带鲛人泣泪香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十三 莲花","author":"郭居敬","text":"源头活水满方塘，净植亭亭异众芳。\n世上已无周茂叔，不知今日为谁香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十四 桂花","author":"郭居敬","text":"谁剪仙花四出黄，枝枝叶叶翠交相。\n世人若把黄金比，只恐黄金不解香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十五 木犀","author":"郭居敬","text":"荷芰衰零菊未黄，婆娑一树影蟾光。\n春园红紫知多少，无比西风半点香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十六 菊花","author":"郭居敬","text":"楚臣孤苦空醒眼，晋令疏狂已醉乡。\n除却两翁知己外，只今谁复爱秋香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十七 茉莉","author":"郭居敬","text":"满畦清气逼炎荒，翠叶参差玉蕊光。\n平夜纱厨凉似水，薰人吟梦不胜香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十八 柳眉","author":"郭居敬","text":"东风蕴藉学张良，画出章台翠叶长。\n好看晓烟轻湿处，胜如镜里麝煤香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其四十九 荷钱","author":"郭居敬","text":"团团万选贴波光，个个天成胜孔方。\n买断西湖风与月，更无铜臭只闻香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十 荼醾","author":"郭居敬","text":"问酒村中酣雨意，题诗园里闹晴光。\n绿纱捻作柔条细，绛蜡融成艳蕾香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十一 山兰","author":"郭居敬","text":"棱棱剑叶翠尖长，生长云根野水傍。\n一点骚魂清万古，山灵未许閟幽香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十二 采莲","author":"郭居敬","text":"小小兰舟载艳妆，琵琶声里水风凉。\n玉纤折断红云朵，日暮归来满袖香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十三 见梅","author":"郭居敬","text":"铁枝列戟出苔墙，玉蕊含春破晓霜。\n如是朝来吟案上，寒风一点入诗香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十四 芙蓉","author":"郭居敬","text":"妆点秋容出粉墙，碧云四畔拥花房。\n真妃酒困胭脂重，织女机寒蜀锦香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十五 红梨花","author":"郭居敬","text":"不分沉香睡海棠，也来涂抹入时妆。\n樽前且对红裙醉，诗底休吟白雪香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十六 白芙蓉","author":"郭居敬","text":"金井梧桐一叶黄，亭亭玉树映秋光。\n马嵬坡下人千古，幻出当时粉面香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十七 白牡丹","author":"郭居敬","text":"风暖瑶亭春昼长，天然国色异群芳。\n广寒宫里嫦娥面，肯□燕脂半点香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十八 墨梅","author":"郭居敬","text":"玉骨冰肌压众芳，鹅溪半幅贮春光。\n黄昏月淡霜风紧，只欠窗前影与香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其五十九 红梅","author":"郭居敬","text":"雪里相逢笑一场，淡妆不爱爱浓妆。\n时人只羡朱颜好，不道春风减却香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十 樱桃花","author":"郭居敬","text":"霜叶枯枝未退黄，繁开满树动春阳。\n碧纱窗外移红影，暖日薰人鼻观香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十一 松","author":"郭居敬","text":"岁晚山空伯仲行，梅花洁白竹青苍。\n冰霜节操凌云气，肯授秦封雨露香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十二 竹","author":"郭居敬","text":"清似夷齐立首阳，平生高卧傲风霜。\n若教汗简修青史，多少人留姓字香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十三 梅","author":"郭居敬","text":"美玉精神鹤膝长，冰霜国里破天荒。\n魁名且占群芳上，异日调和鼎鼐香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十四 白菊","author":"郭居敬","text":"西风夹雪过南荒，欲落东篱深处藏。\n谁料朝来三径里，花神幻化作秋香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十五 剪彩花","author":"郭居敬","text":"剪彩为花花异常，枝枝点缀作春光。\n都缘不惹闲蜂蝶，胜似浮花浪蕊香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十六 灯花","author":"郭居敬","text":"开时浑不待春光，一蕊银釭冷焰长。\n檐影无风深处静，不愁蜂蝶暗偷香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十七 花影","author":"郭居敬","text":"月来花底弄清光，半上窗纱半短墙。\n宴坐瑶台春夜永，看来端的胜花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十八 红叶","author":"郭居敬","text":"满林碎锦染新霜，几片飞来入画廊。\n曾与深宫寄愁怨，御沟流出一联香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其六十九 草","author":"郭居敬","text":"毡似青青带似长，丛丛秀色泛烟光。\n春风吹醒西堂梦，留得诗名万古香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十 斗草","author":"郭居敬","text":"采采奇芳映绣裳，三三五五蹈青阳。\n全筹赢得金钗去，一路春风语笑香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十一 苍苔","author":"郭居敬","text":"土花著雨自苍苍，渐染新痕上画廊。\n好是东风三月暮，落红绣出翠纹香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十二 萍","author":"郭居敬","text":"柳花飞雪落寒塘，幻出浮生泛水光。\n好与三千汉宫女，晓妆齐贴翠钿香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十三 水","author":"郭居敬","text":"粼粼鸭绿飏清光，日夜朝来有底忙。\n好有金鳞乘浪暖，桃花流出禹门香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十四 露","author":"郭居敬","text":"酥润花枝垂苑囿，珠生荷叶满池塘。\n金人掌上秋宵冷，留与君王饮玉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十五 香炉石","author":"郭居敬","text":"不学金猊置画堂，仙家顿放水中央。\n寒烟漠漠霜风里，只□梅花一瓣香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十六 题缺","author":"郭居敬","text":"一规蟾魄出天汉，万里山河一色光。\n笑饮西楼清不寐，玉杯影里桂花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十七 夜雨","author":"郭居敬","text":"梦断瑶台夜未央，檐声滴滴下空廊。\n杏园明月堪惆怅，零落燕胎满地香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十八 春游","author":"郭居敬","text":"傍柳随花笑几场，管弦声里度韶光。\n尘随金勒□□细，风飏罗衣缕缕香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其七十九 春宵","author":"郭居敬","text":"瑶台深处引壶觞，一刻千金玉漏长。\n醉倚东风眠未得，满庭明月浸花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十 春晚","author":"郭居敬","text":"绿叶分阴覆画廊，西园雨后蝶蜂忙。\n千红万紫消磨尽，犹有荼醾一注香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十一 春晚","author":"郭居敬","text":"樽前一醉绮罗乡，杜宇声中几断肠。\n燕蹴飞花红雨落，马嘶芳草绿云香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十二 初夏","author":"郭居敬","text":"深院沉沉午漏长，画栏西畔看鸳鸯。\n小池水满薰风细，已有新荷一叶香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十三 夏","author":"郭居敬","text":"炎炎红镜出东方，绿树阴浓白昼长。\n山酒一樽棋一局，好风隔竹度茶香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十四 秋","author":"郭居敬","text":"半痕淡月弄清光，几信微风合嫩凉。\n菊圃未开三径艳，桂林先放一枝香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十五 冬暖","author":"郭居敬","text":"一冬天气暖无霜，欹枕山楼客□乡。\n睡又不成吟又懒，溪风吹送野梅香。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十六 山庄夜","author":"郭居敬","text":"寂寂蓬门雪夜长，一炉柴火辟寒光。\n果盆饤蔟山橙小，瓦瓮新篘浊酒香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十七 冬夜","author":"郭居敬","text":"读遍南华夜更长，竹炉火暖酒如汤。\n一时诗思清人骨，窗外梅花浸月香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十八 山行","author":"郭居敬","text":"一径逶迤碧草长，短筇随处看岚光。\n春风颇解诗人意，时送幽花一阵香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其八十九 诗","author":"郭居敬","text":"呕出心肝只恁狂，清风明月满奚囊。\n他年会遇君王颜，题在金屏家家香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十 曲","author":"郭居敬","text":"十八燕姬宫样妆，缓歌金缕宴华堂。\n桃花扇底春风暖，一点梁尘落酒香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十一 美人","author":"郭居敬","text":"雪作春衣霞作裳，远山淡淡浸波光。\n绿窗睡起新梳掠，斜插梅花一剪香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十二 贫女","author":"郭居敬","text":"寂历蓬门春日长，奉姑辛苦事蚕桑。\n自甘镜里冰霜影，不带人间脂粉香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"百香诗 其九十三 泪","author":"郭居敬","text":"独坐纱窗别恨长，几回偷滴断鸾肠。\n黄昏门掩梨花雨，界破残妆一线香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]