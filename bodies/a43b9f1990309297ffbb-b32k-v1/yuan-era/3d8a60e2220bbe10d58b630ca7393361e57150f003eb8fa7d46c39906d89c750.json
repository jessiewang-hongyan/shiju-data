[{"title":"答茅山道士见寄","author":"萨都剌","text":"道人自有爱山癖，蜡屐平生几两穿。\n七窍冷云秋喷竹，一琴明月夜调弦。\n山中紫府茅君宅，肘后丹方许史传。\n短褐拟寻黄犊出，长镵斸雪早春前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬张伯雨寄茅山志","author":"萨都剌","text":"恨余未识茅君面，喜得茅山道士书。\n灯外雨声那厌听，风前石发岂堪梳。\n碧窗云气寒生楮，清室丹珠夜绕厨。\n梦到层台夜披卷，桂林风动月疏疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奎章阁观进皇朝经世大典","author":"萨都剌","text":"文章天子大一统，馆阁词臣日纂脩。\n方丈奎光悬秘阁，九重春色满龙楼。\n门开玉钥芸香动，帘捲金钩砚影浮。\n圣览日长万几暇，墨花流出凤池头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西宫春日与吴锦衣赋","author":"萨都剌","text":"九重春色金银阙，冠带将军尽羽林。\n上苑春莺随柳啭，西宫午漏隔花深。\n天开阊阖收金锁，帘卷奎光听玉音。\n白发儒臣卖词赋，《长门》应费万黄金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京师春夜呈宋礼部","author":"萨都剌","text":"柳色无端染翠裙，官街车马去纷纷。\n莺花御苑春多少，漏箭宫壶夜几分。\n金缕悠扬燕市月，玉箫缭绕凤楼云。\n太平天子恩如海，亦遣馀音客枕闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王习灵新授宗师朝京","author":"萨都剌","text":"玉佩珊瑚下界闻，天风吹动碧榴裙。\n刘郎跨鹤游三岛，王子吹箫到五云。\n花洞夜深传玉印，石坛月黑礼茅君。\n若逢天上吴夫子，应有丹砂肯我分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠鲜于伯机","author":"刘祁","text":"忆昔逢君北渚秋，藕花香里醉轻舟。\n三年一别空回首，千里相思更倚楼。\n明月不随春物老，碧山长带暮云愁。\n天平松竹黄华水，早晚柴车得共游。\n思君一日如三载，两寄诗来慰我心。\n尘土愈知人世隐，风烟遥见海门深。\n贫来笑我常痴坐，乱后怜君更苦吟。\n历下亭前春水阔，扁舟何日重相寻？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄新原林道士","author":"萨都剌","text":"我识华阳林道士，步虚空里带淮腔。\n几年挂剑茅君洞，一夜渡船扬子江。\n醉酒惯眠松下石，题诗爱近水边窗。\n仙家白鹤养无数，不惜人间借一双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游钟山感兴","author":"萨都剌","text":"骢马穿松到上方，南巡辇路碧苔荒。\n禅僧白首看行殿，山鬼黄昏避御床。\n云冷夜无龙在钵，日长时有虎巡廊。\n小桃十月开如锦，犹带前朝雨露香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日登北固多景楼录奉即休长老二首 其一","author":"萨都剌","text":"醉拍阑干起白鸥，登临不尽古今愁。\n六朝人物空流水，三国江山独倚楼。\n秃发凉风吹木叶，孤城落日下帘钩。\n海门不管兴亡事，犹送春潮打石头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤林僧送竹笋","author":"萨都剌","text":"棕鞋桐帽走风雨，正是山僧送笋时。\n夜月不留栖凤影，春雷失却化龙枝。\n从来不识葛藤味，此去方参玉版师。\n老子胸中冰雪满，岁华晚节更相期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游钟山遇雨","author":"萨都剌","text":"虎踞龙蟠翠作堆，竹舆高下路萦回。\n潮声万壑松风过，云气满楼山雨来。\n梁武庙前芳草合，荆公墓下野花开。\n百年感慨成何事？\n且尽生前酒一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陪张御史游钟山","author":"萨都剌","text":"乌府仙人獬豸冠，清游喜得共儒酸。\n鹃花过雨干岩净，骢马穿云六月寒。\n山鬼每惊诗句险，客怀惟爱酒杯宽。\n一时佳兴千年遇，莫作浮生半日看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题半山寺","author":"萨都剌","text":"今日偶成林壑趣，清幽恨未得从容。\n龙归石洞半山雨，潮卷天风十里松。\n春路泥深多滑马，晚楼雾重只闻钟。\n荆公旧隐知何处，回首苍茫第几重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城玩雪","author":"萨都剌","text":"雪正纷纷客倚栏，长江风急吼天关。\n干重铁瓮成银瓮，一夜金山换玉山。\n舟子迷归寒浦外，衲僧疑在白云间。\n晓来霁日高林照，好景依然悦我颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游金山","author":"萨都剌","text":"约客同游买渡船，閒观古刹礼金仙。\n山中好景无多地，天下知名第一泉。\n佛阁齐云浮海屿，客帆过寺带风烟。\n当年郭璞因何事，来葬江心作浪传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"平望驿道","author":"萨都剌","text":"左带吴松右五湖，人家笑语隔菰蒲。\n风涛不动鱼龙国，烟雨翻成水墨图。\n越客卧吹船上笛，吴姬多倚水边垆。\n鉴湖道士如招隐，一曲他年得赐无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王御史","author":"萨都剌","text":"骢马如龙玉作鞭，江头下马上官船。\n承恩不比寻常辈，入谏频瞻咫尺天。\n草满畬田多战骨，花飞驿路少人烟。\n宪台自是清高甚，时事关心易白颠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题玄妙观玉皇殿","author":"萨都剌","text":"虚空台殿枕层岑，木杪丹梯起百寻。\n花落鸟啼青竹里，客来犬吠白云深。\n松坛昼日移幢影，石室天风送铎音。\n老鹤如人窗下立，閒听羽士理瑶琴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复题平望驿","author":"萨都剌","text":"秋雨黄华下九天，又随归雁过吴川。\n荒村有火夜投宿，野渡无人秋放船。\n中酒不堪连夜饮，思家无奈五更前。\n归来却被青山笑，万丈黄尘两鬓烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日侍驾游香山","author":"萨都剌","text":"马上游人隔苑墙，天家未肯纵春阳。\n轻寒轻暖鸟声转，无雨无风花命长。\n香殿云烟随凤辇，交旂日月耀龙章。\n三三节近晴光稳，满进虞廷万岁觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓升龙观时吴宗师持旨先驾至大都度滦川遂次韵赋此以寄并简顺咨先生","author":"萨都剌","text":"扈跸千官取次行，道人先踏雪泥晴。\n关南日暖龙颜近，岭北风高鹤背轻。\n丞相早行霜滑马，将军夜宿火连营。\n一年两度经过处，惟有青山管送迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送南安镇抚赵南山捧表西省","author":"萨都剌","text":"平生尺剑众中师，臣子肝肠天地知。\n少壮金戈探虎穴，太平铠甲网蛛丝。\n青衫白发尊前酒，紫塞黄云马上诗。\n今日又随天表去，梅花香里立沙墀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过李陵墓","author":"萨都剌","text":"降入天骄愧将才，山头空筑望乡台。\n苏郎有节毛皆落，汉主无恩使不来。\n青草战场雕影没，黄沙鼓角雁声哀。\n那堪携手河梁别，泪洒西风骨已灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟李陵送苏武","author":"萨都剌","text":"同是肝肠十九年，河梁携手泪潸然。\n铁衣骨朽埋沙碛，白首君归弃雪毡。\n海北牧羊无梦到，上林过雁有书传。\n汉家恩爱君须厚，剪纸招魂望塞边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河夜送西台御史张子寿时新除湖广佥宪","author":"萨都剌","text":"爱君足迹半天下，白简清霜秋气多。\n帆影东南湖上去，马蹄西北日边过。\n风波玉露仙人掌，文彩云机织女梭。\n自笑追随远游客，斗槎星夜下黄河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河夜雨怀兀颜子方","author":"萨都剌","text":"风流俊逸四公子，轻帽短衣过鲁城。\n紫陌东风閒戏马，绿窗明月醉闻莺。\n樱桃花下春中酒，沈水香回夜按筝。\n独有黄河千里客，短篷听雨到天明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高唐驿","author":"萨都剌","text":"三尺高唐帝子坟，东风吹草绿沄沄。\n官中子母生前别，天上箫韶梦里闻。\n日暮白杨飞乱雪，夜深黑气结愁云。\n小臣泣血应无补，留与他年太史云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王御史时巡历河道解舟金陵","author":"萨都剌","text":"淮南雨过好晴色，御史楼船动楚桡。\n杨柳清风秋解缆，琼花明月夜闻箫。\n卧听天上银河浪，梦到云边白玉桥。\n后夕相思裁短咏，莫将书札付洪乔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游铁塔寺","author":"萨都剌","text":"江南地僻繁华盛，古寺巍然铁塔存。\n金屋月梅横夜雨，铜驼露草泣秋原。\n六朝王气人何在，几度悲风铃自喧。\n尚有他年旧时字，摩挲一半没苔痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送外舅慎翁之燕京","author":"萨都剌","text":"扬子江头柳色浓，小船春雨去匆匆。\n青袍铁瓮龙门婿，紫锦蒲帆鹤发翁。\n晋府旧臣还塞北，星门娇客卧床东。\n明年亦是燕山客，骑马天街踏软红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日登北固多景楼录奉即休长老二首 其二","author":"萨都剌","text":"东风吹树散晴岚，独上层楼酒半酣。\n拍岸潮声来海外，满江山色入淮南。\n当时霸主分三国，此日吴禅老一龛。\n惟有楼前旧时柳，年年三月色如蓝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"还京口","author":"萨都剌","text":"黄鹤山头雪未消，行人归计在今朝。\n城高铁瓮江山壮，地接金陵草木凋。\n北府市楼开旧酒，南朝官柳识归桡。\n吏人莫见参军面，水宿风餐鬓发焦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄金山长老","author":"萨都剌","text":"老师召对金銮殿，喜动龙颜坐赐茶。\n一日潮音起般若，九重春色上袈裟。\n高风已入三天竺，妙果重开五色花。\n渴想杨枝旧甘露，何时一到病人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊尽过练湖","author":"萨都剌","text":"独倚牙樯数客程，残年风景足乡情。\n寒天半夜无人语，明月满船闻雁声。\n云外好山如有约，烟中野树不知名。\n明朝乌鹊桥头闹，应是人家出户迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丹阳普宁寺席上","author":"萨都剌","text":"红白桃花开满枝，满城微雨牡丹时。\n因过古寺逢僧话，莫遣扁舟解缆迟。\n客里逢春多病酒，江南到处半题诗。\n山川总是曾游处，一曲琵琶写别离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王郎还钱塘","author":"萨都剌","text":"王郎会我丹阳郭，归兴钱塘不可留。\n北固雪晴山出画，西湖春动水明楼。\n草生湘浦行人远，日落吴山故国愁。\n安得与君二三月，买花沽酒醉红舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿玄洲精舍芝菌阁别张伯雨二首 其一","author":"萨都剌","text":"一到茆山三日留，满山风雨过中秋。\n云行松树高低见，日落涧水东西流。\n外史相邀登菌阁，此身只合往瀛洲。\n它年丛桂结招隐，野服愿随麋鹿游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿玄洲精舍芝菌阁别张伯雨二首 其二","author":"萨都剌","text":"竹树忽闻乾鹊鸣，明朝归计候新晴。\n小楼无处有秋意，暗雨空山如海声。\n叶落窗虚开鹤步，峰回路合断人行。\n谁知昨夜玄洲客，剪烛题诗过二更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登德兴聚远楼上有宋庙书","author":"萨都剌","text":"眉山仙去风流尽，聚远楼空月色寒。\n波暖东风入尊俎，夜深北斗挂阑干。\n幽花野草先灵杳，铁画银钩御墨残。\n不见旧时双燕子，春风几度捲帘看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九华山石墨驿","author":"萨都剌","text":"马上行人思九华，飘飘高兴满天涯。\n排空峭石生玄笋，落日奇峰挂赤霞。\n仙掌九秋倾露屑，天河半夜碍星槎。\n云中五老应招手，呼我来游太乙家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至龙潭驿","author":"萨都剌","text":"野草山花知姓字，人生踪迹似浮萍。\n帆冲细雨空江白，鸟没长淮远树青。\n今夜故人离水驿，明朝别酒尽沙瓶。\n匆匆又入丹阳去，暮鼓晨鸡已候听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤凰台怀古","author":"萨都剌","text":"凤凰一去不复返，竹实桐花空满庭。\n暮雨楼台连野寺，秋风鼓角动边城。\n水边万井吴烟白，天外三山楚树青。\n不见骑鲸李公子，几回惆怅此中行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王本中灯夕观梅","author":"萨都剌","text":"翠禽偷梦出南园，绰约冰姿傍绿尊。\n冰镜玉钗浮翠影，风帘银烛照妆痕。\n粉香微润无人见，素质多寒藉酒温。\n不似海棠春睡去，西楼月落已黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢人惠木犀","author":"萨都剌","text":"霜高落叶如雨急，有客敲门送木犀。\n夜月不留藏兔影，秋风失却挂蟾枝。\n云中仙子金华坠，天上吴生玉斧移。\n寄语凤台老居士，旋磨香露写新诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉和邓善之学士赠陈尧夫教授之作","author":"萨都剌","text":"巴西夫子邓学士，文彩珊珊玉佩琚。\n天上已无金马诏，人间空有白鹅书。\n云窗春透松花湿，月殿秋高桂影疏。\n不见青山埋骨处，水晶宫里是幽居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过江东驿次王侍御韵","author":"萨都剌","text":"政事文章王侍御，朱帘捲雨送将归。\n江东春色分银篆，马上清风吹绣衣。\n泽国水香鱼藻动，砚池春暖墨花飞。\n至今吴楚经行处，夜夜奎光绕太微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日登石头城","author":"萨都剌","text":"九日吟鞭聚石头，翠微高处倚晴秋。\n西风不定雁初度，落木无边江自流。\n两眼欲穷天地观，一杯深护古今愁。\n乌台宾主黄华宴，未必龙山是胜游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄野堂","author":"萨都剌","text":"忆昔相逢春莫天，道傍杨柳尽飞绵。\n池鱼出水将三尺，竹笋成林又一年。\n高士已成招隐赋，行人未办买山钱。\n野堂灯火清秋夜，何日联床听雨眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄同年友","author":"萨都剌","text":"忆昔同登龙虎榜，思君一度一悽然。\n三年岁月红尘里，万里关河白雁前。\n天上故人淮水隔，江南老树楚云连。\n不堪回首知何处，闻说年来海变田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄茅山谢舜咨","author":"萨都剌","text":"升龙观里谢道士，一入茅山不肯回。\n白发笑人年百岁，青天容我日千杯。\n已知圣主求方士，未必先生下钓台。\n每向石头城下望，顺风应寄鹤书回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王幼达之北京","author":"萨都剌","text":"五色云烟百尺台，王郎独步近蓬莱。\n江湖水落鱼龙上，天地秋高鸿雁来。\n北苑芙蓉风惨淡，西宫杨柳月徘徊。\n此行正及扶桑日，应献尧庭万寿杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"升龙观夜烧香印上有吕洞宾老树精","author":"萨都剌","text":"兰风吹动吕仙影，老树槎牙吐暮秋。\n夜静药炉丹火现，月明神剑夜光浮。\n已知浩气无穷尽，不到心灰未肯休。\n铁笛一声吹雪散，碧云飞过岳阳楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送湖洲鼓元明道士入茅山","author":"萨都剌","text":"道人居住碧湘湾，清夜月明摇佩环。\n出门倒拄九节杖，辞家却入三茅山。\n开笼放鹤横江去，写檄收龙带雨还。\n便拟访君吹铁笛，青松白石往来间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送崔知印之江东","author":"萨都剌","text":"金陵市上多骢马，白下桥头喜识君。\n玉佩清摇乌府月，篆银红带赤城云。\n买舟又过江东去，离笛难禁柳外闻。\n独有无媒送行者，依然野鹤在鸡群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题先春卷上有萧滕王三学士赞","author":"萨都剌","text":"番阳山人春拥门，玉堂学士墨翻盆。\n屋前屋后雪千树，枝北枝南月半痕。\n寒夜老龙摇玉骨，霜天瘦鹤吊冰魂。\n未经调鼎休惆怅，会见留酸到子孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒夜即事次韵呈许荣达","author":"萨都剌","text":"呵笔题诗逸兴舒，翠帘寒重捲虾须。\n春分采石仙人酒，夜读茅山道士书。\n箭刻未移寒漏浅，江声渐少夜潮枯。\n闭门岁晚仍多事，归梦无端绕故庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤骨笛","author":"萨都剌","text":"九皋声断楚天秋，玉顶丹砂一夕休。\n杨柳肯忘枯朽恨，梅花吹尽古今愁。\n魂归辽海身如蜕，曲破江城月满楼。\n惆怅玉人三弄罢，杳无消息到扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天灯","author":"萨都剌","text":"高挂长绳百尺馀，直飞红燄上天衢。\n一包春髓蒸元气，九转灵丹炼太虚。\n綵凤抱成吞日卵，赤龙衔出照天珠。\n高高不受飞蛾扑，长使凡人仰面吁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过紫薇庵访冯道士 其一","author":"萨都剌","text":"道士爱幽居，年来一事无。\n盆池新过雨，石上种菖蒲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过紫薇庵访冯道士 其二","author":"萨都剌","text":"山中华盖洞，石气冷萧萧。\n不见眠云客，惟逢避雨樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过紫薇庵访冯道士 其三","author":"萨都剌","text":"研珠滴露清，自点太玄经。\n尽日无人到，小窗兰叶青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪霁过清溪题道士江野舟南馆 其一","author":"萨都剌","text":"孤舟横野水，门外雪晴初。\n白日莫放鹤，青溪閒钓鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪霁过清溪题道士江野舟南馆 其二","author":"萨都剌","text":"江南正月半，犹自有梅花。\n踏雪去何处，青溪道士家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]