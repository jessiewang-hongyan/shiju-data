[{"title":"题柏子庭枯木","author":"熊梦祥","text":"铁珊瑚树飞鬼蝶，王子敝舄不许蹑。\n乞与海神神不收，涌树雪晴光晔晔。\n何人泼墨澹复浓，使我一见成心猎。\n便令退从未画前，无孔笛中宫徵叶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王元章画梅花","author":"熊梦祥","text":"水影晴光为写神，当时已是失天真。\n一从残角吹新曲，几向寒溪觅故人。\n缟袂归来犹有月，佩环飞去更无尘。\n莫言醉魄空离落，信把和羹属大臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题管夫人竹","author":"熊梦祥","text":"夫人写竹何纵横，错刀离离光怪生。\n安得月明招白凤，玉阑西畔听秋声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题二色芙蓉便面","author":"熊梦祥","text":"曾障西风十二阑，亭亭醉醒碧波寒。\n月边青鸟无消息，流落人间作画看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李息斋竹","author":"熊梦祥","text":"蓟丘道人写潇洒，烟寒兔齿石苍苍。\n素娥剪翠云叶乱，三十六陂春水香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画山矾","author":"熊梦祥","text":"傍路依山到处生，只因樵牧惯相轻。\n若教尘俗如桃李，未必梅花肯作兄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王元章梅","author":"熊梦祥","text":"紫禁春醲雪未消，年年香冷只飘飖。\n许身入画酬清赏，不嫁东风过小桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"熊梦祥","text":"船头新月恰如眉，折得双头莲子归。\n荷花菱叶不同种，蝴蝶蜻蜓各自飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题蕺山题扇图","author":"熊梦祥","text":"蕺山老媪本无知，恰值将军乘兴时。\n竹扇一时光怪动，莫教低价与元规。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题燕士李叔成静怡精舍","author":"宋沂","text":"守道岂忘世，脉脉重端居。\n旷怀不可极，清风生太虚。\n寂寂独无营，欣欣常有馀。\n童子启窗户，昼读孔氏书。\n窅然在隘巷，时来长者车。\n问我何栖迟，东陵未丘墟。\n矧伊幽州士，胡为卧空庐。\n答云各有志，素丝尚匪污。\n相从赋《黄鸟》，驾言歌《白驹》。\n凤兮或来下，愧彼狂接舆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题澹斋","author":"宋沂","text":"泠泠山下泉，谡谡松上风。\n松风吹我心，置彼山泉中。\n清深聊洗耳，汪洋因荡胸。\n时时酌玄酒，孰与甘醴同。\n张侯坐斋阁，尺宅如虚空。\n泊然濯尘虑，明德庶弥崇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题听秋轩","author":"宋沂","text":"憀慄夫何如？\n幽斋致虚极。\n相看数竿竹，更觉万籁寂。\n颢景逾清旷，天宇弥寥泬。\n凉飔发金奏，繁露漙玉滴。\n高梧庭鹤唳，衰蕙候虫唧。\n愿言凝耳韵，端居以游息。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东海谣奉送宋大监降香海上天妃庙","author":"宋沂","text":"东海鲤鱼摇赤尾，舳舻尽发江南来。\n帆樯出没蛟鼍窟，灵雨神风劳帝子。\n紫衣使者麾金幢，麒麟煖玉隐天香。\n元君昼下翠旗湿，百灵冉冉天吴立。\n使君骑马历东吴，吴中父老争迎趋。\n自言春涛漂白骨，官家下诏复征役。\n今年陇亩粳稻空，县官索租到疲癃。\n丁男登山拾橡栗，妻孥含酸向人泣。\n使君北来候神人，应怜赤子百忧集。\n明年海若不扬波，君归宣室当如何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送逯都水赴海运万户","author":"宋沂","text":"都水使者日边来，黄金虎符照漕台。\n笑持英簜入沧海，不比徐福求蓬莱。\n将军昔骑青骢马，风采桓桓丹阙下。\n紫髯如戟半成霜，议论精神更潇洒。\n今年运米发东吴，三百万石皆明珠。\n扬旗列戟耀云汉，伐鼓鸣金转舳舻。\n将军尚文今尚武，何物鲸鲵敢予侮。\n搀抢荡灭凋瘵平，报政归来奏明主。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠别黄德广赴都","author":"宋沂","text":"江上相逢浑未久，忽对芳尊倾别酒。\n君向燕台万里□，我留吴会三春后。\n当年曾入承明庐，千官委佩侍金舆。\n此行剩拟《长杨赋》，何用频封光范书。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白鹤观次韵郑蒙泉呈朱仲文陈庶子","author":"宋沂","text":"谁写《黄庭》一两章，碧桃花发日初长。\n欲求大药黄金鼎，先解明珠白玉珰。\n漠漠春阴连海气，迟迟云影度天光。\n群公共爱幽栖好，芝草瑶花杂众芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答苏昌龄","author":"宋沂","text":"二十四桥春雨晴，高斋日日读书声。\n寄来满纸□□湿，想见吹箫弄月明。\n倾盖清尊相为醉，盍簪白发可怜生。\n东风三月淮阴郡，写寄绸缪故旧情。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送傅与砺佐使安南","author":"宋沂","text":"皇帝三年颁正朔，使君万里向交州。\n瑶池天阔龙光漏，铜柱云低蜃气收。\n陆贾独能持节往，终军因得弃繻留。\n幕中为惜悬河辩，毛遂归来坐上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉饯御史中丞汪公大司徒致仕归陇右","author":"宋沂","text":"仗引绛驺中执法，镜悬清鉴大司徒。\n当今天子尊元老，自昔诸侯祖二疏。\n腊尽挂冠辞北阙，春来供帐出东都。\n魏舒就第施行马，薛广传家保赐车。\n德教万民蒙帝赉，王封四世赞皇图。\n翰蕃方国歌周雅，带砺河山著汉书。\n燕塞骅骝知故道，陇云鹦鹉识前驱。\n平泉草木芳华里，终日垂绅拥玉鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄马易之 其一","author":"宋沂","text":"近日淮南见马卿，新诗句句掇琼英。\n画船不肯留三日，先载东风过四明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄马易之 其二","author":"宋沂","text":"自是风流爱鉴湖，木兰舟上倒金壶。\n鲈鱼莼菜恋乡国，马湩蒲萄忆帝都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上元日侍宴叠嶂楼","author":"卞思义","text":"上使开华宴，高楼倚碧霄。\n山如屏嶂列，风逐管弦飘。\n事简春偏永，歌长酒易消。\n月明人散后，骢马不胜骄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铁笛诗寄杨廉夫","author":"卞思义","text":"一段清冰百鍊钢，曾翻宫徵侍虚皇。\n裂开黄鹤矶头石，惊落青鸾镜里霜。\n仙子佩环新乐府，翰林风月旧文章。\n道人清节磨砻久，却笑桓伊独据床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杨廉夫新居韵","author":"卞思义","text":"楼居最喜傍西河，春水溶溶生绿波。\n近市小桥云影乱，隔帘疏雨竹声多。\n执经弟子登金马，换帖山人贽白鹅。\n欲向尊前吹铁笛，且听牙板翠儿歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠清隐杨鍊师","author":"卞思义","text":"野鹤昂藏自不群，往来瀛海绝嚣氛。\n碧瞳老去照秋水，石室晓来生白云。\n采药每于松下见，步虚时向月中闻。\n《太玄》亲授神仙秘，霜茧淋漓旧墨纹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大瀛海道院为吕啬斋作","author":"卞思义","text":"人间咫尺大瀛海，方丈蓬莱信杳然。\n若木三更先吐日，弱流万里不通船。\n未同徐福来求药，好访安期且问仙。\n闻说吕公高隐处，蛟龙常护石床眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"巢云为吴义卿作","author":"卞思义","text":"元气氤氲天四垂，我来高处足栖迟。\n笑看乌鹊空三匝，肯与鹪鹩共一枝。\n露湿衣裳星斗近，暖生毛骨梦魂知。\n有时借得天风便，唤取仙人白鹤骑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"侍宴叠嶂楼次苏资道韵","author":"卞思义","text":"使君閒暇宴高台，佩玉珊珊得重陪。\n无数好山成叠嶂，一湾流水似天台。\n烟中佛寺藏楼阁，火后人家半草莱。\n不用登临增感慨，春风梁燕又归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西津渡","author":"卞思义","text":"西津渡口望瓜洲，候吏欢迎使客舟。\n天堑已无南北限，江流不尽古今愁。\n云连巨舰来湖口，风送残潮过石头。\n驿舍题诗满东壁，重来还忆去年秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过邳州风雨不能渡宿州治","author":"卞思义","text":"天下黄河势欲奔，江南游子黯销魂。\n阴风怒作波涛险，秋雨忽来天地昏。\n下榻可堪尘满席，开怀赖有酒盈尊。\n晓晴又上征鞍去，城下新添涨潦痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"毗陵玄妙观","author":"卞思义","text":"古柏青衫锁翠霏，寥阳金阙隐玄扉。\n幡幢影动群仙下，星斗坛空独鹤归。\n高阁云深分树色，修廊雨过湿苔衣。\n壁间若问双龙迹，化作天池宝剑飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汗酒","author":"卞思义","text":"水火谁传既济方，满铛香汗滴琼浆。\n开尊错认蔷薇露，溜齿微沾菡萏香。\n水泄尾闾知节候，津生华盖识温凉。\n千钟鲁酒空劳劝，一酌端能作醉乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马善长设宴思远楼湖船","author":"卞思义","text":"绿野桥边系短篷，归来微雨湿青骢。\n草堂无梦寻康乐，莲社何人忆远公。\n海上相逢疑昨日，尊前谈笑自春风。\n明朝旧约知谁问，隔岸海棠花正红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过琴溪徐公钓台","author":"卞思义","text":"芳草茸茸衬马蹄，重陪使者过琴溪。\n东风又属梨花月，夜雨新添燕子泥。\n石室尘空苍藓合，钓台人去暮云低。\n破奚莫厌诗囊重，多少江山未品题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王安行韵","author":"卞思义","text":"杖策来寻隐者居，闭门重著绝交书。\n入城无事不骑马，临水有时看钓鱼。\n未羡渊明开菊径，拟从诸葛住茅庐。\n清时羽翼知多少，肯散黄金学二疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杨廉夫韵赠歌者翡翠屏","author":"卞思义","text":"扬州曾赏琼花宴，吴下新传翡翠屏。\n湘水月明环佩冷，巫山云湿髻鬟青。\n蹙金孔雀非为贵，隔屋琵琶正好听。\n青鸟无情易飞去，雕笼深锁重丁宁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题舒秀实锄隐","author":"卞思义","text":"宾幕归来野兴浓，卜居还得近城东。\n绕篱自斸荆榛地，傍屋添栽杞菊丛。\n一钁燕泥春雨后，数声牛笛暮烟中。\n红尘轩冕非吾事，老圃如今愿己同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悯忠阁","author":"卞思义","text":"登临独上最高层，东北阑干不敢凭。\n云近蓬莱连复道，天低星斗挂觚棱。\n悯忠曾葬征辽骨，破暗空存供佛灯。\n欲浣京尘振衣袂，冷风萧瑟洒炎蒸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题溪山烟雨图","author":"卞思义","text":"西崦人家枕碧流，屋头高树近山头。\n短蓑烟雨归来晚，满地落花人倚楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过维扬","author":"卞思义","text":"露冷金盘酒价添，云埋琼树客愁兼。\n竹西旧曲无人理，谩捲红楼一半帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春江逸响图","author":"卞思义","text":"黄鹤矶头一棹还，白鸥波上几人閒。\n笛声吹断江南曲，不见渔翁祇见山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀杨铁笛","author":"卞思义","text":"琵琶声断翠鸾孤，铁笛山人泪眼枯。\n闻道小弦今已绝，《竹枝》依旧唱西湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"卞思义","text":"小苏吹笛最高楼，吹作大堤杨柳秋。\n只今青冢在湖上，不识黄云出塞愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王季野侍父入京","author":"屠性","text":"江左风流属过翁，赋成入奏大明宫。\n未应膝上留文度，还向谈边见阿戎。\n《金缕》东风歌折柳，锦帆迟日带归鸿。\n六龙清暑滦河上，扈从应驰白玉骢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"馆娃宫","author":"屠性","text":"栖越归来此筑宫，佳人欲与死生同。\n鸱夷始见投江上，乌喙俄闻赐甬东。\n木落秋波环佩冷，草生故国绮罗空。\n几回香水溪头望，飞雉犹翻夕照红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山阁","author":"屠性","text":"幽居只在碧山阿，高阁凌虚带女萝。\n门外水生春渚白，窗前云起夕阴多。\n藏书每许邻人借，酿酒时邀野老过。\n见说南冈千岁柏，倚阑安得眄柔柯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和潘子弃韵","author":"屠性","text":"云林精舍傍岩阿，中有行吟十二窝。\n陆羽泉清童汲惯，潘郎诗好客酬多。\n茅山猿鹤惊春晓，楚水鱼龙落夜波。\n归去不成千里别，抱琴重约听樵歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵季文","author":"屠性","text":"湖州此去百馀里，公子之官是胜游。\n细雨澹藏城外寺，垂杨齐拂水边楼。\n妙年未厌官曹剧，大府仍闻礼数优。\n日日高堂具甘旨，白鱼须寄霅溪头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送智教授兼简郭思道录事","author":"屠性","text":"先生去作州博士，尚忆沧浪水竹居。\n研露自临修禊帖，闭门欲著绝交书。\n九江城外春帆近，五老峰前晓雁疏。\n此去谈经有馀暇，参军为我问何如？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金粟影","author":"屠性","text":"桂树丛生双涧侧，玄堂羽盖拥团团。\n流膏久矣成芝菌，结荫终当集凤鸾。\n雨露春深增怵惕，溪山秋晚耐高寒。\n淮南不用歌《招隐》，留与云仍百世看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹桃","author":"屠性","text":"仙子吹笙处，碧桃花正开。\n花边有竹实，留待凤归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹菊","author":"屠性","text":"曾向山中住，黄花烂漫栽。\n主人缘爱竹，三径不教开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹棠梨","author":"屠性","text":"石畔竹扶疏，棠梨结子初。\n坐来山雨过，湿翠欲沾裾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹梅","author":"屠性","text":"美人湘浦去，翠袖倚琅玕。\n横笛吹霜晓，遥知不耐寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人赴彭湖巡检","author":"屠性","text":"三十六岛绕彭湖，见说泉南天下无。\n花时小队旌旗出，处处春风啼鹧鸪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题马二首 其一","author":"屠性","text":"渥洼神水与天通，汗血淋漓带赤騣。\n明日甘泉祠泰畤，和銮声在五云中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题马二首 其二","author":"屠性","text":"晓来疏雨过沙堤，振迅先闻柳外嘶。\n不是圉人调未习，临流怕湿锦障泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"屠性","text":"二八女儿双髻丫，黄金条脱银条纱。\n清歌一曲放船去，买得新妆茉莉花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题割股老女卷","author":"陈方","text":"蜂虿螫我手，阿誉须动色。\n如何割股女，引刀不爱惜。\n见父不见肉，视股如视石。\n眼前秦越人，区区较肥瘠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天平山","author":"陈方","text":"东吴水为州，西山兹独秀。\n上有百岁松，下有千尺溜。\n况当泉石间，野花乱如绣。\n顿足忘仆劳，长歌发余陋。\n沈沈范公祠，肃肃香火旧。\n碑犹巩洛时，寺当风雨后。\n乌乎一代尊，庙食今谁守。\n寂寞壮士怀，松风动清昼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵岩山","author":"陈方","text":"客吴十五载，始上灵岩山。\n入门地如削，凭轩绝跻攀。\n孰云念乡国，不复忧险艰。\n回首楚与越，茫茫一气间。\n向来朝会时，自谓吞百蛮。\n焉知王气衰，空忝禅栖閒。\n山川自潇洒，木石饶斓斑。\n俯仰万里外，浩歌风雨还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"羊肠岭","author":"陈方","text":"迢迢羊肠北，山深日当午。\n道傍多奇石，百态不受侮。\n高或如飞龙，低或如踞虎。\n岌嶪积铁间，参差意无迕。\n仆夫如怪我，疾行齐过弩。\n匆匆莫辞劳，悄悄愧不羽。\n野果缀微殷，春泉流乱乳。\n焉知下山时，凄迷更何许？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"涵虚阁","author":"陈方","text":"高标何崔嵬，结搆苍崖上。\n群山如儿孙，罗列皆北向。\n势入五湖小，气敌万夫壮。\n想当全胜时，自足恃保障。\n登之尚心怀，却倚独惆怅。\n远近互出没，风霭相摩荡。\n草木乱如云，乾坤悄孤望。\n矫手不成翔，无从挽尘鞅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宣和所制赤驹图","author":"陈方","text":"房星委地生神□，众马不得相俦匹。\n千里风轻白玉蹄，平渊春浴丹砂质。\n自从长养入天闲，振鬣常陪乘舆出。\n未知赴敌见戈矛，所惯承恩闻警跸。\n嘶当落日近尊严，气抹长林动萧瑟。\n不惭刍豆饱微躯，尚觊朝家三品秩。\n宣和殿里图书□，亲见圉人事爬栉。\n当时青海九万馀，未有一匹当宸笔。\n临轩睥睨迥出群，落纸须臾?奔逸。\n内侍传宣赐近臣，再拜奎光欲腾室。\n秋深沙苑多蒺藜，夜半河南吹觱栗。\n已诏民间置牧地，如此龙媒敢轻失。\n青城道上尘眯人，六宫粉黛无精神。\n此时此马□□□，□□□□□不能。\n追随天子向南去，哀哉委骨俱蒙尘。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]