[{"title":"黄荃蜀江秋净图","author":"吴镇","text":"暮烟漠漠一江秋，疏树依稀见远舟。\n风度钟声来古寺，人随雁影过前洲。\n云销碧落天无际，波撼苍山地欲浮。\n应识个中清绝处，成都画史笔端收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕仙峰春色","author":"吴镇","text":"层轩缭绕绿云堆，坐挹空青落凤台。\n一石负鳌三岛去，九峰骑鹤众仙来。\n越南翡翠无时见，洞口蔷薇几度开。\n春去春来花木好，溪头时听棹歌回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李咸熙秋岚凝翠","author":"吴镇","text":"雨过秋光映翠微，岩云一抹澹荆扉。\n千山寂寂疏钟杳，万壑萧萧落木稀。\n涧水奔飞行路湿，松篁回合墅禽归。\n征帆点点沧江上，应羡山人种蕨薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"范宽江山秋霁","author":"吴镇","text":"沧江遥带碧云流，紫翠凝峦万叠秋。\n阁倚蛟宫飞雨湿，人依鸟道动离愁。\n帆归极浦苍山合，木落千林暮霭浮。\n岂是笔端分造化，无穷岩壑一缣收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王晋卿画","author":"吴镇","text":"晋卿绘事诚无匹，尺素能参造化功。\n碧树依微春水阔，苍山缥缈暮云笼。\n幽深自觉尘氛远，閒澹从教色相空。\n更喜涪翁遗墨好，草堂何必独称工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马和之卷","author":"吴镇","text":"青峰互合若为群，中有高人卧白云。\n飒飒松风从涧出，萧萧竹色过桥分。\n閒来欲觅知音伴，睡起还探颂酒人。\n一段清幽离尘俗，不禁长笛起前濆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子久万里长江图","author":"吴镇","text":"一峰胸次多傀儡，兴寄江山尺素间。\n南北横分疑作限，西东倒注未曾还。\n山围故国人非旧，水绕重城树自閒。\n尤羡个中时序换，昔年禹玉岂容攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"叔明松壑秋云图","author":"吴镇","text":"万壑潆回磴道长，崇冈交互转苍苍。\n疏松过雨虚阑净，古木回风曲岸凉。\n村舍几家门半启，渔梁何处水流香。\n扁舟凝望云千顷，不觉西林下夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题云西画卷","author":"吴镇","text":"云西老人清且奇，随意点笔自合诗。\n高尚不趋车辙迹，新图不让虎头痴。\n溪中有人空伫立，江上征帆归去迟。\n何处溪歌声欸乃，碧云疏树晚离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶画二首 其一","author":"吴镇","text":"城市山林孰是非，幽居能与世尘违。\n函关紫气青牛到，辽海秋风白鹤归。\n天鼓叩残明月堕，洞箫吹彻彩云飞。\n谁知寂寞江天外，长使人间望少微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶画二首 其二","author":"吴镇","text":"数载飘蓬事已非，荆关咫尺世情违。\n寒云时向青山抹，野艇遥从白社归。\n几处夕阳人共语，一村流水鹭边飞。\n知君紫府归来后，閒把丹青玩翠微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方壶松岩萧寺","author":"吴镇","text":"方壶终日痼烟霞，写得湖山事事嘉。\n湖上烟笼梵王宅，山深云覆羽人家。\n诗翁伫立搜新句，稚子閒来扫落花。\n几处归帆何处客，一声啼鸟夕阳斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹十二首 其二","author":"吴镇","text":"亭亭月下阴，挺挺霜中节。\n寂寂空山深，不改四时叶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹十二首 其四","author":"吴镇","text":"竹窗思阒寂，铜博香委曲。\n胸中无用书，写作湘之绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹十二首 其五","author":"吴镇","text":"径深茅屋陋，树倚夕阳斜。\n行遍青山路，何丘不可家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹十二首 其七","author":"吴镇","text":"忽见不是画，近听疑有声。\n落落不对俗，涓涓长自清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王叔明林泉清话图","author":"吴镇","text":"落日秋山外，霜林暮霭中。\n相看无俗处，生事有谁同？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"董源山阁谈禅图","author":"吴镇","text":"山阁深沈树影凉，瀑流飞沫溅匡床。\n多君相对坐终日，话到无生味更长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李公麟大阿罗汉图","author":"吴镇","text":"潇洒龙眠不可呼，彩毫犹喜未模糊。\n天台五百知何处？\n还向图中證有无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"文同风篁萧瑟图","author":"吴镇","text":"翠羽参差自一丛，湘江清影澹微风。\n开图忽睹题痕处，羡杀当年笑笑翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆浩秋山问奇图","author":"吴镇","text":"霜落林端万壑幽，白云红叶入溪流。\n朝来尚有寻真至，共向山亭领素秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏东坡竹","author":"吴镇","text":"晴梢初放叶可数，新粉才消露未乾。\n太似美人无俗韵，清风徐洒碧琅玕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"右丞秋林晚岫","author":"吴镇","text":"右丞已往六百载，翰藻神工若个同。\n千嶂远横秋色里，山家遥带暮烟中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李昭道秋山无尽图","author":"吴镇","text":"奇峰倒映青冥立，绝壑高悬白雾开。\n万里无云见秋末，千林有雨向春回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢鸿嵩山草堂图","author":"吴镇","text":"卢鸿仙去五百载，一段高风未可攀。\n忽睹草堂清绝处，分明几案有嵩山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马远放鹤图","author":"吴镇","text":"载鹤轻舟湖上归，重重楼阁锁烟霏。\n仙家正在幽深处，竹里鸡声半掩扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子久为徐元度卷","author":"吴镇","text":"木落空山秋气高，一声疏磬出林皋。\n归帆点点知何处？\n满目苍烟尚未消。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王叔明卷","author":"吴镇","text":"短缣几许容丘壑，郁郁乔林更著山。\n应识王郎胸次好，未教消得此身閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次云林韵题耕云东轩读易图三首 其一","author":"吴镇","text":"山堂昨夜起秋风，景物萧条便不同。\n岂是天公嫌冷淡，故将林木染黄红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次云林韵题耕云东轩读易图三首 其二","author":"吴镇","text":"高人相对东轩下，竟日曾无朝市言。\n几卷图书几竿竹，天香冉冉泛芳尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次云林韵题耕云东轩读易图三首 其三","author":"吴镇","text":"云林点笔染秋山，往道荆关今又还。\n别去相思无可记，开缄时见墨纤纤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵仲穆东山图","author":"吴镇","text":"东山为乐奈苍生，望重须知亦累情。\n蜡屐春来行更好，桃花洞口笑相迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举海棠鸂鶒","author":"吴镇","text":"东风三月花如锦，两两文禽戏暖沙。\n堪叹深闺年少妇，岂无颜色在天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题墨梅二首 其二","author":"吴镇","text":"玉府仙姝倚澹妆，素衣一夕染玄霜。\n相逢不讶姿容别，为住王家墨沼傍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴道子秋山放鹤图次赵松雪韵","author":"吴镇","text":"秋云如练锁千山，楼阁重重水自湲。\n镇日溪桥无俗侣，杖藜扶鹤是高閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕万松仙馆图","author":"吴镇","text":"参差琳馆碧山齐，云拥疏松望欲迷。\n野老忘机自来去，忽惊麋鹿各东西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李营丘真迹","author":"吴镇","text":"万仞苍山百尺楼，西风吹送满林秋。\n疏钟遥落空亭里，尽属营丘笔底收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里秋景","author":"吴镇","text":"秋光萧瑟满林霜，篱菊英英桂子黄。\n最是西堂风月好，不妨游衍乐清狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵伯驹画","author":"吴镇","text":"璚馆芙蓉罨画山，天香缥缈碧云间。\n鹤巢松顶藤花落，一任山人指顾閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵伯骕画","author":"吴镇","text":"风色凄其上碧山，一朝林木变红颜。\n幽人为惜深秋色，忘却驱驰古道间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周文矩十美图","author":"吴镇","text":"有女联翩巧样妆，能将歌舞动君王。\n谁言金屋风光好，雨滴苍筠漏更长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂秋景","author":"吴镇","text":"远山斜日紫烟霏，一棹鸱夷竟不归。\n萧瑟秋风虚阁表，诗翁吟罢欲添衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂仿顾恺之","author":"吴镇","text":"隔水山高青隐日，傍溪古树绿藏云。\n閒翁自有閒游伴，更爱溪鸥閒作群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂仿张僧繇","author":"吴镇","text":"雨过秋塘泛曲湍，归人欲渡俯平川。\n前村遥望炊烟起，更有新篘破晓寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂仿陆探微","author":"吴镇","text":"客子行吟径路幽，一声啄木绿阴稠。\n芙蓉倒映空江色，危立溪头几点鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子久春山仙隐","author":"吴镇","text":"山家处处面芙蓉，一曲溪歌锦浪中。\n隔岸游人何处去，数声鸡犬夕阳红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪云林画","author":"吴镇","text":"隐君重价如结绿，萝屋萧然依古木。\n篮舆不到五侯家，只在山椒与泉曲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其一","author":"吴镇","text":"草堂仍著薜萝遮，地僻林深有几家。\n莫道春风吹不到，门前依旧鸟衔花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其二","author":"吴镇","text":"杜红兰若满汀边，烟际平林似辋川。\n安得宽閒如此地，看山坐老夕阳船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其三","author":"吴镇","text":"岩壑春深万绿齐，隔林黄鸟尽情啼。\n山翁不记灯前语，为约红楼试品题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其四","author":"吴镇","text":"灌木苍藤护草堂，流泉汩汩绕渔梁。\n书声遥送斜阳里，谁道空山白昼长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其五","author":"吴镇","text":"清霜摇落满林秋，漠漠寒云天际流。\n山径无人拥黄叶，野塘有客漾轻舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其六","author":"吴镇","text":"万木凋残众岭寒，诛茅栖息易为安。\n朝来犹有寻幽者，不畏崎岖磴百盘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其七","author":"吴镇","text":"千仞颠厓势欲倾，飞流溅眼雪花明。\n长风卷入层云去，都作天台暮雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画十首 其八","author":"吴镇","text":"雨歇重林烟树湿，风来虚阁晚窗凉。\n幽人倚遍阑干久，始识山中兴味长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶画","author":"吴镇","text":"罨画岧峣倚碧空，青娥高髻出瑶宫。\n微风忽动前溪影，华表盘云舞镜中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画竹七首 其七","author":"吴镇","text":"有竹之地人不俗，而况轩窗对竹开。\n谁谓墨奴能倒景？\n一枝独上纸屏来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王叔明为陈惟允天香书屋图","author":"黄公望","text":"华堂敞山麓，高栋傍岩起。\n悠然坐清朝，南山落窗几。\n以兹谢尘嚣，心逸忘事理。\n古桂日浮香，长松时向媚。\n弹琴送飞鸿，拄笏来爽气。\n宁知采菊时，已解哦松意。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王摩诘春溪捕鱼图","author":"黄公望","text":"春江水绿春雨初，好山对面青芙蕖。\n渔舟两两渡江去，白头老渔争捕鱼。\n操篙提网相两两，慎勿江心轻举网。\n风雷昨夜过禹门，桃花浪暖鱼龙长。\n我识扁舟垂钓人，旧家江南红叶村。\n卖鱼买酒醉明月，贪夫徇利徒纷纭。\n世上閒愁生不识，江草江花俱有适。\n归来一笛杏花风，乱云飞散长天碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李咸熙秋岚凝翠图","author":"黄公望","text":"山林之乐幽且閒，何人卜居云半间。\n江亭夐立苍树杪，招提高出碧溪湾。\n循溪隐隐穿细路，断岸疏疏起烟雾。\n微茫万顷白鸥天，雁阵凫群落无数。\n樵歌初断渔唱幽，桥边野老策扶留。\n春山万叠西日下，渺渺一片江南秋。\n我昔荆溪问清隐，溪上分明如此景。\n别来时或狂梦思，忽见此图心为醒。\n李侯少年擅丹青，晚岁笔意含英灵。\n兴来漫写秋山景，妙入毫末穷杳冥。\n无声诗与有声画，侯能兼之夺造化。\n临窗点笔试题之，老眼模糊忘高下。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪云林赠耕云东轩读易图","author":"黄公望","text":"君家书屋锁閒云，庭前丛桂吹清芬。\n东轩虚敞坐凉夜，扑帘香雾来纷纷。\n金吹不动露华洁，月里仙人降瑶节。\n奇葩点缀黄金枝，灵种移来白银阙。\n秋林潇洒秋气清，千竿修竹开前楹。\n自是燕山尚清贵，不与桃李争芳荣。\n花下诗成日未尽，更喜幽人往来近。\n清绝何如元镇图，应识耕云是高隐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"管夫人竹窝图","author":"黄公望","text":"歙之山兮郁巃嵷，突出欲坠劖青空。\n千枝万蔓行苍龙，嵚崟锐气欲敌昆崙峰。\n扶疏朴樕不足媲其灵秀兮，篬筤箘簬檀栾■矗竦竦生其中。\n翠蛟翔舞划烟雾，霜戟磔格敲天风。\n山空人寂孤坐而侧耳兮，珊珊环佩响璿宇，复疑金簧玉磬交奏蓬莱宫。\n飞仙遥闻驻鹤驭，威凤倾听来苍穹。\n虽云神领而意会，未若诛茅结屋筼筜谷内没齿宁吾躬。\n君家相距匪数舍，茧袍鸠杖高步时得追文同。\n居旁万竹固已具胸次，落落付诸绘素祇欲此意传无穷。\n元卿子猷长往不复返，此君千古誇奇逢。\n披之三复重太息，双眸炯炯开昏矇。\n会当盛暑棕鞋卉服造竹下，脱巾露发一洗烦热除惺忪。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶松岩萧寺图","author":"黄公望","text":"浩渺沧江数千里，几幅蒲帆挂秋水。\n晓风吹断绿萝烟，百叠青峰望中起。\n梵王宫阙倚云开，七级浮屠倒影来。\n山人久已谢朝市，日踞江头百尺台。\n松篁丛杂多啼鸟，隔岸人家丸弹小。\n此图此景入天机，谁能髣髴方壶老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顾恺之秋江晴嶂图","author":"黄公望","text":"三绝如君少，斯图更擅长。\n设施无斧凿，点染自微茫。\n山碧林光净，江清秋气凉。\n怜余瞻对久，疑入白云乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王晋卿万壑秋云图","author":"黄公望","text":"雨霁云仍碧，天高气且清。\n霜枫红欲尽，涧瀑落长鸣。\n岫岭苍茫景，江湖浩荡情。\n应知卧云者，奚尚避秦名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为袁清容长幅","author":"黄公望","text":"入山眺奇壑，幽致探何穷。\n一水青岑外，千岩绮照中。\n萧森凌杂树，灿烂映丹枫。\n有客茅茨里，居然隐者风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆洪谷楚山秋晚图","author":"黄公望","text":"天高气肃万峰青，荏苒云烟满户庭。\n径僻忽惊黄叶下，树荒犹听午鸡鸣。\n山翁有约谈真诀，野客无心任醉醒。\n最是一窗秋色好，当年洪谷旧知名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题关仝层峦秋霭图","author":"黄公望","text":"群峰矗矗暮云连，萝磴逶迤鸟道悬。\n落叶深深门半掩，疏花历历客犹眠。\n岩端飞瀑为青雨，江上归舟溯碧烟。\n应认个中奇绝处，昔年洪谷属君传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李成寒林图","author":"黄公望","text":"六法从来推顾陆，一生今始见营丘。\n腕中筋骨元来铁，世上江山尽入眸。\n林影有风摧落叶，涧声无雨咽清流。\n寒驴骚客吟成未，万壑寒云为尔留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕仙山楼观图","author":"黄公望","text":"汉主离宫最上头，昔年曾侍翠华游。\n青天半落银河水，白日高悬华岳秋。\n花隐仪銮临阁道，仗移箫凤下瀛洲。\n三山更在齐州外，遥望苍烟九点浮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]