69eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其八","author":"周巽","text":"绝巘路崎岖，跻攀坐来暂。\n树压翠岩幽，香通萝壁暗。\n客笑雀喧枝，樵归花插担。\n落日兴犹酣，停杯倚云瞰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其九","author":"周巽","text":"一树轻冰冻，满林疏蕊香。\n殷勤托花讯，惆怅惜年芳。\n远寺钟声寂，高楼角韵长。\n有怀不可见，寤寐意难忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其十","author":"周巽","text":"元猿吟庾岭，白雁过罗浮。\n倚竹凝朝望，看花带暮愁。\n丰神何洒落，贞节自清幽。\n酌酒芳林下，酣歌兴未休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其十一","author":"周巽","text":"行行过驿亭，历历游仙洞。\n白鹤羽毛翻，玉龙鳞甲动。\n花间壶再倾，石上琴三弄。\n回首隔风尘，思君入清梦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其十二","author":"周巽","text":"思君在何方，昨夜花初发。\n渺渺树间云，娟娟枝上月。\n素辉寒玉肌，清气冷冰骨。\n应笑桃李颜，繁华觉消歇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其十三","author":"周巽","text":"粲粲仙妃降，盈盈倚靓妆。\n香纫青玉佩，光冷素霓裳。\n疏蕊欺霜白，芳心蕤蜡黄。\n雨馀花湿处，疑是泣英皇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"以和靖处士疏影横斜水清浅暗香浮动月黄昏两句为韵赋诗十四首 其十四","author":"周巽","text":"自昔皇英去，谁招花底魂。\n数声云外角，一酹月中尊。\n雪皓山阴霁，云黄野色昏。\n忽传芳信至，初旭散东园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"溪梅","author":"周巽","text":"几树临寒碧，疏疏花满溪。\n皱波涵影瘦，攲岸压枝低。\n月上推篷见，云深去棹迷。\n颇怀过剡曲，乘兴绕芳堤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岭梅","author":"周巽","text":"岭头春意早，疏蕊腊前开。\n使节停云望，樵歌出洞来。\n穿花羸马过，抱树冷猿哀。\n传语罗浮客，新诗早寄回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅林","author":"周巽","text":"寻芳临晚渡，停棹入寒林。\n雪里孤村近，花间一径深。\n隔花人唤酒，倚树客听琴。\n烟寺昏钟动，归来香满襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅洞","author":"周巽","text":"岩谷云深处，冬暄花正开。\n香随微雪落，讯逐早春回。\n白鹿衔花去，元猿抱子来。\n仙人招我隐，倚树独徘徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅魂","author":"周巽","text":"缥缈烟尘外，思君不见君。\n神游枝上月，梦绕树间云。\n素顶三花聚，元精一气分。\n氤氲招不得，化作雪纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅讯","author":"周巽","text":"岁晏无消息，此时芳讯通。\n初传远信至，如见美人同。\n枝上喧林鹊，雪中来塞鸿。\n关山今夜梦，和月到房栊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野梅","author":"周巽","text":"郊外一枝雪，村边十月春。\n行吟逢处士，索笑向佳人。\n茅屋寒烟外，板桥流水滨。\n欲乘芳兴去，云树隔嶙峋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅树","author":"周巽","text":"南昌千载树，屹立出凡尘。\n人想邑中尉，仙留世外身。\n清癯孤鹤骨，夭矫半龙鳞。\n拟挂一壶酒，倚歌招子真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅根","author":"周巽","text":"孤根培厚地，春意在东原。\n蟠屈龙形古，发生阳气温。\n冰坚凝体魄，雪净返精魂。\n大本深含蓄，严冬花正繁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅龙","author":"周巽","text":"千年一老树，瘦骨似蟠龙。\n玉爪冰霜合，翠鳞苔藓封。\n罗浮云里见，夏禹庙中逢。\n乘取臞仙驾，飞光来九重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅蕊","author":"周巽","text":"轻冰融冻蕊，点缀见仙姝。\n色润蓝田玉，光浮合浦珠。\n枝头带蟾影，花底露蜂须。\n此日相看处，芳容何太癯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅英","author":"周巽","text":"霏霏含玉齿，粲粲出琼英。\n春色梢头见，阳和根底生。\n终身守贞白，芳气得轻清。\n隐若飞仙佩，飘翩来上京。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅萼","author":"周巽","text":"冻萼凝芳思，空山见美人。\n冰姿含翠靥，玉齿粲朱唇。\n结蒂栖香雪，缀枝迎早春。\n醉看开也未，微笑问花神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅香","author":"周巽","text":"琼树流清气，花飘晴雪香。\n暗凝翠云袖，微袭紫罗囊。\n旖旎来东阁，芬菲满洞房。\n酒酣三嗅醒，吟断月昏黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅仁","author":"周巽","text":"佳实存芳核，中含元气清。\n阳生春欲动，甲拆暖初萌。\n雪后孤根发，年深老干成。\n长留酸一点，金鼎待和羹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅影","author":"周巽","text":"江碧涵疏影，飘萧宛不群。\n斜横半窗月，低转一帘云。\n昼扫尘无迹，阴移篆有文。\n常随芳质见，隐映雪缤纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄陈进士村民 其一","author":"周巽","text":"不见镜中石，遥思枕上峰。\n景星光欲聚，夜雪兴偏浓。\n著述编新草，吟哦对古松。\n华嵩归隐处，云树几千重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄陈进士村民 其二","author":"周巽","text":"旧种庭前竹，旋看新笋生。\n春深翡翠合，日静凤凰鸣。\n常有凌云气，兼留避俗名。\n希君保贞操，托此寄中情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭雩都县尹沈宗臣父子死节","author":"周巽","text":"侃侃雩都令，情深入梦思。\n大儿同死节，慈母痛生离。\n犹想之官日，空怜骂贼时。\n欲持一杯酒，遥酹郁孤祠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祭石桥先妣墓诗","author":"周巽","text":"哀哀竟何恃，悲痛彻心肝。\n墓树春云暗，阶苔宿雨残。\n泪随流水注，食为禁烟寒。\n肠断思亲处，鹃啼乔木端。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"祭石屋先人墓诗","author":"周巽","text":"早岁自失怙，忧怀不尽言。\n养惭乌返哺，祭效獭衔恩。\n陟岵悲风起，瞻茔佳气存。\n永言思罔极，垂白哭秋原。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水溢芙蓉沼","author":"周巽","text":"雨过芳池满，芙蓉照绿波。\n双鸳香里浴，孤凤镜中过。\n独步承恩重，多情奈妒何。\n采花休采菂，心苦感怀多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"织锦窦家妻","author":"周巽","text":"璇玑初织锦，寄与窦将军。\n思报七襄日，裁成五色云。\n帛书断归信，绮字缀回文。\n洒尽行行泪，何时一见君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关山别浪子","author":"周巽","text":"关山路难越，荡子去何之。\n花落愁飘泊，月明伤别离。\n星河鹊飞夜，风雪雁来时。\n迢递年华晚，寒衣寄与谁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风月守空闺","author":"周巽","text":"惊风开绣幕，新月照罗帏。\n玉树鸣清籁，珠帘捲素辉。\n砧声敲杵急，灯烬落花微。\n今夜思君梦，应随黄鹄飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]