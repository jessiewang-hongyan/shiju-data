[{"title":"城西放歌 其四","author":"周霆震","text":"水寨城关总寂然，诸军号令夜分传。\n火筒清晓三声发，诸将齐驱勇向前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其五","author":"周霆震","text":"敛陆池边晓树旗，埋冤树下夕僵尸。\n皇天近日新开眼，说与四方残党知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其六","author":"周霆震","text":"惨澹秋阴覆血痕，参差苏石倚蟠根。\n古来此是埋冤树，今日还栖战死魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其七","author":"周霆震","text":"大洲男儿身姓熊，杷头削铁刃如风。\n直前竟斩红旗首，步战须还第一功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其八","author":"周霆震","text":"斩头累累悬马鞍，众中谁似林伯颜。\n贼阵横穿来复去，三军大捷唱歌还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其九","author":"周霆震","text":"先锋破阵古来难，好手齐推岳长官。\n除却林奇谁与对，交驰两马万人看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十","author":"周霆震","text":"记得壬辰血乱流，血流又到丙申秋。\n凶徒恶党还知不，莫要轻来打吉州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十一","author":"周霆震","text":"莫道孤城铁作关，云埋贼阵血朱殷。\n强梁多在莼村死，战马才馀八疋还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十二","author":"周霆震","text":"参政遣军快阁下，寇来相遇吉塘桥。\n横陈江上四十骑，居民墙屋免焚烧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十三","author":"周霆震","text":"安坐辕门运六韬，寇锋压境沸如涛。\n收功一战民安堵，始信将军定策高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十四","author":"周霆震","text":"太守当年宪使除，军须供给自纷如。\n白发苍头宁自暇，一宵暂向府中居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西放歌 其十五","author":"周霆震","text":"录事张公老且贫，一身阖郡事如云。\n仓卒开城容万众，从容行酒壮三军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其一","author":"周霆震","text":"半臂缠腰帽卷毡，剪裙荷叶腿齐编。\n市西桥外看屠狗，笑掷并刀赌酒钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其二","author":"周霆震","text":"堆帽红缨间黑缨，粉青宦裤短黄裙。\n酒楼突过行人避，近日新充水砦军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其三","author":"周霆震","text":"旌表门前路几弯，浮图坡下日衔山。\n马上长身单白纻，双双缓辔打毬还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其四","author":"周霆震","text":"短发风欺破帽斜，日西跣足踏红沙。\n妻孥待哺不遑恤，流汗担柴赴主家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其五","author":"周霆震","text":"叠石支床拥败毡，抱关击柝日随缘。\n松灯自抱芒鞋了，要办明朝买菜钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其六","author":"周霆震","text":"剑锋交处奋身跳，箭集征袍血未消。\n夺得红巾冲阵马，归途乾被长官要。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其七","author":"周霆震","text":"官船公子抱琵琶，笑指娼船白藕花。\n今夜江头好风月，买鱼载酒宿谁家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其八","author":"周霆震","text":"团扇题诗爱越罗，画船载酒沸笙歌。\n何人夜读《张巡传》？\n独占秋江月色多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"军中苦乐谣 其九","author":"周霆震","text":"十里长洲列战船，白头吟客坐看天。\n何时得见三阶正？\n独寄篷窗夜不眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初冬骤寒","author":"周霆震","text":"败璧萧萧夜不扉，昨来天气似炎威。\n卧听风雨中宵叹，何限征人未寄衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"周霆震","text":"街头昨日走如麻，逆贼凭陵势转加。\n晓起将军忙馆伴，省官遣子婿侯家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海全二参政","author":"周霆震","text":"弃舟穷走计全躯，力战凭城志扫除。\n身死不殊心死异，海全他日付谁书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都事谔卜都拉","author":"周霆震","text":"部伍相残不敢呵，美人雪洞夜酣歌。\n到头误国均遗臭，只为高昌不可和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纪实","author":"周霆震","text":"振文堂上刃纵横，水陆旌旗瞬息更。\n俯伏献城新太守，笑谈赴井旧诸生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿州歌 其一","author":"周霆震","text":"羽书兵马调西川，省署新兼上将权。\n不怕连营几百里，寇来只要宿州坚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿州歌","author":"周霆震","text":"万骑连云发蜀都，宿州一掷似摴蒲。\n幕僚摺得流星檄，牙帐朝酣睡未苏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿州歌 其三","author":"周霆震","text":"群盗河南稔祸端，此邦城守古来难。\n知州一纪心如水，那得金钱谒上官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿州歌 其四","author":"周霆震","text":"宿州知州无一钱，官差供给赴军前。\n军前未到宿州陷，从此红巾势灼天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿州歌 其五","author":"周霆震","text":"云槃长毂辇金缯，皓齿青蛾逐日新。\n一夜西风吹汉水，将军归去锦城春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成口号","author":"周霆震","text":"初度春生先我辰，馀生时日恰逢春。\n十年风雨江南路，犹有先朝白发人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳枝词 其一","author":"周霆震","text":"离宫别馆短长亭，忘却江南旧日春。\n是处人家种杨柳，往来系马解留人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳枝词 其二","author":"周霆震","text":"背立东风淡画眉，断肠烟雨一枝枝。\n隋宫汉苑春无主，莫向江南话别离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳枝词 其三","author":"周霆震","text":"移栽杨柳受风多，南畔行人北畔过。\n莫道浮萍是飞絮，好随流水到官河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨柳枝词 其四","author":"周霆震","text":"舞絮含愁入酒家，何因得近琐窗纱。\n春风万一无拘束，放去钱塘逐落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即景","author":"周霆震","text":"似晴却阴阴复晴，晓霜雾雪夜瞻星。\n天机咫尺开黄道，借与江南鬼火青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惜往日","author":"周霆震","text":"千金爱女贮兰房，百宝雕鞍拥骕骦。\n过眼青春谁是主，燕归无处说兴亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谷日薄雾食后晴","author":"周霆震","text":"梦笔生花到枕边，朝来晴稳荷苍天。\n春秋灾异书将遍，准拟今秋大有年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"去燕吟","author":"周霆震","text":"寄声多谢捲帘恩，花落春阴半掩门。\n只有当时堂上月，夜深犹照旧巢痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"篱间小花","author":"周霆震","text":"小小閒花分外红，野人篱落自春风。\n江南多少繁华地，尽在寒烟蔓草中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"田家","author":"周霆震","text":"木绵花谢豆荚肥，秋风催换白纻衣。\n东家女儿浣纱去，西家年少负薪归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鹰熊听涧图 其一","author":"周霆震","text":"奇绝鹰熊听涧图，眼明画意近年无。\n子房借箸旋销印，此是人间大丈夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鹰熊听涧图 其二","author":"周霆震","text":"鹰攫熊蹲听涧声，贵从巧画寓深情。\n李斯书上秦留客，安国谋行汉罢兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鹰熊听涧图 其三","author":"周霆震","text":"鹰熊听涧古来难，飞走藏名戏笔端。\n堪笑阴陵迷失道，当年枉怒沐猴冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鹰熊听涧图 其四","author":"周霆震","text":"听涧鹰熊岂是真，画师托意讽时人。\n白登围后知刘敬，辽水兵前忆魏徵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读天宝雷海清舞马事有感 其一","author":"周霆震","text":"剑阁迢迢隔两京，衣冠相送范阳城。\n伤心凝碧池头宴，千载无人传海清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读天宝雷海清舞马事有感 其二","author":"周霆震","text":"太液华清污禄儿，从官千骑竞西驰。\n君恩旧日深如海，赖有衔杯舞马知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"校书","author":"周霆震","text":"马粪儿童锦绣裾，专房倡女后妃舆。\n岂知短褐衡门下，一点寒灯夜校书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉冠","author":"周霆震","text":"酎金刀布罢长安，露冷铜仙屑玉盘。\n毕竟皇天深有意，赤眉难改汉衣冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中","author":"周霆震","text":"柳塘分路市桥斜，海燕双飞识故家。\n一月闭门听夜雨，隔墙落尽碧桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘氏二生从吾儿学赤日中分渠溉枯其意甚善遂成一绝示之","author":"周霆震","text":"渠成不使利专秦，救旱分流惠及贫。\n一饭秋来应忆汝，艰难相顾几何人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前诗子勤连和七章，或病首句秦字难押，援笔泛及故事，不觉其言之长 其一","author":"周霆震","text":"输粟常惭晋闭秦，艰难稼穑每怜贫。\n沟塍雁立交通处，汗血骈肩荷锸人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前诗子勤连和七章，或病首句秦字难押，援笔泛及故事，不觉其言之长 其二","author":"周霆震","text":"井田埋没自先秦，锥卓堪怜白屋贫。\n任氏漫多苍粟窖，王孙一饭更无人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前诗子勤连和七章，或病首句秦字难押，援笔泛及故事，不觉其言之长 其三","author":"周霆震","text":"雨似沱江不向秦，老天应念四郊贫。\n卧闻夜半呼龙起，一滴天瓢活几人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前诗子勤连和七章，或病首句秦字难押，援笔泛及故事，不觉其言之长 其四","author":"周霆震","text":"世上山中几晋秦，今年却忆去年贫。\n有时弹铗歌冯剑，谁是江东指廪人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20672,"sha256":"