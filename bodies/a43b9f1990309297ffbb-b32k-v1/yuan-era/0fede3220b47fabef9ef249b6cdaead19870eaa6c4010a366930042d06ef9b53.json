[{"title":"春意","author":"耶律铸","text":"千里万里游子去，一行两行归雁来。\n休倚高楼起惆怅，满城桃李为春开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晓 其一","author":"耶律铸","text":"晓来云捲四山晴，睡起池塘春水平。\n满眼东风吹柳絮，落花无语怨啼莺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晓 其二","author":"耶律铸","text":"琼枝委露凝香雪，澹月笼花浸麝尘。\n唤起丁宁休唤起，苧萝山下浣纱人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雷发声","author":"耶律铸","text":"连日阴云惨不开，依稀寒色满楼台。\n一台涌地蛰龙起，六合洗天霖雨来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食日见花开","author":"耶律铸","text":"寒食常年柳未黄，今年花满旧池塘。\n如何春色今年早，试对春风笑一场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白日","author":"耶律铸","text":"玉涧鸣泉弹洛浦，苍龙横沼写离骚。\n晴窗睡起炉烟冷，满院春风白日高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临春台","author":"耶律铸","text":"为临春色上歌台，独捲红罗坐绿苔。\n忽啭一声穿九陌，永新传送莫莺来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕 其一","author":"耶律铸","text":"一别相逢泪如雨，不禁憔悴语相思。\n佳期咫尺还知不，明日伤情两别离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕 其二","author":"耶律铸","text":"今日相逢明日离，逡巡离合几多时。\n无情云雨休遮隔，人道相逢一岁期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕 其三","author":"耶律铸","text":"雨洗秋容秋气清，翠帘高捲莫楼晴。\n似含羞色谁家女，旋索金针拜月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋不见月","author":"耶律铸","text":"夜阑人静漏迢迢，云景无情闭碧霄。\n不见嫦娥真面目，裴回虚度可怜宵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日宜都道中","author":"耶律铸","text":"采莲歌断木兰舟，万里长风入戍楼。\n灵凤不来青鸟去，陇头江月可怜秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"傩毕酌吟醉斋","author":"耶律铸","text":"毕方鬼蜮避时傩，便觉祈禠气象和。\n欢伯解言应也道，最难除得是诗魔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏雪","author":"耶律铸","text":"碧玉壶天白玉尘，十分添起月精神。\n从今休作轻盈态，学杀杨花不是春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故宫对雪三首 其一","author":"耶律铸","text":"琼室乱穿樵子径，瑶台空映野人家。\n天公也是灰心地，更忍教开玉树花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故宫对雪三首 其二","author":"耶律铸","text":"更怜琼室伤殷鉴，可是瑶台属夏家。\n元自飞花将蒂叶，已抟羊角到中华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故宫对雪三首 其三","author":"耶律铸","text":"飘飘举似霓裳舞，烂漫横陈玉树花。\n宁知点点飞来意，生自幽人两鬓华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"园中对雪","author":"耶律铸","text":"惊风不展瑶花限，浩荡年光落又开。\n却是仙娥相见处，烂银宫阙玉楼台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月台雪霁","author":"耶律铸","text":"水晶帘下玉尘埃，旋逐风姨去又来。\n应审素娥殊有待，已悬飞镜上瑶台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中戏示汉臣","author":"耶律铸","text":"散花台上千山雪，晴雪楼前万树花。\n触处造门湛腊酒，更休得问是谁家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪后吟","author":"耶律铸","text":"雪助夜寒更漏涩，何能盼得到天明。\n乾坤己落羲和手，休更琼瑶陌上行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姮娥","author":"耶律铸","text":"月姊应劳驾望舒，可能圆缺为阳乌。\n如何窃尽长生药，却种相思树一株。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六夜月得人字 其一","author":"耶律铸","text":"姮娥减却旧精神，桂魄难同昨夜新。\n多谢清光不相负，裴回终夕伴诗人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六夜月得人字 其二","author":"耶律铸","text":"底事姮娥出海迟，玉容寂寞不胜悲。\n清光未必天边减，冷暖人情亦可知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六夜月得人字 其三","author":"耶律铸","text":"昨夜衔杯写我欢，玻璃万顷桂花寒。\n素娥今夕如羞涩，似怨诗人取次看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对月吟","author":"耶律铸","text":"谁遣姮娥到画筵，裴回清景不胜怜。\n广寒宫殿应萧索，想见人归难自眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"炭山窖子店大风后有回风数月不已","author":"耶律铸","text":"西风崛?过柴扉，回裂云衣缠酒旗。\n懒举扇来时自蔽，祇知尘污庾元规。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和林雨大雹有如鸡卵者","author":"耶律铸","text":"谁拥珠玑积玉京，纵期明月易愁晴。\n若教不值骊龙睡，不信波斯擅得名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雷雹","author":"耶律铸","text":"唤起阿香云外具，低徊龙驭过神州。\n翠裀万顷无人捲，弄散珠玑去不收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园梅花","author":"耶律铸","text":"婆律膏融滴蜡开，几多香阵过楼台。\n风梅更是相料理，吹到南华枕上来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对后园梅花简示诸公","author":"耶律铸","text":"莫讶冷姿浑是雪，若存花态即非梅。\n灵根岂受寒拘束，直把阳和竟挽回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早梅","author":"耶律铸","text":"一径萦迂入草莱，柴门虽设不曾开。\n东风自泄春消息，吹到梅花树下来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饮梅花下","author":"耶律铸","text":"除了孤高梅子真，兰生更待与谁亲。\n无如清友延清客，有似贤人对圣人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花引","author":"耶律铸","text":"澹妆素服映冰肌，香袭幽情暗有期。\n满地美人心下事，怕拈横玉倚风吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春梅怨笛歌","author":"耶律铸","text":"一声愁笛吟龙起，万点惊香怨雪飞。\n珍重冰魂莫回首，酒痕犹满去年衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月二十二日梦中咏琼花","author":"耶律铸","text":"一树琼花手自栽，栽成盼得到春来。\n春来烂漫知多少，羞教群芳不敢开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题恋春牡丹","author":"耶律铸","text":"玉籍名延不世香，含情惟务振流芳。\n自缘始恋春料理，是索东君力主张。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹","author":"耶律铸","text":"问谁能养牡丹芽，南枕天津弟一家。\n不枉得输青帝力，见闻知是异凡花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唐家红紫二色牡丹","author":"耶律铸","text":"谁齐天香凝霞彩，灵根培养列仙家。\n汉皇可忍思倾国，鹿走中原是此花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题一花二名牡丹","author":"耶律铸","text":"政缘中业擅英声，是索宜专弟一名。\n抱一足为天下式，尽消神笔与题评。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双头牡丹 其一","author":"耶律铸","text":"并倚春风映画堂，相偎应说夜来长。\n同枝同叶缘何事，脉脉芳心各自香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双头牡丹 其二","author":"耶律铸","text":"玉盘双捧九天香，竞负恩华示宠光。\n忆得沈香亭北畔，太真临镜倚新妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"带将来","author":"耶律铸","text":"野花新傍玉栏开，长恨何人向此栽。\n自是王孙不知道，牡丹根上带将来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题与牡丹同名芍药","author":"耶律铸","text":"生倚英姿胜玉英，一生香占牡丹名。\n县知也是陈惊座，谁许分庭拟抗衡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长春芍药同坐客赋","author":"耶律铸","text":"标举孤芳蕴异香，定知经历几炎凉。\n自来不受春拘束，显是司花少主张。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题与牡丹同名芍药","author":"耶律铸","text":"英名窃比儗花王，倾慕花王事业香。\n奴隶万花题品处，不应花相敢承当。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题所藏芍药花辞","author":"耶律铸","text":"彫章开发自生春，藻思敷花逐日新。\n不独笔端元有舌，为花须可与传神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"取维扬红玉楼子于层阁芍药种迟而未至","author":"耶律铸","text":"红玉楼当在玉京，千层阁合在层城。\n延留应欲腾光价，待合琼花作伴行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"芍药","author":"耶律铸","text":"杨家一捻红娇润，与醉西施较等差。\n倘使红妆无籍在，宝冠须也是閒花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墙北桃树","author":"耶律铸","text":"一树缃桃几万枝，馀花落尽未开时。\n从今甘比墙南树，长得春风半日迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烧桃树根","author":"耶律铸","text":"碧桃林尽了无痕，溪色无光山色昏。\n依旧负薪人不断，采残枝叶更刨根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"路边桃花","author":"耶律铸","text":"不似刘郎初见时，尘埃憔悴损胭脂。\n多情阅尽行人面，醉倚春风果笑谁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月桃花词","author":"耶律铸","text":"春尽山桃花满枝，怨春休道北来迟。\n人人正醉春时节，政是江南肠断时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"日日亭午大风树杪忽见桃花一枝","author":"耶律铸","text":"赢得夭桃衒丽姿，渐教开上最高枝。\n司花未必能为地，便是颓风欲起时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日桃花同诸公赋","author":"耶律铸","text":"碧桃花拥长春洞，秀出元英独自芳。\n一点香心瞒客笑，探幽何意与刘郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答王澹游冬日二色桃花诗","author":"耶律铸","text":"冻得梅花开不得，笑他和雪倚阑干。\n漫山漫岭知多少，尚对东风怯莫寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落花","author":"耶律铸","text":"瘦绿痴肥怨景浓，一帘红雪压晴空。\n惊湍飞去无消息，吹折春心不是风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"圆福院竹甚茂盛幽都一郡所未有起上人云原有桃树百本余悉去之始植此君因为之赋","author":"耶律铸","text":"忍教仪凤箨龙孙，纵酒刘郎道与存。\n应说碧桃花解语，可无桃叶代桃根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"司春园五月五日梨花是日因事不果 其一","author":"耶律铸","text":"雨迷云梦梦迷春，只自将春认不真。\n莫笑独醒人索莫，也须曾是洗妆人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"司春园五月五日梨花是日因事不果 其二","author":"耶律铸","text":"已是春风酿雪香，月波斜浸玉肌凉。\n如何不入荆王梦，却逼何人要洗妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晨诣香山禅寺观两阁前后玉簪","author":"耶律铸","text":"玉簪花映清凉国，露泼冰姿日未升。\n只是旧时香世界，水沈香气自薰蒸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨妃菊 其一","author":"耶律铸","text":"追寻秋色到东篱，肠断三郎足别离。\n折得一枝香在手，临风何处寄相思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨妃菊 其二","author":"耶律铸","text":"醉浮愁颊半朝红，流恨空遗满六宫。\n睡杀海棠春不管，断魂招得嫁春风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨花","author":"耶律铸","text":"游人枉自怨年华，断送春风是此花。\n可是东君难管领，一天晴雪过谁家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏苔","author":"耶律铸","text":"露茵叠翠藉閒园，神篆斑斑世未传。\n推到东君翻古画，尽输春色买苔钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"紫菊","author":"耶律铸","text":"浓改新妆压旧妆，留连春色到秋光。\n渊明老后无归客，篱下而今不孙黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乞花","author":"耶律铸","text":"惜花人草乞花诗，欲得花枝慰所思。\n计取问花珠玉价，素知都是买花赀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊午冬十一月二十八日过阆州杨氏献小桃十二月二日又献杏花","author":"耶律铸","text":"谁意严凝运化机，小桃生弩绽芳蕤。\n东君枉了为春主，开到杏花犹未知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惜花御史","author":"耶律铸","text":"春事权舆未渠央，惜花御史似蜂忙。\n分明白著千红紫，陪奉宫花为括香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"锦连钱","author":"耶律铸","text":"锦连钱晕玉连钱，簪袅行吟软玉鞭。\n可爱金莲花世界，与人长结画图缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花马二首 其一","author":"耶律铸","text":"花满长春洞里开，万枝云锦映楼台。\n刘郎不道谁家物，尽与龙媒带取来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花马二首 其二","author":"耶律铸","text":"散花仙子神如水，閒散瑶花剪霞绮。\n春风吹满铁连钱，鞭碎玉鞭鞭不起。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"红叱拨","author":"耶律铸","text":"顾景骄嘶蹑紫烟，绿云随步步金莲。\n天然红玉飞香辇，宜载花閒醉玉仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晨鸡","author":"耶律铸","text":"延颈长鸣有所怀，司晨期振宿阴开。\n倾心解语扶桑日，直是声声叫出来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过琼林园闻莺","author":"耶律铸","text":"神州沈陆宫莺在，不忍频将旧事题。\n似与幽人说情绪，尽情啼了又重啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雏莺","author":"耶律铸","text":"一帘疏雨洗清明，啼杀东风陌上莺。\n寒勒百花开不得，问他春色与谁争。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新鹰","author":"耶律铸","text":"逼骆驼山驰快马，近鸳鸯泺案新鹰。\n性耽神俊多成癖，非为霜前被冻蝇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋莺","author":"耶律铸","text":"落尽群英一见愁，只因天地雨经秋。\n流莺不道春光老，刬地如今调舌柔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春歌","author":"耶律铸","text":"朔风战野地擘裂，震匣瑶琴弦冻折。\n春风不意到人间，昨夜柳梢先漏泄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白云谣","author":"耶律铸","text":"天花瑞叶将滕六，明与天公示心曲。\n一时三表表何事，表曰孤忠三献玉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]