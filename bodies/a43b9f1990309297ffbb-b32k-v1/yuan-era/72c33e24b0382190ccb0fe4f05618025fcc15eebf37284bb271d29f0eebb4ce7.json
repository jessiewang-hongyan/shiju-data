[{"title":"和景贤还书韵二首 其一","author":"耶律楚材","text":"居士今年又出关，琴书真味伴予闲。\n?成草略初无意，语阙治择误犯颜。\n漆水自惭贻口实，龙冈却得破诗悭。\n衰翁幸乞赎前过，一炷清香论八还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤还书韵二首 其二","author":"耶律楚材","text":"渊明幽隐掩柴关，琴已忘弦人亦闲。\n静倚书窗独寄傲，笑观庭树自怡颜。\n五音格外声何限，百草头边法不悭。\n蠹谱断弦无用处，因风得得寄书还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"外道李浩求归再用韵示景贤","author":"耶律楚材","text":"自从一箭透重关，触处忘缘触处闲。\n莫问羔裘横毳衲，从教华发映苍颜。\n水声说法起予甚，山色呈机不我悭。\n寄客天涯乐如许，问渠何必更南还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"外道李浩和景贤霏字韵予再和呈景贤","author":"耶律楚材","text":"尘缘划断已忘机，布鼓徒敲和者稀。\n中隐强陪人事过，禅心不与世情违。\n昔年勋业真堪笑，旧日家山懒欲归。\n我爱北天真境界，乾坤一色雪花霏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杨居敬韵二首 其一","author":"耶律楚材","text":"自愧才术草芥微，偶然千载遇明时。\n惟希一统皇家义，何暇重思晁氏危。\n仁义且图扶孔孟，纵横安肯效秦仪。\n行看尧舜泽天下，万国咸宁庶绩熙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杨居敬韵二首 其二","author":"耶律楚材","text":"诏下龙庭万国欢，野花啼鸟总欣然。\n熙朝龟卜符千亿，圣主龙飞第一年。\n至道变通皆有数，浮生富贵本由天。\n谁人得似杨公子，傲世高吟数百篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天宁寺用彦老韵二首 其一","author":"耶律楚材","text":"十年不得舞衣班，行尽天涯万里山。\n黄阁伴食空皓首，苍生未济漫胡颜。\n新朝兵革征方急，旧隐烟霞尚未还。\n衮衮簿书尘满眼，衰翁奚暇谒松关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天宁寺用彦老韵二首 其二","author":"耶律楚材","text":"今日从征亦偶然，天宁遐想思悬悬。\n贪荣不得还山去，须信衰翁未古贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天山周敬之席上和人韵二首 其一","author":"耶律楚材","text":"沦落天涯数十秋，区区班笔早年投。\n采薇山下慵拈草，洗耳溪边懒饮牛。\n振武扬威难射虎，忘机绝虑不惊鸥。\n当年射策承明殿，未必轻轻输吕筹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天山周敬之席上和人韵二首 其二","author":"耶律楚材","text":"憩马居延酒半醺，寂寥寒馆变春温。\n未能鹏翼腾溟海，不得鸿音过雁门。\n千里云烟青冢暗，一天风雪黑山昏。\n天涯幸遇知音士，子细论文共一樽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人韵","author":"耶律楚材","text":"四海皇皇无所归，梦魂常绕故园飞。\n海山不羡学居易，华表留言笑令威。\n毛落难寻苏子节，囊空犹有老莱衣。\n静思二十年间事，扰扰纷纷尽觉非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁亥过沙井和移剌子春韵二首 其一","author":"耶律楚材","text":"科登甲乙战文围，吾子才名予独知。\n巢许身心君易乐，萧曹勋业我难为。\n有恒得见实无憾，知己相逢未忍离。\n携手河梁重话旧，胡然羞和子卿诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁亥过沙井和移剌子春韵二首 其二","author":"耶律楚材","text":"行藏俯仰且随时，缊袍怀珠人未知。\n燕雀既群难立志，凤凰不至拟胡为。\n可嗟世态频更变，何奈人生多别离。\n莫忘天山风雪里，湛然驼背和君诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王屋道中","author":"耶律楚材","text":"胜克河中号令齐，神兵入自太行西。\n昏昏烟锁天坛暗，漠漠云埋王屋低。\n风软却教冰泛水，寒轻还使雪成泥。\n行吟想像覃怀景，多少梅花坼玉溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和解天秀韵","author":"耶律楚材","text":"猛士弯弓挽六钧，长驱入汴政施仁。\n前朝运谢山河古，圣世时亨雨露新。\n未遇自甘焚绿绮，知音不必惜阳春。\n朝廷将下搜贤诏，莫恋烟霞老此身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其一","author":"耶律楚材","text":"毡庐同抵足，谈道月西沈。\n议论馨香发，文章蕴藉深。\n正便边氏腹，不上谪仙襟。\n自得逍遥意，何须泊邓林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其二","author":"耶律楚材","text":"丰城三尺剑，神气尚埋沈。\n确论穿杨的，生机劈筈深。\n天真贮便腹，浩气塞征襟。\n伫看泽天下，清风冠士林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其三","author":"耶律楚材","text":"破船无渗漏，流水不能沈。\n雾锁青山秀，花藏古径深。\n白云陪野兴，晴月洗烦襟。\n绝后重苏息，飞花枯木林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其四","author":"耶律楚材","text":"隐隐三星出，依依片月沈。\n鹤飞辽海阔，猿啸楚山深。\n柳色云沾袖，芦花雪满襟。\n普天秋意露，一叶坠梧林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其五","author":"耶律楚材","text":"玄珠罗帐密，寒鼎篆烟沈。\n翡翠疏帘隔，琉璃古殿深。\n本来无垢体，何必拂尘襟。\n斫却蟾中桂，方成假若林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其六","author":"耶律楚材","text":"鳌饵不须针，聊将玉线沈。\n须弥犹未大，渤海岂为深。\n悟后牛穿鼻，迷时马有襟。\n弋人何所慕，幽鸟在嵩林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其七","author":"耶律楚材","text":"个事不容针，迷途自陆沈。\n西天三步远，东海一杯深。\n凉月盛玄钵，轻云剪素襟。\n曹溪无一滴，波浪沸禅林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其八","author":"耶律楚材","text":"流波无放荡，死水暮平沈。\n机尽方钩隐，纶空正钓深。\n赤心休惜口，青眼好开襟。\n误捉溪中月，人人似翰林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其九","author":"耶律楚材","text":"梦觉方知错，生平自屈沈。\n涤尘千㵎外，遗照乱松深。\n柳带缝穿屣，荷衣缀破襟。\n寂寥选佛味，何似宴琼林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用万松老人韵作十诗寄郑景贤 其十","author":"耶律楚材","text":"渔家何足好，乘兴一钩沈。\n路僻苍苔滑，舟横古渡深。\n小晴掀箬笠，微雨整蓑襟。\n梦断知何处，寒潮没晚林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万松老人真赞","author":"耶律楚材","text":"每恨恒山，不逢圭老。\n四众同缘，万松亲到。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠万松老人琴谱诗一首","author":"耶律楚材","text":"良夜沈沈人未眠，桐君横膝叩朱弦。\n千山皓月和烟静，一曲悲风对谱传。\n故纸且教遮具眼，声尘何碍污幽禅。\n元来底许真消息，不在弦边与指边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄曲阳戒坛会首大师","author":"耶律楚材","text":"四众飞书请万松，不消弹指已成功。\n灯笼證据真谈辨，露柱承当不耳聋。\n梵行细推无处所，戒坛须信塞虚空。\n无为济物谁能悉，惟有东垣月拂风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王巨川韵","author":"耶律楚材","text":"圣驾徂征率百工，貔貅亿万入关中。\n周秦气焰如云变，唐汉繁华扫地空。\n灞水尚存官柳绿，骊山惟有驿尘红。\n天兵一鼓长安克，千里威声震陕东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"释奠","author":"耶律楚材","text":"多士云奔奠上下，释迦遗像亦行城。\n旌幢错落休迷色，钟磬铿锵岂在声。\n宣父素心施有政，能仁深意契无生。\n儒流释子无相讽，礼乐因缘尽假名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和移剌子春见寄五首 其一","author":"耶律楚材","text":"四海皇皇足俊贤，浪陪扶日上青天。\n且图约法三章定，宁羡浮荣六印悬。\n润色吾术惟恐后，扶持天下敢为先。\n过情声闻予深耻，可笑虚名到处传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和移剌子春见寄五首 其二","author":"耶律楚材","text":"生遇干戈我不辰，十年甘分作俘臣。\n施仁发政非无据，论道经邦自有人。\n圣世规模能法古，污俗习染得维新。\n英雄已入吾皇彀，从此无人更问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和移剌子春见寄五首 其三","author":"耶律楚材","text":"且喜朝廷先正名，林泉隐逸总公卿。\n群雄一遇风云会，万国咸观日月明。\n丹凤固应潜乱世，白麟自今出升平。\n伫看北阙垂温诏，夜半前席进贾生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和移剌子春见寄五首 其四","author":"耶律楚材","text":"举世寥寥识我谁，未学弓矢愧由基。\n衰年有幸弹三乐，盛世无才出六奇。\n弃物且存光海量，散材获用荷天私。\n微臣自忖将何报，信笔裁成颂德诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和移剌子春见寄五首 其五","author":"耶律楚材","text":"邂逅沙城识子初，天山风雪醉吟馀。\n文章光焰君堪羡，节操仪刑我不如。\n曲蘖乡中前进士，风波堆里老中书。\n他年归去无相弃，同到闾山旧隐居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄移剌国宝","author":"耶律楚材","text":"昔年萍迹旅京华，曾到风流国宝家。\n居士为予常吃素，先生爱客必烹茶。\n明窗挥麈谈禅髓，净几焚香顶佛牙。\n回首五年如一梦，梦中不觉过流沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其一","author":"耶律楚材","text":"龙冈能觅淡中欢，心与孤云自在闲。\n琴阮生涯事松菊，诗书活计老丘山。\n叩弦声自无中出，得句思从天外还。\n踏破化工无尽藏，闲人受用亦非悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其二","author":"耶律楚材","text":"龙冈、漆水两交欢，纵意琴书做老闲。\n未得一言安海内，已输三箭定天山。\n肯容诗思妨心慧，岂使声尘碍耳还。\n信手拈来无不是，清风明月有何悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其三","author":"耶律楚材","text":"人间聚散妄悲欢，何似林泉遁世闲。\n十载残躯游瀚海，积年归梦绕闾山。\n空岩猿鹤招予往，满架琴书伴我还。\n多谢龙冈怜老隐，新诗酬酢路无悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其四","author":"耶律楚材","text":"弦索词章且助欢，羡渠临老得安闲。\n琴歌爱子弹秋水，佳句服君仰泰山。\n声古调凄真可听，辞雄韵险实难还。\n先难后易今方省，名士襟怀本不悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其五","author":"耶律楚材","text":"宦情触处不成欢，未得浮生半日闲。\n荐鹗有书惭北海，泽民无术愧东山。\n琴书习气终难忘，岩麓荒园怎得还。\n卜隐龙冈成老伴，肯教诗思笔头悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其六","author":"耶律楚材","text":"广文怜我失清欢，每著琴书伴我闲。\n痛忆金声并玉振，酷思流水与高山。\n诗坛吝啬犹深闭，琴债迁延未肯还。\n一状如今都领过，龙冈须破两重悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其七","author":"耶律楚材","text":"琴书吾子尽幽欢，随分消磨日月闲。\n佳句典刑传四海，水仙声韵彻三山。\n每惭木李投君去，却得琼瑶报我还。\n从此龙冈开廪藏，徽边笔下更无悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其八","author":"耶律楚材","text":"世间何事最为欢，争似能偷忙里闲。\n得遇夜晴须对月，每逢春盛强登山。\n无钱沽酒和衣典，图利吟诗倍本还。\n绮语千章琴百曲，莫教风月笑人悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其九","author":"耶律楚材","text":"我与先生久已欢，而今皆愿老来闲。\n同舟载棹醉观月，并辔骑驴饱看山。\n绮句缀成连谱换，纯音弹了着诗还。\n琴诗此际慵拈出，可怨龙冈为纸悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄景贤一十首 其十","author":"耶律楚材","text":"闲人闲里竟闲欢，未得回光未是闲。\n叩道一螺斟巨海，参玄千里望恒山。\n但能透镞穿三句，何必拖泥辨八还。\n个事人人皆富有，含生休怨释迦悭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤韵三首 其一","author":"耶律楚材","text":"龙冈便腹尽诗书，落笔云烟我不如。\n一纸安书思塞雁，十年归兴忆鲈鱼。\n托身医隐君谋妙，委迹儒冠我计疏。\n何日相将归故里，翠微深处卜幽居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤韵三首 其二","author":"耶律楚材","text":"龙冈走笔和清篇，出示珠玑寄湛然。\n字古意新看不足，挑灯寒雨夜无眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤韵三首 其三","author":"耶律楚材","text":"摩抚疮痍正似医，微君孰肯拯时危。\n万金良策悟明主，厚德深仁四海施。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李世荣韵","author":"耶律楚材","text":"异同谁足据，俯仰且随缘。\n居士难联句，梅轩却解禅。\n无云皆皓月，何处不青天。\n话到忘言处，迢迢夜不眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其一","author":"耶律楚材","text":"龙冈居士得贤君，闻道贤君增所闻。\n节操鹓雏捐鼠饵，风神野鹤立鸡群。\n只知辅嗣能谈易，谁识相如善属文。\n拟欲赞君言不尽，区区微意见诗云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其二","author":"耶律楚材","text":"天下奇才郑使君，清名不使世人闻。\n五车书笥独穷理，三峡词源迥出群。\n未得开怀重话旧，常思抵足共论文。\n自从一识龙冈老，馀子纷纷不足云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其三","author":"耶律楚材","text":"一圣龙飞敢择君，嗟予潦倒尚无闻。\n苍生未识鸿鹄志，皓首甘游麋鹿群。\n黄雀已归奚望报，彩禽飞去不能文。\n龙冈特慰孤穷闷，时有新诗报我云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其四","author":"耶律楚材","text":"试和新诗寄郑君，无言谈道不闻闻。\n治心更索捐中道，养性浑如鞭后群。\n玄语谆谆非是说，真书历历不关文。\n儒生刺教嫌虚诞，得意忘言孔子云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其五","author":"耶律楚材","text":"文章自愧不如君，敢以玄言渎所闻。\n有道居尘何异俗，无心入兽不惊群。\n重玄消息无多子，半纸功名值几文。\n回首死生犹是幻，自馀何足更云云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其六","author":"耶律楚材","text":"十年不遇一相知，恰识龙冈恨见迟。\n常爱箕山能洗耳，何堪邻舍效颦眉。\n荣枯贵贱难逃数，用舍行藏自有时。\n心事纷纷无处说，援毫闲和景贤诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其七 感事","author":"耶律楚材","text":"万里西来过月氏，初离故国思迟迟。\n人情惭愧三须面，人世梳妆半额眉。\n田上野夫空叹凤，泽边渔父不伤时。\n龙冈本具英雄眼，几倩东风寄我诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其八 读唐史有感","author":"耶律楚材","text":"林甫滔天圣不知，三郎深恨识卿迟。\n尘中妃子春罗袜，钱上开元指甲眉。\n七夕殿中祈巧夜，三秋原上摘瓜时。\n长天忽见飞来雁，垂泪空吟李峤诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其九","author":"耶律楚材","text":"李杨相继领台司，兵起渔阳祸已迟。\n向昔正怜花解语，而今空忆柳如眉。\n心伤桃李初开夜，肠断梧桐半落时。\n试问宫中谁第一，三郎犹记谪仙诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其十","author":"耶律楚材","text":"往来寒暑暗推移，下手修行犹太迟。\n迷后徒劳常捏目，悟来何必更扬眉。\n宗门淘汰宜穷理，道眼因缘贵识时。\n祗为龙冈心猛利，湛然刚写不言诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤十一首 其十一","author":"耶律楚材","text":"龙冈医隐本知机，薰莸同盘辨者稀。\n廊庙虚名无意恋，林泉夙愿与心违。\n羡君绰绰有馀裕，笑我皇皇无所归。\n尚忆当年垂钓处，一江烟雨静霏霏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王君玉韵","author":"耶律楚材","text":"王孙蒙馈饭，灵辄未扶轮。\n自笑孤穷客，谁怜衰病身。\n黄沙万馀里，白发一孀亲。\n肠断山城月，徘徊照远人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过东胜用先君文献公韵二首 其一","author":"耶律楚材","text":"荒城萧洒枕长河，古字碑文半灭磨。\n青冢路遥人去少，黑山寒重雁来多。\n正愁晓雪冰生砚，不忿西风叶坠柯。\n偶忆先君旧游处，潸然不奈此情何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过东胜用先君文献公韵二首 其二","author":"耶律楚材","text":"依然千里旧山河，事改时移随变磨。\n巢许家风乌可少，萧曹勋业未为多。\n可伤陵变须耕海，不待棋终已烂柯。\n翻手荣枯成底事，不如归去入无何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]