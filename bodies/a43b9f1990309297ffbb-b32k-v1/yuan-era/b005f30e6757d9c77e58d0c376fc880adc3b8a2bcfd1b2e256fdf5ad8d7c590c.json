[{"title":"云山小景","author":"成廷圭","text":"我家草堂南涧滨，门前不识车马尘。\n白云相随过山去，天地别有人间春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青山白云图","author":"成廷圭","text":"溪上长松已合围，草堂无事客来稀。\n湿云生满东山路，日暮野樵何处归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唐明皇吹箫图二首 其一","author":"成廷圭","text":"寝殿春深昼漏迟，榻前侍女立多时。\n玉箫自按霓裳曲，赐与梨园子弟吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唐明皇吹箫图二首 其二","author":"成廷圭","text":"花萼楼前柳色新，东风吹散马嵬尘。\n锦囊玉管俱零落，谁是终南梦里人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题蒲塘双燕图为刘小斋作","author":"成廷圭","text":"昭阳池馆晚风微，花落巢空去未归。\n却是蒲塘春水阔，年年还傍小斋飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月十二日出北郊","author":"成廷圭","text":"官河两岸土城低，旗帜青红望欲迷。\n万木千林谁伐尽，数家茅屋野乌啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌 其一","author":"成廷圭","text":"道士庄前秋事多，东家西家收晚禾。\n船头把酒对明月，听打夜场人唱歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝歌 其二","author":"成廷圭","text":"乔麦花开如白烟，并催农事了霜前。\n晚禾未割豆先熟，双髻女儿齐下田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题獐猿便面","author":"成廷圭","text":"树上孤猿树下獐，山林物性各相忘。\n不知万里中原阔，鹰犬交驰苜蓿场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访王伯纯晚归","author":"成廷圭","text":"长洲苑内旧池台，白发山人恰再来。\n无限客愁浑忘却，小楼听雨杏花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其一","author":"成廷圭","text":"邻瓮新篘曲米香，梦魂夜夜绕槽床。\n故人不饮今何在，秋尽空山苜蓿长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其二","author":"成廷圭","text":"江风吹尽暮天霞，我本淮人来寄家。\n吴门留滞不归去，开尽西轩白鹤花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其三","author":"成廷圭","text":"夜半金乌海上翔，行来夹日酷于霜。\n庭前几个芭蕉叶，未到秋分一半黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其四","author":"成廷圭","text":"铁锁沧江第几关，扬州花竹梦中看。\n也知无赖三分月，照见沙场白骨寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其五","author":"成廷圭","text":"月落未落明星高，宿云卷尽无秋毫。\n中庭隐几复假寐，候虫四壁声劳劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其六","author":"成廷圭","text":"湖面茨莼叶半舒，湖中新出四腮鱼。\n黄金换酒须当醉，莫信黄金可贮储。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其七","author":"成廷圭","text":"凤凰桥西淮子河，年年租吏夜催科。\n秪今田父无消息，豹虎满天将奈何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其八","author":"成廷圭","text":"氛祲冥冥晚未消，浙江三日不通潮。\n令人却忆冯公子，知在西湖第几桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其九","author":"成廷圭","text":"彭泽归来落落然，风流不写义熙年。\n东篱菊种无寻处，老树荒台锁暮烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和饶介之秋怀诗韵 其十","author":"成廷圭","text":"横江孤鹤翅如轮，一别山林五百春。\n肯借老夫骑过海，方壶圆峤少风尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其一","author":"成廷圭","text":"花烛银台沈水香，为郎先暖合欢床。\n小姑纳聘山堂上，缠酒红绡十丈长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其二","author":"成廷圭","text":"横江江水荡晴霞，秋尽夫君不到家。\n闺中小鬟也浪语，陌上听歌杨白花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其三","author":"成廷圭","text":"写就安书无便翔，寒衣著破过三霜。\n但记送郎初上马，窄袖短衫穿柳黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其四","author":"成廷圭","text":"西到长干过几关，附得书来侬自看。\n八疋四川十样锦，裁作郎衣遮早寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其五","author":"成廷圭","text":"竹枝歌比柳枝高，红纸乌丝紫兔毫。\n夫婿从军不识字，殷勤写去也徒劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其六","author":"成廷圭","text":"阿翁生儿如阿舒，少年不殊同队鱼。\n但见门前有人客，肯信箧中无积储。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其七","author":"成廷圭","text":"老翁买舟西市河，去应不求闻达科。\n阿婆牵衣翁且住，下第归来将奈何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其八","author":"成廷圭","text":"洞庭山岚犹未消，炮车云起怕风潮。\n劝郎把舵莫放手，水恶须防第四桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其九","author":"成廷圭","text":"江头野花红欲然，春去秋来不记年。\n寻得秦皇系缆石，青沙一色草如烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其十","author":"成廷圭","text":"鸳鸯湖西湖水凉，踏藕采莲来觅郎。\n郎意莫如菱刺短，妾情只似藕丝长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵 其十一","author":"成廷圭","text":"江南秋熟转饥寒，头上犹簪列士冠。\n鸡犬全家上天去，学仙悔不事刘安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题南竹","author":"成廷圭","text":"洞庭南去竹如云，老叶新梢乱不分。\n帝子不归风雨恶，深林何处觅湘君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宫人汲井","author":"成廷圭","text":"辘轳轻转汲清泠，玉碗盛来进内庭。\n别院有人愁似海，眼花落井怨银瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂赋五首 其一","author":"成廷圭","text":"民间升斗籴仓陈，五十青钱一束薪。\n黑潦满街风雨恶，日中犹有未炊人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂赋五首 其二","author":"成廷圭","text":"农父驱牛晓入城，可怜牛卖尽遭烹。\n明年湖上休兵后，一寸荒田不得耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂赋五首 其三","author":"成廷圭","text":"破钱羞涩客囊倾，菜把青青价稍平。\n却喜来朝知肉味，敢云何处有鱼羹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂赋五首 其四","author":"成廷圭","text":"高阳社里醉复醒，于今老友俱凋零。\n街头酒薄不堪饮，四百青钱沽一瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂赋五首 其五","author":"成廷圭","text":"十月一日河上行，军中少年知姓名。\n谁家一儿驾艇子，肯载老夫同入城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭马士明都事 其一","author":"成廷圭","text":"冥冥妖祲黑如云，湖上旌旗乱不分。\n父子四人同战死，边庭谁说马将军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭马士明都事 其二","author":"成廷圭","text":"干戈未定失英雄，野寨无人战舰空。\n三十六陂波浪恶，故人何处哭秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题徐仲原所藏王冕画红梅","author":"成廷圭","text":"罗浮仙子绛绡裳，也欲随时学艳妆。\n今日北人浑见惯，杏花同色不同香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旌表孝义金门","author":"郑元祐","text":"出吴东门，沄沄其水。\n傅陆以居，居民栉齿。\n不有孝义，众何所恃？\n孝义伊何？\n曰维金氏。\n百五十祀，业儒循轨。\n事亲养志，同气敬顺。\n兄掌家钥，弟秉文印。\n不矜而誉，不言而信。\n里举乡推，事腾于朝。\n用旌其门，以阐教条。\n张书扁式，与表迩远。\n守臣树声，加示庆典。\n坊名孝义，大厥里门。\n彰善瘅恶，周书具存。\n吴固沃土，才隳于膴。\n风颓俗靡，事鲜俪古。\n求若孝义，几何其心？\n堪继公艺，价重南金。\n克孝克义，我谣我歌。\n借耰阋墙，敦化猗那。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高昌契侯三节堂","author":"郑元祐","text":"惟天启契，产自辇水。\n润被北庭，侯济厥美。\n挺事昌朝，忠武罕比。\n戡金平宋，策审功侈。\n入毗庙堂，黔黎安只。\n蛮酋兽犷，侯辕南指。\n忠愤踊跃，奋莫顾己。\n忠诚贯天，白虹触起。\n孱孱孤嫠，哭侯孔哀。\n誓死靡他，夫人贞哉。\n贞哉夫人，夫死儿乳。\n教儿能孝，父志在汝。\n齿方成童，母病弗疗。\n刲肱和糜，人孰儿诏？\n彼美至性，移孝而忠。\n抚字列城，继侯英风。\n侯既有子，且复有孙。\n孙皆读书，益大侯门。\n相继掇科，荐承宠光。\n侯其来归，英爽乐康。\n子佩金符，孙萦紫绶。\n世讶其隆，侯植之厚。\n三节一贯，何有夷险？\n恊于王风，永配令典。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"可斋","author":"郑元祐","text":"大哉宣圣，以诗教我。\n兴观群怨，皆与曰可。\n诚笃是学，感发志意。\n善善恶恶，庶全美刺。\n诗人得失，于焉考见。\n妍媸在已，反省毋眩。\n和以处众，不至于流。\n设使雷同，其道亦缪。\n惩创羞恶，中惟一致。\n温柔敦厚，慎勿暴气。\n用以事亲，孝哉有子。\n移以为忠，曾不越此。\n鸟兽草木，名类匪一。\n惟笃学问，旁资多识。\n是我宣圣，以诗设教。\n下逮百王，是则是效。\n嘉子嗜学，尤勤于诗。\n以可名斋，义实在兹。\n六义具存，既殚源委。\n以咏以歌，性情斯理。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登鸿山吊梁伯鸾","author":"郑元祐","text":"我以饥驱，爰求乐土。\n居近山麓，山名孔膴。\n问之父老，曰伯鸾父。\n尝登兹山，览历平楚。\n因以名山，义匪誇诩。\n注意山栖，兹非其所。\n敬吊夫子，愿嗣德音。\n隼栖择高，鱼游择深。\n夫子当时，五噫讴吟。\n出都接浙，笑掷华簪。\n归隐杵臼，佣力是任。\n配谐德曜，雍雍鼓琴。\n上窥羲轩，下混古今。\n以乐此心，俪古傲今。\n而我肱折，不知息心。\n年登知命，尚浮尚沈。\n圣域缅邈，世途崎崟。\n矢从夫子，投迩深窅。\n既齐物我，兼忘昏晓。\n万里非旷，一隙非小。\n毋曰昭昭，示人皦皦。\n聊从兹逝，以谢胶扰。\n夫子不违，罔知适从。\n蝇附以骥，菟罥以松。\n有薪朝炊，有稻夜砻。\n式依夫子，娱老考终。\n优哉悠哉，歌以相舂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兰","author":"郑元祐","text":"恊以鼓琴，世谁知音？\n采苢纫佩，湘江水深。\n兰生棘中，如石轥玉。\n玉受不瑳，幽香满谷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为李绎成悼其妻冯氏","author":"郑元祐","text":"彼美者媛，令姿静淑。\n姆教在鞶，懿范端肃。\n择配皙士，闻望右族。\n读书思荣，焚膏继晷。\n媛来主馈，克承夫志。\n载缉载纫，裳衣补缀。\n奉飧举案，翼若始祭。\n倏遭百罹，綵凤分飞。\n鼓盆哭哀，语及涕洟。\n人孰无妇？\n妇贤而暌。\n永怀弗谖，爰形声诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晖楼","author":"郑元祐","text":"阳春有晖，泛在物表。\n寸草承之，弗间其小。\n春晖熙熙，彼草离离。\n区萌就质，芃芃茂斯。\n诗人载歌，悉物之情。\n子于父母，恩莫与京。\n亲恩之大，春阳之溥。\n子心如草，肤寸思补。\n爰搆重屋，以奉父母。\n以介眉寿，其乐吁吁。\n旨甘滫澻，奉亲之常。\n寸草之微，那报春阳？\n孝子爱日，孝子养志。\n敬亲之枝，勿蹈非礼。\n扬亲之誉，悠久不已。\n是谓可报，寸草春晖。\n万一攸在，吾祈与归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古五首 其一","author":"郑元祐","text":"北辰众星宗，列宿环共之。\n斗杓指其方，生始悉所资。\n万卉春芃芃，至秋悴如期。\n蠢动罔弗然，辟翕启闭随。\n静观造化理，在人岂其遗？\n君象实有类，万古成纲维。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古五首 其二","author":"郑元祐","text":"仲尼去云远，吾道日以微。\n达士忘贱贫，佞人纷是非。\n时态良弗古，乃致美事希。\n末路欲忘言，屏迹避危机。\n桐江有垂钓，首阳有采薇。\n清风盖一世，舍此其安归？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古五首 其三","author":"郑元祐","text":"大道本常在，为士者弗由。\n穷居叹时迈，逐世竟悠悠。\n豪强互吞劫，雄智复相尤。\n遂令务誇诈，攘窃何时休？\n所贵者仁义，势力焉足谋？\n懿教信辽矣，民风此其媮。\n默默掩幽室，感之纷泪流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古五首 其四","author":"郑元祐","text":"春来桃杏华，秋荣菊与杞。\n岂但物性殊？\n造化之所使。\n人生类如斯，通塞固其理。\n苟识吾性诚，隐显良有以。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古五首 其五","author":"郑元祐","text":"委身竹素间，义理费考寻。\n巀嶪泰华高，浩瀚沧溟深。\n涉之远无津，举之力难任。\n不如反诸己，求诸圣贤心。\n成汤警日新，大禹惜寸阴。\n纷拿试屏绝，请鼓无弦琴。\n因之忘肉味，太古寥寥音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其一","author":"郑元祐","text":"已踰乌盭山，未涉狐奴水。\n饥羸形骸黑，枕戈待明起。\n将军方蹋鞠，天地入马箠。\n吾侪亦何人？\n一死等蝼蚁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其二","author":"郑元祐","text":"秦时闾左戍，汉家弛刑徒。\n髑髅弃瀚海，天阴哭呜呜。\n我非望生还，魂魄迷归途。\n但愿戈矢利，委身斲狂胡。\n吁嗟载笔书，不纪万骨枯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其三","author":"郑元祐","text":"受诏武台宫，西遮钩营道。\n阸虎射命中，相从愿深讨。\n蹑血焚龙庭，以功当横草。\n平沙列部伍，鲜整旄与葆。\n奚虑蛇豕繁，一鼓欃枪扫。\n归取万户侯，岁月未云老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其四","author":"郑元祐","text":"糒吞天山雪，衣裂青海风。\n前行几千里，不见单于宫。\n走马脱辔头，所恃五石弓。\n乡井岂不怀？\n简书戒命洪。\n黄尘触垒起，勇奋奔貔熊。\n铅刀异莫邪，所觊一割功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其五","author":"郑元祐","text":"骑羊五岁儿，出没区脱中。\n翻身异鸟鼠，快捷如飞鸿。\n生理不土著，水草无丰凶。\n一战那足平，燕然方勒功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其六","author":"郑元祐","text":"烽烟边上发，塞雁群南翔。\n仰睇冥冥天，风雩雨雪霜。\n驱马上崖谷，悲笳咽云黄。\n弃绝骨肉亲，讵弗怀故乡？\n军声动剑戟，炮火烧衣裳。\n鞠育非寡恩，道远不得将。\n吞咽复何愤，思虏其名王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"出塞七首，效少陵 其七","author":"郑元祐","text":"边尘暮犹黑，鬼燐出霜草。\n转战图报国，宁虑骨枯槁？\n人生无百年，一毙不待老。\n但愿土境富，微躯奚足道？\n勋业铭旗常，秋天气同杳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄张仲敏","author":"郑元祐","text":"子居阖闾城，有屋蔽风雨。\n心融诗书泽，口断儿女语。\n客庖妇供馔，茗灶手自鬻。\n外屦多弗却，束脯乾可茹。\n如何舍之去？\n昼堕缘栋鼠。\n朱门盍华簪，青冥无凡羽。\n已随凤鸣冈，尚感雁遵渚。\n于以见贞操，屯贞贵能处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春六日，辱陈敬初诸君枉顾，小饮敝楼，分得静字","author":"郑元祐","text":"葱肆不嗅荤，荜门惟习静。\n何此枉飞佩？\n诸君森相映。\n方惭乏词锋，安知堕语阱？\n酒杯浅于脐，楼居小如磬。\n敢云谐谑欢，遂忘跪跽敬。\n飞花落砚席，轻云拂麈柄。\n舍坐或屡舞，分题各成咏。\n莫非江海士，行应丘园聘。\n顾我拓飞蓬，更春不复盛。\n假如湛诚痴，何嫌宪非病？\n相会苟不乐，明朝雪盈镜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠谭台史","author":"郑元祐","text":"高昌佳公子，气横海岳秋。\n玉壶洗零露，锦机濯芳洲。\n真致埃壒外，独与神明游。\n岧峣凤凰台，日晏行云愁。\n帝念南纪大，建台分顾忧。\n列圣耳目寄，职斯布皇猷。\n谁工古人学？\n可参宪臣谋。\n之子被辟命，束书上升州。\n煌煌三台星，列宿莫敢俦。\n而子妙折旋，婉娈通衿喉。\n不居世禄懿，远慕儒术优。\n先正高与马，德言皆可雠。\n骨朽名不泯，耿光悬斗牛。\n子能勖令闻，席珍重天球。\n况复五彩笔，尽意工冥搜。\n飞花落棋局，弱柳维江舟。\n感此时物佳，念子何能休？\n龙驹少汗血，驽马老益羞。\n白云高莫和，青山晓加稠。\n日没烟树远，重倚城南楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仙山楼观图","author":"郑元祐","text":"嵯峨三神山，仙圣之所居。\n芝草布庭阙，霞光曳衣裾。\n渴饮碧玉浆，饥餐紫琳腴。\n霓旌冉冉下，彤楼拥鸾舆。\n青童启藏室，帝命校宝书。\n齐心始能读，字字皆玄枢。\n朗咏以相授，灵风舞神鱼。\n天远靡得闻，何以能启予？\n空嗟珊瑚日，照耀金芙蕖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]