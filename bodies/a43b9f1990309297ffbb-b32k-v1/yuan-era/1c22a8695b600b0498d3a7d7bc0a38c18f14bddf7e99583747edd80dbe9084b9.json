[{"title":"反垂柳短吟","author":"刘因","text":"偃蹇高松雪漫飞，最怜憔悴绿杨枝。\n青丝曾识莺声软，黄叶俄惊马足迟。\n有分只偷春色早，无心要结岁寒知。\n不应再得东风力，更与行人管别离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄彦通","author":"刘因","text":"青刍白饭思悠然，灯火山亭暮雨前。\n不意相思浑百里，直教一别动经年。\n久甘分席樵夫下，敢望过门长者先。\n自是烟霞爱招客，可无佳句助清妍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"付阿山诵","author":"刘因","text":"十亩荒田不自耕，半空楼观几时成？\n人因遇困方言命，我为求奇反丧名。\n此去要知灯是火，向来空指雁为羹。\n新诗铭在山童口，百过高歌告乃兄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人官浙西","author":"刘因","text":"江海十年几战酣，劫灰飞尽到耕蚕。\n乱翻文物想犹在，彫弊徵科恐未堪。\n眼底兴亡即今古，胸中形胜欠东南。\n因君渐有扁舟兴，伫待清风洗瘴岚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蔷薇","author":"刘因","text":"色染女真黄，露凝天水碧。\n花开日月长，朝暮阅两国。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"刘因","text":"溪童出门望，鸥鹭满空下。\n江水淡无情，尽是忘机者。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"溪桥步月图","author":"刘因","text":"山中有幽人，独步溪桥月。\n莫问兴如何？\n披图亦清绝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春露亭书","author":"刘因","text":"老树含春容，寒泉动幽响。\n念彼山中人，风露恣清赏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书事三首 其一","author":"刘因","text":"当年一线魏瓠穿，直到横流破国年。\n草满金陵谁种下，天津桥畔听啼鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书事三首 其三","author":"刘因","text":"唱彻芙蓉花正开，新声又听采茶哀。\n秋风叶落踏歌起，已觉江南席卷来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史谩题","author":"刘因","text":"眼底权奸汉室空，伯喈文举亦才雄。\n王畿庙号关何事？\n亦在区区论建中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙尚书家山水卷","author":"刘因","text":"扁舟老树傍苍崖，好似今秋雪岭回。\n试问黄尘山下渡，几人曾为看山来？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭氏家山图","author":"刘因","text":"鹿门烟影接隆中，翁媪通家社酒红。\n只有山童最神骏，旧曾床下拜庞公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"睡起","author":"刘因","text":"晚醉城南不记回，虚檐高枕藉莓苔。\n酒醒凉意潇潇在，应是前山送雨来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"刘因","text":"云白天青浩不收，雨晴山色欲无秋。\n淡烟衰草关何事，落日红波空自愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山寺早起","author":"刘因","text":"松窗一夜远潮生，断送幽人睡失明。\n梦觉不知春已去，半帘红雨落无声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万寿宫馆舍","author":"刘因","text":"来时残雪点征衣，落尽庭花尚未归。\n梦里不知身尚病，春衫归路马如飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨晋州二首 其一","author":"刘因","text":"曾是吾乡旧幕官，秋风碧水记红莲。\n而今却忆当时事，回首惊看二十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨晋州二首 其二","author":"刘因","text":"南州选举数三杨，中统衣冠半在亡。\n明日朝廷访耆旧，不应白首尚为郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭翁诗","author":"刘因","text":"佳木交清阴，欣然动人意。\n况闻翁之风，能不有生气。\n此翁少有兄，干戈乡县异。\n哀鸣念羁孤，相思劳梦寐。\n自誓毕此生，复尔欢聚遂。\n千里三往还，竟扶篮舆至。\n夜雨一方床，春风满天地。\n家无十岁僮，百役一身寄。\n效儿浣厕牏，代妇理中馈。\n生忘茕独忧，死免道路弃。\n关河隔故丘，走送徇归志。\n大义今已全，初心始无愧。\n翁本不识书，所知惟艺事。\n作诗美翁贤，亦以警士类。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游北溪分韵得晖字","author":"刘因","text":"苍黄淡野色，草树含清晖。\n林居隐葱茜，晴岚散霏微。\n归云有真意，鸣禽发天机。\n胜处必深会，轻觞岂虚挥。\n山泉来何从，北望空依依。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"呈保定诸公","author":"刘因","text":"燕垂赵际间，人物荧圭璋。\n诸侯旧宾客，一郡宗贤良。\n士穷叫知己，人渴思义浆。\n诸公且勿嗔，贱子伸馀狂。\n骃幼有大志，早游翰墨场。\n八龄书草字，观者如堵墙。\n九龄与太玄，十二能文章。\n遨游坟索圃，期登颜孔堂。\n远攀鲍谢驾，径入曹刘乡。\n诗探苏李髓，赋薰班马香。\n衙官宾屈宋，伯仲齿卢王。\n斯文元李徒，我当拜其旁。\n呼我刘昌谷，许我参翱翔。\n眼高四海士，儿子空奔忙。\n俗物付脱略，壮节持坚刚。\n前年脱颖士，峨峨势方飏。\n欲求伸汩没，今反堕渺茫。\n少小婴忧患，痛切摧肝肠。\n零丁叹孤苦，片影吊仓皇。\n溺身朱墨窟，人事如冰霜。\n高才日陵替，壮志时悲伤。\n驽骀欺赤骥，鸱枭笑凤凰。\n妾妇妒逸才，浪觜谗舌长。\n纷然生谤议，锋岂不可当。\n不忍六尺躯，缩项俄深藏。\n诸公富高义，刮垢摩我光。\n去留从所适，爽气生西廊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同仲实南湖赏莲醉中走笔","author":"刘因","text":"湓江泔寒风露凉，安得置我濂溪堂。\n香尘缥缈芙蓉裳，百年得此南湖张。\n举杯人胜境亦胜，有莲以来无此香。\n莲香随酒来诗肠，得句惊起幽禽翔。\n幽禽随人作殢态，意欲和我风雩狂。\n人间一味清到骨，两足暂付吾沧浪。\n螟蛉蜾蠃卿且去，醉眼太华云间苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"记梦","author":"刘因","text":"天风吹云送星槎，苍鳞道前牵紫霞。\n凤凰呈舞月妃和，飘飘来自金母家。\n金母临行有奇赠，玉箫璚管声清佳。\n嘱我醒时无泄露，恐世知子生諠哗。\n明朝梦觉莫惊怪，异香冉冉浮窗纱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发高黑口号","author":"刘因","text":"苍月瘦，黑风酸，枯梢老窍号空山。\n东方未动天发黑，迷途客子回征鞍。\n冰髯压唇帽檐侧，耳轮霜醉鼻尖寒。\n中原年少燕南道，功名未了黄尘老。\n黄尘老，马上神州依旧好。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞帝庙","author":"刘因","text":"四顾莽何际，威灵俨若临。\n山川尚醇朴，天地自高深。\n凤鸟千年叹，箫韶三月音。\n玄功久无复，徒抱致君心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登保府市阁","author":"刘因","text":"十载鸡泉隐，今朝市阁晴。\n民谣混诸国，里号带军营。\n瀛海依依见，尧山隐隐横。\n怀今与思古，独立若为情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒夜","author":"刘因","text":"肝胆了无寐，襟怀谁与同。\n更长头可白，烛暗火逾红。\n砚滴冰生瘿，星流气吐虹。\n林鸦先我起，鸣噪竟何功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送成从事","author":"刘因","text":"易水河梁梦，回头已十春。\n相逢惊我老，送别向君频。\n求赠攀前例，将诗认故人。\n故山松菊在，归去未全贫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭张之杰","author":"刘因","text":"义许同生死，夺君何遽然。\n无人共清夜，有泪葬黄泉。\n苦疾求予祷，遗孤托我怜。\n伤心墓头字，旌孝看他年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独立","author":"刘因","text":"恒岳精英大，直冲昴毕星。\n初疑元气白，横界太虚青。\n欲与河汉共，不随霜露零。\n相看一杯酒，连夜立中庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渡白沟","author":"刘因","text":"蓟门霜落水天愁，匹马冲寒渡白沟。\n燕赵山河分上镇，辽金风物异中州。\n黄云古戍孤城晚，落日西风一雁秋。\n四海知名半彫落，天涯孤剑独谁投？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遂城道中","author":"刘因","text":"铁城秋色接西垣，远客还乡易断魂。\n霸业可怜燕太子，战楼谁吊汉公孙。\n冷烟衰草千家冢，流水斜阳一点村。\n慰眼西风犹有物，太行依旧压中原。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"避暑玉溪山","author":"刘因","text":"风露撩人尽力清，也应知我到禅扃。\n秋声满谷有生气，山意带烟成远形。\n皎月欲升天失色，白云初出树留青。\n他年若访经行处，合有先生避暑亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留题山房","author":"刘因","text":"灵风缥缈竹花飞，怪石参差树影齐。\n壶里有天藏日月，杯中无海饮虹蜺。\n松生太古鹤应识，路入白云山尽低。\n万里黄尘一回首，微茫烟水意悽迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春游","author":"刘因","text":"巧稳林亭无四邻，背山向水得天真。\n风光正及二三月，童子同来六七人。\n十日得閒须小醉，一年最好是深春。\n鸟声似向花枝说，曾见无怀有此民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐有怀寄故人","author":"刘因","text":"几叶疏桐万斛秋，四山清露一窗幽。\n高情千古谢安石，壮志平生马少游。\n有错真成六州铁，欲还空说大刀头。\n悠悠且付天公在，未必苍生待尔忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋孙仲诚席上四杯螺","author":"刘因","text":"陇鸟回头意若何，刳肠欲我鉴红螺。\n微茫山意诗痕在，滟滪江声饮兴多。\n圣处已分糟与蟹，醉来唯见酒成波。\n千年醒杀江鱼腹，应恨生身在汨罗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荷","author":"刘因","text":"碧筒和露卷晴霞，锦浪随鲸落晚沙。\n风趁歌声来弄叶，酒知人意要浮花。\n胸中壁立三峰玉，醉里神游太一家。\n明日清霜看红翠，人生容易鬓成华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃","author":"刘因","text":"希夷尊俎永相望，混沌凿开见此觞。\n金橘有天容逸老，青田无地避馀香。\n云中招隐留仙掌，物外寻真得醉乡。\n试向峨眉问啼鸟，人间红雨几斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"橙","author":"刘因","text":"潇湘千树暮林平，风露诗肠快一倾。\n蜜恋金丝仍可意，香分绿蚁最关情。\n洞庭春色元无恙，南国幽姿谩浊清。\n惟办酒船千万斛，棹歌和月卷江声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席以韵课诸生东斋诸物 其一 远山笔架","author":"刘因","text":"何物能支笔万钧，案头依约远山痕。\n灯横烟影隐犹见，秋入霜毫势欲吞。\n掌上三峰看太华，人间一发是中原。\n中书未免从高阁，不向林泉怨少恩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席以韵课诸生东斋诸物 其二 梅杖","author":"刘因","text":"铁石心肠冰玉姿，掌中潜得岁寒枝。\n天教一握藏春密，风觅馀香就手吹。\n雪月冷怀随步履，溪山高兴入支颐。\n玉堂若要扶持用，说与东君也不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席以韵课诸生东斋诸物 其三 醉梨","author":"刘因","text":"白雪春香洗未残，玄霜谁遣冻成团。\n涞封圆颗盘增滑，蜜和浓浆齿避寒。\n绿蚁从今忘病渴，金花无地著馀酸。\n快人风味依然在，莫作寻常软熟看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即席以韵课诸生东斋诸物 其四 玉簪","author":"刘因","text":"花中冰雪避秋阳，月底阴阴锁暗香。\n玉瘦每忧和露滴，心清惟恨有丝长。\n且留宛转围沈水，莫遣联翩入粉囊。\n只许幽人太相似，苍苔疏雨北窗凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"盆池","author":"刘因","text":"青蛙昨夜圣来鸣，斗水那容掉尾鲸。\n白发惊鱼应百我，扁舟捉月记三生。\n荷风拂面秋先觉，苔露生波晚更清。\n我欲江东鉴湖老，天河早为洗南兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黑马酒","author":"刘因","text":"仙酪谁誇有太玄，汉家挏马亦空传。\n香来乳面人如醉，力尽皮囊味始全。\n千尺银驼开晓宴，一杯璚露洒秋天。\n山中唤起陶弘景，轰饮高歌敕勒川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答河閒赵君玉见寄","author":"刘因","text":"出门纷扰互相寻，常使幽人懒病深。\n前月借书来水北，去年采药到城阴。\n黄精已倩徐生斸，苍朮新教石老寻。\n只有烟霞肯赊借，无人曾送买山金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆郝伯常","author":"刘因","text":"一檄期分两国忧，长缨不到越王头。\n玉虹醉吸金陵月，玄鹤孤游赤壁秋。\n漠北苏卿重回首，天南王粲几登楼。\n飞书寄与平南将，早放楼船下益州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早起","author":"刘因","text":"饥鼠号多似诉愁，破囊空惯已无羞。\n閒来点检幽居事，鶗鴂声中又一秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿洪崖观","author":"刘因","text":"云山不受壮心降，无限西风撼客窗。\n应是夜深知月出，却收风雨入清江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪岭遇雨","author":"刘因","text":"天为西游饷我晴，野花啼鸟效平生。\n今朝雪岭初逢雨，应是郎山带帽迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故园寒食","author":"刘因","text":"一抔新土寄馀哀，故老相邀信步来。\n行到水西村尽处，桃花无数未全开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻角","author":"刘因","text":"人间无物比悠扬，谁道一声随夜长。\n馀哀到晓无寻处，吹作南湖十里霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"霜落","author":"刘因","text":"霜落清江一夜秋，觉来明月满江楼。\n酒醒人散夜将半，花上鸟啼空自愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题李渤联德高蹈图四首 其一","author":"刘因","text":"扊扅炊罢补麻衣，习取禁寒抗老饥。\n幸自伯鸾无识者，对人不必案齐眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题李渤联德高蹈图四首 其二","author":"刘因","text":"求人谀鬼果何为，翻忆谋亲入仕时。\n寄谢韩公莫相挽，山妻元不解啼饥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题李渤联德高蹈图四首 其三","author":"刘因","text":"伦理天生有自然，莫言家累损清閒。\n何人会我图中意，说似阳城与鲁山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题李渤联德高蹈图四首 其四","author":"刘因","text":"诸生课罢弄烟霞，纺绩乘閒为煮茶。\n白鹿高风有谁继？\n草堂贫女晦庵家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中闻云溪不在","author":"刘因","text":"灯火幽窗拟对谈，十年不到二龙潭。\n白云吹作山前雨，应报高僧不在庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新居","author":"刘因","text":"雪拥闲门尽未除，小斋人道似禅居。\n年来日历无多事，只有求方与借书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂著集陶句二首 其一","author":"刘因","text":"人生岂不劳，终古谓之然。\n孰是都不营，早起暮归眠。\n过足非所钦，躬耕非所叹！\n但使愿无违，甘以辞华轩。\n正尔不可得，在己何怨天。\n自古有黔娄，被服常不完。\n荣叟老带索，饥寒况当年。\n何以称我情，赖古多此贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂著集陶句二首 其二","author":"刘因","text":"善恶苟不应，鬼神昧茫然。\n是非苟相形，行止千万端。\n世路廓悠悠，聊且凭化迁。\n居常待其尽，任真无所先。\n诗书塞座外，弱子戏我前。\n亲戚共一处，馀粮宿中田。\n促席延故老，斗酒散襟颜。\n聊以永今朝，百世谁当传？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集杜句赠王运同彦材","author":"刘因","text":"霄汉瞻佳士，公侯出异人。\n家声同令闻，文雅见天伦。\n玄朔巡天步，危楼望北辰。\n燕王买骏骨，黄阁画麒麟。\n妙誉期元宰，苍生倚大臣。\n蛟龙得云雨，雕鹗离风尘。\n治国明公在，雄图历数屯。\n世儒多汩没，贤俊赞经纶。\n开辟乾坤正，调和鼎鼐新。\n弼谐方一展，风俗尽还淳。\n经济宜公等，泥涂任此身。\n尊荣瞻地绝，感激异天真。\n交态遭轻薄，浮生有屈伸。\n嗟予意轗轲，抚迹独酸辛！\n留滞才难尽，苍茫兴有神。\n形容真潦倒，世业岂沈沦。\n倚著如秦赘，逢迎念席珍。\n壮心久零落，败绩自逡巡。\n载感贾生恸，难甘原宪贫。\n邵平元入汉，王粲不归秦。\n回首躯流俗，生涯脱要津。\n稻粱求未足，台衮更谁亲？\n碧海真难涉，苍鹰愁易驯。\n君能微感激，何处不依仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵生","author":"陈植","text":"玄霤峰如画，别来劳梦思。\n江乡为客久，岁晚到家迟。\n夜暖梅花发，冬深草亦衰。\n红尘染衣袂，莫使白云知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绿水曲","author":"陈植","text":"绿水西阊道，送君江上行。\n盆城应不住，五老笑相迎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]