[{"title":"春晚书怀二首 其一","author":"贡师泰","text":"东吴丧乱后，消息竟何如？\n日望平安信，空传报捷书。\n壮心徒感激，老泪独欷歔。\n坐对垂杨晚，行人江上疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晚书怀二首 其二","author":"贡师泰","text":"江黑雨将至，水高潮正来。\n花随两岸别，鸥逐片帆开。\n世治逢多难，吾生愧不才。\n飘零添白发，见者莫惊猜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄静庵上人","author":"贡师泰","text":"细雨桐花晚，微风麦气秋。\n王符偏好学，宋玉不胜愁。\n世事同蕉鹿，人心类棘猴。\n何时虎溪上，还共远师游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆侄景","author":"贡师泰","text":"自汝南台去，栖迟两见春。\n鼓鼙江上月，烽火海边尘。\n衰病全非昔，传闻总不真。\n近知更大将，旗帜一时新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马仲皋立秋韵","author":"贡师泰","text":"酒尽青山暮，书从白雁过。\n长风断疏雨，阙月挂明河。\n故国逢人少，新秋到客多。\n不知沧海上，何日罢干戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题朱质夫东野草堂","author":"贡师泰","text":"幽人海昌住，草屋向村墟。\n□竹频呼鹤，分泉谩种鱼。\n梨花春巷冷，榆叶夜窗虚。\n细雨篝灯火，匡床正读书。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洪栈驿","author":"贡师泰","text":"万壑从东下，群峰向北围。\n牛车縆水去，驴驮负薪归。\n隙日斜窥户，尖风直透衣。\n羁怀正无赖，一鹗向南飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和石田马学士殿试后韵","author":"贡师泰","text":"春风驰道入宫墙，青琐深沈引夕郎。\n草染绿波生太液，花扶红日上披香。\n声名已重千金璧，恩宠方隆七宝床。\n治世斯文今极盛，九天星斗自成章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈太祝使江浙收礼器乐书二首 其一","author":"贡师泰","text":"天子齐明奉宗庙，容台祇饬备仪章。\n云雷出地雕彝鼎，日月悬天画衮裳。\n驿骑昼停山木荫，船窗风度水花凉。\n过家莫醉红楼月，上国回鸾欲禘尝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈太祝使江浙收礼器乐书二首 其二","author":"贡师泰","text":"六月楼船泛御河，太平乐谱自编摩。\n凤鸣嶰谷曾吹律，马出蒲梢更作歌。\n古尺要将诸部定，新声还用四清和。\n器成早入神庭奏，人颂明时瑞应多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"崇真宫醮罢敕画吴宗师像","author":"贡师泰","text":"海日曈昽照九衢，霓旌霞旆拥高居。\n尚方敕画仙官像，中使传宣学士书。\n剑气朝寒垂白练，丹光夜暖出红蕖。\n石坛醮罢清如水，犹听松阴起步虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画马","author":"贡师泰","text":"汉家旌节度流沙，夺得戎王铁喙騧。\n天上白鱼秋弄影，月中玄兔夜生花。\n九图妙入将军笔，八骏神空阿母家。\n独控奚官更超绝，长楸锦队谩如霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送黎兵胡万户南还","author":"贡师泰","text":"将军仗策去安边，诏下东南万里天。\n云海旌麾趋玉帐，春江鼓角载楼船。\n黎人满溜槟榔水，蜑户齐分牡蛎田。\n遥想军中无一事，坐驱千骑猎平川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陶翁归豫章","author":"贡师泰","text":"秋雨初晴䆉稏香，蟹红鱼白忆江乡。\n十年客枕鸡声月，千里归帆雁背霜。\n入室亲朋罗酒馔，上堂儿女挽衣裳。\n逢人莫说京华事，汉署今无白发郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天寿节日大明宫朝罢口占简张约中博士","author":"贡师泰","text":"金门珠箔转回廊，文武分班有旧章。\n花露重沾腰佩湿，松风轻度鬓丝凉。\n仗随骐骥通朝贡，杯进夔龙祝寿康。\n最喜太常张博士，清标如雪照鹓行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送林希元应奉赴上虞县尹","author":"贡师泰","text":"居庸雪消河水深，南行赖有买舟金。\n相如多病因能赋，东野长贫为苦吟。\n已许姓名辞凤阙，更传声价到鸡林。\n白头作县临东海，谁识先生去住心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送余廷季赴海东佥宪","author":"贡师泰","text":"绿发相从白发生，都门握手倍多情。\n论交岂少新朋友，对酒何如老弟兄。\n玉节绣衣江上骑，苑花宫柳日边莺。\n使星一夜移东海，定遣文章到两京。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送苏伯修侍郎赴淮东廉使","author":"贡师泰","text":"黄金台上受新恩，还向长杨谒至尊。\n行殿晓寒颁玉节，驿亭春暖簇朱轓。\n青蒲叶短烟波阔，黄柳枝长雪水浑。\n别后新诗好相寄，广陵冠盖接都门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四川张万户夫人贞节卷","author":"贡师泰","text":"白帝楼前巷陌深，将军旌旆正沈沈。\n玉箫声断孤鸾曲，绿绮弦空别鹤吟。\n岂是人生轻一羽，要知身死重千金。\n春风冢上连枝树，只有韩凭会此心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠仙居散人","author":"贡师泰","text":"青山四面玉嵯峨，中有山人隐薜萝。\n细雨閒门芳草满，微风深涧落花多。\n童窥丹灶时惊鹤，客写《黄庭》欲换鹅。\n我亦平生爱疏散，春来应许谢朝珂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"广微天师祈雪有应诗以美之","author":"贡师泰","text":"九枝灯照碧坛空，龙虎旗高满殿风。\n绿简夜深朝玉陛，素幢春浅拂珠宫。\n一天冻色星河合，万里冰华陆海同。\n明日内家应锡宴，綵符争取缀钗虫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送连子奇归隐赣州","author":"贡师泰","text":"蓟门风冷白鹅来，万里孤舟一日开。\n去路定过彭泽县，到家重上郁孤台。\n煮茶林下收黄叶，理钓矶边扫绿苔。\n太史明朝占处士，少微依旧傍三台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都诈马大燕五首 其一","author":"贡师泰","text":"紫云扶日上璇题，万骑来朝队仗齐。\n织翠辔长攒孔雀，镂金鞍重嵌文犀。\n行迎御辇争先避，立近天墀不敢嘶。\n十二街头人聚看，传言丞相过沙堤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都诈马大燕五首 其二","author":"贡师泰","text":"棕榈别殿拥仙曹，宝盖沈沈御坐高。\n丹凤衔珠装騕䮍，玉龙蟠瓮注葡萄。\n百年典礼威仪盛，一代衣冠意气豪。\n中使传宣捲珠箔，日华偏照郁金袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都诈马大燕五首 其三","author":"贡师泰","text":"卿云弄彩日重晖，一色金沙接翠微。\n野韭露肥黄鼠出，地椒风软白翎飞。\n水精殿上开珠扇，云母屏中见衮衣。\n走马何人偏醉甚，锦鞲赐得海青归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都诈马大燕五首 其四","author":"贡师泰","text":"箫韶九奏南风起，沙燕高低扑绣帘。\n醽醁酒多杯迭进，鹧鸪香少火重添。\n旧分宫锦缘衣襵，新赐奁珠簇帽檐。\n日午大官供异味，金盘更换水晶盐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都诈马大燕五首 其五","author":"贡师泰","text":"清凉上国胜瑶池，四海梯航燕一时。\n岂谓朝廷誇盛大，要同民物乐雍熙。\n当筵受几存周礼，拔剑论功陋汉仪。\n此日从官多献赋，何人为诵武公诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过柳河","author":"贡师泰","text":"野旷山寒露易霜，短榆疏柳路茫茫。\n雨来黄潦聚成海，风过白沙堆作冈。\n驿馆到时逢数骑，驼车宿处错群羊。\n客怀政尔无聊赖，忽见南飞雁一行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送上都吴学录归河东就试","author":"贡师泰","text":"驱车直渡滦河水，千里青山半月程。\n自信文章当世用，人言书剑到家荣。\n上林久已称司马，宣室终须召贾生。\n料得凤池春色满，柳阴立马共听莺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄王鲁川推官","author":"贡师泰","text":"公庭草绿讼声稀，时见双双蛱蝶飞。\n曹史尽随衙鼓散，理官独抱狱书归。\n曾同太守行红旆，更与高僧别翠微。\n近报南台多辟荐，殿前早晚赐朝衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宋仁甫赴池州阴阳教授","author":"贡师泰","text":"北风吹雪路漫漫，万里荆门客正寒。\n自爱青衫同博士，也胜白发老长安。\n城南款段此时别，江上芙蓉到日看。\n我亦春来买舟去，九华绝顶望扬澜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠写神镜塘上人归京口","author":"贡师泰","text":"鹤翎风动碧天凉，宝月新凝百鍊霜。\n水面散成千种影，波心元只一轮光。\n玉簪道士来空室，金粟维摩现十方。\n此去要观真法相，却收画本过维扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新蝶","author":"贡师泰","text":"杏树生香蠹化成，向人飞下不胜情。\n寒辞薄翅犹粘粉，暖溢柔须始弄晴。\n燕舞盘中嫌露重，莺歌扇底避风轻。\n春闺未解南华梦，乞与滕王为写生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送明原道赴南丰判官","author":"贡师泰","text":"日华西转万年枝，记得甘泉奏赋归。\n佩马新迎州倅节，绯鱼旧赐从臣衣。\n诗成江驿梅花瘦，酒醒山城蕨菜肥。\n为谢南丰旧诗友，白鸥春梦绕苔矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送江西傅与砺赴广州教授","author":"贡师泰","text":"买得吴船便欲东，更骑羸马别诸公。\n文声久许江西盛，诗律因归海外工。\n人羡义阳封介子，客从泰畤荐扬雄。\n五羊城下南风起，茉莉花香荔子红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冠州","author":"贡师泰","text":"万里关山鬓易华，冠州桥下御河斜。\n千门烟冷分榆火，三月春寒见杏花。\n新水聚船人趁市，顺风吹旆客还家。\n莫怜书剑频漂泊，拟学东陵老种瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚泊邳州","author":"贡师泰","text":"一带黄河百折湾，下邳城外更潺湲。\n烟迷两岸疑无地，日落中原喜有山。\n法重盐租严犯界，官多鱼税倍征关。\n白头父老相逢处，犹似圮桥授履还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扬州别斡克庄佥宪","author":"贡师泰","text":"红日东生绿雾收，海风吹客到扬州。\n露分仙掌金盘冷，香动琼花玉树秋。\n使者乘骢开大府，仙人骑鹤醉高楼。\n朝来别我垂杨岸，珂佩如云簇水头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题丁元善鍊师阳明楼","author":"贡师泰","text":"贺老家西百尺楼，好山多处称仙游。\n丹光散作霞千缕，剑气吹成月一钩。\n窗外鹤归辽海暮，袖中龙起鉴湖秋。\n道人久直黄金殿，可使归来雪满头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘山驿","author":"贡师泰","text":"开窗坐看千峰顶，对酒还思万里程。\n飞雨远随松子落，湿云近向树头生。\n正愁绝壁乌鸢背，忽听半空鸡犬声。\n安得身骑辽海鹤，遍游八极醉吹笙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠漳南巡检许以衷","author":"贡师泰","text":"将军早献安边策，手挽强弓起七闽。\n正为功名轻万里，已知勇略冠千人。\n风鸣鼓角山村晓，日射旌旗海戍春。\n匹马何时渡江水，笑谈为国扫妖氛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"建德城西寺","author":"贡师泰","text":"山门东转步廊深，长日禅房占绿阴。\n松径雨晴添虎迹，竹潭风冷听龙吟。\n上林久说相如赋，故里徒誇季子金。\n独坐胡床看明月，不知凉露湿衣襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泉州驿别太守契世玉","author":"贡师泰","text":"老夫欲起犹便睡，候吏频催却治行。\n万里烟云随骥足，五更风雨杂鸡声。\n乾坤笑我应无补，江海逢君倍有情。\n且解金鱼沽别酒，洛阳桥下正潮平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴景文居庭牡丹盛开饮后有感","author":"贡师泰","text":"韶光天遣属君家，犹是东京第一花。\n金鼎夜寒团绛雪，锦机春暖簇红霞。\n倚风忽作缠头舞，避日还将便面遮。\n薄暮阑干同醉倚，却怜孤客鬓先华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送有亨侄还钱唐","author":"贡师泰","text":"嗣宗诸侄仲容贤，客路飘零雪满颠。\n曾为颂椒留子美，却思戏蜡爱僧虔。\n十年江海三杯酒，百里溪山一钓船。\n何日兵戈得休息，敬亭春雨共归田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵李清叔元夕","author":"贡师泰","text":"绛烛烧烟散满城，九衢车马似潮声。\n山河影转琉璃薄，陆海光浮菡萏平。\n蝶睡误翻歌扇暖，鹊惊疑报画檐晴。\n夜阑人静天如水，依旧残星数点明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏子瞻画像","author":"贡师泰","text":"老龙起深夜，来听洞箫声。\n酒尽客亦醉，满江空月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎山十咏 其一 金鸡山","author":"贡师泰","text":"巨灵劈山石，飞出黄金鸡。\n至今山下人，犹听云中啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎山十咏 其二 象山","author":"贡师泰","text":"载宝出西域，献琛自南溟。\n仙人一叱之，化作青崚嶒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎山十咏 其三 龙井","author":"贡师泰","text":"宝剑落深潭，时时见光怪。\n鳞甲飞上天，白昼风雨快。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎山十咏 其四 云台山","author":"贡师泰","text":"天星二十八，下作汉廷将。\n功成归帝傍，精彩射石上。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明仁殿进讲五首 其一","author":"贡师泰","text":"春日君王出殿迟，千官帘外立多时。\n觚棱雪转寒无奈，先许儒臣到讲帷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明仁殿进讲五首 其二","author":"贡师泰","text":"黄绫写本奏经筵，正是虞书第二篇。\n圣主从容听讲罢，许教留在御床边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明仁殿进讲五首 其三","author":"贡师泰","text":"殿前冠佩俨成行，玉椀金瓶进早汤。\n自愧平生饭藜藿，朝来得食太官羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明仁殿进讲五首 其四","author":"贡师泰","text":"黄金为带玉为檐，剑戟如林卫紫髯。\n也爱儒臣勤讲读，向前轻揭虎皮帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明仁殿进讲五首 其五","author":"贡师泰","text":"奏对归来日已西，独骑瘦马踏春泥。\n行从海子桥边过，犹望宫城柳色齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人归庐州","author":"贡师泰","text":"淮水春深绿似苔，故人天上恰归来。\n扁舟系在门前树，犹记行时手自栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题渊明小像","author":"贡师泰","text":"乌帽青鞋白鹿裘，山中甲子自春秋。\n呼童检点门前柳，莫放飞花过石头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其一","author":"贡师泰","text":"城上鸦啼曙色催，五门三殿一时开。\n玉皇不许群仙见，隐隐车声天上来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其二","author":"贡师泰","text":"绿池香水出芙蓉，十二钗寒妒玉虫。\n只恐禁园今夜雨，华清明日又西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其三","author":"贡师泰","text":"宝扇微开万乐从，紫衣扶辇出行宫。\n近臣侍罢樱桃宴，更遣黄门送两笼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其四","author":"贡师泰","text":"紫云扶日上盘盘，花气薰衣露始乾。\n行处不禁春色恼，回身却倚玉阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其五","author":"贡师泰","text":"睡思厌厌易入眉，绣帘低下燕归迟。\n黛鬟不整钗梁亸，满院杨花梦觉时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其六","author":"贡师泰","text":"殿头昨夜报春残，尽放宫人赏牡丹。\n独有沈香亭北畔，一枝偏许八姨看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和马伯庸学士拟古宫词七首 其七","author":"贡师泰","text":"云影微开日脚垂，杏花深院落游丝。\n不知谁动秋千索，惊起黄鹂过别枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和胡士恭滦阳纳钵即事韵五首 其一","author":"贡师泰","text":"紫驼峰挂葡萄酒，白马鬉悬芍药花。\n绣帽宫人传旨出，黄门伴送内臣家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和胡士恭滦阳纳钵即事韵五首 其二","author":"贡师泰","text":"野阔天垂风露多，白翎飞处草如波。\n髯奴醉起倾浑脱，马湩香甜奈乐何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和胡士恭滦阳纳钵即事韵五首 其三","author":"贡师泰","text":"荞麦花深野韭肥，乌桓城下客行稀。\n健儿掘地得黄鼠，日暮骑羊齐唱归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]