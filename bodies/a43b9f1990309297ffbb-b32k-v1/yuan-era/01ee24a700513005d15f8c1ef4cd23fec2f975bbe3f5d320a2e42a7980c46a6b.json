[{"title":"春山程鍊师山房 其一","author":"黄镇成","text":"春山道士不饮酒，颜如丹渥气如虹。\n不是出山归较晚，贪看明月过桥东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春山程鍊师山房 其二","author":"黄镇成","text":"春山道士不辟谷，自斸芝田种白云。\n昨夜石坛明月冷，一声长笛半空闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题摘枝海棠","author":"黄镇成","text":"展卷还教蜀客疑，半含清露湿胭脂。\n草堂二月花无数，开透春风未有诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月调兵赴绥阳 其一","author":"黄镇成","text":"五月南征亟出师，黄尘眯目汗流衣。\n衰翁偃仰犹嫌暑，惭愧军中几日归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月调兵赴绥阳 其二","author":"黄镇成","text":"五月农家半未耕，更闻田鼠食苗萌。\n辕门昨夜飞书急，十户三人赴调兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月调兵赴绥阳 其三","author":"黄镇成","text":"五月公私乏见储，师徒野掠竟何如。\n自怜无力操戈从，未敢偷安饱饭居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月调兵赴绥阳 其四","author":"黄镇成","text":"五月炎蒸日似年，金龙山下有林泉。\n不知杖锡何时去，裹饭从师借榻眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李遵道枯木竹石图","author":"黄镇成","text":"老树槎牙倚半空，苍筠叶叶带秋风。\n欲将岁晚论心事，遥忆美人江水东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜中忽雨","author":"黄镇成","text":"岁恶无邻堪乞籴，时艰何地可移民。\n秋来一夜江南雨，不责空囷活饿人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郑子声飞凤朝阳图","author":"黄镇成","text":"万叶迎风舞翠翘，五云浮日丽青霄。\n祗应飞上青天去，吹作仙人紫玉箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为吴松庵题古木疏篁图 其一","author":"黄镇成","text":"老树经秋叶未霜，一溪流玉落沧浪。\n有人解得江南意，月下吹箫引凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为吴松庵题古木疏篁图 其二","author":"黄镇成","text":"曾上君山第一峰，遥看湘岸起秋风。\n今朝忽忆王摩诘，都在淋漓醉墨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"商橘所画海棠双喜图","author":"黄镇成","text":"相向相鸣两缟巾，海棠风暖上林春。\n今朝识得眉黄意，同立花间报主人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨子辅竹树小景","author":"黄镇成","text":"发竹矶头晚泊舟，雨篁烟树隔沧洲。\n美人无限潇湘意，分得江南一片秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张师夔玉华楼观图","author":"黄镇成","text":"碧嶂层层玉洞秋，云烟缥缈似丹丘。\n祗应与子携琴去，共住仙人十二楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题剑水秋浦山房","author":"黄镇成","text":"借得云房一榻秋，十年山水记曾游。\n逢人欲说当时事，满树西风独倚楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三华道中书所见 其一","author":"黄镇成","text":"秋雨才收雨没沙，升平渐复到田家。\n村村晒白蚕犹茧，处处吹香稻正华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三华道中书所见 其二","author":"黄镇成","text":"绿树田家蓊若云，黄牛沙碛散成群。\n行人却爱三华好，海内风尘更忍闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李倚衡所藏边伯京萱竹图","author":"黄镇成","text":"金谷园西锦水东，紫丝云暖露华浓。\n琴中写得江南意，翠绕巫山十二峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春雨书怀 其一","author":"黄镇成","text":"春深已喜冰霜尽，老大惟惊岁月徂。\n若待清明方纵目，人间风雨几时无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春雨书怀 其二","author":"黄镇成","text":"多忧每恐风摇竹，易感还愁雨滞花。\n亦幸山房炉火在，春寒独自煮春茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田自述","author":"黄镇成","text":"泰华浮云连日观，江湖夜雨水浮天。\n老来但觉身无系，来伴山僧野客眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王元善赴北清江新雁图","author":"黄镇成","text":"江南春水拍天齐，鸿雁成行向北飞。\n未必云山便相隔，秋风还带夕阳归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郑克刚双松图","author":"黄镇成","text":"老干悬霜紫翠分，一山风雨半空闻。\n携琴欲扫苔根石，为写秋声寄白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪窗兰石图","author":"黄镇成","text":"空谷幽人紫绮裘，洞箫声远碧山秋。\n月明忽忆同游客，已在君峰十二楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越王台","author":"黄镇成","text":"亭院荒丘古，萧萧草木秋。\n遗来辇路迹，传属越王游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"放歌台","author":"黄镇成","text":"堂搆新池上，閒来放浩歌。\n阳春元寡和，夜月许谁过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西窗昼雨","author":"黄镇成","text":"三春惊过半，霪雨洒窗西。\n鹊脑添炉炷，春鸠隔树啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春竹","author":"黄镇成","text":"花落东皇暮，春江深复深。\n双柑携向客，斗酒听鸣禽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"看泉","author":"黄镇成","text":"竹树柴门古，重阴胸女萝。\n徘徊溪径曲，瀑布下岩阿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪舟独泛","author":"黄镇成","text":"玉树耸长空，琼瑶万壑封。\n夷犹冰镜里，诗思灞桥东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纳凉","author":"黄镇成","text":"避暑到重阴，奚奴挟素琴。\n南薰时自至，灌木响鸣禽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春竹","author":"黄镇成","text":"岩曲泻鸣泉，风花万树妍。\n支筇连袂去，踏草兴悠然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老僧翻经","author":"黄镇成","text":"趺坐傍云根，圆空慧性存。\n法华堆自展，难与世人论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野桥","author":"黄镇成","text":"选胜野桥边，疏松似鼓弦。\n亭幽当水曲，林际起秋烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"放棹","author":"黄镇成","text":"天清一棹远，枫老叶如花。\n溯到芙蓉渚，遥空见雁斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪","author":"黄镇成","text":"琼瑶天半耸，风急六花飞。\n寂寞无人境，孤舟傍钓矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夕泛","author":"黄镇成","text":"秋净山如拭，江清一棹横。\n挂帆延暮眺，趺坐待潮生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野望","author":"黄镇成","text":"寒江一棹远，接岸板桥斜。\n独往乘幽兴，何妨去路赊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蚕妇辞","author":"洪焱祖","text":"贫家桑地狭，买叶疗蚕饥。\n叶价贵如金，卖钗仍典衣。\n所得弗偿费，况乃筋力疲。\n萧条镜中颜，伊轧窗下机。\n都将寸心苦，织入千万丝。\n帛成不敢裁，支梧迫公私。\n端居被文绣，愧尔西家施。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿中滦","author":"洪焱祖","text":"晓出酸枣门，暗与夷山别。\n睡睫风沙濛，冻须露华结。\n小车驾双驴，箕踞坐卼臲。\n野阔迷去程，铎鸣避来辙。\n亭午过黄河，浊浪半天掣。\n雷声撼乾坤，土色暗日月。\n杂以牛马车，百命托孤叶。\n含灵幸有知，帖妥无踶齧。\n妄动或侧欹，均同一沤灭。\n到岸已斜阳，相庆犹馀慑。\n人稠屋稍华，炊过炕喜热。\n问名知中滦，境壤卫辉接。\n买饭直不廉，年饥断曲蘖。\n旅卦尚资仆，数奇我俱阙。\n远游触事非，陋学谋身拙。\n兹行似可笑，内顾奚所挟。\n体疲即就枕，衾薄尽发箧。\n淅淅瓦霰鸣，前途明日雪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"文安县","author":"洪焱祖","text":"文安隶霸州，显德州始置。\n萧萧风捲沙，渺渺天裹地。\n驼载杂驴车，日落喧市肆。\n酸齑芼汤饼，我亦解鞍憩。\n维昔石晋兴，结辽与共事。\n割畀十六州，贸易一闰位。\n世宗取三关，锐意平幽蓟。\n破竹功垂成，服药志勿遂。\n金瓯竟莫完，铁砚真左计。\n艺祖继挥戈，似亦欠乘势。\n后人不量力，轻举速颠踬。\n中原百战争，乱极数当治。\n大物自有归，追思一长喟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿苍岭绝顶","author":"洪焱祖","text":"行穷涧百折，始上深山高。\n峥嵘岁年晚，蹭蹬人马劳。\n积雪冻如铁，寒雨细于毛。\n但见石荦确，而闻草萧骚。\n亘古无日色，白昼有鬼号。\n谷氓惊过客，奔窜捷猿猱。\n商贾虞剽劫，出没森弓刀。\n岭半乃有店，三州犬牙交。\n历险得一息，讵敢轻衡茅。\n饥炊甘如饴，况觊丰馔醪。\n嗟予本孱儒，早与世故鏖。\n欣怖从何生，梦幻随所遭。\n昔贤仗忠信，岭海气愈豪。\n矧此奚足云，内视固有操。\n窗开风灭烛，松响鹤归巢。\n思诗夜无寐，霁月生林梢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宛丘","author":"洪焱祖","text":"寿春之宛丘，十日复五日。\n河盘常山蛇，舟舞宋都鹢。\n途长冬景短，坐卧厌局蹐。\n未知疏凿意，何苦纡弗直。\n恭惟大圣人，环辙于斯厄。\n神龙困泥沙，祥凤栖枳棘。\n平原澹荒烟，犹带愠见色。\n知士多崄艰，愚夫抱安逸。\n有怀重徘徊，延伫三太息。\n路转见孤村，垣低出古驿。\n过雨蔓菁青，凉风木绵白。\n林疏散鸡豚，土广饶菽麦。\n红裙摇清漪，浣女秋波急。\n柳边当垆妇，倚阁看过客。\n数户赋一兵，优游且殷实。\n北人尚并兼，差徭合众力。\n束矢莫能折，床肤讵剥及。\n南人虽弟昆，小户亦缕析。\n岁久弱弗支，贪官肆蚕食。\n何当此卜居，卖书买玺栗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄岩盛景则来为吾郡征官见示诗文因成一章","author":"洪焱祖","text":"昔我游公乡，瞻望弗及见。\n公今仕吾州，过从两不倦。\n人生水上萍，邂逅随风转。\n端能相知心，岂在蚤识面。\n高文久自珍，屡请容一眄。\n如升泰山顶，朝观海日眩。\n云涛浮青红，光采生万变。\n新诗更圆美，花暖娇莺啭。\n忽疑龙挂天，飞雨响银箭。\n呜呼此事难，补衮非袜线。\n沉吟拊几案，便欲弃笔砚。\n终然齿未衰，犹冀骨可换。\n跪请九还诀，昼夜锻复鍊。\n骖鸾侍远览，八极如抹电。\n宁同井底蛙，局促自矜衒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再用韵答景则","author":"洪焱祖","text":"风骚久寂寥，作者未多见。\n四灵晚唐家，讽咏使人倦。\n恭惟浣花翁，下笔坤轴转。\n岂为黄陈私，万世当北面。\n海阔苍天高，未易穷睇眄。\n吾曹夜迷方，仰斗可无眩。\n读之三十年，陋质稍觉变。\n羡君得其髓，不随群鸟啭。\n出户合车辙，两锋交快箭。\n织成紫绡衣，非假五色线。\n官閒竹满轩，宾退云生砚。\n击节独长谣，连城肯轻换。\n春山芝术香，委羽好修鍊。\n挂冠归何时，牛背射岩电。\n逝将从游歌，抱月谨勿衒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"群校思乐亭对酒","author":"洪焱祖","text":"高斋俯远山，烟树疑无地。\n急雨破微晴，馀春起秋思。\n念彼荷蓑人，原田各趋事。\n劳生有近功，实务非清议。\n而我独何为，穷年守经笥。\n讲授信多娱，抚躬祗自喟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"问政山","author":"洪焱祖","text":"行穷白云坞，步入青松林。\n飞花去人间，好鸟鸣春阴。\n黄冠雅好客，瀹茗澹冲襟。\n洒之幽兰芬，弄以清泉音。\n怀哉媚丹灶，谅矣轻华簪。\n常年聂仙子，出处知何心。\n徘徊扬州鹤，怅望故山岑。\n仙游不可问，古墓蓬蒿深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵奉酬孟能静见贻之什","author":"洪焱祖","text":"公生富贵家，被服同寒俊。\n一官成一集，诗学源流正。\n后生竞传诵，心服非猊敬。\n岂惟言语工，先后典七郡。\n鸱鸮怀好音，鸿雁托安定。\n纷华剧相攻，不战以道胜。\n五十未为老，卧疴谢朝请。\n世议日以隘，强起宁肯更。\n忆昨临新安，味同获亲近。\n一朝惊送别，桀黠共相庆。\n顷余续州乘，特笔纪善政。\n岁晏客衢城，因风辱佳咏。\n清时故将军，吾党大司命。\n后凋松柏姿，弥烈姜桂性。\n彼昏冒宠荣，会有暗鬼侦。\n相期身后名，永与日星映。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戴就","author":"洪焱祖","text":"东都有一士，天赋岂寻常。\n屈居仓曹掾，众未察所长。\n一朝薛从事，未按郡守赃。\n收就钱唐圄，五毒既备尝。\n烧斧挟肘腋，辞色愈慨慷。\n焦毁肉堕地，掇以充饥肠。\n覆船薰马通，三日孰可当。\n发视意其死，大骂目方张。\n针爪使杷土，彭考无馀方。\n宁死白于天，终不枉忠良。\n其事竟得释，太守免归乡。\n我观此丈夫，性命轻毫芒。\n心非儿女脆，肤亦铁石刚。\n见义不见身，遥恤支体伤。\n古今几冤狱，蔀屋埋日光。\n由来独行少，史册徒芬芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月二十二日押纲离杭是夜泊舟浮山","author":"洪焱祖","text":"客船拨不开，见船不见河。\n官船亦龃龉，护送烦麾诃。\n逡巡各敛避，容我跃丈波。\n千篙正插笋，一只俄腾梭。\n出郭晓初分，到江午已过。\n日月互答吐，海天相荡摩。\n越树绿攒荠，吴山青点螺。\n舍狭就空旷，登仙超网罗。\n将夕忽风顺，纲军鸣鼓锣。\n上水帆若箭，夜宿依寒坡。\n乘快终有险，耐迟庶无它。\n河江置勿论，嗟我鬓既皤。\n之官半载馀，行路五月多。\n下瘠上弗察，孤清众难知。\n劳形兼费橐，痴恋欲如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓舍近溪有大木数章休暇辄游息其间偶得二诗 其一","author":"洪焱祖","text":"吏卒各已休，独步风林下。\n雨馀堤草青，亦放庭前马。\n隔水叫黄鹂，千山暗初夏。\n非无可乐资，孰是同情者。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓舍近溪有大木数章休暇辄游息其间偶得二诗 其二","author":"洪焱祖","text":"春去不留花，青阴满山县。\n天生溪上林，息我簿书倦。\n济世本无能，观心如有见。\n携瓢酌清波，三漱复三咽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永康道中","author":"洪焱祖","text":"悬崖忽褰开，放目诗满野。\n千林并一青，秀色森可把。\n水光相映发，农事皆幽雅。\n谁遗孟诸樵，汨没风尘下。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过贵义岭入龙泉县界","author":"洪焱祖","text":"原泉落青天，当道巉翠壁。\n界破一条虹，东西流两邑。\n两邑民颇淳，不劳官置驿。\n后村报前村，舆夫歘然集。\n惯行轻积险，改负逞新力。\n而我坐何安，大半亲降陟。\n吁嘘邻封讼，使往平曲直。\n道丧巧伪滋，论公贪猥嫉。\n愧尔荷锄翁，身劬心最逸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵府尹范松石游柯桥","author":"洪焱祖","text":"天边洞户长不扃，洞口芝田龙自耕。\n灵梅已逐风雨散，飞花乱点仙人枰。\n五马踏云山鬼惊，九霞觞劝瑶琴鸣。\n玉虹僵卧众峰锁，雷斧剜开一窍明。\n轻身欲跨碧烟去，宿习要湔尘界清。\n倚松默念黄庭经，酌泉更咽紫石瑛。\n餋圣怀胎十月满，子建吟诗七步成。\n归来凝香洒醉墨，三复使我迷魂醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅天台杨景羲拟杜陵曲江体五首 其一","author":"洪焱祖","text":"天台山深秋月明，幽人见月偏多情，伐木赓诗求友生。\n我亦弹琴不成调，风清露冷越江横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅天台杨景羲拟杜陵曲江体五首 其二","author":"洪焱祖","text":"快剑斫水水不绝，同心何恨音书阙，莪蒿两地中肠热。\n还怜瘦马系空阶，得似青鞋踏沙月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅天台杨景羲拟杜陵曲江体五首 其三","author":"洪焱祖","text":"百川赴海海不满，志士意长日月短，金丹九转成功晚。\n台山采药听清猿，剩欲投簪寄閒散。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅天台杨景羲拟杜陵曲江体五首 其四","author":"洪焱祖","text":"城中帻峰高插天，竹房煮茗僧汲泉，半江云影危阑前。\n秋风吹去一只鹤，老我回头三十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵荅天台杨景羲拟杜陵曲江体五首 其五","author":"洪焱祖","text":"洞天夜宴桃花下，座中都是能文者，银烛穿山闹车马。\n当年此会几人存，安得云龙逐东野。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题鱼浦晚归图","author":"洪焱祖","text":"近村寂寞孤炊起，远树为茫沽酒市。\n柳丝高挂新月钩，平者是沙流者水。\n黄头摊网儿刺船，腥风瑟瑟鱼平舷。\n沙鸟背人群欲睡，林禽追棹去相先。\n千金何处得此纸，咫尺烟波含万里。\n不纳租庸过一生，提鱼换酒仍赊米。\n仙源路远桃花残，人间踏地多惊湍。\n珍重江湖钓竿手，莫遮西日向长安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大雨次韵刘成德","author":"洪焱祖","text":"断鳌立极水倒流，当时何处辨九州。\n玄圭告成绿字显，下有桑土高山丘。\n六甲乾坤纳壬癸，习坎卦中云雨起。\n女丁妇壬传世婚，相王休因此常理。\n如何祝融灰不然，今年冥顼独司天。\n阴旌高张帝鼓闹，逆捲平陆成奔川。\n惊心白昼重泉杳，素练当檐垂未了。\n彻夜弥加气势酣，兼旬犹恨滂沱少。\n思徵麦曲医河鱼，何惜千金购提壶。\n火乌濡翅飞不得，怒鼍撞城来突如。\n揭竿求子纷叫喘，沉灶产蛙多叹吁。\n试登冈阜望原野，彷佛天吴挂海图。\n我闻五行各有叙，月离于毕工招雨。\n桃花红绽壮波涛，梅子黄肥蒸溽暑。\n焉知极备反致凶，荡析盖藏埋栋宇。\n照泥占星信屡验，灼蔡卜晴殊未许。\n列仙高居琼楼深，赤子坐受颠崖苦。\n为糜食饿岂无人，祷社荣门传自古。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]