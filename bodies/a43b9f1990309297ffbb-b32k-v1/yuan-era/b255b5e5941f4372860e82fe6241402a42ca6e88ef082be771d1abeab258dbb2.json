元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其四","author":"朱晞颜","text":"翩翩沙际鸟，冲雨去何之。\n羡杀前汀鹭，翛然立水涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其五","author":"朱晞颜","text":"马龁枯萁晓，梦回山月残。\n一鞯秋色里，偏觉毳袍寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其六","author":"朱晞颜","text":"路转村逾僻，江平岸欲无。\n片帆明夕照，天遣画成图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其七","author":"朱晞颜","text":"古驿经过少，空庭鸟雀多。\n我来正摇落，奈此岁年何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其八","author":"朱晞颜","text":"西风波浩渺，我欲访三高。\n安得翼鸿顺，归舟捷似舠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其九","author":"朱晞颜","text":"江花随意碧，照水可怜生。\n不见采莲女，映妆羞月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"市汊驿十绝次韵 其十","author":"朱晞颜","text":"丈夫四方志，不识别离愁。\n风里挂帆去，宁辞云路修。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山翠","author":"朱晞颜","text":"群山喁喁来，跃入千层翠。\n漫垩有馀斯，我欲斲其鼻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古意二首 其一","author":"朱晞颜","text":"妾有古明镜，光彩分妍媸。\n君面虽可照，君心未必知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古意二首 其二","author":"朱晞颜","text":"妾心如镜背，苍翠磨不灭。\n君心似镜心，妍丑随人设。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题夹山玄真渔钓图","author":"朱晞颜","text":"榔板从喧寂，丝缗自浅深。\n烟波同是客，谁识得鱼心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19904,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏蕙","author":"朱晞颜","text":"居然丈夫质，嶷嶷萧艾中。\n自非铅华种，桃李若为容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19905,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其一","author":"朱晞颜","text":"春江流水曲尘波，亭上羁人奈若何。\n底事同来不同去，又添新雨入漳河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19906,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其二","author":"朱晞颜","text":"岩花红白柳深青，箫鼓丛祠竞乞灵。\n可笑监官祝如愿，今年仍似去年醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19907,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其三","author":"朱晞颜","text":"暑雨初收积潦深，虹桥高下任浮沉。\n痴儿了却公家事，卧看西林度夕阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19908,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其四","author":"朱晞颜","text":"迥江亭北石阑东，荷气吹香递晚风。\n一夜扁舟发章赣，数声欸乃月明中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19909,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其五","author":"朱晞颜","text":"江净秋清雁影空，参差落木飐西风。\n秀文几树堂前桂，得得吹香入座中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19910,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其六","author":"朱晞颜","text":"红鳊白粲楚江秋，升斗来为口腹谋。\n世事自来如意少，忍堪无蟹有监州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19911,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其七","author":"朱晞颜","text":"轩窗小小客情舒，榾柮堆红拥地炉。\n荡暖破除晨粥了，此身还似在家无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19912,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其八","author":"朱晞颜","text":"辛苦携家累左迁，亏赢自信且随缘。\n鬓毛衰飒缁尘遍，又与梅花度一年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19913,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其九","author":"朱晞颜","text":"平生心迹与天通，刻画无私任化工。\n堪笑东轩旧桃李，等閒开落媚东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19914,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江亭十绝 其十","author":"朱晞颜","text":"百折奔腾万马驰，区区欲把此江迥。\n阑边鸥鸟忘机久，飞过涛头去又来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19915,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄唐子华照磨二首 其一","author":"朱晞颜","text":"春透江梅向暖枝，清香已许冻蜂知。\n遥思东阁无馀事，排遣东风正费诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19916,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄唐子华照磨二首 其二","author":"朱晞颜","text":"江汉飞飞鸿雁秋，孤羁未足稻粱谋。\n谁怜独客悲摇落，梦入寒塘月满洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19917,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曹娥纯孝祠","author":"朱晞颜","text":"纯孝祠荒草自春，江山依约髻鬟青。\n行人不识夫人意，只把金钱愿乞灵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19918,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄卫戴叔三首 其一","author":"朱晞颜","text":"西湖春色滟歌钟，十载分携一梦中。\n今日归来头并白，满林黄叶卧秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19919,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄卫戴叔三首 其二","author":"朱晞颜","text":"畦蔬绕舍稻粱新，白酒黄鸡不负贫。\n何事匆匆乘传去，青山元不解随人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19920,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄卫戴叔三首 其三","author":"朱晞颜","text":"少年惊座纵雄谈，作掾输君只语三。\n不用归来誇舌在，试烹石鼎与同参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19921,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午睡偶成 其一","author":"朱晞颜","text":"閒门尽日递凉薰，八尺蕲藤展浪纹。\n睡久不知团扇落，更无来客为书裙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19922,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午睡偶成 其二","author":"朱晞颜","text":"龙门汲雪芳林之，址两山如户旁有。\n石泉夏旱不竭汲，以煮茗味极甘美。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19923,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"午睡偶成 其三","author":"朱晞颜","text":"山深万木偃蛟龙，岩罅渟涵一水中。\n自拾堕樵供石鼎，细听飞雪洒归篷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19924,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鸟洋观鱼","author":"朱晞颜","text":"桃花飐浪龙先化，翠网曾牵出万艘。\n拨剌金鳞轻拾块，南风一席乱云浮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19925,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题两猿图","author":"朱晞颜","text":"穿林饮涧啸秋风，活计虽殊乐意同。\n自笑平生山野性，一生何事著樊中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19926,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题星翁尧民诗卷","author":"朱晞颜","text":"白榆历历满天街，廓落薇垣帝座开。\n东壁图书群玉府，好曕奎画候兰台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19927,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南浦朝云","author":"朱晞颜","text":"一缕微升海峤东，悠然飘泊信无踪。\n赤乌苍狗浑閒事，卧看东西三四峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19928,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹菊 其一","author":"朱晞颜","text":"谁幻秋芳五色奇，漫教姚魏识东篱。\n可怜一寸风霜骨，绝似徐娘老大时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19929,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹菊 其二","author":"朱晞颜","text":"丹岩拾翠岩产石，赤白色圆转如珠。\n世传仙灵遗迹春，游士女拾以为玩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19930,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牡丹菊 其三","author":"朱晞颜","text":"山蹊雨过绿初肥，的的啼红映落晖。\n斗草归来喧笑语，春风满袖湿珠玑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19931,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明良诗 其八","author":"吴当","text":"云汉于昭，发耀天藻。\n垂美无疆，永以为宝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19932,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明良诗 其九","author":"吴当","text":"翼翼厥明，终始典学。\n陈善责难，世臣攸托。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19933,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明良诗 其十","author":"吴当","text":"以道事君，汝翼汝为。\n股肱左右，庶底缉熙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19934,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明良诗 其十一","author":"吴当","text":"明良之逢，有典有则。\n世笃忠贞，式报天德。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19935,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其一","author":"吴当","text":"于穆天命，恒久不已。\n往禅来续，与道为体。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19936,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其二","author":"吴当","text":"惟圣有德，率性之常。\n不二不杂，悠久无疆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19937,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其三","author":"吴当","text":"君子是则，勉勉不息。\n终始弗渝，夙夜无斁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19938,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其四","author":"吴当","text":"赫赫元勋，昔佐皇祖。\n配德惟一，永锡胤祚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19939,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其五","author":"吴当","text":"侃侃闻孙，靖共在位。\n式谨尔常，以赞天子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19940,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其六","author":"吴当","text":"佩舄雍雍，退食自公。\n肃慎斋居，用省厥躬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19941,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其七","author":"吴当","text":"协于克一，责难将美。\n徵其化成，万国咸理。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19942,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"恒德斋为开府明良公作 其八","author":"吴当","text":"惟巽而动，勿承以羞。\n亿万斯年，于昭匹休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19943,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其一","author":"吴当","text":"春木载荣，朝阳孔曦。\n悠悠白云，华盖之西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19944,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其二","author":"吴当","text":"爰有新亭，翼翼中峙。\n式究尔宁，君子攸止。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19945,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其三","author":"吴当","text":"其止维何，朝弦莫歌。\n道其问学，弗辟弗颇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其四","author":"吴当","text":"斯道之著，皎焉日星。\n发育峻极，敛之灵扃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其五","author":"吴当","text":"弥纶六合，迥绝寥廓。\n周知旁行，卓彼先觉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其六","author":"吴当","text":"如俯层台，洞视靡遗。\n如持悬鉴，罔有蔽亏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其七","author":"吴当","text":"知崇效天，礼卑法地。\n成性之存，内外交致。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其八","author":"吴当","text":"万物毕备，一贯斯全。\n参乎有唯，思也是传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19951,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其九","author":"吴当","text":"予忝承学，子实名裔。\n自顾无闻，祇用生愧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19952,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"极高明亭诗为曾以敬作 其十","author":"吴当","text":"惟博反约，实基三省。\n敢曰尚友，愿以自警。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19953,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其一","author":"吴当","text":"惟楚萍乡，邑里有堂。\n繄昔刘氏，肇基于唐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19954,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其二","author":"吴当","text":"雄虎之台，郁郁丘土。\n其伏未耀，本干深固。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其三","author":"吴当","text":"子孙多贤，冠佩蝉联。\n积善储和，溯流而源。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其四","author":"吴当","text":"福庆之实，既坚既栗。\n晔晔灵芝，毓秀于室。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其五","author":"吴当","text":"历宋而元，流庆未已。\n袒免同居，表德闾里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其六","author":"吴当","text":"山冢之迁，有霆有雷。\n尚复多祉，源源其来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其七","author":"吴当","text":"奕奕君子，实居后麓。\n既休既宁，以踵芳躅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其八","author":"吴当","text":"绳绳厥承，忠厚之教。\n庶其绍之，以食斯报。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庆原堂诗为萍乡刘氏作 其九","author":"吴当","text":"太史有记，邦人足徵。\n式勖来嗣，勒诗尔楹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]