[{"title":"傲窗诗卷","author":"凌云翰","text":"偶向南窗倚暮秋，寄情宁复傲公侯。\n谁知容膝无多地，高似元龙百尺楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为安道题墨竹","author":"凌云翰","text":"何事清风满剡溪，琅玕长得与云齐。\n此君若得王猷见，兴尽应须为品题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梁大用所作青松红梅二画 其一","author":"凌云翰","text":"仙馆长松老更奇，过门曾见出墙枝。\n谁传月下蛟龙影，应有风雷起砚池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梁大用所作青松红梅二画 其二","author":"凌云翰","text":"占得魁名即赐绯，调羹心事尚依依。\n玉堂别有如椽笔，更待春风为发挥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方李长所作梅竹 其一","author":"凌云翰","text":"竹里梅花巧耐寒，正如红袖倚阑干。\n诗翁传淂春风面，曾在家山别墅看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方李长所作梅竹 其二","author":"凌云翰","text":"竹传唐帖双钩法，梅效徐家没骨图。\n谁道茂林春已暮，不知春色在西湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渊明像","author":"凌云翰","text":"两晋文章在此翁，阳秋都寄杖藜中。\n诗人秪写归来意，不道闲情似国风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画","author":"凌云翰","text":"草堂筑得傍林丘，溪友相过即放舟。\n翻爱白云如画意，终朝长在碧山头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沈养性画","author":"凌云翰","text":"长虹如瀑蛎如山，万竹深藏屋数间。\n夜半秋声最堪听，抱琴来此不须还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鬼猎图 其一","author":"凌云翰","text":"飞鹰走狗猎山坡，狐兔全驱入网罗。\n不有唐家钟进士，人间魑魅更应多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鬼猎图 其二","author":"凌云翰","text":"谁遣馗翁作鬼雄，形容彷佛记唐宫。\n山林川泽今无此，转忆先生铸鼎功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鬼猎图 其三","author":"凌云翰","text":"虚耗驱除若羽毛，开元天子赐蓝袍。\n空令鬼物持戎器，不管雄狐向窟嗥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渭川烟雨图","author":"凌云翰","text":"渭川曾见竹青青，和雨和烟画杳冥。\n不似九疑云雾隔，空教瑶瑟怨湘灵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牧牛图","author":"凌云翰","text":"桃林地瘠奈牛何，此日周王已止戈。\n芳草平原春万里，牧童能唱太平歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赤壁图","author":"凌云翰","text":"江水东流赤壁孤，曹瞒曾此战周瑜。\n山川不逐英雄去，却为坡仙入画图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕王阁图","author":"凌云翰","text":"画栋朱帘云雨间，朝看南浦暮西山。\n风帆不送诗人到，高阁临江亦等闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"裴日英墨菊","author":"凌云翰","text":"披图便欲醉秋光，映竹幽花似有香。\n昨日山中新酒熟，先生闲户作重阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋山渔影图为方仲敏赋","author":"凌云翰","text":"秋色都从点染成，白云妚树故山情。\n溪渔钓得归来得，卧听松窗瀑布声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林子山诗意扇面","author":"凌云翰","text":"门前春水碧如苔，不见鸥来见鹤来。\n翻意断桥曾唤渡，满身花雨荡舟回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱宗文扇","author":"凌云翰","text":"吴淞江上见秋风，水色山光下笔同。\n闻道四腮驴最美，几时归去作渔翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为沈景玉题高士谦所作烟雨万竿图","author":"凌云翰","text":"影薄犹疑翠袖寒，东林日暮忆曾看。\n渭川千亩谁能写，烟雨空濛千万竿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦竹石扇面","author":"凌云翰","text":"何处参差舞翠鸾，瑶台明镜上云端。\n如今织女支机石，也被姮娥借得看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林子山画菜上有蜗牛故及之","author":"凌云翰","text":"晓畦春雨细如毛，菜本青肥挟土膏。\n叶底蜗牛曾湿久，诗人犹欲剌升高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔隐图","author":"凌云翰","text":"渔者虽多屡数难，磻溪彷佛到严滩。\n东都名教西周业，不枉人间把钓竿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杏花暮雨图","author":"凌云翰","text":"杏花庭院暮寒多，酒醒其如客思何。\n绛蜡烧残犹觅句，不知春雨湿渔蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画鱼","author":"凌云翰","text":"谁写群鱼入画图，相忘浑似在江湖。\n诗人忽作丰年梦，还有宣王考牧无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为杨复初题秋江归棹图仍次其韵","author":"凌云翰","text":"不为莼鲈若忆归，缁尘惟恐上人衣。\n欲知此日思亲意，长似征帆带雨飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举二菊 其一","author":"凌云翰","text":"露华如酒晓淋漓，醉色和秋上别枝。\n若使罗虬重有作，此花瑞合比红儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举二菊 其二","author":"凌云翰","text":"尽道西施类玉环，多因醉里认容颜。\n馆娃宫与华清似，都在秋风十二鬟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"裴日英墨菊","author":"凌云翰","text":"浓墨淋漓写折枝，便从纸上见东篱。\n玉蟾分得南阳水，一衣秋香满砚池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邹汝舟画","author":"凌云翰","text":"童子言师去未还，采芝多在白云间。\n谁知流水桃花外，更有高人卧碧山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青山白云图","author":"凌云翰","text":"何处青山无白云，每来松顶便氤氲。\