[{"title":"悼节","author":"范梈","text":"百华高下拥晴天，竹屋方床兴悄然。\n忽忆逝人泉下冷，学烧楮火作新烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明后，闻邻庄牡丹尽发，馆中独迟。雨晴，忽开一枝，咏以志赏","author":"范梈","text":"千山飒飒雨无风，憔悴群芳二月中。\n整待人家春事过，小亭特放状元红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杨补之墨梅","author":"范梈","text":"学到逃禅自一家，洗空尘墨印江沙。\n笔端不有兰亭骨，莫写园林雪后花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江东晚泊","author":"范梈","text":"云间列岫映朱楼，江水东来打石头。\n不是行人惜光景，人心旧有帝王州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江上古祠","author":"范梈","text":"老树昂藏倚岸隈，祠灵经岁锁苍苔。\n豚蹄卮酒能多少，便有群鸦旦暮来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重感","author":"范梈","text":"曾谒聊城太守归，吏扶残醉踏斜晖。\n重来柳下停船处，太息人间万事非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖面","author":"范梈","text":"湖面春深煖气匀，青芜未陨已知春。\n沙湾散驻张鱼客，苇室时惊射雁人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉隆宫","author":"范梈","text":"东晋真人尚典刑，石函故在药飘零。\n阁前正是升仙处，云路笙歌少得听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经梅仙坛下","author":"范梈","text":"懒慢辞朝梅子真，空山祠庙已千春。\n自从上疏东都后，不见江湖有直臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北山谷中老父","author":"范梈","text":"无多林屋冠青山，长子成孙鬓未斑。\n问我乡原何处是？\n半生江海未知还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题万竹秋声","author":"范梈","text":"山人爱竹手自种，万个直临江水边。\n长吟浪被秋风觉，散作宫商声满天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱生幽禽图","author":"范梈","text":"谁人剪下碧梧枝，误落西风粉墨池。\n立断小禽飞不去，朝阳何事凤鸣迟？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"封州作","author":"范梈","text":"魏阙迢迢隔彩霞，别来几岁客天涯？\n春风二月崖州道，时见棠梨一树花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渡端州峡","author":"范梈","text":"棹郎得便溯清流，忽报舟前晓雾收。\n蛮语酬人翻自苦，好山不敢问何州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月二十四日至宝圭驿是北流县自此遵陆指郁林矣","author":"范梈","text":"远辞京阙碧云端，溯尽夷江未到官。\n回雁峰南更千里，是行谁为报平安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登沓磊驿楼，自此度海","author":"范梈","text":"半生长以客为家，罢直初来瀚海槎。\n始信人间行不尽，天涯更复有天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒海神庙","author":"范梈","text":"南州未识异州苹，初向沙头问水神。\n料得行藏无用卜，乘桴人是北来人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"得樟树镇便寄家书","author":"范梈","text":"商船夜说指江西，欲托音书未忍题。\n收拾乡心都在纸，两声杜宇傍人啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"琼州出郭","author":"范梈","text":"自出琼州古郭门，更无平衍似中原。\n重重叶暗桄桹雨，知是黎人第几村？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临高阻雨","author":"范梈","text":"恐倾南海成秋雨，急唤西风作晚凉。\n净扫黎山须见骨，莫令楚客屡回肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"槟榔寨","author":"范梈","text":"秋入黎山风雨多，长江不定驻惊波。\n翠榕叶底闻鹦鹉，自此无如客思何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安定县","author":"范梈","text":"岛上晴云灭复生，谁家吹笛海天明？\n县堂晓起西风急，半是深黎夜雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至富屯","author":"范梈","text":"承恩千里出江乡，转历三关道路长。\n黄叶雾开山市集，见人凫雁忆横塘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西楼","author":"范梈","text":"童子出舂亲掩关，春来芳树伴人闲。\n别家五月不得信，独上西楼思远山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元夕","author":"范梈","text":"危楼向暮倚层空，故岁今年不得同。\n记取合沙元夕节，满街箫鼓雨兼风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月十六夜，双门观灯，时闽、粤阃官吏皆集","author":"范梈","text":"双门此夜启崇台，次第东山好月来。\n自古金吾元不禁，少留大将与衔杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二十六夜，得舍弟书，及知熊敬舆茂才消息。期旦夕有会，并知便，良足快慰也","author":"范梈","text":"故人天阙腾新荐，舍弟云溪守敝庐。\n未省东归何日见？\n挑灯细读寄来书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南涧志见","author":"范梈","text":"繁桃只称倚红扉，腊酒吹香着舞衣。\n楼底谁家吹玉笛？\n一双白鹭上云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"池馆夜坐听雨","author":"范梈","text":"更声随雨动谯门，颇似听泉宿楚原。\n客里青灯如骨肉，独能相待向黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀京下亲友","author":"范梈","text":"海上经年思杀人，绝怜京国旧交亲。\n过江唯有传柑使，寄得书回是暮春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"池上晚步","author":"范梈","text":"清池斜步竹烟微，莺啭重门锁夕晖。\n退食幸堪无趋谒，见人惭道听公非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"不寐","author":"范梈","text":"鼓角连天月满城，芭蕉叶上露华生。\n思乡不寐占潮信，说是中旬夜半平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐池上馆","author":"范梈","text":"沉沉画戟隐高牙，月满闽都十万家。\n竹外小曹人睡稳，杖藜独立听鸣蛙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"建安馆夜坐听流水","author":"范梈","text":"平生慕爱武夷君，及此名山阻白云。\n九曲水声流过郡，夜深犹得世人闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"路傍树","author":"范梈","text":"路傍古木是谁栽，更有山棠次第开。\n东海神仙求不得，何因百岁客重来？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临觞","author":"范梈","text":"几见春钟度上阳，偶因寒尽强临觞。\n故乡只在车轮下，自是青云路每长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻笳","author":"范梈","text":"何处闻笳最是悲，京门独立晚晴时。\n鹂庚一去荒郊远，借问春光有底迟？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜诵赋瓶花","author":"范梈","text":"胆瓶折得树头花，初是东园一片霞。\n西涧读书过夜漏，忽随灯影上窗纱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓书","author":"范梈","text":"欲写乡书寄故园，行人已远意空存。\n举头却见南来雁，个个随春度塞门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山僧养犬","author":"范梈","text":"不见岩扉净业君，山僧养犬漫成群。\n人知自此来看少，祇向山中吠白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆得","author":"范梈","text":"忆得佳人《白纻》词，几将天外数归期。\n自从落尽庭前树，夜夜秋声总不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠郭判官","author":"范梈","text":"慈乌夜夜向人啼，几度纱窗兔魄低。\n自有平安三百字，无因却寄大江西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种树","author":"范梈","text":"种树江头不记春，年来年去祇伤神。\n今朝忽向江头见，稍有清阴芘路人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沟上","author":"范梈","text":"御沟新绿动朱阑，沟上垂杨尽可看。\n惟有西山九千仞，朝朝阙角倚晴寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卧病","author":"范梈","text":"朝来忽见树藏霞，碧草村边径路斜。\n佳客不来春雨尽，山禽啄遍小桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灵应宫","author":"范梈","text":"万花如绣拥青红，梯石棱层见梵宫。\n一十二时春百刻，日长半在鸟声中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日留西山","author":"范梈","text":"离家六度见清明，知是何时出帝京。\n今日登临倍惆怅，好山多似豫章城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"逢芳草","author":"范梈","text":"忽逢芳草思绵绵，绿遍郊原翠满川。\n不是王孙归未得，尽缘春色有今年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西谷访人不遇","author":"范梈","text":"出郭幽人晚未归，青天咫尺见何稀。\n一年祇有春晴好，多事杨花学雪飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题闺人望远图","author":"范梈","text":"郎行不用苦悲辛，久别心知万事亲。\n看取江边垂柳树，最先零落最多春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬友人月夜见寄","author":"范梈","text":"舍北舍南流舫通，高荷万柄倚微风。\n不识此时明月夜，共谁谈笑水烟中？","collection":"元","notice":