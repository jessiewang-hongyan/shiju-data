[{"title":"陶生","author":"廖大圭","text":"陶生真我友，生恨不同今。\n清节照当世，黄花知此心。\n衣冠思典午，诗酒寄东林。\n寂莫将千载，无人归去唫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唁许生","author":"廖大圭","text":"幽明分伉俪，期月废游歌。\n畴昔期偕老，于今奈若何。\n春魂来梦寐，秋序感蹉跎。\n一击庄生缶，忧端未觉多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏氏","author":"廖大圭","text":"嫠居三十载，将母育孤儿。\n之子有如此，他人谁过之。\n素尘生晓镜，凉月入秋帷。\n贞节磨千古，茫茫独尔思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄山长内子挽诗","author":"廖大圭","text":"阀阅钟醇懿，来嫔江夏黄。\n同心空自结，异路竟相望。\n环佩归何处，铭旌带夕阳。\n十年今得葬，无憾即玄堂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和孙公子游南山","author":"廖大圭","text":"帝里归来日，胸怀尚昔年。\n人材今可数，公子独无前。\n大旆光南寺，清唫到暝烟。\n功名方鼎鼎，未许傍云眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚过许生遂相携至蔡家新亭","author":"廖大圭","text":"落日淮桥上，因君得胜游。\n花蹊入流水，林院近清秋。\n抚景方成玩，题诗更少留。\n悠然心迹静，新月照归休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵星夕","author":"廖大圭","text":"中年亲旧远，寂莫岁时过。\n有客山南集，开尊月下歌。\n三更来白露，一水静银河。\n不得同清赏，因诗感慨多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"院檄归田于我贺主者","author":"廖大圭","text":"使院来新檄，莲宫复旧田。\n顿除经岁患，应为主人贤。\n合浦收膏壤，同袍仰食天。\n汶阳归鲁后，麟笔动千年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云上人","author":"廖大圭","text":"藻鉴高双眼，刀圭活万人。\n多材能济世，行橐自生春。\n谈笑诸侯客，鉼盂释氏身。\n识真今已少，谁信混光尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送嘉惠师祷雨归","author":"廖大圭","text":"幢盖来嘉惠，汤年待救焚。\n衣冠趋梵刹，风雨起炉薰。\n井有回泉脉，田无补地文。\n尚何怀故里，远近一慈云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访东寺不在","author":"廖大圭","text":"东郭寻幽事，高人适出游。\n不成相问讯，欲去复淹留。\n湖近荷香入，亭空树影浮。\n更须乘月夜，行遍竹林秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送知藏者归山","author":"廖大圭","text":"君探龙藏遍，犹有去来心。\n久客流年易，故山归梦深。\n林泉成独往，风月废同吟。\n别后多春哢，嘤嘤听好音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚凉知许生独在小楼寄赠","author":"廖大圭","text":"落日见山色，小楼初罢书。\n晚凉成独立，幽兴在高居。\n皓月僧钟远，微云鹤树疏。\n极怜登眺好，诗律近何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简魏文宪二首 其一","author":"廖大圭","text":"南国徵兵赋，中军重掾曹。\n塞氛方不靖，王事敢云劳。\n匹马秋风晚，朋尊海月高。\n澄清天下志，馀事及诗骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简魏文宪二首 其二","author":"廖大圭","text":"林居长闭户，无意傍青云。\n此客人间少，杯茶松下分。\n神山誇独步，连率借多闻。\n岁晚来同社，匡时早策勋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送奇上人迎师榇京师","author":"廖大圭","text":"讣告南天晚，趋奔朔雪寒。\n帝乡非故土，人物已新棺。\n哭位颜如对，归丧魄亦安。\n师门诸子在，生死一心难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙母颜氏挽词二首 其一","author":"廖大圭","text":"五鼎侯家食，伊人独饭蔬。\n磬声诸佛近，经卷一灯初。\n南野空陈迹，西方有净居。\n长归秖遗蜕，万古閟幽墟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙母颜氏挽词二首 其二","author":"廖大圭","text":"当时裨内治，懿德玉无瑕。\n夙夜忧宗祀，勤劳在主家。\n新阡成马鬣，旧社有莲花。\n万里专城使，哀哀哭海涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颍川安人挽词二章 其一","author":"廖大圭","text":"事嫂犹姑氏，从夫若大宾。\n多仪皆妇道，百岁但情亲。\n云暗鱼轩远，天寒马鬣新。\n归寻泉下女，曾忆鼓盆人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颍川安人挽词二章 其二","author":"廖大圭","text":"颍水成东逝，仙山正夕佳。\n得男非我腹，有后慰中怀。\n大易家人馈，周诗季女斋。\n伤心无复见，丹旐已天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送詹海沤清溪游","author":"廖大圭","text":"溪水如蓝绿，幽人一叶舟。\n夕阳成独酌，山色在中流。\n清兴今谁及，长吟不自休。\n归来期扫榻，相对话良游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠孟伯真宪郎别因谢墨竹 其一","author":"廖大圭","text":"养亲须薄禄，作吏本无心。\n霜雪知清节，乾坤付漫吟。\n旧游南国满，新梦北堂深。\n老我云林下，凭谁豁素襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠孟伯真宪郎别因谢墨竹 其二","author":"廖大圭","text":"墙阴数丛玉，笔底有清风。\n留赠非无意，相期迥与同。\n岁寒犹特立，心事一玲珑。\n何以酬知己，猗猗在眼中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题五峰岩","author":"廖大圭","text":"一寻五峰老，孤塔在云端。\n铁树已古色，石房空昼寒。\n风流无后辈，山水入多盘。\n见说潜公隐，天华雨满坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东济上作","author":"廖大圭","text":"大江日东去，吾道竟悠悠。\n一世几同志，百年空白头。\n青山犹入俗，皓月不随流。\n安得长风便，孤舟万里浮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唁基道人丧弟","author":"廖大圭","text":"只谓百年内，脊令相近飞。\n急难长在眼，风雨一同归。\n死别惊心早，情亲举世稀。\n断云秋日暮，念尔独何依。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵詹生怀陈众中阮信道","author":"廖大圭","text":"旧游陈与阮，不见独成吟。\n无复此联璧，为谁重鼓琴。\n朔方文字老，南国酒杯深。\n今日风流远，令人恨满襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南国","author":"廖大圭","text":"南国地皆赤，吾生亦有穷。\n丰年何日是，菜色万人同。\n海上舟频入，民间楮已空。\n犹闻谷价涌，开籴若为功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"馈饟","author":"廖大圭","text":"馈饟资边阃，南军万灶寒。\n断粮今累月，为变岂无端。\n夜戍留文吏，秋兵?武官。\n到头就诛戮，饿死固应难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桑城","author":"廖大圭","text":"桑城连盗贼，国楮断新颁。\n只少材充制，非关上有悭。\n人情无用旧，世事渐成艰。\n陛下明如日，更张一铸山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有怀","author":"廖大圭","text":"不知经此乱，犹及见吾亲。\n归去嗟无路，淹留愧有身。\n孤城闭白日，四野起黄尘。\n我里今何似，区区欲问人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哀郑亢宗","author":"廖大圭","text":"每侍尊公侧，颜开白玉温。\n相期成远器，何事作归魂。\n舐犊能无泪，瞻乌尚有恩。\n苍天不可问，端遣几人存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病甚廓上人能来 其一","author":"廖大圭","text":"卧病百馀日，拥衾山雨寒。\n世人不我爱，之子独相看。\n市药能盈裹，春蔬得满盘。\n一闻此问讯，吾道愧艰难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病甚廓上人能来 其二","author":"廖大圭","text":"乱馀饥又甚，云散我庐空。\n时运方如此，人心莫与同。\n病身须一壑，天下付诸公。\n为报平生友，途今处处穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵詹生因所见有感","author":"廖大圭","text":"四门磔群贼，饿者竞趋之。\n顾此果何物，犹能疗汝饥。\n虎今生角翼，民已竭膏脂。\n无怪人相食，干戈正此时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独坐","author":"廖大圭","text":"秋风一来林院深，开户自弹焦尾琴。\n丛木寒凉独鹤白，乱云高下群山阴。\n老天有月照閒坐，清夜无人同苦吟。\n古来穷饿得不朽，我生与世空浮沉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登云榭","author":"廖大圭","text":"老屋危台雨气昏，石苔不见旧镵痕。\n当年霸业旌麾尽，故国秋声树木存。\n度海雁行惊断角，近城萤火没荒垣。\n无人去买长瓶酒，一酹陈王千载魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖上简閒中","author":"廖大圭","text":"秋近清波荷叶圆，叶阴疏处见青天。\n偶临湖坐得佳树，欲傍花行无小船。\n林院鹤归山色外，水亭人去夕阳前。\n深知碧玉壶中乐，一笑临风揖地仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王丞石泉","author":"廖大圭","text":"白石丛丛屋上山，泉声一道碧云间。\n十分如练月同色，万古不痕天照颜。\n静夜竹斋知雨意，清秋茶鼎共僧閒。\n甘寒可濯功名念，公子青袍鬓未斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"詹生","author":"廖大圭","text":"长材硕德见时清，底事斯文未有灵。\n天上谁传子虚赋，日斜犹草太玄经。\n龙媒在野空思秣，鹿角浮阳竞闯萍。\n顾我孤云岩壑底，相看一笑眼偏青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蚤起","author":"廖大圭","text":"山钟唤我披衣起，浩荡晓阴犹未开。\n稍觉柴门稀应接，独怜幽鸟下莓苔。\n束书如旧岁年晚，丛木近秋风雨来。\n一笑莫思身外事，好将兰蕙遍庭栽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辅上人自京师还遂如海上省觐","author":"廖大圭","text":"万里黄金台上客，白云回首故山深。\n庭闱岁月催华发，包笠秋风折寸心。\n百福起居申定省，三年音信问浮沉。\n不从客路看明月，身在青青桑梓阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"顾生","author":"廖大圭","text":"材调如君许倔奇，遁身药市不求知。\n风流谭笑来东晋，家世渊源接上池。\n经验方传函是玉，活人心在鬓成丝。\n从今努力行医国，沉醉休歌白纻辞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱将军北上","author":"廖大圭","text":"鲁国将军盖世雄，十年归卧海门东。\n旧游台阁诸公在，当日京师万马同。\n行李忽来人意外，觚棱重入眼明中。\n圣心政尔思颇牧，待赐临轩节钺崇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吕生访所知潮阳","author":"廖大圭","text":"浩水诗名喧岭海，天南有客力吹嘘。\n梦魂秋尽绕韩木，老气年来压鳄鱼。\n风浪扁舟酣笑语，布衣行李半琴书。\n青云六翮看高翥，林麓何时共卜居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哀王德符","author":"廖大圭","text":"深期久屈一时伸，白发蓬庐竟不春。\n在抱孤儿方识母，藏书万卷付何人。\n穗帷像设空堂暮，萧寺琴尊异世身。\n同社相逢俱涕落，百年无复见遗民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"霞山逸人","author":"廖大圭","text":"卜筑初成在燕居，红尘飞不到林庐。\n开门海月来清夜，隐几松涛满太虚。\n酒热剩招持蟹客，家藏深爱相牛书。\n城中少识庞公面，远挹高风谢不如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起见必上人去秋所惠诗次韵","author":"廖大圭","text":"闭户春寒燕子前，寥寥孤坐掩残编。\n中年心事谁复识，南院故人殊可怜。\n隔岁相思诗在箧，清秋忆共夜谭禅。\n交游疏远身多病，莫笑当时孟浩然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孙计总","author":"廖大圭","text":"六辔如琴仕路春，司存计省政方新。\n圣朝化洽关雎盛，史笔芳联汉吏循。\n伯仲埙篪闻上国，衣冠阀阅擅全闽。\n此时长画劳筹算，万一皇家忆荩臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孟上人兰若","author":"廖大圭","text":"长松短草秋风早，野寺寥寥古意存。\n老我独来呼圣佛，传家犹喜见玄孙。\n门前日落东湖绿，舍北云寒古岳尊。\n坐爱清游归未得，多情煮茗荐盘飧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贫后","author":"廖大圭","text":"贫后故人怜我少，秋来清兴为谁多。\n独将好句遍题竹，犹喜新衣一制荷。\n山曲白云朝自去，树头孤月夜相过。\n百年已分长冰檗，眼见风生陆地波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南山隐者","author":"廖大圭","text":"独抱胸中五色霓，南山高处乐幽栖。\n瓦墙护竹凉书牖，砂井分泉润药畦。\n白日杯茶多过客，长年更漏一鸣鸡。\n此身未得同君隐，回首杉松翠叶齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宁海桥","author":"廖大圭","text":"凿石为梁岁月悠，山川有待得谭侯。\n海桥壮观成三趾，国士勋名出一头。\n大浪不惊虹影湿，高车齐度马声秋。\n玉湖湖上通行路，浩荡馀波万古流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"示上人客鱼石归詹王二生信宿","author":"廖大圭","text":"天近瑶台新月明，相思无路去寻盟。\n三秋海上归来客，一夜灯前笑语声。\n黑发满头含瘴色，清贫到骨有诗情。\n岁寒尊酒诸公在，预戒春风卜远行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南院故人至","author":"廖大圭","text":"不见故人今几日，满山风雨落花声。\n云林孤坐度芳岁，杖屦一来开晚晴。\n剪烛西窗深夜语，卜邻南峤半生盟。\n病身已是栖迟久，汗漫相将游太清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵与史眉山别","author":"廖大圭","text":"清啸神山日未斜，独骑官马入桐花。\n尽驱春意苏亭户，不遣丹心负帝家。\n舄卤八州瞻幕府，风云万里接京华。\n去时得路扬鞭阔，野衲相思自摘茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答周詹二先辈过瓮天","author":"廖大圭","text":"缅思邃古尚巢居，一室盘蜗不愿馀。\n身外置锥似无地，眼中插架漫多书。\n梅檐觅句供閒趣，竹榻冥心到物初。\n赖有儒林炯连璧，相期结社慕匡庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"定居寄峤翁","author":"廖大圭","text":"囊空负我买山心，珍重多情许赠金。\n乌鹊倦飞三匝后，鹪鹩初托一枝深。\n竹窗斜日犹开卷，松榻新秋自理琴。\n从此卜居尘事少，高车莫惜过云林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过郑氏新居","author":"廖大圭","text":"芙蓉池上晚凉初，萍叶青青一雨馀。\n落日无人来洗马，小亭临水见游鱼。\n清吟我亦忘归去，长爱君能此卜居。\n绕岸近栽新树好，相期重看绿扶疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至北山","author":"廖大圭","text":"何处人间清意多，疏松白石散岩阿。\n道人汲水煮新茗，念我攀云到碧萝。\n泉谷夕阴留杖屦，林庐秋色入婆娑。\n野猿声断青天外，便欲临风一浩歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴公挽词","author":"廖大圭","text":"家声礼乐古延陵，立政临民自有经。\n父老数州争说尹，蛮夷一节旧瞻星。\n鄞江路接黄泉迥，锦里春回玉树青。\n归与淑人同穴好，老成何处见仪刑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故人过访","author":"廖大圭","text":"七尺长身卧故庐，日斜起坐对残书。\n几人岁晚能相问，一榻山中独久虚。\n好客新秋来杖屦，小窗暮雨共盘蔬。\n相看道义有真乐，万事悠悠总不如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王中荣新亭","author":"廖大圭","text":"长江东去万银涛，远屿西来拥六鳌。\n中有新亭专物色，极怜吾子近风骚。\n窗开白昼云根立，露洒清秋碧树高。\n见说良宵满栏月，呼尊留客试新糟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中秋雨","author":"廖大圭","text":"中秋有月不可逢，杖藜起踏台前松。\n天公一收玉兔去，广寒尽遣玄云封。\n归来闭閤风雨集，忆昔登楼宾客从。\n百年人事半忧乐，过眼阴晴知几重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青松山中次韵基道人","author":"廖大圭","text":"金粟山高晓雪晴，柴门相对有馀清。\n因逢好景成归隐，自许閒身乐泰平。\n白发已无尘世梦，青松新结岁寒盟。\n北林有客同岑寂，旋煮溪蔬折足铛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"廓上人事母疾愈","author":"廖大圭","text":"高堂传说病逾深，多少关情自不禁。\n归去恐无尝药日，平生兼有织蒲心。\n乌衣子弟皆如玉，青笋啼痕欲满林。\n一夜秋风苏鹤发，笑携杖锡入云岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王国祥游吴","author":"廖大圭","text":"南州故人独可怜，轻别闾里何翩翩。\n断发旧闻泰伯国，扁舟初入鸱夷天。\n云连茶灶自随去，月在芦花相对眠。\n秖今老我不得往，为传清梦到吴堧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]