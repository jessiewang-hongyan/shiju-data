[{"title":"杨村","author":"马祖常","text":"霜明野水晓粼粼，芦叶黄时少白蘋。\n船上忽逢吴客子，牵衣双手拂征尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"马祖常","text":"一春不得见花开，何况飞红堕酒杯。\n今日城南花万树，看花不肯放春回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其一","author":"马祖常","text":"吴王莲宫夜张乐，急管哀丝翠帘幕。\n可怜西子眉少颦，坐使长洲百花落。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其二","author":"马祖常","text":"天上冰蚕白雪丝，裁成纨扇好题诗。\n南风恰住西风起，莫道班娘有怨词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其三","author":"马祖常","text":"初嫁郎时正盛年，画眉涂颊斗婵娟。\n只知百岁专房宠，谁料君恩不似前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其四","author":"马祖常","text":"江南女儿年十五，两髻丫丫面粉光。\n小红船上采莲叶，北客初来应断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其五","author":"马祖常","text":"盈盈小客抱琵琶，歌舞王孙帝子家。\n弹得开元教坊曲，金钱还只当泥沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其六","author":"马祖常","text":"翡翠明珠载画船，黄金腰带耳环穿。\n自言家住波斯国，只种珊瑚不种田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句七首 其七","author":"马祖常","text":"甬东贾客锦花袍，海上新收翡翠毛。\n买得吴船载吴女，都门日日醉春醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄示男武子","author":"马祖常","text":"烂熳天孙织锦机，春风吹雨洗芳菲。\n香泥满地胭脂湿，只许新来燕子飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花马","author":"马祖常","text":"白毛红点巧安排，勾引春风上背来。\n莫解雕鞍桥下浴，恐随流水泛天台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南方贾客词","author":"马祖常","text":"江岸琅玕悲帝妇，云光漏日波含雾。\n泷船春下鹧鸪林，青帻蛮郎占龙户。\n千寻高杉生翠微，北人去买椒葛衣。\n鸡骨卜神铜铸鼓，却意冰纨将北归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"踏水车行","author":"马祖常","text":"松槽长长栎木轴，龙骨翻翻声陆续。\n父老踏车足生茧，日中无饭倚车哭。\n乾田荦确稚禾槁，高天有雨不肯下。\n富家操金射民田，但喜市头添米价。\n人生莫作耕田夫，好去公门为小胥。\n日日得钱歌饮酒，朝朝买绢与豪奴。\n识字农夫年四十，脚欲踏车脚失力。\n宛转长谣卧陇间，谁能听此无悽恻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"缫丝行","author":"马祖常","text":"缫车轧伊茧抽丝，桑薪煮水急莫迟。\n黄丝白丝光縰縰，老蚕成蛹啖儿饥。\n田家妇姑喜满眉，卖丝得钱买羃䍦。\n翁叟惯事骂妇姑，只今长男戍葭芦。\n秋寒无衣霜冽肤，鸣机织素将何须。\n翁叟喃喃骂未竟，当门叫呼迎县令。\n驺奴横索马鞭丝，妇姑房中拆纑经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拾麦女歌","author":"马祖常","text":"垄雉飞，桑扈鸣，老蚕入簇茧欲成。\n原头腰镰者谁子，刈麦归家作饼饵。\n心知栖亩有滞穗，恻恻忍收寡妇利。\n寡妇持筐衣蓝褛，终朝拾麦满筐筥。\n儿啼妇悲灶无火，寒浆麦饭晡时取。\n岂不见贵家妾，岂不知娼家妇，绣丝系襦莲曳步。\n银刀鲙鱼佐酒杯，狎坐酣歌愁日暮。\n拾麦女，拾麦女。\n尔莫嗟，尔莫忧，人生赋命各有由。\n前年贵家妾，籍入为官婢。\n今日娼家妇，年老为人弃。\n贫贱艰难且莫辞，毕竟荣华成底事？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古乐府","author":"马祖常","text":"天上云片谁剪裁，空中雨丝谁织来？\n蒺藜秋沙田鼠肥，贫家女妇寒无衣。\n女妇无衣何足道，征夫戍边更枯槁。\n朔雪埋山铁甲涩，头发离离短如草。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河西歌效长吉体","author":"马祖常","text":"贺兰山下河西地，女郎十八梳高髻。\n茜根染衣光如霞，却召瞿昙作夫婿。\n紫驼载锦凉州西，换得黄金铸马蹄。\n沙羊冰脂蜜脾白，个中饮酒声澌澌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南田歌三首 其一","author":"马祖常","text":"东塘水初满，西塘泉又生。\n春风两塘侧，多少路人行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南田歌三首 其二","author":"马祖常","text":"蒲生亦有笋，菰生亦有米。\n可怜芙蓉花，照影秋塘里。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南田歌三首 其三","author":"马祖常","text":"借钱买盐茶，倩人莳早秧。\n日望秋田熟，仍防野鸭伤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南鱼歌三首 其一","author":"马祖常","text":"棹船淮水上，晒网赤岸南。\n船中捕来鱼，卖钱买鱼篮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南鱼歌三首 其二","author":"马祖常","text":"小艇如凫鹥，湘东柴杉木。\n载家复捕鱼，夜夜系江竹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南鱼歌三首 其三","author":"马祖常","text":"渡江问鱼价，人来索酒钱。\n妇姑亦不恶，便煮缩项鳊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王左司柳枝词二首 其一","author":"马祖常","text":"郎君巧歌《杨柳枝》，柳眉初出学月支。\n隋堤千树烟光暮，不如柳眉初出时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王左司柳枝词二首 其二","author":"马祖常","text":"凤城三月草色青，池塘飞絮相飘零。\n风吹宛转低扑人，长空白日流榆星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王左司竹枝词二首 其一","author":"马祖常","text":"日边宝书开紫泥，内臣珠帽辇步齐。\n君王视朝天未旦，铜龙漏转鸡人啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王左司竹枝词二首 其二","author":"马祖常","text":"金炉宝熏留篆云，花间百舌鸣早春。\n五坊戏马赛争道，传声催赐十流银。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北歌行","author":"马祖常","text":"君不见李陵台、白龙堆，自古战士不敢来。\n黄云千里雁影暗，北风裂旗马首回。\n汉家卫霍今何用，见说军还如裹痛。\n不思百口仰食恩，岂念一身推毂送。\n如今天子皇威远，大积金山烽燧鲜。\n却将此地建陪京，滦水回环抱山转。\n万井喧阗车戛轮，翠华岁岁修时巡。\n亲王觐圭荆玉尽，侍臣朝绂蠙珠新。\n高昌句丽子入学，交趾蛮官贡麟角。\n斗米三钱金如土，国人讴歌将军乐。\n将军乐，四海清，吾皇省方岂田猎，观风察俗知太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"前宛转曲","author":"马祖常","text":"紫檀出海南，削成琵琶槽。\n上有鸳鸯弦，弹曲声嘈嘈。\n客问此何声，新声名绛桃。\n一奏桃始华，再奏花枝斜。\n笑靥颊晕粉，仙源饭蒸霞。\n度作新声曲，春树双莺逐。\n双莺掷金梭，鱼藻荡圆波。\n陌上行车带结罗，绛桃年少光阴多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"萧姓渊善鼓琴予尝为之作我思操今自和林归再任巡徼之职于江南比行又求予诗遂为赋汉铜马式歌以送之","author":"马祖常","text":"汉家金铜铸马式，求马相比不失一。\n塞上将军得一匹，骕骦如龙高八尺。\n日斜骑出阴山道，猎猎霜风鸣浅草。\n鞍后并悬双白狼，归来穹庐月弓好。\n江南绿芜春接天，只须一抹蹴云烟。\n摩诃旧是将军种，酒涴青衫学控弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"公子行","author":"马祖常","text":"绿香绣帐乘流苏，床头三尺红珊瑚。\n十八窈窕秦罗敷，曲房小步珰鸣襦。\n高台公子吹笙竽，百斛明珠买氍毹。\n兰灯桂浆炙文鱼，但苦不驻羲和车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其一","author":"马祖常","text":"华清水殿绣芙蓉，金鸭香消宝帐重。\n竹叶羊车来别院，何人空听景阳钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其二","author":"马祖常","text":"银床井冷露漙漙，半臂熏衣钏辟寒。\n不恨长门冬夜永，小奴休报袜罗单。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其三","author":"马祖常","text":"长门月转漏声催，自熨寒衣减带围。\n休怕官家嫌体弱，细腰曾是楚王妃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其四","author":"马祖常","text":"合宫舟泛跃龙池，端午争悬百綵丝。\n新赐承恩脂粉硙，上阳不敢妒蛾眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其五","author":"马祖常","text":"茧馆缫丝湿翠翘，夫人纤指织龙绡。\n罗襦双佩清晨响，只恐君王有晏朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其六","author":"马祖常","text":"八姨粉翠锡千缗，脂盝新妆百宝匀。\n白发上阳宫女老，补衣重拆绣麒麟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其七","author":"马祖常","text":"卯酒微微解宿酲，催花羯鼓变新声。\n君王好赐承恩宴，辛苦边头百将营。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其八","author":"马祖常","text":"露兰研粉寿阳妆，帘内新烧百刻香。\n圆舌教成鹦鹉语，偷将玉笛送宁王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其九","author":"马祖常","text":"银河七夕度双星，桐树逢秋叶未零。\n万岁君王当宁立，妾身不怨命如萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟唐宫词十首 其十","author":"马祖常","text":"花气蒸霞淑景明，望仙楼上看弹莺。\n李谟吹笛宫墙外，学得梨园第几声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书上都学宫斋壁","author":"马祖常","text":"斋居芹宫旁，永日少人迹。\n清心慕古躅，简编颇紬绎。\n徒自伤迷民，位卑力莫及。\n苟禄亦可羞，吾将反蓬荜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集袁王二学士诗为首二句祖常足成之","author":"马祖常","text":"石城月落鸦栖堞，秋浦天清雁拂檐。\n春送乱红浮酒面，山飘空翠湿书签。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹦鹉联句同王继学赋","author":"马祖常","text":"雕笼居啄桃，袨服仪采绿。\n南荒孕灵质，西颢发丽曲。\n颈绶红萦丝，喙棘赪屈玉。\n蓄慧婉含章，襮彩粲成缛。\n能言贯珠舌，善舞凌云躅。\n金眸肖韝隼，珍畜异巢鹄。\n层塔宝舍利，深杯注醽醁。\n流丹曙林度，堕翠春洲浴。\n石镜影毰毸，铜梁步陆续。\n题赋吾岂能，入贡尔应录。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都城南有道者居名松鹤堂暇日同东平王继学为避暑之游因作松鹤联句","author":"马祖常","text":"偃云耸层霄，惊露落古雪。\n虬枝喜垂涧，鹭羽陋鸣垤。\n蟠石千岁苓，顶朱百龄血。\n胎禽哺春巢，乳脂凝冱节。\n舞盖竽籁喧，啄粒苔藓齧。\n玄玉熏麝煤，碧胫隘鸡桀。\n陟岳秦爵崇，授甲卫轩劣。\n沐发豹雾深，引吭凤竹裂。\n风驭八极小，河舟三翼拙。\n鲁缟曳缡褷，夏社挺巀嶭。\n任重明堂材，言归华表别。\n拳缩包胥立，坚刚伯夷烈。\n延世饵方液，顾步炫高洁。\n作室擅兹美，观物入独阅。\n誓将束囊书，从尔解佩玦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天庆寺纳凉联句","author":"马祖常","text":"槐屋夏阴繁，石池暑气清。\n高堂瞰福田，邃宇依王城。\n午磬梵呗集，夜廊酥灯明。\n龛经郁金字，壁础承丹楹。\n寂寂鸽栖罘，宛宛燕穿荣。\n露葵炫昼艳，霞药敷阳英。\n境阒便静室，心古乐高情。\n逍遥祇园赏，迤逦庐社盟。\n山枕藉云润，水簟凝冰轻。\n饭盂给香积，袈衲褫华缨。\n共忻朋簪合，敢谓词锋并。\n睥睨荒草棘，横纵按林坰。\n幽寻振尘鞅，雅谈忘飞觥。\n鄙哉河朔饮，投愤得世名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"避暑","author":"贡奎","text":"避暑北山下，修篁夹林阴。\n客来澹忘言，稍觉清我心。\n酷暑尚可避，酷吏不可禁。\n迹绝畏途辙，凉飙散尘襟。\n却嗟避名者，犹恨山未深。\n为言暑与吏，纵酷何能侵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"敬亭山","author":"贡奎","text":"名山镇宣郡，古祠崇敬亭。\n杰构靓深岩，飞廊引重扃。\n陟彼百仞高，始觉万类形。\n楼殿势益弘，兵卫森幽灵。\n增秩睹隆典，纶音播明廷。\n丰穰走祈报，烟燎浮芳馨。\n竹树蔽险壑，虚阑俯南坰。\n麻姑湖上碧，华阳天际青。\n神飙飒然起，新凉濯微醒。\n疏雨映白石，垂虹截苍冥。\n永言李谢游，岂惜岁月零。\n悠悠孤云去，渺渺从双軿。\n招之殊未来，庄思展函经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荅陈华仲二首 其一","author":"贡奎","text":"海上三神山，上有学仙侣。\n泠泠紫箫声，吹作飞凤语。\n回飙荡溟海，散落成烟雨。\n岂无知音者，一振九苞羽。\n持之献天庭，上以奉明主。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荅陈华仲二首 其二","author":"贡奎","text":"贫贱交有道，富贵多异途。\n所以古君子，择交严所趋。\n霜剑閒宝室，烈士发长吁。\n隔世或相慕，同居分越吴。\n寥寥千载间，羡彼管鲍徒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦故人","author":"贡奎","text":"千里万里道，三年二年别。\n鸿雁去复来，我友音书绝。\n梦中忽一见，款语情更切。\n觉来失处所，残釭半明灭。\n相思各天涯，长夜寒剽冽。\n风霜草木变，贫贱不易节。\n中心谅谁知，素月当空洁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题董简卿所藏潇湘图","author":"贡奎","text":"潇湘在何处？\n展卷心悠然。\n是中有云飞，上与苍悟连。\n忆昔弄扁舟，载雪清江天。\n湘君招不来，明月随我前。\n微钟破征梦，落雁栖寒烟。\n回首行万里，揽衣羡孤搴。\n可怜楚人辞，憔悴穷岁年。\n图画岂不好，此意谁复传？\n已矣三叹嗟，临风叩商弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐二首 其一","author":"贡奎","text":"京国雨初霁，虚堂夜气凉。\n新月上团团，坐久流清光。\n露叶闪明晦，河云互飞扬。\n机籁发天秘，起弄琴与觞。\n千里同今夕，幽愁结中肠。\n湿萤低复举，栖鸟亦惊翔。\n适时物乃贵，人生何慨慷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜坐二首 其二","author":"贡奎","text":"夜久境逾静，居然庭树秋。\n气机发群动，时节无淹留。\n凉露浴蟾彩，浮云澹河流。\n微生竞如发，瀰思志常周。\n精爽一以竭，榛烟蔽前丘。\n道贵善持养，日入当偃休。\n寄言学仙子，文字徒冥搜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪晴","author":"贡奎","text":"今晨持我书，燕坐雪照屋。\n闭门谢尘鞅，展卷自朗读。\n众说初若攻，冥思意才复。\n旭日上团团，清泉涣春绿。\n涓涓晴櫩溜，洗眼溅飞瀑。\n岂不事游观，驱车泥及腹。\n永怀同袍士，岁晚在空谷。\n好风忽东来，起玩庭前竹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送夹谷伯敬之官单父","author":"贡奎","text":"燕州连日雨，六月寒装绵。\n闭户断车辙，修途溢如川。\n朝晴悦物性，槐阴起初蝉。\n衣篝曝馀润，照眼阶葵鲜。\n闻君去仪曹，五马行翩翩。\n缅怀古单父，高堂坐鸣弦。\n政理日以媮，宝此千载贤。\n矧此荐岁饥，夏潦仍相缘。\n嗷嗷东南州，流移踵车船。\n死者相枕藉，羸瘠甘弃捐。\n民命悬守令，壅遏谁当怜？\n君怀策世才，往哉寄承宣。\n譬彼善牧者，鞭击非所先。\n戴星亦有人，何乃任力专。\n凄凉二子远，故老应相传。\n我昔尝经游，土风尚熙然。\n回河抱阡陌，桑麻绿浮烟。\n岂无稌稻区，草木纷华妍。\n维兹重责任，慎彼浇俗迁。\n会徵太史书，家声振当年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和袁伯长冬至燕集韵","author":"贡奎","text":"黄钟起葭琯，王树华宝宴。\n清交寡常流，铿辞表时彦。\n盈盈劝浮蛆，袅袅簪綵燕。\n雅服称仪新，嘉蔬列乡荐。\n香销神用舒，棋覆心罢战。\n培花候奇识，煮茗遂清咽。\n虚幌云度英，空檐冰落线。\n永言悦书玩，亦岂慕盘馔。\n尘踪合浮萍，芳岁惜流箭。\n念此远道逢，□人久怀羡。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日陪大学士赵公憩龙山玄真宫","author":"贡奎","text":"岩岩居庸关，左挟飞仙居。\n苍茫四山合，石径穿盘纡。\n人家稍相接，林木何森敷。\n觚棱生晓烟，玄风凌紫虚。\n念彼羽流集，岂与世俗俱。\n溪流转云碾，馀润分园蔬。\n钟磬荅空谷，斋供荐芳腴。\n穹碑纪宗传，道一教乃殊。\n素餐贵崇本，卒岁事耕锄。\n渔父在何许？\n空有桃花株。\n坐惭秉文干，尸禄常旷迂。\n日暮陟层巅，丹霞成长裾。\n遥睇空中云，超然能卷舒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登齐山","author":"贡奎","text":"出郭行五里，落日众山赤。\n中环翠凝峦，秀色起千尺。\n风流杜牧守，壮语镌妙画。\n我来严冬初，俯仰一今昔。\n人烟久变故，鬼怪据幽僻。\n披丛得小径，往来遭折屐。\n乱石排犬牙，荒洞泯龙迹。\n空馀岩前碑，雨日自淋炙。\n黄花既非时，何以供太白。\n但须历层巅，一笑天地窄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荼蘼架","author":"贡奎","text":"西园检春事，积雨断馀红。\n荼蘼压高架，皎皎晚日烘。\n翠蔓点残雪，清香度微风。\n幽人对之坐，瑩然此心同。\n徘徊不忍去，片月来高空。\n宛如万玉娥，素袖舞云中。\n珠玑露颗缀，翠佩烟光笼。\n爱花不受折，枝柔刺盈丛。\n携酒醉其下，慰此良夜终。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿凤口会九万兄","author":"贡奎","text":"扁舟下沧溟，日暮浮云散。\n青山衮衮随，十里行不断。\n古廛集人烟，舣缆临绝岸。\n谁知兄弟情，邂逅忽相见。\n篙师轻波澜，呼啸惊夜半。\n贪程虑涉险，欲往还自算。\n推篷视天宇，白露下凌乱。\n众星亦已没，落月破微暗。\n念此局促身，倏然重三叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]