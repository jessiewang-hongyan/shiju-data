[{"title":"鲋鱼辞","author":"耶律铸","text":"鲋托微波致微意，上自蛟龙至鲟鲤。\n今虽得百万江湖，宁比当时斗筲水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"日将出","author":"耶律铸","text":"阴云夜合乾坤失，万象不能分别得。\n苍凉海底浴重光，却与行人指南北。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五将行","author":"耶律铸","text":"螣蛇游雾相乘势，龙举云兴相借力。\n致使云消雾散时，要似枯鱼过江泣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋莲怨","author":"耶律铸","text":"红衣乱委鸳鸯浦，罗袜尘消水仙府。\n凝情照景竟无言，应惜芳心为谁苦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松声","author":"耶律铸","text":"风低满地蛟龙走，风高万壑龙蛇吼。\n苍苍元是岁寒姿，休错思量比蒲柳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五禽咏 其一 大麦孰簸箕漏","author":"耶律铸","text":"小麦青青大麦黄，野老啼饥空绕肠。\n感大麦孰簸箕漏，惆怅无由除秕糠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五禽咏 其二 麦饭孰即快活","author":"耶律铸","text":"长安米贵不易居，粒粒皆比明月珠。\n彼麦饭孰即快活，宁知西山有饿夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五禽咏 其三 提葫芦沽美酒","author":"耶律铸","text":"黄垆邈若山与河，人生安乐孰如他。\n为提葫芦沽美酒，快唤灵均听浩歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五禽咏 其四 烧香拨火","author":"耶律铸","text":"烧香拨火情发衷，心知有愿天必从。\n千声万声祷何事，应祷时和将岁丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五禽咏 其五 不如归去","author":"耶律铸","text":"不如归去不如归，吻裂血啼谁汝知。\n便休也把春催去，就去万花深处飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲蝶","author":"耶律铸","text":"莫疑庄喜知为蝶，且恐韩凭有化身。\n䝼取一生花里活，未宜随定卖花人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立秋前一日","author":"耶律铸","text":"大火西流暑气回，青蝇心绪已徘徊。\n人言明日新消息，天外秋风刮地来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蛙吹","author":"耶律铸","text":"两部难分曲调名，莫疑喧聒是蛙鸣。\n谁能碧草清泉上，受用仪同鼓吹声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"揽镜","author":"耶律铸","text":"月让清光日让圆，翠鸾伏背浸琼筵。\n明知富贵自来逼，谁不更教长少年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听苗君弹琴","author":"耶律铸","text":"一溪流水漱成冰，六马嘘天四座倾。\n未是幽人堪动处，试听徽外两三声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听琵琶二首 其一","author":"耶律铸","text":"惊沙槭槭亦纷纷，不觉清霜满鬓根。\n寒雁似啼还似说，试临穷发望乌孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听琵琶二首 其二","author":"耶律铸","text":"冷风搜雨雁呼群，点点鸣鸦入暮云。\n何事荒寒千万劫，野人甘忍怨昭君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔父叹","author":"耶律铸","text":"直钩钓鳌良可叹，片网图龙真绝痴。\n往来江上人无限，鼓掌笑君君不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"御床","author":"耶律铸","text":"万国趋观上国光，先皇临御是明堂。\n鼎湖龙去无回日，更好教人惜此床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大猎诗二首 其一","author":"耶律铸","text":"营表交驰突骑过，射声云布已星罗。\n诏官点检貔貅数，奏比年来百万多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大猎诗二首 其二","author":"耶律铸","text":"网络周阹万里疆，幅员都是禁围场。\n传言羽猎将来到，有诏唯教静虎狼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行帐八珍诗四首 其一 醍醐","author":"耶律铸","text":"众珍弹压倒淳熬，甘分教人号老饕。\n饕大名非痴醉事，待持杯酒更持螯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行帐八珍诗四首 其二 麆沆","author":"耶律铸","text":"玉汁温醇体自然，宛然灵液漱甘泉。\n要知天乳流膏露，天也分甘与酒仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行帐八珍诗四首 其三 驼蹄羹","author":"耶律铸","text":"独擅千金济美名，夤缘遗味更腾声。\n不应也许教人道，众口难调傅说羹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行帐八珍诗四首 其四 驼鹿唇","author":"耶律铸","text":"麟脯谁教冠八珍，不甘腾口说猩唇。\n终将此意须通问，曾是调和玉鼎人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"软玉膏","author":"耶律铸","text":"赤髓薰蒸软玉膏，不消割切与煎熬。\n是须更可教人笑，负鼎徘徊困鼓刀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行厨","author":"耶律铸","text":"已去取温金鳌酒，还来请煮玉蝉羹。\n未妨门外令三老，长是帘前报五更。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发清冷泉戏题行厨家僮名三老者","author":"耶律铸","text":"玉液应期养圣胎，万花仙供为人开。\n祇从六甲行厨里，径就行窝卒去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茶后偶题","author":"耶律铸","text":"嫩香新汲井华调，簪脚浮花椀面高。\n饮罢酒醒江上月，依稀瀛酒一游遨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重和惜春诗韵余时经始西园 其一","author":"耶律铸","text":"到底总输开口笑，未妨教效捧心颦。\n壶中日月杯中酒，只属莺花旧主人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重和惜春诗韵余时经始西园 其二","author":"耶律铸","text":"握月担风留后日，吞花卧酒莫过时。\n请君但就溪堂上，更试沈吟味此辞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和曹南湖故宫二首 其一","author":"耶律铸","text":"练杀声歌不练兵，霸图应自恃长城。\n水流花落将春去，三十六宫空月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和曹南湖故宫二首 其二","author":"耶律铸","text":"香生罗绮纷生光，天上人间白日长。\n流水浮云春梦断，夕阳空满旧缭墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人台城","author":"耶律铸","text":"天下纷纷经几秦，六朝风物问无因。\n旧时王谢堂前燕，飞入宫墙不见人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人池亭秋宵思归","author":"耶律铸","text":"风定清烟冷自消，月明秋水浸兰桡。\n归心不与游尘息，空混沧波影动摇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和德卿秋日海棠","author":"耶律铸","text":"马嵬别后若为容，犹带宫妆醉晕红。\n把恨付春春不管，似将馀恨托西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人茶后有怀友人","author":"耶律铸","text":"玉瓯盈溢仙人掌，云脚浮花雪面堆。\n两腋清风归不去，为谁吹上句楼来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和光祖","author":"耶律铸","text":"诗篇足继晋名流，几度思君倚寺楼。\n十载龙庭归不得，玉泉何日更同游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人韵二首 其一","author":"耶律铸","text":"十分著意送春来，远近人家花尽开。\n多谢东君无彼此，笙歌休放紫霞杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和人韵二首 其二","author":"耶律铸","text":"忠臣四海年来少，谗佞满朝日更多。\n洒泪问天天不语，不知天意果如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日席上次高丽国使新安公诗韵二首 其一","author":"耶律铸","text":"绿杨飞尽山城雪，花影满帘春日迟。\n事异势殊春是旧，化工著意几曾私。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日席上次高丽国使新安公诗韵二首 其二","author":"耶律铸","text":"从来造物閒相弄，自在翻腾梦里身。\n人事不知天意思，欲回天地一时春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩春思诗韵","author":"耶律铸","text":"惜春弥月醉高楼，不放闲人到上头。\n桃李乱随流水去，满城风雨替莺愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次卢希谢冬日桃花诗韵","author":"耶律铸","text":"严风猎猎雪成堆，一夜桃花满院开。\n春自不知谁著力，九重天上挽回来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩诗韵 其一","author":"耶律铸","text":"读书学剑两无成，牢落无由话此情。\n闻道太平公事了，蓬窗閒杀老书生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩诗韵 其二","author":"耶律铸","text":"寄语幽都君子儒，年来活计道人居。\n而今扰扰封侯辈，大剑长枪不读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩诗韵 其三","author":"耶律铸","text":"玉泉泉下有鱼龙，风起波涛沧海同。\n自是鱼龙无意出，月明愁杀钓鱼翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩过玉泉怀古韵 其一","author":"耶律铸","text":"绿回芳草春长在，梦与浮云一段空。\n休向玉泉悲故国，咸阳无处问秦宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次赵虎岩过玉泉怀古韵 其二","author":"耶律铸","text":"路僻山荒碧草迷，行人惆怅马频嘶。\n当时楼观寻无处，落日疏林鸦乱啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复次过玉泉诗韵四首 其一","author":"耶律铸","text":"玉泉佳景昔人传，近筑幽居碧水前。\n他日卜邻无我弃，竹篱茅舍好相连。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复次过玉泉诗韵四首 其二","author":"耶律铸","text":"玉梅清浅野梅疏，驿路尘空未得书。\n独坐穷庐情味恶，漫吟新句寄双鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复次过玉泉诗韵四首 其三","author":"耶律铸","text":"客梦时时绕玉泉，碧山无数锁苍烟。\n君恩未报归难得，且向龙沙待数年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复次过玉泉诗韵四首 其四","author":"耶律铸","text":"广文寥落客幽都，我在天涯亦隐居。\n料得因循浑忘却，数年不寄一封书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟回文 其一","author":"耶律铸","text":"诗成怨立小桥西，晚日春怀伤鸟啼。\n离别书情多寄恨，远山高处暮云低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟回文 其二","author":"耶律铸","text":"楼上独来心上愁，泪垂难道不肠柔。\n秋深夜雨风回梦，烛剪空窗暗燄浮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即日拟乐天作","author":"耶律铸","text":"从臾新交与旧游，编排酒令与诗筹。\n但言误及功名事，便索荒唐改话头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答客问","author":"耶律铸","text":"是佛尽居安乐国，无仙不住没愁乡。\n听教共献天花供，更管清明分外香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"继韵为答","author":"耶律铸","text":"日日浮沈卖酒家，不知寒力战风沙。\n又谁知道新春色，开到南枝弟几花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答李仲玉白发叹","author":"耶律铸","text":"功名江海一浮沤，赚得英雄雪白头。\n日月如飞留不住，雁行山色又横秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠御史","author":"耶律铸","text":"四海嗷嗷属望声，绣衣直指下天庭。\n好将罗隐秋虫赋，自此书为座右铭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏赠隐士刘仲明","author":"耶律铸","text":"爱仙无药可登云，爱酒无钱可计春。\n只说南山有佳处，如何犹自是闲人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日行次池上戏赠钓者","author":"耶律铸","text":"垂白穷居野水滨，祇疑秋水是龙津。\n神龟己死三千岁，何事持竿不顾人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重醉修真宫鍊师","author":"耶律铸","text":"玉检素书鱼附去，锦笺瑶句凤衔来。\n桃花流水长春洞，也望群仙许再开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读书楼赠道士","author":"耶律铸","text":"道本无名莫强名，在人呈露自然情。\n楼头山色门前水，不是天公彩画成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为阅俳优诸相赠优歌道士","author":"耶律铸","text":"一曲春风踏踏歌，月光明似镜新磨。\n谁游碧落骑鸾凤，记姓蓝人是彩和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"近体隔句赠人","author":"耶律铸","text":"不知何事伤游子，漫折閒花尽日吟。\n转觉忘机是啼鸟，静依芳草说春心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏诸公省集","author":"耶律铸","text":"万事人生前已定，须知祸福不由人。\n谁怜四海生灵望，浪著閒钱问鬼神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送许大用还浑水","author":"耶律铸","text":"临歧促我送行诗，信笔成诗送子归。\n望断碧云天不尽，西风残日雁南飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘仲素行","author":"耶律铸","text":"积雪凝云失远岑，西风千里暗惊心。\n送君归去寒山外，寂寞归来独怅吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用辅之送晋之诗韵","author":"耶律铸","text":"执手溪边酒一杯，羡君归路过金台。\n因风寄语能诗客，囊里新诗早寄来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王彦高","author":"耶律铸","text":"世閒无物可劳神，风外浮云陌上尘。\n还笑凤凰城下柳，长条不解挽行人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送焦宝国","author":"耶律铸","text":"云压荒凉塞树依，倚楼停酒望君归。\n一天风雪晚来定，冻合乾坤鸟不飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王君璋","author":"耶律铸","text":"半岭斜阳天淡淡，一川衰草角悠悠。\n云山望断中州远，衰草斜阳满目愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送侯君美","author":"耶律铸","text":"塞鸿不度暮声哀，况复分襟把一杯。\n望断野云人不见，满天风雪下高台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送丁仲华","author":"耶律铸","text":"归旆翩翩挽不留，别离诗思为君求。\n西风落日重回首，何处青山是宿头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人回游江南","author":"耶律铸","text":"就花便买金钗涧，纵酒休颓玉斗山。\n须信人生行乐耳，此行莫问几时还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送行人二首 其一","author":"耶律铸","text":"十年鞍马往来程，学剑读书两不成。\n故国英雄应笑我，苦吟佳句送人行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送行人二首 其二","author":"耶律铸","text":"经过离亭知几度，从前端的一千场。\n只疑折尽无情柳，不意东风吹又长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送田鍊师行","author":"耶律铸","text":"从侄三山相见稀，又驰云驾几时归。\n杨花不领东风管，到处将春自在飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]