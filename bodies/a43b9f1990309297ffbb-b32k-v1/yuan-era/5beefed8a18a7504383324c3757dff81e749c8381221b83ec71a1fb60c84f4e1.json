[{"title":"陈母张安人挽辞","author":"郑元祐","text":"延陵陈母具柔慈，训子成名鬓亦丝。\n楼护起家元自蚤，冯勤补衮不嫌迟。\n旨甘每却熬波味，燕飨长怀剪发思。\n未拜恩封先已没，后来阡表有馀悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽杨九玄","author":"郑元祐","text":"虎丘山下有孤坟，曾识谭经杨子云。\n梦落江湖仍听雨，魂归泉壤亦修文。\n家山路远听猿泪，书传香留辟蠹芸。\n况有佳儿能力学，草玄犹足继前闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宾月楼","author":"郑元祐","text":"最爱香山宾月楼，清光全得太湖秋。\n鱼龙出向初筵舞，蟾兔来从上客游。\n凝阁绿苔须士赋，委波金镜属谁收？\n江山千古才情在，牛渚何人独献酬？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"知音亭","author":"郑元祐","text":"亭院日长深复深，高山流水思愔愔。\n曲中别鹤啼清怨，树底薰风养绿阴。\n激楚忽闻机裂帛，怀人又见冶镕金。\n能言万籁无南郭，隐几形闲孰赏音？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听雨楼","author":"郑元祐","text":"每爱沧江听雨眠，不应愁绝似今年。\n建瓴长恐崩高屋，鍊石徒闻补漏天。\n响入北廊葭菼乱，湿增傍壁薜萝牵。\n白头倦客孤蓬底，尚想躬耕有石田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵季文茶屋","author":"郑元祐","text":"萧萧茶屋傍池开，谩谩丛筠带雨栽。\n窗雪晃晴鸡误唱，炊烟带暝鹤归来。\n醉酒烧烛亲黄卷，静爱飞花点绿苔。\n尊酒久违真寂寞，鹧鸪啼上越王台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"薛玄卿鹤斋","author":"郑元祐","text":"君家少保已登云，留得青田貌后真。\n乌母督仙须显驾，羽车骖乘必长人。\n听经香案孤撑雪，啄菌瑶阶每遇春。\n迟子吹笙明月下，丹砂乞与顶头巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵寄颜元卿院判","author":"郑元祐","text":"酒尽空悬蘸甲瓢，一灯孤馆夜寥寥。\n雁寒犹下沧洲宿，地暖何由重雾消？\n长笛一声推赵嘏，衮衣三世属文饶。\n看云早晚摩天翼，瞥尔青云万里遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄泰兼善总制","author":"郑元祐","text":"征凤鲜于专节制，戮鲸王式任偏裨。\n长江谩击中流楫，落日方悬大将旗。\n夜泣寒机嫠掷纬，朝妆明镜女扬眉。\n丈夫身在难乾没，三秀煌煌是紫芝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴宗师，寄张贞居","author":"郑元祐","text":"齐老堂前烟树空，真人锡类坐神宫。\n一缣今赉高年帛，重壤惊回秃发翁。\n琳馆花残春欲雨，石坛松老夜多风。\n遥思问道崆峒处，都在衢尊盎盎中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵薛真人贺吴宗师寿辰","author":"郑元祐","text":"臣工袒割紫鳞肪，辞藻辉飞白玉堂。\n五色云中扶日毂，九霞杯里酌天浆。\n又从禹范开皇极，重拾尧蓂纪岁阳。\n古桂长承新雨露，绵绵根柢发天香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿春官达郎中","author":"郑元祐","text":"清油幕下紫薇开，身总群纲儗上台。\n桂海已闻京观筑，越裳还见贡琛来。\n诗书未与秋摇落，刀尺难从世剸裁。\n廊庙栋梁须致用，贞松合抱是良材。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王季野北归二首 其一","author":"郑元祐","text":"黑发黄髯万里归，腰如开国待犀围。\n楼前花似琴台发，江上鱼如丙穴肥。\n蛮井远民茶税急，槐阴燕席酒觥飞。\n名勋莫负传家笏，六尺青云立绣衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王季野北归二首 其二","author":"郑元祐","text":"公子承恩日下归，小山堂上锦香围。\n百壶写渌方论醉，五鼎熬肪不厌肥。\n听瑟池鱼冲浪出，寄书笼鹤傍云飞。\n茜袍色映轻裘好，为是夫人手制衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁暮感事","author":"郑元祐","text":"岁除风雪苦阴寒，民庶逋租悉系官。\n破荡未充狼虎欲，系累只作马牛看。\n何人肯破杨城械？\n有客空弹贡禹冠。\n上力已穷民力瘁，腐儒头白泪阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"范魏公祠","author":"郑元祐","text":"白云乡里魏公祠，翼翼烝尝荐奠时。\n功盖百年书史载，道求千古圣贤知。\n山侵虎穴盘风磴，石拔鲸牙插羽旗。\n更上高亭望城邑，义田秋实正离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙门","author":"郑元祐","text":"龙门岞崿倚天开，点额神鱼几度来？\n云起区中成五色，星从阙角见三台。\n更无铁限嗤山鬼，可有金铺上石苔？\n李范党同勋业异，御车千古意悠哉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天池","author":"郑元祐","text":"立石如云不待鞭，兀临池水看青天。\n下潜灵物疑无底，傍溉山畦似有年。\n刺水翠苗霜后在，舞风珠树月中悬。\n太湖万顷应凡浊，閟此泓渟一勺泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄郑长卿","author":"郑元祐","text":"吾宗自昔有升沈，况复姬嬴远至今。\n世讶孙枝发枯蘖，人推祖德返遗金。\n螭头未必云萦佩，谷口何嫌雪满簪？\n自恨衰年多病苦，药囊时乞细探寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿李廉使","author":"郑元祐","text":"立秋三日是生申，督饟功高海若驯。\n金节已悬岩下电，绣衣仍应日边春。\n久从隶古森波磔，复向心源揖圣神。\n野老愿留吴下住，一新漕政答鸿钧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄于彦成高士","author":"郑元祐","text":"文锋久淬鸊鹈膏，鞍甲藏身百战鏖。\n王簿宅前春载酒，李绅祠下醉挥毫。\n乡关未觉东林远，光焰终如北斗高。\n儒老感君难报称，黄金随力铸韦皋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郝遵道北归","author":"郑元祐","text":"汴河千里雁南飞，吴下孤帆又北。\n归竹素残编无世味，蒯缑孤剑有星辉。\n岧峣使节弓旌近，迤逦神州草木稀。\n想见琼轩恭对日，黄金台上雪霏霏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刘宪副春日湖上有感五首 其一","author":"郑元祐","text":"庾信哀多赋漫成，江南文物久晨星。\n市衢火后蒿横目，民舍春来草满庭。\n浪齧湖堤官柳尽，沙填江浦夜潮腥。\n归来何异辽东鹤，只有西山慰眼青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刘宪副春日湖上有感五首 其二","author":"郑元祐","text":"湖水西边旧是家，春风绕屋种梅花。\n传闻故老谈前日，爱教仙人服幼霞。\n鹤老离巢松化石，鸾孤照水竹穿沙。\n只今重到经行处，憔悴萧郎两鬓华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刘宪副春日湖上有感五首 其三","author":"郑元祐","text":"潮落空城谁重过，犹馀里耳听鸣珂。\n襄阳耆旧知谁在？\n江左风流不厌多。\n自见石麟眠枳棘，长闻蜀魄叫松萝。\n野梅开尽西湖雪，万斛春愁奈尔何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刘宪副春日湖上有感五首 其四","author":"郑元祐","text":"湖水荒荒寒食天，相逢犹话国初年。\n红楼夜唱花间席，翠管春吹月下船。\n玄圃自应留富丽，湘云谁为惜清妍？\n可怜头白归来日，井邑凄凉蔼白烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵刘宪副春日湖上有感五首 其五","author":"郑元祐","text":"青苔寺里客来稀，乌石冈边僧自归。\n金雁嘈云春不去，玉鱼冲雨夜曾飞。\n出门每歌月皎皎，制佩莫惜芳菲菲。\n人世何由比金石？\n嗟我欲把东皇衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵钱伯行游仙诗二首 其一","author":"郑元祐","text":"海定初风湛绿罗，仙人词藻寄来多。\n贯珠音在云谁遏？\n琢玉文成手自磨。\n霄汉画桥尝有会，昆崙黄竹漫成歌。\n可怜人世书裙手，池上犹笼道士鹅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵钱伯行游仙诗二首 其二","author":"郑元祐","text":"轧轧青牛拟度沙，煌煌白兔岂无家？\n肉生徐甲符难秘，斧钝吴刚桂始华。\n谛授宝书盟刻玉，醉离瑶席舞传葩。\n竹宫望拜真痴绝，日日韶光在景霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送章心远道士入闽兼简杜清碧先生","author":"郑元祐","text":"风日晴缫杨柳青，翩然独鹤过南溟。\n山中每忆罗公远，海上重逢武达灵。\n榕叶拥云山似簇，蛎房烹玉酒初醒。\n小冠子夏如相问，为道穷愁老一经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘宗师入觐，次虞学士韵","author":"郑元祐","text":"羽轮暂别大茅峰，又御青冥万里风。\n月帔引朝宣德殿，云韶赐宴集灵宫。\n悬知汉室龙颜主，似见商岩鹤发翁。\n便使图形在麟阁，闲心只爱白云中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘年基高士还江东，兼柬张一无二首 其一","author":"郑元祐","text":"剑寒秋水客东归，堂上慈亲白发稀。\n棂具定无璊玉璏，线痕犹是紫烟衣。\n蜂营崖蜜花争发，鹿养春茸蕨正肥。\n自古山林有甘脆，何妨物色报春晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘年基高士还江东，兼柬张一无二首 其二","author":"郑元祐","text":"为问江东张道士，著书还了致桑篇？\n江湖冷落番君老，云汉昭回象帝先。\n芋火夜煨霜后叶，菜庖朝汲涧中泉。\n相依共住知何日？\n孤鹤东还意惘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄贞居张儒仙","author":"郑元祐","text":"露冷玄洲草木疏，砚泉分得涧循除。\n钩题石记脩人表，笔削山经作志书。\n丹鼎晓温松节酒，茗瓯春点菊苗菹。\n残骸若有登真分，亦欲西游候羽车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简张仲举待制","author":"郑元祐","text":"宵占两两使星东，川后迎恩启閟宫。\n海上天灯悬宝月，帷中神语飒冷风。\n云团芝盖香烟直，春入衢尊酒味同。\n况是词臣工致祝，鲸波永息岁恒丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送钱思复之东嘉","author":"郑元祐","text":"校官东上斗城时，水落高滩舟楫迟。\n造化纵凭修月斧，文章须是表忠碑。\n斋庖近昼空弹铗，诗说穷源屡解颐。\n来岁秋闱战仍捷，桂林折取最高枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠柯敬仲，次王止善韵","author":"郑元祐","text":"楚天鸿雁白云秋，归卧沧江看水流。\n莫问湘累王子宿，且同新息贾胡留。\n山林不返趋朝梦，道路难为筑室谋。\n莫遣虹光贯明月，眠波帖下有沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜雪寄达监司，次寿道韵二首 其一","author":"郑元祐","text":"去年南国暖如蒸，岁尽犹多扑缘蝇。\n直恐蛇神司有厉，可须麟笔纪无冰。\n元勋复相调金铉，稔岁恒占应玉绳。\n伫听赓歌继豳雅，万年枝上日东升。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜雪寄达监司，次寿道韵二首 其二","author":"郑元祐","text":"正自风流歌白雪，何须辛苦赋青蝇？\n成章雾豹方依穴，鼓枻神鱼欲上冰。\n剑具寒侵璊玉璏，宫悬冻直綵绒绳。\n枯鳞望活西江水，涸辙何因有斗升？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钓月","author":"郑元祐","text":"籊竹裁竿拂帝青，山河影里夜亭亭。\n坐乾草际沾衣露，掣得波间在罶星。\n巨犗可应投贝阙，长丝便欲系天经。\n清光照彻磻溪叟，方看霓裳舞广庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧桐月","author":"郑元祐","text":"露下秋阴洗夜光，辘轳哀响度银床。\n苍龙出井献沉璧，青女抱琴弹履霜。\n鹊绕暗知河汉近，凤栖明见羽毛张。\n宝钗击罢宫娥老，一曲霓裳泪数行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李秀才归越","author":"郑元祐","text":"蹑屩东归度浙河，越山无数绾青螺。\n森森南国春秋学，袅袅西风子夜歌。\n潮涌月轮丹桂近，山环亲舍白云多。\n明年春捷灵光殿，远听鸣驺驻玉珂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠朱君复秀士","author":"郑元祐","text":"松陵驿里雨骚骚，剪拂谁甄汗马劳？\n扁石呼儿朝授简，疏棂启帙夜焚膏。\n不因圣药无熊胆，每为神山有凤毛。\n老我江湖读书眼，会看攀桂月轮高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送白治中之徽州","author":"郑元祐","text":"高下溪声三百滩，好山高入帝青寒。\n雄藩择牧金投冶，别驾行春锦覆鞍。\n茶焙香销芽尚采，砚坑云冷石仍刓。\n残民久望诗书泽，阙里遗编墨未乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽顺义贞惠公","author":"郑元祐","text":"朔汉人豪贞惠公，策勋元自不酬功。\n自从虎旅平南服，眼见龙旗捲北风。\n庭有芝兰更种植，老登槐棘保初终。\n只今太史修臣传，应有幽光发閟宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵吴宗师题大涤洞郎师房","author":"郑元祐","text":"一庵闲地足神仙，能驻人间大小年。\n赤鲩夜飞丹井月，紫鸾春步术苗田。\n山经我欲紬金匮，昼漏时闻滴宝莲。\n便驾飙轮上天柱，不辞身倚帝青边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄宛丘赵祭酒","author":"郑元祐","text":"当阳圣主重师臣，妙选儒宗赞大钧。\n神格西廱夔典乐，名高北斗愈垂绅。\n金绳著钮编珠贝，瑶草纾花毓凤麟。\n老我钓纶江海上，烟波空爱白鸥驯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题海运省官卷","author":"郑元祐","text":"省幕分贤佐上台，参模须仗出群材。\n九年鹏翼乘云上，万斛龙骧破浪开。\n已见清风生白简，便朝红日诣金台。\n美哉王度关元化，政藉群公翊戴来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢刘廷干漕使馈肉","author":"郑元祐","text":"琐屑鱼虾不厌腥，惊闻一脔到斋扃。\n荠肠久断闻韶味，蒿目愁看在罶星。\n破履尚图儿致养，解颐空对客谈经。\n西风峭急江湖晚，何处充饥有楚萍？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王本斋参政挽辞","author":"郑元祐","text":"甘棠港口咽寒潮，帝促明公黼衮朝。\n已有旗常昭日月，却骑箕尾上云霄。\n北风吸歘年华尽，南国凄凉士气销。\n便欲一为天下恸，英魂不用楚词招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钟绍京书灵飞经","author":"郑元祐","text":"匣里钟郎六甲经，虹光夜夜射天星。\n使来海上持龙节，驾下云端拾凤翎。\n金母度祠黄帝录，玉真按笔紫皇听。\n勤修苦炼资轻举，濯足明河上九青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简金伯祥高士","author":"郑元祐","text":"瞻云西迈思悠然，过雨群峰紫翠连。\n儿子劬书能继业，羽人接袂且谈玄。\n可无海上安期枣，更有山头太华莲。\n便驾飙轮脱尘网，劫灰不到郁蓝天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠张月庭道士","author":"郑元祐","text":"为爱中庭月一方，坐看河汉转苍苍。\n山河影在无圆缺，漏刻声中有短长。\n灵药杵风金兔伏，桂花霏雪綵鸾翔。\n广寒原是栖真地，歌引霓裳入醉乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次倪元镇韵，寄刚中","author":"郑元祐","text":"缥缈陈王湖里寺，琮琤郑老竹间棋。\n每因海月参心镜，却笑茶烟袅鬓丝。\n墨渍尚嗔龙尾滑，酒酣方忆虎头痴。\n论文未极终宵话，且让韩山一片碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和潘子素宿倪元镇宅，送张贞居还茅山","author":"郑元祐","text":"扣舷溪子发阳阿，落叶霜林见鸟窠。\n清閟阁前春意早，萧梁台上月明多。\n倾瞻鸣雁嵇中散，仰视飞鸢马伏波。\n对酒息思千古事，潘郎刺促为谁歌？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭州即事二首 其一","author":"郑元祐","text":"瓦砾堆堆塞路坳，胜游巷陌尽蓬蒿。\n祠宫地卧驼鸣?，秘殿春扃马矢臊。\n山色无如今度惨，潮头可似昔时高？\n王师贵在能安集，岂必兵行血渍刀？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭州即事二首 其二","author":"郑元祐","text":"往来都是石尤风，身境俱忘逆顺同。\n镜里转增双鬓白，花前仍是小桃红。\n莫惊天地军麾满，尚喜江湖客棹通。\n杨柳吹绵春又暮，赋诗愁杀杜陵翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵怀钱塘","author":"陈旅","text":"武帝亲祠太乙神，流光汹旭动星辰。\n行宫典礼犹存汉，轵道山河已易秦。\n香径至今啼木客，露盘无复泣金人。\n红灯几点东风里，犹是元宵一度春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元宵怀钱塘二首 其二","author":"郑元祐","text":"钱唐江上雪初晴，鳷鹊楼前月正明。\n万炬金莲开火树，六龙翠辔降瑶京。\n箫韶并入钧天奏，宫掖欢闻下土声。\n犹是向来歌舞地，鬼灯寒雨暗荒城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送萧万户西归","author":"郑元祐","text":"将军旗鼓镇西州，六诏猖狂一战收。\n馀墨朝犹磨楯鼻，重环夜已附刀头。\n归朝却献王褒颂，去国惟存季子裘。\n醉里相逢歌按剑，沧江斜日水悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答玉山二首 其一","author":"郑元祐","text":"扁舟不乱白鸥群，又复移家入水云。\n载酒可无人问字？\n挥毫故有客书裙。\n荒凉汉室铜盘泪，剥落周宣石鼓文。\n犹藉顾循能慰籍，江湖冷落见番君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答玉山二首 其二","author":"郑元祐","text":"谁似廱侯孙子贤，宴宾歌舞斗清妍。\n门前岸脚占潮讯，苇里拿音候客船。\n海气若浮山隐玉，野光纯净月当川。\n人生得意须行乐，莫遣闲愁到酒边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠岑医士","author":"郑元祐","text":"经络多岐脉贯身，颠崖性命属谁伸？\n如生独得岐黄秘，起死能兼郭华神。\n龙献古方长系肘，虎巡熟杏不伤人。\n悬知此道无疵吝，花发莺啼到处春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]