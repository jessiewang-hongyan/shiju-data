[{"title":"画 其一","author":"凌云翰","text":"寻源幽涧长往，倚杖斜阳未还。\n桥下潺潺春水，和云流出空山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其二","author":"凌云翰","text":"春日村村花柳，人家处处桑麻。\n小艇却寻溪转，好山不用云遮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其三","author":"凌云翰","text":"小艇东去西去，长江朝流暮流。\n笑入芦花深处，清风明月悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其四","author":"凌云翰","text":"问讯南屏隐者，草堂竹树谁栽。\n昨夜何时雨过，山禽几个飞来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其五","author":"凌云翰","text":"长松落落千丈，大厦渠渠万间。\n应笑樗材拥肿，等闲空老深山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其六","author":"凌云翰","text":"童子携瓶沽酒，仆夫汲水煎茶。\n坐对青山扪虱，不妨终老烟霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画 其七","author":"凌云翰","text":"石上悠然独酌，空山谁与相亲。\n满目长松流水，安知不是佳宾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦墨竹  其一 雨竹","author":"凌云翰","text":"阴浓愈觉重叠，翠湿何曾动摇。\n静里试听馀韵，评来清胜芭蕉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦墨竹  其二 晴竹","author":"凌云翰","text":"新篁解箨春尽，畏日移阴昼长。\n一枕南薰破梦，时闻粉节吹香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦墨竹  其三 风竹","author":"凌云翰","text":"紫极宫中暂宿，黄陵庙下曾行。\n一夜洞庭木落，打窗都是秋声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高士谦墨竹  其四 雪竹","author":"凌云翰","text":"天寒翠袖正薄，月满琼枝又新。\n祗恐凤凰巢冷，截筒吹转阳春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅","author":"凌云翰","text":"乱插繁花晴昊，不禁冷蕊疏枝。\n江树垂垂又发，无声总是新诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双松独步图","author":"凌云翰","text":"高士清癯比鹤，长松夭矫犹龙。\n如在山阴道上，经行万壑千峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹 其一","author":"凌云翰","text":"笔下筼筜有谷，胸中清渭成川。\n为问湖州老可，何如赤壁坡仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹 其二","author":"凌云翰","text":"山童偶敲茶臼，野老闲歌竹枯。\n明月不离襟袖，好风都在蒲葵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"墨竹 其三","author":"凌云翰","text":"墨君写以老可，石丈拜之来颠。\n何似王维高适，一时诗崡同传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枯木竹石","author":"凌云翰","text":"脩篁美如君子，古木秀似衰翁。\n赖有米家石丈，挥毫正待南宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林子山画二首 其一 春山趣游","author":"凌云翰","text":"蹇驴随意踏苍苔，行到溪桥首重回。\n想得山家春尚早，过墙桃李未全开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林子山画二首 其二 秋江意钓","author":"凌云翰","text":"雨过矶头流水香，水深更放钓丝长。\n分明一段江南意，枫叶芦花共夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沈思礼画 其一","author":"凌云翰","text":"渔在江湖樵在林，相逢肯信有机心。\n沙鸥尚未能忘我，飞过云山不可寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沈思礼画 其二","author":"凌云翰","text":"隔水楼台映翠微，山桃风暖欲花飞。\n一溪春水深无主，却被诗人载得归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨生溪居图","author":"凌云翰","text":"满眼溪山庵尽开，草玄亭子半荒苔。\n如何秪写渔家意，不及扁舟载酒来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阎仲彬墨菊","author":"凌云翰","text":"立本丹青不自誇，戏拈秃笔写秋花。\n秪疑风雨重阳日，夜访柴桑处士家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次徐总制韵 其一","author":"凌云翰","text":"柳绕沙堤花绕城，千门万户赏春晴。\n谁知画戟凝香处，人与湖山一样清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次徐总制韵 其二","author":"凌云翰","text":"燕子来时花满城，海棠丝雨半笼晴。\n行人最爱西湖水，流入官河也自清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙生二画 其一 槐安国","author":"凌云翰","text":"木槐为国竟如何，梦境浑如世事多。\n老我久无名利念，笈看行蚁上南柯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孙生二画 其二 竹叶舟","author":"凌云翰","text":"长安流落嗼途穷，一叶归舟便向东。\n咫尺图中能缩地，秪疑山叟是壶公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"破窑图","author":"凌云翰","text":"日暮归来雪已深，破窑无奈夜沉沉。\n谁知拨尽寒炉火，鍊出经纶一片心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"并入易履墨菊","author":"凌云翰","text":"写到黄花韵更高，墨池秋水染鹅毛。\n幽香一掬谁分得，知是并州快剪刀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春色","author":"凌云翰","text":"寒不能生暖不消，融融转觉望中遥。\n东皇富贵谁能识，尽把黄金铸柳条。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"草堂图","author":"凌云翰","text":"锦江玉垒入霜毫，亦有人家荫白茅。\n道是草堂元来信，秪因梅柳是西郊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贾岛推敲图","author":"凌云翰","text":"蹇驴随处恣游遨，京兆相逢即定交。\n看取古人三百首，工夫元不在推敲。","collection":"元","notice":"","provenance":{"repo":"