[{"title":"过高邮射阳湖杂咏 其三","author":"萨都剌","text":"野鹤如人长，迎风理毛羽。\n独立秋雨凉，人来忽飞去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏 其四","author":"萨都剌","text":"雨湿鼓声重，风匀湖面平。\n官船南北去，帆影挂新晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏 其六","author":"萨都剌","text":"秋水落红衣，秋波日潇洒。\n不见采莲人，惟逢捕鱼者。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏 其七","author":"萨都剌","text":"霜落大湖浅，渔家悬破罾。\n此时生计别，小艇卖秋菱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏 其八","author":"萨都剌","text":"捕鱼湖中水，卖鱼城市里。\n夫妇一叶舟，白头共生死。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过高邮射阳湖杂咏 其九","author":"萨都剌","text":"大罾一丈阔，小舟一叶轻。\n相传子与孙，终古无人争。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其一","author":"萨都剌","text":"十日九风雨，深秋独闭门。\n积阴须自散，倚杖望朝暾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其二","author":"萨都剌","text":"为客家千里，思归月满楼。\n木犀开欲尽，病里过中秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其三","author":"萨都剌","text":"门系青骢马，多应问病人。\n小官好疏散，莫讶懒衣巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其四","author":"萨都剌","text":"病形如瘦鹤，照影向清池。\n自有冲霄志，游鱼莫见疑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其五","author":"萨都剌","text":"风叶高下落，秋砧远近闻。\n天涯多病客，倚杖看孤云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其六","author":"萨都剌","text":"陶令贫无酒，郎言菊也无。\n家僮烧柿叶，邻舍送茱萸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中杂咏 其七","author":"萨都剌","text":"多病东厅客，深秋出幕迟。\n芙蓉开也未，叶上好题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠钦师","author":"萨都剌","text":"随缘驻瓶锡，顶雪已差差。\n莫道禅非学，心空不废诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画","author":"萨都剌","text":"树色浓堪掬，痴岚扑雨秋。\n道人岩下住，屋角挂奔流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画二首 其二","author":"萨都剌","text":"草迷苍耳子，鸟弄白头翁。\n十里湖山树，平分杳霭中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵与德明小友 其一","author":"萨都剌","text":"烟雨短篷水口，人家乱石山前。\n送别莫忘今日，相逢知在何年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵与德明小友 其二","author":"萨都剌","text":"莫笑风餐水宿，暂离马足车尘。\n两岸好山送客，一江细雨归人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟中题画卷","author":"萨都剌","text":"两岸好山如画，丹崖翠壁楼台。\n爱杀南闽风景，小官何日归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中渡江过山饮旸谷简上人房 其一","author":"萨都剌","text":"闻说山中新酒熟，野人乘兴过江来。\n小窗无处看春色，一树梅花雪里开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中渡江过山饮旸谷简上人房 其二","author":"萨都剌","text":"山酒吹香出小槽，灯前痛饮污青袍。\n夜深梦醒知何处，老鹤一声山月高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京口城南次集 其一","author":"萨都剌","text":"野荠花开春欲尽，山樱子落雨初晴。\n酒醒骑马踏花去，门外绿阴无数生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京口城南次集 其二","author":"萨都剌","text":"雨深绿叶樱桃肥，日长青草蝴蝶飞。\n江南三月春欲尽，白马王孙游不归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"憩奉真道院","author":"萨都剌","text":"落花风飏步虚声，翠草玄芝烂熳生。\n过客不知春早晚，午窗晴日睡闻莺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对客","author":"萨都剌","text":"石榴花开光照屋，胡桃叶大阴满帘。\n焚香终日对客坐，时有白云来纤纤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过扬州","author":"萨都剌","text":"买舟南浦秋闻雁，呼酒西窗夜剪灯。\n何处玉箫天似水，琼花一夜白如冰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿淮南长芦寺","author":"萨都剌","text":"柳花漠漠春归寺，芦叶青青晚渡江。\n屋角松声撼风雨，道人一夜不开窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿化阁渡口阻风 其一","author":"萨都剌","text":"江船日午无人渡，渡口人家尽不罾。\n却忆吴姬新压酒，钟山对岸是金陵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿化阁渡口阻风 其二","author":"萨都剌","text":"艇子渡江何日回，石头城下浪如雷。\n淮南春色知多少，一树樱桃带雨开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿化阁渡口阻风 其三","author":"萨都剌","text":"客船伐鼓春江暮，水面鱼龙出浪花。\n今夜石头城下泊，买鱼沽酒向谁家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宣化江阻风","author":"萨都剌","text":"渡口无人上野航，白头巨浪自冲撞。\n东风三日不肯住，吹送杨花飞度江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题界首驿 其一","author":"萨都剌","text":"清气扑人湖面水，幽声到耳树头风。\n人家蚕老樱桃过，恰似淮南四月中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题界首驿 其二","author":"萨都剌","text":"平湖过雨天开镜，落日放船人打鱼。\n野老柳阴沽秫酒，行人马上寄家书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渡淮即事","author":"萨都剌","text":"杨花点点冲帆过，燕子双双掠水飞。\n淮上渔人閒不得，船头对结绿蓑衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西宫即事 其二","author":"萨都剌","text":"退朝西殿承平日，一片春云奏凤笙。\n白面内官供玉食，却将黄帕覆银铛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"还台偶成 其一","author":"萨都剌","text":"高低柳絮飞渡水，红白桃花开满枝。\n自笑江南无用客，一春无事只题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成","author":"萨都剌","text":"踏马归来过早春，空阶已见草如茵。\n东风吹绿青溪柳，马上轻寒不著人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题冶城道士稽秋山卷","author":"萨都剌","text":"不见冶城稽道士，云深无处访仙踪。\n夜闻老鹤行枯叶，知在秋山第几重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"余与观志能俱以公事赴北舟至梁山泊时荷花盛开风雨大至舟不相接遂泊芦苇中余折芦一叶题诗其上寄志能","author":"萨都剌","text":"题诗芦叶雨斑斑，底事诗人不奈閒。\n满浦荷花开欲遍，客程五月过梁山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春词","author":"萨都剌","text":"深宫尽日垂珠箔，别殿何人度玉筝。\n白面内官无一事，隔花时听打毬声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其一","author":"萨都剌","text":"白昼箫韶起半空，水晶行殿玉屏风。\n诸王舞蹈千官贺，高捧蒲萄寿两宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其二","author":"萨都剌","text":"沙苑棕毛百尺楼，天风摇曳锦绒钩。\n内家宴罢无人到，面面珠帘夜不收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其三","author":"萨都剌","text":"凉殿参差翡翠光，朱衣华帽宴亲王。\n红帘高卷香风起，《十六天魔》舞袖长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其四","author":"萨都剌","text":"中官队仗等宫车，小样红靴踏软沙。\n昨日官家清宴罢，御罗轻帽插珠花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其五","author":"萨都剌","text":"大野连山沙作堆，白沙平处见楼台。\n行人禁地避芳草，尽向曲阑斜路来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其六","author":"萨都剌","text":"院院烧灯有咒僧，垂帘白日点酥灯。\n上京六月凉如水，人渴天瓢更赐冰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其七","author":"萨都剌","text":"祭天马酒洒平野，沙际风来草亦香。\n白马如云向西北，紫驼银瓮赐诸王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其八","author":"萨都剌","text":"牛羊散漫落日下，野草生香乳酪甜。\n卷地朔风沙似雪，家家行帐下毡帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京即事 其十","author":"萨都剌","text":"五更寒袭紫毛衫，睡起东窗酒尚酣。\n门外日高晴不得，满城湿露似江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再过梁山泊有怀观志能 其一","author":"萨都剌","text":"故人同出不同归，云水微茫入梦思。\n记得题诗向芦叶，满湖风雨似来时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再过梁山泊有怀观志能 其二","author":"萨都剌","text":"灯火官船夜睡迟，满湖风露袭人衣。\n无端惊起沙头雁，明月芦花各自飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邵伯舟中","author":"萨都剌","text":"惊鱼时出浪花雪，短鬓凉吹水面风。\n远客行船秋色里，谁家吹笛月明中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题京口高资包氏壁","author":"萨都剌","text":"肩舆晓踏新晴出，山色青青上客衣。\n昨日千林风雨过，满田白水鹭鸶飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠茅山道士胡琴月","author":"萨都剌","text":"茅山道士来相访，手抱七弦琴一张。\n准拟月明弹一曲，桐花落尽晓风凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送镜中圆上人游钱塘","author":"萨都剌","text":"西湖西畔三天竺，古木苍藤望欲迷。\n遥忆道人禅榻夜，月高霜落听猿啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过赞善庵","author":"萨都剌","text":"夕阳欲下行人少，落叶萧萧路不分。\n脩竹万竿秋影乱，山风吹作满窗云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云中过龙潭紫微观访道士不值","author":"萨都剌","text":"道人已跨龙潭鹤，童子能煎雀舌茶。\n一夜山中满林雪，客来无处觅梅花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"将游茅山先寄道士张伯雨","author":"萨都剌","text":"借骑白鹤访茅君，琪树秋声隔夜闻。\n料得山中张道士，开门先扫鹤巢云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登众妙堂题商学士画雨霁归舟图","author":"萨都剌","text":"大茅峰顶见日出，烟树云林宿雨收。\n万里澄江净如练，却从天际识归舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"紫阳道士冯友直与余同宿菌阁次日予过元符宫友直同僧安上人入五云观因以寄之","author":"萨都剌","text":"道人采药出山迟，菌阁秋高袭羽衣。\n半夜忽闻孤鹤唳，五云相伴一僧归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同张伯雨过凝神庵因观宋高宗所赐蒲衣道士张达道白羽扇","author":"萨都剌","text":"晴日赤山湖水明，湖中山影一眉青。\n蒲衣道士无人识，羽扇年年落凤翎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茅山玄洲精舍有道士号紫轩又号木通生白日坐解遗书其徒许道民者至今坐墙尚存为题其卷","author":"萨都剌","text":"白日飞升凌紫烟，灵书犹许道民传。\n玄洲精舍无多地，夜夜火珠光烛天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日渡淮喜东南顺风 其一","author":"萨都剌","text":"青旗红字映河滨，九日人家物色新。\n渡口客船争贳酒，斫鱼裂纸赛江神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日渡淮喜东南顺风 其二","author":"萨都剌","text":"东南风送渡淮船，过雁声寒水接天。\n落日红霞收未尽，澹云微月出东边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日镇阳柳溪道院","author":"萨都剌","text":"城外青溪出洞门，道人归去日长曛。\n柳花满地无人扫，隔水遥看是白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过镇阳城南观音院","author":"萨都剌","text":"柳色暗藏溪上寺，露华偏湿水边僧。\n门前天暝荷花满，出水游鱼夜戏灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄奎章学士济南李溉之","author":"萨都剌","text":"山东李白似刘伶，投老归来酒半醒。\n天下三分秋月色，二分多在水中亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄奎章学士济南李溉之 其二","author":"萨都剌","text":"笑掷金龟上酒船，不须图像在凌烟。\n碧罗衫色乌纱帽，便是开元李谪仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过献州","author":"萨都剌","text":"西风老树昏鸦集，落日荒城暗雨崩。\n寂寞断碑秋草里，路人遥指献王陵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"补题淮西送王仲和从事诗卷","author":"萨都剌","text":"百年驰马苦匆匆，水落乌江楚庙空。\n眼底山川犹历历，淮南旧梦雨声中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李溉之送别诗卷","author":"萨都剌","text":"清平三曲动明皇，四海知名李白狂。\n把酒探春送行客，挥毫字字柳花香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"将入闽赵郡崔好德求题舆地图","author":"萨都剌","text":"月轮西转日生东，四海车书总会同。\n骑马出门天万里，山川长在别离中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河舟中月夜","author":"萨都剌","text":"十丈雪帆拂斗杓，星槎风急浪花飘。\n夜深露冷银河近，卧听天孙织绛绡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阻风南露筋过罗汉寺登楼看山茶","author":"萨都剌","text":"野寺寻春酒未醒，不知几日过清明。\n小阑干外东风急，一树山茶落晚晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜宿金山题金山图","author":"萨都剌","text":"远人夜宿金山寺，坐对画图如梦中。\n剪烛题诗云气里，不知身已在龙宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日过丹阳石仲和宅会茅山道士石山辉","author":"萨都剌","text":"杏花一夜雨声寒，酒醒丹阳几日还。\n却遇茅君三白鹤，借骑一只到三山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登姑苏台","author":"萨都剌","text":"阊门杨柳自春风，水殿幽花泣露红。\n飞絮年年满城郭，行人不见馆娃宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登姑苏台 其二","author":"萨都剌","text":"野水满城飞燕子，谁家小艇载吴姬。\n姑苏台上一樽酒，落日昏鸦无限悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"入闽过松陵和王伯循所题","author":"萨都剌","text":"广陵城里别匆匆，一去三山隔万重。\n日暮江东寄相忆，欲从秋水剪芙蓉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]