[{"title":"宿长安驿 其一","author":"萨都剌","text":"坝北坝南河水平，客船争缆水云腥。\n乡音吴越不可辨，灯火黄昏如乱星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿长安驿 其二","author":"萨都剌","text":"水面微风动杨柳，客船吹笛月明中。\n远人江海多归思，卧看流星度水东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钓台夜兴","author":"萨都剌","text":"仙茶旋煮桐江水，客火遥分石壁灯。\n风露满船山月上，夜凉独对钓台僧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早发钓台","author":"萨都剌","text":"山头钟响不闻鸡，重露翻鸦满树啼。\n艇子钓台东畔发，月轮却在钓台西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兰溪舟中","author":"萨都剌","text":"水底霞天鱼尾赤，春波绿占白鸥汀。\n越船一叶兰溪上，载得金华一半青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊江家步无月同孟志学小酌溪上 其一","author":"萨都剌","text":"把酒无从邀月色，共君且复听滩声。\n夜深灯影青溪上，鱼尾摇船亦有情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泊江家步无月同孟志学小酌溪上 其二","author":"萨都剌","text":"兰溪春水似蒲萄，越女如花压小槽。\n今夜共君溪上醉，直须溪月照宫袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄亭驿晓起","author":"萨都剌","text":"积雨莓苔上壁青，晓寒山馆梦初醒。\n鹧鸪声里流年度，自是行人不忍听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和经历杨子承晓发山馆","author":"萨都剌","text":"梦回山馆月西斜，曙色千峰动紫霞。\n杜宇一声山竹裂，鹧鸪飞上野棠花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石林即事 其一","author":"萨都剌","text":"三山幕府无公事，多病郎官懒出门。\n老鹤唤回童子睡，石盆新雨长兰孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石林即事 其二","author":"萨都剌","text":"蒲扇屏山紫竹床，岭南五月似秋凉。\n砚池风动云生石，帘外雨兰吹湿香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题屏风","author":"萨都剌","text":"海国夜凉星乱垂，石林逋客未眠时。\n满帘月色吹轻雾，白露无声下竹枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独坐恭和堂","author":"萨都剌","text":"东阁高悬如道院，人言幕府最清严。\n印封不动坐终日，满树梅花雨一帘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闽城岁暮","author":"萨都剌","text":"岭南春早不见雪，腊月街头听卖花。\n海国人家除夕近，满城微雨湿山茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经历司暮春即事 其一","author":"萨都剌","text":"隔树幽禽送好音，沉沉幕府似云林。\n小盆几个山茶落，桃叶满帘春雨深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经历司暮春即事","author":"萨都剌","text":"霞飞海燕拂帘过，风卷鱼鳞剪绿波。\n閒倚石阑数春事，满池红雨落花多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠道士陈华隐","author":"萨都剌","text":"早年濯足东海水，去卧华峰顶上云。\n收得九秋仙掌露，归来酌献武夷君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮安王氏小楼 其一","author":"萨都剌","text":"江水粼粼鸭绿新，江头日日送行人。\n南来北去年年事，岸草汀花自在春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮安王氏小楼","author":"萨都剌","text":"拂晓楼窗一半开，楼前昨夜浪如雷。\n满江梅雨风吹散，无数青山渡水来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮安王氏小楼 其三","author":"萨都剌","text":"江月满楼江水澄，胡床据坐忆吾曾。\n解吟如练澄江句，未信玄晖独擅能。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮安王氏小楼 其四","author":"萨都剌","text":"雪满寒江压酒旗，江南无处不堪题。\n小舟载得梅花去，渡领春风过水西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画竹","author":"萨都剌","text":"小雨春池湿凤毛，天孙深夜织鲛绡。\n何人更立湘江水，独倚薰风忆舜韶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏呈廉公亮佥事 其一","author":"萨都剌","text":"亚父冢前春草齐，楚王城上夕阳低。\n黄莺不解兴亡事，飞过海棠枝上啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏呈廉公亮佥事 其二","author":"萨都剌","text":"城下黄河去不回，四山依旧画屏开。\n无人念得登临意，独上将军戏马台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏呈廉公亮佥事 其四","author":"萨都剌","text":"何处春风燕子楼，断碑落日古城头。\n画眉人远繁华歇，无数远山生暮愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏呈廉公亮佥事 其五","author":"萨都剌","text":"歌扇春风噀酒香，舞裙落日动鹅黄。\n柳边今夜孤舟发，水远山遥空断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食马上","author":"萨都剌","text":"道傍杨柳已栖鸦，几度春深未到家。\n城北城南干树雪，行人马上看梨花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕京作","author":"萨都剌","text":"落月西窗闻禁钟，梦回远客立云龙。\n江南飞尽千株雪，辜负梅花过一冬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奎章阁感兴 其一","author":"萨都剌","text":"奎章三月文书静，花落春深锁阁门。\n玉座不移天步远，石碑空有御书存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奎章阁感兴 其二","author":"萨都剌","text":"花落春深似去年，无人再到阁门前。\n当时济济誇多士，争进文章乞赐钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京城立春","author":"萨都剌","text":"燕姬白马青丝缰，短衣窄袖银?光。\n御沟饮马不回首，贪看柳花飞过墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日遇雨","author":"萨都剌","text":"佳期不负到重阳，细雨浓阴又可伤。\n试问东篱何处赏，有花无酒恼人肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中九日 其一","author":"萨都剌","text":"寥落天涯岁月赊，每逢佳节苦思家。\n无钱沽得邻家酒，不敢开窗看菊花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中九日 其二","author":"萨都剌","text":"佳节相逢作远商，菊花不异故人乡。\n无钱沽得邻家酒，一度孤吟一断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过石子冈","author":"萨都剌","text":"霞光日落红穿树，山色雨馀青近人。\n便好拂衣入山去，解鞍辞却马头尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王叔能侍御史","author":"萨都剌","text":"龙蛇偃蹇出墙阴，五色春云态度深。\n台阁文章散清气，月明山馆夜萧森。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉起","author":"萨都剌","text":"杨柳楼心月满床，锦屏绣褥夜生香。\n不知门外春多少，自起移灯照海棠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词","author":"萨都剌","text":"骏马骄嘶懒著鞭，晚凉骑过御楼前。\n宫娥不识中书令，借问谁家美少年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"衰柳","author":"萨都剌","text":"清凉亭上几株柳，霜夜凉风下夕阳。\n依旧明年二三月，小金山上看鹅黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏友人","author":"萨都剌","text":"毗陵公子醉醺醺，白面迎风向酒痕。\n几度小红楼上月，有人银烛掩重门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宴回","author":"萨都剌","text":"两行老柏参天翠，银烛青骢御史回。\n深夜酒阑人散后，独留明月照霜台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"约友游西峰不至","author":"萨都剌","text":"仙人约我峰头去，欲去峰头看白云。\n一夜白云峰下宿，晓来散作雨纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太平驿即事","author":"萨都剌","text":"驿鼓高悬使者稀，溪云断续树参差。\n日斜山畔无人语，独立西风数桂枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过光孝寺","author":"萨都剌","text":"秋日留题翠壁层，出山聊近在山僧。\n肩舆又上沙头渡，隔水人家两岸灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临丹青阁","author":"萨都剌","text":"飘然身在紫芝峰，翠壁丹崖有路通。\n杰阁凌烟欲飞去，乱山无数夕阳中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河","author":"萨都剌","text":"斗杓照水半垂天，水气涨天如白烟。\n南北橹声争上下，月中闻鼓避官船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沛尉蒋景山沛簿赵伯颜送予金沟月夜别去有怀","author":"萨都剌","text":"公子将军两少年，绣衣白马杏花天。\n醉中送客归城暮，回首金沟月满船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和閒閒吴真人二首 其一","author":"萨都剌","text":"几度驱车上京国，五更归梦绕云林。\n丹炉火伏虎书卧，石钵云寒龙夜吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和閒閒吴真人二首 其二","author":"萨都剌","text":"天上神仙吴子晋，丹凤楼前驾鹿车。\n红门下马见天子，袖有一卷养生书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兴圣寺即事三首 其一","author":"萨都剌","text":"宫阶白日杏花落，深院朱帘燕子飞。\n回首人间春又老，将军白马几时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兴圣寺即事三首 其二","author":"萨都剌","text":"御厨香动晚分羹，七宝玻瓈柈柈承。\n白面内官呼小字，隔帘传旨赐中丞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兴圣寺即事三首 其三","author":"萨都剌","text":"二月深宫花似锦，柳丝垂地怯风吹。\n御阶春水多三尺，丞相游湖太液池。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题范阳驿","author":"萨都剌","text":"长路风寒酒力醒，马头岁月短长亭。\n冻云欲雪风吹散，望出西山一半青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道傍萱花","author":"萨都剌","text":"萱草花开山路头，内家景致落林丘。\n风尘不改好颜色，应与行人消百愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书浍沟杨氏壁二首 其一","author":"萨都剌","text":"故人家在河边住，吏部书从天上来。\n愧我挂冠归去晚，柳花飞尽楝花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书浍沟杨氏壁二首 其二","author":"萨都剌","text":"杨柳人家春昼长，落花庭院燕飞忙。\n买鱼沽酒黄河上，傲杀南风三月强。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"彭城杂咏","author":"萨都剌","text":"英雄去尽山河在，城郭荒凉草树迷。\n过客无心吊千古，落花风雨听莺啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜过白马湖","author":"萨都剌","text":"春水满湖芦苇青，鲤鱼吹浪水风腥。\n舟行未见初更月，一点渔灯落远汀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高邮至邵伯二首 其一","author":"萨都剌","text":"移棹偏惊临水雁，过淮时买出罾鱼。\n有时得句无人和，风雨寒窗夜读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高邮至邵伯二首 其二","author":"萨都剌","text":"几度秋深未到家，满湖开遍水红花。\n远人日日频中酒，明月扁舟索买瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题淮东王廉访清凉亭","author":"萨都剌","text":"主人胸次洗冰雪，深夜金山月涌波。\n二十四桥秋水白，淮南八月泻银河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次和清凉寺长老韵","author":"萨都剌","text":"缁衣送酒一壶冰，霜蒂悬香九月橙。\n酌酒破橙天色晚，桂花树下出银灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江横笛图为维扬苏天爵题","author":"萨都剌","text":"枫叶高低山远近，月明霜薄楚江澄。\n何人吹笛孤舟外，莫是苏仙过广陵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过江后书寄成居竹","author":"萨都剌","text":"扬州酒力四十里，睡到瓜洲始渡江。\n忽被江风吹酒醒，海门飞雁不成行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨子江送同志","author":"萨都剌","text":"衮衮诸公立要津，一波才动总精神。\n满江风浪晚来急，谁似中流砥柱人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜发龙潭二首 其一","author":"萨都剌","text":"孤舟一夜发龙湫，水逆风回上石头。\n暂泊沙洲过夜半，卧听钟鼓是升州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜发龙潭二首 其二","author":"萨都剌","text":"船头夜静天如水，渡口潮平月在江。\n灯影摇波风不定，老龙吹浪湿篷窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江浦夜泊","author":"萨都剌","text":"千里长江浦月明，星河半入石头城。\n棹歌未断西风起，两岸菰蒲杂雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中遇雨寄功父光国五首 其一","author":"萨都剌","text":"出城便喜风景好，淡水穿沙生细鳞。\n多谢山云飞白雨，应教行客洗红尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中遇雨寄功父光国五首 其二","author":"萨都剌","text":"平生梦想金陵道，此日偶然身自来。\n应是山云喜诗客，野花满路雨中开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中遇雨寄功父光国","author":"萨都剌","text":"夹道长松风聒聒，满沟乱石水泠泠。\n断云衔雨溪南去，失却长山一半青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中遇雨寄功父光国五首 其四","author":"萨都剌","text":"骑马何人冲白雨，乘舆有客看青山。\n出城自谓身无事，冲雨看山未是閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金陵道中遇雨寄功父光国五首 其五","author":"萨都剌","text":"梦想江南今日到，肩舆过处落花风。\n行人五月金陵道，石竹花开白雨中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓台城寄吴宗师","author":"萨都剌","text":"金陵城外凤凰台，夜夜吹箫独自来。\n不见仙人倚歌和，白鹤飞下还飞回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中饮升龙观","author":"萨都剌","text":"银烛春船剪夜寒，道人鹤氅紫霞冠。\n山瓢未尽金陵酒，玉树飞花满石坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王本中直台书事 其一","author":"萨都剌","text":"百尺台中谁夜直，西廊斜月照东廊。\n五更梦觉春寒甚，帘外梨花满树霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王本中直台书事 其二","author":"萨都剌","text":"今日短衣鞭瘦马，每惭同辈说登科。\n近曾夜直南台上，学得吴儿白苧歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"升龙观九日海棠杏花开二首 其一","author":"萨都剌","text":"九日江南风日暖，海棠花间杏花开。\n升龙观里春光早，为是先承雨露来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"升龙观九日海棠杏花开二首 其二","author":"萨都剌","text":"鼎湖龙去御床空，辇路花开旧日红。\n九日人间春色早，不堪草木见秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]