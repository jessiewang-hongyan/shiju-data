4d192fe5294295f79689","path":"元.csv","pointer":28157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄荃花溪仙舫图","author":"黄公望","text":"花发枝头水涨溪，仙丹犹泊武陵堤。\n重重楼阁仙云卷，无数青峰出竹西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"董北苑","author":"黄公望","text":"一片閒云出岫来，袈裟不染世间埃。\n独怜陶令门前柳，青眼偏逢惠远开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭忠恕万松仙馆图","author":"黄公望","text":"琳堂掩映万松齐，绝壑寒云望不迷。\n为听水流翻破寂，轻袍重过短墙西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李营丘真迹次俞紫芝韵","author":"黄公望","text":"营丘自是浪仙流，写得空山一段秋。\n古木千章施锦绣，风光都属幔亭收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵伯驹","author":"黄公望","text":"露湿庭松偃盖青，一声野鹤隔疏棂。\n仙翁来往无拘束，閒向琳宫读道经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周文矩十美图","author":"黄公望","text":"侍宴朱楼向暮归，御香犹在缕金衣。\n相携女伴阶前立，笑指鸳鸯水面飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂为袁清容画秋景仿大李次韵","author":"黄公望","text":"空江渺渺暮烟霏，轻舸应知张掾归。\n鸿雁恰来枫叶下，山翁未解换秋衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂仿张僧繇","author":"黄公望","text":"松影参差俯急湍，悠悠斜日下西川。\n舟师欲渡频回首，游子经年怯袂寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂仿陆探微笔意","author":"黄公望","text":"千山雨过琼琚湿，万木风生翠幄稠。\n行遍曲阑人影乱，半江浮绿点轻鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临李思训员峤秋云图","author":"黄公望","text":"蓬山半为白云遮，琼树都成绮树华。\n闻说至人求道远，丹砂原不在天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王叔明为姚子章林泉清话图","author":"黄公望","text":"霜枫雨过锦光明，涧壑云寒暝色生。\n信是两翁忘世虑，相逢山水自多情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪云林为静远画","author":"黄公望","text":"遥山近山青欲滴，大木小木叶已疏。\n斜日疏篁无鸟雀，一湾溪水数函书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪云林为子章徵士画","author":"黄公望","text":"荒山白石带古木，个中仍置子云亭。\n砚坳疑有烟云贮，时见青青落户庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶画","author":"黄公望","text":"鼋石矶头宿雨晴，蛟峰祠下树冥冥。\n一江春水浮官绿，千里归舟载客星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举海棠鸂鶒图","author":"黄公望","text":"春来庭院风光好，花萼连枝锦不如。\n况有和鸣双绣羽，御黄新染浴清渠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张叔厚写渊明小像","author":"黄公望","text":"千古渊明避俗翁，后人貌得将无同。\n杖藜醉态浑如此，困来那得北窗风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题春林远岫图","author":"黄公望","text":"春林远岫云林画，意态萧然物外情。\n老眼堪怜似张籍，看花玄圃欠分明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其一","author":"黄清老","text":"麦熟天乍热，开轩理瑶琴。\n兹晨有客至，一径苍苔深。\n日出树影倒，旷坐分绿阴。\n清谈落馀花，松风杂幽禽。\n君子希道德，永言结同心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其二","author":"黄清老","text":"园林步春晓，芳径澹已开。\n日出露未晞，孤吟池上台。\n虚阁纳翠光，砚寒欲生苔。\n清坐契心赏，白云时入来。\n君子晚相识，南山碧崔嵬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其三","author":"黄清老","text":"西山三月春，万物好颜色。\n鸟啼自宫商，花开各红白。\n滔滔东流水，千里在顷刻。\n风雨入远林，苔痕有新箨。\n鸡鸣潮欲上，山月迟归客。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其四","author":"黄清老","text":"狂风卷茅屋，遥见溪上山。\n人生有遇合，离别何足叹。\n黄鹄将西归，临水振羽翰。\n我有双明珠，置之青云端。\n朝朝复暮暮，照君千里还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其五","author":"黄清老","text":"少年处山谷，壮岁游京师。\n性本猿鹤群，焉能牛马驰。\n曩有采薪忧，挂冠愿为医。\n近得圣贤心，读书甘如饴。\n习贯已成癖，岂无君子知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗六章送王君冕归陕西 其六","author":"黄清老","text":"十载宦京辇，田园就荒芜。\n兹焉拟归耕，休马南山隅。\n举酒树色动，莺燕鸣相呼。\n流水既送君，白云亦邀余。\n锦囊可赠远，愧非明月珠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"招友人","author":"黄清老","text":"晨雨洗馀花，尘虑日萧散。\n芳草绿如茵，空林坐春晚。\n遥思江上客，尊酒愧折简。\n临流撷嘉蔬，共此林下饭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨信父归临江","author":"黄清老","text":"自别武夷君，海水落几丈。\n当年尊俎地，颠倒叠横嶂。\n君从山中来，应见桃花开。\n秦人笑相语，愧我非仙才。\n茫茫八极中，云月秋徘徊。\n苦吟不出门，孤负黄金罍。\n划然西风生，拂我琴边埃。\n愿从双白鹤，去去不复回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李子威代祀嵩衡淮海三首 其一","author":"黄清老","text":"天香出金门，春色动远山。\n使者持节去，翩如跨双鸾。\n崔嵬嵩少峰，卓立乾坤间。\n中夜南极浮，星河绕天坛。\n石室有宝书，泉鸣玉珊珊。\n安得揖浮丘，青云骖羽翰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李子威代祀嵩衡淮海三首 其二","author":"黄清老","text":"群生望甘泽，五岳云气通。\n天香落岩谷，瑞霭春冥濛。\n海潮天际来，金碧森万峰。\n划落紫翠堆，亭亭玉芙蓉。\n古庙丝竹存，迎神奏黄钟。\n空山递馀响，落花舞青童。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李子威代祀嵩衡淮海三首 其三","author":"黄清老","text":"南海祝融宅，汪洋载神州。\n巨浸涵万有，元气何空浮。\n苍苍岛屿间，仿佛通十洲。\n神鱼在深渊，甘霖何以求。\n朝折若木枝，夕饮桐柏流。\n万里一瓣香，岂徒司马游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古乐府三首 其一","author":"黄清老","text":"君好锦绣段，妾好明月珠。\n锦绣可为服，服美令人愚。\n不如珠夜光，可以照读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古乐府三首 其二","author":"黄清老","text":"君好春芍药，妾好夏池莲。\n芍药多艳色，春风迷少年。\n不如莲有实，可以寿君筵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古乐府三首 其三","author":"黄清老","text":"绵绵江上草，郁郁庭中柯。\n人生不相知，有如东逝波。\n食杏犹苦酸，食梅当若何？\n衣褐犹苦寒，衣葛寒更多。\n岂无千载友，肯听渔樵歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山行二首 其一","author":"黄清老","text":"爱山不知倦，缓步成幽寻。\n观泉度叠嶂，携日穿层林。\n眷彼枝上鸟，少憩松间阴。\n萧然清风来，发我松下琴。\n白云邀我饮，流泉永我吟。\n曾谓尘中人，不知君子心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山行二首 其二","author":"黄清老","text":"采采岩下菊，菊老花压地。\n泉露飘我衣，撷英不盈袂。\n铮然松子落，林下远风至。\n沈吟不成诗，支筇领山意。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古意怀仲章贡侍御二首 其一","author":"黄清老","text":"娉婷二八女，绝色妙难画。\n新妆薄铅华，照影修竹下。\n盛年事夫婿，锦玉耀精舍。\n虽非伯鸾妻，惓然惜春夜。\n琴馀月当轩，默默倚风榭。\n寄语东家儿，红颜莫轻嫁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古意怀仲章贡侍御二首 其二","author":"黄清老","text":"梧桐生高冈，云气涵空清。\n南枝挂孤月，上有苍鸾鸣。\n大匠挥玉斧，浑然合天成。\n置之白玉堂，被之弦歌声。\n一弹松风来，再鼓溪月明。\n子期人已往，青山为谁情？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送僧定观归","author":"黄清老","text":"诗僧百丈来，复作五台别。\n丁然振金锡，桂子落秋雪。\n山空白雪閒，风息万籁灭。\n相思何处无，江湖一明月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鄱阳舟中闻友人消息因赠","author":"黄清老","text":"岧峣九天门，玉署青琐闼。\n老我烟霞心，参商坐寥阔。\n十年望春云，不忍镊白发。\n鸿雁还塞来，频频附书札。\n江湖秋水浅，舟楫苦不达。\n不知南山阳，梅花为谁发？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹外一枝梅花","author":"黄清老","text":"仙标何处来？\n一寒倚寒玉。\n晴窗见疏林，座上春可掬。\n山阴带残雪，水影兼远绿。\n珍重孤竹君，岁寒伴幽独。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题医人黄子厚","author":"黄清老","text":"悠悠溪上山，叠叠山下云。\n幽人不出户，芝草日以春。\n伯也种丹杏，心与孤鸿轻。\n仲也捣玄霜，西风林间声。\n世降运不齐，病随人心生。\n芳草何所无，谁能撷其英。\n吾宗幼方积，积久用更精。\n金丹有时合，白日升蓬瀛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武夷道中","author":"黄清老","text":"积雨多浮云，百川合为一。\n新晴落花深，草径没行迹。\n溪风淡和柔，天宇浩澄碧。\n诸峰出云间，净若露初拭。\n迟迟策驽马，稍稍度翠壁。\n从人不知疲，佳境恣所历。\n松间古仙人，燕坐松下石。\n羽化今几年，苍苔满双屐。\n乾坤妙无言，小大自有得。\n为我谢群芳，春风各努力。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯及第归和揭经历见贺诗","author":"黄清老","text":"儿时见月欲上天，昆仑独往三十年。\n山深染得秋水绿，所思忽到梅花边。\n萤灯照雪心炯炯，危坐空斋似禅定。\n落花啼鸟意不惊，涧瀑松风自相应。\n书成上谒天帝君，半夜掣起扶桑云。\n麒麟峥嵘列万户，虎豹奰屃悬千钧。\n翠盘八珍为君荐，剑佩锵锵揖群彦。\n木天日上五色云，知有百灵护经传。\n春城如海花满园，狂吟中有白与元。\n至今风雨飞动意，垂杨起舞花能言。\n银潢东流几时了，松下梦回秋又晓。\n苍苍此意谁得知，蟾阙佳人霜雪皎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题胡修撰金华杂兴小稿","author":"黄清老","text":"吾闻金华之山东南峰，石壁巉起如飞龙。\n沧溟盘礴几万里，但见扶桑日影倒挂金芙蓉。\n山中仙人古愚老，青霞落落云间松。\n翩然独去游无穷，谒帝西上昆仑宫。\n春苔染水碧于酒，辇路人家插杨柳。\n金茎露泻明月珠，散落人间作星斗。\n君不见西山日上紫气横，花下有人调玉笙。\n太平拟进九成乐，五云楼阁生秋声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上继学王公","author":"黄清老","text":"大风卷地沙尘昏，十日不得一出门。\n眼中俗子浩于海，思欲一见云中君。\n云中之君玉为节，廌冠峨峨照晴雪。\n振衣惊落琪树花，片片人间作明月。\n有时霹雳生风雷，松声晓落青崔嵬。\n众芳收雨作春色，瑶草绿遍三蓬莱。\n有时笔端吐光怪，干将生花玉龙蜕。\n广寒天上闻步虚，万壑千崖起秋籁。\n嗟余困学无所成，仙家幸识黄麒麟。\n愿从辋川觅诗法，白鸥飞入南山春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]