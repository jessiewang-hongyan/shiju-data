[{"title":"书画舫小集分韵得春字","author":"郑元祐","text":"雪舫夜寒虹贯日，溪亭腊尽柳含春。\n将军结发开全武，隐者逃名愧子真。\n醉里都忘诗格峻，灯前但爱酒杯频。\n芼羹青点沿墙荠，斫鲙冰飞出网鳞。\n稽古尚能窥草圣，送穷端欲致钱神。\n周南老去文章在，同谷歌终手脚皴。\n擉鳖归来还自笑，闻鸡起舞意谁嗔。\n盍簪岂料有今夕，明日桃源又问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纪事二首 其二","author":"周伯琦","text":"礼闱半月得从容，料峭春寒似早冬。\n警夜每闻三弄角，论文直到五更钟。\n雁来远路惊流景，草茁閒庭失旧踪。\n得士共为天下贺，明朝揭榜醉黄封。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其一","author":"杨允孚","text":"北顾宫庭暑气清，神尧圣禹继升平。\n今朝建德门前马，千里滦京第一程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二","author":"杨允孚","text":"纳宝盘营象辇来，画帘毡暖九重开。\n大臣奏罢行程记，万岁声传龙虎台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三","author":"杨允孚","text":"宫车次第起昌平，烛炬千笼列火城。\n才入居庸三四里，珠帘高揭听啼莺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四","author":"杨允孚","text":"营盘风软净无沙，乳饼羊酥当啜茶。\n底事燕支山下女，生平马上惯琵琶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五","author":"杨允孚","text":"羽猎山阴射白狼，太平天子狩封疆。\n峰峦频转丹楼稳，辇辂初停白昼长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六","author":"杨允孚","text":"居庸千古翠屏环，飞骑将军驻两关。\n万里车书来上国，太平弓矢护青山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七","author":"杨允孚","text":"穹崖幻出梵王宫，双塔中间一径通。\n四月雨馀山更碧，六龙行处日初红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其八","author":"杨允孚","text":"翎出王侯部落多，香风簇簇锦盘陀。\n燕姬翠袖颜如玉，自按辕条驾骆驼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其九","author":"杨允孚","text":"仙峡琴鸣水木多，别离见月奈愁何。\n题名石壁辽金字，宿雨残风半灭磨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十","author":"杨允孚","text":"狼山山下晓风酸，掩面佳人半怯寒。\n倚户殷勤唤尝粥，止宜倦客宿征鞍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十一","author":"杨允孚","text":"榆林御苑柳丝丝，昨夜宫车又黑围。\n宿卫一时金帐卷，鎗竿珍重白云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十二","author":"杨允孚","text":"断堤遗址古长城，一径中分万柳青。\n年少每忺春酒美，诗人偏厌绮罗腥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十三","author":"杨允孚","text":"汲井佳人意若何，辘轳浑似挽天河。\n我来濯足分馀滴，不及新丰酒较多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十四","author":"杨允孚","text":"莫道枪竿危复危，有人家住白云西。\n儿童采棘颠崖去，杜宇伤春尽日啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十五","author":"杨允孚","text":"李老谷前山石癯，何年此上遂民居。\n老龙若作三更雨，顷刻茅檐数尺馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十六","author":"杨允孚","text":"马上重看尖帽山，山头无数白云间。\n汉家天子真龙种，抔土长陵为设关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十七","author":"杨允孚","text":"北去云州去路赊，马驼残梦忆京华。\n寒风淅沥山无数，树影参差月未斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十八","author":"杨允孚","text":"万古龙门镇两京，悬崖飞瀑一般清。\n天连翠壁千寻险，路绕寒流百折横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其十九","author":"杨允孚","text":"塞北凝阴无子规，晓看山色不胜奇。\n坚冰怪石涧边路，残月疏星马上诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十","author":"杨允孚","text":"东京亭下水濛濛，敕赐游船两两红。\n回纥舞时杯在手，玉奴归去马嘶风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十一","author":"杨允孚","text":"南国乡音渐渐稀，朔风吹雪上征衣。\n边鸿飞过桓州去，更向穷阴何处归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十二","author":"杨允孚","text":"窝名檐子果何如，野草黄云入画图。\n弧矢纵悬仍觅侣，塞前番语笑人迂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十三","author":"杨允孚","text":"驱车偏岭客南还，始见胡姬笑整鬟。\n谁信片云三十里，寒暄只隔此重山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十四","author":"杨允孚","text":"李陵台畔野云低，月白风清狼夜啼。\n健卒五千归未得，至今芳草绿萋萋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十五","author":"杨允孚","text":"鸳鸯坡上是行宫，又喜临歧象驭通。\n芳草撩人香扑面，白翎随马叫晴空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十六","author":"杨允孚","text":"夜宿毡房月满衣，晨餐乳粥椀生肥。\n凭君莫笑穹庐矮，男是公侯女是妃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十七","author":"杨允孚","text":"欢喜坡边望禁城，鸾翔凤翥卿云清。\n举杯一吸滦阳酒，消尽南来百感情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十八","author":"杨允孚","text":"铁番竿下草如茵，澹澹东风六月春。\n高柳岂堪供过客，好花留待蹋青人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其二十九","author":"杨允孚","text":"先帝妃嫔火失房，前期承旨达滦阳。\n车如流水毛牛捷，韂缕黄金白马良。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十","author":"杨允孚","text":"圣祖初临建国城，风飞雷动蛰龙惊。\n月生沧海千山白，日出扶桑万国明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十一","author":"杨允孚","text":"北阙东风昨夜回，今朝瑞气集蓬莱。\n日光未透香烟起，御道声声驼鼓来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十二","author":"杨允孚","text":"撒道黄尘辇辂过，香焚万室格天和。\n两行排列金钱豹，钦察将军上马驼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十三","author":"杨允孚","text":"又是宫车入御天，丽姝歌舞太平年。\n侍臣称贺天颜喜，寿酒诸王次第传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十四","author":"杨允孚","text":"九奏钧天乐渐收，五云楼阁翠如流。\n宫中又放滦河走，相国家奴第一筹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十五","author":"杨允孚","text":"得宠亲王马上回，朱门绣闼一时开。\n淋漓未了金钗宴，中使传宣御酒来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十六","author":"杨允孚","text":"大安阁下晚风收，海月团团照上头。\n谁道人间三伏节，水晶宫里十分秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十七","author":"杨允孚","text":"四杰君前拜不名，轮番内直浃辰更。\n蓬莱山上群仙集，得似王孙世禄荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十八","author":"杨允孚","text":"北极修门不暂开，两行宫柳护苍苔。\n有时金锁因何掣，圣驾棕毛殿里回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其三十九","author":"杨允孚","text":"曙色苍茫阊阖开，相君有奏入蓬莱。\n须臾云拥千官出，又带天边好雨来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十","author":"杨允孚","text":"结綵为楼不用扃，角声扶上日初明。\n龙驹河北王来觐，直入金门下马行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十一","author":"杨允孚","text":"相国门前柳未花，不多嫩绿便藏鸦。\n东风吹得浓阴合，散入都城百万家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十二","author":"杨允孚","text":"千官万骑到山椒，个个金鞍雉尾高。\n下马一齐催入宴，玉阑干外换宫袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十三","author":"杨允孚","text":"锦衣行处狻猊习，诈马筵前虎豹良。\n特敕云和罢弦管，君王有意听尧纲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十四","author":"杨允孚","text":"仪凤伶官乐既成，仙风吹送下蓬瀛。\n花冠簇簇停歌舞，独喜箫韶奏太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十五","author":"杨允孚","text":"丽日初明瑞气开，千官锡宴集蓬莱。\n黄门控马天街立，丞相簪花御苑回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十六","author":"杨允孚","text":"聿来新贡又殊方，重译宁誇自越裳。\n驯象明珠龟九尾，皇王丕宝寿无疆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十七","author":"杨允孚","text":"嘉鱼贡自黑龙江，西域蒲萄酒更良。\n南土至奇誇凤髓，北陲异品是黄羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十八","author":"杨允孚","text":"太平天子重文曹，阁建奎章选俊髦。\n一自六龙天上去，至今黄帕御床高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其四十九","author":"杨允孚","text":"内人调膳侍君王，玉仗平明出建章。\n宰辅乍临阊阖表，小臣传旨赐汤羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十","author":"杨允孚","text":"曲曲阑干兔鹿驯，雨肥绿草度青春。\n主来不避韩卢猎，惯识金衣内贵人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十一","author":"杨允孚","text":"银蹄天马衣氍毹，肉食寻常斗酒俱。\n可惜东游巡海者，不教骑看试何如？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十二","author":"杨允孚","text":"仙娥隐约上帘钩，笑倚阑干出殿头。\n鹦鹉临阶呼万岁，白翎深院度清秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十三","author":"杨允孚","text":"宫人两两凭阑干，又喜新除内监宽。\n金线蹙花靴样小，免教罗袜步轻寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十四","author":"杨允孚","text":"澹墨轻黄浅画眉，小绒绦子翠罗衣。\n君王又幸西宫去，齐向花阴斗草归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十五","author":"杨允孚","text":"香车七宝固姑袍，旋摘修翎付女曹。\n别院笙歌承宴早，御园花簇小金桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十六","author":"杨允孚","text":"窈窕仙姝出禁闱，小西门外绿杨堤。\n五陵公子多豪纵，缓勒骄骢不敢嘶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十七","author":"杨允孚","text":"凤楼春暖翠重重，内禁门开晓日红。\n宝马香车金错节，太平公主幸离宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十八","author":"杨允孚","text":"侯王甲第五云堆，秦虢夫人夜宴开。\n马上琵琶仍按拍，真珠皮帽女郎回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其五十九","author":"杨允孚","text":"汤羊内膳日差排，红帖呼名到玉阶。\n底事金吾呵不住，腰间悬得象牙牌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十","author":"杨允孚","text":"东城无树起西风，百折河流绕塞通。\n河上驱车应昌府，月明偏照鲁王宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十一","author":"杨允孚","text":"官妓平明直禁闱，瑶阶上马月明归。\n宫花飞落春衫袖，辛苦桑麻入梦稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十二","author":"杨允孚","text":"内宴重开马湩浇，严程有旨出丹霄。\n羽林卫士桓桓集，太仆龙车款款调。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十三","author":"杨允孚","text":"鸾舆八月政高翔，玉勒雕鞍万骑忙。\n天上龙归才带雨，城头夜午又经霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十四","author":"杨允孚","text":"南坡暖翠接南屏，云散风轻弄午晴。\n寄与行人停去马，六龙飞上计归程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十五","author":"杨允孚","text":"月出王孙猎兔忙，玉骢拾矢戏沙场。\n皮囊乳酒锣锅肉，奴视山阴对角羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十六","author":"杨允孚","text":"雍容环佩肃千官，空设番僧止雨坛。\n自是半晴天气好，螺声吹起宿云寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十七","author":"杨允孚","text":"正元紫禁肃朝仪，御榻中间宝帕提。\n王母寿词歌未彻，雪花片片彩云低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十八","author":"杨允孚","text":"元夕华灯带雪看，佳人翠袖自禁寒。\n平生不作蚕桑计，只解青骢鞴绣鞍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其六十九","author":"杨允孚","text":"试数窗间九九图，馀寒消尽煖回初。\n梅花点遍无馀白，看到今朝是杏株。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十","author":"杨允孚","text":"脱圈窈窕意如何，罗绮香风漾绿波。\n信是唐宫行乐处，水边三月丽人多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十一","author":"杨允孚","text":"葡萄万斛压香醪，华屋神仙意气豪。\n酬节凉糕犹末品，内家先散小绒绦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十二","author":"杨允孚","text":"百戏游城又及时，西方佛子阅宏规。\n綵云隐隐旌旗过，翠阁深深玉笛吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十三","author":"杨允孚","text":"紫菊花开香满衣，地椒生处乳羊肥。\n毡房纳石茶添火，有女褰裳拾粪归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦京杂咏一百首 其七十四","author":"杨允孚","text":"为爱琵琶调有情，月高未放酒杯停。\n新腔翻得《凉州》曲，弹出天鹅避海青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]