[{"title":"正月三日，大雪","author":"范梈","text":"大雪生何处，飞来应早春。\n清寒微着物，光霁亦宜人。\n日月双吟鬓，乾坤独病身。\n浊醪差可近，祇为有天真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"康大监善庆堂","author":"范梈","text":"大府声名旧，京华有此堂。\n栋梁深尽制，花竹净分行。\n世美尤当济，身名赖必扬。\n自公常退食，把易细焚香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日，和危太朴见贻","author":"范梈","text":"年年江海上，饮菊对重阳。\n又复兹辰至，都无少日狂。\n遥峰栖户碧，败叶拥池黄。\n只有长生事，于今堕渺茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日，简危太朴","author":"范梈","text":"疾风吹细雨，忽忽过阴崖。\n久喜江山静，新增节序佳。\n秋声连迥野，暝色起高斋。\n自得论文侣，中年有好怀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏夜，登后亭","author":"范梈","text":"县酌群山置，亭因古堞安。\n幸无多检校，于以小盘桓。\n潦倒渊明酿，凄凉子贱弹。\n杖藜听夜鹤，世虑苦无端。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖上值雪","author":"范梈","text":"农事伤下泽，官曹限穷年。\n崎岖尽所历，缱绻何由宣？\n窗明变松雪，室冷延山烟。\n少岁守恬淡，未敢轻弃捐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贵州","author":"范梈","text":"离思久不惬，幽情晚旋添。\n天宜明月独，山与宿云兼。\n蛩语通支柱，蛛丝映卷帘。\n若无光霁在，何以破朱炎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发横浦之永淳县","author":"范梈","text":"急桨开晨涨，孤尊已夕阳。\n水光排峡静，洲势背城长。\n太史才无敌，将军义不忘。\n感伤今岁月，淹泊愧沧浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄刘传之","author":"范梈","text":"故人去南海，已度百花时。\n万事须重到，孤舟何太迟！\n云迷帝子渚，月过伏波祠。\n幕府文书省，来须慰我思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚至沙塘","author":"范梈","text":"风雨病屡涉，烟山知几重？\n平湖番近服，大邑艾遗封。\n受粟常惭吏，看花正闵农。\n周原已遍度，明旦复何从？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月十一日，遣家人还舍奉侍，值雨。十四日，值晴作","author":"范梈","text":"具船闻解缆，想象系朝昏。\n到日初收雨，沿流定达村。\n初生南涧藻，好近北堂萱。\n载感飘零意，清江是故园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古木","author":"范梈","text":"谁擘苍烟破，依稀露老龙。\n偶违风雨会，遂感雪霜踪。\n飞动关元气，沉潜见物宗。\n何阶韦偃伎，千岁此相逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠别韩德卿归安西，因候萧司成","author":"范梈","text":"十年关陇道，文学老貂裘。\n久别重相见，相看更自愁。\n早膺朱绂宠，暂为白云留。\n寄谢萧夫子，岩栖向几秋？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄宿维扬驿，寄怀王仪伯","author":"范梈","text":"水墅见明月，适随归桌圆。\n故人在郡国，今夜隔风烟。\n何日征河内？\n常时诵颍川。\n经过因念此，书信赖流传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题靖节征士归来图","author":"范梈","text":"维公楚杞梓，作令晋衣冠。\n得志但恐暮，济时非所难。\n古今弦韵寡，岁月酒杯宽。\n渺渺山中去，深深画里看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吴生雨吟图还寄清江皮野","author":"范梈","text":"江雨四时昏，故人家远村。\n如何一见面，还又两忘言。\n老树经鲛泪，空花断雁魂。\n由来前日画，妙手出吴门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东斋秋雨后花药具有生意","author":"范梈","text":"田园虽尚远，未肯效凄凉。\n药就篱成蔓，花因径作行。\n岂惟延晚趣，自足信年芳。\n颇敬邻人妇，驱鸡不过墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中","author":"范梈","text":"世故只如此，予生今若何？\n不忧新食少，但喜好诗多。\n野鹤来濠上，山猿落涧阿。\n平时朝夕者，经岁不吾过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哀文集贤，时奉使南海道弃","author":"范梈","text":"瘴海距天关，道逾千万山。\n空传灵雨送，不见使星还。\n旌旆青枫暗，楼台白水闲。\n郡人惟我最，远客泪潺潺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠葛推官","author":"范梈","text":"五罚从容至，群生阨塞多。\n但无为已甚，勿问达如何。\n早读于公戒，终传召父歌。\n故人风雨节，为我数经过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"张别驾山居产玉芝","author":"范梈","text":"高秋别驾宅，异草吐奇芬。\n为尔掇白雪，服之乘紫云。\n但恐仙灵物，长遮虎豹群。\n待弃人间事，先报赤松君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠别李仝","author":"范梈","text":"士以才名重，君犹梗概先。\n间关百年道，浩荡九春天。\n不为歌弹铗，还寻与酒钱。\n古来自如此，相问涧西田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄高邮李使君","author":"范梈","text":"题诗报使君，春远楚江濆。\n剩水鼋鼍窟，低空雁鹜群。\n朱幡临野日，翠袖绕山云。\n早晚金鸾召，风流许细分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚兴","author":"范梈","text":"古寺山重掩，平田县对门。\n鹧鸪藏白昼，蟋蟀破黄昏。\n贝贾多通市，藷偷每近村。\n殷勤省风俗，慷慨动心魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"澄迈县，有苏内翰所题通潮阁，在海上","author":"范梈","text":"候馆驻征骑，西风独夜清。\n开门闻叶落，倚杖看潮生。\n有礼齐蛮俗，无歌学楚声。\n凄凉苏季子，行处足高名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"将行值暴涨","author":"范梈","text":"雨发蛮山涨，来从五指原。\n风桥初没马，到县已侵门。\n甚欲乘槎去，还思弃佩言。\n轻身犯南斗，信有北溟鲲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏荔子","author":"范梈","text":"思归江路永，荔子几时丹？\n祇念违亲久，何愁待尔难？\n园林有专美，霜雪莫留寒。\n记得珠崖道，长吟立马看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"细雨","author":"范梈","text":"细雨沾墙竹，轻风发槛桃。\n幕分流水静，楼抗远山高。\n但长琴书癖，宁知案牍劳？\n趋朝未觉懒，兴味属吾曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和谢梁内舍过访","author":"范梈","text":"承闻招隐处，独占万山清。\n乍见心如醉，多忧眼遽明。\n荐遗唐四岳，道付鲁诸生。\n欲理寻幽事，惟妨夜鹤鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河口","author":"范梈","text":"神女大河口，逸人阴洞中。\n船鸣谷雨浪，门掩荔枝风。\n鹤鹳行相背，乌鸦宿自同。\n为于百年内，试问鹿皮翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晨至西郭池亭，见新荷，有感时物而作","author":"范梈","text":"虚亭结构美，驿路带垣斜。\n山芗含晚翠，池响集春蛙。\n官荷已偃盖，僧蔬欲架花。\n俯仰宾从役，孰与测幽遐？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三山对月，怀山寿","author":"范梈","text":"豫章千里月，渐解向天高。\n安得山儿慧？\n能知海客劳。\n榕城咽韵鼓，竹馆净香醪。\n何日书帷下？\n清辉映凤毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚上南山观烧","author":"范梈","text":"渡口向寥阒，夕晖生翠屏。\n随风初绕电，翳雾忽如星。\n鸟兽蒸宜遁，柴扉照不扃。\n闽都春始过，雨洗合重青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庭草","author":"范梈","text":"为爱庭中草，经春坐不除。\n澄心皆净域，履道即安居。\n海气含楼阁，年光映簿书。\n昔人伤废事，作吏竟何如？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昨游","author":"范梈","text":"昨游居士涧，春入羽人丘。\n面面山相引，年年水自流。\n乾坤双蜡屐，江海一渔舟。\n知我能来否？\n啼莺去复留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪观雨后对薜老峰","author":"范梈","text":"高阁飞雨过，新凉连海隅。\n竹溪鱼板集，松寺鹤巢孤。\n吏隐非兼得，登临适自娱。\n盛名苏季子，犹是老征夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京下思归","author":"范梈","text":"黄落蓟门秋，飘飘在远游。\n不眠闻戍鼓，多病忆归舟。\n甘雨从昏过，繁星达曙流。\n乡逢徐孺子，万口薄南州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延平西峡","author":"范梈","text":"巨浪劈山倾，孤舟与浪争。\n逆飞天地肃，捷出鬼神惊。\n至险追前载，终身愿太平。\n不然忠孝理，值此各何情？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵曾五判官","author":"范梈","text":"磊落将军石，周游太史迁。\n世人宁见尔？\n我辈故超然。\n胆急投豺地，神销过鹄天。\n祇今谁可语？\n壮志必同年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠颠叟僧别二首 其一","author":"范梈","text":"问子家何在，名山越树春。\n来游万里道，去作五台宾。\n乞食宁忘禄？\n行歌若有神。\n曾逢陆脩静，招入社中人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠颠叟僧别二首 其二","author":"范梈","text":"未是真颠者，能颠故有余。\n试留吴郡草，为报揭阳书。\n带日辞铜马，投云听木鱼。\n南归定何日？\n白象守林庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送施处士还东溪","author":"范梈","text":"东溪子故物，归去一身轻。\n树晓雏莺坐，沙晴乳鹿行。\n乘舟不尽兴，罢钓忽忘名。\n忆我南山下，蘼芜绕舍生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"期出东郊不果却率便河闸桥诣张道人庵寻故旧作","author":"范梈","text":"却欲东郊去，还寻北渚来。\n江翻垂木动，风过杂花回。\n馗道迷朱毂，虚空见紫台。\n世氛浑不奈，忆得是蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阅友人壁间咏，有怀旧游","author":"范梈","text":"漫说经行处，云边第二春。\n石林投倦客，画壁跋高人。\n迹与风鹏转，心兼野鹤亲。\n平生许玄度，自比白头新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其一","author":"范梈","text":"书剑上青霄，乡关雨雪遥。\n年华侵水竹，客思堕山苗。\n会想商岩绮，将从郑里桥。\n文词诚小伎，祗比俗情饶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其二","author":"范梈","text":"岂是幽栖地，飞腾亦未量。\n城根分鼠壤，池面合鱼梁。\n名久喧郎署，歌时感女桑。\n畏卿音调苦，畴复贵相忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其三","author":"范梈","text":"圃色依帘障，天光切户庭。\n草生连夜雨，花落遍池星。\n未遂翔寥廓，真堪托晦冥。\n逢时须紫燕，得意拂青萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其四","author":"范梈","text":"亦欲依家耳，衡门斗极边。\n乡心征化鹤，宦径跕飞鸢。\n白日抛书送，青山拂槛延。\n风流自无已，忆上五湖船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其五","author":"范梈","text":"都无京国意，满眼旧生涯。\n壁隐崆峒木，毡蒙婀娜花。\n善邻垣故辟，爱客酒能赊。\n皦皦荒途子，音期只尔遐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其六","author":"范梈","text":"偶从耕凿事，便有古人风。\n井泻千畦碧，林然独杏红。\n世情何近远？\n宦秩自卑崇。\n任道流行意，雩坛或与同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其七","author":"范梈","text":"磊落人间士，名成定不虚。\n愿陈元有策，交荐可无书？\n莫遣从师苦，因将作吏疏。\n吾徒岂念此？\n愧尽马相如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李溉之园居杂咏八首 其八","author":"范梈","text":"丹柰花初结，朱樱子半成。\n寝兴因物变，筋力与年增。\n燕拂承尘去，蜂随曳杖行。\n玉泉几千仞，好在翠如倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重过太傅忠宪王园林","author":"范梈","text":"一代王章宠，于今胜地非。\n野池花自发，春日燕争飞。\n坐送笙歌密，衙迎剑佩稀。\n颇萦游子骑，脩景澹忘归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登觉山寺","author":"范梈","text":"远见浮图顶，逡巡及寺门。\n此行如有待，何地更无喧？\n山背斜阳恶，泉侵落叶浑。\n沉沉委台殿，多是赐金幡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种瓠二首 其一","author":"范梈","text":"岂是阶庭物，支离亦自奇。\n已殊凡草蔓，缀得好花枝。\n带雨宁无实，凌霄必有为。\n啾啾群鸟雀，从汝踏多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种瓠二首 其二","author":"范梈","text":"嘉瓠吾所爱，孤高更可人。\n不虚种植意，终系发生神。\n有叶诚藏用，无容岂识真。\n明年应见汝，众子亦轮囷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月菊","author":"范梈","text":"萧然故可爱，况在五侯家。\n未到三秋节，先开万点花。\n风霜宁未熟？\n岁月自云赊。\n惭愧青松干，昂藏照岛沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏简孔太祝","author":"范梈","text":"人间最好日，祇在菊花前。\n颇怪来今雨，相看语后天。\n门阶销俗客，冠佩切飞仙。\n愿约秋风住，长年泛酒船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘修撰赴湖南提举任","author":"范梈","text":"久淹词馆寄，新奉玺书还。\n白发临漳水，青云动楚山。\n文称一道重，政类百司闲。\n设有湘南骑，因之解别颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄李彦谦御史","author":"范梈","text":"古燕城下路，柳树落西枝。\n每到重来处，长怜欲别时。\n鹘飞平照急，鸥集远烟迟。\n此去秦州什，应须寄我知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒斋对雨书怀","author":"范梈","text":"冬暖久不雪，天分雨破颜。\n依稀才洒户，惨淡欲连山。\n垣屋重重密，壶尊独独悭。\n焉知魏阙士？\n隐与吏相关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客至","author":"范梈","text":"客至冠缨好，殊非旧友生。\n晓晴霜太重，冬暖日偏明。\n觉我肌肤弱，兴言感慨并。\n子云工赋述，切莫论公卿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅，和陈城南","author":"范梈","text":"我亦吴头客，年年念远梅。\n孤根元自植，冷蕊为谁开？\n因睹城南咏，深思岭表来。\n北人盆里看，应不近苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"守岁咏怀，次韵","author":"范梈","text":"大年在今夕，旅爵记前除。\n时序无闲事，江湖少定居。\n烛花分坐委，漏箭落城疏。\n底复穷庐叹，人生各有初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送贡仲实还江西","author":"范梈","text":"送行何太频，日日见行人。\n又复风霜节，相违旅病身。\n浮名非甚急，远意独难信。\n念子关劳苦，题诗莫待春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题友人山居","author":"范梈","text":"游居展静好，尽日有高情。\n竹下流泉过，花间时鸟鸣。\n因人问药裹，要我罢琴迎。\n本自无知者，山林颇近名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林尊师招不果，就别","author":"范梈","text":"甚欲抠衣去，仍烦折简呼。\n竟孤林下约，还想市间壶。\n野馆侵浓树，春波乱嫩芜。\n看云解榻意，秋露近玄都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野望","author":"范梈","text":"思远卑栖地，凭高独望辰。\n峡云低度晚，野水净含春。\n语鹤关梁迥，归鸿岁月新。\n不堪回首处，横笛倍伤神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游招提","author":"范梈","text":"胜地相从日，应无俗客踪。\n春花浓夹骑，昼树静藏钟。\n妙理端深得，佳游亦漫逢。\n怜渠丝与竹，舫上见西峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送白湛作尉金溪","author":"范梈","text":"离思已无极，尊前况夕昏。\n闭门六月雨，行李万重云。\n远禄年虽壮，名家代不群。\n县人迎主簿，应似大浮君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢师东谷怀城中诸友","author":"范梈","text":"契阔遽如许，淹留空复情。\n天遥一鹤上，山合百虫鸣。\n异俗嗟何适，冥栖得此生。\n平居二三子，今夜隔重城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]