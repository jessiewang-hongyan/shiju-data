[{"title":"观弈图","author":"贡性之","text":"笑杀王郎底事痴，斧柯烂尽不曾知。\n却抛尘世无穷乐，只博山中一局棋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画兰","author":"贡性之","text":"吴刚斫断云根石，不数珊瑚高百尺。\n美人林下独含愁，霹雳一声山鬼泣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过鉴湖二首 其一","author":"贡性之","text":"归思关心路转遥，打头风急滞兰桡。\n夕阳江上秋无数，血点蜻蜓立碧苕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过鉴湖二首 其二","author":"贡性之","text":"南风吹断《采莲歌》，越女船开小似梭。\n却恐红妆不成态，背人偷照鉴湖波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅二首 其一","author":"贡性之","text":"朔风扑面冻云垂，引鹤冲寒出郭迟。\n却忆西湖霜月下，美人相伴立多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画梅二首 其二","author":"贡性之","text":"江城钟鼓夜迢迢，霜月多情照寂寥。\n更有梅花是知己，小窗斜度两三梢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题菜二首 其二","author":"贡性之","text":"雨过畦蔬绿渐匀，呼童小摘慰情亲。\n个中滋味如谙得，不是寻常肉食人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冻凫","author":"贡性之","text":"江天岁晚景凄凄，云脚低垂望欲迷。\n水鸟畏寒飞不起，黄芦枝上并头栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"贡性之","text":"此生无梦到京华，到处溪山即是家。\n昨夜石桥新过雨，错教刘阮认桃花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅四首 其一","author":"贡性之","text":"美人吟苦减腰围，瘦影竛竮不自支。\n只有梅花是知己，相逢多在月来时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅四首 其二","author":"贡性之","text":"十年痴坐冷官毡，几度看花雪后天。\n白水同心如此调，载将春色上归船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅四首 其三","author":"贡性之","text":"万里无云月正高，翠禽啼断酒初消。\n灵均自是非知己，不写芳魂入楚骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅四首 其四","author":"贡性之","text":"寒气棱棱雪作晴，看花独自出郊行。\n北枝未吐南枝发，笑杀春光也世情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枯木图二首 其一","author":"贡性之","text":"湖石东头太液西，春风宫树半高低。\n王孙金弹多如雨，不著黄鹂一个啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枯木图二首 其二","author":"贡性之","text":"翠萝牵恨引丝长，黄叶将风战晓霜。\n莫怨一枝栖未稳，上林春树近昭阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白描海棠花","author":"贡性之","text":"美人睡起不奈愁，弄粉调朱只谩羞。\n閒倚绿窗春昼静，双鸾飞上玉搔头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"贡性之","text":"扰扰黄尘没马鞍，几人消得此中閒。\n绿阴清昼深如水，饱看溪南雨后山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题翠竹红梅","author":"贡性之","text":"美人燕罢酒初消，凌乱云鬟压步摇。\n莫遣翠禽啼梦断，醒来无处托春娇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"贡性之","text":"一江春水晚微茫，醉倚篷窗客思长。\n忽听箫韵云外落，松风轻度鬓丝凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅","author":"贡性之","text":"眼中谁识岁寒交，只有梅花伴寂寥。\n明月满天天似水，酒醒听彻玉人箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戴春雨","author":"贡性之","text":"长江烟水接蓬莱，百尺风帆破浪开。\n二月桃花春雨里，候人还向水边来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画翎毛","author":"贡性之","text":"莫怪幽禽雪满头，多情只为海棠愁。\n开元宫里千株锦，一夕西风起碧秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题肃万邦蒲萄","author":"贡性之","text":"忆骑官马过滦阳，马乳累累压架香。\n酿就琼浆三百斛，胡姬当道唤人尝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题美人图","author":"贡性之","text":"离离珠树隔秋烟，望断归帆信杳然。\n试问海山今夜月，不知何处照人圆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题红梅翠鸟图与唐愚士联句","author":"贡性之","text":"萼绿枝头翠羽鲜，春风早入艳阳天。\n几回梦觉频听处，正是书声欲断边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明思先垄","author":"汪克宽","text":"芳树晓烟鶗鴂鸣，澹云晕碧漏新晴。\n惊心时序百六日，回首家山十五程。\n病思为魔成逆旅，梦魂飞泪洒先茔。\n遥知兄弟溶溪上，细扫松花酹曲生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和唐宰山行","author":"汪克宽","text":"山县千峰叠，闾阎杂崄夷。\n雨香鱼拨剌，风软燕差池。\n郭外耕夫耦，桑中稚子嬉。\n弦歌声教远，民俗变浇漓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁亥四月十四日陪尚书公泽民游祥符寺分得煖字","author":"汪克宽","text":"芙蓉六六森如铲，乘舆登临寄疏散。\n绿沈灵湫老龙蛰，翠护祇园新竹短。\n山乐鸣空石洞寒，金鸡舐鼎丹炉暖。\n藓瘢拂拭读残碑，一浴灵泉客尘浣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送傅德谦还临川","author":"吴海","text":"傅君隘流俗，举步追古人。\n古人去已远，斯道为荆榛。\n出门抱高志，区区向谁陈？\n十年江海上，漂泊但一身。\n念我德不孤，邂逅遂见亲。\n相知宁苦晚，不觉逾三春。\n精微共探讨，议论发清新。\n谊合然诺重，途穷忧思频。\n如何语离别，使我意酸辛。\n酸辛不在别，欲留我何贫。\n闽水东赴海，楚山西入秦。\n春波正浩荡，谁能知其津？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游郎官峰","author":"吴海","text":"连山如波涛，高峰荡云日。\n萃然孤杓耸，其势孰可匹。\n危攀将欲飞，俯瞰觉自失。\n罗田几聚落，端坐见纤悉。\n南延川源深，北望海水出。\n处高视益远，缩地岂有术。\n天寒霜露交，收穫事已毕。\n仍年蝗旱馀，民物尽萧瑟。\n遘兹得非幸，惆怅宁具述。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游七岩寺同行诸君子","author":"吴海","text":"罗田众山中，七岩独高秀。\n经营将半载，宿愿始得副。\n缘云攀鸟道，十步九??。\n刚飙从北来，岩谷尽号噭。\n促步赴层巅，依石避野烧。\n郁然烟燄交，歘若雷电绕。\n其势吁可畏，僮仆尽惊走。\n须臾得少息，方觉性命有。\n列坐咸自庆，啖胾酌大斗。\n阴阳却变化，霏雨垂白昼。\n痴云迷海屿，昏雾失林薮。\n归途畏虎迹，惨惨暝色厚。\n幽怀莫能写，造次宜自咎。\n述此成短章，聊用纪邂逅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日燕东皋亭","author":"吴海","text":"展席俯清池，倚槛盼层巘。\n苗绿满平畴，草秀被长坂。\n风度荷气清，日移树阴转。\n长笑天为高，汎观心自远。\n良时会岂易，莫待岁华晚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送唐伯庸二首 其一","author":"杨翮","text":"江南一何秀，寄语北人道。\n翡翠戏兰苕，奈此颜色好。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送唐伯庸二首 其二","author":"杨翮","text":"诸父纡组绶，翁媪被封爵。\n盛年得逢此，光耀殊不恶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孔进道宰星子","author":"杨翮","text":"素王有贤孙，达尊在德齿。\n爵膺天子命，绾绶宰百里。\n南康控湖江，属县望星子。\n江右号嚣哗，斯地独醇美。\n帝眷礼义俗，择令烦为理。\n惟君当厥任，君志亦愿喜。\n扬帆溯洪涛，巨舰千图史。\n牛刀新发硎，割鸡聊用此。\n抚字定多暇，弦歌自今始。\n廉车察殿最，衡鉴在止水。\n会采襦裤谣，移书上风纪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送索都事赴浙东佥宪","author":"杨翮","text":"挟策事明主，出入承明庐。\n一为淮南宾，籍籍播清誉。\n制诏擢御史，行台在东吴。\n间岁升幕府，遄闻复超除。\n宾客出相送，饯饮西城陬。\n持节往何之，直指婺女墟。\n东瓯杭于越，会稽薄海嵎。\n行部列郡中，山川郁盘纡。\n长吏走上谒，县令为前驱。\n驷马何奕奕，高盖拥路衢。\n观者咸叹息，云是今大儒。\n谁言钟鼎贵，曾不由诗书。\n区区刀笔吏，安□遏亨涂。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上巳日燕饮","author":"杨翮","text":"閒居眷芳春，况乃修禊时。\n群贤毕倾盖，招宴酬素期。\n华馆挹奇观，嘉席延多仪。\n兰芬扬光风，藻色涵晴漪。\n末座聆高谈，雅抱摅遐思。\n虽微丝与竹，清兴良足怡。\n画舸翳中沚，繁声流四涯。\n俗情岂无乐，斯意非所知。\n千载一胜赏，继此当复谁。\n达者解其会，浩饮宁须辞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金溪县孝女庙乐歌三章 其一","author":"杨翮","text":"灵之来兮两旗张，导旌幢兮锵琳琅。\n缤晻暧兮相颉颃，并辎軿兮归故乡。\n归故乡兮民所望，昭肸蚃兮曶洋洋。\n庭燎辉兮夜未央，椒兰发兮郁芬芳。\n民报祀兮弗敢忘，心屏营兮咸肃将，灵格思兮民乐康。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金溪县孝女庙乐歌三章 其二","author":"杨翮","text":"灵之留兮澹容与，云凝凝兮翳堂宇。\n琼筵陈兮合箫鼓，列尊罍兮酌清酤。\n牲肥腯兮承雕俎，女巫进兮傞屡舞。\n诵神德兮歌颂举，孰捐躯兮悟时主。\n齐英英兮惟孝女，继兹今兮飨终古，灵醉饱兮民乐胥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金溪县孝女庙乐歌三章 其三","author":"杨翮","text":"灵之去兮将安之，俨欲旋兮猋上驰。\n互招摇兮烂祈祈，遵云路兮眷威迟。\n金有赋兮地不遗，竭赀产兮民力罢。\n我邑井兮咸熙熙，赖神惠兮独弗罹。\n千万祀兮神是稽，荐蘋藻兮答神釐，灵遄逝兮民聿思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬孔秀才","author":"杨翮","text":"达人乐高蹈，寒士耽远游。\n远游欲何之，禦冬无重裘。\n栖栖道路间，四顾谁与谋。\n温言忽相慰，庆惬复焉求。\n三复《缁衣》诗，调高安能酬。\n薄言写心曲，终觉怀惭羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游广教寺次李生韵","author":"杨翮","text":"胜日款禅宫，苍苔印屐踪。\n云间闻梵语，烟外听斋钟。\n树列千年桧，林深百尺松。\n明珠光错落，幽壑舞骊龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李德瞻壁间相看不厌图","author":"杨翮","text":"窗前图画胜玄关，怪石长松九夏寒。\n寄语山灵休厌客，清风明月好相看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晖楼者吴下顾君仲瑛就养读书之所也仲瑛日与昆弟子侄奉卮酒为亲寿临海陈敬初氏实记之余不自揆辄赋古诗二首或者歌以介寿仲瑛之志也其词曰","author":"沈右","text":"玉山之阳，延咢萦纡。\n有屋层出，君子之居。\n入奉父母，出与弟俱。\n有琴有书，以钓以渔。\n㶁㶁流水，深不可?。\n英英白云，迩而不迂。\n维春有晖，维德不孤。\n及尔孙子，永言乐胥。\n先哲有训，有典有经。\n淑尔君子，仰止景行。\n我来自东，春日载明。\n曰未觏止，中心怦怦。\n亦既觏止，我心则平。\n仰尔父母，及尔弟兄。\n既和且煦，令仪令名。\n升堂拜母，式表友情。\n维木有椿，有蔚其荣。\n维草有萱，有茁其青。\n韡韡常棣，有叶其生。\n有猗者兰，有烨者荆。\n有懿者德，有休者徵。\n乐只君子，百福来并。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵叔方先生兼简伯行敬初二首 其一","author":"沈右","text":"忆昔陪二子，吟啸野亭中。\n风急江花白，霜晴木叶红。\n去留身若寄，陶写兴无穷。\n更喜陈夫子，幽寻讶许同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵叔方先生兼简伯行敬初二首 其二","author":"沈右","text":"掩卷坐忘寐，书灯耿独明。\n年华劳发改，夜气与神清。\n感梦疑蕉鹿，挑愁赖曲生。\n何时重相觅？\n握手话真情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"叔方先生过咏归亭二首 其一","author":"沈右","text":"短棹相过莫便回，咏归亭上且低徊。\n升堂拜母称觞后，隔竹呼童瀹茗来。\n八尺驼尼分紫锦，一双蜡屐破苍苔。\n空江草木虽摇落，犹有寒花带雨开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中酒杂诗四句五首 其一","author":"沈右","text":"中酒如卧病，天寒露为霜。\n东轩候朝旭，暴背屡移床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中酒杂诗四句五首 其二","author":"沈右","text":"江头风浪急，舟小力难胜。\n一桨归来晚，长林月已恒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中酒杂诗四句五首 其三","author":"沈右","text":"太丘海岱士，肆情丘壑间。\n《考槃》诗赋罢，采菊对南山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中酒杂诗四句五首 其四","author":"沈右","text":"岁闰寒酒薄，风回水自生。\n杖藜随小步，极目大江横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中酒杂诗四句五首 其五","author":"沈右","text":"朋酒享公堂，农家尽涤场。\n县官薄税敛，田野足耕桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"沈右","text":"劝郎莫向花下迷，劝郎莫待醉如泥。\n临行更有分明语，枝上流莺休乱啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高尚书秋山暮霭图","author":"沈右","text":"高侯笔法妙天下，貌得江南雨后山。\n都是乾坤清淑气，兴来移入画图间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与慎独先生","author":"沈右","text":"东林薄酒试新尝，中有松花腻粉香。\n遣送颍川陈有道，书斋渴饮胜茶汤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题洛阳朝元宫","author":"谭处端","text":"宫门寂寂锁祥烟，古迹灵踪尚俨然。\n云罩连枝烹药鼎，霞生灵井溉丹泉。\n日魂炼就华胥国，月魄收将不夜天。\n紫诏师真归去后，未知孰继大罗仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游灵山寺","author":"谭处端","text":"閒閒云水访禅林，密密琅玕映碧岑。\n玉桂峰高尘不染，灵山寺隐境难寻。\n□交白雪匀铺玉，间隔黄花乱点金。\n清澈古潭秋静夜，桂花独现本来心。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀三首 其一","author":"谭处端","text":"挫锐摧彊作善良，顿然心法两俱忘。\n鼎中频起金刚焰，炉内常燃般若香。\n玉蕊乍芳惟独采，蟠桃初熟与先尝。\n莫言迢递华胥国，了了空虚路不长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀三首 其二","author":"谭处端","text":"为慕仙源景物长，涤除灵地布琼芳。\n南宫赤子居凉殿，北海乌龟住绛房。\n清净洞中囚白虎，无为山上牧青羊。\n自从鼎内云收后，常饮醍醐卧醉乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀三首 其三","author":"谭处端","text":"天机深远少人知，一粒刀圭午上持。\n雾卷古潭秋静夜，云收碧嶂月明时。\n蛟龙纵得囚离鼎，猛虎擒来锁坎池。\n炼就仙丹超造化，去奔蓬岛擅真师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述怀","author":"谭处端","text":"谭马丘刘四个师，逍遥自在做修持。\n周天磨鍊无穷宝，一片灵光自得知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游怀川","author":"谭处端","text":"云耕宝陆三千里，月破黄昏十万家。\n清夜碧潭澄皎洁，蚌吞银焰产丹砂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云屯山","author":"丘处机","text":"云屯山，云冥冥，天风动摇飞雨零。\n神奇幻怪不可测，千变万化无常形。\n云收雨霁杳无迹，但见群山罗翠屏。\n山高谷深复何有，白石磊磊松烟青。\n春风浩荡满山谷，直上似欲超天庭。\n心虚目极淡天阔，俯视漠漠环沧溟。\n昔居庵地走三郡，今为洞天朝万灵。\n虚空旧基作新观，万世不朽传佳名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烟霞洞四首 其一","author":"丘处机","text":"山云勃勃涌惊涛，海水漫漫浸巨鳌。\n极目下观千万里，扶桑依约见蟠桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烟霞洞四首 其二","author":"丘处机","text":"白石磷磷绕洞泉，苍松郁郁锁寒烟。\n碧桃花发朱樱秀，别是人间一洞天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烟霞洞四首 其三","author":"丘处机","text":"海上群山培塿多，姑馀高峻出陂陀。\n太平直与稽天翠，五岳高标未见过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"烟霞洞四首 其四","author":"丘处机","text":"海曲山河洞府低，蓬壶阆苑海东西。\n仙人玉女时游集，不许桃源过客迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青天歌八章 其一","author":"丘处机","text":"我初开廓天地清，万户千门歌太平。\n有时一片黑云起，九窍万骸俱不宁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]