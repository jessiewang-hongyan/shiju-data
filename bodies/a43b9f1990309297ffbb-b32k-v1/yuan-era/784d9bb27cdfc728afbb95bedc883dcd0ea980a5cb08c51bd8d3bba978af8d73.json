[{"title":"题陈氏潇湘八景图 其八 江天暮雪","author":"陈旅","text":"寒云不成雨，暝色凝江枫。\n巫峡梨花梦，飘浮过郢中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题虞先生词后","author":"陈旅","text":"忆昔奎章学士家，夜吹琼琯泛春霞。\n先生归卧江南雨，谁为掀帘看杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题班婕妤题扇图","author":"陈旅","text":"层城柘馆重徘徊，坐见瑶阶长绿苔。\n纨扇秋来定无用，君王方筑避风台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画梅","author":"陈旅","text":"处士桥边古岸隈，梅花偏向小园开。\n冲寒有客寻春去，移得晴窗雪影来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题雨竹","author":"陈旅","text":"江上鹧鸪留客住，黄陵庙下泊船时。\n一林春雨垂垂绿，消得晴风烂熳吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为张壶洲赋壶洲","author":"陈旅","text":"握日台高雨气收，扶桑凉影动瀛洲。\n珠林错落三华露，宝稼离罗五色秋。\n邻曲夜机鲛有室，空中烟市蜃为楼。\n颇闻云锦张高士，曾与壶公汗漫游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张真人代祠武当龙虎两山追赋","author":"陈旅","text":"桂馆祠官持羽节，名山两地蹑丹梯。\n共誇曼倩来金马，大胜王褒祀碧鸡。\n杵涧暝痕消雨石，杼岩秋影动星溪。\n蕙肴椒醑登瑶席，定有神光起畤畦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画图二首 其一","author":"陈旅","text":"青红楼观护烟霞，湖曲高亭竹径斜。\n日出炎埃生九野，松阴水石养苔花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画图二首 其二","author":"陈旅","text":"雨馀空翠转霏霏，杜若洲边小艇归。\n又为故人临野閤，江云日暮湿秋衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题泛舟图","author":"陈旅","text":"江云生白石，水木澹幽姿。\n双松出丛薄，翠色集遥枝。\n落日明极浦，楚岫正参差。\n美人鼓兰枻，岁晏将何之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"开玄堂下有两雁互浴盆池王真人命工绘为图","author":"陈旅","text":"玉麈山前紫雁飞，真人燕坐久忘机。\n馀不溪水连天碧，只借盆池浣羽衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵本元上人相别","author":"陈旅","text":"君向雷峰塔边住，诗成总在倚阑时。\n苏堤残柳凝烟小，葛坞閒云度水迟。\n衲子定回花绕屋，故人别后草生墀。\n相知不似相忘好，谁说庄周与惠施。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵韩伯清访句曲外史","author":"陈旅","text":"苕霅归来俗事稀，偶然携客款郊扉。\n渚霞落椀松花熟，溪雨登柈石菌肥。\n薄宦不閒惭折简，高人相见定披衣。\n平生愿究中黄秘，安得茅君指化机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题扇面","author":"陈旅","text":"娟娟翠袖倚清空，解把并刀剪雪风。\n一段寒香吹不尽，西泠残月角声中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题段氏扇子","author":"陈旅","text":"江上《竹枝歌》，为君颦两蛾。\n秋风团扇底，零落黛痕多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题马道士画","author":"陈旅","text":"江上群山翠作堆，人家门槛对江开。\n小楼应有凭阑者，天远归帆似不来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题水仙花图","author":"陈旅","text":"莫信陈王赋《洛神》，凌波那得更生尘。\n水香露影空清处，留得当年解佩人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题辽人射猎图","author":"陈旅","text":"美人貂帽玉骢马，谁其从之臂鹰者。\n沙寒草白天雨霜，落日驰猎辽城下。\n塞南健妇方把锄，丈夫边成官索租。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用吴彦晖韵送扬州张教授还汴梁二首 其一","author":"陈旅","text":"花边细马蹋轻尘，柳外移舟水满津。\n莫向春风动归兴，杭人半是汴东人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用吴彦晖韵送扬州张教授还汴梁二首 其二","author":"陈旅","text":"匆匆归去缘何事，要看扬州芍药花。\n定有金盘承绛露，送他梁苑故人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题竹石图","author":"陈旅","text":"蓝田水曲青玉立，雨过秋光满林湿。\n故人结屋傍幽崖，静爱石窗晴翠入。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高氏所藏画图","author":"陈旅","text":"谁家林麓近溪湾，高树扶疏出石间。\n落叶尽随溪雨去，只留秋色满空山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画兰","author":"陈旅","text":"九畹光风转，重岩坠露香。\n紫宫祠太乙，瑶席荐琼芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"艾氏心远楼","author":"陈旅","text":"闻子临川上，高楼万里并。\n兴来时独立，心与目俱行。\n野夕归鸿小，溪晴落木明。\n登临何日共，作赋写平生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李盘中真人代祀江南三名山","author":"陈旅","text":"弱水回风不受帆，三山只在大江南。\n使槎真带秋星湿，仙掌遥分夕露甘。\n琮玉礼神通景气，宝香随地结晴岚。\n泰坛建论昭灵贶，老我犹能效史谈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方壶道士作荒山白云图寄豫章杨显民","author":"陈旅","text":"之子读书处，乱山生白云。\n林花晴冉冉，岩瀑暝纷纷。\n画此何为者，持之以赠君。\n谓宜作春雨，舒卷只成文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次萨天锡韵","author":"陈旅","text":"燕南幕府文章客，泽国相逢宴集齐。\n酒后鲈鱼霜作鲙，花边骢马月为题。\n千篇杰句谐金奏，一曲离歌听玉啼。\n别后寒云满江海，雁书何处落青泥？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题韩伯清所藏郭天锡画","author":"陈旅","text":"往年京口郭天锡，学得房山高使君。\n画省归来人事少，烟岑间向客楼分。\n林扃暝落青枫雨，水郭寒生白蜃云。\n岁晚怀人增感慨，晴窗展玩到斜曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南山诗","author":"陈旅","text":"江左群山囿，仙丘倚太霞。\n上清分亢爽，南谷抱谽谺。\n台观黄琼宅，林峦赤虎家。\n天池开宝鉴，日井射金砂。\n桂霣秋岩粟，桃烘晓岸葩。\n泉香通美竹，云液嫩灵芽。\n俯涧松偏润，缘崖径自斜。\n幽亭宜水绕，晴阁受岚遮。\n神舄丹扃秘，玄关紫气赊。\n石桥留月色，银浦渺皇华。\n愿解延陵剑，终乘博望槎。\n临风一邂逅，食我枣如瓜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题罗节妇传后","author":"陈旅","text":"岁晚良人去未归，堂前有客著新衣。\n此身只为韩冯死，化作鸳鸯海上飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送潘泽民还江南诗","author":"陈旅","text":"之子来京国，侯门即曳裾。\n只求毛义檄，未献贾生书。\n野树山前合，江帆雨外疏。\n故人正相望，且莫赋《閒居》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"林外诗为夏生作","author":"陈旅","text":"幽人遁世入林间，林外高风况可攀。\n仲御偶然游洛水，黄公岂必在商山。\n春深溪雨流花出，日暮松云载鹤还。\n拓落尘中嗟我老，归欤无地可投閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题城市山林图","author":"陈旅","text":"城市山林路不分，昼桥骑马是徵君。\n树头粉堞连青嶂，陌上红尘乱白云。\n水巷柳深莺唤友，阳坡草暖鹿为群。\n滑稽谁似东方朔，更向金门避世氛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题耿氏所藏艳画","author":"陈旅","text":"五月风生水殿凉，绿杨深处奏莺簧。\n佳人偏爱临池坐，欲与荷花斗晚妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朱莲峰著书得官南归","author":"陈旅","text":"城东有客过吾庐，挥麈高谈逸气舒。\n金马岂无方朔伎，石渠今取夏侯书。\n沙堤老屋秋枫合，海浦归帆暮雨疏。\n我亦草玄官拓落，江南无地可耕锄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄鹂海棠图","author":"陈旅","text":"二月园池蜀锦殷，多情宫鸟喜来看。\n上林春色浓于酒，莫把黄金铸弹丸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题春宫倦绣两图二首 其一","author":"陈旅","text":"上阳宫树奏莺簧，蛱蝶罗衣逗暖香。\n睡思已随巫峡雨，綵丝偏与日争长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题春宫倦绣两图二首 其二","author":"陈旅","text":"绿树垂垂护宝阑，床头翠帕羃双鸾。\n阿鬟可是无情思，又见春风到牡丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24602,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅石","author":"陈旅","text":"还家不复羡浮荣，处士头衔字字清。\n愧我独无归隐地，上林春晚更听莺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24603,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴王纳凉图","author":"陈旅","text":"吴王台榭满汀洲，湖上风来暑雨收。\n坐拥红妆可娱老，市无赤米不教愁。\n采莲舟载烟岑晚，响屧廊通水殿幽。\n岁暮甬东宁有此，夜凉歌舞莫令休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24604,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄筌竹鸾图","author":"陈旅","text":"一窗晴色绿猗猗，群雀飞来占好枝。\n此竹几年方结实，空山秋晚凤雏饥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵友人京华即事二首 其一","author":"陈旅","text":"阿阁棱层羃晓阴，扶桑凉影映疏林。\n燕山北拥天都大，瀛海中涵月殿深。\n仙女乘鸾吹紫玉，才人骑马勒黄金。\n壮游偶结高阳客，无复临风动越吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵友人京华即事二首 其二","author":"陈旅","text":"落拓綀衣阆苑间，江南游子醉长安。\n禁沟春过留香雨，宫树风来响翠澜。\n五卫旌旗秋甸里，千官剑佩晓云端。\n何人只献河清颂，宜向明时沥寸丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵叔隆倦绣图","author":"陈旅","text":"龙绡碧幮挂秋水，藕风吹香团扇底。\n琵琶弹歇宫昼长，钗落云边九雏紫。\n二姝谁是薛灵芸，绣得金塘两鸳似。\n宫奴夕殿唤更衣，露湿银床响桐子。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为赵敬叔赋汉海兽蒲桃镜盖郑夹漈家故物也","author":"陈旅","text":"尚方老冶收精铜，金膏玉水开膧胧。\n未央晓月低青桐，六宫秋井生芙蓉。\n当涂妖鬼负神器，铜人登车数行泪。\n宝奁偶落长安市，永与人间照珠翠。\n凝阴空祭江心龙，海雨夜入闽王宫。\n一朝愁杀漈上翁，破屋日夜穿晴虹。\n西苑野露堪作酒，中有騊駼活欲走。\n赵侯得之莫失手，龙女鲛童俟之久。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郭孝子诗","author":"陈旅","text":"金台有孝子，郭氏名寿瑛。\n寿瑛执亲丧，昼夜闻哭声。\n负土起崇冢，栽松翳玄扃。\n瘦骨寒岳立，苦泪春河倾。\n视容日梅梅，一朝废双睛。\n复扶大母柩，冥行出芜城。\n愿言毕序葬，身瘵心则宁。\n里人问孝子，过毁圣所惩。\n孝子哭且答：我非敢伤生。\n有泪不哭亲，恶乎用吾情？\n亲死我目在，徒能视无形。\n黄泉相见日，无用此目明。\n吾闻寿瑛语，悲剧不自胜。\n昔人曾有言，五色令目盲。\n长年悦纷华，眉斧戕心精。\n视彼郭孝子，愧色能无赪。\n而我嗜读书，昏花散秋灯。\n思亲不能哭，涕泗空填膺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵氏人马图","author":"陈旅","text":"蒲桃宫前白面马，春日赐与近臣归。\n主人爱马不换妾，更与小奴裁绿衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵阿容参政省中夜坐","author":"陈旅","text":"上国群公集，秋深画省开。\n虚檐河影近，凉苑树声来。\n独坐多幽趣，高吟有逸才。\n平明当献纳，骑马踏轻埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"院中闻大驾先还再和伯修韵","author":"陈旅","text":"甘泉宴罢雁声寒，桂树吹香出宝阑。\n翠辇遥临秋海白，霓旌高拂曙星残。\n毡城家拜银麇赐，棘院人争绣虎看。\n堪笑子云能作赋，独骑羸马后奚官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三马图","author":"陈旅","text":"豹股龙膺百战馀，凌烟长藟载璠玙。\n时平不出横门道，愿为君王驾鼓车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送海丰刘巡检","author":"陈旅","text":"随牒游丹徼，春风骑气舒。\n蜑丁鸣鼓吹，鱼吏掌文书。\n浦屿烟霞远，村墟瘴疠除。\n石华肥可茹，无用脍蜛蝫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠莱州石工","author":"陈旅","text":"落星犹带天河湿，绝胜丹丘鬼血腥。\n琢作大樽休载酒，莱山柏露照人青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汾州北席里石氏节妇","author":"陈旅","text":"北里高楼昼掩扉，水铜光冷上苔衣。\n寸心誓比南山石，汾水秋风雁不飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋凝春小隐","author":"陈旅","text":"一窗花气袭人衣，窗底芳尘煖不飞。\n坐久砚池生石雨，海棠枝上雪都晞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王致道代祠北岳北海济渎南镇","author":"陈旅","text":"皇帝斋明守镇圭，祠官奉节出金闺。\n北寻海渎瞻恒岳，南涉江淮上会稽。\n山下灵风吹桂棹，云边仙树拂丹梯。\n王褒空有《甘泉》颂，投老还乡祀碧鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送项鍊师还天台","author":"陈旅","text":"不学东方朔，归寻马子微。\n人间无药卖，海上有云飞。\n谷煖金鹅大，溪深土鸭肥。\n当年种桃种，高过石楼扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毛真人南还","author":"陈旅","text":"真人不似壶丘子，老去都忘杜德机。\n左乙象文令虎守，尚方凫舄背人飞。\n岩扉煖翠侵缃帙，江渚晴霞上羽衣。\n游子故园春似海，客窗长日听催归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答都下友人二首 其一","author":"陈旅","text":"百金买骏马，千金买红妆。\n长安画楼上，饮酒吹笙簧。\n夭夭园中桃，郁郁陌上桑。\n美人越山下，白发生雕房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答都下友人二首 其二","author":"陈旅","text":"凉风振高梧，繁露集幽菊。\n揽衣起徘徊，残月照我屋。\n层襟郁孤清，日日尘眯目。\n银河在天上，手短不可掬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和康庸田鲁瞻公言怀韵","author":"陈旅","text":"震泽三江入堰潴，今年春雨又生鱼。\n汉廷数月宽租诏，鲁史元无告籴书。\n沟洫已非神禹迹，东西空引白公渠。\n袖中夙有匡衡疏，也拟金门候属车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城即事","author":"陈旅","text":"江城十日九风雨，骑马出门行紫苔。\n春草绿时犹作客，云山多处忽登台。\n青青野竹题诗去，小小吴姬唤酒来。\n漠漠候车乘早发，城东昨夜杏花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题木斋卷","author":"陈旅","text":"昔年种树不胜巢，老干今如屋脊高。\n屡许狙公分橡栗，时呼木客醉松醪。\n衣巾白日沾苍雪，枕簟西风梦海涛。\n岁晚淹留吾倦矣，借君丛桂续《离骚》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花幽禽图","author":"陈旅","text":"金塘花竹滟春红，枝上幽禽弄暖风。\n莫把残英都蹴尽，无情流水画桥东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题熊云巢竹石图","author":"陈旅","text":"道人种竹三千个，定有新巢宿凤凰。\n石上幽香飘露粉，檐间新绿袅风篁。\n天坛月白瑶笙近，水国春寒翠袖长。\n见说故人东海上，钓竿日暮倚扶桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李彦方副使入闽","author":"陈旅","text":"海邦赤子穷无告，诏遣儒臣著绣衣。\n天禄阁中书灏灏，越王山下马騑騑。\n鱼风满港榕阴合，燕雨侵帘荔子肥。\n一道澄清俄顷事，使星还向紫垣飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"建昌胡氏小有楼","author":"陈旅","text":"窈窕麻姑宅，登临忆谢公。\n近闻好山色，都在小楼中。\n屋曙丹霞吐，城深翠雨通。\n石池正当户，人立藕花风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题子昂江天钓艇图","author":"陈旅","text":"雨馀秋水满山前，正是江南落雁天。\n何处故人鱼艇小，乱蝉疏树夕阳边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"申屠子迪为山南宪掾白部使者毁夷陵曹操庙","author":"陈旅","text":"黄牛峡口滩声急，楚女传芭水庙秋。\n此地殷勤祠魏武，何人辛苦得荆州。\n莫令故国无遗祀，不见中郎尽发丘。\n千载有人伸大义，高风全似故安侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵子期使交趾","author":"陈旅","text":"晓日承恩紫殿深，都门祖道马骎骎。\n上书不奏唐蒙策，归橐宁将陆贾金。\n露入珠盘鲛室白，苔生铜柱象崖阴。\n为君临水歌《黄鹄》，天北天南万里心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]