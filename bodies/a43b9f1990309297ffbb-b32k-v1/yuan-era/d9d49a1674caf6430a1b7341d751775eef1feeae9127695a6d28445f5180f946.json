[{"title":"次韵子践秋社归岩南","author":"黄溍","text":"久悟清都是梦中，未嫌短褐任飞蓬。\n时情冉冉心如醉，世议纷纷耳欲聋。\n会种枌榆依汉社，共谈禾稼续豳风。\n蹉跎偶负平生约，已复人间岁一终。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭州寄里中一二同志","author":"黄溍","text":"故山有路去无从，灯火关心梦不通。\n浪走红尘真自笑，旧游白社竟谁同。\n胸中好贮千岩秀，眼底徐观万马空。\n风雨未休鸿雁断，此怀渺渺故难穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客楼雨中","author":"黄溍","text":"江城飘泊动经年，尽日高楼阅过船。\n睡起小窗初听雨，岸旁垂柳已生烟。\n坐抛岁月今如此，每望云山欲泫然。\n尚喜游从得诸彦，时将乐事寄新篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨山长归钱塘","author":"黄溍","text":"百里乡心海雁飞，三年官况野鸥知。\n儿童早已占归信，弟子应能颂去思。\n茅屋荒田春草草，杏花深巷雨丝丝。\n人生适意须行乐，驷马高车恐未迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"章德懋同登车盖山","author":"黄溍","text":"城南日日望苏湾，碧树童童盖一山。\n何意兹辰成邂逅，与君携手共跻攀。\n钩衣乱石通高步，着面和风启醉颜。\n尚爱铭碑多楷则，俗书且勿斗妖?。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖州遇叶士心因寄郭祥卿架阁","author":"黄溍","text":"谢公城下蹋春晖，最忆东园夜不归。\n落月清樽波潋潋，高花银烛雾霏霏。\n未愁强醉罗衣湿，政恐重来燕麦稀。\n大地风涛竟如料，九霄一鹄看横飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大卿牟公挽诗 其一","author":"黄溍","text":"云光一夕失崔嵬，多上相逢泪雨推。\n夹道共看丹旐去，遗民犹忆绣衣来。\n萧萧悲吹蘋花冷，渺渺乡山杜宇哀。\n哭尽贞元旧朝士，临歧无语重徘徊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大卿牟公挽诗 其二","author":"黄溍","text":"后生无复望仪刑，青史徒烦列姓名。\n穷有遗文成钜冢，死无新爵上铭旌。\n瓜田方任蓬蒿没，玉树偏依雨露生。\n旧笏满床知未坠，翰林风月向来清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵牟主簿南湖客中","author":"黄溍","text":"遥望仙桡度碧湖，翩然高兴不枝梧。\n也知白发行相待，无奈青山不受呼。\n过眼光风殊猎猎，沾衣多露已涂涂。\n相逢幸及南枝好，一笑聊须引百壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵姚子敬教授筠庵别业","author":"黄溍","text":"故园烟树渺江关，长愧求閒未得閒。\n客路独愁黄叶下，高人正在白云间。\n卜邻傥遂容依止，载酒终期共往还。\n未害看山仍拄笏，一竿付我钓沧湾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵别程晋辅教授","author":"黄溍","text":"落拓江湖久不归，相逢还及试春衣。\n忽闻烟际兰桡动，谁共花前玉斝飞。\n青眼故多知己在，黑头未觉壮心违。\n赤霄孔翠吾何望，喔喔邻鸡尔自肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"草意","author":"黄溍","text":"澹烟斜照旧离离，吐漫芳心欲向谁。\n可是忘忧能自得，若教指佞定无私。\n东风江上何人识，南国春来有梦知。\n留取青青承雨露，术应红紫浪相疑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阙下口号","author":"黄溍","text":"遹骏先猷在作人，忝陪多士奉明纶。\n端闱乍启清光近，胪句高传茂典新。\n奎壁照临回景运，风雷鼓舞契昌辰。\n不才何以酬天造，徒咏菁莪乐至仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赐第后归谒郡府承为置宴口号","author":"黄溍","text":"拜赐才沾雨露香，又惊盛典出黄堂。\n鸣驺合遝迂千骑，坐席雍容累百觞。\n他日同乡修故事，不才终古被馀光。\n承宣得意逢明牧，诸彦能无共激扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郡厅宴集之明日乡先生复为置酒重述口号","author":"黄溍","text":"去年此日宴琼林，雨露光华映古今。\n称庆谬承宾礼重，徼荣弥觉主恩深。\n少须天诏从容至，坐看宫花取次簪。\n千载斯文寄来哲，可应外物累初心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜赵继道至有怀陈君采","author":"黄溍","text":"匆匆聚散定何常，耿耿心期故未忘。\n草木关情人事异，云霄回首路岐长。\n交游历落银河隔，制作纷纶瑞锦张。\n为语何时共倾倒，秋床风露已生凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄曹子讷于寿道二同年","author":"黄溍","text":"忆同鹄立簉天关，清漏无声虎豹闲。\n黄榜未开齐望拜，紫衣高唱遽分班。\n已惊恩出寻常表，更羡身居季孟间。\n海国邻疆幸无远，可容接武向蓬山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄别宋推官","author":"黄溍","text":"目断仙帆去莫从，翩然心逐北飞鸿。\n未忘绿幕追游盛，况忝黄堂礼数崇。\n南国几人歌召伯，汉廷有日相于公。\n悠悠聚散何堪计，趋走终期出下风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送姜学录","author":"黄溍","text":"短褐萧条两鬓苍，逢人犹解说春坊。\n云霄有路新推毂，风月传家旧佩囊。\n此去官曹虽冷落，不妨门户暂辉光。\n况闻寮友多华胄，休暇过从乐未央。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送盐官傅都目","author":"黄溍","text":"春风匹马去翩翩，老佐名州鬓未班。\n遥数驿程知到日，坐令官府静如山。\n河塘灯火机声里，墟落盐烟海气间。\n历历旧游如梦寐，可容乘兴一追攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送贡教授致仕归里","author":"黄溍","text":"宦情乡思两依依，独裹寒毡去若飞。\n岁晏忍为千里别，林间惊见一人归。\n官河远树迎仙棹，夕日暄风飏綵衣。\n漫使临歧生怅望，可容泉石借馀辉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送三高祠陆主奉","author":"黄溍","text":"垂虹古祠烟树新，昔贤高致久无闻。\n画图想像空陈迹，谱谍流传喜到君。\n春水白鸥分座席，寒泉秋菊荐炉熏。\n临歧何限沧洲意，目断风帆天际云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈推官之信州","author":"黄溍","text":"三朝两世掌丝纶，异代仍瞻玉树新。\n尚喜传家馀宦谱，又闻议狱用儒臣。\n中年离别情何限，南渡风流迹未陈。\n遥想郡斋多暇日，肯怜州县正劳人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送胡古愚兼简道传博士","author":"黄溍","text":"坐拥皋比十载馀，忽闻飞鹗上公车。\n此行未可轻投笔，随处犹须小曳裾。\n灯火尚惭馀事在，云霄转觉故人疏。\n为言留滞今头白，无用诸公荐子虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送淮海书院丘山长","author":"黄溍","text":"遥望官河驻綵桡，春深绛帐不萧条。\n已惊雨露恩光厚，还喜山川物色饶。\n尽日楼台人载酒，隔江灯火夜吹箫。\n定知馆下多才彦，政乐风雩对一瓢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留别钱翼之","author":"黄溍","text":"矫首清标二十霜，白头倾盖郑公乡。\n忘形肯厌追游数，借润频飞翰墨香。\n世态浮云看不定，别情流水去方长。\n杏花时节霏霏雨，谁共春风举一觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诸暨休日偶书","author":"黄溍","text":"一室萧然似冷官，更无车马驻江干。\n天清不断丝丝雨，春浅犹生阵阵寒。\n公事痴儿何日了，云山图画要人看。\n轻风正满微黄柳，谁与相从试凭栏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答徐文蔚","author":"黄溍","text":"一别溪头十五春，归来乌帽尚黄尘。\n故应用意崎岖外，未忍忘情寂寞滨。\n图画云台非我事，挂冠神武独何人。\n也知州县徒劳耳，相见空惭白发新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送顾仁甫上计京师","author":"黄溍","text":"忆昔曾随计吏行，浮湛州县竟何成。\n凉风袅袅仙舟去，夕日依依魏阙情。\n金匮故藏多钜典，石渠高论尽鸿生。\n栖身朱墨非君事，早晚公车上姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送沙彦文架阁分题得西山","author":"黄溍","text":"忆昔寒江破浪归，西山回首落烟霏。\n忍逢朝士登舟去，如望仙人拔宅飞。\n游戏何妨依绿水，追趋早已到黄扉。\n公馀若过滕王阁，为捲朱帘挹翠微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题高远楼","author":"黄溍","text":"闻道危楼架泬寥，楼前物色不萧条。\n窗临谢傅祠边树，门对曹娥渡口潮。\n解使诗人争应接，也知老子极风标。\n倦游已忘山阴路，胜饯仍须折简招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题东柯谷图","author":"黄溍","text":"长松密竹翠交加，洞府新开碧海涯。\n石上仙人留足迹，春深涧水出桃花。\n流传图画来千里，生长儿孙只一家。\n目断飞鸿那可到，旧游空指赤城霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻赵继清调安陆县尹","author":"黄溍","text":"慈恩塔上墨犹鲜，一别重来十七年。\n相见都门惊判袂，又闻泽国去鸣弦。\n素衣久出风尘外，青琐行依雨露边。\n跂马望君先数日，县花虽好莫留连。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毕县尹","author":"黄溍","text":"归途环佩晓珊珊，白日青天映羽翰。\n疑是省亲辞太学，惊闻出宰用郎官。\n花迎墨绶春光暮，风引仙舟海色寒。\n想见捧觞仍綵戏，乡人争作锦衣看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵题刘氏石壁精舍","author":"黄溍","text":"佳城杳杳隔千峰，精舍寥寥一径通。\n夜静寒泉犹映月，秋深老树不惊风。\n旧题尚喜苔碑在，高卧无令蕙帐空。\n我已倦游今白发，有山如此愿长终。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和外舅主簿公自为挽诗","author":"黄溍","text":"五十年前马上飞，青春如水去难追。\n一从玉树歌残后，数到黄粱梦觉时。\n李贺元无楼可记，刘伶漫有锸相随。\n少须海上蟠桃熟，归簉仙班恐未迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留别一公琳公","author":"黄溍","text":"浪走红尘鬓已丝，此身端合老岩扉。\n兴来复举山阴棹，别去仍留海上衣。\n夜听泉声如雨落，晴看天末有云归。\n浮萍飞絮何时定，空使诗人赋式微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送傅汝砺之安南","author":"黄溍","text":"南徼车书路不遥，秋风使节下青霄。\n颇闻僚佐登才彦，应有文章达教条。\n日照楼船江水活，天低铜柱瘴云消。\n归时岭上梅花发，想见诗囊未寂寥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送式公归高丽","author":"黄溍","text":"一锡凌空海上飞，星河荡漾宿云披。\n颇惊辽鹤归来晚，正值骊龙睡觉时。\n百尺珊瑚无地种，六花薝卜任风吹。\n高秋兰若烟波外，此乐应须久自知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宁节妇诗卷","author":"黄溍","text":"春旗柳色映门闾，华扁新题节妇居。\n作传小裁青竹简，疏封近降紫泥书。\n河壖松柏风烟外，阶戺芝兰雨露初。\n三釜及亲殊未晚，花前何日奉安舆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孔御史归曲阜","author":"黄溍","text":"清流共喜聚群贤，新渥时闻下九天。\n东观紬书何日了，中丞遗笏要人传。\n过家莫久依林庙，封事先须彻御筵。\n千载斯文寄来哲，临分握手重悬悬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送谢仲连小鹿巡检","author":"黄溍","text":"而翁许史旧家声，遗子黄金不满籯。\n坐拥斋炉惊岁晏，出乘边障属时清。\n游山定复多新句，饮酒何妨得老兵。\n愧我白头官尚冷，夜深仍对读书檠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送乌编修代祀海岳南镇兼简明善隐君","author":"黄溍","text":"承明退直马如龙，将指祠庭礼数崇。\n岳色非烟生近甸，川灵藏器出幽宫。\n周原共识皇华使，禹穴谁陪太史公。\n亦见安阳韩处士，为言客鬓已秋蓬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张武定公死事诗卷后","author":"黄溍","text":"古称马革裹尸还，祗有空言世共传。\n一死如公良伟甚，百年遗庙独巍然。\n要从身后观馀烈，试听军中奏凯还。\n文武衣冠方迭起，后先奕叶更绵绵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王君冕同年芳润亭","author":"黄溍","text":"花县归来昼寂寥，终南山翠涌亭皋。\n林深未觉兰荪变，天远何妨雨露高。\n此去溉根须食实，谁分剩馥与残膏。\n行看小试挥毫手，香雾霏霏滴凤毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题丁文苑同年哀词后","author":"黄溍","text":"自别琼林雨露边，江湖目断绣衣前。\n禹门尚想龙初化，辽海惊闻鹤已仙。\n烈日秋霜空耿耿，重山宿草正芊芊。\n不才后死知何用，坐对诸郎独泫然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尉彦诚道州经历","author":"黄溍","text":"一别垂垂四十年，朔风吹鬓两苍然。\n寒毡久坐归何日，上幕初登望若仙。\n莫使催科书下考，盛谈名理继前贤。\n春生马首逢回雁，并写相思入近篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈君归江西","author":"黄溍","text":"咫尺清光近玉除，姓名何不达公车。\n也知贾傅今无策，犹幸虞卿旧有书。\n江上归帆随去雁，年来旅食厌骑驴。\n诸公正索山人价，能勿相招学隐居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵苏侍郎平村暮归","author":"黄溍","text":"中台多暇独仪曹，退食归来路不遥。\n扶老未须苍玉杖，行春聊过赤阑桥。\n挥毫风雨倾三峡，听履星辰接九霄。\n愧我白头方倚席，敢将巴曲和仙韶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送尚子正理问","author":"黄溍","text":"上相分临控列州，理官高选用儒流。\n风生使节声华旧，地近台垣宠数优。\n南土政平多暇日，西山气爽入新秋。\n公馀若过滕王阁，烦为题诗在上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送苏伯修宪使","author":"黄溍","text":"久参法从侍凝旒，忽拥幨轺按列州。\n太史山川皆熟路，淮南草木自生秋。\n遥瞻龙节辞中禁，尚想鳌峰接俊游。\n樗散郑虔无所用，幸搜岩壑副旁求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王止善检挍","author":"黄溍","text":"官无失政吏无私，钩挍宁烦事细微。\n遥想名曹多暇日，不妨高咏发清晖。\n潮生江上仙舟迥，春到湖边驿使稀。\n送尽北来南去客，石田茅屋几时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送高唐李知州","author":"黄溍","text":"来登延阁预时髦，出守名州领教条。\n已羡汉儒知吏事，要观齐俗变风谣。\n双旌前路方迢递，八座家声未寂寥。\n此去行须归报政，鸣珂几日造昕朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送傅汝砺广州教授","author":"黄溍","text":"耻学山人赴辟书，勇随使者驾轺车。\n横经久合居高座，上冢应须过旧庐。\n黑夜文星南斗外，青冥鹏路北风初。\n来期莫落梅花后，待诏先生席正虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘遂初修撰","author":"黄溍","text":"近闻退直自承明，忽报扬镳出凤城。\n未老已嫌金带重，暂归不著绣衣行。\n故人尚作瀛州客，岁晚无忘魏阙情。\n临别赠言聊复尔，谁能持酒劝公荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送于指挥归密州","author":"黄溍","text":"故山东望路何长，远奉灵輀返寿藏。\n予告公朝存旧典，疏封泉壤发幽光。\n总戎行复开油幕，儤直仍须赴玉堂。\n它日过家如上冢，岁寒松柏正苍苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书巢张君挽章","author":"黄溍","text":"岁晚巢居寄一枝，上林无树可相依。\n不随叶县飞凫去，竟作辽东化鹤归。\n架上牙签书在否，门前珠履客来稀。\n春江如箭船如马，忍见舟旗飏落晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵伯雨腊月八日雪中同登来鹤亭","author":"黄溍","text":"兴来欲泛山阴雪，不奈舟胶野水凝。\n朝士白头愁独步，仙人赤脚傲层冰。\n招来尽是鸡群鹤，趍附空惭骥尾蝇。\n夜久松龛同拥毳，绝胜儤值有青绫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至大庚戌正月二十一日予与儒公禅师谒松瀑真人于龙翔上方翰林邓先生适至予为赋诗四韵诸老皆属和焉后三十一年是为至元辛已正月二十三日过伯雨尊师之贞居无外式公刘君衍卿不期而集辄追用前韵以纪一时之高会云","author":"黄溍","text":"庐山旧事谁能继，三十年前此会同。\n偶尔共来今日雨，萧然犹有古人风。\n坐深遥对花如雾，兴尽徐归月在空。\n仰止前修那堪作，聊追馀响托无穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送史景福","author":"黄溍","text":"十年相望各天涯，上幕新开鬓未华。\n日出公庭来雁鹜，风生老笔动龙蛇。\n蜀乡路远春多雨，江国云深树有花。\n若见君家彭泽令，为言且莫问桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"府判谢公挽章","author":"黄溍","text":"换得朝衣不称身，勇辞新爵号遗民。\n鍊成偃月炉中药，阅遍铜驼陌上人。\n鲁国灵光俄委地，谢家玉树正伤春。\n忽闻旧唱贞元曲，衰涕能无洒石麟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月十二日上京翰林开院喜雨院长开府公俾为诗以志之","author":"黄溍","text":"雨浥鳌峰长绿苔，佳辰良会玉堂开。\n凉生薰殿宸居近，恩予官壶诏使来。\n尽醉不愁骑马滑，新诗可待片云催。\n作霖正尔须公等，行见文星入上台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"安南遣使入朝用故事奉贽纳谒于翰林其归也上介黎括以赠言为请赋诗四韵以遗之","author":"黄溍","text":"上圣敷文格远人，外藩修职用儒臣。\n并驰使介踰丹徼，特设朝班觐紫宸。\n炎海计程归路永，都亭燕饯宠光新。\n祗承德意勤宣布，鼓舞鸢鱼咏至仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]