[{"title":"西湖春日壮游即事 其八","author":"马臻","text":"紫染春罗窄袖裁，伶人楚楚自诙谐。\n部头教奏金娥曲，尽向船棚一字排。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其九","author":"马臻","text":"笙歌箫鼓沸春涛，耳目难禁应接劳。\n院落鞦韆谁氏女？\n綵绳掷起过墙高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十","author":"马臻","text":"万柳摇金接画桥，一清堂外景偏饶。\n文章太守开华宴，预报龙舟夺锦标。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十一","author":"马臻","text":"歌妓娉婷画不成，去年初籍教坊名。\n新腔翻得梨园谱，喜入王孙喝采声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25904,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十二","author":"马臻","text":"园丁花木巧杯棬，万紫千红簇绮筵。\n折得青梅小如豆，献来还索赏金钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25905,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十三","author":"马臻","text":"揉蓝染水翠浮山，堤上亭台锦绣间。\n花柳禁人攀折去，要留春色大家看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25906,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十四","author":"马臻","text":"进馀薇露与流香，散落人间任品尝。\n处处旗亭招客醉，大书不是赶春场。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25907,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十五","author":"马臻","text":"珍禽翠羽养雕笼，列向船头尽不同。\n怜杀锦鹦偏解语，唤人提挈避东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25908,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十六","author":"马臻","text":"豪家游赏占头船，趁得风轻放纸鸢。\n手拍丝轮争上下，一时回首看青天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25909,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十七","author":"马臻","text":"娇民技艺也天生，斗巧搜奇事事能。\n稚子土宜偏剧戏，浪儿黄累十三层。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25910,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十八","author":"马臻","text":"一路亭台间酒家，渐看杨柳绿藏鸦。\n太平官府无民讼，补种沿堤四季花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25911,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其十九","author":"马臻","text":"画船过午入西林，人拥孤山陌上尘。\n曾被弁阳模写尽，晚来閒却半湖春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25912,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二十","author":"马臻","text":"要嘱园丁取折枝，红桃白李紫蔷薇。\n石函桥畔人烟晚，挑得春光一担归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25913,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二十一","author":"马臻","text":"遥看暝色下渔汀，金鸭香消酒半醒。\n倒转船头元有意，槛边人报放流星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25914,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二十二","author":"马臻","text":"天街夜市已喧阗，半掩城门玉漏传。\n笼烛绛纱争道入，湖心犹有未归船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25915,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二十三","author":"马臻","text":"送得春归夏又初，名园不放玳筵虚。\n只知富足家家事，肯为儿孙教读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25916,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二十四","author":"马臻","text":"惯见升平春复秋，分明往事昔年游。\n西林桥外青山色，几度夕阳人白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25917,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居","author":"马臻","text":"一径荒凉长碧苔，竹门斜对远山开。\n自操清白传家谱，不受青黄致木灾。\n穴鼠苦衔诗稿去，溪螯喜荐酒尊来。\n东篱满地金钱菊，多谢西风为剪裁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25918,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题唐十八学士图","author":"马臻","text":"唐家天子尊黄屋，大业隆兴调玉烛。\n当年十八登瀛仙，弘文日侍分三六。\n两京初定四海清，君圣臣贤古难续。\n立本图真亮为赞，遂令书府藏诸椟。\n后有龙眠传此本，礼乐衣冠激流俗。\n自从沦落向人间，画手纷纷互翻覆。\n千年事去君莫问，留得青编遣人读。\n萧萧马耳射东风，长安道上春山绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25919,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其一","author":"马臻","text":"径曲交加锁竹阴，不教宠辱到林扃。\n心閒莫道浑无事，粉落松花污鹤翎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25920,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其二","author":"马臻","text":"参天杨柳手亲栽，一院西风户牖开。\n落日尚馀三四尺，山平水远看秋来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25921,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其三","author":"马臻","text":"小春天气未生寒，缀树朱栎正入看。\n昨夜海棠开数朵，一双蝴蝶上阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25922,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其四","author":"马臻","text":"新霜尚薄树声乾，寒水无痕倒浸山。\n知是钓船归较晚，鵁鶄嘎嘎起芦湾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25923,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其五","author":"马臻","text":"饱霜紫芋细凝酥，旋拨寒灰出地炉。\n惭愧邻家新酒熟，客来酤得满葫芦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25924,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其六","author":"马臻","text":"萧萧野老发垂肩，家住湖西杜若烟。\n载得茭根入城卖，西风落日满归船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25925,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其七","author":"马臻","text":"风琴流响韵虚堂，湘簟攲眠水一方。\n静里数声棋剥啄，乳莺深向绿阴藏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25926,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其八","author":"马臻","text":"槐阴满院喧巢鸦，蜜房香老蜂趁衙。\n邻家艇子钓鱼去，水光摇动金莲花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25927,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其九","author":"马臻","text":"北风小雨戒新寒，隔水枫林叶已丹。\n莫道閒门知己少，白鸥飞去又飞还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25928,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其十","author":"马臻","text":"燕山楚水曾为客，惯听霜砧捣月明。\n不似新愁怕新雁，秋风吹落两三声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25929,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其十一","author":"马臻","text":"晴日穿花煖似烘，风檐微动玉丁冬。\n山童睡起心无事，斫得筇枝补鹤笼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25930,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谩成四十二首 其十二","author":"马臻","text":"云归雨歇湖水平，五色螮蝀山边明。\n唱歌舟子采菱去，十里柳堤蝉乱鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25931,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次筠轩诗韵","author":"马臻","text":"幽轩列万竹，惬此冲澹襟。\n乃知心迹远，不在山林深。\n客散动秋影，鹤归分夕阴。\n至乐寓言外，任鼓昭文琴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25932,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画意四首 其一","author":"马臻","text":"红尘海里懒低颜，石路迢遥入乱山。\n拟向云边种黄独，几时容我屋三间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25933,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画意四首 其二","author":"马臻","text":"江花江草映江楼，写出江天一片秋。\n隔岸小桥低数尺，淡烟消处见渔舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25934,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画意四首 其三","author":"马臻","text":"幽人自乐山中趣，閒访山家入山去。\n记得西峰阿那边，乱云遮断无寻处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25935,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画意四首 其四","author":"马臻","text":"缘溪路滑蹇驴迟，水色山光总入诗。\n还胜襄阳孟夫子，满身风雪灞桥时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25936,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和山村见寄诗韵二首 其一","author":"马臻","text":"休将野服染缁尘，大患须知为有身。\n药饵任从留过客，是非终不到閒人。\n山中相隐怀弘景，谷口躬耕羡子真。\n午睡醒来春事晚，枝头梅豆已生仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25937,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和山村见寄诗韵二首 其二","author":"马臻","text":"不成一事鬓先皤，朋友偲偲喜琢磨。\n千里音书归雁少，满城风雨落花多。\n迸阶新笋微过竹，脱茧春蚕欲变蛾。\n惆怅少陵身老大，壮心激越醉时歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25938,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浙江晚眺","author":"马臻","text":"昔年吴越事并吞，留得青山只断魂。\n落日正明渔浦渡，归鸦遥点范家村。\n云分雨脚回沙溆，帆趁潮头出海门。\n欲问凄凉千古意，鸱夷何处有儿孙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25939,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集句和陈渭叟见寄诗韵二首 其一","author":"马臻","text":"寒食离家麦熟还，不应空老道途间。\n会须伐竹开荒径，剩著溪南几尺山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25940,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集句和陈渭叟见寄诗韵二首 其二","author":"马臻","text":"池边月影间婆娑，卧听行云一曲歌。\n閒忆昔年为客处，囊中无物只诗多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25941,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集句遣怀","author":"马臻","text":"懒慢无堪不出村，当年心事与谁论。\n如今老去愁无限，雨打梨花深闭门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25942,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游龙井方圆庵阅宋五贤二开士像","author":"张雨","text":"独寻招提游，果得世外欢。\n昔贤所栖集，画像藏屋端。\n山僧启锁鱼，不待啜茗乾。\n修广各异制，精采俱生完。\n堂堂苏长公，英气邈难干。\n筇杖紫道服，天风吹袖宽。\n清献薄须眉，示我铁肺肝。\n尚馀所施物，片石椭而寒。\n侍郎胡金华，高括侍中冠。\n眉间可容掌，手版出中单。\n颍滨与淮海，秋色亚层峦。\n参寥独缁衣，颔髭茁茅菅。\n最后辨才师，文茵高座安。\n空山一室内，举目皆龙鸾。\n再拜倾挈壶，喜极重悲酸。\n去之三百载，归路何漫漫。\n斯人为列星，下视虫沙繁。\n宁不念学子，道术救彫残。\n抵舍亟摹貌，微哉难控抟。\n梦中傥未遇，展诗时一观。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25943,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无波古井水","author":"张雨","text":"古井何泓然，不食自甘冷。\n去来绝攀缘，挽断辘轳绠。\n唯有中宵月，圆中时照影。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25944,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清权尊师集中览庚戌见怀一诗感念今昔自伤之情","author":"张雨","text":"天既劳我晚，不如早息我。\n奚止七不堪，于世无一可。\n空山酒半瓢，秃发花三朵。\n平生仲长统，谁能曲如锁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25945,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"种树","author":"张雨","text":"植梓五十本，移松八百栽。\n山灵借好雨，似为道人来。\n青意争郁勃，细声亦吹洒。\n松如稚子长，梓长未盈把。\n吾衰讵能待，将以荫来者。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月十三夜对月","author":"张雨","text":"幽篁不见天，况乃见月色。\n晴来春尚佳，岂不有馀日。\n离离花气上，稍稍帘阴直。\n啼鴂夜不眠，声欲碎岩石。\n闻声思逾寂，悟赏在兹夕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独行","author":"张雨","text":"春泥未成沙，曳屣柔且平。\n春风不鸣条，振衣凉且轻。\n我意本静惬，中林便独行。\n松盖无曲影，水乐皆全声。\n踽踽迫前冈，悠悠度斜坑。\n老樵眼如猫，见我不问名。\n直赠金光草，疑是古先生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪元镇玄文馆会饮","author":"张雨","text":"亲知贵浃密，屡此良宴会。\n堂陛自崇广，促席归卧内。\n说诗盛使气，屈折高李辈。\n更端辄笑谑，知节已沾醉。\n玲珑檐花乱，萧屑风竹碎。\n政使韩伯休，移床夜相对。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听雨楼","author":"张雨","text":"雨中市井迷烟雾，楼底雨声无著处。\n不知雨到耳边来，还是耳根随雨去。\n好将此语问风幡，闻见何时得暂閒。\n钟动鸡鸣雨还作，依然布被拥春寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里聚扇上写山次韵题","author":"张雨","text":"翠水丹山气旁礴，几叠香痕经手握。\n何年破镜飞上天，吴淞水剪并刀薄。\n江南宝绘多遗馀，王孙不归恨蘼芜。\n蘼芜消歇秋风起，班姬为我歌乌乌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25951,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王时敏听雪斋","author":"张雨","text":"顽寒赑屃河流澌，银涛铁骑交奔驰。\n珑玲淅簌瓦沟满，坐窗已有幽人知。\n东家暖客红醅凝，嘈杂新声迷听瑩。\n后园压折万琅玕，雪多政自无人听。\n我时空山夜寂寥，风篁雪窦筛琼瑶。\n希声疏越不可尽，鸣球戛击如闻韶。\n忆昔斋居困学翁，大书听雪烦楚龚。\n百年胜事将无同，不传师旷传王恭。\n鹤氅明朝行雪里，须辨龙头煎雪水。\n床下何人闻斗蚁，唤起春雷来洗耳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25952,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵送净月上人","author":"张雨","text":"阴崖颠风无时兴，篁竹偃地虎昼行。\n斲冰积雪卧空谷，春至唯闻禽鸟鸣。\n华阳南便洞窗小，香烟西放蛾眉道。\n神僧问讯破孤寂，把臂入林一倾倒。\n帕头蒙寒驴背驮，泥滑稳于杯渡波。\n寄谢少年王敬和，独行其如法汰何？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25953,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"效隐居拟古乐府寒夜愁","author":"张雨","text":"夜寒生，群兽惊，寂兮寥兮栖遁情。\n阴宫漫漫落叶平，冈头霜月弄微明。\n寒漏涩，寒弦紧。\n愁肠结，愁语尽。\n人生异木石，思来谁能忍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25954,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵率性来山人见贻之作","author":"张雨","text":"南峰后，灵石前，岚霞茜绚争春妍。\n贫家客来净扫地，亦有一瓶红杜鹃。\n东坡七过山南坞，山人能记坡翁语。\n君方骑马听朝鸡，为我入林来听雨。\n雨声吹断听松声，怪石长松为友生。\n怜君慰我支离者，不饮向人空复情。\n我如病马离群去，君如伯乐能相顾。\n羊群好在金华山，梦里相逢犹识路。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春对雨杂言","author":"张雨","text":"寒谷望春如望赦，雨雨风风恶相嚇。\n床头败絮未尝温，石上瘦花浑欲谢。\n三时尽辨禽鸟鸣，合涧助为风水声。\n白水田头漫无路，老稚种麦已青青。\n朝晴独见扶犁叟，人生合作无犁耦。\n不须识字只耕田，酒杯也到扶犁手。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵段推官观潮","author":"张雨","text":"雪涛卷入白螺杯，云梦吞将滟滪堆。\n陈马直从天汉落，飓风先自海门来。\n青山一向开银壁，黄伞中央立露台。\n好在画图留壮观，江头白首不堪回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠纽怜大监","author":"张雨","text":"论卷聚书三十万，锦江江上数连艘。\n追还教授文翁学，重叹徵求使者劳。\n石室谈经修俎豆，草堂迎诏树旂旄。\n也知后世扬雄在，献赋为郎愧尔曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"老学斋书怀寄京师故人","author":"张雨","text":"手种群松数尺围，草深南涧客来稀。\n一经断送垂垂老，万事安排念念非。\n晨待樵苏才蓐食，凉惊络纬尚絺衣。\n蓬莱坊里清宵月，也到山家白板扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晨兴","author":"张雨","text":"聊与梅枝说岁穷，真成古木共衰翁。\n百年勋业何烦尔，一世云山不负公。\n寒梦渐消窗影上，春容已在雨声中。\n晨兴陡觉诗神王，未放韶华角长雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵虞公和断江和尚种松","author":"张雨","text":"松下微吟惬病悰，支离潦倒似支公。\n顶因巢鹤翻成结，心为依禅毕竟空。\n陆子坛前春古淡，葛洪井上雨青葱。\n茯苓乞与杨员外，谁复缄诗过浙东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游华藏寺","author":"张雨","text":"湖上乱峰如髻鬟，湖边才子驻春鞍。\n霜馀鹦鹉沙汀浅，日落麒麟墓道寒。\n古壁风篁无尽意，清尊云海有馀欢。\n远游未羡鸱夷子，直向飞仙乞羽翰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春溪晓渡","author":"张雨","text":"怪底朝来云气升，雨晴洗遍碧碐磳。\n山腰行李去未远，谷口人家呼渡应。\n彷佛箫台凌凤吹，安排春水理鱼罾。\n卧游已惬平生志，深负床头六尺藤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云林席间怀铁笛简草堂","author":"张雨","text":"花朝无花也可怜，桃李矜持不作妍。\n烂听雨声眠白昼，梦乘艇子上青天。\n閒居尚庶浮云志，老病难趋卜夜筵。\n绛帐先生惟寂寞，后堂自理琵琶弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丹阳道中观稼","author":"张雨","text":"行遍山东黄叶村，纵横草路细难分。\n荒鸡户暗蟏蛸月，落雁天黏䆉稏云。\n下泽车傍悬酒榼，延陵词畔读碑文。\n空山更觅牛羊径，入兽依然不乱群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邓学可留谷城戴尧文许雪中书寄二友","author":"张雨","text":"钩帘坐对西山雪，菌阁前头正向阳。\n剡水当时元有戴，谷城今日可无张。\n披云松树鳞鳞湿，瞰屋山泉角角方。\n染就绿霞春帖子，不妨青鸟便衔将。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋西塞山送赵季文湖州学录","author":"张雨","text":"往来苕霅旧山川，流水桃花思杳然。\n溪女浣纱春雨后，仙人把钓夕阳边。\n渔歌未用朝廷觅，惠政先由隐逸传。\n不信青衫涴尘土，水晶宫里住三千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风雨近寒食未已","author":"张雨","text":"一榻清寒恋旧毡，无言桃李不成妍。\n柳长渐碍螭头舫，雨重浑迷卵色天。\n谁向侯家分赐烛，自依丹井食新泉。\n海南上巳才登冢，忍待晴泥扫墓田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]