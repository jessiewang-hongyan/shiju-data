[{"title":"冬日见桂花","author":"李孝光","text":"北风吹倒碧琅玕，金粟栖枝露未乾。\n翠气遥连仙掌晓，天香微堕玉壶寒。\n明蟾照影临丹阙，青女销香著画栏。\n可是天翁露消息，小春先得一枝看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访王君济","author":"李孝光","text":"好溪沙渚更停桡，来访仙人王子乔。\n稚子候门如有喜，故人索酒不须招。\n门含古树春先到，帘映青山雪未消。\n老子红颜如昔日，只添白发不相饶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄同别峰","author":"李孝光","text":"雨洒高城柳散丝，扁舟长忆送君时。\n前时书去惟凭客，今日诗成欲语谁？\n修竹娟娟当石净，归云故故入山迟。\n平生不解求人识，惭愧黄金铸子期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"棋","author":"李孝光","text":"国手功名满世间，几多奇思上眉端。\n人心险处千机变，局面危时一著安。\n陈入乌江迷项羽，势穷赤壁走曹瞒。\n近来黑白无分晓，输与樵翁冷眼看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月十四夜宿东县明日登山上亭","author":"李孝光","text":"海上归来访旧游，草堂开宴醉新秋。\n金花木落鱼初鲙，玉液香浮酒旋篘。\n展席凉风依绿树，振衣斜日濯清流。\n五年不见孙郎面，一笑相看总白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送友人金陵漕运","author":"李孝光","text":"金陵从古帝王州，漕运君今事胜游。\n丹凤有台春树老，乌衣无国夕阳收。\n潮声挟雨翻蛟室，山气浮云结蜃楼。\n白发高堂日相待，早回兰桡莫淹留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读陶隐居九锡文录呈赵虚一真士","author":"李孝光","text":"独鹤能空鸡鹜群，仙阶还许世人闻。\n题诗未倚李太白，学道愿从茅长君。\n白鹿随车绕山木，丹砂出鼎染溪云。\n先生少留亦不恶，共读华阳九锡文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过山寺","author":"李孝光","text":"隔溪茅屋半开扉，缘护晴林昼打围。\n野鹿饮泉山影动，幽禽出树岸花飞。\n百年往事回头换，一路斜阳送客归。\n要识上方何处是？\n钟声隐隐隔烟霏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨后村行二首 其一","author":"李孝光","text":"雨过沙头落涨痕，满林红叶自纷纷。\n水平路面高低见，风约溪声断续闻。\n老屋无桥横独木，沧洲欲雁起寒云。\n残芦头顶花如雪，莫是吟人鬓上分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨后村行二首 其二","author":"李孝光","text":"泽国秋深景物非，西风猎猎又吹衣。\n路行落日离人去，山破寒烟独鸟飞。\n潮信到滩推月上，邻家停火候船归。\n村醪香软鲈鱼美，自笑吟边貌不肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苦竹村","author":"李孝光","text":"篮舆轧轧路高低，苦竹村南古岘西。\n草舍爨茆留客饭，麦田焚棘断人蹊。\n花梢春意关禽语，石磴霜痕印虎蹄。\n心自爱閒身尚役，好山何处是真栖？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十里","author":"李孝光","text":"官河十里数家庄，石埠门前系野航。\n梅月逢庚江雨歇，稻花迎午水风凉。\n桥横自界村南北，堠断难知里短长。\n倦矣野塘行瘦马，云山杳杳复苍苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋晚别业偶成","author":"李孝光","text":"平原渺渺路西东，豆叶才黄柿半红。\n獭下江潭塘水涸，鼠归墙屋野田空。\n烧烟不断经秋旱，草露无多彻夜风。\n行过小桥人住处，短篱清晓护畦菘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为学古澹藏主题安庆金君美秀野次潘仲举韵","author":"李孝光","text":"户外黄尘满地流，亭边山色转幽幽。\n牛无令斗残吾竹，客与俱来上某丘。\n池上小风花树午，夜深疏雨橘林秋。\n老翁独乐宁非计，正使先生忆钓游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送菜藏主","author":"李孝光","text":"日日秦淮送客船，江中八月雨如烟。\n道逢鸿雁东南去，眼见蟾蜍四五圆。\n美酒相看不成醉，黄花别后为谁妍。\n貉裘已弊秋风起，我正思归种石田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用群字韵寄伯雨尊师","author":"李孝光","text":"使轺草草索离群，南北东西不更闻。\n别去廿年如梦寐，山头一日忽逢君。\n蓬莱阁里呼明月，抚掌东边洗白云。\n诗律老苍无可说，祇须出酒觅论文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"商山四皓图","author":"李孝光","text":"帝忧母主重废嫡，人料子房宜与谋。\n盟诅不虞高后劫，卑辞翻为建成筹。\n腹心已去悲歌起，羽翼虽成女祸留。\n俱堕术中曾不寤，先生轻出后人羞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次伯雨韵","author":"李孝光","text":"佳士望见知耐久，俗子定交心已疏。\n中林有客赋《招隐》，后日何人问《遂初》？\n达官不入祢衡刺，逸史会给陈农车。\n我见弥明太玩世，自言不解人间书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次仲举韵送亭上人","author":"李孝光","text":"垂垂笠子上吴船，去过扬澜浪蹴天。\n狂客还寻破虱录，清童解识野狐禅。\n江来全蜀如衣带，云破中原见岳莲。\n唯有天边旧时月，还随老子发残年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王彦谦韵","author":"李孝光","text":"升州逆旅竟何物，安识人间有子房。\n东野英年空说剑，临邛当日亦求凰。\n鱼生春水桃初雨，雉没高原草欲香。\n寄语归来双燕子，乌衣巷口又斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送姚子章庆元帅府掾","author":"李孝光","text":"东方幕府才华盛，值世承平息虎貔。\n陈琳何烦工草檄，退之莫倚爱题诗。\n海静蛟龙怕钟鼓，天清蛮蜑识旌旗。\n前日元戎为饮酒，深衣宽博锦绅垂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十六日弛儋庐州城西长安寺","author":"李孝光","text":"庐州夜宿长安寺，紞紞城头鼓正严。\n独立春风犹问马，爱看明月自钩帘。\n从人劝酒拈浮蚁，有客哦诗拟撒盐。\n幸得梅花照残夜，未妨长啸倚东檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送坚上人还云门次顾仲瑛韵","author":"李孝光","text":"送客去游梁楚间，桃花开半含花斑。\n幽兰白雪令人瘦，凤凰麒麟何日还。\n江作蛇行过全楚，天将云去见三山。\n借问石城在何处？\n不缘离别损朱颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王彦强见怀","author":"李孝光","text":"美人住在云门西，望到每朝乌欲栖。\n近报綵舟来候我，寄将锦字是亲题。\n荷花日落江相映，芳草春深路转迷。\n更怜把烛裁诗夜，还梦城南旧主啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得越山越水","author":"李孝光","text":"贺家湖上又秋风，放翁宅前东复东。\n两行云树忽远近，十里荷花能白红。\n游人濯足银河上，越女梳头青镜中。\n我欲张帆上南斗，扶桑碧海与天通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘好古归武昌","author":"李孝光","text":"游子结束向何处，城中雪花几尺围。\n去家万里多梦见，辞亲十年今始归。\n道士吹箫赤壁下，行人泊舟黄鹤矶。\n我亦张帆拂南斗，卧看明月去如飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用马中丞韵送志能贺冬之京师","author":"李孝光","text":"停酒更唱车遥遥，官船打鼓回春潮。\n凤曹合引金闺彦，骢马尚随方盖轺。\n五日乐成黄道正，万年觞进紫宸朝。\n清班陪谒三云殿，仙伯神官手屡招。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅魄","author":"李孝光","text":"处士孤魂不可招，夜深疑与雪俱消。\n香流东阁风吹树，梦过西湖月满桥。\n隔岁冰霜哀契阔，空山玉雪想孤标。\n萧萧翠袖令人瘦，莫遣尊中一片飘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越乡次旧韵","author":"李孝光","text":"兴来不买剡溪船，匹马冲寒款著鞭。\n绕驿水声残雪夜，半桥山影夕阳天。\n雁横云宕犹千里，春入梅花又一年。\n唤仆更寻前处宿，有诗还和旧时篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27885,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白沙早程","author":"李孝光","text":"听得邻鸡便问程，前涂犹有客先登。\n官河半落长桥月，僧塔疏明昨夜灯。\n古渡潮生鸥浸梦，野田风急浪归塍。\n雁山喜入新诗眼，踏破秋云最上层。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27886,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乐成","author":"李孝光","text":"万叶萧萧独厌听，长江日脚未全晴。\n豆遗晨垄芽齐白，稻尽秋田孕更青。\n偶向前村逢断岸，欲寻古寺傍山行。\n嫩寒日暮添萧索，无那新来禁酒亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27887,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辛亥玉川问归","author":"李孝光","text":"松菊当年手自栽，故山招我赋归来。\n石桥冲晓霜蹄滑，梅路偷晴雪眼开。\n家在梦中犹未到，春于腊底已先回。\n关河风景依然在，千古兴亡付一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27888,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丙子泛舟登奥","author":"李孝光","text":"鸡埘豚阱半榛荆，村北村南感易生。\n雨过雪消连日冻，潮平水歇下塘声。\n鸦啼古树寒烟湿，人谒荒祠小艇横。\n一段乡情浑漠漠，隔江斜日暗孤城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27889,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次晚春韵","author":"李孝光","text":"燕幕沈沈春昼永，閒敲棋子小阑东。\n拍天涨绿连朝雨，满地残红昨夜风。\n草际梦回诗有债，柳边寒薄絮无功。\n韶光暗换年年事，莫遣閒愁著鬓中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27890,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东林废寺","author":"李孝光","text":"白社寥寥度岁华，客来犹记话分茶。\n桥横山郭前溪路，树隔厨烟何处家？\n官马放归门径草，野僧移去石泉花。\n荒原相接多邻冢，祭扫人还噪暮鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27891,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朵儿只国王之辽东","author":"李孝光","text":"奕世名王策骏功，建分茅土镇辽东。\n玉符金印传孙子，铁券丹书誓始终。\n沧海断霞连虎帐，黑河飞雪暗雕弓。\n莫忘圣武艰难日，四杰从容陟降同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27892,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和宋学士晚出丽正门","author":"李孝光","text":"暮光霞彩炫金题，绛阙高居雉堞低。\n上相楼台连御苑，中郎车骑过沙堤。\n皂雕孤捩凌云翮，紫雁双翻蹀雪蹄。\n回首上林凉月夜，蕊珠多是凤凰栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈杏林赴潮州医学教授","author":"李孝光","text":"三千驿路上滩船，九品医官半百年。\n药市得钱添月俸，杏林收谷当公田。\n北书渐觉江鸿远，南食初尝海鳄鲜。\n不用越巫驱瘴疠，家家传取卫生篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿魏仲远宅","author":"李孝光","text":"每忆君家好兄弟，轻舟远出践深期。\n春风吹雨曹娥渡，夕照满山虞舜祠。\n即问寒暄如梦寐，各言加饭慰相思。\n重来应记呼灯处，夏盖山前月上迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"郊礼庆成","author":"李孝光","text":"郊丘亲祀自吾皇，夙驾銮舆建太常。\n冕服并行周典礼，乐歌不数汉文章。\n清台夜奏灵光紫，温室朝迎瑞日黄。\n今代侍臣多马郑，明时应许议明堂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送阁学士赴上都","author":"李孝光","text":"从官万骑拥銮舆，东阁词臣载宝书。\n雨过草肥金络马，月明山转紫驼车。\n龙庭日近瀛洲路，滦水天高玉帝居。\n明日仙凡便相隔，少年寮吏谩踌躇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陪萨使君饮酒铁塔寺分题得箨龙轩分韵得而字","author":"李孝光","text":"琅玕尽灵种，玉立近东池。\n已与风云会，终含冰雹姿。\n气酣犹赑屃，鳞动觉之而。\n雨暗思雷泽，天清入葛陂。\n凤毛当户见，蛇影到杯疑。\n神物烦呵护，应看变化时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竺云为昙上人作","author":"李孝光","text":"云来自西极，骀荡复委蛇。\n影度流沙晓，峰临鹫岭奇。\n从龙飘宛转，触石起参差。\n光拟凤毛紫，清同玉叶垂。\n芙蓉连华岳，绮藻映天池。\n五色主祥瑞，贤人怀羽仪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玄真馆饮酒分韵得冲字","author":"李孝光","text":"良朋谢悁悒，仙赏属玄冬。\n野净梅将发，山乾雪不封。\n生荑近芳节，出日媚川容。\n愁用诗湔浣，寒凭酒折冲。\n幽人每多暇，俗子自无悰。\n聊以共娱悦，讵知縻万钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李子云白云窗","author":"李孝光","text":"白云如白月，宛宛复离离。\n青霓依涧出，玉叶映檐垂。\n讵阂飞花度，还同病鹤窥。\n纷晖含户牖，倒影散园池。\n近看吁欲落，伫立意俱迟。\n坐卧常相对，成峰晚更奇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27901,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听雪为赵本初作","author":"李孝光","text":"玄冬易萧瑟，积气但清寥。\n夜严方有觉，天静不成嚣。\n深坐愁如见，微闻去已遥。\n新晖留素魄，妍密属青腰。\n声虚如拂竹，花重想封条。\n高居尔最乐，难拔俗人标。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27902,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送廉公亮佥事江西","author":"李孝光","text":"除书下北阙，使牡指南州。\n暂辍紫霄顾，遥瞻画阁秋。\n官清持玉节，天近见珠旒。\n报政民安作，闻谣雨不愁。\n梅花当路发，月影入江流。\n定有登高赋，应将胜日酬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27903,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游雁荡","author":"李孝光","text":"盘盘古荡倚苍穹，势压坤舆距海东。\n异境从真三岛外，群山呈技五云中。\n玲珑胜插连星斗，杳渺神鳌戴华嵩。\n香雾千屏金沆瀣，煖霞万簇锦芙蓉。\n峰亭玉女螺鬟亸，瀑泻冰帘雨气浓。\n怪底双鸾翔彩凤，崭然绝壁挂苍龙。\n展旗轻飏神僧洞，天柱相高玉笋丛。\n偃盖紫芝当锦帐，挺标卓笔对天聪。\n北瞻瑞鹿晴岚薄，西溯飞泉紫翠重。\n钜宦来观留好句，名才远访畅幽悰。\n跻攀适带琴尊并，啸览纷陪杖履同。\n倦客岂知今再到，老僧能记昔相逢。\n冰盘甘脆传林果，芳饤新柔荐晚菘。\n远社飞杯深缱绻，赞房对榻重从容。\n晃衣枫锦飘阶叶，吹佩松涛度曲风。\n悟趣只知玄圃近，探幽拟与虎溪通。\n挂巾五老窥灵穴，脱屐常云濯剑锋。\n涵日影摇临水塔，破烟声度隔林钟。\n千年纪载文光烂，数日盘桓目力穷。\n镌石题诗状难尽，遍图胜概贮诗筒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27904,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪元镇纨扇","author":"李孝光","text":"野水见落日，幽人殊未还。\n白云满洲渚，搔首问青天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27905,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题松雪竹石","author":"李孝光","text":"幽篁碧悄悄，白石白粼粼。\n帝子吹笙罢，月明愁杀人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27906,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂画","author":"李孝光","text":"汀洲木叶下，斜日倚湘娥。\n我欲采芳草，洞庭秋水多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27907,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪氏雨竹","author":"李孝光","text":"落日楚江深，鹧鸪啼远林。\n相思不可见，池上写春阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27908,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宝林八咏 飞来峰","author":"李孝光","text":"山似琅玕小，地将秦望雄。\n越王歌舞处，长作梵王宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27909,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江边","author":"李孝光","text":"江边孤树犹碧，天际白云自流。\n七十二滩浩荡，夕阳照见归舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27910,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪晴","author":"李孝光","text":"雪乾玉饭初香，月瘦珠胎犹小。\n开门不见臞仙，白鹤横江清晓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27911,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其一 云门福地","author":"李孝光","text":"古帝南巡事已非，土阶茅屋尚依依。\n夜深月底吹箫去，度得云门一曲归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27912,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其二 盖竹洞天","author":"李孝光","text":"蝙蝠翻云似白鸦，石林玉气乱晴霞。\n山中鸡犬应相笑，溪上红桃几树花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27913,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其三 双瀑飞泉","author":"李孝光","text":"雨洗天根云洞幽，黑蛟飞雹舞长湫。\n只应壮士思酣战，组练相衔夜不收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27914,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其四 箫台明月","author":"李孝光","text":"山月峥嵘露玦环，石楼香冷白云间。\n玉箫吹裂阶前竹，骑鹤仙人去不还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27915,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其五 白鹤晨钟","author":"李孝光","text":"风约疏钟下窈冥，天南曙月飐飞星。\n驼鸣阊阖嚣声起，老鹤巢深梦未醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27916,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其六 紫芝晚磬","author":"李孝光","text":"萧萧清磬出云迟，月死空林日气微。\n重过紫芝山下路，坏桥灯火照人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27917,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其七 东塔云烟","author":"李孝光","text":"海月四更移塔去，天风万里擘松开。\n烟销日出无人到，独自看云山上来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27918,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"箫台八景 其八 西岑松雪","author":"李孝光","text":"山上行人如冻蝇，西厓日出澹青荧。\n太阴积雪草木缩，留得孤松长茯苓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27919,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六月初十日雨止月出坐大桂树旁西风先秋","author":"李孝光","text":"软玉衣裳翡翠环，暖笙初学凤锦蛮。\n广寒宫阙西风紧，一夜天香满世间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27920,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"得故人书","author":"李孝光","text":"风前一纸故人书，上说相思下起居。\n却道梅溪新事业，声名全胜绍兴初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27921,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]