ovenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23605,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题东坡帖","author":"虞集","text":"鱼复浦前春水生，负薪渡江初月明。\n凭郎莫下巫峡去，楚王宫殿在专城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23606,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊日偶题","author":"虞集","text":"旧时燕子尾毵毵，重觅新巢冷未堪。\n为报道人归去也，杏花春雨在江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23607,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题扇与周干臣","author":"虞集","text":"玉叠松花蜜饼香，龙珠星颗露盘凉。\n遥知环碧楼中坐，翠竹苍松夏日长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23608,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周怡临韩干明皇出游图","author":"虞集","text":"开元盛事何人画，玉冠芙蓉御天马。\n从官骑步各有持，移仗华清意閒暇。\n宫袍如锦照青春，诏许传看思古人。\n不知身在瀛洲上，亲奉图书侍紫宸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23609,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徽宗画梨花青禽图","author":"虞集","text":"宿雨初收禁林寂，玉斧临窗看春色。\n蒺藜沙上煖尘飞，何处人间作寒食。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23610,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里小景","author":"虞集","text":"前代王孙不好武，拈笔幽窗写汀渚。\n残云野水三百年，依旧松筠湿春雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23611,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"韩干马","author":"虞集","text":"开元沙苑蒺藜秋，韩干新图总不收。\n天厩真龙奇骨在，故知臣甫负骅骝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23612,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曹霸下槽马","author":"虞集","text":"枥下长年饱豆刍，谁通马语识踟蹰？\n主恩深重知何报，或者东封驾鼓车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23613,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕昌祐蘹香睡鹅图","author":"虞集","text":"苍鹅惜毛羽，宛宛卧春雨。\n雨馀日照沙，上有蘹香花。\n怀香不自献，梦到金鸾殿。\n殿池多跃鱼，君王方草书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23614,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹林七贤图","author":"虞集","text":"瞻彼修竹，下临清流。\n文石偃堤，华松荫丘。\n植表界壤，剪茅宅幽。\n梁度高巘，台隐中洲。\n方床读书，异宫同休。\n咏歌相闻，觞豆相求。\n或莳名药，或钓游鯈。\n课艺嘉植，坐思远游。\n濯缨微波，看云良畴。\n逸而不放，俨而自修。\n泰哉沮溺，邈乎巢由。\n按图以观，永宜春秋。\n孰若五君，遗其故俦。\n糟粕尘世，高踪庄周。\n我怀古人，遁而违忧。\n安得挥弦，以招沈浮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23615,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题汪华玉所藏兰亭图","author":"虞集","text":"衡茅负晴旭，有客至我门。\n共披会稽图，山水盛缤纷。\n众贤坐水次，飞觞汎沄沄。\n夷旷各有趣，高閒知右军。\n幽情付后览，陈迹感前欣。\n悠悠千载来，不异更旦昏。\n探穴问神禹，望海悲秦君。\n逝者皆如斯，死生固奚云。\n所以鼓瑟人，思从童冠群。\n春服沂新浴，归欤聊永言。\n抚卷不知老，遐思在兹文。\n东南极积水，日暮多浮云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23616,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉隆留题","author":"虞集","text":"仙真治兹山，重阜隐延广。\n冲奥元气会，运至法灵响。\n与世作司命，神宇廓弘敞。\n及门春雨来，玄感副夙仰。\n摩挲晋时树，托身何萧爽。\n千载抱微息，日月共来往。\n欲为黄发期，日待紫芝长。\n上天垂光彩，月出江海上。\n故人不可待，惆怅理归鞅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"记梦","author":"虞集","text":"梦行衡庐间，千仞过苍壁。\n崇高仰神明，深广下不测。\n云雨蓄盘礴，时至如欲出。\n絪缊尚回旋，挥霍忽奔逸。\n物怪匿岩穴，愯若俟霹雳。\n黑波汎高树，木叶走崩石。\n升身登玄间，纵观龙变迹。\n俯视九州野，草木有辉泽。\n乃在风雨外，手画素三尺。\n挥豪极动荡，落墨更沈郁。\n图成示坐人，共笑不可得。\n顾瞻以踟蹰，恍惚增叹息。\n因之命肩舆，出门聊有适。\n大术何舒舒，白鹤从数客。\n略经幽涧滨，便上青松侧。\n凭高望远水，双景荡虚碧。\n拂石共客坐，芳草藉尻膝。\n忽然闻钟声，睡觉北窗席。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵陈溪山棕履二首 其一","author":"虞集","text":"解舄还上方，归山据枯槁。\n禁足结僧夏，陈编谢探讨。\n隐几或过昼，凝尘遂忘扫。\n行庭不见人，谁或践生草。\n实由筋力衰，无复驰走好。\n前年当此时，严召出城早。\n追度龙门水，赐见沙领道。\n鼎湖忽踰年，始克罢趋造。\n感君素履咏，幽贞可长保。\n番番茹芝人，长歌岂知老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵陈溪山棕履二首 其二","author":"虞集","text":"六月乃屡雨，良田不忧槁。\n独念桂林戍，触热赴南讨。\n道路备攘掠，所过净于扫。\n缚人夜送军，吏卒何草草。\n蛮獠亦人类，义利启戎好。\n寻原可制乱，机要贵及早。\n夜来送者还，颇言暍横道。\n诸军四面集，同月约皆造。\n谁为饥渴谋，性命安可保。\n藜藿虽满盘，对之令人老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和陈溪山韵","author":"虞集","text":"幽人慎素履，古道思独往。\n瞋目登高台，浮云不足上。\n丹砂炼仙骨，沆瀣濯神爽。\n远怀澄江静，耿若孤月朗。\n河汉自倾注，山川邈游想。\n敛迹倦飞翼，归耕故时壤。\n好风从东来，空谷感遗响。\n诏书荐遗逸，郡府属高仰。\n聊持东湖水，往助敬亭赏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"楚石琛藏主自蒋山归却欲就丛林阅藏同舟清江之上赋此赠之","author":"虞集","text":"手携北山云，却上西江水。\n月明洲渚生，叶落风不起。\n虚舟不移棹，寒波钓金鲤。\n银河转碧落，北斗去天咫。\n龙吟匣中剑，虎跃弦上矢。\n杀机谁敢当，吹毛岂轻试。\n贝叶启千函，木榻脱双履。\n惟应胜壁观，悠悠度年岁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题蒙庵为黄石谷赋","author":"虞集","text":"东南有高丘，下临万家邑。\n汪洋浃春润，沃衍盛秋入。\n群山若浪波，起伏翠重袭。\n灵运好奇险，高平罕相及。\n幽人园绮间，周览度原隰。\n随山导清泉，积石拾层级。\n结庵以蒙名，果行信所执。\n良时一来游，朔月九交十。\n门当星斗高，陇卧风雨湿。\n一川灯火归，宾从杂车笠。\n登高愧能赋，腾身竦山立。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"平江开元雪窗光禅师访予临川山中其归也予与宾客用一雨六月凉中宵大江满分韵送之不足予为继之而予分得一字","author":"虞集","text":"积雪何处高，蜀山最崷崒。\n海东极孤绝，目送断鸿一。\n徘徊桫椤树，宴坐但空室。\n园果堕宿雨，当昼从定出。\n八月露水繁，石钵满华蜜。\n相会岂无因，分床便深密。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]