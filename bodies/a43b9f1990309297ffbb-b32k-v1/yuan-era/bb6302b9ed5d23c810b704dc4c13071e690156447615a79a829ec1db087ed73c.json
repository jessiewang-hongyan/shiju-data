commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水芙蓉","author":"虞集","text":"长洲宫沼醉西施，荡漾兰舟不自持。\n愿奉君王千岁乐，一盘清露玉淋漓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送四川宪使","author":"虞集","text":"已叹玄经返墨池，复愁国史奉严祠。\n离乡游子归仍晚，独对东风惜鬓丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曹将军马","author":"虞集","text":"高秋风起玉关西，踣铁归朝十万蹄。\n貌得当时第一匹，昭陵风雨夜闻嘶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马图","author":"虞集","text":"昔在乾淳抚蜀师，卖茶买马济时危。\n乡人啜茗同观画，解说前朝复有谁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王母图 其一","author":"虞集","text":"偷桃小儿痴且妍，恃恩无赖更蒙怜。\n窃翻雷电天公怒，风雨落花红九川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王母图 其二","author":"虞集","text":"黄竹遗墟白雪高，空桑戴胜向晨嗥。\n茂陵多欲非仙器，枉赐金盘五色桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23574,"sha256":"83a9