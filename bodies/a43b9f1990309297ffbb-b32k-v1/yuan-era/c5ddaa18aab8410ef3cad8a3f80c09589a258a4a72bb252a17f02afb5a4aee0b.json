[{"title":"与无照暮出西郊","author":"善住","text":"阊阖城边烟草昏，自携禅侣过孤村。\n阴云垂地鸟归树，寒色满空人闭门。\n山径雨馀留虎迹，野塘秋尽露潮痕。\n一声牧笛前峰起，回首残阳欲断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过石湖","author":"善住","text":"十月吴皋霜露零，田家收稻满柴扃。\n湖中浪拥银花白，天末山横螺髻青。\n寒色乱鸦飞笠泽，夕阳衰柳并旗亭。\n何时觅得清游伴，更买扁舟过洞庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登报恩寺阁","author":"善住","text":"高阁閒登四望宽，青山极目倚云端。\n水村漠漠连天远，垄树沈沈带雨寒。\n罢马嘶风春草遍，倦鸦归堞夕阳残。\n岂知大道平如掌，今古人间行路难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之金陵","author":"善住","text":"歌罢阳关酒一杯，扁舟欲上更徘徊。\n舒王旧院为僧寺，后主遗宫化劫灰。\n北固山头春雨过，西津渡口暮潮回。\n心间在处堪为客，遮莫天涯杜宇催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟次江亭","author":"善住","text":"归思悠悠极渺冥，暂维舟楫并长亭。\n春江水暖蒲牙白，野岸烟销柳眼青。\n鸣犊带声登废垄，征鸿和影度遥汀。\n不知何处吹桐角，独立天涯泪欲零。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜四首 其一","author":"善住","text":"明河如练月如弓，凉叶萧萧下远空。\n水国正秋无过雁，苔阶终夕有鸣虫。\n故人自隔关河外，往信犹存箧笥中。\n一盏青灯伴孤寂，梦回吹杀破窗风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜四首 其二","author":"善住","text":"渐老襟怀岂易宽，强将诗句散愁端。\n黄花开后重阳近，白发生来万事难。\n月老独眠松馆静，晚天清坐竹窗寒。\n暗尘锁断青琴索，指甲虽存莫可弹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜四首 其三","author":"善住","text":"雁声吹落五云间，带月柴扉夜未关。\n寒气仅伤凡草木，秋风难老旧河山。\n孔宾好学非求隐，元亮休官为爱閒。\n今古一株天上桂，近来闻说有人攀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月夜四首 其四","author":"善住","text":"阴虫切切啼秋露，凉月娟娟照夕风。\n鸾凤几曾栖枳棘，鸱鸮多是占梧桐。\n人皆酤酒追陶令，我独栽莲学远公。\n堪笑当年槐国梦，黄粱未熟已成空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京口","author":"善住","text":"车声轧轧辗红埃，北马南帆日夕来。\n淮甸雪销江水涨，海门月上楚天开。\n堤边行饭多逢柳，野外寻诗不见梅。\n会散金山即归去，春风催我上琴台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵山村先生二首 其一","author":"善住","text":"严陵台下水潺湲，漠漠高风去不还。\n处士隐庐遗路侧，永公书瓮出松间。\n山田硗瘠民生俭，郡邑萧条吏事閒。\n几欲清游身未遂，烟霞盘礴鬓毛斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵山村先生二首 其二","author":"善住","text":"定起空山尚有星，悲笳杳杳上青冥。\n壁间灯暗鸦啼树，池上月凉鱼闯萍。\n文锦荐柈风字研，綵绳穿夹梵书经。\n舌端解使天华坠，争似无言对翠屏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日至钱塘阻雨首寄山村先生","author":"善住","text":"客窗灯暗曙钟残，泥潦从衡路未乾。\n满目云山留我好，一楼风雨见君难。\n湖边雪尽梅应早，吴下春迟麦尚寒。\n南渡耆英久寥落，岂知犹有故衣冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"如镜师剪竹四竿植为莆桃架其一适活要予赋诗遂作此以塞请云","author":"善住","text":"苍筤剪得出遥林，架就危棚近壁阴。\n柔蔓未垂珠落落，短梢先挺碧沈沈。\n月明乱影翻秋几，露冷清声入夜琴。\n养取间门表孤直，莫教容易俗尘侵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子虚以湘竹杖惠予兼贶以诗遂依韵答之","author":"善住","text":"颁得山人古竹筇，节间销尽泪痕红。\n化龙定跃苍波里，伴鹤还腾碧汉中。\n跬步安危存用舍，百年前却付穷通。\n相应海国归来日，系乡船头取便风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渔父","author":"善住","text":"夕阳波上钓丝轻，风入蒹葭窸窣鸣。\n辞剑为怜逋客难，鼓桡曾笑逐臣清。\n数声竹笛湘江阔，一帽山花白发明。\n南北去来人自老，几多空抱羡鱼情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经故人所居","author":"善住","text":"桃花灼灼柳依依，院落荒凉昼掩扉。\n石沼水乾鱼逝久，杏梁巢覆燕来稀。\n陇头未说人浇酒，世上先传客卖衣。\n欲对东风写离恨，郡谯吹角暮云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"落梅","author":"善住","text":"晴雪霏霏洒砌苔，浪蜂欲去更徘徊。\n空传淡影浮歌扇，不送寒香入酒杯。\n陇首故人千里隔，江南驿使几时回。\n翠禽莫怨高楼笛，一度春风一度开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晚","author":"善住","text":"矮窗日月无今古，闭户争知春去来。\n清镜静临多白发，好花閒看半苍苔。\n蛙传鼓吹池塘雨，茶展枪旗涧壑雷。\n海燕未回寒尚在，暮云重叠锁崔嵬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苦雨","author":"善住","text":"积潦横流路不分，满空烟霭暗朝昏。\n乌鸢跕跕堕荒圃，风雨潇潇失远村。\n刍米贾腾愁白屋，管弦声沸醉朱门。\n无言桃李参差放，似怯春寒欲断魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴二首 其一","author":"善住","text":"五十虽赊病见侵，闭门终日少相寻。\n春莺漫逞千般语，老骥终存万里心。\n花绕竹房红作阵，柳垂莎径翠成阴。\n江南三月清明后，便有蛙声聒夜深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"遣兴二首 其二","author":"善住","text":"身前万事若浮尘，过眼从衡日日新。\n蛙黾得时多意气，鲲鲸失水少精神。\n青山古木丘园晚，白鸟苍烟浦溆春。\n回首吴淞兴无限，岛头新涨绿粼粼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自阳山归舟中作","author":"善住","text":"小麦青青大麦黄，涧松风急夜声长。\n屩穿细路春泥滑，花落清渠野水香。\n岭上独留云作盖，村边多见石为梁。\n枫桥寺转阊门近，回首西山已夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无照林亭","author":"善住","text":"累土崇丘作小亭，手栽花木满林坰。\n郡中高树已全绿，屋外远山才半青。\n过眼荣枯荒圃草，到头聚散野池萍。\n馀生但愿身长健，杖策时来对翠屏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠叔恭","author":"善住","text":"负笈担簦计已灰，归来萧寺掩莓苔。\n呼猿别涧曾抛果，放鹤他山得看梅。\n樵径雪晴芒屩出，江桥风熟布帆开。\n反思身外无穷事，不直窗间水一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中","author":"善住","text":"寂寥空谷久相容，行道何须向别峰。\n山腹引泉因煮茗，岭头乘雨为栽松。\n倚天杰阁巢灵鹤，彻海澄潭卧毒龙。\n樵客岂能知住处，草堂终日白云封。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋居","author":"善住","text":"栖迟寄穷巷，不异住荒村。\n寒草生枯树，秋苔上败垣。\n众山皆绕郭，一水独当门。\n抱瓮非吾事，乘閒学灌园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日野望","author":"善住","text":"寂历村桥畔，夷犹野望时。\n路长征骑疾，风定去帆迟。\n城晚牛羊下，天秋草木衰。\n数声何处笛，渺渺隔烟吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠隐者","author":"善住","text":"生无轩冕志，老不释渔竿。\n对食惭周粟，纫衣尚楚兰。\n江城犹雨雪，花柳政春寒。\n穷达皆由命，初非行路难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邓隐君牧","author":"善住","text":"标格类孤鹤，翩然独往还。\n弹琴坐白石，把酒看青山。\n须鬓经年改，身心竟日閒。\n料知尘世事，无复得相关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之冷泉","author":"善住","text":"兹游无伴侣，远树独依依。\n日落征帆急，天寒过客稀。\n断云随竹锡，残雪照麻衣。\n应渡西湖去，闻钟入翠微。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆轲","author":"善住","text":"壮气干牛斗，孤怀凛雪霜。\n只知酬太子，不道负田光。\n易水悲歌歇，秦庭侠骨香。\n千金求匕首，身后竟茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨花","author":"善住","text":"池塘春欲暮，散漫复霏微。\n未得为萍去，先来作雪飞。\n带泥粘燕嘴，和雨点人衣。\n乡晚东风急，飘零无所归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送白云之鄞","author":"善住","text":"泽国东南郡，迢迢接会稽。\n人烟逢海断，山木与云齐。\n夜汲分波月，晨征候店鸡。\n却愁孤锡返，草暗竹房西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚二首 其一","author":"善住","text":"兰若依城市，萧条门巷深。\n夜阑春漏断，窗近晓寒侵。\n书幌无灯火，禅堂有磬音。\n几番清梵罢，红日上遥林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚二首 其二","author":"善住","text":"陋巷寡轮鞅，开门对翠屏。\n冰销春水绿，云尽晚山青。\n袅袅来孤篴，荧荧见小星。\n乱鸦栖已定，犹自步閒庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蟋蟀","author":"善住","text":"西风吹蟋蟀，切切动哀音。\n易入愁人耳，难惊懒妇心。\n寒灯孤馆外，秋雨古城阴。\n听极无由寐，终宵费苦吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿山寺次韵子封先生","author":"善住","text":"暝投云际寺，深殿一灯微。\n海底月已出，山中僧未归。\n涧声经雨急，林影入秋稀。\n明发寻征道，还愁露湿衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄友生","author":"善住","text":"分违若未久，相忆似多时。\n后会将何日，重来预作期。\n夕风翻急浪，寒月堕高枝。\n寄语同人说，诗翁鬓已丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚望怀岩栖翁","author":"善住","text":"晚望荒台上，孤筇手自持。\n柳条擎雪重，溪鸟溯风迟。\n枯草春还发，阴云冻不移。\n何当高世者，来此共题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵子封先生答山中僧","author":"善住","text":"名山不肯住，自欲老深云。\n凿翠通虚牖，锄荒出坏坟。\n花开留客醉，果熟与猿分。\n更莫逃幽隐，音书难重闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄中峰长老","author":"善住","text":"中峰峰顶寺，长忆旧游时。\n云暝鹤归急，山深月到迟。\n乱藤悬雨壁，坏帛挂风枝。\n终亦携瓶锡，相从支遁师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陨叶","author":"善住","text":"霜后色初变，风高始乱零。\n和云流远涧，杂雨下空庭。\n扫处兼僧影，烧时带鹤翎。\n翻思在春日，绕屋政青青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送中上人归里","author":"善住","text":"相留已无计，欲别手重携。\n客路连愁远，乡山入望低。\n野花秋寂历，江草晚凄迷。\n旧隐重归日，寒螀夜夜啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜独坐","author":"善住","text":"解带坐盘石，翛然四体轻。\n夜凉蛩语细，天净月华清。\n孤烛明深殿，哀笳起废城。\n寥寥尘境外，谁识此时情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵登石城","author":"善住","text":"振策登危堞，东风雁北归。\n清江愁外阔，远树望中微。\n草色和烟重，莺声带雨稀。\n缅怀千古事，客泪堕麻衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄宋子虚","author":"善住","text":"儒释门虽异，诗书味颇同。\n有心依涧壑，无意谒王公。\n午鼎篆烟碧，夜灯花穗红。\n曾闻少年日，几度过辽东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘉定显庆寺","author":"善住","text":"舣棹逢精舍，松扉昼不扃。\n暮云兼雨黑，寒树带烟青。\n鸟散庭还静，龙归水自灵。\n徘徊未能去，石塔语风铃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"馀生","author":"善住","text":"短鬓霜侵久，馀生懒问交。\n爱閒忘俯仰，养静倦推敲。\n花露悬蛛网，芹泥落燕巢。\n有时幽兴剧，扶杖出衡茆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋怀四首 其一","author":"善住","text":"凉风动寥廓，庭下草初黄。\n病骨知寒早，愁怀觉夜长。\n孤城淹岁月，重露迫衣裳。\n黑发浑无几，尤宜事退藏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋怀四首 其二","author":"善住","text":"砌冷候虫急，灯昏幽梦长。\n秋风吹草木，天气入凄凉。\n门掩荒城月，鸦啼古堞霜。\n无成今白首，身世转堪伤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋怀四首 其三","author":"善住","text":"涧曲独盘旋，人间事屡迁。\n艰难销壮志，衰朽惜残年。\n世有还珠浦，生无种玉田。\n归来华表鹤，亦劝学金仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋怀四首 其四","author":"善住","text":"抱景坐虚室，翛然谁与同。\n像金辉夕烛，櫩铁响天风。\n汛大潮应满，林深叶未空。\n江南秋欲老，肠断北来鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱唐感旧","author":"善住","text":"江山王气终，江水自流东。\n钟鼓传新寺，烟花失故宫。\n龙亡灵沼竭，凤去寝园空。\n残月西风夜，无人倚井桐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陪山村先生白提举宅清集","author":"善住","text":"展席当清昼，凭轩野思饶。\n苔随屐齿陷，雪入酒杯消。\n看竹鹤先舞，弹琴梅自飘。\n风流馀二老，相对话前朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"盆竹","author":"善住","text":"瓦缶不多土，娟娟枝叶蕃。\n岂知幺凤尾，元是古龙孙。\n苍雪洒禅榻，细香浮酒尊。\n王猷来此见，应亦为销魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟次吴江","author":"善住","text":"客路渺无际，崎岖何日平。\n积烟迷远树，残照下荒城。\n水宿先归港，朝行暗计程。\n长桥知渐近，笳鼓隔林鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宝带桥","author":"善住","text":"运得他山石，还将石作梁。\n直从堤上去，横跨水中央。\n白鹭下秋色，苍龙浮夕阳。\n涛声当夜起，并入榜歌长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"期石室不至","author":"大欣","text":"风水不可期，知君定来否？\n何处唱歌声，月明大溪口。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送晖东阳往江西省佛智师","author":"大欣","text":"故家西江上，游子未成归。\n而我岂不怀，所惭志多违。\n十五知好道，从师别庭闱。\n朅来苕上寺，遭时蹈危机。\n秋风走淮甸，晏岁东海涯。\n交情无厚亲，面诺心已非。\n感子始终意，见我无瑕疵。\n爱恶有妍丑，人孰不自知。\n目睹凌云质，自足为我规。\n况同早入室，甚知多令仪。\n前年党祸作，众溃如星驰。\n老师卧一室，四海浮云悲。\n我时阙服役，赖子能扶持。\n子去我始至，曾不慰渴饥。\n遂令八十翁，落日乡土思。\n别来鞠再华，田圃霜露滋。\n穷檐白日晚，苦心徒尔疲。\n感激子遂行，信有天下奇。\n草堂白头亲，有弟供甘肥。\n敢忘师道尊，恩义无或亏。\n意气重然诺，为道况孜孜。\n神机不停伫，天马脱絷羁。\n能不念离索，潦倒成荒嬉。\n尺书岂无邮，问谒多愧辞。\n我有心与目，孰不为鸢鸱。\n母老家亦殚，弟妹贫贱离。\n长绝伯父恩，骨朽葬无资。\n天诛不可逭，何用涕交颐。\n因子感我私，听歌行步迟。\n誓言如白水，我归岂无期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梁楷田乐图","author":"大欣","text":"作劳田中归，酒味薄可漉。\n人生一醉饱，良不负吾腹。\n牵携影参差，歌吹非有曲。\n流风一胥靡，此乐不可复。\n吾人孰非古，亦有心与目。\n封伦恨不留，重睹贞观俗。\n昔在唐虞世，苗民有不服。\n地硗知良农，畜瘠求善牧。\n愿持画史心，献君比和玉。\n朝来愧斯图，恻怆意未足。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"颜晖猿","author":"大欣","text":"峡冬拖长冰，崖滑如积铁。\n客子涕纵横，悲猿助呜咽。\n仰视浮云崩，再听苍石裂。\n不畏行路难，但感芳年歇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"索士岩都事赴浙东佥宪以疾不能送作诗寄别","author":"大欣","text":"鲲鹏虽钜物，为瑞不如凤。\n五金利而坚，良玉世所重。\n古来德辅时，不必趋俗用。\n公德配古人，文艺复掩众。\n前驱失班扬，后顾无屈宋。\n譬之武事严，万甲卷殽雍。\n往年试春闱，对策天威动。\n烈风挟长波，电影掠飞鞚。\n称此衣绣荣，人品赖甄综。\n任众难独专，榱桷杂楹栋。\n分宪得问俗，施惠徵前痛。\n积水散凫鹥，良畴没菰葑。\n飞章择守令，邦赋足输贡。\n怀德民不欺，率教童知诵。\n平生许经济，无由预宾从。\n方外亦何有？\n天地一空洞。\n所惭世网婴，不虞祸机中。\n车偾长途暮，舟胶哀壑冻。\n甘泽被污莱，巨照烛昏瞢。\n乞退悔苦晚，谁无钵饭供。\n愿从金华山，芋区荒可种。\n更怜苏长公，忍别阻追送。\n短歌愧知己，空怀好音哢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月支王头饮器歌","author":"大欣","text":"呼韩款塞称藩臣，已知绝漠无王庭。\n驰突犹誇汉使者，纵马夜出居延城。\n我有饮器非饮酒，开函视之万鬼走。\n世世无忘冒顿功，月支强王头在手。\n帐下朔风吹酒寒，凝酥点雪红斓斑。\n想见长缨系马上，髑髅溅血如奔湍。\n手麾欲回斗杓转，河决昆崙注尊满。\n酒酣剑吼浮云悲，使者辞欢归就馆。\n古称尊俎备献酬，孰知盟誓生戈矛。\n斩取楼兰悬汉阙，功臣犹数义阳侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]