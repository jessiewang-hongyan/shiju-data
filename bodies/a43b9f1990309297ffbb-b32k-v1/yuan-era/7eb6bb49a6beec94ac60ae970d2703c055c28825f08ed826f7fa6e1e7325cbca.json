[{"title":"对春雪","author":"周砥","text":"琼叶缀玄圃，玉羽翔伊川。\n翻霙九霄下，呈芳二月前。\n低徊隔帘翠，玲珑入绮钱。\n欲消不自驻，已断复成连。\n珠帏凝华洁，花池舞影妍。\n相思梁园暮，曾赏洛城年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"尚朴斋","author":"周砥","text":"言甘知有吝，味旨閒其多。\n居恒属念虑，抱朴心靡他。\n淳风返元化，至体适平和。\n意胜惟自然，道存谅不磨。\n营营彼浇俗，机巧滋烦苛。\n身偕百忧长，奄忽其奈何！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风雨一首用高季迪韵","author":"周砥","text":"贫富不相值，衰荣固有时。\n行哉徒自速，止尼未为迟。\n崎岖千万涂，辛苦岂要辞。\n风雨群鸡鸣，坏屋起晨炊。\n一日不解醉，千古有遗悲。\n如何屠钓人，敢为帝者师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠叶秀才","author":"周砥","text":"日暮登高台，浮云结远阴。\n树木何蒙茏，野雀噪繁林。\n驱车涉关塞，岐路郁且深。\n借问子何之，故乡阻崎嵚。\n曷不暂栖息，蓬藿非所任。\n隐悯□不发，威迟既前临。\n脆管促飞觞，鹍弦奋逸音。\n仗剑从此别，秋风满怀襟。\n寡立步非窘，薄游志不沈。\n策马欲俱去，我无当世心。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵一阳真士归霅上","author":"周砥","text":"渺渺晴湖白鹭飞，青山迢递夕岚微。\n閒操桂楫云生腋，欲采芙蓉露满衣。\n紫翠房深丹灶暖，松杉秋静鹤巢稀。\n明年去觅封君达，应驾青牛说息机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵介之梦山中","author":"周砥","text":"松花金粉落春晴，白鹤看棋如客行。\n疏雨竹窗缘是梦，隔林茶臼只闻声。\n繁华久困心何得，澹泊相遭思亦清。\n不有鹿门高世志，山中几日道能成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李用和之常熟知州","author":"周砥","text":"落日孤城近海边，川流九道直如弦。\n朱幡到邑歌来暮，玉帐论兵思去年。\n楚水南回多贾舶，虞山西望少人烟。\n从来惠化同甘雨，还使残民得洒然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月廿一日惟寅徵君踏雨过林馆为留终日因诵近赋绝句三首爱其词致清婉辄走笔次韵如上古道寥寞人以角逐声利为务惟寅独逍遥恬淡之乡时来□之篇章翰墨之事岂易得也哉 其一","author":"周砥","text":"野花疏竹媚幽姿，翡翠帘前雨散丝。\n最爱陈琳诗句好，玉盘春露捧金芝。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月廿一日惟寅徵君踏雨过林馆为留终日因诵近赋绝句三首爱其词致清婉辄走笔次韵如上古道寥寞人以角逐声利为务惟寅独逍遥恬淡之乡时来□之篇章翰墨之事岂易得也哉 其二","author":"周砥","text":"秋来长掩竹间扉，过客谁能识道机。\n惭愧庐山陈处士，时来共葺薜萝衣。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月廿一日惟寅徵君踏雨过林馆为留终日因诵近赋绝句三首爱其词致清婉辄走笔次韵如上古道寥寞人以角逐声利为务惟寅独逍遥恬淡之乡时来□之篇章翰墨之事岂易得也哉 其三","author":"周砥","text":"晚风吹雨过林庐，柿叶飘红手自书。\n无限萧条江海意，一尊相对忆鲈鱼。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读故友徐幼文诗集有怀","author":"周砥","text":"欲与评诗恨久违，楚云吴树两依微。\n读阑北郭平生稿，秋晚空斋掩落晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山草堂","author":"周砥","text":"忆汝草堂何许在，辟疆园里玉山陲。\n方床石鼎高情远，细雨茶烟清昼迟。\n鸿雁来时曾会面，枇杷开后更题诗。\n山中容易年华暮，书史娱人总不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题宫人行乐图","author":"周砥","text":"金宫游素女，玉笛弄清晖。\n月殿龙香度，风帘翠影飞。\n云开移綵仗，花落卷春衣。\n莫买相如赋，长门事已非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈惟允荆溪图","author":"张田","text":"人家绿树绕孤城，溪上风波落日明。\n三害祠存人已去，只今豺虎却纵横。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春十咏 其二","author":"王畛","text":"东风生庭隅，拂拂翻衣浪。\n仁及红绽柯，德布绿回望。\n芳情达金闺，诵声递书幌。\n池塘溢波澜，柔条欣骀荡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春十咏 其五","author":"王畛","text":"蹁跹先春雀，风暖喧晴檐。\n惊人鲜得食，阚阶无停瞻。\n不趋太仓中，小腹恣属厌。\n高秋寒露下，大水须深潜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自遣二首 其一","author":"王畛","text":"江湖肆鲸鳣，沟渎难容身。\n人情不千日，世事有两心。\n朝暮有显晦，日月常升沈。\n天道我欲问，其理幽且深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"放慵","author":"王畛","text":"愁到心常结，事过心自凉。\n幽忧漫成疾，慵放且何妨。\n笼鹤声难出，床龟息稳藏。\n浮生付天地，澄虑博山香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚思","author":"王畛","text":"薰风向晚急，吹动一身愁。\n意合情终美，心离事只休。\n鸟冲残日度，云逐暮天流。\n今古无穷恨，令人早白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其一","author":"张简","text":"海静不扬波，仙人鞚鹤过。\n灵峰七十二，何处月明多？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其二","author":"张简","text":"扁舟下彭蠡，望见大君山。\n只道支机石，移来天汉湾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其三","author":"张简","text":"歌按《霓裳曲》，分行舞广庭。\n天坛看星斗，散乱若浮萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其四","author":"张简","text":"海门棹驭出，鲸吼浪花飞。\n孔翠排旌盖，云昏黄鹤矶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其五","author":"张简","text":"龙子丹砂鬣，金芒耀水盆。\n真人忽骑去，霹雳破天根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其六","author":"张简","text":"夜过洞庭曲，青山玉作堆。\n仙人吹铁笛，白鹤自飞来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其七","author":"张简","text":"雨过积金顶，芙蓉万朵青。\n神鱼不飞去，风伏翠涛腥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其八","author":"张简","text":"忆坐松根石，相看说大还。\n昆崙云一朵，唤作九华山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其九","author":"张简","text":"仙花云万叠，浩劫与春开。\n却笑珊瑚树，焦枯作死灰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和铁崖小临海十首 其十","author":"张简","text":"海上三神峤，尝看羽盖飘。\n玉虹三百尺，嘘气结成桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其一","author":"薛兰英、蕙英","text":"姑苏台上月团团，姑苏台下水潺潺。\n月落西边有时出，水流东去几时还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其二","author":"薛兰英、蕙英","text":"馆娃宫中麋鹿游，西施去泛五湖舟。\n香魂玉骨归何处？\n不及真娘葬虎丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其三","author":"薛兰英、蕙英","text":"虎丘山上塔层层，静夜分明见佛灯。\n约伴烧香寺中去，自将钗钏施山僧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其四","author":"薛兰英、蕙英","text":"门泊东吴万里船，乌啼月落水如烟。\n寒山寺里钟声早，渔火江风恼客眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其五","author":"薛兰英、蕙英","text":"洞庭馀柑三寸黄，笠泽银鱼一尺长。\n东南佳味人知少，玉食无由进上方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其六","author":"薛兰英、蕙英","text":"荻芽抽笋楝花开，不见河豚石首来。\n早起腥风满城市，郎从海口贩鲜回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其七","author":"薛兰英、蕙英","text":"杨柳青青杨柳黄，青黄变色过年光。\n妾似柳丝易憔悴，郎如柳絮太颠狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其九","author":"薛兰英、蕙英","text":"一緺凤髻绿如云，八字牙梳白似银。\n斜倚朱门翘首立，往来多少断肠人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏台竹枝词十首 其十","author":"薛兰英、蕙英","text":"百尺高楼倚碧天，阑干曲曲画屏连。\n侬家自有《苏台曲》，不去西湖唱《采莲》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明良诗 其七","author":"吴当","text":"惟皇之念，翰墨是锡。\n倅尔嘉名，休光有奕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠陈章甫","author":"吉雅谟丁","text":"三十年前鬓未苍，曾陪宰相入鹓行。\n解衣换酒寻常醉，跃马看花取次忙。\n乱后已非前日梦，老来那复少年狂。\n黄冠野服新妆束，稳把长竿钓海乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤年弟尽弃纨绮故习清心学道特遗楮帐资其澹泊之好仍侑以诗","author":"吉雅谟丁","text":"谁捣霜藤万杵匀，制成鹤帐隔尘氛。\n香生芦絮秋将老，梦熟梅花夜未分。\n枕上不迷巫峡雨，床头常对剡溪云。\n竹炉松火茶烟暖，一段清贞尽属君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游定水寺寄杜尧臣","author":"吉雅谟丁","text":"水纹藤簟竹方床，山阁重阴雨后凉。\n新月梧桐秋已老，碧梧机杼夜初长。\n白鱼入馔松醪熟，红稻供炊笋脯香。\n云树芝泉随处好，一时清赏肯相忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题九灵山房图","author":"爱理沙","text":"梦里家山十载违，丹青咫尺是耶非？\n墨池新水春还满，书阁浮云晚更飞。\n张翰见机先引去，管宁避乱久忘归。\n人生若解幽栖意，处处林丘有蕨薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钟秀阁","author":"爱理沙","text":"槛外澄湖平不流，窗间叠嶂屹将浮。\n烟霞五色锦屏晓，风月双清瑶镜秋。\n薝葡浓香吹法席，芙蓉凉影荡仙舟。\n结巢拟傍云松住，回首朝簪愧未投。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄高丞相","author":"刘祁","text":"青云自致不须阶，十稔从容位上台。\n负荷一堂森柱石，调和众口费盐梅。\n勤劳密迩三朝重，寿考康宁七秩开。\n家道益昌孙有息，綵衣扶杖好归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"是年五月扈从上京宫学纪事绝句二十首 其二","author":"周伯琦","text":"层甍复阁接青冥，金色浮图七宝楹。\n当日熙春今避暑，滦河不比汉昆明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其七","author":"柯九思","text":"高鼻黄髯款塞胡，殿前引贡尽龙驹。\n仗移天步临轩看，画出韩生试马图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十首 其二","author":"柯九思","text":"黄金幄殿载前驱，象背驼峰尽宝珠。\n三十六宫齐上马，太平清暑幸滦都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其十四","author":"柯九思","text":"元戎承命猎郊坰，敕赐新罗白海青。\n得隽归来如奏凯，天鹅驰送入宫庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其二","author":"柯九思","text":"黑河万里连沙漠，世祖深思创业难。\n数尺阑干护春草，丹墀留与子孙看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫词十五首 其五","author":"柯九思","text":"万里名王尽入朝，法宫置酒奏箫《韶》。\n千官一色真珠袄，宝带攒装稳称腰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岭海将归梁吉士佩兰载酒邀同屈大均陈恭尹吴韦王准陈","author":"元基","text":"飞楼压高城，人天纳万籁。\n登临信可娱，矧与群彦会。\n吉士澹荡人，偕行屏轩盖。\n论交半簦笠，杂坐缓巾带。\n樽中酒如泉，海大鱼作鲙。\n款款话别悰，迢迢念归旆。\n于焉感昔游，兹楼在晻霭。\n凝思蹑丹梯，兴发不可奈。\n惟时建雄藩，自比夜郎大。\n邸中凿园池，巧匠恣雕绘。\n水亭拟舟梁，山木徒枞桧。\n长姣罗美人，管库敛文贝。\n因之设厉禁，游者心钳釱。\n一闭金兽镮，廿年委榛荟。\n修蛇穴其中，妖鸟叫其外。\n虽免劫火焚，终遭飓风害。\n人事戒满盈，天意恶侈忲。\n六师一以移，汉将齐下濑。\n刘王旧花坞，金粉尽淘汰。\n今来纵游观，足以动深慨。\n觞罢复凭阑，远目豁蒙{榷去木加弓}。\n祝融方司南，尉陀台占兑。\n万井郁参差，百谷互阳昧。\n人影数沙虫，林梢亚蓬艾。\n我非云中君，何缘出尘壒。\n少陵有遗诗，将老斯游最。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"眉妩 河东君妆镜，偕曹君直","author":"元忠","text":"叹秦淮秋老，杜曲门荒，金粉半尘土。\n定有惊鸿态，妆成后，熏香初试纤步。\n翠鸾漫舞，剩黛痕磨尽今古。\n更凄感，一样临池里，当如是观否。\n枯树，兰成心苦。\n早涧东人远，巾帽非故。\n零落沧桑影，铜仙泪，知他饱经风露。\n岁华细数，对半规重想眉妩。\n怕蕉萃菱花，还不许，绛云驻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东汉高士咏十四首 其一 刘翊","author":"张雨","text":"子相足周旋，破此家产丰。\n阴功谁为书，得来华阳中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题凤山古寨","author":"陈牧隐","text":"保障当年建义旗，凤山磐石绕汤溪。\n英雄战垒今何在，万古鸦声对落晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茂林","author":"杨宗瑞","text":"野水舟横行人稀，溪云断续树参差。\n南来北去年年事，归鸟巢林只一枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山邻钟隐君","author":"元瀚","text":"西云种德屡曾跻，不周之山天与齐。\n表弟忽传诗句到，中宵梦语西云西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山邻钟隐君","author":"元瀚","text":"中宵梦语西云西，云白天青帽顶齐。\n云侣有人供茗果，天梯无路只同跻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【归塞北】 其二","author":"白朴","text":"貂裘客，嘉庆卷帘看。\n好景画图收不尽，好题诗句咏尤难，疑在玉壶间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【好观音】 其三","author":"白朴","text":"富贵人家应须惯，红炉暖不畏严寒。\n开宴邀宾列翠鬟，拚酡颜，畅饮休辞惮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【幺篇】 其四","author":"白朴","text":"劝酒佳人擎金盏，当歌者款撒香檀。\n歌罢喧喧笑语繁，夜将阑，画烛银光灿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【结音】 其五","author":"白朴","text":"似觉筵间香风散，香风散非麝非兰。\n醉眼朦腾问小蛮，多管是南轩蜡梅绽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【幺篇】 其二","author":"白朴","text":"宋玉悲秋愁闷，江淹梦笔寂寞。\n人间岂无成与破，想别离情绪，世界里只有俺一个。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【伊州遍】 其三","author":"白朴","text":"为忆小卿，牵肠割肚。\n凄惶悄然无底末，受尽平生苦。\n天涯海角，身心无个归着。\n恨冯魁，趋恩夺爱，狗行狼心，全然不怕天折挫。\n到如今刬地吃耽阁，禁不过，更那堪晚来暮云深锁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【幺篇】 其四","author":"白朴","text":"故人杳杳，长江风送，听胡笳沥沥声韵聒。\n一轮皓月朗，几处鸣榔，时复唱和渔歌。\n转无那，沙汀蓼岸，一点渔灯相照，寂寞古渡停画舸。\n双生无语泪珠落，呼仆隶指泼水手，在意扶柁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【尾声】 其五","author":"白朴","text":"兰舟定把芦花过，橹声省可里高声和。\n恐惊散宿鸳鸯，两分飞也似我。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【幺篇】 其二","author":"白朴","text":"恰春光也，梅子黄时节，映日榴花红似血。\n胡葵开满院，碎剪宫缬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【挂搭沽序】 其三","author":"白朴","text":"倏忽早庭梧坠，荷盖缺。\n院宇砧韵切，蝉声咽。\n露白霜结，水冷风高，长天雁字斜，秋香次第开彻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"【幺篇】 其四","author":"白朴","text":"不觉的冰澌结，彤云布，朔风凛冽。\n乱扑吟窗，谢女堪题，柳絮飞玉砌。\n长郊万里，粉污遥山千叠。\n去路赊，渔叟散，披蓑去，江上清绝。\n幽悄闲庭院，舞榭歌楼酒力怯，人在水晶宫阙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]