[{"title":"忆李东轩","author":"耶律铸","text":"枚卜云山醉隐居，可能无地置屠苏。\n驾飞鸿去翔寥廓，羡杀高人李上都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12617,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄李渊","author":"耶律铸","text":"只须剩剪鸳鸯锦，更与重围翡翠楼。\n不信西风将白雪，便教吹上远人头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12618,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨子美","author":"耶律铸","text":"万里关山人去后，一江风雨雁来时。\n悠悠自别无消息，漫草新诗寄所思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12619,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄国范","author":"耶律铸","text":"旧欢新梦两悠悠，只引相思上驿楼。\n尺素不应无寄处，玉滦江抱凤城秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12620,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄李稚川","author":"耶律铸","text":"不堪人坐著风篷，别后俄惊一岁终。\n寥落天边倦游客，酒杯何日与君同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12621,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄赵虎岩","author":"耶律铸","text":"世态人情但见时，未尝仔细不寻思。\n伤心吾道难开口，何处青山约后期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12622,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"睡起有寄","author":"耶律铸","text":"连日轻阴护好花，几场春梦绕天涯。\n寻思不记相逢处，又入街西卖酒家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12623,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺子所寄","author":"耶律铸","text":"风流玩世酒中仙，独醉仙名盖世传。\n诗价一如声价重，且将锦绣裹山川。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12624,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄家兄","author":"耶律铸","text":"碧云天外寄相思，叠纸封愁鬓欲丝。\n一枕晓窗春梦好，东风烂漫小桃枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12625,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄郭仲益鍊师","author":"耶律铸","text":"瑶草祇堪尘外种，凤箫当就月中闻。\n应怜汉女临溪水，閒洗榴花染白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12626,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西斋述事奉寄东都故人","author":"耶律铸","text":"酣觞始得离骚味，恨杀灵均说独醒。\n待与解嘲还自笑，默然翻守太元经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12627,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄归二首 其一","author":"耶律铸","text":"深掩兰闺定自珍，千金一笑万金身。\n笔头无舌倾心事，不著流莺说不真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12628,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄归二首 其二","author":"耶律铸","text":"几凭青鸟报芳尘，终是将心寄不真。\n一纸短书分付与，蕊珠宫里弄珠人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12629,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄人","author":"耶律铸","text":"囊括乾坤计未疏，不知胠箧竟何如。\n如何万里惊尘座，未奉平安纸一书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12630,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日怀王澹游禧伯","author":"耶律铸","text":"长记寻春信马蹄，画桥流水乱莺啼。\n别来往事浑如梦，明月满庭芳草齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12631,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀李舜卿","author":"耶律铸","text":"北来得见鸿音少，南去徒来蝶梦多。\n一曲高歌人万里，几回无语上高坡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12632,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀曹通甫","author":"耶律铸","text":"流水迢迢芳草匀，相思吟杀倚楼人。\n万里关山一壶酒，与谁重醉凤楼春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12633,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代人作","author":"耶律铸","text":"玉箫抛曲锦停梭，却倚妆楼怨梦多。\n心在故园身在客，一声秋雁过滹沱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12634,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"席上和光祖上佥事寿诗韵","author":"耶律铸","text":"素娥檀板象牙床，低按秦筝荐寿觞。\n翰林风月三千首，一岁从头上一章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12635,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为人寿","author":"耶律铸","text":"漫漫寒雪望来迷，喜见孤松渐出堤。\n一岁只能生一寸，与君相约碧云齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12636,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题寿人八十卷尾","author":"耶律铸","text":"未入非熊惜壮图，却簪黄发掩仙居。\n空花不挂真人眼，一任春风撼太虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12637,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代书答征西将士抑绝所请","author":"耶律铸","text":"一同游蜀道登天，回首斯须十二年。\n老我风神今不似，剑门关内陈场前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12638,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"磨剑行","author":"耶律铸","text":"故国江山梦里行，不期今日果长征。\n剑华休遣尘生涩，万事人閒总未平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12639,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉去来辞五首 其一","author":"耶律铸","text":"唯有乐天知道者，祇欣欢伯意安哉。\n慇勤且莫相回避，著去相将醉去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12640,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉去来辞五首 其二","author":"耶律铸","text":"为慕公和爱啸台，结茅特就北山莱。\n须非树挂风瓢处，莫厌歌呼醉去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12641,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉去来辞五首 其三","author":"耶律铸","text":"启事许谁当首肯，谋生休自谩牙欸。\n系风捕影非吾事，问柳寻花醉去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12642,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉去来辞五首 其四","author":"耶律铸","text":"日日名花次弟开，看长春色映楼台。\n司花可要司春子，准备西园醉去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12643,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉去来辞五首 其五","author":"耶律铸","text":"可爱风流赵素台，与香风引到蓬莱。\n诚知宦海风波恶，离了风波醉去来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12644,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园仙居亭对雪命酒作白雪嗺 其一","author":"耶律铸","text":"玉花团结就冰桃，玉蕊凝香袭冻醪。\n时自唱歌嗺痛饮，踏歌白雪代离骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12645,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园仙居亭对雪命酒作白雪嗺 其二","author":"耶律铸","text":"情知白玉莲花酌，岂抵天然自暖杯。\n玉友也须期白雪，缓歌惟命雪儿嗺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12646,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园仙居亭对雪命酒作白雪嗺 其三","author":"耶律铸","text":"谁长更得非中圣，自爱惟知是上尊。\n只许飞琼歌白雪，缓歌催捲玉昆崙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12647,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园仙居亭对雪命酒作白雪嗺 其四","author":"耶律铸","text":"风流天上玉华君，应为花閒种玉人。\n延命阳春将白雪，立生春色入壶春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12648,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西园仙居亭对雪命酒作白雪嗺 其五","author":"耶律铸","text":"浮云盌里酌云液，明月杯中酌月波。\n白雪调高谁可和，散花天女与韩娥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12649,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"横笛引 其一","author":"耶律铸","text":"雪梅清瘦怕春知，待结同心与阿谁。\n谁许云封将怨笛，引吟龙去陇头吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12650,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"横笛引 其二","author":"耶律铸","text":"为谁折柳雪长丝，横笛知谁引所思。\n春水绿波芳草路，枉教愁杀路傍儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12651,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"横笛引 其三","author":"耶律铸","text":"落梅流韵游金谷，折柳传情寄玉关。\n蕴结长思无计解，只应心曲是连环。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"横笛引 其四","author":"耶律铸","text":"野梅官柳得长生，写出龙吟与凤鸣。\n已许云封封怨笛，不教人世有愁声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四公子廋辞体四首 其一","author":"耶律铸","text":"细腰宫里芳菲处，唯有金衣公子知。\n尝笑何郎暮春怨，绍兰只寄一联诗。","collection":"元","notice":"","