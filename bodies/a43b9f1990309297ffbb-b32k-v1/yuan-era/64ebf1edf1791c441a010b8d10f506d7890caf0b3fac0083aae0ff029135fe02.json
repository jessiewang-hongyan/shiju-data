[{"title":"咏史 党奴","author":"张玉娘","text":"江雪寒连酒思豪，歌传锦帐醉烹羔。\n争如取水陶承旨，茗椀清新兴味高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春思","author":"张玉娘","text":"玉勒雕鞍燕北春，閒愁空自惜芳尘。\n杨花入户还飞去，应笑虚帏翠被新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昼寝","author":"张玉娘","text":"南窗无事倦春妍，绣罢沉香火底眠。\n清梦却同飞絮杳，误随双蝶度秋千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜长","author":"张玉娘","text":"秋风生夜凉，风凉秋夜长。\n贪看山月白，清露湿衣裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其十 凤头钗","author":"张玉娘","text":"金蹙钗头双凤凰，晓来巧拂鬓云光。\n自怜不带萧郎思，独对菱花学淡妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其八 玉压衾","author":"张玉娘","text":"匠出昆山一片珍，白虹气爽晚凉新。\n鸳鸯不作湘波梦，幽独还嫌锦绣裀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":264,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其四 扶玉椅","author":"张玉娘","text":"绣罢南窗睡思催，花生银海玉山颓。\n东风斜倚娇无力，梦入湘江隔楚台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":265,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其五 凌波袜","author":"张玉娘","text":"天孙夜半剪云罗，翠幄春分巧思多。\n一束金莲微印月，香尘不动步凌波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":266,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其三 鹊尾炉","author":"张玉娘","text":"汉宫早送瑶池信，荀令堂前夜气浮。\n凭仗花间拜新月，重添新篆炷春愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":267,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花","author":"张玉娘","text":"潇洒石池边，清标出自然。\n东风零乱后，蜕甲玉蜿蜒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":268,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春闻莺","author":"张玉娘","text":"膏雨初乾风日晴，绿阴深处一声莺。\n唤回午枕伤春梦，起向蔷薇花下行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":269,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻笛","author":"张玉娘","text":"小楼吹夜笛声飞，暗度梅花入翠帏。\n曲罢梦回肠欲断，起看秋月色凝衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":270,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端午","author":"张玉娘","text":"晓糁蒲玉泛琼浆，臂结红丝暗自伤。\n莫漫相逢宜楚节，独怜清梦隔潇湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画小景","author":"张玉娘","text":"山合云初尽，溪阴下夕阳。\n贪看无限好，柳底坐秋光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画 伯牙","author":"张玉娘","text":"山家茆屋隔寒林，独抱枯桐觅旧吟。\n门掩无人飞蛱蝶，白云垂地结晴阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"从军行","author":"张玉娘","text":"二十遴骁勇，从军事北荒。\n流星飞玉弹，宝剑落秋霜。\n画角吹杨柳，金山险马当。\n长驱空朔漠，驰捷报明王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏竹 风","author":"张玉娘","text":"满庭修竹动秋风，掠地无痕一径通。\n影弄绿窗金琐碎，声归宝瑟玉玲珑。\n流云不碍湘妃佩，隔水还疑蔡女桐。\n曲罢岂知鸾鹤在，翠霞飞去玉台空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏案头四俊 马肝砚","author":"张玉娘","text":"一贡西支路八千，端溪无石玉还坚。\n龙媒带雨滴秋月，霜兔和云染翠烟。\n凤咮山荒幽草合，雀台春老野花妍。\n丹砂不用医繁鬓，留尔芸窗勖草玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏案头四俊 珠麝墨","author":"张玉娘","text":"兰煤薰透漏星房，苍璧无痕晕漆光。\n万杵龙珠凝海水，十分麝泪泣玄霜。\n松烟入砚还矜色，江雨翻云别有香。\n风静月林秋气逼，满天诗思动清商。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春妆凝思","author":"张玉娘","text":"春来常是见花羞，终日帘垂懒上钩。\n淑气薰人饶旧梦，柳条萦带绾新愁。\n情归野草泥寒雨，目断长江送去舟。\n笑比南金身自许，镜鸾独抱下妆楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜","author":"张玉娘","text":"松花香度漏初沈，人静庭空落暗金。\n一枕嫩风清晓露，半窗凉月弄轻阴。\n坐移十二阑干曲，兴入千层积翠深。\n弹罢云和重问夜，蔷薇影里复长吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春睡","author":"张玉娘","text":"绣倦南窗下，翛然睡思催。\n红日过墙去，清风入幕来。\n幽梦迷庄蝶，荒云隔楚台。\n觉来香缕在，虚室绝尘埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜","author":"张玉娘","text":"暮声杂鸣叶，灵籁生郊墟。\n白雾脆杨柳，秋水翻芙蕖。\n蟾蜍澹帘箔，机杼织寒虚。\n几度思蘋藻，茫然愧鹿车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺情 沐发","author":"张玉娘","text":"腻滑青螺宝髻黏，金盘香水吸寒蟾。\n指尖巧弄琅玕影，楚发轻披云母帘。\n掠雾暗疑星点点，拂波深见玉纤纤。\n起来乱绾慵双凤，熏彻沉檀强自添。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游春","author":"张玉娘","text":"侍儿传野约，趣伴出邻姬。\n竹外花迎佩，溪边柳笑眉。\n春随流水远，日度锦云迟。\n拾翠人争问，含羞独有诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新燕忆女弟京娘","author":"张玉娘","text":"三月江南绿正肥，阴阴深院燕初归。\n乱衔飞絮营新垒，閒逐花香避绣帏。\n却笑秋风红缕在，独怜旧事玉京非。\n兰闺终日流清泪，愧尔双飞拂落晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春夜思","author":"张玉娘","text":"夜凉春寂寞，淑气浸虚堂。\n花外钟初转，江南梦更长。\n野春鸣涧水，山月照罗裳。\n此景谁相问，飞萤入绣床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石榴亭诸父夜酌","author":"张玉娘","text":"永漏报高阁，榴亭出夜筵。\n紫檀熏宝鼎，银烛散青烟。\n灵籁生修竹，香风入夏弦。\n露浓罗袖重，歌遏酒杯传。\n诸妇酣春梦，双娥失翠钿。\n玉山推不倒，看月背花眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽州胡马客","author":"张玉娘","text":"幽州胡马客，莲剑寒锋清。\n笑看华海静，怒振河山倾。\n金鞍试风雪，千里一宵征。\n韔底揪羽箭，弯弓新月明。\n仰天坠雕鹄，回首贯长鲸。\n慷慨激忠烈，许国一身轻。\n愿系匈奴颈，狼烟夜不惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山之高三章","author":"张玉娘","text":"山之高，月出小。\n月之小，何皎皎。\n我有所思在远道，一日不见兮我心悄悄。\n采苦采苦，于山之南。\n忡忡忧心，其何以堪。\n汝心金石坚，我操冰雪洁。\n拟结百岁盟，忽成一朝别。\n朝云暮雨心去来，千里相思共明月。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日","author":"张玉娘","text":"曈日破寒天，红光生紫烟。\n诗情归草梦，春色染桃笺。\n眉月添明镜，梅妆静翠钿。\n堂开诸弟集，相对笑迎年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双燕离","author":"张玉娘","text":"白杨花发春正美，黄鹄帘垂低燕子。\n双去复双来，将雏成旧垒。\n秋风忽夜起，相呼度江水。\n风高江浪危，拆散东西飞。\n红径紫陌芳情断，朱户琼窗旅梦违。\n憔悴卫佳人，年年愁独归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閒坐口谣","author":"张玉娘","text":"独坐看花枝，无言双泪垂。\n痴婢不知意，问我心恨谁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古别离","author":"张玉娘","text":"把酒上河梁，送君灞陵道。\n去去不复返，古道生秋草。\n迢递山河长，缥缈音书杳。\n愁结雨冥冥，情深天浩浩。\n人云松菊荒，不言桃李好。\n澹泊罗衣裳，容颜萎枯槁。\n不见镜中人，愁向镜中老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白雪曲","author":"张玉娘","text":"帘白明窗雪，风急寒威冽。\n欲起理冰弦，如凝指尖折。\n霜帏眠不稳，愁重肠千结。\n閒看腊梅梢，埋没清尘绝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"池边待月","author":"张玉娘","text":"待月月未升，看池池水清。\n冰夷吹海浪，薄雾约云英。\n惟见寒波动，嫦娥明镜行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"灯夕迎紫姑神","author":"张玉娘","text":"淑气回春雪渐融，星河天上一宵通。\n芙蕖万点交秋月，鼓角三更度晓风。\n烛影晕迷光绰约，帘环声彻佩玲珑。\n不妨鸟篆留仙迹，凤辇殷勤出紫宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听琴","author":"张玉娘","text":"竹外结枯桐，琅琅生松风。\n听来还自惜，坐对烛花红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和谪弟三一三峡晓征寄回韵","author":"张玉娘","text":"鸟道萦纡入剑门，谪居惟汝独怜恩。\n锁天烟黑疑无地，隔树人言知有村。\n听雨不生池草梦，看云应断故乡魂。\n平安日问南归雁，三峡清秋依晓猿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 马融","author":"张玉娘","text":"堂下青衿日就文，帐中丝竹遏行云。\n岂应鲁壁遗经日，雅奏洋洋满耳闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 伏生","author":"张玉娘","text":"楚炬秦坑六籍埃，芳心争忍不同灰。\n若非斯道终难坠，雪鬓应消异世才。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 陈图南","author":"张玉娘","text":"避名高卧白云深，扶醉骑驴下碧岑。\n一笑披袍惊堕处，遁时知有济时心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 绿珠","author":"张玉娘","text":"珠易佳人胜阿娇，香尘微步独怜腰。\n危楼花落繁华尽，总付春风舞柳条。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏竹 月","author":"张玉娘","text":"幽幽万籁竹千竿，凉夜宜从月里看。\n翠节参差邀玉兔，金波晃漾浴青鸾。\n半檐苍月催诗思，一径寒辉醒醉魂。\n吹彻霓裳清露下，嫦娥犹自对芳樽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏竹 烟","author":"张玉娘","text":"数枝潇洒碧溪寒，水气冥冥日欲昏。\n青玉案前双翡翠，紫丝帐里万琅玕。\n湘江旧事迷归梦，陆海春阴无羽翰。\n晚来独倚阑干望，暝色连天何处村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏竹 雪","author":"张玉娘","text":"冻雪霏霏堕九皋，竹枝垂地翠旋销。\n玉龙战退飞鳞甲，青凤翻成白羽毛。\n岁晚馀寒知劲节，梦回佳兴讶清标。\n隔云谁弄柯亭笛，落尽梅花风韵高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏夏雨","author":"张玉娘","text":"头上云俱黑，一片雨浪浪。\n惨澹隐高树，霏微迷绿杨。\n冷冷添涧水，点点落危樯。\n帘捲山流翠，郊虚草自香。\n静嫌声间竹，醉爱爽凝觞。\n殿阁罗閒扇，池亭送嫩凉。\n荷珠圆复碎，兰芷脆还芳。\n拂埃乱天际，度云喧草堂。\n乘空曳轻练，向晚洗炎光。\n幽径荒苔滑，短檐飞鸟忙。\n湛湛翻萍影，溶溶浸柳塘。\n无心留石洞，有梦恼襄王。\n暝色欺明月，高飙透薄裳。\n入更生阒寂，攲坐讶清商。\n润气清湘簟，徘徊怯绣床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏案头四俊 凤尾笔","author":"张玉娘","text":"近来觅得管城子，修竹枝头彩影高。\n气挟风云驱阵势，光摇文彩动旌旄。\n诗成览德三书俊，梦入生花五色豪。\n圣代祇今皆有象，晴窗处处凤凰毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏案头四俊 锦花笺","author":"张玉娘","text":"薛涛诗思饶春色，十样鸾笺五采誇。\n香染桃英清入观，影翻藤角眩生花。\n涓涓锦水涵秋叶，苒苒剡波漾晚霞。\n却笑回文苏氏子，工夫空自废韶华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜鹭","author":"张玉娘","text":"白鹭宿秋陂，夜寒如堕雪。\n久立不飞去，月明霜气冽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明月引","author":"张玉娘","text":"明月度天飞，团团散清晖。\n中有后羿妻，窃药化蟾蜍。\n碧海心如梦，澹澹生寒虚。\n关山一夜愁多少，照影令人添惨悽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"牧童辞","author":"张玉娘","text":"朝驱牛，出竹扉，平野春深草正肥。\n暮驱牛，下短陂，谷口烟斜山雨微。\n饱采黄精归不饭，倒骑黄犊笛横吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"采莲曲","author":"张玉娘","text":"女儿采莲拽画船，船拽水动波摇天。\n春风笑隔荷花面，面对荷花更可怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居四景 其一 山色","author":"张玉娘","text":"远山翠不减，满庭摇空青。\n坐对太古色，终日有馀情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居四景 其二 水光","author":"张玉娘","text":"渺渺涵秋色，澄澄生晓烟。\n四山潦初歇，寒玉一溪完。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居四景 其三 窗月","author":"张玉娘","text":"山月流素晖，小窗绝嚣响。\n四壁寂无声，合座生灵爽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"幽居四景 其四 蛩音","author":"张玉娘","text":"落木旧山寺，霜清叶扫风。\n已无鸡犬声，虚殿鸣秋蛩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晓谣","author":"张玉娘","text":"到枕一声莺，晓窗生虚白。\n烟柳影参差，蔷薇红半拆。\n乘风双蛱蝶，欲入珠帘隔。\n独向花下吟，翠筱剌罗襟。\n徘徊吟不就，婢子整瑶琴。\n抚弦不堪弹，调别无好音。\n一弦肠一断，断尽几回心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋江辞","author":"张玉娘","text":"烟迷浦口人迹稀，老松瘦竹横斜晖。\n舟人鲙切莼羹美，竹叶香清蟹正肥。\n醉眠篷底呼不醒，一任春风吹鬓影。\n起来霜月白满天，淅沥蒹葭凉夜静。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋思","author":"张玉娘","text":"秋入银床老井梧，能言鹦鹉日相呼。\n兰闺半月閒针线，学得崔徽一镜图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋思","author":"张玉娘","text":"爽籁生灵径，清秋澹碧空。\n乘凉赊月色，问夜出帘栊。\n独坐怜团扇，罗衣吹暗风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"结袜子","author":"张玉娘","text":"闺中女儿兰蕙性，寒冰清澈秋霜瑩。\n感君恩重不胜情，容光自抱悲明镜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺情 卜归","author":"张玉娘","text":"南浦萧条音信稀，百劳东去燕西飞。\n玉钗敲断灯花冷，游网乘空蟢子非。\n沉水斋心燃宝鼎，金钱纤手卜灵龟。\n数期细认先天课，甲乙爻加归未归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺情 秋千","author":"张玉娘","text":"瘦腰春病不成围，闲逐秋千荡画衣。\n香散天风兰佩堕，声摇环玉綵绳飞。\n飘飖似跨双鸾去，闲雅宜从月殿归。\n无力尚怜扶不起，翠蛾犹蹙怨斜晖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闺情 倦绣","author":"张玉娘","text":"绿窗春睡起常迟，绣罢鸳鸯听子规。\n斜倚睡屏閒怅望，慵临鸾镜独支颐。\n工馀綵线日空永，愁伴珊瑚梦已违。\n细数目前花落尽，伤心都付不言时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其六 梅花枕","author":"张玉娘","text":"玉肤冰骨独英英，绣向珊瑚照睡屏。\n疑有暗香生纸帐，罗浮梦断晓魂惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其七 紫香囊","author":"张玉娘","text":"珍重天孙剪紫霞，沉香羞认旧繁华。\n纫兰独抱灵均操，不带春风儿女花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其二 鲛绡帨","author":"张玉娘","text":"半幅生绡雪色寒，鲛人相赠比琅玕。\n华清浴罢恩波媚，南浦伤时泪雨斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏夜园亭纳凉","author":"张玉娘","text":"南园有凉气，移席散馀情。\n新月隐修竹，清风开小亭。\n水骨静香汗，霜纨扑乱萤。\n忽然微雨至，爽籁拂檐楹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海棠月","author":"张玉娘","text":"永夜无人玉漏迟，团团月上海棠枝。\n月留凉露芳尘暗，花弄清晖淑影移。\n粉黛三千春对镜，银波万顷晓凝脂。\n深闺为尔牵愁兴，坐问容光强赋诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"班婕妤 其一","author":"张玉娘","text":"一自怜捐弃，香迹玉阶疏。\n闻道西宫路，近亦绝鸾舆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚楼凝思","author":"张玉娘","text":"鸳鸯绣罢阁新愁，独抱云和散画楼。\n风竹入弦归别调，湘帘捲月笑银钩。\n行天雁向寒烟没，倚槛人将清泪流。\n自是病多松宝钏，不因宋玉故悲秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]