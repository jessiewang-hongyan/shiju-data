[{"title":"次韵马伯庸应奉绝句八首 其四","author":"袁桷","text":"小楼昨夜听琵琶，推手却手怨王家。\n不辞远嫁卢龙道，可怜长城骨如沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸应奉绝句八首 其五","author":"袁桷","text":"红衣夜唱娑罗树，云是西天好儿孙。\n吹螺日饮官法酒，笑渠骑马傍人门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸应奉绝句八首 其六","author":"袁桷","text":"谁家弄玉矜少年，采莲艇子歌娟娟。\n转首那知颜色老，犹抹横云啼镜前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸应奉绝句八首 其七","author":"袁桷","text":"向曾六月桓州住，雪歇前岩散冰树。\n王郎马郎太愁生，两骑双双辞我去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵马伯庸应奉绝句八首 其八","author":"袁桷","text":"乌靴窄窄称宫袍，双鬓风翻见二毛。\n闻道中山止十驿，急须乘马酿松醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学伯庸上都见寄二首 其一","author":"袁桷","text":"阴阴棕殿水云苍，鳷鹊风微夏日长。\n浑似醴泉宫畔境，千官齐立从文皇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学伯庸上都见寄二首 其二","author":"袁桷","text":"纱縠单衣佩水苍，碧笺裁诏茧丝长。\n日斜双入通明殿，云母屏前对玉皇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱舜举折枝菊","author":"袁桷","text":"醉别南山十五秋，雁声深恨夕阳楼。\n寒香似写归来梦，背立西风替蝶愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"葛仙翁移居图","author":"袁桷","text":"翁媪相携入翠微，转头犹有可怜儿。\n丹砂不是神仙药，勾漏归来鬓已丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离宫图","author":"袁桷","text":"龙首渠开王气埋，浅沙残草认天街。\n当年金屋寒鸦聚，时有耕人拾宝钗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子昂逸马图","author":"袁桷","text":"神骏飘飘得自閒，天池飞跃下尘寰。\n青丝络首谁收得，留与春风十二闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"薛涛笺二首 其一","author":"袁桷","text":"蜀王宫树雪初消，银管填青点点描。\n可是春山留不住，子规声断促归朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"薛涛笺二首 其二","author":"袁桷","text":"十样蛮笺起薛涛，黄筌禽鸟赵昌桃。\n浣花旧事何人记？\n万劫春风燐火高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22767,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫女度曲图","author":"袁桷","text":"望瀛法曲紫霞觞，更按《伊州》奉玉皇。\n翠竹凉深宫院密，新声那得过宫墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22768,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简马伯庸","author":"袁桷","text":"象榻香浓翠幌春，美人倦绣态横陈。\n平明欲进朝天袜，小立兰灯熨贴频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22769,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"居庸关","author":"袁桷","text":"太行领群山，万马高下拜。\n平峦转城隍，隐隐南北界。\n危坡互交牙，寒溜泻泙湃。\n阴风玄虬涌，巨石忽崩坏。\n周遭青松根，下有古木砦。\n石皮散青铜，云是旧战铠。\n天险不足凭，历劫有成败。\n驱车上林杪，出日浴光怪。\n肃肃空岩秋，天风迅行迈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22770,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中度南口","author":"袁桷","text":"山寒绝禽鸟，独闻子规啼。\n石壁飞雨骤，众木摇凄凄。\n瘦马蹴乱石，高下齧其蹄。\n陟巘沮洳深，渐觉所历低。\n暝色起亭午，土屋流寒泥。\n须臾过雷声，倏忽生晴霓。\n水清亦可度，戒仆踰前溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22771,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"度怀来沙碛","author":"袁桷","text":"沙清圆石瘦，千里闻风声。\n驱此觳觳车，索索莎鸡鸣。\n远山列翠席，近坡环碧城。\n高下各有险，辙迹那由平。\n惊兔导我前，历录为之惊。\n天低云摇荡，土旷尘纵横。\n谬膺翰墨选，远行有期程。\n回头望南坂，初月随风生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22772,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙门","author":"袁桷","text":"瀚海双龙铁鳞甲，卷壑挐云蹲冀阙。\n千泉百道凑东南，急雨翻空迸晴雪。\n古言神禹功最多，导山凿石疏九河。\n幽都之地不复顾，乃使双龙下地成盘涡。\n阴风何飕飕，磅礴太古秋。\n崩崖落车炮，怪木森戈矛。\n碎沙晴日铺金麸，云是昔日当关挽劲之仆姑。\n寒泉组练结九曲，亭午赫日光模糊。\n车声何辚辚，昨宵急水迷无津。\n垂堂之言犹在耳，游子商人行不已。\n子规彻天呼我归，翠华北幸那得辞。\n龙门之石高不磨，泚笔书我龙门歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22773,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"弹琴峡","author":"袁桷","text":"寒泉飞玉峡，谁弹使成声。\n下有战士骨，呜咽水中鸣。\n丝石本异调，摩戛生亏成。\n凿迹匪神禹，佳兵搆秦嬴。\n驻马为听之，逝者何不平。\n虚牝纳新雨，急促浊复清。\n重华初省方，百神静相迎。\n为作薰风弦，散彼岩下情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22774,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云州","author":"袁桷","text":"天阔云中郡，刚风起泬寥。\n毡房联涧曲，土屋覆山椒。\n橦布朝朝市，通薪户户烧。\n遥看尘起处，深羡霍嫖姚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22775,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金主画孟浩然骑驴图","author":"袁桷","text":"生前明主已遭嗔，身后君王为写真。\n家国总缘诗句废，灞陵犹胜蔡州尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22776,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李陵台","author":"袁桷","text":"雪衮寒沙风衮灰，眼穿犹上望乡台。\n陇西可是无回雁？\n不寄平安一字来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22777,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登候台","author":"袁桷","text":"蜿蜒西龙冈，绿草摇晴波。\n旁有双玉井，石角增嵯峨。\n明良佐神运，目力穷坡陁。\n层垣睥睨雄，宝构通羲娥。\n昂昂铁竿耸，飞鸟光荡摩。\n土屋粘蜜房，文毡围锦窠。\n缅思皇猷远，默止松林戈。\n匪以清暑游，跋履劳鸣珂。\n阴森晚色晦，寒沙聚群驼。\n悲笳月初上，戴斗瞻天河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22778,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其一","author":"袁桷","text":"云护中街日，风开北户天。\n千沟凝白雪，万灶起青烟。\n午溽曾持扇，朝寒却衣绵。\n松林空有界，剪伐不知年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22779,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其二","author":"袁桷","text":"土屋层层绿，沙坡簇簇黄。\n马鸣知雹急，雁过识天凉。\n墨菊清秋色，金莲细雨香。\n内园通阆苑，千树压群芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22780,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其三","author":"袁桷","text":"天阙虚无里，城低纳远山。\n白榆迷雁塞，青草补龙湾。\n市簇家家近，官清日日閒。\n重游深问俗，渐恨鬓毛斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22781,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其四","author":"袁桷","text":"旧岁寒冬恶，霏霏土雨迷。\n门荒悬马革，草净绝牛蹄。\n列帐烟光惨，空营月色低。\n县官捐粟帛，岁晚得扶携。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22782,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其五","author":"袁桷","text":"上国饶为客，天凉眼倍青。\n白鱼沙际网，黄鼠草间翎。\n芍药围红斗，摩姑缀玉钉。\n渐知尘骨换，振佩接青冥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22783,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其六","author":"袁桷","text":"天锡清凉国，晴霞绽雪峰。\n月低疑堕兔，云近得攀龙。\n宝鉴颁水彻，筠笼赐果封。\n白头貂帽客，为我话深冬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22784,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其七","author":"袁桷","text":"驼鼓村村应，传更趣进程。\n草肥凉露白，树薄晓风清。\n帐殿横金屋，毡房簇锦城。\n属车流水度，细点侍臣名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22785,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其八","author":"袁桷","text":"伏日琼林宴，名王总内朝。\n帽尖花压翠，衣角锦围貂。\n炙熟牛酥芼，醅深马乳浇。\n《柘枝》旋舞急，宛转称纤腰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22786,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其九","author":"袁桷","text":"市狭难驰马，泥深易没车。\n冻蝇争日聚，新燕掠风斜。\n晚汲喧沙井，晨炊断木槎。\n闾阎通茗酪，俗简未全奢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22787,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京杂咏十首 其十","author":"袁桷","text":"长夏崇真馆，疏帘洒静便。\n支颐推万古，止息契重玄。\n月窟窗如雪，天瓢酒似泉。\n主人怜老客，下榻不曾悬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22788,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其一","author":"袁桷","text":"帝京环陆海，平野接冰天。\n龙吐青林火，狼沈紫塞烟。\n风花秋黯澹，云叶雨连绵。\n昔日君臣意，深符卜洛年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22789,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其二","author":"袁桷","text":"宝阁凌空涌，金壶映日黄。\n梵音通朔漠，法曲广伊凉。\n御榻惟经帙，宫炉独篆香。\n吾皇清净德，银管愿垂芳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22790,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其三","author":"袁桷","text":"高下云中树，疏明雪外山。\n坡凹茅结屋，岭转水回湾。\n禁路分驰道，沙场当内闲。\n通明风露冷，时许侍清班。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22791,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其四","author":"袁桷","text":"晨起仪台立，烟青望眼迷。\n草低鹰侧目，车逼马回蹄。\n风劲弓弦直，泥融柱础低。\n蚊蝇深敛迹，麈尾不须携。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22792,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其五","author":"袁桷","text":"紫极中天正，森森接帝青。\n雁归传帛信，雉落舞红翎。\n宝所金千顷，朱门带万钉。\n瀛洲清浅处，高坐纳空冥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22793,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其六","author":"袁桷","text":"昔年曾扈跸，宿直对鳌峰。\n锦掣兰苕翠，波翻墨沼龙。\n起居青简注，除拜紫泥封。\n共说先皇日，千官总住冬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22794,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其七","author":"袁桷","text":"土驿高低置，苍茫七日程。\n马通分熠耀，牛酪注深清。\n残雪明珠阙，繁星列火城。\n前山黄白处，草药不知名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22795,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其八","author":"袁桷","text":"千堞蜂腰凸，群山马首朝。\n沙场调俊鹘，草窟射丰貂。\n闹舞花频簇，狂歌酒恣浇。\n今年春事减，土舍雪齐腰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22796,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其九","author":"袁桷","text":"箭落惊游骑，铃传督运车。\n土风殊楚越，驿道仿褒斜。\n细雨三更枕，清秋八月槎。\n夜听繁管急，渐习五陵奢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22797,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次上京杂咏韵十首 其十","author":"袁桷","text":"长斋孤馆静，捧腹睡便便。\n酒断眸凝碧，尘深鬓返玄。\n冻蜂粘暖草，乳燕啄冰泉。\n过翼时频数，乡心日夜悬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22798,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松林行","author":"袁桷","text":"阴阴松林八百里，昔日相传为界址。\n玄云卷甲天马来，雪兔霜狐先委靡。\n山前犬牙十六州，石郎屈膝轻相投。\n浅沙圆石古辙迹，草青草枯无尽愁。\n□□拂天镇南北，万井燃松烟似墨。\n大车□□龙角全，小车轮囷束矛戟。\n松花落子□复抽，不如昔日当道稠。\n采薪之人不辞□，出郭十里争相酬。\n君不闻雪山之西铜柱南，混同鸭绿成东渐。\n金山橐驼争贡宝，剪取平林作驰道。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22799,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学途中竹枝词四首 其一","author":"袁桷","text":"红袍旋风漾金泥，车前把酒长跪齐。\n忽听琵琶相思曲，迎郎北来背面啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22800,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学途中竹枝词四首 其二","author":"袁桷","text":"毡房锦幄花簇匀，酥凝叠饼生玉尘。\n晚传宫壶檀板急，酒转一巡先吐茵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22801,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学途中竹枝词四首 其三","author":"袁桷","text":"土屋苫草成廜?，前床翁媪后小姑。\n我郎南来得小妇，芦笛声声吹鹧鸪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22802,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学途中竹枝词四首 其四","author":"袁桷","text":"阊阖云低接紫宫，水晶凉殿起薰风。\n侍臣一曲无怀操，能使八方歌会同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22803,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题桦皮","author":"袁桷","text":"褐裳新脱玉层层，红叶朱蕉谢不能。\n拟制小冠韬短发，意行云水一枝藤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22804,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙虎台","author":"袁桷","text":"群山朝宸居，层台纳灵秀。\n百泉暗东西，千嶂明左右。\n先皇雄略深，省方岁巡狩。\n翠华悬中天，问俗首耕耨。\n沈沈貔貅垒，濯濯鹰犬薮。\n前行节驼鼓，执御各在手。\n侍臣仰天威，长跪四方奏。\n往闻父老言，罗拜上万寿。\n山桃与黍酒，启齿时一嗅。\n乘云去无踪，过者必稽首。\n登坡望储胥，紫气彻牛斗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22805,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桑乾岭","author":"袁桷","text":"兹山西北来，旋转十二雷。\n昔人望乡处，生别何崔嵬。\n我来坐绝顶，云汉森昭回。\n出日腾金钲，积露流银台。\n长空不受暑，雪花散皑皑。\n毡车引绳过，屈曲肠九回。\n微踪愧三至，南望心低回。\n长风马耳迅，何当赋归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22806,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙门","author":"袁桷","text":"苍厓出双阙，群山俯首尊。\n阴风起晴雷，摩荡昼日昏。\n铁峡拥偪仄，百川为之奔。\n疑下有龙湫，逞怪蹲天门。\n渰兮出肤寸，顷刻黄流浑。\n侧径出石壁，巨浸存遗痕。\n缅昔设天险，事久难穷论。\n征衣袭轻雨，神君俨云根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22807,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓发","author":"袁桷","text":"蓐食慎王事，晓星当前户。\n跨马官道行，细草泣寒露。\n乱石鸣琮琤，啼鸟守荒树。\n行行未十里，问堠坐当路。\n年衰胫力拘，望远弥窘步。\n天风卷飞蓬，白日互吞吐。\n深知非世才，归耕誓先墓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22808,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"合门岭","author":"袁桷","text":"寒沙高冈聚，积溜开土门。\n地媪神功奇，兹焉奉帝尊。\n先皇岁巡幸，属车烂华轩。\n令严植前茅，高下相攀援。\n鱼贯别后殿，蚁行定前屯。\n飞丸落千尺，瞥裂惊危辕。\n履险深自持，人情戒居安。\n寒云蔽出日，去去踰前村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22809,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滦河","author":"袁桷","text":"近山马昂鬉，远山凤腾羽。\n百谷奔乱流，屈曲长蛇赴。\n维时雨新过，急溜糟床注。\n居人汇为井，千屦集沙步。\n寒光澄玉膏，甘冽过牛乳。\n兹泉成白沟，巨浸合沮洳。\n莲芡充糇粮，鱼虾足租赋。\n塞翁话畴昔，陋彼成险固。\n往事不复论，沄沄日东去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22810,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨花曲","author":"袁桷","text":"上都杨柳瘦且坚，叶叶不展圆如钱。\n年年飞花作端午，远客乍见心茫然。\n上都飘雪不知数，此花与雪相旋舞。\n黄鹂声绝孤雁鸣，万骑千车互来去。\n手攀短条心欲绝，宛转成毬恨初结。\n寒风飞蓬卷车轮，点点相亚随明灭。\n南邻荡子衣夜单，晓望出日如黄绵。\n辛勤掇拾不敢弃，愿刮龟毛同作毡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22811,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"装马曲","author":"袁桷","text":"綵丝络头百宝装，猩血入缨火齐光。\n锡铃交驱入风转，东西夹翼双龙冈。\n伏日翠裘不知重，珠帽齐肩颤金凤。\n绛阙葱昽旭日初，逐电回飙斗光动。\n宝刀羽箭鸣玲珑，雁翅却立朝重瞳。\n沈沈棕殿云五色，法曲初奏歌薰风。\n酮官庭前列千斛，万瓮蒲萄凝紫玉。\n驼峰熊掌翠釜珍，碧实冰盘行陆续。\n须臾玉卮黄帕覆，宝训传宣争俯首。\n黑河夜渡辛苦多，画戟雕闳总勋旧。\n龙媒嘶风日将暮，宛转琵琶前起舞。\n鸣鞭静跸宫门闭，长跪齐声呼万岁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22812,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学竹枝宛转词二首 其一","author":"袁桷","text":"闻郎腰瘦寄当归，望尽天边破镜飞。\n昨夜灯花圆似粟，倚门不肯送郎衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22813,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵继学竹枝宛转词二首 其二","author":"袁桷","text":"年年河鼓度天津，郎在滦阳见得真。\n今夕定知郎到日，桂花浮魄满香轮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端午日由车中抵开平客中三度端阳怆然有怀","author":"袁桷","text":"居庸昔日逢端午，子规声声劝归去。\n旧岁滦阳万寿宫，九节菖蒲泛琼醑。\n今年车中饱掀簸，盲风北来雨如注。\n沙坡马鬣高下迎，土屋鱼鳞先后附。\n旧家松篁百寻碧，薝卜花前石榴树。\n停车俯首不得语，邻墙箫声杂驼鼓。\n劳生得意同蜗牛，旧历却行等蝇虎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天鹅曲","author":"袁桷","text":"天鹅颈瘦身重肥，夜宿官荡群成围。\n芦根啑啑水蒲滑，翅足蹩曳难轻飞。\n参差旋地数百尺，宛转培风借双翮。\n翻身入云高帖天，下陋蓬蒿去无迹。\n五坊手擎海东青，侧眼光透瑶台层。\n解绦脱帽穷碧落，以掌疾掴东西倾。\n离披交旋百寻衮，苍鹰助击随势远。\n初如风轮舞长竿，末若银毬下平坂。\n蓬头喘息来献官，天颜一笑催传餐。\n不如家鸡栅中生死守，免使羽林春秋水边走。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客舍书事五首 其一","author":"袁桷","text":"客景真愁绝，凄凉倍旧年。\n草穿沙嘴缩，云住屋头偏。\n灶冷厨烟湿，窗低檐溜悬。\n畏寒难出户，尽日得高眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客舍书事五首 其二","author":"袁桷","text":"愁极吟肩耸，尘深望眼迷。\n屋随冰上下，山趁雪高低。\n乾酪瓶争挈，生盐斗可提。\n日斜看不足，蹋舞共扶携。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]