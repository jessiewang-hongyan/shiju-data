[{"title":"王孝子刲股","author":"吴当","text":"孝子有异行，世情生叹嗟。\n炉香通夜白，股血启晨霞。\n儿体应无恙，亲年幸有涯。\n殷勤鄠人对，直道正奇邪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠沛县阴阳教官","author":"吴当","text":"七政阴阳纪，三辰卜祝科。\n中原井邑小，圣世教官多。\n谯鼓夜传漏，野田春涌波。\n儒冠自拘束，莫听大风歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"节妇挽诗","author":"吴当","text":"抱节青春苦，荥阳有故家。\n教儿能绾绶，报德已宣麻。\n台倚巴清墓，风传鲁妇髽。\n夕阳原上树，依旧宿慈鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题唐子华画","author":"吴当","text":"老树吴江上，茅茨八九椽。\n晚山浓似黛，秋水净无烟。\n盘石堪垂钓，孤舟许醉眠。\n卜居宜近此，何日赋归田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毛李祥归云林因托之访予山居 其一","author":"吴当","text":"客子年方盛，家山花正浓。\n扁舟溯鸿雁，高浪蹴鱼龙。\n京国五千里，云林六七峰。\n升堂举春酒，始得豁心胸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毛李祥归云林因托之访予山居 其二","author":"吴当","text":"莽莽闻征鼓，纷纷踏去船。\n衰颜尚簪绂，雅志自林泉。\n茅屋应无恙，山田幸有年。\n凭君上华盖，为访白云边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李卓归临川","author":"吴当","text":"江上兵虽满，山东路已通。\n发从今日白，花似去年红。\n浮世嗟蓬转，幽栖想桂丛。\n因君万里意，极目送飞鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"徐氏同德堂","author":"吴当","text":"千载南州士，流风气谊存。\n合居今五世，同德又诸昆。\n白日书连屋，清秋稻满村。\n圣朝敦孝礼，桓表已旌门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨曼卿","author":"吴当","text":"京国莺花里，扁舟望旧山。\n烟芜连楚泽，春水隔乡关。\n访古题诗遍，匡时草疏閒。\n丈夫无别泪，此日满愁颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"福泉亭","author":"吴当","text":"筑室庐江上，山泉亦有名。\n深源流福泽，长日作春声。\n润借桑麻秀，寒分井谷清。\n尘缨如可濯，来看白云生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽待制杨贤可 其一","author":"吴当","text":"才逮古循吏，名成初制科。\n百年存气节，五郡起讴歌。\n致政冰衔重，题诗秀句多。\n风流今已矣，洒涕望江沱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽待制杨贤可 其二","author":"吴当","text":"宵旰忧民牧，人才转寂寥。\n如公多令望，绝迹上清朝。\n玉署真成梦，金鱼漫在腰。\n庆源宜有待，嗣子各风标。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送倪长卿","author":"吴当","text":"江汉风尘里，关河日月傍。\n乍疑音问阔，顿觉羽书忙。\n献赋垂归橐，销魂逐去樯。\n朝缨漫羁束，何计濯沧浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宣使蒋槃归寄江西省郎中颜希古 其一","author":"吴当","text":"故国雄藩在，清秋使者归。\n江湖陟险地，舟楫蹈危机。\n士壮常思斗，城高屡受围。\n亦尝修谏草，直欲把天衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宣使蒋槃归寄江西省郎中颜希古 其二","author":"吴当","text":"行李随秋色，萧萧出帝城。\n两行忧国泪，万里望乡情。\n赋敛无修贡，疮痍未息兵。\n大廷俱鼎食，何以报升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宣使蒋槃归寄江西省郎中颜希古 其三","author":"吴当","text":"方镇诸军缺，城池累月攻。\n战场宵燐碧，贼垒晓旗红。\n幕府谋猷密，群公胆气雄。\n妖氛须净扫，崖石始铭功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宣使蒋槃归寄江西省郎中颜希古 其四","author":"吴当","text":"吾庐华盖下，乔木白云边。\n每忆秋风鲙，常怀雪夜船。\n传烽今四野，飞檄已三年。\n亦有平安问，烦君万里传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送徐仁辽阳教官","author":"吴当","text":"辽水东临海，榆关北际燕。\n官程千里外，行色五云边。\n童冠来春服，歌钟杂夏弦。\n莫嗟无籍在，归路近星躔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commi