e":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其一","author":"吴当","text":"旧宅今何在，云山昔更清。\n樵歌秋树谷，渔网夕阳汀。\n门巷来车盖，书声接户庭。\n遗墟悲蔓草，浪迹信浮萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其二","author":"吴当","text":"江雾仍为雨，山花故作容。\n秋风馀鼠雀，寒水落鱼龙。\n慷慨心犹壮，羁栖力巳慵。\n白云华盖表，怅望最高峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其三","author":"吴当","text":"忆昔升堂日，诸生授简时。\n遗经周礼乐，野服汉威仪。\n一自趋丹凤，微班侍玉螭。\n风尘惊岁阔，猿鹤怨归迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其四","author":"吴当","text":"高堂存古制，粹德俨先容。\n道脉千年统，人心百世宗。\n夜台悲化鹤，云气想犹龙。\n松柏宁无恙，青山一万重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其五","author":"吴当","text":"西斋风月好，庭草到阶前。\n春服趋童冠，秋声杂诵弦。\n题诗黄叶上，拄竹白云边。\n俛仰成今古，销魂为黯然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其六","author":"吴当","text":"乔木依深谷，居人尚几家。\n衣冠迷宿草，舟楫失桃花。\n转斗宁无已，劳生已有涯。\n毋烦问松菊，何计事桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其七","author":"吴当","text":"契阔风云会，栖迟道路长。\n老来犹作客，春至好还乡。\n酒醒天连屋，诗成草满塘。\n家声尚清白，世态任炎凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其八","author":"吴当","text":"党里乌巾集，邻翁古意淳。\n瓶罂随野俗，耕稼及清辰。\n世业诸孙在，寒山白屋贫。\n为传宗谱旧，长使旅情亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其九","author":"吴当","text":"幽居临水竹，老桂出林阿。\n荫接青云武，花开碧玉柯。\n百年秋露重，十里夜香多。\n荣悴知何意，炎尘起海波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十","author":"吴当","text":"故园谁识主，曝背已忘君。\n雾雨鸡豚社，寒山鹿豕群。\n池分涧底水，圃斸垄头云。\n茅屋知堪赋，长歌对夕曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十一","author":"吴当","text":"昔人营寺日，野老在朝时。\n栋宇山林净，松杉土壤宜。\n海尘留法雨，檀施寄禅枝。\n接地多先垄，春秋拟合祠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十二","author":"吴当","text":"茅屋云犹在，桃源世已非。\n渔樵能有待，鸿燕尚知归。\n霜露春秋感，风尘造化机。\n松楸千里日，夜夜梦魂飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十三","author":"吴当","text":"世事嗟何及，天伦恨已深。\n乾坤一抔土，霜露百年心。\n去住青山隔，艰危白发侵。\n丈夫无别泪，此际倍沾襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十四","author":"吴当","text":"山黑天仍雪，江寒梅未花。\n昔年宾国日，几醉上林霞。\n勇退寻归棹，甘心理钓槎。\n如何青布袜，未得踏溪沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀旧隐十五首 其十五","author":"吴当","text":"白社千头橘，成都八百桑。\n每思亲棣萼，不为问山庄。\n太史瞻凫影，家人识雁行。\n茅茨容易葺，春水棹相将。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"匡庐","author":"吴当","text":"匡庐望不极，几度涉风涛。\n秀色一道出，振衣千仞高。\n仙岩谁种玉，鬼谷旧栽桃。\n白鹤巢云表，秋宵见羽毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"双剑峰","author":"吴当","text":"双剑倚秋汉，孤城瞻碧岑。\n岳连吴楚阔，光合斗牛深。\n胜地千岩壑，长江一带襟。\n州图增杀气，愁眼倦登临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其一","author":"吴当","text":"圣祖开寰宇，英贤集网罗。\n暂烦周斧钺，即听舜讴歌。\n世阀风云阔，耕岩雨露颇。\n万方俱职贡，一旦尽烟波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其二","author":"吴当","text":"舆图归覆载，天畀万方全。\n帝德元无外，皇纲自失权。\n中原堕土赋，内郡落民编。\n国计东南隘，经邦愧昔贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其三","author":"吴当","text":"太祖收中夏，供储赋土田。\n河仓红粟腐，漕壤紫台烟。\n民物滋殷阜，车书转瘠捐。\n可怜疆理在，运会付茫然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其四","author":"吴当","text":"南国昔归顺，中原仍戍藩。\n岁分貔虎士，阵入鸟云屯。\n名籍沦逋窜，枢兵失讨论。\n诸君甘负国，故里亦空村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其五","author":"吴当","text":"帝患湮洪水，人思凿钜河。\n万方劳畚锸，列郡困徵科。\n处处黄巾社，纷纷赤子戈。\n千年遗恨在，铭石写嵯峨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其六","author":"吴当","text":"泉货资桑币，经纶称物宜。\n低昂三尺法，敛散百年规。\n拙甚黄金注，凄其白鹿皮。\n纷更愆祖宪，废阁失天威。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其七","author":"吴当","text":"夜直麒麟殿，晨司虎豹关。\n周庐诸子贵，枕戟卫郎閒。\n通籍存奴隶，连车载匪颁。\n世勋何补报，戎马泪潸潸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其八","author":"吴当","text":"世爵推勋阀，元戎典禁兵。\n营分龙虎卫，势接凤凰城。\n烽火迷千里，烟尘犯两京。\n临危忘勇决，何以答升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其九","author":"吴当","text":"黄头称国士，碧眼佩天弧。\n突骑今何在，风光古所无。\n旧看装宝剑，可怕执金吾。\n畜锐思防患，凭谁卫两都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十","author":"吴当","text":"命将图推爵，登坛愧匪材。\n舟车空府库，金帛散舆台。\n论赏屯膏泽，争权稔祸胎。\n旧家零落尽，庙算实堪哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十一","author":"吴当","text":"四野悲龙战，群方习豹韬。\n烟尘来滚滚，江汉去滔滔。\n云构千章栋，风帆万斛艘。\n炎波俱鼎沸，何用赋民劳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十二","author":"吴当","text":"福极频移柄，明良久失图。\n匠材违矩度，博局转枭卢。\n宝鼎宗周器，玄圭大禹谟。\n万方俱有间，九贡近来无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十三","author":"吴当","text":"乳羝随敝节，帛雁识累臣。\n渐觉关河壮，应瞻日月新。\n威声通海岱，喜气入梁秦。\n万骑轻天堑，何时一问津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十四","author":"吴当","text":"异乡风景切，人事见推移。\n冠盖非前日，豪华又几时。\n年深鹦鹉草，春老杜鹃枝。\n依旧青山色，寒云满目悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"述感十五首 其十五","author":"吴当","text":"世自馀蛇豕，人犹慕凤麟。\n节旄寒在牧，鈇钺暗生尘。\n有梦能归国，无邻可避秦。\n几年江海上，老泪独沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高卧","author":"吴当","text":"冰霜寒序集，灯火夜堂深。\n高卧尘侵榻，长吟雪满簪。\n空存三寸舌，不负百年心。\n慷慨能忘死，饥寒亦易禁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初度日","author":"吴当","text":"衰疾年添算，劬劳思转伤。\n声华江上雾，勋业鬓边霜。\n诗继唐风作，书从禹穴藏。\n光阴何冉冉，华盖郁苍苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大雪","author":"吴当","text":"萧萧惊朔雪，浩浩怒天风。\n虎穴先朝事，鹅池半夜功。\n中原思将帅，乱世识英雄。\n今古兴亡迹，乾坤阖辟中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"相疑","author":"吴当","text":"向国应无计，归田屡作期。\n江湖身病日，松柏岁寒时。\n老鹤云千里，惊乌月一枝。\n人生各有志，物态莫相疑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪","author":"吴当","text":"积雪凝冬瑞，群情兆岁登。\n洞门沦径隧，宫瓦失觚棱。\n烟火江村猎，寒澌野水罾。\n殊方兼久病，高卧竟何能。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪霁","author":"吴当","text":"江上千峰雪，天边几缕霞。\n冻澌依岸梗，冰柱落檐花。\n野回山光薄，沙明树影斜。\n负暄貂已敝，抱病虱空爬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊月朔","author":"吴当","text":"羁客无颁朔，穷年有此朝。\n山明仍戴雪，水落不通潮。\n黄道环辰极，青阳转斗杓。\n仰关身万里，转壑梦连宵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"世路","author":"吴当","text":"世路难如此，京华事若何。\n风云归草昧，日月傍干戈。\n南土分争久，西秦王气多。\n累臣独洒泪，衰疾卧江沱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同驾","author":"吴当","text":"白日行天速，青山去国遥。\n昔年苍水佩，同驾紫云轺。\n汉节犹堪牧，虞旌不待招。\n人生誇气概，莫遣旅魂销。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊日","author":"吴当","text":"乡心违伏腊，宦迹历关河。\n酥酪分邻粥，弦匏拥醉歌。\n天清云路阔，春近雪花多。\n事业今如此，江边一钓蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题 其一","author":"吴当","text":"牧地连云水，羔羊饱杞椒。\n体充香透骨，尾重雪凝膘。\n珍出天厨馔，炉传禁脔烧。\n先尝时有赐，况复酒频浇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏题 其二","author":"吴当","text":"西域葡萄熟，浆醪不用酤。\n色深滦水菊，香重塞城酥。\n甘露浮银瓮，寒冰贮玉壶。\n相如犹病渴，传赐近来无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闵姜公硕","author":"吴当","text":"窃据窥神器，人心事事非。\n每闻优诏下，无复报音归。\n虎穴宁容饰，龙韬未息机。\n小臣徒溅血，不得沃天衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"馆人","author":"吴当","text":"风雪夜迢迢，探囊失敝貂。\n烛龙沧海阔，帛雁上林遥。\n伏枕调诗律，篝灯注酒瓢。\n馆人情思厚，尚觉旅魂销。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旅馆","author":"吴当","text":"旅馆经时序，羁愁转寂寥。\n山空寒隐雾，风急夜鸣条。\n塞雪应无际，军声自不骄。\n何时衰老泪，拭目圣明朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]