[{"title":"江城杂咏七首 其五","author":"张仲深","text":"方冬气候变，纵目意凄迷。\n千里兼吴越，南州带鼓鼙。\n地连江栈阔，天入海门低。\n归路何愁寂，寒城鸦乱啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8910,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城杂咏七首 其六","author":"张仲深","text":"霜空澹孤月，此夕十分清。\n乌鹊寒无梦，关河夜自明。\n入帘微影落，开户素华倾。\n万里还如许，姮娥不世情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8911,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城杂咏七首 其七","author":"张仲深","text":"霜露下林薄，江干岁事阑。\n起来风力恶，不放酒杯乾。\n南土旌旗满，孤城鼓角寒。\n百年如梦寐，头黑好相看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8912,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其一","author":"张仲深","text":"经年困行役，郁郁若为情。\n异县青山众，新秋白发生。\n诗魔降战垒，酒阵破愁城。\n物色今如此，漂流不为名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8913,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其二","author":"张仲深","text":"百曲浮梁上，沧波午景齐。\n乱山藏四县，一水汇双溪。\n舟逐鸬鹚下，沙迎草树低。\n隔桥秋社散，归客醉如泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8914,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其三","author":"张仲深","text":"佳期天上又，星约喜重寻。\n明月孤城柝，西风独客心。\n故乡千里外，归梦一溪深。\n应想高堂上，新刍亦自斟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8915,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其四","author":"张仲深","text":"久客经春夏，风清尚坐留。\n楼头延月滞，树杪见星流。\n东土登平岁，西畴黍稌秋。\n山妻应解事，曲蘖已吾谋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8916,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其五","author":"张仲深","text":"客倚南楼上，西风月又初。\n紫箫閒度曲，茅屋夜温书。\n风物吾乡似，人情异县疏。\n既无升斗绊，只合赋归欤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8917,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金华杂咏六首 其六","author":"张仲深","text":"浴罢披襟坐，危栏曲曲凉。\n秋风清枕席，客思入江乡。\n乱竹疏萤度，深林众鸟藏。\n晚来閒物色，风土似荆扬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8918,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游承天寺","author":"张仲深","text":"秋色今朝尽，西风落晚红。\n人心本无隔，节序不能同。\n杖策孤村外，斋居乱水中。\n坐看驰骋者，行李自匆匆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8919,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"练川杂诗四首 其一","author":"张仲深","text":"风物皆迁次，因循岁月过。\n清池黄叶满，落日暮云多。\n蛮海横妖祲，官军荷铠戈。\n故乡音信断，无路问如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8920,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"练川杂诗四首 其二","author":"张仲深","text":"百年全盛日，海角见风波。\n潮势秋逾恶，村舂夜有歌。\n时丰多黍稌，日暮饫驾鹅。\n幸遇登平岁，搴旗听倒戈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8921,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"练川杂诗四首 其三","author":"张仲深","text":"浮世如谈梦，人情似聚沙。\n一年江海上，千里问音赊。\n驿路通西市，江声入下砂。\n客怀无可遣，时复嗅黄花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8922,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"练川杂诗四首 其四","author":"张仲深","text":"江深风物异，归计每逡巡。\n有酒愁难破，吟诗兴自神。\n枯萑晴似雪，独鹤夜如人。\n遁世当无闷，行藏一任真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8923,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬姜朝宗见寄韵三首 其一","author":"张仲深","text":"山色迎人近，西风逐客来。\n隔林松子落，遍地菊花开。\n补衮惭无策，论诗属有才。\n江南多蟹稻，相遇且衔杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8924,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬姜朝宗见寄韵三首 其二","author":"张仲深","text":"霜枫围别院，烟草乱苍綦。\n久客怀三益，论心儗四知。\n浮生波上梗，世事橘中棋。\n坐叹知音少，凭谁觅子期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8925,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬姜朝宗见寄韵三首 其三","author":"张仲深","text":"未赴龙门险，安知蜀道难。\n勋名怀魏阙，身世属槐安。\n乌帽西风侧，渔村夕照寒。\n黄尘三万丈，无计一弹冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8926,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵酬余伯庸三首 其一","author":"张仲深","text":"西风吹练水，凉意袭絺袍。\n拟草张衡赋，愁闻楚客骚。\n旅怀秋更恶，归舸月中操。\n应叹浮生者，巢由亦自高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8927,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵酬余伯庸三首 其二","author":"张仲深","text":"乌纱笼短发，浑欲不胜簪。\n落景增诗思，秋风识客心。\n潮平江浩浩，月上夜深深。\n不道人无寐，新蛩四壁吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8928,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵酬余伯庸三首 其三","author":"张仲深","text":"短褐勾吴客，风流忆晋贤。\n斯文今尚在，故墨有谁传。\n野寺门如市，田家屋似船。\n飞萤偏有意，时照笔床前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8929,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬江叔载见寄韵三首 其一","author":"张仲深","text":"射虎南山侧，风吹短短衣。\n故人浃旬别，今日五云飞。\n春动梅争放，霜晴鱼正肥。\n悬知贤伯仲，醉卧月中扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8930,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬江叔载见寄韵三首 其二","author":"张仲深","text":"异县无家客，惟愁卒岁衣。\n年馀三日在，春入一鸢飞。\n溪水深如浅，梅花瘦不肥。\n扁舟时有兴，莫掩雪中扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8931,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬江叔载见寄韵三首 其三","author":"张仲深","text":"元日雪如泥，山林玉作衣。\n柳梢春尚浅，香絮晓先飞。\n顾我邻无蹇，知君厩有肥。\n而还许借我，一策到山扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8932,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄楼仲几","author":"张仲深","text":"一日一相见，百年如此不。\n已知诗有趣，未放酒忘愁。\n鸟下西邻树，月明今夜楼。\n相看须白首，投老共林丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8933,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访鄮山周致尧时杨彦常乌性善蒋伯威陈子参军联句因次其韵","author":"张仲深","text":"红树风霜重，玄冬气候深。\n幽人喜还往，好客足期襟。\n酒阵围诗垒，词锋逼羽林。\n江湖千古意，今日友朋心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8934,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游越","author":"张仲深","text":"抚迹悲生事，因循作远游。\n半生山水愿，满眼古今愁。\n木叶经霜减，山云遇雨稠。\n晚来清兴动，步屧到林幽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8935,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茜泾庄上人以诗招饮用韵答之 其一","author":"张仲深","text":"别院围琪树，风声起绎骚。\n暝云连古寺，老客拥新貂。\n零雨妨归计，幽人屡见招。\n西山如有约，何必上凌霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8936,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茜泾庄上人以诗招饮用韵答之 其二","author":"张仲深","text":"清江三日客，风色晚骚骚。\n古寺催尝酒，诗人免解貂。\n永怀方外友，时见雨中招。\n彷佛蓬壶路，何须问紫霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8937,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早秋","author":"张仲深","text":"六月商飙动，光阴逝莫留。\n小窗梧叶雨，危枕竹床秋。\n远浦凉云薄，孤村野水流。\n去年为客日，今夜在南州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8938,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓起","author":"张仲深","text":"晓起坐南牖，寻诗可散愁。\n江城三日雨，天地一分秋。\n断坼蘋花乱，空江雁影浮。\n西风清兴远，倚遍夕阳楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8939,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"严子迪南宅宴","author":"张仲深","text":"浦上南阳宅，人奇似小坡。\n论交虽未久，厚谊许相过。\n江暖眠鸂?，霜威振薜萝。\n斋居具薰茗，无梦到南柯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8940,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梁湖","author":"张仲深","text":"孤舟催晓发，急水暗前滩。\n行子羁离日，玄冬树木乾。\n霜清天宇阔，山尽海门寒。\n回首通明路，梅花属我看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8941,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即景","author":"张仲深","text":"三山何所见，众木集珍禽。\n流水自朝暮，青山无古今。\n饥鸢立樯杪，孤客发春深。\n江海多诗思，愁人懒独吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8942,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"破寺","author":"张仲深","text":"破寺依山杪，平湖绕四围。\n霜风吹客鬓，水气湿人衣。\n渔舸鸣榔急，吟篷载酒归。\n晚来閒物色，坐览岁华非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8943,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行旅","author":"张仲深","text":"行旅惊秋莫，征衣点越霜。\n绝荤神气爽，得句客情忘。\n废沼枯荷满，空庭碧柚香。\n起来羞把镜，维恐鬓毛苍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8944,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天际","author":"张仲深","text":"天际残阳薄，南濠水气宽。\n生涯牢落久，江汉别离难。\n明月渔歌起，孤舟客子寒。\n梅花随地发，聊以破愁端。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8945,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北风","author":"张仲深","text":"北风振枯木，残叶苦禁持。\n起览穷冬物，因怀生事悲。\n疏烟澹西舍，寒雨响枯池。\n陈酒床头有，题吟饮一卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8946,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁尽","author":"张仲深","text":"无家千里客，此日若为情。\n异县多风雪，残年见甲兵。\n梅花因我笑，山月为谁明。\n照我乡关梦，相随到鄮城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8947,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀兄子益","author":"张仲深","text":"莽莽草根白，昏昏林表烟。\n半村犹作客，横浦有归船。\n晚岁霜如雪，离家日似年。\n何如聚兄弟，团坐夜深眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8948,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归梦","author":"张仲深","text":"归梦逐飞鸟，修程柰尔何。\n澄江饶浦溆，落日乱驾鹅。\n近市浮图小，还家客艇多。\n裁诗且消遣，随意发高歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8949,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归途","author":"张仲深","text":"归途才五日，晓起每心惊。\n溪响知滩急，霜严信日晴。\n漂流几半载，踪迹愧吾生。\n先到西湖上，时还访旧盟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8950,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行舟","author":"张仲深","text":"舟行常可计，风色苦相违。\n落日酒杯阔，清江芦笋肥。\n壮怀兹浩荡，毕景自稀微。\n眼底非无见，遥空一鸟飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8951,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日 其一","author":"张仲深","text":"忆昔殊方客，故乡千里情。\n何如杜员外，瞻眺梓州城。\n老圃黄花在，西风白发生。\n床头有新酒，涓滴尽馀倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8952,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日 其二","author":"张仲深","text":"海角孤城晚，惊心岁月驰。\n小园枫落日，老圃菊花时。\n爱酒陶彭泽，能诗杜拾遗。\n百年须强饮，头白莫深悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8953,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒山寺","author":"张仲深","text":"姑苏九月荒城路，一水回环客艇多。\n万里西风吹落日，五更渔火乱沧波。\n江村夜迥传钟鼓，池馆秋深老芰荷。\n欲问兴亡吴越事，道人为我发长歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8954,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"曹娥庙（用石上诗韵）","author":"张仲深","text":"淑女贞诚贯九霄，身随父榇入寒潮。\n一江大浪名长在，三尺孤坟骨未销。\n严祀有仪崇令典，素麻宣诰属熙朝。\n当年莽操皆臣子，惭愧贤娥史并标。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8955,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次乌继善城南三首 其一","author":"张仲深","text":"中原克复近来闻，鼓角连天起夕曛。\n杜老有诗如国史，贾生无策奉明君。\n樱桃入夏千株雨，牟麦先秋万顷云。\n独有村南垂白老，晓呼妇子饷初耘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8956,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次乌继善城南三首 其二","author":"张仲深","text":"故朝城郭尽空基，今日增修又一时。\n于越谁人追范蠡，句吴有客似湘累。\n杏林煮酒心先醉，草阁看山手自支。\n无限閒情动吟思，绿杨为我一颦眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8957,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次乌继善城南三首 其三","author":"张仲深","text":"柳丝槐幄荫澄波，十里横塘翠飒娑。\n荏苒风光春事晚，清和天气雨声多。\n园庐近远连桑柘，陇坂高低杂黍禾。\n靴帽入城尘土暗，故山回首隔烟萝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8958,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铁釜中莲（暇日宴金华祥符方丈了堂悟公以铁釜置莲方著一花关西杨伯玉徵予赋诗以呈湛庵信公时与者孟志学萧君祐暨仲深也）","author":"张仲深","text":"翠拥柔葩濯素商，谁分玉井一茎芳。\n根通金气秋逾盛，雨裛铅华晚更香。\n埏埴有功潜土脉，凌波无步到陂塘。\n自知鼐鼎钧陶力，不受金茎沆瀣凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8959,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨廉夫月波楼","author":"张仲深","text":"饮马桥头听鸣珂，饮马桥下雪始波。\n自从道人琴佩至，想得衡门车马多。\n楼外青山横独鹤，枕边柔橹响双鹅。\n我来疑是扬雄宅，夜烛藜光讽九歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8960,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉寄易之在京师","author":"张仲深","text":"忆君日日共吟哦，三载怀人可奈何。\n声价相随诗价长，新交应似旧交多。\n春连宫树莺花合，人在瀛洲岁月过。\n十里有书如讯问，布衣仍旧住城阿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8961,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀严侯在庐州 其一","author":"张仲深","text":"九十春光强半阴，蛮风日日振平林。\n海天花柳愁无际，江郭旌旗驻转深。\n驿骑通宵催调发，故人终岁绝声音。\n吾生赖有园庐在，吟尽黄昏思不禁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8962,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀严侯在庐州 其二","author":"张仲深","text":"去岁风狂薄海涯，今朝霪雨转如麻。\n自缘地僻多啼鸟，不管春深又落花。\n千里荒城宵警柝，一年征戍日思家。\n丘山想有栖迟者，独立衡门数瞑鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日与吴君同舟过越","author":"张仲深","text":"延陵有客上蓬莱，九日相逢畅好怀。\n赖有舟中尊酒在，不知篱下菊花开。\n利名异业同奔走，山水无情任往回。\n解得渊明千古意，不谋升斗盍归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"建德曹德明存中斋","author":"张仲深","text":"梅花千树雪纷纷，想得衡门闭夕曛。\n地脉阳和今夜复，天根造化一中分。\n空青暗结昆冈髓，神汞连光华岳云。\n养得丹成思蜕骨，笑骑黄鹤驭氤氲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次勾曲外史西湖感怀韵","author":"张仲深","text":"一鞭春入晓萧萧，长记寻诗过段桥。\n花底莺声閒送客，马头山影欲凌霄。\n情怀忽尔思前载，风物多应似故朝。\n蹋尽春光生感慨，当年王气逐虹销。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送周养心检讨","author":"张仲深","text":"江南六月蚕重熟，此日扬舲兴倍赊。\n满面炎尘低客帽，一川离思属荷花。\n功名衮衮人千里，世路悠悠日自斜。\n儗驾轻车寻旧约，曳裾多在五侯家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题危太朴检讨借船图次叶敬常编修韵","author":"张仲深","text":"独怀十载竹书光，今日追游越水乡。\n棹发钱湖情浩浩，梦回梵宇月凉凉。\n莼丝入豉春流滑，菰米舂云晚饭香。\n内翰新诗费题品，定应风物引杯长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬单孟年韵","author":"张仲深","text":"买得江鱼贯柳条，欲谭兴废访渔樵。\n西斋有酒寻常醉，东閤需贤次第招。\n春尽广湖孤客老，月明小皎素娥娇。\n桃源有路家应近，不比天台隔石桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬郑千里见柬韵","author":"张仲深","text":"碧梧秋入未全飞，尚有馀阴护客扉。\n半顷风漪天澹澹，一竿晴旭晓晖晖。\n弱躯秪为吟诗瘦，强项多应食肉肥。\n海角书生心自赤，伏蒲无计到官闱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酬族兄润父韵","author":"张仲深","text":"长记西湖日日晴，画船齐载管弦声。\n青青草色裙腰绿，白白梅花粉额明。\n舞倦玉纤歌扇重，醉挥银笔帕罗轻。\n今年海上多岑寂，相对篱根郭索行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雁","author":"张仲深","text":"翅老西风绝点瑕，秋江难认宿芦花。\n雪边字缺银钩断，月下筝閒玉柱斜。\n影乱飞鸥回远浦，阵横宿鹭落平沙。\n声声唤起苏卿恨，为带吴霜染鬓华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"慈湖感怀 其一","author":"张仲深","text":"十年不蹋慈湖路，湖水湖山总旧游。\n老树尚能知客意，白鸥元不识人愁。\n漫需菽粟谋盘斝，尽使锄犁化戟矛。\n筑得长城为屏蔽，也应飞遁住沧州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"慈湖感怀 其二","author":"张仲深","text":"慈湖三月风物好，客子行吟遣日长。\n断浦草根科斗黑，隔篱櫩下来禽香。\n家童解事故携酒，野鸟辟人低度墙。\n今夜山中有风雨，何妨下榻赞公房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠方矩之","author":"张仲深","text":"化城尽属利名场，门外三车日日忙。\n自畏简书为府史，故知文字重经王。\n天华晓雨苍云湿，贝叶翻风白昼香。\n江海红尘一千丈，静边心地自清凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠胡一泉","author":"张仲深","text":"见说君家住翠瀛，蓬莱只在眼中青。\n门前弱水三千顷，屋后长松九百龄。\n别墅溪桥宜客渡，断崖石濑可人听。\n一丘一壑平生愿，老我茅堂煮茯苓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠吕季亨","author":"张仲深","text":"华掖云开接绛霄，簿书参赞见英髦。\n姓名曾隐磻溪钓，笥笈今传左相刀。\n昭代衣冠称古昔，太平礼乐属贤劳。\n愿将真孝旌天下，解使遐蕃俗尽陶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]