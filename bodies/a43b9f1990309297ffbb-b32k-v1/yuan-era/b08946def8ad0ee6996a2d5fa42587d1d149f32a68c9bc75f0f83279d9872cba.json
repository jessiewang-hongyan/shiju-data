[{"title":"元统元年冬十一月句曲外史菌山巢居成制十小诗以自见录呈华阳隐居资一捧腹 其六","author":"张雨","text":"但倚茅君为座主，从称外史作官衔。\n道家六经发愿写，深向石头藏一函。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统元年冬十一月句曲外史菌山巢居成制十小诗以自见录呈华阳隐居资一捧腹 其七","author":"张雨","text":"屋壁置书碑版多，雄虹光怪凤凰阿。\n看到空山十日雪，灶突无烟奈尔何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统元年冬十一月句曲外史菌山巢居成制十小诗以自见录呈华阳隐居资一捧腹 其八","author":"张雨","text":"肯借山中步障锦，与作天下庇寒裘。\n三尺窗棂万株木，不怕霜寒到上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统元年冬十一月句曲外史菌山巢居成制十小诗以自见录呈华阳隐居资一捧腹 其九","author":"张雨","text":"只有天公终可倚，我作巢居名倚天。\n未必高虚无事业，负日读书兼打眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统元年冬十一月句曲外史菌山巢居成制十小诗以自见录呈华阳隐居资一捧腹 其十","author":"张雨","text":"龙虎山中薛玄子，璚林筑台诗亦工。\n应接菌山聊尔耳，非关千里事同风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨时可苏在廷","author":"元老","text":"文章华翰九天开，二妙同时在一台。\n高会竞看文阵合，后堂新许客星来。\n评诗故自当归逊，在寝何容敢望回。\n已请杏花留一笑，不劳羯鼓横相催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张仲宗","author":"元干","text":"高贤往往突不墨，造化从来一小儿。\n执戟逐贫曾有赋，柴桑乞食岂无诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张仲宗","author":"元干","text":"二顷无田空好岁，四郊多垒已仍年。\n遥知壁立书生舍，只有溪藤与麝烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张仲宗","author":"元干","text":"飘蓬闻说旅涂穷，我有枯鱼困辙中。\n裹饭独期来见客，一杯当卜与君同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张仲宗","author":"元干","text":"冠玉何因常瓮牖，身名未泰少安之。\n雀罗忽枉黄金弹，惊怖还应震失匙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵张仲宗","author":"元干","text":"中台宏议裨初政，学省雄文畏后生。\n不悟宦游成左计，只今无米糁藜羹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王司业","author":"元龟","text":"中兴天子初龙翔，临轩策士当维扬。\n艰难果见异人出，龙虎甲乙俱非常。\n先生大对过晁董，指切时务言激昂。\n麟经绝笔二千载，收拾纸上生光芒。\n自从曲江到今日，劲气独得南方强。\n权门用事手可炙，申枨亦减平生刚。\n先生闭门玩爻象，簸弄日月潮之阳。\n帝忧南国命共理，袁连二政俱循良。\n公道方行正人用，诏起韩愈师虞庠。\n先生不作进学解，直言慷慨投封章。\n一麾出守山水郡，十行诏墨加恩光。\n东嘉得贤类京兆，前政有张今有王。\n张公到官席未煖，犹有遗爱如甘棠。\n先生况是儒宗师，敛此大惠施一方。\n入境愿问民疾苦，下车宜诛吏奸赃。\n首延璆孺坐贤榻，无使杨墨登门墙。\n河内借恂岂容久，宸衷念贾殊未忘。\n鲰生抠衣恨太晚，执经未获时登堂。\n私心窃喜父母国，圣恩特许来龚黄。\n愿同何坚首率化，归见颍川鸣凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹亭纳凉","author":"张玉娘","text":"独坐幽篁阴，停绣更鸣琴。\n叶齐林影密，惟有清风心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其一 桃花扇","author":"张玉娘","text":"浓花妆点一枝春，影拂潇湘月半轮。\n歌彻霓裳风力软，钗横鬓乱晓寒新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香闺十咏 其九 青鸾镜","author":"张玉娘","text":"云奁初展晓光寒，幽思重重独舞鸾。\n自是伤秋怜瘦影，不惭綵笔写春山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 谢东山","author":"张玉娘","text":"风捲胡沙动地尘，蔷薇深洞蔼馀春。\n棋终偶折登山屐，方信风流社稷臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏史 茜桃","author":"张玉娘","text":"爱赏佳人白雪辞，云绫一束费春机。\n翻然席上呈诗句，羞杀歌喉与舞衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春偶成","author":"张玉娘","text":"草香云暖雨初晴，对竹敲诗坐小亭。\n昼永人閒啼鸟静，花飞无语春冥冥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题二首 其二","author":"张玉娘","text":"闷来弹鹊漫停梭，竹岛花潭思转多。\n秋老莫言春度尽，若邪犹自惜凉荷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"明皇并辔图","author":"宋无","text":"三郎沉醉玉环随，不上金舆索马骑。\n老大独归南内里，风流无复并鞍时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长信秋","author":"宋无","text":"长信秋来月自圆，夜香犹拜玉阶前。\n妾今不愿君王宠，惟愿君王寿万年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江山万里图","author":"宋无","text":"只尺寒流千万峰，湍声寂寂暮猿空。\n买船欲泛春潮雨，楚树吴云是画中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江干暮泊","author":"宋无","text":"野色随墟落，江皋烟景饶。\n远村明晚烧，高岸没春潮。\n览镜芳年去，援毫藻思销。\n琴书苦行役，不敢问渔樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大禹祠","author":"宋无","text":"力平水土势回天，功业三千五百年。\n四海九州皆禹迹，独留陵寝越山边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骡纲图","author":"宋无","text":"剑阁清尘犯属车，纲骡驮得荔支无。\n却嫌画史才情少，不作承平舞马图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"厦门杨石松","author":"元华","text":"家风无敌北而南，列戟门资六艺谙。\n元、白名高皆压倒，程、朱道广已同参。\n鸣琴和卜羊城治，作画奇从鹭屿探。\n结契愿如韩与孟，联吟何日共诗龛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"厦门杨石松","author":"元华","text":"当年卢、骆本齐名，华萼楼高播远声。\n才得十全真旷代，交无一见信多情。\n推袁雅谊殷勤甚，御李微忱企慕诚。\n行见炎州歌五裤，鳣堂世泽定公卿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳梢青·题陶陶簃","author":"元镛","text":"何处寻诗。\n柳边林下，万柳萋迷。\n举目河山，平头岁月，猿鹤催归。\n萧然箬笠蓑衣。\n定未减、长芦钓师。\n水绕孤村，月残断岸，小立多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"唐多令","author":"元日","text":"四始转芳洲。\n三微启孟陬。\n献椒花、颂出妆楼。\n聚饮屠苏谁最少，添一岁、更风流。\n阊阖在螭头。\n衣冠拜冕旒。\n赐醁醽、白兽樽浮。\n朝罢金莲花炬散，曾记入、火城游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"霜天晓角","author":"元夕","text":"新正月半。\n皓影连云汉。\n偏闹六街灯火，好月无人看。\n喧阗箫鼓乱。\n旦旦如何旦。\n归坐小山梅下，香茗几人清玩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31724,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"商左山","text":"药裹封灾随腊去，酒杯称寿逐年新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31725,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠李之和","author":"李冶","text":"玄牝机关不死根，自消自息自氤氲。\n暖于燄燄九微火，轻似飘飘三素云。\n白玉池心流晓润，紫金炉口袅馀熏。\n未知与道相应否？\n试作新诗一问君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31726,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"帛书诗","author":"郝经","text":"霜落风高恣所如，归期回首是春初。\n上林天子援弓缴，穷海累臣有帛书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31727,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辞召命作","author":"许衡","text":"一天雷雨诚堪畏，千载风云漫企思。\n留取閒身卧田舍，静看蝴蝶挂蛛丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31728,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊李肯斋","author":"崔斌","text":"一夕司空抚御床，祖龙未死国先亡。\n只缘西楚无坚壁，致使南州总战场。\n湘水一川骸骨满，肯斋千古姓名香。\n我来不见先生面，犹对西风酹一觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31729,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金山","author":"崔斌","text":"浩浩长江天际来，中流砥柱独崔巍。\n风摇万壑秋声动，潮捲千堆雪浪回。\n山势参差现灵鹫，海波辽阔隔蓬莱。\n夕阳不尽登临意，倒泻沧溟入酒杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31730,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独石","author":"高鸣","text":"一块苍顽石，颓然半水滨。\n可怜阎立本，徒写五湖真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31731,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杜莘老华山图","author":"高鸣","text":"上方可望不可到，今日兴来时卧游。\n须信丹青有神化，世间随处是同州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31732,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雁荡能仁寺遗诗","author":"石国英","text":"我行天下山水半，侧身西望长嗟叹。\n山到蜀川方绝奇，世殊久被微官绊。\n万里提兵雁荡来，高牙一展岚雾开。\n松风吹骑联镳入，高日下照翻经台。\n老僧振锡去何所？\n香篝寂寂佛无语。\n山鸣谷应应者谁？\n似有秦民宅幽阻。\n姑休尔旅枕尔鋋，云深不得惊龙眠。\n水晶一派泻琤玉，岁与清气中洄沿。\n二三溪碓长林下，人力罢舂天所借。\n草香花净太古春，虎啸猿吟明月夜。\n幽寻静胜登嵯峨，鸾旗柱笔光影摩。\n诗成写破峭壁翠，稽首岩前诺巨那。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31733,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉堂即事二首 其一","author":"王恽","text":"阴阴槐幄幕閒庭，静似蓝田县事厅。\n细草近缘春雨过，映阶侵户一时青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31734,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉堂即事二首 其二","author":"王恽","text":"日长上直玉堂庐，思入閒云待卷舒。\n重为明时难再遇，等闲羞老蠹鱼书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31735,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"口号","author":"王恽","text":"隔夜端门分板位，平明簪笏列鸳行。\n紫云低覆千官入，润作金炉百和香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31736,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"检荒租二首 其一","author":"张之翰","text":"头田乱插白红牌，翁媪相看不敢猜。\n十八年愁今日散，爱民使者检荒来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31737,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"检荒租二首 其二","author":"张之翰","text":"三载徒劳三载过，旁人休笑拙催科。\n浙西尽有荒闲地，不似松江分外多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31738,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"镜中灯","author":"张之翰","text":"孤影徘徊入照临，西风不动竟沈沈。\n一池铅水镕真火，半夜金星犯太阴。\n鸡翅舞时红焰歇，蛾头扑处碧光深。\n纵渠百鍊千烧后，依旧刚明一片心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31739,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼鲜于伯几鹤二首 其一","author":"梁曾","text":"翠柏屏前竹阑曲，几见毰毸雪衣舞。\n平生风云万里心，零落湖山一丘土。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31740,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼鲜于伯几鹤二首 其二","author":"梁曾","text":"世间万事不可虞，奇祸何由也到渠？\n不见嵇康遭杀戮，令人空叹养生书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31741,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题莱州海神庙","author":"徐琬","text":"龙宫高拱六鳌头，六合乾坤日夜浮。\n贝殿走珠蛟构室，戟门烘雾蜃喷楼。\n中原右顾真孤岛，外域东渐更九州。\n咫尺琛航倭濊近，好将风浪戒阳侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31742,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"徐琬","text":"一窍鬼工开混沌，八蚕神茧堕扶桑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31743,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题围肚诗","author":"姚燧","text":"八十年来遇此春，此春遇后更无春。\n纵然不得扶持力，也作坟前拜扫人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31744,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠相师","author":"姚燧","text":"渊澄如止水，泉活有馀波。\n梅到清香处，君应风味多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31745,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅枝拄杖","author":"阎复","text":"斫取江南万玉柯，春风入手惯摩挲。\n较清邛竹能香否，斗品鸠藤奈俗何。\n声破梦寒霜满户，影随诗瘦月横坡。\n人言功在调羹上，不道扶持力更多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31746,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"阎复","text":"群材方用楚，一士独辞燕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31747,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过梅岭冈留题","author":"伯颜（子中","text":"马首经从庾岭回，王师到处悉平夷。\n担头不带江南物，只插梅花一两枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31748,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿阳梅图","author":"王思廉","text":"一声白雁渡江潮，便觉金陵王气销。\n画史不知亡国恨，犹将铅粉记前朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31749,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归妇吟","author":"王宥","text":"烈火都将玉石焚，死生契阔忆中分。\n信音一绝思青鸟，望眼双穿见白云。\n残日鹡鸰还有难，北风鸿雁正离群。\n新诗送尔还家去，重续当年织锦纹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31750,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乐府","author":"信世昌","text":"东风吹落花，纷纷辞故枝。\n莫怨东风恶，花有再开时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31751,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"信世昌","text":"宗庙有灵贤相出，黔黎无患太皇明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31752,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海青马生肝","author":"陈伯通","text":"金符飞下渥洼龙，鞭影轻抟六翮风。\n耳窍风声闻斗蚁，眼花云影疾惊鸿。\n未容骏骨辽东老，已得英名冀北空。\n一缕红尘江汉捷，天庭不为荔支红。\n催荐厨中语未阑，控拳豪客簇雕盘。\n翠翻云叶并刀乱，冰透霜花楚玉寒。\n一吮味甘牙齿滑，十分香彻鼻头酸。\n梦魂不到鲈鱼鲙，醉眼江湖特地宽。\n惊呼乳盎意匆匆，便觉馀香鼻观通。\n露滴冰盘蓝玉软，风生霜刃碧囊空。\n舞娃惊溅罗衣绿，酒客潜消醉脸红。\n若使昔人知此意，羊头烂熟不成功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31753,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陈伯通","text":"肢伤一体娄师德，目眇三分李雁门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31754,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"剪子","author":"耶律柳溪","text":"体出并州性自刚，箧中依约冷光芒。\n双环对曲蜂腰细，叠刃齐开燕尾张。\n惯爱分花沾雨露，偏憎裁锦破鸳鸯。\n可怜戍妇寒窗下，一剪边衣一断肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31755,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"耶律柳溪","text":"角端呈瑞移御营，扼亢问罪西域平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31756,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洛阳怀古分韵得发字","author":"员炎","text":"东洛打空城，北邙连废阙。\n怀古动悲吟，远客生华发。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31757,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"隆德宫","author":"员炎","text":"林花细妥胭脂色，水荇轻淤翡翠泥。\n歌舞留连嫌昼短，楼台缥缈觉天低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31758,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宴集东平湖亭","author":"员炎","text":"北海尊前人似玉，东原城下水如天。\n满眼荷花三百顷，采莲人语隔秋烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31759,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高唐道中","author":"员炎","text":"影孤海内干戈满，愁入天涯草树低。\n桑柘影空蚕已老，陂塘涸尽燕无泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31760,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扇尾羊","author":"员炎","text":"冯翊春草香芊绵，柔毛食饱饮苦泉。\n卧沙稀肋琼箸细，带霜小耳春茧圆。\n扇尾一方移种类，风头万里摇腥膻。\n吾生本无食肉相，不烦浼手愁烹煎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31761,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马酮","author":"员炎","text":"漫说千杯不醉人，清光压倒洞庭春。\n携行可用紫丝络，渴饮不烦乌角巾。\n摇动革囊成酝酿，封藏花盎作逡巡。\n坐中一混华夷俗，或有豪吞似伯伦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31762,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"员炎","text":"宿雨乍收云叶断，犹疑电影掣湖心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31763,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"撖降","text":"谁家金鸭暖梅魂，绣户春风半掩门。\n桃叶等閒留暮雨，梨花寂寞过黄昏。\n盘盘鸾髻堆云影，澹澹蛾眉扫月痕。\n常似谢家银烛底，凤凰钗影落瑶尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31764,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"记梦","author":"撖降","text":"千里崤函楚客行，关河西上铁牛城。\n申湖亭下月初上，召伯堂前草自生。\n十里杏园红雨暗，一条春水碧罗平。\n觉来半壁寒灯底，吹落风檐暮雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31765,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过沙井","author":"撖降","text":"沙沈石马废城秋，剑钺寒生古戍楼。\n平日只疑无蜀道，此行何处问荆州？\n山连海塞从西断，水界龙荒尽北流。\n一曲商歌才夜半，朔风吹雪望牛头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31766,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]