[{"title":"五月廿日雨怀有寄","author":"吕诚","text":"竹洲草树暗渔庄，五月雨多沙水黄。\n薝卜林深书屋小，芭蕉叶大酒樽凉。\n乍瞻霁色收屏翳，犹讶车声走阿香。\n冉冉途征尘没马，怀人幽兴讵能忘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓言二首 其一","author":"吕诚","text":"苦瓠若悬瘿，宜瓢亦宜笙。\n笙将用合雅，瓢以供酌烹。\n吾为苦瓢谋，任力不任声。\n荐劳铏鼎间，自足资养生。\n物贱终反贵，吹万岂其情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓言二首 其二","author":"吕诚","text":"少学老无成，所守但糟粕。\n譬如福与市，涉海求灵药。\n岂不望三山，风至辄引却。\n岁阑坐穷陋，青灯映疏箔。\n虽微白足禅，自置丹霞缚。\n贱贫吾所安，饮水差足乐。\n邻家日椎牛，不似西邻礿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日雨后二首 其一","author":"吕诚","text":"浦口寒潮频有信，空中鸟迹了无痕。\n野航落日东西渡，黄叶秋风远近村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日雨后二首 其二","author":"吕诚","text":"曲埼茅屋两三家，返照垂虹隔断霞。\n风外叶声来似雨，莫嗔杨柳不藏鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜","author":"吕诚","text":"砌草虫吟四壁静，檐竹摇灯动秋影。\n老来无梦到阳台，开门月在青松顶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杜少陵行春图","author":"吕诚","text":"牢落出同谷，凄凉赋七歌。\n日斜驴背上，白发似诗多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄江南绍隆伯瑩","author":"吕诚","text":"一冬风雪出村稀，忽见梅花映酒旗。\n行过江桥屡回首，无人寄与绍隆师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"正月廿三日借竹洲访顾藏六于司马庙","author":"吕诚","text":"一番行春始出村，韶华无赖已平分。\n野鸟乱啼司马庙，石麟犹卧汲家坟。\n烧痕新绿浑禁雨，柳色半黄都染云。\n荡泾桥头有酒卖，醉把梨花日又曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客至","author":"吕诚","text":"幽窗谈笑话平生，旧砚磨穿笔代耕。\n白发满头难讳老，青山排闼故多情。\n桃花灼灼浑无语，春雨潇潇尚未晴。\n明日兰舟休便发，南邻笋蕨巳堪烹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日前雨中","author":"吕诚","text":"已知无地可登临，况是孤村风雨深。\n酒为解忧惟有醉，菊怜短发不胜簪。\n白鱼出网一双玉，黄橙捣齑三寸金。\n南北暌离佳节过，壮游空感昔年心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋浦归舟图二首 其一","author":"吕诚","text":"埼岸枫林隔野桥，梵王宫殿在山腰。\n扁舟好趁樵风去，莫待寒江落晚潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋浦归舟图二首 其二","author":"吕诚","text":"秋浦行舟日欲晡，秋来到处有莼鲈。\n酒家鲙具如堪借，暂卸西风十幅蒲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄怀乡友浩然戍横州","author":"吕诚","text":"分袂每怜秋未半，开帆犹记月初圆。\n客程千里又千里，老鬓一年衰一年。\n令弟喜沾新雨露，故乡不改旧山川。\n悬知献捷归来日，重理琵琶第四弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄乡友福州别驾二首 其一","author":"吕诚","text":"乌石山前听讼时，石榴洞口看云飞。\n马蹄好踏官街月，人在青榕影里归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄乡友福州别驾二首 其二","author":"吕诚","text":"酿来南酒甜于蜜，爱浴山泉热胜汤。\n退食自公微醉后，小姬和叶进槟榔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和烹箨龙诗韵","author":"吕诚","text":"雷公传令风火急，鞭起雨工头戢戢。\n泥蟠骨蜕未能飞，野人争奋长劖入。\n狞须逆鳞不复畏，斯须唯闻釜中泣。\n金杯苦酒五色光，玉版云腴乳花湿。\n长房见之发长叹，曲生一笑恣鲸吸。\n灵物变化不可常，骈玉森森作人立。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月廿四日雨中寄仲庄","author":"吕诚","text":"四月江乡暑尚微，林寒老客未更衣。\n复愁刈麦雨不止，况是索租人正饥。\n谷秧出水青青短，筀笋登盘个个肥。\n门外泥深无辙迹，相从莫怪出村稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答偶武孟","author":"吕诚","text":"犹忆当年应鹄头，诗名从此达南洲。\n狂歌赖有千钟酒，豪士今无百尺楼。\n紫蟹白鱼江市晚，绿芜红树海门秋。\n西风开到篱根菊，拟向桃源一系舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"白纸扇歌","author":"吕诚","text":"我昔舟泊江西湄，推冰看捣万楮皮。\n江神相过色惨怆，波工自诧手不龟。\n怀金问价云满箧，霜纨失素无晶辉。\n廿年归来存百一，制成团扇真绝奇。\n红炉百炼太古雪，紫筼三尺盘屈铁。\n银潢影射秋鉴光，玉虹冷贯青天月。\n昏目摩挲惊老丑，动摇清风生腋肘。\n高堂昼把蝇蚋空，魑魅潜藏飞电走。\n岂不闻蕺姥不识王右军，茂弘曾障元规尘。\n谢公高风固足尚，班女箧笥空悲呻。\n乌飞兔掷急于箭，商飙奄忽号枯林。\n呜呼盛衰天地无古今，炎凉不易君子心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读宋太史诗文集谩书","author":"吕诚","text":"金华山下古潜溪，秀发英灵间世奇。\n岁久不闻清庙瑟，眼明今见玉堂诗。\n百年人物推此老，一代风流当继谁。\n颇恨淹留忘坠景，遗编徒使后来悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访成真观有感","author":"吕诚","text":"暮年重访成真观，不见秋云竹外楼。\n枸杞经春皆化犬，朱藤历岁总如虬。\n种桃道士凭虚去，采若骚人汗漫游。\n见说蓬莱又清浅，拟将黄鹤问丹丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题子昂画马图卷","author":"吕诚","text":"灵物降精生倔奇，贡来自是千里驹。\n天闲潇潇风满旗，立仗不受黄金羁。\n吴兴写生世所稀，春雷挟之上天飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访偶武孟篬筤轩时武孟制满求仕","author":"吕诚","text":"旧草溪东十里馀，小桃源上见郊居。\n落红石径和云扫，新绿瓜畦趁雨锄。\n池上此君宜对酒，门前长者屡回车。\n此中未让商山老，见说王褒有荐书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仲春雨后生寒有怀篬筤室","author":"吕诚","text":"东冈二月草芊绵，淰淰寒云雨后天。\n杨柳三眠风作恶，樱桃半开春可怜。\n诗域日荒抛砚石，醉乡时与打?船。\n清游每忆篬筤室，何日重来看碧鲜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"觅菊","author":"吕诚","text":"秋潮横挟风雨颠，洲上空闻有菊田。\n香色于人既无有，物情在我敢求全。\n颇怜尘世光阴迅，似觉人间雨露偏。\n白发满头难讳老，苍颜对客强为妍。\n岂惟酒向邻家得，自是杯从旧日传。\n陶宰不妨多种秫，杜陵且莫叹无钱。\n青天雁影西风外，红树秋声落照边。\n见说南庄饶物色，少分清艳到樽前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访友","author":"吕诚","text":"先生家住正阳门，绕屋松声日夜闻。\n大药总消头上雪，小山长带洞中云。\n已知济物宜终庆，况是清时属右文。\n却叹吾诗与君画，海门风月拟平分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东溟生诗为顾某赋","author":"吕诚","text":"东溟之生何所闻，抱艺学古以事亲。\n翛然一室东海村，市尘不到绝垢氛。\n坐见三洲渺无垠，一碧万里玻瓈盆。\n雪涛银屋相吐吞，烂霞浴出扶桑暾。\n是时幽人侍晏温，菽水之乐乐天真。\n兴来挥扫水墨浑，下笔惨淡愁鬼神。\n居然耕凿生意存，经营态度回阳春。\n百年缣素琴断纹，挦标装潢称绝伦。\n由其天机出清新，能事逸发皆可人。\n素昧平生笑语亲，一日索书来叩门。\n嗟余耳聩目力昏，那能复作寒螀呻。\n霜风搜林叶缤纷，寒菊艳艳东篱根。\n姑致是事且勿论，与子倒尽花前樽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆溪棹歌四首 其一","author":"吕诚","text":"荆溪溪上晚山稠，沙棠港口木兰舟。\n裹头女子唱歌去，水色山光总是愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆溪棹歌四首 其二","author":"吕诚","text":"大男凿山衣尽红，中男操舟惯张篷。\n独山门外北风恶，白浪如天怖杀侬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆溪棹歌四首 其三","author":"吕诚","text":"溪上雪消春水高，鹅黄新柳暗长桥。\n桥头人家好春酒，无情长与驻兰桡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆溪棹歌四首 其四","author":"吕诚","text":"双舟来往奈愁何，日日溪中听棹歌。\n溪水西流流不断，海门东去作风波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝词三首 其一","author":"吕诚","text":"千夫万夫皑作堆，什什五五鱼贯腮。\n长兴步头候粮去，红阑街里买薪来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝词三首 其二","author":"吕诚","text":"胭支山头雨雪飞，胭支山前人苦饥。\n山下斧斤夜达旦，山上閒云长自归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"竹枝词三首 其三","author":"吕诚","text":"十八里冈云有无，炎风扫地雪模糊。\n山川通塞奚能问，閒看清波入太湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄怀茜川基古石二首北山翁也","author":"吕诚","text":"身閒无事且婆娑，转眼流年一掷梭。\n牢落诗怀三月过，颠狂风信五更多。\n潮来海市鱼论斗，柳暗江林鸟弄歌。\n颇讶寥寥无信使，题诗为问近如何？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄谢谌西堂惠纸二首 其一","author":"吕诚","text":"云茧罗纹幸见投，乌皮几上雪凝眸。\n怀人端为双鱼信，作赋空惭五凤楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄谢谌西堂惠纸二首 其二","author":"吕诚","text":"翠峰山下连吴会，雪浪东来入海门。\n胸次不留元字脚，金香炉下铁昆崙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴二首 其一","author":"吕诚","text":"静室无尘少客过，新篁阴曳小坡陀。\n朝来始悟春归尽，风里杨花似雨多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴二首 其二","author":"吕诚","text":"落花寂寂掩柴荆，满地绿阴新笋生。\n自是老来游兴减，江山何处不堪行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题水墨龙图","author":"吕诚","text":"画史凭陵造化机，研池倾倒墨龙飞。\n生绡半幅春云湿，疑是前山作雨归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月廿八日重过翠涛轩清坐终日薄暮而归赋此盖书所见也翠涛为竹而得名余不能无辞矣","author":"吕诚","text":"幽人爱竹不吃笋，养得修篁个个长。\n五月六月雨不落，千枝万枝风自凉。\n苍雪逼人时展簟，翠涛惊梦午移床。\n涓涓清润乌皮几，楚楚高搀薜荔墙。\n密影扫阶敷琐碎，馀音拂水度笙簧。\n孙枝迸地浑疑占，老节凌云色更苍。\n三径旋开真得计，七贤避世故佯狂。\n因怀梅友称三绝，却笑荷花似六郎。\n白鹤归时云动荡，青鸾啸处夜微茫。\n对之可使食无肉，衰矣空惭鬓有霜。\n隐几无心开卷帙，捲帘随意炷炉香。\n日中见斗瞻霄汉，月下吹箫引凤凰。\n物外襟怀差可共，閒中滋味淡相忘。\n不寻酒伴鸡豚社，误落诗名锦绣坊。\n时复开樽排匼匝，每怜学子走?蹡。\n兴来坐久无聊赖，老去频过也不妨。\n他日成材惟汗简，于今触目尽琳琅。\n振衣散策归来后，江路迢迢又夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"则明游馀杭三桥步回过余草堂赋此谢之","author":"吕诚","text":"秋日三桥步，行舟野色新。\n乱山围草市，荒埭接江津。\n杉竹通蛮獠，麇麋贩猎人。\n欲将金粟酒，为子拂征尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题枯树图","author":"吕诚","text":"铁干槎牙翠叶残，云根剥落古苔斑。\n大材宁尽天年老，不遇工师不出山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月晦访声远留题","author":"吕诚","text":"海门潮上水如烟，贺老重维载酒船。\n喜见云山开雪壁，幸因郎囝鼓冰弦。\n应门童子清于鹤，捣药灵禽半是仙。\n岁晚卜邻应有约，几时行李到梅边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄则明二首 其一","author":"吕诚","text":"苜蓿花开遍地秋，秋声浑在树梢头。\n西风昨夜吹归梦，唤起客怀无限愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄则明二首 其二","author":"吕诚","text":"几树芙蓉近水低，碧沙凉露泣莎鸡。\n月边已有南来雁，飞过荻江官渡西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚归书事六言二首 其一","author":"吕诚","text":"访旧五溪薄暮，沙长归路迢遥。\n虚市人家烧烛，流水孤村断桥。\n一个残僧待渡，数声短笛归樵。\n闪闪昏鸦啼后，江风又落寒潮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚归书事六言二首 其二","author":"吕诚","text":"渔榜溪翁罢钓，邮铃稚子传书。\n暝烟寒雪欲落，腊柳半黄未舒。\n云叶落随去雁，浪花泼刺跳鱼。\n一段诗情画意，潇然风景愁余。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"醉归","author":"吕诚","text":"醉归不觉已斜曛，稚子驩迎先候门。\n露林睡觉凉如水，树影满窗疑是云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄鹤山樵画匡山读书图","author":"吕诚","text":"黄鹤山人美如玉，长年爱山看不足。\n醉拈秃笔扫秋光，割截匡山云一幅。\n诗豪每忆青莲仙，结巢读书长醉眠。\n我欲因之揽秀色，双凫飞堕香炉前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食谩兴书所见二首 其一","author":"吕诚","text":"杨柳东风日夜颠，杏桃无语不成妍。\n水流竟没鸥边石，雨重浑迷卵色天。\n节序匆匆无可那，物情汹汹最堪怜。\n荒村阒寂无鸡犬，何处人来扫墓田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食谩兴书所见二首 其二","author":"吕诚","text":"三月三日雨初晴，清旦梳头坐草亭。\n一陂草色为谁绿？\n千树柳条无赖青。\n忧患未平心耿耿，衰迟那遣鬓星星。\n林鸠底事频呼妇，强聒春愁苦厌听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日雨中杂兴","author":"吕诚","text":"霜降海门天气肃，无边落木总缤纷。\n鸥眠夜渡芙蓉雨，雁落秋田䆉稏云。\n未有诗篇酬令节，祗将茗盌对炉薰。\n月中桂子飘人世，时有天香隔幔闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"听雨","author":"吕诚","text":"倾倒天瓢走雨工，海门龙过起腥风。\n潇潇午夜鸣山竹，如在春江听打篷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"期友不至","author":"吕诚","text":"长日閒吟步紫苔，流光转眼熟黄梅。\n雄风豪雨将春去，浊垢深泥少客来。\n老柘叶稀愁茧瘦，草田水漫厌鹃催。\n题诗问讯王文学，怀抱何时一笑开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风雨连日闭户默坐怀思可知忽翠涛轩以笋蔬之惠走笔答之","author":"吕诚","text":"春事都随逝水东，不堪日夜雨兼风。\n龙归海浦沈云墨，鸟啄樱桃落子红。\n老境讵言诗有债，醉乡谁谓酒无功。\n鲑蔬向赖西邻笋，瓷缶时将五尺僮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集句题水仙图","author":"吕诚","text":"秋水为神玉为骨，山矾是弟梅是兄。\n恍然坐我水仙府，吾与汝曹俱眼明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂诗五首 其一","author":"吕诚","text":"三月南江渡，行春属晚晴。\n留连花下䑽，酾酒待潮生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂诗五首 其二","author":"吕诚","text":"开船收雨色，新水达春江。\n鸂?元无侣，雎鸠自一双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂诗五首 其三","author":"吕诚","text":"青天归雁喜，密树坐莺深。\n落日春愁里，怀人浩荡心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂诗五首 其四","author":"吕诚","text":"城门踏青草，城下杨花度。\n荒垄无耕人，三月输官赋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂诗五首 其五","author":"吕诚","text":"近江乔木里，彊半棣华栽。\n叶覆青青蔓，相沿别树开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"仿李商隐一首","author":"吕诚","text":"花落铜盘蜡炬融，逶迤春色照芙蓉。\n当筵行酒金钗侧，隔座吹笙绣幕重。\n已有鸾刀飞鲙缕，未须翠釜出驼峰。\n夜深环佩云中过，宛在瑶台月下逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登淀山寺","author":"吕诚","text":"一上湖南淀山寺，寺门高开秋树颠。\n下界云烟惟一气，八方楼阁驻诸天。\n无风灵籁时生壑，深夜神龙或起渊。\n我独题诗此临眺，寥寥宇宙几千年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀友","author":"吕诚","text":"□夏夜景静，斋阁临前池。\n当檐素月流，举扇凉飔吹。\n参差丹棘花，婀娜红莲枝。\n玉人美无度，耿耿劳我思。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江水辞送友人之龙江二首 其一","author":"吕诚","text":"江水一百里，南风一日程。\n飞华多意绪，相逐柁楼行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]