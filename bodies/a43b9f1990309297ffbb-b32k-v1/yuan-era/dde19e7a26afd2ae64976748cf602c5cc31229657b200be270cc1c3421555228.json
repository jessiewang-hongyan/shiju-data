[{"title":"赠歌者杜氏入道三首 其三","author":"潘纯","text":"云髻高梳鬓不分，扫除虚室事元君。\n新糊白纸屏风上，尽画蓬莱五色云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":1,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七岁游法兴寺","author":"胡天游","text":"山色摇光入袖凉，松阴十丈印回廊。\n老僧读罢楞严咒，一殿神风柏子香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":2,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新岁忆曾子白","author":"陈高","text":"经月愁闻雨，新年苦忆君。\n青华为客久，白发著书勤。\n酒共邻僧饮，蔬从野老分。\n何时共登眺，整屐待晴云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":3,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城西虎跑寺","author":"陈高","text":"石势虎蹲伏，山形龙屈盘。\n寺开唐殿阁，坟掩宋衣冠。\n幽涧泉声细，斜阳塔影寒。\n近城多战鼓，栖息此中安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠章以元昆仲","author":"陈高","text":"相见谈经史，江楼坐夜阑。\n风声吹屋响，灯影照人寒。\n俗薄交游尽，时危出处难。\n衰年逢二妙，亦得闷怀宽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":5,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春词和韵 其一","author":"胡天游","text":"绿窗红烛制春衣，宫样花纱要入时。\n玉手怕裁双凤破，并刀欲下更迟迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":6,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕王","author":"元婴","text":"君王台榭枕巴山，万丈丹梯尚可攀。\n春日莺啼脩竹里，仙家犬吠白云间。\n清江锦石伤心丽，嫩蕊浓花满目班。\n人到于今歌出牧，来游此地不知还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":7,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自集庆路入正大统途中偶吟","author":"元文宗","text":"穿了氁衫便著鞭，一钩残月柳梢边。\n二三点露滴如雨，六七个星犹在天。\n犬吠竹篱人过语，鸡鸣茅店客惊眠。\n须臾捧出扶桑日，七十二峰都在前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春游","author":"虞集","text":"明日城东看杏花，叮咛童子蚤将车。\n路从丹凤楼前过，酒向金鱼馆里赊。\n绿水满沟生杜若，暖云将雨湿泥沙。\n绝胜羊傅襄阳道，车骑西风拥鼓笳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登凤凰台二首 其一","author":"萨都剌","text":"凤凰台上望长安，五色宫袍照水寒。\n綵笔十年留翰墨，银河一夜卧阑干。\n三山飞鸟江天暮，六代离宫草树残。\n始信人生如一梦，壮怀莫使酒杯乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登凤凰台二首 其二","author":"萨都剌","text":"梧桐叶落秋风老，人去台空凤不来。\n梁武台城芳草合，吴王宫殿野花开。\n石头城下春生水，燕子堂前雨长苔。\n莫问人间兴废事，百年相遇且衔杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四时宫词四首 其四","author":"萨都剌","text":"悄悄深宫不见人，倚门惟有石麒麟。\n芙蓉帐冷愁长夜，翡翠帘垂隔小春。\n天远难通青鸟信，瓦寒欲动白龙鳞。\n夜深怕有羊车到，自起笼灯照雪尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":12,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望九华","author":"元文宗","text":"昔年曾见《九华图》，为问江南有也无。\n今日五溪桥上见，画师犹自欠工夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧叶儿","author":"吴西逸","text":"韶华过，春色休。\n红瘦绿阴稠。\n花凝恨，柳带愁。\n泛兰舟。\n明日寻芳载酒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧叶儿","author":"张可久","text":"鸳鸯浦，鹦鹉洲。\n竹叶小渔舟。\n烟中树，山外楼。\n水边鸥。\n扇面儿、潇湘暮秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧叶儿","author":"张可久","text":"花垂露，柳散烟。\n苏小酒楼前。\n舞队飞琼佩，游人碾玉鞭。\n诗句缕金笺。\n懒上苏堤画船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三君咏 其二 郭代公","author":"元振","text":"代公实英迈，津涯浩难识。\n拥兵抗矫徵，仗节归有德。\n纵横负才智，顾盻安社稷。\n流落勿重陈，怀哉为悽恻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":17,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其二 三山","author":"于立","text":"蓬莱失左股，负以垂天翼。\n中有仙人居，珠宫灿瑶席。\n凝云不飞去，化作轮囷石。\n弹琴坐石上，长忆三山客。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其八 芬陀室","author":"于立","text":"视心如莲花，净明涵十虚。\n出泥本无垢，露体皆真如。\n大千入一息，晏坐忘百须。\n陶公虽饮酒，时能到林庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其六 古城","author":"于立","text":"驱车晓行迈，行行出郊郭。\n断冈屹崇墉，虚籁殷灵壑。\n雨深瑶草长，风定松花落。\n西山有爽气，逍遥倚晴阁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其三 崇山","author":"于立","text":"会稽山水国，崇山幽事多。\n当时觞咏处，春净花颜酡。\n磊落黄金罍，玲珑白玉珂。\n行乐须及时，美人在丘阿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":21,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其七 缥碧楼","author":"于立","text":"楼居本高明，况在松竹间。\n溪流深几尺，新雨过前山。\n浮云多变态，好鸟亦间关。\n偃蹇楼中人，对酒还开颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其一 种山","author":"于立","text":"青山削芙蓉，上有浮云生。\n窈窕俯长流，逶迤带重城。\n朝光散霞彩，暮色涵空青。\n鸱夷去不回，遗尔千古名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其五 鉴湖","author":"于立","text":"我爱鉴湖水，明如照胆铜。\n澄清若有待，浑浊那能蒙。\n当时贺知章，富贵如苓通。\n岂无一亩地，来筑仙人宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":24,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵鉴中八咏 其四 梅山","author":"于立","text":"梅山如积翠，的皪手堪捧。\n遥遥仙人尉，盘盘故时陇。\n丹泉清可鉴，石乳甘于湩。\n行将解尘缨，于焉蹈高踵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题明福法堂壁","author":"云章真人","text":"一望罗浮耸万山，画图曾进悦天颜。\n金炉飞篆乘鸾去，玉笈翻经引鹤还。\n棋洞落花春寂寂，药槽流水夜潺潺。\n人来共道修仙易，谁肯安心学坐圜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"济州登太白楼怀郑从之御史二首 其一","author":"曹伯启","text":"高城蘸云根，聊可慰心迹。\n长风万里来，如对骑鲸客。\n监州好事者，树此楼与石。\n隆鼻号金仙，更长谩嗟惜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张明府清风堂","author":"元佐","text":"万叠春山积雨晴，新茶处处煮车声。\n不应独送月团片，偏与卢仝两腋生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":28,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张明府清风堂","author":"元佐","text":"素纨摇月坐高堂，病暍应无困道傍。\n好倩丰隆吹火伞，人间各受一襟凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":29,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张明府清风堂","author":"元佐","text":"麦陇初秋晓吹寒，新篁摇动碧琅玕。\n涤烦解愠谁相似，父老人人说长官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵谢吕君","author":"元方","text":"鄂城未至客湓城，谁识惓惓欲见情。\n端肯寄书凭雁足，遥知求友认莺声。\n论心政愿投胶漆，临路良难渡水罂。\n江海一生今老矣，待来重结岁寒盟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":31,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵谢吕君","author":"元方","text":"弱冠清脩更老成，诗来重慰故人情。\n向曾屡共阿戎语，今乃新闻侯喜声。\n材大君当为杞梓，器微吾仅比瓶罂。\n平生吟社彫零尽，合许忘年友与盟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吕才甫之官合肥","author":"元恺","text":"妙年半五十，分刺合肥城。\n楚俗虽尊武，淮乡已息兵。\n草霜校秋猎，花雨课春耕。\n退食应多暇，书灯夜夜明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄抚州吕使君","author":"元恺","text":"一别龙门十五期，湓城日夜梦魂驰。\n归装初解临川印，注本应多介甫诗。\n定复一鸱能见惠，遥知五马未相遗。\n鲤鱼直下西江水，兼有书来慰我思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留回岭汪明府宅","author":"元圭","text":"仇池非仙境，商岭在人世。\n讵必深且僻，而后兵可避。\n大物有转移，戈甲满天地。\n城郭非云远，马迹竟不至。\n蓊蔚树木密，复重涧谷閟。\n中有长者家，累叶重名谊。\n积德服里社，故非一朝致。\n园池既显敞，栋宇亦弘邃。\n文甃洛花红，雕笼陇禽翠。\n恍然壶中天，迥与尘界异。\n崇觞延老夫，子侄尽擎跽。\n岂惟授之粲，抑且侑以币。\n客来无不速，各各满其意。\n居多章甫冠，宪宪洁衿佩。\n如闻筑精舍，徽国严祀事。\n纪载傥予属，庶用报嘉惠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":35,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神山避暑晚行田间用陶渊明平畴交远风良苗亦怀新为韵 其一","author":"许有壬","text":"田塍晚独策，及此时雨晴。\n东畦与西疃，泱泱流水声。\n丰年已足欢，清风复多情。\n归来藉草坐，浊酒还自倾。\n不用浇磈磊，我怀无不平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":36,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉阳郎官湖歌","author":"李泂","text":"山翁薄暮醉酒归，杖藜迷却高阳池。\n清风吹花绿阴倒，我笑谓是秋云移。\n还乘贯月槎，夜过郎官湖。\n峥嵘星斗入江汉，荡漾槎影如鲸鱼。\n九华之真人，邀我倒玉壶。\n麒麟擘脯供行厨，依稀仙乐在空际，碧山四映寒蟾孤。\n举酒酌寒蟾，明月下饮嫦娥俱。\n霓裳拂云锦，万荷露泻琼瑶珠。\n麾幢晻霭罗烟空，乃有玉皇所授之玉童。\n风前飘飘曳广带，对立十二秋芙蓉。\n清香九曲银河通，真人绿发披天风。\n锦袍玉雪照天地，口说姓字安南公。\n是公多逸气，略与古昔贤豪同。\n时能扫月色，延我石室烟萝中。\n又言昔同张谓所游地，长啸一覆丹霞钟。\n风吹仙乐度溪去，我已醉卧香炉峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":37,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送封州方法曹","author":"元吉","text":"地远无迎吏，州城若个边。\n宁甘茅屋粥，勿饮石门泉。\n旋橐挑诗卷，家书托客船。\n安知二千石，不荐议曹贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":38,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭裘","author":"元量","text":"筑室西山下，孤标未易亲。\n长闲如野鹤，偶出似祥麟。\n属者陪髦士，嗟呼瘗玉人。\n北风吹老泪，空滴暮江滨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":39,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽林武博二首","author":"元晋","text":"畴昔论交四十霜，知公出处我尤详。\n召来空赏凌云赋，麾去全疏偃月堂。\n近寄丽蔘怜老病，忽吟楚些隔存亡。\n从今野叟凝尘几，无复三溪字数行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":40,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽林武博二首","author":"元晋","text":"郭令科名翁冠绝，董生制策子蝉联。\n向来景行珠林老，末后冰衔玉局仙。\n食肉恨公非燕颔，冲霄从古要鸢肩。\n可怜閒袖功名手，仅驾朱轮楚泽边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":41,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答方俊甫投赠二首","author":"元美","text":"李杜坛高未易扳，鲸波浩渺鹤天宽。\n潮音堂上频升座，日过寮中暂挂单。\n颜子向来曾父孔，李翱未可便兄韩。\n内丹仅足延龄尔，若要飞升必大丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":42,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答方俊甫投赠二首","author":"元美","text":"抽还手板把随如，甘向三家村卜居。\n晚有绝诗题白下，早为选礼倡黄初。\n难从杨子通奇字，却羡祁公学草书。\n国语一编可传世，何妨左氏失明馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":43,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠吴王","author":"元顺帝","text":"金陵使者过江来，漠漠风烟一道开。\n王气有时还自息，皇恩无处不周回。\n莫言率土皆王化，且喜江南有俊才。\n归去丁宁频属付，春风先到凤皇台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":44,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧叶儿","author":"张雨","text":"移家去，市隐间。\n幽事颇相关。\n刘商观棋罢，韩康卖药还。\n点检绿云鬟。\n数不尽、龟溪好山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":45,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏武慢 寄赠","author":"朱晞颜","text":"枕海山横，陵江潮去，雉堞秋风残照。\n閒寻桂子，试听菱歌，湖上晚来凉好。\n几处兰舟，采莲游女，归去隔花相恼。\n奈长安不见，刘郎已老，暗伤怀抱。\n谁信得、旧日风流，如今憔悴，换却五陵年少。\n逢花倒躲，遇酒坚辞，常是懒歌慵笑。\n除奉天威，扫平狂寇，整顿乾坤都了。\n共赤松携手，重期明月，再游蓬岛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":46,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春词和韵 其二","author":"胡天游","text":"日射珠帘试晓晴，隙光斜上宝钗明。\n碧纱窗下无消息，閒数吴蚕几个生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":47,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饯吕子敬赴漕台","author":"朱晞颜","text":"北风吹海波，寒气已惨栗。\n岁功方告成，上计仓廪实。\n大府督先期，列城群彦集。\n公来亲奉辞，王事有远役。\n入登和钧堂，咨诹侍前席。\n力陈功利源，首先二三策。\n民实吾同胞，苛痛体均一。\n商贾趋懋迁，负贩致其力。\n上以奉王供，下以合民食。\n嗟余忝命吏，三载贰下邑。\n适丁岁屡艰，课计虚所入。\n使车勤远人，问俗考肥瘠。\n念兹灾疹馀，推额减其籍。\n寒者煦之温，饥者哺之粒。\n向非大府严，云雨手转剧。\n公归被顾问，为我对以臆。\n倘能出泥滓，穷困非所惜。\n相期在岁寒，梅边问消息。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":48,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二乔卷","author":"宋无","text":"国色双花相并栽，周郎分得小枝来。\n汉宫早有君王见，金屋须教一处开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":49,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三高祠","author":"宋无","text":"退能合天道，隐亦是人豪。\n借问祠前水，如今几个高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":50,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子陵","author":"宋无","text":"乾坤罢战尘，渔钓可藏身。\n何事刘文叔，犹来觅故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":51,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"子陵祠堂","author":"宋无","text":"一见故人归去来，渔竿不肯博三台。\n汉陵今日无抔土，惟独先生有钓台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":52,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中","author":"宋无","text":"半岭松声樵客分，一溪春草鹿成群。\n采芝人入翠微去，丹灶石坛空白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":53,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中僧","author":"宋无","text":"雪顶霜眉齿半稀，跏趺苔石看云归。\n山童扫叶鹤飞起，狼籍松花满衲衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":54,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马塍","author":"宋无","text":"桃李宫城近，偏承雨露恩。\n至今耕种地，一半作花园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":55,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云雨","author":"宋无","text":"云雨朝朝暮暮新，襄王魂断楚江春。\n武丁曾有中宵梦，惟觅岩前版筑人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":56,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"孔明","author":"宋无","text":"有心兴汉室，不意托孤儿。\n帝昔曾三顾，臣今表出师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":57,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题","author":"宋无","text":"花影玲珑满绣林，自调绿绮背红窗。\n惆怅佳期学弘线，七条请怨不成双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":58,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水驿","author":"宋无","text":"水驿相连晓夜行，浑无心记短长亭。\n莫笑杨花道飘泊，人生自有一浮萍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":59,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长信秋","author":"宋无","text":"长信秋来月自圆，夜香独拜玉阶前。\n妾吟不顾君王宠，惟顾君王寿万年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":60,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东风","author":"宋无","text":"东风吹绿上汀洲，染出江南一片愁。\n长到春来问芳草，不知何地可忘忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":61,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兰","author":"宋无","text":"分向湘山伴野蒿，偶并香草入离骚。\n清名悔出群芳上，不入离骚更自高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":62,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发白解嘲","author":"宋无","text":"吴霜两鬓早先秋，闻道愁多会白头。\n溪上鹭鸶浑似雪，想应无那一身愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":63,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四皓","author":"宋无","text":"四老本英雄，来成羽翼功。\n向令秦重士，未必隐山中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":64,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戍妇言","author":"宋无","text":"姑嫜有妾奉，征战盍郎行。\n早取封侯去，封侯妾亦荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":65,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汉宫","author":"宋无","text":"武帝升遐玉殿空，金人夜泣月明中。\n三千嫔御无行幸，犹费丹砂饲守宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":66,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉环病齿图","author":"宋无","text":"一点春寒入瓠悄，海棠花下独颦眉。\n内厨岁日无宣唤，不间君王索荔枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":67,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉津园","author":"宋无","text":"御爱花无主，长生树几时。\n青青辇路草，尽属牧羊儿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":68,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"扬州","author":"宋无","text":"红桥二十四，明月照笙歌。\n若是迷楼在，游人应更多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":69,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江山万里图","author":"宋无","text":"只尺寒流千万峰，濡声寂寂暮猿空。\n卖船欲泛春潮雨，楚树吴云是尽中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":70,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]