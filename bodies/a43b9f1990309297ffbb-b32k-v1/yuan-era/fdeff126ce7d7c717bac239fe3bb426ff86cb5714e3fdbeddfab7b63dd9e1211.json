[{"title":"过高唐","author":"萨都剌","text":"残雪复残草，凄风吹未消。\n王孙去不返，魂魄有谁招？\n往事皆如梦，无人问早朝。\n荒陵斜照里，松柏晚萧萧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送管元帅南征 其五 寄省郎郭天锡","author":"萨都剌","text":"人道省郎好，簿书清昼閒。\n惟公不自喜，忽尔要思还。\n酒债西湖路，归心北固山。\n閒愁且抛却，莫遣鬓毛斑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送金德启之句容","author":"萨都剌","text":"元宵能几日，君去独何心。\n县市春灯乱，山村夜雪深。\n乡情犹越分，诗句尽唐音。\n后会逢寒食，晴光满树林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠诉笑隐长老","author":"萨都剌","text":"佛宫天上有，人世见应稀。\n客遇钟鸣饭，僧披御赐衣。\n青春忘蝶梦，白日说龙飞。\n遥忆宸游处，金莲照夜归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"都下同翰林诸公送御史尚游题紫骝马","author":"萨都剌","text":"御史紫骝马，今朝行且嘶。\n远烟芳草露，细雨落花泥。\n蹋月饮淮水，随云过汴堤。\n遥思乡旆日，晓立听朝鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钟山遇风雨 其一","author":"萨都剌","text":"城市多骢马，清游有几人。\n山灵飞白雨，朝士说红尘。\n云起钟楼暝，桃开野寺春。\n上人归太晚，谁主复谁宾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钟山遇风雨 其二","author":"萨都剌","text":"游乐有深处，岂知行路难。\n山风吹马倒，松雨滴花寒。\n丘壑篮舆转，花台石磴盘。\n吾皇千万寿，曾此驻金銮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四美亭饯别时雪大作戏赠赵公子","author":"萨都剌","text":"公子青骢马，追游十里遥。\n风头云叶冻，酒面雪花消。\n惜别迟回首，何因见舞腰。\n君归金帐暖，无限可怜宵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送道士良豸冠还楚丘","author":"萨都剌","text":"淮水春帆动，山城积雨馀。\n南台去千里，北阙有三书。\n白下曾行马，黄河可脍鱼。\n庙堂公论在，君去莫踌躇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄习思敬","author":"萨都剌","text":"深冬残雪夜，醉卧玉山楼。\n风劲银筝响，花垂绛烛流。\n连床无客梦，中酒失乡愁。\n岁月如流水，凭高忆旧游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄中台照磨子徵","author":"萨都剌","text":"中台高百尺，幕府得姚郎。\n洗面风生雨，鸣珂月照霜。\n诗成裁昼锦，酒饮赐天香。\n独有无媒者，台城立晚凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起城东晚步","author":"萨都剌","text":"扶病谁同步，寻幽思不群。\n逢僧穿竹去，吹笛隔林闻。\n山势浮云合，溪流野水分。\n徘徊归晚径，树影月纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵郭侍御","author":"萨都剌","text":"江左风流在，长怀晋谢安。\n传家须教子，畏事即嫌官。\n云雾天风险，烟波世路难。\n雄心端有望，白发漆纱冠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄士岩台郎","author":"萨都剌","text":"荐士如君子，文章立玉泥。\n自登台阙去，不使簿书迷。\n薄俸无馀积，长贫有病妻。\n长安贵公子，中酒听莺啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宣古木","author":"萨都剌","text":"铁面小将军，旌旗照海门。\n兵机出孙武，胆气走桓温。\n社稷剑三尺，乾坤酒一樽。\n茫茫霄汉内，此意与谁论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过贾似道废宅","author":"萨都剌","text":"贾生亦何者，此地起楼台。\n社稷无人物，湖山养祸胎。\n前朝亡国恨，遗迹后人哀。\n落日空江上，王宫亦草莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"途次吴江别高照庵","author":"萨都剌","text":"适意无南北，相逢江海边。\n乡关千里外，风雨一灯前。\n呼酒吾同醉，论文子独贤。\n分襟在今日，握手又何年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄友","author":"萨都剌","text":"紫禁莺花老，京城四月初。\n层楼开别酒，小海出银鱼。\n度日轻肥马，朝天借蹇驴。\n愿言江海上，亦有病相如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"范佥事幽居","author":"萨都剌","text":"邑外桑麻长，山中笋蕨甜。\n儿孙荐时果，燕雀下晴檐。\n芳草生含路，杨花飞过帘。\n人头似白雪，对客口如钳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大别山","author":"萨都剌","text":"落日在平地，苍茫吴楚秋。\n人随孤鹤远，天共九江流。\n风物吞淮海，楼船下鄂州。\n凭高一登眺，不尽古今愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统乙亥余录囚至沧州坐清风楼","author":"萨都剌","text":"晋代繁华地，如今有此楼。\n暮云连海溆，明月满沧州。\n归鸟如云过，飞星拂瓦流。\n城南秋水尽，寂寞采莲舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中怀友 其一","author":"萨都剌","text":"远望空山里，天寒夕梦孤。\n林昏行魍魉，江晚变䕷芜。\n课议难容我，交游重有吾。\n论文轻咳唾，问俗到耕锄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中怀友 其二","author":"萨都剌","text":"天府超群彦，脩材复壮腾。\n波澜开白昼，羽翼动苍冥。\n弱质悲殊调，明时欲独醒。\n应怜扬执戟，寂寞太玄经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中怀友 其三","author":"萨都剌","text":"何事虚斋里，犹分苜蓿盘。\n高林容偃蹇，众翼避扶抟。\n黑夜文星动，青天剑气寒。\n终南山正好，那得悔儒官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中怀友 其五","author":"萨都剌","text":"卓荦恒山秀，相逢几抱琴。\n五年风雨别，四海弟兄心。\n岭外梅花远，山中桂叶深。\n定知嵇叔夜，高兴满云林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中怀友 其六","author":"萨都剌","text":"洛社推年久，清村照柿林。\n春风何处客，芳草独行深。\n遗墨收秦刻，新诗学楚音。\n别离无一字，目断白云岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送唐卿御史","author":"萨都剌","text":"去去红尘外，秋光满华嵩。\n故乡归衣锦，行路避乘骢。\n未觉长安远，真成冀北空。\n燕山一枝桂，回首正西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题刘山长雪夜板舆图","author":"萨都剌","text":"板舆行乐处，鹤发尽鬖鬖。\n人子谁无母，刘家独有男。\n诸孙嬉掌上，阿母度溪南。\n玉宇光连夜，颜酡酒半酣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿大横驿","author":"萨都剌","text":"灯火明沙渡，牛羊过水西。\n村舂干涧落，野店四山齐。\n桂树偏宜月，人家尽向溪。\n秋蟾莫相恼，惟听度关鸡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"溪行中秋望月","author":"萨都剌","text":"去岁南闽客，今年此日还。\n中秋八月半，一水万山间。\n皓月飞圆镜，回流转曲环。\n携家共清赏，何异在乡关。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游梅仙山和唐人韵 其一","author":"萨都剌","text":"城郭千峰合，仙凡一水分。\n颠崖悬鸟道，乱石聚羊群。\n苔井分丹水，茶炉煮白云。\n肩舆万松岭，有客访梅君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游梅仙山和唐人韵 其二","author":"萨都剌","text":"绝顶寻仙迹，寒泉照病容。\n栖鸾多种竹，爱鹤莫移松。\n丹药人来乞，山粳手自舂。\n秋深霜叶满，麋鹿日相逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游梅仙山和唐人韵 其四","author":"萨都剌","text":"洞天何处是，休日漫寻真。\n老鹤来迎客，隔松长似人。\n茶炉敲火急，丹井汲泉新。\n风景秋过半，烟霞晚更亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"平川幽居 其一","author":"萨都剌","text":"深隐云林静，何须负郭田。\n图书从塞屋，鸡犬亦登仙。\n酿酒寻仙术，脩琴借药钱。\n閒过武夷洞，来上钓鱼船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"平川幽居 其二","author":"萨都剌","text":"九曲溪行尽，平川隐者居。\n看家留白鹤，度竹借蓝舆。\n架上多丹药，床头有古书。\n汉廷论封禅，应问马相如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王伯循御史韵","author":"萨都剌","text":"江城连日雪，骑马欲何之。\n老树昏鸦集，寒塘落雁迟。\n松窗灯下火，竹屋夜深棋。\n寄语王公子，幽栖或可期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其一 焦桐","author":"萨都剌","text":"怜尔抱奇质，无香已自焚。\n材高初偶得，音古更谁闻。\n天海空遗操，冰霜见裂纹。\n中官方煮鹤，终得舍夫君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其二 蠹简","author":"萨都剌","text":"六籍灰寒久，名山依旧藏。\n漆痕微有字，芸草欲无香。\n后死嗟犹及，斯文岂遽亡。\n世方珍贝叶，掩卷一凄凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其三 破砚","author":"萨都剌","text":"巨璞何人凿，磨穿偶至今。\n系文虚绿润，雨气共玄阴。\n瓦砾开无异，尘埃积转深。\n明光几携入，往事复何心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其四 残画","author":"萨都剌","text":"胜境不可得，生绡馀旧图。\n丹青初彷佛，尘土半模糊。\n蝴蝶飞疑去，波涛折转无。\n良工今岂有，为尔一长吁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其五 败裘","author":"萨都剌","text":"袭尔亦已久，风霜两袖穿。\n甘从稚子笑，未受故人怜。\n雅志逾前古，深期及暮年。\n累丝今化尽，念汝独依然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其六 旧剑","author":"萨都剌","text":"忆昔蛟龙剑，提携竟出门。\n红尘走马处，白日报人恩。\n岁月铜花涩，云烟牛斗昏。\n凄然中夜舞，回首暗销魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其七 尘镜","author":"萨都剌","text":"古镜色如墨，千年独此留。\n玉台尘网暗，珠匣土花浮。\n莫笑尘埃满，曾令鬼魅愁。\n蟠龙今已化，云雨梦悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其八 废檠","author":"萨都剌","text":"不解照珠翠，早同文字盟。\n何年中路弃，无复向人明。\n宿雨高斋梦，秋吟废馆情。\n相看几今夕，及此慨平生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其九 断碑","author":"萨都剌","text":"零落秋风卧，何年破庙碑。\n图经愁莫载，耆旧说频移。\n野烧龟文失，荒台鸟迹疑。\n遥知千载后，拂拭转堪悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和吴赞府斋中十咏 其十 卧钟","author":"萨都剌","text":"龙簴久摧折，深埋奈尔何。\n耕民谁睥睨，野衲自摩挲。\n雅奏多年歇，铭文几字讹。\n斜阳荆棘里，长伴旧铜驼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄志道张令尹","author":"萨都剌","text":"淮南宣化阁，相对石头城。\n二月风帆过，满江春浪生。\n青山行不断，绿野尽开耕。\n令尹张公子，儿童知姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人兄弟相别","author":"萨都剌","text":"送兄南浦上，情思两悠悠。\n昆弟难为别，江山总是愁。\n橹声摇夜月，帆影障寒流。\n后夜相思处，嗷嗷鸿雁秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山道中","author":"萨都剌","text":"积雨千峰霁，溪流两岸平。\n野花多映水，山鸟自呼名。\n人语随乡变，官船带月行。\n江南数千里，无处不关情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道中漫兴 其一","author":"萨都剌","text":"云气千峰暝，溪流水拍桥。\n竹溪泥滑滑，榕树雨潇潇。\n曲栈钩崖角，垂虹挂岭腰。\n山家酒初熟，或事借椰瓢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道中漫兴 其二","author":"萨都剌","text":"绿树莺啼尽，山红映碧萝。\n一年春事了，四月雨声多。\n闽海夏无暑，山田晚种禾。\n远人千里别，归思欲如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭同年进士李竹操经历 其一","author":"萨都剌","text":"进士如公少，何期与死邻。\n青山归葬骨，白发未封亲。\n已矣官三郡，哀哉子一人。\n送君螺水上，呜咽泪沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哭同年进士李竹操经历 其二","author":"萨都剌","text":"此去成长别，频将雨泪挥。\n空江片帆远，落日乱鸦飞。\n白纸招魂葬，青山有梦归。\n双亲头似雪，尘暗老莱衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶题清凉境界","author":"萨都剌","text":"今日清凉境，明朝剑水心。\n酒堪消客况，泉可洗尘襟。\n佛古荒苔藓，林深繁绿阴。\n樵歌山路晚，馀兴付归禽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题蜀山驿","author":"萨都剌","text":"荒山孤馆静，老树冻云低。\n马识来时路，诗存旧日题。\n邮亭一尊酒，客枕五更鸡。\n到晓征鞍发，村村雪涨溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿因胜庄 其一","author":"萨都剌","text":"薄莫雨初作，客愁行路难。\n长风吹短发，平地走惊湍。\n云气千山暝，松声五月寒。\n小窗僧话久，亦学坐蒲团。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿因胜庄","author":"萨都剌","text":"竹院亦幽雅，参禅愧未能。\n梦回僧枕雨，花落佛龛灯。\n风响过墙竹，窗摇挂树藤。\n裁诗题素壁，聊尔记吾曾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11354,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿龙潭寺","author":"萨都剌","text":"客路青山下，僧庵绿水边。\n撞钟惊鸟宿，洗钵动龙眠。\n未有林泉趣，先寻粥饭缘。\n上人喜留客，夜雨佛灯前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11355,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次龙潭壁间韵忆新之区谦二台节 其一","author":"萨都剌","text":"故人久不见，怅望思迟留。\n客路愁山虎，渔灯散渚鸥。\n清歌闻越调，小艇入淮流。\n江市虽萧索，人家酒可谋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11356,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次龙潭壁间韵忆新之区谦二台节 其二","author":"萨都剌","text":"勤劳贤使者，官马未曾閒。\n夜醉谁家酒，晓行何处山。\n莫云留客住，落日望君还。\n相忆寻诗处，波涛汹涌间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江馆写事","author":"萨都剌","text":"晚市人烟合，归帆带夕阳。\n青山到江尽，白鸟去天长。\n越女能淮语，吴姬学楚妆。\n栖迟未归客，犹著锦衣裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢龙江虚白上人雨中见过","author":"萨都剌","text":"山僧入城市，归路晚沈沈。\n雨湿缁衣重，灯明黑树深。\n泥途信行脚，粥鼓急归心。\n应到松窗下，新诗剪烛吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铁塔寺写怀","author":"萨都剌","text":"萧条冶城寺，杖屦日登临。\n古木凉风急，空山落叶深。\n夜灯明铁塔，秋雨暗松林。\n衲子清游处，閒来独自吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫兴","author":"萨都剌","text":"去岁干戈险，今年蝗旱忧。\n关西归战马，海内卖耕牛。\n元老知谁在，孤臣为尔愁。\n西风吹短发，落日倦登楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺阴君锡封赠","author":"萨都剌","text":"奕世阴家子，居官迈等伦。\n妙年全至孝，馀禄养慈亲。\n致敬归荣早，推恩敕署新。\n綵衣映萱草，日日北堂春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日游鹤林寺","author":"萨都剌","text":"病馀乘野兴，来扣了翁房。\n竹笋迸出地，花枝垂过墙。\n雨声鸣客枕，云气暗僧堂。\n归路马啼滑，风吹酒面凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺丘郡博持敬新修镇江儒学","author":"萨都剌","text":"孔门新壮观，化雨过南徐。\n紫殿风鸣铎，青灯夜读书。\n杏坛翔彩凤，芹沼跃银鱼。\n馆下诸生意，如游小石渠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"花山寺投壶","author":"萨都剌","text":"落日花山寺，秋风铁瓮城。\n野人欢讼简，稚子说官清。\n系马岩花落，投壶山鸟惊。\n兴阑山下路，相送晚钟鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答奎章虞阁老伯生见寄","author":"萨都剌","text":"衮职须公称，江波属我閒。\n宦情鱼鸟畔，德誉董韩间。\n黄阁论思地，金焦放浪山。\n尽操舟泛泛，空忆佩珊珊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中书怀二首 其一","author":"萨都剌","text":"半月闭门坐，萧然远俗氛。\n病中心似水，门外马如云。\n练杵捣寒月，香炉生昼薰。\n兴来览明镜，太瘦小参军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":11367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]