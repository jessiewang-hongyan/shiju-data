[{"title":"雪后荆林道中","author":"圆至","text":"冷风寒柳闭千门，柳外啼鸦聚晚群。\n残日晖晖烘雪气，徘徊半岭作晴云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"小汊","author":"圆至","text":"麻骨灯明竹壁疏，更深人语在茅庐。\n开篷缘岸去沽酒，点火拨船来卖鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"胡卢","author":"圆至","text":"胡卢河畔洗毡裘，日日花香满水流。\n嫁得夫郎爱官职，去随太子取交州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴王庙","author":"圆至","text":"吴王庙近水边山，壁上雕青鬼臂蛮。\n白日炉中烟色变，散成云气满人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宗岳归青莲","author":"圆至","text":"布囊诗几卷，归计亦凄凉。\n不惜经时别，应知聚日长。\n石峰蒸玉气，井水浸莲香。\n曾许为邻寺，招余住竹房。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"逢故人","author":"圆至","text":"共看咸淳上苑花，锦笺綵句敌春华。\n白头相见钟陵市，我亦如君未有家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元夕观傀儡","author":"圆至","text":"锦裆丛里斗腰支，记得京城此夕时。\n一曲《太平钱》舞罢，六街人唱看灯词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"芳塘","author":"圆至","text":"芳塘雨霁绿初肥，折得青条串露归。\n一树残花喧斗雀，红香满径扑人飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄恩以仁","author":"圆至","text":"风柳青青条叶新，别愁江畔又逢春。\n交情似我如君少，一度相逢胜故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对山曲","author":"释英","text":"青山作宾翁作主，山翁持觞山鹤舞。\n山翁对山倾绿醑，青山对翁默无语。\n山本无情翁无心，青山不饮翁自斟。\n酒阑对山抚掌笑，山鹤一声山月沈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夜曲","author":"释英","text":"西风不起凝空碧，霜花霏霏炯秋色。\n层霄辗上玉一轮，竹影参差光欲滴。\n洞房深寂湘簟寒，梦回孤枕疏漏传。\n雁声低度吴天远，素壁青灯瑶穗断。\n隔云听彻五更钟，鸳鸯屏冷初日红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"陌上花","author":"释英","text":"江南三月芳菲菲，杂花生树莺乱飞。\n美人一去几斜晖，城郭空在人民非。\n山河满目草离离，留得歌声落翠微，犹自叮咛缓缓归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"释英","text":"正月梅花落，二月桃花红。\n荣枯元有数，不必怨东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄兰壑宗长","author":"释英","text":"同宗同在旅，彼此系微官。\n所去无多远，其如相见难。\n连云秋树老，卷雪暮涛寒。\n几度空江上，思君独凭阑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客夜有感","author":"释英","text":"十载红尘海，漂流笑此身。\n山川孤馆夜，风雨独眠人。\n嗜茗真成癖，工诗不疗贫。\n还家须及早，垂白有双亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏晚泛湖","author":"释英","text":"杨柳阴中舣小船，芰荷香里耸吟肩。\n雷声惊起云头雨，塔影倒摇波底天。\n群鹭远明残照外，一僧閒立断桥边。\n菱歌袅袅知何处？\n满袖清风骨欲仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿睦州祖师庵","author":"释英","text":"庵依兜率寺，小憩俗心灰。\n竹密暑不到，窗虚风自来。\n山昏飞鹤下，磬断定僧回。\n拂拭残碑看，年深厚绿苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"倪秀才归越","author":"释英","text":"君归何处所，迢递浙江东。\n千里故人别，一尊今夜同。\n客愁灯影外，蛩语月明中。\n潮水将离思，茫茫逐去篷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖上晚步","author":"释英","text":"画桡归去歇笙箫，水影山光共寂寥。\n一叟相逢双鬓雪，向人犹自话前朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游净慈忆沅禅师","author":"释英","text":"慧日峰前阁，重来百感增。\n空存黄面老，不见白头僧。\n道偈书犹在，埋铭刻未曾。\n有诗行已久，何必上传灯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26055,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客夜忆傅森","author":"释英","text":"深夜相思浣水边，情怀堪恨复堪怜。\n云山千里书不到，风雨一楼人独眠。\n蛩带秋声吟壁下，鼠窥灯影山窗前。\n去年记得西湖上，醉倒荷花香满船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26056,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"废寺","author":"释英","text":"白昼閒房一两僧，山门深掩藓花青。\n西风不管钟鱼破，自在斜阳语塔铃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26057,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中景","author":"释英","text":"六月山深处，松风冷袭衣。\n遥知城市里，扑面火尘飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26058,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"径山夜坐闻钟","author":"释英","text":"凉气生毛骨，天高露满空。\n二三十年事，一百八声钟。\n绝顶人不到，此心谁与同。\n凭阑发孤啸，宿鸟起长松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26059,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中二绝 其一","author":"释英","text":"一声山鸟啼，幽梦忽唤醒。\n起来开竹扉，日上中峰顶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26060,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山中二绝 其二","author":"释英","text":"窗前瀑布寒，林外夕阳薄。\n清风何处来，扑扑松花落。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26061,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"胜禅人游庐山","author":"释英","text":"飘然庐岳去，破衲共枯藤。\n此地山林胜，令人肌骨清。\n莲开千柄雪，瀑挂一条冰。\n五老如相见，烦君为寄声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26062,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄刘仲鼎山长","author":"释英","text":"我已浮屠隐，君仍冷掾游。\n向人空说项，何地可依刘。\n风雨残灯梦，关河落木秋。\n近闻吟更苦，应是雪盈头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26063,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"家则堂大参南归","author":"释英","text":"故国衣冠已变迁，灵光此际独依然。\n一身幽蓟三千里，两鬓风霜十九年。\n归去午桥非旧日，梦飞秋塞隔遥天。\n江南遗老如公少，青史名高万古传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26064,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梁秀才南归","author":"释英","text":"交情方脱略，忽尔话归期。\n萍水相逢处，梅花欲寄时。\n蠍多投店懒，马瘦到家迟。\n去去西湖上，春风柳未丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26065,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人还山","author":"善住","text":"偶随流水出，閒趁白云归。\n步石苔侵屐，攀松露滴衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26066,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春兴","author":"善住","text":"冉冉春将暮，悠悠日欲残。\n东风特地恶，不道杏花寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26067,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西斋秋夜","author":"善住","text":"晚雨过江城，西斋秋气清。\n梦回孤枕上，无处不虫声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26068,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋夕","author":"善住","text":"孤馆灯初暗，虚窗月正明。\n寒衣犹未补，风递捣砧声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26069,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早行","author":"善住","text":"拂曙驾柔橹，溪山行几重。\n云昏不见寺，依约但闻钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26070,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨后","author":"善住","text":"小园春雨后，碧草弄轻寒。\n花片无烦扫，新泥尚未乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26071,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬夕","author":"善住","text":"繁草霜严绿减，疏星云尽光寒。\n城头一声画角，月落乌啼夜阑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26072,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"福严即事","author":"善住","text":"村边几株红树，屋外四面青山。\n终日无人能到，孤云薄暮飞还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26073,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄西峰隐者","author":"善住","text":"烟云出没弄晴碧，中有幽人抱禅寂。\n夜半岩间风雨来，松花吹满苍苔石。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26074,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"己未夏日杂兴四首 其一","author":"善住","text":"深红淡白已随尘，斜雨横风送却春。\n池上偶来间照影，霜花吹入鬓毛新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26075,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"己未夏日杂兴四首 其二","author":"善住","text":"落尽红芳见绿阴，小桥流水雨馀深。\n市楼横笛谁家子？\n吹得残阳下远岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26076,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"己未夏日杂兴四首 其三","author":"善住","text":"纤纤碧草与阶齐，浓绿阴中杜宇啼。\n花院昼长听政好，带声飞过粉墙西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26077,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"己未夏日杂兴四首 其四","author":"善住","text":"中庭日午橘花开，蜂蝶何知故故来。\n一阵南薰生殿角，乱飘香雪点苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26078,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春兴二首 其一","author":"善住","text":"朔雁初归花欲妍，江云澹澹晚晴天。\n因思剪烛山窗夜，香烬雕盘尚未眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26079,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春兴二首 其二","author":"善住","text":"三月江南春日长，柳阴庭院午风凉。\n离怀漠漠深于海，燕子飞来语画梁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26080,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感旧","author":"善住","text":"风雨萧萧送暮春，百花开尽草如茵。\n画梁尘锁帘垂地，燕子归来不见人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26081,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过林逸人次韵岩栖翁","author":"善住","text":"花边曾醉少年春，白首相过不厌贫。\n近说汉家徵诏急，西山犹有卧云人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26082,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚兴","author":"善住","text":"浮图寒耸碧崔嵬，烟雨冥濛晚不开。\n深殿已灯门欲闭，松头巢鹤未归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26083,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阳山道中二首 其一","author":"善住","text":"一掬云泉漱齿凉，小亭幽绝背山阳。\n道人自乡峰头住，闭户不知春日长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26084,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"阳山道中二首 其二","author":"善住","text":"雨馀春涧水争分，野雉双飞过古坟。\n眼见人家住深坞，梅花绕屋不开门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26085,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜思","author":"善住","text":"梦鹊惊飞叫不休，声声还绕旧枝头。\n墙东一片梨花月，又逐笙歌上水楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26086,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄岩栖翁","author":"善住","text":"霜髭碧眼老头陁，陋巷曾经几度过。\n连月不来城里住，只缘城外好山多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26087,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻角","author":"善住","text":"晓角吹霜海月斜，一声幽梦断天涯。\n自非贯作沙场客，谁乡风前不忆家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26088,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感事","author":"善住","text":"覆雨翻云事可哀，交情谁是旧陈雷。\n夕阳满地无人见，独立风前看落梅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26089,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人之金陵","author":"善住","text":"清游莫惮路岐赊，但有云山即是家。\n此去凤台明月夜，西风肠断《后庭花》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿报恩寺","author":"善住","text":"凄凉塔庙几经春，往事重思迹已陈。\n夜半梦回禅榻上，不知曾是寺中人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夏日即事","author":"善住","text":"庭树森沈晚色浓，修修寒雨满疏钟。\n白云一片归飞急，知宿城南若个峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵山村先生二首 其一","author":"善住","text":"绿杨深处画桥横，风掠平湖碧浪生。\n待得笙歌城郭去，苧袍筇竹自閒行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵山村先生二首 其二","author":"善住","text":"驿亭枫树著霜红，天际冥冥见断鸿。\n隔岸远山青更好，澹烟斜日值秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴五首 其一","author":"善住","text":"野水浮来半落红，不须惆怅怨东风。\n春归毕竟归何处，还在溪光柳影中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴五首 其二","author":"善住","text":"门掩东风柳色深，暮寒脉脉透衣襟。\n春天最是无凭准，一日才晴一日阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴五首 其三","author":"善住","text":"雨入孤城草木新，香红半逐马蹄尘。\n却怜杜宇无情甚，不解迎春祇送春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴五首 其四","author":"善住","text":"春光欲老绿阴寒，稚笋搀空已作竿。\n无限好山都不见，乱云斜雨满阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴五首 其五","author":"善住","text":"红药花开春欲归，绿杨阴暗燕争飞。\n晚来一阵东风雨，又送馀寒上客衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万里江山图","author":"善住","text":"巴水沄沄巴峡青，月明客泪堕猿声。\n眼中已识瞿唐路，剩水残山懒问名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋兴","author":"善住","text":"几夜西风叶满苔，燕巢空在锁尘埃。\n秋归莫折黄花赠，逗到明年又再来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日杂兴二首 其一","author":"善住","text":"野塘风紧涨涟漪，桃李春寒发尚迟。\n山色晚晴青不了，倚筇忘却立多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日杂兴二首 其二","author":"善住","text":"湘云碎剪作春衣，步入青山映夕晖。\n我已无心事渔猎，野禽何事亦惊飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬日偶成","author":"善住","text":"清霜欲重小春天，杨柳萧疏带晓烟。\n无奈东皇苦多事，又传春信到梅边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感旧","author":"善住","text":"绿杨萧瑟飐秋风，客去门间酒盏空。\n夜半月明生绮席，不知谁在画楼中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暮春杂兴","author":"善住","text":"满地柽阴野水新，粉墙额额有凝尘。\n一双戏蝶来书幌，犹绕残花觅旧春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春杪登苏台","author":"善住","text":"独上高台小凭阑，荒城寂历水云宽。\n连天芳草雨初霁，满地落花春又残。\n白发不生还亦老，青山无事且须看。\n吴王伯业消磨尽，江鸟呼风野树寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟次盘门过无得院","author":"善住","text":"篷窗兀坐听鸣蝉，满目阴云欲雨天。\n山隔坏城悬落日，树连荒驿带苍烟。\n临流石马何年墓？\n种竹人家有钓船。\n至老相寻能几度，更挥青盖访林泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠日本僧","author":"善住","text":"鲸波渺渺接遥空，今古由来一苇通。\n斗柄夜悬常办北，日轮朝涌始知东。\n车书既混文无异，爵服才分语不同。\n乡路眼中应已熟，好携包笠扣玄宗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送日上人还吴淞","author":"善住","text":"秋云秋水两悠悠，白首何堪动别愁。\n代岭月明寒雁过，楚江木落晚禾收。\n夫差既赐申胥剑，勾践难回范蠡舟。\n今古兴亡无限事，愿因归路问沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人还山","author":"善住","text":"茅茨抛在翠微间，即栗横肩又独还。\n松树别来巢鹤大，铜瓶归去蛰龙閒。\n西风黄叶埋寒径，落日青猿叫乱山。\n后夜月明谁是伴，枕前飞瀑响潺潺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人入杭寻弟及谒山村先生","author":"善住","text":"之子难忘骨肉情，远寻仲弟入杭城。\n好山半乡舟中看，佳句多于枕上成。\n驿路牛羊归暮色，江桥鼓角动秋声。\n端淳耆旧今无几，为问湖边老净名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":26112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]