[{"title":"过金山和人韵三绝 其一","author":"耶律楚材","text":"金山突兀翠霞高，清赏浑如享太牢。\n半夜穹庐伏枕卧，乱云深处野猿号。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过金山和人韵三绝 其二","author":"耶律楚材","text":"金山前畔水西流，一片晴山万里秋。\n萝月团团上东嶂，翠屏高挂水晶毬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过金山和人韵三绝 其三","author":"耶律楚材","text":"金山万壑斗声清，山气空濛弄晚晴。\n我爱长天汉家月，照人依旧一轮明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢王巨川惠腊梅因用其韵","author":"耶律楚材","text":"雪里冰姿破冷金，前村篱落暗香侵。\n令人多谢王公子，分惠幽芳寄好音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和王巨川题武成王庙","author":"耶律楚材","text":"商辛自底灭亡期，保障全空聚茧丝。\n谁识华山归马日，易于渭水钓鱼时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又用韵 其一","author":"耶律楚材","text":"不遇知音钟子期，逢人未敢理冰丝。\n年来忘尽悲风操，空忆伤麟叹凤时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又用韵和王巨川 其二","author":"耶律楚材","text":"今年扈从入西秦，山色犹如昔日新。\n诗思远随秦岭雁，征衣全染灞桥尘。\n含元殿坏荆榛古，花萼楼空草木春。\n千古兴亡同一梦，梦中多少未归人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其一","author":"耶律楚材","text":"一曲悲风为子弹，穹庐聊复助清欢。\n自惭未尽桐君趣，老境方知道愈难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其二","author":"耶律楚材","text":"龙庭十载典南讹，再品朱弦韵未和。\n美湩千钟聊当酒，纯音三弄且充歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其三","author":"耶律楚材","text":"今日边城又见君，试弹流水爇梅魂。\n声和塞色金徽润，香散穹庐玉鼎温。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其四","author":"耶律楚材","text":"雅操真堪坐庙堂，积年仁义佐贤王。\n鸣琴谈笑泽天下，始信斯文天不亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其五","author":"耶律楚材","text":"桐孙元采峄阳林，万里携来表素心。\n聊尔赠君为土物，也教人道有知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其六","author":"耶律楚材","text":"年来衰老四旬馀，愿与人间万事疏。\n惟有琴魔降不得，鸣球戛玉彻清虚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤七绝 其七","author":"耶律楚材","text":"知音重遇已忘忧，况复边山七月秋。\n联句弦歌清夜乐，人生适意亦何忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又和景贤四绝 其一","author":"耶律楚材","text":"年来世事已参商，但有声尘尚未忘。\n若向琴中定优劣，龙冈错认老髯郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又和景贤四绝 其二","author":"耶律楚材","text":"抚弄桐君乐自然，寥寥古意讵容传。\n伯牙点检真堪笑，不遇知音便绝弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又和景贤四绝 其三","author":"耶律楚材","text":"幽人寥落思无穷，付与轩昂一曲终。\n欲罢不能行且止，泣麟嗟凤鼓悲风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又和景贤四绝 其四","author":"耶律楚材","text":"接得新诗想笑谈，奇才独步斗之南。\n纵横风月输君手，惟有枯禅不许参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤二绝 其一","author":"耶律楚材","text":"醉时还许醒时无，谚有斯言正谓予。\n未得素鹅白似雪，等闲难与右军书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和景贤二绝 其二","author":"耶律楚材","text":"龙冈才德古来无，敏捷新诗正起予。\n词翰双全妙天下，银钩深似鲁公书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和高冲霄二首 其一","author":"耶律楚材","text":"十里东风渭水春，临风酹月吊英魂。\n直须立事书麟阁，何必题诗寄雁门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和高冲霄二首 其二","author":"耶律楚材","text":"翠华南渡济苍生，垂老将观德化成。\n昨夜行宫传好语，秦川草木也欣荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天山和上人韵二绝 其一","author":"耶律楚材","text":"从征万里走风沙，南北东西总是家。\n落得胸中空索索，凝然心是白莲花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过天山和上人韵二绝 其二","author":"耶律楚材","text":"一入空门我畅哉，浮云名利已忘怀。\n无心对镜谁能识，优钵罗花火里开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过覃怀二绝 其一","author":"耶律楚材","text":"十年寥落隐穹庐，驿使空来好信无。\n再过覃怀觅陈迹，冰魂无恙影扶疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"