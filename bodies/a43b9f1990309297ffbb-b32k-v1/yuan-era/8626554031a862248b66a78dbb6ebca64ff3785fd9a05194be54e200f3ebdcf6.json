tice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄梅出山图","author":"耶律楚材","text":"佛祖不识山中主，良材可惜遭斤斧。\n肩担明月过前峰，一时忘却曹溪语。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦中赠圣安澄老","author":"耶律楚材","text":"一束三人作一团，了无前后亦无偏。\n几乎笑杀庞居士，拟问如何便着拳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋定僧岩","author":"耶律楚材","text":"玉岩三尺碧玲珑，入定僧迷一色功。\n打入无明山鬼窟，不知何日透真空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏探春花用高冲霄韵","author":"耶律楚材","text":"风拂新芳映短墙，典型依约类丁香。\n梅花欲谢渠先坼，消得东君为汝忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄休林老人","author":"耶律楚材","text":"世上元无真是非，丛林禅客自多疑。\n此诗寄向并州去，笑倒休林老古锥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过济源登裴公亭用闲闲老人韵四绝 其一","author":"耶律楚材","text":"一抱青山插碧空，平湖春水碧溶溶。\n裴公亭下千竿竹，撩我诗情得得浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过济源登裴公亭用闲闲老人韵四绝 其二","author":"耶律楚材","text":"珍玉参差照底寒，闲闲佳句继香山。\n湛然不揆真堪笑，也敢题诗列壁间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过济源登裴公亭用闲闲老人韵四绝 其三","author":"耶律楚材","text":"绕垣乔木碧天参，松竹萧萧翳镜潭。\n他日携琴来隐此，林间乞我一禅庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过济源登裴公亭用闲闲老人韵四绝 其四","author":"耶律楚材","text":"碧湖风定水痕平，雪竹幽禽自好声。\n我羡清源高隐士，干戈人世不知兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再用前韵（过济源登裴公亭用闲闲老人韵） 其一","author":"耶律楚材","text":"山接晴霄水浸空，山光滟滟水溶溶。\n风回一镜柔蓝浅，雨过千峰泼黛浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再用前韵（过济源登裴公亭用闲闲老人韵） 其二","author":"耶律楚材","text":"掀髯坐语闲临水，仰面徐行饱看山。\n竹里忽闻春雪落，天教著我画图间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再用前韵（过济源登裴公亭用闲闲老人韵） 其三","author":"耶律楚材","text":"侍中庵底春山色，裴老亭边秋水声。\n修竹茂林真隐地，但期天下早休兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再用前韵（过济源登裴公亭用闲闲老人韵） 其四","author":"耶律楚材","text":"劫外玄机好细参，他年卜筑绕澄潭。\n琴书活计无多子，祗与龙冈共一庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复用前韵 其一","author":"耶律楚材","text":"水影连天天渺渺，山光和水水溶溶。\n一林修竹摇云碧，百亩凉阴蔽日浓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复用前韵 其二","author":"耶律楚材","text":"门外回环皆碧水，庭中坐卧得青山。\n凭栏尽日搜新句，思入烟霞缥缈间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复用前韵 其三","author":"耶律楚材","text":"几时投老谒同参，拟向君王乞镜潭。\n饭了遨游容膝处，裴公亭与侍中庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"复用前韵 其四","author":"耶律楚材","text":"四海干戈尚未平，不如归隐听歌声。\n情知文武都无用，罢读诗书不学兵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再和西庵上人韵","author":"耶律楚材","text":"不在寻求不在参，谁分西北与东南。\n云川试入西庵去，三圣元来共一庵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"请真老住华塔","author":"耶律楚材","text":"华塔丛林久席虚，真公予请肯来无。\n湛然拙偈呈君去，便好携瓶倒上驴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"请王公住太原开化","author":"耶律楚材","text":"大愚不了戾儿孙，开化重兴正赖君。\n便请踏开关捩子，何妨地炙与天薰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和薛伯通韵四绝 其一","author":"耶律楚材","text":"黄花红叶满秋山，月浸银河夜未阑。\n寂寞梧桐深院落，有人何处倚阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和薛伯通韵四绝 其二","author":"耶律楚材","text":"碧山妆点塞天秋，老尽黄花蝶也愁。\n拚醉东篱颠倒舞，人间富贵一何楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和薛伯通韵四绝 其三","author":"耶律楚材","text":"衰年且喜志微伸，镜里惊看白发新。\n何日得游云水去，秋江鸥鹭淡相亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和薛伯通韵四绝 其四","author":"耶律楚材","text":"虚名羁我未能归，羞见冥冥一雁飞。\n拜扫松楸定何日，不堪双泪对君挥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和松菊堂主人照老见寄三诗 其一","author":"耶律楚材","text":"松菊堂中老故人，芝眉重谒我无因。\n林松老节应依旧，篱菊寒英又一新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和松菊堂主人照老见寄三诗 其二","author":"耶律楚材","text":"晋阳相遇亦前因，分手归来迹已陈。\n松菊幽堂应冷淡，与君同话更何人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和松菊堂主人照老见寄三诗 其三","author":"耶律楚材","text":"俊老荼毗四十年，前身是我误相传。\n香山声价喧天下，争似衰翁不会禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]