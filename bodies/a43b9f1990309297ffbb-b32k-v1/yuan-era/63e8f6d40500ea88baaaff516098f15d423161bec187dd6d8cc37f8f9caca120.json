[{"title":"和周景远见寄二首 其二","author":"赵孟頫","text":"止酒陶彭泽，能书王右军。\n逃禅宁辟俗，感旧惜离群。\n泽国茫茫水，霜空黯黯云。\n为农投老去，北望隐思君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉隆福召命赴都过德清别业","author":"赵孟頫","text":"骤喧气候变，幽园卉物凄。\n山云石上起，春鸟雨中啼。\n牵衣怜稚子，举案愧山妻。\n苦被虚名累，未得遂高栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢石林赠湖石次其韵","author":"赵孟頫","text":"怪石曾听法，来从不二门。\n玲珑浮磬韵，斑驳古苔痕。\n池月岩边上，春云水面屯。\n微尔能辍赠，此意向谁论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"胡穆仲先生挽诗","author":"赵孟頫","text":"我有三益友，对之如古人。\n布衣甘陋巷，书册老遗民。\n泪落黔娄被，神伤郭泰巾。\n请为千字诔，书刻上坚珉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠永清曹显祖县尹","author":"赵孟頫","text":"赤县郎官宰，清朝学士班。\n云端双履去，花底一琴间。\n鸿鹄宜天路，骐驎近帝闲。\n会当从此召，岂待及瓜还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠郑之侨","author":"赵孟頫","text":"我有故人子，少年能缀文。\n偏工吟九日，已解赋齐云。\n落落驹千里，昂昂鹤出群。\n却怜吾老矣，须鬓白纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"来鹤亭","author":"赵孟頫","text":"客游真馆日，鹤来玄圃时。\n援笔二大字，欣然千载期。\n长鸣松月照，屡舞竹风吹。\n天路何寥廓，吾与尔同之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李太白酒楼","author":"赵孟頫","text":"城迥当平野，楼高属莫阴。\n谪仙何俊逸，此地昔登临。\n慷慨空怀古，徘徊独赏心。\n峄山明望眼，百里见遥岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵敬父侍御祖德诗","author":"赵孟頫","text":"弃子抱兄子，古来闻邓攸。\n贤哉赵氏母，盛德迈前脩。\n阴骘理须复，高门庆自流。\n诜诜庭下玉，簪笏尽公侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠刘节轩侍御","author":"赵孟頫","text":"骢马人皆避，沙鸥意独閒。\n天恩沾赠典，泉壤慰慈颜。\n乐在箪瓢外，春生杖屦间。\n闻閒且行乐，但恐趣朝班。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题陆振之与閒堂","author":"赵孟頫","text":"一閒天所与，万事世从疏。\n名教有乐地，安心为广居。\n林间听啼鸟，濠上看游鱼。\n意适无馀想，时还读我书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵观复表兄见简 其一","author":"赵孟頫","text":"寒雨何时已，停云不肯开。\n难陪山简醉，空忆谪仙才。\n梅蕊枝枝发，幽禽日日来。\n可能无过我，真复要诗催。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故两浙运使李公挽诗 其一","author":"赵孟頫","text":"昔我閒居日，公来作守时。\n敝庐曾寓止，暇日每娱嬉。\n篆籀传书法，弦歌送酒卮。\n情亲自兹始，岁晚辱深知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故两浙运使李公挽诗 其二","author":"赵孟頫","text":"白发仪刑老，清朝侍从班。\n理财羞聚敛，治郡已恫瘝。\n卧疾留南久，招䰟竟北还。\n向来漳水道，泪落郭西山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张梦符郎中还朝","author":"赵孟頫","text":"侍从班行近，咨谋出使频。\n乘轺山水国，把酒浙江春。\n骢马歌仍在，祥麟德自驯。\n大书诚有法，妙句不无神。\n爱士容疏放，忘年接隐沦。\n回辕瞻斗极，听履上星辰。\n此别真堪惜，兹情未易陈。\n数公如见问，为说混风尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日即事","author":"赵孟頫","text":"今日秋色好，天高景不暄。\n清飙动林薄，凉意满丘樊。\n俗客无因至，幽禽时自言。\n露浓金盏侧，香远玉簪繁。\n谁办东山妓，空馀北海尊。\n莫吟招隐赋，桂树可攀援。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元日朝贺","author":"赵孟頫","text":"阊阖曙光生，觚棱瑞霭横。\n治朝春有象，严跸物无声。\n簪笏千官列，箫韶九奏成。\n彤墀簇仙伏，翠树拂霓旌。\n绝域梯航至，来庭玉帛盈。\n皇图天远大，圣德日高明。\n兵息知仁布，民熙见化行。\n耄倪齐鼓舞，率土共升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉赠平章李相公十韵","author":"赵孟頫","text":"鱼水千年庆，龙云亿载春。\n乾元开泰运，圣主得贤臣。\n画像丹青炳，书题刻画真。\n春宫承宠旧，秋谷赐名新。\n扶日登皇极，经邦赞化钧。\n甘盘基相业，傅说应星辰。\n报国非私已，逢时岂爱身。\n谁能动天子，今复见山人。\n始白诗书效，行看俗化淳。\n硕陈归美意，作诵比丞民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵子俊","author":"赵孟頫","text":"岁云莫矣役车休，蟋蟀在堂增客愁。\n少年风月悲清夜，故国山川入素秋。\n佳菊巳开催节物，扁舟欲买访林丘。\n从今放浪形骸外，何处人间有悔尤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵本斋先生即事","author":"赵孟頫","text":"重揽衣裘敝更宽，徂年欲莫气先寒。\n雨中百草难为绿，霜后黄花尚耐看。\n千古清真耆旧传，半生辛苦腐儒冠。\n便应筑室山阿去，嘉与斯人赋考槃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵帅初","author":"赵孟頫","text":"吴越相望三十年，相逢意气共翩翩。\n长歌白石徒为尔，远访丹砂亦偶然。\n海气昏昏云拂地，江风飒飒雨连天。\n他时别后相思处，欲问山阴雪后船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李元让赴行台治书侍御史","author":"赵孟頫","text":"郎署联班仅一秋，旦同趍省莫同休。\n岂惟官事奔忙共，自觉吾侪气味投。\n骢马只今登宪府，白鸥何日傍沧洲。\n别离不似今朝恶，南望令人生白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘天锡镇守鄂州","author":"赵孟頫","text":"将军好武更敦书，执戟多年卫帝居。\n扈跸惯骑天育马，分符真食武昌鱼。\n弓刀行色寒逾壮，尊酒风流澹有馀。\n江路梅花政堪折，未应便向故人疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送阎子静廉访浙西","author":"赵孟頫","text":"翰林禁近逼青冥，宪节乘骢出帝城。\n海内文章归浑厚，浙西民物望澄清。\n姑苏落日荷花净，震泽秋风橘柚明。\n忆向玉阶承圣语，早归黄阁慰苍生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孟君复信州总管","author":"赵孟頫","text":"君侯弱冠已专城，未许甘终浪得名。\n五马人生真足贵，一毫宠辱不须惊。\n暮云去作江东梦，秋雨无忘蓟北情。\n歌罢风前折杨柳，离觞那忍为君倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追挽宋汉臣副使","author":"赵孟頫","text":"生世怜余后此公，闻人说似涕无从。\n一时文献交游里，十载烟霞杖屦中。\n有子能为先友记，临终方见古人风。\n秋漪亭上残阳色，犹照先生醉后容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钦颂世祖皇帝圣德诗","author":"赵孟頫","text":"东海西山壮帝居，南船北马聚皇都。\n一时人物从天降，万里车书自古无。\n秦汉纵强多霸略，晋唐虽美乏雄图。\n经天纬地规模远，代代神孙仰圣谟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李仲渊求其弟叔行万竹亭诗为赋一首","author":"赵孟頫","text":"闻君有弟多栽竹，邀我题诗寄远情。\n翠碧飞来人政静，凤凰鸣集实初成。\n江波倒影春云合，山月笼阴夜气清。\n我亦有亭深竹里，也思归去听秋声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王氏节妇","author":"赵孟頫","text":"夫妇人伦之大者，夫死宁容有二天。\n矧是簪缨闲姆训，故应诗礼得家传。\n何须断耳徒惊俗，只是持身巳自贤。\n年少寡居今白发，为君重赋柏舟萹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子敬御史志养堂","author":"赵孟頫","text":"志养堂前骢马归，融融喜气动庭闱。\n能令将种为书种，可是斑衣胜绣衣。\n手树丛萱侵雪色，心同寸草报春晖。\n不须更上陈情表，寿母康强世所稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初到济南","author":"赵孟頫","text":"自笑平生少宦情，龙钟四十二专城。\n青山历历空怀古，流水泠泠尽著名。\n官府簿书何日了，田园归计有时成。\n道逢黄发惊相问，只恐斯人是伏生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日送廉访监司赴都","author":"赵孟頫","text":"春回北斗转招摇，使节迎春上九霄。\n官道柔杨有生意，私田细麦长新苗。\n东风河水冰初泮，迟日沙堤雪易销。\n入觐彤廷元会毕，衮衣留相圣明朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘安道指挥副使还都兼寄李士弘学士","author":"赵孟頫","text":"昔来雨雪正霏霏，今去春鸿向北飞。\n王事便应歌杕杜，家人未用叹蛜蝛。\n据鞍横槊军威壮，把酒论文雅志违。\n为问瀛洲李学士，相思何故信音稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惊秋","author":"赵孟頫","text":"泽国西风一夜生，故园乔木动秋声。\n山川满目悲摇落，物色无心得老成。\n下坂牛羊知故道，亲人鱼鸟近幽情。\n向来豪气消磨尽，空对年光浪自惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和邓善之九月雪","author":"赵孟頫","text":"季秋惊见燕山雪，远客淹留愁病身。\n憔悴自伤黄菊晚，横斜空忆野梅春。\n苍松翠柏争擎重，绀殿红楼迥绝尘。\n想得江南犹未冷，嫩橙清酒政尝新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵子敬怀王子庆往吴中","author":"赵孟頫","text":"阖闾城郭填姑苏，吊古登台百感俱。\n秋水远随鸿影没，江云长傍客帆孤。\n吴时花草于今在，晋代风流绝世无。\n别后故人须有得，已应怀宝问归途。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵西云长老赠周仲和","author":"赵孟頫","text":"江南春水碧於天，白鸟沧洲兴渺然。\n刺绣可能如倚市，力田终不似逢年。\n几因莼菜怀张翰，欲把丹砂访稚川。\n才力如君强健在，不妨沽酒醉花前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送萧万户镇阆州","author":"赵孟頫","text":"锦屏山下蜀江清，阆州城南春意生。\n投壶今见诗书帅，树羽遥怜鼓角营。\n远戍固须烦将略，杂耕因足见民情。\n梅花到日应如雪，折取繁枝一寄声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留别沈王","author":"赵孟頫","text":"珍重王门晚受知，一年长恨曳裾迟。\n分瓯共酌人参饮，绕径同看芍药枝。\n华屋焚香凝燕寝，画屏摘句写乌丝。\n吴船万里东南去，采尽蘋花有所思。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"德昌总管雪后见过而余适往德清别业归来承惠诗走笔奉和","author":"赵孟頫","text":"年过五十已无闻，老子犹容醉吐茵。\n短棹冲寒投别墅，朱轓行雪布阳春。\n诗成自可追群玉，笔冻真成秃万㕙。\n且喜丰年多美酒，传杯慎勿厌□巡。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三日后再雪德昌复枉骑见过既而复和前萹见赠辄亦次韵","author":"赵孟頫","text":"夜深万籁寂无闻，晓看平阶展素茵。\n茗椀纵寒终有韵，梅花虽冷自知春。\n使君磊落如天骥，老我堆豗似冻㕙。\n深愧闭门高卧客，枉劳车骑巳三巡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"已酉元日朝拜喜晴总管次前韵见教复和一首","author":"赵孟頫","text":"公庭拜罢笑声闻，晓色曈曈射锦茵。\n元日不阴占乐岁，太平有象兆新春。\n不知何地来银瓮，复报诸方致白㕙。\n四海治安封禅举，岱宗久已望东巡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游乌镇次韵千濑长老","author":"赵孟頫","text":"泽国人烟一聚间，时看华屋出林端。\n巳寻竹院心源净，更上松楼眼界宽。\n千古不磨唯佛法，百年多病只儒冠。\n相逢已定诗盟了，他日重寻想未寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠张进中笔生","author":"赵孟頫","text":"平生翰墨空馀习，喜见张生缚鼠毫。\n韩子未容誇兔颖，涪翁底用赋猩毛。\n黑头便有中书意，黄纸宁辞署字劳。\n千古无人继羲献，世间笔冢为谁高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽洞霄章耕隐","author":"赵孟頫","text":"黄发萧萧瘦骨清，每於谈妙见高情。\n琼浆政欲分丹鼎，霞佩胡为返赤城。\n白鹤归来华表在，碧桃开尽玉棺成。\n师今此去哀难悼，万壑松风共此声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵庞夷简礼部","author":"赵孟頫","text":"故山深处桂阴浓，云碓无人水自舂。\n玉友一尊为老伴，木奴千树当侯封。\n宦途坎壈谋身拙，病骨支离触事慵。\n早挂一帆归去好，五湖烟㬌最情钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢彦威用韵见赠亦复次韵","author":"赵孟頫","text":"东篱紫菊露方浓，西舍黄粱夜自舂。\n蕙帐夜空玄鹤怨，松门无锁白云封。\n图书老去心犹在，朝市重来意转慵。\n岂有高情齐隐逸，政缘多病巳龙钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"论书","author":"赵孟頫","text":"右军潇洒更清真，落笔奔腾思入神。\n裹鲊若能长住世，子鸾未必可惊人。\n苍藤古木千年意，野草闲花几日春。\n书法不传今已久，楮君毛颖向谁陈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题保定杜处士晚翠楼","author":"赵孟頫","text":"楼外山光翠不如，楼中美人老耽书。\n一尊绿酒刘伶醉，几点黄华陶令居。\n虚旷自疑风月近，孤高应与世尘疏。\n他时若到丹梯上，当有清谈一起予。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠张德玉","author":"赵孟頫","text":"张君说易万人誇，幽赞神明断不差。\n动静六爻虽有象，吉凶万变本无涯。\n河图妙在纵横用，皇极曾传一倍加。\n自笑已无疑可卜，有疑来问尔西家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚偶成","author":"赵孟頫","text":"致君泽物巳无由，梦想田园霅水头。\n老子难同非子传，齐人终困楚人咻。\n濯缨久判随渔父，束带宁堪见督邮。\n准拟新年弃官去，百无拘系似沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵杜浩卿咏所藏研","author":"赵孟頫","text":"我生老研日相寻，手不能神谩苦心。\n墨妙巳无王令帖，诗穷空学杜陵吟。\n质温未逊连城璧，气润先知几日霖。\n只有子西知钝体，便应刻此当铭箴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送史总管廉访江东","author":"赵孟頫","text":"历下方誇汉吏循，江东又见绣衣新。\n可能召父专前代，更有萧规俾后人。\n佐理非才常自愧，别离作恶向谁陈。\n何当揽辔从公去，归泛清溪采白蘋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿平章李韩公","author":"赵孟頫","text":"瑞钟光岳应时需，日上天衢手自扶。\n八表同风开寿域，五云异彩映台符。\n经纶至治归贤相，陶冶斯文属大儒。\n为国白头身未老，掌中行见有明珠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鹤归亭","author":"赵孟頫","text":"仙去人间有故亭，四山林竹郁青青。\n隐居真诰传千古，玉局丹文役万灵。\n白鹤归来人换世，黄云翔集夜充庭。\n步虚声转松风响，思掬岩泉洗耳听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34044,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽道士危功远","author":"赵孟頫","text":"处世纷纷一梦同，觉来虚室已成空。\n药垆丹灶尘埃里，羽节琼轮杳霭中。\n素壁尚明秋馆月，青松犹引夜窗风。\n仙家自有逍遥趣，不用悲哀哭断蓬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34045,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送柳汤佐怀孟总管","author":"赵孟頫","text":"河山王屋翠岧峣，玉辇曾临号乐郊。\n老子分符称太守，诸儿骑竹候前茅。\n春苗秋实供厨传，紫笋朱樱入贡包。\n手种成阴千树柳，政成应有凤来巢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34046,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴真人谒告归为二亲八十之寿兼降香名山","author":"赵孟頫","text":"许迈杨羲奕世仙，木公金母共长年。\n斑衣归戏鄱君侧，绛节朝辞玉帝前。\n去去青牛随紫气，飞飞白鹤绕香烟。\n大椿自得人间寿，八十从今数八千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34047,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高彦敬树石图","author":"赵孟頫","text":"乔林动秋风，索索叶自语。\n堂堂侍郎公，高怀政如许。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34048,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题米元晖山水","author":"赵孟頫","text":"澄江漾旭日，青嶂拥晴云。\n孤舟彼谁子，应得离人群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34049,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题孙安之松楸图","author":"赵孟頫","text":"坟墓在万里，宦游今五年。\n人谁无父母，掩卷一潜然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34050,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题太白酒船图 其一","author":"赵孟頫","text":"载酒向何处，稽山镜水边。\n若为无贺老，兴尽便回船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34051,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因禅师挽诗 其一","author":"赵孟頫","text":"先子同年友，唯馀此老存。\n安心得禅悦，闭户道弥尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34052,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因禅师挽诗 其二","author":"赵孟頫","text":"面帝陈三语，还山又几春。\n萧然无世累，卓尔出埃尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34053,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"因禅师挽诗 其三","author":"赵孟頫","text":"朱阁非新构，青松只旧林。\n佛澄今巳逝，无复听铃音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":34054,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]