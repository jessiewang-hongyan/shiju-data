[{"title":"春日行近山 其二","author":"黄镇成","text":"门外山童扫落霞，问师还只在山家。\n推窗引客云边坐，自扇风炉煮雪花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日行近山 其三","author":"黄镇成","text":"天上香风拂彩桥，云霞宫馆郁岧峣。\n行从白鹤山头过，吹动仙人紫玉箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"霁月","author":"黄镇成","text":"寒爱春来暑爱秋，水长山远白人头。\n天时自有清凉日，霁月如银独上楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过福山僧不遇","author":"黄镇成","text":"香积厨边华雨纷，翻经台上柏烟焚。\n不知飞锡游何处，应在天台看白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新城道中","author":"黄镇成","text":"苦竹黄泥十里馀，一村烟雨暗平芜。\n清枫渡口半可涉，无数山禽留客酤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清风逆旅 其一","author":"黄镇成","text":"系马门前日正亭，与君相见问知名。\n感君意气似相识，聊赠木桃将远情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清风逆旅 其二","author":"黄镇成","text":"妾家本在湘江住，湘江水深归路长。\n闻君有便过湘水，凭寄音书还故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田夜雨","author":"黄镇成","text":"四檐春雨夜浪浪，记得吹笙近竹房。\n三十五年江海梦，又随归雁过潇湘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游麻姑偶题","author":"黄镇成","text":"借得丹炉煮石泉，楼居一日近神仙。\n偶然吹笛下山去，又过人间五百年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郑子声画","author":"黄镇成","text":"能画能书郑广文，丹成挥手谢尘氛。\n不知笙鹤游何处，留得潇湘一片云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田耕舍 其一","author":"黄镇成","text":"跨鹤来寻处士家，迢迢空翠隔烟霞。\n山童揖客松边坐，却背春风扫落花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田耕舍 其二","author":"黄镇成","text":"山下云收宿雨凉，一溪流玉自宫商。\n松阴满地苔花湿，坐对炉烟白日长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田耕舍 其三","author":"黄镇成","text":"行到长松野水间，吹箫石上不知还。\n岚光已重衣裳冷，自扣岩扉月满山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南田耕舍 其四","author":"黄镇成","text":"松下携镵采茯苓，一山红叶正纵横。\n因留石上云生处，又听冰崖泻瀑声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题麻姑图有怀蒋师文","author":"黄镇成","text":"曾宿丹霞十二楼，水亭风馆不胜秋。\n故人天上无书到，自展山图看雪流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居春日杂吟 其一","author":"黄镇成","text":"五色云开日上东，腊寒销尽得春风。\n秦人自爱桃源好，新酒家家有醉翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居春日杂吟 其二","author":"黄镇成","text":"白发盈头又得春，自将平日省吾身。\n胸中俯仰无惭怍，度外从天不在人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居春日杂吟 其三","author":"黄镇成","text":"南北东西经乱离，閒思往事只堪悲。\n山中落尽梅花片，同赏春风更有谁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居春日杂吟 其四","author":"黄镇成","text":"平生海岳旧心期，万里风云入梦思。\n今日独从高处望，偶逢林寺一题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"紫云山","author":"黄镇成","text":"甘泽中宵下建瓴，一帘秋意枕边生。\n名山有祷神如在，听取村村打稻声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其一 太极无朕","author":"黄镇成","text":"万里江天欲雪时，石梁斜路枕寒漪。\n山翁拟觅春消息，踏遍青苔未有诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其二 气化有形","author":"黄镇成","text":"吟屋萧疏霜后村，江头千树欲黄昏。\n等閒又被春风觉，添得寒梢月一痕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其三 性质合凝","author":"黄镇成","text":"携杖来寻碧玉泉，千林红叶晚霜天。\n何人写得琴中意，尽在疏枝浅水边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其四 风神全具","author":"黄镇成","text":"曾向燕云画里誇，孤山流水断桥斜。\n祗今残雪疏篱外，始见江南第一花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其五 含春待放","author":"黄镇成","text":"行到湖边处士家，春风篱落近晴沙。\n应将綵笔题新句，直待满林飞雪花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其六 得月齐开","author":"黄镇成","text":"幽芳一点无尘到，况是月明霜夜深。\n怪得阳春满天地，溪桥千树玉成林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其七 疏影横烟","author":"黄镇成","text":"霜姿月骨夜棱棱，亦有轻烟一带横。\n聊似染空成淡影，幽香不减向来清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其八 寒枝压雪","author":"黄镇成","text":"雪枝擎重为花惜，怯冷应开春色中。\n劲节始知金断日，岁寒终谢玉成功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其九 敛华就实","author":"黄镇成","text":"山亭流水雨初歇，杨柳桥头花正飞。\n直待清阴成子日，与君携酒送春归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅花太极图十首 其十 待用调元","author":"黄镇成","text":"凝姿已得木味正，鍊粹复专阳德纯。\n大用悉归调鼎实，生生无尽一腔仁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春感兴 其一","author":"黄镇成","text":"风雨生寒七日春，梅花落尽杏花新。\n欲谈旧事推时变，无复当年行辈人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春感兴 其二","author":"黄镇成","text":"生际华夷混一年，老从耕凿遇尧天。\n春和着物皆生意，岂是乾坤雨露偏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春感兴 其三","author":"黄镇成","text":"一室虚明白昼閒，图书左右坐中间。\n嗒然隐几无人到，身在白云深处山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早春感兴 其四","author":"黄镇成","text":"石壁山前春水生，畬田雨后课僮耕。\n交游半是渔樵客，使者无烦问姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜听雨有怀 其一","author":"黄镇成","text":"孤客曾听夜雨眠，一生江海已华颠。\n吟怀不与春风隔，漫忆檐声五十年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜听雨有怀 其二","author":"黄镇成","text":"天地飘飘老此身，一怀幽思为谁伸。\n春来犹有登临趣，拟向山中觅故人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春夜听雨有怀 其三","author":"黄镇成","text":"天上仙人玉笋班，殷勤赠我翠琅玕。\n相逢不复伤迟暮，知己能倾一语难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿武夷","author":"黄镇成","text":"秋日停车宿武夷，石坛云馆近天梯。\n几时来此山中住，结个松巢伴鹤栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李中明秋山小景","author":"黄镇成","text":"家住夕阳三峡口，人行秋雨二崤间。\n不知何处真堪画，移得柴门对楚山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山家四首 其一","author":"黄镇成","text":"十里南田去郭赊，不因无事却移家。\n才分宿火添香炷，又酌山泉煮茗华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山家四首 其二","author":"黄镇成","text":"家住桃花源上村，编松为屋鹿为群。\n匡床尽日临门坐，閒看青山起白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山家四首 其三","author":"黄镇成","text":"野衲来栖半屋云，一单犹贮贝多文。\n问他城郭山林事，手数轮珠默不闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山家四首 其四","author":"黄镇成","text":"石洞悬流泻碧崖，石桥幽磴抱云回。\n樵人共我山头看，知是吹笙跨鹤来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李氏甥彦博所藏枯林兰石","author":"黄镇成","text":"幽芳冉冉路云深，白石沧江见此心。\n零落佳人在空谷，自弹秋月寄瑶琴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻鸡","author":"黄镇成","text":"曾催月影到寒窗，又促征车拂晓霜。\n湖海故人今白发，五更孤枕泪浪浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秦原岭","author":"黄镇成","text":"山行尽日不逢人，五里松风十里云。\n还有道家烧药处，时时笙鹤半天閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和周凌云秋日光邑山行韵","author":"黄镇成","text":"闽岭秋深水树凉，原田耕穫岁时忙。\n无人画得农家乐，雨过青疏白稻香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠染笺周方大","author":"黄镇成","text":"曾见东溟涌日轮，霞流丹穴锦回文。\n蓉城昨夜西风壮，捲入春膏五色云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠海中所藏顾定之竹","author":"黄镇成","text":"凯之遗墨在人间，风起萧萧万叶寒。\n何日携琴踏青藓，雨华台上听琅玕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方壶墨竹","author":"黄镇成","text":"方壶仙人洒香墨，矛戟纵横八法中。\n青鸾舞罢秋水阔，珊珊飞佩凌天风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宪掾孟伯真","author":"黄镇成","text":"杜老题诗不到闽，千年风物迹犹陈。\n即今海内传新句，直待邯郸孟伯真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄月潭","author":"黄镇成","text":"平生山水最相亲，蜡屐长随野鹿群。\n未似月潭双足健，东南踏遍万重云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其一 五曲精庐","author":"黄镇成","text":"歌棹曾穷九曲源，精庐迢递隐屏前。\n閒寻五曲樵溪上，三十六峰秋满船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其二 万峰梵刹","author":"黄镇成","text":"云馆高车最上峰，遥林清逼翠微宫。\n下方尘土不可到，五色日丽扶桑东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其三 石鼓松风","author":"黄镇成","text":"蛟鼍斫断藓痕斑，万壑萧萧响佩环。\n溪馆梦回山月冷，满天秋影韵珊珊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其四 丹台梅月","author":"黄镇成","text":"羽客丹成去此台，独闻笙鹤夜归来。\n几回欲问台边月，晴雪梅花冷自开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其五 北桥春舫","author":"黄镇成","text":"北桥桥下春水生，画桡两两蛟龙争。\n晚风楼畔珠帘捲，倚棹何人听玉笙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其六 西塔暮钟","author":"黄镇成","text":"山外斜阳紫翠浮，相轮无影半空秋。\n晚钟吹落人间去，一抹青烟澹未收。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其七 樵岚秋稼","author":"黄镇成","text":"樵溪水出莲花山，平畴䆉稏白云寒。\n田家太平岂有象，社酒鸡豚常尽欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"樵阳八咏用陈教和周东圃韵 其八 熙春朝阳","author":"黄镇成","text":"会景亭西晓独登，晨曦一上万山清。\n满城桃李春如绣，人在金鳌顶上行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其一 君山霁雪","author":"黄镇成","text":"谁把琪花散碧霄，千岩万壑总琼瑶。\n支颐正好吟诗句，莫遣东风一夜消。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其二 仙冈暮霭","author":"黄镇成","text":"霏霏暝色满山城，隐隐岩扉带晚晴。\n试问仙人何处是，数声樵唱不胜情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其三 九峰晴旭","author":"黄镇成","text":"朵朵芙蓉倚碧天，溪光岚影蔼晴烟。\n望中佳致堪图画，疑在匡庐五老前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其四 七里春涛","author":"黄镇成","text":"滚滚桃花浪拍空，茫茫东去势何雄。\n禹门三级浑如许，应有潜鳞此化龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其五 云岩书灯","author":"黄镇成","text":"曾伴先生共夜阑，时留馀燄在云端。\n自从折桂蟾宫去，剩馥残膏几岁寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其六 月庵钟鼓","author":"黄镇成","text":"雪满长空月满楼，鼓钟声里夜光浮。\n悬知老衲无馀事，长祝皇图亿万秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其七 乌洲渔唱","author":"黄镇成","text":"扁舟一叶任西东，烟水微茫处处同。\n钓罢归来无个事，数声欸乃夕阳中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杭川八景 其八 龙滩棹歌","author":"黄镇成","text":"潺潺石滩急如弦，灵物曾从此处眠。\n最是短篷烟雨里，长歌一曲水连天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢子安之江右求葬师 其一","author":"黄镇成","text":"千里间关觅葬师，青山多在白云西。\n秋风满道吹红叶，何处逢人问楚溪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢子安之江右求葬师 其二","author":"黄镇成","text":"家在烟岚五县间，碧榕桥下水潺湲。\n朝来雨过秋如洗，写出江南一幅山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题牛背醉归图 其一","author":"黄镇成","text":"社散田头日欲晡，平坡烟暖草如铺。\n醉来祗坐乌犍背，归去花村不用扶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题牛背醉归图 其二","author":"黄镇成","text":"岁久携家住白云，春风行乐任天真。\n颓然醉貌衣冠古，应是鹿门山下人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云山小景","author":"黄镇成","text":"飞瀑潺潺泻碧岑，野桥分路入云深。\n三椽草屋长松下，应有先生抱膝吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题乌江庙","author":"黄镇成","text":"五色龙文应汉王，项家徒用力争强。\n不知麾下无人杰，卷土重来亦是亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱清坝","author":"黄镇成","text":"父老何知太守贤，宵无尨吠即安眠。\n当时不作归装累，更莫轻持一大钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"于越","author":"黄镇成","text":"沃土连云富稻粱，十年生聚信能彊。\n扁舟不见鸱夷面，独上高台吊越王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"会稽山","author":"黄镇成","text":"安邑茫茫宅上都，东南万里播銮舆。\n遥观禹穴云如海，玉帛缤纷上计书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柯亭","author":"黄镇成","text":"金碧楼台宅梵王，柯亭无处问中郎。\n何当截取如椽干，吹起昆丘紫凤凰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":15513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]