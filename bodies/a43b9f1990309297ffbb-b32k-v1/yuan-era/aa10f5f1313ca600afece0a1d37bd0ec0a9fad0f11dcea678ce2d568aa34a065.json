[{"title":"团扇词","author":"朱晞颜","text":"吴纨一尺秋霜寒，冰绡⽟麈裁合欢。\n团团素影落怀袖，何人月下乘青鸾。\n二八佳人秋水色，提携未忍轻抛掷。\n閒寻小草戏流萤，儿家庭树秋风生。\n秋风萧骚日夜来，明年何处荷花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺先上人奉母归乡","author":"朱晞颜","text":"早岁孤迎养，庭闱草自春。\n那知清野久，却喜白头新。\n楚水寒摇锡，蛮花净熨巾。\n怜君辛苦意，羞杀倚门人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"经芜湖","author":"朱晞颜","text":"平芜连楚甸，古县接通津。\n酒色澄江雨，茶香客焙春。\n鱼盐通远贾，鹅鸭共比邻。\n昨夜乡山梦，长吟到白蘋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"普照寺晚步","author":"朱晞颜","text":"晚凉閒散策，一径入松深。\n每到钟鱼地，便生泉石心。\n水花香晚殿，凉月堕空林。\n后夜相思梦，怀君倚柱吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独客二首 其一","author":"朱晞颜","text":"独客筠江上，嚣然傲世纷。\n市喧趋旦合，帆影过桥分。\n仕与贤愚滞，名因课利昏。\n高安有遗迹，莫惜访前闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独客二首 其二","author":"朱晞颜","text":"世路艰于棘，生涯兀似禅。\n尚牵诗酒债，未断簿书缘。\n役役徒千里，悠悠付百年。\n何时脱羁絷，一棹浙江边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别蕲县尹二首 其一","author":"朱晞颜","text":"渐老难为别，江亭首重回。\n风尘头共白，湖海气全灰。\n我岂千金帚，君非百里才。\n试将遮日手，一棹载诗来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别蕲县尹二首 其二","author":"朱晞颜","text":"吹箫台上客，来此惜分携。\n别泪多兼酒，行囊半是诗。\n篮舆乘晓月，野饭煮秋葵。\n应忆栖栖者，山阳夜笛悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"瓜洲","author":"朱晞颜","text":"古驿临官渡，人烟聚一墟。\n江分南北限，山断圣凡居。\n落日孤飞鹜，寒潮逆上鱼。\n乡关何处所，城郭带烟芜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋色","author":"朱晞颜","text":"微吟愁独客，马上思纷纷。\n古道下黄叶，空山生白云。\n轻烟浮宿霭，凉雨澹斜曛。\n望入苍茫外，西风黯不分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠周可竹","author":"朱晞颜","text":"凋丧兵戈后，清淳簿领前。\n老将琴作伴，閒与酒为年。\n俗眼多嗔白，君心独守玄。\n惟应松下客，相见故依然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴兴杂咏","author":"朱晞颜","text":"吴兴山水窟，清远古今闻。\n水入孤城合，山来别县分。\n寒川明野烧，晓碓湿溪云。\n试买乌程酒，微馨透客醺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金山寺","author":"朱晞颜","text":"江山清绝处，一刹涌青莲。\n门挹吴山翠，堂凝楚岸烟。\n金银开世界，龙象护人天。\n晴耸危梯直，阴穿古洞连。\n妙香清五蕴，胜境断诸缘。\n晓雨龙听讲，秋风鬼唤禅。\n廊深僧呗合，山匝寺钟圆。\n怪石虬蟠墓，惊涛雪溅船。\n宗乘湖海集，诗老古今传。\n地尽东南坼，江空象纬悬。\n青冥知有路，爽气欲无前。\n唤起乘槎兴，清辉近斗边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张伯雨寄揭曼石学士时揭奉旨祀岳渎留杭丐老","author":"朱晞颜","text":"昭代频纡眷，严祠侈报功。\n名山登异数，盛选属明公。\n雅志甘投散，新诗益启蒙。\n乾坤钟间气，湖海挹高风。\n剩喜词臣旧，还欣地位崇。\n归桡先顺济，予告亦留中。\n李令千奴富，相如四壁空。\n那知心暗折，转觉鬓先蓬。\n翰墨追遗老，江山迟此翁。\n鹤归横碧海，花发上离宫。\n故国人怀楚，仙都客自洪。\n君如滨寂寞，谁复起疲癃。\n落落真堪数，堂堂讵可攻。\n二疏增汉重，五鬼固韩穷。\n年至宁繁事，官优岂厚躬。\n春山乘款段，晓枕唱玲珑。\n娱老书千帙，归休屋一丛。\n重逢千里异，近别十年匆。\n技短株难劂，音希叩必鸿。\n已应惭宋玉，一赋大王雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和梅村方州判元日早朝韵","author":"朱晞颜","text":"凤历初颁又建正，千门队仗蔼欢声。\n风生翠隼旌旗合，日转苍龙观阙明。\n北极星辰趋玉几，西池仙子进霞觥。\n远臣亦解相如赋，愿列词官窃宠荣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日试笔呈元播府推时举经历 其一","author":"朱晞颜","text":"泥牛击罢晓寒轻，春满黄堂碧玉觥。\n衰齿已应怜饼餤，老怀犹自惜歌声。\n綵鞭争道尘初动，画鹢浮江水暗生。\n惭愧监官苦羁絷，东轩坐觉岁峥嵘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立春日试笔呈元播府推时举经历 其二","author":"朱晞颜","text":"东风一夜泮冰澌，晓日移春上故枝。\n朱户泥金题翠墨，玉盘纤手弄青丝。\n老将岁月销衰鬓，閒与江山觅好诗。\n剩办春晴供胜集，从今挑菜不须迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简赵仲时","author":"朱晞颜","text":"不用区区叹陆沉，古来才大亦难任。\n且须自宝连城璧，莫为人疑跃冶金。\n宫锦色繁春仗丽，天书光烂夜堂深。\n他年诏直层霄上，应有青藜识此心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简王奉礼","author":"朱晞颜","text":"世系名门礼数娴，妙年声望耸朝端。\n玄丘夜直金镛静，丹陛春朝玉佩寒。\n喜溢天颜承雨露，名通仙籍簉鹓鸾。\n自怜饥死东方朔，愿乞馀甘窃大官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次李竹所先辈韵","author":"朱晞颜","text":"忆昔南宫角俊游，高名何事间陈楼。\n汉廷素擅无双誉，兰省今推第一流。\n吟策追随梅涧晓，书灯深窈竹房秋。\n遥知近注潜夫论，应是斯人可得俦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴叔巽赴湖州录事","author":"朱晞颜","text":"汉廷策第拜殊恩，一日声名四海闻。\n黄甲共推名进士，青衫独识老参军。\n唫鞭细袅清苕雪，游屐閒穿古弁云。\n从此风流多胜集，好将馀论起斯文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贽管文秀博士","author":"朱晞颜","text":"簪裙缓引步龙楼，每得鸣珂侍宴游。\n银笔从横裨献纳，玉堂清近接风流。\n昼帘花静琴心远，午枕香残草梦幽。\n盛业只今烦润色，先声已到凤池头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠松间张内舍","author":"朱晞颜","text":"德业由来裕后昆，笙竽应不羡高门。\n佳儿足付万金产，寒士时怀一饭恩。\n近为云山通井臼，每因水竹置琴樽。\n孙登肯愧淮南客，吟啸逢君未足论。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠娄贤佐","author":"朱晞颜","text":"东吴望族君家最，倒指风流尽逝波。\n绿野池台春草遍，古槐门巷暮蝉多。\n诸郎冷落传缃素，故老依稀说佩珂。\n独有玄成经术在，骁腾无计柰君何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄刘云庄","author":"朱晞颜","text":"忆向江湖诵子虚，锦囊初见出骊珠。\n穷途剩喜逢佳士，小伎终惭谒大巫。\n四壁愁吟蛩对语，一灯清影鹤同孤。\n采诗问字俱吾事，还许乘閒载酒无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"呈学士张师道","author":"朱晞颜","text":"紫鳌云气欲飞骞，粉署高邻尺五天。\n秋月新窗寒贮玉，晓风宫殿翠生烟。\n赤墀独奏三千字，银笔閒题九万笺。\n共说丝纶专世美，几回夜直赐金莲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"呈鲁子翚学士","author":"朱晞颜","text":"衰迟谁复念陈人，一室聊堪信屈伸。\n自笑赤贫难使鬼，那知拙宦不谋身。\n十年风雨江湖梦，千里家山笋蕨春。\n曾向南州拜高节，归来丘垄倍思亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游宝叔塔下方和季子奇韵","author":"朱晞颜","text":"楼阁参差鹫岭青，松杉依约纪经行。\n半篙春水斜穿屋，一带苍山远入城。\n此地钟鱼真警俗，平生泉石最关情。\n好风一晌吹薝卜，顿觉庐能鼻观清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"呈山斋卫治中","author":"朱晞颜","text":"画绣争看负弩驱，先声自昔满乡闾。\n传家旧有堆床笏，知己今惟一束书。\n夜月灯前闻鹤后，秋风江上忆鲈初。\n到头藏用须由命，且莫区区叹术疏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张同知安溪留题","author":"朱晞颜","text":"古驿荒凉小似舟，解装随分此淹留。\n风前残杵敲乡梦，雨底寒灯照客愁。\n山接重冈循县转，潮回暗水入河流。\n世间名利真何物，投老驱驰可自由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简杨仲弘院长归思","author":"朱晞颜","text":"慷慨樽前抚剑歌，自怜侠气半消磨。\n不惟游子青衫薄，无奈高堂白发多。\n东阁梅寒清入思，南湖雨暖绿生波。\n一春折尽刀头梦，欲向玄真觅钓蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书况 其一","author":"朱晞颜","text":"十载风尘倦往还，细看巾帽一汍澜。\n愁多白发三千丈，路折青泥百九盘。\n丘嫂漫嗤仪舌在，故人谁惜范袍寒。\n天涯多少驱车客，不信人间行路难。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书况 其二","author":"朱晞颜","text":"老去身慵忆壮游，尊前无计破牢愁。\n青衫不掩功名泪，白发难藏富贵羞。\n风雨可堪鸡废职，稻粱那计雁为谋。\n因思自鬻于秦者，何事当年乐饭牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源古宫","author":"朱晞颜","text":"步入烟霞缥缈间，恍疑身已脱尘寰。\n风生万壑喧仍静，云出层峦去复还。\n世上几更新历日，洞中犹是旧溪山。\n留侯不作避秦举，到底赤松相与閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"碧落堂","author":"朱晞颜","text":"岗势萦回入缭垣，坡陀崇级上攀缘。\n八窗空阔浑无暑，一罅高寒别有天。\n隐隐佩环迷洞府，悠悠钟鼓隔山川。\n我来俛仰嗟陈迹，浪说仙家八百年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"会丘静山","author":"朱晞颜","text":"投鬣何年溯北溟，相逢把臂话平生。\n故山路远难为别，上国才多易得名。\n短褐风霜纫紫凤，长钩尘土结青萍。\n男儿一掬英雄泪，莫向西风恨不平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鄞县半山亭和郑宣使韵","author":"朱晞颜","text":"曾向钟山酹夜台，几因登览首频回。\n高人已逐飞凫去，此地还应化鹤来。\n古碣迷漫横断草，閒花颠倒卧苍苔。\n我来俛仰成今古，分付城头角自哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄郑天趣","author":"朱晞颜","text":"谁道分司此避乖，一轩安止信悠哉。\n庭无抱案丞何负，吟有诗盟郑不来。\n列屋堆银排夕浪，明珂映玉破寒梅。\n相逢对饮须成醉，莫问春风几日回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽水云居士","author":"朱晞颜","text":"天才矫矫欲干霄，试捷东还王气销。\n处士衣冠栖别业，名门谱牒记前朝。\n寻松访竹诗题在，占水分云鹤梦遥。\n好觅丰碑旌隐节，大书琬琰上岧峣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简袁晞颜都事","author":"朱晞颜","text":"清时簪绂尽英游，才业如君第一流。\n珥笔早曾趋左辖，封章每得近前旒。\n纵横伧父三都赋，慷慨元龙百尺楼。\n海内正须烦卧治，莫将清兴到沙鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"侍老人种松","author":"朱晞颜","text":"桃李春场一閧空，暮年心事只青松。\n饱知桤木三年大，绝厌花枝百日红。\n岁晚风霜坯屈蠖，夜深笙鹤度天风。\n他时愿结鸡窠伴，为问岩前十八公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋屏阁","author":"朱晞颜","text":"閒来倦足凌飞磴，试倚危栏眼为舒。\n落日空明金破碎，轻云点染翠扶疏。\n凄凄远笛归人暮，漠漠平沙去鸟孤。\n何事斯游嗟独晚，春江恰值雪晴初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"首夏会饮奉酬晴山晴川二先生见惠之什","author":"朱晞颜","text":"积阴连闰过芳春，气转清和物候新。\n信美江山非我土，绝怜天地老斯人。\n曲中有误周郎顾，琴上无弦陶令真。\n自愧不才床下拜，底知孰主孰为宾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"追送唐子华照磨之任嘉禾","author":"朱晞颜","text":"才华秀发蚤诜诜，大府宜君被选抡。\n天下昔曾陪画史，幕中今喜得诗人。\n清时事业行将见，诸老风流迹未陈。\n何日鸳鸯湖上水，相期一洗簿书尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食感兴","author":"朱晞颜","text":"春事骎骎欲向阑，病夫随分为凭栏。\n愁怜甚雨花多瘦，老觉殊乡食更寒。\n两屐晴泥妨醉策，一溪春水足渔竿。\n年来触物多悲感，莫向垂杨陌上看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题岘山亭","author":"朱晞颜","text":"青山缭绕倚丛台，名迹空存尽草莱。\n岘首有碑空堕泪，门前无客且衔杯。\n春晴鱼鸟从人乐，日暮牛羊下垄来。\n相对欲谈今古事，野僧一笑领花开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登楼晚眺","author":"朱晞颜","text":"独客乡心被酒收，和愁分付上层楼。\n西风永巷孤砧晚，落日空江一笛秋。\n紫翠回还山作县，青黄点染橘成洲。\n狂游自笑君兼我，悔不睢阳二顷谋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"调饶汉军教授","author":"朱晞颜","text":"青衫何事尚尘泥，久客人情自惜归。\n亲老已知为客误，家贫未是读书非。\n楼空晓雨浮吴远，笛冷秋云渡浙稀。\n十载长安资桂玉，东风老尽故山薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨梅和蒋远静来韵","author":"朱晞颜","text":"的皪筠笼晓露濡，病中初见气全苏。\n风酣鹤顶寒生粟，日炫龙睛怒迸珠。\n不比金樱擎翠笼，还同朱李荐芳壶。\n才疏羞对君家果，还有当年捷对无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和张州尹节饮食诗韵","author":"朱晞颜","text":"扰扰人生百岁强，自须饮啄济身康。\n熊鱼未必能兼欲，藜藿何尝有别肠。\n澹泊存心惟味道，肥甘适口或罹殃。\n万钱一箸真同饱，未数何曾得计长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏简袁德平山长","author":"朱晞颜","text":"年来破砚不谋身，颇喜今朝饭瓮新。\n独客不须书咄咄，诸生应复颂陈陈。\n一官己厌獐头相，三釜终怜鹤发亲。\n莫为清香生怨泣，使君应念乞墦人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游四明山杖锡寺","author":"朱晞颜","text":"痴儿公事退还休，拄策仙岩最上头。\n莫但驱车行偪仄，且须橐笔赋深幽。\n百年古木缘云立，五月惊雷破峡流。\n试扫苍崖看藓迹，昔人曾有记游不。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拱北楼","author":"朱晞颜","text":"屹立东南一柱齐，悬空栱桷尽翚飞。\n雄吞二景开黄道，远接三辰入紫微。\n春树已随辽鹤返，秋云不隔塞鸿归。\n长安只在蝉蜒处，莫向西风赋落睴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆旧游","author":"朱晞颜","text":"云边回首忆清游，信美江山有此楼。\n杂遝市声还岸曲，参差帘影入江流。\n西风断雁孤城暮，衰柳残蛩候馆秋。\n愧我东轩尘拍塞，危阑何日与君俦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次陆撝谦瓶梅韵","author":"朱晞颜","text":"陇使殷勤寄折枝，冰人犹带故人诗。\n楸枰有著花频落，棐几无尘影倒移。\n香透吟魂窗蝶绕，愁凝妆额镜鸾知。\n多情莫厌春无赖，看到青青子结时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冷泉","author":"朱晞颜","text":"一泓湛碧气凝秋，转石来从鹫岭陬。\n六月地寒无死脉，九天风静有飞流。\n净涵阑影衣初湿，远夹松声耳更幽。\n最爱泠泠供客醉，几人著意到巢由。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅魂 其一","author":"朱晞颜","text":"幽香和恨结冰枝，栩栩翻疑冻蝶知。\n几度春风寒不化，一规霜月冷相窥。\n醉迷驿树青禽在，怨入胡沙佩玉遗。\n爇尽奇熏招不返，自吟哀些酹清卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅魂 其二","author":"朱晞颜","text":"芳心元不为春劳，脉脉离愁黯欲销。\n一种幽情骚不挽，百生清怨笛难招。\n静依淡月临江驿，暗逐寒云度石桥。\n蕙歇兰衰悲吊影，空山千古恨寥寥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"简茂枯林上人","author":"朱晞颜","text":"老去逢迎入郭稀，相看还觉故吾非。\n三生忆我参同梦，一著输君落钝机。\n岁晚鸥波烟水阔，秋高雁渚稻粱肥。\n重来应被梅花笑，谁为缁尘涴素衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"跋茂枯林集句题东坡画像","author":"朱晞颜","text":"秀毓峨嵋德望高，风流元是玉堂豪。\n冥鸿匹对天边鹄，痴虎精神颊上毫。\n生气百年存大节，哀歌九些续馀骚。\n紫云饭饱秋堂寂，一穗炉熏对和陶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋马思琵琶研","author":"朱晞颜","text":"眉子空颦病眼羞，谁将雅意曲中求。\n剩裁汉月传宫样，远割溪云写塞愁。\n切切小弦玄墨雨，庚庚横理紫筠秋。\n平生不解移宫羽，空伴书萤死案头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼马毙二首 其一","author":"朱晞颜","text":"忆从按辔试初程，振鬣风前听一鸣。\n小队郊迎争騕袅，短衣野猎任纵横。\n晚凉柳下亲看洗，夜后槽间仆代更。\n谁信死生难倚托，敝帷一见惜深情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼马毙二首 其二","author":"朱晞颜","text":"昨宵中厩失羸骖，腰脚虽顽信不难。\n有竹不妨门可款，无车何事铗空弹。\n花间小集追联辔，月下微吟忆据鞍。\n好乞赢钱买驽蹇，老夫端要遂巡官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]