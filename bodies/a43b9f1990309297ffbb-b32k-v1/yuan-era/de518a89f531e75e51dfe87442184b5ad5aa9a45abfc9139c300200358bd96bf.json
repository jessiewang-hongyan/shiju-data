[{"title":"句","author":"刘应凤","text":"天留仲子继孤竹，谁向西山饭伯夷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32258,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"高晞远","text":"豪气欲吞天下士，冷官初到岳阳城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32259,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题汪水云湖山类稿","author":"李珏","text":"天地事如许，英雄鬓已斑。\n泪添东海水，愁压北邙山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32260,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭主簿模摩诘本辋川图卷","author":"李珏","text":"园图亲画早流传，已是人间五百年。\n凝碧池头秋句在，当时几负此林泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32261,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李珏","text":"此水自当兵十万，昔人曾有客三千。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32262,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"林月香","text":"楚人一缕垂亡命，尽向秦庭哭得回。\n六国既亡秦一统，如何却道帝秦非。\n那知老子痴顽福，曾见官家历五朝。\n可怜几幅通神画，只入桓玄夹袋中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32263,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书壁","author":"莫崙","text":"又得浮生半日閒，忽闻春尽强登山。\n因过竹院逢僧话，终日昏昏醉梦间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32264,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"废家子孙诗","author":"金方所","text":"兴废从来固有之，尔家忒煞欠扶持。\n诸坟掘见黄泉骨，两观番成白地皮。\n宅眷皆为撑目兔，舍人总作缩头龟。\n强奴猾干欺凌主，说与人家子弟知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32265,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"项平父","text":"日长沙岸立，看云只念家。\n如何永州梦，偏爱在长沙？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32266,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金鳌山","author":"于演","text":"金鳌之山金碧浮，重玄宝坊居上头。\n钟声夜度海门月，树色远揽丰山秋。\n龙伯国人真妙手，掣此巨灵镇江口。\n丹丘逸士来跨之，石洼为尊江当酒。\n黄须天子七宝鞭，黄头渔郎棹江船。\n百年尘迹果何在，芒砀云去山苍然。\n历试诸难固天造，中兴开国何草草！\n腹心有疾日月昏，英雄无声天地老。\n两宫不归汴水流，此地空传帝子游。\n惜无健笔驱风雨，一洗江山万古愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32267,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闵项氏","author":"李宗冽","text":"少无依倚老何堪，白发婆娑乱不簪。\n梦里尚思江北好，悔将夫骨葬江南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32268,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岳王墓","author":"徐孟岳","text":"童大王回事已非，岳将军死势尤危。\n直教万岁山头雀，去绕黄龙塞上旗。\n饮马徒闻腥巩洛，洗兵无复望条支。\n湖边一把摧残骨，盖世功成百世悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32269,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答内","author":"吴仁叔","text":"一幅空笺聊达意，佳人端的巧形言。\n贤妻若也投科试，应作人间女状元。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32270,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽张伯成","author":"吴伯庆","text":"何处重逢说别时，斯文千载尽交期。\n学怜知己先登早，生愧同庚后死迟。\n笺疏空令传杜律，志铭谁与继唐碑？\n寡妻弱子将焉托，节传遗文只益悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32271,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鞦韆","author":"杨鹏翼","text":"日转华檐树影偏，谢家庭院簇神仙。\n綵绳斜擘纤纤笋，画板轻承步步莲。\n弄玉未升云汉上，绿珠先坠舞楼前。\n不知小径残红里，明日何人拾翠钿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32272,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张明","text":"春风跨马银鞍稳，夜月骑牛铁笛閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32273,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"侯友彰","text":"万钱终有命，遗汝不如廉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32274,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"何有成","text":"曾有仙人双白鹤，可无老子一青牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32275,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题南雄花林院","author":"刘渊","text":"花落春已暮，门开白云来。\n阶前一片石，风雨留莓苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32276,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"郭正平","text":"灞桥柳絮人千里，楚泽芦花水半扉。\n身卧不知云子白，气酣聊作木奴酸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32277,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题第一山","author":"文若","text":"汴水东流绕旧京，恢图妙算入皇明。\n暂携诸将停归骑，来看中原第一城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32278,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋山小景","author":"李明中","text":"家在夕阳三峡口，人行秋雨两岩间。\n不知何处堪图画，移得柴门到楚山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32279,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张孟","text":"鸿濛再剖一天地，书契复见科斗文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32280,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张起","text":"别来越树长为客，看尽吴山不是家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32281,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏赠瞽者","author":"靼鞑哑","text":"就鞍和袖绾丝缰，也逐王孙出晋阳。\n人笑但闻誇景物，风来应解审笙簧。\n马蹄响处无芳草，莺舌调时有绿杨。\n休道不知春色好，东风桃李一般香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32282,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉诏回作","author":"丘处机","text":"外国深蕃事莫穷，阴阳气候特无从。\n才经四月阴魔尽，却早弥天旱魃凶。\n浸润百川当九夏，摧残万草若三冬。\n我行往复三千里，不见行人带雨容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32283,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王元粹","text":"十月风霜侵病骨，数家针线补残衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32284,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"哀被虏妇","author":"聂碧窗","text":"当年结发在深闺，岂料人生有别离。\n到底不知因色误，马前犹是买胭脂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32285,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北朝赦至感而有诗","author":"聂碧窗","text":"乾坤杀气正沈沈，又听燕台降德音。\n万口尽传新诏好，四朝谁念旧恩深。\n分茅列土将军志，问舍求田父老心。\n丽正押班犹昨日，小臣无语泪沾襟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32286,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏北妇","author":"聂碧窗","text":"双柳垂眉别样梳，醉来马上倩人扶。\n江南有眼何曾见，争捲珠帘看固姑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32287,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵太祖真容","author":"聂碧窗","text":"凤表龙姿俨若新，一回展卷一伤神。\n天颜亦怪君非虏，河北山东总旧臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32288,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存书记","author":"梁大柱","text":"一声两声松子落，三片五片枫叶飞。\n夕阳在山新月上，道人相伴一僧归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32289,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"马臻","text":"达人不患贫，贞女不事媚。\n静知春事佳，老觉世味熟。\n古交山上松，今交陌上花。\n某丘有树犹堪宿，何处无鱼可疗饥。\n瘦梅喜浸古罍盎，老态怕著新衣裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32290,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴全节","text":"要知颜子如愚处，正是羲皇未画前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32291,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杜鹃行","author":"李道坦","text":"吾闻昔有蜀天子，化作冤禽名杜宇。\n一身流落怀故乡，万里逢人诉离苦。\n西来纵呼巫峡间，楚台花落青春阑。\n台中魂梦久寂寞，行云日暮愁空山。\n明朝复向潇湘发，北叫苍梧江竹裂。\n竹间之泪花上血，怨入东风俱不灭。\n天涯无穷朝暮啼，王孙草绿不须归。\n哀哉王孙终不归，江南江北杨花飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32292,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄吴正传","author":"李道坦","text":"拂袖行歌归故乡，相思又是一星霜。\n梦回江上秋风杳，愁入天涯春草长。\n书问久淹嗟契阔，诗章时读慰凄凉。\n知君亦有逍遥兴，肯学征鸿为稻粱？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32293,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人归严陵并寄吴正传","author":"李道坦","text":"官车一两马并驰，送君朝出城门西。\n投觞誓河以为别，东流到海无还期。\n云间挂冠归故里，河上停帆谢游子。\n不愿松江食巨鲈，甘向桐江钓寒水。\n子陵昔钓川之侧，百尺高台犹屹立。\n斜日归舟系石根，稽首清风无愧色。\n金华洞天清且幽，神仙牧羊松下游。\n故人吴君仙者俦，高卧岩屋秋浮浮。\n兹山相邻尔睦州，山翠俯压城南楼。\n吴君之家某水丘，尺书欲烦亲手投。\n一见足写平生忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32294,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"高将军白鹞子歌","author":"李道坦","text":"淮西猛士高将军，新获骁禽被凉素。\n调之弗顾情未狎，跨马臂出城东去。\n征鸿作字云边斜，耸身直上谁能遮。\n天寒日暮望不见，北风万里吹瑶花。\n云飞忽断鸿飞却，短草长烟沙际漠。\n但馀孤色摇清秋，未许纤毫生碧落。\n归来珍卫不解韝，亲手喂肉供饥喉。\n英雄遇合固有分，可惜惊尘俱雪头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32295,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李白酒楼歌","author":"李道坦","text":"溧阳酒楼春水涯，白马系在楼东家。\n千金醉尽不复顾，犹吹玉笛引吴娃。\n日斜楼外东风起，春愁满眼杨花里。\n高歌一曲下楼去，传遍江南数千里。\n锦袍绿水迷踪迹，月落空梁照颜色。\n江头尽日不见人，楼上几年无此客。\n倚栏仰看西飞云，胡为不饮愁其身？\n即今寂寞千年后，谁酹青山山下坟！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32296,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李道坦","text":"落日中原小，悲风易水寒。\n凡物皆归土，深山始见天。\n城南草绿王孙去，江上花飞燕子来。\n清江百转秋花底，渔火孤舟暮雨中。\n芙蓉水碧双凫冷，苜蓿秋高万马肥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32297,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李道坦","text":"天寒日暮望不见，北风万里吹瑶花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32298,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"薛玄曦","text":"臂鹰过雁碛，老马上龙堆。\n明月梦回夔子北，长风吹度夜郎西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32299,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食客中","author":"黄石翁","text":"明朝便典黑貂裘，寒食宁无数日留？\n烟断昔曾悲介子，火衰今不祀商丘。\n百年尽付风吹柳，一雨远随山入楼。\n安得五侯鲭到我，自脩茶事试香篝。\n惨淡微茫断客魂，最难忘处最难言。\n南陵不可避风雨，麦饭如何托子孙。\n往事沧江吹白鸟，谁家铁拨送金尊。\n欲寻隐者相倾倒，烟柳深深不见门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32300,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"黄石翁","text":"看山如觅孟万年，君自求之眉睫间。\n病翁生愁午睡去，舟行失却九峰山。\n前瞻数点颇铦锐，沿流计程只此是。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32301,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"黄石翁","text":"历落求奇迹，丁宁问异书。\n石刻披秦篆，铜章验汉官。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32302,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王与敬","text":"依然拂袖归山去，止止庵前伴白云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32303,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自赞","author":"彭日隆","text":"五五二十五，只管从头数。\n到底一也无，松梢月当午。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32304,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"盗发亚父冢","author":"朱思本","text":"戏马台前范增冢，英风千载行人竦。\n冢中宝气腾光芒，识宝贾胡心为动。\n筑室潜谋二十年，一朝凿井穿其垄。\n畚锸才深四十尺，乃有石盘青巃嵷。\n四旁牂杙大十围，各施九十森环拱。\n石穿棺翣更分明，漆光可鉴刚而巩。\n斲之不用挥金椎，白骨俨然全顶踵。\n宝剑未化横苍虬，金玉辉耀气交拥。\n贾胡致富须臾间，弃骨沟中宁愧恐。\n平原无色鼓角悲，山鬼夜号川泽涌。\n太守陈公英俊才，慨叹奸偷吾所统。\n亟呼五百取群盗，械置狴犴见仁勇。\n伤哉亚父天下奇，鸿门高会真危机。\n火龙飞起实天意，拔剑起舞空尔为。\n风云变化失隆准，玉斗一碎山河非。\n如公明义古亦少，发愤乃作彭城归。\n六合茫茫汉疆土，厚葬何人诚可嗤。\n君不见骊山牧竖遗烬酷，不如王孙裸葬良亦足。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32305,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伯生学士见和仆与李学士诗纸尾批云已与溉之约红梨花开当往访也卧病不知春事浅深清明后四日闻梨花盛开复用清明诗韵呈玄德真人伯生溉之二学士","author":"朱思本","text":"红入梨花媚更明，黄莺飞下眼频倾。\n玉容带酒含春色，绛袂迎风感物情。\n幻化可能穷妙理，追欢聊复得浮生。\n开尊为报虞夫子，莫待缤纷雪满城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32306,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明后四日红梨花开用明字韵赋诗一章奉邀虞李二学士以践看花之约玄德真人且属和矣学士竟不至又六日风雨大作花已委地依韵再赋一章呈玄德真人并简二学士","author":"朱思本","text":"霞卷云舒映树明，花如妩媚向人倾。\n仙翁染翰饶诗兴，学士停骖傲物情。\n有限光阴春事老，无端风雨莫愁生。\n明朝扫地红英遍，却待寻芳出凤城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32307,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道言","author":"张雨","text":"造物于我厚，一切使我薄。\n瓶中有储粟，持此卧云壑。\n弊衣取苟完，得味在藜藿。\n花鸟予友于，尊酒不独酌。\n床头堆故书，败履置床脚。\n未尝身没溺，何与世浊恶。\n正如散马牛，不识穿与络。\n异时老髑髅，会有南面乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32308,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月风雨清斋","author":"张雨","text":"中林授衣节，寒气早已集。\n牖户洎裘褐，凡百缺治葺。\n穷居昧时序，颇讶光景急。\n丛篁助幽翳，漾濑发空寂。\n水禽穿屋过，岩树排檐入。\n陶尊既尘渍，墨突亦雨立。\n遐思把菊咏，端处掬溜室。\n空言非药饵，殆不废九日。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32309,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"涧阿对雨二首卷二改。按张雨另有涧阿晚兴诗可證。】 其一","author":"张雨","text":"山云油然作，山雨来不缓。\n既沾灵石坞，遂洒寒栖馆。\n落水遽如许，众草行复烂。\n有酒不堪酌，无物堪把玩。\n与闻季长笛，宁从中散锻。\n代谢夫何如，徒为白首叹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32310,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"涧阿对雨二首卷二改。按张雨另有涧阿晚兴诗可證。】 其二","author":"张雨","text":"步归灵涧幽，泥染居士屩。\n不知岚雨深，稍怯布衣薄。\n拂床次群帙，扫径堆脱箨。\n清坐亦偶然，吾非慕仙爵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32311,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"延陵公承庆堂诗","author":"张雨","text":"大江苍苍兀龙虎，辅元之家百神頫。\n望拜受釐若稽古，上清真人阅众甫。\n新宫洁斋导天语，纷云郁霞错承宇。\n虚皇穆然阳卫武，左飙右欻降軨羽。\n县钟镗镗迅击鼓，赫金蔡服赭朱户。\n双珠月明带宝璐，挟以流黄玉■（木昙）具。\n既竣大礼私事举，吉日宗族奉爵俎。\n青紫系地簪绶组，魏张代剑新捧土。\n饶国开观治宿莽，报君亲师物咸睹。\n抚己一念或未溥，西壁考书玄范府。\n寒冰层阴发春煦，日若休明沐仁雨。\n道德大非方仙五，月佩六印非适取。\n持旌召趣迹旁午，下土滓?宁久处。\n天关会规足蹈矩，愿天愿地多黍稌。\n毕志万年奉明主，小史作书孰敢侮。\n吁嗟厚德番之祖。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32312,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张雨","text":"家藏逸少笼鹅字，门系龟蒙放鸭船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32313,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张雨","text":"风沙不惮五千里，将身跳入仙人壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32314,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自题春消息图","author":"邹复雷","text":"蓬居何处索春回，分付寒蟾伴老梅。\n半缕烟消虚室冷，墨痕留影上窗来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32315,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词","author":"富恕","text":"十里荷花锦一机，雨馀荷气扑人衣。\n满船游女蒙白苧，阵阵腥风鸥鹭飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32316,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"方从义","text":"岸花汀鸟留幽意，碧水丹山共隐情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32317,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"朱宣慰家题画","author":"子温","text":"昔有朱买臣，今有朱宣慰。\n两个担柴夫，并为朱紫贵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32318,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画葡萄卷后","author":"子温","text":"明月清风宗炳社，夕阳秋色庾公楼。\n修心未到无心地，万种千般逐水流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32319,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"子温","text":"曾向流沙取梵书，草龙珠帐满征途。\n轻包短策难将带，记得西风月上初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"有规","text":"读书已觉眉棱重，就枕方欣骨节和。\n睡去不知天早晚，西窗残日已无多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重阳","author":"德丰","text":"战尽今秋见太平，西风多作北风声。\n不吹乌帽吹毡帽，篱下黄花笑不成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答钟山长老","author":"德丰","text":"耿耿孤吟对古梅，忽传军将送书来。\n倚崖枯木摧残甚，虚负阳和到一回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"炳同","text":"老来非厌客，静里欲书经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南山诗","author":"净权","text":"紫气金丹晓，青霞玉井春。\n画牛曾寓意，鸣鹤更通神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"存诚","text":"别后多游沧海东，忽携诗卷到山中。\n立谈数语飘然去，满径松花落午风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]