24878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"后土祠琼花","author":"周权","text":"东风何处擅浓华，只有扬州第一花。\n天上群仙肤似雪，绿云深拥七香车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清真道院","author":"周权","text":"空翠霏霏霭洞天，蹋云来访洞中仙。\n满襟诗思清如水，写尽松花一砚烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晚棹","author":"周权","text":"白水青林荡晚晴，野禽树底向人鸣。\n乘风十幅蒲帆饱，快试淮南第一程。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"即事","author":"周权","text":"晨墟跣妇鬻鱼虾，两岸?童牧艾豭。\n赋敛输官农事足，太平气象属淮沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨后","author":"周权","text":"鸣鸠村暗晓寒天，白水交流乱野田。\n落尽残红春不管，一川风雨阁榆烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵冯仲远","author":"周权","text":"长河柳暗春波碧，青帘摇曳厨烟寂。\n客舟无处醉梨花，自买豚鱼作寒食。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘伶坟","author":"周权","text":"荷锸相随死便埋，平生六合等浮埃。\n千年一醉不知晓，谁向苍苔酹一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶题","author":"周权","text":"东风吹绿遍天涯，陌上晴烟漾柳花。\n鹤发老人茅店下，一樽相对话桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邳州","author":"周权","text":"百战残城古下邳，白门楼下草萋萋。\n古来多少英雄恨，落月城头乌夜啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"进履桥","author":"周权","text":"博浪沙头恨未消，毙秦践项不终朝。\n汉家四百年宗社，开辟洪基在此桥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"沛县","author":"周权","text":"天连荒草入青原，古县残桥拥一廛。\n千载芒砀销王气，斜阳孤水落寒烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"道傍即事","author":"周权","text":"閒马嘶云牧远芜，高原下隰尽耕锄。\n太平里巷都无事，老卒支颐听读书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"武城县","author":"周权","text":"牛刀小试恢恢手，庭讼都无犴狱空。\n直把弦歌为县谱，寥寥千载接清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凌州","author":"周权","text":"萦纡河水走长虬，汩汩黄泥逐浪浮。\n揉断橹声惊睡熟，一舟冲雨下凌州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"端午","author":"周权","text":"河上人家插艾蒿，纷纷炊黍荐香醪。\n客怀寥落真无那，暮雨孤舟读楚骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客枕","author":"周权","text":"落叶萧萧拥石阑，辘轳声断井花乾。\n夜深天阔风霜紧，雁落沧江月正寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"欧阳学士过访","author":"周权","text":"玉堂仙忽枉华镳，客舍如何采涧毛。\n袖有建溪春一掬，莱山石鼎煮银涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓秋","author":"周权","text":"浦溆明寒透橘洲，雁风吹老一天秋。\n渔翁醉卧芦花底，流水晚烟閒钓舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"值雨憩僧舍","author":"周权","text":"昼篆萤行香半残，隔阑翠柳拂疏烟。\n勿论尘土东华客，著我僧毡听雨眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵瓜洲渡","author":"周权","text":"江花江水两悠悠，万事匆匆付白头。\n又向瓜州买樽酒，一篷烟雨话扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潘易斋写水墨梅","author":"周权","text":"胸中一卷画前易，笔底万斛江南春。\n莫向冰纨写孤洁，从他水月自传神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水天一碧亭","author":"周权","text":"吟鬓萧萧风雪客，黄河太华曾亲识。\n振衣舒啸巍然亭，目尽江淮天一碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴秋山写江淮秋意","author":"周权","text":"江天漠漠秋无际，数点淮山冷屏翠。\n閒拈枯笔洒松腴，半幅生绡千里意。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拟古 其一","author":"黄玠","text":"龙马负灵图，八卦开人文。\n天运当寅中，民时方大昕。\n制字乃未多，所言为典坟。\n一往数千载，怀哉圣神君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":14147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]