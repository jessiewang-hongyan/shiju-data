"commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19320,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李成枯木","author":"郑元祐","text":"谁如惜墨李营丘，屈铁交柯烟雨稠。\n记得沧江龙出蛰，怒须捲雾拔山湫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19321,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题万竹图","author":"郑元祐","text":"远近阴晴玉万竿，渭川何在绿云寒。\n砚坳飞墨如飞雨，白发萧郎仔细看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19322,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王元章墨梅","author":"郑元祐","text":"旧时月色有谁歌，拔剑王郎鬓已皤。\n惆怅春风旧词笔，南枝香少北枝多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19323,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题明雪窗兰","author":"郑元祐","text":"生公台石比双峨，两不为稀万不多。\n兰蕙香销荆棘里，光风流转奈君何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19324,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子昂兰石","author":"郑元祐","text":"捐玦孤臣万古愁，思君日夜水东流。\n春风开遍闲桃李，却对青山泣楚囚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19325,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题柯敬仲梅竹图二首 其一","author":"郑元祐","text":"苔石相依葆岁寒，凭谁翠袖倚阑干？\n玉文堂上萧萧雨，墨沈于今尚未乾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19326,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题柯敬仲梅竹图二首 其二","author":"郑元祐","text":"谁料丹丘不复生，眼眵长向墨踪明。\n钓竿若拂珊瑚月，少为梅花住越城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19327,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题文与可竹","author":"郑元祐","text":"欲屈王郎作粲使，只因萧李与文侯。\n尚有阴阴竹里馆，万竿玉立辋川秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19328,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题岳家旧藏高彦敬云山图","author":"郑元祐","text":"千柱华榱淇渌堂，只今衰草野田荒。\n空馀宝玩谁开阖？\n一叠云山泪一行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19329,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题山水扇面","author":"郑元祐","text":"一握方诸镜里天，分明雁荡石城连。\n仙人不患蓬壶小，便驻鸾笙五百年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19330,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送人","author":"郑元祐","text":"岁月蹉跎秋复春，轮囷瘿树不求伸。\n斧斤何待秋零落，多是长松百尺身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19331,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张叔厚白描麻姑像","author":"郑元祐","text":"狡狯仙人来自东，海波清浅日轮红。\n易迁宫里飞霞佩，只在鸾笙一曲中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19332,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其一 师子峰","author":"郑元祐","text":"天日耽耽师子岩，金毛闪日耀烟岚。\n转身却向吴中吼，直与淩霄势并参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19333,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其二 栖凤亭","author":"郑元祐","text":"翙翙朝阳孤凤凰，绿筠千尺起高冈。\n何人解续卷阿颂？\n戛玉鏦金作晚凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19334,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其三 飞虹桥","author":"郑元祐","text":"彩霓连蜷饮海空，老僧留作小飞虹。\n舣舟因意吴江钓，苍雪吹凉满雨蓬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19335,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其四 问梅訚","author":"郑元祐","text":"谩道龙驹踏杀人，梅花成实又逢春。\n不因嚼碎无留核，谁为征蓬洗客尘？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19336,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其五 指柏轩","author":"郑元祐","text":"反覆神机老赵州，庭前柏树几经秋？\n空林元自无枝叶，莫著祥鸾宿上头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19337,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其六 玉鉴池","author":"郑元祐","text":"活水涓涓一鉴开，玉光射日瑩无埃。\n临流照见行禅影，天际孤云蓦地来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19338,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其七 立雪堂","author":"郑元祐","text":"少林山里雪漫漫，谁复将心与汝安？\n近日师林寒彻骨，冰花吹满碧琅玕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19339,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"师子林八咏 其八 卧云室","author":"郑元祐","text":"老随云卧不朝天，空影长当木榻穿。\n便是绣衣传诏下，空山且复伴龙眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19340,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其一","author":"郑元祐","text":"岳王坟西是妾家，望郎不见见栖霞。\n孤山若有奢华日，不种梅花种杏花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19341,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"郑元祐","text":"青青两点海门山，郎去贩鲜何日还？\n潮水便如郎信息，江花恰是妾容颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19342,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪云林画，次韵","author":"郑元祐","text":"云林雨过踏青阳，涧水溅溅老树苍。\n不是砚坳云作阵，疏篁空自拂檐长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19343,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题陈惟允荆溪图","author":"郑元祐","text":"荆溪溪上首重回，岂意人间花劫灰？\n只有斩蛟桥下水，可曾写入画图来？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19344,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其一","author":"郑元祐","text":"金碧楼台瀛海东，娉婷仙子下瑶宫。\n圣凡千古无穷事，都在鸾笙一曲中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19345,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其二","author":"郑元祐","text":"蔼蔼身中三素云，朝晖出海共氤氲。\n桃霞沐雨轻匀面，柳浪含漪细织裙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19346,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其三","author":"郑元祐","text":"凤麟洲上水烟分，女伴同祠李少君。\n点定易迁宫里籍，步虚携手踏红云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19347,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其四","author":"郑元祐","text":"煌煌珠树四时春，树影玲珑月满身。\n理罢玉笙朝斗去，就中谁是避秦人？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19348,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其五","author":"郑元祐","text":"云旗阿母降珠庭，母为双成欲授经。\n尘世登真无要诀，药囊辛苦贮参苓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19349,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其六","author":"郑元祐","text":"才炊松屑饭胡麻，又见蟠桃一度花。\n不为灵姝工服食，金盘那得枣如瓜？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19350,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其七","author":"郑元祐","text":"窈窕溪真十二仙，灵犀分水夜长然。\n珠宫每按皇人笔，点较青瑶第几篇？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19351,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其八","author":"郑元祐","text":"宝髻骈云谁最高，花间行数旧栽桃。\n笙洲月出星宫近，骑著神鱼舞翠涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19352,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其九","author":"郑元祐","text":"紫皇亲驾按寰瀛，又见鲸波彻底清。\n仙籍不能无谪降，尘缘敢恨有亏成？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19353,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游仙词十首，并引 其十","author":"郑元祐","text":"欲采灵芝敢后期，游鱼千里费寻师。\n不因悟得长生著，一局才终未了棋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19354,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋巫峡云涛石屏","author":"郑元祐","text":"石理庚庚有至文，江涛鼓浪忽蒸云。\n鬼神不露雕镂巧，那得阴阳一线分？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19355,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郑所南推篷竹卷","author":"郑元祐","text":"墨胎之墨死不化，固应此君长入画。\n雨里推篷略见来，至今风节传天下。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19356,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子昂瓮牖图二首 其一","author":"郑元祐","text":"穷通由命不由人，结驷来窥瓮牖春。\n富贵不淫贫贱乐，山青云白水粼粼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19357,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子昂瓮牖图二首 其二","author":"郑元祐","text":"贫病无聊是老农，萧条门巷绝行踪。\n画图不尽朋从意，凝望停云检宿舂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19358,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵魏公二帖","author":"郑元祐","text":"馀不溪边采白蘋，铁网珊瑚寸寸珍。\n天上玉楼盛不住，虹光夜夜贯星辰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19359,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题曹云西山水","author":"郑元祐","text":"笔底江山不露锋，茅茨十尺倚长松。\n采芝空谷归何晚？\n知在晴云第几重？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19360,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭天锡画二首 其一","author":"郑元祐","text":"飞墨来从海岳庵，春烟林麓是江南。\n绿蘋洲渚闲鸥白，不著征人一解骖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19361,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭天锡画二首 其二","author":"郑元祐","text":"商颂何须曳履歌，江南山色砚池波。\n长髯蘸得琳琅目，留作飞云在涧阿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19362,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂马图","author":"郑元祐","text":"王孙曾骑天厩驎，每忆龙驹便写真。\n曹霸祇今那复得？\n丹青剥落泪沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19363,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪云林春山岚霭图","author":"郑元祐","text":"九龙峰上雨云乾，影落栖神涧水寒。\n不是天机飞墨妙，何由写入画图看？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19364,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"采莲径","author":"郑元祐","text":"曲曲栏杆水殿凉，红绡扇底芰荷香。\n按歌误触鸳鸯起，宫漏今宵分外凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19365,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其一 赤乌碑","author":"郑元祐","text":"鼋趺螭首立重玄，沦落蛟龙百尺渊。\n大手似闻皇象笔，老僧空记赤乌年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19366,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其二 陈桧","author":"郑元祐","text":"华飞三阁竟萧条，万木江南一夜凋。\n独有祯明缨络桧，霜皮剥落气摩霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19367,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其三 虾子禅","author":"郑元祐","text":"名缁神异肯炊沙，钵里蜿蜒喷浪花。\n漂海不随虾国去，渡江还为老渔赊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19368,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其四 讲经台","author":"郑元祐","text":"东土高僧大梦还，讲经犹刺雨花台。\n天龙去尽香云散，满地松阴长石苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19369,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其五 沪渎垒","author":"郑元祐","text":"东吴内史晋长城，沪渎千年壁垒平。\n莫向月明悲往事，即令沧海已尘生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19370,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其六 涌泉","author":"郑元祐","text":"涌泉亭子小冰壶，老蚌胎寒露溅珠。\n只许鲛人弄明月，懒随龙叟泽焦枯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19371,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其七 芦子渡","author":"郑元祐","text":"吴淞古渡水如烟，十里芦花雪满天。\n一苇可航还自许，老僧应不泛虚船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19372,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏 其八 绿云洞","author":"郑元祐","text":"长松钜竹翠敷腴，爽气清含雨露濡。\n不异茅君主句曲，尚容元结隐猗玗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19373,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题萧翼赚兰亭图","author":"郑元祐","text":"已赚君亲走晋阳，老僧犹未识萧郎。\n圣图本为天同大，谁谓桥山善守藏？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19374,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王叔明小画","author":"郑元祐","text":"幼舆丘壑未忘情，万叠青山照眼明。\n儗向画图深处住，一檐灶日听松声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19375,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪元镇水竹居图","author":"郑元祐","text":"秋风潇飒满吴江，竹影飘飖落短窗。\n堪爱倪迂清绝处，依微残墨本无双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19376,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王渊花鸟轴","author":"郑元祐","text":"夜舒荷是若耶人，香散鸳鸯共影身。\n一段柔情看未足，故教绮笔写来真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19377,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郑思肖画兰","author":"郑元祐","text":"南冠江上哭湘累，泪著幽兰雨里枝。\n不独苌弘血化碧，孤芳愁绝有谁知？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19378,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"睡蝶","author":"谢宗可","text":"不趁游蜂上下狂，閒舒倦翅怯寻芳。\n花房舞罢春酣重，蕙径栖迟晓梦长。\n贪困有谁怜褪粉，返魂无力去偷香。\n漆园傲吏忘形久，莫到蘧蘧枕上忙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19379,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纸帐","author":"谢宗可","text":"清悬四壁剡溪霜，高卧梅花月半床。\n茧瓮有天春不老，瑶台无夜雪生香。\n觉来虚白神光发，睡去清閒好梦长。\n一枕总无尘土气，何妨留我白云乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19380,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"纸衾","author":"谢宗可","text":"霜捣溪藤一幅新，醉来高卧付诗人。\n松床夜煖云生席，蕙帐香融雪满身。\n翡翠多情嫌寂寞，鸳鸯无分乐清贫。\n枕边不作红尘梦，睡足梅花玉洞春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19381,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"茶筅","author":"谢宗可","text":"此君一节瑩无瑕，夜听松声漱玉华。\n万缕引风归蟹眼，半瓶飞雪起龙牙。\n香凝翠发云生脚，湿满苍髯浪卷花。\n到手纤毫皆尽力，多因不负玉川家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19382,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"酒旗","author":"谢宗可","text":"水村山郭酒初香，纻影青青字一行。\n垆畔低悬花雾湿，檐阴斜揭柳风凉。\n指挥意马冲愁阵，摇曳心旌入醉乡。\n惆怅步兵招不起，半竿空自舞斜阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19383,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诗瓢","author":"谢宗可","text":"雨蔓霜藤老翠壶，吟边不是酒葫芦。\n剖开架上轮囷玉，著尽胸中错落珠。\n满贮苦心留宇宙，深藏清气付江湖。\n谁家半腹能千首，为问山人果在无？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19384,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]