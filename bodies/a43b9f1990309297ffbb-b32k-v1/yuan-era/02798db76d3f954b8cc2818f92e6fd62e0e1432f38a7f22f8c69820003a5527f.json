[{"title":"高琼太守遗像","author":"尹廷高","text":"河流咫尺隔腥膻，进寸曾令火德燃。\n江海扬尘龙虎逝，英雄犹有画图传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13652,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题秋山晚色图","author":"尹廷高","text":"千峰含翠入高寒，咫尺生绡眼界宽。\n开尽黄花归未得，霜林红叶画中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13653,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永嘉精舍二首 其一","author":"尹廷高","text":"寂寞真如住院僧，竛竮瘦影半孤灯。\n法筵第一无他说，只有脩斋旧葛藤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13654,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永嘉精舍二首 其二","author":"尹廷高","text":"败檐偪仄怕抬头，孤宦飘零不自由。\n半夜空斋风雨急，梦中误唤系渔舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13655,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"腊月海棠","author":"尹廷高","text":"尤物真能夺化工，腊前偷泄数枝红。\n霜花不上胭脂面，强饰春妍嫁北风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13656,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"立秋日","author":"尹廷高","text":"一叶才飞暑渐收，西风吹起鬓飕飕。\n清凉入骨皆恩意，寄语人间莫怨秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13657,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枫塘别业","author":"尹廷高","text":"白云缺处露檐牙，鸡犬相闻仅数家。\n幽鸟不啼林寂寂，满山黄雾落松花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13658,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山九日","author":"尹廷高","text":"每逢佳节倍思家，独倚高秋感物华。\n莫被黄花瞒醉眼，满城风雨是天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13659,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸丑元旦即事二首 其一","author":"尹廷高","text":"客窗曙色渐朦胧，不觉微和上笑容。\n乡梦醒来残烛在，东风吹送景阳钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13660,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸丑元旦即事二首 其二","author":"尹廷高","text":"弟兄遥想颂椒盘，应望天涯忆岁寒。\n归雁纷纷空北向，更无一字寄平安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13661,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山闻杜鹘口占三首 其一","author":"尹廷高","text":"蜀魄千年西复西，何时风隔别幽栖。\n中原万里多芳树，却傍五云深处啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13662,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山闻杜鹘口占三首 其二","author":"尹廷高","text":"黄尘点鬓欠知几，忘却苍苔满钓矶。\n想是山灵懒驰檄，祗今啼鸟劝人归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13663,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山闻杜鹘口占三首 其三","author":"尹廷高","text":"石栈天梯路久通，羽毛何地不春风。\n到今不信尧夫语，浩荡乾坤一气中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13664,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金台","author":"尹廷高","text":"招贤事往久凄凉，志气何人为激昂。\n多少黄金化尘土，荒台千古说昭王。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13665,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞博士扁所居东西曰陶曰邵以寓尚友古人之意各赋一首 其一","author":"尹廷高","text":"重华苗裔许谁同，寓意阶前旧菊丛。\n一片古音人未识，无弦琴里操南风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13666,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"虞博士扁所居东西曰陶曰邵以寓尚友古人之意各赋一首 其二","author":"尹廷高","text":"髣髴行窝旧典型，神游八极手鞭霆。\n群儿斗草春风乱，欹枕窗前看画屏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13667,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南归过钓台","author":"尹廷高","text":"高风千古水漫漫，云压双台暮色寒。\n惟有倒骑牛背客，月明横笛过严滩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13668,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信安秋晚","author":"尹廷高","text":"西风吹客鬓，天地一离愁。\n黄菊山城雨，青灯野店秋。\n乔松填缺嶂，落叶涩寒流。\n吹醒乡关梦，笛声人隔楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13669,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客中思归","author":"尹廷高","text":"孤灯寒照影，清夜自沈吟。\n砧杵他乡泪，松楸故国心。\n路长归梦短，酒浅客愁深。\n了却江湖债，携书隐竹林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13670,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"严先生祠","author":"尹廷高","text":"貂蝉何足浼，鸿鹄竟高飞。\n潮退江流急，山深云出迟。\n草荒耕雨地，苔合钓鱼矶。\n勋业皆尘土，双台只汉时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13671,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宁化县斋思故园","author":"尹廷高","text":"故园春又暮，游宦几时回。\n树暗莺虚老，庭空燕自来。\n石阶风扫叶，诗壁雨生苔。\n最忆东篱菊，谁分旧种裁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13672,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"尖山寺","author":"尹廷高","text":"入门僧意古，便觉隔尘氛。\n清磬摇寒翠，空廊贮白云。\n定回松落子，画剥藓添纹。\n仙笔今何在，儿啼夜不闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13673,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽诗友","author":"尹廷高","text":"诗筒消息断，近作绝无闻。\n棋石夜敲雨，吟窗昼掩云。\n苍苔闲旧业，芳草绿新坟。\n愁见梅花面，伤心正忆君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13674,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"故里兵火后","author":"尹廷高","text":"故家尽焦土，天地我何归。\n世数至此极，人烟存者稀。\n溪山虽不改，巷陌已全非。\n尚忆堂前燕，傍谁门户飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13675,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奕山值寇读杜诗有感","author":"尹廷高","text":"杜曲衣冠尽，群凶转跳梁。\n疏林巢燕雀，空谷斗豺狼。\n衣湿彭衙雨，砧敲楚岸霜。\n年荒难自给，拾橡当糇粮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13676,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"信安送友归开化","author":"尹廷高","text":"客里复送客，君西我亦东。\n相逢机易失，欲别意难穷。\n杨柳津亭绿，桃花野渡红。\n不堪回首处，江上雨濛濛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13677,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"翁村翠流閤","author":"尹廷高","text":"四围山翠合，缥缈见危楼。\n地狭星辰少，云深水石幽。\n溪声晴亦雨，松影夏如秋。\n寄语游方者，桃源岂外求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13678,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壬午秋自翁村回奕山三首 其一","author":"尹廷高","text":"竟别桑乾水，归并却似家。\n春风故巢燕，夜雨废池蛙。\n石径曾栽菊，砖垆旧煮茶。\n自怜萍梗迹，何日定生涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13679,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壬午秋自翁村回奕山三首 其二","author":"尹廷高","text":"读了杜陵诗，伤今思故时。\n见应经事老，贫悔治生迟。\n醉可忘荣辱，吟无救乱离。\n老夫从所欲，世事尚堪为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13680,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"壬午秋自翁村回奕山三首 其三","author":"尹廷高","text":"十年流落苦，鬓雪几茎侵。\n松菊寒归约，桑麻热客心。\n年荒思乐土，故病怯清砧。\n未遂东归志，空成梁父吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13681,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别友","author":"尹廷高","text":"风雨江桥别，凄然欲断魂。\n乱离难作客，患难易为恩。\n回首人千里，论心酒一尊。\n寄梅有良便，好认白云村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13682,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕云寮即事二首 其一","author":"尹廷高","text":"埽影入林壑，松边旋结茅。\n癖从俗子笑，贫少故人交。\n抱叶蝉遗蜕，衔枝鹊理巢。\n此中有清兴，无日不推敲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13683,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"耕云寮即事二首 其二","author":"尹廷高","text":"闭门贫亦乐，世态任炎凉。\n梦稳疑宵短，心闲觉昼长。\n与鸥分钓石，留鹤伴丹房。\n休笑生涯薄，疏篱橘柚黄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13684,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送王令尹","author":"尹廷高","text":"一力行安静，临民最有容。\n官清琴独古，事简印长封。\n马瘦廉声出，鲈肥归兴浓。\n双凫早朝阙，长乐听疏钟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13685,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊子八月邑再燬于寇庠序独存","author":"尹廷高","text":"曲突无先见，偷安苟目前。\n赏奸成餋虎，稔祸起飞鸢。\n戒石眠秋草，空城锁暮烟。\n民彝终未泯，庠序独岿然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13686,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠雪涯","author":"尹廷高","text":"遍阅诸瓢尽，如师了悟难。\n诗无蔬笋气，貌带竹松寒。\n破衲挐云补，残经带月看。\n定回崖雪霁，万象只空观。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13687,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同友访厚轩归晚","author":"尹廷高","text":"松下闲乘兴，相陪访厚轩。\n及门曾未久，归路已全昏。\n钟近山藏观，灯遥树隔村。\n书囊谈未了，何日再开尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13688,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠叶羽士","author":"尹廷高","text":"洞门长不锁，俗客到应难。\n琴谱莺能和，丹炉鹤为看。\n竹阴暗诗壁，松子落玄坛。\n道士清溪派，虚堂管翠寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13689,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春晚即事","author":"尹廷高","text":"晴雨都无定，东君似不知。\n蜗涎篆蝌蚪，燕语译侏离。\n花事付杯酒，桑阴落茧丝。\n柴门久关闭，吟思浩无涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13690,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送平山兄回西岸","author":"尹廷高","text":"剪烛话寒更，芳樽且缓倾。\n飘零多旧梦，离乱半平生。\n山色秋看冷，砧声夜听清。\n转头千嶂隔，风雨若为情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13691,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送友回郡","author":"尹廷高","text":"捧檄乱云西，频宵梦好溪。\n还家江蟹熟，归路峡猿啼。\n山翠湿诗担，桥霜印马蹄。\n经行逢胜地，浓墨洒留题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13692,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南明寺","author":"尹廷高","text":"金刹雄天半，风传钟磬音。\n石梁担佛法，崖瀑洗尘心。\n古径黄花淡，山门翠柏深。\n就中奇绝处，小洞曲穿林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13693,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居","author":"尹廷高","text":"青山深处隐，时事不须闻。\n门闭千峰雨，楼吞万壑云。\n种花篱密护，接竹水遥分。\n羞作千人态，甘心鹿与群。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13694,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八咏楼","author":"尹廷高","text":"披褐便归休，登临底用愁。\n楼空偏爱月，山瘦不胜秋。\n二水城根合，孤云天际浮。\n倚阑千古意，鸿影去悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13695,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江楼夜兴","author":"尹廷高","text":"戍鼓报三更，危楼夜气清。\n诗成海月上，梦觉浦潮生。\n沙白昏渔火，江空闻橹声。\n归心随野鹤，展转到天明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13696,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖岳王坟","author":"尹廷高","text":"高鸟何尝尽，良弓已弗存。\n西风捲归旆，朔雪暗中原。\n桧色犹含愧，湖波不洗冤。\n当年莫须有，翁仲寂无言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13697,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"见徐判簿留村先生","author":"尹廷高","text":"冰檗平生志，公馀户自扃。\n待人绝城府，临政若家庭。\n市井狐狸遁，乡村鸡犬宁。\n何惭古循吏，耳目为公醒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13698,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古杭秋日三首 其一","author":"尹廷高","text":"正自无聊赖，西风更败荷。\n秋容森列嶂，曙色耿残河。\n吾道青灯冷，衰年白发多。\n曲生交久绝，借汝挽春和。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13699,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古杭秋日三首 其二","author":"尹廷高","text":"故国无书问，他乡有弟兄。\n霜风欺老病，江海寄馀生。\n黄叶天涯路，清风雨外城。\n东邻似相恼，深夜捣衣声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13700,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古杭秋日三首 其三","author":"尹廷高","text":"成毁乾坤老，炎凉岁月忙。\n冥鸿既寥廓，烟鹭亦沧浪。\n江寺秋云白，宫墙夕照黄。\n倚阑无限意，一笑越山沧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13701,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"约正卿北行 其八","author":"尹廷高","text":"饮啄犹前定，飘零岂偶然。\n古梅村店路，官柳御河船。\n嵩华三生梦，燕云万里天。\n丈夫四方志，未用赋归田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13702,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"离杭别友","author":"尹廷高","text":"勇作子长游，翻成老大羞。\n山川几两屐，天地一扁舟。\n何处无黄犊，吾生负白鸥。\n离情正悽断，风絮更悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13703,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"燕山秋夜","author":"尹廷高","text":"十宵九归梦，摇落故乡心。\n星象连双阙，秋声起万砧。\n风霜添老色，天地入清吟。\n儿女应相忆，青灯语夜深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13704,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长芦舟中值雪","author":"尹廷高","text":"清景不常得，吟边急用摹。\n天风吹短艇，暮雪过长芦。\n水港行终涩，烟村望欲无。\n不须归兴急，权当剡溪图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13705,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北归留杭","author":"尹廷高","text":"笑指家山近，何妨复暂留。\n樽前万里客，天际一归舟。\n黄叶来时路，青灯旧日楼。\n醉馀还自笑，浪迹类江鸥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13706,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"抵杭闻章古泉下世挥泪二首 其一","author":"尹廷高","text":"湖山相送日，此别遂千秋。\n岁晚古人尽，天涯老泪流。\n百年真过鸟，一笑竟荒丘。\n乌石江头路，寒花蝶也愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13707,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"抵杭闻章古泉下世挥泪二首 其二","author":"尹廷高","text":"俗子存何益，诗人去可伤。\n青山顿尘土，黄叶半凄凉。\n托后遗言在，论交古意长。\n九原呼不起，天阔意茫茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13708,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归来","author":"尹廷高","text":"心知归计是，猿鹤亦欣然。\n松顶留残雪，檐牙起暮烟。\n解琴弹膝上，把酒话灯前。\n洗净尘埃面，看山且勿眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13709,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"真诰岩","author":"尹廷高","text":"真人仙去久，洞穴尚谽{含牙}。\n殿滴空嵓雨，廊穿别嶂霞。\n对门孤石峭，开牖乱峰斜。\n欲跨蟾蜍背，腾空采月华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13710,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"期男祖志未至","author":"尹廷高","text":"失学嗟何及，应门望汝贤。\n来迟春雨后，立尽夕阳天。\n山店村村柳，江湖日日船。\n何时占鹊喜，袖简拜庭前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13711,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京都三首 其一","author":"尹廷高","text":"鳌极曾重建，真元一气钟。\n乾坤雄析木，日月绕居庸。\n霁色千门柳，高风半夜钟。\n儒生亦何幸，白首际时雍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13712,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京都三首 其二","author":"尹廷高","text":"万里观光客，吟怀浩荡间。\n黄埃深似雾，绿树远疑山。\n海鹤当秋奋，宫鸦入夜还。\n破愁惟有酒，春色上衰颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13713,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"京都三首 其三","author":"尹廷高","text":"如许山河壮，重来谩寄游。\n红云金阙晓，黄菊玉泉秋。\n迂策知难用，颓龄窃自羞。\n长镵归斸雪，聊复自为谋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13714,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸丑三月得去年七月所寄家书","author":"尹廷高","text":"飘泊天涯远，乡音日以疏。\n又成经岁别，忽得去年书。\n客里无穷事，灯前薄醉馀。\n沈吟不自已，一纸卷还舒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13715,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起","author":"尹廷高","text":"卧疴经月久，风雨少开扉。\n病起花阴满，诗成燕子归。\n寸闲关晚福，一笑阅春晖。\n但得身强健，登临尚有期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13716,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江东书怀","author":"尹廷高","text":"败叶萧萧乱打窗，山河入望正凄凉。\n千年巷陌风流尽，一曲庭花霸业荒。\n马载客愁嘶楚月，雁传乡信带吴霜。\n悠悠今古兴亡事，断础寒烟几夕阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13717,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花二首 其一","author":"尹廷高","text":"老树粘云冻欲皲，疏花数点自精神。\n绝无烟火尘中气，可是山林物外身。\n冰净湖天长浴影，雪深人世未知春。\n清高莫道交游少，月与仝窗竹与邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13718,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅花二首 其二","author":"尹廷高","text":"偃蹇虬枝带藓斑，暗香和月到阑干。\n修来仙骨身千劫，琢透春痕玉一团。\n气味自清非傲俗，标姿虽瘦却禁寒。\n横斜疏影描难尽，更写梅真子细看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13719,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桂花","author":"尹廷高","text":"吹老西风粟满梢，天来爽气助挥毫。\n影摇夜月金波碎，香度秋云玉宇高。\n万点娇黄光醉眼，一团冷翠润征袍。\n吟边受用清无尽，独据绳床兴转豪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13720,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海棠","author":"尹廷高","text":"李花带俗杏花粗，争似天然蜀锦图。\n雨晕香脂娇欲滴，日酣红袖醉相扶。\n未消光彩摇银烛，且约芳菲伴玉壶。\n欲办窗间小横轴，丹青易染态难摹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13721,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿光宫","author":"尹廷高","text":"清都缥缈踞林峦，幽致曾图入内看。\n跨虎仙升丹井废，画牛人去砚池寒。\n白云片片封宫树，黄叶年年下石坛。\n风景不殊时事改，吟成无语拍阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13722,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题翠峰贯休旧隐","author":"尹廷高","text":"乘风长啸翠峰头，唤醒当年老贯休。\n境界高寒多得月，松筠潇洒密藏秋。\n蜀尼曾礼空中刹，吴越难添句里州。\n劫外有家人不识，白云千古意悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":13723,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]