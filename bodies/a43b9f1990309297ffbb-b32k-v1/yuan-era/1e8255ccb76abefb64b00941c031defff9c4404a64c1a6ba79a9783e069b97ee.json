[{"title":"濑溪","author":"张翥","text":"古渡猴溪外，风烟淡欲无。\n岛人形貌怪，闽囝语言殊。\n小店鱼虾市，深林猿鸟都。\n肩舆看山好，候骑缓前驱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16455,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"发漳州","author":"张翥","text":"万里漳南道，遥连岭峤东。\n山寒冬息瘴，海近昼多风。\n废圃攒筋竹，疏林落刺桐。\n槟榔新善啖，一解宿酲空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16456,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归武林冒雨至练市韩伯清庄","author":"张翥","text":"溪雨寒犹重，山云昼不开。\n老夫喜閒暇，练水得沿洄。\n凫雁冲船过，鱼虾入馔来。\n故人居渐近，应待举吾杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16457,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泛舟青镇至姚师善庄夕回韩庄","author":"张翥","text":"明月半溪水，归人中夜舟。\n树阴屯岸合，萤影入烟流。\n勋业生无取，田园老可谋。\n悠然发清咏，思绕白蘋洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16458,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"召入国学雨中过高沙湖","author":"张翥","text":"细雨洒秋色，平湖生白波。\n客心贪路急，帆腹受风多。\n落木生诗思，惊禽避棹歌。\n舟行不借酒，兀坐奈愁何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16459,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北归四月一日舟至市泾","author":"张翥","text":"绿树村村合，晴川浦浦通。\n岸容宽积雨，水色定回风。\n戍近时鸣柝，渔归忽舣篷。\n船人喜相约，乘早过垂虹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16460,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"留宿洪洞庆云观刘山甫方丈","author":"张翥","text":"旅寓丹房夜，高城乍绝钟。\n蜡花烧烛短，乳面泼茶浓。\n山豁三更月，秋添四壁蛩。\n殷勤老贞士，清话得从容。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16461,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟行即事二首 其一","author":"张翥","text":"雾树浑连水，水沟不受潮。\n米盐江上舫，鱼菜市中桥。\n壮士宁辞辱，仙公会见招。\n边淮无酒禁，磊碨剩须浇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16462,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟行即事二首 其二","author":"张翥","text":"天水浑无际，中流明月轮。\n山形立积铁，潮色烂镕银。\n沙露冻粘石，海风寒薄人。\n舟师传吉语，沽酒祭江神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16463,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归来二首 其一","author":"张翥","text":"扰扰群生里，茫茫大化中。\n是非同喻马，得失一亡弓。\n买酒从贤浊，论文任鬼穷。\n此身河上鸟，只合信天公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16464,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"归来二首 其二","author":"张翥","text":"处士声华远，吾生志趣同。\n结庐犹洛北，避世即墙东。\n几见薰天富，俱成扑地空。\n虞罗谩机事，未许篡冥鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16465,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月一日之集庆望日次锡山宿玄文馆","author":"张翥","text":"海月光芒湿，川云意绪閒。\n刚风浮地外，元气满人间。\n野榜歌相答，渔灯去不还。\n电明知有雨，只在九龙山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日谒告归阻风御河","author":"张翥","text":"雨后风何暴，藏舟古岸阴。\n早霜红树遍，残月白河沈。\n鸥泛乘长浪，狐跳没远林。\n人生信淹速，那敢易初心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至通州","author":"张翥","text":"驿卒争鸣鼓，舟人喜下桅。\n依然今日到，却似去年回。\n岸黑秋涛缩，川红夕照开。\n君恩忘险阻，不觉畏途来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自悟 其一","author":"张翥","text":"古佛风翻盎，诗僧醉可朋。\n有生还有劫，无尽本无灯。\n蚤自楞伽悟，今非愿力能。\n此心宁万虑，于道只三乘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自悟 其二","author":"张翥","text":"海内虚游子，山中脱骨仙。\n一单如老衲，八十又新年。\n野马飞窗日，醯鸡舞瓮天。\n吾今丈人行，肯与众争怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上除日南山莲社期忏偕伯清昆季还饮南园","author":"张翥","text":"禊饮湖亭上，临流自祓衣。\n闰留春事晚，风打酒船稀。\n蛙子黑初出，桃花红欲飞。\n早霞知有雨，沾洒送人归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伯青邀予至青芝坞汎湖暮归","author":"张翥","text":"落日风花起，寒波倏渺然。\n山藏进雪寺，岸护种冰田。\n醉眼轻浮世，牢愁入暮年。\n若为湖一曲，携钓隐渔船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明游包家山 其一","author":"张翥","text":"远近红千树，繁开夺艳霞。\n月明寒食雨，春老上阳花。\n辇路迷游躅，宫词入梦华。\n东风葵麦浪，回首野人家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明游包家山 其二","author":"张翥","text":"太液曾来鹄，高台旧影娥。\n美人黄土尽，故国白云多。\n野草荒神籍，宫莲怨棹歌。\n羌儿洗马处，斜日满寒波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偕杨瑀元诚王炢自行湖堤閒步","author":"张翥","text":"湖上西风急，秋阴止杳冥。\n水痕连岸白，山色彻云青。\n蛰燕依深谷，还鸥下近汀。\n君歌我当和，有酒满长瓶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋试后胡益士恭归番阳与游吴山圣水寺","author":"张翥","text":"高处见沧溟，西风吹酒醒。\n潮来一片白，山拥万重青。\n草木如浮动，烟尘忽杳冥。\n登临不可极，吟思满秋汀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日偕李钦嗣游吴公弓台至雷塘蜀井","author":"张翥","text":"路绝平沙过，新塘水半乾。\n龙归雷雨恶，鹘没海天宽。\n县帜春醅熟，行厨野祭寒。\n此生无倚泊，随处得盘桓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月八日陪危太朴偕梁九思游城南三学寺万寿寺 其一","author":"张翥","text":"南城多佛刹，结构自辽金。\n傍舍遗民在，残碑好事寻。\n雨苔尘壁暗，风叶石床深。\n一饭蒲团了，萧萧钟磬音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月八日陪危太朴偕梁九思游城南三学寺万寿寺 其二","author":"张翥","text":"休日得连骑，高秋天气新。\n楼台惟见寺，井里半成尘。\n坏庙鬼无主，荒丘狐化人。\n千龄共须尽，回首一伤神。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"文昌楼望月时家已归浙上","author":"张翥","text":"今夜溪楼月，登临倍惘然。\n电光何处雨，风色欲秋天。\n历历灯缘岸，依依笛起船。\n江湖归路渺，回首白鸥前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清明日游东山谒栖霞岭仇先生墓","author":"张翥","text":"前辈凋零尽，南阳有古阡。\n诗应传四海，酒不到重泉。\n槐国真成梦，桃源亦是仙。\n松根一匊泪，惨淡堕风烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋日独行便上偶至清修寺","author":"张翥","text":"溪南野寺幽，巾舄偶相求。\n古道多黄叶，残僧半白头。\n远村高鸟暮，灌木乱蝉秋。\n此地茅堪剪，吾将卜隐丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月望观帝师发思跋影堂","author":"张翥","text":"佛子来西竺，巍然南面尊。\n法筵花散漫，香殿玉温黁。\n龙象诸天下，钟螺竟日喧。\n朝观立随喜，如在给孤园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九月六日宿宝集寺","author":"张翥","text":"来借禅房宿，悠然空客心。\n残僧几人在，古殿一灯深。\n檐铎能蕃语，斋居发海音。\n重阳又已近，聊复此登临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵莫景行秋雨喜晴","author":"张翥","text":"苦热不可忍，汗肤鳞甲生。\n雨分何处落，月在半天明。\n虫语迎秋早，川光入夜清。\n得凉忘坐久，河汉忽西倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"甲子元日夜大雪初三日立春始晴","author":"张翥","text":"几年无此雪，南国见应稀。\n平地深三尺，飞花大一围。\n银河乾彻底，白石烂生辉。\n润色饶梅柳，新春晓已归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南园宴集雨归有作","author":"张翥","text":"骤落菰蒲雨，遥生菡萏风。\n归云龙井黑，倒照凤山红。\n帘暮舟频引，衣凉酒屡空。\n歌声未可放，花底有惊鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辛未苦雨","author":"张翥","text":"禾田犹钜浸，春日复连绵。\n醉使呼堂上，饥人死道边。\n鹤神方下地，龙伯已行天。\n真宰如容问，吾心血可笺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"癸酉人日雨中","author":"张翥","text":"积雨将谋雪，新年未入春。\n半生如过客，七日又逢人。\n采胜天花小，香醪玉色醇。\n多忧亦何事，适意任天真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"与勃海孟芾景章守岁成居竹宅","author":"张翥","text":"此老无柴棘，襟期一见同。\n诗如孟东野，名是米南宫。\n把酒推年长，围炉到夜终。\n剩吟须剩醉，相对各衰翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"庚辰元日立春","author":"张翥","text":"采燕方迎岁，苍龙忽建辰。\n车书时有道，宇宙物皆春。\n红喜灯花重，青看菜甲新。\n屠苏不辞后，已是白头人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊子正月连雪苦寒答段助教天祐吉甫二首 其一","author":"张翥","text":"雪寒浑未解，风力更狂吹。\n强饭怜君瘦，重裘觉我衰。\n酒香红面颊，灯影黑须眉。\n黄鹤山中地，求田已有期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊子正月连雪苦寒答段助教天祐吉甫二首 其二","author":"张翥","text":"三年冗博士，四海老诗人。\n同是桑榆日，惟堪曲米春。\n清羸元寿相，肮脏任长身。\n微子谁知我，从来懒更真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月十四日习仪白塔寺有旨翥升院判","author":"张翥","text":"乍换朝衣紫，祗怜客鬓华。\n才知无补世，官喜不离家。\n海燕雏方乳，戎葵蕊未花。\n归来北窗卧，尘污满乌纱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月六夜对月","author":"张翥","text":"星会黄姑夕，天回白帝秋。\n明河初左界，大火渐西流。\n晚景逢多故，寒心集百忧。\n山林莽寥落，何处觅丹丘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乙未元日","author":"张翥","text":"稍稍钟鼓动，纷纷车马朝。\n张灯照白发，把酒送寒宵。\n黄石终归汉，洪厓反见尧。\n刍言欣见采，拭目望新条。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁除日","author":"张翥","text":"七十古稀有，欣然岁更新。\n换衣痴女喜，分粟故人贫。\n软饱须官酿，奇温爱絮巾。\n明当候云物，载笔纪王春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暴风","author":"张翥","text":"闭户复闭户，黄尘千丈生。\n不雨草无色，冲风人倒行。\n游子念乡土，腐儒忧甲兵。\n狂吹不肯息，终夜为心惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"长至日","author":"张翥","text":"至节得休暇，闭关宜燕居。\n孤怀愁易切，远信语多虚。\n寿酒教儿劝，祥云听史书。\n亲知半湖海，无地问何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大风时送友南城","author":"张翥","text":"南国碧云暮，西风芳草多。\n相思故人远，如此别情何。\n清绝山僧笔，苍茫楚客歌。\n凭将万里意，一问洞庭波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"啸亭为盐令贾策治安题","author":"张翥","text":"老子掀髯处，云间孤草亭。\n不妨舒逸气，直恐动精灵。\n风水划秋涌，鱼龙悲夜听。\n几翻流响歇，江冷越山青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题钦惟心山房三首 其一","author":"张翥","text":"普照南徐寺，苍苍祗树林。\n驮经惟白马，布地尽黄金。\n午梵钟声远，寒灯殿影深。\n由来世界黑，谁与一明心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题钦惟心山房三首 其二","author":"张翥","text":"朱方有真子，心印悟南宗。\n奏乐惟天女，听经化海龙。\n香凝行道席，灯照著衣钟。\n犹厌依城市，开门别种松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题钦惟心山房三首 其三","author":"张翥","text":"名山旦夕仰，方外宿心亲。\n业白到初地，性空无一尘。\n乞钟时出寺，坐夏不迎人。\n想见惟心叟，风凉满㲲巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辑山村先生诗卷 其一","author":"张翥","text":"昔在垂髫日，今吟薄暮年。\n床孤郗氏选，诗得谢公传。\n故国空戎马，荒山冷墓田。\n祗令后死者，忍泪读遗篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辑山村先生诗卷 其二","author":"张翥","text":"卷可留天地，诗尝泣鬼神。\n游仙归化鹤，披发下骑麟。\n素望高前辈，青衫老此身。\n栖霞石表在，终古不成尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"金山桥上闻苑池荷香","author":"张翥","text":"立马金河上，荷香出苑池。\n石桥秋雨后，瑶海夕阳时。\n深树栖霞早，微波浴象迟。\n烦襟一笑爽，正喜好风吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵题大雷山桃源汪氏桃隐 其一","author":"张翥","text":"幽甚南雷路，尝闻故老传。\n墟通卖鱼碶，潮入种蚶田。\n棂子浑成树，桃花不计年。\n山中多佛寺，灯火肃芊芊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵题大雷山桃源汪氏桃隐 其二","author":"张翥","text":"南北二十里，两山中过云。\n采芝随鹿去，拾果与猿分。\n酒熟青田核，羹香碧涧芹。\n非君播诗句，那得世人闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鉴堂上人招余游慧山行舟不成往因寄","author":"张翥","text":"竟负山游约，长怀第二泉。\n毁茶休著论，载酒谩回船。\n会摘春林雨，来寻午灶烟。\n从师坐联句，祗恐废安禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"大风","author":"张翥","text":"彻昼风何急，避行陵树傍。\n惊沙扑面黑，野日映人黄。\n科斗旱未出，栗留寒欲藏。\n穷途泪易下，不是阮生狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七月旦立秋风雨夜寒","author":"张翥","text":"练裯不解暖，已索絮衾眠。\n老疾日渐退，馀生天所怜。\n蝎行窗纸响，蛾扑烛花偏。\n喜见沽头报，江南有到船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"默坐","author":"张翥","text":"默坐观浮世，何殊起灭云。\n猿寒夜嘷母，鸦急晚追群。\n应俗神嗟耗，经冬足苦皲。\n俸香吾独喜，日可炷炉薰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夕","author":"张翥","text":"坐玩群儿戏，閒供一笑欢。\n朱丸那却鬼，白酒不禁寒。\n官索题春帖，邻分馈岁槃。\n归期知几日，谩检历头看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初三日夜玩月至中秋日得诗 其一","author":"张翥","text":"化工金铸巧，又换一钩新。\n远道伤游子，深闺喜拜人。\n影县秋半破，明溯日西沦。\n正拟排宵看，裁诗莫厌频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"初三日夜玩月至中秋日得诗 其二","author":"张翥","text":"新月过初弦，冰轮次第圆。\n空中真见相，清极恍如仙。\n旧雨苍苔地，新寒白露天。\n匡床延伫久，不觉屡移前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼太平公","author":"张翥","text":"晨起洒杯酒，北风吹泪痕。\n岂徒歌楚些，端欲叫天阍。\n碧化苌弘血，春归杜宇魂。\n千秋一史笔，谁辨逐臣冤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅隐为蕃禧观余道士作二首 其一","author":"张翥","text":"隐者多幽事，锄云自种梅。\n几盘山径术，强半雪莓苔。\n拾药泥丹灶，浮香入酒杯。\n时时霞上友，清晓踏寒来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅隐为蕃禧观余道士作二首 其二","author":"张翥","text":"茅屋西林下，逋仙恐是君。\n支筇鹤外见，哦句竹边闻。\n老树春常早，空山雪不分。\n道人无梦久，何处觅梨云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄云门僧若邪溪兼题其松风阁二首 其一","author":"张翥","text":"闻道邪溪叟，高年出寺迟。\n眉毫长几许，布衲破多时。\n挂锡鹤移树，翻经花满池。\n相望一江水，岁晚赴幽期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄云门僧若邪溪兼题其松风阁二首 其二","author":"张翥","text":"阁外老松子，萧萧虚籁生。\n定从何处起，宁有不平鸣。\n我耳固师耳，风声是树声。\n他时叩禅寂，衲破睡天明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"识趣斋为山阴魏仲远赋","author":"张翥","text":"夏盖湖滨宅，幽然水竹开。\n庄前鱼市合，山下酒船来。\n把钓云移树，寻诗步石苔。\n相羊总成趣，直待醒心回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送泐季潭游天台并送渊侍者归天台二首 其一","author":"张翥","text":"来从石城寺，去访石桥僧。\n锡杖空山路，禅龛独夜灯。\n道知文畅得，诗识皎然能。\n到日西岩下，应吟瀑布淜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]