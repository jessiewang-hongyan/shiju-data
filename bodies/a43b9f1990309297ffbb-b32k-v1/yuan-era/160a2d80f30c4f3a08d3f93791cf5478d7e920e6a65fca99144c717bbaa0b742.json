[{"title":"咸阳王功德诗 其一","author":"吴当","text":"在昔皇祖，有赫神武。\n维忠宣王，杰出西土。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19963,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其二","author":"吴当","text":"佐命而兴，来受圭组。\n宪宗伐蜀，往补戎伍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19964,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其三","author":"吴当","text":"于穆世皇，天戈载扬。\n亲拔云南，用逖蛮方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19965,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其四","author":"吴当","text":"滇之宗臣，乃悖纪纲。\n复叛不顺，袭盗以狂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19966,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其五","author":"吴当","text":"天子曰嘻，孰称予使。\n爰命忠惠，以绥以抚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19967,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其六","author":"吴当","text":"谕之恩信，涤汝烦苦。\n简节疏目，咸得理所。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19968,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其七","author":"吴当","text":"乃疆乃理，奠尔城邑。\n市有居货，屋有陶甓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其八","author":"吴当","text":"我田我池，粳稌黍稷。\n训厥士女，污俗斯革。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其九","author":"吴当","text":"既庶既富，建学立教。\n笾豆鼓钟，于乐孔庙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十","author":"吴当","text":"诗书歌弦，孰则孰效。\n折其狂猘，笃尔忠孝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十一","author":"吴当","text":"步不出国，侯幽侯深。\n部曲联绎，干戈若林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十二","author":"吴当","text":"久而弥孚，向义骎骎。\n锡贡无已，大赂南金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十三","author":"吴当","text":"天祚皇国，克生伟人。\n历年孔多，以福远民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十四","author":"吴当","text":"远民之安，克顺克正。\n惟王之贤，天子之圣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十五","author":"吴当","text":"元臣云亡，远民孔哀。\n风马云车，曷往曷来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十六","author":"吴当","text":"新庙既作，执事有恪。\n王其享兹，用配诸葛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十七","author":"吴当","text":"锡爵启封，皇则悼之。\n嗣德象贤，天实报之。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咸阳王功德诗 其十八","author":"吴当","text":"诜诜孙子，有引无替。\n太史作诗，式昭永世。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"性乐堂诗 其一","author":"吴当","text":"繄厥成性，浩然其天。\n灵明洞彻，溥博渊泉。\n万物毕备，众善具全。\n反身而诚，乐莫大焉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"性乐堂诗 其二","author":"吴当","text":"惟尔学者，夙夜有恪。\n循端致曲，实充实扩。\n昭兹本善，以踵先觉。\n观其回通，亦底克乐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"性乐堂诗 其三","author":"吴当","text":"翼翼高堂，攸介攸宁。\n天光丕容，匪间显冥。\n灼之当为，勇往是程。\n其则不远，勒诗在楹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其一","author":"吴当","text":"瞻彼嘉木，太行之阴。\n盘盘幽谷，侃侃素心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其二","author":"吴当","text":"缅焉兴怀，古道是式。\n惟心之宜，至当有则。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其三","author":"吴当","text":"我其扩之，制事不违。\n用达万变，审乎先几。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其四","author":"吴当","text":"灼知勇为，乃积乃充。\n无间微显，集于厥躬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其五","author":"吴当","text":"浩然之生，实匪助长。\n天地之塞，吾体同量。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集义斋诗为太行高氏作 其六","author":"吴当","text":"肃尔斋居，永端于初。\n必有事焉，昭昭圣谟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致亭诗 其一","author":"吴当","text":"瞻彼绎山，绵绵其麓。\n爰有君子，乐尔贞卜。\n有倬斯亭，荫此嘉木。\n悠悠永歌，衍衍春服。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致亭诗 其二","author":"吴当","text":"先民有觉，昧兹寡闻。\n我其致之，匪学曷敦。\n问辨言析，反思其存。\n焕若融彻，大明初暾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致亭诗 其三","author":"吴当","text":"顾瞻周行，玄邈奚绪。\n曷其致之，惟圣有矩。\n我车既坚，我马孔阜。\n无远弗至，式谷尔御。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致亭诗 其四","author":"吴当","text":"潏彼川流，昼夜斯逝。\n溯溯无端，原原无已。\n于惟缉熙，不杂不二。\n我是用希，夙夜敬止。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"致亭诗 其五","author":"吴当","text":"既种既耨，廪积孔殷。\n既狩既猎，鼎餗具陈。\n秩秩大猷，俛焉日新。\n勖尔尚友，予亦何人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其一","author":"吴当","text":"惟皇降衷，弗忚弗亏。\n习远情肆，始沦以隳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其二","author":"吴当","text":"有卓君子，励行自修。\n夙夜惕若，反躬是求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其三","author":"吴当","text":"孰去孰存，惟日内省。\n百鏬勿遗，靡伺靡骋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其四","author":"吴当","text":"脩省之始，尤慎在独。\n勇绝其萌，庶制尔欲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其五","author":"吴当","text":"于赫斯临，昭昭幽深。\n毋苟自欺，其敢弗钦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":19999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其六","author":"吴当","text":"矧兹明威，曷敢戏豫。\n战兢自持，主一无二。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其七","author":"吴当","text":"燕居观象，恒若荐雷。\n益慎益戒，万善具来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其八","author":"吴当","text":"审之靡疚，式底于完。\n信立愿达，克承克安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其九","author":"吴当","text":"吾侪小人，贪欲内锢。\n甘心物欲，有寐有寤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"脩省斋诗 其十","author":"吴当","text":"为之由己，曷自暴弃。\n呜呼灵台，幸勖尔志。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其一","author":"吴当","text":"于昭秉彝，有本有支。\n立爱惟亲，万善是基。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其二","author":"吴当","text":"衎衎令子，报德慈母。\n菀兹堂构，有翼其宇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其三","author":"吴当","text":"鱼轩戾止，兄弟具在。\n执礼循循，百福攸介。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其四","author":"吴当","text":"旨甘孔时，春酒载筵。\n天锡纯嘏，眉寿永年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其五","author":"吴当","text":"哺乌在林，遗我好音。\n起处攸宁，式慰母心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其六","author":"吴当","text":"琴瑟静好，以雅以南。\n式歌且舞，朱衣华簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其七","author":"吴当","text":"既曰寿只，实在宁只。\n夙夜凊温，庶其敬止。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寿宁堂诗为冀宁耿氏作 其八","author":"吴当","text":"敦孝移忠，永锡不匮。\n矢诗孔扬，以勖来裔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月朔都门别友","author":"吴当","text":"昨日送春归，今朝送君去。\n君去几时来，春归向何处。\n都门柳千行，晴空正飞絮。\n祇恐尊酒空，离情渺无据。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"拂云堂","author":"吴当","text":"脩竹临绿水，高堂散清阴。\n猗猗岁寒操，皎皎君子心。\n不承春阳媚，已觉秋露深。\n仰止云汉上，高节慎所任。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤冈隐居 其一","author":"吴当","text":"凤凰千仞冈，中有隐者庐。\n流水绕屋下，青山当座隅。\n邻曲不在多，聊可共耕锄。\n种菊秋露重，斸花春雨馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤冈隐居 其二","author":"吴当","text":"松下挥鸣弦，凉风满庭除。\n振衣红尘表，濯缨清水渠。\n虚名果何益，此乐将焉如。\n伊人幸同姓，行矣巾吾车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送刘山人远游","author":"吴当","text":"初夏风日清，芳华尽披委。\n萧萧野人居，绿树净如洗。\n繁阴在庭户，晴云隔窗纸。\n刘君负绝艺，幽讨亦戾止。\n平生一緉屐，历历几千里。\n南袖岭峤烟，东拂扶桑水。\n空斋坐终日，论议颇亹亹。\n言立罔迷真，浩瀚况无已。\n群流会一原，众辙不殊轨。\n昆仑倚西极，黄河走其底。\n嵩华与恒岱，郁郁土中峙。\n休气蓄灵光，自惜伯玉址。\n结交燕赵豪，跃马长杨里。\n堂堂百年身，兹游更奇伟。\n酌酒浇壮怀，奋步从此始。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送曾冲衍自甥馆归省","author":"吴当","text":"慨我林壑姿，高思凌云烟。\n清秋到城邑，兼旬得留连。\n耆旧颇凋谢，新知多少年。\n曾君金川彦，胤胄本蝉联。\n华姻照高阅，玉树来鸾鹓。\n自小涉书史，已能缀诗篇。\n相值阛阓间，被服华且鲜。\n间亦能我即，辞气自温妍。\n而翁富文学，传家有渊源。\n十年不相见，使我心悁悁。\n奇骨出名驹，风采固超然。\n尔邑危处士，其人萟且贤。\n词高连城价，字重青瑶镌。\n汝能早入室，累岁相周旋。\n吾闻古人学，忠信盖所先。\n彝伦本日用，昭著无幽玄。\n本干既有立，华实自芬蕃。\n愿言勤孝弟，馀力及艺文。\n友道贵责善，我歌匪虚言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同诸彦泛舟游","author":"吴当","text":"移舟荡绿水，棹击来清风。\n山树接天碧，汀花向日红。\n圭璋益良朋，群簪得相从。\n窈窕杨柳外，逶迤墟里东。\n微雨洒芳郊，流水度晴虹。\n渔歌日暮起，清响紫烟中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日江楼分韵赋采字","author":"吴当","text":"江上秋风多，客里时序改。\n嘉菊空满目，幽香为谁采。\n江楼对西山，物景颇潇洒。\n山云寒冉冉，汀树晴蔼蔼。\n何以慰今朝，浊醪向邻买。\n野馔在盘餐，梨栗杂醯醢。\n眷兹二三友，被服盛兰茝。\n举盏送飞鸿，翩翩望沧海。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋灵碧石山子","author":"吴当","text":"卷石重拱璧，致之果何从。\n隐几当翠微，娟娟秀芙蓉。\n艮岳玄雾温，香炉紫烟重。\n五老不可见，令我忆鳌峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吾安之令渤海县","author":"吴当","text":"奉诏出高阙，驱车向长河。\n长河正奔崩，大野仍横戈。\n宵衣动深忧，频岁秋无禾。\n今君宰渤海，敷政当如何。\n上以畅皇惠，下以拯民疴。\n清宫执道要，直气排洄波。\n东郊散壶榼，月户鸣机梭。\n境内鸡犬静，垄头牛马多。\n游人若云环，窭室皆春和。\n遄归赞天纬，报最无蹉跎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汪氏桃溪先业","author":"吴当","text":"种桃作春华，插柳被涧阿。\n飞梁度窈窕，峭壁缠烟萝。\n游息各有地，简编足吟哦。\n宜有遁世者，看云时一过。\n先庐倚丘坟，岁晏伤如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送丑时中安陆知府","author":"吴当","text":"烝庶日凋敝，久贻宵旰忧。\n中原有斗格，陋室仍诛求。\n又闻大河奔，无复桑田收。\n群情自嗷嗷，时论空悠悠。\n下诏选朝士，传声典方州。\n及兹数年来，令牧颇清修。\n皇帝威信布，膏泽亦下流。\n用副民社寄，庶答廊庙谋。\n君才已历试，儒术素所优。\n寒露承冰壶，黄钟播天球。\n楚郢古名邦，廛市接车舟。\n人多尚游贩，野有良田畴。\n坐令书牒稀，行见疮痍瘳。\n香凝棨戟静，雨洽桑麻稠。\n问俗在抚摩，敷政尚怀柔。\n三年屡丰穰，五裤成歌讴。\n最书举劳绩，归来奏宸旒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送李伯微山东廉使赋华不注峰","author":"吴当","text":"华峰秀亭亭，缥缈风雨会。\n湖光纳空翠，元气蓄冥昧。\n云来泰山颠，日出方丈外。\n孤根奠地轴，万木动天籁。\n危攀望不极，高致君应最。\n使节无滞留，都人仰旌旆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送赵大本西台御史得一字","author":"吴当","text":"关陕古雄都，四塞若天室。\n圣人物土贡，沃壤称第一。\n皇威极西邮，声教无远昵。\n崇台揽纪纲，郡国底宁谧。\n赵君金闺彦，楚楚冰玉质。\n出身翰墨场，已执太史笔。\n朝峨惠文冠，夕策长亭驲。\n弭节都门道，供帐集簪韠。\n朔风吹秦陇，岳色寒崒嵂。\n泾渭扬浊清，河水相荡潏。\n皇皇霜简动，肃肃绣衣出。\n丈夫报国心，重在理仁术。\n矧兹圣明时，布衣靡阙失。\n胡为守牧宰，往往败绳律。\n饥渴剧饫饕，民隐讵遑恤。\n岂无循良才，众丑成妒嫉。\n遂令白黑挠，惩劝恒过实。\n周询待摩抚，伺察到微密。\n于焉振风采，勿使废彀率。\n遄归报明廷，烟柳动春日。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西屿书堂","author":"吴当","text":"高堂在西屿，积水宜清秋。\n飞梁接广衍，松竹何翛翛。\n草色洲渚净，书声庭户幽。\n美人水苍佩，公子木兰舟。\n及兹且容与，乐哉以忘忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"横州新城","author":"吴当","text":"守国设险阨，由来固金汤。\n天下已一家，四海无封疆。\n边夷失摩抚，虚邑奔豺狼。\n横州两江上，妖氛日相望。\n烈烈四野焚，哀哀万民疮。\n倪君列半刺，为政古循良。\n及兹幸辑睦，庶以安苍黄。\n兵威尚形势，邦本资堤防。\n版筑不辞劳，恩波浩难量。\n神功实天相，良甓发地藏。\n遂令千年间，集此百雉强。\n坐见云鸟陴，居然山水乡。\n嵯峨超楼橹，迢递蟠池隍。\n落日笳鼓壮，寒风旌旆扬。\n廛区表井里，公馆临康庄。\n蔼蔼闻士誉，熙熙浃时康。\n从兹慎备禦，奚用多斗伤。\n长松在涧底，至宝委道傍。\n鸾栖自枳棘，鹓路空翱翔。\n谁持太史书，为贡白玉堂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢灵运小像","author":"吴当","text":"达人不偶俗，穷乃托遐踪。\n海上采石华，山头接云松。\n旷情凌霄外，长笑紫烟重。\n白驹不可絷，矫若人中龙。\n世诐道已微，君子固有穷。\n多才竟为累，寡立复谁从。\n凄凉贝锦诗，千载仍忡忡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兰石竹树图","author":"吴当","text":"光风被丛兰，秀气何绸缪。\n竹树露已深，萧萧苔石幽。\n亦有纫佩者，襭芳在中洲。\n含情欲谁寄，湘水何悠悠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渊明图","author":"吴当","text":"窈窕墟里烟，崎岖抚遐踪。\n松菊在三径，归来事春农。\n乘化乐天命，千古垂高风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菊泉轩","author":"吴当","text":"种菊秋水上，泉甘花更妍。\n掇英挹朝露，牵萝媚清涟。\n衡门幽且閒，沦迹托贞坚。\n浊酒有深趣，乐哉以忘年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送立道","author":"吴当","text":"清笳动城阙，落叶响空井。\n羁客增远怀，繁霜集寒景。\n依依塞鸿度，杳杳江路永。\n昨夜梦沧洲，朝来理烟艇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":20033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]