[{"title":"鳌峰宜晚亭","author":"张雨","text":"鳌峰亭子偏宜晚，约下烟光与细看。\n独鹤归来频寄语，夕阳舂外一凭栏。\n昔游谢眺空陈迹，回首敬亭生莫寒。\n万一桑榆容倦翮，西飞会访毛公坛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"铁笛道人新居曰书画船亭作诗以寄","author":"张雨","text":"苏州去访扬雄宅，近水楼居似月波。\n东府官曹知者少，西山爽气望中多。\n台招天上仙人凤，池养山阴道士鹅。\n谁和淳风吹铁笛，莫愁艇子柳枝歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄杨廉夫郑明德","author":"张雨","text":"快雪时晴春意动，归舟移缆向方塘。\n走寻饮伴鸡豚社，误落诗名锦绣场。\n子云奇字谁能问，郑老襟期独不忘。\n阖闾城中可终老，安得四万买沧浪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马伯庸中丞桐乡阡迁祔有旨赐碑名肇文开善有诗次韵","author":"张雨","text":"公家阡表似泷冈，总为能文补舜裳。\n龙耳当承天子问，龟趺重表郑公乡。\n异时将相宁无种，此举邦家亦有光。\n想见丹书映丛桂，淮南无地著秋香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题陈渭叟紫云编用张仲举韵","author":"张雨","text":"葛溪观主陈渭叟，高行绝人诗益工。\n明月双珠好奇服，閒居七言成变风。\n大茅独立云在下，小史久住江之东。\n吴筠寥寥五百载，唯我与君相长雄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"新栗寄云林","author":"张雨","text":"朅来常熟尝新栗，黄玉穰分紫壳开。\n果园坊中无买处，顶山寺里为求来。\n囊盛稍共来禽帖，酒荐深宜蘸甲杯。\n首奉云林三百颗，也胜酸橘寄书回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西爽轩次韵韩致用","author":"张雨","text":"大名谁及河东老，为爱幽轩肯赋诗。\n沆瀣一杯凌倒景，阑干几曲带清漪。\n徒闻东海投竿去，不似西山拄笏宜。\n两岸菰蒲鱼鸟乐，系船犹带绿杨丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答董子羽见寄","author":"张雨","text":"清都闻已住多年，鹤驾鸾骖与后先。\n阊阖五云宫树暖，蓬莱初日羽衣鲜。\n神仙翰墨唯皇象，史馆人材总孟坚。\n天上春风如旧识，殷勤吹送寄来篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄渭清远记室","author":"张雨","text":"大石坠腰勤苦行，此生深愧老卢能。\n雨留涧下三板水，苔卧窗间七尺藤。\n清壑钟传晨放梵，云门诗到夜挑灯。\n凭君试问龙河隐，政在钟山第几层。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴兴舟中","author":"张雨","text":"苕溪斫鲙腹偏腴，取酒乌程清若无。\n最怜杨柳破二月，绝胜蛾眉游五湖。\n船头濯足畏鱼淰，港口卸帆惊鸟呼。\n林峦在处著舟楫，倘有剩田吾欲租。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵倪元镇赠小山张掾史还寄元镇","author":"张雨","text":"为爱髯张亦痴绝，簿领尘埃多强颜。\n何如膝上王文度，转忆江南庾子山。\n绿树四邻悬榻在，青溪千仞荷锄还。\n风流耆旧凋零尽，莫怪参军语带蛮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"元统甲戌夏五月既望余客义兴王氏怀庆堂十又八日偕士友张德常谒张公洞得七言诗一首寄住山陈长卿周仁仲","author":"张雨","text":"路入秋阴罨画间，弭节洞灵俱启关。\n东皇衣覆云雾海，玉女盆盛人鸟山。\n牵骡步步迹石髓，投龙往往祝金环。\n茅家小史岂尘土，此地一游聊解颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴石居使君寿八十","author":"张雨","text":"若翁腰带玉围虹，剩喜今年八十同。\n食邑尝为骁骑尉，入城争识鹿门公。\n车回晚望蓬莱日，帽卸凉梳菡萏风。\n儿子去为真学士，未应园绮住山中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴养浩江浙提学任满侍亲归番阳","author":"张雨","text":"稳送归帆向锦江，西湖能负白鸥双。\n书中久已知梁鹄，床下时曾拜老庞。\n封还画省文章印，盛取玉堂云雾窗。\n荣禄乡中会耆旧，开筵应酿酒盈缸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题彭大年祷雨诗卷和仲举韵延祐己未开玄道院作","author":"张雨","text":"羽衣秋薄剪湘荷，茅屋山宫补绿萝。\n白石资方青䭀饭，洪厓借乘雪精骡。\n松云暖忆春游岳，冰草寒怜晓度河。\n使节南归如见念，峰头笙鹤好相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼鹤","author":"张雨","text":"羽毛冻损雪襕斑，碧落游魂杳不还。\n和靖船归笼尚闭，浮邱经在寿能悭。\n长身被裹玄黄内，旧迹苔封紫翠间。\n欲撰瘗铭修故事，寄书先报九华山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和实喇卜郎中上巳湖上道宫韵","author":"张雨","text":"望湖楼观似山阴，水边丽人同赏心。\n槐火新泉还有梦，玉鱼葬地已无金。\n三潭雨压蛟龙睡，半岭风传鸾凤音。\n拟续临河修禊事，尘埃茧纸不堪临。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代溪月翁和吴宗师所寄赐酒感兴诗韵","author":"张雨","text":"年年恩霈出皇家，此度仍回八月槎。\n望阙苍龙分瑞霭，开樽白兽泻流霞。\n笺天久已知心事，鉴水唯应换鬓华。\n遥想新春供大礼，班头对御祝椒花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳道传送别还茅山次韵复谢","author":"张雨","text":"乌蜀先生相见稀，钟陵初载橐书归。\n江南萧艾作人立，卷里卢龙看雪飞。\n最怜玉斧有道气，重惜子真犹布衣。\n去去空山相忆夜，朱弦三叹为君挥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵题吕氏园馆","author":"张雨","text":"因向云间求二陆，西施浦口弄云沙。\n东风勒住螭头舫，微雨催开茧粟花。\n到处华房通曲密，旧时醉墨误欹斜。\n一声歌板银瓶侧，亦见玉童双髻鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和坡仙寒食诗","author":"张雨","text":"寒食今年二月晦，又分新火到厨烟。\n碧桃花落閒谁埽，白苧衣轻老更便。\n发箧但馀金薤墨，考年正在玉堂编。\n大书绝类颜光禄，小字骎骎逼墓田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵实喇卜郎中春游二首 其一","author":"张雨","text":"杨柳三眠午未醒，杨花飞雪散星星。\n海中蜃气春浮岛，月下胎仙夜降庭。\n尺素书来云锦织，紫鳞跃处浪纹腥。\n楼前政有三株树，剪断西山一半青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次韵实喇卜郎中春游二首 其二","author":"张雨","text":"邻近桃源鸡犬家，不缘迷路得看花。\n衣裳总湿三危露，服食唯消五色霞。\n鹤冢浪磨崖上字，渔舟潮阁渡头沙。\n石盘棋子都狼藉，莫向人间问岁华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"欧阳巡尉遇仙卷","author":"张雨","text":"宝圭风洞鼓钲鸣，独挈仙壶一世惊。\n勾漏丹砂还道术，泷冈阡表足家声。\n芙蓉城小花周匝，枸杞丛深犬吠迎。\n不上飙梯十二级，白头空愧学长生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"伏蛟台胡道玄请题伯生有记","author":"张雨","text":"豫章自昔旌阳宅，借问仙都已劫灰。\n西山应无剪柏处，东湖遂有伏蛟台。\n千年铁札化为石，十日阴风怒若雷。\n妖孽不生寰海静，五陵佳气待君来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浴鹄湾题壁","author":"张雨","text":"洑流乱石幽栖地，子美诗中萧史家。\n白发羽衣元自称，风流异代不须嗟。\n竹缘迮径篱编笋，丛碍低垣雨卧花。\n岂少烟霞閒艇子，一枝聊赠老生涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送姚焕章还京口兼简张率性","author":"张雨","text":"江乡人事凋讹尽，人日题诗复送行。\n十载归来访邻里，他年科第属门生。\n春泉暗动金沙井，晴雪微椷铁瓮城。\n推官厅有诗人住，閒暇相求一寄声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和丹邱生悼吾子行书遗墨后","author":"张雨","text":"故人亦复葬江鱼，空向人间忆子虚。\n月下箫閒留谱在，竹边房冷倩谁居。\n蓬莱都水题金简，汲冢先秦见漆书。\n惟有研山磨不朽，时时泪滴玉蟾蜍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月十五夜待月","author":"张雨","text":"移床露坐閒临水，浴鹄湾头足芰荷。\n秋已平分催节序，月还端正照山河。\n老怜宋玉生悲思，狂忆桓伊作浩歌。\n云汉茫茫一卮酒，白头惭愧古人多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵韩伯清见寄","author":"张雨","text":"尘海幽居似地仙，满床堆笏是家传。\n座中桃李春风酒，郭外桑麻杜曲田。\n倚盖一松扶偃蹇，影娥片月弄婵娟。\n池边草色撩诗思，未觉才情让惠连。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月山石诗","author":"张雨","text":"拾得金钱溪上石，小峰如弁立云根。\n他山鸟道隔千里，新月蛾眉见一痕。\n入林误踏金蟆背，激水犹思雪浪盆。\n拟就漫郎呼酒舫，石鱼湖上共洼尊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春将过半病怀索莫惜无可与言诗者得句自遣山泽癯者云","author":"张雨","text":"一一花栽绕屋庐，半春多病意何如。\n缘诗太瘦终无补，与酒全交渐要疏。\n研席留香非长物，斋庖得笋是佳蔬。\n鹤群呼唤来同饮，新绿溅溅已满渠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"士弘贤良猥赠佳什空山真有似人之喜即与奉和所望为晚菊一来山也丙戌夏作","author":"张雨","text":"南州高士秪徐君，野鹤昂然自不群。\n心似寒潭冰下水，身如秋岭雨馀云。\n艺兰何待樵青斧，酾酒难寻李白坟。\n为问别来能几日，城中消息了无闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方泳道令尹水竹亭","author":"张雨","text":"水竹亭子在花山，输与幽人日倚栏。\n苍雪四檐迷䆗窱，绿波三面浸琅玕。\n扶行绿竹鸠形杖，濯足金沙鸭嘴滩。\n几树甘棠同召伯，更留清节比方干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"善权山洞","author":"张雨","text":"善权离墨争盘纡，浩劫磥砢仙人庐。\n莘莘石林压水府，往往阁道通楼居。\n壁藏已出黄素卷，穴处尤多青绿鱼。\n爱此长连煮药灶，待我盥漱沾遗馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次松瀑黄尊师寓筹峰韵","author":"张雨","text":"保大谁传墨半规，笔踪惊见十年迟。\n风流丘壑真吾事，名教衣冠异昔时。\n书别左公寻解剑，酒深东老独留诗。\n谷山长在通玄顶，笙鹤相过自有期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"快雨喜晴而开阳室适成赋诗自慰","author":"张雨","text":"春来耽酒仍耽困，一枕雨声如蜜甜。\n老锸栽松宁有待，饥肠食笋独无餍。\n峰连笔格安空翠，泉入茶垆斗谷帘。\n吾爱吾庐聊复尔，少留佳日在茅檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"女仙江静真碧游仙词","author":"张雨","text":"衣剑符图有子传，生如孤凤蜕如蝉。\n方留橘叶聊供母，谁信桃枝已得仙。\n萧索帘帏通素月，玲珑环佩曳空烟。\n麻姑坛上花姑老，想共乘鸾欲著鞭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越灵峰寺之松风阁","author":"张雨","text":"溪谷风声何瑟瑟，啸歌长在两长松。\n金鸡翔舞不多见，青壁夤缘知几重。\n花时扫阁黄尘满，泉处凿厓甘露浓。\n待我与携笙鹤去，香炉对面礼陶峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"笔冢","author":"张雨","text":"退笔如陵那忍弃，敛藏数笼瘗岩阿。\n管裁犀象宁同殉，研历冰霜尚可磨。\n兔窟早空金椀地，鹅峰深润墨池波。\n毛颖有灵应感遇，秦恩自少主恩多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次桑善止韵是日廉夫杨尹见访","author":"张雨","text":"发脱冠欹衰态多，日长犹赖饮无何。\n阿对泉头布衣老，谢公墩上美人过。\n青松岂代麈尾柄，如意莫击珊瑚柯。\n挍书天禄馀事耳，迟子考槃同涧阿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵王文友送游张公洞","author":"张雨","text":"庚桑成道来孟峰，再拜摄衣升故宫。\n馨香果核犹可拾，颠倒云气长相蒙。\n有时月明钟磬发，绝顶涛声舟楫通。\n看从便道之五岳，腰插骡鞭追老翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再次倪元镇韵","author":"张雨","text":"嗜石未数奇章公，太湖洞庭无此峰。\n便拟翻身入青壁，谁见抱膝哦长松。\n乳香从令飞鼠饮，绝路或与樵人逢。\n玉女下房不可到，只许云气随飞龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄一峰画贞居图","author":"张雨","text":"北苑南宫凝绝笔，蟠胸磊磈若为裁。\n按图宁在多多许，落墨真成滚滚来。\n百折丹梯凌涧道，一川燄水动湾洄。\n时清谁问商于路，乞我西山锦绣堆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代玄览真人次虞伯生见寄韵","author":"张雨","text":"屋倚松杉路拥莎，金鳌小隐且婆娑。\n几年有约遥相望，一棹何时肯见过。\n老去山中空岁月，秋来江上政风波。\n黄花满眼香醪熟，对此其如逸兴何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"又次韵","author":"张雨","text":"别后惊心岁已驰，几回草梦绕春池。\n新诗远寄迢遥驿，旧约重看绝妙碑。\n鳌禁风清班缀玉，龟溪雪冷鬓垂丝。\n何时共执论文酒，坐对西窗待月迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠姜彦翁秀才","author":"张雨","text":"科举恩沾乡贡榜，学校例贡诸生员。\n多岐取士从润色，百骸受蠹争夤缘。\n穷巷授徒缺养母，普天为吏横索钱。\n妙年立身在择术，老生常谈无弃捐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和黄晋卿提举忆旧诗","author":"张雨","text":"支许何能接王谢，山阴图画略相同。\n能留茧纸真奇事，爱养鹅群少道风。\n苔树斲冰春未破，花瓷削雪酒如空。\n深惭故旧相料理，肯使牢愁坐五穷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天师素华阁","author":"张雨","text":"仙家楼阁风尘表，更筑凌空月榭高。\n虚白岂知存夜气，太清还许隔秋毫。\n溪光澹澹冰填壑，松响离离雪舞涛。\n此去银桥通咫尺，神仙直下有灵鳌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"碧筒饮","author":"张雨","text":"采绿谁持作羽觞，使君亭上晚樽凉。\n玉茎沁露心微苦，翠盖擎云手亦香。\n饮水龟藏莲叶小，吸川鲸恨藕丝长。\n倾壶误展琳琅袖，笑绝耶溪窈窕娘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上京赐宴王眉叟有诗次韵","author":"张雨","text":"从事何缘过草堂，行都遣赐玉壶方。\n远劳使者红尘骑，烂煮仙家白石羊。\n中圣敢辞千日醉，承恩独许四明狂。\n金茎剩有三清露，润及葵心向太阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其一","author":"张雨","text":"不爱昆冈玉，不爱江汉珠。\n爱己有苍璧，有之利有馀。\n吾生为我有，其利当何如。\n论爵不足贵，论富不能踰。\n达生命之情，顺生以自娱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其二","author":"张雨","text":"荆人有遗弓，索之将奚为。\n且荆人遗之，乃荆人得之。\n孔子闻之曰，去其荆可耳。\n老聃闻则曰，去其人可矣。\n天下有至公，孔聃得其理。\n天地且弗有，莫知其所始。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其三","author":"张雨","text":"墨子叹染丝，所叹一何长。\n染于苍则苍，染于黄则黄。\n奚独染丝然，染国在所当。\n有染如伊皋，禹汤称圣王。\n殷纣染恶来，既染国亦亡。\n染士如孔聃，死久道弥光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其四","author":"张雨","text":"鲁君聘颜阖，踰垣避使者。\n我非恶富贵，君胡独不舍。\n全生以为上，迫生以为下。\n当知得道人，治国其土苴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其五","author":"张雨","text":"虞人百里奚，所鬻五羊皮。\n有得其说者，乃是公孙枝。\n献诸秦穆公，四境不足治。\n贤者倘不遇，后世谁当知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其六","author":"张雨","text":"昔者齐桓公，往见小臣稷。\n一日凡三至，欲见且弗得。\n骜爵固轻主，骜霸亦轻士。\n大夫纵骜爵，骜霸吾敢尔。\n所以终见之，不为从者止。\n谁云内行缺，论霸亦可矣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其七","author":"张雨","text":"桓公遇宁戚，饭牛中夜起。\n赐之以衣冠，一说境内理。\n再说为天下，桓公以师事。\n卫与齐不远，安用疑客子。\n不患有小恶，所患亡大美。\n且人固难全，用长当若此。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其八","author":"张雨","text":"业烦则无功，礼烦则不庄。\n令苛则不听，禁多则不行。\n国人逐狡兔，因之杀子阳。\n严刑无所赦，适见召乱亡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其九","author":"张雨","text":"齐有善相狗，假买取鼠者。\n数年不取鼠，畜之不如舍。\n相曰实良狗，志在獐麈鹿。\n欲观取鼠能，请桎其后足。\n桎足乃取鼠，淹尔骥獒气。\n安得忘言徒，喻此鸿鹄志。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古诗十首 其十","author":"张雨","text":"燕雀争善处，处在大屋下。\n姁姁甚相乐，子母得相哺。\n一朝灶突决，火炎屋栋燬。\n燕雀色不变，不知祸及己。\n人臣私聚敛，迷国坏纲纪。\n孰谓斯人智，不如燕雀耳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独酌","author":"张雨","text":"静极忽不惬，掩书曝前轩。\n荣木樊四维，时禽托孤园。\n群物方趋功，吾衷恒晏然。\n本乏超世才，偶脱区中缘。\n妙理寄浊醪，嘉名爱灵仙。\n从吾所好耳，富贵须何年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10214,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天池石壁为铁雅赋","author":"张雨","text":"尝读枕中记，华山閟中吴。\n神泉发其颠，青壁缭其隅。\n春风四山来，群绿互纷扶。\n羽觞曲折行，浮花与之俱。\n采珠搴薜荔，洗玉弄芙蕖。\n聱叟颇好名，石洼作鱼湖。\n鸿乙志草堂，挑烟遂成图。\n而此涤烦矶，阅世如摴蒲。\n发兴云林子，盥手与我摹。\n居然缩地法，挈入壶公壶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":10215,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]