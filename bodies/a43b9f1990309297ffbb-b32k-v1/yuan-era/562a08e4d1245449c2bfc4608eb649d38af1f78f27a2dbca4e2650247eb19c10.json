[{"title":"小重山","author":"刘秉忠","text":"诗酒休惊误一生。\n黄尘南北路、几功名。\n枝头乌鹊梦频惊。\n西州月，夜夜照人明。\n枕上数寒更。\n西风残漏滴、两三声。\n客中新感故园情。\n音书断，天晓雁孤鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"小重山","author":"刘秉忠","text":"晓起清愁酒盎空。\n清愁缘底事、别离中。\n登临无地与君同。\n青山色，山外更重重。\n落尽海棠红。\n蔷薇新破萼、露华浓。\n牡丹芳信一帘风。\n寻幽梦，曾到小园东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"干荷叶","author":"刘秉忠","text":"干荷叶，色苍苍，老柄风摇荡，减了清香。\n越添黄。\n都因昨夜一场霜，寂寞在秋江上。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引","author":"刘秉忠","text":"长安三唱晓鸡声。\n谁不被，利名惊。\n搅镜照星星。\n都老却、当年后生。\n山林苍翠，江湖烟景，归去没人争。\n休望濯尘缨。\n几时得、沧浪水清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引","author":"刘秉忠","text":"衲衣藤杖是吾缘。\n好归去，旧林泉。\n富贵任争先。\n总不较、诸公著鞭。\n雁飞汾水，鹤归华表，人事又千年。\n沧海变桑田。\n谁知有、壶中洞天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引","author":"刘秉忠","text":"桃花流水鳜鱼肥。\n青箬笠，绿蓑衣。\n风雨不须归。\n管甚做、人间是非。\n两肩云衲，一枝筇杖，尽日可忘机。\n之子欲何为。\n归去来、山猿怪迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引","author":"刘秉忠","text":"青山憔悴锁寒云。\n站路上，最伤神。\n破帽鬓沾尘。\n更谁是、阳关故人。\n颓波世道，浮云交态，一日一番新。\n无地觅松筠。\n看青草、红芳斗春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引 武候","author":"刘秉忠","text":"至人视有一如无。\n见义处，便相扶。\n三顾出茅庐。\n莫不是、先生有图。\n拯危当世，觉民斯道，佩玉已心枯。\n遗恨失吞吴。\n真个是、男儿丈夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"太常引 鲁仲连","author":"刘秉忠","text":"当时六国怯强秦。\n使群策，日纷纷。\n谈笑却三军。\n算自古、谁如此君。\n一心忠义，满怀冰雪，功就便抽身。\n富贵若浮云。\n本是个、江湖散人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆秦娥","author":"刘秉忠","text":"杯休侧。\n为君送别城南陌。\n城南陌。\n茸茸芳草，万家春色。\n阳关一曲愁肠结。\n吟鞭斜袅黄昏月。\n黄昏月。\n长安古道，洛阳游客。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆秦娥","author":"刘秉忠","text":"调羹手。\n残枝莫折离亭柳。\n离亭柳。\n年年春尽，为谁消瘦。\n海棠过雨愁红皱。\n行人驻马空搔首。\n空搔首。\n秦楼花月，凤城歌酒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆秦娥","author":"刘秉忠","text":"斜阳暮。\n西风落叶关山路。\n关山路。\n归鸿巢燕，笑人来去。\n我歌一曲君听取。\n人生聚散如今古。\n如今古。\n湘江秋水，渭川春树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢","author":"刘秉忠","text":"笑平生活计，渺浮海，一虚舟。\n任紫塞风沙，鸟蛮瘴雾，即处林丘。\n天地几番朝暮，问夕阳、无语水东流。\n白首王家年少，梦魂正绕扬州。\n凤城歌舞酒家楼。\n肯管世闲愁。\n奈麋鹿疏情，烟霞痼疾，难与同游。\n桃花为春憔悴，念刘郎、双鬓也成秋。\n旧事十年夜雨，不堪重到心头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢","author":"刘秉忠","text":"既天生万物，自随分，有安排。\n看鸑鷟云霄，骅骝道路，斥鴳蒿莱。\n东君更相料理，著春风、吹处百花开。\n战马频投北望，宾鸿又自南来。\n紫垣星月隔尘埃。\n千载拆中台。\n叹麟出非时，风归何日，草满金台。\n江山阅人多矣，计古来、英物总沉埋。\n镜里不堪看鬓，尊前且好开怀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢","author":"刘秉忠","text":"到闲人闲处，更何必，问穷通。\n但遣兴哦诗，洗心观易，散步携筇。\n浮云不堪攀慕，看长空、淡淡没孤鸿。\n今古渔樵话里，江山水墨图中。\n千年事业一朝空。\n春梦晓闻钟。\n得史笔标名，云台画像，多少成功。\n归来富春山下，笑狂奴、何事傲三公。\n尘事休随夜雨，扁舟好待秋风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"木兰花慢 混一后赋","author":"刘秉忠","text":"望乾坤浩荡，曾际会，好风云。\n想汉鼎初成，唐基始建，生物如春。\n东风吹遍原野，但无言、红绿自纷纷。\n花月流连醉客，江山憔悴醒人。\n龙蛇一屈一还伸。\n未信丧斯文。\n复上古淳风，先王大典，不贵经纶。\n天君几时挥手，倒银河、直下洗嚣尘。\n鼓舞五华鸑鷟，讴歌一角麒麟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风流子","author":"刘秉忠","text":"书帙省淹留，人间事，一笑不须愁。\n红日半窗，梦随蝴蝶，碧云千里，归骤骅骝。\n酒杯里、功名浑琐琐，今古两悠悠。\n汉代典刑，萧曹画一，晋朝人物，王谢风流。\n冠盖照神州。\n春风弄丝竹，胜处追游。\n诗兴笔摇牙管，字字银钩。\n遇美景良辰，寻芳上苑，赏心乐事，取醉南楼。\n好在五湖烟浪，谁识归舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永遇乐","author":"刘秉忠","text":"山谷家风，萧闲情味，只君能识。\n会友论文，哦诗遣兴，此乐谁消得。\n壶中天地，目前今古，今日还明日。\n似南华蝶梦醒来，秋雨数声残滴。\n诗书有味，功名应小，云散碧空幽寂。\n北海洪尊，南山佳气，清赏今犹昔。\n一天明月，几行征鹰，楼上有人横笛。\n想醉中、八表神游，不劳凤翼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉楼春","author":"刘秉忠","text":"闲云不肯狂驰骋。\n向晚自来栖峰顶。\n野人无事也关门，一炷古香焚小鼎。\n惊鸟有恨无人省。\n飞去飞来明月影。\n夜阑万籁寂中闻，破牖透风微觉冷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉楼春","author":"刘秉忠","text":"翠微掩映农家住。\n水满玉溪花满树。\n青山随我入门来，黄鸟背人穿竹去。\n烟霞隔断红尘路。\n试问功名知此趣。\n一壶春酒醉春风，便是太平无事处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"好事近","author":"刘秉忠","text":"酒醒梦回时，小鼎串烟初灭。\n留得瘦梅疏竹，弄窗间素月。\n起来幽绪转清幽，幽处更难说。\n一曲竹枝歌罢，满襟怀冰雪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"好事近","author":"刘秉忠","text":"桃李尽飘零，风雨更休怀恶。\n细把牡丹遮护，怕因循吹落。\n平芜望断更青山，楼外数峰削。\n野鸟不知归处，把行云随着。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江月晃重山","author":"刘秉忠","text":"红雨斜斜作阵，绿云碎碎成堆。\n武陵溪口几人迷。\n桃花水，流入不流回。\n夏日董风殿阁，秋宵宝月楼台。\n仙凡境界隔尘埃。\n青鸾客，归去又归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江月晃重山","author":"刘秉忠","text":"杜宇声中去住，蜗牛角上输赢。\n金瓯名字尽人争。\n秋鸿影，湖水镜般明。\n杨柳烟凝露重，莲花月冷风清。\n万年枝稳鹊休惊。\n邻家笛，夜夜故园情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江月晃重山","author":"刘秉忠","text":"太白诗成对酒，仲宣赋就登楼。\n思乡怀古两悠悠。\n黄尘路，风雨鬓惊秋。\n三岛云随鹤驭，五湖月载归舟。\n青山西塞水东流。\n功名好，欢伯笑人愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梧叶儿","author":"张可久","text":"乘兴诗人棹，新烹学士茶。\n风味属谁家。\n瓦甃悬冰箸，天风起玉沙。\n海树放银花。\n愁压拥、蓝关去马。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城子","author":"刘秉忠","text":"平生行止懒编排。\n住蒿莱。\n走尘埃。\n社燕秋鸿，年去复年来。\n看尽好花春睡稳，红兴紫，任他开。\n紫微天上列三台。\n问英才。\n几沉埋。\n沧海遗珠，当著在鸾台。\n兴世浮沉惟酒可，如有酒，且开怀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城子","author":"刘秉忠","text":"松苍竹翠岁寒天。\n雁山前。\n凤城边。\n回首燕南，一别又三年。\n长爱故人心似月，人不见，月还圆。\n小窗寂寂锁凝烟。\n一灯然。\n一诗联。\n诗若灯青，孤影伴无眠。\n明日酒中余思在，挥醉墨，洒云笺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"江城子 游琼华岛","author":"刘秉忠","text":"琼华昔日贺新成。\n与苍生。\n乐升平。\n西望长山，东顾限沧溟。\n翠辇不来人换生，天上月，自虚盈。\n树分残照水边明。\n雨初晴。\n气还清。\n醉却兴亡，惟有酒多情。\n收取晋人腮上泪，千载后，几新亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谒金门","author":"刘秉忠","text":"醪虽薄。\n再四劝君无恶。\n林到面前须饮却。\n莺啼花未落。\n束置功名高阁。\n两日三朝留酌。\n绿柳来年无可握。\n春情凭底托。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诉衷情令","author":"刘秉忠","text":"山河萦带九州横。\n深谷几为陵。\n千年万年兴废，花月洛阳城。\n图富贵，论功名。\n我无能。\n一壶春酒，数首新诗，实诉衷情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙","author":"刘秉忠","text":"堂上箫韶人不奏，凤凰何处飞鸣。\n黄尘扰扰马纵横。\n谁能知乐毅，志不在齐城。\n后辈谩搜前辈错，到头义重功轻。\n海隅四面尽苍生。\n东风吹绿草，布谷劝春耕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙","author":"刘秉忠","text":"同是天涯流落客，君还先到襄城。\n云南关险梦犹惊。\n记曾明月底，高枕远江声。\n年去年来人渐老，不堪苦事功名。\n倾开怀抱酒多情。\n几时同一醉，挥手谢公卿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙","author":"刘秉忠","text":"满路红尘飞不去，春风弄我华颠。\n故园桃李酒尊前。\n赏心逢美景，此事古难全。\n若智若痴人总笑，夕阳空袅吟鞭。\n马头山色翠相连。\n不知山下客，何日是归年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 桃花","author":"刘秉忠","text":"一别仙源无觅处，刘郎鬓欲成丝。\n兰昌千树碧参差。\n芳心应好在，时复问蜂儿。\n报到洞门长闭着，只今未有开时。\n杏花容冶没人司。\n东家深院宇，墙外有横枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 海棠","author":"刘秉忠","text":"十日狂风才是定，满园桃李纷纷。\n黄蜂粉蝶莫生嗔。\n海棠贪睡著，留得一枝春。\n便是徐熙相对染，丹青不到天真。\n雨余红色愈精神。\n夜眠清早起，应有惜花人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临江仙 梨花","author":"刘秉忠","text":"冰雪肌肤香韵细，月明独倚阑干。\n游丝萦惹宿烟环。\n东风吹不散，应为护轻寒。\n素质不宜添彩色，定知造物非悭。\n杏花才思又凋残。\n玉容春寂寞，休向雨中看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"檀板称歌喉。\n唱到消魂韵转幽。\n便觉丝簧难比似，风流。\n一串骊珠不断头。\n惟酒可忘忧。\n况复卢家有莫愁。\n醉倒不知天早晚，云收。\n花影侵窗月满楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"夜户喜凉飙。\n秋入关山暑气消。\n句引客情缘底物，鹪鹩。\n落日凄清叫树梢。\n古寺漏长宵。\n一点青灯照寂寥。\n暮雨夜深犹未住，芭蕉。\n残叶萧疏不柰敲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"季子解纵横。\n六印累累拜上卿。\n凤鸟不来人渐老，谋生。\n二顷田园也易成。\n尊酒醉渊明。\n菊有幽香竹有声。\n吹破北窗千古梦，风清。\n小鸟喧啾噪晓晴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"憔悴寄西州。\n赋得登楼懒上楼。\n魂梦不知关塞远，悠悠。\n疏雨梧桐客里秋。\n往事起新愁。\n九曲回肠不自由。\n见说世间离别苦，休休。\n一夜相思了白头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"游子绕天涯。\n才离蛮烟又塞沙。\n岁岁年年寒食里，无家。\n尚惜飘零看落花。\n闲客卧烟霞。\n应笑劳生鬓早华。\n惊破石泉槐火梦，啼鸦。\n扫地焚香自煮茶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"南北短长亭。\n行路无情客有情。\n年去年来鞍马上，何成。\n短鬓垂垂雪几茎。\n孤舍一檠灯。\n夜夜看书夜夜明。\n窗外几竿君子竹，凄清。\n时作西风散雨声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"李杜放诗豪。\n万丈晴虹吸海涛。\n六义不传风雅变，离骚。\n金玉无言价自高。\n春日对春醪。\n短咏长歌慰寂寥。\n幽鸟落来花里悟，从教。\n彩凤飘飘上九霄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南乡子","author":"刘秉忠","text":"翠袖捧离觞。\n济楚儿郎窈窕娘。\n别曲一声双泪落，悲凉。\n纵不关情也断肠。\n今古利名忙。\n谁信长安道路长。\n昔日去家年正少，还乡。\n故国惊嗟两鬓霜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"洞仙歌","author":"刘秉忠","text":"仓陈五斗，价重珠斛。\n陶令家贫苦无畜。\n倦折腰闾里，弃印归来，门外柳、春至无言自绿。\n山明水秀，清胜宜茅屋。\n二顷田园一生足。\n乐琴书雅意，无个事，卧看北窗松竹。\n忽清风、吹梦破鸿荒，爱满院秋香，数业黄菊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"十载风霜，玉关紫塞都游遍。\n驿途方远。\n夜雨留孤馆。\n灯火青荧，莫把吴钩看。\n歌声软。\n酒斟宜浅。\n三盏清愁散。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"寂寂珠帘，凤楼人去箫声住。\n断肠诗句。\n彩笔无题处。\n花褪残红，绿满西城树。\n蘅皋暮。\n客愁何许。\n梅子黄时雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"恰破黄昏，一湾新月稍稍共。\n玉溪流汞。\n时有香浮动。\n别后清风，馥郁添多种。\n如相送。\n未忘珍重。\n已入幽人梦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"天上春来，满前芳草迷归路。\n楚山湘浦。\n朝暮谁云雨。\n凤吹初听，认是吹箫侣。\n刘郎去。\n碧桃千树。\n世外无寻处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"客梦初惊，雪晴风冷千山晓。\n塞烟沙草。\n又上邮亭道。\n石窟萝龛，为我君应扫。\n何时到。\n放怀吟啸。\n相伴山间老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇","author":"刘秉忠","text":"古寺萧条，十年再到经行路。\n旧题新句。\n总是关心处。\n睡起西轩，转觉添幽趣。\n斜阳暮。\n淡烟疏雨。\n湿遍山前树。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 梅","author":"刘秉忠","text":"策杖寻芳，小溪深雪前村路。\n暗香时度。\n更在清幽处。\n一见冰容，便有西湖趣。\n题新句。\n句成梅许。\n折得南枝去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"点绛唇 梨花","author":"刘秉忠","text":"立尽黄昏，袜尘不到凌波处。\n雪香凝树。\n懒作阳台雨。\n一水相县，脉脉难为语。\n情何许。\n向人如诉。\n寂寞临江渚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花曲","author":"刘秉忠","text":"青山千里，沧波千里，白云千里。\n行程问行客，更无穷山水。\n青史功名都半纸。\n念刘郎、鬓先如此。\n桃源觅无路，对溪花红紫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花曲","author":"刘秉忠","text":"茸茸芳草，漫漫长路，匆匆行李。\n佳人在何许，渺云山千里。\n莫惜千金沽一醉。\n道刘郎、不宜憔悴。\n春归寂寞语，恨桃花流水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花曲","author":"刘秉忠","text":"一川芳景，一壶春酒，一襟幽绪。\n今朝好天色，又无风无雨。\n水满清溪花满树。\n有闲鸥、伴人来去。\n行云望逾远，更青山无数。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃源忆故人","author":"刘秉忠","text":"桃花乱落如红雨。\n闪下西城碧树。\n寂寞琐窗朱户。\n最是春深处。\n一尊酒尽青山暮。\n楼外轻云犹渡。\n远水悠悠下住。\n流得年光去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"浣溪沙","author":"刘秉忠","text":"桃李无言一径深。\n客愁春恨莫相寻。\n看花酌酒且开襟。\n白雪浩歌真快意，朱弦未绝有知音。\n月明千里故人心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望月婆罗门引","author":"刘秉忠","text":"午眠正美，觉来风雨满红楼。\n卷帘情思悠悠。\n望断碧波烟渚，苹蓼不胜秋。\n但冥冥天际，难识归舟。\n大夫骨朽。\n算空把，汨罗投。\n谁辨浊泾清渭，一任东流。\n而今不醉，苦一日醒醒一日愁。\n薄薄酒、且放眉头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望月婆罗门引","author":"刘秉忠","text":"年来懒看，古今文字纸千张。\n酒中悟得天常。\n闲杀阶前好月，不肯照西厢。\n任昏昏一醉，石枕藤床。\n名途利场。\n物与我，两相望。\n目断霜天鸿雁，沙漠牛羊。\n一庭秋草，教粉蝶黄峰自任忙。\n花老也、尚有余香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐","author":"刘秉忠","text":"月明风劲。\n花弄窗间影。\n一夜玉壶秋水冷。\n梧叶乍凋金井。\n世间日月如梭。\n人生会少离多。\n篱畔黄花开尽，相逢不醉如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清平乐","author":"刘秉忠","text":"渔舟横渡。\n云淡西山暮。\n岸草汀花谁作主。\n狼籍一江秋雨。\n随身箬笠蓑衣。\n斜风细雨休归。\n自任飞来飞去，伴他鸥鹭忘机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":4178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]