[{"title":"西域和王君玉诗二十首 其二十","author":"耶律楚材","text":"鲰生诗僻慕诗仙，乱缀狂吟数百千。\n浅陋妄言嗤俊哲，清新绮语愧先贤。\n摧残吟鬓星星发，倾倒词源浑浑泉。\n韵险言穷无可说，祇凭此句露深玄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杨彦广韵","author":"耶律楚材","text":"三台须要趁琵琶，知己相逢两会家。\n雕斲勿伤石内玉，纵横须放火中花。\n探玄浑似三杯酒，清兴何消七椀茶。\n谁识湛然端的处，差徭随分纳些些。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题平阳李君实此君轩","author":"耶律楚材","text":"环榻森森荫好凉，此君风味讵能忘。\n虚心悄悄生来劲，直节亭亭老更刚。\n虽与蓬蒿均雨露，本同松菊傲风霜。\n主人雅志元堪尚，物以群分类以方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域有感","author":"耶律楚材","text":"落日城头鸦乱啼，秋风原上马频嘶。\n雁行南去潇湘北，萍迹东来鸟鼠西。\n百尺栋梁谁着价，三春桃李自成蹊。\n功名到底成何事，烂饮玻璃醉似泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"早行","author":"耶律楚材","text":"马驼残梦过寒塘，低转银河夜已央。\n雁迹印开沙岸月，马蹄踏破板桥霜。\n汤寒卯酒两三盏，引睡新诗四五章。\n古道迟迟四十里，千山清晓日苍凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自叙","author":"耶律楚材","text":"信流乘坎过西天，钵里吞针亦偶然。\n只道一花刚点额，不知三子暗登肩。\n既来此世难逃数，且应前生未了缘。\n俗眼见时难放过，并赃陈首万松轩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域元日","author":"耶律楚材","text":"凌晨随分备樽罍，辟疫屠苏饮一杯。\n迂叟不令书郁垒，痴儿刚要画钟馗。\n新愁又逐东风至，旧信难随春日来。\n又向边城添一岁，天涯飘泊几时回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域寄中州禅老","author":"耶律楚材","text":"吾师道化震清都，奔逸绝尘我不如。\n近日虚传三岛信，几年不得万松书。\n宗门淘汰犹嫌少，习气薰蒸尚未除。\n惆怅天涯沦落客，临风不是忆鲈鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"蒲华城梦万松老人","author":"耶律楚材","text":"华亭髣髴旧时舟，又见吾师钓直钩。\n只道梦中重作梦，不知愁底更添愁。\n曾参活句垂青眼，未得生侯已白头。\n撇下尘嚣归去好，谁能骑鹤上扬州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄巨川宣抚","author":"耶律楚材","text":"历数兴亡掌上看，提兵一战领清官。\n马前草诏珠玑润，纸上挥毫风雨寒。\n昔日谈禅明法界，而今崇道倡香坛。\n诸行百辅君都占，潦倒鲰生何处安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄南塘老人张子真","author":"耶律楚材","text":"张侯风味讵能忘，黄米曾令我一尝。\n抵死解官违北阙，达生遁世钓南塘。\n知来何假灵龟兆，作赋能陈瑞鹤祥。\n岂是西边无土物，不如诗句寄东阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"观瑞鹤诗卷独子进治书无诗","author":"耶律楚材","text":"丁年兰省识君初，缓步鸣珂游帝都。\n象简常陪天仗立，玉骢曾使禁臣趋。\n只贪殢酒长安市，不肯题诗瑞应图。\n我念李侯端的意，大都好事不如无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄德明","author":"耶律楚材","text":"英侯志节本凌云，尚自飘零故国尘。\n有道且同麋鹿友，谈玄能说虎狼仁。\n幸然不全饱死鬼，可惜空吟笑杀人。\n弥勒下生何太早，莫随邪见说无因。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"才卿外郎五年止惠一书","author":"耶律楚材","text":"五年只得一书题，路远山长梦亦迷。\n睡老黑甜酣顺北，冷官清淡泊辽西。\n羡人得志能如虎，笑我乏才粗效鸡。\n伫看天兵旋北阙，从今不用玉关泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄清溪居士秀玉","author":"耶律楚材","text":"鹪鹩犹欠一枝栖，不得燕山半土犁。\n时复有琴歌碧玉，年来无梦绕清溪。\n数行文字聊遮眼，半纸功名苦噬脐。\n回首故人今健否，馀生甘老碧云西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏秀玉","author":"耶律楚材","text":"清溪掀倒打油房，五卫凋零三径荒。\n未信塞翁嗟失马，须知禦寇觅亡羊。\n东湖菡萏从君赏，西域蒲萄输我尝。\n各在天涯会何日，临风休忘老髯郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄张子闻","author":"耶律楚材","text":"忆昔携琴论太玄，湛然初识子闻贤。\n回头葱岭仍千里，分手松轩已五年。\n东望卢龙倾玉表，西来青鸟阙金笺。\n几时重会燕山道，一曲临风奏水仙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄用之侍郎","author":"耶律楚材","text":"蓬莱怜我寄芳笺，劝我无忘仁义先。\n几句良言甜似蜜，数行温语煖于绵。\n从来谁识龟毛拂，到底难调胶柱弦。\n用我必行周孔教，舍予不负万松轩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和正卿待制韵","author":"耶律楚材","text":"布袖龙钟两眼尘，丹诚如旧白头新。\n暮云西畔犹怀汉，晓日东边才是秦。\n酒贱不妨连夜醉，花繁长发四时春。\n花繁酒贱无佳思，谁念天涯万里人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄仲文尚书","author":"耶律楚材","text":"仲文曾作黑头公，辅弼明时播美风。\n治粟货泉流冀北，提刑奸迹屏胶东。\n笑观桃李新恩遍，拜扫松楸老计终。\n西域故人增喜色，万全良策不谋同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9408,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪轩老人邦杰久不惠书作诗怨之","author":"耶律楚材","text":"当时倾盖便忘年，别后春风五度迁。\n万里西行愁似海，千山东望远如天。\n不闻旧信传梅岭，试道新诗怨雪轩。\n更上危楼一回首，朝云深处是燕然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9409,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谢王清甫惠书","author":"耶律楚材","text":"西征万里扈銮舆，高阁文章束石渠。\n只道昔年周梦蝶，却疑今日我为鱼。\n一簪华发垂垂老，两眼黄尘事事疏。\n多谢贵人怜远客，东风时有寄来书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9410,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思亲二首 其一","author":"耶律楚材","text":"老母琴书老自娱，吾山侧近结蘧庐。\n鬓边尚结辟兵发，箧内犹存教子书。\n幼稚已能学土梗，老兄犹未忆鲈鱼。\n谁知万里思归梦，夜夜随风到故居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9411,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思亲二首 其二","author":"耶律楚材","text":"昔年不肯卧茅庐，赢得飘萧两鬓疏。\n醉里莫知身似蝶，梦中不觉我为鱼。\n故园屈指八千里，老母行年六十馀。\n何日挂冠辞富贵，少林佳处卜新居。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9412,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思亲用旧韵二首 其一","author":"耶律楚材","text":"前年驿骑过西陲，闻道萱堂鬓已丝。\n琴断五弦忘旧谱，菊荒三径负疏篱。\n筵前戏笑知何日，膝下嬉游看几时。\n欲附一书无处寄，愁边空咏满囊诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9413,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思亲用旧韵二首 其二","author":"耶律楚材","text":"天涯惟仗梦魂归，破梦春风透客帏。\n灯下几时哦丽句，筵前何日舞斑衣。\n垂垂塞北行人老，得得江南远信稀。\n回首故园千万里，倚楼空望白云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9414,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"思亲有感","author":"耶律楚材","text":"骨肉星分天一涯，萱堂何处忆孤儿。\n排愁正赖无声乐，遗兴学吟有眼诗。\n丽句日逐三上尔，香醪时复一中之。\n前年汉使来西域，笑我星星两鬓丝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9415,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再过西域山城驿","author":"耶律楚材","text":"去年驰传暮城东，夜宿萧条古驿中。\n别后尚存柴户疏，重来犹有瓦窗蓬。\n主人欢喜铺毛毯，驿吏苍忙洗瓦钟。\n但得微躯且强健，天涯何处不相逢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9416,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"辛巳闰月西域山城值雨","author":"耶律楚材","text":"冷云携雨到山城，未敢冲泥傍险行。\n夜听窗声初变雪，晓窥檐溜已垂冰。\n泪凝孤枕三停湿，花结残灯一半明。\n又向茅亭留一宿，行云行雨本无情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9417,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十七日早行始忆昨日立春","author":"耶律楚材","text":"客中为客已浃旬，岁杪西边访故人。\n杷榄花前风弄麦，葡萄架底雨沾尘。\n山城肠断得穷腊，村馆销魂偶忘春。\n今日唤回十载梦，一盘凉饼翠蒿新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9418,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十七日驿中作穷春盘","author":"耶律楚材","text":"昨朝春日偶然忘，试作春盘我一尝。\n木案初开银线乱，砂瓶煮熟藕丝长。\n匀和豌豆揉葱白，细剪蒌蒿点韭黄。\n也与何曾同是饱，区区何必待膏梁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9419,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西域蒲华城赠蒲察元帅","author":"耶律楚材","text":"骚人岁杪到君家，土物萧疏一饼茶。\n相国传呼扶下马，将军忙指买来车。\n琉璃钟里葡萄酒，琥珀瓶中杷榄花。\n万里遐方获此乐，不妨终老在天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9420,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"乞车","author":"耶律楚材","text":"君家轮扁本多能，碧轼朱辕照眼明。\n居士此回无马坐，郎官不可辄徒行。\n陈遵投辖情何重，灵辄扶轮报敢轻。\n别更不须寻土物，载将春色去东城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9421,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏作二首 其一","author":"耶律楚材","text":"苍颜太守领西阳，招引诗人入醉乡。\n屈眴轻衫裁鸭绿，葡萄新酒泛鹅黄。\n歌姝窈窕髯遮口，舞妓轻盈眼放光。\n野客乍来同见惯，春风不足断人肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9422,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏作二首 其二","author":"耶律楚材","text":"太守多才民富强，风光特不让苏杭。\n葡萄酒熟红珠滴，杷榄花开紫雪香。\n异域丝簧无律吕，胡姬声调自宫商。\n人生行乐无如此，何必咨嗟忆故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9423,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过太原南阳镇题紫薇观壁三首 其一","author":"耶律楚材","text":"廷臣侍从蔑前驱，道侣忻奔迓使车。\n县吏喜闻新号令，村民争认旧中书。\n累累山果盈磁钵，薄薄浊醪半瓦壶。\n隐逸竞询新事迹，几时迁洛卜新都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9424,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过太原南阳镇题紫薇观壁三首 其二","author":"耶律楚材","text":"吾皇巡狩用三驱，万骑千官奉帝车。\n北阙春颁劝农诏，南陬夜奏报捷书。\n士民安堵耕盈野，老幼迎郊浆满壶。\n伫看要荒归一统，天兵不日破东都。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9425,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过太原南阳镇题紫薇观壁三首 其三","author":"耶律楚材","text":"三教根源本自同，愚人迷执强西东。\n南阳笑倒知音士，反改莲宫作道宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9426,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和松月野衲海上人见寄二诗 其一","author":"耶律楚材","text":"游子痴愚莫识家，牛车远弃爱羊车。\n汪洋渤海龙宫藏，涓滴波澜坎井蛙。\n迷后万言犹是少，悟来千里不为赊。\n丛林衲子空行脚，绕遍天涯与海涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9427,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和松月野衲海上人见寄二诗 其二","author":"耶律楚材","text":"小隐居山何太错，居廛大隐绝忧乐。\n山林朝市笑呵呵，为报禅人莫动着。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9428,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梦中偶得","author":"耶律楚材","text":"昔年钩隐索幽奇，只向纵横枝上觅。\n而今拍手笑呵呵，九九元来九十一。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9429,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贾非熊饯余用其韵","author":"耶律楚材","text":"銮辔和鸣车指南，廷臣自愧侍龙骖。\n平生慷慨贞夫一，万里别来益友三。\n老子此行无酒债，故人归计有禅庵。\n白云野衲皆宗匠，道服因缘好细参。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9430,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用李德恒韵","author":"耶律楚材","text":"吾子栖迟尚布衣，挑灯弹铗壮歌悲。\n阮生固已开青眼，马氏元来有白眉。\n运拙巢由真可慕，时亨房杜不难为。\n男儿用舍奚忧喜，三径耕耘足自资。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"松月老人寄诗因用元韵","author":"耶律楚材","text":"谈禅讲教不知家，芳草漫漫去路差。\n杓卜虚声禾老鼓，盘星错认洞山麻。\n全无去就论空色，谁有心情说照遮。\n松月野僧须荐取，钓鱼人是老玄沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和薛正之韵","author":"耶律楚材","text":"天涯倚遍塞城楼，凝望冥鸿空自羞。\n礼义不张真我恨，干戈未戢是吾忧。\n每怜丹凤能择食，常笑黄能误上钩。\n何日解荣偿旧约，扁舟蓑笠五湖游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用李邦瑞韵","author":"耶律楚材","text":"沈沈北海雪波深，老眼增明寸碧琴。\n未得一江活物水，何酬四海望云心。\n我生有遇千年会，自愧难为三日霖。\n吾子佞然虚赞德，临风羞继谪仙吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄平阳净名润老","author":"耶律楚材","text":"驿骑新从平水回，知公无恙笑颜开。\n出门不剪闲庭草，退步从生古殿苔。\n玉锁何须絟彩凤，金钩毋得钓黄鲐。\n夜深织就无纹锦，但有人来寄个来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和郑景贤韵","author":"耶律楚材","text":"我爱龙冈老，鸣琴自老成。\n未弹白雪曲，先爱水仙声。\n但欲合纯古，谁能媚世情。\n林泉聊自适，何必献承明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李茂才寄景贤韵","author":"耶律楚材","text":"醒时还醉醉还醒，尚忆轮台饮兴清。\n瀚海波涛君忍听，天山风雪我难行。\n好学慷慨英雄操，毋傲辛酸儿女情。\n但得胸中空洒洒，天涯何处不安生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除戎堂二首 其一","author":"耶律楚材","text":"除戎堂主震威名，一扫尘氛消未萌。\n不出户庭成庙算，折冲樽俎有奇兵。\n何须公瑾长江险，安用蒙恬万里城。\n坐镇大河兵偃息，居延不复塞尘惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除戎堂二首 其二","author":"耶律楚材","text":"除戎厅事筑城阿，烽火平安师旅和。\n远胜长城欺李绩，徒标铜柱笑伏波。\n服心不用七擒策，禦侮何劳三箭歌。\n高枕幽窗无一事，西人不敢牧长河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武川摩诃院圆明老人五首 其一","author":"耶律楚材","text":"临行不暇别圆明，禅客机关百变生。\n明月清风都不会，落花流水两无情。\n只知常谒摩诃院，谁道曾离归化城。\n宾主相忘非聚散，笑谈松竹自清声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武川摩诃院圆明老人五首 其二","author":"耶律楚材","text":"新诗入手眼增明，老作机锋太峻生。\n略叙寒温闲礼数，过承褒赏假人情。\n羡君奋迅超真地，笑我徘徊恋化城。\n且喜武川归海若，狂流万派尽消声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武川摩诃院圆明老人五首 其三","author":"耶律楚材","text":"我爱圆明道眼明，简书时复寄鲰生。\n谈真辨妄输达士，背正归邪笑世情。\n且隐骊珠光万丈，奚贪尺璧价连城。\n穹庐高枕无馀事，静听潮轰北海声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武川摩诃院圆明老人五首 其四","author":"耶律楚材","text":"归与不得效渊明，细碎功名误此生。\n客里正如闲气味，病来犹有好心情。\n冰弦罢品昭君曲，醉墨闲题苏武城。\n受用观音法无尽，悲笳风送两三声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄武川摩诃院圆明老人五首 其五","author":"耶律楚材","text":"一扇儒风佛日明，舍生从此乐馀生。\n高人编简寻长味，衲子林泉称野情。\n见道谷绵充廪藏，喜闻流散集京城。\n自惭无德毗明主，千里虚名浪播声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李汉臣韵四首 其一","author":"耶律楚材","text":"梦中身世鬓垂斑，方士从誇药驻颜。\n性海一波涵万象，威音双箭透重关。\n圆融活水非生灭，浩渺虚舟任往还。\n便好灰心养愚拙，须知大智本闲闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李汉臣韵四首 其二","author":"耶律楚材","text":"龙飞登九五，历数与天膺。\n休运绵瓜瓞，功臣列土封。\n但期酬子志，奚虑枕吾肱。\n千载圣人出，休嗟见有恒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李汉臣韵四首 其三","author":"耶律楚材","text":"云中栖隐养雄豪，我爱先生一著高。\n鼓腹诗鸣光圣世，雄文端可继离骚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和李汉臣韵四首 其四","author":"耶律楚材","text":"龙庭十载不知疲，自恨无才出六奇。\n欲著涓埃裨海岳，虚名闲誉畏人知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和北京张天佐见寄","author":"耶律楚材","text":"寓迹龙庭积有年，功名已后祖生鞭。\n销金众口嫉居士，好事独君慕湛然。\n许远云山分袂别，几时风雨对床眠。\n琼华赠我将何报，聊寄江南古样弦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戊子继武川刘抟霄韵","author":"耶律楚材","text":"不得吾山卧翠霞，西行行遍海之涯。\n火风地水虽非我，南北东西总是家。\n驿骑亲驰涉弱水，星轺躬驾过流沙。\n惟期圣德渐遐迩，不惮龙庭万里赊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"憩解州邵薛村洪福院","author":"耶律楚材","text":"天兵南出武阳东，暂解征鞍憩梵宫。\n玉像巍巍红叶捧，金容奕奕碧纱笼。\n三秦繁盛如席卷，两晋风流扫地空。\n惟有真如元不坏，青山依旧白云中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邵薛村道士陈公求诗","author":"耶律楚材","text":"玄言圣祖五千言，不说飞升不说仙。\n烧药炼丹全是妄，吞霞服气苟延年。\n须知三教皆同道，可信重玄也似禅。\n趋破异端何足慕，纷纷皆是野狐涎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":9452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]