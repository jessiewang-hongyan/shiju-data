ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"张某","text":"草中人不见，空外鹤先知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"某神童","text":"分得两头轻与重，世间何事不担当。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲员炎","author":"无名子","text":"靴有镫青虽可爱，面无人色亦堪怜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲宾罗汉温相公","author":"无名子","text":"长竿醉草宾罗汉，短褐徉狂温相公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠陈克甫诗","author":"无名子","text":"夜过浮丘月满山，一尊相对坐漫漫。\n门临大海风涛壮，家有小天星斗寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"苏长公墨竹","author":"无名子","text":"黄陵庙前春雨足，湖皋烟树锦模糊。\n恸天大叹苦无语，二女祠中叫鹧鸪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"联方回诗","author":"无名子","text":"把酒从来不可期，吾降今日少人知。\n但看建德安民榜，便是虚翁德政碑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"两朝忠义传，俱有若人名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"葵藿有心终向日，杏桃无力谩随风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和汤西楼","author":"无名子","text":"荣华富贵等浮花，膂力难胜国爪牙。\n汉世但知光拥立，唐朝谁识?奸邪。\n绮罗化作春风蝶，弦管翻成夜雨蛙。\n纵有清漳人去也，碧天难挽紫云车。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"山中乌喙方尝胆，台上蛾眉正捧心。\n空怀狗监知司马，且喜龙门识李膺。\n生藏鱼腹不见水，死挽龙髯欲上天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古铜器诗","author":"无名子","text":"模棱难断佞臣头，碎脑翻成百倍忧。\n解使英雄生胆气，从今不用佩吴钩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"天目山诗","author":"无名子","text":"天目山前水齧矶，天心地脉露危机。\n西周浸冷觚棱月，未必迁岐说果非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠夏贵","author":"无名子","text":"自古谁无死，惜公迟四年。\n问公今日死，何似四年前？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊夏贵墓","author":"无名子","text":"享年八十三，而不七十九。\n呜呼夏相公，万古名不朽！","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"讥文璧","author":"无名子","text":"江南见说好溪山，兄也难时弟也难。\n可惜梅花有心事，南枝向暖北枝寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠虞伯生","author":"无名子","text":"万世文章凌日表，惊人风采动朝端。\n穷经白首讨论易，草诏丹墀润色难。\n忧国泪多双眼暗，归田计早一身安。\n不堪回首昭陵道，落日西风莎草寒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访樵隐不遇诗","author":"无名子","text":"想是朝真去未回，空教人久立丹台。\n冰盘露冷生琼屑，玄圃春深长碧苔。\n岩下响知松子落，洞中香是竹花开。\n拍阑一笑欲归去，海阔天高鹤不来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"集古句","author":"无名子","text":"翡翠屏风烛影深，良宵一刻值千金。\n共君今夜不须睡，明日池塘是绿阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲伯颜","author":"无名子","text":"百千万定犹嫌少，垛积金银北斗边。\n可惜太师无运智，不将些子到黄泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊秦王伯颜","author":"无名子","text":"人臣位极更封王，欲逞聪明乱旧章。\n一死有谁为孝子？\n九泉无面见先王。\n辅秦应已如商鞅，辞汉终难及子房。\n虎视南人如草芥，天教遗臭在南荒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"悼何巨川","author":"无名子","text":"奇才不泄神仙事，抗疏曾干世祖知。\n每恨南邦本无罪，比留北使欲何为！\n忠魂久掩孤城馆，褒诏新镌二品碑。\n地下若逢奸似道，为言故国黍离离。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其一","author":"无名子","text":"苏公堤上杨柳青，人来人去绾离情。\n东风为尔丁宁道，折断柔条莫再生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖竹枝词二首 其二","author":"无名子","text":"天竺寺前开翠微，长年流水白云飞。\n流水入湖无日歇，白云出岫有时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲时政诗","author":"无名子","text":"旧省新丞相，新台旧大夫。\n大夫听子语，丞相爱金珠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"书台门","author":"无名子","text":"苞苴贿赂尚公行，天下承平得未能。\n二十四官徒獬豸，越王台上望金陵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲廉访司官","author":"无名子","text":"解贼一金并一鼓，迎官两鼓一声锣。\n金鼓看来都一样，官人与贼不争多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32534,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲诸司","author":"无名子","text":"丞相做假钞，舍人做强盗。\n贾鲁要开河，搅得天下闹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32535,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊四状元","author":"无名子","text":"四榜状元逢此日，他年公论定难逃。\n空令太守提三尺，不见元戎用六韬。\n元举何如兼善死，公平争似子威高。\n世间多少偷生者，黄甲由来出俊髦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32536,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"黄金合铸李将军。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32537,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘲杨廉夫","author":"无名子","text":"竹枝柳枝桃杏花，吹弹歌舞拨琵琶。\n可怜一个杨夫子，变作江南散乐家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32538,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"山前有客祠彭越，塞上无人斩郅支。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32539,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"无名子","text":"斜倚水开花有思，缓随风转柳如痴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32540,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊张士诚","author":"无名子","text":"天星夜落水犀军，又见吴台走鹿群。\n睥睨金汤空自固，仓皇珠玉竟俱焚。\n将军只合田横死，国士嗟无豫让闻。\n风雨年年寒食节，麦盂谁上太妃坟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"不平诗","author":"无名子","text":"天遣魔军杀不平，不平人杀不平人。\n不平人杀不平者，杀尽不平方太平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岳武穆降箕诗","author":"无名子","text":"百战间关铁马雄，尚馀壮气凛秋风。\n有时醉倚吴山望，肠断中原一梦中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉华山诗","author":"马巫父","text":"玉楼云淡晓光浮，中有飞仙驾鹤游。\n下界此时方熟睡，谁寻紫气问青牛？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"三茅吴真人","text":"深深门巷老翁家，自洗铜瓶浸杏花。\n唤起承平当日梦，令人转忆旧京华。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳杏","author":"三茅吴真人","text":"岸曲纷纷已弄烟，园林点点欲争然。\n何人折取归深院，两样风光在眼前。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九洞","author":"郑文选","text":"拖露抟风海峤来，觚棱寂寂自楼台。\n春光不比承平日，泪眼看花荐一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"张君有","text":"八千里路到杭郡，城郭人民几变迁。\n惟有吴山青不改，令威何日是归年？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"兰渚","author":"张君有","text":"光转东风弄暖天，永和人物尚依然。\n谁怜纫佩凄凉客，倚策愁吟楚泽边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"绝句","author":"王大圭","text":"六朝盛事总成尘，结绮楼前草自春。\n一曲后庭何处觅？\n空留月伴倚阑人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]