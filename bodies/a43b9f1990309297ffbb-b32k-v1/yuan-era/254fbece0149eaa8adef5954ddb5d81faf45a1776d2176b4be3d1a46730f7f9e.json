[{"title":"寄张子震","author":"卢琦","text":"南浦多芳草，东风又落花。\n相思频入梦，见说欲回家。\n奇字从人问，新醅为客赊。\n自惭羁旅者，犹滞锦江涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16090,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春暮寄友","author":"卢琦","text":"郁彼园林景，居然锦水边。\n花阴方半夜，月色正中天。\n清景归图画，和风上管弦。\n惜春情未已，窗外忍闻鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16091,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送佥判赵宗吉","author":"卢琦","text":"大夫持宪檄，来憩古松阴。\n有马行阡陌，无鸦集泮林。\n丰功登石碣，归道载瑶琴。\n惟有前溪水，分明照此心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16092,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送许存忠之漳浦县尹","author":"卢琦","text":"榕下年华晏，逢君又送君。\n铜章新县尹，铁甲旧将军。\n客路长亭雨，乡心极浦云。\n公馀延里士，樽酒共论文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16093,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和木轩林先生寄本中韵","author":"卢琦","text":"玉人始相识，犹忆在琳宫。\n野树云间隔，灵槎海上通。\n荷香风共远，荔子雨初红。\n别后还惆怅，何时笑语同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16094,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓榕州寄乌石陈晚对","author":"卢琦","text":"每忆山中老，幽居昼不扃。\n客多频饮酒，儿长解明经。\n溪近鲈鱼美，林深荔子馨。\n何时同晚对，一笑聚星亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16095,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和林子苍湖亭晚酌","author":"卢琦","text":"登临多野趣，未暇问朝簪。\n南国秋声起，西湖暮景涵。\n江云连远树，山雨落寒岚。\n同是他乡客，相携看斗南。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16096,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿僧房","author":"卢琦","text":"信步寻僧去，经台梵韵清。\n竹窗云影过，草阁夕阳横。\n磬响开经卷，香飘绕殿楹。\n青山飞白鸟，暮景一时生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16097,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"枫亭道中","author":"卢琦","text":"枫林村酒好，使客醉初醒。\n云影驿傍树，月明溪上亭。\n文章多旧藁，身世似浮萍。\n努力崇勋业，休教两鬓星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16098,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惠安道中","author":"卢琦","text":"龙山兵火后，百里总萧疏。\n官帑需新赋，公田索旧租。\n莼鲈频有梦，鸿雁久无书。\n自笑成何用，云边是旧庐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16099,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答王经历庭训","author":"卢琦","text":"数日不相见，文园病若何。\n山城春事晚，竹屋雨声多。\n幕府官如水，门庭雀可罗。\n东家有贺老，杖屦肯相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16100,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宁化县","author":"卢琦","text":"触热来宁化，居人已卖瓜。\n田园饶五色，市井近千家。\n孤㙮凌云耸，青山对县斜。\n萧疏兵火后，抚景重咨嗟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16101,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过建宁县","author":"卢琦","text":"蓝舆度林杪，还向此中过。\n县古人家少，山深秋意多。\n民风原俭啬，官事只催科。\n赖有二三友，相从共啸歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16102,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠李逢原","author":"卢琦","text":"逢原为县吏，地僻类仙居。\n俸入堪供母，公馀每读书。\n诗人赓棣萼，邻叟饷溪鱼。\n家世应如许，期君发轫初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16103,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送长乐县吏","author":"卢琦","text":"郑生赋归去，吏隐大江浔。\n刀笔萧曹术，诗书孔孟心。\n潮平鱼入市，山近荔成林。\n双剑津头客，时时望好音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16104,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"昆山客邸","author":"卢琦","text":"萍水须相识，居然子共欢。\n天高秋月落，江近夜潮寒。\n湖海诗怀壮，云山客梦残。\n出门舟欲发，犹自倚阑干。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16105,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送高教谕","author":"卢琦","text":"建安小洙泗，之子去横经。\n远树含烟碧，香芹带雨青。\n深衣登讲席，綵服戏亲庭。\n须忆分携处，吟诗柳外亭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16106,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游万竹庵","author":"卢琦","text":"公馀乘兴出，时向北山游。\n翠雨环檐响，清音满座浮。\n佛香晴殿冷，僧榻午窗幽。\n试弄桓伊笛，凉风碧树秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16107,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游东林庵","author":"卢琦","text":"窈窕东林里，幽人此结庵。\n檐松青郁郁，庭草绿毵毵。\n对景应无住，谈禅向已参。\n静观心自在，明月照澄潭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16108,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游万松庵 其一","author":"卢琦","text":"昔贤归隐处，山路入云长。\n绝顶松涛吼，幽岩桂雨香。\n白云封药灶，流水落莲塘。\n客至忘归去，连宵宿上方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16109,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜","author":"汪克宽","text":"玄观空山静，秋风晚更清。\n岚光连雾气，松响乱泉声。\n竹户流星近，兰阶落叶平。\n夜寒人不寐，独对一灯明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16110,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游北岩庵","author":"卢琦","text":"曲径峰前转，临行见虎踪。\n孤庵万树合，绝涧一桥通。\n芳草凝微露，灵湫饮綵虹。\n山僧面壁坐，应悟万缘空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16111,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜泊羊角坝","author":"卢琦","text":"系舟羊角坝，一夜梦难成。\n月色千秋雪，滩声万马兵。\n鱼龙攀石出，鸟雀绕枝惊。\n惆怅浑无奈，还添白发生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游吴廷用南庄","author":"卢琦","text":"公事多馀暇，看山到远村。\n云庄依竹见，樵径过桥分。\n野水晴舂碓，岩松昼掩门。\n所忻花县近，归路任黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次郑公除夕韵","author":"卢琦","text":"爆竹声除腊，洪钧气转春。\n一年诗太苦，今日酒偏醇。\n援笔题桃帖，焚香供玉宸。\n仰看云汉外，斗柄指东津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送福唐林氏兄弟","author":"卢琦","text":"故人伤远别，对酒且淹留。\n冠盖临溪上，旌旗夹道周。\n风霜下残日，鹏鹗起高秋。\n独有林才子，赠言多远猷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次繁昌邑宰梅双溪韵","author":"卢琦","text":"矍铄繁昌令，曾为观国宾。\n儒冠犹破帽，礼服尚垂绅。\n淡泊心无愧，清癯自有神。\n老膺朱绂贵，惊看白头新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄同年状元拜住善御史","author":"卢琦","text":"胪唱乍传同虎榜，绣衣还见上乌台。\n石头城下题诗遍，天目山前揽辔回。\n使节照江秋水立，谏书排闼曙云开。\n东南赤子疮痍甚，日望分司御史来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客武林寄马元臣山之英二同年","author":"卢琦","text":"结束琴书上帝畿，谁知人事与心违。\n半生薄宦真堪笑，六月扁舟独自归。\n淮甸水深荷叶阔，吴江烟暖稻苗肥。\n行囊只有诗题富，写向天风寄绣衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山之英寓所观壬午进士题名记有感","author":"卢琦","text":"曾携赋草入天门，五色云中谒至尊。\n一代文明千载会，十年耆宿几人存。\n尘中事往浑如梦，客里情亲得共论。\n浪说题名垂不朽，相期努力答君恩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自高邮买舟还江南至常州值雨寄鲁元达","author":"卢琦","text":"万里扁舟偶独还，毗陵城下少盘桓。\n天连旷野青山少，雨满空楼白昼閒。\n旅邸有人垂顾问，家书何日寄平安。\n半生勋业成迂阔，犹自窗前把镜看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和韵答白明之","author":"卢琦","text":"君厌区区簿领劳，诗人相对便挥毫。\n幽居最喜青山色，熟睡不知红日高。\n夜雨江湖谈旧事，秋风庭院试新袍。\n笑他名利途中客，一似扁舟驾海涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"汀州道中","author":"卢琦","text":"七闽穷处古汀州，万壑千岩草树稠。\n岚气满林晴亦雨，溪声近驿夜如秋。\n云间僧舍时闻犬，兵后人家尽买牛。\n但得龚黄为太守，边方从此永无忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄泰宁鲍县尹 其一","author":"卢琦","text":"重冈复岭渺天涯，触热驰驱力欲疲。\n但愿官仓长有粟，不愁客路更多岐。\n政声尽说于阳好，心事还逢鲍叔知。\n别后思君劳梦寐，樵川川上月明时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄泰宁鲍县尹 其二","author":"卢琦","text":"鲍侯招客梵宫游，杰阁岧峣近斗牛。\n山势北来如展幕，溪流西去可通舟。\n半峰落日孤城晚，一榻凉风万叶秋。\n想有新诗留绝顶，还应寄与故人不。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"云岩书院","author":"卢琦","text":"路入秋云翠几重，人烟山色水声中。\n精庐不废名贤祀，勒石还镌旧令功。\n野径凉生松叶雨，畬田香满稻花风。\n醉归马上频回首，鳔缈亭台倚半空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"临汀城外别丁景文","author":"卢琦","text":"六月骑马奔出郭，故人相送高洋桥。\n百年古郡千峰绕，万顷平田十里遥。\n客怀欲别且须酒，溪月自来何待招。\n后夜相思定何处，乱山叠叠雨潇潇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵孝子卷","author":"卢琦","text":"仙居连朝雨雪集，孝子血泪盈衣襟。\n层空忽尔露日脚，寸念直可回天心。\n何处买山埋白骨，有人作传胜黄金。\n顾余无限思亲意，南浦相逢感慨深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周孝子卷","author":"卢琦","text":"当时翁媪去何之，四岁孤儿托付谁。\n禄养莫酬平日志，画图长寄百年思。\n田园夜雨先庐旧，屺岵秋风宰木悲。\n我有二亲俱已矣，不堪对此泪双垂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题徐方外捕盗应梦图 其一","author":"卢琦","text":"徐老平生志不群，力能擒贼胜千军。\n一官落拓司征日，数纸纵横纪梦文。\n湖海至今传异事，朝廷终不负奇勋。\n西风南浦还相见，击节狂歌月到门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题徐方外捕盗应梦图 其二","author":"卢琦","text":"钓龙台下解舟去，大庾岭头驰马过。\n驿路云生椰子树，江城月满鳄鱼波。\n青山是处题诗遍，绿野从今买犊多。\n客里送秋仍送客，潇潇秋雨奈愁何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送朱希文","author":"卢琦","text":"江城水阔雁来稀，闽岭云深去路微。\n风土于人谁信美，年华惊梦不如归。\n过家幸遇宾兴日，行路宁辞露湿衣。\n安得重为论宿昔，好赊邻酒扣柴扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴元珍","author":"卢琦","text":"几年不剪西窗烛，此日相逢如别何。\n冷宦莫嗟乡国远，故人今在省台多。\n闽关把袂云生树，滦水维舟月满河。\n我尔重寻燕蓟路，凤城载酒日相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠片云上人","author":"卢琦","text":"曾忆相逢月台下，清谈犹自带烟霞。\n避喧却爱山中寺，访旧还寻海上槎。\n石鼎烹茶分野水，纸窗剪烛看檐花。\n定知归去松萝路，犹向云间采药芽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答林迪斋陈景渊","author":"卢琦","text":"村北村南学翠岑，二分觞咏学山阴。\n尘中岁月成何事，岩下烟霞识此心。\n三径落花红簌簌，一溪流水碧沈沈。\n村醅时向邻翁醉，不羡渠家帐下斟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送万谦甫归铭山","author":"卢琦","text":"每向铭山山下过，还来此地却逢君。\n少年从吏身何忝，平日吟诗兴不群。\n十月虎林天欲雪，一舟渔浦水连云。\n自怜客况无聊赖，耳畔蛙声不忍闻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"依韵答欧士中","author":"卢琦","text":"客舍凄凉生绿芜，经年祇傍野人居。\n尊空每买邻家酒，巷僻应回长者车。\n白鸟梦残枫树冷，黄花香老竹篱疏。\n相逢且莫谈离别，一别如今十载馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送孙君猷","author":"卢琦","text":"久客桃源若避秦，孙郎一见却情亲。\n诗才直欲空馀子，书法犹能学古人。\n黄瘴秋深云似墨，绿波夜静月如银。\n元戎麾下应相问，为道年来白发新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄吕用宾县尹","author":"卢琦","text":"烽燧年来暗不消，溪南剑气夜干霄。\n共欢百里尘初静，犹恨诸酋首未枭。\n剪烛西窗山市雨，移舟南浦海门潮。\n桐边定见尹明府，为寄相思道路遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游蓬壶因呈诸公一笑 其一","author":"卢琦","text":"匹马重寻蓬岛路，东风二月柳花香。\n晓烟万笠人耕垄，夜雨孤舟客卧床。\n野老送迎悲往事，山童歌舞学红妆。\n群贤此路从来少，未必山阴胜永阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游蓬壶因呈诸公一笑","author":"卢琦","text":"我来作县已三载，偏爱毗湖春酒香。\n溪上画桥朝系马，雨中茅屋夜连床。\n多情黄鸟短长曲，无数桃花浓淡妆。\n欲学渊明归种柳，不栽桃李满河阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"依韵奉呈敬在博士先生并简诸公一笑","author":"卢琦","text":"遥逐荐书游蓟北，暂将教铎振泉南。\n桃花门巷晚风急，燕子帘栊春日酣。\n海内干戈垂盛化，山中灯火照清谈。\n兴来共饮溪边市，一任人嘲醉堕簪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"予客莆中同登壶山真净岩访古道了堂二师","author":"卢琦","text":"松扉深入白云中，蹑蹬扪萝路可通。\n结社几人从惠远，登山何处觅壶公。\n五更客梦茅檐雨，六月秋声木叶风。\n独倚阑干望江海，故乡应在海门东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正己亥六月游壶山宿真净岩访忠门西江陈公江亭 其一","author":"卢琦","text":"懒听江城奏鼓笳，却从村坞问桑麻。\n临风亭馆非人境，近海云林是我家。\n山径草肥嘶瘦马，石矶水浅动轻槎。\n山间犹自忧民瘼，日暮回头看稻花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正己亥六月游壶山宿真净岩访忠门西江陈公江亭","author":"卢琦","text":"树下松扉绝点埃，何须海上觅蓬莱。\n十年客鬓尘中改，六月襟怀酒后开。\n云影不随飞鸟没，江声偏逐晚潮来。\n干戈满眼风尘暗，欲别西山首重回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"再道江亭用前韵酬美中","author":"卢琦","text":"近来南国奏胡笳，处处干戈乱似麻。\n避俗每观高士传，过江直访故人家。\n百年风雨祠前树，万里云涛海上槎。\n犹忆太平无事日，西湖载酒赏荷花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽安童参政先任兴化太守后任参政分省兴化","author":"卢琦","text":"昔日郡侯今将相，出师未捷殒边城。\n空令父老思黄霸，重使英雄吊孔明。\n公论有人书野史，旅魂无路到神京。\n东山宾客知多少，谁似羊昙涕泪倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和虞伯生寄张总管韵","author":"卢琦","text":"玉署仙人化綵云，每于江海见遗文。\n百年词翰真无敌，五马家声赖有君。\n堆笏床头馀旧物，读书窗外种芳芸。\n停骖只在西湖上，一席西风许共分。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓平南善应庵述怀 其一","author":"卢琦","text":"薄宦曾充盐荚使，经营邦赋愧非才。\n此身已拟休官去，斯地还因避乱来。\n欲觅桃源终鳔缈，偶过莲社且徘徊。\n家僮莫问村醪熟，我已兼旬废酒杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寓平南善应庵述怀","author":"卢琦","text":"去年过此身犹健，今日重来一病翁。\n乱地风霜如塞上，隔江烟火是莆中。\n孤鸿唳月秋空碧，万叶经霜野树红。\n竹下闭门来客少，清谈日与老僧同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病中怀王德辉","author":"卢琦","text":"忆与故人分袂日，游鱼吹浪动新荷。\n一年又见黄花老，两地相思白发多。\n月落峰头霜满树，雨馀溪上水生波。\n知君囊底诗偏好，寄与茅斋敌病魔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题节妇卷","author":"卢琦","text":"陈家有女李家妇，三十哭夫应断肠。\n梧叶几番深夜雨，梅花一树短篱霜。\n閤东才俊眉俱白，堂北光阴鬓已苍。\n不待门前植华表，人间野史百年香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月晦日郑友云招饮","author":"卢琦","text":"客乡寥落三春尽，惟有故人情最亲。\n不管柳花飘巷陌，却从藜杖过比邻。\n帘间银烛摇疏雨，酒后金盘荐细鳞。\n何日携樽郊外去，绿阴庭院更宜人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客建宁别李季昌","author":"卢琦","text":"壶公山前曾赋别，越王山下还论文。\n采茶夜煮南浦雨，寻山晓踏西岩云。\n青囊经在君能说，丹鼎功成我欲分。\n客舍明朝又南北，凉飙送叶秋纷纷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游真净岩和方时举韵","author":"卢琦","text":"林下高僧睡得牢，春风几度到园桃。\n龙归洞口云犹湿，鹤唳峰头月正高。\n千里溪山无战垒，半江烟雨有鱼舠。\n我来还忆方时举，斗酒篇诗意气豪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答乐屿陈乐斋","author":"卢琦","text":"曾向虞庭看凤凰，微生自喜际明良。\n久无消息通蓬岛，忽有文章落草堂。\n永夜怀人江月近，频年笑我石田荒。\n渭滨钓叟君知否，老去功名汗竹香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]