[{"title":"至节即事 其三","author":"马臻","text":"閒看来往坐多时，雨洒香尘土湿微。\n珠翠压头行不稳，娇羞儿女把人衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至节即事 其四","author":"马臻","text":"已有纱笼照舞儿，喧喧鼓笛自相随。\n谁家院落来呼唤，门外天明也不知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至节即事 其五","author":"马臻","text":"帘旌叠叠绣鲛鮹，遮护香风不放消。\n却恐酒阑先睡去，预教小玉问明朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至节即事 其六","author":"马臻","text":"新词听彻思徘徊，侍女擎羹下箸迟。\n红烛有花心暗喜，流苏双挂玉梅枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至节即事 其七","author":"马臻","text":"店舍喧哗彻夜开，荧煌灯火映楼台。\n欢游未晓不归去，早有元宵气象来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"村中书事二首 其一","author":"马臻","text":"饷留儿女自喧呼，指点春禽又引雏。\n村妇相逢还笑问，把蚕今岁是三姑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"村中书事二首 其二","author":"马臻","text":"轧轧缲车草屋低，新篁带箨出檐齐。\n莺雏未省逢人避，直向路傍花上啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春归曲","author":"马臻","text":"平林静绿生幽芳，桃脂杏粉攒蜂房。\n西楼浪客唱别恨，屈卮酒暖珊瑚光。\n百劳留春春不许，愁觜喃喃如寐语。\n翠鸦游女卷香归，一夜花神老风雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏六言三首 其一","author":"马臻","text":"堤晚游人争渡，花密流莺乱鸣。\n近水亭台柳色，转山楼观钟声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏六言三首 其二","author":"马臻","text":"烟外幽人独立，落日正照平台。\n野鹭联翩飞去，山云断续归来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏六言三首 其三","author":"马臻","text":"楚尾吴头旧梦，水边山际閒情。\n一夜杏园风急，等閒吹老莺声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻蝉","author":"马臻","text":"短翼含风薄似秋，一声声带夕阳愁。\n年年古柳官塘路，催得行人白尽头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"飞霜歌","author":"马臻","text":"飞霜悴百草，芳兰亦委柯。\n纵欲努旧力，奈此寒风何！\n在昔结花初，岂不受春多。\n耻随桃李场，托迹空山阿。\n四时有代谢，阳艳忽已过。\n薰莸苦不辨，一体同消磨。\n不如牡丹根，密幄相遮罗。\n伤心复伤心，伤此《飞霜歌》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"旅夜","author":"马臻","text":"自惭身世拙，客里更关情。\n月树回凉影，秋声叠夜砧。\n道能忘畏垒，酒不破愁城。\n睡薄吟魂冷，西风亦屡惊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄澉川杨如山","author":"马臻","text":"吾闻沙丘之马黄骊牝牡世莫知，九方皋去不复有。\n天风吹我沧海边，忽地相逢钓鳌手。\n论文托契输心胸，倾倒金尊斟绿酒。\n登高望远古意多，百年之乐能几何？\n男儿屑屑志不展，秋霜满鬓空蹉跎。\n酒酣眼极情未毕，笑指青山歌落日。\n却怜徐福向蓬丘，苍苍烟浪无消息。\n明朝挂席我归来，西湖十月梅花开。\n梅花开，动诗思。\n思君不待春雁回，因之一寄平安字。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日独坐言怀","author":"马臻","text":"昔日欢娱忆此身，名园歌舞接芳辰。\n蛰雷夜送催花雨，香径春迷斗草人。\n合沓楼台形势壮，风流莺燕语言新。\n眼前旧物浑狼藉，休怪提壶劝客频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"桃花","author":"马臻","text":"浅碧繁红又满枝，化工消息本无机。\n艳滋晓露莺摇落，香渍春泥燕掠归。\n金谷园中芳草在，玄都观里昔人非。\n自从云隔天台路，刘阮如今梦亦稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行春","author":"马臻","text":"行春无侣自迟留，汀草汀花暖更稠。\n马援近来成矍铄，谢安应合减风流。\n乍惊语燕穿人屋，无赖游丝绊客舟。\n老我光阴忽如此，不判尊酒复何求？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈渭叟归山中","author":"马臻","text":"人生少至百，一别动经载。\n不信岁月驰，请看容鬓改。\n先生本是超绝人，长竿学钓清渭滨。\n钓头不解挂芳饵，岸草汀花空复春。\n大鱼小鱼求不得，芒鞋忽厌人间窄。\n手携诗卷出万山，来觅湖边闭关客。\n终朝相对百不为，口中咄咄唯言诗。\n飞花浊酒日色静，天地悠悠知者谁？\n兴尽翩然即归去，鹤巢雏在门前树。\n他时我亦访君家，但问青山白云处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閒居自遣","author":"马臻","text":"喜无轩盖款柴荆，静里天机见物情。\n德愧王良千里马，食无娄护五侯鲭。\n海翁岂为鸥防虑，稚子休烹雁不鸣。\n一笑行藏头已白，新凉又到读书檠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁暮偶成","author":"马臻","text":"古人不可见，养拙谢时髦。\n隐傍渊明柳，饥怀曼倩桃。\n凿坯谁敢望，抱瓮岂应逃。\n义见冯公伟，仁依范叔豪。\n乾坤心浩浩，江汉日滔滔。\n老境诚难料，繁荆未易薅。\n亲朋随宿草，岁月掩秋涛。\n夜短鸡筹促，天寒象纬高。\n燕情伤局促，松节感持操。\n姜被流离析，邹裾揖让劳。\n乱云迷鹤路，短发问鱼舠。\n念与追攀绝，心辞宠辱熬。\n世情甘木石，我辈岂蓬蒿。\n万事差池里，长歌对浊醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送杨仲弘之京","author":"马臻","text":"迢递官塘官树阴，征鞍催发短长亭。\n荆吴雨涨河流白，齐鲁春归岱岳青。\n玉宇风云开北极，金台日月聚文星。\n近闻下诏求贤急，刘向终须论五经。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和仇仁近岁暮见寄韵","author":"马臻","text":"瑶琴三叠此心间，目送飞鸿信手弹。\n千里故人行自远，一声《白雪》和应难。\n贺公岁晚称狂客，郑老才高只冷官。\n且向吟边了身世，西山暮雨卷帘看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越上感怀","author":"马臻","text":"曾负琴书到越中，别来三十五秋风。\n江山有待容回雁，岁月无情类转蓬。\n禹穴荒烟寒木老，鉴湖旧水野田空。\n骑鲸人去知何在，拟向沙边问钓翁？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"忆孤山","author":"马臻","text":"自从梅树委荒烟，湖上风光不值钱。\n见说年来春好在，拟携尊酒报啼鹃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"冬至即事","author":"马臻","text":"结屋傍湖水，对门三四峰。\n心灰无复煖，鬓雪近来浓。\n孤雁雨中过，短书灯下封。\n平生故人意，衰老不相从。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画卷","author":"马臻","text":"翠叠洪濛色，云凝淡沲春。\n高寒不可到，应有采芝人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"为翁子善作晴江图","author":"马臻","text":"故人遗我清江县里一匹纸，白光晶荧心所好。\n几欲写作晴江图，尘土昏人意不到。\n竹风入户忽然铿戛琅玕声，为我胸中扫烦躁。\n濡毫扫素游其神，乃悟周穆王时西极之化人。\n但见重峦列嶂盘春转碧应接来不断，沧浪之水倒影翻青春。\n风樯沙鸟纷入眼，物色明丽不可陈。\n因思神禹功，疏凿本天意。\n愧我一寸笔，浩浩逼茫昧。\n又疑此水通星河，八月秋风扬素波。\n君若乘槎访牛渚，为言博望成蹉跎。\n呜呼，云边纵得支机石，成都卜肆今日无人识。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"水轩夏日","author":"马臻","text":"碧窗昼寂幽意长，竹阴满地琴尊凉。\n轻雷送雨远不到，雪白水花生晚香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄筹峰林芝岩三首 其一","author":"马臻","text":"小院回廊日正长，绿阴幽草自生香。\n春风老矣犹多事，时送飞花出短墙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄筹峰林芝岩三首 其二","author":"马臻","text":"市声不到野人居，满院花阴昼睡馀。\n偶忆新城罗给事，枉将心力著《谗书》。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄筹峰林芝岩三首 其三","author":"马臻","text":"青鞋布袜厌趑趄，肯向何门学曳裾。\n错为黄金换词赋，一生惆怅马相如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏三首 其一","author":"马臻","text":"幽芳泣露质，好鸟饮春声。\n尽向东风里，悲欢各有情。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏三首 其二","author":"马臻","text":"荣贵如风花，安得长美好。\n冯唐不解事，却恨发白早。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杂咏三首 其三","author":"马臻","text":"凉露老荷叶，莲房亦已空。\n可怜红蓼花，摇摇受西风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山居写兴","author":"马臻","text":"人事喧喧任弈棋，青山数亩是归期。\n分将药草锄云种，买得松杉趁雨移。\n老去故人多入梦，愁来閒事总成诗。\n芒鞋布袜身犹健，十里莎堤信杖藜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖山春游暮归偶作","author":"马臻","text":"西月光景微，斜檐尚如练。\n揽衣昧旦起，林峦淡方见。\n景风积雾敛，曙牖新禽啭。\n尘动九衢喧，烂烂流目眩。\n游衍惜欢悰，行行信郊甸。\n遗情席细草，赏静引华馔。\n山水信恬和，动息各恩怨。\n云断旧时人，梁回去年燕。\n姿容一已晚，浩荡群芳变。\n岂不怀尔思，徇往何由羡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画龙门山桑乾岭图","author":"马臻","text":"昔我经龙门，晨发桑乾岭。\n回盘郁青冥，驱车尽绝顶。\n驿骑倦行役，苦觉道路永。\n引领望吴楚，日入众山暝。\n归来惬栖迟，山水融心境。\n寸毫写万里，历历事可省。\n理也存自然，畴能搜溟涬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画海南入贡天马图","author":"马臻","text":"余吾天马生水中，毛如泼墨耳插筒。\n雄姿挺挺浴海气，一刷万里追遗风。\n九夷入贡宾来服，画出犹能骇人目。\n韩子休教喂地黄，太仆能令饱粱肉。\n谁怜东郊瘦马硉兀如堵墙，汗血力尽德不扬，尚望明年春草长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食日","author":"马臻","text":"密竹疏帘春昼□，疾风甚雨满江南。\n又逢寒食一百五，不觉行年六十三。\n楚女腰肢从妙舞，晋人标格祇清谈。\n不劳燕子终朝语，冷暖时情我自谙。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读秦纪","author":"马臻","text":"六国争雄事已空，南游勒石纪成功。\n早知三月咸阳火，不买鱼灯照夜宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嗟馀春","author":"马臻","text":"春雨足，春水满，岸花匼匝光风暖。\n人间杜宇最知机，啼得血流春不管。\n迷芳著物苦忘归，直待杨花似雪飞。\n多少好怀成别恨，馀香沁入野蔷薇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题溪山访友图","author":"马臻","text":"溪风吹长松，石路秋影薄。\n下有寻幽人，支筇注林壑。\n良朋眇何许，杂树森草阁。\n画师发深机，笔底气参错。\n我昔事扁舟，颇识山水乐。\n于今日月驶，此景亦萧索。\n愧乏买山资，老负宿昔诺。\n展卷令人嗟，高歌激寥廓。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"湖楼夜坐","author":"马臻","text":"孤楼侵树小，老雁入云迷。\n月暗水光白，夜深邻语低。\n钟声传下竺，梅信失西溪。\n偶忆曾游寺，尘昏壁上题。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"田父词二首 其一","author":"马臻","text":"龙钟田父住深村，桑柘冈头石路分。\n犹领儿孙到城市，向人听读劝农文。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"田父词二首 其二","author":"马臻","text":"处处丛祠鼓笛喧，已占蚕麦十分添。\n醉骑牛背归来晚，乱把山花插帽檐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成六言二首 其一","author":"马臻","text":"两袖水风春冷，一抹山烟晚晴。\n小槛倒披花影，归船远送歌声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日偶成六言二首 其二","author":"马臻","text":"燕拂花阴绣毂，人指箫声画楼。\n杨柳六桥旧梦，夕阳一段新愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日閒居杂兴四首 其一","author":"马臻","text":"宿雨兼风酿麦秋，馀寒欲断自迟留。\n杜鹃啼得百花尽，却向绿阴深处愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25880,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日閒居杂兴四首 其二","author":"马臻","text":"茶香庭院一枰棋，柳影侵阶日自移。\n因见刺桐花满树，等閒忆得故园时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25881,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日閒居杂兴四首 其三","author":"马臻","text":"绿波如染带花流，阵阵鱼苗贴岸游。\n日暮画船歌舞歇，春声散入锦缠头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25882,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日閒居杂兴四首 其四","author":"马臻","text":"花底飞觞酒浪翻，才迎春至又春残。\n日斜客散炉烟尽，自洗窑瓶插牡丹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25883,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春江言别口占","author":"马臻","text":"送子清江皋，江烟黯行路。\n鸟啼山隐春，潮长人争渡。\n世上无别离，何由发垂素。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25884,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"偶成小轴山水寄仰山长老熙晦翁","author":"马臻","text":"南山每独往，问讯西隐楼。\n清阴蔼乔木，天风忽凉秋。\n归舟溯平湖，遥见仰山月。\n月色如德人，万古光不灭。\n素练不盈尺，写此千里心。\n欲知相忆不，明月是知音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25885,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李安忠画雪岸寒鸦图","author":"马臻","text":"北风万里吹石裂，古树槎枒摧朽铁。\n群乌哑哑如苦饥，倦飞还向空林歇。\n孤村荒寒得食远，日暮沙边啄残雪。\n回情诉意各有态，羡杀画师心更切。\n我尝记得天随诗，至今读之长激越。\n妇女衣襟便佞舌，始得金笼日提挈。\n老乌老乌尔身毛羽黑离离，况复人间厌尔啼。\n何不飞鸣丈人屋，丈人屋头春柳绿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25886,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其一","author":"马臻","text":"岸水依痕钓艇间，炊烟几处出芦湾。\n西窗正是斜阳好，一带泥金抹远山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25887,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其二","author":"马臻","text":"月华如水天如空，苍烟远树涵秋容。\n笔头墨尽意不尽，参错云山三四重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25888,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其三","author":"马臻","text":"数点寒鸦水绕村，几家茅屋掩柴门。\n白头溪叟归来晚，自把渔舟系柳根。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25889,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其四","author":"马臻","text":"轻云漠漠天影空，江村雨过生微风。\n似嫌野外春淡薄，故点桃花深浅红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25890,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其五","author":"马臻","text":"春阴淡荡归帆急，叠嶂层峦凝空碧。\n知是夜来风雨深，村外野桥低二尺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25891,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画杂诗六首 其六","author":"马臻","text":"采菱渡头秋日晚，孤楼隔岸知谁家？\n参差远树杂云气，灭没渔舟侵浪花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25892,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送江西熊履善茂才之金陵","author":"马臻","text":"君向秦淮我在吴，柴门白发老西湖。\n书来莫附洪乔便，只道经年一字无。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25893,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其一","author":"马臻","text":"绕湖无处避芳尘，叠鼓红旗彩鹢新。\n冉冉春云来不断，涌金门外踏青人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25894,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其二","author":"马臻","text":"霍山庙食庆流虹，民物讴歌乐岁丰。\n七宝社回呈了马，年年归路雨和风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25895,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其三","author":"马臻","text":"南屏山色染春烟，路接高峰社鼓喧。\n第一桥边春更好，御舟閒在翠芳园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25896,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其四","author":"马臻","text":"问谁偏解占风光，飞盖金鞍白面郎。\n山北山南游欲遍，画船教舣集贤堂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25897,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其五","author":"马臻","text":"瑞烟祠宇隐垂杨，士女穿花语笑香。\n三十九贤生翠碣，虚舟亭上借传觞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25898,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其六","author":"马臻","text":"镂玉雕琼簇闹竿，珠花翠叶缕金篮。\n东家年少贪游冶，正值明朝三月三。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25899,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西湖春日壮游即事 其七","author":"马臻","text":"流苏两两挂船头，绣额珠帘不上钩。\n《金缕》缓歌家宴静，午前先入里湖游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":25900,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]