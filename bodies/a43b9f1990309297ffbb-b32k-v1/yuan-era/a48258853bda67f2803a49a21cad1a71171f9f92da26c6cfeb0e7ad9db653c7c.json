[{"title":"送徐子贵南恩州学正","author":"陈颖庆","text":"笔床茶灶米家船，去结香芹碧藻缘。\n高士旧闻人下榻，冷官谁谓客无毡。\n诗成蜃气楼台外，目送鸢飞潦雾边。\n往事沙虫堪一慨，海灵山下浪浮天。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33466,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"舟宿武山是夕风雨骤发余襄公候潮处也","author":"陈颖庆","text":"海门鲸浸浪掀天，点点归帆贾客船。\n怪石中流成虎踞，腥风半夜起龙眠。\n神仙弱水知何许，天地无情任可怜。\n惟有朝昏潮信在，武陵遗迹尚依然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33467,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其一 金鼓朝阳","author":"黄仲翁","text":"半抹红花满，山城物色新。\n楼台三界晓，花鸟万家春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33468,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其二 石岐晚渡","author":"黄仲翁","text":"野船春浪急，烟柳夕阳低。\n流水南还北，行人东又西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33469,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其三 南台秋月","author":"黄仲翁","text":"阊阖城南夜，澄鲜一望中。\n可怜台上路，举步是蟾宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33470,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其四 浮虚春涛","author":"黄仲翁","text":"西北朝宗派，东南合踏潮。\n长风随入夜，吹作雪翻飘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33471,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其五 阜峰文笔","author":"黄仲翁","text":"群峰超绝处，特自起孤高。\n卓地青筠管，抽天碧兔毫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33472,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其六 天池芰荷","author":"黄仲翁","text":"天池方半亩，半亩尽荷花。\n借问荷花主，蓬莱是主家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33473,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其七 金紫岩溜","author":"黄仲翁","text":"垂绅初沥沥，漱玉乍玲玲。\n山色惊人目，泉流足我听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33474,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"香山八景诗 其八 长洲烟雨","author":"黄仲翁","text":"柳暗溪桥路，云封古洞门。\n牧童村外笛，驱犊下黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33475,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"谷山在藤县城北","author":"麦澄","text":"层峦叠翠瘴江湄，水色林光云起时。\n云鹤自闲春自老，个中风月几人知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33476,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东山","author":"麦澄","text":"东山云敛碧天开，月色苍茫海上来。\n风露满空清似洗，一庭光彩转瑶台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33477,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石壁山高十馀丈，下临大江，是多松桧","author":"麦澄","text":"千尺丹厓削石屏，波光倒树碍云行。\n何当借我烟霞榻，卧听泉声看月明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33478,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赤水峡两岸壁立，一水中流，树木蔚然，岚气朝夕不散","author":"麦澄","text":"水气初升云气浮，山林不辨鸟声幽。\n天风吹入三竿日，草木依然水绕洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33479,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"藤江","author":"麦澄","text":"桃花浪暖锦鳞肥，白发渔翁罢钓归。\n柳底系船篷底坐，满前鸥鹭已忘机。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33480,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"鸭滩","author":"麦澄","text":"中流乱石水交加，滚滚寒声带雪花。\n霜月不随流水去，只将秋色伴渔家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33481,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送方外","author":"戴希文","text":"悤悤方外友，弱冠往蓬莱。\n剑挂双龙去，书传只鹤回。\n云深丹药老，春静碧桃开。\n闲里披图看，双眸厌俗埃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33482,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏鸢飞鱼跃亭残句","author":"戴希文","text":"西郭云连沙树晚，前池风荐水花凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33483,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春江待渡应制","author":"戴次胄","text":"绿杨芳草马频嘶，担重奚奴举步迟。\n小艇不来春水急，沙头独立已多时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33484,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽戴希文","author":"赵光国","text":"哲人呼不返，谁结岁寒盟。\n有子皆英伟，希年擅老成。\n文章留轨范，生死隔幽明。\n怅恨无知己，临风涕泗倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33485,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题张奂墓残句","author":"佚名","text":"易启先天秘，琴弹太古声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33486,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潮州开元寺铜云钣铭","author":"佚名","text":"道以时鸣，警于朝夕。\n清净音闻，如夔拊石。\n觉彼参玄，尽来知识。\n镇重禅林，有典有则。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33487,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游白鹤观","author":"梁信","text":"罗浮瀑布九百八，惟是五龙潭水清。\n我来白鹤寄閒迹，近听龙潭飞瀑声。\n丹崖峻削势千级，松楸直泻涛声急。\n泠泠琴筑四山空，泉风清听扶筇立。\n昔人漱石与枕流，我亦洗耳追巢由。\n箕山颍水足千古，拟之此地别何求。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33488,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游黄龙洞","author":"梁信","text":"我来罗浮访仙迹，数不尽罗浮峰四百。\n黄龙巀嵲洞最幽，两水夹山山路僻。\n攀萝直上登云梯，探入松林洞门辟。\n流杯池水声潺潺，玉龙飞走春潮白。\n七星坛畔逢赤松，邀入龙宫蹊径碧。\n笑傲烟霞生隐心，红尘不到烦襟释。\n何事将金别买山，此处岩栖即安宅。\n不愿宦游拖长绅，愿从罗浮山下为居民。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33489,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閒居自咏","author":"梁旷宗","text":"笑卧乾坤里，超然世外身。\n门无车马客，径有竹松邻。\n梦上三竿日，醉来几度春。\n昼长时听鸟，风静漫投纶。\n得趣猿堪狎，忘机鸥共亲。\n羲皇馀一枕，高卧乐天真。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33490,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日登高","author":"陈野仙","text":"黄菊篱边已放花，摘来盈把泛流霞。\n振衣直上冈千仞，问酒须逢曲几车。\n囊里霜萸拚尽醉，坐间秋色转无涯。\n举头十数烟村外，绿绿溪流淘白沙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登乌石","author":"陈野仙","text":"优游云外山，缥缈翠微间。\n烟锁深松暗，花开春日闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独坐","author":"陈野仙","text":"桃红柳绿一年春，诗句清新自有神。\n闲坐榕阴无个事，不知谁是谪仙人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿乌石","author":"陈野仙","text":"曲水环山望欲迷，沁心美月息春溪。\n仙翁炼药乘云去，云自高飞鸟自啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题石梅","author":"陈野仙","text":"瑰然片石长苔痕，谁种先天太极春。\n欲向花神问消息，疏枝无语自黄昏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤山钓矶 其一","author":"陈与言","text":"一曲沧浪欸乃间，数声清彻凤山湾。\n世多俗客忙相逐，天许渔郎剩得闲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤山钓矶 其二","author":"陈与言","text":"潮汐回旋绕凤山，临流把钓自安閒。\n渔矶夜夜歌明月，谁道遗民去不还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33497,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"华古小隐","author":"陈文瑶","text":"古洞云深石径幽，寒泉漱玉涧中流。\n闲来试放逋翁鹤，刷羽千峰独唳秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33498,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石穴洞天","author":"陈文瑶","text":"到处摩崖探白云，小山花鸟度深春。\n秦皇空有坑儒计，不及岩泉打坐人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33499,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登金刚髻峰","author":"陈文瑶","text":"振衣应万仞，独坐觉神怡。\n眼阔沧溟窄，步高碧巘低。\n中天空楼阁，南极度虹蜺。\n长啸青云起，遥连五岳齐。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33500,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"梅岩图景","author":"陈文瑶","text":"欲晴欲雨霭溟濛，一朵梅花深谷中。\n寒鹊也应知此味，六花飞散唤东风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33501,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"尖石趺坐","author":"陈文瑶","text":"爱尔岩岩亦秉平，乾坤老此结寒盟。\n重华去后谁相与，一片栖云卧岁星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33502,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宗人伯静许惠笔以诗趣至","author":"黎伯元","text":"我有翰墨交，中山毛氏子。\n颖也最白眉，精锐供任使。\n助我学草元，旦暮常密迩。\n朅来何间阔，退锐非昔比。\n免冠发尽秃，之武今老矣。\n不见时月间，令我生吝鄙。\n吾宗有才彦，文房兼四美。\n意遣中书君，授好华窗几。\n图新即舍旧，用壮厌衰齿。\n拟露囊中锥，增高洛阳纸。\n时艰方用武，文事谁料理。\n运用如操戈，微尔孰知己。\n作诗趣宗人，江山先助喜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33503,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风火径有警纡道陟崇而行","author":"黎伯元","text":"叱驭上险巇，披葺入菑翳。\n向来轻车路，豺虎有吞噬。\n王事何能安，劳形心孔悸。\n前登崖壁峻，下陟石路细。\n羸马付仆夫，蹉跌忧困弊。\n蛇蟠尚回转，猱度姑少憩。\n梯凳迹暂离，荆棘牵衣袂。\n出山见樵牧，相见如相慰。\n及兹履康庄，巅崖悯劳瘁。\n平山方寸地，坦坦无拘系。\n艰难有时遭，浇漓嗟季世。\n人心甚太行，所遇尤可畏。\n念此夜达晨，归田宜早计。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33504,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其一","author":"黎伯元","text":"有客有客黎氏子，携书积岁辞故里。\n朝食日照苜蓿盘，夜灯风露亲图史。\n三年官闲归未得，避寇转徙荒山里。\n呜呼一歌兮歌激扬，青春伴我留他乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33505,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其二","author":"黎伯元","text":"短檠短檠吾与汝，天涯到处同甘苦。\n黄尘涨天白日暮，眵昏书眼犹汝顾。\n迩来无烛照逃亡，天阴燐火行失路。\n呜呼二歌兮歌始奋，呼酒为我散孤闷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33506,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其三","author":"黎伯元","text":"有弟有弟兮雁行，三人将老一弟亡。\n谁知生别成永诀，魂招不来我涕滂。\n鹡鸰在原心衋伤，况我飘泊值寇攘。\n呜呼三歌兮歌且止，苍生无数遭兵死。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33507,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其四","author":"黎伯元","text":"有子有子才俱庸，诗书世泽谁亢宗。\n大男耻称弓弩手，小男懒学宜归农。\n扁舟江海合早计，蒿目世路多奸凶。\n呜呼四歌兮歌四举，鹧鸪啼急千山雨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33508,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其五","author":"黎伯元","text":"粤山云霾粤溪暝，黄雾滃滃迷四境。\n号狐舞蟮乘海暝，射工含沙伺人影。\n有生何为随溟峤，抚掌三叹发深省。\n呜呼五歌兮歌怆神，巅崖无人问苦辛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33509,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其六","author":"黎伯元","text":"岛有夷兮在海隅，呰窳偷生托樵渔。\n喜人怒兽易变态，寇攘乘时闯州闾。\n水中鲛鳄陆豺虎，坐此困阨谁驱除。\n呜呼六歌兮歌思沉，林间变色成春阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33510,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"神符山乡避寇效杜少陵同谷七歌 其七","author":"黎伯元","text":"男儿生能立功死，不朽济时谁是经纶手。\n将军何日诛贼奴，肘系金章大如斗。\n儒生致身苦不早，勋业蹭蹬空白首。\n呜呼七歌兮歌七阕，天若有情亦呜咽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33511,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答高茂绩 其一","author":"黎伯元","text":"驿路通村坞，行行渡野桥。\n夜寒鹃自诉，春老雉犹娇。\n氛祲终消弭，川原爱泬寥。\n防身长剑在，坐待磔群枭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33512,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答高茂绩 其二","author":"黎伯元","text":"乌衣谢家巷，杜宇洛阳桥。\n花泪英雄恨，柳眉儿女娇。\n交游成契合，句律慰荒寥。\n早献安边策，群凶计日枭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33513,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"花朝 其一","author":"黎伯元","text":"今日是花朝，愁随春半销。\n山容留雨润，柳色借烟娇。\n世乱怀芝草，年丰验麦苗。\n海天光霁少，云密谷风飘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33514,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"花朝 其二","author":"黎伯元","text":"紫禁青春入，曾看辇路花。\n扰扰逢世运，老大惜年华。\n供馔晨挑菜，分泉午试茶。\n太平应有日，归理旧生涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33515,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"莲塘村舍","author":"黎伯元","text":"茅茨半月雨，客舍四年春。\n浪迹乖生业，躬耕愧野人。\n云寒仍黯黪，山翠失嶙峋。\n桃李晴方赏，家园梦到频。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33516,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正丙申端月避寇竹州冈梁家 其一","author":"黎伯元","text":"始识通村坞，因寻遁世人。\n园庐幽背郭，翁媪喜迎宾。\n耕凿家随足，过从俗尚淳。\n囊衣来避寇，终夕话酸辛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33517,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正丙申端月避寇竹州冈梁家 其二","author":"黎伯元","text":"蚤作逢人日，客途难自舒。\n四方戎马地，一宿野人居。\n翠小梅初缀，金匀柳尚疏。\n阴暝望开霁，世运定何如。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33518,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月自端泮还乡","author":"黎伯元","text":"满眼莺花欲发吟，四方戎马正关心。\n农归渤海家如寄，人恨桃源路不深。\n夜月啼鹃空惨怆，朝阳鸣凤遂消沉。\n三年枉作莼鲈梦，采蕨惟应入翠岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33519,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读史有感","author":"黎伯元","text":"姓名竹帛数行纪，官爵枭卢一掷成。\n忙里犊车终取侮，贫中马磨足为生。\n鹃啼地气真能验，凤去河流未肯清。\n谁信文章传死后，百壶春酒且须倾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33520,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"感兴","author":"黎伯元","text":"雁泽秋风入浅斟，商歌激烈夕阳沉。\n青山犹是古人面，白水不同今日心。\n食肉有谋当报国，封侯无相盍投簪。\n草庐未必名湮没，何用栖栖梁父吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33521,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用郑梅园官军平寇韵","author":"黎伯元","text":"骢马挥戈见亦稀，军门饮士斗为卮。\n爬疏蜂蚁师行日，整顿乾坤否极时。\n世事百年棋局换，兵机千变阵图奇。\n岛夷不似平淮蔡，血涴髑髅谁手提。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33522,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"增城访亲友道间作","author":"黎伯元","text":"长途冲暑马频催，尽胜撑舟雪夜回。\n村径曲通鹦鹉望，县山遥指凤凰台。\n花残官路红飞片，树拥邮亭翠作堆。\n云母石边行缓辔，细看琼屑点苍苔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33523,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"石井庵访伍智卿","author":"黎伯元","text":"金紫山前访隐君，抗尘踪迹畏移文。\n松杉响振半天浪，猿鹤幽栖一坞云。\n岚翠拥庐苍壁立，源泉出涧细流分。\n劫灰不到盘中土，准拟移家避世氛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33524,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邓氏园亭","author":"黎伯元","text":"处士庐幽信步寻，修篁乔木接繁阴。\n一弓村径藏閒地，九夏秋声入茂林。\n树外近山随坞合，花开细水到池深。\n人生早作丘园计，回首辋川成古今。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33525,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄区鲁卿聘士","author":"黎伯元","text":"雁书夕至慰孤吟，蝶梦宵驰折寸心。\n老蜃嘘楼波浪阔，白驹入谷树云深。\n百蛮风气嗟时变，一代英雄肯陆沉。\n见说盘中多隐所，卜居准拟傍幽岑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33526,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄崔德卿郡正","author":"黎伯元","text":"别来老圃几寒花，雁断风尘瘴海涯。\n鲁泮旧游同采藻，鹿门新隐各携家。\n乾坤谁有千间厦，河汉今无八月槎。\n犹忆仙城寻旧约，歌楼翠袖劝流霞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33527,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"答叶以礼","author":"黎伯元","text":"洛诵遥闻塾在闾，卜邻仁厚是安居。\n汉灰未息犹飞劫，秦火何尝尽燬书。\n夜月七弦弹别鹤，春江尺素托双鱼。\n斯文否极终当泰，适鲁载歌风满雩。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33528,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"惠州西湖次董养吾韵","author":"黎伯元","text":"荷花十里桂三秋，今日余杭负胜游。\n千古边疆开骆粤，一湖风景占罗浮。\n峰翔白鹤留坡老，水似愚溪待柳侯。\n东向幽亭寻野史，流芳南土几监州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33529,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"读陆放翁诗","author":"黎伯元","text":"閒来朗诵剑南集，句律快心成感伤。\n才士无穷千载往，此翁自许一生狂。\n北征向后谁知杜，南渡以前无愧唐。\n三百篇中关治忽，须将世教验词章。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33530,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吟稿为寇所攘感而赋","author":"黎伯元","text":"旧闻野妇泣遗簪，行稿遭攘感更深。\n背锦奚奴犹抱恨，还毡寇盗不逢今。\n鸡林有识宁希价，饭颗相逢笑苦心。\n侧近云山休厌我，盖棺未定尚狂吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33531,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用郑梅园大尹自述韵","author":"黎伯元","text":"官閒世运忆重熙，几夕华胥入梦稀。\n归里尽高彭泽节，题诗不比永嘉时。\n还寻旧约同年乐，谁画流亡民色饥。\n千载橐金羞不掩，饮泉风概自家知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33532,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别后寄陈默甫","author":"黎伯元","text":"烟月圆沙几度留，风蓬飘转可能休。\n劳生无地求如愿，何处有乡居莫愁。\n东阁遗经终世用，安邦长策亦人谋。\n吟边颇忆同心友，自拂朱弦散隐忧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33533,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]