etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8491,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"漫成","author":"宋褧","text":"日射金堤御水明，杨花榆荚出宫城。\n上林如锦春如画，却怪黄莺不解鸣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8492,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存初宣慰湖南十首 其一","author":"宋褧","text":"太平天子辟经筵，侧席金华引旧贤。\n顿首玉皇香案底，旌麾毕竟使飘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8493,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存初宣慰湖南十首 其二","author":"宋褧","text":"绿暗红稀出凤城，潞河津上酒双瓶。\n湘花湘鸟凭谁报，早晚楼船过洞庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8494,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存初宣慰湖南十首 其三","author":"宋褧","text":"甘棠旧树几年馀，枝叶葱茏拂月衢。\n长沙耆旧如相候，先向轺车看凤雏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8495,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存初宣慰湖南十首 其四","author":"宋褧","text":"碧湘如镜岳如屏，赋客骚人聚德星。\n况是苏仙吟咏处，高名从此竞芳馨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":8496,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送存初宣慰湖南十首 其五","author":"宋褧","text":"金貂门第黑头公，五省三台指顾中。\n便拟梅花庄上隐，不应解组太匆匆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"