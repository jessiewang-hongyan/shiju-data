[{"title":"酬友人见访不遇","author":"何中","text":"荷笠深山采药回，荆扉石径损秋苔。\n花边稚子相迎说，昨日有人骑马来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荷花","author":"何中","text":"曲沼芙蓉映竹嘉，绿红相倚拥云霞。\n生来不得东风力，终作薰风第一花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夜自封溪归高渊","author":"何中","text":"鸳鸯翻雨戏回溪，溪路迢遥湿翠围。\n隔竹杏花红万点，何因知我此时归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"豫撞登舟作","author":"何中","text":"城南无树识神仙，閒往閒来四十年。\n西岸青山东岸塔，为谁相对老秋烟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"象牙潭","author":"何中","text":"水禽两两树三三，近浦遥峰隔嫩岚。\n新换一天秋色别，短篷又过象牙潭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丰城道中","author":"何中","text":"江村南北笑声频，红烛花时次第新。\n春水渐生桃叶渡，小舟时载嫁归人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"风雨","author":"何中","text":"池上风雨来，柴扉人迹绝。\n隔水烟气生，林峰半明灭。\n蛤吠秋草深，鱼惊晚荷折。\n孤坐倚匡床，微红隐天末。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵宁志道表氏偕庵夜兴","author":"何中","text":"空庭山色重，积此松桂阴。\n微风从何来，一鸟惊前林。\n清心有密契，幽听得远音。\n寒灯照孤馆，岁晏夜偏深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"柳下","author":"何中","text":"是谁安宅子，占得绿杨阴。\n山色春来长，溪流雨后深。\n树遥飞鸟疾，人近戏鱼沉。\n舟子船头望，安知不解吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"除夜","author":"何中","text":"风萦萦，雨霏霏。\n寒轻新柳润，春到落梅稀。\n筠篮入市买红烛，烟火松林人醉归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"访牟大卿","author":"任士林","text":"自开黄叶径，城郭有山林。\n老失相如璧，贫嗟靖节琴。\n青天庭树在，白发镜尘深。\n欲叩黄唐事，寥寥千载心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄陈宣慰帖","author":"任士林","text":"客从昆崙来，遗我一寸胶。\n投之东海中，浊浪生清涛。\n世人饮泾水，沦浃如村醪。\n醉久与俱化，复恶醒者劳。\n客笑余亦休，泾水方滔滔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"屏居","author":"任士林","text":"壮志轮囷强未销，屏居万事饱尘劳。\n贫知渭竹真堪传，老恨江梅不入骚。\n山谷樵歌閒日月，江湖鱼计足风涛。\n妻孥灯后应相笑，头上如今有二毛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"海扇","author":"任士林","text":"汉宫佳人班婕妤，香云一箧秋风初。\n网虫苍苍恩自浅，犹抱明月冯夷居。\n至今生怕秋风面，三月三日才一见。\n对天摇动不如烹，肯入五云清暑殿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵吾子行新年三首 其一","author":"任士林","text":"有道贫方乐，无营坐亦深。\n新诗知病后，老鬓觉年侵。\n信有乾坤力，时劳江海心。\n文园亦消渴，浑愧白头吟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵吾子行新年三首 其二","author":"任士林","text":"已分身将隐，还惊老易过。\n时来慰岑寂，相与惜蹉跎。\n白发短犹栉，青铜暗欲磨。\n人生有如此，我醉子当歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵吾子行新年三首 其三","author":"任士林","text":"雪后春风起，天空江水来。\n新年浑作客，多病孰怜才。\n有道身先老，无人首屡回。\n承祯须不爽，闻已扫丹台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"公子舞歌","author":"任士林","text":"明河在天不可舠，我欲汲之成酒醪。\n维北有斗不可量，我欲把之为酒觞。\n人生豪诞有如此，况有开筵柳公子。\n公子平生白苧袍，酒酣起舞天为高。\n大鹏长风九万里，老蛟鳞甲秋江水。\n坐中忽唱河西曲，琵琶声高裂寒玉。\n态浓海树出鹧鸪，意足霜枝下鹦鹆。\n为君一洗儿女目，众宾自爱白宰酒，情欢不用夫起寿。\n长空更唤明月来，人影檀栾风满袖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"凤求凰","author":"任士林","text":"凤将将，求其凰。\n凰既遂，辞母旁。\n逐凰孔良，不与母同翔。\n凤心长，海树凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用子行韵简周景远应奉","author":"任士林","text":"供奉平生酒，中郎绝代书。\n自便青琐直，未放碧山居。\n辈行人谁在？\n行藏意自如。\n丝纶须世掌，曾识典坟初。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送许君实同知之任乡邦因简于有卿知州","author":"任士林","text":"一出已十载，江流只目前。\n家乡荒政日，客路独醒年。\n南郡碑钱远，东山屐藓圆。\n归心随使鹢，漠漠海云边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"客游华亭访卫山斋","author":"任士林","text":"东浙青山少，西湖白发新。\n渐多江海伴，更卜水云邻。\n杨柳初笼雨，蒹葭欲剩春。\n不愁成汗漫，天地有閒身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘将军射虎行","author":"任士林","text":"半湿新蹄山径晓，于菟夜渡海中岛。\n百夫鼓噪屋瓦震，将军弯弓白日皎。\n地形平露草不长，狂啸无风威欲倒。\n玄翎一中洞心胸，坐据木床脱须爪。\n胃中白骨谁家魂？\n红肉已供人醉饱。\n人生意气不下堂，车铎当当冯妇老。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓发衡山访子昂学士","author":"任士林","text":"山林真学士，天地一诗翁。\n乘兴不可返，孤舟雪后风。\n浩荡襟期别，艰难道术穷。\n何当真卜宅，共老水精宫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"屡访开元陈高士不值","author":"任士林","text":"我亦乾坤一腐儒，杖藜时访白云居。\n故人不入江海梦，道士空惊世俗书。\n箫史凤归云缥缈，刘郎桃在雨扶疏。\n当年亲见东风事，杨柳丝丝二月馀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李唐春牧图","author":"任士林","text":"春气熏人未耕作，江草青青牛齿白。\n牛饥草细随意嚼，老翁曲膝睡亦著。\n蓬头不记笠抛却，午树当风梦摇落。\n梦里牛绳犹在握，昨夜囤头牛食薄。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用韵酬陈渭叟林伯清","author":"任士林","text":"我本厌尘市，志在栖幽清。\n还听客城雨，深夜愁寒更。\n山中两道士，孤铛煮雷鸣。\n漱沐得清谣，久却世上名。\n何用王子乔，相从学长生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和唐玉潜用友人韵见寄","author":"任士林","text":"独怜鬓雪上蓬婆，未得逢君镜水波。\n世上冬青高谊少，山中日录好诗多。\n白云明月怀安石，细雨斜风老志和。\n人事参商那有此，时劳相望意如何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四雁图 其一","author":"任士林","text":"江北江南秋正骄，孤飞万里气方豪。\n平生惯有冰霜翼，却笑东风燕雀高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四雁图 其二","author":"任士林","text":"满腹秋风郁未开，一声清唳九天回。\n人间儿女有痴梦，明月楼头独往来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四雁图 其三","author":"任士林","text":"孤咮双翎睡古香，芦花水浅海云黄。\n城头未落三更月，梦入青天万里长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四雁图 其四","author":"任士林","text":"两翼清秋倦未翔，北风喉咶水云乡。\n菰蒲万顷食不尽，肯与群凫逐稻粱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游升元归寄陈道士","author":"任士林","text":"独往有所适，重来兴未穷。\n苍云山色外，晴日树声中。\n世亦思遐举，吾方抱屡空。\n平生司马约，回首起玄风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕客中","author":"任士林","text":"容易乡心秋自生，纡馀老态日纵横。\n无官谩赋五升籴，有妇难呼一石酲。\n露气满山高木落，秋声入屋短檠明。\n薄田可买归无计，星汉年年浪影清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"喜陈茂阳客归","author":"任士林","text":"对坐头俱白，愁来强欲歌。\n出门知己少，遇事折肱多。\n海气低青嶂，年光暗绿莎。\n不堪妻子笑，舌在欲如何？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上虞客中","author":"任士林","text":"黄叶空阶晓，清斋白发人。\n于于风力紧，滴滴雨声频。\n妻子千山远，诗书一饭身。\n人间有知己，重老未相亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄襄贵丁明府","author":"任士林","text":"小桂堂前手自栽，未沉沙塌已生苔。\n青山自笑不归去，白马相看时独来。\n凉月清宵谁与共？\n好花晴日不须开。\n明年应度卢沟水，早寄春风郭隗台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过华亭留别吴山诸友","author":"任士林","text":"出处何时定，归栖老尚迟。\n江山无倦客，天地有真知。\n竺岭呼猿日，华亭听鹤时。\n平生爱杯酒，到处付襟期。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"八月十五夜对月","author":"任士林","text":"客路惜年年，中秋月自圆。\n正怜儿女侧，不共弟兄前。\n老去一丘壑，人生二顷田。\n兹游谅何事，清影未能眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠相者王月屋","author":"任士林","text":"布囊诗卷胜黄金，白纻乌纱碧眼深。\n自是清时少遗逸，不须物色到山林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和杜元用见过韵","author":"任士林","text":"湖上新楼好，相过不厌君。\n年光吴地老，客梦越江分。\n聚散无虚迹，穷通有昔闻。\n时遮西望眼，冉冉见浮云。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送延庆济上人归西","author":"任士林","text":"人世难为客，心空不待年。\n坐深千衲在，道许一灯传。\n白日论诗地，青山住世缘。\n高歌望吾子，我亦买归船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"十二月初六日晓发松江","author":"任士林","text":"冬雾比春浓，舟行日未东。\n可能辞物役，岂敢怨涂穷。\n清兴乘江水，交情付晓风。\n流年今白首，何日慰飘蓬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日诗寄明碧竹院","author":"任士林","text":"我岂人间客，秋风托尔邻。\n一声清唳晓，万里壮游身。\n出处自有道，栖迟未厌贫。\n黄花谩情思，清对未归人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送石棋盘醉归分韵得边字","author":"任士林","text":"一雁不渡海，衔芦列青天。\n孤疏怯走壑，远赴百道泉。\n结交贵日广，不广空壮年。\n抟沙固易散，投漆固易坚。\n所以日共饮，山花列秋筵。\n道士黄石孙，亦解供酒钱。\n初游濮阳家，再醉康乐前。\n却看仙人棋，危石如平田。\n山风子声寂，洞日瓢影悬。\n归来忽自笑，我岂非谪仙。\n更唤酒杯入，健倒东篱边。\n摸索溪石白，莫嗔我欲眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送徐春野","author":"任士林","text":"昨日之酒月满楼，今日之酒月满舟。\n三十度月月圆缺，期君看月丹山头。\n君携月色钱唐去，我有浊酒谁为酬。\n功名一纸政复尔，岁月两鬓归来休。\n柳桥久负秋夜笛，花鬟老忆春风喉。\n鹏云正高眼历历，鲲海未运天悠悠。\n雄鸡一声骑当发，男儿顶上簪公侯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四禽言 其一","author":"任士林","text":"行不得哥哥，未曙登程日已蹉。\n腹饥足趼可奈何，前山雨暗豺虎多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四禽言 其二","author":"任士林","text":"脱裤脱裤，破碎一针无补处。\n谁持箧中新，换我身上故。\n但得深闺有孟光，年年裤破亦不恶。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题翰墨十八辈封爵图","author":"任士林","text":"公子装车从楚国，十九人行一不足。\n上阶卒赖毛先生，招手相呼公录录。\n迩来翰墨十八人，一日受封列华物。\n世上空成孺子名，论功却笑中书秃。\n人生慎勿为事先，乞留足矣张良独。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"月下歌","author":"任士林","text":"月从东出西壁沈，曾照千古万古之人心。\n人心只有月照破，达人当之成酒淫。\n卿不闻李太白苏子瞻，把酒频问月，无月酒不斟。\n月为抵愁之白玉，酒为买笑之黄金。\n吾徒俯仰明月下，月亦傲兀窥人深。\n径须椎罂倒瓮为月尽一醉，如何青天白眼放月还西岑。\n狂歌他日作佳事，共道此乐今宵今。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其一","author":"揭祐民","text":"泽欲流，强用兵。\n仁者师，无威声。\n持百万，如云行。\n令所出，时扬鹰。\n不血刃，惟功成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其二","author":"揭祐民","text":"来南东，用生道。\n前旌旗，后盾纛。\n称兑戈，存障堡。\n上韬略，匪勇暴。\n泯杀机，遂仁好。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其三","author":"揭祐民","text":"东苍龙，入震泽。\n民胥生，道得国。\n始用牡，振太白。\n徐用止，田有获。\n吴山高，著铭勒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其四","author":"揭祐民","text":"虎丘奠，西师安。\n念越栖，稽山完。\n国既逊，无胥残。\n泰伯祠，在江干。\n过禹穴，碑勿欢。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其五","author":"揭祐民","text":"王临襄，继踰淮。\n以所履，觇云雷。\n利建侯，雄基开。\n入图像，麒麟才。\n视王仪，毋能侪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮安王吴山歌六章 其六","author":"揭祐民","text":"笳鼓竞，铙歌长。\n王有灵，福此方。\n男吹笙，女协簧。\n抚琴瑟，升中堂。\n惠我杭，时无疆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河南王孙南谷平章诗三章 其一","author":"揭祐民","text":"河之水，波浟浟。\n见世泽兮在中流，夹日焜耀兮为国伊周。\n保合元气兮春阳和柔，功有绍兮名长留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河南王孙南谷平章诗三章 其二","author":"揭祐民","text":"杨之土，春煦煦。\n美有济兮世此所，荐生良弼兮为国申甫。\n辅翼治道兮还庞复古，猗其人兮衮是补。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河南王孙南谷平章诗三章 其三","author":"揭祐民","text":"会稽之月，下照禹穴，履海岛兮被吴越。\n勤劳王孙兮秉玉节，为国南镇兮地罔触齧。\n彰旧闻，声烈烈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"永固庙","author":"揭祐民","text":"凿凿龙虎死，集灵壮高居。\n其阳播江涛，其阴蓄澄湖。\n井固不可改，邑亦何尝殊。\n但感岁月迁，流入楣间书。\n重来二十年，旧碧眼欲枯。\n神在不可亵，下山仍踟J。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南山泉","author":"揭祐民","text":"南山有泓泉，濯濯清不浑。\n下有到地株，上有号云猿。\n积石从西来，岁久根遂蟠。\n如何百年后，雕凿加钻刓。\n我恨来最迟，不见真气完。\n万物自有弊，至理难穷言。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"登凤凰台","author":"揭祐民","text":"西风扫建业，六朝倏更代。\n孤凤何年来，高台此留待。\n唐家日方中，忧昃深感慨。\n宗臣裂肝胆，片语到今在。\n痴云起大荒，事业果颠沛。\n遗吟所镌磨，岁月又屡改。\n梁园后悲秋，草草作南内。\n登台渺八顾，潮落石头碎。\n祸乱有本原，臣子出忠爱。\n夜深挹长庚，江月为谁对？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西风碍长养","author":"揭祐民","text":"西风碍长养，冷气移当暑。\n河北饥未赒，燕中久无雨。\n传言山东地，亦有流冗故。\n细民辄疵疠，天意肯回互。\n犹闻客子船，买口向南去。\n饥馑事关天，肯使为利赂。\n南人多暴殄，米粟易珠土。\n此理焉可常，翻覆随朝暮。\n曩岁江浙间，眼见吁可惧。\n长愿四序平，秋香熟禾黍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"泰山发秋潦","author":"揭祐民","text":"泰山发秋潦，东鲁数州没。\n及兹黄河交，南徐更汤割。\n我乘归船来，引缆行木末。\n高原尚为沈，低土焉得遏。\n夜来泊溪岸，寒螀啼冷月。\n鸿雁无宁宅，蛟蜃有深窟。\n秋成一月浸，百草俱烂物。\n客中视此意，忧事贯华发。\n茫茫下双洪，寥落寸心掇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"中原道上次欧阳齐汲韵","author":"揭祐民","text":"中原七郡地，气厚风还淳。\n天分涧瀍水，路入河洛春。\n圣贤所经营，绳准相均平。\n六合昔有隔，一观恨无因。\n怀哉此盛区，理者皆先民。\n曾经龙虎啖，重为狼羊贫。\n大若斡元化，细物涵深仁。\n一士行其间，鞍马犹逡巡。\n解带思古道，题诗清路尘。\n望迷黄河北，欲度正怆神。\n遗黎当道隅，涕说青城滨。\n青城不可说，回首伤天津。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"瘠马图","author":"揭祐民","text":"念汝出塞下，四蹄疾如飞。\n半夜驰临关，气夺戎王围。\n被铁踏河冰，几度向武威。\n将军事百战，腾力不顾肥。\n祇今饮渭流，齿老不任鞿。\n坡寒暮风酸，碛瘠春草微。\n百感画者意，要见骏骨稀。\n但看古英贤，工苦常寒饥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":27185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]