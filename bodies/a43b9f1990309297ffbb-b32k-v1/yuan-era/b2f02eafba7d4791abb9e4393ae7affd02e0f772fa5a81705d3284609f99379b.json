[{"title":"题赵子昂竹石","author":"陈孔彦","text":"徒羡芙蕖与牡丹，繁华瞬息易凋残。\n何如竹石常清淡，冬雪春风一样看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32112,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋郭用和所藏古镜","author":"陵希惠","text":"汉皇蛇剑穿屋飞，伯禹神鼎沦泗涯。\n鲸翻鳌转总陵谷，此鉴零落何足疑。\n团团知是谁家物，偶向耕夫春陇得。\n苔昏土蚀篆文微，消尽清光质如有。\n忆昔清光未泯时，玉台鞶带生光辉。\n白发几挥豪杰泪，青娥曾照婵娟啼。\n汾阳诸孙诚好古，床上书连只环堵。\n闻之不惜抱衾裯，岂为深闺照媚妩。\n愿君试觅负局生，炯然秋月高堂明。\n一点莫遣飞埃侵，万古不灭如此心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32113,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"陵希惠","text":"丹崖雪窦相掩映，一枝北走如翔龙。\n白云输雨出深谷，苍松倚壁来清风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32114,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"施坦","text":"香纫幽兰佩，诗裁明月珠。\n乱声秋树叶，寒色晚花枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32115,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"熊不易","text":"太瘦尚能怜杜甫，不言几已失鬷明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32116,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"朱得先","text":"戴星问俗千村曙，耕雨关山百里春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32117,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"师晦文","text":"吠雪从惊犬，耕云欲买牛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32118,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"胡晋","text":"茶灶沾晴露，书林趁午阴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32119,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"何致中","text":"苦吟生白发，归梦绕青山。\n雨久琴丝润，风清扇影閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32120,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"汪士深","text":"雨香林下屐，花影席间尊。\n白发已从公道得，青山长似故人看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32121,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"刘得之","text":"登楼须待月，税地亦栽花。\n风帘桑落酒，春网药楂鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32122,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"梅德明","text":"彩鹢随风飞宛水，黑貂犯雪上金台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32123,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴锳","text":"塞翁休问马，海客自盟鸥。\n泉声晴亦雨，山气夏先秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32124,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"至正二十年八月十五日招同诸彦小集南湖以杜甫不可久留豺虎地南方犹有未招魂为均得不字","author":"缪思恭","text":"我生胡弗辰，守土愧簪黻。\n乱离难斯瘼，兵氛驾飘坲。\n贵人既防求，苗僚荐骄拂。\n比户罹毒淫，流殃痛未讫。\n大军有凶年，荆榛莽茀郁。\n天地塞无欢，三秋翳沈沕。\n当国哀黎氓，方来滥朱绂。\n所冀民社宁，优诏非为屈。\n顿觉元气清，太空如荡韨。\n借问今夕娱，还思去年不？","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32125,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其一","author":"唐朝","text":"与物无心心颇宽，无才赢得本无官。\n更无文字劳神思，缄口无言漫自安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32126,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其二","author":"唐朝","text":"此君原是主人翁，夙夜惺惺俨在中。\n只为杜门能谢客，一间虚室自玲珑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32127,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其三","author":"唐朝","text":"山中古木老槎牙，几度逢春不放花。\n清庙栋梁奚足取，霜枝雪干漫矜誇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32128,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其四","author":"唐朝","text":"鲈鳜吞香系钓筒，珍禽解语入金笼。\n为怜鲜鴳能安分，自得丛林浅濑中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32129,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其五","author":"唐朝","text":"云在空中变态奇，风来江上浪漪漪。\n何如风定云开后，秋水长天一色时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32130,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五无吟六首 其六","author":"唐朝","text":"晓林喜鹊暮林鸦，饮啄随时漫自嘉。\n祸福于人何所与，不劳屋角日喳喳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32131,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏马台","author":"林彦华","text":"白蛇夜断飞赤龙，长驱疾足平关中。\n鸿门玉碎亚父死，彭城霸气随飘风。\n沐猴御尊真成戏，调服群驽弃天骥。\n一骓岂解踏九州，事去空歌时不利。\n宋公不复登此丘，吊古有客悲黄楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32132,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"程彦明","text":"地吞南极尽，波撼北溟回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32133,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李子飞","text":"花迎玉殿红千树，柳拂金沙翠万条。\n层岚蔽日云当户，阴瀑含风雪满床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32134,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"丁守中","text":"弹琴夜和鸣皋鹤，持钵朝降度海龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32135,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"吴漳","text":"平野北连钟阜远，大江东抱石城流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32136,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王东","text":"西风旷野孤城出，落日空江白浪回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32137,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王圭","text":"福兼鸿范五，瑞集凤雏三。\n兴寄冥鸿外，诗成立马间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32138,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"王璋","text":"举世非新法，中朝放直臣。\n宽觉腰围减，明嫌鬓影秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32139,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"李廷臣","text":"湛露仙盘白，朝阳虎殿红。\n诏起西河上，旌随斗柄东。\n西北干戈定，东南杼柚空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32140,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"曹文晦","text":"刳肠难脱豫且网，留骨堪为子夏冠。\n鼠须过晋今无用，兔颖封秦亦不如。\n当时照炫水中影，今日扫空堂上尘。\n小槽酒滴清光透，老瓦盆空饮兴多。\n顾家曾识将军号，华岳堪供处士眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32141,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其二 讲经台","author":"钱岳","text":"潮打弯埼半欲摧，老禅称土筑高台。\n旃檀林下谈经坐，舍卫城中乞食回。\n江月夜摇金篆冷，天风时散宝花来。\n惟馀石塔残阳里，长使登临过客哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32142,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其三 沪渎垒","author":"钱岳","text":"袁公筑垒吴淞口，废址犹存沪渎名。\n先驻孤军防险地，已胜痴将假阴兵。\n涛舂海岸喧鼙鼓，云合江天拥旆旌。\n豪杰不将成败论，千年青史见忠贞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32143,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其一 陈桧","author":"余寅","text":"海波浮玉殿，宝网拂珊瑚。\n座上来听法，龙精即老夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32144,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其二 虾子禅","author":"余寅","text":"老禅不解事，眉白鬓茎稀。\n曹溪一滴水，虾子作龙飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32145,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其三 沪渎垒","author":"余寅","text":"我过袁崧宅，重寻沪渎津。\n英雄千载下，遗垒大江滨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32146,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录四 其一 赤乌碑","author":"陆侗","text":"金人入梦兴梵宗，重玄始创沪渎东。\n紫髯纪年石且丰，大书赤乌欲黄龙。\n维松潮汐地不同，文章忽瘗洪涛风。\n龟蚨螭首潜无踪，川后河伯还会通。\n奎星下烛娑竭宫，方信人间谈色空。\n江水自白江花红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32147,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录四 其二 陈桧","author":"陆侗","text":"铁干屈左纽，苔枝锁空青。\n雨露承十朝，根心自祯明。\n愿仗千佛荫，羞向三阁荣。\n水月照缨络，俨矣大士形。\n秋风动石头，不杂玉树声。\n泰媪永诃护，恐化苍龙精。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32148,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录四 其三 涌泉","author":"陆侗","text":"元气斡坤轴，不舍昼夜旋。\n四五穷其上，趵突万劫泉。\n宁随月盈缩，滚滚常自然。\n沸如沃焦起，汨若尾闾连。\n神虎耻来跑，骊龙惧为渊。\n自天一数生，在理合后先。\n荒哉博望侯，空去求河源。\n美彼西方人，卓锡良有缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32149,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录四 其四 芦子渡","author":"陆侗","text":"芦村胥村南北路，舟往舟还古今渡。\n一笠天垂紫凤飞，百枝水落青龙步。\n鲤鱼风起夜未收，雪色苇花零乱秋。\n借得君山第三管，月中吹过沧浪洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其一 赤乌碑","author":"赵觐","text":"僧来天竺国，寺创赤乌年。\n碑碣前朝重，文章后世怜。\n秋风生大野，斜月堕重渊。\n有待龟龙负，图书得共传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其二 陈桧","author":"赵觐","text":"不识陈朝桧，相传故老言。\n理文俱左纽，后土自蟠根。\n气迥青山暝，阴寒玉殿昏。\n何须野王笔，图画至今存。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录三 其三 芦子渡","author":"赵觐","text":"芦花十里塘，野色正荒凉。\n明月秋无际，西风雪有香。\n渔郎茆屋小，估客棹歌长。\n自愧无家别，经行百感伤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录二 其一 沪渎垒","author":"韩壁","text":"山暝蒺藜黑，天寒燐火青。\n将军身没后，衮海毒蛟腥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录二 其二 涌泉","author":"韩壁","text":"光摇星彩乱，声散雹珠圆。\n不为将军拜，玄机极后先。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其一 赤乌碑","author":"唐奎","text":"河水初润瓠子决，东吴沪渎复漫泄。\n重玄不见赤乌碑，怅惘波臣心欲折。\n玄龟抃舞苍龙飞，江头落日枫林稀。\n谁云杜公两石在，安知陵谷千年非。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其二 陈桧","author":"唐奎","text":"祯明老桧高百尺，十亩苍寒浸苔石。\n虬枝偃如东向松，霜皮惨若西来柏。\n金陵王气当时誇，落日江村啼乱鸦。\n璧月满天清夜静，玉箫吹落后庭花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其三 虾子禅","author":"唐奎","text":"谁云俨师示化所，馀香未绝天花雨。\n痴禅狡狯悉共知，嚼碎红须化龙舞。\n痴禅化去虾亦存，至今法门无尽灯。\n风雨几度惊山灵，庭前柏树犹青青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其四 讲经台","author":"唐奎","text":"师遗台石苍苔厚，兔葵燕麦生禅肘。\n当时公享七十年，石丈人中谁肯首？\n我来作志写长文，可叹昔人谀墓金。\n自喜文章如谢脁，涅槃重问远公林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其五 沪渎垒","author":"唐奎","text":"吴淞江上袁公垒，千年何处寻遗址。\n石犀半落江水中，秋老芦花三十里。\n五百马尘今尚飞，啾啾赤子将安归？\n月明古堞急鼓鼙，孤臣有泪空沾衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"静安八咏录五 其六 芦子渡","author":"唐奎","text":"耶城东来芦子渡，万顷芦花失江路。\n明月清秋作雪飞，村中不见将军墓。\n只今海内风尘昏，移家来就渔樵伦。\n处处桑麻有闲地，纷纷桃李傍公门。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"句","author":"涂守约","text":"西门穷阴连莽苍，东南巨浸接微茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"同同","text":"西子湖头花满烟，谩郎日日醉湖边。\n青楼十丈钩帘坐，箫鼓声中看画船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"唐棣","text":"门前杨柳乱吹花，第一桥头第一家。\n马上郎君休挟弹，柳枝深处有慈鸦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"韩好礼","text":"翠柳黄莺金缕衣，海棠红觜两相思。\n宾郎本是薄情鸟，独要阿侬呼画眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"黄季伦","text":"钱塘江头莎草齐，钱塘女儿歌别离。\n愿郎相见如月子，月子团团无暗时。\n湖上女儿犹褐衣，出门日日望郎归。\n春水绕湖春草绿，草上双双蝴蝶飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"李廷臣","text":"杨花飞尽荷花开，南人北人湖上来。\n荡舟自唱黄陵曲，载得山头月子回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"堵简","text":"港上蘋蒲翠叶齐，凫鸥鸿雁总来栖。\n劝郎得意且行乐，白苧樽前日易西。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其一","author":"杨椿","text":"侬家生长在西湖，暮管朝弦随处呼。\n早听当初阿姨语，免教今日悔狂夫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"边鲁","text":"戴胜降时桑叶青，梨花开处近清明。\n狂夫归来未有信，蝴蝶作团飞上城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"杨庆源","text":"小姑女儿住里湖，年来十八十三馀。\n自从湖口送郎去，马上金钱不受呼。\n湖中采菱菱刺长，芡头新剥掌中藏。\n掌中芡子眼中泪，化作鲛珠来遗郎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"完泽","text":"花满苏堤酒满壶，画船日日醉西湖。\n阿侬最苦两离别，不唱黄莺唱鹧鸪。\n堤边三月柳阴阴，湖上春风似海深。\n游人来往多如蚁，半是南音半北音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"谢寅","text":"郎书前月发京华，燕子来时当到家。\n记得去年裁白苧，郎君系马石榴花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"徐梦吉","text":"雷峰港口晚凉天，相唤相呼去采莲。\n莫为采莲忘却藕，月明风定好回船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"刘肃","text":"日出放船水中流，日落风波浪打头。\n劝郎移向侬家去，杨柳青青堪系舟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"李庸","text":"六桥桥下水流东，桥外荷花弄晚风。\n郎心似水不肯定，妾颜如花空自红。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词三首 其一","author":"康瑞","text":"大船搥鼓银酒缸，小船吹笛红绣窗。\n鸳鸯触棹忽惊散，荷花深处又成双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词三首 其二","author":"康瑞","text":"燕子来春雁来秋，曾见钱王衣锦游。\n英雄漫说八百里，只管东西十四州。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词三首 其三","author":"康瑞","text":"狮子峰头插将旗，凤凰山下草离离。\n三宫去后宫门闭，恰似钱王献土时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"陆继善","text":"手种宜男寄去时，花开灼灼叶离离。\n芳心不似蘼芜草，一任春风烂熳吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其一","author":"朱彬","text":"南北峰高作镜台，十里湖光如镜开。\n行人有心都照见，劝郎肝胆莫相猜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词二首 其二","author":"朱彬","text":"湖水东来日欲西，兰苕参差那得齐？\n苏公堤边人荡桨，吴山树头鸦欲栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"欧阳公瑾","text":"第一桥边第一家，瓜皮船子送琵琶。\n妾身自是良家女，不是当年苏小家。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"郑贺","text":"北高峰头侬望夫，望见西子下姑苏。\n脂塘水腥吴作沼，莫将西子比西湖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"高克礼","text":"第四桥头第一湾，看鱼直上玉泉山。\n大鱼已逐龙飞去，留得当年旧赐环。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和西湖竹枝词","author":"陈聚","text":"茜红裙子柳黄衣，花间采莲人不知。\n唱歌荡桨过湖去，荷叶荷花风乱吹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":32186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]