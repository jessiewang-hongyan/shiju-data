[{"title":"静寄轩为吴僧一元赋","author":"张翥","text":"群动寂寥外，一轩潇洒中。\n山林亦长物，身世本虚空。\n清磬花龛日，孤灯竹榻风。\n不曾离寓所，惟有主人公。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16385,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"抱素子作自适图求题","author":"张翥","text":"隐者抱幽素，独行穿杳冥。\n有诗吟木客，无驾勒山灵。\n寒涧流沙白，秋云入竹青。\n携琴向何处，弹与野猿听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16386,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"北山诵藏经三旬毕诗以调之","author":"张翥","text":"金布庄严地，花飞梵呗时。\n舌端谈孔雀，顶上集刍尼。\n国寿祈天永，皇心体物慈。\n明当喜圆满，一月废吟诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16387,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"用北山韵答之","author":"张翥","text":"吾衰年冉冉，师乐日閒閒。\n师以诗娱意，吾将酒驻颜。\n看云知幻灭，见月喜明还。\n莫问谁家曲，相酬笑语间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16388,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送观性空上人归省","author":"张翥","text":"白发高堂在，青山旧业贫。\n载经随客舫，留偈别禅邻。\n行路半春雨，近乡多故人。\n一龛还可老，莫污衲衣尘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16389,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送以中及公自扬天宁寺游匡庐","author":"张翥","text":"趺坐对禅镫，江风浪几层。\n还从鹤城路，去访虎溪僧。\n湖晓星浮石，岩春瀑断冰。\n吴中却回日，应老旧池菱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16390,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清轩","author":"张翥","text":"轩居最潇洒，不受一尘侵。\n门断怀金者，人知饮水心。\n鹤声生晚思，竹色净秋阴。\n此意琴尊外，翛然只自深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16391,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"话旧送胡士恭之京师","author":"张翥","text":"话旧共蝉联，河桥且系船。\n春归花满地，江阔雨连天。\n处士题鹦鹉，诗人拜杜鹃。\n此生虽老去，未敢愧前贤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16392,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"自顾","author":"张翥","text":"自顾摧颓客，仍居寂寞滨。\n月佣奴谇少，岁计妇忧贫。\n酒后诗成梦，灯前壁写神。\n渔樵吾所喜，相见即情亲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16393,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀天目山处士张一无二首 其一","author":"张翥","text":"一饭了年华，蒲团静结跏。\n雪蹊抛即栗，风壁裂袈裟。\n寒狖窥烧叶，饥禽听施茶。\n清除亿劫想，吾欲问僧伽。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16394,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"怀天目山处士张一无二首 其二","author":"张翥","text":"僧舍蜂腰缀，君居第几间。\n池冰寒挂瀑，云雪白藏山。\n未得抛尘网，相从出死关。\n东冈幻住塔，礼罢几时还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16395,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送福上人无际南归","author":"张翥","text":"岁闰春来早，师行且过寒。\n问程山寺远，乞食野人难。\n空性元无际，禅锋岂有端。\n遇予方外友，一为问平安。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16396,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"清河水涨答复中吉监县水字韵","author":"张翥","text":"漭漾清河涨，湍流滋浸淫。\n沧溟浑灌注，浊浪浩浮沉。\n洲渚津涯阔，泥沙沮洳深。\n沿淮泽鸿满，漂荡渡江浔。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16397,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郑喧宣伯赴赤那思山大斡耳朵儒学教授四首 其一","author":"张翥","text":"圣祖兴王地，风云护大营。\n天垂紫塞阔，星戴赤山明。\n人俗殊淳古，皇文易化成。\n君行当劝学，无愧鲁诸生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16398,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郑喧宣伯赴赤那思山大斡耳朵儒学教授四首 其二","author":"张翥","text":"绝漠同文轨，提封振古稀。\n犬牙开武帐，元老秉天威。\n白马紫驼酒，青貂银鼠衣。\n那思山下水，曾睹六龙飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16399,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郑喧宣伯赴赤那思山大斡耳朵儒学教授四首 其三","author":"张翥","text":"野散千军帐，云横万里川。\n寒多雨是雪，日近海为天。\n黑黍供甘酿，黄羊饱割鲜。\n广文但少客，宁虑坐无毡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16400,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郑喧宣伯赴赤那思山大斡耳朵儒学教授四首 其四","author":"张翥","text":"晨发戒行装，风沙碛路长。\n油鞯白鼻马，蓝绶赤铜章。\n文学重新命，□□□□□。\n□□□□□，□□□□□。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16401,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫中舞队歌词 其一","author":"张翥","text":"十六天魔女，分行锦绣围。\n千花织步幛，百宝贴仙衣。\n回雪纷难定，行云不肯归。\n舞心挑转急，一一欲空飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16402,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫中舞队歌词 其二","author":"张翥","text":"凿海行龙舸，凭山起鹄台。\n天池神马出，月殿舞鸾来。\n六合妖氛静，群生寿域开。\n吾皇乐民乐，愿上万年杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16403,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宫中舞队歌词 其三","author":"张翥","text":"白玉雕钗燕，黄金凿步莲。\n箫吹凤台女，花献蕊宫仙。\n香雾团银烛，歌云扑锦筵。\n请将供奉曲，同贺太平年。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16404,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潞庄","author":"张翥","text":"松棚叟卖浆，棚下午风凉。\n独涧绕群木，数家成一坊。\n蜂行花已密，蚕罢叶仍桑。\n此地无千步，真堪作蜕藏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16405,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闻蝉","author":"张翥","text":"中庭白榆树，时有一蝉声。\n沸茧方抽绪，鸣弦忽断筝。\n苍烟起平楚，落日下高城。\n曾是天涯客，因之百感生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16406,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雁声","author":"张翥","text":"嘹嘹数雁度，流响一凄然。\n半落淮南雨，遥沉海上天。\n疏砧欲断处，哀角未吹前。\n我亦离群者，闻之夜不眠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16407,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马通薪","author":"张翥","text":"可代薪如桂，还宜火作煤。\n翁摊扶杖立，童拾戴筐回。\n野屋寒堆整，山炉夜拨灰。\n厩