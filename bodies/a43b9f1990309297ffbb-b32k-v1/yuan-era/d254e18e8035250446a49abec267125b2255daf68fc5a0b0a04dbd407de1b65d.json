689","path":"元.csv","pointer":16431,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"病起","author":"张翥","text":"强起梳头坐，窗明晚景新。\n生遭兵是劫，病与鬼为邻。\n农事田畴废，边声鼓角频。\n故山多药物，徒切未归身。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16432,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚苦寒偶成四章录似北山 其一","author":"张翥","text":"风暴寒逾急，星回岁欲周。\n缺牙便食粥，瘦骨怯重裘。\n节物殊牢落，前图益谬悠。\n蜕窝真类蛰，长日火炉头。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16433,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚苦寒偶成四章录似北山 其二","author":"张翥","text":"清眠梦屡觉，霜气转凄凄。\n春近雁北向，月明乌夜啼。\n炉香留墨篆，烛泪聚银泥。\n少释幽忧疾，寻君一杖藜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16434,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚苦寒偶成四章录似北山 其三","author":"张翥","text":"鼠劣翻书册，猫驯伴坐毡。\n吟怀欣雪夜，疾目畏风天。\n惟酒能消日，无方可引年。\n我诗犹偈子，一问北山禅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16435,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁晚苦寒偶成四章录似北山 其四","author":"张翥","text":"短景催残岁，穷阴连大荒。\n狙三随所赋，龟六可深藏。\n未了惟文债，堪归祗醉乡。\n絁衾有馀暖，翻喜夜天长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16436,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"四月十三日","author":"张翥","text":"白丁驱上城，徒手不能兵。\n斗将无人色，行涂多哭声。\n惟将孔达解，竟遣夙沙烹。\n满眼黄尘暮，悲风惨淡生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16437,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"城东废寺","author":"张翥","text":"一径入荒寂，松风长夏寒。\n夜叉栖败屋，魔女去空坛。\n古佛金全剥，遗碑字半刓。\n时逢好事者，来剔藓文看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16438,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游刘真君庙","author":"张翥","text":"古庙西原上，虚廊半欲摧。\n水龙鳞剥雨，画鬼面生苔。\n叟乞烧钱火，巫抄构殿材。\n英雄有神护，遁迹此中来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16439,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"渐老","author":"张翥","text":"渐老惟贪睡，相留大有情。\n诗从年长淡，寒入夜深清。\n不鼓床琴㾌，慵书帖字生。\n灯花独可喜，连夕向人明。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16440,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜宿青芝坟园","author":"张翥","text":"水落宽船步，年丰密酒壶。\n土酥分地产，木蜜荐秋腴。\n认路尘踪断，拖筇野影孤。\n行人不可暮，落日有于菟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16441,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"上都从驾幸东凉亭","author":"张翥","text":"鹤禁烟华紫，龙冈草色青。\n羽林移晓仗，法驾幸凉亭。\n大业开天道，甘泉发地灵。\n微臣叨侍从，愿睹万邦宁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16442,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"西内应制即事","author":"张翥","text":"烽火连齐鲁，干戈接陇秦。\n四郊多壁垒，万里半烟尘。\n将帅屯兵久，君王遣使频。\n老臣叨视草，进罢益沾巾。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16443,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"行次独石驿大雨驲行廿里喜晴","author":"张翥","text":"段段青天出，浮云四散归。\n燕忙搀马过，蝇乱扑人飞。\n远道倦行李，故山思采薇。\n北风朝已冷，未敢御絺衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16444,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"暴疾卧草堂","author":"张翥","text":"伏枕朝佣起，惟将药裹亲。\n纷纭眼前事，憔悴病中身。\n宿露浓于雨，秋花好似春。\n最嫌姜桂绝，无处乞诸邻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16445,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"有旨翥领宋史刊于江浙次东阿站","author":"张翥","text":"南来十五驿，幽绝独斯亭。\n下榻月初上，捲帘山更青。\n干时嗟暮齿，从事厌劳形。\n寂寞江云外，谁知有使星。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16446,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"九日抵武安县徘徊店","author":"张翥","text":"水落衡漳急，川回上党高。\n流年秋忽忽，行路日滔滔。\n山市人多瘿，沙沟地不毛。\n村墟欣有菊，小驻为持醪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16447,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代祀湄洲天妃庙次直沽","author":"张翥","text":"晓日三叉口，连樯集万艘。\n普天均雨露，大海静波涛。\n入庙灵风肃，焚香瑞气高。\n使臣三奠毕，喜色满宫袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16448,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次石门驿","author":"张翥","text":"投老复行役，江湖秋兴悲。\n舣舟黄落处，欹枕黑甜时。\n燕闰归何晚，鸥晴浴故迟。\n不妨无事饮，聊遣有情痴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16449,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"剡中清风岭王节妇沈江处有血书石上","author":"张翥","text":"尽日经行远，云山又嵊山。\n江光寒照外，雨气乱峰间。\n野艇罾鱼卖，村巫诅虎还。\n千秋贞妇庙，留在□□□。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16450,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"关岭","author":"张翥","text":"青林抱涧阿，直上更嵯峨。\n田凿云根种，人盘鸟道过。\n乱泉鸣暗谷，丰草被阳坡。\n彷佛疑山鬼，衣裳隐薜萝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16451,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雨中次黄岩驿","author":"张翥","text":"宿雨晨初歇，高秋日浸微。\n水声千涧落，云气万山归。\n委羽洞天在，仙人飙驾飞。\n丹砂如可问，吾岂恋朝衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16452,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"夜过石溪驿","author":"张翥","text":"篮舆摇醉梦，轧轧过前冈。\n木落风声碎，行人月影长。\n远村时见火，沾露忽零裳。\n一笑方言异，前涂殊未央。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16453,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"刘山驿","author":"张翥","text":"兹山类台剡，回复度中岑。\n传舍白云上，人家乌桕林。\n此身嗟老大，行路转岖嵚。\n佳处时停策，终焉惬野心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":16454,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]