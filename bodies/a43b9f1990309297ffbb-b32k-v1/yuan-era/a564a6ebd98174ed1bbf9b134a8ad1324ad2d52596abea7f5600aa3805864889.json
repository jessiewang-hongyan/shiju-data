[{"title":"再游金山寺","author":"成廷圭","text":"放船重到金山寺，独对沧江照鬓丝。\n过客谩惊天险处，老僧曾见海枯时。\n通宵月色鱼龙喜，绝顶秋声鹳鹤悲。\n琼树花开不归去，妙高台上要题诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18541,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题石林茅屋","author":"成廷圭","text":"春林深深石如笋，我屋正在林之西。\n结茅不放风雨入，种树乃与岗峦齐。\n天寒白鹤向人语，日暮野鸟来上啼。\n浣花老人不可作，何处客至同幽栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18542,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王维贤所藏盛子昭画双松系舟图","author":"成廷圭","text":"云门寺前风物幽，布袜青鞋吾昔游。\n葫芦盛酒待明月，舴艋载琴当上流。\n长松并立几千尺，狂客一别三十秋。\n何当挂席过湖去，东里草堂姑少留。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18543,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送郜彦清之浙西宪史时有高德晋同日应辟之江西所以诗中故及之","author":"成廷圭","text":"西浙西江同应辟，此时此会记清欢。\n两贤共起诸侯幕，十载谁先御史冠。\n野寺听蝉秋冉冉，津亭维马雨珊珊。\n清时事业须公等，老我山中拭目看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18544,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题俞仲桓双林道人卷","author":"成廷圭","text":"双林道人如霜林，参天劲木寒萧森。\n众芳到此万叶脱，元气授尔孤根深。\n风前猛虎作人啸，月下清猿将子吟。\n铁笛老仙在何许，吾欲载酒同幽寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18545,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"宿鹤沙张氏草堂","author":"成廷圭","text":"草堂借我作行窝，杖履频烦太史过。\n满地白云清昼永，隔溪黄鸟绿阴多。\n银瓶自泻中山酒，铁笛谁翻小海歌。\n今日逢君须尽醉，西家亭馆奈愁何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18546,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次杨太史之韵题赠叶子澄草堂图诗","author":"成廷圭","text":"君家草堂林木幽，乃在吴会之东头。\n花开从令鸟雀喜，水落正为鱼龙忧。\n深林烂饮枸杞酒，如意醉击珊瑚钩。\n丈夫嘉遁有如此，傍人比是神仙流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18547,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送陈希文北游","author":"成廷圭","text":"万里中原道路长，关河环绕五云乡。\n心驰天上黄金阙，梦忆山中紫翠房。\n人海鱼龙三月浪，御街车马五更霜。\n丹墀奏罢中兴颂，燄燄声名动北方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18548,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱伯玉南园小隐","author":"成廷圭","text":"君是钱王几叶孙，浮云富贵不须论。\n丈人屋上乌仍好，处士篱边菊尚存。\n招隐辞章娱日月，表忠碑刻照乾坤。\n明当载酒来相觅，烂醉君家老瓦盆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18549,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题杨仲德照磨自汴梁归话中原荆棘蔽野人烟断绝闻复山东感而赋此","author":"成廷圭","text":"故人归报朔方兵，已下山东七十城。\n日月未教乌兔死，风云方使虎龙争。\n入关谩尔窥周鼎，背水今谁立汉旌。\n北望中原五千里，黄河之水几时清。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18550,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"重游虎邱寺","author":"成廷圭","text":"海涌峰头行径微，芒屦欲趁孤云飞。\n风高木客作人语，月出天王骑虎归。\n杰阁重楼递隐见，寒泉古木相因依。\n荒邱王气岂消歇，干将莫耶千载稀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18551,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄题松江之青龙瞿睿夫通波草阁诗","author":"成廷圭","text":"五月通波草阁寒，绿阴长日此凭栏。\n山如碧凤参差出，江作青龙左右蟠。\n榄子烧香云母火，樱桃行酒水晶盘。\n老夫亦有鹅溪绢，也欲相从看写兰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18552,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒舍为偷儿见顾窃去珠环首饰赋以自遣","author":"成廷圭","text":"太息偷儿也自顽，踰垣何意到山间。\n潜踪深夜开重穴，竟造中堂启四关。\n狱吏肯追全璧返，家人犹望去珠还。\n愁来幸喜青毡在，觅纸题诗一解颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18553,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题何德深溪南小隐","author":"成廷圭","text":"宰相官之不受招，碧梧林巷自逍遥。\n溪头二月花先发，洞里千年雪未消。\n朝士过门时载酒，仙人飞佩夜吹箫。\n社图谁写耆英会，还肯中间著老樵。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18554,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寒食日松江有怀广陵","author":"成廷圭","text":"老来也欲惜年华，春正浓时不在家。\n江上苦遭寒食雨，梦中犹见广陵花。\n书藏旧箧应无恙，酒忆新楼不用赊。\n日暮荒城闻鬼泣，东风吹恨满天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18555,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送秀岩上人归日本","author":"成廷圭","text":"几年中国游方遍，看水看山念念非。\n海眼枯时千劫坏，日头出处一僧归。\n黄梅雨打袈裟湿，白蜃云随锡杖飞。\n富士岩前留语在，庭松新长旧禅扉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18556,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题上海静安寺绿云洞天为宁为无寺之祖师虾子和尚","author":"成廷圭","text":"沪渎城西古道场，洞天深处绿云凉。\n雨昏不辨琅玕色，日转都成翡翠光。\n春水满溪虾子活，午阴当户鸟声长。\n华阳老客家何在，拟伴高僧坐石床。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18557,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"别茅府判","author":"成廷圭","text":"封印归来寡送迎，画桥门巷水同清。\n二分明月杯中泻，九朵春云笔下生。\n宾客班荆谈雅道，儿童骑竹颂廉声。\n奚须老拙扬人善，公府争传好姓名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18558,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"三月十日移居","author":"成廷圭","text":"山人垂老厌奔波，客里移居可奈何。\n居竹轩中无长物，采莲泾上有行窝。\n几茎白发梳来短，千古清尊饮尚多。\n最喜东邻王处士，闲来无事肯相过。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18559,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送毛自得北游","author":"成廷圭","text":"平原门下客三千，毛遂当时独妙年。\n脱颖机锋吾已得，治安筹策子何先。\n江淮故道苍烟外，楚汉孤城落照边。\n今日送君何限意，秪将忠孝足家传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18560,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次饶介之游东皋佳作 其一","author":"成廷圭","text":"半雨半晴春更佳，也知郭外少纷华。\n蛮王埠头多载酒，李家园中来看花。\n曲阑芳槛递隐见，苍松老竹相交加。\n安得长绳系乌足，不放西崦红日斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18561,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次饶介之游东皋佳作 其二","author":"成廷圭","text":"纵饮狂歌晚未归，松阴香雾转霏微。\n醉中漫喜朱颜在，头上争禁白发稀。\n无数野花迎客喜，一双沙鸟傍船飞。\n浣花溪上真堪笑，每日朝回只典衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18562,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次饶介之游东皋佳作 其三","author":"成廷圭","text":"草草杯盘也自佳，名园今日有光华。\n东风淡起云漠漠，胡蝶飞上芜菁花。\n百年酒伴无多在，一夜春愁十倍加。\n明朝应被傍人笑，醉里题诗字半斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18563,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次饶介之游东皋佳作 其四","author":"成廷圭","text":"不用人扶醉里归，水边杨柳晚风微。\n一年春事又将半，三月捷音何太稀。\n莫倚书囊谈未了，却凭藜杖步如飞。\n入城彷佛严更动，冉冉花香尚满衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18564,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"同张仲举宿寒桥","author":"成廷圭","text":"柔橹声乾破寂寥，青山矶下宿寒桥。\n乾坤万事双蓬鬓，风雨孤舟半夜潮。\n丹凤不来秋又老，玉人何处水空遥。\n几时更醉秦淮酒，细听渔樵话六朝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18565,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李子英心远亭","author":"成廷圭","text":"门外黄尘扫不开，何由吹得到灵台。\n閒看倦鸟投林去，静爱孤云出岫来。\n彭泽高人多逸兴，峨眉仙客有天才。\n祗今谁到悠然处，同采秋香共一杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18566,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄王仲沔御史左迁之安庆府判诗","author":"成廷圭","text":"青骢马鸣催趣装，日出未出江茫茫。\n但愿四海有武备，不可一朝无宪纲。\n搀抢经天堕作石，沆瀣着地凝为霜。\n先生忧国鬓未白，至今台柏留辉光。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18567,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王澹园明道堂","author":"成廷圭","text":"重阑飞构入清溟，虎豹森罗户不扃。\n紫气拥关周问礼，玉光浮座汉传经。\n日斜海雾侵香案，夜静天风语铎铃。\n几度澹渊来说法，泉中应有老龙听。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18568,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送袁季文之帅幕","author":"成廷圭","text":"少年书剑学从军，幕府于今气不群。\n白发元戎多好武，青衫从事最能文。\n帐前草檄花如雨，江上维舟水似云。\n把酒高歌成远别，不知何处又逢君。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18569,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送张士行士明会试","author":"成廷圭","text":"山东秋榜得豪英，谁似君家好弟兄。\n四海宾兴得两举，七千乡贯占三名。\n大苏衣钵都源委，小宋文章更老成。\n明日鸰原同送喜，早将春信到江城。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18570,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南城暮春","author":"成廷圭","text":"南城雨尽午风和，二客相从步屧过。\n流水陂塘春事减，落花门巷晚愁多。\n银瓶自泻沙头酒，宝瑟谁调陌上歌。\n莫写江南断肠句，贺郎憔悴发空皤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18571,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄湖州乌雅太守时有福建参政之除","author":"成廷圭","text":"万里中原路未开，谁倾银汉洗氛埃。\n诸公多向江南老，远使频从海上来。\n九月溪寒鸥梦熟，三山秋暝鹤书回。\n莫挥白发新亭泪，且醉乌程下若杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18572,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵答冯仁伯","author":"成廷圭","text":"闭门风雨过重九，却忆同登江上台。\n独客诗成扶病起，故人书到拆封开。\n自怜风物随南土，谁有文章落上台。\n黄菊紫萸浑未见，兴来聊复举吾杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18573,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"甫里先生故宅是时马县尹葺其庙","author":"成廷圭","text":"太湖三万六千顷，一代高贤独此翁。\n故宅有僧茶灶在，荒池无主鸭阑空。\n松陵唱和知谁再，茅屋襟期与我同。\n最爱长洲马明府，艰危犹自挹高风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18574,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周平叔夜宿崇明寺海云楼偕罗成之隐君文长老及卢隐君以沙头双瓶为韵各赋诗四首次韵卷后 其一","author":"成廷圭","text":"沧洲三月住星槎，闻访青原隐者家。\n四老咏歌能玩世，百年聚散若抟沙。\n饥来且食书中粟，老去空悲镜里花。\n明日分携各努力，暮云回首隔天涯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18575,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周平叔夜宿崇明寺海云楼偕罗成之隐君文长老及卢隐君以沙头双瓶为韵各赋诗四首次韵卷后 其二","author":"成廷圭","text":"老去无因接胜游，题诗烦寄海云楼。\n天空直与海无底，云起正当楼上头。\n黑水几程通直谷，青山一发是瀛洲。\n高明境界无尘到，抚卷令人咏未休。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18576,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周平叔夜宿崇明寺海云楼偕罗成之隐君文长老及卢隐君以沙头双瓶为韵各赋诗四首次韵卷后 其三","author":"成廷圭","text":"天台老衲两眉庞，自起高楼枕石杠。\n煮茗别开留客处，论文多近坐禅窗。\n冥鸿散去犹相逐，独鹤飞来不作双。\n明发仙舟上霄汉，定传诗话满沧江。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18577,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"周平叔夜宿崇明寺海云楼偕罗成之隐君文长老及卢隐君以沙头双瓶为韵各赋诗四首次韵卷后 其四","author":"成廷圭","text":"天水空明接杳冥，老禅三昧解通灵。\n欲将东海为平地，尽捲西江入净瓶。\n宿霭微分沙鸟白，晚风犹带毒龙腥。\n他时月夜来相觅，笑指狼峰五朵青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18578,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"邱克庄敞云楼","author":"成廷圭","text":"君家楼外云如海，五色轮囷扫不开。\n每就月明檐下宿，更随秋色座中来。\n琼台夜鹤迷踪迹，玉女春衣费剪裁。\n看汝乘将朝帝所，举头西北是蓬莱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18579,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题玉岩上人溪山野趣图","author":"成廷圭","text":"流水淙淙石齿齿，满庭云气欲模糊。\n白鸥溪上秋多少，黄叶山中路有无。\n十月雨深渔屋破，三江风急野航孤。\n年来难觅幽居处，空向晴窗看画图。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18580,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄越上能仁寺用章俊禅师","author":"成廷圭","text":"几年卓锡住苕溪，一日寻山入会稽。\n蒲室塔曾藏舍利，道林堂已种菩提。\n空中云气开楼阁，门外湍声杂鼓鼙。\n草木变迁吾老矣，隔江南望转凄迷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18581,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和周伯温参政九日南园宴集诗二首 其一","author":"成廷圭","text":"步履巉岩若跨鳌，望中诗兴与秋高。\n西山拄笏东山屐，右手持杯左手螯。\n返照入湖明塔影，断云将雨过林皋。\n松间饮散归来晚，金粉霏霏湿锦袍。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18582,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和周伯温参政九日南园宴集诗二首 其二","author":"成廷圭","text":"范相南园五百秋，重来访古转多愁。\n啼乌树老台空在，饮马池荒水不流。\n芹泮好从多士乐，桂丛谁赋小山幽。\n诸公高会诗如锦，授简安能接胜游。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18583,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"嘉兴缪同知号菊陂因赋","author":"成廷圭","text":"杰哉霜下转精神，一色中黄不染尘。\n老圃看花迎宰相，秋潭分水候仙人。\n千年东里归何早，九日南陂赏□□。\n在昔神农书上药，至今医国慰斯民。","collection":"元","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18584,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"马瞿睿夫题张伯雨外史评黄子久画仙山楼观图","author":"成廷圭","text":"陵谷东南几变迁，琼台仍在白云边。\n阎浮世上今何日，句曲山前第八天。\n说法久要狂外史，挥毫曾识大痴仙。\n人间俯仰三千岁，抚卷题诗一惘然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18585,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺耕叟晚香亭","author":"成廷圭","text":"幽香分得东篱本，每候开时九月前。\n晚岁谁从陶靖节，高风独数傅延年。\n清秋泛酒宾筵盛，白发簪花客帽偏。\n若个芬芳同老境，魏公佳句至今传。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18586,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"二月十四日风雨孤坐秀州城西僧舍赋此","author":"成廷圭","text":"秀州城西春事微，二月苦雨行人稀。\n江湖渺然不可渡，风雨如此将安归。\n老来口腹胡为累，乱后人民今见非。\n兼旬不得武陵信，倚杖南望孤鸿飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18587,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送马令尹任满","author":"成廷圭","text":"长洲赤子穷无告，正赖郎官为抚摩。\n兵后人家犹耒耜，日长官社有弦歌。\n越来溪上波声小，鲁望祠前月色多。\n自古长才须大用，荐书元不待常何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18588,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题嘉兴水西寺爽溪楼寄新仲铭长老","author":"成廷圭","text":"新公邀作爽溪游，为说前朝有此楼。\n云气远开天北极，风光仍在水西头。\n虚檐古瓦缘苍鼠，曲涧轻波漾白瓯。\n宸翰仅留飞白在，烟尘漠漠使人愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18589,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺长洲县令尹马公除枢密院都事","author":"成廷圭","text":"报政期年上考书，君才端合应时须。\n三公掾属多为相，两府郎官半是儒。\n夜帐论兵银烛抚，春庭称寿綵衣趋。\n苍生久堕巅崖苦，定有嘉言赞庙谟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18590,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次张仲举侍读韵","author":"成廷圭","text":"词源浩浩倒岷江，直笔如公世少双。\n目下十行千字过，身长九尺两眉庞。\n世间忠烈应知感，地下奸谀岂竖降。\n老客中吴最萧索，白头犹尔读书窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18591,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"东饶介之","author":"成廷圭","text":"鲁连不为商贾事，贺监自是神仙人。\n解纷排难乃豪杰，嗜酒狂歌非隐沦。\n燕雀一生谋水食，凤凰千仞出风尘。\n太湖之水东作海，海上桃花树树春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18592,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄张内翰","author":"成廷圭","text":"中原不见旧山河，使节仍烦涉海波。\n天末草烟春信早，江南风雨客愁多。\n谢公拟献中兴颂，壮士宁忘敕勒歌。\n万里相忘成永决，白头萧索柰公何。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18593,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王仲德思诚斋 其一","author":"成廷圭","text":"六凿相攘总失真，一诚无妄见斯人。\n指挥直拟回天地，祭祀还能给鬼神。\n别室蓍龟先兆汝，前楹鸟雀自相驯。\n明年执玉朝廷上，会见尊严动缙绅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18594,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王仲德思诚斋 其二","author":"成廷圭","text":"爱汝端居入静思，察机尤在未萌时。\n天人孚感原无间，物我交攻每日持。\n行远升高应得已，斋心浴已固知之。\n屈伸洞见阴阳理，荣瘁休嫌风露枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18595,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋得落星湖送瞿睿夫任满之诗","author":"成廷圭","text":"南湖北湖春水多，陨石下筑神龙窝。\n渚花汀草各无赖，云影天光相荡摩。\n天星劝汝一杯酒，海月听我千年歌。\n斗牛之槎若可待，送子八月乘银河。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18596,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"钱塘谢太守有书见邀作此诗以谢之","author":"成廷圭","text":"一缄远寄楚狂生，上有钱塘太守名。\n堆案几时疑是梦，焚香三读见高情。\n五湖风月曾宾主，四海交游总弟兄。\n少待西风渐凉后，六桥荒藓尚堪行。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18597,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饶介之有诗见贻次韵奉荅 其一","author":"成廷圭","text":"一夜南风约晓晴，看山如在越中行。\n丹藏别室生虹气，啸入空岩作虎声。\n倒涧枯松留古怪，悬崖飞瀑漱寒清。\n神仙若个能千岁，吾欲崆峒问广成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18598,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"饶介之有诗见贻次韵奉荅 其二","author":"成廷圭","text":"数日南风阴复晴，饭馀閒绕绿阴行。\n竹间病鹤缡褷影，池上惊鱼拨刺声。\n老子鬓毛如此白，道人心迹本来清。\n能诗谁是周公子，学得阴何五字成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18599,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贺李左丞再入中书","author":"成廷圭","text":"上公开府驭群英，妙算神机属老成。\n裴度向来归绿野，谢安重起为苍生。\n朝廷约法三章旧，天地功成百谷盈。\n不有武功除暴虐，岂无文教答升平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18600,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"万壑松涛为郜彦清赋","author":"成廷圭","text":"草堂夜夜听松涛，谁挽沧溟压树梢。\n雷谷震惊龙换骨，风林摇荡鹤倾巢。\n玉山月白箫声杂，银汉天清剑气交。\n我与周弘同洗耳，乘槎便欲渡三茅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":18601,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]