[{"title":"春江独钓图","author":"王恽","text":"渺渺春江碧若空，一丝斜袅钓坛风。\n富春莫拟幽栖稳，已在君王物色中。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题烟江叠嶂图","author":"王恽","text":"楚水吴山万里秋，风帆吹饱北来舟。\n应怜满眼新亭客，空对江山双泪流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山行杂诗二首 其一","author":"王恽","text":"太行元气老洪濛，草树风前带润容。\n山色只宜差远看，近移空翠上高峰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山行杂诗二首 其二","author":"王恽","text":"西来游宦半忙閒，六日迢遥道路间。\n回转羊肠三百里，天教马上饱看山。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"毳幕卓歇图","author":"王恽","text":"牙旗风软马萧萧，渭水归来气更豪。\n想得龙沙西北道，际天秋草黑山高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"韩干画照夜白图","author":"王恽","text":"缨绂驺衣一色红，玉华光照苑门空。\n昭陵六骏秋风里，辛苦文皇百战功。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"滕王蝶蚁图二首 其一","author":"王恽","text":"槐壤纷纷事暂欢，枕中栩栩伴周閒。\n丹青欲识滕王意，须著人间比梦间。",