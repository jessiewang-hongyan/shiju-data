[{"title":"卧病奉怀中恺季子修龄三君子","author":"陈显曾","text":"地偏异寒燠，厉风筋膂伤。\n时艰况羁旅，年登尚糟糠。\n忆昨盛壮辰，致身思慨慷。\n空余献纳志，白首念严廊。\n卧疾厌长夜，惊乌惨繁霜。\n斗室悲黝暗，揽衣俟初阳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33814,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"歌风台次韵","author":"陈显曾","text":"建议初辞灞上亭，指挥豪杰破名城。\n高台置酒传天语，故国蒙恩罢岁征。\n王气郁葱关树晓，霸图萧瑟楚云晴。\n良弓走狗知何补，空叹韩彭意未平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33815,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题金坛张氏云泉斋","author":"陈显曾","text":"尔家南山不计年，松下小斋长独眠。\n闲云栖户堕复起，回溜入溪清可沿。\n山头抱犊夕阳下，池上种花春雨前。\n愧我始衰仍远役，束书西问汉江船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33816,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"溪山胜概楼","author":"陈显曾","text":"江南二月罗衣裳，藤花满地山云香。\n背人小燕撇波去，朱帘白日游丝长。\n蒲茸绿浅芹芽紫，沙上轻烟湿飞雨。\n美人遥睇木兰船，一夜相思隔春水。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33817,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题横山雪浪庵梅花","author":"陈汝霖","text":"罗浮一别暗伤神，月落参横恐未真。\n今日细看枝上雪，当年曾寄陇头人。\n孤根占断千花谱，百味空销万劫尘。\n偶到禅房聊一和，白头憔悴不胜春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33818,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送吴县之官嘉定分题赋得夫椒山","author":"顾常","text":"夫椒洞庭野，积翠窅防间。\n水倒青莲影，云梳玉女鬟。\n回峰驱越骑，挂月照吴关。\n今古皆陈迹，伤离惨别颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33819,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"澹泊轩","author":"慧熙","text":"阿师澹泊异常人，乐止斯轩岂患贫。\n白拂懒挥床角挂，金文间阅案头陈。\n鹤因煮石鸣应喜，龙为斟泉卧恐嗔。\n却笑黄尘来往客，终朝门外闹蹄轮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33820,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题邹氏寿山图","author":"陆以道","text":"野水微茫小苑东，林居窈窕白云中。\n一帘湿翠山川气，十里生香草木风。\n落日放舟还载酒，有时挥麈坐谈空。\n惟应安晚堂前月，长照梅边鹤发翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33821,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽华季充","author":"陆以道","text":"早慧推文举，多才许正平。\n诗声随日长，病骨与秋清。\n桃叶歌先断，兰芽玉未成。\n灯前看麈尾，应自惜余生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33822,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"挽虞薇山先生","author":"孟潼","text":"桑梓连云影，抠趋愧互乡。\n道同志易合，情浃分俱忘。\n旧梦空流水，高风企惠阳。\n凝云凄薤露，回首泪沾裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33823,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送薛仲杰之奉化州判","author":"司马亨","text":"忆作参军日，曾闻少壮时。\n兰陵人共说，苕水去犹思。\n甘雨歌来邑，冬阳爱趟衰。\n如何重绾绶，叹息未分麾。\n东海民从亿，南山判莫移。\n朝廷须旌表，别拟送君诗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33824,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游惠山寺","author":"王仁辅","text":"红社溪边舣小舟，青莲宇内作清游。\n土花绣壁淡如昼，岚翠拨云浓欲流。\n短李清风存古意，大苏圆月洗春愁。\n摩挲泉石舒长啸，未羡神仙十二楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33825,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄倪元镇","author":"王寔","text":"每怀云林人，能诗复能画。\n诗摩靖节垒，画并董元驾。\n大娘舞剑器，烈士歌唾壶。\n前朝媚没骨，允矣斯人徒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33826,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越中秋怀二首 其一","author":"吴采","text":"无边落木送秋来，宋玉愁多赋更哀。\n淮甸烽烟连白下，楚江云影暗阳台。\n汉王未惜三斋印，庞统原非百里才。\n俛仰去天才咫尺，几回清梦到三台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33827,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"越中秋怀二首 其二","author":"吴采","text":"羁思愁怀耿未平，秋来景物倍伤情。\n苍鲸跋浪风偏恶，宝剑惊时夜亦鸣。\n南国未全沧海贡，中原犹望朔方兵。\n躬耕自惜英雄事，未必南阳老此生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33828,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题周南斋书卷","author":"孟栻","text":"南市城边一草堂，图书左右百忧忘。\n屋偏宜夏风生画，花易逢春地向阳。\n不愿笙歌闻北里，为怜松竹锁西庄。\n自家意思何相似，庭草青青日渐长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33829,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题惠麓复隐图二首 其一","author":"孟棐","text":"满汲清泉洗战尘，结茅重与惠山邻。\n谋生不为鸡豚乐，愿得粢盛岁荐新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33830,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题惠麓复隐图二首 其二","author":"孟棐","text":"频年避地得生全，白发归来只自怜。\n栽树种田春雨后，试茶重煮惠山泉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33831,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赋尹氏澹饭斋","author":"陶植","text":"食澹神自清，甘肥成疢疾。\n吁嗟口腹徒，奢味无穷极。\n嘉馔必候鲭，骈罗方丈席。\n过此三寸喉，芬芳竟何益。\n尹君和靖孙，传家守清白。\n官虽列华要，励志常冰蘖。\n箪食与豆羹，泰然对宾客。\n吾徒山泽癯，何惭枯槁质。\n书此澹饭斋，洗心聊自饬。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33832,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其一 古梅","author":"冯子振","text":"君复孤山数百年，此花又在此翁先。\n只今起早新栽树，后世相看亦复然。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33833,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其二 早梅","author":"冯子振","text":"夜来花发先群芳，又向丛中独擅场。\n毕竟先开定先落，谁能雪里久馨香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33834,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其三 江梅","author":"冯子振","text":"若有人兮湘水濆，冷香和月浸黄昏。\n自怜不入离骚谱，待把芳心吊楚魂。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33835,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其四 溪梅","author":"冯子振","text":"古树横斜涧水边，野桥村市独暄妍。\n玉堂路杳无心到，甘与渔翁系钓船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33836,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其五 岭梅","author":"冯子振","text":"谁种霜根大庾颠，地高天近得春先。\n枝南枝北元同干，何事东风亦有偏。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33837,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其八 老梅","author":"冯子振","text":"古树槎牙长绿苔，半边生死尚花开。\n不须更问春深浅，人道咸平手种来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33838,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其九 新梅","author":"冯子振","text":"几年雨露栽培得，此度春风乍著花。\n为语东君加爱护，徐看老大已横斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33839,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十一 远梅","author":"冯子振","text":"罗浮山下起春风，千里相思信不通。\n安得移栽近书屋，繁花乱落向晴空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33840,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十二 落梅","author":"冯子振","text":"花开花落春不管，清风明月自绸缪。\n天然一种孤高性，直是花中隐逸流。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33841,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十三 蟠梅","author":"冯子振","text":"屈干回枝制作新，强施工巧媚阳春。\n逋仙纵有心如铁，奈尔求奇好事人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33842,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十五 雪梅","author":"冯子振","text":"北帝司权发令新，天葩凡卉斗精神。\n化工不让花神巧，特与增添一树春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33843,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十七 风梅","author":"冯子振","text":"绰约肌肤不受吹，飘香坠玉怕春知。\n凭谁领取东君意，传语封家十八姨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33844,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十八 烟梅","author":"冯子振","text":"谁家吹笛苦悲凉，断却佳人铁石肠。\n回首泪痕看不得，离情分付返魂香。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33845,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其十九 红梅","author":"冯子振","text":"春风昨夜入南枝，浃髓沦肌释冻威。\n和气晓来无著处，满空飘作綵云飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33846,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其二十一 千叶梅","author":"冯子振","text":"蜜瓣重重玉作围，就中消息孰能窥。\n待看水月澄明际，彷佛观音化现时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33847,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其二十四 胭脂梅","author":"冯子振","text":"捣碎春英看守宫，花房芳信一时通。\n汉庭佳丽三千女，艳抹浓妆总是同。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33848,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其二十五 照水梅","author":"冯子振","text":"玉树临流雪作堆，寒光疏影共徘徊。\n多情最是黄昏月，配合春风不用媒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33849,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏梅三十首 其二十六 二月梅","author":"冯子振","text":"高标久占百花魁，春半方开恨太迟。\n毕竟东君有深意，等閒桃李莫相欺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33850,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其一","author":"赵孟頫","text":"诗亡春秋作，仲尼盖苦心。\n空言恐难托，指事著以深。\n大义炳如日，万古仰照临。\n凤鸟久不至，楚狂乃知音。\n愁来不得语，起坐弹吾琴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33851,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其二","author":"赵孟頫","text":"周衰有战国，纷纷极荆蓁。\n黄金聘辩士，驷马迎从人。\n朝为刻骨雠，莫作歃血亲。\n终然智力屈，奉身俱入秦。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33852,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其三","author":"赵孟頫","text":"相如赋大人，出语颇奇怪。\n飘然凌云意，过耳诚一快。\n誇言入无际，自觉尘俗隘。\n安知翻成劝，何用名为戒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33853,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其四","author":"赵孟頫","text":"自有天地来，蓬莱几清浅。\n人生空皓首，举世谁得见。\n瑶台在何许，渺渺烟波远。\n方舟不可渡，使我空展转。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33854,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其五","author":"赵孟頫","text":"绝代有佳人，被服绮与纨。\n蛾眉秀联娟，吐词馥若兰。\n清歌启皓齿，瑶琴发哀弹。\n一弹再三叹，听者涕汍澜。\n借问谁家子，为言本邯郸。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33855,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其六","author":"赵孟頫","text":"秋风吹庭树，故叶纷以队。\n明月耿夜长，草虫促经纬。\n四序苦不淹，少壮何足贵。\n展转复展转，寤辟不能寐。\n昔为闺中秀，今作市门鄙。\n岂无膏与沐，甘心得憔悴。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33856,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其七","author":"赵孟頫","text":"山深多悲风，日莫愁我心。\n玄云降寒雨，松柏自哀吟。\n人生百年后，奄然閟重阴。\n念此每不乐，天路何由寻。\n仙人偓佺辈，消摇在青岑。\n奈何不尔思，委命重黄金。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33857,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其八","author":"赵孟頫","text":"海山有奇树，粲粲珊瑚枝。\n由来植物性，无胫可推移。\n如何石氏子，树之白玉墀。\n洛阳经几战，金谷久荒夷。\n空令千载下，闻者为伤悲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33858,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其九","author":"赵孟頫","text":"烈风号枯条，落叶满周道。\n原野何萧索，川流亦浩浩。\n离居日以远，怀思令人老。\n功名会有时，生世苦不早。\n顾瞻靡所骋，忧心惄如捣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33859,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古风十首 其十","author":"赵孟頫","text":"浮云何方来，不知竟安之。\n飘飖随风去，汗漫以为期。\n自昔功名士，往往事驱驰。\n白驹空谷中，谁能加絷维。\n皎皎难见容，翻受世妍媸。\n虚名诚无益，不见斗与箕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33860,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和子俊感秋五首 其一","author":"赵孟頫","text":"秋至倏廿日，天宇豁然清。\n凉飙旦夕至，林木发商声。\n良辰不我与，慨然心自惊。\n古人久已逝，念之动中情。\n苦心婴世患，只博身后名。\n今我将无同，庶复得此生。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33861,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和子俊感秋五首 其三","author":"赵孟頫","text":"披衣步中庭，仰视河汉白。\n寓形天地内，聊复度朝夕。\n仲尼谅非愚，皇皇不暖席。\n履运有异同，喟然慨今昔。\n丘园岂云远，终当期屏迹。\n日月驰骛去，鸟影飞过隙。\n归休盍不早，胡为受形役。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33862,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和子俊感秋五首 其四","author":"赵孟頫","text":"微霄暧高宇，轻飙弄微凉。\n天气政尔佳，抚己徒自伤。\n今日非昨日，荏苒叹流光。\n几见春鸟鸣，巳复啼寒螀。\n一时良亦短，万世则为长。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33863,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其一","author":"赵孟頫","text":"皇天分四序，寒暑互推移。\n如何当秋夕，怆恍令心悲。\n寒蝉寂无声，翔雁纷南飞。\n西风一披拂，草木失华滋。\n不惜鶗鴂鸣，但伤众芳萎。\n徘佪白露下，郁邑谁能知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33864,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其二","author":"赵孟頫","text":"美人涉江来，遗我云和琴。\n朱丝縆玉轸，古意一何深。\n长歌和清弹，三叹有遗音。\n逸响随风发，高高不可寻。\n奈何俚俗耳，折杨悦哀淫。\n此道弃捐久，沉吟独伤心。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33865,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其三","author":"赵孟頫","text":"明明秋夜月，流光照罗帷。\n隐忧从中来，起视夜何其。\n草虫催杼轴，扎扎鸣声悲。\n良人远行役，万里归无期。\n予发巳曲局，膏沐久不施。\n回身入闺房，愁思当告谁。\n独有中宵梦，遥遥为君驰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33866,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其四","author":"赵孟頫","text":"苍天高无极，大川广且深。\n下有沉潜鱼，上有冥飞禽。\n先民莫不逸，我独怀苦心。\n抒情作好歌，歌竟意难任。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33867,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其五","author":"赵孟頫","text":"陵苕何青青，上蒙松与柏。\n一时良亦好，岁晚竟谁得。\n人无金石寿，生年不盈百。\n何为慕荣禄，抱此长戚戚。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33868,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏怀六首 其六","author":"赵孟頫","text":"菽粟在中原，夫人能采之。\n无为思百忧，欢乐当及时。\n今日忽已过，来日非所知。\n有酒且复饮，既醉歌令仪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33869,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其一","author":"赵孟頫","text":"凤凰览德辉，奋翅翔千仞。\n矫矫孤竹子，求仁斯得仁。\n於心有不厌，视世等埃尘。\n俯仰志不屈，又不辱其身。\n圣言一以宣，万古无缁磷。\n谁言首阳山，卓与嵩华邻。\n采采山中薇，愧尔肉食人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33870,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"咏逸民十一首 其二","author":"赵孟頫","text":"劳生本非情，禄仕吾不苟。\n古来畎亩间，亦有沮溺叟。\n依依偶耕心，千载思尚友。\n中道世所难，狂狷诚足取。\n如何绝代下，相知不忠厚。\n仲尼不复作，斯怀向谁道。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33871,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁莫和刚父杂诗四首 其一","author":"赵孟頫","text":"穷阴结严寒，玄景閟微阳。\n兰萧同憔悴，隐恻我中肠。\n美人弹玉琴，继之歌清商。\n弦急声未巳，知子意独长。\n阳春时未至，此曲徒悲伤。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33872,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岁莫和刚父杂诗四首 其二","author":"赵孟頫","text":"美玉处荆山，林木生光辉。\n采之献凡目，弃置亦其宜。\n如何和氏子，涕泣有馀悲。\n古来贤达人，不为毁誉移。\n被褐怀至宝，宁惧不我知。\n待贾未能信，韫藏诚可师。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33873,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赠道隆上人","author":"赵孟頫","text":"辟俗无所之，步寻招提游。\n颓垣蔽蓬艾，破屋坏不脩。\n老僧俗念净，静坐百不忧。\n浮云有逸态，止水无急流。\n乃知我辈人，苦受世累囚。\n朅来得此地，稍觉心休休。\n窗前几丛菊，青蕊亦巳稠。\n爱之不忍采，留作山房秋。\n何当移四松，伴汝成清幽。\n南冈与北岭，路近颇易求。\n他年风雨夜，来听龙吟愁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33874,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"游南山憩山下人家和人韵","author":"赵孟頫","text":"驱马南山阳，下马望绝巘。\n解衣坐盘桓，言就蓬庐偃。\n非无攀援力，兴尽自应返。\n天高暄风息，木落岁华晚。\n势阻乏遐观，趣得心自远。\n不有君子词，何用抒缱绻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33875,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春后多阴偶成三首用复无逸来贶 其一","author":"赵孟頫","text":"日出晨景澹，散发步中庭。\n仰见濯濯柳，春风畅人情。\n兹晨岂不佳，谁能定阴晴。\n人生亦良脆，疲劳竟何营。\n万事可拨遣，舍道焉求成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33876,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春后多阴偶成三首用复无逸来贶 其二","author":"赵孟頫","text":"卧起向北窗，一室可栖迟。\n取诗三百萹，一一弦歌之。\n古道岂为远，先师不吾欺。\n嘉我有良朋，所志共在兹。\n适意聊娱乐，过此非所知。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33877,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春后多阴偶成三首用复无逸来贶 其三","author":"赵孟頫","text":"仲春忽已过，四序随流波。\n水深不可厉，苦雨一何多。\n田园颇在念，春事今如何。\n沉忧亦无益，言笑复言歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33878,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"晓起川上赠友","author":"赵孟頫","text":"明发不能寐，独步柳阴中。\n秋色方浩荡，晨光乍曈昽。\n烁烁川上日，萧萧树间风。\n葛巾吹欲堕，纤絺巳无功。\n感彼岁月驶，悟此人世空。\n悠悠竟何补，山林情所钟。\n终期抗高志，驾言从赤松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":33879,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]