[{"title":"试院杂题五首 其五","author":"马祖常","text":"游客春来醉若泥，摄官一月伏雌鸡。\n连茵夜听同年语，写纸朝分举子题。\n画阁薰香金篆郁，银台烧烛玉虫齐。\n太官已具恩荣宴，列宿重辉想次奎。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22969,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"光山县尹孔凝道作县有声乡人为图","author":"马祖常","text":"光山近在故山西，树满江头稻满畦。\n邻屋读书相教授，社祠醉酒共提携。\n水牛砺角嫌耕浅，野茧抽丝喜价低。\n春雨行田无从吏，独骑斋马畏青泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22970,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题四首 其一","author":"马祖常","text":"瓦沟银竹曙翻江，阆苑凉风满石幢。\n葛令寄来丹臼一，陶公归去酒瓢双。\n梧桐寂寞陈公井，薜荔扶疏玉女窗。\n天畔帝车呼小凤，桂花流水夜淙淙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22971,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题四首 其二","author":"马祖常","text":"鹤城十二叠瑶光，琪树悬秋四面香。\n蛱蝶染花生粉白，玻璃著酒暖金黄。\n熏炉旧梦凭荀令，烛扣閒吟属沈郎。\n南国雁来书不至，江楼谁为制荷裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22972,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题四首 其三","author":"马祖常","text":"三湘潇洒恨无潮，乌鹊填河愿有桥。\n丹穴凤来龙树远，海门鱼去蜃楼遥。\n已知京兆誇高髻，不信章华斗细腰。\n船尾横江春水急，长年无事醉吹箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22973,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"无题四首 其四","author":"马祖常","text":"爱酒书生白发垂，鸾胶獭髓岂能医。\n汉宫斗草端阳节，唐殿穿针七夕时。\n竹上蛎房真可买，石间芝箭似难移。\n扬雄拟奏河东赋，但乞君王酒一卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22974,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次前韵四首 其一","author":"马祖常","text":"岷峨山下锦成江，好买玄都翡翠幢。\n竹种筼筜千万个，鸟飞鸂?两三双。\n铜龙漏下春生水，金马神来雾入窗。\n花落天台招小隐，胡麻饭熟石淙淙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22975,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次前韵四首 其二","author":"马祖常","text":"切玉龙刀宝气光，祫罗半臂麝脐香。\n荔枝囊密嫣嫣紫，卢橘团金颗颗黄。\n秦氏故侯更汉主，石家小妇嫁孙郎。\n江心谁铸芙蓉镜，照见嫦娥织翠裳。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22976,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次前韵四首 其三","author":"马祖常","text":"钱塘八月水生潮，邛笮千年竹架桥。\n簟织龙须天路近，衣裁蝉翼渚宫遥。\n府中丞相鱼垂带，阃外将军箭插腰。\n无奈黄金閒买赋，云间学得凤凰箫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22977,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次前韵四首 其四","author":"马祖常","text":"乐部韦娘舞小垂，病来能召翰林医。\n嗔人书奏三千牍，劝客歌诗十二时。\n金谷花枝随雨尽，石城江水逐潮移。\n世间若有神仙术，西去瑶池醉酒卮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22978,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"龙门","author":"马祖常","text":"万壑奔流一峡开，君王岁岁御龙来。\n人间尘土常相隔，天上星辰到此回。\n草木四时承午日，风云半夜束春雷。\n自惭曾奏《长门赋》，跋马傍徨念暴鳃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22979,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"还过龙门","author":"马祖常","text":"紫塞秋高凤辇回，龙门有客去还来。\n荡摩日月昆崙坼，吐纳风云混沌开。\n天帝有神司主宰，地灵无力戴崔嵬。\n谁吹石濑成飞雨，不使时人污酒杯。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22980,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"驾发上京","author":"马祖常","text":"苍龙对阙夹天阍，秋驾凌晨出国门。\n十里貔貅骑腰袅，一双日月绣旗幡。\n讲蒐猎较黄羊圈，赐宴恩沾白兽尊。\n赫奕汉家人物盛，马卿有赋在文园。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22981,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和袁伯长待制送虞伯生博士祠祭岳镇江河后土","author":"马祖常","text":"房闼歌儿翠黛摧，不禁夫婿陟崔嵬。\n一春花好人相别，四月梅黄雨又来。\n酒酌玉缸酣脸晕，香消银叶蠹炉灰。\n祠官好致君王意，早奉神休马首回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22982,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"琉璃帘","author":"马祖常","text":"吴侬巧制玉玲珑，翡翠虾须迥不同。\n万缕横陈银色界，一尘不入水晶宫。\n月华远射离离白，灯影斜穿细细红。\n相隔神仙才咫尺，灵犀一点若为通。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22983,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菊枕","author":"马祖常","text":"东篱采采数枝霜，包裹西风入梦凉。\n半夜归心三径远，一囊秋色四屏香。\n床头未觉黄金尽，镜底难教白发长。\n几度醉来消不得，卧收清气入诗肠。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22984,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"野兴","author":"马祖常","text":"沧洲梅发月生波，屋角寒藤半挂萝。\n孤石隐林真似马，乱云渡水却如鹅。\n步随野老逢人少，閒过邻家有酒多。\n转忆淮南粳稻熟，夜归冲雨借田蓑。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22985,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"开平事","author":"马祖常","text":"金马门东画省西，千官花覆曙光低。\n九茎芝盖云衣合，百石铜盘露颗齐。\n鹿栅已营修竹坞，燕巢还补落花泥。\n上林伏日金桃熟，鹦鹉来时不敢栖。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22986,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次韵进士宋显夫海岸春行","author":"马祖常","text":"灵沼春波殿影高，行人苑外望蟠桃。\n街尘曙雨沈红雾，宫瓦晴霏动翠涛。\n鸟度镜中还避弹，鱼跳船尾不因篙。\n曲江别有新承宴，笑我官曹似马曹。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22987,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"驾发","author":"马祖常","text":"紫绣鸾旗不受风，北都驾发日曈昽。\n九秋宫殿明天外，十部箫韶起仗中。\n白海水波浮晓绿，赤城花蕊带春红。\n神皋不用清尘雨，辇路龙沙草藉重。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22988,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送宋显夫南归","author":"马祖常","text":"琵琶沟北识君初，藉甚才华二十馀。\n欲赋兔园干孝邸，不同狗监荐相如。\n潇湘路熟逢知己，韦杜天低望故居。\n携幼归来拜丘陇，南游莫恋武昌鱼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22989,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"寄淡渊提点","author":"马祖常","text":"仙客吹箫踏月轮，因游淮海误寻真。\n松花捣药分贫士，柿叶题诗寄远人。\n秋浦有潮留载酒，春云不雨取裁巾。\n江都千树隋宫柳，曾见先生绿发新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22990,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送客西归","author":"马祖常","text":"陆机初入洛，王粲却归秦。\n春草无愁思，杨花送远人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22991,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中登郡城西亭二首 其一","author":"马祖常","text":"石路屐齿滑，天风吹高寒。\n花明喜珠缀，竹瘦愁露漙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22992,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"雪中登郡城西亭二首 其二","author":"马祖常","text":"楚甸无层冰，霢霂土膏湿。\n更怜三角湖，澄彻瑩寒碧。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22993,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吊节妇","author":"马祖常","text":"白日松台閟，青山石椁沈。\n空馀哭夫泪，下入九泉深。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22994,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题四皓图","author":"马祖常","text":"不听高皇召，还来太子宫。\n阿㜷人彘祸，吾恨紫芝翁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22995,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"僧院蜀葵","author":"马祖常","text":"紫晕成丹景，黄敷缀绿幢。\n何因女冠子，却近老僧窗。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22996,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"閒题树叶上","author":"马祖常","text":"秋意凤城多，凉飙奈夜何？\n题诗满霜叶，不见洞庭波。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22997,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"山水图","author":"马祖常","text":"石壁云生树，涛江雨闇船。\n居人属仙籍，长负免丁钱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22998,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李陵台二首 其一","author":"马祖常","text":"故国关河远，高台日月荒。\n颇闻苏属国，海上牧羝羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":22999,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李陵台二首 其二","author":"马祖常","text":"蹛林闻野祭，汉室议门诛。\n辛苦楼兰将，凄凉太史书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23000,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"画鹰","author":"马祖常","text":"侧视窥霄汉，低飞近草莱。\n金韝时一脱，肉饱更须回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23001,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题猿图","author":"马祖常","text":"江渚无来雁，山樊有宿猿。\n秋高卢橘熟，巴月树连村。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23002,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄河","author":"马祖常","text":"尘海东南下，云山西北高。\n黄流荡中潏，万里费波涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23003,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"独石","author":"马祖常","text":"秋濑喧石梁，临流不肯渡。\n与客坐忘归，山寒日将暮。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23004,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六言三首 其一","author":"马祖常","text":"南塘雨晴草满，西林春早花疏。\n道士烧丹借灶，山翁种树求书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23005,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六言三首 其二","author":"马祖常","text":"白鸟飞来何许，青山閒对谁家？\n日暮一尊浊酒，不知风帽欹斜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23006,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"六言三首 其三","author":"马祖常","text":"绝涧花迎暮竹，回塘水媚春云。\n欲赋淮南招隐，山中桂树留人。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23007,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨妃墓","author":"马祖常","text":"汉庙衣冠照碧燐，唐陵翁仲作黄尘。\n马嵬坡上棠梨树，犹占秦原几日春。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23008,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南城二首 其一","author":"马祖常","text":"城南牡丹一百本，翰林学士走马来。\n渡水杨花逐飞燕，蓟中芳草送春回。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23009,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"南城二首 其二","author":"马祖常","text":"粟侯亭前花一园，客来日日费金钱。\n明朝碧树春城令，恨不江东问酒船。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23010,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骊山二首 其一","author":"马祖常","text":"绣岭春来绿树圆，东风吹影入温泉。\n华清梦断飞尘起，玉雁衔香堕野田。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23011,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骊山二首 其二","author":"马祖常","text":"玉女泉边翠藻多，石池涵影媚宫娥。\n可怜绣岭啼春鸟，犹似梨园弟子歌。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23012,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河湟书事二首 其一","author":"马祖常","text":"阴山铁骑角弓长，閒日原头射白狼。\n青海无波春雁下，草生碛里见牛羊。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23013,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"河湟书事二首 其二","author":"马祖常","text":"波斯老贾度流沙，夜听驼铃识路赊。\n采玉河边青石子，收来东国易桑麻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23014,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"七夕舟中苦热","author":"马祖常","text":"尝忆银床桐泣露，更思玉椀蔗流浆。\n天孙初嫁龙绡薄，却恐秋河入夜凉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23015,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"戏马台","author":"马祖常","text":"将军一叱靡千人，未可掀髯便笑秦。\n枉筑高台闲戏马，汉王将地拟功臣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23016,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"春日即事","author":"马祖常","text":"梨花白罢海棠红，谁为韶光次第工。\n小閤卷帘春事晚，伫看蝴蝶过庭东。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23017,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送胡古愚还越二首 其一","author":"马祖常","text":"越江秋水得霜清，夜夜天南婺女明。\n客子布衣风又急，世间无用是才名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23018,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"送胡古愚还越二首 其二","author":"马祖常","text":"送客归山天正霜，吴江蟹美橘初黄。\n上林千树樱桃熟，莫恋金华是故乡。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23019,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"过故相宅","author":"马祖常","text":"瓦坠当檐燕不来，白头老妾卖花栽。\n旧时小吏今身贵，羞近门西上马台。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23020,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闽浙之交三首 其一","author":"马祖常","text":"闽峤人居罨画图，客行只欲望京都。\n笋舆轧轧相思岭，秋雨空濛叫鹧鸪。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23021,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闽浙之交三首 其二","author":"马祖常","text":"路入闽中尽翠微，家家蕉葛作秋衣。\n石墙遮竹松围屋，时有丹禽哺子归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23022,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"闽浙之交三首 其三","author":"马祖常","text":"山溪秋濑急飞淙，万斛跳珠溅石矼。\n闽女唱歌来漂苧，素馨花插髻丫双。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23023,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"诮燕","author":"马祖常","text":"风雨池塘斗颉颃，春来秋去一生忙。\n世间多少宽閒境，辛苦营巢傍屋梁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23024,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"五月芍药","author":"马祖常","text":"红芍花开端午时，江南游客苦相疑。\n上京不是春光晚，自是天家日景迟。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23025,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"潘居士施饭","author":"马祖常","text":"饭饱千僧洗钵归，生台饥鸟拂檐飞。\n山中丈室维摩病，独向长松挂衲衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23026,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"骏马图","author":"马祖常","text":"天马西来入帝闲，风騣雾鬣驳文班。\n房星一夜光如水，却怨龙媒万里还。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23027,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贡院次曹子真尚书韵二首 其一","author":"马祖常","text":"杏园三月换银袍，燕子西飞背伯劳。\n赋罢长杨传唱急，天门金榜日华高。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23028,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"贡院次曹子真尚书韵二首 其二","author":"马祖常","text":"红绫饼餤出宫闱，赐宴恩荣玉殿西。\n白发词臣曾射策，榜名欣见武都泥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23029,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"和史参政韵","author":"马祖常","text":"五云天近昼香残，红白花枝满药阑。\n一夜东风吹小雨，殿头持卷隔帘看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23030,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯上京四绝 其一","author":"马祖常","text":"山雨晴时已是秋，苑中行殿日华浮。\n长杨十里旌旗宿，不使飞霜入画楼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23031,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯上京四绝 其二","author":"马祖常","text":"离宫秋草仗频移，天子长杨羽猎时。\n白雁水寒霜露满，骑奴犹唱蹋歌词。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23032,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯上京四绝 其三","author":"马祖常","text":"海国名鹰岂鹘胎，渥洼天马是龙媒。\n明时不惜黄金赐，只欲番王万里来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23033,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"丁卯上京四绝 其四","author":"马祖常","text":"持橐词垣已赐金，对衣侍拜更恩深。\n何如坐索长安米，只有诗歌满翰林。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23034,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"御沟春日偶成二首 其一","author":"马祖常","text":"御沟流水晓潺潺，直似长虹曲似环。\n流入宫墙才一尺，便分天上与人间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23035,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"御沟春日偶成二首 其二","author":"马祖常","text":"水南沙路雨清尘，桃李花开蛱蝶春。\n三月京华寒食近，东风十里酒旗新。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23036,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵中丞折枝图 其一 牡丹","author":"马祖常","text":"洛阳春雨湿芳菲，万斛胭脂染舞衣。\n帐底金盘承蜜露，东家蝴蝶不须飞。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23037,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"代悼亡为陈云峤作","author":"马祖常","text":"燕子楼空花不开，绣帘天晚月初来。\n手痕留在红牙板，犹有馀香妒落梅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23038,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王参政延福宫韵二首 其一","author":"马祖常","text":"蕊珠宫阙画云扉，么凤桐花白日飞。\n冰水藕丝清暑宴，偷桃方朔醉忘归。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23039,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"次王参政延福宫韵二首 其二","author":"马祖常","text":"唐家涨水望云亭，三月千花隔障屏。\n不似仙人华绿洞，双笙吹凤五芝庭。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23040,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吴娃图二首 其一","author":"马祖常","text":"金莲烛下看蛾眉，应是吴王半醉时。\n一自馆娃宫坏后，仙魂都上落花枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23041,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吴娃图二首 其二","author":"马祖常","text":"千两金盘浴小儿，玉钗双堕燕差池。\n绣窗白日无针线，却笑罗敷不画眉。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23042,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"吴宗师送牡丹","author":"马祖常","text":"十五年前花发时，仙翁邀赏醉瑶池。\n如今头白无情思，只见瑶池花满枝。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":23043,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]