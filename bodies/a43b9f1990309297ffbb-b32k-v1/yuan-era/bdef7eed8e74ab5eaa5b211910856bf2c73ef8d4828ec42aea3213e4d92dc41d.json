[{"title":"虞雍公诛蚊赋虞伯生书","author":"柯九思","text":"因读《诛蚊赋》，深怜爱国情。\n三公登间牒，四海失升平。\n早觉文章贵，争期德业成。\n云仍蒙世禄，翰墨负时名。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30150,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄鹤樵叟竹石","author":"柯九思","text":"风落湘江秋正波，重瞳消息竟如何？\n竹间犹有斑斑泪，应是英皇恨更多。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30151,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"黄大痴缥缈仙居图","author":"柯九思","text":"玉观仙台紫雾高，背骑丹凤恣游遨。\n双成不唤吹箫侣，阆苑春深醉碧桃。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30152,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"菊山诗赠吴兴黄君","author":"柯九思","text":"菊蕊逢秋放，山居可醉眠。\n落英攲石冷，佳色傍云鲜。\n旧摘烟萝外，新栽水竹边。\n思君多道味，何日共攀缘。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30153,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"岳王墓","author":"柯九思","text":"结发行间见此公，两河忠义俟元戎。\n勋成伊吕终方驾，算胜孙吴亦下风。\n拂剑未酬千古辱，赐环空坏十年功。\n奸邪卖国堪流涕，独立西风看去鸿。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30154,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"方方壶云林图","author":"柯九思","text":"仙人危太朴，屏迹云林间。\n河车运金液，九转成大还。\n苦辛三十载，得道鬓已斑。\n弱水政清浅，蓬莱那可攀。\n娇娥贮金屋，霜露零秋山。\n勿猜松柏操，不及桃李颜。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30155,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王叔明双松图","author":"柯九思","text":"碧眼支郎耳更聪，轩楹占断白云中。\n有声听到无声处，错认长松是老龙。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30156,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"玉山佳处","author":"柯九思","text":"神人夜斧开清玉，一片西飞界溪曲。\n中有桃源小洞天，云锦生香护华屋。\n主人意度真神仙，日日醉倒春风前。\n手挥白羽扇，口诵青苔篇。\n袖拂剑山云，足蹑蓝田烟。\n飘飘直向最佳处，漱润含芳掔琪树。\n世间回首软尘红，不须更向蓬莱去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30157,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵鸥波古木竹石图","author":"柯九思","text":"水晶宫里人如玉，窗瞰鸥波可钓鱼。\n秀石疏林秋色满，时将健笔试行书。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30158,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题高尚书秋山暮霭图","author":"柯九思","text":"三代以来推盛世，九州之外有斯人。\n君看笔底生秋色，尽在潇潇楚水滨。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30159,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题倪幻霞良常草堂图","author":"柯九思","text":"幽馆晓山如沐，断桥春水初生。\n花下班荆酒熟，松间散策诗成。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30160,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李思诲柳浪轻舟小景","author":"柯九思","text":"晓烟如幕柳垂丝，曲曲春塘望欲迷。\n一个轻舟仍载酒，赤栏桥外听莺啼。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30161,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"杨升蓬莱飞雪图","author":"柯九思","text":"仙山一夕遍琼瑶，万木森森长玉苗。\n处处楼台相掩映，素娥白鹤正逍遥。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30162,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"荆浩秋山仙侣图","author":"柯九思","text":"奇峰回合映林光，霜气殷殷满竹房。\n知有高人山外住，故携绿绮入崇冈。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30163,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"卢鸿蓬岛仙游图","author":"柯九思","text":"苍崖千仗有云封，刘阮何来策短筇。\n行过石桥看急涧，一声野鹤出长松。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30164,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"韩干双马图","author":"柯九思","text":"渥洼自昔产龙媒，何事开元万骑回。\n千载韩公称入室，恐惊风雨未应开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30165,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题危太朴所藏荥阳郑虔画秋峦横霭图","author":"柯九思","text":"虎头昔日称三绝，孰谓新图见郑虔。\n紫翠虚无晴嶂里，青红掩映夕阳前。\n从知嘉赏归明主，应许神工迈昔贤。\n满目秋光无著处，此身疑在碧云巅。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30166,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题危太朴所藏李昭道画春江图次苏东坡韵","author":"柯九思","text":"春江淼漫百叠山，晴烟笼山山吐烟。\n望君拄笏聊聘望，但见一气长苍然。\n千章绿树倚茅屋，复有涧谷奔寒泉。\n商舸迎阳泊沙岸，布帆吹籁弥平川。\n李侯生前得此景，骨格夐出探微前。\n胸中八九小云梦，笔底万顷沧浪天。\n铅丹金碧世希有，晶瑩不让蓬瀛妍。\n江楼掩映临江碧，时见轻鸥落渚田。\n此图此景有神护，小住人间七百年。\n摩挲绢素开黯淡，飞舞妙思藏便娟。\n卧游斋头一展看，恍若身对湘巫眠。\n鼎湖髯挂李侯去，飘然久作芙蓉城内仙。\n邹阳后身薄自晓，舍我谁结三生缘。\n呜呼江烟幻灭在俄顷，短词聊次东坡篇。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30167,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题荆洪谷楚山秋晚图","author":"柯九思","text":"峰迥留深隐，天青袭素袍。\n栖身断人迹，游目送鸿毛。\n树挂栖崖鸷，藤悬饮子猱。\n龙眠石涧冷，虎撼树根牢。\n野客吟时共，山翁弈处遭。\n浮云过水尽，孤月挟霜高。\n羽使来三岛，胎仙舞九皋。\n左招玉斧饮，右揽赤松邀。\n空色收寥廓，虚声起驿骚。\n弹琴遗古散，问字度危桥。\n遂向图中见，谁能世外逃？\n乘槎几月至，一泛九秋涛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30168,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵干春林曲坞图","author":"柯九思","text":"风暖柳仍绿，春晴花更浓。\n高低茅屋静，远近碧溪通。\n亭白分湖色，山青隔岸容。\n村翁无俗虑，相过说年丰。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30169,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄荃蜀江秋净图","author":"柯九思","text":"蜀江昨夜雨初歇，两岸青山净如拭。\n疏柯历历间青红，古渡何人相向立。\n扁舟咿哑过江来，酒家犹掩门未开。\n数声鸡犬知谁处？\n浩渺东流不复回。\n万竿修竹鸣苍玉，怪石巉岩倚茅屋。\n惊涛震荡战马奔，不动山翁卧深谷。\n江山尽属掌中看，画图莫作寻常观。\n成都要叔留妙笔，一缣秀色若可餐。\n堪叹宣和藏匪固，杜鹃啼断天津路。\n何知散落向人间，犹藉清容加袭护。\n吾侬幸尔相遭逢，谁数当年有项容？\n临窗展对未能已，祇觉飒飒来松风。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30170,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题吴瑩之所藏郭忠恕画册","author":"柯九思","text":"恕先非漫士，却儗阆瀛仙。\n资禀山灵秀，胸罗锦绣妍。\n居周声誉重，仕宋位名迁。\n篆隶宗前哲，丹青迈昔贤。\n观楼殊壮丽，云水自澄鲜。\n泉落千重壁，峰回万井烟。\n春秋仍变幻，挥洒更悠然。\n啄木藏深树，鸱夷钓碧川。\n歌声振林表，笑语出花前。\n御舸乘红粉，扶留挂绿钱。\n素缣盈咫尺，妙境总堪怜。\n一入宣和袭，千秋取次传。\n故人持过慧，续尾愧残编。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30171,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"李成江村秋晚图","author":"柯九思","text":"万壑秋风木欲空，流泉屈曲竹丛丛。\n山家已露炊烟白，鸟雀初归夕照红。\n篱落喜无车马迹，柴门时有故人踪。\n桃源渔父知何处？\n未若兹图景最工。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30172,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"王晋卿万壑秋云图","author":"柯九思","text":"千山回合平原少，云去云来忘昏晓。\n绝涧奔飞万壑雷，丹枫萧瑟一林鸟。\n独坐长吟是阿谁，蹇驴骚客行迟迟。\n何来征舸江头泊，无限秋光属尔为。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30173,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题郭忠恕夏山仙馆图","author":"柯九思","text":"碧树沈沈覆草塘，湘帘齐揭藕风凉。\n人间无地逃炎暑，安得移家住上方。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30174,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉题文与可十竹图二首 其一","author":"柯九思","text":"过雨湘江翠羽攒，舞风清影玉声寒。\n当时嵇阮人何处，留得高标咫尺看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30175,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"奉题文与可十竹图二首 其二","author":"柯九思","text":"湖州仙去几经年，十竹新图属世传。\n点点墨花金错乱，离离月影凤翎鶱。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30176,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵令穰秋村暮霭图四首 其一","author":"柯九思","text":"远岫千重青似染，平林一望锦成堆。\n回塘渔艇不归去，溪上数家门半开。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30177,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵令穰秋村暮霭图四首 其二","author":"柯九思","text":"溪上数家门半开，村翁傍晚却归来。\n霜林掩映芙蓉色，秋水微茫鸿雁哀。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30178,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵令穰秋村暮霭图四首 其三","author":"柯九思","text":"秋水微茫鸿雁哀，短桥曲渚锦林开。\n疏林欲下斜阳色，一抹青山入望来。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30179,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵令穰秋村暮霭图四首 其四","author":"柯九思","text":"一抹青山入望来，满林秋色总诗材。\n宣和当日珍天府，未许骚人费品裁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30180,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"米芾真迹","author":"柯九思","text":"树色模糊藓径平，人家只隔水泠泠。\n白云不解巃嵷去，远却峰峦一半青。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30181,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵千里画长幅","author":"柯九思","text":"神区何处有此山，盘回耸峙如髻鬟。\n安期曾于此鍊液，琼柯郁秀非尘寰。\n白云拥户不须掩，紫雾临窗未许关。\n朱楼缥缈足舒眺，虚亭幽绝时跻攀。\n珠帘轻揭青鸾舞，画舸徐牵白鹤还。\n溪回时有飞琼度，桥迥常凭弄玉扳。\n绛桃乱落无人扫，瑶草丛生若个删。\n山中胜概何可数，流泉㶁㶁空潺湲。\n谁能摹写长图好，伯驹笔妙趣自閒。\n固知作者有深思，展卷情驰未拟还。\n先生寤寐何时已，晴窗对阅娱心颜。\n陶贞白，在何处，胡不同来此中住。\n仙家自昔忘岁年，长啸拂衣自来去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30182,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵千里画八幅","author":"柯九思","text":"数幅晴云翠岫，千重碧树琼楼。\n羡杀承平公子，笔端万里瀛洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30183,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题马远虚亭渔篴图","author":"柯九思","text":"五月江南雨乍晴，看山如在画中行。\n隔溪帘幕初飞燕，灌木池塘独听莺。\n暑向昨宵风雨尽，诗从今日簟纹成。\n昼长睡起无何事，蓦送沧浪渔笛声。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30184,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题危太朴集八大家","author":"柯九思","text":"诸君挥染映空碧，十日一水五日石。\n春山秋树绿更红，板桥野屋横且直。\n烟云蓊郁风雨交，夏木重重气犹湿。\n山花若笑山鸟鸣，五马骁腾仅盈帙。\n古岸疏林秋气清，石涧飞流疑咫尺。\n老来看画眼枯涩，便拟买田溪水侧。\n脱去赐带系芒屐，著书五车刻苔壁。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30185,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题邓善之集十大家","author":"柯九思","text":"展画能销夏，何如此更深。\n匡庐云互涌，湘水雨生阴。\n粉艳知春色，林疏识暮心。\n羡君幽致好，不必费遐寻。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30186,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久为姚子章卷","author":"柯九思","text":"空岩花落满林香，古殿松阴入座凉。\n清绝右丞名独擅，精妍北苑派何长。\n寂无鸡犬鸣晴昼，时有烟云绕上方。\n赖是一峰传正脉，故将冲澹洗浓妆。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30187,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久为徐元度卷","author":"柯九思","text":"一峰老人嗜泉石，八尺素缣写秋色。\n顿使窗头开翠微，复令箧里流丹碧。\n翩翩逸兴殊未已，更拨苔文青可指。\n摆脱骊黄见神骏，洗尽铅华出西子。\n徐君那得不破颜，此身如坐清泠间。\n未损嘉宾一日橐，买尽沃州千万山。\n吴中好事家相属，得陇何人堪望蜀。\n断无明月映连城，或可昆冈矜片玉。\n君不见开元王右丞，南唐董北苑。\n丹青一片流至今，前辈风神更超远。\n一峰固是餐霞侣，知音未敢轻舒卷。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30188,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久吴门秋色图","author":"柯九思","text":"幽人来往吴中道，独掉秋风海上仙。\n何处归帆频倚岸，几家茆屋傍流泉。\n水禽款款集深渚，夕照霏霏媚远天。\n点笔忽惊埃壒外，恍疑身在辋川边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30189,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题梅道人为伯理十幅","author":"柯九思","text":"云溪吴仲岂凡俦，写得湖山数幅秋。\n良夜漏沈呼剪烛，不知风雨下前洲。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30190,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题曹云西画卷","author":"柯九思","text":"东吴高士云西客，爱染长笺浅深墨。\n空濛不记山几重，万树疏烟气犹湿。\n渔人举网溪流清，野老何来款素情。\n上方钟磬出云表，归帆影落空江明。\n前村鸡犬日已暮，黄叶秋风满山路。\n个中妙境压古人，三复摩挲未能去。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30191,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题董北苑画","author":"柯九思","text":"树密重重万壑深，清溪决决更穿林。\n行人曳杖频回首，隔岸黄鹂送好音。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30192,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题李成秋山图","author":"柯九思","text":"萧萧木叶落欲尽，渺渺洞庭生白波。\n杜老因悲秋事晚，山翁斜日望苍螺。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30193,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题王晋卿钓鱼图","author":"柯九思","text":"雨歇见春山，菰蒲第几湾。\n鸥来又飞去，只有钓舟閒。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30194,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵千里春景","author":"柯九思","text":"朱楼不识有春寒，隔岸何人尽日看。\n为惜年光同逝水，肯教桃李等閒残。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30195,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵伯骕画","author":"柯九思","text":"车辙辚辚过别山，满林霜叶映红颜。\n晚来仍起云千叠，一片幽閒指顾间。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30196,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"赵子昂画夏景仿王摩诘次韵为袁清容学士","author":"柯九思","text":"山楼开处映晴霞，消夏虚明水阁斜。\n云影倒窗思泳藻，松风吹落鸟衔花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30197,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵子昂仿张僧繇笔意","author":"柯九思","text":"寒云淰淰碧峰攒，木叶惊风下急湍。\n何处山人残照里，罢琴犹向隔江看。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30198,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题赵仲穆画","author":"柯九思","text":"草堂仍著薜萝遮，地僻林深有此家。\n只道春风吹不到，门前依旧落松花。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30199,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久海岳庵图","author":"柯九思","text":"元章翰墨世称良，近代痴翁更擅长。\n海岳尚馀清胜在，一江秋色两微茫。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30200,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄子久虞峰秋晚图为太朴先生","author":"柯九思","text":"古树尽归秋色里，人家常在水声中。\n数行旅雁入云去，一簇招提倚碧空。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30201,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题黄鹤山樵剑阁图","author":"柯九思","text":"天梯石栈自相钩，造物玄功笔底偷。\n挂起碧窗相对处，满堂风色剑关秋。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30202,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画","author":"柯九思","text":"古木槎牙知几年，一丛修竹翠依然。\n空山莫道多寥落，自有春风到日边。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30203,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画二首 其一 白头","author":"柯九思","text":"春浓不放小禽栖，白发冲冠向晓啼。\n帘幕半开人未起，楼台风暖日犹低。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30204,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题画二首 其二 黄鹏","author":"柯九思","text":"春风娇软绿阴肥，上苑莺花紫翠围。\n却向后宫深院里，一枝閒自理金衣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30205,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"对月","author":"刘致","text":"凉霄在前墀，佳月堕我侧。\n此月如此心，旷朗一片白。\n开尊起相娱，佳月即佳客。\n月如感知己，为我好颜色。\n此时还独醒，奈此明月夕。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30206,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"题钱玉潭竹林七贤图","author":"刘致","text":"门巷寡辙迹，静对溪南竹。\n溪水净堪染，竹色与分绿。\n有时澹相向，襟抱如瑩玉。\n安得万苍筤，遮植青溪曲。\n岂无嵇阮辈，遁世尊往躅。\n浩歌日酣燕，达生亦云足。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30207,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"青楼曲","author":"刘致","text":"峭寒暗袭云蓝绮，鲛帐愔愔夜如水。\n美人骨醉红玉软，满眼春酣不忺起。\n幽禽关关唤霜曙，金壁屠苏溢香雾。\n有生只合老温柔，璧月长教挂璚树。\n鸳鸯同心暗中结，满意芳兰煖红雪。\n痴云騃雨自年年，不管人间有离别。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30208,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"秋雨吟","author":"刘致","text":"湿萤闪光飞不起，八尺风漪夜如水。\n仙姝不眠肌骨清，起驭夜凉吹玉笙。\n曲中忽作孤凤鸣，天帝感泣秋雨零。\n旱龙暍死嗟莫及，坐见扶桑落叶湿。\n前溪水高龙夜吟，不管西郊老农泣。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30209,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"淮南歌","author":"刘致","text":"甓社湖中出明月，斯须千山万山白。\n烛龙驰影不敢眠，淮上风烟黯无色。\n鼪鼯起啼鳅鳝舞，荷风惊涛战南浦。\n湖天无光湖水立，夜半行空洒飞雨。\n东方摇摇天欲曙，毕逋啼老扶桑树。\n淮天幽幽澹空素，老蚌潜辉寂无处。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30210,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"古采莲曲","author":"刘致","text":"长安女儿淑且浓，日日采莲溪水中。\n笑插荷花照溪水，韶容欲与花争红。\n溪中荷花深几许，溪上时时闻笑语。\n红酣绿缛不见人，应在荷花更深处。\n归时夜凉溪水清，扣舷踏歌荡桨行。\n荷叶盖头花㔩鬓，溪上月明潮已平。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30211,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"望夫石","author":"刘致","text":"望夫山头日欲颓，望夫山下江声哀。\n山头日日风雨恶，江上不见行人回。\n空山亭亭几朝暮，独记行人去时路。\n知君渡河长不归，恨不当年逐君去。\n此身化石千仞矶，石犹可转心不移。\n长江水涸黄埃飞，行人应有归来时。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30212,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}},{"title":"姑苏台","author":"刘致","text":"麋鹿应知易代频，《吴趋》谁唱不堪闻。\n捧心台暗梨花月，抉目门深薜荔云。\n江阅水犀欧冶剑，气腾金虎阖庐坟。\n计然己死鸱夷逝，寂寞五湖西日曛。","collection":"元","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元.csv","pointer":30213,"sha256":"83a9b19069eb9d0a23ec0c2824878cf918a857896ec1ca33cebdf7438cc165a8","dynasty":"元"}}]