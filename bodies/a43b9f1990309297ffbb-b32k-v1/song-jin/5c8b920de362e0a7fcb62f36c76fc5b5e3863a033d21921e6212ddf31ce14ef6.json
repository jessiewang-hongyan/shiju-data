[{"title":"中秋觅酒","author":"宇文虚中","text":"今夜家家月，临筵照绮楼。\n那知孤馆客，独抱故乡愁。\n感激时难遇，讴吟意未休。\n应分千斛酒，来洗百年忧。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":128,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其一 春","author":"宇文虚中","text":"短草铺茸绿，残红照雪稀。\n暖轻还锦褥，寒峭怯罗衣。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":129,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其二 春","author":"宇文虚中","text":"翠涟冰绽日，香径晚多花。\n细笋抽蒲密，长条舞柳斜。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":130,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其三 春","author":"宇文虚中","text":"折花幽槛小，倾酒绿杯深。\n蝶舞轻风晓，莺啼老树阴。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":131,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其一 夏","author":"宇文虚中","text":"翠密围窗竹，青圆贴水荷。\n睡多嫌昼永，醒少得风和。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":132,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其二 夏","author":"宇文虚中","text":"草径迷深绿，莲池浴腻红。\n早蝉鸣树曲，鲜鲤跃潭东。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":133,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其三 夏","author":"宇文虚中","text":"暴雨随云骤，惊雷隐地平。\n好风摇箑透，轻汗挹冰清。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":134,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其一 秋","author":"宇文虚中","text":"晚日欣帘捲，凉风觉袂摇。\n远吟高兴遣，长醉宿愁销。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":135,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其二 秋","author":"宇文虚中","text":"短苇低残雨，虚舟带晚潮。\n断鸿归暗浦，疏叶堕寒梢。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":136,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其三 秋","author":"宇文虚中","text":"戚戚蛬吟苦，茫茫水驿孤。\n日衔山色莫，霜带菊丛枯。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":137,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其一 冬","author":"宇文虚中","text":"鹘健呼风急，乌啼促景残。\n窟深宜兔蛰，蒲折荫鱼寒。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":138,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其二 冬","author":"宇文虚中","text":"裂瓦寒霜重，铺窗月影清。\n灭灯惊好梦，孤枕念深情。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":139,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"四序回文十二首 其三 冬","author":"宇文虚中","text":"秀柏留阴绿，芳梅蘸影斜。\n溜檐冰结玉，装树雪飞花。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":140,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"灯碑五首 其一","author":"宇文虚中","text":"清阴霭霭匝城闉，万井熙熙桃杏春。\n紫陌传呼旌旆出，重臣新佩玉麒麟。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":141,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"灯碑五首 其二","author":"宇文虚中","text":"钿轴天章拜异恩，驿骖花骑映朝暾。\n手持禁钥千门肃，官压东宫二品尊。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":142,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"灯碑五首 其三","author":"宇文虚中","text":"垒原清照白登山，弥陇连天麦浪寒。\n剑戟渐销农器出，人家只识劝农官。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":143,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"灯碑五首 其四","author":"宇文虚中","text":"九夏南风入舜琴，恩风泽雨浃飞沈。\n陪京最是仪形地，先识君王解愠心。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":144,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"灯碑五首 其五","author":"宇文虚中","text":"枹鼓无声讼狱空，欢谣击壤万家同。\n时人共解班春意，兵寝刑清第一功。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":145,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"馆中书事","author":"宇文虚中","text":"雨来蒸郁似江乡，雨过西风特地凉。\n尚有庭花共客恨，可无尊酒慰幽芳。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":146,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"时习斋","author":"宇文虚中","text":"未厌平生习气浓，更将馀事训儿童。\n鲁论二万三千字，悟入从初一句中。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":147,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"醉经斋","author":"宇文虚中","text":"傍人但笑腹便便，枕藉诗书正昼眠。\n不识先生真悟处，未离文字已逃禅。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":148,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"醉墨斋","author":"宇文虚中","text":"旋汲清泉起縠纹，定知娄永是前身。\n个中自可逃真性，不用淋漓污葛巾。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":149,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"乌夜啼","author":"宇文虚中","text":"汝琴莫作归凤鸣，汝曲莫裁白鹤怨。\n明珠破璧挂高城，上有乌啼人不见。\n堂中蜡炬红生花，门前绀幰七香车。\n博山夜长香烬冷，悠悠荡子留倡家。\n妾机尚馀数梭锦，织恨传情还未忍。\n城乌为我尽情啼，知道单栖泪盈枕。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":150,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句","author":"宇文虚中","text":"有人若问南冠客，为道西山赋蕨薇。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":151,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"山中见桃花李花","author":"吴激","text":"锦里春风遍海棠，别时无计奈红芳。\n山中桃李浑疑晚，犹有残红断客肠。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":152,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"长安怀古","author":"吴激","text":"佳气犹能想郁葱，云间双阙峙苍龙。\n春风十里灞陵树，晓月一声长乐钟。\n小苑花开红漠漠，曲江波涨碧溶溶。\n眼前叠嶂青如画，借问南山共几峰。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":153,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"宿湖城簿厅","author":"吴激","text":"日迟风暖燕飞飞，古柳高槐面翠微。\n卷上疏帘无一事，满池春水照蔷薇。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":154,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"穷巷","author":"吴激","text":"穷巷无来辙，贫家有旧醅。\n窗明怜雪在，睡美觉春回。\n菜甲方齐拆，梅花亦半开。\n茅檐鸣好鸟，节物莫相催。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":155,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"偶成二首 其一","author":"吴激","text":"一番瘦笋羽林枪，松架阴阴尽日凉。\n绕屋云烟无定态，连山草木有真香。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":156,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"偶成二首 其二","author":"吴激","text":"蟹汤兔盏斗旗枪，风雨山中枕簟凉。\n学道穷年何所得，只工扫地与焚香。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":157,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"病后寄开甫","author":"吴激","text":"暗蛩咽幽响，隙月漏微光。\n溪上风雨过，翛然有馀凉。\n病瘦鹤骨立，低垂不能翔。\n怀我中山兄，开经焚道香。\n猿啸耿清夜，钟鸣悠夕阳。\n商秋早晚至，梦寐松楸苍。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":158,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"过南湖偶成","author":"吴激","text":"杏山松桧紫坡陀，湖面无风亦自波。\n绿鬓朱颜嗟老矣，落花啼鸟奈春何。\n诗人未必皆憔悴，世事从来有折磨。\n列坐流觞能几日，知谁对酒爱新鹅。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":159,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"夜汎涡河龙潭","author":"吴激","text":"轻舟弄素月，静夜横清涡。\n天风毛发乱，疏星灿明河。\n图经记父老，冥寞年岁多。\n渊沈三千丈，湛碧寒无波。\n微流带文藻，绝岸无柔莎。\n炯如帝鸿镜，可鉴不可磨。\n中蟠至神物，役使群蛟鼍。\n蜿蜿头角古，劲鬣谁敢劘。\n深宫照珠贝，颇费蚌与螺。\n何时葛陂竹，化作陶公梭。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":160,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"秋兴","author":"吴激","text":"后园杂树入云高，万里长风夜怒号。\n忆向钱塘江上寺，松窗竹阁瞰秋涛。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":161,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"岁莫江南四忆 其一","author":"吴激","text":"瘦梅如玉人，一笑江南春。\n照水影如许，怕寒妆未匀。\n花中有仙骨，物外见天真。\n驿使无消息，忆君清泪频。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":162,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"岁莫江南四忆 其二","author":"吴激","text":"天南家万里，江上橘千头。\n梦绕阊门迥，霜飞震泽秋。\n秋深宜映屋，香远解随舟。\n怀袖何时献，庭闱底处愁。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":163,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"岁莫江南四忆 其三","author":"吴激","text":"吴淞潮水平，月上小舟横。\n旋斫四腮鲙，未输千里羹。\n捣齑香不厌，照箸雪无声。\n几见秋风起，空悲白发生。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":164,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"岁莫江南四忆 其四","author":"吴激","text":"平生把螯手，遮日负垂竿。\n浩渺渚田熟，青荧渔火寒。\n忆看霜菊艳，不放酒杯乾。\n比老垂涎处，糟脐个个团。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":165,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"述怀","author":"吴激","text":"旅食空弹铗，归休合挂冠。\n烟尘榆塞远，风雨麦秋寒。\n巢燕长如客，鸣蛙不属官。\n柴门江涨到，落日下渔竿。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":166,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"喜晴和张鲁瞻","author":"吴激","text":"原野恍新沐，丰隆宁世情。\n鸟归林霭暝，楼射涧虹明。\n春草牛羊远，人家机杼鸣。\n惨舒长有命，谁复问阴晴。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":167,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"国公女生日席上命赋","author":"吴激","text":"雪射瑶阶月，春回玉女扉。\n云中三秀草，石上六铢衣。\n酒熟鹅儿色，身轻燕子飞。\n客槎还汎斗，谁解卜支机。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":168,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"秋夜","author":"吴激","text":"岂有涓埃补盛明，强扶衰病厕豪英。\n夜窗灯火青相对，晓镜髭须白几茎。\n年去年来还似梦，江南江北若为情。\n石田茅舍君家近，借与林泉送此生。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":169,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"招赵资深拾遗","author":"吴激","text":"别久貌逾壮，道同心更亲。\n移居近韦杜，相对邈参辰。\n雪少似饶客，鸟喧知得春。\n归期淹几日，莫厌马蹄频。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":170,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"张戡北骑","author":"吴激","text":"张生鞍马客幽都，却笑灵光笔法粗。\n祗今白首风沙里，忆向江南见画图。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":171,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"鸡林书事","author":"吴激","text":"箕子朝鲜僻，蓬丘弱水宽。\n儒风通百粤，旧史记三韩。\n邑聚从衡接，民居质朴安。\n犹存古笾豆，兼用汉衣冠。\n兔颖家工缚，鲑腥俗嗜餐。\n骑兵腰玉具，府卫挟金丸。\n长袖鸢窥肉，都场狖挂竿。\n琴中蔡氏弄，指下祝家弹。\n主礼分庭抗，宾筵百拜难。\n渍橙粇酿旨，滋桂鹿脩乾。\n泼墨松如栉，隤墙石似丹。\n地偏先日出，天迫众山攒。\n鹏翼云帆远，羊肠石磴盘。\n由来异文轨，休讶变暄寒。\n事可资谈柄，谁能记笔端。\n聊将诗貌取，归作画图看。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":172,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其一","author":"吴激","text":"春风蜀栈青山尽，晓日秦川绿树平。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":173,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其二","author":"吴激","text":"烟拂柳梢留淡白，云蒸山腹出深青。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":174,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其三","author":"吴激","text":"山侵平野高低树，水接晴空上下星。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":175,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其四","author":"吴激","text":"玉座烟霞春寂寂，石坛星斗夜苍苍。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":176,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其五","author":"吴激","text":"手版西山聊复尔，角巾东第定何时。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":177,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其六","author":"吴激","text":"竹院鸣钟疑物外，画桥流水似江南。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":178,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其七","author":"吴激","text":"数树残花喜春在，一声啼鸟觉山深。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":179,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其八","author":"吴激","text":"玉雪自知尘不涴，丹青难写酒微醺。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":180,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其九","author":"吴激","text":"四海苍生谢安石，一言宣室贾长沙。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":181,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其十","author":"吴激","text":"海东绝域皇华使，天上仙官碧落卿。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":182,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其十一","author":"吴激","text":"江湖攲枕梦，风雪打窗时。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":183,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"沙边","author":"张斛","text":"晚雨涨平堤，沙边独杖藜。\n长风催雁北，众水避潮西。\n楚客相逢少，吴天入望低。\n故园无路到，春草自萋萋。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":184,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"东川春日","author":"张斛","text":"巴蜀三年客，江湖万里情。\n沧波何处尽，归棹几时行。\n世态浮云变，春愁细草生。\n群山遮望眼，片月上高城。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":185,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"巫山对月怀湖外亲友","author":"张斛","text":"众壑敛新雨，孤舟增暮寒。\n巫山今夜月，湘水几人看。\n不得临湖醉，惟愁下峡难。\n双鱼凭寄远，尺素劝加餐。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":186,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"武陵春雪","author":"张斛","text":"天风吹雪满千山，不见桃花汎碧澜。\n洞里仙人贪种玉，岂知人世有春寒。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":187,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"高寺","author":"张斛","text":"高寺鸣钟后，孤舟落雁边。\n已知归径晚，故就上方眠。\n石峻溜声急，月高松影圆。\n明朝下烟霭，回首阻清川。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":188,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"寓中江县楼","author":"张斛","text":"武江斜转石，文岫独参天。\n绿涨他山雨，青浮近市烟。\n松薪炊白粲，水蔓系红鲜。\n自喜飘蓬迹，安居过两年。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":189,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"回文二首 其一","author":"张斛","text":"野旷悲行客，湍惊碍去船。\n夜江清汎月，秋草碧连天。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":190,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"回文二首 其二","author":"张斛","text":"绿径斜萦草，红梢半落花。\n曲池风碎月，攲岸雨摧沙。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":191,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"仙门驿听泉","author":"张斛","text":"一亭围古木，双涧泻清流。\n行到云山暮，卧闻风雨秋。\n客尘何日浣，病渴此时瘳。\n归去南溪上，轻舟细浪浮。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":192,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"夜雨南山","author":"张斛","text":"雨夜宿山斋，夜深雨声息。\n石室含馀清，风枝堕残滴。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":193,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"平安关道中二首 其一","author":"张斛","text":"高林俯青冥，柯叶森若织。\n阳光已转午，阴岭仍半黑。\n峥嵘乱石间，行子有苦色。\n临深地势入，涉险天宇塞。\n四顾无所投，迹茧去未息。\n怅然增百忧，冥冥羡归翼。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":194,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"平安关道中二首 其二","author":"张斛","text":"穷冬十日阴，积雪千山路。\n晴云开半岭，落日犹在树。\n悠悠客心速，惨惨天色暮。\n寒鸟各有依，解鞍尚无处。\n游鱼误衔钩，玄豹终隐雾。\n行行谢冠冕，复我林壑趣。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":195,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"还家","author":"张斛","text":"云林无俗姿，相对可终老。\n如何尘中人，不见青山好。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":196,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"访香林老","author":"张斛","text":"风雨无时浪蹴天，南浮舟楫信多艰。\n半生梦破寒江月，万里春回故国山。\n归客自伤青鬓改，高僧长共白云闲。\n诛茅借我溪西地，未厌相从水石间。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":197,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"小孤山","author":"张斛","text":"天围秋涨阔，山背夕阳孤。\n岸树晴犹湿，汀烟近却无。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":198,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其一","author":"张斛","text":"云开千里月，风动一天星。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":199,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}}]