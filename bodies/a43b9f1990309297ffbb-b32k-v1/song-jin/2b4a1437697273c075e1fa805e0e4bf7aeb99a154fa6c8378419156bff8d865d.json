[{"title":"杂诗二首 其一","author":"王予可","text":"白露沙滩浸绿湄，小舟舣岸尚依稀。\n山回屏曲江连树，春锁人家深处归。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":1,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"驯鹤图","author":"王予可","text":"寝处妆铅未捲钗，孤云花带月边来。\n六宫帘幕金鸾冷，露湿晨烟啄翠苔。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":2,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"南园湖石","author":"王予可","text":"翠雀衔云堕翠芜，砥峰倒影卧平湖。\n飞花不到穿帘月，高倚晴天一剑孤。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":3,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"宫体 其二","author":"王予可","text":"骄马金笼藉草归，翠鸾屏曲染红霏。\n凭栏山色春风里，唤得莺儿燕子飞。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":4,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"宫体 其一","author":"王予可","text":"红叶铺霜撼御阶，绣莲尘蹴衬罗鞋。\n袖沾莺翅调簧语，堕却衔翘入鬓钗。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":5,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"宫词","author":"王予可","text":"水曲朱门漪漾漫，一帘花雨月波寒。\n金闺背衬鸳鸯冷，春困秋千立画干。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":6,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"题灵隐寺","author":"王予可","text":"游山无处浣尘埃，出郭寻幽入翠苔。\n众水尽从双涧去，一峰元自五天来。\n行春人散题名在，坐夏僧閒听讲回。\n清磬一声猿鸟寂，石楠花落满经台。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":7,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其十二","author":"王予可","text":"凤环捧席带香屏，鲸杯倚伎和云捲。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":8,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其三","author":"王予可","text":"一壶天地醒眠小。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":9,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其六","author":"王予可","text":"唾尖绒舌淡红甜。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":10,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其十","author":"王予可","text":"帘捲绿阴花外月，玉山冰雪醉扶翁。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":11,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其二","author":"王予可","text":"壶树苔波月渍皴。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":12,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其一","author":"王予可","text":"石裂雯华渍月秋。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":13,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其五","author":"王予可","text":"风色偃貂裘。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":14,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其十一","author":"王予可","text":"啼鸟倒衔金羽舞，惊蛇斜傍玉帘飞。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":15,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其七","author":"王予可","text":"金盆水不暖，翠雀啄晴苔。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":16,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其八","author":"王予可","text":"凤蹴瑶华散，龙衔桂子香。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":17,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其九","author":"王予可","text":"一片冷截潭底月，六弯斜卷陇头云。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":18,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"过白沟趁顺安","author":"刘著","text":"万折狂澜肯倒流，归心梦寐在东周。\n平生快意君知否，今日驱车过白沟。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":19,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"伯坚惠新茶绿橘香味郁然便如一到江湖之上戏作小诗二首 其二","author":"刘著","text":"黄苞犹带洞庭霜，翠袖传看绿叶香。\n何待封题三百颗，只今诗思满江乡。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":20,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"伯坚惠新茶绿橘香味郁然便如一到江湖之上戏作小诗二首 其一","author":"刘著","text":"建溪玉饼号无双，双井为奴日铸降。\n忽听松风翻蟹眼，却疑春雪落寒江。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":21,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"送客亭","author":"刘著","text":"十年羁旅鬓成丝，千里淮山信息稀。\n送尽长亭短亭客，且看庄舄几时归。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":22,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"闺情二绝 其二","author":"刘著","text":"蕙帐金炉冷篆烟，故山春草几芊芊。\n只今唯有潇湘月，万里相随照不眠。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":23,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"闺情二绝 其一","author":"刘著","text":"天边北斗又回春，愁绝龙沙任酒醺。\n万里巫山归梦断，不知何处觅行云。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":24,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"顺安辞呈赵使君二首 其二","author":"刘著","text":"六朝兴废渡河年，旧国归来更黯然。\n八月边城山未雪，芦花籍藉已漫天。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":25,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"顺安辞呈赵使君二首 其一","author":"刘著","text":"太平时世屡丰年，胜事空闻父老传。\n郭外桑麻知几顷，船头鱼蟹不论钱。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":26,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"病中寄楚卿","author":"刘著","text":"月满江楼午夜钟，多情多病一衰翁。\n行云不道无行雨，只恐相逢是梦中。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":27,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"文季侍郎得绿萼香梅子文待制有诗辄亦同赋","author":"刘著","text":"一枝绿萼冠群芳，潇洒犹疑楚岸傍。\n香骨瘦来冰蕊细，梦魂清处月波凉。\n赓酬便合成千首，醒醉宁须计百觞。\n横玉叫云吹不尽，只教今古洗离肠。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":28,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"出榆关","author":"刘著","text":"羽檄中原满，萍流四海间。\n少时过桂岭，壮岁出榆关。\n奇祸心如折，羁愁鬓已斑。\n楚累千万亿，知有几人还。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":29,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"再和彦高","author":"刘著","text":"否泰由来在岁星，谁听叩角作商声。\n一朝汉魏成今古，百口燕秦隔死生。\n雉堞仅能逃病妇，雁书犹记作团兄。\n雪云埋尽辽西路，有酒如淮奈此情。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":30,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"次韵王子慎玉田道中一首兼呈韩公美阁老","author":"刘著","text":"东晋风流属子猷，开元峭直让韩休。\n丝纶对掌惊三隽，尊酒更酬失四愁。\n古道阴阴槐树老，归鸿杳杳荻花秋。\n浩然诗思天涯远，月满江南小谢楼。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":31,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"次韵彦高暮春书事","author":"刘著","text":"平生漫浪老清晖，却扫丘园属少微。\n世乱伤心青眼旧，天涯流泪白云飞。\n羁愁只忆中山酒，贫病长悬子夏衣。\n泽畔行吟谁念我，祗应形影自相依。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":32,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"至日","author":"刘著","text":"乱离南国忽经年，一线愁添未死前。\n心折灵台候云物，眼看东海变桑田。\n燕巢幕上终非计，雉畜樊中政可怜。\n安得绝云行九万，却骑鲸背上青天。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":33,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"枕上言怀","author":"刘著","text":"九土将分裂，中原政扰攘。\n孰为真汉相，却忆假齐王。\n晋室迁神鼎，梁园作战场。\n可怜羁客梦，夜夜在家乡。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":34,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"病中言怀呈韩给事","author":"刘著","text":"潦倒淮山客，金台五见秋。\n退飞嗟宋鹢，畏暑甚吴牛。\n问疾怜摩诘，分曹类子猷。\n自惭无补报，只合隐林丘。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":35,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"寄题张浩然松雪楼","author":"刘著","text":"入座山光秀玉柯，岸巾绝景意如何。\n瘦来岂为寒松句，和寡还惊白雪歌。\n地近云烟来鹤驾，檐高星斗泻银河。\n悬知老子登临处，渺渺沧波月色多。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":36,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"渡辽","author":"刘著","text":"身隔辽东渡，心怀冀北群。\n会归苏属国，却忆范将军。\n风陈横秋雁，雷声吼夜蚊。\n方言莫相笑，唐梵本殊分。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":37,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"次韵彦高即事","author":"刘著","text":"福威看九落，笔削在麟经。\n中道亡三鉴，危时忆九龄。\n网罗无处避，鼙鼓不堪听。\n身远辽阳渡，心怀岘首亭。\n脱巾头半白，倾盖眼谁青。\n断雁西风急，潸然涕泗零。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":38,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"次韵彦高占雪","author":"刘著","text":"天秋鼓南风，云海飘暮雪。\n三春犹冱寒，九夏那苦热。\n土圭测中气，尝闻先儒说。\n穷发多异宜，泥古诚亦拙。\n吴侯擅六艺，名宦端不屑。\n晚岁登泰山，蚤已探禹穴。\n千岁可坐致，不待数旬月。\n重阴畏坎陷，五阳欣夬决。\n君子方履霜，渠肯蹈覆辙。\n鸡猪与鱼蒜，幸可充朝啜。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":39,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"题御城寺壁","author":"刘著","text":"一径埋云草树荒，石麟苍藓卧田桑。\n汉家陵阙今何在，洛水嵩山满夕阳。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":40,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"虏中作三首 其二","author":"宇文虚中","text":"遥夜沈沈满幕霜，有时归梦到家乡。\n传闻已筑西河馆，自许能肥北海羊。\n回首两朝俱草莽，驰心万里绝农桑。\n人生一死浑闲事，裂眦穿胸不汝忘。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":41,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"中运使寄酒清明日到以诗谢之","author":"张孝纯","text":"芳樽到日恰清明，似与嘉辰默计程。\n拟助林园延胜赏，肯容桃李落繁英。\n老来官爵浑无味，闲里杯盘却有情。\n见说使车临岱麓，倘能相过共飞觥。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":42,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"挽张叔夜二首 其二","author":"张孝纯","text":"季世遭奇祸，烦冤痛可论。\n交情伤死别，亲属恸遗言。\n空想还家梦，难招去国魂。\n一朝成万古，斜日下平原。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":43,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"挽张叔夜二首 其一","author":"张孝纯","text":"畴昔中朝士，簪绅仰令名。\n恩威彰辅郡，忠孝卫都城。\n许国志何壮，为山功莫成。\n西风故林道，萧瑟感秋声。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":44,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"卢台峭帆亭","author":"张斛","text":"高秋客未还，何处望乡关。\n乔木苍烟外，孤亭落照间。\n雨晴山觉近，潮满水如闲。\n目断峒阳路，归云不可攀。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":45,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"无题","author":"施宜生","text":"唱得新翻稳贴腔，阿谁能得肯双双。\n天宁寺里尊前月，分擘清寒入小窗。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":46,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"平阳书事","author":"施宜生","text":"春寒窣窣透春衣，沿路看花缓辔归。\n穿过水云深密处，马前蝴蝶作团飞。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":47,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"柳","author":"施宜生","text":"魏王堤暗雨垂垂，还似春残欲别时。\n传语西风且停待，黛残黄浅不禁吹。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":48,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"盆池","author":"施宜生","text":"盆池潋滟荫芭蕉，点水圆荷未出条。\n分得江湖好风景，断云飞去晚萧萧。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":49,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"题将台","author":"施宜生","text":"梅花摘索未全开，老倦无心上将台。\n人在江南望江北，征鸿时送客愁来。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":50,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"社日 其二","author":"施宜生","text":"割少诙谐语，分均宰制功。\n灵祇依古树，醉叟泥村童。\n万里开耕稼，三时顺雨风。\n行春从此乐，著意酒杯中。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":51,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"诗一首","author":"施宜生","text":"久坐乡关梦已迷，归来投宿旧沙溪。\n一天风雨龙移穴，半夜林峦鸟择栖。\n卖菜无人求好语，种瓜何地不成畦。\n男儿未老中原在，寄语鹍鸡莫浪啼。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":52,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"感春","author":"施宜生","text":"感事伤怀谁得知，故园閒日自晖晖。\n江南地暖先花发，塞北天寒迟雁归。\n梦里江河依旧是，眼前阡陌似疑非。\n无愁只有双蝴蝶，解趁残红作阵飞。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":53,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"感钱王战台","author":"施宜生","text":"层层楼阁捧昭回，元是钱王旧战台。\n山色不随兴废去，水声长逐古今来。\n年光似月生还没，世事如花落又开。\n多少英雄无处问，夕阳行客自徘徊。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":54,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"赠明道人","author":"施宜生","text":"休论道骨与仙风，自许平生义与忠。\n千古已尝窥治乱，一身何足计穷通。\n仰天但觉心如铁，览镜犹欣发未蓬。\n尘世纷纷千百辈，只君双眼识英雄。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":55,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"题壁","author":"施宜生","text":"君子虽穷道不穷，人生自古有飘蓬。\n文章笔下千堆锦，志气胸中万丈虹。\n大抵养龙须是海，算来栖凤莫非桐。\n山东宰相关西将，俯仰怀贤倚暮风。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":56,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"山谷草书","author":"施宜生","text":"行所当行止当止，错乱中间有条理。\n意溢毫摇手不知，心自书空不书纸。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":57,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"严子陵钓台","author":"施宜生","text":"悬崖断壑少人踪，只合先生卧此中。\n汉业已无一抔土，钓台今是几秋风。\n同学刘郎已冕旒，未应换与此羊裘。\n子云到老不晓事，不信人间有许由。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":58,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"含笑花","author":"施宜生","text":"百步清香透玉肌，满堂和气自心知。\n褰帷跛客相迎处，射雉春风得意时。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":59,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其一","author":"施宜生","text":"只因未有良媒在，直到如今万万秋。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":60,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其三","author":"施宜生","text":"临池翕忽云雾集，舞剑浩荡波涛翻。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":61,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"句 其二","author":"施宜生","text":"朱门处处临官道，流水年年绕禁宫。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":62,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"闻雁","author":"刘著","text":"千里寒云卷朔风，当轩月午雁书空。\n烦君为报江南客，憔悴辽东更向东。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":63,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"月夜汎舟","author":"刘著","text":"浮世浑如出岫云，南朝词客北朝臣。\n传邮扰扰无虚日，吏俗区区老却人。\n入眼青山看不厌，傍船白鹭自相亲。\n举杯更欲邀明月，暂向尧封作逸民。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":64,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"春日","author":"宇文虚中","text":"北洹春事休嗟晚，三月尚寒花信风。\n遥忆东吴此时节，满江鸭绿弄残红。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":65,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"和高子文秋兴二首 其一","author":"宇文虚中","text":"沙碧平犹涨，霜红粉已多。\n驹年惊过隙，凫影倦随波。\n散步双扶老，栖身一养和。\n羞看使者节，甘荷牧人蓑。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":66,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"和高子文秋兴二首 其二","author":"宇文虚中","text":"摇落山城莫，栖迟客馆幽。\n葵衰前日雨，菊老异乡秋。\n自信浮沈数，仍怀顾望愁。\n蜀江归棹在，浩荡逐春鸥。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":67,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"迎春乐 立春","author":"宇文虚中","text":"宝幡彩胜堆金缕。\n双燕钗头舞。\n人间要识春来处。\n天际雁，江边树。\n故国莺花又谁主。\n念憔悴、几年羁旅。\n把酒祝东风，吹取人归去。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":68,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"题宗之家初序潇湘图","author":"吴激","text":"江南春水碧于酒，客子往来船是家。\n忽见画图疑是梦，而今鞍马老风沙。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":69,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"同儿曹赋芦花","author":"吴激","text":"天接苍苍渚，江涵袅袅花。\n秋声风似雨，夜色月如沙。\n泽国几千里，渔村三两家。\n翻思杏园路，鞭袅帽檐斜。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":70,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}},{"title":"早春","author":"吴激","text":"寂寂重寂寂，出门春草齐。\n晚芳犹著树，江涨欲平溪。\n山暝有时雨，村深何处鸡。\n远山缘底恨，故作傍人低。","collection":"宋末金初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋末金初.csv","pointer":71,"sha256":"c6109460760a25bbc25e0740544eca5f0ea8ac1cab3ffbb4005014f8a8ff649d","dynasty":"宋末金初"}}]