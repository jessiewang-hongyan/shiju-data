[{"title":"颂十六首 其八","author":"释慧晖","text":"高高而独坐，便是见渗漏。\n寥寥而气净，正是情渗漏。\n明明而神露，悉是语渗漏。\n毕竟同混处，从古绝渗漏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其六","author":"释慧晖","text":"上正之器根密密而难言，中当之器要了了而幽玄，下偏之器见明明而满天。\n学人分上事纷纷而不玄，主家活计事寂寂而不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其五","author":"释慧晖","text":"不行心处，不尽凡心。\n若于心处见于凡心，不妨个个了得心心。\n不挂本衣，不著元裳。\n自求本衣，再装元裳。\n不用人人，会取堂堂。\n何须正当，何坐空床。\n正当恁么，尚在虚旁。\n切忌未生，坐妙路方。\n如起归信，更堪厚赏。\n毕竟舍去，一树花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其四","author":"释慧晖","text":"祖翁四借吾门事，密密疏疏著眼视。\n位里有功隐里显，功中有位弟中师。\n功位不须功位外，主宾不拣主宾机。\n偏正回互没分晓，樵子笠穿戴月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其二","author":"释慧晖","text":"路断无依著，满船乘雪月。\n夜午不相关，全体蹈金铁。\n唱出归家歌，恣吹还乡曲。\n从斯野子梦，徒尔难分节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其一","author":"释慧晖","text":"一片天光三五风，玉墀吹断岭头松。\n巍然山上澄湛下，忽尔云同霜月中。\n堆堆全体乾坤里，密密满心天地表。\n碌碌??通用眼，骊珠击碎草芊忡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十二","author":"释慧晖","text":"午夜山房月色深，十分明白堕功勋。\n拨开向上通天窍，烟嶂重重不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其七","author":"释慧晖","text":"庵主当年用得亲，衲僧眼里要生筋。\n赵州舌有龙泉剑，开口等閒疑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其五","author":"释慧晖","text":"枯木岩前烟嶂昏，羚羊挂角觅无门。\n玉梭暗掷千峰外，一线虚通晓色分。\n孤迥迥，绝瘢痕，万古寒潭搅不浑。\n正坐当堂金殿冷，回头尽是我儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其四","author":"释慧晖","text":"一人道不落，一人道不昧。\n夜来一阵狂风生，浪打石头如粉碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其十","author":"释慧晖","text":"皎皎而月澄，岭上之孤松。\n凄凄而风渡，半夜之空中。\n深深也妙诀，自坐少林之峰。\n了了也真气，元居虚谷之功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其九","author":"释慧晖","text":"正偏融融而路断于鸟道之表，君臣堂堂而容俨于玉殿之中。\n到底难说，妙处绝同。\n别得傍道，见万年松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其八","author":"释慧晖","text":"定林只履，天台楖?。\n鈯斧住山，横担镔铁。\n独有云床老胡僧，徒见夜中天上月。\n目前无极分外心，少室花容是妙诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其七","author":"释慧晖","text":"人间无佛时，早是如来机。\n世界无尘境，新看深妙奇。\n若具此眼，便人天师。\n忽有这汉，何用拟议。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其五","author":"释慧晖","text":"玉人深睡澄潭妙，石汉眼开花岳笑。\n不是今朝新发悟，三生大定了知少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其四","author":"释慧晖","text":"直下拨开木上座，蓦端握却毫长老。\n衲僧气宇乾坤外，一夜寒冰通体到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释慧晖","text":"皮肤脱落绝方隅，明了身心一物无。\n妙入道寰深静处，玉人端驭白牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释慧晖","text":"谷之神，枢之要。\n里许旁参，回途得妙。\n云虽动而常闲，月虽晦而弥照。\n宾主交参，正偏兼到。\n十洲春尽花凋残，珊瑚树林日杲杲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释慧晖","text":"巢知风，穴知雨，甜者甜兮苦者苦。\n不须计较作思量，五五从来二十五。\n万般施设到平常，此是丛林饱参句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释慧晖","text":"朔风凛凛扫寒林，叶落归根露赤心。\n万派朝宗船到岸，六窗虚映芥投针。\n本成现，莫他寻，性地闲闲耀古今。\n户外冻消春色动，四山浑作木龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十八","author":"释慧晖","text":"有时破关知落处，有时透关契密旨。\n有时妙容拜位里，有时光烛嘱机头。\n个中有体用宾主，个中有宛转傍参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十六","author":"释慧晖","text":"梁土皇帝，南天太子。\n相见端的，不识妙旨。\n廓然不识莫公私，太子皇帝对面时。\n一片檀香炉上火，残红吹起发花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十三","author":"释慧晖","text":"行脚大事，一段宗要。\n直拈起兔角佛杖，正举蓍龟毛祖拂。\n若人拈起举著时，人尽有礼谢在时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十二","author":"释慧晖","text":"古佛道场，尚乘车子。\n澄源潭水，犹棹孤舟。\n夜鹤穿潭底，云月落银笼。\n天龙无雨，汗马而无鞭也。\n从此出生犊牛儿，金吼银声满芦水。\n微毛依旧正受中，玄角又带漫雪草。\n一回倒骑牧童梦，数笛吹来樵子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十八","author":"释慧晖","text":"枯木云笼秀，云中袍玉立。\n寒潭月夜圆，潭底侵鱼入。\n回头开正眼，头上戴帽出。\n芳草破春烟，草芊拂天内。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十六","author":"释慧晖","text":"春色千林花正开，秋潭万水月犹明。\n夏热绿杨影满地，冬寒白树覆前庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十三","author":"释慧晖","text":"风波灭尽而悔当时之事，碧海澄明而恨十分之恩。\n潭水月落而带清光之影，壶天云尽而存青霄之晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十","author":"释慧晖","text":"玉龙起雨上东天，石虎出风下北山。\n夜兔穿云南海底，昼乌破暗西畔岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其九","author":"释慧晖","text":"以大圆觉为我伽蓝，山河大地日月星辰。\n身心安居平等性智，天上天下唯我独尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其七","author":"释慧晖","text":"妙处彻底妙，玄处彻底玄。\n独知分外事，谁见壶中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其四","author":"释慧晖","text":"直把须弥锤子，正打虚空鼓子。\n稳坐寥寥而不妨，全身寂寂而忘志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二","author":"释慧晖","text":"衲僧活眼睛，见破四天明。\n六门之活计，处处而现成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其一","author":"释慧晖","text":"只个玄妙诀，从来无异辙。\n拨开千嶂云，放出一天月。\n建化门头事，山僧未曾说。\n再来花木春，佛祖也难决。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四十一","author":"释慧晖","text":"玉珠连朵万年松，金鹤飞梢一样桐。\n三吉九祥当现座，千银七宝净慈峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十八","author":"释慧晖","text":"寒凉彻骨时，通身难去处。\n其间有眼在，新丰一曲子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十六","author":"释慧晖","text":"寒夜无炭衰老衣，凉机透骨古堂微。\n霜辛雪苦慕先律，雨宿风餐圆后奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十二","author":"释慧晖","text":"辜月今朝初一日，正当冬至满霜月。\n一阳佳节大家章，字字含玄向白日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十九","author":"释慧晖","text":"阳月今朝初夜间，霜风吹地过金关。\n今宵分晓开炉火，仁者眉毛烧却寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十八","author":"释慧晖","text":"鬼箭南山射石虎，神锋北岳刺骊龙。\n好是满堂霜月夜，寒冰出火旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十七","author":"释慧晖","text":"铁夫破梦五更前，石人开眼一壶天。\n木马过闾风化后，玉虎振威野渡边。\n主人稳坐草堂前，硬翁独卧万芊天。\n三个胡狲弄钱夜，格外难求宿鹤边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十六","author":"释慧晖","text":"玄月今朝白菊辰，含珠天草未开金。\n重阳九日初阳后，吹起香烟风正新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十五","author":"释慧晖","text":"传家清白，字字廓脱。\n玉袋金针，锋锋通达。\n今夜一轮月，千山万派流。\n不觉劫壶铁，巍然没去留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十四","author":"释慧晖","text":"壮月今朝半月明，上来衲子眼睲睲。\n难瞒众眼病堂尅，何用洞家儿子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十三","author":"释慧晖","text":"杀气到来黄叶秋，梧桐老冷随河流。\n人间天上无分晓，从古至今谁得酬。\n恁么辩得，尚带滞留。\n别得一路，正绝踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十二","author":"释慧晖","text":"金气黄枫半叶红，晚来渔客倚青松。\n多多动梦夜凉路，处处偷光午月峰。\n长安万里景，大阳千里道。\n大悲阁前是鼎州，黄鹤楼前鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十一","author":"释慧晖","text":"相月今朝日气旭，梧桐一叶落金风。\n秋声潇索黄文玉，山上满天愁杀中。\n目前机用无分外，那里妙章绝万工。\n破梦蝶魂飞大空，失船钓客舣孤篷。\n胡文新送北来鸿，乡信始见他日功。\n旧山山转月明后，归路悠悠玉?珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十","author":"释慧晖","text":"诸佛出身处，东山水上行。\n宸闺垂玉帘，云榻拥天青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十八","author":"释慧晖","text":"夜间洗热凉飘飘，六月皎然满天雪。\n青林日晚人归宅，红谷天明客唤月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十六","author":"释慧晖","text":"且月今朝半夏辰，修行道者有疏亲。\n明头合暗宾中主，暗里含明主中宾。\n暗暗未明位里真，明明不暗目前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十五","author":"释慧晖","text":"他家自有通霄路，何用从容求别路。\n巍巍绝顶落潭底，峭峭家风吹满路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十四","author":"释慧晖","text":"君看五月半旬飔，山上雪花满地飞。\n乌鸡昨夜入云外，鹭鹤今朝出紫微。\n木马声声嘶北风，金鹅口口啼南枝。\n石翁气瘦运步断，玉士情丰竖拳稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十二","author":"释慧晖","text":"天桥横海上，石人走玉阶。\n玄源歌，孰得唱。\n妙唱奇，岂得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十一","author":"释慧晖","text":"禁足护生曲直中，安居收念又机圬。\n一炉香气香满室，黄面老师弄拙巧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十","author":"释慧晖","text":"千山郁密处，凉飘洗夏热。\n今日正当眼，利剑是镔铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其九","author":"释慧晖","text":"余月今朝初一日，满山绿树影青青。\n异苗繁茂只斯是，大地全分画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其八","author":"释慧晖","text":"桃红李白落空墀，天碧地青悬锦机。\n云鹤出笼过鸟道，饱参密旨不传时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其六","author":"释慧晖","text":"花月今朝朔旭前，桂轮普转满天边。\n枝花馥郁清香在，乌鹊从来同夜蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其五","author":"释慧晖","text":"学者恒沙无一悟，过在他讨舌头路。\n欲得忘形泯踪迹，努力慇勤空里步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四","author":"释慧晖","text":"竺土之大仙，今日告涅槃。\n鹤林之米子，当下得枯偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二","author":"释慧晖","text":"陬月今朝三五风，岭头雪气缚寒松。\n不知枯木得胡信，含玉灵花春梦中。\n瑞鸟飞来千万峰，祥鱼行过二三众。\n纷然相见主人眼，历历双眸处处通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩大士不答文殊问如何是菩萨入不二法门颂","author":"释慧晖","text":"净名大士口如盆，一默无端拿雷云。\n十圣瘦然居足下，三贤了尔失全分。\n飘飘而出溪风骨，濯濯而清月水纹。\n天外孤松峰顶耸，晚楼霜雪梦犹昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答云居西和尚偈","author":"释慧晖","text":"和尚不知禅，困来便打眠。\n泥牛吃水草，木马咬瓦砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十","author":"释慧晖","text":"参得五语，功勋始成。\n有时不说，恣口说行。\n有时不玄，空失妙正。\n有时不显，才一气生。\n有时不出，独来水清。\n有时不生，未开眼睛。\n毕竟见得，连天晓星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其三","author":"释慧晖","text":"转功就位，独看古风。\n再通消息，转位就功。\n功位齐显，千岳万峰。\n又转春芳，俱隐位功。\n毕竟不用，频弄万工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其六","author":"释慧晖","text":"一回得妙，二度忘妙。\n急急归云，堆堆白云。\n别增真照，殊出月照。\n芬芸百花，馥郁红花。\n春窗暖笑，破家好笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其三十一","author":"释慧晖","text":"不夜真灯，破夜心月。\n穿日玄谈，不日妙诀。\n一句了然，不涉途辙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其三十","author":"释慧晖","text":"一段大事，古今难通。\n三乘曲说，去来易空。\n衲僧眼目，端的无工。\n禅和信趣，脱然绝踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十九","author":"释慧晖","text":"朝说暮说，出广长舌。\n坐卧经行，万里镔铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十五","author":"释慧晖","text":"春梦朦胧，秋月玲珑。\n夏凉寂寂，冬寒空空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十一","author":"释慧晖","text":"运步堂堂，通身历历。\n东道西说，南来北去。\n全得寸心，直用尺情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十","author":"释慧晖","text":"圆蟾出冷，晶旭入暖。\n惠光破暗，才辉照明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十九","author":"释慧晖","text":"绿岩枯木，不落人间。\n红谷芳草，不厌温寒。\n西南东北，各不相关。\n三段玄处，正开眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]