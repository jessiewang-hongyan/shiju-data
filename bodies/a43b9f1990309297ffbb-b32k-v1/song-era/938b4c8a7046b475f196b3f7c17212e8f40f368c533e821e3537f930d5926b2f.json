[{"title":"寄芳洲先生 其二","author":"徐瑞","text":"周郎折简应难致，退叟高骞招不来。\n石上留题有神护，不教雨渍长苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄芳洲先生 其三","author":"徐瑞","text":"时人近日多轻士，造物从来亦忌名。\n只有青山无世态，与君一见若平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄芳洲先生 其四","author":"徐瑞","text":"官衔雅似何水部，文学老于元道州。\n如此身名应贵重，世间清浊易同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄芳洲先生 其五","author":"徐瑞","text":"生来道义胜纷华，晚抱遗经学种瓜。\n犹有爱山心不厌，时时幽梦到烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其一","author":"徐瑞","text":"数间老屋云松下，半亩方塘水竹村。\n先生观化耿独坐，不觉寒深雪塞门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其二","author":"徐瑞","text":"檐头风铁响铮铮，檐外浪浪槁叶鸣。\n别有宫商人未识，一炉活火听瓶笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其三","author":"徐瑞","text":"读书声歇茶初熟，古鼎香销诗未成。\n起唤欧苏索白战，天高海阔不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其四","author":"徐瑞","text":"古人何者是不朽，举世何人善打乖。\n总是流连光景处，天分幽事属吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其五","author":"徐瑞","text":"文章有皮有骨髓，欲参此语如参禅。\n我从诸老得印可，妙处可悟不可传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其六","author":"徐瑞","text":"古人骨烂心犹在，欲观古人观其心。\n我读古书忘寝食，去之千载一如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其七","author":"徐瑞","text":"何人求死不得死，有士欲生而舍生。\n谁谓古今人品异，要于出处自权衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其八","author":"徐瑞","text":"谷粟桑麻里俗淳，农谈竟夕意弥真。\n半壶浊酒陶陶醉，便是羲皇以上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其九","author":"徐瑞","text":"绝怜山北松间寺，门径漫漫雪作堆。\n衲僧定起夜将半，自拨寒炉分芋魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中夜坐杂咏十首 其十","author":"徐瑞","text":"看梅不睡非愁夜，对酒高谈别是春。\n水北山南清兴发，迟明踏雪度烟津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月望暂寓山中感旧 其一","author":"徐瑞","text":"出山两足涴尘土，几夜梦听山中泉。\n行到向来结茆处，瘦藤枯树仍风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月望暂寓山中感旧 其二","author":"徐瑞","text":"茆茨高下倚苍石，略彴参差跨碧流。\n白发前坡两翁媪，相逢漫说十春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月望暂寓山中感旧 其三","author":"徐瑞","text":"野花绿水红香动，石壁晴霞倒影奇。\n好句诗人曾拾得，重来绝笑剑痕痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月望暂寓山中感旧 其四","author":"徐瑞","text":"石臼凝泉瑩似冰，山椒云气起如蒸。\n小溪流出桃花片，我欲穷源客不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阒月廿九日芳洲寄绿萼梅一枝诗二首次韵为谢 其一","author":"徐瑞","text":"故人雪里寄梅花，妙句清寒逼齿牙。\n睡起病随残臈去，坐看神水长金华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阒月廿九日芳洲寄绿萼梅一枝诗二首次韵为谢 其二","author":"徐瑞","text":"鹤背从来不载钱，老梅风雪是忘年。\n春风若肯留相待，定趁湾头水上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽李思宣","author":"徐瑞","text":"芝山携酒诗犹在，芹泮横经梦已空。\n箧底更藏书数纸，不堪和泪对秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢拙逸见寄","author":"徐瑞","text":"鱼雁迢迢不一书，寻真岂为出无驴。\n去年偶误梅花约，心密何须泥迹疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与弋阳徐觉民主簿 其一","author":"徐瑞","text":"昔年熟看灵山面，常怪宝气充其间。\n此行乃与公相识，不负平生识此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与弋阳徐觉民主簿 其二","author":"徐瑞","text":"文章政事本一贯，道在从教俗论哗。\n为问匆匆赴期会，何如骑马看烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与弋阳徐觉民主簿 其三","author":"徐瑞","text":"向来自许千年鹤，老去真成六日蟾。\n且喜宗盟今日合，归程不惜为公淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送从弟兰玉视牍柳州 其一","author":"徐瑞","text":"柳侯种柳柳江边，岁岁春风岁岁妍。\n若访韩碑寻柳庙，为持菊蕊荐寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送从弟兰玉视牍柳州 其二","author":"徐瑞","text":"折花呼酒醉南楼，草草三年一笑留。\n今日要游难似旧，玉钗占喜白云秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵送谢拙逸 其一","author":"徐瑞","text":"久悟看山胜看书，梦中犹爱倒骑驴。\n武夷夙有烟霞侣，目断晴云雁影疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵送谢拙逸 其二","author":"徐瑞","text":"辟俗寻常昼掩门，弄丸聊复了朝昏。\n折梅且寄春风信，终待相逢慰渴魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马天心远游而归椎髻变而巾帻袖衣变而逢掖名字号俱变书亦学颜作三诗寄之 其一","author":"徐瑞","text":"纸上磊落太师字，行间突兀玄晏名。\n斯人变幻不可测，卒然见之令人惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马天心远游而归椎髻变而巾帻袖衣变而逢掖名字号俱变书亦学颜作三诗寄之 其二","author":"徐瑞","text":"风流千载贺知章，晚岁黄冠归故乡。\n三岛烟霞镜湖月，此意与之谁短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送马君采赴忠定书院教谕 其一","author":"徐瑞","text":"吾乡湾头有明月，照映空山草木寒。\n颇怪近来光采变，乃知珠徙上馀干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送马君采赴忠定书院教谕 其二","author":"徐瑞","text":"孤城上与白云齐，唐宋诸人旧有题。\n吊古不须深感慨，但教残剩付归奚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别高则山王叔浩 其一","author":"徐瑞","text":"采诗直须别具眼，论人尤贵平其心。\n莫重所闻轻所见，四方岩穴有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别高则山王叔浩 其二","author":"徐瑞","text":"孤洲兰蕊春风晚，老树丝苓夜雨寒。\n何日抱琴重过我，焚香煮茗听君弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题小斋壁","author":"徐瑞","text":"卖药城南二十秋，得钱取醉酒家楼。\n近来不敢出山去，怕有人呼韩伯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题邓梅边买驴卷后","author":"徐瑞","text":"出市难逢陈处士，叩门谁识傅先生。\n此行若遇孙郎宴，借笔不妨题子名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵怡如解嘲","author":"徐瑞","text":"子敦尚受坡翁谑，山谷何心戏炳之。\n抵掌相看成一笑，折肱始信是良医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过歇岭","author":"徐瑞","text":"四山竹树与云齐，浙水东流江水西。\n独策短筇过歇岭，乱峰叠叠翠禽啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚行三桥","author":"徐瑞","text":"晚凉信步十三湾，疏柳高荷欲半残。\n时有小舟桥下过，无言独倚石阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵芝寺","author":"徐瑞","text":"为爱嘉名似故乡，芒鞋日日此徜徉。\n非关贪礼瞿昙相，自是三生有愿香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登钓台 其一","author":"徐瑞","text":"雪手升堂读古碑，先生应笑鬓成丝。\n满庭黄叶无人扫，唯有清风似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登钓台 其二","author":"徐瑞","text":"欲荐山中十九泉，荒榛塞路上无缘。\n凄凉不尽怀贤意，黄帽催呼蚤下船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行不胜节物之感","author":"徐瑞","text":"客中无酒浣羁愁，想见家山菊自秋。\n记取今年重九日，大郎滩下泛孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次马初心韵 其一","author":"徐瑞","text":"良朋难合易参差，处独频频入梦思。\n岁晚得君相料理，老怀磊落更谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次马初心韵 其二","author":"徐瑞","text":"浊酒陶陶时一钟，柴门牢键畏迎逢。\n夜来风雪敲窗纸，喜见前山玉作峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊午元日 其一","author":"徐瑞","text":"爆竹声残晓色分，漫天雪片报新春。\n绝怜今日屠苏酒，不见丁年共饮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戊午元日 其二","author":"徐瑞","text":"屋角红梅雪里香，索人管领意深长。\n老松秀出千林表，甲裂皮皱色转苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其一 两堤柳色","author":"徐瑞","text":"废垒迢迢睥睨连，两堤横截锁苍烟。\n柳丝系得春光住，画舫时时杂钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其二 双塔铃音","author":"徐瑞","text":"浮屠双笔仰书天，檐铎吟风破曙烟。\n似为众生说般若，兴亡莫问劫灰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其三 孔庙松风","author":"徐瑞","text":"苍然五鬣东海来，直干参天不可回。\n堂上不闻金石韵，空中时听殷晴雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其四 颜亭荷雨","author":"徐瑞","text":"急雨高荷汞走盘，颜公一去岁如千。\n天公不为游人计，端为忠臣雪怒肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其五 湖中孤寺","author":"徐瑞","text":"崔嵬银屋漭相围，突兀禅房水半扉。\n便是金山古兰若，坐看孤鸟断云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其六 洲上百花","author":"徐瑞","text":"后台花发映前台，红紫成林绿作堆。\n三日一花尤尽在，愿言均作四时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其七 荐福茶烟","author":"徐瑞","text":"老衲松根拾槁枝，石铛煮茗日舒迟。\n青青亭上晴云散，正是禅僧出定时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其八 新桥酒旆","author":"徐瑞","text":"袅袅垂杨映小楼，吴姬唤客酒新篘。\n倚檐高揭青帘处，认取墙东最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其九 江城暮角","author":"徐瑞","text":"梅花三叠暮云横，戍客怀乡梦自惊。\n纵是时平争战息，不堪吹出入云声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵月湾东湖十咏 其十 芝峤晴云","author":"徐瑞","text":"深谷逶迤缥缈中，白衣遥映晓暾红。\n时清不叹唐虞远，可有商山四老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月十七夜梦中见亡孙概觉而悽怆不已","author":"徐瑞","text":"梦汝颀然立我傍，言辞慷慨巧趋跄。\n觉来落月明窗户，抚枕潸然泪满床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对菊用先大父云岩先生仰高堂壁间韵","author":"徐瑞","text":"小圃秋花孰是强，唯馀老菊殿年光。\n寒英不独华予晚，九死犹能不改香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读靖节和靖诗偶成寄仲退","author":"徐瑞","text":"逋仙只住西湖上，靖节终身栗里中。\n千古修名垂宇宙，何曾南北与西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵江道可见寄五绝 其一","author":"徐瑞","text":"戎压尘沙汗血劳，君如孤鹤立危梢。\n何时过我长松下，共候风炉涌雪涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵江道可见寄五绝 其二","author":"徐瑞","text":"世间万事匪人为，消长神机祗自知。\n饮酒不求千日醉，读书空悔十年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵寄题文溪许氏秋圃","author":"徐瑞","text":"我看黄花意甚长，纷纷萧艾不能荒。\n无论楚晋韩家事，万古秋风只自芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饭牛","author":"徐瑞","text":"饭牛夙志老方酬，看似沩山水牯牛。\n水草寻常自调伏，鼻端不用拽绳头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腰痛苦甚戏作二绝句","author":"徐瑞","text":"十万腰缠不足珍，腰围顿减可怜人。\n折腰不为五斗米，彭泽元来解忍贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月廿七月湾来访折千叶红梅一枝为赠","author":"徐瑞","text":"喜闻环佩响然臻，笑语芬芳绝世尘。\n林壑荒凉无所有，殷勤送似一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月十六夜对月有感","author":"徐瑞","text":"神游赤壁水光浮，想见元丰壬戌秋。\n甲子四周月长好，更无人续宋风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东绿翁既居山中而瑞方葺敝庐再用前韵","author":"徐瑞","text":"见说移居只载书，高人从此可悬车。\n看松北崦风吹面，种豆南山月满锄。\n拙计不能争子所，痴心尚自爱吾庐。\n辟人辟世将焉择，独立西风鬓影疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留汪子明","author":"徐瑞","text":"美人渺渺隔秋水，六年不见心茫茫。\n麦昂黍低各自媚，鹤长凫短庸何伤。\n荷锄未厌素业在，读书从来真味长。\n是间偪仄不称意，待晴携酒登重冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠别彭东皋","author":"徐瑞","text":"芝山相识廿年前，我齿如冰子鬓玄。\n颜貌顿惊俱丑老，光阴自叹祇流连。\n近来酒渴应刚制，此去诗篇莫浪传。\n语别有期频作恶，预怜清梦绕新田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵题南翁悠然阁","author":"徐瑞","text":"去家几度忆瓜丘，付与閒人一壑秋。\n林下定知无俗驾，室中应自有天游。\n幽怀时抚竹根枕，清赏堪浮莲叶舟。\n夜直玉堂明月冷，回光还是照高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂感 其一","author":"徐瑞","text":"夸父以渴毙，麦杖终死兵。\n项王称拔山，霸图竟无成。\n区区诸勇力，如何与天争。\n子房类妇人，谈笑立功名。\n去去从谷城，迢遥学长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂感 其二","author":"徐瑞","text":"阿瞒事鞍马，横槊尚赋诗。\n淮淝政交锋，别墅方围棋。\n何哉情事迂，俗论乃嗤嗤。\n斯人机械深，政尔未易窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂感 其三","author":"徐瑞","text":"长公不肯仕，曼容亦辞官。\n高车与驷马，祇可誇外观。\n玄凤栖昆崙，杳杳天风寒。\n沆瀣以为饮，朝霞以为餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂感 其四","author":"徐瑞","text":"六根本清净，人自滓六根。\n倾夺相纠结，不如此身尊。\n梯空智愈凿，金注道逾昏。\n稽首刘伯伦，酒放过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]