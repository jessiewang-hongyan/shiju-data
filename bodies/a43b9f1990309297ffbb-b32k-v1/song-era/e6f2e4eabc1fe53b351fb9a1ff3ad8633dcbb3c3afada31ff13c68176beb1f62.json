[{"title":"访施八评事","author":"梅尧臣","text":"施兄今七十，近郭隐茅庐。\n懒问齐民术，喜看庄叟书。\n竹间鸣涧水，原际见村墟。\n识尽穷通理，超然乐有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过山阳水陆院智洪上人房","author":"梅尧臣","text":"十载七来此，每嗟多异今。\n池灰休辨劫，川月解明心。\n遗墨悲苏倩，高情想遁林。\n能闲常似旧，翘立水边禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过永庆院","author":"梅尧臣","text":"荒凉旧兰若，古屋两三重。\n庭下已无柏，涧边唯有松。\n石阶生薜荔，香座缺芙蓉。\n化俗似禅衲，破来缝不缝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过白水","author":"梅尧臣","text":"下马独怀古，翛然临渡风。\n真人去来久，流水自无穷。\n雨阔沙痕涨，湾平野色通。\n曾兴汉家业，今与百川同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过鸣雁城","author":"梅尧臣","text":"九月过鸣雁，斜阳上废台。\n兵车千载会，桑柘万畴开。\n代谢随秋草，英灵化死灰。\n我来空咏古，寒鸟有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过淮","author":"梅尧臣","text":"侍亲数数来浮汴，护榇迢迢复渡淮。\n旨蓄曾无御寒具，细君唯有隐居钗。\n月衔远入鱼衔浪，潮退长汀蚌阁崖。\n素服华颠色相似，青铜不忍见形骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过褐山矶值风","author":"梅尧臣","text":"山口风偏急，矶头水似煎。\n喧声殊倦听，逆上正难牵。\n暗石谁愁碍，长途未拟前。\n江心看白浪，卷起大于船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐国大长公主挽词二首 其二","author":"梅尧臣","text":"鲁馆当年盛，秦台此日遥。\n龙归终合剑，凤去不闻箫。\n挽曲方传薤，行輀竞奠椒。\n空馀汉官属，泣送马如潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"齐国大长公主挽词二首 其一","author":"梅尧臣","text":"贤行闻当世，尊隆异故常。\n每令夫结友，不为子求郎。\n夜月初沉海，姑星忽殒潢。\n临门亲祖祭，悲吹起脩冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀姚陈寺丞","author":"梅尧臣","text":"试邑来勾越，风烟复上游。\n江潮自迎客，山月亦随舟。\n海货通闾市，渔歌入县楼。\n弦琴无外事，坐见浦帆收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兵","author":"梅尧臣","text":"太平无战阵，汉卒久生骄。\n金甲不曾擐，犀弓应自调。\n嗟为燎原火，终作覆巢枭。\n若使威刑立，三军岂敢嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别钟京","author":"梅尧臣","text":"我怜钟氏子，冒雨为求文。\n暂以经兹迈，与之书所闻。\n野鸥窥笔砚，舟子采蒿芹。\n况有新炊饭，箪浆可送君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县署丛竹","author":"梅尧臣","text":"袅袅幽亭竹，团团自结丛。\n寒生绿樽上，影入翠屏中。\n陶柳应惭弱，潘花只竞红。\n方持雪霜操，不敢倚春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴正仲见访回日暮必未晚膳因以解嘲","author":"梅尧臣","text":"永日无车马，闲坊有竹邻。\n雨中乌帽至，门外绿苔新。\n不杀鸡为具，堪题凤向人。\n山公识墨在，知我旧来贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴正仲遗二物咏之 金盏子","author":"梅尧臣","text":"钟令昔醒酒，豫章留此花。\n黄金盏何小，白玉椀无瑕。\n始入吴郎宅，还归楚客家。\n从兹不能醉，只恐费流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴正仲遗二物咏之 叠石","author":"梅尧臣","text":"十片寒湖滑，千秋白浪根。\n苍苍古崖色，叠叠老苔痕。\n欲象巨鳌顶，俯当科斗盆。\n唯愁作险说，平地起昆崙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴正仲遗新茶","author":"梅尧臣","text":"十片建溪春，乾云碾作尘。\n天王初受贡，楚客已烹新。\n漏泄关山吏，悲哀草土臣。\n捧之何敢啜，聊跪北堂亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴仲庶殿院寄示与吕冲之马仲涂唱和诗六篇邀予次韵焉 其六 次韵夜过新开湖忆二御共泛","author":"梅尧臣","text":"出舟湖渺渺，月白绝纤氛。\n已见水如鉴，莫生波上云。\n独征何慕侣，冷酌不知醺。\n露下清吟久，同心本爱君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴仲庶殿院寄示与吕冲之马仲涂唱和诗六篇邀予次韵焉 其五 次韵临淮感事","author":"梅尧臣","text":"楚舸高帆未可开，满帆风暴作阴雷。\n圣文亹亹伤漂溺，世路纷纷自往来。\n浮磬犹闻传激越，沉妖不见锁渊回。\n连陂蛙黾鸣无数，安得周官为洒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴仲庶殿院寄示与吕冲之马仲涂唱和诗六篇邀予次韵焉 其三 次韵晚泊睢阳","author":"梅尧臣","text":"日下绣衣客，江南燕尾艎。\n迹虽同鹢退，心不假犀凉。\n旧国旌旄去，包原苑囿荒。\n临堤一怀古，柳上见微阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴仲庶殿院寄示与吕冲之马仲涂唱和诗六篇邀予次韵焉 其二 依韵游陈留禅寺后池","author":"梅尧臣","text":"共逢香刹住，万景笔头堆。\n池水蛟龙尽，汀洲雁鹄来。\n远游情莫落，去国意徘徊。\n舟子休?鼓，王程不尔催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴季野话抚州潜心阁","author":"梅尧臣","text":"高阁潜心所，图书曝蠹收。\n青山随宅转，远水向门流。\n迤逦看无厌，潺湲听不休。\n一闻秦洞说，便欲泛渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴资政挽词二首 其二","author":"梅尧臣","text":"峨峨陉土厚，自古葬贤人。\n百尺不逢水，千年空闭春。\n夜台埋琬琰，陇道刻骐驎。\n西望缘缨泪，曾无幕府宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴资政挽词二首 其一","author":"梅尧臣","text":"天下文章老，为公地底铭。\n平生怀道德，铺写若丹青。\n蒲市一朝罢，洛人皆泪零。\n嗟嗟庙堂贵，今以柏为庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坐睡依韵和持国","author":"梅尧臣","text":"坐久既生倦，渐看冠佩斜。\n钟声传紫禁，乌影转西华。\n窃印后当致，触屏前未嘉。\n不为疏慢意，何用北窗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"希深本约游西溪信马不觉行过据鞍联句","author":"梅尧臣","text":"有意访西溪，顺途吟思迷。\n及兹询野老，已恨过芳蹊。\n醉客但多兴，幽禽空自啼。\n无由驻金勒，林表日光低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"希深所居官舍新得相府蔬圃以广西园","author":"梅尧臣","text":"楚相拔葵后，萧条三亩馀。\n烟畦偶连畛，蕙圃得增墟。\n便欲开春沼，何妨薙野蔬。\n始添台榭美，况近子云居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弟著作宰南陵","author":"梅尧臣","text":"新买紫骝马，欲归清弋江。\n去弹琴雁独，来认舄凫双。\n橐实收盈篚，浓醅熟满缸。\n弟兄相忆否，风烛旧西窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张子野赴官郑州","author":"梅尧臣","text":"尽室寄东里，一官辞上都。\n只应乘小驷，宁肯蹑双凫。\n秋雨生陂水，高风落庙梧。\n梅山为余访，还有旧家无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张圣民席上赋红梅","author":"梅尧臣","text":"吾家有嘉树，红蕊开朝雾。\n笑杏少清香，鄙梅多俗趣。\n江都别乘居，似见句溪圃。\n坐中勿苦疑，结子看春暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张仲通追赋洛中杂题和尝历览者六章 其一 伊川","author":"梅尧臣","text":"山断泻伊流，滩声朝暮急。\n东渡马将登，西堤人已立。\n日看东西舟，争途如不及。\n谁见捕鱼郎，寒蓑雨中湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张尧夫寺丞改葬挽词三首 其一","author":"梅尧臣","text":"洛阳交旧里，过半已凋残。\n在昔义投漆，最先悲阖棺。\n谁知二纪水，重卜九原安。\n闻说塞门路，白杨风更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张尧夫寺丞改葬挽词三首 其二","author":"梅尧臣","text":"当时嗟遽殁，二子未能言。\n频岁折丹桂，买茔迁陆浑。\n重铭太史笔，不替故人恩。\n为善有终庆，此焉天意存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张尧夫寺丞改葬挽词三首 其三","author":"梅尧臣","text":"旧坟为润齧，新冢得山深。\n斩木来荒路，移松出近岑。\n黄鹂啼棘上，玉女问泉音。\n强作挽人唱，傥知哀感心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张侍郎中隐堂","author":"梅尧臣","text":"畴昔人归老，于兹望白云。\n门高知后庆，宾至诵先芬。\n草树中园秀，衣冠旧里闻。\n宁同江令宅，寂寞向淮濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张法曹归阙","author":"梅尧臣","text":"海底日未上，屋头群雀喧。\n晨兴溪馆迥，坐听橹声烦。\n出户望行舸，羡心如野猿。\n暮春余亦去，为见故人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张脩赴威胜军判官","author":"梅尧臣","text":"青骊渡河水，侠气动刀环。\n入幕沙尘暗，临风鼓角闲。\n地形通柏谷，秋色满榆关。\n谁复轻儒者，难淹笔砚间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张淳叟献诗永叔同永叔和之","author":"梅尧臣","text":"张君献诗诗词巧，美女插花娇醉春。\n公答七言夸笋笴，我无千里学骐驎。\n夜吟谢朓澄江练，露湿陶潜漉酒巾。\n归去应将锦囊贮，已胜珠玉莫愁贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟王维观猎","author":"梅尧臣","text":"白草南山猎，调弓发指鸣。\n原边黄犬去，云外皂雕迎。\n近出长陵道，还看小苑城。\n聊从向来骑，回望夕阳平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟宋之问春日剪綵花应制","author":"梅尧臣","text":"上林花未有，中禁綵先成。\n叶逐剪刀出，蕊从妆粉生。\n红繁内人手，香染侍臣缨。\n不是将春竞，天心重发荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟张九龄咏燕","author":"梅尧臣","text":"眇眇双来燕，长年与社违。\n任从新历改，只向旧巢归。\n永日当人语，轻寒逆雨飞。\n自亲梁栋惯，不识海鸥机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟李益竹窗闻风寄苗发司空曙","author":"梅尧臣","text":"窗前风动竹，声碎影仍繁。\n冲扉忽自启，出候初迎门。\n惊雀枝未定，乳蜂窠暂翻。\n飘飘一举袂，聊更迟来辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李廷老祠部寄荆柑子","author":"梅尧臣","text":"踏雪冲风驰小吏，带霜连叶寄黄柑。\n擗包欲咀牙全动，举盏逢衰酒易酣。\n书尾自题知远意，笔头亲答厌多谈。\n故人莫觅新诗卷，都似嵇康七不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李廷臣通判蔡州","author":"梅尧臣","text":"夹路青青草，随君去未休。\n亦将离思远，还共翠心抽。\n细藉车轮稳，薰牵野蔓柔。\n王孙归不久，冉冉莫经秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李审言归郑州","author":"梅尧臣","text":"尝从京索间，跃马望春山。\n气象归王国，丘陵接汉关。\n长榆啼鸟乱，细草牧陂閒。\n老厌行涂路，因歌送子还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李审言将归河阳值雪遗金波酒","author":"梅尧臣","text":"朔吹卷天吼，远郊无鸟飞。\n忽惊门户白，昨夜打窗微。\n闾巷我方懒，关山君独归。\n翻能寄醇酎，为此解寒威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李尚书挽词二首 其二","author":"梅尧臣","text":"伊水西头月，青山北脚云。\n夜台无复晓，阴岭有时熏。\n龙剑双埋没，庭兰竟郁芬。\n不知门下客，谁刻道傍文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李尚书挽词二首 其一","author":"梅尧臣","text":"相门三世贵，家法百年同。\n天子赐恩礼，史臣书祖风。\n笳声空苦雾，陇穴启寒蓬。\n自古焉能免，于兹是始终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李舍人见过","author":"梅尧臣","text":"春泥无处所，穷巷少人行。\n忽枉青丝骑，曾非白面生。\n笑言聊与适，鸡黍未尝烹。\n莫叹余贫甚，吾侪业本清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李庭老许遗结丝勒帛","author":"梅尧臣","text":"纫丝作长带，正胜茱萸纹。\n冉冉仍垂绋，??自有薰。\n鲜华非称我，脩饰未如君。\n曾不日来取，贤哉知礼云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李康靖少傅夫人挽词二首 其二","author":"梅尧臣","text":"板舆曾至郑，灵輤此归周。\n行哭人增慕，凝茄月正秋。\n九原开祔穴，故土覆新丘。\n岁晏寒松下，茅苫孝子留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李康靖少傅夫人挽词二首 其一","author":"梅尧臣","text":"九月秋风急，三川苦雾迷。\n卜邙新隧启，度巩短箫齐。\n宝剑知终合，灵蟾已陨西。\n松门来会葬，车马几千蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李端明宅花烛席上赋","author":"梅尧臣","text":"百两礼将陈，王家集上宾。\n花光浓照席，烛艳暖回春。\n已接冰壶润，宁辞翠斝醇。\n自惭持短调，重对玉堂人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村豪","author":"梅尧臣","text":"日击收田鼓，时称大有年。\n烂倾新酿酒，饱载下江船。\n女髻银钗满，童袍毳氎鲜。\n里胥休借问，不信有官权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃","author":"梅尧臣","text":"蜀帝何年魄，千春化杜鹃。\n不如归去语，亦自古来传。\n月树啼方急，山房客未眠。\n还将口中血，滴向野花鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨畋赴官并州","author":"梅尧臣","text":"尝闻地近胡，寒气盛中都。\n车马行临塞，关山见落榆。\n吴钩皆尚壮，章甫几为儒。\n寄谢西曹掾，能吟秀句无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈学士景休知真州","author":"梅尧臣","text":"太守幡旗近国门，州民迎望若云屯。\n家风自有东阳咏，主道新移北海樽。\n红锦臂韝观粉质，涂金珂勒驾朱轩。\n他时傥使春秋对，莫以周襄出郑论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟和持国","author":"梅尧臣","text":"绿源去未穷，夹岸树濛濛。\n弱蔓低侵水，残芳不隐丛。\n浣衣思越妇，折笋拟江童。\n薄暮回船处，潭鱼动镜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛溪","author":"梅尧臣","text":"中流清且平，舍楫任船行。\n渐近鹭犹立，已遥村觉横。\n何妨绿樽满，不畏晚风生。\n屈贾江潭上，愁多未适情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏祠部通判洪州","author":"梅尧臣","text":"飞鹢去江西，秋飙满桂旗。\n芦洲花白处，枫岸叶丹时。\n沙鸟看来没，云山爱后移。\n高才属滕阁，家擅子卿诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"补题东都善惠师禅斋","author":"梅尧臣","text":"香象红蕖坐，花盆白石台。\n上公金印去，王子玉驹来。\n心是寒瓶水，明无宝镜埃。\n世人何扰扰，时为一言开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛著作知西京永宁","author":"梅尧臣","text":"跃马西畿令，家茔在洛阳。\n衣沾寒食雨，花发故宫墙。\n冷淡鸠鸣屋，宽闲水满塘。\n送君悲渐老，空忆钓伊鲂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还文雅师书帙","author":"梅尧臣","text":"编绝不加新，于今十二春。\n绿窗重展目，静几勿生尘。\n岂爱吾庐日，终将道者亲。\n莫嫌同刺字，漫灭看难真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迟雪","author":"梅尧臣","text":"风嚎大泽晚，云覆女墙低。\n惊霰夜将集，广庭朝复迷。\n莺鸣寒蔽日，雁泊冻生溪。\n会待飘花密，开轩意外题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵伯堰下王君玉饯王仲仪赴渭州经略席上命赋","author":"梅尧臣","text":"未破河西寇，朝廷尚有忧。\n淮南命儒帅，塞上足封侯。\n莫擐黄金甲，须存百胜谋。\n昔尝经黠虏，今去正防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰正月二日夜张氏纳妇","author":"梅尧臣","text":"婚姻贵及时，周有摽梅诗。\n雪后花争发，人归室且宜。\n坐中传漏鼓，户外转星旗。\n环佩遥闻出，当脩庙见仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居","author":"梅尧臣","text":"读易忘饥倦，东窗尽日开。\n庭花昏自敛，野蝶昼还来。\n谩数过篱笋，遥窥隔叶梅。\n唯愁车马入，门外起尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陆子履见过","author":"梅尧臣","text":"刘郎谪去十年归，长乐钟声下太微。\n屈指故人无曩日，平明骑马扣吾扉。\n论情论旧弹冠少，多病多愁饮酒稀。\n犹喜醉翁时一见，攀炎附热莫相讥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]