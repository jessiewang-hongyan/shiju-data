[{"title":"题贺水部书画五首 其一","author":"汪藻","text":"茹芝商岭见时清，来望重瞳日月明。\n径去似知真主意，东游不为羡门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题贺水部书画五首 其二","author":"汪藻","text":"枕中鸿宝谩纷如，尺素题诗已月馀。\n何物弥明儿女语，刚云不解世间书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题贺水部书画五首 其三","author":"汪藻","text":"眼见嘉平忍更论，当时爵里至今存。\n子真何苦更名姓，白首区区守市门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题贺水部书画五首 其四","author":"汪藻","text":"纷纷儿辈自名家，妙道从来岂有他。\n时以丹青写佛事，不妨柱史入流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题贺水部书画五首 其五","author":"汪藻","text":"风吹鸟迹落岩间，付与区中万古传。\n故遣诗人收拾得，要知身不是顽仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题日暮倚修竹图","author":"汪藻","text":"藁砧何在复凋年，兴在孤鸿落照边。\n遮莫春光无处著，只蒋修竹共婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大年小景","author":"汪藻","text":"忽惊坐上江天渺，半幅鹅溪写霜晓。\n风低黄芦潮欲到，平沙无人喧宿鸟。\n而来著眼应万里，开卷尺馀那尽了。\n须知王孙寄笔力，平日气吞云梦小。\n故将点缀调儿辈，不待淋漓翻墨沼。\n滕王蛱蝶往谁并，曹霸骅骝今已少。\n坐令好事费百金，窗几短屏横轴绕。\n君家此本传几世，羁客见之先绝倒。\n江头历历旧行处，好在渔矶落寒潦。\n浮家泛宅归去来，还看飞鸿卧林杪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠人","author":"汪藻","text":"拨炉应对夜语久，云灰消尽红金斗。\n君才合在殿阁间，簿书帷中不应有。\n且置玉堂风雨笔，来试牛刀霹雳手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徽宗皇帝灵驾发引挽词四首 其一","author":"汪藻","text":"图治八王上，增光六圣馀。\n仁恩渐动植，文物掩诗书。\n未及金縢启，俄成玉帐虚。\n衣冠归故国，神已在化胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徽宗皇帝灵驾发引挽词四首 其二","author":"汪藻","text":"三雍无逸隽，四海屡丰年。\n嘉瑞标图谍，休功被管弦。\n鼎成龙即去，书远雁空传。\n多少承平老，遥悲杞国天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徽宗皇帝灵驾发引挽词四首 其三","author":"汪藻","text":"无心居大宝，有子传鸿钧。\n万里方终宴，千年忽上宾。\n地今纵禹葬，天不返虞巡。\n怆极皇情处，还观吉仗陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徽宗皇帝灵驾发引挽词四首 其四","author":"汪藻","text":"七圣迷途后，宫车遂不回。\n乘云知益远，濡露但增哀。\n日卜天宁近，山依冰固开。\n千岩应更秀，从此是轩台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆祐皇太后挽词三首 其一","author":"汪藻","text":"四纪归坤极，三朝赖母临。\n德齐先后懿，恩及圣君深。\n册宝追崇祀，衰麻欲报心。\n哀荣千古事，谁复嗣徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆祐皇太后挽词三首 其二","author":"汪藻","text":"化行江汉域，人喜翟车还。\n色养方无阻，神游遽莫扳。\n月沉长乐殿，云绕庆都山。\n不奉旋京驾，千秋惨圣颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆祐皇太后挽词三首 其三","author":"汪藻","text":"德盛周文母，仪尊喾正妃。\n山河隳地载，星宿掩轩晖。\n此日哀笳曲，他年大练衣。\n越冈宁久驻，会有灞陵归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何郡王挽词二首 其一","author":"汪藻","text":"两纪中天侍冕旒，甘盘仍作济川舟。\n传家经术终黄阁，袖手功名未白头。\n身似留侯初出汉，葬如姬旦不忘周。\n千官祖奠城东陌，十里春风鼓吹忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何郡王挽词二首 其二","author":"汪藻","text":"名标南国洞中天，胄出西京鼎足贤。\n早扈六蜚依日月，晚辞三事作神仙。\n马蹄忽到縢公室，鸡梦那逢谢傅年。\n一品真王对异姓，功臣今日数凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"学士蒋公母挽词三首 其一","author":"汪藻","text":"举酒频华族，高堂有白头。\n生儿胜武子，偕老得黔娄。\n未免平反笑，俄惊孺慕忧。\n他年如辍社，牛女有悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"学士蒋公母挽词三首 其二","author":"汪藻","text":"坐膝扶床处，人看七十稀。\n孤雏方反哺，双剑忽随飞。\n脂泽新封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"学士蒋公母挽词三首 其三","author":"汪藻","text":"才大惊馀子，名高压四夷。\n雁书希世事，鵩赋暮年悲。\n习险从人在，杯圈旧事非。\n凄凉嘉树侧，无复板舆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"詹令人挽词二首 其一","author":"汪藻","text":"小隐严陵下，当年得孟光。\n里师为妇顺，子庆事亲长。\n洲橘应还熟，庭萱遂不芳。\n他年冠盖会，来看伏牛冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"詹令人挽词二首 其二","author":"汪藻","text":"有子皆通籍，迎扶出万山。\n色难三釜外，眉寿百年间。\n帝渥书泥紫，儿嬉服綵班。\n空成潘岳赋，无复板舆还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天台道中","author":"汪藻","text":"渺渺孤程逐雁飞，茫茫平野见人稀。\n水纹萦石作虫篆，麦陇挂山如衲衣。\n日月尚留沧海照，山川盍护翠华归。\n春风自满江南岸，不管人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归州","author":"汪藻","text":"写真不怨毛延寿，视死还同屈大夫。\n异世同乡俱薄命，空令千载起嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蚕妇行","author":"汪藻","text":"树头恰恰晴鸠喜，上巳人家扫蚕蚁。\n纸窗茅屋春雨寒，买炭添炉中夜起。\n平明采叶晞露痕，随刀翠缕如丝匀。\n三眠欲食春已老，旋炊新麦祀蚕神。\n咽明足紧解丝簇，犹向前溪问茅卜。\n东邻西里想殷勤，借问今年几分熟。\n缲车轧轧桑阴凉，主家人立鸿雁行。\n丝成不得半缕著，一生麻纻随风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琴高鱼","author":"汪藻","text":"百川萃南州，水族何磊砢。\n其间琴高鱼，初未列楚些。\n岂堪陪薧鲜，裁用当殽果。\n土人私自珍，千里事封裹。\n遂令四方传，噍嚼亦云颇。\n俗云琴高生，控鲤宛溪左。\n灵踪散如烟，遗鬣尚馀颗。\n向来骑鲸人，逸驾尝慕我。\n不应当时游，反用此么么。\n得非效齐谐，怪者记之过。\n彭越小如钱，踪迹由汉祸。\n越书载王馀，变化更微琐。\n因知天地间，人莫穷物夥。\n区区于其中，臆决盖不可。\n伪真吾何知，且用慰颐朵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀杭道中","author":"汪藻","text":"过境全疑道若穷，萦纡百转曲回通。\n人行山顶半天上，舟绕溪流乱石中。\n狱讼已无前世号，衣冠犹有古人风。\n才归又见争相庆，共听歌谣万室同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢端明遣骑送酒","author":"汪藻","text":"十样华樽照荜门，儿童歌舞彻比邻。\n他乡忽作青州梦，新岁初尝白堕春。\n敢谓五浆骇先馈，且欣一盏便醺人。\n扶衰却老皆公惠，肯学刘伶祀鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄何山慧老","author":"汪藻","text":"一见蝉联话不休，别来林壑又经秋。\n每思树杪闻清磬，几欲沙边具小舟。\n未办眼前茅一把，谁知身后橘千头。\n远公社里栽莲处，他日还能着我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题葆真阁","author":"汪藻","text":"溪山上下碧相寻，中有幽人妙陆沉。\n自古几人能转物，平生万事要刳心。\n清风不动竹阴直，白日有馀春意深。\n世论未宜轻小隐，可能朝市胜山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"附舶船送荔子","author":"汪藻","text":"千里云飘破浪开，使君知道荔枝来。\n未尝玉井醍醐味，先看金盘火齐堆。\n肯作浪题霜后橘，聊同驰寄陇头梅。\n到头应遣纤纤手，笑擘轻红喔酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"相如","author":"汪藻","text":"词气纵横亦壮夫，低回功业独何如。\n可怜封禅遗忠意，魂魄应须愧史鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过定香寺","author":"汪藻","text":"雨痕狼藉龙挂虚，风林岑蔚枭哺雏。\n一川窈窕水云国，百家世世封樵渔。\n钟来木杪知有寺，杖藜起踏苍烟孤。\n溪山清明搀楚尾，台殿倾圮存唐馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴江","author":"汪藻","text":"好在松江水，丁年忆此过。\n垂垂梅子雨，细细曲尘波。\n花老千头橘，香闻数丈荷。\n百忧今已矣，搔首意如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过靖安镇","author":"汪藻","text":"樯竿历历表中流，瞑宿河堤古驿头。\n天遣山川浑着月，人将榆柳共惊秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过五岭","author":"汪藻","text":"蜀道如天世路稀，那知五岭与云齐。\n登临直上凌霄去，仰视何妨稳步跻。\n仁杰思亲聊税驾，王尊念国欲鞭蹄。\n往还勿谓兹山险，更有无穷万丈溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿焦山方丈","author":"汪藻","text":"明发理烟艇，欢言济遥岑。\n盘涡沸风雨，稍辨钟磬音。\n行行并疏柳，迎客多幽禽。\n扶舆上荦确，始见江湖深。\n台殿明海色，嵌空忆龙吟。\n修廊延客步，妙香慰人心。\n遐眺未云极，千岩忽秋阴。\n孤月欲生岭，诸天悉浮金。\n兹游倍奇绝，况接支道林。\n夜语不知旦，虚窗对横参。\n人间惊毫末，物外雄窥临。\n稽首悟真理，微生安所任。\n苍崖有奇字，霜乾约重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿上方院","author":"汪藻","text":"问津渔子浦，休驾法王城。\n一雨夜来过，数峰烟际明。\n藤萝月不到，钟磬寒愈清。\n信美欲归去，村鹃如放声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"汪藻","text":"敌帐梦回惊日处，都城心切望云时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"汪藻","text":"班立青云腰佩玉，手持洪造印涂金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"汪藻","text":"野田无雨出龟兆，湖水得风生縠纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"汪藻","text":"路行归雁不到处，家在长江欲尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"汪藻","text":"欲识庆源何自远，大川东去未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"汪藻","text":"寒无蟹螯持，犹觉非故围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"汪藻","text":"三君赫奕今谁在，百谪风流故自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"汪藻","text":"应物聊为小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"林大声","text":"南徐江山天下雄，沿江一水如蟠龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"林大声","text":"双瀑挂天绅，七杉排斗样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其一","author":"释道震","text":"白云深覆古寒岩，异草灵花彩凤衔。\n夜半天明日当午，骑牛背面着靴衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其二","author":"释道震","text":"眼见色时耳便聋，耳闻声处眼无功。\n朝来不耐灵禽报，树上杨梅似火红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其三","author":"释道震","text":"石人问枯椿，何时汝发华。\n枯椿怒石人，何得口吧吧。\n石人呵呵笑，枯椿吐异葩。\n红霞辉玉象，白玉碾金沙。\n借问通玄士，何人不到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"插锹井颂","author":"释道震","text":"尽道沩山父子和，插锹犹自带干戈。\n至今一井如明镜，时有无风匝匝波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临终颂","author":"释道震","text":"吾年八十三，随顺世言谈。\n不落思量句，谁人共我参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重经快阁","author":"范正国","text":"侨寓穷沧海，心栖快阁间。\n烟云浮四座，几席对千山。\n阑槛何由见，神明怅未还。\n兴崇应有待，高躅付谁攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"范正国","text":"百尺参天隋代柏，可怜终老栋梁材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"范正国","text":"云护俨公塔，天清雷满池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题南山寺","author":"吴师能","text":"苍崖千仞入寒云，一水分流照眼新。\n潭孕蚌胎珠弄月，石藏虹气玉蒸春。\n轮蹄自老青山路，香火谁闲白日身。\n愧乏涓埃报君禄，萧条双鬓满衣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐云堂","author":"索逑","text":"巍堂耸太清，日暮倚前楹。\n飞鸟却在下，落霞相与平。\n眼中穷百越，掌上瞰三城。\n送客一樽酒，怀归无限情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大观间题南京道河亭","author":"史徽","text":"谷雨初晴缘涨沟，落花流水共浮浮。\n东风莫扫榆钱去，为买残春更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中作","author":"王珩","text":"杖屦步斜晖，烟村景物宜。\n溪深水马健，霜重橘奴肥。\n舂罢鸡争黍，人行犬吠篱。\n可怜田舍子，理乱不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潘良贵三江亭","author":"王珩","text":"潘郎未觉鬓霜侵，佳致乘闲得得寻。\n古岸渺茫分远渡，飞甍虚敞快人心。\n融樽想见频颓玉，季诺由来雅胜金。\n野老固惭东阁客，何妨同作醉翁吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五港","author":"张郛","text":"源出金溪北，支分五港开。\n碧波涵白日，秋水渍苍苔。\n鳞介多潜育，渔人自溯洄。\n嗟予羁薄宦，因此欲归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日陪郡侯游贤山和眼听和尚韵","author":"张宰","text":"澹澹秋林挂夕晖，红尘扫尽白云飞。\n不嫌月到常开牖，一任风来自掩扉。\n啸木山猿如唤梦，衔花石鹿总忘机。\n何人参透其中味，野鹤舒翎天际归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游南雁","author":"陈经正","text":"雨晴华表插无孤，雾散丹霞落雁湖。\n洞窈不知红日过，峰危倩得白云扶。\n人间谁道无蓬岛，天地分明有画图。\n山鸟罔知人未醒，隔林款款唤提壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"张迪","text":"此地从来寒暑偏，扇纨不曾遭弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"义了道人昨梦斋","author":"吴表臣","text":"不受尘网缠，祝发趣幽屏。\n回观真梦事，超然得深省。\n寂照涵虚空，梦觉等前境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临平山","author":"沈汝谐","text":"山势分明饮水鼍，孤峰西转郁嵯峨。\n不须探问山童药，且揖朝来爽气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冰谷泉","author":"沈汝谐","text":"甃石才深数尺馀，一泓清冷若冰壶。\n泉源定与安平接，二水轻甘略不殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涤虑轩 其一","author":"左誉","text":"过眼浮云是也非，桔槔俯仰政儿嬉。\n欲知身世俱无染，看取莲花在水时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涤虑轩 其二","author":"左誉","text":"洗尽尘机万虑空，胸中冰鉴许谁同。\n今宵正可谈风月，借问何人是阿戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]