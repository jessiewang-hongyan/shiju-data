[{"title":"端午内中帖子词 其三 皇帝阁","author":"王圭","text":"泰一扶皇运，真人感赤精。\n更逢端午节，君德万方明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十一 皇帝阁","author":"王圭","text":"翠华初到玉池游，笑指宫人按棹讴。\n湘水英魂在何处，犹教终日竞龙舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其七 皇帝阁","author":"王圭","text":"采丝缠粽动嘉辰，浴殿风生画扇轮。\n拂晓千门放金钥，玉阶还有谢衣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其五 皇帝阁","author":"王圭","text":"万里来珍贡，风澜静四溟。\n鱼龙惊咒水，神雾忽生庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十二 皇帝阁","author":"王圭","text":"御池风暖水如鳞，争看兰舟竞渡人。\n应是君王好忠直，至今犹为吊孤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题斋宫","author":"王圭","text":"邻鸡未动晓骖催，又向灵台饮福杯。\n自笑治聋知不足，明年强健更重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李右丞王维画雪景绝句","author":"王圭","text":"微生江海一閒身，偶上青云四十春。\n何日扁舟载风雪，却将蓑笠伴渔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一题白马馆","author":"王圭","text":"白马荒原非路歧，征夫未起雪侵肌。\n雁思水国犹南翥，人在冰天更北驰。\n狂吹欲号沙四作，冻云无赖日西垂。\n平生可是嗟行役，一对胡觞亦自嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又次韵","author":"王圭","text":"吟边莫放酒杯乾，玉树琼楼不奈寒。\n授简谁当梁苑赋，泛舟聊作剡溪看。\n但知盈尺占丰岁，岂为无毡笑冷官。\n想得题诗呵冻砚，固应清兴入毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄公仪四首 其四","author":"王圭","text":"花扑行人柳荫渠，每逢嘉趣为停舻。\n留连一水风光暮，怅望今宵月影孤。\n汉橐暂持来法从，皋禽还引上仙图。\n中条侯骑知非远，肯尽都门别酒无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄公仪四首 其三","author":"王圭","text":"千里行行近帝都，拍堤新浪喜衔舻。\n天涯芳草春过尽，楼北浮云客望孤。\n醉倚东风轻万事，梦留沧海阻归图。\n为怜何逊多才思，还信休文带减无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄公仪四首 其二","author":"王圭","text":"又拥双旌去守蒲，波从天上泛归舻。\n青云慷慨逢辰早，白发逶迤事主孤。\n薄宦多端非我素，清吟终日是君图。\n锦江春色年年好，忆把游人醉袖无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄公仪四首 其一","author":"王圭","text":"紫掖新书换使符，春晴红旆照行舻。\n曾持白简风何厉，更伏青规论益孤。\n月露清吟应到骨，江山别梦欲成图。\n闻教双鹤先归去，还到辽城似旧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元","author":"王圭","text":"昔年今日从宸游，綵仗纷纷已御楼。\n半夜众星来紫极，一春万火纵丹丘。\n玉栏曾侍看山久，翠醁仍酣赐醴优。\n锦帐宵寒薰易歇，梦魂直欲到天头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"工部尚书致仕王懿敏公挽词","author":"王圭","text":"慷慨当年论太平，谏书虽在已尘生。\n三秋胜气横金甲，半夜离歌掩玉笙。\n庭下绿槐空自老，匣中长剑为谁鸣。\n壮图未就冠先挂，从此无由听履声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书四望亭","author":"王圭","text":"轩然独到碧峰头，万里青霄入寸眸。\n日夜松声如雨急，古今山色与云浮。\n废朝风物依依在，客路江波滚滚流。\n汉辇已沉江树老，天涯寂寞下归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书隐者壁","author":"王圭","text":"客路森如棘，岩栖静掩关。\n陶巾春渍酒，谢屐晚回山。\n醉梦雷霆息，棋声日月閒。\n我惭撄世网，暂此一怡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁字卷子","author":"王圭","text":"文昌清晓漏声疏，曾看飞泉落笔初。\n诗入池塘似灵运，赋传宫殿学相如。\n春官不下真朱点，阴注将成淡墨书。\n见说丹台名第一，蕊章须诏侍严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽词五首 其五","author":"王圭","text":"忆昨颁遗诏，犹闻玉几香。\n鼎湖龙已去，汾水雁空翔。\n北极星辰暗，三山日月长。\n宸游在何处，尚想赭袍光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽词五首 其四","author":"王圭","text":"平昔传清跸，金舆下紫宸。\n忽从沧海宴，遂隔属车尘。\n剑落桥山夜，衣留汉庙春。\n东厢朝圣子，绝恸见群臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽词五首 其三","author":"王圭","text":"七月攒宫晓，愁看动素旂。\n乾坤清泪满，车驾昔游非。\n落月低黄伞，流尘上玉衣。\n苍梧何日返，耘鸟傍陵飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽词五首 其二","author":"王圭","text":"西葬青嵩道，千秋岂复晨。\n皇图先与子，庙号独称仁。\n二帝衣裳旧，三王礼乐新。\n茂陵书奏晚，不及议车巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽词五首 其一","author":"王圭","text":"忽觉宫车晚，乘云御帝乡。\n空馀群玉殿，不奏万年觞。\n白发孤臣泪，黄尘九陌荒。\n返虞歌未断，陵柏已苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日呈原叔给事唐卿谏议","author":"王圭","text":"欲晓东风拂面来，征骖初喜共春回。\n九天应下阶庭拜，万蛰先惊汉地雷。\n冷彻貂裘须护节，和侵毡屋莫穷杯。\n出疆慷慨男儿事，未信霜颜便一摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友生失意","author":"王圭","text":"梦到天阍寤翼伤，拂衣归去乐江乡。\n丈夫岂识原非病，丞相应嗤盖有狂。\n失马未须嗟北塞，过关重约使南阳。\n君知韝上雄飞日，秋劲霜严始一翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜有寄","author":"王圭","text":"莎阶切切思寒螀，爽籁泠然露气凉。\n半夜云高蟾喷晕，一秋风紧桂飘香。\n鸟惊危树栖无定，人倚空楼望更长。\n遥忆洞庭南去客，叶翻波急驻归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王公和学士挽词","author":"王圭","text":"念昔携君手，同游金马门。\n流年一鸟过，白首几人存。\n星挂朝衣湿，尘埋相印昏。\n西风原上泪，不得洒清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发会同馆","author":"王圭","text":"一持天子节，兹喜去龙庭。\n大漠夜犹白，寒山春不青。\n峰多常蔽日，地绝欲回星。\n同类惟所适，鸣镳毋暂停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四并亭","author":"王圭","text":"蹛林初跃玉羁旋，已觉芳菲近日边。\n塞上胭脂侵酒面，江南寒食落尊前。\n魂迷一水花临浦，醉入东风絮满天。\n金谷更饶春色好，四难犹恐负华年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月五日与馆伴耶律防夜燕永寿给事不赴留别","author":"王圭","text":"万里来持聘玉通，今宵宾燕为谁同。\n铙歌自醉天山北，汉节先随斗柄东。\n半夜腾装吹朔雪，平明跃马向春风。\n使车少别无多恋，只隔燕南一信中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再召至龙图阁观书","author":"王圭","text":"君王又诏蓬莱宴，三阁崔嵬压海鳌。\n翠玉装舆容扈跸，黄金涂纸看挥毫。\n尧文自与星辰烂，汉殿常依日月高。\n四十年来无此会，恩深不觉醉仙醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刑部侍郎致仕王熙仲挽词","author":"王圭","text":"解组归来岁月侵，应无尘土上华簪。\n犹闻别鹤山中怨，忽送冥鸿日外沉。\n洧水于今寒露起，汉台依旧白云深。\n与君曾论平生事，不觉临觞泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘损斋主簿见示游广教和刘朔斋诗次韵","author":"王圭","text":"红叶村边白板扉，林间剥啄愧新知。\n离居自信难同俗，载酒何时许问奇。\n黄蘖人亡空有寺，锦袍仙去更无诗。\n知君此日登临意，不比儿曹饱腹嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"王圭","text":"闻笛更怀旧，望鸿难寄音。\n西风行客泪，明月故人心。\n离恨江波阔，归期岁景深。\n何时紫溪隐，尊酒起狂吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池亭月下独坐","author":"王圭","text":"游云销尽月当空，危坐西轩快水风。\n往恨忽从中夜起，赏心难与故人同。\n鼠惊琴匣闻馀响，萤度莲塘见乱红。\n星薄漏稀犹不寐，寒声通夕战疏桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹","author":"王圭","text":"天地得正气，四时无易心。\n生来本孤节，高处独千寻。\n月影龙蛇动，风枝箫籁吟。\n如何枫与柳，亦拟傍清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自述","author":"王圭","text":"少从客路千波转，老入流年万事疏。\n野鹤定知乘宠误，春冰多愧践名虚。\n几思汉殿金盘露，恣阅蓬山绿字书。\n未报君恩成白发，翻然江海羡吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行述怀寄公仪","author":"王圭","text":"昔陪画省对春菲，今日逢春未得归。\n灼灼海棠谁复折，差差燕子又还飞。\n清尊须惜良辰共，白发俄惊万事非。\n昨夜淮山好风月，为君中夕促瑶徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访别成献甫经历时新拜西台御史之命二首 其二","author":"王圭","text":"寒露迎风一段冰，高标孤映宛之滨。\n人言飙击须鹰隼，我喜时清睹凤麟。\n伫看仙班朝北极，暂移星节照西秦。\n皇华礼乐君恩重，好访巅崖慰远民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访别成献甫经历时新拜西台御史之命二首 其一","author":"王圭","text":"江上秋风吹绣衣，客槎西上渺天涯。\n得为李御平生愿，一识荆州是别时。\n柏署行分秦地月，棠阴好在召南诗。\n日边消息长安近，伫听朝趋上玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"王圭","text":"云日散朝阴，清江更一临。\n北堂无草积，南浦有波深。\n春意饶芳树，晴光动翠岑。\n自惭机亦浅，劳起海鸥心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈永叔书事","author":"王圭","text":"诏书初捧下西厢，重棘连催暮钥忙。\n绿绣珥貂留帝诏，紫衣铺案拜宸香。\n卷如骤雨收声急，笔似飞泉落势长。\n十五年前出门下，最荣今日预东堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈景仁偶书","author":"王圭","text":"昔对芳樽常感慨，今同华发半萧疏。\n唐家一代成青史，汉殿多年诵子虚。\n丹凤春裁西掖诏，白麻夜草北门书。\n几时却奉承明谒，玉蕊花边并直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈景彝偶书","author":"王圭","text":"一从奉诏银台路，下马成诗夺凤毫。\n东观已陪窥秘箓，南宫又接较群髦。\n芝封紫掖文章贵，星近端门气象高。\n今是汉廷三独坐，夜吟犹许醉春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京口遇大风","author":"王圭","text":"虹蜺赫奕射中天，怒窍风号势塕然。\n云翼扶抟弥九万，海帆飞迅越三千。\n鲵嘘骇浪时开阖，鳌负灵山或溯沿。\n安得琴高控双鲤，一驱霾曀静洪渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴枢密正月二日留题曾侍中斋阁","author":"王圭","text":"昨日春风变旧年，连珂来访紫芝仙。\n三朝元仗鸿钧手，万里今同不系船。\n寿酒一倾人共醉，赐书千轴子多贤。\n从前身退如公少，莫把长竿忆渭川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和元参政喜雨四首 其四","author":"王圭","text":"君心常与下民忧，嘉应为霖讵一州。\n梦绕金人云气满，笑回玉女电光流。\n己成沃野千箱望，岂事灵坛屡舞求。\n边粟定储三百万，皋兰何必预防秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和元参政喜雨四首 其三","author":"王圭","text":"紫殿宵祈感圣忧，玉毫曾降梵王州。\n慈深三界云常聚，法遍诸天雨自流。\n袯襫趁耕皆帝力，污邪满载为民求。\n年年睿泽沾群物，愧未酬恩鬓已秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和元参政喜雨四首 其二","author":"王圭","text":"瑶津祷雨见皇忧，谁约金仙下帝州。\n楼阁绕云千地涌，鱼龙嘘水五天流。\n至精自与三灵契，殊例终缘万宇求。\n柄国老臣无异术，但将嘉荫续阳秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和元参政喜雨四首 其一","author":"王圭","text":"岁旱连春与俗忧，忽兴嘉雨遍群州。\n郊禾薿薿青如积，宫瓦差差翠欲流。\n良弼为霖辜宿望，神僧作雾应精求。\n西成喜有登年候，况此新晴见麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和王宣徽冬燕","author":"王圭","text":"丞相华堂燕斝飞，君恩自与众心期。\n鲁台况值书云后，汉殿仍经喜雪时。\n便有东风来翠幕，别翻新曲度瑶池。\n可伤衰病无才思，欲续高吟愧色丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和王宣徽春雨","author":"王圭","text":"春入东郊雨，油然协气通。\n晓澌犹未破，岁事已知丰。\n辇凤翔仙雾，台乌转瑞风。\n野农徒鼓舞，何以谢天功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和王原叔内翰禁直有怀","author":"王圭","text":"暮钥严温省，宵铃静浴堂。\n银花无奈冷，瑶草又还芳。\n梦久闻仙吹，班清犯晓霜。\n帝阍何所叩，一炷祝尧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和永叔戏书","author":"王圭","text":"良辰并与赏心难，偶对清樽且共欢。\n梦忆江湖无奈远，吟牵月露不胜寒。\n曲逢郢雪须歌尽，漏绕宫花几听残。\n朝锁楼台空怅望，欲将春恨托飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴枢密上王相公同召赴资政殿听读诗义感事","author":"王圭","text":"清晓陈经秘殿中，关睢首化属周公。\n人穿豹尾班初上，日转螭头讲未终。\n述作虽寻前圣远，讨论犹待后贤通。\n汉廷无更矜他说，自有匡衡发帝聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和宋次道龙图馆阁暴书","author":"王圭","text":"五云迎晓禁庐开，不及华衣曳老莱。\n宝藏发函金作界，仙醪传羽玉为台。\n己逢天上非常景，更约人间第一材。\n白首庙堂终乞去，明年此会定应来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和贾直孺舍人初春祠左太乙二首 其二","author":"王圭","text":"太乙灵宫近帝都，夕迎丹节下层虚。\n方从宣室承釐后，更约浮邱把袂初。\n文藻自高鹓掖诏，姓名应冠蕊台书。\n我惭昔预祠春客，曾梦钧天侍燕胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和贾直孺舍人初春祠左太乙二首 其一","author":"王圭","text":"严祠初缀汉墀班，爚爚珠熉照幄宽。\n玉殿威神来帝福，紫垣风骨敌春寒。\n芝华拥盖阴犹合，桂醑流觞饮欲残。\n拂晓东风迎马首，鸣珂归背月珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和梅圣俞从登东楼三首 其三","author":"王圭","text":"云日晖晖下碧山，谁从沧海宴初还。\n香车轣辘红尘里，紫阙岧峣瑞气间。\n午夜笙歌移法曲，满城桃李斗朱颜。\n金吾不禁天街鼓，独有文闱已上关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和梅圣俞从登东楼三首 其二","author":"王圭","text":"五云扶阙对南山，风猎丹邱烧影还。\n凤盖斗回天北畔，瑶台直到海中间。\n漏寒锦帐迟归梦，波暖金钟艳醉颜。\n谁在玉楼歌未足，林梢春鸟已关关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和梅圣俞从登东楼三首 其一","author":"王圭","text":"万灯初烧宝龙山，御路先迎綵仗还。\n紫极躔星来帝所，仙风递管落人间。\n芳醪欲泥追嘉节，红烛翻惊照病颜。\n曾从宸游燕双阙，梦魂通夕绕严关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和章枢密景灵宫奉安列圣神御","author":"王圭","text":"清都铙吹犯宵寒，宝帐云龙度帝关。\n禁跸忽传天直北，仙山元在海中间。\n九门日月蒙嘉气，六殿衣冠绘晬颜。\n翠辇归来朝献罢，千官齐拜未央班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和景仁闻喜席上作兼呈司马君实内翰","author":"王圭","text":"奉诏华林事最荣，门前几度放门生。\n三朝遇主惟文翰，十榜传家有姓名。\n碧海蟠桃和露重，丹山雏凤入云清。\n诗书教子终须立，箧里黄金一顾轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和景仁寄河中公仪龙图","author":"王圭","text":"锦江回日应迢递，闻道秋来已到城。\n南省深沉春又锁，东楼怅望雨中情。\n河声欲转吞鼙鼓，山色初明照旆旌。\n别后新诗有多少，钟嵘那得为君评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和景彝观刑部厅燕侍郎画山水二首 其二","author":"王圭","text":"秋曹壁上奇山水，官冷尤将野趣宜。\n翠竹忽逢行尽处，白云相伴看多时。\n于今绝笔谁还识，当日清吟亦欠诗。\n犹喜一来重拂拭，惭无佳句续君辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]