[{"title":"初月","author":"郑克己","text":"初月当楼动，风帘倚望斜。\n光亏微有晕，桂薄不成花。\n云淡明林叶，溪清印岸沙。\n去年寒露白，旅食在京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别蒋世修","author":"郑克己","text":"传道贤关客，寻山向会稽。\n春风千里别，花路寸心迷。\n天倚吴江阔，云随禹穴低。\n兰亭得遗墨，为我好封题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中书王舍人使北虏","author":"郑克己","text":"细马缕金鞍，文星使可汗。\n袖中天诏重，帐外节毛寒。\n烽火燕城急，尘沙朔野宽。\n安边在大体，何必斩楼兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅中遇故人","author":"郑克己","text":"云薄清溪水，天寒黄叶风。\n乡关三载别，客路一樽同。\n旧事如昨日，问年俱老翁。\n相看今古意，泪冷菊花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浙江十六夜对月","author":"郑克己","text":"急桨浮天阔，长江得月迟。\n最怜新缺后，全胜未圆时。\n夜雪潮千尺，秋风桂一枝。\n潜蛟易翻动，怨笛莫惊吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飘转","author":"郑克己","text":"飘转未归客，风帆不夜舟。\n断云依水定，薄月带沙流。\n香倚黄花岸，心清白露秋。\n林鸦栖未稳，飞乱北山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过大浪滩","author":"郑克己","text":"急浪吹飞雪，鸣篙破晓滩。\n异乡人易老，行路古来难。\n玉露晨初湿，天河夜不乾。\n飘流双鬓白，未有一枝安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"系缆","author":"郑克己","text":"系缆萦回浪，昏林入暮鸦。\n水穷人有路，天尽客无家。\n蕉叶浮春蚁，鱼歌隔浦沙。\n醉眠星斗下，寻梦卜年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青衫","author":"郑克己","text":"青衫著破禁中罗，楚泽吴江几度过。\n仕宦宛如杯水澹，朝廷空有故人多。\n渔村疏竹明风旆，烟浦斜阳起暮歌。\n欲买田园归海上，此身无奈客愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭妹贞娘节烈","author":"郑君老","text":"哀哉吾妹兮，生不逢时。\n痛哉吾妹兮，死此乱离。\n灰尘涨空兮，铁骑南驰。\n旌旗蔽野兮，日色无辉。\n凶徒蜂起兮，浊乱民彝。\n恣行劫掠兮，四野伤悲。\n我妹遇兹兮，尚在闺闱。\n若逃患难兮，计无可为。\n恐被污辱兮，决死无疑。\n一刀自刎兮，澌血淋漓。\n死仆于床兮，不变容仪。\n刀不落地兮，手尚坚持。\n英烈如生兮，人谁敢欺。\n嗟我独生兮，于世何裨。\n汝危莫援兮，恨无穷期。\n悠悠我思兮，泣涕涟如。\n人皆有死兮，特出异宜。\n哀哉痛哉兮，噫嘻。\n独存汝名兮，万古无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸葛庐","author":"郑吾民","text":"琅琊一室云，独许老龙卧。\n英气宇宙春，君臣重三顾。\n岁久化为墟，白日聚狐兔。\n惟有忠臣心，风雨不可破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游鼓山","author":"郑应开","text":"两峰峻上半天开，一水争奔急雪来。\n眺远直疑沧海近，洞灵曲坳涌泉回。\n慨思南北江山异，更陟嵯峨宇宙恢。\n眇眇愁余歌石鼓，漫磨枯墨洒苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼花","author":"郑良嗣","text":"玉立祠庭久不衰，俄经剪伐重能栽。\n端知妙护有神力，更喜当时歼厥魁。\n种不他传焉得子，年将丰稔辄多开。\n天生异物初无伴，只许翻阶近侍来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春汪若水宋寿谷见过","author":"郑芬","text":"云起松洋路，吾庐蹴水开。\n故人嫌俗缚，双骑出城来。\n春昼散微雨，邻家多早梅。\n弹琴徵古调，何处可登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"见远亭","author":"郑侠","text":"天边毫末见千峰，景物都穷见不穷。\n因念当时小天下，亦如亭上老仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出御史台","author":"郑侠","text":"万险千艰六出身，如今也得避嚣尘。\n须知从此寒原上，有个行歌拾穗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论诚","author":"郑侠","text":"万事以诚立，不诚心不专。\n诚心非铁石，铁石被诚穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳沚亭","author":"郑侠","text":"澄流良湜湜，幽藻还漪漪。\n不是采蘩手，芬芳长自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蔡公上巳","author":"郑侠","text":"恺悌侯藩修禊事，风流草木荐天香。\n使君喜为民行乐，拟筑春光作舞场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临终作","author":"郑侠","text":"似此平生只藉天，还如过鸟在云边。\n如今身畔浑无物，赢得虚堂一枕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴十五约重阳饮患无登高处","author":"郑侠","text":"道义相欢胜饮醪，况添流雪见承糟。\n卧篱一醉陶家宅，不是龙山趣也高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读史","author":"郑侠","text":"乱亡由佞舌，览古每嗟吁。\n拟刻奸谀像，申明两观诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家","author":"郑侠","text":"月满平湖夜渐深，浩波千顷荡黄金。\n不知世有荣华事，何至中藏喜惧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中见以索牵五六十人监理钱者","author":"郑侠","text":"可怜平地不生钱，稚老累累被索连。\n困苦新图谁画此，祗愁中禁又无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谩成","author":"郑侠","text":"琴虽古意元无取，诗近虚名亦懒吟。\n不是将心就无事，都缘无事可关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫成","author":"郑侠","text":"风送微凉来小户，月回清影向疏窗。\n不知人世何珍丽，可与诗书气味双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵峰平步亭","author":"郑侠","text":"天险尝闻不可升，人间危堑更难名。\n欲知平步亭中意，平得心来处处平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元符放还谢英守何智翁","author":"郑侠","text":"僦屋平山至典衣，来时便作十年期。\n岂知未报归馀闰，早有潜吟送别诗。\n圣主恩仁天地力，明公怜念父兄慈。\n征鞍拟待春和煖，催促行装愿少迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示庐山寺胜老","author":"郑侠","text":"宝鼎当年未结丹，幽栖曾此掩柴关。\n羽軿欲化乘风驭，梵锡应留解虎环。\n僧卧碧云皆寿考，鹤迷华表几时还。\n好应月白长廊下，涧水无声人自閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示潮州妹子","author":"郑侠","text":"八人兄弟三人在，独立他州信汝贤。\n直使无情如槁木，忍看垂泪念南迁。\n从今依旧歌泉水，何物偏宜寄谪仙。\n美酒年年须百瓮，好从南海便乘船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲常龙图自广中移师闽","author":"郑侠","text":"节钺依前向钓台，祥烟喜气两崔嵬。\n民思父母无穷已，天借星辰有去回。\n千里裤襦还众煖，三山楼阁为谁开。\n须知道路先腾说，又见清凉古佛来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲常龙图自广中移帅闽 其二","author":"郑侠","text":"惠兹政化及民功，内外声称有古风。\n五岭山川情正黮，七闽桃李意先通。\n大明继照天衢辟，重德还朝众愿同。\n早晚皇穹顺舆议，老人星在玉堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲常龙图自广中移帅闽 其一","author":"郑侠","text":"去年牙戟海边城，空望门阑涕泗横。\n今日去旄东向梦，那知高纛此中迎。\n岂非丈席谐瞻对，亦似云衢有否亨。\n十有馀年想谆诲，更期朱玉似河倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同子忠上西楼","author":"郑侠","text":"偶因送客上西楼，共爱佳城枕海陬。\n雁翅人家千巷陌，犬牙商舶数汀洲。\n风吹细雨兼秋净，云漏疏星带水流。\n独有单亲头早白，迢迢东望不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"权府黄叔粲朝奉双门落成之会有感而作","author":"郑侠","text":"凤管鸾丝彻太清，双门今日落功成。\n一州壮观新楼好，千里欣欢太守名。\n已见声华逾綵绚，更期中外倚端平。\n详风瑞雨年年事，海角天涯似此城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张子京游天王湖作","author":"郑侠","text":"湖上迟迟不忍还，谈玄清彻几重关。\n旋岚野马皆归静，逝鸟潜鱼各自閒。\n坠果露巢秋后树，淡烟斜日晚来山。\n吟情到此何终极，注目红云紫雾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张汉公言怀","author":"郑侠","text":"人间滚滚竟何营，只为蝇头利与名。\n千里瘴乡吾逐客，一箪穷巷子书生。\n文章相误终须别，宠辱无关自不惊。\n赢得白头闲处坐，一竿风月有谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次张君举秀才","author":"郑侠","text":"长风清洒翳天尘，捧出重光耀世轮。\n龙衮未温当扆坐，凤书先轸向隅人。\n一缄符命来差缓，四尺先坟梦已频。\n衰老将何报明主，雪霜柯干草莱身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次孟坚初冬晴和见梨桃二花作","author":"郑侠","text":"十月南天尚暑襟，幽花何怪动清吟。\n半扉素蕊呈修径，几朵夭红出茂林。\n地借小春回暖气，日匀疏影转轻阴。\n惟应幕府多才俊，不负行台醉赏心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子京下元雨过对月","author":"郑侠","text":"年虽小歉俗安苏，小雨时时济旱枯。\n天为下民成晚霁，月将三五上东隅。\n星如青女临银镜，人似寒冰在玉壶。\n想是庭前吟望久，岂殊云外一轮孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子京早春雨中","author":"郑侠","text":"花草迎春意已娇，霢如膏雨复连朝。\n昏云暗雾饶慵困，疏李残梅共寂寥。\n赖有河阳游约近，能令圃泽睡魔消。\n看看陌上千红紫，只好公孙日解貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子京述怀","author":"郑侠","text":"桑海有涯殊浩荡，蕙风无动任飘飖。\n莫穷兴废千年事，但看盈虚两信潮。\n方听民间歌道化，何为天际想归桡。\n当知得意无南北，随向生成似玉杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵广州梁有为秀才","author":"郑侠","text":"孤直惟知不愧天，飘零无复记流年。\n学从邹鲁已如此，贫甚颜原亦浩然。\n乞食偶随持钵老，入城因访跨羊仙。\n真人到了扶真道，手付瑶台刻玉篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵太守仁智堂","author":"郑侠","text":"堂下玻瓈看碧澜，天边图画指层峦。\n崔嵬切汉星辰近，清泚照人毛骨寒。\n已叹神明传政化，仍观慈惠展杯盘。\n尊前不为扶衰病，敢惜酡颜胜渥丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严巨孟 其三","author":"郑侠","text":"侠也愚而已，奚称忠与刚。\n未能安社稷，自合窜炎荒。\n国以民为本，仁当生不伤。\n君其明辨此，万里在飞翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵余纯臣通判球琅轩","author":"郑侠","text":"耸翠凌空不少盘，回环使宅对千峦。\n高华谁为球琅辟，劲节相怜霜雪寒。\n引得凤来缘有实，化为龙去始堪看。\n桐庐寂寞烟云暝，惆怅无人近钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵余倅笼碧轩","author":"郑侠","text":"万龙齐干拥高牙，占尽幽奇只一家。\n分破密阴开细路，罩将馀碧入江沙。\n静笼簪玉朝云合，暮到杯金夜月斜。\n贤守二车真可畏，尊前诗笔太豪华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张老见赠","author":"郑侠","text":"乌鸦蝼蚁有君臣，此义如何易世尘。\n欲为无穷宗社计，肯忧如幻死生身。\n八千江上奔驰路，十二天南黯淡春。\n归到亲闱捧杯酒，始知终是福唐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈秀才告别之作","author":"郑侠","text":"行橐萧萧又出门，岂应踪迹溷东园。\n诗书无地人间世，山野有亭江上村。\n几许春秋由白发，谁能枝叶事閒言。\n行矣吾衰今已矣，独将清梦到乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵环翠亭","author":"郑侠","text":"天围湖海净团圞，水色山光四座寒。\n暗结浓阴森万木，静铺遥碧拥千峦。\n共斟绿醑看浮蚁，遥见孤舟下远湍。\n是处烟云有佳隐，崎岖长道太无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡登高言怀","author":"郑侠","text":"莫向天涯说故乡，人身不似雁随阳。\n黄花满手空佳节，千里有怀如寸肠。\n为许功名酬圣代，不须愁绪付瑶觞。\n男儿不是闺中物，生则桑弧射四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵春登楼","author":"郑侠","text":"公馀閒步古城巅，迟日和风暇豫天。\n花引嫩芳迎晓露，柳垂轻絮拂晴烟。\n一尊椒桂除三品，千室讴歌在五弦。\n红紫正争春又半，断崖荒堑草芊芊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵资道秋夜闻角","author":"郑侠","text":"萧索秋城五鼓前，月临残梦正团圆。\n彤楼一曲梅花落，玉枕谁家绣带连。\n歌酒梁园人散后，弓刀秦戍雁南天。\n一般凄咽西风下，转展空床夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵清溪樊主簿","author":"郑侠","text":"欲致皇恩浃羽鳞，天涯地角尽如春。\n当年款款曾忘死，今日区区肯患贫。\n正以庭闱安梓里，谁知魂梦达枫宸。\n海邦一见如畴昔，心膂相知亦宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈元叟清轩","author":"郑侠","text":"尘坌中轩户，谁标似水名。\n物讹空自汩，人性本来清。\n天上云藏月，人间石裹英。\n云开与石裂，精瑩自分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子京霜字见寄","author":"郑侠","text":"秋深园圃虽无雨，晚岁头须自有霜。\n身事无功且人事，酒囊馀地乃书囊。\n寒雅啸侣鸣乔木，粉蝶成围过矮墙。\n对此每思良友伴，幸时来访浣愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔粲沧浪亭","author":"郑侠","text":"高亭殖殖水冷冷，笑指鸥凫坐晚汀。\n远不闻声千橹去，矫如争秀数峰青。\n烟云窗牖纷纷雨，露月蒹葭点点星。\n最好归舆拥双璧，笙歌灯火照仙屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孟坚二月晦同出城 其二","author":"郑侠","text":"城中未必闷，出郭喜还生。\n浓淡山原气，高低溪涧声。\n鸣棋振幽谷，把酒听流莺。\n疏旷还随分，何须学步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孟坚二月晦同出城 其一","author":"郑侠","text":"花柳接重闉，三分破二春。\n江梅初弄雪，垄麦旋收新。\n缨绋嗟尘事，农桑羡野民。\n暂陪游乐乘，此日是何辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和英州太守何智翁次韵冯仲礼麻江桥 其二","author":"郑侠","text":"一带危桥接市廛，春成冬坏几多年。\n谁驱巨石如填海，化作长虹下饮川。\n白水晓寒孤洞杳，红灯夜午万珠连。\n清风明月如堪买，且问如今直几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和英州太守何智翁次韵冯仲礼麻江桥 其一","author":"郑侠","text":"叠石梁空太守贤，一年功力倍千年。\n惠从今日流终古，智是当时决九川。\n有竞轮蹄何杂沓，无情风月亦流连。\n红灯焰焰三更市，从此吴江不直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和荆公何处难忘酒诗","author":"郑侠","text":"何处难缄口，熙宁政失中。\n四方三面战，十室九家空。\n见佞眸如水，闻忠耳似聋。\n君门深万里，安得此言通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季冬桃花","author":"郑侠","text":"真宰终无妄，元和岂有偏。\n如何洞天蕊，开向雪花前。\n游骑虽然阒，红芳亦自鲜。\n惟应祝融氏，偷窃玩馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽居","author":"郑侠","text":"萧条深巷寄门墙，城郭村居事异常。\n石展地衣三药径，锦围天柱十花樯。\n幽禽隔树钩胶语，异草摇风合和香。\n不觉冬归与春到，但知无事日偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林六秀才之广劝其早归","author":"郑侠","text":"无情乌兔两相追，岁月蹉跎一箭飞。\n解报劬劳能几日，可堪容易旷慈闱。\n须知楚国千钟粟，不直莱庭一綵衣。\n我念松楸心独苦，故知吾子不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫成","author":"郑侠","text":"衲帽麻衣君勿轻，有如华衮贵难名。\n人须自力方能立，事若无诚断不成。\n倚物蔓条终嫩脆，冒霜寒柏始坚贞。\n男儿一副黄金骨，莫学伊阿浪死生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辞方公悦","author":"郑侠","text":"又承尊酒细论文，日日樽前得未闻。\n怜旧直忘趋走贱，有疑俱向笑谈分。\n心缘明德怀高屏，日为偏亲断远云。\n明日迢迢东郭路，未行离思已纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]