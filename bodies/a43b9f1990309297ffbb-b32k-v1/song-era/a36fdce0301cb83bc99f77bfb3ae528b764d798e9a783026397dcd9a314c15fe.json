[{"title":"次韵陈学正 其二","author":"陈造","text":"自审江湖槁项翁，浪将张邴并高风。\n就闲耕钓真无说，投合侯王况不工。\n策足不应诸俊后，如君宁复老夫同。\n亟须秉烛欢游地，行簉英雄入彀中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈学正 其一","author":"陈造","text":"区中尘外自由身，囊不留钱最入神。\n便约春秋同保社，不妨天地著陈人。\n园翁溪友曾无间，野蔌山肴继荐新。\n却叹声名雪堂老，莫年岭海梦峨岷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈倅赵宰双竹","author":"陈造","text":"两君深结此君缘，句里萧森堕我前。\n笋茁便应欺瑞麦，诗成端合付双莲。\n窗间俪影斜新月，风处骈梢袅绿烟。\n会拟韩公颂连理，为渠小辍枕书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈梦锡","author":"陈造","text":"手板夤缘替荷锄，从渠争挟子公书。\n三年已办青箱蠹，一饱才分代舍鱼。\n烟烬萁炉朝兀兀，窗明风霰夜疏疏。\n独思把酒看君醉，墨汁淋浪点翠裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周秀才","author":"陈造","text":"暇日枝筇对摇落，衰年悲感为谁多。\n政疏里俗有嗫呫，身远贵游无孰何。\n耐病阻陪吹帽醉，祛愁聊复击樽歌。\n诗来起我湖海兴，梦逐狎鸥分白波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵招饭不赴","author":"陈造","text":"吏能儒业实惭名，晚喜论交盖代英。\n千里久劳魂梦往，一欢犹阻咄嗟成。\n粲花论胜违频听，击钵诗工况莫京。\n别后槱溪萦望眼，此心川水漫东倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林子长","author":"陈造","text":"诗坛旧同歃，攀附不无因。\n揽辔今肤使，回辕记老身。\n云泥知已隔，谭笑尚容亲。\n不记棋前酒，当时定几巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林子长一首","author":"陈造","text":"使华不袖生春手，绛老泥涂亦使年。\n病后隐沦甘甫里，向来魂梦颇祁连。\n受廛已傍乡三老，对客还矜我二天。\n处士一星君漫记，会扬光彩映台躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵罗春伯提举","author":"陈造","text":"龙公靳飞雨，盍趁望时来。\n尚及丰年计，真令笑口开。\n池莲端自若，月地信佳哉。\n倚槛西风夜，题诗判费才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑同年饯行","author":"陈造","text":"一官自食天水草，群隽追奔风马牛。\n俭幕胡宁效涓滴，孔装未拟借膏油。\n交情顾我失一臂，才地较君输几筹。\n更引功名挽衰朽，天生江水不西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵战舰","author":"陈造","text":"下濑千艘旧擅名，汉家虓将况飞英。\n呼韩款渭人胥后，小耿平齐事竟成。\n击楫定无违庙算，覆盂端有奠神京。\n圣君动静天人合，持满何妨亦定倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其二","author":"陈造","text":"北归客子谩贪忙，河欲生冰野覆霜。\n他日鹳鹅常避敌，即今竿木又逢场。\n思迟正坐相如渴，文好知熏武仲香。\n妙语鼎来吾拜手，乳泉更用汲银床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其三","author":"陈造","text":"我亦饱参僧，赢粮走百城。\n诸公传句法，夫子擅诗声。\n自笑屠龙误，时须画鹜成。\n峨肩出苦语，蛩夜共凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其二","author":"陈造","text":"腹里群经笥，毫端五字城。\n少陵宁漫兴，侯喜欲无声。\n窃听锵金奏，仍闻破竹成。\n君知盥手处，毛骨为谁清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其三","author":"陈造","text":"月姊多情闯绮窗，停云著意护飞霜。\n艳桃秾李宽围坐，舞雪歌云各擅场。\n醉倒不堪酬礼数，归来赢得梦魂香。\n明朝谁省扁舟客，但载茶铛与笔床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其一","author":"陈造","text":"藩方人奠枕，楚尾铁为城。\n晓日熙仁惠，春雷殷政声。\n护边一李绩，增户几王成。\n笑指琼花露，如公彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅四首 其四","author":"陈造","text":"舟子喧呼解缆忙，驼裘答飒冷禁霜。\n行分槁项新岐路，心属毛锥旧战场。\n谈笑惯陪北海酒，馥膏拟炷后山香。\n诗筒傥肯生毛羽，飞到幽人梦蝶床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅岁暮","author":"陈造","text":"虚心观物变，投老得诗穷。\n玄草居然白，炉萁却暂红。\n诗缘梅隽发，愁倩酒消融。\n未用凌羁客，疏帘逗雪风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅登平山堂 其三","author":"陈造","text":"修月于今第一功，后车九万蜀笺红。\n诗供寒食莺花课，袖拂平山杨柳风。\n匝坐蕙兰歌似剪，生香笑语酒如空。\n胡床不减南楼兴，今古风流正自同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅登平山堂 其二","author":"陈造","text":"平章景物我何功，犹博宾筵醉颊红。\n欢甚锐戈思却日，吟馀豪兴欲凌风。\n急觞泛滟春浮渌，掺鼓喧轰雁堕空。\n白雪拜嘉仍袖手，汗颜终恐坐雷同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅登平山堂 其一","author":"陈造","text":"东皇未慭养花功，远近娇红乱老红。\n胜赏已容陪隽轨，凭虚仍喜受雄风。\n小?蜀井寒冰齿，旋俯波光碧蘸空。\n更看诗翁落椽笔，弹丸句法许谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵帅赏古梅","author":"陈造","text":"把酒花前量自宽，花同人意惬轻寒。\n盈盈似驾翠虬起，特特为邀青眼看。\n纸贵共誇诗律细，客来旋报粉香残。\n若为白璧青钱费，可问东君博此欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵教授 其一","author":"陈造","text":"争米何心问斗城，聚蚊底许太狂生。\n未遑饩粟如子罕，谩复公言付阿平。\n缓我愁肠千缕结，羡君笔力万钧轻。\n何时去上中和颂，却用诗情写物情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵教授 其二","author":"陈造","text":"携孥西垒复东城，触处千愁百恨生。\n如许尧民艰粒食，未应汉法废常平。\n爱君长策三农重，泥古迂儒一芥轻。\n会略文移倒陈廪，一时骨肉慰皇情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁丈知府喜雨","author":"陈造","text":"使君今代段荆州，指顾为霖旱不忧。\n比屋便令开笑口，散人亦复掉吟头。\n封君擅富宁容数，义廪赒贫可待求。\n想阅贺章天更喜，津津玉色动凝旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪雪二首 其二","author":"陈造","text":"天怜梅蕊怯摧残，善后何妨小作悭。\n一雪应期真望外，三诗说喜想颜间。\n瑶花已兆食四釜，沉炷为通天九关。\n捲帐盍酬民气乐，苏台持酒挹湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁宪雪二首 其一","author":"陈造","text":"犯雪回帆岁遽残，自怜雨涩更风悭。\n从游已落邹枚后，著语渠能季孟间。\n梦逐蜚仙凌色界，谁因逋客护云关。\n独思快目毗陵晓，玉衬金波妥锡山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁提刑劳军许浦中路风雨","author":"陈造","text":"方隅咫尺俨威颜，穷谷回春不作难。\n渥泽欲随金节到，先声已失铁衣寒。\n来时敢惮风将雨，泊处仍听浪卷滩。\n天自与公供壮观，海涵云物正阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭教授雪二首 其一","author":"陈造","text":"皇心忧喜与民同，帝意深怜岁不丰。\n瑶检何时下仙界，瑞花一昔覆寰中。\n和声已自消疵疠，陈廪从知饱困穷。\n今世皋夔活国手，信知人职代天工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭教授雪二首 其二","author":"陈造","text":"诗力骎骎雅颂同，人言平处逼熙丰。\n清篇自昔传平水，妙曲何人和郢中。\n颇怪鲸牙须手揽，悬知鼠技笑吾穷。\n衰慵合袖推敲手，且可旁观斲鼻工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高机宜送别 其一","author":"陈造","text":"棋枰诗课忆同堂，转首暄寒几蔀章。\n每叹羁离念陈迹，更因衰病感流光。\n亟催江鹢休停棹，已信溪禽不乱行。\n鱼澳芋区真好在，连宵归梦为谁长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高机宜送别 其二","author":"陈造","text":"士价如君定玉堂，陈陈腹笥汉文章。\n即今綵笔春争媚，它日青藜夜有光。\n诗力不劳凌汝辈，才名况自溢班行。\n清篇见属吾何取，愧闯辞坛阙寸长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高宾王见投四首 其四","author":"陈造","text":"知君斲句为祛愁，得句须防有暗投。\n我病床头但周易，人谁皮里著阳秋。\n骑驴久袖推门手，载酒慵移捉月舟。\n祇命君诗作三益，伴翁听雨卧徐楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高宾王见投四首 其三","author":"陈造","text":"檐花如雾湿黄昏，犹梦君前白兽樽。\n但有红尘染衣袂，更堪碧草思王孙。\n逃威正坐齐竽谬，歈舞难招楚客魂。\n回首仙曹云雨上，谁云九虎踞天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高宾王见投四首 其二","author":"陈造","text":"病念还家可奈愁，客中日月急梭投。\n土花晕壁迎梅雨，海燕将雏送麦秋。\n沾袖正怜珠陨睫，关门能复玉为舟。\n支头閤膝高舂卧，黄奶青奴共此楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高宾王见投四首 其一","author":"陈造","text":"残年病眼苦眵昏，尽屏甘腴誓绿樽。\n龙树难逢刮膜手，孟公顾有独醒孙。\n颇烦十吏供挥扫，无奈诸峰役梦魂。\n友义惟公记衰疾，新编肯到雀罗门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高缙之二首 其二","author":"陈造","text":"奚囊走湖海，襟度极风流。\n学力隐一敌，才华追二刘。\n与时君有用，漫仕我非优。\n它日霄霏上，诗成复寄不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵高缙之二首 其一","author":"陈造","text":"能事馀千牍，幽期自一丘。\n向来书襞积，不疗客漂流。\n小挹苏耽鹤，同歌宁戚牛。\n几时诗酒社，相属话天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄王帅属","author":"陈造","text":"才华奔逸可能追，我识王郎自壮时。\n酒处每看鲸吸海，书成还想墨为池。\n穷交徒自怜东野，孰看于今敬道儿。\n莫靳诗筒数还往，人生何处不儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄汪教授二首 其二","author":"陈造","text":"客路何人起病怀，论交今得谪仙才。\n每当玉麈玄谭胜，不问铜壶漏箭催。\n鲁泮旧常烹瓠叶，广平聊复赋江梅。\n揆予傥可陪英轨，莫向诗筒靳往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄汪教授二首 其一","author":"陈造","text":"友贤端许写中怀，千丈孤标十倍才。\n黄绢旧知儒业富，黑头宁受岁华催。\n笔囊小却司盘诰，鼎实终期荐傅梅。\n指日元侯矕龙衮，未容文学久低回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵寄陈主管","author":"陈造","text":"轺軿七十晓相追，记得张园叙拜时。\n香衬蕙兰来北里，云随笙鹤燕仇池。\n朋簪重盍宁人力，贫仕居卑听化儿。\n祇冀幕莲分靫菂，诗坛棋社与闲嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵常倅俞君任二首 其二","author":"陈造","text":"与君颜面各临年，同滞江湖恐不然。\n虎兕向来甘旷野，骅骝宁复待挥鞭。\n政成合进凌霄步，客里犹抬斲句肩。\n人品国华君可仰，岂应学我赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵常倅俞君任二首 其一","author":"陈造","text":"匆匆同醉记前年，客路重逢亦偶然。\n理窟扣君弥入域，生涯怜我欠加鞭。\n了知富贵难投足，共约归来径息肩。\n旧欲将雏卜邻去，未应须办十牛田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵常熟感旧","author":"陈造","text":"诗囊随处纪山川，古县繁雄更海边。\n按节将春巡甲垒，循陔回首记丁年。\n綵衣尚念亲三釜，芝检终当岁九迁。\n移孝为忠贤圣事，期公迄反汶阳田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵章守移学","author":"陈造","text":"千柱崇成俨旧规，小劳移筑未为非。\n诸儒受业三熏沐，贤守收功一指挥。\n蒇事此时争拭目，决科它日看增辉。\n问玄亦复侯芭事，可但经生识指归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵章宰 其二","author":"陈造","text":"游旧多厌绝，怪君终眷知。\n帐留仍碧酒，纻献更清诗。\n风义固难及，月评无乃私。\n相从文字乐，悔作十年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵章宰 其一","author":"陈造","text":"穷山从薄宦，小郡著衰翁。\n政术甘疏拙，辞坛敢长雄。\n一饥才自救，五细未宜中。\n又拟包羞去，京尘冒软红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵彭景贶","author":"陈造","text":"鸠杖随身去，乡园得自娱。\n红鲜终日有，俗物向来无。\n酒所挥椽笔，风前据槁梧。\n逢人休举似，儿辈笑吾徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵彭景贶","author":"陈造","text":"紫燕穿帘若有求，为人端作置书邮。\n诗翁别后犹能酒，妄尉归来亦未侯。\n江閤香温留语笑，花楼月好记从游。\n即今满眼悲凉意，投老宁禁此段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅二首 其一","author":"陈造","text":"平时渭北与江东，文会宾筵幸许同。\n政使迟迟嗟去鲁，未应咄咄遽书空。\n抄诗奚翅无瑕璧，会意俄乘在下风。\n更喜朝来宾雁足，阳春封寄客涂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅二首 其二","author":"陈造","text":"从昔文章盖代翁，言间有物自无同。\n娟妍徒玩花含露，洒落还惊月印空。\n底许贱工惭擢矢，信知妙斲有成风。\n古今一印元呈露，要在神融领会中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅二首 其二","author":"陈造","text":"人间尘不到筹边，诗老乘閒思涌泉。\n千佛香名仍世继，一灯素业自家传。\n斗城一去嗟多病，宾幕重登便半仙。\n要看诸郎各行马，染须膏面计留年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅二首 其一","author":"陈造","text":"满怀披雾慰生平，到日音容隔暮城。\n想见舟中留郭泰，可能酒处欠公荣。\n韦家相业应门户，谢氏才华况弟兄。\n愧我携儿在尘滓，寸田硗埆望茨京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅游习池三首 其三","author":"陈造","text":"青编勋业笑谈追，千载生贤瑞圣时。\n竹帛会书河似带，封疆不止汉为池。\n玄谭日属王平子，妙语心轻谢客儿。\n来岁赏花应帝所，赓歌宣劝倍欢嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅游习池三首 其二","author":"陈造","text":"清明胜赏尚容追，不减觞浮曲水时。\n坐觉晴云恋歌扇，看供吟笔泻天池。\n春光有底遽如许，酒量勉添些子儿。\n可但大堤民气乐，啼莺语燕共嬉嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程帅游习池三首 其一","author":"陈造","text":"牙纛犹容后乘追，枕书不出此何时。\n香飘玳席千花坞，影倒妆光百子池。\n诗句肯藏扪虱手，仙曹容著牧羊儿。\n回思行李冒尘土，更喜百忧偷一嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答许推章宰二首 其二","author":"陈造","text":"北来青翼导霓旌，翩若凌云鹤驭轻。\n烟柳困眠才寤晓，露花酣醉正熹晴。\n献之能赋虽辞罚，楚客同醒恐不情。\n豪兴尚堪追少隽，漏卮灌酒鲙长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答许推章宰二首 其一","author":"陈造","text":"矞云非雾霭飞浮，满听游人载路讴。\n痛饮君能判濡首，新翻我亦办缠头。\n羽觞潋滟风微度，翠盖蹁跹晚尚留。\n且倩银钩写陈迹，未须诗律压刘侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答张丞","author":"陈造","text":"顾省辞华分槁乾，簿书堆里作粗官。\n客怀止饮仍多病，海气乘秋早戒寒。\n好语相濡真禁脔，不才持答欠琅玕。\n从今恶况能排遣，日课君诗一再观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答高宾王 其一","author":"陈造","text":"向来骑凤下天津，冠屦因循混世尘。\n行处西湖作西子，静中佳茗是佳人。\n秋风暗凝金茎露，香雾潜浮海树春。\n唤萼绿华书玉叶，人间新笔有通神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答高宾王 其二","author":"陈造","text":"陂量如君信有容，诺金到我岂宜蒙。\n蛾眉自古偕三惑，虎旅何心待九攻。\n雨室聊辞秉烛女，石肠莫笑叩舷翁。\n吾徒妩媚青编在，檗茹冰栖定隽功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答龚泽卿","author":"陈造","text":"君如绿耳抹流沙，躞蹀追风不待挝。\n缀葺曾童楚山竹，燕游行插曲江花。\n久烦凤诏搜奇逸，定复龙光叠宠嘉。\n叱咤即今凌笔阵，坐令楚幕集归鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答德瑞","author":"陈造","text":"诗客胸襟旧绝尘，惠然分我一缄春。\n裁成蜀国添花锦，贵重丹砂伏火银。\n暮雨朝云知有梦，琼枝璧月可无人。\n要须共醉彭宣酒，莫诿忘情宋玉邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]