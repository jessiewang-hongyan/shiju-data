[{"title":"明月亭下作","author":"孔武仲","text":"杳杳芜城起暮钟，亭亭华月照秋容。\n便疑碧海依墙堑，云水情知隔万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"板桥辞太母灵舆三首 其三","author":"孔武仲","text":"郁郁陵台瑞气多，短箫声裂想悲歌。\n西郊泪尽身先返，唯有心随洛水波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"板桥辞太母灵舆三首 其二","author":"孔武仲","text":"元夕三宫綵仗随，月华灯彩近瑶池。\n连昌故老曾经见，似梦如醒恍自疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"板桥辞太母灵舆三首 其一","author":"孔武仲","text":"吉仗凶仪备古今，哀歌仍杂管箫音。\n喧阗四海脩同轨，未满君王孝养心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍新辟西窗二首 其二","author":"孔武仲","text":"几岁榴花蔽曲隈，繁阴初逼坐中来。\n西邻小槛如图画，偷入帘帷次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍新辟西窗二首 其一","author":"孔武仲","text":"推倒西墙平日功，暑天饶作一窗风。\n人间岂有炎凉隔，只在施为向背中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祅庙祈晴","author":"孔武仲","text":"丛祠斋浣夜焚香，解带投眠小簟凉。\n云色倚秋犹缥缈，雨声羞晓故摧藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"侯塘渡","author":"孔武仲","text":"空山宿雨涨前溪，芳草连云欲渡时。\n落日人心急星火，招招舟子更来迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城上乔木","author":"孔武仲","text":"城上苍虬困不醒，春阳己半未回青。\n只应一夜新雷震，渐放繁枝拥日星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词二首 其二","author":"孔武仲","text":"云雾猊香锦绣堆，千官重列序宾仪。\n欲知湛露零萧处，尽在天杯侧劝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词二首 其一","author":"孔武仲","text":"十顷西池碧近天，春深调马教龙船。\n至尊勤政欢嬉少，企望銮舆又七年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将至湖口作","author":"孔武仲","text":"一帆安稳转汀洲，吞吐波澜画鹢遒。\n三尺龙文光景动，川平何处有蛟虬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待朝","author":"孔武仲","text":"山轩斜透山南月，坐看天边桂影移。\n圆扇矮床凉透骨，匆匆无奈上朝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故县遇风二首 其二","author":"孔武仲","text":"积雨成湖客路长，春风掀搅意何狂。\n残云吹尽真天力，乞我晴明入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故县遇风二首 其一","author":"孔武仲","text":"狂风奔屋似輣车，旅枕清寒一倍加。\n半夜雨声收拾尽，晓来飞雪不成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送十二兄还江西","author":"孔武仲","text":"匣有青萍笥有书，西风只影渡江湖。\n剩收岳麓春前景，写入新诗胜画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧惠芝归东林","author":"孔武仲","text":"东林开士解谈禅，共住千岩万壑前。\n回首归云不知处，林间相遇是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除宣城守赠元忠毅父次其韵","author":"孔武仲","text":"垂杨正好移舟看，轻舸何妨出沐迟。\n叠嶂双溪虽未历，白云芳草已相知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家居三首 其一","author":"孔武仲","text":"毁誉平千载，穷通譬一毛。\n虹蜺千丈气，岂便伏蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峰顶","author":"孔武仲","text":"苦霰悲风作斧斤，千秋松竹损精神。\n似闻犬吠白云外，犹有秦时避世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过州桥","author":"孔武仲","text":"晓日苍凉宿雾东，蓬莱金碧起浮空。\n沧溟万里排天去，人物纷纷海市中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读梁武帝纪二首 其二","author":"孔武仲","text":"锄决堤防纵怒涛，横流四海尽滔滔。\n单于已入朝阳殿，软语空疑定力高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读梁武帝纪二首 其一","author":"孔武仲","text":"破除纲纪事虚空，可恨萧家一老翁。\n鱼烂土崩俱自取，不须侯景到江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒帘","author":"孔武仲","text":"闪闪风中誇绿醽，当年匹马下旗亭。\n秋原败叶声如扫，只有云山伴醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄范清老二绝 其一","author":"孔武仲","text":"高平处士节尤孤，门掩江边径欲芜。\n诗好未窥新岁集，酒醇犹忆去年壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄范清老二绝 其二","author":"孔武仲","text":"一别浔阳已隔年，官居应接谩纷然。\n南来瀑水倾江海，梦挈尘肝先洗湔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄信守王子明 其二","author":"孔武仲","text":"年来江上苦多风，匹马关山重复重。\n须信心闲为乐地，主人窗槛有仙峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄信守王子明 其一","author":"孔武仲","text":"清香一炷道家仪，贝叶云签自诵持。\n尽是铃斋潇洒趣，红尘奔走尔为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄南康徐大夫","author":"孔武仲","text":"山南泉石有馀清，几日篮舆天上行。\n亦欲西园伴飞盖，庞公不惯入州城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小井","author":"孔武仲","text":"团团样学天边月，汨汨声回地底泉。\n剩贮黄金还屋税，此功宁止见山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹家巷税居三咏 小椿","author":"孔武仲","text":"渺小墙阴数尺栽，儿童欲拔几徘徊。\n须知造化机关敏，坐见童童羽扇开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹家巷税居三咏 小槐","author":"孔武仲","text":"合抱庭槐已是奇，何年春色长孙枝。\n主张莫使随薪槱，会见繁柯偃盖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维那观师以偈示余求诗为赠因成两绝句 其一","author":"孔武仲","text":"扰扰长途策马回，柴门寂寞昼慵开。\n清香一炷茶一啜，赖有高人数往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦绣谷二首 其二","author":"孔武仲","text":"帝忆庐山万玉妃，狂风浩荡唤春归。\n繁华过眼一朝尽，惟有珍禽无数飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦绣谷二首 其一","author":"孔武仲","text":"江城已月芳菲尽，残紫深绯到谷中。\n最是庐山佳丽处，我来萧飒已秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中呈鲁直","author":"孔武仲","text":"日过鳌山三丈红，陈编相对鬓如蓬。\n朱门请谒无时了，且访东邻慢?翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州二首 其二","author":"孔武仲","text":"山上泉声风雨来，门前峰色画屏开。\n仙居洞里桃花古，不是刘郎去后栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州夜泊听水声因为绝句以广欧阳公诗话","author":"孔武仲","text":"泠然非徵亦非商，夜久清音入梦长。\n人道官蛙成鼓吹，我知风水是霓裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓目","author":"孔武仲","text":"啾啾黄雀在枝间，岁晚荒郊怨苦寒。\n容易惊飞无处所，人家曾借画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭泽山","author":"孔武仲","text":"山矶环合辟鲸虬，白水如汤动地流。\n崖崿尽成斤斧迹，当年谁与化工谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景灵宫殿多植荼蘼清香远闻","author":"孔武仲","text":"宫殿沈沈锁碧云，仙葩相倚正敷芬。\n珠帘翠幄知多少，不碍清香处处闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘上二首 其一","author":"孔武仲","text":"满眼青湘浸绿苔，谁家篱援坼寒梅。\n天容婉美霜云薄，己逗春光入望来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"腊月三日","author":"孔武仲","text":"寒窗劲色晓覃覃，又见京华腊月三。\n官渡梅花应照水，香清回首忆江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落日","author":"孔武仲","text":"光彩沉沉万木西，青空围出酿燕脂。\n家园正对荒陂望，恰似腾波出海时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遇行人","author":"孔武仲","text":"我托南车去，君挐北辔还。\n相看一梦里，好入画图间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安铺三首 其三","author":"孔武仲","text":"簟如秋水憩回廊，素月分辉百倍凉。\n山木交加无意绪，故教疏影到人床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新安铺三首 其二","author":"孔武仲","text":"薄云斜日乱山川，投得荒亭晚息肩。\n地僻谁知藏好景，庭前花数折金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暖轿","author":"孔武仲","text":"垂帘为户竹为舆，千里征行似宴居。\n达摩无心惟稳坐，倪宽已老更耽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暖轿二首 其二","author":"孔武仲","text":"淮山万点雨晴初，日日寒帷望太虚。\n野阔天低今可压，闭帘无事只看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暖轿二首 其一","author":"孔武仲","text":"双袖深笼两脚垂，朝寒乘快度荒陂。\n春风浩浩无边际，似驾乌云过海时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧芦蓼花在天庆观","author":"孔武仲","text":"御水泱泱绕禁闱，碧芦红蓼转相宜。\n玉堂金阙非人世，亦有繁华具尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡州 其二","author":"孔武仲","text":"忆曾醉看仙翁树，骑马重来二十年。\n百尺湖台蘸春渌，月华依旧到樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡州 其一","author":"孔武仲","text":"亭下湖光凝不流，银灯玉斝缀绸缪。\n主人今是真黄霸，民誉仍推郭细侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜡梅二绝黄鲁直云王都尉有之邀同赋 其二","author":"孔武仲","text":"清嫌冰麝俗，淡学池鹅黄。\n情知不是蜡，风定有馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲春听琵琶五首 其五","author":"孔武仲","text":"夜如何其夜未央，山城斗转星煌煌。\n收琴插拨各无语，酒美不知春漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲春听琵琶五首 其四","author":"孔武仲","text":"百转干萦住复移，浑如啄木在高枝。\n春郊极目快晴后，峭绝一声飞去时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲春听琵琶五首 其三","author":"孔武仲","text":"北踏胡霜汉马骄，千秋琴调思娇娆。\n华堂夜饮灯如昼，共听新声不寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲春听琵琶五首 其二","author":"孔武仲","text":"新自浔阳江上来，虽闻此曲不悲哀。\n轻拢细撚俱清绝，指法何惭二善才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕲春听琵琶五首 其一","author":"孔武仲","text":"银烛交光桂酿清，亲朋相见苦多情。\n春宵万籁俱澄绝，初试鹍弦骤雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题报慈寺花药园","author":"孔武仲","text":"少时随众蹂京尘，曾倚朱栏看晚春。\n二十年间头半白，方知花木解磨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"橙子","author":"孔武仲","text":"秋露凝浆细，朝阳入色深。\n冰齑不须捣，恐碎袅蹄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罾鱼","author":"孔武仲","text":"野色星辉半有无，曲江舟子夜罾鱼。\n红鳞跃网无钱买，惆怅天涯尺素书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"骤雨","author":"孔武仲","text":"骤雨随风入汉关，倾都欢喜破愁颜。\n电光犹恐龙潜伏，闪烁馀辉绕壁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其六","author":"孔武仲","text":"窈窕东注壑，舒徐南入江。\n寄声沧海若，高洁此难双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其五","author":"孔武仲","text":"接石为槽绕画檐，清风爽气坐来添。\n恰从天外为飞瀑，又向人间作水帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其四","author":"孔武仲","text":"沉浮又似缀汀鸥，石齿横斜咽复流。\n莫放阴云遮洞府，最宜明月挂高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其三","author":"孔武仲","text":"晴天如练雨成雷，飞洒青空亦快哉。\n推倒西峰一百丈，试观河汉所从来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其二","author":"孔武仲","text":"山头飞瀑海中潮，此理谁能问泬寥。\n秪恐分流从月窟，桂香无限到西桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布六首 其一","author":"孔武仲","text":"悬崖倾注自成川，六月溪风为肃然。\n不是化工移用巧，尾闾应亦有穷年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月廿二日西馆雨中作","author":"孔武仲","text":"西馆萧然拥罽裘，浑无桃李似潘侯。\n路多绿竹遮栏雨，池有残荷掩映秋。\n蛮獠讴歌逢乐岁，江湖风景忆扁舟。\n衣冠到底为身累，秪慕逍遥寄一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九华山","author":"孔武仲","text":"扁舟重过九青莲，极目空明思浩然。\n可是画工烦刻画，只因山骨偶枝骈。\n风高迥认龙腾海，云散初疑剑插天。\n剩采太湖嵌孔石，南窗排列伫飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二湘","author":"孔武仲","text":"斯文常绝息，二子振波澜。\n旧国清风在，荒阡古木残。\n苍苔生閟宇，斜日下长竿。\n求福今无数，不将陈蔡看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入万家园","author":"孔武仲","text":"行尽东南郡，重来访旧居。\n此心能有止，他境更谁如。\n入径看生笋，临池想跃鱼。\n仍贪田舍乐，植杖劝芸锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入山三首 其二","author":"孔武仲","text":"路出西林兴倍长，轻衫短盖入秋阳。\n层崖蔽日多清影，深谷迷人有异香。\n访古不辞穿绝磴，参禅直为遍诸方。\n此身似是辽东鹤，偶逐飞云到故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十一月十六日入馆","author":"孔武仲","text":"一雪初乾晓日红，行人争道已憧憧。\n泥萦马足行初踬，寒犯貂裘力正浓。\n地逼新阳虽喜气，云垂沧海更愁容。\n便应买酒邀俦侣，烂醉高眠群玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十二日后殿朝参","author":"孔武仲","text":"广殿泬寥边，鸣靴趁静鞭。\n中霄黄道直，诸御锦袍鲜。\n夜雨尘如洗，秋槐影尚圆。\n银台不奏事，人乐太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月十六日后殿朝谒","author":"孔武仲","text":"晨光先到帝王州，别殿珠帘不上钩。\n万岁声齐山献寿，九门朝退海分流。\n参差雉尾回丹陛，杳远鸡声下禁楼。\n年少曾来奏词赋，钧天却记梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十二月朔入局","author":"孔武仲","text":"坐听禅林叩晓钟，官曹遥指禁城东。\n千门洒扫冰镵路，万木号呼叶受风。\n金殿放朝閒虎士，蟾泓挥翰冷瑶宫。\n春晖闭目无多日，预草新文拟送穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]