689","path":"宋_1.csv","pointer":2299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀高禖十首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"聿分春气，施生在时。\n禖宫肇启，精意以祠。\n礼仪告备，神其格思。\n厥灵有赫，锡我繁釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其十一 送神用《静安》。","author":"郊庙朝会歌辞","text":"神之来止，风驶云翔。\n神之旋归，有迎有将。\n歌以送之，磬筦锵锵。\n何以惠民，丰年穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其十 彻豆用《歆安》。","author":"郊庙朝会歌辞","text":"莫重于祭，非礼不成。\n笾豆有践，尔殽既馨。\n神具醉止，荐以齐明。\n赞彻孔时，釐事斯成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其九 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"幽明位异，施报理同。\n克恭明神，降福乃丰。\n我膺受之，来燕来崇。\n岂伊专飨，于彼三农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其六 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"羽毛干戚，张弛则殊。\n进旅退旅，匪棘匪舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其五 酌献用《禧安》。","author":"郊庙朝会歌辞","text":"蠲涤盏斝，巾帨而升。\n挹彼注兹，酒醴维清。\n洋洋在上，享于克诚。\n神其孚佑，以厚民生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其四 尚书奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"柔毛刚鬣，或剥或烹。\n为俎孔硕，登荐厥诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其三 神农、后稷位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"制为量币，厚意是将。\n求之以类，各因其方。\n于以奠之，精诚允彰。\n神其享止，惠我无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其二 迎神用《静安》。","author":"郊庙朝会歌辞","text":"猗欤田祖，粒食之宗。\n世世仰德，青坛载崇。\n时惟后稷，躬稼同功。\n作配并祀，以诏无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴享先农十一首 其一 皇帝入内壝盥洗用《隆安》。","author":"郊庙朝会歌辞","text":"大事在祀，齐洁为先。\n既盥而升，奉以周旋。\n下观而化，无敢不蠲。\n惟神降格，监厥精虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祈谷三首 其三 太宗位酌献用《德安》。","author":"郊庙朝会歌辞","text":"天锡勇智，允惟太宗。\n功隆德盛，与帝比崇。\n礼严陟配，诚达精衷。\n尚其锡祉，岁以屡丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祈谷三首 其二 上帝位酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"三阳肇新，万物资始。\n精诚祈天，其听斯迩。\n愿均雨旸，田畴之喜。\n如坻如京，以备百礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祈谷三首 其一 太宗位奠币用《宗安》。","author":"郊庙朝会歌辞","text":"于穆思文，克配上帝。\n涓选休成，遵扬严卫。\n祗荐明诚，肃陈量币。\n享兹吉蠲，申锡来裔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十五 太宗位酌献用《韶安》。","author":"郊庙朝会歌辞","text":"绍天承业，继世立功。\n帷幄屡胜，车书始同。\n武扫氛雾，文垂日虹。\n遗泽所及，孰知其终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十四 望燎用《仪安》。","author":"郊庙朝会歌辞","text":"载酌载献，以纯以精。\n歌传夜诵，物备秋成。\n报本斯极，听卑则明。\n愿储景贶，福我群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其七 太祖位奠币用《广安》。","author":"郊庙朝会歌辞","text":"推尊太元，重屋为盛。\n谁其配之，我祖齐圣。\n开基握符，正位凝命。\n于万斯年，孝孙有庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其九 徽宗位奠币用《泰安》。","author":"郊庙朝会歌辞","text":"于穆帝临，至矣元造。\n克配其仪，惟我文考。\n仁恩广覃，奕叶永保。\n宗祀惟初，以扬孝道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十 终献用《穆安》。","author":"郊庙朝会歌辞","text":"诚一为专，礼三而称。\n孰陪邦祠，惟我同姓。\n金丝屡调，圭玉交映。\n是谓熙成，福来神听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其十六 徽宗位酌献用《成安》。","author":"郊庙朝会歌辞","text":"钦惟合宫，承神至尊。\n祗戒专精，俨然若存。\n奠兹嘉觞，茝兰其芬。\n发祉隤祥，以子以孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其四 盥洗用《仪安》。","author":"郊庙朝会歌辞","text":"肇开九筵，维古之仿。\n皇皇大神，来顾来享。\n庶仪交修，百辟显相。\n微诚自中，交际天壤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴亲享明堂二十六首 其二十五 望瘗用《仪安》。","author":"郊庙朝会歌辞","text":"礼协丰融，诚交彷佛。\n辟公受膰，宗祀临瘗。\n贻我来牟，以兴嗣岁。\n山川出云，天地同气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]