[{"title":"李司直会客吴运干有诗次韵","author":"戴复古","text":"使君高会集群仙，也使狂夫坐细毡。\n白璧一双酬议论，青春十载棹觥船。\n客愁遇酒退三舍，梅信与春开一先。\n已办扁舟明日去，几时重得到花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李季允侍郎舟中","author":"戴复古","text":"忆昨枫桥既语离，何期千里又相随。\n太湖不见鸱夷子，秋浦同寻杜牧之。\n灯火船窗深夜话，江山客路早冬诗。\n人间草木空无数，除却梅花莫我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李深道得苏养直所为深字韵一首不知题何处景俾跋其后","author":"戴复古","text":"都来五十有六字，写出山林无限奇。\n当日所题何处景，祇今但见后湖诗。\n一言一语堪传世，某水某丘仍属谁。\n试向愁烟推白鸟，无情白鸟又何知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜子野主簿约客赋一诗为赠与仆一联云生就石桥罗汉面吟成雪屋阆仙诗","author":"戴复古","text":"杜陵之后有孙耒，自守诗家法度严。\n秀骨可仙官况薄，高情追古俗人嫌。\n起看星斗夜推枕，为爱江山寒捲帘。\n饱吃梅花吟更好，锦囊虽富不伤廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜门自遣","author":"戴复古","text":"世事茫茫心事灰，众人争处我惊回。\n闭门不管花开落，避俗唯通燕往来。\n富贵在天求不得，光阴转地老相催。\n平生任达陶元亮，千载神交共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜仲高自鄂渚下仪真","author":"戴复古","text":"鄂渚三千里，南楼看月回。\n东园花政好，去岁客重来。\n兄弟皆名士，文章动上台。\n倾城倾国色，也用觅良媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜仲高相遇约李尉","author":"戴复古","text":"胸中无地著尘埃，有我唯堪把酒杯。\n苦恨好山移不得，生憎俗客去还来。\n秋风吹老东篱菊，春信搀开北岭梅。\n管领风光须我辈，急吹短笛棹船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜仲高高九万相会","author":"戴复古","text":"杜癖诗无敌，高髯画绝伦。\n笑谈能不朽，富贵或成尘。\n今古多奇事，乾坤几怪民。\n相逢不容易，一醉楚江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨伯子监丞霅川久雨得晴为喜","author":"戴复古","text":"村南村北晒蓑衣，好是云开日出时。\n太守少宽忧世志，野人为赋喜晴诗。\n两岐瑞麦黄金实，八茧吴蚕白雪丝。\n政事端知合天意，雨旸还亦顺人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求安","author":"戴复古","text":"愁来须强遣，老去只求安。\n酒熟思招客，诗成胜得官。\n梅花天下白，雪片夜深寒。\n衲被蒙头睡，翛然百虑宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪见可约游青原","author":"戴复古","text":"来访青原古钓矶，溪流衮衮濯龙奇。\n一茶可款从僧话，数局争先对客棋。\n云雨那能败吾事，山林政喜得君诗。\n石头路滑篮舆小，换得扁舟在水湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪见可教授约诸丈凤山酌别","author":"戴复古","text":"凤凰洲上凤凰山，草草登临见一斑。\n不立樊墙天广大，剩栽花竹地宽闲。\n白云四面峰千叠，绿柳前头水一湾。\n行色催人诗未就，寄情庭院落花间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪给事守鄂渚元宵代江夏宰吴熙仲献灯 其一","author":"戴复古","text":"鄂州新得主人翁，今岁元宵便不同。\n灯火夜深回昼日，管弦声动起春风。\n辽天月借三秋白，陆地莲开十丈红。\n妙手信能移造化，速宜归去补苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汪给事守鄂渚元宵代江夏宰吴熙仲献灯 其二","author":"戴复古","text":"一晴收尽四山云，天与黄堂作好春。\n西楚东吴献风月，南楼北榭拥星辰。\n扶持入郭观灯叟，歌舞拦街醉酒人。\n此是太平真气象，今年第一个良辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈庄可号菊花山人即其所言","author":"戴复古","text":"老貌非前日，清吟似旧时。\n已无藏酒妇，幸有读书儿。\n连岁修茅屋，三秋绕菊篱。\n寒儒有奇遇，太守为刊诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵洲","author":"戴复古","text":"一台中立郁苍苍，四面山光接水光。\n潮信往来知气候，鼋精出没兆灾祥。\n烟生茶灶僧留款，风展蒲帆客去忙。\n白发东坡在何许，两行遗墨照琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵洲梅花","author":"戴复古","text":"穿林傍水几平章，合有春风到草堂。\n自入冬来多是暖，无寻花处却闻香。\n枝南枝北一轮月，山后山前两履霜。\n直看过年开未了，醉吟且放老夫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵峰灵岩有天柱石屏之胜自昔号二灵","author":"戴复古","text":"骇见二灵景，山林体势豪。\n插空天柱壮，障日石屏高。\n览胜苦不足，登危不惮劳。\n白云飞动处，绝壁走猿猱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花朝侄孙子固家小集","author":"戴复古","text":"今朝当社日，明日是花朝。\n佳节唯宜饮，东池适见招。\n绿深杨柳重，红透海棠娇。\n自笑鬓边雪，多年不肯消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏希亮约客游刘兴伯大自在亭","author":"戴复古","text":"偶尔来江上，从君到酒边。\n雨晴花弄日，风定柳凝烟。\n适意共一笑，浮生无百年。\n明朝大自在，谁办载花船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赤壁","author":"戴复古","text":"千载周公瑾，如其在目前。\n英风挥羽扇，烈火破楼船。\n白鸟沧波上，黄州赤壁边。\n长江酹明月，更忆老坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛丑岁暮三首 其三","author":"戴复古","text":"意气久凋落，形模老可憎。\n能扶双病脚，赖有一枯藤。\n世味淡如水，吾心达似僧。\n明朝今日事，一任运腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛丑岁暮三首 其二","author":"戴复古","text":"腊尽无多日，吾生有几年。\n老于人事懒，贫觉世情偏。\n独枕江湖梦，闭门风雪天。\n三杯动诗兴，得句落梅边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛丑岁暮三首 其一","author":"戴复古","text":"日月易流转，一年仍一年。\n身从忧患老，事逐岁时迁。\n白首未闻道，清贫不愧天。\n寒林松柏瘦，花柳又春妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛未元日上楼参政攻愧斋先生","author":"戴复古","text":"东风入仗庆云翔，百辟朝元奉玉皇。\n一代安危寄黄发，群生枯瘁转青阳。\n梅花结果调勋鼎，柏叶宜年上寿觞。\n宰相黑头天子圣，赖公同与措时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邵阳赵节斋史君同黄季玉以合江亭三字分韵","author":"戴复古","text":"万里清秋景，都归乎此亭。\n光阴几今古，天地一宫廷。\n澬水东西白，梅山表里青。\n登临生酒兴，欲醉又还醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈伯可山亭","author":"戴复古","text":"梯险登霞外，乘流过竹西。\n寒溪随雨涨，高阁与云齐。\n双鹤有时舞，孤猿何处啼。\n清吟无尽兴，白石可留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈孟参陈明子同游麻姑山","author":"戴复古","text":"麻姑坛上共登临，野客悠然起道心。\n丹井汲泉深百尺，星杉耸壑到千寻。\n青莲花白仙踪远，乌桕叶红秋意深。\n何用金槃擘麟脯，山肴浊酒可同斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈漕领客西园赏海棠","author":"戴复古","text":"追随玉节赏仙葩，满座风流客更嘉。\n锦绣有光摇竹影，珍珠无价买春华。\n猩红滴滴娇含蕊，雪白纷纷老半花。\n肯对骚坛轻著语，后山诗句已名家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮中","author":"戴复古","text":"布衣不换锦宫袍，刺骨清寒气自豪。\n腹有别肠能贮酒，天生左手惯持螯。\n蝇随骥尾宜千里，鹤在鸡群亦九皋。\n贤似屈平因独醒，不禁憔悴赋离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮中达观","author":"戴复古","text":"人生安分即逍遥，莫向明时叹不遭。\n赫赫几时还寂寂，闲闲到底胜劳劳。\n一心似水惟平好，万事如棋不著高。\n王谢功名有遗恨，争如刘阮醉陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮萧和伯家醉登快阁和杨伯子题分明观韵","author":"戴复古","text":"醉归萧史宅，快阁倚西东。\n山敛过云雨，江无起浪风。\n月行银汉上，人在玉壶中。\n天眼照尘世，应怜鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"事机","author":"戴复古","text":"天下事机别，朝廷局面新。\n台官迁不定，年号改何频。\n黜陟由明主，安危仗老臣。\n祖宗成宪在，即此是经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京口别石龟翁际可","author":"戴复古","text":"把剑樽前砍地歌，有何留恋此蹉跎。\n心期难与俗子道，世事不如人意多。\n莲叶已空犹有藕，菊花虽老不成莎。\n扁舟四海五湖上，何处不堪披钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京口遇薛野鹤","author":"戴复古","text":"天下江山第一州，可能无地著诗流。\n黄金不爱买官职，白发犹堪上酒楼。\n懊恨牡丹遭雨厄，叮咛芍药为春留。\n狂吟有禁风骚歇，语燕啼鶑代唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙子直家有西阁吾有东楼相望秋来景物佳甚","author":"戴复古","text":"逼仄人间世，思从造物游。\n君方倚西阁，吾亦上东楼。\n挹彼千峰秀，森然万象秋。\n相看成二老，更有几年留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙子渊新居落成二首 其二","author":"戴复古","text":"一区扬子宅，中有读书堂。\n早觉儒风好，兼看野趣长。\n籓篱带花竹，里巷接农桑。\n安得茅三架，为邻住汝傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙子渊新居落成二首 其一","author":"戴复古","text":"结屋邻苍海，开门面翠屏。\n堂前萱草绿，寿母鬓丝青。\n礼乐陈樽俎，诗书立户庭。\n一时勤卜筑，百世享康宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙亦龙作亭于小山之上□余以野亭名之得诗五首 其五","author":"戴复古","text":"田间四五月，此景看来稀。\n翼翼青苗上，双双白鸟飞。\n茅茨林下住，蓑笠雨中归。\n拍岸瓜藤水，不须忧岁饥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙亦龙作亭于小山之上□余以野亭名之得诗五首 其四","author":"戴复古","text":"勿谓此亭水，岿然气不群。\n静中观变化，闲处立功勋。\n水细通岩窦，亭高压海云。\n隐居行素志，不负圣明君。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙亦龙作亭于小山之上□余以野亭名之得诗五首 其三","author":"戴复古","text":"诗礼家声重，田园活计饶。\n自甘为野客，不愿仕王朝。\n时为花开眼，谁因米折腰。\n此心安出处，何日不逍遥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙亦龙作亭于小山之上□余以野亭名之得诗五首 其二","author":"戴复古","text":"蔡外有馀地，登临作此亭。\n心如乔木古，眼共远山清。\n社酒谁同醉，村歌自可听。\n有时来夜坐，收拾读书萤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙亦龙作亭于小山之上□余以野亭名之得诗五首 其一","author":"戴复古","text":"平地变丘壑，安排若自然。\n为山移白石，凿沼贮清泉。\n栗里有松竹，兰亭无管弦。\n轩裳非我事，在野不妨贤。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙仲晦亦龙和前诗甚佳其家有林塘之胜兄弟和睦日以奉亲为乐用此韵以美之","author":"戴复古","text":"有母身长健，无营家自丰。\n林塘孝子宅，诗礼古人风。\n垄亩秋成后，弟兄和气中。\n时闻有佳话，常欲访王戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙炳以东野农歌一编来细读足以起予七言有汲水灌花私雨露临池叠石幻溪山草欺兰瘦能香否杏笑梅残柰俗何似此两联皆自出新意自可传世然言语之工又未足多其体格纯正气象和平为可喜余非谀言自有识者因题其卷末以归之","author":"戴复古","text":"吾宗有东野，诗律颇留心。\n不学晚唐体，曾闻大雅音。\n霜空孤鹤唳，云洞老龙吟。\n群噪无才思，昏鸦自满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄孙景文多女贺其得雄","author":"戴复古","text":"阴极一阳转，君家气数回。\n试看庭竹上，新有凤雏来。\n端的传书种，分明是福胎。\n三朝食牛气，端不类婴孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侄淑远游不得书","author":"戴复古","text":"客梦江湖远，穷居骨肉离。\n尺书无寄处，中夜不眠时。\n念尔衣裘薄，满怀风露悲。\n狂游断消息，深负竹林期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净明","author":"戴复古","text":"林峦相掩映，岩谷独玲珑。\n下置维摩室，上通龙伯宫。\n灵珠四时雨，秋水一帘风。\n甚欲观新月，山高脚力穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到鄂渚","author":"戴复古","text":"连宵歌舞醉东楼，不信樽前有别愁。\n半夜月明何处笛，长江风送故人舟。\n十年浪迹游淮甸，一枕高眠到鄂州。\n明日拟苏堤上看，当春杨柳政风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和高与权","author":"戴复古","text":"相逢休说昧平生，高适能诗久擅名。\n欲课荒芜来入社，羞将老丑对倾城。\n近来客里仍多病，强向花前举一觥。\n乐极自伤头白早，樽前知我孟云卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韶州许使君令子送别之韵","author":"戴复古","text":"诗瘦吾非沈隐侯，五穷相值结为雠。\n方愁度岭无相识，却喜闻韶到此州。\n世道从来三不合，客行何止七宜休。\n故人知我平生事，肯笑苏秦著弊裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅投所知","author":"戴复古","text":"洁白无瑕美不娇，烱如珠玉粲林皋。\n独开残腊与时背，奄胜众芳其格高。\n欲启月宫休种桂，如何仙苑却栽桃。\n不将品质分优劣，痛饮花前读楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因风再寄南昌故人兼简王帅子文 其二","author":"戴复古","text":"江湖归亦好，朋友恨相疏。\n倏作三年别，才通一纸书。\n诗盟谁是主，世道正愁予。\n若见王都督，烦君问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因风再寄南昌故人兼简王帅子文 其一","author":"戴复古","text":"寄声黄与宋，书去望书还。\n别后交情在，年来世路艰。\n吾思蹈东海，君合隐西山。\n诗卷勤收拾，留名天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜吟呈赵东岩","author":"戴复古","text":"汲井漱残酒，行吟到夜分。\n一轩清似洗，万籁寂无闻。\n风送迎秋雨，天收翳月云。\n鸡鸣庭户白，人事又纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宿田家","author":"戴复古","text":"簦笠相随走路岐，一春不换旧征衣。\n雨行山崦黄泥坂，夜扣田家白板扉。\n身在乱蛙声里睡，心从化蝶梦中归。\n乡书十寄九不达，天北天南雁自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宜春东湖呈赵使君","author":"戴复古","text":"东园有佳趣，五马共登临。\n介石见古意，月台延赏心。\n虽然近城郭，元不远山林。\n能使一州润，秀江秋水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳市胜业寺禹柏","author":"戴复古","text":"三千年老柏，怪怪复奇奇。\n剖彼一枯腹，离为九折枝。\n蟠根半生死，阅世几兴衰。\n神禹所栽植，山灵常护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子荐饥 其四","author":"戴复古","text":"乘时皆闭粜，有谷贵如金。\n寒士糟糠腹，豪民铁石心。\n可怜饥欲死，那更病相侵。\n到处闻愁叹，伤时泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子荐饥 其三","author":"戴复古","text":"饿走抛家舍，从横死路岐。\n有天不雨粟，无地可埋尸。\n劫数惨如此，吾曹忍见之。\n官司行赈恤，不过是文移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子荐饥 其一","author":"戴复古","text":"正月彗星出，连年旱魃兴。\n自应多变故，何可望丰登。\n孰有回天力，谁怀济世能。\n嫠居不恤纬，忧国瘦崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子荐饥 其五","author":"戴复古","text":"杵臼成虚设，蛛丝网釜鬵。\n啼饥食草木，啸聚斫山林。\n人语无生意，鸟啼空好音。\n休言谷价贵，菜亦贵如金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子荐饥 其二","author":"戴复古","text":"连岁遭饥馑，民间气索然。\n十家九不爨，升米百馀钱。\n凛凛饥寒地，萧萧风雪天。\n人无告急处，闭户抱愁眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建昌道上","author":"戴复古","text":"凛凛北风劲，行行西路赊。\n人情甘淡薄，世事苦参差。\n酒易逢知己，诗难遇作家。\n林间数点雪，错认是梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"所闻","author":"戴复古","text":"北风如许急，亦使客心寒。\n近得襄阳报，仍闻蜀道难。\n三杯中夜酒，一枕几时安。\n江上两都督，何人上将坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]