[{"title":"蛾眉亭","author":"周月船","text":"一片沙明万古秋，半规月印两眉头。\n无人不有关心事，各自看山各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周月船","text":"归去门前栽柳树，逢春先绿向阳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 和丁基仲","author":"周氏","text":"画楼帘卷翠。\n正柳约东风，摇荡春霁。\n缃桃雨才洗。\n似妆临宝镜。\n脂凝铅水。\n云偏髻子。\n坠钗梁、羞看燕垒。\n最堪怜，锦绣香中，早有片红飘砌。\n闲记。\n琴弹古调，曲按清商，旧年时事。\n屏山画里。\n江南信，梦中寄。\n感春浓怀抱，午酲初解，浅酌依然又醉。\n傍阑干、犹怯馀寒，倦和袖倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"周世昌","text":"画鼓雷奔天不雨，綵旗云耸地生风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪","author":"周世南","text":"壁立石青苍，邻溪复枕江。\n刊铭传不朽，文笔老无双。\n怪树森圆幄，□□寄□幢。\n奇踪□异景，□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠胡侍郎荣归","author":"周古","text":"尝水茫茫怅别情，悲风吹树作离声。\n酒倾银斝临江卧，潮落沙汀带月明。\n千里绿烟芳草合，一天红雨落花轻。\n老怀对景成三叹，不觉潸然泪两倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一甲子前与济源李綦仪之游从赣上今其婿谢幼学传示衰容为题四句","author":"周必大","text":"早同短李客南康，晚识渠家玉润郎。\n自笑头颅并目睫，依然如鼠复如獐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯中秋初夜见月欲登楼而阴五鼓如永和镇省七兄月色如昼","author":"周必大","text":"携壶拟欲上层楼，云掩冰轮且罢休。\n谁料五更南栅路，却成邂逅好中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯冬杨廷秀访平园即事 其二","author":"周必大","text":"梅得诗翁八月歌，至今万朵压枝多。\n明年结子应无数，金鼎调时味正和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙卯冬杨廷秀访平园即事 其一","author":"周必大","text":"乘兴不回安道舟，销忧同倚仲宣楼。\n莫嫌四面酸风射，犹胜三场沈汗流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁酉二月二十日同部中诸公游下竺御园坐枕流亭观放闸桃花数万点随流而下继至集芳亦禁峑也海棠满山郁李绕槛殆不类人间世明日入部而桃花数枝伶俜窗外未时内直则海棠郁李各一株方开遂赋二绝句 其二","author":"周必大","text":"清胜堂前花万重，玉堂署里两芳丛。\n应怜寓直清无侣，聊伴衰翁宿禁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁酉二月二十日同部中诸公游下竺御园坐枕流亭观放闸桃花数万点随流而下继至集芳亦禁峑也海棠满山郁李绕槛殆不类人间世明日入部而桃花数枝伶俜窗外未时内直则海棠郁李各一株方开遂赋二绝句 其一","author":"周必大","text":"万点红随雪浪翻，恍疑身到武陵源。\n归来上界多官府，人与残花两不言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七兄夜以小诗相戏走笔和韵","author":"周必大","text":"小蛮未解啭莺簧，凿壁偷分富烛光。\n不是庞公灵照女，谁人为作起予商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日哭子柔弟","author":"周必大","text":"自酹黄花酒，心酸苦泪零。\n常时爱鸣雁，从此不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十七夜与诸弟小酌尝榧实误食乌喙乌喙堇也古书云以堇寘酒杀人戏成小诗","author":"周必大","text":"伏神老芋不伤生，江蟹蟛蜞祸亦轻。\n我独好奇尝酒堇，误思榧实杀三彭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十二日夜梦奏事","author":"周必大","text":"曾抱疲驽佐圣明，枕中议政似平生。\n五更鼓角惊残梦，彷佛街司报点声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入直召对选德殿赐茶而退","author":"周必大","text":"绿槐夹道集昏鸦，敕使催宣坐赐茶。\n归到玉堂清不寐，月钩初上紫薇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十八日与客小集赏岩桂而红梅海棠金林檎盛开明日江西美赋四绝句走笔次首篇韵","author":"周必大","text":"壮观江潮拍岸时，肯来小圃访樊迟。\n天怜无以娱嘉客，并发春花伴桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十二日葛守送羊羔酒戏占小诗","author":"周必大","text":"马乳三年隔大官，羊羔今日倒芳樽。\n浅斟低唱非吾事，醉梦惟应踏菜园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十九日饯别刘文潜运使明日书来云醉梦中作小诗但记后两句为足成之","author":"周必大","text":"幽人门巷冷如冰，使节光华肯再登。\n今夕青灯话三馆，明年何处说庐陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月九日陈诚之送菊花小诗奉答","author":"周必大","text":"十月风霜动，篱边菊始黄。\n从来司历过，失不闰重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安韦邦彦字俊臣携王民瞻杨廷秀谢昌国绝句相过次韵勉之 其二","author":"周必大","text":"后学争攲雨后巾，前贤久泽雾中文。\n韦郎勉力追三杰，他日人还效五云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安韦邦彦字俊臣携王民瞻杨廷秀谢昌国绝句相过次韵勉之 其一","author":"周必大","text":"卢溪笔力透天心，杨令文追正始音。\n更读池塘惠连句，识君何待接清襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安赖秀才家拾青楼二首 其二","author":"周必大","text":"高柳侵檐带绿烟，平林遥望倚青天。\n诗人不必工摹写，留与恩袍色斗鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安赖秀才家拾青楼二首 其一","author":"周必大","text":"经术逢辰富贵兼，取名银艾未伤廉。\n更须唤作藏书阁，别贮邺侯三万签。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月三日适值清明会客江楼共观并蒂魏紫偶成二小诗约坐客同赋 其一","author":"周必大","text":"上巳清明共一时，魏花开处亦连枝。\n前身应是唐宫女，犹记昭容双袖垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月三日适值清明会客江楼共观并蒂魏紫偶成二小诗约坐客同赋 其二","author":"周必大","text":"修禊归来却踏青，临流谋野两关情。\n不如省事游春女，挑菜渚边看水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与崔序老步月青玉峡漱玉泉坐瀑布之石桥天气凉冷移坐法堂下对双剑峰甚正序老求偈","author":"周必大","text":"剑峰有时折，瀑水有时竭。\n我性等虚空，今古无生灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子中兄招饮次韵 其一","author":"周必大","text":"青衿学道不忧贫，黄发相看并乞身。\n前有二疏今可企，免教人谓鲁无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子中兄招饮次韵 其二","author":"周必大","text":"立朝共踏东华土，居里同抽北阙身。\n从此清风与明月，尊前真属两閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小诗戏王驹甫请来早转约伯威德源得善彦和志伯西美粹夫及愚卿兄弟共不托一杯已有定例不设他味","author":"周必大","text":"岩桂芙蓉映菊篱，小春仍上海棠枝。\n瓮头幸有茅柴酒，来看平园万户棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山谷自赞云作梦中梦见身外身福唐曾锡盛谈西湖水晶宫之胜因写予真用此意题四句","author":"周必大","text":"大患都缘有此身，笑看身外假为真。\n梦中更作西湖梦，谁谓先生不到闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"门客郑安世写寿星求赞","author":"周必大","text":"谁把江西一幸民，强摹南极老人星。\n穹龟鹿鹤朋三寿，伴我松根斸茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中元日以春花数种送阎才元左司阎赋二绝句次韵 其一","author":"周必大","text":"韩郎牡丹迹已久，殷七杜鹃名谩新。\n何似熙熙行阙里，花随和气四时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中元日以春花数种送阎才元左司阎赋二绝句次韵 其二","author":"周必大","text":"早岁联名向千佛，如今接武事承华。\n何时误入长春苑，尽看先生解语花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中