csv","pointer":35482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘吴二察院去国五首 其五","author":"刘黻","text":"生节雷声午夜残，囊封一疏夺冰寒。\n先生此去非沽誉，留与时人作样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘吴二察院去国五首 其四","author":"刘黻","text":"宰相从来号读书，晚年似欲效痴儿。\n痴儿多病伤于饱，爵禄如何对饱时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘吴二察院去国五首 其三","author":"刘黻","text":"谁新白屋当灵鹫，倚汉横霓几栋梁。\n因想中原陵寝处，断垣衰草正斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘吴二察院去国五首 其二","author":"刘黻","text":"涂碑共说台官去，局面还忧宰相来。\n今古几多兴废事，只缘忠佞是胚胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯潘吴二察院去国五首 其一","author":"刘黻","text":"两豸归欤一相留，孤山草木亦含羞。\n忠言不必排阊阖，付与钱塘江自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇恐滩","author":"刘黻","text":"十八滩中第一滩，舟行风顺不知艰。\n诸生历落诚皇恐，世上何人敢犯颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"砚","author":"刘黻","text":"色若马肝微带紫，星如鹆眼更添青。\n端方一静浑无语，即是吾今座右铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽万竹西隐君","author":"刘黻","text":"哭到先生道已穷，夕阳千古起悲风。\n耆英会上减名哲，高士传中添此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友","author":"刘黻","text":"瘴云未免钟仪絷，夜雨应怜范叔寒。\n尚有慈闱年九十，空挥客泪落江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其六","author":"刘黻","text":"一别狮山千载期，萧条吟屋费修治。\n手栽门户新杨柳，试问春风长几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其五","author":"刘黻","text":"向上工夫肯惮难，须知篑土可为山。\n若还志力无回转，直透龙门亦等閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其四","author":"刘黻","text":"汝兄望汝撑门户，汝不耽书奈汝何。\n汝看二程兄弟传，肯将几月付蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其三","author":"刘黻","text":"千里家山入梦频，又封书尺寄行人。\n未惭定省多疏阔，守道安贫即是亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其二","author":"刘黻","text":"儒生事业戒悠悠，凿井求泉须到头。\n要识汝兄勤苦事，顶门白发一茎秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西弟六首 其一","author":"刘黻","text":"寂寂书堂秋夜凉，一编心画一炉香。\n弟兄动是经年别，羞见天边有雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄寿二亲三首 其一","author":"刘黻","text":"万竹森森一水泓，堂名劲逸即蓬瀛。\n赋诗何必多工部，怕与梅花共瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄寿二亲三首 其二","author":"刘黻","text":"荣拜花封感圣主，寿杯阻莫捧亲前。\n岭梅尚有逢春日，办取斑衣听老天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄寿二亲三首 其三","author":"刘黻","text":"甘向清朝作逐臣，茹蔬观草即经纶。\n心香都在寒梅上，宇宙常逢不老春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄社中","author":"刘黻","text":"暗壁寒螀聚夜愁，孤灯相忆话绸缪。\n雁来不接西风字，又见黄花老却秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢李叔飞惠酒","author":"刘黻","text":"清谈莫疗颠危證，白堕堪浇磊块胸。\n今日得生今日福，世间万事付青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋何明府爱山堂","author":"刘黻","text":"终日看山终日好，山不悦人人不老。\n爱山谁识爱山心，瘦竹长松兼碧草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题禹庙","author":"刘黻","text":"云痴雨妒不相干，古庙深山万木寒。\n水土平治今几载，犹听父老说艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠五星术士","author":"刘黻","text":"星斗扪胸溯李袁，岭梅谁问命艰难。\n彊宫缘被孤星主，合向山中守岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士","author":"刘黻","text":"火色鸢肩类马周，南冠濩落楚江头。\n道人莫说閒荣辱，且对梅花索笑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十五日游兴教寺","author":"刘黻","text":"一僧癯似竹，结坐对观音。\n但见夕阳过，不知春事深。\n茗芳留野客，树老集巢禽。\n卓锡泉千古，泠然照此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十三生日","author":"刘黻","text":"居常出户便思亲，况复流离值诞辰。\n命薄不嫌增甲子，骚清犹可记庚寅。\n菊香留晚招同醉，梅意才先喜卜邻。\n警省工夫须力进，客髭已有数茎新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄 其一","author":"刘黻","text":"元阳诏墨动天霞，喜到东都处士家。\n世路几年滋艾草，道山今日聚梅花。\n作舟济国看商傅，槃石补天过女娲。\n珍重诸贤扶大道，声名毋使后人嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄 其二","author":"刘黻","text":"愧不柯山与执经，曾将尺纸话飘萍。\n六年忆别心如醉，一日相逢眼倍醒。\n结友苦无鸥共志，癖书瘦得鹤同形。\n自怜所性惟方拙，水洁山高即座铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大龙湫","author":"刘黻","text":"总是佳山水，龙居又不同。\n神明专一壑，气势压群雄。\n派想从天落，湫疑与海通。\n高秋看不厌，宴坐雨声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁静山房为孙君赋","author":"刘黻","text":"一庐含万象，古意在听琴。\n虽有种瓜事，却无锄草金。\n山幽驯野鹿，树老带巢禽。\n自得延生法，从渠事养心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕","author":"刘黻","text":"一来生万感，动是两番春。\n俗朴少灯火，年丰多醉人。\n远乡犹有旧，明月只如新。\n无奈梅花落，相看老树身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斗山接待","author":"刘黻","text":"云水无南北，几人相往还。\n井深应接海，石显为开山。\n佛塔寒流上，渔帆夕照间。\n何当脱尘鞅，分石伴僧閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牛头庵次王九山宪使韵","author":"刘黻","text":"有此投閒处，群山绕地图。\n声名出朝士，笑语乐樵夫。\n招鹤松为主，开泉月作模。\n犹嫌居欠僻，来往是征途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王宗臣赵处仁郑季克同游分得村字","author":"刘黻","text":"出关非为看桃李，爱识西山深处村。\n舟泊野桥分柳色，屐寻閒径破苔痕。\n鸠占欲雨唤夫妇，鸡傍残阳聚子孙。\n得友不知商议久，归来灯火已黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见东阁","author":"刘黻","text":"大唐诗派远，今复有唐人。\n慎吐冰霜句，恐妨天地春。\n闭门惟嗜古，养鹤亦甘贫。\n未识孤高貌，梅花想逼真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出邑","author":"刘黻","text":"出邑欣逢友，不知三岭遥。\n云深山失树，月上海生潮。\n县小官租急，年荒酒户销。\n且寻僧舍泊，第一免喧嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四十吟三首 其三","author":"刘黻","text":"四十年来朋友情，朱弦疏越最希声。\n閒思白日同天乐，每向清宵坐月明。\n世事只随沤起灭，故交不趁木枯荣。\n早知党祸今如织，祇合渔樵老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四十吟三首 其二","author":"刘黻","text":"四十年来兄弟情，渠渠天理境中行。\n形如鹤瘦困书癖，志不蝇营守笔耕。\n庭燎献箴知圣主，台评飞劾到诸生。\n阿奴抑郁休嫌拙，门户如冰耐拄撑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四十吟三首 其一","author":"刘黻","text":"四十年来父子情，吁嗟今日任飘零。\n虽惭负米供三釜，莫悔倾籯教一经。\n饮水西江甘冷味，炷香南极祝高龄。\n白云纵隔三千里，诗礼朝朝似过庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永春道中呈贾九","author":"刘黻","text":"永春春不断，桑柘满林丘。\n云薄无多雨，山清即是秋。\n浅沙寒立鹭，小径晚归牛。\n不惯同为客，逢人问宿头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵自述","author":"刘黻","text":"掩关谁复抱琴来，静坐工夫欲换胎。\n事到平心方是道，行希前哲奈非才。\n镜中华发侵寻矣，松下衰翁矍铄哉。\n畎亩未能忘一饭，经纶犹愿济云雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白石洞","author":"刘黻","text":"片石立云端，群峰向下看。\n夜坛星斗近，秋阁洞天寒。\n泉滴疑传漏，人危怯倚阑。\n降魔孤剑在，却并御书安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"刘黻","text":"腊月廿四夕，冷坐梅花州。\n无梦到金马，有诗迎土牛。\n半生常见肘，一岁又从头。\n形影人相释，先生达理否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寺居","author":"刘黻","text":"寺居贫亦乐，多被忆家分。\n井脉寒生雾，钟声远入云。\n青松知出处，白发耐耕耘。\n此地民风古，如何弄梃闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扫松","author":"刘黻","text":"西原百五日，寂寞故松阡。\n挑饭瘗黄土，酹觞焚纸钱。\n烟林窥老狖，雨岛哭蛮鹃。\n旧植亭前桂，一年高一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱菊山汪眉山会宿萧寺","author":"刘黻","text":"共游溪上寺，因得话诗缘。\n客鬓添新雪，梅花似去年。\n疏钟含暮雨，古木带寒烟。\n后会知难定，分题废夕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次何爱山喜雨韵","author":"刘黻","text":"梵宫默祷托炉烟，火伞愁张六月天。\n雨倏随车符蚁垤，水分沃野免龟田。\n已知帘影多琴暇，更与花封结饭缘。\n坐听四方同润泽，庶几大有特书年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次胡潜父先辈","author":"刘黻","text":"圣世如何肯弃贤，唐书笔削赖君传。\n山云相望三千里，岭雾同游恰一年。\n才刃固难居众后，智囊犹欠烛几先。\n嗟吁寄迹寒梅下，白首青灯哭诉天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬吴仙尉张都监游兴教寺","author":"刘黻","text":"野寺坐寥阒，跫然闻足音。\n四山经雨过，六月似秋深。\n灯静窥饥鼠，钟清悟宿禽。\n元城今已远，共此白云心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬杨德中","author":"刘黻","text":"丹心炯炯老天知，莫问人间识者稀。\n孤雁过门思古荡，慈鸦满树忆重闱。\n醉因酒贱歌丰岁，寒觉衣单恋晚晖。\n珍重五穷同寂寞，忍教结柳向谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]