[{"title":"同俞季渊访王脩斋遇雨次季渊韵","author":"刘黻","text":"投宿西山雨，抗论由群居。\n冥冥白雾深，谁卧隆中庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬五羊李子先见寄","author":"刘黻","text":"山深万木寂，一片古心枯。\n昨夜梅花月，相期道不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次酬陈云谷","author":"刘黻","text":"书空咄咄懒题诗，深愧敲门客问奇。\n向晚小窗閒远眺，西风吹雾出秋峗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访西湖","author":"刘黻","text":"东风吹客到西湖，汀草沙禽半识吾。\n惟欠数间茅屋在，种梅花处伴林逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听松","author":"刘黻","text":"寺门松未老，早有鹤来栖。\n一夜枕衾冷，半天风雨啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京邸思家","author":"刘黻","text":"小楼终日户全扃，诗卷閒消客子檠。\n城里不曾闻杜宇，尚疑三月未清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶正父见寄","author":"刘黻","text":"前生疑是老头陀，却笑今生狷愤多。\n谪向梅花岭根住，禅关参得祖师么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和建小学韵呈赵求仁使君 其四","author":"刘黻","text":"浦出西江有此名，道源澄湛自天成。\n屋头松树年多少，曾识濂溪授二程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和建小学韵呈赵求仁使君 其三","author":"刘黻","text":"衿佩欢迎师帅来，读书种子赖栽培。\n他年济济云霄路，谁信清朝叹乏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和建小学韵呈赵求仁使君 其二","author":"刘黻","text":"理非精妙事非粗，一性空明彻万殊。\n白发圣人由稚子，常惺惺处是工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和建小学韵呈赵求仁使君 其一","author":"刘黻","text":"黉舍临溪静最安，朋来俊少共窥斑。\n能知格物如星秤，即是程门第一关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚正字用赵信庵韵题召星馆","author":"刘黻","text":"朔风吹客上江西，历遍山厓与石溪。\n野鸟不知言有祸，晚窗犹自向人啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和渔翁四绝 其三","author":"刘黻","text":"收网移舟月上时，西风吹浪脍鲈肥。\n任渠官买高声叫，醉卧芦花别处矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和渔翁四绝 其四","author":"刘黻","text":"世业相承不裹头，一家全在水中浮。\n有鱼便可供沈醉，休问清流与浊流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和渔翁四绝 其一","author":"刘黻","text":"沧波万顷即良田，一舸东西卧碧天。\n鬓发如银长是醉，不知生甲是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和渔翁四绝 其二","author":"刘黻","text":"得鱼换米傍村归，篷底烟生湿草炊。\n醉倒船头呼不起，斜阳捉虱有孙儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和薛仲止渔村杂诗十首 其十","author":"刘黻","text":"白发疏疏青道衣，苦吟应有鬼神知。\n篇章但可陶情性，羞杀唐人自献诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和薛仲止渔村杂诗十首 其九","author":"刘黻","text":"幸观世事已忘机，觞咏流行度几时。\n万物本来同一性，可知猿鸟不相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和薛仲止渔村杂诗十首 其八","author":"刘黻","text":"情性常嗤俗者劳，世间何处免风涛。\n小舟泊向荷花荡，一个渔翁熟睡高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d