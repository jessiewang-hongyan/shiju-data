[{"title":"句 其三","author":"李建中","text":"故宫芳草在，往事暮江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和祝镒韵","author":"李弥正","text":"劳车发危坂，倦艘失飞湍。\n滔滔褦襶子，疾走殊未阑。\n鹤仙摆名宦，结庐松江干。\n笑拍萍风浮，瞬视草露漙。\n图川不愧辋，序谷宁先盘。\n门岂俗驾拒，室无哀筝弹。\n按行松菊间，澹然有馀观。\n莲巢众香聚，浮天百忧宽。\n秋光敛洲渚，暮翠笼峰峦。\n我来挟良朋，道故盟未寒。\n练颜仰孤标，耐久同苍官。\n终当役薪水，刀圭却衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨 其一","author":"李弥逊","text":"夜雨翻盆晓未停，看山两眼几时青。\n不知溪面添多少，水满方池涨绿萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨 其二","author":"李弥逊","text":"带雨山云不肯明，草泥封径断人行。\n竹林纵有鸟飞路，十日不闻鶗鴂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大宁以雨复留借榻老僧禅室","author":"李弥逊","text":"乞得禅房半日留，卧看岩雨泻清沟。\n浮云岂是尘中物，又逐秋风天外游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山路见梅","author":"李弥逊","text":"笋舆行处及春回，石里横斜亦见梅。\n路细山长愁欲绝，可怜一笑向人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己亥季秋至净居思大智者道场因瞻二士相三日会天大雨不得探险绝而以诗记之 其四","author":"李弥逊","text":"白雾苍烟暗九秋，殷床金吼抱山楼。\n为霖未必浑三日，似有闲云伴我留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己亥季秋至净居思大智者道场因瞻二士相三日会天大雨不得探险绝而以诗记之 其三","author":"李弥逊","text":"雨华随步到天关，远目才分缭绕山。\n风马不驰前景断，更于何地觅无还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己亥季秋至净居思大智者道场因瞻二士相三日会天大雨不得探险绝而以诗记之 其二","author":"李弥逊","text":"香断寒炉古庙空，金毛一去了无踪。\n分明曾得真消息，犹有参天十万松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己亥季秋至净居思大智者道场因瞻二士相三日会天大雨不得探险绝而以诗记之 其一","author":"李弥逊","text":"三苏岩壑连云秀，二士门庭匝地新。\n带雨山光无限思，一时分付镜中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公华以北山荔子见寄因念昔游慨然怀归戏成","author":"李弥逊","text":"筠笼百里故人情，多病文园眼倍醒。\n未放茶瓯三百颗，梦魂先过小长汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六六轩","author":"李弥逊","text":"秋雨已分千壑间，午天初放一轩晴。\n拨开三十六峰翠，为洗老人双眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方池独步","author":"李弥逊","text":"度柳穿莎一径通，曲堤初咏舞雩风。\n我来似与春期约，南陌东畦到处红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月出德甫席上作次韵 其二","author":"李弥逊","text":"世界重重一网中，澄溪上下见天容。\n不知万丈寒光底，却到青冥是几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月出德甫席上作次韵 其一","author":"李弥逊","text":"万境全归一瞬中，山河日月尽含容。\n若将明暗分迷悟，公案从今又一重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"令尹王次虞许开小户通县圃仍为增植花木以诗促之","author":"李弥逊","text":"连墙请谒敢辞频，凿壁开扉肯见亲。\n闻说好花栽满县，杖藜早晚共寻春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仪真道中 其二","author":"李弥逊","text":"长天漠漠水连空，云淡风微两两红。\n南北不知缘底事，一生半落往来中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仪真道中 其一","author":"李弥逊","text":"过尽长淮未见山，倦寻残梦独凭栏。\n风烟渐欲回春眼，不似蒋陵江上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出山","author":"李弥逊","text":"白雾苍烟昼不分，竹风梢雨乱纷纷。\n杖藜来往成何事，添我胸中一壑云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卢橘","author":"李弥逊","text":"皮似稗柿松而剥，核如龙眼味甘鲜。\n满盘的皪如金弹，丛之分尝忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"可师止庵","author":"李弥逊","text":"踏尽东西散胜岩，却提只履过江南。\n远人若解真常位，不碍携庵到处参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史德夫作渚云亭苏养直有诗余初未识苏次其韵以寄之 其二","author":"李弥逊","text":"新亭花木低几杖，叶幄已成藏远山。\n小渚云生夜深月，十分秋思五湖间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史德夫作渚云亭苏养直有诗余初未识苏次其韵以寄之 其一","author":"李弥逊","text":"逢人但说逃禅晋，句里风烟带九秋。\n七字铿锵快先睹，梦魂竟下荻花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十五日与兄弟清坐灯下不饮取黄精荔子甘实食之童稚绕膝嬉笑喧杂亦足慰岑寂戏作三绝句纪之 其二","author":"李弥逊","text":"江城无地可开颜，学剪星裘闭户看。\n手劈方红调儿女，漫将一笑当追欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十五日与兄弟清坐灯下不饮取黄精荔子甘实食之童稚绕膝嬉笑喧杂亦足慰岑寂戏作三绝句纪之 其一","author":"李弥逊","text":"满床缃帙照青灯，碧眼相看老弟兄。\n不见柳枝罗酒脯，旋烧榾柮煮黄精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十五日与兄弟清坐灯下不饮取黄精荔子甘实食之童稚绕膝嬉笑喧杂亦足慰岑寂戏作三绝句纪之 其三","author":"李弥逊","text":"龙楼曾侍赭黄衣，内竖传柑拜舞时。\n空嗅清香愁永夜，梦魂何处觅丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉山道中有感 其二","author":"李弥逊","text":"寂寞新阡草未长，一身千里路茫茫。\n秋风解染愁人泪，枫叶能红菊亦黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉山道中有感 其一","author":"李弥逊","text":"溪绕长山屋绕溪，隔林楼阁暮钟迟。\n青灯一枕家山梦，镜里平明满面丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门寺前溪上有亭余榜以通幽陈丞有诗次韵 其三","author":"李弥逊","text":"茶瓯放手送归客，屋上鸣禽犹唤人。\n山僧别我月中去，不过虎溪君莫嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其三","author":"李弥逊","text":"努力避喧遭掣肘，强颜追好得嗔拳。\n交情只有春风厚，千里随人不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其二","author":"李弥逊","text":"薄宦驱人不亦劳，久纡章服碍爬搔。\n何时归卧钟山石，荷插长随手种桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其五","author":"李弥逊","text":"逢逢伐鼓水边村，狼藉春盘祝社君。\n但愿官曹皆鲁卓，不须南北稼如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵 其一","author":"李弥逊","text":"长檠当昼知无用，团扇经秋叹已陈。\n我独不才端有似，五年泽国又逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵","author":"李弥逊","text":"檐下飞云若可呼，树头岩影暗浮图。\n不知人世路多少，只见前山似覆盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和见示绝句","author":"李弥逊","text":"一阶春雨两檐风，冷枕青灯睡未浓。\n欲断新篇无好语，喜君消息到黄龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坐客赋席上牡丹酴醾海棠 其三","author":"李弥逊","text":"胭脂着雨弄馀妍，力挽春晖上舞筵。\n谁道捲纱红映肉，杜陵正欲补遗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坐客赋席上牡丹酴醾海棠 其二","author":"李弥逊","text":"珊瑚碧树小明月，散作人间无尽香。\n伏雨阑风浑不惜，为君高处踞胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同坐客赋席上牡丹酴醾海棠 其一","author":"李弥逊","text":"品题芳事有春工，姚魏风流胜浅红。\n莫傍沉香亭北看，只宜卮酒对山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公立承事见贶佳什","author":"李弥逊","text":"竹外孤亭思渺然，与君持酒傲壶天。\n不须五斛称焦遂，一酌高谈骇四筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公显夜闻风作","author":"李弥逊","text":"午梦肩舆转断冈，日烘残暑气扬汤。\n舌端时得冰霜句，绝胜狂风作暮凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公显宫教初见天都峰","author":"李弥逊","text":"孤峰突兀现青虚，喜若羁人望故都。\n神马已驰身尚远，却疑真有二文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵公晔见招","author":"李弥逊","text":"浪走长年百念灰，不知春信海边来。\n新诗唤起逃愁梦，病眼花前得暂开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王才元少师杂花 其五","author":"李弥逊","text":"不禁花恼曲江头，欲对清尊舞沐猴。\n留得春红撩客恨，争如庭草解忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王才元少师杂花 其四","author":"李弥逊","text":"桃红深浅漫成堆，犹喜霜葩缀旧枝。\n唤取张卢来共醉，莫随风雨便分披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王才元少师杂花 其三","author":"李弥逊","text":"嫩蕊商量渐满枝，刘郎对境久忘机。\n折来不拟供樽俎，要与游蜂作伴归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王才元少师杂花 其二","author":"李弥逊","text":"酒染凝脂密染香，一枝聊发次公狂。\n小楼准拟来仙驭，明日红云绕树芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王才元少师杂花 其一","author":"李弥逊","text":"春风著物本无殊，姑射偏成玉雪肤。\n独笑浮花媚凡目，水边疏影不胜孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王彦声题梅氏草堂","author":"李弥逊","text":"丘壑胸中自广居，数椽茅屋小蜗庐。\n门罗莫谩惊乌鹊，户外曾来长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叔孝郎中送游黄山见一老之作 其二","author":"李弥逊","text":"路断人稀山正深，隔林钟鼓报新音。\n已穷渡水沿崖力，更尽眠云坐石心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵学士兄秋初 其四","author":"李弥逊","text":"何日刀头水石间，婆娑犹得一官闲。\n杖藜早晚寻幽处，望断秋空不见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵学士兄秋初 其三","author":"李弥逊","text":"叶叶彫梧阵阵风，疏云全放月华浓。\n故人不寄江头信，看尽飞鸿断复纵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵学士兄秋初 其二","author":"李弥逊","text":"树冷饥蝉犹乱吟，风檐琴瑟露寒侵。\n妻孥工作无衣态，却恨清砧动好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵学士兄秋初 其一","author":"李弥逊","text":"冲融日脚未全收，一叶飞黄满眼秋。\n谩向登临追宋玉，苦吟谁广畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其一 西山","author":"李弥逊","text":"交情金石半途分，霜后孤芳独见君。\n尽倒浓漓浇磊磈，胸中着我半山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其五 筠庵","author":"李弥逊","text":"攀枝结叶蔽朝寒，病鹤摧颓老骨山。\n安得虎头痴绝手，蘧庐置我水云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其七 筠亭","author":"李弥逊","text":"叠叠重重两岸山，钩连秀色上琅玕。\n孤亭四壁面烟雨，人与白鸥分暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其三 筠谷","author":"李弥逊","text":"青青谷口自披榛，断取他方宝界新。\n弥勒同龛把茅下，客来不识住庵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其八 筠溪","author":"李弥逊","text":"爱笋从嗔不出山，看成修影泛微澜。\n此君臭味唯风月，底事须除数百竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其六 筠榭","author":"李弥逊","text":"琐碎金中踏薜萝，出云苔壁手摩挲。\n飞鸿送尽不知暝，乌鹊窥林日下坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其九 钓台","author":"李弥逊","text":"镜中白发负长缨，一钓连鳌我不能。\n剩种长竿绕溪绿，得鱼君看积如陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其四 筠堂","author":"李弥逊","text":"借屋何如退结庐，箨龙环水小方壶。\n孤高不贵封千户，独笑轮囷秩大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林仲和筠庄 其二 筠庄","author":"李弥逊","text":"莫解忘忧不数萱，长镵斸雨护云根。\n采薇劲节于今在，知是夷齐几世孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其七","author":"李弥逊","text":"穷秋璧月才圆后，犹忆桑弧初挂年。\n千里一尊欢稚子，祝君从我傲壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其六","author":"李弥逊","text":"青春不与老相期，归雁声中数别离。\n折柳西城真旦暮，镜中白发已如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其九","author":"李弥逊","text":"浮木随流谁见招，春江无尽水云摇。\n只今瘴海投闲地，魑魅为邻盗正骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其五","author":"李弥逊","text":"骥子摛词苦未工，粉袍勍敌气如虹。\n欲收一战追诸父，政恐神锥未易同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其十","author":"李弥逊","text":"季子论才到履驹，十年不调可怜渠。\n自闻马祖今非佛，不似潜夫但著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其八","author":"李弥逊","text":"西林叶幄已藏鸦，若比蜗牛信可誇。\n更约此君成莫逆，北窗高卧看纷华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其一","author":"李弥逊","text":"筠溪岸上千竿竹，梦想犹疑玉笋斑。\n只欠吾家小居士，杖藜风雨亦来还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其二","author":"李弥逊","text":"病着先寻丘首地，林松已约野僧栽。\n他年地下从诸老，何必人间咏八哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵郎中弟见寄 其四","author":"李弥逊","text":"十年不踏横山路，日望白云千里思。\n宰木可围人更老，长镵犹记共栽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵拾青轩咏竹","author":"李弥逊","text":"论诗远到二南风，句里波涛得意浓。\n我亦赓酬还自笑，真成鱼目眩骊龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵春日即事","author":"李弥逊","text":"小雨丝丝欲网春，落花狼藉近黄昏。\n车尘不到张罗地，宿鸟声中自掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵表之道中见梅之作 其二","author":"李弥逊","text":"不是先争特特开，只缘沙际欲春回。\n行人浪起空华想，一夜归心着梦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵赵表之道中见梅之作 其一","author":"李弥逊","text":"近水疏篱竹半侵，枝南枝北弄晴阴。\n不因老眼分明见，辜负凌寒一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]