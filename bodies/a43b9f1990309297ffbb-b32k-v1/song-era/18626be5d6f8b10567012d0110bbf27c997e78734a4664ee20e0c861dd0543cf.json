":"宋_2.csv","pointer":34198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客夜霜寒","author":"郑刚中","text":"晓寒欺客入疏窗，梦破江南一夜霜。\n可但山林小摇落，树头无叶可飞黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"封州极少酴醾近得数蕊瘦小如纸花而清芬异常","author":"郑刚中","text":"小盘和雨送酴醾，瘦怯东风玉蕊稀。\n岂是书窗少培植，大都香足不须肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"度金沙岭","author":"郑刚中","text":"两行古木影交加，山欲侵云水见沙。\n最好岭前鸥鹭起，竹林深处两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"郑刚中","text":"朝来弄日花头密，暗里窥春柳眼多。\n任是老人情意薄，个般时节奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 春风","author":"郑刚中","text":"刘郎桃树欲挠春，一夜飘零最恼人。\n不似穷秋作霜露，摧残蒲柳有谁嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春到村居好四绝 其一","author":"郑刚中","text":"春到村居好，茅檐日渐长。\n杯深新酒滑，焙暖早茶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春到村居好四绝 其二","author":"郑刚中","text":"春到村居好，园林兴味长。\n蚕贪桑眼出，蜂趁蜜脾忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春到村居好四绝 其四","author":"郑刚中","text":"春到村居好，清明欲禁烟。\n乱红桃下雨，轻白柳飞绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春到村居好四绝 其三","author":"郑刚中","text":"春到村居好，枯肠饱可图。\n笋尖将露角，麦秀欲生须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 春雨","author":"郑刚中","text":"燕集深条帘未开，柳添新耳雨生苔。\n悲歌莫作子桑态，裹饭无人为我来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚","author":"郑刚中","text":"东望故园天一涯，官身到处且为家。\n六房吏散无留事，满袖乱红携落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其一 春雪","author":"郑刚中","text":"天散琪花压晚春，岂将灾沴祸吾民。\n为嗔宝货归夷虏，故种人间万顷银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其二 春雪","author":"郑刚中","text":"冰柱垂檐雪满山，今年寒食不胜寒。\n何门可曳长裾语，高卧从教刺墨漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其一 春晴","author":"郑刚中","text":"午梦悠飏一蝶轻，隔窗惊觉捣茶声。\n偶然樽酒得佳趣，半夜花间灯火明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其二 春晴","author":"郑刚中","text":"青烟漠漠昼无人，垂柳遮凉不见尘。\n饮水曲肱眠细草，绝胜肉食坐车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳子厚放鹧鸪词首章曰楚越有鸟甘且腴嘲嘲自名为鹧鸪前日相识惠野鸡一笼云骨脆而美糁之良妙视之则鹧鸪也使庖人具蔬食作小诗送之山中","author":"郑刚中","text":"肠腹元无一字书，杯羹那敢嗜甘腴。\n厨人不用催烟火，已学罗池放鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独坐","author":"郑刚中","text":"午枕幽禽破梦时，明窗过日竹阴稀。\n小炉翻转香残烬，犹有清香一缕飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸酉年梅花开已踰月而窗外黄菊方烂然","author":"郑刚中","text":"江梅久矣报涂粉，篱菊傲然方铸金。\n岭外四时惟一气，难分冬雾与秋阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋雨遽凉","author":"郑刚中","text":"数日窗无疏竹影，烟中长有万丝飞。\n不知小雨催时节，但觉朝来欠裌衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"郑刚中","text":"晓来自扫寒阶净，雨后又还黄叶添。\n秋色庭前容不尽，随风萧飒过疏帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胜仲少卿公惠岩桂并诗二绝用韵和之 其一","author":"郑刚中","text":"摇风暗绿疏疏叶，困日轻黄小小花。\n细认幽香已清绝，更随膏馥出君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胜仲少卿公惠岩桂并诗二绝用韵和之 其二","author":"郑刚中","text":"秋桂荷君亲折赠，倾盘高插傍胡床。\n儿童谩自温金鸭，三日炉金不敢香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草亭远望","author":"郑刚中","text":"酴醾试玉在新条，风肃朝阳宿雾消。\n侵晓不知花有露，清寒惟觉梦无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草寮书事","author":"郑刚中","text":"争巢野鹊噪木杪，得友黄莺栖柳阴。\n都与老夫供一笑，笑他禽鸟亦劳心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪道中四绝 其三","author":"郑刚中","text":"村村土物各风烟，物性无私祗自然。\n敛翼汀鸥随水下，藏头野鸭傍沙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪道中四绝 其四","author":"郑刚中","text":"晚投村舍款柴扉，一望门前野色微。\n西日堕云斜照尽，半山秋雨落馀飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪道中四绝 其二","author":"郑刚中","text":"竹边小径跨寒溪，息念临流万虑非。\n山鸟不知幽客意，背人相顾却惊飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]