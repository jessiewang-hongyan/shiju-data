[{"title":"呈周务本三绝 其二","author":"郑刚中","text":"浦江方此几人家，生事高低各有涯。\n安得巨灵开二岭，放教仁术过金华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈周务本三绝 其一","author":"郑刚中","text":"民因吏扰愈荒疲，不得田园破一犁。\n此邑端须知令尹，春来处处麦连畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈周务本三绝 其三","author":"郑刚中","text":"抚字心劳清愈甚，洁廉官小俸无多。\n知公但欲邦人乐，虽瘦虽贫不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈范茂直时在豫章","author":"郑刚中","text":"窗竹翛翛度晚风，浓香醇酒小寒中。\n玉人尚作桃花色，我辈苍颜何惜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀山居二绝 其二","author":"郑刚中","text":"披丛寻得晚花瘦，带雨剪来春韭香。\n忆把馀醺付松枕，明朝春梦不胜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀山居二绝 其一","author":"郑刚中","text":"春浅酒寒人密坐，花深雨细蝶移枝。\n十年未解作归计，此恨故园莺自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟为孙立之谢 其二","author":"郑刚中","text":"酴醾只作酴醾白，自得新诗添秀色。\n花头已是戴恩光，更渍露华无气力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居二首 其二","author":"郑刚中","text":"清心只有前溪水，息念唯凭一炷香。\n不觉青春倏过去，满村桑叶吐新黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居二首 其一","author":"郑刚中","text":"山风拂拂堕松钗，午日亭亭覆矮槐。\n一唾闲名归酒盏，万钧清思入诗怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜门","author":"郑刚中","text":"柴门深闭岂须开，谓可张罗亦陋哉。\n闲听竹间幽鸟语，绝胜门外俗人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"每岁正月度太阳岭半山间有梅花尝以此时开每见必折一枝丙午岁成一绝","author":"郑刚中","text":"孤根抱石半岩生，玉骨知春自发荣。\n我有此间来往债，年年须挽一枝行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵壁驿有方公美少卿留题戏和于壁","author":"郑刚中","text":"君把使旌临洛水，我参枢幕过潼关。\n秋风想见吹归渡，先看淮南第一山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"良嗣以予生朝将至以古赋一首为寿作三绝与之勉其省愆念咎当在念亲之先 其三","author":"郑刚中","text":"乳燕飞飞竹色深，阿枢娇贺想同斟。\n要知此日妇姑意，便是南方子父心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"良嗣以予生朝将至以古赋一首为寿作三绝与之勉其省愆念咎当在念亲之先 其二","author":"郑刚中","text":"五月榴花照午时，三年知汝忆亲闱。\n小笺写赋随香到，信是今年已庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"良嗣以予生朝将至以古赋一首为寿作三绝与之勉其省愆念咎当在念亲之先 其一","author":"郑刚中","text":"乾坤高厚爱无偏，罪大其如未许怜。\n莫向岁时加念我，共须忧畏补前愆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芙蓉","author":"郑刚中","text":"池边几簇木芙蓉，浥露栖烟花更浓。\n地有鲜鲜金菊对，赏时莫惜醉千钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛未中春旦极热流汗暮而风雨如深秋","author":"郑刚中","text":"起来流汗对朝曦，暮雨如秋意转迷。\n信是岭南秋半景，不须榕叶乱莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭后以水噀蚁时予有华严日课","author":"郑刚中","text":"蚁子寻香满地旋，岂知锅釜久无膻。\n赠渠一滴华严水，好去生他忉利天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"受崧兄弟赴漕司试作二十八言送之","author":"郑刚中","text":"丹桂亭亭五十尺，共持玉斧取来看。\n从前知有姜肱被，草怕早春天上寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元章春风三绝 其一","author":"郑刚中","text":"方欣解冻入花丛，蔌蔌俄惊万片红。\n草木岂能胜造化，吹开吹落任东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元章春风三绝 其三","author":"郑刚中","text":"一扫园林寂寂空，抱枝蝴蝶尚寻红。\n摧残老物无人惜，不比穷秋九月风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元章春风三绝 其二","author":"郑刚中","text":"平分四序递收巧，岂但留情白与红。\n莫讶晓来成谩诞，清微欲换舜弦风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和江虞仲华山二绝 其一 仙人掌","author":"郑刚中","text":"意象轩轩势入云，为谁出手若经纶。\n夜扶星斗朝擎日，气力何知几万钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和江虞仲华山二绝 其二 陈希夷无忧木","author":"郑刚中","text":"世累都忘春复秋，婆娑槐木亦无忧。\n不知千古云间梦，梦见山前虏马不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张叔靖三绝 其二","author":"郑刚中","text":"后生修饰正争妍，老者何颜与拍肩。\n竹径柴门闭深寂，嵇康只愿得高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李端明题灵峰","author":"郑刚中","text":"灵峰特立万山中，秋逼浓岚愈郁葱。\n旁绝逶迤虽寡助，其如气象自摩空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和季平哭小女时避地灵峰","author":"郑刚中","text":"荒山藤束木皮棺，见此令人鼻骨酸。\n自是杏殇风易剪，不须惭痛泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其一 春阴","author":"郑刚中","text":"澹云不雨翳朝曦，帘幕沉沉燕子归。\n细起一炉香雾润，犹扶酲困怯单衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和潘仲严八绝 其二 春阴","author":"郑刚中","text":"露薄云轻物色佳，平平绿水映人家。\n鸠鸣村暗开桑叶，燕舞风斜落杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜闻雪声","author":"郑刚中","text":"怒号中夜忽收声，枯叶寒梢细细鸣。\n晓起一杯檐外立，满阶无处认梅英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜寒","author":"郑刚中","text":"猎猎风吹屋上茅，夜寒都在早梅梢。\n明朝管取东窗暖，又看羲经过一爻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜寒觉有霜","author":"郑刚中","text":"不胜孤洁寒窗月，分外清圆远寺钟。\n后圃便当收橘柚，无疑侵晓一霜浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季天叙为人相宅过余求诗戏书二绝 其一","author":"郑刚中","text":"由来南巷独甘贫，季老徒誇眼有神。\n未暇相烦展高栋，方图种德效前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季天叙为人相宅过余求诗戏书二绝 其二","author":"郑刚中","text":"一区悬磬已偷安，常念风波世路艰。\n若谓他时庇寒士，会须令我作千间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚午冬至夜","author":"郑刚中","text":"旋寻村酒不须浓，饮少愁多酒易供。\n灯下一身家万里，今年恰好是三冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忠州丰都观乃阴长生之地山最高处栏槛围一古井谓是真人丹成乘云仙去之遗迹道士云时有云气出井中过而赋之","author":"郑刚中","text":"莫向山头觅古人，青山之外已为尘。\n弹圆朱橘怀中物，云气有无何足询。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"所居苦多鼠近得一猫子畜之虽未能捕而鼠渐知畏矣","author":"郑刚中","text":"嫩白轻斑尚带痴，敛身摇尾未成威。\n已知穴内两端者，祗齧馀蔬少退肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上","author":"郑刚中","text":"三面屏围屈曲山，篆炉灰冷柏无烟。\n霜钟不管春阴薄，声到寒窗客梦边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河池秋雨","author":"郑刚中","text":"一雨一凉秋气味，添愁添病客情怀。\n故园十亩檀栾好，个里归心未得谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐戏书","author":"郑刚中","text":"窗前寒雨正无边，案上含花烛影偏。\n莫念江湖家万里，一杯径醉且高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"法会堂前蒲萄一架每晨日至其上厨人辄报饭具感而为此","author":"郑刚中","text":"灶下釜声成菜糁，阶前日影上蒲萄。\n顽童不用催人饭，每食焉知愧尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泮宫出示盛作一编并诸父还还集一册作二十八字先还其编","author":"郑刚中","text":"墨带残膏浓复淡，笔生春意睟而温。\n昨朝借我还还集，须信芝兰别有根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范才翁惠酴醾","author":"郑刚中","text":"宝刀分惠过墙西，瘦比寒梅不肯肥。\n只恐东风苦无赖，为君吹作玉花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe