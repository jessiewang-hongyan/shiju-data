[{"title":"蝶恋花 春深","author":"赵长卿","text":"宿雨新晴天色好。\n秾李夭桃，一霎都开了。\n燕子归来深院悄。\n柳绵铺径无人扫。\n咫尺莺花还又老。\n绿入闲阶，只有青青草。\n参揣前期谁可表。\n此情不语知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 初夏","author":"赵长卿","text":"乱叠青钱荷叶小。\n浓绿阴阴，学语雏莺巧。\n小树飞花芳径草。\n堆红衬碧于中好。\n梅子弄黄枝上早。\n春已归时，戏蝶游蜂少。\n细把新词才和了。\n鸡声已唤纱窗晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 深秋","author":"赵长卿","text":"一梦十年劳忆记。\n社燕宾鸿，来去何容易。\n宿酒半醒便午睡。\n芭蕉叶映纱窗翠。\n衬粉泥书双合字。\n鸾凤鸳鸯，总是双双意。\n已作吹箫长久计。\n鸳衾空有中宵泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 暮春","author":"赵长卿","text":"芍药开残春已尽。\n红浅香乾，蝶子迷花阵。\n阵是清和人正困。\n行云散后空留恨。\n小字金书频与问。\n意曲心诚，未必他能信。\n千结柔肠愁寸寸。\n钿钗几日重相近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其一 登楼晚望，闻歌声清婉而作此","author":"赵长卿","text":"闲上西楼供远望。\n一曲新声，巧媚谁家唱。\n独倚危栏听半晌。\n长江快泻澄无浪。\n清泪恰同春水涨。\n拭尽重流，触事如何向。\n不觉黄昏灯已上。\n旧愁还是新愁样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 其三 宁都半岁归家，欲别去而意终不决也","author":"赵长卿","text":"叶底蜂衙催日晚。\n向晚匀妆，巧画宫眉浅。\n翠幕无风香自远。\n金船酌酒须教满。\n未说别离魂已断。\n雨幌云屏，只恐良宵短。\n心事不随飞絮乱。\n宦情肯把恩情换。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 和任路分荷花","author":"赵长卿","text":"忆昔临平山下过。\n无数荷花，照水无纤黦。\n短艇直疑天上坐。\n醉眠花里香无那。\n雨浥红妆娇娜娜。\n脉脉含情，欲向风前破。\n莫道晚来风景可。\n青房著子千千颗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 春暮","author":"赵长卿","text":"柳暗披风，桑柔宿雨。\n一番绿遍江头树。\n莺花已过苦无多，看看又是春归去。\n病酒情怀，光阴如许。\n闲愁俏没安排处。\n新来著意与兜笼，身心苦役伊知否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 夜凉","author":"赵长卿","text":"树影将圆，林梢不动。\n汗珠挹透纱衣重。\n荷风忽送雨飞来，晚凉习习生幽梦。\n珠箔高钩，瑶琴闲弄。\n移樽邀取蝉娟共。\n今宵拼著醉眠呵，夜香闻早添金凤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉花阴 建康重九","author":"赵长卿","text":"老去悲秋人转瘦。\n更异乡重九。\n人意自凄凉，只有茱萸，岁岁香依旧。\n登高无奈空搔首。\n落照归鸦后。\n六代旧江山，满眼兴亡，一洗黄花酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 春深","author":"赵长卿","text":"麦畦匀绿。\n枝头屑屑飞梅玉。\n伤心何事人南北。\n断尽回肠，忍听阳关曲。\n倚窗青荫亭亭竹。\n好风敲动声相续。\n夜阑怕见银台烛。\n会得离情，他也泪速速。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 重午","author":"赵长卿","text":"淡妆浓抹。\n西湖人面两奇绝。\n菖蒲角黍家家节。\n水戏鱼龙，十里画帘揭。\n凌波无限生尘袜。\n冰肌莹彻香罗雪。\n游船且莫催归楫。\n遮莫黄昏，天外有新月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠 初夜感怀","author":"赵长卿","text":"伤离恨别。\n愁肠又似丁香结。\n不应斗顿音书绝。\n烟水连天，何处认红叶。\n残更数尽银缸灭。\n边城画角声呜咽。\n罗衾泪滴相思血。\n花影移来，摇碎半窗月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 赏郡圃芍药","author":"赵长卿","text":"是三春已暮，浪蕊凋残，牡丹零落。\n独殿清和，有佳名芍药。\n浅浅芳丛，绣幢鼎鼎，更艳香绰约。\n浑似扬州，画楼卷起，翠帘红幕。\n倚槛轻盈，万娇千媚，故整霞裙，笑花寂寞。\n太守风流，拥笙歌围著。\n坐上诗人，二千里外，念此身飘泊。\n客眼看花，归心对酒，番成萧索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 春半","author":"赵长卿","text":"是平分春色，梦草池塘，暖风帘幕。\n昨夜三台，灿天边芝角。\n自是君家，庆流泽远，降生申崧岳。\n厚德温良，高才粹雅，渊源学博。\n何事丹墀，尚淹阔步，未许中原，少勤方略。\n且对笙歌，醉黄金错落。\n蕊洞珠宫，媚人桃李，趁青春绰约。\n绿意红情，成阴结子，五云楼阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其一 新荔枝","author":"赵长卿","text":"正火山槐夏，黛叶缃枝，荔子新摘。\n千里驰驱，荐仙源佳席。\n浪比龙睛，未输崖蜜，灿烂然红摘。\n满贮雕盘，纤纤素手，丹苞新擘。\n梨栗粗疏，带酸橘柚，凡品多般，总羞标格。\n何似浓香，洗烦襟仙液。\n为爱真妃，再三珍重，价倾城倾国。\n玉骨冰肌，风流酝藉，直宜消得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱 其二 端午","author":"赵长卿","text":"见浴兰才罢，拂掠新妆，巧梳云髻。\n初试生衣，恰三裁贴体。\n艾虎宜男，朱符辟恶，好储祥纳吉。\n金凤钗头，应时戴了，千般忔戏。\n那更殷勤，再三祝愿，斗巧合欢，彩丝缠臂。\n刻玉香蒲，泛金觥迎醉。\n午日熏风，楚词高咏，度遏云声脆。\n赤口白舌，从今消灭，诸馀可意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉蓬莱","author":"赵长卿","text":"正金风无露。\n玉宇生凉，楚郊无暑。\n催起行人，恰槐黄时序。\n万里晴霄，几人争睹，快鹏抟一举。\n明月圆时，素秋中夜，凌云新赋。\n那更渊源，词锋轻锐，笔阵纵横，学通今古。\n誉望飞腾，是麟宗文虎。\n魁荐归来，华堂香里，与管弦为主。\n待看明年，彤墀射策，鳌头独步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"赵长卿","text":"洗尽铅华不著妆。\n一般真色自生香。\n飘飘何处凌波女，故故相迎马上郎。\n寻谱谍，发诗囊。\n绝胜梅萼嫁冰霜。\n故山寒食依然在，句引东坡旅兴忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 霜夜","author":"赵长卿","text":"门外寒江泊小船。\n月明留客小窗前。\n夜香烧尽更声远，斗帐低垂暖意生。\n醺著酒，炙些灯。\n伴他针线懒成眠。\n情知今夜鸳鸯梦，不似孤篷宿雁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 咏荼五首 其一","author":"赵长卿","text":"弱质纤姿俪素妆。\n水沈山麝郁幽香。\n直疑姑射来天上，要恼人间傅粉郎。\n简酿酒，枕为囊。\n更馀风味胜糖霜。\n肯如红紫空姚冶，谩惹游蜂戏蝶忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"赵长卿","text":"玉容应不羡梅妆。\n檀心特地赛炉香。\n半藏密叶墙头女，勾引酡颜马上郎。\n樽乏酒，且倾囊。\n蟹螯糟熟似黏霜。\n一年光景浑如梦，可惜人生忙处忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 送春","author":"赵长卿","text":"只惯娇痴不惯愁。\n离情浑不挂眉头。\n可怜恼尽尊前客，却趁东风上小舟。\n真个去，不忺留。\n落花流水一春休。\n自怜不及春江水，随到滕王阁下流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 春暮","author":"赵长卿","text":"蜂蜜酿成花已飞。\n海棠次第雨胭脂。\n园林检点春归也，只有萦风柳带垂。\n情默默，恨依依。\n可人天气日长时。\n东风恰好寻芳去，何事驱驰作别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"赵长卿","text":"绿水澄江得胜游。\n浪平风软称轻舟。\n樽前我易伤前事，柳外人谁独倚楼。\n空感慨，惜风流。\n风流赢得谩多愁。\n愁多著甚销磨得，莫怪安仁鬓早秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 深秋悲感","author":"赵长卿","text":"亭树萧萧生暮凉。\n安排清梦到胡床。\n楚山楚水秋江外，江北江南客恨长。\n蘋渚冷，橘汀黄。\n断魂残梦更斜阳。\n欲将此日悲秋泪，洒向江天哭楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 荼","author":"赵长卿","text":"镂玉裁琼莫比香。\n娉婷枝上殢春光。\n风流别有千般韵，割舍昏沈入醉乡。\n蜂共蝶，尽乾忙。\n檀心知未肯寻常。\n从来诗苦人消瘦，乞与幽窗富锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 晨起，忽见大镜，睹物思人，有感而作","author":"赵长卿","text":"睡觉扶头听晓钟。\n隔帘花雾湿香红。\n翠摇钿砌梧桐影，暖透罗襦芍药风。\n闲对影，记曾逢。\n画眉临镜霎时同。\n相思已有无穷恨，忍见孤鸾宿镜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 梅","author":"赵长卿","text":"手种梅花三四株。\n要看冰霜照清臞。\n朝来几朵茅檐下，竹外江头恐不如。\n凝玉面，吐香须。\n莫嫌孤瘦渐丰馀。\n化工不肯辜人意，做底欢娱报答渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 咏燕","author":"赵长卿","text":"梁上双双海燕归。\n故人应不寄新诗。\n柳梧阴里高还下，帘幕中间去复回。\n追盛事，忆乌衣。\n王家巷陌日沈西。\n兴亡无限惊心语，说与时人总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"赵长卿","text":"落魄东吴二十春。\n风流诗句得清新。\n今年却恨花星照，再见温卿与远真。\n分楚佩，染巫云。\n赤绳结得短花茵。\n若非京口初相识，安得毗陵作故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"赵长卿","text":"镂玉裁琼学靓妆。\n不须沈水自然香。\n好随梅蕊妆宫额，肯似桃花误阮郎。\n羞傅粉，贱香囊。\n何劳傲雪与凌霜。\n新来句引无情眼，拼为东风一晌忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 月夜诸院饮酒行令","author":"赵长卿","text":"宝篆烟消香已残。\n蝉娟月色浸栏干。\n歌喉不作寻常唱，酒令从他各自还。\n传杯手，莫教闲。\n醉红潮脸媚酡颜。\n相携共学骖鸾侣，却笑卢郎旧约寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 偶有鳞翼之便，书以寄文卿","author":"赵长卿","text":"一曲清歌金缕衣。\n巧佼心事有谁知。\n自从别后难相见，空解题红寄好诗。\n忆携手，过阶墀。\n月笼花影半明时。\n玉钗头上轻轻颤，摇落钗头豆蔻枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 腊夜","author":"赵长卿","text":"宝篆龙煤烧欲残。\n细听铜漏已更阑。\n纱窗斜月移梅影，特地笼灯仔细看。\n幽梦断，旧盟寒。\n那时屈曲小屏山。\n风光得似而今不，肯把花枝作等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 春残","author":"赵长卿","text":"谡谡东风作雨寒。\n无言独自凭栏干。\n绿肥红瘦春归去，恨逼愁侵酒怎宽。\n追往事，惜花残。\n残花往事总相关。\n风光台上伤心处，此意人休作等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"赵长卿","text":"绰约肌肤巧样妆。\n风流元自有清香。\n未应傅粉疑平叔，却笑荷花似六郎。\n浮蚁瓮，入诗囊。\n学人消瘦怯风霜。\n午窗一枕庄周梦，甘作花心粉蝶忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 初夏试生衣，而婉卿持素扇索词，因作此书于扇上","author":"赵长卿","text":"牙领番腾一线红。\n花儿新样喜相逢。\n薄纱衫子轻笼玉，削玉身材瘦怯风。\n人易老，恨难穷。\n翠屏罗幌两心同。\n既无闲事萦怀抱，莫把双蛾皱碧峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 夜钓月桥赏荷花","author":"赵长卿","text":"新晴水暖藕花红。\n烘人暑意晚来浓。\n共携纤手桥东路，杨柳青青一径风。\n深翠里，艳香中。\n双鸾初下蕊珠宫。\n月笼粉面三更露，凉透萧萧一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"簇水","author":"赵长卿","text":"长忆当初，是他见我心先有。\n一钩才下，便引得鱼儿开口。\n好是重门深院，寂寞黄昏后。\n厮觑著、一面儿酒。\n试撋就。\n便把我、得人意处，闵子里、施纤手。\n云情雨意，似十二巫山旧。\n更向枕前言约，许我长相守。\n忺人也，犹自眉头皱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 其二 和梅","author":"赵长卿","text":"雪花飞歇。\n好向前村折。\n行至断桥斜处，寒蕊瘦、不禁雪。\n韵绝。\n香更绝。\n归来人共说。\n最爱夜堂深迥，疏影占、半窗月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 霜夜小酌","author":"赵长卿","text":"閤儿幽静处，围炉面小窗。\n好是斗头儿坐，梅烟炷、返魂香。\n对火怯夜冷，猛饮消漏长。\n饮罢且收拾睡，斜月照、满帘霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 其一 咏梅","author":"赵长卿","text":"香来不歇。\n谁把南枝折。\n的砾疏花初破，都因是、夜来雪。\n清绝。\n十分绝。\n孤标难细说。\n独立野塘清浅，谁作伴、空夜月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台","author":"赵世长","text":"琼台卜幽隐，金液鍊真精。\n冰雪形容古，烟霞意思清。\n谈玄通至道，养素达长生。\n被诏离仙窟，安居入帝京。\n唐虞回圣眷，巢许让高名。\n抗节辞丹陛，归心恋赤城。\n再眠琪树影，重听瀑泉声。\n朝客多攀饯，天章复赠行。\n令猷光史策，逸态傲公卿。\n珍重青云外，逍遥乐太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵世长","text":"玉清仙子下云达。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵世长","text":"莫恨东风剪拂迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄夹山芳别圃","author":"赵世延","text":"本来包却太虚空，万象森罗立下风。\n假使悠悠千百世，圣人复出此心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵世昌","text":"绿珠楼下志惆怅，宋玉墙头又别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵世昌","text":"一条横截红尘断，几曲遥通紫禁深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵希棼","text":"风雨送迎地，别离多少人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凌霄花为复上人作","author":"赵东阁","text":"袅袅枯藤浅绛葩，夤缘直上照残霞。\n老僧不作依附想，将谓青松自有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄圣水照讲师","author":"赵汝回","text":"圣水水深山亦深，寺前三十里清阴。\n一僧趺坐松间石，不是安禅定苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春山堂","author":"赵汝回","text":"山在画堂西，钩帘静对时。\n林高日落早，巷僻客来迟。\n抱病独不饮，爱闲君所知。\n阶前碧梧叶，片片可题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父","author":"赵汝回","text":"衡岳早来雨，湘江增绿波。\n小舟浮似屋，香草结为蓑。\n水定见鱼影，夜清闻棹歌。\n悠悠百年梦，醒少醉时多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泉南花木","author":"赵令衿","text":"偶然游宦刺桐城，两见南薰荔子生。\n欲别北楼还小立，留题云榭岂无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠鹅湖上人","author":"赵令衿","text":"三年四度到鹅湖，山水娱人道不孤。\n最是可人快心目，晓风残月弄菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李伯纪丞相挽诗 其四","author":"赵令衿","text":"鲸路心犹望，龙门迹已荒。\n楼成上霄汉，书拟奏明光。\n贱子无贤誉，先生独荐扬。\n凛然生气在，谁谓哲人亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李伯纪丞相挽诗 其二","author":"赵令衿","text":"相位期三入，人心望一新。\n名称高世表，器识自天真。\n孰谓仁人寿，空怜吾道贫。\n彼苍如有意，应百赎其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李伯纪丞相挽诗 其一","author":"赵令衿","text":"道大终为累，功高反被疑。\n恨无长日月，宝此大蓍龟。\n鼓咽空山暮，风酸落木悲。\n吊丧哀不及，赖有哭公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李伯纪丞相挽诗 其三","author":"赵令衿","text":"气量吞云梦，风流冠习池。\n致君虽素定，济众未全釐。\n傒望金瓯诏，俄摧玉树枝。\n天心殊莫晓，神物失扶持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其一","author":"赵令畤","text":"楼上风和玉漏迟。\n秋千庭院静，百花飞。\n午窗才起暖金卮。\n匀面了，阑畔看春池。\n何事苦颦眉。\n碧云春信断，尽来时。\n鸳鸯游戏镇相随。\n云雾敛，新月挂天西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山 其二","author":"赵令畤","text":"雨霁风高天气清。\n玉盘浮出海，转空明。\n小窗帘影冷如冰。\n愁不寐，独自傍阶行。\n情似浪头轻。\n一番销欲尽，一番生。\n无言惆怅到参横。\n人欲起，鹎鵊几声鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼 春思","author":"赵令畤","text":"楼上萦帘弱絮，墙头凝月低花。\n年年春事关心事，肠断欲栖鸦。\n舞镜鸾衾翠减，啼珠凤蜡红斜。\n重门不锁相思梦，随意绕天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]