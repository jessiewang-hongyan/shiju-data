[{"title":"吴江太湖笠泽虹桥","author":"俞可","text":"范蠡避名湖上去，季鹰乘兴日边归。\n洲连笠泽春游远，路入松陵夜钓稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞可","text":"拂座好风来橘社，隔汀长笛过松江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤春","author":"俞处俊","text":"黏天芳草绿蒙茸，久客伤心望不穷。\n山色自随人远近，莺声只在水西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"搜春","author":"俞处俊","text":"千林欲暗稻秧雨，三月尚寒花信风。\n九节老筇应不惜，步随流水看残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百字令","author":"俞处俊","text":"残蝉断雁，政西风萧索，夕阳流水。\n落木无边幽眺处，云拥登山屐齿。\n岁月如驰，古今同梦，惟有悲欢异。\n绿尊空对，故人相望千里。\n追念淮海当年，五云行殿，咫尺天颜喜。\n清晓胪传仙仗里，衣染玉龙香细。\n今日天涯，黄花零乱，满眼重阳泪。\n艰难多病，二陵无奈秋思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞处俊","text":"叫月子规喉舌冷，宿花蝴蝶梦魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游妙行寺","author":"俞本","text":"中峰苍翠里，微径入禅关。\n石座香尘积，莲池苔藓班。\n鹤盘云在树，龙过雨侵山。\n会得规中意，怡然一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题英州金山寺壁 其二","author":"俞似","text":"转食胶胶扰扰间，林泉高步未容攀。\n兴来尚有平生履，管领东南到处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题英州金山寺壁 其一","author":"俞似","text":"莫遣韝鹰饱一呼，将军谁志灭匈奴。\n年来万事灰人意，只有看山眼不枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台","author":"俞成","text":"千古英风想子陵，钓台缘此几人登。\n谁知避讳更严氏，滩与州名总误称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久客","author":"俞汝尚","text":"久客西城里，人家似旧邻。\n众知趋事懒，僧厌打门频。\n倦枕费窗竹，开书破砚尘。\n阴晴消白日，门巷忽青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山招复古","author":"俞汝尚","text":"闻道广文客，东来欲载书。\n志勤甘淡薄，情旧免生疏。\n野饭多无菜，溪羹或有鱼。\n小心新买得，且遂带经锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汝尚将归吴兴齐州记室苏子由辱诗为送因逐韵谢之","author":"俞汝尚","text":"释屦从军蚤滥官，已衰能复尚盘桓。\n迩来齿发羞相问，乞有衡茅觅自安。\n使我襟怀遗内热，诵君诗句袭人寒。\n知谁便是知音者，且作岩溪雪景看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过淮阴侯庙","author":"俞汝尚","text":"当时谋战不谋安，将众多多是祸端。\n万垒在前攻掠易，四方无事保全难。\n晓堂钟鼓修淮祀，古壁旌旗拥汉官。\n天下息肩兵革定，一瞻祀宇一长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戒香院","author":"俞汝尚","text":"崎岖穷谷翠屏围，却讶游人到此稀。\n修竹带云当户耸，暗泉鸣玉绕亭飞。\n春风欲老茶含旆，暑雨初收水带矶。\n扰扰红尘何处好，令人回首重忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日闲居","author":"俞汝尚","text":"无人到穷巷，长日守闲居。\n宿火惟烘药，新晴还晒书。\n邻翁伴村酒，稚子课园蔬。\n门外蒿莱地，泥深不用锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张伯玉倅古睦","author":"俞汝尚","text":"新定烟霞外，溪山清可依。\n夜风泉溜响，春雨药苗肥。\n野鹤眠花圃，晴岚湿案衣。\n预知公暇日，垂钓子陵矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三角亭","author":"俞汝尚","text":"奇哉山中人，搆此池上宇。\n蕙径斜映带，林烟尽吞吐。\n春无四面花，夜欠一帘雨。\n寄傲足有馀，何须循广庑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蒙泉","author":"俞汝尚","text":"幽人斸寒泉，井甃名曰蒙。\n井贵德不改，蒙以养为功。\n非徒玩清冷，润液幽芳丛。\n说筑傅岩下，伊耕莘野中。\n静守一夫事，勤政王道隆。\n孔孟不得志，日月经高穹。\n休哉圣贤心，养私而用公。\n宇宙间生民，草木与昆虫。\n仁渐而秾郁，义惨而庞洪。\n泓泓此中泉，与物资天功。\n勿谓短绠浅，海底渊源通。\n勿谓一勺轻，洗涤人心空。\n近林郁青苍，远涧与冲融。\n往往中间云，霶霈起天风。\n汲引即所利，孰遣榛莽丰。\n有道无得丧，孰患番险濛。\n君子修诸业，虑初而图终。\n为君赋此诗，勿厌吾道穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴","author":"俞自得","text":"暄和春景好供诗，日暖风轻土脉肥。\n白鹭时窥秧刺刺，黄莺频说柳依依。\n几回野水闻姑恶，数树春英叫姊归。\n物态满前看不足，等闲吟咏对斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝶恋花 怀旧","author":"俞克成","text":"梦断池塘惊乍晓。\n百舌无端，故作枝头闹。\n报道不禁寒料峭。\n未教舒展闲花草。\n尽日帘垂人不到。\n老去情疏，底事伤春瘦。\n相对一樽归计早。\n玉山不减巫山好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲","author":"俞君宣","text":"小姨学采莲，两腕白于雪。\n花色妒缃裙，瓣瓣红如血。\n西邻小姑亦采莲，隔岸徒闻语笑喧。\n从来不相识，相呼好并船。\n停桡花下勤把手，他年何处投箕帚。\n苦乐参差不可言，此日花开得来否。\n难割藕丝肠，怕逢游冶郎。\n归去风吹小簟凉，时闻花外香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送砚与吴元真广文","author":"俞君选","text":"插天万仞芙蓉峰，茫茫积翠连青空。\n中有千年苍玉骨，山奇水怪秀所钟。\n断崖绝壁不可到，虎豹守护烟萝封。\n一朝良工夺天造，云斤月斧磨玲珑。\n踏天下割碧云髓，往往霹雳惊蛇龙。\n冰蚕吐丝织新就，罗文光瑩浮青铜。\n人间何处用此物，造化欲付文章公。\n先生早晚运椽笔，判花视草蓬莱宫。\n手挥五色补天漏，放开白日消阴虹。\n坐令万物无疵疠，尽从笔底生春风。\n此时浓墨书大字，正须巨石相追从。\n愿公收拾此至宝，相伴他年参化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"俞君锡","text":"蛩声依坏砌，树影倒寒池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"俞君锡","text":"教仆扫枯叶，留僧煎早茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"俞君锡","text":"洗瓢鱼隐石，扫叶蚁移家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"俞君锡","text":"荒店难寻酒，长途半趁船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"俞君锡","text":"野猿偷果去，村仆借书还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"俞君锡","text":"半身长在旅，何日定还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦皇石","author":"俞应佥","text":"祖龙盛气役神鞭，壁立无移只屹然。\n定见先朝陈宝化，阴灵寂寂笑求仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漳河疑冢","author":"俞应符","text":"生前欺天绝汉统，死后欺人设疑冢。\n人生用智死即休，何有馀机到丘垄。\n人言疑冢我不疑，我有一法君未知。\n直须尽发疑冢七十二，必有一冢藏君尸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"俞秀才","text":"天高日远云雾阔，黄金白璧孤虞卿。\n汉廷无人荐司马，故山有客呼孔宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"流花亭","author":"俞纯父","text":"山溪穷洞府，江岸绕楼闉。\n晓艳尝迷客，飞香尚袭人。\n凭高能赋远，祖别重伤春。\n莫惜离歌醉，曾闻上玉津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶花 其二","author":"俞国宝","text":"玉洁冰寒自一家，地偏惊此对山花。\n归来不负西游眼，曾识人间未见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山茶花 其一","author":"俞国宝","text":"花近东溪居士家，好携樽酒款携茶。\n玉皇收拾还天上，便恐筠阳无此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子","author":"俞国宝","text":"剪烛写香笺，拨火温寒醑。\n门外东风将我愁，欲作三更雨。\n夜夜玉楼心，日日长亭路。\n豆蔻花开信不来，尘满金钗股。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"俞国宝","text":"灵谷有荚气，盘结在巴山。\n云蒸雨朵欲遣，奇怪出人间。\n不作丰城宝剑，不作渥洼灵种，不作化龙竿。\n生此济时杰，理乱总相关。\n入为相，出为将，两馀闲。\n忠肝义胆，曾将鲠论破天颜。\n好把昪平勋业，趁取河清桃熟，千岁奉金銮。\n草却登封检，双鬓未曾斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松","author":"俞国宝","text":"一春长费买花钱。\n日日醉花边。\n玉骢惯识西湖路，骄嘶过、沽酒垆前。\n红杏香中箫鼓，绿杨影里秋千。\n暖风十里丽人天。\n花压髻云偏。\n画船载取春归去，馀情寄、湖水湖烟。\n明日重扶残醉，来寻陌上花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"俞国宝","text":"云收雾敛，过一番疏雨，秋容新沐。\n月满巴山天似水，满眼祥云飞扑。\n一点长庚，瑞腾光彩，独照梅仙屋。\n十洲三岛，有人初降凡俗。\n长怪李白疏狂，骑鲸一去，千载无人逐。\n也解重来应尚欠，多少人间传曲。\n只怨君王，促归批诏，夜对金莲烛。\n蓬仙日醉，不知海岛桃熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"俞国宝","text":"落落江湖三岛，才高懒住清都。\n手携黄石一编书。\n醉眠莘垄月，闲钓渭川鱼。\n见说玉阶三尺地，思君来讲唐虞。\n夜来南极一星孤。\n不知天子梦，曾到傅岩无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙","author":"俞国宝","text":"春到江南江北了，东皇未识花权。\n直将和气入巴川。\n逢迎天上客，来作地行仙。\n满捧一杯听细说，只今谁似公贤。\n愿推功业辅尧年。\n都将闲日月，来醉百花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 梅","author":"俞国宝","text":"梦里骖鸾鹤。\n觉三山不远，依前海风吹落。\n浮到五湖烟月上，刚被梅香醉着。\n粲玉树、轻明疏薄。\n十万琼琚天女队，捧冰壶、玉液琉璃杓。\n来伴我，荐清酌。\n恍然梦断浑非昨。\n问溪边竹外，新来为谁开却。\n无限冰魂招不得，拟把离骚唤觉。\n待抖擞、红尘双脚。\n万里瑶台终一到，想玉奴、不负东昏约。\n留此恨，寄残角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"俞国宝","text":"数声乌鹊。\n院宇寒萧索。\n杨柳梢头秋过却。\n无叶可供风落。\n可人犹有芙蕖。\n向人冷澹妆梳。\n云外征鸿过尽，夕阳依旧平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳","author":"俞国宝","text":"南省西清，黄扉青琐，五年历遍中都。\n一封朝奏，无乃爱君欤。\n便作筠阳胜赏，东溪上、鸥鸟相娱。\n谁知道，心存魏阙，身暂寄江湖。\n东溪，何所有，冬梅夏柳，春杞秋蕖。\n谩回首，多少笼鸟池鱼。\n细看山林朝市，经行处、等是蘧庐。\n今朝好，一杯寿酒，一卷养生书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"俞国宝","text":"春衫和泪著。\n又燕入江南，雁归衡岳。\n东风晓来恶。\n绕西园无绪，泪随花落。\n愁钟恨角。\n梦无凭、难成易觉。\n到春来易感，韩香顿减，沈腰如削。\n离索。\n挑灯占信，听鹊求音，不禁春弱。\n云轻雨薄。\n阳台远，信难托。\n念盟钗一股，鸾光两破，已负秦楼素约。\n但莫教、嫩绿成阴，把人误却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 其一","author":"俞国宝","text":"群花烂熳，春色浓如酒。\n芳草绿铺茵，正荼蘼、牡丹时候。\n佳辰协瑞，来降蕊宫仙，珠帘卷，画堂深，香雾腾金兽。\n朱颜绿鬓，不改长如旧。\n金盏莫辞深，拚通宵、尽从银漏。\n笙歌丛里，欢笑度年华。\n看荣贵，有儿孙，永祝松椿寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龚菊岩房清境堂即事","author":"俞昕","text":"物外神仙窟，巾车为小停。\n一泓寒玉境，四面翠微屏。\n清境诗无尽，红尘眼顿醒。\n我来谋此住，把酒问山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游大涤","author":"俞茂实","text":"未了烟霞痼，来从大涤游。\n一区藏世界，九锁閟林丘。\n寒翠霏霏起，春波慢慢流。\n人间空岱岳，海上谩瀛洲。\n隐迹悲猿鹤，祥光射斗牛。\n有人相领略，何地不夷犹。\n好景行行得，遗踪细细搜。\n山根云欲滃，石罅凤仍留。\n琴瑟听泉奏，珠玑看瀑流。\n山灵应有识，鄙句含包羞。\n逸兴那能已，奇观谩此酬。\n会须寻石室，相继筑菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺陈随隐以布衣除东宫掌书","author":"俞某","text":"万人海里辟幽扉，欲学深居只布衣。\n不道内前车马闹，又催父子入宫闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"俞洵直","text":"九折山围五洞天，中间玉殿倚祥烟。\n隔云鸡犬闻清晓，锁径松篁认永年。\n野鹿献花来石室，寒猿掷果饮溪泉。\n玉皇弄笑飞金电，太上红颜雪满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕有怀","author":"俞桂","text":"擘钗情绪思悠悠，月下穿针懒傍楼。\n非独双星苦离别，人间天上一般愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"口占","author":"俞桂","text":"园林绿暗又红稀，蜀鸟啼山笋蕨肥。\n春夏一番交篆早，绵衣脱了著单衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"俞桂","text":"剖竹相通涧下泉，更邀山色在樽前。\n一钩明月轩窗上，攲枕藤床独自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"心事","author":"俞桂","text":"落落功名鬓早斑，蹉跎心事十年间。\n看来只合归湖上，渔钓丛中尽日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月夜","author":"俞桂","text":"江南又见雁初飞，枫叶萧疏旋觉稀。\n边塞戍夫天气冷，谁家月夜捣征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午七夕后一日晚抵松江塔下 其一","author":"俞桂","text":"到得垂虹迫暮烟，前村雨暗莫行船。\n幸然得与僧人熟，借得终宵客位眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙午七夕后一日晚抵松江塔下 其二","author":"俞桂","text":"客中情况少人知，正值钟声约束时。\n清坐更无人共话，挑灯来看菊潭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东山","author":"俞桂","text":"东山随分作生涯，即是清高隐者家。\n粗有小园供日涉，不愁无地种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"半塘","author":"俞桂","text":"因访云岩过半塘，清明时候野花香。\n小舟趁雨冲风去，不及寻僧到上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平湖","author":"俞桂","text":"平湖一景堪图画，舟子烟波去复归。\n旧日玄真无觅处，西山长见鹭鸶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"买鱼","author":"俞桂","text":"芦花荷叶晚秋天，雁影横斜远水连。\n频唤买鱼人不应，偷忙撑入怕官船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"军中请衣","author":"俞桂","text":"诸营今日请春衣，积沓如山竞捧归。\n曾念雪中兵堕指，戍边铁甲正防围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"农事","author":"俞桂","text":"东作农家处处忙，金珠非是疗饥方。\n京华只识笙歌乐，岂识男耕与女桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"俞桂","text":"客里匆匆二月春，梅花开后柳争新。\n西湖不待清明到，早有寻芳拾翠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴","author":"俞桂","text":"漫山花发草萋萋，杨柳飞绵水拍堤。\n况是客怀禁不得，那堪杜宇耳边啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次吴秋潭韵","author":"俞桂","text":"相逢款话傍檐西，坎止流行事不齐。\n君到白蘋秋正好，饱吟风月棹前溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"俞桂","text":"江头云阁雨，柳色与春深。\n船发春风阻，谁知客子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"俞桂","text":"小雨才收日渐斜，酒旗插处两三家。\n江头妆点秋来景，半是芦花半蓼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江头","author":"俞桂","text":"渔浦山边白鹭飞，西兴渡口夕阳微。\n等闲更上层楼望，贪看江潮不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]