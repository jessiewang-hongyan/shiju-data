[{"title":"闻诗得男名之曰夔","author":"王十朋","text":"巫邑初传鲤，吾家遂得夔。\n遥来如马地，却应梦熊诗。\n官忝二千石，孙看第一枝。\n欣同君子抱，祝汝似吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘露降于宅堂竹间凡半月三经雨乃止州宅有甘露堂昔周□□侍郎为郡露降焉易见山堂以名之予无善政惧其为灾记以二绝 其一","author":"王十朋","text":"湛湛下脩竹，味如饴蜜甘。\n人言此为瑞，无德可能堪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘露降于宅堂竹间凡半月三经雨乃止州宅有甘露堂昔周□□侍郎为郡露降焉易见山堂以名之予无善政惧其为灾记以二绝 其二","author":"王十朋","text":"竹间甘露日瀼瀼，饴蜜珠玑带细香。\n天闵夔民岁饥馑，雨旸时若乃嘉祥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元章赠兰","author":"王十朋","text":"英英道山友，赠我深林芳。\n入室与俱化，同心如此香。\n纫之可为佩，不采庸何伤。\n三复韩子操，援琴鼓扬扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧龙山有武侯新祠再用前韵","author":"王十朋","text":"山藏古寺柏青青，地重端因蜀相登。\n沙上不闻江转石，人间几见谷为陵。\n龙蛇树影摇千尺，玉雪花枝吐万层。\n堪叹草庐谁复顾，凄然香火却依僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄书与二叔二弟 其一","author":"王十朋","text":"八十高年林下老，四千馀里梦中家。\n云安双鲤随春水，为我传书到永嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄书与二叔二弟 其二","author":"王十朋","text":"左原端是脊令原，谁遣分飞到蜀门。\n况是清明寒食候，杜鹃声里断离魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题卧龙山观音泉呈行可元章","author":"王十朋","text":"去岁游庐山，社中观白莲。\n不饮远公酒，聊酌聪明泉。\n肩舆过武昌，乘兴西山巅。\n岩乳饮菩萨，诗篇诵苏仙。\n夔州苦无井，瘿俗殊可怜。\n竹筒喉不乾，可浣不可煎。\n日汲卧龙水，屡赖担夫肩。\n所取都几斛，深惭未投钱。\n前日招提游，入耳声涓涓。\n泓澄可照胆，草木皆光妍。\n却疑南阳人，蟠蛰清泠渊。\n惨淡会风云，滂沱霖普天。\n源如少陵词，清入光芒篇。\n馀波涨瞿唐，汹涌吞百川。\n何人著水经，漏此不及编。\n道人出新茗，林间手新研。\n共以夷齐心，来结观音缘。\n至今清夜梦，犹到幽亭边。\n交游况离索，回首成悽然。\n何时鹿呦呦，重访山中禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元章赠笔戏成一绝","author":"王十朋","text":"东台使者妙诗文，赠我中书四十君。\n我不善书惭拜赐，中书今日遇将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再酬元章","author":"王十朋","text":"一尊方喜细论文，春草题诗又送君。\n手握管城言不尽，诗坛谁复将中军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又答行可","author":"王十朋","text":"道造精微更有文，绛侯应愧不如君。\n试将武事论诗笔，句法严于细柳军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬行可惠白酒","author":"王十朋","text":"渴怀思欲吸长江，闻说西台酿满缸。\n一斗青州白从事，忽随诗句到蓬窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同行可元章报恩寺行香登佛牙楼望胜己山","author":"王十朋","text":"篮舆拂晓出东关，钟磬声闻杳霭间。\n心欲报恩频入院，人逢胜己更观山。\n竹香细细禅房静，江水浑浑野渡闲。\n欲问渔人国兴废，黄鹂隔叶语绵蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其一","author":"王十朋","text":"蜀江险处是夔州，滟滪堆边看竞舟。\n为报鄱阳相识道，去年人在此登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其二","author":"王十朋","text":"台前八阵己陈迹，水底三闾何处招。\n手把菖蒲对佳节，兴来呼酒劝同僚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其三","author":"王十朋","text":"鄱阳夔子两端午，去岁人如今岁人。\n直是吴头来蜀尾，子规声里吊灵均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其四","author":"王十朋","text":"榴花照眼对佳客，荷叶传杯怀故乡。\n想见明年话夔子，又如今岁念鄱阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其五","author":"王十朋","text":"黍遇今朝尽生角，艾从何处忽为神。\n荷香十里一钩月，定有扁舟归去人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其六","author":"王十朋","text":"舟人鼓楫呼何在，声似湘沅江上声。\n更听刘郎竹枝曲，不论南北总伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其七","author":"王十朋","text":"细葛含风罗叠雪，近臣初拜赐衣时。\n愿因角黍询遗俗，学士宁无六一词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其八","author":"王十朋","text":"竞渡本来缘救溺，凌波初不为争标。\n今人不解古人意，得胜归来笑语嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月四日与同僚南楼观竞渡因成小诗四首明日同行可元章登楼又成五首 其九","author":"王十朋","text":"綵舟两两鼓鼕鼕，胜己山阴瀼水东。\n父老相逢话良苦，儿郎多在马船中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘韶美至巫山寄诗因次其韵","author":"王十朋","text":"终日思归未有涯，梦魂无夜不还家。\n莫云春树忆太白，流水高山逢伯牙。\n卷轴随身虽有厄，风流得罪可无哗。\n相逢莫便匆匆去，弭棹夔门过食瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送元章改漕成都","author":"王十朋","text":"取友四十载，普天半交游。\n蒹葭群玉间，莫盛登瀛洲。\n元章真国士，未见心已投。\n雅抱畎亩志，共怀天下忧。\n馆阁育人材，孰云专校雠。\n慷慨论世事，不见范尹欧。\n疆埸况如许，宁不忧宗周。\n精忠屹肝胆，苦语惊冕旒。\n君去最勇决，我行尚迟留。\n初别拟十载，相逢忽三秋。\n龙飞起元老，江淮握貔貅。\n礼罗得奇才，戎幕资良筹。\n人事苦好违，壮怀莫能酬。\n去持夔州节，遥泛瞿唐舟。\n我亦来自鄱，兹行岂人谋。\n八阵观壮图，三峡窥倒流。\n访君义胜堂，顾我制胜楼。\n如马谒白帝，卧龙寻武侯。\n江亭览月色，园花赏春柔。\n果分馀味甘，兰赠深林幽。\n诗篇浩卷轴，墨妙辉山丘。\n气薄文艳杜，词卑竹枝刘。\n吏事容拙疏，交情荷绸缪。\n纶言下北阙，绣衣使西州。\n流钱岂君事，易地曾何优。\n胡不班玉笋，入告嘉谋猷。\n巴子国最贫，疮痍民未瘳。\n君去谁抚摩，欲借嗟无由。\n我已上祠章，归欤老田畴。\n迟君还日边，寄书到东瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵元章留别","author":"王十朋","text":"送客成都去，回舟白帝边。\n月应遥共对，夔复有谁怜。\n我只怀归计，君宜了世缘。\n相期翼吾道，馀事读楞圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜与韶美饮酒瑞白堂秉烛观跳珠，分韵得跳字","author":"王十朋","text":"五月峡中天气歊，竹筒引水那能浇。\n江濆龙老卧未起，崖石不枯珠自跳。\n草草杯盘对君酌，灯前疑是檐花落。\n毫端写出万斛珠，共向炎天作冰雹。\n妃子名园荔子丹，绛囊初摘堆金盘。\n细擘轻红唱君曲，咀嚼水晶牙颊寒。\n老翁真个如年少，激水成珠堪一笑。\n刘侯自有胸中珠，不止照人兼自照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仪凤得珠字","author":"王十朋","text":"别来世故朝昏殊，相与言之汗模糊。\n两翁得酒促坐席，感深念极气欲苏。\n箨龙亦解作水供，紬绎寻丈如渴乌。\n衣巾生秋背毛竖，金石相应环佩趋。\n江山豪壮旁尊俎，醉中频贯累累珠。\n此时一事复挂口，为乐未竟成喑呜。\n夔州忧民困汤火，润泽有志无坦途。\n眼前焦熬十万户，欠伸戏笑皆沾濡。\n自操量槩入官廪，不输一钱分水符。\n读书功力无表畔，久矣俗吏轻吾儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵韶美失舟闵书","author":"王十朋","text":"医师笼参朮，良将枕戈矢。\n儒生嗜底物，书卷挂口齿。\n刘侯西南来，岁月十首尾。\n闭门阅古今，过眼分亥豕。\n异书照神藜，奇字哭妖鬼。\n许身如蠹鱼，文字共生死。\n风流反得罪，去国果谁耻。\n仙舟载秘阁，便腹贮名理。\n江神亦世情，逐客多不喜。\n厄同焚书秦，恶类灭邢燬。\n沾濡遍箱箧，痛惜到骨髓。\n我初闻为惊，终夜成坐起。\n得君诗细读，罪己不罪水。\n愿言坐啸馀，书著子刘子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韶美归舟过夔留半月语离作恶诗二章以送 其一","author":"王十朋","text":"五载三诗送我归，古夔今作送君诗。\n相如游处符分竹，诸葛阵旁舟解维。\n秉烛莫辞频把酒，挥毫未免各忧时。\n可怜滟滪双蓬鬓，会合无多又别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元章至云安用送韶美韵见寄次韵以酬","author":"王十朋","text":"社燕秋鸿不共飞，却因送别更怀归。\n一壶独酌人何处，千里相思月满扉。\n烟雨已催予把钓，功名行看子投机。\n云安双鲤传书至，诗句清含山水晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静晖楼前有荔子一株木老矣犹未生予去其枯枝今岁遂生一二百颗至六月方熟","author":"王十朋","text":"木老生迟六月丹，明珠百颗照朱颜。\n因渠风味思瑶柱，撩我乡心念玉环。\n路远应难三日寄，楼高更上一层攀。\n君谟谱内丁香种，宜在江陈品第间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行可和诗再用前韵","author":"王十朋","text":"肌肤冰雪鹤头丹，三峡相逢一破颜。\n人折高枝如折桂，鸟衔馀颗似衔环。\n香传乐谱名尤重，红入诗家句莫攀。\n来岁熟时先寄我，梦魂应到白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行可再和因思前日与韶美同饮计台临池摘实复用前韵","author":"王十朋","text":"星火烧空一夜丹，来禽青李觉无颜。\n少陵池馆三人赏，白帝江山四面环。\n生晚免教妃子污，食馀应许黑衣攀。\n闽娘十八谁标榜，未必风流似此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用韵呈行可","author":"王十朋","text":"神仙乞与返魂丹，枯木能成处子颜。\n雅乐声中逢魏绛，重围解后见齐环。\n九龄赋妙那能继，三峡诗高未易攀。\n儿辈莫言酬倡晚，吾乡食实在秋间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元章至万州湖滩寄六言一绝云满目莫山平远一池云锦清酣忽有钟声林际直疑梦到江南某六月朔日登静晖楼观江涨望西南碧远数峰乃前日送别处也为之黯然楼前荔子初丹次韵寄元章","author":"王十朋","text":"遥碧峰尖如削，轻红荔脸初酣。\n水涨江天渺渺，故人一叶西南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"韶美至云安寄诗二首再用诗字韵以寄","author":"王十朋","text":"刘郎初自日边归，入峡殷勤寄我诗。\n大小承天思越绝，后先去国会坤维。\n分题应记跳珠夜，送别还思入竹时。\n千里遥遥共明月，此心无合亦无离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏日与同官小饮瑞白堂观跳珠分韵赋诗","author":"王十朋","text":"瑞白堂虚冰雪凝，散为珠玉洗炎蒸。\n诙谐未效东方朔，赋咏聊追杜少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏日怀鄱阳同僚","author":"王十朋","text":"去岁鄱阳四望亭，题分十二志同登。\n眼中忽见天边月，不谓天边是固陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀干翁簿以予去饶之日郡人断桥见留画图赋诗见寄因次其韵","author":"王十朋","text":"我慕郑子真，躬耕老岩谷。\n不慕苏季子，腰金诧宗族。\n失脚落尘网，回头念幽独。\n向来鸳鹭行，进退惭碌碌。\n把麾鄱君国，饮水清湾曲。\n缅怀九贤人，痛闵千里俗。\n奉扬乏仁风，黎庶因炎燠。\n畴能政有成，敢望诺无宿。\n厚颜叨禄廪，汗背拥旌纛。\n命下忽夔门，诸公孰推毂。\n水陆三千里，湖重岭仍复。\n至喜谒文忠，秭归怀李矗。\n鄱人怜老守，去类楚臣逐。\n出门桥已断，拥道頞争蹙。\n初无龚黄政，滥继秦侯躅。\n仇香旧同僚，别寄两竿牍。\n赋诗仍画图，开卷宛在目。\n清音满干越，馀韵到巴蜀。\n我有二顷田，荒芜雁山腹。\n愿画归去来，芒鞋事耕育。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠裴童子","author":"王十朋","text":"文公有序规童子，将圣犹言畏后生。\n好把五车书尽读，五车读了要须行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行可生日","author":"王十朋","text":"千载岐周鸑鹫闻，果生英杰嗣姬文。\n鲲鹏变化正六月，蟾兔光辉将十分。\n肯把威名争烈日，只将道眼视浮云。\n祝公寿共诗书久，一瓣心香已敬焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王嘉叟和读楚东诗复用前韵以寄","author":"王十朋","text":"照眼骊珠光陆离，莆田太守寄新诗。\n死生贵贱交情见，惟有吾宗不徇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉叟和黯字诗再用前韵以寄","author":"王十朋","text":"金谷富季伦，丑坐贵思黯。\n人间几泉石，豪夺在轩槛。\n燕贺厦初成，花飞春忽减。\n破甑任生尘，只有莱芜范。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和喻叔奇宿大木寺","author":"王十朋","text":"木记馀干大，风观楚国雄。\n吾诗留大木，君句压雄风。\n鄱水连天碧，潘花满县红。\n论文一尊酒，何日故人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用读楚东集韵寄元章","author":"王十朋","text":"谁遣吾侪合又离，江山深忆共题诗。\n君舟西上吾东矣，尊酒论文更几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉","author":"王十朋","text":"帘捲见山近，窗开竹香香。\n讼庭公事少，静坐纳微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋","author":"王十朋","text":"节物催吾老，天涯见立秋。\n凉微金尚伏，暑炽火初流。\n家远思尝稻，年衰怯戴楸。\n归耕期已近，河汉望牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"王十朋","text":"去年佳节吴头见，今久秋声峡内闻。\n桂魄渐看成半璧，银河犹自掩微云。\n晒书空有便便腹，乞巧初无怪怪文。\n为向天边牛女道，夫耕妇织莫辞勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀鄱阳","author":"王十朋","text":"一别鄱阳岁及期，夔门又见食瓜时。\n自惭政拙无遗爱，安得民心有去思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齿落用昌黎韵","author":"王十朋","text":"我来饶与夔，三载堕两齿。\n悬知年非永，早悟仕当已。\n要须未落时，猛效二疏止。\n胡为一再落，不已良可耻。\n慨然怀古人，未有长不死。\n因思年方少，辈行多胜己。\n颜红齿牢洁，往往同逝水。\n吾衰况如许，宁复老彭比。\n览镜视颜色，今昨不相似。\n行年五十五，万事可休矣。\n功名与富贵，磨灭何足纪。\n但愿早还乡，俯育三百指。\n婚嫁毕儿女，松楸依怙恃。\n弟兄饮真率，故旧忘汝尔。\n齿牙任摇脱，肉食吾不视。\n有身久为患，无齿实堪喜。\n始忧笑韩公，可惜陋子美。\n未必伤我心，兹言闻柳子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 宣化","author":"王十朋","text":"圣主有美化，丁宁戒守臣。\n毋令挂墙壁，宣以及吾民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 刑清","author":"王十朋","text":"昔日循良吏，狱空无怨声。\n刑清本无术，心地要先清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 介福","author":"王十朋","text":"兹地有神宇，人人来荐羞。\n神虽能介福，福亦自须求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 弭节","author":"王十朋","text":"川峡天下险，几人持节过。\n好来平处弭，莫起险中波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 皇华","author":"王十朋","text":"夔府皇华地，乘轺都几人。\n谁如二使者，实惠活斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 兴儒","author":"王十朋","text":"刀笠烧畬俗，舟航撇旋乡。\n五经谁教子，儒术破天荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 崇化","author":"王十朋","text":"西接卿云里，东连屈宋乡。\n好风吹峡水，尽作鲁芹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 ?迁","author":"王十朋","text":"相与勿言利，要令通有无。\n家家香一瓣，心慕舜之徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 兴龙","author":"王十朋","text":"世仰钦宗圣，人知太母贤。\n千秋龙已化，香火蜀江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 卧龙","author":"王十朋","text":"非长陈寿赞，无首杜陵诗。\n庙貌并公论，如今胜昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 庆丰","author":"王十朋","text":"谁道夔门陋，兹坊号庆丰。\n守臣忧国愿，端似杜陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十八坊诗 礼宾","author":"王十朋","text":"前山名胜己，夔子有嘉宾。\n馆辟自予始，愧非贤主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":18304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]