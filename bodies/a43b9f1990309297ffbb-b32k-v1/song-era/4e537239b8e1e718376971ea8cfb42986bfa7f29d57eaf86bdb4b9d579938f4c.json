[{"title":"西江月 二首 其二","author":"邓肃","text":"风荐荷香剪剪，月行竹影徐徐。\n微闻环佩过庭除。\n恐是阳台行雨。\n玉笋轻笼乐句，流莺夜转诗馀。\n酒酣风劲露凝珠。\n我欲骖鸾归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 二首 其一","author":"邓肃","text":"腊雪犹埋石巘，春风已入梅梢。\n冷香随马上琼瑶。\n不与时人同到。\n拍手恐惊星斗，高歌已在烟霄。\n醉呼玉女解金貂。\n笑问何如蓬岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 送李状元三首 其二","author":"邓肃","text":"龙头一语定闽山。\n黄色上眉间。\n诏书促归金阙，玉带侍天颜。\n拢象板，亸宫鬟。\n唱阳关。\n从容禁闼，若念林泉，应寄书还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 送李状元三首 其一","author":"邓肃","text":"乘鸾缥缈过三山。\n游戏下人间。\n金尊不辞频倒，春色上朱颜。\n依暖玉，掠风鬟。\n语关关。\n惟愁漏短，雨散云飞，骑月空还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 送李状元三首 其三","author":"邓肃","text":"从来云雨过巫山。\n只托梦魂间。\n何如醉逢倾国，春到一瓢颜。\n歌窈窕，舞双鬟。\n掩云关。\n重城五鼓，月下西楼，不忍轻还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其六","author":"邓肃","text":"独宿禅房清梦断，鸡声唤起晨钟。\n出门晓月耿寒空。\n小池凝翡翠，竹外跨飞虹。\n梅坞不知何处了，傍篱临水重重。\n啸歌都在冷香中。\n人间那有此，天上广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其七","author":"邓肃","text":"夜饮不知更漏永，馀酣困染朝阳。\n庭前莺燕乱丝簧。\n醉眠犹未起，花影满晴窗。\n帘外报言天色好，水沈已染罗裳。\n檀郎欲起趁春狂。\n佳人嗔不语，劈面噀丁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其五","author":"邓肃","text":"雨过荼蘼春欲放，轻寒约住馀芳。\n南园今日被朝阳。\n琼葩开万点，尘世满天香。\n百卉丛中红紫乱，玉肌自笑孤光。\n清风剪剪过纱窗。\n馀酲空一洗，不数寿阳妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其四","author":"邓肃","text":"剑水泠泠行碧玉，扁舟一叶吹风。\n玉人招手画桥东。\n浩歌随月去，春在小楼中。\n帘幕低垂围笃耨，雕觞笑捧春葱。\n谩将雨意作云浓。\n单于吹未彻，门外响玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其一","author":"邓肃","text":"带雨梨花看上马，问人底事匆匆。\n于飞有愿恨难从。\n大鹏抟九万，鹦鹉锁金笼。\n忽忽便为千里隔，危岑已接高穹。\n回头那忍问前踪。\n家留烟雨外，人在斗牛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其二","author":"邓肃","text":"百尺危楼初过雨，清风凛作轻寒。\n一声渔笛在云端。\n黄昏帘幕卷，新月半阑干。\n青翼不来音信断，云窗杳隔三山。\n何当携手便骖鸾。\n今宵同胜景，玉斝不留残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其九","author":"邓肃","text":"楼北楼南青不断，晴空总是春容。\n先来无处问郎踪。\n那堪风不定，雨尽一窗红。\n初恨水中徒捉月，而今水月俱空。\n谩将雨意伴云浓。\n临风千点泪，不到浙江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其八","author":"邓肃","text":"夜静黄云承宝袜，九疑人到羊家。\n蕊宫仙曲送流霞。\n东陵分玉井，远胜隔荷花。\n绰约旗亭沾一笑，众惊食枣如瓜。\n画桥烟柳忽翻鸦。\n醉鬟倾绿醑，参月共横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 登泗州岭九首 其三","author":"邓肃","text":"春雪一瓯扶醉玉，翩翩两腋生风。\n柳腰无力殢云踪。\n陈郎投辖意，分袂忍匆匆。\n白玉琢杯龙麝泛，瀼瀼天酒争浓。\n何妨一饮上青骢。\n晴空行夜月，缓辔水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其三","author":"邓肃","text":"云绕风前鬓，春开槛里妆。\n凤屏清昼蔼龙香。\n浅画娥眉新样、远山长。\n比翼曾同梦，双鱼隔异乡。\n玉楼依旧暗垂杨。\n楼下落花流水、自斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其四","author":"邓肃","text":"驿畔争挦草，车前自喂牛。\n凤城一别几经秋。\n身在天涯海角、忍回头。\n旅梦惊残月，劳生寄小舟。\n都人应也望宸游。\n早晚葱葱佳气、满皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其二","author":"邓肃","text":"皓月明腮雪，冷风乱鬓云。\n高楼帘幕夜生春。\n半醉倚人秋水、欲斜倾。\n晓雨双溪涨，归舟一叶轻。\n杳无青翼寄殷勤。\n目断烟波渔火、又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 四首 其一","author":"邓肃","text":"竹影窥灯暗，泉声语夜长。\n小窗无梦到高唐。\n独引三杯长啸、步修廊。\n月午衣衫冷，莲开风露香。\n阑干西角下银潢。\n我欲乘槎天上、泛寒光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 八首 其八","author":"邓肃","text":"海畔山如碧玉簪。\n天涯消息叹鱼沈。\n赖逢倾国洗愁心。\n莫为世情生旅况，且因乐事惜光阴。\n明朝红雨已春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其四","author":"邓肃","text":"阑外彤云已满空。\n帘旌不动石榴红。\n谁将秋色到楼中。\n玛瑙一泓浮翠玉，瓠犀终日凛天风。\n炎洲人到广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 八首 其二","author":"邓肃","text":"傍竹柴门俯碧流。\n见人无语眼横秋。\n鸣机轧轧弄纤柔。\n定有回文传窦子，何时银汉渡牵牛。\n归来风雨夜飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其五","author":"邓肃","text":"高会横山酒八仙。\n烟云不减九华妍。\n暖风琼树倚楼前。\n妙唱一声尘暗落，靓妆四座玉相连。\n骖鸾何日共翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其三","author":"邓肃","text":"宿雨潜回海宇春。\n晓风徐散日边云。\n熙熙人意一番新。\n破睡海棠能媚客，舞风垂柳似招人。\n春衫归去马蹄轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其七","author":"邓肃","text":"半醉依人落珥簪。\n天香不数海南沈。\n时倾秋水话春心。\n已觉吹箫归碧落，从今禊饮笑山阴。\n金杯休惜十分深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其一","author":"邓肃","text":"雨入空阶滴夜长。\n月行云外借孤光。\n独将心事步长廊。\n深锁重门飞不去，巫山何日梦襄王。\n一床衾枕冷凄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右九 浣溪沙 八首 其六","author":"邓肃","text":"二八佳人宴九仙。\n华堂清静斗春妍。\n琼枝相倚妙无前。\n良夜黄云来缥缈，东风碧酒意留连。\n花间蝶梦想翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"邓肃","text":"垂杨袅袅腰肢软。\n寒溪练练琉璃浅。\n短艇卧吹风。\n生涯一叶中。\n五湖须径去。\n何用若耶女。\n烟雨暝沙汀。\n花香唤酒醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其九 和李状元","author":"邓肃","text":"骑鲸好向云端去。\n踏花偶为狂朋住。\n笑语凛生风。\n眼高四海空。\n羊裘冲雨露。\n我是渔樵侣。\n已趁白鸥归。\n长江自在飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"邓肃","text":"廉纤细雨连天远。\n纱窗不隔斜风冷。\n花柳自生春。\n无聊空闭门。\n双双携手处。\n回首烟汀暮。\n嬉笑在高楼。\n知人牢落否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"邓肃","text":"飞红欲带春风去。\n柳丝却织春风住。\n去住任春风。\n只愁尊俎空。\n今朝鞭马去。\n又得高阳侣。\n半醉踏花归。\n霜蹄骄欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其八","author":"邓肃","text":"归心谩逐飞云去。\n欢情却为芳菲住。\n翠袖拥香风。\n宁辞玉斝空。\n主人承湛露。\n元是皋夔侣。\n早晚定遄归。\n商霖四海飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"邓肃","text":"帘旌不动薰馀热。\n高堂谁送能言雪。\n一笑下人间。\n天风袭坐寒。\n歌声云外去。\n句句苏仙语。\n曲罢一尊空。\n飘然欲驭风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"邓肃","text":"萋萋欲遍池塘草。\n轻寒却怕春光老。\n微雨湿昏黄。\n梨花啼晚妆。\n低垂帘四面。\n沈水环深院。\n太白困鸳鸯。\n天风吹梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"邓肃","text":"一心唯欲南园去。\n东山著意留难住。\n曾惯识追风。\n马群今已空。\n金盘盛玉露。\n情绝鸳鸯侣。\n破贼凯还归。\n冲天看一飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 十首 其一","author":"邓肃","text":"隔窗瑟瑟闻飞雪。\n洞房半醉回春色。\n银烛照更长。\n罗屏围夜香。\n玉山幽梦晓。\n明日天涯杳。\n倚户黯芙蓉。\n涓涓秋露浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其七","author":"邓肃","text":"腰肢欲趁杨花去。\n歌声能遏行云住。\n杯酒醉东风。\n羁愁一洗空。\n谪仙清饮露。\n意在飞琼侣。\n未醉即求归。\n新词句欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩","author":"邓肃","text":"翠竹谩连云，天风不到。\n帘幕重重自热恼。\n冷香忽至，爱惜当同芝草。\n井花浮碧玉，炎威扫。\n酒渴想东邻，忧心如捣。\n纳履生疑谩悔懊。\n未容沈李，相对尊前倾倒。\n报君惟短句，琼琚好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹧鸪","author":"邓肃","text":"北书一纸惨天容，花柳春风不敢秾。\n未学宣尼歌凤德，姑从阮籍哭途穷。\n此身已落千山外，旧事回思一梦中。\n何日中兴烦吉甫，洗开阴翳放晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 代送李状元","author":"邓肃","text":"执手长亭无一语。\n泪眼汪汪，滴下阳关句。\n牵马欲行还复住。\n春风吹断梨花雨。\n海角三千千叠路。\n归侍玉皇，那复回头顾。\n旌旆已因风月驻。\n何妨醉过清明去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钤冈早行","author":"邓南秀","text":"渔照灭不灭，水光空复空。\n疏钟五更月，残梦万松风。\n沆瀣虚无外，凄清顷刻中。\n火轮欲飞动，滟滟紫霄东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"邓春卿","text":"在巷愧无颜子志，过庐难称魏公心。\n望尘不敢希潘岳，云满南山雪满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南郑马上作","author":"陆游","text":"南郑春残信马行，通都气象尚峥嵘。\n迷空游絮凭陵去，曳线飞鸢跋扈鸣。\n落日断云唐阙废，淡烟芳草汉坛平。\n犹嫌未豁胸中气，目断南山天际横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长信宫词","author":"陆游","text":"忆年十七兮，初入未央。\n获侍步辇兮，恭承宠光。\n地寒祚薄兮，自贻不祥。\n谗言乘之兮，罪衅日彰。\n祸来嵯峨兮，势如坏墙。\n当伏重诛兮，鼎耳剑铓。\n长信虽远兮，匪弃路旁。\n岁给絮帛兮，月赐稻粱。\n君举玉食兮，犀箸谁尝。\n君御朝衣兮，谁进熏香。\n婕妤才人兮，俨其分行。\n千秋万岁兮，永奉君王。\n妾虽益衰兮，尚供蚕桑。\n愿置茧馆兮，组织玄黄。\n欲诉不得兮，仰呼苍苍。\n佩服忠贞兮，之死敢忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同何元立赏荷花追怀镜湖旧游","author":"陆游","text":"少狂欺酒气吐虹，一笑未了千觞空。\n凉堂下帘人似玉，月色泠泠透湘竹。\n三更画船穿藕花，花为四壁船为家。\n不须更踏花底藕，但嗅花香已无酒。\n花深不见画船行，天风空吹白纻声。\n双桨归来弄湖水，往往湖边人已起。\n即今憔悴不堪论，赖有何郎共此尊。\n红绿疏疏君勿叹，汉嘉去岁无荷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太液黄鹄歌","author":"陆游","text":"建章宫里春风寒，太液水生池面宽。\n中人驰奏黄鹄下，龙旗豹尾临池看。\n芹香藻暖鹄得意，左右从官呼万岁。\n须臾传诏宴公卿，欢声如雷动天地。\n时平宫省游乐多，黄鹄刷羽涵恩波。\n小臣珥笔龙墀下，愿继前朝天马歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新岭庵 其一","author":"邓柞","text":"千尺长松矗太清，倚松栋宇与云平。\n凭阑只恐西风起，吹上青冥九万程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒姜相祠坟","author":"邓柞","text":"布衣崛起秉洪钧，料事当年若有神。\n三尺孤坟封马鬣，一时直道犯龙鳞。\n从容未见回天力，流落空闻弃海滨。\n赖有高人秦处士，不妨筑室作居邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题白莲院","author":"邓柞","text":"古树纷纷千嶂雨，远寺鸣钟迷处所。\n一水东流浮落花，隔云应有秦人住。\n海风不断长松路，万籁寒生苍玉麈。\n此去江南山更深，桄榔叶暗猿啼苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午坐后亭","author":"邓剡","text":"隔帘迟日午风微，社燕惊寒未肯归。\n读了丹经成默坐，时时一片杏花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"砻山","author":"邓剡","text":"斜阳客如画，路转丛薄间。\n惊禽忽冲起，似石投前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋刘敏叔画杨诚斋先生探梅图","author":"邓剡","text":"夜起诗翁吟骨健，雪寒梅瘦月初生。\n谁教霜月闲描画，景物和人成五清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"报先寺","author":"邓剡","text":"我是人间未了僧，苍崖如梦昔经行。\n炉中香愿犹馀烬，石上精魂又一生。\n绝嶂猿啼惊犬吠，四山屏合护钟声。\n何当缘业人间满，孤拥秋衾坐五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜闻风声归思浩然","author":"邓剡","text":"西风响高树，乡梦去帆前。\n稚子衡门下，先茔乱叶边。\n老来多一出，归去恰经年。\n海燕巢何晚，秋期落尔先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽文魁母齐魏国夫人三首 其三","author":"邓剡","text":"两公兄弟我，我亦母夫人。\n侍疾番禺药，行封海道纶。\n孤穷空后死，俯仰欲谁亲。\n不尽西州泪，陶阡杳去尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽文魁母齐魏国夫人三首 其二","author":"邓剡","text":"色养从予季，全忠付伯兮。\n一心陵事汉，数语贾兴齐。\n海岭太多幸，崦嵫日遽西。\n犹怜兼国命，鸾诰湿金泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽文魁母齐魏国夫人三首 其一","author":"邓剡","text":"客谈剪髻德，邻识断机心。\n梭壁风云早，谖春雨露深。\n安舆神物相，归旐路足钦。\n滂母犹难比，生儿振古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李行甫","author":"邓剡","text":"倘使平生马少游，不将乡里博封侯。\n肯缘儿辈断屐齿，谁忆平生醉杖头。\n老去焉知尧壤力，乱来初识楚天忧。\n新坟似与欧阡近，许见衣冠夜月游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽唐如晦二首 其二","author":"邓剡","text":"法护何妨短，元龙故自豪。\n交情如水淡，义气与秋高。\n贫不沾三釜，年方见二毛。\n魂兮如可返，通饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽唐如晦二首 其一","author":"邓剡","text":"战艺时人北，受书吾道东。\n俊图开熟路，怒翼碍回风。\n勇往千人废，豪来一世空。\n深山埋玉气，得失付鸡虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"避乱至乌岩山赠承节赵公","author":"邓剡","text":"流水桃花又避秦，诛茅西崦结为邻。\n如公尚友浮丘伯，顾我早师梅子真。\n棋酒从容新里社，衣冠萧散古遗民。\n他年史传收芳迹，应许牵联作隐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书乌龙山","author":"邓剡","text":"岁云暮矣可奈何，云愁雨湿阴风多。\n林壑摧残海惊波，惨淡一色无山河。\n哀鸣嗷嗷旧枝柯，飞天不容忧虞罗。\n深山短景孤鸟过，会看明午风日和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文文山画像赞","author":"邓剡","text":"目煌煌兮疏星晓寒，气英英兮晴雷殷山。\n头碎柱而璧完，血化碧而心丹。\n呜呼，谁谓斯人不在世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽文文山","author":"邓剡","text":"忆公泪悬河，九地无处泻。\n想公骑赤龙，请命苍梧野。\n世人醉生死，翻笑独醒者。\n焉知千载英，精爽皎不夜。\n义士无废兴，时运有代谢。\n念昔丧乱初，公骑使君马。\n奋袂起勤王，忼慨泪盈把。\n须臾三万众，如自九天下。\n灯棋书檄交，笑语杂悲咤。\n捧土障洪河，一绳维大厦。\n至哉朝宗性，百折终不舍。\n身北冠自南，血碧心肯化。\n颜钩凛忠劲，杜诗蔚骚雅。\n晋阳骨肉冤，东市刀兵解。\n精诚揭天日，气魄动夷夏。\n丈夫如此何，一死尤足怕。\n田横老宾客，白发馀息假。\n有时梦岩电，意悟当飘洒。\n非无中丞传，杀青自谁写。\n魂归哀江南，千秋俎乡社。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓径","author":"邓剡","text":"晓风吹众绿，中含露气清。\n振袂起行散，逍遥觉身轻。\n爱彼薝卜香，淡然无世情。\n依稀庞家女，提篮映篱行。\n虽无膏沐意，皓质玉雪明。\n相看味禅悦，何必话无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":20166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]