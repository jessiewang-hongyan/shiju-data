[{"title":"送善兄还洞山兼呈方丈 其二","author":"释慧空","text":"一书远寄云中旧，五偈仍观雪子吟。\n且喜新丰消息在，南方满眼是丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢庞道惠茶","author":"释慧空","text":"冰雪心肠独老庞，一枝春信果无双。\n茅堂客散熏炉冷，有味无言日转窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"本老昔住此庵今出世再过山次日出诸偈颂乃和之","author":"释慧空","text":"舀溪长柄向来杓，瑞世优昙今日花。\n到我住庵无此瑞，只将溪水煮山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧上蜀绢毛段不受以偈谢之","author":"释慧空","text":"关西毛段蜀川绢，万里持来恐亦艰。\n谢汝殷勤复归汝，老僧布衲得遮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泽上人","author":"释慧空","text":"出入丛林成岁月，养成大树没根栽。\n东山老矣病且耄，为荫为凉待后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"容茶头为本无庵道头陀求偈","author":"释慧空","text":"道本无根却有根，根深枝叶遍乾坤。\n不知根本深多少，往见头陀试问看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与通上人","author":"释慧空","text":"迷时翻手迷为悟，悟处存心悟是迷。\n迷悟两忘归路尽，皖山深夜老猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧归四明","author":"释慧空","text":"跛鳖三年病，一书千里心。\n冤家容可避，到老也相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送昙上人游方","author":"释慧空","text":"昔人有言生处乐，东山何劝人行脚。\n殊方异域走苦辛，峻岭重关多险恶。\n东山往昔被赚来，故就于今拔本著。\n问渠端的何处生，一言解却通身缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其一","author":"释慧空","text":"野桃攲岸竹连云，石径萦纡到洞门。\n花落莫随流水去，恐人认此是桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其二","author":"释慧空","text":"石门有路建隆初，树老崖荒路欲无。\n我以多生岩下住，到门先记石于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其三","author":"释慧空","text":"山日辉辉云细细，石渠浅浅竹疏疏。\n珍禽引客飞还住，灵草忽香寻却无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其四","author":"释慧空","text":"百里寻山但宿春，欲留未得去还慵。\n东风莫使归帆饱，放我中流认九峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其五","author":"释慧空","text":"要识停厨第一方，为空石廪著黄粱。\n明年便入岩中坐，五偈先来作定场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其六","author":"释慧空","text":"住如止水动如云，去住无拘是我门。\n又举杖头千佛刹，来藏海上小桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其七","author":"释慧空","text":"惊蛇断路我来初，钵挂藤梢物物无。\n只向无中成活计，应门童子两于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其八","author":"释慧空","text":"衣雨调阶泉淅沥，青烟绕屋树扶疏。\n异时有问碧岩境，举似酬之莫道无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其九","author":"释慧空","text":"黄陈五合不劳舂，食罢无营一似慵。\n麋鹿往还溪上路，白云开合面前峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石室并和澹庵 其十","author":"释慧空","text":"来年四色更多方，忧水忧风忧夏粮。\n未必澹庵能快活，随身干木便逢场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戒庵主示诸老船子图偈赞因与之结缘 其一","author":"释慧空","text":"我笑华亭老，虚舟漾明月。\n撞著问津人，万劫系驴橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戒庵主示诸老船子图偈赞因与之结缘 其二","author":"释慧空","text":"开口赠两桡，老婆心更切。\n回首与翻身，亦未为剿绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戒庵主示诸老船子图偈赞因与之结缘 其三","author":"释慧空","text":"那堪钁头边，勿令有断绝。\n老戒不放伊，携之入闽粤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戒庵主示诸老船子图偈赞因与之结缘 其四","author":"释慧空","text":"到处出似人，几个知时节。\n空也心胆粗，戒戒勿漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离云居寓九仙寄无住","author":"释慧空","text":"痴云翳目不肯散，一雨一风行路迷。\n好山但自著狐兔，百城孤客其安之。\n朝来喜事遽如许，高空卷云风扫雨。\n径须呼我木上座，去探大雄山下虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和可上人","author":"释慧空","text":"梦里身投九泽乡，共惊日月去堂堂。\n江湖乱后人虽健，鸿雁不来书亦亡。\n访旧悲凉山起雾，得君谭笑目生光。\n犀牛扇破犀牛在，宜有清风可播扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答宜禅颂见谒","author":"释慧空","text":"宜禅谒老空，先自著便宜。\n分明金弹子，博得粪球儿。\n把得急抛下，堂堂空手归。\n前路逢人问，如何举似伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过疏山化士求谒","author":"释慧空","text":"南来雨宿仍风餐，蛮溪鬼洞三年还。\n丛林龙象老衲死，处处钟鼓空云山。\n独闻疏山有尊宿，不减当年矮师叔。\n欲求法雨洗蛮烟，正恐斋厨窘炊玉。\n道人忽从山中来，要乞上方香饭回。\n我方痴坐视屋壁，毛孔要须香七日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泐潭化士 其一","author":"释慧空","text":"大智承当三日聋，丈夫志气岂雷同。\n飞鸾渡水急于箭，喝下教伊不敢东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泐潭化士 其二","author":"释慧空","text":"不道二方遭毒手，更持一钵访空生。\n空生亦似把不住，放出瞎驴随队行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送泐潭化士 其三","author":"释慧空","text":"瞎驴无足尾过头，蹴踏乾坤势未休。\n大寂马驹追莫及，沩山水牯岂同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送油头 其一","author":"释慧空","text":"十分亲近见还迟，放去令渠自发机。\n他日归来如点著，普天无处不光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送油头 其二","author":"释慧空","text":"明星时时出现，众生日日成道。\n如何空王殿前，多是点时不到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食荨","author":"释慧空","text":"朔风吹雪排疏棂，敲冰汲水淘香粳。\n前村老樵馈法供，深壑病夫精勤诚。\n聃聃黄耳拥秀色，不约春气钟柴荆。\n隆隆沙铛沤起灭，点点釜口风雨争。\n严行禁谒戒俗客，约束从事烦庖丁。\n老饕寓意前具办，宿衲得路丰颐赪。\n中林雪月皎户牖，一饱对榻双眸明。\n五侯之家政自醉，我因欲卧听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送宜川","author":"释慧空","text":"一气万化之所种，眼处不透花重重。\n达人于中有大观，得处何止如鸡虫。\n倒尔鼻息作雷吼，佛祖望之犹缩手。\n抬头三世才晓昏，过眼千差孰妍丑。\n孤云为伴鸟助歌，沙鸥起舞鱼吹波。\n世间忧乐如我何，病夫聊示见其多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州达珠二化士 其一","author":"释慧空","text":"凡物不达何施为，惟其达者深所宜。\n如珠走槃自圆转，影迹不滞孤光随。\n良由水达舟船通，道路达则车书同。\n心境达则机用活，事理达则人法空。\n至于真达不疑处，鼎鼎舌头无剩语。\n杀人老贼今放憨，喝声雷送番禺雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州达珠二化士 其二","author":"释慧空","text":"二龙争珠不必求，顶上之珠何足留。\n摩尼之珠不必识，衣里之珠何足收。\n广南自有镇海珠，白月黑月分形模。\n无求无得珠不露，囧囧璧月生珊瑚。\n而今四海呈珠者，俊快不在仰山下。\n若谓纵横不犯波，争奈龙王按剑何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州达珠二化士 其三","author":"释慧空","text":"鳖鼻毒蛇横古路，切忌当头犯渠怒。\n犯时性命俱丧亡，不犯依前无避处。\n更有木蛇随后来，草中毒气触还乖。\n山头老汉遭一螫，至今负痛声如雷。\n痛声撼动大庾岭，直至海南人猛省。\n面前公案甚分明，莫负东山水上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送广州达珠二化士 其四","author":"释慧空","text":"木球转处横身去，按住球时须款步。\n定场戏罢急翻身，莫来拦我球门路。\n五州管内人再来，无球可放莫生猜。\n朝来打鼓普请看，未见当年人斫牌。\n广南人自有佛性，试携此语辨邪正。\n岩岩象骨摩苍穹，凛凛四面生清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山到温州仙岩览安楞严姚郎中故事安初读楞严经破句悟道后接姚郎中以梅潭水声悟道东山拈云大小郎中可惜埋向仙岩山中遂说偈仍赠仙岩监寺 其一","author":"释慧空","text":"一句浑沦忽击开，银山铁壁绝纤埃。\n至今千尺雷霆水，大与姚郎雪屈来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山到温州仙岩览安楞严姚郎中故事安初读楞严经破句悟道后接姚郎中以梅潭水声悟道东山拈云大小郎中可惜埋向仙岩山中遂说偈仍赠仙岩监寺 其二","author":"释慧空","text":"休于言下觅玄微，去却人间是与非。\n得意不从头上过，摩诃衍出祖师机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山到温州仙岩览安楞严姚郎中故事安初读楞严经破句悟道后接姚郎中以梅潭水声悟道东山拈云大小郎中可惜埋向仙岩山中遂说偈仍赠仙岩监寺 其三","author":"释慧空","text":"港口呼舟载月行，月中回首望岩扃。\n直凭悬水通消息，莫作中宵风雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"览天童示寂偈","author":"释慧空","text":"太白峰前青海尾，一目秋光弥万里。\n渔翁醉入芦花深，白鸟不飞天在水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答普贤梦石纪梦授观音偈","author":"释慧空","text":"补陀大土观世音，位超灌顶佛长子。\n不取正觉不涅槃，大慈悲等众生界。\n以如幻智入我梦，示身为石令我取。\n入手光严觉即无，无中度我观音在。\n俄而梦石一信通，授我大士栴檀像。\n空无定居懒惰久，礼敬供养心常疏。\n云何大士与梦石，不付他人惟付我。\n譬如良医视患众，各随其病授其药。\n空今病处正在懒，是故二彼用同时。\n慈力欲我如观音，一身普现一切处。\n辩才欲我如梦石，一法圆成一切义。\n懒无根蒂当处平，道有萌芽随念长。\n仰观仁意乃我愿，敢不再拜而钦承。\n惟愿菩萨大慈悲，受我少分之供养。\n戒品为香万行花，勇猛为幢坚固座。\n愿云定水功德山，慧灯智日清凉月。\n所陈妙乐皆法喜，所列珍羞尽禅悦。\n一一遍满虚空界，念念出我清净心。\n心无所住供亦然，是则名为无尽供。\n普愿我等诸佛子，见佛尽作如己想。\n而无彼己同异心，乃至梦中亦如是。\n虽恒观世间如梦，而能广作诸佛事。\n虽常观诸法如幻，而能力转大法轮。\n当知如梦如幻法，非眼境界惟智境。\n东山说偈梦石纪，见者悉成无上觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世尊真赞","author":"释慧空","text":"悉达才生便自尊，无人剪此葛藤根。\n指天指地虎投槛，说顿说圆羊触藩。\n室利逼之轻出手，韶阳打杀略知恩。\n东山门户大无外，留取提鞋及灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨真赞 其一","author":"释慧空","text":"香至国王之季子，般若多罗之克家。\n六宗既正西乾眼，五叶来开东震花。\n根源直截无文字，皮髓分张有等差。\n却怕老僧行正令，急携只履返流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达磨真赞 其二","author":"释慧空","text":"一出南天竺，平欺震旦人。\n九年皮髓尽，冷地忽翻身。\n不思折却当门齿，更向空棺遗只履。\n而今脚下无几何，不是当年留下底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二祖真赞","author":"释慧空","text":"缺齿老胡不敢说，一夜谩天三尺雪。\n神光初只立齐腰，大地到今寒彻骨。\n寒彻骨，金刚扶起泥人佛。\n樵歌渔唱乐升平，灵芝瑞草年年出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音真赞 其一","author":"释慧空","text":"此菩萨，从闻思修入三摩地，于一身现千手眼。\n明乎无所不照，无所不明。\n东山老汉，不免随泥作佛。\n南无观世音菩萨，南无大慈悲菩萨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音真赞 其二","author":"释慧空","text":"静处藏身，动中跳出。\n全起灭心，为自在力。\n耳闻不知，眼见不识。\n天下人称，圆通第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音真赞 其三","author":"释慧空","text":"此大开士，愿力弘深。\n初无自相，随众生心。\n或以土木，至于缕线。\n但有少缘，悉皆出现。\n终不自言，我自于谁。\n惟令见者，默尔知归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观音真赞 其四","author":"释慧空","text":"一香一华，惟称惟赞。\n潮落海门，风生彼岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庞居士真赞","author":"释慧空","text":"要识庞家个老翁，东山壁上之图是。\n手携长柄竹漉篱，犯寒晓踏南昌市。\n市心跶倒灵照扶，则川斫额丹霞呼。\n襄阳耆旧风标在，留与禅家作殃害。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真觉真赞 其一","author":"释慧空","text":"一千五百人善知识，大坐当轩取意描。\n眼上安眉犹不荐，面前球之更相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真觉真赞 其二","author":"释慧空","text":"德山师之师，岩头师之友。\n有是师，有是友，而负一千五百人善知识之地，而于法道大成也宜矣。\n至若开雪山，则忠懿闽王为之檀越。\n办众事，则兴圣国师为之服勤。\n定其宗，则有云门偃。\n正其派，则有玄沙备。\n自馀棱展劲孚，鹅湖镜清流，皆分光四海，若揭日月。\n呜呼盛哉，瞻之仰之。\n杀人老贼面前，球子井赃捉获。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂真赞","author":"释慧空","text":"此大和尚，丛林先觉。\n衲僧性命，出其掌握。\n问北指南，愈病勿药。\n惊起三圣瞎驴，趯倒赵州略彴，恶，四海缁流争名邈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"此庵真赞","author":"释慧空","text":"此据胡床捉尘拂老和尚，恶手段不可近傍。\n曾将千五百斤铁枷，顿在山僧项上。\n而今笔下见之，亦自心惊胆丧。\n得人一尺，还人一丈。\n愿以此百亿佛刹微尘数不可说劫，为之寿量。\n于其中间荷负杨歧重担，倒跨三脚驴儿。\n奔走四海之龙象。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"球堂真赞","author":"释慧空","text":"四众之师，万星之月。\n为照为明，如行如说。\n承其光则器器皆圆，得其心则尘尘无物。\n及其瞎却衲僧眼，倒握麈尾拂。\n则丛林皆谓有老黄龙之体裁，备头陀之风骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦石真赞","author":"释慧空","text":"王母梦中，石佛象骨。\n峰前鳖鼻，僧蓝棋布。\n闽山神秀，尽钟于是。\n提石蛇，与夺出其掌握。\n居德云，大千乃其游戏。\n使著书辅教，则联珠贯璧，不作道原作伫灵。\n使俨临万众，则雷轰电激，不为德山为临济。\n天其有意于斯文，则无使袖手云山，友麋鹿而混吾曹于此世。\n同时出家，先我闻道。\n既为我友，又为我兄。\n浮云会散，初无定踪。\n晚喜其归，雪山之东。\n长松片石，相对两翁。\n遽乘六牙香象，雨后峨嵋扫空。\n冰片满街留不住，使人不能无所慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谷堂真赞 其一","author":"释慧空","text":"冰出水，玉出石，破獍出窠母遭食。\n宗师得法，佛祖避席。\n正令当行，十方辟易。\n耕者驱其牛，饥者夺其食。\n龙骧虎骤，铁眼铜睛。\n到绳床角头，则不寒而慄。\n有此体裁，具此作略，是真临济儿孙，黄龙头角。\n东山与么赞之，何曾一字赞著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谷堂真赞 其二","author":"释慧空","text":"予常对人言，谷堂老子，人类精奇，缁流标格。\n若挽置江湖之上，予则谓之沩山道人慕哲。\n若任其乘桴之能，谓之飞山宗一。\n至于江湖不涉，乘桴不居，予将望洋向若而失，又欲引谁为等匹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"真歇真赞","author":"释慧空","text":"碎丹霞不传之印，起洞山已坠之宗。\n雷闻一世，奔走四方。\n此大唐国内，家至而户知，不假东山发扬。\n独自涅槃后大人之相，又属其贤子孙之承当。\n东山只得炷香再拜，庆师有子，而洞水流长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楮庵真赞","author":"释慧空","text":"横楖栗据此座者，长芦夫跳灶之子，天衣怀的骨之孙。\n抽一顾而瞎其正眼，用十无而诳彼后昆。\n说法则雷轰电激乎仰山之上，入灭则霜清月落乎连水之湄。\n是谓楮庵和尚，而般阳老明提耳之师也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"净信道人真赞","author":"释慧空","text":"入净信心宗，则无俗不真。\n得幻智法门，而有佛皆子。\n视人间为忉利天宫，坐平芜乃台山路上。\n东山晚识此婆，盖因其子止庵道人，幽岩和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"如一悟空二居士真赞","author":"释慧空","text":"如一一亦不如，悟空空须得悟。\n谁家一对鸳鸯，万象之中独露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":15468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]