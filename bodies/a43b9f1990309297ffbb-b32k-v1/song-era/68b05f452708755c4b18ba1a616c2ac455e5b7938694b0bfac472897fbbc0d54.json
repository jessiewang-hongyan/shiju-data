[{"title":"自赞 其一","author":"白玉蟾","text":"日月藏瓢里，溪山挂杖头。\n有些难说处，夜夜是中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中晚眺 其二","author":"白玉蟾","text":"不成无语立江滨，事事堪吟句句新。\n白鹭前身真钓叟，青山今日是诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中晚眺 其一","author":"白玉蟾","text":"小立船仓揭起篷，晚来帆幅饱西风。\n望他鸿雁一双去，过了峰峦千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次吉溪","author":"白玉蟾","text":"十年三过吉溪滩，想被溪梅笑往还。\n尘暗壁间题迹旧，满斟杯酒慰寒山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"白玉蟾","text":"山锁晓烟迷紫翠，花凝宿雨间青红。\n快帆幸自泛秋绿，乞与一篙东去风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"白玉蟾","text":"梢子欢呼御晓风，诗人亦自起推蓬。\n数来数去山都乱，忘却前峰与后峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟程苦迟","author":"白玉蟾","text":"水马轻便胜陆行，冲风溯水反多程。\n溪流诘曲成千摺，云色阴晴没十成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其九","author":"白玉蟾","text":"宝马香车政踏青，岂知已自过清明。\n燕雏告诉花都落，鸠妇丁宁雨速晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其八","author":"白玉蟾","text":"绿杨无力暖相依，不管黄莺诉落晖。\n水被鱼吹成雨点，花为蝶扰逐风飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其七","author":"白玉蟾","text":"政是风娇日騃天，蔷薇粉褪海棠蔫。\n贵人那得看花福，多在绿窗犹醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其六","author":"白玉蟾","text":"终日寻春入醉乡，不知何处见春光。\n风条舞绿水杨柳，雨点飞红山海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其五","author":"白玉蟾","text":"几日春功似有加，晓来万象尽排衙。\n群莺主管园林事，一雨巡行桃李花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其四","author":"白玉蟾","text":"借彼笙箫鼓笛中，诗人随分得春风。\n提壶处处差监酒，布谷朝朝讲劝农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其三","author":"白玉蟾","text":"园园是日是花开，我又何朝不醉来。\n井有人焉蛙两部，日之夕矣蝶三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行春辞 其一","author":"白玉蟾","text":"一斗百篇诚有之，无人知我只春知。\n吟逢蝴蝶即庄子，醉见海棠真贵妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其二","author":"白玉蟾","text":"晓鹭守溪图口腹，暮蛛借屋计家生。\n不羁野马空中骋，无喘蜗牛壁上耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观物 其一","author":"白玉蟾","text":"蜂占蔷薇封食邑，蚁侵蜾蠃借军须。\n雨天风急鸠呼妇，水国烟寒雁唤奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许天游见过","author":"白玉蟾","text":"蝉外西风风外叶，雁边落日日边云。\n诗仙世界无疆埸，一片青山共子分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许旌阳故宅","author":"白玉蟾","text":"诗多唐代刻，柏尚晋时青。\n想得真君剑，犹馀蛟血腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过石梯","author":"白玉蟾","text":"小伞轻包手自携，少需脚力过危梯。\n入门失问翁高姓，看尽壁间前后题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问子规","author":"白玉蟾","text":"绿柳阴中问子规，劝人归是劝春归。\n人须回首春须暮，何不成都西去飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问花","author":"白玉蟾","text":"蓦地诗心到海棠，问花开未晓来忙。\n村童熟睡不知唤，惟有流莺语似簧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问春","author":"白玉蟾","text":"不教蜂蝶略来些，岂是春神病酒耶。\n燕语莺啼今几日，风魔雨难许多花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华阳吟 其六","author":"白玉蟾","text":"武夷结草二年馀，花笑莺啼春一壶。\n流水下山人出洞，岩前空有炼丹炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何仙姑赞","author":"白玉蟾","text":"阆苑无踪迹，唐朝有姓名。\n不知红玉洞，千古夜猿声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事君子堂 其五","author":"白玉蟾","text":"自点雌黄改自诗，苧衣不著著蕉衣。\n前山何故枯松上，半月巢空鹤不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事君子堂 其四","author":"白玉蟾","text":"枝头尚有烂黄梅，次第荷花白者开。\n庭雀被人惊得惯，作群飞去又飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事君子堂 其三","author":"白玉蟾","text":"招风竹下凉生扇，弄水荷边香满衫。\n自拾落花揩面汗，唤将红白酒相搀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事君子堂 其二","author":"白玉蟾","text":"南薰唤起莲花悟，西照催归燕子忙。\n自洗霜刀来切藕，传君嚼玉咽冰方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事君子堂 其一","author":"白玉蟾","text":"墙头榴火正烧空，风削苍云作数峰。\n避叶荷花如避暑，病香愁态若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听琴 其二","author":"白玉蟾","text":"心造虚无外，弦鸣指甲间。\n夜来宫调罢，明月满空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听琴 其一","author":"白玉蟾","text":"十指生秋水，数声弹夕阳。\n不知君此曲，曾断几人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听琴 其三","author":"白玉蟾","text":"声出五音表，弹超十指中。\n鸟啼花落处，曲罢对春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张楼","author":"白玉蟾","text":"前度相逢一似曾，瘦宽金镯可怜生。\n绿窗朱户如无恙，酌我百杯秋月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折梅 其二","author":"白玉蟾","text":"一朵寒香已自奇，高丫两朵更清姿。\n树前树后花都绝，折了南枝折北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"折梅 其一","author":"白玉蟾","text":"夜半披衣凭玉栏，天风吹露洒琅玕。\n前台后台月如水，云去云来梅影寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其八","author":"白玉蟾","text":"星似萤千点，云如鹤一双。\n孤吟寒不寐，落叶打空窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其七","author":"白玉蟾","text":"香篆孤烟袅，灯龛寸火微。\n梦和明月冷，心与白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其六","author":"白玉蟾","text":"犬吠月如昼，马鸣人渡桥。\n更无诗与酒，虚度可怜宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其五","author":"白玉蟾","text":"竹手擎云重，松肩荷月高。\n烟收天地阔，醉目数秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其四","author":"白玉蟾","text":"嫩竹容归鹊，寒松捧落晖。\n危红和露落，空翠扑衣飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其三","author":"白玉蟾","text":"楼影秋江白，苔碑卧夕阳。\n水昏沙暮起，一一雁南翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其二","author":"白玉蟾","text":"酒弄三竿日，诗成一枕风。\n寒声落鸿雁，秋意著梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"护国寺秋吟 其一","author":"白玉蟾","text":"雁过天成画，鱼惊水作纹。\n檐牙宵吐雨，殿脊晓驮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李伯阳赞 其三","author":"白玉蟾","text":"蓬莱三万里，道德五千言。\n一自青牛去，函关烟雨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"课园夫 其二","author":"白玉蟾","text":"问我何厨传，珍鲜满故园。\n笋方青剥指，茄欲紫垂拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步自玉乳峰归 其一","author":"白玉蟾","text":"薄暮一凝伫，归鸿千有馀。\n倚松吟半饷，月影泻庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉","author":"白玉蟾","text":"临水玩芙蓉，一花还两影。\n上倚夕阳斜，下浸秋波冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谷帘下 其二","author":"白玉蟾","text":"步入青红紫翠间，仙翁朝斗有遗坛。\n竹梢露重昼犹湿，松里云深夏亦寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谷帘下 其一","author":"白玉蟾","text":"紫岩素瀑展长霓，草木幽深雾雨凄。\n竹里一蝉闻竹外，溪东双鹭过溪西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远景","author":"白玉蟾","text":"岸树冥茫外，人家点画中。\n断烟分紫翠，