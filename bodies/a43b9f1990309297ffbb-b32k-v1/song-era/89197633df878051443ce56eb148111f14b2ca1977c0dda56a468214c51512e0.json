[{"title":"潇湘八景诗 其一 潇湘夜雨","author":"张经","text":"终夜雨潇潇，闷杀孤舟客。\n滴滴打蓬声，错讶灵妃瑟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乡饮酒唱和诗","author":"张肃","text":"位分南北与东西，旷典才修俗顿移。\n乐合鸾皇下庭宇，觯扬虎蜼伏樽彝。\n头颅如许堪殊席，筋力无多奈缛仪。\n敢昧邦君明德意，后知方遣负先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"张肃","text":"去谒吾君遇太平，太平明主重南能。\n不关名利真开士，却返林泉伴野僧。\n御赐白金为长物，身归青嶂策枯藤。\n只应待到天台日，斋炷檀烟定有灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八陈图","author":"张表臣","text":"八陈功成妙用藏，木牛流马法俱亡。\n后来识得常山势，纵有桓温恐未详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤胡少汲兵败","author":"张表臣","text":"还将他年重，作师此日难。\n伤心闵东道，白首戴南冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨大年馆直诗","author":"张表臣","text":"翰林历历侵华盖，禁掖明明侍紫微。\n自昔词臣最清切，帝宸高拱借光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈叔易就晁以道求长松","author":"张表臣","text":"暂隐嵩高六六峰，未乘云气御飞龙。\n自餐白石求黄石，更采长松寄赤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张表臣","text":"射飞何必捐金弹，抵鹊虚烦用夜光。\n切玉昆吾宁刺豕，断蛟干越岂刲羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵凤凰台","author":"张表臣","text":"骑鲸仙伯已凌凌，奈尔三山二水何。\n地老天荒成脉脉，凤凰台上独来过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青田壶碧筒酒","author":"张表臣","text":"酿忆青田核，觞宜碧藕筒。\n直须千日醉，莫放一杯空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"婺州山中","author":"张表臣","text":"作畎捉檐卸，呼田欸乃侬。\n山塘莫车水，梅雨正分龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题睢阳双庙二首 其二","author":"张表臣","text":"渔阳哭骑满关东，百战孤城挫贼锋。\n唐室兴亡系公等，九原可作更谁从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题睢阳双庙二首 其一","author":"张表臣","text":"张许昭鸿烈，南雷贾共灵。\n无瑕双白璧，有曜五华星。\n怀哲音容在，伤时涕泪零。\n向来丹凤阙，犹带犬羊腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观高邮寺壁曹仁熙画水","author":"张表臣","text":"曹生画手信有神，毫端风雨生奫沄。\n波涛不合来翻屋，鲛鳄何须欲噬人。\n汤汤此水势方割，阳侯郁怒冯夷搏。\n鼍掷鲸呿海岳惊，雾塞云昏光景薄。\n开元将军爱骅骝，拳奇灭没隘九州。\n时危此物岂易得，写此尚可销人忧。\n末有乃孙画乃水，逋客见之心欲死。\n雷奔电击走中原，鱼怖龙愁宁忍视。\n先生道眼高昆崙，聊将妙语破迷津。\n中流险绝待舟楫，四海浩荡须经纶。\n我生甘作淮海客，身脱垂涎头雪白。\n惊心未定畏漰湍，欲觅平波泛家宅。\n此身端的老江湖，雨笠烟蓑是所图。\n他年但饱扬州米，今日宁论甓社珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琵琶","author":"张表臣","text":"白鸽潜来入紫槽，朱鸾飞去唳青霄。\n江边塞上情何限，瀛府霓裳曲再调。\n漫道灵妃鼓瑶瑟，虚传仙子弄云璈。\n小怜破得春风恨，何似今宵月正高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 过吴江","author":"张表臣","text":"垂虹亭下扁舟住。\n松江烟雨长桥暮。\n白纻听吴歌。\n佳人泪脸波。\n劝倾金凿落。\n莫作思家恶。\n绿鸭与鲈鱼。\n如何可寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪","author":"张表臣","text":"楼横北固，尽日厌厌雨。\n欸乃数声歌，但渺漠、江山烟树。\n寂寥风物，三五过元宵，寻柳眼，觅花英，春色知何处。\n落梅呜咽，吹彻江城暮。\n脉脉数飞鸿，杳归期、东风凝伫。\n长安不见，烽起夕阳间，魂欲断、酒初醒，独下危梯去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张表臣","text":"云移鸟灭没，风霁蝶飞翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张表臣","text":"已乘云气翳凤麟，六百馀岁无斯民。\n想像璧月何当亲，虎头摩诘俱泯沦。\n谁其画者陆仲仁，远绍乃祖高无伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"张表臣","text":"床弩天诛韩闼览，剑锋神助宋将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张表臣","text":"采玉应求破山剑，探珠仍遣水精奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张表臣","text":"蛇蛟已尽定飞去，雷电欻惊重下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"张表臣","text":"碧藕连根丝不断，红蕖著子薏何多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 曾公洞","author":"张釜","text":"欲访真仙小有天，路穷崖绝俯灵泉。\n相君聊试济川手，翳凤骖鸾尽有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钓台","author":"张保雍","text":"汉包六合网英豪，一个冥鸿惜羽毛。\n世祖功臣三十二，云台何似钓台高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丈人观","author":"张俞","text":"精气腾井络，下临群岳尊。\n元真戴天坐，执印朝轩辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云楼","author":"张俞","text":"城上新开百尺楼，白云人伴白云留。\n山川半倚三吴胜，江汉常吞七泽流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邛州青霞嶂","author":"张俞","text":"雾山环合自云川，户有清溪种玉田。\n万本桃花不知处，几人曾得问秦年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁穷雨夜独卧山斋","author":"张俞","text":"岁晏云深谁与游，嵓房终夜雨如秋。\n不知海上三山梦，何似人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱槿花二首 其二","author":"张俞","text":"朝菌一生迷晦朔，灵蓂千岁换春秋。\n如何槿艳无终日，独倚栏干为尔羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱槿花二首 其一","author":"张俞","text":"风雨无人弄晚芳，野桥千树斗红房。\n朝荣暮落成何事，可笑纷华不久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜宿黄沙馆书怀","author":"张俞","text":"穷年抚剑独无眠，世路危疑倦往还。\n夜半无人残月白，狐鸣枭啸满空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚕妇","author":"张俞","text":"昨日到城廓，归来泪满巾。\n遍身罗绮者，不是养蚕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郴州道","author":"张俞","text":"南土殊风气，冬林叶尽丹。\n越天无雁度，楚泽有龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"博望侯墓","author":"张俞","text":"九译使车通，君王悦战锋。\n争残四夷国，只在一枝筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩","author":"张俞","text":"玉文山后灵岩寺，四百年来选佛场。\n满地白云关不住，石泉流出落花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游骊山 其二","author":"张俞","text":"玉帝楼前锁碧霞，终年培养牡丹芽。\n不防野鹿踰垣入，衔出宫中第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游骊山 其一","author":"张俞","text":"金玉楼台插碧空，笙歌递响入天风。\n当时国色并春色，尽在君王顾盼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩信坛","author":"张俞","text":"汉用亡臣策，登坛授钺时。\n须知数仞土，曾立太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉州","author":"张俞","text":"城分二江急，树入九峰开。\n地隔犍牂绕，人从楚蜀来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微寺","author":"张俞","text":"翠微寺本翠微宫，楼阁亭台数十重。\n天子不来僧又死，樵夫时倒一株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楚中作","author":"张俞","text":"渺渺洞庭野，萧萧黄鹤楼。\n水通云梦浦，人渡沔阳舟。\n广泽侵吴壤，孤城接郢丘。\n山分三楚断，溪入九江流。\n寂寞休兵月，纷纭战国秋。\n吴生来赤壁，魏武定荆州。\n六代凭形势，群雄死寇雠。\n凄凉帝子宅，浩荡祢衡洲。\n万里浮云暮，千年故国愁。\n武昌宫不见，麋鹿自群游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广州","author":"张俞","text":"越地春生草，春城瞰渺茫。\n朔风惊瘴海，雾雨破南荒。\n巨舶通蕃国，孤云远帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"车湖","author":"张俞","text":"忆昔车公居此地，遗墟缭绕临清渊。\n惜哉断石文尚在，野老不识投波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岑公岩","author":"张俞","text":"池光复涵澈，万象皆镜入。\n亭观出浮云，彤彤映邦域。\n左右浮屠宫，岿然争嶪岌。\n孰云南浦陋，今始逢藻饰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪孙之翰太傅登成都楼","author":"张俞","text":"龊龊古之人，伤心广陵废。\n遂弦芜城歌，半夜一挥涕。\n蕙纨随草衰，藻黼归尘翳。\n魂石敛邱封，歌堂从水逝。\n薰光杳沈灭，吞恨徒千岁。\n我怀吴蜀国，祸乱若符契。\n目览台城墟，心感君王世。\n干戈日驰逐，狼虎争吞噬。\n山河实天堑，城阙巍地肺。\n霸力不久炎，倏忽如焚薙。\n空馀万雉城，岌倚寒云际。\n麋鹿玩苹阴，狐狸栖棘卫。\n江汉含呜咽，岷峨抱迢递。\n荒村烟花遥，落日寒风厉。\n因知市朝人，自古悲兴替。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒白帝庙","author":"张俞","text":"孤山捍江口，上有白帝祠。\n横视天下险，万流皆俯窥。\n古殿锁神物，悲风出阴帷。\n天昏瓦栋折，狐鼠亦生威。\n优巫日鼓舞，鬼怪生奔驰。\n雷霆卷蛟窟，雹火烧松枝。\n入户精魄动，有如阴兵随。\n吁哉汉盗乱，海内遂崩离。\n赤龙始潜跃，逐鹿过秦时。\n公孙奋神剑，定蜀图安危。\n陇坻开北户，荆门启东陲。\n长驱百万众，日斗天下师。\n群豪插羽翼，与汉争雄雌。\n两帝不并立，兴亡良可悲。\n天运虽有在，圣贤岂无为。\n昭皇揽英杰，袭轨奄垂基。\n风云共浩荡，千古馀寒碑。\n威神竟不没，万里震南夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题隐真谷","author":"张俞","text":"绵绵褒斜路，窈窈郑真谷。\n斯人已千载，高谊犹在目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题温汤驿 其三","author":"张俞","text":"同欢一宵间，平生万事足。\n想得唐明皇，畅哉畅哉福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题温汤驿 其二","author":"张俞","text":"昨夜过温汤，梦与杨妃浴。\n敢将豫让炭，却对卞和玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题温汤驿 其一","author":"张俞","text":"梦魂飞入瑶台路，九霞宫里曾相遇。\n壶天好景自愁人，春水泛花何处去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"张俞","text":"真人自有龙蹻术，可笑长生事战争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张俞","text":"可胜亡国恨，犹有爱山心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张俞","text":"高光如有嗣，吴魏岂胜诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张俞","text":"千年黄鹤无消息，满自空寒万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"张俞","text":"与谁天末分青髻，长向人间画翠峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"张俞","text":"昔乃荆棘荒，今为蕙兰袭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"张俞","text":"康乐有情遥寄想，青溪句在十三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"张俞","text":"欲作外臣谁是友，白云孤鹤在岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张俞","text":"万顷碧波看不尽，一拳孤岫望中明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游黄山留题","author":"张冠卿","text":"路尽清溪逼画图，乱云深处插天都。\n雾开虎豹文姿出，松隐龙蛇怪状孤。\n吐焰香砂收火齐，凌虚精舍碍灵乌。\n我来为访容成侣，试问丹丘果有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"张勉窗","text":"小春破白惟梅耳，检点南枝花尚迟。\n自是天工薄寒素，东风先到海棠枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞炭","author":"张勉窗","text":"百条进自西凉国，易火难灰作瑞看。\n想得当时宫殿暖，不知门外有风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿护法寺","author":"张勋","text":"乱草织斜阳，天风结晓霜。\n摇鞭追马足，投宿问僧房。\n望眼挥清泪，愁云罩故疆。\n客帆更无数，不见祖生航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云间阁留题壁间","author":"张垓","text":"清江一曲抱村流，古柏千茎绕径幽。\n天畔峰峦俱秀峙，壁间珠玉烂凝眸。\n遥观细菊重岩下，共作携壶九日游。\n回首家山白云外，遽兴归思漫悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水月洞绝句","author":"张埏","text":"明月出天山，月明秋水寒。\n观心同水月，镊白坐相看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知宫高士菊岩","author":"张复","text":"来游九锁山，忽遇菊岩仙。\n老翠偃千亩，黄金铺万钱。\n花经令尹爱，词入北司编。\n最重水中石，平舟曾为镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"张复","text":"学道探玄务谷神，薜衣疏野见明君。\n暂来北阙利名地，归去旧山鸾鹤群。\n洞壑深藏尘外士，冠裳不系岭头云。\n赤城千仞幽居处，夜籁秋猿枕上闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"张奎","text":"公馀连骑赏芳妍，柳重花明祓禊天。\n丝竹绕堤浮舴艋，绮罗照水戏鞦韆。\n回头景物才三月，屈指光阴又一年。\n台旆行春暂均逸，凤凰池暖正思贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游栖霞宫","author":"张奕","text":"尊师乃高道，有意出尘寰。\n佩剑文垂斗，横琴意在山。\n灵龟调浩气，醇酒发朱颜。\n最得时贤许，诗牌满栋间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄天荡","author":"张宪","text":"昆明劫烧成灰火，临平葑湖拨不开。\n黄泥万顷下无底，海眼一丝通往来。\n南徐江边海鳅走，江神顿足黄龙吼。\n便翻银汉濯泥沙，要使妖蛇先授首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王宗哲六柳堂","author":"张宪武","text":"六柳先生以道鸣，归家高伴子真耕。\n方瞳绿鬓君知否，一片灵台画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张宪武","text":"万叠崇岗揖卧龙，一峰圆顶翠连空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉华山","author":"张峋","text":"玉华山谁穷远近，百里回旋势方尽。\n削成苍玉倚青天，气象轩轩独奇俊。\n黄河哮顑摧昆崙，一峰飘落如龙蹲。\n白云低垂半岩腹，茫茫日轮平地奔。\n惊湍瀑流飞辟历，松根巉岩裂石壁。\n洞门昼闭不知深，仙人琼浆满杯碧。\n饥鼯啼烟猿啸风，子规声哀愁满容。\n山鸟嘤咛绕乔木，唯有黄鹤鸣噰噰。\n翠华迢迢来避暑，飘然陵云欲轻举。\n当时此地最清凉，九成翠微不足数。\n玉鞘声断宫殿闲，大龙飞去髯难攀。\n川峦如旧人事变，但见明月留空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]