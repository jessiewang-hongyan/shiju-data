[{"title":"舟过七里店迓客","author":"袁说友","text":"涨水一篙足，环山七里长。\n维舟横略彴，惊鹭入菰蒋。\n话旧人俱老，相嗟鬓各霜。\n年来慵不出，犹未免迎将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟泊竹筱港夜坐诵后山诗","author":"袁说友","text":"沙岸人归后，船窗月上时。\n霜风竹筱港，灯火后山诗。\n岁晚羁怀恶，江空熟路迟。\n邻舟一樽酒，不使老夫知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观渔舟得巨鱼","author":"袁说友","text":"猛作修鳞想，观渔忆故濠。\n横舟排雪浪，敏手夺银刀。\n过熟偏宜酒，馀鲜更带糟。\n忍穷须忍口，老矣为渠饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观潮","author":"袁说友","text":"倏见江头万鼓催，更闻脚底一声雷。\n怒涛直欲浮天去，急浪犹能带雨来。\n岂但皇都誇伟观，要令区宇绝纤埃。\n灵胥勇志嗟何在，共吊江山付此杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访赵王北园荷池","author":"袁说友","text":"小熟乌程酿，重游习氏园。\n乱蝉依柳噪，疏雨趁荷喧。\n短棹双溪静，轻鸥一羽翻。\n青山满归路，新月送黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过广安军王恭父大著墓","author":"袁说友","text":"与君执友共为郎，尚忆松江送客艎。\n在昔清班方衮衮，至今衰草恨茫茫。\n百年名世嗟天丧，一日修文在帝傍。\n云槚风杉空挂剑，不胜老泪洒危冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过扬州平山堂邂逅许深父主漕","author":"袁说友","text":"平生踪迹半江湖，岁晚淮乡识旧都。\n小却车尘行复止，要看山色有还无。\n关山回首嗟何限，风景于人岂不殊。\n犹得故人谈世事，金城方略政堪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过池阳旧治和吕子西韵","author":"袁说友","text":"浮沈宦海几春秋，岁晚重来旧典州。\n昔日青山虽在眼，故侯白发已盈头。\n吟边感慨关情久，忙里工夫著意偷。\n闻说峡江春涨晚，捲帆聊为此邦留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过怀安军云顶寺","author":"袁说友","text":"拂云绝顶俯金渊，直上重山最上颠。\n一佛向来临大地，万松今独近高天。\n枯楠夭矫浑生意，断石盘陀几合年。\n大士重来闻嘱付，毫光端欲扫烽烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过邻水县横碧川","author":"袁说友","text":"一水横空翠，群山送远阴。\n临流新柳媚，隔岸小楼深。\n五斗渊明米，期年子贱琴。\n可人山水县，莫倦读书音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过忠州酆都观","author":"袁说友","text":"古柏修篁万木颠，盘山百折叩真仙。\n便疑脚踏如来地，已觉身游洞府天。\n空翠遐观浮海日，偃云时汲濯缨泉。\n我来只恨无仙骨，未必丹炉不再燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过故郡渡","author":"袁说友","text":"山路一千三百里，中间四渡今江流。\n天涯作客壮年事，老马长途几日休。\n谁知江深念归客，日向峨岷无尽头。\n举首白云天共远，四方上下与同愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过富池庙","author":"袁说友","text":"祀典名称重，神灵远近闻。\n陈牲共豕一，裹饭集乌群。\n水旱忧民切，江山护国勤。\n丹诚祷祠下，不敢事虚文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过楚州用霍希文韵","author":"袁说友","text":"夜入山阳鹢首东，单车出郭更匆匆。\n欲知势扼三江近，政以城高百尺雄。\n此恨终天身未老，何人抵掌气凌空。\n连云细草秋风下，把酒长吁问化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过霞山小饮","author":"袁说友","text":"霞山书院醉焚香，细雨轻阴见海棠。\n春动旧怀杯酒后，晚吹新恨笛声长。\n或红或白花饶笑，为整为斜草更芳。\n寄语风光易尘土，相看流转且相羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闭户","author":"袁说友","text":"户屦无人满，庭罗尽日张。\n閒窗书白羽，清梦熟黄粱。\n瓦瓮苕溪渌，铜炉柏子香。\n出门本无碍，龟穴惯深藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余应卿招饮","author":"袁说友","text":"东门郭外七桐里，知有宣州别驾家。\n再世从游心自喜，暂时觞咏语无哗。\n平田寒日行孤鹜，枯木凄风集乱鸦。\n酒圣诗狂休问我，淋漓颠倒任横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈浙西张提仓","author":"袁说友","text":"老掾当年意已倾，执鞭虽晚眼仍青。\n绣衣公子初云汉，璧水先生尚典刑。\n负弩前驱容漫叟，下帷覃思愧玄经。\n催科欲付翻羹手，照我山行定几星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坚老住广福","author":"袁说友","text":"高僧七十未龙钟，飞锡飘然百里中。\n正欲逢场施手段，不妨临老入花丛。\n把茅便可传宗旨，一钵由来是祖风。\n直要空门高著眼，看渠拍手任西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岘山塔院","author":"袁说友","text":"野寺埋荒草，浮屠出近郊。\n松声来葆乐，竹影乱旗梢。\n地僻钟鱼响，庭空燕雀巢。\n断崖流涧远，隐隐下山坳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张守招隐","author":"陈造","text":"春风吹作万家春，谁得联镳从使君。\n微径问花同载酒，深堂剪烛细论文。\n王郎把臂簪仍盍，严老呼舟首又分。\n安得云龙随上下，佳辰不复叹离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张汤治狱皆穷根本上欲释严助伍被汤曰弗诛后不可治巧排大臣益见尊任后以怀诈面欺上使使簿责汤汤为书谢遂自杀","author":"袁说友","text":"最是慈祥日，为臣惨刻闻。\n弯弓屠善类，刺骨见深文。\n流毒嗟苛吏，伤恩负此君。\n不知惭簿责，一死尚何云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀仲子病目","author":"袁说友","text":"秋日家乡远，西风去雁迟。\n小儿应药喜，老父数归期。\n昨夜三江梦，今朝五字诗。\n至情如饮水，冷暖自深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟咏宴群臣","author":"袁说友","text":"宴锡蓬山焕旧章，群工列席侍龙光。\n加笾折俎君恩重，合奏回风韵语长。\n击筑为歌嗤汉祖，举觞隆礼视周王。\n幸哉盛事今逢见，愿赴功名敢入襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟咏展观太上皇帝御书","author":"袁说友","text":"龙颜祗肃阅尧章，宝轴神毫赫有光。\n八法心传齐帝学，万年奎画与天长。\n袭藏肯比唐三杰，墨妙尤卑晋二王。\n舜治方隆定于一，区区发问陋梁襄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨梅","author":"袁说友","text":"酒著圆腮重，珠联细叶芳。\n绛纱笼蜜颗，朱粉皱新妆。\n色渍桑间椹，甘传荔子浆。\n轻酸认梅种，草木有他杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"求酒于邵元实删定","author":"袁说友","text":"骨相酸寒不足论，平生心赏旧家村。\n七年误索长安米，百病几成楚客魂。\n命薄不堪嗟分定，官閒犹得荷君恩。\n秋风一醉馀疴殄，须乞庄生五石樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈无隐国正惠殿庐所赐香茶","author":"袁说友","text":"公论归吾党，平生只故人。\n近书时遣况，旧雨日相亲。\n茶辍闽山贡，香分御府珍。\n须公文石陛，回首霅溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵壁蹲石","author":"袁说友","text":"几朵连峰峻，千年古镜浮。\n气分灵壁秀，声逐泗滨流。\n笑我成孤影，从渠老一丘。\n山川多胜地，击拊叹中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓金国聘使舟中逢玉簪花","author":"袁说友","text":"扁舟伊轧乱秋声，花下新凉暑不侵。\n浓叶衬成螺展髻，芳苞拆尽玉垂簪。\n谁将茉莉评高下，未必清香较浅深。\n把酒问花花不语，微吟空伴小蛩吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨","author":"袁说友","text":"一月长晴窘漕渠，更留残暑要驱除。\n飘风也解终朝久，骤雨新添二尺馀。\n但觉天公真有意，不知民力已潜纾。\n田家是处均膏泽，两岸欢吟使者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈主管招饮","author":"陈造","text":"鹊拳庭竹语频频，忽有书来寂寞滨。\n盛事许同花烛夜，芳辰仍醉绮罗春。\n璧联香閤初鸣凤，霞泛仙觞定脯麟。\n更办归装捃珠玉，一时人物各诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饭西湖兜率寺","author":"袁说友","text":"风炉煮饼梵王家，一日平湖十里赊。\n游子政须供杖屦，老僧应有痼烟霞。\n绝知咳唾新珠玉，想见冰霜绕齿牙。\n我恨三山无路到，望中赢得眼昏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"麦秀三岐","author":"袁说友","text":"用过其才愧弗宜，但于牧养要张施。\n未应拙政才兼月，森出来牟过两岐。\n长短异形垂美穗，青黄间色识新枝。\n悬知瑞应由明主，自是丰年属圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侃老舍天宁寺往游何道二山二首 其二","author":"袁说友","text":"飞锡真游戏，论诗解往还。\n一声狮子吼，十里道场山。\n绿竹静无语，白云长自閒。\n赵州应路滑，无复叹间关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侃老舍天宁寺往游何道二山二首 其一","author":"袁说友","text":"拍手笑无语，挑包去不还。\n行行馀一钵，历历上诸山。\n明月随方照，孤云任意閒。\n猊床待师处，猿鸟撤松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周可大惠昆崙桃","author":"袁说友","text":"秋雨成萧瑟，缃桃辱记存。\n品高来禁籞，地远想昆崙。\n幸有千年实，愁无五石樽。\n欲修琼玖报，素手愧空言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周可大携子入山读书","author":"袁说友","text":"一日不觌面，三秋应动心。\n刚闻将子去，又惯入山深。\n饭饱群书乐，窗閒万竹阴。\n扁舟才十里，得得要相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周锡自蜀归浙","author":"袁说友","text":"东瓯西浙两夤缘，齐止金陵万里船。\n风月醉中同客梦，簿书丛里读诗篇。\n怀归念我方投劾，勇去输君已著鞭。\n岁晚江空帆力满，长安春好正朝天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁端叔九日韵","author":"袁说友","text":"风雨重阳候，旌旗五客游。\n清樽烦卜夜，归鬓但惊秋。\n薄暮霭云散，倾城终日留。\n晚楼东望际，萸菊故园丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人怀归","author":"袁说友","text":"宦海风波恶，穷途故旧新。\n匹夫犹按剑，夜璧莫投人。\n狎水舟沈羽，防城口累身。\n归来老丘壑，一笑乐吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子西喜雨","author":"袁说友","text":"战龙捲水动诗兵，著语才非喜雨亭。\n但得云粳香颗颗，不愁霜发短星星。\n秧针刺水轻浮绿，麦浪翻风半挟青。\n只愿年年饱忧国，庶几万里一心宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘叔骥司户韵","author":"袁说友","text":"不饮无何一味膻，听渠七字辄欣然。\n念非公子谁堪比，可奈吾衰不待年。\n料得诗魔排锦绣，却从笔力裹山川。\n兰亭若未归修禊，更伴刘郎发秘传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过皂角林","author":"袁说友","text":"南北城高俯堑深，过帆猝猝倦登临。\n两山未远瓜洲渡，十里俄惊皂角林。\n坐想英灵犹炯炯，眼看祠庙独阴阴。\n塘村共说兴亡处，笑指东河血未沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年张唐英怀弟晋英韵二首 其二","author":"袁说友","text":"嗜利终羞涩，论交愧懒昏。\n日高忺闭户，客至倦迎门。\n多谢铿金语，来如挟纩温。\n穷年得佳友，花柳乐村村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年张唐英怀弟晋英韵二首 其一","author":"袁说友","text":"旧学知何补，丹心早已平。\n过从欣故侣，慨慕熟英声。\n笑洽愁肠释，诗来俗眼清。\n君家好兄弟，何愧洛中程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和许深父转运判官韵二首 其二","author":"袁说友","text":"诗里论交淡淡情，个中风味不胜清。\n锦囊著句知才尽，山色逢人作意明。\n已觉头颅侵晚景，尚堪风月快馀生。\n与君握手关心处，愧乏琅玕腹可呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和许深父转运判官韵二首 其一","author":"袁说友","text":"我辈难忘故旧情，为君满意说诗清。\n抛砖不愧尘埃想，剖蚌俄惊的皪明。\n宦路几年嗟契阔，长安累月话平生。\n诗筒却趁邮筒急，吟到扬州更袖呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和应宪使游沧浪亭韵","author":"袁说友","text":"使星两两照前山，笔下高吟万选钱。\n绝景政须终日款，兹游真可以诗传。\n深林遇雨排清昼，晚日迎风浸碧烟。\n千载不浑亭下水，俯栏犹得继前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张思济县尉韵二首 其二","author":"袁说友","text":"书债频年积，舟行一水期。\n稍吟秋夜雨，不尽故人思。\n正为才高累，宁论事了嗤。\n相忘心屡折，落笔更蜚驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张思济县尉韵二首 其一","author":"袁说友","text":"作计寻山径，论交独两生。\n相过真有意，多病只垂情。\n老怯终年别，诗烦一夜程。\n怀思几秋梦，月落晓溪横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨诚斋春雨韵","author":"袁说友","text":"十年此袂与君分，一笑楼头日过晨。\n真个愁来真似梦，不因诗到不知春。\n云霄元似非关我，风雨何须故恼人。\n犹得吟边慰怀抱，绝知膏馥乞诸邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨诚斋韵谢惠南海集诗三首 其三","author":"袁说友","text":"芸阁登儒拜黼衣，凤凰来泊凤凰枝。\n待教黄阁调元去，暂对青藜下烛时。\n身到三山真得路，君留群玉几题诗。\n十年前访岷峨事，也作书郎慕左思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨诚斋韵谢惠南海集诗三首 其二","author":"袁说友","text":"玉海书来喜欲狂，餐霞食瀣齿牙香。\n固应宗派名江右，底用宫袍入建章。\n今代欧黄真有种，向来沈鲍肯同行。\n只今五集三千首，但觉荧煌锦绣张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨诚斋韵谢惠南海集诗三首 其一","author":"袁说友","text":"斯文宗主赖公归，不使它杨僭等夷。\n四海声名今大手，万人辟易几降旗。\n天方欲治将焉往，用不崇朝尚窃迟。\n整顿乾坤从小试，南州昔日洗潢池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈德远寄江鳐韵","author":"袁说友","text":"粉身截玉慰渠贪，浪迹泥涂遽著篮。\n坐缺江生嗟不乐，诗来东老谢分甘。\n世间风味鄞江颊，传里形容太史谈。\n欲报琼瑶无一可，移文空到北山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陆成父韵","author":"袁说友","text":"功名落落愧强年，晚到淮乡意惘然。\n问月高歌聊自适，吟秋苦思替渠怜。\n据鞍剩欲誇驰骏，酾酒犹堪醉击鲜。\n坐对晴云净如拭，水光秋色正连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和忠父于先生西湖韵","author":"袁说友","text":"先生摆脱世间缘，老去犹堪十万钱。\n气节向来投匦意，风流今识咏梅篇。\n饱闻东閤抡材久，未许西湖对客眠。\n圣主如天怀谠论，只今此席为君前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林子长池上听雨韵","author":"袁说友","text":"远浦鸣疏雨，平林送落晖。\n霏烟青柳暗，晚霁白鸥归。\n触目怀心赏，凭川念昔非。\n池塘消息近，一笑莫身违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林子长种菰韵","author":"袁说友","text":"城郭千林静，菰蒲二顷宜。\n移根元不费，殖利已先知。\n仅脱黄泥贱，相从白玉炊。\n平生惯藜藿，于此羡耘耔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林子长家庭韵","author":"袁说友","text":"诸郎方竞秀，兰玉谢庭家。\n国士无双誉，蟾宫第一花。\n侍嫔歌采苢，笄鬓绾堆鸦。\n已办如椽笔，绵绵赋瓞瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和罗春伯奉常寄题稽山阁韵","author":"袁说友","text":"公来祗谒自周行，脚踏稽山意远翔。\n叠嶂排云烟杳霭，半天得月夜凄凉。\n无言可状湖山好，有客来时锦绣张。\n底事东吴声价重，螭头椽笔冠文场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南伯山行韵二首 其二","author":"袁说友","text":"千峰踏尽又层坡，冠染征尘不暇峨。\n佳处赏心惟酒尔，愁时引睡奈诗何。\n憩亭尚远日先暮，脚力已穷山更多。\n白发对山聊自醉，如公自富郢中歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南伯山行韵二首 其一","author":"袁说友","text":"日日登山复下山，崎岖分寸绝难攀。\n已无鱼腹江湖虑，肯怯羊肠道路弯。\n满目诗材供客子，一杯醽醁染衰颜。\n四方弧矢男儿事，扪尽参墟莫畏艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和施德远双莲韵二首 其二","author":"袁说友","text":"政拙才疏祇具员，也应和气到吴边。\n乡来偶尔双岐麦，今复申之并蒂莲。\n颇觉园丁惊创见，正须骚客赋新联。\n天休要是传消息，得得装成大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]