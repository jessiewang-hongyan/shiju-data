[{"title":"游谭田寺","author":"蒋金部","text":"我爱谭田寺，短桥横碧波。\n数椽松竹里，静处不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 其一 寿张运使","author":"蒋思恭","text":"紫府掣金钥，银汉夜乘槎。\n老仙暂驻幢节，来佐玉皇家。\n翠发朱颜好在，肘后有方医国，宝鼎养丹砂。\n谈笑功名了，身退饭胡麻。\n游物外，聚紫脑，炼青芽。\n星垣寓直有子，曾步八砖花。\n来岁称觞寿宴，衮绣彩衣交映，重荐枣如瓜。\n俯首拾瑶草，长啸卧烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水调歌头 其二","author":"蒋思恭","text":"风流九霞客，名在五云乡。\n十年出入华禁，簪橐奉君王。\n黄伞西清日转，宝月红鸾影里，长近赭袍光。\n彩笔赓歌处，殿阁有馀凉。\n跨秋风，凌宝鼎，笑芝房。\n人间争识奇贵，妙帖焕名章。\n莫羡碧幢金印，换取玉堂清琐，翰墨看淋浪。\n岁岁宫壶酒，雨露带天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋吟","author":"蒋恢","text":"落叶纷纷捲地来，手持六角障黄埃。\n何人真解知秋意，与上凌虚百尺台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜读书","author":"蒋恢","text":"白纻乌纱不耐凉，晚风吹月上莓墙。\n旧书重读添新味，二尺檠边夜正长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重午","author":"蒋恢","text":"逝水光阴不肯停，又从菰黍重寻盟。\n平生不学采莲曲，只读离骚配酒兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"蒋恢","text":"幽鸟无言啄落花，风吹榆荚打窗纱。\n先生酒醒绿阴里，笑听蜂儿报晚衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月晦日偶成","author":"蒋恢","text":"一年芳信雨消磨，负此吟怀奈若何。\n倚槛忽惊新绿暗，扫轩更惜落红多。\n春归惟有时禽觉，睡足从渠日影蹉。\n闲里工夫闲受用，惜无闲客肯相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰腊日遣兴","author":"蒋恢","text":"腊里春前日日阴，西畴弥觉水云深。\n梅边句好无人觅，竹外烟轻有鸟吟。\n发兴合穷千里目，著书聊寄百年心。\n翻云覆雨谁能问，纳纳乾坤古复今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟回练塘","author":"蒋恢","text":"柁转秋塘迥，寒光彻万寻。\n叶声风外急，吟思雨中深。\n白发存公道，青山适素心。\n疏钟何处起，暝色正沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行山","author":"蒋恢","text":"六尺枯筇度远岑，野花啼鸟助清吟。\n云低似觉天根近，涧远因知地脉深。\n阅世岂容无正眼，穷源须要识初心。\n春寒局促良堪厌，一笑阳和破积阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野色","author":"蒋恢","text":"幽事每堪娱，秋深晚霁初。\n帆分江影破，风勒鸟行疏。\n山色美无度，稻花香可书。\n逍遥今夕意，未厌短辕车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西岩胜水","author":"蒋晋","text":"柘川之西有削石，屹立巍巍峻如壁。\n下有沧浪百尺深，澄清恰似秋天碧。\n逝者如斯竟不停，孺子长歌堪濯缨。\n故知源头有活水，支流分派迢迢清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柘川渔火","author":"蒋晋","text":"玉川一带光涵秋，渔艇纵横网罟稠。\n西风日落寒烟暝，煌煌灯火明中流。\n数点如萤走络绎，影趁流波泻金液。\n一声欸乃明灭间，邻鸡又报东方白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛井仙踪","author":"蒋晋","text":"谁凿云根清气泄，混混源泉流不竭。\n味极太古比龙涎，饮之令人骨清彻。\n父老为云有葛仙，丹成此地经多年。\n寂寞烟霞洞云静，惟留斯迹令人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠屏列画","author":"蒋晋","text":"青峰如屏高插天，悬崖积翠生云烟。\n谁把王维旧墨迹，巍巍高挂安居前。\n胜景应知世稀有，妙学丹青乃缩手。\n嗟哉画有蠹损时，斯图寿比南山久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲤屿浮岚","author":"蒋晋","text":"天地造化真何如，幻就青岚如鲤鱼。\n初疑孝子感天意，复恐古人传素书。\n岚气时浮北烟瘴，缥缈奔腾似吹浪。\n远跳深惊欲化龙，故有飘飘五云障。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过葛墟读蒋冽大宗碑","author":"蒋堂","text":"天宝年中立此碑，轩裳鳞次美当时。\n自从寂绝牛头梦，力振家声合在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴江桥","author":"蒋堂","text":"雁翅桥横五湖北，翚飞亭屹大江心。\n鱼龙渊薮风月窟，若比广寒宫更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏金竹","author":"蒋堂","text":"百镒光寒一径深，潜疑造化铸成林。\n贪夫或有凭阑者，不见修篁但见金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前题","author":"蒋堂","text":"使君有意饰门闾，雅为灵芝揭表初。\n招隐溪边往还者，从兹认得野人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"蒋堂","text":"归来深隐太湖滨，天与扶持百岁身。\n虽是浮云隔双阙，丹心爱戴在君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景祐丁丑创曲水亭寮属同赋诸官诗成因书二韵于后","author":"蒋堂","text":"一派西园曲水声，水边终日会冠缨。\n几多诗笔无停缀，不似当年有罚觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清阴馆种楠","author":"蒋堂","text":"手植楩楠二千树，时当庆历五年春。\n还期莫道空归去，留得清阴与后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题月禅师方丈","author":"蒋堂","text":"我到云房是有缘，坐移莲刻听禅诠。\n江边异日人应记，吏部曾来见大颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠白云张少愚","author":"蒋堂","text":"聘命当年下益州，戋戋束帛礼偏忧。\n山人著出隐居报，使者赍还答诏牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠惟政禅师","author":"蒋堂","text":"禅客寻常入旧都，黄牛角上挂瓶盂。\n有时带笠穿云去，便好和云作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泰伯庙","author":"蒋堂","text":"泰伯何为者，不以身为身。\n逊避天下位，奔走句吴滨。\n隐德昭来世，遗祀传斯民。\n吁此廉让国，合生廉让人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东斋","author":"蒋堂","text":"守土无留事，休居有静斋。\n文才化僭陋，术未迨乖崖。\n古帙书参画，秋阴竹间槐。\n西人安枕外，聊此息筋骸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴淞江 其一","author":"蒋堂","text":"江人见我谓谁何，行李无羁野意多。\n六幅青帆趁潮去，一樽白酒扣舷歌。\n沙边历历辨云树，岛外溅溅弄月波。\n兴尽归来还更喜，舞鸥相送入烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其八","author":"蒋堂","text":"池上有时宴，笙簧沸欲凝。\n欢多漏移刻，坐久月和灯。\n席客咏持蟹，女倡歌采菱。\n醉来忘万事，风静水波澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其六","author":"蒋堂","text":"池上有丛菊，繁英满旧蹊。\n金刀惜频剪，粉蝶得幽栖。\n醉卉谁同插，香笺手自题。\n遥思清赏处，野步岸东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其九","author":"蒋堂","text":"池上有雏鹤，来从淮水壖。\n旧巢离海树，清唳入吴天。\n骨峭翘霜月，翎疏刷野泉。\n使君宜得伴，仙格本千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其五","author":"蒋堂","text":"池上有垂柳，烟笼濯濯枝。\n芳根逢茂育，老翠胜平时。\n体弱因风舞，词清入篴吹。\n金城久不到，遥想叹羁离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其七","author":"蒋堂","text":"池上有时钓，閒忘侍从身。\n波平方浸月，吏退阒无人。\n藻映鲂鱼尾，风摇独茧纶。\n一亭容膝地，雅饰免荒蓁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其四","author":"蒋堂","text":"池上有修竹，遥闻手自栽。\n几因风韵响，时感隼旟来。\n粉箨经梅脱，虬根遇石回。\n婵娟绿阴下，小阁为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其一","author":"蒋堂","text":"池上有虚阁，翚檐迅若翔。\n百壶多盛集，四座仰惟良。\n藓印文綦绿，莲依桂楫香。\n何由陪啸咏，敷衽纳微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其二","author":"蒋堂","text":"池上有奇桧，青青岁纪深。\n旧枝怜茂植，时亦助清吟。\n夕月漏孤影，秋霜滋劲心。\n今方遇真赏，风什播瑶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖台三首 其三","author":"蒋堂","text":"水次揭危亭，烟堤四面平。\n栽芦延宿鹭，种柳待啼莺。\n雪霁清流涨，风来野艇横。\n轻肥莫临顾，我老懒逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖台三首 其二","author":"蒋堂","text":"峣榭水中央，兹为隐遁乡。\n小园香寂寂，一派晓泱泱。\n烟草碧弥岸，霜桃红压墙。\n鸱夷倘在此，未必入沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖台三首 其一","author":"蒋堂","text":"危台竹树间，湖水伴身閒。\n清浅采香径，方圆明月湾。\n放鱼随物性，载石作家山。\n自喜归休早，全胜贺老还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"蒋堂","text":"老被诗名系此身，思深山去避人群。\n宝台千尺隔江见，清磬一声归路闻。\n岩上开扉灯照月，庵前扫地雪和云。\n终焉此是清凉处，净住无惭相国文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅","author":"蒋堂","text":"玉骨绝纤尘，前身清净身。\n无花能伯仲，得雪愈精神。\n冷淡溪桥晓，殷勤江路春。\n寒郊瘦岛外，同气更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐圃诗","author":"蒋堂","text":"雅得菟裘地，清宜隐者心。\n绿葵才有甲，青桂渐成阴。\n独曳山筇往，无劳车驾寻。\n湛然常寂处，水月一庵深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪馆二首 其二","author":"蒋堂","text":"野意本自遂，兹溪称独醒。\n云萝环静室，水石照疏棂。\n杀竹编书古，纫兰作佩馨。\n王通昔不遇，时亦坐汾亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪馆二首 其一","author":"蒋堂","text":"年来纳组去，林下得身还。\n泚泚清流处，重重碧树间。\n渊鱼乐且静，庭鹤寿而閒。\n粗有淮安趣，谁同赋小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题山亭","author":"蒋堂","text":"山亭深处枕清溪，万木回环尽翠微。\n梅萼破香知腊近，柳梢含绿认春归。\n风前列嶂琴三叠，雪后群山玉四围。\n顾我此来盘礴久，尘劳潇洒顿忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曲水阁","author":"蒋堂","text":"危构跨奫沦，清宜涤世纷。\n飞湍逢石转，漱玉隔山闻。\n影乱林花落，丛幽涧草熏。\n兹为褉饮地，何羡右将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题妙喜庵","author":"蒋堂","text":"禅公览古意裴徊，偶结云庵向北来。\n满目沧洲围野景，一枝金策卓秋苔。\n沙边水鸟衔花至，月下渔人施供回。\n或记稽山旧徒侣，樵风应为送浮杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈虞卿","author":"蒋堂","text":"宠秩拜春坊，归休识虑长。\n扫门卑魏勃，设醴谢元王。\n一水莼鲈国，群山橘柚乡。\n喜君添老杜，烟驾尚徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞来山","author":"蒋堂","text":"有山昔飞来，神怪安可测。\n万壑鼓风雷，千岩为羽翼。\n胡为忽移徙，到此无倾侧。\n灵越得奇峰，琅琊失遗迹。\n烟云随而至，杉篁古所植。\n如何草创时，躺作瞿昙宅。\n闻之有苾刍，岁久苦刓刻。\n凿声响深崖，火烬淬层壁。\n平为土木基，蔑有苍翠色。\n金粟千亿身，窣堵百馀尺。\n回廊尽复叠，寸地无闲隙。\n一聚红尘中，万瓦青烟羃。\n成彼有为善，斯可长太息。\n我试来寻山，山形俱变易。\n方念此崭绝，安得如往昔。\n不谓山之足，下落言偃室。\n知是骞翥时，于兹堕岩石。\n屹尔画疆畔，其谁敢侵蚀。\n随宜得形胜，触目见崷崒。\n小桂结沈阴，清露有疏滴。\n巾履日可赏，琴樽雅成饰。\n多谢对幽岑，亦足开烦臆。\n若在祇园间，岂更存馀碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再题半峰亭","author":"蒋堂","text":"何名半峰亭，尧峰路之半。\n游客趋层崖，斗上多股战。\n宝云构兹轩，接引心不倦。\n所冀冠盖来，少休松石畔。\n雄视金仙居，巍乎倚云汉。\n自此更攀缘，须臾跻彼岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尧峰新井歌并序","author":"蒋堂","text":"白云莽莽青山头，一穴四面飞泉流。\n其初山间旧井涸，枯肠燥吻海众羞。\n于时大士宝云者，颐指土脉智虑周。\n山灵所感道心爽，檀施聿来工力鸠。\n云锸齐下远雷动，石光内击飞星稠。\n百尺虚空廓地表，一泓清冽呀深幽。\n人疑从天堕月窟，或问何处移龙湫。\n次则其徒骇殊胜，竞持应器尝甘柔。\n饥狖连臂喜跳掷，渴鸟引喙鸣钩辀。\n碧甃光中辘轳晓，银床侧畔梧桐秋。\n宝坊金地互相映，谷鲋坎蛙难此留。\n傍睨江形小衣带，下窥湖面卑浮沤。\n何兹凿饮有功利，一掬入口醍醐优。\n热者濯之昏钝决，病者沃之沈痼瘳。\n而我时邀墨客去，松涧远挈都篮游。\n净瓶汲引试香荈，雅具罗列无腥瓯。\n比之玉乳不差别，诮彼鍊丹多谬悠。\n今兹泉眼在鲁坞，所喜云液邻菟裘。\n苧翁既往乏鉴者，水记未载予将修。\n此山此井永不废，此歌其庶传南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀野亭","author":"蒋堂","text":"秀野亭连小隐堂，红蕖绿筱媚沧浪。\n卞山居士无归意，却借吴侬作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闵山","author":"蒋堂","text":"东南亘群山，形气成断续。\n兹山穷崭绝，孤峙越之腹。\n郁苍瞰城闉，胜秀为民福。\n所宜禁樵苏，主者在严肃。\n不知平昔时，谁氏来班录。\n私庖计薪爨，无时伐良木。\n官膳利货财，弥年剪修竹。\n忽忽事斧斤，丁丁响川谷。\n万叶坏密幄，千竿倒寒玉。\n轮囷无完枝，檀栾鲜遗族。\n戕贼殊未厌，峰峦翠将秃。\n鹤侣怨且惊，云容惨以恶。\n非唯挫生意，仰乃伤雅俗。\n王者有仁恩，行苇亦沾沐。\n嗟嗟若人者，忍不思化育。\n今予剖信符，于兹憩丹毂。\n谓山岂无灵，胡为人所黩。\n呼吏对泉石，申禁护林麓。\n庶几养翘英，勿使罹残酷。\n来者贤使君，斯言愿为复。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其十","author":"蒋堂","text":"池上有驯鹿，亭台深处行。\n长随熊轼惯，且免兔罝惊。\n遥草眠多稳，流泉饮亦清。\n寸岑有灵囿，可使遂微生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和梅挚北池十咏 其三","author":"蒋堂","text":"池上有孤岛，影摇波底天。\n蓬壶欣髣髴，仙客得留连。\n岸草衬丹毂，滩芦偎画船。\n羡君休浣日，寄傲一尊前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘山 其一","author":"蒋堂","text":"虎丘何为山，鲸波涌而显。\n惟青镇一隅，峙秀状无限。\n遥峰乃众阴，四望拱孤巘。\n上有梵王家，高压长洲苑。\n游人接踵来，千里必重趼。\n奔走趋层巅，凌竞陟云栈。\n下瞰洞庭卑，傍睨灵岩浅。\n巍乎屹宝阁，仰之目睛眩。\n中有明光书，丽若日星烜。\n三朝所秘藏，百灵共幽赞。\n兹焉真福庭，瞻者皆色洒。\n夐觉尘世非，恍如化城现。\n塔顶拂彤霞，山脚环青圳。\n北崖宿雪寒，东阜晨曦暖。\n阴森岩腹空，诘屈廊腰转。\n秋磬落云端，宵灯耿天半。\n处者病恼蠲，来者钝根遣。\n予膺邦寄时，所历游屐遍。\n不领旌旗行，恐惊禽鹿散。\n扪萝穷邃深，据槛望平远。\n寻幽既欢欣，访古或兴叹。\n葬金坟已隳，淬剑池犹漫。\n冰霰凋古杉，朱丹浮断简。\n珍重讲石存，讥评鬼诗诞。\n唐贤留风什，遗墨罗粉版。\n险语悉冥搜，清景不可逭。\n国朝有笔札，岩壁刻棱婉。\n刀槊君谟书，龙蛇不疑篆。\n二美贲禅扃，千古骇人眼。\n于时出世师，净住日营缮。\n发缘善侣臻，毕力梓工僝。\n绀宇生光辉，胜概如采绚。\n海众咸安栖，宗风愈恢阐。\n迦陵觉音清，石室惊筹满。\n自惟挂缨归，心与纷拿断。\n每来寻香刹，常得峨野弁。\n久留莲漏移，相接犀谈款。\n露井汲云浆，冰瓷试芳荈。\n最怜草树春，几爱烟岚晚。\n愿借一庵名，于兹修止观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栀子花","author":"蒋堂","text":"庭前栀子树，四畔有桠杈。\n未结黄金子，先开白玉花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题西园","author":"蒋堂","text":"西园昔日多游从，回流屡泛卮酒空。\n前亭后亭草茵软，晓景晚景烟岚融。\n角巾萧洒竹林际，履綦来往花阴中。\n时方偃蕃适四体，不料游宦如孤蓬。\n数移五马临大屏，几怅二毛成老翁。\n昨去邻封亦甚迩，祇限一水无由通。\n锦城此举又远适，流觞雅会何时同。\n钱塘山色望不见，稽山况在钱塘东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题望湖楼","author":"蒋堂","text":"城上危楼势孤峙，楼头尽见湖中水。\n水色澄明游者多，古来雅以鉴为比。\n家家画舫日斜归，处处菱歌烟际起。\n清涟蒙润一都会，碧底涵空三百里。\n溥哉利及镇东人，而我常嗟马臻死。\n今滋史君多感慨，所以望湖心不已。\n频登雉堞追古往，盛集宾朋为宴喜。\n楼南极目芙蓉花，万叠红英照千骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]