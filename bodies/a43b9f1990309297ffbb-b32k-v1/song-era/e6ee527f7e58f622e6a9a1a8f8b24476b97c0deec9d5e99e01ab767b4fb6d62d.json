[{"title":"东塔六言二首 其一","author":"孙觌","text":"翠竹含风袅袅，青山照水重重。\n窗户无人半掩，一龛香雾空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东塔六言二首 其二","author":"孙觌","text":"偶与白云共出，忽随倦鸟俱还。\n明日重寻旧路，桃花流水空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游东塔雨中夜归二首 其一","author":"孙觌","text":"山气濛鸿衣自湿，意行曳杖穿云入。\n老翠阴森万竹蟠，浮苍潋滟千峰立。\n邂逅幽寻到萧寺，拊掌一笑掀百蛰。\n酒醒佛火照黄昏，坐听北窗风雨集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游东塔雨中夜归二首 其二","author":"孙觌","text":"山色凌寒春尚瘦，潭影涵空清可漱。\n漠漠云行紫竹闲，斑斑雨湿黄昏后。\n火炬穿林鸟出巢，人语阗门狗窥窦。\n杖藜有兴会重来，更待黄鹂哢晴昼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦春望二首 其一","author":"孙觌","text":"王孙春望思寥寥，冠盖当年盛八萧。\n花靥重重墙外见，琴心切切酒中招。\n屠龙已破千金产，驷马重归万里桥。\n便解貉裘沽一醉，忍看红糁缀寒条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦春望二首 其二","author":"孙觌","text":"万木阴中锁泬寥，晨门跋马听萧萧。\n故人自欲分茵去，逐客何妨折简招。\n共对春风班露草，却随明月下溪桥。\n击鲜故有诸郎在，三尺银刀贯柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邹次魏黄善长携文见过小诗为谢","author":"孙觌","text":"邹郎英妙知名久，笔端自有谈天口。\n客舍相逢一尊酒，众星错落见箕斗。\n高论欲追牛马走，长剑忽作蛟龙吼。\n馀子碌碌那得交，江夏无双亦其偶。\n我观二妙屠龙手，青紫纷纷何足取。\n他年要作中兴碑，大字磨崖继聱叟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸丑寒食曹山饭僧荐章淑人不胜悼往之怀书二诗于方丈屋壁 其一","author":"孙觌","text":"川逝日已远，蓬漂久未归。\n异乡惊岁换，宿草变春晖。\n魂梦差参是，音容想像非。\n遥怜小儿女，恸哭纸钱飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"癸丑寒食曹山饭僧荐章淑人不胜悼往之怀书二诗于方丈屋壁 其二","author":"孙觌","text":"草草木皮棺，松风生暮寒。\n莺啼春寂寂，萤照夜漫漫。\n梦里号三匝，愁边荐一箪。\n想思为君瘦，零落带围宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日与范季实诸人过胥泽民别墅小集二首 其一","author":"孙觌","text":"水满双飞白鹭，花深百啭黄鹂。\n寒食清明过了，一川烟草离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日与范季实诸人过胥泽民别墅小集二首 其二","author":"孙觌","text":"兀兀三杯卬困，昏昏一枕春融。\n酒醒落花风里，梦回啼鸟声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山春日二首 其一","author":"孙觌","text":"弱柳千丝飏，河横一带围。\n腰支春作瘦，鳞甲雨生肥。\n逐伴鱼儿出，争巢燕子飞。\n匆匆班草地，不觉卧斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山春日二首 其二","author":"孙觌","text":"屏拥山入坐，珠跳水溅裾。\n香销尘漠漠，日近竹疏疏。\n身逢百罹后，春残一梦馀。\n故林千嶂外，孤抱几时摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壁上人开轩辟地栽花种橘戏留小诗","author":"孙觌","text":"看云随卧起，饮水自敷腴。\n秀色共斋钵，寒声落坐隅。\n未开花五叶，且种橘千株。\n幽事相关处，时来近酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雨","author":"孙觌","text":"小雨破春昏，清风洗瘴氛。\n霏微花上见，萧瑟夜深闻。\n独笑幽闲事，酣歌倚半醺。\n羁怀不堪写，危坐听炉芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚二首 其一","author":"孙觌","text":"花落不容惜，犹残叶底春。\n稀红闪馀映，乱绿斗尖新。\n飞絮高度竹，游丝远趁人。\n窥帘闻好语，双鹊喜津津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚二首 其二","author":"孙觌","text":"残尊断送春，千里未归身。\n莺老犹闻语，梅酸欲聚颦。\n独眠愁警夜，起舞听鸣晨。\n行路难如此，悠悠且傍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山三绝句 其一","author":"孙觌","text":"露宿风餐两鬓华，故园芜没旧生涯。\n圣恩若许求帷盖，便向东陵学种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山三绝句 其二","author":"孙觌","text":"竹杖芒鞋稳称身，茸茸香草醉中茵。\n举鞭叱驭何为者，始信王阳是可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山三绝句 其三","author":"孙觌","text":"毁瓦区区为食谋，半生炊黍在刀头。\n一廛会入扶犁手，不上陈登百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有客生致两雉不忍杀开笼纵之二首 其一","author":"孙觌","text":"平地安知祸有机，一跌永负青云期。\n举群惊雊堕罝网，衮背焕烂光陆离。\n山梁三嗅不忍嘬，如皋一笑吁可悲。\n开笼放汝须远去，莫遣韩公赋病鸱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有客生致两雉不忍杀开笼纵之二首 其二","author":"孙觌","text":"谁令孤鷕遂专场，剪迭笼中看鸟翔。\n文章正坐虎毛柄，铩羽一落千丈强。\n翠翎低摧少颜色，奇祸非汝能遮防。\n匆匆应媒莫浪出，尊拳毒手正交相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题妙觉寺壁","author":"孙觌","text":"叶底红稀不见花，枝头绿暗可藏雅。\n春归古殿苍苔满，一点笼灯隐绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再至","author":"孙觌","text":"老眼逢春病有花，淋浪醉墨字如雅。\n悬知不是唐王播，惭愧高僧护碧纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿妙觉竹庵赠静老","author":"孙觌","text":"青山映落日，澹澹烟中明。\n出门无所投，曳杖随意行。\n破裓僧两三，喜笑争邀迎。\n曾巢俯修竹，飞星动高甍。\n老人如宿昔，真契同三生。\n遇人无戚疏，出语恶不情。\n寥寥风马牛，肝胆欲尽倾。\n怪我胸中山，硉兀尚不平。\n邯郸乐无度，短梦一饷荣。\n蛮触怒不休，暴骨千里横。\n微言起我病，内愧面汗骍。\n蚤知天宇大，岂有世网婴。\n举扇障西风，浣此沧浪缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胥泽民招饮二首 其一","author":"孙觌","text":"萧晨散幽步，不放一尘惊。\n高崖初日吐，坏道哀湍鸣。\n平生耽田里，见此心眼明。\n危桥属幽径，别户延朱甍。\n主人鸡黍约，庖烟起晨烹。\n长须举案出，银杯坐中行。\n烂漫写真意，殷勤愧深情。\n留欢更卜夜，华烛吐长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胥泽民招饮二首 其二","author":"孙觌","text":"苍茫夜气合，渺渺风露清。\n篮舆兀醉梦，翩若孤雁征。\n老马志万里，络首丧其生。\n十年饱刍豆，立仗不敢鸣。\n自识酒中趣，承辞身后名。\n皎皎一片心，不受宠辱惊。\n清风悲永夜，万窍同一声。\n醉里有归路，彷佛游化城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别如老","author":"孙觌","text":"同舟无胡越，四海皆弟兄。\n吾人虽晚接，一笑盖已倾。\n我老未闻道，意行堕沟坑。\n逢人得推骂，知非愧平生。\n世乱识真态，涂穷见真情。\n曳杖扣禅扃，撞钟听靴鸣。\n小窗风雨夜，对此一榻横。\n吾身如木偶，春至不复荣。\n岂无三宿恋，天雨方流行。\n去去得首邱，归田克残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徙寓妙觉佛舍胥乂民襆被相过赋夜坐","author":"孙觌","text":"客居厌穷独，蓬艾翳环堵。\n庄舄尚越吟，钟仪犹楚语。\n吾人有奇操，空洞见城府。\n相逢逆旅中，雾豹初一睹。\n拘囹赋囚山，避谤憎市虎。\n褰裳肯顾我，崖峤走风雨。\n微吟对清夜，破此五月暑。\n坠露挹金茎，空花堕犀麈。\n孤灯映笼纱，泠滟翳复吐。\n耿耿遂不眠，逢逢听晨鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招邹次魏","author":"孙觌","text":"客舍风雨交，庭芜蔓春草。\n蓐食悲王孙，戛釜厌邱嫂。\n吾人才杰立，一障狂澜倒。\n汤汤捍滔天，凛凛块绝岛。\n奇音闲大朴，妙语发天藻。\n壁间见蝎喜，屋上瞻乌好。\n跫然听足音，自足慰衰老。\n出门泥活活，所向碍行潦。\n怀人心不展，厌乱迹如扫。\n仲子过我庐，肩舆白云道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠答渊侍者","author":"孙觌","text":"沐猴著冠天所械，笑唾千金如一芥。\n时时扣角咏三生，口业未除诗有债。\n薨薨不作秋虫声，蔼蔼欲尽春云态。\n平旦谁登大将坛，一军惊呼子光拜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建昌守朱直伯寄酒小诗为谢","author":"孙觌","text":"爱酒渊明望白衣，传闻骑吏款柴扉。\n为怜渔父鸣鞭送，欲便山翁倒载归。\n泪向琵琶弦上落，心随蝴蝶梦中飞。\n一杯属我宽愁病，免使黎侯咏式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵","author":"孙觌","text":"千骑森森响铁衣，日上铜环四扇扉。\n何妨指点银瓶索，直须倒著接篱归。\n已邀明月三人共，更看红尘一骑飞。\n何日渊明赋归去，晨光前路正熹微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙觉寺适轩二首 其一","author":"孙觌","text":"古寺秋崖上，清风掩半关。\n晚花明艳艳，晓溜落潺潺。\n松笋穿阶瘦，苔窠蔽石斑。\n翘沙怜鹭静，抱叶看蜂还。\n心以空无累，身从病得闲。\n仪曹独何事，终日赋囚山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙觉寺适轩二首 其二","author":"孙觌","text":"老厌风沙恶，安闲且当禅。\n开帘延白月，倚杖立苍烟。\n鸟散人声里，钟残客梦边。\n小蒲风叶偃，薄槿露花鲜。\n句好吟须断，欢馀醉帽偏。\n人生但如此，何处不翛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙觉书事二首 其一","author":"孙觌","text":"聒聒催酤我，嘤嘤唤友声。\n一遭青蝇污，永负白鸥盟。\n睡鸭嘘烟满，苍龙噀雨鸣。\n参禅我未暇，一榻对僧横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙觉书事二首 其二","author":"孙觌","text":"隐几抛书坐，攲床听雨眠。\n僧来逢自足，盗去失青毡。\n楚国虽三户，滕氓尚一廛。\n如今更何恨，端用酒为年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦端午","author":"孙觌","text":"饭筒菰黍趁流年，葵扇桃笙尚宛然。\n世味半随昌歜苦，心旌长与艾人悬。\n鸿飞不到书来少，鹊喜无凭语浪传。\n两鬓萧萧吹白发，空馀衰谢故人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴益先携文见过以诗为谢","author":"孙觌","text":"千里之马初服辀，风騣雾鬣跨九州。\n驾盐挽磨三千秋，俯首尚与驽骀游。\n吴郎人中第一流，文采绚烂珊瑚钩。\n阳春白雪和者少，夜光明月暗中投。\n鲁人不贵东家邱，吾髯凛凛青两眸。\n摐金戛玉声相求，属镂双蟠九地幽。\n有气夜出干斗牛，忽然化作长黄虬。\n睚眦之怨何足雠，一麾立断楼兰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦","author":"孙觌","text":"北窗风冷冷，西阁夜悄悄。\n缺月吐半璧，独与太白晓。\n缑山王郎子，粲若玉树皎。\n纷纷哙伍中，特立负奇表。\n清谈静炎燠，坚卧镇浮扰。\n呼童高树栅，赤帻厌凡鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"孙觌","text":"二年客尘土，独夜忧悄悄。\n遇酒一破颜，歌呼醉连晓。\n寸心为谁明，伴此孤月皎。\n枯楠郁峥嵘，老干空自表。\n蚁穿万孔萃，蛛挂千丝扰。\n白鹤逝不来，岂敢更择鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涂子野九岁子名驹字千里戏作绝句 其一","author":"孙觌","text":"日角珠庭秀两眉，谁家有此宁馨儿。\n莫惊堕地驹千里，久见参天桂一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涂子野九岁子名驹字千里戏作绝句 其二","author":"孙觌","text":"碌碌为生笑阿奴，九龄重见此英雏。\n千回健走非黄犊，一洗群空定白驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗赠竹庵静老人","author":"孙觌","text":"争名计身后，逐利了目前。\n道人一弹指，永断三生缘。\n起灭水上沤，聚散风中烟。\n纷纷阅凋谢，东海今桑田。\n缟发茁枯颅，秀眉覆两颧。\n已超人天上，遂拍佛祖肩。\n茅斋立万竹，荫此碧玉椽。\n绿暗云扰扰，清涵露娟娟。\n我老无家舍，馀地寄一廛。\n不辞供井硙，辛苦送华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"置酒","author":"孙觌","text":"离离黍禾暗空村，一点炊烟带雨昏。\n山翁过我竹阁寺，未扣爵罗廷尉门。\n老去不辞污诗酒，区区独醒一何有。\n笑语未办供主人，久客那能拒邻叟。\n杜陵白首尚书郎，步屧春风向草堂。\n人生意合无妍丑，共此一夕灯烛光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读李光远诗卷次韵二首 其一 泗州南山","author":"孙觌","text":"跳波乱清淮，一叶寄真赏。\n南山如高人，标格自矜爽。\n胡尘暗楚甸，绝境堕渺漭。\n空城草木春，户外履谁两。\n怅望壶公龙，乘云自来往。\n小诗若图画，彷佛见飞桨。\n从今淮上山，不落梦中想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读李光远诗卷次韵二首 其二 扬州谷林堂","author":"孙觌","text":"楚山多异材，翠竹满崖谷。\n萧萧斤斧馀，斩伐同一束。\n芜城带流水，万亩淇园绿。\n遗苞駮云锦，老节抱金玉。\n岁晚虎穴邻，舐掌方择肉。\n此君亡恙否，应坐白眼俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"志新诵近诗次韵二首 其一","author":"孙觌","text":"客舍秋风我欲愁，世途如漆莽悠悠。\n半生小利营锥末，此日危炊上剑头。\n万里穷乡怜我老，一廛小隐待君谋。\n惘然貌赤空相对，扇面令人手不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"志新诵近诗次韵二首 其二","author":"孙觌","text":"野鹤昂昂祗自奇，水凫泛泛强随时。\n问禅乞我安心法，住世分君大药资。\n便欲乘桴从鲁叟，不须歌凤叹周衰。\n超然独啸千峰上，一吷清风万窍吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石䂬在宜黄县之南二十五里义泉寺寺旁有磴道高里许循山而西少北忽有石梁数十丈横绝两崖之间中空无柱高出云表神剜鬼刻不可名状真洞心骇目之观而僻在一隅游客无所为而至乃赋诗一篇以告喜游而不知者","author":"孙觌","text":"何人手执造化关，投此虹蜺跨两间。\n乌鹊填成天上路，鬼神鞭出海中山。\n飘飘尻驾凌空举，侧身下瞰千峰雨。\n河汉汹汹声西流，风雹相躔齐万弩。\n始信通天有一门，便欲晞发扶桑根。\n乘槎忽逢支机石，拄杖直到洗头盆。\n赏俊誇雄两奇绝，邂逅一声如电掣。\n冥冥沧海会扬尘，大字磨崖书岁月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熊夫人遣介欲婿泽民小诗戏之","author":"孙觌","text":"墙头邻女三年望，户外文君一笑窥。\n欲得贤夫嫁张耳，此真佳婿是羲之。\n定知不折飞梭齿，似说先齐举案眉。\n不信侯门深似海，水流红叶谩题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题邹次魏青藜堂","author":"孙觌","text":"读书非贵嗜，吾子喜欲迷。\n十年费膏火，群嘲笑书痴。\n磊落载五车，望海无津涯。\n双瞳如秋月，一出照耀之。\n冥搜理窟邃，妙解锯屑霏。\n胸中九云梦，百怪见然犀。\n拊枕出鸿宝，铸金侔袅蹄。\n神光发中夜，太乙秉青藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静老容安庵二首 其一","author":"孙觌","text":"离离风中花，深落任所之。\n泛泛水中萍，流转复在兹。\n静公湖海士，世网那得縻。\n独有铁石心，不与燥湿移。\n巢肩统灵鹊，支床馀老龟。\n区区了官事，应解笑儿痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静老容安庵二首 其二","author":"孙觌","text":"云嘘翠扑肤，山拥青入户。\n祗树给孤园，桃源武陵路。\n一从振履还，不复乘杯渡。\n倚墙扪虱坐，挥弦送鸿去。\n水涵楼影交，风敛花气度。\n把茅便有馀，不必黄金布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静老通幽轩","author":"孙觌","text":"诸峰倚崔嵬，众壑隐奔峭。\n寓目欣有系，会心领其要。\n开庐结茅竹，伐翳斩蓬藋。\n此君亦可人，玉立尽娟妙。\n风酣翠相倚，月吐青自照。\n窈眇非世音，鸾鹄中夜啸。\n烟尘闇北关，烽火被南徼。\n便欲老三闾，终焉隐屠钓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦秋怀二首 其一","author":"孙觌","text":"白汗翻浆浃背流，清飙一扫破除休。\n枫江湛湛冰壶月，梧井团团玉露秋。\n蚁动巧闻床下斗，驹跳首向隙中留。\n南山危坐高棱见，杞国区区岂我忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦秋怀二首 其二","author":"孙觌","text":"愁边种种关心事，客里纷纷见俗情。\n雁拆西风离思乱，鸟啼残夜旅魂惊。\n江河风景悲南渡，家室仓皇问北征。\n沧海横流安税驾，一桴从我任平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜三首 其一","author":"孙觌","text":"山寒蔼瞑姿，枫老带涨痕。\n兰摧桂亦折，往往归其根。\n万籁各收声，一气中自存。\n鼻斤无可斲，尻驾不复奔。\n孤光照独夜，月落低金盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜三首 其二","author":"孙觌","text":"金气天与高，灯烬宵正繁。\n暗蛩露下绩，潜虬浪中翻。\n幽人醉清夜，一笑空罍尊。\n遇胜独心诣，了了见目存。\n但忧儿辈觉，难与俗人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜三首 其三","author":"孙觌","text":"寥寥犬吠村，微月耿黄昏。\n鸡豚市井空，虎豹窟宅尊。\n元龙百尺楼，独卧谁与论。\n酒圣且复中，愁魔自惊奔。\n弹铗归去来，稚子候柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴 其一","author":"孙觌","text":"云族正南鹜，日车遂西沈。\n倚楼孤客恨，伏枕故园心。\n唧唧虫造哀，交交鸟遗音。\n危坐百感集，我何念之深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]