[{"title":"次韵王待制游东坡留题十一绝 其三","author":"喻良能","text":"五年同社乐田神，一扇西风障庾尘。\n文采风流千古事，野人恨不识天人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其四","author":"喻良能","text":"赤壁奴台视白楼，五言端的胜苏州。\n政缘不得文章力，故许江山作意游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其七","author":"喻良能","text":"前代乐天今复见，后身元亮更何疑。\n百年人物有谁在，千古声名无尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其十","author":"喻良能","text":"雪堂风物渺江村，行客悽迷欲断魂。\n不见当年谪仙面，空馀春柳典型存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其六","author":"喻良能","text":"对泣何曾学楚囚，扁舟时作大江游。\n眼看西蜀三千里，身在淮南第几州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制游东坡留题十一绝 其二","author":"喻良能","text":"当年随意乐江天，句句新诗尽可传。\n事业文章两俱美，先生兼比二公贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制题予庐山记后二绝 其二","author":"喻良能","text":"山阿诗刻照云松，到处逢人问我公。\n白傅苏仙名不灭，公名今在两贤中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王待制题予庐山记后二绝 其一","author":"喻良能","text":"曾到匡君住处山，始知身在五云间。\n吟毫挥尽无佳句，空遣奚囊捆载还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶宰植竹四绝 其三","author":"喻良能","text":"谁云青士太无情，偏结骚人冷淡盟。\n不假遥岑分寸碧，故应双目自增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶宰植竹四绝 其一","author":"喻良能","text":"檀栾节目瘦长枝，晴既萧骚雨亦奇。\n谁道此君惟澹泊，细看频赏自多姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶宰植竹四绝 其四","author":"喻良能","text":"木本曾看烟雨梢，临窗依砌韵偏高。\n可怜不入繁华眼，祇称清谈王马曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶宰植竹四绝 其二","author":"喻良能","text":"苍烟翠雾两冥迷，秋雨丛深不作泥。\n冷叶寒枝须管领，亭亭会见拂云齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朱昂仲见寄一绝","author":"喻良能","text":"使君诗酒日娱嬉，燕寝新来一段奇。\n政是梦熊佳节里，释迦抱送宁馨儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何茂宏见寄","author":"喻良能","text":"牧之俯首随缰锁，元亮高情乐里闾。\n樽酒未能供一笑，尺书多谢附双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何茂恭咏玉簪三绝 其二","author":"喻良能","text":"未开黄钿紫冠小，谁与幽人作好秋。\n一笑相看两不厌，翠云堆里玉搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何茂恭咏玉簪三绝 其一","author":"喻良能","text":"金谷坠楼人已远，楼前首饰尚堪寻。\n谁家玉面雪肌女，淡扫蛾眉方称簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李同年诚之见贻之什 其一","author":"喻良能","text":"兄弟同登年亦同，羡君墨妙更文工。\n我惭潦倒头仍白，拟学韩豪一送穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李同年诚之见贻之什 其二","author":"喻良能","text":"笔端洒落谪仙人，况复曾同桂苑春。\n一笑相逢端莫逆，门前洲渚正横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其八","author":"喻良能","text":"一时谈笑总名流，十里西湖恣意游。\n熟醉侧身窥翡翠，狂歌左手把蝤蛑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其五","author":"喻良能","text":"忆昔孤山和靖家，光风霁月总输他。\n几多水草连烟草，无限蘋花杂藕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其三","author":"喻良能","text":"裴园亭榭水之滨，草树云烟满目横。\n尽日对山仍把酒，兹游绝胜若耶行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其七","author":"喻良能","text":"湖堤楼阁剧蜂房，楼上争看湖上航。\n万柄芙蓉清冉冉，临风新折麝脐香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其一","author":"喻良能","text":"湖波万顷泻镕银，妙句谁能敌李绅。\n桡影缓随红蓼岸，荷香细著白纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其四","author":"喻良能","text":"与世从来最阔疏，年来况复味潜虚。\n漆园不嗜濠梁乐，人自人兮鱼自鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其二","author":"喻良能","text":"萧萧竹径细通幽，小刹明窗瀹茗瓯。\n夏木阴阴可人处，黄鹂飞上碧枝头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其十","author":"喻良能","text":"湖边幽胜满青莲，到处时时泊画船。\n竟日涟漪吟不足，欲归重看水中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其九","author":"喻良能","text":"袢暑浑如深甑炊，凉飔一饷最先知。\n凭谁为觅丹青手，画我谈诗剥芡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨廷秀郎中游西湖十绝 其六","author":"喻良能","text":"谁云骑马似乘船，摇曳中流即水仙。\n香绣几屏波底影，烟绡千幅望中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈侍郎李察院潇湘八景图 平沙落雁","author":"喻良能","text":"江南云水蓼花洲，中有飞鸿巧自谋。\n过尽关山都不住，直须来趁楚江秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈侍郎李察院潇湘八景图 江天暮雪","author":"喻良能","text":"群山总入玉壶中，只有沧波映远空。\n独钓寒江晚来雪，凭谁画我作渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈侍郎李察院潇湘八景图 洞庭秋月","author":"喻良能","text":"洞阔乾坤日夜浮，月明天净最宜秋。\n何人独卧清风里，万顷烟波一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈侍郎李察院潇湘八景图 渔村落照","author":"喻良能","text":"乱山深处水边村，小艇初归未掩门。\n吹火煮鱼倾浊酒，半规斜日照黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈侍郎李察院潇湘八景图 潇湘夜雨","author":"喻良能","text":"平生云梦泽南州，秋思春情浩莫收。\n更听潇湘夜深雨，孤篷点滴替人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林参议致甫以诗见索近作","author":"喻良能","text":"朝行款接已弥年，会府重逢意豁然。\n好酒未容千日醉，恶诗不必万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑季远国录贤良题余庐山诗记 其一","author":"喻良能","text":"青鞋忆昔到庐山，回首清游梦寐间。\n忽见广文奇绝句，十年风雨唤仍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵十太尉留题驿亭绝句","author":"喻良能","text":"青衫憔悴鬓毛苍，还记并州旧葛强。\n楚尾吴头秋驿好，喜闻嚼麝笑谈香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵景明初见梅花","author":"喻良能","text":"不解何郎五字诗，年年长是探梅迟。\n未甘辜负春消息，强拟来看竹外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭删定观潮四绝 其二","author":"喻良能","text":"天池潮汐渺难推，何事多盈亦有亏。\n生长涛渊头纵白，问之消息莫能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭删定观潮四绝 其四","author":"喻良能","text":"身到钱塘江上初，端如碧海挂新图。\n不知洗眼观潮日，豁得平生俊气无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭删定观潮四绝 其一","author":"喻良能","text":"白浪初看云出门，惊涛旋见大江奔。\n不因江海雷霆斗，安识蛟龙窟宅尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郭删定观潮四绝 其三","author":"喻良能","text":"忆昔初为总角儿，年年秋后厌旌旗。\n只今廓廓浑无事，樽酒何妨乐圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅花绝句","author":"喻良能","text":"玉裙练帨清无尘，一笑唤回幽谷春。\n天寒日暮故相恼，不怕近前丞相嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄三以诗分送笋","author":"喻良能","text":"此君稚子别经年，忽到茅斋意豁然。\n自愧清贫馋太守，尝新翻在小春前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵槐卿舅诗寄石榴","author":"喻良能","text":"细高风物总幽奇，朱实离离瘦玉枝。\n居士既为东道主，文人休勒北山移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵夔府王待制寄示巫山图","author":"喻良能","text":"碧嶂嶙峋夔子国，白云缥缈昭君乡。\n平生不识巫山面，今日巫山到眼傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池边树","author":"喻良能","text":"砾索池边树，疏花照浅清。\n虽无却月观，且有一枝横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池阳报恩寺新成轮藏应公出示鲍仲山诗因赠","author":"喻良能","text":"招提雄冠浦边州，宝藏琅函眩电眸。\n更出故人奇绝句，相看知是赞公流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹岩","author":"喻良能","text":"怪石谁雕斲，苍萝翠木斜。\n幽岩画屏倚，却忆柳州誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老僧携筇竹杖来试就求之欣然举以见赠","author":"喻良能","text":"万里携来自蜀州，老僧珍重许谁求。\n相逢举赠宁无意，要我云山处处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自入新安境中鸭脚千树罗生道傍秋实离离低拂行客顾之欣然因成绝句","author":"喻良能","text":"离离秋实压枝柔，带露含烟烂不收。\n须信新安生鸭脚，大胜霅水熟鸡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自题端溪砚","author":"喻良能","text":"吴兴青石今无闻，歙郡刷丝端可焚。\n儒生谁是喜书者，安得一逢王右军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至德","author":"喻良能","text":"至德春山紫翠堆，楚东征吏又重来。\n是中正好觅佳句，扪腹自怜无此才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何逊梅花诗云枝横却月观林和靖云水边篱落忽横枝又云疏影横斜水清浅是或一律也亦好园江梅一株枝横丈馀作平坛凿小池于其下坛池初成榜曰横枝喜而赋诗","author":"喻良能","text":"却月枝横淮海初，水曹句法到西湖。\n横枝影瘦池清浅，奇绝何人作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馀干资福寺岩桂盛开因折一枝戏成绝句","author":"喻良能","text":"绿玉枝头金粟团，可人风味胜红兰。\n一枝携向金溪去，袖里谁知有广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到庐山","author":"喻良能","text":"匡庐山水甲南州，况是曾经靖节游。\n眼底总堪供赋咏，新诗不碍细雕锼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县斋夜坐","author":"喻良能","text":"鹜行散尽室如冰，数卷残书一穗灯。\n尚有茹荤兼饮酒，不然全似打包僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴越王庙","author":"喻良能","text":"五季流民去不还，赖君抚有此江山。\n嫌名举世犹知避，何况来瞻庙貌间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中即事二绝 其二","author":"喻良能","text":"风劲木初落，霜轻花更幽。\n晴香山苦马，冷艳水牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园中即事二绝 其一","author":"喻良能","text":"锦园无十亩，缓步足登临。\n弄月波涛细，爱山花木深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弄月亭","author":"喻良能","text":"掬水弄涟漪，清辉碎更随。\n人间无太白，欲捉可凭谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弄水亭次李察院韵","author":"喻良能","text":"清溪一曲抱危亭，天水无尘相与明。\n昔日紫微今御史，两翁诗句一般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张持荷以二诗见贻不敢虚辱次韵奉酬 其二","author":"喻良能","text":"南湖一似锦江园，秀句端宜入杜编。\n想得公馀时步屧，清风明月不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张持荷以二诗见贻不敢虚辱次韵奉酬 其一","author":"喻良能","text":"南湖骑马似知章，熟醉清吟锦瑟傍。\n不分鹜行遮电眼，偷閒检校水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张持荷以诗见约同沈无隐赏梅因得绝句奉谢","author":"喻良能","text":"结斋风味如和靖，况有凌风百尺台。\n雪霁春新多办酒，两翁乘兴欲寻梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀王侍郎刘秘监","author":"喻良能","text":"平生西蜀刘中垒，四海东嘉王右军。\n三载相思千里梦，何时把酒听论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀东嘉先生因诵老坡今谁主文字公合把旌旄作十小诗奉寄 其八","author":"喻良能","text":"三让始循墙，一麾尝屡把。\n夔门德政碑，深镵仍大写。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀亦好园钓矶寄仲文季直二弟","author":"喻良能","text":"磬湖雨过漾清波，古岸秋来长薜萝。\n问讯石君无恙否，试烦著手为摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀爱山","author":"喻良能","text":"空陂流水淡泠泠，小立舂锄点远汀。\n烟雨半收山更好，知谁不唤作丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮茶","author":"喻良能","text":"清风生两腋，雪乳啜云团。\n便拟乘风去，翻嫌缚小官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏月","author":"喻良能","text":"何年玉斧巧修成，半似明生半魄生。\n易使飞乌来匝绕，难将老蚌较亏盈。\n桂枝不逐秋风老，水影长随夜气清。\n曾是广寒宫里客，旧游重访更含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏梅","author":"喻良能","text":"竹外江头带雪看，花中清绝画应难。\n玉肌瑩骨冰姿瘦，单著生绡怯暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孟秋七日邀从兄廿五宣义四弟五侄同饮锦园即席之作","author":"喻良能","text":"湖水林风清复清，买肴置酒七峰亭。\n直须待得玉钩挂，要看牵牛织女星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"定泉","author":"喻良能","text":"兹泉定力冠诸泉，故向空山独湛然。\n终日虚明无一物，客来惟见浪痕圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂 其一","author":"喻良能","text":"粟粟枝头浅浅黄，十分风味百分香。\n广寒宫殿清秋里，掠削云鬟试靓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂 其二","author":"喻良能","text":"枝头金粟色偏匀，空里非烟气自薰。\n莫把白旃檀漫比，香浓犹得逆风闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩桂 其三","author":"喻良能","text":"水沉风味郁金黄，风定犹闻十里香。\n造物普令薰一切，故应五浊暂清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]