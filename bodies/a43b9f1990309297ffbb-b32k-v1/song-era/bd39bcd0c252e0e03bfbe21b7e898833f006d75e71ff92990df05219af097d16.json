[{"title":"次韵推官东庵","author":"韦骧","text":"紫竹交阴处，微行接小轩。\n辘轳声在井，薜荔翠依垣。\n自有山林趣，何妨鸟雀喧。\n公馀聊宴坐，方寸得澄源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步云亭","author":"韦骧","text":"官居潇洒并城壖，城上危亭势屹然。\n庨豁四檐通日月，回环千里见山川。\n凌虚迥绝寻常地，据要追吟尺五天。\n莫讶白云随步起，望中祠宇指梅仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和李世美再题步云亭","author":"韦骧","text":"峣峣气势压南闽，彷佛鹏程近紫氛。\n女堞却依丹槛底，翚檐迥与碧霄分。\n融樽有地留清景，阮屐无时蹴乱云。\n引脰更劳西北望，子牟驰恋继朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和世美久雨枕上偶成","author":"韦骧","text":"釜中何虑致鱼生，庭下宁论辍运瓴。\n夜厌繁声惊梦枕，朝愁润色浥书屏。\n无聊搔首怜垂白，遣兴题诗写杀青。\n此段公居正岑寂，还如旧隐掩柴扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和久雨","author":"韦骧","text":"继月霖霪势不停，淙淙高屋似翻瓴。\n气昏亭阁迷仙境，云闇山川掩画屏。\n垄麦潜忧化蛾白，溪荷遥想没钱青。\n占晴问蔡师前语，罄折恭于奉鼎扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴","author":"韦骧","text":"积雨锁山城，幡然喜晚晴。\n园林变新绿，沟浍有馀声。\n日色间何阔，云阴否已倾。\n无才希杜赋，短句且纾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红蕉","author":"韦骧","text":"红蕉秀南土，对植燕堂阴。\n每为开青眼，唯怜吐赤心。\n华丹天赋异，彫瘁岁寒深。\n拟夺兰荃誉，慇勤约共吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公舒题步云亭","author":"韦骧","text":"缔构岧峣倚碧空，建安气象瞩清雄。\n自矜远目穷天末，更喜新篇入彀中。\n坛指升仙叹梅福，山连梦笔想文通。\n梯云每到如平地，养勇何须羡北宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月三日见萱草一枝","author":"韦骧","text":"薄薄初阳晓雾披，庭萱再见似相知。\n月临仲夏才三日，风折今年第一枝。\n蘤剪兼金黄灼烁，干瑳圆玉碧参差。\n韶华来岁应如旧，知在何州记此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和世美吉祥为别","author":"韦骧","text":"山驿迢迢畏景舒，星轺不肯少踌躇。\n先之古寺图分袂，故约前驺幸柅车。\n雾卷茗瓯分啜罢，风收谈麈赠言馀。\n虽知暂别非踰月，尚觊邮筒数惠书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵庆除代","author":"韦骧","text":"一封黄牒下云头，受代需时若自谋。\n虽幸有期趋北阙，自惭无术惠南州。\n累年尘土甘祗役，万里烟霄想告猷。\n犹赖高材见禆助，不教孤迹谩淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去冬留题管节堂世美朝请今夏按部过之为诗见贲辄次韵奉和","author":"韦骧","text":"拙句惭先刻，佳章幸继游。\n褒题踰八字，传咏入中州。\n舍馆仍增丽，时炎倏变秋。\n悠悠想清思，长似建溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世美朝请贤友近按昭武还宠示道中杂诗十三首因成拙句奉呈","author":"韦骧","text":"冲蒙盛暑历山川，肤使何尝叹独贤。\n星骑逡巡一千里，仙才洒落十三篇。\n笼罗绝顶裁诗句，摅发高情破万缘。\n但恨阳春难继和，暗投终辨夜光圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔子","author":"韦骧","text":"闽地高材最杰然，结成丹荔冒炎天。\n堆盘火齐光芒转，溜齿琼浆气味全。\n玉井莲房空赋咏，秀江萍实谩流传。\n更咍蜀品烦驰传，闇向红尘动笑妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月上浣登步云亭","author":"韦骧","text":"一日优閒九日忙，步云亭上共翱翔。\n地高始觉秋风劲，事隙方知昼景长。\n戏举禅谈一重案，静看茶战第三汤。\n吾民况有京坻望，远宦宜从啸咏忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜雨","author":"韦骧","text":"秋色中分夜气清，月华今夕最澄明。\n如何骤雨横来势，不徇高楼倚望情。\n桂子飘零无处觅，烛花煇燄为时生。\n莫辞尽醉酬佳节，犹觊馀光接晓晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公舒朝请得福守所寄荔子佳品二而咏以二诗乃以为示辄次韵奉和 其一","author":"韦骧","text":"邻境缄驰荔子丹，黄堂矜诧满雕盘。\n香收残爇馀龙脑，笺写新诗掩凤团。\n咀嚼定嫌琼液薄，形容更比水精寒。\n强抽滞思聊追和，珍果清吟两可欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公舒朝请得福守所寄荔子佳品二而咏以二诗乃以为示辄次韵奉和 其二","author":"韦骧","text":"佛宫奇品号磂黄，黄縠笼珠径寸光。\n种异却轻萍有实，味甘全胜蔗为浆。\n南人拭目惊稀见，北客流涎试一尝。\n翻笑洞庭霜后橘，岂能当暑侑持觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建安郡庠重彩记事","author":"韦骧","text":"泮水秋深爽气全，簪绅戾止共拳拳。\n丹青图写三千礼，藻绘形容七十贤。\n如堵聿来观盛集，采芹应有赋新篇。\n诸生好进公卿业，此日风流亦与传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日示寿隆 其一","author":"韦骧","text":"九日闽中气尚暄，扶持病体坐家筵。\n喜看数朵黄金菊，强引三分白玉船。\n浮世谩论轩冕贵，佳辰难遇子孙圆。\n明年汝对陶公菊，应念欣欣戏綵前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日示寿隆 其二","author":"韦骧","text":"建安山水亦几希，九日登高著处宜。\n秋杪风光自潇洒，老来情味少欢怡。\n举杯喜见黄花泛，落帽羞将白发吹。\n佳节不能成酩酊，浪吟小杜昔年诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题南剑州延平阁","author":"韦骧","text":"危阁横空待胜游，登临尽道冠南州。\n面分列嶂环群秀，坐看双溪会一流。\n斜纳朝晖长易旦，逆消暑气每先秋。\n更传宝剑深潭近，半夜寒光射斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷风阁","author":"韦骧","text":"胜概天成所得偏，一来登览兴飘然。\n拂云栏楯尘寰远，隔水楼台画幅全。\n隐隐归舟摇落日，悠悠飞鸟破孤烟。\n冷风可御非虚目，况是层峦对演仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题尤溪县林平铺壁","author":"韦骧","text":"前岁方离蜀道难，崎岖今日过黄山。\n自嗟使事殊无补，祇向尘途历险难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黯淡滩","author":"韦骧","text":"慎操舟楫度危滩，脱险从安反掌间。\n岂似俗流争利达，难防笑貌伏波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将到富沙寄世美同事","author":"韦骧","text":"判袂于今涉五旬，驰驱无复寓书频。\n险途顿失往还倦，高谊却忻朝夕亲。\n近事欲蕲祛蔽塞，新吟应许和清纯。\n富沙此去无多地，先走诗筒致所陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公舒见示生日诗","author":"韦骧","text":"衰迟何幸枉佳章，远引吾宗及汉唐。\n户挂桑蓬当日喜，毫挥珠玉此时光。\n欣临爱景披辞藻，怯向清飙动鬓霜。\n松柏由来交茂悦，愿回善颂岁寒芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李世美见寄兼送推官宰彭泽","author":"韦骧","text":"北风传晓角，宿雾锁寒城。\n秣马登途早，将雏振羽轻。\n一经承祖训，百里儆官成。\n多谢龙门秀，贻诗壮去程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和道中书事奉怀","author":"韦骧","text":"同日分携去，先期掉鞅回。\n驰情随道远，残岁怯春催。\n客舍惊新柳，山城叹落梅。\n佳篇慰翘望，还驭过王台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘守正月十日新茶","author":"韦骧","text":"乳雾浮浮啜新茗，祇疑春自壑原来。\n开筵人日踰三昼，试焙申年第一杯。\n首面光肥香已透，辅车津润味全回。\n不须七碗清风至，满盏依稀在楚台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和正月十七日携具见约","author":"韦骧","text":"远宦随时且自娱，看看受代又脂车。\n燃灯初过忘岑寂，极目相从接绪馀。\n瘴雾催花锦零乱，春风吹鬓雪稀疏。\n追怀古语成新咏，万事无非酒破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和","author":"韦骧","text":"著处山川秀可娱，何妨投隙数驱车。\n韶华已过三分一，岁律才经半月馀。\n北海樽罍虽自满，东阳篇咏不宜疏。\n惟愁南国春多雨，谁把繁阴为扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和世美以前韵惠诗","author":"韦骧","text":"东亭清集幸相娱，暮角声休尚柅车。\n冷淡莲光灯夕后，微茫桂魄雨天馀。\n交谈自喜高情合，投老还嗟乐事疏。\n况是离怀起朝夕，好凭樽酒豫驱除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南园正月二十三日见牡丹因剪分送而公舒太守以诗为报遂次来韵","author":"韦骧","text":"上元八日冒轻寒，剪送南园两牡丹。\n为我果能兴绝唱，知君不作等閒看。\n香馀雕槛春犹浅，咏入华笺墨未乾。\n更说僧坊曾寄植，纵观须待解征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和世美行役不与贡第一茶","author":"韦骧","text":"采凤团龙贡紫宸，今年斗柄仅离寅。\n四千里望中天阙，第一番题北苑春。\n拜表尽恭初遣使，乘轺还念未归人。\n太平岁集梯航献，山岳何如此效珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和督决囚","author":"韦骧","text":"旰食忧民睿思焦，默怀时雪滞层霄。\n十行新下宽囚诏，诸道交驰奉使轺。\n缧绁稀疏至恩浃，旄倪欢感大钧调。\n宣扬德泽惭绵弱，但采尧民击壤谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘守以诗约赏南园牡丹","author":"韦骧","text":"閒花浪蕊谩芬敷，满槛妖韶体自殊。\n且看淡红随分有，须知绝品此中无。\n剪愁魏国掺掺手，辨怯齐门一一竽。\n已扫幽亭待清赏，更烦佳句预相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别刘公舒","author":"韦骧","text":"间关杖节使全闽，何幸邦侯遇故人。\n谈笑一樽时得暇，讴歌千里政如春。\n解携白发情非昔，赠别清篇思入神。\n却想萍踪流未远，会看飞诏趣朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出闽境永丰道中","author":"韦骧","text":"去暮愁行泗州岭，清晨喜见江东山。\n二年巡按劳南走，尽室安全庆北还。\n负弩兵回喧渡口，插秧人看立田间。\n却嗟奉使无禆补，征返徒添两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中闻莺","author":"韦骧","text":"栖止垂杨最上枝，绿丝深罩郁金衣。\n也知行客留心听，弄尽新声始肯飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水碓","author":"韦骧","text":"杵臼功能自古施，更堪引水代人为。\n谁知满溢倾攲处，却是临机效力时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滕龙图挽词","author":"韦骧","text":"践历清华四十年，老成忽逐逝波迁。\n盐梅未展和羹效，裘带终淹分阃权。\n忠义长为古人比，功名固有史臣传。\n不材曾附风雷末，远寓哀辞倍泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙圣微同年赴浙漕 其一","author":"韦骧","text":"当时折桂共云梯，四十馀年迹久睽。\n白首为郎方接武，绣衣出使又分携。\n放船汴水寒犹浅，跋马都门日欲低。\n远想清风播仁闻，融融先满浙东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孙圣微同年赴浙漕 其二","author":"韦骧","text":"雄胜东南越与吴，光华使节暂驰驱。\n比年郡邑多疲俗，今日朝廷用老儒。\n固有风声镇媮薄，何妨膏泽慰焦枯。\n公馀且尽登临兴，严召终难缓走趋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张大资挽词 其一","author":"韦骧","text":"峥嵘仪貌国辉光，曾与明堂作栋梁。\n颛面钜藩方偃息，间生英气忽飘扬。\n文章绝笔星辰晦，德业遗芳简册香。\n不以修龄畀贤杰，伤嗟无处问苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张大资挽词 其二","author":"韦骧","text":"熙载功成鬓未华，蕃宣屡易见褒嘉。\n凤池旧别经年久，鹤驭新乘去路赊。\n哀挽声悽霜月冷，铭旌影转晓风斜。\n故山归葬依先垄，千古悠悠贤世家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫和中刑部致仕归吴兴","author":"韦骧","text":"司刑华省健精神，容易飞章便乞身。\n未老先休多有志，似君勇退几何人。\n安车渐远京尘路，归棹仍追霅水春。\n而我区区尚持禄，自惭乡境谩为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行太皇太后挽词 其一","author":"韦骧","text":"德业高千古，忧勤尽九年。\n捲帘将复辟，弛卫忽登仙。\n饮泣均中外，流恩在幅员。\n春风低挽唱，幽咽厚陵边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行太皇太后挽词 其二","author":"韦骧","text":"临朝扶圣治，盛烈掩姜任。\n寿享尧龄浅，哀添舜慕深。\n灵衣粲翚翟，谥册刻球琳。\n仰望轩星晦，悽愁万国心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公仪郎中对雪","author":"韦骧","text":"九陌尘埃变玉沙，云中双阙陋仙家。\n丰年欲启三登兆，大巧先裁六出花。\n高卧洛阳逢汲引，雄文梁苑动吁嗟。\n郎闱自愧徒温饱，坐拥炎炉叹岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘公仪省宿呈同舍","author":"韦骧","text":"夜宿冰厅愁解衣，南宫正是苦寒时。\n窗含积雪犹明几，炉拨残煤始捲帷。\n无所忸怩当俯仰，不须容易叹衰迟。\n更为佳句贻同舍，使我挥毫羡色丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次夕宿省再用前韵呈同舍","author":"韦骧","text":"凛烈寒威著寝衣，中台独宿夜分时。\n郎潜已叹斑冯鬓，幼学空思下董帷。\n直舍孤灯生晕浅，禁垣清漏送声迟。\n何年追语今宵事，笑向江湖理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次韵和公仪所示","author":"韦骧","text":"匆匆下马脱朝衣，夜直仪曹岁晏时。\n香穗萦回清一榻，烛花明媚耀重帷。\n诗成白雪音难和，梦断黄粱熟已迟。\n见说迟明还剡奏，恳求宫钥待言丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和公仪索和诗","author":"韦骧","text":"唱酬三峡浪飞花，敏捷曾蒙秀句誇。\n为感来篇惊岁暮，因成阁笔待春华。\n见斑固已惭窥豹，失酒当须鉴画蛇。\n鄙思强抽追险韵，还如策蹇度褒斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和忆小园梅花","author":"韦骧","text":"为忆新梅发旧枝，勇操吟笔对晴晖。\n幽香不到青绫被，冷艳应迷白羽衣。\n忽忽屡经春色改，纷纷或傍笛声飞。\n祗疑渴想高情剧，频向冰厅有梦归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和喻明仲题纯粹大师虚一轩诗","author":"韦骧","text":"闻说琳公最佳处，榜题虚一一轩清。\n逍遥羽客真高隐，旷达星郎肯谩名。\n琴挂无弦藏至乐，炉存微火锁长生。\n未能投步资閒适，聊和新诗托寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和陈图南见喜权金部","author":"韦骧","text":"绿槐经午转庭阴，投隙相过省闼深。\n且喜清谈共挥麈，莫嗟白发各盈簪。\n邻曹暂幸联官乐，兼局那辞冗事侵。\n更辱高吟叙情旧，侑欢何必浊醪斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵","author":"韦骧","text":"诗将争功定绎骚，堂堂风格等刘曹。\n高情迭唱通三叹，险语相先较一毫。\n酷暑俄惊变潇洒，噪蝉何敢助雄豪。\n嗟予老拙慵牵强，养勇终怜不目逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孔彦常待制赴宣城","author":"韦骧","text":"宣城从古号名城，新拜除书拥旆旌。\n剡奏屡传求外补，偃藩暂得遂高情。\n虎符南国先声重，鹢首秋江去意清。\n最好笳铙将压境，敬亭山色远相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和义夫学士用其韵","author":"韦骧","text":"开府南陵气序秋，翠屏千垒对岑楼。\n力宣膏泽均千里，坐赏溪山冠十州。\n小谢篇章耐吟讽，谪仙踪迹自风流。\n公馀好尽登临兴，应诮区区宋玉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡右丞挽词","author":"韦骧","text":"右辖辞荣重寄分，却趋召节造天阍。\n表仪八座方尊德，悃愊连章乞偃藩。\n将见辨严离凤阙，忽传感疾自鸰原。\n公薨不及期颐寿，至理冥冥岂易论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邓左丞开府挽词","author":"韦骧","text":"术学材猷间世资，进登丞辖仅踰时。\n寿非德称天何吝，命与心违古所悲。\n一品衰荣加赠典，九重震悼辍班仪。\n灵舆还葬从先垄，呜咽秋风薤露辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和盛中叔侍郎斋宿唱酬","author":"韦骧","text":"谁谓南宫夜直频，宿斋清集迥难亲。\n翼朝唯幸窥新什，三纪尤欣叙古人。\n共庆球琳已华国，独惭樗散谩先春。\n更将鄙句追诗战，盖耻韬弓托负薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尝进酒","author":"韦骧","text":"昔年北苑试龙茶，似陟云霄饮露华。\n今日礼曹尝御酒，又疑尘迹到仙家。\n自知衮衮官身幸，莫向区区俚耳誇。\n此段出于尸禄外，支离形体更何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栅山驿早起","author":"韦骧","text":"栅山孤驿夜寒清，襆被㸐柴坐迟明。\n行旆动时红日上，肩舁经处白云生。\n连峰峭怪浓铺翠，流水盘纡数送声。\n自喜区区王事外，纵观佳境有馀情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]