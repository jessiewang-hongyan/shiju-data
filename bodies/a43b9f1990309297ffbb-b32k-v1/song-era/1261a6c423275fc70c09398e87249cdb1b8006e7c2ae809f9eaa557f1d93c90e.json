[{"title":"敷文阁学士李仁甫挽词十绝 其五","author":"周必大","text":"鸣佩甘泉不乏人，谁能博古复通今。\n直如汲黯非游侠，忠似更生不铸金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敷文阁学士李仁甫挽词十绝 其六","author":"周必大","text":"千卷长编已刻闽，争传副墨价兼金。\n冠篇不得同迂叟，遗恨犹应记玉音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敷文阁学士李仁甫挽词十绝 其四","author":"周必大","text":"频驾輶轩析左符，直从梁益到江湖。\n棠阴处处留遗爱，芹泮人人忆大儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敷文阁学士李仁甫挽词十绝 其三","author":"周必大","text":"经学渊源史笔高，文章馀力埒风骚。\n纷纷小技誇流俗，磨灭身名笑尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敷文阁学士李仁甫挽词十绝 其一","author":"周必大","text":"万古仇池一老仙，前身游宦忆西川。\n令威化鹤空千岁，何似重来十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敷文阁学士李仁甫挽词十绝 其十","author":"周必大","text":"我畏讥谗口屡缄，独公嗜好不酸咸。\n每倾苦酒思谈笑，万里何由奠巽严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘讷画赵韩魏王文潞公司马温公欧阳文忠公王荆公苏文忠公黄太史像","author":"周必大","text":"勋业文章各致身，精神未易写丹青。\n八朝三百年间事，付与承明著作廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题安成刘江报德堂白爵图","author":"周必大","text":"孝行通穹壤，珍祥应鼓枹。\n是家飞白爵，谁子泥青乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题耸寒图二绝 其一","author":"周必大","text":"浪传魁梧越沧溟，过誉清夷得好铭。\n今见画图寒乞甚，心声心画果难形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题耸寒图二绝 其二","author":"周必大","text":"道山仙圣典刑真，原庙功臣剑佩新。\n归掩柴门无此梦，撚须画腹对斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠栖贤藏主可升","author":"周必大","text":"我比同年百不能，只馀霜鬓愧师兄。\n慇勤觅句无言说，共拨寒灰听水声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠崇寿寺僧善修","author":"周必大","text":"老僧九十视眈眈，二十年来不下山。\n我得九华充法供，亦能禁足老山间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠黄格非","author":"周必大","text":"诗社飘零二十年，春官老子复登仙。\n豫章幸有横枝在，好觅鸾胶续断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣守郑舜举寄诗酒于答书中就附四句","author":"周必大","text":"十七篇诗酒满壶，赣州风景塞绳枢。\n诗中有画今摩诘，安用当年八境图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赣州丰乐长老惠宣写予真戏赞时年七十三","author":"周必大","text":"少年日醉郁孤台，鼎立三禅屡往来。\n豪气虽存谁复识，形容变尽鬓皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁巳二月甲子蜀锦堂海棠盛开适有惠川绣昼锦堂记者招伯威德源为齐年会次旧韵","author":"周必大","text":"曾因客梦到西川，万户疏封祇隔年。\n花重锦官思杜老，鹤飞沙苑看徐仙。\n衰颜尚许任争齿，浅量深惭赐及肩。\n照眼蜀妆依绣幌，共惊十载谶先传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十五日邦衡用前韵送薰衣香二贴次韵为谢","author":"周必大","text":"天香犹带曳裙霞，银合行参到阙茶。\n剩馥欲沾吾臭味，普薰聊发善萌芽。\n心清此去誇僧舍，意可由来出内家。\n乞与博山添正气，崭岩曾辱更生嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十四日江西美约周愚卿兄弟及许景阳相过共观鹤雏羽毛褐色因饮食双投新酒擘闽中新荔放白莲池上遂成胜赏明日西美有诗走笔奉和","author":"周必大","text":"起来汗浃似翻浆，客带清风变早凉。\n鹤子曳衣犹浅褐，鹅儿对酒已深黄。\n白莲近揖三千女，丹荔遐招十八娘。\n但把槐忙付年少，不妨老伴燕林塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七兄以庚戌重阳前解江东常平印溯江而归先寄二诗次韵 其一","author":"周必大","text":"早日常同席，中间屡话离。\n吕梁今破梦，曹发共深期。\n菊圃新开径，茅斋正筑基。\n不妨风雨夜，酌酒更论诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七兄以庚戌重阳前解江东常平印溯江而归先寄二诗次韵 其二","author":"周必大","text":"春驾轻车上九华，秋乘大舸溯风沙。\n欲抛彭泽追元亮，何待龙山宴孟嘉。\n行止非关人力胜，清平自有部民誇。\n征帆冲雨何时至，东望牙樯眼屡花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七兄以诗相迎次韵","author":"周必大","text":"昔作匆匆去，今成缓缓归。\n江山苦招隐，鸥鹭信忘机。\n已分渔舟老，还思雁序飞。\n天公知客意，帆饱水生肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七兄初约登新楼作重阳敦前岁之盟适病足不能出佳篇送鱼酒且及二苏逍遥堂风雨之句次韵叙谢并为后约","author":"周必大","text":"遍走三台一日中，前年乐事转头空。\n新楼期对萸并菊，旧约翻吟雨与风。\n鱼绕长江殊有味，酒篘大瓮浩无穷。\n登临何必拘重九，脚力强时信即通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十八日夜忽梦作送王龟龄诗两句枕上足成之","author":"周必大","text":"匈奴何敢渡江东，一士真过万马雄。\n唐室安危谁可佩，雪山轻重属之公。\n天台不纳尚书履，乡县犹乘御史骢。\n行乐休嫌园小小，高歌幸有婢隆隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十六日携家游青原归入阳园酴醾盛开诵子中兄摛云摇碧露繁星之句赋此诗","author":"周必大","text":"偶从山寺赏春还，问讯名花已破悭。\n清绝比梅加馥郁，丰容似菊更妖娴。\n碧云重忆尊前句，红缬遥思醉后颜。\n寒食清明祇旬日，绿斋芍药待君攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十七日葛守钱倅出所和胡邦衡羊羔酒诗再次韵简二公","author":"周必大","text":"德似羊羔春共颁，政如醇酎野多欢。\n属厌靖节杯中物，屡费将军竹里槃。\n畴昔调饥惟饮湿，祗今软饱不言寒。\n唱酬妍丽归公等，自笑梅翁语带酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十五日同兄弟甥侄游西台次子载弟韵","author":"周必大","text":"地饮成真率，天风恕涩悭。\n台临平野迥，人对老僧閒。\n已是寻春至，仍容载月还。\n郊坰有如此，能不数追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二老堂会七兄乐语口号","author":"周必大","text":"早似机云入帝乡，晚如广受出咸阳。\n旧游应忆鱼同队，倦翼还欣雁著行。\n甲子八百九十朔，醉乡三万六千场。\n新阳渐漏春消息，二老风流日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月二十七日刘公度徐用之许相过公度居忧止酒用之偶食素适有饷小春团茶者因成拙诗奉简","author":"周必大","text":"平日何曾忘穆生，如今胡不饮公荣。\n颇嫌性僻嵇中散，为怕情伤阮步兵。\n美意正须羹碧涧，衰颜聊复饭青精。\n更携天上新圆月，同试沙瓶雪水清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次邦衡长子总干韵","author":"周必大","text":"乃公刚鲠迅词章，济美人推小赞皇。\n君实固难安洛汭，子虚亦合荐周行。\n牛屠十九看游刃，媠击三千始滥觞。\n早向秦淮迎辇辂，北征旗鼓正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次邦衡族侄长彦司户韵","author":"周必大","text":"圣世恩荣盛孝章，北窗自欲傲羲皇。\n通家喜燕鸡豚社，治郡愁亲雁鹜行。\n陌上花开人斗草，瓮头酒熟客传觞。\n及时行乐君休厌，召驿相将项背望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次韵二首 其二","author":"周必大","text":"宫槐分影直，官柳著行疏。\n画栋飞翚远，晴霞散绮馀。\n池邀山简马，水胜武昌鱼。\n只恐封泥召，骖鸾上帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次韵二首 其一","author":"周必大","text":"川流元滚滚，客至喜津津。\n卜筑新形势，逢迎旧主人。\n酒杯容我醉，诗句味君醇。\n大隐聊城市，岩耕笑子真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金国贺正旦使副到阙紫宸殿宴致语口号 其二","author":"周必大","text":"绛阙嵯峨映五云，华簪合遝会芳宸。\n尽收残腊严凝气，散作新年浩荡春。\n盏斝频宣恩意重，金丝徐韵乐声纯。\n欲知朝野欢娱处，听取三呼万岁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十八日春华楼前芍药盛开招欧葛二兄再为齐年之集次旧韵","author":"周必大","text":"老去犹思饮吸川，静中还喜日为年。\n艾耆天畀如三寿，谈辨人惊似八仙。\n洞锁嵩峰偏入眼，丹成?嵝远齐肩。\n定知乐事年年共，更看新诗句句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月六日中宫生辰二府例以前四日就孤山四圣观设醮泛舟至玉壶环碧园因记欧阳公治平三年丙午岁上巳和韩丞相诗谓是岁始颁明天历三月三日丁巳故有节正须知凤历新之句今岁亦逢辛巳而又岁皆丙午诚异事也辄借原韵赋诗一篇简诸公","author":"周必大","text":"东华正踏软红尘，却趁西湖祓禊辰。\n历似明天时令正，春逢闰岁物华新。\n流连花柳输豪侠，判断湖山愧隐沦。\n尚拟鸣銮一游豫，还陪英衮奉严宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三次韵答江西美","author":"周必大","text":"菲饮箪壶食与浆，淡交非复世炎凉。\n佳名谁合戎州绿，妙语端由太史黄。\n无怨不须移孔议，有情未可老徐娘。\n荷香袭坐忘归兴，不觉昏鸦影渡塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳访杨廷秀赏牡丹于御书匾榜之斋其东园仅一亩为术者九名曰三三径意象绝新","author":"周必大","text":"杨监全胜贺监家，赐湖岂比赐书华。\n四环自斸三三径，顷刻常开七七花。\n门外有田聊伏腊，望中无处不烟霞。\n却惭下客非摩诘，无画无诗只谩誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与馆中同僚会邦衡侍郎于南山真珠园后两日翰苑作开讲会予不赴邦衡有诗见怀次韵","author":"周必大","text":"讲席人期相郑覃，石渠我忝继齐堪。\n碧琳殿邃同宣召，白玉堂深接笑谈。\n寓直敢陪东道主，登高尚想北山南。\n洞岩胜集空回首，何日芒鞋许再探。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子中兄再示新诗以妃为僭次韵解嘲","author":"周必大","text":"妃即嫔嫱非并后，公卿虽备要严徐。\n黄裳敢僣夫人服，紫袖聊瞻御坐裾。\n石韫山辉元倚玉，媠飞海运本名鱼。\n莫因韩李同佳传，便废千年太史书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己未二月十七日会同甲次旧韵","author":"周必大","text":"里仁初不问山川，身健从交换岁年。\n红紫丁宁容老圃，丹青点化属诗仙。\n情均雁序兼莺友，寿贯犀颅映鹤肩。\n莫算酒行徵罚令，一株花下一杯传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"己未立春留杨伯子知县小酌夜闻窗竹有声伯子以为雪或曰风也已而果雪诘旦敲门送诗走笔戏和","author":"周必大","text":"莫讶衰翁笑口开，故人风度继欧梅。\n堕筛雪阵鱼丽远，蹋迹诗仙凤沼来。\n酒似茅柴居膈上，句如桂子落天台。\n新年春日相追逐，谁谓天公厌两回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广德军鹿鸣燕乐语口号","author":"周必大","text":"才子雍容入帝京，使君劝驾意殊深。\n骑蟾定喜攀仙桂，鸣鹿先须咏野芩。\n好去玉阶方寸近，休辞金盏十分斟。\n明年三月莺花丽，洗眼宫袍宴上林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中奉大夫直徽猷阁致仕邵及之挽词二首 其二","author":"周必大","text":"不殖千金产，惟求十亩园。\n湖山堆几席，花木报寒暄。\n曾是尊前客，常思醉后言。\n怀贤空有泪，无路洒新原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中奉大夫直徽猷阁致仕邵及之挽词二首 其一","author":"周必大","text":"廉甚仍知止，高风似孔戣。\n北归垂橐日，南省挂冠时。\n清白传诸子，安闲阅十期。\n今谁主文字，好继退之碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五次韵","author":"周必大","text":"客嘉合馈五先浆，竹好仍生一味凉。\n天与冰肌胜傅粉，星驰火齐捷飞黄。\n将雏华表疑丁令，唤渡京江忆杜娘。\n屡枉新篇谁可拟，一川烟草贺横塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仆营小圃方两月而张坦夫示腴庄图有起予之意辄成鄙句","author":"周必大","text":"百年种德十年栽，映带云岩与月台。\n无问四时留客醉，何曾一日不花开。\n人人争羡富登览，物物岂知工剪裁。\n我比樊须身更老，只今学圃亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从驾过德寿宫马上得程泰之次庚寅玉堂旧韵有银章金带之戏走笔为谢","author":"周必大","text":"推敲也复从鸣銮，凤沼诗盟故未寒。\n两制空烦舍人样，外郎争比大夫官。\n翰林今夜仍连直，讲殿明朝岂两般。\n毕竟五金如五味，莫因黄白议咸酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元枢陈叔达挽词二首 其二","author":"周必大","text":"联事麟台里，论心鹤禁中。\n贤愚虽有异，出处不无同。\n解后桥山日，凄凉浙水风。\n儿孙看竞爽，门户庆方隆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元枢陈叔达挽词二首 其一","author":"周必大","text":"淡墨名何早，洪钧转稍迟。\n艺文追伏郑，德业望皋夔。\n寔事常求是，多闻更阙疑。\n斯民先觉者，人代舍公谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元宵煮浮圆子前辈似未尝赋此坐间成四韵","author":"周必大","text":"今夕知何夕，团圆事事同。\n汤官寻旧味，灶婢诧新功。\n星灿乌云里，珠浮浊水中。\n岁时编杂咏，附此说家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内直以金橘送七兄","author":"周必大","text":"昼卧玉堂殿，眼看金弹丸。\n禹包经岁月，郑驿助杯盘。\n黄带霜前绿，甘移醉后酸。\n江湖有兄弟，此日忆团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬戌冬至胡季亨伯信仲威叔贤相过洛花一朵正开置酒赏之王南剑偶遣矮人献笑坐中以开闭长短为戏因成四韵","author":"周必大","text":"霁色舒圭景，寒醅艳玉杯。\n关讥方且闭，国色已先开。\n幸有佳宾客，将何助笑咍。\n共言长至日，底事矮人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太守赵山甫示和篇次韵为谢","author":"周必大","text":"阿娇金屋聚芳菲，当御银环序妾妃。\n龙女坠天頩素颊，鲛人出水织纁衣。\n袖垂户外瞻双引，燕在宫中第一飞。\n不用虫鱼笺尔雅，使君行合左符归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行皇太后挽词二首 其二","author":"周必大","text":"妫汭芳声远，思齐圣德优。\n湘妃初从舜，文母晚兴周。\n养弃慈宁乐，神同永祐游。\n凤车青羽盖，忍望浙江舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行皇太后挽词二首 其一","author":"周必大","text":"瑞应兴沙麓，祥源发狶韦。\n东朝方母育，沧海倏尘飞。\n蟾蝉冰轮影，鳌翻地轴机。\n宸心怀慕处，箧有五时衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文忠烈公居洛有丙午同甲会诗今执政府凡三位枢密使王季海参政钱师魏先在焉前岁夏某忝参预连墙而居适然齐年时号丙午坊次文公韵简公","author":"周必大","text":"文公八十会伊川，盛事于今又百年。\n岂意苍颜华发叟，亦陪黄阁紫枢仙。\n府居末至容连栋，班路前瞻愧比肩。\n丁丙连干支合德，君臣庆会岂虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方孺人挽词","author":"周必大","text":"处士诗名满古今，外家文采切星辰。\n中郎有女曾传业，武子趋庭更慰人。\n谖草正开堂北向，扶桑莫返日西沦。\n可怜寂寞湘江路，燐走萤飞翠柏新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无心居士刘君挽词","author":"周必大","text":"应物无心善自宽，临财有义肯儒酸。\n竹林逸老多馀庆，鸿苑奇书独饱观。\n名父平生淹簿领，佳儿他日绍衣冠。\n追思再世相逢旧，西望梅溪一永叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王季海正言父宣义挽词","author":"周必大","text":"三世儒科独隐沦，功名岂必在吾身。\n早看伯氏囊荷旧，晚喜郎君谏草新。\n绛县人存疑甲子，论衡书就困庚辛。\n遥知会葬车千两，絮酒淋漓卧冢麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王籍文学求读书堂诗","author":"周必大","text":"倚相端能记典坟，子羔未可治人民。\n十年莫作攸之恨，万卷方知甫也神。\n堂下从渠糟粕议，城南容我简编亲。\n铁更三擿韦三绝，将圣犹然况后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丙辰七兄有诗及人月分圆己未彼此服药未能夜坐今次旧韵为重九之约","author":"周必大","text":"初非远道思绵绵，自是岑岑懒涉川。\n咫尺却成千里隔，蹉跎还负十分圆。\n坐看碧落飞金镜，遥想黄楼运笔椽。\n宽约重阳各强健，登高同赋去年篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐顺之司理用杨韵赞予去岁江行游山之乐再次韵","author":"周必大","text":"溯洄险过峡中船，赖有名山寄静便。\n丘壑遂将从栗里，功名何敢梦凌烟。\n吾贤才术今谁敌，野老风流未可传。\n趁取桃花日千里，蓬莱方丈会群仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卢帅钱待制之望挽词","author":"周必大","text":"白鹿争看拥碧油，貂蝉锐欲出兜鍪。\n初官事业追山盗，晚岁功名静海舟。\n鹤唳八公垂破贼，虎飞万里欠封侯。\n儒科有子传衣钵，积善徐卿庆未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":24663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]