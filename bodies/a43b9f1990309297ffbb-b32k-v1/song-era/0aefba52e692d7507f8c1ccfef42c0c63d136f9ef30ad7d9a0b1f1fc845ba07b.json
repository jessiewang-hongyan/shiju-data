[{"title":"依韵酬葛秋岩陶体四首 其四","author":"释文珦","text":"东原风正和，西山气尤爽。\n坐我于其中，此心日以广。\n腰间岂须重，眼下何必两。\n颜原陋巷居，歌有金石响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵酬葛秋岩陶体四首 其三","author":"释文珦","text":"吾生一无营，终日衡门下。\n栖迟已成乐，岂羡台与榭。\n相彼常汲汲，而我独多暇。\n时听蜾祝儿，于以知物化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵酬葛秋岩陶体四首 其二","author":"释文珦","text":"大化无端倪，至道绝冯仗。\n委身于一静，足以去群妄。\n死生亦寄耳，遐龄岂吾望。\n伯伦称达人，胡为未忘葬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵酬葛秋岩陶体四首 其一","author":"释文珦","text":"山林自多趣，况此晴和时。\n我友贲然来，相娱以琴诗。\n仓庚遗好音，薰风发清吹。\n悠然与心会，安能遽忘兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凭阑","author":"释文珦","text":"清川屡萦回，石路更深窈。\n经月无行人，柴门闭春草。\n虚堂在云际，疏磬出林杪。\n日日有馀閒，凭阑看飞鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卧云歌","author":"释文珦","text":"潜山道人性疏懒，地覆天翻浑不管。\n草座麻衣居绝巘，一间茅屋云常满。\n颇爱云纵亦萧散，于焉誓与云为伴。\n终日卧云忘早晚，梦回日照云床暖。\n彼此无心体舒缓，所以相从加缱绻。\n他年我死云独存，云应惋惜吾生短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周草窗吟藁号蜡屐为赋古语","author":"释文珦","text":"尝闻阮孚心好屐，对客蜡之手不释。\n閒畅非唯时所推，千载嘉名犹著白。\n弁山山阳有吟翁，嗜诗亦与嗜屐同。\n尽将书传资诗用，字字句句加磨砻。\n万象一时供掇拾，大玩于词成钜集。\n还将蜡屐以自名，吾知清尚人难及。\n尚喜江湖有此翁，此诗此屐当无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周草窗命题异人爪搯仙境图","author":"释文珦","text":"幽斋众客多清娱，弁翁开卷示此图。\n细画纤纤比毛发，老眼眴转视若无。\n须臾神定乃能辨，蓬山圆峤连方壶。\n山川盘纡体势远，楼观缥缈棼桴铺。\n霓旌羽盖蔽空日，云軿鹤驭交天衢。\n瑰丽绮错千万状，一一尽与人间殊。\n弁翁指陈更详悉，言是澄江惠氏所宝之旧物。\n昔有道人方外来，暮夜延之入其室。\n萧然独卧无灯明，时闻爪甲铿有声。\n明发道人不知处，但见桶底搯画成。\n吾知道人非小巧，物物之中存幻眇。\n更于爪画两俱忘，当与道人同一笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏苕霅","author":"释文珦","text":"苕霅水烟乡，溪风六月凉。\n家家有船步，日日听鱼桹。\n柳树垂阴密，蘋花入梦香。\n山入心亦爱，时到咏沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅 其二","author":"释文珦","text":"万木凋零尽，知经几度霜。\n独馀冰玉质，薰得梦魂香。\n影入清泉瘦，声传画角长。\n每因春烂熳，惆怅失孤芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归 其一","author":"释文珦","text":"天气殊清和，山中多胜践。\n沿流采香芹，穿云得芳荈。\n幽怀日以舒，嚣尘自兹遣。\n乘月返茅茨，倦足不复洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜归陋室","author":"释文珦","text":"萧萧两鬓如凝霜，险阻艰难曾备尝。\n少年气节尚奇伟，老来事业成荒唐。\n盗贼纷纷安衽席，衰翁秋晚犹絺绤。\n明月皎皎星宿稀，夜静入门徒四壁。\n四海知音今已矣，仰天太息悲风起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜兴","author":"释文珦","text":"万缘不相涉，默坐调四肢。\n天理静中见，物情閒处知。\n长风扫重阴，皎月生东篱。\n寒虫唧唧鸣，亦各知天时。\n悠然发清兴，朗诵渊明诗。\n人生百年间，汲汲奚所为。\n贤愚虽有殊，同为来者悲。\n为语高世流，有酒当自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜思","author":"释文珦","text":"静坐四无邻，看山待明月。\n池边暑气尽，竹上凉飔发。\n伏翼打窗飞，孤萤随草没。\n予心适有会，还就幽人说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"居山乐","author":"释文珦","text":"居山乐无涯，三径富松菊。\n山体静吾心，山光悦吾目。\n春来山蕨肥，秋后山田熟。\n未必王侯家，有吾清净福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废冢","author":"释文珦","text":"荒草没颓垣，知是何人墓。\n高顶上牛羊，空间住狐兔。\n行旅为伤神，子孙在何处。\n飋飋起悲风，萧骚白杨树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"征妇怨","author":"释文珦","text":"宁为路傍草，莫作战士妻。\n初嫁席未温，夫今戍辽西。\n忆与夫别时，山川正飞雪。\n腰间弓箭重，冰冻马蹄裂。\n夫君在万里，如何可相求。\n瞻彼日月光，使妾心悠悠。\n悠悠复悠悠，想思曷云已。\n夜夜劳梦魂，遥遥渡辽水。\n军中有纪律，君当慎终始。\n勿以念室家，无心事戎垒。\n自昔忠义人，从军皆效死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"披云亭","author":"释文珦","text":"我爱山中人，冥心住幽寂。\n危亭上绝巘，不染世人迹。\n群峰合空翠，疑若天宇窄。\n午夜独长啸，云开山月白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拙叟","author":"释文珦","text":"拙叟百念无，视身同木石。\n有客问生涯，笑指松与柏。\n客言人之生，当有资生策。\n纵曰遗声利，其能去衣食。\n松柏本无情，于子知何益。\n吾言子姑去，吾倦将偃息。\n反关据槁梧，隤然竟终夕。\n觉来寂无有，鸡叫东方白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放浪诗","author":"释文珦","text":"放浪游名山，山水悦人意。\n穷日不知疲，行行转幽邃。\n空籁如风声，奇峰似云气。\n濯足就寒流，憩锡投古寺。\n长廊遇真僧，妙语发清秘。\n道我多隐情，喜我无众伪。\n愿言从此始，万事尽捐弃。\n相从了馀生，共践真实地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放鹤操","author":"释文珦","text":"相彼胎禽兮有志凌霄，剪翎铩翼兮羁縻于笼牢，为时人之近玩兮中心郁陶。\n有高人兮逆知其然，养成羽仪兮纵之于千仞之巅，使全其性兮逍遥乎九天。\n九天之高兮穹窿，鹤之乐兮融融，维高人之德兮与天无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松竹间","author":"释文珦","text":"瘦竹老松间，閒房仅容膝。\n栖迟非一朝，谢遣用三术。\n泉落双涧清，云消众山出。\n谁能强予迁，爱此成痼疾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松竹堂","author":"释文珦","text":"玉立诸君子，苍髯十八公。\n有此岁寒质，胡能媚东风。\n勿堕长房术，勿受秦皇封。\n深期老此堂，长与幽人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林卧","author":"释文珦","text":"林卧岁月久，閒襟颇孤清。\n静中观庶类，因之感予情。\n木伐以其材，膏煎以其明。\n兽槛以狡彯，禽笼以音声。\n人苟矜智虑，自械伤神形。\n纵使功业崇，或受鼎镬烹。\n今古无不然，念之殊可惊。\n世用常致患，时弃乃全生。\n所以箕颍客，翛然竟遗名。\n吾幸拙而愚，冀可终馀龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林和靖孤山旧隐","author":"释文珦","text":"抱璞肯自剖，藏之在深椟。\n嗟彼荆山人，不能卫其足。\n生先有良贵，那爱分□禄。\n閒居五十年，祗著山人服。\n华衮有何好，此服安且燠。\n童鹤亦清真，梅边伴幽独。\n身后无子孙，高风许谁续。\n疏澹水边萤，飞来照吟屋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊舟","author":"释文珦","text":"泊舟青林傍，日入风色莫。\n翩翩群鸟归，各以类相聚。\n我生独何为，孤立寡良遇。\n落落天壤间，真如惠王瓠。\n苦吟复谁听，直道遭时恶。\n齿豁眼已昏，鬒发坐成素。\n踯躅中夜起，沾衣苦多露。\n仰视天一方，繁星不知数。\n故乡何由返，年老忘归路。\n良宵苦无悰，明朝又何处。\n馀生但迍邅，百念空回互。\n感激动悲歌，邻舟还诟怒。\n吞声入篷底，局促似罝兔。\n行役古所叹，人生亦多误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泽国幽居夏日杂题 其一","author":"释文珦","text":"泽国无袢暑，幽居趣自长。\n花开殊旦暮，稻熟间青黄。\n急雨分塍下，微风度水凉。\n断除车马迹，日日听鱼桹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"炙背","author":"释文珦","text":"老身不能寒，心唯爱冬日。\n炙背蓬门下，暖气浃肌骨。\n自谓人间世，此乐居第一。\n虽曰狐貉温，功莫与之匹。\n山居人不到，独坐快扪虱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空山 其二","author":"释文珦","text":"空山一草庐，住来忘岁月。\n孤身同梦幻，两鬓任霜雪。\n纷纷蛮触争，颇若大琐屑。\n予虽知其然，不欲有分别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经旬","author":"释文珦","text":"经旬坐春雨，畏湿不下席。\n晓看篱角萱，怒长忽过尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苕霅歌","author":"释文珦","text":"昔闻两溪水色异，苕清霅浑犹渭泾。\n又闻发源自天目，悬高坠峻如建瓴。\n日夜滚滚流不止，尽过白蘋红蓼汀。\n流入太湖不复辨，挹之但闻鱼鳖腥。\n堪笑人生亦如此，百年汲汲劳其形。\n到头富贵亦何用，一卧泉下无由醒。\n争似渔翁扁舟独往最脱洒，七十二峰相对长青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦益菜","author":"释文珦","text":"苦菜吾所嗜，意与食檗同。\n古者以益名，颇足昭其衷。\n秋花更清妍，绰约冰雪容。\n恍疑姑射仙，或如采芝翁。\n菊以彭泽显，莲以濂溪崇。\n此独无知音，没身萧艾中。\n人生天壤间，用舍为穷通。\n草木岂不然，一皆系其逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贫贱诗","author":"释文珦","text":"贫贱交亲绝，形影自相吊。\n清泉白石间，朝夕事吟啸。\n甑堕何足言，灰死不须溺。\n达人乃知此，宁免俗士诮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊外春日","author":"释文珦","text":"垂杨袅东风，桐花醉鸣鸠。\n地僻无行人，方塘水交流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采兰吟","author":"释文珦","text":"楚芳有幽姿，采采倏盈把。\n馨香满襟袖，欲寄同心者。\n道远不可求，余怀为谁写。\n佩服林下游，自爱逸而野。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采莲曲 其四","author":"释文珦","text":"采莲惟采花，不敢采莲子。\n其中有苦意，与妾心相似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采莲曲 其一","author":"释文珦","text":"荡桨入平湖，湖波渺无极。\n红白芙蓉花，何如妾颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采莲曲 其三","author":"释文珦","text":"采莲莫伤根，伤根不成藕。\n因思藕不成，悔作征人妇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金竹峰","author":"释文珦","text":"双桧高亭亭，遥见百里外。\n恍疑香烟幢，亦若羽葆盖。\n秀色何其多，贞心固常在。\n化龙想非难，坐待风雨会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓者吟","author":"释文珦","text":"吾谓钓者徒，今古不同流。\n今钓曲为饵，古钓直不钩。\n直钓不在得，所得过于求。\n曲钓志在得，所得良可羞。\n乃知今古钓，不可相为谋。\n好古不好今，颇若能自修。\n试问羊裘人，亦合子意不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后","author":"释文珦","text":"夜雨万雷集，涨水三尺深。\n游鳞得其所，波间自浮沉。\n科斗千点墨，鲤鲫数寸金。\n偶会濠梁意，道人本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青阳代谢行","author":"释文珦","text":"青阳已代谢，赤帝方司衡。\n草木日繁庑，黄鸟鸣嘤嘤。\n维彼造化者，密运何神灵。\n不知为所迁，但见白发生。\n囿身天地间，所卫唯生经。\n宜令心气平，毋使疾疠婴。\n顺此阴阳序，四体当安宁。\n凯风吹棘薪，夭夭长枝茎。\n怀念父母恩，有泪如雨倾。\n仰观仍俯察，因之捈中情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青松篇","author":"释文珦","text":"西山有孤松，亭亭高百尺。\n冰雪屡凌厉，难变青青色。\n东园盛桃李，摇艳矜春容。\n少皞布秋律，扫地无遗踪。\n青松固真心，桃李乏坚操。\n君子与小人，自古不同调。\n宁忍学桃李，誓言作青松。\n偃蹇终不屈，傲睨秦皇封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸣雁行","author":"释文珦","text":"鸣雁??来自北，一一衔芦度深碛。\n空受严霜捐羽毛，不为征人寄消息。\n散落湘吴无定所，或寄平川或洲渚。\n相唤相呼不乱群，非比寒鸦无次序。\n弋者多怀害尔心，栖宿须寻烟水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齿脱","author":"释文珦","text":"老齿皆脱落，十中无二三。\n存者一动摇，咀嚼宁复堪。\n荼荠均一咽，尽略苦与甘。\n世味非道腴，正尔不欲耽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"养疾","author":"释文珦","text":"介特无门徒，室亦如垂罄。\n隤然类枯株，聊以养衰病。\n朝来启篱户，落叶满苔径。\n流光遽如斯，脆质安能竞。\n虚籁起高林，助我发长咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山松柏章","author":"释文珦","text":"松柏何夭矫，南山何崚嶒。\n松柏有常性，南山不骞崩。\n南山人所仰，松柏人所承。\n寻常部娄间，琐琐唯薪蒸。\n彼无高志徒，视此宜自惩。\n坚守岁寒操，亦当慎攸凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中春日","author":"释文珦","text":"客处空林下，贫唯七尺单。\n重阴迷晓色，细雨作春寒。\n乡信凭谁寄，离情强自宽。\n一诗吟未稳，倚遍石池栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客夜","author":"释文珦","text":"客馆何寥寥，明月竟窗户。\n青天悬列星，零露沾宿莽。\n怀感不遑寐，起坐听漏鼓。\n听罢复重听，听彻三四五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客居多暇步过田家","author":"释文珦","text":"客寄无生事，乘閒到水东。\n风和禽语乐，日暖土膏融。\n田父称家有，行人自屡空。\n殷勤留我饭，怜我不为农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客枕 其一","author":"释文珦","text":"客枕正无憀，寒鸡鸣夜半。\n开门望天末，月沉星烂烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏居","author":"释文珦","text":"吾生本疏庸，不作尘间梦。\n屏居万山中，野性颇自纵。\n消摇鹰脱鞲，萧散马释鞚。\n天寒放麋入，春燠闻鸟哢。\n斸药时荷锄，灌圃晨抱瓮。\n薇生富采撷，橘熟断包贡。\n乔松已巢鹤，瘦竹待鸣凤。\n回首视世人，真若蚁一鬨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏居","author":"释文珦","text":"屏居泉石间，所乐在閒纵。\n山田与山果，皆吾手自种。\n禾穗已垂颖，栗包初拆缝。\n一饱既可期，肯复作诗用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屏迹","author":"释文珦","text":"江湖厌风波，岩壑事幽屏。\n柴门绝往还，自阅朝昏景。\n日出烟雾消，鸟散松竹静。\n须臾日西颓，馀晖在高岭。\n短生亦如寄，举世孰能省。\n愿学远公俦，终然谢尘境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽栖","author":"释文珦","text":"幽栖绝世纷，足以养心君。\n是草皆为药，无山不出云。\n房空留鹿伴，果熟与猿分。\n信口成诗句，长谣到夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思远人四方四首 其四","author":"释文珦","text":"幽燕地冷无春晖，此时道归郎不归。\n今朝朔风欺远客，又还无处寄寒衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思远人四方四首 其三","author":"释文珦","text":"草间小虫鸣素秋，唤起妾身离别愁。\n愁多宛转结成梦，梦远直过西凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思远人四方四首 其二","author":"释文珦","text":"念郎南行在桂林，蛮风瘴雨众毒侵。\n室家团栾第一乐，愿郎早归无久淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思远人四方四首 其一","author":"释文珦","text":"娟娟秋月照空床，行人东征未还乡。\n思如辘轳不断绝，千转万转萦愁肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日吟","author":"释文珦","text":"春山青，春水绿，野鸟啼春声续续。\n提壶劝我饮，杜鹃劝我归。\n吾归不待劝，吾贫无酒资。\n之二虫，不吾知，徒尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日野步","author":"释文珦","text":"春色在筇履，山前山后行。\n野花随处发，林鸟百般声。\n幽径遥通寺，清流可濯缨。\n村翁忽相值，又得尽閒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春江夜泛","author":"释文珦","text":"江月照扬舲，乘风过万汀。\n素光流远汉，高浪湿寒星。\n客恨消长笛，閒身渺一蘋。\n到京天未曙，隐隐越山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]