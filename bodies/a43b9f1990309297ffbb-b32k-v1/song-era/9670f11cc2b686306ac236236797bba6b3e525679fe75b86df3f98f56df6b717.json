[{"title":"道中即事八首 其二","author":"洪刍","text":"十年不踏关山道，千里来寻长短亭。\n烟水照人头欲白，云峰见我眼犹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其三","author":"洪刍","text":"兜罗输柳几多绵，独茧抽丝飏远天。\n买断残春是榆荚，乱抛无数沈郎钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其四","author":"洪刍","text":"笋舆沙路裌衣轻，小雨斑斑落又晴。\n三月尽头穿岭去，万松阴里踏莎行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其五","author":"洪刍","text":"春风岭上春风颠，杜鹃花下啼杜鹃。\n花开花落春事晚，归欤当及秋风前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其六","author":"洪刍","text":"万里将雏西北飞，江淮倒景弄差池。\n云天空阔稻粱少，却羡鹪鹩巢一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其七","author":"洪刍","text":"穿云高入双峰寺，投壁难追四祖禅。\n香积喜逢蒲塞馔，拂床聊寄吉祥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中即事八首 其八","author":"洪刍","text":"三月东风池上头，鱼龙漫没戏仙舟。\n我来税驾亦未晚，后乘傥追公子游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"洪刍","text":"翻经灵运推不去，爱酒渊明挽不来。\n无复种莲人作社，空馀写影佛成台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏酒官","author":"洪刍","text":"吏部瓮间应烂醉，渊明篱下祗空杯。\n径须道士常持满，拉取青州从事来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张掾新泉三绝句 其一","author":"洪刍","text":"北山石窦冽寒泉，森木清阴拱外堧。\n试酌祇园八功德，醍醐灌顶想欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张掾新泉三绝句 其二","author":"洪刍","text":"水之美者三危露，邂逅清甘一勺同。\n两客携茶煮汤鼎，归来应御玉川风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和张掾新泉三绝句 其三","author":"洪刍","text":"山色何如水色幽，棋声不乱叶声愁。\n斧柯未烂君归去，白日桑榆不我谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从琏长老借书","author":"洪刍","text":"折轴南来书五车，韦编贝叶映窗纱。\n老禅不用钻故纸，借与书生遮眼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋橘帖二首 其一","author":"洪刍","text":"苏州句法追彭泽，九日题诗兴有馀。\n可是门生藏橘帖，不劳博物见新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋橘帖二首 其二","author":"洪刍","text":"右军一字价连城，断简残章尚典型。\n坐获骊珠三十九，绝胜辛苦赚兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏余天申 其一","author":"洪刍","text":"十年不见君如许，一日相逢我便倾。\n结绶合为金马客，裁诗已至玉溪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏余天申 其二","author":"洪刍","text":"贾谊洛阳推最少，相如蜀郡更多才。\n异书且觅金楼子，俊采空归玉镜台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上口占和使君韵二首 其一","author":"洪刍","text":"皂盖朱轓驻水滨，芳菲虽晚景犹新。\n何妨绮席三千履，不负阳春十二旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上口占和使君韵二首 其二","author":"洪刍","text":"莺歌蝶舞更红裙，端与东山作主人。\n竹马儿童扶杖老，争随千骑去行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"或遗扬州芍药者用元韵二首 其一","author":"洪刍","text":"似与风光殿后尘，亭亭红艳远看人。\n既能障下嫣然笑，移取雷塘十里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"或遗扬州芍药者用元韵二首 其二","author":"洪刍","text":"可堪春恨似悲秋，把酒驱愁转益愁。\n飞尽柳花怜逐客，始知春色到汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵绝句","author":"洪刍","text":"子猷爱竹真成癖，爱菊渊明懒是真。\n篱下想通三径入，林间谁许七贤亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏答王雍","author":"洪刍","text":"临池端欲写黄庭，笼赠鹅群重有情。\n我亦年来无复杀，不应怪我太憎生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋戏赵公子","author":"洪刍","text":"南国佳人翠自颦，西山爽气我相亲。\n只应此夜团团月，偏照寒窗独宿人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶花","author":"洪刍","text":"万卉千葩画不如，芬芳合比白云腴。\n应凭巧绝传神笔，幻出江南没骨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"局中即事用壁间韵 其一","author":"洪刍","text":"老屋疏窗窈窕深，铺松缚竹作清阴。\n数竿风筱天然笑，惟有此君知我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"局中即事用壁间韵 其二","author":"洪刍","text":"无人尽日鸟关关，只许清风伴我闲。\n纵复思归归未得，婆娑诗酒破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始年四十二首 其一","author":"洪刍","text":"门换桃符官落拓，酒传婪尾岁侵寻。\n朱颜已逐年华改，祇有胸中不动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始年四十二首 其二","author":"洪刍","text":"学诗未后高常侍，献赋犹先杜拾遗。\n摘句搜章终底用，求田问舍悔全迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾内相以绝句诗还予诗卷和其韵五首 其一","author":"洪刍","text":"梅生养性来关市，贾傅隳官吊汨罗。\n敢过雷门誇布鼓，辄将鱼目换隋和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾内相以绝句诗还予诗卷和其韵五首 其二","author":"洪刍","text":"月旦平生精藻鉴，短章七字粲星罗。\n银钩虿尾争辉媚，岂减兰亭叙永和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾内相以绝句诗还予诗卷和其韵五首 其三","author":"洪刍","text":"紫微光燄垂星斗，内相词华丽蜀罗。\n愿乞金丹换凡骨，坐令文物压元和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾内相以绝句诗还予诗卷和其韵五首 其四","author":"洪刍","text":"李膺此世龙门坂，得士初非一目罗。\n牛铎黄钟或同调，岂无宫徵配鸾和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾内相以绝句诗还予诗卷和其韵五首 其五","author":"洪刍","text":"世味著人浓似酒，交情向我薄于罗。\n古今混混东流水，听取踏歌蓝采和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小桃晚发 其一","author":"洪刍","text":"深深浅浅小桃枝，苦被蛮风瘴雨欺。\n莫恨春工开最晚，却应孤艳落还迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小桃晚发 其二","author":"洪刍","text":"东风不识桃花面，惆怅多愁足病身。\n青帝也应怜逐客，小窗故剩一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠僧庵二首 其一","author":"洪刍","text":"海棠红映梨花白，拄杖芒鞋绕屋檐。\n深树提壶空好语，无人沽酒送陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠僧庵二首 其二","author":"洪刍","text":"风枝雨叶春无赖，石径芳茨昼不开。\n绿竹笋高人未觉，紫荆花谢我重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟岘台","author":"洪刍","text":"崇台面空阔，远眺真高明。\n一水来朝宗，湾环抱荒城。\n连山颇偃蹇，却略倚翠屏。\n缅怀青溪上，兴与岘山并。\n客从豫章来，及此春服成。\n公子有好怀，良人及兹登。\n初筵挹溪光，中觞闻雨声。\n翠幄列茂树，金沙涨回汀。\n鸥鸟舞不下，渔舟纵复横。\n尚恨夜气敛，不见白月生。\n信美非吾土，少留空复情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石耳峰","author":"洪刍","text":"朝踏红尘暮宿云，往来车马漫纷纷。\n猴溪桥下潺湲水，惟有峰头石耳闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芍药","author":"洪刍","text":"蚕老桑柔戴胜鸣，翻阶芍药占春荣。\n牵风孙寿愁眉破，带雨骊姬泪眼横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝","author":"洪刍","text":"仙果移从海上山，露华供夜鹤分丹。\n光射腰金陵宝印，影回殿砌拂猗兰。\n朱砂芒刺羞红颗，龙目团圆避赤丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"异蚕吐丝成段","author":"洪刍","text":"公子青衫得意朝，闺门异事喜成谣。\n星河牛女支机石，泉室鲛人暗织绡。\n园客凭虚誇独茧，冰蚕志怪岂同条。\n细看霞绮惊群眼，讵减云裳下九霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虾蟆","author":"洪刍","text":"动物类含血，虾蟆独无之。\n双目但瞠也，一腹亦皤其。\n龙变或托体，鱼腹睹幽姿。\n罕见三足蟾，讵减六眸龟。\n向来奏赝瑞，背负轮囷芝。\n坐谩皆下吏，胶车等儿嬉。\n虽蒙黄金掷，荆卿空尔为。\n或以白玉琢，形模妙工倕。\n咄尔百丑质，讵辱五鼎脂。\n浪号土底牺，雄誇水中鸡。\n何足污帝箸，但可充蛇饥。\n作意一池鸣，和我五字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上墨工","author":"洪刍","text":"子墨客卿妙一世，怀玉山中五大夫。\n峨眉老仙与推毂，谷量牛马斗量珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家谣","author":"洪刍","text":"鸠妇勃溪农荷锄，身披袯襫头茅蒲。\n雨不破块田坼图，稊稗青青佳谷枯。\n大妇碓舂头鬓疏，小妇拾穗行饷姑。\n四时作苦无裤襦，门前叫嗔官索租。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阙题二首 其一","author":"洪刍","text":"槐下枣花纂纂，麦秋葚子离离。\n不沽十千美酒，难消三百枯棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阙题二首 其二","author":"洪刍","text":"两部池蛙当妓，千山飞鸟催沽。\n引睡直须黄妳，曲肱正要青奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵作","author":"洪刍","text":"沙觜弯环转柁牙，一衣带水绕城斜。\n飞廉解使冯夷怒，渡口风吹荞麦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其一","author":"洪刍","text":"宝历中兴业，于今六十年。\n洗光旸谷日，鍊补女娲天。\n大业超东汉，皇恩畅北燕。\n圣谟谁可颂，会有笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其二","author":"洪刍","text":"往在艰难际，乾坤震扰中。\n京华原有主，赵魏剪为戎。\n整顿须神武，扶持立隽功。\n配天还祀夏，真与少康同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其三","author":"洪刍","text":"紫塞连沙漠，天亲堕杳冥。\n竟能襄水祏，复见养慈宁。\n孝道光千古，精神格上灵。\n典谟垂不尽，赫赫照丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其四","author":"洪刍","text":"盛德如何说，由来只是仁。\n推心无尔界，摩手为吾民。\n广大天同道，高明圣与邻。\n欲知恩普处，海岳但微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其五","author":"洪刍","text":"祸转妖氛灭，天催五鼎烹。\n只知江饮马，岂料观封鲸。\n士感亲征诏，神扶义战兵。\n干戈俄载戢，遗恨不收京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其六","author":"洪刍","text":"翼善能传圣，巍巍又见尧。\n才逾知命岁，已禅拱辰朝。\n玉册三加峻，琼宫十闰超。\n大章传懿铄，稽古耀宗祧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其七","author":"洪刍","text":"圣学由天纵，煌煌翰墨场。\n臣中羞瓘靖，户外立钟王。\n飞动鸾窥藻，昭回斗避芒。\n焕文瞻仰处，杰阁在西厢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其八","author":"洪刍","text":"北内神灵地，期期亿万年。\n岩廊明圣日，宇宙戴尧天。\n乐事湖山在，英徽雅颂传。\n那知开玉锁，不恋地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其九","author":"洪刍","text":"鹤驭临丹极，龙髯堕玉宸。\n炉烟犹泛夜，宫蕊已迷春。\n梦断无寻处，神游不见人。\n伤心天壤内，血泪染车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高宗皇帝挽词 其十","author":"洪刍","text":"仙仗葳蕤去，行行浙水东。\n稽山元禹穴，吴岫见尧宫。\n帐殿凄寒露，笳城起暝风。\n霓旌不可望，应在彩毫中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山紫霄峰有禹刻石室","author":"洪刍","text":"块视落星石，杯观彭蠡湖。\n荒哉秦汉君，抗旌上崎岖。\n永怀太史公，九江观禹摹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学韩退之体赋虾蟆一篇","author":"洪刍","text":"吾庐逼沮洳，蛙蛤宗生之。\n委委见蝌蚪，阁阁已在兹。\n夜声一何喧，达旦乃寖微。\n月令纪蝼蝈，语默亦有时。\n岂伊不平鸣，沓沓竟何为。\n那复当鼓吹，安能问官私。\n吾闻昆崙下，厥大数十围。\n蟾蜍窟望舒，色胜金袅蹄。\n痴騃反食月，吞吐谁能知。\n坎井我自足，跳梁而持颐。\n鳖笑色无愠，鹑化理莫推。\n疥体不自惜，或以调盐醯。\n柳州味南烹，下箸甘若饴。\n在昔荐宗庙，乃与羔兔齐。\n擅减几被坐，巨细不可遗。\n莫以腥臊弃，终将瑚琏期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藏之和予虾蟆短调再作之因以策事","author":"洪刍","text":"虾蟆何为者，痱磊盎于背。\n人言怀土虫，弃去俄复在。\n昔有系青缯，酉阳志其怪。\n尝观三物图，副以蝍蛆带。\n相持莫先动，含毒相屠脍。\n端欲兄龟龙，未肯弟孔翠。\n俳语解人颐，子阳妄尊大。\n慎勿离窟穴，旁午元五辈。\n东行犯日忌，束缚非其罪。\n倘有切玉刀，甘心脂鼎鼐。\n平生不下箸，实惮背脊疥。\n何必食马肝，前修有明戒。\n愿君勿嘲诮，微命其可贷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"洪刍","text":"撩人縢六索题诗，赖有支郎为解围。\n永夜祇宜燋兔好，彤云不见织乌飞。\n少林未许齐腰立，青女无端接手归。\n想得庐山幽绝处，洒林压竹更增辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家谣","author":"洪刍","text":"父耕原上田，子斸山下荒。\n六月一禾生，官家一开仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登文殊台","author":"洪刍","text":"壮哉文殊台，俯瞰落星湾。\n双剑倚天外，一柱切云端。\n未穷黄石岩，但逢赤眼禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊女儿浦","author":"洪刍","text":"大孤山下两牛鸣，女儿浦口一苇横。\n已隔云烟五老面，犹梦雷霆三峡声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青原台","author":"洪刍","text":"高台梯空上云烟，宴坐城郭窥山川。\n凫汀鹤渚江在前，青原入望山苍然，蓦波轻泛一叶船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"洪刍","text":"眼中人物东西尽，肺病京华故倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"洪刍","text":"鹿场兔径白昼静，稻垄松竹青嶂深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"洪刍","text":"关山不隔还乡梦，风月犹随过海身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"洪刍","text":"何如唤取陆鸿渐，石鼎风炉来试茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"洪刍","text":"谁折可怜花，置我经行处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"洪刍","text":"但使添丁长，终兴谢客家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"洪刍","text":"爰有福地直斗牛，厥名閤皂形色收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]