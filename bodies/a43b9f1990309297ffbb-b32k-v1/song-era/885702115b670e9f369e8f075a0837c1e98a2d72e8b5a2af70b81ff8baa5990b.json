[{"title":"偈六首 其六","author":"释净端","text":"端师子，太慵懒，未死牙齿无坏烂。\n二时伴众赴堂，粥饭都赶不办。\n如今得死是便宜，长眠百事皆不管。\n第一不著看官，第二不著吃粥饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释净端","text":"七处徵心心不遂，懵懂阿难不瞥地。\n直饶徵得见无心，也是泥中洗土块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释净端","text":"八还之教垂来久，自古宗师各分剖。\n直饶还得不还时，也是虾逃不出斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释净端","text":"点铁成金易，忠孝两全难。\n子细思量著，不如个湖州长兴灵山孝感弹院老松树下无用野僧闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释净端","text":"南无观世音，说出种种法。\n众生业海深，所以难救拔。\n往往沉没者，声声怨菩萨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴少卿入山","author":"释净端","text":"友人相访入柴关，云水宽闲溪涧寒。\n莫道山家无可待，老松修竹任君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和友人入山韵","author":"释净端","text":"闲来无事对山屏，古涧寒松畅野情。\n是处岩华高下色，几般幽鸟往来声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题归云庵壁","author":"释净端","text":"老来林下养闲躯，茅屋清虚蚊蚋无。\n一径松虱何处起，入松穿竹两三株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"释净端","text":"石枕藤床一榻低，觉来还自日沈西。\n白云堆里翻身转，一曲渔歌在碧溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自述","author":"释净端","text":"潇洒岩居畔，结茅惟一庵。\n清风销暑气，寂寞少人贪。\n幽有鸟声碎，禅无衲子参。\n斋馀林下去，华雨落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"释净端","text":"吴山古寺近溪边，高阁虚堂景象全。\n林下寂寥炉火尽，未眠犹听夜行船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其一","author":"释净端","text":"吴山古寺寒松直，老鹤巢居最上头。\n惟爱月明中夜后，一声清唳满山愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其二","author":"释净端","text":"老嫌俗客来相访，独泛孤舟溪上游。\n夜宿芦华赏明月，应无闲事挂心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其三","author":"释净端","text":"老来无事掩柴扉，林下闲闲何所为。\n莫道茅庵无一物，窗前片片白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其四","author":"释净端","text":"野老欣欣任自然，斋馀无事玩林泉。\n门前竟日无人到，夜对乔松月在天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其五","author":"释净端","text":"年老醒醒神更清，夜深幽室诵莲经。\n儿孙睡觉应嫌我，石版时敲四五声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其六","author":"释净端","text":"老拙懒陪尘俗客，茅堂挣坐复安眠。\n林间莫道无看待，松竹溪山在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其七","author":"释净端","text":"岩前松竹两三株，日炙风吹渐已枯。\n叶落纵横人不扫，清声犹自响朝晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰若杂言 其八","author":"释净端","text":"因观杨柳垂青眼，始觉人间春到来。\n遥望南山雪消尽，寒梅犹有一枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登慈云岭","author":"释净端","text":"千古慈云岭，诸方南北行。\n江波与湖水，极目两分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长兴周承事相访 其一","author":"释净端","text":"吴山长碧水长流，水转山湾路更幽。\n多谢庞公远相访，旋烧松火荐茶瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长兴周承事相访 其二","author":"释净端","text":"渐觉清和四月天，一声清磬响山川。\n心澄气爽无拘束，留得高人伴夜禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张居士相访","author":"释净端","text":"清河居十别多年，一笑相逢信有缘。\n莫讶老僧无别话，平常心是祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送客之三衢","author":"释净端","text":"今日忽相见，俄然又相别。\n三衢山水清，好赏中秋月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题假山石","author":"释净端","text":"无用无知顽石头，天生奇巧世人求。\n算来世上无闲物，假使无情不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会昙老","author":"释净端","text":"渔家生计好，终日泛轻舟。\n剪竹为竿钓，裁荷作酒瓯。\n只知溪上乐，不识世间愁。\n昨夜岩隈下，蓑衣忘却收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祥符寺溪堂","author":"释净端","text":"开窗满日见溪山，霅水东流下岭湾。\n夜月深明渔舫寂，白云无事到禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"述怀","author":"释净端","text":"晦迹归岩坞，僻居人到稀。\n披衣眠静榻，策杖绕荆扉。\n远谢名兼利，能忘是与非。\n松风祛暑薄，山月照萤微。\n烹茗满瓯雪，掬泉半湿衣。\n穷通云意密，终与世人违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吉祥寺茶山","author":"释净端","text":"吉祥山水与云连，清韵来闻二十年。\n知道老僧无熟恼，金沙地内不流泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同苏饶文宿吉祥寺二首 其一","author":"释净端","text":"孤峰峻岭翠光寒，山势奔湖去又蟠。\n今夜虎头岩下宿，更无归梦出林峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同苏饶文宿吉祥寺二首 其二","author":"释净端","text":"与公昔作长城别，一去尘埃六七年。\n夜静书堂寻旧约，定将生计话林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送上方亮老","author":"释净端","text":"何故无心恋霅溪，鄣南风景白云齐。\n有人若问宗门事，水自东流日自西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其一","author":"释净端","text":"人事悠悠懒更攀，茅堂静坐白云闲。\n夜观明月为高烛，一道清光照万山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其二","author":"释净端","text":"水澄山色映青天，静坐茅堂未欲眠。\n好玩岩头松与月，更闻高柳一声蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其三","author":"释净端","text":"耳聋不听楼头鼓，眼暗难看夜半灯。\n一曲渔歌声尽后，归云天外自腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠长兴王省元","author":"释净端","text":"谁测先生意趣难，贫如原宪学宗颜。\n年年酒债将琴当，岁岁诗狂待月还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜子胜仲登第","author":"葛书思","text":"广场笔阵数千人，喜汝穿杨箭镞亲。\n庆绪绵长时幸会，文科兴复事还新。\n昔年继榜熙宁岁，今偶同科绍圣春。\n从此莫教书种断，孙曾应复值昌辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿悟空院","author":"葛书思","text":"高枕僧房夜漏深，经窗俄见月华侵。\n抗尘走俗成何事，问道参禅徒在心。\n智镜直须真里照，机锋莫向句中寻。\n悟空不见悟空者，漫对寒灯拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿广福寺","author":"葛书思","text":"我非山中人，暂借山中宿。\n灵风散微阴，片月出乔木。\n蕙帐栖夕香，古井汲寒渌。\n名缁多夙契，延坐同茗粥。\n况与静者俱，缮性久已熟。\n清词丽陶谢，玄谈干身毒。\n所愧形迹拘，无由寄高躅。\n钟声殷江岛，露气霭林麓。\n良遇惬素怀，徘徊至天旭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"解日字谜","author":"吕惠卿","text":"东海有一鱼，无头亦无尾。\n更除脊梁骨，便是这个谜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答逢原","author":"吕惠卿","text":"晨出趋长司，跪坐与之言。\n偶然脱龃龉，相送颜色温。\n归舍未休鞍，簿书随满门。\n相仍宾客过，攲午仅朝餐。\n平生性懒惰，应接非吾真。\n况乃重戕贼，良气能几存。\n就夜甫得息，阅我几上文。\n开卷未及读，睡思已昏昏。\n自知小人归，昭昭复何云。\n每于清夜梦，多见夫子魂。\n侧耳听高议，如饮黄金樽。\n觉来不得往，欲飞无羽翰。\n昨日得子诗，我心子先论。\n怪我诗苦迟，友道宜所敦。\n岂不旦夕思，实苦案牍烦。\n岂无同官贤，未免走与奔。\n相见鞅掌间，有言无暇陈。\n嗟嗟兹世士，无食同所患。\n念我力难任，闻子谋更艰。\n久知为之天，安能怨窭贫。\n吾闻君子仕，行义而已焉。\n亦将达吾义，岂遂为利牵。\n东海有沧溟，西极有昆崙。\n古来到者谁，不过数子尊。\n子已具车航，吾亦为楫轮。\n欲一从子游，不知何时然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题风乞儿扇","author":"吕惠卿","text":"无人肯作除非乞，没药堪医最是风。\n求乞害风都占断，算来世上少如公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题兴安王庙","author":"吕惠卿","text":"剪叶疏封意，归禾协济心。\n遗风固唐远，积德本周深。\n逝水悲兴废，浮云阅古今。\n祠宫尚翚翼，鸣玉漱松阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"吕惠卿","text":"鱼出清波庖脍玉，菊含寒露酒浮金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"吕惠卿","text":"南北战争蜗两角，占今兴废貉同丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"吕惠卿","text":"虚心清暑殿，预戒一阴生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吉甫侄","author":"吕川","text":"峨眉月浸千秋雪，太华峰摇十丈莲。\n一见升平玉清客，雪莲声价顿销然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致仕郭朝议","author":"吕川","text":"漫道任公钓有神，六鳌无迹海生尘。\n争如静卧南窗下，兰菊从教秋与春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浯溪","author":"杨冀","text":"长安失驭颂声沈，作者谁能刻翠岑。\n大业尽归文老笔，中兴还死叛臣心。\n天边奎壁垂芒冷，溪上龙蛇倒影深。\n当日形容播金石，洋洋千载有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"王靖","text":"蜀道新持使节优，南昌更命按诸侯。\n江山秀入行台晓，风月吟余泽国秋。\n宽弛茶租吴俗富，兴骊渠利晋人讴。\n送将莫讶迟留处，浩穰敲喧讼牒稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王靖","text":"欲往海上吞鲸鲵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王举元柏谷山院","author":"韩标","text":"附骥游僧刹，天清晓色开。\n园林喷雨过，殿阁踏云来。\n日转花阴薄，山深磴道回。\n凭栏堪写望，陇麦翠如堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐卿既篆欧公侍郎滁州琅邪山醉翁亭记上石讫思莫能致之滁上因斧官之隙地众材堪栋梁者枝其榱桷构堂于廨舍西偏高三仞植记于中楹若屏然图悠久也因成长句五十六字以诗其名兼寄献欧公侍郎","author":"苏唐卿","text":"醉翁亭记醉翁堂，远取琅邪近费乡。\n高世雄文刊翠琰，老山孤干负虹梁。\n左邻鳌海三神岛，西倚儒宫数仞墙。\n虽愧篆工非墨宝，英辞终与借辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和诸公佳作","author":"苏唐卿","text":"老文新刊立新堂，千里腾辉贲两乡。\n江汉骊珠探作宝，龟蒙文桂断为梁。\n英辞美陋琼瑶室，古篆工羞粪上墙。\n陵谷燮迁解讹缺，后贤何惜补休光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏唐卿","author":"龚敦","text":"滁守南迁记醉狂，篆刊移近舞雩乡。\n当年寓兴临山水，今日希风构栋梁。\n吏部丧文辞避席，阳冰阁笔让循墙。\n东沂从此遗声迹，迥掩桐庐翰墨光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏唐卿","author":"史辞","text":"昔日欧公镇永阳，构亭直在水云乡。\n醉翁啸傲曾为记，贤宰风流别驾梁。\n老笔健遒刊琬琰，晴岚滴沥照门墙。\n更吟新咏深堂秘，相伴昆山片玉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"篆书醉翁亭记石刻","author":"邵忱","text":"欧公顷岁守滁阳，题记苍颜入醉乡。\n贤宰特将刊古篆，旧碑不免弃山梁。\n轩楹别构如安屏，笔札难通似面墙。\n异口智仙来辇坐，退蒙从此谢声光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"李特","text":"出没云闲满太虚，元来真相一尘无。\n重重请问西来意，唯指庭前柏一株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"慧禅师","text":"朝朝日出东方，夜夜月落西户。\n如今大宋官家，尽是金枝玉树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释灵运","text":"夜来云雨散长空，月在森罗万象中。\n万象灵光无内外，当明一句若为通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂鲁祖面壁","author":"释善冀","text":"鲁祖三昧最省力，才见僧来便面壁。\n若是知心达道人，不在扬眉便相悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释令滔","text":"放却牛绳便出家，剃除须发著袈裟。\n有人问我西来意，拄杖横挑啰哩啰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答李陶","author":"章阿父","text":"通身一点法，四海永绝伦。\n开得天关路，闭得地户门。\n若要求长生，到断五行因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"性慵","author":"黄希旦","text":"性佣人事拙，思向远山居。\n欲得是非少，先宜来往疏。\n善邻惟水竹，良友秪琴书。\n冷淡生涯外，逍遥一室虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颐真亭","author":"黄希旦","text":"剪去旧蒿莱，开亭养圣胎。\n闭开虚室白，隐几寸心灰。\n月上池浮露，风生竹扫苔。\n悠悠奔竞者，何处问丹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日书怀和韵","author":"黄希旦","text":"二月又将半，闲居兴若何。\n芳菲殊未赏，泥泞阻相过。\n华砌饶苔藓，柴门长薜萝。\n韶颜须自惜，随分乐天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采药","author":"黄希旦","text":"采药山中去，扳跻不觉赊。\n深源无俗迹，满地是灵芽。\n岩迥阴留雪，溪澄净见沙。\n可怜名利客，应笑此生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人秋感","author":"黄希旦","text":"烈士感秋兴，高吟击太阿。\n功名辜壮志，岁月叹流波。\n永巷蛩初响，荒阶叶渐多。\n灵槎如可约，从此泛银河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水心亭","author":"黄希旦","text":"为爱方池净，危亭此构新。\n寒光摇玉鉴，晴色戏金鳞。\n月上骊宫晓，莲开水府春。\n主人能息虑，四座绝风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏竹","author":"黄希旦","text":"生涯何所有，满砌植琳琅。\n瘦影碎秋月，健梢横晓霜。\n且从喧鸟雀，终待集鸾凰。\n吟绕都忘却，谁知此兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月春将半三首 其一","author":"黄希旦","text":"二月春将半，幽居掩竹斋。\n自惭疏懒甚，苔藓满空阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月春将半三首 其二","author":"黄希旦","text":"二月春将半，农耕细雨中。\n花前轻薄子，醉倒笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月春将半三首 其三","author":"黄希旦","text":"二月春将半，霖霪雨尚寒。\n松黄收拾晚，狼籍满金坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]