[{"title":"过新津游修觉山","author":"李流谦","text":"旧闻修觉寺，苇岸却维舟。\n句法雄千古，山形尽数州。\n野宽仍据会，江合却分流。\n畏暑犹如此，吾方事远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别元质 其二","author":"李流谦","text":"远梦灯频照，羁怀酒重倾。\n啼乌翻夕露，归雁占秋晴。\n此地丰鱼稻，如君好弟兄。\n语离亦怊怅，松槚独关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别元质 其一","author":"李流谦","text":"鸥轻家泛泛，梗短路悠悠。\n妙句能留客，澄江可散愁。\n长年资浩叹，秋色动商讴。\n故有先畴在，归为雁鹜谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别费检正二首 其二","author":"李流谦","text":"主人爱客客留连，敢比荆州遇仲宣。\n亲奉绮谈逾十日，空劳清梦隔三年。\n未能轻去田园乐，那得长居几杖前。\n真约赏音无几个，故应感激易潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别费检正二首 其一","author":"李流谦","text":"香案前头自乞归，归心先逐雁西飞。\n岂关松菊吾身重，偶托莼鲈此意微。\n行乐不妨千骑拥，照人何必万钉围。\n儿曹怅惜先生笑，付与醇醪定是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别赵惟直","author":"李流谦","text":"邂逅都城一笑休，却来万里共羁游。\n关河地迥仍分首，桃李春深已放舟。\n诗卷长留开倦目，酒杯尽嚼豁离忧。\n追风健笔兼豪气，期子蓬山更上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"李流谦","text":"懒步东阡与北溪，一春心赏苦多违。\n堕红藉藉痴蜂醉，稚绿阴阴乳燕飞。\n去国三年应自笑，封侯万里不如归。\n门前车马能来否，午睡醒来独掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"李流谦","text":"山路仍多雨，秋天最易阴。\n呼舟乱滩响，倚杖俯溪浔。\n风力凭江横，云容隐树深。\n一寒遽如许，料理欲归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"李流谦","text":"爱春未得一钱酬，独倚东风搔白头。\n花影入帘情苒苒，竹风挨枕梦悠悠。\n黄鹂欲下无谁语，碧草相看始欲愁。\n老大别无新伎俩，只凭诗句写风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其三","author":"李流谦","text":"雪巘云林共莽然，世间那有此江天。\n晓樯搀日何时到，夜柁鸣风几夕眠。\n閒卜家书灯似粟，略开旅抱酒如泉。\n轻鸥飞下仍飞去，汝在江湖是散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴波亭相对数峰极可爱","author":"李流谦","text":"吴波波上亭，一面列山屏。\n雨雨晴晴好，朝朝暮暮青。\n倦身无处著，醉眼为渠醒。\n便欲携归去，全胜腰万钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈德茂","author":"李流谦","text":"秋入羁怀劳我思，愁兼归梦到家迟。\n有人来得平安字，无事编成酬唱诗。\n相伴几经江月照，同行更赏峡山奇。\n祗应便把州麾去，还有三年不见时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀李仲明 其一","author":"李流谦","text":"地旷空凝结，江清悦见闻。\n娟娟初上月，漠漠未归云。\n鱼乐能忘钓，鸥閒故念群。\n桂旗风不度，却立咏湘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀李仲明 其二","author":"李流谦","text":"斜晖放船好，晚吹得凉多。\n星斗窥深酌，鱼龙答浩歌。\n乾坤身半老，湖海意如何。\n夙昔纫兰约，迟君肯重过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投晁子止制置三首 其三","author":"李流谦","text":"西南雄节制，人物妙炉锤。\n舐鼎非无意，登门独恨迟。\n正期云触石，会见菌成芝。\n不信酬恩事，君看左顾时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投晁子止制置三首 其二","author":"李流谦","text":"吴甸七千里，坤垠六十州。\n宸心宽北阙，老子在西楼。\n召伯出分陕，卫公归相周。\n衮衣人惬意，重为雪山愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投晁子止制置三首 其一","author":"李流谦","text":"读书万卷破，转物一机神。\n道德欣为御，文章妙斲轮。\n圣贤同一处，天地要弥纶。\n汗简窥千古，从来只数人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李允成次彦博韵见示仍用韵答之三首 其二","author":"李流谦","text":"吾家老仙伯，白璧半钱酬。\n杖屦穷幽地，禽鱼替客愁。\n可能百世出，閒却一生休。\n念旧须公等，年来叹俗浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李花","author":"李流谦","text":"春寒怪底一分加，元是东君雪作花。\n已后残梅矜夜魄，强随飞絮舞朝霞。\n霜葩荐斝何人共，碧实堆盘尽客誇。\n为汝泫然应有意，骚人端是感年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜少陵祠","author":"李流谦","text":"赤绂银章玉骨寒，焚香再拜泪汍澜。\n黄花郪县仍羞见，好月鄜州只独看。\n可是一生长客路，故应千古恨儒官。\n蚤知涉世元如此，悔不霜林斫钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟呈元质照老 其二","author":"李流谦","text":"落日清江阔，临流一慨然。\n断鸿烟际渚，雌霓雨馀天。\n照海珠成市，骑鲸客是仙。\n轻风借帆力，送我玉妃前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟呈元质照老 其一","author":"李流谦","text":"扁舟载我去，身世两悠然。\n暝霭无穷树，春江不尽天。\n阮嵇真酒伴，李郭即神仙。\n孤唱君须和，风流汉晋前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芜湖晚步","author":"李流谦","text":"迥陂积水长蒲蒋，散步郊原借夕凉。\n尘袖风巾嗟久旅，稻畦柘径似吾乡。\n蛙声月色当空旷，爨火人家在莽苍。\n望合碧云人未至，滞留愧客问行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还家","author":"李流谦","text":"吾家在何许，水泉修竹林。\n鸥鹤失闲伴，跂予有遐心。\n窗前小梅花，耐霜笑吟吟。\n小待新酒熟，冷蕊劝清斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连日阴雨未及一到金焦二山病中得梁文佳句枕上吟哦不能自已复次韵","author":"李流谦","text":"云满长空雨涨沙，金焦一望去非赊。\n拟抛尘网寻僧舍，更著烟蓑访钓家。\n北固江山仍壮丽，南徐风物尚繁华。\n只愁病客难登槛，且待金乌出海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰重阳有感次宋景文公韵","author":"李流谦","text":"濛濛烟雨湿閒愁，往燕来鸿共远游。\n引满白醪欣再熟，尽开黄菊耐深秋。\n眼前节物重凭槛，醉里商歌缓击瓯。\n苦爱佳名叹尘爵，渊明高兴转悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆使君祠二首 其二","author":"李流谦","text":"梁初奄巴蜀，仍有渡泸人。\n汲直馀蒸简，萧翁亦聚尘。\n杰魂犹念沛，远梦不归秦。\n幻化元超忽，何劳问大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆使君祠二首 其一","author":"李流谦","text":"山为一案峙，水恰面前流。\n自是神灵宅，非从槁壳谋。\n风声分井络，云气接瀛邱。\n炯炯谁相领，焚香发半秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮文氏园是日鹊噪于庭坐上烛花无数就试者凡五人","author":"李流谦","text":"虎变龙腾各有心，诸公高宴盍朋簪。\n烂开数对迎祥烛，合噪仍来报喜禽。\n人似月娥元自近，酒名天禄莫辞深。\n坐中五客联登去，他日华堂榜桂林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶六舅","author":"李流谦","text":"李杜主盟诗有声，文推韩柳著章程。\n二三子者皆人杰，五百年来并世生。\n但见词源倒三峡，岂知武库足千兵。\n勉君须把分阴惜，莫问红尘雨共晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜兴","author":"李流谦","text":"疲筋弱骨畏歊蒸，颇欲清言濯肺膺。\n风乱飞萤光细碎，露团幽筱醉懵腾。\n只应爱月痴犹在，更觉憎蚊忿未惩。\n竹屋纸窗风雨夜，几时书册近青灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐呈王子友 其二","author":"李流谦","text":"晴山见历历，远水听飕飕。\n宇宙不知大，关河空复愁。\n孤云游子梦，滞穗野翁讴。\n我与鸦俱息，烟林晚共投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐呈王子友 其一","author":"李流谦","text":"无毡殊未觉，有兴亦难忘。\n小雨寒微就，孤灯话尽长。\n疏凉汤煮豉，淡泊菜含霜。\n为问王夫子，如何共肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学中曝御书次少虞韵","author":"李流谦","text":"晴暾煜煜眩晨光，洗眼来窥云汉章。\n身拜玉阶元夕梦，手披金笈有天香。\n风翔凤翼尤妍媚，云捲奎躔不覆藏。\n尚想承平閒气象，从臣鹄立侍君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忠州","author":"李流谦","text":"井邑云根一聚村，寻诗来扫壁间尘。\n此州惟有断头将，圣世初无弃梗人。\n枫叶晚林终日醉，梅花腊峤几时春。\n不愁过客当年泪，尊酒黄堂是旧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抵家","author":"李流谦","text":"何地非吾土，故乡情未忘。\n掀眉对兄弟，酌酒话行藏。\n拜墓色不愧，逢人语更狂。\n梅花相待发，好在细思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抵简池呈元质进孺二首 其二","author":"李流谦","text":"竹生稚子鹤生雏，重到君家旧隐居。\n病后苦无多酌酒，别来唯有自钞书。\n身方逐食从飘荡，学久师心恐阔疏。\n惭愧故人相念意，欲行为我少踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抵简池呈元质进孺二首 其一","author":"李流谦","text":"持此迂愚漫浪身，忍惭一出竟何营。\n枕边客意兼寒意，门外溪声似雨声。\n易办蓬蒿三亩宅，可无藜苋一杯羹。\n青衫岂是官人样，白鸟私忧说败盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招黄太博饮","author":"李流谦","text":"从来官职惯如冰，便是青衫行脚僧。\n去岁离家今日是，故人招隐几时能。\n早衰须鬓逢人问，太拙形模引世憎。\n均在客中谁作伴，如何不共醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枕上","author":"李流谦","text":"欲问更长短，江村无鼓鼙。\n客怀如酒病，秋夜与年齐。\n被冷失孤蝶，霜清闻远鸡。\n终年为荡子，尺纸愧山妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枢相游吴园再用前韵","author":"李流谦","text":"等閒驱雪作晴天，夹道从公立万弮。\n白甚自矜梅淡伫，青回稍觉麦芊绵。\n不知今夕真何夕，共说明年是好年。\n舐鼎恐无鸡犬分，一江还我捕鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊采石二首 其二","author":"李流谦","text":"江头杨柳浅于金，泽国馀寒春未深。\n才见桃花能慰眼，便同踯躅每伤心。\n琼枝璧月自惆怅，山色潮声无古今。\n閒访阇黎倒戈地，正应汉德有讴吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊采石二首 其一","author":"李流谦","text":"何时便有此山川，真宰悬知恐偶然。\n唳鹤惊风前日事，落沤斜照晚来天。\n燬犀无用撩幽怪，洗盏先应酹谪仙。\n暝角吹残吾欲老，五陵佳气隔疏烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行至天王院","author":"李流谦","text":"郊行不欲经城市，厌见尘沙漠漠黄。\n响树蜩螗凭晚吹，绕陂凫鹜占残阳。\n青山与世久相绝，修竹于人未易忘。\n下马招提揖僧话，始知尘境有仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵二首 其二","author":"李流谦","text":"江城叠鼓晚停挝，游子翩翩念岁华。\n水底乾坤浮日夜，沙边鸥鹭老烟霞。\n渔人能说陈隋事，燕子犹寻王谢家。\n南北自分仍自合，不应全殢后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵二首 其一","author":"李流谦","text":"龙蟠虎踞帝王州，屡叹降旗出石头。\n不惜家居撞坏了，可因歌舞破除休。\n露桃滴滴啼宫井，风柳条条绊客舟。\n春水一江流未尽，不禁更问几多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后有月江上作","author":"李流谦","text":"雨止夜色静，涨生江浪浮。\n碧云度星汉，明月照汀洲。\n倏忽阴晴异，苍茫意绪秋。\n微吟不须苦，下有未眠鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独步","author":"李流谦","text":"冻壳藏龟太窘生，惊心已觉岁峥嵘。\n倦慵把易床头看，独自寻梅树下行。\n溪面冰花寒更结，屋颠雪意晚将成。\n一生与物无深分，竹叶相看合有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀次黄仲甄韵 其一","author":"李流谦","text":"畏日全无客到门，一溪閒与白鸥分。\n绕楼山色时时见，抱叶蝉声处处闻。\n战罢棋枰无宿恨，梦回茗椀有殊勋。\n力田尚可持门户，我欲归耕谷口云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草堂","author":"李流谦","text":"浣花溪上得閒来，石刻摩挲病眼开。\n短策多时临水立，红尘半路与风回。\n乞灵伎薄裳为带，惊世名言海纳杯。\n相对只今真梦寐，数椽茅屋老苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"费文达除夔漕作此贺之三首 其三","author":"李流谦","text":"刻鹄工夫愧不量，弓裘遗绪可能忘。\n一廛未遂耕桑计，半世空磨翰墨场。\n桐烬偶收非有意，璧瑕误指亦何伤。\n霜松不学閒桃李，报答东君日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"费文达除夔漕作此贺之三首 其二","author":"李流谦","text":"吉音一纸疾邮传，白帝城头劝著鞭。\n楚树已沾新雨露，蜀江行换好风烟。\n政须急拯沟中瘠，不用多流地上钱。\n一节故应关象纬，向来两使动星躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"费文达除夔漕作此贺之三首 其一","author":"李流谦","text":"分明馀润彻眉间，道德根源固晔然。\n宝篆印泥初不著，神机贯札自无前。\n丝纶新渥荣三昼，鼎铉深知眇一涓。\n两禁只今谁妙手，岷峨人物半吴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贻长松寺慈禅师","author":"李流谦","text":"一年山色好相看，欲去仍来倍黯然。\n大士初无留客意，幽人更结住山缘。\n梨花村落清明后，梅子园林五月前。\n我已到家春亦老，酒杯犹足趁流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送五八侄归二江","author":"李流谦","text":"清霜入短褐，送汝酌深杯。\n万事不如学，千金难买才。\n关心门户重，过眼岁时催。\n莫待收灯后，驱车望早来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送尹仲求临邛户掾","author":"李流谦","text":"何必昆峰远，天球自粹温。\n掾曹甘蠖屈，僚侣总鲸吞。\n子去成三友，公馀寄一樽。\n沧溟有馀沥，犹幸及鸰原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王伯董入总幕 其一","author":"李流谦","text":"几窗缠结习，翰墨录殊勋。\n未入三山直，当空万马群。\n俛眉聊绿水，展脚是青云。\n五十头如漆，功名不放君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王伯董入总幕 其二","author":"李流谦","text":"昔为万里别，归送北征鸿。\n近接何曾数，深期本自同。\n远眸眵雾嶂，短箠滑霜风。\n更说无穷乐，怀中双橘红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王和叟赴果州","author":"李流谦","text":"芝兰祇合在阶庭，公子翩翩更老成。\n白日朱门三列戟，黑头华毂再专城。\n一樽别酌心先醉，万里归桡梦易惊。\n欲问楼高高几许，跨渠仙鹤到瑶京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王景文","author":"李流谦","text":"相送复相送，生憎风景殊。\n还家疑是梦，涉世误为儒。\n爱惜千金璧，迟回一束刍。\n亦思江海去，书札寄潜夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王景文入制幕二首 其二","author":"李流谦","text":"缱绻联名第，飘零共塞垣。\n自知此事胜，更觉斯文尊。\n欲别言尤苦，相期意略存。\n成都万事好，只合近清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王景文入制幕二首 其一","author":"李流谦","text":"著眼分明见，论心委曲知。\n负排阊阖气，有泣鬼神诗。\n世故从料理，人材属盛衰。\n浮云多变化，宁忆路傍时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送计祖仁雒县丞","author":"李流谦","text":"青青杨柳灞桥斜，满酌清樽莫叹嗟。\n可是因循成别绪，只应咫尺便天涯。\n未论流水千竿竹，且看春风一县花。\n渺渺故园情最苦，不知归梦属谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯夏卿","author":"李流谦","text":"再见三池已旧游，向来交臂锦江头。\n味融实际冰河泮，心印微言水月秋。\n虽作燕鸿犹邂逅，故应蓬梗合漂浮。\n相思别后才馀梦，身在刀州望梓州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史唐英二首 其二","author":"李流谦","text":"阴崖陨天末，朝日上团团。\n稍觉岷峨近，绝知湖海宽。\n舜门元自辟，蜀道未应难。\n富贵风花耳，相看在岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史唐英二首 其一","author":"李流谦","text":"藉甚闻名久，惠然从我游。\n敢云国士遇，每向古人求。\n一第娱亲尔，高怀可意不。\n咸韶乱蛙吹，期子继苏欧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]