[{"title":"谒真如悟法述偈","author":"释道平","text":"七颠八倒，业识忙忙。\n螺江回首处，笑杀谢三郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释道平","text":"山僧不会佛法，为人总没来由。\n或时半开半合，或时全放全收。\n还如万人丛里，冷地掉个石头。\n忽然打著一个，方知触处周流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释道平","text":"赵州有四门，门门通大道。\n玉泉有四路，路路透长安。\n门门通大道，毕竟谁亲到。\n路路透长安，分明进步看。\n岁晚未归客，西凤门外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"举盘山示众偈","author":"释道平","text":"似地擎山，不知山之孤峻。\n如石含玉，不知玉之无暇。\n古人恁么说话，大似抱贼叫屈。\n普融门下，人人慷慨。\n生擒虎兕，活捉狞龙。\n眼里著得须弥山，耳里著得大海水。\n不是向人誇伎俩，丈夫标致合如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释景祥","text":"灵山话，曹溪指，放过初生斫额底。\n未问龙眠老古锥，昨夜三更转向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陕府铁牛","author":"释景祥","text":"尾在黄河北，头枕黄河南。\n善财无鼻孔，依旧向南参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释寘","text":"福岩山上云，舒卷任朝昏。\n忽尔落平地，客来难讨门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终与蔡氏甥","author":"周滨","text":"三舅报无常，诸甥脚手忙。\n熟搥三挺皂，烂煮一锅汤。\n垢腻从君洗，形骸任尔扛。\n六钉声寂寂，千古路茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答沂州吏","author":"王老志","text":"多年退罢老公人，手种桑麻数百根。\n尽是笔头挼撚得，一枝枝上有冤魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"余辟","text":"不誇长揖出宫闱，不重为渔老钓矶。\n最爱清宵银汉上，客星时共帝星辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题太平兴国宫","author":"傅谦受","text":"仙家楼阁霭清芬，倦客停骖日欲曛。\n争得便如陶靖节，拂衣来此看孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别友人","author":"陆字","text":"园花今烂漫，一一手亲栽。\n惟有新离恨，东风吹不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏马巨济","author":"李作乂","text":"太学有马涓，南省无马涓。\n秋榜有马涓，春榜无马涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题白莲堂","author":"徐评","text":"一法圆融万法该，白莲香社应时开。\n渊明不解同方便，何事攒眉不肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题蜕龙洞","author":"徐评","text":"荟蔚苍岩下，灵踪此暂蟠。\n云雷一夜起，风雨满山寒。\n骨腐苔方绿，涎馀石未乾。\n试凭图画去，聊羡叶公看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁国院","author":"徐评","text":"岑寂千山曲，萦纡一径微。\n楼台青嶂合，窗户乱云飞。\n野色侵僧衲，池光射客衣。\n偶来修吏隐，到此益忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月集句 其一","author":"葛次仲","text":"玉露中秋夜，亭亭月正圆。\n一霄当皎洁，万象共澄鲜。\n送别高台上，添愁野帐前。\n无因驻清景，歌舞入明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月集句 其二","author":"葛次仲","text":"凉夜清秋半，常娥照玉轮。\n九霄微有露，万里正无尘。\n气射繁星灭，明翻宿鸟频。\n寥寥天地内，风景一时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昆山慧聚寺集句","author":"葛次仲","text":"全吴临巨溟，青山天一隅。\n静境林麓好，胜槩凌方壶。\n泓泓野泉洁，暧暧烟谷虚。\n攀云造禅扃，跻险筑幽居。\n道人刺猛虎，复来薙榛芜。\n咄嗟檀施开，以有此屋庐。\n侧叠万古石，功就岂斯须。\n磥砢成广殿，鬼工不可图。\n有穷者孟郊，过此亦踌躇。\n赋诗留岩屏，词律响琼琚。\n我访岑寂境，幸与高士俱。\n时升翠微上，凉阁对红蕖。\n岸帻偃东斋，果药杂纷敷。\n上方风景清，华敞绰有馀。\n高窗瞰远郊，万壑明晴初。\n赏爱未能去，赪霞照桑榆。\n老僧道机熟，闲持贝叶书。\n秉心识本源，高谈出有无。\n茗酌待幽客，顿令烦抱舒。\n儒道虽异门，意合不为殊。\n抖擞垢秽衣，惟有牟尼珠。\n馀生愿休止，投策谢归涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"葛次仲","text":"万里清江万里天，一村桑柘一村烟。\n渔翁醉睡又醒睡，高唱夕阳孤岛边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其一 青童峰","author":"楼异","text":"斩新高髻掠云开，翠色罗衣一样裁。\n知有真仙此中住，故命天女捧书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二 黄盖峰","author":"楼异","text":"一片黄云驻不飞，中天帝子欲何知。\n不须更问玉人事，自有嵩高峻极诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其三 浮邱峰","author":"楼异","text":"谁知方丈与瀛洲，尘世纷纷漫白头。\n不到嵩山最高处，世人容易揖浮邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其四 三鹤峰","author":"楼异","text":"昔有仙翁住此间，炼成青发与朱颜。\n一朝跨鹤升天去，涧草岩花岂复攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其五 遇圣峰","author":"楼异","text":"汉家天子学神仙，曾遇真人耳过肩。\n不待菖蒲长黑发，须知逸乐自延年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其六 万岁峰","author":"楼异","text":"仙仗西来感百神，泥金检玉尚如新。\n山灵知是真天子，万岁声中第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其七 玉镜峰","author":"楼异","text":"皎皎冰盘瑩百围，广寒宫殿见依稀。\n青山万叠浑如洗，浮翠光中一镜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其八 狮子峰","author":"楼异","text":"苍苔藤蔓饰须眉，狮子标形是与非。\n果解嚬呻作哮吼，窟中狐兔定魂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其九 虎头峰","author":"楼异","text":"万里封侯相不如，道人曾此获阴符。\n轩牙露舌惊樵采，猛士还当捋尔须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十 起云峰","author":"楼异","text":"触石孤飞一叶蓬，雷公电母昼鞭龙。\n但知四海为霖雨，不道中天第几峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十一 凤凰峰","author":"楼异","text":"当年翔凤此徘徊，曾为真人览德来。\n今日飞鸣天外过，纷纷燕雀不须猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十二 金壶峰","author":"楼异","text":"想见金壶泻墨河，皂林馀润郁嵯峨。\n伯阳当日传经后，肯向山阴与换鹅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十三 华盖峰","author":"楼异","text":"华盖峰高未易穷，扪参历井到天中。\n回头却顾人间世，但见群青似小童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十四 玄龟峰","author":"楼异","text":"玄武名峰古所传，晨昏吐气作云烟。\n虽无钻灼刳肠患，岁晚风霜亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十五 卧龙峰","author":"楼异","text":"头角低回藓蔓封，蜿蜒端似卧真龙。\n旱乾岁祷多灵应，时见油云出此峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十六 会仙峰","author":"楼异","text":"鹤乘云軿下九天，玉盘星子竟谁先。\n相应汉武题花品，留作人间聚八仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十七 子晋峰","author":"楼异","text":"当年曾悟镜中形，道骨仙风拟紫冥。\n二十四峰明月夜，玉笙须向揖仙听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十八 玉柱峰","author":"楼异","text":"丹楹未羡人间侈，玉柱一峰天外高。\n自古大材须大用，扶持广厦岂辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其十九 老翁峰","author":"楼异","text":"翳雾埋云皓首翁，难将书传考前踪。\n商山羽翼朝天后，化作中天一石峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二十 玉人峰","author":"楼异","text":"汉武求仙未得仙，玉人何事落峰前。\n故知帝子乘云下，神盖峰头启洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二十一 玉女峰","author":"楼异","text":"玉仙曾此驻云车，日薄窗纱映雪肤。\n七字天书人不辨，定知玄女手中符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二十二 独秀峰","author":"楼异","text":"孕玉怀金不待媒，蓊然佳气罩崔嵬。\n天教秀拔诸峰上，未信狂飙解折摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二十三 积翠峰","author":"楼异","text":"翠幄笼云自一家，萝梯夜碾七香车。\n举头雨过馀霞散，绿芰池开菡萏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山二十四咏 其二十四 太白峰","author":"楼异","text":"仰攀日月风云近，俯瞰冈峦培塿低。\n绝顶光芒长不断，人言太白此中栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋","author":"李朴","text":"皓魄当天晓镜升，云间仙籁寂无声。\n平分秋色一轮满，长伴云衢千里明。\n狡兔空从弦外落，妖蟆休向眼前生。\n灵槎拟约同携手，更待银河彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵玉岩应诏 其一","author":"李朴","text":"天书远下事徵求，乡里同推马少游。\n世事已非三不可，年华却是一宜休。\n岂缘薄禄贻身累，祇为当时分主忧。\n筇杖芒鞋留我伴，伫闻谈笑即封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵玉岩应诏 其二","author":"李朴","text":"掷饵求鱼计亦难，长鲸摇曳海波宽。\n狂风有待三秋起，健翮须教万里抟。\n直以逸民朝圣主，不随计吏上春官。\n庖刀休用援尸祝，巾笥宁封贡禹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆玉岩 其一","author":"李朴","text":"阿阁曾看紫凤栖，暮年江国拥旌麾。\n孤云南北本无定，浮世悲欢那可期。\n鹤顶丹砂埋药灶，鸭头绿水浸春陂。\n待公踏遍红尘地，景物归来似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆玉岩 其二","author":"李朴","text":"秋风燕雀正关关，忽见篱边菊又斑。\n寒雁自知霜露重，海鸥常伴水云閒。\n百年往事丹心里，千古声名直道间。\n此意属公须慷慨，晚云成雨便归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崆峒山","author":"李朴","text":"云根秀出碧芙蓉，烟晃霞飞瑞霭中。\n地脉九枝龙奋蛰，天河一派练横空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺山","author":"李朴","text":"天竺崎岖绝海边，何人分作赣江禅。\n鹫山巧叠三峰石，葛坞深疏两派泉。\n一醉风光能几许，十年尘迹尚依然。\n欲题豹隐还相笑，盼断长空簇暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马祖岩","author":"李朴","text":"踏尽层峦上小亭，日华初泛晓烟清。\n尘埃不到门常静，身世相忘性自灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乞巧","author":"李朴","text":"处处香筵拂绮罗，为传神女渡天河。\n休嫌天上佳期少，已恨人间巧态多。\n齰舌自应工妩媚，方心谁更苦镌磨。\n独收至拙为吾事，笑指双针一缕过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八境台","author":"李朴","text":"金弋百战古虔州，滚滚双江日夜流。\n杯酒登台同极目，夕阳渔唱起沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游通天岩","author":"李朴","text":"春烟澄霁色，杖策出郊坰。\n叠嶂浮空翠，孤云罨断青。\n燕衔泥作垒，僧结草为亭。\n万树山风里，钟声下界听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张祜韵","author":"蒋瑎","text":"野旷吴天杳，江浮楚梦吞。\n桂香飘露叶，松古兀霜根。\n碧荠他州树，黄芦何处村。\n世尘飞不到，清磬落空门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孟郊韵","author":"蒋瑎","text":"依崖架僧坊，微云冒经床。\n阔睨沧海潮，幽聆诸天香。\n远水泻空碧，层轩逗寒光。\n愿言寄暮齿，永诀声利场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"蒋瑎","text":"谁知清淡者，冬月亦登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸太学","author":"李师德","text":"坠典遗经已表章，又传清跸幸胶庠。\n黄龙绕驾天移仗，白雪分袍士缀行。\n况是体元能作圣，更欢稽古效规王。\n太平盛世文明远，万国儒风自一堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四顶山","author":"张彦修","text":"翠峦齐耸压平湖，晚绿朝红画不如。\n寄语商山闲四皓，好来各占一峰居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"都贶","text":"不可思议，是大火聚。\n便恁么去，不离当处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三高堂","author":"黄潜","text":"三贤同一隐，所遇时则异。\n不居云水乡，讵泄英雄气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九仙岩","author":"阮之武","text":"野老相传有九仙，尝游此地忽升天。\n霓旌鹤驭今何在，千古空岩锁暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉遗爱庙碑","author":"阮之武","text":"楚续光辉存简策，汉碑突兀锁期思。\n风云会合当年事，箫鼓喧阗此日祠。\n弱嗣负薪廉节著，怪蛇膏剑德名垂。\n庙封又见标遗爱，子产英灵想已知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愚溪","author":"阮之武","text":"亭溪山号悉从吾，占得声光万古无。\n不似零陵柳司马，贬他好景乱名愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夕阳岩","author":"阮之武","text":"晋人仙去莫知春，依旧空岩锁暮云。\n西照满前无限景，有谁能此忆瞿君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫云岩","author":"阮之武","text":"石磴萝梯隐翠微，坐间时有紫云飞。\n纷纷郁郁来还去，难问瞿仙几日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石塘寺","author":"阮之武","text":"洗开无用木，放出自然屏。\n一簇冈峦势，多般人物形。\n金坚性难坏，玉润色常青。\n得地生禅刹，休嗟在大坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引烟坞","author":"杜捍","text":"行爱种桃处，濛濛罩轻素。\n花深人不辨，似入迷仙路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天泽源","author":"杜捍","text":"湛碧一泓深，潺湲泻不断。\n高穹沛四时，派别环周半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"杜捍","text":"铁乌老龙挺，谁为辨雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"杜捍","text":"倘使在南阳，应为孔明石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"杜捍","text":"应为览德归，来仪化灵迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"杜捍","text":"波心石船并，中载白莲馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"杜捍","text":"上就巾子头，轩昂成皂盖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":57862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]