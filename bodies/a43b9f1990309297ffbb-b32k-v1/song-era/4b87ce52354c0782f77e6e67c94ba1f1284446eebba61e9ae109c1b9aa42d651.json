[{"title":"次韵石七三六言七首 其一","author":"黄庭坚","text":"从来不似一物，妄欲贯穿九流。\n骨硬非黄閤相，眼青见白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵舍弟题牛氏园二首 其二","author":"黄庭坚","text":"春事欲了莺催，主人虽贫燕来。\n玉烛传杯未厌，金吾静夜惊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵舍弟题牛氏园二首 其一","author":"黄庭坚","text":"春与园林共晚，人将蜂蝶俱来。\n樽前鸟歌花舞，归路星翻汉回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩川奉祠西太乙宫四首 其四","author":"黄庭坚","text":"泰坛下瑞云黄，雨师洒道尘香。\n便面犹承坠露，金钲半吐东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩川奉祠西太乙宫四首 其三","author":"黄庭坚","text":"紫府侍臣鸣玉，霜台御史生风。\n官烛论诗未了，知秋自属梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩川奉祠西太乙宫四首 其二","author":"黄庭坚","text":"白髦下金神节，青祝携御炉香。\n百礼尽修亳祀，九歌不取沈湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩川奉祠西太乙宫四首 其一","author":"黄庭坚","text":"万灵未对甘泉，五福问祀迎年。\n旌旂三斿半偃，风马云车闯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其五","author":"黄庭坚","text":"天子文明浚哲，今年不次用人。\n九原埋此佳士，百草无情自春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其四","author":"黄庭坚","text":"老忆夷门老将，当年许我忘年。\n博学似刘子政，清诗如孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其三","author":"黄庭坚","text":"两公六字语妙，独我一双眼明。\n笔似出林鸟翼，诗如落涧泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其二","author":"黄庭坚","text":"不怨子堂堂去，盖念君得得来。\n家藏会稽妙墨，晚岁喜识方回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和东坡送仲天贶王元直六言韵五首 其一","author":"黄庭坚","text":"仲子霣霜杀草，风流无地寄言。\n王君攀鳞附翼，礼义端能不骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏子舟小山丛竹","author":"黄庭坚","text":"病竹犹能冠丛，夏篁解箨匆匆。\n细草因依岑寂，小山紫翠嵌空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南签判向和卿用予六言见惠次韵奉酬四首 其四","author":"黄庭坚","text":"觅句真成小技，知音定须绝弦。\n景公有马千驷，伯夷垂名万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南签判向和卿用予六言见惠次韵奉酬四首 其三","author":"黄庭坚","text":"覆却万方无准，安排一字有神。\n更能识诗家病，方是我眼中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南签判向和卿用予六言见惠次韵奉酬四首 其二","author":"黄庭坚","text":"向侯赋我菁莪，何敢当不类歌。\n顾我乃山林士，看君取将相科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆南签判向和卿用予六言见惠次韵奉酬四首 其一","author":"黄庭坚","text":"仕宦初不因人，富贵方来逼身。\n要是出群拔萃，乃成威凤祥麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荔支绿颂","author":"黄庭坚","text":"王墙东之美酒，得妙用于六物。\n三危露以为味，荔支绿以为色。\n哀白头而投裔，每倾家以继酌。\n忘螭魅之躨触，见醉乡之城郭。\n扬大夫之拓落，陶徵君之寂寞。\n惜此士之殊时，常生尘于尊勺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蚁蝶图","author":"黄庭坚","text":"胡蝶双飞得意，偶然毕命网罗。\n群蚁争收坠翼，策勋归去南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送慧林明茶头颂","author":"黄庭坚","text":"慧林有一老人，恰似银瓮盛雪。\n彻底元无渗漏，旁观但知皎洁。\n有徒三百二百，木钻漫钻磐石。\n或遇东海鲤鱼，一棒令生羽翼。\n其馀两两三三，归堂又要茶吃。\n上人南来云水，因行不妨掉臂。\n凤山修水东西，灵草春来满地。\n但令己事相应，归日驴驮不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效孔文举赠柳圣功三首 其三","author":"黄庭坚","text":"王良终日驰驱，曹商百乘从车。\n七芧鼓舞群狙，学问圣处功夫，千古与我友俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效孔文举赠柳圣功三首 其二","author":"黄庭坚","text":"妙言玉质金相，学问日月悠长。\n良贾故要深藏，屈体下心堂堂，灰头土面辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"效孔文举赠柳圣功三首 其一","author":"黄庭坚","text":"武库五兵森森，名驹万里骎骎。\n英风爽气如林，读书凿井欲深，学道却要无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寂住阁","author":"黄庭坚","text":"庄周梦为胡蝶，胡蝶不知庄周。\n当处出生随意，急流水上不流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄六祖范和尚颂","author":"黄庭坚","text":"范公头上著枷，涪翁脚上著杻。\n且共弥勒过冬，閒坐地炉数九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深明阁","author":"黄庭坚","text":"象踏恒河彻底，日行阎浮破冥。\n若问深明宗旨，风花时度窗棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答杨明叔送米颂","author":"黄庭坚","text":"买竹为我打篱，更送米来作饭。\n用此回光反照，佛事一时成办。\n不须天下求佛，问取弄臭脚汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢胡藏之送栗鼠尾画维摩二首 其二","author":"黄庭坚","text":"丹青貌金粟影，毛物宜管城公。\n只今为君落笔，他日听我谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢胡藏之送栗鼠尾画维摩二首 其一","author":"黄庭坚","text":"貂尾珍材可笔，虎头墨妙疑神。\n颇知君尘外物，真是我眼中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"慈母岩亮长老颂","author":"黄庭坚","text":"敕书改律为禅，意在无力宗空。\n人欲破禅作律，群儿更助之攻。\n莫恨塞翁失马，会取楚人亡弓。\n老夫亦不掩耳，我来自听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨蛇颂","author":"黄庭坚","text":"此书惊蛇入草，书成不知绝倒。\n自疑怀素前身，今生笔法更老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题万松亭","author":"黄庭坚","text":"天柱峰无比肩，郁郁高松满川。\n万身苍髯老禅，刳心忘义忘年。\n说法曾无间歇，松风寺后山前。\n四海五湖衲子，更于何处参玄。\n若觅向上关捩，灵龟石下流泉。\n太平堂中老将，家活都无一钱。\n会得佛头著地，不会佛脚梢天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题子瞻书诗后","author":"黄庭坚","text":"诗就金声玉振，书成虿尾银钩。\n已作青云直上，何时散发沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山谷石牛洞","author":"黄庭坚","text":"司命无心播物，祖师有记传衣。\n白云横而不度，高鸟倦而犹飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题马当山鲁望亭四首 其二 狄梁公","author":"黄庭坚","text":"鲸波横流砥柱，虎口活国宗臣。\n小屈弦歌百里，不诬天下归仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题马当山鲁望亭四首 其四 陆鲁望","author":"黄庭坚","text":"笠泽道人高古，文章白发萧条。\n欲问勒铭遗墨，应书水府鲛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题马当山鲁望亭四首 其三 颜鲁公","author":"黄庭坚","text":"不见鲁公断石，谁家为础为杠。\n笔法锥沙屋漏，心期晓日秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题马当山鲁望亭四首 其一 元亮","author":"黄庭坚","text":"马当一曲孤烟，人物于今眇然。\n不见绕篱黄菊，谁收种秫圭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东坡竹石","author":"黄庭坚","text":"怪石岑崟当路，幽篁深不见天。\n此路若逢醉客，应在万仞峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘将军鹅","author":"黄庭坚","text":"箭羽不沾春水，籀文时印平沙。\n想见山阴书罢，举群驱向王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑防画夹五首 其五","author":"黄庭坚","text":"子母猿号槲叶，山南山北危机。\n世故谁能樗里，彀中皆是由基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑防画夹五首 其四","author":"黄庭坚","text":"折苇枯荷共晚，红榴苦竹同时。\n睡鸭不知飘雪，寒雀四顾风枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑防画夹五首 其三","author":"黄庭坚","text":"徐生脱水双鱼，吹沫相看晚图。\n老矣个中得计，作书远寄江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑防画夹五首 其二","author":"黄庭坚","text":"能作山川远势，白头惟有郭熙。\n欲写李成骤雨，惜无六幅鹅溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题郑防画夹五首 其一","author":"黄庭坚","text":"惠崇烟雨归雁，坐我潇湘洞庭。\n欲唤扁舟归去，故人言是丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题般若会疏颂","author":"黄庭坚","text":"六祖深禅独脚，与盲抉开眼膜。\n走人天下乞钱，涪翁放过一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灊峰阁","author":"黄庭坚","text":"徐老海棠巢上，王翁主簿峰庵。\n梅蘤破颜冰雪，绿丛不见黄甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高子勉四首 其四","author":"黄庭坚","text":"拾遗句中有眼，彭泽意在无弦。\n顾我今六十老，付公以二百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高子勉四首 其三","author":"黄庭坚","text":"妙在和光同尘，事须钩深入神。\n听他下虎口著，我不为牛后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高子勉四首 其二","author":"黄庭坚","text":"张侯海内长句，晁子庙中雅歌。\n高郎少加笔力，我知三杰同科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高子勉四首 其一","author":"黄庭坚","text":"文章瑞世惊人，学行刳心润身。\n沅江求九肋鳖，荆州见一角麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一落索","author":"黄庭坚","text":"谁道秋来烟景素。\n任游人不顾。\n一番时态一番新，到得意、皆欢慕。\n紫萸黄菊繁华处。\n对风庭月露。\n愁来即便去寻芳，更作甚、悲秋赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子","author":"黄庭坚","text":"要见不得见，要近不得近。\n试问得君多少怜，管不解、多于恨。\n禁止不得泪，忍管不得闷。\n天上人间有底愁，向个里、都谙尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下水船","author":"黄庭坚","text":"总领神仙侣。\n齐到青云歧路。\n丹禁风微，咫尺谛闻天语。\n尽荣遇。\n看即如龙变化，一掷灵梭风雨。\n真游处。\n上苑寻春去。\n芳草芊芊迎步。\n几曲笙歌，樱桃艳里欢聚。\n瑶觞举。\n回祝尧龄万万，端的君恩难负。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 其一","author":"黄庭坚","text":"苑边花外。\n记得同朝退。\n飞骑轧，鸣珂碎。\n齐歌云绕扇，赵舞风回带。\n严鼓断，杯盘狼藉犹相对。\n洒泪谁能会。\n醉卧藤阴盖。\n人已去，词空在。\n兔园高宴悄，虎观英游改。\n重感慨，波涛万顷珠沈海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 其二","author":"黄庭坚","text":"世间好事。\n恰恁厮当对。\n乍夜永，凉天气。\n雨稀帘外滴，香篆盘中字。\n长入梦，如今见也分明是。\n欢极娇无力，玉软花敧坠。\n钗罥袖，云堆臂。\n灯斜明媚眼，汗浃瞢腾醉。\n奴奴睡，奴奴睡也奴奴睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑奴儿/采桑子","author":"黄庭坚","text":"济楚好得些。\n憔悴损、都是因它。\n那回得句闲言语，傍人尽道，你管又还鬼那人唦。\n得过口儿嘛。\n直勾得、风了自家。\n是即好意也毒害，你还甜杀人了，怎生申报孩儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年心 其二 添字","author":"黄庭坚","text":"心里人人，暂不见、霎时难过。\n天生你要憔悴我。\n把心头从前鬼，著手摩挲。\n抖擞了、百病销磨。\n见说那厮脾鳖热。\n大不成我便与拆破。\n待来时、鬲上与厮噷则个。\n温存著、且教推磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少年心 其一","author":"黄庭坚","text":"对景惹起愁闷。\n染相思、病成方寸。\n是阿谁先有意，阿谁薄倖。\n斗顿恁、少喜多嗔。\n合下休传音问。\n你有我、我无你分。\n似合欢桃核，真堪人恨。\n心儿里、有两个人人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆帝京 黔州张倅生日","author":"黄庭坚","text":"鸣鸠乳燕春闲暇。\n化作绿阴槐夏。\n寿酒舞红裳，睡鸭飘香麝。\n醉此洛阳人，佐郡深儒雅。\n况坐上、玉麟金马。\n更莫问、莺老花谢。\n万里相依，千金为寿，未厌玉烛传清夜。\n不醉欲言归，笑杀高阳社。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆帝京 其二 私情","author":"黄庭坚","text":"银烛生花如红豆。\n占好事、而今有。\n人醉曲屏深，借宝瑟、轻招手。\n一阵白蘋风，故灭烛、教相就。\n花带雨、冰肌香透。\n恨啼乌、辘轳声晓。\n岸柳微凉吹残酒。\n断肠时、至今依旧。\n镜中消瘦。\n那人知后。\n怕夯你来僝僽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆帝京 其一 赠弹琵琶妓","author":"黄庭坚","text":"薄妆小靥闲情素。\n抱著琵琶凝伫。\n慢捻复轻拢，切切如私语。\n转拨割朱弦，一段惊沙去。\n万里嫁、乌孙公主。\n对易水、明妃不渡。\n泪粉行行，红颜片片，指下花落狂风雨。\n借问本师谁，敛拨当心住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其四 用前韵赠郭功甫","author":"黄庭坚","text":"少年得意从军乐。\n晚岁天教闲处著。\n功名富贵久寒灰，翰墨文章新讳却。\n是非不用分今昨。\n云月孤高公也莫。\n喜欢为地醉为乡，饮客不来但自酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其二 次前韵再呈功甫","author":"黄庭坚","text":"青壶乃似壶中谪。\n万象光辉森宴席。\n红尘闹处便休休，不是个中无皂白。\n歌烦舞倦朱成碧。\n春草池塘凌谢客。\n共君商略老生涯，归种玉田秧白石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一","author":"黄庭坚","text":"风开水面鱼纹皱。\n暖入草心犀点透。\n乍看晴日弄柔条，忆得章台人姓柳。\n心情老大痴成就。\n不复淋漓沾翠袖。\n早梅献笑尚窥邻，小蜜窃香如遗寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 当涂解印后一日，郡中置酒，呈郭功甫","author":"黄庭坚","text":"凌歊台上青青麦。\n姑熟堂前馀翰墨。\n暂分一印管江山，稍为诸公分皂白。\n江山依旧云空碧。\n昨日主人今日客。\n谁分宾主强惺惺，问取矶头新妇石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"黄庭坚","text":"庾郎三九常安乐。\n使有万钱无处著。\n徐熙小鸭水边花，明月清风都占却。\n朱颜老尽心如昨。\n万事休休休莫莫。\n樽前见在不饶人，欧舞梅歌君更酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一 窜易前词","author":"黄庭坚","text":"翰林本是神仙谪。\n落帽风流倾座席。\n坐中还有赏音人，能岸乌纱倾大白。\n江山依旧云横碧。\n昨日主人今日客。\n谁分宾主强惺惺，问取矶头新妇石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其二","author":"黄庭坚","text":"东君未试雷霆手。\n洒雪开春春锁透。\n帝台应点万年枝，穷巷偏欺三径柳。\n峰排群玉森相就。\n中有摩围为领袖。\n凝香窗下与谁看，一曲琵琶千万寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一 游览","author":"黄庭坚","text":"瑶草一何碧，春入武陵溪。\n溪上桃花无数，花上有黄鹂。\n我欲穿花寻路，直入白云深处，浩气展虹霓。\n只恐花深里，红露湿人衣。\n坐玉石，敧玉枕，拂金徽。\n谪仙何处，无人伴我白螺杯。\n我为灵芝仙草，不为朱唇丹脸，长啸亦何为。\n醉舞下山去，明月逐人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]