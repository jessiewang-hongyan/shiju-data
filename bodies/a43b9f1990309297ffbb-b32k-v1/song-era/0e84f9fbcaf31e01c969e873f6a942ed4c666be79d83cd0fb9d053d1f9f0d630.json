[{"title":"之霅","author":"卫宗武","text":"小艇经从处，村村尽掩扉。\n山川今似旧，城郭是耶非。\n泽竭鱼龙困，林空鸟雀稀。\n天寒岁年晚，蚤计盍知归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"卫宗武","text":"晚芳开欲尽，落叶满林楸。\n风色转寒候，雨声鸣暮秋。\n清游殊有碍，归兴浩难收。\n何日逢开霁，天还解客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行道间","author":"卫宗武","text":"行春行不足，今日又明朝。\n平岭上危岭，长桥过短桥。\n残红明石涧，腻绿暗风条。\n最是宜人听，迁莺出谷娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为乡人赋心田","author":"卫宗武","text":"方寸良畴人共有，能耕能敛几人知。\n坦平非有山河界，存养何殊雨露滋。\n盍剖藩篱忘彼我，却明畦畛别公私。\n尽多阴骘于中种，播穫当为百世菑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为谢氏赋流芳","author":"卫宗武","text":"斯文一脉可传家，囊帛籯金不足誇。\n须信诗书涵润泽，自今庭户发英华。\n谢兰辉映方生玉，窦桂香含不断花。\n不但种芳兼种德，百年之计此为嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为僧赋梅庭","author":"卫宗武","text":"奇绝生春五出花，僧居著此境尤嘉。\n一方寒月浸清影，几度春风生素华。\n何必江头千树暗，未如屋角数枝斜。\n翻经觅句无尘事，坐对尤宜雪煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巨室遗牡丹有作 其二","author":"卫宗武","text":"殿春名谱压群葩，汲水金铜满贮花。\n无地栽培娱老境，有风吹送到儿家。\n娇容粉薄雨含沐，丰脸杯醺日绚华。\n花卒还荣人莫少，芳辰来往岁无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巨室遗牡丹有作 其一","author":"卫宗武","text":"几年有负倾城艳，惭愧今朝对洛花。\n忆昔富文同胜集，慨今姚魏属谁家。\n赏心不作园林想，过眼聊为几席华。\n回首一年春又了，绿阴芳草接天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月师西岩","author":"卫宗武","text":"灵山作岩骨，清气涤炎洲。\n突兀插万古，玲珑涵九秋。\n排云宿翳扫，宾日晓光浮。\n的的西来意，宜于此处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月集呼声妓不至野渡于觞末俾赋诗以纪初集","author":"卫宗武","text":"真率盟齐喜有初，崇觞载俎志交孚。\n共披白帢俱沾醉，独惜红裙不受呼。\n拟洛耆英宜有咏，班唐九老可成图。\n从今胜集循环举，岁岁毋令此意辜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花","author":"卫宗武","text":"颇费东君巧，晚春才有芳。\n森森紫毫束，艳艳粉囊张。\n凡木难仝谱，猗兰祇有香。\n花名传乐府，雅调更悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代饯行 其二","author":"卫宗武","text":"下车人已诵廉平，三载松江著令名。\n敏则有功无滞事，惠而为政及疲氓。\n班班可纪郡曹美，去去先驰台掾声。\n腾实蜚英闻北阙，伫看紫诏趣亨程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代饯行 其一","author":"卫宗武","text":"比来长掾宰如君，退食时惟儒士亲。\n编简香中犹得味，簿书丛底不沾尘。\n乍交祇恨过从浅，每到须蒙问劳频。\n多少清风留鹤国，不堪折柳向西津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊","author":"卫宗武","text":"几度拟郊行，天公欠一晴。\n水寒鱼绝影，林暝鸟藏声。\n云敛天容净，雨馀山骨清。\n津桥小盘薄，梅有数枝横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城山墓域行至赵村","author":"卫宗武","text":"才出城山路，云收霁景呈。\n乾端顿轩豁，山色更晶明。\n远近烟村露，微茫野水横。\n平头今七十，此地几经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山晚步","author":"卫宗武","text":"远岫烟光合，天寒欲敛昏。\n栖鸦依古木，归艇入前村。\n岸隔山藏寺，潮生水到门。\n川原浑似旧，伫立暗销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归舟","author":"卫宗武","text":"回艇临塘路，牵夫欣路平。\n归鸿千里近，过鸟一身轻。\n溪派分头去，山光恋眼明。\n松江水云际，屈指不多程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次华谷咏梅韵","author":"卫宗武","text":"宜烟宜雨更宜晴，竹底何妨枝带横。\n雅致耻随春富贵，英姿不怕月分明。\n吟边兴动诗添韵，醉里香传梦亦清。\n一自孤山题品后，此花标格孰能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵咏梅","author":"卫宗武","text":"直疑姑射地行仙，绰约如临几案前。\n和竹半攲能去俗，与兰并列盍饶先。\n林间姿艳同霜洁，窗下精神待月传。\n剩欲栽培为老伴，相亲日日在吟边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵幽居","author":"卫宗武","text":"柴荆长日闭，一径窈而深。\n花竹四时趣，简编千古心。\n户庭无俗驾，风月入骚吟。\n种秫多为酒，客来须共斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵雪积即消","author":"卫宗武","text":"冯夷剪水抑何悭，祇怕天工未许閒。\n上瑞先春才破白，屡丰卜岁已窥斑。\n可怜俄顷消成水，不怕明朝失却山。\n金帐羊羔非我事，汲清煮茗课奴蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答柯提干","author":"卫宗武","text":"年来人物慨凋零，义重交盟嵩华轻。\n一苇匪遥秋水隔，两章相映夜光明。\n乾坤何日可还古，风月于人无异情。\n姑把愁怀寄觞咏，出门一笑九山横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自霅还登舟","author":"卫宗武","text":"日日上巑岏，吟边饱看山。\n笋舆穿岭遍，桂楫汎溪还。\n芳草垂杨际，行云流水间。\n往来身不系，未羡白鸥閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至上基祖坟","author":"卫宗武","text":"小径入山村，行行及墓门。\n丰林俱易种，古木失常尊。\n重怅松楸地，多为荆棘原。\n青青一抔土，马鬣喜犹存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行分途次野渡韵","author":"卫宗武","text":"同舟李郭喜相亲，尽日赓酬夜至分。\n未信诗能穷我辈，不应天遽丧斯文。\n相违虽判城西路，有约同看岭上云。\n从此吟毫可停运，祇疑风月未饶君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟近吴兴郡见山","author":"卫宗武","text":"一舸夷犹白浪间，抬头俄喜对青山。\n平生每见便刮目，今日重来不改颜。\n城郭衣冠应寂寂，川原草木尚斑斑。\n馀龄未艾须时到，健笔犹能记往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟泊姑苏","author":"卫宗武","text":"夜泊垂杨古渡头，片帆已喜到邻州。\n经从城郭惊前梦，寂寞川途异旧游。\n近事能知惟语燕，馀生何有付盟鸥。\n可堪人与春俱老，落絮飞花点点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访山庵","author":"卫宗武","text":"弥月住山家，晴天物色奢。\n莺迁对人语，蜂聚报僧衙。\n笋老欲成竹，蕙香开遍花。\n清吟无个事，冉冉送春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安吉县梅溪二首 其二","author":"卫宗武","text":"纵步历前村，翛然幽趣深。\n鸣鸿归别渚，倦鹊立寒林。\n烟树远横带，云甍高耸岑。\n随风数声笛，清绝似龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安吉县梅溪二首 其一","author":"卫宗武","text":"壮年知几到，幽径喜重寻。\n异世桃源路，暮春梅子林。\n屏山森秀色，槃涧漱清音。\n迤逦穷幽渺，山行不厌深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安吉城","author":"卫宗武","text":"一年两到吴兴郡，梦想往时云锦乡。\n败堞颓垣尚围绕，雕梁画楝总凄凉。\n萧萧适际风寒候，黯黯全无山水光。\n日暮楼头鸣鼓角，声声悲壮断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吴兴城","author":"卫宗武","text":"两溪浮玉浸晴空，万井楼台一苇通。\n舟过恍如蓬岛客，人行疑在广寒宫。\n青山迎送犹佳友，绿鬓往来成老翁。\n遐想坡仙莘老辈，迩来那复有遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过秀城哭叶倅 其一","author":"卫宗武","text":"一见负吾愿，人亡乃及门。\n温乎容可即，俨若像如存。\n满拟朋三寿，那知隔九原。\n瓣香倾老泪，伫立黯消魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过秀城哭叶倅 其二","author":"卫宗武","text":"久矣致生刍，斯行夫岂徒。\n不惟哀一老，亦欲识诸孤。\n魏笏期传祖，韦经在业儒。\n子平仙去早，万事付长吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过荻塘","author":"卫宗武","text":"烟火人村盛，川途客旅稠。\n荻塘三百里，禹甸几千畴。\n绵络庐相接，膏腴稼倍收。\n经从少至老，复此系扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过荻塘次韵","author":"卫宗武","text":"平林历历晓云迷，津堠将迎客棹西。\n千古兴亡泰伯国，一川经纬狄公堤。\n雨添柳色成蛾绿，春剩花香散麝脐。\n去去苕城知不远，摩挲老眼看山溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过菁山秀王墓","author":"卫宗武","text":"对案毬狮衮，来冈阵马驱。\n谶书曾昔验，王气慨今无。\n犹喜王侯冢，免遭诗礼儒。\n葱葱馀壤树，柯叶尚纷敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过墓邻僧寺","author":"卫宗武","text":"一见说交情，僧醪为客斟。\n溪山衔落照，杉竹聚清阴。\n日对画图轴，风生琴筑音。\n意行行不足，逸兴对高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过新丰村偶成","author":"卫宗武","text":"咫尺是江城，欲前犹未能。\n舟行寻宿泊，村近问名称。\n愁聚眉常敛，吟穷思屡凝。\n新丰旧游地，过骑免凭陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初春次文友韵","author":"卫宗武","text":"原郊稚绿未成苍，芽甲森森似猬芒。\n急景不堪乌兔跃，新年又见燕莺忙。\n看看地列千机锦，冉冉风传百和香。\n人事不如春事好，芳菲徒自满河阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别陈玉峰","author":"卫宗武","text":"三载相亲久，临分思黯然。\n不堪兰佩远，近在菊花前。\n欲买尧夫宅，难移杜曲田。\n台山千万叠，书有雁能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席赓喜雪韵","author":"卫宗武","text":"崇峦九叠破天悭，地远尘嚣隔几关。\n方恨重云封皓月，俄惊半夜老青山。\n莫嫌腊后欠三白，且喜春前露一斑。\n几度冬来逢上瑞，更祈盈尺送舟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听莺","author":"卫宗武","text":"羽族满幽谷，绵蛮声更多。\n翠林深万绪，金羽掷双梭。\n破晓频惊梦，叫云如解歌。\n弓丸那可近，鸣跃在高柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张石山迁居","author":"卫宗武","text":"于我已渠渠，迁乔喜得庐。\n挈来三釜粟，更有一床书。\n叠石境不俗，得山名岂虚。\n从今来问字，门外列高车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹","author":"卫宗武","text":"淑景骎骎到牡丹，探芳日日倚楹栏。\n巧心吐出黄金缕，腴脸开成紫玉盘。\n春晚有花飞欲尽，山中此种得应难。\n便须收拾归囊锦，更酌清尊仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹和韵二首 其二","author":"卫宗武","text":"似盘还似囷，尊号擅芳名。\n洛土分来种，景星流作英。\n纷敷为绝色，向背若含情。\n别久喜相对，开尊话旧盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹和韵二首 其一","author":"卫宗武","text":"红紫富轮囷，京花非浪名。\n相看仝国色，独酌愧耆英。\n物好能移老，春归更有情。\n桑榆阴未徙，尚拟续芳盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩入屋韵","author":"卫宗武","text":"得庐莫恨太婆娑，缭以芳蘅葺以荷。\n徙舍借车家具少，架书充栋手编多。\n且甘穷巷饮瓢乐，须有文朋载酒过。\n他日不妨更爽垲，诗人宁逊庾并罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩以青溪至有作","author":"卫宗武","text":"故人未到欠诗催，才到九山云为开。\n野鹤正思寻老伴，盟鸥亦竞喜朋来。\n免教北陇惭空帐，消得南山咏有台。\n梅信已传花信动，直须领客待春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩述志 其一","author":"卫宗武","text":"蠹简钻研眼欲穿，读书何似夏侯玄。\n文传可使纸增价，酒尽何妨尊屡眠。\n唾落成珠皆至宝，笔耕有粟胜良田。\n席珍尽足需时聘，经史何劳手更编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丹岩述志 其二","author":"卫宗武","text":"室罄囊空气不衰，朵颐宁肯舍灵龟。\n多金未羡陶朱富，淅玉姑为杜老炊。\n暖客情难到貂鼠，惠人智不及蒲葵。\n春风可笑随流俗，不长桃枝长棘枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人秋怀","author":"卫宗武","text":"林薮发枯山敛眉，凛秋岂但楚臣悲。\n翩翩莺燕知何往，猎猎鹰鹯正得时。\n残雨晓添衣气润，新寒夜厌漏声迟。\n悲风入调须频奏，妙趣惟应心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文友催梅","author":"卫宗武","text":"日昴验星躔，阳和梅占先。\n未教疑雪似，早已夺春妍。\n少缓芳蕤放，多令秀句传。\n输君探山意，日日醉花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叶干庆七秩诗","author":"卫宗武","text":"不图闻达老何求，久矣甘为农服畴。\n晚岁但知书甲子，希年徒自富春秋。\n作朋何敢班耆父，招隐犹堪共钓游。\n寄语纷纷朝市客，狐裘未必似羊裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和玉峰春吟","author":"卫宗武","text":"年来愁似海波深，柏酒明朝试一斟。\n那复苏堤追胜赏，不妨楚泽效狂吟。\n金幡晓赐梦何在，红旆春行步莫寻。\n料得宫花仍似旧，应无堕珥与遗簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张石山惜春韵 其一","author":"卫宗武","text":"天涯芳草路，几度拟幽寻。\n怀古空陈迹，伤春徒苦心。\n花残犹宿蝶，柳暗已藏禽。\n天地年来别，一春常是阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张石山惜春韵 其二","author":"卫宗武","text":"满眼物华媚，芳辰与意违。\n愁多何乐少，昨是岂今非。\n转蕙光风老，流花过雨肥。\n春来传好事，空又送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张菊存寄诗二首 其二","author":"卫宗武","text":"一纸飞云端，骊珠得所难。\n句成春草梦，香带古梅寒。\n愿见期倾盖，远游思整冠。\n乘流问陶径，剩借菊吟看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张菊存寄诗二首 其一","author":"卫宗武","text":"江湖诗价满，竞说弟兄难。\n才压曹刘短，气凌郊岛寒。\n骚坛新领袖，上国旧衣冠。\n未见诗先得，今人作古看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和咏雪二首 其二","author":"卫宗武","text":"飞霙应冬候，志喜属诗人。\n远岫千尖没，寒林一色新。\n年丰呈上瑞，天巧占先春。\n比屋银成屋，民贫岂疗贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和咏雪二首 其一","author":"卫宗武","text":"六出天施巧，时哉更可人。\n后庚三日至，来复一阳新。\n破白祥开腊，剪红工胜春。\n羊羔金帐饮，宜富不宜贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和青溪山行","author":"卫宗武","text":"北崦共幽寻，森森万绿新。\n柳阴停雨棹，柏径岸风巾。\n幸有宽閒野，堪娱老病身。\n祇怜人事异，沧海亦扬尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和南塘","author":"卫宗武","text":"历遍崔嵬又涉川，菊秋还见早梅天。\n重来槁顶惟添老，屡对青山似有缘。\n携友拟为深谷隐，有僧可问小乘禅。\n临风却忆南塘老，便脱芒鞋棹去船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戚秋涧遗诗 其一","author":"卫宗武","text":"登金步玉信无缘，二十年来喜服田。\n肯羡鸣春为候鸟，自甘饮露作寒蝉。\n嗜閒倦举吟风笔，叹老贫无钓月船。\n但得有钱供客醉，绝胜名字挂凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戚秋涧遗诗 其二","author":"卫宗武","text":"欲废推敲几岁华，诗葩君至复萌芽。\n吟章既富旧成帙，生计无多新载家。\n胸著古今书拍塞，墨行真草字横斜。\n年逾八十身方健，高把松乔寿未涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁七夕吟","author":"卫宗武","text":"暗度双星见者希，那堪雾气更霏霏。\n为云为雨观如梦，一岁一宵来即归。\n玄鹊有灵劳翼负，素娥含恨减腰围。\n綵楼误却穿针女，玉宇银潢欠发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和象翁雪 其二","author":"卫宗武","text":"剪水天为农发祥，岂知寒卧欲成僵。\n朱门快意酒肉会，墨客驰神词翰场。\n梁苑集中呈赋手，灞桥行处吐诗香。\n羊羔茗饮评清浊，相去何殊千丈强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]