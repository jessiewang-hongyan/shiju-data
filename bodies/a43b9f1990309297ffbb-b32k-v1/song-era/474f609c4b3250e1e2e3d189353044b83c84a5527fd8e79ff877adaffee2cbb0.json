[{"title":"山中偶作五首 其四","author":"释守卓","text":"渐老便幽僻，西来意亦迷。\n不知师子吼，何似野猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中偶作五首 其五","author":"释守卓","text":"爽快怜清景，迟回出草庵。\n寒山一倾盖，明月印寒潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩畔春将老四首 其一","author":"释守卓","text":"岩畔春将老，香风匝地生。\n囊藏无底钵，高卧笑毗城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩畔春将老四首 其二","author":"释守卓","text":"岩畔春将老，残花自点苔。\n牛头峰下客，曾见祖师来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩畔春将老四首 其三","author":"释守卓","text":"岩畔春将老，阶前碧草深。\n浏阳好风骨，一句有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩畔春将老四首 其四","author":"释守卓","text":"岩畔春将老，憨痴兴转多。\n时时逢野老，共唱哩棱啰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜","author":"释守卓","text":"密携光景共因循，谁为俱忘是要津。\n毫发不移人自老，看看啼鸟报芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧问六相义因示以偈","author":"释守卓","text":"天上火星地下走，泥牛踏著烧却口。\n驴儿害痛马人瞋，打落杨梅三五斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞻双塔","author":"释守卓","text":"竞传垂手设三关，又说常锋示一拳。\n谁信云根涌双塔，松风历历更幽玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉初志","author":"释守卓","text":"四山相逼势如奔，三鼠侵藤那久存。\n莫倚少年轻白日，急须回首入空门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其一","author":"释守卓","text":"衲僧无作为，亦不坐无作。\n红尘本自寂，谁解释尘纷。\n一机虽妙常，要如千钧弩。\n弩满发机全，破的惟等闲。\n持此入红尘，是谓尘中眼。\n应变犹如如，善导无所事。\n贫富自谁何，知音即所遇。\n得意早归来，资吾无尽藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其二","author":"释守卓","text":"谁管川途冻未开，笑持铁钵出山来。\n心花不落东君手，待把灵根火里栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其三","author":"释守卓","text":"火里生莲世岂知，入廛须是丈夫儿。\n毗耶老汉如相扣，报道年来眼搭眵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其四","author":"释守卓","text":"甘露无底钵，禅人要拈拨。\n浩浩尘土中，一佛二菩萨。\n撞著老维摩，轻轻共伊说。\n施者非福田，是谁纳败阙。\n咦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其五","author":"释守卓","text":"本觉本来明，乘缘须体妙。\n壁立何匹俦，沤和生谈笑。\n万化了全机，千机全一照。\n波昏月岂亡，水清光自曜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其六","author":"释守卓","text":"林下既了空，尘中须达事。\n随事了真空，自空展化事。\n事空空事中，淘镕成宝器。\n宝器盛醍醐，是曰甘露味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诸方行化 其七","author":"释守卓","text":"食施何如法施均，绿杨青草几番春。\n擎盂好好廛中去，莫惜眉毛指向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座右铭","author":"释守卓","text":"觉变则迷，识澄则悟。\n作止因依，生死交互。\n妙矣灵通，混然本素。\n用与性齐，语与默寓。\n三世现前，十方顿赴。\n非知而知，不住而住。\n永言大观，唯心是务。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"止堂铭","author":"释守卓","text":"旨哉斯堂，全观全止。\n是止亦止，应现何已。\n法尔而然，不默则病。\n必尔之归，渊默生定。\n妙定圆极，心精发光。\n不出户牖，灵鉴十方。\n既超动静，无住者存。\n居之而安，左右逢原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其一","author":"释守卓","text":"年来乍住甘露，痴钝无可作做。\n刚被王官差排，业缘无能回互。\n祇得逐浪随波，从教诸方流布。\n门前旋买新盐，瓮里有些陈醋。\n来者觅茶与茶，大似虽贫而富。\n更问祖师西来，老也得住且住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其二","author":"释守卓","text":"四维风景寥寥，极目晴空廓落。\n孰为好丑是非，何用识情卜度。\n石火迸光，清秋一鹗。\n言前得旨已周遮，句后无踪徒摸索。\n劄著不行，秦时?轹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其三","author":"释守卓","text":"久雨不晴今日晴，和泥合水要分明。\n虚空湿了何妨事，依旧太阳东畔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其四","author":"释守卓","text":"日出卯，闹炒炒。\n于其中，须善巧。\n打面还他州土麦，唱歌须是帝乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其五","author":"释守卓","text":"的的无来去，明明有旧新。\n去年今日事，今日去年人。\n脱体全收放，随流混主宾。\n春光重漏泄，有口不须陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其六","author":"释守卓","text":"步步登高，从空放下。\n南北东西，曾无缝罅。\n教外别传，一切话霸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其七","author":"释守卓","text":"风非别凉，火是本热。\n冷坐九年，元来未瞥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其八","author":"释守卓","text":"飞金乌，走玉兔，刹那之间成新故。\n一阳复处透全身，露柱开花还峭措。\n炒茅栗，煮山芋，衲僧活计随时做。\n胡家曲拍自分明，晷运推移何处去。\n堪嗟茫茫尘世人，几个暂行休歇路。\n今年不见去年人，多少今人成古墓。\n张三李四醉昏昏，笑杀甘露拄杖子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其九","author":"释守卓","text":"劝公一，识取心王万事毕。\n六尘堆里拾得来，历劫元来未曾失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十","author":"释守卓","text":"释迦掩室，过犯弥天。\n维摩杜词，自救不了。\n如何如何，口门太小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十一","author":"释守卓","text":"付法传心，将错就错。\n立雪断臂，随邪逐恶。\n本色衲僧，如何评溥。\n达磨大师，露出一膊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十二","author":"释守卓","text":"一雨一晴，岩桂加青。\n释迦骨髓，弥勒眼睛。\n途中无限拖泥者，问渠何日是归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十三","author":"释守卓","text":"黄河水，出昆崙，要得分明转见昏。\n若欲迥超无间业，灭却如来正法轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十四","author":"释守卓","text":"空中呈鸟迹，水上露灯毬。\n要辨渠端的，玉人骑铁牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十五","author":"释守卓","text":"因行不妨掉臂，求他不妨求己。\n面前山子若存，处处无风浪起。\n一声鸿雁忽闻时，尽在愁人窠窟里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十六","author":"释守卓","text":"孤村黄叶落，深院桂花香。\n志士惜日短，愁人知夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十七","author":"释守卓","text":"风从何来，雨从何至。\n皮下有血，面上有鼻。\n脱体相呈，全无忌讳。\n明眼衲僧，更须瞥地。\n瞥地如何，且莫瞌睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十八","author":"释守卓","text":"落花随流水，啼鸟在深云。\n莫怪多违背，年高耳目昏。\n岂不见七百甲子老禅翁，对人祇道东门西门南门北门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十九首 其十九","author":"释守卓","text":"昨朝炒炒闹，今朝闹炒炒。\n波斯失白氎，拾得铁钱钞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其一","author":"释守卓","text":"心心心，佛佛佛。\n心佛佛心，心心佛佛。\n心佛无二，更须知有向上一窍。\n如何是向上一窍，南瞻部州，北郁单越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二","author":"释守卓","text":"见见须教透顶门，顶门开处宝光分。\n照彻古今无比况，犹来佛祖是儿孙。\n到头珠有水，未免线因针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其三","author":"释守卓","text":"真不掩伪，开眼瞌睡。\n曲不藏直，犹较些子。\n鱼目明珠，都卢在汝。\n更拟如何，未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其四","author":"释守卓","text":"人无心合道，困来不觉和衣倒。\n一老一不老，法身真个入荒草。\n了无来，随分讨，粪扫堆头拾得宝。\n木人石女共欢呼，信手拈来用恰好。\n青山无尽意无穷，何须更觅来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其五","author":"释守卓","text":"二月桃花红，三月李花白。\n要调满庭芳，须会十八拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其六","author":"释守卓","text":"开眼即迷，闭眼即错。\n古佛巴鼻，何处摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其七","author":"释守卓","text":"会与不会，拈却一对。\n直截如何，风不鸣条，雨不破块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其八","author":"释守卓","text":"欲明生死须穷道，一叶落时天下秋。\n不涉去来常变化，归根得旨但随流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其九","author":"释守卓","text":"晴来又雨，雨了又晴。\n辉天电闪，震地雷鸣。\n争奈室中人不闻何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十","author":"释守卓","text":"古佛真宗，弥满成现。\n明眼衲僧，作么生辨。\n切忌撞头磕脑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十一","author":"释守卓","text":"粪扫堆头丈六身，入泥入水出家人。\n丈夫自有通方眼，认著珍时不是珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十二","author":"释守卓","text":"岁时驹过隙，倏忽十月初。\n今年寒较早，前日已开炉。\n炉边向去者，各各护眉须。\n分明一路无寒暑，不知何日是归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十三","author":"释守卓","text":"日出心光耀，堂堂更孤峭。\n天阴性地昏，风寒早闭门。\n不知天地者，刚道有乾坤。\n欲明还得暗，打破却浑仑。\n争如回首家乡路，寒食依前是暮春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十四","author":"释守卓","text":"心同虚空界，个中有买卖。\n示等虚空法，处处皆周匝。\n證得虚空时，全收复是谁。\n无是无非法，一离还一合。\n不因霜雪苦，那辨岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十五","author":"释守卓","text":"云从龙，风从虎，大地谁言无寸土。\n三阳肇处布新春，明明独露乾坤祖。\n谁知毗耶老病翁，默尔忘言善谈吐。\n不落四句彻三玄，还他一二三四五。\n报尔栴檀林下人，应时纳祐还知否。\n收来横骨暗中抽，放去随群作水牯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十六","author":"释守卓","text":"诸佛不出世，四十九年说。\n千江有水千江月，万里无云万里天。\n祖师不西来，少林有妙诀。\n西天此土俱拈却，一种平怀当处亲。\n若人识祖佛，当处便超越。\n大尽三十日，小尽二十九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十七","author":"释守卓","text":"生死即涅槃，涅槃即生死。\n全迷即全悟，全死即全生。\n魔佛齐平，孰为非道。\n又须知生死非涅槃，涅槃非生死。\n无生死而不显涅槃，无涅槃而不度生死。\n法法显然，尘尘自离。\n到者里，更须有转身一路。\n若也转得，枯木枝头，别迎春色。\n踢倒铁围山，踏翻生死海。\n从教月色和云白，管取春来草又青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十八","author":"释守卓","text":"一月普现一切水，一灯能传百千灯。\n此时不彻全身句，眨起眉毛已葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其十九","author":"释守卓","text":"大圆鉴中同结社，一微尘里共安居。\n释迦弥勒无门入，不到到者真丈夫。\n大丈夫汉，撩著便知来由，不为分外。\n若更拟议踌躇，何啻云泥万里。\n所以道十五日已前点即不到，十五日已后到即不点。\n且道点即是，不点即是。\n长因虎啸风生处，记得龙吟雾起时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二十","author":"释守卓","text":"五五二十五，人人超佛祖。\n撩著未知机，黄金成粪土。\n诸禅德，莫莽卤，夷门山朝朝走入。\n新罗占波国里，卖吉州针。\n相逢醉老婆，寻牛撞著虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二十一","author":"释守卓","text":"逢庚则伏，狸奴昨外暍死。\n遇明则苏，白牯今朝律活。\n全活全死，全死全活。\n死活两忘，是个什么。\n到这里，也须是个汉始得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二十二","author":"释守卓","text":"长期告毕，法岁云周。\n木人施草，石女行筹。\n衲僧了无交涉，那更头上安头。\n横担楖栗，笑傲清秋。\n要去即去，得留且留。\n逢人若问长灵老，向道浩浩尘中斗铁牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二十三","author":"释守卓","text":"过现无三世，星霜有四明。\n秋残心似口，冬至眼如眉。\n了了何依住，新新孰变移。\n岁寒同饮啄，冷暖自家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十四首 其二十四","author":"释守卓","text":"心心心，莫谩寻。\n道道道，已蹉过。\n不蹉过，是什么。\n一机全，步步到。\n木马已追风，瞎驴倒推磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终前一日和云门曲","author":"释守卓","text":"衲僧要唱云门曲，六六从来三十六。\n曹源有个痴禅人，解道一生数不足。\n数不足，不属金石与丝竹。\n等闲一拍五音全，直道如弦已曲录。\n从教岁去年来，依旧山青水绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太白画歌","author":"饶节","text":"先生之气盖天下，当时流辈退百舍。\n醉中咳唾落珠玑，身后声名满夷夏。\n青山木拱三百年，今晨乃拜先生画。\n乌纱之巾白纻袍，岸巾攘臂方出遨。\n神游八极气自稳，冰壶玉斗霜风高。\n呜呼先生泰绝伦，仙风道骨语甚真。\n肃然可望不可亲，悬知野鹤非鸡群。\n天宝之初天子逸，先生醉去不肯屈。\n采石江头明月出，鼓枻酣歌志愿毕。\n只今遗像粉墨间，尚有英风爽毛骨。\n宣州长史粉黛工，谁令写此人中龙。\n细看笔意有俯仰，妙处果在阿堵中。\n人云此画世莫比，吴侯得之喜不寐。\n意侯所爱岂徒尔，亦惜真才死泥滓。\n先生朽骨如可起，谁为猎之奉天子。\n作为文章文圣世，千秋万古诵盛美。\n再拜先生泪如洗，振衣濯足吾往矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送故人","author":"饶节","text":"秋风夜作万马声，草木自有离别情。\n君行胡不卜春夏，况我抱病方竛竮。\n我生不祥忧患并，行李四方影随形。\n少年之气追琢尽，胸中独抱渭与泾。\n世人纷纷水火争，我欲从之惫不能。\n骑马时寻故人舍，掀髯抵掌意自倾。\n图书万卷相将迎，座无凡儿眼更明。\n惟酒无量与兴会，我醉未去君经营。\n不用赐金为解酲，一月何必一日醒。\n此中万事气自宁，勿语世人人不听。\n君今胡为忽戒行，使我此计堕杳冥。\n君行潇湘绝洞庭，沙头水落鼍夜鸣。\n想君抱恨寐辄惊，起吊湘累涕泪横。\n顾我胡为世网婴，前行霜露后榛荆。\n谁为传之凤凰翎，与君方驾寻此盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送傅仲默登第归麻姑","author":"饶节","text":"谢安中年不堪别，况我与子本末同。\n临川古郡著名数，麻姑且在邦域中。\n与君同方复同术，十年共度齑盐日。\n一身烂漫天地中，万里风霜今白发。\n南山之封木拱矣，此身万事相终始。\n何知迟暮犹羁旅，夜语对床辄三起。\n君今先著祖生鞭，我穷未办买山钱。\n君行启我方寸乱，抱琴长歌声彻天。\n西风萧萧木脱叶，表里家山落眉睫。\n为语淮南大小山，虽在侯门不弹铗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]