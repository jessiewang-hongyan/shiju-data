[{"title":"高宗明堂前朝献景灵宫十首 其十 望燎用《乾安》。","author":"郊庙朝会歌辞","text":"奕奕原祠，有严毖祀。\n礼仪孔宣，燔燎斯暨。\n帝心肃祗，天步旋止。\n熙事既成，永膺蕃祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其九 送真用《太安》。","author":"郊庙朝会歌辞","text":"高飞安翔，持御阴阳。\n幽赞圆穹，监观四方。\n元精回复，奄虞孔良。\n毕觞降嘏，偃蹇于骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其八 彻馔用《吉安》。","author":"郊庙朝会歌辞","text":"洋洋降临，肃肃布列。\n熙事既成，嘉笾告彻。\n九天储庆，垂佑无缺。\n寖明寖昌，绵绵瓜瓞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其七 饮福用《报安》。亚、终献《冲安》用旧辞。","author":"郊庙朝会歌辞","text":"于赫大神，总司元化。\n监我纯精，威光来下。\n延昌之贶，千亿冯藉。\n曾孙保之，丕平是迓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其六 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"进旅退旅，载执干戚。\n不愆于仪，容服有赫。\n式妥式侑，神保是格。\n灵鉴孔昭，孝思维则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其五 圣祖位酌献用《祖安》。","author":"郊庙朝会歌辞","text":"裴回若留，灵其有喜。\n荐我馨香，挹兹酒醴。\n我祖在天，执道之纪。\n申佑无疆，奏神称礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其四 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"琼琚锵锵，玄衣绣裳。\n荐嘉升香，粢盛芬芳。\n礼仪莫愆，鼓钟喤喤。\n曾孙之常，绥福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其三 圣祖位奠玉币用《灵安》。","author":"郊庙朝会歌辞","text":"玉气如虹，丰缯充笥。\n既奉既将，亦奠在位。\n有永群后，实相祀事。\n何以临下，心意不贰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其二 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"帝既临享，龙驭华耀。\n孝孙承之，陟降在庙。\n诚意上交，庆阴下冒。\n天休骈至，千亿克绍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗明堂前朝献景灵宫十首 其一 降圣用《大安》。","author":"郊庙朝会歌辞","text":"德惟馨香，升闻八方。\n粤神之从，灿然有光。\n骖飞乘苍，啾啾跄跄。\n消摇从容，顾予不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其三十 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"盛德丰功，一祖六宗。\n钦翼燕诒，禋享是崇。\n厉意齐精，假庙惟恭。\n率礼周旋，福禄来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十九 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"于皇上天，钦哉成命。\n集于冲人，丕承列圣。\n爰熙紫坛，于庙告庆。\n肸蚃潜通，休祥荐应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十八 送神用《兴安》。","author":"郊庙朝会歌辞","text":"神之来游，风马云车。\n淹留彷佛，顾瞻欷歔。\n神之还归，钧天帝居。\n监观于下，何福不除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十七 尚书彻豆用《丰安》。","author":"郊庙朝会歌辞","text":"熙事既成，嘉笾告彻。\n洋洋来临，蔼蔼布列。\n配帝其功，在天对越。\n允集丛釐，万邦和悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十六 还位用《乾安》。","author":"郊庙朝会歌辞","text":"帝既临享，步武鸣鸾。\n陟降规矩，颙昂周旋。\n登歌一再，典礼莫愆。\n神之听之，祉福绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十五 饮福用《禧安》。","author":"郊庙朝会歌辞","text":"赫赫明明，维祖维宗。\n鉴于文孙，维德之同。\n日靖四方，亦同其功。\n亿万斯年，以承家邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十四 皇帝再升位诣饮福位用《乾安》。","author":"郊庙朝会歌辞","text":"维皇亲享，至再至三。\n礼备乐奏，层陛森严。\n粢盛芳洁，酒醴旨甘。\n云车风马，从卫观瞻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十三 皇帝出小次用《乾安》。","author":"郊庙朝会歌辞","text":"夙戒告备，礼节俯成。\n妥侑惟乾，氛氲夜澄。\n有严有翼，列圣灵承。\n于穆清閟，肃肃无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十二 终献用《正安》。","author":"郊庙朝会歌辞","text":"疏幂三举，诚意一纯。\n孰陪予祀，公族振振。\n神具醉止，燕娭窈冥。\n于万斯年，绥我思成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十一 亚献用《正安》。","author":"郊庙朝会歌辞","text":"威神在天，享于克诚。\n申以贰觞，式昭德馨。\n笾豆孔嘉，乐舞具陈。\n庶几是听，福禄来成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二十 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"八音谐律，缀兆充庭。\n进旅退旅，肃恭和平。\n盛荐祖宗，灵监昭升。\n象功崇德，遹观厥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十九 入小次用《乾安》。","author":"郊庙朝会歌辞","text":"于皇我后，祗戒专精。\n躬制声诗，文思聪明。\n雍容戾止，玉立端诚。\n神听如在，福禄来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十八 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"明德惟馨，进止回复。\n裼袭安恭，严若惟谷。\n诚意昭融，群工袂属。\n成此祲容，生乎齐肃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十七 徽宗室用《承元》。御制。","author":"郊庙朝会歌辞","text":"于皇烈考，道化圣神。\n尧聪舜孝，文恬武忻。\n命子出震，遗骏上宾。\n罔极之哀，有古莫伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十六 哲宗室用《重光》。","author":"郊庙朝会歌辞","text":"明哲煌煌，照临无疆。\n绍述先志，寔宣重光。\n诒谋燕翼，率由旧章。\n苾芬孝祀，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十五 神宗室用《大明》。","author":"郊庙朝会歌辞","text":"烝哉维后，继明体神。\n稽古行道，文物一新。\n润色鸿业，垂裕后人。\n灵斿沛然，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十四 英宗室用《治隆》。","author":"郊庙朝会歌辞","text":"穆穆英宗，持盈守成。\n世德作求，是缵是承。\n齐家睦族，偃武恢文。\n于荐清酤，酌之欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十三 仁宗室用《美成》。徽宗御制。","author":"郊庙朝会歌辞","text":"仁德如天，遍覆无偏。\n功济九有，恩涵八埏。\n齐民受康，朝野晏然。\n击壤歌谣，四十二年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十二 真宗室用《熙文》。","author":"郊庙朝会歌辞","text":"思文真宗，体道之崇。\n憺威赫灵，遵制扬功。\n真符鼎来，告成登封。\n盛德百世，于昭无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十一 太宗室用《大定》。","author":"郊庙朝会歌辞","text":"皇矣太宗，嗣服平成。\n益奋神旅，再征不庭。\n文武秉德，仁孝克明。\n以圣传圣，对越紫清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其十 太祖室用《皇武》。","author":"郊庙朝会歌辞","text":"为民请命，皇祖赫临。\n天地并贶，亿万同心。\n造邦以德，介福宜深。\n挹彼惟旨，真游居歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其九 宣祖室用《天元》。","author":"郊庙朝会歌辞","text":"昭哉皇祖，源深流长。\n雕戈圭瓒，休有烈光。\n天祐潜德，继世其昌。\n永怀积累，嘉荐令芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其八 翼祖室酌献用《大顺》。","author":"郊庙朝会歌辞","text":"天命有开，维仁是依。\n乃眷冀邦，于以顾之。\n其顾伊何，发祥肇基。\n施于孙子，虔奉孝思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其七 僖祖室酌献用《基命》。","author":"郊庙朝会歌辞","text":"思文僖祖，基德之元。\n皇武大之，受命于天。\n积厚流光，不已其传。\n曾孙笃之，于万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其四 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"秬鬯既将，黄钟具奏。\n肃我祖考，祗栗以俟。\n于皇列圣，在帝左右。\n监观于兹，云车来下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其二 皇帝升殿用《乾安》。诣室、降殿并同。","author":"郊庙朝会歌辞","text":"皇皇大宫，丕显于穆。\n休德昭清，元气回复。\n芝叶蔓茂，桂华冯翼。\n孝孙假斯，受兹介福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其二十 望燎用《乾安》。","author":"郊庙朝会歌辞","text":"奕奕灵宫，有严毖祀。\n燔燎具扬，礼仪既备。\n帝心肃祗，天步旋止。\n对越在天，永膺蕃祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十九 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"我秩元祀，上推灵源。\n展事有侐，祲威肃然。\n丹墄既降，秉心益虔。\n荷天之休，于千万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十八 送真用《太安》。","author":"郊庙朝会歌辞","text":"雍歌既彻，熙事备成。\n神夕奄虞，忽乘青冥。\n灵心回眷，监我精禋。\n诞降嘉祉，休德昭清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十七 彻馔用《吉安》。","author":"郊庙朝会歌辞","text":"普淖既荐，苾芬孔时。\n神嗜而顾，有来燕娭。\n飨矣将彻，载钦载祗。\n展诗以侑，益臻厥熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十五 饮福用《报安》。","author":"郊庙朝会歌辞","text":"嘉荐既终，神贶斯复。\n赉我思成，灵光下烛。\n孝孙承之，载祗载肃。\n敷锡庶民，函蒙祉福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十四 亚、终献用《冲安》。","author":"郊庙朝会歌辞","text":"五音饬奏，神既亿康。\n澹其容与，荐此嘉觞。\n有来显相，鋗玉锵锵。\n奉承若宥，罔不斋庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十三 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"于皇乐舞，进旅退旅。\n一弛一张，笙磬具举。\n岂惟玩声，象德是似。\n神鉴孔昭，福禄来予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十二 还位用《乾安》。","author":"郊庙朝会歌辞","text":"奠鬯告成，式旋厥位。\n天步雍容，神人燕喜。\n九庙观德，百灵荐祉。\n子孙其昌，垂千万祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十一 圣祖位酌献用《祖安》。御制。","author":"郊庙朝会歌辞","text":"瑶源诞启，玉牒肇荣。\n覆育群有，监观圆清。\n酒醴既洽，登荐惟诚。\n无有后艰，骏惠云仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其十 再诣圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"于赫炎宋，十叶华耀。\n属兹郊报，陟降在庙。\n其降伊何，椒浆桂酒。\n再拜斟酌，永御九有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其九 再盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"有严大礼，对时休明。\n情文则粲，蠲洁必清。\n再临观盥，以专以精。\n真游来格，永观厥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其八 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"百职骏奔，来相于庭。\n奉盛以告，登兹芳馨。\n际天蟠地，默运三灵。\n神兮来歆，祚我休平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其七 还位用《乾安》。","author":"郊庙朝会歌辞","text":"我后临飨，奠币攸毕。\n式旋其趋，矩度有式。\n礼容斋庄，孝思纯实。\n天休滋至，时万时亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其六 圣祖位奉玉币用《灵安》。","author":"郊庙朝会歌辞","text":"上灵始祖，云景元尊。\n严祀夙展，六乐朱轩。\n明玉之洁，丰帛之温。\n畅乃继序，承德不愆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其五 圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"涓选休辰，有事嘉荐。\n琅琅琼佩，陟降岩殿。\n其陟伊何，币玉斯奠。\n周旋中礼，千亿储羡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其四 盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"斋居皇皇，琼琚锵锵。\n承祭之初，其如在旁。\n挹彼注兹，储禧迎祥。\n神之听之，欣欣乐康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其三 降圣用《太安》。","author":"郊庙朝会歌辞","text":"惟德馨香，升闻八方。\n粤神临之，来从帝乡。\n万灵景卫，有烨其光。\n监我精纯，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其二 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"帝既临飨，罄兹精意。\n对越在天，爰升紫陛。\n孔容翼翼，保承丕绪。\n孝奉天仪，永锡尔类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗郊前朝献景灵宫二十一首 其一 皇帝入门用《乾安》。","author":"郊庙朝会歌辞","text":"维皇齐居，承神其初。\n颙颙昂昂，龙步云趋。\n景钟铿如，肃觐清都。\n肸蚃之交，神人用孚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乾道别庙乐歌三首 其三 懿节皇后室酌献用《歆安》。","author":"郊庙朝会歌辞","text":"丕显文母，厚德维坤。\n仙驭虽邈，徽音固存。\n瑟彼玉瓒，酌此郁尊。\n简简穰穰，裕我后昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乾道别庙乐歌三首 其二 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"宗祀九筵，先荐閟宫。\n陟自东阶，煌煌衮龙。\n于穆圣善，监兹礼容。\n是享是宜，介福无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乾道别庙乐歌三首 其一 诣庙用《乾安》。","author":"郊庙朝会歌辞","text":"涓选休辰，于秋之杪。\n既齐既戒，爰假祖庙。\n有侐仪坤，旧章是效。\n享祀奚为，天子纯孝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 送神用《兴安》。","author":"郊庙朝会歌辞","text":"黍稷维馨，虡业充庭。\n既钦既戒，灵心是承。\n顾予烝尝，言从之迈。\n申锡无疆，是用大介。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 终献用《仪安》。","author":"郊庙朝会歌辞","text":"珩璜之贵，袆褕之尊。\n天作之合，内治慈温。\n元良钟庆，祉福乾坤。\n以享以祀，事亡如存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 退文舞、进武舞用《昭安》。","author":"郊庙朝会歌辞","text":"翩然干戚，扬庭陈阶。\n文以经纬，武以威怀。\n其张其弛，节与音谐。\n迄兹献享，妥灵绥来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 亚献用《神安》。","author":"郊庙朝会歌辞","text":"嫔于潜邸，爰正坤仪。\n关雎化被，思齐名垂。\n柔德益茂，家邦以熙。\n皇心追崇，永羞牲粢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 酌献用《兹安》。","author":"郊庙朝会歌辞","text":"雍雍玉佩，清酤惟良。\n粢盛具列，有飶其香。\n怀其徽范，德洽无疆。\n于兹燕止，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 升降殿用《熙安》。","author":"郊庙朝会歌辞","text":"笙箫纷如，陟彼庙庭。\n锵锵佩玉，怀兹先灵。\n神保聿止，音容杳冥。\n繁禧是介，万年惟宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 罍洗用《嘉安》。","author":"郊庙朝会歌辞","text":"列爵陈俎，芬芳和羹。\n摐金击石，洋洋和声。\n礼行伊始，我德惟明。\n既盥而往，于昭斯诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]