etry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其八 庞公","author":"刘克庄","text":"当日献皇后，逃生屋壁间。\n何如伴庞老，同入鹿门山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其六 姜诗","author":"刘克庄","text":"爱子死于汲，常情鲜不悲。\n贤哉孝廉妇，哭恐阿姑知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其五 梁鸿","author":"刘克庄","text":"嫁与张京兆，新眉扫黛浓。\n不如伯鸾妇，长伴藁砧舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其三 于陵","author":"刘克庄","text":"何必如郎伯，区区禄万钟。\n辟纑并织屦，足了一生中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其二 接舆","author":"刘克庄","text":"王遣金驷聘，先生已许王。\n徙家变名姓，非独接舆狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其一 黔娄","author":"刘克庄","text":"死无衾覆首，贫乃士之常。\n妇谥为康子，何须问太常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其七 乐羊","author":"刘克庄","text":"遗金不知主，视若盗泉然。\n相与弃之野，妇贤夫亦贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"处士妻十首 其四 老莱","author":"刘克庄","text":"王将托一国，自驾请先生。\n门外车迹众，莱妻投畚行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"左史倚相","author":"刘克庄","text":"善谑非为谑，微言可解纷。\n祈招忘出处，也道读三坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归至武阳渡作","author":"刘克庄","text":"夹岸盲风扫楝花，高城已近被云遮。\n遮时留取城西塔，篷底归人要认家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午上巳谒何恭人坟三绝 其二","author":"刘克庄","text":"华堂不洎千钟养，荒垄空遗四尺封。\n愁绝狐狸潭畔路，不知更扫几番松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午上巳谒何恭人坟三绝 其一","author":"刘克庄","text":"织素尘机长寂寞，燎黄锦诰谩荣华。\n堪同络秀书前史，谁为王符访外家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午上巳谒何恭人坟三绝 其三","author":"刘克庄","text":"当日封崇殊草创，末年付授绝悲哀。\n子孙记取吾翁语，斗酒单鸡岁岁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午生朝和居厚弟五绝 其二","author":"刘克庄","text":"符辈安能刬且编，可怜辛苦事雕镌。\n绝弦举世无能听，覆瓿他时未必传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午生朝和居厚弟五绝 其一","author":"刘克庄","text":"懒值悬弧浑不记，老当还笏复奚疑。\n潞公未得为全福，晚惜斋旄尚涕垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午生朝和居厚弟五绝 其五","author":"刘克庄","text":"曾结诗絇玉座傍，放狂归去老知章。\n钝迟一任嘲元白，迂阔皆因駮录黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊午生朝和居厚弟五绝 其四","author":"刘克庄","text":"灵龟曳尾防钻壳，老蚌潜光怕剖珠。\n史笔久无两龚传，画家曾有二疏图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊辰书事","author":"刘克庄","text":"诗人安得有春衫，今岁和戎百万缣。\n从此西湖休插柳，剩栽桑树养吴蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊辰重阳绝句","author":"刘克庄","text":"冯唐白首尚含香，卫武谆谆肯惰荒。\n万一享年如二老，犹堪烂醉十重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧游","author":"刘克庄","text":"扶胥黄木水连空，曾读韩碑访祝融。\n安得六丁机万弩，岷江西去海潮东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉儒二首 其二","author":"刘克庄","text":"卖赋长安偶遇知，后车归载远山眉。\n可怜犬子真穷相，不见刘郎过沛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉儒二首 其一","author":"刘克庄","text":"执戟浮沉亦未迂，无端著颂美新都。\n白头所得能多少，枉被人书莽大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玄山观","author":"刘克庄","text":"来瞻石像看唐碑，一径苍松映碧漪。\n闻说宋公曾住此，寄声过客细吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜李","author":"刘克庄","text":"蝇及瓜勿啖，螬食李何妨。\n苦淡谁知味，甘鲜或腐肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍","author":"刘克庄","text":"稚子呼牛女拾薪，莱妻自鲙小溪鳞。\n安知曝背庭中老，不是渊明辈行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍二首 其二","author":"刘克庄","text":"桀溺长沮振古豪，不能历聘遂深逃。\n獾郎一肚皮周礼，浪说求田意最高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍二首 其一","author":"刘克庄","text":"源里人家太古时，争为鸡黍款渔师。\n下山莫向城中说，第一休教太守知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其十","author":"刘克庄","text":"溪上渔郎占断春，一川碧浪映红云。\n问渠定是神仙否，橹去如飞语不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其七","author":"刘克庄","text":"条桑女子两鬟垂，车马过门未省窥。\n生长柴门蓬户里，安知世有二南诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其八","author":"刘克庄","text":"草草衣装挈自随，婿贫毕竟与齐眉。\n绝胜京洛倾城色，锁向侯门作侍儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其四","author":"刘克庄","text":"蹴鞠鞋尖尘不涴，臂鹰袖窄样新裁。\n社中年少相容否，也待鲜衣染鬓来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其二","author":"刘克庄","text":"村落争看乌角巾，略谈北事向南人。\n百年只有中州乐，世世无为塞下民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其三","author":"刘克庄","text":"古来观社见春秋，茜袂银钗尽出游。\n欲与鲁人同猎较，可怜身世尚它州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其九","author":"刘克庄","text":"儿女相携看市优，纵谈楚汉割鸿沟。\n山河不暇为渠惜，听到虞姬直是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其一","author":"刘克庄","text":"去年赢粟尚储瓶，又见新秧蘸水青。\n野老逢人说惭愧，长官清白社公灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其六","author":"刘克庄","text":"田舍诸雏各雅驯，男儿盍有艺资身。\n古来医卜多名世，莫学文章点涴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田舍即事十首 其五","author":"刘克庄","text":"邻壁嘲啾诵学而，老人睡少听移时。\n它年谨勿如张禹，帝问床前谬不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵","author":"刘克庄","text":"太行以北海丰南，我与梁公各有惭。\n儿五十馀亲八十，可堪来宿白云庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白杜迓客一首","author":"刘克庄","text":"贫食官仓不自由，强扶衰病坐荒邮。\n送迎不是祠官事，偶见青山急下头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其三","author":"刘克庄","text":"恰召阳翁伯，俄徵谢自然。\n不知玉楼上，几个是诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其十七","author":"刘克庄","text":"海岛五百士，刘郎庐亦深。\n不似阿罗汉，神通无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其六","author":"刘克庄","text":"乍见作飞势，细听无唳声。\n雪翎差髣髴，丹顶不分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其五","author":"刘克庄","text":"吾脚今无力，安能跪鞠躬。\n北瞻韩吏部，南仰狄梁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其十八","author":"刘克庄","text":"此来为佳处，高犹在绝颠。\n吾衰中道废，汝少更加前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其十六","author":"刘克庄","text":"嗒然蒙一衲，趺坐不知年。\n处处神通现，何须海岸边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其八","author":"刘克庄","text":"元不识死活，偶然逢二仙。\n昔与牧奴戏，今饶国手先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其二","author":"刘克庄","text":"仅可著孤身，何曾有四邻。\n切须留一榻，让与细书人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其十五","author":"刘克庄","text":"惜齿埋之土，何曾愿世知。\n终为交趾献，亦被普贤骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石竺山二十咏 其二十","author":"刘克庄","text":"力却帝尧禅，犹为颍水羞。\n似曾洗渠耳，不可饮吾牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]