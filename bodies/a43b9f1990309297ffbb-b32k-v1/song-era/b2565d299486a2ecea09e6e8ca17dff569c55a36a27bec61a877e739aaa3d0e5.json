[{"title":"和韵 其二","author":"韩淲","text":"春来常苦少晴阳，纵有幽花未肯芳。\n不是骚人催唤醒，煖风迟日也无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其一","author":"韩淲","text":"水南上郭荒凉甚，犹有西轩两首诗。\n沙草犊鸥眠动处，当时识赏孰能追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其二","author":"韩淲","text":"涧曲山隈借竹轩，轩虽非旧有前言。\n断碑零落犹能打，此意微茫仅复存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其三","author":"韩淲","text":"人言君方君但方，吕诗尤足照僧房。\n只今尹记畴能问，我辈怀贤未可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其四","author":"韩淲","text":"才见云游又打包，何时月下把门敲。\n相思白发空千丈，坐对烟林滴露梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其五","author":"韩淲","text":"行欲方而智欲圆，河东车说已居前。\n先方之喻斯为美，只恐圆成又不便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其一","author":"韩淲","text":"溪山淡淡复溶溶，老觉身閒百念空。\n谁把清诗相触拨，又随吟啸醉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其二","author":"韩淲","text":"人之老去须甘老，天以閒来莫厌閒。\n满树梅开和玉雪，门前流水响空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其三","author":"韩淲","text":"横斜清浅暗香动，时把心情百样摹。\n忽忆西湖林处士，此风应笑古来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其四","author":"韩淲","text":"车尘不到世氛远，野水閒花景最新。\n汎汎空明知我独，故将流影巧随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其五","author":"韩淲","text":"不须更著前村里，且傍衡门看流水。\n无人涂路横古今，吹尽梅花又梅子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其六","author":"韩淲","text":"閒收神观与天游，坐断空山百不留。\n只许梅花恣开落，春归幽涧水风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其七","author":"韩淲","text":"水流活活水桥斜，清浸梅梢岸底花。\n自与空门了孤绝，肯随游冶入芳华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鲁解元以坡语空山无人水流花开为诗和韵 其八","author":"韩淲","text":"岁寒草木竞黄落，春到空山梅自开。\n一任门无车马到，香飞流水涧中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其一","author":"韩淲","text":"行尽田家与酒家，书窗薝卜见新花。\n风流一老来何处，不许閒人作话夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫 其二","author":"韩淲","text":"云绕蹊间水满豅，豅中来往少能同。\n溪头系得扁舟在，更约乘流载短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其一","author":"韩淲","text":"竹隐泠泠屋数椽，做成清尚得如然。\n山村底处无丛薄，我独因人以赋焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其二","author":"韩淲","text":"章泉兄弟旧新庐，子舍高低不远欤。\n篱槿池莲映林竹，款门犹是可容余。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其三","author":"韩淲","text":"城郭虽多总不如，瑞峰山净竹应舒。\n纷拿肉食红尘热，缓步那言可当车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其四","author":"韩淲","text":"僧寺本来能脱俗，水南逼市漫成竿。\n台喧地污要除扫，禅月当年真可安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其五","author":"韩淲","text":"绝岸沿流翠碧洲，烟枝露叶落还抽。\n输他荒阔无人管，拟待烦君一笔收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其六","author":"韩淲","text":"山囿遥遥合世官，事嗟成往尚何观。\n新知益比故知少，纵有竹林无复欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昌甫竹句 其七","author":"韩淲","text":"苍筤亭种千竿竹，三十年前此地家。\n野水纵横旧时涧，客来犹得共瓜茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵缪教授 其一","author":"韩淲","text":"山花忍作寿阳妆，且著胭脂入艳阳。\n细雨春风谁会得，溪桥空自落幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵缪教授 其二","author":"韩淲","text":"若无交友可忘年，馈岁何由得酒泉。\n不是骚人太多事，定无家酿与吟篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和教授诗 其一","author":"韩淲","text":"边韶经笥任嘲眠，底用回澜障百川。\n系马堂阶官独冷，秋来应喜雨公田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和教授诗 其二","author":"韩淲","text":"暑天常欲踏层冰，未雨低垂气不胜。\n田里三农那可旱，闾阎万灶信如烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和教授诗 其三","author":"韩淲","text":"诗筒剥啄入幽扉，到手令人喜欲飞。\n多谢清骚涤尘虑，不惟高泽救时饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和教授诗 其四","author":"韩淲","text":"三曾三孔久凄凉，百世空闻书传香。\n人物江西初未远，定寻坠绪接茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和教授诗 其五","author":"韩淲","text":"学海波翻笔底宽，逢辰当不负巍冠。\n只今得句因时雨，才思何妨若涌湍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示可然叟 其一","author":"韩淲","text":"水声流出白云洞，正是楚天秋雨时。\n应过严陵滩下去，清风波面一丝知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示可然叟 其二","author":"韩淲","text":"往来常爱白龙洞，困借僧窗竹榻眠。\n几许客尘烦恼病，为渠泉石弄风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵 其一","author":"韩淲","text":"不是伤春著句迟，似醒犹困欲晴时。\n从他野草閒花见，已自雄蜂雌蝶知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵 其二","author":"韩淲","text":"酴醾一架煖争开，投老看花得几回。\n兴以芳时寻醉去，诗从永日送香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗以杨朴契玄断送头皮语说病亦昌甫郑州乡里人也次韵 其一","author":"韩淲","text":"契玄东里一遗民，落拓颠狂混俗人。\n自是本朝全盛际，至今拈起话常新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗以杨朴契玄断送头皮语说病亦昌甫郑州乡里人也次韵 其二","author":"韩淲","text":"示疾炎凉合问之，头皮老去记谁诗。\n杨妻有句留千古，笑倒黄州举此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫以诗送香任尚书任和答且辱见及次韵昌甫不必寄尚书也 其一","author":"韩淲","text":"夏衣轻体凉絺绤，忘却禦冬寻敝襦。\n且玩章泉香与句，閒来服用更何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫以诗送香任尚书任和答且辱见及次韵昌甫不必寄尚书也 其二","author":"韩淲","text":"交情到老终难已，此味平生毕竟浓。\n远近行藏两相望，湖山应自白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久舍人七月廿一夜喜雨五绝 其一","author":"韩淲","text":"钱湖苦热人不眠，下塘水涩流涓涓。\n云奔雨骤忽到晓，便有小舟来闸边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久舍人七月廿一夜喜雨五绝 其二","author":"韩淲","text":"雨云低水夜微明，隐隐临平山上青。\n荷花菱叶不自已，摇动湿风时乱萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久舍人七月廿一夜喜雨五绝 其三","author":"韩淲","text":"客中倚楼秋思觉，人静石罅促织鸣。\n未知我诗能吟否，三更起坐床不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久舍人七月廿一夜喜雨五绝 其四","author":"韩淲","text":"补陀净圣有许事，用作霖雨谈笑中。\n天竺山高湖水满，去来何地不圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久舍人七月廿一夜喜雨五绝 其五","author":"韩淲","text":"转庵老子又多能，意气少年誇五陵。\n自到玉皇香案侧，退朝犹不废吟灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠余之任","author":"韩淲","text":"记得青岩载酒时，僧窗吹雨夜檐低。\n如今共踏南豅路，却说青岩看木犀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠杰宿之","author":"韩淲","text":"山林春雪未花开，生日何情近酒杯。\n似醉似醒方鹘突，上人剥啄带茶来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠向亲","author":"韩淲","text":"大耐人家旧相门，共嗟北路尚堪论。\n载披留别知己叙，此意寥寥属耳孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子功赠王玉山 其一","author":"韩淲","text":"要知爵服人人别，不信弦歌个个同。\n指点苕溪归棹远，西风吹梦藕花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子功赠王玉山 其二","author":"韩淲","text":"翻云覆雨功名事，到底谁称一世雄。\n邂逅酒杯还小醉，强酬诗句苦难工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴子似 其一","author":"韩淲","text":"喜君常诵介庵诗，此老流风百世知。\n摸索期思长短句，象山如在更沙随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴子似 其二","author":"韩淲","text":"渐老方知欠往还，等閒萧寺得同盘。\n吕曾旧事今如梦，且上南山横碧看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其一","author":"韩淲","text":"飞腾暮景惜流光，至后年前日渐长。\n绕屋雨声无藉在，海山尤带北风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其二","author":"韩淲","text":"家林何在梦魂飞，闭阁焚香醉似泥。\n火冷灯青推枕坐，幽怀无处觅诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其三","author":"韩淲","text":"年年以酒浇残腊，日日为诗作好春。\n涧水渐生梅正发，鸟啼人语亦清新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其四","author":"韩淲","text":"里巷欢呼争爆竹，田庐围坐亦然萁。\n寒更不觉鸡三唱，可惜心情不赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其五","author":"韩淲","text":"流传风俗岂无因，柏叶椒花意已驯。\n騃女痴儿何所试，牵衣踏地只争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕次韵郑司理 其六","author":"韩淲","text":"夜窗松月旧家风，宦海飘流鞅掌中。\n但觉年年添一岁，不知齿豁与头童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵山水便面绍之所作","author":"韩淲","text":"春风绿遍林间木，想见晴岚扑閒屋。\n山人琴剑未归来，知谁把我残书读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵成季道中","author":"韩淲","text":"远如无际近纷然，一棹吴波入楚天。\n水面如尘开又合，晚来寒日见山烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日次韵次公 其一","author":"韩淲","text":"水南著我登高处，风急山篱带薄云。\n从昔骚人爱重九，冥鸿天际有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日次韵次公 其二","author":"韩淲","text":"纷纷下视三家市，人物悲欢逐年岁。\n吾侪秃发帽檐斜，不见黄花也须醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗来言九日是悼亡之日因答和及紫芝是日过城下 其一","author":"韩淲","text":"玉山何许两峰高，不特云藏雾亦韬。\n可惜敝庐城郭浅，心蓬徒使目还蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗来言九日是悼亡之日因答和及紫芝是日过城下 其二","author":"韩淲","text":"紫芝九日上杭都，溪馆经从说大苏。\n摇落风霜为搔首，病馀真是我非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗来言九日是悼亡之日因答和及紫芝是日过城下 其三","author":"韩淲","text":"佳辰人物本难俱，事事虽非景不殊。\n君既悼亡应感旧，细看那复嗅茱萸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗来言九日是悼亡之日因答和及紫芝是日过城下 其四","author":"韩淲","text":"黄落山川亦变衰，平生高李吹台诗。\n秋来季月溪南路，独往空歌宋玉悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日范伯升惠诗连伯玉丈有和句皆道先公平昔登高事感而次韵 其一","author":"韩淲","text":"诗来增我思亲念，愁对秋山气象高。\n糁糁黄花惊节物，东篱徒有鬓萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日范伯升惠诗连伯玉丈有和句皆道先公平昔登高事感而次韵 其二","author":"韩淲","text":"尘土装怀不可论，伤心夏凊与冬温。\n西风南涧萧萧竹，犹有范翁时到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所赋癞可瘦权且言去岁到白鹿洞 其一","author":"韩淲","text":"踏雪寻僧已是诗，更将书册试同披。\n名高直隐江西社，五字非君熟和斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所赋癞可瘦权且言去岁到白鹿洞 其二","author":"韩淲","text":"当年权可气横秋，此日匡山亦雪不。\n莫恨禅床人寂寂，可论书院鹿呦呦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其一","author":"韩淲","text":"谁家绿展窗前叶，何物清成池上花。\n叹息陶斯为模写，要须随兴寄无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其二","author":"韩淲","text":"华发差差从满颠，形神才释自蹁跹。\n角巾东路浑常事，便驾柴车亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其三","author":"韩淲","text":"秋深剩有十分凉，好理平生书传香。\n见说江西多胜士，吟成风雨近重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其四","author":"韩淲","text":"得将胶扰一身藏，吴是他乡蜀故乡。\n从昔衰荣无定在，山林钟鼎两俱长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其五","author":"韩淲","text":"禅门底用金仙偈，道室空多玉笈书。\n知我者希斯我贵，身心如此可踟躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李季章参政寄近作绝句次韵答之 其六","author":"韩淲","text":"家食何如禄万钟，梦回珂辔响玲珑。\n书生习气初无恙，只怕勋名不贷公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张令郊行 其一","author":"韩淲","text":"连朝晴日破层阴，下泽翩翩兴愈深。\n水际风翻沽酒旆，静看飞鸟过平林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张令郊行 其二","author":"韩淲","text":"不须万里羡侯封，且把千诗一抚松。\n野步何人知此意，仙家寒露湿芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]