[{"title":"游天峰寺","author":"龚况","text":"杖藜高踏半山云，不见此岗知几春。\n异时人物凋零尽，只有青山似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午歇惠安寺","author":"龚况","text":"寒食都来数日闲，颜卿家帖到今传。\n此公刚鲠无情煞，到得春时也自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送唐大监","author":"龚况","text":"东山相别又相逢，转觉衰颓一老翁。\n子约重来我方去，满庭黄叶正秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古乐府 其一","author":"龚况","text":"妖娆破瓜女，争上秋千架。\n香飘石榴裙，影落蔷薇下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古乐府 其二","author":"龚况","text":"墙外见鸳鸯，双双春水塘。\n归来情脉脉，无绪理残妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"龚况","text":"贪山借船赏，嗜酒典琴沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"龚况","text":"闲多卷满新成句，懒极床堆未答书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"龚况","text":"客疏闲吠犬，庖匮割啼鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"龚况","text":"得句怕难续，避人长转多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"龚况","text":"山色秋难老，池光夜不昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题宴坐石","author":"石端诚","text":"飞流喷雪散层岩，瓴水无时泻屋檐。\n客梦夜回疑是雨，起看窗户有明蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水索","author":"石端诚","text":"箨龙何用更横空，一线长绳引水通。\n顷刻能周清净供，汉阴端谢桔槔功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题八角亭","author":"蒋存诚","text":"由来祗说四檐亭，今日先生八角成。\n最喜潇潇春夜雨，一檐分作两檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩夜月","author":"侯延年","text":"十年辛苦唐贤士，千载奇观旧石岩。\n天籁沉沉山月小，夜深文字与谁谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登麻姑山","author":"童邦直","text":"碧苔侵野径，好鸟隔春烟。\n有洞寻青翼，无僧结白莲。\n雨添蛙一部，暖足柳三眠。\n绿发便花朵，悭肠怯酒船。\n安仁嗟拙宦，苏晋暂逃禅。\n日色同悲惨，东风乱纸钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙湖","author":"储惇叙","text":"咫尺仙湖号堵平，先贤曾此劝农耕。\n若教一日归豪右，敢向黄公庙下行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿大涤山","author":"吴倜","text":"解骖投宿到蓬壶，骨冷魂清梦寐无。\n可怪春禽晓啼月，又催行李出凡途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂妙喜老师室中所问因缘","author":"吴伟明","text":"不是心，不是佛，不是物，通身一穿金锁骨。\n赵州参见老南泉，解道镇州出萝卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈一首","author":"吴伟明","text":"毒蛇猛虎空相向，铁壁银山谩自横。\n长笛一声归去好，更于何处觅疑情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"吴伟明","text":"梁山重回首，翠峰三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题碧沼寺","author":"徐伟达","text":"古寺登临不记秋，重来境物更清幽。\n烟笼野色穿窗日，竹引寒泉绕径流。\n杜阁谛观缁侣肃，莲堂时有妙音浮。\n老僧喜客殷勤甚，冰簟蒲团为我留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三江亭","author":"顾文","text":"词源倒峡势奔侵，绠短那容汲万寻。\n望属沧浪惊鹤唳，志存流水识琴心。\n挥毫句句囊盛锦，拜赐人人袖有金。\n不日都俞在庙庙，更听虎啸应龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"李宋臣","text":"秀峰双拱背，庾岭独当眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"资福寺","author":"黄荐可","text":"一径崎岖步翠微，乱山深处掩柴扉。\n烟萝密锁人家少，碎石崚嶒马足稀。\n泉跳浮沤员复散，人生幻梦是还非。\n何时识此林泉趣，饱饭参禅向上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大眉小眉山","author":"黄锐","text":"一岭复一岭，山巅又一巅。\n步丘皆力穑，掌地也成田。\n线引山腰路，针穿石眼泉。\n眉山同是号，此处合生贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵竟宣圣林","author":"林伯显","text":"生民未有如夫子，好学皇泉最自强。\n功业当年虽坎壈，声名后世愈芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题濂溪","author":"林焕","text":"我来濂溪拜夫子，马蹄深入一尺雪。\n长嗟岂惟溪泉廉，化得草木皆清洁。\n夫子德行万古师，坡云廉退乃一隅。\n有室既乐赋以拙，有溪何减名之愚。\n水性本清挠之浊，人心本善失则恶。\n安得此泉变作天下雨，饮者犹如梦之觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洞霄宫","author":"成无玷","text":"我欲观太华，一笑凌险阻。\n灭迹恨未果，衰容遽如许。\n东南岂不佳，泉石閟灵府。\n未访潜山源，且寻天目乳。\n一峰拔地起，离立谁敢侮。\n千岩绝附丽，万壑失媚妩。\n有如人中杰，羞与绛灌伍。\n翠箬藏丹砂，石洞飞白鼠。\n游人倦登陟，异境何由睹。\n振衣临绝顶，云外听天语。\n仙人傥予迎，从此遂轻举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游开山寺","author":"欧阳子槐","text":"高平北路入禅堂，行转茅冈上石冈。\n壑险桥危需一苇，山深树古立千章。\n禽声呖呖如簧巧，溪曲湾湾似带长。\n我欲拂衣登绝顶，低徊吟啸白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题仁寿楼","author":"徐衡","text":"百尺楼成接昊苍，御题仁寿问行藏。\n四端所有虽为贵，五福为先孰敢当。\n日出千山凝晓色，花开十里带秋香。\n老来意外无他念，赢得登临兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠彭神童","author":"徐衡","text":"吾家先世有童子，姓名尝著杜诗史。\n不缘神气形相殊，安得公诗重褒美。\n三百年有宋兴，妙裔四海皆豪英。\n番郡自古称多士，群儿头角又峥嵘。\n洎水之东有彭氏，生儿五岁真佳瑞。\n双眸点漆肌骨清，不与孩提共嬉戏。\n诵诗记字何了然，琅琅一口千万言。\n弱不胜衣行未稳，凌人气岸已轩轩。\n嗟予去国亦云久，为报君恩矢奔走。\n绣衣持节入闾阎，大半故人新白首。\n与儿阿父昔同游，高才终不事王侯。\n报不在身当在子，发源所与今其流。\n行看直上青云梯，决取钟如探囊中筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东明寺","author":"蜀僧","text":"三十年前镇益州，紫泥丹诏凤池游。\n大钧播物心难一，六印悬腰老未休。\n佐主不能如傅说，知几那得似留侯。\n功名富贵今何在，寂寂招题一土丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答外兄王子常问修行之术","author":"刘卞功","text":"非道亦非律，又非虚空禅。\n独守一亩宅，惟耕己心田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题写真","author":"刘卞功","text":"韬光晦迹居环堵，闭自凝神事事疏。\n漫许丹青传道貌，难将妙笔写真如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠黎如璧","author":"崔羽","text":"茫茫宇宙春复秋，上清曾记昔年游。\n烧丹灶古云烟在，遗履亭虚草树幽。\n花压画栏香梦远，酒倾磁盏瑞光浮。\n饮馀忍别贤昆季，回首向云天际头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示黎如璋丹诀","author":"崔羽","text":"丹即筌蹄道即鱼，忘筌得道證空虚。\n莫坚守抱无为一，扑碎空虚一也无。\n妙有灵丹常赫赫，含容法界自如如。\n随缘应感长清静，九载金刚不坏躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨夜乩坛偶笔","author":"崔羽","text":"烟霏雨湿路泥泞，鹤驾飘然下紫京。\n休咎吉凶休动问，细谈时事与黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛塘","author":"段拂","text":"筑圃依山曲，开门向水湄。\n春风摇鼠梓，夜雨足凫茈。\n但解髡能饮，焉知朔欲饥。\n提壶花外转，催出眼前诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈大慧禅师偈","author":"计法真","text":"终日看经文，如逢旧识人。\n莫言频有碍，一举一回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其一","author":"张扩","text":"小人无远谋，湮没如湛辈。\n胸中气奄奄，垂尽鼓一再。\n安知翰墨场，李杜凛然在。\n文章作甘棠，百世负遗爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其二","author":"张扩","text":"退休小得计，耳冷百不闻。\n戎马叵奈何，四郊尚兵氛。\n眼中习主簿，才似李将军。\n小试未为屈，有君如华勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其三","author":"张扩","text":"十年功名心，客枕寄归梦。\n众中不卓立，老大复何用。\n收身入禅寂，蔬茹饱僧供。\n蛙鸣谁官私，聊欲当弦诵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其四","author":"张扩","text":"大道昔彫丧，夷涂日荒榛。\n进无活国谋，俯仰多由人。\n人生几何时，夜旦互相因。\n往者不可作，未妨来日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其五","author":"张扩","text":"国风久沦亡，毛郑纷六凿。\n譬如秋水篇，破坏向与郭。\n千年见渊明，五字配前作。\n谁传古人诀，定自顾方略。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其六","author":"张扩","text":"吾诗窘时穷，章句羞拙讷。\n君诗非吾偶，齐大轻郑忽。\n雷门不敢过，西施忌唐突。\n政当就阿戎，谈天搜理窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其七","author":"张扩","text":"赠篇最崛奇，披读辄三过。\n巧如娲皇手，五色补天破。\n珍宜宗庙享，净戒儿女涴。\n谁能续离骚，且用追楚些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其八","author":"张扩","text":"达人云间鹤，初不谋稻粱。\n渠有酒百壶，买舟从伯郎。\n世间乳臭儿，衣服誇玄黄。\n岂识卫叔宝，胸中无膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其九","author":"张扩","text":"躬耕良苦辛，十亩手自锄。\n我穷分定耳，矧复怜封胡。\n君今未三十，诗声殿黄初。\n后生要努力，勿及几杖扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温侄用再闻诵新作突过黄初诗作十诗见遗辄勉强次韵 其十","author":"张扩","text":"连门水竹居，照映麋鹿姿。\n子戴靖节巾，得我如远师。\n花黄催重九，羽葆杂金规。\n未能沽酒饮，且赋止酒诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温县丞侄长篇见赠并携少卿伯父梅堂所赋绝句相示翰墨宛然叹息久之因次其韵","author":"张扩","text":"平生张洪州，豪气压群士。\n唾视狗鼠辈，纷纷何足数。\n晚登文石陛，剑服峨櫑具。\n高论忍违时，所愧罔君父。\n至今家集中，秩秩有伦次。\n流传到诸孙，谁复步亦步。\n此翁日已远，畴昔旦暮遇。\n何温少也爽，芝兰秀而紫。\n状貌类洪州，谈笑了万事。\n笔端见微铓，妙解如削鐻。\n精刚金百鍊，该贯龟五聚。\n俗学不足诋，纷纶或殊趣。\n斯文悬诸天，字字有分付。\n诐词颇乱真，芜颣少删去。\n吾子壮且勇，政在戒逸豫。\n昨者忽过门，短袖出长句。\n轩然祢正平，坐诵鹦鹉赋。\n洞庭莽空阔，终日奏咸濩。\n初非郭林宗，岂识黄叔度。\n但惊锦囊文，及此春秋富。\n未能赏雌霓，且复说奇字。\n吾年过半百，世事亦何慕。\n杖屦相扶携，筋骸日僵仆。\n犹于五字中，彫刻叹冰柱。\n习气未易扫，贪味如桂蠹。\n肯借梅堂篇，风流忆张绪。\n珍藏几何时，应有神物护。\n今晨偶开展，英彩照江阜。\n后生要着鞭，探讨及微处。\n遗予真过矣，娟洁忌沾污。\n清梦渺春草，俚谈羞杕杜。\n慎勿索其馀，恐君痴叔似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵大年侄见赠古诗二首 其一","author":"张扩","text":"人生几何时，心地要平旷。\n不须意外求，辛苦寻蒟酱。\n此郎有高处，智出百夫上。\n禅窗接软语，眉宇春盎盎。\n诗坛久失律，斋戒欲谋将。\n谁专笔阵功，定起太公望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵大年侄见赠古诗二首 其二","author":"张扩","text":"君文秋水篇，曲士羞臆度。\n吾文元尚白，穷老甘寂寞。\n向来失宗盟，士气日卑弱。\n后生苗未秀，况复病草恶。\n如君真挺特，文字兽一角。\n头风吾何忧，解后当勿药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大年耆年各赋长篇投名诗社中顾景蕃及伯初子温二侄传诵喜甚子温有诗因次其韵","author":"张扩","text":"诸君总能诗，字字秉忠信。\n联章辄惊人，我老终不近。\n朝来试披读，花雨乱巾衽。\n独惭草元迂，浪说周易准。\n至今覆瓿谤，文字愧小谨。\n昨观两雄篇，词采溢肝肾。\n高参风雅淳，俯谢边幅窘。\n谁能报殽役，怒语激先轸。\n吾军老而怯，望敌倒戈盾。\n会看两犹子，秋风横雁阵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蓬莱室","author":"张扩","text":"巨鳌戴浮水，屹然瀛海中。\n断取入君手，枣叶悬针锋。\n君本山中人，俗子那用逢。\n犹应谒帝梦，佩环摇天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子温作驱疮诗伯初与顾景蕃皆属和蕃以谓不当止酒初以谓宜鍊元气予亦戏次其韵","author":"张扩","text":"小儿私化权，令行错穷冬。\n淫疡薄皴肤，欲战垒块胸。\n道人寖不平，怒发忽上冲。\n馋夫犹收痂，义士唯吮痈。\n快无仙爪爬，滥有苦剂攻。\n坐令费讥诃，沾汗文字中。\n虎头笔有神，众妖避其锋。\n似闻以意医，请用三杯通。\n阿兄言更深，细述葆鍊功。\n二说俱可人，而子将何从。\n酒醇傥消忧，气厚定保躬。\n自然四体胖，那复百病凶。\n吾闻柳州语，祸物人犹虫。\n旻苍厌呻呼，疴痒应汝容。\n疾去会有时，未为吾道穷。\n汝自多识者，吾言犹匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送惠子泽工曹罢官还陜右","author":"张扩","text":"关西多名流，后出亦豪侠。\n三年佐幕府，论事费口颊。\n人情易薰染，久或化为怯。\n不如殽黾去，归路马蹀躞。\n虽无米千斛，尚有书百箧。\n吾曹官为家，穷老漫随牒。\n南州美风土，水净山九叠。\n子尝访之我，行欲买舟楫。\n我本江湖人，妙处饱经涉。\n谁能老作伧，政恐梦为蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曾徽言学士求赋所蓄端砚曾尝避乱海陵家赀尽没于贼独携此砚脱去","author":"张扩","text":"君家文房珍，尤者一二数。\n端溪从谁得，不记岁月古。\n中洼隐天成，外削馀雷斧。\n色羞龙尾乾，质陋雀台窳。\n平生依石丈，什袭费调护。\n向来萑苇中，险作百碎补。\n脱身间道还，神物远侵侮。\n他年沉香亭，奉诏翻乐府。\n周旋妃子手，借润毛与楮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周嘉仲刑曹简航师食笋四首 其一","author":"张扩","text":"箨龙豢不得，托根暂神奇。\n忽化清净供，结缘贫导师。\n回甘溢齿颊，常带泉石滋。\n要知服食功，不减琼田芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周嘉仲刑曹简航师食笋四首 其二","author":"张扩","text":"此君淡难交，挺挺如立玉。\n何意昆仍中，为人偿口腹。\n群婴脱锦褓，珍胜脔项肉。\n犹堪作味谏，没齿蠲腊毒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周嘉仲刑曹简航师食笋四首 其三","author":"张扩","text":"长镵太寡恩，斲丧东南美。\n至今管城封，滥罚及孱子。\n例求一赦贷，馀润乞松髓。\n周旋南董手，骂贼到卢杞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周嘉仲刑曹简航师食笋四首 其四","author":"张扩","text":"周郎清而臞，菜把助严苦。\n槃中玉离离，酝酿冰雪语。\n向来几时亡，径欲就君补。\n请读食笋篇，微言皆可咀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢元龄惠猫头笋予去春曾同元龄伯初昆仲子公顾景蕃经行林间掘笋以归子公刻名竹上也","author":"张扩","text":"狸奴戴头来，本是箨龙种。\n长镵借愿力，搀汝入珍供。\n晨庖辱分甘，辄应食指动。\n令人怀旧游，春服粲群从。\n竹间留名字，小刻妙南董。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送次公侄从辟颜拱卫军中","author":"张扩","text":"结发事师友，投身翰墨场。\n技成忽弃去，短衣亲戎行。\n平生万卷书，岂无活国方。\n不如口击贼，对面用所长。\n颜侯将家种，勇过王铁枪。\n蝥弧每先登，裂袂裹箭创。\n得君如敌国，乳臭未易当。\n中原干戈满，貔虎政陆梁。\n谁专发纵策，坐待锥脱囊。\n事平各分功，千级歉莫偿。\n位卑君勿言，儒雅故自将。\n会从傔籍中，微见奏凯章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短句调子温侄","author":"张扩","text":"阿丞善谈诗，眼如九方皋。\n相马空马群，妙在遗骨毛。\n衰老钻不入，钝愚如枣膏。\n后生不应尔，笔力生波涛。\n黄绢幼妇语，莫负秋风高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]