[{"title":"城上怀古","author":"彭汝砺","text":"水涨藏舟浦，云浮偃月城。\n寒芜随地远，漫水与天平。\n险阻生奸伪，乾坤入圣明。\n杖藜登绝径，谈笑不忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题外舅评事秀实堂","author":"彭汝砺","text":"地胜风长暖，堂开美亦并。\n溪声留几席，山影上檐楹。\n田野多真趣，诗书足义荣。\n本根今日好，华实看俱成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上晚起","author":"彭汝砺","text":"水昏如欲雨，雾落复非云。\n浩荡重波隐，微茫小岸分。\n大明瞻日晓，微暖报风薰。\n隐约庐山寺，孤钟续续闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答吴节推","author":"彭汝砺","text":"吴子新诗好，轻容俗吏传。\n芝兰元自秀，骐骥不须鞭。\n万象生尘外，千林宿水边。\n欲歌无意绪，甘让古人先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和白酒","author":"彭汝砺","text":"村醪薄滋味，市俗固安便。\n酃水东湖咏，青囊杜甫钱。\n宴游知有地，尘俗自非仙。\n我醉非关饮，昏昏坐欲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和思归","author":"彭汝砺","text":"嗟予苦山野，爱子有光辉。\n饱学诗浑好，多愁虑益微。\n幕中方倚办，江上可言归。\n况有高风便，行看俊鹘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春城北","author":"彭汝砺","text":"何曾看好春，已复见春深。\n水涨千溪绿，松低一路阴。\n簿书淹世态，鸡黍乱乡心。\n莫废清和饮，枝头李可沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晚北园","author":"彭汝砺","text":"天气非相逼，东风已自归。\n乐游终少及，世事故多违。\n桃杏春如在，溪山暑尚微。\n早期荃楫泛，频纵角觞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和自遣","author":"彭汝砺","text":"春花竞狼藉，暮鸟学啁嘲。\n劲节松千尺，奇文凤九苞。\n杲之莲府客，嵇绍竹林交。\n欲看归廊庙，胡然忆旧巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祖道京淮道中酬唱","author":"彭汝砺","text":"旅中人远别，河上酒频行。\n暖日开花信，高风去雁声。\n庭闱甘菽水，魏阙望瑶琼。\n应答诗惭拙，犹能慰别情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和祖道国门外文渊子至东父饯席上赠别","author":"彭汝砺","text":"行李随长道，飘蓬笑贱官。\n望云瞻白日，临水看惊澜。\n鸟语如知节，花开尚怯寒。\n莫嫌春色浅，留到后园看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈一惠诗次韵谢之","author":"彭汝砺","text":"世途羞困辱，不复顾交情。\n众稚怜张载，诸公厌祢衡。\n仁心矜废物，佳句写真诚。\n喜悦驱车至，思心正若萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次静长老韵","author":"彭汝砺","text":"性火方能熄，心灯不复挑。\n猿声传古穴，柏实落枯条。\n阒寂苦无寐，淋零已半宵。\n更深寒愈重，慵解束薪烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入桐庐道中","author":"彭汝砺","text":"学问古人重，英豪世所归。\n呼奴整轩驾，拭泪别庭闱。\n久雨路岐涩，荒村草木稀。\n城闉顿相远，回首一依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马上","author":"彭汝砺","text":"马上值寒食，途中非故乡。\n山川劳跋涉，风雨助悲凉。\n碧树鸟相语，幽林花自芳。\n不辞趋道路，多愧负春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨","author":"彭汝砺","text":"风雨恣颠蹶，晚潮相继来。\n轻舟一叶转，巨浪千山颓。\n忠信吾知矣，风波孰病哉。\n寒江几百里，白雪正皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢姜二兄","author":"彭汝砺","text":"阒寂桐江地，羁栖远客魂。\n别家惊节换，此意与谁言。\n忽尔声容际，悠然信义存。\n此时皆逆旅，何日共归轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去桐庐学","author":"彭汝砺","text":"中庸方自乐，外虑巧相侵。\n兴废尽天意，行藏非我心。\n泪因莺谷乱，愁为鹡原深。\n日暮途方远，谁赓马上吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与蒋十二","author":"彭汝砺","text":"孑立羁穷际，相逢邂逅间。\n交游新气概，尘土旧容颜。\n共指青云远，同分白日闲。\n区区交友志，松柏满南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮","author":"彭汝砺","text":"日暮辞前渚，天寒宿远汀。\n青灯同寂寞，浊酒慰飘零。\n痛饮无人共，高歌反自听。\n终宵惟此兴，日战破愁亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送元博县丞还浙忠甫沈翊还鄱阳","author":"彭汝砺","text":"汴水昼夜落，客心朝夕飞。\n君舟虽独往，吾梦亦同归。\n山色藏星渚，风清梦钓矶。\n乐游难并得，人事固多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再寄颖叔一首","author":"彭汝砺","text":"山林问旧题，州县见馀威。\n求友诚相及，思亲梦远归。\n丁丁闻伐木，密密看缝衣。\n但自心猿伏，如它翼虎飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同许屯田子仁宿圆通寺","author":"彭汝砺","text":"远水猿溪古，孤峰石耳悬。\n慈悲开一径，智慧出双泉。\n大士车乘鹿，幽人社结莲。\n欲知今邂逅，犹是昔因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和子仁","author":"彭汝砺","text":"祇见尘埃远，还疑粉绘悬。\n淡云寒对月，幽石静闻泉。\n润泽作甘雨，污泥生白莲。\n五更催解辔，知未悟尘缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到慈湖九江有感 其一","author":"彭汝砺","text":"昔赴长沙幕，初经彭蠡湖。\n所天正强健，此地稍踟蹰。\n杖屦今何在，溪山祇自如。\n白头双血泪，一夜落深蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到慈湖九江有感 其二","author":"彭汝砺","text":"系舟此地昔徜徉，杨柳今时更老苍。\n却望灵芝西北路，秋风吹泪满沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐亭泛舟 其一","author":"彭汝砺","text":"万叶烟云上，千花锦绣中。\n停舟不忍发，为恐破圆红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐亭泛舟 其二","author":"彭汝砺","text":"晚雨轩窗润，秋风池沼香。\n爱花不忍折，恰似惜甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自临川泛舟还归因假前韵寄粹老提举朝议兼简知府龙图丈 其一","author":"彭汝砺","text":"村郭孤烟暝，溪山片月斜。\n吾生浑是客，所至即为家。\n春色生颜面，寒泉绕齿牙。\n归与须载酒，一笑慰天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自临川泛舟还归因假前韵寄粹老提举朝议兼简知府龙图丈 其二","author":"彭汝砺","text":"舟行朝市隔，恣意看溪山。\n天地青春远，江湖白日閒。\n偶随鸥独往，却与燕俱还。\n时节清明近，应须屡破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自临川泛舟还归因假前韵寄粹老提举朝议兼简知府龙图丈 其三","author":"彭汝砺","text":"道路不得已，简书无奈何。\n啼莺思旧友，流水忆清歌。\n江汉心尤惬，田园兴转多。\n西山春咫尺，游思欲扪萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自临川泛舟还归因假前韵寄粹老提举朝议兼简知府龙图丈 其四","author":"彭汝砺","text":"匹马千山远，扁舟宇宙宽。\n岁华春已仲，时节食初寒。\n稍忆棋争胜，还须饮尽欢。\n使君如见问，行李已河干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将行季自鄱阳来","author":"彭汝砺","text":"伯也别何遽，叔兮来未央。\n水流心去远，月静梦归长。\n细雨湿萱草，高风吹雁行。\n几时生事足，相看老耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得书并简仔仲二侄 其一","author":"彭汝砺","text":"近得江东递，连收十月书。\n岁时今已晚，安否比何如。\n从事先生老，谋生仲叔疏。\n为君归不惜，稍更治田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得书并简仔仲二侄 其二","author":"彭汝砺","text":"远宦非予欲，浮生如此何。\n几时俱省定，终日念渐摩。\n流水嗟蓬转，青云喜雁过。\n寄书盈万字，不似泪痕多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中","author":"彭汝砺","text":"小人故怀土，游子更思乡。\n里堠经双只，邮亭宿短长。\n暮栖乌反哺，春去雁随阳。\n亦有一廛宅，能无十亩桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月初三日送叔宜弟初离襄阳","author":"彭汝砺","text":"月魄才生夜，春风恰到时。\n异乡愁对酒，深院静论诗。\n道路嗟吾老，云霄恨汝迟。\n莫言明日别，徒益鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叔宜","author":"彭汝砺","text":"地近梅开早，溪深柳放迟。\n可怜春到处，恰值汝归时。\n衰晚疲奔走，羁栖恨别离。\n祇因明夜梦，千里亦相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庭佐","author":"彭汝砺","text":"久别随蓬草，相思看雁行。\n水流心去远，月静梦归长。\n尽力耕南亩，怡颜侍北堂。\n曾参君不及，可以似王祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病懒","author":"彭汝砺","text":"原宪自多病，长卿仍倦游。\n经旬或洗面，一月不梳头。\n身世真羁旅，功名是赘疣。\n百年无可问，吾道合归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈师道教授示黄梅诗次韵呈正夫学士四首 其一","author":"彭汝砺","text":"美色绝殊众，暗香时著人。\n齐州终自别，不比岭头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈师道教授示黄梅诗次韵呈正夫学士四首 其二","author":"彭汝砺","text":"可但深宜晚，须知巧耐寒。\n北人浑未识，祇作棣棠看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈师道教授示黄梅诗次韵呈正夫学士四首 其三","author":"彭汝砺","text":"旧作酴醾白，新翻蛱蝶黄。\n不须多变态，固自有真香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈师道教授示黄梅诗次韵呈正夫学士四首 其四","author":"彭汝砺","text":"不独看花懒，吟诗味亦忘。\n此花谁可赋，顾曲有周郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大小沙陀 其一","author":"彭汝砺","text":"南障古北口，北控大沙陀。\n土地稻粱少，岁时霜雪多。\n古来常用武，今日许通和。\n岂乏骠姚将，君王悟止戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大小沙陀 其二","author":"彭汝砺","text":"大小沙陀深没膝，车不留踪马无迹。\n曲折多途胡亦惑，自上高冈认南北。\n大风吹沙成瓦砾，头面疮痍手皴坼，下带长烟蔽深驿。\n层冰峨峨霜雪白，狼顾鸟行愁覆溺。\n一日不能行一驿，吾闻治生莫如啬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑寺丞过洪州 其一","author":"彭汝砺","text":"盛德鸿枢后，才华日久新。\n声名飞海岳，步履望星辰。\n棋锐如无敌，诗成似有神。\n当涂难久滞，行楫桂花春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑寺丞过洪州 其二","author":"彭汝砺","text":"清风不可近，碎璧缀圆规。\n翰墨传家学，风流蕴素资。\n龙孙藏旧节，蟾桂毓新枝。\n愿听功名起，青云慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑寺丞过洪州 其三","author":"彭汝砺","text":"恨接清规晚，愁看去鹢东。\n别情万里远，离绪一尊中。\n柳意藏春雪，梅香度晓风。\n馀寒须有作，无惜寄江鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑寺丞过洪州 其四","author":"彭汝砺","text":"闻君话行色，今过洞中天。\n坐视征帆速，还令别意牵。\n重江锁云雾，邃谷隐神仙。\n不得相追逐，诗成一洒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和汉广席上赋柑","author":"彭汝砺","text":"秀色霜滋重，馀香露洽鲜。\n鹄巢灵壳媚，海窟夜珠圆。\n丹橘非优贡，蟠桃亦浪仙。\n无嗟后林质，未至太清天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋孝严江行","author":"彭汝砺","text":"江为雨频增浩荡，物因霜重益凄凉。\n千年老木战风色，万里澄波浮日光。\n梅萼半红浑腊意，麦田微绿已春阳。\n欲留佳赏无樽酒，空引诗魂百尺长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸君江步以病不能从走笔寄之","author":"彭汝砺","text":"烦君仔细数江峦，风物如今总几般。\n永夜水声应自得，新秋月色好谁看。\n沙禽静敛双飞翼，鱼艇空馀一钓竿。\n诗力有穷情不尽，更凭收拾向毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登楼","author":"彭汝砺","text":"缥缈飞楼倚太清，危栏一瞬尽沧溟。\n世途忽忽与时异，水色溶溶依旧青。\n夷夏固知归禹画，幽燕何事属戎庭。\n草莱贱策无津致，空想秋风涕泗零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到醒心亭","author":"彭汝砺","text":"万里江湖逐断萍，红尘不见北山亭。\n一思好景心魂醉，才挹馀芳眼目醒。\n寒暑忽移佳木绿，古今长见远峰青。\n烟芜路断无穷尽，空惜琅邪旧记铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日影","author":"彭汝砺","text":"日影昏冥雨力微，扁舟欲往浪沾衣。\n不甘落叶东归去，空羡征鸿北向飞。\n俗恶懒经沽酒市，身闲欲卧钓鱼矶。\n祇疑风色相欺得，系滞尘踪未许归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈刘推景仁","author":"彭汝砺","text":"万里依依欲见君，浪烦车马走乾坤。\n频经患难心方老，久厌尘埃眼欲昏。\n几日不归南郡帐，清宵长梦翟公门。\n侧闻丹诏从天下，愿借春风起旧根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送臧梦符秀才归","author":"彭汝砺","text":"匹马騑騑冒晓征，故人惜别涕双零。\n青云器业方千里，穷巷生涯独一经。\n节目已疏非杞棘，源流不竭即沧溟。\n馀闲且尽诗书学，莫遣尘埃误性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪畔","author":"彭汝砺","text":"尘绪纷纷今少休，更须一去弄溪流。\n清风满木春才半，落日明波雨乍收。\n懒逐山林群野鹿，欲归江汉狎沙鸥。\n藻疏菱密吾虽羡，未忍敲针作钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与梅秀才游安师池亭赋诗","author":"彭汝砺","text":"炎天自欲沉朱李，诗社初欣见素梅。\n绿柳荐风消酷暑，青荷飞雨濯尘埃。\n墙头竹影纷纷出，水面菱花细细开。\n拍手浩歌情不尽，笑君佳句泥流杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重至","author":"彭汝砺","text":"亭台池沼皆依旧，惟爱清风日日新。\n念远恨无双羽翼，临流安得一丝纶。\n好花有意重留客，幽鸟无情乱惹人。\n满眼澄光清可赋，与君无厌往还频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出关寄资道","author":"彭汝砺","text":"草色萋青花色殷，独乘微雨度重关。\n雕鹰不死蓬蒿际，骐骥方怀道路间。\n千里未能通咫尺，一毫安敢望丘山。\n韶华欲老功名远，卧想清风辄厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平居多忧多病间从诗酒自乐即席为诗呈诸友且寓一时之怀也","author":"彭汝砺","text":"不惜千金换酒醪，为君穷力赋离骚。\n乾坤尽入双吟眼，日月都归一醉毫。\n平昔至诚倾益契，昨宵游梦得夔皋。\n穷途知负经纶器，烂醉西风首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"炎暑","author":"彭汝砺","text":"炎暑半归天早凉，日阴苦短夜初长。\n风清月白已秋意，海角天涯非故乡。\n无赖分为多病叟，有情还作一诗狂。\n溪声汩汩东西去，南北游人欲断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君时十二弟","author":"彭汝砺","text":"漂泊东南天地间，分明身世似乘船。\n此生去住总未定，所值险夷皆偶然。\n载酒纵随红芰饮，移床深近白云眠。\n知君独处多幽趣，诗轴今成第几编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次皇甫子仁老杜诗韵","author":"彭汝砺","text":"少陵气忠勇，毫发见声诗。\n卫稷心丹破，穷途鬓雪垂。\n兵戈灵武道，风雨耒阳时。\n不及明君用，空馀后学悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬寒围炉以题为韵得寒字","author":"彭汝砺","text":"道路冬无雪，山原腊始寒。\n平林风力疾，落叶雨声乾。\n冰玉诗肠瘦，江湖酒思宽。\n庭帏即予乐，不必事杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和济叔冬字","author":"彭汝砺","text":"雨声传到耳，雪意尽穷冬。\n气味闲相惬，形骸病见攻。\n冷呵诗笔冻，寒啜酒醅醲。\n且剧红炉饮，行闻古寺钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和庭佐弟韵","author":"彭汝砺","text":"鸿雁飞云际，圭璋照座隅。\n喜心看欲雪，佳句续围炉。\n萧洒开书帙，清狂泥酒壶。\n云霄非万里，行看步夷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]