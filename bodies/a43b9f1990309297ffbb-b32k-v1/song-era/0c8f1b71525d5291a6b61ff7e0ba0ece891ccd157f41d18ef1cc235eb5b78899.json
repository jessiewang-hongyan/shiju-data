[{"title":"早自乌龙庙归","author":"陆游","text":"残漏声中听曳铃，翩翩吹帽出郊坰。\n雨馀涧落双虹白，云合山馀一发青。\n铁马蹴冰悲昨梦，朱颜辞镜感颓龄。\n归来独对空斋冷，鸟迹苍苔自满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早至园中","author":"陆游","text":"湖上空濛雨熟梅，清晨岸帻一悠哉。\n幽花不恨草埋没，密树岂知禽去来。\n旧为爱茶分水器，近缘炊爨得琴材。\n小丘仅见山如髻，尚愧韩公八尺台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行","author":"陆游","text":"寒漏参差断，晨鸡次第鸣。\n匆匆半枕梦，草草一杯羹。\n泽国多逢雨，闲人不计程。\n云间出寸塔，迎我有馀情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行","author":"陆游","text":"江路迢迢马首东，临川一梦又成空。\n日高未泫晨霜白，风劲先消卯酒红。\n山市人经饥馑后，孤生身老道途中。\n著身稳处君知否，射的峰前卧钓篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行","author":"陆游","text":"笮马践槐影，纱笼吹蜡香。\n凭鞭寻断梦，侧帽受微凉。\n病骨更疏放，衰怀罢激昂。\n道边双石笋，笑我伴人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行至江原","author":"陆游","text":"喔喔鸣鸡促起程，翻翻飞鹭导孤征。\n节旄尽落归犹远，带眼频移瘦自惊。\n小市萧条黄叶满，断桥零落绿苔生。\n居人犹复多愁思，何况天涯倦客情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早饭干溪盖干吉故居也","author":"陆游","text":"剑外归来席未温，南征浩荡信乾坤。\n峰回内史曾游地，竹暗仙人旧隐村。\n白发孤翁锄麦垄，茜裙小妇闯篱门。\n行行莫动乡关念，身似流槎岂有根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春","author":"陆游","text":"数声屋角听鸣禽，红糁青梢忽满林。\n雨过东皋一犁润，冰消南涧半篙深。\n逢僧竹院闲评药，携鹤山村醉拥琴。\n青史功名黄閤贵，有时应不到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春出游二首 其二","author":"陆游","text":"人生何适不艰难，赖是胸中万斛宽。\n尺宅常朱那待酒，上池频饮自成丹。\n楚祠花发呼舟去，禹穴云生倚杖看。\n更有新春堪喜事，一村箫鼓祭蚕官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春出游二首 其一","author":"陆游","text":"微云薄霭新晴后，小盖轻舆古道遥。\n林杪幽禽初学啭，墙阴冻雪未全消。\n酒垆日暮收青旆，市步人归拥画桡。\n攲帽扪髯常半醉，逢人谁与话无憀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春出游","author":"陆游","text":"地炉久厌拨寒灰，一笑真成病眼开。\n不恨城笳催日落，且欣巷柳报春回。\n蹇驴破帽人人看，南陌东阡处处来。\n闻道禹祠游渐盛，也谋随例一持杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春对酒感怀","author":"陆游","text":"探花畴昔喜春回，老大空惊节物催。\n芳瓮旋开新压酒，好枝犹把未残梅。\n书生岁恶甘藜苋，志士时平死草莱。\n欲豁孤怀谁晤语，夜弹长剑有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春池上作","author":"陆游","text":"疏懒元当与世辞，残年况近乞身期。\n一官空作读书祟，五斗不供沽酒资。\n冰拆野塘初滟滟，雪残芳草已离离。\n物华似有平生旧，不待招呼尽入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春新晴","author":"陆游","text":"柳弄春柔拂小潭，山横霁色卷浮岚。\n飞扬幡脚掷东北，零落梅花馀二三。\n村店疏灯新卖酒，神祠叠鼓正祈蚕。\n幽人睡起东园去，芹茁萱芽又满篮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋四首 其一","author":"陆游","text":"凉飔淅淅撼庭柯，微雨萧萧集浦荷。\n草阁檐虚觉山近，蓬窗地迮得香多。\n谋身自拙穷无鬼，闭户长闲睡有魔。\n台省诸公盛冠剑，固应老子得婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋四首 其四","author":"陆游","text":"貂裘尘土忆东周，瓜陇风霜隐故侯。\n懒似老鸡频失旦，衰如蠹叶早知秋。\n壶觞非复平生友，岁月空添客子愁。\n病起笔端犹健在，未妨挥洒赋登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋四首 其二","author":"陆游","text":"秋入房栊夜渐长，纱厨笛簟怯新凉。\n萤光得意穿帘隙，桐叶知时拂井床。\n世事本来谁得鹿，人生何处不亡羊。\n灯前笑向吾儿说，又过铜匜半篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋四首 其三","author":"陆游","text":"落魄巴江号放翁，斯名岁晚亦成空。\n酒醒遥夜孤舟雨，睡美清秋一榻风。\n骇浪千重无死地，神丹九转有新功。\n云端不遇飞仙过，谁顾幽人寂寞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早秋南堂夜兴","author":"陆游","text":"水注横塘藻荇香，候虫唧唧满空廊。\n风前落叶纷可扫，天际疏星森有芒。\n夜漏渐长愁少睡，秋衣未制怯新凉。\n明朝却有欣然处，写得黄庭又几行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早凉熟睡","author":"陆游","text":"灵台虚湛气和平，投枕逡巡梦即成。\n屋角鸣禽呼不觉，手中书册堕无声。\n百年日月飞双毂，千古山河战一枰。\n赖有莲峰遗老在，白云深处主齐盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早寒","author":"陆游","text":"沔鄂犹残暑，荆巫已早寒。\n潦收滩正白，霜重叶初丹。\n节物元非恶，情怀自鲜欢。\n暮年更世事，唯有醉江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旬日公事颇简喜而有赋","author":"陆游","text":"社近楼台昼已长，丰年颇减簿书忙。\n雨催树绿吹箫陌，日射尘红击鞠场。\n农事渐兴初浸种，吏衙早退独焚香。\n晚来别有欢然处，检教儿书又一箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曳杖","author":"陆游","text":"曳杖寄彷徉，徐行转曲廊。\n病知贪酒害，老悔爱花狂。\n庭树云收影，帘旌雨浥香。\n悠然有佳处，物我两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有为予言乌龙高崄不可到处有僧岩居不知其年予每登千峰榭望之慨然为作二诗 其二","author":"陆游","text":"崄绝无微径，淙潺有细流。\n寒岩依作屋，堕毳拾为裘。\n木客求相识，毛人约共游。\n百年如一瞬，尘世几公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有术士过门谓余寿及九十","author":"陆游","text":"形骸鹤瘦复松枯，况是新霜满鬓须。\n醉似在家狂道士，愚于识字老耕夫。\n敢言万里封侯事，但问纵文入口无。\n许我年如伏生比，逢时犹解诵唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有年","author":"陆游","text":"不向神林乞雨晴，天公自解相西成。\n急符收尽无逋赋，新酒沽多足笑声。\n外户彻扃停夕柝，齐民相劝力春耕。\n传闻夜市连三鼓，却恨庞公不入城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀青城雾中道友","author":"陆游","text":"雪谷孤松自郁然，纷纷朝菌但堪怜。\n坐更拂石芥城劫，时说开皇龙汉年。\n淡煮藜羹天送供，闲拖藤杖地行仙。\n共看王室中兴后，更约长安一醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀独孤景略","author":"陆游","text":"富贵世间元不乏，此君才大独难成。\n喑呜意气千人废，娴雅风流一座倾。\n韬略岂劳平大敌，文章亦足主齐盟。\n荒山野水涪州路，肠断西风薤露声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀梁益旧游","author":"陆游","text":"土堠累累只复双，悠然残梦对寒缸。\n乱山落日葭萌驿，古渡悲风桔柏江。\n虎印雪泥馀过迹，树经野火有空腔。\n四方行役男儿事，常笑韩公赋下泷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有所感","author":"陆游","text":"世事真成风马牛，细思愈觉此生浮。\n旧交散后知心少，行路难来出户愁。\n气节陵夷谁独立，文章衰坏正横流。\n鲁中狂士今安有，泪尽朱云草满丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有所怀","author":"陆游","text":"镜里形模日夜衰，三峰师友久睽离。\n芝房又失耘锄候，丹剂常思沐浴时。\n雷雨未成龙起晚，海天无际鹤归迟。\n午窗一钵青精饭，拣得香薪手自炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有叟","author":"陆游","text":"有叟镜湖边，茆茨八九椽。\n凭阑秋万里，闭户醉经年。\n身外浮名小，胸中浩气全。\n此生吾自判，造物恐无权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有客","author":"陆游","text":"有客南山至，相携饭野亭。\n倾篮鱼白白，出笼菜青青。\n米滑溪舂碓，醅浑草塞瓶。\n从今同保社，日醉不须醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有道流过门留与之语颇异口占赠之","author":"陆游","text":"万里纵横自在身，偶然来看剡溪春。\n取将月去闲娱客，携得云归远寄人。\n缩地不妨游汗漫，移山随处对嶙峋。\n须君更出囊中剑，一为关河洗虏尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陆游","text":"云崦重重不易寻，庖厨性命走山林。\n但令有月同幽梦，更用何人识苦心。\n流辈渐稀知死近，鬓毛无色觉愁侵。\n平生自许忘情者，颇怪灯前感慨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感","author":"陆游","text":"温洛荣河拱旧京，从来人物富豪英。\n报仇虽有楚三户，守节得无齐二城。\n胡寇宁能断地脉，王师行复畅天声。\n凤麟久伏应争奋，勉为明时颂太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感二首 其一","author":"陆游","text":"书生事业绝堪悲，横得虚名毁亦随。\n怖惧几成床下伏，艰难何啻剑头炊。\n贷监河粟元知误，乞尉迟钱更觉痴。\n已卜一庵鹅鼻谷，可无芝术疗朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感二首 其二","author":"陆游","text":"读遍名山万卷藏，残年肯受俗低昂。\n正须啸咏风涛上，未至悲辛酒䏑旁。\n梦里功名谁复计，闲中日月不胜长。\n虚皇有诏君知否，尽赐江湖作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂书幽居事五首 其一","author":"陆游","text":"抱瓮穷园叟，还山老布衣。\n死边常得活，闹处偶容归。\n钓恐鱼吞饵，棋忧客堕机。\n此心君会否，洗尽百年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂书幽居事五首 其四","author":"陆游","text":"贫困虽终老，胸中尚浩然。\n直令头抢地，未害鼻撩天。\n种菜悭三亩，苫茅仅数椽。\n布衾常不暖，夜夜亦安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂书幽居事五首 其五","author":"陆游","text":"卜筑南湖上，梅花几度春。\n身缘作诗瘦，家为买山贫。\n野步维渔艇，江楼岸醉巾。\n谁知会稽叟，不愧葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂书幽居事五首 其三","author":"陆游","text":"庭旷多延月，斋空半贮云。\n松声行路共，泉脉近邻分。\n采药九蒸曝，朝真三沐熏。\n林间有丛杞，绕屋夜狺狺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂书幽居事五首 其二","author":"陆游","text":"淡薄齐荣辱，恢疏略怨恩。\n炉常养丹母，手自斲桐孙。\n炎火下照海，黄河高溯源。\n道翁来不速，一笑倒吾樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其二","author":"陆游","text":"客问维摩疾，人哀范叔寒。\n诗囊负童背，药笈挂驴鞍。\n野果攒眉涩，村醪捩齿酸。\n老鸡殊可念，旦旦报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其四","author":"陆游","text":"平生独何幸，命若与人谋。\n疲懦逃深责，空疏得早休。\n位卑轻得丧，迹远少恩雠。\n莫怪归耕乐，文园久倦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其一","author":"陆游","text":"散步持书卷，闲眠枕药囊。\n驯獐随几杖，痴蝶入衣裳。\n病起年光速，身闲日景长。\n为怜红树好，久立向西厢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其五","author":"陆游","text":"倒橐得千钱，从人买钓船。\n秋风宿村步，暮雪醉江天。\n得意鸥波外，忘归雁浦边。\n平生笑严子，犹有姓名传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其六","author":"陆游","text":"泽居忧下湿，老病觉中乾。\n违俗恐不免，倚天聊自宽。\n受规如获药，喜退甚弹冠。\n不是憎勋业，心知骨相寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴六首 其三","author":"陆游","text":"爱物停垂钓，劬身自荷锄。\n时从邻父饮，日授稚孙书。\n尚弃登山屐，宁须下泽车。\n平生双不借，投老伴归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴二首 其二","author":"陆游","text":"散发林间万事轻，梦魂安稳气和平。\n只知秋菊有佳色，那问荒鸡非恶声。\n达士招呼同啸傲，福人分付与功名。\n一篇说尽逍遥理，始信蒙庄是达生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴二首 其一","author":"陆游","text":"造物乘除理固然，许将穷悴博顽坚。\n骥衰伏枥心千里，龟冷支床寿百年。\n好事时供沽酒费，拥途争笑插花颠。\n渔村宿愿虽偿尽，犹恨僧房欠昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其六","author":"陆游","text":"栉发晨兴后，宽腰午饷馀。\n讲明穷理学，雠校养生书。\n倚杖听啼鸟，临池看戏鱼。\n怡然又终日，底事解愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其四","author":"陆游","text":"贵固不如贱，狂应未胜痴。\n闭门真已矣，命驾欲何之。\n碧缕生香袖，清漪涨砚池。\n是中有佳处，不觉昼阴移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其三","author":"陆游","text":"家业贫原宪，年龄老伏生。\n但悲鸾独舞，那羡雁能鸣。\n酿酒秋常醉，驱牛夜亦耕。\n此身当自贵，勿用作投琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其二","author":"陆游","text":"孤学违流俗，危机历畏途。\n逢人增惝恍，看镜失肤腴。\n闭户书围坐，移灯影向隅。\n空怀四方志，泯默死东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其一","author":"陆游","text":"养疾清溪曲，风林几著霜。\n细书如助懒，薄酒不成狂。\n老叹朋侪尽，闲知岁月长。\n柴门偶一出，倚杖立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋六首 其五","author":"陆游","text":"海上鱼盐聚，烟中鸡犬声。\n耕农叱牛去，醉叟策驴行。\n敛薄民差乐，烽消盗略平。\n悠然憩松下，我亦有幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其五","author":"陆游","text":"早仕谗销骨，迟归悔噬脐。\n短衣犹掩胫，穷巷固多泥。\n婢喜蚕三幼，奴贪雨一犁。\n衡茅明我眼，刮膜谢金篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其六","author":"陆游","text":"春晚晴还雨，村深醉复醒。\n溪添半篙绿，山可一窗青。\n药品随长镵，花名记小屏。\n闲身幸无事，吟啸送馀龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其一","author":"陆游","text":"病卧践衰境，躬耕归故园。\n怒蛙号废沼，妖鵩啸荒村。\n里巷鱼餐薄，坊场黍酒浑。\n相逢欲话旧，意极转忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其四","author":"陆游","text":"草径才容步，茅庐仅庇床。\n原贫道尊显，回夭死芬芳。\n弦诵喧清晓，锄耰满夕阳。\n此风能不坠，韦布亦何伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其二","author":"陆游","text":"道进身垂老，方灵病已侵。\n知难逃死籍，犹得遂归心。\n星斗开孤剑，尘埃拂素琴。\n妄庸常衮衮，谁与论幽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次吕子益韵","author":"陆游","text":"吕子奇才非复常，诗来起我醉中狂。\n大音谁和阳春曲，真色一空时世妆。\n东閤献谀无辙迹，西湖寄傲有杯觞。\n病怀正待君湔祓，墨妙时须寄数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次季长韵回寄","author":"陆游","text":"野人蓬户冷如霜，问讯今惟一季长。\n旧好自均亲骨肉，新知何怪薄心肠。\n开书字字论畴昔，遣使年年有故常。\n万念知公扫除尽，见哀底事独难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次林伯玉侍郎韵赋西湖春游","author":"陆游","text":"西湖一别不知年，陈迹重寻麦岭边。\n山远往来双白鹭，波平俯仰两青天。\n残骸自觉难支久，一笑相从亦宿缘。\n旅食京华诗思尽，羡公落笔思如泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次金溪宗人伯政见寄韵","author":"陆游","text":"道义流闻意已倾，岂知晚岁托齐盟。\n六经日月未尝蚀，千载源流终自明。\n汝水家家书有种，吾宗世世士知名。\n读君长句还增气，俗耳那闻韶頀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次前韵","author":"陆游","text":"乌帽红尘过去身，荒山野水又经春。\n残年欲尽初闻道，薄宦宜休不问人。\n一局枯棋忘日月，数斟浊酒约比邻。\n石帆山下菱歌断，未叹临风白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]