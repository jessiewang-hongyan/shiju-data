[{"title":"居茅山作","author":"刘谊","text":"曾跨江西使者鞍，直言才上便休官。\n三茅得梦全清瘦，头发鬅鬙布袄宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郎官湖","author":"刘谊","text":"滚滚长江水，苍苍大别山。\n古今人老尽，山水镇长闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题融州老君岩 其二","author":"刘谊","text":"凿成岩穴鬼工难，中有神仙自往还。\n不见桃花开落处，祇随流水到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题融州老君岩 其一","author":"刘谊","text":"谩说人间假像真，老君形相亦虚言。\n岩前瑞气归宸翰，佛子年年□国恩。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄山温泉","author":"刘谊","text":"山有灵砂泉色红，涤除身垢信成功。\n不除心上无明业，只与山间众木同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":34999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游曾公岩","author":"刘谊","text":"寻得新岩冠一州，使君从此作鳌头。\n千年草莽埋幽致，今日衣冠成胜游。\n洞穴已能惊俗眼，神仙须合隐浮丘。\n主人将为商霖起，还许微官卜筑不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘谊","text":"铜柱将军嗟不见，铁胎丞相镇长存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"刘谊","text":"十里崇因寺，临江水气中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禹碑","author":"刘贽","text":"坛峙麻姑石，溪忘夏禹碑。\n物神人所贵，世事远谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"刘起","text":"琼台东畔石桥西，三径无尘古木垂。\n囊里歌编君相赐，腹中珠穴老庄知。\n风回蕙帐过猿岭，月上茅堂透鸟枝。\n万载圣朝高士传，何人更得效依稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌夜啼 石榴","author":"刘铉","text":"垂杨影里残红。\n甚匆匆。\n只有榴花、全不怨东风。\n暮雨急。\n晓鸦湿。\n绿玲珑。\n比似茜裙初染、一般同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年游 戏友人与女客对棋","author":"刘铉","text":"石榴花下薄罗衣。\n睡起却寻棋。\n未省高低，被伊春笋，拈了白玻璃。\n钏脱钗斜浑不省，意重子声迟。\n对面痴心，只愁收局，肠断欲输时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 送春","author":"刘铉","text":"人自怜春春未去。\n萱草石榴，也解留春住。\n只道送春无送处。\n山花落得红成路。\n高处莺啼低蝶舞。\n何况日长，燕子能言语。\n付与光阴相客主。\n晴云又卷西边雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿胡运使","author":"刘阆风","text":"青原连峰郁嵯峨，中产瑞石如金螺。\n清淑之气孕秀多，蜿蟺旁礴无偏颇。\n间世人杰文星罗，六一鸣道继雄轲。\n忠简名节森聱牙，乃孙所学能传家。\n天孙为织云锦窠，五凤装楼龙作梭。\n吐词摛藻正而葩，纬国经邦真土苴。\n暂屈计台烦抚摩，飞刍挽粟汉萧何。\n专城治郡政不苛，分医散药起札瘥。\n幻出东湖十里荷，百花蔽亏万柳遮。\n民不知劳在咄嗟，涂歌里咏自吟哦，坐致金穰玉烛和。\n登城万宝丰百嘉，黍稷稻粱菽禾麻。\n维时秋律灰吹葭，玉宇凉生雨乍过。\n银河夜静风无波，祥烟瑞霭纷交加。\n只说牛女此会佳，谁知神仙降云车。\n中驱下扶走乘戈，玉妃拥卫不撝呵。\n童女十二颜如花，乘鸾吹箫静无哗。\n弹璈戛玉献琵琶，琴奏双成瑟女娲。\n仙掌金茎吸露华，西凉蒲萄胜流霞。\n桃实如蟠枣如瓜，祝公千百算增遐。\n公持玉节镇龙沙，我领辕门吉水涯。\n一水东西骋望赊，安得共泛张骞槎。\n秋风阊阖鸣玉珂，公归调鼎我盐醝，持衡不致斤两差。\n诗寄柏梁愧猗那，因词见意倘可歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠 其二","author":"刘寅","text":"人谓吴痴信不虚，建崇越相果何如。\n千年亡国无穷恨，只合江边祀子胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三高祠 其一","author":"刘寅","text":"江流东去日滔滔，谁把功名等一毫。\n若使今人同古调，不应江上只三高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农和江万里韵","author":"刘崇卿","text":"年来兵饷瘠吾农，天遣仁侯作岁丰。\n燕寝昼清尘不到，螺江春满泽无穷。\n诗陶幽雅熙熙俗，文续周书噩噩风。\n别乘自怜无锸地，劝耕却得到山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"刘接","text":"猎叟藤编户，徭人草结庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"刘接","text":"水来五渡若铺练，山对九疑如画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"刘接","text":"湛湛直通龙渡水，㶁㶁傍过鹿头山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发成都 其三","author":"刘望之","text":"一夜孤舟浪打头，不容客梦到沧洲。\n谁言江上烟波急，未抵归心一半流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发成都 其二","author":"刘望之","text":"欲洗羁愁只自醒，郫筒酒好信虚名。\n江阳春色论千户，价比西州却未轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发成都 其一","author":"刘望之","text":"落拓平生载酒行，如今憔悴鬓丝生。\n无金得买青楼笑，空负闲愁出锦城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗二首 其二","author":"刘望之","text":"孤舟未晚泊，烟火傍人家。\n小市常忧虎，空城不见花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗二首 其一","author":"刘望之","text":"归计堕何许，出溪仍溯流。\n梦回牛溉路，行到马湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久留少城","author":"刘望之","text":"好去相羊乌角巾，却来躏踏软红尘。\n酒因觅睡方成醉，金为收书更觉贫。\n屡入草堂难下语，少留药市恐逢人。\n可怜吊古凄凉意，只向扬家往返频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子云故居","author":"刘望之","text":"杀却王章爱孔光，举朝谁复说兴亡。\n未能免俗歌新美，岂不怀归念楚狂。\n斗酒只今犹寂寞，小池无旧已荒凉。\n秋风细雨催人去，似恐徘徊费感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出游","author":"刘望之","text":"漫有游随意，何曾语展眉。\n琴台悲犬子，江路忆熊儿。\n修竹萧萧寺，平芜浅浅陂。\n年来底事业，访古但饶诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古柏","author":"刘望之","text":"草木长生亦偶然，不须闻此便谈仙。\n烧枝竞说丹飞日，举世宁知手种年。\n双鹤不归秋自冷，万牛回首句空传。\n相逢一饮清阴下，与子前生定有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沱江","author":"刘望之","text":"尚胜三年谪，终惭万里驯。\n极知行路涩，可忍在家贫。\n岁晚沱江绿，云深锦树新。\n相思肯如月，夜夜只随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草堂","author":"刘望之","text":"风月藏诗骨，流离赋病骸。\n不禁一饱死，空遗百生怀。\n树秀天通陇，山娇客语淮。\n壁间无半偈，无乃望君崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新都驿远平轩","author":"刘望之","text":"霜晴木落送归鞍，袖手微吟此慰颜。\n胜欲凭栏招白鸟，更烦剪树出青山。\n晚悲薄禄非三釜，赖许清诗见一斑。\n看到远平才得恨，我宁归卧尺椽间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙多山","author":"刘望之","text":"金船载山知有无，大千浮空佛所书。\n何人夜断海山臂，一手挈置西南隅。\n白虹发晴涪水现，翠凤下晓巴山趋。\n亮哉何邦实有此，但恐□舞皆凡姝。\n已从上头收浩荡，更著幽处藏萦纡。\n冯仙观中柏摩月，静老岩下泉跳珠。\n霜荷千树小雨暗，野竹万个秋风□。\n石囷□不了岁事，丹灶肯为凡人炉。\n惜无数桃出山崦，来藉芳草开春壶。\n从来山僧野道士，畏客誓不荒榛芜。\n问谁结屋据雄会，邑中令君秦大夫。\n此郎平生眼如鹘，视此亦足知远图。\n挽衣留客来置酒，要看碧浪摧天吴。\n我亦为渠脚力轻，拄杖插到青云孤。\n酒酣抚槛叫落日，共闵此世真区区。\n真须举臂游汗漫，莫向人间堕履凫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔枝","author":"刘望之","text":"泸戎瘴疠窟，闽粤山水乡。\n如何产此物，烂然照炎荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"刘望之","text":"平山堂下花无数，看到海棠春好处。\n东君用意恼风光，迟日放开阴勒住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读和议成赦文作","author":"刘望之","text":"一纸盟书换战尘，万方呼舞却沾巾。\n崇陵访沈空遗恨，郢国怜怀若有人。\n收拾金缯烦庙算，安排钟鼎颂宗臣。\n小儒何敢知机事，终望君王赦奉春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题三学山","author":"刘望之","text":"栖贤古招提，十里巨松阴。\n栋宇自隋氏，悠悠岁月深。\n唐人范生画，风雨欲剥侵。\n相传金仙趾，玉质存至今。\n星黑夜正午，异物为华灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"刘望之","text":"劝子一杯酒，清泪不须流。\n人间千古，俯仰如梦说扬州。\n何况楚王台畔，为雨为云无限，人事付轻沤。\n聚散随来去，天地有虚舟。\n谪仙人，解金龟，换美酒。\n载与君游，流水曲觞且赓酬。\n麾盖飞迎过霭，江滨响振歌喉，拚醉又何求。\n三万六千日，日日此优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令","author":"刘望之","text":"休絮。\n休絮。\n我自明朝归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"刘望之","text":"只应将巧畀人间，定却向、人间乞取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"刘望之","text":"山绕郡楼秋过雨，月临池树晚生烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"刘望之","text":"海山无瘴八蛮清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"刘望之","text":"地连巴楚峰岚见，节近清明柳色知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"刘望之","text":"山盘四十八面险，云暗三百六旬秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"刘望之","text":"南县烧畬早，西溪落涨初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"刘望之","text":"便作稽山看，犀湖五月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"刘望之","text":"闻说南州异，寒来正月并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"刘望之","text":"凤林秋晚见日落，鹿门事远无人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"刘望之","text":"剩破朱红供短发，南荒来校世间书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"刘望之","text":"莫道南州居井底，请来此处望川原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭谪象州","author":"刘梦才","text":"绍兴宝庆百年馀，古往今来说二胡。\n论事直须弹恳切，立朝端不忍阿谀。\n两贤幸属吾州有，万事何曾公议无。\n象郡新宁不同诏，九重天子正仪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华延年卜诗","author":"刘梦求","text":"邲鉴总龟如往学，未见才名能广博。\n希点若来参学时，同年从此不须疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日游九龙岩","author":"刘梦符","text":"突兀灵岩古，纡回石磴升。\n地幽忘日烈，壁峭喜云蒸。\n峰顶池如月，山根水欲冰。\n摩挲可镌处，大字纪中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 子寿父","author":"刘清之","text":"江南十月春风早。\n见枝上、梅英小。\n爱日初升清雾晓。\n绣筵中启，星图高挂，膝下斑衣绕。\n今年献寿多欢笑。\n弄玉新将二雏好。\n此曲尊前何所祷。\n十分康乐，十分强健，一树庄椿老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 子寿母","author":"刘清之","text":"柳色青青罩翠烟。\n花光灼灼映临川。\n欲知窈窕呈祥日，恰近清明淑景天。\n浮瑞霭，庆真仙。\n不须男女祝椿年。\n异时早约西王母，剩折蟠桃荐寿筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"刘清夫","text":"残腊卷愁去，春至莫闲愁。\n荣枯会有成说，无处著机谋。\n身世石中敲火，富贵草头垂露，何用苦贪求。\n三尺布衣剑，千载赤松游。\n忆亲朋，方丱角，总白头。\n羊肠世路巇崄，莫莫且休休。\n选甚范侯高爵，遮莫陶公钜产，争似五湖舟。\n万事付蜗角，止坎谩乘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 咏刘篁栗碧莲，时内子将诞","author":"刘清夫","text":"浅碧芙蓉，素艳亭亭，前身阿娇。\n记湘滨露冷，酥容倍洁，华清水滑，酒晕全消。\n瑶剪丰肥，云翻碎萼，白羽鲜明时自摇。\n风流处，是古香幽韵，时度鲜飙。\n琼枝璧月清标。\n对千朵婵娟倾翠瓢。\n况水晶台榭，低迷净绿，冰霜词调，隐约轻桡。\n细认金房，钟奇孕秀，已觉青衿横素腰。\n西风晚，看花开十丈，玉井非遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金菊对芙蓉 沙邑宰绾琴妓，用旧韵戏之","author":"刘清夫","text":"浅拂春山，慢横秋水，玉纤闲理丝桐。\n按清泠繁露，淡伫悲风。\n素弦瑶轸调新韵，颤翠翘、金簇芙蓉。\n叠蠲重锁，轻挑慢摘，特地情浓。\n泛商刻羽无穷。\n似和鸣鸾凤，律应雌雄。\n问高山流水，此意谁同。\n个中只许知音听，有茂陵、车马雍容。\n画帘人静，琴心三叠，时倒金钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘清轩","text":"可笑吴痴亡越憾，却誇范蠡作三高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"刘渊","text":"当时兴废事，说著意犹悲。\n自谓水不返，谁知云解归。\n十年麋鹿恨，一卷杜鹃诗。\n又入离骚国，清弹霜叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同友人泛舟至仁王","author":"刘焘","text":"青秧出水细于针，嫩叶初齐绿未深。\n又是一年春欲尽，杖藜乘兴足幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罨画溪","author":"刘焘","text":"竹林深处杜鹃啼，两岸青青草色齐。\n欲识人间真罨画，朱藤倒影入清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶","author":"刘焘","text":"聚作梨梢白，轻争柳絮狂。\n夜来花里宿，通体牡丹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱邑墓","author":"刘焘","text":"古木森森覆墓亭，大农祠在古桐城。\n后来为政应千辈，能使斯民独有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题召伯埭斗野亭","author":"刘焘","text":"地势如披掌，天形似覆盘。\n三星罗户牖，北斗挂阑干。\n晚色芙蕖静，秋香桂子寒。\n更无山碍眼，剩觉水云宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿华严院","author":"刘焘","text":"夜宿雾山雾，晨茹芝山芝。\n年来嗜好衰，但与青山宜。\n登临意未惬，出户车已脂。\n王事有期程，爱山岂余私。\n崎岖田野间，食寝将安之。\n天寒未落日，税驾忽在兹。\n二山已陈迹，兹处尤新奇。\n翠竹与黄花，一一对山扉。\n对景自忘言，若与予心期。\n眠云饱山色，那得困与饥。\n山僧喜我来，迎我留新诗。\n我有爱山痴，山僧知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题乐平寺","author":"刘焘","text":"名蓝占幽寂，花木深禅房。\n开轩俯芳流，竹风终日凉。\n谓此已胜绝，坐可雄诸方。\n谁知槿篱外，古木郁苍苍。\n下有湍激涧，珠玉鸣琅珰。\n何当开松门，两岸安石床。\n尽发溪山奇，枕流挈其芳。\n他年我重来，君子留徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八宝妆","author":"刘焘","text":"门掩黄昏，画堂人寂，暮雨乍收残暑。\n帘卷疏星门户悄，隐隐严城钟鼓。\n空街烟暝半开，斜日朦胧，银河澄淡风凄楚。\n还是凤楼人远，桃源无路。\n惆怅夜久星繁，碧空望断，玉箫声在何处。\n念谁伴、茜裙翠袖，共携手、瑶台归去。\n对修竹、森森院宇。\n曲屏香暖凝沈炷。\n问对酒当歌，情怀记得刘郎否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]