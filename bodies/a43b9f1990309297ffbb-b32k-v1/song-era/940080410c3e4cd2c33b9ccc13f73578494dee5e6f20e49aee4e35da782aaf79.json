[{"title":"偶书","author":"晁说之","text":"京华可望无高楼，闻道故人多白头。\n此身却似城东柳，惜别伤离不自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见司马公休陈无己书简感旧作绝句","author":"晁说之","text":"卓行高文司马陈，当年简牍拂埃尘。\n身名暂振久青冢，见在凄凉海畔身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见张天贶奉议书策后题跋感旧作绝句","author":"晁说之","text":"轩轩众艺张天贶，翰墨悲凉二绝馀。\n今日无人知姓字，史官他日若为书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见夏英公与文庄公书云秋序始凉师门尚远又一书云念其出自师门赐一善地辄成绝句","author":"晁说之","text":"前辈终身知学植，今人得意讳师门。\n如新几帖英公字，可但吾家礼数尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶见新花呈季和","author":"晁说之","text":"寂寥仍抱病，风雨尚征师。\n几许野花发，无穷客泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李辅之 其二","author":"晁说之","text":"布裘菜饭久忘言，粝食粗衣过上元。\n怪底狂风迷四野，荣光自满濯龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李辅之 其一","author":"晁说之","text":"嫁树裁花待上元，一灯明焰照山樊。\n香炉下烟霞客，此夜皇州亦掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄昭德兄弟 其一","author":"晁说之","text":"莫言无合亦何伤，旅雁卑飞怯稻粱。\n南亩荒芜嵩少远，却来楫口祭勾芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼乱","author":"晁说之","text":"解组边亭畿甸来，且将白发共徘徊。\n去年亭下花何在，日夜胡尘不得开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜春","author":"晁说之","text":"待得莺来花已落，断难料理漫咿嚘。\n便如前哲亦非敌，八斗才当万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚日临水得此句呈季和先为公家池上明日之游也","author":"晁说之","text":"客子思归悔远游，曾波新绿恋汀洲。\n庾郎得暇为春赋，定是春来未肯愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲谈","author":"晁说之","text":"欲谈无应莫吾容，悔不居身可否中。\n尽日小斋何所乐，芭蕉宜雨竹宜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮海二绝 其二","author":"晁说之","text":"莫问扬州桃叶生，渡江今日得风晴。\n长沙子弟更相笑，上到隋堤便住营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淮海二绝 其一","author":"晁说之","text":"卜钱簇簇怯单单，小妇扬州桥上看。\n拜鬼求神春更恨，不堪风雨作花寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"累夜读武经总要慨然思陈叔易寄予嵩阳读水经之句因用其韵作寄叔易此公相与倡和最多于此诗则每诵之 其三","author":"晁说之","text":"蓬莱学士有家声，易退难忘旧杀青。\n万卷饶君相似处，此生不读膳夫经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"累夜读武经总要慨然思陈叔易寄予嵩阳读水经之句因用其韵作寄叔易此公相与倡和最多于此诗则每诵之 其二","author":"晁说之","text":"风送黄河冰底声，三川半死误丹青。\n何人告与君消息，枉是磨铅勘水经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜鲁直还用前韵再作 其二","author":"晁说之","text":"鹧鸪不入馔，松柏有常心。\n归来应未老，但道古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜鲁直还用前韵再作 其一","author":"晁说之","text":"梵志问故邻，木兰坐旧床。\n去恨已断绝，归意更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒甚","author":"晁说之","text":"二月春风著意来，毡裘北客尚低回。\n只应是日无何逊，江上梅花未肯开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食书事","author":"晁说之","text":"冷官不易逢寒食，海角风霜剩作寒。\n杏粥榆羹浑不见，蓬池春色梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悲秋","author":"晁说之","text":"白杨夹道起秋声，要使征人恨不平。\n自笑一生成底事，元常笔秃却谈兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览冀亭榴花","author":"晁说之","text":"长夏清江倚碧岑，人间尘土莫相侵。\n榴花不得春工力，颜色何如桃杏深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"痛恨","author":"晁说之","text":"胡儿直犯洛阳宫，蔼蔼园陵指点中。\n殄灭四夷心不遂，裕陵萧瑟独悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答恂阇黎乞浆","author":"晁说之","text":"白头破褐恂阇黎，硬白高谈岂易知。\n却喜粟浆如北客，从教薄相笑无奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢季和朝议牡丹","author":"晁说之","text":"侍无童子懒焚香，君送花来恨便忘。\n尽日清芬与风竞，熏炉漫使令君狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢圆机灵山芍药","author":"晁说之","text":"灵山芍药谁销得，我是灵山授记人。\n贪蝶惏蜂莫来到，更须作供老夫身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢圆机送梅","author":"晁说之","text":"何事新梅度玉溪，应怜泯默与诗题。\n少年曾赋宋开府，老大无如羯鼓迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢钱掾","author":"晁说之","text":"论思献纳方自代，海舶鮹人岂识渠。\n长啸清风含雪语，怜侬不解读新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢乾明滋老送炒团","author":"晁说之","text":"蓼花散畔轻盈意，炒米团边笑语亲。\n多谢稻畦磨衲老，十方撮聚戏閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢景修惠洞庭春色","author":"晁说之","text":"洞庭春色何年赋，越国王孙几种愁。\n今日忽亲鹦鹉杓，当家馀韵落芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢曾迪功松皮冠","author":"晁说之","text":"松皮冠赠松山客，惭愧红尘赤日中。\n好向浮云傍归路，定应剩听入琴风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢蕴文承议阳关图","author":"晁说之","text":"邂逅故人逃难处，王孙气象独升平。\n诗吟摩诘如无味，画到阳关别有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢蕴文荠菜馄饨","author":"晁说之","text":"无奈国风怨，荠荼论苦甘。\n王孙旧肥羜，汤饼亦多惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢魏宰惠芍药","author":"晁说之","text":"敢期芍药边城见，本是人间第一流。\n我有无穷羁旅恨，为君今日到扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩二十七诗来云已束归鞍逐去鸿令人欣喜愧叹辄次韵和","author":"晁说之","text":"此身重滞愧征鸿，况对庭前郢树风。\n暂至京师便归去，敢期今日有黄公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叠后","author":"晁说之","text":"病眼终朝更懒开，难输心曲语悠哉。\n从教苔径无人到，日日潮声自上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"叠前","author":"晁说之","text":"董生今日窥园圃，几许伤心涕泪垂。\n金令不行呈木怪，无端灾异乐哀为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁 其一","author":"晁说之","text":"云暗花寒春在否，烟波漠漠不禁愁。\n此愁肯逐杨花散，常与幽人种白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"愁 其二","author":"晁说之","text":"无奈愁来欲解携，春光何事亦如迷。\n只应自有人行乐，枉是多情王会稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新合柏子香因诵皮日休坐久重焚柏子香辄以其香赠张簿","author":"晁说之","text":"柏子香清谁喜闻，五言句法更清芬。\n病仍春困在难久，遣向吟窗起暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新年","author":"晁说之","text":"何事重新作此年，身无疾病意欣然。\n春风莫但开桃李，吹落妖星静九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简沙头李山伯","author":"晁说之","text":"坎离交养日需沙，君向沙头好泊家。\n鸥鹭若来寻旧隐，为言直上有烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄜州人语间有似河朔人处予独知其然盖此本魏之上郡魏人以归秦之三年秦遂称王而不乐为秦民之故其音犹魏也作绝句","author":"晁说之","text":"魏郡归秦秦遂玉，音犹故魏恨难忘。\n谁知我本魏郡士，比汝独思田子方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题大年阁路逢僧图","author":"晁说之","text":"关深羁思满，风断绿阴单。\n一遇空门侣，那知行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题公震小景","author":"晁说之","text":"万古兴亡归白鹭，一时舒惨在青山。\n与君都下太平日，岂料思君鼙鼓间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题弟子问","author":"晁说之","text":"人物昭陵一代倾，墨庄夫子著书成。\n我生既晚复何恨，解叩青霜钟大鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨如晦二画 边鸾雉","author":"晁说之","text":"骇雉丹青人姓边，无花无石自瞿然。\n已能倚壁音声绝，何用蹲飞欲上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画扇","author":"晁说之","text":"秦秦何处乐，独自托孤枝。\n玉粒知无分，清风也自戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新泉","author":"晁说之","text":"舍北洗山如有待，舍南泉发本无期。\n羁愁尽落清音里，不用骞公读楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠仪真天宁讷老","author":"晁说之","text":"若说真州水，时人不道甘。\n天宁老谁识，板齿毛鬖鬖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠京师少年在海陵者","author":"晁说之","text":"夷门子弟逞豪华，不忿西京谷雨花。\n走马城东玉仙醉，着身海角敢咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠柳三解 其三","author":"晁说之","text":"桃李那知杨柳恨，故时风雨不依依。\n自从彭泽无人后，青眼虽开心事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠柳三解 其一","author":"晁说之","text":"莫道垂杨管别离，与春离别自依依。\n若教兼有征人恨，只恐鸦儿不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠柳三解 其二","author":"晁说之","text":"海角那知有宫柳，故园春思尚依依。\n可怜风韵去人远，一日花开天际飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠笔处士屠希","author":"晁说之","text":"屠希祖是屠牛坦，今日却屠秋兔毫。\n自识有心三副健，可怜无副一心劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠笔处士曹忠","author":"晁说之","text":"苇管予何爱，轻圆称白毫。\n固知今独妙，旧数浙西曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠童子蚍蜉","author":"晁说之","text":"拂拭方山帽，安排一复巾。\n春秋书满架，整整莫因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠道光","author":"晁说之","text":"老僧讲罢结茅庐，忆昔鸣琴着意馀。\n一曲风前三百遍，十年不作作如初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠鄜州田玘","author":"晁说之","text":"前世能歌田顺郎，今身追悔太昌昌。\n戏泥巧尽群儿态，休忆小姑初倚床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠雷僧 其三","author":"晁说之","text":"留官莫去且徘徊，官有白茶十二雷。\n便觉罗川风景好，为渠明日更重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠雷僧 其一","author":"晁说之","text":"蓬头冰齿独徘徊，五百年前人姓雷。\n为问罗川何处好，笑言京洛总看来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠雷僧 其二","author":"晁说之","text":"东奔西走肯徘徊，言语相残听鼻雷。\n未料此生终作底，可知不为学诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避地","author":"晁说之","text":"久欲为僧避世喧，况当寰海正飞翻。\n五台自有天台院，处处流通玄妙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月一日作","author":"晁说之","text":"去秋今复号新秋，要使新愁入旧愁。\n四海元龙霖雨望，一生仲举国家谋。\n囚冠不脱凋蓬鬓，旅殡何堪败蒻舟。\n谁与此怀同涕泗，南山朝霭暮烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"晁说之","text":"日日无堪只叹嗟，谁教九日事豪华。\n寂寥难落方山帽，烂熳先开野菊花。\n闻道鹓鸾趋镐燕，忍将鸿雁听边笳。\n古来感慨今朝甚，苦雨凄风助我赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日宴李德充中大家次韩三十六丈韵作","author":"晁说之","text":"重阳风雨每凄凄，物色今年得所期。\n赐第好贤多骥子，三山酌酒过鹅儿。\n红楼尚想吹箫夕，碧树今誇出日枝。\n我与韩公殊辈行，门阑感旧泪俱垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日陪韩三十六丈大夫集李德充家再蒙赋诗相似谨次韵攀和","author":"晁说之","text":"丈人邂逅共悲凄，九日芳樽敢有期。\n感慨既能追壮士，欢欣复自学群儿。\n菊憎紫蕊侵黄蕊，萸愤南枝胜北枝。\n萧史高楼幸登眺，但惭清唱手空垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十二弟获金印","author":"晁说之","text":"季也获金印，籀文秦不如。\n情知非鬼篆，恨不识天书。\n池静龟游罢，庭閒鹊斗馀。\n春风还旧物，疏俊独怜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二日","author":"晁说之","text":"柳花多情不肯新，可怜失尽汉家春。\n二年不识挑生菜，万国谁知有杀身。\n群盗犹多南渡客，征鸿难问北归人。\n始知前日一樽酒，上帝升平与尔亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二弟寄诗一编来用其山字韵作","author":"晁说之","text":"季诗来灞岸，秀色蔼雕山。\n独笑寒暄外，相逢翰墨间。\n花飞能拥路，月入不开关。\n巧解供新句，吾才愧晋悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月七日夜梦中作两长句觉而忘之别成长句视李师民","author":"晁说之","text":"冬来羁旅更迢迢，抚枕灯残百感饶。\n饥鼠翻空疑有鬼，惊乌误晓尚中宵。\n诗成与梦俱零落，剑出低眉亦寂寥。\n无分京华居老境，江湖高隐幸相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又再和","author":"晁说之","text":"人人讲德自元丰，何处荀家有八龙。\n白羽不施宁洗甲，赤云常见预乾封。\n无烦禾黍如茨稼，自足鹓鸾琢玉容。\n稽首宝香通列毕，倾心御籴走良农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又依韵一首","author":"晁说之","text":"看去朱轓今已归，问余山郡几多时。\n盘绦绫样知能盛，带叶甘香定不衰。\n惜别荔枝红发?，恨看山岭碧参差。\n自怜藉手有何物，学把锄头不用嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和","author":"晁说之","text":"客子吟哦聊遣闷，敢将鱼目报珠玑。\n寒来何事水流急，愁里更堪人住稀。\n使我难忘麋鹿性，多君已弃芰荷衣。\n山斋永夜宜清话，莫只山公倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和西捷","author":"晁说之","text":"西州五帅议多攻，决策曾闻利不穷。\n今日一乘能必取，异时重译要皆通。\n明光喜霁甲兵雨，沙碛恩摇草木风。\n自顾腐儒何所补，骑猪难在虎狼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]