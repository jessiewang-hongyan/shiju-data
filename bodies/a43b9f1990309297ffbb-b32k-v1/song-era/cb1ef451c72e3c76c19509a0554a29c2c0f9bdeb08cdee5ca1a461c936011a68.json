[{"title":"梅仙观","author":"洪朋","text":"炎灵失其御，四海无安税。\n呜乎梅南昌，脱屣元始岁。\n小臣披肝胆，宫掖事严秘。\n上书竟渺茫，弃掷江湖外。\n一朝厌蜗角，万里骑鹏背。\n向来杀青士，此事美无对。\n到今瑶池地，风露翔孔翠。\n仰瞻神界游，千载想生气。\n愿为龙鳞婴，勿学蝉骨蜕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"洪朋","text":"好在龙沙黄，俄入鸾江碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"洪朋","text":"盱母江头唤渡人，遥指麻源第三谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"洪朋","text":"茧收松上雪，麦刈陇头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"洪朋","text":"蒲根水满雁初下，梅径香寒蝶不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"洪朋","text":"花明柳暗一溪水，日薄云浓三月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"洪朋","text":"海棠照日倚垂杨，万缕千丝影零乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十一","author":"洪朋","text":"蕊珠宫殿拥神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十二","author":"洪朋","text":"赠我麝煤如黑玉，为君龙尾濯清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其十三","author":"洪朋","text":"棹歌缥缈城西路，烟树参差埭北村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲华洞答友人","author":"洪刍","text":"莲峰耸崔巍，在眼昔未到。\n发兴空盘纡，舒写属吟啸。\n五老如有情，遥岑动清眺。\n新篇下紫霄，语我游历妙。\n物景会相忘，烟霞领其要。\n坐石掬清流，缘云睨奔峭。\n悠然俛仰间，无心乃同调。\n偕游会有期，山灵勿腾笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游泐潭寺","author":"洪刍","text":"吾闻石门山，对峙俨天辟。\n林茂山自青，草香涧长碧。\n中有古招提，柱栱焕青赤。\n惟昔马大士，方坟耸遗迹。\n龙象仰慈颜，马驹谶前识。\n香火有因缘，窗户坐幽阒。\n瓶锡想异时，云水饱游历。\n饮波浥曹溪，法雨被江国。\n大阐选佛场，法战无兼敌。\n我非山中人，暂著登山屐。\n东阁嘲书淫，净境酬诗癖。\n朝涉潺湲溪，暮陟崔嵬石。\n敷床听犍椎，钵饭分香积。\n山高日易斜，梦短夜分寂。\n神心颇灵明，俗虑讵充斥。\n归欤得短章，投笔疥其壁。\n政如抱布鼓，岂能飞霹雳。\n径须倩阿香，轰然听霆击。\n忽传汤休篇，风骚共推激。\n何当从君游，愿飞恨无翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次子字韵呈郑太玉","author":"洪刍","text":"斯文不可见，犹欣识之子。\n端如逃虚空，而闻跫音喜。\n历历海南事，细话倾我耳。\n悠悠世上情，毁誉私彼己。\n是事姑置之，斯文长已矣。\n风味契渊明，流落逾子美。\n从来直如弦，多作道边死。\n寄声柳柳州，未用斩曲几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤鹤行赠杨君","author":"洪刍","text":"翩翩云中鹤，来自华亭滨。\n徘回久乃集，伫立江之濆。\n高步整霜羽，只影翔秋旻。\n岂无鸿鹄侣，俛仰鸡鹜群。\n啄腥细流中，汝食得无贫。\n况有缯缴虞，惊顾何逡巡。\n珠庭响清唳，胎仙舞祥云。\n胡不矫翮去，来仪瑞吾君。\n饥食玉山禾，渴饮瑶池津。\n无言九皋远，鸣阴谁不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题贯时轩诗","author":"洪刍","text":"古人憩息地，不种凡草木。\n数竿何必多，可以慰幽独。\n忘忧玩芳草，怡颜眄庭柯。\n岂无艳阳节，摇落将如何。\n彼美轩中人，澹然对浮云。\n此君有佳处，心期暗相亲。\n萧萧四时色，目击道逾妙。\n君看竹得风，天然向人笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 警露","author":"洪刍","text":"皎皎蟾桂明，耿耿星斗烂。\n清梦时时惊，零露滴霄汉。\n伟哉仙人骑，从来知夜半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 顾步","author":"洪刍","text":"举趾一何高，脩颈宛回顾。\n只影踉蹡行，眷然慕俦侣。\n岂忘赤霄上，盘桓此池籞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 理毛","author":"洪刍","text":"飘飘青田质，敛翼在亭皋。\n回此碧玉喙，刷我白雪毛。\n顾影矜羽仪，孔翠非其曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 唳天","author":"洪刍","text":"清唳九皋内，抗音薄层云。\n戛然时一鸣，流响惊人群。\n嗟哉陆内史，华亭无复闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 舞风","author":"洪刍","text":"归来丁令威，暂别已千年。\n抽琴奏清角，婆娑舞胎仙。\n何必拊节和，御风自泠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因读梅圣俞六鹤诗或令余别赋之 啄食","author":"洪刍","text":"昂昂兀兀姿，朱冠垂素翎。\n首下尻益高，徘回我中庭。\n俯仰鸡鹜群，啄腐复吞腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同师川过李三十九湖上宅用师川韵","author":"洪刍","text":"多书唐邺侯，蔼蔼盛云来。\n髯公颇好事，相过必迟回。\n结构平湖阴，清绝无纤埃。\n数到不知远，君家宽酒杯。\n绕水信杖屦，披靡蓬蒿开。\n遗基访孺子，荒坟吊澹台。\n诛茅卜邻并，兹愿何当谐。\n七松未暇种，五柳径须栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同陈虚中劝农出郊因游明水山寺","author":"洪刍","text":"深树鸣鷤䳏，红紫春事休。\n临川贤假守，只今陈太丘。\n驾言出远郊，班春临道周。\n亦招素冠士，来从朱轓游。\n晨兴惬胜引，适此夜雨收。\n原隰乱高下，意行逐前俦。\n荒荒白水满，郁郁稻秧抽。\n旧闻明水寺，宛在岩之幽。\n石门本无关，鸣禽自相求。\n不有省耕役，俗驾来何由。\n老屋隐乔木，野僧事良畴。\n松径深窈窕，轩车纷少留。\n迟回动归兴，冲雨戒摧辀。\n危情极冰渊，细路遵塍沟。\n深泥艰涉足，竹鸡为我愁。\n岂惮来往频，清与耳目谋。\n回首谢青山，寻盟亦悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠倪涛少府","author":"洪刍","text":"君从淮上来，手持阿髯诗。\n尘埃欣拂拭，得此带经倪。\n珠璧岂投暗，按剑有馀悲。\n愿保青云姿，勿叹黄绶卑。\n太山驻翠辇，行草封禅仪。\n汉皇傥借问，润色非君谁。\n我非国侨贤，惭负延陵知。\n缟带敢虚辱，赠言当纻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和郑太玉新居","author":"洪刍","text":"荒涂负崇冈，君居在其麓。\n下与佛界连，一径通刍牧。\n高情慕天随，枵腹茹杞菊。\n数椽负郭居，窈窕凿空谷。\n忆昨步过君，窘步侵两足。\n听君亹亹谈，霏屑落锯木。\n相依方在兹，凉飙荡烦燠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宴李氏园亭得庆字韵","author":"洪刍","text":"我来北斗南，两见回东柄。\n万斛开府愁，四壁文园病。\n谁知深巷中，卉木颇幽夐。\n大梁贤公子，携酒宾亦命。\n红蕤已飘零，绿绮方辉映。\n岂惟追寻迟，亦苦风雨横。\n主宾混谁何，谈笑杂嘲评。\n讵知时雨灵，但觉中酒圣。\n年丰乐崇宁，诗敌蹑长庆。\n况有雷陈交，何必宛洛盛。\n律管承飞灰，羲和驻春令。\n日月曾几何，佳辰我所竟。\n芍药殿馀春，想见晨妆靓。\n一醉欢有馀，此集君其更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黄稚川云巢","author":"洪刍","text":"云巢一上十五里，中有今世巢居子。\n鸡鸣犬吠白云里，不知天际去此几。\n平生深契鸟巢禅，剪茅盖头万事已。\n宴坐经行飞鸟上，人间荣辱不到耳。\n蜗牛两角竟何为，鹪鹩一枝端自喜。\n我有一廛落城市，章服裹狙聊复尔。\n武溪未访桃花源，脩江傥问桃花水。\n会取樱桃洞前路，藜杖扶衰从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏用荆公体呈黄张二君","author":"洪刍","text":"金华牧羊儿，稳坐思悠哉。\n谁人得似张公子，鞭笞鸾凤终日相追陪。\n长夏无所为，垒曲便筑糟邱台。\n古今同一体，吾人甘作心似灰。\n南方瘴疠地，郁蒸何由开。\n永日不可暮，渴心归去生尘埃。\n人生会合安可常，如何不饮令心哀。\n张公子，时相见，我能拔尔抑塞磊落之奇才。\n只愿无事常相见，有底忙时不肯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松棚","author":"洪刍","text":"南山落落千尺松，干云蔽日摇青葱。\n盘根错节岁月古，龙吟虎啸号悲风。\n北山文杏中梁栋，我材臃肿非世用。\n脩枝细叶幸有馀，赪肩大束那辞送。\n承以高竹青扶疏，置君宽闲之玉除。\n倏如乱云驻车盖，恍似广庭张拂庐。\n垂头塌翼下孔翠，张鳞摆鬣来鲸鱼。\n穿空入隙清飙吹，疑有万壑哀声随。\n羲和按辔不驰骋，炎官火伞将安施。\n朅来投荒近循海，日坐板屋如蒸炊。\n南山苍官怜我热，遗我七鬣千孙枝。\n但令脩干青青多，温风烈日如予何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次洪上人云巢韵","author":"洪刍","text":"黄子厌喧求避俗，直上孤峰结茅屋。\n欲期汗漫游九垓，俯视尘寰战蛮触。\n小山招隐唤不回，旧时从事有边幅。\n不能投笔学文鸳，底用决科似张鷟。\n自赋云巢自高唱，手握灵蛇嗤鱼目。\n由来江夏多可人，蓝田片片生美玉。\n要须青山顶上行，去伴白云檐下宿。\n西湖窟穴对华榱，肯把兰亭比金谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"板屋","author":"洪刍","text":"西戎板屋诗所录，瓯闽万里同风俗，风吟日暴雨所沐。\n巧匠引绳如解玉，溪民得之亟乘屋。\n既轻且坚尺度足，可怜童我南山木。\n君不见曹瞒邺下铜雀台，陶土作瓦何壮哉。\n台倾基平瓦尚在，凿为大研奇且瑰。\n君不见黄州使君誇竹楼，剖竹俛仰相绸缪。\n琮琤最宜雨中听，击考有类鸣琳球。\n铜雀幺么何足摹，箨龙燥轻易焚如。\n不如杉屋寿且姝，风雨不动何渠渠。\n嗟予抱衅谪蛮夷，如人体瑰欣解衣。\n数椽破屋亦不恶，仰见星宿相参差。\n鸱鸮作室庇风雨，鹪鹩巢林安一枝。\n凌云大厦鬼所窥，衡门之下可栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次陈州","author":"洪刍","text":"一水萦回橐驼项，百丈遥牵如簸掌。\n鸬鹚捕鱼没复出，鹭鸶行沙俯还仰。\n白云思我白头亲，双足未到心先往。\n黄昏系缆危台边，饭糗羹藜莫惆怅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李少微韵","author":"洪刍","text":"春风杨柳岸，寒食杏花村。\n对月惊生魄，思人暗断魂。\n我闲无吏考，君治有司存。\n又作匆匆别，相逢席未温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王张赠别之作","author":"洪刍","text":"五言聊赠别，二妙送将归。\n立马然萁敏，争锋啮镞机。\n日将秋共晚，人与雁俱飞。\n去住加餐饭，新霜点客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次师川韵 其一","author":"洪刍","text":"与君城北寺，取次对床眠。\n坐即棋中隐，时逃醉里禅。\n相招从白社，不拟问青天。\n但有加餐饭，无田亦愿年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次师川韵 其二","author":"洪刍","text":"卧疴非傲世，背俗信畸人。\n无复少年事，偶随肥马尘。\n静便门扫轨，懒任草如茵。\n迹滞江山胜，心将鱼鸟亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次瑛上人怀汪彦章韵","author":"洪刍","text":"君虽四禅侣，自是一诗家。\n白足濯蛟井，清风振龙沙。\n虚室无长物，多文富生涯。\n怀人有新作，粲粲菖蒲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵师川题余荀龙壁间三首 其一","author":"洪刍","text":"青镜磨秋水，红衣退藕花。\n朅来寻五柳，端欲问三车。\n浊酒休论限，浮生定有涯。\n比封千户竹，鼓吹一湖蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵师川题余荀龙壁间三首 其二","author":"洪刍","text":"高文肠是锦，妙句笔生花。\n松菊开三径，诗书载五车。\n曲湖邻贺监，复壁笑王涯。\n海若应怜我，贻书问井蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵师川题余荀龙壁间三首 其三","author":"洪刍","text":"我来占食指，客至卜灯花。\n但祝加餐饭，何劳问颊车。\n交情真莫逆，秋兴浩无涯。\n姑置人间事，纷纷祇斗蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨诗","author":"洪刍","text":"日日望南山，朝隮解我颜。\n云垂四天外，雨洒一林间。\n枯沼微澜动，旱苗生意还。\n慇勤祝屏翳，莫为远人悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次师川韵喜雨呈彦章 其一","author":"洪刍","text":"绿塘深涨雨，红芰静舒花。\n卧上三竿日，晴喧两部蛙。\n老饕犹善饭，水厄怯逢茶。\n拟到新池畔，来寻谢客家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次师川韵喜雨呈彦章 其二","author":"洪刍","text":"登高能共赋，好雨故催诗。\n阶草卧青软，畦苗垂绿滋。\n夏深飞燕静，秋近候虫知。\n寄语耽吟客，可无新句为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和彦章池上之作二首 其一","author":"洪刍","text":"官闲发兴清，水远觉空明。\n玉局思无限，青蘋风自生。\n鱼荷翻暮色，蝉树带秋声。\n云黑斜阳外，遥知雨又晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和彦章池上之作二首 其二","author":"洪刍","text":"水槛凉秋好，风林初日明。\n屏间青嶂合，镜里白云生。\n茶试旗枪色，蛙添鼓吹声。\n瘦筇聊复倚，绕水步新晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题双林寺","author":"洪刍","text":"幽谷双林寺，荒郊得远寻。\n银钩遗墨在，笔谏慕贤深。\n徙倚千山晚，坐愁三日霖。\n枯棋围白黑，聊复费光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潘延之挽词","author":"洪刍","text":"肥遁攀巢许，幽光烛斗牛。\n长公辞汉世，孺子隐南州。\n闭户荒三径，紬书综九流。\n欲寻高士传，端向古人求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和元礼","author":"洪刍","text":"湖海沙鸥性，山林雾豹文。\n龙蛇争起陆，羔雁看成群。\n玉石无缁磷，芝兰自苾芬。\n韩康不二价，女子会知君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"容膝轩","author":"洪刍","text":"乌隼经行处，蜗牛窈窕深。\n会稽虽奉计，彭泽自无心。\n禅寄跏趺坐，风披徙倚襟。\n莫言容膝地，不废掉头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张元干","author":"洪刍","text":"自昔张平子，愁来赋四愁。\n行看车马客，坐觉岁时流。\n明月江山夜，候虫天地秋。\n怪君有底急，不肯少迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲偷儿","author":"洪刍","text":"长卿惟有壁，囊橐自无钱。\n金尽何劳攫，墉疏岂待穿。\n未能抛鼎禄，犹复恋青毡。\n梁上休惊坠，饥寒亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书怀","author":"洪刍","text":"北阙书休上，南窗膝易安。\n道肥知战胜，归约已盟寒。\n委吏无麟笔，迂儒置虱官。\n所须升斗水，肯沃鲋鱼乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和师川同集章江寺二首 其一","author":"洪刍","text":"鹿苑江南寺，龙沙城北游。\n脩椽云自宿，返照雨还收。\n禅麈寻支遁，棋枰对弈秋。\n还家真复乐，何必远封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和师川同集章江寺二首 其二","author":"洪刍","text":"兴发寻荒径，途穷见宝坊。\n随宜聊复饱，触处得追凉。\n取友真濠上，怀人向渭阳。\n不嫌茶七碗，殊胜酒千觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口占赠何秀才","author":"洪刍","text":"何郎闽越英，畴昔昧平生。\n邂逅同衾宿，夷犹共舸行。\n繁台半床梦，颍水一篙清。\n俄顷胶投漆，难忘此日情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李商老赠李少魏","author":"洪刍","text":"诛茅迟竹君，拂匣见桐孙。\n囊箧深倾倒，钟彝细讨论。\n只今仙李后，好事阿髯存。\n不厌敲门客，时开炙背轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题泐潭院","author":"洪刍","text":"平生麋鹿性，名山恣幽寻。\n历尽岩壑奥，始闻钟梵音。\n中多不凋木，上有自呼禽。\n许税俗士驾，兹焉聊洗心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游泐潭院用前韵","author":"洪刍","text":"石门久寒盟，兹游得重寻。\n静契祖师妙，清闻山水音。\n长闲羡老衲，幽思愧鸣禽。\n可怕移文劾，沙鸥知我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈使君咏霰雪三首 其一","author":"洪刍","text":"天幕垂云合，山屏拥雪飞。\n杨公田种玉，渊客泪成玑。\n点缀添梅萼，飘零乱羽衣。\n清溪横一叶，并载月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈使君咏霰雪三首 其二","author":"洪刍","text":"萧洒宣城守，挥毫雪共飞。\n山川映重璧，咳唾斗明玑。\n佳气笼寒谷，欢声抵袭衣。\n霜台如不践，粉省定须归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈使君咏霰雪三首 其三","author":"洪刍","text":"敷床初屑屑，入夜故飞飞。\n拭处浑抛粉，揉来乱掷玑。\n银蟾分玉照，云絮借天衣。\n地席横陈处，晨曦未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和郭功甫题客馆韵","author":"洪刍","text":"容膝柴门觉易安，数椽喜枕寺东山。\n雁飞不到吾来此，燕亦知归客未还。\n梦断霜钟年欲晏，愁听蛮鼓鬓先班。\n自公退食门长掩，未必邻僧似我闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]