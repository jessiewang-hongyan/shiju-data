[{"title":"以道次韵因再和二首 其一","author":"张镃","text":"秋林何翅一般香，楚思无穷属野航。\n不必再参庞老语，要须先会接舆狂。\n青灯渐向韦编熟，白露初添玉井凉。\n久矣荡除人我相，莫疑高尚鄙侯王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尤丈京丈和篇踏至四用前韵为谢","author":"张镃","text":"江南从识桂花林，岁岁逢秋属意深。\n夜气未添承露掌，晓光先上辟寒金。\n玉笙殿迥应留月，铁杵岩高不用砧。\n争似吾家种流水，拥香亭榭绿沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙花","author":"张镃","text":"鲤鱼程阔海茫茫，照眼琼标十二行。\n矾弟梅兄同旧隐，风姨月姊特新妆。\n湘滨人远难闻瑟，洛浦才高最断肠。\n何似香严真实处，鼻端无窍著猜量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长至前夕书寄陆严州","author":"张镃","text":"铜炉熟火暖无烟，一盏清灯纸帐边。\n迟睡颇如除夜景，新阳方幸好晴天。\n诗成水阁梅堪折，信断山城雁不传。\n莫待扁舟叙暌隔，归来身作紫微仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代书回寄杨伯虎","author":"张镃","text":"僧舍匆匆别，飞花雨过春。\n水村居自乐，城市懒尤真。\n载酒青油舫，传书白锦鳞。\n访君须及早，非是久閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"写村舍壁","author":"张镃","text":"路转溪隅草色苍，烟霏云屋带渔乡。\n鸡头叶老陂塘暗，狗脊花繁篱落香。\n景物向人须品藻，太平无地不耕桑。\n何时秋入丰年社，持蟹来听压酒床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日","author":"张镃","text":"半空飞雨整还斜，翳日游云散复遮。\n七字吟情书柿叶，一年心事约梅花。\n关门人识陶潜室，静坐自疑庞蕴家。\n纸帐蒲龛方用事，更须何物作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至日晓雪庭桂一枝著花戏成长句","author":"张镃","text":"居士归来百事嘉，木樨雪里也开花。\n麸金一掬枝头小，药玉千沟屋上斜。\n境界许奇非浪得，色香俱静更何加。\n高寒似我休拈出，微笑从来少作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后五日约客晨往极乐精舍因寻梅湖山作诗纪事 其二","author":"张镃","text":"未苦撩清兴，骑驴故绕山。\n松篁高下处，云日往来间。\n要是从今后，休教枉却閒。\n乌巾风弄影，画出我诗孱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至后五日约客晨往极乐精舍因寻梅湖山作诗纪事 其一","author":"张镃","text":"烟重山弥远，林高日倍鲜。\n抱鸡趋野店，?水入冰田。\n未有三冬雪，浑如二月天。\n梅花应早慧，著眼竹篱前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出馀杭县","author":"张镃","text":"暑剧中宵枕屡移，夙兴犹得趁凉时。\n平冲露气篮舆稳，遥杂星芒筱炬随。\n触景有诗聊记述，为人无术漫驱驰。\n须臾假寐谁惊觉，隔岸清风叫子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出寂照行至书馆","author":"张镃","text":"茅屋鸡声过日中，热云蒸雨转无风。\n形劳自背当年说，句快全誇近日工。\n破院未成投宿计，枯田犹觊入秋丰。\n情知必没扬雄宅，看竹何妨揖主翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出德清县","author":"张镃","text":"天公有意作诗颠，入得苕溪未见莲。\n先放水荭围半里，更将芦叶界平川。\n明金扇日停苍渚，碧玉环山吐白烟。\n非是老夫来领略，此中那有地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山早兴","author":"张镃","text":"出郭凉舆稳，山晨气自浓。\n寺园逢水断，塔路过烟重。\n啄木声穿竹，凌霄色映松。\n世欢吾傥泥，那遂此从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圣井亭","author":"张镃","text":"重到虚亭意豁然，望高容易觉秋天。\n山连旷野全无水，树杂轻烟间有田。\n极目几时忘去路，西风何日送归船。\n残蝉更唤斜阳好，衬出金刚翠筱边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月","author":"张镃","text":"景奇天遣助诗豪，意快惭无鍊句劳。\n一夜月晖金盌出，万波风摆玉鳞高。\n衣冠城里多新贵，酒脯船中自老饕。\n未著丛书追笠泽，此行扶路且游遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平望遇风","author":"张镃","text":"平望陂湖一望平，当年地志岂虚名。\n微茫远树山同出，破碎层云日斗明。\n更著百千寒雁叫，偏宜三四旅帆征。\n疏帘揭起从风入，要洗频年郁滞情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归南湖喜成","author":"张镃","text":"路转斜桥似梦醒，拥衾摇兀亦身轻。\n知期岸鹊如相语，匿笑邻翁欲斗迎。\n见处青山还委么，遮回居士太呆生。\n矮篱半路寒毬树，新种浑如旧种成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月八日喜霁","author":"张镃","text":"未春天气已佳晴，病起光风满意明。\n竹色舞帘金翠活，鸟声穿户角宫成。\n黄麻天上登周召，浊酒林间慕绮荣。\n从此寻芳绕阡陌，野翁相遇诧时平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月三日同诸亲从叔祖阁学登宁寿观东西山寻至邻园次叔祖韵","author":"张镃","text":"超旷欣便静，纷哗厌处浓。\n客亲非外约，地胜适新逢。\n诗兴骖黄鹤，仙情寄赤松。\n烟平千万户，此处认歌钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永嘉张仲思相士过访坐间索诗","author":"张镃","text":"便静非形色，相逢子独知。\n功名槐蚁话，文字壁鱼痴。\n剩取朝贤誉，何须隐者诗。\n南湖鸥正狎，休误凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二首 其二","author":"张镃","text":"未办当春句法工，坐来花下泥春风。\n山高水远须人领，玉洁珠光喜日烘。\n越女信知天下白，屈平那是泽边穷。\n明朝风雨从教有，老眼今年已不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉照堂观梅二首 其一","author":"张镃","text":"绝怜一见一番新，短直长斜意总真。\n绕屋便能云态度，问春谁更雪精神。\n栽花十亩犹嫌少，与我多生定是亲。\n为惜生香怕閒却，折归聊当散花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日访梅裴氏园","author":"张镃","text":"下马东风恰到来，午烟沙际日烘开。\n长松寂历寒声少，远柳葱茏绿意回。\n零落欢游逢故地，夤缘幽胜逐深杯。\n湖边不使侬先咏，枉却今年处士梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买书","author":"张镃","text":"自笑从来癖，诗书满屋藏。\n不充饥鼠喙，即饱蠹鱼肠。\n插架牙签整，开编竹简香。\n他年林下去，谁与记山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏日","author":"张镃","text":"未晓雨先骤，过朝风更鲜。\n谁知初伏日，全是早秋天。\n洗盏尝新酒，临池摘嫩莲。\n平生丘壑意，不受暑寒迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游 其一","author":"张镃","text":"晓日晴岗路未分，昔年钟磬隔林闻。\n龙归古洞千岩雨，人卧空山半榻云。\n异草灵苗交晚翠，野兰芳芷杂秋芬。\n何时得似山中鹤，脱却鸡群友鹿群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘子履少卿挽辞二首 其二","author":"张镃","text":"释和书上巳经年，敌骑南来果犯边。\n太息龟灵成底事，漫闻鸿宝得家传。\n平生喜踏天山雪，晚岁愁看瘴浦烟。\n务实褒称曾未泯，不须凝恨入重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘子履少卿挽辞二首 其一","author":"张镃","text":"气盖两峰蚤食牛，堂堂声誉冠诸刘。\n直言不愧上方剑，妙句常轻万户侯。\n仙药了无金鼎效，梦魂空绕玉关秋。\n当时若假三千骑，岂但区区活泰州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"名新酿曰白鸥波以一尊送佑圣观刘高士","author":"张镃","text":"酒熟将何字，白鸥波正如。\n一瓢谁合饮，高士观中居。\n汗漫涵无象，鸿濛洽太初。\n醒来松户晓，应念臭于帑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回渡荷叶浦","author":"张镃","text":"宿雨惊眠变早凉，喜成风便放归航。\n山云野树水墨暗，芦叶荷花文绣香。\n藉枕冰藤醒倦思，打帘珠浪发清狂。\n天围平浦方宜眼，便腹飞帆莫太忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因过田倅坐间得姜尧章所赠诗卷以七字为报","author":"张镃","text":"京廛舆马竞扬埃，何碍骚人独往回。\n我住水边奚自识，诗如云外寄将来。\n一从风袖携归看，屡向松亭静展开。\n应是冰清逢玉润，只因佳句不因媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因过张郎中识孙才翁教授时徐衡仲亦在坐成四韵送呈","author":"张镃","text":"邂逅如相约，新交会旧知。\n轩窗浑未暑，宾主总能诗。\n小草浮冰楮，初篁映锦葵。\n星郎风韵杀，我辈盍幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"守岁","author":"张镃","text":"寒缸孤照听更迟，情绪斟量睡却宜。\n春向岁前三日到，老缘头上二毛知。\n朱泥逐疫烧灵药，桃板书符换旧诗。\n但愿明年更閒散，无灾无难复何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安乐泉亭上午憩","author":"张镃","text":"脩竹有风处，道人无事时。\n诸公难入眼，不用总如眉。\n得价婆娑重，投閒懒散宜。\n三年何足道，坚判百年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安溪山间寻桂得之","author":"张镃","text":"心期经岁只秋芳，况有溪山近好凉。\n天宇荡开暄浊意，岩花催就泬寥香。\n招寻拟把深枝折，爱护休令背蕊伤。\n三五冰轮行散影，仙凡同异要平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安溪晚泊因到无净院","author":"张镃","text":"十丈亭桥稳踔溪，斜阳红滟入船低。\n枯筇径过荒街北，静院深寻破庙西。\n游伴苦无成独笑，物情谙遍任难齐。\n归时早是星烦出，影漾波痕上下迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏呈郑去华县丞","author":"张镃","text":"叠破当年御赐袍，饱看人钓六灵鳌。\n行藏虽似少中节，识趣不妨依旧高。\n入梦傅岩初岂意，上书曼倩本徒劳。\n浮生万事天都了，爱惜君才祝善刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题","author":"张镃","text":"人前一语撞翻墙，直气西秦本故乡。\n雪野射麋轻队马，杏园移象矮交床。\n诗忙渴砚酒磨墨，睡足趄廊花夺香。\n矫揉尽归官样去，有时閒笑错商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题故袍","author":"张镃","text":"垂髫便衣绿荷衣，两见龙飞圣主时。\n举世恩荣俱合换，唯吾忧患只该披。\n收藏尽好随腰带，提掇应堪傲鬓丝。\n试使著来门外立，精神犹胜似钟馗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早饭庵中次张以道韵","author":"张镃","text":"岂是幽人眼，从来可惯山。\n有时才得见，觅句不曾閒。\n野日光尤暖，溪梅信尚悭。\n饭馀行便去，休待暮云还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲廊","author":"张镃","text":"曲廊桐树绿阴阴，檐佩风来奏玉琴。\n但有疏帘知独立，更无尘事恼閒心。\n雪霜鬓畔谁能免，城府胸中枉自深。\n二六时辰真快乐，坐禅才罢即行吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀参政范公因书桂隐近事奉寄二首 其二","author":"张镃","text":"迂疏那可作治中，閒事归来却不慵。\n晓炷佛香聊作观，晚投社饮亦称侬。\n荷衣制就身宜著，菰米收成手自舂。\n最是今春多伟绩，万丛兰四百株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀参政范公因书桂隐近事奉寄二首 其一","author":"张镃","text":"石湖仙伯住吴门，事业文章两足尊。\n南北东西曾遍历，焉哉乎也敢轻论。\n桂园柳色金丝织，笠泽桃花锦浪翻。\n小大风烟俱自适，鹪巢终莫拟云鲲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂兴三十九首 其十七","author":"张镃","text":"圣道由书传，秉畀火于秦。\n汉兴反秦暴，见儒犹骂嗔。\n董子惟有志，耿耿谁与陈。\n使时三策行，焉老诸侯宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次以道荷叶浦","author":"张镃","text":"向来曾爱叶田田，落日荷花拥棹前。\n霜冷不移鱼世界，苇残聊作雁家缘。\n诗狂顷刻成三首，懒病中间接四边。\n除此今朝无别事，与君相就乐?船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张以道韵","author":"张镃","text":"无愁便是乐无涯，看破纷纷眼里花。\n旋洗杯盂将酒试，重糊窗户把风遮。\n丹房火鼎频添水，衣匮香炉就焙茶。\n判却一生閒理会，共君难数第三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次夜月色复佳游霞川锦池二首 其二","author":"张镃","text":"画桥烟重柳垂垂，露湿衣裳透始知。\n丹桂花香墙畔起，水荭枝影席间移。\n思量究竟都如梦，恋著休閒煞不痴。\n夜半江潮声正熟，归来才是欲眠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次夜月色复佳游霞川锦池二首 其一","author":"张镃","text":"倚栏看月兴难平，载酒还须入涧行。\n竹顶有时翻鹊翅，草根随处闹虫声。\n城中岂是无人赏，船里何曾卧地撑。\n游遍一池心未足，乱荷丛底听三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次武子韵","author":"张镃","text":"宇内张夫子，诗如孟浩然。\n安心从太末，借屋近平泉。\n眼里弹冠手，生来种芋田。\n相投忽离席，佳月恋?船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王耘之","author":"张镃","text":"白汗翻浆九市人，清风谁似此论心。\n壮游淮上官声起，重会都城句法深。\n久矣求才胶柱瑟，老来逢事不徽琴。\n漫湖又见香荷发，煮饼须同近寺林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王耘之秋兴二首 其二","author":"张镃","text":"多士宁王室，中宸梦傅岩。\n如何两京客，犹挂五湖帆。\n落落云松节，飘飘霜叶杉。\n深藏草檄手，端欲取殽函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王耘之秋兴二首 其一","author":"张镃","text":"妙墨真连草，清辞角应商。\n襟期容汗漫，兴致入苍茫。\n派自王摩诘，才分马子长。\n宦途休叹滞，眉宇见新黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵杨廷秀左司见赠","author":"张镃","text":"愿得诚斋句，铭心秪旧尝。\n一朝三昧手，五字百般香。\n弦绝今何苦，衣传拟自强。\n草玄非近效，举世漫匆忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陈秀才","author":"张镃","text":"规模浑是野人居，剪结苍松荫屋除。\n閒把欹眠酬懒架，静便徐步当安舆。\n青精饭好终延老，紫石潭空总付渠。\n玩世从来畏人觉，他年方信此心初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叔祖阁学秋兴","author":"张镃","text":"岁序推流感世浮，乐閒宜早向农畴。\n修梧绿减俄过夏，短发丝添剩得秋。\n千古是非归啸傲，一门酬唱胜交游。\n祗因名句多难数，常笑区区赵倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叔祖阁学题逸村亭壁","author":"张镃","text":"桥迥有牛过，村深无马嘶。\n哨风惊客袂，膏雨慰耕犁。\n游目花通野，吟情絮著泥。\n幽坊惬虚眺，况复见新题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周昭礼见寄兼约观园梅","author":"张镃","text":"沙头晴了便回春，巳觉青蘋媚煖津。\n但课浇畦园内叟，何心说剑里中人。\n超情耐久宁拘远，合处无多颇复伸。\n待得梅开醉香海，健呼重看老精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉酬张野夫见赠","author":"张镃","text":"谋身堪笑若舂锄，甓社栖寒水满湖。\n近寺偶成莲社似，为园非效辋川图。\n清樽酒好诗中圣，古冢珠存念大儒。\n久矣自求无所用，喜君能好柏楸株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵罗端规二首 其二","author":"张镃","text":"雪窗吾畏友，称誉满中边。\n往矣非乔木，生乎仗老天。\n肯来丹桂里，须醉白鸥前。\n百计安流好，纷纷急水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵罗端规二首 其一","author":"张镃","text":"世态从渠变，前山只么新。\n关门便懒退，遇事少躬亲。\n和我诗何益，知公道不贫。\n两旬才识面，枉是自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵寄斋赠竹居","author":"张镃","text":"振俗还风雅，乾坤觅句中。\n夔皋渠合遇，郊岛我甘同。\n浩荡投鸥水，清和翻燕风。\n相投两无语，声远莫摩空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答曾司法","author":"张镃","text":"精神由日就，格律忌雷同。\n我匪从它入，君应自此工。\n多岐怜世路，力学振家风。\n莫易朱弦绝，千年论最公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答潘茂洪桂花见怀","author":"张镃","text":"藉使音书少，何妨好尚通。\n看花虽各自，觅句却相同。\n嚼蕊晨烟里，搴枝夜月中。\n亦曾湖上坐，香底水精宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬张仲思高邮见寄二首 其二","author":"张镃","text":"便欲相寻去，山光看水光。\n野航因挟策，春韭自炊粱。\n踽踽吾才短，翩翩子意长。\n文翁他日誉，不但劝农桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]