[{"title":"青云峰","author":"李义山","text":"瀛洲拟岘屡凭栏，不得江山四面看。\n欲识青云奇绝处，碧天无际裹峰峦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白龙寺","author":"靳更生","text":"不怯山寒风力尖，要登绝顶看龙潜。\n翚飞杰阁云穿栋，静镇禅关月满帘。\n踏破松萝容极目，啸惊岩壑快轩髯。\n我来默印无边义，寄与孤铃语夜檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李咸谷歌","author":"黄师参","text":"李咸谷，真诗人，无枝可栖云水身。\n去年县官为架屋，才有数枝堪寄宿。\n朝厨无烟眠正高，痴儿叫怒吟转豪。\n人间六月尽絺服，独著春衫凉自足。\n黄鸡白酒东家留，西家欲留还住休。\n凿池养鱼未盈掌，有客过门须举网。\n网收鱼尽镜奁空，菜羹作供尤春风。\n谷之山，窈复深，谁其友之紫芝民。\n谷之水，清且泚，谁其似之巢父耳。\n再拜号君咸谷子，白头结交从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过庐陵","author":"黄师参","text":"昔年楼迹处，今访不知门。\n华屋半尘土，故人馀子孙。\n少留谁共语，欲去转销魂。\n落日江楼望，江山空复存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏怀","author":"黄师参","text":"南国有佳人，不数阴丽华。\n长年事絺葛，无语吟柳花。\n平生父母心，岂不愿有家。\n纷纷轻薄儿，媒氏空自哗。\n失身死堪羞，失时未须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小楼即事","author":"黄师参","text":"病起懒拈酒盏，衣单顿怯春寒。\n独把东坡诗卷，立残西日阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉岩有感","author":"黄师参","text":"游山苦无侣，独行亦自佳。\n不羡篮舆稳，软草供蒲鞋。\n小僧倚门问，客从何处来。\n长啸不复答，露坐面山隈。\n往谒玉岩翁，缟衣绝纤埃。\n祠宫蔽风雨，碑碣荒莓苔。\n四山壮幽閒，百感撄我怀。\n先生竟何之，山猿朝夕哀。\n出处非有意，于道相萦回。\n翁看岭表人，白骨漫成堆。\n所见明且哲，屡表乞归骸。\n伫立三太息，归思落日催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坡南塘","author":"黄汉章","text":"吁嗟从古行路难，长亭短日天风寒。\n舟胶马隤忧欲死，朱门歌舞谁办此。\n一朝邂逅荥阳君，首倡开土囊俱倾。\n五丁未具饭能几，群毛不集裘安成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倒插花岩","author":"黄汉章","text":"怪石胆瓶窟，从天倒插花。\n九阳一样泽，生意为何差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"照胆台","author":"叶味道","text":"一水磨铜镜面寒，人心蔽锢可谁观。\n诸君顾影清潭里，私曲分明见肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清溪晓行","author":"秦噩","text":"瀰瀰一溪水，滔滔终古清。\n晃漾吸初日，风静波不生。\n冲烟出孤棹，微闻欸乃声。\n寄言彼渔父，吾欲濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"憩南台寺","author":"刘子澄","text":"居尘等出家，涉世类行脚。\n岳灵招我隐，雨止云亦阁。\n乾坤锦囊收，风月麈柄握。\n众鸟各自鸣，岂碍冲霄鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙泉行呈张敬父","author":"刘子澄","text":"玉龙蟠向荆山麓，喷起双泉冰雪瀑。\n琮琤万古作寒鸣，冷浸一山浑是玉。\n泉旁树老亦如龙，泉根石濯玛瑙红。\n更有金莲吐泉底，历历星在银潢中。\n池光六月如霜洗，蓝桥倒影壶天里。\n流下人间灌稻畦，岁岁家家饭云子。\n我行荆州见山少，忽对林泉如久要。\n张侯引我飞羽觞，劝我为泉开一笑。\n我歌数语泉应闻，兹山古号荆州门。\n英雄过者心在鹿，安得泉声到耳根。\n曹瞒疾驰玄德惧，潘璋设伏云长怒。\n早知成败等丘墟，悔不解鞍学巢父。\n英雄何在水长流，阅尽英雄过未休。\n今日为侯泉上醉，明朝西指鹿门游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枞阳出陆","author":"刘子澄","text":"浮家无定日，仕在水云乡。\n棹别洞庭月，帆迎赤壁霜。\n早寒裘代葛，多病药充粮。\n明日枞阳客，征鞍去路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鸿宿洲","author":"刘子澄","text":"洲名号鸿宿，流徙合来居。\n淮郡侵江密，人烟罩水疏。\n无山供笛竹，有港便罾鱼。\n壮士休营业，功成返故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游石门县层山流杯亭观卓锡泉","author":"刘子澄","text":"寺惟泉最古，有咏载州图。\n几度流觞了，长如卓锡初。\n楚山闽老住，隋柏宋朝枯。\n雨后人耕急，荒冈带月锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"董宰见和用韵留别","author":"刘子澄","text":"谩辱君相送，我行非壮图。\n客程来又去，人事久如初。\n句淡僧能和，泉灵旱不枯。\n升高莫怨险，世路尔能锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武陵别任年魁","author":"刘子澄","text":"诏书应在道，君但趣行装。\n去棹乘桃涨，朝衣带芷香。\n归斋寻旧话，上殿拜新皇。\n论事依经好，平迁是玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿星寺江湖伟观","author":"刘子澄","text":"岂不近京都，红尘此地无。\n吴山青似越，江水白于湖。\n天接帆边海，烟生树外晡。\n危栏僧共倚，莫恨旅怀孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会真观水帘","author":"刘子澄","text":"观近朱陵萃列真，烟霞虽僻境长春。\n若非火府炼神处，安用水帘遮世尘。\n古像著灵多是石，补钟留迹似非人。\n寻源亦有桃花涧，莫是山山可避秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"厉漕饮别海棠下索诗 其一","author":"刘子澄","text":"天然翠袖隐丰肌，好是胭脂未透时。\n夜睡无香供蝶梦，晨妆有恨只莺知。\n坡仙具眼犹烧烛，子美多情却欠诗。\n料得锦城花正好，怨公底事访春迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"厉漕饮别海棠下索诗 其二","author":"刘子澄","text":"著雨胭脂沁玉肌，绝疑妃子醉眠时。\n未邀佳客閒来赏，已怪游蜂早得知。\n烧烛不妨循故事，卷纱何惜赋新诗。\n羡君立就花前句，我欲赓吟思苦迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云峰寺诗","author":"刘子澄","text":"治水神书在此祁，溪名犹似念胼胝。\n当时民垫赖谁力，今日地平惟佛祠。\n泉出玉床疏作乳，火生丹窖结成芝。\n云峰自有樵人径，岣嵝寻碑误退之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游岳麓宫抱黄洞","author":"刘子澄","text":"连天七十二云屏，真境先于翠麓呈。\n洞发金光丹气结，泉疏乳白玉华生。\n江心雁影重临字，谷口禽呼自答名。\n閒步不教方外觉，破烟双鹤已来迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云中寺","author":"刘子澄","text":"地僻层云岿古禅，我来访古尚依然。\n越人重见流觞水，隋刹犹存卓锡泉。\n石罅遗题思往迹，岩隈纪事忆前贤。\n可人不为时摩拂，朝暮青山一抹烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登祝融宿上封寺诗","author":"刘子澄","text":"祝融尊与岱宗齐，仙境今容佛屋依。\n晓揖日轮知海窄，夜扪星轸觉天低。\n风高殿悉杉为瓦，云冷僧常绵作衣。\n莫剪光天坛下草，时巡要秣六龙嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江陵逢黄虚舟","author":"刘子澄","text":"山谷机忘似白鸥，有孙今复号虚舟。\n信风为棹先开浪，与月同舱不载愁。\n吟就自将歌欸乃，醉时宁逐境漂流。\n乾坤等是虚舟尔，只好和诗莫带休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张功曹清明之什","author":"刘子澄","text":"兰江无物可关情，春去春来感亦生。\n流水几番供禊事，新烟两度过清明。\n念乡鹃泪和花滴，怀友莺肠学柳萦。\n读遍离骚诗自慰，世间无地不蛮荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和贾秋壑南楼韵","author":"刘子澄","text":"大别矶头江汉合，烟波堪咏亦堪图。\n山标禹贡他州有，水列周南到处无。\n鹤外声来蕲笛远，鸿边影落楚帆孤。\n登临此地陪秋壑，收拾乾坤寘玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过金陵总卿吴履斋以诗赠别用谢","author":"刘子澄","text":"六朝三百有馀期，不满诗人一皱眉。\n只有燕迷新巷陌，更无凤集古台基。\n兵于史传多陈迹，酒与江山是己知。\n仆指长淮又西去，舆图向后更谁披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭赵南仲","author":"刘子澄","text":"功名翻覆等南柯，云掩新阡长薜萝。\n千载只凭公论去，百年无奈世情何。\n高光时节经营易，晋宋人才隐逸多。\n入汴老宾犹坐谪，馀生只合理烟蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过洞庭","author":"刘子澄","text":"波神有兆报平安，半日重湖度不难。\n只艇溯洄风浪息，单包就谪水云宽。\n晓烟不隔渔歌过，秋月还同画轴看。\n摆脱尘缘天借便，嶷云深处养神丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"会饮西湖闻黄浦捷用余制干韵","author":"刘子澄","text":"湖边重度夏，风物恍如初。\n竹喜儿孙密，花怜姊妹疏。\n小舟逢寺泊，淡句欠僧书。\n此乐何从得，淮堧报贼除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其一","author":"刘子澄","text":"主辱兮忘家，国安兮亲宁。\n奈何有躯兮而焉自形，宁陨绝兮无生。\n望苍穹兮痛彻，君精诚兮为列星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其二","author":"刘子澄","text":"蕙肴兮椒浆，历芳芜兮荐君堂。\n君不来兮予愁，渺贝宫兮谁留。\n高丘之人兮为君妒，聊澧浦兮消遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其三","author":"刘子澄","text":"熠耀兮高明，读经兮漱芳。\n仕不辰兮经以不信，蹇道直兮难行。\n人心险兮剑戟，公归来兮故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其四","author":"刘子澄","text":"阴凝阳兮血涂野，臣力微兮肝胆怒。\n睨阶庭兮激诸子，往间道兮戴盟主。\n陈志诚兮冠期举，事危就兮天弗假。\n天高兮苍苍，君柰何兮归来双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其五","author":"刘子澄","text":"兰之江兮有洲，环堵兮兰幽。\n胡独微兮台阁，留不归兮焉求。\n咏歌兮卒岁，名与兮江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其六","author":"刘子澄","text":"酌水兮澧清，酹月兮洞庭。\n公读书兮湖上堂，波涛卷兮胸中甲兵。\n浩然兮长在，烟水兮茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澧州群贤堂记并歌 其七","author":"刘子澄","text":"鹤书贲兮林丘，假截径兮予羞。\n曳杖兮长歌，清风宾兮明月友。\n云山兮未改，羌何日兮公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游层岩","author":"刘子澄","text":"一层云结一层巅，贯腹成溪异物潜。\n仙乐万悬钟有乳，洞门百折水为帘。\n崖碑藓暗瑰辞缺，石栈苔阑羽卫严。\n我欲通天刳绝顶，倒飞明月浴寒蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读书台","author":"刘子澄","text":"安乡古下邑，公偶混迹居。\n编茅阅古今，清澄涔澧潴。\n波涛入胸中，万甲时卷舒。\n坐吞八九泽，去作宋真儒。\n西师出绪馀，胆已寒毡庐。\n军中但歌范，谁识旧陶朱。\n大贤方穷时，隐忧在江湖。\n功成等糟粕，况复堂上书。\n我来拜遗像，悲风生黄垆。\n公今倘无死，此地正堪娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"刘子澄","text":"世间此物多为马，宝剑还宜出上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"刘子澄","text":"自怪神仙骑白凤，不教天地点青蝇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳祐七年丁未十一月朔蔡久轩自江东提刑归抵家时三馆诸公以风霜随气节河汉下文章分韵赋诗送别得节字","author":"陈协","text":"贾生陈治安，难与绛灌列。\n汲黯触公卿，不得补遗阙。\n直道非身谋，古今同一辙。\n吾观蔡子贤，木讷有志节。\n道山得良友，同舍颜色悦。\n家学传考亭，议论接贤哲。\n尘污具瞻地，两疏愤激切。\n当宁垂宽容，在庭竞称说。\n屡章丐投闲，一节往司臬。\n狱情贵平反，人物宜区别。\n要令大江东，精彩与昔别。\n君诚给谏姿，上恩讵轻绝。\n即当宣室对，忠言合稷契。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清都台","author":"曾镐","text":"兀坐岂不佳，偶出亦良适。\n高台挹清旷，况此好风日。\n俯怜波面净，仰爱松身直。\n洒落万古秋，飞鸟度晴碧。\n徘徊足瞻眺，萧散谢羁絷。\n浮生眇尘端，一醉不易得。\n古人岂其远，千载犹宿昔。\n清风何寥寥，愧此台上石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赏心亭","author":"王野","text":"物华尽入锦囊收，留与江山做话头。\n桃叶数声风力晚，芦花万顷月波秋。\n非寻鹤相当年画，谁记坡仙旧日游。\n回首兴亡多少事，渔舟独不挂闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微亭","author":"王野","text":"虚亭北眺大江临，江外晴岚出寸岑。\n景与齐山俱绝唱，量如沧海且频斟。\n地高宇宙双眸豁，人老风霜两鬓侵。\n感慨石城勋业旧，侃居夏口峤居深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题凝神庵","author":"王野","text":"抛却林泉趣，卓庵临近村。\n两窗吞日月，一室养乾坤。\n菊露秋篱重，松风午枕喧。\n蒲团数胎息，不肯学傍门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登灵鹫兴圣寺","author":"王野","text":"山从西域来，寺自东南有。\n林泉既奇秀，岩穴更深黝。\n世僧奋空弮，经始不已久。\n俄然幻杰阁，丹碧照林薮。\n相辉灵隐前，更胜天竺后。\n理公坐崖屋，千岁骨已朽。\n坡翁昔曾游，遗句今在否。\n洞猿不待呼，清昼时一吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨柳","author":"王野","text":"雨重垂杨绿未乾，一渠流碧弄潺潺。\n暝鸦过尽东风恶，独倚衡门看远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日游鹤林寺 其一","author":"王野","text":"蒿目黄尘扰扰间，出门偶到鹤林山。\n仙花僧竹俱陈迹，白日青天祇自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日游鹤林寺 其二","author":"王野","text":"竹院闲来春正迟，箨龙犹自有孙枝。\n野夫岂识寻芳意，为爱光风面面吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵章泉","author":"王野","text":"冷笑申公老汉班，不成一事又空还。\n与其零雨难苏物，孰若为云只在山。\n庭草静涵春意足，野瓢休挂树阴闲。\n多应粪土看荣贵，留得清风宇宙间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿千亿","author":"王野","text":"三十六洞天下奇，三十六峰名武夷。\n武夷山中溪九曲，曲曲泻出清涟漪。\n溪南溪北山对立，拔地插天几千尺。\n或如丹砂丹，或如碧玉碧。\n东望开楼台，南顾俨城壁。\n廪庾积其西，车盖列其北。\n磊磊落落不可名，怪怪奇奇神所刻。\n草木不移寒暑心，岩峦长带烟霞色。\n太玄姥，武夷君，幔亭虹桥凌紫云。\n曾孙宴罢桑海变，长琴短鼓空纷纷。\n魏公子，张真人，嗜酒一谪八百春。\n功成白日生羽翼，巅崖灵蜕犹如新。\n我欲冥搜极幽远，棹船朝去暮忘返。\n峰回嶂合忽复迷，安得飞梯宿云巘。\n鸾鹤去兮猿猱啼，恍空中兮闻金鸡。\n石啮足兮溅溅，风吹衣兮凄凄，洄洑萦折。\n谽谺崔嵬，石堂真馆豁然而中开。\n壑舟不坠栈不朽，至今药炉丹鼎髣髴千仞之层崖。\n目亦不能尽，心亦不能恻。\n桃源风景未复见，柯山日月难重得。\n鼓余枻兮潺湲，乘惊波兮下前滩。\n瞬息兮回首，失向来兮巑岏。\n呜呼，列仙高拱兮宅玄都，二圣继御兮恢炎图。\n措斯世于平乂，应皇家兮瑶符。\n臣守藩兮南国，臣倾心兮北极。\n山之高兮水之深，祝吾皇兮寿千亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上霄洞","author":"王野","text":"吾闻北山阳，岩壑宝相窍。\n何年开鸿濛，随地通窔奥。\n朝真高难攀，冰壶深莫料。\n诡怪者双龙，崖室最苍峭。\n上霄虽晚出，烟霞寄孤峤。\n寻源陟空山，访仙款遗庙。\n始探颇褊窄，稍入亦窈窕。\n上穴由梯升，傍穿须火照。\n青厂既郁郁，白乳仍皭皭。\n旁通多曲折，幽眇转奇妙。\n穷探岂不欲，所畏自微爝。\n昏昏蝙蝠飞，悄悄鼪鼯叫。\n或疑洞灵出，或恐山鬼啸。\n又闻村中氓，凿石供灰烧。\n俄然得深窦，倾城尽登眺。\n何人不好事，窒塞迷其要。\n此虽幸独存，荒僻委蓬藋。\n傥移傍京邑，车马日号召。\n了知神仙事，茫昧不堪吊。\n岂无隐沦士，岩筑像惟肖。\n畬田沃可耕，涧水清可钓。\n平生爱泉石，自谓饥可疗。\n喜兹近吾隐，来往足谈笑。\n此意复谁论，行行逢荷筱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"王野","text":"轻霜临菊月，细雨似梅天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"王野","text":"莫道春随风雨过，化工昨夜到桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦皇庙","author":"常棠","text":"古庙三间矮棘丛，帝魂枉自气凌空。\n早知今日容身窄，前此阿房不作宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花婆井","author":"常棠","text":"一湾秋月浸香痕，涤尽山前万古尘。\n犹记当时老梳洗，淡妆明镜照眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次王元吉咏梅","author":"高鹏飞","text":"约略阳和动琯灰，南枝已冠百花魁。\n莫教陇驿携春去，且向罗浮唤梦回。\n玉骨风标自仙种，铁肠赋咏谩多才。\n只应剩结青青子，调鼎功夫看后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"窗轩","author":"高鹏飞","text":"一窗开永昼，万象出天成。\n风力欺杨絮，雷声唤笋萌。\n愁多春不愿，病起眼犹明。\n最喜今朝雨，川原足暮耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]