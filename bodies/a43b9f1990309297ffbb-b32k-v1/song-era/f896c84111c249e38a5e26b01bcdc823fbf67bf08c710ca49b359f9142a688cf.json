[{"title":"送李中舍袭之宰南郑","author":"梅尧臣","text":"莫问褒中道路难，襄阳直上几重滩。\n苍烟古柏汉高庙，落日荒茅韩信坛。\n出水槎头一丝挂，穿虹雨脚两桥残。\n土风大抵如南国，期会先时俗自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李君锡学士使契丹吊慰","author":"梅尧臣","text":"昨日匈奴来告哀，殿门不识桃花开。\n今闻君去作吊使，正值雁嘷从北回。\n风捲黄云无远近，山留白雪犹枯荄。\n归看车马汗流沫，逃暑为传河朔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李学士公达北使","author":"梅尧臣","text":"万里使穷域，山川入马蹄。\n驼鸣沙水冻，雕击雪云低。\n食饮羊兼酪，供迎虏杂奚。\n礼成回近日，喜听早期鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李泾州审言 其二","author":"梅尧臣","text":"汉家旧日回中路，天子新除太守行。\n牙将握刀趋远驿，羌人下马拜高旌。\n云间白草开边陇，山上朱楼压郡城。\n勇脱区区簿书内，壮心应欲请长缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李祠部知滑州","author":"梅尧臣","text":"自古重名器，未尝轻授人。\n煌煌东郡守，灿灿两朱轮。\n父祖继居此，恩荣谁与邻。\n秋风度河水，马足不生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李载之殿丞赴海州榷务","author":"梅尧臣","text":"瓜蔓水生风雨多，吴船发棹唱吴歌。\n槎从秋汉下应快，人忆故园归奈何。\n世事静思同转毂，物华催老剧飞梭。\n茶官到有清闲味，海月团团入酒蠃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李康伯赴武当都监","author":"梅尧臣","text":"城下汉江流，沧波照鬓秋。\n山川包楚塞，风物似荆州。\n试听清砧发，何如画角愁。\n遥知绝戎事，水味有槎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李献甫寺丞知虹县先归金陵","author":"梅尧臣","text":"今日归为美，涂金作马缨。\n愿言膏沐妇，相望石头城。\n得邑柳堤合，还家梅野晴。\n里中多乐事，州牧是名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秀州海盐知县李寺丞","author":"梅尧臣","text":"吴帆千里去，邑屋富鱼盐。\n霜鹤亭皋唳，风乌海客占。\n沧凉朝日近，紫翠晚山尖。\n若过陆机宅，寒芜应不嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送贡仲章之燕","author":"梅尧臣","text":"天启文明泰运兴，汉庭来召鲁诸生。\n我婴世网空投老，君向容台早著名。\n水阔风高鹏翼健，沙乾云暖马蹄轻。\n归来衣锦看他日，何用樽前唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邵不疑谪邵武","author":"梅尧臣","text":"不嗟迁谪远，所惜去非迟。\n国法何尝重，君恩亦已慈。\n飞鸿因雨急，寒叶未霜危。\n江上多新酿，青帘亚竹篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邵梦得永康军判官","author":"梅尧臣","text":"言离洛阳日，正值春风前。\n伊水矫白鹭，蜀山鸣杜鹃。\n轻袍游宦去，匹马度关年。\n若过君平肆，穷通可问焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送闵郎中知池州","author":"梅尧臣","text":"一送池阳守，颇怀当日游。\n青山临岸尽，翠水入江流。\n楚旧茅为贡，燕来雁报秋。\n牧之登览处，故事待君修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陆子履学士通判宿州","author":"梅尧臣","text":"雷雨初过草木新，汴堤杨柳绿阴匀。\n已看画舸逐流水，不惜长条折与人。\n淮境秋传蟹螯美，郡斋凉爱蚁醅醇。\n睢南莫久留才子，宣室归来问鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陆介夫学士通判秦州","author":"梅尧臣","text":"从来戎马地，飨士日椎牛。\n介胄奉儒服，诗书参将谋。\n陇云连塞起，渭水入关流。\n岂似瀛洲下，穷年事校雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈贤良忠正军签判","author":"梅尧臣","text":"书对三千字，恩科第一人。\n鲲鱼飞北海，龙剑跃平津。\n直悟聪文主，深论险尅臣。\n已能明世弊，枉作幕中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周谏议知襄阳","author":"梅尧臣","text":"蔼蔼荆州几万家，竟持壶酒望高牙。\n里儿尚唱铜鞮曲，耆旧争随画鹿车。\n雄鸭绿头看汉水，肥鳊缩项出渔查。\n乡人应笑张平子，只有归田赋可誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送贤良田太丞通判江宁","author":"梅尧臣","text":"世为燕赵客，慷慨有奇才。\n对策汉庭后，拜官江国来。\n舟从瓜步去，潮自蒋山回。\n心寄城头月，相随上古台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑太保瀛州都监","author":"梅尧臣","text":"秋气入关河，匈奴久已和。\n雕弓聊可试，宝剑不须磨。\n草木将摇落，牛羊自寝讹。\n能知塞垣景，持以赠吾歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送临江军监军李太博","author":"梅尧臣","text":"三江卑湿地，北客宦游稀。\n雾气多成雨，云蒸易损衣。\n白醪烧瓮美，黄雀下田肥。\n未辨殊方语，山歌半是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送信安张从事吉甫兼寄白使君","author":"梅尧臣","text":"西洛故人少，世家今亦稀。\n怜君能及禄，过我苦言归。\n游宦长城下，生涯旧国微。\n使君应借问，出处竟多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送施司封福建提刑","author":"梅尧臣","text":"命使得才臣，钦刑圣主仁。\n铜苗休问发，田种去教亲。\n白茗出溪上，红蕉连海滨。\n轻车莫道远，诏意重生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送洛南周寺丞","author":"梅尧臣","text":"将去洛南宰，日闻庭下松。\n乱山归四隐，旧墅隔三峰。\n狭谷车能入，春林雨易逢。\n地多椒与漆，货必厚于农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送洪州通判何太博先归新淦","author":"梅尧臣","text":"拜官江上客，乘马不乘船。\n独畏蛟龙浪，将归风雨天。\n葛花侵野径，源水入腴田。\n君住巴丘下，西山道路连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送洪秘丞知大宁监","author":"梅尧臣","text":"三峡蛮溪上，千山楚俗兼。\n妇人樵入市，官井货专盐。\n魑魅或为患，猕猴常可嫌。\n君能厚风化，男子使腰镰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡臣秀才","author":"梅尧臣","text":"汴水日夜浅，归船不可留。\n天高云就岭，地冷雁回洲。\n江馆鱼堪食，家林橘已收。\n平生素业在，莫见里人羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送觉上人归湖州","author":"梅尧臣","text":"古寺一盂饭，弊衣三岁尘。\n相应维帝祝，子已得袍新。\n范叔复何望，原生甘自贫。\n归看五湖上，终有泛舟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵子渊知颍州","author":"梅尧臣","text":"旧谷不栖亩，新春原鹿饥。\n野荒多寇夺，诏发抚疲羸。\n驿骑东风急，菑田小雨迟。\n应同汉太守，膏泽亦能随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵升卿之韶幕","author":"梅尧臣","text":"舟车历尽险，风物乃还君。\n俎肉应多味，虞韶不复闻。\n林鸣异音鸟，山冒欲晴云。\n若吊张丞相，空祠旧近坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵谏议知徐州","author":"梅尧臣","text":"鹿车几两马几匹，轸建朱幡骑彀弓。\n雨过短亭云断续，莺啼高柳路西东。\n吕梁水注千寻险，大泽龙归万古空。\n莫问前朝张仆射，毬场细草绿蒙蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送闾丘殿丞","author":"梅尧臣","text":"每有西归客，谁无满袖诗。\n都忘将别意，竞媚向官资。\n凭在屋头月，照君墙上旗。\n不同山一定，更远更相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送唐待制子方北使","author":"梅尧臣","text":"王命来天外，阏氏坐帐中。\n仪虽聘邻国，礼岂异和戎。\n汉使方持节，胡人自带弓。\n唯应沙漠凛，不减谏臣风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送唐紫微知苏台","author":"梅尧臣","text":"洞庭五月水生寒，卢橘杨梅已满盘。\n泰伯庙前看走马，阖闾城下见骖鸾。\n吴娃结束迎新守，府吏趋锵拜上官。\n曾过扬州能惯否，刘郎盏底劝须宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐君章秘丞知梁山军","author":"梅尧臣","text":"苍壁束江流，孤军水上头。\n蛟龙惊鼓角，云雾裛衣裘。\n午市巴姑集，危滩楚客愁。\n使君才笔健，当似白忠州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送晁质夫太丞知深州","author":"梅尧臣","text":"芜蒌问古亭，春入饶阳城。\n豆粥君王远，壶浆刺史迎。\n地凉宜牧马，塞近惯调兵。\n为寄井泉石，老来思目明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送晁殿丞郑州签判","author":"梅尧臣","text":"朝离泌水上，夕去野亭赊。\n走马日衔树，度河风卷沙。\n关云来雨脚，陂岸长蒲芽。\n共被方为乐，军中莫掺挝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送润州通判李屯田","author":"梅尧臣","text":"过江始与风沙隔，京口山连北固牢。\n刺史丰仪于体重，邦人全伏以名高。\n宴盘紫蟹方多味，古寺青林不厌遨。\n定挈传家旧图籍，漕河应莫费吴艘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送盐官刘少府古贤","author":"梅尧臣","text":"我祖南昌尉，时危弃去仙。\n刘郎从宦日，天子治平年。\n燥茗山中火，熬波海上烟。\n吴民不为盗，唯此挠君权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送阆州驻泊荆供奉","author":"梅尧臣","text":"青天不可上，蜀道未尝行。\n每说褒斜险，唯闻猿鸟声。\n去为千里客，自握一方兵。\n所重恩威立，无将远戍轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陶太博通判广信军","author":"梅尧臣","text":"平时易水头，不复起边愁。\n壮士去来久，寒波空自流。\n临塘移鹭羽，隔戍见毡裘。\n半似江南美，军和胜宴游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送崔秀才 其二","author":"梅尧臣","text":"少年游太学，著尽箧中衣。\n独剑自为伴，无家何处归。\n秋蓬随野转，寒鹊绕林飞。\n霄汉有知己，行行宁久微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送崔秀才 其一","author":"梅尧臣","text":"晨风无定巢，远寄鹪鹩枝。\n天寒鼓翼健，粒食宁所窥。\n大泽多群羽，翱翔各有时。\n今子振衣去，焉能久迍羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁学士知襄州","author":"梅尧臣","text":"骑吹荆州去，乔林汉水前。\n乡亭逢故老，牛酒问高年。\n翠巘临关路，黄柑逐贾船。\n习家池馆在，宾从与留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送萧监丞浚宰临邑","author":"梅尧臣","text":"羡君先拜邑，残腊见登车。\n远驿寒云重，长郊积雪馀。\n行当劝民稼，始信带经锄。\n还到济南日，应传古尚书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送阎中孚郎中知磁州","author":"梅尧臣","text":"箫管梁王台，风雪邯郸道。\n君行守赵城，我向夷门老。\n持麾邦寄重，歌裤民欣早。\n重冈古猎场，惊兔离衰草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄国博知抚州","author":"梅尧臣","text":"逆水乘风上，蒲帆满挂樯。\n日行知几里，江渺不分疆。\n宿浦随潮入，逢人问路长。\n临川十万户，劝劳执壶浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送棣州唐虞部","author":"梅尧臣","text":"人持左符去，马逆北风行。\n古路草初白，大河冰未成。\n暖科桑柘美，寒织杼梭鸣。\n风俗已如此，憩棠无讼争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送温州楚屯田","author":"梅尧臣","text":"雁荡山头雁，如随太守来。\n秋风既与至，春日定同回。\n上宰无忘旧，明时必用才。\n自于章句老，经册向萤开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送番禺杜杆主簿","author":"梅尧臣","text":"行识桄榔树，初窥翡翠巢。\n地蒸蛮雨接，山润海云交。\n讼少通华语，虫多入膳庖。\n不须思朔雪，梅吐腊前梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送董察推赴江宁","author":"梅尧臣","text":"金陵从事去，不叹食无鱼。\n尺鲤日登俎，故乡时得书。\n衰荷摘短袂，秋藓曳长裾。\n若见府公问，年来懒更疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩文饶寺丞宰萧山","author":"梅尧臣","text":"吴会未探穴，广陵先看潮。\n横江百马怒，卷海万鼙嚣。\n舟楫凌湍发，鱼龙接浪跳。\n薄言增勇气，少当举山瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩文饶赞善宰河南","author":"梅尧臣","text":"退之曾作河南宰，韩氏于今又见君。\n县政从来人有望，家声不坠世多文。\n后池分洛贮蓝水，高槛看嵩迷岭云。\n主簿堂前七叶树，手栽应莫已刳焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩玉汝太傅知洋州三首 其二","author":"梅尧臣","text":"渭入秦宫古，褒分蜀道难。\n泉声春雨后，月色晓程寒。\n蚕浴桑芽短，禽啼杏萼丹。\n从来称召杜，民俗在君安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩奉礼","author":"梅尧臣","text":"将欲侍亲去，独要予赠言。\n世风还自有，文体不须论。\n稍爱春波急，微生野岸根。\n舟行宁觉远，几日到都门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩持正寺丞知馀姚","author":"梅尧臣","text":"君家二仲父，连为吴越宰。\n钱唐与萧山，治迹应无改。\n鱼虾莫厌腥，网罟从人采。\n天晴姚江深，县鼓朝翻海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩签判玉汝还南京","author":"梅尧臣","text":"天子甘泉祀，欢声浃九围。\n绿章驰骑入，朱服佩鱼归。\n赋雪上宾席，买鬟更舞衣。\n清池无限雁，莫道信音稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鲁玉太博挽词三首 其三","author":"梅尧臣","text":"试问于天下，谁从百岁心。\n短长从所尽，祸福乃相寻。\n只以名宾实，那论古至今。\n未能忘物境，空复叹人琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鲁玉太博挽词三首 其二","author":"梅尧臣","text":"自昔称王谢，于今亦盛门。\n尚看珠树秀，应见玉麟存。\n书史辛勤学，文章苦死论。\n都然莫施设，恨向九原吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鲁玉太博挽词三首 其一","author":"梅尧臣","text":"射策志何远，阖棺人共疑。\n奠觞朋友去，泣血母兄悲。\n雾气窗间尽，车声户外知。\n玉楼成作记，此语可能欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送微上人归省天台","author":"梅尧臣","text":"释子怀慈母，吾儒未易轻。\n不寻琪树去，肯向石桥行。\n海近云多润，山高日少晴。\n天恩新赐服，书字欲传名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新安张尉乞侍养归淮甸","author":"梅尧臣","text":"天兵出塞日，西尉去官初。\n却衣老莱服，曾无梅福书。\n春郊欲回雁，寒水正沉鱼。\n任意归舟驶，风烟亦自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楚屯田知扶沟","author":"梅尧臣","text":"客亭多少路，花信几番风。\n折柳赠新翠，种桃思旧红。\n渊明节已异，潘岳趣还同。\n政治有馀力，归来辞赋工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瑞竹长老归当涂因寄徐著作","author":"梅尧臣","text":"谢傅青山路，春来蔓草生。\n樵苏犹不入，瓶锡莫能行。\n朝上野船去，宿逢溪雨鸣。\n多应见康乐，曾重远公名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒙寺丞赴郢州","author":"梅尧臣","text":"郢国当时唱，犹传白雪真。\n问今非昔日，和者几何人。\n客自射飞雁，渔能供跃鳞。\n芳洲堕马处，吾祖汉名臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧在己归秀州","author":"梅尧臣","text":"前岁嘉兴火，僧居化劫灰。\n四方持钵去，千里渡江来。\n心向王城讲，缘从海客回。\n水天闻唳鹤，不复有尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蔡侍禁赴长沙","author":"梅尧臣","text":"寒叶下潇湘，之官逐雁行。\n水经菱浦晚，船过橘洲香。\n二女竹林外，三闾枫叶傍。\n平时息戎律，物景助才章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送裴节推归京","author":"梅尧臣","text":"远水未生冻，轻舟归大梁。\n岸回初向月，篙滑始沾霜。\n清世岂淹俊，上公存荐章。\n行应重对策，莫愧汉贤良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送鲜于秘丞通判黔州","author":"梅尧臣","text":"壶头山下俗，巴妇曲中听。\n汲井熬盐白，烧田种谷青。\n岩风来虎啸，江雨过龙腥。\n事简能谈者，杨雄所草经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]