[{"title":"夏日二首 其二","author":"朱熹","text":"季夏园木暗，窗户贮清阴。\n长风一掩苒，众绿何萧椮。\n玩此消永昼，泠然涤幽襟。\n俯仰无所为，聊复得此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汲清泉渍奇石置熏炉其后香烟被之江山云物居然有万里趣因作四小诗 其一","author":"朱熹","text":"晴窗出寸碧，倒影媚中川。\n云气一吞吐，湖江心渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汲清泉渍奇石置熏炉其后香烟被之江山云物居然有万里趣因作四小诗 其二","author":"朱熹","text":"一水渺空阔，群山中接连。\n寒阴白雾涌，飞度碧峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汲清泉渍奇石置熏炉其后香烟被之江山云物居然有万里趣因作四小诗 其三","author":"朱熹","text":"隐几对寒碧，忘言心自闲。\n岂知宜寂士，灭迹青峰间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汲清泉渍奇石置熏炉其后香烟被之江山云物居然有万里趣因作四小诗 其四","author":"朱熹","text":"吟馀忽自笑，老矣方好弄。\n慨然思古人，尺璧寸阴重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次张彦辅韵","author":"朱熹","text":"风霜岁云徂，尘事眯双目。\n故人书鼎来，照眼一连玉。\n把玩不知疲，日晏坐空腹。\n卷藏什袭秘，寒光夜穿椟。\n嗟予肮脏姿，十驾不能速。\n丘壑聊自娱，箪瓢亦云足。\n君侯湖海士，逸气谢追逐。\n胡为不予鄙，乃肯顾林谷。\n高轩缓前期，清梦绕双竹。\n起将杜陵句，写寄玉川屋。\n我穷诗未工，最觉貂难续。\n感君慇勤意，吟苦屡更烛。\n群公饶藻思，裂笺动盈束。\n历险正摧辀，争先俄击毂。\n低回欲引避，怅望曷归宿。\n出吻竟无奇，彊颜终自恧。\n北风催岁年，两鬓失新绿。\n樊生念学稼，曹子悲食粟。\n死灰宁复然，寡过良所欲。\n耿耿自知明，何劳詹尹卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次张彦辅赏梅韵","author":"朱熹","text":"朔风万里开云屏，清霜夜坠朝景晴。\n南枝浩荡正春色，冻蕊的皪含空明。\n花边偶对青铜镜，槁项不堪冰雪映。\n拥炉独坐只悲吟，振策出游舒远兴。\n暗香何处时一飘，行行复值最长条。\n仰头欲折渺谁赠，满意相思那得邀。\n极知异县淹行李，心赏未甘轻付畀。\n石雄赋罢不相闻，秀野书来因举似。\n两翁句法争新奇，画出疏影沉寒漪。\n幽探自出尘境外，胜概未许儿曹知。\n祇今嚼蕊攀条处，它日重来记前度。\n风台月观悄无言，玉笛冰滩索同赋。\n嗟予衰懒倦将迎，过眼纷纷无复情。\n尚喜疏英窥水白，更怜落片点苔青。\n兴来乱插飞蓬首，拟向君家醉君酒。\n酒酣耳热莫狂歌，布鼓雷门须缩手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借韵呈府判张丈既以奉箴且求教药","author":"朱熹","text":"一生江海迥无俦，材大应容小未周。\n景好身闲真复乐，酒酣耳热却堪忧。\n飞腾莫羡摩天鹄，纯熟须参露地牛。\n我亦醒狂多忤物，颇能还赠一言不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家山堂晚照效辋川体作二首 其一","author":"朱熹","text":"夕阳浮远空，西峰背残照。\n爽气转分明，与君共晚眺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家山堂晚照效辋川体作二首 其二","author":"朱熹","text":"山外夕岚明，山前空翠滴。\n日暮无与期，闲来岸轻帻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事有怀寄彦辅仲宗二兄二首 其一","author":"朱熹","text":"一水方涵碧，千林已变红。\n农收争暖日，老病怯高风。\n徙倚非无计，心期莫与同。\n向来欢会处，离合太匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事有怀寄彦辅仲宗二兄二首 其二","author":"朱熹","text":"闻说双飞桨，翩然下广津。\n江湖知子乐，鱼鸟谅情亲。\n淹速须关命，行藏不系人。\n三山虽好在，惜取自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次知府府判二丈韵三首 其一","author":"朱熹","text":"两公清庙瑟，窈窕拂朱丝。\n事纪一朝胜，名从千古垂。\n流传当共赋，惆怅不同时。\n且要君颐解，宁辞匡说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次知府府判二丈韵三首 其二","author":"朱熹","text":"忆昨中秋夕，寒盟约重寻。\n幔亭欢举酒，江阁快论心。\n月堕俱忘起，罍空始罢斟。\n只今千岭隔，怅望一何深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次知府府判二丈韵三首 其三","author":"朱熹","text":"志士怀韬略，奇兵吼镆干。\n关河那得往，肝胆不胜寒。\n壮节悲如许，雄图渺未阑。\n皇舆方仄席，陋巷敢求安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巢居之集以中有学仙侣吹箫弄明月为韵探策赋之而熹得中字遂误为诸君所推高俾专主约既而赋诗者颇失期于是令最后者具主礼以当罚乃稍集独敦夫圭甫违令后至众白罚如约饮罢以苍茫云海路岁晚将无获分韵熹得将字而子衡兄得苍字实代熹出令","author":"朱熹","text":"一昨楼上饮，所欢不可忘。\n群公各赋诗，佩玉何锵锵。\n二子朱丝弦，掩抑独叵量。\n经营久不作，一奏声满堂。\n巧迟未足多，谴负先取偿。\n主盟谬夙推，否德愧莫当。\n兹焉不举法，何以存令章。\n刘子具盘食，魏子输壶浆。\n悠然复一醉，归路相扶将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨承诸兄临辱不揆以薄酒蔬食延驻都骑明日视壁间所张墨刻有亡去者人以为德庆丈之廋也驰问遣索蒙需拙诗辄赋所怀往奉一笑而尊犍刻可以归于我矣","author":"朱熹","text":"岁暮霜霰集，宾友从我游。\n置酒临高斋，觞酌屡献酬。\n鸡黍整中庖，肴核供庶羞。\n所恨乏珍肥，欢意不得周。\n何牾上客怀，徙我夜壑舟。\n平明但素壁，篆刻不可求。\n究索劳象罔，高踪希盗丘。\n我亦惭仲子，独未忘轻裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨以诗徵亡碑于四十一丈既蒙酬和而诸兄亦继作焉联为巨编藏之巾笥虽所亡古刻不可复得而此之所获则已多矣顾其中犹有不能释然者因念吾子厚隶法妙古人当为我大书伟辞于壁庶以焜耀区区之望彼死鬼之陈迹其存亡盖不足为重轻也次韵见意云","author":"朱熹","text":"端居感物化，怅恨不出游。\n赋诗往追亡，顾得杂佩酬。\n结绶光陆离，缊袍非所羞。\n终然抱耿耿，尼父悲东周。\n凄凉尊犍崖，望想沧浪舟。\n低徊不得去，寂寞将焉求。\n安知崔蔡徒，考槃共斯丘。\n为我挥素壁，报君当紫裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋解嘲","author":"朱熹","text":"宇宙一瞬息，人生等浮游。\n云何百年内，万变纷相酬。\n颠倒不自知，旁观乃堪羞。\n拱揖尚虞夏，干戈到商周。\n岂悟旷士怀，泛若不系舟。\n驷马谅弗视，名高非所求。\n彼哉夸夺子，逝矣昆崙丘。\n褰裳绝冥外，天风舞云裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题祝生画呈裴丈二首 其一","author":"朱熹","text":"近代丹青手，心期良独难。\n夫君偏有思，妙处却无端。\n堂上三湘远，人间五月寒。\n空囊今有此，不用一钱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题祝生画呈裴丈二首 其二","author":"朱熹","text":"斗酒淋漓后，颠狂不作难。\n千峰俄纸上，万景忽豪端。\n石瘦冈峦古，林深烟雨寒。\n苍茫无限意，俗眼若为看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽延平李先生三首 其一","author":"朱熹","text":"河洛传心后，毫釐复易差。\n淫辞方眩俗，夫子独名家。\n本本初无二，存存自不邪。\n谁知经济业，零落旧烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽延平李先生三首 其二","author":"朱熹","text":"闻道无馀事，穷居不计年。\n箪瓢浑谩与，风月自悠然。\n洒落濂溪句，从容洛社篇。\n平生行乐地，今日但新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽延平李先生三首 其三","author":"朱熹","text":"岐路方南北，师门数仞高。\n一言资善诱，十载笑徒劳。\n斩板今来此，怀经痛所遭。\n有疑无与析，挥泪首频搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用西林旧韵二首 其一","author":"朱熹","text":"一自篮舆去不回，故山空锁旧池台。\n伤心触目经行处，几度亲陪杖屦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用西林旧韵二首 其二","author":"朱熹","text":"上疏归来空皂囊，未妨随意宿僧房。\n旧题岁月那堪数，惭愧平生一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其一 纳湖","author":"朱熹","text":"诗筒连画卷，坐看复行吟。\n想像南湖水，秋来几许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其二 东渚","author":"朱熹","text":"小山幽桂丛，岁暮霭佳色。\n花落洞庭波，秋风渺何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其三 咏归桥","author":"朱熹","text":"绿涨平湖水，朱栏跨小桥。\n舞雩千载事，历历在今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其四 船斋","author":"朱熹","text":"考槃虽在陆，滉瀁水云深。\n正尔沧洲趣，难忘魏阙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其五 丽泽堂","author":"朱熹","text":"堂后林阴密，堂前湖水深。\n感君怀我意，千里梦相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其七 书楼","author":"朱熹","text":"君家一编书，不自圯上得。\n石室寄林端，时来玩幽赜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其八 山斋","author":"朱熹","text":"藏书楼上头，读书楼下屋。\n怀哉千载心，俯仰数椽足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其九 蒙轩","author":"朱熹","text":"先生湖海姿，蒙养今自閟。\n铭坐仰先贤，点画存彖系。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十 石濑","author":"朱熹","text":"疏此竹下渠，漱彼涧中石。\n暮馆绕寒声，秋空动澄碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十一 卷云亭","author":"朱熹","text":"西山云气深，徙倚一舒啸。\n浩荡忽搴开，为君展遐眺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十二 柳堤","author":"朱熹","text":"渚华初出水，堤树亦成行。\n吟罢天津句，薰风拂面凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十三 月榭","author":"朱熹","text":"月色三秋白，湖光四面平。\n与君凌倒景，上下极空明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十四 濯清","author":"朱熹","text":"涉江采芙蓉，十反心无斁。\n不遇无极翁，深衷竟谁识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十五 西屿","author":"朱熹","text":"朝吟东渚风，夕弄西屿月。\n人境谅非遥，湖山自幽绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十六 淙琤谷","author":"朱熹","text":"湖光湛不流，嵌窦亦潜注。\n倚杖忽淙琤，竹深无觅处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十七 听雨舫","author":"朱熹","text":"綵舟停画桨，容与得攲眠。\n梦破蓬窗雨，寒声动一川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十八 梅堤","author":"朱熹","text":"仙人冰雪姿，贞秀绝伦拟。\n驿使讵知闻，寻香问烟水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其十九 采菱舟","author":"朱熹","text":"湖平秋水碧，桂棹木兰舟。\n一曲菱歌晚，惊飞欲下鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同张敬夫城南二十咏 其二十 南阜","author":"朱熹","text":"高丘复层观，何日去登临。\n一目长空尽，寒江列暮岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈武夷道中五绝句 其一","author":"朱熹","text":"地久天长岁不留，坐来念念失藏舟。\n回看万法皆儿戏，还直先生一笑不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈武夷道中五绝句 其二","author":"朱熹","text":"分符拥节几经年，闻道方成屋数椽。\n只恐未容高枕卧，却须持橐听鸣鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈武夷道中五绝句 其三","author":"朱熹","text":"勋业今从镜里休，箧中空有敝貂裘。\n死灰那复飞扬意，惠许深惭不易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈武夷道中五绝句 其四","author":"朱熹","text":"常记桐城十载前，几回风雨对床眠。\n他年空忆今年事，却说黄亭共惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈武夷道中五绝句 其五","author":"朱熹","text":"诸郎步武各骎骎，季子尤怜产万金。\n衣钵相传自端的，老生无用与安心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 小山","author":"朱熹","text":"飞来小坡坨，未雨已滂濞。\n荒此定何人，苏公有遗记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画卷 吴画","author":"朱熹","text":"妙绝吴生笔，飞扬信有神