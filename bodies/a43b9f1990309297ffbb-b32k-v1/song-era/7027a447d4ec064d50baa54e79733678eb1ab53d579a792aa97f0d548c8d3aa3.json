[{"title":"论螳螂形 其一","author":"贾似道","text":"首短身长何足用，羽翅好是航船?。\n若还六足尽尖长，此是螳螂最堪用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论螳螂形 其二","author":"贾似道","text":"身狭牙尖大肚皮，脚前乔立仰头窥。\n此蛩不问青黄色，斗到深秋必定输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"论蟑螂形","author":"贾似道","text":"易名宽翅号蟑螂，翅阔头尖牙用长。\n身要匾摊脚要细，只许英雄三二番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"防微","author":"贾似道","text":"朝晨出宿看虫形，须交提出斗盆听。\n撚聒叫声观喜怒，蛩喜如同虎啸声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呆物 其三","author":"贾似道","text":"飞虫能斗体轻盈，拔翅成疮斗负疼。\n可用剪刀裁内翅，自然百战百番赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呆物 其二","author":"贾似道","text":"头昏项紧有何奇，腿脚花班黑肚皮。\n翅上更有膏药积，只好将来去喂鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗法八条 其二 防敌","author":"贾似道","text":"左右不离常夹牵，临斗之时多少变。\n他若回身牵捍遮，踢着之时必伤面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗法八条 其八 斗败","author":"贾似道","text":"此番不比寻常败，饱食泥盆待一旬。\n临日带饥将出斗，依然还做上将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗法八条 其三 择牵","author":"贾似道","text":"牵头要长捍要直，落牵不要如弩力。\n牵头急落栅儿中，便是青天遭霹雳。\n把牵犹如人把舵，舵若横时舟受祸。\n牵头须取白露前，好牵就中金宝货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗法八条 其六 审势","author":"贾似道","text":"他若无情休要斗，分斗开时向面点。\n你若频撚必酸牙，焰头过了形多变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斗法八条 其四 接力","author":"贾似道","text":"五日方容斗一场，若还频斗损牙关。\n虫儿不食因何事，蛟损牙关服食难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昌化道中","author":"贾似道","text":"西风落叶路漫漫，衣袂微生旦暮寒。\n只隔片云家便到，远山移入梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狗蝇黄","author":"贾似道","text":"麻头黄项翅铺金，腿脚班黄肉蜜色。\n牙钳若是黑如灰，敌尽场中为第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金束带","author":"贾似道","text":"十个红铃九个败，脱却红铃休赌赛。\n红铃若得满腰生，常胜号为金束带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青金翅","author":"贾似道","text":"麻头青项翅如金，肉腿如同银打成。\n牙钳更生如漆黑，赢尽诸人匣内金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青麻","author":"贾似道","text":"麻头青项有毛丁，翅绉肉白腿脚长。\n更生一付牙钳黑，三秋得胜喜非常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青黄二色 其二","author":"贾似道","text":"青黄二色翅项明，此等生来何处寻。\n初秋斗到深秋后，百度交锋百度赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青黄二色 其一","author":"贾似道","text":"黄头青项销金翅，二色俱全便为最。\n若还三件一齐生，斗到秋深绝无对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"促织歌","author":"贾似道","text":"新虫调理要相当，残暑盆窝须近凉。\n渐到秋深畏风冷，不宜频浴恐防伤。\n养时盆罐须宽阔，下食依时要审详。\n水食调匀蛩必旺，看时切莫对阳光。\n水时并尽方堪斗，不可伤饥患饱忙。\n盆内土须蚯蚓粪，相宜盖为按阴阳。\n如此宿虫无姤色，仍将宿水换新浆。\n假如草叶供虫啮，齿软仍知牙更僵。\n过笼窝罐安排固，行动提携总不妨。\n酒后切忌将来看，壮气冲伤走跳狂。\n误放橘橙充食物，食之虫腹反为殃。\n安顿必须清净处，油烟熏损不刚强。\n过期未斗频频看，仍复收拾用意藏。\n倘或打食口齿谩，必须医损按前方。\n不察强弱当场斗，必是遭输笑不良。\n盖盆谨慎休留隙，免使奔逃意下慌。\n看取调养依斯谱，虫体无伤齿更刚。\n堪怜一种清幽物，岁岁三秋声韵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养法十二条 其四","author":"贾似道","text":"喂食还须只一件，莫信傍人教你换。\n鸡豆菱肉尽非宜，不及朝朝黄米饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咸淳庚午冬大雪遗安抚潜侍郎 其二","author":"贾似道","text":"玉立堂堂君子林，由来彦圣好于心。\n时和定是占书岁，贤居奚须更难任。\n上瑞以人誇自昔，太平有象适当今。\n莫令一片花飞却，留取春光到绿荫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总言 其一","author":"贾似道","text":"莫言促织正奇能，养者须当耐性情。\n只宜漫斗无疏失，不可忙忙去斗频。\n交锋一口停三日，大斗须还隔一旬。\n不依此法随心好，撞了齐肩必定倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"残疾","author":"贾似道","text":"不问青黄赤白黑，不拘大小与残疾。\n秃须秃尾小无爪，此物见之不足惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真青麻头","author":"贾似道","text":"线项麻头纹理明，蜻蜓头翅项浑青。\n侧生身分高而厚，斗著交锋速便赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积食不消化诀","author":"贾似道","text":"积食不化甚堪嗟，水畔红虫是可佳。\n研细任君分两处，喂毕斗胜是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇恩演福禅寺偈","author":"贾似道","text":"灵山一别几经春，今日重来喜见君。\n佛法一肩担荷却，黄鹤楼前第一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淡黄","author":"贾似道","text":"淡黄生来腿脚白，三样头尖如琥珀。\n初秋斗间最迷痴，末后逢强绝口敌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄麻头","author":"贾似道","text":"麻头黄项翅金色，腿脚班黄肉带蜜。\n牙钳若是炭样乌，斗胜叫鸣闻四壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶翅 其三","author":"贾似道","text":"哂哂连叫两三声，此虫便是灶鸡形。\n玉腿白牙赢到底，黄牙项细是输名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琵琶翅 其一","author":"贾似道","text":"壳翅琵琶不用青，若还紫色也相应。\n要知斗处关张勇，头小牙长体似金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫金翅","author":"贾似道","text":"紫头青项翅如金，腿脚兼黄肉带蜜。\n必须生有紫黑钳，咬杀秋虫人失色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫黄","author":"贾似道","text":"头似樱珠项似金，肉脚如同金裹成。\n牙钳不问何颜色，诸虫咬著便昏沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阔翅","author":"贾似道","text":"阔翅之虫识亦难，臀长匾薄也应凡。\n要知才貌青黄色，头小牙长两腿班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黑紫","author":"贾似道","text":"黑紫生来似茄皮，腿脚兼黄赤肚皮。\n钳若生来紫黑色，早秋赢到雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦蓑衣","author":"贾似道","text":"翅宽翅急最为低，识者当场便敢欺。\n生得两边如鸟翅，名传天下锦蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辨虫老嫩","author":"贾似道","text":"要知促织与苍雏，秘诀分明在两须。\n贴齿老黄生日久，悬牙如玉离泥初。\n头高必定无心斗，埋首人称老野狐。\n有此秘方劳记取，十场罕有一场输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蟹青","author":"贾似道","text":"此虫名称湖蟹青，腿脚班黄翅不金。\n不看牙钳红与白，须观项上有毛丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"贾似道","text":"浦浦风来趁藕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"贾似道","text":"飞花落絮满长安，饮尽离杯度渺漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"贾似道","text":"梅花见处多留句，谏草藏来定得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"贾似道","text":"轻袂杨花落，遥装燕子随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"贾似道","text":"稻花香满路，菰叶乱苍洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示蔡通判","author":"贾同","text":"圣君宠厚龙头选，慈母恩深白发垂。\n君宠母恩俱未报，酒如为患悔何追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横浦楼","author":"贾成之","text":"横槎三月江如束，风浪萦行接天绿。\n郡楼新创插云飞，尽日江山对双目。\n楼中剌史幽兴长，百斛载春供不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 呈判府宣机先生乞赐笑览","author":"贾应","text":"晚日浴鲸海，璧月挂鳌峰。\n不知今夕何夕，灯火万家同。\n楼外芙蕖开遍，人在琉璃影里，语笑隔帘重。\n对景且行乐，一醉任东风。\n黄堂宴，春酒绿，艳妆红。\n文章太守，和气都在笑谈中。\n正此觥筹交错，只恐笙歌未散，温诏促追锋。\n来岁传柑处，侍宴自从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"贾宜","text":"滕王阁畔斗星傍，此处幽人构草堂。\n鹤散窗含松岛露，客来衣带橘洲香。\n诏旌门第殊恩沛，教被乡闾益讼藏。\n小圃花时三径雪，朝昏谁共对琴觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曲水园","author":"贾昌朝","text":"画船载酒及芳辰，丞相园林潩水滨。\n虎节麟符抛不得，却将清景付闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏凌霄花","author":"贾昌朝","text":"披云似有凌霄志，向日宁无捧日心。\n珍重青松好依托，直从平地起千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"繁城魏受禅台","author":"贾昌朝","text":"服殷自古称文王，几见符膺把纣亡。\n谁谓老奸亟篡事，禅台空立在繁昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"贾昌朝","text":"都城水绿嬉游处。\n仙棹往来人笑语。\n红随远浪泛桃花，雪散平堤飞柳絮。\n东君欲共春归去。\n一阵狂风和骤雨。\n碧油红旆锦障泥，斜日画桥芳草路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"贾昌朝","text":"坐忆蛟桥此日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄赠宣义大师","author":"贾玭","text":"篆写千文迈古今，感陶承旨撰碑阴。\n两朝雨露书中得，满箧诗章物外寻。\n衡岳水云长挂梦，帝城烟月不关心。\n西游去后无消息，想共陈抟一处吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题壁","author":"贾舍人","text":"愁见干戈起四溟，恨无才术济生灵。\n不如痛饮中山酒，直到太平方始醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"贾青","text":"万叠层峰夹两溪，雨馀清气却炎晖。\n何时学得严陵傲，洗尽尘襟卧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黯淡院","author":"贾青","text":"溪声滩外急，草色两中深。\n客意自南北，山光无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子","author":"贾奕","text":"闲步小楼前。\n见个佳人貌类仙。\n暗想圣情浑似梦，追欢。\n执手兰房恣意怜。\n一夜说盟言。\n满掬沉檀喷瑞烟。\n报道早朝归去晚，回銮。\n留下鲛绡当宿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"贾逋","text":"薰梅染柳。\n借得东君手。\n柳色梅香到樽前，摅写才华八斗。\n当年占梦佳辰。\n今年乐事尤新。\n日侍玉皇香案，钧天日月常春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝中措","author":"贾逸祖","text":"青山隐隐水斜斜。\n修竹两三家。\n又是水寒山瘦，依然行客遍天涯。\n天教流落，东西南北，不恨年华。\n只恨夜来风雨，投明月、老却梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟贻宣议大师英上人","author":"贾黄中","text":"金仙子便是师师，高道宁容世网羁。\n浩浩心田龙可扰，飘飘行止鹤应知。\n尘机摆落超三界，古篆沉研冠一时。\n莫怪伊余苦珍重，白莲花社有心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送新知永州潘宫赞若冲赴任","author":"贾黄中","text":"鸳鹭行中已著名，颂条暂慰远民情。\n道途行去乘轺贵，乡里过时画锦荣。\n铃阁晓开江月满，戟枝寒照雪峰明。\n知君游刃多馀暇，莫忘新诗寄凤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华林书院","author":"贾黄中","text":"旌阳旧山曲，书室构山前。\n景物尘埃外，轩窗树石边。\n宁惟集儒业，兼恐混神仙。\n百行家门最，宜当世有贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伏睹禁林盛事谨赋一章","author":"贾黄中","text":"璇题飞白御毫新，三体琼章妙入神。\n特赐禁林为盛事，只缘明主重名臣。\n青编辉映轻前古，丹地深严隔世尘。\n金箓祯祥非是宝，玉堂名号此方贞。\n恩荣谁比烟霄客，文彩长悬日月轮。\n为报鳌宫主人道，蓬莱全胜昔时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂林还珠洞","author":"贾黄中","text":"赫赫威声震百蛮，昔携筐筥溷溪山。\n无人为起文渊问，端的珠还薏苡还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画绯桃题诗","author":"贾蓬莱","text":"朱砂颜色瓣重台，曾是刘郎旧看来。\n只好天台云里种，莫教移近俗人栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢姊惠鞋","author":"贾蓬莱","text":"莲瓣娟娟远寄将，绣罗犹带指尖香。\n弓弯著上无行处，独立花阴看雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晓","author":"贾蓬莱","text":"方池水影薄，曲槛鸟声娇。\n鸾镜红绵冷，蛾眉翠黛消。\n冶容舒嫩萼，幽思结柔条。\n纤指收花露，轻将雪粉调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨","author":"贾蓬莱","text":"露颗珠团团，冰肌玉钏寒。\n杏梁栖只燕，菱镜掩孤鸾。\n残树枯黄遍，圆荷湿翠乾。\n绣帘生色画，窗下带羞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏蝶","author":"贾蓬莱","text":"薄翅凝香粉，新衣染媚黄。\n风流谁得似，两两宿花房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"贾蓬莱","text":"幽兰露华重，罗幌凉风动。\n木匣掩香纨，绣衾谁与共。\n萤影度疏帘，兽炉寥寥烟。\n银缸芳焰灭，自脱翠花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺情","author":"贾蓬莱","text":"燕子南来雁北飞，远人何事竟忘归。\n一腔心病难形口，万斛愁情尽属眉。\n试掠金钗临晓镜，潜垂玉箸渍春衣。\n邻姬莫问容憔悴，只有西窗夜月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题真仙岩","author":"贾遵祖","text":"翰林以谪流夜郎，我亦何为涉此境。\n生平山水债未了，宦游直度桂州岭。\n牂牁江绕古融城，拂拭冠缨照清影。\n举头忽见真仙岩，盘空攫拿势驰骋。\n天教刻削无遗巧，不知斤斧谁手秉。\n吻如蚀月丑虾蟆，枵腹穹窿宽一顷。\n尸居龙见柱下史，宴坐似说常清静。\n贯穿石涧飞惊湍，两岸峡束垂机阱。\n兹晨邂逅得胜践，身到中间发深省。\n青牛昔过函谷关，我陪五老曾造请。\n依然一念浩劫初，堕在尘埃官独冷。\n童儿徐甲今何所，朝从南箕暮东井。\n当时与我极绸缪，默而祷之意相领。\n扶携腾上虚皇前，赐我金丹凌倒景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"襄阳","author":"贾黯","text":"带水依山一万家，襄阳自古富豪奢。\n北轩二月回头望，红日连城尽是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]