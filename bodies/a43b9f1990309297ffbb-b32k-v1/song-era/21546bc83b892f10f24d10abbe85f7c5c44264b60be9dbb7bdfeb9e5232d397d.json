[{"title":"白云山见五色雀","author":"李昴英","text":"罗浮禽五色，创见此山椒。\n锦羽嬉同坠，铁冠迁最乔。\n疑随仙驭过，喜趁白云招。\n贵客非关我，劳渠千里遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云登阁","author":"李昴英","text":"白云捧拥到危巅，杰阁翚飞倚半天。\n谷响颇疑吟木客，潮回坐见变桑田。\n几重山隔几重海，一日身闲一日仙。\n真乐无如会心处，林花野鸟亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示儿用许广文韵","author":"李昴英","text":"斐然狂简不知非，席帽何时免诮讥。\n官样词章惟典雅，心腔理义要深几。\n各随鹏鴳高低适，一笑鸡虫得失微。\n偶未成名儿勿恨，我方追悔蹈文闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘朔斋游蒲涧谒菊坡祠","author":"李昴英","text":"晓随丝辔饭僧坊，丞相祠堂一瓣香。\n试问神仙蒲九节，何如名德菊孤芳。\n高山仰止堪模楷，百世闻之尚激昂。\n我辈此来深有意，岂专泉石癖膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同刘朔斋游白云寺二首 其一","author":"李昴英","text":"冲暑登高人所惮，云韩龙孟乐相从。\n眼穷溟海九万里，身在蓬莱第一峰。\n潮长屿低帆势急，山回路曲树阴重。\n日斜移席临池饮，戏掬清泉解酒容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后峒月溪寺","author":"李昴英","text":"寺巧蟠山背，池圆印寺前。\n连筒泉落瓮，如镜地无砖。\n茗苦苛留客，僧淳懒说禅。\n使君期不至，一宿笑无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后峒月溪寺","author":"李昴英","text":"森森杉桧郁相缪，散策何妨逐胜游。\n梵宇庄严传浙样，碧池荡漾纳泉流。\n将军赢得山林在，衲子多因粥饭留。\n眼界虽云欠轩豁，晚凉宜酒且夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪事保林尉韵","author":"李昴英","text":"清晨风日辟群阴，一纸三熏上帝临。\n或者贪功频滑手，毅然奋笔特诛心。\n冤辞赖有由言折，圣世难施汉法沉。\n此举岂谋身祸福，祗怜无罪絷南音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西樵岩","author":"李昴英","text":"巨石卷阿驾半天，樵山风景岂虚传。\n水帘不捲四时雨，丹灶空凝万古烟。\n印石尚存乌利迹，问谁曾识紫姑仙。\n我来游遍登云谷，更借山僧半榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别陈霆","author":"李昴英","text":"政喜论文子遽归，扶胥之口访韩碑。\n吟篇佳处南游得，行李轻如始至时。\n石友秉心终可托，铁翁具眼远相期。\n勉旃办取兰闱捷，四六供官且放迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席和人韵送荃翁","author":"李昴英","text":"诗似油翁背注油，知音世有几荆州。\n乍寒乍暖方榆火，无米无钱只叶舟。\n客况可堪今老大，人生何必尽封侯。\n津亭且莫匆匆去，万斛春醪任拍浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮赴解试士友二首 其二","author":"李昴英","text":"少日谙场屋，斯文为细论。\n艰深成札闼，卑弱又西昆。\n与客为佳谶，当年是解元。\n贺诗多办取，盛事属于门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮赴解试士友二首 其一","author":"李昴英","text":"座满挺时髦，经明亦富豪。\n几年勤用志，三日健挥毫。\n笑取刀牛角，相逢酒蟹螯。\n有名还有分，秋鹗碧云高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和广帅宋自牧劝驾韵","author":"李昴英","text":"天将造榜放秋晴，南国新逢运会亨。\n障碍洞开来试者，计偕稳送上华京。\n主人况是梅花宋，寓客渐非日色程。\n面见河南已分晓，伫聆魁捷响仙城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和心字韵送林尉公琰校文","author":"李昴英","text":"鹄袍忙立老槐阴，争望文星早照临。\n称物衡无高下手，别形鉴有是非心。\n品题岂逐朱衣转，沙汰何妨苦海沉。\n将见贤书协舆论，真才到此遇知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建仓解归诗复徐意一二首 其二","author":"李昴英","text":"吏擎双印出，便觉此身轻。\n物我忘恩怨，渔樵寄姓名。\n笛声黄犊背，诗兴白鸥盟。\n故旧休相讶，无书到帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建仓解归诗复徐意一二首 其一","author":"李昴英","text":"恨未澄清尽，孤踪己不安。\n缪悠臣罪大，感激上恩宽。\n乡国三千里，人心百八盘。\n梦归今始验，为我谢言官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武夷观","author":"李昴英","text":"闲乘石罅船，又到浙江边。\n回向初心地，皈依古洞天。\n成丹呼鹤舞，喷酒起龙眠。\n雨意偏留客，杯茶定宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮飞云顶","author":"李昴英","text":"山行颇觉思悠然，游遍仙家几洞天。\n登见日亭风刮面，立飞云顶月齐肩。\n稚川翁有烧丹灶，景泰师留卓锡泉。\n我得真人金石诀，无求自可享长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮国醮","author":"李昴英","text":"霓氅蹁跹拜玉宸，发挥道德五千文。\n步虚夜半千山月，朝斗空中五色云。\n风雨若时昌国运，乾坤齐寿祝吾君。\n贤侯方寸精诚积，散作丰湖叶气薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮峒长宝谷王宁素送药瓢","author":"李昴英","text":"久矣深山炼鹤形，闻呼峒长又逃名。\n断崖怪木人稀迹，乱石奔泉涧有声。\n剑定通神收古匣，棋聊供玩戏纹枰。\n药瓢解赠宁无意，重到孤庵论养生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山飞来殿","author":"李昴英","text":"龙门凿破碧天池，呈佛高峰插翠微。\n对岸钟声犹隐耳，御风檐角尚如翚。\n二神择地非著相，双锡腾空向上机。\n此境世间如更有，安知古殿不重飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看僧披剃","author":"李昴英","text":"尔教言无相，谁教蜕发毛。\n虚名犹度牒，多事更方袍。\n父认师传的，年推戒腊高。\n冠巾何不可，只要断尘劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋试已近用韵勉儿辈","author":"李昴英","text":"邺轴轮囷数世藏，乃翁曾读被龙光。\n诗书有种芥拾紫，科举催人槐落黄。\n学到自然名盛大，文工更要理深长。\n岁当酉戌吾家旺，月府先教窦桂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"美广帅赵平斋拓贡院","author":"李昴英","text":"围棘千间手拓开，帅幢元是个中来。\n前峰卓卓尖如笔，正路堂堂稳踏槐。\n自此鹄袍容万士，浑然龙化出伦魁。\n南州尽说明年好，依旧科名得上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子先贤归南海","author":"李昴英","text":"束书相伴到江西，我尚濡留子遽归。\n轮角难生催别斝，刀头欲折为斑衣。\n功名有分须如意，学问无穷更造微。\n若到家林遇奴辈，先教拂拭钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广东宪陈均二首 其二","author":"李昴英","text":"我如越雪致狺狺，此事牵连亦到君。\n久矣浮名等蛮触，付之公论定莸薰。\n四知谁不推杨震，三已何曾损子文。\n甚欲一行陪祖帐，万山遥隔几重云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广东宪陈均二首 其一","author":"李昴英","text":"十五年间再绣衣，幡然一出浩然归。\n囹空但欲全人命，网打谁能避祸机。\n壬巧交攻邪害正，丁钱奏免是成非。\n离亭父老遮如堵，莫驻春江去棹飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶耆卿试太学","author":"李昴英","text":"背城赢一战，璧水是儒林。\n词赋八叉手，功名寸铁心。\n程兼驰数驿，学苦惜分阴。\n清献起庚戌，长风送捷音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送次儿解试","author":"李昴英","text":"四度笺名达帝聪，布衣便有此遭逢。\n吾家积庆为心印，一战收功在笔锋。\n举子头场关荐鹗，时文手段要屠龙。\n庭前手植森森桂，飞捷今秋好事重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张子元班见","author":"李昴英","text":"笑掇巍科是管君，等闲马上换京官。\n扶摇九万从今易，植立千年自古难。\n多办衣裘禦风雪，紧操维柁过泷滩。\n中朝知旧如相问，试把吟篇举似看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李尉兴龙之海丰任","author":"李昴英","text":"书味无穷得属厌，待瓜六载不辞淹。\n乃心雅欲亲诸老，初筮惟知守一廉。\n毋纵弯弓猎鸡犬，谨防暴客起鱼盐。\n同乡同姓钟情处，酌别中秋吸玉蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李路钤万入京","author":"李昴英","text":"运厄南州暴吏专，鹖冠却有好官员。\n捕猺怕损平人命，制锦尽除常例钱。\n枘凿一言辞辟郡，胸襟三略合筹边。\n景文匹马长相过，我愧才非玉局仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送连推黄端简赴班","author":"李昴英","text":"别我谷之盘，今谁似二难。\n西江诗种好，南斗剑光寒。\n千里依莲重，三年食檗安。\n头班人品称，春意暖征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈大雷试太学","author":"李昴英","text":"裹粮数千里，贾勇万人场。\n庾岭琴书去，桥门姓字香。\n有司应眼具，喜气已眉黄。\n践履宜天相，时文况所长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑雪屋归里","author":"李昴英","text":"征衣点落红，君去与春同。\n贫到归时见，吟多醉后工。\n不应冠尚鹖，自许气如虹。\n急著看山眼，飞帆吸快风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送荃翁张端义之惠阳","author":"李昴英","text":"吹面东风竖绿蓑，诗翁七十醉婆娑。\n放怀自号天随子，知我无如春梦婆。\n吟有小奚磨破砚，卧看赤脚踏行窝。\n太湖争似黄湾阔，高浪粘天独笑过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送恩平潜使君还里二首 其二","author":"李昴英","text":"五载南州屈重名，活人一段是归程。\n两州曾唤两苏起，孤节要师孤竹清。\n合有锋车催赴阙，不应画戟又专城。\n闲身已决深山底，千里犹能共月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送恩平潜使君还里二首 其一","author":"李昴英","text":"风流太守作春游，到处恩波浩荡流。\n怀绶故乡需上日，移舟别浦趁中秋。\n声歌洋溢行人口，书翰纵横健笔头。\n识面虽新心颇熟，殷勤话别送归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送都运陈炜以烦言去","author":"李昴英","text":"铁汉从来去就轻，当年乌府树风声。\n福星临分人安乐，浊世如泥志洁清。\n祠命忽传奸吏贺，归装绝少担夫惊。\n退庵本惬家林兴，父老攀辕却有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送族子春叟游西广","author":"李昴英","text":"凤出丹山定九苞，桂林要拣一枝巢。\n久闻岩窦须幽讨，不是豪人莫汎交。\n鹤发频将安问寄，萤窗勤把旧书抄。\n功名到底还坚志，崛起新丰一草茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舶使孙叔谐东归","author":"李昴英","text":"莼鲈高兴趁新秋，帆腹吞风涌去舟。\n万宝集登天子库，诸蛮遮泣海山楼。\n世间颠倒是非梦，达者逍遥得失侯。\n归到家林定重九，团栾杯酒菊花浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舶使周申","author":"李昴英","text":"堂堂山立旧朝簪，久屈清流督献琛。\n风赶连艘出狮国，浪吹残句到鸡林。\n平生不隔同年面，中岁难禁惜别心。\n归见耆英定相问，只言闭户万山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄提干赴班","author":"李昴英","text":"不枉金闺贮一贤，唱名重见冕旒前。\n省闱见说第三赋，选调犹迟十八年。\n据实语人南峤事，无多行李浙江船。\n壶山群彦官今紧，直谅如今合茹连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送循倅黄必昌之官","author":"李昴英","text":"好风佳月说龙川，人喜新来别乘贤。\n才尽优为千里式，学今有用四书全。\n黄门祠下挥吟笔，丞相岭头先著鞭。\n莫但俛眉衔纸尾，忍教田里苦颠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送湛师回罗浮花首山","author":"李昴英","text":"翩然拂袖忽然回，带得罗浮面目来。\n乞食又还双足茧，坐禅岂是寸心灰。\n故依花首从三靖，旋摘茶芽供一杯。\n兰若苦空君不厌，可能为我扫苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鉴师住灵洲寺","author":"李昴英","text":"少年芹泮也儒冠，底事缁袍染异端。\n孤岛一灯开佛屋，长身七尺占僧单。\n钟鸣鱼叩随缘过，棹舞鸥飞取次看。\n亭下听经鼋在否，石栏摇影碧波寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送演侄三首 其三","author":"李昴英","text":"一同休戚尉相关，肉食那容职旷瘝。\n验视难真防木刻，追擒易误戒弓弯。\n千寻树看萌芽始，万里行从跬步间。\n大抵穷通皆定分，炎门邪径莫跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送演侄三首 其二","author":"李昴英","text":"五常百行异其名，腔子源头一个诚。\n数马似愚宁过谨，悬鱼虽矫却真清。\n宽和爱众众同爱，骄倨轻人人所轻。\n诗好何如勋业好，旂常元不载诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送演侄三首 其一","author":"李昴英","text":"少年政要识艰难，受国恩深早一官。\n著力莫孤先世望，从头细把四书看。\n金兰益友真同志，菽水慈亲曲尽欢。\n学取老夫穷意思，免教人指裤繻纨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻褫阁职免新任之报二首 其二","author":"李昴英","text":"狂妄孤臣罪有馀，三年三度挂丹书。\n群儿过计愁郎罢，外物浮名总子虚。\n只是儒酸真面目，不题道号混樵渔。\n亲朋欲语浇教醉，休与时人定毁誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻褫阁职免新任之报二首 其一","author":"李昴英","text":"远民冤甚草菅芟，抗论公庭出至諴。\n且喜一方全性命，何妨三字减头衔。\n机关平地藏深阱，仕宦伶人视戏衫。\n五逊州符今免矣，幅巾藜杖可松杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭清远权宰楼海司法二首 其二","author":"李昴英","text":"百里称廉吏，谁欤起衅端。\n州符需赋急，军饷及期难。\n节义扶浇俗，朝廷赠大官。\n邑人崇庙像，犹似发冲冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭清远权宰楼海司法二首 其一","author":"李昴英","text":"谕贼散私财，冥顽不可回。\n愤然瞋目骂，吾已戴头来。\n一死当凶刃，千家免劫灰。\n遗孤元未有，行路为悲哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宴鸣佩亭和赵漕韵","author":"李昴英","text":"数尺飞泉漏隔城，寒岩坳处落琮琤。\n悬知胜境无尘到，却讶晴天作雨声。\n一歃不容贪者饮，两峰宜著醉翁行。\n此泉千载因人重，曾识光风霁月清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽右史方铁庵诗三首 其三","author":"李昴英","text":"纸钱森插竹，遗像在方桥。\n月暗甘棠密，风嘶韩木乔。\n所悲缘瘁国，于谊况同朝。\n凄断黄湾路，丹旌些莫招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽右史方铁庵诗三首 其二","author":"李昴英","text":"喜怒皆和气，天全一片春。\n眼高多识士，心直不疑人。\n称得深衣古，争传判笔神。\n恙微谈笑去，忽失玉璘珣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽右史方铁庵诗三首 其一","author":"李昴英","text":"一疏纲常重，端平起直声。\n难磨石宋璟，不动铁元城。\n前辈风流在，南州个信诚。\n精神兼学力，倾倒为遐氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽如老归真","author":"李昴英","text":"不见才三日，喧传已坐亡。\n平生功行到，垂绝偈言香。\n缘分无高刹，禅名却四方。\n开包残藁在，切勿放毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钝斋先生许象州三首 其三","author":"李昴英","text":"丈席即之温，终身佩一言。\n栋梁失安定，山斗惨韩门。\n恸矣心丧重，凄然手泽存。\n江声助悲些，莫返大夫魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钝斋先生许象州三首 其二","author":"李昴英","text":"义重人谁及，高风有古人。\n己田分友子，黎事保羁臣。\n抱负耕莘志，依稀陋巷仁。\n丹青遗像在，难写道心真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽钝斋先生许象州三首 其一","author":"李昴英","text":"家学存斋授，渊源自晦庵。\n魁文行海内，师道重天南。\n衔未冰条一，州才刀梦三。\n芳名却千载，俎豆拜祠龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赠竹隐李聘君","author":"李昴英","text":"圆沙有此隐君子，短褐枯筇自一丘。\n安乐窝中宽宇宙，逍遥游处眇公侯。\n逢人皆喜一无忤，于世何求百不忧。\n种德已深天必报，大儿玉立最清修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":61999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼花首湛长老二首 其二","author":"李昴英","text":"别我笑吟吟，罗浮愿力深。\n空拳糊众口，平地起丛林。\n山迥孤云没，溪寒片月沉。\n人今奇坐蜕，在日孰知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼花首湛长老二首 其一","author":"李昴英","text":"碧眸泓铁面，跣足衲悬鹑。\n数日蒲团定，一如泥塑人。\n施钱随散掷，忍辱已忘嗔。\n丁字何曾识，拈提话转新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]