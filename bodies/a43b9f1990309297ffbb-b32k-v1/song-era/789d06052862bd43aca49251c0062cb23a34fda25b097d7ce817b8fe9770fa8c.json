[{"title":"挽霞溪高县丞二首 其二","author":"裘万顷","text":"公家原在洪崖宅，自是洪崖向上人。\n嗜酒一生真简淡，风标八帙更精神。\n纷纷偶厌人间事，去去归寻洞里春。\n朱绂只今无觅处，但馀佳句镇长新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽霞溪高县丞二首 其一","author":"裘万顷","text":"少年挟策上金銮，三拜郎官鬓未斑。\n不说知音在霄汉，但知投老向云山。\n柳丝阴里陶潜乐，花锦香中潘岳闲。\n逝者不堪人事异，洪崖亭下水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留浅沙","author":"裘万顷","text":"故山岂不好，萧寺亦堪居。\n作意多成碍，无心始自如。\n钟鱼饱香积，枕簟熟华胥。\n但惜诗成后，旁无阿买书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读伯仁诗卷","author":"裘万顷","text":"忆昔从君渔钓时，小舟行遍楚江湄。\n僧房夜月琴三叠，客舍秋风酒一卮。\n别后相思梅折尽，书成欲寄雁来迟。\n蛩声惊觉寒窗梦，自起挑灯读旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘次孙教南韵","author":"裘万顷","text":"簿领归来得泮宫，一时衮衮任诸公。\n市朝竞逐利名走，草木谁为臭味同。\n霅水不妨披宿雾，蓬山正要挹清风。\n尘埃不得从君后，岂但他时愧两翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"裘万顷","text":"松径烦风扫，柴门为雨扃。\n行携道院集，坐对敬斋铭。\n好事心常记，闲谈耳不听。\n观空为时误，无异醉初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘择之新居成","author":"裘万顷","text":"西风吹雁过吾庐，特地传君一纸书。\n九载不须论旧事，万金良喜得新居。\n春回院落花侵座，雨过池塘水绕除。\n我欲退之门下去，却愁无处觅金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄高菊涧谢惠诗集","author":"裘万顷","text":"高名如斗夜垂天，无地追思每自怜。\n正欲为君寻五老，乃蒙因我到双泉。\n新诗妙绝閒方就，稚子携归喜欲颠。\n此去湖边不多远，秋风当觅钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题喻高士澹轩","author":"裘万顷","text":"世事邯郸枕，生涯老子书。\n能知澹中味，雅称竹间居。\n石径排云入，霜根带月锄。\n纷华不到眼，赢得玩清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚岁送馆人归省","author":"裘万顷","text":"不厌冰霜路，冲寒办一归。\n晨鸡戒鞍马，春酒寿庭闱。\n灯火知辛苦，云霄会奋飞。\n相期纡绿绶，非但戏斑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"裘万顷","text":"日落欲闭户，风清聊杖藜。\n千山犹带雨，一径已无泥。\n㶁㶁水声急，悠悠云影低。\n催归缘底事，著意旁人啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"裘万顷","text":"天花一夜泄春机，飞坠人间片片奇。\n有色有光欺柳絮，无声无臭点梅枝。\n纵横万舞风回处，表里双清月霁时。\n此景惟诗可摹写，却怜老去不工诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜范光伯相过","author":"裘万顷","text":"章江东下几湾洄，谁伴臞仙夜探梅。\n离别不禁诗社冷，遭逢莫放酒船回。\n冰霜满眼岁将换，花柳转头春又来。\n安得飞腾九霄外，鞭鸾笞凤日相陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起书怀时诸公相勉再出","author":"裘万顷","text":"北窗终日废书眠，一枕清风直万钱。\n云度茅檐轻冉冉，泉生石砌净涓涓。\n不嫌雨脚花间注，要听秋声屋外传。\n三径初成吾欲老，幕中何用泛红莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午上饶道中","author":"裘万顷","text":"一春留滞在京华，午日依前未到家。\n细葛香罗素无望，黄尘乌帽亦堪嗟。\n争舟野渡人如簇，立马邮亭日欲斜。\n遥想埙篪献亲寿，綵衣罗拜酌流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题小桃源","author":"裘万顷","text":"半月池边倚瘦藤，望仙台上岸乌巾。\n尘埃一点不到地，花木四时长是春。\n载酒岂无好事者，烂柯应有著棋人。\n请君更种桃千树，准拟渔郎来问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题怀秀堂","author":"裘万顷","text":"莫教满地长莓苔，杖屦从今日日来。\n曲径要随松巷转，柴门须对石桥开。\n墙头花木因时种，案上图书任意堆。\n幸有林泉可投老，忍将双脚踏尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题洪内翰爽榭","author":"裘万顷","text":"雾阁云窗天外安，悬知幽趣胜人间。\n帘栊夜月浮银海，桃李春风醉玉山。\n自笑红尘无暇日，浪凭清梦觅商颜。\n何如飞佩随君后，细看匡庐紫翠鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠画工","author":"裘万顷","text":"綵笔三生梦，春莲万叶花。\n笑人为市道，随分足生涯。\n山路净如水，溪流浅见沙。\n能来良不恶，看我傲烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙亥六月乡民祈雨寿春祠下嘉澍既降槁苗尽兴万口一辞颂神之德予喜聊成俚语以书祠壁","author":"裘万顷","text":"忧时曾上天庭疏，悯物今为旱岁霖。\n一夕风霆百川水，四郊香火万民心。\n山巅定有烟霞宅，夜半常闻钟磬音。\n傥许尘踪拜仙驭，愿营茅屋老云岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"裘万顷","text":"篱落黄花尚自无，白衣况未到吾庐。\n莫令此日负佳筛，为展渊明采菊图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入京道中风雨因赋此遂退休","author":"裘万顷","text":"新筑书堂壁未乾，马蹄催我上长安。\n儿时只道为官好，老去方知行路难。\n千里关山千里梦，一番风雨一番寒。\n何如静坐茅斋下，翠竹苍梧仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月大雨","author":"裘万顷","text":"一冬都无五日寒，赤日杲杲后土乾。\n水官丐归帝弗许，诘朝不雨吾戮汝。\n斯须便放大瓢倾，一洗万里尘埃清。\n不妨更作尺深雪，桑榆之功尚堪说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从人觅墨梅","author":"裘万顷","text":"熏炉束诗魂，茗碗驱睡思。\n掩关寂无营，翰墨自娱戏。\n山寒溪正清，月澹雪初霁。\n横斜两三枝，见说可人意。\n天机如胸中，出手特馀事。\n何时剪冰纨，来对病居士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见雪","author":"裘万顷","text":"玄冥当语谁，饷我一檐雪。\n吾庐本来静，得此更清绝。\n遥怜北海上，往往已盈尺。\n齧毡人在否，毋凌汉臣节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出门","author":"裘万顷","text":"出门复入门，吾行竟安之。\n携书北窗下，翻阅聊自怡。\n有怀千载人，掩卷还歔欷。\n采采首阳薇，恋恋商山芝。\n一裘或终身，欣然钓江湄。\n斯人不可作，斯道日湮微。\n目前稻梁谋，凫雁方齐飞。\n青田寂无音，岁晚将畴依。\n慎勿出门去，尘埃染人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再呈仲庸","author":"裘万顷","text":"芳枝莫遣风吹折，要看枝头千点雪。\n孤山畴昔盛开时，十里香飔飞不绝。\n蹇驴乌帽照霜颠，长吟竟日溪桥边。\n自从和靖收声后，一时翰墨归坡仙。\n只今往事飞鸿送，寂寞西湖投老梦。\n花开花落谩伤心，明月清湍谁与弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"厌原山中晓行","author":"裘万顷","text":"碧鸡夜半声啁哳，唤起幽人步林樾。\n秋高风露著群木，无数寒花泣明月。\n松篁一径宛如画，石溜涓涓更清绝。\n山巅便好结茅庐，莫待他年鬓成雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安乐窝示元德弟二首 其二","author":"裘万顷","text":"清泉出石窦，白云卧山窝。\n淋淫乍开霁，原野欢声多。\n吾庐近西峰，其下林婆娑。\n解衣坐磐石，持竿钓清波。\n主人忘机心，鸥鸟亦无他。\n东鲁与南郭，泰山等峨峨。\n周子何人哉，自许不啻过。\n一朝离草堂，山英遂横戈。\n折辕不得还，如此俗驾何。\n仰视前修翁，铅刀比太阿。\n予弟山林人，心平气自和。\n欢然乐箪瓢，笑彼荤膻罗。\n好书不厌观，佳句时一哦。\n烦赓紫芝曲，为我醉时歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安乐窝示元德弟二首 其一","author":"裘万顷","text":"往时病僧寮，今为安乐窝。\n昔病而今安，所得良已多。\n百年直须臾，一丘且婆娑。\n倦翼栖茂林，潜鳞渺重波。\n方欣随所愿，岂复知其他。\n朝来启南窗，群山郁嵯峨。\n上有无心云，乘风远相过。\n却观声利场，纷纷正横戈。\n到头蛮与触，胜负能几何。\n曷若休吾心，考槃依涧阿。\n孟夏草木繁，雨馀气清和。\n四壁环断碑，经史星宿罗。\n幅巾据胡床，翛然自吟哦。\n因之成此诗，要使儿童歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次许秀才韵二首 其二","author":"裘万顷","text":"拙工不量力，自谓中了了。\n高谈盖一座，众可己独否。\n斯须临斧斤，汗背血两手。\n旁观信善斲，莫肯告以道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次许秀才韵二首 其一","author":"裘万顷","text":"痴儿欲了事，事竟莫之了。\n崇朝弄朱墨，校勘是与否。\n徐观雁鹜行，大半落渠手。\n败群虽已去，考牧未有道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次伯仁善利阁小室韵","author":"裘万顷","text":"山林吾所庐，夜月但对影。\n焉知江上人，一日了万境。\n褰裳步崇台，有室妍且静。\n徘徊不能去，坐见四山暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次伯量赠别诗韵","author":"裘万顷","text":"我生既驽下，且复寡见闻。\n时时警其愚，姻党赖有君。\n自惭将且疲，不足张此军。\n君乃不我弃，欢然与同群。\n愿学如之何，此志亦已勤。\n正坐未知方，所得不足云。\n人生所好杂，其力用是分。\n词章末技耳，安能媲皇坟。\n而况字书学，兀兀纂说文。\n曷若鞭吾心，或有汗马勋。\n请益恨未能，别君大江濆。\n长吟昌黎诗，安得身登云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余主簿仲庸梅韵","author":"裘万顷","text":"春醪欲冰木欲折，急雨风吹不成雪。\n玉妃夜堕广寒宫，开作寒花赛清绝。\n未须千树插山巅，且要几枝横水边。\n暗香疏影尚无恙，凭谁唤起西湖仙。\n不妨琢句更驰送，一洗十年尘土梦。\n铁心元不为渠回，眼底珠玑聊簸弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴司理见贻二绝韵 其二","author":"裘万顷","text":"湛然胸次幸清明，忍看人间势利轻。\n我辈相知端有道，未应胶漆付雷陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次范光伯泛江韵","author":"裘万顷","text":"夫君陶阮徒，俗子所不快。\n屹然颓其中，特立盖甚介。\n平生江湖乐，欲去不得迈。\n何当从君游，渔钓寄吾解。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次黄存之韵","author":"裘万顷","text":"客宦何时了，官居又岁馀。\n归心五湖梦，病眼一床书。\n近作君能富，新功我略无。\n不妨赋游猎，会有荐相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯下偶次前韵","author":"裘万顷","text":"北风吹雨夜正寒，北窗吟诗舌欲乾。\n千辛万苦浪如许，饭颗山头谁著汝。\n何如一尊随意倾，酒酣不问浊与清。\n明朝纵有三尺雪，灞陵诗句无庸说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹斋述事","author":"裘万顷","text":"梦魂惊断渺难续，卧听竹里风泠泠。\n寒蛩争鸣绕四壁，缺月半堕横疏棂。\n平生细字发欲白，午夜短檠灯尚青。\n稻粱作计吾不愿，愿学沧海鸿飞冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老农叹","author":"裘万顷","text":"霜耕冰在趾，雨种泥没膝。\n旱魃忽为虐，耕种谩劳力。\n去年幸一稔，今岁免艰食。\n细听老农语，令我三叹息。\n但愿从此去，龙骨长挂壁。\n大田多黍稌，高廪若山积。\n或云谷大丰，则恐钱转啬。\n夏租星火急，处此未有策。\n细民一钱税，往往亦追索。\n谷贱反伤农，此语传自昔。\n语客且勿忧，新丝尚堪质。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自警","author":"裘万顷","text":"俗尘易污人，胸次须自洁。\n君看四明老，冰壶浸秋月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行役","author":"裘万顷","text":"宿雾锁山椒，落月挂林侧。\n崎岖历冈峦，彷佛辨阡陌。\n秋高风露寒，道远时序迫。\n安得归故园，篝灯理书册。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别友","author":"裘万顷","text":"清宵月满梁，相思几搔首。\n不图尘土中，得共一尊酒。\n人事好乖甚，随复而分手。\n惟有管鲍心，明明若箕斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐荐福寺次王成之韵","author":"裘万顷","text":"鞭鸾未暇相追逐，且向祇园止君宿。\n清谈待得月华生，窗户明明耿残烛。\n谁令泉石堕吾前，洗净人间丝与竹。\n风帆明发君不留，此乐只应吾所独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武阳渡","author":"裘万顷","text":"一舟小如叶，横在波涛中。\n纷纷川上人，欲渡愁北风。\n有帆天际来，渐近葭苇丛。\n寄声与问讯，恐是陶朱公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗溪桥","author":"裘万顷","text":"我来从西昌，日日困尘土。\n谁知罗溪桥，净若初过雨。\n长松列左右，清风奏宫羽。\n薄暮舍篮舆，扁舟渡溪去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其七","author":"裘万顷","text":"君姿正而刚，名节非所欠。\n临歧赠一言，惟有学不厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其三","author":"裘万顷","text":"考亭无恙时，从游孰非贤。\n岁寒万木彫，松柏始杰然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其四","author":"裘万顷","text":"圣贤去我远，何者名事业。\n吾欲到彼岸，须君借舟楫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其五","author":"裘万顷","text":"过从资直谅，夫岂势利交。\n谓朋党者谁，仁人姑听教。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咨咨草根虫","author":"裘万顷","text":"咨咨草根虫，瑟瑟叶上雨。\n休休退食人，落落谁与语。\n陈编竟日披，陋室随时处。\n此心苟自乐，贫贱亦得所。\n夷齐虽饿死，清风冠千古。\n颜子瓢屡空，宣父极称许。\n但当守吾仁，晋楚何足数。\n试看松与柏，矫矫傲寒暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋试示诸儿","author":"裘万顷","text":"漠漠轻云弄寒影，霏霏小雨生秋兴。\n黄槐开尽举子心，丹桂喜传仙籍信。\n竹斋双手缩袖间，坐看群儿鏖一战。\n春风跃马不为难，此去毋言日边远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荣侄试周","author":"裘万顷","text":"汝生方满岁，伯发已星星。\n桑苧甘投老，兰荪喜向荣。\n席间无一印，帷下有诸经。\n莫学鱼儿戏，来年快聚萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚁运","author":"裘万顷","text":"知战不能损，檀氏所以亡。\n吾愧与敌槐，将何固封疆。\n及此閒暇时，相与积乃仓。\n不须更他骛，富国兵自强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范光伯北行","author":"裘万顷","text":"玄冥将归休，勾芒已促装。\n江边疏柳青，江上寒梅香。\n有客当此时，中流驾风樯。\n欲学太史公，穷汶泗沅湘。\n吾闻帝王州，雄丽几钱塘。\n畴昔驻六龙，至今绘未央。\n鹭洲横渺瀰，凤台摩青苍。\n名山与大川，往往遥相望。\n是间或小留，不妨月徜徉。\n平生学屠龙，袖手五字章。\n兹逢贤主人，定知奏宫商。\n追李逐杜陵，相与升其堂。\n要令千万篇，金薤垂琳琅。\n秋风鸿雁来，因之东南翔。\n写君磊磈胸，慰我离别肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诗僧如师西游","author":"裘万顷","text":"乡来诗坛上，权可声籍籍。\n君虽后两翁，而已分半席。\n主人龙门高，宜有如此客。\n横行翰墨场，往往一当百。\n挟是今西游，吐谈取双璧。\n要须早归来，成就法王宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中闻伯量相访寄之二首 其二","author":"裘万顷","text":"高人在城郭，应酬颇纷如。\n忆我烟霞栖，遗我一纸书。\n雨馀窗户凉，蛩声满阶除。\n相过有成言，何时命巾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中闻伯量相访寄之二首 其一","author":"裘万顷","text":"我屋修竹根，身閒境逾静。\n维摩本无心，谁令示人病。\n夕阳耿疏林，影落莓苔径。\n伫立有所怀，高人傥乘兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读邸报","author":"裘万顷","text":"纷纷天下事，翻覆良难期。\n不知窈冥中，主张者云谁。\n工拙判两涂，人谋岂容施。\n得非欲平治，机缄遂潜移。\n目前三四公，并用无一遗。\n毋嫌滞一州，民实邦之基。\n乡来番江头，亲见国子师。\n德行渊与骞，千载如同时。\n斯人使临民，儿不赖母慈。\n人言致泰和，须索登皋夔。\n位崇泽斯均，否则失所宜。\n天乎傥人从，何时可臻兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘别吴长文司理","author":"裘万顷","text":"同心而异乡，既见复轻别。\n岂终无会期，南北渺难必。\n邮亭君与我，强饭再三说。\n此意非不领，欲话声已咽。\n肩舆使前驱，分手大江侧。\n升高辄回首，犹拟望颜色。\n予家古南州，胜友固不乏。\n如君相知深，千百未见一。\n君才十倍我，君德更刚直。\n赠行诗满纸，字字良有益。\n谁与趣我去，胡不缓旬浃。\n噬脐怅弗及，写心寄愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿田家竹亭","author":"裘万顷","text":"我家西山巅，四壁皆此君。\n朅来事奔驰，日与茅苇亲。\n方思坡仙诗，恐入俗士群。\n止我宿者谁，此君满其门。\n颀然千百夫，一见若故人。\n夜深清风来，好音梦中闻。\n呼童启北窗，为渠炷炉芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]