[{"title":"和杨公维二首 其一","author":"廖行之","text":"子云家无儋石储，日有载酒过门闾。\n道丰泽衍今甫大，天理报施宁欺予。\n我惭投李得珍贶，俗眼快睹真璠玙。\n何当急走问奇字，报语姑以先勤渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗四首 其四","author":"廖行之","text":"满袖风埃季子裘，谁怜斗粟漫淹留。\n栖迟岁月浑闲事，放浪湖山得胜游。\n一律任渠从滥吹，数杯容我且浇愁。\n祗应好在平生志，更上陈登百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗四首 其三","author":"廖行之","text":"平生湖海敝貂裘，一笑周南底滞留。\n豪放不妨诗李白，峥嵘何意吏朱游。\n悠悠世上难穷事，落落胸中肯著愁。\n高兴横秋浑不浅，月明还上武昌楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗四首 其二","author":"廖行之","text":"白云飞处祝融墟，心切平安一纸书。\n浪走毛生惭捧檄，清贫羊续漫悬鱼。\n银蟾浮彩秋尤好，金粟含香桂欲舒。\n指日安舆奉颜色，綵衣容与戏庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和松坡刘迂诗四首 其一","author":"廖行之","text":"新凉凭雨入郊墟，却置诗书困简书。\n顾我尘埃随野马，今谁风味忆鲈鱼。\n可能三釜从吾好，且放双眉满意舒。\n剩买一尊浇礧磈，从他㶁㶁水鸣除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望从人觅酒二首 其二","author":"廖行之","text":"春愁满眼久驱除，懒问生涯念及孥。\n但得论文留客醉，不妨问字到山居。\n寒收冻面应浮蚁，暖入芳腴可泛酥。\n便欲呼儿洗杯酌，陶然应许及波馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和武公望从人觅酒二首 其一","author":"廖行之","text":"野店醪香尚带烟，中山酝久漫经年。\n公营恶草安吾分，太白高吟羡子先。\n好办一尊常对月，谁能百斛更浮川。\n正须浇我谈天口，富贵浮云且任缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和罗舜举 其一","author":"廖行之","text":"岸岸花飞客思浓，拍空烟水与天东。\n暮云横岭依依碧，朝日翻波衮衮红。\n鸥共忘机元自适，鼍犹鸣鼓定谁攻。\n凭栏万里危楼望，愁绝江南一笛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和罗舜举三首舜举梦中得腊酒催诗处春幡剪綵时二句足成四韵属余和之 其三","author":"廖行之","text":"世无良乐久，骥足谩驱驰。\n尚喜心无愧，渠忧人未知。\n尘埃浑眯目，魂梦识佳时。\n好在张仪舌，男儿讵可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和罗舜举三首舜举梦中得腊酒催诗处春幡剪綵时二句足成四韵属余和之 其一","author":"廖行之","text":"世态醯鸡舞，尘缘野马驰。\n眼中惟俗物，梦里是真知。\n綵笔神传夜，春池句得时。\n渠侬未应愧，百世与风期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和罗舜举三首舜举梦中得腊酒催诗处春幡剪綵时二句足成四韵属余和之 其二","author":"廖行之","text":"日月游驹迅，光阴激箭驰。\n自应怜未遇，谁解语先知。\n消息春来好，功名梦到时。\n更凭询造物，无作戏人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前韵 其一","author":"廖行之","text":"有赋为招隐，无文可送穷。\n郢歌应寡和，齐瑟自难工。\n好在南山雾，高眠北牖风。\n此心奚所得，要与古人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和前韵 其二","author":"廖行之","text":"久雨送春晚，倦游怜客穷。\n不因人事谬，安得诗篇工。\n莺语唤昨梦，鸡声惊晓风。\n此时无好句，愁绝有谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春游三首 其三","author":"廖行之","text":"雨馀迟日放晴天，春入园林点化仙。\n为约奚囊行秀野，更看花岛媚清川。\n杖头买醉多踰百，笑里挥金知几千。\n一段清狂谁会得，谩将高兴付诗传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春游三首 其二","author":"廖行之","text":"寻胜遨游且乐天，楚狂应是地行仙。\n一年最好春三月，到处那能花满川。\n梦泽诗肠吞八九，河沙醉境渺三千。\n眼中况有江皋佩，应作潇湘胜会传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春游三首 其一","author":"廖行之","text":"骀荡融和二月天，邀朋同是饮中仙。\n试将拄杖踏芳草，更看兰舟航野川。\n酒兴偿花聊复一，诗篇贾勇或相千。\n何妨日日寻春去，醉把赓酬授简传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春睡","author":"廖行之","text":"持底赏春晴，清眠自爽魂。\n据梧销白日，高枕未黄昏。\n蝴蝶飞何乐，华胥梦可温。\n周公应不远，心事得深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和家字韵呈同社诸公","author":"廖行之","text":"平生四海鲁东家，貌敬谁能礼有加。\n试问离歌谈狗曲，何如艳曲唱山茶。\n广平似铁诗犹好，河内闻箴喜更誇。\n惟有谪仙堪痛饮，世间佳处乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其六","author":"廖行之","text":"胸中涵万象，江上漫怡情。\n突兀飞华屋，依微出化城。\n所欣逢岁有，此意乐时平。\n登览多新句，何须马槊横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其五","author":"廖行之","text":"底事及幽冥，仁人恻隐情。\n怜渠犹旅骴，为尔返乡城。\n泚颡人应化，分香讼亦平。\n存亡俱惠泽，高义与云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其四","author":"廖行之","text":"世治不忘兵，公深爱国情。\n雄张新汉壁，势压旧吴城。\n夜月鸣笳肃，秋风列燧平。\n农耕浑自适，是处亩从横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其三","author":"廖行之","text":"驭吏胡为术，临民若用情。\n两难诚具美，双璧重连城。\n威爱无偏举，权衡自适平。\n吏忠民更乐，协气日流横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其二","author":"廖行之","text":"食黮从吾化，安舆本若情。\n有能奔晋盗，何用筑秦城。\n一邑诚天幸，三年赖政平。\n儒功固如许，仪舌漫纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和益阳赵宰六首 其一","author":"廖行之","text":"为邦何所急，劝学最留情。\n数仞新儒馆，千年继武城。\n梁间珍篆古，门外碧波平。\n会有明伦士，培风纵鹗横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晚菊三首 其三","author":"廖行之","text":"荒凉篱落露华清，菊为重阳特地荣。\n奔竞斗心知戒在，疏迟懒性习闲成。\n偿秋为子添秋兴，见晚知谁恨晚英。\n赖有南山陪旧望，悠然目极与云平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晚菊三首 其二","author":"廖行之","text":"何事秋光老更清，故应有菊占秋荣。\n后来汉陛知薪积，晚出商山叹翼成。\n三径惟将松比操，东篱那为酒含英。\n纷纷红紫随时好，臆对西风诉不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晚菊三首 其一","author":"廖行之","text":"羁寓穷秋几许清，晚芳犹尔亦何荣。\n东篱旧岂论馀子，三径今应愧老成。\n气味耐堪供饮兴，登临那得厕群英。\n节华要是丈人行，俗眼谁知省屈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾知运寄兄诗二首 其二","author":"廖行之","text":"忠孝蝉联萃一门，雁行相望款天阍。\n青云有弟先行志，蓝绶今兄亦拜恩。\n肘印一时饶季子，风雩千载见诸孙。\n二难金玉交辉映，出处相高德义尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾知运寄兄诗二首 其一","author":"廖行之","text":"得丧区区指屈伸，褰裳归去楚江滨。\n莼鲈到底秋风美，牛斗依然夜气新。\n满壑烟霜供啸傲，传家诗礼照清贫。\n不须变姓吴门隐，自有相从化鹤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游归来园韵 其二","author":"廖行之","text":"簿书丛里厌纷埃，夙驾輶轩此地来。\n好是板舆将母乐，不妨樽酒为花开。\n难拚胜赏哦诗适，生怕严城打鼓催。\n明日江头还眺望，松风阁上几徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和游归来园韵 其一","author":"廖行之","text":"咄咄柴桑久卜邻，轩轩少室竟何人。\n一丘奇兴心犹远，千古论交迹未陈。\n奋锸自随天地阔，园林好在岁时新。\n东风相逐经行处，花草禽鱼不计春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宜春道中","author":"廖行之","text":"路转溪回几曲村，溪头流水去浑浑。\n农忙野叟朝耕陇，蚕老人家昼掩门。\n游子漫怜春色晚，故园应想绿阴繁。\n归欤屈指无多日，夜雨团栾酒一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"觅酒于宋伯潜","author":"廖行之","text":"典衣无策渐朝衫，早计君毋笑拊骖。\n未辨墙头仍瓮下，空哦斗北与箕南。\n蒲萄不作凉州想，庚癸犹酬褐父谈。\n折简更招花下饮，可能离坐亦容参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中有怀 其二","author":"廖行之","text":"春色无多日，匆匆度七旬。\n驱驰游子态，萧索旅中贫。\n酒薄愁那减，诗穷句转新。\n谁能念牢落，涸辙有枯鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中有怀 其一","author":"廖行之","text":"客里春三月，江头雨半旬。\n囊空那得醉，吟苦未甘贫。\n愁逐花枝老，诗随节物新。\n郴流去湘水，欲此寄双鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪","author":"廖行之","text":"腊尾春风不著忙，雪花先压百花香。\n试为天上玉妃舞，欲遣人间越犬狂。\n万里冰壶尘不染，一番琼圃日初长。\n东皇喜作吾翁瑞，又报丰年到酉阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜读书示谦 其一","author":"廖行之","text":"百年诗种世科存，三载相望两拜恩。\n主簿从渠称大小，儒冠喜我到儿孙。\n立身正要先忠孝，力学尤须造本原。\n老矣寸阴犹共惜，日新期汝大吾门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送长兄赴调上都次田俊卿韵二首 其二","author":"廖行之","text":"从今日日听新除，去马加鞭不用徐。\n最是好为三釜计，不妨频寄万金书。\n君行霄汉无留轫，我得江湖欲纵鱼。\n更念起家人底事，百年门户正关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送长兄赴调上都次田俊卿韵二首 其一","author":"廖行之","text":"霜熟林空月满川，冲寒突兀耸诗肩。\n便应策骥行夷路，不用燃犀照碧渊。\n从昔正人终遇世，到今方士漫求仙。\n老成谋国须吾辈，可笑轻疏贾少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送乐贡父赴书馆","author":"廖行之","text":"秀出书堂隽有声，又携琴剑主文盟。\n师承自得春秋学，经行俱高月旦评。\n援缴解令专志虑，窥园那肯乱精明。\n安昌异日多成就，何止从宣一二名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送许兄还侍兼简广南监场二首 其二","author":"廖行之","text":"旧游历历记湟川，南下番禺稳可沿。\n知有文星冲斗去，遥怜海水绕城边。\n而今五岭多宜客，见说群卿剩好贤。\n问讯夫君聊吏隐，云胡三月未官迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送许兄还侍兼简广南监场二首 其一","author":"廖行之","text":"君家畴昔汝南龙，渊有骊珠自不穷。\n黄卷乃翁廉取位，碧梧之子秀参空。\n儒冠底误资身术，盐筴聊成富国功。\n莫倚沃饶云近盬，图南九万看抟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送伯华醉归不寐又用韵杂言二首 其二","author":"廖行之","text":"休论决处甚防川，刚道呼来不上船。\n正使涓流鸣㶁㶁，终然脩竹净娟娟。\n浮沈与世鱼潜跃，清浊从渠酒圣贤。\n富贵功名皆自有，可怜邀月问青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送伯华醉归不寐又用韵杂言二首 其一","author":"廖行之","text":"十幅风蒲下碧川，别怀何惜醉金船。\n娄公正遣江流稳，庾老宁辜月影娟。\n善世如君皆夙望，泽民应我愧前贤。\n荣华莫美城南杜，早晚还亲尺五天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感事怀人送春病酒晓起五首 其三 送春","author":"刘学箕","text":"煮酝青梅且共尝，游蜂飞蝶为谁忙。\n鞦韆綵索迷青草，车马红桥锁绿杨。\n春事战回蒲剑老，诗肠结尽柳丝长。\n韶光赋别休匆遽，凝伫东风更一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄尉解官因简黄德亨 其一","author":"廖行之","text":"夫君解纽去通泉，十幅风帆下碧川。\n宝剑诗成光射斗，扶摇路稳翼垂天。\n湖山桂老乘秋兴，越水梅开近日边。\n丹扆须贤方侧席，会听鸣履上星躔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄尉解官因简黄德亨 其二","author":"廖行之","text":"平生饱听无双誉，一见全胜得异书。\n妙语从君闻梗概，清尊酌我更踌躇。\n希踪伯氏情何限，惜别吾曹意有馀。\n若见滁州新博士，为言湘水愧污渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鲍判官解官归浙西","author":"廖行之","text":"蚤行吴越得清名，岁久湘中始识君。\n人物自堪交仲父，才华端可继参军。\n一州从事曾游刃，万里封侯好策勋。\n江上今朝话离别，西风吹起楚天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九后菊","author":"廖行之","text":"寂寞东篱几夕霜，不堪憔悴逐炎凉。\n谁知璞玉浑金态，尽作红尘紫陌妆。\n流液尚能甘水味，返魂应付与梅香。\n来年莫落秋深后，好趁登高入酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九道中怀长兄二首 其二","author":"廖行之","text":"追欢那复少年时，老骥如今亦受羁。\n白发惊人风落帽，黄花伴我岁寒枝。\n谁能寻胜过元亮，自叹知音失子期。\n点检胸中犹礧磈，强倾浊酒自哦诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九道中怀长兄二首 其一","author":"廖行之","text":"客里匆匆饱岁时，今谁能免利名羁。\n有人骑鹤去千岁，顾我巢林方一枝。\n后日空怀棠杕燕，经年惭愧菊花期。\n白云飞处湘天碧，心在南陔日咏诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食菜作二首 其二","author":"廖行之","text":"春来日膳菜数本，绝胜杖头携百钱。\n但得园蔬非馑岁，肯令午梦搅清眠。\n食芹有美吾思献，采菲无遗利可专。\n莫笑先生长诳腹，解吟朝日照盘萹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食菜作二首 其一","author":"廖行之","text":"吾儒不羡能方丈，彼相胡为食万钱。\n谁识春来有珍味，乐如疏食曲肱眠。\n园中菜把勤能致，曹掾莼羹美未专。\n便作远谋胜肉食，他年无愧作诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唁陈颐刚颐大二兄","author":"廖行之","text":"陈子吾为友，别来今甫春。\n孔庭歌坏木，窦树失灵椿。\n谁谓有馀庆，几成无告民。\n天涯一携手，涕出为悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽王倅","author":"廖行之","text":"政最方贤躅，公心得事情。\n江湖多抚字，秦蜀佐廉平。\n族处欢群从，乡评叹老成。\n西风非宰木，犹记手经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽邓知县友龙 其二","author":"廖行之","text":"别向巴丘去，归从浙水来。\n绝怜三益友，高卧九泉台。\n清会成陈迹，明时失茂才。\n无因陪祖奠，风壑寄馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽邓知县友龙 其一","author":"廖行之","text":"文撼湘南国，才高月旦评。\n弟兄皆吏计，父子擅科名。\n綵服欢初浃，黄粱梦不惊。\n伤心见零落，埋玉闭佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽邓彦霄 其二","author":"廖行之","text":"仲氏怀联璧，慈亲念倚闾。\n官迁身未享，子少室无储。\n不料全家望，真成一梦虚。\n生材悭子寿，天意竟何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽邓彦霄 其一","author":"廖行之","text":"秀整文明早，精明吏事优。\n联登年正妙，再转誉弥休。\n方展云衢步，俄惊夜壑舟。\n平生如此友，零落向山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽军器监簿周公子及 其一","author":"廖行之","text":"人物丹丘秀，才华迈选优。\n青藜行照坐，白玉遽成楼。\n数不登知命，言犹见告猷。\n词林根柢在，三凤看鸣啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽军器监簿周公子及 其二","author":"廖行之","text":"一经同雁塔，再入并鸳行。\n方喜为寮好，那知梦奠伤。\n学多应损寿，文富幸流芳。\n有士奇如此，云溪奈閟藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘主簿令二首 其二","author":"廖行之","text":"投檄巴陵本为亲，迟留方拟问通津。\n一官粗报平生志，万里俄倾未老身。\n里棘岂堪栖凤驻，冢花重叹卧麟新。\n我惭李汉无才望，敢效韩编作序人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘主簿令二首 其一","author":"廖行之","text":"雁行场屋久联翩，赋客终为桂籍仙。\n鸾诰已封慈母贵，鲤庭仍见世科传。\n转头生死归何地，反掌荣枯欲问天。\n贱子门阑方有托，惊嗟梁木忽先颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘知府乘","author":"廖行之","text":"辛苦平生学，儒科志稍酬。\n路遥车折轴，夜半壑亡舟。\n士惜鸰原尽，亲悲鹤发留。\n传家幸有子，门户可无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":27520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]