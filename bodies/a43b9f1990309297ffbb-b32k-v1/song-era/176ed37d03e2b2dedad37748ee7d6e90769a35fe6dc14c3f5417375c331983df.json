[{"title":"次吴说避地白岩山中书怀韵","author":"邓仁宪","text":"避地南来极，吾乡北斗边。\n风尘今阻隔，途路旧迍邅。\n闾里千门盛，湖山百卉鲜。\n故乡归未得，飞梦入青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜韵 其二","author":"邓仁宪","text":"五星不循轨，征战未应休。\n妇叹怀空室，鹤鸣增旧愁。\n刘公三见顾，诸葛万机投。\n四海今多病，维摩分外忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜韵 其一","author":"邓仁宪","text":"狎鸥东海上，结友竹林贤。\n国难知谁救，途穷祇自怜。\n空花迷眼界，秋月契心禅。\n未起归欤兴，重寻载酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜韵 其三","author":"邓仁宪","text":"明月杖头挂，啸歌沧海边。\n自闻狮子吼，尽吐野狐涎。\n酒兴如流水，诗情似直弦。\n岩花应未老，更上白云巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀑布泉","author":"邓仁宪","text":"鲛人对泣号且呼，洒落瀛洲万斛珠。\n海神知贵不敢受，天池泻下扶焦枯。\n初疑素霓随银汉，尽似明月投冰壶。\n庐山瀑布几千丈，较此不可分锱铢。\n胶西先生春睡足，喜见晴光漱寒玉。\n武陵迷路初不知，错认松风响岩谷。\n金波满泛琉璃钟，长揖云峰谢拘束。\n更约青莲社里人，同向苍崖结茆屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试笺","author":"邓允端","text":"拨开宿火起炉烟，留得馀香伴夜禅。\n落尽碧桃春不管，东风却放柳飞绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴","author":"邓允端","text":"轻烟漠漠锁晴岚，野水溪边小驻骖。\n日暮征鸿落何处，似将风景过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣兴","author":"邓允端","text":"得志心偏壮，谋生事转疏。\n雨蓑春种药，月案夜抄书。\n穷达虽同道，功名不定居。\n凭谁报消息，为问近何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题社友诗稿","author":"邓允端","text":"诗里玄机海样深，散于章句敛于心。\n会时要似庖丁刃，妙处应同靖节琴。\n韵胜想君言外得，字新令我意边寻。\n痴人说梦终难信，何日樽前取次吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府","author":"邓允端","text":"梧桐叶落秋容早，夜夜寒蛩泣衰草。\n凤钗金冷鬓云凋，可惜红颜镜中老。\n音尘望断沈双鲤，唤起相思何日已。\n琐窗人静月轮孤，六曲屏山冷如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过处士山斋","author":"邓允端","text":"一室萧疏甚，禅床印佛宗。\n树阴生石藓，茶鼎带松风。\n去去水千里，行行山几重。\n佩琴与诗卷，回首翠微中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"邓允端","text":"楚岸卸轻帆，停舟曲江曲。\n日暮塞鸿归，春水平桥绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涉江采芙蓉","author":"邓允端","text":"涉江采芙蓉，欲采寄所思。\n所思今何在，望断天一涯。\n将花照秋水，秋水清且漪。\n行乐不得再，日暮空凄悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵秋晓","author":"邓元奎","text":"文星陨向凤台城，凶讣传来验奠楹。\n天若假年加富贵，人生梦枕做功名。\n谪仙诗在晚唐重，坡老身亡两蜀轻。\n豪迈如今存者几，惜乎吾道重伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄衣","author":"邓氏","text":"欲寄寒衣上帝都，连宵裁剪眼模糊。\n可怜宽窄无人试，泪逐西风洒去途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御风亭","author":"邓仲倚","text":"饮醉归时户欲扃，烟喧栖鸟噪荒荆。\n飘飖万里鹏程远，缥缈三山鹤驾轻。\n秋树凉生空过鹢，暮云光动海翻鲸。\n酒徒他日如相问，为拂尘埃看姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉山道上","author":"邓有功","text":"玉溪溪上雨声乾，日暮东风客衲寒。\n数树梅花吹作雪，行人犹自倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客信丰寄刘起潜 其二","author":"邓有功","text":"鱼苗客子去成群，野笑狂歌慢慢行。\n三十里头齐顿住，闻官早过吉州城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客信丰寄刘起潜 其三","author":"邓有功","text":"锦衣戍卒竖霜矛，弹压盐丁过岭头。\n三月闻韶堪叹息，南中还是一年忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客信丰寄刘起潜 其四","author":"邓有功","text":"岭南咫尺莫如虔，和暖严寒别有天。\n一夜诗魂清到骨，晓霜封却钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客信丰寄刘起潜 其一","author":"邓有功","text":"怪得寒灯昨夜花，五更归梦倏还家。\n多情儿女伤离别，争挽征衫问鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺刘掞赴召史馆校勘","author":"邓有功","text":"秋堂风露声唔咿，青灯一点昏两眵。\n蟫鱼蠹纸老白日，未识心宇包黄羲。\n麟胶饮尽霜兔泣，俪花斗叶纷奇姿。\n少年轻裘舌秦衍，睥睨六印京尘缁。\n平生眼底厌糠秕，自对春风乐沂水。\n搜奇抉怪问子云，载酒归来成独醉。\n金刀喜有南邻翁，曾吹藜焰丹霞峰。\n白云满榻呼不起，斜日倚仗酣秋空。\n紫皇一夕下纶旨，细祓丹铅勘文字。\n会将一语赞阳秋，高入九天卑九地。\n圣明勋业琬琰储，不独焜耀冰衔书。\n两朝蒐辑摩日月，往往呼喝羞庭衢。\n庐陵健笔人莫赎，南丰瓣香竟谁续。\n西江浩浩流古今，莫遣白头愧青竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曾子华游赣","author":"邓有功","text":"丈夫达有遇，出令走千里。\n焚香玩太空，宴坐尘不起。\n云胡子曾子，不自乐沂水。\n风烟挟两袖，足跟尚芒履。\n持被直承明，三省良未已。\n观君气如虹，接淅亦可美。\n昔年子长游，落笔妙信史。\n三苏出岷峨，文章仰欧子。\n此行崆峒岭，万事宁足侈。\n郁孤有奇观，佳句公摩洗。\n予生事斗室，出若畏澜蠡。\n长安歌狭邪，神鼎铸螭魅。\n穷通匪同途，动静实一理。\n时止复时行，愿与参此义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"选冠子","author":"邓有功","text":"燕蹴飞红，莺迁新绿，几阵晚来风急。\n谢家池馆，金谷园林，还又把春虚掷。\n年时恨雨愁云，物换星移，有谁曾忆。\n把一尊试酹，落花芳草，总成尘迹。\n频自笑、流浪孤萍，沾泥弱絮，有底困春无力。\n银屏香暖，宝簟波寒，又负月明今夕。\n往事梦里，沈思惟有罗襟，泪痕犹湿。\n奈垂杨万缕，不系西风白日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"邓有功","text":"卷上珠帘，晚来一阵东风恶。\n客怀萧索。\n看尽残花落。\n自把银瓶，买酒成孤酌。\n伤漂泊。\n知音难托。\n闷倚阑干角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舫斋","author":"邓朴","text":"闷闷之暑不可耐，走马来寻灵迹怪。\n山深树老龙屈蟠，洞阔云寒鼠飞败。\n崭然角立九关锁，势铄晴空生险隘。\n流泉奔荡一声雷，倒擘悬崖舞澎湃。\n上岩拖下水晶帘，下岩击碎琉瓈派。\n天风吹作六月寒，辟易精神心胆快。\n宜搜得此天下奇，恍然坐我神仙界。\n虽与金樽映翠杓，亦有山肴供晚嘬。\n解衣磅礴舞翠阁，笔端写作诗中画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"邓伯秀","text":"在我时舒卷，从他自去留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟享仰瞻圣驾","author":"邓克中","text":"辇路春风锦绣张，裁红剪绿斗芬芳。\n黄罗伞底瞻天表，万叠明霞捧太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游道岩观 其二","author":"邓希恕","text":"石敲新火煮云腴，细讲濂溪太极图。\n此去不知千载后，有人来讲此图无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游道岩观 其一","author":"邓希恕","text":"乘云不到玉皇家，岩上仙桃几度花。\n今日喜偕三益友，看来丹灶炼黄芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"邓希恕","text":"龟鹤与群同寿隽，貂蝉相映半时贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"邓远举","text":"翠云卧石千岩冷，黄叶呼风万里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 丹霞峰","author":"邓宗度","text":"绮段堆青壁，点缀秋颜色。\n几使晓来风，纵横裁不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 石门峰","author":"邓宗度","text":"暮云无意锁，春草岂能关。\n何事栖霞客，从兹去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 石床峰","author":"邓宗度","text":"原非人力建，造化琢磨成。\n一枕游仙梦，蟾波白昼生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 桃花峰","author":"邓宗度","text":"刘阮辞世尘，桃花谁复主。\n无计殢春风，一夜零红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 祥符寺","author":"邓宗度","text":"云水最饶处，轮蹄无到时。\n夜蟾生佛面，春雪印僧眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 滴水岩","author":"邓宗度","text":"石壁碎寒流，行人暮已愁。\n更倾风月耳，无水不生秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山杂咏 苍豹","author":"邓宗度","text":"却隐他山雾，来眠此洞云。\n区区麛鹿辈，战栗敢子群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与文潜无咎对榻夜话达旦","author":"邓忠臣","text":"书窗灯火夜深明，窗外萧萧雨叶声。\n对榻不眠谈往事，紞如五鼓过严城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小诗戏无咎","author":"邓忠臣","text":"文书盈几法筵埋，香火秋来愿稍乖。\n得似鹿门携手去，定随绣佛镇长斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已未年春与伯时较试南宫同年被命者六人今兹西馆唯同伯时一人而已因书奉呈","author":"邓忠臣","text":"十载京师五校文，并游多已据通津。\n再来更锁城西馆，检点同年只一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再谢周颙之句二首 其二","author":"邓忠臣","text":"秋日照歌淮上舫，春花引醉福昌城。\n何如阊阖门西北，卧听秋风枕畔声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再谢周颙之句二首 其一","author":"邓忠臣","text":"眼看秋雁歌汾水，心到阳关唱渭城。\n却被维摩居士笑，海潮音作断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文潜嘲无咎夜起明灯诵予诗","author":"邓忠臣","text":"参横月转与天高，归士飞心忆大刀。\n故作楚吟排滞思，吟成风叶更萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉答张文潜戏赠","author":"邓忠臣","text":"拚老工诗恨不高，苦心错玉与砻刀。\n正如天禄秋风夜，剔尽寒灯著广骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄次张弟","author":"邓忠臣","text":"猫头竹叶细檀栾，新笋如椽日满盘。\n寄语儿童莫多取，来春从上万馀竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天启有少年真喜事之句用其韵和","author":"邓忠臣","text":"慷慨论边事，飘萧动礼闱。\n贵须金印绾，老要玉关归。\n食酪便榆塞，鸣铙惯铁衣。\n悬知雄辩在，志愿未应违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未试即事杂书率用秋日同文馆为首句三首 其三","author":"邓忠臣","text":"秋日同文馆，重门静不开。\n云随鸿影去，风送乐声来。\n插架书千轴，论文酒百杯。\n脱花陈叶满，还是作愁媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未试即事杂书率用秋日同文馆为首句三首 其二","author":"邓忠臣","text":"秋日同文馆，人閒景自长。\n重帘朝气入，嘉木午阴凉。\n朝市喧聊避，山林兴未忘。\n频添绕炉水，还与试香方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未试即事杂书率用秋日同文馆为首句三首 其一","author":"邓忠臣","text":"秋日同文馆，沉沉锁棘闱。\n捲帘襟乍快，攲枕梦先归。\n骤雨忧环堵，回风喜裌衣。\n十年经五试，抚事意多违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同舍问及故山景物用钟字韵诗以答","author":"邓忠臣","text":"吾庐高对玉池峰，日听诸天奏鼓钟。\n海外鹤归青嶂觉，洞中花落碧溪逢。\n翻经夜对高禅请，采叶晨邀老圃从。\n说与群仙如画出，纷然归思乱云浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入试院","author":"邓忠臣","text":"东门骢马止行行，被诏秋闱阅俊英。\n三岛隔云天北极，万灯明路国西城。\n人閒聊假诗书乐，地远还闻市井声。\n一夜凉风起阊阖，月中应有桂枝生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邯郸道中夜行阻风","author":"邓忠臣","text":"欲泻悬河雨，先号拔木风。\n问津尨吠处，觅路霓光中。\n徒御忧群盗，儿童笑拙翁。\n当知步兵哭，初不为途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡宿韵寄蒋之奇 其一","author":"邓忠臣","text":"梦罢静思岩野回，何心商鼎作羹梅。\n东门祖帐新光宠，北斗枢星旧冠魁。\n无故弟兄真可乐，相忘父子总多才。\n扁舟若向东吴去，几杖何由日夕陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡宿韵寄蒋之奇 其二","author":"邓忠臣","text":"独步文章妙一台，都门便欲挂冠回。\n已怜天上三台路，未尽人间八斗才。\n坐幄每闻千里胜，占云初见四夷来。\n我公莫作遄归想，衣笥行看衮绣开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和蔡肇慎思说家山之胜用其语得诗","author":"邓忠臣","text":"野桥随岸架，茅屋依林脩。\n木落吟霜狖，云晴舞雪鸥。\n山屏当户列，瀑布入溪流。\n只合樵歌唱，何因得蔡讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜听无咎文潜对榻诵诗响应达旦钦服雄俊辄用九日诗韵奉贻","author":"邓忠臣","text":"连床交语响舂容，激楚评骚彻晓钟。\n绕宅金丝神共听，满潭雷雨剑初逢。\n信知自有江山助，便欲长操几杖从。\n俱是年家情不浅，依兰应许丐香浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬 其二","author":"邓忠臣","text":"试场未动文书静，官舍相联步履过。\n千丈苍波争倚薄，十围便腹有森罗。\n登临已结骚人恨，填委终翻劳者歌。\n后夜中秋佳月色，惟予不饮奈明何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬 其一","author":"邓忠臣","text":"秋闱深锁觉愁多，赖有英游玉趾过。\n日望高楼吟楚月，梦随明月到湘罗。\n南宫曾看挥华藻，西馆还来共笑歌。\n六稔飞光如过隙，人生谁奈老催何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院即事呈诸公","author":"邓忠臣","text":"俊游常恨邈山河，邂逅文闱喜屡过。\n朱簿分明俱鼎立，墨图伻位看星罗。\n人开户牖还相近，朝进英材信可歌。\n双钥重关非不密，只应无奈梦魂何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院后至诸公","author":"邓忠臣","text":"秋日同文馆，飞章待报回。\n丝纶先日降，鹓鹭忽朋来。\n诸彦俱精鉴，微生亦滥陪。\n纷纷五千牍，谁定冠伦魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其六","author":"邓忠臣","text":"秋日同文馆，晨兴不待鸡。\n耽书迷甲子，行乐在东西。\n静对庭柯盼，閒常柿叶题。\n相期放朝后，连日醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其五","author":"邓忠臣","text":"秋日同文馆，来游翰墨场。\n预闻周俊造，多有汉文章。\n兰室依新润，芸书识旧香。\n逢辰强思报，矫首咏明康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其四","author":"邓忠臣","text":"秋日同文馆，分场试未齐。\n借书穷石室，刊字费棠梨。\n想见英雄彀，谁当甲乙题。\n喜陪群彦集，通籍在金闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其三","author":"邓忠臣","text":"秋日同文馆，虚廊日几回。\n浮花出林杪，古樾蔽城隈。\n远笛悲仍壮，幽禽去又来。\n微吟还自喜，共和有清才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其二","author":"邓忠臣","text":"秋日同文馆，朝晖淡淡光。\n聚蚊喧败帐，飞蝠入雕梁。\n香散青绫被，诗翻古锦囊。\n群居有英彦，晤语兴何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗呈同院诸公六首 其一","author":"邓忠臣","text":"秋日同文馆，多朋信可依。\n慧莺还伴锁，巧燕自知归。\n藻鉴由来定，翘材未觉稀。\n贤书早晚上，拭目看珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]