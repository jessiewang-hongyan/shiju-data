[{"title":"送似表弟还乡","author":"李弥逊","text":"话别几年一月留，离歌还起楚江楼。\n往来笑子蚁旋磨，得失顾予鱼中钩。\n雍齿且侯真戏事，冯唐已老盍归休。\n凭君为扫筠庄榻，要着南来新白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舟过南山用琴韵 其二","author":"李弥逊","text":"雪涛一苇意雄誇，惯与滩头雁聚沙。\n年后腊前梅唤客，山南水北竹为家。\n蓬蒿影里开三径，笳鼓声中听两衙。\n去住了无忻厌赏，暮年心迹晚林鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舟过南山用琴韵 其一","author":"李弥逊","text":"唤起骑鲸玉树埋，江边琢语亦佳哉。\n眼看云起山容改，坐觉春随花信来。\n隔水村深寻径入，系船门窄待僧开。\n个中有句无人道，更遣丰隆着雨催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵文伯归溧阳","author":"李弥逊","text":"盍簪异县亦三年，浮木逢龟信偶然。\n忙里诗筒长遣客，静中酒户不妨禅。\n酸寒溧尉君今似，枯槁湘原我自怜。\n别后弹冠应不免，着鞭莫遣祖生先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵二十一观察蜀中迎亲","author":"李弥逊","text":"得意那知行路难，板舆行处蜀江边。\n慈颜未拜心先往，乐事乍闻人共传。\n新制衣裳文锦缎，重颁雨露间花笺。\n回思三十年中恨，长愿儿生有母怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送硕夫赴试礼部","author":"李弥逊","text":"词垒新收汗马劳，冲寒意气九疑高。\n上书北阙真馀事，拄颊西山须汝曹。\n世虑薰心工制锦，时名唾手看连鳌。\n哦君剩欲传衣句，为解千牛绿绮袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日与妙现老堂二公晚步江皋露坐月下夜分乃归老堂有诗次其韵 其二","author":"李弥逊","text":"胡床兴不浅，未肯庾公贤。\n山意知秋近，江声到寺前。\n夜凉新病后，月色正愁边。\n可惜江南梦，青灯照不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日与妙现老堂二公晚步江皋露坐月下夜分乃归老堂有诗次其韵 其一","author":"李弥逊","text":"步屧榕根晚，明河九面横。\n两禅方外得，一笑坐中成。\n云去天逾碧，星垂月自明。\n寒江正留客，倚杖看潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日小集池上次韵明甫之作","author":"李弥逊","text":"生怕微云点太清，箨龙莫作断肠声。\n馀霞到晚铢衣薄，满月当空玉斧成。\n已结松筠为老伴，不缘蛙黾唤愁生。\n但令有酒邀田父，矍铄何须更一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日宿广教寺风月清甚思李白敬亭诗有怀用似表弟韵","author":"李弥逊","text":"众鸟高飞云去闲，相看只有敬亭山。\n孤标尚想风尘外，佳句长留天地间。\n影落金牛撩客恨，手摩玉兔练仙颜。\n故山风月非人世，何事骑鲸去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日游连江石门坐林下有虫咂肤视之仅可分有无疑蚋也以诗嘲之","author":"李弥逊","text":"么么何从到上方，敢将唇吻犯堂堂。\n但知射影求阴中，可笑当年不自量。\n鲎目苦遭蚊喙聒，象蹄犹畏鼠牙伤。\n须臾性命随翻手，蛮触应难望故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上分韵赋梅花得知字","author":"李弥逊","text":"寒梅独笑野人扉，只有春风许自知。\n蜡屐追芳输我辈，着鞭持酒记他时。\n白霓行处玉妃从，明月光中宝璐垂。\n更与丁宁后来秀，醉中来折最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋康郡侯硕人曾氏挽诗 其二","author":"李弥逊","text":"身备难并福，心明最上宗。\n夜台亡宿恨，旦宅漫遗踪。\n尘暗鱼机帐，云低马鬣封。\n酸风一襟泪，哀入暮山松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋康郡侯硕人曾氏挽诗 其一","author":"李弥逊","text":"阀阅荣誇俗，闺房秀出群。\n得贤推淑女，有子赖严君。\n台柏忧时誉，庭兰奕世闻。\n高名写彤管，异代仰清氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别傅才儒","author":"李弥逊","text":"壮岁追随鬓已苍，谁将勋业问行藏。\n怜公惜莫鸡群鹤，顾我凌兢虎质羊。\n败柳亦工喧暮雨，寒花直欲腻秋霜。\n更谋浊酒穷清夜，明日山深木叶黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题叶成父尚书山庵普光明堂","author":"李弥逊","text":"三生调御潮音会，楼阁随方涌化城。\n鸟树有声皆念法，云山多态总忘情。\n禅翁自得逃禅乐，俗客犹沾避俗名。\n但了心源秋月净，刹尘何地不光明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题新安幕府聚秀轩","author":"李弥逊","text":"星聚群贤上幕宾，层轩高敞枕溪漘。\n一时卢骆王杨辈，望重东西南北人。\n句里江山端有助，学馀民社政须亲。\n青冥接迹他年事，晋地卿材半楚臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后戏呈谟老禅师","author":"李弥逊","text":"霜髭病起若相侵，销尽平生未了心。\n一事关身俱是梦，万缘弹指已非今。\n月林清影元无定，山路幽香不可寻。\n唤取汤休共清夜，静听帘雨写鸣琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病卧一春无复少况蹈元顾为寻山之行以诗简之","author":"李弥逊","text":"病与老期推复来，十分春事苦相催。\n干戈四海少闲地，寒暑一生能几回。\n止酒尊罍成说食，空华风景乱真梅。\n晴明强理寻山屐，笑口逢君倘暂开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翁尉以诗送莲并酒","author":"李弥逊","text":"不复西河叹踽凉，真成仙吏隐襄阳。\n一生可了酒供座，千顷平铺花绕塘。\n皓腕折香遮老眼，长须洗杓荐新尝。\n肯分臭味同衰朽，好语犹惊得夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭君建挽诗","author":"李弥逊","text":"蔼蔼声华万耳闻，可凭诗礼大于门。\n浮云终负三馀学，流水难追九逝魂。\n朝有青衿怀旧德，室惟黄卷富诸昆。\n生平不对论文酒，空使清铅比泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪大慈老登古院","author":"李弥逊","text":"林影横榰折脚床，禅翁唤我坐斜阳。\n诸天共说无生话，万壑同薰不尽香。\n茗椀泛云醒远目，藜羹煮玉闹枯肠。\n逢人若问峰头事，翠竹阴中菊正黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪五马诸公游西山泛舟待月而归偶作","author":"李弥逊","text":"鸟乌声乐报新晴，起觅邻翁作队行。\n爱日葵心倾烂熳，寻春蝶梦去纵横。\n人归高屋山逾碧，船到平滩月已生。\n客里不谙风景好，欲将此夕并登瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题陈氏尚遐亭","author":"李弥逊","text":"结屋秋荷上，尘心想坐忘。\n露凝公子荦，风曳野人章。\n浪蕊终无实，多花根不长。\n知君有情尚，千柄伫幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题径川刘子先逸轩","author":"李弥逊","text":"古县溪山里，深轩城郭馀。\n地清从近市，朋好亦多车。\n云隐寻山屐，风翻插架书。\n会看迎鹤版，不独爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题福州程进道止戈堂二首 其二","author":"李弥逊","text":"一麾局促楚江东，时喜邻藩好信通。\n坐厌文书朱墨里，静思谈笑圣贤中。\n浮瓯小试茶膏白，照眼分尝荔子红。\n想见高堂分凫鹜，竞追乐事赏年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题福州程进道止戈堂二首 其一","author":"李弥逊","text":"不识威名擅汉廷，云仍今复见材卿。\n万家桃李栽培盛，千里妖氛却扫清。\n羽扇纶巾聊自适，风声鹤唳已魂惊。\n向来雪锷櫜藏地，剩筑诗坛按酒兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚泊江口令小舟汲江心水烹叶玙云谷碎冰散步岸浒顾望踌躇飘然有物外趣因成小诗云","author":"李弥逊","text":"不到钟山二十年，江边独立思茫然。\n故园如梦南归客，明日好风东去船。\n白鹭一双轻照水，青鸦万点远漫天。\n何须痛饮排孤闷，一酌清甘胜酒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登昭真亭云雾不见黄山因以述怀","author":"李弥逊","text":"莫放微云点太清，欲将游目泫孤亭。\n十年去国心长赤，一月看山眼未青。\n多病情怀千日酒，穷途生事五侯鲭。\n谩游踪迹随方寄，更觉轻於水上萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登齐云阁","author":"李弥逊","text":"窈窕僧窗十肘长，解分眼界入他方。\n尘襟偶脱公家事，鼻观重参佛土香。\n寒日半收山着色，晚风无力水磨光。\n幽寻已觉沧洲近，身外营营付一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹溪道中呈何公显","author":"李弥逊","text":"笋舆访古出秋原，山网重重护石田。\n水接桃花源上路，人行巫女峡中天。\n要令陶冶誇盘谷，何必丹青貌辋川。\n寄语能诗何水部，笔端应许见云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"硕人赵氏挽诗 其二","author":"李弥逊","text":"命服从夫贵，遗经易子成。\n蘋蘩无失职，琴瑟自和鸣。\n已叹归同穴，犹悲梦两楹。\n旁观洒清泪，双旐出寒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"硕人赵氏挽诗 其一","author":"李弥逊","text":"毓秀名臣裔，来宾上相家。\n浮沤轻富贵，朽木视铅华。\n晓日俄晞露，春风自笑花。\n仙踪今不返，望断五云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿竹阁","author":"李弥逊","text":"草木尽改色，孤标绿正繁。\n曳云扶劲节，攲石护盘根。\n静者宜投迹，高人时避喧。\n岁寒松柏共，何必在梁园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翊善余公挽诗 其二","author":"李弥逊","text":"白发归来一笑同，旧游长忆鲁山东。\n松楸地接螺江上，兄弟名联雁塔中。\n问舍蜗牛聊老□，□书虿尾不忧穷。\n清芬千古无遗恨，空使馀哀入暮风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翊善余公挽诗 其一","author":"李弥逊","text":"弱冠声名翰墨场，一官小试活人方。\n二王宾客推清介，半刺规模与善良。\n可但仁风薰晋鄙，犹怜奇节老阌乡。\n康宁寿考犹馀事，兰玉阶亭久更芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴再用闲字韵","author":"李弥逊","text":"风掠游云露远山，长藤竟欲与君攀。\n花神解作琼瑶报，野老心如铁石顽。\n千树暗春难比富，一枝照眼未应悭。\n不须更作含羞态，唤取张卢来共闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭府君夫人罗氏挽诗 其二","author":"李弥逊","text":"始讶生儿异，那知有母贤。\n客无三至感，家独一经传。\n恨锁鱼机帐，悲缠马鬣阡。\n他年陈五鼎，清昼下云軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭府君夫人罗氏挽诗 其一","author":"李弥逊","text":"擢秀芝兰畹，来嫔诗礼庭。\n好羞贫更洁，寿发短犹青。\n秦号封方宠，蓬瀛驾不停。\n天风助哀怨，吹雨湿丹铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游石门用前韵促陈丞","author":"李弥逊","text":"昨夜浓阴泼墨来，比邻折简小奚催。\n印窗寒月晓前白，寻壑春舆天际回。\n盏面绿浮新展叶，杖头黄碍半肥梅。\n知君自扫松间径，古锦何妨此地开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游雪峰将至大目溪","author":"李弥逊","text":"造物随人意，轻帆百里间。\n舟痕风力健，客枕橹声闲。\n山合尘纵断，秋高爽气还。\n望州相见处，蓦直透三关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴溪","author":"李弥逊","text":"竹色千钟静，溪光一鉴开。\n岩隈宿风雨，人迹老莓苔。\n控鲤定何在，骑鲸今不来。\n空馀泉上月，与我共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新成茅庐独宿西山","author":"李弥逊","text":"幕上宁容燕作巢，土阶竹屋近诛茅。\n深行乐地思招隐，早悟危机欲绝交。\n溪响隔溪来枕面，月光先月到林梢。\n为官拓落真吾事，何用纷纷更解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴再用似表弟高字韵","author":"李弥逊","text":"疏林远墅见秋毫，破晓阳乌羽翼高。\n湖面平于开匣镜，山棱光并发硎刀。\n闭门听雨宁论日，散策寻冈莫数遭。\n世上几人能避俗，簿书堆案想官曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暇日游石门用前韵","author":"李弥逊","text":"晓御欲随风脚来，报晴乌鹊入檐催。\n松幢竹盖宝坊近，石壁云关尘境回。\n山气得春浓胜酒，花光带月冷过梅。\n却收眼力寻归路，惜取馀青莫浪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠矶待月","author":"李弥逊","text":"偶坐松根送落晖，竹风零露湿人衣。\n乱萤点水只自照，宿鸟赴林犹并飞。\n玉塔微澜秋月吐，澄江净练夜潮归。\n好山不负平生约，故傍吾庐翠作围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡子应郎中挽诗 其二","author":"李弥逊","text":"三生曾结在家因，半世相从渐老身。\n曲几团蒲分夜静，斜风细字寄情亲。\n伯牛命矣元非病，桑户嗟来已反真。\n我亦无心趁哀乐，每怀前事一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔡子应郎中挽诗 其一","author":"李弥逊","text":"独秀声名楚水东，妙年腾达俊游中。\n文昌寓直风云近，神武归来猿鹤同。\n居士人非禅板寂，少微星暗宝函空。\n知心不必悲生死，欲向何方觅是翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德甫知丞大夫惠诗见招次韵","author":"李弥逊","text":"地胜官清人更幽，公田政足办槽丘。\n吏情厌问可不可，世事但从浮自浮。\n绿盖红妆供客笑，黄鸡白酒为君留。\n惯倾老瓦陪田父，高会端如饫五侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"德甫知丞过筠庄溪亭为待月之会戏呈席上诸友","author":"李弥逊","text":"载酒何人过子云，传呼鸡犬亦惊奔。\n门无车马苔侵径，坐近池台竹覆尊。\n好月邀人留晚照，疾雷催雨过前村。\n独醒楚子真多事，共醉愚溪百尺浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题子阳监丞见一庵","author":"李弥逊","text":"云间幽好许谁参，十亩林园拥舍南。\n隐几献花真不二，举杯邀月但成三。\n着鞭有路非吾乐，弹铗无求只自甘。\n吾亦营巢老深竹，肯分华榜共名庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兴教寺","author":"李弥逊","text":"云开岫幌隐禅扉，高屋凭虚面翠微。\n午枕有香清蝶梦，晚林无路送鸿飞。\n一丘一壑真吾事，三沭三薰悟昨非。\n山意有情留倦客，树头谁道不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题明叔郎中海月吹笛图","author":"李弥逊","text":"天上星郎骑省孙，兴随孤月到无垠。\n浮槎夜入鱼龙宅，横竹秋生海岳云。\n控鲤丹成终独往，骑鲸仙去杳难群。\n纷纷世上知君少，画茟犹能续异闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题福唐郡园清閟亭","author":"李弥逊","text":"公馀自种南阶竹，好事风流今未闻。\n但得七人来结友，何须千亩比封君。\n风梢不定微藏日，雨叶初乾薄带云。\n自是甘棠人爱惜，不忧寒谷遇樵斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题薛直老府园万象亭","author":"李弥逊","text":"断取方壶壮郡壕，钩连野色上亭皋。\n星移日转天容丽，江净山明地轴高。\n下榻筵宾供啸咏，凝香罢寝助风骚。\n使君八九吞云梦，小展风烟遗我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝碧晚望","author":"李弥逊","text":"秋来何必送将归，落日高台意自悲。\n一壑未容追汗漫，三钟犹得饱支离。\n黄花对客如相笑，白发寻人似有期。\n时序不堪翻覆手，每逢佳处亦开眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠硕夫","author":"李弥逊","text":"此君风致似吾侬，来伴筠翁晚径筇。\n世味每于谈际断，诗情尤向饮边浓。\n溪山寄语能相觅，猿鹤论交肯见从。\n共斸云根结茅屋，自锄菜甲为君供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葵藿倾太阳","author":"李弥逊","text":"葵藿比君子，卑栖亦自荣。\n叶随朱夏盛，心逐太阳倾。\n大象无私照，孤黄不并生。\n风稍轻转影，云日澹留明。\n连茹怀君志，同根念旧情。\n拾遗千古恨，难夺恋轩英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日陪徽守游白水寺继登西山继白堂晚饮","author":"李弥逊","text":"晓衢初日动游人，叠嶂回溪绿黛新。\n自偃松篁如唤客，后开桃李尚留春。\n笑谈怀远西山上，觞咏追时白水滨。\n五马行春从此始，更驱风伯净车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与同馆昼会王公衡家分韵得瓜字","author":"李弥逊","text":"秋曦上观阙，晨驺散蜂衙。\n追随我辈人，偶到蓬莱家。\n主人心远尘，门无车马哗。\n峰峦生几棐，图书乱签牙。\n午簟琅玕清，莼瓯荐流霞。\n坐令秋风思，悠悠起天涯。\n微官浪自缚，霜蔓萦寒瓜。\n爱子庭宇静，同官谢纷华。\n寓意语成剧，忘机虑乃赊。\n得酒且复尽，昏林欲藏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与老禅诸上人同游鼓山灵源洞","author":"李弥逊","text":"茶瓯唤起清昼眠，涧松岩竹谈幽禅。\n秋曦忽随壮士臂，暮景已入诗人肩。\n尘缘咄咄鱼吞饵，胜事堂堂驹着鞭。\n屐齿欲回还小立，隔溪明灭见江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与何西仲秉烛饮梅下","author":"李弥逊","text":"山茶著包大如茧，初见寒梢一花展。\n强将老眼趁年华，日日芒鞋踏苔藓。\n花神似苦山翁催，不问春风有深浅。\n树头纷纷弄月明，冰雪琼瑶乱裁剪。\n痴□公事无了时，与花拚作十日期。\n阑风伏雨恐相逼，夜傍花阴烧烛随。\n攀条嚼蕊兴不尽，满把自摘香传衣。\n星星霜鬓簪不得，小撚疏英翻酒卮。\n儿童莫作吴歈声，山翁正与花神盟。\n生愁一片风飘零，留取北枝宽作程。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]