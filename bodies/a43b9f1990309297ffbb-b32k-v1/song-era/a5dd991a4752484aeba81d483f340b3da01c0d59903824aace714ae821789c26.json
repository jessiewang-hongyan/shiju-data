[{"title":"偈颂三十首 其十七","author":"释慧晖","text":"少室胡僧，履子留只。\n米树应供，趺子出双。\n新丰老人，问杀首座。\n大阳兄者，兼养青鹞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十五","author":"释慧晖","text":"佛日高悬，祖月弥朗。\n僧云漫漫，法雨浩浩。\n禅林花发，教风春迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十二","author":"释慧晖","text":"路遮户外，家包云中。\n客游三月，主居月宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其八","author":"释慧晖","text":"真到做处，清虚妙体。\n时时随后，步步在前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其六","author":"释慧晖","text":"青山山上，白云云下。\n户外水寒，波心船点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其五","author":"释慧晖","text":"吾门广大，从古难入。\n徒展两脚，不蹈阶级。\n元非宫内，岂得建立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十","author":"释慧晖","text":"小春霜刃，大家雪机。\n一堂禅侣，三世结制。\n时光可惜，岁花不留。\n自晨至暮，吃饭饮茶。\n道者一个，无得禅心。\n从生至老，著衣谈笑。\n道流半个，莫知自心。\n徒劳念情，不识玄旨，苦哉悲矣。\n贫道孤老，走年难系。\n谨劝云众，一生归信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其一","author":"释慧晖","text":"山上栏外，水下槛前。\n夜兔光雪，昼乌辉火。\n黄头出妙，净名入玄。\n胡僧印心，卢公传衣。\n张三野曲，李四樵歌。\n船动碧波，海浸孤天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧深","text":"未得入头应切切，入头已得须教彻。\n虽然得入本无无，莫守无无无间歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其三","author":"释慧温","text":"正中来，无著当年访善财。\n琉璃盘里藏明月，异草山华处处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其四","author":"释慧温","text":"兼中至，不历僧祇超十地。\n虽然踏著旧家乡，更须知有深深意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其五","author":"释慧温","text":"兼中到，天寒大雪长安道。\n五陵才子锦袍新，马蹄乱踏琼瑶草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其二","author":"释慧温","text":"偏中正，过房之子初受命。\n金刚脚下昆崙奴，腰间也佩毗卢印。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位 其一","author":"释慧温","text":"正中偏，玉兔金乌落二边。\n丫角童儿骑黑象，三更穿过御楼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释慧温","text":"释迦老子，四十九年坐筹帷幄。\n弥勒大士，九十一劫带水拖泥。\n凡情圣量，不能刬除。\n理照觉知，犹存露布。\n佛意祖意，如将鱼目作明珠。\n大乘小乘，似认橘皮为猛火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释慧温","text":"拶出通身是口，何妨骂雨诃风。\n昨夜前村猛虎，咬杀南山大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"砂锣盛油","author":"释慧勤","text":"铜砂锣里落盛油，生菜还他萝卜头。\n但看来年正月半，家家门首挂灯毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其五 十身调御","author":"释慧勤","text":"捉贼分明要见赃，十身调御下禅床。\n曾经巴峡猿啼处，铁作心肝也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其六 三圣逢人即出","author":"释慧勤","text":"城南措大骑驴子，市北郎君跨马儿。\n各各四蹄俱著地，三春同到月明池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其二 日面佛月面佛","author":"释慧勤","text":"东街柳色拖烟雨，西巷桃华相映红。\n左顾右盼看不足，一时分付与春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其三 世尊升座","author":"释慧勤","text":"一轮明月挂天心，四海生灵荷照临。\n何必西风撼丹桂，碧霄重送九秋音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其四 离四句绝百非","author":"释慧勤","text":"美如西子离金阁，娇似杨妃倚玉楼。\n犹把琵琶半遮面，不令人见转风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其二","author":"释慧勤","text":"日日日西沉，日日日东上。\n若欲学菩提，但看此模样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其一 达磨见武帝","author":"释慧勤","text":"始闻阿阁一声钟，日暖苍龙睡正浓。\n再击凤凰台上鼓，夜半祥鸾未飞舞。\n帝基永固如磐石，胡僧枉费平生力。\n回指少林归去来，春风一阵华狼藉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其七 南泉示众云文殊起佛见法见贬向二铁围山","author":"释慧勤","text":"彩云影里仙人现，手把红罗扇遮面。\n无人著眼看仙人，却看随后红罗扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其六","author":"释慧勤","text":"天左旋，地右转，古往今来经几遍。\n金乌飞，玉兔走。\n才方出海门，又落青山后。\n江河波渺渺，淮济浪悠悠，直入沧溟昼夜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其五","author":"释慧勤","text":"世尊有密语，冬到寒食一百五。\n迦叶不覆藏，水泄不通已露赃。\n灵利衲僧如会得，一重雪上一重霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其四","author":"释慧勤","text":"金乌急，玉兔速，急急流光七月十。\n无穷游子不归家，纵归只在门前立。\n门前立，把手牵伊不肯入。\n万里看看寸草无，残花落地无人拾。\n无人拾，一回雨过一回湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其三","author":"释慧勤","text":"去年今日时，红炉片雪飞。\n今日去年时，曹娥读夜碑。\n末后一句子，佛眼莫能窥。\n白莲峰顶上，红日绕须弥。\n鸟啄珊瑚树，鲸吞离水犀。\n太平家业在，千古袭杨歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈六首 其一","author":"释慧勤","text":"至道无难，唯嫌选择。\n桃华红，李花白，谁道融融只一色。\n燕子语，黄莺鸣，谁道关关只一声。\n不透祖师关捩子，空认山河作眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧勤","text":"八月二十五，有宾兼有主。\n辊出雪峰毬，打动禾山鼓。\n天帝释摇头，大梵王作舞。\n不透上林关，未敢轻相许。\n空生不解此家风，惹得岩前华似雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏月","author":"释樟不","text":"月轮端似古人心，皎洁高深处处临。\n纵在波涛圆缺定，照尘尘亦不能侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂","author":"释遵式","text":"韦提重礼请能仁，愿说西方净报因。\n十六观兼三净业，修之即得往生身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 中品中生","author":"释遵式","text":"若人至心一日夜，持戒持斋无破缺。\n以此功德回愿生，七日华敷成记莂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 无量寿佛身观第九","author":"释遵式","text":"无量寿佛金色身，光明普照群生类。\n勤修智者系心观，诸佛现前同授记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 华座观第七","author":"释遵式","text":"七想莲华妙台座，广大弥陀愿力成。\n作此想时心不乱，定当极乐国中生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 地观第三","author":"释遵式","text":"琉璃宝地正观时，谛了分明极乐国。\n八种清风鼓乐音，苦空无我无常曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 杂往生观第十三","author":"释遵式","text":"重想弥陀二菩萨，神通变现事如前。\n杂沓观成无量福，定生安养奉金仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 池观第五","author":"释遵式","text":"五想净土七宝池，池中水有八功德。\n宣流念佛法僧名，妙宝莲华千万亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 势至观第十一","author":"释遵式","text":"次观势至菩萨身，量等观音无有异。\n但于肉髻宝瓶中，盛众光明现佛事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第九疑：凡修斋福，并读诵经典，当回向家宅何等神明，凡有几位耶？颂曰：","author":"释遵式","text":"作福常回施，天龙善鬼神。\n威光常覆护，使汝免灾迍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第十疑：既不许祭祀，或家眷死亡堕在鬼趣，云何施其饮食耶？颂曰：","author":"释遵式","text":"鬼道常饥渴，当生怜悯心。\n能蠲口中食，佛赞福田深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第五疑：祭祀之家，及彼师巫，得何罪报耶？颂曰：","author":"释遵式","text":"杀他还自杀，影响逐形声。\n鬼饱都无福，空招堕火坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第三疑：家眷死后祭祀，得食不得食耶？颂曰：","author":"释遵式","text":"人死随前业，升沉六道殊。\n如何纯祭祀，须道世人愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第七疑：改祭之后，忽遇灾祸，既已舍神，求谁救护耶？颂曰：","author":"释遵式","text":"专持菩萨号，八部护君身。\n急难随声应，唯除不信人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第八疑：自来杀生祭祀，所有罪业作何功德而得消灭耶？颂曰：","author":"释遵式","text":"法宝真良药，众生自不尝。\n书持并供养，世世上天堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第一疑：有鬼无鬼，能祸能福耶？颂曰：","author":"释遵式","text":"鬼神随处有，谄诳世间人。\n祭鬼都无福，空增杀业因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 第二疑：现见世人病患，祭祀获安，何言无福耶？颂曰：","author":"释遵式","text":"正信天龙护，邪神岂奈何。\n但知常念佛，灾怪自消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"改祭修斋决疑颂 圆丘方泽，上下神明，国之常典。云何劝令断祭，奈太伤国风乎？颂曰：","author":"释遵式","text":"杀牛惭礿祭，黍稷本非馨。\n斋诵真明德，何劳执礼经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬苏屯田西湖韵","author":"释遵式","text":"雨馀残景照渔家，渔子鸣榔彻郡衙。\n今夜相呼好垂钓，晚来新雨涨蒹葭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上王丞相十界心图颂","author":"释遵式","text":"无象无名杳莫寻，强将名象测幽深。\n凭斯会解还相背，舍此他求转自沉。\n鹫岭殷勤亲付嘱，龙门恺悌好知音。\n仍闻挂在高堂上，误杀来人错认心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苗推官","author":"释遵式","text":"官满载琴书，乘春入上都。\n烟波离远岸，桃李发中途。\n俸薄尊常浅，诗清道太孤。\n登朝无恨晚，未有白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄丹丘鸿上人不出寺","author":"释遵式","text":"小固山前一道人，不言生死不言真。\n茅堂静有朝端客，草履烂无门外尘。\n银漏滴残犹在定，石花开尽始知春。\n相思未得相寻去，空恨江头多病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘处士","author":"释遵式","text":"度月阻相寻，应为苦雨吟。\n井浑茶味失，地润屐痕深。\n鸟背长湖色，门閒古树阴。\n想君慵更甚，华发昼方簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄悟和尚","author":"释遵式","text":"无累无机祇任缘，一斋长掩古松边。\n寒垂白发过深雪，不下青林知几年。\n木叶当薪烧更暖，姜苗为屦著难穿。\n竟何人问东林社，时引清流灌碧莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隋观法师塔","author":"释遵式","text":"五六百年内，金躯亦化尘。\n方知新冢上，尽是古人身。\n白发争名急，青山送骨频。\n除师灵塔外，一一好沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐者","author":"释遵式","text":"一径千峰里，何人更往还。\n无为无事者，白首白云閒。\n酿酒担寒瀑，寻猿过别山。\n岂知名利客，鞭马向秦关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游天台观","author":"释遵式","text":"古观春山下，寻幽似有期。\n瀑清冥坐久，峰好独归迟。\n客啸巢禽识，仙踪药叟知。\n我来无别趣，禅性尽相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬伉上人","author":"释遵式","text":"鸟外清閒极，谁能更似君。\n山光晴后见，瀑响夜深闻。\n拾句书幽石，收茶踏乱云。\n江头待无事，终学弃人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠智伦弟","author":"释遵式","text":"溪竹拥疏帘，溪云冷不厌。\n千岩唯虎伴，一讲许诗兼。\n煮茗敲冰柱，看经就雪檐。\n有时开静户，寒日下峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戒五辛颂","author":"释遵式","text":"五辛佛所说，障道定无疑。\n梵网招轻垢，楞伽损大慈。\n人天犹尚失，净土固难期。\n生啖增瞋念，熟食发淫思。\n讲经十二部，天仙悉舍离。\n善神不守护，恶鬼得便宜。\n薜荔唼唇吻，魔罗现佛仪。\n福德因消灭，业障更弥滋。\n地狱铜兼铁，轮回网复羁。\n无端耽草味，殃祸大堪悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 上品上生观第十四","author":"释遵式","text":"慈心不杀持众戒，读诵大乘方等经。\n修行六念回向愿，临终化佛悉来迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 上品下生","author":"释遵式","text":"深信因果奉大乘，但发无上菩提意。\n以此功德回愿生，生已当住欢喜地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 上品中生","author":"释遵式","text":"不必受持方等经，解第一义明因果。\n紫金台现命终时，自见身于台上坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 下品上生观第十六","author":"释遵式","text":"若人虽不谤尊经，造众恶业无惭愧。\n临终遇劝念弥陀，生彼十劫得初地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 下品下生","author":"释遵式","text":"有作五逆十恶业，应堕地狱受诸苦。\n临终遇劝念弥陀，决定超生于彼土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 下品中生","author":"释遵式","text":"若有众生犯众戒，盗取僧祇三宝物。\n临终遇劝念弥陀，一念顷间生彼国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 中品上生观第十五","author":"释遵式","text":"受持五戒八戒斋，修行诸戒回向愿。\n命终生彼闻法音，应时即得阿罗汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 中品下生","author":"释遵式","text":"孝养父母行仁义，临终复遇善知识。\n广说弥陀大愿因，屈伸臂顷生彼国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 日观第一","author":"释遵式","text":"正坐面西想日轮，见日欲没如悬鼓。\n见已闭目开目间，皆令明了心坚住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 水观第二","author":"释遵式","text":"次作水想见西方，一切皆为净土水。\n既见水已想成冰，皎然映彻琉璃地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 观音观第十","author":"释遵式","text":"观音菩萨紫金身，眉间毫相七宝色。\n流出光明满十方，光中化佛无数亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六观经颂 佛菩萨像观第八","author":"释遵式","text":"诸佛如来法界身，遍入众生一切想。\n智者当观此想心，是心即佛菩萨像。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]