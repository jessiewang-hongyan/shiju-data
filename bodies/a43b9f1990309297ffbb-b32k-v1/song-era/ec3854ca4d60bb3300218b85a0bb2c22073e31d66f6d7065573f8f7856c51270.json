[{"title":"晓过叶家桥二首 其二","author":"杨万里","text":"圩峻愁今路，山行羡昨朝。\n闭窗深坐轿，合眼过危桥。\n岸近何由到，魂惊半欲销。\n寄言薛丞相，最稳是轻舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过叶家桥二首 其一","author":"杨万里","text":"鸡唱嗔人睡，鸦啼唁客劳。\n近山烟外远，矮竹苣边高。\n老矣犹长铗，悠哉未大刀。\n绕圩无杂树，一色柳新缫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓过皂口岭","author":"杨万里","text":"夜渡惊滩有底忙，晓攀绝磴更禁当。\n周遭碧嶂无人迹，围入青天小册方。\n半世功名一鸡肋，平生道路九羊肠。\n何时上到梅花岭，北望螺峰半点苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓泊丹阳馆","author":"杨万里","text":"夕冻朝还积，寒曦暖未多。\n霜轻犹著草，冰重亦浮河。\n山尽酣馀势，潮归殿去波。\n六朝遗迹在，故老尚传么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓泊舟庙山","author":"杨万里","text":"平水长先晓，无风也自涛。\n烟昏山易远，岸阔树难高。\n去雁鸣相报，游鱼冷总逃。\n轻寒容可忍，清眺得辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓经八盘岭赴东宫讲堂","author":"杨万里","text":"至前至后恰多晴，山北山南间一登。\n瘦石经霜乾脱藓，细泉滴涧旋成冰。\n海波贯日红千丈，江雾萦楼玉万层。\n资善堂前得春早，宫梅一朵掠觚棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓看芙蓉","author":"杨万里","text":"两岁芙蓉无一枝，今年万朵压枝低。\n半红半白花都闹，非短非长树斩齐。\n临水酽妆新雨后，出墙背面晓风西。\n春英笑杀秋英淡，祗恐秾于桃李蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓望","author":"杨万里","text":"暑退谁当忆，秋生喜此逢。\n荒林失轻雾，寒日上危峰。\n忽有吟边兴，忘看镜里容。\n不须无鲍谢，始得擅诗宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴发黄杜驿二首 其二","author":"杨万里","text":"巷竹欹将倒，林花湿不飞。\n总将枝上雨，洒入轿间衣。\n晴色犹全嫩，春寒肯便归。\n祗能欺客子，户户闭荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴发黄杜驿二首 其一","author":"杨万里","text":"望后月不落，偏于水底明。\n对悬双玉镜，并照一金钲。\n忽值山都合，浑无路可行。\n多情小花径，导我度千萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓晴过猿藤径","author":"杨万里","text":"厌雨欣初霁，贪程敢晏眠。\n排天双壁起，受日一峰先。\n入径惟逢树，无人况有烟。\n藤深猿不见，声到客愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓登子城","author":"杨万里","text":"鞋响新霜后，襟暄野日初。\n寒溪半湾落，远树一行疏。\n老矣端何苦，归哉不愿馀。\n终更犹半岁，作么度居诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮石清晓放船遇雨","author":"杨万里","text":"破晓开船船正行，忽然头上片云生。\n秋江得雨茶鼎沸，怒点打篷荷叶鸣。\n远听滩喧心欲碎，近看浪战眼初明。\n夜来暗长前村水，绝喜舟人好语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠四首 其四","author":"杨万里","text":"吾诗多为海棠哦，花意依前怨不多。\n已拆未开浑是韵，乍浓还淡总由它。\n留连春色能销底，请托东风定肯么。\n岂是少陵无句子，少陵未见欲如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠四首 其三","author":"杨万里","text":"竞艳争娇最是他，教人嫌少不嫌多。\n初酣晓日红千滴，晚笑东风淡一涡。\n自是花中无国色，非关格外占春窠。\n开时悭为渠侬醉，却恨飘零可若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠四首 其二","author":"杨万里","text":"暖醉寒醒各自奇，千花谁是复谁非。\n燕支浓透春风面，翡翠新裁生色衣。\n破落东皇能许劣，庄严西子较些肥。\n痴儿犹恨无香在，紫蝶黄蜂政打围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠四首 其一","author":"杨万里","text":"小园不到负今晨，晚唤娇红伴老身。\n落日争明那肯暮，艳妆一出更无春。\n树间露坐看摇影，酒底花光并入唇。\n银烛不烧渠不睡，梢头恰恰挂冰轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涉小溪宿淡山","author":"杨万里","text":"径仄愁斜步，溪深怯正看。\n破船能不渡，晴色敢辞寒。\n白退山云细，青还玉宇宽。\n险艰明已济，魂梦未渠安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留萧伯和仲和小饮二首 其二","author":"杨万里","text":"谁曾白日上青天，谁羡千钟况万钱。\n要入诗家须有骨，若除酒外更无仙。\n三杯未必通大道，一斗真能出百篇。\n李杜饥寒才几日，却教富贵不论年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留萧伯和仲和小饮二首 其一","author":"杨万里","text":"野果山蔬未要多，浊醪清酒尽从他。\n不于两盏三杯里，奈此千愁百恼何。\n山倒莫教扶玉树，尊空别得借银河。\n少陵一语君知么，不见堂前东逝波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题筠庵以茅盖层出如蓑衣然","author":"杨万里","text":"茂林脩竹翠光中，那得披蓑一老翁。\n白石砌成珠子径，黄茅裹却水晶宫。\n夏凉冬暖非人境，雪打霜封即钓篷。\n老子明朝便东去，更携瓦枕享松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题碧落堂","author":"杨万里","text":"仙人白日上青冥，千载如闻月下笙。\n南北万山俱在下，中间一水独穿城。\n江西个是绝奇处，天下几多虚得名。\n滕阁孤台非不好，祇缘犹带市朝声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中夜坐","author":"杨万里","text":"月流银汉小徘徊，似恋空庭独树梅。\n玉漏听来更二点，烛花剪了晕重开。\n病身不饮看人醉，乾雪无端上鬓来。\n后日老衰知健否，只今六九已摧隤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中屏肉味独茹菜羹饭甚美","author":"杨万里","text":"云子香抄玉色鲜，菜羹新煮翠茸纤。\n人间脍炙无此味，天上酥陀恐尔甜。\n浑是土膏含雨露，何须酱豉与醯盐。\n茹毛祸首雍巫出，馋到熊蹯未属厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中春雨闻东园花盛","author":"杨万里","text":"万类欣欣一老悲，物华岂是不佳时。\n病夫自与春无分，好景非于我独遗。\n花底报来开已闹，雨中过了更曾知。\n风光九十今强半，又约芳菲隔岁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中喜雨呈李吉州","author":"杨万里","text":"两日炎晖烈未收，连宵甘澍沛如流。\n大田今日非昨日，多稼新秋赛旧秋。\n凉气隔帘深亦透，香烟穿袖散难留。\n史君小试为霖手，便作江西第一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中感春","author":"杨万里","text":"老去春来已薄情，体中病后更竛竮。\n海棠红酽飞成雪，杨柳金浓染作青。\n到得当家饶景物，不如旧日借园亭。\n一杯欲把还休去，遮莫莺花笑独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中感秋","author":"杨万里","text":"病中一刻抵三秋，况见西风再树头。\n老去能禁几回病，秋来不为别人愁。\n书帷梦觉疑僧榻，竹户凉侵似客舟。\n寿外康宁方是福，不然徒寿不须休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中感秋时初丧寿佺子","author":"杨万里","text":"临晓睡偏重，不知窗已明。\n高梧下清露，宿鸟有寒声。\n愁岂关须事，秋来添雪茎。\n病身仍哭子，并作老来情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后觉衰","author":"杨万里","text":"病著初无恼，安来始觉衰。\n人谁长健底，老有顿来时。\n山意凄寒日，秋光染瘦诗。\n小松能许劣，学我弄吟髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起览镜二首 其二","author":"杨万里","text":"览镜忽自问，何方一病翁。\n生涯管城外，本贯醉乡中。\n笔砚今都废，尊罍久屡空。\n又将数茎雪，憔悴见西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起览镜二首 其一","author":"杨万里","text":"病起长新骨，居然非旧容。\n眼添佩环带，腰减采花蜂。\n对面不相识，何人忽此逢。\n吾身无定在，更要问穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益公和白花青缘牡丹王字韵诗再和以往","author":"杨万里","text":"渠是花中异姓王，平园小试染花方。\n冰霜洗出春风面，翡翠轻棱叠雪裳。\n夜领素娥酌青女，晓看国色带天香。\n更将秋菊潭心水，滴作䒠茸月蕊黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益公新作三层百尺新楼署曰围山观贺以唐律二章 其二","author":"杨万里","text":"崖谷求仙底有仙，金梯上去即仙源。\n山川第一江西景，风月无边相国园。\n十倍黄楼况黄阁，千寻青笔是青原。\n写成脚力犹强句，灯火笙歌特地村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"益公新作三层百尺新楼署曰围山观贺以唐律二章 其一","author":"杨万里","text":"万峰飞入子城头，千里长江几上流。\n外面周遭苍玉笋，虚空幻出水晶楼。\n帘开雪月非三界，人立云霄更九州。\n一骑红尘北来底，平章军国恼公不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真阳峡","author":"杨万里","text":"清远虽佳未足观，真阳佳绝冠南蛮。\n一泉岭背悬崖出，乱洒江边怪石间。\n夹岸对排双玉笋，此峰外面万青山。\n险艰去处多奇观，自古何人爱险艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇德道中望福严寺","author":"杨万里","text":"一径青松露，三门白水烟。\n殿横林外脊，塔漏隙中天。\n地旷迎先见，村移眺更妍。\n追程坐行役，不得泊春船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秧畴","author":"杨万里","text":"田底泥中迹尚深，折花和叶插畦心。\n晚秧初撚金狨线，先种输它绿玉针。\n云垄雾畴俱水响，丝风毛雨政春阴。\n莫听布谷相煎急，且为提壶强满斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨小止暂到东园雨作急归","author":"杨万里","text":"咫尺东园千里遥，欣逢小霁略逍遥。\n鹭穿秧稻新黄脚，虫秃金沙嫩紫条。\n城市檐间堪系缆，山溪夜半失危桥。\n匆匆行散还归去，一阵飘萧不见饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"积雨新晴驾幸聚景园拟口号","author":"杨万里","text":"帝心忧麦复忧桑，一念通天转雨旸。\n五色日华销积霭，三春花草殿馀芳。\n黄云暖照天颜喜，红药浓熏禁籞香。\n见说都人争出郭，欢声舞倦万垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷池观鱼","author":"杨万里","text":"截山剜沼贮泉流，旋种鯈鱼绝善游。\n细数未齐还已乱，群嬉半没忽全浮。\n荷钱荇带来复去，雪片银花稀却稠。\n我乐自知鱼似我，何缘惠子会庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读张忠献公谥册感叹","author":"杨万里","text":"恩视韩兼赵，名均献与忠。\n礼中非不极，勋外若为同。\n三圣无多学，千年仅一翁。\n犹怜公议在，拚泪乞秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读罪己诏时有符离之溃 其二","author":"杨万里","text":"乱起吾降日，吾将强仕年。\n中原仍梦里，南纪且愁边。\n陛下非常主，群公莫自贤。\n金台尚未筑，乃至羡强燕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读罪己诏时有符离之溃 其三","author":"杨万里","text":"只道六朝窄，渠犹数百春。\n国家祖宗泽，天地发生仁。\n历服端传远，君王但侧身。\n楚人要能惧，周命正惟新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读罪己诏时有符离之溃 其一","author":"杨万里","text":"莫读轮台诏，令人泪点垂。\n天乎容此虏，帝者渴非罴。\n何罪良家子，知它大将谁。\n愿惩危度口，傥复雁门踦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭母孺人李氏挽歌辞","author":"杨万里","text":"李郭俱名族，华姻合两家。\n藁砧巾角雨，郎罢笔头花。\n树秀庭双玉，荪荣砌百芽。\n半生冰雪节，再赋白山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郭汉卿母挽诗","author":"杨万里","text":"妇节今安仰，斯人古有光。\n鸡鸣不知雨，荠茂独凌霜。\n未拜金花诰，空悲玉树郎。\n藤舆帘蹙绣，无复出萱堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都下食笋自十一月至四月戏题","author":"杨万里","text":"竹祖龙孙渭上居，供侬樽俎半年馀。\n斑衣戏綵春无价，玉版谈禅佛不如。\n若怨平生食无肉，何如陋巷饭斯蔬。\n不须庾韭元脩菜，吃到憎时始忆渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱仲耕殿撰侍郎挽诗二首 其二","author":"杨万里","text":"使节三持玉，州轓两画熊。\n雪山郇宝白，冰漕太仓红。\n理世非轻士，才难会忆公。\n石峰当西子，作殉送青枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱仲耕殿撰侍郎挽诗二首 其一","author":"杨万里","text":"易髓三爻表，恩波九里强。\n贯珠程氏传，炊玉范家庄。\n荷橐中年紫，芸签到老香。\n不应踰耳顺，便返白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪留守余处恭总领钱进思提刑傅景仁游清凉寺即古石头城三首 其三","author":"杨万里","text":"已守台城更石城，不知并力或分营。\n六师只遣环天阙，一垒真成借寇兵。\n向者王苏俱解此，冤哉隗协可怜生。\n若言虎踞浑堪倚，万岁千秋无战争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪留守余处恭总领钱进思提刑傅景仁游清凉寺即古石头城三首 其二","author":"杨万里","text":"万里长江天上来，石头却欲打江回。\n青山外面周如削，紫府中间划洞开。\n苏峻战场今草树，仲谋庙貌古尘埃。\n多情白鹭洲前水，月落潮生声自哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪留守余处恭总领钱进思提刑傅景仁游清凉寺即古石头城三首 其一","author":"杨万里","text":"山自新亭走下来，化为一虎首重回。\n平吞雪浪三江水，卧对雨花千丈台。\n点检故城遗址在，凄凉浩叹宿云开。\n六朝踪迹登临遍，底事兹游独壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗圣神武文宪孝皇帝挽诗二首 其二","author":"杨万里","text":"更造今光武，中兴昔武丁。\n云昭河洛画，天作典谟经。\n立极馀三纪，颐神再一星。\n尧山邻禹穴，松雪蔚争青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗圣神武文宪孝皇帝挽诗二首 其一","author":"杨万里","text":"芒动长星帚，亲挥却日戈。\n再令天有柱，一定海无波。\n黄屋非尧乐，薰琴付舜歌。\n祗书魏荡字，诔语不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高枧石岭雨中云气蔽亏山色隐显","author":"杨万里","text":"绝顶仙人富宝熏，水沉山子不论斤。\n堆从平地到天半，并作清香一炷焚。\n烟绕翠鬟苍玉佩，身披白縠素罗裙。\n更将万斛蔷薇露，酒作桑麻万顷云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿乐平县北十里西塘","author":"杨万里","text":"破店能无漏，孤灯肯更明。\n中间通客路，终夜有人声。\n坐又坐不得，眠来眠未成。\n如何故山友，抵死怨躬耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿兰溪水驿前三首 其三","author":"杨万里","text":"水色秋逾白，山光夜不青。\n一眉画天月，万粟种江星。\n小酌居然醉，当风不觉醒。\n谁家教儿子，清诵隔疏棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿兰溪水驿前三首 其二","author":"杨万里","text":"合眼波吹枕，开篷月入船。\n奇哉一江水，写此二更天。\n剩欲酣清赏，翻愁败醉眠。\n今宵怀昨夕，雨卧万峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿兰溪水驿前三首 其一","author":"杨万里","text":"系缆兰溪岸，开襟柳驿窗。\n人争趋夜市，月自浴秋江。\n灯火疏还密，帆樯只更双。\n平生经此县，今夕驻孤幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿白云山奉圣禅寺","author":"杨万里","text":"径夹长松照地青，眼看高阁与云平。\n出林殿脊先知寺，满路花枝未见莺。\n上到峰头千嶂合，下临岭脚一溪横。\n山寒入骨冰相似，冰杀人来却道清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿龙回","author":"杨万里","text":"大熟虚成喜，微生亦可嗟。\n禾头已生耳，雨脚尚如麻。\n顷者官收米，精于玉绝瑕。\n四山云又合，奈尔老农家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿池州齐山寺即杜牧之九日登高处","author":"杨万里","text":"我来秋浦政逢秋，梦里曾来似旧游。\n风月不供诗酒债，江山长管古今愁。\n谪仙狂饮颠吟寺，小杜倡情冶思楼。\n问著州民浑不识，齐山依旧俯寒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿鸡林坊二首 其一","author":"杨万里","text":"路觉往而复，意迷东与西。\n元来八九渡，只是一条溪。\n亭午虽微暑，兹辰较少泥。\n诸峰云上出，不但与云齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿鸡林坊二首 其二","author":"杨万里","text":"草有清无俗，田生不用耘。\n菰花雕品字，荇叶缺钱文。\n出水浮难没，遥风净更芬。\n物情岂难状，作么未前闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]