[{"title":"赠术士罗公弼","author":"李新","text":"陂迥山空溪水浅，骑牛信牛行自远。\n大翁织笠六铢轻，阿母理衣蓑直软。\n短笛叫云无曲终，年年但见岩花红。\n何者为荣何等辱，牛饱归来睡亦足。\n识字无多浪得官，出门车折舟风澜。\n当时牧牛无许事，初信人间行路难。\n罗生邂逅孤城角，细数直推期命薄。\n五福无有六极全，四字干头三字恶。\n逆知大似他心通，元辰空亡那免穷。\n壬癸是非终可畏，收拾人情称晚贵。\n我家幸有石田在，梦里归耕心未改。\n季咸再见应茫然，壶子而今藏九渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠翟提刑 其一","author":"李新","text":"云麦供羞荐紫阍，里闾初识子威孙。\n千年海骨蟠桃实，六日天眉画桂痕。\n饱见雪霜威剑阁，行看松柏老夷门。\n石麟下作人间客，故有光芒扫夕昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜月吟","author":"李新","text":"飘飘青女颜如花，云軿羽盖乘烟霞。\n手持凤尾青锦纹，扫空飒飒飞琼沙。\n嫦娥孤栖宫四寂，倚柱长吟愁永夕。\n曳裾摇佩渡明河，闲弄银波洗虚碧。\n婵娟相如争清夜，素彩寒光色相射。\n金乌翻树不成栖，哑哑半夜绕林啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祭先农","author":"李新","text":"帝先农功，曰惟孟春。\n载耒与耜，昕及南亩。\n穜稑薿薿，以布以种。\n帝躬三推，土膏雷动。\n百工比栉，其耕泽泽。\n岁约有年，裕帝之德。\n我艺我黍，我敛我稷。\n为醴为酪，斟酌吉礼。\n吉礼既至，神祇来游。\n燕及祖考，万邦作休。\n降福孔穰，飶芬其羞。\n于以正辞，亦又何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送菜徐秀才 其四","author":"李新","text":"增添庾郎方丈，掇拾仪休弃遗。\n但令门人学圃，不妨夫子下帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送菜徐秀才 其一","author":"李新","text":"吏部齑盐满腹，先生苜蓿盈盘。\n珍重寻常痴客，不作膏粱眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送菜徐秀才 其二","author":"李新","text":"食荠已甘予口，送荼聊苦君肠。\n见说舐砧无分，借令轑釜何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送菜徐秀才 其三","author":"李新","text":"黄精末有积雪，晚菘犹带寒烟。\n虽辜主父九鼎，不减何郎万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"李新","text":"杨柳梢头春色重，紫骝嘶入残花。\n香风满面日西斜。\n只知闲信马，不觉误随车。\n已许洞天归路晚，空劳眼惜眉怜。\n几回偷为掷花钿。\n今生应已过，重结后来缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 秋怀","author":"李新","text":"千古人生乐事稀。\n露浓烟重薄寒时。\n菊花须插两三枝。\n未老功名辜两鬓，悲秋情绪入双眉。\n茂陵多病有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 书所见","author":"李新","text":"雨霁笼山碧破赊。\n小园围屋粉墙斜。\n朱门闲掩那人家。\n素腕拨香临宝砌，层波窥客擘轻纱。\n隔窗隐隐见簪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摊破浣溪沙/山花子","author":"李新","text":"几度珠帘卷上钩。\n折花走马向扬州。\n老去不堪寻往事，上心头。\n陶令无聊惟喜醉，茂陵多病不胜愁。\n脉脉春情长不断，水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李新","text":"在昔岷峨神，龙文而马首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赠华阳洞隐者 其二","author":"李楙","text":"天上神仙白玉扉，春云谁绣六铢衣。\n人间传得新诗句，为有高僧到紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赠华阳洞隐者 其一","author":"李楙","text":"句容郭里望三峰，绿翠芙蓉杳霭中。\n安得与君骑两鹿，碧岩深处听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山家","author":"李楫","text":"日长无客到山家，藓晕封苔一径斜。\n睡美不知中夜雨，起来惊落半岩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有约","author":"李楫","text":"杨柳垂堤水绕门，可人清景近黄昏。\n明朝有约谁先到，手掐花梢记月痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春曲","author":"李楫","text":"春欲归何处，流莺也不知。\n只应江上水，暗与落花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花","author":"李楫","text":"拾得红英不忍残，殷勤更觅旧枝安。\n情知不似开时好，犹胜溪头水面看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题昼寝宫人图应制","author":"黄泳","text":"御手指婵娟，春风昼日眠。\n粉匀香汗湿，髻压鬓云偏。\n柳妒眉间绿，桃惊脸上鲜。\n梦魂何处是，应绕帝王边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南楼","author":"李猷卿","text":"三面江光抱城郭，四围山势锁烟霞。\n马鞍岭上浑如锦，伞盖门前半是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访南山许真人故居","author":"李稙","text":"穿云策杖岸乌纱，来访南山羽客家。\n九转既成丹灶冷，半池烟水浸桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李简","text":"向来红与紫，随流去如云。\n虽有故枝在，花落何纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯时番王礼佛图卷","author":"李简","text":"佛身充满大千界，莲座玄谈海水翻。\n融摄群修證圆觉，灵通虚彻卓然存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李简","text":"挹香不盈怀，餐英淡无味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李简","text":"山绕一城藏古寺，江连二水送孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十六","author":"李缜","text":"行人将底酬春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"李缜","text":"仙衣襞积素中单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李缜","text":"鶗鴃一声春事空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"李缜","text":"莫嫌春浅花房小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李缜","text":"南园北园花满风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十七","author":"李缜","text":"蜂撩蝶嬲不相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"李缜","text":"疑是西湖处士魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李缜","text":"借发明年最早花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"李缜","text":"惆怅晚来风定后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十","author":"李缜","text":"何人月下此幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十一","author":"李缜","text":"江头千树玉模糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李缜","text":"客愁春恨两茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"李缜","text":"似嫌时世妆梳浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"李缜","text":"兰替天香蜜替黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十四","author":"李缜","text":"童初宫里雨斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"李缜","text":"眼明初识道家装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李缜","text":"疑与月相吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"李缜","text":"从教革带减诗镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"李缜","text":"直似山阴雪下时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十九","author":"李缜","text":"驼裘几折犯寒花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十二","author":"李缜","text":"天与风流春与娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三十二","author":"李缜","text":"可怜风味故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"李缜","text":"女鬟誇巧幻寒芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十三","author":"李缜","text":"暗香都自著人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"李缜","text":"可怜几许怀春意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"李缜","text":"又遣相思梦到家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"李缜","text":"酥滴寒英露滴香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李缜","text":"岂待世间桃李风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十五","author":"李缜","text":"浅笑微颦尽断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李虞卿","text":"上岭浑如鱼贯柳，下山恰似雁排空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楮衾","author":"李谨思","text":"相亲赖有楮先生，雪与阳春指顾成。\n狐白温温疑伯仲，龟纹隐隐见纵横。\n夜阑更作封章梦，晨起犹闻展卷声。\n垂老未忘钻故纸，三生飞气太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠李节妇","author":"李谨思","text":"猝猝多羝屈，幽幽独雉经。\n借渠施粉黛，聊与照丹青。\n孤槥何年寄，重泉底处扃。\n有人能缩地，不隔短长亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王以道三丧未举","author":"李谨思","text":"岂无一弓地，载子三世碑。\n碑端语云云，碑下冢累累。\n白杨秋气深，碧草春露滋。\n翻怜会稽山，禹穴不得窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"李谨思","text":"月香水影眩锦画，冰魂雪骨酣华春。\n神仙狡狯本玩世，处士游侠聊惊人。\n怒艴不顾杀气横，忠赤自与晴曦亲。\n山林著汝吾未许，绛衣朱襮鏖缁尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀古","author":"李谨思","text":"昔我从耆英，图史娱朝昏。\n咄嗟陵与谷，永谢西州门。\n梦中亦识路，欲往先销魂。\n往还无须臾，失声强复吞。\n西山照公槛，南山亘公垣。\n平生五亩池，东海遥崩奔。\n公门山海并，遂斡造化元。\n招公在薇菊，酬公有佳尊。\n行吟闻地籁，飞奏劘天阍。\n公来月星悬，公归江汉翻。\n六籍未渠央，百圣谅斯存。\n翩翩媚学子，风节当谁敦。\n我发日以变，洮面留心源。\n庶无骍汗流，独此清泪痕。\n英英出灵变，杳杳通绪言。\n因风荐商参，秋思随孤骞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"补疏斋题鹅湖","author":"李谨思","text":"客来谁与期，微钟度山椒。\n松风如起予，间以笙与箫。\n逸响谅斯存，幽踪莽难招。\n极目不知还，新诗坐泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄进士熊退斋 其一","author":"李谨思","text":"犹存火后书，罕识卷中字。\n无笔补玄经，有金酬载记。\n漫漫岁月驰，忽忽春秋閟。\n欲辨已忘言，涕泪空垂泗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题文丞相吟啸集","author":"李谨思","text":"南人不识两膝贵，曲摺百态卑且劳。\n斯人护膝不护头，故以颈血沾君刀。\n蟠胸孤愤擘不碎，杀气千丈缠旌旄。\n援桴亲鼓尽南海，背水更用蜑丁鏖。\n俘来吮血语神语，咄咄尚与天争豪。\n须臾赤日减颜色，玄云莽莽风飕飕。\n或言巨灵收拾付真宰，读罢拊臆生长号。\n又言丰隆列缺对愁绝，疾指玉鞭鞭六鳌。\n雨瓢倒翻水怪舞，斗枢横轧天籁号。\n怜伊肝胆苦复苦，亦见曩昔真离骚。\n劫灰满地莫挂眼，蓬莱虽远容轻舠。\n长驱疠鬼尚堪战，尽闲未许飞仙遨。\n乃言兴废在尔不吾与，吾死吾主吾焉逃。\n鲁叟闻言拍手笑，斯人六经为骨为皮毛。\n斯人捲取六经去，空将赝本传儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"李嘉龙","text":"江湖牢落叹蘧年，说着乾淳泪泫然。\n折桂昔为天上客，餐松今作洞中仙。\n南窗寄傲陶元亮，东海归来鲁仲连。\n紫凤天吴颠倒褐，抱琴又泛楚江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次袁尚书巫山十二峰二十五韵","author":"李嘉谋","text":"道人爱山出天姿，自谓计黠人嫌痴。\n独游名山看不足，每得胜处行为迟。\n谁人能知物外赏，世上自有灵中奇。\n一行作吏困汩没，便与好境相参差。\n脱兔投林今适愿，穷猿得木吾何之。\n芒鞋竹杖恣如往，烟蓑雨笠长相随。\n青山愈好足力尽，此意未止驽骀疲。\n路逢行人说大尹，正见谕蜀扬舲旗。\n好贤招邀每虚席，问俗疾苦时褰帷。\n才华落落清庙器，诗笔粲粲珊瑚枝。\n胸吞楚泽八九尽，气压巫峡群山低。\n大峰联娟争媚妩，苍壁徙倚供游嬉。\n巴东巴峡古所重，作云作雨今胡为。\n有情飞鸢送迎客，无数棹歌来去时。\n昔日画图曾见者，何意忽此今逢兹。\n迩来丰碑在人口，已与流水争东驰。\n政用中和得大体，智出毫末非全施。\n不与英声流上国，已有诗卷传江湄。\n狼烽长閒士鼓腹，耕陇不见愁生眉。\n都门髣髴记分袂，蜀道脩阻常支颐。\n持谒见公敢论旧，抚髀顾我清无缁。\n樽俎频开闲共话，歌讴聊与民同嘻。\n忽然晨旦往东壁，但见山月来峨嵋。\n行吟何独壮三峡，在处山林来乞诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清虚庵皇甫真人坦之隐居","author":"李塾","text":"宝墨光分眄禁春，超然晏坐寂怡神。\n力辞汉殿从游乐，乞得康庐自在身。\n黄屋记曾参扈从，白衣犹忆指山人。\n恐虚立马前宵梦，柱下无材忝世臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八六子 次筼房韵","author":"李演","text":"乍鸥边、一番腴绿，流红又怨苹花。\n看晚吹、约晴归路，夕阳分落渔家。\n轻云半遮。\n萦情芳草无涯。\n还报舞香一曲，玉瓢几许春华。\n正细柳青烟，旧时芳陌，小桃朱户，去年人面，谁知此日重来系马，东风淡墨敧鸦。\n黯窗纱。\n人归绿阴自斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"声声慢","author":"李演","text":"轻鞯绣谷。\n柔屐烟堤，六年遗赏新续。\n小舫重来，惟有寒沙鸥熟。\n徘徊旧情易冷，但溶溶、翠波如縠。\n愁望远，甚云销月老，暮山自绿。\n嚬笑人生悲乐，且听我尊前，渔歌樵曲。\n旧阁尘封，长得树阴如屋。\n凄凉五桥归路，载寒秀、一枝疏玉。\n翠袖薄，晚无言、空倚修竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 夜宴燕子楼","author":"李演","text":"芳水戏桃英。\n小滴燕支浸绿云。\n待觅琼觚藏彩信，流春。\n不似题红易得沈。\n天上许飞琼。\n吹下蓉笙染玉尘。\n可惜素鸾留不得，更深。\n误剪灯花断了心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 次筼房韵","author":"李演","text":"采芳苹，萦去橹。\n归步翠微雨。\n柳色如波，萦恨满烟浦。\n东君若是多情，未应花老，心已在、绿成阴处。\n困无语。\n柔被褰损梨云，间修牡丹谱。\n妒粉争香，双燕为谁舞。\n年年红紫如尘，五桥流水，知送了、几番愁去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 多景楼落成","author":"李演","text":"笛叫东风起。\n弄尊前、杨花小扇，燕毛初紫。\n万点淮峰孤角外，惊下斜阳似绮。\n又婉娩、一番春意。\n歌舞相缪愁自猛，卷长波、一洗空人世。\n闲热我，醉时耳。\n绿芜冷叶瓜州市。\n最怜予、洞箫声尽，阑干独倚。\n落落东南墙一角，谁护山河万里。\n问人在、玉关归未。\n老矣青山灯火客，抚佳期、漫洒新亭泪。\n歌哽咽，事如水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]