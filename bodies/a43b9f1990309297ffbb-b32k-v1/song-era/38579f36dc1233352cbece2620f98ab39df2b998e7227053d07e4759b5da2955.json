[{"title":"次韵王功达见寄","author":"许景衡","text":"乌府参风宪，鲰生负德音。\n投閒虽白首，体国尚丹心。\n天上浮云散，江边秋色深。\n第知歌击壤，宁复赋愁霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈仲山见寄","author":"许景衡","text":"风雨江湖梦，衣裳京洛尘。\n人生皆物役，海内岂吾贫。\n丈室虽多病，邻翁或可亲。\n杖藜元有约，会见往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵似之运使奉呈左经臣兄二首 其一","author":"许景衡","text":"江海閒来久，篇章老更新。\n蒿莱犹自饱，天地岂吾贫。\n旧友今持节，诸郎亦可人。\n应怜未归客，白首尚红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵似之运使奉呈左经臣兄二首 其二","author":"许景衡","text":"酒胆他年大，诗名近世无。\n山林多避寇，里巷笑为儒。\n老去慵开眼，秋来欲染须。\n凉风千万里，的的为南图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄许乐清冲辅","author":"许景衡","text":"入竹空陈迹，经行忆岁除。\n旧游谁更在，逸兴近何如。\n树密莺声远，江寒雁影疏。\n楼头红日晚，徙倚独踌蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾汝器既别奉寄","author":"许景衡","text":"忆在西斋日，斯文得细论。\n别离空岁月，飘泊任乾坤。\n把酒馀风味，看云各泪痕。\n扁舟独归处，烟水暮昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张德祥","author":"许景衡","text":"细草碧侵池，幽花亦满枝。\n群生俱有德，造物定谁私。\n故国春将暮，他乡日自迟。\n论文一樽酒，何路得追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄竹阁臣师","author":"许景衡","text":"鹿苑西湖上，乌台北斗旁。\n尘沙空自老，云外定相望。\n林麓馀秋色，郊原半夕阳。\n惟应阁前竹，凛凛带新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄沈亨老","author":"许景衡","text":"京国三千里，人来慰所思。\n遥知为客好，何似在家时。\n春日鸾凰去，秋风鸿雁悲。\n衣裳慈母线，亦恐汝归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄薛十七巨源","author":"许景衡","text":"茅屋西山曲，携书喜见过。\n别离惊岁月，淹泊奈时何。\n末俗皆浮诞，斯文肯琢磨。\n后生馀力在，吾意已蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄钱子勉","author":"许景衡","text":"花县逢迎日，琴堂宴坐频。\n簿书时有暇，灯火夜相亲。\n世系皆王泽，官曹独海滨。\n政成飞舄去，念别一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题张学士三径堂二首 其一","author":"许景衡","text":"留侯有高致，世业更谁传。\n苕霅新开径，蓬瀛旧集仙。\n藜床荫松桂，蕙帐带云烟。\n扰扰争毫末，何人解乐全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题张学士三径堂二首 其二","author":"许景衡","text":"我欲寻三径，长歌归去来。\n未能似夫子，还是走尘埃。\n彩笔临流赋，清樽对菊开。\n披榛往来处，东望思悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纵目轩诗","author":"许景衡","text":"真人已仙去，释子在高岑。\n暮色江山远，春风草木深。\n何人与题咏，今我亦登临。\n纵目皆云尔，谁知有纵心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行役诗","author":"许景衡","text":"行役无时节，春来又几时。\n柳条随处处，梅蕊亦枝枝。\n弱质曾无取，斯文祇自宜。\n眼边新物色，驻马暮江湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石泉小轩","author":"许景衡","text":"泉裂碧岩腹，玆焉复小渠。\n泓澄元有在，溉濯乃其馀。\n孤迹寄江海，三年困簿书。\n閒来俯清浅，感叹独踟躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"土山驿诗","author":"许景衡","text":"渺渺指沧海，行行过汉陵。\n衣裳千里雪，鞍马九河冰。\n寓宿适有处，悲歌自不胜。\n平生少游语，耿耿对寒灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴 其一","author":"许景衡","text":"南州苦卑湿，梅熟复何如。\n老夫厌巾屦，稚子在泥涂。\n新月出天末，微凉生雨馀。\n陶公入州府，此兴与谁俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚晴 其二","author":"许景衡","text":"天街经暑雨，乌府绝尘氛。\n跃马人皆散，新蝉我独闻。\n风生初罢扇，日转渐无云。\n寄语同时客，清凉尚可分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驻马诗","author":"许景衡","text":"驻马长河曲，穿林小径斜。\n犹能寻隐逸，可是厌泥沙。\n轩冕虽无意，田园尚有涯。\n何时策筇竹，随意到山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"许景衡","text":"台奴初学语，丹子已能行。\n问叔今何处，嗔爷太懒生。\n会令主门户，岂复意功名。\n坐对江湖晚，横塘舟自横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野外","author":"许景衡","text":"野外连荒草，楼头正夕阳。\n凭栏空远目，何处是吾乡。\n王粲从军乐，少陵羁旅伤。\n男儿知底事，出处两难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿僧房","author":"许景衡","text":"捕逐虽王事，经行亦自强。\n舣舟当海岛，寓宿得僧房。\n绝境三山在，清风一水长。\n此生空物役，回首意茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜过杜家村","author":"许景衡","text":"驻马问村老，却言行未迟。\n路虽十里远，月到四更时。\n我去良有役，子眠宁负期。\n人生随意好，冷笑一题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送师颜致康深道入京","author":"许景衡","text":"二子今西去，赠言聊尔规。\n勉哉精素业，行矣仕明时。\n破腊梅先蕊，含春柳欲丝。\n江边人散后，帆影渐参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上章倅二首 其一","author":"许景衡","text":"海内名闻久，江边岁复期。\n美才由世济，清节畏人知。\n郡国已无事，朝廷方有为。\n会参鸿雁序，归去凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上章倅二首 其二","author":"许景衡","text":"簿领勤官府，声名振士林。\n虽云心尚在，自觉力难任。\n岁月淹多病，江山入苦吟。\n高堂昔三叹，亦恐负知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远意","author":"许景衡","text":"远意诚难问，狂歌自不禁。\n花光春灼灼，月色夜沉沉。\n简册终何事，江湖独此心。\n野禽多意绪，飞集近寒林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横塘","author":"许景衡","text":"好在横塘水，人今去几年。\n秋光空到地，霁色自连天。\n伐石围高岸，诛茅驾短椽。\n归欤此心在，何苦利名牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"节物诗","author":"许景衡","text":"江水西风急，江天作暝阴。\n乡山犹在眼，节物莫惊心。\n是处皆秋穫，谁家急暮砧。\n薄游愧妻子，飘荡到而今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻子瞻南迁","author":"许景衡","text":"陇蜀崎岖外，炎荒闻望中。\n黑头方世用，青眼忽途穷。\n遂作天涯客，何如塞上翁。\n幽愁还有作，笑杀赞皇公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺人祖父生辰","author":"许景衡","text":"青春嘉诞日，八十渭川师。\n林下有真乐，人间无愧辞。\n松梢看舞鹤，荷叶隐巢龟。\n赖有荣孙子，蓝袍荐寿卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴子思","author":"许景衡","text":"花县初相见，清樽日笑歌。\n交情论厚薄，客路自蹉跎。\n历历功名意，骎骎岁月多。\n岂知同夜宿，还问命如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠姚仪甫","author":"许景衡","text":"年少开千卷，生涯祇一瓢。\n声名动场屋，意气在云霄。\n素发今垂领，青衫尚折腰。\n未应轻斗禄，吏隐本逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠张承老","author":"许景衡","text":"永裕躬神武，开边绝汉西。\n虽云拥貔虎，犹未斩鲸鲵。\n吾子名家后，当年训士齐。\n天涯思往事，回首祇悽悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题寿圣院","author":"许景衡","text":"古寺重门里，回廊一径幽。\n水声长带雨，山色最宜秋。\n寓宿已多日，题诗更少留。\n此生随利禄，行路日悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题叶希圣申申亭 其一","author":"许景衡","text":"燕处厌纷华，穿林一径斜。\n层峦开水墨，古木走龙蛇。\n事业虽无补，田园尚有涯。\n何时策筇竹，随意到山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题叶希圣申申亭 其二","author":"许景衡","text":"每向新亭去，何曾问主人。\n弟兄俱有好，樽俎自相亲。\n栖翼云山晚，飞花洞府春。\n长愁醉归去，步步近红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙大夫绝尘亭诗","author":"许景衡","text":"丈人乐高旷，阅世等樊笼。\n池馆重城外，尘沙一笑空。\n红蕖新过雨，修竹自生风。\n未必全违俗，杯盘与客同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上","author":"许景衡","text":"十里西城去，春风水拍堤。\n画船帘幕动，别殿筦弦齐。\n勿觉仙山远，相将醉路迷。\n红尘竞回首，斜日杏花西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"许景衡","text":"不知何处出，牢落水村边。\n隐隐犹含雨，飞飞欲近船。\n诗书看老矣，事业尚茫然。\n今夕知何夕，篷窗犹未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去国","author":"许景衡","text":"诗书元有志，耕养苦无田。\n去国何为者，题诗独慨然。\n庙堂修政事，郡国奏丰年。\n五斗虽云薄，馀生得醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"升之兄见访竹阁","author":"许景衡","text":"飞盖山城外，寻幽鹿苑中。\n层轩不受暑，修竹自生风。\n江海多年别，杯盘一笑同。\n平湖吞晚照，归棹惜匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题会文阁","author":"许景衡","text":"刘子天台去，君今几代孙。\n山居多水石，客至亦琴樽。\n簿领嗟淹泊，诗书失讨论。\n何当谢羁束，杖策过层轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亚叟惠腊粥次韵","author":"许景衡","text":"飞琯迎长候，香糜入腊新。\n交情最怜客，节物独惊人。\n云意安排雪，梅香告报春。\n病中疏酒盏，兀坐惜芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"许景衡","text":"河南闻誉久，汉上定交新。\n遗粥聊从俗，题诗更可人。\n归期恨不早，旅思怯逢春。\n他日从谁饷，长怀腊八辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邱隐夫传神","author":"许景衡","text":"曹霸逢佳士，慇勤为写真。\n今君仍妙笔，顾我独何人。\n轩冕曾无意，功名敢问津。\n会须添杖屦，却作自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左司江公 其一","author":"许景衡","text":"前辈风流远，惟公尚复存。\n此心无限量，所得有渊源。\n眷奖深宸扆，声名重谏垣。\n平生经世志，已矣复何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左司江公 其二","author":"许景衡","text":"壮岁从澹泊，犹馀味道心。\n今朝叹流落，羁旅老侵寻。\n庾岭暮云合，钓台秋水深。\n向来游历处，千载只如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽左司江公 其三","author":"许景衡","text":"宪府叨新渥，京华会卜居。\n迂疏惭琐琐，许与独渠渠。\n酬唱看遗墨，漂零送輤车。\n他年桐水上，雪涕更踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楼朝议挽辞 其一","author":"许景衡","text":"金闺早通籍，银兔屡分符。\n文采倾簪笏，讴谣足裤襦。\n联荣看子舍，从养亦神都。\n八十终天禄，朋侪更有无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楼朝议挽辞 其二","author":"许景衡","text":"东南独耆德，湖海老门生。\n未厌遗簪旧，频烦倒屣迎。\n音容忽冥漠，岁月又峥嵘。\n梦入鄞江路，依稀晚柝声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴师常","author":"许景衡","text":"吴君久羁旅，所至即为家。\n倾倒贤人酒，浮游仙客槎。\n此身惟愿健，万事尽从他。\n闻说今归矣，田园亦有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送萧德宏","author":"许景衡","text":"孤屿何时别，双溪累月留。\n父兄安契阔，庠序得优游。\n宿雾散初日，春风乘去舟。\n好看清汴水，渺渺带伊流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李季成","author":"许景衡","text":"花入新年好，传觞日倚栏。\n故人从此别，春色更谁看。\n洒落馀篇翰，芬芳识蕙兰。\n片帆天际晚，回首独江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李忠彦","author":"许景衡","text":"留滞嗟为客，而今始据鞍。\n梅花春信早，星斗夜堂寒。\n此别十分饮，何时一笑欢。\n劳生强半在，见晚不须叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德祥四首 其一","author":"许景衡","text":"天上张公子，河间善最多。\n三年种桃李，万室自弦歌。\n北阙今归去，斯民奈别何。\n会将清禁月，千里照嘉禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德祥四首 其二","author":"许景衡","text":"天上张公子，同时桂籍人。\n江湖嗟迹远，关塞独情亲。\n鸿鹄宁无志，骅骝已绝尘。\n音书怜旧好，别后莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德祥四首 其三","author":"许景衡","text":"好去张公子，依然别后深。\n霜清风槭槭，野旷马骎骎。\n奕世皆荣问，连枝复好音。\n青云多意绪，宁复故人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德祥四首 其四","author":"许景衡","text":"好去张公子，离歌尽一尊。\n朝廷方北顾，父老惜南辕。\n禦侮从先志，招携亦旧恩。\n须君对宣室，为我折群言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽元僧正","author":"许景衡","text":"物外孤高客，人间九十春。\n朋游多有道，学子略成尘。\n仙岭浮云散，寒潭夜月新。\n孤生长感怆，先友更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其一","author":"许景衡","text":"井邑遗孤垒，渔樵尚几家。\n洪河散陵谷，古冢入桑麻。\n燕子初经节，蜂儿几报衙。\n此身天地内，随处是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其二","author":"许景衡","text":"故国岂不好，卑官良为贫。\n驱驰万里去，憔悴九河滨。\n乱水才通野，幽花已绣春。\n天公浑不惜，乞与作诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其三","author":"许景衡","text":"藜藿晨昏外，诗书寤寐间。\n百年皆物役，五斗愧身閒。\n暖日花争发，春风雁欲还。\n杖藜俯清浅，萧飒鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其四","author":"许景衡","text":"谁道边城远，春风也自来。\n咿哑林鸟啭，细碎野花开。\n日压初晨雾，龙惊昨夜雷。\n郊原閒驻马，极目绝纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其五","author":"许景衡","text":"燕赵当南北，关河独郁盘。\n时平无戾气，岁闰有春寒。\n仰禄家千里，题诗思万端。\n危楼多晚照，倚遍小栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景城杂诗六首 其六","author":"许景衡","text":"冰雪初消冻，关河已见春。\n民居乐丰岁，吏隐是閒人。\n黄水鱼偏美，青帘酒亦醇。\n吾生如有计，五斗未为贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任夫人挽词","author":"许景衡","text":"荣养方南国，安舆更北辕。\n从容对孙子，闻问及平反。\n无复承颜乐，犹馀在耳言。\n会看坟上柏，千尺倚高原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄兄长","author":"许景衡","text":"江上分携日，樽前听我歌。\n安居是非少，游宦别离多。\n陋巷从颜子，斯文续孟轲。\n平生端有意，叹息自蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄三十九兄","author":"许景衡","text":"伊昔初分袂，于今几度秋。\n鹓行惭北阙，雁序忆南洲。\n湖海谁招隐，尘沙独倦游。\n平生一樽酒，好在谢公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]