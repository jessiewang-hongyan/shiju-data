[{"title":"玉壶即事","author":"黄文雷","text":"雨过条风着柳芽，淡黄浅绿嫩如花。\n陂湖漾漾初侵路，蜂燕纷纷各理家。\n带郭园林仙苑近，送春船舫绣帘遮。\n芸窗倦倚何山翠，暖霭轻笼日脚斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏蒙赐和复用韵二章拜呈可谓出丑衒媸惟自叙鄙怀并以见区区敬慕之意姑惟教之是所愿也 其二","author":"杜范","text":"学道辛勤历万艰，精神见性本无还。\n齐眉自可供瓢乐，携手何须去鹿山。\n谓介谓通非所在，不夷不惠处其间。\n自怜尘俗心犹在，即席抠衣愿少闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏蒙赐和复用韵二章拜呈可谓出丑衒媸惟自叙鄙怀并以见区区敬慕之意姑惟教之是所愿也 其一","author":"杜范","text":"道在行藏自古艰，为贫偶出未能还。\n一从举手遮西日，已恐移文在北山。\n身入微官缰锁里，心惭大隐市朝间。\n浮云富贵非吾事，便有功名亦等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再依韵复足五十六字以见一时无聊之态非诗也","author":"杜范","text":"人间总是一虚空，过眼流光过耳风。\n方见露芽墙下茁，又嗟霜叶岭头红。\n身来作吏双溪上，谁使冲寒一寺中。\n急雪随风穿瓦过，强呵冻手作诗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赋段桥风筝","author":"杜范","text":"段桥牵纸鹞，儿戏亦关心。\n风快应难挽，云高径欲侵。\n人誇无限力，身直不多金。\n说与须知道，明朝不似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"杜范","text":"捧檄来兹邑，劳劳两载馀。\n亲庭千里隔，家信十分疏。\n有妇闻多病，诸儿尽废书。\n低檐秋雨滴，点点正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次会再和","author":"杜范","text":"古殿后多竹，虚檐前可床。\n炎歊于此却，胸次要人当。\n自足萧萧意，时来细细香。\n曲肱无一事，闲为属诗忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁冬日三诗 其二","author":"杜范","text":"人心天理两相关，无奈花翁尽日闲。\n丽服靓妆纷拜节，弊衣短策自怡颜。\n已闻瞥尔寻幽去，又见陶然向市还。\n住世世尘尘不染，梅花好处即孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁冬日三诗 其一","author":"杜范","text":"料理新阳在此朝，休文但觉带宽腰。\n懒将漫刺巡门到，病怕时人举酒邀。\n强裹青衫空自累，满簪白发不相饶。\n冥心久矣随天付，九转还丹不用烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁冬日三诗 其三","author":"杜范","text":"翛然僧舍一柴扉，淡泊如君眼底稀。\n山泽肯为仙骨瘦，襟怀自得遁身肥。\n有诗盈帙遮空橐，无酒留宾办典衣。\n一棹稽山风雪里，便应兴尽雪中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁自笑韵","author":"杜范","text":"村翁活计谢田庄，肯与时人较短长。\n馀事诗篇陵鲍谢，太平胸次到黄唐。\n以通为隐浑无碍，有乐偿贫似略当。\n自笑此生成鹘突，谁知鹘突正难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁第二雪","author":"杜范","text":"创见飞琼粲晚华，已闻得句压刘叉。\n乱随风势斜穿户，谁在云端巧雨花。\n恼杀饥乌寻屋角，寒惊宿雁失汀沙。\n此时清绝难酬赏，羔酒谁言胜凤茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次花翁喜雪快晴韵","author":"杜范","text":"何人急急走灵符，扶醒摐摐十万夫。\n隘巷未收穿履迹，短檐已倚晒书儒。\n日开雪色如翻手，景属诗家费撚须。\n起望四山新入画，翠屏半是粉成图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次陈友韵","author":"杜范","text":"企望邻邦百里赊，一时文物数名家。\n惊人议论铿苍佩，落笔词章粲彩霞。\n此日相逢真有幸，何年重会恐无涯。\n顾余何以为君别，多愧新诗屡拜嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次郑府判金字韵","author":"杜范","text":"巇岖来北固，邂逅识南金。\n未觉人间役，欣同物外心。\n灯花残夜半，桂子落秋深。\n细听朱弦曲，寥寥大雅音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵草堂","author":"杜范","text":"心事崔嵬日不如，愁端丛起蔓难图。\n残山剩水鸟声怨，落日微云雁影孤。\n妙句耸闻惊昨梦，寒窗细读慰来苏。\n许身已在羲皇上，降志犹能念昔吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟早行将至三界偶成","author":"杜范","text":"辞京尘渐远，入越思逾清。\n雨壑溪方涨，风帆去又轻。\n天光浮水阔，山色带云横。\n更问乡关路，从今尚几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别宛陵同官","author":"杜范","text":"游宦见交情，惟忧间易生。\n文书祇自了，意气若为倾。\n幸已符金断，终然为玉成。\n官僚有如此，共保岁寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十九兄梅韵二首 其二","author":"杜范","text":"语别星霜久，怀人道里长。\n江山高著眼，文字饱撑肠。\n穷壑生新态，寒梅带旧香。\n它年当记忆，有雁过衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十九兄梅韵二首 其一","author":"杜范","text":"空谷寒花好，荒村野路长。\n有怀寻往事，无语搅枯肠。\n老气犹无恙，幽姿只自香。\n喜君歌白雪，茂对此新阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和十四兄灵岩偶作","author":"杜范","text":"松关开野寺，山色净藜床。\n战局谁争胜，夸声或大当。\n有人观物静，得句满囊香。\n鸥鹭盟犹在，闲中作此忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙司门寄宽堂诗 其二","author":"杜范","text":"靖节非沉湎，行藏岂漫游。\n几多经济具，可付醉吟休。\n志在存周鼎，悲能学楚囚。\n流风千载想，我欲赋登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和孙司门寄宽堂诗 其一","author":"杜范","text":"官喜文书少，尘迷岁月迁。\n岂无车可出，傥有约宜坚。\n傍水寻疏影，裁诗续旧编。\n孤山须竟日，去莫买游船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴准斋所赓刘石涧咏湖山之乐因见示韵","author":"杜范","text":"胜赏付飞觞，诗人妙嚼芳。\n荷君相抆拭，容我共清凉。\n湛俗人空老，偷闲策最长。\n高峰应更好，何日曳桄榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨兄五言二首 其二","author":"杜范","text":"纳履终朝役，挑灯独夜思。\n功名非我事，风月负君诗。\n菽水谋多拙，山林计未迟。\n江村梅正好，珍重岁寒期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨兄五言二首 其一","author":"杜范","text":"羁栖馀两载，尘扰费三思。\n愧匪江陵掾，空多东野诗。\n佩囊无限富，击钵已嫌迟。\n细读停云句，多应负所期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨兄两诗 其一","author":"杜范","text":"鲁教寂寥邹辨已，异端塞路日殷繁。\n宝丝远缉千年绪，古鉴新磨一世昏。\n正道以身为屏翰，真儒于此见渊源。\n缄来遗像知君意，百世师模俨若存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨兄两诗 其二","author":"杜范","text":"望断家山两地悬，白云何处涕潸然。\n吏尘岁月知无几，宦海风涛幸有边。\n已是雪霜催岁晚，又还花柳放春妍。\n起予妙语令深省，碧眼相看话百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和沈节推韵","author":"杜范","text":"点检春光向几多，埋头官事暗中过。\n萧萧鬓影霜先入，匝匝襟尘镜未磨。\n盟会谁令寒晋楚，篇词自幸识阴何。\n休文多病风流甚，红药尊前独醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和花翁自咏","author":"杜范","text":"愚拙天真未易全，如翁自许岂其然。\n剩将诗句酬花债，只把春衣办酒钱。\n仅六尺床皆乐地，方千里旱自丰年。\n瞿昙老子都曾学，曾学为儒也学仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宗司法与郑府判韵 其一","author":"杜范","text":"毫端收尽九秋清，凡目容窥巨海惊。\n别驾锦囊誇李贺，参军石鼎续弥明。\n珠玑错落交辉映，金石铿锵迭奏成。\n迷道愿君相指似，敢辞驽钝策孤征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宗司法与郑府判韵 其二","author":"杜范","text":"候虫啧啧泣秋清，节物还令壮士惊。\n人在九原谁可作，月横千里自增明。\n诗坛尚幸从盟约，句法于今识老成。\n自愧枯肠如罄室，只愁有债未宽征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林簿二诗 其二","author":"杜范","text":"宦途元自险于山，我辈孤寒分外难。\n萧寺羡君成胜概，新诗为我解愁端。\n自叹落落无三语，底事区区为一官。\n初夏北窗新枕簟，碧梧昼影正清团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和贵方韵","author":"杜范","text":"万物由来备一身，要教纯熟在持循。\n莫嫌恶浊浮埃界，自做分明实地人。\n培养确知心是圣，工夫岂费笔如神。\n羡君精进追前哲，愧我衰颓落世尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和耕甫弟梅","author":"杜范","text":"数点冰葩与雪宜，有人著眼水边篱。\n从渠疏影初传句，自此清吟未有诗。\n曾到孤山飞鹤处，恰思偃树跨鲸时。\n李园莫负春风约，应有当年未折枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"承见再和用韵","author":"杜范","text":"簇簇枝头缀浅黄，鼻通四远熟留藏。\n秋于对树疑添色，雨不多时怕减香。\n花事索人非易管，诗情得酒为新尝。\n丛芳德色惊人句，影下重吟驻夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗年能赴兴国前诗未作尝于醉中谩成亦并达之","author":"杜范","text":"一笑重逢二十年，自怜镜影已华颠。\n谩言世上谁知我，落在人间恐愧天。\n理到平时无一事，行须实处著千鞭。\n但教千里民安乐，莫使虚名为世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑宁夫携诗什访余并有赠篇闻其浙右之行诗以送","author":"杜范","text":"何人剥啄扣云关，袖有新诗数百篇。\n宫徵自调相和应，珠玑不拣尽光圆。\n昌黎荐士惭无路，东野盘空枉笑天。\n闻道二亲犹未葬，知谁著眼为渠怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡舟中偶成","author":"杜范","text":"日斜远浦閟朱光，烟抹前山湿翠妆。\n自有著身丘壑分，故应遣我水云乡。\n便于世上誇钟鼎，何似田间饱稻粱。\n手把黄花相问讯，秋风不改旧时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复用韵以见别情","author":"杜范","text":"插架牙签富邺侯，戏将翰墨此中游。\n紫萸黄菊家家酒，巨轴长篇字字秋。\n谈笑不堪增恋嫪，简书无奈怕淹留。\n人生聚散真萍梗，咫尺应能见九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨甲子而润泽不违时夏已更秋方虑乾涸一夕沛然优渥矣喜而写情","author":"杜范","text":"甲子谣言未足听，沛然甘泽以时行。\n平田不藉开渠水，野老谁思逐妇声。\n黄倒积云承露重，青翻长浪簸风轻。\n贱夫一饱诚为幸，更祝倾河洒甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵山甫居玉壶尽得湖山之胜醉后和其韵二章 其二","author":"杜范","text":"相见虽无几，相观却有馀。\n清襟无这样，尘世有谁如。\n文理须教密，浓醺且放疏。\n论文何日再，欲别更踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵山甫居玉壶尽得湖山之胜醉后和其韵二章 其一","author":"杜范","text":"占尽春光好，湖山一览馀。\n著身蓬岛里，纵目画屏如。\n我计还知错，君谋定不疏。\n它年同到此，卜筑莫踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵学士挽诗","author":"杜范","text":"鼎盛弹冠地，胡然袖手居。\n自怡还自足，谁毁又谁誉。\n花竹人安在，芸兰庆有馀。\n华涂惊素锦，行道尽欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻喜宴和御诗","author":"杜范","text":"清朝策士属新元，四海英髦意气轩。\n自是冕旒崇直道，亦令韦布效忠言。\n鹿苹初洽君恩重，凤藻俄颁帝语温。\n此日微臣陪镐宴，更惭兰省滥搜抡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"准斋诲人亹亹不倦某每侍几席洒然若执热之濯清风一日语及唱和新篇继复缄示联章巨轴皆相与切磋之意某辄忘其荒陋次韵二章借以求教不敢言诗也幸赦不敏而镌诲之 其二","author":"杜范","text":"倦游愈觉世途艰，远矣淳风未易还。\n车去出门多异辙，尘来眯目失前山。\n差殊只在毫釐际，迷复都来反覆间。\n珍重先生相指似，忙中自有本来闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"准斋诲人亹亹不倦某每侍几席洒然若执热之濯清风一日语及唱和新篇继复缄示联章巨轴皆相与切磋之意某辄忘其荒陋次韵二章借以求教不敢言诗也幸赦不敏而镌诲之 其一","author":"杜范","text":"著身闹市厥惟艰，渺渺狂澜荡不还。\n心莫转移真匪石，德常安重有如山。\n谈经不踵诸儒后，辨理尤严一字间。\n倾耳名言深猛省，半生日月总成闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐倅尊人挽诗二首 其二","author":"杜范","text":"论子论交事契深，同年同里又同心。\n登堂未展庞公拜，梦奠俄惊尼父吟。\n自古阴功天所予，如公遐福世同歆。\n老成渐渐凋零尽，空有潸然泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐倅尊人挽诗二首 其一","author":"杜范","text":"教子成名岂偶然，存心积善契苍天。\n独工学问驰清誉，旁习阴阳得异传。\n煞有哀荣身后事，不差生死梦中言。\n欲占厚德看铭志，七十之期过一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭谢侍读仁皇训典彻章御赐杜工部紫宸殿诗退朝口号并鞍马香茶 其二","author":"杜范","text":"丹地从容接细毡，岂徒口耳漫周旋。\n帝王家法由心法，典策言传以道传。\n章彻诵筵天意悦，恩隆赐典露华鲜。\n礼文稽古皆成宪，主德由斯志罔愆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭谢侍读仁皇训典彻章御赐杜工部紫宸殿诗退朝口号并鞍马香茶 其三","author":"杜范","text":"微臣何幸厕经帷，宠渥便蕃亦例施。\n鸾凤惊飞高晋帖，夔龙会送借唐诗。\n灵芜甘露排忧困，骏马雕鞍念老羸。\n自愧无功难称塞，孤臣耿耿只天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭谢侍读仁皇训典彻章御赐杜工部紫宸殿诗退朝口号并鞍马香茶 其一","author":"杜范","text":"于赫仁皇训典垂，宽慈实德太平基。\n鸿图植远文孙绍，燕翼谋深烈祖贻。\n宝历初更思善治，瑶编久阅抚良规。\n平平王道今犹昔，海宇雍熙庶可期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王侍郎二首 其二","author":"杜范","text":"里枌敷荫樾，昼绣借辉光。\n诱接尝登席，抠趋屡负墙。\n故山欣弭节，华屋痛帷堂。\n岁晚凋松柏，令人重慨伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王侍郎二首 其一","author":"杜范","text":"地灵钟国秀，胪唱压时名。\n虎观坚廉节，螭坳振直声。\n志随时暂郁，身与道俱荣。\n人羡腰金日，于公孰重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶子仪二首 其二","author":"杜范","text":"当年共短檠，心事熟论评。\n岂我非同志，于公不用情。\n几多才莫试，有此恨难平。\n旧友凋零尽，悲哉伐木声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶子仪二首 其一","author":"杜范","text":"性质孰无偏，工夫岂易镌。\n人谁知此学，我独谓公贤。\n耿耿存忧世，悠悠付逝川。\n一经端有属，拭目看家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘监丞二首 其二","author":"杜范","text":"奕世诗书远，三刘姓字香。\n乡评高宿望，里社借馀光。\n莲浦秋堂晚，松冈夜室长。\n典刑无复见，南望独凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽刘监丞二首 其一","author":"杜范","text":"诸老凋零尽，公胡不少留。\n麈谈裁后进，山立俨前脩。\n逸馆休黄发，为邦付黑头。\n瓯闽看蔽芾，有泪正难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李处士","author":"杜范","text":"确荦群山兀海隅，芬川蔚有吉人居。\n施仁一念周乡井，称善同声溢里闾。\n教子垂芳心有待，荣亲养老意何如。\n貤恩漫尔撑门户，肯负当年一束书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈将仕","author":"杜范","text":"事到盖棺方始定，言于陋巷乃为公。\n试看倾郭盈襟泪，尽是忘餐振廪功。\n荣贵但知崇己欲，文章未必济民穷。\n如君厚积人谁忌，惟恐君家积未丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周迪功二首 其二","author":"杜范","text":"忆昔痴儿幸，联君季氏姻。\n两家成契阔，一梦记酸辛。\n乡誉闻君子，铭章又古人。\n落花愁暮雨，凄冷不成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周迪功二首 其一","author":"杜范","text":"书种开风气，儒声动海涯。\n一门团义聚，千里择名师。\n重卦终须卜，留耕已可菑。\n贤书初入贡，玉树影参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵漕二首 其二","author":"杜范","text":"敛衽从童丱，巢枝幸里闾。\n尘踪谁抆拭，馀论借吹嘘。\n得意鸣珂地，惊嗟素锦车。\n直言公不死，兰玉秀阶除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽赵漕二首 其一","author":"杜范","text":"蔚蔚郎闱望，皇皇使节辉。\n竞时俱勇往，怀宝独言归。\n皂盖人方惜，黄粱梦已非。\n萧山遗老在，谁使涕交挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]