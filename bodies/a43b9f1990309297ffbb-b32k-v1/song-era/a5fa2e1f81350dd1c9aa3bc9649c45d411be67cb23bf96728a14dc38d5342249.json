[{"title":"春晚游宝云寺","author":"陈师道","text":"繁杏青犹小，幽花落更香。\n目随云雨断，恨与水风长。\n蚁子何缘斗，蜂儿有底忙。\n山人能弃世，游子不思乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柏","author":"陈师道","text":"用直宁论世，名成不待官。\n低枝缘我有，偃盖到谁看。\n秀色有新故，英姿无暑寒。\n要为千岁计，岂虑万牛难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烂石村","author":"陈师道","text":"乱石何年烂，千林昨夜黄。\n晓耕来鸟雀，麦垄纵牛羊。\n投老须微禄，持身阙寸长。\n洗心闻吉语，时事信难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋后五日应物无诗岂年志俱壮未解伤秋耶以诗挑之","author":"陈师道","text":"伏尽暑犹壮，秋生凉故迟。\n蝉吟接远响，萤烛度深枝。\n岁半身仍健，年侵意自悲。\n情知寇公子，不作感秋词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"陈师道","text":"稍稍昏烟集，鼕鼕一再更。\n短檠昏细字，高枕忘平生。\n来雁妨身健，新杨唤眼明。\n已须甘酒力，不用占时名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其四","author":"陈师道","text":"梨埒当千户，渔防拥万头。\n宁须一网尽，不为百人留。\n密雨点急水，惊风擘系舟。\n百年供转徙，因病得夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其三","author":"陈师道","text":"山断开平野，河回杀急流。\n登临须向夕，风雨更宜秋。\n急急后飞雁，翩翩不下鸥。\n晚舟犹小待，暮雀已深投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其二","author":"陈师道","text":"小雨断复续，回斜落晚风。\n寒心生蟋蟀，秋色傍梧桐。\n草与遥山碧，花欺晚照红。\n口须谈世事，目已失飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀四首 其一","author":"陈师道","text":"积雨不受暑，既晴还得秋。\n未免困河鱼，宁如喘吴牛。\n风梧有先声，巢燕无后留。\n人生行乐尔，一经今白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀示黄预","author":"陈师道","text":"窗鸣风历耳，道坏草侵衣。\n月到千家静，林昏一鸟归。\n冥冥尘外趣，稍稍眼中稀。\n送老须公等，秋棋未解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览胜亭","author":"陈师道","text":"断岸通横水，吹花满系船。\n中年擅幽独，辍食买林泉。\n草木真宜主，江山故作妍。\n升沉有流转，且复赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺文潜","author":"陈师道","text":"飞腾无那高詹事，奔轶难甘杜拾遗。\n释梵不为宁顾计，公侯有命却随宜。\n且留陈迹来韩愈，不用逢人说项斯。\n富贵风声真两得，穷人从此不因诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺关彦长生日 其一","author":"陈师道","text":"吉梦熊罴后，名家韦杜旁。\n风霜随气节，河汉借文章。\n汉相功名晚，周南德化长。\n欲伸千岁祝，愿奉故人觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺关彦长生日 其二","author":"陈师道","text":"经术宜传世，清明正得秋。\n德优高士传，名重赋家流。\n短袖妨妍舞，青衫负白头。\n待看灵寿杖，扶出富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵岩","author":"陈师道","text":"一市万人聚，四冲千里遥。\n胡然不作邑，兼自可成桥。\n群盗去无迹，诸家压不骄。\n由来天下事，浮议易倾摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追尊皇太后挽词二首 其一","author":"陈师道","text":"彤管书阴教，黄图载德容。\n汉宫元梦日，代邸近乘龙。\n乔岳已遗服，青门启故封。\n从今祠百世，清庙配商宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送大兄兼寄赵团练","author":"陈师道","text":"贫有分离苦，官无早晚宜。\n又为千里别，未觉十年迟。\n日与江山远，风连草木悲。\n平生刘子政，见可只论诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王元均贬衡州兼寄元龙二首 其二","author":"陈师道","text":"先生秀句满天东，二子缘渠再得穷。\n诗礼向来堪发冢，孙刘能使不为公。\n炎方瘴疠避轩豁，故国山河开始终。\n传语元龙要相识，江湖春动有来鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王元均贬衡州兼寄元龙二首 其一","author":"陈师道","text":"先生英气盖区中，命与仇谋得老穷。\n又见长身有家法，可辞短簿怒吾公。\n石头路滑行能速，宣室归来语未终。\n宛洛风尘莫回顾，直须留眼送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王君玉赴试","author":"陈师道","text":"汝颍诸王后，风流独此人。\n谈锋坚百战，笔力举千钧。\n得士吾无愧，多闻子未贫。\n平生三学士，相见定相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王定国通判河南","author":"陈师道","text":"孤身十载客都城，白社双林讳姓名。\n授馆不为他日计，解衣真出故人情。\n翘材必定延枚叟，宣室终须记贾生。\n万里归来发如漆，了知句画更新清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送冯翊宋令","author":"陈师道","text":"三楚风流信有人，先声今已彻咸秦。\n宁为鸡口官无小，欲试牛刀久要新。\n细肋卧沙勤下箸，长芒刺眼莫沾唇。\n山西豪杰知吾老，为说犹堪举万钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送外舅郭大夫夔路提点刑狱","author":"陈师道","text":"天险连三峡，官曹据上游。\n百年双鬓白，万里一身浮。\n可使人无讼，宁须意外忧。\n平生晏平仲，能费几狐裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘主簿","author":"陈师道","text":"平生师友豫章公，矻矻谈君口不空。\n半面相看吾已了，连城增价子何穷。\n三千奏牍诸儒上，四百庵寮一岁中。\n二父风流皆可继，谤禅排道不须同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江季恭","author":"陈师道","text":"正学元非世，能诗新有声。\n诸公交郑季，多士闭何生。\n泛爱经过数，移书底里倾。\n又为淮海别，病眼向谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江楚州","author":"陈师道","text":"濠梁初得意，阙里旧论诗。\n晚岁何多难，经年始一辞。\n淮人饥馑后，良吏拊循时。\n欲托山阳簿，翁归不受私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送伯兄赴吏部改官","author":"陈师道","text":"先子初增秩，年侵鬓已皤。\n念兄今善继，此别喜如何。\n亲老家仍困，门衰仕未多。\n犹须教儿子，早要中文科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何子温移亳州三首 其三","author":"陈师道","text":"复作中年别，仍怀后日忧。\n关山遮极目，汴泗只东流。\n政好遭频借，诗清得暗投。\n会看灵寿杖，扶出富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何子温移亳州三首 其二","author":"陈师道","text":"青衿曾诵赋，皓首始登门。\n意得宁论晚，心交不待言。\n向来期北上，可复改南辕。\n画地数佳政，丛谈何处村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何子温移亳州三首 其一","author":"陈师道","text":"治出龙城守，名高水部郎。\n清明人共识，风味独难忘。\n骨立秦书瘦，须粘桧密香。\n烹鲜师老耳，曳尾肯蒙庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴先生谒惠州苏副使","author":"陈师道","text":"闻名欣识面，异好有同功。\n我亦惭吾子，人谁恕此公。\n百年双白鬓，万里一秋风。\n为说任安在，依然一秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孝忠二首 其二","author":"陈师道","text":"经史三年学，聪明一旦开。\n把文甘潦倒，数日待归来。\n士患声名早，官今岁月催。\n有亲须薄禄，临路尚徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孝忠二首 其一","author":"陈师道","text":"老眼元多泪，春风见此行。\n又为贫贱别，更觉急难情。\n斗食吾堪老，词场尔向荣。\n未须怜野鹜，家法付宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孝忠落解南归","author":"陈师道","text":"妙年失手未须恨，白璧深藏可自妍。\n短发我能今种种，晓妆他日看娟娟。\n千金市帚宁论价，万户分封信有年。\n清白传家有如此，归涂囊尽不留钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张支使","author":"陈师道","text":"旷度逢知晚，高才处下难。\n清秋一鹗上，拭目万人看。\n白酒初同醉，黄花已戒寒。\n凭将衰老事，一一报长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张芝卿","author":"陈师道","text":"相逢已偶尔，告别更苍然。\n离合惊时换，行藏乃世缘。\n君无学干禄，我亦赋归田。\n泗水秋山外，长安夕照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张秀才","author":"陈师道","text":"学又三年积，功收一日长。\n擅场推老手，附尾续诸郎。\n度鸟界晴碧，过云回夕黄。\n熟知诗有验，莫愠路无粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张蕲县","author":"陈师道","text":"接禄才馀岁，为邦近故园。\n案图三万户，镇静五千言。\n雪尽春泥滑，风生沙水昏。\n犹须放琴客，坐席稍能温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张衡山","author":"陈师道","text":"昔别青衿子，今为白发翁。\n此行何日见，多难向来同。\n官事酣歌里，湖山秀句中。\n风尘莫回首，留眼送归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨侍禁兼寄颜黄二公二首 其二","author":"陈师道","text":"多问黄居士，终年欠一书。\n因人候消息，有使报何如。\n向晚逢杨子，真堪托后车。\n亲年方赖禄，不惜借吹嘘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨侍禁兼寄颜黄二公二首 其一","author":"陈师道","text":"相逢今已晚，同府尚经年。\n众口不成虎，诸公更荐贤。\n两亲须薄禄，一障欲乘边。\n往问颜夫子，何妨试著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送苏迨","author":"陈师道","text":"胸中历历著千年，笔下源源赴百川。\n真字飘扬今有种，清谈绝倒古无传。\n出尘悟解多为路，随世功名小著鞭。\n白首相逢恐无日，几时笔札到林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送建州郑户部","author":"陈师道","text":"清江画舸照新晴，铙鼓喧喧聒市鸣。\n昔日布衣今着绣，他年鹤化只空城。\n还朝不待三年最，得郡何妨万里行。\n岁禄二千亲八十，世间谁有此时荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林朝奉","author":"陈师道","text":"两父论诗伯仲间，去思今识谢家安。\n旷怀亦苦中年别，归翼仍愁行路难。\n四壁未堪风雨夕，百围已试雪霜寒。\n欲逃富贵疑无地，千丈竿头试手看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送欧阳叔弼知蔡州","author":"陈师道","text":"颍阴为别悔匆匆，十载相望信不通。\n晚遇圣朝收放逸，旋遭官禁限西东。\n又为太守专淮石，剩喜郎君类若翁。\n梅柳作新诗兴动，可令千里不同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送河间吕令","author":"陈师道","text":"今日中牟令，当年太守孙。\n独能怜此老，肯避席为门。\n寒日风涛壮，边城簿领繁。\n平生子曾子，白首得重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送泽之过维扬","author":"陈师道","text":"梦里扬州十载间，青楼陈迹故依然。\n袍争烂锦催诗笔，雨溅明珠落酒船。\n顾我老无骑鹤兴，羡君行及看花天。\n囊中绣句归应满，不负韦郎五色笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑祠部","author":"陈师道","text":"持节还家未白头，有亲八十更何求。\n又须急诏登天去，不为寒乡尽岁留。\n四著儒冠甘送老，数经奇运得销忧。\n拟登碣石临朝日，浩荡沧溟没白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵承议","author":"陈师道","text":"先生隐德世难名，晚见诸孙也自成。\n颍水向来须好句，道山今日有宗英。\n林湖更觉追随尽，巾帽犹堪语笑倾。\n勤苦读书终不补，未须墙角弃长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵教授","author":"陈师道","text":"束发相看到白头，了知公鬓不胜忧。\n可堪亲老须三釜，又著儒冠忍一羞。\n平世功名须晚节，向来旬月取封侯。\n北州豪杰知谁健，乞我黄淤十里秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵朝请赴苏幕","author":"陈师道","text":"好合同黄卷，情新更白头。\n胡然落丹墨，不坐致公侯。\n沙软留徐步，潮回趁急流。\n平生湖海兴，日夜逐行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送晁无咎出守蒲中","author":"陈师道","text":"一麾出守自多奇，四十专城古亦稀。\n解榻坐谈无我辈，铺筵踏舞欠崔徽。\n的桃作剧聊同俗，遇事当前莫后几。\n圣世急才常患少，栈羊酾酒待公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送晁尧民守徐","author":"陈师道","text":"中年为别不堪忧，束发登门到白头。\n南省望郎仍国士，东方千骑更吾州。\n彭翁老寿终遗骨，燕子飞来只故楼。\n知己难逢身易老，烦公置醴我归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送晁奉议高邮判官","author":"陈师道","text":"公族仍前辈，都城早与游。\n士穷须禄食，才大岂身谋。\n雪岭无归鸟，冰河有去舟。\n平生湖海意，不为有鱼留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秦觏二首 其二","author":"陈师道","text":"师法时难得，亲年富有馀。\n端为李君御，尽读邺侯书。\n结友真莫逆，论才有不如。\n折腰终不补，可但曳长裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秦觏二首 其一","author":"陈师道","text":"士有从师乐，诸儿却未知。\n欲行天下独，信有俗间疑。\n秋入川原秀，风连鼓角悲。\n目前㹠犬类，未必慰亲思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高推官","author":"陈师道","text":"先生钟旧德，大府冠群能。\n过手无难事，逢人有异称。\n荐贤馀一鹗，夙记契千灯。\n看挽秦梁缆，头头数不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹秀才","author":"陈师道","text":"甲第衣冠后，东迁岁月侵。\n情亲期一诺，急病阙千金。\n孰并还家乐，毋忘在莒心。\n时能记衰疾，声迹到云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送检法赵奉议","author":"陈师道","text":"三岁公门不屡过，作笺时得问如何。\n及兹去去翻为恨，向使常常肯谓多。\n勇锐闭房犹著酒，切深疾恶反伤和。\n赠言窃取仁人号，善听君居长者科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送章氏兄弟兼寄金山宁禅师","author":"陈师道","text":"末涂一过马群空，老眼双瞻碣石鸿。\n固有江东兼渭北，其如明月与清风。\n一官羁绊吾堪老，万里嫖姚子未穷。\n寄语此时怀马祖，叩门何日许庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送章推官","author":"陈师道","text":"从事有多誉，还家能少留。\n持杯犹颍尾，解缆即沙头。\n好事今犹壮，论文老自休。\n风埃留我老，说与五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送傅子正宣义","author":"陈师道","text":"渐渐乌竿五两轻，一帆秋色下江滨。\n请缨北阙非无意，捧檄南州且为亲。\n神骥解缰天上足，风鹏摇翮日边身。\n归途眯眼尘沙恶，想梦西湖十里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送提刑李学士移使东路","author":"陈师道","text":"襟袖从前相向开，倡酬于此未多陪。\n身更宠辱谈弥胜，路别东西意自哀。\n隐几忘言终不近，白头青简两相催。\n孰知衰老难为别，声问应须续续来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送智叔令咸平","author":"陈师道","text":"二谢将能事，重阳只故台。\n固须冲节去，便恐带秋回。\n敏捷才无尽，铺张意有开。\n犹须记衰疾，书与雁同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送詹司业","author":"陈师道","text":"学舍论交二十年，白头相对固依然。\n才难孰为吾君惜，果满宁容我辈先。\n熟路长驱聊缓步，百全一发不虚弦。\n故怀未尽还成别，饱惯人间不更怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送澶州录曹宋参军","author":"陈师道","text":"宦游男子事，访别故人情。\n能吏于今少，春风及此行。\n英雄馀战伐，犴狱寄廉平。\n未肯轻衰疾，人来阙寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钜野泊触事","author":"陈师道","text":"蒲巷牵丝直，平湖坠镜清。\n顺流风借便，捷路雪初晴。\n鸟度欲何向，鸥来只自惊。\n有行须快意，安得易为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钦圣宪肃皇后挽词二首 其二","author":"陈师道","text":"复辟先元约，长年损积忧。\n春移柏城仗，仙去帝乡游。\n德并涂莘敏，功临马邓优。\n千秋修故事，车马戒如流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]