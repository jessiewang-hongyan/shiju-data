[{"title":"次韵立方何园","author":"沈说","text":"春事觉垂垂，春行似后期。\n草根花片积，人语鸟声随。\n酒病因过量，棋输为好奇。\n欲归愁路远，月色若为私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗溪途中","author":"沈说","text":"天风吹落日，秋色上遥岑。\n倦客未投馆，栖鸦已满林。\n妻孥非远别，岁月易惊心。\n市酒不成醉，新蛩助我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖独步","author":"沈说","text":"平湖开霁色，寒碧照空心。\n小立背桥影，缓行随柳阴。\n几年劳远梦，到日记曾吟。\n荷荡成茭地，萧萧秋意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别墅","author":"沈说","text":"野舍清溪曲，连茅接树阴。\n呼童邻错应，贳酒妇同斟。\n落照收残雨，寒烟出寸岑。\n江湖成梦事，投老属山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡鸣","author":"沈说","text":"鸡鸣霜叶下，月在纸窗寒。\n客路千家晓，山居一枕安。\n秫收催岁酿，韭种接春盘。\n纵有少年梦，其如心事阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"征途","author":"沈说","text":"桂管三千里，征人一寸心。\n自从登驿路，几见换乡音。\n古树春阴薄，寒塘野水深。\n渴行呼得酒，瓦碗不辞斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南坡不以科目自累而以风雅自鸣请余为赋","author":"沈说","text":"凤衔科诏出祥云，底事儒林有逸民。\n四海声名难著我，一坡风月正宜人。\n镜留白发非遮俗，家酿黄柑可接春。\n只许诗朋自来往，素袍青履华阳巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋溪","author":"沈说","text":"迎月步秋溪，芦长与树齐。\n水光连汉近，夜气压山低。\n岸隔呼渔渡，林疏见鸟栖。\n酒微风力劲，归袖冷凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送观过免举赴省","author":"沈说","text":"樽前逢腊近，行李独西征。\n事历风霜惯，春回雨露生。\n一经家自学，千佛世题名。\n昨夜瞻奎宿，寒芒万丈明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水竹需次入剡易斋赴浙漕","author":"沈说","text":"弟兄联骑出，秋色赴行装。\n慈水瓜应熟，孤山桂又香。\n对床村店寂，起饭晓灯凉。\n到日分吴越，江流两岸长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何仲远适越因之官霅水","author":"沈说","text":"樽酒沙头绿涨波，事欢其柰别愁何。\n去程想憩兰亭竹，到日须看霅浦荷。\n年少莫嫌官职小，名高却怕荐书多。\n腊前拟作孤山梦，还许扁舟载雪过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何榷院之官金陵","author":"沈说","text":"分司陪宰掾，赐敕带朝衔。\n见说成行李，无因别去帆。\n秋风石城路，夜月雨花岩。\n料有惊人句，鸿边寄短函。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周堂长归慈溪寄何赞府","author":"沈说","text":"慈溪隔楚云，问不接鸿鳞。\n因送还乡客，重怀佐邑人。\n海明看出日，山晚倦行春。\n料得双松下，吟成瘦鹤身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽鲍监镇","author":"沈说","text":"一纸辟书驰，华年发轫时。\n排云何不到，殒露遽如斯。\n幼子未知父，偏亲反哭儿。\n有书来谒些，忍泪看埋碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟浦","author":"沈说","text":"烟浦残鸦舞夕阳，风枝病叶似初霜。\n眼中秋色十分净，沙外寒流一线长。\n溪女得鱼烹碎白，田家收谷晒新黄。\n偶寻野趣归来晚，草际萤飞点点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张永堂","author":"沈说","text":"浙江风浪阔，梦不落吟边。\n书到知何日，君归想隔年。\n才高朝士重，命拙故人怜。\n早办山中计，吾今省俗缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渠流","author":"沈说","text":"岸石湿黏萍，一渠流水清。\n每来疑雨过，少立见鱼行。\n树隔炎歊远，桥分午影平。\n主人契幽事，客到出相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野店","author":"沈说","text":"幽人逢野客，相约过云庄。\n去路稻粱熟，入山松柏香。\n试霜寒尚薄，落叶夜初长。\n对坐煨茅栗，瓶中取酒尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"沈说","text":"冻项缩如龟，茅檐讽雪诗。\n冷于初下日，好是未消时。\n树重高枝折，窗明晚色迟。\n忽思溪上路，拟借蹇驴骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游真岩","author":"沈说","text":"一径入松林，真岩峭莫寻。\n山空泉自落，日出地长阴。\n鹤去仙台净，丹成古井深。\n残碑看未了，屋角转幽禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"超化云山","author":"沈说","text":"入门松作径，步步接秋阴。\n山带孤城起，云归古殿深。\n隔池闻鹤唳，倚树看僧吟。\n笑指煎茶处，青烟出竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪楼","author":"沈说","text":"心远俗尘隔，楼高野兴多。\n稻花黄雀雨，山影白鸥波。\n滩涩推船上，桥危挽客过。\n日斜栏倚遍，无句奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简柳浚卿","author":"沈说","text":"一别仅三年，相看事宛然。\n旋添新蒜发，犹耸旧吟肩。\n红日征途外，黄花喜气边。\n不须劳寄问，姓字有人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缙云道中","author":"沈说","text":"去作京华客，离家此月前。\n问程恰中道，数日近残年。\n山雨易成雪，村云疑是烟。\n仆行愁不进，添乞酒浆钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春","author":"沈说","text":"燕翼初乾渌满池，桑阴收尽麦黄时。\n一年春事又成梦，几日愁怀欲废诗。\n料理病身尝药遍，揩摩睡眼看书迟。\n翛然独倚阑干立，花下狸奴卧弄儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄止庵诗集","author":"沈说","text":"灯前几寒夜，编得近诗成。\n对客时评看，归囊喜带行。\n风高霜鹘健，木落涧秋清。\n吟到无吟处，萧萧白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁福道中","author":"沈说","text":"山径少曾平，人烟隔陇青。\n浅流分石渡，低树碍舆行。\n税籍全编户，村童半壮丁。\n我来官此邑，三度究民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古树","author":"沈说","text":"古树被青藓，蟠溪作卧龙。\n穷冬不蔽日，入夏却生风。\n枝少禽难托，根空蚁聚封。\n幸为斤斧弃，得老雪霜中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立秋","author":"沈说","text":"昨日午时秋，西风夜转头。\n吹来溪外雨，藏却树间楼。\n暝带栖鸦色，凉催客燕愁。\n一樽吟未了，衰鬓早飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹色","author":"沈说","text":"竹色留清睡，薰风昼一帘。\n懒因人事少，病觉老颜添。\n开槛临昏镜，齐书补坠签。\n晚蝉声欲断，新月到虚檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茅檐","author":"沈说","text":"茅檐夜雪晓开晴，自洗寒衣漉涧清。\n如此过冬何不可，梅花休笑鬓星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食梅","author":"沈说","text":"儿时摘青梅，叶底寻弹丸。\n所恨襟袖窄，不惮颊舌穿。\n我年不自觉，以我齿尚完。\n尝新试一荐，喉棘眉先攒。\n岂味不悦口，岂老难强餐。\n人生煎百忧，算梅未为酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄永堂","author":"沈说","text":"落日照江东，思君讯便风。\n栖迟定何处，约莫过残冬。\n小隐时曾到，安书久未通。\n自怜心易老，盘屈似寒松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚行","author":"沈说","text":"晚行疏松间，遥见青烟处。\n群牧下山迟，斜阳半芳树。\n孤云驾回飙，介水横不渡。\n倾意望幽人，待月同归步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠段琴 其一","author":"沈说","text":"我琴未弦时，浑然心与耳。\n自从识开指，反为琴所使。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠段琴 其二","author":"沈说","text":"清风千古曲，雪涧敲寒玉。\n谁能继此音，苍梧泣脩竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘州/八声甘州 心传索词屡矣，久以缮金字之冗，未暇填缀。玉田生乃歌白雪之章，汴沈钦就用其韵","author":"沈钦","text":"有吴僧、醉倒墨池边，西风暗吹芳。\n对苍髯冷挂，龙珠万颗，清映经窗。\n却似仙人黄鹤，笛里换时光。\n静处观生意，竹老梅荒。\n犹说当年分种，是枯槎远驾，万里途长。\n信留真何许，烨烨楮毫香。\n□前度、离宫别馆，正金铺、深掩绿苔床。\n都休问，一番展卷，清昼生凉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 蝗虫三叠","author":"沈唐","text":"不是这，下辈无礼，都缘是我，自家遭逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"沈唐","text":"杏花过雨，渐残红零落，胭脂颜色。\n流水飘香人渐远，难托春心脉脉。\n恨别王孙，墙阴目断，手把青梅摘。\n金鞍何处，绿杨依旧南陌。\n消散云雨须臾，多情因甚，有轻离轻拆。\n燕语千般，争解说、些子伊家消息。\n厚约深盟，除非重见，见了方端的。\n而今无奈，寸肠千恨堆积。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"沈唐","text":"朝觐俯尧阶。\n宠拜新恩天上回。\n欢动边城十万户，民怀。\n荣见旌旗却再来。\n清晓敞铃齐。\n庭下鸣鼍绮宴开。\n红袖两行频捧劝，金□。\n利市应销十二钗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望南云慢 木芙蓉","author":"沈唐","text":"木叶轻飞，乍雨歇亭皋，帘卷秋光。\n栏隈砌角，绽拒霜几处，蓓深浅红芳。\n应恨开时晚，伴翠菊、风前并香。\n晓来寒露，嫩脸低凝，似带啼妆。\n堪伤。\n记得佳人，当时怨别，盈腮泪粉行行。\n而今最苦，奈千里身心，两处凄凉。\n感物成消黯，念旧欢、空劳寸肠。\n月斜残漏，梦断孤帏，一枕思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海潮 上太原知府王君贶尚书","author":"沈唐","text":"山光凝翠，川容如画，名都自古并州。\n箫鼓沸天，弓刀似水，连营十万貔貅。\n金骑走长楸。\n少年人一一，锦带吴钩。\n路入榆关，雁飞汾水正宜秋。\n追思昔日风流。\n有儒将醉吟，才子狂游。\n松偃旧亭，城高故国，空馀舞榭歌楼。\n方面倚贤侯。\n便恐为霖雨，归去难留。\n好向西溪，恣携弦管宴兰舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜叶飞","author":"沈唐","text":"霜林凋晚，危楼迥，登临无限秋思。\n望中闲想，洞庭波面，乱红初坠。\n更萧索、风吹渭水。\n长安飞舞千门里。\n变景摧芳榭，唯有兰衰暮丛，菊残馀蕊。\n回念花满华堂，美人一去，镇掩香闺经岁。\n又观珠露，碎点苍苔，败梧飘砌。\n谩赢得、相思泪眼，东君早作归来计。\n便莫惜丹青手，重与芳菲，万红千翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临高台","author":"沈浚","text":"上台意悲伤，下台梦颠倒。\n不缘台高下，心肠自草草。\n台下东西水，水绕南北道。\n一水一重山，红颜望中老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山斋诗","author":"沈继祖","text":"置之一壑谢鲲像，画入三峰潘阆图。\n二子居山真得趣，山斋曾为写真无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花村","author":"沈继祖","text":"杏破繁枝春意闹，牙盘堆实荐时新。\n仙家种此应知味，试问庐山姓董人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日即席和章帅侍郎","author":"沈继祖","text":"玉帐清无一点尘，浃旬休暇乐延宾。\n二天共醉千钟酒，三月惟馀一日春。\n风急鸟雏犹唤友，雨晴燕子也留人。\n骊珠八七盈怀袖，归去行囊喜不贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友善堂为张以道题","author":"沈继祖","text":"上士与下士，多闻或寡闻。\n子诚能尚友，我亦叹离群。\n磨琢功当进，金兰志不分。\n孝标何所见，但广绝交文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答李孟达通判索鄙诗","author":"沈继祖","text":"删后无诗亦可忧，人言赋者古诗流。\n欲闻正始今安在，须向先秦以上求。\n玄酒大羹存至味，子虚亡是谩相酬。\n万人丛里谁人晓，独有夫君暗点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次瞿塘寄呈杨帅","author":"沈继祖","text":"转柁边楼隔夕阳，竹枝歌断送飞航。\n敢同计事追韩信，每辱扬鞭问葛彊。\n雁影入江三峡冷，猿音呼月五更长。\n功名岁晚貂裘弊，归鬓应怜已点霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送閤学袁尚书帅蜀 其二","author":"沈继祖","text":"兵书一箧老空休，尚记当年寓益州。\n扪虱盖尝谈世事，鲙鲈聊复寄扁舟。\n我方泥饮誇严尹，公喜逢时过武侯。\n作此短歌怀感遇，运斤班郢独包羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨寺丞浑父帅安康","author":"沈继祖","text":"杨子声名鹤在阴，诗书作帅有谋深。\n开关入洛平如掌，击楫中流酬此心。\n胡运只今那得久，齐疆指日自归侵。\n君当草奏摅忠愤，所领州名力去金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨侍郎帅江陵 其二","author":"沈继祖","text":"蜀道登门日，于今十五秋。\n恩勤怀荐祢，飘泊久依刘。\n兹辍中台望，将宽北顾忧。\n望之多献纳，有欲为王留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨侍郎帅江陵 其一","author":"沈继祖","text":"王眷勤三接，儒流见一真。\n维申柔且直，于尹学焉臣。\n玉铉当调化，金城要得人。\n行看司马相，端委静边尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送直阁刘郎中知平江府","author":"沈继祖","text":"星郎星使两俱优，三辅黄图帝选侯。\n万里登瀛超弱水，一轮有月照苏州。\n刀飞雪缕誇鲈鲙，云作奇峰簇虎丘。\n太守能书传宝帖，洞庭应寄橘千头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题新昌簿厅绿阴亭","author":"沈继祖","text":"洛下追收黄耳信，林间闻创绿阴亭。\n千章古树虚帘接，四月清风羽扇停。\n兄弟头颅时感叹，江湖岁月久飘零。\n对床夜话知他日，幽赏如何得细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游西湖用中字韵呈直院高舍人","author":"沈继祖","text":"制兼内外文章伯，远过当年高侍中。\n运笔不停池水黑，举觞未厌酒珠红。\n泛舟但仰膺门峻，登岘夫何湛辈同。\n傥以言诗许商赐，诗工宁复恨人穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又代上张帅太尉","author":"沈继祖","text":"三杰人材有重轻，子房呼字不呼名。\n天授家传此韬略，固应堂上有奇兵。\n方虎成功张仲在，惟忠与孝一心纯。\n英姿鹦鹉洲前见，异日麒麟閤上人。\n挟纩皆由一语温，吮疽效命亦前闻。\n听得武昌军士说，张家军比岳家军。\n元颜辛巳寇边日，十骑能收唐邓州。\n奈何养兵一百万，岁以金缯遗虏囚。\n春秋尚复九世雠，和议于今六十秋。\n诸将宁无持禄念，将军必不为身谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上扬州钱帅","author":"沈继祖","text":"名世半千推硕德，淮南第一是扬州。\n一尘不动边民乐，知有威声慑虏酋。\n人谓儒生将略疏，世人元未识真儒。\n天下武夫俱夺气，钱公赤手缚于菟。\n丰水有芑岂不仕，论者以为数世仁。\n寿皇所以遗嗣圣，如此真材有几人。\n夷虏久知唐李揆，近闻松漠抗毡车。\n虏在目中馀事耳，不烦遥度扫穹庐。\n天津桥上骑驴客，儒者知兵似晋公。\n五大在边非所称，谋谟合在庙堂中。\n春风十里杨花路，天下花中独有琼。\n樽俎折冲多胜赏，一时纸贵有诗声。\n淮南好客词人盛，风雅而来大小山。\n旧客尚馀枚叟在，秋风零落鬓毛班。\n联名雁塔终呈再，讨贼螺川又几年。\n范叔一寒今若此，绨袍或有故人怜。\n少陵去阆依严郑，彭泽还家太守贤。\n北道主人天下士，何须羞涩问囊钱。\n万事消磨独有诗，人言此派在江西。\n所期诵句百僚上，佳士由来经品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上章帅侍郎 其一","author":"沈继祖","text":"太平之兆从西起，西方人兮独宏伟。\n中兴三相西蜀英，魏雍沂国封鼎峙。\n得君之专不约同，应龙翔云鱼有水。\n大勋将集自有时，时望今归章夫子。\n岷峨英气蟠千年，十年郁蟠一朝启。\n固应世命生大材，天下重轻之所系。\n六鳌不动海岳崇，八柱檠天穹窿倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和阎帅侍郎见寄","author":"沈继祖","text":"全荆百万兵屯云，甲光耀日争晶荧。\n中有诗书礼乐帅，声色不动今孔明。\n幕府昼闲多啸咏，风流文采被诸生。\n嗟予入蜀四载久，恨未得承謦欬声。\n今为属县方托迹，似闻号召将朝京。\n荆州一纸贤十部，字画飞动诗语清。\n居然二妙到蔀屋，再拜庄诵心已倾。\n忆昔锦城秋月里，张侯更迭赋歌行。\n人生聚散不可料，如月圆缺与阴晴。\n岂期斐章辱赐和，骊珠宝璐箧笥盈。\n傥因徐辟见孟子，有志未就公其成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄叔万游西湖韵","author":"沈继祖","text":"城西去天才尺五，溯游从之不脩阻。\n西湖春水涨旧痕，葡萄盎盎浮春醑。\n鱼成队阵影虚游，禽呼友朋声乐与。\n船行是处有佳趣，芳草和烟迷断浦。\n小桥曲径通深幽，疑在阆风与玄圃。\n花飞犹有半妆在，柳长尚作画眉妩。\n酒中之仙仅八人，把杯谁是湖山主。\n楼台倒影俯清漪，密树摇风翠交舞。\n妙处政自落笔难，安得君房妙言语。\n只将剧饮饯残春，一醉忘形到尔汝。\n黄香可人招不来，云烟落纸英词吐。\n三年与君巴峡游，至今诗名播西土。\n金华不生有嫡孙，一时纸贵人争睹。\n维莫之春作兹游，绝忆苏仙赋东武。\n从今风月三千篇，要扫冰溪九万楮。\n芰荷立水更重游，当戒行厨治尊俎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]