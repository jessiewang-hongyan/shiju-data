[{"title":"安远道中","author":"韦骧","text":"晚穿乱水踏攲危，晓度空山瘴雾飞。\n今日戒途甘险阻，古来谋事重依违。\n行询野叟观其欲，静究州图记所非。\n走遍封疆收定议，黄花时节合东归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金精岩","author":"韦骧","text":"回岩万仞透青冥，造化功偏窍凿精。\n自是神仙乘福地，岂因谖诈诱愚兵。\n金床旧迹知何在，石鼓遗歌仅可评。\n尘淟暂来心已悟，灵场千古为苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游金精回书朝阳岩观壁","author":"韦骧","text":"秋入群峰气象清，朝阳才过到金精。\n胜游却向尘劳得，此日清怀慰此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"板石驿","author":"韦骧","text":"童山皆戴石，浅水屡萦村。\n路接猿猱险，云兼瘴雾昏。\n披榛投舍馆，藉草展行樽。\n吏役身无定，天涯一断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋午夜和溪看月","author":"韦骧","text":"去岁中秋别岳阳，洞庭湖外望清光。\n今年衮衮仍行役，此日萧萧复异乡。\n林叶泛辉兼玉露，水波摇影接银潢。\n出船聊踞胡床坐，远负高楼列酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登郁孤台 其一","author":"韦骧","text":"区区倦翼傍旌旄，独上名台滞思逃。\n章水背流馀派合，崆山前隐独峰高。\n万家井落氛埃绝，千里喉襟气象豪。\n一见荆川胜侯印，况将佳趣慰尘劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登郁孤台 其二","author":"韦骧","text":"去年秋宿洞庭湖，今日登临在郁孤。\n两处风流皆胜绝，一身奔走亦崎岖。\n光摇二水看云断，翠滴千山爱日晡。\n吏役不容清兴足，放船回首望城隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过赣石","author":"韦骧","text":"乘危趋疾固轻身，却羡操舟妙入神。\n石罅安船石头立，渔人谩笑往来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天柱滩","author":"韦骧","text":"密密赣滩三百里，此滩崛起最峥嵘。\n中原柱石知多少，安用江心滥得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月八日离虔","author":"韦骧","text":"明日重阳日，章江独放船。\n岂无时节兴，固有简书牵。\n残暑犹争际，馀雷忽霈然。\n诘朝晴气爽，忍负菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月八日薄晚离赣城十馀里而雷雨作遂倚舟以宿九日晓行又十馀里而逆风暴甚乃泊于白鹇滩侧虔之史君相留不可屡以亟行见谑今日会宾席间当语及濡滞以为笑矣因书以自戏云","author":"韦骧","text":"佳辰来可喜，久客去难论。\n为忆东篱菊，因辞北海樽。\n逆风吹急浪，单舸泊孤村。\n缅想茱萸宴，卢胡有后言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至万安","author":"韦骧","text":"西风萧瑟作秋声，远客归心信水程。\n双石尖尖双鹭立，一滩渺渺一舟行。\n酒杯无侣难成饮，诗句非奇谩写情。\n晚泊沙头从杖履，故乡何在眼空明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙世则著作新年见寄 其一","author":"韦骧","text":"不奉清谭一纪馀，相期情分愈于初。\n数篇秀句锋谁敌，累幅华笺手自书。\n芸省联曹虽喜共，萍江制邑独惭疏。\n如君才术当超卓，安见飞黄困守闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙世则著作新年见寄 其二","author":"韦骧","text":"剸繁芟弊力无馀，行学存心负厥初。\n冻笔方驱嚣讼牒，解颐忽得故人书。\n分襟固久情还密，领邑虽邻迹也疏。\n安得同时俱代去，相从山水乐吾闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行年","author":"韦骧","text":"行年四十志方刚，一任蓬松两鬓苍。\n道在忽愁施设地，心恬宁感利名场。\n本无畎亩为私计，只有诗书可自强。\n努力终非素餐辈，未堪回首顾沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿新乐驿","author":"韦骧","text":"去秋村北宿僧床，今夕村南寓驿堂。\n官仆颇谙蹊径熟，野人应笑往来忙。\n敝裘不耐春寒甚，老马犹堪山路长。\n独酌独诗还独寐，此中清况亦难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"之虔推劾道远雨甚念从隶之劳","author":"韦骧","text":"山雨淋头急，冈泥没骭深。\n从驱尔何罪，行役我甘心。\n抑鞚忧难趁，分装恐不任。\n苏樵复稀遇，寒气少相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安福驿","author":"韦骧","text":"作邑多离邑，去家如去乡。\n三年三过驿，一别一回肠。\n治绩安能胜，征途遒备尝。\n何时腰解印，长啸入馀杭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜晴","author":"韦骧","text":"今年未见日，指数两经旬。\n清旦初开霁，元功始布新。\n溪流徐变绿，林啭便知春。\n吏役方长道，油云莫更瞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南昌铁柱","author":"韦骧","text":"南昌昔谓水浮州，铁柱支持事更幽。\n天地有炉劳一铸，蛟螭无穴解群忧。\n槎牙露处几三尺，摇撼徒然踣万牛。\n人赖旌阳恩力大，此功何愧禹功优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"韦骧","text":"春来二十日，寒气尚棱棱。\n万甲殊未坼，新雷徒已曾。\n山禽鸣瑟缩，道马足凌兢。\n节候无惊异，江南旧所称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赣州鞫劾呈同事邓宰德夫","author":"韦骧","text":"二月春寒倍觉深，双扉昼锁柏庭阴。\n修途远至劳虽甚，雅谊相亲喜不任。\n穷覈须繄颛用智，哀矜当亦共存心。\n累囚未引犹纾暇，浊酒那辞细细斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和同时到院","author":"韦骧","text":"各沿台檄会平番，萍水金溪隔万山。\n两处相期仗官驿，一时交际到江关。\n如何远趾符同甚，岂是诚心吻合间。\n案牍牵仍毋易视，囚情未得莫优閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锁院深寂夭桃独芳有可怜之色为诗要德夫共赋以赏之","author":"韦骧","text":"静院深扃霁雨新，小桃墙侧弄精神。\n祇知春色归吾眼，不悟他乡寄此身。\n露蕊妖韶真自得，胭脂浓淡属谁匀。\n共将短句酬幽艳，奚独东风是主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月十六日感雨示同事","author":"韦骧","text":"烛烬遗朝几，炉烟出昼帘。\n时春惊一半，山雨怅相兼。\n吏局如巢寄，家音以鹊占。\n敢思游观乐，同患滞囚淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讯鞫有閒呈德夫","author":"韦骧","text":"同时锁深院，轮日直寒厅。\n所得期无喜，忘情在不经。\n桃心随雨碎，柳眼向人青。\n早晚连镳去，春郊约罄瓶。\n案积云堆影，庭虚谷应声。\n榜笞非所事，杖履有馀清。\n静径牵情数，芳林照眼明。\n相逢得佳侣，尤足慰营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵德夫推院有感","author":"韦骧","text":"薄宦予嗟少定踪，贤劳君叹久西东。\n相从山国春多雨，共忆公园花已丛。\n酒约倒杯忻有伴，诗寻险韵惧无功。\n勤乘閒隙酬清兴，便与分襟棹短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜春 其一","author":"韦骧","text":"皦皦春阳上柳尖，轻轻朝雾亦相兼。\n教雏老雀穿雕栱，失伴狂蜂入翠帘。\n深院难将飞絮锁，空阶且任落花黏。\n惜春情味从来甚，今日江城兴倍添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜春 其二","author":"韦骧","text":"二月已破三月来，吟诗空忆少陵才。\n檐前有意残花堕，云里无情旅雁回。\n何处轮蹄蹂芳草，谁家丝管上高台。\n吾侪局外添婴绕，此段襟怀强自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵社日且以善谑","author":"韦骧","text":"社日江南眼屡经，春天峤北寄春城。\n双飞海燕知时节，半醉田翁舞泰平。\n谩把杯盘为小饮，频催案牍况垂成。\n却思廉割东方朔，归遗那无动旅情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复假前韵为即事二诗且言别于卒章 其一","author":"韦骧","text":"烟花苒苒裹江亭，云霭纷纷接暮城。\n物态除非诗可写，旅怀唯藉酒能平。\n燕知社节来何早，莺怯春寒语未成。\n非晚与君分袂去，他时当记此时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复假前韵为即事二诗且言别于卒章 其二","author":"韦骧","text":"浩如潮水出东溟，勇似云梯破铁城。\n谈柄交挥逾月久，吟毫相抗几时平。\n清驩返向尘劳得，佳集元非计构成。\n还守邑疆相望远，陇烟江月若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日赣川忆东湖 其一","author":"韦骧","text":"韶光强半已消除，峤北芳华眼不辜。\n黄鸟穿林金闪铄，紫荆铺地锦模糊。\n持循畏简催胥吏，整顿归鞍戒仆夫。\n传语东风为加意，少留花卉在东湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日赣川忆东湖 其二","author":"韦骧","text":"晓风吹雨过溪南，春色晴光三月三。\n燕觜啄泥方汲汲，杏梢攲水正酣酣。\n樽庖冷落俱能耐，刀笔萦仍岂自甘。\n珠阁帘堂应好在，待教门外系归骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵为感春喜会二首酬德夫 其一","author":"韦骧","text":"五侯门馆映交衢，点检春光肯暂辜。\n教舞庭除红锦藉，看花窗牗碧纱糊。\n侈心忘理虽儿女，乐事乘时亦丈夫。\n而我拘挛过佳节，岂无船在贺家湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵为感春喜会二首酬德夫 其二","author":"韦骧","text":"东风烂漫巨江南，林薄馀花十二三。\n隐隐游丝飞日影，娟娟戏蝶舞春酣。\n独旗共爱茶芽嫩，佳境俱怜芋蔗甘。\n谈屑不宜虚永昼，长岐分背谩停骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春杪书怀三十韵呈同事邓令","author":"韦骧","text":"覆囚将讫事，春杪兴蹉跎。\n亭馆依游好，云天气候和。\n江山秀色远，桃李绿阴多。\n燕熟巢仍补，莺新语尚讹。\n径深无过辙，门阒可张罗。\n雨渍苔钱积，风旋柳絮涡。\n落花冲蚁阵，侧叶露蜂窠。\n朝雾开如扫，晴丝荡不梭。\n鸣禽多了了，舞蝶并傞傞。\n物意良俱得，人情亦自阿。\n轩窗资坐啸，杖履起行歌。\n屋角鶱飞翼，帘旌动翠波。\n画图连璧带，香穗接庭萝。\n笔颖牵诗癖，茶枪战睡魔。\n清谈屡挥麈，酣饮必空螺。\n语射怜当鹄，论书忆换鹅。\n九霄明日月，万国富山河。\n轻减中原役，韬藏绝塞戈。\n壮犹摅阔略，嵬论辟么么。\n束帛丘园走，封轺驿传过。\n拔才方迅疾，养拙且婆娑。\n凫鹤形难壹，鹪鹏好自颇。\n痔医荣足贱，墦乞诈宜诃。\n投步安夷坦，存心谢揣摩。\n势穷嗟屈贾，道乐慕渊轲。\n豹隐潜加泽，牛山戒执柯。\n忘非羞搏虎，招议畏鸣鼍。\n末宦难萦束，高怀固岌峨。\n踏青筵已旷，镊白镜慵磨。\n聊作逍遥咏，君其谓我何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和邓德夫再和书怀别用三十韵","author":"韦骧","text":"飞文侔羽檄，执议有金科。\n于役同之赣，夫君仅自鄱。\n相逢多所乐，末礼去其苛。\n鱼咏蒸然罩，材忻茂者莪。\n穷奸摧狡穴，辨枉愈绵痾。\n日食肴几变，宵忧寐欲吪。\n恤冤防夏旱，驱害逐春傩。\n覈实当由已，指踪奚自他。\n囚衣应足虱，吏案已胜驼。\n居似蛇存蛰，归如茧化蛾。\n险途须屡叱，行旅勿轻呵。\n白雪风中絮，青钱水上荷。\n佳辰怜爽旷，秀句好彫瑳。\n束卷儒风旧，严装武貌番。\n分岐兹泮涣，回首则猗那。\n蚁酒慵为酌，藜羹糁不鹾。\n轻遗逸士帽，倒踏谪仙靴。\n恍忽东西驿，踌躇上下波。\n嘤鸣忻得侣，妖艳况方瘥。\n引脰邻于鹤，离肠迥若沱。\n版徒犹相武，笔吏解封酂。\n易失时兼势，难淹轴与薖。\n莘耕方释耒，磻钓亦收蓑。\n勉力攀翔凤，何心跃遁骡。\n养躯宜气适，乘兴且颜酡。\n淡泊延诗伯，伊优远舞娥。\n加功草封岱，著意吊沉罗。\n即是金扉对，无辞墨绶拖。\n仳违临晚萚，声问约新禾。\n何日瞻天驭，同听白玉珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫荆花","author":"韦骧","text":"紫艳暮春庭，少陵诗思清。\n老蛟蟠曲干，丹矿缀繁英。\n花谱元无品，春工别有情。\n不随桃李色，俗眼莫相轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元真州","author":"韦骧","text":"春阴荡尽见春妍，立马长坡思渺然。\n望断双旌已难见，声闻五裤只空传。\n遥知裁割常虚刃，应赏风光蚤布筵。\n不省玉人歌阕处，红梅多少落樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆林道中示孙张二君","author":"韦骧","text":"西风掠雨作朝寒，联马相将入乱山。\n愧从使车无补助，敢辞征驭历间关。\n日边帝阙瞻犹远，云下亲闱念未还。\n旅思纷纷何以慰，间求佳论一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵和孙正甫所示","author":"韦骧","text":"画船同出汴渠湾，天末云收数点山。\n共应辟书离魏阙，谁持别酒唱阳关。\n閒论浙右经年事，此去胶东几日还。\n男子有为须远趾，谁能辕下久低颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胶水道中逢九日呈温伯舍人","author":"韦骧","text":"绣衣肤使出东州，九日旌轩不暂留。\n固有诚心当倚注，肯缘佳节废询求。\n马蹄远践天涯路，雁翼横飞海角秋。\n安得一樽黄菊酒，代公冰饮过宵休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵谢和诗二首","author":"韦骧","text":"虽知自古有言酬，倍获佳篇却重留。\n袭璞固宜资一笑，报瑶何意足多求。\n词源浩若江河注，笔力成如造化秋。\n询度馀閒吟咏作，岂非夫子德公休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十八夜宿莱州海庙夜分登亭望月观海呈伯温舍人","author":"韦骧","text":"昼从旌旗过碧山，夜陪巾履望漫漫。\n蛟龙睡著风波静，鸿雁影低星月寒。\n不极清光分岛屿，无边爽气接栏干。\n此时此兴真夷旷，莫作尘游一等看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出东莱城示海傍观者","author":"韦骧","text":"老稚相携出翳林，玉沙堤上听车音。\n便安赤子朝廷意，补助清时使者心。\n畎亩均休无一役，岁时赈乏有千金。\n东人祇见东溟阔，不识君恩似海深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和孙正甫音字韵呈舍人","author":"韦骧","text":"峨峨气格冠书林，落落文章叩玉音。\n暂别谏垣虚谠论，聊持使节慰焦心。\n红尘翠霭飘衣绣，紫幅黄油护印金。\n采尽舆情将入告，谋谟谁得见精深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月二十二日黄县道中遇雪","author":"韦骧","text":"九日登州路，西风暴作威。\n黄桑犹半在，白雪已交飞。\n惯见邦人眼，难当旅客衣。\n来思尚稽咏，遽此对霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至登州","author":"韦骧","text":"长途冉冉马萧萧，风势横来带雪飘。\n雁队去成铧觜阵，蚁樽行向剑头挑。\n气清肝膈诗还健，寒切肌肤酒易消。\n顾我不才无寸补，徒瞻使骑旆旌摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻潮","author":"韦骧","text":"钱塘江上吾家近，惯听秋潮动地鸣。\n今日蓬莱于役处，却疑身在故乡行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和淮阳颜长道见寄","author":"韦骧","text":"冉冉征途似梦间，相从未几又先还。\n却思前日同清会，不若当年醉碧山。\n别去载怀眉宇旧，书来重说鬓毛斑。\n吾侪固有襟期远，肯向明时容易閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登蓬莱阁","author":"韦骧","text":"行尽东州到此州，登临更尽北山头。\n孤城突兀连沧海，三岛参差耸暮秋。\n广座下疑鳌负石，危檐远学蜃为楼。\n蓬莱方丈虽冥邈，高阁今朝亦胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙正甫二首 其一","author":"韦骧","text":"马头今日向西行，不比来时道路生。\n与子联镳下长阪，无人回首望高城。\n疏林积叶牛閒卧，衰草牵风兔自惊。\n诗思过于归思好，征鸿斜衬落霞明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙正甫二首 其二","author":"韦骧","text":"马头今日向西行，仆驭欣欣脚力生。\n白雪波涛离海国，黄金宫阙想京城。\n墙间笑语群儿集，木末冲飞独鸟惊。\n从此归程宜倍道，解鞍须到众星明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路疑 其一","author":"韦骧","text":"晓起仍行迈，征途一梦新。\n雁低如有信，马急似无尘。\n青讶山长雨，黄疑柳自春。\n此身从衮衮，奔走岂由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"路疑 其二","author":"韦骧","text":"莫夜仍投宿，邮亭葺半新。\n风帷如涨海，烟蜡似征尘。\n白讶窗催晓，红疑炉变春。\n归期尚淹晚，鞅绊可尤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游齐州灵岩四首 其一","author":"韦骧","text":"征尘汹汹顿消磨，路入灵岩好趣多。\n崖穴透空疑昼月，泉池凝渌似春波。\n锦帷香细薰千佛，金殿灯明觉众魔。\n一宿禅房幸安稳，明朝骑马又长坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游齐州灵岩四首 其二","author":"韦骧","text":"东国名高独此岩，群峰环抱自韬钤。\n道场岑寂规风古，禅室空疏杖喝严。\n木落有时飘殿角，云寒终日蔽山尖。\n不知双鹤归何处，留得灵泉与众甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游齐州灵岩四首 其三","author":"韦骧","text":"区区不觉路岐难，尘土衣冠喜动颜。\n已见成书归上国，更逢便道览名山。\n随轩幸涉三时久，弭节仍陪半日閒。\n却与禅翁自相悦，绣衣云步共追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游齐州灵岩四首 其四","author":"韦骧","text":"鸡鸣峰外日曈昽，欲去踌躇兴未穷。\n索笔请题青石柱，留名愿附碧纱笼。\n重裘迥触千山雾，回辔轻随一径风。\n跋马频频望苍翠，他时应与梦魂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和颜长道见寄","author":"韦骧","text":"行役牵挛好思悭，诗筒旬浃未能还。\n驱驰东国黄尘路，梦想南乡碧玉山。\n顾我俗情方衮衮，爱君佳句独班班。\n再吟再和都缄寄，幸有冥鸿羽翼閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]