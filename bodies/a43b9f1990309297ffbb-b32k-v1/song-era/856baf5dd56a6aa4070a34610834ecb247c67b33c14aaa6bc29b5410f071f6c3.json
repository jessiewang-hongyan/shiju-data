[{"title":"王提举閤政钱夫人挽诗 其二","author":"赵善括","text":"山敞神仙宅，人辞富贵家。\n靓容深莫识，清节瑩无瑕。\n蚌脱珠方璨，椿灵桂始华。\n他年容万马，今日送千车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世事二首 其二","author":"赵善括","text":"我贫非道病，生计恝然疏。\n数亩田常旱，一溪云有馀。\n幸无贫外乐，赢得静中虚。\n已断声华念，临深肯羡鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"世事二首 其一","author":"赵善括","text":"世事今如此，惟堪一笑哗。\n空持冲斗剑，安得上天槎。\n远信凭飞翼，流年付落花。\n平戎须大度，何必顾纤瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"发舟至至德观","author":"赵善括","text":"风细樯高去路迟，晓烟秋色正霏微。\n弯环沙觜村市井，突兀江心古钓矶。\n涌月小轩无尽藏，参天老桧不胜围。\n山川好处都输与，不是缁袍即羽衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平山堂","author":"赵善括","text":"平山堂对妙高峰，极目郊原万里同。\n杳霭四垂天不尽，萦纡一带水无穷。\n城闉遥隔芙蓉浦，栏槛几经杨柳风。\n想见风流贤太守，一尊时复酹欧翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用子存韵寄乃兄雪香","author":"赵善括","text":"要识居尘不染尘，小窗容膝近东邻。\n香梢不老偏宜晓，瘦节常寒别是春。\n侑坐图书情颇厚，对床风雨梦还新。\n拟将梅竹方兄弟，若说清高更逼真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用同叔韵","author":"赵善括","text":"风定舟行力不难，一钩新月照溪湾。\n断烟横抹岸头树，落日斜攲江上山。\n鱼鸟久知思旧侣，桑榆归去亦惭颜。\n儿童见我应相怪，两鬓如何雪样斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其二","author":"赵善括","text":"我是忘机士，初非学二疏。\n瓮醅常得醉，瓶粟任无馀。\n天下众生病，山中四壁虚。\n昔年刍豢口，今日伴钟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其一","author":"赵善括","text":"枕席方相好，儿童且勿哗。\n窗蕉鸾曳尾，檐树鹊鸣槎。\n有客谈飞屑，无才笔吐花。\n倦馀题短句，谁为指瑜瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同王秘校和同年五使君韵饯送严文守江阴 其二","author":"赵善括","text":"欲说澄江好，丹青百雉楼。\n山明新雨泽，潮涌乱云流。\n贤守声先至，疲民疾已瘳。\n中兴待良佐，千里未分忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同王秘校和同年五使君韵饯送严文守江阴 其一","author":"赵善括","text":"江左词章伯，朝端俊伟人。\n燕居文会友，得志泽加民。\n自是无心镜，俱传有脚春。\n成风运斤斧，何处不参神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同叶宰饯春净众寺","author":"赵善括","text":"千尺飞虹跨碧溪，绿阴沉水暗连堤。\n马蹄一踏沙头滑，云脚半垂山顶齐。\n招隐疏钟曾破梦，洗春微雨不成泥。\n晚来放目郊园外，万点翻鸦散麦畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次龚丈同叔高韵","author":"赵善括","text":"备尝险阻与艰难，久别松楸水一湾。\n孤愤未申思北阙，双眉初展见西山。\n化工已定休言命，巧匠于今亦汗颜。\n它日中兴筹庙略，为君一露管中斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过前冈见毁松有感 其一","author":"赵善括","text":"夹道松阴若剪齐，前人种得几多时。\n曾经行客频相恋，试问乡翁总不知。\n暗引风声号绿野，密留云影挂苍枝。\n今人惠物能如否，祇有摧残樵牧儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过前冈见毁松有感 其二","author":"赵善括","text":"当年种植到于今，用力虽劳用意深。\n巨荫已容车马过，盘根宁畏雪霜侵。\n两行冠剑大夫职，十万旌旗勇士林。\n烈日流金路无尽，此时方识古人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过清江怀莫谦父","author":"赵善括","text":"春来乘兴泛孤篷，棹影频移鉴影中。\n昨夜忽添三寸雨，今朝尤喜一帆风。\n桃红李白年年好，水绿青山处处同。\n屈指归时花未老，一樽携手过湖东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶宰","author":"赵善括","text":"暂时行李已堪忧，况是经年成漫游。\n三月晓风红扫地，一犁春雨绿盈畴。\n从教征袖尘埃满，赖有新诗箧笥收。\n桃李主人能好事，未归谁复叹淹流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和莫谦父韵","author":"赵善括","text":"扁舟昨夜过黄州，准拟篮舆作胜游。\n卷地骇风回岸脚，扑天惊浪打船头。\n一尊欲访东坡隐，两鬓难禁宋玉秋。\n江上乱山云色重，却疑眉黛锁闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚同叔春日即事五首 其五","author":"赵善括","text":"邂逅相逢好，初心各壮图。\n金兰期永好，银艾愿同纡。\n恨逐芳樽遣，情烦綵笔铺。\n风云偶然会，携手上天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚同叔春日即事五首 其四","author":"赵善括","text":"春已堂堂去，那闻杜宇啼。\n江山惊异土，桃李谩成蹊。\n我自无心了，谁能与物齐。\n功名傥相贷，深卷碧云溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚同叔春日即事五首 其三","author":"赵善括","text":"莺簧方报暖，鸠唤未容晴。\n新涨长还减，痴云暗复明。\n我生随分乐，春事有馀情。\n闻道东湖好，相邀散策行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚同叔春日即事五首 其二","author":"赵善括","text":"柳绵飞扑扑，荷叶散田田。\n物幻无穷意，春归何处天。\n事随鸾镜改，人逐燕巢迁。\n一笑千金价，吾羞鲁仲连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和龚同叔春日即事五首 其一","author":"赵善括","text":"苦雨不肯霁，花愁都落红。\n老农欣岁兆，游子恨途穷。\n寒尚衣难褪，春侵酒易中。\n城头喧角弄，轻度一帘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江玉虚观有牡丹思后圃亦正开恨不与集","author":"赵善括","text":"绛苞翠幄压朱栏，秀色生香观里看。\n小圃想须春烂熳，大家应是醉团栾。\n名缰久纵心无累，利径虽驰兴易阑。\n但愿对花常酩酊，莫思身外有悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结茅守冢偶携子弟散策郊游有感借用壁间韵 其二","author":"赵善括","text":"蠖屈地容壮，鸟还天宇闲。\n渔樵苕水市，薇蕨首阳山。\n瓮下金貂友，林中玉笋班。\n谁能齐万物，为我辨彭颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结茅守冢偶携子弟散策郊游有感借用壁间韵 其一","author":"赵善括","text":"天地一蚁磨，人生何日闲。\n此身真土木，到处即溪山。\n血点居苫泪，衣馀戏綵斑。\n春游板舆在，无复奉慈颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送运干陈圣嘉解组还朝","author":"赵善括","text":"月明千里正婵娟，且莫匆匆便放船。\n三载泛莲依绿水，一朝荐鹗上青天。\n西楼未作经笥梦，北阙先分御鼎烟。\n且向蓬山雠校了，却持荷橐从甘泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王漕稚川 其一","author":"赵善括","text":"紫荷馀爱在，皂盖填名城。\n膏泽流千里，嘉谋肃五兵。\n林泉多雅趣，桑梓有深情。\n道大虽难用，详观月旦评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王漕稚川 其二","author":"赵善括","text":"昆玉皆龙凤，唯公最白眉。\n乡邦好人物，翰墨妙词诗。\n南浦言犹在，西山梦可疑。\n我归公已逝，霰泪不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱倅周卿 其一","author":"赵善括","text":"戚畹芝兰秀，儒宗金玉相。\n解牛无肯綮，驰骥阻康庄。\n政术今犹诵，家风久益彰。\n蕴藏初未试，盛德付诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱倅周卿 其二","author":"赵善括","text":"自洒膏粱习，人推道义尊。\n蟾宫看桂子，凤穴见兰孙。\n遗戒垂家法，新诗断客魂。\n从今渭阳念，极目灌城村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈提举 其一","author":"赵善括","text":"蔺璧虽期复，苏书竟不还。\n庆馀钟令绪，才大压尘寰。\n劲正三朝老，从容半世闲。\n会心真是老，一笑别人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈提举 其三","author":"赵善括","text":"持斧威全振，分符盗易歼。\n真祠方赐逸，荣养遽难淹。\n许国心如在，绳家法正严。\n莫悲才不尽，祥览卧寒苫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈提举 其二","author":"赵善括","text":"志学屡辞爵，传家蔚有声。\n小官能抗疏，文吏乃知兵。\n守法摧强禦，输忠沃圣明。\n平生无所负，谗口任蝇营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵龙图大卿","author":"赵善括","text":"胶庠昔日共齑盐，穷达分携四十年。\n南北阮门殊少长，东西施子异媸妍。\n判花隽嗣跻三品，司稼名卿正九迁。\n世事只须聊复尔，秋堂明月岂长圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽韩漕直阁 其一","author":"赵善括","text":"忠宪勋名冠本朝，传芳五叶尽金貂。\n芝兰生子竞秀发，松柏如公合后凋。\n淮县剧繁迎刃解，蜀边奸慝望风销。\n才高见忌何须病，公道于今久寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽韩漕直阁 其二","author":"赵善括","text":"孳孳善政被民编，謇謇嘉谟黼扆前。\n万卷诗书门户壮，一生功业子孙贤。\n梦回芳圃犹樽俎，泪落虚堂绝管弦。\n我始卜邻君已逝，茂林修竹亦凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明偶题","author":"赵善括","text":"曲沼一泓碧，乱花双径红。\n攲梅惊北客，舞柳认东风。\n欲买春无价，常令酒不空。\n我生随分乐，初不问穷通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跃马西湖","author":"赵善括","text":"晓来何事到湖西，风急飞红衬马蹄。\n望信只愁秋雁断，爱春还恨早莺啼。\n山连楼阁云容重，水浸栏干月影低。\n归棹采菱重惜晚，一声歌过绿杨堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游香社寺","author":"赵善括","text":"山水兴方逸，尘埃缚暂宽。\n菜肠甘久素，酒颊助微丹。\n江阔烟光薄，霜滋叶晕残。\n不妨走幽寺，或可叩禅端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游梅仙坛口占","author":"赵善括","text":"篮舆破晓雨初收，天气正和麦正秋。\n四合平林空翠滴，一川芳草乱青浮。\n梅仙道馆松全古，马祖禅关山更幽。\n扰扰红尘竟何事，此身宜老白云秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登坛作","author":"赵善括","text":"一坛横压绀天低，好向云端觐紫微。\n林鹤惯闻金磬舞，烟鸾疑认玉台飞。\n步虚声彻空犹响，宝篆香销露未晞。\n星斗绣天长不夜，疑乘风驭扣瑶扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登梅仙坛观中作","author":"赵善括","text":"梅尉栖真昔已仙，祇馀岩谷正巍然。\n老松作势龙千尺，怪石拿空虎一拳。\n楼与云齐曾观日，坛因斗建欲扪天。\n如今胜景能长在，尘世应无海变田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登裴公亭借用杜牧之登齐山诗韵二首 其二","author":"赵善括","text":"风帘斜捲燕于飞，天气清和酒力微。\n极目烟波无尽藏，关心春梦有时归。\n香飘十里喧朝市，翠积千山断晚晖。\n杖屦不妨频一到，尘埃那解点征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登裴公亭借用杜牧之登齐山诗韵二首 其一","author":"赵善括","text":"春晚风花片片飞，登临共惜景熹微。\n人生待足谁如意，官况苦无胡不归。\n且向园林穷胜事，更凭山水发清晖。\n酒酣起舞君休笑，直欲淋漓身上衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题马氏避暑宫开福寺莲湖","author":"赵善括","text":"金仙楼观郁嵯峨，昔日曾容万绮罗。\n不见园林蒙锦绣，空教钟鼓唤笙歌。\n印花宝甃封苍藓，倚槛晴山拥翠螺。\n凉夜尚疑旌盖在，三千宫女袜凌波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题长沙倅厅磬沼","author":"赵善括","text":"嘉名雅合泗滨浮，玉振金声第一流。\n曲尺映桥横锦带，湾环沉月并瑶钩。\n清如有韵应仪凤，击若无心可狎鸥。\n好向新亭按宫徵，凌波声动一帘秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仪真天宁寺","author":"赵善括","text":"短棹客千里，炷香人小留。\n禅房深寂寂，世事易悠悠。\n去此两槐夏，惊予双鬓秋。\n钟鱼发新响，作意为重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题古圳铺","author":"赵善括","text":"去郭十五里，依山三两家。\n剪茅成栋宇，沽酒是生涯。\n雨过鸠休妇，日斜蜂趁衙。\n亲闱今咫尺，停梦看灯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题本觉寺","author":"赵善括","text":"春禽嚼徵更含宫，唤我精蓝路易穷。\n雨雪不垂成暮霭，花开都尽怨东风。\n一川芳草低随水，满眼青山半插空。\n跃马归来尤寂寞，此怀欲与故人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题定光壁","author":"赵善括","text":"护雨云初断，登山眼便明。\n枫彫丹舞叶，松古绿摇声。\n觉宿无穷老，禅关有底清。\n小春天不冷，归路尚馀情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵舍人","author":"赵善括","text":"季父英名上玉津，瞿昙抱送石麒麟。\n龙文宝册传青琐，凤阁鸾坡近紫宸。\n亲老侍行知有子，才高见忌岂无人。\n洪崖百仞泉飞玉，一洗人间万斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醮成作","author":"赵善括","text":"心格崇霄禁路通，纤埃收尽见天容。\n三千绛阙云开锁，十万霓旌月印踪。\n香袅郁葱翔鼎凤，松摇寥廓状云龙。\n虚皇夜宴长生殿，九奏琼璈动晓钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醮毕作","author":"赵善括","text":"醮阑星斗挂脩甍，綵跸丹舆上玉清。\n百尺坛空云弄影，一钩帘捲月输明。\n灵香匝地寒无力，宝奏钧天静有声。\n万里好风吹目断，松篁犹学佩环鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上王右司三十韵","author":"赵善括","text":"丱角从亲后，抠衣拱座隅。\n辞章窥雅制，翰墨景良模。\n零露哀先德，青云激壮图。\n暌违十五载，流落二三孤。\n蹇涩凭乡荐，崎岖达上都。\n芝眉重晤对，桂籍偶叨踰。\n劳苦温言重，开明鄙性迂。\n一雷初绾绶，千里遇分符。\n琴浦催科拙，澄江德政殊。\n美瓜滋灌水，良酝寄兵厨。\n社雁惊飞楚，边鸿不到吴。\n色辞思益远，忧患痛多虞。\n风树亲难待，林泉誓与俱。\n啼号真有累，缰锁复相拘。\n华节来临镇，荒城获走趋。\n二天蒙芘覆，半载幸驰驱。\n郡政惭轓盖，民歌愧裤襦。\n深期展四体，宁复顾微躯。\n厚意平生在，高风振古无。\n亲依方款密，聚散忽须臾。\n鹢首浮仙路，乌台接禁涂。\n苕溪虽近甸，宣室赖嘉谟。\n德盛应难外，民思觊少苏。\n甘泉跻法从，膏泽下寰区。\n自叹如巢幕，人怜数守株。\n寸心随履舄，只影在江湖。\n鸟倦一枝稳，龙须大手屠。\n闲情验蕉鹿，浩思忆莼鲈。\n已困三眠茧，还穷五技鼯。\n枫宸清问处，回首念疏愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐塘铺和周师禹韵","author":"赵善括","text":"迟日醉花春影长，村醪引入无何乡。\n碧林啼鸟惊梦断，行客红尘吹去忙。\n忧心悄悄谁知道，且是不关春事了。\n雨旸今岁定丰年，慇勤更问农家老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪游","author":"赵善括","text":"几重浓云泼黑墨，数点疏雨飞的皪。\n桃花李花红更白，不觉东风扫踪迹。\n深山绿暗新树密，悬崖倒挂春空碧。\n泉声泻出万霹雳，长虹飞过三百尺。\n蹇驴倒骑回语客，目端春事俱可识。\n茅舍敲门倾琥珀，古寺击鼓非玉食。\n我今已饱天工力，风吹浮云露白日。\n崎崄不复厌登陟，高处更穷低处逼。\n下瞰群峰五顽石，回首一笑天地窄。\n兴来策杖绕山侧，窦深岩远不可侧。\n相思涧边酌寒滴，一抹暝烟壮山色。\n寻真不见空回忆，使我伤今复伤昔。\n道人山房遍幽历，醉里疑从仙籍谪。\n钧天广乐梦中得，更问腾空好消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过金陵有感和韵","author":"赵善括","text":"五马渡江思典午，祖龙谩凿秦淮浦。\n未登三代盛明时，曾是六朝文物祖。\n中兴事业由忧勤，风流千载还芬薰。\n谢安王导亦可罪，至今遂使南北分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过清渚","author":"赵善括","text":"横冈栉比路弯环，茅店无人昼亦关。\n桑圃霜枯乾叶舞，麦畦雨润翠苗斑。\n山风力壮啸空谷，溪水流清露瘦滩。\n斜崦乍明天地阔，只疑身在碧壶间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伍解元喜祈雨有感","author":"赵善括","text":"痴龙偃蹇玩岁月，深居白云抱幽石。\n有时江海肆贪残，坐视天焦地皮拆。\n分疆守职各有方，止沸讵可扬其汤。\n曰旸而旸雨而雨，何待酹酒焚炉香。\n不谓神心有城府，必需精祷方降雨。\n刑鹅割牲厌口腹，缁衣黄冠诵章句。\n上天有意生斯人，假尔群祀江之滨。\n弄权推怨吝所施，帝怒碎戮犹微尘。\n吁嗟痴龙今已矣，异日忧深目前喜。\n勿将风雨希民求，岁岁丰穰尽天赐。\n我家亦有二顷田，膏泽霈然长有年。\n神心傥不悖天意，与民共赋噫嘻篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]