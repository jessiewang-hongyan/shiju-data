[{"title":"游南山晚归二首 其二","author":"范浚","text":"荒荒日已暮，回首兴何长。\n䆉稏纷乾穟，森疏啸折篁。\n水枯山石露，风晚野花香。\n归卧前檐下，诗成小雨凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺长兄茂宽赐绯","author":"范浚","text":"褒功传紫诏，锡服下丹墀。\n朱绂荣书记，银章付拾遗。\n舄凫随步趾，象笏映须眉。\n更卜垂三组，它年佩陆离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李修撰哀挽二首 其一","author":"范浚","text":"三朝推旧德，四海仰高名。\n起起方惊梦，嗟嗟忽奠楹。\n木冰伤达宦，薤露寄哀情。\n矫首西山下，悬河泪已倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李修撰哀挽二首 其二","author":"范浚","text":"公欲攀琪树，天令堕玉棺。\n生前纡白艾，身后跨青鸾。\n令子清规在，遗书旧墨乾。\n英灵今已逝，千古一长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日行兰溪道中六言二首 其一","author":"范浚","text":"云顽欲雪不雪，梅冻将花未花。\n荒草狭蹊山路，断桥流水人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日行兰溪道中六言二首 其二","author":"范浚","text":"瑟缩鸦栖古树，联拳鹭立回塘。\n水际风低白苇，隔村时见牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忘言示曾仲思","author":"范浚","text":"范叔初非辩士，曾子本同道人。\n欢伯解两家难，忘言一笑相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侄端臣七夕","author":"范浚","text":"万古东西隔女牛，停梭期会岂悠悠。\n虾蟆轮破青天暮，乌鹊桥横碧汉秋。\n莫放痴儿欢彻曙，且容老子强登楼。\n举瓢更取天浆酌，一洗胸中万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠光上人","author":"范浚","text":"道人工小笔，梅瘦竹婵娟。\n更学有声画，不参无眼禅。\n一枰聊复尔，七马独超然。\n为足前年句，真成续断弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张生夜载酒相过","author":"范浚","text":"夜卷一钩帘，衣寒觉露沾。\n未惊风割面，且看月磨镰。\n玉椀鹅儿酒，花瓷虎子盐。\n张公鸡黍旧，欢笑了无嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽居","author":"范浚","text":"幽居长杜户，竟日少来人。\n花动蜂儿去，帘垂燕子嗔。\n脱巾慵不整，得酒醉仍频。\n养拙风尘外，吾宁愧此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓龙丘次韵六兄茂永见寄","author":"范浚","text":"梦想常怀兄弟贤，何如合眼到东川。\n客居自幸贫无事，归计犹须大有年。\n一丈席间方隔阔，万金书意要频传。\n诗筒更喜如飞鸟，愿乞清新一百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侄端旻示游浦江花藏寺诗且道皎老相问意因次韵并烦为简皎公禅师","author":"范浚","text":"子到祇陀舍，经行几屐穿。\n想当吟出月，不奈思如泉。\n真界飞花雨，寒山落木天。\n皎公知好在，香室夜安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵三兄茂载偶成二首 其一","author":"范浚","text":"自笑踆踆走海边，栖迟已与俗相捐。\n谁怜乞米问卢老，懒以无薪告仲连。\n案上三杯朝不饱，膝头一榻夜惊穿。\n诗人未用生羞涩，尚觉囊中有一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵三兄茂载偶成二首 其二","author":"范浚","text":"君看如弦死道边，由来忠鲠世人捐。\n剑除佞士朱狂直，笏击奸臣顾少连。\n莫以古人蕲薄俗，空嗟膏轴运方穿。\n齿牙枉插于菟口，见说官家废料钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送欧丈朝请赴阙","author":"范浚","text":"祖道春风外，伤怀野水滨。\n亲盟丈人行，才力栋梁臣。\n好去鞭高足，荣期据要津。\n人言宣室召，未弃贾生贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵富修仲见赠二首 其二","author":"范浚","text":"幽栖长懒放，野性耻浮沈。\n避俗真成僻，居山恨不深。\n感君来辱意，契我愿交心。\n但愧琼瑶赠，才枯欲嗣音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过严州乌龙岭","author":"范浚","text":"何年龙胁破鳞皴，应是风雷役鬼神。\n曲折凿开南北路，去来老尽利名人。\n秦云楚树青天外，禹穴胥山沧海滨。\n下视蓑城如掌大，市声啾唧暗红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵翁承之见寄二首 其一","author":"范浚","text":"人情巇险摧车路，世事变迁鸣屐廊。\n自分北宫长粝食，懒从东壁借馀光。\n林庐雪后梅含白，篱落天寒橘孕黄。\n幽意只应君共醉，何时拂石对倾觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵翁承之见寄二首 其二","author":"范浚","text":"伊我索居吟雪屋，怀君独夜步风廊。\n语离尚忆三春暮，共醉曾分一日光。\n忽喜斜封书绢白，更传妙语色丝黄。\n遥知发兴虬松下，白眼看天自举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀曹宗臣并寄","author":"范浚","text":"闭关自喜脱愁笼，未愧柴桑避俗翁。\n黄奶引人千里梦，青奴借我一窗风。\n绿葵紫蓼园蔬课，白葛朱藤野步供。\n尚想故人怀别久，论文安得一樽同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侄伯通岁暮即事","author":"范浚","text":"世情分付与东流，含梗徒劳百念浮。\n但使心源长寡欲，便知乐地本无忧。\n处身忌作燕巢幕，脱事要如鹰掣韝。\n节腊好同营一醉，幸逢开泰戢戈矛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼致政楼少师 其一","author":"范浚","text":"雅望题舆早已贤，高风晚岁更超然。\n笑收剑佩遗荣路，独往山林事引年。\n行马正看光梓里，卧麟忽叹掩松阡。\n乡州耆旧今垂尽，忍见山颓重涕涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼致政楼少师 其二","author":"范浚","text":"身后储休世或同，生前有耀孰踰公。\n班衣五彩枢臣贵，宝带万钉天眷隆。\n终始哀荣时共羡，丕扬宠赠会追崇。\n遥瞻素旆愁云外，惨憺悲歌立晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寓居兰溪地湿卧病","author":"范浚","text":"病怯帘疏雨到床，雨馀山霭上衣裳。\n宵携冷杖强看月，晓傍暖檐贪向阳。\n禦湿要须谋日饮，乏资深恨值年荒。\n所须药物真吾事，麦曲山鞠今满囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侄端臣同游藏春园","author":"范浚","text":"探春著屐犯榛荒，更入名园转曲塘。\n红认蔬畦怜小甲，白寻梅楥得幽香。\n全同花下迷山简，只欠池头语葛强。\n吾土信多行乐地，绝胜酒里到家乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏东山","author":"范浚","text":"烟嶂巍巍列翠屏，松山高下郁葱菁。\n风生万壑笙竽触，拟向林间筑小亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侄端方喜雪","author":"范浚","text":"川原恍若白崖天，屑玉轻明瑞有年。\n折竹掀轰宵暗积，欺梅艳溢晓相鲜。\n当知破耳冲风出，未似蒙头正昼眠。\n杲日能怜有贫者，不须更作寄天笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王大声","author":"范浚","text":"腹藁才名第一流，只今偃蹇困吴州。\n牛腰但使诗章富，鹤发宁论岁月遒。\n耻傍朱门随掉尾，独寻青箬钓查头。\n知君高胜如松竹，不遇犹为潇洒侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三兄茂载燕兄弟预者六友宜尽觞咏之乐长兄茂宽有诗因次其韵","author":"范浚","text":"南北东西遇合疏，偶然良会足欢娱。\n豹胎供馔斥鱼婢，雀舌试汤分酪奴。\n花萼成诗多共赋，竹根有酒不须沽。\n借令六逸无人画，也胜当年九老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花前有感兼呈崔相公刘郎中","author":"仲并","text":"落花如雪鬓如霜，醉把花看益自伤。\n少日为名多检束，长年无兴可颠狂。\n四时轮转春常少，百刻支分夜苦长。\n何事同生壬子岁，老于崔丈及刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"晁公武","text":"峨眉古名山，长雄坤之维。\n月峡为表里，雪岭相蔽亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题贡院","author":"赵善晤","text":"天约闲云结嫩阴，苦无诗酒懒登临。\n一声鸡唱日初午，满地花寒秋已深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"胡铨","text":"当时号令君听取，白战无须带步叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落花十绝 其七","author":"冯时行","text":"即看簇簇斗鲜妍，忽作漫天也可怜。\n随雨随风知有恨，恨无人著买春钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊题瀼东人家屋壁 其二","author":"冯时行","text":"风引晴云度去，腊催残叶飞来。\n短景馀寒几日，安排都放花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"汤思退","text":"虞妃从梧野，启母祔稽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"孟大武","text":"綵仞气浮三塔耸，浮牌声振两溪寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"孟大武","text":"扫地石盆冷，闭门春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"曾惇","text":"南城南丰万家邑，异人间出俱屹立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"曾惇","text":"近城殊未发，君与探山宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李士举过仙都徐氏山居 其二","author":"谢伋","text":"耄倪扶杖小童闲，绕舍清溪碧水环。\n争看赤帷仍避传，静无桴鼓爱青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院和陈蕃仲酴醾两绝 其二","author":"葛立方","text":"幽姿不分小山丛，合在江梅季孟中。\n香破鹤林真呓语，肯教七七擅神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子直画屏求题诗 裴休乞食歌姬院","author":"葛立方","text":"一从黄檗逗真机，瞥地回光更不疑。\n著脚洞房犹乞食，那知罗刹是歌姬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建国刘夫人挽歌词 其二","author":"葛立方","text":"四德推贤范，流芳在管彤。\n植兰门户秀，嚼蜡世缘空。\n荷橐夫官重，萱堂母道崇。\n相孙仍相妇，寂漠閟幽宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"机简堂自隐静归为万年主人访余林下相与道旧因以述怀","author":"吴芾","text":"吾乡本仙窟，石井尤奇特。\n民物生其间，古来盖千亿。\n惟师与我家，所居共阡陌。\n少小初无殊，长乃分儒释。\n术业虽不同，于道俱有得。\n师为方外游，声价已籍籍。\n象教久衰微，赖师振业席。\n炉鞴与钳锤，信有弥天力。\n果续佛慧命，作大善知识。\n我虽登禁涂，无功亦无德。\n但有忧国心，徒劳竟何益。\n挂冠归林下，面亦无惭色。\n知心独有师，相视笑莫逆。\n每思共谈玄，倾倒此胸臆。\n江浙遥相望，恨不生羽翼。\n昨朝忽惠然，得得访泉石。\n一见双眼明，欢喜几折屐。\n第念我与师，彼此头颅白。\n世路方艰难，老去合休息。\n师既归故乡，不应复他适。\n愿言却世缘，来伴我幽寂。\n相看成二老，永为闾里式。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再题周处士山居 其二","author":"吴芾","text":"闲驱小队出城闉，春色三分已二分。\n到处有花浑灼灼，望中无木不欣欣。\n故池尚想玄晖宅，荒草空悲太白坟。\n满目青山谁是主，独输高士卧烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和泽民喜雨","author":"吴芾","text":"阴长阳消帝怒深，尽驱赫日扫群阴。\n却疑枉致一秋旱，聊复霈为三日霖。\n陇亩共知成乐岁，里闾谁不起欢心。\n朝来幽鸟知予意，亦向檐前作好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送诸乡人赴试南宫","author":"吴芾","text":"闻道诸君上玉京，一杯聊复话离情。\n青钱既中三年选，黄鹄须看万里程。\n欲向他时成远器，要从今日立修名。\n吾君锐意图兴复，好把嘉言对集英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱世同夜闻竹声","author":"吴芾","text":"醉卧空斋静绝人，夜阑霜月白纷纷。\n寒生枕上浑无梦，声到窗前疑是君。\n玉轸谁家调古曲，铁衣何处角孤军。\n羡君写入新诗里，清壮还应过所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中偶有所感再成一绝","author":"吴芾","text":"倒著山公白接䍦，尚怀前日醉蛾眉。\n江山风物还如旧，祇欠波间玉笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题惠照斋宫僧房","author":"吴芾","text":"古木脩篁翠欲堆，小窗那更面山开。\n谁知局促尘埃里，犹有山光入眼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"坐间见装成早梅数枝","author":"吴芾","text":"正欲攀条折蕊看，忽惊枝上雪斑斑。\n不知妙手新装缀，误使衰翁为解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朝宗海棠","author":"吴芾","text":"海棠已赋十分妆，细看妖娆更异常。\n不得与君同胜赏，空烧银烛照花光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"定光南安岩 其二","author":"郑弼","text":"香风影里迎新魄，梵呗声中见落晖。\n自恨劳生名利役，不能来此共忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂二十九首 其二十四","author":"释云","text":"了了了时无可了，玄玄玄处亦须呵。\n贪生逐日区区去，唤不回头争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴 其二","author":"胡宏","text":"扁舟迤逦过焦金，江阔千寻不记深。\n明月有情偏照我，好山无处不知心。\n天空一鸟惊渔火，夜静群星落野砧。\n此处风光尽难得，朗然因复有清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东湖游山","author":"史浩","text":"四明山水天下异，东湖景物尤佳致。\n古来奇处芜没多，极目空馀老苍翠。\n最称险奥唯福泉，崒嵂万仞摩青天。\n屹起精蓝名寿圣，松风飒飒泉涓涓。\n一径崎岖通下水，风物人情更淳美。\n两椽茅屋何萧然，是即吾庐靠山起。\n吾尝终日倚阑干，眼界峨峨碧玉攒。\n有时出户一乘兴，枯筇蜡屐随清湍。\n攀萝直上上水去，烟霞迤逦僧家路。\n龙藏虎蛰天地宽，陟岵欷歔空堕泪。\n次经象坎白云庵，阴崖断谷常青岚。\n中有村墟号韩岭，渔歌樵斧声相参。\n陶公霞屿峥嵘出，秀杰绵延数非一。\n鳖山孤立水中央，规圆不赖人镵刻。\n地雄山壮泉源豪，七十二溪俱怒涛。\n截山突屼起六堰，百尺花蹊金石牢。\n鸣桹掷钓渔艇短，数百成群来往款。\n绿蓑青笠苦忘归，细雨斜风浑不管。\n栖真兰若唯南隅，闻是徐王旧隐居。\n莲塘十里香风阔，凫鹥鸂鶒时沉洳。\n一帆迅抵青山寺，丈室云堂高赑屃。\n森森松菊蔽村祠，细读刓碑知故事。\n云是皇朝李使君，浚浊澄清利后人。\n迄今旱岁赖实利，血食往往长秋春。\n破雾穿云梯磴滑，石胁山腰遍金刹。\n濯足清流舒啸长，筼筜十亩清风戛。\n紫衣道士氏曰朱，高论山前结草庐。\n客至石坛无俗物，横琴数曲酒一壶。\n对岸二灵只一苇，依约谁家葬龙耳。\n夜深疏雨洗遥空，一朵浓云罩山觜。\n金襕禅老今大颠，坏衲蒲团日坐禅。\n我行不问西来意，消息还将方寸传。\n乌石山头滕奥口，泓澄万丈辉星斗。\n过客谁知此地灵，只闻静夜生龙吼。\n鉴湖芜没多田畴，临平车马尤喧啾。\n纷纷未识兹万顷，神仙窟宅合在东南北西陬。\n周游几千里，此兴犹未已。\n归来摸写笔不停，大匠从其诮狂斐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时晋亨作小轩块石盆池名曰趣远真隐居士赋之","author":"史浩","text":"新晴可步履，杖策穿云林。\n萧斋有达士，六合涵胸襟。\n东偏辟小窗，广袤不盈寻。\n片石远山意，寸池沧海心。\n乃知一芥子，可纳须弥岑。\n归鸿目不尽，为尔发微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其一 叠山","author":"史浩","text":"嵩山远万里，儿孙可邀致。\n当轩罗三峰，便有出群意。\n不蜡谢氏屐，徜徉日游戏。\n邂逅风雨兴，端可名福地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其二 凿池","author":"史浩","text":"萧萧足佳致，心远地自偏。\n斫去苍苔纹，得此清泠泉。\n湛然不容滓，于以明性天。\n肯复以童儿，见诮韩公篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其三 栽松","author":"史浩","text":"童童蒿艾间，拱把力尚微。\n托根一得所，势隘天四围。\n春烟滋苍髯，朔雪被羽衣。\n他年大夫封，风雨良足依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其四 洗竹","author":"史浩","text":"春林藉雷惊，??牛羊出。\n风月迩来稀，厌此琅玕密。\n繁柯谢一洗，挺挺岁寒质。\n终成葛陂龙，云路骋骏逸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其五 浇花","author":"史浩","text":"芳圃向成趣，雨泽多愆时。\n花开不抱瓮，花谢嗟何为。\n潘岳兴不浅，陶潜颜可怡。\n安得商家霖，万木均嬉嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨少辅山居六咏 其六 薙草","author":"史浩","text":"设罗门巷静，草深山更幽。\n何事勤诛锄，杖屦来羊求。\n王孙未归楚，苌弘已弃周。\n惜此年年绿，君其勿剪休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]