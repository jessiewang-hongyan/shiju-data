[{"title":"邵仲恭许相过金山未至","author":"释道潜","text":"二月归来江上居，江流变渌江鸥去。\n时移物改何足论，身世悠悠本非固。\n鸠鸣屋角山雨馀，花苞破红满芳树。\n晴窗晓日幽兴催，振衣出户凌高台。\n潮回浪死风色定，缥缈沙岸烟中开。\n故人佳期绝消息，满眼空看暮云碧。\n何日扁舟南渡来，一洒高风破吾臆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维王府园与王元规承事同赋 其一","author":"释道潜","text":"年少王郎一幅巾，杖藜呼我步城闉。\n红泥亭子阑干外，绝目遥看万树春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维王府园与王元规承事同赋 其三","author":"释道潜","text":"蔼蔼春空宿雾披，桃溪柳陌共逶迤。\n阿戎莫道无才思，细草幽花总要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚 其二","author":"释道潜","text":"晓风池沼水澜翻，春尽淮南麦秀寒。\n院落无人日亭午，柳花如雪满阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚 其三","author":"释道潜","text":"怪雨盲风卷却春，傍栏萧瑟只青筠。\n引雏燕子朝来去，回首多情语更频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邵伯道中 其一","author":"释道潜","text":"一道河流远接天，两行官柳复萧然。\n村舂历历鸣何处，彷佛孤烟落日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邵伯道中 其二","author":"释道潜","text":"回首山光古寺基，拂天寒木耿斜晖。\n孤撑渐与钟声远，但见风幡竹外飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂观雨","author":"释道潜","text":"午枕藜床梦忽惊，柳边雷送雨如倾。\n蜀冈西望芜城路，银竹森森十里横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆秋夜 其一","author":"释道潜","text":"梵呗声沈香雾销，月明金殿影岧峣。\n夜深唯有龛灯在，风露满庭人寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建隆秋夜 其二","author":"释道潜","text":"娟娟云月照窗扉，纸帐形开梦觉时。\n庭下风篁自成韵，吹箫安用玉人为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"释道潜","text":"丛薄萧萧朔吹翻，暝鸦辽乱欲投村。\n江南雪后山无数，林表才分翠一痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵阎永仁博士同饮蜀井","author":"释道潜","text":"潭潭古甃閟高冈，脩绠低悬百尺长。\n廋语乐天推绝特，第泉鸿渐许甘凉。\n金盘谩说漙秋露，玉碗休誇沃蔗浆。\n更有碧梧盘爽荫，坐惊亭午失骄阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵永仁见赠","author":"释道潜","text":"怜君泣血依坟墓，虽设衡门不妄开。\n盈几贝多翻百遍，同龛弥勒礼千回。\n夜寒幽鸟窥香火，岁暮邻僧数往来。\n何日为余重扫榻，卧听松韵落清哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵何子温龙图见赠","author":"释道潜","text":"春破邗沟古驿旁，挥毫邂逅沈东阳。\n自惭击壤无高韵，但愧投珠有异光。\n旷达未应输靖节，风流可复羡知章。\n我非照镜迷头客，一接清欢亦似狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨康功待制所藏醉道士石","author":"释道潜","text":"天官夜燕琼楼春，一官大醉颓穹旻。\n飞光贯地若素练，百里鸡犬声纷纷。\n吹风洗雨岁月古，化此顽石良悲辛。\n楚山之老颇知异，濯以涧底清漪沦。\n霓裳彷佛认羽客，楮冠数寸横秋云。\n空斋昼闲戏一击，琅然哀韵还清真。\n我闻天官天所陈，虽复暂屈终当申。\n烈风迅雷一朝作，却上苍苍朝紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾明夜坐怀孙莘老学士","author":"释道潜","text":"余生飘泊犹断蓬，讵肯低回附根柢。\n兹焉得坎谩栖止，一日从风即轻逝。\n淮南十月寒未苦，耿耿虚堂属宵外。\n星辰错落挂檐庑，爽气侵寻入衣袂。\n桐叶声翻玉露圆，竹枝影扫金波碎。\n安得南邻庞老翁，挥麈堂堂坐相对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维阳府学四柏堂","author":"释道潜","text":"頖宫本凄凉，庭户无冗长。\n苍然馀四柏，终日清相向。\n夫人擅所有，高怀益超放。\n炎蒸五六月，大厦如瓮盎。\n凉飙天外来，披拂逾一饷。\n恍如乘虚舟，破月渡溟涨。\n严冬众木死，薿薿独无恙。\n非求造化私，故与冰雪抗。\n宜亦有神明，兹焉阴所相。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少游学士送龚深之往金陵见王荆公 其一","author":"释道潜","text":"春风随意可嬉娱，水有舟航陆有车。\n应笑杨雄未忘我，闭门犹著解嘲书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少游学士送龚深之往金陵见王荆公 其二","author":"释道潜","text":"梦幻皆输古竺乾，功名何用咤燕然。\n羡君一棹江南去，碧荠时鱼暮雨边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少游学士送龚深之往金陵见王荆公 其三","author":"释道潜","text":"虎踞龙盘亦漫雄，城荒狐兔往来通。\n可人惟有秦淮月，出没娟娟波浪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵少游学士送龚深之往金陵见王荆公 其四","author":"释道潜","text":"白下长干春雾披，家家桃李粲朝晖。\n悬知一见毗耶老，心地如灰不更飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄子理宣德田居四时 其一","author":"释道潜","text":"四序自逶迤，田园常局促。\n春阳旋东皋，迫我事铫耨。\n出种曝篱根，驱牛饮溪曲。\n晖晖明朝阳，聒聒喧布谷。\n颓龄惜筋骸，晓睡谩云足。\n蓐食出柴门，荷筱赴幽谷。\n搴条视柔桑，密叶已舒绿。\n今年气候早，膏雨厌霢霂。\n邻翁时一来，耕耨每相属。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄子理宣德田居四时 其二","author":"释道潜","text":"离离小麦黄，习习南风度。\n桑枣暗蓬麻，耘锄困朝暮。\n种瓜屋东隅，翠蔓已分布。\n黄花引疏篱，冉冉欲横路。\n白水漫青秧，联翩下鸥鹭。\n新丝换浊酒，肴蔌羞薄具。\n扫洒聚比邻，环坐荫高树。\n稚子羡赢馀，牵衣傍翁妪。\n牛羊岭外归，落日林梢去。\n饷妇亦还家，笑言隔烟雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄子理宣德田居四时 其三","author":"释道潜","text":"村落已徂暑，蚊蝇尚喧啾。\n衡门霁朝雨，茅竹归新秋。\n机丝迫邻女，札札无停休。\n中田蔼黄稼，烂熳如云浮。\n渌蚁酿新瓮，嘉鲂钓清流。\n瓦尊迟来客，礼数忘献酬。\n三杯未肯辞，笑语方绸缪。\n时平盗自隐，场圃无宵忧。\n儿孙渐束发，婚嫁迫所谋。\n款曲从我言，归途蹇淹留。\n林端有月色，相送前溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄子理宣德田居四时 其四","author":"释道潜","text":"朔吹鸣高林，回塘冰已结。\n牛羊卧茅屋，原野暗飞雪。\n壮男臂彫弓，短后事田猎。\n饥鹰一号呼，荒径洒毛血。\n归来誇意气，邻舍呼饮啜。\n明朝过南山，更欲穷窟穴。\n寒炉然豆萁，光燄时起灭。\n布被拥娇儿，从渠踏里裂。\n老翁寝不寐，展转念鹅鸭。\n篱落易穿窬，狐狸恐惊发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和龙直夫秘校细雨 其一","author":"释道潜","text":"细雨连阡陌，轻云湿不飞。\n池寒鸥自卧，巢冷燕催归。\n惨澹疑沈树，飘萧忽近帏。\n檐花沾已久，稍欲堕人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和龙直夫秘校细雨 其二","author":"释道潜","text":"薄雾兼寒雨，凌晨霭未分。\n细宜池上见，清爱竹边闻。\n斗帐侵兰梦，虚棂逼蕙薰。\n晚来欣小霁，钩箔见疏云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和龙直夫秘校细雨 其三","author":"释道潜","text":"傍砌飘才断，从风强更来。\n斑斑泣蛛网，浥浥汗江梅。\n薄日光时漏，曾阴意未开。\n少陵心易感，诗句写清哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵孙传师龙图游醴泉寺","author":"释道潜","text":"杨林几曲到城根，中有招提气象昏。\n暝雀聚群盘栋吻，老藤垂蔓覆高垣。\n月生归路无灯火，巷转人家有笑言。\n却掩吾庐还寂寞，冷风摇幔影翩翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴 其一","author":"释道潜","text":"积雨久不破，曾阴蔽城阙。\n晓来得春风，扫荡净六合。\n绰约墙头花，依微带残月。\n少年谁家子，骅骝飞蹀躞。\n扬鞭出郊去，逸兴生林樾。\n黄鸟弄柔音，青梅已堪折。\n行乐须及辰，芳时易消歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晴 其二","author":"释道潜","text":"寒食东城隅，青杨夹驰道。\n高楼暖凤笙，绝曲闻缥缈。\n晴日动鞦韆，飞烟拂瑶草。\n南邻与北里，良辰竞为好。\n人生逆旅间，何必事枯槁。\n仰首笑春风，兹怀谁与造。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东园 其一","author":"释道潜","text":"斜照明明射竹篱，桑阴翳翳麦蛾飞。\n萧条一径无来辙，时见羸牛引犊归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东园 其二","author":"释道潜","text":"曲渚回塘孰与期，杖藜终日自忘归。\n隔林彷佛闻机杼，应有人家在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东园 其三","author":"释道潜","text":"云峰缺处支筇立，溪溜声中弄扇行。\n习习南风吹百草，幽香知有蕙兰生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上 其一","author":"释道潜","text":"芦梢向晓战秋风，浦口寒潮尚未通。\n日出岸沙多细穴，白虾青蟹走无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上 其二","author":"释道潜","text":"今夜沙头月上迟，小萤零碎傍船飞。\n可怜光彩虽无限，何似婵娟一寸辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上 其三","author":"释道潜","text":"天阔阴云低抱树，沙寒鸥鹭欲亲人。\n小航泊处谁家住，脩竹疏花宛似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜会孙莘老司谏书斋 其一","author":"释道潜","text":"去马来车声已阑，雪云低压暮檐寒。\n地炉山蘖烧初熟，软语聊为世外欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜会孙莘老司谏书斋 其二","author":"释道潜","text":"碧瓦炉焚袅袅香，红柑紫栗更分尝。\n从来乐事人间少，不惜归途夜漏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜会孙莘老司谏书斋 其三","author":"释道潜","text":"多病山人能放旷，忘缘居士解逍遥。\n蒲团叠足清相向，谁道云林胜市朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓出土山","author":"释道潜","text":"绕山脩竹晓参差，叶叶涂霜坠碧枝。\n日脚渐高风乍起，萧萧恰似雨来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蔡彦规主簿","author":"释道潜","text":"绕舍苍烟晚更凝，隔帘新月未多明。\n栖乌著树无馀噪，老桧吟风有细声。\n客散愈怜真境好，定回犹觉幻身轻。\n可堪俗子能知味，此语聊传北郭生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵太虚夜坐","author":"释道潜","text":"古寺冬萧瑟，天寒色更冥。\n捲帏延素月，转盼失流星。\n炉底眠枯蘖，窗根立冻瓶。\n谈馀焚柏子，一燧小烟清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广陵城外野步呈莘老","author":"释道潜","text":"林梢聒聒鸟声繁，积雪初消涧水浑。\n老树卧波寒影动，野烟浮草夕阳昏。\n风回笛响山前路，犬吠人行竹外村。\n杖屦不知幽兴远，归来新月在柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王通叟寺丞见寄","author":"释道潜","text":"彫斲肝脾欲报公，还如献豕过辽东。\n珠玑屡获渊云妙，土木曾无粲忍风。\n耿耿吟魂嗟异处，迢迢桂魄谩相同。\n锦囊应有新诗在，九曲池边多塞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄仲恭","author":"释道潜","text":"晓雨霁郛郭，晴云递纷披。\n曦和拆万物，初茎弄葳蕤。\n鯈鱼泳弱藻，漾漾动碧漪。\n缅彼空际山，黛影摇参差。\n感此芳菲节，美人旷佳期。\n音形眇何方，莽莽天一涯。\n长河泮春冰，花浪激箭驰。\n好凭三尺鲤，寄我相思诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早秋南楼书事","author":"释道潜","text":"白帝初回天地秋，井梧叶老阴尚稠。\n森森爽气入屏幔，骨冷魂清无汗流。\n觉来览眺觅佳处，挟册独上西南楼。\n崇山广泽坐可挹，远水孤村横道周。\n上窥青天堕海日，下瞰白鹤盘庭楸。\n谁令浓阴起曾嶂，扑扑乱眼如云浮。\n埋林涨壑只俄顷，抚袂掩抑将谁俦。\n明星皎月邈难见，络纬蟋蟀空啁啾。\n安得风生土囊口，万里一扫无停留。\n王孙未归空碧草，我思不见徒离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老经六合西门水亭怀裴学士","author":"释道潜","text":"折柳相从地，重来失旧柯。\n林光延晚照，岸影动霜波。\n碧圃檀栾密，朱檐翡翠过。\n主人成异物，搔首奈情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和莘老初至温泉呈庆禅师","author":"释道潜","text":"年华行已老，林莽尚葱苍。\n地胜连龙窟，泉温注鬼汤。\n人风远城市，钟梵近僧坊。\n九夏来投锡，栖心应更凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋温泉","author":"释道潜","text":"赭落峰前与世分，溶溶汤井翳深云。\n月生滋穴流寒影，风入华清皱碧纹。\n暗引石池波宛转，暖蒸苔壁气氤氲。\n解衣盘礴南窗下，骨肉都融到日曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵莘老游龙洞","author":"释道潜","text":"曈眬杲日破林坰，杖策相将马暂停。\n路与猿猱争险磴，身随鸿鹄入青冥。\n巉岩曲穴疑无底，盘屈苍虬信有灵。\n能使谢公诗兴动，宛如游刃发新硎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵莘老赠显之","author":"释道潜","text":"盘盘秀岭绕曾檐，方丈门开挹翠岚。\n风激松梢声间发，月留泉底影相涵。\n天机清晓猊台震，险句穷宵虎穴探。\n白傅异时修故事，杖藜应许到云庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虚乐亭","author":"释道潜","text":"谁构新亭近翠微，似教陶令洽天机。\n池光引月来檐庑，竹影疏风到客衣。\n爱酒有时携玉斝，无弦聊自拂金徽。\n人间乐事还能几，肯向良辰与物违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱伯收主簿观雪 其一","author":"释道潜","text":"朝来密雪蔽天涯，坐目丘园发素华。\n初著败梧惊拥肿，久沾庭竹见攲斜。\n水精不动垂千箸，云母无声落万家。\n安得曾穹返收拾，莫教狼藉浑泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵朱伯收主簿观雪 其二","author":"释道潜","text":"阴风何事吼檐牙，夜半窗前变物华。\n梦断只疑蟾影在，褰帏俄骇练光斜。\n苦侵陋巷凌寒士，强入高楼媚酒家。\n霁后请看庭下草，蕙兰含绿出晴沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵姜伯辉朝奉宿九曲池","author":"释道潜","text":"当时楼阙已桑麻，陈迹何须置齿牙。\n宛转颓城围绿野，嵚崟孤塔背明霞。\n山云度晚飞琼叶，海月生秋堕桂花。\n圆峤方壶同笑语，终宵疑在水仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邗沟绝句","author":"释道潜","text":"隔屋萧萧风度竹，当空粲粲斗翻芒。\n峥嵘岁月人间暮，目断云山归兴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过新开湖寄李端叔大夫","author":"释道潜","text":"新开湖边秋梦晓，鸡犬无声人悄悄。\n试揭疏篷觇日华，水面残星犹缭绕。\n尝闻明珠藏巨浸，光焰一出辉群草。\n篙师为我暂停橹，罔象终期入幽讨。\n波间宛转兴方豪，依然别恨生怀抱。\n故人离群东海头，徇禄摧眉事枯槁。\n菰梢蘋末翠犹在，蕙兰憔悴青枫老。\n浪游不知岁月徙，旧约无端失天杪。\n目羡南鸿两两飞，安得身同羽翰小。\n游胥堂在吾必行，一榻数椽应预扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下晓霁","author":"释道潜","text":"千门昨夜雨，万木晓生光。\n御水浮红蕊，宫云丽粉墙。\n转楼迟日静，萦草乱丝长。\n想像西池路，浓阴覆绿杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬邵彦瞻朝奉见寄","author":"释道潜","text":"扬州从事多文华，新诗组织如朝霞。\n高怀忽念朔方客，秋风一纸来天涯。\n都城冠盖属休沐，邂逅过我森如麻。\n开缄传读不知厌，愕立圜视相惊誇。\n上言音形阔川路，下言杖屦埋风沙。\n蹲鸱正熟邀我返，城南古寺无諠哗。\n我今翩然已东下，轻舟早晚从公家。\n平山堂西百尺井，请公为汲烹露芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访彭门太守苏子瞻学士","author":"释道潜","text":"眉山郁茀眉水清，清淑之气钟群形。\n精璆美璞不能擅，散发宇内为豪英。\n煌煌苏氏挺三秀，豫章杞梓参青冥。\n少年著书即稽古，经纬八极何峥嵘。\n未央宫中初射策，落笔游刃挥新硎。\n翰林醉翁发奇叹，台阁四座争相惊。\n逡巡传玩腾众手，一日纸价增都城。\n同时父子擅芳誉，芝兰玉树罗中庭。\n风流浩荡播江海，粲若高汉悬明星。\n前年闻公适吴会，壶浆跪道人争迎。\n浮云流水付幽讨，下视世网鸿毛轻。\n野人弱龄不事事，白首丘壑甘忘情。\n神仙高标独未识，暂弃萝月人间行。\n朝吴暮楚失邂逅，惝恍夜梦还茕茕。\n迩来旅食寄梁苑，坐叹白日徒虚盈。\n彭门千里不惮远，秋风匹马吾能征。\n铃斋吏退属幽款，一看挥麈银河倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭门书事寄少游 其一","author":"释道潜","text":"我思君处君思我，此语由来自谪仙。\n欲借野人传纸尾，待凭新雁寄辽天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭门书事寄少游 其二","author":"释道潜","text":"戏马台边驻马蹄，回廊曲院总攀跻。\n秦郎前日曾来否，试拂凝尘觅旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]