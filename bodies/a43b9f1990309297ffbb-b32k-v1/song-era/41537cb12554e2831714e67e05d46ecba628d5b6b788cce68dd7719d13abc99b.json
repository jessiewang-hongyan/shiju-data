[{"title":"题信丰县城门六首 其四 清平","author":"罗椅","text":"行行西复西，稍喜市声静。\n征夫指前路，望望梅花岭。\n淡烟鸡犬村，落日牛羊径。\n忽见荷锄人，唤起归田兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题信丰县城门六首 其六 朝天","author":"罗椅","text":"驾言出北门，长桥拱门外。\n双溪东西来，到此而始汇。\n人言似章贡，玉虹夹其背。\n拟作合江亭，景物无小大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题向伯侨吴松雪霁图三首 其三","author":"罗椅","text":"天随漫解理艇，不惯霜后霜前。\n幸自竹篙閒著，抛来借与邻船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题向伯侨吴松雪霁图三首 其二","author":"罗椅","text":"天上清流云片，人间名胜吴松。\n两贤相厄已甚，赖有斜阳半峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题向伯侨吴松雪霁图三首 其一","author":"罗椅","text":"暖来日晒冰滑，恨极天寒竹修。\n云开梵铎相诉，水活渔船自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八声甘州 孤山寒食","author":"罗椅","text":"甚匆匆岁月，又人家、插柳记清明。\n正南北高峰，山传笑响，水泛箫声。\n吹散楼台烟雨，莺语碎春晴。\n何地无芳草，惟此青青。\n谁管孤山山下，任种梅竹冷，荐菊泉清。\n看人情如此，沉醉不须醒。\n问何时、樊川归去，叹故乡、七十五长亭。\n君知否，洞云溪竹，笑我飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子","author":"罗椅","text":"晚潮生，凉月细。\n一抹远山无蒂。\n收越棹，起吴樯。\n人间何限忙。\n石头城，西北角。\n杳杳天低鹘落。\n浑不似，此波光。\n清歌催夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青","author":"罗椅","text":"萼绿华身，小桃花扇，安石榴裙。\n子野闻歌，周郎顾曲，曾恼夫君。\n悠悠羁旅愁人。\n似飘零、青天断云。\n何处销魂，初三夜月，第四桥春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"罗椅","text":"明虹收雨。\n两桨能吴语。\n人在江南荷叶浦。\n采得蘋花无数。\n梦中舞燕栖鸾。\n起来烟渚风湾。\n一点愁眉天末，凭谁刬却春山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗椅","text":"华裾客子袖文过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"罗舜举","text":"腊酒催诗处，春幡剪綵时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自和","author":"罗道成","text":"水云踪迹自閒游，夏谷阴寒冷胜秋。\n猿鸟性情犹恋旧，翻身却去海边州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投郭主簿","author":"罗道成","text":"白骡代步若奔云，闲人所至留诗迹。\n欲知名姓问源流，请看郴阳山下石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游岳","author":"罗道成","text":"因思灵秀偶来游，碧玉寒堆万叠秋。\n直上太山高处望，根盘连接十馀州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白鹭亭","author":"罗愚","text":"千古城头白鹭亭，鹭飞长是满江汀。\n如何览德辉台上，只有台存凤不灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送永丰汪令","author":"罗椿","text":"锦缆梅花浦，江南作县归。\n新来荐鹗牍，惊动衮龙衣。\n岁晚情难别，心亲事却违。\n恐君天上去，扶病出烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨诚斋","author":"罗椿","text":"不愁风月只忧时，发为君王寸寸丝。\n司马要为元祐起，西枢政坐寿皇知。\n苦辞君命惊凡子，清对梅花更与谁。\n梦绕师门三稽首，起敲冰砚诉相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 贺杨诚斋","author":"罗椿","text":"郎星锦帐，忽翩然归访，南溪孤鹜。\n前日登高谁信道，寿酒重浮茱萸。\n风露杯寒，芙蓉帐冷，笑受长生箓。\n广寒宫殿，桂华应已新续。\n不用翠倚红围，舞裙歌袖，共理称觞曲。\n只把文章千古事，留伴平生幽独。\n但使明年，鬓青长在，萱草春风绿。\n诸郎如许，转头百事都足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"罗椿","text":"春消千嶂雪，清逼五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"罗椿","text":"露湿看花脚，莺啼欲晓山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颂秋浦先生","author":"罗源民","text":"十里清溪流活水，连村绿稼有甘霖。\n罗村野叟千秋史，秋浦先生一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴氏四贤堂 其四 鉴","author":"罗鉴","text":"敬斋一则话，传自南轩翁。\n于湖金玉之，诸老归下风。\n不使掌帝制，嗟哉吾道穷。\n遗像今伟然，吾敬司封公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴氏四贤堂 其二 澥","author":"罗鉴","text":"经济学有用，宁与佔毕同。\n集英晨唱第，夕对蓬莱宫。\n儒林急渊源，不遣朔庭空。\n遗像今伟然，吾敬国子公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴氏四贤堂 其一 沆","author":"罗鉴","text":"河汾续经罢，洙泗还清风。\n深衣大带垂，身退道则丰。\n一编通言在，万古无盲聋。\n遗像今伟然，吾敬环溪公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴氏四贤堂 其三 曾","author":"罗鉴","text":"中兴洪韩吕，文章之钜工。\n密年遍参请，一镞直箭锋。\n锦帐与画戟，稽古似不蒙。\n遗像今伟然，吾敬吏部公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 中秋和施司谏","author":"罗愿","text":"秋宇净如水，月镜不安台。\n郁孤高处张乐，语笑脱氛埃。\n檐外白毫千丈，坐上银河万斛，心境两佳哉。\n俯仰共清绝，底处著风雷。\n问天公，邀月姊，愧凡才。\n婆娑人世，羞见蓬鬓漾金罍。\n来岁公归何处，照耀彩衣簪橐，禁直且休催。\n一曲庾江上，千古继韶陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失调名","author":"罗愿","text":"九月江南秋色，黄雀雨，鲤鱼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云岩次朱晦庵韵","author":"罗禧","text":"陟彼中和山，无人不感仰。\n庭中檀麝盈，洞里珍珠满。\n两腋清风生，一腔春意爽。\n焚香祝圣回，袖带炉烟暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏宗统","author":"罗禧","text":"豫章谱系派流长，积德贻谋百世昌。\n子孝臣忠昭史册，人文士义著名邦。\n根源有自支流盛，辞赋无穷翰墨香。\n一阅此书一兴叹，令人千古仰馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏雪岩","author":"罗禧","text":"山回百折路难跻，远望楼台烟树迷。\n满地白云封洞口，一轮红日照天梯。\n龟蛇伏气时难老，鸾鹤归来夜倦飞。\n万壑千岩游不尽，且将词句壁头题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别母","author":"苗氏女","text":"桃花飞尽马塍春，此日辞家泪满巾。\n岂是比邻无嫁处，千山万水逐行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐孝子张常洧义台","author":"苗昌言","text":"义台屹立尚千秋，褒诏曾宣李邺侯。\n古碣不教苍藓蚀，高原惟见夕阳流。\n耕夫锄自将芝护，野客衣还伴鹤游。\n一样荒坟偏起敬，孝思耿耿至今留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅岭佛祠壁","author":"英州司寇女","text":"滇江今日掌刑回，上得梅山不见梅。\n辍俸买栽三十树，清香留与雪中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知宗生日","author":"王十朋","text":"天工未放二阳生，留得尧阶一荚蓂。\n庆诞仙源贵公子，祥开南极老人星。\n日垂宫线添无尽，貌比庄椿看更清。\n岁岁华堂祝眉寿，笙歌声里雪梅馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆山客邸题壁","author":"范万顷","text":"囊金遗失正茫然，逆旅仁心尽付还。\n从此弋阳添故事，不教阴德擅燕山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"范习父","text":"地收楚蜀西南水，天与江湖旦暮风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"右石老人","author":"范子长","text":"攲右堂空怒翼垂，清泉赴壑两鱼嬉。\n道人强欲安楼宇，闲却南边一半奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南亭","author":"范子长","text":"花木精神面面金，谁将好景作南亭。\n栗留枝上春风思，鶗鴂声中脱屐痕。\n檐后梅樊兄及弟，槛前竹鹤子生孙。\n我今犹是数旬客，遇意忻时即打门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满江红 寿东人","author":"范飞","text":"律转黄钟，尧蓂尚、零星一叶。\n人尽道、当年此日，诞生豪杰。\n我是君家门下士，三年屡献阳春雪。\n更此行、骑鹤上扬州，恩稠叠。\n君有子，文章伯。\n君有女，夸才色。\n更风流酝藉，东床佳客。\n婿祝长生儿祝寿，玉杯举罢金杯接。\n愿年年、长醉腊前梅，梅梢月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范中立","text":"我本云山窟里人，每怜雪岭照人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴田铺","author":"范云山","text":"曲坡行尽处，鸡犬两三家。\n十里长亭路，青山道正赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题梅山 其一","author":"范仁仲","text":"袖凛摧奸剑拂霜，奈何不报疏三章。\n南昌一尉孤忠日，西汉诸王百沸汤。\n便觅赤松为伴去，何求青史把名扬。\n想疑九转丹成后，愤吐精衷诉玉皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范元作","text":"山连巫峡几千里，水阔沅湘三四州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省谒观文之茔留题 其一","author":"范公","text":"先帝龙飞第一年，囊封夜半达甘泉。\n朝来急召明光殿，谠论能回不夜天。\n遐想神□今已远，永怀帝德浩无边。\n他时信史传遗事，悟主应□数百篇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春寄梅坛杨逸老","author":"范太中","text":"仕路蹉跎又见春，区区深厌走红尘。\n未能解脱无穷事，长忆逍遥自在人。\n瓦缶汲泉朝灌药，羽衣濛露夜朝真。\n洒然物外清虚境，呼吸淳元养气神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常庵题","author":"范心远","text":"路入清溪第二湾，东风犹自逗馀寒。\n白云粘地扫不去，黄叶恋枝吹未乾。\n沙上湿痕谁涉水，天边长啸独凭阑。\n道人酒意无醲薄，饮尽携琴月下弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云溪庵","author":"范心远","text":"云溪高隐卧烟霞，默饮阳晶与月华。\n雾敛丹台生瑞草，云收灵腑结琼葩。\n青龙吐火烹金茗，白虎跑泉溉玉芽。\n龙虎媾交功九转，刀圭一粒捧丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范令孙","text":"孤云不为雨，尽日却归山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"褒公亭","author":"范令闻","text":"唐变租庸调之后，皇朝列圣踵□馀。\n□科若使犹仍旧，人到于今□奠居。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六一堂","author":"范令闻","text":"□□□□法，□□□□□。\n□□□□□，□□□雪人。\n□□□□照，□□江汉炳。\n灵□□物□，生五色虎□。\n□山□长□，□□□□□。\n□简三□秩，满□中□□。\n然囊衣度云，栈□□□与。\n七贤□襁负，中□□金产。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"回龙院","author":"范令闻","text":"柏人去弗宿，万安退而止。\n见几惩贯高，噬脐嬖妃子。\n畏避虽同途，兴亡乃异轨。\n江边招提小，楼阁半倾圮。\n回薄二里馀，六龙驻于此。\n愁横云盖山，闷系罗带水。\n历历斜谷路，去天尺有咫。\n昨夜雨中铃，哀音犹在耳。\n画像赭衣袂，挟一弓两矢。\n侑以圣云孙，祖武略相似。\n剑外尘再蒙，黄明著年纪。\n今我吊陈迹，行迈亦靡靡。\n吹动波间皱，正值秋风起。\n安得如渔翁，垂钓江之涘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚公鹰","author":"范令闻","text":"与鹰写真惟楚公，与公作歌惟老杜。\n画托此歌以不朽，至今人诵抟空句。\n相传妙画旧通灵，乌鹊不敢巢庭树。\n饥未饱肉资远击，凛然戴角乃□顾。\n枯枝绝笔半已讹，飞鸟脱字无缘补。\n好事能来一赏音，不必移之在缣素。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与张焘太博行忻代间因话江山作","author":"范仲淹","text":"数年风土塞门行，说著江山意暂清。\n求取罢兵南国去，满楼苍翠是平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书扇示门人","author":"范仲淹","text":"一派青山景色幽，前人田地后人收。\n后人收得休欢喜，还有收人在后头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书酒家壁","author":"范仲淹","text":"当垆一曲竹枝歌，肠断江南奈尔何。\n游子未归春又老，夜来风雨落花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆杭州西湖","author":"范仲淹","text":"长忆西湖胜鉴湖，春波千顷绿如铺。\n吾皇不让明皇美，可赐疏狂贺老无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"范仲淹","text":"十口相将泛巨川，来时暖熟去凄然。\n关津若要知名姓，定是孤儿寡妇船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风水洞","author":"范仲淹","text":"神仙一去几千年，自遣秦人不得还。\n春尽桃花无处觅，空馀流水到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其四","author":"范仲淹","text":"分符江外去，人笑似骚人。\n不道鲈鱼美，还堪养病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其三","author":"范仲淹","text":"妻子屡牵衣，出门投祸机。\n宁知白日照，犹得虎符归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其八","author":"范仲淹","text":"素心爱云水，此日东南行。\n笑解尘缨处，沧浪无限清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其二","author":"范仲淹","text":"君恩泰山重，尔命鸿毛轻。\n一意惧千古，敢怀妻子荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其九","author":"范仲淹","text":"沧浪清可爱，白鸟鉴中飞。\n不信有京洛，风尘化客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其十","author":"范仲淹","text":"风尘日已远，郡枕子陵溪。\n始见神龟乐，优优尾在泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其一","author":"范仲淹","text":"陇上带经人，金门齿谏臣。\n雷霆日有犯，始可报君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其六","author":"范仲淹","text":"天阍变化地，所好必真龙。\n轲意正迂阔，悠然轻万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其七","author":"范仲淹","text":"万钟谁不慕，意气满堂金。\n必若枉此道，伤哉非素心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出守桐庐道中十绝 其五","author":"范仲淹","text":"有病甘长废，无机苦直言。\n江山藏拙好，何敢望天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石子涧二首 其二","author":"范仲淹","text":"飞泉落处满潭雷，一道苍然石壁开。\n故老相传应可信，此山云出雨须来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石子涧二首 其一","author":"范仲淹","text":"凿开奇胜翠微间，车骑笙歌暮未还。\n彦国才如谢安石，他时即此是东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其四","author":"范仲淹","text":"岭上英英向日开，帝乡情态自徘徊。\n如何一施阳春雨，依旧无心归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其三","author":"范仲淹","text":"铿铿千古峄山桐，金石声来造化中。\n谁道元和无复致，为君堂上起薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]