[{"title":"亚字谜","author":"陈亚","text":"若教有口便哑，且要无心为恶。\n中间全没肚肠，外面强生棱角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一 药名寄章得象陈情","author":"陈亚","text":"朝廷数擢贤，旋占凌霄路。\n自是郁陶人，险难无移处。\n也知没药疗饥寒，食薄何相误。\n大幅纸连粘，甘草归田赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其四 同上","author":"陈亚","text":"浪荡去未来，踯躅花频换。\n可惜石榴裙，兰麝香销半。\n琵琶闲抱理相思，必拨朱弦断。\n拟续断朱弦，待这冤家看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其三 同上","author":"陈亚","text":"小院雨馀凉，石竹风生砌。\n罢扇尽从容，半下纱厨睡。\n起来闲坐北亭中，滴尽真珠泪。\n为念婿辛勤，去折蟾宫桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二 药名闺情","author":"陈亚","text":"相思意已深，白纸书难足。\n字字苦参商，故要槟郎读。\n分明记得约当归，远至樱桃熟。\n何事菊花时，犹未回乡曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"陈亚","text":"如僧清早厨边过，偷却黄兴料里蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"陈亚","text":"无雨若还过半夏，和师晒作葫芦巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"陈亚","text":"马嘶曾到寺，犬吠乍行村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"陈亚","text":"吏辞如贺日，民送似迎时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"陈亚","text":"布袍袖里怀漫刺，到处迁延胡索人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"陈亚","text":"蔡襄无口便成衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"陈亚","text":"收寒归地底，表老向人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"陈亚","text":"浪平山接影，山尽树回根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"陈亚","text":"棋怕腊寒呵子下，衣嫌春暖缩纱裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈亚","text":"若是道人头不白，老人当日合乌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈蹇叔郎中出闽漕别送新茶李圣俞郎中出手分似","author":"杨万里","text":"头纲别样建溪春，小璧苍龙浪得名。\n细泻谷帘珠颗露，打成寒食杏花饧。\n鹧斑椀面云萦字，兔褐瓯心雪作泓。\n不待清风生两腋，清风先向舌端生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈仲微","text":"死为异国他乡鬼，生是江南直谏臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郭将军庙","author":"陈份","text":"天欲亡佗开汉境，将军英武契风云。\n远驱函谷三千骑，南下番禺十万军。\n自此河山消垒拒，至今民俗荷庸勋。\n后来扼腕征蛮者，禄重功轻不似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙脊","author":"陈似","text":"峡水渊流测益深，砥平鳌脊介江心。\n簿书丛里逢休假，云水光中欣访寻。\n拂石四题鸡子卜，舣舟三听竹枝音。\n时和挝鼓同民乐，快喜春阳逐众阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"陈充","text":"密叶高丛拥万枝，女仙成队绿云随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈充","text":"掩户闲欹枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱晦翁作","author":"陈光","text":"去年渭北望卿频，今日深山屐齿新。\n珠树香沾千涧雨，莲峰翠滴四时春。\n渔郎有意休相问，樵子无心可与亲。\n石榻盘旋忘岁月，瓶罍羞罄故人贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮桥","author":"陈兴","text":"千寻铁绾苍龙骨，七十舟横赤雁行。\n来往浑如履平地，渡头无复立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高季明玉溪晓步","author":"陈兴宗","text":"物外有佳趣，尘中劳苦形。\n芒鞋枝短藜，快哉得松扃。\n萝蔓猿狙悬，石磴苔藓青。\n龙出正为雨，碧潭如画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"砀山怀古","author":"陈刚","text":"山名芒砀势穹崇，汉祖严祠翠霭中。\n紫气应时腾碧落，素灵何处泣秋风。\n狐鸣陈涉孤坟坏，金尽梁王石室空。\n毕竟乾坤归有道，漫誇扛鼎力英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阳关词","author":"陈刚中","text":"客舍休悲柳色新，东西南北一般春。\n若知四海皆兄弟，何处相逢非故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石材庙题柱","author":"陈刚中","text":"疏爵新刚应，论功旧石材。\n能形文母梦，还讶佞人来。\n海市为谁出，衡云岂自开。\n乞灵如见告，逐客几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视涝","author":"陈刚中","text":"暨阳古泽中，今岁仍大水。\n舟行民田中，一浪四十里。\n农夫相对泣，父子饥欲死。\n酷吏亦何心，诛求殊未已。\n岂繄竭膏血，直欲剥肤髓。\n哀此无告民，有生皆赤子。\n天灾自流行，助虐亦何理。\n我愧才术疏，陆陆佐小垒。\n熟视不能救，有泪空如洒。\n皇心念下民，恻怛形诏旨。\n丁宁既谆复，象魏几黄纸。\n要须尽蠲除，仰称德意美。\n人微言或弃，归休从此始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龟峰词后","author":"陈合","text":"西晋风流自一家，忆君魂梦到梅花。\n梅花深处无人迹，明月一枝霜外斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝鼎现 寿贾师宪","author":"陈合","text":"神鳌谁断，几千年再，乾坤初造。\n算当日、枰棋如许，争一著、吾其衽左。\n谈笑顷、又十年生聚，处处豳风葵枣。\n江如镜，楚氛馀几，猛听甘泉捷报。\n天衣细意从头补。\n烂山龙、华虫黼藻。\n宫漏永、千门鱼钥，截断红尘飞不到。\n街九轨，看千貂避路，庭院五侯深锁。\n好一部、太平六典，一一周公手做。\n赤舄绣裳，消得道、斑斓衣好。\n尽庞眉鹤发，天上千秋难老。\n甲子平头才一过，未说汾阳考。\n看金盘，露滴瑶池，龙尾放班回早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓色","author":"陈在山","text":"荒鸡递寒鸣，寥廓弄清曙。\n初阳未离海，薄云尚笼树。\n沙明宿鹭惊，巷白行人语。\n瓦瓶自持汲，正在月落处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和太师平章魏国贾公遗潜侍郎之作","author":"陈存","text":"先腊催开万玉林，人心悦处即天心。\n山河洞彻重瞳远，宫阙高寒一柱任。\n瑞应崆峒知有日，尘清洄曲在斯今。\n神功变化无留迹，便放阳春捲积阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵良淳三首 其三","author":"陈存","text":"慷慨君酬国，奔逃我丧家。\n陆沈同一壑，渊涉眇无涯。\n祈死惟嫌晚，馀生只自嗟。\n蒿莱连雉堞，落日噪栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵良淳三首 其二","author":"陈存","text":"忠定扶神鼎，安邦不顾身。\n曾孙能致命，属籍岂无人。\n归骨番江上，招魂霅水滨。\n死生均此念，老病泣遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵良淳三首 其一","author":"陈存","text":"日惨天无色，城危岁迫除。\n孤忠元自许，一死不知馀。\n束衽全遗体，呼儿受诀书。\n登陴才信宿，肠断正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈存","text":"云连京国深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三城侍郎寄示留题延庆寺二韵诗二章顷岁予肄业于此遗景尽在幸会之迹首唱之序详矣谨依命攀和但于首章增为四韵盖浅陋之才不觉辞费因遣稚子赞善大夫通判邠州事学古写于此牌以永嘉赐 其二","author":"陈尧佐","text":"萤窗从此极研覃，坠简疑文访济南。\n拟卜菟裘邻学所，龙香时爇御书龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天圣间入参大政复寄题二章 其二","author":"陈尧佐","text":"山好曾留句，城高复创亭。\n登临千万境，谁与画为屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天圣间入参大政复寄题二章 其一","author":"陈尧佐","text":"罗浮山下郡，楼阁枕沧溟。\n谁得闲中意，清风野吏亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆越州 其二","author":"陈尧佐","text":"稽峰倚云千仞高，澄湖倒影分秋毫。\n当年逸赏有馀意，徘徊不忍移轻舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆越州 其一","author":"陈尧佐","text":"越绝溪山第一州，画图城郭几淹留。\n閒思禹庙斜回首，髣髴云端见郡楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆潮阳","author":"陈尧佐","text":"东西楼阁与云齐，天际孤烟认恶溪。\n记得幽人旧吟处，独游亭在野桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江潮阻风","author":"陈尧佐","text":"按部溪山接海涛，连天风雨泊轻舠。\n沧溟未必全胜我，潮落潮生亦自劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀杭州西湖","author":"陈尧佐","text":"桥影飞虹跨碧潭，熙熙亭畔柳毵毵。\n扁舟载酒渔翁唱，记得闲过处士庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"国清寺","author":"陈尧佐","text":"南越第一寺，偶来心地真。\n却嫌桥下水，流去入红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘 其二","author":"陈尧佐","text":"人间灵迹遍曾游，祇欠吴门访虎丘。\n今日偶来无限感，阖闾坟左剑池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘 其一","author":"陈尧佐","text":"云际楼台树杪轩，孤松千尺耸平田。\n危栏远思微吟好，隐隐秋帆半入天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈尧佐","text":"雨网蛛丝断，风枝鸟梦摇。\n诗家零落景，采拾合如樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郑州浮波亭　","author":"陈尧佐","text":"碧玉波光四面寒，虚空檐宇出林端。\n尘埃未到交游绝，绕座扁舟与钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄宫 其二","author":"陈尧佐","text":"谷口停骖上翠微，五云宫殿辟金扉。\n不知何处朝元会，却见龙鸾队仗归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄宫 其一","author":"陈尧佐","text":"一帆高挂出红尘，万仞长歌入紫云。\n莫道游仙别无侣，玉清冠盖许同群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄宫 其三","author":"陈尧佐","text":"二天封部稼如云，流水清寒出洞门。\n更爱林间盘石上，松花飘落羽人樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴潮阳倅 其一","author":"陈尧佐","text":"沉醉犹难别帝州，满城春色重淹留。\n公闲预想消魂处，望阙频登海上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴潮阳倅 其二","author":"陈尧佐","text":"休把空言较短长，算来齐物也无妨。\n蛮民解唱升平曲，愿领闲愁入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王生及第归潮阳","author":"陈尧佐","text":"休嗟城邑住天荒，已是仙枝耀故乡。\n从此方舆载人物，海边邹鲁是潮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题漳浦县斋","author":"陈尧佐","text":"漳浦从来瘴疠深，潮阳南去更难禁。\n当时三载曾无事，不放闲愁入寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望越亭","author":"陈尧佐","text":"飒飒西风叶叶秋，谁家烟火起沧洲。\n乘闲不耐无机性，拟劝渔翁直钓钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖州碧澜堂","author":"陈尧佐","text":"苕溪清浅霅溪斜，碧玉光寒照万家。\n谁向月明终夜听，洞庭渔笛隔芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答张顺之","author":"陈尧佐","text":"有花无酒头慵举，有酒无花眼倦开。\n正向西窗念萧索，洛阳花酒一时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮阳作 其二","author":"陈尧佐","text":"静院莺啼竹，幽阑蝶在花。\n登临转惆怅，斜日两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潮阳作 其一","author":"陈尧佐","text":"景淡花初落，寒生海上潮。\n门前归北路，微雨柳垂条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题上虞兰芎山","author":"陈尧佐","text":"岩岩一峰千万寻，微茫楼阁寒云深。\n巡州佐吏倚栏久，泠泠天籁清尘心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华清宫","author":"陈尧佐","text":"百首新诗百意精，不尤妃子只尤兵。\n争如一句伤时事，只为明皇恃太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题朝元阁","author":"陈尧佐","text":"朝元高阁迥，秋毫无隐情。\n浮云忽以蔽，不见渔阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题漳浦县壁","author":"陈尧佐","text":"蛮烟渔火接鲸波，树树花枝处处歌。\n况是天涯好行乐，莫教憔悴鬓霜多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三城侍郎寄示留题延庆寺二韵诗二章顷岁予肄业于此遗景尽在幸会之迹首唱之序详矣谨依命攀和但于首章增为四韵盖浅陋之才不觉辞费因遣稚子赞善大夫通判邠州事学古写于此牌以永嘉赐 其一","author":"陈尧佐","text":"清济园林接寺隅，水昏烟暝自成图。\n当年棣鄂三冬学，今日鸰原万里途。\n道契风云多感激，人非丰沛欠吁谟。\n闻君又枉行春骑，应笑溪边旧截蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归阙感怀","author":"陈尧佐","text":"望阙二年馀，中宵梦玉除。\n忽闻天上诏，乍厌海边居。\n归路寻芳草，空囊载旧书。\n君恩何以报，零泪落尘裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知果教寺","author":"陈尧佐","text":"萝岩山下寺，静境绝过从。\n芳草二三月，碧云千万峰。\n窗虚明落日，楼迥响疏钟。\n恰恐重来晚，庭前记偃松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄书上人","author":"陈尧佐","text":"阶前春色长苔斑，避俗常闻昼掩关。\n一榻琴书双阙寺，片心泉石二林山。\n江楼把酒云供望，松院支筇鹤对闲。\n谁向风骚为消息，此身元在寂寥间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄洪州杨太博","author":"陈尧佐","text":"南昌为郡好，楼阁枕江湄。\n地暖春生早，山寒日下迟。\n讼庭唯鹤立，吟树独僧期。\n安得通官政，烟霞共一司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游凤栖寺","author":"陈尧佐","text":"十里水烟迷，禅居偶杖藜。\n地灵人不老，山好凤曾栖。\n暑气消将尽，苔痕长欲齐。\n松间何所得，泉石两三题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游惠阳西湖","author":"陈尧佐","text":"附郭水连山，公馀独往还。\n疏烟鱼艇远，斜日寺楼闲。\n系马芭蕉外，移舟菡萏间。\n天涯逢此景，谁信自开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游湖上昭庆寺","author":"陈尧佐","text":"湖边山影里，静景与僧分。\n一榻坐临水，片心闲对云。\n树寒时落叶，鸥散忽成群。\n莫问红尘事，林间肯暂闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林处士水亭","author":"陈尧佐","text":"城外逋翁宅，开亭野水寒。\n冷光浮荇叶，静影浸鱼竿。\n吠犬时迎客，饥禽忽上阑。\n疏篱僧舍近，嘉树鹤庭宽。\n拂砌烟丝袅，侵窗笋戟攒。\n小桥横落日，幽径转层峦。\n好景吟何极，清欢尽亦难。\n怜君留我意，重叠取琴弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]