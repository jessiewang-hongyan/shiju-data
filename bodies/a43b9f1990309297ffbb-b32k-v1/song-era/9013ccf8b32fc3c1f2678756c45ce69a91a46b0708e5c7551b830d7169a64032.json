[{"title":"玉渊亭","author":"张孝祥","text":"夜投宝觉寺，径上玉渊亭。\n峡束千崖水，天分一段星。\n神光行熠耀，空翠矗青冥。\n雄观兼幽趣，悠然寄独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"简寂观","author":"张孝祥","text":"瀑水流红叶，荒祠琐翠微。\n紫霄人不到，白鹤事全非。\n苦笋今年少，黄冠竟日饥。\n摩挲石龙柱，伫立为歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇甫坦所居","author":"张孝祥","text":"石侧疑无路，峰回别有天。\n神泉通玉海，帝画丽奎躔。\n紫闼虽重到，青瑶却未镌。\n直须香案吏，为写白云篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出郊","author":"张孝祥","text":"楚雾侵衣润，湘江到眼明。\n春连岳麓寺，花满定王城。\n佳客真如此，天公却不晴。\n空濛殊可意，沙湿马蹄轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬朱元晦登定王台之作","author":"张孝祥","text":"海内朱公子，端能为我来。\n谭谐渺今古，欢喜到舆台。\n日月何曾蔽，风云会有开。\n登临一杯酒，莫作楚囚哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴伯承生孙交游共为之喜凡七人分韵我亦从来识英物试教啼看定何如某得啼定字 其一","author":"张孝祥","text":"得孙当赞喜，唤客便分题。\n楼鼓方行夜，天星恰照奎。\n熊罴通梦寐，孔释自提携。\n汤饼那应晚，吾来为止啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴伯承生孙交游共为之喜凡七人分韵我亦从来识英物试教啼看定何如某得啼定字 其二","author":"张孝祥","text":"吴郎薄轩冕，市隐室垂罄。\n儿孙忽成行，乘除乃天定。\n我女才三岁，此事当退听。\n剩欲便款门，积雨道苦泞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠王茂升","author":"张孝祥","text":"荐士移书早，论交识面迟。\n宽行十里路，细读百篇诗。\n句法能如此，胸中定自奇。\n不嫌知己少，莫厌此官卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日郊居","author":"张孝祥","text":"秋日郊扉乐，心闲景趣闲。\n风生疏竹里，雨在片云间。\n疏港聊通水，关门不碍山。\n残书读未尽，飞鸟暮云还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋书事","author":"张孝祥","text":"江月清光冷，波亭夜色奇。\n流萤翻露草，倦鹊绕风枝。\n素魄不长满，故人频语离。\n有怀千里恨，若为一杯辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"请说归休好 其一","author":"张孝祥","text":"请说归休好，扶行白发亲。\n访医无远近，买药辨新陈。\n索酒兼邻瓮，要宾尽里人。\n短长无不可，且得是闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"请说归休好 其二","author":"张孝祥","text":"请说归休好，从今自在闲。\n新除叠黄纸，旧隐接青山。\n竹绕披风榭，芦藏钓月湾。\n田间四时景，何处不开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜归作","author":"张孝祥","text":"月地参差影，风檐取次花。\n酒为春主掌，贫是老生涯。\n湖海扁舟去，江淮到处家。\n扶持两仙伯，丹鼎绚彤霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故年家姚公挽章","author":"张孝祥","text":"世德方隆报，君恩未及封。\n起家惟子好，弗寿竟谁钟。\n无复时中圣，遥怜不相舂。\n只鸡吾阻往，抆泪睇乔松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"殿庐偶成","author":"张孝祥","text":"帘幕垂垂燕子风，宫花春尽翠阴浓。\n日长禁直文书静，宝爇时时一拆封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘国正觅雌黄 其一","author":"张孝祥","text":"刘郎家具少于车，只有诗囊未厌渠。\n乞与丹铅将底用，点勘腹中行秘书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘国正觅雌黄 其二","author":"张孝祥","text":"蛮笺攲斜落杰句，清似秋月横蛾眉。\n口中雌黄盖天下，聊欲教我烦新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅","author":"张孝祥","text":"满面宫妆淡淡黄，绛纱封蜡贮幽香。\n遥怜未识春消息，乞与一枝教断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵左举善木樨","author":"张孝祥","text":"想见秋花插满头，遥怜不负此山游。\n一枝并与诗筒馈，气压西湖万斛秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以茶芽焦坑送周德友德友来索赐茶仆无之也 其二","author":"张孝祥","text":"仇池诗中识焦坑，风味官焙可抗行。\n钻馀权倖亦及我，十辈走前公试烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蕲春道中","author":"张孝祥","text":"霜净波平水落湾，我行正在画图间。\n帘钩不用怕风日，且看江南江北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其一","author":"张孝祥","text":"说河不救痴儿渴，砥柱乃障颓波流。\n庾公楼中三昧手，何时归侍殿西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其二","author":"张孝祥","text":"霜馀江北山如画，岁晚家乡稻作京。\n万里公方黄鹄举，扁舟我自白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其三","author":"张孝祥","text":"今朝放缆好天色，过午忽作打头风。\n却望江州才十里，我船且系芦花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其四","author":"张孝祥","text":"庐山突兀上霄汉，使君豪气与相酬。\n庐山虽好不足恋，归矣当为苍生谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其五","author":"张孝祥","text":"连城鼠璞不足唾，千金敝帚谁能酬。\n只今机会不容发，愿借前箸君当谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其六","author":"张孝祥","text":"谷帘酿酒极清美，风味大似主人翁。\n我有一尊正倾写，却思烟雨庾楼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其七","author":"张孝祥","text":"何人列屋闭婵娟，忆对清歌重慨然。\n一笑相怜穷相眼，谩撩诗思入愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次江州王知府叔坚韵 其八","author":"张孝祥","text":"经行有恨是阴雨，不见香炉生紫烟。\n安得草堂容一榻，听松听水日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道间见梅","author":"张孝祥","text":"寒女生来不解妆，天然玉色照孤芳。\n疏篱茅舍无端恨，故有幽人与断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题定山寺 其一","author":"张孝祥","text":"蹇驴夜入定山寺，古屋贮月松风清。\n止闻挂塔一铃语，不见撞钟千指迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题定山寺 其二","author":"张孝祥","text":"千山苍茫月东出，万木摆摇风怒号。\n幽人隐几抚群动，清灯明灭炉烟高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭亭食柑","author":"张孝祥","text":"一双分我洞庭秋，梨枣傍观不那羞。\n唤得风霜回齿颊，夜寻清梦五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其一","author":"张孝祥","text":"厌听诸方三昧禅，却思夜雨对床眠。\n欲知千偈如翻水，看取朝来绿涨川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其二","author":"张孝祥","text":"不谈世法不谈禅，彻晓齁齁一觉眠。\n个里神通元不小，回风急雨震山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其三","author":"张孝祥","text":"朝供炉香夜供灯，闲来落得困瞢腾。\n如庵许我参堂去，长作昭亭粥饭僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其四","author":"张孝祥","text":"一灯分作百千灯，光遍河沙正郁腾。\n稽首应庵休拣择，直须传与在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其五","author":"张孝祥","text":"道人受偈自然灯，笔底光芒夜夜腾。\n诗成十手不供写，凿齿敢对弥天僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和如庵 其六","author":"张孝祥","text":"飞蛾扑扑误占灯，火色何人要上腾。\n我已澹然忘世味，蒲团纸帐只依僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枫桥","author":"张孝祥","text":"四年忽忽两经过，古岸依然窣堵波。\n借我绳床消午暑，乱蝉鸣处竹阴多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题西湖可赋轩","author":"张孝祥","text":"风光猎猎上乌巾，不那西湖烂熳春。\n借我绳床对脩竹，为君一洗软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题胡敦约山行图","author":"张孝祥","text":"松行石磴两崎岖，此去长安路更迂。\n底个官侬强健在，葛巾芒屩自骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从张唐卿乞韭黄","author":"张孝祥","text":"雪压畦蔬僮手皲，度郎多日欠常珍。\n悬知旅食初无恙，窖里黄芽借得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送纸衾韩中父 其一","author":"张孝祥","text":"韩郎香尽诸缘绝，坏衲篝灯供佛熏。\n乞与纸衾绵样暖，撩教醉里梦纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送纸衾韩中父 其二","author":"张孝祥","text":"了知梦境皆虚妄，妄念常从梦处开。\n败子道心因此梦，梦成还我纸衾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵 其一","author":"张孝祥","text":"雪中纸衾有奇趣，煖香夜作椒兰熏。\n毗耶丈室本无病，天女为散花纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵 其二","author":"张孝祥","text":"雪花如席风色恶，拥被围炉门不开。\n我亦穷阎车马绝，一杯相属望君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将至宣城和壁间韵寄王宣子","author":"张孝祥","text":"一笑归来见在身，倒倾江水洗缁尘。\n骑驴缓缓东风里，知有工夫展故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄当涂王守叔坚","author":"张孝祥","text":"隔江灯火夜深明，见说江城犬不惊。\n黠虏头颅当献社，使君胸次有长城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐静觅杉株","author":"张孝祥","text":"旧闻隐静庭前柏，虎啸龙吟三十秋。\n我亦经营一丘壑，无根树子却须求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题夏氏庄","author":"张孝祥","text":"平湖漠漠雨霏霏，压水人家燕子飞。\n欲向湖东问春色，杏花无数点征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中即事","author":"张孝祥","text":"夜行水涩舟难进，月白林稀鸟易惊。\n老去不堪霜露力，尊中微觉似多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小憩孙氏竹轩观诸公诗 其一","author":"张孝祥","text":"开轩种竹仍留客，想见此翁强健时。\n借我绳床小盘薄，为君试读壁间诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小憩孙氏竹轩观诸公诗 其二","author":"张孝祥","text":"种竹主人今白发，题诗客子半青云。\n北来南去何时了，风月依然只此君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王龟龄遣妓送酒赐诗走笔为谢","author":"张孝祥","text":"不复襄王梦里云，纷纷缟袂与青裙。\n鸣鞭枉送斋中酿，病彻杯觞欠薄醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与荐福","author":"张孝祥","text":"湖上童童百亩阴，丹楼碧阁照清深。\n不嫌歌板相喧聒，要见桃花印此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丰城观音院有胡明仲范伯达汪彦章诸公题字","author":"张孝祥","text":"中兴人物数诸公，遗墨凄然野寺中。\n欲访英灵无处所，独搔蓬鬓立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入桂林歇滑石驿题碧玉泉","author":"张孝祥","text":"百折崎岖岭路头，一环清駃石间流。\n须君净洗南来眼，此去山川胜北州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明年重过次韵六言","author":"张孝祥","text":"世事风经两过，此身遇坎乘流。\n折腰不为五斗，辙环或遍九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其一","author":"张孝祥","text":"登临不但为山水，玉节政尔观民风。\n因君引我看胜处，诗在千山烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其二","author":"张孝祥","text":"平生烟霞成痼疾，置在朝市殊不宜。\n梦寻归路向何许，淮南小山生桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其三","author":"张孝祥","text":"先生名字帝所识，三节在道已相望。\n早晚鸣珂朝玉阙，朱衣正在殿中央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其四","author":"张孝祥","text":"便建油幢上木天，棠阴元不用蒲鞭。\n南州小试调元手，国步多难政要贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其五","author":"张孝祥","text":"绿蓑青笠舟一叶，黄麻紫诰言如纶。\n君扶日月行黄道，我向江湖作散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其六","author":"张孝祥","text":"盆池虽小亦清深，要看澄泓印此心。\n不嫌蛙黾相喧聒，夜静恐有蛟龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和都运判院韵辄记即事 其七","author":"张孝祥","text":"君诗我续貂不足，曹郐大楚非匹俦。\n要知二人唱必和，异日盛事传中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敬谢经略秘阁馀甘汤 其一","author":"张孝祥","text":"甘言误我三折臂，良药为洗五斗肠。\n欲知苦过味方永，请试君家肘后方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"敬谢经略秘阁馀甘汤 其二","author":"张孝祥","text":"此老才堪上谏坡，南州留滞意如何。\n还将苦口劘英主，医国悬知药笼多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德庆范监州以子石砚宠假虽小而奇戏作 其一","author":"张孝祥","text":"曾侍虚皇玉案前，夜书茧纸笔如椽。\n莫嫌此石规模小，一寸玄云万斛泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德庆范监州以子石砚宠假虽小而奇戏作 其二","author":"张孝祥","text":"端溪别驾极风流，白璧明珠不暗投。\n笑我支床已多许，须君隐几更冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以水仙花供都运判院 其一","author":"张孝祥","text":"十月西湖冰齿凉，梅间松下小齐房。\n幽芳靓色天为笑，落莫南来也自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以水仙花供都运判院 其二","author":"张孝祥","text":"瘴土风烟那有此，却疑姑射是前身。\n冰肌玉骨谁消得，付与霜台衣绣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其一","author":"张孝祥","text":"雪屋因君发妙思，作歌可比汉芝房。\n根尘巳證清净慧，鼻观仍薰知见香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和 其二","author":"张孝祥","text":"玉壶寒露映真色，雾阁云窗立半身。\n可但凌波学仙子，绝怜空谷有佳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和仲钦题粉岩","author":"张孝祥","text":"一麾縻我欠追从，怅望千山紫翠重。\n忽向邮筒得新句，知君正在碧莲峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲钦寄民为重斋诗和答 其一","author":"张孝祥","text":"斋中寒日影珑葱，斋外参天十八公。\n二十四州民乐否，莫教一物怨途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]