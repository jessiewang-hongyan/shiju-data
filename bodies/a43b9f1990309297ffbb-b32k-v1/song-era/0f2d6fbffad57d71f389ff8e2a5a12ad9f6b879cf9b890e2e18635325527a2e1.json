[{"title":"宋相国公挽辞二首 其二","author":"司马光","text":"邦光华衮襚，家宝素书陈。\n东阁簪裾散，西芒宅兆新。\n泉台无复晓，柏径不知春。\n独有高文在，芬芳继古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋相国公挽辞二首 其一","author":"司马光","text":"仁圣初承绪，敷天吁隽贤。\n得人兹最盛，射策独居先。\n禁省英声远，岩廊至化宣。\n辞荣还故第，三事究高年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张元常挽歌二首 其二","author":"司马光","text":"秀眉无足验，结轖遽为灾。\n乡曲三年别，江山万里回。\n林闾飞旐入，书剑逐舟来。\n坟草枯还绿，重泉不复开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张元常挽歌二首 其一","author":"司马光","text":"为吏文无害，临民政不苛。\n浑金生自美，古井澹无波。\n方喜风鹏举，旋闻隙驷过。\n善人宜寿考，报施定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李花","author":"司马光","text":"嘉李繁相倚，园林淡泊春。\n齐纨剪衣薄，吴纻下机新。\n色与晴光乱，香和露气匀。\n望中皆玉树，环堵不为贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏解嘲","author":"司马光","text":"造物本非我，荣枯那足言。\n但馀良干在，何必艳花繁。\n壮丽华林苑，欢娱梓泽园。\n芳菲如可采，岂得侍君轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沉阴欲雪与同列会饮南斋","author":"司马光","text":"簿领日沈迷，从容乐事稀。\n宾朋幸相值，樽酒不须违。\n惨澹愁云积，参差远树微。\n淹留勿轻散，待取雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花庵多牵牛清晨始开日出已瘁花虽甚美而不堪留赏","author":"司马光","text":"望远云凝岫，妆馀黛散钿。\n缥囊承晓露，翠盖拂秋烟。\n响慕非葵比，彫零在槿先。\n才供少顷玩，空废日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花庵独坐","author":"司马光","text":"荒园才一亩，意足已为多。\n虽不居丘壑，常如隐薜萝。\n忘机林鸟下，极目塞鸿过。\n为问市朝客，红尘深几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏才翁子美有赠扶沟白鹤观黄道士诗纪于屋壁岁久漫灭今县宰周同年得完本于民间抵予求诗","author":"司马光","text":"潦倒黄冠无足论，白头嗜酒住荒村。\n狂名偶为留诗著，陈迹仍因好事存。\n金石锵洋虚殿寂，龙蛇洒落古墙昏。\n飞黄灭没浮云外，疲马何能望骏奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运使虞部按行洛西诸县因游所过名山有诗百馀首合为一编蒙赐宠示俾之继作一首","author":"司马光","text":"属城穷僻地，揽辔遍周流。\n弊政已更化，名山不废游。\n鸣驺留谷口，轻屐历岩幽。\n聚看官仪者，相扶半白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还陈殿丞原人论","author":"司马光","text":"品物芸芸游太虚，不知谁氏宰洪炉。\n一株花落分荣辱，万窍风号见有无。\n觉后共占犹是梦，衣中所得亦非珠。\n何如鼓瑟浴沂水，春服成时咏舞雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还张景昱景昌秀才兄弟诗卷","author":"司马光","text":"韡韡新诗卷，青春映棣华。\n机云今继美，载协旧承家。\n幸托仁人里，时回长者车。\n白虹光乱眼，何敢议瑜瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵尧夫先生哀辞二首 其二","author":"司马光","text":"慕德闻风久，论交倾盖新。\n何须半面旧，不待一言亲。\n讲道切磋直，忘怀笑语真。\n重言蒙蹠实，佩服敢书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵尧夫先生哀辞二首 其一","author":"司马光","text":"菽藿一箪乐，蒿莱三亩宽。\n蒲轮不能起，瓮牖有馀安。\n高节去圭角，久要敦岁寒。\n今朝郊外客，谁免涕汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰正月十五日夜监直对月怀诸同舍 其二","author":"司马光","text":"澹薄春云散，低昂北斗横。\n微分汉津雁，静识建章更。\n浊酒怜虚爵，高文忆友生。\n前轩空不掩，怅息负孤清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲中有富贵","author":"司马光","text":"闲中有富贵，迥与俗尘殊。\n水净齐纨展，花繁蜀锦纡。\n竹风寒扣玉，荷雨急跳珠。\n可笑公孙衍，酣歌誇丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲来","author":"司马光","text":"闲来观万物，在处可逍遥。\n鱼为贪钩得，蛾因赴火焦。\n碧梧饥鸑鷟，白粒饱鹪鹩。\n带索谁家子，行歌复采樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居呈复古","author":"司马光","text":"闲居虽懒放，未得便无营。\n伐木添山色，穿渠擘水声。\n经霜收芋美，带雨接花成。\n前日邻翁至，柴门扫叶迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依前韵奉送才元和甫使北","author":"司马光","text":"析木带天津，华星随去人。\n扬旌踰绝漠，负弩候前尘。\n出塞风霜苦，归涂杨柳春。\n会书专对美，烨烨满秋筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和仲庶省壁画山水","author":"司马光","text":"画工执笔已心游，稍稍蘅皋引杜洲。\n堆案烦文犹倦暑，满轩新意忽惊秋。\n天生贤者非无谓，官遇明时未易休。\n正恐怒飞朝暮事，丹青难得久淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"其夕宿独乐园诘朝将归赋诗","author":"司马光","text":"平晓何人汲井华，辘轳声急散春鸦。\n开园更有四五日，映叶尚馀三两花。\n宿病岑岑犹带酒，无眠耿耿不禁茶。\n自嫌行乐妨年少，遽索蓝舆且向家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到任明年旨罢官有作","author":"司马光","text":"恬然如一梦，分竹守长安。\n去日冰犹壮，归时花未阑。\n风光经目少，惠爱及民难。\n可惜终南色，临行子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到并州已复数月率尔成诗","author":"司马光","text":"忽忽此何地，经时更自猜。\n深疑醉里得，复似梦中来。\n薄宦真何益，浮生信可咍。\n鹏蜩定有分，不若寸心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子华应天院行香归过洛川","author":"司马光","text":"印节传呼洛北还，府庭无讼不妨闲。\n度桥寒色侵春服，按辔晴光露晓山。\n香穗徘徊凝广殿，花篮繁会满通阛。\n自知白雪高难和，忍愧谁能寄我颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子华招潞公暑饮","author":"司马光","text":"朱门近在府园东，杖屦过从跬步中。\n避暑连翩投辖宴，析酲萧洒满襟风。\n闲来高韵浑如鹤，醉里朱颜却变童。\n剪烛添香欢未极，但惊铜漏太匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子骏约游一二园亭看花遇雨而止","author":"司马光","text":"行乐及佳时，官闲无所羁。\n只知花正发，不共雨为期。\n浅草碧无际，浓云冷四垂。\n陪游兴未尽，安得不相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子骏洛中书事","author":"司马光","text":"西都自古繁华地，冠盖优游萃五方。\n比户清风人种竹，满川浓绿土宜桑。\n凿龙山断开天阙，导洛波回载羽觞。\n况有耆英诗酒乐，问君何处不如唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子骏新荷","author":"司马光","text":"懒不窥园久，元非效仲舒。\n新荷满沼密，蓝舁出门疏。\n借问含烟晚，能胜裛露初。\n愧无鱼戏句，弄翰白纷如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子渊元夕","author":"司马光","text":"神岳嶕峣阙角齐，银蟾无影玉绳低。\n风传丝管交加发，灯滉星河上下迷。\n清醴横飞金凿落，香尘不染锦障泥。\n谁知此夕斋祠客，近在宫城槐柳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子渊除夜","author":"司马光","text":"缇室重飞玉琯灰，物华全与斗杓回。\n依依残腊无情别，历历新春满眼来。\n强取酒卮浮翠柏，懒开粽叶觅杨梅。\n男儿努力平生志，肯使功名落草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和公廙喜雪","author":"司马光","text":"向来河洛久愆阳，祷祀徒劳罄肃庄。\n林雪飞花欣暂白，麦田濡叶未全黄。\n城中稍觉桑薪贵，村外时闻社瓮香。\n八使孜孜悯茕独，斯民那复畏凶荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王少卿十日与留台国子监崇福宫诸官赴王尹赏菊之会","author":"司马光","text":"儒衣武弁聚华轩，尽是西都冷落官。\n莫叹黄花过佳节，且将素发共清欢。\n红牙板急弦声咽，白玉舟横酒量宽。\n青眼主公情不薄，一如省闼要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王安之题独乐园","author":"司马光","text":"草浓初过雨，林静远含烟。\n燕引新飞鷇，荷承半坠莲。\n朋来惟有月，山见不须钱。\n谁与同其乐，壶中浊酒贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乐道再以诗见寄","author":"司马光","text":"谏垣簪笔接英游，今日华颠昔日忧。\n邂逅升沈皆是命，逍遥出处本无愁。\n衡门不羡金门贵，藿食焉知肉食谋。\n溟海榆枋各安分，蓬莱未必胜嵩丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和乐道自河外南辕过宜芳雨晴和气景物可爱马上偶成","author":"司马光","text":"京洛春应老，河边初解颜。\n碧浮烟际草，翠滴雨馀山。\n目极褰帷外，诗成揽辔间。\n满川桃李色，共喜传车还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和史诚之谢送张明叔梅台三种梅花","author":"司马光","text":"别后相惊两鬓霜，可怜梅蕊为谁芳。\n台头日暖分三色，林下风清共一香。\n正烂漫时游不足，忽离披去乐难常。\n慇勤手折遥相赠，不欲花前独举觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和白都官见赠","author":"司马光","text":"齿疏鬓白两眸昏，万事无堪老病身。\n脱粟犹沾太仓禄，法官仍忝外台臣。\n直缘迂僻求闲地，岂是孤高慕古人。\n英俊满朝皆稷契，太山何少一飞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和冲卿喜雨偶成","author":"司马光","text":"万里风随快雨来，尘昏消伏旱光开。\n物情濯热参差喜，天意为仁容易回。\n帘映薄寒灯有晕，窗含虚白麝成煤。\n君侯雅有江湖兴，萧洒何须气象催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘伯寿陪潞公禊饮","author":"司马光","text":"旌幢车骑满沙头，鼓吹喧繁画鹢浮。\n十里罗纨光照地，千家帘幕远临流。\n觞随洛水周公事，月映凤楼裴相游。\n令典久堕今更举，行闻美俗遍中州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和同舍对菊无酒","author":"司马光","text":"黄花倚秋色，晔晔为谁开。\n更使窥残榼，空令洗旧杯。\n嗅香行缭绕，撚蕊立徘徊。\n尽日柴门外，白衣来不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宇文公南涂中见寄","author":"司马光","text":"骢马乌纱游洛尘，未能全得自由身。\n深惭白首恋微禄，不向青山为散人。\n斥鴳卑飞聊取适，冥鸿高举益难亲。\n蜀都迢递千馀里，徒诵新诗妙入神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和安之久雨","author":"司马光","text":"秋霖逢甲子，禾耳恐须生。\n流俗幸无验，高田犹有成。\n润唯藜莠得，烂与蕙兰并。\n早晚浮云豁，逍遥赋晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尧夫见寄 其二","author":"司马光","text":"仁政如慈父，蒲人得所依。\n教条前后接，风迹古今稀。\n试郡才书最，还朝必奋飞。\n西台旧班列，犹望绣衣归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尧夫见寄 其一","author":"司马光","text":"志趣苦难合，伥伥何所依。\n逢君始相照，知我信为稀。\n忽报除书下，徒瞻征盖飞。\n相思千里远，洛浦又春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尧夫首尾吟","author":"司马光","text":"尧夫非是爱吟诗，安乐窝中无所为。\n古道白头无外用，今时青眼几人知。\n嵩山洛水长相见，秋月春风不失期。\n筋力虽衰才思壮，递年比较未尝亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和次道大庆殿上元迎驾","author":"司马光","text":"凤律年华到尚新，九重气象已成春。\n晓云低拂羽林仗，宿雨先清紫陌尘。\n玉殿鸣鞘传警跸，彤庭委佩集簪绅。\n阙前无复鱼龙戏，自有驩谣亿万人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宋次道西都元日怀不疑并见寄","author":"司马光","text":"露冕优分竹，题舆佐画圻。\n比年携手乐，兹日赏心违。\n斋祀春来并，娱游别后稀。\n谁怜从窭卒，草际犯寒归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邠守宋度支来卜居与南园为邻","author":"司马光","text":"弱冠交游鬓发苍，饱谙官况好深藏。\n闲居共买一廛地，尽老常依数仞墙。\n虽喜卜邻同晏子，尚惭推宅异周郎。\n何时税此凭熊驾，倚仗相迎立路傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯常自郢州见寄","author":"司马光","text":"西郊去岁揖行人，柳暗花浓又一春。\n坐想高风清入骨，沉吟佳句健生神。\n潺湲杳霭烟波古，散诞逍遥兴趣新。\n应笑洛阳车马道，缁衣未免化红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯镇再入馆","author":"司马光","text":"甘泉献赋人，流落浙江滨。\n自叹三年谪，归来万事新。\n铨衡时进对，户牖日相亲。\n明主方思贾，非徒问鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君贶少林寺","author":"司马光","text":"达磨自云传佛心，绪言迷世到于今。\n既携只履归西域，安得遗灵在少林。\n孤月正明高殿冷，清风不断老松深。\n谢公自爱山泉美，肯为幽禅此访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君贶寄河阳侍中牡丹","author":"司马光","text":"真宰无私妪煦同，洛花何事占全功。\n山河势胜帝王宅，寒暑气和天地中。\n尽日玉盘堆秀色，满城绣毂走香风。\n谢公高兴看春物，倍忆清伊与碧嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君贶任少师园赏梅","author":"司马光","text":"寒压春头草未芽，喜闻置酒赏新葩。\n官仪赫奕三川守，野意萧疏四皓家。\n不用管弦妨淡泊，岂容桃李竞繁华。\n昏鸦散乱传呼出，归路林间烛影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君贶暮秋四日登石家寺阁晓泛洛舟 登阁","author":"司马光","text":"嬉游乘晓霁，登览犯秋寒。\n不出埃尘外，安知在壤宽。\n宫前断山碧，林表落霞丹。\n欲下惜佳趣，相留更倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君贶题潞公东庄","author":"司马光","text":"嵩峰远叠千重雪，伊浦低临一片天。\n百顷平皋连别馆，两行疏柳拂清泉。\n国须柱石扶丕构，人待楼航济巨川。\n萧相方如左右手，且于穷僻置闲田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和君锡雪后招探春 其二","author":"司马光","text":"繁霙回夜色，凌乱落春云。\n虚幌寒相袭，华堂静不闻。\n玉卮深可敌，银烛近微分。\n谁念牛衣客，穷经白发纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶寄吴瑛比部安道之子壮年致政归隐蕲春","author":"司马光","text":"负米承亲愿已赊，耻随鸡鹜啄泥沙。\n一朝投绂真高士，万卷藏书旧世家。\n齿发未衰非药物，山林不返为云霞。\n庞眉尚有郎潜者，徇禄忧生直可嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴辨叔知凤翔见寄","author":"司马光","text":"岐阳府舍始相逢，四十馀春屈指中。\n昔日布衣今露冕，当时小吏亦衰翁。\n醉吟久作藏身计，条教应多及物功。\n惟是綵衣难再著，长林极目起悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宋子才致仕后岁旦见赠","author":"司马光","text":"闲官逢献岁，拜揖亦纷然。\n须信家居日，方为已有年。\n劬劳中外遍，名迹始终全。\n伯玉空搔首，蹉跎愧在前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其十","author":"司马光","text":"何处初寒好，初寒福善居。\n长宵对灯火，满室聚诗书。\n暂息登山屐，休脂下泽车。\n所安容膝地，何必更多馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其九","author":"司马光","text":"何处初寒好，初寒游弈园。\n林间叶未尽，篱底菊犹存。\n结竹为庵小，开炉构火温。\n谁言处城市，岑寂似丘樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其八","author":"司马光","text":"何处初寒好，初寒肃政台。\n官闲免簿领，门静少尘埃。\n天借风霜气，人无鹰隼猜。\n庭荒馀老柏，尚有夕乌来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其七","author":"司马光","text":"何处初寒好，初寒叠石溪。\n山斜改昏晓，路曲失东西。\n拾栗走村稚，凿垣巢乳鸡。\n我来闲拥褐，曝背草檐低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其六","author":"司马光","text":"何处初寒好，初寒喷玉泉。\n折冰流谷口，飞溜落云边。\n雀噪聚林杪，樵歌下石巅。\n寻幽不思返，坐啸夕阳偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张文裕初寒十首 其五","author":"司马光","text":"何处初寒好，初寒禹凿门。\n遥天露崖口，轻浪漱山根。\n万佛龛苔老，一灯林霭昏。\n渔梁杳相望，石濑夜声喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]