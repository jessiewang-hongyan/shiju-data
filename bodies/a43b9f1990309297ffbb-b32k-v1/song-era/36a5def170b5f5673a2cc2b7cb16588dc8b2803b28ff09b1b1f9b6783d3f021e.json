[{"title":"简周文显借王有道集二首 其二","author":"赵蕃","text":"先生风节昔人似，白发箪瓢犹嗜书。\n家有校书诗百首，可能乞我助三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简周文显借王有道集二首 其一","author":"赵蕃","text":"乡人不识王有道，抔土空传唐校书。\n闻道遗诗尚多有，典型不似晚唐馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简俞尉","author":"赵蕃","text":"世人往往嗜甘言，正味多嫌橄榄严。\n寄我要须并海物，花猪顿顿饭难厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简施文叔绝句四首 其四","author":"赵蕃","text":"世上小儿迷黑白，此翁胸中泾渭殊。\n少卑高论近流俗，恐妨要路肩安舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简施文叔绝句四首 其三","author":"赵蕃","text":"营营青蝇挥不去，为问适从何处来。\n病人埃郁思一洗，沈李浮瓜亦快哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简施文叔绝句四首 其二","author":"赵蕃","text":"今日之热不可触，闭门养疴适所欲。\n振衣策杖一欣然，凉风为我生脩竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简施文叔绝句四首 其一","author":"赵蕃","text":"草树阴阴一径开，饥乌閒下啄莓苔。\n清风无事自还往，时送官池荷气来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其二","author":"赵蕃","text":"不到西湖又五年，况当风雪探梅天。\n出门有愧登山屦，寻友空回访戴船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其六","author":"赵蕃","text":"自从传得婺州诗，南北飘零阙后期。\n一纸忽来湖上信，恍然堕我水仙祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其一","author":"赵蕃","text":"月台台上几经过，白发重登奈我何。\n树影漫能参独立，溪声无复乱长哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其三","author":"赵蕃","text":"我诗虽老竟无工，君句能佳更不穷。\n立论曾闻紫微老，赠篇期见习轩公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其五","author":"赵蕃","text":"南山最数月台高，曾著能诗何水曹。\n略计出山今几载，生令梅赋阙风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其七","author":"赵蕃","text":"故人索我近题诗，何处如今更有之。\n十载未论前日梦，一枝还动昔人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简徐季益 其四","author":"赵蕃","text":"问讯西湖旧隐庐，水边雪后又何如。\n祇今付与谁人手，籍甚诗名白社徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简莫令求茶","author":"赵蕃","text":"万安近说神潭茶，颇似文当屈宋衙。\n山中索居睡不足，碾寄盍令舒眼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简梁叔昭觅香","author":"赵蕃","text":"雨住山岚更郁深，病夫晨起畏岑岑。\n可能乞我蓬莱炷，要遣衣襟润不侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简赠欧阳伯威二绝句 其一","author":"赵蕃","text":"江西人物况欧阳，少有诗名老更昌。\n左辖虽能诵佳句，子虚胡不荐君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简赠欧阳伯威二绝句 其二","author":"赵蕃","text":"三年身不到穷冈，诗友飘零半在亡。\n杯里纵能谈矻矻，镜中无复鬓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷老欲退普宁二绝句 其一","author":"赵蕃","text":"借阁看山且半年，看山未饱此为迁。\n闻师亦欲抛山去，祇恐山灵未许然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷老欲退普宁二绝句 其二","author":"赵蕃","text":"怀玉山中旧住人，岁寒庵里坐禅身。\n当年未解来飞锡，今日何妨却问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鼠山","author":"赵蕃","text":"鼠山山下鼠山潭，名字常因艇子谈。\n几欲赋诗收拾汝，技穷如我莫多贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其十一","author":"赵蕃","text":"寒日萧萧上矮窗，竹阴窗影两舂撞。\n是中寓意真无尽，笔底寻诗卒未降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其十","author":"赵蕃","text":"春风吹绿满天涯，想见山园尽落花。\n少日意狂轻节物，祇令流转谩成嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其九","author":"赵蕃","text":"风顺风横总欲乘，传呼虽数不余应。\n去程渺渺湖边草，宿伴悠悠水上罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其八","author":"赵蕃","text":"一日风帆数日程，绝知快意亦轻生。\n延缘始欲滨湖去，可奈同途莫并行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其七","author":"赵蕃","text":"望极平湖不得山，水长山远画图间。\n赋诗不似王摩诘，湖北湖南空往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其六","author":"赵蕃","text":"已遭穿颊尚洋洋，尔本何辜饵触香。\n断肉未能聊戒杀，念将赎尔又空囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其五","author":"赵蕃","text":"钓发关余谓吉徵，长年三老尔何凭。\n那知我本江湖士，失脚东来亦堕罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其四","author":"赵蕃","text":"截竹钩丝作钓筒，半缠苍石著波中。\n忽焉快跃知鱼中，相语相呼促短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其三","author":"赵蕃","text":"风雨萧萧病欲侵，杂然啼鸟在中林。\n细听却有黄鹂语，端是当年隔叶音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其二","author":"赵蕃","text":"风雨属连殊未休，豫章城中十日留。\n江云有意作晴色，今者薄暮当行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴十一首 其一","author":"赵蕃","text":"桃树深红亦浅红，竹竿个个又丛丛。\n儿男在田妇行馌，犬卧鸡啼茅舍空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瘦梅","author":"赵蕃","text":"清虚日集人当瘦，粪壤不资梅合癯。\n君看霜皮藏玉骨，肯如朱粉斗涂糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午三首 其三","author":"赵蕃","text":"忠言不用竟沉死，留得文章星斗罗。\n何意更觞昌歜酒，为君击节一长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午三首 其二","author":"赵蕃","text":"年年端午风兼雨，似为屈原陈昔冤。\n我欲于谁论许事，舍南舍北鹁鸠喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午三首 其一","author":"赵蕃","text":"谩说投诗赠汨罗，身今且尔奈渠何。\n尝闻求福木居士，试向艾人成祝呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静春堂","author":"赵蕃","text":"游子如蜂蝶，纷纷讵识春。\n先生静中观，物物寓吾仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"趣成父酿酒用子进家法故及其昆仲","author":"赵蕃","text":"入眼江梅皆好枝，是中劳我几怀思。\n诗声何止一头出，酒事乃称百室师。\n闻道名方曾口授，定应买秫趁冬炊。\n小须旬月酿当熟，寄我茅斋不可迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三老堂壁","author":"赵蕃","text":"雨过湖边秋思多，怅无轻樴傲渔蓑。\n向来梦境今安在，名与青山保不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题子璿浯溪图","author":"赵蕃","text":"璿之戏墨万之诗，不到浯溪坐可知。\n凛凛元颜千载意，若为付与水云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题中团寺柱","author":"赵蕃","text":"向来不识中团寺，一自移家得屡过。\n纵使山僧真厌客，淡然相对有维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丰陂铺壁","author":"赵蕃","text":"树影当阶日正中，一蝉何适自吟风。\n病夫畏病怕触热，聊此设床寻睡功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仁坑铺","author":"赵蕃","text":"四松离立类岩幽，遮我聊为半日留。\n更恨月明清影夜，不能于此听飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方士繇伯谟五丈所居三首 其三","author":"赵蕃","text":"远庵庵榜晦庵书，不独人高字亦如。\n陇亩纵令非我有，溪山政自要君居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方士繇伯谟五丈所居三首 其二","author":"赵蕃","text":"文定去营衡麓宅，仲容自老籍溪傍。\n祇令风月无人主，今代玄英更姓方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题方士繇伯谟五丈所居三首 其一","author":"赵蕃","text":"诗名旧仰方丰国，句法亲传吕紫微。\n闻道有儿能世业，师门更向晦庵归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题王远父所藏苏沧浪帖","author":"赵蕃","text":"吾家旧物见君家，说起漂流屡叹嗟。\n甚欲持归试摹写，不堪病眼已昏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题旧宫","author":"赵蕃","text":"新宫改作几何年，像设于今尚俨然。\n薜荔绿垂山木槁，长春开尽草芊芊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题白龙洞","author":"赵蕃","text":"流水疏梅我有诗，偶来重见雪离披。\n五年不蹋常山路，咫尺宁乖一赴期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石潭观音院用王枢密庶愚丘正宗韵二首 其二","author":"赵蕃","text":"所至滔滔不问津，故知此地往来频。\n从今更识林间寺，再到不愁无主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石潭观音院用王枢密庶愚丘正宗韵二首 其一","author":"赵蕃","text":"老衲迎门祇敝裳，问年还举四山黄。\n谁云此院通衢著，渠自长閒人自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘正之少陵像二首 其二","author":"赵蕃","text":"我今即有湖南役，准拟扁舟泊耒阳。\n敬谢此图非久别，会倾桂酒奠椒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘正之少陵像二首 其一","author":"赵蕃","text":"逢人欲问成都事，见说成都信便回。\n欲问草堂亡恙否，恍然图像对人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘叔骥所画竹","author":"赵蕃","text":"竹不愧老可，人今无老坡。\n聊将一卮酒，相与酹蘋波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘叔骥梦游赤壁赋后二首 其二","author":"赵蕃","text":"江湖知友亦云多，每叹风流奈若何。\n水落故知当石出，镜中宁惜鬓将皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘叔骥梦游赤壁赋后二首 其一","author":"赵蕃","text":"三国功名可立谈，赋成赤壁倍崭岩。\n想君梦去神游处，慷慨风流真可参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题邢园壁","author":"赵蕃","text":"池草似争长，木阴如合围。\n不惟催我去，政欲饯春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题君子亭","author":"赵蕃","text":"菊落渊明手，爱人仍及乌。\n荷花定好友，周子亦陶徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨补之画梅","author":"赵蕃","text":"翠筱横侵鹤膝枝，江南篱落雪残时。\n杨郎笔下烟岚集，留作晴窗觅句资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题沈弟所作短轴 其一","author":"赵蕃","text":"冥冥细雨熟黄梅，欲起看山懒又回。\n咫尺忽能来万里，恍然堕我晓船开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题沈弟所作短轴 其二","author":"赵蕃","text":"作诗政欲江山助，老矣东西南北人。\n弟却把诗摹作画，东西南北是知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题芭蕉","author":"赵蕃","text":"卷藏政尔待时雨，及此发舒天已秋。\n已是萧萧吹我急，主人宁得厌飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓雪图 其三","author":"赵蕃","text":"画师端为谁，钓者亦安在。\n我不识若人，相望大千内。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题圆通院","author":"赵蕃","text":"吾家旧筑炉峰宅，岂不怀归困转蓬。\n奔走微官遍林谷，却寻清磬到圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题泰州司理廨舍小亭","author":"赵蕃","text":"凿去为亭因得池，面池老柳蔽仍亏。\n客来不用勤修供，乞与绳床令赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题堂下桃花","author":"赵蕃","text":"桃花颜色晓犹深，薄暮风烟已不禁。\n人生抵死朱颜恃，不料青铜霜雪侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题渊明采菊图子璿所作","author":"赵蕃","text":"云出无心还自归，乱峰明处日西微。\n白衣不至东篱寂，满把菊花风动衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题船子和尚图","author":"赵蕃","text":"纵有丝纶不暇施，痴鱼吞月自惊疑。\n旁观莫作风波想，比著人间未是危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄溪壁二首 其二","author":"赵蕃","text":"此邦茶品固多有，闻说黄溪独未尝。\n何日敲门辱持赠，更须高诵碧云章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄溪壁二首 其一","author":"赵蕃","text":"新居不见邠山主，及到黄溪又不逢。\n锡杖徐飞向何处，槛前山水自为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾幼度诗集后二首 其二","author":"赵蕃","text":"客路东西曾数州，诗成宁免暗中投。\n我今办取逢人说，倾盖悬知胜白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾幼度诗集后二首 其一","author":"赵蕃","text":"江南山水尽宜诗，几欲经营竟不奇。\n不料此编能到手，意曾关处辄能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曾真君炼丹井","author":"赵蕃","text":"樟源岭下炼丹井，建德道间仙女泉。\n埋没只今谁汲引，信知名字托人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新宫","author":"赵蕃","text":"到处江山非不佳，不归佛屋即仙家。\n南山自好不归去，落魄赋诗天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新庵壁间","author":"赵蕃","text":"道人庭宇知何有，几个修篁一树梅。\n说似庵门莫深闭，断无俗客此间来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"憩汭口之秘藏院","author":"赵蕃","text":"老至浑亡旧所经，漫嗟古屋暗丹青。\n庭空废扫苍苔长，时听风抛柏子铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"篱落间见凌霄偶书","author":"赵蕃","text":"凌霄何自名，缘木与俱生。\n底事因蓬附，故为亦蔓荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠龙王山庵秀上人","author":"赵蕃","text":"道人学易更参禅，一住江头已六年。\n劝我小留殊不顾，那知风雪有回船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许季升五首 其五","author":"赵蕃","text":"学诗自足致寒饥，更欲探求造化机。\n我坐一偏犹不免，君今两取是邪非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]