[{"title":"拾得赞","author":"释如珙","text":"是谁拾得你，便名为拾得。\n手把粗粝藜，要打天边月。\n埽地却有功，眼界得净洁。\n闾丘太守来，也解生欣悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵州和尚赞","author":"释如珙","text":"有底道赵州说禅，近在口皮边，远过河沙国，总描邈不著。\n镇州出大萝卜头，是他亲见南泉。\n观音院壁上，挂个葫芦，风吹不落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送一维那","author":"释如珙","text":"扣我山寮门，乃是我法侄。\n来情不用推，一一皆著实。\n生柴带叶烧，新水敲冰汲。\n难得再相逢，今年六十七。\n归去望东溟，天岸一团日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送彻上人游台雁","author":"释如珙","text":"多人乞语过台雁，上人亦向那边游。\n寒拾不能登妙觉，只为贪著山水幽。\n巨罗长年抱膝坐，痴痴更是不知休。\n春花正开香满路，日轮卓午山气收。\n乘兴去时宜速速，乘兴回来莫悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送明藏主","author":"释如珙","text":"门内天地阔，门外山水长。\n一句未脱口，遍界是冰霜。\n寒光夺夜月，鬼神不敢当。\n本来清净性，胸中无留藏。\n拾得是我弟，寒山是我兄。\n明朝相随去，一锡兼一瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送茂侍者","author":"释如珙","text":"一鹗度秋空，秋空无影迹。\n千人万人海，聚头空唧唧。\n点黑杨岐衣，鹫峰藏得密。\n寒暑知几年，分付当有日。\n谈玄说妙者，脱去情尘执。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送琦上人","author":"释如珙","text":"万里无寸草，出门便是草。\n十年归不得，忘却来时道。\n今岁秋事早，凉风生木杪。\n拄杖挑钵囊，锐志不小小。\n孰顾他洞山，浏阳寒拾老。\n衲僧家行履，不可得寻讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四十三","author":"释如珙","text":"北斗里藏身，虚空中出没。\n道得一句来，日头东畔出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四十二","author":"释如珙","text":"斩蛇却非小小事，直是教他脱苦轮。\n座主高茅心未泯，如何胡乱妄通言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十九","author":"释如珙","text":"尊者策眉王不会，十方刹土古风清。\n佛斋胜会亲曾预，不是寻堂粥饭僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十七","author":"释如珙","text":"圆相中间坐底谁，便施女拜各呈机。\n国师道大遍天下，未许寻常人得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十三","author":"释如珙","text":"担一片板在肩头，如何得到空王地。\n睦州古佛多垂慈，要你自家放舍去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十一","author":"释如珙","text":"不曾出门去，庄上吃油糍。\n庄主归相谢，侍者不得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十","author":"释如珙","text":"大地一只眼，谁敢屙其中。\n锹子寄将去，那知到雪峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十四","author":"释如珙","text":"人来面壁成多事，争得心开见本源。\n空劫已前诸佛子，话头不举自然圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十二","author":"释如珙","text":"廓然无圣真实语，对朕者谁心未息。\n本光灿烂照十方，无量劫来到今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十","author":"释如珙","text":"闻声不见形，撼树却惺惺。\n体用何须论，归家落日明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其二十","author":"释如珙","text":"吾家不甚遥，看取脚下路。\n红日上山头，石羊草里卧。\n人间一百年，弹指声中过。\n柴门无锁钥，白云自来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十九","author":"释如珙","text":"迷时从他迷，悟时听他悟。\n九牛虽有力，拽之不可住。\n日落又黄昏，风吹白杨树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十八","author":"释如珙","text":"老农陇上耕，终日手不住。\n白骨谁家冢，群鸦噪高树。\n一条浅溪水，滔滔自流去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十五","author":"释如珙","text":"大道在目前，本来无妙理。\n阳地生为人，阴空死作鬼。\n月照岭上松，风吹原下水。\n髼头寒拾翁，拍手笑不已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十二","author":"释如珙","text":"鱼浮水面性地平，鸟入林中机路密。\n秋到石床枫叶落，梦幻伴子六十七。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十一","author":"释如珙","text":"晓来云过阑干湿，手把圆珠独自立。\n声声称念南无佛，佛道现前不成佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其十","author":"释如珙","text":"万事成空皆已悉，一身无实亦深知。\n丝毫名利放不过，得出轮回是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其八","author":"释如珙","text":"触目尽是清净地，清净地上无佛住。\n赵州教人急走过，狸奴倒上菩提树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其六","author":"释如珙","text":"诸佛面前求早悟，众生界上几曾迷。\n本源自性天真佛，日用中间无少亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其五","author":"释如珙","text":"楼上五更钟未动，人间万事已营营。\n明朝一饭先书籍，那取工夫细度量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十首 其四","author":"释如珙","text":"贪瞋痴众生根本，众生根本佛根本。\n佛无众生不成佛，是故众生佛根本。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十三","author":"释如珙","text":"从上来，死衲子心，能有几人。\n活衲子眼，能有几人。\n昨夜玲珑岩，吞却太白峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十六","author":"释如珙","text":"三期罢了不施功，万里秋天西北风。\n无孔铁锤成队走，苦哉灭却少林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十五","author":"释如珙","text":"明暗色空，不曾碍人。\n一念周沙界，日用万般通。\n湛然常寂寂，常转自家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十四","author":"释如珙","text":"群阴欲去未去之际，一阳欲来未来之时。\n楼上钟鸣，堂前鼓响。\n凡圣交参，一期事毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十二","author":"释如珙","text":"哇地一声诸境现，周行七步更多能。\n老僧不是多饶舌，要与诸人绝谓情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十一","author":"释如珙","text":"三世如来说妙义，炎炎火燄雪火飞。\n面前总是听法底，识取当头底是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三十","author":"释如珙","text":"薪火相交，识性不停。\n上至诸佛，下至众生。\n扶过断桥水，伴归明月村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十九","author":"释如珙","text":"日暖风和二月春，桃红李白遍山林。\n涅槃路上绝来往，一个无为清净身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十七","author":"释如珙","text":"大无外，小无内。\n一即三，三即一。\n路逢道伴交肩过，一生参学事毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十六","author":"释如珙","text":"年穷岁尽时，家家烧纸钱。\n滴滴落地，千神俱醉。\n不可作佛法商量，不可作世谛流布。\n若作世谛流布，瞎却眼睛。\n若作佛法商量，烂却舌头。\n即心即佛，非心非佛。\n不是心，不是佛，不是物。\n东海鲤鱼打?跳，新罗国里无寸土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十三","author":"释如珙","text":"鼓声咬破七条，只著偏衫去也。\n老鼠满地走，拖取猫儿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十一","author":"释如珙","text":"天得一以清，地得一以宁。\n金刚神合掌，归依佛法僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二十","author":"释如珙","text":"龙门无宿客，不是点额人。\n孤峰无宿客，不是守株人。\n红日绕须弥，清风遍寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十九","author":"释如珙","text":"小屎坑，大屎坑，浸不杀底出来。\n我有一句向你道，如何是佛，乾屎橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十八","author":"释如珙","text":"莲花生淤泥，标格天然别。\n出水未出时，喂鱼并喂鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十七","author":"释如珙","text":"恶是罪业，善亦是罪业。\n罪业消除，青天白日。\n西河弄狮子，丰干骑猛虎。\n老玄沙卓牌，邓师伯打瓦鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十五","author":"释如珙","text":"夜来地动葭灰起，百草头边一寸春。\n抖擞精神急荐取，生老病死不饶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十三","author":"释如珙","text":"三衣覆体，四事供需。\n若也知惭知愧，是真释子。\n莫道曩劫修来，非从今日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十二","author":"释如珙","text":"离四句，绝百非，老僧爱瞋不爱喜。\n箭过西天十万里，向大唐国里等候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其十一","author":"释如珙","text":"今日生，来日死。\n千年田，八百主。\n郎当屋舍没人修，火官头上风车子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其九","author":"释如珙","text":"十方同聚会，啾啾唧唧。\n个个学无为，劳劳摝摝。\n此是选佛场，心空及第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其八","author":"释如珙","text":"华阴山前百尺井，中有寒泉彻骨冷。\n谁家女子来照影，不照其馀照斜领。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其六","author":"释如珙","text":"相见不扬眉，君东我亦西。\n相逢欲相唤，脉脉不能语，总是粥饭气。\n贴贴底无缝罅能有几个，温州城里何限数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其五","author":"释如珙","text":"三界心尽，即是涅槃。\n山花红似锦，涧水湛如蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其四","author":"释如珙","text":"一毛吞海，海性无亏。\n纤芥投锋，锋利不动。\n龙潭吹灭纸灯，德山倒地礼拜。\n今年桃李贵，一颗直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其三","author":"释如珙","text":"般若如大火聚，著得一丝毫么。\n一拳拳倒黄鹤楼，一踢踢翻鹦鹉洲。\n有意气时添意气，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十六首 其二","author":"释如珙","text":"古佛与露柱交参，猫儿咬杀猛虎。\n出门撞著须菩提，拶破虚空全体露。\n一片虚凝绝谓情，万里清光飞玉兔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄予藏主","author":"释如珙","text":"要成大树作阴凉，放教片心如泥去。\n云门一举四十九，临济大师无本据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灵仲通侄","author":"释如珙","text":"一楼山色好，山是飞来山。\n座上方外友，身心俱閒閒。\n秋来几夜梦，踏月到其间。\n更转语方定，瓦炉香未残。\n一偈聊相寄，山寮长日关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宝藏主","author":"释如珙","text":"识尘消落尽，本性自圆明。\n动静无差异，语言只似常。\n后到不过此，先来亦只宁。\n坐禅一片石，松树长青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄雪窦千峰琬西堂","author":"释如珙","text":"千丈崖根芋火香，天上日轮正卓午。\n东土西乾无祖师，白头老僧七十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄端书记","author":"释如珙","text":"青猿长短声，独自倚廊柱。\n三际俱不来，一片冷泉水。\n非唯无众生，无佛亦无己。\n短句与长吟，遣兴适意耳。\n半夜落霜华，日轮正卓午。\n寥寥天地间，只有寒山子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灌顶长老","author":"释如珙","text":"半夜鹤鸣山月吟，山翁独坐破柴床。\n几番劫石成灰去，一点灵光照世明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塔偈","author":"释如珙","text":"午夜髑髅吟，山空片月明。\n西方无净土，只有弥陀经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塔铭","author":"释如珙","text":"天生一穴，藏吾枯骨。\n骨朽成土，土能生物。\n结个葫芦，挂赵州壁。\n永脱轮回，超三世佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山赞","author":"释如珙","text":"做诗无题目，只要写心源。\n心源虽难搆，浅深在目前。\n白云抱幽石，藤花树上纡。\n丰干不识你，道你是文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其七","author":"释如珙","text":"不是心，不是佛，不是物。\n新罗国里打鼓，大唐殿上作舞。\n天上天下人痴痴，七佛传来到六祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其一","author":"释如珙","text":"不破古人玄关，而玄关自破。\n不碎今时窠臼，而窠臼自碎。\n鹫峰之衣烂却，西丘之话无传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人画师像请赞 其六","author":"释如珙","text":"栽菜根向上，种豆要收谷。\n不必生疑讶，今年六十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道藏主号物外因作此偈","author":"释如珙","text":"何处是物外，徒然劳指注。\n物物皆唯我，我实无比喻。\n去却我一字，动静随所寓。\n灵光遍寰宇，今古绝来去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈明和尚赞","author":"释如珙","text":"得人怕，得人憎。\n嚇得神鼎，头缩面青。\n烧火未著，晚参鼓鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德山和尚赞","author":"释如珙","text":"吹灭纸灯，眼前黑暗。\n拈得白棒，胡挥乱挥。\n黄河放出，太华裂开，大千沙界绝尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干赞","author":"释如珙","text":"人心既无，虎心亦无。\n骑来骑去，是汝是吾。\n松门杳杳，朗月轮孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虎丘隆和尚赞","author":"释如珙","text":"睡虎一啸，虚空掇转。\n南辰居北，北辰居南。\n驴作驴鸣，犬作犬吠。\n外道消灭，正宗亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其十三","author":"释如珙","text":"补陀岩上，白衣观音。\n闻声悟道，见色明心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其四","author":"释如珙","text":"我瞿昙佛，具正遍知。\n子母分解，只在当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其一","author":"释如珙","text":"世尊拈花，迦叶微笑。\n正法眼藏，涅槃妙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]