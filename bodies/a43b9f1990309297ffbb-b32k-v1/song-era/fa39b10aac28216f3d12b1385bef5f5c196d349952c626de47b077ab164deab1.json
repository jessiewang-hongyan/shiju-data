[{"title":"咏佛见笑","author":"舒岳祥","text":"锦堂得此添春色，金屋从他著丽人。\n老佛见之怜且笑，少年休以妄为真。\n梵天宝相宜方驾，海岛金沙合效颦。\n可是好花多刺手，汉滨游女礼防身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏芭蕉","author":"舒岳祥","text":"虚明旱藕千丝透，清泠寒泉百脉来。\n绿烛怕烧先自障，青笺欲寄倩谁裁。\n正怜夜雨敲篷响，只恐秋风裂扇开。\n月下徘徊清影动，却疑翠凤下瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏豆蔻花 其一","author":"舒岳祥","text":"春晚愁偏重，垂头向下生。\n牡丹怜与叶，蕙草爱分茎。\n悬袋双鱼意，含胎少妇情。\n幽姿如冷淡，那敢拟倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏凌霄花","author":"舒岳祥","text":"凌空千尺走龙蛇，隐映柴门野老家。\n拚把长缨縻落月，乱飘丹粉染晴霞。\n猿猴升惯能收药，蝴蝶低飞不到花。\n最爱豹林种处士，紫英香里岸乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏海棠","author":"舒岳祥","text":"一年春潋滟，二月锦阑干。\n绿嫩难扶醉，红轻最觉寒。\n欲知花有恨，来向雨中看。\n泥饮须通晓，千枝放烛残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏密囿花","author":"舒岳祥","text":"繁枝密密宜樊圃，以此能当密囿名。\n不信嫩茎藏劲刺，试将纤手触红英。\n毛身秦女自正色，鸟爪麻姑无俗情。\n方朔窃桃何处入，只应列子御风行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏紫荆花","author":"舒岳祥","text":"自古惟闻棠棣咏，后人多感紫荆回。\n固知天理随机触，亦本诗人起兴来。\n枯条谁缀桃花米，嫩蕊初挼撒酒媒。\n野老门前栽一树，才开桐角此花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏赪桐花","author":"舒岳祥","text":"朱草文明瑞，兹花上品朱。\n巧瑳红象珥，阔制紫云襦。\n丽夺炎精盛，名沾御赐殊。\n且贪颜色好，鹤顶似他无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏篆畦垂丝海棠","author":"舒岳祥","text":"夺胎锦带仍添丽，借面芙蓉特太癯。\n睡去不禁春露压，醉来谁倩晓风扶。\n长条莫恨无新叶，纤瓣还能著细须。\n火急提鱼花下饮，明朝千点乱青芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏蝶","author":"舒岳祥","text":"前身曾学昭仪舞，时样工为京兆眉。\n拣尽好枝无可意，倦寻芳草歇多时。\n晓畦雾重狂须减，风槛花飞误与随。\n不但蛛丝深著避，更知红袖亦堪疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏鸂鶒","author":"舒岳祥","text":"双双游戏水仙宫，著锦衣裳舞镜空。\n晴浴桃花红影里，雨眠莲叶翠香中。\n文禽自是风情别，野鹭休将品格同。\n寄语虞罗须并取，莫令失侣各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因黄甘人便问讯帅初","author":"舒岳祥","text":"茇舍干戈后，班荆荐莽馀。\n何人骑有鹤，顾我食无鱼。\n孤愤向谁说，倦游休上书。\n时时问甘岭，戴子近何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"舒岳祥","text":"黄昏风雨后，清夜圣贤心。\n松月生池底，窗灯间竹林。\n咽津芝朮味，洗耳石泉音。\n早秫传消息，清香慰暑襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜读达善烧痕漫抄次来韵奉谢","author":"舒岳祥","text":"桓桓松柏岁寒知，白发相逢也自奇。\n犹记小儒曾共勘，绝怜后藁未全窥。\n斯文定价何必我，自古趋名存者谁。\n惟有立言差不朽，夫君此计未应痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝相花","author":"舒岳祥","text":"春风不到上林花，流落民间日又斜。\n曾向玉堂承雨露，可堪金屋委尘沙。\n生来富贵由天分，到底风流出内家。\n莫讶绿繁伤手刺，幽贞难犯可吁嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩云","author":"舒岳祥","text":"岩云黏壁白，瀑雨点帘斑。\n诗句鸦初晓，乡愁日半山。\n故人来沼上，好鸟韵窗间。\n树近夜先到，村空春未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚辰元旦试笔","author":"舒岳祥","text":"数我初生岁，今为第二年。\n光阴六十过，行辈几人全。\n试把新诗写，闲将好梦圆。\n儿孙扶出拜，苏酒让渠先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚辰冬帅初与正仲约过阆风既而予坐病二友亦不果至辛巳四月帅初特来访予时尚在病中为予留山庵一宿而去似不欲劳予应酬耳归至中涂有诗见寄予次韵因贻正仲也","author":"舒岳祥","text":"杜宇啼时多是雨，酴醾开后便无春。\n惜花底学千金子，对酒还思两玉人。\n良药草中闲长叶，幽禽花里巧藏身。\n青山百里通来往，衰病何曾厌客频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放萤寄正仲","author":"舒岳祥","text":"残编百读过，年去放萤飞。\n好带随身火，休争秉烛辉。\n夜凉辞竹庋，风逆返书帏。\n未是明经日，何人拾汝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"易庵道人归雁苍两月矣作诗趣之","author":"舒岳祥","text":"一入雁苍山，山苍雁落湾。\n石螀鸣杼下，沙鸟宿窗间。\n吾子动多悔，老夫今稍闲。\n密云疏雨里，心事极相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松花","author":"舒岳祥","text":"偃蹇不入俗，随春也作花。\n高攀许樵子，轻扫落僧家。\n功用虽非药，风标正似茶。\n秋风收子食，辟谷胜胡麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枕上闻蛩有感","author":"舒岳祥","text":"桑鸟催耕缘底事，草虫促织竟何成。\n春风秋月祗垂泪，北斗南箕空得名。\n有客悲歌持筑击，何时至治以韶鸣。\n吾侪吟咏还如此，哀乐不知何处生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物化","author":"舒岳祥","text":"扰扰孰分形，纷纷谁与明。\n蝼蛄擘地走，蚯蚓上阶鸣。\n随事皆天道，因人见物情。\n蝉吟兼蝶舞，风韵喜轻清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦牙动诗","author":"舒岳祥","text":"身心自缚似芭蕉，安得凌风历九霄。\n闲户人随春去老，倚阑花向雨中消。\n病牙臲卼活书板，童顶羸垂倒药瓢。\n善谑偶然成句子，丛谈聊以永今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试杨日新笔次韵答戴帅初","author":"舒岳祥","text":"闻尔又归青嶂住，四明西畔越东头。\n山当篱外偏环屋，水到门前总合流。\n得句苦迟难附置，怀人不见更登楼。\n扫除儿女相思话，好作阆风十日游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前所咏诸花皆托物以赋者尔未若眼花乃吾身之花岂得遗乎","author":"舒岳祥","text":"春去花亦去，何如见此花。\n青山飞霭合，白日乱烟遮。\n望月惟昏镜，看书似隔纱。\n潇湘闻夜雨，此景属谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将为鄞江之游先寄正仲三首 其三","author":"舒岳祥","text":"水涨苔梳发，风晴麦漾须。\n茶香度深竹，灯影射平芜。\n岁月江流驶，乾坤客枕孤。\n鄞乡风物好，莼菜出湘湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将为鄞江之游先寄正仲三首 其二","author":"舒岳祥","text":"天地悲歌里，江城战血馀。\n哀湍泻坏道，斜日照残书。\n发秃因慵栉，园荒亦懒锄。\n旧来双紫燕，随我到茅庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将为鄞江之游先寄正仲三首 其一","author":"舒岳祥","text":"相思不在远，道地一来难。\n残月中峰见，疏星半夜看。\n江湖青草远，风雨小窗寒。\n鄞水饶鱼米，何由得共餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春分偶饮成醉兀兀坐睡觉而残月在窗矣","author":"舒岳祥","text":"酒熟还成饮，花香忽过墙。\n近灯人影大，斜月树身长。\n阴洞龙藏雨，春苗麝养香。\n閒吟谁与语，醉倚一胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日与正仲坐山斋余隐几就睡既觉而正仲端坐诵书未已此意似更胜渊明卿且去之语也","author":"舒岳祥","text":"坐睡吾知味，观书客更嘉。\n柴门桑旧曲，石径笋新斜。\n花饱蜂归国，巢成燕著家。\n此中真有意，高柳两三鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其十","author":"舒岳祥","text":"春日山居好，光风草上浮。\n溟濛晨霭散，澹荡夕阳收。\n发轫梅花报，攀辕芍药留。\n春来亦何好，惟有白添头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其九","author":"舒岳祥","text":"春日山居好，春园赏海棠。\n风流思妙丽，老大尚清狂。\n暂拭伤时泪，还逢绝世妆。\n倾银并注瓦，彼此一时芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其八","author":"舒岳祥","text":"春日山居好，寻花急占先。\n骑驴投酒市，领鹤上渔船。\n薄暖还挥扇，轻寒未替绵。\n清和时候正，丽日牡丹天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其七","author":"舒岳祥","text":"春日山居好，柴门爱客过。\n连朝恣泥饮，随意有山歌。\n句小从人学，才衰觉气和。\n情怀依分足，好景不须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其六","author":"舒岳祥","text":"春日山居好，西湖乐事非。\n青黄虽未接，红紫自交辉。\n酒在何忧死，诗成可疗饥。\n典书犹可醉，何必有金挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其五","author":"舒岳祥","text":"春日山居好，闲思二月头。\n麦青农作暇，荑秀女工休。\n布谷迟催种，提壶早劝游。\n老夫同猎较，陌上暖风柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其四","author":"舒岳祥","text":"春日山居好，春来不问深。\n柳能同燕舞，莺解代花吟。\n有酒家闲去，无诗客莫寻。\n卖田强免役，何必苦劳心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其三","author":"舒岳祥","text":"春日山居好，春深自向归。\n且看成茂实，何必恋芳菲。\n树合明湖隔，蒿长远径微。\n风雩吾党事，试浴振春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其二","author":"舒岳祥","text":"春日山居好，尤佳是仲春。\n半开花有韵，微醉酒全真。\n尧帝衣裳日，周公礼乐辰。\n枝头百舌子，播告太谆谆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山居好十首 其一","author":"舒岳祥","text":"春日山居好，初春草色回。\n小桥帘映柳，野店烛簪梅。\n箭茁穿沙出，兰芽带雪开。\n从今排日去，连月覆樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日即事","author":"舒岳祥","text":"灯夕花朝都已过，石泉槐火又将新。\n故乡失业荆榛满，客子长饥雨雪频。\n底处桃源堪避世，何人橘里得藏身。\n朝家细核丁黄籍，食指虽多无绢银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日怀帅初","author":"舒岳祥","text":"夜雨流如涧，春风响似雷。\n千愁芳草远，一笑百花开。\n白发痴贪酒，昏眸懒上台。\n怀人不可见，应棹剡船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓","author":"舒岳祥","text":"高枕还慵起，晴窗晓日明。\n家贫从省事，身老放徐行。\n溪树藏村暗，山花照市明。\n园林有乐事，桑下见雏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚闻霰客思凄然两日不见达善季辩书怀奉寄","author":"舒岳祥","text":"夜阑风薄树，雨急水坍沙。\n书在吾何恨，春深自忆家。\n高花犹著雪，浅草早鸣蛙。\n同是离居客，相逢吊岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚寄二林","author":"舒岳祥","text":"谷雨秧芽动，楝风花信来。\n蟹奔沙上火，笋长地中雷。\n燕子巢重定，主人门早开。\n二林诗敌手，先著一篇催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春深赠山甫","author":"舒岳祥","text":"石枕空蝴蝶，山窗足杜鹃。\n春深方沃若，人意自翛然。\n衰老难为别，留连未肯眠。\n灯花知我意，今夜大如钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼睡","author":"舒岳祥","text":"生平慕睡乡，逃暑最为良。\n渴爱煎茶响，饥闻煮粥香。\n百年依白社，一枕熟黄粱。\n童懒呼难动，贪眠到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独坐遣兴","author":"舒岳祥","text":"昏眼迷烟雨，修眉隐树林。\n杜鹃知夜半，蟋蟀俟秋音。\n静悟平生事，閒思万古心。\n嗟跎七十五，既往莫追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕寄周鍊师","author":"舒岳祥","text":"虫声叠哀思，树影弄清辉。\n休恨催年老，私惭昧昨非。\n倦童眠自语，惊鹤定还飞。\n远念周高志，华颠坐翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其十","author":"舒岳祥","text":"秋日山居好，秋涛木末横。\n龙藏寒水静，鹘击广原平。\n红叶茅茨露，黄花曲糵成。\n西风轻步履，随意得閒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其九","author":"舒岳祥","text":"秋日山居好，疏明入画峰。\n猎怜依寺鹿，樵护倚祠松。\n雁起西风笛，人居夕照舂。\n东山久不到，胜具一枝筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其八","author":"舒岳祥","text":"秋日山居好，清凉雁过初。\n鸡头消暑夕，鸭脚待霜馀。\n草净蜃虻远，瓜香蚤蚁除。\n小园新雨过，菜甲自删锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其七","author":"舒岳祥","text":"秋日山居好，重阳庶物穰。\n剖菱红绽白，剥栗紫含章。\n黄雀绵披脊，霜狸玉截肪。\n登高惟小圃，何必上重冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其六","author":"舒岳祥","text":"秋日山居好，中秋兴莫违。\n四腮鲈正脆，一尺蟹初肥。\n白露粳登馔，清霜绢下机。\n急舂输井税，无事早言归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其五","author":"舒岳祥","text":"秋日山居好，新凉及早兴。\n玉餐阳坞米，冰嚼下洪菱。\n海错来蒲港，溪鲜出石屏。\n欲从逋客逝，为此未之能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其四","author":"舒岳祥","text":"秋日山居好，星河顶上悬。\n聊随儿女戏，也设果瓜筵。\n攲枕看星渡，开窗抱月眠。\n溪田六十日，接阙到红鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其三","author":"舒岳祥","text":"秋日山居好，吾居山海间。\n意行逢酒住，兴尽放歌还。\n稻穫归流水，林疏缩远山。\n谁知僧快活，饭饱即身閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其二","author":"舒岳祥","text":"秋日山居好，园丁贡美蔬。\n燃萁酥煮豆，拗颈烂蒸壶。\n菰首甜供茹，姜芽嫩漉菹。\n秋来风物美，何必去吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日山居好十首 其一","author":"舒岳祥","text":"秋日山居好，新凉读旧书。\n黍馨秋社祭，灯灿夜滩渔。\n茄摘收花后，瓜尝脱蒂初。\n早田三得雨，一饱解忧虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日书事贻潘少白","author":"舒岳祥","text":"树色已非昨，虫声不忍闻。\n乱鸦投急景，老树淰长云。\n百顷青黄半，一村晴雨分。\n凭阑新得句，书赠特山君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚随意行涧上值老农问劳去年避乱时事 其一","author":"舒岳祥","text":"书在心犹在，时艰变易衰。\n白云山半寺，红叶水西祠。\n农老言多善，乌驯噪总慈。\n谁于千载后，见我苦吟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种麦后栽补桑柘至田家憩息","author":"舒岳祥","text":"桑柘疏时补，篁茅密处删。\n水边黄叶路，雨外夕阳山。\n一鸟自啼足，两牛相对闲。\n山翁留壁记，子丑话时艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贱生之日邀正仲子堂小酌","author":"舒岳祥","text":"开岁恰七十，吾衰病已频。\n从今数正旦，一月有三晨。\n甲子添新志，乾坤寄老身。\n晚年方学易，此意为谁陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻山甫","author":"舒岳祥","text":"多病空馀老，劳生为苦思。\n偶然新得句，长是不眠时。\n鼠搅歉无肉，佣逃怨食糜。\n此怀谁可诉，只恐则山知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻正仲","author":"舒岳祥","text":"月生鲸海上，人在雁苍中。\n一巘环村转，双溪到海同。\n百年能几见，七十有三翁。\n为此当心恻，诗成走递筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送山甫还峡中","author":"舒岳祥","text":"到处图松树，何曾忘却山。\n相携溪路断，愁踏夕阳还。\n田狖吟桑空，山鸡饮石间。\n所忧无可醉，天上酒星闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王奕世归玉塘","author":"舒岳祥","text":"故人今有子，过我乞铭文。\n红树催年老，青灯话夜分。\n诗笺传父业，隶笔张吾军。\n万里青州路，沂公几代坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]