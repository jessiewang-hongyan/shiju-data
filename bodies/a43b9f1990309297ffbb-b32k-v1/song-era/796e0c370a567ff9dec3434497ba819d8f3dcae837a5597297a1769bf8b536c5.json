[{"title":"九日题潮阳县斋","author":"林㟽","text":"去岁重阳尚故乡，今朝官舍又重阳。\n人情不似黄花好，处处相逢一种香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重辟西湖 其二","author":"林㟽","text":"新堤喜绕几纡萦，挈榼携壶出满城。\n萍破烟纹容棹过，石开云罅看人行。\n亭浮横照波中影，僧拾残霞树杪声。\n不必凤凰山上问，此山东向面湖平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西湖山岩二首 其二","author":"林㟽","text":"坐对高舂放晚衙，舂米和石也穿芽。\n鸥边云阔三千顷，树杪烟横数万家。\n贮月未圆松琐碎，怯风无力竹攲斜。\n叮咛好护湖山景，养得阴成宿莫鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西湖山岩二首 其一","author":"林㟽","text":"咫尺移文唤即应，此亭便可配韩亭。\n溪流横过一湾碧，山色平分两岸青。\n落日钟声鸣远树，半空塔影倒寒汀。\n云烟满目皆亲种，留与邦人作画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重辟西湖 其一","author":"林㟽","text":"镜奁平处小桥西，桥外轻鸥掠镜飞。\n凿破青云放山出，拨开碧藓引湖归。\n带烟插柳阴虽瘦，趁雨栽荷绿已肥。\n欲借禽鱼祝君寿，君恩宽大此情微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居","author":"林绪","text":"宿草江边阁，临流发啸歌。\n所观得病少，岂在蓄书多。\n生子能无贵，居身不可过。\n苟图销旦夕，青鬓长如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起","author":"林景怡","text":"天鸡弄喔咿，残星在斜汉。\n整衣出幽扉，山城漏初断。\n微微水风生，冉冉田露散。\n此时游葛天，淡然空百羡。\n海色上寒梢，渐识梅花面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"言归","author":"林景英","text":"言归江海上，甘向石田耕。\n不愧为斯世，能閒过此生。\n地从邻竹占，树听野禽争。\n坐咏风涛外，南山尽日行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"废观","author":"林景英","text":"羽衣人已化，无处问殊庭。\n春色桃谁种，天香药自灵。\n片霞飞绝顶，一鹤下青冥。\n荒藓空阶下，犹闻夜祭星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林氏庵呈周鍊师","author":"林景英","text":"遥跨青田鹤，翩翩到此来。\n庭生自家草，山有主人梅。\n扫石夜朝斗，雨田秋起雷。\n谁知尘影里，清趣似蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋风","author":"林景英","text":"飒然何处起，水国不成眠。\n触树人疑雨，开门月在天。\n渔舟移绝浦，雁阵落荒田。\n晓起伤漂荡，芦花走屋前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友之石龙","author":"林景英","text":"一杯渭酒劝诗豪，杨柳西风拂去袍。\n行路正当金虎壮，登云不惮石龙高。\n水悬岩白惊残雪，日漾溪红认落桃。\n记取奚囊新句得，月三四幅寄东皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈莘村","author":"林景英","text":"玄冬梅半白，光接太丘星。\n雪月往来梦，溪山长短亭。\n利名成露草，行止付风萍。\n三十年来友，无如老典型。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日出入行","author":"林景英","text":"朝出扶桑来，莫入虞渊去。\n胡不缓驰驱，百岁一朝暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毗陵太平院壁间画山水熟视之有飞动势殆仙笔也因题","author":"林景熙","text":"山风不动云四寂，万顷波涛生素壁。\n三峡夜怒摇星河，九溟昼沸卷霹雳。\n谁将江海一笔吞，华阳入砚玄波翻。\n灵鳌东转坤轴动，惊浪出没蛟与鼋。\n毫端分寸千万里，人心之险亦如此。\n老僧阅世如阅画，面壁凝然悟玄理。\n嗟余老作汗漫游，寒光飞动六月秋。\n乃知瞿塘在平陆，安得竹叶吹成舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与邵德芳同舍三首 其三","author":"林景熙","text":"葵心恋日还终在，橘性踰淮已不同。\n谁识鲈江持钓手，曾搴月窟一枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与邵德芳同舍三首 其二","author":"林景熙","text":"年少同游古辟雍，文光万丈扫秋虹。\n不须旧事谈如梦，灯下相看亦梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与邵德芳同舍三首 其一","author":"林景熙","text":"聚散云萍亦偶然，十年曾此系秋船。\n当时别意芙蓉老，不道相逢又十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山窗新糊有故朝封事稿阅之有感","author":"林景熙","text":"偶伴孤云宿岭东，四山欲雪地炉红。\n何人一纸防秋疏，却与山窗障北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丹阳泉","author":"林景熙","text":"扬子江中?夜月，慧山亭上漱朝烟。\n遥看丹气霏微里，二十泉中第四泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归自越避寇海滨寒食不得祭扫","author":"林景熙","text":"持酒无因洒墓松，禽声花色惨东风。\n去年此日身为客，及到乡山又客中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘龙洲墓","author":"林景熙","text":"一抔寂寞几秋风，云断洲空忆老龙。\n湖海刘郎诗骨冷，乾淳馀响寄孤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘伶墓","author":"林景熙","text":"碧落当年堕酒星，醉中万事一浮萍。\n亦知人世无穷事，一醉松根不肯醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次吴兴二首 其二","author":"林景熙","text":"苍烟淡淡水濛濛，渔笛吹残夕照红。\n六客风流今已远，堂名空入酒名中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次吴兴二首 其一","author":"林景熙","text":"钓舟远隔菰蒲雨，酒幔轻飘菡萏风。\n彷佛层城鳌背上，万家帘幕水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别方槐庭山人二首 其二","author":"林景熙","text":"夜阑深语剔寒缸，别意萧萧竹半窗。\n明日孤帆鸿影外，东风残雪过曹江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别方槐庭山人二首 其一","author":"林景熙","text":"半生书剑孤心老，万里山川两眼醒。\n空向西陵问佳气，舜田禹穴草青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴中会故人","author":"林景熙","text":"一声新雁荻花秋，片月吴松共客舟。\n却忆去年今夜月，思君独上越山楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏小小墓","author":"林景熙","text":"歌扇风流忆旧家，一丘落月几啼鸦。\n芳魂不肯为黄土，犹幻燕支半树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍应平坡侍郎郊行口占二首 其二","author":"林景熙","text":"试耕黄犊健，入社白鸥真。\n柳外呼舟去，水风吹葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侍应平坡侍郎郊行口占二首 其一","author":"林景熙","text":"春霖卷流芳，霁旭浮远野。\n白首贞元人，相期古松下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送果上人游五台 其一","author":"林景熙","text":"万里参师最上关，五台高处雪花寒。\n出门有碍怜吾老，独枕残书梦杏坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送果上人游五台 其二","author":"林景熙","text":"飘飘孤锡度风沙，南北由来本一家。\n参透五台峰顶雪，却归大庾看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"林景熙","text":"蜀魄声声诉绿阴，谁家门巷落花深。\n游丝不系春晖住，愁绝天涯寸草心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蝉二首 其二","author":"林景熙","text":"近交纸薄云翻手，旧梦冠空雪满颠。\n却忆画船曾听处，夕阳高柳断桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蝉二首 其一","author":"林景熙","text":"翼绡微动自宫商，几曳残声送夕阳。\n唤得槐柯芳梦觉，薰风一曲换西凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"项羽庙","author":"林景熙","text":"夜半追兵入楚营，鸿门玉碎卯金兴。\n江东父老犹羞见，地下如何见范增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其六","author":"林景熙","text":"草枯霜白泣原鸰，五十三年老弟兄。\n风雨对床缘未了，荆花重合在来生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其五","author":"林景熙","text":"伯兮癯似松间鹤，季也孤于云水僧。\n昨夜梦中闻笑语，觉来秋在影堂灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其四","author":"林景熙","text":"溪冷浣花宗武哭，池荒梦草惠连愁。\n行人犹说春风夜，灯影书声共水楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其三","author":"林景熙","text":"空遗破砚孤心苦，只博生绡两鬓华。\n小婢灯前泣秋雨，竹房不见夜呼茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其二","author":"林景熙","text":"风尘何处托清魂，家世梅花水月村。\n旧箧已无封禅稿，独怜渴病似文园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭德和伯氏六首 其一","author":"林景熙","text":"棣陨双葩洒泪红，百年已短更匆匆。\n祇今风雪栖栖影，地老天荒一个鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真娘墓","author":"林景熙","text":"歌声舞影散春霞，月殉香魂几落花。\n休恨天家无分到，汉妃青冢落胡沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦望山","author":"林景熙","text":"镌石奇功席卷来，眼中沧海一琼杯。\n神山只在灵鳌背，徐福楼船不见回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羞墓","author":"林景熙","text":"远望车尘汗雨流，自知覆水已难收。\n为君富贵妾羞死，富贵如君不自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其九 上下二镬","author":"林景熙","text":"元非铸冶自成湾，乌兔烹煎那得闲。\n却问黄粮几番熟，不知沸鼎在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其一 若耶溪","author":"林景熙","text":"晴峰无数蘸清流，窈窕寒生六月秋。\n百鍊不须欧冶剑，沼吴人在采莲舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其五 石广","author":"林景熙","text":"一室元无斧凿痕，闲云四壁守孤猿。\n空山静阅古今过，不老乾坤是此门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其六 石船","author":"林景熙","text":"玉笥孤帆唤不来，长风破浪忆江淮。\n不知海水何年陆，万斛龙骧寄断崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其二 任公子钓石","author":"林景熙","text":"巨犗长竿钓海波，空遗矶石卧荒坡。\n千年无此垂纶手，多少饥民向浙河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其十 附子冈","author":"林景熙","text":"洞霞疑接台峰近，石栈空歌蜀道难。\n一种灵苗人不识，半山霜露夜痕乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其四 陶宴岭","author":"林景熙","text":"笑拂青萝问隐君，千岩秋色此平分。\n当时宴坐无人识，唯有松风共白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其七 舜田","author":"林景熙","text":"闻说东夷有圣人，历山何处此耕云。\n露苗犹洒当年泣，寂寞春风鸟自耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其八 葛仙翁石床","author":"林景熙","text":"钧天梦破珊瑚枕，岩壑春供翡翠屏。\n一卷黄庭云半席，夜深读与岭猿听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陶山十咏和邓牧心 其三 集仙桥","author":"林景熙","text":"流来一水截人寰，虹背秋寒十二阑。\n白鹤飞边人影绝，天风吹佩玉珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄芗林故人","author":"林景熙","text":"狺狺多楚狗，何处续离骚。\n草径无尘入，秋峰与节高。\n菰香清野饭，柳色老宫袍。\n笑问刘安鼎，相看已二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中作四首 其三","author":"林景熙","text":"昭陵玉匣走天涯，金粟堆前几吠鸦。\n水到兰亭转呜咽，不知真帖落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中作四首 其一","author":"林景熙","text":"珠亡忽震蛟龙睡，轩敝宁忘犬马情。\n亲拾寒琼出幽草，四山风雨鬼神惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中作四首 其四","author":"林景熙","text":"珠凫玉雁又成埃，斑竹临江首重回。\n犹忆年时寒食祭，天家一骑捧香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中作四首 其二","author":"林景熙","text":"一抔自筑珠丘土，双匣犹传竺国经。\n独有春风知此意，年年杜宇泣冬青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦回","author":"林景熙","text":"梦回荒馆月笼秋，何处砧声唤客愁。\n深夜无风莲叶响，水寒更有未眠鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馆娃宫","author":"林景熙","text":"苧罗山女入宫新，四壁黄金一笑春。\n步辇醉归香径月，隔江还有卧薪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄耳冢","author":"林景熙","text":"筠筒音断水云村，吠入空林枸杞根。\n我亦天涯音信杳，卢令诗在为招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁山 凤洞","author":"林景熙","text":"日澹梧枝洞锁苔，人间矰缴几惊猜。\n九苞自是冲霄物，曾为箫韶一出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁山 天柱峰","author":"林景熙","text":"谁卓孤峰紫翠巅，流泉一脉到宫前。\n却怜千尺擎天柱，不拄东南半壁天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁山 龙洞","author":"林景熙","text":"云湿林腥隐石扉，不知何代有龙归。\n却疑此洞元无底，下挟沧溟作雨飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁山 松间","author":"林景熙","text":"客杖偶逢山鹤引，儒冠幸免野猿嗔。\n吹来松气清人骨，为洗东华万斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九锁山 神仙隐迹","author":"林景熙","text":"仙子浑无涉世劳，屐痕一尺寄孤高。\n几人失脚风波里，可是云根立得牢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陆大参秀夫广陵牡丹诗卷后","author":"林景熙","text":"南海英魂叫不醒，旧题重展墨香凝。\n当时京洛花无主，犹有春风寄广陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠会稽尹医师","author":"林景熙","text":"相逢湖海说医灵，学更参玄世味轻。\n蓟子他年游碧落，空留药市会稽城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"林景熙","text":"闭门荒草合，宿雨掩春华。\n西海无回日，东风几落花。\n雾冥猿自啸，荡冷雁犹家。\n谁是补天手，空怀鍊石娲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中早行","author":"林景熙","text":"短策穿幽径，山樵半掩扉。\n月斜林影薄，石尽水声微。\n一犬隔篱吠，孤僧何处归。\n相逢松下立，风露满秋衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山阴秋怀","author":"林景熙","text":"旧游浑似梦，短发不胜簪。\n风雨行金气，乾坤老铁心。\n舜田秋稗满，禹穴夕云深。\n正自登临懒，凄凉隔水砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"飞云渡","author":"林景熙","text":"人烟荒县少，澹澹隔秋阴。\n帆影分南北，潮声变古今。\n断峰僧塔远，初日海门深。\n小立芦风起，乘槎动客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]