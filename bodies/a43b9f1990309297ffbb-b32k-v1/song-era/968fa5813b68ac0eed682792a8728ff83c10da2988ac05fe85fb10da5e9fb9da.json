[{"title":"日本仙侍者归国","author":"释大观","text":"三应声中密意通，分明饭布裹春风。\n休论亲切不亲切，巨舶回程至海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日者王振斋","author":"释大观","text":"言口谈天有振斋，五行曾不涉安排。\n小轩对坐似无语，几度晴云过断崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示林侍者","author":"释大观","text":"点墨如将当已长，分明白饭糁椒姜。\n出门相送都无说，堂下秋花自吐香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示锦屏赵高士","author":"释大观","text":"真游谁管客程赊，阆苑春风几度花。\n若会粟中藏世界，寥阳不是玉皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴道人求语回庵","author":"释大观","text":"东游何见便还西，觅我伽陀要指迷。\n领取庵头好消息，冬蔬经雨翠交畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沙弥付衣","author":"释大观","text":"鹫岭将何付饮光，十成绵密转乖张。\n鄮峰恁么不恁么，尺线单丝自短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其二","author":"释大观","text":"诸方门户总经过，恼乱春风有几多。\n今日蒸云重睹对，丝毫不隔最誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其一","author":"释大观","text":"日毂升边不计程，转头已是隔重溟。\n更遭尊者相勾引，瀑捣飞梁梦未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"性空","author":"释大观","text":"万有俱该等太虚，更须拈却赵州无。\n如今若欲知端的，舜若新添颔下须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中送湛侍者之京","author":"释大观","text":"别我从容药鼎边，迢迢京路紫霞连。\n重提药病相治句，却道亲依已五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十七","author":"释大观","text":"善战何如善用谋，孙吴兵法岂同俦。\n秋风古塞看形势，一样边声两样愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十六","author":"释大观","text":"叶脱风高天地秋，长江衮衮只东流。\n行人不折离亭柳，羌笛空吹落日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十五","author":"释大观","text":"江面无风平似镜，转头变态互呈新。\n冯夷驾浪险难涉，渔父操舟妙若神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十四","author":"释大观","text":"张公屋畔尽桑麻，李老园中只种花。\n满目风光无限好，笑呼银盌酌流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十一","author":"释大观","text":"客泛灵槎犯斗牛，银河碧海暗通流。\n昆仑推倒无依倚，万里长空一样秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十","author":"释大观","text":"两声不合共交肩，毒手才施报老拳。\n今日上天同碧落，明朝入地共黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其八","author":"释大观","text":"咄哉古墓一狐精，化作人来耍弄人。\n华表未然先败也，至今无地可容身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其五","author":"释大观","text":"才是贪他便著他，其间半露又全遮。\n只今谁是傍观者，一笑何劳挂齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其二","author":"释大观","text":"自是兵家贵伐谋，鏖锋擒敌未为优。\n沈沈刁斗三更月，玉帐威行紫塞秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其三十七","author":"释大观","text":"片段悠扬点太空，卷舒无地觅行踪。\n业风有意相交辊，又复从龙过别峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十四","author":"释大观","text":"倒拈折箸搅沧溟，无限鱼龙暗里惊。\n一笑机关轻捩转，东湖午夜月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十二","author":"释大观","text":"天门日射黄金榜，宫殿晴薰赤羽旗。\n四海九州齐入贡，春风又到万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十一","author":"释大观","text":"三叠秋风古调清，移商换徵许谁听。\n周郎一顾扬鞭去，云外数峰江上青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其十","author":"释大观","text":"一入咸阳尽旧游，春风台榭对芳洲。\n非关好景留人醉，自是行人醉不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其二","author":"释大观","text":"滴滴檐前闻不闻，镜清无舌与谁论。\n夜来几阵尤霶霈，欺压斜阳绿到根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大慧宏智二禅师揖让图赞","author":"释大观","text":"载色载笑，和气津津。\n半前落后，超轶绝尘。\n瘴面忽泽兮疾雷将奋，犀颅茁霜兮枯木生春。\n腹背受敌，百万买邻。\n相见易得好，共事难为人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师清泰请赞","author":"释大观","text":"瞥喜瞥嗔，没头没脑。\n道泰时清，生风起草。\n等閒相撞，黑漆竹篦劈面来。\n无禅可谈，三寸舌头胡乱扫。\n九九百百，自不知老。\n称为临济儿孙，顽石何曾是宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师清瑞请赞","author":"释大观","text":"萎萎蕤蕤，自把不定，人多不悦。\n一味从空架空，知他有何所说。\n养子缘，迷子诀，六月炎炎飘瑞雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师清默请赞","author":"释大观","text":"直如钩，曲如弦。\n拍盲使去，罔测其然。\n不解深跧，强出人前。\n默然兮意传更待驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山隐居士赞","author":"释大观","text":"僧之形，人之英。\n何所作兮畦衣常披，何所说兮玉麈常横。\n世情悠悠兮若秋云之淡，胸次了了兮悬秋月之明。\n其禀也灵，其施也平。\n六窗自虚，万象自呈。\n斯何人欤，岂不入山林而隐，不濯沧浪而清者耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒拾赞","author":"释大观","text":"来何处，去何之。\n与二子，何所期。\n虎视眈眈，阴飙凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云谷粹长老赞","author":"释大观","text":"閒如云，虚如谷。\n岁晚一庵，湖山千簇。\n师资相忘，古灵何必拊背。\n动静无间，茶陵空自跌足。\n一味卷舌冥怀，付与松风度曲。\n玉几如此抑扬，也是唤么作六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山源和尚赞","author":"释大观","text":"门里虫，蛊里毒。\n才过凌霄峰，浑家成不睦。\n指白为黑兮质證有头之冤，改调移声兮唱出无谱之曲。\n自奉川之富沙以至乎剑池，深处兮有谁共躅。\n何须象骨岩高，须知已展不缩。\n韶成九包至，樵唱一夔足。\n家私莫隐，全封半幅。\n赞之骂之，口哑舌秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释大观","text":"入山去龙章凤质，出山来败衣勃率。\n更将悟底分疏，添得一场?淈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释大观","text":"兜率陀天，长汀管界。\n泼布袋打开，自买还自卖。\n眨上眉毛，败也败也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉章云法师赞","author":"释大观","text":"魁梧厚厖，慈和安祥。\n声在江湖品目，仪表衡台学场。\n空假中之列三兮，一与三之不立。\n修多罗如标月兮，指与月之俱忘。\n四处提撕，四花飞扬。\n未老掩光，返常寂光。\n此其所以为柏庭之克家，云公汉章者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示沙弥","author":"释大观","text":"维卫芳腾蔓愈滋，花花叶叶转芬披。\n鄮峰酷烈较些子，昙萼翻成铁蒺藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞","author":"释大观","text":"是境不涉，逢缘不借。\n恶人随顺，喜人凌跨。\n拨千圣剩语为画处山川，笑从上发机如巾结兔马。\n丝糁弗容留，虚空生柄把。\n只今纳败向谁，他骂不如自骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芝岩禅师赞","author":"释大观","text":"和气蔼丛芝，触著变荆棘。\n笑把凌霄峰信脚踏翻，直得新昌石佛额头汗出。\n慈云峰顶，机用纵横。\n凌空驾虚，从其建立。\n高崙苍苍，东湖羃羃。\n僧繇妙笔亦难传，丝毫不动成狼藉。\n咦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山泳长老请赞","author":"释大观","text":"絷空云蒂，补太虚缝。\n虽在穷相手头，却要因人发用。\n等閒撞著个冤家，活脱临时看拈弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释大观","text":"一花移自西，五叶香灿烂。\n嗅蕊与寻芳，纷如蜂蝶乱。\n地阔天宽，难图滋蔓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过水布袋赞","author":"释大观","text":"深则厉，浅则揭。\n七十二汀，无风浪起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿平章秋壑师相","author":"释大观","text":"稽首毗卢法身主，三身一体圆满觉。\n曼殊室利大智海，普贤清净行愿门。\n大慈悲父观世音，信住行向地等妙。\n五十三位善知识，权实拥护天龙神。\n慈威加被俨在上，鉴兹赞祝日行空。\n癸酉仲秋之八日，定光金地产异人。\n自威音前秉正因，向灵山上受记莂。\n优钵孕奇时一现，昴宿腾精瑞两间。\n千灵嘉会当其时，君臣道合若符节。\n升平规模愈持重，呼吸变故常镇浮。\n身徇国难入重险，手扶日毂升中天。\n远夷缩缩惮威略，生民熙熙安衽席。\n嗣皇矜式尊为师，万汇仰戴恃为命。\n佛法流行明盛世，持世护法端有凭。\n二千年后视今日，二千年前等无异。\n如来慧命期永续，众生正信当不断。\n整顿乾坤大力量，安乐黎庶大福德。\n我此伽蓝鄮岭东，释尊舍利所镇临。\n即兹吉祥殊胜地，衮绣光仪立寿祠。\n穰穰缁侣方俨集，钟鼓梵呗何所祝。\n万象舌头悉称寿，宝塔显为舒瑞光。\n昔阿育王造佛塔，其数满八万四千。\n一塔该八万四千，八万四千同一塔。\n八万四千妙吉祥，八万四千妙殊胜。\n愿均吉祥与殊胜，散作寿域无边春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"补陀大士赞","author":"释大观","text":"海天寥泬，海岸孤绝。\n见得亲切，虚空钉橛。\n怒涛舂碎岩前月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远法师陆脩静赞","author":"释大观","text":"一笑相逢，悠然意消。\n植藩篱兮肝胆楚越，外形骸兮鹏鴳逍遥。\n凉襟洒洒兮何须鹤驭之风，别袖翩翩兮不见虎溪之桥。\n此东林六事之一兮，犹可想见其丰标。\n古不可挽，今不可招。\n火生莲花，雪长芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明化惟长老请赞","author":"释大观","text":"为无所为，益无所益。\n和气如春，近傍不得。\n有时崄处少机关，拶倒临济白拈贼。\n以冤报冤，其义不忒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法喜泾长老请赞","author":"释大观","text":"有准绳，无捉摸。\n开口错商量，铁蒺藜确确。\n日冷月热，泾清渭浊，昨夜凤巢生鸑鷟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉赞","author":"释大观","text":"藕窍藏身，不形一缕。\n掀播风云，泽遍大地。\n彼其隐现大小之不同，终莫能逃乎应量之器。\n明眼人前，可贱可贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保福溥长老请赞","author":"释大观","text":"云门普，千钧弩。\n蓦地一发，当阳饮羽。\n冤有头兮债有主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南涧果法师赞","author":"释大观","text":"气和色庄，襟度洋洋。\n雪残春嶂，月午秋江。\n峙凌虚金碧兮增飞来小朵之奇观，发昔人幽潜兮来典午咸和之遗芳。\n或见或闻，意消心降。\n若夫奉己淡薄，接物慈祥。\n不泥文字，不堕平常。\n此所以为北峰之克家，而于自受用三昧中，合乎性具之宗纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拾得收菜滓赞","author":"释大观","text":"一机不副，截断千差。\n瓶泻妙答，缀齿粘牙。\n何如在国清寺里，偷佛饭食菜滓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝诠","author":"释大观","text":"虚空讲得四花飞，大地山河总发机。\n碧眼黄头无处觅，是中元不动唇皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺大渊自资福住白云","author":"释大观","text":"者边飏下舀溪杓，鈯斧又移深处山。\n说与白云门外客，相逢莫作旧时看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栖真身长老请赞","author":"释大观","text":"我无我，柰这个。\n眨得眼，话已堕。\n翻转面皮，放人不过。\n搥碎连城之璧，大肆秦人之祸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莲社图赞","author":"释大观","text":"天运悠悠终典午，竞从庐阜寻归处。\n凿池种藕拟奚为，西山几度看悬鼓。\n爱酒渊明挽不来，贪佛灵运推不去。\n同盟二九姑置之，咄尔而今在何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顽空法师赞","author":"释大观","text":"眼头生角，囊里盛锥。\n驾古轨辙，辟坦路达。\n龙藏忘筌兮揭义天之寥豁，麈尾倒握兮翻辩澜之渺瀰。\n堂堂之陈，正正之旗。\n非其所是，是其所非。\n发老啸之韬略，茂老豁之孙枝。\n迨其涅槃后，有借万象舌兮其谁知之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十三","author":"释大观","text":"饥人贪食良农粟，渴汉错饮蛊家水。\n对面还成千里遥，贼人有智过君子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其十二","author":"释大观","text":"贾勇扬旌无大敌，看看身已陷重围。\n要令夺角冲关去，驾与青龙不解骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其九","author":"释大观","text":"休论凤箭射乌巢，看取虚弓落九包。\n收放若为逃羿手，控弦傍助亦徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其七","author":"释大观","text":"一鼓薰风至自南，再行璧月挂苍杉。\n锦筵公子方沈醉，白雪幽兰空再三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其六","author":"释大观","text":"吹无孔笛，和毡拍版。\n父子和同，冰炭相反。\n末上之机果若何，定州元出花瓷碗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其四","author":"释大观","text":"故园红紫自芳菲，不在春风著意吹。\n待得征人重回首，枝头香雪已纷披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其三","author":"释大观","text":"忽看龙舟压浪飞，鼓声催促笛声悲。\n锦标到手还轻放，转得头来事已非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十七首 其一","author":"释大观","text":"乾坤虽有作，太平本无象。\n赫日正中天，去却脩罗掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其五十一","author":"释大观","text":"荆棘锋刃丛，洞房丝竹里。\n威凤何须住碧梧，卧龙终不鉴止水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其五十","author":"释大观","text":"监本倔强，匙挑不上。\n絷空云蒂补虚空，陆地滔天翻白浪。\n暗中拈出定命竿，鹘眼鹰睛迷向当。\n老和尚为谁没齿更穿龈，从教疑杀天下人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十九","author":"释大观","text":"见见之时，雨洗淡红桃萼嫩。\n见非是见，风摇浅碧柳丝轻。\n见犹离见，白云影里怪石露。\n见莫能及，流水光中古木清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十八","author":"释大观","text":"簸土扬尘，金刚正体。\n七颠八倒，大寂定门。\n排空烟嶂添愁色，著雨林花带泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十七","author":"释大观","text":"春色融融，花气濛濛。\n六窗俱不钥，当处不留踪。\n危栏同遍倚，身在寂寥中。\n几欲全提先漏泄，滑唇黄鸟弄春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五十一首 其四十六","author":"释大观","text":"律非缚，禅非脱。\n蝴蝶梦庄周，周公制礼乐。\n会则事同一家，不会则万别千差。\n一片白云生岭上，几回开了又还遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]