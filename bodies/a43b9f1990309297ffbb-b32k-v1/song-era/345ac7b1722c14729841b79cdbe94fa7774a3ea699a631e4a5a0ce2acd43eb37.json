[{"title":"送日老住九座山","author":"刘克庄","text":"瓶锡飞来方款曲，幡华迎去倏分离。\n草眠毡睡身皆稳，刀割香涂佛岂知。\n守土亲为大檀越，开山留下废砧基。\n直须金碧千间了，却访溪庵亦未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王实之","author":"刘克庄","text":"欲去还留每自怜，竟为吾子著先鞭。\n孤忠尽见万言疏，十口同登一叶船。\n屈法相全烦圣主，上书俱贬愧前贤。\n南归定过西山下，细把行藏告墓阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王实之赴长沙幕","author":"刘克庄","text":"贾傅遗踪在，君于此泛莲。\n不应卑湿地，犹著广寒仙。\n策好人争诵，名高士责全。\n衡山余所管，拟结草鞋缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王南海二首 其二","author":"刘克庄","text":"史氏循良传，儒家果艺科。\n土荒耕老少，海近贩人多。\n古有宁馨语，今无于蔿歌。\n县知新令尹，琴调得民和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王南海二首 其一","author":"刘克庄","text":"昔作翘材客，曾谈执友贤。\n虽无金屋贮，赖有归巢迁。\n此老飞仙去，斯文付嫡传。\n病翁犹未聩，要听武城弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王梅州二首 其二","author":"刘克庄","text":"祸始自三枪，菑犹被一方。\n帝将安渤海，君肯薄淮阳。\n老手何忧斲，新眉尚费妆。\n汉庭褒郡最，蚤晚入为郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王梅州二首 其一","author":"刘克庄","text":"州境与潮邻，徐行止浃旬。\n瘴乡均一气，盐子亦吾民。\n日晏烟岚敛，兵馀户口贫。\n定将田里事，闭閤细条陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邓侍郎","author":"刘克庄","text":"追陪豹尾恰踰年，刘叟安能望邓先。\n圣主忧贤勤召对，诸公祖道羡登仙。\n降庚寅岁虽相似，雌甲辰旬守自怜。\n风雨满天春水阔，不知若个是君船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶士龙归竹林精舍","author":"刘克庄","text":"侍讲开甥馆，三间不至奢。\n少曾居北面，老只住东家。\n野笋庖尤美，深衣衮未华。\n何时寻旧路，去谒玉川茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶士岩二首 其二","author":"刘克庄","text":"向来参请遍诸方，恍惚如痴亦似狂。\n雪与膝平犹未退，斤从鼻过了无伤。\n拈花弟子知谁悟，撼树群儿不自量。\n极欲为君露消息，天寒日短话头长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶士岩二首 其一","author":"刘克庄","text":"曾约还辕访爵罗，几回扫榻伫经过。\n待先生敬虽如此，与老人期柰后何。\n走马看花消许急，杀鸡为黍误侬多。\n吴中故旧还相问，一臂偏枯两鬓皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶制参","author":"刘克庄","text":"闻说秋防急，安危寄阃臣。\n无心致羔雁，有分上麒麟。\n毡帽环吾境，纶巾赖此人。\n晋朝陶庾辈，岂必靠江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶尚书奉祠二首 其二","author":"刘克庄","text":"身于七邑最孤寒，每辱黄堂刮眼看。\n乍可郡无九年蓄，要令民受一分宽。\n公闲去伴种司谏，我懒思寻靖长官。\n曾出龙门称弟子，感知惟有寸心丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶尚书奉祠二首 其一","author":"刘克庄","text":"先生清梦绕林泉，黄纸除书拜地仙。\n报答吾君吾相了，徜徉某水某丘边。\n事光白傅求闲后，衔似温公约史年。\n笑向故山猿鹤说，古来晚节几人全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶尚书赴永嘉二首 其二","author":"刘克庄","text":"曾系金狨扈属车，田间访旧尚勤渠。\n都忘森戟临方岳，但记燃藜共值庐。\n谢守吟来谁继者，洛英老去各何如。\n山林深密江湖远，相见烦公问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶尚书赴永嘉二首 其一","author":"刘克庄","text":"洛蜀纷纷孰是非，孤忠惟上与天知。\n何曾后世无公论，不愿明时有党碑。\n去奉绣帘差足喜，来调金鼎未为迟。\n铃斋一穟柑香起，细听中和乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送叶知郡","author":"刘克庄","text":"家在春风住二年，借侯无路意悽然。\n到来不饮官中水，归去难谋郭外田。\n灯远村民多点塔，担轻津吏易排船。\n壶公亦似追程送，青过囊山古寺前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外弟方时父寄呈□古心相公","author":"刘克庄","text":"一自子猷回棹后，溪边风雪少来宾。\n栎樗吾偶逃天伐，瓜葛君犹访古亲。\n不以痴顽疏此老，绝胜富贵合它人。\n相公留下阳春脚，应念诗翁白首贫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送归善郑主簿","author":"刘克庄","text":"境胜多遗迹，州贫异旧闻。\n雌堂方致士，矮屋可烦君。\n黄放无遐迩，朱勾有惰勤。\n岭民如见问，白首布襦裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送龙岩林主学","author":"刘克庄","text":"官冷君行勿鄙夷，儒风未有盛斯时。\n进青衿子陈新义，为紫阳公广旧规。\n然否听人来议政，尊严无士敢嘲师。\n齑盐堪饱芹堪采，况值文翁适拥麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲白","author":"刘克庄","text":"官舍萧条苇盖檐，拾薪独有一长髯。\n同来社友因饥瘦，远作参军得俸廉。\n国士交情穷乃见，古人诗律晚方严。\n中年各要身强健，别后寒衣切记添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲晦国录赴康州二首 其二","author":"刘克庄","text":"别我暑行三百里，使君此举古今稀。\n班荆不以牙旗从，剪韭都忘草具微。\n浪汩鸢飞毋久住，颍川凤下可遄归。\n未妨黠鬼揶揄笑，专壑专城孰是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲晦国录赴康州二首 其一","author":"刘克庄","text":"帝重南邦妙选抡，徐卿又驾两朱轮。\n龙潜不付茧丝手，蜑俗争看玉雪人。\n五瘴下车如痛痒，二麾负郭尚清贫。\n吾评此去今萧汲，惜不居中牧远民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送仲晦徐监丞","author":"刘克庄","text":"曩岁屡嗟萧补郡，此行稍喜□居中。\n□□□□□□□，清议从来在泽宫。\n未必诸生无郭泰，□□□□□□□。\n遥知共起淹中蕝，不必畦间拾穗翁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘连江之官","author":"刘克庄","text":"旧说土风淳，今闻未易驯。\n势侵官府弱，税去县衙贫。\n襆印辞州远，开轩与海邻。\n中朝峨豸者，多用满归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙季蕃","author":"刘克庄","text":"家在吴中处处移，的于何地结茅茨。\n囊空不肯投笺乞，程远多应税马骑。\n短剑易钱平近债，长瓶倾酒话馀悲。\n衡山老祝凄凉甚，明日无人共讲诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙明府","author":"刘克庄","text":"三年于赤子，摩拊极殷勤。\n令尹留方寸，吾民受一分。\n宛如小滕国，突过大冯君。\n四境风谣美，诸公必采闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙梦宫","author":"刘克庄","text":"大帝开江左，无锥与远孙。\n自言埋战地，也胜活侯门。\n短褐边风紧，孤舟海浪翻。\n知他三尺剑，携去报谁恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宇文倅二首 其二","author":"刘克庄","text":"祖佐文忠幕，初新肃悯祠。\n昔曾瞻古柏，今始识孙枝。\n西鄙方头重，南辕若背驰。\n汉朝如谕蜀，草檄舍君谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宇文倅二首 其一","author":"刘克庄","text":"昔以县为滩，于今倅亦难。\n纵令急符下，且放大弦宽。\n航海船粳白，游山谱荔丹。\n应怜铜墨吏，舒惨在毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庄纠一首","author":"刘克庄","text":"忽枉高轩访，殷勤不忍离。\n虽书督邮考，率在过庭时。\n辩素推三语，清尤畏四知。\n归装无长物，一首后村诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庄知录归觐","author":"刘克庄","text":"彼美佳公子，甘为郡督邮。\n鲤庭素钟爱，乌幕不能留。\n剡上止一鹗，挽回无万牛。\n李官难久旷，来莫待新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送延平邓医","author":"刘克庄","text":"和扁过门千百辈，邓先神妙七闽推。\n非关玉枕方犹閟，自是金篦刮已迟。\n天下岂无书未见，世间唯有老难医。\n绮裘宝马相酬赠，未抵樗翁七字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汤伯纪归番昜","author":"刘克庄","text":"华宗所产必人英，久见诸贤说父兄。\n荀氏晚添文若出，杨家又有敬之生。\n进堪负荷斯文责，退亦流传后世名。\n身老荒村无可恨，独于佳友尚关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汤季庸监岳","author":"刘克庄","text":"季子真奇士，声名亚长君。\n尚难友裘牧，何敢吏朱云。\n江国无生业，沙场有异闻。\n临岐各珍重，世故属纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邢仙游","author":"刘克庄","text":"彼美邢侯者，逢人满口夸。\n有恩沾小户，无势挠公家。\n拔尽民间薤，栽添境内花。\n吾诗采清论，一字不曾加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送伯纪礼部造朝兼简息庵二首 其二","author":"刘克庄","text":"谢遣弓旌久掩关，十年坐阅几蒲团。\n老臣惫不堪将橐，丞相嗔因乞挂冠。\n庙算浑如孤注赌，林栖未保一枝安。\n暮云万叠江闽远，相见除非插羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送伯纪礼部造朝兼简息庵二首 其一","author":"刘克庄","text":"传闻东涧拜南宫，朝野皆忻泰道通。\n不比唐家超子厚，壹如元祐起坡公。\n官箴健论犹当续，雪月浮文不必工。\n十载帝城无点墨，有怀难托北飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送余子寿","author":"刘克庄","text":"去岁与君同聘召，何曾杯酒暂相离。\n兵谋元帅多亲访，心事同官尽得知。\n三釜忽怀归去檄，一枰未了著残棋。\n此生聚散须牢记，记上扬州战舰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送君用侄判官","author":"刘克庄","text":"天官长榜该差久，公相繁机押敕迟。\n佩玉徐行真上介，著鞭先发任群儿。\n方惭当宁询黄发，绝喜吾宗见白眉。\n闻说守侯留祢墨，水衡召拜必同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴时父侍郎二首 其二","author":"刘克庄","text":"十行礼促归荷橐，五朵云飞堕草庐。\n西北战尘锋锐甚，东南民力磬悬如。\n帝开宣室初前席，公忆康山旧读书。\n问讯少君无恙否，衰残久不奉双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴时父侍郎二首 其一","author":"刘克庄","text":"慧灯溥照人幽隐，心秤能权物重轻。\n士子比之常相国，吏民道是蔡端明。\n来时稻蟹非常熟，去日琴龟作伴行。\n安得四方皆结辈，苍黔开眼看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张守秘丞二首 其二","author":"刘克庄","text":"逐客门庭断履綦，时迂小队访茅茨。\n追随雅有蓬山旧，爱助惭无薤水规。\n舆腻岂为名士涴，羊碑长遣后人思。\n安知昭代輶轩使，不向民间采此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张守秘丞二首 其一","author":"刘克庄","text":"斗垒那堪数旱饥，君侯苦节未为非。\n宾筵虽画何尝卜，雩祷于天且不违。\n岁俭粟输仓氏少，郡贫饷入洛阳稀。\n老农夹道攀辕叹，作么携琴载鹤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张应斗还番昜","author":"刘克庄","text":"蕉荔漫山雾雨繁，虬须客子悔南辕。\n久留闽囝谁堪语，却忆番君可与言。\n豪杰虽穷留气在，圣贤不死有书存。\n归时洗换征衣了，拣个深山紧闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李用之察院赴潮州二首 其二","author":"刘克庄","text":"昔在番禺鬻筴时，瞽言不敢计从违。\n固知国有三空患，又欲民无再榷讥。\n箬裹为生尤瘠薄，牙筹所积恐纤微。\n公卿文学方矛盾，应待囊封决是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李用之察院赴潮州二首 其一","author":"刘克庄","text":"乌府名臣暂拥麾，霜棱聊复变春熙。\n行人犹谓骢当避，圣世初无鳄可移。\n粤俗相携看上日，韩祠配食付它时。\n极知不作周南滞，禁闼须君补阙遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李漕用之二首 其二","author":"刘克庄","text":"汉廷盐铁议交攻，有诏姑惟旧法从。\n闻道岭南歌圣主，一如河北感仁宗。\n向舒自是堪王佐，桑孔安知富大农。\n它日公归奉清问，可无鲠论赞烹封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李漕用之二首 其一","author":"刘克庄","text":"斜飞庆历皇华远，捷出熙宁使指新。\n但记欧公更此职，不知赵济是何人。\n剡章遍及孤寒士，奋笔先诛聚敛臣。\n自叹暮年衰飒甚，羡君老手独埋轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨休文","author":"刘克庄","text":"寂寞鳏翁掩县斋，吏传刺字睡惊回。\n自从黄鹤仙人去，谁遣青牛道士来。\n适梦羽衣良有徵，共吟石鼎愧无才。\n殷勤问讯西山老，何日山中伴访梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨彦极提刑二首 其二","author":"刘克庄","text":"绣斧翩翩向福唐，百城敛衽避风霜。\n梦回桑下初何恋，手植棠阴故未忘。\n判笔有神皆可录，抄书无数即行装。\n从今病叟牢扃户，莫望严公访草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨彦极提刑二首 其一","author":"刘克庄","text":"闽蜀相望万里遥，敢图斗垒屈魁杓。\n南州处士蒙殊礼，魏府牙兵不更骄。\n邦伯如今安得结，国人它日会思侨。\n瓣香垂去犹精祷，果有甘霖溉旱苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈僩","author":"刘克庄","text":"建学多通显，何为尚布衣。\n不闻行聘久，始悟设科非。\n落日君寻店，深山我掩扉。\n几时残烛下，重听讲精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邹莆田","author":"刘克庄","text":"日日焚香出，天知令尹心。\n租符环境少，花判入人深。\n发路惟诗卷，般家亦俸金。\n极为乡井惜，不是怆分襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邹景仁","author":"刘克庄","text":"冲寒何处去，新戍尚来年。\n客劝休辞幕，君言已买船。\n霜清江有蟹，叶脱木无蝉。\n若过东林寺，携家往问禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈户曹之官襄阳二首 其二","author":"刘克庄","text":"幕府秋风事日生，参军匹马去兼程。\n起为楚舞何其壮，吟退胡兵在此行。\n且喜岘山碑有跋，不愁江表传无名。\n老儒那复封侯梦，止愿躬耕看太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈户曹之官襄阳二首 其一","author":"刘克庄","text":"丞相曾参督府谋，郎君今复赞边筹。\n彼哉金谷饮长夜，去矣玉关防盛秋。\n尺度岂能拘快士，功名断不在中州。\n习池水满堤花艳，安得相陪赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈使君二首 其二","author":"刘克庄","text":"庞老趋城少，严公出郭多。\n难攀逸民传，堪举力田科。\n夙昔烦驺哄，从今闭雀罗。\n若逢两狨橐，应问一渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈使君二首 其一","author":"刘克庄","text":"博士曾森戟，甘棠爱尚新。\n漫馀受廛叟，获见拜厅人。\n醴酒多延士，蒲鞭不及民。\n一年三易守，无乃送迎频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈叔方侍郎二首 其二","author":"刘克庄","text":"犹记同穿豹尾中，一翻覆手异蛇龙。\n吕侯赐履作方伯，毛颖免冠成秃翁。\n清苦吏人无厚禄，殷勤军将有斜封。\n君归定访耆英社，问讯周南太史公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈叔方侍郎二首 其一","author":"刘克庄","text":"八郡皆知德度宽，缿筒罢设讼堂闲。\n治如清献乖崖样，人在原明子野间。\n岂有珠鱼堪作贡，亦无金鹤可携还。\n暮年腰脚犹顽健，惜不从公看雁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈郎玉汝之官二首 其二","author":"刘克庄","text":"管鲍交三世，朱陈共一村。\n居惭阿承女，获事太丘孙。\n惜别吾钟爱，相宾右格言。\n应怜垂白叟，计日望回辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈郎玉汝之官二首 其一","author":"刘克庄","text":"昔一平津阁，今随孟博车。\n径趋乌幕远，渐向鲤廷疏。\n分袂三年别，平安两字书。\n何时迎昼绣，携酒煮溪鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈郎玉汝赴淮南计幕","author":"刘克庄","text":"台使方求助，征鞍倍道驰。\n君怀翁定省，吾念女伤悲。\n玉塞烽全少，金闺籍未迟。\n暮年怕离别，计日数归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈监簿造朝","author":"刘克庄","text":"君昔闲三纪，朝今聚众贤。\n居然峙鸾鹄，不似袭貂蝉。\n训俭无钗泽，遗忠有笏传。\n将何告明主，事事法隆乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]