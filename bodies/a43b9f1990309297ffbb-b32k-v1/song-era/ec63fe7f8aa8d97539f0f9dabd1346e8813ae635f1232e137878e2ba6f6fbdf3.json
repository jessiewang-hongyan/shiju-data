[{"title":"览照","author":"王禹称","text":"览照笑浮生，秋霜发数茎。\n才高空有气，官散即无荣。\n贫久心还乐，吟多骨亦清。\n他年文苑传，应不漏吾名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺三舍人新入西掖","author":"王禹称","text":"紫微新命旧交游，报到商于寂寞州。\n天上共分三字贵，山中全减贰车愁。\n抛离红药心无恨，弹拂金貂舞不休。\n最喜吾家有馀庆，凤毛还直凤池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺冯起张秉二舍人","author":"王禹称","text":"八年东观知深屈，百日南床祇暂经。\n春暖并吟红药树，云开双见紫微星。\n绣衣脱后休持斧，珠履抛来免过厅。\n应念出官淮水上，被人还笑屈原醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺吕祐之谏议","author":"王禹称","text":"凤阁前年陪步武，麟台昔日是交游。\n先归内署身虽忝，直上高坡命更优。\n玉笋外郎全弃掷，土山果毅免经由。\n却应回笑滁阳守，官似冯唐半白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺毕翰林","author":"王禹称","text":"闻步花砖喜复悲，所悲君较十年迟。\n银台晓入批丹诏，铜镜秋开镊白髭。\n宫锦细袍宣与著，内闲骄马赐来骑。\n家门记得咸通事，莫忘论兵夜召时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺李宗谔先辈除校书郎","author":"王禹称","text":"秘省官清住帝乡，春来春榜探花郎。\n未吟红药归西掖，且著青衫侍北堂。\n射策更期挥健笔，骑驴犹得醉闲坊。\n同年佐邑应相羡，衣上芸香杂桂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺范舍人再入西掖","author":"王禹称","text":"再入承明旧直庐，腰间仍得佩金鱼。\n重批汉武求贤诏，曾上东方自荐书。\n红药篇章应感动，紫泥封检未生疏。\n樊川杜曲休劳梦，日日延英侍玉除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺柴舍人新入西掖","author":"王禹称","text":"早折蟾宫第一枝，纶闱恩命苦何迟。\n久为俗吏殊无味，合掌王言亦有时。\n好继忠州文最盛，应嫌长庆格犹卑。\n他年莫忘中吴宰，六里山前歌紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺将作孔监致仕","author":"王禹称","text":"泣辞明主挂冠簪，便约幽云老旧林。\n朝请罢来频典笏，田园归去只携琴。\n焚香静院当山色，晒药空庭避竹阴。\n一子得官三品禄，未饶疏傅有黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺温正言赐紫","author":"王禹称","text":"密疏封来乙夜看，延英召对议安边。\n荣颁紫绶同三品，旧赐朱衣未一年。\n白兽捧樽斟御酒，金鱼垂鬣惹炉烟。\n从今便有公卿望，休梦天台瀑布泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴长洲县作 其二","author":"王禹称","text":"移任长洲县，辞亲泪满衣。\n折腰虽未免，搔首欲何归。\n晓白霜华重，晴红栗叶飞。\n江头鸥鸟在，应怪不忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴长洲县作 其五","author":"王禹称","text":"移任长洲县，沿流渐入吴。\n见碑时下岸，逢店自徵酤。\n野庙连荒冢，江禽似画图。\n高堂从别后，应梦宿菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴长洲县作 其三","author":"王禹称","text":"移任长洲县，孤帆冒雨行。\n全家随逆旅，一夜泊江城。\n身世漂沦极，功名早晚成。\n惟当泥尊酒，得丧任浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴长洲县作 其一","author":"王禹称","text":"移任长洲县，扁舟兴有馀。\n篷高时见月，棹稳不妨书。\n雨碧芦枝亚，霜红蓼穗疏。\n此行纡墨绶，不是为鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴长洲县作 其四","author":"王禹称","text":"移任长洲县，穷秋入水乡。\n江涵千顷月，船载一篷霜。\n竹密藏鱼市，云疏漏雁行。\n故园渐迢递，烟浪白茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁谓之再奉使闽中","author":"王禹称","text":"绣衣直指东南夷，入奏风谣受圣知。\n持节又从三殿出，演纶还较一年迟。\n朝中谬拜推贤表，江畔空吟惜别诗。\n郡印喧卑文会少，为君搔首落花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送毋殿丞赴任齐州","author":"王禹称","text":"三齐号难治，民瘼待良医。\n勿谓人多诈，须教吏不欺。\n鱼盐多近海，桑柘润连淄。\n御札新颁历，无忘训诫词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送牛学士知润州","author":"王禹称","text":"诏从书殿理江干，江外生民识谏官。\n京口浪花迎棹白，海门山色入楼寒。\n茅君仙洞披图见，张祜诗牌拂藓看。\n他日政成无一事，好吟新句寄长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王司谏赴淮南转运","author":"王禹称","text":"白兽樽前侍玉除，暂分邦计别宸居。\n映淮风月供吟笔，拱极星辰伴使车。\n别岸酒浓桑叶落，野亭霜薄菊花疏。\n东南莫作三年调，红药香繁在直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯学士入蜀","author":"王禹称","text":"锦川宜共少年期，四十风情去未迟。\n蚕市夜歌攲枕处，峨嵋春雪倚楼时。\n休誇上直吟红药，多羡乘轺听子规。\n莫学当初杜工部，因循不赋海棠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史馆学士杨亿闽中迎侍","author":"王禹称","text":"迎侍闽川去路长，才名官职过欧阳。\n翰林贵族誇东榻，史馆清衔庆北堂。\n别酒正逢寒菊绽，归舟应见早梅香。\n拾遗健羡吟诗送，莫笑蹉跎两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史馆赵寺丞出宰咸阳","author":"王禹称","text":"县连秦汉旧离宫，分付诗人胜武功。\n带职远辞书殿去，携家深入画图中。\n庭莎晓润终南雨，槛竹寒摇渭水风。\n百里封疆三馆客，折腰休叹似陶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送交代刘斐裁之大夫","author":"王禹称","text":"祖孙相望百年间，万石遗风庶可攀。\n新咏裤襦传□巷，旧栽桃李满淮山。\n林泉岂易留君住，鱼鸟真□□我闲。\n好纵斋航天上去，郎闱卿寺有虚班。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送光禄王寺丞通判徐方","author":"王禹称","text":"通悴徐方茜绶新，老莱衣服暂离身。\n家君莲幕开厅事，府帅金貂耀缙绅。\n戏马台荒春寂寞，斩蛇乡古树轮囷。\n公馀应长吟滋味，好寄西垣寓直人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送同年刘司谏通判西都","author":"王禹称","text":"元老留司卧雒阳，谏官通理辍鸳行。\n仲宣旧佐红莲幕，裴度新开绿野堂。\n几处古碑停马读，到时春笋约僧尝。\n香山居士真容在，为我公馀奠一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送巡抚侍读吕司谏","author":"王禹称","text":"三十军城百万家，侍臣分命走轺车。\n长春殿里承丹诏，乙夜书边别翠华。\n驻马祇教看垄麦，忧民无暇醉溪花。\n归朝旧友如相问，为道山中学种畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江州孙膳部归阙兼寄承旨侍郎","author":"王禹称","text":"九江为郡鬓成霜，淮海相逢共黯伤。\n放逐翰林同李白，蹉跎郎署是冯唐。\n才名各负诗千首，离别无辞酒一觞。\n归见鳌头如借问，为言枨也减刚肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送严判官归滁州","author":"王禹称","text":"永阳谪宦鬓成华，唯有宾从最可誇。\n文学东堂进士第，风流南国相公家。\n移官我未归丹禁，回棹君今指白沙。\n滁上淹翔虽已久，寺楼山色对琅邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宋澥处士之长安","author":"王禹称","text":"簪笏盈门独纫兰，卧龙潜在八龙间。\n鸰原任说朝贤贵，鹤氅惟称处士闲。\n静按仙经烧大药，狂挨僧壁画遥山。\n老郎见作归休计，分取圭峰并掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张监察通判馀杭","author":"王禹称","text":"郡城潇洒浙江滨，暂辍乘骢慰远民。\n莫放霜威誇御史，且收风景属诗人。\n雪侵楼上迎潮眼，花拥湖中泛月身。\n尽是公馀吟咏处，好飞佳句寄词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李中舍罢萧山赴阙","author":"王禹称","text":"吏隐江东五六年，归时犹恋好山川。\n野僧送别携诗句，瘦马临歧当酒钱。\n吴苑醉逢梅弄雪，隋堤吟见柳垂烟。\n自言更共秋涛约，未舍西兴一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李著作","author":"王禹称","text":"芸阁新衔捧诏归，历阳湖畔拜庭闱。\n已闻爱子披朱绂，犹学婴儿著綵衣。\n饭馈海陵红稻软，鲙擎淮水白鱼肥。\n吾生自失荣亲禄，谩踏花砖入北扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨屯田通判永兴","author":"王禹称","text":"长安弃废比藩方，通理犹宜占省郎。\n入洛才名齐二陆，有唐门户本三杨。\n袖中丹桂家声在，道畔丰碑祖德光。\n莫向公馀寻故第，榛芜难认靖恭坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵察院知朗州","author":"王禹称","text":"郡斋全占五溪云，就养辞权以孝闻。\n重戴旧称秦御史，高堂新授汉封君。\n板舆为别经三载，寿酒先斟满十分。\n我叹今生无此事，赋诗相送泪雰雰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送奉常李丞赴阙","author":"王禹称","text":"江城方话旧，捧诏去长安。\n宦路相逢少，乡情叙别难。\n烟波迷晓渡，风雨动春寒。\n初夏应回首，重期看牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送河阳任长官","author":"王禹称","text":"宰君行李苦萧疏，妻子龙钟尚跨驴。\n醉眼且看花满县，愁颜莫望果盈车。\n头衔新换呼明府，科第元高得校书。\n谁解吟诗送行色，茂陵多病老相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送直馆高正言转运荆湖","author":"王禹称","text":"象笏乌纱谏署荣，运输权重使蛮荆。\n职分三馆图书贵，地辖重湖水石清。\n贪吏望风潜解印，逋民知惠自归耕。\n官曹寂寞冯唐老，多羡乘轺泽国行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送罗著作奉使湖湘","author":"王禹称","text":"使星躔次入长沙，晓别延英去路赊。\n数刻漏中承密旨，几重湖外奉皇华。\n山行马拂湘川石，寺宿僧供岳麓茶。\n回日期君直西掖，当阶红药正开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舍弟赴举因寄两制诸大僚","author":"王禹称","text":"堂上尊亲鹤发垂，十年禄仕不相离。\n何期膝下承颜日，却是山中谪宦时。\n未有重茵如子路，空披綵服学婴儿。\n全家送尔随乡荐，试向朝端献此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柴郎中使高丽","author":"王禹称","text":"初过清明野色繁，柳花榆荚扑轺轩。\n中台应宿郎官贵，外国占星使者尊。\n海水无波分岛屿，扶桑见日认藩垣。\n东夷休请萧夫子，好把诗书问状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑南进士归洪州","author":"王禹称","text":"霜飘枫叶满长郊，家指西山旧结茅。\n访我谪居龙失水，怜君行路鸟焚巢。\n仲尼未免遭儒戏，杨子何烦解客嘲。\n归去豫章泉石好，不知徐孺与谁交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑褒归闽中","author":"王禹称","text":"褒也瓯闽士，文高行益修。\n干名逢诏罢，归计逼亲忧。\n鸥鸟终相狎，公卿谩欲留。\n刺桐花下宅，兰蕨奉晨羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送临清杨可主簿入蜀","author":"王禹称","text":"脱白去焚黄，遥知祖德光。\n墓坟乔木老，襟袖桂枝香。\n回见梅含雪，归逢橘饱霜。\n子云应有宅，为奠草玄堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送南阳李太傅 其一","author":"王禹称","text":"两朝黄阁预弥纶，又策春坊第一勋。\n僧塔旧题前进士，斋坛新拜上将军。\n马衔金勒冲微雪，雁避红旌入断云。\n还似徐州张仆射，御诗相送四方闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送南阳李太傅 其二","author":"王禹称","text":"红旆飘飘夺晓霞，御筵相送出京华。\n仲尼俎豆真儒者，郤縠诗书属将家。\n腰下已悬如斗印，门前看见筑堤沙。\n先朝学士期牵复，待草南阳入相麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送查校书从事彭门","author":"王禹称","text":"佐幕徐方鬓未秋，官升芸阁更风流。\n姓名旧在莺迁榜，诗什重题燕子楼。\n渐有俸钱供药债，应无归梦到渔舟。\n公馀时上台头寺，珠履金貂共胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郝校书从事相州","author":"王禹称","text":"提笔从戎别帝乡，官清兼领校书郎。\n将军幕下红莲媚，诗客袖中丹桂香。\n吟倚旌旗春过雨，醉听刁斗夜含霜。\n金台莫作多时计，非久应归振鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送閤门秦舍人","author":"王禹称","text":"郡印我未解，轺轩君不留。\n相逢都几日，此别又经秋。\n山雪晴犹在，河澌暖渐浮。\n内庭连上閤，早晚共优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送夏侯正言奉使江南","author":"王禹称","text":"百舌关关麦垄青，远山迎马翠如屏。\n禁中已诵相如赋，江外犹看使者星。\n衣拂茶烟寻水寺，枕攲梅雨泊沙汀。\n归期莫过中秋节，侍宴甘泉月满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送夏侯正言襄阳迎亲","author":"王禹称","text":"兰省方雠乙夜书，襄阳迎侍暂脂车。\n挥毫偶未归纶阁，衣锦何妨奉板舆。\n岘首碑前留马足，鹿门山下宿僧居。\n汉皋游女曾相识，应解鸣珰换佩鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送柴谏议之任河中","author":"王禹称","text":"蒲津名郡得名公，谏纸盈箱且罢封。\n红药阶墀曾吐凤，绿莎厅事旧鸣蛬。\n下车首谒重华庙，入境先经五老峰。\n见说丘门诗板在，应教回也继遗踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送秘阁裴都监奉使两浙","author":"王禹称","text":"霏霏梅雨洒船窗，绿荇参差早稻黄。\n捧诏暂辞图籍府，扬帆深入水云乡。\n皇华静宴江楼月，御札闲开野寺香。\n若到苏台人问我，长官重拜紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送秦供奉自商州使鄂渚","author":"王禹称","text":"携家昼锦行，山驿接江城。\n使是皇华贵，人还故国荣。\n离筵青杏小，别夜子规鸣。\n鹦鹉洲边宿，无忘吊祢衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送都官梁员外同年之江南转运","author":"王禹称","text":"月宫同岁取丹枝，次第飞翔侍玉墀。\n出职未吟红药树，转官新入白云司。\n使权繁重虽无暇，曹局清闲合赋诗。\n不似谪官淮水上，鬓毛衰飒咏江蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送密直温学士西京迁葬","author":"王禹称","text":"锦衣西去道何光，卜葬伊川旧钓乡。\n留守开筵亲举白，故人垂泪看焚黄。\n重寻泉石应多感，旋插松楸未著行。\n一月归程如有暇，云间时到读书房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送戚殿丞之任栝苍","author":"王禹称","text":"佐郡海西边，挂帆离兔园。\n远经罗刹石，去近鹡鸰原。\n菊暖秋飞蝶，霜晴夜叫猿。\n老郎方吏隐，应笑市朝喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送淳于中舍悬车侍养","author":"王禹称","text":"悬车东去谢明朝，摆脱簪缨似一毛。\n望苑官清谐侍养，督邮名贱耻徒劳。\n青宫位在他年起，綵服身归此日高。\n我愧无亲尸厚禄，与君书命泪沾袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送第三人朱严先辈从事和州","author":"王禹称","text":"赁船东下历阳湖，榜眼科名释褐初。\n宾职不忧无厚俸，郡斋唯喜有藏书。\n伴吟先买秋江鹤，醒酒时烹晚市鱼。\n廉使多情应问我，为言衰病似相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送馆中王正言使交趾","author":"王禹称","text":"乘轺南下兴何长，大半江山是故乡。\n蛮府好迎天上使，朝贤不为橐中装。\n犀牛出水挨铜柱，飓母扶空卸海樯。\n复命丹墀莫经岁，北门西掖待翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送董谏议之任湘潭","author":"王禹称","text":"依依行色满帆樯，又借仁风惠远方。\n暂去长沙非贾谊，犹虚计相待张苍。\n槛前波浪潇湘阔，雨后汀洲橘柚香。\n翰苑放臣知最幸，愿听民讼继甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谭殿院之任南阳","author":"王禹称","text":"大抵人生乐故居，山川况复汉南都。\n别来坟墓有宿草，归去田园多绿芜。\n银印莫羞双鬓白，锦衣兼照两轓朱。\n西垣衰病无憀客，空羡此行歌裤襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送融州任巽户曹","author":"王禹称","text":"御前曾取好科名，一掾如何万里行。\n身落蛮夷人共惜，罪因文学自为荣。\n吏供版籍多鱼税，民种山田见象耕。\n君看咸通十司户，投荒终久是公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鞠评事宰兰溪","author":"王禹称","text":"东下兰溪数十程，几多山水入图经。\n科名旧捷仙人桂，县界遥看婺女星。\n琴院静笼江树绿，敕楼高对海峰青。\n三年吏隐无嗟叹，百里封疆似画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜寄罗评事同年 其三","author":"王禹称","text":"郡僚方贺正，独宿太湖棱。\n阶下羞为吏，船中祗载僧。\n折梅和薄雪，煮茗对孤灯。\n应笑排衙早，寒靴踏晓冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]