[{"title":"次韵文潜立春日三绝句 其一","author":"黄庭坚","text":"眇然今日望欧梅，已发黄州首更回。\n试问淮南风月主，新年桃李为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王稚川客舍二首 其二","author":"黄庭坚","text":"身如病鹤翅翎短，心似乱丝头绪多。\n此曲朱门歌不得，湖南湖北竹枝歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王稚川客舍二首 其一","author":"黄庭坚","text":"五更归梦常苦短，一寸客愁无奈多。\n慈母每占乌鹊喜，家人应赋扊扅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其十","author":"黄庭坚","text":"学似斲轮扁，诗如饭颗山。\n室中馀一剑，无气斗牛间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其六","author":"黄庭坚","text":"佳人斗南北，美酒玉东西。\n梦鹿分真鹿，无鸡应木鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其九","author":"黄庭坚","text":"半菽一瓢饮，悬鹑百结衣。\n萧条鬼不瞰，聊可与同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其二","author":"黄庭坚","text":"万木霜摇落，山呈斧凿痕。\n痴蝇思附尾，警鹤畏乘轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其三","author":"黄庭坚","text":"日短循除庑，溪寒出臼科。\n官居图画里，小鸭睡枯荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其一","author":"黄庭坚","text":"什袭发硎刀，无名自贵高。\n秋衣犹葛制，午饭厌溪毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其八","author":"黄庭坚","text":"茵席絮剪茧，枕囊收决明。\n南风入昼梦，起坐是松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其四","author":"黄庭坚","text":"眼看人换世，手种木成阴。\n藏拙无三窟，谈禅剧七禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老十小诗 其七","author":"黄庭坚","text":"斲鼻昔常尔，绝弦知者稀。\n无人与争长，惟有钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵向和卿行松滋县与邹天锡夜语南极亭二首 其二","author":"黄庭坚","text":"冲风冲雨走七县，唯有白鸥盟未寒。\n坐中更得江南客，开尽南窗借月看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵向和卿行松滋县与邹天锡夜语南极亭二首 其一","author":"黄庭坚","text":"雪泥滑滑到山郭，提壶劝沽亦不恶。\n林中解道不如归，家人应念思归乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李士雄子飞独游西园折牡丹忆弟子奇二首 其二","author":"黄庭坚","text":"桃李阴中五兄弟，扶将白发共传杯。\n风吹一雁忽南去，空得平安书信回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李士雄子飞独游西园折牡丹忆弟子奇二首 其一","author":"黄庭坚","text":"西园春色才桃李，蜂已成围蝶作团。\n更欲开花比京洛，放教姚魏接山丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵杜仲观二绝 其一","author":"黄庭坚","text":"短舞朱裙惬醉看，惜公官守隔江干。\n遥怜得句无人赏，走马城东觅道安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵杜仲观二绝 其二","author":"黄庭坚","text":"诗家二杜见仍云，佳句风流照映人。\n青眼向来同醉醒，白头相望不缁磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨君全送春花","author":"黄庭坚","text":"化工能斡大钧回，不得东君花不开。\n谁道纤纤绿窗手，磨刀剪綵唤春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵奉答南山禅师二颂兼呈琦上人 其二","author":"黄庭坚","text":"南山四至分明也，一日元来十二时。\n两个泥牛齐著力，矛头淅米剑头炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵奉答南山禅师二颂兼呈琦上人 其一","author":"黄庭坚","text":"鱼吼钟鸣索饭钱，牧牛耕种别人田。\n淮师收得祖关在，一笛操江月满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐文将至国门见寄二首 其二","author":"黄庭坚","text":"千头剖蚌明珠熟，百尺垂丝鲙缕长。\n柳下石门君有此，可能冲雪厌清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐文将至国门见寄二首 其一","author":"黄庭坚","text":"槐催举子著花黄，来食邯郸道上粱。\n便欲扫床悬麈尾，正愁喘月似灯光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵钱德循鹿苑滩舣舟有作","author":"黄庭坚","text":"鹿苑滩头秋月明，使君辍棹爱江清。\n尘埃一段思归路，已听荆州渔鼓鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喜陈吉老还家二绝 其二","author":"黄庭坚","text":"夜寒客枕多归梦，归得黄柑紫蔗秋。\n小雨对谈挥麈尾，青灯分坐写蝇头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喜陈吉老还家二绝 其一","author":"黄庭坚","text":"公庭无事吏人休，垂箔寒厅对弈秋。\n催织青笼篘白酒，竹炉煨栗煮鸡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游景叔闻洮河捷报寄诸将四首 其四","author":"黄庭坚","text":"遥知一炬绝河津，生缚青宜不动尘。\n付与山河印如斗，忍为鼠子腹心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游景叔闻洮河捷报寄诸将四首 其三","author":"黄庭坚","text":"汉得洮州箭有神，斩关禽敌不逡巡。\n将军快上屯田计，要纳降胡十万人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游景叔闻洮河捷报寄诸将四首 其二","author":"黄庭坚","text":"中原日月九夷知，不用禽胡衅鼓旗。\n更向天阶舞干羽，降书剩破一年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵游景叔闻洮河捷报寄诸将四首 其一","author":"黄庭坚","text":"千仞溪中石转雷，汉家万骑捣虚回。\n定知献马胡雏入，看即称觞都护来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答马中玉三首 其三","author":"黄庭坚","text":"仁气已蒸全楚尽，同云欲合暮江前。\n争春梅柳无三月，对雪樽罍属二天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答马中玉三首 其二","author":"黄庭坚","text":"卷沙成浪北风颠，衔尾千艘不敢前。\n匝岸水居皆有酒，行人得意买江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答马中玉三首 其一","author":"黄庭坚","text":"雨入纱窗风簸船，菊花过后早梅前。\n锦江春色熏人醉，也到壶中小隐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答少章闻雁听鸡二首 其二","author":"黄庭坚","text":"朝士闻鸡常半途，朱门拥被不关渠。\n秦郎五起听三唱，残烛贪传未见书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答少章闻雁听鸡二首 其一","author":"黄庭坚","text":"平生绝少分甘处，身要从师万事忘。\n霜雁叫群倾半枕，梦回兄弟綵衣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答邵之才","author":"黄庭坚","text":"文章真向古人疏，聊有孤怀与世殊。\n陋质不堪华衮赠，可能薏苡似明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢公定王世弼赠答二绝句 其二","author":"黄庭坚","text":"酒因咀嚼还知味，诗就呻吟不要工。\n王谢风流看二妙，病夫直欲卧墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f796