[{"title":"再次韵四首 其二","author":"陈造","text":"翰墨场中对抗旌，黄陈一笔万钧轻。\n武安屋瓦秋鼙震，湘水波光夜月晴。\n沮洳求鱼真自笑，渚涯向若倍驰情。\n吾生恨落任公后，不见投纶掣海鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其三","author":"陈造","text":"尸祝代庖良过矣，即今坐啸免嘲讴。\n陶朱计食鱼万尾，景略有儿牛十头。\n甫里过从劳梦寐，辋川归去忌迟留。\n大弨一弛吾通袖，冷看逢蒙中射侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵四首 其四","author":"陈造","text":"韵语联翩到浚旌，楚珩非重夜光轻。\n吟成品物回春态，诵处东风放晓晴。\n抖擞锦囊娱我老，涤除愁斛见君情。\n固应诗胆骜无本，刺手霜牙摩怒鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵自诳简宾王二首 其二","author":"陈造","text":"庾郎胸次枉堆愁，冯衍才名迄不投。\n归去来兮岁华晚，末如何矣鬓毛秋。\n令威心事千年鹤，张翰生涯一叶舟。\n回首月堂金谷梦，却怜海蜃结飞楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵自诳简宾王二首 其一","author":"陈造","text":"鱼避清澄鸟爱昏，陶翁归计酒盈樽。\n山田雨足鸠呼妇，篱院春深竹有孙。\n百首旋编新赋咏，三生犹忆旧精魂。\n小摩他日红尘眼，闲送蜚云过海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵后篇戏朱 其二","author":"陈造","text":"似闻新酝敌宜城，想对檐花又独倾。\n别乘工为海鲸吸，广文当念露蝉清。\n投醪频遣春浮颊，盗印宁无夜闯营。\n约束长须牢闭户，瓮间防有毕先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵后篇戏朱 其一","author":"陈造","text":"淙淙雨势欲沈城，衮衮辞源亦对倾。\n辟户浑疑云气近，诵诗如在玉壶清。\n射知猿臂须穿札，陈怯鱼丽且闭营。\n只把两君新句法，为歌丰乐诏诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵呈张守","author":"陈造","text":"使君刘白信其朋，笑我顽然粥饭僧。\n打睡正便檐日煖，味诗还喜蔗浆凝。\n破阴风软梅犹小，弄影云疏月渐升。\n一自藏钩得新句，莫停吟笔到烧灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵呈张守 其一","author":"陈造","text":"乌衣雏燕正依栖，又见南风递赤泥。\n宣室殊恩子夜对，天章清问御书题。\n可无上药蠲民瘼，有待司南觉世迷。\n好在论功继皋益，毋庸问管渎曾西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵呈张守 其二","author":"陈造","text":"朋旧携持过陋栖，炊香瀹雪鲙拖泥。\n酒浇礧磈聊娱老，诗愬酸寒最切题。\n种秫集功今有约，对棋销日不嫌迷。\n千奴别去平安否，时欲拿舟甓社西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵呈章守","author":"陈造","text":"吾儒交贺得宗师，片善盱衡置百非。\n小驻锋车宣室召，时观谭麈頖宫挥。\n诗坛已许公馀论，邻烛何曾靳寸辉。\n此意急须笺阿衮，不因鱼稻久忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵张德恭二首 其二","author":"陈造","text":"平日疏愚但意行，每从师友仰高明。\n如君况是庭兰秀，向我防讥冻芋萌。\n柏悦悬知待松茂，渭流终不溷泾清。\n新诗应敌才馀事，纸价于今贵列城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵张德恭二首 其一","author":"陈造","text":"公家父子书林杰，力探希微析混茫。\n膝上风流识文度，鯈游领解契蒙庄。\n六花阵势容摩垒，五凤规模见肯堂。\n自叹吾儿豚犬尔，祇宜耕牧守穷乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵复文炳","author":"陈造","text":"君犹芹泮老宾朋，我似房公再世僧。\n烟径幽寻春澹沲，月窗冷语夜澄凝。\n人情感旧多为祟，酒盏浇愁更计升。\n笑命棋枰同永夜，旋添萁火上篝灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵送张守 其四","author":"陈造","text":"性资凉踽系时轻，青眼惟公底里倾。\n砥柱颓波储硕望，阳春穷谷见高情。\n青冥蜚上应回首，陆续诗来可待盟。\n念我老无当世意，拟从樵牧寄馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵送张守 其三","author":"陈造","text":"唾壶声里晚凉轻，风自虚徐月自倾。\n诗好要从知者道，格高今识古人情。\n三熏谁定分膏馥，十袭吾方守诅盟。\n预恐幽居念离索，时须开卷慰愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵送张守 其二","author":"陈造","text":"未解州符累已轻，辞源满意酒边倾。\n颉颃前辈真无愧，褒拂迂儒每过情。\n老境更堪听别语，书邮当复固齐盟。\n吴山正合供酬唱，安得风前两翼生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵送张守 其一","author":"陈造","text":"目送归帆风翮轻，赠诗还笑字攲倾。\n如公风义仍知己，计我隆污合用情。\n想觐龙颜新得意，未忘牛耳旧同盟。\n周旋尚可诸公后，肯放江湖了此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答节推二首 其二","author":"陈造","text":"亏成久不挠心旌，老阅人间百事轻。\n却笑平生甘淡薄，每缘行乐问阴晴。\n羽觞饧粥同春事，卧醉行歌见俗情。\n击钵更遭强敌困，可能赤手控奔鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答节推二首 其一","author":"陈造","text":"透幕穿帘香雾浮，行云低影傍清讴。\n游人是处歌鼓腹，佳客伴翁吟掉头。\n令节可孤三日醉，归期犹有一春留。\n诗坛酒会容先歃，莫问将军老不侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答许节推二首 其二","author":"陈造","text":"步屧巉岩屏骑旌，松风茵露为谁轻。\n已无桃李擅春事，忽有鸟乌啼晚晴。\n羽客不妨同水厄，宿酲端解败诗情。\n开缄又拜同寮赐，锦段中含掉尾鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答许节推二首 其一","author":"陈造","text":"起依筇竹似桴浮，改就新词却自讴。\n囊锦斩关聊袖手，酒兵推户且扶头。\n东风已拆红踯躅，碧树更啼黄栗留。\n醒醉醉醒殊未沬，不应通守羡通侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答陈居仁二首 其二","author":"陈造","text":"丁年也办刺天蜚，几梦西垣与北扉。\n未簉时英书汗简，已烦溪友寄当归。\n桑榆境界宁辞冷，芹藻杯盘可得肥。\n说似故人应绝倒，衰颜五十盍知非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答陈居仁二首 其一","author":"陈造","text":"篱菊擎霜又著花，插花犹记醉君家。\n两州札翰虽频寄，一笑班荆迄未涯。\n酒处赋成千载计，床头易熟数年加。\n珠玑属我元无踵，坐想挥毫写物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答程帅高机宜四首 其三","author":"陈造","text":"高郎笔势未姑徐，千纸珠玑欬唾馀。\n春兴漂萧陵野马，夜窗清绝冰金蜍。\n诸公交口传黄绢，蜚诏褒贤定赤车。\n亦使穷山拜嘉惠，衰翁击节正冯虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答程帅高机宜四首 其二","author":"陈造","text":"名德谁今挺古风，人嗟汲直合居中。\n挥毫有物鬼落胆，与世无心云度空。\n倚听金銮拜新渥，又烦竹马走群童。\n贝宫风露鳌峰月，行矣辉华映两瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答程帅高机宜四首 其一","author":"陈造","text":"自分迂愚著海滨，诸公荐力漫忱恂。\n摧颓晚境空多感，局缩穷山亦再春。\n故里归耕虽有约，中田敬馌遂无人。\n何由消破愁千斛，甓社春浓莫计巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵答程帅高机宜四首 其四","author":"陈造","text":"倒海翻湖袖手观，揆子才思坐天悭。\n愁攻心折仍无赖，债压头低不办还。\n坐想赓酬联白璧，祇令翘企仰高山。\n拙疏却喜便衰病，赢得萧斋尽日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵谢张守得新居","author":"陈造","text":"得巢归翼惬卑栖，尚卷风茅落冻泥。\n病树缘阶旋培植，旧书堆案细签题。\n地非新野聊龙卧，人似东屯剩客迷。\n身世只今供冷笑，百川东注月行西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵谢惠诗 其二","author":"陈造","text":"小家茨竹即为堂，暇访深林索豫章。\n平日床头但周易，看人笔落便灵光。\n庳隆赋质嗟多样，良楛论材要当行。\n莫向黔娄问奇货，长沙舞袖可能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵谢惠诗 其一","author":"陈造","text":"百镒籯金数仞堂，何如盥手颂佳章。\n夺胎信自非凡剂，献佛当知便放光。\n斤运向来车合辙，影斜还惜雁分行。\n衰年离绪谁禁得，镜里新丝莫计长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵酬俞君任","author":"陈造","text":"闯首亨衢属壮年，即今奔骛恐徒然。\n时情合退羊肠步，宦路难加马腹鞭。\n朱紫浪惊流俗眼，风骚要拍古人肩。\n归休计办君当贺，儿辈新营种秫田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠张德恭 其二","author":"陈造","text":"辞锋森列看分朋，退作穷山苦行僧。\n每读严诗惊我倒，亦知舜绩待公凝。\n丝纶指日从天下，阊阖摩霄接武升。\n更想班衣奉亲寿，五云低护九枝灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠张德恭 其一","author":"陈造","text":"老寻诗法得良朋，转处骊珠悟后僧。\n帝所宫商中夜奏，仙盘沆瀣未秋凝。\n乐天不幸逢元稹，季友而来有彦升。\n交手当家亲父子，为君别本记传灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠张德恭 其三","author":"陈造","text":"闯门不乏远方朋，辟席浑如问话僧。\n笔底烟云无尽藏，谭间霜霰不寒凝。\n身行建德欢谣里，人在春台瑞日升。\n老子生涯漫訾省，拥书犹傍短檠灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠张德恭 其四","author":"陈造","text":"同门谁定肯论朋，拙似苕鸠懒似僧。\n病减不辞诗语拙，归来少贷客愁凝。\n老欺鬓发丝千丈，籴仰官仓日五升。\n台閤中天清梦断，分眠山店问渔灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠俞德瑞 其一","author":"陈造","text":"珠轩绣毂辗香尘，回首西湖罗绮春。\n便合行歌访花柳，可辞买笑费金银。\n清吟自属当千客，劝醉那无第一人。\n肯学孤山旧居士，平生诗酒祇僧邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠俞德瑞 其三","author":"陈造","text":"襟袂犹缁客路尘，攀追强踏帝城春。\n落身穷僻才全璧，敌己游从半佩银。\n枉却近臣开荐口，颇尝内地著痴人。\n君看捉笔青灯夜，得句欢呼聒四邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠郭高叔","author":"陈造","text":"知君诗价旧连城，不作渠侬苦瘦生。\n血指有人惭妙斲，空弮如我合输平。\n珠同鱼目曾非匹，鼓过雷门定见轻。\n久已传抄呼阿买，陶编可复置闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠高宾王二首 其二","author":"陈造","text":"虞卿与世得穷愁，枘凿方圆岂易投。\n政复有文衙屈宋，须防罪我坐春秋。\n千株已种柴桑菊，万斛空横野渡舟。\n可惜玉堂挥翰手，独缘羁旅赋登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵赠高宾王二首 其一","author":"陈造","text":"尘外高人谢宦昏，生全天爵哜衢樽。\n逸民佳传须银笔，常侍流风见耳孙。\n入洛真能折伧父，浮湘更欲吊英魂。\n男儿有志轻万里，辟世何如金马门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游虎丘二首 其二","author":"陈造","text":"令节携壶客，当年伏虎山。\n诗成云气上，人语画图间。\n官作三年住，时须半日闲。\n从今碧眼老，几送醉中还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游虎丘二首 其一","author":"陈造","text":"阖庐归骨地，僧宇庇高丘。\n又趁能诗伴，来为吊古游。\n英雄馀幅纸，岁月莽东流。\n未解山前客，相逢更说愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵呈杨侍郎","author":"陈造","text":"左符得请未逾年，民誉朝评两蔼然。\n补衮工夫旧荷橐，承流政绩暂蒲鞭。\n周衡可迓须分陕，孔室容窥顾及肩。\n侧伫翘材著枚叟，看公亲反汶阳田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠泽卿商卿道旧三首 其三","author":"陈造","text":"过眼纷纷更问为，幽人生死况能齐。\n海桑恐碍日车辙，宸极劣为天磨脐。\n臧谷君方堕书蠹，研桑我亦笑醯鸡。\n晚知战胜轻千乘，悔厌晨盐与暮齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠泽卿商卿道旧三首 其二","author":"陈造","text":"隆污非是莫端倪，瞢蹈觞深试汩齐。\n荆璞笑渠忘卫足，坞金何策赎然脐。\n悠悠塞上悲亡马，断断尸乡丛养鸡。\n可是世纷吾屑去，平生结习晚吹齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠泽卿商卿道旧三首 其一","author":"陈造","text":"一昨西风散马蹄，肯如接淅去东齐。\n人家炊玉香馥鼻，禾垄如云高过脐。\n饮隽不无惊渴虎，醉归同约候鸣鸡。\n二卿好客家声在，遮莫茅柴荐韭齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同高叔不愚如晦饮再次韵二首 其二","author":"陈造","text":"珠帘深里按金丝，幻出扬州杜牧诗。\n共引玻璃扶窈窕，更烦侧理写瑰奇。\n一欢有约能如愿，四者求并每后时。\n却念少陵从郑老，得钱沽酒话襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同高叔不愚如晦饮再次韵二首 其一","author":"陈造","text":"诗老掀髯吟掉头，红妆间坐眼波秋。\n快倾良夕如渑酒，宛是当时锁燕楼。\n想有疏帘窥白下，可无急鼓衮伊州。\n凭君更挽刘师命，宽破三年烂熳游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圩上","author":"陈造","text":"小村山影里，山脚水明沙。\n春事初移柳，人家未摘茶。\n生儿了门户，馔客有鱼虾。\n笑我尘埃者，奔驰鬓易华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壮观亭为真州作","author":"陈造","text":"频年入梦此跻攀，骤觉平时气象还。\n吴客到应忘月观，淮乡胜不数平山。\n飞檐曲槛霄霏处，叠嶂横江几席间。\n见说能诗好宾主，风雷落笔每乘闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚言怀 其一","author":"陈造","text":"病在岁云除，相羊小石渠。\n连朝无出日，进药止观书。\n旧苦将迎困，新惭诵说疏。\n官曹不事事，世恐诮相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚言怀 其二","author":"陈造","text":"纸屋酣春意，霜空凝冻云。\n甘违酒伴约，稍策睡乡勋。\n寂寂观腾踔，堂堂敛放纷。\n冥心得今我，回首谢前闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚言怀 其三","author":"陈造","text":"雀响初防雪，鸦骄恐报晴。\n徒妨一老梦，莫究二虫情。\n虚籁吹群动，洪炉寄短生。\n只今观物化，未替白鸥盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"托人卖马二首 其二","author":"陈造","text":"闲人徐步觉优游，马似羞贫意不留。\n久厌短衣随射虎，更怜匣剑佩耕牛。\n楚山好处聊双屩，淮水生时办一舟。\n如子长才当柄用，伫看干旆拥鸣驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"托人卖马二首 其一","author":"陈造","text":"伴我山城惯崄巇，长因马健感吾衰。\n三年粗了痴儿事，并日犹嗟灶妇炊。\n会见千金市龙种，可能一笑换蛾眉。\n还家劣有枯藤在，神驾尻轮得自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早步湖上","author":"陈造","text":"忽忽京尘渍客衣，正须轩旷一伸眉。\n独行初日葱茏处，不待游人杂遝时。\n鱼乐暗摇亭树影，风轻闲弄水云姿。\n因循又耐箫歌聒，早晚湖山细入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次丁嘉会韵二首 其二","author":"陈造","text":"尘里清风忽满襟，诗成正始识遗音。\n才轻馀子今文举，气压诸豪复季心。\n棋罢蜡灯衔烬暗，酒阑庭树挟霜吟。\n百年衮衮须今夕，岁晚鸥盟要重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次丁嘉会韵二首 其一","author":"陈造","text":"倦驻频题醉后襟，离群自叹阙知音。\n卜邻未暇论前约，著语聊须慰此心。\n小挽归轩清夜饮，忆尝对卧白头吟。\n中年畏别犹轻别，添我霜毛又几寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次儿辈戏商卿设醴韵二首 其二","author":"陈造","text":"将命长须脚未移，联翩客马已来齐。\n菊花旋采浮云液，罗幕宽围护麝脐。\n醉里有诗皆虎凤，区中无物不虫鸡。\n主宾等是龙津客，未分金鳞卧瓮齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次儿辈戏商卿设醴韵二首 其一","author":"陈造","text":"水豢山肤自土宜，况邀从事到青齐。\n宾筵大嚼宁虚口，灶妇深颦想噬脐。\n烂醉岂无醒酒鲙，明朝重阅不鸣鸡。\n扶头更忆松江晓，旋买鲈鱼薤捣齑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次日再次韵三首 其二","author":"陈造","text":"微吟缓步惬晴沙，聊谢愔愔载妇车。\n时遣贳貂村店酒，回思缚虎长官衙。\n春山好著屏中色，吟笔谁添锦上花。\n不妨习池风月主，只今何处问诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次日再次韵三首 其一","author":"陈造","text":"山行风色怒飞沙，山末屯云涌炮车。\n伏轼不容同蝶梦，问炊犹可趁蜂衙。\n龟鱼泛渌熹晴日，草树留春著晚花。\n暮憩自怜尘满面，五浆先馈定谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]