[{"title":"夜饮","author":"姜特立","text":"风高霜挟月，酒暖夜生春。\n一曲清歌罢，华胥有醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居室","author":"姜特立","text":"居室要须存野意，不求轮奂炳丹青。\n王侯第宅他崇贵，麋鹿山林我性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚申春再得奉祠","author":"姜特立","text":"香火缘深宦意灰，十年萧散卧蒿莱。\n庞公从此不入市，只与渔樵相往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"废桑畦种花 其二","author":"姜特立","text":"种花真濩落，曾不救号寒。\n我自金芍药，从渠黑牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其一 安坻","author":"姜特立","text":"规创仙舟傍水涯，搜名揭榜号安坻。\n于今措足如平地，无复风波十二时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其三 西望","author":"姜特立","text":"江山静处远红尘，出郭肩舆意自真。\n西望市喧声合处，中间几个是閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其六 秀野","author":"姜特立","text":"坡仙独乐赋新诗，秀野于公两得之。\n山卉名花同一囿，调元妙手本无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其九 细香","author":"姜特立","text":"翠茎绿荫散高冈，老气峥嵘耐雪霜。\n不独清虚符有德，紫绷才脱便馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其八 鸥渚","author":"姜特立","text":"归来林下久忘机，表里虚明更不疑。\n俯仰自知无愧怍，此心何止白鸥知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其二 娱老","author":"姜特立","text":"老来何事可娱嬉，堂枕崔嵬瞰绿漪。\n自有山光并水色，不须花貌与蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其四 数花","author":"姜特立","text":"横身障簏又何痴，睡听朝鸡欲晓时。\n唯有先生无一事，偶来閒坐数花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其七 霜馀","author":"姜特立","text":"龟壳浮游不问津，壶中日月自长春。\n向来橘隐商山乐，今日中间添一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林和叔山园九咏 其五 霞隐","author":"姜特立","text":"流水桃花几换春，花溪溪上好栖真。\n此中自有神仙伴，不是秦时避世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦乐","author":"姜特立","text":"人生苦乐与俱生，不问侯王及庶氓。\n万事随缘安乐法，莫求好处一边行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热","author":"姜特立","text":"老人气血少，日夜遭煎煮。\n点检槁形骸，能禁几寒暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅龙涎巧石 其二","author":"姜特立","text":"甲蠡浅俗枣仍昏，沉水龙涎气最芬。\n敢望凝香如燕寝，竹炉聊欲试氤氲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诞日戏作亦可以瑞鹧鸪歌之","author":"姜特立","text":"梅山诞日簇觥筹，更挟娉婷共胜游。\n此去只求閒富贵，人生须是老风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼燕","author":"姜特立","text":"拍岸鱼遗子，排檐燕引雏。\n有生俱有欲，情爱岂其无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":37574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"养鸡抱犊摩诘语也戏广其说","author":"姜特立","text":"云里养鸡非是达，山头抱犊未为真。\n何如老奉閒香火，醉卧林间了此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f8