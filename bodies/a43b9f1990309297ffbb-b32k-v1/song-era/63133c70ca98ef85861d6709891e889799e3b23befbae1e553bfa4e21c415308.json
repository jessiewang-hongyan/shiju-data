[{"title":"高邮别秦观三首 其一","author":"苏辙","text":"濛濛春雨湿邗沟，篷底安眠昼拥裘。\n知有故人家在此，速将诗卷洗闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扇","author":"苏轼","text":"团扇经秋似败荷，丹青彷佛旧松萝。\n一时用舍非吾事，举世炎时奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧","author":"苏轼","text":"一钵即生涯，随缘度岁华。\n是山皆有寺，何处不为家。\n笠重吴山雪，鞋香楚地花。\n他年访禅室，宁惮路歧赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马子约送茶，作六言谢之","author":"苏轼","text":"珍重绣衣直指，远烦白绢斜封。\n惊破卢仝幽梦，北窗起看云龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘蔗","author":"苏轼","text":"老境于吾渐不佳，一生拗性旧秋崖。\n笑人煮箦何时熟，生啖青青竹一排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢人送墨","author":"苏轼","text":"墨月黳云脱太清，海风吹上笔头轻。\n琐窗冷透芙蓉碧，定有新明到九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送竹香炉","author":"苏轼","text":"枯槁形骸惟见耳，凋残鬓发只留须。\n平生大节堪为底，今日灰心始见渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村二首 其一","author":"苏轼","text":"野水开冰出，山云带雨行。\n白鸥乘晓泛，黄犊试春耕。\n地僻民风古，年丰米价平。\n村居自潇洒，况有读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江村二首 其二","author":"苏轼","text":"野老幽居处，成吾一首诗。\n桑枝碍行路，瓜蔓网疏篱。\n牧去牛将犊，人来犬护儿。\n生涯虽朴略，气象自熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送玉面狸","author":"苏轼","text":"北距飞狐信未通，夜来缚到藁街东。\n千年妖幼谁家妇，一国蒙茸无是公。\n丘首可怜迷故土，帝羓空用起腥风。\n长缨俘献埋轮使，未问豺狼问此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿叔文","author":"苏轼","text":"烨烨苍龙宿，腾光射斗杓。\n嘉时钟间气，○契在丛霄。\n感会风云际，承恩雨露朝。\n史才资笔削，使指载歌谣。\n十载霜威重，连○弊俗消。\n赐环归画省，鸣玉率英寮。\n典礼还咨伯，寅○合佐尧。\n谠言文石陛，正色紫宸朝。\n共说门阑喜，谁云天路遥。\n一龙今在沼，三凤并仪○。\n道在须调鼎，谋深鄙○貂。\n高情真邈邈，逸气更飘飘。\n仙果虽迟熟，灵椿信后凋。\n东山何足羡，会是蹑松乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潮中观月","author":"苏轼","text":"璃玻千顷照神州，此夕人间别是秋。\n地与楼台相上下，天随星斗共沉浮。\n一尘不向山中住，万象都从物外求。\n醉吸清华游碧落，更于何处觅瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献寿戏作","author":"苏轼","text":"终须跨个玉麒麟，方丈蓬莱走一巡。\n敢献些儿长寿物，蟠桃核里有双仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舒啸亭","author":"苏轼","text":"揽胜雷山舒啸亭，诸峰秀拱透云程。\n啸傲池边红日伴，舒怀岩壑白云迎。\n满目纵观天际迥，一腔收拾岁寒清。\n松花香遍银阳地，剩把新诗壮此行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿资福院","author":"苏轼","text":"月明写炤寺林幽，最是江湖入念头。\n衣染炉烟金漏迥，茶烹石鼎玉蟾留。\n山星几点躔官舍，僧院百年过客舟。\n封事未投圣主意，长安此夕亦多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金沙台","author":"苏轼","text":"雨后东风渐转和，扣门迁客一经过。\n王孙采地空圭璧，长者芳声动薜萝。\n正尔谪居怀北阙，聊同笑语说东坡。\n山林台阁原无异，促席论心酌叵罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈公园","author":"苏轼","text":"春池水暖鱼自乐，翠岭竹静鸟知还。\n莫言叠石小风景，捲帘看尽铜官山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题双楠轩","author":"苏轼","text":"南轩前头两佳木，先生抚玩常不足。\n尤爱薰风五月初，白银花开光照屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中邀李范庵过天竺寺作 其一","author":"苏轼","text":"步来禅榻畔，凉气逼团蒲。\n花雨檐前乱，茶烟竹下孤。\n乘闲携画卷，习静对香垆。\n到此忽终日，浮生一事无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中邀李范庵过天竺寺作 其二","author":"苏轼","text":"老禅趺坐处，疏竹翠泠泠。\n秀色分邻舍，清阴覆佛经。\n萧萧日暮雨，曳履绕方庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安老亭诗","author":"苏轼","text":"桥下幽亭近水寒，倩谁○字在楣端。\n市廛得此尤堪隐，老者于今只自安。\n饭后徐行扶竹杖，倦来稳坐倚蒲团。\n眼明能展钟王帖，绝胜前人映雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王晋卿画","author":"苏轼","text":"两峰苍苍暗石壁，中有百道飞来泉。\n人间何处有此景，便欲往买二顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗二句","author":"苏轼","text":"有客打碑来荐福，无人骑鹤上扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：联","author":"苏轼","text":"山抹微云秦学士，露花倒影柳屯田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：上联一句其一","author":"苏轼","text":"二疏辞汉去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：上联一句其二","author":"苏轼","text":"衡茅稚子璠玙器。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：属辽使者对","author":"苏轼","text":"四诗风雅颂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗二句 其一","author":"苏轼","text":"枪棋携到齐西境，更试城南金线奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗二句 其二","author":"苏轼","text":"密竹不妨呈劲节，早梅何惜认残花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗二句 其三","author":"苏轼","text":"秋英不比春花落，说与诗人子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：联","author":"苏轼","text":"槐花黄，举子忙。\n促织鸣，懒妇惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：联","author":"苏轼","text":"凤凰来仪，嘉禾合穟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：联","author":"苏轼","text":"爱蜀蕲舒嘉代富，新登高棣桂常芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：穷措大","author":"苏轼","text":"一夕雷轰荐福碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：大雨联句","author":"苏轼","text":"有客高吟拥鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：诗二句","author":"苏轼","text":"一炉香对紫宫起，万点雨随青盖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无题","author":"苏轼","text":"冈陵来势远，幽处更依山。\n一片湖景内，千家市井间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂酒颂","author":"苏轼","text":"中原百国东南倾，流膏输液归南溟。\n祝融司方发其英，沐日浴月百宝生。\n水娠黄金山空青，丹砂晨暾朱夜明。\n百卉甘辛角芳馨，旃檀沈水乃公卿。\n大夫芝兰士蕙蘅，桂君独立冬鲜荣。\n无所摄畏时靡争，酿为我醪淳而清。\n甘终不坏醉不酲，辅安五神伐三彭。\n肌肤渥丹身毛轻，冷然风飞罔水行。\n谁其传者疑方平，教我常作醉中醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浪淘沙","author":"苏轼","text":"昨日出东城。\n试探春情。\n墙头红杏暗如倾。\n槛内群芳芽未吐，早已回春。\n绮陌敛香尘。\n雪霁前村。\n东君用意不辞辛。\n料想春光先到处，吹绽梅英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子 八月十八日观潮","author":"苏轼","text":"海上乘槎侣，仙人萼绿华。\n飞升元不用丹砂。\n住在潮头来处、渺天涯。\n雷辊夫差国，云翻海若家。\n坐中安得弄琴牙。\n写取馀声、归向水仙誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一丛花 初春病起","author":"苏轼","text":"今年春浅腊侵年。\n冰雪破春妍。\n东风有信无人见，露微意、柳际花边。\n寒夜纵长，孤衾易暖，钟鼓渐清圆。\n朝来初日半衔山。\n楼阁淡疏烟。\n游人便作寻芳计，小桃杏、应已争先。\n衰病少悰。\n疏慵自放，惟爱日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香子 过七里滩","author":"苏轼","text":"一叶舟轻。\n双桨鸿惊。\n水天清、影湛波平。\n鱼翻藻鉴，鹭点烟汀。\n过沙溪急，霜溪冷，月溪明。\n重重似画，曲曲如屏。\n算当年、虚老严陵。\n君臣一梦，今古空名。\n但远山长，云山乱，晓山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祝英台近","author":"苏轼","text":"挂轻帆，飞急桨，还过钓台路。\n酒病无聊，敧枕听鸣橹。\n断肠簇簇云山，重重烟树，回首望、孤城何处。\n閒离阻。\n谁念萦损襄王，何曾梦云雨。\n旧恨前欢，心事两无据。\n要知欲见无由，痴心犹自，倩人道、一声传语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 寒食未明至湖上，太守未来，两县令先在","author":"苏轼","text":"城头月落尚啼乌。\n朱舰红船早满湖。\n鼓吹未容迎五马，水云先已漾双凫。\n映山黄帽螭头舫，夹岸青烟鹊尾炉。\n老病逢春只思睡，独求僧榻寄须臾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 夏景","author":"苏轼","text":"乳燕飞华屋。\n悄无人、桐阴转午，晚凉新浴。\n手弄生绡白团扇，扇手一时似玉。\n渐困倚、孤眠清熟。\n帘外谁来推绣户，枉教人、梦断瑶台曲。\n又却是，风敲竹。\n石榴半吐红巾蹙。\n待浮花、浪蕊都尽，伴君幽独。\n秾艳一枝细看取，芳心千重似束。\n又恐被、秋风惊绿。\n若待得君来，向此花前，对酒不忍触。\n共粉泪，两簌簌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 观潮","author":"苏轼","text":"碧山影里小红旗。\n侬是江南蹋浪儿。\n拍手欲嘲山简醉，齐声争唱浪婆词。\n西兴渡口帆初落、渔浦山头日未敧。\n侬欲送潮歌底曲，尊前还唱使君诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江仙 风水洞作","author":"苏轼","text":"四大从来都遍满，此间风水何疑。\n故应为我发新诗。\n幽花香涧谷，寒藻舞沦漪。\n借与玉川生两腋，天仙未必相思。\n还凭流水送人归。\n层巅馀落日，草露已沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 歌妓","author":"苏轼","text":"绣帘高捲倾城出。\n灯前潋滟横波溢。\n皓齿发清歌。\n春愁入翠蛾。\n悽音休怨乱。\n我已先肠断。\n遗响下清虚。\n累累一串珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 代人赠别","author":"苏轼","text":"一颗樱桃樊素口。\n不爱黄金，祇爱人长久。\n学画鸦儿犹未就。\n眉尖已作伤春皱。\n扑蝶西园随伴走。\n花落花开，渐解相思瘦。\n破镜重圆人在否。\n章台折尽青青柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行香子 丹阳寄述古","author":"苏轼","text":"携手江村。\n梅雪飘裙。\n情何限、处处消魂。\n故人不见，旧曲重闻。\n向望湖楼，孤山寺，涌金门。\n寻常行处，题诗千首，绣罗衫、与拂红尘。\n别来相忆，知是何人。\n有湖中月，江边柳，陇头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭君怨 金山送柳子玉","author":"苏轼","text":"谁作桓伊三弄。\n惊破绿窗幽梦。\n新月与愁烟。\n满江天。\n欲去又还不去。\n明日落花飞絮。\n飞絮送行舟。\n水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉落魄 离京口作","author":"苏轼","text":"轻云微月。\n二更酒醒船初发。\n孤城回望苍烟合。\n记得歌时，不记归时节。\n巾偏扇坠藤床滑。\n觉来幽梦无人说。\n此生飘荡何时歇。\n家在西南，长作东南别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 京口得乡书","author":"苏轼","text":"雨后春容清更丽。\n只有离人，幽恨终难洗。\n北固山前三面水。\n碧琼梳拥青螺髻。\n一纸乡书来万里。\n问我何年，真个成归计。\n回首送春拚一醉。\n东风吹破千行泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少年游 润州作，代人寄远","author":"苏轼","text":"去年相送，馀杭门外，飞雪似杨花。\n今年春尽，杨花似雪，犹不见还家。\n对酒捲帘邀明月，风露透窗纱。\n恰似姮娥怜双燕，分明照、画梁斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子 自京口还钱塘道中寄述古太守","author":"苏轼","text":"蜀客到江南，长忆吴山好。\n吴蜀风流自古同，归去应须早。\n还与去年人，共藉西湖草。\n莫惜尊前仔细看，应是容颜老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神子 陈直方妾嵇，钱塘人也。求新词，为作此。钱塘人好唱陌上花缓缓曲，余尝作数绝以纪其事","author":"苏轼","text":"玉人家在凤凰山。\n水云间。\n掩门閒。\n门外行人，立马看弓弯，十里春风谁指似，斜日映，绣帘斑。\n多情好事与君还。\n闵新鳏。\n拭馀潸。\n明月空江，香雾著云鬟。\n陌上花开春尽也，闻旧曲，破朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神子 湖上与张先同赋时闻弹筝","author":"苏轼","text":"凤凰山下雨初晴。\n水风清。\n晚霞明。\n一朵芙蕖，开过尚盈盈。\n何处飞来双白鹭，如有意，慕娉婷。\n忽闻江上弄哀筝。\n苦含情。\n遣谁听。\n烟敛云收，依约是湘灵。\n欲待曲终寻问取，人不见，数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 有美堂赠述古","author":"苏轼","text":"湖山信是东南美。\n一望弥千里。\n使君能得几回来。\n便使尊前醉倒、更徘徊。\n沙河塘里灯初上。\n水调谁家唱。\n夜阑风静欲归时。\n惟有一江明月、碧琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情 送述古迓元素","author":"苏轼","text":"钱塘风景古来奇。\n太守例能诗。\n先驱负弩何在，心已浙江西。\n花尽后，叶飞时。\n雨凄凄。\n若为情绪，更问新官，向旧官啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 杭妓往苏。迓新守杨元素。寄苏守王规甫","author":"苏轼","text":"玉童西迓浮丘伯。\n洞天冷落秋萧瑟。\n不用许飞琼。\n瑶台空月明。\n清香凝夜宴。\n借与韦郎看。\n莫便向姑苏。\n扁舟下五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"苏轼","text":"云鬟倾倒。\n醉倚阑干风月好。\n凭仗相扶。\n误入仙家碧玉壶。\n连天衰草。\n下走湖南西去道。\n一舸姑苏。\n便逐鸱夷去得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 西湖席上代诸妓送陈述古","author":"苏轼","text":"娟娟缺月西南落。\n相思拨断琵琶索。\n枕泪梦魂中。\n觉来眉晕重。\n华堂堆烛泪。\n长笛吹新水。\n醉客各西东。\n应思陈孟公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神子 孤山竹阁送述古","author":"苏轼","text":"翠蛾羞黛怯人看。\n掩霜纨。\n泪偷弹。\n且尽一尊，收泪唱阳关。\n漫道帝城天样远，天易见，见君难。\n画堂新创近孤山。\n曲阑干。\n为谁安。\n飞絮落花，春色属明年。\n欲棹小舟寻旧事，无处问，水连天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 西湖送述古","author":"苏轼","text":"秋风湖上萧萧雨。\n使君欲去还留住。\n今日漫留君。\n明朝愁杀人。\n佳人千点泪，洒向长河水。\n不用敛双蛾。\n路人啼更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 送述古赴南都","author":"苏轼","text":"清淮浊汴。\n更在江西岸。\n红旆到时黄叶乱。\n霜入梁王故苑。\n秋原何处携壶。\n停骖访古踟蹰。\n双庙遗风尚在，漆园傲吏应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 送述古","author":"苏轼","text":"回首乱山横。\n不见居人只见城。\n谁似临平山上塔，亭亭。\n迎客西来送客行。\n归路晚风清。\n一枕初寒梦不成。\n今夜残灯斜照处，荧荧。\n秋雨晴时泪不晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"苒苒中秋过，萧萧两鬓华。\n寓身此世一尘沙。\n笑看潮来潮去、了生涯。\n方士三山路，渔人一叶家。\n早知身世两聱牙。\n好伴骑鲸公子、赋雄誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南歌子","author":"苏轼","text":"师唱谁家曲，宗风嗣阿谁。\n借君拍板与门槌。\n我也逢场作戏、莫相疑。\n溪女方偷眼，山僧莫皱眉。\n却愁弥勒下生迟。\n不见老婆三五、少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]