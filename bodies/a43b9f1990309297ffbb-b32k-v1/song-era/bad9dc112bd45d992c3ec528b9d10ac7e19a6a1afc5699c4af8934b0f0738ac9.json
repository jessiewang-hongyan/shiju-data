[{"title":"题端明苏子瞻书天庆观乳泉赋后","author":"王遂","text":"天一生兮上浮，羽人俟兮丹丘。\n溯儋耳兮东注，夹昆仑兮倒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王遇","text":"不知何处雨，已觉此间凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题天台明岩","author":"王道","text":"自古悬崖深蔽日，此心圆镜本无尘。\n会知明暗非关石，便是岩中得道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登巾子山有怀旧游","author":"王道","text":"路转岧峣瞰古城，阑干曲处眼偏明。\n岚光不与江流断，凉意还从竹外生。\n好事樽罍初不减，旧题岁月已堪惊。\n会须更待天边月，醉看浮图波面横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"于介翁别去一载偶会高湖谩成唐律以写相思之意","author":"王道士","text":"高湖回首恰周期，别后青山几度思。\n丹灶烟霞空入梦，夜窗风雨忆论诗。\n百年相会宁无约，九日来游竟失期。\n去去但坚金石操，岁寒松柏有深知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"美阎承旨","author":"王道士","text":"海底珊瑚明月珰，出为国瑞固难量。\n文章能事间重译，雨露深仁及远方。\n六合八荒春浩荡，百家诸子海苍茫。\n淮王门下孙登客，还许升堂近耿光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太湖","author":"王道士","text":"三万六千顷，浩荡三州界。\n烟雾四无边，往往出奇怪。\n洞庭柑已霜，震泽鱼极介。\n岂无范蠡舟，我欲从公迈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜卧舟中闻有唱山歌者倚其声作二首 其一","author":"王道父","text":"生来不识大门边，一片丹心石样坚。\n闻道阿郎难得妇，无媒争得到郎前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人","author":"王道亨","text":"刘郎自是桃花主。\n不许春风闲度。\n春色易随风去。\n片片伤春暮。\n返魂不用清香炷。\n却有梅花淡伫。\n从此镇长相顾。\n不怨飘残雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅 其一","author":"王鈇","text":"前身姑射冰相似，今代潘妃玉不如。\n坐对真成在江国，淡烟微雨暗扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"墨梅 其二","author":"王鈇","text":"可是伤春故癯瘦，未应无意作娉婷。\n不须更向岭头觅，只此松煤更典型。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶","author":"王鈇","text":"粉翼琼须似剪裁，飞飞自远逐香来。\n花间得意情多恨，应笑王孙殢酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其一","author":"王雱","text":"一双燕子语帘前，病客无憀尽日眠。\n开遍杏花人不见，满庭轻雨绿如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其二","author":"王雱","text":"霏微细雨不成泥，料峭轻寒透夹衣。\n处处园林皆有主，欲寻何地看春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦寻芳慢/倦寻芳 中吕宫","author":"王雱","text":"露晞向晚，帘幕风轻，小院闲昼。\n翠径莺来，惊下乱红铺绣。\n倚危墙，登高榭，海棠经雨胭脂透。\n算韶华，又因循过了，清明时候。\n倦游燕、风光满目，好景良辰，谁共携手。\n恨被榆钱，买断两眉长斗。\n忆高阳，人散后。\n落花流水仍依旧。\n这情怀，对东风、尽成消瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王嗣宗","text":"恶人须用大枷枷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送桑泽还天台","author":"王廉清","text":"桃花风起竹舆寒，寒食天晴石路乾。\n正是东君好春色，不妨词客驻归鞍。\n金声赋就方腾踏，铁砚才高尚考槃。\n如到琼台与华顶，为侬试拂旧题看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题玉霄亭","author":"王廉清","text":"忆昔新亭敞玉霄，使君髯舅意飘飘。\n春风潋滟黄金盏，明月参差紫玉箫。\n歌吹旧踪空草木，风流闲话属渔樵。\n凭栏无限凄怆意，寂寞寒江落暮潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临终诗","author":"王楙","text":"平生不学口头禅，脚踏实地性虚天。\n临归不用求缠裹，趁著帆风便上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 寿张仪真","author":"王楙","text":"三杰后，福寿两无涯。\n食乳相君功未既，妩眉京兆眷方兹。\n富贵莫推辞。\n门两戟，却棹一纶丝。\n莼菜秋风鲈鲙美，桃花春水鳜鱼肥。\n笑傲霅溪湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登浮光四望亭","author":"王楠","text":"长年忍泪说中原，望彻中原隔戍垣。\n谁遣江淮限南北，从来宇宙一乾坤。\n功名纸上徒虚语，岁月谁边恐断魂。\n老矣叫阍无处所，倚空长剑与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观梅","author":"王楠","text":"谁见梅花正发时，江天雪意欲垂垂。\n疏枝冷蕊春无几，断水残云意自奇。\n疏影偶因明月见，暗香惟有好风知。\n何人更起调羹手，莫道功成结子迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康泊舟欲游庐山值雪","author":"王楠","text":"春风浩荡江湖客，咫尺庐山风雨急。\n门前老树最关情，一夜相思头尽白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 送人归武夷","author":"王槐建","text":"武夷一片闲云，被风吹落清原顶。\n溪梅馥馥，飞来相傍，不嫌凄冷。\n瓦釜争鸣，丝桐一曲，满城倾听。\n奈阳春未了，骊驹已驾，桐阴底、梦魂醒。\n何限吟笺赋笔，甚乡心、分却清兴。\n鳌峰胜处，遥知风月，属谁管领。\n邂逅何时，无穷事业，有穷光景。\n但相期、不负初心，此外分、皆前定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王溥","text":"挥毫文战偶搴旗，待诏金华亦偶为。\n白社遽当宗伯选，赤心旋遇圣人知。\n九霄得路荣虽极，三接承恩出每迟。\n职在台司多少暇，亲师不及舞雩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄邓洵美","author":"王溥","text":"衡阳归雁别重湖，衔到同人一纸书。\n忽见姓名双泪落，不知消息十年馀。\n彩衣我已登黄阁，白社君犹葺旧居。\n南望荆门千里外，暮云重叠满晴虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢进士张翼投诗两轴","author":"王溥","text":"清河诗客本贤良，惠我新吟六十章。\n格调宛同罗给事，功夫深似贾司仓。\n登山始觉天高广，到海方知浪渺茫。\n好去蟾宫是归路，明年应折桂枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王溥","text":"两制职官三十客，自怜荣耀老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞","author":"王煓","text":"轧轧篮舆松径间，晚风吹雨逼人寒。\n断崖蹲虎停云湿，一水飞蛟醉眼看。\n空翠万重藏绝景，夜光千丈浴神丹。\n青鞋布袜吾能办，未觉丹躯羽化难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寂光寺","author":"王献臣","text":"霸业何劳问废兴，前人楼阁后人登。\n海山有籍归真主，云物无情属野僧。\n饮鹿澄潭环细浪，啼猿拱木网寒藤。\n纷华不见旧时事，惟有禅龛空报澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天开岩","author":"王献臣","text":"觉皇普照黄金宅，西有峰峦插空碧。\n地灵不放幽境开，都把云萝锁顽石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泗州山","author":"王献臣","text":"大石小石皆罗列，造化安排非人设。\n覆者如轩深者洞，方者如屏平者席。\n可以安尊罍，可以横琴瑟。\n天边乌兔眼前飞，海上波澜掌中白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麻姑坛","author":"王献臣","text":"我佩绿绮琴，独上麻姑坛。\n七弦试拂拭，一天星斗寒。\n仙子为我来，降语五云端。\n世人知音少，君今休要弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澄虚阁","author":"王献臣","text":"此地留仙灶，仙人去何早。\n一粒药初成，空山绝灵草。\n灶傍五色土，令人百病好。\n况复饵丹人，朱颜几时老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琴歌","author":"王谨礼","text":"低露下，深幕垂，月照孤琴空弦咽，宵泪谁怜此夜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"耆英会诗","author":"王谨言","text":"相印貂冠粲六符，华颠高会侍臣俱。\n不将官职誇乡里，唯尚年龄入画图。\n履道清欢追故事，伫瞻阴德见吁谟。\n叨陪几杖真荣观，圭璧丛中问珷玞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将离蓝田同王辟太博饮于王氏亭联成二韵","author":"魏野","text":"白鹿原东浐水西，杨花漠漠草萋萋。\n那堪对此还醒别，况是醍醐鸟正啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿王辟宅与王专洎用晦上人因成联句","author":"魏野","text":"夜浅月未生，春寒雪犹在。\n吴僧携古琴，来与山人会。\n诗心有是非，禅话无慷慨。\n高鸿自冥冥，弋者复何害。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题三学山","author":"王雍","text":"五色琉璃白昼寒，当年佛脚印旃檀。\n藕丝织出三衣妙，贝叶经传一偈难。\n夜看圣灯红菡萏，晓惊飞石碧琅玕。\n更闻鹦鹉因缘塔，八十山僧试说看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题紫箨寺","author":"王戬","text":"竹山绝顶古招提，境异相将竺国齐。\n灵鹫雄吞台岳小，瑞峰高压斗牛低。\n云深石怪宜猿隐，水静林幽乐鸟啼。\n见说当年封紫箨，只因丹凤此中栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题寺壁","author":"王暨","text":"奔驰尘土何时了，自叹一官如蚁小。\n半夜觅宿僧家园，梦里闻鸦霜月晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金濑吊贞女","author":"王端朝","text":"嗟彼战国秋，风俗日以漓。\n卓哉史氏女，粲粲兰蕙姿。\n守贞奉慈母，克尽乌鸟私。\n业贫不辞苦，击漂临清漪。\n适尔遇丈夫，失路良可悲。\n恻然为发筥，振彼穷途饥。\n振穷乃所愿，越礼非所宜。\n灭口葬鱼腹，此心天地知。\n丈夫既得志，雪耻鞭平尸。\n念此一日恩，仗节远来兹。\n百金报无地，立马空嗟咨。\n俛仰易陈迹，屈指万古期。\n谁招地下魂，惟遗道旁碑。\n雄辞吐激烈，粲若星贝垂。\n吾生后谪仙，况乃驽钝资。\n捧心学西子，取笑将奚为。\n留题表贞义，庶几薄俗移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张判官归巴州","author":"王翥","text":"回首三巴曲，平生万里桥。\n衣冠无赖客，花月可怜宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆舍弟","author":"王翥","text":"药物吾仍病，花时汝未归。\n不眠愁月落，独立看云飞。\n诗礼自持律，饥寒谁解围。\n遥知理舟楫，西望涕沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮世","author":"王翥","text":"浮世惟高枕，平生有敝裘。\n江花中酒日，巴雨落帆秋。\n老矣英雄事，愚哉盗贼谋。\n啼猿长自在，一笑下沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灌口秋涨","author":"王翥","text":"所向愁无地，穷源欲上天。\n蛟龙胡尔怒，鸥鹭更谁怜。\n万里朝宗意，群凶跋扈年。\n生涯秋色里，独立问渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴宣抚故宅","author":"王翥","text":"社稷疲奔命，乾坤服至诚。\n扶持三蜀在，出入两朝荣。\n豕犬有遗恨，麒麟空复情。\n家声隤已尽，国法用犹轻。\n成季翻无后，花卿浪得名。\n门庭黄鸟语，几杖绿苔生。\n威福何偏重，精神恐不平。\n庶几蒙世立，凡百慎持盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中塔悟空禅院 其三","author":"王蔺","text":"皋亭回首软红尘，晴日僧房暖似春。\n禅老眈眈如卧虎，相逢一笑问前因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中塔悟空禅院 其一","author":"王蔺","text":"重到招提恰两年，北窗风雪接衾眠。\n客来休说邯郸梦，世事端知不偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中塔悟空禅院 其二","author":"王蔺","text":"富贵危机岂独今，且从麋鹿逐山林。\n只惭莫报君恩重，敢废惓惓畎亩心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨廷秀至后睡觉","author":"王蔺","text":"池塘春梦草初生，江左诗来得我惊。\n开秩快观醒倦眼，挑灯细读度寒更。\n追参李杜今无敌，挥斥侯刘独有声。\n一首敬酬三百首，深惭坡老和渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠胡侍郎荣归","author":"王銮","text":"南还昔别已匆匆，目断云飞思欲穷。\n江水波涵天上下，海门潮涌浙西东。\n沉烟白鸟晴沙际，飘带青山夕照中。\n治世安民遗泽在，万年史笔纪高风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"王镃","text":"綵楼帘影夜沉沉，一片筛凉月似金。\n倚得画栏和袖暖，看人儿女学穿针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三潭印月","author":"王镃","text":"草满咸平古屋基，梅花几度换横枝。\n黄昏若看一潭月，不出林逋两句诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中即事","author":"王镃","text":"落花流出石崖泉，疑是山中有隐仙。\n路隔深林看不见，斧樵声在碧云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶","author":"王镃","text":"蜡包绿萼日才烘，放出千枝鹤顶红。\n待得雪晴春信透，翠云围绕锦屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马嵬","author":"王镃","text":"梨花魂醉草伤秋，玉笛霓裳事已休。\n谁信一勾罗袜内，能藏天宝许多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵","author":"王镃","text":"柳院春归雪未乾，试灯歌巷月痕寒。\n懒随翠影红香走，自买梅花插烛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六桥春望","author":"王镃","text":"美人娇醉落花钿，船载笙歌出柳边。\n春满六桥调马路，香风飘趁玉丝鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤仙","author":"王镃","text":"凤箫声断綵鸾来，弄玉仙游竟不回。\n英气至今留世上，年年化作此花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡","author":"王镃","text":"枕书午睡正朦胧，云翠风凉透葛中。\n唤醒一床蝴蝶梦，轧鸦声在隔楼东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月色催花","author":"王镃","text":"湖中暖动采香船，晴入泥痕斗草天。\n红影一阑春欲透，趱开桃杏向阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜","author":"王镃","text":"不眠行绕石池吟，月色如银夜正深。\n山路无风枯叶静，时闻露滴响空林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜敲砧","author":"王镃","text":"沉沉万籁满天星，药兔秋声处处明。\n落尽灯花人欲睡，一檐桐影捣衣声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月洞书屋","author":"王镃","text":"自咏自书粘壁上，何须古画与名碑。\n隔墙风落閒花片，日日飞来入砚池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水乐洞","author":"王镃","text":"一派宫商石壁中，此腔不与世人同。\n分明水府真韶乐，几换兴亡曲未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水仙","author":"王镃","text":"银台香露洗金卮，玉佩飘飘醉欲飞。\n想是龙宫春宴罢，凌波归早湿绡衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水居","author":"王镃","text":"飞鸥贴水水连天，一半青山一半烟。\n日暮潮回渔父醉，不知船阁浅沙边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水阁纳凉","author":"王镃","text":"云碧纱厨水阁中，鸳鸯花冷枕玲珑。\n描金团扇无人用，一阵荷香一阵风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风光著柳","author":"王镃","text":"春色桥边万缕金，娉娉袅袅弄晴阴。\n笼烟罩月多情处，又见丝条染绿深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙源即事 其二","author":"王镃","text":"避世移家入乱山，松风杉雨打窗寒。\n床头一卷麻衣易，自点松明尽夜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙源即事 其一","author":"王镃","text":"山花幽草自成春，深入仙源欲避秦。\n地僻不知南北事，相逢尽是种桃人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]