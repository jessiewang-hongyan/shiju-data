ollection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浙江","author":"苏泂","text":"演迤来何代，崩腾直至今。\n飞潜知险地，征逐欠閒心。\n西障残山渺，东流大海深。\n会携秋月色，徐听夜龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"热","author":"苏泂","text":"夏云端的似奇峰，忽作颓墙四面红。\n坐想微风过荷叶，梦成疏雨滴梧桐。\n浮家何计来波上，举扇无因出焙中。\n三十馀年吟冷语，今年吟到水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途次口占三首 其三","author":"苏泂","text":"枣子万星攒，良苗绿一端。\n扑篮多秀色，吹帽受风寒。\n扰扰水和尚，泠泠山药官。\n近诗差进步，安得老梅看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途次口占三首 其二","author":"苏泂","text":"鼓棹泛瀰茫，驱车道莽苍。\n功名中底用，奔走为谁忙。\n白浪高扬子，青山入建康。\n从来怀古意，秋至转悲凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途次口占三首 其一","author":"苏泂","text":"草檄头风愈，吟诗疟鬼藏。\n三年如昨日，多难更殊乡。\n涧底秋花小，枝头病叶黄。\n饥餐并困卧，平地有仙方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪制帅宝学侍郎饮别金陵诸胜地","author":"苏泂","text":"制阃三年名，亭台一日违。\n江山云外款，鼓吹月中归。\n夜气轻杯力，霜棱迫妓围。\n明当趁朝谒，回首此依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卫太常二首 其二","author":"苏泂","text":"祖世多生契，门墙半面人。\n若为资巨岳，不敢望洪钧。\n千载今如此，诸公迹易陈。\n江河须到海，松柏不胜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卫太常二首 其一","author":"苏泂","text":"道义分明重，功名取次休。\n重来踏龙尾，犹记立螭头。\n行辈云霄上，家山岁月周。\n孰知为郡乐，未慊过都留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卢子高二首 其二","author":"苏泂","text":"君行甫郭门，我病已昏昏。\n呕泄辄经日，芳芗空屡飧。\n每思今古易，终畏别离烦。\n向匪勤车马，何因共一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卢子高二首 其一","author":"苏泂","text":"我别君逾壮，君来我欲翁。\n艰虞畴昔异，风雨数宵同。\n鹤病祇应瘦，鹰饥怕苦笼。\n平生黄叔度，见可俗尘空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵紫芝","author":"苏泂","text":"同年今半百，同病半年赊。\n瘦骨如枯木，残身类晚花。\n人言关念虑，书字觉攲斜。\n且愿逢灵药，清吟老鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄常山晋叟兄","author":"苏泂","text":"行人有公论，知县得奇才。\n祖世今衰矣，吾兄亦壮哉。\n可能千里到，不破一朝来。\n当日王猷兴，真成访戴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄颍季","author":"苏泂","text":"人来得一书，分袂两旬馀。\n未擉刘差鳖，谁羹宋嫂鱼。\n时情分向背，同气底亲疏。\n想见迎长节，杯行会忆渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得句 其二","author":"苏泂","text":"马步山逾险，舟行水未通。\n驭风为道号，啮雪是家风。\n自许清如玉，从教臭似铜。\n人生几两屐，老去一飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得句 其一","author":"苏泂","text":"存养龟传息，扶行鹤类形。\n题诗窗纸白，住舍竹林青。\n食淡神偏爽，眠稀梦亦灵。\n从来知守分，真个胜看经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得屋后舟中作","author":"苏泂","text":"有屋吾堪老，无田子缓求。\n长江惟可饮，万事不须谋。\n政尔天从欲，端因鬼瞰忧。\n平生晏平仲，能费几狐裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼剡姊","author":"苏泂","text":"庭闱消息判沉沉，雁序殊乡缺嗣音。\n择对漫言双易姓，何人堪托一分心。\n孤魂寂寞丘中土，庶子凋零地下金。\n没固无聊生亦尔，忍令行路独沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步湖桥","author":"苏泂","text":"吴侬生长镜湖边，湖晚登桥意欲仙。\n初见苍山下红日，忽看白月上青烟。\n收藏画本归吟笔，应答渔歌送客船。\n回首更阑人去后，玉虹横浸冷金眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚渡","author":"苏泂","text":"小雨湿诗人，人疑过渡频。\n望山高著眼，就树巧遮身。\n有句寻鸥说，无家认鹤亲。\n明朝上京去，酾酒酹溪神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹娥江","author":"苏泂","text":"月下倾残酒，风前读断碑。\n采江那有意，陟岵不无悲。\n树影经船疾，滩声到枕迟。\n重来更何日，放棹欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望三山放翁居","author":"苏泂","text":"晚进违前辈，湮才重此州。\n绝知他日少，预作百年忧。\n樵牧非身致，聪明不我谋。\n莫令司马藁，祗候茂陵求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花树下读高兄诗","author":"苏泂","text":"寻思秘阁贤郎样，一似梅花带竹枝。\n每到君边作梅想，却来梅下读君诗。\n崇奎堂暖春风候，射的山寒夜雪时。\n安得居游君共我，梅花三友说心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]