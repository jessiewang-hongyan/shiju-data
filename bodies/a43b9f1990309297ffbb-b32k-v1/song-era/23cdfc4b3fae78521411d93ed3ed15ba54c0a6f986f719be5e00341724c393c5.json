[{"title":"奉送吕表叔赴江阴","author":"苏泂","text":"春风乍入澄江郡，最爱君山一点青。\n柳外化民安若子，鸥边为政出于经。\n每惭旧守勤招唤，况识今侯更典刑。\n此去交承如借问，侯芭贫病发星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学渔","author":"苏泂","text":"舟楫蘋花渺，江湖喜气多。\n一天飞白雨，半夜湿青蓑。\n帆转星初落，潮归镜欲磨。\n平生动中静，安枕信风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松桂堂","author":"苏泂","text":"素韠归来痛倚庐，四时花鸟护幽居。\n躬行已达参乎孝，佩服难忘孔子书。\n绿荫千年知不改，清香奕世岂无馀。\n客来已自徵前梦，未必中堂影像虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊通明","author":"苏泂","text":"午夜通明泊，朝来自启篷。\n骤看潮带雨，还作雪随风。\n酒薄愁无料，诗难老未工。\n疏寮有奇士，恨不此行同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"若耶溪","author":"苏泂","text":"岁月去悠悠，沙边一线流。\n荣无严子钓，直有楚臣钩。\n雨气知鱼乐，烟光验鸟愁。\n馀年未可料，几度此维舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓鱼","author":"苏泂","text":"白头波上白头翁，竹叶杯边竹叶丛。\n烹雁罪因应雁得，非鱼乐语讵鱼同。\n醉醒未觉乾坤异，起灭悬知水镜空。\n严子向来无世念，谢郎今日有家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨","author":"苏泂","text":"春禽唤雨屋山呼，二月韶光一半无。\n作祟岂逃泥滑滑，原情当坐谷孤孤。\n不应豆蔻花梢重，已怪荼蘼叶子粗。\n年去年来谁奈得，酒酣击缶和噫呜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后乞御正殿得请次韵","author":"苏泂","text":"已成霖雨慰黎蒸，圣主斋居尚穆清。\n奏许正朝仍玉食，尽回喜色见民情。\n衣篝不惜添梅润，签帙从堆乱叶声。\n要雨雨来天便许，不须更卜白鼍鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复简蹈中","author":"苏泂","text":"庭树风吹尽，池荷雨滴穿。\n病身能几日，短褐过残年。\n摘藁有千首，看囊无一钱。\n鸡号唤清晓，惜许梦钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客夜","author":"苏泂","text":"风雨夜冥冥，舟行为小停。\n野田藏水白，燐火出坟青。\n将子雁能急，久鳏鱼独醒。\n人生贵艰阻，稍向道涂经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"将别颍叟弟","author":"苏泂","text":"兄弟无聊各数年，东堂犹喜聚炊烟。\n翛然汝更寻灵照，别后吾知忆惠连。\n击汰便应从橹外，看书谁与共灯前。\n明朝不待鼕鼕鼓，祇有关门及早眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡险","author":"苏泂","text":"剖凿谁其始，山川出秘奇。\n祗应天地设，未必鬼神为。\n崩石惊船过，盘涡逼棹移。\n蓬莱如在眼，泪冷挂猿枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽兴","author":"苏泂","text":"花气湿书签，琴风入画帘。\n绿阴连地黑，朱果落枝甜。\n客去从鹦语，人归问鹊占。\n村居近城郭，幽兴得相兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思故人","author":"苏泂","text":"故人不可见，书札报平安。\n黄菊谁能折，青山独自看。\n雨生南浦足，秋入五湖宽。\n岁晚无多事，相看把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜大父墓","author":"苏泂","text":"六载今如此，青松到屋梁。\n何言声籍籍，直作去堂堂。\n事已难追悔，天高只痛伤。\n当时巴蜀使，书疏不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日闲望","author":"苏泂","text":"到处林园静，能来是主人。\n莺喉低啭玉，鱼腹暖翻银。\n玩雨沾芳履，吟风岸角巾。\n功名吾老矣，甘作太平民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春去","author":"苏泂","text":"城郭春风赋式微，忽看莺老燕雏飞。\n秧田水满闻姑恶，树叶阴浓叫姊归。\n百岁襟期真索寞，十年心事只依稀。\n人间我亦无能者，华发苍颜未必非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独鸟","author":"苏泂","text":"独鸟愁归翮，霜寒谢世纷。\n梦遥乡思局，砧急酒醒闻。\n一笑胡为尔，中年更不群。\n颇疑当日论，饱饭薄能文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风 其一","author":"苏泂","text":"秋风清入骨，秋树薄于云。\n老去悲时序，新来断句文。\n燕鸿相背发，泾渭一生分。\n信有难言事，天高不为闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风 其二","author":"苏泂","text":"秋风荷叶老，秋月桂枝生。\n万物四时意，八荒双眼明。\n忧虞滋疾病，治乱阅阴晴。\n粳稻今年少，无劳社酒倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有感 其二","author":"苏泂","text":"楼上几当当，残更引漏长。\n月明山树湿，露下药苗香。\n朝野衣冠异，郊原故物伤。\n平生三径草，此夕更苍凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有感 其一","author":"苏泂","text":"灯影三更夜，虫声四壁秋。\n雨阶疏滴滴，风幔飒悠悠。\n朋友新凋丧，湖山旧钓游。\n平生匡复志，老去未能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋感","author":"苏泂","text":"朱槿不堪留，牵牛上竹幽。\n蛩声清夺漏，鹰翮劲思秋。\n掩卷悲先哲，看山忆旧游。\n闺情兼旅梦，百虑五更头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵黄州寄示诗绝奇次韵","author":"苏泂","text":"书回闻道读春秋，笔削馀功指顾收。\n鲁国故知人有礼，周家那得圣无忧。\n非君著意扶公谷，似我何辞赞夏游。\n会引青藜校天禄，毋忘华发此沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送观复机宜荣侍南游二首 其二","author":"苏泂","text":"命拙仍多故，君来每慰情。\n艰虞还俭岁，文字久寒盟。\n又作家山别，宽为数月程。\n闲门闭萧瑟，病眼向谁明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送观复机宜荣侍南游二首 其一","author":"苏泂","text":"友谊平生少，心期远近同。\n略无时俗气，信有古人风。\n几谏知吾子，忠言在若翁。\n南州须趣召，先寄状元红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陆怀祖之官丹阳","author":"苏泂","text":"放翁去作水中仙，有子生平在眼前。\n钟爱甚于贤伯仲，传家仍自好诗篇。\n肯为筦库官无小，会复公侯泽更绵。\n我亦与君非久别，秋来须上浙西船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈永康昌年","author":"苏泂","text":"公不登台省，犹宜立内朝。\n如何百里县，更以一身遥。\n俗悍须宽理，年丰在政调。\n清秋送卓茂，目断马萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵蹈中府签对策大廷","author":"苏泂","text":"奥学通玄象，须时对广廷。\n端为贾生策，动合圣人经。\n事往谁谋始，时今未敉宁。\n因留非所志，君相眼终青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱子望","author":"苏泂","text":"才名富有馀，挥袂别乡闾。\n小作经年计，轻赍一束书。\n州城蕉叶暗，驿路菊花疏。\n尚想南来使，时因问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重忆旧句","author":"苏泂","text":"太饱伤清气，微寒最好诗。\n白鸥没浩荡，天马谢羁维。\n矫矫真无敌，飘飘信所之。\n百年龙变化，万事燕差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重送吕知录表叔","author":"苏泂","text":"别味中年畏，离筵近日频。\n青山千骑远，绿树一蝉新。\n典狱须吾表，穷涯亦我民。\n时因过周守，相与话推仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重哭周四","author":"苏泂","text":"甫读宗周挽，那知遽绝弦。\n所嗟无我辈，不独在诗篇。\n行到水穷处，魂伤山寂然。\n灰寒空酹酒，恸哭向苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻孟良父侍郎解婺印改江东漕再和堆字韵","author":"苏泂","text":"十行芝检从天下，六月荷花照水开。\n未必便将东节去，不妨政用此时来。\n安排过阙留中奏，想像攀辕恋别杯。\n遣贺以时非造次，索公一笑簿书堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕呈主人","author":"苏泂","text":"使节梅花外，椒盘泪眼边。\n山川非故国，笳鼓咽新年。\n机事鸥偏觉，家书雁不传。\n细笺今夕恨，万一主人怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74468,"sha256":"1841