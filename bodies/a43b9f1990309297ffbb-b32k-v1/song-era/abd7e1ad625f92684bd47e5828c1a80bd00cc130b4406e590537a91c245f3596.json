[{"title":"炎夏即事一首","author":"苏籀","text":"五咏八吟钻古奥，四豪六逸共周旋。\n隐囊垫帻枰棋局，轻箑珍笙荫采椽。\n习气峥嵘谈在昔，知音推激互相然。\n至哉佛老儒宗外，圣谛冰销浊火煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热二首 其二","author":"苏籀","text":"越吟吴咏两参商，我那皋原侬水乡。\n赤地千仓待舂簸，炎飙九夏剧晴阳。\n云霓不族讼风伯，雷电惭劳驱毕方。\n独卧嗟咨龙伯懒，梦乘天驷洒淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热二首 其一","author":"苏籀","text":"示病刘松殊不饮，烁燔汗眩兀如痴。\n尘嚣堀堁东山扇，汩浊祇惭叔度陂。\n茗汁粟浆回渴梦，大门高屋惮炎曦。\n生灵惴惴苗同槁，救暍哀祈风雨吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范箕叟啜茗一首","author":"苏籀","text":"无穷赏物胡名达，希世纤柔不计金。\n爱雪并花也延命，掷丝与竹却知音。\n情閒未绝毫釐念，文艳何妨铁石心。\n雅倩樊蛮诵长恨，饮茶亦可拟芳斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陋居一首","author":"苏籀","text":"平生瓮牖蔀茆菁，江左那无寸土宁。\n游宦飘然纡幕燕，陋居粗有读书萤。\n浮生佛脚须当抱，乱世儒衣便欲停。\n天定灾祥在淫善，北溟安得胜南溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临双溪一首","author":"苏籀","text":"汪汪西步桃花候，去去南峦苍狗云。\n日煖汀沙牧人梦，春嬉凫鹜野夫芹。\n缭郛左右交流浍，彼岸烟昏涨梓枌。\n颔首悠然辨真趣，会心比况有奇闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉旃一首","author":"苏籀","text":"归一岂应无以返，要言湛谛滓淤淘。\n大知直截揣摩渐，积执冥迷厌离劳。\n目睫古人曾致论，根尘当念勿喧嚣。\n主张名教殚才智，王霸蟠煎火上膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南溪太息一首","author":"苏籀","text":"东坡曾赏南溪雪，他日流芳好事孙。\n寒祲棱棱裹崧岱，忧端愤愤塞乾坤。\n赤囊政尔劳边吏，白羽多应落酒樽。\n太息九原何可作，逸才谁敢赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖三首 其二","author":"苏籀","text":"豹雾谷容晦，虎风林响寒。\n通宵喧涧濑，出日照岚峦。\n掩卷妨作乐，支筇咏考槃。\n王孙有窟宅，吾道尚艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖三首 其一","author":"苏籀","text":"去去追濠濮，悠悠平渭莘。\n荒凉罗雀处，寤寐叱牛频。\n鸮炙逢希阔，萍齑适酝醇。\n自谋蝼蚁穴，何以拯斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽栖三首 其三","author":"苏籀","text":"三芝羽人伫，五诫坏衣脩。\n农圃日用事，刍荛无几求。\n林丘识真趣，城阙罢菟裘。\n挥斥尘劳客，平生为道谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故孺封曹氏挽章","author":"苏籀","text":"豪宗相承籍，遗懿本驯良。\n夫息遵慈芘，污莱化阜康。\n杯棬留燕机，丹篆勒阴堂。\n愈愈垂青紫，诜诜庆祚长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日郊外","author":"苏籀","text":"葱路桃溪浩莽春，彤甍栱桷曜芳晨。\n衣如方士客閒剧，园号仪同势绝伦。\n梓幄桂旂端解赋，橘藩筱坞孰为邻。\n畦畦姜芋葵荽蓼，物物蕃滋辅主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春设一首","author":"苏籀","text":"折简王春涓胜日，执舆邻曲集侨官。\n奕娃红手凌寒怯，歌颈涂芗诉白宽。\n膏沐柳梅牵屐齿，冶妍桃杏压栏干。\n珍烹斗赛携英黠，娱老妆楼叠肉槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴一首","author":"苏籀","text":"高槐汤饼排朝馔，嘉菊香菹芼戛羹。\n饷早趁墟樵垦计，浇春量腹圣贤并。\n无由屠嚼相亲就，岂䛏奇章侈大烹。\n飘忽红稠莺燕语，康衢冶服炫春晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春集僧舍一首","author":"苏籀","text":"绣川藻野衒嫣姝，练缟秾殷亭育炉。\n二月峭寒轻抑勒，崇朝和气毕昭苏。\n绀青六幕无纤翳，绿缛多畴几町区。\n居士自携三昧酝，缁流丛错设伊蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栀子花一首","author":"苏籀","text":"镂裁雪羽元同质，合辑龙沈更一家。\n气袭禅僧鼻端白，葩敷溪女鬓唇斜。\n牵缠芗色诚虚幻，结习因缘可叹嗟。\n芍药调和传汉殿，酴醾脂泽有浑耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪子再示论诗之意答一首","author":"苏籀","text":"文章三昧亦无多，甄品难甘状杜何。\n撚脱髭须徒自哂，可怜弹铗为谁歌。\n腐陈点化为珍玩，翡翠鹪鹩入罻罗。\n拟续兰台快哉赋，后来作者岂容过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝舜俞少卿示曩岁葺蒙园陪游风什一编不度枵疏上尘二首 其二","author":"苏籀","text":"筮仕棓生繇莫京，温凊一亩夙经营。\n南陔弦诵给甘旨，北阙簪裾负屈声。\n秦刻唐刊储墨妙，齐衢鲁庙擅文鸣。\n建安正始源流远，详味风规蹑玉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝舜俞少卿示曩岁葺蒙园陪游风什一编不度枵疏上尘二首 其一","author":"苏籀","text":"清沂雩舞蹈前模，风咏先生于蔿于。\n论述殊堪露门召，镌摩已化兔园儒。\n台评公雅铦锋锷，杖齿袁遗抱笔觚。\n草木溉培裁昼暇，忘忧兰桂富芳荂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋分一首","author":"苏籀","text":"础湿岚昏近海多，剑霜清刮手亲磨。\n轮囷马栈非难整，索漠牛衣且勿呵。\n好住延陵皋泽去，强同溱洧济人过。\n坐令幽谷迁乔木，盛论中原喻尉佗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋冷一首","author":"苏籀","text":"岚烟澹澹雨飕飕，残蘖折槎陂水头。\n赎尔典裘扃户牖，饶伊夹幕閟娟柔。\n䔲蓑廛肆斗牢落，泞潦穷途强释愁。\n箬下浮君霜露旦，岂应虚诧钓诗钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜听雨一首","author":"苏籀","text":"萧骚闇响空阶滴，复值幽人对榻时。\n旨趣逍遥称漫叟，锋铓捍格愧神锥。\n愿摈谢万令閒处，实藉陈平屡出奇。\n心境卧轮非别伎，少年狡狯赴无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜雨凉一首","author":"苏籀","text":"寸念微情浩莫缄，此生殊阙住山庵。\n老怀钓港伴侯喜，道契涛江见陆参。\n调气从前深造孟，名官早欲问于郯。\n家书时燠何曾读，整顿尘编拂白蟫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诱学徒一首","author":"苏籀","text":"瞥闻立睹且湛研，讨索思臧义理穿。\n剖析赖经宗匠手，绝群羞拍腐儒肩。\n鸱鸦嗜鼠颛门蔽，博簺忘羊失路偏。\n警策后生文宪种，若为准拟即真贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵和叔大夫母安人曹氏挽词","author":"苏籀","text":"风规王邸韵，筮醮相夫宾。\n逐子大家懿，弄孙东第新。\n百能知肖嗣，八十又三春。\n磬石无虚勒，笄珈不复晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中书潘舍人省上二首 其二","author":"苏籀","text":"亟纾多难一群心，惕厉咨嗟憯测深。\n汉制春温劝敦本，周家夙戒岂无箴。\n该淹伯始万端理，烦悉姬公五诰寻。\n愈近清光缀经席，皇风如玉亦如金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送中书潘舍人省上二首 其一","author":"苏籀","text":"紫微鸡省待论思，少作英辞寤柬奇。\n高浪驾天输朗汉，紫霄即日奋长离。\n然明东里今同道，德裕封敖适此时。\n应笑迂慵畸已甚，呜呼鹤巘缀蝉枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孙丞法先池阳二首 其二","author":"苏籀","text":"一薰襟趣昵，掺执便它邦。\n书剑摇烟艇，鸿光醉绮窗。\n县僚迎节盖，齐酝缀羊腔。\n器宇青云士，能名赋练江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孙丞法先池阳二首 其一","author":"苏籀","text":"樗枌里中契，年辈愧君先。\n德迈华腴裔，才优砉剨然。\n牛刀恢勿扰，马首峻高迁。\n交荐诸侯鹗，蓝田崔未贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱乔年被举荐监石井镇","author":"苏籀","text":"石井镇初腾一鹗，管城子健斡千钧。\n已然自足雄吾党，其进祇应轶古人。\n衣被卉裳殊欲惯，解捐犊佩猾商驯。\n万钟他日扶危手，五斗怡怡为奉亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送芍药者一首","author":"苏籀","text":"披猖二十四风花，淑美丰融殿百华。\n畀付碧茎頩粉蕊，薰裁温馥叠鲜葩。\n无言似笑诗魔恼，比韵侔娇女艳加。\n壮岁逐春心欲谢，酥煎靡丽远泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送苏念八郎下第西归梁益","author":"苏籀","text":"金昌亭下泊舟舻，木马关西赵郡苏。\n建邺鱼飧武昌水，延陵皋壤霸王都。\n吾髯轩轶登楼赋，汝器切磨清庙瑚。\n刷羽三馀鸿鹄举，亨衢甲乙看先驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈梦得省闱一首","author":"苏籀","text":"棘闱春晓锁南宫，文柄伊人掌握雄。\n巧射穿杨惊破的，克家长箭挟良弓。\n怀经负笈云霞集，出手成卢月桂丛。\n玉殿赐袍黄纸诏，布衣驰骛黑头公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送富枢知三衢三首 其三","author":"苏籀","text":"山林引避一无求，遄返岩廊岂自由。\n圣主尊贤载谟诰，故家纪善付春秋。\n公诚愿奖朝中意，密勿谋先天下忧。\n臭味久令参籍湜，斐然攀赋畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送富枢知三衢三首 其二","author":"苏籀","text":"代天襟量服英髦，能扈王舟出海潮。\n轻重裴公陈梗切，安危汲孺绝麾招。\n吟笺访古羊腾石，奕局行春柯烂樵。\n谢傅不应丘壑尚，绝尘机警冠当朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送富枢知三衢三首 其一","author":"苏籀","text":"琳馆屡青书带草，玺封荐捧紫芝泥。\n寅车暂此纡台绂，黄阁依前执命圭。\n表按山川裤襦内，劝农云水插秧齐。\n论毗国是惟公韪，令顺民心不曰卑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程孚叟知归州 其一","author":"苏籀","text":"岷江浮万里，吴峤驻弥年。\n笑理归艎去，牢愁失眼前。\n德门桑梓盛，佳郡鹡鸰联。\n委寄参羊陆，宜知备敌先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程孚叟知归州 其二","author":"苏籀","text":"东都人陆海，游集若为忘。\n筮史同微货，僧坊共小凉。\n卜邻栖辇毂，返旆促囊装。\n巽坎知人意，奔腾达侍旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩少汲萍乡尉","author":"苏籀","text":"大门人望旧旌旄，岭表泷头罄错刀。\n中馈从谁合红卺，邮亭自诡絮征袍。\n青衫九品非君愠，黄卷连车慰我曹。\n兰蕙满山山水县，遥知放意咏离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳一首","author":"苏籀","text":"篱根金色小正时，醅垫风高与节期。\n耿耿挑灯闻夜诵，匆匆刈穗饫晨炊。\n闺娃犀蕊香盈把，朝士茱萸酒一卮。\n盖世豪雄健天下，感秋应待羽觞治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻旧曲一首","author":"苏籀","text":"短舞长讴撩性情，狗翻砑鼓醉承平。\n六么花下西湖集，三叠云凝玉塞声。\n治世之音岂沦谢，淫哇已极返和清。\n关雎正雅终知律，前圣尝云畏后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闽中秩满一首","author":"苏籀","text":"蛮府同僚问字奇，老成衣钵旧箴规。\n飓风不讶飞黄雀，污渎犹将贷病鸱。\n前日幕谋非妙伎，今时民瘼愧良医。\n径从南浦携书笈，吉贝裳衣皂帽帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日叹二首 其二","author":"苏籀","text":"褫絺肆簟扇忘閒，轿担肩赪走市阛。\n湫隘蛙蜩欢嘒里，扫除风月广轮间。\n曷云时燠长无冷，却谓天高只好还。\n传癖词源粗超轶，拟如梅尉乐吴山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日叹二首 其一","author":"苏籀","text":"群空冀北食场秸，蹙踏崔嵬憩鹤台。\n泉石系心终眇邈，炎蒸烁体纵恢胎。\n蒂怀寓眼勤呵咄，专气怡神愿力陪。\n公馆亦须延异士，珍包奇酝肆筵开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅舍中秋一首","author":"苏籀","text":"芦笙茆茹野人编，竹几藜床已侈然。\n月满光临感珠夜，风高冷过曝衣天。\n酒浮炉肆人呼友，雀啅梅花鹭睨莲。\n静士兀然方止酒，旧琴不计有无弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"核实一首","author":"苏籀","text":"窥见吕臣非奉己，可怜甘茂取宜阳。\n敢晞激激苏门啸，老去悠悠孔里狂。\n公利噫乎入私帑，滥吹窃尔耗官仓。\n座铭枕几槃盂警，九鼎何心斥被?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别赵大年并侄十七秀才 其二","author":"苏籀","text":"君年有馀富，我老渐来侵。\n莽苍麇鼯野，峙停鸾鹄音。\n藜羹秉觚牍，筚路向山林。\n商略古人意，孜孜不患深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留别赵大年并侄十七秀才 其一","author":"苏籀","text":"晋公宾佐选，英毅冠朝端。\n三日拂冠剑，一时增羽翰。\n世家存器质，国论伫图难。\n从此抛经卷，青毡拜近官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"调王季恭省干","author":"苏籀","text":"治干怪君呼滑八，话言明府取王丞。\n九皋未省山雌雉，三窟不逃秋角鹰。\n僮鬻斛珠如许价，官居鼎钺最难胜。\n孰令手版投耕耒，苦慕如汤厌若冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪侍知府待制丈巾山高设窃闻是日赓和去春林倅红楼风什奉继一首","author":"苏籀","text":"磴藓梯飙最上头，挈排牺象主觥筹。\n从容北海能延客，酣适东风咏倚楼。\n献岁顺成当大有，名儒过计与私忧。\n仰看凤德翔千仞，总领鸳鸾也狎鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜花一首","author":"苏籀","text":"豁眼桃红思圣解，袭人兰郁比脩能。\n面脂靡曼负涂泽，绘綵化工夸斲冰。\n茜粲芳秾触吟境，艳阳风色嗾狂朋。\n倾壶箫管黳蓬鬓，沈顿金觥雹凸棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚秋偶成","author":"苏籀","text":"生涯一笑槁梧横，叶下寒波收潦清。\n金钿露香花近信，乳泓云拨酒新萌。\n岷人罢赋家四壁，洛客懒吟棋一枰。\n流落粗疏分樵牧，故人衮衮任公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望道一首","author":"苏籀","text":"少年相尚依阿语，老大回看不住心。\n望道尊师岂盲进，忧时论事敢浮沈。\n侏儒饱死嗤方朔，悬罄饥贫类展禽。\n好古宜交鲁卫士，豳风咀噍有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅雨一首","author":"苏籀","text":"柑花销殒荔殊小，海上雨云氛气昏。\n感慨干戈异乡客，愁思骨肉与谁论。\n白鱼紫笋清庖隶，卢橘杨梅积市门。\n作吏天涯何所得，一春黄卷伴芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紬史","author":"苏籀","text":"延陵皋壤决归欤，习气过忧觚不觚。\n何怪倚门嗟抗脏，近来合乐宠侏儒。\n过关自欲闻鸡唱，居肆何须较马摸。\n乖合偶然非汝力，迷途先觉解挛拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绵扇偶吟一首","author":"苏籀","text":"拿云擘茧写兰亭，洴絖娃宫箑柄成。\n皎洁中规捐月斧，清雄消暍并桃笙。\n玉毫躔内乘鸾女，冰鉴光中墨客卿。\n爱惜御冬充便面，辟寒抚勉燠屯营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"著书","author":"苏籀","text":"著书前古老虞卿，何必穷愁学乃成。\n驾说精心是家训，修辞肆笔体人情。\n少年竦跃文章慕，老去冲融道术鸣。\n流略从今皆指掌，粗令衰世不喑盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食后出郊一首","author":"苏籀","text":"澹沱东风酒一卮，笙篁鸡鞠傲春晖。\n绿波泛滟心微荡，邃苑提携手未挥。\n藿靡莎长萦冶步，猗傩花亚罥薰衣。\n桃溪飞弹游童过，竹坞闻棋道士归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴日纵步二首 其二","author":"苏籀","text":"云际潺湲入下田，田塍级级逗平泉。\n羊肠荦确褰裳过，蜗壳跧藏插槿边。\n荷蓧何人行叹息，馈浆与客更留连。\n丹霞翠雾皆招隐，一抹残阳众木颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴日纵步二首 其一","author":"苏籀","text":"穷腊末垂风景和，久游诚是我陵阿。\n牧童笛远鸡凫散，猎户弓鸣貒鹿多。\n季雅濙濙疑蜜酿，木奴小小似金柯。\n起溲十裂吴羹酽，止酒陶诗但独哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程帅父朝议年八十馀诸人作诗褒咏次韵一首","author":"苏籀","text":"郎潜华首寤銮舆，连帅元戎十乘车。\n吏道薛公何必问，史才倚相妙称书。\n雍容鸠杖朝裾伟，谈笑蒲鞭法网疏。\n万石恬侯定非晚，闽人安枕梦维鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程帅新作止戈堂索诗谨赋三首 其三","author":"苏籀","text":"楚王禁暴惭京观，汉世残民辟徼边。\n伐叛从来非得已，修文自古属高贤。\n禽鱼草木无垠惠，乡校康庄议论妍。\n尽悴使君朝听美，不然海国岂安全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程帅新作止戈堂索诗谨赋三首 其二","author":"苏籀","text":"都士万家吁盗守，日行三百檄书驰。\n蛮刀短楯相绳擿，章甫毛锥亦可支。\n三道来攻吾设儆，千艘利涉尔焉知。\n三州十万归农亩，櫜戢无穷歌颂诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":1430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]