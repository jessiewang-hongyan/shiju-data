[{"title":"木兰花 其一","author":"晏几道","text":"秋千院落重帘暮，彩笔闲来题绣户。\n墙头丹杏雨馀花，门外绿杨风后絮。\n朝云信断知何处，应作襄王春梦去。\n紫骝认得旧游踪，嘶过画桥东畔路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 其四","author":"晏几道","text":"风帘向晓寒成阵，来报东风消息近。\n试从梅蒂紫边寻，更绕柳枝柔处问。\n来迟不是春无信，开晚却疑花有恨。\n又应添得几分愁，二十五弦弹未尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 其二","author":"晏几道","text":"小颦若解愁春暮，一笑留春春也住。\n晚红初减谢池花，新翠已遮琼苑路。\n湔裙曲水曾相遇，挽断罗巾容易去。\n啼珠弹尽又成行，毕竟心情无会处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花 其五","author":"晏几道","text":"念奴初唱离亭宴，会作离声勾别怨。\n当时垂泪忆西楼，湿尽罗衣歌未遍。\n难逢最是身强健，无定莫如人聚散。\n已拚归袖醉相扶，更恼香檀珍重劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长相思","author":"晏几道","text":"长相思，长相思，若问相思甚了期。\n除非相见时。\n长相思，长相思，欲把相思说似谁。\n浅情人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松 其二","author":"晏几道","text":"心心念念忆相逢。\n别恨谁浓。\n就中懊恼难拼处，是擘钗、分钿匆匆。\n却似桃源路失，落花空记前踪。\n彩笺书尽浣溪红。\n深意难通。\n强欢殢酒图消遣，到醒来、愁闷还重。\n若是初心未改，多应此意须同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风入松 其一","author":"晏几道","text":"柳阴庭院杏梢墙。\n依旧巫阳。\n凤箫已远青楼在，水沈谁、复暖前香。\n临镜舞鸾离照，倚筝飞雁辞行。\n坠鞭人意自凄凉。\n泪眼回肠。\n断云残雨当年事，到如今、几处难忘。\n两袖晓风花陌，一帘夜月兰堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归田乐","author":"晏几道","text":"试把花期数。\n便早有、感春情绪。\n看即梅花吐。\n愿花更不谢，春且长住。\n只恐花飞又春去。\n花开还不语。\n问此意、年年春还会否。\n绛唇青鬓，渐少花前语。\n对花又记得、旧曾游处。\n门外垂杨未飘絮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扑蝴蝶","author":"晏几道","text":"风梢雨叶，绿遍江南岸。\n思归倦客，寻芳来最晚。\n酒边红日初长，陌上飞花正满。\n凄凉数声弦管。\n怨春短。\n玉人应在，明月楼中画眉懒。\n鱼笺锦字，多时音信断。\n恨如去水空长，事与行云渐远。\n罗衾旧香馀暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一","author":"晏几道","text":"雕鞍好为莺花住。\n占取东城南陌路。\n尽教春思乱如云，莫管世情轻似絮。\n古来多被虚名误。\n宁负虚名身莫负。\n劝君频入醉乡来，此是无愁无恨处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其五","author":"晏几道","text":"旗亭西畔朝云住。\n沈水香烟长满路。\n柳阴分到画眉边，花片飞来垂手处。\n妆成尽任秋娘妒。\n袅袅盈盈当绣户。\n临风一曲醉朦腾，陌上行人凝恨去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其十一","author":"晏几道","text":"采莲时候慵歌舞，永日闲从花里度。\n暗随蘋末晓风来，直待柳梢斜月去。\n停桡共说江头路，临水楼台苏小住。\n细思巫峡梦回时，不减秦源肠断处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其三","author":"晏几道","text":"琼酥酒面风吹醒，一缕斜红临晚镜。\n小颦微笑尽妖娆，浅注轻匀长淡净。\n手挼梅蕊寻香径，正是佳期期未定。\n春来还为个般愁，瘦损宫腰罗带剩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其二","author":"晏几道","text":"一尊相遇春风里，诗好似君人有几。\n吴姬十五语如弦，能唱当时楼下水。\n良辰易去如弹指，金盏十分须尽意。\n明朝三丈日高时，共拚醉头扶不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其十二","author":"晏几道","text":"芳年正是香英嫩，天与娇波长入鬓。\n蕊珠宫里旧承恩，夜拂银屏朝把镜。\n云情去住终难信，花意有无休更问。\n醉中同尽一杯欢，归后各成孤枕恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其六","author":"晏几道","text":"离鸾照罢尘生镜。\n几点吴霜侵绿鬓。\n琵琶弦上语无凭，豆蔻梢头春有信。\n相思拼损朱颜尽。\n天若多情终欲问。\n雪窗休记夜来寒，桂酒已消人去恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其一","author":"晏几道","text":"当年信道情无价，桃叶尊前论别夜。\n脸红心绪学梅妆，眉翠工夫如月画。\n来时醉倒旗亭下，知是阿谁扶上马。\n忆曾挑尽五更灯，不记临分多少话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其七","author":"晏几道","text":"东风又作无情计，艳粉娇红吹满地。\n碧楼帘影不遮愁，还似去年今日意。\n谁知错管春残事，到处登临曾费泪。\n此时金盏直须深，看尽落花能几醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其四","author":"晏几道","text":"清歌学得秦娥似，金屋瑶台知姓字。\n可怜春恨一生心，长带粉痕双袖泪。\n从来懒话低眉事，今日新声谁会意。\n坐中应有赏音人，试问回肠曾断未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其八","author":"晏几道","text":"斑骓路与阳台近，前度无题初借问。\n暖风鞭袖尽闲垂，微月帘栊曾暗认。\n梅花未足凭芳信，弦语岂堪传素恨。\n翠眉饶似远山长，寄与此愁颦不尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其九","author":"晏几道","text":"红绡学舞腰肢软，旋织舞衣宫样染。\n织成云外雁行斜，染作江南春水浅。\n露桃宫里随歌管，一曲霓裳红日晚。\n归来双袖酒成痕，小字香笺无意展。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 其十三","author":"晏几道","text":"轻风拂柳冰初绽，细雨消尘云未散。\n红窗青镜待妆梅，绿陌高楼催送雁。\n华罗歌扇金蕉盏，记得寻芳心绪惯。\n凤城寒尽又飞花，岁岁春光常有限。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十三","author":"晏几道","text":"春从何处归，试向溪边问。\n岸柳弄娇黄，陇麦回青润。\n多情美少年，屈指芳菲近。\n谁寄岭头梅，来报江南信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其九","author":"晏几道","text":"远山眉黛长，细柳腰肢袅。\n妆罢立春风，一笑千金少。\n归去凤城时，说与青楼道。\n遍看颍川花，不似师师好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其四","author":"晏几道","text":"坠雨已辞云，流水难归浦。\n遗恨几时休，心抵秋莲苦。\n忍泪不能歌，试托哀弦语。\n弦语愿相逢，知有相逢否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其二","author":"晏几道","text":"轻匀两脸花，淡扫双眉柳。\n会写锦笺时，学弄朱弦后。\n今春玉钏宽，昨夜罗裙皱。\n无计奈情何，且醉金杯酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其三","author":"晏几道","text":"关山魂梦长，鱼雁音尘少。\n两鬓可怜青，只为相思老。\n归梦碧纱窗，说与人人道。\n真个别离难，不似相逢好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十一","author":"晏几道","text":"狂花顷刻香，晚蝶缠绵意。\n天与短因缘，聚散常容易。\n传唱入离声，恼乱双蛾翠。\n游子不堪闻，正是衷肠事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一","author":"晏几道","text":"金鞭美少年，去跃青骢马。\n牵系玉楼人，绣被春寒夜。\n消息未归来，寒食梨花谢。\n无处说相思，背面秋千下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其六","author":"晏几道","text":"轻轻制舞衣，小小裁歌扇。\n三月柳浓时，又向津亭见。\n垂泪送行人，湿破红妆面。\n玉指袖中弹，一曲清商怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其一","author":"晏几道","text":"落梅庭榭香，芳草池塘绿。\n春恨最关情，日过阑干曲。\n几时花里闲，看得花枝足。\n醉后莫思家，借取师师宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其五","author":"晏几道","text":"一分残酒霞，两点愁蛾晕。\n罗幕夜犹寒，玉枕春先困。\n心情剪彩慵，时节烧灯近。\n见少别离多，还有人堪恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其七","author":"晏几道","text":"红尘陌上游，碧柳堤边住。\n才趁彩云来，又逐飞花去。\n深深美酒家，曲曲幽香路。\n风月有情时，总是相思处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其八","author":"晏几道","text":"长恨涉江遥，移近溪头住。\n闲荡木兰舟，误入双鸳浦。\n无端轻薄云，暗作廉纤雨。\n翠袖不胜寒，欲向荷花语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生查子 其十二","author":"晏几道","text":"官身几日闲，世事何时足。\n君貌不长红，我鬓无重绿。\n榴花满盏香，金缕多情曲。\n且尽眼中欢，莫叹时光促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好女儿 其一","author":"晏几道","text":"绿遍西池。\n梅子青时。\n尽无端、尽日东风恶，更霏微细雨，恼人离恨，满路春泥。\n应是行云归路，有闲泪、洒相思。\n想旗亭、望断黄昏月，又依前误了，红笺香信，翠袖欢期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好女儿 其二","author":"晏几道","text":"酌酒殷勤。\n尽更留春。\n忍无情、便赋馀花落，待花前细把、一春心事，问个人人。\n莫似花开还谢，愿芳意、且长新。\n倚娇红、待得欢期定，向水沈烟底，金莲影下，睡过佳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆春时 其二","author":"晏几道","text":"梅梢已有，春来音信，风意犹寒。\n南楼暮雪，无人共赏，闲却玉阑干。\n殷勤今夜，凉月还似眉弯。\n尊前为把，桃根丽曲，重倚四弦看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆春时 其一","author":"晏几道","text":"倚天楼殿，升平风月，彩仗春移。\n鸾丝凤竹，长生调里，迎得翠舆归。\n雕鞍游罢，何处还有心期。\n浓熏翠被，深停画烛，人约月西时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"晏几道","text":"愁黛颦成月浅，啼妆印得花残。\n只消鸳枕夜来闲，晓镜心情便懒。\n醉帽檐头风细，征衫袖口香寒。\n绿江春水寄书难，携手佳期又晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"晏几道","text":"南苑垂鞭路冷，西楼把袂人稀。\n庭花犹有鬓边枝，且插残红自醉。\n画幕凉催燕去，香屏晓放云归。\n依前青枕梦回时，试问闲愁有几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其二","author":"晏几道","text":"来时红日弄窗纱，春红入睡霞。\n去时庭树欲栖鸦。\n香屏掩月斜。\n收翠羽，整妆华，青骊信又差。\n玉笙犹恋碧桃花，今宵未忆家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其一","author":"晏几道","text":"粉痕闲印玉尖纤，啼红傍晚奁。\n旧寒新暖尚相兼，梅疏待雪添。\n春冉冉，恨恹恹，章台对卷帘。\n个人鞭影弄凉蟾，楼前侧帽檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其四","author":"晏几道","text":"天边金掌露成霜。\n云随雁字长。\n绿杯红袖称重阳。\n人情似故乡。\n兰佩紫，菊簪黄。\n殷勤理旧狂。\n欲将沈醉换悲凉。\n清歌莫断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其五","author":"晏几道","text":"晚妆长趁景阳钟，双娥着意浓。\n舞腰浮动绿云浓，樱桃半点红。\n怜美景，惜芳容，沉思暗记中。\n春寒帘幕几重重，杨花尽日风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其三","author":"晏几道","text":"旧香残粉似当初，人情恨不如。\n一春犹有数行书，秋来书更疏。\n衾凤冷，枕鸳孤，愁肠待酒舒。\n梦魂纵有也成虚，那堪和梦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"两同心","author":"晏几道","text":"楚乡春晚。\n似入仙源。\n拾翠处、闲随流水，踏青路、暗惹香尘。\n心心在，柳外青帘，花下朱门。\n对景且醉芳尊，莫话消魂。\n好意思、曾同明月，恶滋味、最是黄昏。\n相思处，一纸红笺，无限啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其二","author":"晏几道","text":"柳间眠，花里醉，不惜绣裙铺地。\n钗燕重，鬓蝉轻，一双梅子青。\n粉笺书，罗袖泪，还有可怜新意。\n遮闷绿，掩羞红，晚来团扇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其四","author":"晏几道","text":"露华高，风信远，宿醉画帘低卷。\n梳洗倦，冶游慵，绿窗春睡浓。\n彩条轻，金缕重，昨日小桥相送。\n芳草恨，落花愁，去年同倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其一","author":"晏几道","text":"槛花稀，池草遍，冷落吹笙庭院。\n人去日，燕西飞，燕归人未归。\n数书期，寻梦意，弹指一年春事。\n新怅望，旧悲凉，不堪红日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其六","author":"晏几道","text":"欲论心，先掩泪，零落去年风味。\n闲卧处，不言时，愁多只自知。\n到情深，俱是怨，惟有梦中相见。\n犹似旧，奈人禁，偎人说寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其三","author":"晏几道","text":"柳丝长，桃叶小，深院断无人到。\n红日淡，绿烟晴，流莺三两声。\n雪香浓，檀晕少，枕上卧枝花好。\n春思重，晓妆迟，寻思残梦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"更漏子 其五","author":"晏几道","text":"出墙花，当路柳，借问芳心谁有。\n红解笑，绿能颦，千般恼乱春。\n北来人，南去客，朝暮等闲攀折。\n怜晚芳，惜残阳，情知枉断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛清波摘遍","author":"晏几道","text":"催花雨小，著柳风柔，都似去年时候好。\n露红烟绿，尽有狂情斗春早。\n长安道。\n秋千影里，丝管声中，谁放艳阳轻过了。\n倦客登临，暗惜光阴恨多少。\n楚天渺。\n归思正如乱云，短梦未成芳草。\n空把吴霜鬓华，自悲清晓。\n帝城杳。\n双凤旧约渐虚，孤鸿后期难到。\n且趁朝花夜月，翠尊频倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其七","author":"晏几道","text":"御纱新制石榴裙。\n沈香慢火熏。\n越罗双带宫样，飞鹭碧波纹。\n随锦字，叠香痕。\n寄文君。\n系来花下，解向尊前，谁伴朝云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其六","author":"晏几道","text":"长因蕙草记罗裙。\n绿腰沈水熏。\n阑干曲处人静，曾共倚黄昏。\n风有韵，月无痕。\n暗消魂。\n拟将幽恨，试写残花，寄与朝云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其二","author":"晏几道","text":"净揩妆脸浅匀眉。\n衫子素梅儿。\n苦无心绪梳洗，闲淡也相宜。\n云态度，柳腰肢。\n入相思。\n夜来月底，今日尊前，未当佳期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其一","author":"晏几道","text":"种花人自蕊宫来，牵衣问小梅。\n今年芳意何似，应向旧枝开。\n凭寄语，谢瑶台，客无才。\n粉香传信，玉盏开筵，莫待春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其五","author":"晏几道","text":"小梅风韵最妖娆，开处雪初消。\n南枝欲附春信，长恨陇人遥。\n闲记忆，旧江皋，路迢迢。\n暗香浮动，疏影横斜，几处溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其三","author":"晏几道","text":"渚莲霜晓坠残红，依约旧秋同。\n玉人团扇恩浅，一意恨西风。\n云去住，月朦胧，夜寒浓。\n此时还是，泪墨书成，未有归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其四","author":"晏几道","text":"凭觞静忆去年秋，桐落故溪头。\n诗成自写红叶，和恨寄东流。\n人脉脉，水悠悠，几多愁。\n雁书不到，蝶梦无凭，漫倚高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诉衷情令 其八","author":"晏几道","text":"都人离恨满歌筵。\n清唱倚危弦。\n星屏别后千里，更见是何年。\n骢骑稳，绣衣鲜。\n欲朝天。\n北人欢笑，南国悲凉，迎送金鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武陵春 其三","author":"晏几道","text":"烟柳长堤知几曲，一曲一魂消。\n秋水无情天共遥，愁送木兰桡。\n熏香绣被心情懒，期信转迢迢。\n记得来时倚画桥，红泪满鲛绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武陵春 其一","author":"晏几道","text":"绿蕙红兰芳信歇，金蕊正风流。\n应为诗人多怨秋，花意与消愁。\n梁王苑路香英密，长记旧嬉游。\n曾看飞琼戴满头，浮动舞梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武陵春 其二","author":"晏几道","text":"九日黄花如有意，依旧满珍丛。\n谁似龙山秋兴浓，吹帽落西风。\n年年岁岁登高节，欢事旋成空。\n几处佳人此会同，今在泪痕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]