[{"title":"赠陆自明","author":"王素行","text":"家世本龟蒙，冥搜趣不穷。\n诗如诸子别，体与老夫同。\n笔影灯窗下，书声雪屋中。\n此时多用力，下字欲清空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"王致","text":"谷暗随呼应，禽春不速来。\n幽居逢令序，跬步且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题袁学士像","author":"王致","text":"平生有志惜分阴，经济功夫着力深。\n一日高飞成远举，几回怀古作豪吟。\n春风频梦丹墀月，夏日长思玉馆琴。\n天下弦歌声已旧，化成都只在公心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞本州教官","author":"王致","text":"年近古稀有，不易升此堂。\n他日留泉下，须留姓氏香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次黄日岩韵","author":"王舫","text":"孤舟闲野渡，竹外小桥通。\n不涉终南径，独高彭泽风。\n云闲钟梵里，月静笑谈中。\n千载留清节，谁云吾道穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次愚谷雪韵","author":"王舫","text":"榾柮炉头夜未阑，冰壶全觉漏声乾。\n前山草木疑长白，下界楼台尽广寒。\n骚客忽惊梅片落，老农先作稻花看。\n何当一奏平淮颂，坐使皇图九鼎安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答陈石泉","author":"王舫","text":"炎气涨空碧，散作藕花秋。\n幽趣兰为佩，浮生芥作舟。\n可人从远别，何日许重游。\n奁玉清无底，楼居第几州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊行次平野韵","author":"王舫","text":"楚泽凄凉笑屈原，行吟如在浣花川。\n风回别墅闻桐角，烟冷荒郊挂纸钱。\n麰麦正香田舍乐，茅柴初熟酒家连。\n锦囊收拾归来晚，踏月闲敲款段鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚憩石门洞","author":"王舫","text":"舣棹石门外，天风吹夕阴。\n疏钟醒客梦，危瀑洗尘襟。\n龙去洞云薄，鹤归松露深。\n旧碑看米字，犹带藓痕侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陶隐居上馆","author":"王莱","text":"最上华阳馆，凄凉岂旧基。\n山中为相日，楼上待仙时。\n精力凋文字，群居厌朮芝。\n却输元处士，薪爨得天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王衮","text":"高空有月千门闭，大道无人独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王衮","text":"探水卓破金鳌头，拨云敲断老虎脚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吴江","author":"王贽","text":"吴江秋水灌平湖，水阔烟深恨有馀。\n因想季鹰当日事，归来未必为莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游淡山岩","author":"王资仁","text":"淡山之景真寻幽，我来为款穷冥搜。\n嵌岩呀豁自呈露，天匠巧斲非人谋。\n撑空突兀几千仞，奇伟万状不可侔。\n群仙秘护人迹绝，元柳不到谁雕锼。\n惜无好语写形似，叹息欲去仍迟留。\n惟予六客信心赏，一洗万古尘中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王资仁","text":"三到澬州不赋诗，溪山应笑懒吟痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝴蝶洞","author":"王铎","text":"庄周已与蝶俱飞，说著遗衣事可疑。\n只怪山中蝴蝶洞，仙家四季总春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明智寺","author":"王陶","text":"邃壑重峦十里过，天围佛境隐岩阿。\n傥来功业忘情久，暂到山林结意多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相公竹","author":"王陶","text":"已枯断竹钧私被，既没贤公帝念深。\n仆木偃禾如不起，至今谁识大忠心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"异服","author":"王陶","text":"辛有叹被发，赵灵喜胡服。\n遂成陆浑戎，终有沙丘辱。\n用夷反变夏，亡礼以从俗。\n先王仁义术，讵用此求福。\n齐桓九合功，不以兵车毂。\n仲尼叹微管，几为左衽属。\n尔来豪侠儿，往往异装束。\n耀武何必然，禦戎有前躅。\n余敢告司关，异服宜禁肃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有窦复者世居镇戎能道边事","author":"王陶","text":"君不见镇戎德顺弓箭手，耕种官田自防守。\n相团置堡禦蕃军，下视贼庭殊不有。\n杀羊取骨燃艾炙，试卜赋兵知拾寇。\n都校招呼入堡居，堡外重围百里馀。\n墙低城小不难破，贼箭如棚城上过。\n堡中不及数十人，且斗且骂且欣欣。\n登陴斫门谓平取，应弦死伤已无数。\n窗间定箭射酋豪，一箭已闻哭声举。\n争将锦囊裹贼尸，鸣金收众唯恐迟。\n不唯城堡依然固，吾众不伤毫与釐。\n自从干戈动四鄙，覆军杀将曾无耻。\n朝廷未省遗边功，何事此勋不闻记。\n安得天兵百万众，尽如此辈坚且勇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛光寺","author":"王陶","text":"五台山上白云浮，云散台高境自幽。\n历代珠幡悬法界，累朝金刹列峰头。\n风雷激烈龙池夜，草木凄凉雁塞秋。\n世路忙忙名利客，尘机到此尽应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游碧落洞","author":"王陶","text":"寻幽碧落外，此境真洞天。\n乳窦穿碧涧，葆树蒙塞烟。\n迹与氛?绝，身亡名利缠。\n日暮懒回首，迟拍洪崖肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云寺","author":"王商翁","text":"幽人何处住，古寺白云高。\n问路不知远，到山方觉劳。\n半窗看竹石，一枕听松涛。\n我亦清幽者，煮茶读楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小蓬莱歌","author":"王埴","text":"仙之山兮□□，仙之水兮委陀。\n驾轻车兮□□，□扁舟兮咏歌。\n轶层巅兮□□，□□流兮白石楚楚。\n上切汉兮□□，□□□兮在下。\n崖花兮春芳，涧□□□□。\n□□澄兮缣素，冰霜结兮璆琅。\n□□□□鱼，鸟跃飞兮谁使。\n石□年兮一□，三万里兮弱水。\n于嗟蓬莱兮仙水是室庐，世之人兮莫知其歌□。\n□□□兮披荆棘，驱虎兕兮□□□。\n□□□兮海涛白，倒光景兮□□□。\n□□□兮执华予，眇流盼兮□□□。\n□□□兮涛无期，碧荔为衣兮□□□。\n□□埃?兮不可以控抟，□□□□□□□憺忘归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"歌 其二","author":"王寂","text":"当年壮气谩如虹，回首都归含笑中。\n群玉峰前好归路，可怜三十二秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"歌 其一","author":"王寂","text":"人间冉冉混尘埃，身后身前事莫猜。\n早悟劳生皆是梦，当时悔向梦中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"䃜山道中","author":"王崇","text":"溅石韵寒泉，依稀言语处。\n回头觉无人，又上前溪去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王棫","author":"王崇拯","text":"渭城杨柳已青青，强住行人听渭城。\n不问使车归路远，且从樽酒满杯倾。\n相逢洮塞休兵后，此去秦州照眼明。\n若立螭头借前箸，且教充国事春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山樵","author":"王崇","text":"山樵竹里居，略彴才堪渡。\n落日澹平畴，牛羊点寒暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荼蘼","author":"王庵僧","text":"雨后荼蘼将结局，风前芍药正催妆。\n道人不管春深浅，赢得山中岁月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"王得益","text":"独上仙槎汴水湄，吟归旧隐赤城西。\n少微昨夜离丹阙，双舄何时到会稽。\n策杖再寻麋鹿径，采芝重蹑薜萝梯。\n云横皓鹤翘松唳，月白孤猿倚树啼。\n象帝真源通阃域，玄元幽趣达筌蹄。\n玉皇歌赐恩殊厚，好把贞珉刻圣题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"应祷诗留天圣观","author":"王惟正","text":"岭外归来者，曾为外计臣。\n无功能报国，抱疾亦忧民。\n乞雨祈诸庙，焚香祷众真。\n精诚达天地，霶霈果均匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霍岳庙","author":"王惟正","text":"耸峻叠寒翠，森森庙木秋。\n崇功封应圣，褒德镇中州。\n辅宋来御署，兴唐占上游。\n义旗初有力，未足答神休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王惟正","text":"云溪水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王晞鸿","text":"峡覆琵琶弯水带，山歌毡帽送江声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和方廷实见赠","author":"王晞韩","text":"谁怜定远不生还，驿骑翩翩出汉关。\n未肯西风回马首，要传飞檄过千山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日郊行","author":"王曼之","text":"出门逢柳色，忽过野桥西。\n坐石看潮长，隔花闻鸟啼。\n地随芳草尽，树与夕阳齐。\n不是桃源路，行人亦自迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西窗","author":"王曼之","text":"西窗枕寒池，池边老松树。\n渴猿下偷泉，见影忽惊去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日山中","author":"王梅窗","text":"客疏吟友少，终日掩柴门。\n冒雨自分菊，带泥移上盆。\n泉添浑井脉，砧响动山根。\n片片西风叶，飞来有病添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄耕绿","author":"王梅窗","text":"孤坐忽叹息，故人成阔疏。\n别三来个月，不得一封书。\n晴雪添岩瀑，寒冰冱野蔬。\n何时分席地，与尔共耕锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林分韵得旧字","author":"杜谨言","text":"竹村喜纡徐，江云迷昏昼。\n踟蹰马上语，嫩寒入衣袖。\n天公惜梅花，破腊开未就。\n端待使君来，春风本依旧。\n一樽既相属，勿辞作诗瘦。\n明年用和羹，请为使君寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李书史四首 其四","author":"王梦应","text":"水叶雪花正可人，陌头客子剑生鳞。\n千年风致未尽歇，如此溪山有弃民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李书史四首 其三","author":"王梦应","text":"火龙骑日雪飞空，劲草亭亭不见风。\n臣亮南阳今未老，一锄云碎日犹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李书史四首 其二","author":"王梦应","text":"山中昼永书一帙，兵后南州健更谁。\n君实中年陪社日，考亭无事注骚诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李书史四首 其一","author":"王梦应","text":"林塘万绿压沈沈，云满吟窝足靓深。\n几朵青山成畏友，一窗白日照初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东归","author":"王梦应","text":"一揖仍为别，他乡复避兵。\n客随风雨老，春著鼓鼙轻。\n宇宙关何事，艰危得此生。\n门前一溪水，几日到江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲申元日","author":"王梦应","text":"上日仍漂寄，尊前客又非。\n乡心眠听雨，病骨晚添衣。\n街鼓春将动，帘灯寒未归。\n梅花经一雪，几片不曾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和清明上冢韵","author":"王梦应","text":"酒壶花担发双明，陌上携扶笑语声。\n桑叶影稠春欲暗，楝花寒退雨初晴。\n宫官记梦曾传烛，□客无诗定罚觥。\n老影年年霜露感，牛羊踯躅乱孤茔。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾东轩二首 其二","author":"王梦应","text":"壮图罹短世，野趣满馀年。\n往事堪垂史，孤踪每畏天。\n广文俄病酒，摩诘厌闻弦。\n遥想南州士，生刍重泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曾东轩二首 其一","author":"王梦应","text":"健笔千夫畏，长才四海空。\n飞腾须掌制，危急逐乘骢。\n国事笺天疏，臣心救日弓。\n故人牛斗上，相见气如虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚望","author":"王梦应","text":"望尽西南一隙明，荒荒野色弄微醺。\n青烟白骨行人老，苦竹黄芦细路分。\n寒雁不来秋似水，故园何处草如云。\n高怀久为凭阑尽，更遣西风化白纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太白仙人下岷峨谣","author":"王梦应","text":"太白仙人下岷峨，飞凌素烟紫琼珂。\n天风万里吹银河，手挼瑶草光逶迤。\n琅琅太清绿云攲，下弄倒影笑羲娥。\n锦袍淋漓金叵罗，醉围婵娟玉颜酡。\n金庭昔日乘鸾过，不肯上天著朝靴。\n下界弱水飞尘多，公为星精辟兵戈。\n愿见瀛海秋澄波，绿鬓纚纚吞天和，后天不老公所哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"王梦应","text":"欲霜更雨，记青云篱落，东风前此。\n帘外客秋人共老，雁与愁飞千里。\n水郭烟明，竹陂波小，万叶寒声起。\n凭高那更，九嶷吹尽云气。\n婉娩空复多情，年年晋梦，花与柴桑是。\n谁解意消风日晚，短笛孤舟林水。\n江蟹笼新，露萸斟浅，浇得乡关思。\n平芜天远，一痕黄抹秋霁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疏影","author":"王梦应","text":"瞢腾晓被，听堕冰屋角，晴哢仍未。\n土湿烟生，庭掩寒青，障泥懒为春试。\n东风旧与花飞去，料记得、年年沙际。\n忍落梅、万点苔根，化作一窗离思。\n犹忆蔫红稚绿，断桥雪未扫，天近春易。\n老对荒寒，事旧人新，雁后不成情味。\n人间解有花如海，待一片、不教随水。\n但玉香、酥影玲珑，逐日暖红云里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 寿王尉癸未冬至后五日","author":"王梦应","text":"问谁歌、暗香疏影，此花堪照人世。\n起持霜月为花寿，天亦愿花千岁。\n谁有意。\n著如此人间，更著花如此。\n高寒洒洒。\n看浩荡刚风，跨虬飞佩，玉影乱如水。\n行春处，一笑人间紫翠。\n纷纷窥此天地。\n寿如川至。\n□好是、涧翁兹岁喜。\n荣沾南儒恩例。\n捧觞更喜郎君美。\n任夜来归侍。\n见说生辰，恰逢本命，寿筵且未。\n听老聃孙子。\n祝公耆艾，祝公富贵。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"锦堂春/锦堂春慢 寿李仁山","author":"王梦应","text":"浅帻分秋，凉尊试月，西风未雁犹蝉。\n看芙蓉影里，绿鬓年年。\n日上云帆压海，尘清玉马行天。\n更烟楼凤举，风幕麟游，锦后珠前。\n绿阴池馆如画，记晴春药径，雨晓芝田。\n已办十年笑语，小聚云边。\n舞称香围艳雪，歌迟酒落红船。\n早群仙归去，柳掖花扶，似雾非烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉太平 送人入湘","author":"王梦应","text":"寒窗月晴。\n寒梢露明。\n一痕归影灯青。\n又分携短亭。\n蘅皋佩云。\n蒸溪酒春。\n有谁勤说归程。\n是峰头雁声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勘灾","author":"王梦雷","text":"散吏驰驱踏旱邱，沙尘泥土掩双眸。\n山中树木减颜色，涧畔泉源绝细流。\n处处桑麻增太息，家家老幼哭无收。\n下官虽有忧民泪，一担难肩万姓忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春游小园","author":"王淇","text":"一从梅粉褪残妆，涂抹新红上海棠。\n开到荼蘼花事了，丝丝天棘出莓墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"王淇","text":"不受尘埃半点侵，竹篱茅舍自甘心。\n只因误识林和靖，惹得诗人说到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题福祐王庙","author":"王淮","text":"关中失鹿人争逐，一去鸿门不可寻。\n千古英雄死遗恨，封侯庙食更何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗皇帝挽词 其一","author":"王淮","text":"炎祚开中叶，龙翔自有真。\n挥戈回日照，洗甲挽天津。\n立极乾坤正，循环雨露新。\n嗣皇能继志，诗为武功陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗皇帝挽词 其二","author":"王淮","text":"历数尧咨舜，羹墙舜见尧。\n三加徽号册，五日未央朝。\n庙祀瞻龙衮，韶音遏凤箫。\n伏蒲思往事，泪湔浙江潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 用吴渊吴潜二公韵","author":"王淮","text":"踏遍江南，予岂为、解衣推食。\n谩赢得、烟波短棹，月楼长笛。\n看剑功名心已死，积薪涕泪今谁滴。\n想中原、一望一伤情，英雄客。\n形势地，还如昔。\n谈笑里，封侯觅。\n岂有于前代，无于今日。\n龙豹莫藏韬略手，犬羊快扫腥膻迹。\n看诸公、事业卜枭卢，何劳掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其一","author":"王罙高","text":"千枝蔓仙牒，眉宇肖苍龙。\n就中天赋英杰，玉磬照金钟。\n满袖春风和气，散在苕溪霅水，讴歌闹儿童。\n好个庙堂样，貂弁马头公。\n烛如椽，香似雾，宴蓬瀛。\n我家寿酒须信，不与世间同。\n昨夜欢传清禁，今日黄堂歌舞，千载一相逢。\n来岁五云里，宣劝折黄封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其二","author":"王罙高","text":"今夕是何夕，南极见祥光。\n自天飘下佳气，五色覆黄堂。\n为借盐梅妙手，暂对裤襦欢颂，森戟护凝香。\n馀事剩吟咏，金薤灿琳琅。\n眷田园，松径旧，菊畦荒。\n欲乘风驭归去，策杖纵相羊。\n物外乾坤自在，壶里无尘日月，千岁傲羲皇。\n天意未应许，军国要平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]