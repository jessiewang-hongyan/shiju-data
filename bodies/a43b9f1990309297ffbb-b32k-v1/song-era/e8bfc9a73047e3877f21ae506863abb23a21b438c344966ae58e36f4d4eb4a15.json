[{"title":"鹧鸪天 其二","author":"谢逸","text":"红晕香腮粉未匀。\n梳妆闲淡稳精神。\n谁知碧嶂清溪畔，也有姚家一朵春。\n眉黛浅，为谁颦。\n莫将心事付朝云。\n坐中有客肠应断，忘了酴醾架下人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"谢逸","text":"水阔天低雁字横。\n小春时节晚寒清。\n梅梢月上纷纷白，竹坞风来冉冉轻。\n人似玉，酒如渑。\n入关意气喜风生。\n坐中有客联镳去，谁唱阳关第四声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹧鸪天","author":"谢逸","text":"桐叶成阴拂画檐。\n清风凉处卷疏帘。\n红绡舞袖萦腰柳，碧玉眉心媚脸莲。\n愁满眼，水连天。\n香笺小字倩谁传。\n梅黄楚岸垂垂雨，草碧吴江淡淡烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题冲佑观","author":"谢塈","text":"一线天回得顺流，几家脩竹满岩幽。\n转头已失来时路，过眼犹怜水上舟。\n仙事渺茫姑勿论，客情萧散故迟留。\n试寻怀玉山人传，更有承平好识不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴中复江渎泛舟","author":"谢景初","text":"雨飞暑馆变秋堂，息驾林祠意绪长。\n笋脱万苞风韵玉，莲开百亩水浮香。\n楸盘力战棋忘味，筠簟清吟扇递凉。\n心惜吏闲文酒乐，雅欢未既即离觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁烟即事","author":"谢景初","text":"时节一百五，疾风收雨天。\n鸟催青帝驭，人重子推钱。\n蹴鞠逢南陌，鞦韆送晚烟。\n墦间无限醉，唯我独萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寻馀姚上林湖山","author":"谢景初","text":"山水有奇秀，何必耳目亲。\n兹地世未知，偶游良可珍。\n平湖瞰其中，翠巘围四垠。\n青松千万植，落瀑如悬巾。\n佛庙耸殿塔，装点绘图新。\n清溪与断崖，水石声磷磷。\n峰巅见沧海，日出常先晨。\n花草时节异，宁问秋夏春。\n陵谷千万古，岂无称道人。\n德微言不信，又恐远故堙。\n樽酒且乐我，醉来事事均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观上林垍器","author":"谢景初","text":"作灶长如丘，取土深于堑。\n踏轮飞为模，覆灰色乃绀。\n力疲手足病，欲憩不敢暂。\n发窑火以坚，百裁一二占。\n里中售高贾，斗合渐收敛。\n持归示北人，难得曾罔念。\n贱用或弃朴，争乞宁有厌。\n鄙事圣犹能，今予乃亲觇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观仙居山瀑布","author":"谢景初","text":"落泉下峭壁，斗绝千万丈。\n溅急雪片飞，望若匹练广。\n曲岭隔青林，三里已闻响。\n其旁有巨石，平润可俯仰。\n愚俗所不道，我辈偶来赏。\n须期秋色清，攀萝将尔上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观馀姚海氛","author":"谢景初","text":"海上风与雨，未眹先气升。\n泽卤杂山云，蓊郁相薰蒸。\n交语面已障，安辨丘与陵。\n衣濡带革缓，臭腥殊可憎。\n自非昌其阳，疾疠得以乘。\n君子却阴邪，何必医师能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馀姚董役海堤有作","author":"谢景初","text":"五行交相陵，海水不润下。\n处处坏堤防，白浪大于马。\n顾予为其长，恐惧敢暂舍。\n董众完筑塞，跋履率旷野。\n使人安于生，兹不羞民社。\n调和阴与阳，自有任责者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法喜堂","author":"谢景初","text":"虚堂庇风雨，结构不务壮。\n外饰无髹髵，置物况容长。\n开箧药剂灵，拈棋白黑抗。\n阶花澹亦夭，庭石碧交向。\n出门鸟雀喧，燕处物我丧。\n吴俗夸有素，佛徒侈相尚。\n独能守质静，坐以矫流宕。\n栖之果自喜，何须山海上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐介南迁 其五","author":"谢景初","text":"谏逐古今有，例为朝政疵。\n况与廊庙臣，世复恶其私。\n安危治乱迹，此事姑置之。\n傥未监谤者，失得何须悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐介南迁 其四","author":"谢景初","text":"身任言责地，眼见公路埋。\n胡宁包心颜，践履天子阶。\n言出谪随至，吏送南海涯。\n一臣不足惜，喋筛狈与豺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐介南迁 其三","author":"谢景初","text":"郁郁炎海旁，气蒸雾露毒。\n得罪往投畀，幸贷吭颈戮。\n彼心学圣贤，于义无不足。\n奈何触主威，未尝有是辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐介南迁 其二","author":"谢景初","text":"木秀风所折，膏明自煎然。\n折固理之必，明性其可迁。\n趋向人各异，公议日月悬。\n开言死不测，喑噤贵且年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送唐介南迁 其一","author":"谢景初","text":"长蛇齿牙毒，谁使赤手捕。\n六月河破堤，捧块捍奔注。\n匹夫徒昭昭，天下皆慕顾。\n后世有至公，此计不为误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"粤俗","author":"谢景初","text":"粤俗嗜海物，鳞介无一遗。\n虾蠃味已厚，况乃蟹与蜞。\n潮来浦屿涨，遮捕张藩篱。\n潮去沙满滩，拾掇盈篱箕。\n杀烹数莫记，琐碎臭且奇。\n苟务贪咀嚼，宁识暴殄悲。\n蛟蜃吐云气，腹以人为饴。\n呀口日肥大，洪波谁敢窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢景初","text":"倒著衣裳迎户外，尽呼儿女拜灯前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢景初","text":"峰巅见沧海，日出常先最。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"若耶溪","author":"钱公辅","text":"若耶溪出若耶山，浪影溶溶入醉颜。\n仙客曾因一箭赠，樵风长到五云关。\n数峰蘸碧轻清外，双舸浮春上下閒。\n料得当年乘兴子，为贪烟水宿前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"谢景温","text":"青琐初辞佩守符，过家衣锦耀乡闾。\n丹心忽厌承明直，白首犹刊丽正书。\n满目湖山真吏隐，半空楼阁信仙居。\n若耶老叟嗟来暮，应向江头待隼旟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题云门山雍熙院","author":"谢景温","text":"耶溪欲尽山转青，中有三寺山为屏。\n秦峰表里植苍翠，仰视万木相峥嵘。\n雪霜洗尽尘土迹，龙蛇蛰处烟氛生。\n我携宾友事登览，穿径已觉毛骨轻。\n穷幽陟险兴不尽，岩房留宿神逾清。\n寒随阴谷一夜来，酒力半酣如不胜。\n狂歌出门步竹径，正见溪桥双月明。\n幽泉乱出石窦响，松风远送哀猿声。\n凌晨后岭纵俯仰，长林翠阜何纵横。\n献之旧地不可辨，悬崖欲断石作坑。\n五云散尽遗迹灭，老僧至今传此名。\n凭高览古复太息，翻嗟万事多废兴。\n丈夫出处固未测，我于山水心难萦。\n区区世路虽可厌，脱身向此诚独醒。\n岂知乘兴事兹乐，赏心不系穷与亨。\n昔人避世非获已，我今安学禽鸟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"谢福娘","text":"闲傍药栏西。\n正是春光三月时。\n深紫浅红光照眼，依稀。\n有似西施醉枕敧。\n摘放胆瓶儿。\n冷艳幽光映酒卮。\n曾记古人题品语，祆知。\n今夜花王得艳妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"谢僎","text":"何时锁钥入吾手，尽发天仓赈世穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生查子 和李商老","author":"谢薖","text":"情亲难语离，且尽玻璃盏。\n双鲤有来时，莫使音书缓。\n征骖去若飞，不道家山远。\n相见小冯君，笑语迎归雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令 陈虚中席上作，赠李商老","author":"谢薖","text":"人似已圆孤月。\n心似丁香百结。\n不见谪仙人，孤负梅花时节。\n愁绝。\n愁绝。\n江上落英如雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神子/江城子","author":"谢薖","text":"破瓜年纪柳腰身。\n懒精神。\n带羞瞋。\n手把江梅，冰雪斗清新。\n不向鸦儿飞处著。\n留乞与，眼中人。\n水精船里酒粼粼。\n皱香茵。\n驻行云。\n舞罢歌馀，花困不胜春。\n问著些儿心底事，才靥笑，又眉颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定风波 七夕莫莫堂席上呈陈虚中","author":"谢薖","text":"牛女心期与目成。\n弥弥脉脉得盈盈。\n今夕银河凭鹊度。\n相遇。\n玉钩新吐照云屏。\n行旆雍容留宴语。\n将暮。\n方携珠袖到山亭。\n寂寞江天正云雾。\n回顾。\n不应中有少微星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 宜雨亭咏千叶海棠","author":"张镃","text":"绿云影里，把明霞、织就千重文绣。\n紫腻红娇扶不起，好是未开时候。\n半怯春寒，半宜晴色，养得胭脂透。\n小亭人静，嫩莺啼破清昼。\n犹记携手芳阴，一枝斜带艳，娇波双秀。\n小语轻怜花总见，争得似花长久。\n醉浅休归，夜深同睡，明日还相守。\n免教春去，断肠空叹诗瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 陈虚中席上和李商老雪词","author":"谢薖","text":"柳絮随风散漫飞。\n檐冰成柱粟生肌。\n力排寒气赖金卮。\n赋丽谁为梁苑客，调高难和郢中词。\n且烦呵笔写乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偷声木兰花 梅","author":"谢薖","text":"景阳楼上钟声晓。\n半面啼妆匀未了。\n斜月纷纷。\n斜影幽香暗断魂。\n玉颜应在昭阳殿。\n却向前村深夜见。\n冰雪肌肤。\n还有斑斑雪点无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其一 和人梅词","author":"谢薖","text":"江边一树。\n愁绝黄昏谁与度。\n琪树琼枝。\n不受雄蜂取次欺。\n风前望处。\n直恐乘风吹得去。\n能动诗情。\n故与诗人独目成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其二 中秋","author":"谢薖","text":"寻常三五。\n坐待丹山飞玉兔。\n试问常娥。\n底事清光此夜多。\n尊空客满。\n纵有鹔鹴无处换。\n不倒金荷。\n可奈金波潋滟何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 其三 赠棋妓","author":"谢薖","text":"风篁度曲。\n倦倚银屏初睡足。\n清簟疏帘。\n金鸭香销懒更添。\n纤纤露玉。\n风雹纵横飞钿局。\n颦敛双蛾。\n凝伫无言密意多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二 梅","author":"谢薖","text":"相思一夜庭花发。\n窗前忽认生尘袜。\n晓起艳寒妆。\n雪肌生暗香。\n佳人纤手摘。\n手与花同色。\n插鬓有谁宜。\n惟应潘玉儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一 陈虚中席上别李商老","author":"谢薖","text":"雪消新洗寒林碧。\n华堂向晚开瑶席。\n一曲杜韦娘。\n有人空断肠。\n谪仙同夜宴。\n晓即归程远。\n莫放酒尊空。\n主人陈孟公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其一 九日和董彦远","author":"谢薖","text":"金钗尽醉何须伴。\n萸糁浮杯乱。\n黄花香返岭梅魂。\n好把一枝斜插、向乌云。\n坡词欲唱无人会。\n桃叶知何在。\n与君同咏一联诗。\n但道老来能趁、菊花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 其二","author":"谢薖","text":"人间离合常相半。\n璧月宁长满。\n九秋风露又方阑。\n何日小窗相对、话悲欢。\n月华临夜宜人醉。\n老去嗟颜悴。\n君如玉树照清空。\n况有凝之道蕴、一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹊桥仙","author":"谢薖","text":"月胧星淡，南飞乌鹊，暗数秋期天上。\n锦楼不到野人家，但门外、清流叠嶂。\n一杯相属，佳人何在，不见绕梁清唱。\n人间平地亦崎岖，叹银汉、何曾风浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 留董之南过七夕","author":"谢薖","text":"一水盈盈牛与女。\n目送经年，脉脉无由语。\n后夜鹊桥知暗度。\n持杯乞与开愁绪。\n君似庾郎愁几许。\n万斛愁生，更作征人去。\n留定征鞍君且住。\n人间岂有无愁处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉蓬莱 中秋有怀无逸兄并示何之忱诸友","author":"谢薖","text":"望晴峰染黛，暮霭澄空，碧天银汉。\n圆镜高飞，又一年秋半。\n皓色谁同，归心暗折，听唳云孤雁。\n问月停杯，锦袍何处，一尊无伴。\n好在南邻，诗盟酒社，刻烛争成，引觞愁缓。\n今夕楼中，继阿连清玩。\n饮剧狂歌，歌终起舞，醉冷光凌乱。\n乐事难穷，疏星易晓，又成浩叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉南歌","author":"谢履","text":"泉州人稠山谷瘠，虽欲就耕无处辟。\n州南有海浩无穷，每岁造舟通异域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"谢慧卿","text":"寻得桃源可学仙，丹书唯恐凤飞传。\n雨收峰顶云归洞，风到池塘月满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过杭州故宫二首 其一","author":"谢翱","text":"禾黍何人为守阍，落花台殿暗销魂。\n朝元阁下归来燕，不见前头鹦鹉言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过杭州故宫二首 其二","author":"谢翱","text":"紫云楼阁宴流霞，今日凄凉佛子家。\n残照下山花雾散，万年枝上挂袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜词","author":"谢翱","text":"愁生山外山，恨杀树边树。\n隔断秋月明，不使共一处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八咏楼","author":"谢翱","text":"江山此愁绝，寒角梦中吹。\n飞鸟过帆影，游尘空戟枝。\n水交明月动，槎洑故州移。\n已薄齐梁士，犹吟沈约诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书文山卷后","author":"谢翱","text":"魂飞万里程，天地隔幽明。\n死不从公死，生如无此生。\n丹心浑未化，碧血已先成。\n无处堪挥泪，吾今变姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西台哭所思","author":"谢翱","text":"残年哭知己，白日下荒台。\n泪落吴江水，随潮到海回。\n故衣犹染碧，后土不怜才。\n未老山中客，唯应赋八哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别子静却送之霅","author":"谢翱","text":"独往知吾事，语离何所求。\n故家无别业，残梦下扁舟。\n积叶吴宫冷，吟猿顾渚秋。\n那能不相待，羁旅负清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈王尚书应麟","author":"谢翱","text":"寒风吹鬓影，客泪湿衣尘。\n千里见积水，满城无故人。\n船歌瓯雪尽，剑舞越花薪。\n独忆丝纶老，相从话所亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜玄英先生画像","author":"谢翱","text":"来此得公真，尘埃避隐沦。\n水生溪榜夕，苔卧野衣春。\n雨冢侵吴甸，荒祠侑汉人。\n微吟值衰世，为尔独伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白纻歌","author":"谢翱","text":"江头蓬沓走吴女，浣水为花朝浣纻。\n昼随睛网晒日中，夜覆井阑飘白露。\n织成素雪裁称身，夫为吴王戍柏举。\n田家岁绩供布缕，独夜讵如妾愁苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"池上萍","author":"谢翱","text":"浮萍随涨水，上到荷叶端。\n水退不得下，犹粘花萼间。\n花殷青已见，叶翠枯始斑。\n何如根在水，根蒂相团团。\n人生慕高远，风云事跻攀。\n绝髯尚号叫，化为鹤与猿。\n幸未及枯槁，万里吾当还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝幢山寻黄提刑震旧避地处","author":"谢翱","text":"甬东寺里逢陈若，双袖龙钟行带索。\n问知黄公旧避逃，宝幢山下坐丛薄。\n日惟一食祷先灵，不愿拾得不死药。\n仰天呼号得正终，一往不复至城郭。\n公初著书女立旁，公死母亡家濩落。\n子为户曹取公女，欲叙因由无与语。\n得来与子行林莽，月落山空识其处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采药候潮山宿山顶精蓝夜中望海","author":"谢翱","text":"蛟门南去鸟，此地望迢迢。\n积湿侵幡黑，生寒入梦飘。\n见灯归舶夜，闻偈解衣朝。\n土植皆为药，山枝不满樵。\n暗光珠母徙，秋影石花消。\n拟候槎回汉，宁甘客老辽。\n却寻徐福岛，因问秦皇桥。\n于彼看日出，羽旌焉可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城西废园","author":"谢翱","text":"水门夹西雨连越，邺瓦耕残莎草茁。\n谁知当日夫容园，湿路迷城暗车辙。\n夫容青根联戚里，美人对博蓬山里。\n潮痕欲上红露晞，知是日高梳洗起。\n园南禁绝人行道，中有民间旧宿草。\n废园起垡鸣窃脂，寒食始应通祭扫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其四","author":"谢翱","text":"落叶昔日雨，地上仅可数。\n今雨落叶处，可数还在树。\n不愁绕树飞，愁有空枝垂。\n天涯风雨心，杂佩光陆离。\n感此毕宇宙，涕零无所之。\n寒花飘夕晖，美人啼秋衣。\n不染根与发，良药空尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其一","author":"谢翱","text":"手持菖蒲叶，洗根涧水湄。\n云生岩下石，影落莓苔枝。\n忽起逐云影，覆以身上衣。\n菖蒲不相待，逐水流下溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其三","author":"谢翱","text":"閒庭生柏影，荇藻交行路。\n忽忽如有人，起视不见处。\n牵牛秋正中，海白夜疑曙。\n野风吹空巢，波涛在孤树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其六","author":"谢翱","text":"弱柏不受雪，零乱苍烟根。\n尚馀粲粲珠，点缀枝叶繁。\n小榻如僧床，下有莓苔痕。\n对此莓苔痕，三年不敢言。\n莓苔傥可食，咽雪待朝暾。\n岂无柏树子，不食种在盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"效孟郊体七首 其七","author":"谢翱","text":"闺中玻黎盆，贮水看落月。\n看月复看日，日月从此出。\n爱此日与月，倾写入妾怀。\n疑此一掬水，中涵济与淮。\n泪落水中影，见妾头上钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]