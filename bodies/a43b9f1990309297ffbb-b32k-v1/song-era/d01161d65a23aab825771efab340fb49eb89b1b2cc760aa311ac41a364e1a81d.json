[{"title":"和戒首座韵","author":"释法薰","text":"两目瞠瞠视碧霄，生吞佛祖气雄豪。\n石潭谁得知深浅，尽日金风鼓怒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和真歇墨迹三颂 其一","author":"释法薰","text":"个事全超浩劫前，借功明位不徒然。\n但能不触亲爷讳，一任冰轮在处圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和真歇墨迹三颂 其三","author":"释法薰","text":"撒手悬空万仞崖，方知佛祖绝梯阶。\n无端诸老争呈丑，未免将身一处埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拈古十四首 其四","author":"释法薰","text":"大家在这里，廓彻无依倚。\n有口难分疏，冻破一双耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空上人乞颂","author":"释法薰","text":"冷泉近日饭箩空，无奈栽田岁不逢。\n有个休粮方子妙，衲僧竞去问天童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"相士朱蓑衣","author":"释法薰","text":"阅世双眸自有神，酒浇胸次语生春。\n一蓑衣底乾坤大，切莫匆匆说向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送小师游方","author":"释法薰","text":"莫辞脚力造诸方，佛法无多要久长。\n历尽崎岖到平地，归来掀倒破禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送干钟","author":"释法薰","text":"大炉鞴里笑翻身，空腹高心许十成。\n好听玉楼撞动处，和声送出太分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送月首座住庵","author":"释法薰","text":"结草为庵自昔贤，古今谁后复谁先。\n客来须得通方句，莫只随邪竖起拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吉州云上人","author":"释法薰","text":"语言动静总天真，叉手徒劳问别人。\n旧说青原白家酒，子归切忌再沾唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送师孙昧禅人","author":"释法薰","text":"十五为僧二十归，途中莫比在家时。\n老僧留浙汝回蜀，三昧从来古不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送炳藏主归乡","author":"释法薰","text":"江海浮游岁月移，五峰曾契少林机。\n白拈果有超师作，和我南山载取归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送祖上人","author":"释法薰","text":"祖祖相传直至今，天高地迥少知音。\n到家人问相传事，但道真鍮不博金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送圆禅人","author":"释法薰","text":"灵山无地可容身，好泛江潮去问津。\n东浙丛林如海阔，但参露柱莫参人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送巢道士","author":"释法薰","text":"一点灵光触处通，心空不见太虚空。\n五千言把为玄妙，湿纸如何裹大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送皎中庵住广寿","author":"释法薰","text":"名字馨香满道途，挽将洞水注南湖。\n他时把杖来轻探，莫谓从前一滴无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送照上人归蜀","author":"释法薰","text":"我堕南来鬓已衰，汝今何得悔来迟。\n乌藤?跳还归那，佛祖从教不展眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧","author":"释法薰","text":"久旱吴田半不收，子今西浙往东州。\n且图有展炊巾处，佛法从教烂却休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送韶化士干灵云古寺基","author":"释法薰","text":"剑客重寻眼翳生，至今孤露不堪闻。\n老韶直下能扶起，十□精神减八分。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送韶铁鞭住西余","author":"释法薰","text":"西余旧说端狮子，解弄如今有几人。\n不是区区谩相屈，要看手眼一时亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚬子和尚赞","author":"释法薰","text":"把个里捞波，做尽穷伎俩。\n推出酒台盘，至今收不上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其十","author":"释法薰","text":"曾到未到俱吃茶，为君抉出眼中花。\n犀因玩月纹生角，象被雷惊花入牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其九","author":"释法薰","text":"安居三月不论玄，水牯朝昏痛著鞭。\n拽脱鼻绳无觅处，山童走得脚皮穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其八","author":"释法薰","text":"无宾主话意深深，流落丛林古到今。\n火冷灰寒口挂壁，衲僧冻死不知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其七","author":"释法薰","text":"冬来底事要商量，向道京师出大黄。\n多少病猫餐死鼠，日中抬首眼无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其六","author":"释法薰","text":"天地根元与我同，拨波求水谩劳功。\n时人见此花如梦，坐断须弥信不通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其五","author":"释法薰","text":"万法归一一何归，海口难酬这一问。\n不得青州一领衫，几乎丧却穷性命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其四","author":"释法薰","text":"百千诸佛在何居，黄鹤楼诗锦不如。\n问汝秀才题也未，一篇题取莫踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其三","author":"释法薰","text":"东村王老夜烧钱，鼻孔依稀露半边。\n武帝求仙求不得，王乔端坐却升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其二","author":"释法薰","text":"百丈机先疾似风，巍巍独坐大雄峰。\n要知奇特中奇特，明月难教下碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其一","author":"释法薰","text":"道人相见问如何，举手寒温事已多。\n潦倒赵州呈漆器，岳阳船子洞庭波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一二三","author":"释法薰","text":"冷水点沸锅，舌头不出口。\n可惜老岩头，慈悲成过咎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一一五","author":"释法薰","text":"相见不须瞋，君穷我亦贫。\n谓言侵早起，更有夜行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其一○○","author":"释法薰","text":"九年坐兀兀，胡僧无妙诀。\n长安路坦然，夜行人不绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其八十三","author":"释法薰","text":"悉达今朝出母胎，无端满目是尘埃。\n山僧倾倒西湖水，索性从头洗一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其七十","author":"释法薰","text":"不结毗卢印，那弘古佛心。\n明月照幽谷，寒涛助夜砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十六","author":"释法薰","text":"通身无觅处，遍界不曾藏。\n闭目中秋坐，却笑月无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其三十五","author":"释法薰","text":"无心亦无法，非法亦非心。\n大勋不竖赏，柴扉草自深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十六","author":"释法薰","text":"解语非干舌，能言不是声。\n斩新提活句，冬后一阳生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其二十","author":"释法薰","text":"老倒慈明为指迷，钓丝绞水出群机。\n时人贪看芦花白，不见沙鸥隔岸飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十八","author":"释法薰","text":"庭开金菊宿根生，来雁新闻一两声。\n犹握金鞭问归客，夜深谁共御街行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百三十三首 其十","author":"释法薰","text":"五祖鹁鸠啼，当机直下提。\n隔山寻蚁迹，能有几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十四","author":"释法薰","text":"夫子不识字，达磨不会禅。\n御楼看射猎，不是刈茅田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十三","author":"释法薰","text":"大海波涛涌，于江水逆流。\n龙王宫殿里，不见一人游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十二","author":"释法薰","text":"吾家那事苦无多，不在频搜故纸箩。\n未解语言先作赋，却参钟阜问如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十一","author":"释法薰","text":"夏末秋初万万千，石头路滑脚皮穿。\n这僧剑刃翻身疾，也被云门索饭钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其五","author":"释法薰","text":"透骨霜风入户庭，日南长至又逢迎。\n衲僧不解论时节，只么堆堆过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十七","author":"释法薰","text":"松柏千年青，不入时人意。\n牡丹一日红，满城公子醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其六十二","author":"释法薰","text":"德山棒头短，临济喝声低。\n不伤物义句，赵州东院西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十九","author":"释法薰","text":"海上明公秀，赵州东院西。\n不移毫发许，平步上云梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其十二","author":"释法薰","text":"巴陵三转语，钝置老僧门。\n灵山无半句，报尽破庵恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十八首 其五","author":"释法薰","text":"大雪满长安，春来特地寒。\n新年头佛法，一点不相瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接待","author":"释法薰","text":"满甑熟炊无米饭，半途长接不来人。\n但持此语诸方去，博得知音一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"断臂僧复田业","author":"释法薰","text":"古人断臂觅安心，岂有他能我不能。\n好手手中誇好手，千年常住一朝僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒岩居士请赞","author":"释法薰","text":"末法无知老比丘，虚空寻缝陆行舟。\n寒岩可谓心肠毒，写出令人骂不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道号毒果","author":"释法薰","text":"铁树花开半夜间，枝头结个子团团。\n古今药杀人无数，不信教伊咬破看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"煎笋","author":"释法薰","text":"锦绣乍脱玉为肌，更著油煎供养伊。\n盐醋费他多少了，舌头换却不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞净慈赴灵隐","author":"释法薰","text":"湖上牢牢把一关，孤危独立绝跻攀。\n老无定力随风转，又向南山过北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端大师","author":"释法薰","text":"峻峺门庭老末山，清风凛凛固难攀。\n古今彼此元无间，只在当人反掌间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题石霜雷迁塔","author":"释法薰","text":"一念慈容元不隔，何须特地肆乖张。\n平高就下婆心切，恼得雷公一夜忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞宗道者","author":"释法薰","text":"走下桐城赤脚归，半风颠又半憨痴。\n草鞋却把袈裟裹，二虎双鸦笑杀伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞蓑衣道人","author":"释法薰","text":"佯狂混迹养天和，上界其如官府多。\n暑了又寒寒又暑，一蓑衣外更无他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠云谷先生","author":"释法薰","text":"卦盘掇转味天机，祸有胎兮福有基。\n昨夜孛星移一位，先生睡著不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠通禅客","author":"释法薰","text":"龙墀问法动天颜，天赠黄金一万钱。\n打得衲僧公验正，通禅依旧是通禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二祖赞","author":"释法薰","text":"觅心无处觅，当下便心安。\n早知冰是水，两臂定完全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三祖赞","author":"释法薰","text":"觅罪不可得，更于何处忏。\n云翳豁然开，青天孤月上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马郎妇赞","author":"释法薰","text":"声色纯真，见闻不碍。\n宴坐经行，得大自在。\n脚头脚底黑漫漫，又逐春风妇马郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干寒山拾得图赞","author":"释法薰","text":"三人必有我师，臭肉元同一味。\n把手聚头，苏卢悉里。\n只因一等饶舌，两个隐身无地。\n可惜当初国清寺里，一队懞憧师僧，更没些子意智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五祖赞","author":"释法薰","text":"栽遍满山松，暗地翻身转。\n虽然得信衣，何曾识爷面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖赞","author":"释法薰","text":"腰石碓坊舂，不识一丁字。\n无树亦无台，犹传钵袋子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞 其二","author":"释法薰","text":"健即经行，倦即打坐。\n思惟四十九年，做得许多口过。\n开眼堂堂，只成话堕。\n浩浩清风树杪来，直下知机能几个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞 其一","author":"释法薰","text":"未出山时，四方风悄悄。\n才出山来，平地洪波涌。\n个般丑举止，邈得将何用。\n也好长时展起，随分爇三钱兜楼香，薰他鼻孔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四祖赞","author":"释法薰","text":"谁缚无人缚，何更求解脱。\n未必右军鹅，便是支郎鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四睡图赞","author":"释法薰","text":"一等骑虎来，两个挨肩去。\n松门外聚头，辊作一处睡。\n梦蝶栩栩不知，孰为人孰为虎。\n待渠眼若开时，南山有一转语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尼了然干藏乞语","author":"释法薰","text":"三绕绳床眼未开，起模画样为安排。\n葛藤桩子如成就，自有龙天出手推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尼长老请赞","author":"释法薰","text":"住山三十载，潦倒福缘微。\n全提一著，衲子攒眉。\n我无沩山之作，汝有铁磨之机。\n自知水底难捞月，却倩丹青染污伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释法薰","text":"杖挑布袋，云生脚下。\n前街后巷，浑无顾籍。\n拊背唤得回，几人能领话。\n也且只得奈烦，铁奉化人难化。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释法薰","text":"辞兜率，混凡尘。\n闭眼昨夜，肚里惺惺。\n何如起来，提却拄杖子，东行西行，忽然等看个人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其二","author":"释法薰","text":"握拂子，坐绳床。\n默尔无言，其声琅琅。\n断衲僧命脉，坏丛林纪纲。\n丹青写出，丑恶难藏。\n一任傍人话短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]