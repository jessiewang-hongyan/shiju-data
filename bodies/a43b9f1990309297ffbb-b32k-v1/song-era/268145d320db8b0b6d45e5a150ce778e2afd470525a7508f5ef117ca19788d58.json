[{"title":"晚登层楼","author":"王同祖","text":"西风吹我上层楼，千载兴亡逝水流。\n数点鸦归江浦晚，一声雁过塞垣秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜 其一","author":"王同祖","text":"匝地阴风黯淡天，怯寒时候只宜眠。\n毡裘羔酒非吾事，自碾新茶和雪煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜 其二","author":"王同祖","text":"风收云捲月当天，独立中庭思悄然。\n市井不知边塞事，呜呜鼓吹乐新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其一","author":"王同祖","text":"长安三月又三日，绣毂狨鞍富贵家。\n笙鼓喧天兰棹稳，卖花声里夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上 其二","author":"王同祖","text":"偶出城来日未西，百花丛底草萋萋。\n游人过尽归来晚，行遍苏公十里堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上早行","author":"王同祖","text":"钱塘门外买湖船，雾气冲云水接天。\n只有苏堤金线柳，半笼早日半笼烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间晚景","author":"王同祖","text":"断桥流水涵虚碧，远岸空山锁晚青。\n勒马为看溪畔景，森森古木暗长汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郑云谷梅窗 其一","author":"王同祖","text":"匆匆岁月为谁忙，静倚梅窗到夕阳。\n老菊不知秋已去，晚风时送短篱香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题郑云谷梅窗 其二","author":"王同祖","text":"爱梅来访小春花，闲卧云房避俗哗。\n唤醒昏昏尘世梦，旋移石鼎煮新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜风","author":"王同祖","text":"一夜霜风动地寒，塞垣火未报平安。\n嫦娥亦带伤心色，为照征人尚抱鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与月船周君话别 其二","author":"王同祖","text":"鸭炉烟冷夜窗寒，著尽冬衣尚怯单。\n忽忆故人千里别，雁赍芳恨度扶栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日 其一","author":"王同祖","text":"一夜东风换斗杓，千门晓色雪初消。\n君王已奏平淮雅，犹自谦冲免会朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚即事","author":"王同祖","text":"矻矻穷年漫逐名，不知七日换新正。\n困人天气浓于酒，赖有梅花唤眼醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观宰相早朝","author":"王同祖","text":"五更三点内门开，御路传呼宰相来。\n天子未明思政理，退朝常是过辰牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐 其二","author":"王同祖","text":"坐到中宵未忍眠，祗今身世两茫然。\n悲欢转眼俱陈迹，休对寒灯说旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂观礼杂咏十三首 其一 观景灵宫恭谢","author":"王同祖","text":"圣皇宗祀怀多福，恭谢回来看带花。\n柷敔笙镛齐合奏，举头更见日光华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴 其五","author":"王同祖","text":"清明过了柳花飞，帘外萋萋草正肥。\n唤起惜春情绪处，空山残月杜鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客","author":"王同祖","text":"千金难买是心知，谁遣相亲又语违。\n杨柳若知行客恨，不教飞絮扑春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观白莲 其五","author":"王同祖","text":"泰华根株本一同，何分白白与红红。\n半池只怕霜风倒，输与苍颜百丈松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上","author":"王同祖","text":"湖头春水千丈碧，湖堤袅柳不盈尺。\n唱歌女儿棹船回，惊起沙鸥对对立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"王同祖","text":"往事星移物换，旧游雨冷云沈。\n真娘墓草几回青。\n问著寒潮不应。\n何处芙蓉别馆，依前杨柳离亭。\n东风吹泪入重扃。\n为唤香魂教醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"王同祖","text":"一帘疏雨细于尘。\n春寒愁杀人。\n桐花庭院近清明。\n新烟浮旧城。\n寻蝶梦，怯莺声。\n柳丝如妾情。\n丙丁帖子画教成。\n妆台求晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿","author":"王同祖","text":"记年时、荔枝香里，深红一片成阵。\n迎风浴露精神爽，谁似阿娇丰韵。\n黄昏近。\n望翠幕玳席，粉面云鬟映。\n娇波微瞬。\n向烛影交相，歌声闲绕，私语画阑并。\n佳期事，好处天还悭吝。\n莺啼燕语无定。\n一轮明月人千里，空梦云温雨润。\n萧郎病。\n恨天阔鸿稀，杳杳沈芳讯。\n日长人静。\n但时把好山，学他媚妩，偷就眉峰印。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁寒亭成题柱自警","author":"王名遂","text":"松荣梅竹秀，三径但含滋。\n不与乾坤老，难令霜雪欺。\n交情存淡薄，世治识艰危。\n前路留教远，终身以自期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答曾节推","author":"王名遂","text":"夫君真自淦川来，书种相承教有台。\n蓬阆得时宜直上，金焦无地却空回。\n荐书共喜从天下，诗句谁能带雨催。\n细数平生归计是，待耕明月种寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双凫","author":"王回","text":"时时行地罗裙掩，双手更擎春潋滟。\n傍人都道不须辞，尽做十分能几点。\n春柔浅蘸蒲萄暖，和笑劝人教引满。\n洛尘忽浥不胜娇，刬蹈金莲行款款。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浙江有感","author":"王回","text":"候潮门外浙江西，曾忆浮舟自此归。\n万古波涛今日是，一身踪迹昔人非。\n愁侵壮齿头先白，泪入秋风眼易眵。\n日暮彷徨不能去，连堤疏柳更依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃","author":"王圭","text":"小桃常忆破正红，今日相逢二月中。\n自是粉闱人未识，莫因花晚笑春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迎春花","author":"刘敞","text":"华省当时绿鬓郎，金樽美酒醉红芳。\n今日对花不成饮，春愁已与草俱长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"市骏坊","author":"王圭","text":"平昔君王事胜游，日斜沧海尚停辀。\n千金骏骨今谁顾，死驾盐车亦未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其五 夫人阁","author":"王圭","text":"月残鳷鹊雪离离，禁里春风自有期。\n晓忆梅花谁为折，从来不许下瑶墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其二 夫人阁","author":"王圭","text":"玉殿闻春到，罗衣照地红。\n君恩深汉帝，不惜舞东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其三 夫人阁","author":"王圭","text":"綵燕迎春入鬓飞，轻寒未放缕金衣。\n苑中忽报花开早，得从銮舆向晚归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其一 夫人阁","author":"王圭","text":"翠缕争垂柳，红酥旋点花。\n林中都未有，疑是旧年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其四 夫人阁","author":"王圭","text":"金缕新幡翠凤翘，侧商催酒转宫腰。\n玉栏风急花零乱，始觉春寒第一朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其五 皇后阁","author":"王圭","text":"雪残宫瓦欲生烟，已觉风光变旧年。\n应自东皇报春后，又扶君德进忠贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其三 皇后阁","author":"王圭","text":"平桥御水破冰痕，忽觉东风遍九门。\n谁道帝家春不早，椒房昨夜已先温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其二 皇后阁","author":"王圭","text":"未染仙人杏，偏柔帝女桑。\n应知蚕事早，不独斗年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其四 皇后阁","author":"王圭","text":"迎得韶光入寿杯，披香华殿倚云开。\n只应王母瑶池宴，又送新春宝胜来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其一 皇后阁","author":"王圭","text":"正道仪中阃，柔风表六宫。\n一倾春日酒，万寿与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其二 皇帝阁","author":"王圭","text":"丽日凝丹阙，光风拂紫闱。\n欲知春色早，先上赭黄衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其三 皇帝阁","author":"王圭","text":"云捧楼台切绛霄，太平天子未央朝。\n帝家春色年年好，万寿觞前奏九韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其五 皇帝阁","author":"王圭","text":"丹门瑞雾紫濛濛，日到蓬莱正殿东。\n只看御炉香欲起，佩环齐响半天中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其一 皇帝阁","author":"王圭","text":"北地凝阴尽，千门淑气新。\n年年金殿里，宝字贴宜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其六 皇帝阁","author":"王圭","text":"春入东郊晓望明，霏霏新两点初成。\n野农岂解知尧力，唯喜年来垄易耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其四 皇帝阁","author":"王圭","text":"禁沼冰开跳锦鲤，御林风暖啭黄鹂。\n金舆未下迎春阁，折遍名花第一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其二 温成皇后阁","author":"王圭","text":"平昔歌声断，凝尘满画梁。\n昭阳新奏曲，谁得奉君觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其三 温成皇后阁","author":"王圭","text":"遥闻碧海有三山，云锁琼楼日月閒。\n花下玉颜常不老，也应春色胜人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其一 温成皇后阁","author":"王圭","text":"御柳依然绿，宫苔取次生。\n黄鹂深处语，不似旧时声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春内中帖子词 其四 温成皇后阁","author":"王圭","text":"宫树沉沉锁玉扉，东风犹是度罗帏。\n此身不及春来燕，又向披香殿里飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会仙石","author":"王圭","text":"奉使群材笑拍肩，玉浆春酒已酡然。\n当时曾舐淮南鼎，亦恐兹山自有仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏坛坊","author":"王圭","text":"几年文字齿将刓，驷马今游一驻鞍。\n自笑不如虎贲士，翻令捉臂笑儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和元参政正月十九日候聚厅移刻未至口占绝句","author":"王圭","text":"日下龙楼禁漏疏，朝衣犹自覆熏炉。\n五房人退文书静，閒看河州瑞麦图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和范景仁内翰留题子履草堂二首 其二","author":"王圭","text":"闻君筑圃多奇植，红蕊黄花落又开。\n惟有庭前岁寒竹，时时双凤下飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和范景仁内翰留题子履草堂二首 其一","author":"王圭","text":"门前车马走尘埃，偶到东园眼暂开。\n鳌岭凤池人去后，不知载酒又谁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴相公南郊春晴题斋宫壁绝句","author":"王圭","text":"玉津驰马柳风斜，雨急金鳞走御沙。\n南亩农民望新霁，不劳云意苦相遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴相公闻南宫放榜喜雨即事绝句","author":"王圭","text":"紫掖清晨捧号来，门前桃李占先开。\n满城风雨逢寒食，更听春岩第一雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和公仪小桃绝句","author":"王圭","text":"粉闱飘雪对清晨，二月桃花始见春。\n莫向东风恨开晚，凤城犹有未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅公仪琴高鱼同圣俞","author":"王圭","text":"三月江南花乱开，青溪曲曲水如苔。\n琴高一去无踪迹，枉是渔人尚见猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎北口","author":"王圭","text":"来无方马去无轮，天险分明限一津。\n愿得玉龙横十万，榆关重识故封人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十六","author":"王圭","text":"内库从头赐舞衣，一番时样一番宜。\n才人特地新装束，生色春衫画折枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十九","author":"王圭","text":"焚香重熨赭黄衣，恐怕朝阳进御迟。\n禁鼓五更交早直，归来还是立班时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十八","author":"王圭","text":"黄昏锁院听宣除，翰长平明趁起居。\n撰就白麻先进草，金泥降出内中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十九","author":"王圭","text":"六宫春色醉仙葩，绮户沉烟望翠华。\n琥珀盘生山芍药，绛纱囊佩木香花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七","author":"王圭","text":"瑶台夜滴金茎露，水殿凉生玉枕风。\n卧看星河归阁晚，月斜疏影转梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十二","author":"王圭","text":"露井银床冻不收，深宫花暗晓莺愁。\n残红满地无人扫，一半随风落御沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十一","author":"王圭","text":"尽日閒琐赌选仙，小娃争觅倒盆钱。\n上筹得占蓬莱岛，一掷乘鸾出洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十二","author":"王圭","text":"雪晴鳷鹊楼边月，风落昭阳殿后梅。\n炉炭灺消香兽暖，独拈香箸拨红灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十","author":"王圭","text":"燕子初来语更新，一声声报内家春。\n遥闻春苑樱桃熟，先进金盘奉紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十一","author":"王圭","text":"红湿春罗染御袍，透帘三丈日华高。\n金针玉尺裁缝处，一对盘龙落剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十三","author":"王圭","text":"内库新函进御茶，龙团春足建溪芽。\n黄封各各题名姓，赐入东西两府家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二","author":"王圭","text":"洛阳新进牡丹丛，种在蓬莱第几宫。\n压晓看花传驾入，露苞方拆御袍红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十九","author":"王圭","text":"鱼藻宫中淑景长，鸭头新水御池塘。\n奇花深院门门闭，总被春风漏泄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十六","author":"王圭","text":"银盆着水洒球场，马嚼衔声立两行。\n齐上玉鞍随仗列，粟金腰带小牌方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十八","author":"王圭","text":"金钲画角警场开，天子南郊玉辂来。\n十里青城遥北望，綵云宫殿月楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十七","author":"王圭","text":"黄金掌上露华稀，朝退君王索辇迟。\n到得经筵春讲罢，海棠花影数砖移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十三","author":"王圭","text":"夜深独倚栏干角，玉笛横吹弄月明。\n馀响度云无处觅，人间闻得两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]