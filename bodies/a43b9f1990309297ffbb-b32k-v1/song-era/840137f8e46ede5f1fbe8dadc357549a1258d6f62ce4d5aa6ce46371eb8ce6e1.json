[{"title":"爱山","author":"喻良能","text":"公子漫誇金谷富，先生祇爱玉川贫。\n山中矫矫七君子，堂上皤皤四老人。\n时引壶觞聊自醉，肯教鹅鸭恼比邻。\n深红浅白兼秾紫，看取林园十亩春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赏月","author":"喻良能","text":"云尽天容静，冰轮故故圆。\n广寒宫阙里，今夕是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉题艇斋","author":"喻良能","text":"平生饱识江湖趣，今日归来鬓似丝。\n闭户松风惊醉耳，恰如鱼浦听潮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经理西山同二客兄弟侄辈侍太孺人游观联句","author":"喻良弼","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"经理西山同二客兄弟侄辈侍太孺人游观联句","author":"喻仲文","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗挽陈提刑 其二","author":"释宝昙","text":"少日牛力在，中年玉节新。\n平生无惮吏，老去只忧民。\n西溯身犹健，东归迹已陈。\n丹丘方在梦，乔木想轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"迎送神辞 其二 送神","author":"李洪","text":"旱既太甚神是吁兮，一勺之水为甘霔兮。\n伊神正直歆诚愫兮，三日为霖弥旬注兮。\n我稼既兴舟在步兮，微我两公余曷愬兮。\n击鼓其镗山之下兮，桂酒椒浆饯神去兮。\n功成惠孚去不顾兮，携幼扶鲐民塞路兮。\n卒相有年多黍稌兮，泽惠无忘永终古兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡抚干再雪诗每句寓再字仍用汝阴诗禁 其二","author":"项安世","text":"力减沙头酒，情添汉浦神。\n有歧俱可可，无鬓不新新。\n淮蔡层城夜，元和二月春。\n遥瞻双阙贺，难预合班人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三雪诗用前韵寓三字 其二","author":"项安世","text":"巴峡疑无路，蓬山似有神。\n极涵天地混，光助日星新。\n开拓大千界，铺张九十春。\n闭门经几日，饥杀咽螬人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五雪诗用前韵寓五字 其二","author":"项安世","text":"眼看山城老，心经木有神。\n燕台六月旧，粤岭一冬新。\n色映康衢色，花沾綵服春。\n瑞多休更辑，禹甸有穷人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五更至城下","author":"项安世","text":"身闲最怕俗间忙，夜短仍妨睡思长。\n戍柝传更催曲枕，领舆将梦踏黄塘。\n湿云裹月江天白，小雨蒸春草树香。\n却到城门听画角，倚空楼堞正苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"沙溪","author":"项安世","text":"沙溪东畔小沙溪，凿石临流唤客题。\n水欲环洲流故曲，山来拥市势全低。\n车声轧轧机中纬，榔响丁丁阵上鼙。\n出处不齐均有役，两轮天上亦东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阻风岳州回寄曹汉阳","author":"项安世","text":"病里牵船去赵沱，醉中题字寄曹皤。\n卧听别语心难遣，起看家山路不多。\n晴日上江卿大好，北风吹浪汝云何。\n早知七日桃花峡，且可千钟竹叶波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨佥判室中竹枝","author":"项安世","text":"懒龙入户养慵枝，罢听风雷却听诗。\n头角不争云雨会，精神如畏雪霜欺。\n莫教画手流传去，生怕时人取次知。\n此腹可怜终不负，琅玕朝暮为君披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久雨","author":"项安世","text":"一春泥水断前街，重闭柴门养绿苔。\n惟有杏梁双海燕，知人曾到十洲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和韵送方翔仲赴省 其二","author":"项安世","text":"苏子书中挦策略，叶家肆里偷新作。\n南宫卷子不须深，句顺声谐即好音。\n调古曲高虽句绝，辞严意密谁笺说。\n清泉白卤贮铜瓶，磨松展楮霜毫明。\n三题奏罢宫门早，行过郎闱惊阁老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阴雨六韵","author":"项安世","text":"滨水地钟湿，关门时过春。\n读书无气力，看字费精神。\n阴雨便高枕，泥涂阻故人。\n小诗随意就，情话与谁亲。\n返照轻霞出，明朝霁色新。\n辛勤愧田父，江上晚耕匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金陵纪游百韵","author":"项安世","text":"舣棹秦淮日，中秋万客船。\n水门高夹岸，河道曲通廛。\n港对青林直，洲横皓鹭鲜。\n会怜桃渡楫，离惜柳亭鞭。\n木志婵娟墓，香埋睥睨颠。\n赏心飞观出，旌德旧题镌。\n沙白寒笼月，波清暝宿烟。\n酒家知是否，商妇唱依然。\n儿病留三月，身閒近半年。\n游山情亹亹，吊古笔翩翩。\n寺觅清凉邃，堂窥德庆悬。\n雉墉寻古址，虎踞出层巅。\n处峻生堪戮，袁刘死合甄。\n山腰舟万竹，峰顶上千川。\n楚甸前开辟，吴山后接连。\n似垣环泰一，如阵拥中权。\n江触崖根转，潮冲石角旋。\n莫愁迷系艇，王浚罢扬旃。\n离殿逃唐暑，精蓝变竺乾。\n虽知悲李主，未免佞金仙。\n兑野情方倦，春墟兴已遄。\n门经白下过，沟傍冶亭沿。\n旧驿分携处，新园欲饯边。\n路趋钟阜近，人畏谷灵专。\n轩冕吾无欲，文移汝勿儇。\n半山悲故相，晚岁悦空诠。\n零落逢诗板，荒寒见采椽。\n骑驴当独往，挟册想深研。\n僧刻前朝诏，农耕绕舍田。\n争堆犹在眼，说字已成筌。\n后嶂当胸阔，中峰覆顶圆。\n披山安万柱，聚衲演三元。\n突兀留髡塔，炜煌志老筵。\n齐梁陈继踵，刀尺拂随肩。\n木末幽轩缀，云间小径穿。\n定林庵莽苍，功德水潺湲。\n洗砚池涵月，栽松干拂天。\n摇摇支败屋，草草订遗篇。\n坛祀阳郊僣，岩居少海偏。\n未穷山背屐，已迫日西鞯。\n朔易需明旦，周遭了胜缘。\n鸡笼残兀兀，玄武断涓涓。\n阅士常于此，倾城每往焉。\n因高营玉帐，就下列金鋋。\n忆昨南朝盛，开湖后苑妍。\n汎舟崇宴席，应诏想英躔。\n牲酒丛祠渎，香灯佛屋虔。\n草堂钟呗肃，兰籍鼓箫阗。\n蒋尉官为帝，周儒宅化禅。\n神兵功易诳，俗驾耻难湔。\n南陌开朱阙，三桥跨碧涟。\n观台誇凤翥，讲席伟牛牵。\n李白愁难解，萧延蔽莫蠲。\n浮云迷帝所，花雨眩胡祆。\n朱雀波声小，乌衣草色蔫。\n讵询华屋础，谁见大航舷。\n郁郁长干迥，岧岧崒堵骞。\n芳峦青宛宛，香径绿芊芊。\n秀水横塘外，平池曲槛前。\n一春来士女，千两拥辎軿。\n郭内清溪好，州东旧迹传。\n名园花隐映，甲第锦蝉联。\n门巷喧车马，楼台沸管弦。\n若非江令出，即是褚公还。\n绮院摧荒圃，瑶池逗浅溅。\n空馀杨袅袅，时有芰娟娟。\n新阁虚堪爱，危桥净可怜。\n花残思战栅，神遇想灵渊。\n步月逢娇魄，弹霜引腻咽。\n金簪花恍惚，银碗意微绵。\n复有陈宫井，深依北垒堧。\n哀声啼断绠，辱色玷清泉。\n栏石文虽暗，亭碑义更宣。\n桐彫疑陨黛，花坠忆飘钿。\n狎客谣琼树，姀嫔踏宝莲。\n自矜鱼目比，宁悟鹊毛填。\n珠玉施窗带，沉檀制屋櫋。\n鬼工三阁就，神器一朝捐。\n證圣无存瓦，台城绝断砖。\n永为前鉴渴，长使后车悛。\n右转遵琳馆，西郛记冶埏。\n谁知黄土贵，下有玉人眠。\n事变明高节，时艰别巨贤。\n光华三卞死，磊落一门全。\n俗爱风流久，人无操行坚。\n忠肝甘虎口，孝骨委蛟涎。\n子岫王公竁，寅冈将相阡。\n麒麟纷杂遝，翁仲蔼蹁跹。\n独美斯邱石，堪同信史编。\n六朝多胜槩，孤冢孰争先。\n我有耽幽癖，家无买墅钱。\n随身凭拄杖，系脚赖行缠。\n此地闻畴素，陪京冠幅员。\n孙刘同相宅，王谢迭扶邅。\n今岁知何幸，兹来得所便。\n侵星赍糗饵，借力荷舆箯。\n吟笑髭频断，登临颈屡延。\n山川穷表里，善恶究芗膻。\n愧匪诗三百，空成字一千。\n更须无党注，还与郑玄笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉归再用前韵","author":"项安世","text":"车中倒载笑儿童，马上扶行夹骥熊。\n安得风流如杜甫，偶然日夕似山公。\n幸无风雨成三厄，遇有圣贤须一中。\n数寄短章劳侍史，捲舒时得近春葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乐景夔生日","author":"项安世","text":"四十九年蘧伯玉，又从湘水向洮河。\n还家趁及垂弧燕，阖郡喧传衣锦过。\n风月平分秋恰半，亲朋来祝寿如何。\n亮功人是长生日，预卜他年事业多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其一 卢运使","author":"项安世","text":"双峰握节国西门，直气森森老更尊。\n一榻独容徐孺子，人间□尽有陈蕃。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其二 杨教授","author":"项安世","text":"溯江而上岂他杨，便是刘家执戟郎。\n拂拭千年旧行处，墨池文字日争光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其三 庞巨渊","author":"项安世","text":"蜀士如何苦摈夔，盛山庞子最能诗。\n天门万里凭谁叫，衡鉴当今四路持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其四 卢武子","author":"项安世","text":"武子才高八面宜，一身何事不兼之。\n精神可惜须完养，瘦骨伶俜玉一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其五 卢道子","author":"项安世","text":"我爱卢家道子贤，悼亡之后只萧然。\n虎儿向我能求字，玉雪肌肤更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其六 潘和叔","author":"项安世","text":"潘郎于我最情长，劝我新滩莫么忙。\n落日系舟崖石下，斯人风味故难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其七 卢智子","author":"项安世","text":"圣门坦坦万人行，欲入先须去路明。\n为报只今卢智子，莫教辜负项先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中怀夔门亲旧八绝 其八 卢似之","author":"项安世","text":"伯庸皇考锡嘉名，所愿儿如此水清。\n莫羡泾人多稻米，长教渔父濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顺风","author":"项安世","text":"十叶乾蒲万斛船，满江箫鼓看登仙。\n不牵百丈摇双橹，坐见红旗上碧川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风回二绝句 其一","author":"项安世","text":"南风欲转北风颠，一夜涛声趣枕边。\n更著三更篷上雨，十风无赖扰清眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风回二绝句 其二","author":"项安世","text":"缆作野叉浮水面，碇如狸爪下船头。\n长年笑语归船去，卧听颠风更不愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十七日衡阳义宰以奚奴墨梅侑客","author":"项安世","text":"铁石心肠宋广平，赋含脂粉太多情。\n固应却有柔荑手，淡拂横枝彻骨清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚自岳麓归","author":"项安世","text":"千张绿锦变明青，岳麓峰前暝霭生。\n万顷玻璃成玛瑙，潇湘江上夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其一","author":"项安世","text":"六月长江白水秋，夜寒银汉入江流。\n台星直下穿云梦，知是西来使者舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其二","author":"项安世","text":"使者东南甲第开，日边云气近蓬莱。\n要令二□知名字，故遣穷边万里回。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其三","author":"项安世","text":"横绝乾坤作四封，秦川马驿与天通。\n北关门到菖蒲海，尽在轺车玉节中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其四","author":"项安世","text":"巴滇绿骏足如风，西域天驹骨似龙。\n日日马纲来不断，君王心已在除□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其五","author":"项安世","text":"北人从古笑南方，只有楼船解把江。\n今日因公致天马，□□闻说已心降。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其六","author":"项安世","text":"蜀道三千鬓发新，九重兴念玉关人。\n芝函宝迹从天下，唤取归来作近臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其七","author":"项安世","text":"翩翩不下楚江鸥，水宿风餐得自由。\n闻道鸾凰上霄汉，亦知惊起却回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送都大茶马入觐八绝句 其八","author":"项安世","text":"何世真无千里马，如今始得九方歅。\n何如牝牡骊黄外，更相权奇磊落人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入鄂州","author":"项安世","text":"重来啧啧两街人，惭愧无功及吏民。\n正是去年平贼后，椎牛酾酒满春城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其一","author":"项安世","text":"熟知宦海波如席，不碍沧洲白鸟双。\n诗来正与我意合，一笑澹然明六窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其二","author":"项安世","text":"主家一妾三千当，教我育我如恐伤。\n如今弃妾归南阳，使我一苇凌苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其三","author":"项安世","text":"我来不饮粤山酒，三百五十九日斋。\n先生付我一大事，正恐乘醉著青鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其四","author":"项安世","text":"开缄忽见王安丰，手阅七言诗一通。\n端能道人意中事，千载之下有国风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其五","author":"项安世","text":"美人读易见三圣，恍惚不堕老与关。\n菰蒲中士有如此，使我日日望龙山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其六","author":"项安世","text":"太守风味今寒儒，惠我佳句春华敷。\n越中溪山犹可似，太守好事天下无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答荆南王君行见寄七首 其七","author":"项安世","text":"锦城虽好劣吾庐，作吏不如归读书。\n千羡万羡王隐居，有田可耕湖可渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后日出三绝句 其一","author":"项安世","text":"驱车清晓入瑶林，玉色珠光冷不禁。\n天意向人相暖热，云头初日万黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后日出三绝句 其二","author":"项安世","text":"勾芒设色满丘园，著粉施朱总可怜。\n未抵天公真画手，金光明里玉山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后日出三绝句 其三","author":"项安世","text":"六日阴寒一夜成，梦回秋月照窗明。\n开门一雪深三尺，展尽寒威便放晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元雷雪","author":"项安世","text":"巫峡苍江一夜雷，南云北梦万花开。\n天作自作烧灯会，不放金莲放玉梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道山梅开最迟作四绝句 其一","author":"项安世","text":"晓窗依约见凝脂，争挽南枝问别离。\n幸有今年春较早，避人何事却开迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道山梅开最迟作四绝句 其二","author":"项安世","text":"走下青泥湿素綦，竹篱苔径有横枝。\n疏花数点凄凉甚，已甚樱桃似雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道山梅开最迟作四绝句 其三","author":"项安世","text":"一年人事几推移，只倚梅花似旧时。\n起懒妆迟花亦老，却教青鬓不成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道山梅开最迟作四绝句 其四","author":"项安世","text":"避妒含羞作态迟，等閒虚度上春时。\n东风已到垂杨树，倚赖清香欲告谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月十七日辞郢州值襄阳人至","author":"项安世","text":"谩说离家已半年，春风吹草绿如烟。\n马军恰与征人会，此出那知不系天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西渡亭别罗郢州","author":"项安世","text":"十七年间四别离，江南江北几驱驰。\n相逢转觉工夫密，不作寻常血气衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴少保春日四首 其一","author":"项安世","text":"正从濠上看鯈鱼，忽向宫中佩虎符。\n出处自殊心自一，依前鱼乐满江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴少保春日四首 其二","author":"项安世","text":"春昼迟时思不迟，笔飞成阵墨成池。\n不书虎卧龙跳字，即赋鲸鱼翡翠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴少保春日四首 其三","author":"项安世","text":"米家书画最难忘，唤起眉间大宅阳。\n酒病春愁都洗尽，贴黄小字荐贤章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴少保春日四首 其四","author":"项安世","text":"弹压江湖景有归，指麾物象思无违。\n不周风顶飞栏上，抚掌人间得失微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其一","author":"项安世","text":"前肩苏叟后陪朱，父子经筵世已无。\n谁见诸孙同盛事，槐龙阴下六丝絇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺范安抚上事十绝 其二","author":"项安世","text":"泰陵初政似昭陵，荣国亲扶晓日升。\n欲把经纶付乔木，内前车马已腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]