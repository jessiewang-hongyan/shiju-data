[{"title":"浣溪沙 其六 上元游静林寺","author":"毛滂","text":"花市东风卷笑声。\n柳溪人影乱于云。\n梅花何处暗香闻。\n露湿翠云裘上月，烛摇红锦帐前春。\n瑶台有路渐无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 寒食初晴，桃杏皆已零落，独牡丹欲开","author":"毛滂","text":"魏紫姚黄欲占春。\n不教桃杏见清明。\n残红吹尽恰才晴。\n芳草池塘新涨绿，官桥杨柳半拖青。\n秋千院落管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十六 泊望仙桥月夜舟中留客","author":"毛滂","text":"晚色轻凉入画船。\n云峰飞尽玉为天。\n疏飙自为月褰帘。\n细酌流霞君且住，更深风月更清妍。\n为谁凄断小桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二十一 泛舟","author":"毛滂","text":"银字笙箫小小童。\n梁洲吹过柳桥风。\n阿谁劝我玉杯空。\n小醉径须眠锦瑟，夜归不用照纱笼。\n画船帘卷月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 慰圃观梅","author":"毛滂","text":"曾向瑶台月下逢。\n为谁回首矮墙东。\n春风吹酒退腮红。\n庾岭殷勤通远信，梅家潇洒有仙风。\n晚香都在玉杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 送汤词","author":"毛滂","text":"蕙炷犹熏百和秾。\n兰膏正烂五枝红。\n风流云散太匆匆。\n仙草已添君胜爽，醉乡肯为我从容。\n剩风残月小庭空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其十九 泛舟还馀英馆","author":"毛滂","text":"烟柳风蒲冉冉斜。\n小窗不用著帘遮。\n载将山影转湾沙。\n略彴断时分岸色，蜻蜓立处过汀花。\n此情此水共天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"毛滂","text":"竹送秋声入小窗。\n香迷夜色暗牙床。\n小屏风掩烛花长。\n雁过故人无信息，酒醒残梦寄凄凉。\n画桥露月冷鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 生日","author":"毛滂","text":"深院绣帘垂。\n前日春归。\n画桥杨柳弄烟霏。\n池面东风先解冻，龟上涟漪。\n酒潋玉东西。\n香暖狻猊。\n远山郁秀入双眉。\n待看碧桃花烂漫，春日迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 其三 归去曲","author":"毛滂","text":"鬓绿飘萧，漫郎已是青云晚。\n古槐阴外小阑干，不负看山眼。\n此意悠悠无限。\n有云山、知人醉懒。\n他年寻我，水边月底，一蓑烟短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 其二 送会宗","author":"毛滂","text":"老景萧条，送君归去添凄断。\n赠君明月满前溪，直到西湖畔。\n门掩绿苔应遍。\n为黄花、频开醉眼。\n橘奴无恙，蝶子相迎，寒窗日短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 其一 松窗午梦初觉","author":"毛滂","text":"一亩清阴，半天潇洒松窗午。\n床头秋色小屏山，碧帐垂烟缕。\n枕畔风摇绿户。\n唤人醒、不教梦去。\n可怜恰到，瘦石寒泉，冷云幽处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 月下观花","author":"毛滂","text":"蔷薇折。\n一怀秀影花和月。\n花和月。\n著人浓似，粉香酥色。\n绿阴垂幕帘波叠。\n微风过竹凉吹发。\n凉吹发。\n无人分付，这些时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"粉蝶儿","author":"毛滂","text":"雪遍梅花，素光都共奇绝。\n到窗前、认君时节。\n下重帏，香篆冷，兰膏明灭。\n梦悠扬，空绕断云残月。\n沈郎带宽，同心放开重结。\n褪罗衣、楚腰一捻。\n正春风，新著摸，花花叶叶。\n粉蝶儿，这回共花同活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑 其二 泰娘","author":"毛滂","text":"香歇。\n袂红黦。\n记立河桥花自折。\n隼旟绀幰城西阙。\n教妾惊鸿回雪。\n铜驼春梦空愁绝。\n云破碧江流月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑 其四 美人赋","author":"毛滂","text":"钗冷。\n鬓云晚。\n罗袖拂人花气暖。\n风流公子来应远。\n半倚瑶琴羞懒。\n云寒日暮天微霰。\n无处不堪肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑 其十 破子","author":"毛滂","text":"花好。\n怕花老。\n暖日和风将养到。\n东君须愿长年少。\n图不看花草草。\n西园一点红犹小。\n早被蜂儿知道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑 其一 崔徽","author":"毛滂","text":"城月。\n冷罗袜。\n郎睡不知鸾帐揭。\n香凄翠被灯明灭。\n花困钗横时节。\n河桥杨柳催行色。\n愁黛有人描得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑 其八 张好好","author":"毛滂","text":"相望。\n楚江上。\n萦水缭云闻妙唱。\n龙沙醉眼看花浪。\n正要风将月傍。\n云车瑶佩成惆怅。\n衰柳白须相向。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其二 留贾耘老","author":"毛滂","text":"曾教风月。\n催促花边烟棹发。\n不管花开。\n月白风清始肯来。\n既来且住。\n风月闲寻秋好处。\n收取凄清。\n暖日阑干助梦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三 李家出歌人","author":"毛滂","text":"小桥秀绝。\n露湿芙蕖花上月。\n月下人人。\n花样精神月样清。\n谁言见惯。\n到了司空情不慢。\n丞相瞋无。\n若不瞋时醉倩扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一 正月十七日，孙守约观残灯。是夕灯火甚盛，而雪消雨作","author":"毛滂","text":"暖风吹雪。\n洗尽碧阶今夜月。\n试觅云英。\n更就蓝桥借月明。\n从教不借。\n自有使君家不夜。\n谁道由天。\n光景随人特地妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 其四","author":"毛滂","text":"恰则心头托托地。\n放下了日多萦系。\n别恨还容易。\n袖痕犹有年时泪。\n满满频斟乞求醉。\n且要时闲忘记。\n明日刘郎起。\n马蹄去便三千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 其三 酒家楼望其南有佳客，招之不至","author":"毛滂","text":"花影低徊帘幕卷。\n惯了双来燕燕。\n惊散雕阑晚。\n雨昏烟重垂杨院。\n云断月斜红烛短。\n望断真个望断。\n情寄梅花点。\n趁风飞过楼南畔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 其一 富阳水寺秋夕望月","author":"毛滂","text":"山转沙回江声小。\n望尽冷烟衰草。\n梦断瑶台晓。\n楚云何处英英好。\n古寺黄昏人悄悄。\n帘卷寒堂月到。\n不会思量了。\n素光看尽桐阴少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 其二 富阳僧舍代作别语赠妓琼芳","author":"毛滂","text":"泪湿阑干花著露，愁到眉峰碧聚。\n此恨平分取，更无言语空相觑。\n断雨残云无意绪，寂寞朝朝暮暮。\n今夜山深处，断魂分付潮回去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"毛滂","text":"桃夭杏好。\n似个人人好。\n淡抹胭脂眉不扫。\n笑里知春占了。\n此情没个人知。\n灯前仔细看伊。\n恰似云屏半醉，不言不语多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其七","author":"毛滂","text":"天连翠潋。\n九折玻璃软。\n回抱金堤清宛转。\n疑共蓬莱清浅。\n吾君欲济如何。\n唐虞风顺无多。\n自有松舟桧楫，一帆三代同波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其十三 元夕","author":"毛滂","text":"东风桂影。\n低拂姮娥镜。\n镜里妆寒酥粉莹。\n越恁十分端正。\n素光行处随人。\n柳边照见青春。\n一片笙箫何处，花阴定有遗簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其八 太师相公生辰","author":"毛滂","text":"娟娟月满。\n冉冉梅花暖。\n春意初长寒力浅。\n渐拟芳菲满眼。\n当时吉梦重重。\n间生天子三公。\n付与人间桃李，年年管领春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其十五 送贾耘老、盛德常还郡。时饮官酒于东堂，二君许复过此","author":"毛滂","text":"杏花时候。\n庭下双梅瘦。\n天上流霞凝碧袖。\n起舞与君为寿。\n两桥风月同来。\n东堂且没尘埃。\n烟艇何时重理，更凭风月相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一 春夜曲","author":"毛滂","text":"兰堂灯灺。\n春入流苏夜。\n衣褪轻红闻水麝。\n云重宝钗未卸。\n知君不奈情何。\n时时慢转横波。\n一饷花柔柳困，枕前特地春多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"毛滂","text":"雪馀寒退。\n唯有青松在。\n春不加荣寒不悴。\n用舍如公都耐。\n流肪磊硌龟蛇。\n会留红日西斜。\n欲助我公寿骨，蟠桃等见开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二","author":"毛滂","text":"重芳叠秀。\n风约仙云皱。\n椿不争年松与寿。\n共出皇家忠孝。\n仁深枯冷皆蒙。\n托根不倚东风。\n日照恩光万里，暖生塞草丛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其十四 春兰用殊老韵","author":"毛滂","text":"曲房青琐。\n浅笑樱桃破。\n睡起三竿红日过。\n冷了沈香残火。\n东风偏管伊家。\n剩教那与秾华。\n谁送一怀春思，玉台燕拂菱花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一 千叶芝","author":"毛滂","text":"九重寒少。\n烟暖丰瑶草。\n金井碧梧雏凤矫。\n南极人来最老。\n衣冠远换裘毡。\n德随和气蝉连。\n万里同开寿域，一年三秀芝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其五","author":"毛滂","text":"锦屏夜夜。\n绣被熏兰麝。\n帐卷芙蓉长不下。\n垂尽银台蜡灺。\n脸痕微著流霞。\n瞢腾越恁秾华。\n破睡半残妆粉，月随雪到梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其十一 己卯长至作","author":"毛滂","text":"流光电急。\n又过书云日。\n旧是天津花下客。\n老对山青水碧。\n而今转惜年华。\n迟阳为缓西斜。\n试问东君音信，晓寒犹压梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其十二 东堂月夕小酌，时寒秀亭下娑罗花盛开","author":"毛滂","text":"云峰秀叠。\n露冷琉璃叶。\n北畔娑罗花弄雪。\n香度小桥淡月。\n与君踏月寻花。\n玉人双捧流霞。\n吸尽杯中花月，仙风相送还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其四 春晚与诸君饮","author":"毛滂","text":"杯深莫厌。\n强看桃花面。\n记约阳和初一线。\n便恁芳菲满眼。\n明年春色重来。\n东堂花为谁开。\n我在芦花深处，钓矶雨绿莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其四","author":"毛滂","text":"九茎为寿。\n千叶前无有。\n叶叶年年看不朽。\n天与君王意厚。\n君恩雨露无边。\n玉筵暖接非烟。\n马向华山烽冷，人安草亦千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"毛滂","text":"镂烟剪雾。\n?鞢无层数。\n苜蓿青深烦雪兔。\n引到祥华开处。\n仙人手翳朝阳。\n清都绛阙相将。\n来覆东封翠辇，好遮化日舒长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 与诸君小酌，烛下见花，戏作一首 其二","author":"毛滂","text":"风摇灺烬。\n吹下桃花影。\n醉倒碧铺眠碎锦。\n谁伴香迷酒凝。\n少年不解孤春。\n年来减尽春心。\n犹下绣帘遮定，不教风雨侵凌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其六","author":"毛滂","text":"银河秋浪。\n遥出昆崙上。\n忽变澄澜添碧涨。\n可道升平无象。\n黄云浊雾初开。\n荣光休气徘徊。\n试觅当时五老，金泥玉检将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其五 绛河清","author":"毛滂","text":"绛河千岁。\n一照升平事。\n万里青铜开碧霁。\n俯见南山晚翠。\n绀寒不翅湘酃。\n清于练静江澄。\n流向万年觞里，玉波可但如渑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其九","author":"毛滂","text":"瀛洲春酒。\n满酌公眉寿。\n日照沙堤春傍柳。\n恩暖朝天衮绣。\n东君著意丁宁。\n芳酸先许梅英。\n要就生平滋味，待公来进君羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其三","author":"毛滂","text":"鬓底青春留不住。\n功名薄似风前絮。\n何似瓮头春没数。\n都占取。\n只消一纸长门赋。\n寒日半窗桑柘暮。\n倚阑目送繁云去。\n却欲载书寻旧路。\n烟深处。\n杏花菖叶耕春雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"毛滂","text":"恰则小庵贪睡著。\n不知风撼梅花落。\n一点儿春吹去却。\n香约略。\n黄蜂犹抱红酥萼。\n绕遍寒枝添索寞。\n却穿竹径随孤鹤。\n守定微官真个错。\n从今莫。\n从今莫负云山约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 戊寅冬，以病告卧潜玉，时时策杖寒秀亭下，作渔家傲三首 其一","author":"毛滂","text":"年少莫寻潜玉老。\n无才无艺烦君笑。\n暖过茅檐霜日晓。\n休起早。\n竹间尽日无人到。\n别径小峰孤碧峭。\n曲沟浅浸寒清绕。\n此老相看情不少。\n浑忘了。\n浑教忘了长安道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 次韵秀倅送别","author":"毛滂","text":"玉卮细酌流霞湿。\n金钗翠袖勤留客。\n行色小梅残。\n官桥杨柳寒。\n赐环宣室夜。\n看落金莲灺。\n人记海听康。\n流风秀水旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其八 赠舞姬","author":"毛滂","text":"当时学舞钧天部。\n惊鸿吹下江湖去。\n家住百花桥。\n何郎偏与娇。\n杏梁尘拂面。\n牙板闻莺燕。\n劝客玉梨花。\n月侵钗燕斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"毛滂","text":"溪山不尽知多少。\n遥峰秀叠寒波渺。\n携酒上高台。\n与君开壮怀。\n枉做悲秋赋。\n醉后悲何处。\n白发几黄花。\n官裘付酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其六 富阳道中","author":"毛滂","text":"春潮曾送离魂去。\n春山曾见伤离处。\n老去不堪愁。\n凭阑看水流。\n东风留不住。\n一夜檐前雨。\n明日觅春痕。\n红疏桃杏村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其七 新城山中雨","author":"毛滂","text":"云山沁绿残眉浅。\n垂杨睡起腰肢软。\n不见玉妆台。\n飞花将梦来。\n行云何事恶。\n雨透罗衣薄。\n不忍湿残春。\n黄莺啼向人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四 重阳","author":"毛滂","text":"淡烟疏雨东篱晓。\n菊团凄露真珠小。\n青蕊抱寒枝。\n因谁特故迟。\n曾是骚人盼。\n羞做茱萸伴。\n揉破郁金黄。\n与君些子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 定空赏梅","author":"毛滂","text":"含章檐下眉如月。\n融酥和粉描疏雪。\n桃杏莫争春。\n凌风台畔人。\n如今千万树。\n零乱孤村雨。\n和雨滴瑶觞。\n归来肌骨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 代赠","author":"毛滂","text":"端端正正人如月。\n孜孜媚媚花如颊。\n花月不如人。\n眉眉眼眼春。\n沈香添小炷。\n共挹熏炉语。\n香解著人衣。\n君心蝴蝶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 昔游","author":"毛滂","text":"灯雾里。\n老去昔游不记。\n月似旧时人不似。\n小楼何处是。\n归卧晚香翠被。\n玉酒著人小醉。\n欲睡先来都不睡。\n此情那恁地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散馀霞","author":"毛滂","text":"墙头花□寒犹噤。\n放绣帘昼静。\n帘外时有蜂儿，趁杨花不定。\n阑干又还独凭。\n念翠低眉晕。\n春梦枉恼人肠，更厌厌酒病。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼 其一 散后","author":"毛滂","text":"微雨过，深院芰荷中。\n香冉冉，绣重重。\n玉人共倚阑干角，月华犹在小池东。\n入人怀，吹鬓影，可怜风。\n分散去、轻如云与梦，剩下了、许多风与月，侵枕簟，冷帘栊。\n副能小睡还惊觉，略成轻醉早醒松。\n仗行云，将此恨，到眉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"最高楼 其二 春恨","author":"毛滂","text":"新睡起，熏过绣罗衣。\n梳洗了，百般宜。\n东风淡荡垂杨院，一春心事有谁知。\n苦留人，娇不尽，曲眉低。\n漫良夜、月圆空好意，恐落花、流水终寄恨，悲欢往往相随。\n凤台痴望双双羽，高唐愁著梦回时。\n又争如，遵大路，合逢伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遍地锦 孙守席上咏牡丹","author":"毛滂","text":"白玉阑边自凝伫。\n满枝头、彩云雕雾。\n甚芳菲、绣得成团，砌合出、韶华好处。\n暖风前、一笑盈盈，吐檀心、向谁分付。\n莫与他、西子精神，不枉了、东君雨露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其三 晚酌","author":"毛滂","text":"多病酒尊疏，饮少辄醉。\n年少衔杯可追记。\n无多酌我，醉倒阿谁扶起。\n满怀明月冷，炉烟细。\n云汉虽高，风波无际。\n何似归来醉乡里。\n玻璃江上，满载春光花气。\n蒲萄仙浪软，迷红翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 其一 解秀州郡印，次王倅韵","author":"毛滂","text":"两岁抚邦人，曾无恩意。\n别后何人更相记。\n题舆玉树，愧与蒹葭相倚。\n殷勤犹念我，同吟醉。\n画舸相追，孤城已闭。\n不道扁舟□云外。\n夜分月冷，一段波平风细。\n忆君清兴满，无由寄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]