[{"title":"和李少卿见贻之什","author":"李新","text":"碧江青嶂冷翻光，水镜冰壶照座凉。\n舜日有时琴自动，鲈鱼何处鲙飞香。\n竹开细尾搀先出，雀引新雏底事忙。\n老去得为裴度客，旧来频过郑公乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏晴","author":"李新","text":"髯老新诗锦自裁，雨绡烟帐玉屏开。\n风摩团碧阴云破，檐倒斜红晚景来。\n蚁阵争雄人未觉，蚊雷强聒夜相陪。\n请君日醉兵厨酒，千古英流安在哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐有感并简与讷教授","author":"李新","text":"青灯微火照寒更，不信儒冠误此生。\n翻觉广文官未冷，始闻工部辟初行。\n三年宦况秋萧瑟，一枕时情梦战争。\n思过故园寻故老，旋持春酒看春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官归","author":"李新","text":"旅巢几百指，水国漫三年。\n极望祇秋草，归耕惟石田。\n不成便招隐，渐拟欲安禅。\n那得苏司业，相逢乞酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝岩寺","author":"李新","text":"竹影与溪声，萧萧眼底明。\n秋云浮古树，山石削长城。\n暝色凝黄碧，啼乌伴晚征。\n高僧不知客，故遣作诗鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往银山深道亡寺观暮投宿民居","author":"李新","text":"入谷清光寒刮眼，远分苍树绕楼台。\n急锵环佩溪流迅，晚下牛羊雪迹开。\n山影不随云影转，竹声长作雨声来。\n野梅弄色何人爱，空抱幽香没草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所见","author":"李新","text":"鬓丝萧散忙蚕月，笑靥匀停喜麦秋。\n落照已斜犹曝茧，故人未渡莫横舟。\n屋攲云影长年见，枕压溪声半夜流。\n料得此生无好梦，却胜终日有閒愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经甘相庙","author":"李新","text":"相君天所佑，童子知何神。\n不必茂为祖，因知秦有人。\n一言成大计，千古仰青春。\n庙下尘劳客，将惭白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金牛道中","author":"李新","text":"龙鳞凤翼阻腾骧，仰首青云自渺茫。\n汉月满衣谙客思，巴音侧耳觉吾乡。\n金牛有路通秦惠，筹笔无功愧蜀王。\n祗笑无成谩来往，回头惭愧绿衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金匮道中","author":"李新","text":"白云包裹石城赊，几度亲归梦里家。\n春入小桃浑绮绣，风回残雪半尘沙。\n唐贤碎泻真珠粒，郑老微明白杏花。\n莫道穷边无好语，二公流落亦天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陋夷","author":"李新","text":"疗饥宁采故丘薇，真陋羌夷讵可依。\n火日四山犹堕雪，鬼林六月不单衣。\n药残花萼归方册，狨老金丝触祸机。\n倒指瓜期今已足，早修云翼背西飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青石阻雨","author":"李新","text":"茅屋阴多麦化蛾，西山云重雨流禾。\n未闻回也改其乐，解道虞兮奈若何。\n身与前村孤堠远，泪随流水一溪多。\n文章生世元无力，半岁边城伴枕戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日自锦封归宁过宝岩寺","author":"李新","text":"曲槛横桥尽落梅，春风草木自承恩。\n一身初逐断鸿去，百里犹馀残烧痕。\n回首锦溪花柳市，那如山寺水云村。\n鸣驺喜色知多少，白发双亲笑倚门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游","author":"李新","text":"寂寂茂陵春，文园病后情。\n黄蜂腰欲断，细柳眼初明。\n丽服骈游女，馀酣失老兵。\n残妆深院落，相对任卿卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相鹤轩","author":"李新","text":"别传眼法定何如，不用平平许负书。\n贵客逢轩乘有分，道人得玉食无馀。\n钧天万舞知新奏，华表千年识故居。\n田屋老翁亏鉴戒，伴鸡同放不知渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神泉道中寄李道明","author":"李新","text":"野鸟啼春稍觉空，马蹄何故万山中。\n树连土雨微茫绿，花入麦秋零乱红。\n北阮不知贫气味，谪仙元有旧家风。\n正须洗出青青目，看取新来塞上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荣德夫人挽词","author":"李新","text":"旧池龟去必巢莲，龙隧愁看锦水边。\n肯与玉人俱远宦，自怜王母已高年。\n松窗弦诵亲曹叔，秋月家风起郑玄。\n仙客立朝何所恨，自缘退有可耕田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"药水岩","author":"李新","text":"岩前曾考腐斤樵，洞里仙人不可招。\n龙睡有时悭小雨，春长无地觅灵苗。\n与攻中散平时懒，更沃文园异日消。\n调鼎和羹须玉液，预私清泚注轻瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵壹读书台","author":"李新","text":"台上看书千载客，故基青草白芊绵。\n那由府檄平平起，除到柴车特特贤。\n土俗更无堪计吏，古风空解惜囊钱。\n五行俱下何人见，独有高名伴汉川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送元景参辟廱","author":"李新","text":"老年鹤瘠玉苍苍，送汝难收泪两行。\n短褐尚存慈母线，义居初割紫蜂房。\n埙篪元自音声协，鸿雁而今羽翼长。\n别业未尝收菽粟，一家温饱待文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯梦授试礼部 其二","author":"李新","text":"年来初识小冯君，鞭靮何妨驭晏婴。\n三世卿云涪水秀，一门巢许蜀山清。\n飘零殊幸逢公子，邂逅相看不世情。\n入手华标归早晚，愿扶藜杖出山迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冯梦授试礼部 其一","author":"李新","text":"殷树葱笼绣晓暾，马蹄东去乱冰痕。\n世收徵诏藏商谷，家有新功刻禹门。\n太白夜郎初辱顾，冯唐汉殿欲承恩。\n南山报喜通啼鸟，明日荣归鹤有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘汉特兼简邵子文","author":"李新","text":"绿筱攲墙叶叶声，夜凉风细露华清。\n飘零何幸逢公子，邂逅相看不世情。\n拟向伯伦求酒颂，不知东野解诗鸣。\n三峰峰下文章伯，应忆当年阮步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘金部三首 其三","author":"李新","text":"七里亭中酒满樽，野梅疏淡月黄昏。\n可怜白屋西南士，占得青春雨露恩。\n千载誓言飞将种，一生归报豢龙孙。\n年来佩剑人相笑，宁立孤风昼掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘金部三首 其二","author":"李新","text":"烟老溪花几堕红，高阳闾巷接吴宫。\n禁墙钟断翻新雨，剑岭云寒想去鸿。\n汴水波声天地远，上林春色古今同。\n行观勋策知多少，河水安流敌帐空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘金部三首 其一","author":"李新","text":"绮鸾衔诏碧霜林，按部归来听好音。\n卧看蜀云山历历，行游兰省夜沉沉。\n柔桑平带三川绿，苍桂同铺百里阴。\n天子虚怀求妙道，肯令公负一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送权守解印趋阙","author":"李新","text":"欲挽行人入醉乡，残春岐路日偏长。\n花容贴雨蜂儿静，麦浪翻风燕子凉。\n心计已高刘晏幕，恩波终戴召公棠。\n去思正伴东溪水，听得潺湲更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许东传 其一","author":"李新","text":"碧霄已觉少微明，帝所行看召老成。\n好梦谩依淮水去，秋风空见雪山轻。\n衣冠几许披云雾，父老于今识弟兄。\n黄阁他年开月旦，想公终不解忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许东传 其二","author":"李新","text":"转蓬孤鹤昔流人，千里楼西客此身。\n江海相忘鱼自乐，雪霜已过树回春。\n长安索米非方朔，谷口耕云待子真。\n收拾从来忧国泪，太平无复事沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李才儒 其一","author":"李新","text":"未觉乡关岁月深，转山旗影缓愔愔。\n远人愿见乔卿服，支邑曾随子贱琴。\n摅散幽阴千古恨，发明忠义一生心。\n冰清不屈二天庇，雨化宁逢三日霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李才儒 其二","author":"李新","text":"理官食木遥遥胄，一姓而今万顷麻。\n浑道娄公能耐事，惟馀老子未通家。\n行经阊阖云生足，归到方壶雪弄花。\n休丐一麾江海去，且扶尧日度清华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵马勾二首 其二","author":"李新","text":"芳菊江藜泣冷烟，秋风秋雨老行鞭。\n尝依故国横经笥，犹忆南堂乞火仙。\n月瘴稍昏斜谷路，渔竿空倚北溪船。\n有钱他日邻枌社，待觅嵩阴一顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邵马勾二首 其一","author":"李新","text":"飘零愁杀病参军，点点黄泥渍帽裙。\n藏火解销秦地铁，骑驴重数华山云。\n儿号惟有韩司业，官冷谁怜郑广文。\n身世泡沤浑道得，请君一笑北邙坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周晋叔","author":"李新","text":"妙龄壁水兴何穷，投笔幡然定远功。\n宝仗初依金碧辂，铁鞭閒静海连风。\n萱堂归去椒觞近，珠佩收来汉月空。\n明日紫骝嘶晓雪，故人端在乱山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送知府王大夫 其二","author":"李新","text":"平生和气满襟春，往事飞凫自在身。\n风伯已驱天上雾，凤书仍起汉滨人。\n一鞭草色吟青嶂，几刻花阴梦紫宸。\n从此唐衢哀世泪，为公无复更沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送知府王大夫 其一","author":"李新","text":"一笑行抛汉水湄，野梅残雪照旌旗。\n啼莺未与春先去，归骑犹呼雨自随。\n干禄且优垂老姊，穷经自有起家儿。\n后人觅得松岩石，先刻寒生送别诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送姚深之","author":"李新","text":"急向空花认此身，莫因宦学苦伤贫。\n迟迟海果未成子，忽忽荷衣看作尘。\n玉有细疵那觉病，谷无雌虎自生春。\n还家少鼓男儿气，麈尾驱牛笑煞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡运使 其二","author":"李新","text":"请将龟寿卜椒觞，迟日花塼几刻长。\n千里煖风春梦好，半钩新月绣衣光。\n帝前动笏摇山岳，剑外行车映雪霜。\n湖上柳青归未得，里人争扫德星堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡运使 其一","author":"李新","text":"吴江冰散水溶溶，乍见山花襭眼红。\n六日春容归汉苑，千年桃树倚天风。\n预留黄阁朱衣吏，令侍商丘白发翁。\n元圃长生新酿熟，一杯相属月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡运使 其三","author":"李新","text":"当年姓字列仙曹，醉逐西王折海桃。\n万策水平祥雾合，峨眉岚静使星高。\n泥封明日传清诏，台量何人荐佩刀。\n老去功成解金印，卧云閒笑一生劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱使者三首 其三","author":"李新","text":"翠羽颁书出紫皇，残春岐路日初长。\n花容帖雨蜂儿静，麦浪翻风燕子凉。\n八叶世家方越古，二王振鹭已成行。\n行行才业知多少，千里吴天水满塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱使者三首 其二","author":"李新","text":"玉翰飞过汉江东，蜀道三年兴已穷。\n明日登山临水去，故园啼鸟落花空。\n闻今自草延英奏，合下人推长者风。\n燕麦兔葵初乱眼，欲将修翼问归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钱使者三首 其一","author":"李新","text":"不须回首汉皋亭，白发愁催却易生。\n好梦先依鸾仗去，此身聊伴剑云行。\n随辀芳草真无赖，送客黄鹠似有情。\n故国要知何处是，望湖楼下锦衣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九","author":"李新","text":"出户非我识，长安虽万家。\n有愁焦绿发，无语插黄华。\n酒僻喜宫酝，衾寒怯绛纱。\n欲传此情况，行客在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳","author":"李新","text":"簟篷辞劳始乞身，夹衣温丽燕私辰。\n秋客刮黛披天姣，秫米长腰漱蚁囷。\n黄菊明朝为长菊，江山今日笑醒人。\n不烦孙盛贻嘲弄，预对西风脱醉巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳已后折菊泛酒","author":"李新","text":"芳樽毕献酬，世态等闲休。\n金蕊香犹在，骚人意重留。\n泛觞诗老座，作古饮家流。\n从此重阳后，殷勤送暮秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳后有作","author":"李新","text":"白酒贤人趣，黄花道貌妆。\n物情殊未厌，时节不加长。\n自是良辰往，何妨后会张。\n试看人化鬼，不异露为霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重阳近有作","author":"李新","text":"短晷西风冷，残秋令节频。\n菊花无几日，竹叶劝何人。\n饱稻黄鸡矮，抛房紫栗新。\n时来持此备，未觉野夫贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌云","author":"李新","text":"江汇潨流摇地轴，路穷九顶切彤霄。\n半犁好雨田香润，一簸残花春寂寥。\n土马未騣愁败草，仙人得杖厌灵苗。\n与公莫论从前事，楚些游魂却可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐安叟郊居","author":"李新","text":"旋补疏篱短短遮，郊居初似厌纷华。\n邻灯林腹几萤小，市路山腰一线斜。\n衰草缀珠看晓露，暮天飞墨数归鸦。\n怜君近岁头浑白，两泪临风数祭拿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽史太君词","author":"李新","text":"吴楚云帆万里风，元歌来哭旧江东。\n梁城皓鹤千年恨，蜀垄青松一梦空。\n滏水波声天地远，灞陵山色古今同。\n碑阴且刻东坡语，勋烈将收国史中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张承事词","author":"李新","text":"长吟清啸蜀江干，一尺霜根向物寒。\n吾道祗知尊孔子，奇书何用学刘安。\n玄谈客去虚方丈，碧落雏归迅羽翰。\n晓月流星无处觅，断云空著子陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽崇宁王雅桥杨公善宣教词","author":"李新","text":"何必他杨重蜀苗，关西华胄固遥遥。\n大成殿老身先倡，贝叶书成血未消。\n金马祥光开旧地，玉虹寒影卧新桥。\n伟翁有子全忠孝，行看圭璋荐盛朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓起","author":"李新","text":"晓禽聒起坐薪床，梳裹斑丝短短苍。\n瓮面拨来蛆子白，花心飞出蝶须黄。\n游蜂声沓晨衙退，细篆香萦碧线长。\n已约邻家来小饮，是中容得次公狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花菊","author":"李新","text":"秋雨秋风夜，闲为桃菊吟。\n任香飘涧水，回翠入篱金。\n苦李自胡越，幽兰初腹心。\n故山千里外，回首暝烟深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮春斋","author":"李新","text":"烟鼎金颜碧线长，是中日日载春阳。\n翠翰结屋惊鳌背，绿叶翻波梦水乡。\n静昼鸟啼三月老，路人风送百花香。\n从它流出红英去，化作人间有韵妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别寄元裕","author":"李新","text":"耳熟英声相见晚，解颜一笑尽天真。\n有鱼待客不妨醉，无玉藏花初厌贫。\n疏竹已留清夜月，好风先断过江尘。\n幽居莫薙庭前草，枕葄他时有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题华严壁","author":"李新","text":"直向忙中得少休，一生缘分属清幽。\n好山不许寻常见，野水从教自在流。\n种竹养茶双碧重，有僧无客四时秋。\n当初著眼如低下，不识光芒射斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中二首 其二","author":"李新","text":"林间风气杳无踪，欲遣谁人慰病慵。\n丐友何颜堪著论，祭拿无泪可沾胸。\n不知心逐摇摇旆，反为官怜楚楚松。\n最是少眠多念处，暝鸦残月五更钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中二首 其一","author":"李新","text":"虚名毕竟耳边风，梦入巢由事一空。\n贫窭未能防鬼笑，悲哀端更遇途穷。\n胡沙十月惊弦雁，水国三年食蓼虫。\n得似此身无好味，病馀明日即衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笋竹","author":"李新","text":"峥嵘泽国与烟村，饱见尖尖破土痕。\n稍倩南风开鹊尾，数烦夜雨送龙孙。\n平生直节初挥箨，后日清阴自庇根。\n残月莫云林外看，森森矛戟万军屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读五代史","author":"李新","text":"瓜割沟分几战场，坎蛙穴蚁自侯王。\n铁枪妄谓千人敌，溺器犹须七宝妆。\n诸国岂能臣癞子，九龙那得贮归郎。\n堪悲五十年来事，荼毒蒸民倍感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资州邓园","author":"李新","text":"苍官愯愯护重岗，绿玉寒梢亚短墙。\n春事鸟啼三月老，路人风送百花香。\n蜂衙归去栏干静，江面飞来燕予忙。\n簿领堆中催白发，不知閒日许多长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁山祠成二首 其二","author":"李新","text":"缥缈团空翠一围，丛神社鼓日相依。\n阴天几处看云阵，夜雪何时化铁衣。\n鸟鼠莫栖新蕊殿，风尘从染旧龙旗。\n门前汗马蹄翻玉，犹似当年力战归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁山祠成二首 其一","author":"李新","text":"千岭分岗一岭西，一峰骧首万峰低。\n仰看木杪楼台小，犹听云端甲马嘶。\n暮角回风吹落叶，晓暾笼树转寒霓。\n要知血食无穷处，阴壑藏雷水绕溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]