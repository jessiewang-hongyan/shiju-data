[{"title":"好事近 其二","author":"赵闻礼","text":"小枕梦催闲，飞雨时鸣高屋。\n挂起西窗人静，听春禽声续。\n鸭塘溪绿涨轻痕，烟柳媚新绿。\n谁伴瘦筇尊酒，弄岩泉飞瀑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鱼游春水","author":"赵闻礼","text":"青楼临远水。\n楼上东风飞燕子。\n玉钩珠箔，密密锁红藏翠。\n剪胜裁幡春日戏。\n簇柳簪梅元夜醉。\n闲忆旧欢，暗弹新泪。\n罗帕啼痕未洗。\n愁见同心双凤翅。\n长安十日轻寒，春衫未试。\n过尽征鸿知几许，不寄萧娘书一纸。\n愁肠断也，那人知未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎 萤","author":"赵闻礼","text":"池馆收新雨。\n耿幽丛、流光几点，半侵疏户。\n入夜凉风吹不灭，冷焰微茫暗度。\n碎影落、仙盘秋露。\n漏断长门空照泪，袖纱寒、映竹无心顾。\n孤枕掩，残灯炷。\n练囊不照诗人苦。\n夜沉沉、拍手相亲，騃儿痴女。\n栏外扑来罗扇小，谁在风廊笑语。\n竞戏踏、金钗双股。\n故苑荒凉悲旧赏，怅寒芜、衰草隋宫路。\n同磷火，遍秋圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其二","author":"赵闻礼","text":"人病酒。\n生怕日高催绣。\n昨夜新翻花样瘦。\n旋描双蝶凑。\n慵凭绣床呵手。\n却说新愁还又。\n门外东风吹绽柳。\n海棠花厮勾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隔浦莲近/隔浦莲近拍","author":"赵闻礼","text":"愁红飞眩醉眼。\n日淡芭蕉卷。\n帐掩屏香润，杨花扑、春云暖。\n啼鸟惊梦远。\n芳心乱。\n照影收奁晚。\n画眉懒。\n微醒带困，离情中酒相半。\n裙腰粉瘦，怕按六么歌板。\n帘卷层楼探旧燕。\n肠断。\n花枝和闷重捻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其一","author":"赵闻礼","text":"客边情味恶。\n花漏远、春静风鸣凤铎。\n空梁燕泥落。\n映柔红微罥，海棠帘箔。\n愁钟恨角。\n怕催人、黄昏索寞。\n拥吟袍、凭暖阑干，醉怯冷香罗薄。\n阿鹊。\n幽芳月淡，紫曲云昏，有人说著。\n名缰易缚。\n归鞭杳，误期约。\n记金泥卜昼，银屏娱夜，弹指匆匆恨错。\n为情多、搀尽芳春，带围瘦觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙 其二 立春","author":"赵闻礼","text":"冻痕消梦草。\n又招得春归，旧家池沼。\n园扉掩寒悄。\n倩谁将花信，偏传深窈。\n追游趁早，便裁却、春衫短帽。\n任残梅、飞满溪桥，和月醉眠清晓。\n年少。\n青丝纤手，彩胜娇鬟，赋情谁表。\n南楼信杳。\n江云重，雁归少。\n记冲香嘶马，流红回岸，几度绿杨残照。\n想暗黄、依旧东风，灞陵古道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行","author":"赵闻礼","text":"照眼菱花，剪情菰叶。\n梦云吹散无踪迹。\n听郎言语识郎心，当时一点谁消得。\n柳暗花明，萤飞月黑。\n临窗滴泪研残墨。\n合欢带上旧题诗，如今化作相思碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵闻礼","text":"西风昨夜摧黄叶，秋亦无心在菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄苏小娟","author":"赵院判","text":"当时名妓镇东吴，不好黄金只好书。\n借问钱塘苏小小，风流还似大苏无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小松","author":"赵顺孙","text":"小小青松未透栏，枝枝叶叶傲霜寒。\n如今正好低头看，异日冲霄仰望难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"赵顺孙","text":"母在堂前为父忧，特令儿子谒公侯。\n大人若肯行方便，一点春风在笔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"染疾吟","author":"赵顺孙","text":"百年世事不胜悲，大厦原非一木支。\n慷慨西风泪横臆，此心唯有老天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病笃吟","author":"赵顺孙","text":"不见人烟空见花，烟笼寒水月笼沙。\n人生自古谁无死，莫怨东风当自嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建回吟","author":"赵顺孙","text":"烽火年来报虏尘，每回回首即长颦。\n明眸皓齿今何在，异服殊音不可亲。\n几树好花閒白昼，数株残柳不胜春。\n狂风落尽深红色，水远山长愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤景吟","author":"赵顺孙","text":"门前不改旧山河，莲渚愁红荡碧波。\n坠叶飘花难再复，浮云流水竟如何。\n鱼龙寂寞秋江冷，鸿雁不来风雨多。\n穷巷悄然车马绝，磬声深戛出烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感情吟","author":"赵顺孙","text":"豪杰消磨叹五陵，发冲乌帽气填膺。\n眼前不是无豪杰，身后何须论废兴。\n当道有蛇魂己断，渡江无马谶难凭。\n可怜一片中原地，虎啸龙腾几战争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢 寿吴宪四月十三","author":"赵宰","text":"洞宾仙客，诞节明朝，方斋今日称觞。\n为有金丹，希年近也康强。\n平生铁石肺腑，肯依阿、贪恋朝行。\n芹溪上，把等闲出处，付与沧浪。\n花竹午桥葱倩，身退静、功名大耐偏长。\n济世经纶，暂时收敛何妨。\n黄扉有分须到，况玉皇、久待平章。\n康时了，万千年、姓字弥香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜别","author":"赵晟母","text":"暖有花枝冷有冰，佳人后会却无凭。\n预愁离别苦相对，挑尽渔阳一夜灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"赵桓","text":"历代恢文偃武，四方晏粲无虞。\n奸臣招致北匈奴。\n边境年年侵侮。\n一旦金汤失守，万邦不救銮舆。\n我今父子在穹庐。\n壮士忠臣何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"赵桓","text":"塞雁嗈嗈南去，高飞难寄音书。\n只应宗社已丘墟。\n愿有真人为主。\n岭外云藏晓日，眼前路忆平芜。\n寒沙风紧泪盈裾。\n难望燕山归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵桓","text":"宸传三百旧京华。\n仁孝自名家。\n一旦奸邪，倾天拆地，忍听琵琶。\n如今在外多萧索，迤逦近胡沙。\n家邦万里，伶仃父子，向晓霜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱 其一","author":"赵烨","text":"道统谁传授，源流易失真。\n滔滔皆四海，亹亹独斯人。\n业履群经粹，词华一世新。\n可嗟天不慭，难赎百年身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吕东莱 其二","author":"赵烨","text":"近接南轩讣，公今事亦休。\n彫零数耆旧，牢落一山丘。\n吾道将穷矣，苍天可问不。\n双溪楼下水，应共哭声流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"合宫歌 皇佑二年飨明堂","author":"赵祯","text":"缵重明。\n端拱保凝命。\n广大孝休德，永锡四海有庆。\n觚坛寓礼正典名。\n幔室雅奏，彩仗崇制定。\n五位仿古甚盛。\n蒿宫光符辰星。\n高秋嘉时款芎灵。\n交累圣。\n上下来顾，寅畏歆纯诚。\n三阶平。\n金气肃，转和景。\n翠葆御双观，巽风兑泽布令。\n脂茶刬荡墨索清。\n远迩向附，动植咸遂性。\n表里穆悦，庶政醇醲，熙然胥庭。\n唐舜华封祝，如南山寿永。\n愿今广怀宁延，昌基扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远朝归","author":"赵耆孙","text":"金谷先春，见乍开江梅，晶明玉腻。\n珠帘院落，人静雨疏烟细。\n横斜带月，又别是、一般风味。\n金尊里。\n任遗英乱点，残粉低坠。\n惆怅杜陇当年，念水远天长，故人难寄。\n山城倦眼，无绪更看桃李。\n当时醉魄，算依旧、裴回花底。\n斜阳外。\n谩回首、画楼十二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜行船","author":"赵軏","text":"今夜阴云初霁。\n画帘外、月华如水。\n露霭晴空，风吹高树，满院中秋意。\n皎皎蟾光当此际。\n怎奈何、不成况味。\n莫近檐间，休来窗上，且放离人睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨礼侍六言","author":"赵载","text":"围青绕绿近在，虚白羊玄本同。\n须知满眼叠嶂，不碍举头太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 寿太守李宗丞","author":"赵通判","text":"贺白文章，英卫规模，簪缨世家。\n更襟怀，芳润光风齐月，笔端奇伟，春藻天葩。\n课最严城，升班清禁，蔽芾棠阴人竞夸。\n争知道，富恩波衮衮，万顷无涯。\n清辉庭桂方花。\n映潋滟仙杯浮紫霞。\n庆云龙风虎，明良际会，鸿勋骏业，重叠辉华。\n寿挹南峰，福迎庐水，未羡还丹九转砂。\n从此去，看腰黄眼赤，迤逦堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梦英大师","author":"赵逢","text":"林峦影里有清贤，与我相知二十年。\n书札爱工精玉箸，利名抛舍住金田。\n吟容贾岛称诗匠，醉许刘灵作酒仙。\n别后近闻栖华岳，乱云应得恣情眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑶台第一层","author":"赵顼","text":"西母池边宴罢，赠南枝、步玉霄。\n绪风和扇，冰华发秀，雪质孤高。\n汉陂呈练影，问是谁、独立江皋。\n便凝望、壶中圭璧，天下琼瑶。\n清标。\n曾陪胜赏，坐忘愁、解使尘消。\n况双成与乳丹点染，都付香梢。\n寿妆酥冷，郢韵佩举，麝卷云绡。\n乐逍遥。\n凤凰台畔，取次忆吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴庆池禊宴","author":"赵寅","text":"斗城初霁媚春晖，托乘寻芳鹤盖飞。\n修禊波深轻急桨，舞雩风暖薄更衣。\n香车宝马嬉游盛，别馆离宫往事非。\n因忆凤池新溜跃，黑轓看逐节函归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三脆面","author":"赵密夫","text":"笋蕈初萌杞采纤，燃松自煮供亲严。\n人间玉食何曾鄙，自是山林滋味甜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅岩 其二","author":"赵崇乱","text":"梅花应只在岩间，无奈官身不可攀。\n几度句中寻夜佛，钜灵安得为移山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅岩 其一","author":"赵崇乱","text":"嵌空天影落元间，更著梅花迥莫攀。\n休说横斜欠清浅，此岩正不减孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金精歌","author":"赵崇怿","text":"东风飞霖雨，一洗桃李尘。\n快马紫游缰，来赏金精春。\n连林翠气妙不动，时作佛髻螺头青。\n劖劖天壁面削起，中可建旗坐万人。\n豁然呀呀，怫然凭凭。\n蹲蹲者为虎豹，兀兀者为墉城。\n千年老狖学春吟，白日龙雷藏树阴。\n莲花峰下久无路，时有樵子攀藤寻。\n丹光出屋水涔涔，白鹤飞去栖桃林。\n桃今几熟枝尚青，石田玉子无龙耕。\n云蒸甑腹烂青䭀，雪冻地骨迷黄精。\n灵君久矣鞭玉麟，今作天上何公卿。\n崖前老竹屡生米，夜有石犬当阶鸣。\n我亦三生家石鼓，花落花开不知数。\n人间渔沫吹秦桥，漫有姓名刻洞府。\n试为灵君觅杯水，水中白昼青虬起。\n便令紫雾生风霆，一举直上九万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙潭寺","author":"赵崇杰","text":"欲觅龙潭何处是，青山影里见浮图。\n红蕖映日真花藏，碧水涵天瑩玉壶。\n已放源流通北海，未饶风物说西湖。\n侍中庵外多闲地，容我他年卜筑无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉子读书","author":"赵崇泞","text":"男儿立志要崚嶒，莫与闾阎较重轻。\n一寸光阴无放过，十年灯火夙修成。\n学疏达境还堪愧，道在穷途亦可亨。\n未必儒冠能见误，书窗努力继芳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读书趣","author":"赵崇洁","text":"溪流静阅万签书，未许传讹杂鲁鱼。\n洙泗渊源应出活，宫墙高大独生虚。\n乾坤容我承三极，造化凭谁托一嘘。\n从此已知身即道，便便熟路驾轻车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游亭晚酌","author":"赵崇洁","text":"一樽对酌晚临溪，诗景撩人兴不迷。\n风约滩声侵座冷，月移花影落檐低。\n银笺白雪心先吐，玉斝黄流手漫提。\n自庆一时文物会，肯拚身世醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丛桂轩 口黄","author":"赵崇㻱","text":"半轩秋雨染鹅黄，望里还疑分外香。\n月到树傍生净想，云开花底拥仙装。\n披襟笑赏和衣馥，携手高攀满袖芳。\n信道男儿输宿愿，一枝早占广寒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丛桂轩 老翠","author":"赵崇㻱","text":"霓裳阿妹舞婆娑，老翠连云秀复华。\n露令山房笼月色，风清池馆落天葩。\n分来窦氏三秋种，斧罢吴生几树花。\n莫讶仙才无用处，一朝队引啸烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丛桂轩 妖白","author":"赵崇㻱","text":"种自姮娥宫里栽，如何亦向世间开。\n偏宜素质妆秋晚，不比晚华怕早摧。\n风递香来薰绮席，月移影上弄瑶台。\n看时直欲令人醉，似向琼林宴御杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丛桂轩 嫩红","author":"赵崇㻱","text":"昨夜西风吹御沟，红摇桂子麝香浮。\n蟾宫影散三千界，玉殿根盘第一流。\n仙骨知非凡俗相，锦标喜簇少年头。\n欲从云外移真种，试向丹梯最上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题关夫子","author":"赵崇琏","text":"天挺孤忠世所钦，桃园口血誓坚金。\n单刀万古英雄胆，明烛一生节义心。\n蜀汉史书传不朽，春秋庙祀有馀歆。\n当年无奈曹孙在，今日曹孙何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题两桥","author":"赵崇琏","text":"一溪夹道枕流水，上有两桥横绝流。\n乌鹊互飞银汉夜，彩虹交映玉潭秋。\n东西雨过苔痕润，左右晴分浪影收。\n谁是当年题柱者，还应并驾到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题曹孝娥","author":"赵崇琏","text":"孝女方童丱，哀诚动鬼神。\n父沈迷死所，己不爱其身。\n苍桧根泉壤，灵祠食水滨。\n中郎八个字，恼得老奸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玩秋月","author":"赵崇森","text":"玉宇秋光无一尘，人人共喜桂花新。\n看来世态炎凉尽，惟有月明无贵贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"砧","author":"赵崇森","text":"谁家夜月响秋砧，一段清愁不自禁。\n况是客中攲枕听，声声捣碎故乡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久旱喜雨","author":"赵崇森","text":"五月炎歊化作霖，分明滴滴是黄金。\n田禾预卜六分熟，河水新添一尺深。\n和气已能周禹甸，至诚端自感汤林。\n此时此泽人知否，大慰饥民望岁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行","author":"赵崇森","text":"贪看湘江景，蓬窗手自扪。\n沙陈鸟行迹，石带水流痕。\n大树多遮庙，疏林间有村。\n芦花自弥望，消得酒盈尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暖","author":"赵崇森","text":"春晴多得两三日，便觉暄于轻暑天。\n行客停鞭争买扇，侍儿启笥请收绵。\n把杯早自嫌温酒，盥手相将喜冷泉。\n此去西湖已初夏，安排絺绤上游船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐逸","author":"赵崇森","text":"懒散数椽下，于人无所求。\n静观棋得趣，闲坐石忘忧。\n对酒红生颊，孤吟白上头。\n高山有佳趣，便欲作清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"赵崇森","text":"今年寒较早，十月雪霏霏。\n冰渚鱼深逝，风林鸟倦飞。\n家人催买炭，客子虑无衣。\n便好骑驴过，羊羔酒正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"椰簟","author":"赵崇森","text":"赠子椰心簟，波纹细欲流。\n来浮南海远，好伴浙西游。\n睡处知温凊，行时便卷收。\n不知风雨夜，能忆故人不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琴","author":"赵崇森","text":"群胥推案去，一客抱琴来。\n唤起高山趣，驱除俗吏埃。\n耳根从此净，指法看君开。\n剩欲传佳操，仙舟且莫回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漏屋雨","author":"赵崇森","text":"官屋无钱可得修，雨来难免震凌忧。\n墙基有罅相将踣，地杖无钉自在浮。\n仆折松枝通夹溜，儿编竹叶学行舟。\n衣衾漂湿浑闲事，且上书楼把画收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三女冈白莲花","author":"赵崇森","text":"旧址来从晋，史更几废兴。\n一莲开陆地，三女卧冈陵。\n题咏誇先辈，流传得主僧。\n林深钟梵寂，长夜一明灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"赵崇森","text":"连朝连夜雨，春尽转潇潇。\n巷陌泥沾足，田畴水浸腰。\n麦黄皆倒穗，桑冻不抽条。\n花事今休矣，祈晴且救苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其二","author":"赵崇渭","text":"一到琳宫事事幽，炎天正好暂时留。\n鹤仙共此泉流乐，气象全胜白鹭洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"赵崇渭","text":"福地天然号洞霄，王畿密迩路非遥。\n淡浓翠碧山重列，圆碎珠玑泉一条。\n九锁真成仙境胜，借行顿使客愁销。\n超凡得道从兹始，未减金华王子乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丫头岩","author":"赵崇鉘","text":"烟雨斑斓石藓春，坠云谁梦宝花颦。\n行人总被虚名误，到得倾城又误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山间","author":"赵崇鉘","text":"山回雾气湿，生意鞠砰隐。\n石道苔藓春，松花郁金粉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月岩","author":"赵崇鉘","text":"玉丹仙蜕驭飞翰，便作琉璃世界看。\n大地山河浑忘却，谩依桂树舞青鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]