[{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其一","author":"赵蕃","text":"参军出郭匪幽寻，使者移文播德音。\n石蒜榆皮那得饱，刀耕火种岂能任。\n义仓政尔因饥发，赈历兹焉遣吏临。\n比屋故知难户晓，分行聊得尽吾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十六日郊行","author":"赵蕃","text":"乍惊风色扫群阴，旋见朝光上远林。\n李径桃蹊愁欲寂，麦畦桑亩秀何深。\n未云晨出因迎客，自喜山行不废吟。\n春晚得晴如此少，寄声鸠辈且停音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月初二日雨人以为风止之祥","author":"赵蕃","text":"谶言雨作风当正，得雨喜如遭旱时。\n枕藉无嗔杂蓑笠，跧藏不异庇茅茨。\n近看杨柳大垂手，远对云山图入眉。\n日暮横流难共济，明当安稳遂东之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月审知以余行有日置酒于智门寺后竹间小亭时与者王彦博审知之侄彦章余之弟成父审知命以尊前失诗流为韵分得流字书以呈之","author":"赵蕃","text":"林下有高兴，眼前无此流。\n并溪村径入，背佛野亭投。\n绿竹依人好，红蕖取意秋。\n病多宽酒债，别近耿离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三诗寄郭古夫 其二","author":"赵蕃","text":"往日台郎选，今年散吏员。\n词华推匠哲，问学得师传。\n视草应栖掖，谈经合细旃。\n诸公曷逃责，诏旨尚求贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三诗寄郭古夫 其一","author":"赵蕃","text":"巫峡闻归旆，潇湘说定居。\n若亲千里面，曾捧一缄书。\n山桧风霜老，江枫日夜疏。\n穷秋已凉冷，体候复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三诗寄郭古夫 其三","author":"赵蕃","text":"丐去秋今晚，能归岁且徐。\n须公一尊酒，胜我十年书。\n生死交情异，乖离人事疏。\n如闻厚风谊，何敢自趑趄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上宠市早饭","author":"赵蕃","text":"雾合疑为雨，云开复变晴。\n梨花高朵盛，柳树弱枝荣。\n问寺山场远，逢虚旅饭营。\n侵晨王事起，亭午野田行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下七盘岭","author":"赵蕃","text":"路绝疑无地，山穷复有天。\n林园更田亩，鸡犬亦人烟。\n江右名疆界，南中势接连。\n周书信无外，禹别自何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与成父别后有怀","author":"赵蕃","text":"何物催衰白，频年屡别离。\n弟兄俱老境，摇落况秋时。\n汝水应余忆，袁江独尔思。\n不堪行似棘，更对雨如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与成父夜坐","author":"赵蕃","text":"抱病俱不饮，清言醒肺肝。\n山空知室迥，念静失忧端。\n纵笔诗还作，无弦琴废弹。\n庵居已清绝，况及夜微阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与伯玉元衡大声兄弟饮","author":"赵蕃","text":"何方应雨落，此地祇凉生。\n杯酒偶相属，晤言聊叙情。\n登楼念王粲，促席想渊明。\n乡里无新故，情亲总弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李潭州椿寿翁五首 其五","author":"赵蕃","text":"日夜霜风急，东西客路昏。\n诗方学蛮语，病昔似文园。\n俯上辕门谒，愁干节制尊。\n顽疏宁自昧，剪拂望深恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李潭州椿寿翁五首 其四","author":"赵蕃","text":"万里沅湘路，千年贾屈文。\n迹同探禹穴，心每望尧云。\n未说渺茫隐，长思矍铄勋。\n不应迷出处，四十畏无闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李潭州椿寿翁五首 其三","author":"赵蕃","text":"今代长沙帅，当年汉李膺。\n登门故未易，为御亦堪矜。\n嗜好虽章句，经营在斗升。\n青衫旧蓝缕，白发近鬅鬙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李潭州椿寿翁五首 其二","author":"赵蕃","text":"疏去良臣散，文兴大老归。\n能忘缪公侧，何有步兵几。\n暴虎无苛政，鸣冈览德辉。\n辈虽参落落，业且相巍巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李潭州椿寿翁五首 其一","author":"赵蕃","text":"荷橐上甘泉，居多政府迁。\n胡为抗章谢，而必退身全。\n自计虽良已，人贤讵舍旃。\n吾心故公尔，斯道合幡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与苏运使诩四首 其一","author":"赵蕃","text":"筠阳有贤牧，典选得望郎。\n汉廷急献纳，使节乃辉光。\n翰墨一门盛，人才当代良。\n平生愿识面，今日获升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与契兄","author":"赵蕃","text":"因怀碧云友，发兴青林端。\n要尽深幽趣，浑忘下上难。\n泉声流咽绝，松韵响高寒。\n久作庐山别，疑从梦境看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与契兄相遇于鄱阳同游荐福寺","author":"赵蕃","text":"佛寺诚避俗，道宫还少休。\n摩挲汤饼腹，咽漱乳花瓯。\n爱此当檐趣，同为解带留。\n不惟纾我暇，聊亦散吾忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久不闻表叔张平子安否觅使寄此","author":"赵蕃","text":"一自书题阙寄将，不知今度几飞霜。\n空云梅岭有驿使，可奈衡阳无雁行。\n好趁荐章求北阙，莫因文价滞南荒。\n已今快阁治诗板，准拟归舟略系傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久不领衡州舅氏书以长句问动静","author":"赵蕃","text":"寥阔书题久不闻，可怜鱼雁动成群。\n未传春兴衡阳纸，长忆江东日暮云。\n见说风帆京口泊，又云山色敬亭分。\n莫言翰墨绕游戏，看取毛锥解致君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞竹亡有药圃主人买以种之","author":"赵蕃","text":"时人蕲惜千金费，肯似俞郎买竹栽。\n老节尚封南涧雪，定交新得北枝梅。\n幽禽亦自知人意，度日频能为我来。\n十饭未妨全不肉，上番春笋待新雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乞晓","author":"赵蕃","text":"乞晓占云物，过东还过西。\n已因月仰瓦，真验水平溪。\n齐楚自得失，短长从鹤鹥。\n谁能效巢穴，聊得寄诗题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大雨连昼夜不止","author":"赵蕃","text":"天漏谁能补，河倾势未平。\n踞床如露处，曳履学泥行。\n朽柱芝菌出，断沟蝌蚪生。\n南公安已惯，北客见犹惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大琛沽酒","author":"赵蕃","text":"吾州大琛酒，名不谢孤洲。\n女子亦知价，行人皆系舟。\n西来滩过险，东上寺逢幽。\n未说千忧散，姑为一醉谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进子仪过予山居子进有诗次韵呈子进兄弟二首 其二","author":"赵蕃","text":"荆溪有三士，求识自初年。\n才大俱诗伯，公惟愧饮仙。\n结交期耐久，过我地忘偏。\n惭愧衡门下，今成顿有边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进子仪过予山居子进有诗次韵呈子进兄弟二首 其一","author":"赵蕃","text":"蓬麻成蔽蔚，邻曲断经过。\n茶供同桑苧，香闻共补陀。\n寒蒲空有节，古井久无波。\n尚病留馀习，诗成索细哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进示怀玉诗卷有归途见怀恨不同游二诗次韵 其二","author":"赵蕃","text":"山有英灵在，眼应青白分。\n问禅公得髓，呈佛我无文。\n意赏人知独，神游默固群。\n清诗传妙旨，读罢雨花纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进示怀玉诗卷有归途见怀恨不同游二诗次韵 其一","author":"赵蕃","text":"望压大江东，兹峰独著雄。\n潜珍伏其下，神画隐于中。\n旧俗多庞说，因公得髓穷。\n从今逢有问，身与到山同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进昆仲俱和寄怀三诗复次韵 其一","author":"赵蕃","text":"此山祇合便终焉，底用心劳学计然。\n贫贱已安身外事，功名宁顾俗间缘。\n旧游要纪东南胜，有句须从甲乙编。\n闲向晴窗遮老眼，亦堪时伴结跏禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进昆仲俱和寄怀三诗复次韵 其三","author":"赵蕃","text":"有竹相娱道岂孤，信知造物未遗予。\n交游更许得奇士，保社却嗟无定居。\n怀玉近传酬倡集，荆溪与说往还书。\n世人徇利轻翻覆，我辈百年端一如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子进昆仲俱和寄怀三诗复次韵 其二","author":"赵蕃","text":"古途荆棘少人行，制礼难招鲁二生。\n世上儿曹俱覆辙，公家伯仲自争衡。\n一年欲尽见松秀，众水莫污知渭清。\n保此不渝真有道，更须直以所能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子畅雨中见过且惠以诗乃用蕃谢文显载酒之韵复用韵为答并简文显 其二","author":"赵蕃","text":"雨合茅檐书罢看，惠然君乃过苏端。\n浇胸细酌杯中物，洗耳饱听溪上湍。\n近喜同参诗有味，晚期偕隐谷名盘。\n因声寄谢周夫子，文行如斯古亦难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子畅雨中见过且惠以诗乃用蕃谢文显载酒之韵复用韵为答并简文显 其一","author":"赵蕃","text":"草本荒凉门半掩，故人谁肯为予来。\n要师原宪安非病，敢学襄阳怨不才。\n春自堂堂花更落，发今种种老其催。\n谢安故有东山志，过我题诗拭砚埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子畅尉曹用赠沅陵韵作诗见示亦用韵奉酬","author":"赵蕃","text":"元祐于今几故家，要寻遗事渺难涯。\n虚名可愧铁炉冒，实美当知丙穴嘉。\n柱后惠文余故窘，伍符尺籍子无嗟。\n神仙也说多官府，何物蜂房亦趁衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子耕录寄老圃赋及千秋观诸诗寄谢","author":"赵蕃","text":"歆向当年苦持难，少卿为有广之风。\n求君政合形骸外，笑我犹拘意匠中。\n远寄一朝成暴富，深藏没世免终穷。\n客来剩喜誇张事，何幸交游得是公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园早步","author":"赵蕃","text":"今朝欣雨止，天气渐清和。\n篱落小桃破，阶除驯雀多。\n占方移果树，带土数蔬科。\n农务侵寻及，吾宁久卧疴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行","author":"赵蕃","text":"晨起雨间雪，晚行风送晴。\n梅残冰玉瘦，林远画图呈。\n贾客嗟长路，农夫乐早耕。\n余怀独无累，徙倚待诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"已晴复阴","author":"赵蕃","text":"云去疑收雨，云来复作阴。\n已闻崩涧壑，何止暗园林。\n蛙斗怒何事，鸠鸣非好音。\n农心殊闵闵，病体更岑岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王照邻滕彦真韵二首 其二","author":"赵蕃","text":"王子诗如照，滕侯隐似真。\n倘来宁取遇，居易若为屯。\n酬倡虽才始，风期自夙亲。\n江湖纵悠远，德盛罔非邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次王照邻滕彦真韵二首 其一","author":"赵蕃","text":"黄妳能生睡，朱弦孰写忧。\n客居兹已病，归去合成谋。\n华岳虽遥吏，陶窗得素求。\n小舟何日具，湖水正漫洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"广平寺次孙子肃壁间韵","author":"赵蕃","text":"野寺夙所历，山程行苦赊。\n桂荣秋剩馥，蓬勃旱吹沙。\n徙倚俄成久，飞腾已向斜。\n异时如问隐，此地亦吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上读子肃诗集并怀子进子仪","author":"赵蕃","text":"一雨初收更有凉，我时驱马度危梁。\n溪山惯见少新意，诗句熟窥多旧行。\n不使高飞向台省，忍教微禄滞柴桑。\n难兄难弟俱奇士，宁愧诸洪出豫章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不寐","author":"赵蕃","text":"近梦续远梦，长更和短更。\n月窗疑雪积，风柁苦宵行。\n天外独身在，暗中华发生。\n归田莫迟暮，底是物穷亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋不见月次韵元衡十四夜江干步月五言","author":"赵蕃","text":"月待今宵满，秋空此夕中。\n与君俱客路，而我欠诗工。\n短发添新白，颓颜失旧红。\n波长嬉属玉，渚远怆宾鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋不见月得斯远所寄诗有怀兼呈远父成父","author":"赵蕃","text":"中秋不见月，空传江左诗。\n阴晴定俱尔，离合政关兹。\n亦复婆娑否，还成赋咏为。\n溪南旧游地，谁与共襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中夜风雨骤作怅然有怀简全真沅陵并寄成父弟","author":"赵蕃","text":"酒尽云间月，诗成雨至风。\n支离如病鹤，吟咏杂寒虫。\n摵摵朝梧叶，萧萧瘦竹风。\n飘零偶天末，憔悴祇江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋夜作去年今夕仆自北关过吴兴","author":"赵蕃","text":"明月同千里，寒乡又一秋。\n床随桧阴侧，巾与桂香浮。\n此夕山中趣，它年霅上游。\n诸儿皆楚语，老子自商讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中夜复书","author":"赵蕃","text":"凉生愁辗转，月上照鬅鬙。\n林壑故对此，溪山逢未曾。\n吟哀蛩伴苦，书绝雁无凭。\n更欲留危坐，枝梧殆不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰城送成父弟还玉山三首 其三","author":"赵蕃","text":"调护山中竹，斧斤毋使侵。\n当门要移种，绕堑合分阴。\n诗去惭如锦，书来定抵金。\n上言说儿女，其次及山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰城送成父弟还玉山三首 其二","author":"赵蕃","text":"酒薄仅饮湿，歌长欲泪垂。\n人皆有兄弟，我独困乖离。\n苦乏田园计，初非干谒资。\n途穷与计拙，千载少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰城送成父弟还玉山三首 其一","author":"赵蕃","text":"溪上同舟送，江头独步归。\n秋风方落木，客路要添衣。\n故旧询安否，形容话瘠肥。\n吾行犹许远，尔去复谁依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书方伯谟窗间","author":"赵蕃","text":"问此林间屋，何年所筑成。\n开窗山自入，绕屋水长鸣。\n可静看书眼，如参琢句声。\n白云原上宅，比并孰堪兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书买江天阁壁","author":"赵蕃","text":"赵壹乡党摈，陈登湖海豪。\n飘飘风欲举，凛凛雪争高。\n眼界自无极，画图空复劳。\n未须惊白发，聊得湛春醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书后湖集","author":"赵蕃","text":"我怀苏养直，不作汉三公。\n隐墅人安在，春溪草自丰。\n遗文尚亡恙，斯道未应穷。\n会与吾尊友，青灯话此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"赵蕃","text":"春风吹雨又吹晴，柳树能青桃树明。\n细履野蹊初见蝶，却行幽径未闻莺。\n布衾虽破犹堪典，菜甲纵稀亦可羹。\n政拟远同嵇叔夜，一尊浊酒话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"赵蕃","text":"倦栉头如葆，深居心若斋。\n作诗须识病，遇事莫装怀。\n富贵乃身贼，饥寒为道阶。\n长贫君勿怨，天岂困吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其二","author":"赵蕃","text":"去日春江白芷生，再来秋野蟪蛄鸣。\n浩然已分不才弃，张翰安能恤后名。\n自叹还山何太晚，政须杯酒为深倾。\n凭愚邀敬多官府，与想桃源源上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其一","author":"赵蕃","text":"要令多病也身轻，安得晨风永昼清。\n瑟瑟泉流沿涧响，疏疏松吹转空鸣。\n生平旧隐藓踪合，老至危途蓬鬓生。\n松柏后雕闻古语，若何秋菊敢齐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书李氏园亭","author":"赵蕃","text":"坐久思行步，因而上野亭。\n日兼梅雨落，山接稻田青。\n何术销终讼，连朝役瘦形。\n早知还走俗，不用学通经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事 其八","author":"赵蕃","text":"儿啼宵不饱，女诉夏无衣。\n几载宦游倦，素来生事微。\n诗书须自勉，纫补莫多违。\n我亦田园去，终难粟肉希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事","author":"赵蕃","text":"当暑暑何在，以风风为生。\n舆夫忘倦色，客子慰归情。\n往者千年隔，人焉几日程。\n同行得老伴，馀事率诗鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事寄呈斯远","author":"赵蕃","text":"路熟疑为短，马迟翻更长。\n野田吹欲合，林日冻无光。\n未暇亲书案，频成唤酒觞。\n短檠今夕念，我友正相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书滩头驿","author":"赵蕃","text":"闭户只书痴，郊行粗有诗。\n翠深千顷峤，烟迥几茅茨。\n雨作衣添袷，炊迟昼不饥。\n旧题看好在，重是一春期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书管掾所抄张安国诗","author":"赵蕃","text":"天上张公子，诗轻万户侯。\n驾车追熟路，顺水放轻舟。\n化鹤惊何远，藏山散莫收。\n可人秋浦掾，著力为冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]