[{"title":"乐府杂拟 其五","author":"黄彦平","text":"青青佳蔬色，春事幽人家。\n为政一畦足，葱韭纷菁华。\n贫士食有经，愿欲不得奢。\n鲑种二十七，笾豆无添加。\n寒翠濯露雨，甘芳供齿牙。\n菜花亦不恶，何独爱桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其四","author":"黄彦平","text":"往者东门瓜，近接咸阳道。\n炎风沉玉甃，宿露薅瑶草。\n召平磊落人，此亦有何好。\n常时玩钩带，不复叹枯槁。\n武陵桃易华，角里芝难老。\n战争兹云始，贱贫傥长保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其二","author":"黄彦平","text":"用意崎岖外，人贵真相知。\n张耳望陈馀，汲黯是魏其。\n所谓刎颈交，首身果不随。\n太行摧车险，蜀道登天危。\n坐席有畏涂，方笑剑头炊。\n老翁牙齿脱，年少莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐府杂拟 其六","author":"黄彦平","text":"忘机对芳草，一目青浮浮。\n荣枯四时行，寂寞万事休。\n树谖见国风，采菊闻灵修。\n空残飞蓬首，讵返王孙游。\n韩子木强人，臭味谁敢投。\n暮年还小黠，不肯辨薰莸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归途次韵 其九","author":"黄彦平","text":"逢人怕作宣明面，为米误折渊明腰。\n光阴客里深相忆，泉石家山特见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归途次韵 其三","author":"黄彦平","text":"寒食犹须数日间，楚亭才隔几重山。\n归时便有桃花否，试擘华笺问曲栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田间春晚 其二","author":"黄彦平","text":"浅白深红小睡馀，梦残春去绿扶疏。\n更无蜂蝶怜膏馥，时有娇莺隐自呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石钟寺 其二","author":"黄彦平","text":"朔风驱水作狂澜，眼里庐山脚到难。\n少待须臾莫仓卒，卸帆聊憩石钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立秋日湘舍熊生所居斸地得剑长三尺六寸熊生自言居六世矣感延平旧事因系以诗","author":"黄彦平","text":"野人斸地得神兵，铲采埋光三尺半。\n念求款识推甲乙，櫑具连环既芜漫。\n里闾只从曾高说，栋宇未随儿子换。\n迄今要自二百年，前此怪藏那得算。\n秋风是日来阊阖，利器乘时思击断。\n肯论口腹车鱼间，未露文章斗牛畔。\n良工拂拭劳三浴，志士提携思一旦。\n张雷博识固自佳，贾郭充庭还可叹。\n北岩华阴土性弱，颜色暂时供把玩。\n不如一洗清海水，径斩长鲸为万段。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欢喜口号 其七","author":"黄彦平","text":"何必翠虚捎魍魉，且看白旆挂麟猊。\n几年待著龙蛇岁，便是乾坤交泰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临川投赠 其二 汪彦章","author":"黄彦平","text":"翰林逼华盖，天策视瀛州。\n哀痛扶兴运，从容赞庙谋。\n终篇常称惬，两郡却淹留。\n更试平原尔，方看相且侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南归宿西禅寺","author":"黄彦平","text":"灵辄三年宦，何蕃间岁归。\n风尘为吏苦，天地禀生微。\n廪粟难糊口，园蔬亦乐饥。\n谁令浪奔走，南北敝征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南部","author":"黄彦平","text":"南部风流志，东山窈窕容。\n诗笺元襞彩，史笔近书彤。\n花月妖时见，闺房美间钟。\n梦兰宵有證，吞蕊露添浓。\n稍讶钗分髻，还怜镜隐胸。\n吹箫仪彩凤，遗策驻游龙。\n会是云间堕，真成月下逢。\n光风开豆蔻，钿履上芙蓉。\n湘岸传虚瑟，昆廷学晚钟。\n瑰姿随月满，绮思殢春慵。\n乱絮飞何远，繁花影自重。\n红裳明洛浦，白雨湿巫峰。\n织女期清汉，宜男结绿茸。\n丹书多避忌，银叶竟怔忪。\n每遂西瑶宴，长防北斗舂。\n屏深金屈戌，佩响玉玲珑。\n阅古柔情极，紬书逸兴浓。\n烛还通德侍，研有雪儿供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独秀峰","author":"黄彦平","text":"湘山富佳色，韫蓄人未知。\n天球有馀润，草木蒙其私。\n联绵固不恶，峭独看愈奇。\n兹峰岂飞来，兴尽留于斯。\n云烟惨么么，灌莽纷离披。\n名虽异星渚，实不愧仇池。\n惜无小白花，密雪蒙疏枝。\n教僧营小筑，便是补陀祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡帅见和用韵再寄 其二","author":"黄彦平","text":"乔木犹春色，名家亦世臣。\n安危思有寄，文武不无人。\n翰墨昭前烈，功勋踵后尘。\n八萧终鼎鼐，二贾且丝纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵丞相黄冈独往亭","author":"黄彦平","text":"士生涉道有深浅，时来行身随近远。\n飞云邂逅作霖雨，雨足云归自舒卷。\n南阳躬耕心不悔，东山忽起颜犹腆。\n威行巾帼喜折屐，得倍古人谋盖鲜。\n杨颙恸哭野王筝，叹息成言那及践。\n关中丞相富丘壑，掩鼻功名聊不免。\n前年一战靖江浒，今年再战开淮甸。\n心期绿野园林胜，梦想黄冈松桧晚。\n渊明孤往欲问津，赤松从游非众愿。\n凭虚或喜凌云赋，远游请续离骚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡帅","author":"黄彦平","text":"征南下车再寒暑，比屋罢民手摩抚。\n使渠安业不扰渠，恐负来时天上语。\n汉官题名当家谱，向来诸公孰为伍。\n天下中庸有胡公，不畏彊禦陈仲举。\n年时丞相双旌举，南浦飞云作霖雨。\n文昌戎政念得人，谁令两公归接武。\n周宣中兴藉方虎，秦王学士开天府。\n只今陛下更辛苦，要折遐冲付尊俎。\n忍饥种麦未盖土，军民嗷嗷两难处。\n从容宫漏未遽移，亦及渔樵人物否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐稚山江西漕","author":"黄彦平","text":"长江分东西，下流隔沧楚。\n方船漕红粟，出节须调护。\n催科急星火，踏浪轻尘土。\n公私此一时，长短要相补。\n水生春岸阔，江净桃花吐。\n饯宴那得频，征帆会当举。\n烟鬟小姑山，晓镜女儿浦。\n雁雁破行飞，鸭鸭避人语。\n平生钓竿手，只合江湖去。\n因君偶别离，感我犹羁旅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄司录 其二","author":"黄彦平","text":"雪销南国瘴，花遍北枝梅。\n华发天边老，微阳树底回。\n未知身外事，聊覆掌中杯。\n检点樽前客，明年几去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读邸报有感","author":"黄彦平","text":"江城留滞鬓毛斑，六县三年几往还。\n迁客东流惊建德，怀人秋浦更齐山。\n平生深愧田园志，陈迹真成俛仰间。\n同学少年都上道，欲将长铗向谁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿新喻县戏为俳体","author":"黄彦平","text":"短短长长柳，疏疏密密杉。\n秧深先熟稻，叶贵再眠蚕。\n禦暑乌油伞，伤春白纻衫。\n乡风尽江右，魂梦莫湘南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿香严寺 其一","author":"黄彦平","text":"章原暝边龙会宿，塔岭尖处胡孙愁。\n且并山腰攲侧过，莫从高顶望神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清溪解缆用秀才甫韵寄杜藏用 其一","author":"黄彦平","text":"九华晴云今日阴，清溪涨水夜来深。\n苍梧哀泛湘妃瑟，白藕秀出姮娥簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭泽怀古","author":"黄彦平","text":"人言宁饮建业水，陶公不污彭泽米。\n淳耀之烈当未渝，义熙之政何如此。\n不能先驱净蝼蚁，忍傍车轮攀獭尾。\n已荒松菊赋归来，颇著文章申已志。\n少题正朔多岁时，此志会须来者知。\n羲皇上人乐复乐，晋室遗民悲莫悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程伯禹给事供职维扬不及迎侍通直丈生辰欲寄寿星未获方深念不怿有叩门求售者既得之自赞其异且求诗","author":"黄彦平","text":"将军精忠石饮羽，志士纯孝冰出鱼。\n天公晓人极了了，间遣异物供时须。\n西清侍讲广陵居，寿亲千里愁作书。\n平明剥啄出见客，帝俾遗汝明星图。\n仙官游空貌不臞，若木映日华不枯。\n勿嫌龟鹤有皂白，相汝綵服为亲娱。\n嗟君密行不可诬，塞侯周叔俱不如。\n帅先百僚待忠孝，伫相明主平羌雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵少隐移漕广东","author":"黄彦平","text":"五岭馀炎蒸，三湘漫清绝。\n犬牙地相入，要是俱百粤。\n赵侯干莫器，盘错中排决。\n近惟高帝孙，远付使者节。\n悠悠南海路，惘惘舂陵别。\n君才谁得如，郎星映卿月。\n功名与事业，邂逅当俯拾。\n姑行毋疾驱，迟补中都阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘氏市隐亭","author":"黄彦平","text":"云合日景暮，鸟啼芳意休。\n闲芳閟佳境，倦客得深投。\n主人定何人，方技家者流。\n持廉不二价，博物要兼收。\n丹砂出勾漏，杜若来芳洲。\n卢橘上林夏，桂丛小山秋。\n鱼虫傥适用，剥啄无虚求。\n潜山仕途捷，隐居吾庐幽。\n喧寂若两忘，容膝万事周。\n佳名志华屋，他日或重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤雨宿香步","author":"黄彦平","text":"阿香被召雷挟辀，飞廉受职云承宇。\n冥官鬼伯俱奔走，东风作恶神灵雨。\n山长已自疲荦确，泥深况复愁沮洳。\n夜投古寺亟燎衣，灯烛荧煌汤湢具。\n移床避漏皆相似，欲往华胥仍龃龉。\n曲肱齁䶎初未遑，蓐食还须戒徒御。\n长年行役虽劳事，胜日登临或相补。\n会到诸峰最上头，俯看万壑争流处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石钟寺 其一","author":"黄彦平","text":"秀发九华晴景，摧颓五老苍颜。\n暮雨朝云佳处，小姑依约烟鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄彦平","text":"湘江东西中浯溪，云埋雨洗三吾碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"黄彦节","text":"拟嚼枝头蜡，惊香却肖兰。\n前村深雪里，莫作岭梅看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠僧宗佑","author":"黄彦臣","text":"潇潇丰姿迥不同，少年来住此禅丛。\n谁知今日佑和尚，便是当年钟令公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元宵词二首 其二","author":"黄彦辉","text":"鳌头移得山三岛，月下传来灯万枝。\n香陌马嘶红萼锦，翠楼人倚绿杨眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元宵词二首 其一","author":"黄彦辉","text":"琥珀盏中云母钟，琉璃光射水晶宫。\n风随兰麝香千里，人在莲花影万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古寺","author":"黄彦辉","text":"古寺云深去路赊，来分僧钵共生涯。\n依稀池草成春梦，容易江梅老岁华。\n长铗悲弹三尺雪，短檠寒落五更花。\n夜来风雨催归急，为报河阳令尹家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旴江舟中联句","author":"白玉蟾","text":"倏忽僧千兔，寻常涸百蠡。\n眼光摩日月，足迹遍山河。\n赤壁聊化鹤，黄庭浪换鹅。\n秋声归欸乃，云影映婆娑。\n夜后调焦尾，风前舞太阿。\n待藏班婕扇，却援鲁阳戈。\n点尔言其志，虞兮奈若何。\n道缘宁择地，世事总随波。\n万象由弹压，千篇在切磋。\n酒徒从狎至，诗客听相过。\n辍我芒不借，就伊金叵罗。\n峰巅餐地秀，霞外挹天和。\n拍手僛僛舞，忘形踏踏歌。\n力辞金殿客，高应玉皇科。\n八桂招六逸，九疑哀两娥。\n清漪驯绿鸭，列阜拊眠驼。\n逸韵应无敌，清名到不毛。\n樵仙分我席，力士污吾靴。\n风沈腰何束，霜潘鬓谩皤。\n怀丹医病鹤，寻饵钓神鳌。\n为问六国印，何如一渔蓑。\n清飙茶腋爽，韶景醉颜酡。\n且啖藕如臂，从教晷似梭。\n推蓬延月桂，引襋玩烟萝。\n君已人登泰，辞皆水导嶓。\n蕊官清缥缈，云阙郁嵯峨。\n未到桑田变，疑将铜狄摩。\n谁知天不管，敢谓世无魔。\n觞政驩无忤，骚坛今太苛。\n玄谭时脍炙，杰句肆吟哦。\n大道真溟滓，浮生但刹那。\n玉天还有诏，应是典风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑池","author":"黄昭","text":"一剑已飞去，千年池尚存。\n浮图入云表，古寺倚山根。\n虎踞石形险，龙潜水气昏。\n阖闾成底事，遗恨满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌石山","author":"黄某","text":"□□□□石，硉突倚山颠。\n□□□羊伏，漫漫万马联。\n何年□□□，终古□桑田。\n□□□□□，□仙□允传。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙 原不著调名，按律似是浪淘沙","author":"黄某","text":"八十加三迎九十，还似婴童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陆象山先生墓","author":"黄矩","text":"西风匹马驻邮亭，茅屋鸡鸣尚未醒。\n野寺秋声三径竹，石桥云气一潭星。\n寒欺短褐霜华白，水落平田野蔓青。\n师友家传今寂寞，欲移文字问山灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄檗览秀阁和韵","author":"黄祖舜","text":"飞阁凌云翠，幽寻一径微。\n峰峦长竞秀，烟水莽相围。\n景色尘嚣外，诗情领略归。\n标题属大手，价重胜留衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江山晚眺","author":"黄荣仲","text":"十里沧波自在流，满天风月下芦洲。\n待携六幅生绡去，画出江南水墨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漱石 其二","author":"黄荦","text":"天然云骨老巉岩，疑是飞来住此间。\n独坐小窗听夜雨，梦魂应不到康山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漱石 其一","author":"黄荦","text":"撑空嶙峋一石古，呼水来作飞泉鸣。\n摩挲徙倚坐弥久，便欲老此岩之扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅昌言出镇太原","author":"黄觉","text":"五马雍容出镇时，都人争看好风仪。\n文章一代喧高价，忠直三朝受圣知。\n帐下军容生剑戟，门前行色拥旌旗。\n云笼古戍黄榆暗，雪满长郊白草衰。\n出去暂开貔虎幕，归来须占凤皇池。\n鬓间未有一茎白，陶铸苍生固不迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄觉","text":"床头历日无多字，屈指明年七十三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三峡桥","author":"黄诰","text":"桥压神龙三四秋，良材应是鬼神搜。\n猿猱争饮涧中水，草木不知天下秋。\n隐士闲行随白鹿，道人长往驾青牛。\n灵源自与天河接，谁信江淮是末流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双剑峰","author":"黄诰","text":"泻成神剑倚双峰，天地为炉造化工。\n万丈虹霓连碧落，一声霹雳走丰隆。\n拂开岚障千山秀，削尽妖魔六宇空。\n应笑镆铘为小器，延平津上合雌雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺吴樵登第","author":"黄诰","text":"连云山下凤凰儿，何幸今朝见白眉。\n父子传经无异说，弟兄题塔又同时。\n北堂偕老椿千岁，南国联荣桂两枝。\n青史他年书茂实，一门忠孝是镃基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题道岩二十韵","author":"黄诰","text":"道士元周其姓胡，朝来遗我仙岩图。\n一堆磐石东西向，凿破混沌中心虚。\n欲知地面深且广，架屋百楹端有馀。\n天池高下相灌溉，四柱卓立擎香炉。\n席帽近南犹仰视，云盖一峰蟠北隅。\n前岩后岩为表里，直过可以肩篮舆。\n吴许遗留试剑石，葛艾弃置烧丹炉。\n当时俗眼固不识，一旦脱屣朝清都。\n至今丹井泉源涌，下接三江连五湖。\n春来桃李开锦绣，宛在武陵溪上居。\n人间酷热不能到，清风白水摇芙蕖。\n霜飞雪落万木死，玉叶青青长不枯。\n三清殿前拜章夜，香绕真仪七十躯。\n月光射入嵌空内，皎皎寒冰在玉壶。\n老龙耽睡忽惊觉，一霎万顷沾膏腴。\n物无疵疠年谷熟，有感则通如合符。\n本朝图经自该说，厥后荒废成丘墟。\n元周抵掌来必葺，十四年间复古初。\n崇宁天子降明诏，废者使兴传圣谟。\n郡邑何时能剡奏，毕封之祝相欢呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延庆院","author":"黄轸","text":"宝刹标奇处，烟萝响乱流。\n地灵僧得住，山好客多游。\n灯影连金像，钟声散石楼。\n风雷等閒作，咫尺是龙湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何岭怀古","author":"黄钟","text":"缕缕浮云一线穿，老松窈窕石娟娟。\n五芝采就辞尘?，九鲤飞时忆汉年。\n岭尽斜阳犹迫翠，风清层磴可谈玄。\n庐江去后寻消息，肯与淮南共拍肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄钧","text":"水远山遥疑剑断，风愁雨恨只铃知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 寿太守母八十正月初一","author":"黄革","text":"堂堂卿月，奉君恩来作，潜藩贤守。\n喜遇慈闱年八十，特向新正称寿。\n千里春风，满堂和气，是处歌声奏。\n荷衣紫绶，捧觞齐上春酒。\n人道彭祖高年，寿高八百，管从来稀有。\n似此遐龄，屈指算、犹有十分之九。\n惠满梅山，宠新芝检，归展调羹手。\n疏封国号，天教富贵长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长门怨","author":"黄顺之","text":"锦瑟新添一岁尘，宝鸾空负百年身。\n建章万户莺花好，只有长门更不春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观冷水谷桃花","author":"黄顺之","text":"石家步障久成尘，移作包山一段春。\n惆怅日斜原上路，年年红雨打行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴宫曲","author":"黄顺之","text":"乌鹊桥边春日斜，吴王醉上七香车。\n西施斗草归来晚，赢得钗头金凤花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"法安院","author":"黄顺之","text":"瘦藤拄到古韬光，分得山僧半榻凉。\n幽鸟一声春梦断，湿云漠漠护残香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑","author":"黄顺之","text":"抚剑悲歌壮泪流，海清岳静世无雠。\n匣中幸有容身地，莫遣光芒射斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题九曲尼院","author":"黄顺之","text":"曾是霓裳第一人，曲终认得本来身。\n多年不作东风梦，閒却蔷薇一架春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题岩砻寺","author":"黄顺之","text":"岩花得雨新如染，古树悬崖怪欲飞。\n日暮溪深人不渡，一双白鸟傍林归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]