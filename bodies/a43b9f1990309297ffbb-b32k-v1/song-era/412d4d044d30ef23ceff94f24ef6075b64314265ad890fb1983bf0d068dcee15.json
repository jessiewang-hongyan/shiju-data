[{"title":"过石磨岭岭皆创为田直至其顶","author":"杨万里","text":"翠带千镮束翠峦，青梯万级搭青天。\n长淮见说田生棘，此地都将岭作田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其六","author":"杨万里","text":"道是行船也未行，老夫误喜可怜生。\n要知开闸真消息，记取金钲第二声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其五","author":"杨万里","text":"才闻开闸总驩欣，第一牵夫有喜声。\n只得片时天未黑，后来天黑也甘行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其四","author":"杨万里","text":"等到船齐闸欲开，船船捩柁整帆桅。\n一船最后知何故，日许时间独不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其三","author":"杨万里","text":"昨宵听尽棹讴声，愁里无眠达五更。\n今夕雨寒泥又滑，作何计会速天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其二","author":"杨万里","text":"泊船到得暮钟时，等待诸船不肯齐。\n等得船齐方过闸，又须五鼓到荆溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过吕城闸六首 其一","author":"杨万里","text":"闸头洲子许团栾，古庙萧条暮雨寒。\n榆柳千株无半叶，冬青一树碧琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安仁市得风挂帆二首 其二","author":"杨万里","text":"西望柯山正蔚蓝，衢州只在此山南。\n却愁路尽风犹剩，回纳清风与破帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过安仁市得风挂帆二首 其一","author":"杨万里","text":"明发山溪一雨馀，昨来暑气半分无。\n何人道是三衢远，挂起东风十幅蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过百家渡四绝句 其三","author":"杨万里","text":"柳子祠前春已残，新晴特地却春寒。\n疏篱不与花为护，只为蛛丝作网竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过百家渡四绝句 其四","author":"杨万里","text":"一晴一雨路乾湿，半淡半浓山叠重。\n远草平中见牛背，新秧疏处有人踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过百家渡四绝句 其二","author":"杨万里","text":"园花落尽路花开，白白红红各自媒。\n莫问早行奇绝处，四方八面野香来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过百家渡四绝句 其一","author":"杨万里","text":"出得城来事事幽，涉湘半济值渔舟。\n也知渔父趁鱼急，翻著春衫不裹头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过西坑","author":"杨万里","text":"乾风无那湿云何，吹不能开只助他。\n野水落溪生蟹眼，一番过了一番多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨二渡三首 其三","author":"杨万里","text":"柳见风时舞便轻，解将衮遍趁莺声。\n道它誇逞腰肢著，风罢元来倦不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨二渡三首 其二","author":"杨万里","text":"两日山寻尽野花，今晨水眺始桑麻。\n春风娇得千垂柳，恰限身才个个斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨二渡三首 其一","author":"杨万里","text":"春迹无痕可得寻，不将诗眼看春心。\n莺边杨柳鸥边草，一日青来一日深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨子桥二首 其一","author":"杨万里","text":"浪说春归已四旬，淮南元自不知春。\n明朝却是中和节，野次谁怜寂寞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨子桥二首 其二","author":"杨万里","text":"客愁满目政无聊，忽报船经杨子桥。\n未到江南心已喜，隔江山色碧相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过沙头三首 其三","author":"杨万里","text":"昨来飞橹下危泷，不敢窥窗只闭窗。\n莫叹江平船不进，只将行役当游江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过沙头三首 其二","author":"杨万里","text":"过了沙头渐有村，地平江阔气清温。\n暗潮已到无人会，只有篙师识水痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过沙头三首 其一","author":"杨万里","text":"非烟非雨淡濛濛，深闭窗扉护晚风。\n船外山光帘里翠，岸头花影镜中红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过苏岩","author":"杨万里","text":"仰望苍岩高更深，岩中佳处著禅林。\n琼泉万仞峰头落，一滴泉声一醒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其七","author":"杨万里","text":"山穷喜见一平川，不似林中不识天。\n只出此山灾便散，何须更问小行年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其四","author":"杨万里","text":"为怜上轿齧人肩，下轿行来脚底穿。\n客子心心愁欲暮，碧云偏作半阴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其二","author":"杨万里","text":"草光叶润亦清佳，翠里生香不是花。\n一事说来人不信，蕨长如树蚓如蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其三","author":"杨万里","text":"芦深石路旋芟开，藤絓肩舆却倒回。\n兰蕙连山为谁好，芭蕉满谷不缘栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其六","author":"杨万里","text":"涧泉劝我出山迟，曲曲遮留步步随。\n泉自多情侬自闷，今宵会有出山时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其一","author":"杨万里","text":"林中亭午始微明，枫倒杉倾满路横。\n黄叶青苔深一丈，先生却爱此中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陂子径五十馀里乔木蔽天遣闷柒绝句 其五","author":"杨万里","text":"晚风寂寂树阴阴，松不悲鸣竹不吟。\n只有清泉逢白石，向人刺口说山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陈公径二首 其二","author":"杨万里","text":"江行十日厌船迟，却换篮舆踏路泥。\n江水别来才两日，陈公径下再相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过陈公径二首 其一","author":"杨万里","text":"去岁陈公径里松，船中仰看爱松风。\n只今身在松风里，下看江船西复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过京口以南见竹林","author":"杨万里","text":"行从江北别梅兄，归到江南见竹君。\n却忆西湖湖上寺，梅花如雪竹如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过周陂江","author":"杨万里","text":"溪暖无冰可得销，清波白石小鱼跳。\n忽逢寸碧翩然起，翡翠惊飞上柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其十","author":"杨万里","text":"五湖佳处是荒寒，却为无山水更宽。\n归去江南无此景，未须吃饭且来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其六","author":"杨万里","text":"雨里楼船即钓矶，碧云便是绿蓑衣。\n沧波万顷平如镜，一只鸬鹚贴水飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其五","author":"杨万里","text":"湖堤插柳早青葱，犹带隋家旧土风。\n莫笑千株尺来许，看渠揽尽夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其四","author":"杨万里","text":"渔家可是厌尘嚣，结屋圆沙最尽梢。\n外面更栽杨柳树，上头无数鹭鸶巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其二","author":"杨万里","text":"细雨初如弄隙尘，须臾化作舞空蚊。\n作团面旋还分散，只见轻烟与薄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宝应县新开湖十首 其一","author":"杨万里","text":"寒里船门不可开，试开一望兴悠哉。\n空濛烟雨微茫树，都向湖光外面来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过建封寺下连鱼滩二首 其二","author":"杨万里","text":"梦里篙师忽叫滩，老夫惊杀起来看。\n前船过尽知无虑，末后孤舟胆自寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过建封寺下连鱼滩二首 其一","author":"杨万里","text":"江收众水赴单槽，石壁当流斗雪涛。\n将取危舟飞过去，黄头郎只两三篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过招贤渡四首 其四","author":"杨万里","text":"岸上行人莫叹劳，长年三老政呼号。\n也知滩恶船难上，仰踏桅竿卧著篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过招贤渡四首 其三","author":"杨万里","text":"倦游客子自无聊，不是江山景不饶。\n危岸崩沙新改路，断渠横石自成桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过招贤渡四首 其二","author":"杨万里","text":"一江故作两江分，立杀呼船隔岸人。\n柳上青虫宁许劣，垂丝到地却回身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过招贤渡四首 其一","author":"杨万里","text":"归舟曾被此滩留，说著招贤梦亦愁。\n五月雪飞人不信，一来滩下看涛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过松源晨炊漆公店六首 其五","author":"杨万里","text":"莫言下岭便无难，赚得行人错喜欢。\n政入万山围子里，一山放出一山拦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过松源晨炊漆公店六首 其四","author":"杨万里","text":"日高谷底始微暄，岚翠依然透骨寒。\n说与行人忙底事，金鸡声里促银鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过松源晨炊漆公店六首 其二","author":"杨万里","text":"山北溪声一路迎，山南溪响送人行。\n也知流向金陵去，若过金陵莫寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过罗溪南望抚州泉岭","author":"杨万里","text":"泉岭诸峰太劣生，与侬争走学侬行。\n苍官总上山头去，一色前驱娖翠旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过虎头矶","author":"杨万里","text":"虎卧中流扼两涯，目光须怒首仍回。\n真阳峡里君须记，个是瞿塘滟滪堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金台天气顿热三首 其三","author":"杨万里","text":"入到船中气郁蒸，出来船外日侵陵。\n绿波欲沸清何在，青盖张来似不曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金台天气顿热三首 其二","author":"杨万里","text":"日晒船篷四面炊，几时却得出船时。\n江西未到何须恨，且到三衢也自奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过金台天气顿热三首 其一","author":"杨万里","text":"江云山翠借朝凉，晚日晴波挟暑光。\n旧说长江无六月，暮春已自不禁当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过青阳县望九华山云中不真来早大雾竟不见其全三首 其三","author":"杨万里","text":"懊恼西来不见山，五更指准月中看。\n却将香雾宽裁幕，性燥和天总一漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过青阳县望九华山云中不真来早大雾竟不见其全三首 其二","author":"杨万里","text":"肩舆过了九华西，恨杀秋云故故低。\n遮尽奇峰时放出，逐峰放出不教齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过青阳县望九华山云中不真来早大雾竟不见其全三首 其一","author":"杨万里","text":"山长百里玉孱颜，百里何缘尽好山。\n只是县前青一簇，九芙蓉出五云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平二首 其二","author":"杨万里","text":"人家点缀荻花林，水绕阶除雪湿衿。\n最是疏篱与脩竹，脚根半入小河深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平二首 其一","author":"杨万里","text":"临平放目渺无涯，莲荡蘋汀不钉牌。\n雪后轻船四捞漉，断芦残荻总成柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平莲荡四首 其四","author":"杨万里","text":"人家星散水中央，十里芹羹菰饭香。\n想得薰风端午后，荷花世界柳丝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平莲荡四首 其三","author":"杨万里","text":"朝来采藕夕来渔，水种菱荷岸种芦。\n寒浪落时分作荡，新流涨后合成湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平莲荡四首 其二","author":"杨万里","text":"莲荡中央劣露沙，上头便著野人家。\n篱边随处插垂柳，檐下小船萦钓车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平莲荡四首 其一","author":"杨万里","text":"莲荡层层镜样方，春来嫩玉斩新光。\n角头一一张芦箔，不遣鱼虾过别塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过南荡三首 其三","author":"杨万里","text":"政好行时莫懒行，犹寒未热雨初晴。\n江西休问何时到，已离南屏第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过南荡三首 其二","author":"杨万里","text":"近岫遥峰翠作围，平田小港碧行迟。\n垂杨一径深深去，阿那人家住得奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过南荡三首 其一","author":"杨万里","text":"秧才束发幼相依，麦已掀髯喜可知。\n笑杀槿篱能耐事，东扶西倒野酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过显济庙前石矶竹枝词二首 其一","author":"杨万里","text":"石矶作意恼舟人，束起波涛遣怒奔。\n撑折万篙浑不枉，石矶赢得万馀痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过显济庙前石矶竹枝词二首 其二","author":"杨万里","text":"大矶愁似小矶愁，篙稍宽时船即流。\n撑得篙头都是血，一矶又复在前头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洛社望南湖暮景三首 其三","author":"杨万里","text":"一阵南风似箭来，蒲帆飞上最高桅。\n两边岸柳都奔走，不及追船各自回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洛社望南湖暮景三首 其二","author":"杨万里","text":"暮烟如雨雨如烟，一把珠帘隔远山。\n帘影渐浓山渐淡，恍然移入画屏间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洛社望南湖暮景三首 其一","author":"杨万里","text":"南湖隔水见渔灯，雁落芦汀八字横。\n对面双峰烟雨里，双峰外面是宜兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过神助桥亭","author":"杨万里","text":"下轿浑将野店看，只惊脚底水声寒。\n不知竹外长江近，忽有高桅出寸竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过润陂桥三首 其二","author":"杨万里","text":"却忆庚寅侍板舆，过桥桥断费人扶。\n重来一见新桥了，泪湿秋风眼欲枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过真阳峡六首 其六","author":"杨万里","text":"百滩千港几涛波，聚入真阳也未多。\n若遣峡山生塞了，不知江水倒流么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过真阳峡六首 其五","author":"杨万里","text":"榕树阴中一苇横，鹧鸪声里数峰青。\n南人到此亦肠断，一是南人作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过真阳峡六首 其四","author":"杨万里","text":"堪笑跳波数百滩，如何入峡顿无喧。\n人言此峡如巴峡，只欠三声堕泪猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过真阳峡六首 其三","author":"杨万里","text":"仰见青天尺许青，无波江水不胜平。\n只惊白昼山竹裂，杜宇初闻第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]