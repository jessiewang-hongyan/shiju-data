[{"title":"下程","author":"赵汝燧","text":"下程疑颇早，店主劝予休。\n今晚莫贪路，明朝便到州。\n疏篱编马眼，新笋护猫头。\n六七岁童子，一人随数牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久客写怀","author":"赵汝燧","text":"一身千里叹飘零，鬓影萧疏已半星。\n云雁叫愁栏独倚，秋风吹面酒初醒。\n尘埃南北何曾歇，日月东西不暂停。\n昏暮谁家数声笛，含悽喷怨要人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子开移居郊外","author":"赵汝燧","text":"数间低矮屋，不可以抬头。\n嫌市尘埃浊，寻山泉石幽。\n门松霜干古，窗竹露竿脩。\n办此一廛了，从今何所求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山庄","author":"赵汝燧","text":"门掩斜阳岸，溪横独木桥。\n山禽弄春舌，堤柳舞风条。\n世事雪双鬓，生涯水一瓢。\n似闻邻酿熟，自往不须招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰城道中","author":"赵汝燧","text":"雨后泥深马费鞭，看来遵陆岂如船。\n人行滩过无多水，雁带云飞不尽天。\n束担侵晨离故县，算程明日至临川。\n长安钟鼓何时听，东望犹争路一千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"化成岩二首 其二","author":"赵汝燧","text":"一线沿崖路，衰残步屧迟。\n攀萝冲雾上，倚槛俯空危。\n石佛像须久，山僧言不知。\n看来众亭子，最是妙高奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"化成岩二首 其一","author":"赵汝燧","text":"命友化成岩，同寻顷刻闲。\n半途瞻佛塔，数里入禅关。\n松动影移日，江清波漾山。\n卫公读书处，有鹭宿其间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午炊徐坊岭","author":"赵汝燧","text":"途长力困时时歇，日影将中仆马饥。\n籴米荒年增价售，汲泉远井得炊迟。\n竹稠乱笋穿开路，藤茂多花盖尽篱。\n饭了店翁相送出，丁宁前面小桥危。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午炊浰阳一馆甚雅","author":"赵汝燧","text":"谁料三家市，能令两眼明。\n花喧丛蝶恋，檐午乱鸡鸣。\n忙里青春去，愁边白发生。\n摇鞭问归路，更乞一旬晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午炊溪店","author":"赵汝燧","text":"草店临流傍蓼汀，午炊于此片时停。\n健农怗岸般卵石，幼妇汲泉携斗瓶。\n荐饭满盂山芋美，开窗匝室野花馨。\n隔篱庵舍极潇洒，万竹中间著小亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弋阳道中","author":"赵汝燧","text":"千里叹行役，今朝方半途。\n橘肥霜后颗，松落雨中须。\n店妪当垆问，官人要酒无。\n忻逢扫愁帚，沽了又还沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"日融","author":"赵汝燧","text":"日融风力软，曳杖独逍遥。\n蜂去花心静，莺迁柳影摇。\n一年春易老，两鬓雪难消。\n客至时留饮，无缘特地招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东村","author":"赵汝燧","text":"晴久全无雨，溪乾半是沙。\n风横分雁阵，日转趣蜂衙。\n地僻草埋径，篱摧菊卧花。\n桥西一林竹，潇洒两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍晴","author":"赵汝燧","text":"日色今朝稳，园林二月中。\n池塘展晴绿，桃杏斗春红。\n犯险升高径，扶衰藉小童。\n黄鹂怕人见，飞过野桥东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日友人见过","author":"赵汝燧","text":"荆扉终日闭，难得故人来。\n欲暖寒须酒，相携手问梅。\n艰危惊鬓雪，勋业叹心灰。\n子负江湖气，谁怜当世才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史镇江丐祠得请仍进职 其一","author":"赵汝燧","text":"两载南徐屈从臣，笑谈樽俎运精神。\n民无土木丝毫费，手挈江山表里新。\n千里舳舻渠水利，一团锦绣阆风春。\n夹河柳接甘棠影，下有攀辕卧辙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史镇江丐祠得请仍进职 其二","author":"赵汝燧","text":"帝念承流欲报功，力祈阊阖请琳宫。\n固知槐鼎身将近，却爱莼鲈味不同。\n宝阁风云虽学士，沧洲烟雨且渔翁。\n到家宣室思前席，又使猿惊蕙帐空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"田家叹","author":"赵汝燧","text":"破屋三间结草扉，柴根煨火阖家围。\n此生能得几年活，薄命连遭两岁饥。\n肠久鸣雷惟淡粥，体虽起粟尚单衣。\n晚来稚子总欢喜，报道小姑挑菜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘子愿山居","author":"赵汝燧","text":"般向山边住，萧然茅数椽。\n平塘印星斗，深谷剩风烟。\n老不离书卷，贫谁乞酒钱。\n莫言无管待，频取好茶煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘干东园","author":"赵汝燧","text":"筑圃非容易，经营二十年。\n烟松迷五鬣，风柳起三眠。\n叠石连山麓，栽桃拟洞天。\n最为潇洒处，正在竹林边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘簿约游廖园","author":"赵汝燧","text":"名园新整顿，樽酒约追随。\n春晚花飞少，墙高蝶度迟。\n注汤童煖酒，拍案客争棋。\n寂寞鞦韆索，无人尽日垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同子严初夏饮山閤","author":"赵汝燧","text":"绿阴千百顷，约我共登临。\n山翠含烟重，榴红著雨深。\n行藏皆有命，计较谩劳心。\n病怕杯中物，怜余浅浅斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同杨济翁唐季路陈纯叟饮光风亭光风旧名招屈纯叟席上鼓琴","author":"赵汝燧","text":"江边旧亭子，招屈改光风。\n揭扁名虽异，怀人意则同。\n一篇渔父问，千古大夫忠。\n酒尽琴犹鼓，幽兰曲未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同官率游郑园","author":"赵汝燧","text":"亭围花木阁临池，移席行杯处处宜。\n藻里漾春鱼放子，竹间寻路鹤将儿。\n登山少俊誇先到，扶杖衰残愧独迟。\n所恨隔关归去急，不容结果着残棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同赵尉饮江亭","author":"赵汝燧","text":"草草三间两眼明，数峰如画一江横。\n风乌破浪帆樯急，野鹘过林鸟雀惊。\n蚁取浮篘尤有味，鱼方出网正宜羹。\n流莺怜我无歌者，簧舌频翻柳上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同崔纠访陈道士","author":"赵汝燧","text":"寻幽过桥去，松径入琳宫。\n竹摆风檐绿，榴残雨院红。\n黏碑多古籀，插架独参同。\n道士掀髯笑，诗联石鼎工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"赵汝燧","text":"北固危登最上层，身浮霄汉手扪星。\n江连淮海东南胜，山出金焦左右青。\n天水精神清雁骨，风烟图画入秋屏。\n萧萧古意凭栏久，目尽斜阳没远汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙王渡","author":"赵汝燧","text":"霁后泥途行尚艰，今年大率是晴悭。\n春当浓处寒犹在，寒肯消时春渐还。\n木杪红沉半轮日，波心碧浸两边山。\n渡头不住人来往，共羡白鸥云水闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安仁道中","author":"赵汝燧","text":"半月离乡井，家音杳不闻。\n路危多半缺，桥朽忽中分。\n秋尽风搜叶，日沉岩宿云。\n荒村店虽陋，店主颇殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庄居","author":"赵汝燧","text":"三四间茅屋，回环水石清。\n鸡催残漏尽，月截半窗明。\n好句枕边得，浮名身外轻。\n起来供日课，先绕药畦行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早征","author":"赵汝燧","text":"店鸡一唱接疏钟，起整行装尚梦中。\n沙路踏残征马月，柳堤啼断晓莺风。\n水肥渡险添舟子，岸没途穷问牧童。\n千里乡人逢陌上，片时握手各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次庄过荆渚以诗寄之","author":"赵汝燧","text":"泽国遥千里，云帆隔两州。\n醉行沙市月，吟破渚宫秋。\n鱼叹冯驩铗，貂残季子裘。\n人传君入蜀，无事早归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁州郑守鹿鸣宴","author":"赵汝燧","text":"诏增贡籍自端平，大比贤书拔众英。\n学备六经俱里选，赋推五色以文鸣。\n虽由黄卷能勤苦，皆藉朱轓与作成。\n来岁锦标先夺得，天街听喝状元声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江阁夜","author":"赵汝燧","text":"小阁临江迥，疏帘带雾钩。\n云鸿遥影灭，滩月碎光流。\n诗思偏宜夜，衰髯不耐秋。\n渔灯三两点，隐隐荻花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江楼会饮对月","author":"赵汝燧","text":"层楼画栋淩霄汉，槛外江流百顷清。\n无一片云但秋色，放千里月到天明。\n唤舟撒网鲜鳞美，击鼓喧汀宿鹭惊。\n坐上有人欢未厌，酒阑连釂两三觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中","author":"赵汝燧","text":"离家俄十日，千里独衰翁。\n蓬响过云雨，帆开逆水风。\n新沙增岸脚，小港隐芦丛。\n客思难消遣，黄昏月一弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中","author":"赵汝燧","text":"系缆停征棹，斜阳古渡头。\n风霜先远客，天地独扁舟。\n水鸟冲开浪，汀鸿占断秋。\n在家贫亦好，何用出林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟夜","author":"赵汝燧","text":"夜泊枫林岸，江平万籁收。\n松崖猿袅月，芦渚雁眠秋。\n轩冕傥来尔，林泉归去休。\n客愁正无奈，孤笛起渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行春","author":"赵汝燧","text":"绿杨袅袅草萋萋，缓步行春独杖藜。\n搜蕊蜂儿透花骨，增巢燕子砌芹泥。\n过溪野水冲桥版，觅路田塍穿菜畦。\n松竹林间僧揖我，谒茶携手上招提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖访梅","author":"赵汝燧","text":"久无梅信息，访问到湖滨。\n耐尽一冬冷，开残千树春。\n临流转风韵，与雪斗精神。\n疏影暗香后，能吟有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访上官道人庵","author":"赵汝燧","text":"三十年居此，何尝识酒荤。\n柴扉人少到，草径鹿同群。\n雨足添新瀑，山深有剩云。\n水瓢丹灶外，闲事不曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访子益","author":"赵汝燧","text":"拣得溪山住，三间草屋低。\n坐贫忧酒债，废事悔棋迷。\n壁坏何时补，诗成无处题。\n留余余戒饮，白饭荐黄鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访友人溪居","author":"赵汝燧","text":"数间屋子压溪光，百十乔松列翠行。\n鹤为听琴朱顶侧，鸭皆睡日绿头藏。\n后园遣仆锄冬笋，隔岸寻僧度野航。\n天色黄昏归已晚，苦留夜话对胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访友野外","author":"赵汝燧","text":"雨意方浓改作晴，杖藜野外访柴荆。\n争寻桑叶占蚕熟，退立田塍避犊行。\n风过沙平收鸟迹，烟浓寺没但钟声。\n小童走报余将至，一笑松间倒屣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访次张广上人继至","author":"赵汝燧","text":"都不见尘埃，园扉傍水开。\n晴茵铺碧草，风弹落黄梅。\n访子因寻竹，呼童急办杯。\n诗僧相继至，罢酒把茶来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访别胡倅留饮水阁","author":"赵汝燧","text":"故人知我已膏车，折简殷勤祝访渠。\n惜别匆匆留语笑，临时草草治肴蔬。\n密遮池面荷千盖，斜插云头月一梳。\n此夕凭栏又何日，雁来莫惜数行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访昙师","author":"赵汝燧","text":"道人云外住，小径入庵幽。\n干老梅逾瘦，林疏竹自脩。\n拣茶相伴煮，补线且停抽。\n此事如何说，下山归去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访郑隐君不遇","author":"赵汝燧","text":"行尽枥林村，柴门闭夕曛。\n自来松下坐，閒想壁间文。\n守树猿偷果，窥山犬吠云。\n多应寻鹤去，祇隔暮溪濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访皇甫道士","author":"赵汝燧","text":"道人留淡话，竹院寂无声。\n沽酒童来缓，题窗诗已成。\n海珍纫紫菜，仙品渍黄精。\n移席临檐月，焦桐膝上横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访黄簿留饮","author":"赵汝燧","text":"爱静移家住水南，门排古木枕寒潭。\n鹤翎渐长呼童剪，麈尾频挥对客谈。\n旋切银丝鲙鲜鲫，新尝金颗擘香柑。\n惜余戒饮难陪伴，举白掀髯子独酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过宝云寺访密师","author":"赵汝燧","text":"寺才三二里，曳杖且徐行。\n晴塔松梢见，风钟岭半鸣。\n樵夫分道过，僧子就房迎。\n竹有千竿立，尘无一点生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过曹家渡","author":"赵汝燧","text":"数篙撑过渡，雨后水添肥。\n山橘青迷树，野花香袭衣。\n哀鸿悽远客，斗雀堕斜晖。\n童稚喧林垄，牛羊个个归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过黄园","author":"赵汝燧","text":"黄家亭馆人称好，杖屦春风领客行。\n开放园门千嶂入，爱他山阁一溪横。\n花迷粉翅双飞蝶，柳露金衣百啭莺。\n酒后著棋聊适兴，未须屑屑较输赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邬文伯归自邵阳","author":"赵汝燧","text":"宾主西游久，赓诗日日传。\n交情谁似此，归兴忽翩然。\n楚岸猿吟树，湘江月载船。\n我穷君更甚，相助愧无钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"赵汝燧","text":"十里东风摇羽葆，高低远近万株松。\n侧身靠石牛揩痒，俛首穿林鹿护茸。\n樵子登山云里过，诗僧采药涧边逢。\n近传有虎常来往，隔陇犹存旧脚踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张园","author":"赵汝燧","text":"几年人说张园好，筇杖芒鞋欠我游。\n泉脉涓涓三里远，山根匝匝四时流。\n鹤嫌竹密妨来往，蝶厌花多费应酬。\n台馆高低皆得所，松间亭子最清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀亨父","author":"赵汝燧","text":"两年只影潇湘去，料想尘埃白发侵。\n久雨千山秋得意，西风一雁客关心。\n或于梦里陪谈笑，每向人前问信音。\n忆昔赓诗岩桂下，花开今日叹孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀武陵王广文","author":"赵汝燧","text":"念子经年别，书尝寄驿筒。\n每思谈笑隔，或假梦魂通。\n师范新芹泮，骚情转蕙风。\n拿舟访秦洞，桃雨一川红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀徐教","author":"赵汝燧","text":"忆昔相逢气味投，兴来无日不追游。\n静寻鸥鹭同溪社，醉挈乾坤入钓舟。\n湖海匆匆三岁别，尘埃汩汩几时休。\n一丘彼此皆能办，何用人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜鹃","author":"赵汝燧","text":"才听今春第一啼，如何便道不如归。\n声穿窗隙惊闺梦，血溜花梢溅客衣。\n叫断寸肠谁接续，懒随群翼恋芳菲。\n田园荒尽腰犹折，我亦因君觉昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汪丞招饮问梅","author":"赵汝燧","text":"把酒问梅开也未，巡檐搜见两三枝。\n祇缘今岁寒差甚，故比常年花较迟。\n折向纷华筵畔看，输他冷淡水边时。\n含香嚼蕊清无奈，散入肝脾尽是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日","author":"赵汝燧","text":"四郊社鼓响枫林，朝雨方晴晚复阴。\n稚子求聪多啖藕，佳人怕拙例停针。\n饭争簇巧毋嫌杂，酒正逢时莫厌斟。\n为问年年鸿与燕，去来相避果何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵步","author":"赵汝燧","text":"久雨厌人妨野步，几时便得此番晴。\n到桥唤仆来相助，过寺逢僧约共行。\n篱落一团飞蛱蝶，汀洲数点立鵁鶄。\n农家竹里深深住，风度茅檐纺织声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陇首","author":"赵汝燧","text":"陇首多逢采桑女，荆钗蓬鬓短青裙。\n斋钟断寺鸡鸣午，吟杖穿山犬吠云。\n避石牛从斜路转，作陂水自半溪分。\n农家说县催科急，留我茅檐看引文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到农家","author":"赵汝燧","text":"难得官人到，茅檐且驻车。\n自携锄掘笋，更取网求鱼。\n一媪来斟酒，诸童竞挽裾。\n须臾对吾泣，科役苦追胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和林守玉茗花韵","author":"赵汝燧","text":"园名金柅多奇卉，古干灵根独异常。\n耻与春花争俗艳，故将雪质对韶光。\n天葩巧削昆山片，露蕊疑含建水香。\n当为君侯好封植，角弓三叹誓无忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼","author":"赵汝燧","text":"洞庭雄压岳阳楼，万里风烟万里秋。\n左右江湖同浩荡，东西日月递沉浮。\n青蛇鸣袖神仙过，古瑟弹湘帝子游。\n朝暮飞鸥千百点，送迎城下去来舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弦歌堂对雨","author":"赵汝燧","text":"绝交诗酒客，扑面簿书尘。\n汩没朝连夜，匆忙雨过春。\n民宽残税欠，身受上官嗔。\n了却三年债，归耕秀水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]