"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽歌词二首 其二","author":"司马光","text":"雾晓铜鱼跃，霜寒阊阖开。\n哀声际海发，灵仗拂天来。\n别寝严虚位，重阍閟夜台。\n柏城空有路，无复属车回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽歌词二首 其一","author":"司马光","text":"声教万馀里，文明四十春。\n茂勋留信史，盛德满生民。\n共适禽鱼乐，安知橐籥仁。\n百年龙驭远，空复仰威神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十八日夜大暑","author":"司马光","text":"老柳蜩螗噪，荒庭熠耀流。\n人情正苦暑，物怎已惊秋。\n月下濯寒水，风前梳白头。\n如何夜半客，束带谒公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双竹","author":"司马光","text":"双干标枯腹，青青凡几霜。\n龙腾双角直，鲸喷两须长。\n但欲寻支遁，安能问辟疆。\n屡来非别意，未与此君忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太皇太后挽歌词二首 其二","author":"司马光","text":"四纪袆衣盛，两朝长乐尊。\n九州贡甘旨，万乘问晨昏。\n明辟归元子，嘉谋赉孝孙。\n群生资后土，难答化光恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太皇太后挽歌词二首 其一","author":"司马光","text":"麟阁承家庆，轩星应德晖。\n帝猷阴有补，嫔则动无违。\n遽就苍梧野，空馀大练衣。\n只应彤管在，万古播鸿徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆庞之道","author":"司马光","text":"畴昔两垂髫，知音结久要。\n何言半涂别，不待岁寒彫。\n幸有才名在，非随气运消。\n英灵犹彷佛，宿草已萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文太师挽歌三首 其三","author":"司马光","text":"夏屋封何处，山田有卧牛。\n蟠根走伊水，回首负嵩丘。\n忠孝家风备，哀荣礼秩优。\n龙鸾舞宸翰，万古照松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文太师挽歌三首 其二","author":"司马光","text":"美化流民物，薰然遗爱多。\n栾公当日社，邵父至今歌。\n庭有三鳣集，门容驷马过。\n欲知馀庆在，公鼎格平和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文太师挽歌三首 其一","author":"司马光","text":"汾晋地形美，古今多钜贤。\n况承勋烈后，宜有庆灵传。\n著位登朝古，声华出众先。\n起家从此始，圭组遂蝉联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田横墓","author":"司马光","text":"昔时南面并称孤，今日还为绛灌徒。\n忍死祗能添屈辱，偷生不足爱须臾。\n一朝从殉倾群客，千古生风激懦夫。\n直使强颜臣汉帝，韩彭未必免同诛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下小饮","author":"司马光","text":"美景赏心相值难，良宵四座尽儒冠。\n月华过冷衣襟润，酒力易消樽俎寒。\n自有笑谈供逸气，不须丝竹借馀欢。\n坊楼五鼓欲催曙，桂影长先高兴阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王金吾北园","author":"司马光","text":"丞相后园天籞邻，年年分借上林春。\n目前但识禽鱼乐，门外何妨车马尘。\n花蘤祗疑名品尽，图书方验古今贫。\n将军朝下无馀事，端为风烟作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长安送李尧夫同年","author":"司马光","text":"昔岁琼林花气曛，今朝长乐柳梢春。\n事随流水滔滔度，鬓结繁霜戢戢新。\n世路饱谙都是梦，人生可贵莫如身。\n会须筑室临清洛，相与携筇戴葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风","author":"司马光","text":"陇首红旌急，樽前翠幕重。\n林端翻远刹，花外转疏钟。\n夜寂清机发，春阑别意浓。\n如何玉琴韵，并欲在青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风雪数日不见叔度晚约公明共诣之 其一","author":"司马光","text":"云雪连朝闇，朋从叹坐违。\n临文与谁共，开卷为君稀。\n趣扫六花散，聊通一径微。\n当携兔园赋，同映读书帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东窗","author":"司马光","text":"临风梳短发，萧飒晚凉新。\n不识市朝客，何如江海人。\n沈吟凭棐几，攲侧带纱巾。\n浊世事无尽，东窗聊放神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐","author":"司马光","text":"吾心自有乐，世俗岂能知。\n不及老莱子，多于荣启期。\n缊袍宽称体，脱粟饱随宜。\n乘兴辄独往，携筇任所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乐轩","author":"司马光","text":"繁弦凝绿水，叠鼓掺渔阳。\n风结舞初急，尘飞歌正长。\n凫鹥争上下，栋宇为低昂。\n太守且安坐，新声未遽央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代叔礼作使北诗","author":"司马光","text":"人主爱民物，心无彼此情。\n约欢同一国，蒙福遍群生。\n玉帛遥相望，风波寂不惊。\n熙熙南北海，所至尽升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北轩老杏其大十围春色向晚止开一花予悯其憔悴作诗嘲之","author":"司马光","text":"春木争秀发，嗟君独不材。\n须惭一花少，强逐众芳开。\n顽艳人谁采，微香蝶不来。\n直为无用物，空尔费栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北京留守王太师挽歌词二首 其二","author":"司马光","text":"昔日程文士，中间侍坐宾。\n游陪惭晚辈，待遇过它人。\n方叹龙门远，俄惊马鬣新。\n西园行乐处，引领但沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]