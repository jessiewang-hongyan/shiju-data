[{"title":"酬次道板桥晚望见寄","author":"司马光","text":"春来曾约醉河桥，深负垂杨千万条。\n今日都门相望处，西风乱叶正萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静夜","author":"司马光","text":"午夜空斋四悄然，清寒透骨不成眠。\n秋风故揭疏帘起，正漏月华来枕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮水 其二","author":"司马光","text":"淋淋出海门，百里雪花喷。\n坐看东归去，平沙空有痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潮水 其一","author":"司马光","text":"平江欲上潮，古木自萧萧。\n两岸饶葭苇，寒波浸寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉","author":"司马光","text":"厚于太古暖于春，耳目无营见道真。\n果使屈原知醉趣，当年不作独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹭鸶","author":"司马光","text":"清闲自合无忧累，白发何因更飒然。\n遥望孤飞下秋水，雪花一片落晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁尚书挽词二首 其二","author":"司马光","text":"丹阙晨趋退，萧然忘世荣。\n闲斋虚自白，永日澹无营。\n脱落簪缨累，沈冥丘壑情。\n贪夫诚有激，千载素风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁尚书挽词二首 其一","author":"司马光","text":"凤跸游汾曲，非熊得伟人。\n闺台尤显重，训诰愈深淳。\n论道参黄阁，横经侍紫宸。\n如何天不整，志业未全伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日怀聂之美 其一","author":"司马光","text":"钱唐江里扁舟上，别后篱花几度黄。\n忧患萦心何缭绕，风光满目尽凄凉。\n谁同凿落杯中酒，独系茱萸肘后囊。\n可复无书道情素，云间空有雁南翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日怀聂之美 其二","author":"司马光","text":"太室横山蔽十里，相思空复上高台。\n瓮头白酒行当熟，篱下黄花稍复开。\n陶令不无同醉兴，孟君况有解嘲才。\n欲凭西北高风势，飞度轘辕劝一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十八日会不疑家席上纪实","author":"司马光","text":"召客客俱来，赏花花正开。\n寒暄方得所，风雨不相催。\n席上柳飞雪，门前车隐雷。\n主人意仍厚，安得不徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月二日太常致斋晨起呈景仁次道二同舍","author":"司马光","text":"官舍春萧瑟，朝来尚薄寒。\n人虽繁陌上，尘不近门端。\n已负踏青约，仍无举白欢。\n凭君御沟上，试折柳条看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月三十日与同舍宴李氏园晚归马上赋诗","author":"司马光","text":"门前蹀躞金羁满，坐上连翩玉斝飞。\n数尺游丝留客醉，一行垂柳送人归。\n同邀胜友时难得，重到名园花已稀。\n莫惜芳辰剩行乐，无端风雨横相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十五日夜陪留守宣徽登西楼值雨待月久不见","author":"司马光","text":"经岁侍佳节，无如阴霭何。\n果然时雨足，安用月华多。\n未免银缸进，空闻玉漏过。\n庾公兴不浅，久为驻鸣珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月五日夜省直","author":"司马光","text":"大火已西落，温风犹袭人。\n留连惜纨扇，散诞脱纱巾。\n蟾影夜色浅，蛩声秋意新。\n图书足自适，何物更关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月七日夜省直苦雨三首 其三","author":"司马光","text":"菊蕊如排粟，青青见叶心。\n未尝窥白日，何以散黄金。\n攲侧疏篱短，绵延蔓草深。\n寒蛩尔何与，终夕亦悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月七日夜省直苦雨三首 其二","author":"司马光","text":"怅望中秋月，于今已上弦。\n明生圭样小，影露桂花偏。\n幽思邈难致，浮云去不还。\n何当出阴翳，清彻照中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月七日夜省直苦雨三首 其一","author":"司马光","text":"夜色槐阴重，雨声官舍寒。\n野农安敢问，环堵未能完。\n尽日流云度，何时大块乾。\n正愁开霁晚，霜雾满红栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又云新铸釜斛与今太府寺尺及权衡若合符契复次前韵","author":"司马光","text":"裁筒累黍久研精，况复新修釜斛成。\n岂校忽微争口语，本期淳古变人情。\n既言乐律符今尺，但恐箫韶似郑声。\n若欲世人俱信服，凤凰再集颍川城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又代孙检讨作二首 其二","author":"司马光","text":"人为天地客，处世若浮休。\n岂有生长在，祗知名可留。\n露沾寒草晚，风啸白杨秋。\n地下求文友，应从顾陆游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又击毬","author":"司马光","text":"肃奉乘轺命，仍陪戏马游。\n朋分初迥出，势合复相收。\n顾盼华星激，萦回紫电流。\n良因重嘉好，礼接使臣优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和二月五日夜风雪","author":"司马光","text":"春风正豪怒，夜雪复飘扬。\n勿使羁愁乱，自知清兴长。\n帘疏声淅沥，灯冷晕微茫。\n此夕牛衣客，成名不可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和六日四老会","author":"司马光","text":"萸房迎令节，菊蕊入芳筵。\n华烛初长夜，清霜未冷天。\n悲风咽横吹，骤雨送繁弦。\n聊附邹枚客，敢希园绮贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和开叔","author":"司马光","text":"寒梅犯雪荣，大隐久专名。\n异种生江渚，何年到洛城。\n色如虚室白，香似主人清。\n响使吴儿见，不思菰菜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和安国寺及诸园赏牡丹","author":"司马光","text":"洛邑牡丹天下最，西南土沃得春多。\n一城奇品推安国，四面名园接月波。\n山相著书称上药，翰林弄笔作新歌。\n人间朱粉无因学，浪把菱花百遍磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和来韵","author":"司马光","text":"年老逢春无用惊，对花弄笔眼犹明。\n不嫌贫舍旧来燕，唤起醉眠何处莺。\n一仆相随幅巾出，群童聚看小车行。\n人间万事都损去，莫遣胸中气不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和留题定襄驿","author":"司马光","text":"按节羊肠阪，褰帷并塞州。\n仁风熙爱日，清德凛高秋。\n甘泽随征盖，华星近戍楼。\n佗年叱驭事，直笔寄歆彪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和雪霁","author":"司马光","text":"南宫来几时，挟纩易春衣。\n意谓花将晚，何言雪尚飞。\n夜声通旅枕，晓色弄晴晖。\n继日劳王事，离离雁已归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄献","author":"司马光","text":"承明共直庐，瞬息八年馀。\n幸托屏星驾，前迎使者车。\n迹虽殊贵贱，心不置亲疏。\n青眼披情素，犹如相见初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日与太学诸同舍饮王都尉园","author":"司马光","text":"冠盖郁相依，名园花未稀。\n游丝萦复展，狂絮堕还飞。\n积弩遗风陋，兰亭旧俗微。\n何如咏沂水，春服舞雩归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元书怀","author":"司马光","text":"老去春无味，年年觉病添。\n酒因脾积断，灯为目阿嫌。\n势位非其好，纷华已久厌。\n唯馀读书乐，暖日坐前檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与乐道约会超化寺比至乐道以疾先归涂中有诗见寄","author":"司马光","text":"颠毛种种齿浮摇，屈指交游渐寂寥。\n时较半朝非是晚，路无数里不为遥。\n子猷垂到复归去，安道虽知未易邀。\n古寺徘徊久东望，青春云日冷萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨效乐天体","author":"司马光","text":"雨多虽可厌，气凉还可喜。\n欲语口慵开，无眠身懒起。\n一榻有馀宽，一饭有馀美。\n想彼庙堂人，正应忧燮理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之美举进士寓京师此诗寄之","author":"司马光","text":"结发声华盛，无疑屈未伸。\n何妨久垂翅，从此欲惊人。\n鹰击天风壮，鹏飞海浪春。\n行当解故褐，不惜化京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子高有徐浩诗碑昌言借摹其文甫及数本石有微衅惧而归之子高答简有碎珊瑚之戏昌言以诗赠子高同舍皆和","author":"司马光","text":"徐公精笔老生神，石刻犹能妙夺真。\n几为通书翻丧宝，愈令好事惜传人。\n锋铓半折犹能健，圭璧微瑕自足珍。\n直使尽随如意碎，石家玉树未全贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","p