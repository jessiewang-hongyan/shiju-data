[{"title":"和黄宰木犀","author":"洪咨夔","text":"春风花事数河阳，又见玲珑糁缀黄。\n万斛香添秋酝藉，十分凉借月容光。\n熏奁拾取留长挹，汤鼎煎来得细尝。\n须信小山标致别，从渠涂额学宫妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和程教元日韵","author":"洪咨夔","text":"晓云三素过天东，早送韶华入万红。\n枍诣霜寒迟景转，昆明太液薄澌融。\n憨痴官事龟生手，泰定天光漆点瞳。\n柏叶更须随酒进，醉乡有地爵无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂去","author":"洪咨夔","text":"凤凰知细德，鸥鸟识机心。\n物理固如此，世情非特今。\n足缨清与浊，厉揭浅和深。\n觉破从前梦，长歌月满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐","author":"洪咨夔","text":"夜永难为睡，群儿坐伴翁。\n漉齑冰瓮碧，撚豆雪炉红。\n清诵听还隽，闲谈笑又烘。\n安排明蚤供，荠长后园丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜读夷坚放卷偶成","author":"洪咨夔","text":"敛卷惊嗟语幻哤，搔头危坐对明缸。\n梧桐细语秋传信，络纬长鸣月上窗。\n浊酒不多双耳热，妙香无尽寸心降。\n家山未得平安报，飞梦东归拜老庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使燕山回早行书事","author":"洪咨夔","text":"露满中庭月满天，秋来怀抱转悽然。\n客程恨不日千里，归思乱如云一川。\n故国伤心那忍说，遗民望眼几回穿。\n当家旧事堪垂泪，海上看牛十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝云庵戒师","author":"洪咨夔","text":"钟山好住苦弗住，驮岭难居真欲居。\n出地入天须任我，来今去古不关渠。\n万由旬上起肤寸，一刹那间弥太虚。\n识得鬘华云体段，妙高高处坐如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岸行","author":"洪咨夔","text":"少年血气暗消磨，盎盎阳春保大和。\n已放杏花风味短，未酸梅子典刑多。\n一官满去鱼无饵，万里归来燕有窠。\n但愿时平蚕麦好，免教人问蜀如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泥溪 其二","author":"洪咨夔","text":"左计来行险，强名为爱奇。\n一家川䖃苴，三顿豆离萁。\n压架龙门石，撑囊剑阁诗。\n扁舟归计足，不问鹤和龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泥溪 其一","author":"洪咨夔","text":"沙路缘江曲，斜阳塞轿明。\n晚花酣晕浅，平水笑窝轻。\n喜荫时休驾，疑昏屡问程。\n谁家刚齐饼，味过八珍烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"狐鼠","author":"洪咨夔","text":"狐鼠擅一窟，虎蛇行九逵。\n不论天有眼，但管地无皮。\n吏鹜肥如瓠，民鱼烂欲糜。\n交征谁敢问，空想素丝诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗解元母胡氏挽诗","author":"洪咨夔","text":"三世不异爨，一门皆力书。\n此风今所少，他行特其馀。\n藻锜明疏牖，萱窝护碧除。\n春光元自在，遗梦杳安舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗察院父瑞桂堂","author":"洪咨夔","text":"老仙方寸长黄芽，百顺薰蒸到物华。\n移得广寒宫里种，开将后土庙中花。\n诗书根蒂圣贤脉，忠孝馨香今古牙。\n富贵傥来馀事耳，化工深意属君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗告至李汉州","author":"洪咨夔","text":"驿奴莫问客为谁，但报房湖水石知。\n象鼻卷筒和月吸，凤膺横玉倚风吹。\n江淮消息愁端压，关洛功名老色欺。\n陶写此情须会得，行厨催唤莫教迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨","author":"洪咨夔","text":"夥颐秋后雨，暝些晚来凉。\n夹市崩崖赤，环城涨潦黄。\n随宜梨栗熟，满意黍荞香。\n白鹭追红鹤，归飞作个忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞提举挽诗 其二","author":"洪咨夔","text":"苍鹤孤山晓，黄花栗里秋。\n一身虽物外，万国尚眉头。\n遗老几何在，耆英只么休。\n问天天不语，江阔莫云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞提举挽诗 其一","author":"洪咨夔","text":"展也万夫特，翛然山泽臞。\n朔风空汴泗，春水渺淮湖。\n筹驿尹师鲁，诗坛梅圣俞。\n绣衣归老去，有韫不轻沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事 其二","author":"洪咨夔","text":"黄奶扶春梦觉来，禅心已堕老黄梅。\n沾沾桃叶相先发，寂寂梨花未肯开。\n抱案并无钳纸请，索书时有打门催。\n人生消得韶华几，两鬓霜根不待栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事 其一","author":"洪咨夔","text":"杨柳黄黄燕子来，梅花落尽已青梅。\n一年春事闭门过，万里客怀呼酒开。\n西土逖哉鸿雁断，东方明矣子规催。\n海棠多买燕宫本，归去家山手自栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行","author":"洪咨夔","text":"百舌梢头一半春，日长无处着闲心。\n推枰竞欲投机早，结眊谁知用意深。\n梅子胚胎盐里味，桐花摆布蜜边阴。\n东皋西崦行几遍，软脚踉蹡索酒斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春行次韵","author":"洪咨夔","text":"拂开芳草碧，坐断落花红。\n世味觥筹外，年华带眼中。\n六州空铸铁，万物任为铜。\n有鷕桑畴雉，逢时会长雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春事","author":"洪咨夔","text":"莫为春愁两鬓翁，管愁元不属春风。\n深黄杨柳夕阳外，淡白杏花明月中。\n大自在身天地并，妙光明性圣愚同。\n鸣鸠乳燕相料理，融得从前万虑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雪","author":"洪咨夔","text":"甲子乾飞雨，元宵湿陨星。\n风柔行阵阵，月淡下亭亭。\n木笔侵凌碧，来牟掩映青。\n东皇收拾急，暖涨赴沧溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昭化","author":"洪咨夔","text":"梅子收霖雨，榆花断瘴烟。\n浓云明白鸟，深草暗乌犍。\n岁月滩声里，家山客枕边。\n老来圭角尽，戒得是韦弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳","author":"洪咨夔","text":"天机日与物华新，妩绿柔黄触拨人。\n精采只消些子雨，腰肢无着许多春。\n兴亡萤苑迷楼梦，荣辱孤山曲院尘。\n醒眼年来浑看破，万缘分定不须颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳用前韵","author":"洪咨夔","text":"菀彼烟丝一样新，依然面目我陈人。\n只疑大造元无物，岂料深山亦有春。\n尽日三眠浑得意，随风万舞不惊尘。\n长长短短亭前路，肯与渠侬管笑颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洗研","author":"洪咨夔","text":"自洗洮州绿，闲题柿叶红。\n一尘空水月，百念老霜风。\n钝菊凄犹蕾，颠桃艳已丛。\n斡流千万变，谁实主鸿濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪园洗心堂饮中偶成","author":"洪咨夔","text":"官事何时了，抽身朱墨丛。\n未霜乌桕赤，得日紫薇红。\n山势西南缺，湖光左右通。\n引将丝竹却，洗耳听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省中和何子温见寄","author":"洪咨夔","text":"东风婉娩燕来双，禁漏无声万绿香。\n宝鸭炷云朝太紫，玉蜍挹露校铅黄。\n圣贤不断千年脉，宇宙长存一点光。\n老鹤也知虚静好，夜深踏月上脩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"省闱试士","author":"洪咨夔","text":"东风席帽快行催，浑为天家造士来。\n捧诏九霄云气湿，分题五色日华开。\n拣金沙里须精鉴，脱颖囊中尽异材。\n容受直言天子圣，好听胪唱响春雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祖母哀挽 其二","author":"洪咨夔","text":"叠綵春风里，含饴爱独深。\n卷卷行己训，历历读书箴。\n长忆违离语，难酬侍养心。\n微官稽执绋，东望泪盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祖母哀挽 其一","author":"洪咨夔","text":"我祖当家始，零丁只影存。\n根芽惟大母，枝叶又曾孙。\n触少心犹惕，慈多语易温。\n德尊年亦称，消得诰花恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀 其二","author":"洪咨夔","text":"鹦鹉琵琶恨，融归十四弦。\n拨寒红玉笋，拍暖绣金莲。\n梅影春风里，茶声雪水边。\n自怜还自笑，星发照婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀 其一","author":"洪咨夔","text":"素节垂垂杪，衰怀拍拍丛。\n风乾梧叶白，霜老菊花红。\n理曲多添瘦，停诗不减穷。\n出寻空阔处，揩眼送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"洪咨夔","text":"一日一番雨，三更三昧凉。\n桐边青弄影，荷底静留香。\n俗物刺人眼，世情冰我肠。\n关山何处笛，落月照胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆公","author":"洪咨夔","text":"君臣一德盛熙宁，厌故趋新用六经。\n但怪画图来郑侠，何期奏议出唐坰。\n掌中大地山河舞，舌底中原草木腥。\n养就祸胎身始去，依然钟阜向人青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荠馄饨","author":"洪咨夔","text":"嫩斸苔边绿，甘包雪里春。\n萧家汤是祖，束叟饼为邻。\n混沌函三极，冲和贮一真。\n日斜摩腹睡，自谓葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和及甫雪","author":"洪咨夔","text":"胚腪造化妙天家，趁得辛夷未着花。\n浊水淤泥还絮白，枯株朽树亦芳华。\n长空光眩鸣皋鹤，厚地寒侵入宇蛇。\n钜竹南墙清绝甚，一编孟子一瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王崇庆得樽字","author":"洪咨夔","text":"白苧笼轻暑，红榴照别樽。\n两帆先后去，一水古今存。\n玉札须多蓄，金瓯莫点痕。\n相期黄卷里，培植太平根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张行父守赣 其二","author":"洪咨夔","text":"南斗一帆外，西风千骑头。\n莫嗟中落落，须感上休休。\n贾谊词林晓，陈蕃墓草秋。\n经行拚斗酒，为浣古今愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张行父守赣 其一","author":"洪咨夔","text":"觉是圣贤脉，复为天地根。\n典刑诸老尽，文献几家存。\n露下鹤先警，风高鸿独骞。\n一时京洛价，知有魏公孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李致远安远簿 其二","author":"洪咨夔","text":"与我迭知己，喜君初得官。\n时来宁论晚，身健莫辞难。\n访雪牵魂梦，停云寄肺肝。\n斯文元气在，努力好加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李致远安远簿 其一","author":"洪咨夔","text":"四海几青眼，五车今白头。\n信天投矮屋，觅地起岑楼。\n山迥风烟合，江平潦雾收。\n谁欤人物计，留取备枚邹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜阳安奉亲还蜀 其二","author":"洪咨夔","text":"买我归吴棹，扬君溯蜀旃。\n虽为万里别，端有一家缘。\n腊雪添新涨，春风减旧绵。\n江山随处好，横槊小留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杜阳安奉亲还蜀 其一","author":"洪咨夔","text":"访落方勤止，而翁苦掉头。\n立几遗世独，行盍为王留。\n日月驰双毂，乾坤寄一舟。\n勿缘归计得，忘却纬边忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐显道尉无锡","author":"洪咨夔","text":"握手不禁别，庭梧声欲秋。\n云霄生脚底，田里付眉头。\n敬是禔身柱，和为应物舟。\n卷旗蒲柳市，茶鼎雨飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秦秘监还蜀 其二","author":"洪咨夔","text":"蜀产班行几，分符又去之。\n气完吞落日，心定发凉飔。\n蝇虎攫何壮，蜗牛升更痴。\n见几能许早，别思渺江蓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送秦秘监还蜀 其一","author":"洪咨夔","text":"岷峨人物古，淮海姓名香。\n识面岁华晚，论心春昼长。\n有怀胡去国，无愧好还乡。\n呼酒犒三老，柁楼天正凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高才卿守永康 其二","author":"洪咨夔","text":"岷峨悽怆未全苏，急要诸公着力扶。\n政似刈葵难放手，民如种树莫搔肤。\n雪山西去三边静，沬水东来万井腴。\n小队还家聊上冢，天寒早与问无襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高才卿守永康 其一","author":"洪咨夔","text":"同社纷纷早上坡，一麾独爱晚婆娑。\n矜春桃李好能几，饱雨稻粱收更多。\n管摄三才还正大，陶镕万象是中和。\n西风未用轻分手，尚欲从君细切磋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送章君范之湖南幕","author":"洪咨夔","text":"天阔孔鸾起，江晴荃若春。\n亲荣知有子，主胜信宜宾。\n岳麓盛古学，衡山多秀民。\n平生金玉质，更看濯磨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程于潜 其一","author":"洪咨夔","text":"溪山民物古，政理器能宽。\n平易见眉睫，明清生肺肝。\n春风帘影暖，霜月研声寒。\n野老自相语，元丰崔长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程于潜 其二","author":"洪咨夔","text":"溯紫催飞舄，攒红簇去鞍。\n吾邦倾市送，旁邑塞涂看。\n清庙登牺象，明庭峙孔鸾。\n野翁麋鹿友，时与讯平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程宗武游岝崿","author":"洪咨夔","text":"骤暖揠芳意，薄游烘软尘。\n乱山云气晓，啼鸟杏花春。\n人物少催老，物华新换陈。\n一声铿尔瑟，沂水绿鳞鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送澄维那访旧湖山","author":"洪咨夔","text":"梅子酸犹浅，桃花艳已饶。\n春风开口吸，明月换肩挑。\n鹤向平湖放，猿从古洞招。\n出门天地阔，何处不逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黎德升出守眉州 其二","author":"洪咨夔","text":"同是郾城客，对床如弟兄。\n秋风双鬓改，落日寸心明。\n终古方书在，随时局面更。\n公馀经济学，讲贯不嫌精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黎德升出守眉州 其一","author":"洪咨夔","text":"霜隼健毛骨，冥鸿高羽翰。\n来迟怀去速，退易挽留难。\n文物声明郡，中和孝友官。\n大冯棠荫在，多放一分宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过剑门","author":"洪咨夔","text":"众水东瞿峡，连山北剑门。\n地非甘习坎，天欲护全坤。\n直上云千尺，中间月一痕。\n客怀无柰恶，索酒自招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟云叔挽诗","author":"洪咨夔","text":"秋隼风神耸，春云笔势奇。\n人情方共属，天理竟难窥。\n哭子零丁母，啼耶娅姹儿。\n落花飞絮急，行道亦伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟太君挽诗","author":"洪咨夔","text":"护额锦裁帕，扶腰珠络衣。\n几回呼使进，尽日醉言归。\n径古梅成荫，堂深桂合围。\n重来无复拜，春色黯斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟惠叔转示赵临安两山堂诸公诗刻随喜二首 其二","author":"洪咨夔","text":"朵颐常逐逐，观复自休休。\n静昼青竹笋，深春黄栗留。\n觉圆熏穟直，梦破茗华浮。\n为问连山易，床头好在不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟惠叔转示赵临安两山堂诸公诗刻随喜二首 其一","author":"洪咨夔","text":"两峰高峙玉，五亩秀含滋。\n细柳未眠种，脩篁方醉移。\n雨将云出谷，水引月归池。\n动静天机密，何人共一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻山阳夏全之变","author":"洪咨夔","text":"洮湟私牍旧开边，淮楚依然样子传。\n抱虎寝蛟心不保，护疽讳蛊祸相挻。\n河流三舍尽人血，城阖四门无灶烟。\n昨夜洗兵盈尺雪，华夷齐贺太平年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除妄","author":"洪咨夔","text":"酒泉能醉么，饭颗免饥不。\n万事得如愿，一生应莫愁。\n凉风高放鹤，落日倒骑牛。\n诸妄冰消尽，吾师马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新年","author":"洪咨夔","text":"欲识新年课，都非旧日图。\n词分诗料帐，酒夺饭工夫。\n锻息柳边手，镊闲花里须。\n寒消芳草绿，打急办行厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜哭内","author":"洪咨夔","text":"密雪疏风客屋穿，几回除夕伴忧煎。\n团栾方索日边饭，契阔已成松底眠。\n画火何堪思旧事，理衣谁与管新年。\n平时戒汝无多酌，争得屠苏到汝前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奚左藏挽诗二首 其二","author":"洪咨夔","text":"诸老定交早，群儿惊见稀。\n功名身韫椟，翰墨世传衣。\n龟寿前占梦，鸥盟晚息机。\n吴头耆旧尽，搔首送斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奚左藏挽诗二首 其一","author":"洪咨夔","text":"理学不远复，躬行毋自欺。\n志虽千万往，材仅二三施。\n花竹觥筹密，云山步屐迟。\n眇然人物里，公竟止于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]