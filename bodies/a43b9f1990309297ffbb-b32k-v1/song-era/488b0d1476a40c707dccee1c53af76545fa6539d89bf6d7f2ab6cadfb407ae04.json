[{"title":"得乡书","author":"吴芾","text":"闻道交亲知我还，欢迎竞欲越乡关。\n我于乡里初无补，又复劳人祇汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得子云和篇约元宵见访再用前韵以速之二首 其二","author":"吴芾","text":"花开本是待春来，天遣春先荐我杯。\n君莫疑花开太早，相思一夜发寒梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得子云和篇约元宵见访再用前韵以速之二首 其一","author":"吴芾","text":"闻道元宵始肯来，见梅说与且停杯。\n行将有客同清赏，雅致高标一似梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家书喜津病愈","author":"吴芾","text":"老怀郁郁苦难舒，忽报吾儿病已除。\n便觉身心无个事，万钱不抵一封书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼王习之","author":"吴芾","text":"两州佳政万人传，一旦那知遂溘然。\n到底久生从古少，要须乘健早归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴三首 其三","author":"吴芾","text":"三分春色二分过，那更连宵风雨多。\n试向园中问消息，不知还尚有花么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴三首 其二","author":"吴芾","text":"时巡中外已欢呼，那值天晴喜浴凫。\n路上捷音良可庆，王师所至若摧枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴三首 其一","author":"吴芾","text":"洗尽妖氛喜乍晴，风生万马四蹄轻。\n天时人事俱相契，敢有纤儿更弄兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅庄主人袖诗见过累日欲得次韵以汩汩无暇且和一绝","author":"吴芾","text":"偶驱小队踏苍苔，无数梅花照眼开。\n更有高人同胜赏，此行端是不虚来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花下饮茶又成二绝 其二","author":"吴芾","text":"强拈茶碗对梅花，应是花神笑我多。\n更取香醪拚一醉，不禁风味恼人何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花下饮茶又成二绝 其一","author":"吴芾","text":"昨日花前酒太过，今朝怕见近流霞。\n不应辜负花枝去，且嗅清香倍饮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花下闻角声","author":"吴芾","text":"兀坐江城厌寂寥，喜逢春色上梅梢。\n寄言画角休吹遍，留与铃斋作淡交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅亭盖旧太守徐公禋所作传者谓公得庾岭梅移种于此故创斯亭余来相距未六十年曩日之梅已无复有感时追往因取野梅环植之仍赋二绝 其二","author":"吴芾","text":"种梅我始效徐公，已觉幽香鼻观通。\n寄语后人无剪伐，要令凋郡识春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅亭盖旧太守徐公禋所作传者谓公得庾岭梅移种于此故创斯亭余来相距未六十年曩日之梅已无复有感时追往因取野梅环植之仍赋二绝 其一","author":"吴芾","text":"已无庾岭旧时梅，但见梅亭向水开。\n遐想风流犹彷佛，更将梅绕四檐栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅怨 其二","author":"吴芾","text":"我与梅花素有期，故应花怨我轻离。\n巡檐索笑宁无日，少待归来酒作池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅怨 其一","author":"吴芾","text":"几年不见主人归，及见开时又别离。\n若也有花无分赏，何如休种满园池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移梅北隩和黄清表韵","author":"吴芾","text":"自惭面目久尘埃，拟对冰姿一笑开。\n闻道前村连夜发，岂辞健步远移来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后观梅 其二","author":"吴芾","text":"春色三分已一分，江梅犹自占青春。\n有花堪折须拚醉，莫待东风吹作尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后观梅 其一","author":"吴芾","text":"雨声才歇雪漫漫，深恐梅花不耐寒。\n破晓踏泥来问讯，细看枝上喜平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客赏海棠雪作 其一","author":"吴芾","text":"绝艳妖娆压众芳，况来烛下逞新妆。\n引将姑射神人到，亦逐春风上下狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客赏海棠雪作 其二","author":"吴芾","text":"撩拨游人思不禁，也缘尤物荡人心。\n今宵雪向花间作，应妒此花红太深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客赏梅 其二","author":"吴芾","text":"只拟花开把酒杯，南枝忽递暗香来。\n径须领客同清赏，莫待城头吹落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"领客赏梅 其一","author":"吴芾","text":"经年相别阻传杯，忽见梅枝入眼来。\n今日劝君休惜醉，不应辜负腊前梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"吴芾","text":"正忧麦槁井泉乾，一雨中宵忽沛然。\n莫恨梅花憔悴去，且欣新绿尽归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨三首 其三","author":"吴芾","text":"畏暑停骖憩驿亭，不知郭外雨如倾。\n晚行但觉通衢湿，凉入郊墟分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨三首 其二","author":"吴芾","text":"昨朝偶得碧琳腴，不敢濡唇畏暑涂。\n雨过凉生襟袂爽，不妨倾倒且踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨三首 其一","author":"吴芾","text":"铄石流金苦异常，行人谁不困秋阳。\n狂风忽送排檐雨，涤尽炎威作晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴","author":"吴芾","text":"始喜晴天照眼明，忽惊风雨报秋声。\n天公也念悲秋客，还扫群阴作晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒梅","author":"吴芾","text":"冰玉精神绝点埃，人间无物似寒梅。\n凌霜傲雪浑閒事，最是欺春不逐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡钱塘江","author":"吴芾","text":"万顷烟波一叶轻，风来枕上觉凉生。\n我行触热浑无奈，却喜身心得顿清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游月岩 其二","author":"吴芾","text":"平生性僻喜岩居，事不如人只守株。\n拟欲结茅依石罅，仙人还许我来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游月岩 其一","author":"吴芾","text":"仙人蜕骨几何年，姓氏于今秘不传。\n石壁苍崖无处问，空馀洞府尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都观五首 其五","author":"吴芾","text":"登览兹山古到今，流传今有几何人。\n如今胜践悬知少，况有新诗为写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都观五首 其四","author":"吴芾","text":"人已乘龙去不还，尚馀双鹤不知年。\n坐来顿觉尘寰隔，始信壶中别有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都观五首 其三","author":"吴芾","text":"闻道山颠有鼎湖，莲花还似旧时无。\n轩辕去后空车辙，疑此山川即旧都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都观五首 其二","author":"吴芾","text":"策杖行行入翠微，步虚山下久忘归。\n幽栖宜有中林士，何事斯人近世稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙都观五首 其一","author":"吴芾","text":"来访仙人古玉虚，山前有客指迷涂。\n烟云渺渺孤峰绝，松竹森森一径迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登舟","author":"吴芾","text":"天怜行客困阳秋，许舍车徒上小舟。\n十里好风袪滞思，一溪寒水助清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登进贤县治后山望云亭","author":"吴芾","text":"古木千章翠欲交，白云疑只在松梢。\n公馀莫惜频登眺，无限风烟满四郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登望云亭","author":"吴芾","text":"记得来时上此亭，亭荒有景亦徒清。\n如今亭与景俱胜，水倍秀兮山倍明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢陈詹山惠蜡梅","author":"吴芾","text":"岁晚相逢眼已明，一枝还复见高情。\n幽香不与江梅共，要与夫君斗独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赏山茶","author":"吴芾","text":"向晚佳人逞艳妆，偶随月姊到山房。\n自怜老去无佳句，亦复冥搜为发扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲁漕惠鹿鹤花果","author":"吴芾","text":"镂果团缯宛似真，尊前一见喜生春。\n感公持此为余寿，益悟浮生是幻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其三","author":"吴芾","text":"雨脚才收拟杖藜，檐前依旧又垂垂。\n倘余有分花间醉，会有风和日暖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其四","author":"吴芾","text":"纵令日日醉春风，已恨花无十日红。\n何事东君长作恶，不容春色丽晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其五","author":"吴芾","text":"千花到底不如梅，胜赏犹宜踏雪来。\n今日满天长是雨，如何花下得徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其一","author":"吴芾","text":"正欲持杯赏万红，却遭连日雨兼风。\n种花欲看难如此，可是衰翁赋分穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其六","author":"吴芾","text":"春来日日欲寻春，乐此疏慵老大身。\n岂料青春今过半，萧萧风雨却愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其八","author":"吴芾","text":"一雨绵绵不暂停，天公于此底无情。\n不应直待花飘尽，始放阳和作好晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感花 其二","author":"吴芾","text":"年来老病苦相侵，已是伤春不自禁。\n那更雨声长在耳，连朝滴碎惜花心。","collection":"宋",