:"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十六","author":"吴芾","text":"两山夹苍烟，双瀑挂峭壁。\n汹涌非一朝，倾泻几千尺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十五","author":"吴芾","text":"兹岭别二年，今朝又重过。\n过了还复来，哀哉蚁旋磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十四","author":"吴芾","text":"苍崖崛地耸，飞瀑从天下。\n一岭跨两州，千年无九夏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十三","author":"吴芾","text":"睡里闻风雨，吾行拟暂停。\n起来搔首坐，喜见一天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十二","author":"吴芾","text":"游鱼跳水面，幽鸟啭山腰。\n各随飞潜性，人犹恋市朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十一","author":"吴芾","text":"雨馀江色净，风过稻花香。\n客里逢清旷，何妨且纳凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其十","author":"吴芾","text":"崇阁瞰方池，池边绿树围。\n披襟临水坐，宁复畏炎威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其九","author":"吴芾","text":"村径迷南北，晨兴乃错行。\n悟来还已远，却悔早贪程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其八","author":"吴芾","text":"自江至吾庐，七日喜及半。\n却恐席未温，又过江南岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其七","author":"吴芾","text":"中夜不能眠，颇疑天有雨。\n寒燠自古然，不应冷如许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其六","author":"吴芾","text":"剧暑当三伏，新凉似九秋。\n日光还欲吐，云影未全收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒙恩易镇豫章丐假还乡途中偶成十七首 其五","author":"吴芾","text":"沙虚防败岸，舟小怯惊湍。\n行路难如此，争如野处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer"