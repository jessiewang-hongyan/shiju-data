[{"title":"眉溪与光祖共谈得四绝句 其一","author":"陈渊","text":"乾坤今古自昭然，此意何劳密处论。\n不是逢人喜倾倒，正应公事合公言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"眉溪与光祖共谈得四绝句 其二","author":"陈渊","text":"青山雨后足奇态，好鸟檐间无俗音。\n纵使曲生难会面，可无毛颖解传心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"眉溪与光祖共谈得四绝句 其三","author":"陈渊","text":"流泉为演秘密藏，枕上声从涧底来。\n半夜梦回听说偈，似传衣钵向黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"眉溪与光祖共谈得四绝句 其四","author":"陈渊","text":"溪边索共桃花笑，雨打风吹扫地空。\n待访灵云旧消息，急流无处觅残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"交溪庵中因检药囊偶成","author":"陈渊","text":"道人头上经春雪，不羡少年何首乌。\n已觉老来甘草莽，便当归去访田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陆时可岁暮感怀 其一","author":"陈渊","text":"小桥横截一溪云，隔岸遥通避世人。\n钓艇偶随秋雁泊，吟窗今见腊梅新。\n烟尘已觉千山静，雨露行看万国春。\n诗酒暮年生处乐，一瓢归去岂辞贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陆时可岁暮感怀 其二","author":"陈渊","text":"风御泠然几过旬，异乡穷腊作离人。\n淹留赖有交情重，翻覆从教俗态新。\n于世无求心似水，向人多可气如春。\n也知已造颜原室，不耻人间贱与贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和时可二首 其一","author":"陈渊","text":"芝眉不见忽经旬，屡出新篇故恼人。\n应共翰林争敏捷，岂如开府但清新。\n鸡豚且入他乡社，桃李何殊故国春。\n白发苍髯共携手，从来管鲍两忘贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和时可二首 其二","author":"陈渊","text":"甲子公今不记句，磻溪垂钓岂其人。\n安心有道年年健，出语无尘字字新。\n斗智莫争三十里，贪生何用八千春。\n直须准备新年醉，无地容锥未是贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又用元韵呈时可","author":"陈渊","text":"古来兵出仅三旬，便欲修文格远人。\n图蔓可堪师已老，涤瑕当与俗更新。\n舞干止杀知何日，卖剑归耕要及春。\n但得锄耰遍原野，饭藜何惜一身贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖闲居感怀","author":"陈渊","text":"风义久已丧，交道何其衰。\n艰窘无与俱，乃歌风及颓。\n谁言经由地，过门有犁来。\n霜雪岂不恶，松筠真奈摧。\n富贵如浮云，于我何有哉。\n所嗟道不兴，兹士犹尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初到临安二首 其一","author":"陈渊","text":"风际管弦朝病酒，云中楼阁夜闻香。\n十年一梦沙河路，独步春泥觉燕忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初到临安二首 其二","author":"陈渊","text":"青鞋踏雨花铺径，朱舰凌风柳拂堤。\n天竺旧游心已懒，孤山行处路应迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱塘江","author":"陈渊","text":"潮头驾月冲残梦，水色浮空送峭寒。\n十幅轻蒲连夜发，不知身到海门山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王长源饮垂丝海棠花下","author":"陈渊","text":"寇盗纵横已十春，今年花下得微曛。\n应怜万木灰薪槱，喜见奇葩脱斧斤。\n遣将几人非鞅鞅，覆盟今日尚棼棼。\n凭君为国施长策，莫恋垂丝鄙献芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓季明挽词三首 其一","author":"陈渊","text":"少年长揖出贤关，自许行藏契孔颜。\n云路不求千载遇，筚门赢得一生闲。\n奇言尽扫鸡三足，妙意谁窥豹一斑。\n尽道东床如李汉，会传馀论落人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓季明挽词三首 其二","author":"陈渊","text":"它时肤使早还乡，驻节旁连避世墙。\n雁序风标莲破萼，凤雏衣袂桂飘香。\n花边对酒春难老，竹里围棋日自长。\n曾共国人歌友爱，伤心重到棣华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓季明挽词三首 其三","author":"陈渊","text":"道人于世已忘名，相府闻风眼自青。\n险韵旧联韩子句，直词今称蔡邕铭。\n壁间玉唾情何厚，梁上银钩墨尚馨。\n只尔便知君不朽，岂缘中说载元龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"省题笔谏诗","author":"陈渊","text":"志士忧君切，还将笔效忠。\n但于心取正，不向字求工。\n理自胸襟得，情因翰墨通。\n一言毛颖喻，千古史鱼风。\n托意挥毫上，成名补衮中。\n谁知执艺事，功与诤臣同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和参谋至日喜雪三首 其一","author":"陈渊","text":"风鸣竹屋惧将颠，起视同云隘万川。\n共喜葭灰初应律，那知柳絮已漫天。\n传杯莫怕山颓玉，闭户从教径糁毡。\n幕府老成堪倚杖，故应衰病得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和参谋至日喜雪三首 其二","author":"陈渊","text":"玉花初著乱山颠，入夜俄惊月满川。\n虽有冷光凝白昼，尚馀阴曀锁青天。\n属车未返瑶池骏，远使犹餐北海毡。\n梦断忽传淮蔡捷，喜临尊酒已忘眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和参谋至日喜雪三首 其三","author":"陈渊","text":"恊气方占大有年，珠玑填道璧沉川。\n尘埃已洗三千界，云雾终开尺五天。\n羔袖久惭依帅幕，牛衣端不羡蛮毡。\n求田好趁丰登候，乞与元龙榻上眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和参谋参议寻春","author":"陈渊","text":"二老俱传正始音，春来诗思转精神。\n风前未展垂天翼，笔下空闻掷地金。\n晓日若将开霁色，宿云先已弄轻阴。\n落花流水年年事，只恐桃源不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵吴参议病中怀归因以自见","author":"陈渊","text":"柳丝垂地整如梳，春尽长怀旧隐居。\n草暖屡眠斜照外，水香时漱落花馀。\n西山忍饿初疑隘，北海无功竟坐疏。\n同是念归公得请，自怜濡滞一轩渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵安茂通同薛参议上巳日唱和","author":"陈渊","text":"扁舟冲浪去，羸马傍城行。\n飘泊伤春绪，艰难作吏情。\n岂无贤者乐，亦有圣人清。\n莫继兰亭会，愁连曲水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月二十日游东山参议不至有诗次韵","author":"陈渊","text":"羁怀厌朝市，逸兴薄江山。\n放杖嚣埃外，传觞紫翠间。\n碧云犹未合，飞鸟已知还。\n不见高车过，重城欲上关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"参谋得暂假归留别同舍次韵","author":"陈渊","text":"青蒿何敢附苍官，要以陈根托岁寒。\n万事忘情知我拙，一窗容膝许同欢。\n也知坚卧元非病，况是无心可得安。\n归去傥馀饥溺念，岂能无意复缨冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵茂通喜雨","author":"陈渊","text":"师行初不犯秋毫，坐缚凶渠泚与滔。\n和气自应回岁旱，丰年当复验秋高。\n横流是处通飞鹢，归佩何时脱孟劳。\n要广江南千里润，须令天下入甄陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张巨山著作使闽分韵得我字","author":"陈渊","text":"道山仙者居，是中乃置我。\n白前英俊前，糠秕出扬簸。\n同寮事阔略，未忍弃衰惰。\n日闻所不闻，更欲学其可。\n张侯廊庙器，文字粲藻火。\n一班见馀论，已足践青琐。\n欣然取使节，去我何其果。\n无乃万斛舟，未授济川柁。\n相携湖上别，酒尽重城锁。\n分离情已重，去住计谁左。\n从来洞庭野，乘雁不加夥。\n何日西江潮，送我东归舸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石夫人挽词","author":"陈渊","text":"好客陶家旧，多才谢女风。\n一窥知帝辅，三徙得儒宫。\n遗子经犹在，知人鉴已空。\n里闾推达识，爱婿有乘骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄平国倅邵武","author":"陈渊","text":"雪到蓬山尚破裘，倦听馀子说封侯。\n松楸更作连宵梦，桂玉宁堪卒岁留。\n衣绣故应人所羡，题舆仍为国分忧。\n艰难兀坐添华发，亦欲如公可得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答吴济仲见寄","author":"陈渊","text":"季子观周乐，妙意传青简。\n诸孙拾其遗，破具前人眼。\n新诗如珠璧，字字无可拣。\n故应意有馀，不但音睍睆。\n念昔我方壮，意轻三子撰。\n自闻歌白雪，欲和色先赧。\n中间各流落，念子忘寝馔。\n阻寻千里盟，未卜一笑莞。\n书来得佳句，奇字富瑟僩。\n推先情已厚，感旧涕应潸。\n周宣致中兴，土宇日益昄。\n肤使尽苏张，九合宁须轏。\n天才必有用，造物岂徒产。\n椽笔傥容挥，斗印定当绾。\n既去却须来，毋绝汉中栈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邓天启贺茅舍新成二首 其一","author":"陈渊","text":"长者一床室，先生五柳庐。\n久贫应似我，多病或如渠。\n客少门常寂，身闲日自舒。\n窥园知鲜暇，安得掺君裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵邓天启贺茅舍新成二首 其二","author":"陈渊","text":"艰难思健士，谁复数寒儒。\n老去怀三径，归来就一区。\n春情萦梦草，晚步及栖乌。\n不愧王摩诘，新诗有画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵延年弟相庆 其一","author":"陈渊","text":"逐客身无事，乘闲葺敝庐。\n堂成因有室，水到自成渠。\n地迥千岩秀，春回一气舒。\n幸为时所弃，容我懒簪裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵延年弟相庆 其二","author":"陈渊","text":"经年侍清宴，饱食愧侏儒。\n脱迹鸳鸿路，忘怀草木区。\n朝檐看斗雀，晚槛引饥乌。\n已觉蓬蒿适，谁能九万图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宗仁弟相庆 其一","author":"陈渊","text":"吾闽山水国，幽绝胜衡庐。\n隐几云生席，开轩柳映渠。\n连枝均鲁卫，异说屏荆舒。\n此外无它慕，何门可曳裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宗仁弟相庆 其二","author":"陈渊","text":"侵疆犹未复，世不乏真儒。\n肯使金汤地，长为豺虎区。\n颓龄真病鹤，急警任飞乌。\n纵有藏身处，偷安岂远图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵沈公雅相庆 其一","author":"陈渊","text":"沈子膏粱胄，从余一草庐。\n几年同寂寞，此日更勤渠。\n师范宗韩孟，源流接谊舒。\n艰难思报国，犹未厕朝裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵沈公雅相庆 其二","author":"陈渊","text":"尚书足勋业，振迹自穷儒。\n清德逾三世，忠名满八区。\n诗才推道蕴，玄旨赖童乌。\n岂厌隆中卧，惭无八阵图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代朝宗弟和饯行二首 其一","author":"陈渊","text":"席门谁复顾寒儒，深愧频迂长者车。\n更为穆生时设醴，应怜冯子食无鱼。\n诸生久被弦歌化，盛礼谁将简册书。\n从此邑人蒙劝奖，定知容驷有高闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代朝宗弟和饯行二首 其二","author":"陈渊","text":"少年经业富三馀，肯羡相如驷马车。\n要向青云开羽翼，岂辞黄卷注虫鱼。\n平生颇负连鳌手，老大犹随荐鹗书。\n此去果符丛桂兆，敢求椽笔揭吾闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴国灿老往漳州二偈送之 其一","author":"陈渊","text":"江梅又趁一阳回，身在旃檀林下来。\n行到漳南香未歇，百花闻此一时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兴国灿老往漳州二偈送之 其二","author":"陈渊","text":"浮云出岫本无心，桔槔俯仰人所引。\n一大藏教留后人，看与不看渠自省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓端友临要阁五首 其一","author":"陈渊","text":"昔年曾到十三楼，一日西湖十顷秋。\n寒碧轩中最宜暑，只缘脩竹近清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓端友临要阁五首 其二","author":"陈渊","text":"十里烟波竹外溪，隔溪青嶂绕窗扉。\n诗人不见东坡老，直节空馀一尺围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓端友临要阁五首 其三","author":"陈渊","text":"谁家多竹门可款，临要阁前沙岸傍。\n谩道薰风能解愠，正应苍玉自生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓端友临要阁五首 其四","author":"陈渊","text":"繁枝盖地欲成幄，杰干凌空不碍檐。\n为语韩公莫除好，此间风月岂须添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邓端友临要阁五首 其五","author":"陈渊","text":"甘苦元从舌上知，竹间风味与谁期。\n万竿可斩从人说，一榻乘凉要自嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友和临要阁诗再次韵五首 其一","author":"陈渊","text":"茅斋西望水边楼，亦复开轩对奕秋。\n欲效子猷偏种竹，竹前那得一溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友和临要阁诗再次韵五首 其二","author":"陈渊","text":"乘兴谁当访剡溪，竹间应复掩双扉。\n也知剧暑攻人急，正赖青双一解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友和临要阁诗再次韵五首 其三","author":"陈渊","text":"午窗青梦接羲皇，茗盌无多置我傍。\n此味若令儿辈觉，人间容有竹风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友和临要阁诗再次韵五首 其四","author":"陈渊","text":"宿霭初收一卷帘，万山腾沓拥飞檐。\n静看野色连苍竹，便觉闲中气味添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友和临要阁诗再次韵五首 其五","author":"陈渊","text":"不将朝服换斑衣，正以亲年慰所期。\n却恐英名喧众口，未容莱子作儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送朝宗弟赴试南宫","author":"陈渊","text":"霜馀宾雁日南征，念子冲寒去我闽。\n应向月娥占昨梦，欲扳仙桂赴新春。\n平生学海真无底，晚节词锋更有神。\n要路争先吾老矣，可无高论蹑平津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆邓德达得子","author":"陈渊","text":"海中仙果真难得，天上麒麟必异才。\n速客未为汤饼供，荐觞须俟鲤鱼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书心画诗","author":"陈渊","text":"书法从中得，难将笔下寻。\n欲知神合处，始悟画由心。\n篆隶秦非古，真行晋迄今。\n奇踪存翰墨，妙意本胸襟。\n雄健猊翻石，骞腾鸟出林。\n古人求笔正，八法响随音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题兴国寺碧落轩 其一","author":"陈渊","text":"北山其下僧伽塔，影落轩前草树间。\n谁向月明看白牯，静中相对两俱闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题兴国寺碧落轩 其二","author":"陈渊","text":"休论暮四同朝四，且说前三与后三。\n造物戏人无足较，老禅深处要重参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其一","author":"陈渊","text":"白衣挈榼踵吾门，颇说双泉更有兄。\n洗盏为君开醉色，不知人世有王闳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其二","author":"陈渊","text":"秋水无声泻玉觥，镜奁初启净无尘。\n未将滋味誇殊胜，已觉风神最恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其三","author":"陈渊","text":"浊者为贤圣是清，古人无复论甘辛。\n因观表里如冰玉，始信荀杨未尽醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其四","author":"陈渊","text":"鼠窃跳梁十里间，数杯中夜得安眠。\n千艘雷动人方扰，一榻山颓我自仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其五","author":"陈渊","text":"饷我两樽才斗许，客来索饮不论升。\n明朝此物岂易得，纵有市酤宁独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端友以桂浆两樽见惠赋诗六首 其六","author":"陈渊","text":"投辖谁云有祖风，啜醨难与贵人同。\n竹林若许供鸡黍，助我醇醪幸少丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代陈应之作","author":"陈渊","text":"淑德初无玷，高情更出尘。\n择邻思教子，剪发为延宾。\n裁鉴推前识，提携即伟人。\n东床他日选，乌府号忠臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒璨老病未能起留二偈示之 其一","author":"陈渊","text":"赵州不出三门，净名坚卧一榻。\n我来堂下便回，此间有问有答。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒璨老病未能起留二偈示之 其二","author":"陈渊","text":"西堂偶尔头痛，首座从来脚跛。\n堂头更自默默，客来一场懡㦬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]