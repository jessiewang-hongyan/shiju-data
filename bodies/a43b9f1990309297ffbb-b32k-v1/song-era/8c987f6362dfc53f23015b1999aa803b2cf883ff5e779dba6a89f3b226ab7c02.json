[{"title":"送陈动之","author":"宋祁","text":"绨帙抛蓬观，军牙佐柳屯。\n伏熊均轼宠，睡貉袭裘温。\n睢苑寒云隔，渔挝暝鼓喧。\n帛书无厌数，知有雁为门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送河中司马待制","author":"宋祁","text":"从祀天坛歇翠薰，西门征軷怆离群。\n暂违册府三重阁，先过楼船一曲汾。\n賨炙击鱼开左席，戏壶争马宴中军。\n鹳楼西北怀都思，尽日凭高不碍云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郑天休","author":"宋祁","text":"春筠蒸遍擿锋摧，剡奏飘然别上台。\n授简客惊枚乘去，探书人继史公来。\n爆桐度曲离筵惨，樵的分风使棹催。\n千万禊滨传善序，永和三月有流杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送驾部俞员外良孺知江州","author":"宋祁","text":"朝弁辞清晓，斋艎汎暮秋。\n官华飞雉省，地剧左鱼州。\n湓水遥浮郭，天章近占楼。\n知君乘月夕，不浅是风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鱼太傅通判汉州","author":"宋祁","text":"绵野喜相依，长亭亟解携。\n寒销云栈北，春遍锦城西。\n邛酱传芳蒟，岩祠颂缥鸡。\n时平通守贵，千骑斗鄣泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送保定张员外","author":"宋祁","text":"倾座仙风冠颍奇，枳鸾移调位犹卑。\n兰薰夕膳三林案，草妒春袍一綵丝。\n烟戍星残低序雁，陇天云断送歌骊。\n报成结课行堪待，慰荐连章达帝帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送南顿胡簿","author":"宋祁","text":"密雪妍辞盛，垂窗怒翼开。\n聊从百里佐，初露七年材。\n集隼趋侯府，歌骊酬客罍。\n时年无道茀，庇邑迩天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客","author":"宋祁","text":"西出都门路，横参送客鞍。\n低云能作暝，轻吹不成寒。\n天势高无极，原姿秀可餐。\n长年伤别甚，作恶叵能欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客不及","author":"宋祁","text":"祖帟难留十里筵，亭皋衰柳但长烟。\n班骓不及来时路，黄鹄空惊去后弦。\n曾是松心同岁晚，怒无梅信发春前。\n南楼漫作凭高计，望尽天涯更有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客野外始见春物萌动","author":"宋祁","text":"苑路高高雪作泥，始知春信到芳蹊。\n绿波水暖鱼腮骤，缥色陂长麦首齐。\n万里碧云随望合，半规红日有情低。\n榆牙柳目相看数，枉是回肠付解携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送段秘丞同理金陵","author":"宋祁","text":"赭丹濡笔狱无冤，佐守初依凤沼莲。\n南土出藩申伯宠，辟书为首嗣宗贤。\n蟠龙运厌山围国，燬角宵凉水际天。\n哲辅定知三入相，期君同赴渭滨畋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送炳宗巢簿","author":"宋祁","text":"世德封胡后，英游终贾年。\n尘缁去郡客，木落渡淮天。\n揖吏贪持簿，劳歌倦倚弦。\n无忧亲釜薄，新复古圭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送祝熙载","author":"宋祁","text":"昔誓繻仍在，今行绶已新。\n春莺得迁友，夜鹤怨归人。\n倦枕低潮月，征帆截渚蘋。\n清时偏乐职，寒鳖佐吴醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡宿同年主合肥簿","author":"宋祁","text":"归路青袍杂綵裳，何言县枳滞鸾翔。\n恨无旨酒邀枚叟，愁听斑骓送陆郎。\n四剖楚萍资夕膳，一弦淮月望春艎。\n铃斋坐镇儒林丈，密启行闻达上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送贵溪尉周懿文先辈","author":"宋祁","text":"几日铨符给诏程，赐袍如草滞僚英。\n大言久废三千奏，倦曲难终一再行。\n吴蟹沈波秋稻富，海鱼藏穴夜潮平。\n待君削牍登文石，趣与渊云继颂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐秀才","author":"宋祁","text":"风鹢摧高羽，云鹍惨别弦。\n倦随东郭履，归养豫樟年。\n客信凭梅陇，乡歈伴月舷。\n君谋适不用，虚赠绕朝鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梅尧臣","author":"宋祁","text":"祖帟都门路，秋风满客衣。\n台舟三鹢驶，官舄两凫飞。\n乡思临波远，离忧傍酒微。\n不应缘事事，手自废谈围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭太保知相州","author":"宋祁","text":"螭阶看引羽林兵，罢直还家得使旌。\n黼帐三云清晓别，锦鄣千骑上头迎。\n鸳沈故瓦秋烟阔，凤下长阿夕照平。\n谁伴燕休同把酒，嘈嘈歌鼓亚夫营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宿州李明允都官","author":"宋祁","text":"省帐香残捲夕红，名郎去守日围东。\n组垂丈二腰章贵，骑拥千馀使幕雄。\n弭节亭皋乡梓近，贯都河溜客鱼通。\n期年美化流欢颂，尽入中和乐职中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送常州陈商学士","author":"宋祁","text":"红梨秋老石渠霜，并欲萧萧伴祖觞。\n台上襆绫收柘枕，水边古兽得鞶囊。\n浮云并盖辞京辇，晓月将潮促使艎。\n缘饰有文成政速，剩储灵气茹芝房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送惟正归钱塘","author":"宋祁","text":"客艑高樯冒楚霏，月岩丛桂老春枝。\n一杯来应伊蒲供，八法归刊斗薮碑。\n鳅岸风生凉汐满，蜃天霞破暝楼危。\n学该内外皆圆法，却要声闻是总持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送戚秘丞典上饶钱监","author":"宋祁","text":"左典吴山冶，行行榜客舟。\n终无善宦巧，肯为著书愁。\n别思都成恶，芳辰信易遒。\n江南饶杜若，何兴奈高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梁著作宰兴平","author":"宋祁","text":"班马萧萧祖帐阑，晓参横影送征鞍。\n春归花树排初荠，天废关泥落旧丸。\n乳雉群飞郊柘密，秘鱼双合省芸乾。\n霸陵草色无深浅，试为南登一望看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梅学密赴并州","author":"宋祁","text":"连天橐笔侍天台，始见东方画隼开。\n路避晚风崤外转，人瞻冬日绛中来。\n笳箫后队联幽侠，璧马中军聘楚材。\n自昔河东股肱地，不应归节叹淹徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梅挚廷评宰上元","author":"宋祁","text":"子虚诵入汉皇帷，给笔当年掞藻奇。\n赐罢春袍兼彩服，对馀昆玉照林枝。\n即时酒所歌骊阕，几日江南瑞雉随。\n建业清溪无尽曲，为赓妍唱绕遗词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才长吉还天台","author":"宋祁","text":"归祴卷兰芽，城标拂曙霞。\n溪行鸥避锡，岩供马衔花。\n翠柰经园密，苍莓渡彴斜。\n暮云他日合，相望在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送萧山宰刘寺丞","author":"宋祁","text":"秋江九月鹭涛平，楚客征樯拂县星。\n射的初过若耶渚，禊林重访永和亭。\n畏蛟俗富风移古，飞乙天长日际冥。\n几帙异书藏卧帐，肯容伧客广蒸青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄寺丞谪濠梁","author":"宋祁","text":"间关羁籍远，跌宕壮心违。\n倦逐淮禽去，欣同塞马归。\n时来富且贵，事往是耶非。\n姑共春清酌，徐徐遣世机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄昱秘校太平理掾兼简法掾李伯元","author":"宋祁","text":"中铨覆拟下慈宸，又作东西补掾人。\n去国虽逢零霰暮，过江未失杂花春。\n西山气爽聊持版，白纻袍馀且制巾。\n星贯文稀堪乐事，联曹鲍照藻辞新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄秘校书","author":"宋祁","text":"妙龄看试牍，共叹俊登喧。\n十载重来调，犹参军事烦。\n吴艎沿迅溜，京炙伴芳樽。\n东观他年选，当求江夏孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄灏","author":"宋祁","text":"横步文林二十春，华颠初得半通纶。\n江边又濯沧浪水，堂上宁招肮脏人。\n未分尘缨惭蕙帐，不缘羊酪弃羹莼。\n思家夕梦还都信，并附秋波六六鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蒋御史漕江南","author":"宋祁","text":"柱后峨冠久未还，江南行府使旗鲜。\n陈陈洪庾催输粟，往往吴山即铸钱。\n暝月早霞千里国，废楼残社六朝天。\n时清宪笔无弹劾，供助骚人藻思妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢处士南归","author":"宋祁","text":"岁晏心无著，时清遁更肥。\n江莼萦箸滑，海鸟傍帆飞。\n乡思生闽雾，吟怀入楚霏。\n趋庭多令子，綵服间荷衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送越州陆学士","author":"宋祁","text":"梅天霞破候旗乾，乡树依然越绝间。\n挟策当年逢掖去，怀章此地绣衣还。\n亭馀内史浮觞水，路入仙人取箭山。\n牛酒盛夸先墅宴，不妨春诏得亲班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩太祝","author":"宋祁","text":"云阵星躔促传车，长安初日望储胥。\n金闺引籍中天阙，玉字藏家上帝书。\n祖道泛萍觞易釂，赋园飞雪席应虚。\n承明再过怀先业，磐石深沈禁树疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送韩廷评婺州市征","author":"宋祁","text":"去程烟草妒蓝袍，越绝天文宝婺高。\n五两樵风船画鹢，九秋犀烛鹭翻涛。\n吴盐煮海通关赋，陆橐收金析利毫。\n仙酎油囊鲈鲙洁，未妨馀暇左持螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送殿院张奎漕京东","author":"宋祁","text":"霜柏轻寒惊曙乌，使台东道亚风旟。\n人瞻御史乘骢贵，钱续司农朽贯馀。\n睢苑千门聊按节，齐官三服罢移书。\n此行须信褒恩美，新诏黄金饰佩馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送睦州柳从事","author":"宋祁","text":"唱第千人俊，从军十部贤。\n鸡翘迂赐绶，鹢首赴归船。\n别思瑶华岸，怀乡玉脍天。\n不妨宾弁侧，新曲遍鹍弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送福州通判陈铸","author":"宋祁","text":"州阁纡新绶，乡枌历故廛。\n先驱长卿贵，随子大家贤。\n桂蠹闽君贡，刀耕越俗田。\n春邮有归信，正待早梅传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送简殿丞赴阙","author":"宋祁","text":"共治清淮北面州，何言分袂帐夷犹。\n君还南阙双龙下，我驻东方千骑头。\n未落林花延别醑，无穷堤草伴行舟。\n怀人愬月劳劳意，自此相牵更倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蒙城簿谢煜先辈","author":"宋祁","text":"曾第飘飘赋，仍劳冉冉趋。\n叹时三嗅雉，倦别一飞凫。\n句簿虚公几，迎浆溢里壶。\n异时赍阀阅，明陟在丹涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧游越","author":"宋祁","text":"越绝天长晓雾低，若耶云树蔽春晖。\n江龙浪稳迎杯度，岩虎蹊空避锡归。\n晨饭聚香斋品洁，夜盆沈漏睡魔稀。\n玉珰谁望西来气，五叶花开祖有衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送静海勾稽高洎","author":"宋祁","text":"豪锥残试墨，纶绶照恩裳。\n沿牒天官调，承家父任郎。\n曲长溪舫远，宴密酒螯香。\n得助江山国，仍缝古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送静照大师归馀杭","author":"宋祁","text":"旁行经叶振馀埃，社侣欣闻锡股回。\n林鸟入花迎拥裓，江龙停浪送浮杯。\n他年应共销香饭，几夕飞谈辩劫灰。\n渐次南征知有为，化成今在故岩隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送潘秘校赴颍上簿","author":"宋祁","text":"捧檄去三铨，招招客叩船。\n倦游惊密雪，离思著幺弦。\n淮月开帆暝，京尘减绶鲜。\n枳鸾非久息，刷羽伫来旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送冀州李团练","author":"宋祁","text":"雪云寒气著离杯，道北轻风大旆开。\n太守直居千骑上，将军仍自九天来。\n征鼙曲曲渔阳掺，后乘人人邺下材。\n忠孝相移难两遂，沁园归恋遍兰陔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送澶渊李太傅","author":"宋祁","text":"左契铜鱼照绶囊，上头车骑冠东方。\n三交荐技中军戏，一割牛心右客尝。\n烽静塞垣宵燐灭，桥横河曲暮虹长。\n归来竞病喧笳鼓，不畏休文赋韵彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送薛学士伯垂同理嘉兴郡兼简太守集仙柳著作","author":"宋祁","text":"广内多年铁㰅摧，监州新命诏函开。\n河东世擅鹓雏誉，江左人瞻竹箭才。\n即席离弦凄鹄韵，几程残魄晦珠胎。\n兴禾善俗蓬仙友，剩舞吴歈耻宴罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重葺敝庐有作","author":"宋祁","text":"屦市喧卑极，家林改筑初。\n藩倾犹置笔，楹破尚逢书。\n径草临江府，园畦洛涘居。\n凭谁遣真意，仁义亦蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻中山公淝上家园新成秘奉阁辄抒拙诗寄献","author":"宋祁","text":"为乐东平得再麾，别营层阁驻经帏。\n溢囊秘简青皆汗，署榜宸毫白正飞。\n樽喜客来衔酒数，画疑仙去启厨稀。\n门前即枕春溪路，几曲歌成使舫归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻王侍郎请老","author":"宋祁","text":"未老辞荣上所褒，官閒犹寄白云曹。\n海边人乐鸥先下，笼外天多鹤始高。\n此路逍遥真有趣，他年侍从信为劳。\n清商弟子歌声妙，谁判挥金引冻醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻归雁","author":"宋祁","text":"故岁东南客，新来西北飞。\n声迷江月老，阵入塞云稀。\n远恨抛书素，馀音付玉徽。\n行人落君后，搔首未成归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻后苑赐宴","author":"宋祁","text":"汉家殿幄紫云连，万品仙葩匝赐筵。\n露蕊半晞仙掌外，斗杓长在帝车前。\n液池綷鸟栖连籞，钩盾祥麰遍弄田。\n病客无阶陪槁饫，除因断梦到钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻杜宇","author":"宋祁","text":"传闻望帝冤，底处最堪怜。\n蜀月将残夜，巴山欲晓天。\n周军尝化鹤，齐后亦为蝉。\n物变皆如此，非君是偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蝉","author":"宋祁","text":"秋风日夕惊，庭树喝蝉声。\n衰意先鶗鴂，繁音伴沸羹。\n斜阳挂高柳，落日淡遥城。\n此际君怀苦，非徒客子情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蝉有感三首 其三","author":"宋祁","text":"劳君惊暮节，助我思流年。\n嘒若横吹管，繁如未破弦。\n城残嘶外月，林暝噪馀烟。\n块坐秋风里，潘郎鬓飒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蝉有感三首 其二","author":"宋祁","text":"残蜕抛何处，新声集迥枝。\n岁芳鵙后妒，露信鹤前知。\n风坞嘶清御，霞梢咽暝规。\n此时兼一叶，并助长年悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻蝉有感三首 其一","author":"宋祁","text":"初闻蜀树蝉，含喝晚风前。\n便把凄凉意，催成摇落天。\n易惊惟远客，所得是流年。\n空腹悲何事，繁于五十弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻圜丘礼成肆眚","author":"宋祁","text":"斋幄连蜷驻玉虬，万灵遥护翠云裘。\n宝鸡并雊迎神曲，卓马争趋助祭侯。\n封屋都人差赐帛，贱星牢口阒无囚。\n露萧雷解疏恩美，万和欢声速置邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦客","author":"宋祁","text":"貂裘敝尽饮瓢空，身滞平台倦客中。\n濩落本依庄栎社，飘飖误闭陇鹦笼。\n心缘远别长依旆，发近穷年已付蓬。\n素愿禄储过六百，云罗天外有冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌屯田知和州","author":"宋祁","text":"坡殿程篇属思精，飘飘老气薄黔嬴。\n一台旧服郎官笔，千骑新提太守兵。\n候吏腾装催去舸，故人引脰怅离觥。\n云波莫苦秋江阔，自有桃歌用楫迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭公孙子正","author":"宋祁","text":"穷愁四十鬓华侵，肘卧垂杨感慨深。\n遗墨未乾园令札，悲弦长绝献之琴。\n嗟贤有梦龙占苦，对臆无言鵩坐阴。\n三步过车绵酹薄，死生从此隔朋簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭郭仲微三首 其三","author":"宋祁","text":"谢氏虽多女，中郎竟乏儿。\n人生忽至此，天道果无知。\n一代英才往，千篇故稿遗。\n生平同翰墨，不及镂丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭郭仲微三首 其二","author":"宋祁","text":"我作鱼符守，君司凤诏文。\n他时谈笑罢，今日死生分。\n怨涕翻荥浪，悲魂引郑云。\n山阳怀旧笛，肠断不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭郭仲微三首 其一","author":"宋祁","text":"仓卒闻婴疾，何辜遂没身。\n哭筵同产子，霜寝未亡人。\n冢有邢山旧，天为京兆邻。\n想君赍志恨，不使白杨春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐李卫公庙","author":"宋祁","text":"斯人天挺杰，贼胆畏膏肓。\n疾战江陵破，长驱颉利亡。\n成功在不伐，垂烈付无疆。\n血食雄京辅，于今异姓王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐诏监簿池阳市征","author":"宋祁","text":"五鼓歇津亭，风帆去斗城。\n美材王国秀，独木县官征。\n萍密浮罂剂，莼丝杂釜羹。\n袁郎秋咏去，江月对盈盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]