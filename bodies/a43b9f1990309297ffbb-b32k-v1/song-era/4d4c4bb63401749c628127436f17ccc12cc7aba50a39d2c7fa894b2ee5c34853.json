[{"title":"自和二首 其二","author":"刘克庄","text":"贵豪渠已重金带，贫病侬犹旧布衾。\n钟阜解仇无宿憾，荆江感事有新吟。\n早知馀耳交难保，晚觉王何罪未深。\n白首还乡应闭户，断无保社肯追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和徐潭二首 其二","author":"刘克庄","text":"远游昔结四方缘，高卧今贪一壑专。\n有客埋腰冲许雪，无人洗耳涴吾泉。\n金棺未免荼毗厄，玉匣安知裸葬贤。\n多积荆薪宽酿酒，龙钟禁不得霜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和徐潭二首 其一","author":"刘克庄","text":"从今快活安斯寝，那复辛勤陟彼冈。\n万里路曾双不借，四天下只一禅床。\n宽如马驿名方丈，劣似鸡栖即客房。\n自唱山歌樵牧和，底须论著学班扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和效颦一首","author":"刘克庄","text":"未爱京师传子真，园池冷落户庭贫。\n神仙疑是丹丘子，年纪高于绛县人。\n春去似催花送老，岁荒聊喜麦尝新。\n晚知嵇阮非酣畅，名与杯中物孰亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自勉","author":"刘克庄","text":"海滨荒浅幼无师，前哲藩篱尚未窥。\n玄咏易流西晋学，苦吟不脱晚唐诗。\n远僧庵就勤求记，亡友坟成累索碑。\n天若假余金石寿，所为讵肯止于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自题长短句后","author":"刘克庄","text":"春端帖子让渠侬，别有诗馀继变风。\n压尽晚唐人以下，托诸小石调之中。\n蜀公喜柳歌仁庙，洛叟讥秦媟上穹。\n可惜今无同好者，樽前忆杀老花翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自警","author":"刘克庄","text":"笔枯砚燥自伤悲，文体全关气盛衰。\n倚马纵难挥万字，骑驴尚足课千诗。\n奉盘谁可推盟主，撼树人方谤老师。\n疑有更深于此者，入山十载试精思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日","author":"刘克庄","text":"钧天残梦忽惊回，金钥遥知已掣开。\n不复五更三点入，刚云七日一阳来。\n即今空恋唐宫阙，畴昔曾登鲁观台。\n犹记小窗添线晷，强揩老眼乱书堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行期一首","author":"刘克庄","text":"□□同登市骏台，柳边花底早朝回。\n仕如枘凿难投合，身几麾招老去来。\n近师旷傍吾岂敢，居枚叟右众应猜。\n暮年怕与家山别，门外弓旌莫苦催。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西林寺","author":"刘克庄","text":"将谓如庐阜，因迂数里行。\n问俱无古迹，来等慕虚名。\n借榻眠难熟，逢碑眼暂明。\n残僧逃似鼠，难结社中盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西淙山观雨","author":"刘克庄","text":"与客同登万仞崖，蔽天风雨蓦然来。\n六丁白昼诛炎魃，百怪苍渊起蛰雷。\n毒蟒喷时林尽黑，怒龙裂处石中开。\n吾生不及观河决，得赋斯游亦壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观元祐党籍碑","author":"刘克庄","text":"岭外瘴魂多不返，冢中枯骨亦加刑。\n稍宽末后因奎宿，暂仆中间得彗星。\n蚤日大程知反覆，莫年小范要调停。\n书生几点残碑泪，一吊诸贤地下灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观射","author":"刘克庄","text":"浪箭束如林，傍观笑不禁。\n蛮平无事久，卒惰可忧深。\n各自分牛䏑，何曾贯虱心。\n种侯青涧法，能费几黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观溪西子弟降仙","author":"刘克庄","text":"似有物凭箕，傍观竞卜疑。\n曾从师授易，肯问鬼求诗。\n岩穴虽高枕，乾坤尚弈棋。\n老儒心下事，未必紫姑知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访李钢草堂不遇","author":"刘克庄","text":"细路萦纡入野田，遥瞻竹树已欣然。\n青苔地滑跌卢老，苍耳林深迷谪仙。\n不羡玉堂在天上，径须茅屋占云边。\n极知谢客非为亢，贪看林花听涧泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访辟支岩绝顶二僧值雨","author":"刘克庄","text":"闻有比丘隐绝巅，多年无迹下山前。\n僧称功行几如佛，樵说神通复近仙。\n食少仅炊盈握米，身寒不挂半铢绵。\n重岩风雨妨游陟，回眺苍烟一惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过刘尚书墓","author":"刘克庄","text":"士林方卜道穷通，一旦骑鲸万事空。\n帷下有人师董相，墓傍无客哭乔公。\n白头稍得谈经力，青简尤高绝币功。\n尚记长衣横麈柄，今看华表立西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过建阳","author":"刘克庄","text":"城郭依稀人物改，桥边感旧一销魂。\n小童子已成黧黑，久寓公惟见子孙。\n耄矣千丝羞览镜，去之三纪尚攀辕。\n当时手种花无数，问讯而今几树存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过建阳二首 其二","author":"刘克庄","text":"白布裙襦雪满颠，携扶伛偻拜车前。\n皆言庾氏相因粟，犹是君侯不饮泉。\n自昔活民须有备，即今去客愧无权。\n愚公老矣痴如故，长把心灯望后贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过建阳二首 其一","author":"刘克庄","text":"溪上重来两鬓丝，岂知拙政久犹思。\n旄倪欲见叶公面，香火共存朱邑祠。\n争劝令君持酒盏，不容老子闭车帷。\n谁言俗薄今非古，我与斯民各秉彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过章戴二首 其二","author":"刘克庄","text":"曾向明时雪李邕，又闻名在聘贤中。\n忆言鸱吻施茅屋，忍见龟趺立柏宫。\n杯酒昔常陪贺老，只鸡终待哭乔公。\n情知客泪先难制，邻笛那堪咽晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过章戴二首 其一","author":"刘克庄","text":"鲁叟新阡何处寻，桥边感旧独沉吟。\n一生欲唾奸谀面，千古难磨道义心。\n溪昔放鱼晴鱍鱍，门今罗爵冷涔涔。\n发潜赖有西山笔，何日碑成勒碧岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问友人病","author":"刘克庄","text":"病来清瘦欲通仙，深炷香篝扫地眠。\n野客劝寻廉药买，外人偷出近诗传。\n术庸难靠医求效，俗陋多依鬼乞怜。\n鸥鹭如欺行迹少，分明溪上占渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问讯大渊痔疾","author":"刘克庄","text":"秋来日日候双凫，霍地光阴迫岁除。\n古有客过雄寂寞，今无人问白何如。\n苏先自说饥餐面，蒙叟曾嗤舐得车。\n纵使村翁穷到骨，岂无薄醴与枯鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问讯竹溪二首 其二","author":"刘克庄","text":"几度书来说乞身，果然跳出软红尘。\n推黄粱枕了无梦，对紫薇花他有人。\n杜老诗犹怀主相，瞿昙法贵等冤亲。\n竹君樗叟俱强健，天遣相从寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问讯竹溪二首 其一","author":"刘克庄","text":"举子穷通占得失，词臣进退系污隆。\n拾青伊辈俱腾上，饮墨夫谁不热中。\n有太学生笑韩子，为西昆者谤欧公。\n他时陆氏庄相望，始验先生造士功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严关新洞","author":"刘克庄","text":"羽客初寻见，因于此葺庐。\n未能平险峻，先拟架空虚。\n磴路樵相引，山名尉自书。\n看来临驿道，未必有仙居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余平生不至庐山六月廿八日夜梦同孙季蕃游焉林木参天瀑声如雷山中物色良是一刹甚幽邃傍人告曰此中有不出院僧余与季蕃欣然访之语未终而觉将晓矣窗外檐溜淋浪纪以二诗 其二","author":"刘克庄","text":"泉声㶁㶁树苍苍，云有高僧占一房。\n粮绝罕曾起烟火，佛来不肯下禅床。\n缁流谁可传宗旨，黄敕难招坐道场。\n何必真分一间住，偶为但过亦清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余平生不至庐山六月廿八日夜梦同孙季蕃游焉林木参天瀑声如雷山中物色良是一刹甚幽邃傍人告曰此中有不出院僧余与季蕃欣然访之语未终而觉将晓矣窗外檐溜淋浪纪以二诗 其一","author":"刘克庄","text":"似与孙郎有宿期，共穿紫翠探幽奇。\n水帘喷雪非常爽，火伞张空了不知。\n蒙衲僧宁非惠远，结茅人莫是凝之。\n惜今粉绘无名笔，尚可追摹入拙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余自戊申春得疾止酒十年戊午秋开戒小饮二首 其二","author":"刘克庄","text":"自是病躯孱，元非饮量悭。\n灾星俄引去，美禄稍支还。\n兀兀醺酣后，蘧蘧解脱间。\n祖云谁缚汝，妙语颇相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余辛卯岁卧病郡城陈宗之胡希圣有诗问讯后五岁希圣寄新刊漫游集前诗已载集中次韵二首 其二","author":"刘克庄","text":"如闻攻老拙，颇似斫虚空。\n众口嘲投阁，新眉妒入宫。\n一身槁梧上，百岁大槐中。\n莫叹形骸废，姑留两颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余辛卯岁卧病郡城陈宗之胡希圣有诗问讯后五岁希圣寄新刊漫游集前诗已载集中次韵二首 其一","author":"刘克庄","text":"晚悟河难塞，收方入枕函。\n五穷衰并现，百病老皆谙。\n强起留奚益，全归死亦甘。\n癃残愧英妙，努力勿多谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余除铸钱使者居厚除尚书郎俄皆销印即事二首呈居厚 其二","author":"刘克庄","text":"病鸿垂翅噤无声，惯见虚弦莫浪惊。\n二仲卜邻元不恶，两生坚壁未尝行。\n出关谁识为周史，入社犹堪伴洛英。\n都把首阳山占断，采薇到老没人争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余哭蟾子潮士钟大鸣有诗相宽次韵 其一","author":"刘克庄","text":"愁眉暂展赖君诗，欲以先知觉后知。\n历引竺乾宽此老，未甘嬴博窆吾儿。\n寄阿兰若俄经昔，祔短松冈会有期。\n欲访巫咸何处在，忧来自向理中推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余哭蟾子潮士钟大鸣有诗相宽次韵 其二","author":"刘克庄","text":"彭聃俱未离乎死，况汝孩提未有知。\n自昔丈夫怜少子，即今王母惜孙儿。\n探环尚记曾游处，建鼓应无再见期。\n三纪七挥儿女泪，孰尸寿夭莽难推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余常用小端砚失之经年忽在常卖人手中以钱赎归纪实二首 其二","author":"刘克庄","text":"得来矻矻相亲附，飏去频频入梦思。\n盗璧相争笞掠汝，窃弓子笔亦诛之。\n偿金在我宁从厚，拜石为兄苦好奇。\n待唤良工镌砚背，偷儿携出有人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余常用小端砚失之经年忽在常卖人手中以钱赎归纪实二首 其一","author":"刘克庄","text":"几年共学久相于，中道如遗忽弃予。\n韫椟而藏机不密，窃钩虽小法当诛。\n匹夫有罪因怀璧，象罔无心偶得珠。\n戒饬家僮严护守，即今鼠子巧穿窬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冶城","author":"刘克庄","text":"断镞遗鎗不可求，西风古意满原头。\n孙刘数子如春梦，王谢千年有旧游。\n高塔不知何代作，暮笳似说昔人愁。\n神州只在阑干北，度度来时怕上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬","author":"刘克庄","text":"晴窗蚤觉爱朝曦，竹外秋声渐作威。\n命仆安排新暖阁，呼童熨贴旧寒衣。\n叶浮嫩绿酒初熟，橙切香黄蟹正肥。\n蓉菊满园皆可羡，赏心从此莫相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋感事三首 其三","author":"刘克庄","text":"恩放归田又数期，少犹迂阔况衰迟。\n日非夸父追能及，山岂愚公力可移。\n前席虚怀何日报，细旃密启有天知。\n太阳所烛皆萌达，不照墙阴藿与葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋感事三首 其二","author":"刘克庄","text":"跌荡当年赋两京，晚抛笔砚事春耕。\n达空函启已心懒，读夹注书犹眼明。\n金匮旧闻虚论次，香奁少作悔流行。\n而今老病都休也，起听秋声百感生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初秋感事三首 其一","author":"刘克庄","text":"遍阅同参入涅槃，傍观尽怪老僧顽。\n有诗传世天机浅，无史藏山笔钺闲。\n梦境瞿庄更唤醒，醉乡陶阮夹扶还。\n吾庐寂寂人稀至，不是先生爱掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初宿囊山和方云台韵一首","author":"刘克庄","text":"客游万里践霜冰，旦旦披衣坐待明。\n累黍功名成未易，跳丸岁月去堪惊。\n即今纸被携寻宿，当日油幢听报更。\n赖有云台公好事，追程来送老门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别后寄大渊二首 其二","author":"刘克庄","text":"苛留未忍听骊驹，薄具酸寒不可孤。\n邻巷沽来惟饮汁，田家客至具焚枯。\n吾衰异昔中年别，子去云谁半夜呼。\n敬问伯鱼诗礼外，过庭亦有异闻乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别后寄大渊二首 其一","author":"刘克庄","text":"面削瓜黄头雪白，雀罗庭院久深芜。\n劳烦上客迂童马，惭愧贫家阙饭刍。\n绝喜绪言闻辅嗣，了无斋衬供文殊。\n定知别后尤精进，寻得轩皇所失珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别宋斌文叔","author":"刘克庄","text":"天下书无数，君专治四书。\n因留精舍久，遂向举场疏。\n山路挑包去，秋风罢讲馀。\n故园荒草合，似欠一番锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别宋倅一首","author":"刘克庄","text":"往昔少司农，朱幡牧刺桐。\n见碑怀叔子，有庙祀文翁。\n家法惟清白，军储必腐红。\n遥知门户肃，不与贾胡通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别张季","author":"刘克庄","text":"昔谒西山过里中，谈兵论易气如虹。\n若非遇彼负苓者，必是传于坠履翁。\n至竟白袍无谄屈，何曾黄策有英雄。\n秋风定访蒙斋否，为说冯唐老更穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别张倅一首","author":"刘克庄","text":"同谒金闺觐茂陵，鼎湖弓剑隔西兴。\n绝怜晚景如庞老，空为州人惜许丞。\n自有名姬调绿绮，可无侍女直青绫。\n梦中雪鼓搀天碧，恨不陪君拄瘦藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别陈宗院","author":"刘克庄","text":"送客频张酒，迎宾久倚辕。\n何曾薄西邸，不忍□□□。\n宦拙从渠巧，甥荣觉舅尊。\n福唐遗父老，应看□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别敖器之","author":"刘克庄","text":"旧说闽人苦节稀，先生独抱岁寒姿。\n老年绛帐聊开讲，当日乌台要勘诗。\n东閤不游缘有气，草堂未架为无赀。\n轻烟小雪孤山路，折剩梅花寄一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别翁定宿瀑上","author":"刘克庄","text":"偶送诗人共宿山，拥炉吹烛听潺湲。\n已修茗事将安枕，因看梅花复启关。\n崖色无苔通涧底，月光如练抹林间。\n平生所历同邮寄，独到庵中不忍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别赋一首","author":"刘克庄","text":"平芜尽处即沧溟，身寄区中等一萍。\n种杞菊翁犹老健，插茱萸伴半凋零。\n去年敕设尘飞鞚，今日村酤草塞瓶。\n却笑痴人妄分别，何人未必胜刘伶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劳农二首 其二","author":"刘克庄","text":"画檐一夜雨飘萧，际晓阴霾扫碧霄。\n有日暂看旗脚展，无风初觉鼓声调。\n纷纷竭作趋南亩，稍稍新妆出北桥。\n白发长官尘土杀，尚能觅句补风谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劳农二首 其一","author":"刘克庄","text":"江浙膏腴动渺然，惟闽硗薄少平川。\n可怜老子扶凋邑，绝似吾民垦瘠田。\n稍喜一犁翻宿雨，聊为三爵礼高年。\n太平主相调元气，春在桑畦麦垄边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"刘克庄","text":"病索人扶乃寝兴，高楼咫尺少曾登。\n思悭惟有吟差长，睡少方知老可憎。\n榾柮成灰犹凛冽，茅柴似水亦瞢腾。\n暮年临履常兢战，未敢荒唐说葛藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"刘克庄","text":"峤南气候异中州，多病谁令作远游。\n瘴土不因梅亦湿，飓风能变夏为秋。\n方眠坏絮俄敷簟，已著轻絺又索裘。\n自叹幻身非铁石，天涯岂得久淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事一首","author":"刘克庄","text":"过了田光盛壮时，年今望八复奚为。\n薄浇磊磈嫌红酒，懒读聱牙喜白诗。\n释子书求名卵塔，社人卜请记丛祠。\n吾文谁道难施用，后有中郎赏断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事一首","author":"刘克庄","text":"书卷交疏觉昼长，田园收薄值年荒。\n老而用事独毛颖，何以解忧惟杜康。\n赐帛恩深优故老，催租人至败重阳。\n西风烂熳开蓉菊，不管先生两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事二首 其一","author":"刘克庄","text":"碧玉去随年少易，绛桃留待主君难。\n唤郎岂有云神女，觞客宁无黑牡丹。\n汉上谩为留佩恼，湘东曾被淡妆瞒。\n维摩老病禅房冷，一点青灯伴夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事二首 其二","author":"刘克庄","text":"非人不暖岂其然，卷起桃笙设艾毡。\n老物可憎吾顿觉，盛时一失汝堪怜。\n有分香妓空遗臭，无散花魔莫恼禅。\n多谢小窗半规月，夜深长伴绛纱边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事二首 其一","author":"刘克庄","text":"厨人失职晏忘炊，赖是先生贯忍饥。\n一客覆羹真小事，举家食粥已多时。\n自怜气馁鲜难脍，渐觉身轻鹤可骑。\n屈指故交无厚禄，未知太保李公谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事二首 其二","author":"刘克庄","text":"厨荒灶鬼未须嗔，君看先师尚在陈。\n老退休贪太仓腐，清虚聊咽上池津。\n今无能采金膏者，古有曾逢石髓人。\n自笑冰衡三百户，难分圭撮饷比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]