[{"title":"静观堂十偈 其九","author":"汪晫","text":"有时检点旧閒游，出岫行云野渡舟。\n蓦地静中消息好，夕阳西下水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠天竺僧","author":"汪晫","text":"衲被蒙头付自然，何须八棒十三禅。\n数声啼鸟青山外，惊起幽窗一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日拜大兄坟","author":"汪晫","text":"携家松底酹虾蟆，椒荔豚肩荐菊芽。\n吾父洲中无橘树，与兄庭下有荆花。\n和羹莫遂笺边让，破帽无能落孟嘉。\n衰老伤怀泪痕冷，年来须鬓白多些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"汪晫","text":"农夫只合老山林，辜负时卿一寸心。\n老矣不堪持手板，死时何用覆斜衾。\n有人称善名非细，对客无惭乐最深。\n回首暮云天黯淡，谁能更听伯牙琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用尊字韵寄胡约之","author":"汪晫","text":"芙蓉红晚对高轩，何日论文共一尊。\n祇作古诗十九首，不消柱史五千言。\n一声南雁霜华重，连夜西风木叶翻。\n自叹须眉今白尽，复愁友道更昏昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王季雄初春","author":"汪晫","text":"春事年年兴不穷，野塘冰泮雪初融。\n烧痕彷佛草萌绿，树影扶疏梅萼红。\n莫恨一生今老大，还知万事本虚空。\n饥餐渴饮存吾道，尺雪今年贺岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵吕仲见提干题翠眉亭","author":"汪晫","text":"亭前诗板有人临，公去知谁续好吟。\n忽有名人留七字，竞传高价值千金。\n曾扶诸老开皇极，终使微身坠众阴。\n两岫至今愁不展，此言应当老师心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱同人携妓见访留题","author":"汪晫","text":"行过晴溪乌桕弯，清漪犹自照苍颜。\n□□□□□□□，举酒欣然得绿鬟。\n鱼为知机潜别浦，兰因避俗住空山。\n老夫自觉无多事，且喜宾朋时往还。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李明甫追和苏黄门鸂鶒池","author":"汪晫","text":"无秽水常净，忘机鸟自驯。\n重来圆宿梦，因省是前身。\n尤物遗灵在，珍毛荐瑞频。\n何当还抱子，池上啄游鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李明府上事初谒登源庙用苏黄门韵见示","author":"汪晫","text":"缓引前诃度岭巅，真祠犹镇旧山川。\n悬知幽德如存日，更有孤忠合老天。\n双炷炉香祈一稔，两诗题咏播千年。\n民安善政神应喜，桑荫儿童犊背眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李明府追和苏黄门鸂鶒池","author":"汪晫","text":"池上先生诗句香，得公诗句更揄扬。\n精神相对陈圭瓒，意气潜交冶镆将。\n贤令旧容老文学，山农今见谪仙郎。\n百年剩喜风流续，未有名禽首屡昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵春愁","author":"汪晫","text":"风林弄影舞婆娑，水漫池塘绿皱波。\n天上谁人待金马，人间何路出铜驼。\n千年史册乱居半，百日春光晴不多。\n飞絮落花还病酒，门前佳客倦相过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡约之秋兴","author":"汪晫","text":"秋山排闼翠盈轩，似向高人伴酒尊。\n桑叶一庭深不扫，菊花满院静无言。\n谷中景物随时变，案上文书信手翻。\n恰得君诗吟未了，梧桐疏雨滴黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵胡益之初夏见怀","author":"汪晫","text":"自是胸中三斗尘，诗兵敢敌亚夫营。\n愁关老子两肩瘦，春点榴花一树明。\n雨向梅边来处细，句从夜半得时清。\n方床竹枕思君切，幸有吟筒话旧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵梅中","author":"汪晫","text":"梅熟雨初过，虚堂枕簟凉。\n心閒世自古，事简日偏长。\n藕叶度清气，兰花留晚芳。\n正巾堪一笑，发短自僧光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵盖簿初春郊行","author":"汪晫","text":"黯淡云初敛，霏微雨复晴。\n烧痕回野色，禽语尽春声。\n駃駃山泉溜，欣欣木叶荣。\n杖藜村店酒，清似好官清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵落花","author":"汪晫","text":"新绿满高树，残红辞旧枝。\n马嵬留袜处，金谷坠楼时。\n巢燕衔香急，川鱼弄缬迟。\n诗人无可恨，青子又垂垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵戴显之晚春夹溪閒行","author":"汪晫","text":"出郭知春晚，阴阴绿满川。\n小桥横■杌，斜柳拂沦涟。\n风急低双燕，林幽聒一鹃。\n酴醾破香蕊，孤艳殿群妍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过西园视豁然亭旧址景仰苏黄门有感用其留题韵示五弟八弟","author":"汪晫","text":"西风落叶满空山，怀古情悰每怆然。\n诗句尚传人化鹤，危亭何在草生烟。\n披寻旧址营华构，追继当时醉玉船。\n要为故家复遗业，当知此举合为先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席次韵赵簿县圃小集呈李明府","author":"汪晫","text":"管领宾僚破费春，座中著白是山人。\n鱼游浅绿心机熟，莺诉残红句语新。\n老屋不嫌规制朴，长官最喜土风淳。\n满园桃李成阴密，留取甘棠浣水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城中春寒即事","author":"汪晫","text":"重来春又半，梦寐念归期。\n山近衾裯薄，春寒鼓角悲。\n晓钟风送远，宿霭日开迟。\n客里真寥落，愁添两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕遣兴","author":"汪晫","text":"秋月清如水，凉生善养堂。\n鹊惊梧叶坠，露压稻花香。\n煨芋荐蛆白，开橙擘蟹黄。\n客来随所有，此兴不能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"写真","author":"汪晫","text":"须眉数得茎茎古，果是环谷山中人。\n道眼静观付一笑，借问两个若个真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丁簿杂兴 其三","author":"汪晫","text":"高士亦主簿，漫士可一笑。\n轻云出岩阿，皎月生海峤。\n官曹无公事，老木有鹤叫。\n侯已诗道尊，时亦参众妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丁簿杂兴 其五","author":"汪晫","text":"祥凤鸣高梧，■鴳伏短篱。\n人行谨所趋，畏途或平逵。\n如饮钵中水，冷暖能自知。\n我愿歌考槃，侯遇亦未迟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丁簿杂兴 其四","author":"汪晫","text":"侯家好兄弟，森森如立竹。\n侯今白首去，乃复坐矮屋。\n要当振龙鬣，宁更淹骥足。\n吉人天相之，富贵在晚福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丁簿杂兴 其二","author":"汪晫","text":"宴坐读侯诗，凛凛竖发毛。\n平实未是卑，秀爽非为高。\n清如幽谷花，羞杀李与桃。\n无怨而有哀，请歌楚离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵丁簿杂兴 其一","author":"汪晫","text":"诗坛一何峻，寻盟休论且。\n弟子性嗜酒，白莲许入社。\n寒水巫阳峡，暮日苍梧野。\n大雅久不闻，今侯真作者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶子真贤良留题登源先庙","author":"汪晫","text":"文皇当日伐辽东，授钥忠勋留禁中。\n违命加诬非信史，新诗昭雪有奇功。\n阴兵犹可歼凶悖，甘泽还能作岁丰。\n他日或提迁固笔，删修订实望研穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵处约兄春行用前韵","author":"汪晫","text":"老去而今技已穷，在人胸次要陶融。\n三杯村酒兄和弟，一岁春光绿换红。\n兀坐悠悠閒度日，闭门咄咄静书空。\n青山顾我多容态，影照清溪秀且丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵环谷即事","author":"汪晫","text":"本是偷閒择一枝，静中此乐有谁知。\n山光照座年年在，世事于人日日非。\n春研有诗吟即事，夜灯无梦到相思。\n汉阴老子机何有，禅病今来减带围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵盖簿宾春","author":"汪晫","text":"忽颁新历日，春事到茅檐。\n心自丹如故，须应白又添。\n微风和拂面，小雨冷侵帘。\n酒竭妨春饮，新将齑瓮腌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏同周同人与史尉登西园后山茅亭望远周君有赋依韵奉和兼呈少府","author":"汪晫","text":"青山一登啸，陡觉心胸别。\n飘飘襟袖寒，恍若御风列。\n汩没尘埃中，纷纷乱如蠛。\n不期会佳人，成此两奇绝。\n美哉周氏子，炯炯冰壶月。\n倾盖便如故，何必素所惬。\n磊落史少府，丰姿瑩霜雪。\n真如汗血驹，才名籍天阅。\n抵掌同一笑，心悟口难说。\n向晚雨初霁，高柳新蝉咽。\n倚槛云去来，不误巾角折。\n挥翰有佳句，明珠眩双睫。\n蹇予非少年，所作尽短拙。\n万事等白鸥，波间自没灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某衰年未了初度复临伏辱时贤载酒为寿且挥洒佳章增光枯朽即席次韵见谢意","author":"汪晫","text":"白发衰翁岁已老，惜花有心犹起早。\n无事晓窗但高眠，闭关苔青门不扫。\n和靖风流屋后梅，濂溪气味窗前草。\n近与邹轲同窠臼，亦欲集义以养浩。\n不解吟诗著书册，自爱严君平一个。\n无复求仙事老聃，宁更寻禅参达磨。\n皇天见怜尚不死，牵率时贤持酒贺。\n不才自当明主弃，非敢椟玉为怀宝。\n致君尧舜须公等，山中槁夫勿多道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景苏堂新复上李明府","author":"汪晫","text":"先生德政殊清明，斯堂故以景苏名。\n可怜向苦糟曲厄，东撑西柱悬河倾。\n一从公来忽嗟叹，不日云斤还旧观。\n败栋宅鼠壁篆蜗，涌翠流光复辉焕。\n坐想岷峨远山碧，先生已矣遗陈迹。\n华阳三十六篇诗，今日拂尘炯全璧。\n自来苏李两名家，斯堂二贤愈光华。\n看公了却此县债，步武先生云路快。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游翠眉用苏黄门子由韵","author":"汪晫","text":"黛拂蛾眉两月弯，虚亭著与小三间。\n吾翁先见如樗里，此老遗思比岘山。\n千仞远峰和我瘦，一庭芳草伴春閒。\n登临涕落当年事，不见仙人玉雪颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴四章章五句 其一","author":"汪晫","text":"暑往寒来如电泡，年年门外閒花草，世事纷纷自颠倒。\n青山眼底最多情，日日向人浑不老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静观堂十偈 其三","author":"汪晫","text":"万缘一息丝不挂，一个閒身煞潇洒。\n静中有味淡如如，哑子得梦难为话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 次韵荷净亭小集","author":"汪晫","text":"落日水亭静，藕叶胜花香。\n时贤飞盖，松间喝道挟胡床。\n暑气林深不受，山色晚来逾好，顿觉酒尊凉。\n妙语发天籁，幽眇亦张皇。\n射者中，弈者胜，兴悠长。\n佳人雪藕，更调冰水赛寒浆。\n惊饵游鱼深逝，带箭山禽高举，此话要商量。\n溪上采菱女，三五傍垂杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 属纩遗语","author":"汪晫","text":"一只船儿没赛。\n七十六年装载。\n把柁更须牢，风饱蒲帆轻快。\n无碍。\n无碍。\n匹似子猷访戴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令 次韵吴郎子信残春","author":"汪晫","text":"几点弄晴微雨。\n翳日薄云来去。\n断送一番春，满径杨花飞絮。\n无语。\n无语。\n还是旧时院宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 咏木犀","author":"汪晫","text":"可是东风、当日欠商量。\n百紫千红春富贵，无半点，似渠香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 次韵李明府见寿","author":"汪晫","text":"千缕柳丝犹嫩，一星榆火初明。\n载将新意寿幽人。\n红袖持杯劝尽。\n老鹤自偏野性，沙鸥难比轻身。\n殷勤多谢祝长春。\n一笑东风夜静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 次韵李明府劝农","author":"汪晫","text":"民吾同胞，剖破藩篱，元是大家。\n故见之诰诏，视如子弟，谆勤恳切，悃愊无华。\n孝悌力田，职当劝相，起早非干为看花。\n亲酌酒，老农唯诺，句句仁芽。\n晓来犹觉寒些。\n看雨湿风吹旗□斜。\n笑吾生八十，尽谙农事，公筵既彻，更共烹茶。\n高唱豳风，敬酬令尹，王道桑麻乐有涯。\n春务急，见溪头杨柳，已可藏鸦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"汪晫","text":"相逢草草，共吟诗、同醉杯中之物。\n评论三王讥五霸，谈辩喧哗邻壁。\n敲缺唾壶，击残如意，妙语飞华雪。\n无能为也，如何对此三杰。\n看取东野诗成，南昌书就，奈征车催发。\n后夜山深何处宿，红豆寒灯明灭。\n一老堪怜，两生未起，应念星星发。\n风传佳话，花村无犬惊月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 清明","author":"汪晫","text":"谁家野菜饭炊香，正是江南寒食。\n试问春光今几许，犹有三分之一。\n枝上花稀，柳间莺老，是处春狼藉。\n新来燕子，尚传晋苑消息。\n应记往日西湖，万家罗绮，见满城争出。\n急管繁弦嘈杂处，宝马香车如织。\n猛省狂游，恍如昨梦，何日重寻觅。\n杜鹃声里，桂轮挂上空碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其二 环谷秋夜独酌","author":"汪晫","text":"夜对灯花语。\n且随宜、果盘草草，两三杯数。\n翠玉环中园五亩，自唱山歌自舞。\n况今夜、尊前无暑。\n何用食前须方丈，更后车、何用婵娟女。\n这闲福，自心许。\n蓼花芦叶纷江渚。\n有沙边、寒蛩吟透，梧桐秋雨。\n羡甚满堂金玉富，未可学人渔取。\n怕天也、未曾相与。\n豹遁蛟藏泉可濯，有鬼神、呵护盘之阻。\n鲜可食，脍银缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 其一 开禧丁卯端午中都借石林韵","author":"汪晫","text":"帖子传新语。\n问自来、翰林学士，几多人数。\n或道江心空铸镜，或道艾人如舞。\n或更道、冰盘消暑。\n或道芸香能去蠹，有宫中、斗草盈盈女。\n都不管，道何许。\n离骚古意盈洲渚。\n也莫道、龙舟吊屈，浪花吹雨。\n只有辟兵符子好，少有词人拈取。\n谁肯向、帖中道与。\n绝口用兵两个字，是老臣、忠爱知艰阻。\n写此句，绛纱缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 次韵初夏小集","author":"汪晫","text":"田舍炉头语。\n便如何学得，三变美成家数。\n村酒三杯狂兴发，拔剑偶然起舞。\n只么也、迎寒送暑。\n待草万言书上阙，似忧端、倚柱东邻女。\n卿相事，未易许。\n渔歌且和芙蓉渚。\n又何须、淫辞媟语，诃风诋雨。\n劝人生、且随缘分，分外一毫莫取。\n那富贵、由天付与。\n身蹈危机犹不觉，如布衣、自在都无阻。\n空博得，雪千缕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 秋夜简赵尉借韵","author":"汪晫","text":"午夜凉生风不住。\n河汉无声，时见疏星度。\n佳客伴君知未去。\n对床只欠潇潇雨。\n素月四更山外吐。\n金鸭慵添，消尽沈烟缕。\n料想玉楼人念处。\n归舟日望荷花浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪词 春愁","author":"汪晫","text":"伤时怀抱不胜愁。\n野水粼粼绿遍洲。\n满地落花春病酒，一帘明月夜登楼。\n明眸皓齿人难得，寒食清明事又休。\n只是鹧鸪三两曲，等闲白了几人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"汪晫","text":"山寒杏未花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"汪晫","text":"梨花院落春宵短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"汪晫","text":"灭烛闵娥伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"汪晫","text":"片片飞红已谢春，红移榴蕊更精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访黄吏部不值","author":"汪翔龙","text":"一镜湖光半壁山，主人何往客来观。\n闲蝶自专花富贵，幽禽如语竹平安。\n烟云变化草木媚，日月往来天地宽。\n何当共整登临屐，更上崔嵬绝顶看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游泽山","author":"汪翔龙","text":"独俯空堂夜，无人境自宽。\n高风河影动，斜月竹身寒。\n潮海秋声阔，山林客梦安。\n坐来更几点，北斗挂阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄山采药歌","author":"汪雄图","text":"黄山青兮峛崺，三十六峰兮森起。\n草芸芸兮金吐华，石浥浥兮玉成髓。\n若有人兮薜荔衣，掬芳润兮凌险巇。\n朝撷英兮岩窦，夕揽秀兮溪湄。\n招浮邱兮为侣，岂刘阮兮自迷。\n疗膏肓兮下土，陪轩辕兮与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方壶别墅","author":"汪楚材","text":"面面轩窗好，溪山不待招。\n清风修竹径，细雨绿荷桥。\n地僻人烟少，天恢景象饶。\n襟怀无一事，终老乐箪瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谋创领要亭","author":"汪熙","text":"生平酷爱山，好山宁相远。\n知吾入山意，幽致竞牵挽。\n信步杖藜轻，升高腰脚健。\n小雨著黄落，索索声相溷。\n僧窗事事幽，蕉肥野菊曼。\n尘市仅隔水，心安即为遁。\n有岩瞰清溪，古木郁萝蔓。\n前冈连远嶂，万象纷自献。\n人生有物缘，参合甚符券。\n缘外倘强求，十一失千万。\n此地乃天与，一亭吾欲建。\n寄言岩下石，为偿把钓愿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孙武","author":"汪韶","text":"为忧玩色堕军实，故假陈兵去二姬。\n却恨此机深莫悟，后人不谏受西施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"汪韶","text":"南北几离合，江山一古今。\n秋风驼卧棘，春雨燕巢林。\n家国兴亡梦，英雄胜败心。\n九疑呼不起，愁绝暮云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]