[{"title":"皇祐亲享明堂六首 其五 酌献用《孝安》。","author":"郊庙朝会歌辞","text":"艺祖造邦，二宗绍德。\n肃雍孝享，登配圜极。\n先训有开，菲躬何力。\n歆馨锡羡，保民丽亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇祐亲享明堂六首 其一 降神用《诚安》。","author":"郊庙朝会歌辞","text":"维圣享帝，维孝严亲。\n肇图世室，躬展精禋。\n镛鼓既设，笾豆既陈。\n至诚攸感，保格上神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗上太皇太后册宝五首 其五 太尉等奉册宝出入门用《正安》。","author":"郊庙朝会歌辞","text":"玉车临御，凤盖棽丽。\n奉承宝册，弥文盛仪。\n抗声极律，助我孝熙。\n天之所佑，万寿无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗上太皇太后册宝五首 其四 降坐用《乾安》。","author":"郊庙朝会歌辞","text":"涂山之德，渭涘之祥。\n图徽宝册，玉色金相。\n管弦烨煜，钟鼓喤喤。\n天之所启，既寿而昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗上太皇太后册宝五首 其三 太皇太后升坐用《乾安》。","author":"郊庙朝会歌辞","text":"总裁庶政，拥佑嗣皇。\n金书玉简，烂其文章。\n众歌警作，筦磬将将。\n保安四极，降福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗上太皇太后册宝五首 其二 降坐用《乾安》。","author":"郊庙朝会歌辞","text":"皇帝仁孝，总临万方。\n褒显其亲，日严以庄。\n龙衮翼翼，玉书煌煌。\n传之亿世，休有烈光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗上太皇太后册宝五首 其一 皇帝升坐用《乾安》。","author":"郊庙朝会歌辞","text":"大矣孝熙，帅民以躬。\n奉承宝册，钦明两宫。\n万乐具举，一人肃雍。\n化繇上始，四海来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗发皇后册宝三首 其三","author":"郊庙朝会歌辞","text":"宣哲维公，就位肃庄。\n册宝具举，丕显其光。\n出于宸闱，鼓钟喤喤。\n母仪天下，万寿无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗发皇后册宝三首 其二","author":"郊庙朝会歌辞","text":"我礼嘉成，我驾言旋。\n降坐而跸，奏鼓渊渊。\n景命有仆，保佑自天。\n永锡祚嗣，何千万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗发皇后册宝三首 其一","author":"郊庙朝会歌辞","text":"既登乃依，如日之升。\n有严有翼，丕显丕承。\n天作之合，家邦其兴。\n朱芾斯皇，子孙绳绳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗传受国宝三首 其三 《翔鹤》。","author":"郊庙朝会歌辞","text":"彼鸣在阴，亦白其羽。\n声闻于天，来集斯所。\n勉勉我王，咸遂厥宇。\n播于异物，受天多祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哲宗传受国宝三首 其二 《神光》。","author":"郊庙朝会歌辞","text":"惟皇上德，伊嘏我王。\n将受厥明，载锡之光。\n于昭于天，晔晔煌煌。\n缉熙钦止，其永无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 送神用《景安》。","author":"郊庙朝会歌辞","text":"于赫上帝，乘龙御天。\n惟圣克事，明飨斯虔。\n荐豆云彻，灵猋且旋。\n载锡休祉，其惟有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 望燎用《正安》。","author":"郊庙朝会歌辞","text":"灵承上帝，精意感通。\n馨香旁达，粢盛既丰。\n登降有仪，祀备乐终。\n神之听之，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 彻豆用《肃安》。","author":"郊庙朝会歌辞","text":"内心齐诚，外物蠲洁。\n神来迪尝，俎豆既彻。\n燕及群生，靡或夭阏。\n降福穰穰，时万时亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 太祖位酌献用《英安》。","author":"郊庙朝会歌辞","text":"赫赫翼祖，受命于天。\n德迈三代，威加八埏。\n陟配上帝，明禋告虔。\n流光垂裕，于万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 太祖位奠币用《定安》。","author":"郊庙朝会歌辞","text":"茫茫苍穹，孰知其纪。\n精意潜通，虽远而迩。\n量币荐诚，有实斯篚。\n眷然顾之，永锡繁祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"惟圣普临，顺皇之德。\n典礼有彝，享祀不忒。\n笾豆静嘉，降登肸饬。\n神具醉止，景贶咸集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 其一 降神用《景安》。","author":"郊庙朝会歌辞","text":"蒐讲上仪，式修毖祀。\n日吉辰良，礼成乐备。\n风驭云旗，聿来歆止。\n嘉我馨德，介兹繁祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"祀事孔明，礼文惟楙。\n爰洁牺牲，载登俎豆。\n或肆或将，无声无臭。\n精祲潜通，永绥我后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 其四 降神用《景安》。","author":"郊庙朝会歌辞","text":"惟天为大，物始攸资。\n恭承禋祀，以报以祈。\n神不可度，日监在兹。\n有馨明德，庶其格思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 上帝位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"治极发闻，不瑕有芬。\n嘉玉陈币，神届欣欣。\n诚心昭著，钦恭无文。\n以妥以侑，笃祜何垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 其二 降神用《景安》。","author":"郊庙朝会歌辞","text":"我将我享，涓选休成。\n执事有恪，惟寅惟清。\n乐既六变，肃雍和鸣。\n高高在上，庶几是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 升坛用《正安》。","author":"郊庙朝会歌辞","text":"皇矣上帝，神格无方。\n一阳肇复，典祀有常。\n豆登丰洁，荐德清香。\n棐诚居歆，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"大德曰生，阴阳寒暑。\n乐舞形容，干戚籥羽。\n一弛一张，退旅进旅。\n神安乐之，祉锡绵宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高宗建炎初祀昊天上帝 上帝酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"气萌黄钟，万物资始。\n钦若高穹，吉蠲时祀。\n神策泰元，增授无已。\n群生熙熙，函蒙繁祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾兴御楼二首 其二 降坐用《隆安》。","author":"郊庙朝会歌辞","text":"皇衢赫敞，黼坐穹崇。\n华缨在列，严令发中。\n王制钜丽，宝瑞丰融。\n均禧绵宇，万寿无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾兴御楼二首 其一 升坐用《隆安》。","author":"郊庙朝会歌辞","text":"夹钟纪月，初吉在辰。\n眚灾流庆，布德推仁。\n采章震耀，典礼具陈。\n茂昭丕贶，永庇斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乾道七年册皇太子四首 其四","author":"郊庙朝会歌辞","text":"储副豫定，器之公兮。\n册授孔时，礼之隆兮。\n天步迟迟，旋九重兮。\n寿祉万年，德无穷兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0