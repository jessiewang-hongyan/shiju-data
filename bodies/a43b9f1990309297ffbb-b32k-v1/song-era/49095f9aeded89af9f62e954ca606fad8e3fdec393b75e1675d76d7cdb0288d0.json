[{"title":"寓叹四首 其三","author":"陆游","text":"事外痴顽老，人中剩长身。\n开颜时赖酒，闭口不言贫。\n淡话常终夕，闲游动历旬。\n渔翁偶相遇，疑是武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹四首 其二","author":"陆游","text":"小隐终非隐，休官尚是官。\n早知农圃乐，不见道途难。\n故国鸡豚社，贫家菽水欢。\n至今清夜梦，犹觉畏涛澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"眼底谁为耐久朋，倚肩按膝一乌藤。\n虚名但可欺横目，薄俗何时复结绳。\n浮世百年悲冉冉，闲身万事付腾腾。\n年来更叹龙钟甚，欲探梅花病不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹三首 其三","author":"陆游","text":"裘薄便冬暖，箪空畏午饥。\n临成乞米帖，看入借车诗。\n学古心犹壮，忧时语自悲。\n公卿阙自重，社稷欲谁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹三首 其二","author":"陆游","text":"交世非初志，谋生又绝疏。\n家贫思辟谷，人忌悔知书。\n门异回轩巷，乘无秃尾驴。\n老顽君勿怪，万事有乘除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹二首 其二","author":"陆游","text":"醉抚酒壶怜矲矮，卧看香岫爱嶙峋。\n旧时京洛尘埃面，今作江湖风月民。\n幻世界中均起灭，太虚空里孰冤亲。\n可斋入定论千劫，说与天魔任恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"千载前人每暗同，眼边俗客马牛风。\n作文要可张子布，饮酒思从陈孟公。\n半世氛埃成潦倒，几时蓑钓入空濛。\n一庵处处皆堪老，莫怕无山著此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"五福惟无富，嗟予得已多。\n禅房时托宿，酒市每酣歌。\n诗瘦慵看镜，棋鏖恐烂柯。\n残年犹有几，切莫负渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹二首 其一","author":"陆游","text":"白首还乡厌蕨薇，伥伥自叹欲畴依。\n门庭不扫稀迎客，砧杵无声未赎衣。\n达士共知生是赘，古人尝谓死为归。\n耕畴幸可期中熟，又报残蝗接翅飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"有位方忧失，无家岂念归。\n贤愚竟谁得，今昨两皆非。\n世事无长算，人情忽骇机。\n细思如意处，惟有钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹三首 其一","author":"陆游","text":"心已忘斯世，天犹活此翁。\n嫩汤茶乳白，软火地炉红。\n课婢耘蔬甲，呼儿下钓筒。\n生涯君勿笑，聊足慰涂穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹二首 其一","author":"陆游","text":"江上霜风透弊袍，区区无奈簿书劳。\n衰迟始忆壮游乐，仕宦更知归卧高。\n人怪羊裘忘富贵，我从牛侩得贤豪。\n俗间问讯真成懒，有手惟堪把蟹螯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"五亩烟芜过半生，还山自笑又躬耕。\n舂炊不继儿啼饭，烹饪无方客絮羹。\n游宦人间身愈困，读书灯下目几盲。\n退之已老当更事，犹向时人说善鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹二首 其二","author":"陆游","text":"忆昔建炎南渡时，兵间脱死命如丝。\n奉亲百口一身在，许国寸心孤剑知。\n坐有客瘖堪共醉，身今病忘莫求医。\n出门但畏从人事，临水登山却未衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"萧疏残发数茎丝，胜负浑如未算棋。\n万里旌旗无昨梦，一蓑烟雨有新诗。\n潜消暗换人谁在，小醉闲眠我自奇。\n二十四年能几许，汾阳回首亦成痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"人生各自有穷通，世事宁论拙与工。\n裹马革心空许国，不龟手药却成功。\n早朝玉勒千门雪，夜坐蓬窗万壑风。\n借得奇书且勤读，小儿能续地炉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓叹","author":"陆游","text":"孤生拙料事，诸老误知人。\n世故几翻覆，此身常贱贫。\n有书藏禹穴，无地静胡尘。\n衰病今年剧，呻吟欲过旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓兴","author":"陆游","text":"穷巷无来客，秋风独浩歌。\n壮年闲处老，佳日病中过。\n甚欲携长镵，仍思拥短蓑。\n逢山皆可隐，不必上三峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓言三首 其二","author":"陆游","text":"出仕谢招麾，还家美蕨薇。\n深居全素志，大路息危机。\n世变生呼吸，人情忽细微。\n床头周易在，舍此欲安归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓言三首 其一","author":"陆游","text":"济剧人才易，扶颠力量难。\n为谋须远大，守节要坚完。\n气与秋天杳，胸吞梦泽宽。\n方知至危地，自有泰山安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓言三首 其三","author":"陆游","text":"山海三家市，风烟五亩园。\n藜羹均玉食，茅屋陋朱门。\n耕钓此身老，乾坤吾道尊。\n故交沦落尽，至理与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓舍书怀","author":"陆游","text":"借得茅斋近笮桥，羁怀病思两无聊。\n春从豆蔻梢头老，日向摴蒱齿上消。\n丛竹晓兼风力横，高梧夜挟雨声骄。\n书生莫倚身常健，未画凌烟鬓已凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓舍偶题","author":"陆游","text":"转徙身飘梗，淹留等系匏。\n雁孤依远渚，鸠拙寄空巢。\n寒日赪梨颊，清霜长橘包。\n平生曲道士，岁晚欲深交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓驿舍","author":"陆游","text":"闲坊古驿掩朱扉，又憩空堂绽客衣。\n九万里中鲲自化，一千年外鹤仍归。\n绕庭数竹饶新笋，解带量松长旧围。\n惟有壁间诗句在，暗尘残墨两依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓馆晚兴","author":"陆游","text":"随牒人间不自怜，衢州孤驿更萧然。\n百年细数半行路，万事不如长醉眠。\n发短经秋真种种，腹宽耐事只便便。\n晚窗商略唯当饮，安得黄花到眼边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓蓬莱馆","author":"陆游","text":"道山方梦断，税驾复蓬莱。\n海上羝应乳，辽东鹤已回。\n客惊添鬓雪，自笑久心灰。\n底事妨人睡，楼头暮角哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓蓬莱馆","author":"陆游","text":"朱门高柳画桥南，掠面风埃喜解骖。\n霁日偶逢春盎盎，野人不惯屋潭潭。\n堂中剩喜簪裾集，楼上时闻鼓角酣。\n明发扁舟觅归路，趁时吾欲事农蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"属疾","author":"陆游","text":"白头属疾卧丘园，药物枝梧且仅存。\n月黑浅山闻鵩啸，窗明高树送鸦翻。\n谗欺薄命深消骨，忧集穷途黯断魂。\n回视少时真隔世，但馀一念在元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悲秋","author":"陆游","text":"一抛蓑笠雪溪舟，八载梁州复益州。\n才破繁华海棠梦，又惊摇落井梧秋。\n晓班无复趋行殿，晚境惟思老寝丘。\n病肺经旬疏酒盏，愁来惟是上南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悲秋","author":"陆游","text":"病后支离不自持，湖边萧瑟早寒时。\n已惊白发冯唐老，又起清秋宋玉悲。\n枕上数声新到雁，灯前一局欲残棋。\n丈夫几许襟怀事，天地无情似不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"搔首","author":"陆游","text":"玩画无馀易，闻歌已尽诗。\n古人不可作，此理孰能推。\n白发秋风里，青灯夜雨时。\n初心竟当负，搔首叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散发","author":"陆游","text":"散发垂肩懒更簪，一窗竹水对萧森。\n从来耻作资身策，老去终怀报国心。\n雷起鼻端秋枕石，泉鸣指下夜横琴。\n不缘羸病愁迎客，经岁何人肯见临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散吏","author":"陆游","text":"拜赐明时散吏名，头衔字字敌冰清。\n读书有味聊忘老，赋禄无多亦代耕。\n笠泽莼鲈秋向晚，缑山笙鹤月微明。\n人间乐事今真得，莫恨摧颓白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散怀","author":"陆游","text":"小疾便幽翳，孤怀抱郁陶。\n遗文诵史汉，奇思探庄骚。\n谈笑宽吟苦，经行慰作劳。\n东冈聊一往，突兀古台高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散怀","author":"陆游","text":"少年已遂遁山林，何况霜毛两鬓侵。\n习气尚存诗入梦，病根未去药关心。\n猿知秋近啼先苦，鹤阅年多顶渐深。\n不忍顿疏风月在，粗能扶杖即登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散步东村","author":"陆游","text":"偶从北崦缭东岗，曳杖行歌踏夕阳。\n一径入云多鹿迹，数家临水共渔梁。\n野风萧瑟知秋早，社酒淋漓喜岁穰。\n邻曲不须怜老惫，尚能寻句答年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散步至三家村","author":"陆游","text":"人情简朴古风存，暮过三家水际村。\n见说终年常闭户，仍闻累世自通婚。\n罾船归处鱼餐美，社瓮香时黍酒浑。\n记取放翁扶杖处，渚蒲烟草湿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散步湖上至野人家","author":"陆游","text":"湖上霜高水落时，一藤信步出寻诗。\n妄誇强健真堪笑，唤作清闲亦自欺。\n西埭又随牛迹去，东村常望鹳巢知。\n渔翁留客频辞谢，鸡瘦难烹酒味漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散步湖堤上时方浚湖水面稍渺瀰矣","author":"陆游","text":"老觉人间万事轻，不妨闲处得闲行。\n西山鸟没暮云合，南浦堤平春水生。\n孤操不渝无鹤怨，淡交耐久有鸥盟。\n先民幸处吾能胜，生长兵间老太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散策至湖上民家","author":"陆游","text":"曳杖翩然入莽苍，人间有此白云乡。\n风传高树珍禽语，露湿幽丛药草香。\n农事正看春水白，客途渐爱午阴凉。\n馀年且就无羁束，社鼓鼕鼕乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斯道","author":"陆游","text":"斯道有显晦，所忧非贱贫。\n乾坤均一气，夷狄亦吾人。\n朋党消廷论，锄耰洗战尘。\n清时更何事，处处是尧民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴甫一日复大风雨连日不止遣怀","author":"陆游","text":"书剑当年隘九州，白头归卧一窗幽。\n染成草色春犹浅，老尽梅花雨未休。\n得句已无前辈赏，开编时与古人游。\n山房小瓮今朝熟，不恨尊前自献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑中自遣","author":"陆游","text":"名山处处得幽寻，破砚时时出苦吟。\n上药和平无近效，古诗简淡有遗音。\n苏门隐去闻孤啸，栗里归来弄素琴。\n尚恐俗尘除未尽，每思雪夜宿东林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑行憩新都驿","author":"陆游","text":"细细黄花落古槐，江皋不雨转轻雷。\n长空鸟破苍烟去，落日人从绿野来。\n散策意行寻水石，脱巾高卧避氛埃。\n羁游未羡端居乐，看月房湖又一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夜","author":"陆游","text":"毒暑弥三伏，微凉起二更。\n月窗风竹乱，烟渚露荷倾。\n寂寞借书读，清羸扶杖行。\n无功耗官廪，太息负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夜泛舟二首 其二","author":"陆游","text":"烈暑元知不可逃，天将清夜付吾曹。\n小舟行处浦风急，健鹘归时山月高。\n愚智极知均腐骨，利名何啻一秋毫。\n等闲分得吴松水，安用并州快剪刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夜泛舟二首 其一","author":"陆游","text":"暑气方然一鼎汤，聊呼艇子夜追凉。\n微风忽起发根冷，阙月初升林影长。\n渐近场中闻笑语，却从堤外看帆樯。\n超然自适君知否，身世从来付两忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曾原伯屡劝居城中而仆方欲自梅山入云门今日病酒偶得长句奉寄","author":"陆游","text":"借得僧房似钓船，兼旬散发醉江天。\n酒能作病真如此，穷乃工诗却未然。\n闲似白鸥虽自许，健如黄犊已无缘。\n秋高更欲移家去，先葺云门屋数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝饥示子聿","author":"陆游","text":"水云深处小茅茨，雷动空肠惯忍饥。\n外物不移方是学，俗人犹爱未为诗。\n生逢昭代虽虚过，死见先亲幸有辞。\n八十到头终强项，欲将衣钵付吾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山四首 其三","author":"陆游","text":"病退行犹倦，山坡每少休。\n高枝闻鹊语，浅濑见鱼游。\n偶有堪乘兴，元无可遣愁。\n悠然又终日，争路有归牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其二","author":"陆游","text":"萧然破帽伴枯藤，逢著青山不厌憎。\n家似江淮归业户，身如湖岭罢参僧。\n煨柴夜宿寒炉火，洗釜晨敲古涧冰。\n果向此中能得趣，宦途捷径不须曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其一","author":"陆游","text":"一生万里著行縢，抖擞尘埃尚未能。\n不怕语音时带剡，敢辞生计略如僧。\n疏梅渐动清溪曲，霁雪遥看古塔层。\n唤起故年清绝梦，数声柔橹下巴陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山四首 其四","author":"陆游","text":"古寺不来久，入门空叹嗟。\n僧亡犹见塔，树老已无花。\n世事虽难料，吾生固有涯。\n殷勤一梳月，十里伴还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山四首 其一","author":"陆游","text":"萧散湖山路，天教脱絷羁。\n蝉声入古寺，马影度荒陂。\n樵唱时倾耳，僧谈亦解颐。\n偏门灯火闹，不敢恨归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山三首 其三","author":"陆游","text":"九十衰翁心尚孩，幅巾随处一悠哉。\n偶扶拄杖登山去，却唤孤舟过渡来。\n酒市拥途观嵬峨，僧庐借榻寄咍台。\n吾生清绝烦君看，不枉人间梦一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山步二首 其二","author":"陆游","text":"南出平桥十里馀，湖山处处可成图。\n水边更觉梅花瘦，云外谁怜雁影孤。\n时唤行僧同煮茗，亦逢樵叟问迷途。\n破裘不怕春寒峭，小市疏灯有酒垆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山归偶赋","author":"陆游","text":"此生本寄一浮沤，归卧茅茨又四秋。\n习气未除惟痛饮，幻躯偶健且闲游。\n买蓑山县云藏市，横笛江城月满楼。\n与世沈浮最安乐，莫思将相快恩雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山戏作","author":"陆游","text":"晚境频辞禄，穷居旋学耕。\n量衰添酒敌，才尽减诗名。\n风月成交友，溪山管送迎。\n登车雨先止，天岂相吾行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山西村","author":"陆游","text":"莫笑农家腊酒浑，丰年留客足鸡豚。\n山重水复疑无路，柳暗花明又一村。\n箫鼓追随春社近，衣冠简朴古风存。\n从今若许闲乘月，拄杖无时夜叩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山步二首 其一","author":"陆游","text":"蹇驴渺渺过云边，旋了三生物外缘。\n平日视家真逆旅，此行出户若登仙。\n饥从野店烹葵饭，困就僧床借枕眠。\n所恨暮年交旧尽，佳时无与共联翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游云门诸兰若","author":"陆游","text":"花过木阴合，溪云生莫凉。\n牛行响白水，鹭下点青秧。\n古寺宛如昔，稚松森已行。\n耆年不下榻，童子为烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游凤皇山","author":"陆游","text":"穷日文书有底忙，幅巾萧散集山堂。\n一樽病起初浮白，连焙春迟未过黄。\n坐上清风随麈柄，归途微雨发松香。\n临溪更觅投竿地，我欲时来小作狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游东村","author":"陆游","text":"露草衡门晓，风松一坞幽。\n新春有佳日，老子得闲游。\n鸥为忘机下，鱼缘得计浮。\n归途无远近，一叶乱渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石帆玉笥石旗诸山","author":"陆游","text":"暮景苦多病，幽寻寄一欣。\n溪喧常似雨，石润易生云。\n天迥回鸦阵，林疏过鹿群。\n莫谈朝市事，吾老厌纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游西村","author":"陆游","text":"昨夜雨多溪水浑，不妨唤渡到西村。\n出游始觉此身健，无食更知吾道尊。\n药笈可赊山店酒，筇枝时打野僧门。\n归来灯火茅檐夜，且复狂歌鼓盎盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游西村赠隐者","author":"陆游","text":"水清沙净见游鱼，槐柳阴阴五月初。\n人似登仙惟火食，俗如太古欠巢居。\n熟闻高卧常扃户，剩欲频来共荷锄。\n从此梦游端有地，渊明不独爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游张园","author":"陆游","text":"冷局归差早，名园得缓行。\n穿林山骤出，度峡路微平。\n霜近柳无色，风生蒲有声。\n出门还惝恍，满路夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]