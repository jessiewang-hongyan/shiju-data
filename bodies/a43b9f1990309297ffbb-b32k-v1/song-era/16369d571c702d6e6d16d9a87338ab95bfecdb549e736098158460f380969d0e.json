[{"title":"凌晨马上得惠诗再次元韵 其二","author":"韦骧","text":"建芽精嫩凤为团，海错珍鲜鳆作乾。\n远物方惭容易献，来篇不似等閒看。\n始忻报玖情何厚，幡觉阳春和独难。\n写寄中州传好事，须教纸价踊长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌晨马上得惠诗再次元韵 其三","author":"韦骧","text":"自今酬唱不宜稀，所恨诗盟结已迟。\n两阵辞锋谩交战，一坛将钺敢争持。\n宦途何愧为难进，老境宁当效逆施。\n相遇相期情谊远，莫临觞咏数瓜期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻胡琴一首","author":"韦骧","text":"园林雨过秋萧索，幅巾谈笑情方乐。\n歘然一抹四朱弦，续续清声透帘幕。\n轻拢慢撚手应心，如出自然非以学。\n露蝉凄咽春莺啭，变化逡巡动寥廓。\n审音度曲肃众听，歌舞满堂生寂寞。\n自嗟投老饮量衰，一举为空金凿落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书西县壁","author":"韦骧","text":"判袂知非远，驰轺约屡经。\n犹于暮云底，回首汉皋亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻岩起至以诗先寄 其一","author":"韦骧","text":"宝峰亭下菊鲜鲜，妩媚秋风似可怜。\n欲摘一枝分玉盏，星轺莫惜屡扬鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻岩起至以诗先寄 其二","author":"韦骧","text":"公来税鞅且盘桓，山国萧条正早寒。\n虽缺鸾弦翻妙曲，聊凭蚁酒助清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和道中咏怀","author":"韦骧","text":"酒轶刘伶颂，茶高陆羽经。\n庶几延笑语，何事驻长亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和述志","author":"韦骧","text":"振职提三尺，潜心醉六经。\n高材难浅度，岂止狱平亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和念祖","author":"韦骧","text":"仰服籯金训，传家在一经。\n况当声教远，夜柝静戎亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和庭橘","author":"韦骧","text":"常思洞庭橘，美实冠南方。\n雪蘤千林谢，金衣万顷黄。\n辉光依泽国，彷佛在仙乡。\n沈咏滋迎露，韦诗寄待霜。\n远邦方渴想，邻圃得清香。\n未用矜封户，何如助釂觞。\n分甘音尚阻，抽思韵空长。\n岂必三吴渚，宁烦一苇航。\n支筇即可到，反掌便堪尝。\n慰我东南梦，殷勤送斐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和告成寺","author":"韦骧","text":"嘉陵江势并山回，山寺双扉对水开。\n凿石千寻维佛屋，参天一举类仙台。\n白云有意频舒卷，幽鸟无情自往来。\n心境两忘真未易，登临便谓出尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送益铃高宣事","author":"韦骧","text":"王孙远器世功勋，材略纵横旧出伦。\n春事近违文陛侧，铃兵遥指锦江滨。\n赠篇累什皆通贵，去国赊程少故人。\n倾盖相欢一樽酒，感君离思并如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过青山","author":"韦骧","text":"迟晓扬镳陟峻冈，马蹄凌厉踏新霜。\n崔嵬昨日参天碧，萧索今朝满目黄。\n堕叶离披疑虎迹，曲蹊盘屈类羊肠。\n按行若也多禆补，敢惮崎岖道路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至苍溪","author":"韦骧","text":"輶轩寒入苍溪县，秀句遐追老杜诗。\n送客泛舟空往事，过峰来橘似当时。\n高材遗兴千年在，远宦羁怀万里随。\n索笔谩题行馆壁，可能閒料后人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自西水还少憩锦屏山广寿院","author":"韦骧","text":"按行回辔阆城南，登陟崎岖力不堪。\n却坐锦屏休倦迹，暑天冰水沃醺酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云台观","author":"韦骧","text":"缘崖涉涧上云台，古观稀逢车马来。\n翠柏径深长蔽日，玉鱼池浅仅胜杯。\n取桃人去无遗迹，锁药炉存绝旧灰。\n唯仰天师凛然像，祗愁双剑起风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢岩起惠支颐二首 其一","author":"韦骧","text":"几杖安身外，于兹用智深。\n见贻扶倦颔，捧受识仁心。\n本异支离隐，何妨彦祖钦。\n唯愁说诗善，笑解恐难任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢岩起惠支颐二首 其二","author":"韦骧","text":"引髭聊试颇安然，正好凭依学坐禅。\n儿女环观齐指笑，朱颜犹未怯双莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和苏进之见招兼简岑岩起","author":"韦骧","text":"夫君捧诏独先来，趋节还先数月回。\n联事已忧将判袂，列城况是未丰财。\n翻蒙雅饯同肤使，更枉清篇费美才。\n若得星轺少聊缓，吐茵强酒不辞陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子方登朝京楼偶成","author":"韦骧","text":"登楼为喜乍晴时，欲倚栏杆日已微。\n头上云生还作雨，座间风劲却添衣。\n笑言且共须臾乐，气象休惊顷刻非。\n应是催诗念前况，果然高唱属先机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韦骧","text":"楼号朝京人未归，浮云蔽日雨霏微。\n静论国手饶棋路，閒喜官身著道衣。\n心慕孟轲潜养浩，年过蘧瑗久知非。\n随时觞咏聊同乐，全胜区区竞巧机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前韵奉简","author":"韦骧","text":"未能形德似支离，行学由来恨力微。\n罔利唯羞陟龙断，可言宁念卧牛衣。\n高材幸遇同忧乐，公论相投壹是非。\n待向游从废棋局，区区安用谩藏机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和答前福守林中散","author":"韦骧","text":"使指频将念匪宜，闽山何敢惮驱驰。\n荐贤锐意先推鹗，逐恶雄心肯问狸。\n却愧裁篇为惠重，况当卧辙欲留时。\n光芒照眼观华藻，遥想张芝墨满池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福州古田天王院撤珠轩","author":"韦骧","text":"过颡因人激跃成，撤珠取类亦虚名。\n偶观却忆钟离意，委地当时事独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢公永惠荔枝","author":"韦骧","text":"筠笼远致色犹鲜，咀嚼琼英真味全。\n多谢仁人怜病渴，故将灵液爽心㾓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子方夜过卧云庵绝句","author":"韦骧","text":"自愧银鱼久未成，区区从政谩辛勤。\n过庵佳句撩幽兴，待买青山占白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曹子方静常庵","author":"韦骧","text":"爱君新作静常庵，况是佳名继郑南。\n昼坐不知人扰扰，夜存长保气酣酣。\n寓言记述睎庄叟，复命栖时慕老聃。\n标榜粲然辉众目，几何立懦与廉贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答曹子方少年弄篇翰一首","author":"韦骧","text":"虚堂隐几坐，忽忽若假寐。\n飒然清风来，顿尔爽昏思。\n新诗执在手，展读过三四。\n初言少年弄篇翰，喜道白发聊自戏。\n次惊老境今且迫，岂甘物役汩其志。\n轻视富贵如浮云，极论穷通钧一意。\n高谈念平时，健句存远记。\n请老愧袭常，先期乃吾事。\n君年才知命，耳顺予阙二。\n自此七星霜，投绂去朝市。\n是时取高篇，却托冥鸿寄。\n公方处要途，利达沛材智。\n见诗当不嗔，犹认旧书字。\n其来不待索，应亦念衰瘁。\n君年方如我今日，那肯抽簪饵芝术。\n庶几得以警幽情，莫忘采真挥劲笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山二绝 其一","author":"韦骧","text":"溯溪游览绝尘纷，看尽奇峰过所闻。\n昔日幔亭何处是，寂寥空想武夷君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山二绝 其二","author":"韦骧","text":"心爱仙山役世缘，乘轺欲去谩留连。\n更祈秋日停羲驭，莫遣回头怨暝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈安道同年","author":"韦骧","text":"执别都门四见春，悠悠吴越断音尘。\n尔来虽幸官居近，所得唯蒙手翰频。\n折桂交游三纪外，系匏踪迹两溪滨。\n未能把酒论离阔，聊寄篇章托去鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山二首 其一","author":"韦骧","text":"一溪秋水碧溶溶，逆掉扁舟溯晚风。\n卧看峰峦耸奇势，心疑造化炫殊功。\n宾云曲断笙箫远，机石苔荒组织空。\n仙理冥冥难究诘，抽簪归隐羡刘公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山二首 其二","author":"韦骧","text":"融结山川凿混元，谁为窟宅遗神仙。\n三千曾会幔亭客，十六仍标洞府天。\n崖有珍苞不缘种，棺遗清骨莫知年。\n披图昔谓多增饰，至此方知画未全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山寄曹子方","author":"韦骧","text":"访寻仙迹览群峰，诘曲清溪两桨通。\n幡念不成秋后约，独游还与未来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋颖叔重山馆留题","author":"韦骧","text":"清诗题柱几朝曛，二十馀年伴岭云。\n今夜泥轮犹宿此，隔溪依旧磬声闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江墩铺","author":"韦骧","text":"郊原秋老湛无风，孤坐危亭夕照中。\n刈熟人归荷肩重，嘻嘻笑语话年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿泰宁县驿","author":"韦骧","text":"紞如五鼓响寒厅，夜艾东窗未肯明。\n一片滩声聒幽枕，几番归梦不能成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离建宁","author":"韦骧","text":"境穷昭武入长汀，溪侧山根指去程。\n护险栏干红缭绕，依稀如傍蜀江行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烂石","author":"韦骧","text":"嵌岩烂石耸溪湾，峻削陶人手不閒。\n落在深郊犹及此，斧斤何必叹牛山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿宁化县鹫峰寺","author":"韦骧","text":"轻轺冒雨势匆匆，晚入幽溪宿鹫峰。\n一夜泉声绕清榻，梦回何待晓来钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题龙地岩","author":"韦骧","text":"应龙何日跃天衢，不识还思旧隐无。\n见说至今遗惠在，每兴云雨救焦枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临汀行馆十月桃花盛开","author":"韦骧","text":"十月临汀气候讹，桃花零落发林阿。\n也知欲趁春风媚，争奈穷州地暖何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿宁化西隐院","author":"韦骧","text":"邮亭地远宿禅扃，夜永时寒睡思轻。\n檐溜不鸣知雨止，窗棂半白悟天明。\n更攒百点催兵从，鸡送三号起使程。\n自愧区区少禆补，北山文在盍留情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过鳞原驿","author":"韦骧","text":"晨餐才了又遄征，驿榜鳞原以地名。\n山顶寒多雪花重，溪湾流浅玉沙明。\n田畴有穫良农喜，社鼓无声暴客平。\n奉诏非材幸无事，行中时得肆吟情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"度烂溪","author":"韦骧","text":"独木为桥度烂溪，溪傍山石烂如泥。\n高低采削材如一，祗恐钧陶意不齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十二日早按行临汀遇大雷电而雨","author":"韦骧","text":"传车十月到长汀，郁奥犹如暑气生。\n经夕山川带云雾，凌晨雷雨动檐楹。\n乍逢旅客殊多怪，惯见邦人悄不惊。\n聊作小诗传所遇，他年稳坐活平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚洲岭","author":"韦骧","text":"行行晚洲岭，高若离人寰。\n肩舆薄层霄，身在杳霭间。\n朝天及青泥，谁谓蜀道难。\n岂如兹峻陟，不类羊肠盘。\n斗上五千尺，步步须跻攀。\n隆冬犹汗浃，睥睨唯心寒。\n旁沾宿云润，下视飞鸟閒。\n恍如陶公梦，插翼冲天关。\n潜慕汉忠臣，叱驭毋盘桓。\n古语固有之，酖毒比宴安。\n君恩思未报，何敢惮险艰。\n临风一长吟，所叹两鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师子峰","author":"韦骧","text":"欲将师子号奇峰，蹲踞如真倚碧空。\n闻说近山无虎啸，可非潜伏畏威风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双溪驿","author":"韦骧","text":"按程颇自觉淹留，朝夕经行处处幽。\n忻逢古驿双溪水，追忆东阳八咏楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阴山馆","author":"韦骧","text":"圜峰耸于前，鸣泉绕其背。\n若使画成图，谁云非傅会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游宝盖岩","author":"韦骧","text":"度溪履险得幽岩，欲去徘徊意尚贪。\n吏部祝融峰下句，未宜留此付镌镵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题馆节堂","author":"韦骧","text":"建阳溪水接仙流，溪上新堂气象幽。\n弭节柅轮从便适，观风问俗得优游。\n凌虚岌岌围千嶂，据要冲冲控八州。\n白发书生倦奔走，每怜潇洒为迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曹子方","author":"韦骧","text":"度溪踰岭一何劳，霜鬓鬅鬙首屡搔。\n自愧晚年空碌碌，唯逢佳境且陶陶。\n会仙古观风流远，馆节新堂气象豪。\n不得与君同啸傲，强抽荒思引吟毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韦骧","text":"佳和殊堪渴想劳，幅巾霜鬓遂忘搔。\n长言灿灿经三复，至乐融融共一陶。\n遇事未能全吏隐，解颐幸得接诗豪。\n愿前瓜代频酬唱，任秃秋蟾玉兔毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曹子方","author":"韦骧","text":"绕舍方怜喜鹊鸣，临风更听振金声。\n戆儿远宦趋庭过，善友新篇击钵成。\n荒学谩传乌足道，嘉辞借誉一何荣。\n凤毛池上他年贵，谦晦终难掩道耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子方赠祖夷仲提刑","author":"韦骧","text":"蓬莱为别几秋风，倅乘当年服徇公。\n梁汉曾嗟失高躅，瓯闽幸迟扩前功。\n税车白发相看喜，把酒黄堂一笑同。\n行见刑清八州境，里言应不咏垣东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至三日游水南诸寺","author":"韦骧","text":"曦轮飞上宿云收，晚出城南趣适幽。\n六寺连延行复道，一溪萦绕泻寒流。\n世情共喜新阳复，仙境聊成极目游。\n不以篇章记登览，此时清兴若为酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和公舒太守长至游水南僧寺","author":"韦骧","text":"纷华盛丽已心灰，蜡履寻山尚喜陪。\n聊藉琴樽乐清景，全胜车马冒黄埃。\n年登况毕三时务，阳复仍忻七日来。\n更爱启予传秀句，使君诗笔富天才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹子方","author":"韦骧","text":"判袂长亭岁律残，天寒云霭惨溪山。\n间关唯恐君兼道，寂寞仍愁我独还。\n秀句八州神物护，轻轺千里老人攀。\n他时企想音书外，伫听休声耸近班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其一 雷分石","author":"韦骧","text":"闻说丰隆为剖开，非关星陨自天来。\n数齐元凯峥嵘势，不是寻常作削材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其二 香炉峰","author":"韦骧","text":"由来元化作钧陶，赋象香炉峰势高。\n恰似羌庐山下见，不容太白独抽毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其三 天然桥","author":"韦骧","text":"欲渡银潢上九霄，回头云路正迢迢。\n谁知略彴由天造，全胜间关履鹊桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其四 玉印峰","author":"韦骧","text":"拂云苍翠势嵚崟，玉印分明带秀林。\n变化固非缘堕鹊，天将宝玩镇幽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其五 石鉴峰","author":"韦骧","text":"天悟迷人亦自然，团团石镜为高悬。\n潜令演若狂心止，忘照回情学坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其六 蛰龙潭","author":"韦骧","text":"蛰龙潭上木阴森，百丈垂丝未度深。\n蟠屈只应如傅说，俟时腾跃作商霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其七 放生池","author":"韦骧","text":"看收数罟买鲜鳞，纵在深池是亦仁。\n但使校人诚子产，自然微物遂天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其八 凤凰山","author":"韦骧","text":"凤凰山色似晴光，半入青云两翅张。\n谁谓太平宁有象，峰峦犹学瑞禽翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其九 锁翠屏","author":"韦骧","text":"屏名锁翠势弯环，境胜全疑出世间。\n枕石眠云乃其地，谁能先向此中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"护国院十咏 其十 仙茆峰","author":"韦骧","text":"饵茆仙去绝遗踪，屹屹孤峰倚碧空。\n空使时人想飙驭，寸心长惑有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]