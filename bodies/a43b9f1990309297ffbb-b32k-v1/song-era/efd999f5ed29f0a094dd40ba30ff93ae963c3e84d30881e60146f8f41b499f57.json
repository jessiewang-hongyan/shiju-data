[{"title":"晚游九曲院","author":"陈师道","text":"冷落丛祠晚，回斜狭路赊。\n平荷留夜雨，惊鸟过邻家。\n云暗重重树，风开旋旋花。\n病身无俗事，待得后归鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晦日","author":"陈师道","text":"人老时情薄，春深花意微。\n暄寒南北异，风俗古今违。\n即事无同异，旁观有是非。\n食蔬如许瘦，饱肉未须肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望夫石","author":"陈师道","text":"碛戍人何在，秋霜志不移。\n无言息妫怨，有泪舜娥悲。\n山静云盘髻，江空月印眉。\n谁将望远意，歌作送征诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"陈师道","text":"霜叶红于染，吹花落更馨。\n平江行诘曲，小径夹葱青。\n度鸟开愁眼，遥山入画屏。\n畏人惟可饮，从俗却须醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野望","author":"陈师道","text":"山开两岸柳，水绕数家村。\n地势倾崖口，风涛啮石根。\n平林霜著色，沙岸水留痕。\n剩寄还乡泣，难招去国魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者郊居","author":"陈师道","text":"高斋缭绕度双沟，老气轩昂盖九州。\n不谓江山开悒怏，正缘风味得淹留。\n招携好客供谈笑，拆补新诗拟献酬。\n小摘自锄稀菜甲，旁观虚作不堪忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"陈师道","text":"初雪已覆地，晚风仍积威。\n木鸣端自语，鸟起不成飞。\n寒巷闻惊犬，邻家有夜归。\n不无惭败絮，未易泣牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中寄魏衍","author":"陈师道","text":"薄薄初经眼，辉辉已映空。\n融泥还结冻，落木复沾丛。\n意在千山表，情生一念中。\n遥知吟榻上，不道絮因风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后","author":"陈师道","text":"送往开新雪又晴，故留腊白待春青。\n稍回杉色伸梅怨，并得朝看与夜听。\n已觉庭泥生鸟迹，遽修田事带朝星。\n暮年功力归持律，不是骚人故独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后黄楼寄负山居士","author":"陈师道","text":"林庐烟不起，城郭岁将穷。\n云日明松雪，溪山进晚风。\n人行图画里，鸟度醉吟中。\n不尽山阴兴，天留忆戴公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄无悔挽词四首 其四","author":"陈师道","text":"玉箸凝潮后，丝桐艺业馀。\n远涂憎早悟，旷度得中疏。\n子逝今何遽，吾生孰与居。\n岂无文士传，未有茂陵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄无悔挽词四首 其三","author":"陈师道","text":"志大期千里，身宜置一丘。\n英词真盖世，爽气已横秋。\n地要黄金骨，天成白玉楼。\n平生斲泥手，斤斧恐长休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄无悔挽词四首 其二","author":"陈师道","text":"骨秀神仙数，诗清雅颂才。\n识高悬日月，韵胜脱尘埃。\n去就堪同事，摧残尽一哀。\n了知天上去，不似世间来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄无悔挽词四首 其一","author":"陈师道","text":"敏慧仍江夏，风流更妙年。\n贫焚酒家券，病得里胥钱。\n精爽来鹰隼，清明泻涧瀍。\n无儿传素业，有泪彻黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄楼","author":"陈师道","text":"楼以风流胜，情缘贵贱移。\n屏亡老毕篆，市发大苏碑。\n更觉江山好，难忘父老思。\n只应千载后，览古胜当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜","author":"陈师道","text":"留滞常思动，艰虞却悔来。\n寒灯挑不燄，残火拨成灰。\n冻水滴还歇，风帘掩复开。\n孰知文有忌，情至自生哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜","author":"陈师道","text":"一夜风澎浪，中宵月脱云。\n到窗资少睡，远响倦多闻。\n星火远相乱，江山气不分。\n早鸡先得便，断雁屡鸣群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜","author":"陈师道","text":"闭户风将雨，通宵浪打头。\n若为中夕听，复作别时愁。\n宿雁鸣渔火，村舂急暗投。\n不应田二顷，能使寸心休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓目","author":"陈师道","text":"曲曲河回复，青青草接连。\n去帆风力满，来雁一声先。\n野旷低归鸟，江平进晚牵。\n望乡从此始，留眼未须穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬酬智叔三赐之辱兼戏杨理曹二首 其二","author":"陈师道","text":"险韵廋词费讨论，真持布鼓过雷门。\n更看九日台头句，未用三人月下樽。\n镜里黄花明白发，海边赤脚踏长鲲。\n从来相戒莫打鸭，可打鸳鸯最后孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬酬智叔三赐之辱兼戏杨理曹二首 其一","author":"陈师道","text":"龙争虎据竟成尘，只有青楼与白门。\n令宰才高先得句，使君情重数开樽。\n江山故国难留鹤，科斗荒池可著鲲。\n直使颔须浑作白，未应投镊愧诸孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"智宝院后楼怀胡元茂","author":"陈师道","text":"晚渡呼舟疾，寒城著雾深。\n昏鸥明鸟道，风叶乱霜林。\n久客登临目，中年怀旧心。\n犹须一长笛，领览自沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑雨","author":"陈师道","text":"密雨吹不断，贫居常闭门。\n东溟容有限，西极更能存。\n束湿炊悬釜，翻床补坏垣。\n倒身无著处，呵手不成温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游鹊山院","author":"陈师道","text":"积石横成岭，行杨密映门。\n人声隐林杪，僧舍绕云根。\n顿摄尘缘尽，方知象教尊。\n只应羊叔子，名字与山存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"陈师道","text":"湖上难为别，梅梢已著春。\n林喧乌啄啄，风过水鳞鳞。\n缘有三年尽，情无一日亲。\n白头厌奔走，何地与为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上晚归寄诗友 其三","author":"陈师道","text":"功名违壮志，戒律负前身。\n刘德长欺客，王融却笑人。\n残年增受岁，病眼怯逢春。\n杖屦知何向，知公未厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上晚归寄诗友 其一","author":"陈师道","text":"髭发难藏老，湖山稳寄身。\n却寻方外士，招作社中人。\n霜叶深于染，秋花晚自春。\n无人还有碍，诗卷莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上晚归寄诗友 其四","author":"陈师道","text":"红绿羞明眼，攲斜久病身。\n年龄不待命，湖海却留人。\n点滴花间露，新鲜柳上春。\n情怀将底用，诗外不须频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上晚归寄诗友 其二","author":"陈师道","text":"蓑笠宜多病，衣冠错致身。\n清愁偏待客，白发解禁人。\n江月深留雪，山梅探借春。\n兴从湖上发，诗为道人频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登寺山","author":"陈师道","text":"晴山堪著眼，别意不胜秋。\n小作三年别，聊为五斗谋。\n要须乘下泽，不待到壶头。\n预恐登临处，长思马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登快哉亭","author":"陈师道","text":"城与清江曲，泉流乱石间。\n夕阳初隐地，暮霭已依山。\n度鸟欲何向，奔云亦自闲。\n登临兴不尽，稚子故须还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登城楼","author":"陈师道","text":"城郭春容晚，因行可当游。\n飞来双蛱蝶，目尽一浮鸥。\n峡崄山将合，江平水却流。\n同来端兴尽，且为小迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登彭祖楼","author":"陈师道","text":"城上危楼江上城，风流千载擅佳名。\n水兼汴泗浮天阔，山入青齐焕眼明。\n乔木下泉馀故国，黄鹂白鸟解人情。\n须知壮士多秋思，不露文章世已惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登鹊山","author":"陈师道","text":"小试登山脚，今年不用扶。\n微微交济泺，历历数青徐。\n朴俗犹虞力，安流尚禹谟。\n终年聊一快，吾病失医卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登燕子楼","author":"陈师道","text":"绿暗连村柳，红明委地花。\n画梁初著燕，废沼已鸣蛙。\n鸥没轻春水，舟横著浅沙。\n相逢千岁语，犹说一枝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答王立之","author":"陈师道","text":"每逢无可语，暂阻即相求。\n解卷初增气，开怀得写忧。\n昏烟宜带雨，风树更添秋。\n绝唱犹多和，先衰怯后酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答田生","author":"陈师道","text":"酒亦有何好，人今不肯忘。\n苟无愁可解，何必醉为乡。\n剩欲论奇字，终能讳秘方。\n直饶肌骨秀，正要画眉长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答李簿","author":"陈师道","text":"老去才先尽，春来酒屡空。\n甘为耕钓手，畏作嗫嚅翁。\n与罪宁无说，言诗新有功。\n不堪须野鹜，似欲吐长虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答晁以道","author":"陈师道","text":"转走东南复帝城，故人相见眼偏明。\n十年作吏仍糊口，两地为邻阙寄声。\n冷眼尚堪看细字，白头宁复要时名。\n孰知范叔寒如此，未觉严公有故情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答寄魏衍","author":"陈师道","text":"往昔敦朋好，犹能作报书。\n老衰浑得懒，疏密略相如。\n名堕网中蝶，身随冰下鱼。\n填门车马客，左席为君虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答寇十一惠朱樱","author":"陈师道","text":"故人怜一老，辍食寄三山。\n厚味非贫具，先尝愧客闲。\n甘酸俱可口，衰白不宜颜。\n句妙那能继，情深未觉悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答颜生","author":"陈师道","text":"烦君临问我何堪，剩欲从君十日谈。\n老退不应称敏捷，颜苍宁复借红酣。\n世间公器毋多取，句里宗风却饱参。\n陋巷远孙还好学，未容光禄擅东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答颜生见寄","author":"陈师道","text":"阙然车马不闻音，行路艰危已备更。\n求舍问田真得计，临流据石有馀清。\n江山满目开新卷，韦杜诸人得细评。\n闲处著身容我老，忙中见记识君情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答魏衍惠朱樱","author":"陈师道","text":"开门先得故人书，稍喜提携起覆盂。\n得句有谁知我在，尝新此日赖吾徒。\n倾篮的皪沾朝露，出袖荧煌得宝珠。\n会荐瑛盘惊一坐，苋肠藜口未良图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舒御史太夫人挽辞","author":"陈师道","text":"回合江山秀，佳城去域中。\n佩环无晓日，蘋藻自春风。\n断发人何在，捐金事已空。\n遂移男子孝，更作直臣忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢赟阇梨见访","author":"陈师道","text":"好在谈经老上人，冲风踏雪到江滨。\n百篇出箧自新得，一钵随身依旧贫。\n终岁杜门逃俗士，为师设榻对脩筠。\n蒲团藜杖焚香坐，此意此时无点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楝花","author":"陈师道","text":"密叶已成荫，高花初著枝。\n幽香不自好，寒艳未多知。\n会见垂金弹，聊容折紫緌。\n粉身非所恨，犹复得闻思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简令由司理","author":"陈师道","text":"居连里巷室连甍，多谢能空凿壁生。\n幸有馀光子何损，岂无邻好我先倾。\n已知涉世蘧蘧梦，但欲求田俋俋耕。\n贫病久甘从弃置，宁堪更类汝南评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简杨安国","author":"陈师道","text":"侯门谁预识冯谖，岁晚宁知范叔寒。\n倾盖尚怜吾道在，立谈相信古人难。\n开怀磊落无城府，握手侵寻出肺肝。\n共许异时终此去，满冠尘土待君弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舅氏新斋","author":"陈师道","text":"堂因竹柏有，花与岁时阑。\n欲作终年计，长留别眼看。\n色侵杯酒重，子孰落声乾。\n只有林园主，相期耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人草","author":"陈师道","text":"幽草默通神，旧题虞美人。\n长言方度曲，应节若翻身。\n律吕声相召，云龙气自亲。\n无情犹感会，不独在君臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"触目","author":"陈师道","text":"溪响饥鱼食，川明柱影斜。\n惊禽穿密竹，噪鹊立浮查。\n谷暗山藏雨，林喧雀啅蛇。\n乡闾等行路，何向更为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬吕明父学士","author":"陈师道","text":"当日功名指顾收，一言悟主过千秋。\n去登霄汉如平地，归到云山尚黑头。\n解组行参莲社客，挥金坐揖醉乡侯。\n谢公不为苍生起，拥鼻重来可自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬应物见戏","author":"陈师道","text":"扣门赏竹任推排，兴尽归舟挽不回。\n平世山林成偃蹇，新年词句得参陪。\n醒心正赖挥毫疾，误笔仍须送喜来。\n书省不应烦乳媪，一时除目尽英才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬智叔见戏二首 其二","author":"陈师道","text":"雨花风叶未宜春，私柳官渠白下门。\n每度清溪嘲短发，时容使席近芳樽。\n雄蜂雌蝶元非偶，野马游尘不佐鲲。\n若许成功当封赏，请看子子与孙孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬智叔见戏二首 其一","author":"陈师道","text":"百念皆空习尚存，稍修香火踏空门。\n槌腰摩腹非春事，割爱投闲覆玉樽。\n白发情多犹可染，骖鸾兴尽却乘鲲。\n上界纷纷足官府，也容河鼓过天孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬智叔见赠","author":"陈师道","text":"老去斯文不更论，却因夫子话师门。\n清谈不待倾三语，胜日何知共一樽。\n逐北我方填坎井，图南谁得料鹏鲲。\n过逢为说侯芭在，卧楫生衣犊有孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颜市阻风二首 其二","author":"陈师道","text":"万古梁山泊，今年未掾船。\n阻风兼著雪，费日亦忘年。\n世事元相忤，衰怀忍自煎。\n晚来声更恶，始觉畏途边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颜市阻风二首 其一","author":"陈师道","text":"水到西流阔，风从北极来。\n声驱峡口坼，力拔岭根摧。\n突兀重重浪，轰豗处处雷。\n顺流看过舫，更著快帆催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠王聿脩商子常","author":"陈师道","text":"欲作新诗挑两公，含毫不下思先穷。\n贪逢大敌能无惧，彊画脩眉每未工。\n畏病忍狂妨痛饮，晚云朝雨滞晴空。\n正须好句留春住，可使风飘万点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠田从先","author":"陈师道","text":"衣冠鲁国动成群，忧患相从只有君。\n落笔如流宁蹈袭，行前应敌却纷纭。\n愧非伏老成和伯，喜有侯芭守子云。\n意气有馀功用少，相望千里定能勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠白阇梨","author":"陈师道","text":"瓶锡倦西东，归来一榻空。\n宗乘能自判，文学更兼通。\n讲彻夜堂月，定回枯树风。\n无从参净社，回首倦飞蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石先生","author":"陈师道","text":"多方作计老如期，百疾交攻遽得衰。\n晚有胜缘逢异士，生须快意阙前知。\n迫人鬓颔纷纷白，临事回迂种种迟。\n分我刀圭容不死，他年鹤驭得追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠欧阳叔弼学士","author":"陈师道","text":"早知汝颍多能事，晚以诗书托下寮。\n大府礼容宽懒慢，故家文物尚嫖姚。\n只将忧患供谈笑，敢望功名答圣朝。\n岁历四三仍此地，家馀五一见今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郑户部","author":"陈师道","text":"千载归来辽海东，江山如旧里闾空。\n时平未觉身难遇，学赡依然说不穷。\n著绣昼行真细事，下车磬折得深衷。\n圣朝未有徐州相，剩作功名跨数公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五言贺雨出","author":"陈师道","text":"六月鄞江旱，焦劳刺史忧。\n戴星趋洞府，踏月叩龙湫。\n引咎青章设，为坛古法修。\n山川将尔遍，牲币岂吾留。\n帝意兹回眷，神聪俯应求。\n油云潜感召，灵雨忽滂流。\n急势朝翻幕，寒声暮咽沟。\n馀波平浦屿，翠色蔽田畴。\n池阁消残暑，闾阎庆有秋。\n邦民无以谢，惟起载途讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同道士钱泠然寻涧水源","author":"陈师道","text":"晓领黄冠子，步寻东涧源。\n拖筇探清浅，垂手弄潺湲。\n岸阁残花片，槎留旧涨痕。\n凤潜丹穴邃，龙卧古潭浑。\n脩竹青垂荫，长萝翠可扪。\n忽惊穿药圃，不觉到云根。\n嶝外看飞鸟，崖边见饮猿。\n援琴写山水，布席坐兰荪。\n白石支棋局，青沙藉酒尊。\n醉歌归路稳，洞口月黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]