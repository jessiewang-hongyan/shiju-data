[{"title":"减字木兰花 子寿母","author":"陈克","text":"阆风玄圃。\n阳羡溪头山好处。\n郁郁葱葱。\n胜日尊罍笑语中。\n十分芳酒。\n鹤发初生千万寿。\n乐事年年。\n弟劝兄酬阿母前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 怀人","author":"陈克","text":"枕边清血。\n梦好离肠切。\n笑倚柳条同挽结。\n满眼河桥烟月。\n莺啼新晓璁珑。\n罗窗寂寞春空。\n只许梦魂相近，此生枉是相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲","author":"陈克","text":"宝瑟尘生郎去后。\n绿窗闲却春风手。\n浅色宫罗新染就。\n晴时后。\n裁缝细意花枝斗。\n象尺熏炉移永昼。\n粉香浥浥蔷薇透。\n晚景看来浑似旧。\n沈吟久。\n个侬争得知人瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其六","author":"陈克","text":"绿阴寂寂樱桃下。\n盆池劣照蔷薇架。\n帘影假山前。\n映阶红叶翻。\n芭蕉笼碧砌。\n猧子中庭睡。\n香径没人来。\n拂墙花又开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"陈克","text":"绿芜墙绕青苔院。\n中庭日淡芭蕉卷。\n蝴蝶上阶飞。\n烘帘自在垂。\n玉钩双语燕。\n宝甃杨花转。\n几处簸钱声。\n绿窗春睡轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"陈克","text":"池塘淡淡浮鸂鶒。\n杏花吹尽垂杨碧。\n天气度清明。\n小园新雨晴。\n绿窗描绣罢。\n笑语酴醾下。\n围坐赌青梅。\n困从双脸来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其五","author":"陈克","text":"柳条到地莺声滑。\n鸳鸯睡稳清沟阔。\n九曲转朱阑。\n花深人对闲。\n日长刀尺罢。\n试屐樱桃下。\n䰉髻玉钗风。\n云轻线脚红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"陈克","text":"柳条窣窣闲庭院。\n锦波绣浪春风转。\n红日上阑干。\n晚来花更寒。\n绿檀金隐起。\n翠被香烟里。\n幽恨有谁知。\n空梁落燕泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"陈克","text":"赤阑桥尽香街直，笼街细柳娇无力。\n金碧上青空，花晴帘影红。\n黄衫飞白马，日日青楼下。\n醉眼不逢人，午香吹暗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其一","author":"陈克","text":"花满院。\n飞去飞来双燕。\n红雨入帘寒不卷。\n晓屏山六扇。\n翠袖玉笙凄断。\n脉脉两娥愁浅。\n消息不知郎近远。\n一春长梦见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其六","author":"陈克","text":"罗帐薄。\n缥缈绮疏飞阁。\n红地团花金解络。\n香囊垂四角。\n尽日春风帘幕。\n谁见绿屏纤弱。\n云压枕函钗自落。\n无端春梦恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其五","author":"陈克","text":"春草碧。\n忆著去年寒食。\n白纻红裙香□□，折花闹调客。\n好在江南江北。\n燕子不传消息。\n醉眼腾腾羞面赤。\n断肠侬记得。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其八","author":"陈克","text":"春寂寂。\n绿暗溪南溪北。\n溪水沈沈天一色。\n鸟飞春树黑。\n肠断小楼吹笛，醉里看朱成碧。\n愁满眼前遮不得。\n可怜双鬓白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其二","author":"陈克","text":"柳丝碧。\n柳下人家寒食。\n莺语匆匆花寂寂。\n玉阶春藓湿。\n闲凭薰笼无力。\n心事有谁知得。\n檀炷绕窗灯背壁。\n画檐残雨滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门 其七","author":"陈克","text":"愁脉脉。\n目断江南江北。\n烟树重重芳信隔。\n小楼山几尺。\n细草孤云斜日。\n一向弄晴天色。\n帘外落花飞不得。\n东风无气力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"摊破浣溪沙/山花子","author":"陈克","text":"慢梳头浅画眉。\n乱莺残梦起多时。\n不道小庭花露湿，剪酴醾。\n帘额好风低燕子，窗油晴日打蜂儿。\n翠袖粉笺闲弄笔，写新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二","author":"陈克","text":"小山戢戢盆池浅。\n芳树阴阴转。\n红阑干上刺蔷薇。\n蝴蝶飞来飞去、两三枝。\n绣裙斜立腰肢困。\n翠黛萦新恨。\n风流踪迹使人猜。\n过了斗鸡时节、合归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其三","author":"陈克","text":"绿阴满院帘垂地。\n落絮萦香砌。\n池光不定药栏低。\n闲并一双鸂鶒、没人时。\n旧欢黯黯成幽梦。\n帐卷金泥重。\n日虹斜处暗尘飞。\n脉脉小窗孤枕、镜花移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一 张宰祈雨有感","author":"陈克","text":"踏车不用青裙女。\n日夜歌声苦。\n风流墨绶强跻攀。\n唤起潜蛟飞舞、破天悭。\n公庭休更重门掩。\n细听催诗点。\n一尊已咏北窗风。\n卧看雪儿纤手、剥莲蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 曹申甫以著色山水小景作短制，思极萧散，方倅袭明邀予为咏","author":"陈克","text":"越罗巧画春山叠。\n个里融香雪。\n满身空翠不胜寒。\n恰似那回偷印、小眉山。\n青骢油壁西陵下。\n仿佛当时话。\n而今眼底是高唐。\n拂拂淡云疏雨、断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"陈克","text":"禁瘆馀寒酒半醒。\n蒲萄力软被愁侵。\n鲤鱼不寄江南信，绿尽菖蒲春水深。\n疑梦断，怆离襟。\n重帘复幕静愔愔。\n赤阑干外梨花雨，还是去年寒食心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"陈克","text":"芳树阴阴脱晚红。\n馀香不断玉钗风。\n薄情夫婿花相似，一片西飞一片东。\n金翡翠，绣芙蓉。\n从教纤媚笑床空。\n揉蓝衫子休无赖，只与离人结短封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 阳羡竞渡","author":"陈克","text":"柳外东风不满旗。\n青裾白面出疏篱。\n㬠来打鼓侬吹笛，催送儿郎踏浪飞。\n倾两耳，斗双螭。\n家家春酒泻尖泥。\n侬今已是沧浪客，莫向尊前唱教池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 寄友人","author":"陈克","text":"白苎吴侬红颊儿。\n行歌半是使君诗。\n山茶处处春犹浅，灯市人人夜不归。\n拚剧饮，莫相违。\n皇恩往往下丹墀。\n挥毫却对莲花炬，忆著蘋洲秉烛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"陈克","text":"风露涓涓玉井莲，霓旌绛节会中元。\n鬓头未学功名晚，金紫由来称长年。\n青作穗，酒如泉。\n蓬莱方丈自飞仙。\n黄麻敕胜长生箓，早送夔龙到日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"陈克","text":"小市桥弯更向东。\n便门长记旧相逢。\n踏青会散秋千下，鬓影衣香怯晚风。\n悲往事，向孤鸿。\n断肠肠断旧情浓。\n梨花院落黄茅店，绣被春寒此夜同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延祥观","author":"陈兑","text":"两受君恩辞魏阙，重寻乡路入嘉州。\n延祥观是扬雄宅，好住玄门第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陈兵书","text":"山秀云成叶，江湍浪作花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七溪","author":"陈均","text":"为爱潺湲引步迟，不知行尽白云西。\n云深忘却来时路，吟断空山片月低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九江闻雁","author":"陈均","text":"烟波渺渺梦悠悠，家在江南海尽头。\n音信稀疏兄弟隔，一声新雁九江秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤林寺 其一","author":"陈均","text":"知有枫林坐竹间，每寻纡路试登山。\n虚檐忽见笼中鹤，似我爱閒身未閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼花图","author":"陈孚","text":"荒棘萋萋后土宫，芳根已逐彩云空。\n男儿别有扬州泪，不为琼花滴晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罗隐题诗石","author":"陈宋辅","text":"诗名鼎鼎号三罗，藜杖经从石上过。\n铁画银钩难辨认，雨霖日炙莫镌磨。\n幽泉添砚潺湲响，明月生波感慨多。\n小立西风吹鬓发，碧罗深处听渔歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙隐岩","author":"陈岘","text":"烟萝深锁非凡境，泉石相逢似故人。\n归认落花犹恐误，天风为我隔嚣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次鄂州","author":"陈岘","text":"蜀江来滚滚，楚望意悠悠。\n浩气高情晓，新寒带晚秋。\n关山方北顾，烟火又南楼。\n蓬鬓天涯客，萧然一叶舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中偶成","author":"陈岘","text":"雨声春不绝，绿涨与池平。\n久摘花犹好，新锄草又生。\n闭门惟我独，终日断人行。\n对酒还忧病，裁诗强遣情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡圃依绿亭","author":"陈岘","text":"修林平沼久荒埃，招领春风一笑回。\n扫净莓苔分径岸，剩添桃李结亭台。\n时因休吏文书了，忽作閒人杖屡来。\n待与邦人同醉乐，一樽何惜少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全州观风楼","author":"陈岘","text":"江源发蛮荒，来与湘灌遇。\n交流趋城隅，清映日东注。\n群山半楚越，驰骤若竞赴。\n谯门百步南，楼堞此雄踞。\n观风久标名，栋宇初改故。\n极目渺塞岭，蔚起矗云雾。\n千里耸翠碧，众水横练素。\n古寺带林薄，渔艇依野渡。\n村墟互隐见，风烟自朝暮。\n东西亘井络，棋分杂营戍。\n偶值丰登年，乐此保生聚。\n秋风黄花天，良集盛簪屦。\n肴觞固匪虔，藉此山水具。\n登临方兴深，诸君幸少驻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"全州砻岩","author":"陈岘","text":"泉流萦带戛冰玉，石壁深窈寒侵衣。\n开凿应劳造化力，窟宅如待灵仙归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮翁常之宅分韵得友字","author":"陈岘","text":"杖屦随春风，邂逅得良友。\n行行西域道，触目尽花柳。\n还步过茆茨，交欢亦何有。\n东邻颇好事，邀我意良厚。\n南窗竹风凉，更命新醅酒。\n一醉何足辞，期此百年久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿董山寺","author":"陈岘","text":"送客联镳归，得得招提宿。\n晚渡沧江口，路入青山曲。\n突兀忽在眼，一洗奔驰俗。\n然灯遽呼酒，僧留供野蔌。\n林高上明月，谈声响空谷。\n坐久夜益深，同来或鼾熟。\n明朝返城郭，此兴真可录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楚南伟观楼","author":"陈岘","text":"平生足迹穷遐陬，一麾更守湖湘州。\n西接悬崖五溪曲，南望渺极苍梧愁。\n天涯牢落孰慰意，千嶂倒影三江流。\n千里脉络兹要会，意趣端与江山投。\n群峰四绕立碧玉，带映林薄如雕锼。\n虬蟠虎骤互起伏，天作地涌非凡俦。\n郊村依约半洲渚，远明天际来归舟。\n湖南素号清绝地，一旦呈露疑神谋。\n作成英奇易旧观，俗化远与邹鲁侔。\n寄语后来无泯没，共保佳致传千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴五首 其五","author":"陈希声","text":"田园兴在晚春头，且说田蚕两事休。\n榆荚雨酣新水滑，楝花风软薄寒收。\n青枫蛾子催桑月，绿树鹂鹒报麦秋。\n但愿花村无吠犬，时呼薄酒背眠牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴五首 其四","author":"陈希声","text":"田园兴在半春天，春事关心夜不眠。\n护撒秧畦须拥水，辟栽蔬圃更堤川。\n青囊子粒乡风旧，翠箬灵芽社雨前。\n独立斜阳无限意，一声拨谷野桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴五首 其三","author":"陈希声","text":"田园兴在早春时，眼缬生红喜上眉。\n门巷日高人扫雪，池塘烟涨水流澌。\n杯柈新岁欢同社，灯火元宵闹古祠。\n野老告余春事及，夜来小雨过前陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴五首 其二","author":"陈希声","text":"犁锄遍野沸耕农，血吻鹃声一树红。\n畦矗秧针青剡剡，陇翻麦浪翠芃芃。\n鸡鸣昼寂花村雨，蛤吠朝寒草岸风。\n溪外云过横笛乱，微烟野色树茏葱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日田园杂兴五首 其一","author":"陈希声","text":"香红眩眼缬蕤英，竹杖扶吟纵步行。\n桑眼蟆含青蕾小，麦须虾磔翠芒轻。\n黄花菜圃午风软，绿水秧畦春野平。\n芳树几声鸠雨过，苍苍柳色弄烟晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和范公希文怀庆朔堂","author":"陈希亮","text":"弱柳奇花递间栽，红芳绿翠对时开。\n主人当日孤真赏，魂梦还应屡到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游钟山题八功德水庵壁 其二","author":"陈序","text":"十年尘土暗衣巾，乱走江乡一病身。\n西第将军成底事，北朝开府是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游钟山题八功德水庵壁 其一","author":"陈序","text":"寒骑瘦马度山腰，目断青溪第一桥。\n尽是帝王陵墓处，野风荒草暝萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游茅山和诸侄","author":"陈序","text":"山南细路半青霄，人昔共游非俗交。\n浮玉故乡惊上国，埋丹清梦记中茅。\n峰头仙客归黄鹄，石面灵根走翠蛟。\n见说西园浑草莽，手栽寸柏已胜巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"药市","author":"陈应斗","text":"肘后应难一一传，多将灵药种仙山。\n仙禽捣就仙翁卖，挑杖悬壶走世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈徐宪应特","author":"陈应龙","text":"弱冠弄笔砚，耻为章句儒。\n夜半剑气发，精光射天衢。\n欲分天子忧，张灯阅地图。\n七闽山水秀，我亦思故庐。\n世事苦龃龉，吾道宁踌蹰。\n一官如涕唾，焉能轻重吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青紫峰亭","author":"陈应辰","text":"铁壁嶙峋构小亭，潇然云栋接风棂。\n烟光横抹半峰紫，山色不磨千古青。\n老去久无金马梦，归迟应愧草堂灵。\n明经拾芥成何事，得似朝来对翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石刻诗","author":"陈抟","text":"我谓浮荣真是幻，醉来舍辔谒高公。\n因聆玄论冥冥理，转觉尘寰一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"华山","author":"陈抟","text":"半夜天香入岩谷，西风吹落岭头莲。\n空爱掌痕侵碧汉，无人曾叹巨灵仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞公岩","author":"陈抟","text":"万事若在手，百年聊称情。\n他时南岳去，记得此岩名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石水涧","author":"陈抟","text":"银河洒落翠光冷，一派回环湛晚晖。\n几恨却为顽石碍，琉璃滑处玉花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归隐","author":"陈抟","text":"十年踪迹走红尘，回首青山入梦频。\n紫陌纵荣争及睡，朱门虽贵不如贫。\n愁闻剑戟扶危主，闷见笙歌聒醉人。\n携取旧书归旧隐，野花啼鸟一般春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辞上归进诗","author":"陈抟","text":"草泽吾皇诏，图南抟姓陈。\n三峰千载客，四海一闲人。\n世态从来薄，诗情自得真。\n乞全獐鹿性，何处不称臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠金励睡诗 其二","author":"陈抟","text":"至人本无梦，其梦本游仙。\n真人本无睡，睡则浮云烟。\n炉里近为药，壶中别有天。\n欲知睡梦里，人间第一玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠金励睡诗 其一","author":"陈抟","text":"常人无所重，惟睡乃为重。\n举世皆为息，魂离神不动。\n觉来无所知，贪求心愈用。\n堪笑尘中人，不知梦是梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与毛女游","author":"陈抟","text":"药苗不满笥，又更上危颠。\n回指归去路，相将入翠烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日晚望","author":"陈抟","text":"山鬼煖或呼，溪鱼寒不跳。\n晚景愈堪观，危峰露残照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对御歌","author":"陈抟","text":"臣爱睡，臣爱睡。\n不卧毡，不盖被。\n片石枕头，蓑衣铺地。\n震雷掣电鬼神惊，臣当其时正酣睡。\n闲思张良，闷想范蠡。\n说甚孟德，休言刘备。\n三四君子只是争些闲气，争如臣向青山顶头。\n白云堆里，展开眉头。\n解放肚皮，但一觉睡。\n管什玉兔东升，红轮西坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西峰","author":"陈抟","text":"为爱西峰好，吟头尽日昂。\n岩花红作阵，溪水绿成行。\n几夜碍新月，半山无夕阳。\n寄言嘉遁客，此处是仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏毛女","author":"陈抟","text":"曾折松枝为宝栉，又编栗叶作罗襦。\n有时问著秦宫事，笑撚仙花望太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"陈抟","text":"华阴高处是吾宫，出即凌空跨晓风。\n台殿不将金锁闭，来时自有白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":16576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]