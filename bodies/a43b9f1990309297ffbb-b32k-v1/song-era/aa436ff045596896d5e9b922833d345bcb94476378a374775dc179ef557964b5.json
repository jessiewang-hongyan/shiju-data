[{"title":"宫词 其九十三","author":"王仲修","text":"探花时节按歌回，粉黛重匀傍照台。\n定是君王急宣召，忽然蟢子上头来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十六","author":"王仲修","text":"云罗雾縠晓风凉，绣幕黄龙绕画廊。\n宿雨乍收烟水静，曲池万柄绿荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五","author":"王仲修","text":"春风来自斗杓东，万物欣欣鼓舞中。\n凤纸催裁宽大诏，拂明宣下未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十九","author":"王仲修","text":"圣人夜宴蓬莱殿，星汉沉沉玉漏迟。\n楼角轻云捧新月，宫人笑指似蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十","author":"王仲修","text":"宜春苑里望春台，台下仙花已半开。\n地密无人敢偷折，万民喜待翠舆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十","author":"王仲修","text":"节纪天宁里社鸣，猗兰今日圣人生。\n如何表得千年瑞，万里黄河一带清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十九","author":"王仲修","text":"宫槐御柳绕池亭，水殿中间暑气清。\n珠网帘深尘不到，静闻燕子引雏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十九","author":"王仲修","text":"蕊珠宫殿俯烟霞，宣政门开立正衙。\n刚日小王封大国，玉堂学士进新麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十九","author":"王仲修","text":"玉箫声里酌玻璃，风腊旌旗卷绛霓。\n星渚月斜珠露重，银河流水亦东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十一","author":"王仲修","text":"地雷设象圣言昭，上应星辰转玉杓。\n阳管气升君道正，忠贤类进小人消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十三","author":"王仲修","text":"邻院相招象戏归，和衣卧到日平西。\n起来理遍琵琶谱，花底春莺向晚啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十","author":"王仲修","text":"殿阁新秋气象清，玉阶露冷半彫蓂。\n六宫最重中元节，院院烧香读道经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十","author":"王仲修","text":"西池曼衍鱼龙戏，燕罢回銮近夕阳。\n路远不乘双凤辇，玉鞍珠辔御龙骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十五","author":"王仲修","text":"囹圄空虚入颂歌，雪霜风雨四时和。\n君王德惠施天下，甘露偏于柳上多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十五","author":"王仲修","text":"四辅论思政事堂，尽收才杰置周行。\n掖庭职事分司局，铨择皆由紫极房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十四","author":"王仲修","text":"瑶池初见一枝梅，为爱清香特地栽。\n今日御栏风露好，胜如山路雪中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十九","author":"王仲修","text":"天子观渔陋鲁棠，涵曦亭下似沧浪。\n金鳞钓得龙颜喜，韶乐声中进玉觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十二","author":"王仲修","text":"太平祥瑞符君德，鹤兔芝禾月不虚。\n玉检金绳旧仪在，不知谁献长卿书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十二","author":"王仲修","text":"瑟瑟西风下建章，御栏无限菊花香。\n天心亦爱黄金蕊，故遣轻云护早霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十三","author":"王仲修","text":"重城放钥玉签疏，四百银袍拜殿除。\n白日禹门三级浪，一声雷雨化鲲鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十八","author":"王仲修","text":"长生殿里更阑后，乞巧楼前月上时。\n河汉玉梯三十六，不知谁见画蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十","author":"王仲修","text":"宰臣出省午漏下，卫士交番未刻深。\n续报六宫无事后，龙墀初月夜沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十九","author":"王仲修","text":"楼台雪霁晓阴阴，珠网屏风御幄深。\n和气先春宫掖暖，凤钗不用辟寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十二","author":"王仲修","text":"太平无事似熙丰，天乐声和下帝宫。\n禽鸟也能知乐事，宫莺娇醉弄春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十七","author":"王仲修","text":"六曲屏风倚殿帷，君王几度欲题诗。\n却宣学士书无逸，又赐沉香笔数枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十四","author":"王仲修","text":"访古搜奇得汉馀，有名书画世间无。\n紫宸朝退捐声色，不看骊山按乐图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十六","author":"王仲修","text":"迩英新殿在西厢，圣代隆儒过汉唐。\n讲罢赐茶班退后，槐盘龙影下修廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十","author":"王仲修","text":"吾君圣学自通神，匪但书看逸少亲。\n妙绝长江春色丽，一时同赐紫枢臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十八","author":"王仲修","text":"太平气象满皇图，清晓祥烟捧帝居。\n四海销兵民乐业，熙然恩信及豚鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七","author":"王仲修","text":"冒腊交春日向迟，雪残鳷鹊已多时。\n宫桃红小匀丹脸，御柳黄深展翠眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十二","author":"王仲修","text":"公卿拜舞进流霞，瑞气祥烟动日华。\n殿下排场如绵绣，紫云楼畔万株花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十七","author":"王仲修","text":"大晟修成六律新，铿锵雅韵格三灵。\n殿前九奏人心悦，定有来仪凤舞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十八","author":"王仲修","text":"陇山鹦鹉羽毛鲜，养在金笼已数年。\n应为能言人爱惜，教成御制鹤冲天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十五","author":"王仲修","text":"良家选入侍仙都，性慧从来爱读书。\n记得茂陵封禅事，满宫呼作女相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十六","author":"王仲修","text":"卷幕风来满殿凉，晖晖红日上回廊。\n郢坊初进酴醾酒，别是人间一种香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十五","author":"王仲修","text":"飘浮瑞雪洒长空，混合乾坤万象同。\n殿阁嶙峋如叠玉，凌晨人步广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十四","author":"王仲修","text":"十二珠帘上玉钩，一声鸡唱下重楼。\n南郊渐近天和暖，选日司衣进大裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十七","author":"王仲修","text":"暴衣楼上清秋夜，河鼓星临十二城。\n银汉无梁不可渡，牵牛织女若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十二","author":"王仲修","text":"天星东壁夜辉辉，文物声明过昔时。\n人说宫中女学士，和成御制上元诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十四","author":"王仲修","text":"谁向缑仙学玉笙，紫筠管密制新成。\n绮窗人静月明夜，能作箫台九凤声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十五","author":"王仲修","text":"春深百卉过芬芳，雕槛惟馀芍药香。\n应是东君偏着意，日华浮动御衣黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三","author":"王仲修","text":"元夜笙歌满上都，九霄皓月舞蟾蜍。\n烛龙穿仗来天际，万叠黄云覆帝车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四","author":"王仲修","text":"玉钺光华引六虬，天街万烛拥宸游。\n端门五夜开黄幄，月在蓬山顶上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十九","author":"王仲修","text":"帘垂珠阁对遥津，燕罢芳菲已半春。\n四部笙歌初散后，花前红烛引妃嫔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十四","author":"王仲修","text":"二月琼林花未开，风烟幂幂锁楼台。\n湿红生绿谁装点，直待春深圣驾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十七","author":"王仲修","text":"尧舜慈仁性自然，爱民如子食为天。\n都门瑞雪深盈尺，彤管应书大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五十三","author":"王仲修","text":"房星烨烨照明堂，陟配神皇咏我将。\n怵惕孝思霜露感，如山降福自穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二","author":"王仲修","text":"前殿风传万岁声，九重歌管乐升平。\n欲知庆事丛元日，瑞气先从帝鼐生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十六","author":"王仲修","text":"自补仙韶从帝游，镇随歌舞不知愁。\n新霜太液雁初下，岸柳萧疏又见秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词","author":"王仲修","text":"红日初生捧殿高，葱葱佳气拂云袍。\n今朝驾幸化成殿，先对东风赏小桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四十六","author":"王仲修","text":"时和岁稔似熙丰，腊月仙京大雪中。\n殿阁园林都瑩彻，云河不是水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十六","author":"王仲修","text":"玲珑翠网隔尘埃，鉴里双鸾挂宝台。\n睡起日高花影转，玉盘香篆半成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"王仲修","text":"乞麾占得山川胜，金纽新提左顾龟。\n苍阙斗龙辞日下，红旌引骑照江湄。\n剡溪月午何妨醉，曲水春馀好赋诗。\n玉案天香携满袖，锦衣谁似过乡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十一","author":"王仲修","text":"圣人独看临轩陛，殿后双龙捧翠华。\n明日集英排大宴，御前先降出琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十七","author":"王仲修","text":"柳絮飘零春事稀，绿荫零乱上瑶墀。\n好花着子青如豆，却忆香红满槛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十二","author":"王仲修","text":"晓风薄薄透罗衣，桃李芬芳长旧围。\n雨过御沟春水满，小滩风月漱珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八","author":"王仲修","text":"万户千门入建章，金绳界路柳丝黄。\n和风偏度乐声细，晴日自随宫线长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十","author":"王仲修","text":"画栋宵寒燕未来，江南谁寄一枝梅。\n闰年雪后春工晚，羯鼓催花满槛开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十一","author":"王仲修","text":"乘舆前殿退朝初，玉案焚香午漏馀。\n三省奏来祥瑞事，编排付与内尚书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十七","author":"王仲修","text":"绿槐疏影满花砖，首夏清和未暑天。\n进食门前金合人，唐装宫女听传宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归去词","author":"王仲素","text":"种松雨濯发，折笋春堕指。\n长啸归去来，沧江一天水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题虎丘次蒲章二公韵 其一","author":"王仲敏","text":"松阴岚影翠回环，尽在墙垣缭绕间。\n舟楫更无通别浦，烟霞曾不接他山。\n诗亡石在云徒恨，剑去池荒水自闲。\n偷得公馀来一饷，遥城钟鼓出催还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题虎丘次蒲章二公韵 其二","author":"王仲敏","text":"匆匆乘诏解行舟，早晚重来此地游。\n今日湖山诗似杜，当年庠序学如丘。\n烟波初入朝宗浦，风月还思望海楼。\n红旆碧幢留不住，空馀遗爱在南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王仲敏","text":"诨语销忠骨鲠亡，此中空奏忒郎当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过董叔达故居","author":"王休","text":"短石拂荒阡，诵君孝行全。\n甘泉潜易地，至德上通天。\n明诏再三下，承欢八十年。\n草堂遗址在，溪水绕涓涓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游普济寺","author":"王休","text":"排险凌空入磴斜，参差金碧倚烟霞。\n一山门里分三刹，万柳湖边带几家。\n世上无人吞栗棘，国中有佛吐莲花。\n凭栏凝望遥天表，数点青山似乱鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居","author":"王先莘","text":"斗室依山曲，如巢伴鹤栖。\n风鸣窗纸破，雨湿爨烟低。\n古致岩松外，秋声野竹西。\n潺湲听涧响，流不出横溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵范公游云门","author":"王冲","text":"高蹑五云堆，平看万象开。\n樵风溪路远，华雨梵天来。\n刹倚三峰直，钟传万壑回。\n叨陪上方燕，依约近中台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"续寄一章","author":"王冲","text":"骀荡青郊祓禊辰，东池冠盖集嘉宾。\n逍遥共入华胥国，绰约谁逢洛浦神。\n展障露花长乐际，袍敧烟草曲江滨。\n遥知台旆行春暇，起作元钧辅弼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈彦臣连静女案判词","author":"王刚中","text":"佳人才子两相宣，置福端由祸所基。\n永作夫妻谐汝愿，不劳钻穴隙相窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弥牟镇孔明八阵图","author":"王刚中","text":"我稽八阵图，规模载方册。\n朅来镇西蜀，夔门观叠石。\n赋诗有数字，字字究来历。\n进涉汉州西，弥牟镇之北。\n平原列堆阜，滩石同一式。\n细思作者意，孔明有深策。\n高岸或为谷，滩石存遗迹。\n江海变桑田，平原犹可觅。\n故今两处存，千载必一得。\n再歌遂成篇，当有智者识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滩石八阵图行","author":"王刚中","text":"我生孔明后，相望九百载。\n我想孔明贤，巍然伊吕配。\n奇谋勇略誇雄师，大节英风盖当代。\n木牛流马何足言，八阵遗踪千古在。\n我行已度瞿唐门，长滩石垒差参分。\n洪纤高下尺寸等，犹有当年节制存。\n四头八尾触处首，敌冲中央两皆救。\n握奇如枢运无穷，七纵七擒仍敢攻。\n规模黄帝已垂文，后来得者惟将军。\n唐宗李靖拾遗意，乐舞幡表徒缤纷。\n长江之上石蟠结，江波汹涌石不灭。\n使君何事遽刬除，一夜风雷吼天阙。\n明朝仍旧石纵横，神物护持人已惊。\n向来守蜀用此法，谁知石垒真金城。\n嗟乎孔明遇不遇，遇则刘公恢大度。\n国险地狭民力微，法出万全势未具。\n嗟乎孔明以此用于吴，长江内固魏可图。\n嗟乎孔明以此用于魏，扫平三分归一彗。\n祇应所遇势不同，势既不同功亦异。\n嗟乎孔明之心如石坚，欲扶汉室还中原。\n事之不就则天耳，安肯俯首从曹袁。\n嗟乎孔明如生石不老，后世用兵无草草。\n忽然变作六花看，便失本真难按考。\n请观叠石韬机筹，江流东去自悠悠。\n英豪得此石外指，长与君王靖边垒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游琅琊山呈锐公长老","author":"王吉","text":"踏石披云一径通，翠微环合见禅宫。\n峰峦郁密泉声上，楼殿参差树色中。\n午夜千溪分水月，清秋十里韵松风。\n平生久得名山约，吟赏今才信宿同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与月船周君话别 其一","author":"王同祖","text":"明日须知子遂行，一灯对语过三更。\n离魂已逐歌声断，清梦空随夜雨生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]