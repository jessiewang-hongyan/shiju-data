[{"title":"和诸庵花光十梅颂 其四","author":"王柏","text":"不问东风来未，冷冰冰中得意。\n谁于笔外相知，更有无味之味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其九","author":"王柏","text":"几度落花流水，何待空枝方省。\n要须投笔虚空，幻习与之俱尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其十","author":"王柏","text":"推出突栾本相，雨肥叶底清黄。\n熟后何曾酸涩，舌根自不寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其六","author":"王柏","text":"江头千树纷纷，纸上不堪狼藉。\n翻思洞口风流，忽见半梢横出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其二","author":"王柏","text":"孤山树槁神枯，一段底死工夫。\n脉脉不知机转，忽然嘴眼皆苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其七","author":"王柏","text":"孤标向背从地，枝头各自精彩。\n堂堂妙用纵横，谁识笔根所在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其三","author":"王柏","text":"空里翻身透出，风前玉立精神。\n百草头边未觉，还他独占先春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其一","author":"王柏","text":"一笔划断寒崖，疏蕊数枝低亚。\n不待雪压霜摧，已自全体放下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和诸庵花光十梅颂 其八","author":"王柏","text":"大化元无拣择，墨光随手高低。\n但得岁寒风度，自然处处皆宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 题泽翁梅轴后","author":"王柏","text":"今岁腊前，苦无多寒色、梅花先白。\n可惜横斜清浅处，谁访孤山仙客。\n玉勒寻芳，金尊护冷，定与心期隔。\n夜阑人悄，可无一段春月。\n怕它香已飘零，罗浮梦断，不与东君接。\n买得鹅湖千幅绢，留取天然标格。\n树老梢癯，蕊圆须健，不放风骚歇。\n花光何处，儿孙声价方彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游东禅院","author":"王某","text":"曲曲青溪叠叠山，石门深处有禅关。\n我心自得閒滋味，坐听风口尽日还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白水山","author":"王栐","text":"高空重素练，界断碧山纹。\n雪浪冲天下，风涛带雾分。\n乌尖峰顶水，驴迹岭头云。\n几欲乘槎访，星河没夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭","author":"王毖","text":"长桥千步截江洄，虹影随波綵翠开。\n谁与上皇传信息，定从此路入蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九月二十日游桃源寺","author":"王洋","text":"东溪缭绕黄花国，西崦纵横白酒家。\n谁道桃源解迷路，与君平步到烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上谹父郎中二首 其二","author":"王洋","text":"湘江又见承明客，青嶂谁刊岳麓诗。\n双旆到时鸿雁少，洞庭春水照旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上谹父郎中二首 其一","author":"王洋","text":"堂前双石瞻金印，砌下孤峰记好诗。\n春入瓮醅誇曲糵，雪浮盏面压枪旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下云居至瑶田戏赠圆老","author":"王洋","text":"山在云中人在山，人居山与白云闲。\n也须认得瑶田路，方见青云一望间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大明老僧年七十五日诵法华一部","author":"王洋","text":"自怜双目眯尘沙，老欲依僧半在家。\n世上何人销永日，如君七轴妙莲华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广孝寺","author":"王洋","text":"前朝缔结梵王宫，秘咒长因乞岁丰。\n隆报自惟追广孝，修除真可效臣忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弋阳道中题丫头岩","author":"王洋","text":"昭君村里千年恨，神女峰前一梦成。\n不谓此州无美艳，只嫌名字太粗生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予寓家龟溪赋廪郡故事郡将始至及其将行皆一奉谒予非异人也不敢异众故自壬戌三月至癸亥暮春计裁一年往来三宿何山寺退而自笑复自怜也质明将发纵观殿藏奥曲睹慧枢二士经营成立之迹私有感焉因赋二绝 其二","author":"王洋","text":"房湢斋庖间翠铺，环山环水绿云扶。\n不知几许中人产，支慧居前后阿枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予寓家龟溪赋廪郡故事郡将始至及其将行皆一奉谒予非异人也不敢异众故自壬戌三月至癸亥暮春计裁一年往来三宿何山寺退而自笑复自怜也质明将发纵观殿藏奥曲睹慧枢二士经营成立之迹私有感焉因赋二绝 其一","author":"王洋","text":"官供粥饭是官身，一岁三逢陌上春。\n应有得闲人笑我，苦因何事去来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老峰","author":"王洋","text":"小年那得此风流，老子登临兴未休。\n恨石尚分三敌国，仙翁合列五诸侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以芋易酒于应求","author":"王洋","text":"岷田到死无饥苦，软饱三杯醒又饥。\n我忍空肠谋换酒，为嫌惶恨没休时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以纸衾寄叔飞代简","author":"王洋","text":"我有江南素茧衣，中宵造化解潜移。\n隆冬必可独不死，分向苕溪雪闇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以豆豉送谹父","author":"王洋","text":"吴楚家山一水分，金山僧饭饱知闻。\n莼丝煮菜无消息，盐豉聊供旧使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗问谹父病五首 其五","author":"王洋","text":"不与红尘费梦思，白云流水有心期。\n吟君细与鸥盟句，病起全胜未病时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗问谹父病五首 其四","author":"王洋","text":"满目溪山醉复醒，虚怀长羡少经营。\n相如病起忘消渴，一任沱江过锦城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗问谹父病五首 其三","author":"王洋","text":"闲门岁满常驱迫，事外那容免剥肤。\n为问赤城香火客，不知还欠药钱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗问谹父病五首 其二","author":"王洋","text":"病为世上真良药，佛是人间大道师。\n十八师兄齐饱后，却言无病可医治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗问谹父病五首 其一","author":"王洋","text":"舍南舍北逢秋雨，十日相望不出门。\n闻自新凉罢汤熨，秖今含哺弄儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以前韵再继五绝 其五","author":"王洋","text":"春风待看百花奔，旧事知谁可共论。\n颜色不曾追俗好，从他蜂蝶自劳魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以前韵再继五绝 其二","author":"王洋","text":"老眼非悭不爱花，惯逢开谢不须嗟。\n君看桃李成阴后，也自能回长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以前韵再继五绝 其三","author":"王洋","text":"风流比拟谈何易，未省尔曹堪作吏。\n曾闻一颂了刘伶，湖上七篇传盛事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以前韵再继五绝 其一","author":"王洋","text":"夜发前村君莫惜，晓与天花比真色。\n争先不是压群芳，秖恐群芳心自息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以酒饷谹父蒙以绝句为谢因次韵并叙送行之意时欲往吴中二首 其二","author":"王洋","text":"诗满花笺酒满杯，吴中应喜使君来。\n马蹄归踏青霜滑，早趁江梅次第开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以酒饷谹父蒙以绝句为谢因次韵并叙送行之意时欲往吴中二首 其一","author":"王