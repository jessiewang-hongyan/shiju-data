[{"title":"凤栖梧/蝶恋花 其五 丁宅二侍儿","author":"张纲","text":"缓带垂红双侍女。\n彩凤衔来，秀色生庭户。\n转蕙光风香暗度。\n回眸绰约神仙侣。\n寡和清歌声激楚。\n夜饮厌厌，劝我杯频举。\n只恐酒阑催暮雨。\n凭谁约断阳台路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花 其四 癸未生日","author":"张纲","text":"老去光阴惊掣电。\n生长元丰，试数今谁健。\n多谢天公怜岁晚。\n清时乞得身闲散。\n忆昔生朝叨睿眷。\n台馈颁恩，内酒当筵劝。\n今日衰残欢意鲜。\n举杯目断尧天远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花 其二 安人生日","author":"张纲","text":"雨洗轩庭迎晚照。\n黄菊才芳，未觉秋光老。\n怪底烘堂添语笑。\n姮娥此夜来蓬岛。\n献寿新词谁解道。\n满眼儿孙，著语皆争巧。\n潋滟金杯休惜釂。\n追欢不怕霜天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 梅柳","author":"张纲","text":"梅柳约东风，迎腊暗传消息。\n粉面翠眉偷笑，似欣逢佳客。\n晚来歌管破馀寒，沈烟袅轻碧。\n老去不禁卮酒，奈尊前春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 和吕丞送进士赴省","author":"张纲","text":"宝津楼下柳阴重。\n画桥东。\n戏鱼龙。\n闻喜当时，开宴盛仪容。\n遥想新年寻故事，扶醉帽，夕阳中。\n可怜衰鬓飒霜丛。\n借酡红。\n遣愁浓。\n梦入长安，惊起送飞鸿。\n直下青冥休避路，九万里，看抟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 壬午生日","author":"张纲","text":"易老方惊岁晚，难禁又报生朝。\n从他华发转萧萧。\n且共尊前一笑。\n为具随宜饾饤，烘堂不用笙箫。\n只烦欢伯散无憀。\n醉里追回年少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二 次韵李公显木樨","author":"张纲","text":"多情宋玉，值西风摇落，悲秋时节。\n赖有幽芳深解意，的皪枝头争发。\n欲语含羞，敛容微笑，心事如何说。\n暗香时度，卷帘留伴霜月。\n谁为赋写仙姿，挥毫落纸，有尊前词客。\n独倚阑干须信道，消得孤吟愁绝。\n补阙骚经，拾遗香传，顿许居前列。\n品题多谢，一枝当为君折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其一 次韵张仲远，是日醉甚，逃席","author":"张纲","text":"论思厌久，动莼鲈清兴，轻辞丹极。\n佩玉腰金归故里，光照湖山秋色。\n八座仪刑，九重尊宠，才大今词伯。\n汉家豪俊，一时谁是勍敌。\n三径旧日家声，华堂深稳处，频开瑶席。\n春在壶中真自有，一境珠宫仙掖。\n谭麈挥风，罚筹如猬，数因尊前客。\n故应元放，举杯狂醉轻掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青门饮 京师送王敏求归乡","author":"张纲","text":"疏柳飘零，暮鸦寒集，都门送客，斜阳影里。\n野色沈沈，翠微隐隐，遥指故乡云外。\n聚久交情厚，对西风、争忍分袂。\n饮散宾朋，画船去也，平芜千里。\n因记。\n小轩无寐。\n观夜月凭阑，共论深契。\n绛帐清闲，杏坛优暇，当念宴游同醉。\n南北烟波远，愿无忘、音书频寄。\n未知名宦拘人，异日相逢何地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一 次韵陈少阳重九","author":"张纲","text":"绿蚁浮觞香泛泛，黄花共荐芳辰。\n清霜天宇净无尘。\n登高宜有赋，拈笔戏成文。\n可奈园林摇落尽，悲秋意与谁论。\n眼中相识几番新。\n龙山高会处，落帽定何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二 坚生日","author":"张纲","text":"追想京都全盛日，蓬弧初记生时。\n朝来朱绂照庭闱。\n谁知衰谢老，还有宁馨儿。\n休记蓝田生美玉，举杯听取歌词。\n年方强仕未应迟。\n高风轻借便，一鹗看横飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 荣国生日二首 其二","author":"张纲","text":"罗幕重重，画堂迎腊和风转。\n玳筵高展。\n知是群仙宴。\n银鸭香浮，红袖翻歌扇。\n金杯劝。\n深深祝愿。\n争把蟠桃献。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 荣国生日二首 其一","author":"张纲","text":"飞雪初晴，晓来佳气生庭户。\n宝薰笼雾。\n帘幕香风度。\n鹤发龟龄，堂上潘舆驻。\n花深处。\n缓歌金缕。\n莫惜杯频举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四 安人生日","author":"张纲","text":"过隙光阴还自催。\n生朝又送一年来。\n宴堂深处强追陪。\n眼眩岂堪花里笑，眉攒聊向酒边开。\n与君同醉莫辞杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 荣国生日四首 其二","author":"张纲","text":"腊日银罂翠管新。\n潘舆迎腊庆生辰。\n卷帘花簇锦堂春。\n百和宝薰笼瑞雾，一声珠唱驻行云。\n流霞深劝莫辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 荣国生日四首 其一","author":"张纲","text":"罗绮争春拥画堂。\n翠帷深处按笙簧。\n宝奁频炷郁沈香。\n海上蟠桃元未老，月中仙桂看馀芳。\n何须龟鹤颂年长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 荣国生日四首 其三","author":"张纲","text":"象服华年两鬓青。\n喜逢生日是嘉平。\n何妨开宴雪初晴。\n酒劝十分金凿落，舞催三叠玉娉婷。\n满堂欢笑祝椿龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 安人生日","author":"张纲","text":"思堂醇酎。\n满酌金杯争献寿。\n记取年时。\n头白成双唱旧词。\n莫言秋晚。\n五日小春黄菊绽。\n折一枝来。\n纶诰金花要并开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜分飞 次韵丁希闵","author":"张纲","text":"年少春心花里转。\n只恐飞花片片。\n沈醉归深院。\n妓衣何用令高卷。\n要看梁州初入遍。\n放出楼中舞燕。\n有眼何曾见。\n看来未足重开宴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 上元","author":"张纲","text":"红莲照晚。\n花底明人眼。\n无限游人谁惜倦。\n只有衰翁心懒。\n笙歌缓引更筹。\n更阑客散添愁。\n香雾半窗幽梦，烟波千里归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿头鸭/多丽 其一 次韵王伯寿","author":"张纲","text":"敛晴烟。\n桂花如水轻寒。\n宴中秋、朋簪来会，满筵绿鬓朱颜。\n罄尊罍、兴吞海量，妙歌吹、声彻云端。\n独念衰残，强陪欢笑，恍然感旧觉悲酸。\n功名志，黄粱晓梦，老去奈何天。\n休追悔，天应教人，赢取身闲。\n想姮娥、情郎如旧，也须知我贪欢。\n奈潘鬓、霜蓬渐满，况沈腰、革带频宽。\n月有重圆，人谁长健，一回相见一回难。\n王夫子，看君风度，何不早弹冠。\n莫学我，年年对月，扶病江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿头鸭/多丽 其二 次韵陈季明","author":"张纲","text":"爱家山。\n坐来心与云闲。\n念平生、功名有志，暮年多病知难。\n眷簪缨、未容引去，奈猿鹤、久已催还。\n松菊关情，莼鲈引兴，昔人高韵照尘寰。\n细追想，山林钟鼎，从古罕兼全。\n归来好，皇恩赐可，拂袖欣然。\n望西清、犹叨法从，梦魂宁隔台躔。\n莳七松、便为小隐，开三径、且乐馀年。\n宾友相过，鸡豚为具，从容聊作饮中仙。\n君试听，阳春佳阕，今日恰新传。\n休辞酒，从教醉舞，踏碎花毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 上元","author":"张纲","text":"重帘卷尽楼台日。\n华灯万点欢声入。\n老病莫凭阑。\n一城星斗寒。\n艳妆翻舞雪。\n目眩红生缬。\n不是故无情。\n羞君双鬓青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 上元","author":"张纲","text":"南山只与溪桥隔。\n年来厌著寻山屐。\n卧对曲屏风。\n淡烟疏雨中。\n功成投老去。\n拚作林塘主。\n万事不关心。\n酒杯红浪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一 安人生日","author":"张纲","text":"年时生日宴高堂。\n欢笑拥炉香。\n今日山前停棹，也须随分飞觞。\n东阳太守，携家远去，方溯桐江。\n把酒祝君长健，相随归老吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二 前年十二月十八日入对，遂除吏侍。今在婺州，腊月十八日也","author":"张纲","text":"前年初对大明宫。\n寒律转春风。\n几度乡关归梦，催成两鬓霜蓬。\n山州岁晚，还逢令节，空记前踪。\n莫遣酒兵相向，愁城生怕频攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其三 腊日","author":"张纲","text":"休惊初腊冻全消。\n旬日是春朝。\n梅吐芳心半笑，柳含青眼相撩。\n风光如许，那知太守，老去无聊。\n乘兴方思把盏，归心已逐轻桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 休官","author":"张纲","text":"解组盛明时，角巾东路。\n家在深村更深处。\n扫开三径，坐看一川烟雨。\n故山休笑我，来何暮。\n苦贪富贵，多忧多虑。\n百岁光阴能几许。\n醉乡日月，莫问人间寒暑。\n兴来随短棹，过南浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一 生日","author":"张纲","text":"十月风光，小春时候，宴堂初启朱筵。\n博山云润，风细袅晴烟。\n坐有文章公子，争吟唱、诗满花笺。\n帘帷里，时闻笑语，今日间生贤。\n郎潜。\n虽未贵，虚名自有，清议推先。\n更那堪、高堂重庆兼全。\n占取人间乐事，何必羡、玉带貂蝉。\n飞觞处，深深更祝，龟鹤永齐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二 荣国生日","author":"张纲","text":"风轧云低，寒催腊近，画堂和气先春。\n玳筵初启，佳会庆生辰。\n漏转高张宝炬，重帘邃、深炷炉薰。\n欢声里，清歌闲发，一曲绕梁尘。\n慈闱，春不老，山河象服，恩被丝纶。\n占人间荣贵，兰玉诜诜。\n便好金尊尽醉，殷勤劝、须满十分。\n深深愿，斑衣拜舞，千岁奉灵椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 其六 甲辰生日","author":"张纲","text":"小窗开宴，草草杯盘具。\n欢喜走儿童，庆生朝、一年一度。\n风光好处，恰是小春时，香泛泛，酒醺醺，一曲歌金缕。\n吾今已醉，解作醒时语。\n千里念重亲，望家山、云天尽处。\n深深发愿，只愿早休官，居颜巷，戏莱衣，岁岁长欢聚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日书吕季慈室","author":"张良臣","text":"上池入寺见承平，影落南州迹易陈。\n手把黄花看新雁，风烟愁杀旧京人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上雪窦山奉慈院","author":"张良臣","text":"迢迢岭外雪云明，犹忆尘中见伟人。\n沙上岂无新到雁，附来莫厌尺书频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小破","author":"张良臣","text":"小破燕支钿早梅，雪云平澹越江迟。\n青山岁夜行人少，鸭鸭群飞浅草时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山房惠猫","author":"张良臣","text":"从来怜汝丈人乌，端正衔蝉雪不如。\n江海归来声绕膝，定知分诉食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长松丹井","author":"张良臣","text":"九转丹砂炼得成，飘飘仙袂入青冥。\n一泓寒水留真汞，千岁长松产茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平旦","author":"张良臣","text":"平旦梅花破冷红，越香何限水流东。\n陈年翠袖新年恨，尽在吹香笑语中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉台体 其一","author":"张良臣","text":"一寸春霏拂绮寮，蕙花江上雪初销。\n伤心燕子重来地，无复人吹紫玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉台体 其二","author":"张良臣","text":"主人流落委荒坟，燕子还来坏戟门。\n惟有桃花古时月，端端正正照啼痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示长芦仁禅师","author":"张良臣","text":"丛丛竹雀闹人家，农事春来渐有涯。\n品字柴头煨政暖，不知风雪到梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有怀山房","author":"张良臣","text":"每忆山房话夜深，几前无主亦无宾。\n老兵未领西来意，斜倚屏风一欠伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老子像","author":"张良臣","text":"函谷关头紫气浓，独教关尹喜相逢。\n如何道德五千字，不载周家藏室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖晚归","author":"张良臣","text":"帖帖平湖印晚天，踏歌游女锦相牵。\n凤城半掩人争路，犹有胡琴落后船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过西溪","author":"张良臣","text":"罨画层波蕙草荒，冷云客雁两回皇。\n梅花到得吹成雪，尽是清愁不是香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临平","author":"张良臣","text":"儿时曾忆此登临，细说穷途有述征。\n四十九年蘧伯玉，月明人静过临平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别持上人","author":"张良臣","text":"茂竹永和字，浣花天宝诗。\n清江入舟楫，忍泪别僧持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其二","author":"张良臣","text":"后主搴香复倚春，潘嫱梳洗最轻盈。\n南朝破后无词客，燕子桃花古石城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词 其一","author":"张良臣","text":"伫兰无限楚时春，罨岸风平绿自熏。\n睡起画檐双语燕，梨花留得夜来云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝猫","author":"张良臣","text":"江上孤篷雪压时，每怀寒夜暖相依。\n从今休惯穿篱落，取次怀春屡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人游姑苏","author":"张良臣","text":"儿时吾亦寄君州，细细听君说旧游。\n处处绿波通酒巷，女郎多在采菱舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜","author":"张良臣","text":"恰则黄昏雨便晴，青塘迤逦尽蛙鸣。\n月明已在芭蕉上，犹有残檐点滴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题吴兴投老庵","author":"张良臣","text":"白鹭悠悠去不还，渚云汀草一生闲。\n暮年不入西州路，空倚梅花说住山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒熟","author":"张良臣","text":"浊醪初熟荐霜螯，不拟寒山不广骚。\n清晓豆花篱下立，竹梢独与月争高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪天童觉禅师如城","author":"张良臣","text":"风勒江云雪未匀，梦寒不到碧梅春。\n破帆又指芜城近，漠漠平沙落雁频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"张良臣","text":"谁家池馆静萧萧，斜倚朱门不敢敲。\n一段好春藏不尽，粉墙斜露杏花梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步南城下","author":"张良臣","text":"冷云堆屋晚仍春，惘惘人行陌上昏。\n飞去飞来沙上雁，去年洲渚旧芦根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅市道中","author":"张良臣","text":"连雨疏篷不耐关，脩眉如失更晴悭。\n越王故国无人问，艇子穿花自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后","author":"张良臣","text":"雪花竹屋未全消，寒雀梢头眼擘椒。\n纸閤不烟梅自放，底能踏湿渡溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萱草","author":"张良臣","text":"雪色侵凌绿剪芽，枝抽寒玉带金葩。\n北堂回首伤心处，却复令人恨此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢汪尚书见访","author":"张良臣","text":"黄叶声中接锦鞯，添丁篱落怪相牵。\n归来剩欲从僧话，正掩楞伽曝背眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋","author":"张良臣","text":"柳暗旗亭不忍看，临江愁杀晋衣冠。\n伤心明月扬州路，十里珠帘蕙草寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感旧","author":"张良臣","text":"三十六陂春水绿，四十九年人事非。\n杨子江头永嘉后，吴侬荡桨北人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣家书","author":"张良臣","text":"家住鄱城小洞天，经年烹鲤尚茫然。\n几回鹊喜无消息，吹杀灯花独自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠英上人","author":"张良臣","text":"之秦剩肯迎张禄，踏越何曾用计然。\n元鼎事看蛙胜负，大槐人与蚁相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵持上人题延庆寺清玉轩","author":"张良臣","text":"水芳未动城南路，一一僧檐有竹看。\n政尔尘埃能自表，故应悠久澹相安。\n长杨晓猎干戈肃，古棘春朝万玉寒。\n碧眼阿师来授记，化龙飞去抑何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留云门山中","author":"张良臣","text":"侨装结束灿花衣，采藿兰娘釂翠卮。\n三五二八月皎皎，东西南北草离离。\n非君之故岂妄集，对酒不狂无乃痴。\n口住山閒省前梦，而今不似洛阳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书情奉寄蒋弋阳公 其一","author":"张良臣","text":"五都一何绮，歌管政繁会。\n眷我友明月，援琴写秋濑。\n何言昃离后，一饱困藜稗。\n风雨墨如翳，欲往徒自碍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]