[{"title":"送贯之兄被召为御史三首 其一","author":"范纯仁","text":"御史得言天下事，吾兄清直副明扬。\n方当旒扆勤开纳，肯使江湖勇退藏。\n贤者虑时心欲破，仁人致主策须长。\n朝廷宽大生灵急，只在忠臣振纪纲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送贯之兄被召为御史三首 其二","author":"范纯仁","text":"忆昔先门陟谏垣，正人风采动朝端。\n家声宜有琳琅器，兄职今峨獬豸冠。\n台阁继登时所贵，忠贤得用古来难。\n浮荣未必吾儒志，会把功名竹帛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送贯之兄被召为御史三首 其三","author":"范纯仁","text":"艰祸龙钟百指存，共全馀齿赖依仁。\n鸰原方顾飞鸣急，乌府俄闻拔擢新。\n此别宦游须异地，从今教抚更何人。\n他年莫负乡关约，明月扁舟白酒醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孔宁极先生拜官二首 其一","author":"范纯仁","text":"圣朝旌德向丘园，紫诏颁恩到荜门。\n乡老始知为善贵，竞相廉让教儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孔宁极先生拜官二首 其二","author":"范纯仁","text":"先生操术本真儒，进退恬然与道俱。\n宠至不惊高节在，岂颛虚誉激凡愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门山二首 其一","author":"范纯仁","text":"云拥楼台雪拥川，亲朋行望举吟鞭。\n烟龛万叠凌花霰，坐见金人变玉仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门山二首 其二","author":"范纯仁","text":"松筠深处访潜溪，唐相当年卜隐栖。\n必竟主人归不得，只教游客驻轮蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独游石岩寄诸友","author":"范纯仁","text":"乱石巉空耸翠棱，攀萝寻胜逐溪声。\n爱山怀友情无限，日暮岩边独记名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄香严海仙上人","author":"范纯仁","text":"穰邓相逢已十年，想怀风格镇依然。\n身同幻境融都寂，心得玄珠照自圆。\n倚锡静眠松下石，煮茶閒试竹间泉。\n利名识尽情犹熟，终羡吾师绝世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈和叔游龙门先归","author":"范纯仁","text":"玉峰环照碧伊寒，楼阁参差四望间。\n散骑从游皆故友，一川清景彻南山。\n笑言迥出尘埃外，心意都如物象閒。\n夫子官居惯追赏，故饶诸客独先还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王弱翁白沙道中","author":"范纯仁","text":"共驱羸马蹑寒芜，景色鲜明近洛都。\n出谷流泉春更绿，隔林幽鸟暮相呼。\n伊川旧赏疑朝梦，少室重看胜画图。\n从此便穷山水乐，相从应不厌崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙门马上望雪","author":"范纯仁","text":"山开晓色千峰玉，草映寒光万点琼。\n为我春游添景物，不教桃李独鲜明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临汝温泉","author":"范纯仁","text":"山前阴火煮灵源，昔日曾临万乘尊。\n历尽兴亡只如此，不随时俗变寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与王弱翁游龙门","author":"范纯仁","text":"谁知造化擘巍峨，千古伊流向此过。\n四面寒松拥香刹，两崖苍石束寒波。\n身閒愈觉良朋贵，诗拙翻羞好景多。\n宜向诸方纵萧散，明朝望洛下长坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许真君天诰","author":"范纯仁","text":"至人脩练久能成，此诰尝闻降帝庭。\n宝墨森森耸鸾凤，训词一一在生灵。\n既将道行蒙幽显，奚必仙踪到杳冥。\n鹤驾云軿非我觌，祇期操履学真经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读逸民传寄孔宁极先生","author":"范纯仁","text":"汉法忠贤有不容，遂持名节隐蒿蓬。\n生灵莫见真儒效，爵禄多酬战士功。\n燕市终难沽美璞，鱼罗安得挂飞鸿。\n圣朝高士优游甚，自有行藏继祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曼叔閒书","author":"范纯仁","text":"夫子天资过我曹，两兼才德属人豪。\n不求近誉声逾远，能处卑官道益高。\n岂止一同裁美锦，直须万俗被重袍。\n由来康济吾儒事，抚遍疮痍莫厌劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和早行","author":"范纯仁","text":"拂曙征人各向方，乍明林野更青苍。\n云头漏日开秋色，马足翻沙破晓霜。\n时事罕闻心愈静，故人不见恨空长。\n怜君素爱还乡乐，行役虽劳肯暂忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"循吏","author":"范纯仁","text":"王化由来起一同，尽由守宰致平隆。\n坐移风俗为能政，勤抚生灵是至忠。\n四境肃清民害去，一方和乐主恩通。\n吾皇有德真尧舜，唯待诸君共理功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酷吏","author":"范纯仁","text":"虐吏天资害物深，斯民无耻叹刑淫。\n只凭豺虎贪残意，肯顺乾坤长养心。\n骨肉尽将成怨府，君亲何以致薰琴。\n终逢族灭令人快，智者为谋岂待箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻锻","author":"范纯仁","text":"万籁萧然送夕曛，锻声相应互成文。\n高随晚吹惊愁耳，清入霜空透暮云。\n始讶僧鱼敲晓石，静如山木响秋斤。\n五兵若可为农器，此韵千家不厌闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和象之石磬","author":"范纯仁","text":"谁向西山选翠琳，中含太古自然音。\n昔逢虞帝来祥凤，今与陶家伴素琴。\n清越乍敲脩竹里，坚方真合哲人心。\n一镌名姓将难朽，千载知君道德深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送贾春卿宰尉氏","author":"范纯仁","text":"相君勋业冠朝端，爱子犹居字俗官。\n道德相传家有法，功名善继古为难。\n清平足使群情化，谈笑能令万室安。\n千里远途今日见，愿当仁政勿盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴郑郎中宴集","author":"范纯仁","text":"卧锦仙郎久卜居，满床书史日康娱。\n邀朋欲走趋斋阁，不厌尘埃俗客无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄辛化光","author":"范纯仁","text":"疏閒心迹久相亲，一别江城两见春。\n身若孤鸿长慕侣，道非尺蠖敢求伸。\n优游岁月空尸禄，明润溪山不染尘。\n尊酒从容皆胜景，欠君来作席中宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴君平游蒋山兼呈王安国二首 其一","author":"范纯仁","text":"十年游宦阻朋从，尊酒俄欣二友同。\n单父能名推子贱，襄阳高节爱庞公。\n六朝山色空陈迹，十里松声正晚风。\n联骑追攀不知暮，却嫌归路入尘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴君平游蒋山兼呈王安国二首 其二","author":"范纯仁","text":"钱塘山色饱相从，复此登临景物同。\n旧国池台馀草碧，夕阳楼阁半山红。\n当时言笑如朝梦，今日心颜尽老翁。\n终爱岩间坐禅客，能将万事付虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕献可江口见赠","author":"范纯仁","text":"世阀俱承父祖风，又叨宦契十年中。\n棠阴代领诸侯印，棣萼更联御史骢。\n白首相期唯信道，清朝连贬为输忠。\n驽骀讵合参骐骥，应合心能报主同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕献可牡丹","author":"范纯仁","text":"去年仁政与春来，真赏曾蒙醉目回。\n红旆已随芝检去，满栏芳意为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和献可龙峰寺见寄三首 其一","author":"范纯仁","text":"驱车日日望行舟，目断风帆不可留。\n独有召公遗爱地，苍山重叠满晴楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和献可龙峰寺见寄三首 其二","author":"范纯仁","text":"丹心自许酬明主，百谪那能避贵权。\n此道方今谁复问，望公须向古人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和献可龙峰寺见寄三首 其三","author":"范纯仁","text":"忠臣多快奸臣愤，天意人情可奈何。\n安得皋夔能致主，早闻尧舜复赓歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和献可丙午二月六日别台中僚友","author":"范纯仁","text":"感时情绪已难禁，况复怀贤恨愈深。\n鸦噪晚林催远客，云藏夕照弄轻阴。\n松筠自信凌霜操，葵藿长倾向日心。\n同志飘零山馆寂，欲沽芳酒与谁斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荆甘","author":"范纯仁","text":"品珍方重寄来难，长忆东吴把酒看。\n笠泽烟闲排锦树，洞庭霜老摘金丸。\n清香先透筠笼细，甘液俄通玉齿寒。\n不学荔枝遗国恨，曾烦驿使到长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兖墨","author":"范纯仁","text":"谁爇长松制作勤，轻煤匀腻杂兰薰。\n中疑玄石无纤翳，外若灵犀有密纹。\n溪石乍研浮紫翠，蜀笺试写落烟云。\n会将点画传青简，千古忠邪为尔分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄曼叔","author":"范纯仁","text":"他年尝苦见君难，每一相逢百倍欢。\n正值风烟遥化邑，敢期尘土共粗官。\n夜谈往往惊晨鼓，乐饮时时解醉鞍。\n游遍洛阳佳胜地，须将归兴暂盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张统贯之同年","author":"范纯仁","text":"同榜同僚是别缘，所存相近复相便。\n性情疏懒忘官检，襟抱平夷学古贤。\n仁者才谋当济物，吾曹名利久推天。\n须知白首相逢日，不失初心始自全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中游兴庆池席上","author":"范纯仁","text":"出郊尤喜雨初晴，洗出川原物象明。\n楼影半藏高柳外，池光遥与绿萍平。\n鸥驯长近朱阑戏，民乐争随画隼行。\n主礼自忘台鼎贵，芳尊尽日许同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中垂萝洞","author":"范纯仁","text":"胜游今属相君家，台榭高开碧水涯。\n森耸绿梧常映日，萦纡寒溜曲穿花。\n藤牵柔蔓垂长带，竹引新萌走蛰蛇。\n下吏不辞峨醉弁，却愁归污绣茵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中上巳晚游九曲池","author":"范纯仁","text":"前朝池阁尽尘埃，登览惭无吊古才。\n旧物祇馀苍石在，断墙曾识翠舆来。\n回环竹径穿幽鸟，寂寞茅檐覆故台。\n游客静观兴废迹，利名心息若寒灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中春阴马上","author":"范纯仁","text":"三月芳菲欲暮天，可堪零雨昼连绵。\n润催陇麦将笼节，寒阻春蚕趁早眠。\n疏柳拂墙难结絮，嫩苔铺砌已成钱。\n牡丹只待晴阳照，看吐新花一尺圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩侍中游兴庆池","author":"范纯仁","text":"两奉清欢到碧塘，再游无奈惜春光。\n莎匀古岸添新绿，蝶绕残花采旧香。\n佳木引阴交翡翠，疏林迸笋补筼筜。\n从容赏遍西园景，化国偏知日月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中登广教院阁","author":"范纯仁","text":"两陪千骑叩禅关，每听高吟解客颜。\n吉甫壮猷方北伐，谢公高兴在东山。\n僧轩深闭芳菲静，春昼初长鸟雀閒。\n游览不知归径晚，火城看逐隼旟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中同赏牡丹","author":"范纯仁","text":"秦地春光似洛阳，牡丹名擅百花场。\n巧钟绝艳群芳后，高剪红云万叶彊。\n露满金盘看国色，风回绮席识天香。\n酒酣只欲盈簪戴，聊伴衰颜照玉觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙曼叔北禅牡丹一蒂三花","author":"范纯仁","text":"三花骈蒂吐芳丛，曲尽东皇造化功。\n疑是神山仙子会，霞衣鼎立驭轻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中西禅牡丹","author":"范纯仁","text":"秦川花品似伊川，真赏应同上苑看。\n众卉先收推国艳，五云高吐学仙冠。\n烟苞添色资吟笔，露蕊沾香满酒盘。\n匀压春丛千万朵，欲归犹复绕朱栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩侍中初夏游兴庆池","author":"范纯仁","text":"池边喜逐綵旗行，初夏亭台照水明。\n筠箨乍开春后绿，林稍长带雨来声。\n新荷猎猎香风远，深洞沈沈昼景清。\n珍重相君忧国意，宴游终亦念农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与张靖学士游华清宫雍帅钱子飞端明以诗见寄次韵和","author":"范纯仁","text":"金节煌煌柅使辀，华清胜绝许陪游。\n东来渭水晴光动，西望长安翠霭浮。\n休羡青山供秀句，好归黄閤告嘉猷。\n忆公何处偏回首，身在朝元最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠眉阳致政程浚少卿","author":"范纯仁","text":"清节高风世所推，秋毫名宦肯徘徊。\n勇抛朝市无穷事，笑指林泉独自来。\n吟榻未移溪月上，醉巾长拂野云回。\n尘衣欲作登门客，几杖何妨许暂陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴仲庶游碑楼大慈二寺","author":"范纯仁","text":"锦城寒食最繁华，游骑翩翩杂钿车。\n烟染翠行环郭柳，波摇红影隔江花。\n长年已觉春如梦，远客唯应醉是家。\n回首乡关行乐地，风光正好路岐赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴仲庶上巳游学射山","author":"范纯仁","text":"天涯春色蜀川多，胜赏相从到薜萝。\n绕郭烟芜深似染，隔林山鸟静能歌。\n花边密拥青丝盖，陌上轻驰白玉珂。\n察俗自知无远术，祇于民乐验时和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴仲庶晚春游海云","author":"范纯仁","text":"东郊行乐冠西州，古寺岧峣翠岭头。\n化俗文翁传岂弟，寻山谢傅继风流。\n天涯尊酒欣相遇，剑外三春得共游。\n雅兴直须穷胜赏，年光难使隙驹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和暮春蚕市","author":"范纯仁","text":"古祠幽邃锦城隈，千骑欢游宴席开。\n尽日风光随綵旆，一方民乐在春台。\n江头佛寺藏深竹，郊外人家荫绿槐。\n已奉更书催别绪，肯辞清赏屡追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄临邛致政常郎中","author":"范纯仁","text":"东海抛官勇退时，邦人留止任牵衣。\n三朝报国丹心尽，万里还乡一棹归。\n身向清閒添寿考，德因潜隐更光辉。\n常思把酒亲高议，何日单车遂扣扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄持正都官按部嘉眉","author":"范纯仁","text":"使者观风过晚春，逢山应暂柅征轮。\n云埋雪岭铺银界，日射金仙照碧津。\n千里讴谣民足食，万家水竹地无尘。\n未能结驷相从去，簿领空嗟绊此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以眉州绿荔枝寄吴仲庶有诗次韵","author":"范纯仁","text":"嘉川荔子著芳名，携从归鞍到锦城。\n驰驿幸无唐日贡，甘芹聊致野人情。\n丹砂结颗藏膏露，赭縠为囊贮嫩琼。\n京洛不须图画去，得公佳句自分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲庶江渎避暑","author":"范纯仁","text":"古祠清燕敞虚堂，乔木森森昼景长。\n池面雨来荷助响，席间风细篆生香。\n乌纱倾侧朋簪乐，翠縠翩翻舞袖长。\n牵俗自嗟行役去，阻陪千骑醉瑶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将出蜀次仲庶送行诗韵叙别","author":"范纯仁","text":"远客亲仁岂素期，况陪文酒复经时。\n自惭拙宦多迁逐，每叹良朋易别离。\n白首冯唐空已老，清秋宋玉不胜悲。\n仰公早展经纶志，百辟方今待允釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李审言龙图","author":"范纯仁","text":"英风一别几经年，尊酒相逢意洒然。\n欲报重知惭国士，喜同清议属真贤。\n武侯方屈南阳卧，萧相曾封汉水边。\n好及新春颁惠化，行藏吾道合推天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬张杲卿相公见招","author":"范纯仁","text":"先君同榜更何人，教育偏蒙契义亲。\n孔氏系匏暂滞迹，辽阳归鹤羡閒身。\n四朝盛事浑经眼，千日浓醪好入唇。\n箕颍更无高放客，只应梅柳为公春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎五秀才折海棠见赠","author":"范纯仁","text":"蜀国海棠春最妍，万枝红锦忆曾观。\n乡人折赠情尤重，肯与群花一等看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿州元太守北楼席上","author":"范纯仁","text":"七月高楼暑气回，荷香细逐水风来。\n翠蛾细袖歌声远，绿野苍山醉眼开。\n羁客秋怀追屈宋，主人交义继陈雷。\n他年林下相逢去，诗酒何妨许重陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴伯脩洞霄宫","author":"范纯仁","text":"三朝勤瘁不谋身，今日官閒与道亲。\n纡组还乡宜最乐，居山得禄未全贫。\n性情有暇穷真理，门馆无权少俗宾。\n会待收踪归畎亩，就君同醉洞天春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和滕中舍见寄","author":"范纯仁","text":"蕲水分携自昔时，六年奔走困长岐。\n人怜家世三朝旧，身在风波一叶危。\n白发星星惊岁月，丹心皎皎仗朋知。\n林泉早晚归休去，廪禄无厌愧漏卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李敷察推即席感旧二首 其一","author":"范纯仁","text":"相逢同榜盛当年，喜复君来对此筵。\n花下莫辞频把酒，月中曾是共登仙。\n左迁还有粗官乐，晚达何妨秀句传。\n得失已看如塞马，苦心劳力亦徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":41937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]