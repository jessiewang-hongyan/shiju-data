[{"title":"次韵曾子开侍郎话别 其二","author":"释道潜","text":"抗论仪曹肯折旋，一麾江海去飘然。\n他时开府馀杭郡，来酌吾庐石缝泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书梦寄妙懿","author":"释道潜","text":"妙思堂深路屈盘，夜来魂梦忽跻攀。\n道人开户相迎处，宛在脩篁翠雾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观恭师诗书以二绝勉之 其一","author":"释道潜","text":"吾乡英秀颇能文，子复区区慕碧云。\n请用三多为祖式，他时自与古人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观恭师诗书以二绝勉之 其二","author":"释道潜","text":"论书当亦似论兵，军律非严事不成。\n行伍会须同比栉，出奇方可语纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过钟山寻俞清老不遇","author":"释道潜","text":"霜风薄木韵含悲，岁晚寻君失后期。\n夜鹤晓猿惊怨歇，草堂人去已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘伯昌长官见赠","author":"释道潜","text":"刘侯诗格殆天全，初得西湖纪胜篇。\n锦绣为肠供丽藻，鲸鲵作气吸长川。\n静依北牖开樽俎，醉扫寒梢杂雨烟。\n岁晚扁舟东去急，喜君高调重迁延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵法真禅师送曾敬之宣德昆仲","author":"释道潜","text":"昔与乃翁相遇年，始知有子生且贤。\n尔来双干已争秀，屹屹欲上参高天。\n昨朝较蓺偶不售，他日奏赋闻甘泉。\n方今庙堂喜人物，收拾万汇归陶甄。\n袅蹄麟趾终一出，辉映左右无馀妍。\n肯学孟生誇得意，一日走遍春风前。\n嗟余投老隐岩谷，形若槁木心灰然。\n扁舟追子仅千里，彷佛夜梦遥相传。\n西湖风物行岁晏，归赋梅花趁腊先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送文惠师还金华","author":"释道潜","text":"脱略纷华自妙年，秉心端喜事金仙。\n终期象驭超三界，不羡鹏程越九天。\n考疏穷经心尚壮，依仁据德节尤坚。\n秋风陡起庭闱念，聊寄脩江一叶船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證师圣可桐虚斋","author":"释道潜","text":"吾闻峄山桐，猗猗排秀干。\n栖鸾宿凤信所奇，众木纷纷何足算。\n呜呼，天相彼质，复虚彼心。\n故其声之隐也无阂，其动也无留。\n有叩而鸣，体佚而休。\n嘉上人之妙龄兮，无适俗之卑韵。\n刚有拟于斯桐兮，廓中虚以受训。\n异速成之朝荣兮，培益厚而日敏。\n悼像末之寥寥兮，蹇吾道之不振。\n续芳尘于祖席兮，他日非桐虚上人者而复谁何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"规师方外停云斋","author":"释道潜","text":"上人少脱略，出处非拘囚。\n停云倚空端，舒卷良自由。\n纵之千丈强，敛附拳石幽。\n超遥宇宙间，孰与斯人俦。\n铭诗善摹写，居士亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居智果方外以诗见寄次韵奉酬 其一","author":"释道潜","text":"偶来湖上缉衡门，桐长脩柯竹有孙。\n引策每从佳处去，望云桥下是西村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居智果方外以诗见寄次韵奉酬 其二","author":"释道潜","text":"青灯残篆夜寥寥，门外秋风振苇萧。\n惭愧高人能见忆，为余西望立溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周开祖大夫泛湖见访","author":"释道潜","text":"漾漾清漪十里间，画船人似镜中安。\n雨催菡萏幽香发，风触莆萄细浪寒。\n高岸乌纱来静院，倒挥白羽傍曾栏。\n吟毫所遇无遗景，天乞词源北海宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲试院梦中书事见寄 其一","author":"释道潜","text":"梦入秋山知几层，霜风吹骨正棱棱。\n苍崖荦确难安足，自说从余授杖藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲试院梦中书事见寄 其二","author":"释道潜","text":"朱甍碧瓦碍云浮，共蹑曾梯最上头。\n一饷阑干变风雨，凛然毛发便惊秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲试院梦中书事见寄 其三","author":"释道潜","text":"怪兽胡为出巨津，昂然激水忽翻身。\n鱼龙赑屃何妨事，莫作风波谩恐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲试院梦中书事见寄 其四","author":"释道潜","text":"一川脩竹映疏花，川上时闻响钓车。\n似到秦人种桃处，谁知梦断却还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲试院梦中书事见寄 其五","author":"释道潜","text":"崖根乌蜜已先尝，从此知君鬓不霜。\n应笑吾曹事枯槁，山中危坐独休粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴子野先生","author":"释道潜","text":"麻田老仙心炯炯，少有高风慕箕颍。\n枕流漱石三十年，眸子瞭焉神更静。\n忽然杖策海上来，至人道妙同尘埃。\n达官贵侯竞招致，往无所欲谁嫌猜。\n迩来一志从吾党，迹与孤云共天壤。\n曹溪有路更攀跻，径蹑毗卢高顶上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送庠上人","author":"释道潜","text":"点检行装拂与巾，洒然轻别故山春。\n家家门底长安道，举目何须更问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵才仲山行","author":"释道潜","text":"幕府文书一扫空，何妨行乐醉春风。\n想闻笑语千山外，正在烟云万叠中。\n哢日鸟声喧细碎，照溪花影静玲珑。\n苦吟只恐凋肝肾，夫子还宜少黜聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与神智师话别","author":"释道潜","text":"昔我年始壮，托身灵鹫峰。\n主人大导师，鼓舞扬真风。\n四方依绛帐，杂遝象与龙。\n嗟余于此时，已识大士踪。\n纷纷论议场，头角出群雄。\n如何三十载，慧刃藏其锋。\n端居肄业地，了不为世通。\n迩独念西湖，聿来将谁从。\n情随山水远，兴与鱼鸟同。\n平生方外姿，自在如冥鸿。\n明朝复回首，飘洒一孤篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖晖堂","author":"释道潜","text":"堂上何为绝点埃，堂前翠帚扫空阶。\n遥怜薄日晖晖静，影入高人燕坐怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵嵩阳陈叔易先生见访 其一","author":"释道潜","text":"知君挟册未尝闲，一志端能事孔颜。\n千里扁舟下吴会，眼中收拾只溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵嵩阳陈叔易先生见访 其二","author":"释道潜","text":"枯槁长专一壑间，权豪殊未少低颜。\n风云他日超腾去，莫畏移文到北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓霁","author":"释道潜","text":"云拥茅檐水拍渠，晓来新雨过吾庐。\n蔫红宿萼莓苔满，解事长杨自扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵龚尧佐帐勾晨起感怀","author":"释道潜","text":"造物纷纷自变更，达人何用较前程。\n芭蕉身世荣枯久，胡蝶梦魂来往轻。\n隔屋相惊铜漏尽，开扉犹爱玉绳横。\n应嫌百吏凫行进，簿领文书与案平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远斋","author":"释道潜","text":"君不见昆崙之河与天通，源深发远人莫穷。\n回溪转壑随折冲，末势演溢流于东。\n东溟无旁下无底，浩荡足以家鱼龙。\n嗟哉吾徒虽好学，讵肯著意推所从。\n渊停富滀有若是，孰谓世上无豪雄。\n法师名斋意且远，张皇幽眇见尔聪。\n西来竺书五千轴，期子岁月加磨砻。\n离骚楚词亦谩读，言语黼黻何必工。\n禅馀习气如未尽，时倚涧石吟松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀仙阁","author":"释道潜","text":"瀛洲仙人骑皓鹤，佩玉鸣风度寥廓。\n锦溪南望九仙岑，笑指烟霞憩曾阁。\n阁中清绝无纤尘，铜炉著香夜梦真。\n平明跨鹤出山去，涧草岩花空自春。\n山僧问我入何地，今作玉皇香案吏。\n挟持造化几时还，搔首临风聊一喟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华亭道中","author":"释道潜","text":"白水茫茫天四空，黄昏小雨湿春风。\n五更百舌催残梦，月到官河柳影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同周元翁著作范明远秘校西湖夜泛各赋一首","author":"释道潜","text":"薄云疏雨作还休，白帝撩人巧变秋。\n天地此身均逆旅，江湖几度共离忧。\n暮声断续钟连磬，夜气浮沈浦与洲。\n圆峤方壶吾未羡，敢烦骚客为冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和元翁","author":"释道潜","text":"高论每逢贤友生，还如讲武得奇兵。\n了无鄙吝胸中物，尚有风流世外情。\n破海玉蟾初未跃，洒空珠露已先倾。\n回桡转柂行三鼓，始见波澜百顷明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和明远","author":"释道潜","text":"二客风神瑩石泉，解衣同缓夜归船。\n已残巾子峰头日，犹认吾庐竹外烟。\n水怪有名殊未见，犀灯无事不须然。\n月明幽渚蒹葭静，珍重沙禽稳睡眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵月上人秋夜见寄","author":"释道潜","text":"冥鸿振鹭想仪形，数日新秋入梦清。\n丹壑流泉依旧否，碧岩丛桂几时生。\n风来玉户凉初集，露泫银河色渐明。\n黾勉酬君无妙语，夜光鱼目愧相并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送远上人还金华","author":"释道潜","text":"千林脱叶送残秋，一舸南归兴莫留。\n富渚江平非白马，子陵滩稳异黄牛。\n吟怀览胜宜无倦，才力如君岂易求。\n他日殷勤为细字，尽传佳句到东州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与愚上人宿天竺 其一","author":"释道潜","text":"夕阳山气蔼葱葱，路转松阴复几重。\n行过石桥人未见，数声先听寺楼钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与愚上人宿天竺 其二","author":"释道潜","text":"稽留峰北好林泉，珍重幽栖得所便。\n柏子烟中能宴坐，想无馀习可攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与愚上人宿天竺 其三","author":"释道潜","text":"霜压帘栊露泫条，银河影转斗垂杓。\n清言共失三更梦，错恨芙蓉漏易消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨起","author":"释道潜","text":"猿鹤惊呼晓，楼钟动翠微。\n枫林堕清月，疏影乱人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜不群不疑见访","author":"释道潜","text":"鹊啅庭梧喜满怀，悬知二子下崔嵬。\n山中爽气知多少，半逐风流杖屦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送桐江明上人之都下","author":"释道潜","text":"窈窕孤云下翠岑，帝乡闲去本无心。\n红尘满眼急回首，莫遣空山鹤怨深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送定上人还会稽","author":"释道潜","text":"西风警群木，萧瑟散秋声。\n病客有归思，孤云无恋情。\n月当千里共，人恨四难并。\n苦学谁如子，它年在一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘蔡仲秀才雪后登竹阁 其一","author":"释道潜","text":"槛前君子旧虚心，雪后相看意更深。\n晴日暖风催鸟语，翠梢高处啭柔音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵刘蔡仲秀才雪后登竹阁 其二","author":"释道潜","text":"君看楚峤耸巑岏，圭壁千层间翠岚。\n山后一峰尤秀拔，依稀还落剡溪南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄仲闵主簿见访游宝云诸寺","author":"释道潜","text":"吾庐附曾阿，松竹蔚行路。\n平生土木躯，羞为折腰具。\n蓼虫甘苦涩，虽死那求遇。\n黄香诸父贤，倾盖如有素。\n相将山水行，所适得佳趣。\n观台深且靓，缟壁悬清句。\n云巢倚空端，下览宜细顾。\n楼台霁雪初，碧瓦尘未涴。\n篮舆指颓景，长挹还辞去。\n恍如山阴集，俛仰已成故。\n重来竟何时，相望碧云暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏世美夫人挽辞","author":"释道潜","text":"夫子刚中早数奇，闺门高节耸当时。\n渊明晚欲归三径，德曜能从赋五噫。\n不见莱衣华发事，空惊薤露昔人悲。\n故知造物酬阴施，玉立诸郎富白眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重居夜坐怀苏伯达昆仲","author":"释道潜","text":"狂风吹林声怒号，隔垣汹汹如秋涛。\n夜阑稍觉群动息，星斗挂檐霜月高。\n东邻书生勤且劳，粲然文采真凤毛。\n遥想下帷应未寝，短檠相对课离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慕容居士双楠轩","author":"释道潜","text":"阳羡溪山名浙右，氤氲淑气无时有。\n遂令比屋慕弦歌，甲第殊科争捷手。\n先生读书三十年，数奇不偶真可怜。\n闭门陋巷聊自隐，箪瓢屡空心晏然。\n南轩前头两佳木，先生抚玩长不足。\n尤爱薰风五月初，白银开花光照屋。\n故人解后相逢遇，指点婆娑索新句。\n君不见少陵杜叟有长吟，莫作凡材等闲赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏端明定武雪浪斋","author":"释道潜","text":"孔明气宇白玉温，忠义勇决踰王尊。\n葛巾羽扇传号令，塞垣彻警无尘昏。\n良辰往往挟将佐，射雕走马循烟村。\n归来饮酒坐堂上，宾从如云填戟门。\n一朝郡圃得奇石，雪浪触眼惊神魂。\n旁求苍珉琢巨斛，偃然卧土知无根。\n三牛曳归置阶圯，错磨不许留纤痕。\n兴来作诗寄台阁，雄词妙笔争考论。\n将军今谪穷海外，会见羲娥窥覆盆。\n殷勤寄语朔方客，佳致勿毁宜长存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无为堂","author":"释道潜","text":"无为岂不动，无念非刳心。\n至人均道妙，与物相浮沉。\n青铜一寸明，万象了自分。\n何须苦机械，扰扰乱冲襟。\n晴窗馥烟篆，衣裓蒙馀薰。\n超然旷士怀，所得踰古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示法颖","author":"释道潜","text":"儿曹汝既识薰莸，卓荦应须力自修。\n一志径从齐客语，万端无受楚人咻。\n卑飞燕雀宜深远，高举鸾凰可并游。\n莫负谪仙当日语，十年名誉满东州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清聚轩","author":"释道潜","text":"之子吟怀欲称情，故穿幽沼滀清泠。\n傥逢来客议深浅，但道渊源通北溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵晓师见别欲游京洛","author":"释道潜","text":"春波涨南浦，霁色媚澄鲜。\n扁舟驾两桨，行矣子所便。\n岸花开迤逦，红紫交相妍。\n诗情发浩荡，输泻万壑渊。\n清新逼庾信，雅健追樊川。\n相俦得鸿鹄，翔集固超然。\n衣裓暂尘土，它时洗云泉。\n幽姿复烱烱，不羡玉池莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游径山怀司马才仲","author":"释道潜","text":"柔桑蔽野麦初齐，布谷催耕雨一犁。\n略彴时横溪上下，蔷薇间发水东西。\n重寻胜处追前赏，无复斯人手共携。\n回首春风增感慨，绵绵黄鸟更悲啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云巢 其一","author":"释道潜","text":"环湖相望百招提，高栋曾轩亦屡跻。\n未若道人基构胜，阑干清与白云齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云巢 其二","author":"释道潜","text":"九江秀色可揽结，谪仙爱彼巢云松。\n寂寞风流三百载，此轩奇观蹑前踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云巢 其三","author":"释道潜","text":"碧瓦朱甍冠翠微，郁葱佳气缭窗扉。\n人间尘土纷阡陌，不到藜床燕坐衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日湖上呈秦少章主簿","author":"释道潜","text":"水边花雾晓氤氲，春入西湖两岸深。\n冶叶倡条他自媚，朽株枯木我何心。\n鞦韆索转朱楼角，博塞声喧碧柳阴。\n年少故人方感慨，未应从俗强浮沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送诚无上人还洞山文禅师席下","author":"释道潜","text":"上人妙齿遗樊笼，嗜好岂与稠人同。\n岩栖水饮有馀裕，期以至道超鸿蒙。\n少林人亡仅千载，末路鼓舞谁为雄。\n江西老褐真望士，蚁趋云合争所从。\n羡君伏役事且久，诚专志苦迷春冬。\n心珠磨错稍精瑩，彷佛水月含冲融。\n去岁扁舟下吴会，溪山胜践情所钟。\n芒鞋竹杖霜露入，始知节物徂秋风。\n朝来兴尽挽不住，翻然又逐南征鸿。\n它年相逢定庐岳，与子终老巢云松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕默堂","author":"释道潜","text":"万汇乾坤里，谁何识道真。\n喧卑憎末俗，燕默羡高人。\n漏转芙蓉永，香销柏子频。\n他年挥玉麈，堂上挹芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":50999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送严上人还永嘉","author":"释道潜","text":"道人出处孤鸿俦，讵肯低回受羁绊。\n飘风转日历九州，不羡骑鲸游汗漫。\n我生与君几相逢，穷幽摘胜时乃同。\n胸中妙道未容扣，又引高兴辞秋风。\n君家住在孤屿侧，此别何时见颜色。\n欲识相思一寸心，冷月依依挂空碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门狱中怀北山旧隐 其一","author":"释道潜","text":"江湖堂北是吾庐，缭绕杉篁蔚有馀。\n欲问山中近消息，鳞鸿不寄狱中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门狱中怀北山旧隐 其二","author":"释道潜","text":"诛茅投老卜栖迟，云雨相翻岂易知。\n夜鹤晓猿休怅望，回车复路可无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门狱中怀北山旧隐 其三","author":"释道潜","text":"数亩檀栾古道边，亭亭气慨上参天。\n未应霜雪能摧抑，不用行人叹可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门狱中怀北山旧隐 其四","author":"释道潜","text":"东崦扶疏一树梅，繁英辜负岁时开。\n殷勤寄语兰兼蕙，它日春风我亦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]