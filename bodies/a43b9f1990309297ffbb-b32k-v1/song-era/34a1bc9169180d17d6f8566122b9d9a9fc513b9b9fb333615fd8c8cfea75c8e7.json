ror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日三首 其一","author":"秦观","text":"霜落邗沟积水清，寒星无数傍船明。\n菰蒲深处疑无地，忽有人家笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋词二首 其二","author":"秦观","text":"无数青莎绕玉阶，夕阳红浅过墙来。\n西风莫道无情思，未放芙蓉取次开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋词二首 其一","author":"秦观","text":"云惹低空不更飞，班班红叶欲辞枝。\n秋光未老仍微暖，恰似梅花结子时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴杭倅至汴上作","author":"秦观","text":"俯仰觚棱十载间，扁舟江海得身闲。\n平生孤负僧床睡，准拟如今处处还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送酒与泗州太守张朝请","author":"秦观","text":"莫笑杭州别驾村，昔曾柱下数承恩。\n而今虽是江湖吏，犹有当时七字尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻雁怀邵仲恭","author":"秦观","text":"楚泽吴天去未迟，烦君且傍蒜山飞。\n白袍居士如相问，为说淄尘欲满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","p