[{"title":"题桃花源","author":"龚桂馨","text":"碧树花开醉晚春，灵槎几度汎天津。\n可怜太守仙缘薄，不是衣冠不属秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"龚鼎臣","text":"家经武夷住，事与会稽邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈山龙君祠迎享送神曲 其一","author":"龚颐正","text":"海波渊沦兮海山巃嵷，其下潜通兮君之宫。\n时思其母兮来舂容，菖叶生兮杏蒂融。\n君之来兮雷隆隆，雨我田兮秋芃芃，我之怀兮无初终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈山龙君祠迎享送神曲 其三","author":"龚颐正","text":"吹洞箫兮望极浦，君之归兮云在下土。\n十风兮五雨，祐我海邦兮污莱斥卤。\n君不来兮使吾心苦，千秋万岁兮为民所怙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈山龙君祠迎享送神曲 其二","author":"龚颐正","text":"君祝驾兮芬阳斯陈，鼓钟广享兮列鼎重茵。\n君之宫兮屯云，蕙肴蒸兮芬芬。\n我黍我稌兮抑亦荐其萍芹，君明其衷兮无吐芳新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泰伯庙迎享送神辞三章 其三 送神","author":"龚颐正","text":"车兮载旃，舟兮扬帆，鼓咽咽兮君当还。\n君肯来兮尚盘桓，我心茕茕兮其无端，君不我留兮下土嚣烦。\n福我吴人兮无疾与患，千秋万岁兮歌至德以何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泰伯庙迎享送神辞三章 其二 享神","author":"龚颐正","text":"登歌兮堂上，屡舞兮堂下。\n君来享兮清酤，溪毛陆离兮筐筥。\n莼鲫芳鲜兮亦有肥羜，君不来兮使我心苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泰伯庙迎享送神辞三章 其一 迎神","author":"龚颐正","text":"翼翼兮新宫，兰櫋兮枅桂，气总总兮高灵下队。\n君视八纮兮昔何殊于弃屣，今复何有兮一席之壝。\n惠我吴人兮曷日以弭。\n吁嗟君来兮我心则喜，君来不来兮我忘食事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赠丁谓之","author":"龚颖","text":"胆怯何由戴铁冠，祗缘昭代奖孤寒。\n曲肱未遂违前志，直指无闻是旷官。\n三署每传朝客说，五溪闲凭郡楼看。\n祝君早得文场隽，况值天阶正舞干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"剑池桥梁久就倾圮方丈沾公刊石伐木以递汲且并陈楼悉改旧观","author":"龚潗","text":"涓涓剑池泉，削崖出石乳。\n流传岁千百，评列品三五。\n舆梁见何时，楼与姓俱古。\n坐令丘壑观，凛作岩墙惧。\n沾公大勇猛，咄嗟见未睹。\n攲倾变略彴，岞崿移朽腐。\n连筒称深汲，惠泽遍下土。\n幽寻稳登眺，清意逼肺腑。\n何须铁作限，只尔天可补。\n传闻桥下云，已作前山雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"傅大询","text":"草草三间屋，爱竹旋添栽。\n碧纱窗户，眼前都是翠云堆。\n一月山翁高卧，踏雪水村清冷，木落远山开。\n唯有平安竹，留得伴寒梅。\n唤家童，开门看，有谁来。\n客来一笑，清话煮茗更传杯。\n有酒只愁无客，有客又愁无酒，酒熟且徘徊。\n明日人间事，天自有安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行香子 寿邓宰母二月初五","author":"傅大询","text":"玉佩簪缨。\n罗袜生尘。\n问何时、来到湘滨。\n尧蓂五叶，二月阳春。\n一霎时风，一霎时雨，一霎时晴。\n有子鸣琴。\n有路登瀛。\n戏斑衣、温酒重斟。\n蟠桃难老，相伴长生。\n一千年花，一千年果，一千年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"傅大询","text":"江梅破腊，把一枝来报，□春消息。\n锦帐银瓶龙麝暖，画烛光摇金碧。\n两径桃花，一溪流水，路入神仙宅。\n云裳羽佩，洞天相会今夕。\n堂下乐问灵鼍，玉人清唱，舞袖低回雪。\n富贵风流须道是，天上人间难得。\n玉镜台边，琼浆盏畔，共说春心切。\n百年偕老，凤凰楼上风月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青 庆叶丞","author":"傅大询","text":"春到江南，今年寒少，早有疏梅。\n相伴双松，吟哦风月，着意花开。\n天香甚处安排。\n便何似、调羹去来。\n劲节仙姿，玉堂难老，身在蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦堂春/锦堂春慢 寿许宰","author":"傅大询","text":"梅要疏开，雪教迟下，怕他寒入江天。\n有月桥仙客，相伴婵娟。\n巷陌升平气象，一时都在鸣弦。\n望东家锦里，雁到云边。\n书到云边。\n尊前翠眉环唱，道新腔字稳，花折声圆。\n此去凤池游戏，碧波添插金莲。\n看长生叶上，龟寿千年，人寿千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠桂琴隐先生","author":"傅子云","text":"五载飞鹰迅，孤踪病马羁。\n望东尝把酒，倾盖便论诗。\n玉在山俱润，泉寒练正垂。\n二雏方刷翼，行矣陟天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨汝士玉蕊帖","author":"傅子容","text":"比玚更矾总未佳，要须博物似张华。\n因观异代前贤帖，知是唐昌玉蕊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小孤山","author":"傅文翁","text":"滟滪拓瞿塘，二孤障澜蠡。\n大哉神禹功，天地相终始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游广福院","author":"傅权","text":"古寺荒凉近水涯，钟声朝暮落渔家。\n昔年踪迹曾经此，依旧残阳伴晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望仙峰","author":"傅权","text":"嵯峨山势傍云天，试问谁来此望仙。\n终日望仙仙不见，始知仙道若茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横石潭","author":"傅权","text":"圆如冰鉴石平横，一派泉流到此停。\n我信龙潜应咫尺，终归大海润生灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宿东岩寺","author":"傅权","text":"夜宿给孤园，悠然魂欲仙。\n恐惊沙上月，莫吸石间泉。\n露落萤初度，风回鹤欲眠。\n更瞻峰岭气，非雾复非烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成 其一","author":"傅自修","text":"叠翠亭前秋水深，思韩亭下木成林。\n一生不得文章力，且向潮阳度岁阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成 其二","author":"傅自修","text":"讼牒无多公事希，道心已熟壮心微。\n晚来吏散闲携杖，步到金山趁月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题濠上斋二绝 其一","author":"傅自修","text":"焉知鱼乐我非鱼，梦里荣枯觉则无。\n休学痴蝇贪纸穴，小窗烘日谩跏趺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题濠上斋二绝 其二","author":"傅自修","text":"小斋斗大四壁立，只著匡床与瓦炉。\n不涉语言君识否，莫从门外著工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再题濠上斋","author":"傅自修","text":"外物为藩篱，障此道之径。\n昧则终日迷，达者默尔静。\n子夏出入间，悦乐犹异境。\n谁能入吾乡，节令四时正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日泛舟同朱元晦","author":"傅自得","text":"秋月天然白，溪流镜样平。\n唤船同胜赏，把盏话平生。\n击楫鱼频跃，忘机鸟尚惊。\n兹游还可继，家酿为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓦山溪 早春寿京尹","author":"傅自得","text":"洪钧转处，都在薰陶内。\n瑞世得奇才，赞化工，协调和气。\n雄词健笔，谈笑斡千钧，馀闲手，尹王畿，治行称尤异。\n雍容儒雅，早合登高位。\n天路踏骅骝，看峨冠，羽仪班缀。\n东风骀荡，王斝酒鳞红，春不老，寿难穷，莫惜今朝醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仓部袁公灼像","author":"傅行简","text":"筮仕当前职度支，平衡清操畏人知。\n宣恭在位和同列，理学传家重一时。\n能击武臣强似虎，宁□宰执怒如狮。\n□□犹有弦歌化，治谱真堪百世师。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题博士袁公文苑像","author":"傅行简","text":"禽鸟春风乐与同，有将理趣道儒宗。\n两朝褒赏衣冠旧，一德充融礼乐隆。\n天地无心驰电马，人民有望慰云龙。\n馀年八十无全食，独抱青山继祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三萧行贺萧丞定夫子登科","author":"傅西斋","text":"吾乡前辈多风谊，教子读书全盛事。\n刘斯立在庆历间，二子同升俱上第。\n后来嘉祐孔长源，三子联登相后先。\n元丰四谢更同榜，一家科第光烨然。\n直到淳熙徐思叔，亦与二子连芳躅。\n又报年来萧定夫，绍定两科庭下玉。\n二百年间能几家，刘家孔家无以加。\n才名学行总名世，不但官爵称高华。\n谢家独有民师著，徐家大无鸣诗句。\n人道萧室父子三，前辈流风无让处。\n萧公要是真醇儒，家无他物惟有书。\n自家读了教儿读，夜半书声喧里闾。\n造物负公还不贫，嘉定庚辰汉庭右。\n此时二子已崭然，公曰吾心汝其懋。\n果然相继取高科，二哥饶著与三哥。\n乃翁笑向月中问，吾家桂树何其多。\n月娥报道萧家桂，生满月中香满世。\n移过东山能几年，今日方教翁满意。\n祝公此意令深长，香名当使百世芳。\n前贤事业远且大，三刘三孔尤辉光。\n世科膴仕公家有，实声莫落谢徐后。\n要知渝上一萧家，突过四家名宇宙。\n我曾与公同荐名，服公文行识公真。\n更与贤郎共文社，情谊凛凛如霜筠。\n翻笑传家三父子，草亭老人空厉志。\n曾不得名于荐书，仅有大儿前擢第。\n小儿四度试春官，尚期他日修征鞍。\n如今饥卧空山里，慨想前事悲汍澜。\n喜闻令子归锦里，夜不能眠推枕起。\n瓣香寓作三萧行，寄贺萧公当双鲤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"素馨花","author":"傅伯成","text":"昔日云鬟锁翠屏，只今烟冢伴荒城。\n香魂断续无人问，空有幽花独擅名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟和元夕御制","author":"赵鼎臣","text":"万户千门绣作团，未央宫阙耸巑岏。\n灯花无数排金粟，月魄当空倚扇纨。\n香绕御炉烟羃羃，玉瑶仙佩响珊珊。\n游人共说归来晚，一枕钧天好梦残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拟和元夕御诗","author":"赵鼎臣","text":"元夜新添一月春，曲轻花嫩未成尘。\n笙歌满地醉还醒，楼阁中天奂且轮。\n新乐妙如仪凤舞，远人动似塞鸿宾。\n不知湛露恩多少，但见三韩拜舞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五峰岩","author":"傅伯成","text":"山中亦何有，烟云扶层梯。\n叠石抚空罅，洞水涵清漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送留正知赣州","author":"傅伯成","text":"尚书镇章江，慈母怀婴儿。\n去年甫去郡，未觉棠阴移。\n如何失调驭，众目惊睽睽。\n诏书念前绩，趣起持州麾。\n重临亦云宠，去后良多思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"傅伯成","text":"岁晚松篁期苦节，春光桃李任多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春","author":"傅伯达","text":"白帝司权，炎宫回驭，一叶报秋。\n正银河高泻，金风作扇，冰轮将满，火伞初收。\n吴越传芳，斗牛钟秀，间世生贤谁与俦。\n那堪更负，过人才气，济世谋猷。\n风流花县优游，有善政廉名达郡侯。\n鹗书朝荐，泥封暮召，荣登闺籍，平步瀛洲。\n歌驻行云，舞翔回雪，寿酒深倾碧玉瓯。\n从今愿，愿龄齐鼻祖，名在丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张祜韵","author":"傅宏","text":"远望阳城湖，八九云梦吞。\n白云宿殿罅，青藓埋松根。\n樵唱林间路，渔歌寺外村。\n避喧嗜飞阁，未若叩禅门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孟郊韵","author":"傅宏","text":"修顶磨穹苍，云烟杂古床。\n僧饭钟声远，仙风桂子香。\n老桧有寒操，怪石多冷光。\n俯瞰城郭人，衮衮名利场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦君亭","author":"傅宗教","text":"隐君在何许，遗迹此山阿。\n春风闭门处，回首空烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无名木","author":"傅宗教","text":"峨峨九日峰，下有千年木。\n正异岁寒姿，命受兹也独。\n十围铁干古，百尺虬髯矗。\n不以姓名显，肯为封爵辱。\n畏名如畏虎，终焉托岩伏。\n何当大厦求，一枝亦自足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思古堂","author":"傅宗教","text":"何人凿山腹，高堂跨崔嵬。\n悠悠百年事，滚滚随尘埃。\n弃置君莫问，且复共此杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太平馆","author":"傅知录","text":"万物荣枯自有时，梅花非早菊非迟。\n时人莫似春蝴蝶，才到花开便满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙庭观 其二","author":"傅诚","text":"天风万里拥霓旌，紫凤青鸾上玉京。\n故宅一区千古在，夜深惟有月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙庭观 其一","author":"傅诚","text":"会宴瑶池阿母家，九霞光绕翠琼车。\n坐中一曲山香舞，帽上看看有落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"傅彦济","text":"千里江山供眺望，四围天地入帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮碇冈","author":"傅烈","text":"洪水未必能流山，别岛安得居人间。\n扶桑夜半光吐焰，铜龙白昼飞尘寰。\n初闻其事惊且异，传言岂或流千蛮。\n试将图牒为考订，山中记载皆班班。\n扶藜喜作山中行，胜处不复愁天悭。\n楼台自是人隔绝，峰岫直与天回环。\n凭虚搜冥一眺望，日观朱明两山向。\n乃知云浮山更浮，二山总在三山上。\n从来凡眼不见识，怪怪奇奇千万状。\n我疑灵窦皆国宝，不待山人留心匠。\n丹崖佛迹直末耳，天巩名山世基仗。\n干戈昔为闻马嵬，有坛百尺那能开。\n坐中一笑失道士，国势随灭如烟埃。\n清庙祀典岁岁举，庆基福地源源来。\n愿将此山比南山，歌诗直纪山之隈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周茂叔席上酬孟翱太博","author":"傅耆","text":"古人务乐善，见士即推毂。\n今也多忌才，对面远贤蜀。\n顾予尝喜学，幽室未偶烛。\n幸会才翘翘，深惭识碌碌。\n升堂听高论，惟愁日景促。\n经义许叩击，诗章容往复。\n荷公引重语，玞珉变良玉。\n一违几席来，羲娥变昏旭。\n远闻落帽节，宾朋相追逐。\n剩摘篱下黄，痛饮杯中醁。\n清谈已忘倦，佳篇又相勖。\n毕力为徒弟，强勉攀高躅。\n异时公行道，其势不可独。\n首愿策疲蹇，助公施蕴蓄。\n舒张太平策，散作苍生福。\n此心答此惠，庶几不忝辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"傅瑩","text":"结庐深山顶，遂怀安隐心。\n安隐如之何，道胜尘虑沈。\n青霞白云致，茂树修竹阴。\n翛然北山上，令人思重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临终诗","author":"傅得一","text":"平生胆气清高，抱道长乐逍遥。\n天地阴阳反覆，云收雾捲丹霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"傅晞俭","text":"千年饱服长生药，三朵长簪不老花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"傅梦泉","text":"吾非爱海棠，吾爱与吾恶，海棠自海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水乐洞","author":"傅梦得","text":"踏破芒鞋客倦归，暮云深处夕阳西。\n身如晚鹤无拘束，向此亭中独自栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四山任鼓院","author":"傅梦得","text":"曾向西风把别杯，知君黄色上眉催。\n浙江莫道音书隔，一日潮声两度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皂镜册","author":"傅梦得","text":"依然一册巧装成，故纸为胎越样轻。\n四畔黑云都罩尽，中间只有月长明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读夷齐传","author":"傅梦得","text":"要使清风激懦顽，饿夫宁死首阳山。\n当年若食周家粟，未必名垂万古间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德清太善寺","author":"傅梦得","text":"西风吹客过唐栖，袖拂尘埃读断碑。\n适意绕廊询古迹，老僧引看建炎诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元友山","author":"傅梦得","text":"清梦绕骚坛，相逢一笑间。\n江湖无此友，声价重于山。\n吟就髭犹撚，文穷鬓欲斑。\n移家离城市，世事不相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迥居县","author":"傅梦得","text":"经过太匆匆，山行去路通。\n客衣沾晓露，县陌带春风。\n沽酒从村市，骑牛任老翁。\n相逢有吟者，约我醉城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平江承天寺","author":"傅梦得","text":"古刹号承天，规模阔万间。\n寺中重有寺，山外更无山。\n供佛香犹在，寻僧客亦闲。\n渡淮难久驻，此去别阊关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白发","author":"傅梦得","text":"勋业未能成，青铜照眼明。\n星霜惊入鬓，天地觉无情。\n才近半百岁，渐生三两茎。\n儿童劝休镊，浪得老成名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伍林舟中","author":"傅梦得","text":"人生踪迹抵浮萍，客里行藏分外轻。\n酒力禁持风半日，橹梢摇动月三更。\n暂携琴剑随身去，且得溪山入眼清。\n著脚水乡吟思苦，未知谁得与诗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]