[{"title":"高丽扇","author":"华镇","text":"排筠贴楮缀南金，舒卷乘时巧思深。\n何必月团裁尺素，自多清爽涤烦襟。\n挥来振鹭全开羽，叠去栟榈未展心。\n利用已宜勤赏重，更堪精制出鸡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起酬廷老傅十三丈","author":"华镇","text":"既有吾身似老聃，却无道术类苏耽。\n阴阳授气还非壮，湿燥因时岂易堪。\n动戒荒嬉情谩切，坐膺消渴理宜甘。\n见贻药石诚多愧，乡党无徵只自惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐三年八月初六日得报已有代者归期可数喜动于中载形歌咏","author":"华镇","text":"郡符朝下报新官，不觉津津喜见颜。\n但怪鹊声连日好，谁知鸿翼过年还。\n心游象魏三秋后，步入庭闱数月间。\n别去祇怜风月夜，不闻山溜响潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邦彦赴阙","author":"华镇","text":"士林休复叹栖鸾，已向青云刷羽翰。\n汉殿旧闻称锦绣，燕堂当见擢芝兰。\n张帆正值霜风劲，策马何辞晓月寒。\n解道此行须特达，倾囊却愧乏琅玕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李子约户曹四纪权室","author":"华镇","text":"主人才术照几先，虚室端居宰利权。\n谁觉市征非往日，自知岁课埒当年。\n高梧六月生秋色，修竹三冬起紫烟。\n平日纷纷讥识地，不妨澄寂事经禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨中行朝散别试日院中即事","author":"华镇","text":"多士分袍日造庭，谈经议法与论兵。\n不辞寒夜程文冗，喜见明时道化行。\n此日人怀平旦气，他时中有少年卿。\n凤毛已饱籯金术，伫听传家振大名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院中闻初平别头预上舍选作诗二章以贻之 其一","author":"华镇","text":"拂晓文闱报捷音，传家始见胜籯金。\n不随门户炎凉异，须识胶庠德泽深。\n日月光华今际会，岁时风物莫侵寻。\n欲知报称君亲处，惟有忠嘉一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试院中闻初平别头预上舍选作诗二章以贻之 其二","author":"华镇","text":"龙头本是我青毡，寂寞风流数百年。\n素业久惭吾未振，遗芳今喜汝能传。\n九光瑞日才披雾，千里修途要著鞭。\n竹素纪名男子事，莫令风味愧吾先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出院有日用前韵与诸公叙别","author":"华镇","text":"频年承乏选贤关，自惜生居黍谷寒。\n雠尽加三难自暇，听残敲五敢求安。\n蒙恩邂逅真多乐，已事分飞亦足欢。\n从此尘劳能脱否，待寻蜀客试占看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和林安圣承议别试所即事","author":"华镇","text":"骤阻文闱密密关，不堪霖雨作新寒。\n暂违尘鞅閒还好，喜得朋簪静可安。\n樽俎不陈无过举，笑谈相酢有馀欢。\n共知佳节行相近，须把程文继日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"华镇","text":"陶家门户本常关，泽室肌肤雅耐寒。\n不惜春秋参贡举，况闻早晚报平安。\n款陪盛集无穷乐，细阅雄文有益欢。\n未必重阳虚过了，黄花十日尚堪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欧阳叔向见余试院中诗卷作诗见誉次韵酬之","author":"华镇","text":"未历藩篱见少陵，索涂擿埴愧冥行。\n满怀骤获连城贶，溢耳惟闻中律鸣。\n思巧本惭彫楮手，心雄方怯弃繻生。\n十年世路师良贾，今日才惊利有赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再酬叔向见谢","author":"华镇","text":"词锋笔力势凭凌，高共飞云天上行。\n清夜几通康乐梦，嘉时还嗣孟郊鸣。\n人间雅道时无丧，海内才流世有生。\n欲识篇章精密处，搜奇抉隐语无赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬叔向","author":"华镇","text":"卞玉尘多气已低，可能符采压虹霓。\n晋人自识三都丽，襄野谁教七圣迷。\n谩说违时清似水，且谋终日醉如泥。\n秦关自昔称天府，何事雄誇十二齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿潭帅李金部二首 其一","author":"华镇","text":"庆绪绵绵嗣伯阳，何时熊梦契嘉祥。\n月低蓂荚光犹满，风入林钟景正长。\n出去怀金参九列，归来画乃得三湘。\n遥知当日瞻佳气，还似兹辰赌寿香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿潭帅李金部二首 其二","author":"华镇","text":"汎汎薰风入舜弦，西楼晚月十分圆。\n悬弧门下占祥日，仗节湘南出师年。\n善诵咏歌盈玉叶，寿觞频举倒金莲。\n紫泥褒诏知非晚，行看双旌上日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渐堂","author":"华镇","text":"君家仲季乐天长，书史优游共一堂。\n雁序此时详进止，鸰原异日竟轩昂。\n阶前兰菊幽香远，座上埙篪逸韵长。\n肃穆清风在华榜，可令进躁坐销亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舂陵闻雁","author":"华镇","text":"拥衾攲枕未成眠，历历鸿声到枕前。\n十月高风方永夜，三更疏雨欲寒天。\n衡阳亭榭真虚尔，颍水篇章是偶然。\n万里天南共为客，北书从此喜须传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和纯翁闻新雁","author":"华镇","text":"出门无绪看飞蓬，入夜还惊度早鸿。\n塞外长芦应已断，天涯尺素竟难通。\n青荧疏幌遮寒烬，窸窣高梧弄夕风。\n今夜只应攲枕后，梦魂随汝到江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和都城腊日雪","author":"华镇","text":"同云为瑞上圆清，腊日飞花落帝城。\n双阙渐迷鸳瓦碧，九街匀罩曲尘轻。\n戴溪有月舟方远，袁巷无人路自平。\n却爱马卿词赋好，梁园一座尽知倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和高邮监税李光道承务 其一","author":"华镇","text":"论交未必须白头，邂逅相逢辖屡投。\n识似方诸能鉴物，言非萱草自忘忧。\n诗书已见勤追琢，筦库何妨暂滞留。\n但喜荒斋得佳咏，清风和气日休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和高邮监税李光道承务 其二","author":"华镇","text":"兰玉才华夙有芳，撝谦高韵慕循墙。\n风流自与迂疏厚，澹泊应须气味长。\n屡见清谈能破的，行看素业骤成章。\n日生鞅掌虽无尽，投隙当来语大方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落帽山","author":"华镇","text":"落帽山头雨脚长，消愁还是感河阳。\n劳歌不解凄凉意，小饮难投酩酊乡。\n共恨今秋辜綵菊，相期来岁沃霞觞。\n须知四美人间少，一笑千金未易偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿蔡大资","author":"华镇","text":"岩岩巨镇瞻维岳，落落乔松栋干姿。\n物外风神时远鹤，几先识断世元龟。\n还逢周寝占熊旦，恰是商岩肖象时。\n愿酝东溟为寿酒，一年一献一瑶卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"项王庙","author":"华镇","text":"刘氏功名未足多，谩将带砺指山河。\n楚宫一夜虽虚垒，汉殿百年还艺禾。\n今日祠堂皆寂寞，当时江水自逶迤。\n有灵若忆生前事，应悔初为盖世歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵赠陈县丞","author":"华镇","text":"明明真理与时纷，曾把清心仔细论。\n百虑已知归妙道，一尘无复寄灵根。\n时来或可纡蓝绶，兴尽还思杜席门。\n异日傥能追逸驾，相忘不必近林园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖南运使程大卿寿","author":"华镇","text":"时来嘉会一阳新，庆属高门诞哲人。\n杞梓挺材周世用，圭璋含德足天纯。\n酒熏爱日凝和气，香触寒梅发早春。\n密运阴功方寸地，默增遐算有明神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崇宁元年五月十六日天汉桥月下閒步","author":"华镇","text":"閒来步月上银潢，天宇无尘夜色凉。\n双阙高寻佳气耸，三街平衬绿槐长。\n沈沈琳馆东西迥，袅袅珠楼左右光。\n归去不须寻蜀客，莫教知到斗牛傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高邮张生出所得诗画一轴求余作诗因书","author":"华镇","text":"千岩秀处有扁舟，不驾樵风欲五秋。\n金咮未应甘腐鼠，霜翎时自下昆邱。\n尘埃漠漠长扃户，云月漫漫独倚楼。\n好事古来常恨少，碧霄清思为君搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿西禅寺诗","author":"华镇","text":"湖湘跋涉今犹近，淮海漂流昔早曾。\n扰扰未能逃鞅掌，星星祇见变鬅鬙。\n驱车旷野犹飞雪，税驾閒窗已上灯。\n瓶锡不移缘累息，须知人世尽输僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送道守董朝散","author":"华镇","text":"香穗氤氲杂瑞烟，条风新转早春天。\n桑蓬庆集侯门日，铜竹荣居郡閤年。\n清晓十分圆玉兔，寒宵万斛照金莲。\n祝诗聊致官曹意，上古灵椿自八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱秀才索诗用韵酬之","author":"华镇","text":"新诗字字脱埃尘，几效中郎叹受辛。\n他日合为仙桂客，此时何愧布衣身。\n更无狐貉原非耻，直有箪瓢不是贫。\n雾豹南山饥不下，未惭尺蠖解求伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和潭州尹节推陪同年运使大卿知府安抚少卿知郡大夫饮会","author":"华镇","text":"一声浑化未来宫，当日联飞真乘龙。\n策足津途趋要切，掞庭华藻称纤秾。\n青云荣贯谁同得，白首朋樽此幸逢。\n乐事晚生曾未识，强赓佳句想形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题朱中老宣德墓亭","author":"华镇","text":"不矜乡版早为宾，不叹恩纶晚及身。\n物识傥来忘世累，学随所遇泽吾民。\n鸿冥轻举閒刀刃，舟壑潜移冷隙尘。\n今日户庭皆似旧，共知君有克家人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠孙纯臣居士","author":"华镇","text":"鼓腹酣歌七十馀，卧龙山北寄蓬庐。\n满堂常见斑衣舞，填巷时来长者车。\n负郭稻田周岁计，还家兰圃足晨蔬。\n闲窗尽日无馀事，时展青囊一卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上南都权府提刑孙大监二首 其一","author":"华镇","text":"声华籍籍冠诸公，三十年前浙水东。\n造次谈经皆振玉，从容遇事尽成风。\n心游迥出青尘外，名品横飞碧落中。\n留钥宪台虽重寄，方看平步入鹓鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上南都权府提刑孙大监二首 其二","author":"华镇","text":"抠衣平昔登门下，曾许横经近绛纱。\n江上一言冰玉远，天涯长叹水云赊。\n不才漫忝朱为绂，承学终惭发已华。\n今日姓名犹见齿，尚因提奖得灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中望金山寺","author":"华镇","text":"小山苍翠出江流，山上精庐望外幽。\n午影楼台连北固，夜声钟磬到扬州。\n客帆飞过朱栏角，沙鸟归栖碧瓦沟。\n南去北来长扰扰，画桡何日暂迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送德器移光州仙居令","author":"华镇","text":"邂逅旧惭无半面，追随今恨只三旬。\n高才锋颖凌长剑，和气舒迟压九春。\n百里莫言犹偪仄，三年亦可薄经纶。\n古丹应有遗方在，好使灵功被此民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬刘令见怀","author":"华镇","text":"世路差池懒自嗟，眼前随分过年华。\n山中寻药援青嶂，海上将鸥踏浅沙。\n怀旧爱君交态厚，题诗寄我素封斜。\n争知节物随人冷，十月东篱未有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊后感怀和光道韵","author":"华镇","text":"达人蔑视千钟禄，曲士惊谈五石瓢。\n腊尽自怜春气近，月明谁念美人遥。\n铅华次第开梅萼，金色依稀著柳条。\n莫问阴山更阴处，数峰残雪未全销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过鲁太师庙","author":"华镇","text":"汉家循吏得民深，素业流风尚可寻。\n愧在盛时操短刃，远来邻壤效鸣琴。\n敢论异事追前事，所喜仁心契本心。\n振辔再经驯雉境，一瞻道庙想徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题普照寺","author":"华镇","text":"刚趁閒情逐队行，忽逢萧寺眼前明。\n修廊有荫僧趺坐，古殿无人雀啄声。\n咫尺都城尘不到，寻常林木境还清。\n凭君试问轮蹄客，过此如何不解惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高风","author":"华镇","text":"一传肯来忘暑月，两旬轻举薄云霄。\n非关汉水鱼盈钓，不为宜城酒满瓢。\n方外采真欣淡泊，人间知足得逍遥。\n高风可是陶彭泽，归去田园为折腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陆彦则索诗寄之四韵","author":"华镇","text":"解官才喜此身轻，忍以冥搜损性情。\n疏懒旧来高叔夜，虚閒今日似渊明。\n愿酬美意情虽切，强缀狂歌曲不成。\n应有朱侯偷笑我，壮年不解请长缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿柯运使 其一","author":"华镇","text":"九十韶光才十九，高门曾是弄瑶璋。\n熊罴梦寐当时吉，龟鹤年龄此日长。\n刘晏已知丰外计，曹参行见趣归装。\n更看德善流芳处，济济斑衣满画堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿柯运使 其二","author":"华镇","text":"晓来迟日上高堂，珠箔玲珑锦席张。\n玉斝腾波行旨酒，金炉生穗起真香。\n融融喜气凝庭户，拂拂歌尘下栋梁。\n许步桃蹊无以报，但祈眉寿献篇章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵防禦新辟小斋诗以贻之","author":"华镇","text":"隐操真全不待山，小斋新辟户常关。\n窗延昼白明丹府，炉养春和润玉颜。\n何必金丝喧晓夕，祇将槌拂伴虚闲。\n人间兴味元恬淡，不见轮飞倦后还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代湖南张运使贺蔡右丞","author":"华镇","text":"高步英躔恰妙龄，曙华相照有馀荣。\n早逢周室遵儒雅，亲见文公迓太平。\n可但清标称玉润，共知具体得金声。\n庙堂方契千年会，侧听康哉语载赓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送傅彬老检讨赴宜兴簿","author":"华镇","text":"不是双翎羽未齐，天门欲到失云梯。\n眼前且看神仙府，身外休论枳棘栖。\n百草让茶先有味，一瓶挹水近通携。\n扁舟邂逅须乘兴，细看东风罨画溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵湖南张运判会春园新亭之什","author":"华镇","text":"落落长松满古园，沈沈碧水侵新轩。\n于今人物情虽别，平昔池台迹未昏。\n身外无尘红入座，眼前有酒绿盈樽。\n更将好乐无荒意，深入无生不二门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家二首 其一","author":"华镇","text":"莫笑田家物象微，柴荆未肯愧朱扉。\n槿篱花发锦步障，莎径叶齐丝地衣。\n葭苇吟风环竹屋，鸳鸯浴水傍苔矶。\n藜羹黍酒有馀味，笑看庭阴密又稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田家二首 其二","author":"华镇","text":"绕舍澄沟玉色方，夹堤密树俨修廊。\n霜迟留得秾阴绿，秋冷全无潦水黄。\n独木短桥通别圃，攒芦新廪出高墙。\n终年饱暖人生足，何必崎岖走异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居","author":"华镇","text":"桑弧蓬矢是男儿，故国松楸亦重违。\n架搆自知惟壁立，绸缪谁敢羡翚飞。\n桑麻地狭妻孥笑，堂庑檐低燕雀稀。\n清世薄才何所用，求田问舍未应非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其一","author":"华镇","text":"大雅读书勤苦外，肯来文会盍簪中。\n诅盟吾欲出三物，续社君当图九翁。\n绿橘未题霜降颗，黄杨才长闰馀丛。\n后成若援兰亭例，金谷樽看谁罚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其二","author":"华镇","text":"文力尤能草上风，后生横槊斗诗中。\n诸君共利先登将，一我甘为左次翁。\n水至细流皆入海，材为直木必由丛。\n笔端衮衮淳于夥，未觅膏油炙毂空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其三","author":"华镇","text":"辞宦各归千里外，满城不出数家中。\n得诗夜共嘲骚客，次韵时来寄子翁。\n已分鹭鸾垂翠葆，尚能鱼目斗珠丛。\n人生閒里还无此，白首光阴过莫空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其四","author":"华镇","text":"已在渊明归去后，只消长庆醉吟中。\n诗名未到出蓝者，酒德忘为垂白翁。\n刻烛分题喉每噤，挥杯多酌指如丛。\n拦街拍手儿童笑，十日醒无一日空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其五","author":"华镇","text":"残醉偶思京辇下，戏言堪入和章中。\n词因公度李道可，印借梦卿成孺翁。\n荒怪定逾诗律外，风流谁笔笑林丛。\n张而不弛非文武，莞尔牛刀未可空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗酒六首 其六","author":"华镇","text":"商搉文章论要公，切云千仞将坛中。\n诗人何地可安我，丑妇今朝才拜翁。\n彫玉苦心为楮叶，绣衣谩眼束柴丛。\n南邻寄谢梁兵部，险韵无劳独断空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暖斋诗","author":"华镇","text":"至足无求触处同，小斋和气日冲融。\n几筵已得啸歌地，赤白何须绘画工。\n况有午檐容爱日，曾无北户召寒风。\n清心迥出尘埃外，讵见高堂数仞崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中寄徐主簿","author":"华镇","text":"出门四幕云垂地，举目千花雪映天。\n况是光阴犹故腊，何妨时日在新年。\n不辞登顿行长道，但喜丰穰属大田。\n遥羡风流栖枳客，一焚檀篆达诚虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬道州同官雪中召饮","author":"华镇","text":"千林腊雪缀玫瑰，为送丰年好信来。\n有客倚楼吹玉笛，何人立马傍银台。\n书斋喜白临窗纸，妆阁惊藏照脸梅。\n清景可怜佳句重，为君随分把金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]