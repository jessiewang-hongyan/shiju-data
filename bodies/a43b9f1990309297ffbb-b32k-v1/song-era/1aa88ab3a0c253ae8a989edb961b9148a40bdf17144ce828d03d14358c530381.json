[{"title":"中书东厅十咏 其五 绿筱","author":"韩琦","text":"莫轻丛筱绿阴微，迸笋方抽嫩玉枝。\n结实他年臻瑞物，最宜栽向凤凰池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其六 芎藭","author":"韩琦","text":"蘼芜嘉种列群芳，禦湿前推药品良。\n时摘嫩草烹赐茗，更从云脚发清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其七 山芋","author":"韩琦","text":"随竹萦回翠蔓延，土藷名异出前编。\n会须霜晚餐珠实，可挹浮丘作地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其八 盆池","author":"韩琦","text":"圆沼泓登璧彩浮，萍新殊未覆游鯈。\n纤鳞不用时惊没，香饵虽投是直钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其九 假山","author":"韩琦","text":"危峰叠叠起丸泥，莫爱幽奇是假为。\n黄阁何功宜自劾，去寻真隐老衰疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其十 驯鹊","author":"韩琦","text":"灵鹊双双日自驯，徘徊轩槛若相亲。\n主人素解忘荣辱，何用喃喃送喜频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔象之宰韩城","author":"韩琦","text":"去年同举菊花觞，自揭清音入醉乡。\n此日高秋来一别，几旬佳节负重阳。\n风生古操安新治，雨彻疏茅锁旧堂。\n民里更繁应自化，宰君心地本空王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸西太一宫祈雨","author":"韩琦","text":"晓跸声乾下九重，西郊岑寂款琳宫。\n骄阳尚作三春旱，多稼期沾一雨丰。\n恤物致虔归上德，应诚为答即神聪。\n从来圣感无旋日，不在商岩傅说功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸西太一宫道傍耕桑者皆以茶绢赐之","author":"韩琦","text":"杪春时泽未全滂，西祷真祠徯福祥。\n蚕女舍笼惊法从，耕夫投耒目天光。\n劳勤率有优恩及，拜赐皆知佚道长。\n海内承风谁不劝，何须躬籍与躬桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸西太一宫陌上耕者叱牛声厉左右皆笑之","author":"韩琦","text":"皇心悯雨出西坰，亲祷灵宫致洁诚。\n扈跸不知农事苦，辇前争笑叱牛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸西太一宫谢雨","author":"韩琦","text":"太一尊神宅近坰，特纡天仗乞殊灵。\n清衷祠祷才三日，大澍滂沱足四溟。\n上释忧劳严报谢，民祛愁郁得康宁。\n至诚有答真如响，更异言閒退守星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从驾过金明池","author":"韩琦","text":"帐殿深沉压水开，几时宸辇一游来。\n春留苑树阴成幄，雨涨池波色染苔。\n空外长桥横螮蝀，城边真境辟蓬莱。\n匪朝侍宴临彫槛，共看龙艘夺锦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"驾幸金明池","author":"韩琦","text":"西池风景出尘寰，春豫方乘禁坐闲。\n庶俗一令趋寿域，从官齐许宴蓬山。\n楼台金碧芳菲外，舟楫笙歌浩渺间。\n与众尽欢宫漏促，万花香里属车还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崔象之国博","author":"韩琦","text":"知君为邑解铜章，却复先庐坐葆光。\n对境风幡俱不问，安禅心法两皆忘。\n满庭脩竹争高节，近砌幽兰称独芳。\n若论厌喧遭拄杖，何如趣驾返周行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰景灵宿斋谢雨","author":"韩琦","text":"邃寂敞仙扃，心斋物外清。\n滂沲今应祷，肸蚃此通诚。\n月殿栖真境，风梧醒睡声。\n如何谢灵贶，至道本难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸卯喜雪","author":"韩琦","text":"一夜阴云匝四溟，朝来嘉雪洒寰瀛。\n因风絮起先春媚，剪水花飞到地轻。\n天际定迷琼蕊屑，世间今有玉楼成。\n应时何止销民疹，直压胡沙万里清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻崔公孺国博将入都近重九未至","author":"韩琦","text":"几日知君命驾来，芳辰看失独徘徊。\n黄封御酒新沾赐，更偶金铃菊未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚秋有感","author":"韩琦","text":"倦鹊穿林趁独栖，此情唯有老鳏知。\n西风日紧重阳近，忍对黄花把酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答崔公孺国博","author":"韩琦","text":"向陪亡室鹡鸰原，正是轻霜九日天。\n醉语忘形几尔汝，诗毫挥纸速云烟。\n思穷碧落今无术，泪洒黄花两换年。\n一览嘉章生百恨，孤怀还昧觉心圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"先君写真得永叔为之赞而君谟书其侧崔公孺国博以诗称美次韵答之","author":"韩琦","text":"迁笔褒扬逸少书，孤风拂拂起襟裾。\n孝心知睹英灵在，世系元承福庆馀。\n永向净居同相好，任从深谷改丘墟。\n君诗意主称人善，义节轩然到古初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博观君谟所书孝亲崇福院牌","author":"韩琦","text":"欲护亲茔荐福殊，僧蓝营葺几年馀。\n名因先帝鸿恩锡，牌得君谟大字书。\n佛宇增辉良自尔，乡庐传美孰加予。\n须知体法多奇处，深造钟王奥妙墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博观新模邺王书","author":"韩琦","text":"唐季诸侯孰擅雄，邺邦高袭世勋洪。\n图功自可超烟阁，接士殊优在雪宫。\n刀笔风流争战外，生灵安帖笑谈中。\n诗豪墨妙家藏久，二美刊传定不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博观新模正献杜公草书","author":"韩琦","text":"珍藏正献草书诗，传诫云来示永贻。\n几夜风涛偃松柏，半天雷雨起蛟螭。\n临池学苦应同妙，舞剑功如未是奇。\n刊石岂徒为世玩，更思清节可师之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博模刻文正范公阅古堂诗","author":"韩琦","text":"阅古堂成在北边，希文诗笔美前贤。\n高吟尚纪终军策，小字如观乐毅篇。\n欲起贵名增世慕，更刊馀礼广人传。\n其他事业知难泯，尽入仁宗实录编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答崔公孺国博西亭感怀","author":"韩琦","text":"常喜交亲燕此中，忽移欢绪作悲翁。\n桃阴已盛何曾语，桧影长闲不厌风。\n数漏趁朝心拱北，忍饥开阁客盈东。\n人生易别须偷暇，为我樽前话苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲辰冬雨","author":"韩琦","text":"凛气回轻燠，凉飙绝怒号。\n飞霙难自拆，细雨反如缫。\n惠泽非常降，祥编想共褒。\n民阎清岁疠，农亩得春膏。\n天意虽滂洽，人心尚郁陶。\n未逢银瓮出，不见玉楼高。\n酒兴来差浅，诗情病少豪。\n曾看纷似絮，举白待风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留崔公孺国博","author":"韩琦","text":"虚亭还喜叩禅诠，顿觉襟怀鄙吝捐。\n陶暑屡开河朔饮，聚星看别颍川贤。\n我縻东府成衰叟，君向西湖即洞天。\n且缓归期时一笑，及瓜趋阙动三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳重九","author":"韩琦","text":"苦厌繁机少适怀，欣逢重九启宾罍。\n招贤敢并翘材馆，乐事难追戏马台。\n藓布乱钱乘雨出，雁排新阵拂云来。\n何年得遇樽前菊，此日花随月令开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乙巳郊礼庆成五言二十韵","author":"韩琦","text":"尧历方归圣，虞琴始就声。\n不先惟帝飨，孰见事天明。\n谷旦诹阳复，鸿仪备吉行。\n宸襟正祗谨，阴孽忽孳萌。\n淫雨频兴阵，寒花几坠琼。\n多言摇改卜，上意益专精。\n宗社敷冥祐，穹苍答至诚。\n斗收连日晦，并与祀时晴。\n待晓披阊阖，凝旒下紫清。\n真廷陈洁馔，亲庙展嘉牲。\n爱旭辉黄道，非烟护綵城。\n旌旗停藻卫，铙吹起严更。\n冕服祛繁饰，坛壝即自成。\n晶荧奠琮璧，和雅荐英茎。\n继志还虚次，尊神戒侧迎。\n千龄俄受胙，万乘已旋衡。\n峣阙层霄迥，通衢众目倾。\n疏刑空犴狱，霈泽浃寰瀛。\n统业恢长治，生灵入太平。\n因知却徽号，传迹固难名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博西亭感怀","author":"韩琦","text":"常虚西馆待高贤，一见襟怀两释然。\n且叩真诠期进道，不论衰鬓逐凋年。\n顽金在矿须当变，逸骥无鞭亦自前。\n相叩屡辞虽未得，已齐朝市与林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感春贻崔公孺国博","author":"韩琦","text":"春来天气作轻寒，故使春芳欲见难。\n赖得好风摅俗愤，顿开韶景与人看。\n诗情遇敌豪虽减，杯兴逢辰老未阑。\n幸遇亲朋时枉驾，且偷壶刻奉清欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博黄杏花","author":"韩琦","text":"颗颗装成药灶牙，日边开处近彤霞。\n真宜相阁栽培物，更是仙人种植花。\n高行出群犹仰慕，香名超格合洪誇。\n诸贤继有寻芳会，欲奉欢游决自差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻崔公孺国博","author":"韩琦","text":"三十年来契分隆，更从亲炙达真空。\n明非独善诸昏破，理到无心万事通。\n莫话离悰伤祖席，且留欢刻醉春风。\n海棠亭下花看发，坏子胭脂点点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔公孺国博游兴国寺广严院","author":"韩琦","text":"绀园南北压通寰，气象超然出世间。\n只见庄严尊十地，不须微琐说三山。\n浮云自缚春春失，真境无尘事事闲。\n我有归依殊胜愿，吏文常扰几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答崔公孺国博西亭燕饮","author":"韩琦","text":"一稔繁机困备员，芳时何暇目春妍。\n自惭东阁延才地，得会西豪聚里贤。\n益友至言皆有味，禅宗高论邈无边。\n须知樽酒相留意，老去离怀异少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙午上巳琼林苑赐筵","author":"韩琦","text":"春光浓簇宝津楼，楼下新波涨鸭头。\n嘉节难逢真上巳，赐筵荣入小瀛洲。\n仙园雨过花遗靥，御陌风长絮走球。\n禊饮不须辞巨白，清明来日尚归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"首夏西亭","author":"韩琦","text":"一霎轻尘小雨过，园林风物尚清和。\n巢栖旧燕将成子，盆植新莲未出荷。\n欲就好峰添异石，恶侵芳卉斸狂莎。\n病襟萧索宾如市，孤负良辰乐事多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"召赴天章阁观新刻仁宗御诗","author":"韩琦","text":"天阁当年拂雾宣，紫皇端扆侍群仙。\n亲挥龙凤轩腾字，命继咸韶雅正篇。\n劝酌屡行均圣宠，赐花中出夺春妍。\n玉峰光景都如旧，但睇宸章极泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔国博西亭喜雨","author":"韩琦","text":"暑雨滂然仅作霖，连宵殊未扩阴森。\n全祛下土将焚患，尽识高穹不忍心。\n斗厌埃氛开众目，了无烦热自吾襟。\n当轩倍胜松风过，何必清音一弄琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永兴寒食后池","author":"韩琦","text":"春意阴阴百五天，小池萧索会僚贤。\n孤芳映水花终淡，劲竹凌轩节自全。\n一阵森严林势合，万鱼跳落雨痕圆。\n当筵暂弭忧边虑，且伏诗魔驾酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"席上自和","author":"韩琦","text":"喜陶嘉节曲池边，薄酒何须辨圣贤。\n谈席且誇珠履盛，种羌谁问蚁封全。\n白杨花落眠蚕老，红杏枝残笑靥圆。\n不似丁年为帅日，醉乡方拟拍浮船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明兴庆池上","author":"韩琦","text":"连日阴岑此日晴，池头风物称清明。\n万鳞潜养云头坼，一鉴新开水面平。\n两两凫鹥波上没，憧憧车马柳间行。\n嘉宾须惜难并会，莫厌芳樽冷淡倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"垂萝洞","author":"韩琦","text":"池北如趋紫府家，亭台高下景无涯。\n垂杨下绊游春骑，曲水时飘出洞花。\n万本竹深丛剑戟，一轩藤老缠龙蛇。\n使君欲共斯民乐，莫顾西山下日车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳会兴庆池二首 其一","author":"韩琦","text":"元巳开樽处，垂萝碧洞前。\n绮罗明浩渺，台榭插漪涟。\n曲水来如篆，轻桡去若仙。\n春寒芳意晚，未见柳飞绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳会兴庆池二首 其二","author":"韩琦","text":"兴庆池头三月三，柳如拖绶草如衫。\n禊觞临水筵相属，文鹢凌波尾竞衔。\n花雨乱飞红扑蔌，峰螺遥耸碧崭岩。\n芳辰况任游人乐，不必低将席帽搀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳晚游九曲池","author":"韩琦","text":"九曲池边第一开，舣舟同赏尽高才。\n弯流自得黄河势，怪石应从紫阁来。\n尘外恍迷仙境界，竹间深有古亭台。\n徘徊复至丰碑下，花萼吁嗟作盗灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴马上","author":"韩琦","text":"正是风和日暖天，重阴凌扰苦缠绵。\n蕉心自结凭谁展，柳眼慷开只待眠。\n草湿谩铺留醉席，榆寒难掷买春钱。\n几时霞外氛霾散，放出红轮一丈圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻转运范纯仁司封会兴庆池","author":"韩琦","text":"池榭春深合众芳，使台来赏好风光。\n波头滟日琉璃软，酒面摇花琥珀香。\n访古旧文昏琬琰，记游新刻上筼筜。\n临归定借西园步，愈觉禅诠气味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登广教院阁","author":"韩琦","text":"岑寂禅扉启昼关，公馀为会一开颜。\n高台面垒包平野，老柏参天碍远山。\n花去春丛蝴蝶乱，雨匀朝圃桔槔闲。\n徘徊轩槛何时下，直待前枝倦鹊还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏北禅牡丹","author":"韩琦","text":"一春颜色与花王，况在庄严北道场。\n美艳且推三辅冠，嘉名谁较两京强。\n已攒仙府霞为叶，更夺熏炉麝作香。\n会得轻寒天意绪，故延芳景助飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和都运孙永待制广教院三头牡丹","author":"韩琦","text":"骈枝三出牡丹红，奇有双头结未工。\n宛似灵芝相并秀，瑞云攒处起香风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏西禅牡丹","author":"韩琦","text":"几酌西禅对牡丹，秾芳还似北禅看。\n千球紫绣擎熏炷，万叶红云砌宝冠。\n直把醉容欺玉斝，满将春色上金盘。\n魏花一本须称后，十朵齐开面曲栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月望日会兴庆池","author":"韩琦","text":"莫厌烦蒸共此行，临流台榭极高明。\n风前自得披襟兴，林杪时闻脱裤声。\n洞竹交阴冠盖爽，砌泉争响梦魂清。\n凭轩最切云霓望，日待民田雨足耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湫马上始见终南","author":"韩琦","text":"终南频月晦峰峦，一雨民心万事宽。\n救彻旱苗充岁望，洗开山色与人看。\n半天横示全秦壮，积雪高连太白寒。\n欲识众多欣幸意，送湫歌舞满长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会故集贤崔侍郎园池","author":"韩琦","text":"崔园高绝五门西，尘外风光是处宜。\n唐室旧池因地得，汉宫遗址上楼知。\n青螺万岭前为障，碧玉千竿近作篱。\n我住邺台殊草创，一来尤觉愬归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋","author":"韩琦","text":"门径萦纡洞府间，了无尘外累幽闲。\n长杨十丈乱风雨，流水数枝鸣佩环。\n入户好峰谁可画，碍人新竹不容删。\n池亭面面圆荷满，薄暮飞香送客还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登崔园城上亭","author":"韩琦","text":"危榭厌颓基，登临事可悽。\n邱墟唐殿左，禾黍汉宫西。\n台古疑藏剑，峰遥不见圭。\n山川难尽识，赖有旧图携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览诸人赠狄国宾察推诗","author":"韩琦","text":"凛凛梁公万世尊，复唐功业并乾坤。\n为臣所守能忠义，异代犹思录子孙。\n老嗣寂寥虽未振，大名瞻仰只如存。\n后人真有希颜志，岂特孤风擅一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范纯仁司封移漕京西","author":"韩琦","text":"衰拙何堪定绎骚，使台犹喜会英髦。\n治财绝扰常先恕，移用皆宜似不劳。\n此去任贤终漕挽，几时当路压风涛。\n家声莫拟君能绍，日看青云步步高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉榭池上二阕 其一","author":"韩琦","text":"游鳞惊触绿荷香，水马成群股脚长。\n逐浪相追留篆迹，偃波垂露满芳塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉榭池上二阕 其二","author":"韩琦","text":"病襟思适绕东塘，水荇初花吐嫩黄。\n行困老樗阴下坐，儿童争喜拾红娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其一 流泉","author":"韩琦","text":"龙首高源析，螭吭乱玉锵。\n带花春共远，和雨夜何长。\n冷撼青蛇影，平拖白练光。\n烦襟来自涤，可待濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其二 凉榭","author":"韩琦","text":"忠闵规摹壮，耽然大厦开。\n无时佳燕在，正暑好风来。\n池面飞泉落，林端畏景回。\n谁知仙府路，琼室与瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其三 北塘","author":"韩琦","text":"台榭生凉处，奫沦瞰北塘。\n松筠成夏荫，莲芰入秋香。\n疏雨交寒晕，轻云衬晓光。\n无心投钓饵，游鲤莫惊藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安府舍十咏 其四 双石","author":"韩琦","text":"双石唐馀物，来兹孰记年。\n嵌空危砌下，怪丑好花前。\n名氏坳犹刻，藤萝穴任穿。\n最宜秋后看，班驳藓痕圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":37010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]