[{"title":"题胡运干别墅 其一","author":"白玉蟾","text":"闷来爱竹把花嫌，无事看山高捲帘。\n好鸟一声飞过檐，清风著力送银蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖凤亭 其四","author":"白玉蟾","text":"声传琴瑟风生枕，影泻琅玕月满庭。\n白凤飞来枝外宿，夜深点破一林青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖凤亭 其三","author":"白玉蟾","text":"潘氏亭前饮一宵，酒酣对竹啸琼箫。\n不知栖凤来多少，凤去人归竹寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖凤亭 其二","author":"白玉蟾","text":"竹也多年管风月，凤兮几夜宿云烟。\n林间有客吹箫去，竹化成龙凤入天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题栖凤亭 其一","author":"白玉蟾","text":"亭前绿密玉成丛，凤宿枝头烟雨空。\n箫管一声人未寝，满林明月浸清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题桐柏观","author":"白玉蟾","text":"淡月笼苍松，清流蘸脩竹。\n水深蟾不设，长伴道人宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题桐柏观","author":"白玉蟾","text":"仙翁夜来扣林壑，约我明朝过南岳。\n石坛对坐话松风，鹤唳一声山月落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莫干山","author":"白玉蟾","text":"封到半天烟霭间，一卷仙书一粒丹。\n城南城北无老树，又吹竹笛过前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠黄亭虞丈","author":"白玉蟾","text":"修爵固当修天爵，选官何似选天官。\n青驺走遍皇都易，白鹤飞来绛阙难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题精舍","author":"白玉蟾","text":"到此黄昏飒飒风，岩头只见药炉空。\n不堪花落烟飞处，又听寒猿哭晦翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题潘察院竹园壁","author":"白玉蟾","text":"夜雨洗开千翡翠，春风撼碎万琅玕。\n满林鸦鹊卧明月，铁笛一声烟正寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题凝翠阁","author":"白玉蟾","text":"日射新苔铸绿钱，山耸花屏草刺毡。\n剩把苔钱买风月，山屏低拥草毡眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第一代祖师正一静应真君讳道陵字辅汉","author":"白玉蟾","text":"云锦山前鍊大丹，六天魔魅骨毛寒。\n一从飞鹤归玄省，烟雨潇潇玉局坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第七代讳仲回字德昌","author":"白玉蟾","text":"当年辟谷炼仙丹，召雨呼雷譬似闲。\n四海有人膺宝箓，笑携筇去鹤鸣山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第九代讳符字德信","author":"白玉蟾","text":"上饶山水甲江南，一锡横飞欲结庵。\n忽遇至人烟霭外，归来无语隐松岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十一代讳秉字温甫","author":"白玉蟾","text":"火腹金龟梦正疑，琳房初诞谪仙儿。\n丹传祖印百来岁，执笏归仙地震时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十七代讳象中字拱辰","author":"白玉蟾","text":"仁皇恩赐紫衣时，方是宁馨七岁儿。\n闲把洞章歌一阕，不知鸾鹤满天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十九代讳景端字子仁","author":"白玉蟾","text":"当年仙去鹤巢空，万壑千崖夕照红。\n人在丹丘玄圃外，潇潇松桂夜来风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十二代讳善字元长","author":"白玉蟾","text":"参遍名山谒洞天，相逢却是活神仙。\n归来换骨回阳日，屈指人间九十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十八代讳敦复字延之","author":"白玉蟾","text":"棘围战罢笑归来，一寸功名心已灰。\n白鹤何年归洞府，夕阳影里野猿哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十三代讳季文字仲归","author":"白玉蟾","text":"玉盂祝水起波云，笔下雷声泣鬼神。\n龙虎山前山后问，先生活尽几多人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十五代讳乾曜","author":"白玉蟾","text":"横握镆铘入洞天，洞天漠漠掩寒烟。\n仁宗亲问金丹诀，笑指斜阳噪乱蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十六代讳嗣宗","author":"白玉蟾","text":"朱砂鼎里炼金晶，默祷天皇入紫冥。\n月落半山丹井水，猿声惊断满天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十代讳谌字坚德","author":"白玉蟾","text":"吸乾酒海一须臾，冠冕玄坛百岁馀。\n不食人间烟火气，能传天上电花书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二十四代讳正随字宝神","author":"白玉蟾","text":"人在犁锄烟水乡，结茅高卧小松岗。\n敕封真静先生号，一卷仙经一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第二代嗣师讳衡字灵真","author":"白玉蟾","text":"光和初载大丹成，有甚工夫事汉灵。\n夜半玉舆飞紫露，春风春雨满阳平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第八代讳迥字彦超","author":"白玉蟾","text":"丹篆才书泣鬼神，年踰九十脱红尘。\n至今岩上结庐处，夜半凤凰栖绿筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第十一代讳通字仲达","author":"白玉蟾","text":"闭户凝神四十年，青鸾赤玺策云轩。\n琼棺数月金躯冷，满室天香酹一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第十七代讳顺字仲孚","author":"白玉蟾","text":"贵溪一尉隐家山，静结茅庐三两间。\n九十岁时尸解日，时人犹见是童颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第十九代讳修字德真","author":"白玉蟾","text":"玉局瑶篇龙凤文，三元开度士如云。\n翻身踏著蓬莱路，浴罢焚香自入坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赞历代天师 第十二代讳仲常字德润","author":"白玉蟾","text":"鹤书曾诏赴宸京，归作分形化景人。\n昨日饮酣曾吐酒，醒来又薄瓮头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c