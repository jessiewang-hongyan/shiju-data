b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吴道士","author":"白玉蟾","text":"延陵大士诗中虎，接武黄陈肩李杜。\n无盐争敢陋西施，也向雷门声布鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张知堂","author":"白玉蟾","text":"清河知堂武当来，左日右月双眼开。\n高卧云堂留梦醒，笑骑白鹤归蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠沙书先生","author":"白玉蟾","text":"生蛇满地走如飞，入石三分未是奇。\n掇取恒河归掌握，毫毛不动始知机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈孔目","author":"白玉蟾","text":"制锦堂前万事闲，掉头来入武夷山。\n当年种放如能学，白鹤青云也不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈先生 其三","author":"白玉蟾","text":"翻身趯倒玉葫芦，神水华池一夜枯。\n蓦地夜行见月影，水晶盘里走明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈先生 其二","author":"白玉蟾","text":"木人手里挥泥剑，石女头边带铁花。\n龙汉元年冬上巳，相逢一盏赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈先生 其一","author":"白玉蟾","text":"炯炯双眸古老锥，手提向上大钳锤。\n蓦然寻著钟离老，捉住长髯问是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠明讲师 其二","author":"白玉蟾","text":"岂谓东吴得再逢，二俱老尽少时容。\n来从上国莺花里，堕在辋川图画中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠明讲师 其一","author":"白玉蟾","text":"昔从师在月岩时，我过鹅湖即语离。\n每见孤鸿每生感，不曾一日不相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠诗仙","author":"白玉蟾","text":"学诗有似学仙难，炼句难于学炼丹。\n换骨脱胎君有诀，炷香特特扣诗坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士徐碧眼","author":"白玉蟾","text":"碧眼何须青白为，冰辞雹语不吾欺。\n君看衮衮腰金者，曾见骚坛大将谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠徐钟头","author":"白玉蟾","text":"楼上疏钟撞月明，五云影里一声声。\n九天星宿皆朝斗，人世晓鸡浑未鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠徐翔卿之别","author":"白玉蟾","text":"桃花落地雨漫漫，子乃担簦过万山。\n临别有些无尽意，篇诗送子到崇安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠船稍","author":"白玉蟾","text":"苦海无船渡，众生到岸难。\n劝君齐著力，结取万人欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠葆元","author":"白玉蟾","text":"弃儒为见儒多误，学道缘吾道化贤。\n且把功名权架阁，抱琴随我去修仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠蓝琴士 其三","author":"白玉蟾","text":"夜来莫说西山冷，见说庐山夏有冰。\n直恐与君相别后，错听猿啸作琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠蓝琴士 其二","author":"白玉蟾","text":"逍遥阁下暮烟生，相对无言坐复行。\n弹尽胡笳十八拍，床头剑吼月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠蓝琴士 其一","author":"白玉蟾","text":"江湖见说老蓝公，今日相逢在玉隆。\n竹样精神梅样骨，况君梅竹在胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"螺青山下皆地锦花","author":"白玉蟾","text":"螺青山绾青螺髻，地锦花铺锦地衣。\n雨过花娇山色茜，疑山解舞欲狂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蟋蟀 其二","author":"白玉蟾","text":"秋暮何聊饮不多，素空皓月舞傞傞。\n也知落叶风前拍，似应寒蛩砌下歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蟋蟀 其一","author":"白玉蟾","text":"白发秋来又几茎，萍蓬湖海困平生。\n三更窗外芭蕉影，九月床头蟋蟀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霞隐","author":"白玉蟾","text":"仙翁栖紫霞，颜童鬓不华。\n客来问玄机，笑指菖蒲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"露珠","author":"白玉蟾","text":"秋河一滴露，夜堕即珠然。\n吹入玉盘里，走盘如许圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月三日即事","author":"白玉蟾","text":"烟冷浑沾水，溪清可数鱼。\n鸦翻千点墨，雁草数行书。\n今日征帆下，前年上国初。\n诗盟寒复讲，无酒兴何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月十四夜","author":"白玉蟾","text":"十月十四夜，灯寒燄寸长。\n披衣临曲水，把笔向清霜。\n月透诗情冷，风吹醉面凉。\n故人知得否，空断早梅肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月芙蓉","author":"白玉蟾","text":"岂论春夏及秋冬，事事皆由造化工。\n谁道一生无好运，何缘三月见芙蓉。\n骚人犹恐东风误，醉眼真疑芍药红。\n便是重阳开未晚，且传好意取欢容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三华院还丹诗","author":"白玉蟾","text":"绛宫无事绝尘埃，坎虎离龙战几回。\n白雪飞空铅蕊绽，黄云覆鼎汞花开。\n龟蛇抱一成丹药，乌兔凝真结望胎。\n夜半瀛洲寒月落，冷风吹鹤上蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三衢舟次 其二","author":"白玉蟾","text":"困兽犹强剑未红，少年羞见白蘋风。\n心寒赤县神州远，兴入胡庭沙漠浓。\n谁谓阿蒙犹洛下，未应老亮更隆中。\n年来弓矢浑无用，只好江头射暮鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]