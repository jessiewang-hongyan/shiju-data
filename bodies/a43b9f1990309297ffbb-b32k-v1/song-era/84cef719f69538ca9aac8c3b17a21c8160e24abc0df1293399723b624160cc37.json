[{"title":"次韵送邓祭酒 其四","author":"员兴宗","text":"去去不忧豺虎边，阳关几作絮飞旋。\n挥金将对父老语，锄豆勿遣根株连。\n闭目时教风扫地，沉心大似水涵天。\n西湖淡妆君念否，十客何时十指然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知郡前日见过顾念雨霪不止盖苗而未穟频雨者嘉生之祥也继此真可以止矣因赋二篇拜呈 其一","author":"员兴宗","text":"东田水决西田流，十日雨汁少日休。\n勿厌唾金夜缕缕，准拟炊玉秋浮浮。\n我欣清肠免牛吼，坐快赤子非鱼头。\n社鬼豚蹄政浪得，使君端是监河侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知郡前日见过顾念雨霪不止盖苗而未穟频雨者嘉生之祥也继此真可以止矣因赋二篇拜呈 其二","author":"员兴宗","text":"欲堕之雨天垂垂，三山容态无定姿。\n陇边风回香作饵，头上云黑疑催诗。\n粘壁蜗牛心得计，沸天蚊豹口何施。\n请占锦绣纹开后，勿把琉璃钟自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用子文韵呈李参议彦泽 其一","author":"员兴宗","text":"行殿青冥天尽头，草间祇解老伊周。\n中吴谁命虎牙将，重赵几成牛后羞。\n君去忘家勿忘国，我悲非剑亦非缑。\n动容乞予功名地，不作西南斗样州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用子文韵呈李参议彦泽 其二","author":"员兴宗","text":"驱车翻盖电非追，有客有客公门驰。\n双鸿西至一书堕，五马南边三峡迟。\n况值神倾意豁士，无愁岁暮日斜时。\n张眸指注话乡国，为说两川犹漏卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺阳帅 其一","author":"员兴宗","text":"使节西来快旧游，淳和一洗蜀鹃愁。\n文章星斗三千帙，号令风雷六十州。\n北虏伫瞻司马相，南夷祇畏卧龙侯。\n愿君翻出调元手，万亿春兮万亿秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺阳帅 其二","author":"员兴宗","text":"西掖北门明辩馀，道家岂与法家殊。\n父为鸿渐子鹏举，兄是龙驹弟凤雏。\n金版六韬回地轴，玉衡七政总天枢。\n谁知左相兵刑外，草就歌诗颂有虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云安赠张殿直","author":"员兴宗","text":"旅愁不放上双眉，倚杖长吟李杜诗。\n虎胆狼心须畏伏，凤肌鹤骨恣诙奇。\n章非索海无成日，句想穿天有得时。\n珍重公孙才力健，著鞭努力看追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张郎中出守潼川","author":"员兴宗","text":"亭筑休休未作难，晚因观物遂观澜。\n不赊日月沾新渥，肯对星辰恋旧官。\n龟策幽幽馀处索，牛头衮衮静中看。\n杜鹃口血老臣泪，勿信东川甫也叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与利州守 其一","author":"员兴宗","text":"一襟和气敌春阳，教本宽仁镇益昌。\n未问禁中留召毕，且欣剑外得龚黄。\n奔驰蜀道三千远，控制秦关百二强。\n况是太平今有象，边城处处乐耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与利州守 其二","author":"员兴宗","text":"剑关云栈蜀西头，公在平川最上流。\n五百里中为甸服，一千年里作贤侯。\n城乌想尔齐师遁，边马从他魏使愁。\n燕寝凝香无所事，姓名料想覆金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与利州守 其三","author":"员兴宗","text":"夙称无尽老先生，况复乡贤继踵荣。\n和气四时调玉烛，德辉千里照金城。\n群歌太守来何暮，细数长安去几程。\n仰察帝心应有在，时分台曜近周京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何知郡子文跨鳌观灯","author":"员兴宗","text":"山中胜践蜀中稀，炯炯鳌头吐火齐。\n牛斗下流明夜径，蟾轮飞窟堕山西。\n诸公泛泛千觞稳，我梦蘧蘧一蝶迷。\n异日端门千仗散，也能拥首听朝鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送喻志夫登第西归","author":"员兴宗","text":"羡翁诗礼饱丘园，况有诸孙名义传。\n得雨蛟龙势逐逐，接翰凫凤声联联。\n灵明入地含一笑，痴客问天今九年。\n合沓高名吉人后，会题影响叠前篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游西林寺","author":"员兴宗","text":"寺外青骢拥月题，寺中笑语逐云低。\n不知春色老不老，来访禅林西复西。\n心地虚明檐外竹，舌声长广眼前溪。\n幽寻寓我清凉境，何必羁愁念故栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖","author":"员兴宗","text":"湖光无碍雨溟濛，且任兰桡去路通。\n珍重群仙三日约，忍教春色二分空。\n人言羁思鸥前破，天遣清樽我辈同。\n笑指城闉倦归思，晚晴对起舞雩风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿李巽岩","author":"员兴宗","text":"乌衣巷陌尽清閒，鸾鹤飘然任往还。\n九棘三槐前鲁国，一椿五桂老燕山。\n姓名玉笈琅函上，班次珠宫贝阙间。\n数百年来传洛学，尽从尹喜望秦关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿张母","author":"员兴宗","text":"楚玉骚头云锦裳，天然智术自成章。\n仙娥宫里香风远，慈姥岩前慧日长。\n良夜北阴循轨革，清秋西母荐壶觞。\n愿言桐桂皆萧吕，叶数宏开八九行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月初雨中渡西湖因至道人庵烧佛香略憩灵隐与乡僧同啜茶乘晚以归 其一","author":"员兴宗","text":"猎猎风攲袖，垂垂雨打船。\n最怜荷似屋，不障水如天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月初雨中渡西湖因至道人庵烧佛香略憩灵隐与乡僧同啜茶乘晚以归 其二","author":"员兴宗","text":"溪头断续雨，松下送迎僧。\n世境不到处，心融意自澄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月初雨中渡西湖因至道人庵烧佛香略憩灵隐与乡僧同啜茶乘晚以归 其三","author":"员兴宗","text":"久困尘埃梦，暂随香火缘。\n栖鸦急残照，我亦踏归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"燕居","author":"员兴宗","text":"今我非故我，行禅坐亦禅。\n送风当八面，一钵老三川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新滩险恶不可前遂出乘滩下舟作诗送滩上舟","author":"员兴宗","text":"水面数千里，赖公托此身。\n如何阻恶滩，与我为参辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代舟答","author":"员兴宗","text":"我实假众力，送君游蛮荆。\n滩危不可前，徒有济川名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再送舟","author":"员兴宗","text":"公非不通险，任重载者浅。\n此去荷责轻，又得先归便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟再答","author":"员兴宗","text":"此去责虽轻，恐为商贾资。\n细瓷枉压我，使我成徇私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木樨花二首 其一","author":"员兴宗","text":"承露珠微微，弄态金浅浅。\n秋风一披拂，清意忽作远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木樨花二首 其二","author":"员兴宗","text":"山空花更幽，日透香自永。\n只欠攲月梅，同汝弄疏影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和何知郡子文冬日即事","author":"员兴宗","text":"甲观吾何事，丁年岁又周。\n霜馀一尊在，梅过百花羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上许大卿 其一","author":"员兴宗","text":"因嗟零落栖迟客，旧注聱牙诘屈书。\n脚踏红尘愧泉石，身无清梦到蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上许大卿 其二","author":"员兴宗","text":"晴雾青冥马首来，道逢双剑倚天开。\n北轩赋就含经纬，斗觉灵光气象推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中春尽言怀","author":"员兴宗","text":"万象无涯春有涯，愁肠几逐梦魂赊。\n解吟整整堂堂句，胜看红红白白花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往省陇阡遭雨有感","author":"员兴宗","text":"村烟渐稀村径失，山雨或过山花泣。\n此身浩浩几转蓬，此口离离当挂壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"走笔送王省干","author":"员兴宗","text":"秦树青冥马首来，路逢双剑倚天开。\n江山细入骚人眼，好带诗囊古锦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其一","author":"员兴宗","text":"好在青山成独往，无端赤县拥清曹。\n会须披草对田叟，岂问无豪即易高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其二","author":"员兴宗","text":"闭门不出我何为，词之洽矣昌其诗。\n暗边沈谢可摸索，高处曹刘任指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其三","author":"员兴宗","text":"月锻便驱诗入社，年侵何赖酒为徒。\n而今便作顾夫子，白绢搭头閒著书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其四","author":"员兴宗","text":"文到黄初扫地无，我辈乃欲窥唐虞。\n崇崇笔冢遽如许，劫劫饥坑有是夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其五","author":"员兴宗","text":"草色当阶绿渐侵，我观物化岂无心。\n风轩纳絮春无赖，雨屋关愁夜不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其六","author":"员兴宗","text":"墙外遥峰列黛眉，堂开尚友好栖迟。\n且栽筠筱成千个，与管烟霞当一司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其七","author":"员兴宗","text":"手弄茶月玉川子，肠入诗星贾浪仙。\n寒吟苦饮息万动，两公等是区中贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其八","author":"员兴宗","text":"陕府东郊魏仲先，曾言无事小神仙。\n而今懒残浑到我，去子百年仍著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其九","author":"员兴宗","text":"一秋病暑暑才退，终日倦书书不翻。\n生怕朝衫誇若若，且容居士号闲闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴十首 其十","author":"员兴宗","text":"舍南百尺树骇绿，篱外一梢梅破春。\n不须访我伶俜事，尽有幽花料理人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题岘山图","author":"员兴宗","text":"樽俎当年缓带公，山月自高亭自远。\n荣荣枯枯几晋馀，世外蓬莱忽清浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题灞桥图","author":"员兴宗","text":"百篇醉倒长安市，古今只数骑鲸李。\n何事骑驴踏玉沙，诗叟一寒乃如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春事已深终日坐忘有感","author":"员兴宗","text":"静中我不记吾谁，户外春摇百卉腓。\n何处圣贤留个个，勿喧孔老竞师师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江头送别 其一","author":"员兴宗","text":"别语离离风作恶，羁情滚滚江何尽。\n石头路滑好一驱，入境迟公提正令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江头送别 其二","author":"员兴宗","text":"乙夜览奏天震动，甲科除郎君等閒。\n玉堂再至不小却，语边勿惜鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白云洞 其一","author":"员兴宗","text":"我有孤心寓白云，白云起处自心亲。\n白衣苍狗今休问，且伴研朱点易人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白云洞 其二","author":"员兴宗","text":"归岩无定出无心，过客从何议浅深。\n只欠太湖三万顷，吞空不许世尘侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石照","author":"员兴宗","text":"吴中市井汉淮阴，落拓钱郎用意深。\n希世异人人不识，却因顽石遂知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题普慈官舍竹轩","author":"员兴宗","text":"一生悯悯寄儒冠，客路羁愁特地寒。\n拟倩幽梅当供给，旋添疏竹报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘生公说法堂","author":"员兴宗","text":"折天一径入林幽，乱石牙牙蹲虎丘。\n不为生公夜点首，世间般若自头头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠金山老","author":"员兴宗","text":"一铃自语风薄林，千涛夜涌月翻金。\n寺内何人口生醭，阿师政尔息深深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"距西湖五里至白塔院名蓝连五六最幽绝云","author":"员兴宗","text":"清流汩汩树斜斜，胜地金山底处家。\n总是光明拳下路，任人击竹笑桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶经西湖林逋故宅四圣观见旁畜野鹤立草径对之萧然有怀 其一","author":"员兴宗","text":"未分幽容相料理，只缘老子合婆娑。\n此中琢句出冰玉，曾吸湖光奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶经西湖林逋故宅四圣观见旁畜野鹤立草径对之萧然有怀 其二","author":"员兴宗","text":"霜草深披野径开，幽情端有鹤相媒。\n笔椽拟欲题三尺，悔欠一龟行李来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再往上竺游渡西湖忽晴忽雨凄然有感 其一","author":"员兴宗","text":"湖头接城城满烟，湖尾乱树昏连连。\n从前触境关心事，万里桥边家可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再往上竺游渡西湖忽晴忽雨凄然有感 其二","author":"员兴宗","text":"乍浓乍散后前雨，相笑相迎来往舟。\n四山眩转我作恶，不惯长湖生许愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游凌云寺","author":"员兴宗","text":"半日缘云看九峰，江狂树怪满双瞳。\n可怜玉磬僧廊下，未奏一声郊庙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"射潮","author":"员兴宗","text":"望中劈箭度轻篙，谁省侬家意气豪。\n潮落潮生不关汝，三吴是处有风涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋中再至西湖荷花半残凄然有后时之叹纵步投夜归城中 其一","author":"员兴宗","text":"未暇鸥前弄清泚，都缘帽底踏黄埃。\n荷花净尽有底急，不待商量细细开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋中再至西湖荷花半残凄然有后时之叹纵步投夜归城中 其二","author":"员兴宗","text":"禁当芳意忽蝉噪，张主客愁惟雁声。\n赖有清沂舞雩态，湖穷却与月同行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王检讨年丈以足疾辞归天台 其一","author":"员兴宗","text":"孤心琳宇事无事，再拜玉门山上山。\n重至玉堂合小却，好抽金匮为重删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王检讨年丈以足疾辞归天台 其二","author":"员兴宗","text":"天台真人分天章，曾为诗翁扫秕糠。\n公过故山忽呼出，物从众昧视荒荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王检讨年丈以足疾辞归天台 其三","author":"员兴宗","text":"幽情不作宦情薄，众足群知尊足存。\n收拾青鞋聊示病，踏鲲却遍水云村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白古风高奇或曰能促为竹枝歌体何如戏促李歌为数章 其一","author":"员兴宗","text":"黄河溟溟日落海，逝川流光不相待。\n春容去我秋发衰，拟欲餐霞驻光彩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白古风高奇或曰能促为竹枝歌体何如戏促李歌为数章 其二","author":"员兴宗","text":"天津三月桃与李，朝能断肠暮流水。\n绿珠黄犬悲相续，何如湖海鸱夷子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白古风高奇或曰能促为竹枝歌体何如戏促李歌为数章 其三","author":"员兴宗","text":"郢客遗音飞上天，谁歌此曲谁为传。\n但闻色声纷唱和，使我默叹心悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李太白古风高奇或曰能促为竹枝歌体何如戏促李歌为数章 其四","author":"员兴宗","text":"郑客入关行未已，逢人见谓祖龙死。\n秦人竟去无来踪，千载桃源隔流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆州 其一","author":"员兴宗","text":"有客张陵曾寓此，仙乎仙乎生实死。\n鸿名制作往事空，盛迹今应颂天子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆州 其二","author":"员兴宗","text":"笑杀丹渊吐语轻，山城都不似川城。\n不知禁路春风透，几放溪山照眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]