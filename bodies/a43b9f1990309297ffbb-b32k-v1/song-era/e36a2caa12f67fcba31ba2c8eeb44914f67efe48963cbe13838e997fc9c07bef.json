[{"title":"送客不及","author":"钱惟演","text":"桥阔川长恨已多，斑骓嘶断隔云萝。\n遥山几叠迷朱旆，芳草经时驻玉珂。\n高鸟可能追夕照，绿杨空自拂微波。\n短辕白鼻何由得，目送层楼一雁过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高学士知越","author":"钱惟演","text":"粉署为郎鬓雪侵，酒酣风驶惜分襟。\n云迷水馆春旗润，树绕山城暝角深。\n下担挂钩传密意，渡江桃叶听遗音。\n孤莺啼罢芳心歇，倦翼因君忆故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"钱惟演","text":"汉苑辞千柰，仙丘访五芝。\n汲瓶春溜满，卷裓晓云滋。\n望刹青龙起，观涛白马驰。\n红楼曾应制，佳句咏朝緌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送禅照大师归越","author":"钱惟演","text":"金刹杳霞扃，南风漾彩舲。\n吴天六幕远，越岫万螺青。\n龙篆霏雕像，鲸涛注净瓶。\n上方堪迥望，支策见春溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归天宁万年禅院","author":"钱惟演","text":"绝巘依沧海，疑君际紫氛。\n岩扉晴落雪，宝地昼生云。\n净馔芝房秀，深炉桂叶熏。\n宰官游未得，空愧北山文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归护国寺 其二","author":"钱惟演","text":"白道萦回彻上方，薰然风信满归航。\n五芝岩秀经行熟，千柰园深宴坐凉。\n吟久半轩移海日，定回诸壑散天香。\n忘年宝契由来厚，终谢繁缨捧钵囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题云门山雍熙院","author":"钱惟演","text":"精舍依岩巘，香林结薜萝。\n崇台涵夕霭，危阁架春波。\n净馔供蒲塞，真诠译贝多。\n几时辉昼锦，松下驻鸣珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄灵仙观舒职方学士","author":"钱惟演","text":"方瞳玄鬓粉闱郎，绛阙斋心奉紫皇。\n徵士高怀云在岭，骚人秋思水周堂。\n闲园露草开三径，灵宇华灯烛九光。\n知有美田堪种玉，几时春渚逐归艎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨","author":"钱惟演","text":"紫花青蒂压枝繁，秋实离离出上兰。\n东海圆圭无柰碧，嵰州甜雪不胜寒。\n已忧仙佩悬珠重，更恐金刀切玉难。\n自与相如解痟渴，何须琼蕊作朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"馆中新蝉","author":"钱惟演","text":"冉冉光风泛紫兰，新声含怨日将残。\n自怜伴雀成团扇，谁许迎秋集武冠。\n委蜕亭皋随木叶，飞緌云表拂仙盘。\n青葱玉树连金爵，不觉醯鸡竞羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登师欲东归因成五言","author":"钱惟演","text":"谁谓元戎幕，今同长者家。\n一音闻说法，五叶见开花。\n久住生车耳，因闲长道牙。\n方期注金策，休梦赤城霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁中庭树","author":"钱惟演","text":"紫闼分阴地，丹条擢秀时。\n高枝接温树，密叶覆辛夷。\n夜影瑶光接，晨英玉露滋。\n乘春好封殖，为赋角弓诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槿花","author":"钱惟演","text":"绮霞初结处，珠露未晞时。\n宝树宁三尺，华灯更九枝。\n亭亭方自喜，黯黯却成悲。\n欲作飞烟散，犹怜反照迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤","author":"钱惟演","text":"碧树阴浓接玉墀，几年飞舞伴长离。\n天渊风雨多秋意，辽海烟波失旧期。\n自许一鸣闻迥汉，可随三匝绕空枝。\n从来腐鼠何曾顾，不似鹓雏枉见疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜月","author":"钱惟演","text":"霜月正如钩，临池更上楼。\n沈侯新觉瘦，宋玉旧多愁。\n獭髓分膏密，鹅毛写恨稠。\n长怀寄归雁，归雁自悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳玉津园赐宴","author":"钱惟演","text":"汉家传洛饮，楚俗泛兰泉。\n玉液初颁酒，金盘屡击鲜。\n珥彤寻竹籞，倾盖集芝廛。\n锦羽翻晴旭，霞英落暖烟。\n雅音和舜乐，睿泽洽尧天。\n更听承云曲，同歌在镐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以蜀纸端砚寄仙芝","author":"钱惟演","text":"腻茧裁邛部，苍崖映越溪。\n展时云冉冉，呵久露凄凄。\n平滑逾鹅素，精钢类袅蹄。\n轻于汉宫縠，碧似夏王圭。\n钿轴聊闲卷，银钩且醉题。\n即时封密诏，别有武都泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋","author":"钱惟演","text":"玉甃引清泉，风高露白天。\n盈盈临一水，羃羃隔长烟。\n已分兰芝溺，仍忧赵后仙。\n鲛丝衣更密，珠蚌泪长圆。\n瑟怨来湘浦，鸿惊近洛川。\n金塘正斜照，谁倚木兰船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别墅","author":"钱惟演","text":"别馆斗城傍，斜轩映曲房。\n苍头冠绿帻，中妇织流黄。\n复道登平乐，期门集未央。\n意钱梁冀宅，挟瑟莫愁堂。\n走马章台柳，停车陌上桑。\n彀弓随宝障，投辖付银床。\n出戴繁星急，归冲细雨忙。\n曾过阿君宿，醉舞起跳梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜宴","author":"钱惟演","text":"昨夜宴南堂，华灯烛九光。\n削青争落笔，举白斗飞觞。\n祇觉辉裴玉，宁思梦谢塘。\n解烦多蜜勺，藉俎半兰芳。\n促席风弦怨，开帘月露凉。\n酡颜君莫诉，西北转银潢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宣曲二十二韵","author":"钱惟演","text":"绛缕初分后，银镮未解时。\n已障纨扇笑，犹捧玉壶悲。\n乞巧长生殿，迎风太液池。\n雕屏涵火齐，宝帐隔琉璃。\n欲买词人赋，空传狎客诗。\n蔗浆销内热，琼蕊疗朝饥。\n绮蒂桃初熟，红心草欲披。\n凌波渡罗袜，向日翳华芝。\n素脸分丹柰，香津滴紫梨。\n龙梭随振素，獭髓补凝脂。\n蓬饵重阳节，金针七夕期。\n玉膏尝滵溢，翠盖逐葳蕤。\n弦急哀随指，歌长恨入眉。\n青鸾惟有舞，赤凤可能疑。\n下蔡迷还易，平阳破未知。\n髻高钗自坠，腰细佩长垂。\n出恐严钟晚，归嫌钿幰迟。\n辘轳惊晓梦，鹦鹉漏春思。\n魂怨惟愁断，肠柔已自危。\n璧珰萤影度，琼户藓花滋。\n掩鼻谗难诉，披图悔岂追。\n祇应金带枕，聊为达微辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"珊瑚笔格","author":"钱惟演","text":"蕴粹沧波远，搜奇铁网劳。\n柔条钻火树，丽景夺星旄。\n丛倚栖油几，枝疏荐兔毫。\n宝跗光互映，翠匣价相高。\n钩谩标祥谍，人须咏楚骚。\n休将铁如意，碎击为争豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜对月","author":"钱惟演","text":"颢气中秋正，明河左界长。\n桂孤香易散，蚌冷泪先汪。\n飞盖倾兰坂，鸣琴厌烛房。\n玉盘浮浩露，素绠冰寒浆。\n浪白江连楚，风凄笛怨羌。\n庾楼聊顾慕，潘省更悲凉。\n雪漫誇圆璧，珠休号夜光。\n嫦娥悔孀独，空见海生桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致斋太一宫","author":"钱惟演","text":"斋洁奉惟馨，瑶台独自升。\n楼迷五里雾，坛烛九枝灯。\n珠馆来青雀，琁题射玉绳。\n疏钟平野阔，古柏夕霏凝。\n鹤扇真规月，仙衣可镂冰。\n春茶泛云液，晓饭荐兰蒸。\n弃药疑洪井，藏书类羽陵。\n回瞻太帝室，飞槛更长凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷花","author":"钱惟演","text":"水阔雨萧萧，风微影自摇。\n徐娘羞半面，楚女妒纤腰。\n别恨抛深浦，遗香逐画桡。\n华灯连雾夕，钿合映霞朝。\n泪有鲛人见，魂须宋玉招。\n凌波终未渡，疑待鹊为桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清风十韵","author":"钱惟演","text":"溽暑迎秋尽，凉飔逗晓回。\n起蘋初淅沥，猎桂更徘徊。\n欲引长烟素，微飘画烛煤。\n坠桐侵玉井，拂柳度章台。\n已觉云翘动，还惊月幌开。\n鲛帘移乱影，瑶瑟泛馀哀。\n扇掩藏鸾羽，荷倾侧露杯。\n正当河左界，不待雨东来。\n自好抟垂翼，宁劳起死灰。\n楚宫谁第赋，宋玉最多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"休沐端居有怀希圣少卿学士","author":"钱惟演","text":"雕盘琼蕊冰寒凘，密树蝉嘶下直时。\n更赋新诗答灵运，不将团扇隔元规。\n经梅绿草沿阶上，尽日流风转蕙迟。\n祇待觚棱照初旭，横经还集绛纱韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和司空相公假山","author":"钱惟演","text":"斸得古云根，苍苍藓痕布。\n丛倚状峰岚，霏微起烟素。\n参差衡霍列，巉崒虬龙聚。\n挥扇动林风，飞香暗岩户。\n谁言盈尺内，自有青霄路。\n相君机务閒，玩此怀真趣。\n兴似东山归，境对曹溪悟。\n美矣仁智心，良哉圣明辅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枢密王左丞宅新菊","author":"钱惟演","text":"贺燕翻飞地，灵芳茂遂时。\n阴连桃李径，润接凤凰池。\n夕照挥金葆，轻风拂翠蕤。\n露珠清自冱，烟素引还披。\n西颢霜虽劲，南荣暖更滋。\n撷芳多楚泽，得地胜陶篱。\n味可登兰籍，香应夺桂旗。\n愿公长却老，宴寝奉琼卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张无梦归天台山","author":"钱惟演","text":"金庭霞标云半中，岩扉涧户凌太空。\n飘飘灵气际浮景，蝉蜕万物乘高风。\n吾君当天坐环极，物色异人方侧席。\n岂因垂钓识羔裘，不假张罗得凫舄。\n恩深况遇千龄旦，威颜咫尺隆宸盼。\n问政应同牧马言，临轩几动犹龙叹。\n方瞳玉骨本无羁，驰烟驭气思东归。\n江南芳草正无际，林下群莺犹乱飞。\n浮丘挹袂去何处，五芝同晓仙露晞。\n人间秘境不可识，千载宸章焕岩壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归护国寺 其一","author":"钱惟演","text":"曹溪有真嗣，是名大知识。\n得法三十年，堂堂坐岩石。\n忽徇云玺招，暂屈冥鸿翼。\n褰裳度王城，夙驾来军壁。\n陆泉正持戒，到溉方蔬食。\n晨炉薝卜霏，夜榻氍毹积。\n金钵稻脂香，琼瓯茗花碧。\n高谈入幽固，默对探虚寂。\n学精西竺言，诗妙南朝格。\n与游欣雾润，鄙吝犹泉涤。\n遽忆五芝春，悠然理归策。\n伊予病且老，末景如驹隙。\n惭为中军帅，更玷台臣席。\n无功翊熙明，何力当优绩。\n莲社久栖心，华簪聊寄迹。\n愿辞食地封，永事弥天释。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪居汉东撰曲","author":"钱惟演","text":"城上风光莺语乱，城下烟波春拍岸。\n绿杨芳草几时休，泪眼愁肠先已断。\n情怀渐变成衰晚，鸾鉴朱颜惊暗换。\n昔年多病厌芳樽，今日芳樽惟恐浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"钱惟演","text":"锦箨参差朱槛曲。\n露濯文犀和粉绿。\n未容浓翠伴桃红，已许纤枝留凤宿。\n嫩似春荑明似玉。\n一寸芳心谁管束。\n劝君速吃莫踟蹰，看被南风吹作竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十四","author":"钱惟演","text":"高为天一柱，秀作海三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十六","author":"钱惟演","text":"五马持山节，三衣对水田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十三","author":"钱惟演","text":"深沉蛛网通归梦，紫翠春山接去舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"钱惟演","text":"厅前捉到须依法，合内盛来定付厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十六","author":"钱惟演","text":"东南地迥宵烽息，西北楼高晚望迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"钱惟演","text":"坐激鲜飙湘竹晓，树含凉雨越禽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"钱惟演","text":"客亭厌见名长短，村酒那能辨圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十五","author":"钱惟演","text":"金牛此地通巴栈，黄鸟当时颂汉臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"钱惟演","text":"日上故陵烟漠漠，春归空苑水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"钱惟演","text":"平槛晓波吴榜渡，绕城春树越禽飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"钱惟演","text":"疏钟静起军城晚，华表双高水国秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十二","author":"钱惟演","text":"朱饰两轮巡属邑，案留双笔在中台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe52