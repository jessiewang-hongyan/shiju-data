fe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十一","author":"钱惟演","text":"鱼尾故宫迷草树，龙鳞平隰自风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十四","author":"钱惟演","text":"神庭古柏啼乌起，斋室虚帘宿雾通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偈","author":"钱盖","text":"稽首文殊师，昔为七佛祖。\n尝发大悲愿，广度诸有情。\n念彼东北方，是为清凉境。\n龙神五百俱，眷属万菩萨。\n设化于此土，示现无量光。\n闻者叹希有，何况目所见。\n我于曩劫中，曾种种供养。\n今复得亲近，瞻睹异于常。\n念无始劫来，有尘沙数罪。\n一获光明相，释然尽消灭。\n又念诸众生，与我同体性。\n乘此胜妙力，离苦愁解脱。\n我今永归依，敬礼发弘誓。\n愿尽未来际，常居佛会中。\n一闻微妙音，即證无上道。\n十方虚空界，一切诸有情。\n尽愿同我心，速悟无生忍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归护国寺","author":"钱景臻","text":"天台多胜概，落日乱山青。\n不似三峰好，楼台入翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵苑寺","author":"钱朝隐","text":"马前山色连天起，竹外溪声动地来。\n试过溪桥访山寺，清风为我拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜕龙洞","author":"钱朝隐","text":"凡骨何年蜕洞岩，真龙肯向此中蟠。\n料应夜半凌空去，雷震千山风雨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]