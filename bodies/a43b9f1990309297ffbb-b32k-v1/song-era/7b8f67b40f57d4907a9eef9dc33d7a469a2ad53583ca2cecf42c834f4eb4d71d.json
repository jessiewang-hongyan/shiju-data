[{"title":"翟园 其二","author":"释居简","text":"黄雀儿随玉屑栽，两行珠翠一般开。\n桃花少似玄都观，曾却仙都谱系来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宽堂赵左藏泣子","author":"释居简","text":"广寒秋思苦，桂霣最芳枝。\n既失鸾胶助，宁忘獭髓医。\n彭于殇有间，苍与昊安知。\n不独天难问，人间更问谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘隐别驾别造杨龟山祠堂拜奠于三月既望","author":"释居简","text":"导洛疏伊断在兹，度溪湔祓振荒祠。\n人心未泯犹知劝，事力虽殚岂惮为。\n清似山阴修禊后，煖于沂上咏归时。\n熊罴祥叶期丰报，应有南康别驾儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张别驾饶州之任","author":"释居简","text":"絮飞无迹送行舟，春树江云共献酬。\n国子先生为太守，碧山学士作监州。\n晴开庐阜微茫晓，籁挟芝山汗漫秋。\n华月光风在怀袖，同吟同啸莫鸿沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林国博自兴化军得饶州","author":"释居简","text":"盍缀蓬仙向上班，烹鲜不鄙作州难。\n醉眸尚带壶云碧，吟笔疑翻璧浪乾。\n名著金闺方善下，春生玉树不知寒。\n明年全榜登科记，莫把寻常举送看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"慈感寺蚌珠尊者阁新成","author":"释居简","text":"部勒溪山胜，横陈压丽谯。\n老蟾栖峭峙，饥蜃吐岧峣。\n蘋洁翻波碎，尘红到岸消。\n蚌珠方广士，瘦影落清苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊三高亭","author":"释居简","text":"莼丝鲈脍不如施，歌散虽工又带讥。\n墙壁年时俱有耳，莫嗔鸥鹭往来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵昌折枝芍药","author":"释居简","text":"韶光欲尽伴荼蘼，收拾华风在一枝。\n不惜丹铅和露写，惜它姚魏不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐别驾","author":"释居简","text":"出门骑无驴，拟絷刚风骑。\n问之何因尔，蜚度弱水涯。\n弱水三万里，风烟接蓬趾。\n仰止蓬山云，青红湿窗几。\n煌煌华玉枝，采采黄金芝。\n瀣零濯鲜好，归来赋三岛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"捣纸","author":"释居简","text":"万杵不为轻，丁宁玉汝成。\n忽闻敲月响，误作捣衣声。\n整整云添薄，方方雪更明。\n沉思过秦手，古恨满笺生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵宜兴讣至 其一","author":"释居简","text":"千绪乱纭纭，今才整得清。\n泉羞廉不污，镜笑丑嫌明。\n方听棠阴颂，俄传薤露声。\n半规华月老，囧囧又东生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵宜兴讣至 其二","author":"释居简","text":"百里寄丰凶，休仍与戚同。\n小心三日妇，宏略九年弓。\n犊用刀偿价，人疑蔀发蒙。\n来年花满县，何似去年红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郡博士贺龟山祠新成 其一","author":"释居简","text":"经术修明可保邦，凛然冠佩陈堂堂。\n竞传溪上诸贤聚，渐得门前一水香。\n疏剪新篁看抱节，诛锄恶草戒侵墙。\n美轮美奂从人颂，潜德虽幽愈耿光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郡博士贺龟山祠新成 其二","author":"释居简","text":"肃瞻老屋话因依，再振工夫岂浪施。\n学士贱秦麟妄出，老天祚宋凤来仪。\n崇儒允叶休明运，溢美宜删赋咏词。\n弗待文兴自今古，源源未必不由兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郡博士贺龟山祠新成 其三","author":"释居简","text":"业从师授巧无师，孟子何曾负子思。\n华月不从修处缺，景星还自望中垂。\n伪从所恶生成党，判自持方不中规。\n欲扣两端今已矣，忘言独与故吾期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘练师归绵州","author":"释居简","text":"掾署生贤梦，君生几岁知。\n江围帝子阁，藓晕海棕诗。\n铅岂无成日，筇须有化时。\n怕挥天宝泪，莫话浴妃池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荆山刘成道相过","author":"释居简","text":"系船敲竹户，剥啄异常声。\n灯醒夜来喜，猿因晨起惊。\n葵英和露熟，云子与秋明。\n恨杀西风急，如何驻水程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张公洞","author":"释居简","text":"仙蹊九地更深层，扪磴扳崖谢瘦藤。\n候彻鼎芽抽薿薿，滴残钟乳缀棱棱。\n诡形象物疑成怪，虚处存神唤得应。\n惆怅石驴鞭不起，弗如鸡犬解骞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"善拳洞","author":"释居简","text":"一山三洞幽，两洞碧通流。\n龙占层渊沕，鱼凭四足游。\n远舒云际望，凉惬水边留。\n更卜重来约，岩前石点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祝英台墓在善拳寺后","author":"释居简","text":"作奇男子事，博约访名流。\n只似深闺住，爰从断柬求。\n窗低延月入，幌冷为云留。\n只好寻班谢，泉台约雅游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何监宫云凹","author":"释居简","text":"凹处移将凸处填，悠悠填满乱山颠。\n是中自有从龙便，勿谓春风不偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴秀州自通判即真","author":"释居简","text":"乡来风月渺鸿沟，已属而今第一流。\n九转可曾图速效，双旌何足叹迟留。\n暂纡青绶宣新化，应对黄花动古愁。\n倘有无人耕处地，欲投瘦策问菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十四日自寿 其一","author":"释居简","text":"九月明朝望，思亲到鹡鸰。\n不曾生日醉，未必死时醒。\n有命羞同甲，无钱喜放丁。\n六千三万夕，款曲度残零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十四日自寿 其二","author":"释居简","text":"檐外无多地，秋芳以类从。\n负暄存爱敬，趱课策疏慵。\n勺月酬闲燕，留云备缀缝。\n莫言太早计，吾欲御玄冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送鄂渚秋官陈伯奇兼柬阮广文","author":"释居简","text":"荣如李郭舟，小为蜀僧留。\n江汉渺何许，琴书占上游。\n贪程人易别，劳劝酒难酬。\n黄鹤风烟古，何曾怕搅搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"相士雷舌","author":"释居简","text":"尽道雷无舌，雷无舌可乎。\n不曾藏霹雳，又自笑喑呜。\n菊减霜前馥，筠添雪后腴。\n莫同姚魏看，姚魏望秋殂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王司理之官南徐","author":"释居简","text":"南徐非古徐，或云古徐州。\n乡来徐州牧，亦有大耳刘。\n手携紫髯生，分踞很石筹。\n不知何所筹，楚醪相献酬。\n石无一日转，名有千年留。\n石很不足道，人很宁弗瘳。\n君掾南徐官，盍为南徐谋。\n诚开金石坚，德举毫忽輶。\n鄙薄久自化，强矫终当柔。\n平反惟厥中，此外吾何求。\n君家老卿月，威惠半九畴。\n悠然豁斯道，付与诸郎由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋贤良见过","author":"释居简","text":"莫登百尺楼，岂无湖海豪。\n莫挥北海尊，岂无老风骚。\n风骚脆霜叶，郑卫壮虎牢。\n龌龊胜宏放，昆吾避铅刀。\n竞利黩奇货，遇士輶纤毫。\n妄冀款段驰，不使鸾鹄高。\n弱羽与微类，聚族喧林皋。\n残粒酬渴饥，堕叶争爬搔。\n忽乘吹送起，遂记荫翳翱。\n因风不知反，堕地宁偿劳。\n颠顿失故步，悲叫寻丛蒿。\n击搏恐不免，弹射安得逃。\n仰窥扶摇翮，俯愧腹背毛。\n美人隔秋水，煖霭明春袍。\n访旧溪上寺，泊我寺外濠。\n开端问戒鼠，次及铭瘗獒。\n坚穷与壮老，指摘仍绎缫。\n玉石体自异，瑕颣宁容韬。\n清评盍用恕，白战恶足鏖。\n试请避三舍，大弨方载櫜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄石龟翁总干","author":"释居简","text":"龟灵诗亦灵，铁瓮渺江城。\n爆得风骚兆，铿为琬琰声。\n看如容易得，吟却最难成。\n只有兰陵月，知余入细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高教授讣至","author":"释居简","text":"竞俗奔奔急，潜窥却步难。\n退知藏用密，居得秉彝安。\n有袜常番著，无弦敢废弹。\n谢城空冷帐，回首一汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆别驾解组","author":"释居简","text":"不平容赴愬，无枉不相关。\n契托今州牧，官同旧笋班。\n骚情吟未尽，乐府载将还。\n况是平分手，新声课小蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡提干卜居","author":"释居简","text":"男儿胸中奇，忍作怀土羞。\n冒荣复素食，矧乃羞之尤。\n谩令儿女曹，欣戚相喧啾。\n东家新买邻，百万未易酬。\n邻人何人斯，百万蒱博俦。\n娄叱九折驭，朗吟三硖秋。\n结客尽群玉，税驾半九州。\n痹存万间志，资乏三径谋。\n长沙与吴会，岂必真菟裘。\n濯足门前溪，泛月溪上舟。\n有客共吟啸，有书同校雠。\n有时鼓瑟琴，亦复飞觥筹。\n论士笑浮俗，得失令人愁。\n重官不重名，不约常相侔。\n乡来飞将军，渠岂不足侯。\n名落天地间，迥觉天地遒。\n谬侯纷如蚁，千古众楚咻。\n至今谬与贤，渭与泾殊流。\n高名独不死，天地同悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"续铁炉步志寄平江太守","author":"释居简","text":"惟虚不竞实，薄俗崇虚名。\n岂其乡来实，虚课今日成。\n因依铁炉步，自昔闻题评。\n橐籥废已久，百鍊馀晶晶。\n大而函牛鼎，小而割鸡刃。\n刀也玉如泥，锥也囊脱颖。\n箕裘既失绪，族属庸振领。\n区区欲就铸，水浒方接轸。\n譬彼赵善战，奢抗狼虎秦。\n括也读父书，言外欠发明。\n奢死括驾赵，两眼空无人。\n全提四十万，一窖埋长平。\n括固不足道，谬甚用括者。\n用名弗核实，铸错败良冶。\n曩时阖闾城，呻吟满四野。\n忽闻襦裤歌，一日变风雅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"歌太湖迓常守王寺丞","author":"释居简","text":"伊谁量太湖，三万六千顷。\n天围几何宽，满湖不畦畛。\n或疑湖底天可田，笺天亟问县官请。\n况复周家有成法，尽底均作八家井。\n鲸鹏蛟鳄俱幽屏，藻荇糵为禾黍颖，公田利与私田准。\n坐令虞芮俗，化作西伯境。\n野田无哭声，夜厖亦不惊。\n晏眠早作日以宁，已输再输毋娄征。\n循良在上如西京，媚长牙爪俱逡逡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舣舟黄叔向部纲南徐","author":"释居简","text":"三顾凄凉后，今谁抱膝吟。\n有人皆肉食，无舌变枭音。\n颖脱三千客，囊空四万金。\n孤舟犹系岸，江碧柳阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳 其一","author":"释居简","text":"江春欲到最先知，次到南枝次北枝。\n不信楼头观旖旎，嫩金匀遍去年丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳 其二","author":"释居简","text":"奈尔萦晴殢雨何，静时常少动时多。\n初无恼乱春风意，却是春风恼乱它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠制香蜡茶者","author":"释居简","text":"玄质团团玉不如，翠钿小切试昆吾。\n文园病酒文君老，盍荐芳甘瀹道腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周漕泊舟寺前","author":"释居简","text":"见说淮东使者归，耄鲵都作小儿啼。\n暂闲绿野停鸿鹄，小俟青冥骤駃騠。\n度外二三皆胜策，胸中十万未全提。\n浯溪尚有崭天石，颂德歌功尽可题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山 其一","author":"释居简","text":"弹压奔鲸障怒飞，削成峭峙不分支。\n自檐滴外水为地，于海潮中石涌坻。\n蜀浪春肥浮棹急，淮云晓湿度江迟。\n中泠一滴清如玉，弗与滔滔混浊移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金山 其二","author":"释居简","text":"不占南徐地，遥分北固天。\n削琼标巨浸，坚壁下长川。\n城柝偏遥夜，淮烽直近壖。\n建炎天子圣，翠辇到层颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋塘陈敬父挽章","author":"释居简","text":"百尺楼头卧，傍无一寸梯。\n谈知秋鬓苦，豪压暮潮低。\n白璧羞瓴甋，青丝老駃騠。\n不能回晚照，相与就刀圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"释居简","text":"一点春深燕子泥，卷帘不记燕归时。\n牡丹又逐朝霞散，亟课残经更不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石龟廨宇可山","author":"释居简","text":"城中窥寸碧，益远益难真。\n檐外开荒垒，天涯见似人。\n骤观虽小有，侧看亦横陈。\n蜡屐随山视，幽寻谩苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"于潜张长官荣上","author":"释居简","text":"岞崿峰前古子男，万家喜气接浮岚。\n许曾蜕俗今留迹，坡为寻僧旧驻骖。\n养志不违宜膝下，去天差近似城南。\n明年一县花如锦，日日春风伴燕酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"米知县之官建平","author":"释居简","text":"凛然晋宋美风姿，又似君家古少仪。\n剧县一经名辈作，春江相与白鸥宜。\n盘根小试难藏利，剖竹乔迁勿复疑。\n鸡犬相闻才隔岸，日边书到欲先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬滕主簿","author":"释居简","text":"帆开得便风，从事果何从。\n研滑磨穿底，毫铦贾勇锋。\n三千篇谩与，十四字休封。\n岁晚论交地，由来淡胜浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张令人诵经","author":"释居简","text":"沉思何处雨花零，彷佛灵山会上曾。\n不愧后来成佛女，宛如前辈在家僧。\n翳花去眼空无蒂，老玉胜春瘦弗棱。\n相伴灵椿岁寒操，共看两干又传灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荆山","author":"释居简","text":"隐不知山浅，端如璞在荆。\n草滋皆玉色，松籁作江声。\n莽莽嫌吟俗，滔滔笑渭清。\n莫将云锦橐，容易小能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘母墓","author":"释居简","text":"怒虎跑云此处传，到今知是几何年。\n一弯碧似回珠浦，数曲青藏瘗玉田。\n彤管旋添今日史，白华何补乡来篇。\n诔辞尽出骚人社，行橐犹能得细诠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次宜兴谢长官借榻韵","author":"释居简","text":"挂帆来迓新邦伯，不与邮亭计短长。\n旧习澹如黄阁老，骚情闲寄碧云房。\n空濛得处花生笔，滟潋斟时月满觞。\n想见客毡寒不寐，自将宿火拨残香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡子安见漫堂","author":"释居简","text":"一与慈湖别，怀君十五年。\n衣曾知密付，人不是虚传。\n气老凌秋爽，诗成指日仙。\n相逢卯金子，应有碧云笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胡子安荷花","author":"释居简","text":"出水依稀带露痕，采毫羞涩愧旌能。\n细思语不经人道，揖逊安州食蜜僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠皓律师","author":"释居简","text":"皓也毗尼学，精于玉帐严。\n蚁酣停扫砌，燕乳记勾帘。\n茶鼎敲冰煮，花壶漉水添。\n梦回池草绿，忍践绿纤纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄徽州谢使君密斋","author":"释居简","text":"新安产最良，引类赴文房。\n太守五四友，管城三二王。\n水分千里月，春满六州棠。\n丹穴皆鲜羽，丛霄看颉颃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孙氏封禅碑如囤俗呼囤碑","author":"释居简","text":"拆裂金刀地，三分得一分。\n干戈未奠枕，封禅已刊文。\n符瑞规前谬，勋劳诧后闻。\n水中龙欲下，矫首蜀江濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"修玉楼","author":"释居简","text":"故郡楼居者，宜州太史家。\n浦寒云掩镜，研冷笔生花。\n月砌亭亭玉，风签猎猎牙。\n合簪酬大雅，一战冢淫哇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涨水叹","author":"释居简","text":"去年水为祟，数州害田稚。\n今年逾去年，低陌吞高阡。\n天时杳难度，耕者虞沟壑。\n问天如何其，天空无磴梯。\n苍然不可诘，试诘天所司。\n司方责公田，皇暇恤我私。\n率先盈囷仓，又欲丰盛粢。\n长呼天不闻，问司胡不思。\n反裘惜奇毳，里尽毳孰资。\n司云心是丰凶本，帝哀尔氓乱方寸。\n遂令腐烂不可支，甚若秦皇齐威尸。\n佞壬矫诳至于此，天横伤残乃其自。\n涛翻天上第一禅，所感召者诚宜然。\n或讥浮图事吟笺，法当勿用浮图言。\n少陵琳琅千万篇，留人间者百不一。\n亦师粲可缚禅寂，不知此话何从出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻沈宏父讣","author":"释居简","text":"云裘未换貂，鬓已几茎彫。\n璞美宜穹售，楼成或下招。\n生无金润屋，死有玉蕃苗。\n欲酹余不土，天浆弗满瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚牧图","author":"释居简","text":"寸绳尺箠乱山深，节制安知竖子心。\n老子看牛如相马，微茫淡墨赏遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴兄仲孚","author":"释居简","text":"策慵推病枕，刺字忽来前。\n未说名瓜子，先传姓口天。\n鸿蜚烦送目，蛩响动吟肩。\n穷与穷相值，秋风已飒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蟠松","author":"释居简","text":"肯为人低首，非因米折腰。\n曲何惭九地，直恐碍丛霄。\n雪虐知擎重，风酸不怕摇。\n乔林多裂干，弗后岁寒彫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣姜贫乐谢长兴长赵可斋 其一","author":"释居简","text":"葬近陈朝桧，伤心绝笔吟。\n家馀乞米帖，囊尽掷蛙金。\n语戆贫难屈，名膻死弗沉。\n王孙种花县，何似古藤阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣姜贫乐谢长兴长赵可斋 其二","author":"释居简","text":"金尽骅骝死，交游散似云。\n五穷逐不去，百拙巧难分。\n竹唁梅疏友，鸥随鹭吊群。\n未铭先传散，勒遍霅川濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]