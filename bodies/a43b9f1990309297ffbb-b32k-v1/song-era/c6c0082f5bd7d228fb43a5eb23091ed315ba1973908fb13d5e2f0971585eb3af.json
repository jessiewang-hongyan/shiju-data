[{"title":"喜雪","author":"洪朋","text":"已啭春风百鸟声，斩新飞雪满江城。\n漫天乾雨纷纷闇，到地空花片片明。\n白玉九衢惊晓起，黄云千亩看秋成。\n更怜洗尽年年瘴，山鬼忧幽不敢行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谢德夫","author":"洪朋","text":"泮宫儒先谢安石，平生笑傲东山游。\n朅来客授江湖晚，不废声延涧壑秋。\n青青子衿惜分索，馥馥芳袖萦离愁。\n丈夫富贵恐不免，富贵应须趁黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送师川","author":"洪朋","text":"去年徐郎诗句新，今来徐郎思不群。\n帝子楼前阅秋浪，秦人洞口入朝云。\n忽思赤壁过吾弟，更向舒州迎细君。\n及此瓦盆春酒满，烧灯夜雨重论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代饯无为马使君口号","author":"洪朋","text":"伏波勋业风流远，皂盖朱轓尚小州。\n一曲阳关双别泪，百壶清酒两遨头。\n三年牢落应难借，五马踟蹰更少留。\n珍重促装归汉阙，胡床空复庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别桃源山人","author":"洪朋","text":"句履圜冠不乏贤，桃源深处隐癯仙。\n风流未泯刘全一，意气端如员半千。\n秋浪龙沙陪软语，云山鹤岭访高眠。\n明朝歌竟乘流去，别后还能忆浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪许令宴集不胜杯杓诗谢不敏兼美祝赵两红颜","author":"洪朋","text":"南郭招提逢许令，行厨潇洒办逡巡。\n蟠桃已结千年实，琼树元无一点尘。\n酒后颠狂不知夜，灯前笑语自生春。\n不胜杯杓空归去，肠断冰肌与绛唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得黔州消息","author":"洪朋","text":"夜郎西上万里道，闻说解装四月时。\n摩围峰前何所作，谷鹿洲外不胜悲。\n岂有高明为鬼瞰，真成憔悴被人欺。\n陛下宽仁过文帝，归来前席亦何迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵叙别和答","author":"洪朋","text":"顾曲周郎不姓庞，也寻马祖到禅窗。\n谈功不见令人瘦，句法重来受我降。\n今日茶香聊对榻，异时酒泛满盈缸。\n相期直到无心处，彷佛还须似帝江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答陈孚先见赠","author":"洪朋","text":"陈子陆沉丘壑底，乘槎几欲问明河。\n何人倾盖能如故，无事高轩许数过。\n吟畏舌端多楚调，醉怜耳热颇秦歌。\n顾予贫病难料理，政使禅斋学按摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐十见招","author":"洪朋","text":"徐郎春晚意何如，相见萧然水竹居。\n近得柏梁七字句，俱来茧纸数行书。\n赏心不减远公社，到眼全胜正俗庐。\n首夏清和吾定往，勿令弹铗食无鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢李洪州莅学","author":"洪朋","text":"海内声名四十年，豫章太守得才贤。\n鸣鸾哕哕采芹地，出日迟迟祭韭天。\n可但文翁能教化，须知常衮与周旋。\n却惭不及南州士，合使尘埃一榻悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大母诞日赋岩桂","author":"洪朋","text":"饱闻岩桂馨香旧，珍重园翁采折来。\n天上分丛千丈老，人间擢本一枝开。\n西风白酒何劳劝，明日黄花不用催。\n更把玉壶贮秋色，影斜端为寿觥回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽潘端州","author":"洪朋","text":"岭南底处是端州，使君苦向个中游。\n黄茅千里烟岚晚，皂盖三年鬓发秋。\n欻见崩松万壑底，遂闻埋玉九原头。\n不能执引远郊去，薤露蒿里令人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘六咸临","author":"洪朋","text":"碧梧翠竹闻家子，琼树瑶林物外人。\n千古文章随逝水，一生气义属飘尘。\n匡生左里人何在，南浦东湖迹已陈。\n想见九原托体处，白杨荒草不能春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀黄太史","author":"洪朋","text":"诗家今独步，舅氏大名稀。\n屈宋堪奴仆，曹刘在指挥。\n禅心元诣绝，世事更忘机。\n最喜熊儿去，遥怜雁羽飞。\n九秋悲偃月，万里寄摩围。\n昭代新周典，明年归未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题刘真君祠","author":"洪朋","text":"冠挂谢埃雾，云乘上杳冥。\n棠阴空五马，榆彩杂繁星。\n圜叶馀神界，华林隐翠屏。\n锦帏渺经纬，宝舄绝仪形。\n旧井金丹閟，层坛玉露零。\n千秋想灵气，何许仰天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题藏春谷壁","author":"洪朋","text":"林外鸟声欢，江南尚小寒。\n回头又春色，早晚谷中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"排闷","author":"洪朋","text":"冻雨涨中庭，微风沦止水。\n泛泛藕花飘，眇眇仙茅靡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋徐白鱼虾","author":"洪朋","text":"江湖各相忘，鱼虾同一波。\n谁能写此妙，徐白名不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫兴","author":"洪朋","text":"莫愁愁不至，排闷闷还来。\n谁会登临意，东风莫见猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归自潘氏园途中遇雨有感","author":"洪朋","text":"渐愧日晖晖，依人好鸟飞。\n归来湖上路，小雨却沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏效吴语","author":"洪朋","text":"风絮鹅毛乱，春畴鲜血肥。\n恼侬故乡梦，鸟劝不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠弹筝小妓","author":"洪朋","text":"小鬟弹啄木，写出林间曲。\n空闻剥啄声，虚堂耿华烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶咏","author":"洪朋","text":"黄鸟馀秋声，红菊作秋艳。\n一室得自娱，四时本无念。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题胡潜风雨山水图","author":"洪朋","text":"胡生好山水，烟雨山更好。\n鸿雁书远空，马牛风塞草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山","author":"洪朋","text":"山瀑两道泻，木叶四时春。\n日暝不知去，鱼鸟会留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋山谷帖用其韵 其一","author":"洪朋","text":"学书右军尽善，下笔少陵有神。\n无复向来金马，可惜埋此玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋山谷帖用其韵 其二","author":"洪朋","text":"压倒诗中宰相，鼓行文苑宗公。\n毒雾瘴氛作祟，英姿爽气成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月十八日登报国寺小阁绝句","author":"洪朋","text":"夕阳端解知人意，故照僧房阁倍明。\n雨雪一番今净尽，候禽无数唤春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游太宁院林英预焉","author":"洪朋","text":"松行尽处是招提，殿阁参差柏树齐。\n更与阿戎过净院，剧谈一座日还西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题总持院","author":"洪朋","text":"后土祠边柏造天，雷公堂下锁婵娟。\n韦郎去后无消息，空复秋风入管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清凉寺","author":"洪朋","text":"万古清凉一掬泉，十分随量得轻安。\n要知彻底无尘滓，照破天魔骨尚寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题冯川驿壁","author":"洪朋","text":"细草一方团野色，游丝百尺上晴空。\n预愁柳絮鹅毛白，即见桃花人面红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙兴观胡道士壁","author":"洪朋","text":"倒生松树倚清池，日下西山鸦乱啼。\n隔水竹林人不到，欲寻神界路应迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杜公桥","author":"洪朋","text":"东湖清浅北湖满，三岛相望眼中见。\n我从麒麟虹上行，风袪飘飘薄云汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河上二绝 其一","author":"洪朋","text":"冬日不温狐白裘，隋河只解背人流。\n可怜炀帝繁华尽，唯有两堤榆柳愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河上二绝 其二","author":"洪朋","text":"隋河日照水悠悠，下水谁家泛綵舟。\n回首白云千万叠，梦随飞橹到江头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊口占","author":"洪朋","text":"月照甘蕉十万株，停舟缓步意何如。\n可怜堤下长江水，日夜东流向我疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒即事二绝呈教授 其一","author":"洪朋","text":"云气愁人故不开，风吹雨脚著莓苔。\n筦弦倘是邹子律，唤取春晖次第回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒即事二绝呈教授 其二","author":"洪朋","text":"东风不与芳菲便，故作寒霙倍酿春。\n细草九衢今熨眼，游丝百尺即遮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵惜春二绝 其一","author":"洪朋","text":"柳叶愁眉风翠黛，桃花冶面雨胭脂。\n道人不作三春梦，戏论何妨两解诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵惜春二绝 其二","author":"洪朋","text":"萋萋芳草真成带，寂寂落花何用茵。\n一老只今诗酒废，未应孤负满城春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其一","author":"洪朋","text":"复见飞飞雪满天，瑶林琼树皆可怜。\n属予一病姑置酒，对此欲醉将无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其二","author":"洪朋","text":"柴门草阁李生家，雪压幽篁特地斜。\n寡鹤啄馀畦碎玉，连钱飞起树零花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其三","author":"洪朋","text":"他日照眼临江边，梅花两株一何鲜。\n真成白雪相期得，埋没清香人所怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其四","author":"洪朋","text":"登山临水白皑皑，中有饥鹰飞复回。\n吾比尔曹人不恶，呻吟委绝亦可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其五","author":"洪朋","text":"西山上与云气连，积雪交错于其间。\n隔江草舍粲可画，谁摇艓子自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪六绝 其六","author":"洪朋","text":"去年春雪亦已晚，今夜腊岁如知时。\n谁云此乃农家福，摩挲枵腹聊慰之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"季冬同鸿父登西寺阁观雪时晴日片云雪复乱下鸿父请予赋之","author":"洪朋","text":"新晴馀雪日光同，更遣狂花落晚风。\n结习已空衣不染，何妨天女戏云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同玉父鸿父看池边梅","author":"洪朋","text":"官梅一树小池头，春意冲寒破客愁。\n花萼生光动诗兴，全胜何逊在扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒松","author":"洪朋","text":"茅茨结构野云端，终有松筠贯岁寒。\n但使斧斤无斩伐，穿天出月不应难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏作呈广心","author":"洪朋","text":"清樽歌舞影徘徊，谁唤逃禅苏晋来。\n我自木人人桃李，黄蜂紫蝶莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈王立之","author":"洪朋","text":"主人爱客未渠央，每遣纤纤酌酒缸。\n杯杓不胜还醉著，真成渴梦欲吞江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠林徐二生","author":"洪朋","text":"邂逅黄蜂紫蝶同，春飔恼意艳阳丛。\n只令霜露不见草，犹梦平生深浅红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示海会道人","author":"洪朋","text":"十方薄伽一条路，打破乾坤无处所。\n若人问我祖师禅，东边日出西边雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔寄师川三绝 其一","author":"洪朋","text":"秋来多病友朋疏，隐几无心一味愚。\n寄语南州高士道，不知还忆故人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔寄师川三绝 其二","author":"洪朋","text":"江南风月六朝馀，暇日登楼好著书。\n莫问向来兴废事，世间无物不空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔寄师川三绝 其三","author":"洪朋","text":"官閒无事好飞觞，醉里吟诗想得忙。\n见说京江水清滑，只今谁是杜秋娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"走笔送叔牙","author":"洪朋","text":"三分春色已无多，况是征帆欲棹歌。\n莫惜扬鞭重回首，桃溪李径奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏简","author":"洪朋","text":"夭桃秾李为谁新，占断风光不与人。\n憔悴明窗独醒客，便应虚掷艳阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记梦","author":"洪朋","text":"蚊脚为梯登梵宫，含晖发燄宝树同。\n微尘菩萨演妙法，一一俱见摩尼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事三首 其一","author":"洪朋","text":"短短戎葵晚自芳，飞飞蝴蝶夏犹忙。\n钩帘到面清风远，唤梦吟莺白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事三首 其二","author":"洪朋","text":"淮南不改江南天，五月如秋意惘然。\n仰首勿言居士疾，信心赖有祖师禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事三首 其三","author":"洪朋","text":"风烟寂寂雨霏霏，放箸棂轩独立时。\n况是淮南夏将半，南邻考鼓北邻悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山矾","author":"洪朋","text":"黄龙山中春事晚，山谷道人上山坂。\n鼻端山矾花气浓，怪底经行众芳苑。\n一种风姿极可人，幽姿正色相鲜新。\n素馨籍甚不足意，黄淡羞涩终非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西山","author":"洪朋","text":"云中听鸡犬，不见有人家。\n野水侵官道，山云惹客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云溪院","author":"洪朋","text":"水竹依山在，烟霞并舍分。\n秋添中夜雨，冷浸一溪云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荐福院","author":"洪朋","text":"曲径因山转，精庐到地成。\n楼从云表出，人在日边行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂诗","author":"洪朋","text":"陆沉翰墨场，春事忽云莫。\n文字森在眼，回首不长顾。\n弃置在北门，以写忧思虑。\n春水泱莽浮，上有桃李树。\n安得酒如江，毕竟醉烟雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其一","author":"洪朋","text":"支径雨浓草色，短墙风动筠梢。\n黄鹂犹啭夏木，紫燕才出春巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其二","author":"洪朋","text":"千里烟波渺渺，四时啼鸟匆匆。\n堤柳日浓旧色，庭花月换新红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其三","author":"洪朋","text":"江柳风吹袅袅，池荷雨洗田田。\n吟鸟千声夏啭，薰炉万宇晨烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其四","author":"洪朋","text":"南窗棐几净隐，北园藤杖閒携。\n在野秋风蟋蟀，界天暮雨虹蜺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句五首 其五","author":"洪朋","text":"窣堵坡临南户，给孤园映北窗。\n未能掌擎千界，会须口吸西江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉陪方从教泛东湖","author":"洪朋","text":"可人一宇宙，十顷降魔镜。\n彼美撰清明，令我赏兹胜。\n荷芰相因依，投壶入鱼艇。\n龙蛇上峥嵘，两浒静相映。\n木末隐兰若，风中度钟磬。\n夏虫语交加，此中有真静。\n对此亦何言，妙处心已领。\n聊复归去来，日入西峰暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与吴迪吉刘夷季饶次守同集酒酣题壁先归","author":"洪朋","text":"再为城南游，百花已狂飞。\n更堪逢恶客，骑马风中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]