[{"title":"弈棋绝句二首 其二","author":"洪炎","text":"鹭落寒江鸦点汀，晴窗飞雹击槃声。\n方圆动静随机见，清簟疏帘眼倍明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又叠前韵二首 其一","author":"洪炎","text":"白日惟销一局棋，揽棋还诵李侯诗。\n旁观不作千年计，会有局成柯烂时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又叠前韵二首 其二","author":"洪炎","text":"棋局醒心过博局，棋声娱耳胜琴声。\n少年此戏殊不恶，坐隐时闻夜达明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋弈棋五首 其一","author":"洪炎","text":"荆璞玉为子，井文楸作枰。\n有求惟别墅，不喜得宣城。\n跕跕飞鸢堕，丁丁伐木声。\n破愁逢一笑，无地著亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋弈棋五首 其二","author":"洪炎","text":"祇园三日雨，碧涧一枰秋。\n试问酒中趣，何如林下幽。\n从他著虎口，寻我镇神头。\n惟悟争先法，当机与手谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋弈棋五首 其三","author":"洪炎","text":"不作丹朱戏，难禁清昼长。\n敢言白玉局，聊取紫罗囊。\n角道空传记，乘除自有方。\n儿童争画纸，漫学老夫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋弈棋五首 其四","author":"洪炎","text":"眉山非快手，弈胜亦欣然。\n变态一翻覆，几微系后先。\n陶公虑太过，雪女慧堪怜。\n张弛诚吾道，斯文许尔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋弈棋五首 其五","author":"洪炎","text":"凝神迷远躅，致一有全功。\n皎皎妇姑月，冥冥鸿鹄风。\n置君愚宁子，议乐哂温公。\n谁谓商山老，飘然到橘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越王山二首 其一","author":"洪炎","text":"朝登万仞冈，夕宿云霞间。\n越王昔何时，税驾宅此山。\n山巅有石室，险绝未可攀。\n烟树相映带，尚想飙轮还。\n文吴二仙子，腾踔跨两斑。\n俯仰五百秋，下视悲人寰。\n王室久荡析，世路方孔艰。\n我寻真人居，荷锄芟蓬菅。\n林泉依福地，樵汲闯灵关。\n庶以远兵革，返兹后死颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越王山二首 其二","author":"洪炎","text":"越王名兹山，无复车马迹。\n绝顶有佳处，轩然大磐石。\n灵洞閟其中，神池荡其侧。\n云气朝夕生，合散一瞬息。\n吾闻王子搜，隐遁辞越国。\n玉舆去不返，丹灶锁荆棘。\n二仙出季世，故老犹记识。\n遗踪落人间，不稽传宝墨。\n我睎伯夷清，愿作老聃役。\n脱身尘?外，救暍获三益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岭云","author":"洪炎","text":"吾居半山上，绕屋犹峻岭。\n举头即见之，坐卧作墙屏。\n忽复不可求，澒洞云万顷。\n初疑岸谷变，身不践人境。\n俄顷如故常，突兀在屋顶。\n隐现须臾间，变态莫记省。\n烟霞成痼疾，终日常炯炯。\n早阅金丹诀，未办卜灶井。\n世乱一丘壑，斯志或可逞。\n鸣猿落空岩，翥鹤飏晴影。\n石泉漱芳润，草木皆秀整。\n洞天有归路，未往心已领。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从宝峰长老惟足求猫头笋","author":"洪炎","text":"不识猫头笋，还思马祖山。\n庭兰生旧茁，绷锦换新斑。\n蕴玉争怀宝，登盘想饫餐。\n分甘须剩斸，远助一瓢箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食榧子","author":"洪炎","text":"若榴资彭粮，榧实伐彭兵。\n三彭穴身中，各以尸自名。\n伺隙戕所托，睢盱为己荣。\n仙山无凡木，榧林高且清。\n八月实累累，斗量亦囊盛。\n盈盘得恣食，不与汝粮并。\n嗟汝小黠耳，安所逃汝生。\n蚤读黄老书，五牙漱琅英。\n虽微玉山果，知汝久已行。\n丧乱食不足，长饥病所婴。\n蟠桃未能致，橡栗庶可营。\n作诗颂榧子，期子以主盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十五日山中下视云气自山椒出已而瀰漫咫尺不辨岩谷戏成五言一首","author":"洪炎","text":"一岁下元日，千山小雪天。\n云层生远壑，雨渰隔平川。\n放牧虚横笛，樵苏乐静眠。\n遥知载酒客，无路到斋前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十六日","author":"洪炎","text":"云气依然合，山蹊旧不通。\n齑盐犹可问，牢醴顿成空。\n细觅泉声外，疏篱犬吠中。\n无人披宿雾，采药过庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南城邓氏亭","author":"洪炎","text":"小麦青青山一曲，江南千里伤春目。\n盱母江头唤渡人，遥指麻源第三谷。\n裹盐包饭各匆匆，回首烟霞楼观中。\n诗成更觅羊何和，犹是前身内史公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游麻姑山仙都观","author":"洪炎","text":"浥露出南郭，遵涂眄西岭。\n幽寻不惮远，陟巘造殊境。\n悬瀑泻天路，高斋跨参井。\n麻姑固神人，上下凌倒景。\n逸驾不容追，遗踪抟尘影。\n仙坛独岿然，藓蚀此山顶。\n古屋鸣鸺鹠，污池浴蛙黾。\n葛颜有异闻，源委邈难省。\n空馀丰碑字，欻若猊骥骋。\n永言赏心遇，所乐尘务屏。\n濯缨欲师孔，斲鼻还思郢。\n安得斯人徒，置论挈裘领。\n圣真岂远而，炯炯金在矿。\n九渊孕明月，七返閟神鼎。\n至道如可求，汲深愿修绠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静思院上元日二首 其一","author":"洪炎","text":"麻姑山换越王山，忆昨下元今上元。\n老去休惊长客寓，春来不拟问田园。\n畏途豺虎中原近，挟日风云四海昏。\n梦绕潇湘无落处，凭谁楚些与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静思院上元日二首 其二","author":"洪炎","text":"欲趋严跸万重山，且酌清尊庆改元。\n穑事何时销剑戟，贤书不用到丘园。\n伤心华屋灯如昼，触眼荒涂犬吠昏。\n今日江东须管仲，可怜穷寇尚游魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云溪院","author":"洪炎","text":"水竹依山住，烟霞并舍分。\n秋添中夜雨，冷浸一溪云。\n满目干戈地，关心鸟兽群。\n归涂如可问，猛犬莫狺狺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月十二日偶成","author":"洪炎","text":"金溪东行二十里，高即登山下临水。\n乱山中断水横流，水际招提对山起。\n丹青像设半泥涂，野僧一饭无钟鱼。\n散策闲寻笋蕨芽，密林时逢桃李花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信州逢寒食","author":"洪炎","text":"客行寒食路，春晚上饶城。\n野寺鸟乌乐，山蹊荆棘生。\n人随乘雁集，地隔一牛鸣。\n俛首征途内，官曹何日清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题盛彦光丘壑轩","author":"洪炎","text":"盛子卜居南涧滨，开轩自比葛天民。\n一丘一壑有能事，三浴三薰无俗尘。\n閒逐逸人同执射，偶逢渔父亦垂纶。\n此轩成毁吾何预，画著岩间恐未真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代简呈信州李使君","author":"洪炎","text":"万斛谁能破客愁，一尊风味泛醇酘。\n中丞自许怜渔父，鬲上无端住督邮。\n必使索郎频有顾，也知欢伯解消忧。\n苏州刺史诗盈卷，还忆山僧冷病不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓发鹅湖","author":"洪炎","text":"万松参岭路，千亩动春耕。\n不复红鹅下，空馀碧涧横。\n佛扃穿缥缈，仙驭锁峥嵘。\n道释分殊境，篮舆许我行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古田县","author":"洪炎","text":"勾吴于越通舟车，南走瓯闽城百馀。\n凿山架桥穷奥区，班春不行犹一墟。\n此邦自与桃源并，不能深藏即人境。\n五百年间阅战争，淳朴散尽狙诈生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和古田县丞方景南见惠诗","author":"洪炎","text":"疏慵我似海鸥闲，文采君如雾豹斑。\n不省流离思乐土，深知向往愧高山。\n低飞乳燕声相接，小叩华鲸梦亦还。\n共看围棋欲终日，忘年初在立谈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石鼓山涌泉院","author":"洪炎","text":"昔闻石鼓鸣，今作石鼓游。\n击拊久已息，甲兵殊未休。\n精庐庄严海，百室云雾浮。\n维时当长夏，萧飒如凉秋。\n高崖不见日，老木枝相樛。\n灵泉发嵌窦，下注千仞沟。\n向来经行人，颇以名字留。\n俯仰百年内，磨镌遍岩幽。\n石桥可坐卧，清绝无等俦。\n众山合沓来，响答相献酬。\n虽逢会心欣，未弭当世忧。\n不知稽山上，复有胜处不。\n六飞尚东巡，狐兔穴中州。\n戈鋋塞河洛，冠盖集闽瓯。\n堕此吠雪国，烈火烂不收。\n炎飙方焚轮，赫曦欲停辀。\n微生类焦谷，兹焉得依投。\n一乘凌风翰，濯缨天汉流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石湖院","author":"洪炎","text":"古木参天水一沟，潮来曲折可藏舟。\n招提密映晴岚起，沧海潜通夜气浮。\n丹荔荐盘惊北客，赤蟳供馔识炎洲。\n却疑江左知名士，不作乘桴浩荡游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初食生荔枝二首 其一","author":"洪炎","text":"六月寓闽山，初逢荔子丹。\n皱红分颗颗，凝白作团团。\n品目诚无限，珍甘拟亦难。\n不劳走马使，安坐得加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初食生荔枝二首 其二","author":"洪炎","text":"独擅东南美，谁知十八娘。\n笑颦俱有味，朱粉不迷香。\n璀璨珠生掌，清泠露入囊。\n风流须第一，饤座每难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登万岁寺平远台次糜韵","author":"洪炎","text":"山川信美自愁多，岭海穷途可若何。\n倦客难寻越绝记，畸人但唱郢中歌。\n天香不入伊蒲塞，佛水犹开优钵罗。\n还是浮云韬白日，凤凰台上一经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和了信上座","author":"洪炎","text":"天公下观戏鱼龙，分披惇物隳岱宗。\n尘沙欲枯罔象眼，酒醴难浇磊块胸。\n会稽之南曰闽海，东行万里因雄风。\n二儿得邑古长乐，意拟分治三山中。\n门张雀罗即我室，吊影不识求羊踪。\n担簦挟卷者谁氏，捉笔言诗有此公。\n纷纷道旁皆苦李，辛酸交攻无复理。\n入林初闻薝卜香，知味自觉醍醐美。\n今时杜陵见老人，他日汤休望吾子。\n我观蓬壶才一水，桐柏罗浮相对起。\n赤乌衔符得宝书，青鸟拂檐来报喜。\n君能无事如懒残，吾儿傥不惭张底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题团栾图","author":"洪炎","text":"一老灭尘虑，七儿同静缘。\n境超法界观，身作地行仙。\n男女非殊相，丹青亦浪传。\n襄阳聚首话，犹是在家禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"社日宇文德和送酒次糜韵","author":"洪炎","text":"羁游苦似泽藏山，老境难希药驻颜。\n日日寻香穿窈窕，行行止渴漱潺湲。\n忽闻欢伯来倾盖，无数愁城尽斩关。\n多谢天公爱狂客，九衢忙里独偷闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵许子大王丰父圆明送春之作","author":"洪炎","text":"鶗鴂能愁物外人，芳菲聊借梦中身。\n要知琼刃非凡骨，信有金庭不尽春。\n伯雅相将浮鸭绿，素娥应共踏蟾银。\n休惊丽句同仙授，王许从来侍帝宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福州程使君止戈堂二首 其一","author":"洪炎","text":"瓯山闽海两高深，幕府同开阅古今。\n堂号止戈贤守意，郡名长乐圣君心。\n行看铸剑为农器，即有飞鸮集泮林。\n比日东南是洙泗，喜闻弦诵发清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福州程使君止戈堂二首 其二","author":"洪炎","text":"跳梁山谷有顽民，电扫风除一聚尘。\n排闼江山千里眼，满庭桃李四时春。\n定知当宁思龚遂，政恐攀舆借寇恂。\n谁是诸侯老宾客，酣歌应许杜陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻师川谏议至漳州作建除字诗十二韵迓之","author":"洪炎","text":"建武下诏书，海峤识明主。\n除吏得阳城，所喜逸民举。\n满腹怀经纶，笔间含露雨。\n平生相期心，中兴尔乎取。\n定交自畴昔，契阔及再暑。\n执热子南来，五月憩漳浦。\n破啼谋一笑，预置风月俎。\n危言傥可陈，正学当尽吐。\n成亏在须臾，得失宜熟数。\n收功谢王魏，取道迹傅吕。\n开兹众正路，慰彼苍生苦。\n闭关拒他盗，拂席招巢许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐上呈师川有怀驹父","author":"洪炎","text":"上坡谏议立清班，入奉威颜咫尺天。\n仲氏三山久憔悴，徵君五岭亦迍邅。\n欣逢白鹤归华表，更想黄能出羽渊。\n客舍一樽双泪落，相逢里社复何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"师川见和再用元韵","author":"洪炎","text":"河洛中秋已凛然，瓯闽八月尚炎天。\n方怀许国忠言切，不计归途道里邅。\n子产未能忘季札，太阿应必待龙渊。\n树人树木有明算，谁谓百年同十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入浙中三首 其一","author":"洪炎","text":"松竹笼官道，牛羊食野田。\n岊山低送客，荡水远涵天。\n乍听吴儿语，初逢伧父船。\n平生足未历，聊以慰华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入浙中三首 其二","author":"洪炎","text":"我生豫章汭，游宦在京华。\n百粤非吾土，三吴亦尔家。\n客星严濑钓，西子越溪纱。\n一洗眵昏眼，如乘上汉槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初入浙中三首 其三","author":"洪炎","text":"山村柿栗熟，客舍稻粱秋。\n池足能言鸭，蹊多喘月牛。\n如闻息战斗，剩欲起歌讴。\n鼓楫临江誓，谁为祖豫州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋日上饶郡偶成二首 其一","author":"洪炎","text":"承明非厌直，衰疾自投闲。\n江汉蒸炊内，盘盂嗒哈间。\n层冰万里梦，谒帝九重关。\n愿借抟风翼，追游物外山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立秋日上饶郡偶成二首 其二","author":"洪炎","text":"平生逃暑饮，病著不濡唇。\n熨齿甘瓜冷，流匙香粒匀。\n加餐虽意决，对案已眉颦。\n却叹廉颇老，犹为善饭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盛彦光次韵见和复用前韵因以自叹 其一","author":"洪炎","text":"星织乌同织，鹤闲鸥亦闲。\n问君离俗久，何事落人间。\n末伏秋无雨，残歊昼掩关。\n寒泉聊洗耳，清冷似吾山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"盛彦光次韵见和复用前韵因以自叹 其二","author":"洪炎","text":"凉飙将透齿，烈火谢燋唇。\n壁织梭梭应，檐珠颗颗匀。\n隐忧成独乐，浅笑换深颦。\n更上藐姑射，问途冰雪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作四言用前韵二首 其一","author":"洪炎","text":"事有怕爱，语分忙闲。\n左右前后，内外中间。\n青云千里，紫气浮关。\n五星东井，微臣北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作四言用前韵二首 其二","author":"洪炎","text":"鹢鹢珍腿，猩猩美唇。\n醴齐调适，勺药和匀。\n老商嬉笑，西施解颦。\n倦龟若士，翳桑饿人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次四言韵二首 其一","author":"洪炎","text":"执虎入圈，絷驹在闲。\n志六合外，身十亩间。\n组系单于，泥封函关。\n乐我丛桂，淮南小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次四言韵二首 其二","author":"洪炎","text":"鲁兄卫弟，虞齿虢唇。\n倚伏相因，否泰惟匀。\n履兹艰虞，慎厥笑颦。\n水清见石，天定胜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三次四言韵二首 其一","author":"洪炎","text":"入圣有域，存诚以闲。\n德不德上，材不材间。\n堂上不粪，门设常关。\n鄙哉丘垤，覆篑为山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三次四言韵二首 其二","author":"洪炎","text":"编贝皓齿，含朱绛唇。\n甄陶圆熟，琢削细匀。\n不笑不言，倚席以颦。\n商略有此，为若而人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋分日偶成","author":"洪炎","text":"洪崖山下一臞儒，碧玉岩边抱病夫。\n永日翛然无复事，人欺憔悴鬼揶揄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾仲共和予春日登滕王阁诗盖旧诗也复次韵","author":"洪炎","text":"西江东畔见江楼，江月江风万斛愁。\n试问海潮应念我，为将双泪到南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅","author":"洪炎","text":"见江楼下蜡梅花，香扑金尊醉落霞。\n独依东风如梦觉，一枝春色别人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日","author":"洪炎","text":"开岁逢人日，吾衰不梦周。\n家书生远恨，客舍起离忧。\n朔雪惊南服，江梅笑陇头。\n谁能结綵胜，一为散春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟乳","author":"洪炎","text":"钟乳宜为粉，扶衰老所便。\n缄藏鹅管细，冶鍊玉丸坚。\n石髓诚难值，云腴恐浪传。\n刀圭聊已疾，未敢议真仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少蕴出示郑先觉阅骏图为作长歌","author":"洪炎","text":"丹青得名曹将军，画马已来无复人。\n诸生韩干受肉法，绝足亦传沙苑真。\n儒林望郎李公麟，曹韩复生能与邻。\n心胸可纳天西极，纨素频空粪北群。\n郑生晚识李侯比，自许笔端轻万里。\n山川初出大宛城，翰墨犹沾渥洼水。\n汗血喷沙指顾间，雾鬣风鬃卷中起。\n戏成十马皆龙材，前有飞黄后山子。\n叶公好尚有祖风，苦爱真龙似画龙。\n千金不惜市骏骨，睥睨神物秋毫中。\n英雄尝闻妾换马，意气欲将诗换画。\n诗工画妙两崛奇，谷量马观未论价。\n公诗自是生骅骝，恨公不身亲李侯，向来曹韩空白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曾仲共大风折木歌","author":"洪炎","text":"疾风岌嶪土囊口，阳崖中裂阴崖吼。\n南山乔木大百围，顷刻剪伐如断臼。\n修枝偃蹇掷龙蛇，直干崩山塞岩岫。\n干云蔽日扫地空，掣电奔霆翻覆手。\n山灵掩泣惋惜深，匠石含悲涕洟久。\n折臂而公黥而王，精金当镕玉当剖。\n断木刳为浮海航，路指银河上牛斗。\n委馀犹得宫殿材，琐细亦蒙梁栋取。\n万斛之舟可弗论，大厦帡幪此焉有。\n狂飙卷空欲奚为，寿被金石长不朽。\n天生大材将有用，乖逢相因孰先后。\n嗟尔乾枫与枯柳，摧折为薪尚谁咎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]