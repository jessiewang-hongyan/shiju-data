[{"title":"造桥道者并诸化土写求 其二","author":"释慧空","text":"这汉一生担版，垂老出来住院。\n清真气味全消，恶业因缘顿现。\n说禅罔圣欺凡，乞食走州历县。\n试看帧上传来，辊得成甚觜面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顿庵 其二","author":"释慧空","text":"龙女献珠成佛，善财弹指入门。\n若到顿庵门下，一时且作儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十四","author":"释慧空","text":"盲人端的有眼，铁牛通身无骨。\n不信问取桃花，便见灵云败阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十三","author":"释慧空","text":"人人尽有生缘，落花流出桃源。\n过后再寻无处，满蓑烟雨渔村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其八","author":"释慧空","text":"庞公惭愧全无，马祖慈悲心大。\n直饶吸尽西江，东山未向伊道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十四","author":"释慧空","text":"佛手驴脚生缘，三山影落中天。\n武帝多方学道，王乔端坐神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其九","author":"释慧空","text":"引鼻拽回野鸭，元来却是家鸡。\n不管晦明风雨，才到五更便啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十","author":"释慧空","text":"身披粗布伽梨，手把大木槵子。\n天寒坐火炉头，动是说蛇说虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十一","author":"释慧空","text":"我手何似佛手，拈起扇子擗口。\n打落帝释花冠，却是寒山扫帚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十八","author":"释慧空","text":"南瞻部洲锄地，东弗于逮种麦。\n西瞿耶尼拽磨，北郁单越吃面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十二","author":"释慧空","text":"我脚何似驴脚，车轮顿生八角。\n三千刹海波澄，一阵西风叶落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其六","author":"释慧空","text":"石霜山中独虎，生得三脚驴儿。\n走过萍实楚江，踢倒湖南长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其五","author":"释慧空","text":"雪峰山中解夏，三门开放两边。\n去底观音势至，来底文殊普贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其二","author":"释慧空","text":"雪峰五月五日，不假神符妙术。\n只有顶门一锥，铁佛也须汗出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十三首 其一","author":"释慧空","text":"山僧才到雪岭，打就无底铁船。\n使人真觉海中，运载情与无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧空","text":"先打春牛头，后打春牛尾，惊起虚空入藕丝里。\n释迦无路潜踪，弥勒急走千里。\n文殊却知落处，抚掌大笑欢喜。\n春风昨夜入门来，便见千华生碓嘴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂二首 其二","author":"释慧南","text":"生缘断处伸驴脚，驴脚伸时佛手开。\n为报五湖参学者，三关一一透将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂二首 其一","author":"释慧南","text":"杰出丛林是赵州，老婆勘破有来由。\n而今四海清如镜，行人莫与路为雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百二十三首 其六十二","author":"释普度","text":"心王不妄动，六国一时通。\n罢拈三尺剑，休弄一张弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释慧南","text":"得不得，传不得，归根得旨复何言。\n忆得首山曾漏泄，新妇骑驴阿家牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧圆","text":"这一交，这一交，万两黄金也合消。\n头上笠，腰下包，清风明月杖头挑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和先师宏智和尚五转位颂 五天银烛辉","author":"释慧晖","text":"五天皎皎玉轮孤，一转光分鉴五湖。\n阔步却来游幻海，十方沙界大毗卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和先师宏智和尚五转位颂 匣里青蛇吼","author":"释慧晖","text":"宝剑横斜天欲晓，洗净魔佛逼人寒。\n匣中阴阴光生处，衲子徒将正眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和先师宏智和尚五转位颂 金针去复来","author":"释慧晖","text":"清虚大道长安路，往复何曾有间然。\n暗去明来锋不露，渠侬始不堕中边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芙蓉和尚四句偈颂 死蛇惊出草","author":"释慧晖","text":"金鞭遥指玉堂寒，惊起将军夜出关。\n三尺镆铘清四海，搀枪一扫绝痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芙蓉和尚四句偈颂 铁锯舞三台","author":"释慧晖","text":"铁牛无角卧山坡，鞭起如飞见也么。\n闹市横骑人不会，抬头鹞子过新罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芙蓉和尚四句偈颂 解针枯骨吟","author":"释慧晖","text":"宫漏沉沉夜色深，灯残火尽绝知音。\n木人位转玉绳晓，石女梦回霜满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十六","author":"释慧晖","text":"可怜多客满堂僧，打睡送时乱佛承。\n悟入至今无一个，蓦头端的尽三乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十五","author":"释慧晖","text":"明明梵音海潮音，青青胜彼世间音。\n雨则慧日破诸闇，日则名为观世音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十四","author":"释慧晖","text":"旷劫无尘世界中，恣吹野曲晚来风。\n看看本来无一物，满山云树雪花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十三","author":"释慧晖","text":"武帝功德人天果，圆觉无功真到心。\n清净本然谁会得，碧萝深锁古山岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其七","author":"释慧晖","text":"不觉蹈过镔铁关，悠然稳坐月芦寒。\n别得妙方更难到，巍巍顶相若当看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十九","author":"释慧晖","text":"混而不杂体常虚，雪月交光类莫如。\n应处万端无挂碍，片云自在卷还舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十八","author":"释慧晖","text":"□世如来一口吞，故山深静月黄昏。\n光分顶后千门晓，坐看春回入烧痕。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十七","author":"释慧晖","text":"不打飞鸢便到来，大圆镜里绝尘埃。\n东君节令分明也，桃李年年二月开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十六","author":"释慧晖","text":"心径苔生何处去，谢家人不在渔船。\n芦花万顷水天阔，白鸟深沉任转旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十五","author":"释慧晖","text":"寂寂无依病正深，雪老当年痛处针。\n一唤唤回春梦破，千山浑作木龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十四","author":"释慧晖","text":"一片孤云不露丑，白云儿倚青山父。\n鹤巢灵滴梦初回，新月半钩升万户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十三","author":"释慧晖","text":"故山岌岌锁寒烟，未肯将心轻授传。\n玉女夜寻无字印，石人遥指月明前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十一","author":"释慧晖","text":"上座莫要礼老朽，兴平未易扬家丑。\n尊贵从来不出门，渠侬岂在威音后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十","author":"释慧晖","text":"非男女相独閒閒，正体堂堂孰可攀。\n一句不传千圣眼，九天风静月弯弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其九","author":"释慧晖","text":"翰墨场中唤得回，桂林昨夜觉花开。\n暗香漏泄通消息，散作人间调鼎才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其八","author":"释慧晖","text":"重重去尽自平常，春暖风和日渐长。\n户外鸟啼声细碎，岩花狼藉满山房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其六","author":"释慧晖","text":"百尺竿头氎布巾，上头题作酒家春。\n相逢不饮空归去，洞里桃花笑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其三","author":"释慧晖","text":"不是风幡不是心，衲僧徒自强锥针。\n岩房雨过昏烟静，卧听凉风生竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其二","author":"释慧晖","text":"是风是幡君莫疑，百草丛中信步归。\n王道太平无忌讳，戏蝶流莺绕树飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其一","author":"释慧晖","text":"那吒太子本来身，卓卓无依不受尘。\n云散水流天地静，篱间黄菊正争春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其三","author":"释慧晖","text":"少而可努力，老而可歇心。\n都卢懒万事，双眸泪湿襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其二","author":"释慧晖","text":"一回转意光，千里绝情方。\n悟后梦醒后，孤然坐古堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十首 其一","author":"释慧晖","text":"外罢诸缘绝言语，内无喘息合幽玄。\n心如墙壁忘功处，以入道源空劫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十七","author":"释慧晖","text":"灵剑刃辉在匣中，清光所照侵虚空。\n密通消息不传句，天上人间功不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其二十四","author":"释慧晖","text":"花露残春一样芳，月馀潭底万年光。\n水脉冷寒凉焇焇，云形虚幕露堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其十一","author":"释慧晖","text":"家传妙旨不言语，洞上真机绝外来。\n若有人云知父道，孤然孙子笑咍咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂三十首 其三","author":"释慧晖","text":"家风是自己，自己是家风。\n一如身心眼，全体是玄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四十","author":"释慧晖","text":"今宵分岁限阴阳，宾主交和曾不藏。\n寒雪苦辛霜后路，明朝明旭露春芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十九","author":"释慧晖","text":"铁树风花物外春，一阳未发不传真。\n自斯织出锦机梦，江月布祥碧浪新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十七","author":"释慧晖","text":"北面半窗阴已极，南方全室阳斜得。\n不关阴气与阳光，岭上雪寒白似黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十四","author":"释慧晖","text":"璞玉光寒冰雪气，松柏操彰湛水里。\n分明消息砂中金，丈夫自有冲天志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十三","author":"释慧晖","text":"风吹松雪月当空，一色功中转步同。\n刖路分时无雪月，合同一色落功功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十一","author":"释慧晖","text":"弹指圆成八万门，掌中握却一乾坤。\n铁围倒入黄泉底，一句截流万水源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十九","author":"释慧晖","text":"玉机转侧金堂冷，石室斜开铁户明。\n木鸡唤月壶天晓，泥牛吼花客游城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十七","author":"释慧晖","text":"寂灭真功元无体，无功妙旨太深深。\n同中有异粗中细，异中有同念里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其十三","author":"释慧晖","text":"皋月今朝初旭光，玉辉破暗露堂堂。\n日日分明久远事，威音那畔是时祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三","author":"释慧晖","text":"如月今朝一日晨，风光破玉百花新。\n西来本祖再来也，万岳千峰皆是亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十五","author":"释慧晖","text":"除月今朝吉日朝，寒云断路韫天桥。\n纷飞白雪象王窟，骑底普贤在昨霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其七","author":"释慧晖","text":"花落秦川流水香，雨清荷玉妙珠藏。\n祇么堂堂消息子，见来一点不相当。\n静夜钟声楼上冷，残春岑色付红阳。\n好是满堂孤峻处，不知人世见金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其四","author":"释慧晖","text":"兼中至，长安大道闲游戏。\n处处无私空合空，法法同归水投水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其一","author":"释慧晖","text":"正中偏，混沌初分半夜天。\n转侧木人惊梦破，雪芦满眼不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其三","author":"释慧晖","text":"正中来，帝命旁分展化才。\n杲日初升沙界静，灵然曾不带纤埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其五","author":"释慧晖","text":"兼中到，白云断处家山妙。\n扑碎骊龙明月珠，昆崙入海无消耗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五位颂 其二","author":"释慧晖","text":"偏中正，宝月团团金殿冷。\n当明不犯暗抽身，回眸影转西山顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和先师宏智和尚五转位颂 秦宫照胆寒","author":"释慧晖","text":"岩房阒寂冷如冰，妙得冥符处处灵。\n转侧依忘功就位，回头失却楚王城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和先师宏智和尚五转位颂 深岩藏白额","author":"释慧晖","text":"白额藏岩烟雾昏，异中来也自惊群。\n草深直下无寻处，触著轻轻祸到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和芙蓉和尚四句偈颂 妙唱不干舌","author":"释慧晖","text":"如如寂灭自无情，一句从来本见成。\n舌运广长元不间，雪峰相见望州亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其九","author":"释慧晖","text":"不传之传句，先贤也不传。\n佛祖未出兴，早是有付传。\n不妙之妙句，古圣也难宣。\n黄头碧眼老，如何及言宣。\n不真之真句，人天未生前。\n若以言道趣，只徒在目前。\n不传妙真句，三世不变迁。\n毕竟道人眼，万岁绝易迁。\n寥寥而本传不传之传，明明而今妙不妙妙，玄密密而深到不真真玄。\n毕竟道人眼，亿劫不异迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十二","author":"释慧晖","text":"蹈泥运土自参机，收足展掌自到奇。\n个个须应曾转拨，真灯破夜意光微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂十六首 其十一","author":"释慧晖","text":"黄面手中花一枝，头陀微笑识人希。\n人天百万共尊贵，何不打头勘座师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]