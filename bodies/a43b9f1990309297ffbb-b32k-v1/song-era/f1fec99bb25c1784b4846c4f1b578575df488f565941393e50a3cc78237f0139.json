[{"title":"常思惟大士赞 其五","author":"释居简","text":"轮珠一百八，数了从头数。\n念兹在兹，不知其数。\n自谓初于闻中，驴年入流亡所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其六","author":"释居简","text":"补陀月，龙眠笔。\n笔有痕，月无迹。\n迹其迹，普门寂寂。\n迹既忘，四达皇皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其七","author":"释居简","text":"声亦观，色亦观。\n空劫后，空劫前。\n风动尘起，山深水寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其八","author":"释居简","text":"万窍不风，千波弗澜。\n天低月高，山深水寒。\n普门无路入，终始不曾关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其九","author":"释居简","text":"从闻思修，错了路头。\n将错就错，随流入流。\n补陀山鬼窟，海月半轮秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其十","author":"释居简","text":"从闻思修，入三摩地。\n动静二相，了然不生。\n补陀小白花山上，弗听流莺啼一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其十一","author":"释居简","text":"篮盛鱼，不盛水。\n弗自噇，提入市。\n秤子无星，钩头有饵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常思惟大士赞 其十二","author":"释居简","text":"为散乱人，现如是相。\n方其定时，孰为此像。\n定乱一如，此像亦无。\n若言无像，天地悬隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其一","author":"释居简","text":"赤脚才穿市，回头便笑人。\n手中果何物，弄物不知名。\n闭眼瞌睡，开眼业识。\n便恁么去，著甚死急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释居简","text":"背后曾开鬼眼睛，虽然有眼又无筋。\n问他睹史宫中事，拈得乾鱼举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其三","author":"释居简","text":"笑破古音前，回头尽可怜。\n只今无可笑，仰面笑青天。\n赤脚知晴，蹑屐知雨。\n只这一著，未敢相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其四","author":"释居简","text":"鱼乾拈起走长街，道是天宫带得来。\n铁奉化人顽似铁，阿师咍了更谁咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其五","author":"释居简","text":"正续无名，散圣无位。\n秦汉不收，惭愧惭愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"布袋赞 其六","author":"释居简","text":"天上无，地下无。\n只这无无，已自涂胡。\n区区更回首，转见费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问疾维摩赞","author":"释居简","text":"卖弄澜翻舌，文殊是阿谁。\n未曾谈不二，已自落思惟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"须菩提赞","author":"释居简","text":"洗足已，便趺坐。\n突然道希有世尊，你当时见个什么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒山赞","author":"释居简","text":"寒山指出，拾得执指。\n不曾见月，矮子看戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草衣文殊赞","author":"释居简","text":"衣纫草，发如草。\n未下五台，百怪俱兆。\n手中经，义不了。\n我且问你，前三三后三三，是多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马郎妇赞","author":"释居简","text":"念得莲经便嫁伊，空花无蒂欲谁欺。\n金沙滩上黄金锁，狼藉春风到几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵照女赞","author":"释居简","text":"屋里横机抗老爷，门前敛袂对丹霞。\n爷生娘养好儿女，有得许多无赖吒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"穿破衲赞","author":"释居简","text":"针短线难穿，闲拈当负暄。\n不须嫌破碎，提起自完全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"了残经赞","author":"释居简","text":"从朝数黑豆，数到黄昏后。\n只见月如眉，不觉灵犀透。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初祖赞","author":"释居简","text":"五叶芬敷自一花，无人图蔓剪根牙。\n不教著脚金陵地，犹恨萧梁未作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为痴绝和尚赞初祖达磨并马大师画象 其一","author":"释居简","text":"穿耳耳未尝穴，缺齿齿未尝折。\n北度一苇可航，西归只履自挈。\n或谓之空劫已前中流砥柱，或谓之拈花已后金口木舌。\n或曰正宗别调，又曰直指曲说，皆非吾之所谓道也。\n若夫求大乘器，走十万里，俟人作兴，器岂大乘。\n夙负先觉，礼闻来学。\n学而知之，既远且邈。\n负是四者，吾恐五竺之铁不足铸此错也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为痴绝和尚赞初祖达磨并马大师画象 其二","author":"释居简","text":"金鸡毒，一粒粟，未踏杀人，已先跌足。\n一十八滩兮障回死水，八十四人兮淹浸弗死。\n洪都兮泐潭，宗风兮肆凌厉。\n一波动兮万波起，派兮支兮滔滔者皆是。\n更无一个识玄旨，只有归宗较些子。\n捡点将来，玄沙道底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"普化赞","author":"释居简","text":"风颠用尽到无馀，一个棺材八个舁。\n舁出镇州城外去，听他木铎自分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵州赞","author":"释居简","text":"禅在口皮边，机搀石火先。\n破家才十八，更不使爷钱。\n东南西北，门开两边。\n相见了也，十万八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临济赞","author":"释居简","text":"白拈贼，是这厮。\n捋鬼头巾，假我服色。\n胡芦立地便要沈，秤锤落井不教没。\n脱间漏架，天下第一。\n自谓建立黄檗宗旨，不知黄檗无处雪屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨岐赞","author":"释居简","text":"请慈明晚参，对白雪大笑。\n为父不慈，为子不孝。\n个般驵?行藏，敢称瞎驴种草。\n争怪人言不解禅，熨斗煎茶不同铫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为痴绝和尚赞三睡","author":"释居简","text":"赞也喜，骂也喜。\n醒也睡，困也睡。\n善男子起，法性如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东山赞","author":"释居简","text":"棚入啰扎，君子可入。\n附子同乡一样辣，酸馅嚼破一团铁。\n馅子一句，未敢相许。\n弗是没人情，个中无肯路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永明寿禅师赞","author":"释居简","text":"客吟灯残，猿啼月落。\n衲帔蒙头，千岩万壑。\n指破凡夫，为等觉妙觉。\n齐大小乘，于钱索井索。\n纵大辩于谈笑，寄虚怀于冥莫。\n所谓百轴宗镜之文，如太山之一毫芒。\n巍巍堂堂，炜炜煌煌。\n非心亦非佛，破镜不重光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大慧师祖赞","author":"释居简","text":"絷空云带，补太虚缝。\n秘以自传，公与众共。\n卷覆大千舌于洋屿云门，不与摩竭同条。\n袖掷大千手于梅州衡阳，不与净名同梦。\n至于三藏十二部，一切修多罗，洎百家异氏之书，杂然前陈，无断无灭，有元有统。\n瞥转一机，五峰敛眉。\n伎俩尽也，放下竹篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"智者大师赞","author":"释居简","text":"宝几在前，如意在手。\n禹背汤肩，河目海口。\n南岳山中得圣师，投针钵水了无疑。\n法华同听真精进，直到灵山未散时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"密庵赞","author":"释居简","text":"正法眼，曰破沙盆，曰漏灯盏。\n两段不殊，一倍相反。\n钝置云黄山下老禅魔，匙挑不上，罪不重科。\n但未知虚空消殒，毕竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拙庵赞","author":"释居简","text":"读旁行，倚松立。\n义不精，字不识。\n海涌云兴追不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞 其一","author":"释居简","text":"幼而不逊，长而无述，老而不死。\n贼贼。\n临济未是白拈，自出洞来无敌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞 其二","author":"释居简","text":"字不识，禅不会，数米量柴，料水打碓。\n不是末后全提，亦非现前三昧。\n待众生成佛，尽众生界空，任从沧海变，终不为君通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题慈观长老求赞","author":"释居简","text":"监本倔强，弗善劳谦。\n不识拙庵，他最不堪。\n他亦人耳，我亦人耳。\n空自合空，水自合水。\n卖弄跨门一机，至死无人发市。\n父有重牙，其子无齿。\n没齿穿龈，如是如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小师求赞 其一","author":"释居简","text":"平常心，摩竭合。\n砥柱不摇，风雷不迅。\n拈了也，示祖敬。\n无法商量，一印印定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小师求赞 其二","author":"释居简","text":"不会道，不会禅。\n更求文墨，掘地觅天。\n别调宫商妙不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"檀木白衣相赞","author":"释居简","text":"斤斯运，垩斯斲。\n鼻不伤，立自若。\n臻极之技，与物不二。\n惟其不然，一理万致。\n我观此像，殆非人为。\n就能为之，技不宅微。\n矧此匠氏，应以此机。\n应以此身，化巧幻奇。\n曰余眊然，两眼如镜。\n弗能审观，独以耳听。\n反听绝眹，对此殊胜。\n小白花山，下瞰巨浸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"慈感圭老请赞无量寿像","author":"释居简","text":"十方取土，曰清泰城。\n又曰极乐，与苦浊邻。\n厌苦知乐，不毫忽间。\n一念勇往，即念而瞷。\n惟忆惟念，匪疾匪迟。\n忆而不忘，念兹在兹。\n如求亡子，如丧考妣。\n如疢需石，如渴需水。\n以如是故，曾何远人。\n人人亡羊，入生死轮。\n法法惟心，心亦非心。\n郑卫嘈杂，水鸟树林。\n悠悠渐修，额额阐提。\n同摄罔遗，妙在不疑。\n疑则疑城，日劫倍蓰。\n东隅既失，桑榆可冀。\n粤若二仲，达圆顿机。\n路壅般舟，手自剪夷。\n池栽芬陁，社结名胜。\n一十有八，是修是证。\n天台嗣响，的传自衡。\n和者如云，调高倡宏。\n六朝逮今，衣冠缁褐。\n愚夫愚妇，爰同此筏。\n哂乃二瓠，载沉载浮。\n即窒即海，善柳柳州。\n见月因摽，执指成咎。\n舍有相佛，观无量寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天乐赵紫芝画像赞","author":"释居简","text":"一点虚明，八窗玲珑。\n万波不浑，百川自东。\n殆见其洒然乎外，孰知其渊乎其中。\n谓其襄阳漫仕，曰吾不为南宫。\n谓其江湖散人，曰吾不为龟蒙。\n乌在乎仪刑，先进而丹青太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东坡画像赞","author":"释居简","text":"帝哀先生，为天下忌。\n速反其辕，卒不憖遗。\n遂骑箕尾，而分天章。\n云汉昭回，衣被八荒。\n载驱六丁，收拾文字。\n神京遐陬，旁罗曲致。\n落人间者，太山毫芒。\n寒者绮纨，馁者稻粱。\n取彼谮人，投畀豺虎。\n既粱其饩，而纨其裤。\n豢以人爵，俾敏厥修。\n息公之谮，承天之休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二桃杀三士赞","author":"释居简","text":"大匠不弃栎社之木，良医不遗乌喙之毒。\n务急吾用，不一而足。\n苟适其时，虽弃必录。\n方其用时，有正有奇。\n颠兮吾扶，危兮吾持。\n相道巍巍，二氏似之。\n哂乃齐相，曾不尔思。\n夫三子者，谬以力胜。\n胜力以德，孰敢不敬。\n徒丧厥德，以致其命。\n一念之忍，桃乃其阱。\n欲济缓急，图任媕娿。\n爪牙不铦，其如之何。\n盍观相如，伸秦屈颇。\n隐然长城，无庸干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三教赞","author":"释居简","text":"此三胜流，一笑聚头。\n其道不同，曷相为谋。\n至哉儒先，问礼于李。\n李从竺乾，逮真实际。\n商隐于李，白眉最良。\n曰师师师，其来自唐。\n车适大方，万里一辙。\n差之毫釐，肝胆楚越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤云画像赞","author":"释居简","text":"閒如云，寄寥邈。\n帖水不痕，行空无脚。\n笑从上扫迹生迹，嗟后来以缚解缚。\n于其中间，卷舒自若。\n钉钉却，悬挂却。\n老倒南阳，犹欠一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下竺印画像赞","author":"释居简","text":"窣然短衣，崭然插犀。\n岁晚寂莫，奋此一夔。\n胶名相求之，则万言不直杯水。\n外形骸索之，则半芋美于紫泥。\n宪章左溪，鼓吹荆溪。\n使人复见古道颜色，舍斯人其谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明教禅师五种不坏赞 其一","author":"释居简","text":"顶骨峣然，隐若伏犀。\n于烈火中，凄其廪而。\n古铁铮铮，烬馀不热。\n击石拊石，迭中音节。\n舍利团缀，素魄囧如。\n湛湛凝露，累累贯珠。\n岂无他人，欲见其顶。\n月行太空，蛙沉坎井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明教禅师五种不坏赞 其二","author":"释居简","text":"去窒而聪，去塞而通。\n于无数声，齐万窍风。\n风止声消，音响寂绝。\n谷神不死，听火焰说。\n说无所说，闻无所闻。\n烟灭灰飞，所亡者存。\n以是耳根，示尔四众。\n厚德宏功，千二百种。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明教禅师五种不坏赞 其三","author":"释居简","text":"宣明心声，若出金石。\n汹涌辩河，不渗涓滴。\n书献天子，天颜屡改。\n一笑归来，此舌犹在。\n韩吾不非，吾奚以为。\n壅吾不夷，吾奚以驰。\n一生事了，有死无憾。\n身随劫烧，红开菡萏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明教禅师五种不坏赞 其四","author":"释居简","text":"童真出家，死于童真。\n出没卷舒，一坚密身。\n嗟多欲人，曲为欲说。\n于其根中，出火自焫。\n猗欤哲人，哂乃覆辙。\n以古为鉴，以身代舌。\n火炎昆冈，玉石俱焚。\n石付百粉，玉兮温温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明教禅师五种不坏赞 其五","author":"释居简","text":"的的紫槵，茸茸素丝。\n自幼至老，念兹在兹。\n譬夫一龛，绕以十镜。\n此灯长明，一印印定。\n定则离念，反而自求。\n于无求中，以敏厥修。\n物初有终，法无有尽。\n是故此珠，横绝煨烬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贤者国师赞","author":"释居简","text":"心部根本，身严杂华。\n赤象青牛，跨竺越华。\n半满字则，五其等差。\n殊声响则，一其纷拿。\n使登门之鱼，驾际天之涛。\n陋潢污行潦，而观海若之谽谺。\n琐屑灭裂，又安知鰋鲤之与鲿鲨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强斋高使君金书诸经赞","author":"释居简","text":"淀蓝蘸楮，屑金作字。\n去字与楮，经果何似。\n曰此诸经，即楮与金。\n续父厥志，写佛语心。\n惟佛语心，粤如父志。\n一点画中，具无量义。\n字可悉数，义则无量。\n欲了其源，冥去来相。\n强斋大士，年八十馀。\n目如心明，作蝇头书。\n于一蝇头，分可为二。\n尘毛太华，弗巨弗细。\n佛神力故，初不作难。\n是故北涧，作如是观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两蟆赞 其一","author":"释居简","text":"攫而掷，翾而举之。\n二虫请以战喻。\n翾毋忘于射钩，攫毋忘于在莒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两蟆赞 其二","author":"释居简","text":"蚁战酣，蟆袭其后，非大嚼盍反相友。\n梦好忽同归，一麾何足疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荷屋常不轻画像赞","author":"释居简","text":"芰荷为屋，芙蓉为裳。\n芳茝纫佩，落英贮粻。\n熏以石林，书传之香。\n瀹以太华，玉井之凉。\n濯人间烟火气，毋干吾丘壑姿。\n洎夫锦心之与绣肠，发卐庵之韬略，示我武之维扬。\n适妙喜国拓吾故疆。\n安在乎广莫之野，而无何有之乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"义鉴堂画像赞","author":"释居简","text":"魁梧轩昂，耿介孤洁。\n大珠缟夜，轻云拂月。\n作成泼天问端来前，只似钉头难于敲折。\n东山发源，双峰卷衣。\n把大苏狂澜，障而东之。\n微此老孙子，已而已而。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高丽指堂讲师画像赞","author":"释居简","text":"岩岩指堂，破尘出经。\n惟其能然，曰聪慧人。\n堤圆顿之颓澜，会中下于通津。\n横说竖说，匪亏匪盈。\n全提半提，匪坏匪成。\n夫是之谓全体之用兮全体之真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙湛禅师月岩舍利赞","author":"释居简","text":"及笄洗妆，一花一香。\n舍父求度，回度厥父。\n父子学空，机先有锋。\n父死开法，镆铘出匣。\n归奉其母，孤山之浒。\n示生有灭，笑与母诀。\n火后舍利，粲如繁星。\n如金之晶，如玉之明。\n堂堂月岩，如空行月。\n何庸留此，自暴丑拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下天竺古镜法师画像赞","author":"释居简","text":"伽黎拥肩，不舍夜旦。\n革履梏足，炎熇不跣。\n迹迩世相，而不动不退。\n心惟玄奥，则唯止唯观。\n四辩涌兮澜翻，四筵拥兮冰泮。\n特旨住山，灵山未散。\n洗旧讲榻，萎花新换。\n至于戒香逆风，腾播林野。\n吾尝比之波利质多罗天树花，此之谓也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陶司户画像","author":"释居简","text":"宅尘滓拔千丈之俗，倚梅竹托三友之交。\n稠人广座则惟静惟默，凉天佳月则或推或敲。\n问津荣途，姑欲行志。\n于志得时，反求诸己。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":29451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]