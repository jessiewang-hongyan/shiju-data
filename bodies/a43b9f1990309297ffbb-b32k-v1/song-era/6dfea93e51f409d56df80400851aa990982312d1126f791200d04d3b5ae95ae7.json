[{"title":"治平皇太后皇后册宝三首 其三 皇帝降坐用《乾安》。","author":"郊庙朝会歌辞","text":"衮衣绣裳，严威肃庄。\n八音具张，簨虡龙骧。\n玉简瑶章，金书煌煌。\n寿千万年，与天比长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴十年发皇太后册宝八首 其八 册宝升慈宁殿幄用《圣安》。","author":"郊庙朝会歌辞","text":"礼行东朝，乐奏大吕。\n羽卫森陈，簪绅式序。\n云幄邃严，宏典是举。\n天子万年，母仪寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙二年发太上皇帝太上皇后册宝十一首 其三 皇帝奉太上皇帝册宝授太傅用《礼安》。奉太上皇后同。","author":"郊庙朝会歌辞","text":"翠华之旗，灵鼍之鼓。\n陈于广宇，相我盛举。\n来汝公傅，肃乃仪矩。\n毋愆于素，以笃多祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙十二年加上太上皇帝太上皇后尊号十一首 其四 册宝出门用《正安》。","author":"郊庙朝会歌辞","text":"羽卫有严，宝书有辉。\n昭衍尊名，铺张上仪。\n出其端闱，由于康逵。\n比屋延瞻，歌之舞之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙十二年加上太上皇帝太上皇后尊号十一首 其五 德寿宫册宝入殿门用《正安》。","author":"郊庙朝会歌辞","text":"南山之巩，皇寿无穷。\n太极之尊，皇名是崇。\n奉兹宝册，于皇之宫。\n皇则受之，于昭盛容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其五","author":"郊庙朝会歌辞","text":"既肃琨庭，载升金戺。\n乃导乃陪，威仪济济。\n天步继临，孝诚备矣。\n声容孔昭，中外悦喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嘉泰二年恭上太皇太后尊号八首 其五","author":"郊庙朝会歌辞","text":"文物备矣，三事其承。\n崇牙高张，乐充宫庭。\n耽耽广殿，左墄右平。\n敬尔威仪，摄齐以登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍定三年寿明仁福慈睿皇太后册宝九首 其三","author":"郊庙朝会歌辞","text":"帝阙肃开，天阶坦履。\n霓旌羽盖，导仪护卫。\n匪誇雕瑑，匪矜繁丽。\n兹谓盛仪，亿载千岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍定三年寿明仁福慈睿皇太后册宝九首 其五","author":"郊庙朝会歌辞","text":"皇仪有炜，綵舁次升。\n沈沈邃殿，穆穆天廷。\n坤德罙隆，皇图永宁。\n咨尔廷臣，摄齐以登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴十三年发皇后册宝十三首 其七","author":"郊庙朝会歌辞","text":"温惠之德，袆翟之衣。\n行中采荠，礼无或违。\n降于丹陛，有容有仪。\n委委蛇蛇，谁其似之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙十六年皇后册宝十三首 其六","author":"郊庙朝会歌辞","text":"华榱璧珰，有馨椒殿。\n备物来陈，多仪式焕。\n曰册曰宝，是刻是瑑。\n并举以行，皇矣懿典。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其二","author":"郊庙朝会歌辞","text":"熛阙蟺蜎，璧门云龙。\n烈文维辅，翊奉有容。\n典章煇明，彝度肃雍。\n蒇时缛仪，登于璿宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其四","author":"郊庙朝会歌辞","text":"帟旒云舒，金秀充庭。\n璇卫銮华，茜佩垂?。\n皇容熙备，柔仪顺承。\n三宫齐欢，万福昭膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其五","author":"郊庙朝会歌辞","text":"骖翟崇容，袆鞠陈衣。\n戾止兰殿，夙兴椒闱。\n淑正宣华，粹明腾煇。\n钦若有承，嗣音之徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其六","author":"郊庙朝会歌辞","text":"袆帟流光，沙祥增衍。\n编玉镂德，螭金溢篆。\n粹猷藻黻，徽文华显。\n二南声诗，于时昭阐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其九","author":"郊庙朝会歌辞","text":"肃肃壶彝，雍雍阴教。\n险诐自防，警戒是效。\n中闱端委，列御胥告。\n其思辅顺，永翼帝孝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其十","author":"郊庙朝会歌辞","text":"天子九嫔，王宫六寝。\n有烨令仪，载秩华品。\n福履绥将，节用躬俭。\n矢其德音，于以来谂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其二","author":"郊庙朝会歌辞","text":"丰芑诒谋，建尔元子。\n揆礼仪年，筮宾敬事。\n八音克谐，嘉宾至止。\n于以冠之，成其福履。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其三","author":"郊庙朝会歌辞","text":"礼国之本，冠礼之始。\n宾升自西，维宾之位。\n于著于阼，维子之义。\n厥惟钦哉，敬以从事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十一","author":"郊庙朝会歌辞","text":"有宾在筵，有尊在户。\n磬管将将，醮礼时举。\n跪觞祝辞，以永燕誉。\n宝祚万年，磐石巩固。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其一","author":"郊庙朝会歌辞","text":"鹿鸣呦呦，命侣与俦。\n宴乐嘉宾，既献且酬。\n献酬有序，休祉无疆。\n展矣君子，邦家之光。\n鹿鸣呦呦，在彼中林。\n宴乐嘉宾，式昭德音。\n德音愔愔，既乐且湛。\n允矣君子，实慰我心。\n鹿鸣呦呦，在彼高冈。\n宴乐嘉宾，吹笙鼓簧。\n币帛戋戋，礼仪蹡蹡。\n乐只君子，利用宾王。\n鹿鸣相呼，聚泽之蒲。\n我乐嘉宾，鼓瑟吹竽。\n我命旨酒，以燕以娱。\n何以赠之，玄纁粲如。\n鹿鸣相邀，聚场之苗。\n我美嘉宾，令名孔昭。\n我命旨酒，以歌以谣。\n何以置之，大君之朝。\n鹿鸣相应，聚山之荆。\n我燕嘉宾，鼓簧吹笙。\n我命旨酒，以逢以迎。\n何以荐之，扬于王庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其二","author":"郊庙朝会歌辞","text":"瞻彼南陔，时物嘉良。\n有泉清泚，有兰馨香。\n晨饮是汲，夕膳是尝。\n慈颜未悦，我心靡遑。\n嬉嬉南陔，眷眷慈颜。\n和气怡色，奉甘与鲜。\n事亲是宜，事君是思。\n虔勖忠孝，邦家之基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其三","author":"郊庙朝会歌辞","text":"洋洋嘉鱼，伫以美罛。\n君子有道，嘉宾式燕以娱。\n洋洋嘉鱼，伫以芳罟。\n君子有德，嘉宾式歌且舞。\n我有宫沼，龟龙扰之。\n君子有礼，嘉宾式贵表之。\n我有宫薮，麟凤来思。\n君子有乐，嘉宾式慰勤思。\n相彼嘉鱼，爰纵之壑。\n我有旨酒，嘉宾式燕以乐。\n相彼嘉鱼，在汉之梁。\n我有旨酒，嘉宾式燕以康。\n森森乔木，美蔓萦之。\n我有旨酒，嘉宾式燕宜之。\n喈喈黄鸟，载飞载止。\n我有旨酒，嘉宾式燕且喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其四","author":"郊庙朝会歌辞","text":"崇丘峨峨，动植斯属。\n高既自遂，大亦自足。\n和风斯扇，膏雨斯沐。\n我仁如天，以亭以育。\n崇丘巍巍，动植其依。\n高大之性，各极尔宜。\n王道坦坦，皇猷熙熙。\n仁寿之域，烝民允跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其五","author":"郊庙朝会歌辞","text":"关雎于飞，洲渚之湄。\n自家刑国，乐且有仪。\n郁郁芳兰，幽人撷之。\n温温恭人，哲后求之。\n求之无斁，寤寐所属。\n罄尔一心，受天百禄。\n郁郁芳兰，雨露滋之。\n温温恭人，圭组縻之。\n郁郁芳兰，佩服珍之。\n温温恭人，福履绥之。\n关雎跄跄，集水之央。\n好求贤辅，同扬德光。\n蘋蘩芳滋，同谁掇之。\n愿言贤德，靡日不思。\n偶其贤德，辅成己职。\n永配玉音，服之无斁。\n洁其粢盛，中心匪宁。\n荐于宗庙，助君德馨。\n贤淑来思，人之表仪。\n风化天下，何乐如之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化乡饮酒三十三章 其六","author":"郊庙朝会歌辞","text":"彼鹊成巢，尔类攸处。\n之子有归，琼瑶是祖。\n彼鹊成巢，尔类攸匹。\n之子有行，锦绣是饰。\n彼鹊成巢，尔类攸共。\n之子有从，兰荪是奉。\n伊鹊成巢，珍禽戾止。\n婉彼佳人，配于君子。\n伊鹊营巢，珍禽攸处。\n内助贤侯，弼于明主。\n伊鹊营巢，珍禽辑睦。\n均养嘉雏，致于蕃育。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方丘乐歌 其八","author":"郊庙朝会歌辞","text":"修理方丘，吉蠲是宜。\n笾豆静嘉，登于有司。\n芬芬馨香，来享来仪。\n郊仪将终，声歌彻之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祫飨太庙 其五","author":"郊庙朝会歌辞","text":"景炎启旦，宝系开基。\n登俎如在，缩鬯有仪。\n明灵昭格，孝飨肃祗。\n福茨绵瓞，罄宇均禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祫飨太庙 其八","author":"郊庙朝会歌辞","text":"赫赫閟宫，肇亲合食。\n玉步徊翔，大姿严翼。\n洗奠交举，堂除并饬。\n礼宾无违，神其昭格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祫飨太庙 其十","author":"郊庙朝会歌辞","text":"嘉牲在俎，广乐在庭。\n其所将者，曰躬曰诚。\n神兮来歆，以安以宁。\n以锡寿嘏，惟皇是膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其十四","author":"郊庙朝会歌辞","text":"牲牷腯肥，粢盛丰洁。\n三献用行，万舞复列。\n礼仪克成，乐奏将阕。\n神保聿归，玉豆斯彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"御楼 其一","author":"郊庙朝会歌辞","text":"五辂鸣鸾，八神警跸。\n天官景从，莫不祗栗。\n祲威盛容，昭哉祖述。\n祚我无疆，叶气充溢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祫飨回升楼 其一","author":"郊庙朝会歌辞","text":"飨于宗祧，维圣之孝。\n骖腾素虬，还归自庙。\n端闱百常，耸环七校。\n万邦倾瞻，天若覆焘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书木牌 其一","author":"释无梦","text":"身为车兮心为轼，车动轼随何计息。\n交梨火枣是谁无，自是不除荆与棘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书木牌 其二","author":"释无梦","text":"身为客兮心为主，主人平和客安堵。\n若还主客不康宁，精神管定辞君去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"石道士","text":"石压笋斜出，崖悬花倒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏李氏","author":"张浩","text":"华胥佳梦惟闻说，解佩江皋浪得声。\n一夕东轩多少事，韩郎虚负窃香名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶亭","author":"叶桂女","text":"乐天当日最多情，泪滴青衫酒重倾。\n明月满船无处问，不闻商女琵琶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"濂溪识行","author":"魏嗣孙","text":"分得庐山水一溪，濂名万古合昭垂。\n光风霁月依然在，肯与人间较盛衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"官人子弟","text":"细草行縢路，垂杨席帽风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题巨商壁","author":"靓禅师","text":"去年巢穴画梁边，春暖双双绕槛前。\n莫讶主人帘不捲，恐衔泥土污花砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"欧阳景","text":"清明时节正秾芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"杨黎州","text":"顿缨狂走鹿，吐沫倦游鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠尼还俗","author":"史君实","text":"脱却霞裾著绣裙，仙凡从此路歧分。\n蛾眉再画当时月，蝉鬓重梳旧日云。\n玉貌缓将鸾镜照，锦衣兼把麝香薰。\n屏帏乍得萧郎爱，更没心情忆老君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"压云轩","author":"胡清","text":"谁建危亭压翠微，画檐直与暮云齐。\n有时一片岩隈起，带与老僧山下归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹马","author":"刁麟游","text":"小儿骑竹作骅骝，犹是东西意未休。\n我已童心无一在，十年浑付水东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居 其十一","author":"淳藏主","text":"幽岩静坐来驯虎，古涧经行自狎鸥。\n不是忘机能绝念，大都投老得心休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居 其十二","author":"淳藏主","text":"怕寒懒剃髼松发，爱煖频添榾柮柴。\n栗色伽梨撩乱挂，谁能劳苦强安排。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题沈乌盆尸股","author":"李氏子","text":"洪州沈乌盆，塑佛舍三尊。\n一朝饥冻死，衣不庇其臀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游秀峰寺","author":"刘无降","text":"晓乘轻舸出江城，晚上篮舆却倦行。\n尽日松风响岩谷，小窗听作乱泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春帖子","author":"梁君贶","text":"东方和气斗回杓，龙角中星转紫霄。\n圣主问安天未晓，求衣亲护玉宸朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北固楼","author":"李公异","text":"北固横江尽，东南第一州。\n六朝都在望，回首倦登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"萧实","text":"万株翠干根成后，一个閒僧手植初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"毛季子","text":"独上云梯三百级，回眸失笑万山低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"刘接","text":"兴于东晋废于陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"刘接","text":"废于袁宪相陈年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"孙信臣","text":"林掩羊公庙，渊沈杜预碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大堤曲","author":"李善美","text":"酒旗相望大堤头，堤下连樯堤下楼。\n日暮行人争渡急，桨声幽轧满中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行次汉上","author":"释无本","text":"习家池沼草萋萋，岚树光中信马蹄。\n汉主庙前湘水碧，一声风角夕阳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马嵬","author":"释无本","text":"长川几处树青青，孤驿危楼对翠屏。\n一自玉皇惆怅后，至今来往马蹄腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"刘某","text":"度暑田夫作竹衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赖仙翁","text":"巧妙四山云岫落，玲珑双甑月灯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"赖仙翁","text":"宝山流连井，久立方知省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"郭汝臣","text":"龙抛玉涧归金阙，鹿认桃源入洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李左史","text":"溪流玉雪三三曲，山锁烟霞六六峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"唐子真","text":"捲衣更上前岩去，别有云山千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"唐子真","text":"碧玉环中藏世界，白云影里见楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广安","author":"雍某","text":"欲说宾城好，先誇方物妍。\n金羹收稻后，红腊落梅前。\n照座梨偏紫，堆盘荔更鲜。\n清州如斗大，盛事数从前。\n崖日神留传，山高子得仙。\n何诗春梦草，张谏力回天。\n人物宜旌表，虫鱼不足笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"蒲公","text":"莺花非汉旧，栋宇尚唐馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"杨粹","text":"击瓯楼在碧江隈，楼下江声寂寞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"姚彦游","text":"闻说巴南无一事，助人清思有江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"堤上归 其二","author":"盛烈","text":"片云筛雨过横塘，衬断蘋风作晚凉。\n意快短檠推不照，柳边听月对啼螀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]