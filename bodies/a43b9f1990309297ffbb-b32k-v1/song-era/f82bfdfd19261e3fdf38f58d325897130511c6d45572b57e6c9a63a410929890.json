[{"title":"次仲庸初冬即事二首 其二","author":"裘万顷","text":"君家秋实洞庭种，小子持来独未黄。\n莫作苏州书后梦，只今正欠满林霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次仲庸初冬即事二首 其一","author":"裘万顷","text":"常岁霜天分外晴，一溪如练浸冰轮。\n今年风雨宁无夜，谁与溪梅作小春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次伯仁过道傍田家韵","author":"裘万顷","text":"桃源千载锁烟云，若辈安知古有秦。\n恐是吴兴沈东老，一樽聊复醉诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其三","author":"裘万顷","text":"烂熳花阴覆短墙，花开时候日偏长。\n道人不被春勾引，到处惟闻薝卜香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其一","author":"裘万顷","text":"飞花数点雨初歇，啼鸟一声春正长。\n读罢黄庭了无事，旋安银叶试炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其二","author":"裘万顷","text":"古木阴阴六月凉，幽花藉藉四时香。\n丝桐清夜作三弄，明月入帘风拂床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其四","author":"裘万顷","text":"不见诗仙何逊来，春风几度早梅开。\n竹篱茅舍自清绝，未用移根东阁栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其五","author":"裘万顷","text":"恰则梅边春意萌，困人天气又清明。\n炉熏茗碗北窗下，卧听绵蛮黄鸟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其六","author":"裘万顷","text":"已著遗经洗此心，更寻流水濯吾襟。\n经旬不涉溪边路，荇带苔钱如许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其七","author":"裘万顷","text":"雾阁云窗先自幽，水声那更绕源流。\n春深红雨落桃径，昼永清风生茗瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其八","author":"裘万顷","text":"杨柳阴中啼杜鹃，梧桐枝上噪玄蝉。\n篇章满眼无人会，赢得诗翁取意编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其九","author":"裘万顷","text":"纷纷眼底正争驰，我独冥心绝五綦。\n说与傍人俱不信，故山惟有白云知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十","author":"裘万顷","text":"争春桃李太匆匆，随手飘零逐晓风。\n冰雪不侵尘不污，可人惟有岁寒松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十一","author":"裘万顷","text":"颜杨翰墨今谁解，陶谢篇章古所无。\n安得金丹换凡骨，白头深恐愧吾夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十二","author":"裘万顷","text":"平池春去水溶溶，人在笙歌一部中。\n柳叶翻风罗带绿，荷花著雨锦衣红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十三","author":"裘万顷","text":"檐间新燕几时来，檐外闲花往岁栽。\n丹杏碧桃浑落尽，绿阴低处结青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十四","author":"裘万顷","text":"淡月笼花花映窗，好风吹竹竹浮香。\n梦回何处一声笛，人静山幽天正凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十五","author":"裘万顷","text":"无所用心鱼在沼，居然生子燕成窠。\n谁言春去花事歇，萱草石榴情更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十六","author":"裘万顷","text":"为怜风雨趣春回，故著秋花到处栽。\n兰菊从来盛风味，不妨环绕读书斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十七","author":"裘万顷","text":"白云殊不作俗态，流水更似知人心。\n溪边濯足溪上坐，樵唱一声秋满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十八","author":"裘万顷","text":"坡谷遗书那复有，向来一纸抵千金。\n谁知悬腕与卧笔，如用大都留此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余仲庸松风阁韵十九首 其十九","author":"裘万顷","text":"俗书本作于湖样，野鹜家鸡强自分。\n王氏无人鲁公死，只今何处觅云仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次余求之坐间所赋","author":"裘万顷","text":"地僻不闻车马闹，官闲但觉屋庐深。\n摆除诗债寂无事，一炷炉香观此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴长文见寄时有衡山之役","author":"裘万顷","text":"夜半诗成欲寄君，梦魂飞渡楚江津。\n怡怡前日如兄弟，今作东西南北人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次吴司理见贻二绝韵 其一","author":"裘万顷","text":"朱金得丧日悲欢，内乐知谁梦见颜。\n君有上池无限水，不将涓滴到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李司直韵二首 其二","author":"裘万顷","text":"清虚绝迹竟何为，自笑平生颇好之。\n正路傥非君得似，冥行未免用多歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李司直韵二首 其一","author":"裘万顷","text":"老来方欲卧林泉，一蹑红尘只自怜。\n已与山灵有成说，秋风归骑急加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内相双竹韵三首 其三","author":"裘万顷","text":"管鲍交情真耐久，夷齐义气更无双。\n虚花满眼风号怒，一节青青终不降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内相双竹韵三首 其二","author":"裘万顷","text":"婵娟两枝翠可掬，绝胜白璧南金双。\n留与先生作椽笔，诗坛八面受人降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内相双竹韵三首 其一","author":"裘万顷","text":"延平两龙几年卧，欻尔化作寒枝双。\n春桧长松皆敌国，会须因垒一时降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内翰十月桃韵三首 其三","author":"裘万顷","text":"不须羯鼓促春工，一树霜边取意红。\n寄语玄冥为收拾，莫教人恨五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内翰十月桃韵三首 其二","author":"裘万顷","text":"旧日骊山宫殿中，玉妃无数舞衫红。\n只因归去蓬莱后，梦作寒花笑北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪内翰十月桃韵三首 其一","author":"裘万顷","text":"千红万蕊彫零尽，安得枝头数点红。\n疑是神人写春色，镇长留影在屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次敬叔韵二首 其二","author":"裘万顷","text":"别我新诗有许清，玉声金韵两琮铮。\n笔端定自翻三峡，乞与馀波赋赠行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次敬叔韵二首 其一","author":"裘万顷","text":"玉鉴冰壶一段清，铁中谁与斗铮铮。\n眼看万里云霄路，不信骅骝地上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别胡仲立次敬子伯量二丈韵二首 其二","author":"裘万顷","text":"乾枯如我真何用，谩结蒲团竹椅缘。\n缄口向人无一语，此灯他日遣谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别胡仲立次敬子伯量二丈韵二首 其一","author":"裘万顷","text":"脩水相望无百里，从来人物胜西昌。\n弘斋自是朝阳凤，伯仲行看接翼翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别曹教授三首 其三","author":"裘万顷","text":"江花岸柳太多情，长逐春风管送迎。\n我亦思归归未得，夜窗愁听杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别曹教授三首 其二","author":"裘万顷","text":"从渠柳色自青青，莫为行人赋渭城。\n只恐南墙旧时竹，误随风雨作离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别曹教授三首 其一","author":"裘万顷","text":"一岁与君三别离，盍簪此去定何时。\n梅花未必堪相寄，待倩邮筒寄小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其二","author":"裘万顷","text":"春时耕种夏时耘，七月农夫始食新。\n此去田家常要雨，雨多元自不妨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事二首 其一","author":"裘万顷","text":"门前溪水欲平堤，谩著渔竿浅处垂。\n晴雨每关忧国念，丰凶端欲问人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋吟","author":"裘万顷","text":"骄阳赫赫转秋阴，便觉萧然鬓影侵。\n世事炎凉俄忽尔，闲来物理静推寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其七","author":"裘万顷","text":"无事萦心昼掩扉，松风度曲入琴徽。\n登高老矣兴犹在，塞上秋风战马肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其五","author":"裘万顷","text":"闲中无辱亦无荣，案上图书有课程。\n静对秋花香默默，晚风休送乱蝉鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其四","author":"裘万顷","text":"闭门思古或伤今，每有诗来默契心。\n纸上不须评巧拙，尧夫只是静中吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其三","author":"裘万顷","text":"牵牛引蔓上东篱，气肃清商雨过时。\n人意若随天意好，秋光又到菊花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其二","author":"裘万顷","text":"西风黄叶埽空庭，舞鹤翩翩堕雪翎。\n一阵清风通鼻观，木犀亭下读骚经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其一","author":"裘万顷","text":"少年有策志平戎，心事今成一老翁。\n蜀客款门茶未了，防秋又说枣儿红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松斋秋咏次黄存之韵七首 其六","author":"裘万顷","text":"据梧枝策事纷纭，楼上看山对晚曛。\n纵是楼无山色远，只如小米画烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其六","author":"裘万顷","text":"人生天地间，离别安能无。\n莫作儿女态，相期烈丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其一","author":"裘万顷","text":"平生不量力，妄意希前脩。\n懵懵虽无见，拳拳未敢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯吴长文司理用脩持贤业教无欠为韵 其二","author":"裘万顷","text":"狂澜涌如此，砥柱其谁为。\n天意必有在，吾身姑自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保福寺对橙菊有感","author":"裘万顷","text":"平生爱菊陶彭泽，清夜移橙杜草堂。\n千载诗魂招不得，独留风味在僧房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸亥夜梦","author":"裘万顷","text":"丙夜清眠正熟时，梦魂飞去拜丹墀。\n小臣乍得披肝胆，感慨分明涕泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日即事","author":"裘万顷","text":"断雁声边小雨来，菊花强半卧苍苔。\n乍寒天气虽宜酒，冷淡无心把酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"裘万顷","text":"数声牧笛日将晚，一曲樵歌山更幽。\n解带盘桓小溪上，坐看红叶汎清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荐福寺次许师咏竹","author":"裘万顷","text":"浮云踪迹任西东，翰墨场中且用功。\n时对此君哦七字，也胜痴坐辩幡风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱仲庸主簿入京三首 其三","author":"裘万顷","text":"野梅官柳只供愁，空倚鄱江百尺楼。\n待倩天边几鸿雁，为传消息到皇州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱仲庸主簿入京三首 其二","author":"裘万顷","text":"孤山梅蕊正开时，杖屦还须访水湄。\n莫遣冰魂叹牢落，只今和靖自能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱仲庸主簿入京三首 其一","author":"裘万顷","text":"风帆转眼即长安，好在交游半达官。\n既有王阳知贡禹，不妨乘兴一弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高安别苏野塘三首 其三","author":"裘万顷","text":"交盖才倾便语离，绝怜立马送君时。\n梅花未必堪相寄，待倩邮筒寄小诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高安别苏野塘三首 其二","author":"裘万顷","text":"胸中泉石真成癖，纸上云烟总是诗。\n分我渔舟三四个，故山归去弄涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高安别苏野塘三首 其一","author":"裘万顷","text":"独立每怜陶靖节，北窗终日傲羲皇。\n如今我亦无侪辈，远把心期付野塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿翠岩寺呈李弘斋签判","author":"裘万顷","text":"匡庐胜处君曾到，谁是渊明与远公。\n幸有和陶诗卷在，好依莲社此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元龄弟五首 其五","author":"裘万顷","text":"一室萧然百事无，崇朝趺坐对熏炉。\n岫云舒卷元无碍，赢得从容养病躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元龄弟五首 其四","author":"裘万顷","text":"少年妄作功名想，说著长安喜欲狂。\n多病年来怕奔走，却思云壑置藤床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元龄弟五首 其三","author":"裘万顷","text":"俯仰之间又一年，即看科诏下天边。\n功名万一来相逼，试向荣途小著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元龄弟五首 其二","author":"裘万顷","text":"莫怪穷年不入州，载书前已会盟鸥。\n市朝毕竟多尘事，且傍溪山静处留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄元龄弟五首 其一","author":"裘万顷","text":"馀生端合老吾庐，心地全然与世疏。\n安得数椽西岭下，自行溪水灌园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宋居士脩叔求庵记","author":"裘万顷","text":"翠琰新刊照眼明，流传何日到柴荆。\n从今不恨论交晚，我亦碑中有姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张仲符时得乌石冈地二首 其二","author":"裘万顷","text":"寸田尺地可长久，此诀刘郎却未传。\n他日驭风蓬岛去，谩留陈迹在山巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张仲符时得乌石冈地二首 其一","author":"裘万顷","text":"今人那似古人贤，一锸随身日醉眠。\n此老有灵应笑我，区区常费买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题真爱堂三首 其三","author":"裘万顷","text":"筑堂谁不要看山，往往襟期了不关。\n欲识此翁高绝处，一心长在白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题真爱堂三首 其二","author":"裘万顷","text":"真实爱山今有谁，此心猿鹤亦难欺。\n看来却是朱居士，不愧昌黎五字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题真爱堂三首 其一","author":"裘万顷","text":"终南佳处暂栖迟，堪笑唐朝左拾遗。\n渠但借山为捷径，山中滋味岂曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中再示德龄二弟三首 其三","author":"裘万顷","text":"青青窗外几修篁，也学宫梅巧样妆。\n说与惠连须著句，雪边春色到池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]