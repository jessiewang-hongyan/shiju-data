[{"title":"嘉祐院观壁间文湖州墨竹","author":"陆游","text":"石室先生笔有神，我来拂拭一酸辛。\n败墙惨澹欲无色，老气森严犹逼人。\n惯阅冰霜元耐久，耻随儿女更争春。\n纷纷可笑空摹拟，尔辈毫端万斛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮归马上作","author":"陆游","text":"石笋街头日落时，铜壶阁上角声悲。\n不辞与世终难合，惟恨无人粗见知。\n宝马俊游春浩荡，江楼豪饮夜淋漓。\n醉来剩欲吟梁父，千古隆中可与期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮归舟中二首 其二","author":"陆游","text":"湖水绿可爱，弄桡冲夕霏。\n林昏渔火壮，山转寺钟微。\n老叹世情恶，穷知心事违。\n回头语孤鹤，伴我莫先飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮归舟中二首 其一","author":"陆游","text":"五月未剧暑，暮从城市还。\n断虹低饮涧，落日远衔山。\n蟹舍丛芦外，菱舟薄霭间。\n诗情终草草，虚遣鬓毛斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮行","author":"陆游","text":"志士能轻万户封，野人自爱一枝筇。\n行穷绿岸呼船渡，籴得黄粱就碓舂。\n林外人家明远火，月边僧阁下疏钟。\n江村不用愁孤绝，小店茅檐尽见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陆游","text":"忙里偷闲慰晚途，春来日日在东湖。\n凭栏投饭看鱼队，挟弹惊鸦护雀雏。\n俗态似看花烂漫，病身能斗竹清癯。\n一樽是处成幽赏，风月随人不用呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陆游","text":"憔悴都门白发新，归来一振客衣尘。\n啼莺妒梦频催晓，飞絮钟情独殿春。\n湖上风光犹淡沱，尊前怀抱颇清真。\n诗成绝恨知心少，自写吴笺寄故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陆游","text":"数间茅屋镜湖滨，万卷藏书不救贫。\n燕去燕来还过日，花开花落即经春。\n开编喜见平生友，照水惊非曩岁人。\n自笑灭胡心尚在，凭高慷慨欲忘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"陆游","text":"山阴又见暮春初，禁火园林社雨馀。\n世事不妨随日改，年光未遽与人疏。\n豉香下箸尝莼菜，盐白开奁得䱥鱼。\n草草一杯终可喜，数间茅屋亦吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春二首 其一","author":"陆游","text":"季子黄金尽，安仁白发新。\n无情五更雨，便送一年春。\n难续西楼梦，空存北陌身。\n海棠应似旧，惆怅又成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春龟堂即事四首 其四","author":"陆游","text":"东皇促驾又天涯，一片难寻堕地花。\n瘦策穿林数新笋，素屏围枕听鸣蛙。\n蚕房已里清明种，茶户初收谷雨芽。\n欲把一杯壶已罄，谩搜诗句答年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春龟堂即事四首 其一","author":"陆游","text":"风日初和昼漏长，萧然巾屦集茆堂。\n雨馀千叠暮山绿，花落一溪春水香。\n断简椟中尘委积，故人墓上草荒凉。\n尔来幸有宽怀处，病退床头减药囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春龟堂即事四首 其二","author":"陆游","text":"踯躅花开照眼明，缓扶藤杖绕廊行。\n流年又见一春过，苦雨略无三日晴。\n觅句未应妨熟睡，漱泉聊足解馀酲。\n鹿麛雉子常追逐，谁识山翁及物情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春龟堂即事四首 其三","author":"陆游","text":"日月无根去若驰，故园又见落花时。\n杯中绿酒不肯饮，镜里苍颜应自知。\n千丈新堤湖水满，五更残漏角声悲。\n暮年父子难乖隔，淮浦书来苦觉迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋二首 其一","author":"陆游","text":"时序中年速，风霜客路长。\n孤愁巴月白，清梦楚山苍。\n灯暗秋衔壁，钟疏夜殷床。\n端居有微禄，不敢恨殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋","author":"陆游","text":"十日都门雨，风烟已暮秋。\n甑香新菽粟，篝暖故衣裘。\n意气临书健，形骸顾影愁。\n何时剡中路，秣蹇憩山邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋二首 其二","author":"陆游","text":"万里归无策，八年淹此留。\n羞蒙子公力，宁倦长卿游。\n听雨潇湘夜，飞鹰鄠杜秋。\n更须论富贵，此计亦悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋书事","author":"陆游","text":"暮秋风雨卷茆茨，砧杵声中过雁悲。\n枫叶欲丹先惨澹，菊丛半倒不支持。\n旗亭人熟容赊酒，野寺僧闲得对棋。\n莫怪苦寻林下事，骇机满地只心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋有怀王四季夷","author":"陆游","text":"镜湖西畔小茅茨，红叶黄花秋晚时。\n天阔素书无雁寄，夜阑清梦有灯知。\n功名蹭蹬初何憾，朋旧乖离未免悲。\n遥想扁舟五湖口，阻风中酒又成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋遣兴二首 其二","author":"陆游","text":"平生南地惯羁游，放浪常同不系舟。\n鼍作夜风经沌口，鹳鸣秋雨宿杭头。\n方倾意气轻秦侠，俄困悲伤类楚囚。\n买屋数间聊作戏，岂知真用作菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮秋遣兴二首 其一","author":"陆游","text":"改尽朱颜白尽头，杜门亦复弊貂裘。\n断鸿影外玉关月，病骥嘶中青海秋。\n孤坐向空书咄咄，闲吟随处送悠悠。\n如虹壮气终难豁，安得云涛万里舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠围院","author":"陆游","text":"晓入翠围寺，拥门千万峰。\n山空鸟自命，林茂鹿相从。\n袅袅风中笮，昏昏云外钟。\n将归兴未尽，清啸倚长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微堂","author":"陆游","text":"万顷青山只一溪，此中聊欲效真栖。\n寻深巧被闲云到，破静时闻幽鸟啼。\n羞有卑功追管晏，惭无高节比夷齐。\n困眠饥食真吾事，宝篆香残日又西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜻蜓浦","author":"陆游","text":"舍北蜻蜓浦，新秋偶一来。\n菱丝烟际老，芡觜露中开。\n渔火明还灭，沙禽去却回。\n吾行兴无尽，舟子莫相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜻蜓浦夜泊","author":"陆游","text":"风雨忽如秋已深，短篷今夜系枫林。\n溪翁那问市朝事，蔬食不生杯炙心。\n横截烟波飞健鹘，远投沙渚落羁禽。\n斯游谁道伤幽独，犹有残钟伴苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赛神","author":"陆游","text":"岁熟乡邻乐，辰良祭赛多。\n荒园抛鬼饭，高机置神鹅。\n人散丛祠寂，巫归醉脸酡。\n饥鸦更堪笑，鸣噪下庭柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静室","author":"陆游","text":"静室床横一素琴，尔来殊觉道根深。\n唤回倦枕功名梦，洗尽浮生幻妄心。\n两屦云烟游少室，一窗风雪宿东林。\n细思却是关身事，无奈残年老病侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静院","author":"陆游","text":"静院房栊雨送凉，熏笼衣帻润生香。\n小屏风叠图遥碧，古锦囊书拓硬黄。\n已占江湖宽处老，绝知日月静中长。\n敲门无客妨人睡，更觉馀年乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲子聿","author":"陆游","text":"讲诵多吴语，钩提学佐书。\n夜分灯未彻，晨起发慵梳。\n饱食园官菜，少留溪友鱼。\n能怜乃翁病，身自举篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲布谷","author":"陆游","text":"时令过清明，朝朝布谷鸣。\n但令春促驾，那为国催耕。\n红紫花枝尽，青黄麦穗成。\n从今可无语，倾耳舜弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲畜猫","author":"陆游","text":"甚矣翻盆暴，嗟君睡得成。\n但思鱼餍足，不顾鼠纵横。\n欲骋衔蝉快，先怜上树轻。\n朐山在何许，此族最知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暴雨","author":"陆游","text":"风怒欲掀屋，雨来如决堤。\n孤灯映窗灭，羁鸟就檐栖。\n暑令方炎赫，秋声忽惨凄。\n传闻涨江水，已断瀼东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樊江","author":"陆游","text":"手中一卷养鱼经，又向樊江上草亭。\n朝雨染成新涨绿，春烟澹尽远山青。\n榜舟不厌频来往，岸帻常须半醉醒。\n赋罢新诗自高咏，满汀鸥鹭欲忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横塘","author":"陆游","text":"横塘南北埭西东，拄杖飘然乐未穷。\n农事渐兴人满野，霜寒初重雁横空。\n参差楼阁高城上，寂历村墟细雨中。\n新买一蓑苔样绿，此生端欲伴渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潺湲阁小立","author":"陆游","text":"饱食何曾补县官，潺湲阁上倚阑干。\n水纹靴皱风初紧，花色鞓红露未乾。\n薄酒愁边供醉醒，故人梦里话悲欢。\n孤城正在山穷处，过社今朝尚尔寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬饭","author":"陆游","text":"春事已阑珊，山村未褪寒。\n笋生初入馔，荠老尚登盘。\n僧饭时分钵，园蔬不仰官。\n枯肠更禁搅，姑置密云团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬食","author":"陆游","text":"肉食从来意自疑，斋盂况与病相宜。\n老羝昔作春蔬祟，断稿今无晚钓诗。\n陌上烟苕谁采采，墙阴风叶正离离。\n人生饥饱初何校，一斛槟榔笑汝痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬食","author":"陆游","text":"墙阴春荠老，笋蕨正登盘。\n野馌元无妇，村醅不属官。\n何由取熊掌，幸免买猪肝。\n犹胜烦秦相，绨袍闵一寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔬圃","author":"陆游","text":"蔬圃依山脚，渔扉并水涯。\n卧枝开野菊，残蘖出秋茶。\n病骨知天色，羁怀感物华。\n馀年有几许，且灌邵平瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉乡","author":"陆游","text":"醉乡卜筑亦佳哉，但苦无情白发催。\n痴欲煎胶黏日月，狂思入海访蓬莱。\n辞巢归燕先秋去，泣露幽花近社开。\n莫惜倾家供作乐，古人白骨有苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中出西门偶书","author":"陆游","text":"古寺闲房闭寂寥，几年耽酒负公朝。\n青山是处可埋骨，白发向人羞折腰。\n末路自悲终老蜀，少年常愿从征辽。\n醉来挟箭西郊去，极目寒芜雉兔骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中示客","author":"陆游","text":"四座无哗听我歌，百年生计一烟蓑。\n清尊潋潋犹狂在，白发萧萧奈老何。\n远适安能缩地脉，高眠聊足养天和。\n吾徒看尽人间事，莫爱车前印几窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中戏作","author":"陆游","text":"当年买酒醉新丰，豪士相期意气中。\n插羽军书立谈办，如山铁骑一麾空。\n玉关久付清宵梦，笠泽今成白发翁。\n堪笑灯前如意舞，尚将老健压诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中自赠","author":"陆游","text":"富贵犹宜早退休，一生龃龉更何求。\n赋形未至欠壬甲，语命宁须增斗牛。\n栗里收身贫亦乐，平陵埋骨死无忧。\n狂歌醉舞真当勉，剩折梅花插满头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中作","author":"陆游","text":"小市钟声断，高楼月色新。\n醉眠当大路，狂舞属行人。\n有客要元亮，无妻谏伯伦。\n山花信手插，不复惜乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中作","author":"陆游","text":"名酝羔儿拆密封，香粳玉粒出新舂。\n披绵珍䱹经旬熟，斫雪双螯洗手供。\n吟罢欲沉江渚月，梦回初动寺楼钟。\n炉烟袅袅衣篝暖，未觉家风是老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中作","author":"陆游","text":"宦游三十载，举步亦看人。\n爱酒官长骂，近花丞相嗔。\n湖山今入手，风月始关身。\n少吐胸中气，从教白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中到白崖而归","author":"陆游","text":"醉眼朦胧万事空，今年痛饮瀼西东。\n偶呼快马迎新月，却上轻舆御晚风。\n行路八千常是客，丈夫五十未称翁。\n乱山缺处如横线，遥指孤城翠霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中草书因戏作此诗","author":"陆游","text":"赐休暂解簿书围，醉草今年颇入微。\n手挹冻醪秋露重，卷翻狂墨瘦蛟飞。\n临池勤苦今安有，漏壁工夫古亦稀。\n稚子问翁新悟处，欲言直恐泄天机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中浩歌罢戏书","author":"陆游","text":"造物小儿如我何，还家依旧一渔蓑。\n穿云逸响苏门啸，卷地悲风易水歌。\n老眼阅人真烂熟，壮心得酒旋消磨。\n傍观虚作穷愁想，点检霜髯却未多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中登避俗台","author":"陆游","text":"半醉行歌上古台，脱巾散发谢氛埃。\n但知礼岂为我设，莫管客从何处来。\n剡曲烟波菱蔓滑，耶溪风露藕花开。\n老来世事浑成懒，一棹幽寻未拟回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中感怀","author":"陆游","text":"早岁君王记姓名，只今憔悴客边城。\n青衫犹是鹓行旧，白发新从剑外生。\n古戍旌旗秋惨淡，高城刁斗夜分明。\n壮心未许全消尽，醉听檀槽出塞声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中题民家壁","author":"陆游","text":"壮岁羁游厌故栖，暮年却爱草堂低。\n交情最向贫中见，世事常于醉后齐。\n松吹飕飕凉短发，芒鞋策策响新泥。\n吾诗戏用寒山例，小市人家到处题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉书","author":"陆游","text":"青草渡头波接天，山翁吟啸自悠然。\n朝餐偶过卖鱼市，晚泊时逢迎荻船。\n投老未除游侠气，平生不作俗人缘。\n一樽酌罢玻璃酒，高枕窗边听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉书","author":"陆游","text":"半年愁病剧，一雨喜凉新。\n稍与药囊远，初容酒盏亲。\n浩歌惊世俗，狂语任天真。\n我亦轻馀子，君当恕醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉书山亭壁","author":"陆游","text":"物外阳狂五百年，扁舟又系镜湖边。\n飞升未抵簪花乐，游宦何如听雨眠。\n绿蚁滟尊芳酝熟，黑蛟落纸草书颠。\n忽拈玉笛横吹去，说与傍人是地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉归","author":"陆游","text":"十亩春芜手自犁，瓜牛庐在镜湖西。\n禅心每笑弹棋局，道眼长捐刮膜篦。\n绝食就官分鹤料，无车免客笑鸡栖。\n旗亭酒贱秋风近，夜夜归来醉似泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉归","author":"陆游","text":"持酒江头到夕霏，愁城顿觉解重围。\n澄波宜月移船看，醉面便风走马归。\n末路已惊添白发，故人频报上黄扉。\n彊随官簿真成懒，乞我吴松旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉后庄门望西南诸山","author":"陆游","text":"身是咸阳旧酒徒，龙钟犹复泥村酤。\n百年略似梦长短，一醉且随家有无。\n登览未应惭脚力，功名正尔叹头颅。\n夕阳又凭阑干立，谁画三山岸帻图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉后作小草因成长句","author":"陆游","text":"天教老去未全衰，犹欠纵横万首诗。\n家近将军觞咏地，身如太史滞留时。\n酒翻银浪红螺盏，墨涌玄云紫玉池。\n流落不妨风味在，花前醉草写乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉卧道傍","author":"陆游","text":"烂醉今朝卧道傍，乡闾共为护牛羊。\n高怀那遣群儿觉，至理真能万事忘。\n唤起瘦躯犹嵬峨，扶归困睫更芒洋。\n冻齑快嚼茆檐下，拍手从人笑老狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉眠初起书事","author":"陆游","text":"身世元知似断蓬，流年分付酒杯中。\n饥寒未解士先老，风雨欲收花已空。\n泥补旧巢梁燕喜，水生支港钓船通。\n睡魔正费驱除力，隔竹敲茶赖小童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉赋","author":"陆游","text":"霜枫照茅屋，露菊插纱巾。\n今古无穷事，江湖未死身。\n直令依马磨，终胜拜车尘。\n我亦轻馀子，君当恕醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉睡初觉偶作","author":"陆游","text":"小圃醒还醉，幽窗起复眠。\n虚明炷香地，清润斸花天。\n老去才虽尽，穷来志益坚。\n阿瞒那可语，平日笑桥玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉歌","author":"陆游","text":"却日莫挥戈，君当听我歌。\n花残狂有限，酒熟闷无多。\n生理凭长镵，幽情寄短蓑。\n江湖秋万里，未死且婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉舞","author":"陆游","text":"短帽簪花舞道傍，年垂八十尚清狂。\n茸茸胎发朝盈栉，炯炯神光夕照梁。\n令尹阅人三仕已，太山在我一毫芒。\n药苗麦饭初何欠，全取愚儒百鍊刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉题","author":"陆游","text":"云栖涧饮未为高，起舞行歌亦足豪。\n试问食时观本草，何如酒后读离骚。\n游山不待飞双舄，剪水无因得快刀。\n熟睡市垆君勿笑，年来随事学餔糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":10868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]