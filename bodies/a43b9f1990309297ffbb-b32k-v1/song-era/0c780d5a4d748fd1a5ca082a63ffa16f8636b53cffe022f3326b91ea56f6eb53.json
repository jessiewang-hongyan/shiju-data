[{"title":"赠许季升五首 其四","author":"赵蕃","text":"惶恐滩头一扁舟，桃花水涨如乘流。\n君来叩户喜欲倒，一问此行还遂不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许季升五首 其三","author":"赵蕃","text":"方朔人传是岁星，又云太白本长庚。\n如何未免饥欲死，亦有佯狂万里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许季升五首 其二","author":"赵蕃","text":"清江人物推陈谢，不减当年孔与刘。\n肯为赋诗仍作序，要明吾子乃儒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠许季升五首 其一","author":"赵蕃","text":"东都籍甚汝南许，人物尝更月旦评。\n后嗣流传齐一变，如今推步有知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别耆英二首 其二","author":"赵蕃","text":"忆我移官惶恐滩，肯来徒步不为难。\n颇亦念君家四壁，囊中羞涩但频看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠别耆英二首 其一","author":"赵蕃","text":"学诗曾及谢玄晖，传授应同一唯归。\n旧宅纵荒书故在，不妨幽僻借僧扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠吴昴山人二首 其二","author":"赵蕃","text":"君行足迹遍江南，我亦飘零老不堪。\n幸自尊中有醇酎，何妨醉倒又空谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠吴昴山人二首 其一","author":"赵蕃","text":"又是芳菲一番新，寂寥依旧去年贫。\n相看不用谈馀事，且道逢迎有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠法雷","author":"赵蕃","text":"道人曾与谪仙游，仙去骑鲸师白头。\n骑鲸端复向何处，试问援琴招得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠南首座兼简卢老二首 其二","author":"赵蕃","text":"主人禅伯乃诗伯，招得渠来共此山。\n挂搭问侬能胆大，诗关直上有禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠南首座兼简卢老二首 其一","author":"赵蕃","text":"旋糊纸屋过冬寒，客至成开去即关。\n我亦借寮成挂搭，未妨朝暮往仍还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠笔工","author":"赵蕃","text":"食肉既无相，良工徒苦心。\n吁嗟君类我，何处觅知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤雨记所见","author":"赵蕃","text":"翠筱萧骚入屋寒，欻惊平地起风湍。\n驯除饥雀低飞去，弱羽毰毸似畏弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏昭父惠新刻李西台诸公帖二首 其二","author":"赵蕃","text":"翰墨要知真有种，怪来下笔每多姿。\n不如家学相传授，玉轴锦囊皆得师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"魏昭父惠新刻李西台诸公帖二首 其一","author":"赵蕃","text":"墨妙初闻探锦囊，刻成愈觉烂生光。\n登登打就分来处，雨合新篁夏日凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鬻菜者","author":"赵蕃","text":"早禾未熟晚尤迟，卖菜归来始得炊。\n谷者本从田户出，未滋反取市人嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"赵蕃","text":"涧落峰寒似往时，重阳面目许谁知。\n摇摇枫叶未全赤，草草菊花成后期。\n酒量稍增愁渴肺，诗材顿减费衰髭。\n一年节物财如此，太息空形老大悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"赵蕃","text":"今年重九日，舟楫次兰溪。\n怀古心虽壮，登高思却迷。\n山空分向背，木落尽高低。\n多少羁栖恨，寒猿断续啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日王越卿司法置酒要客始约登武安之塔为游人所先已过圆通晚更集于彦博之居越卿醉后作画其先大夫公亦能画云作诗二首 其二","author":"赵蕃","text":"王家父子竹林期，谈笑初无世俗姿。\n戏搦败毫成冻羽，醉回老力出枯枝。\n解吟秀句寰区满，不拟常称老画师。\n大令右军疑只尔，外人笑怪若能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日王越卿司法置酒要客始约登武安之塔为游人所先已过圆通晚更集于彦博之居越卿醉后作画其先大夫公亦能画云作诗二首 其一","author":"赵蕃","text":"登高有约乃相违，故遣村船逆上溪。\n寺与松篁元不隔，路经蓬藋却成迷。\n数君放逸仍怀古，老我悲凉况哭妻。\n郑重莫逃鸡黍社，又随新月共扶藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日有感","author":"赵蕃","text":"寥落渊明后，凄凉九日期。\n寻花漫青蕊，对酒祇空卮。\n林密栖鸦早，江寒泊雁迟。\n楼高无那倚，弦绝有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日次韵斯远去年是日同成父登半山亭见怀之什寄斯远兼示成父","author":"赵蕃","text":"去岁修途度此晨，今年抱疾更漳滨。\n官壶可醉难多致，城菊未开空屡巡。\n忆我有诗朝在手，思君何处暮伤神。\n遥知置酒登高者，回首西南只两人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日怀周仲材","author":"赵蕃","text":"吹帽今朝是，登高旧俗同。\n穷乡怕逢节，病骨怯临风。\n此日千忧里，他时一梦中。\n白衣殊不至，空绕菊篱东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日莫令置酒县斋余以病不饮作诗呈坐客","author":"赵蕃","text":"孰使庭花未肯黄，政应知我鬓新霜。\n茫茫永夜无时旦，索索穷愁曾断肠。\n坐久支吾催煮药，饮豪络驿看传觞。\n废游不但因公事，风雨连朝故觉妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日寄和父弟","author":"赵蕃","text":"走马忆登江上台，闻知兴废使人哀。\n遥怜冷澹黄花节，远对飘零白雁来。\n念尔不堪怀为恶，思余应是首频回。\n诗成寄与憨申诵，句累难教心孔开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日晦日雨忽杂霰","author":"赵蕃","text":"九月霰维集，南方见未曾。\n马寒添瑟缩，我瘦益崚嶒。\n穷相有如此，昔人谁似能。\n树深鸦屡落，滩远雁相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日欲行宜之兄见留赋诗一首","author":"赵蕃","text":"节里留羁客，愁边识此心。\n台高午时暖，斋静晚来阴。\n白发有衰盛，黄花无古今。\n君其赐茱会，我乃见山吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日游马祖岩","author":"赵蕃","text":"环城往往尽高峰，更欲登高底可同。\n马祖自今成故实，龙山翻觉堕虚空。\n当公迭唱青霄上，政我孤吟返照中。\n要是不孤吹帽节，孰云真隔马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月一日晨起风物凄然不胜怀远之思作五首寄和父憨申并烦转致湖池二州也 其三","author":"赵蕃","text":"秋气故悲哉，连阴况不开。\n黄花九日近，白发数茎催。\n山际擎新塔，江边峙旧台。\n谩看云日暮，安得雁同来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月一日晨起风物凄然不胜怀远之思作五首寄和父憨申并烦转致湖池二州也 其二","author":"赵蕃","text":"节佳重九近，风急授衣初。\n茱菊年龄迈，枫柽日夜疏。\n欲题怀远句，频展寄来书。\n憨子能思我，申儿更忆渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月一日晨起风物凄然不胜怀远之思作五首寄和父憨申并烦转致湖池二州也 其五","author":"赵蕃","text":"秋浦新为别，秋风阙寄书。\n虽然声问阔，未觉梦魂疏。\n杜牧登临后，宛陵吟咏馀。\n三冬如有暇，五字不妨渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月一日晨起风物凄然不胜怀远之思作五首寄和父憨申并烦转致湖池二州也 其一","author":"赵蕃","text":"作别已半百，得书无二三。\n飘零各天外，摇落共江南。\n此去仍加远，相思转不堪。\n怀哉对床约，老矣折腰惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月一日晨起风物凄然不胜怀远之思作五首寄和父憨申并烦转致湖池二州也 其四","author":"赵蕃","text":"姨母比苦胫，涉秋今若何。\n音书君定密，离苦我何多。\n凫舄思文瑞，灯窗想骥和。\n何能俱款集，未厌数经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月二十七日题桂溪铺","author":"赵蕃","text":"昨日方摇扇，今朝可拥裘。\n顿能惊北客，方觉是南州。\n岁傥不逢闰，时今宁复秋。\n无庸叹疏漏，聊得避飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月二日发舟快阁下","author":"赵蕃","text":"开船风打头，举棹水分流。\n到处皆成客，今年未识秋。\n意哀吟蟋蟀，声苦乱飕飗。\n拊枕仍推枕，谁知梦觉优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十一夜雨中读吴梦与诗书以示之","author":"赵蕃","text":"疾风吹雨过江干，老屋阙床无处乾。\n切切冷蛩深撼壁，累累饥鼠下窥箪。\n枕衾屡抚眠难著，灯火重呼诗细看。\n谩说为官犹我似，念君怀抱若何宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十三日雪","author":"赵蕃","text":"稍稍云初集，泠泠风未停。\n粗能成点缀，还是学飘零。\n径路高低滑，炊烟远近青。\n篮舆所经历，诗语费平亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月十六日文兴折赠绿萼梅数枝花多而甚香非寻常梅花比也","author":"赵蕃","text":"旧闻良月似春时，真有梅花如许枝。\n绿萼深宜翠羽宿，静香独许蜜蜂知。\n木犀莫道开能再，庭菊无嗟晚乃移。\n不是南方地偏暖，宠光潜已落天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月五日具草酌同彦博审知成父集于普宁山半之亭作诗二首 其二","author":"赵蕃","text":"平生羞狗监，何啻失羊斟。\n与子风期尚，相要林壑深。\n分甘驹在谷，宁事鹤鸣阴。\n此日胡为乐，诗成改又吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月五日具草酌同彦博审知成父集于普宁山半之亭作诗二首 其一","author":"赵蕃","text":"探支重九日，试手菊花斟。\n论置人繁寡，觞行自浅深。\n风能度林杪，月亦吐山阴。\n四听虫仍起，中还著我吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月廿一日雪书呈进之","author":"赵蕃","text":"一夜悲风晓辄收，布衾如铁强扶头。\n乍惊皎皎明窗纸，稍见疏疏集瓦沟。\n失怪竞闻村巷犬，乱行难觅远汀鸥。\n欣然欲作临流看，却恨凛乎难久留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十一日晚呈全真沅陵师契","author":"赵蕃","text":"酒味虽云薄，谈端却甚长。\n过从未能数，咫尺每相望。\n几念乘羸出，还嫌触热妨。\n檐昏书掩卷，月晚坐移床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十一日湖中","author":"赵蕃","text":"岁晚仍湖路，客中还病身。\n似闻今大熟，那故独长贫。\n方朔一囊栗，季鹰千里莼。\n扁舟固高蹈，金马亦沉沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日同临湘尉曹吕益卿登岳阳楼 其二","author":"赵蕃","text":"草没重湖路，帆孤一叶舟。\n飘风来复断，冻雨落还收。\n游目穷天末，题诗欠笔头。\n登临有如此，好在岳阳楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日同临湘尉曹吕益卿登岳阳楼 其一","author":"赵蕃","text":"地已兼旬住，楼孤百尺登。\n谁与同我适，政尔待君曾。\n韩杜愁来读，西南乐得朋。\n仲春新雨霁，山远水波兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日雪二十九日未已赋诗凡五首 其五","author":"赵蕃","text":"夜久寂无听，晓来微有声。\n鸡鸣疑远墅，鼓动忽孤城。\n异县留妻子，殊方老弟兄。\n怀哉一斗粟，于汝岂无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日雪二十九日未已赋诗凡五首 其四","author":"赵蕃","text":"户户薪充纩，家家炉作床。\n悬知火明暗，是系体炎凉。\n为俗陋至此，斯民真可伤。\n诏条先劝课，王政本耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日雪二十九日未已赋诗凡五首 其三","author":"赵蕃","text":"旧褐犹堪著，晨炊不待营。\n江矶有渔者，山径亦樵行。\n尔勿资閒咏，渠应甚苦生。\n还家对妻子，半菽与藜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日雪二十九日未已赋诗凡五首 其二","author":"赵蕃","text":"腊里逢三白，诗中得数书。\n书生真有癖，习气果难除。\n更上高楼望，聊将远目舒。\n天灾如可弭，冻死未忧余。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十八日雪二十九日未已赋诗凡五首 其一","author":"赵蕃","text":"霰集瓦跳鸣，风横窗竹声。\n阴来由有渐，落地势难平。\n龙具愁终夜，鹑衣起迟明。\n儿时故狂甚，老境只寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十三日使风","author":"赵蕃","text":"江行已属北风权，此去宁忧上水船。\n卧听招呼帆转脚，起看飞溅水平舷。\n鸥乘逸气沿仍溯，雁怯惊吹断复连。\n玄妙未穷天籁说，雄豪诗读快哉篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十五日呈明叔","author":"赵蕃","text":"七十且强半，骎骎数日间。\n不成悲白发，犹说爱青山。\n五斗虽为累，千篇政不悭。\n与君同甲子，此事合相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十日同官相约过水乡蕃雨中先至偶成二诗 其一","author":"赵蕃","text":"约客客来至，寻诗诗偶生。\n秋如惊柳色，雨未改荷声。\n渺渺江湖趣，悠悠鸥鹭盟。\n意虽能浩荡，笔乃欠纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十日同官相约过水乡蕃雨中先至偶成二诗 其二","author":"赵蕃","text":"此雨不易得，有秋端可期。\n微官如饱饭，馀事亦穷诗。\n鸡远村场听，鸠深客路疑。\n是身真已老，何事此长羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十日夜宿小杨","author":"赵蕃","text":"侬问何村泊，人询底处船。\n凶年无善俗，永夜少安眠。\n仅有多年被，犹无旧物毡。\n未应能我累，瑟缩自成然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二十四日一日作十诗季承同之既罢复书四十字并呈季承","author":"赵蕃","text":"米尽不忧饥，行行且赋诗。\n相看一大笑，从谓两真痴。\n未用追元白，聊须效陆皮。\n流传君不愧，附益我奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十九日同两都监沅陵令尉饯叙浦簿公子兴福 其一","author":"赵蕃","text":"随处野花发，所须村酒沽。\n江平初出岸，山好渐成图。\n从此经行地，能留物色无。\n少陵那老蜀，张翰政思吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十九日同两都监沅陵令尉饯叙浦簿公子兴福 其二","author":"赵蕃","text":"慨我复成留，辞君重作愁。\n春风渺归雁，野水迥浮鸥。\n已别还来见，因行亦当游。\n同僚二三子，杯酒互相酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十二日雨寒","author":"赵蕃","text":"重设匡炉火，还披故絮裘。\n春风今已半，地域况南头。\n次第农耕动，侵寻花事休。\n浮生有过鸟，归计欠沉牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十日雨","author":"赵蕃","text":"喜雪仍喜雨，相须旬日期。\n天民终自恤，岁事可前知。\n起我泛舟役，思渠荷笠诗。\n嗔人问米价，王掾果真痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十日喜雨呈李纯教授去非尉曹","author":"赵蕃","text":"沧浪一夜起鸣雷，雨阵因之续续来。\n所病农家成久旱，未论花事有新开。\n书生狂妄常忧国，圣代飘零岂弃才。\n儒馆尉曹俱国士，好为诗赋咏康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月十四日发潮后作","author":"赵蕃","text":"归路今无几，春风半已经。\n潮回知岸远，雪积见山青。\n问欲从渔父，明当访客星。\n未须伤偪仄，那敢怨飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月六日雨中简诸君","author":"赵蕃","text":"人言好雨知时节，红白纷纷柰若何。\n田父相呼稻当种，园官语我菜添科。\n日长燕子自无事，渚涨桃花思汎波。\n寄谢同参二三老，未妨乘间数经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月初二日二首 其二","author":"赵蕃","text":"所见与所闻，豪华同贱贫。\n寒时端有独，温处乃能均。\n幸止药饵费，深知天地仁。\n流行代斯有，不必嫁诸邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月初二日二首 其一","author":"赵蕃","text":"去岁不作疟，今年乃病温。\n初无一床卧，但有小舟蹲。\n未怕黄州鬼，唯忧楚国魂。\n明朝强撑拄，摇兀到吴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月初十日自荻浦绝湖三首 其三","author":"赵蕃","text":"倚赖尊中酒，枝梧卷里诗。\n贫嗟居不易，境对语成危。\n往日行犹记，冲风去不疑。\n舟师笑相谓，未有若人痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月初十日自荻浦绝湖三首 其二","author":"赵蕃","text":"远浪已摇目，疾风仍打头。\n翩翻仰飞鸟，矫捷羡轻鸥。\n湖有万顷白，舟才一叶浮。\n意行从泛泛，吾道本悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]