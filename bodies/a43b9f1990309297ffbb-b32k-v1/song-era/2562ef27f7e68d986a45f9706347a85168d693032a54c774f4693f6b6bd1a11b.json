[{"title":"次希道弟韵寄竹院孚上人","author":"胡仲弓","text":"闭门商古道，细雨湿青春。\n属和卯君句，殷勤巳上人。\n蒲团安地位，秀语发天真。\n旧日曾同社，吾今愧许询。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次周懒窠韵","author":"胡仲弓","text":"风月无边际，吟身乐未央。\n江湖三寸舌，文字九回肠。\n竹伴孤高节，梅熏暗澹香。\n笑他蒲柳质，耐得几番霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次法石寺即事韵","author":"胡仲弓","text":"近郊来往熟，驯犬向人迎。\n半是吟将老，何时隐得成。\n月明山景合，潮落海痕生。\n归路霜钟外，微闻三数声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次洪阳岩太卿韵为方蒙仲书监赋西清风月","author":"胡仲弓","text":"莫听豳人歌楚茨，鬻书空笑未多赀。\n治中尽说裴怀古，馆下曾宗韩退之。\n西望前山谁拄笏，南来别驾例能诗。\n昔贤自有清标在，添在桐城一段奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵同叔春雨中韵","author":"胡仲弓","text":"焚香清坐话襟期，绝胜孤篷共载时。\n晓雨旋添山蕨菜，春风又上海棠枝。\n蝶随痴梦飞丹阙，莺带吟声绕墨池。\n小待阴晴何日定，不成学圃事樊迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次烟浦即事韵","author":"胡仲弓","text":"吟帆归路远，花雨落纷纷。\n鹭过山加点，鸥飞水破纹。\n淡烟依古树，残照下空坟。\n未见巫阳面，高塘韵漫分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次郭吉甫梅仙之官广右","author":"胡仲弓","text":"路入天南更向西，春风匹马赴瓜期。\n折将官柳送行客，归及山梅结果时。\n池上凤凰身未到，滩头鸂鶒事先知。\n徐君曾下陈蕃榻，况是林宗早见推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵山居","author":"胡仲弓","text":"夕阳漏影射疏林，三两人家桑柘阴。\n鹘过拶开归鸟路，钟敲撞碎野猿心。\n常因境胜甘忘食，不为家贫辄废吟。\n说与门前樵牧者，日间过此可相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵抱拙即事","author":"胡仲弓","text":"一啸立东皋，轻寒侵二毛。\n晓光浮野草，春色染夭桃。\n有水池添满，无云山更高。\n清源何日约，扫石共歌骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵送黄耑玉归莆","author":"胡仲弓","text":"主人情分熟，客兴未应阑。\n从古知心少，只今行路难。\n吟身霜竹瘦，归梦早梅寒。\n若见潜夫说，官清贫亦安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵琛庭即事","author":"胡仲弓","text":"吏尘飞不到，官况尽凄凉。\n实货归周府，虚名属晋堂。\n日移槐影转，风细荔花香。\n若问公私事，閒蛙话最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答方元吉","author":"胡仲弓","text":"新知如旧识，话久觉情真。\n云出壶山早，风行晋水春。\n家贫因过客，世变为诗人。\n曾点龙门额，烦君再问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答王东墅","author":"胡仲弓","text":"元龙湖海分栖迟，懒把琴心累子期。\n不是三生曾有旧，如何一见便论诗。\n春行谷外莺求友，月在吟边鹊绕枝。\n甚欲买舟寻隐处，悔将名姓与人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答颐斋","author":"胡仲弓","text":"雀罗门外设，尘远市廛居。\n抱膝吟梁父，摩声赋子虚。\n苔钱何用铸，草带莫教锄。\n世事难开口，休投北阙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次懒窠见寄韵","author":"胡仲弓","text":"园丁无择种，萧艾杂椒兰。\n世俗欠真识，达人当大观。\n无弦徒自赏，有铗莫空弹。\n独倚西风立，推敲一字难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次麓湖韵送王用和归省侍","author":"胡仲弓","text":"因访诗宗特特来，子猷兴尽转船回。\n故园松竹元无恙，新本芝兰更欠栽。\n杰句多于贫后出，好怀长是醉时开。\n白云只在青山外，归去堂前学老莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤惠院以五言定交用韵以谢","author":"胡仲弓","text":"阿邕才识面，转盼便回春。\n药笼还君富，诗囊笑我贫。\n学遵东鲁训，句逼晚唐人。\n五字论交意，吟边忆李频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯花","author":"胡仲弓","text":"根头馀寸草，结作数层红。\n预卜门庭喜，非关造化功。\n开时常入夜，落后不因风。\n误被灯蛾扑，从知色是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹夫人","author":"胡仲弓","text":"虚心陪燕寝，不受虢秦封。\n惟有冰霜节，全无云雨踪。\n李娥书旧恨，湘女敛愁容。\n却是专房宠，无人妒阿侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约枯崖话","author":"胡仲弓","text":"雨中曾折角，策蹇访僧寮。\n待约蕉庵住，莫从莲社招。\n清风资话柄，流水走诗瓢。\n行道知何日，同携过石桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自笑","author":"胡仲弓","text":"自笑谋生拙，多应涉世疏。\n为贫趋斗禄，因病试方书。\n榕叶寒侵户，梅花深结庐。\n焚香坐清夜，吟到晓钟初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中归兴","author":"胡仲弓","text":"舟胶回短棹，岸曲抱溪斜。\n香篆迷烟草，灯光闪浪花。\n归心随舴艋，遗响托琵琶。\n明月如留客，犹笼浅渡沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中即事","author":"胡仲弓","text":"携家驱宦牒，短棹泛桃源。\n人语联篷屋，渔歌隔水村。\n云归千嶂合，雨过一江浑。\n为爱招提近，缆船杨柳根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中夜闻弹筝","author":"胡仲弓","text":"舣舟寻近岸，馀兴月明中。\n鼓瑟人何在，弹筝意略同。\n声和随去浪，调古动悲风。\n银甲无由见，清音出绣栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西塔","author":"胡仲弓","text":"杖策来寻塔庙仙，半程便到碧霄边。\n三千世界浮尘外，百二山河在眼前。\n谁把孤标长插地，只消一柱可擎天。\n夜阑籁静凭栏听，隐隐星河人扣舷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖怀古","author":"胡仲弓","text":"水拍平堤欲蘸天，濯缨人在小桥边。\n古今尘世知多少，沧海桑田几变迁。\n驼巘勋名无竹写，孤山衣钵有梅传。\n谁能撰取西湖传，持到玉皇香案前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西溪即事","author":"胡仲弓","text":"柴门斜对水，一径锁松萝。\n积雨溪流急，閒云山占多。\n村庄留客饭，樵父教儿歌。\n听得田间语，安排收晚禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观江郎石","author":"胡仲弓","text":"江郎何日化，千古镇长青。\n乍见人疑怪，多应地有灵。\n世间无此石，天上应何星。\n海外蓬莱岛，犹疑在杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观蚁","author":"胡仲弓","text":"饱知膻可慕，来往斗相迎。\n忙似人行役，多于雁出征。\n数行缘壁去，一半上阶行。\n何处堪投宿，相逢细问程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观海口占","author":"胡仲弓","text":"扬帆饱风腹，望眼无东西。\n天围沧海阔，日射昆崙低。\n鱼鳖夜深泣，鸿鹄空中迷。\n风涛且莫作，心撼神龙栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观棋闻近事有感","author":"胡仲弓","text":"盘中无活路，败局几番新。\n好著输前辈，危机逊后人。\n静边閒袖手，穷处巧翻身。\n黑白无分别，归欤当自陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访枯崖不遇","author":"胡仲弓","text":"踏破门前苔藓斑，寻曦不值只空还。\n行云过处青山湿，野水明边白鸟閒。\n扪虱有人谈古道，挥蝇无路透禅关。\n杖藜独背西风去，偶见苍官亦厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过山庵","author":"胡仲弓","text":"天地一间屋，心安到处家。\n淡中尝世味，吟里足生涯。\n煨芋频添炭，烹泉旋品茶。\n空山无纸帐，梦不到梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过岭作","author":"胡仲弓","text":"崇冈峻岭欲凌霄，鸟道行边去路遥。\n客里恰逢三伏暑，程头方到九秋桥。\n不堪流水鸣呜咽，赖有诗篇慰寂寥。\n但得此身强健在，任渠皤鬓自萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过梨岭作","author":"胡仲弓","text":"山头日正焚，山脚雨纷纷。\n石罅疑无地，树身常出云。\n神灵香不断，天近路平分。\n星斗迫人句，晚唐诗亦云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问陈禹锡太博病","author":"胡仲弓","text":"脉虚非别症，身坐蠹鱼痴。\n造物不青眼，江湖此白眉。\n近年书不至，远宦梦相随。\n遣病无他嘱，加餐诵杜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严子陵钓台","author":"胡仲弓","text":"聘币凡三到水涯，东都莫是欠人才。\n当时若使无新室，此地安知有钓台。\n鱼水相忘身外乐，羊裘曾卧禁中来。\n桐江一派清如昨，千古高风挽不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泠风阁","author":"胡仲弓","text":"高阁凌云四望赊，剑城横案俯千家。\n乘风列子留行馆，飞舄王乔有别衙。\n天女下游箫引凤，仙人来宴枣如瓜。\n溪山胜绝非尘世，帆过真疑海上槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听宫入琴","author":"胡仲弓","text":"群哇方杂奏，忽听数声琴。\n天地有清气，君王知正音。\n悲风生指玉，明月照徽金。\n曾抚昭君怨，宫人泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙觉山用老溪宝叶二僧韵 其二","author":"胡仲弓","text":"庵居天半壁，古道拟山阴。\n风劲松须落，石高泉眼深。\n钟声清嶂合，幡脚翠岚侵。\n二妙堪名世，诗人曾赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙觉山用老溪宝叶二僧韵 其一","author":"胡仲弓","text":"登山无杖策，元不事依凭。\n斜照穿林影，行云碍石棱。\n鸟啼悲宿草，猿饮挂枯藤。\n曾著高僧住，何人为续灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿赵默庵","author":"胡仲弓","text":"九十风光老益强，一生长得对东皇。\n结成梅子味初实，开尽荼蘼晚更香。\n尧历不随春脚去，周天从此日头长。\n年年常记今时节，花满朝冠酒满觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张巡庙","author":"胡仲弓","text":"说著睢阳胆已倾，单师曾此控孤城。\n一身肯作偷生计，千古长留不死名。\n庙飨毋忘艰食日，庭松犹学战时声。\n祠前碑记无寻处，赖有唐书为发明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀李希膺","author":"胡仲弓","text":"病居身懒出，可是故人疏。\n春后无佳句，天边有近书。\n改弦知不远，制锦定何如。\n未刬门前草，难通长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀悟书","author":"胡仲弓","text":"秋雁欲离群，怀人几夜分。\n吟当半窗月，坐断两山云。\n幡影无心动，钟声出定闻。\n林间谋隐者，修洁莫如君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀钱塘旧居","author":"胡仲弓","text":"钱塘漂泊久，别后梦连宵。\n忽听滩头水，犹疑江上潮。\n暗尘侵竹简，夜雨洗芭蕉。\n料得苏堤路，西风犯柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旱湖","author":"胡仲弓","text":"老天动是一年晴，怪底游人不出城。\n湖上几时无好况，堤边近日少吟声。\n草深盍放牛羊牧，水涸难寻鸥鹭盟。\n但得孤山梅不死，其他风物弗关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛舟分韵得横字","author":"胡仲弓","text":"舣舟迷近远，鸥鹭许同盟。\n潮落沙仍涨，风晴浪不惊。\n一川平野秀，半岭断云横。\n后约何时再，吟篷卧月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛湖晚归式之有诗见寄因次其韵","author":"胡仲弓","text":"晚趁归舟醉复醒，一湖烟水淡冥冥。\n自怜吟鬓新添白，强学游人去踏青。\n足迹未经龙井寺，梦魂常绕冷泉亭。\n何时携手同登览，花满乌纱酒满瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近事","author":"胡仲弓","text":"近事山中总不知，心清常是太平时。\n勿于贫后方求药，才得閒来便赋诗。\n千里白云劳梦想，一天明月负襟期。\n有书堪读梅堪看，绝倒人间富贵痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还翁雪舟吟卷","author":"胡仲弓","text":"世间迂阔者，端的是诗人。\n独坐无生计，相逢尽说贫。\n如君追古作，与我最情亲。\n切莫轻辜负，元龙湖海身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远眺","author":"胡仲弓","text":"袖手独凭栏，乾坤杯酒间。\n此心常坦易，何地不宽閒。\n木落山头秃，冰坚水面顽。\n梅花可人意，一见一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈氏溪亭次韵","author":"胡仲弓","text":"溪亭镇日著吟身，不浣衣中一点尘。\n水比世间机巧者，山如前辈典刑人。\n唤回魂梦敲茶臼，费尽工夫整钓纶。\n时有野僧排闼至，炷香清坐话头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侠客","author":"胡仲弓","text":"仗剑一长笑，出门游四方。\n雄心吞宇宙，侠骨耐风霜。\n豺虎须擒攫，狐狸敢颉颃。\n大梁二壮士，千古姓名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卧听","author":"胡仲弓","text":"卧听芭蕉捲雨声，熟梅天气半阴晴。\n几年不作云山梦，特地来寻泉石盟。\n竹杖芒鞋方得意，桃笙葵扇又关情。\n清和时节如寒食，昨日街头人卖饧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和云心除夕韵","author":"胡仲弓","text":"岁除明日是，心事落梅边。\n节物催双鬓，情怀欠少年。\n桃符依帖写，竹爆应声圆。\n椒颂无人献，酴酥亦自煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和止泓姜秦祠韵","author":"胡仲弓","text":"九日山头两径深，不同出处却同心。\n唤回浮世梦中梦，来向先生吟处吟。\n别驾堂空遗影在，隐君亭破野藤侵。\n古今陈迹休深问，且把寒泉当酒斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丘君就见寄","author":"胡仲弓","text":"曾坐当年阮籍途，功成何敢叹桑榆。\n嚼来世味十分淡，吟得诗肠一半枯。\n向日有书干北阙，只今无梦到西湖。\n访君欲话前头事，怕被秋风吹病躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其一","author":"胡仲弓","text":"冬深差喜病根除，药裹犹亲酒盏疏。\n门对好山纯种竹，园通活水可浇蔬。\n檐牙带湿霜晴后，帘额移阴日出初。\n时有邮筒递诗至，吟馀便拟借牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其二","author":"胡仲弓","text":"几年待漏趣朝班，乞得閒身返故山。\n公论尽归恩怨外，清谈不落是非间。\n屠龙肯信无高手，画虎虽成亦强颜。\n马革裹尸徒自壮，争如投老得生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其九","author":"胡仲弓","text":"宦海风波亦足惊，得閒聊尔慰平生。\n虽无塞上雪堪卧，幸有山中田可耕。\n一老拂衣何太勇，群儿撼树漫相轻。\n绝怜千丈西凉瀑，偏与人间诉不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其三","author":"胡仲弓","text":"出处难为卜筮谋，植鳍无复转岩求。\n清风不度麒麟阁，明月空沈鹦鹉洲。\n采石仅埋吟骨在，新亭犹带泪痕羞。\n书生慷慨谈时事，未必膺门肯见留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其四","author":"胡仲弓","text":"避俗常关白板扉，北山泉石尚堪嬉。\n临流且赋观鱼乐，忧国何消捋虎危。\n自许丹心长恋阙，独怜万户未逢时。\n割鸡为黍寻常事，客至休言子为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其六","author":"胡仲弓","text":"诵读未多才思悭，数编遗丑落人间。\n洪音互杂蛙蝉奏，封事宜投虎豹关。\n杨震有知金忍受，相如未死璧终还。\n且须静守心斋坐，学取箪瓢陋巷颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其七","author":"胡仲弓","text":"累疏殷勤奏榻前，忧时急似救头然。\n功名常是中年立，忠孝当于晚节全。\n投祓归来泉石上，班荆坐向竹梅边。\n乌台无复诗公案，弄月嘲风亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其十","author":"胡仲弓","text":"当日曾弹贡禹冠，悬知出处独今难。\n宁将退翮翔千仞，谁肯模棱持两端。\n风雨笔头犹老健，江湖吟鬓未凋残。\n十篇话破平生事，留与时人作样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘后村杂兴 其五","author":"胡仲弓","text":"迩来笔砚亦相疏，野服焚香读异书。\n筑室不须临孔道，闭门只合造轻车。\n有梅花处犹堪酒，无竹人家不可居。\n涉世直消诫口过，是非荣辱不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]