[{"title":"中春过阳亭","author":"张栻","text":"亭古危临岸，林幽巧近城。\n烟容随雨住，花片著溪清。\n春事已如许，客怀谁与倾。\n亭前两好树，满意欲敷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋与僚佐登江陵郡城观月","author":"张栻","text":"凉意今年早，蟾光七泽多。\n凭栏共怀古，拥袂独高歌。\n风物关山远，功名岁月过。\n一樽聊复尔，于此兴如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"户曹庐陵胡君引年求谢事予视其精力未衰留之踰半载乃今告去不复可挽为诗送别澹庵君之叔父也","author":"张栻","text":"出守嗟何晚，怀归已倦游。\n细看浑矍铄，可是畏伊优。\n幕下倾三语，山中赋四愁。\n平生大小阮，来往足风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王长沙约饮县圃梅花下分韵得梅字","author":"张栻","text":"平生佳绝处，心事付江梅。\n县圃经年见，芳樽薄暮开。\n朗吟空激烈，烧烛且徘徊。\n未逐徵书去，穷冬尚一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长沙郡丞丁君挽词","author":"张栻","text":"廉吏今尤重，朝家诏举频。\n方看千里驾，忽尽百年身。\n职业忧劳甚，游从笑语真。\n空令行路叹，没后见清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用元晦定王台韵","author":"张栻","text":"珍重南山路，驱羸几度来。\n未登乔岳顶，空说妙高台。\n晓雾层层敛，奇峰面面开。\n山间元自乐，泽畔不须哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"由西岭行后洞山路","author":"张栻","text":"西岭更西路，云岚最窈深。\n水流千涧底，树合四时阴。\n幽绝无僧住，闲来有客吟。\n山行三十里，钟磬忽传音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲冬朔日登湘南楼复用正父前韵","author":"张栻","text":"历遍江南处处山，峤南还得倚楼看。\n化工此地无馀巧，爽气穷冬更逼栏。\n官事随时宁解了，书盟平日未应寒。\n相逢自有论文乐，只把空杯未碍欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光弼侄得邑西归赋诗勉之并示光义二首 其二","author":"张栻","text":"得邑宁论小，居官最近民。\n中诚傥无倦，同体会相亲。\n暇日书还读，清源政自新。\n吾兄有遗训，尔辈足持循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光弼侄得邑西归赋诗勉之并示光义二首 其一","author":"张栻","text":"共惟二百载，诗礼一门中。\n冷落吾忧甚，扶持尔辈同。\n传心无异辙，随用不言功。\n外慕知何极，惟应念祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其一","author":"张栻","text":"闭门谢客少过从，独倚修篁傲碧空。\n忽喜千条发琼蕊，纷如万鹤出樊笼。\n与君前日徘徊久，得句悬知惨淡中。\n胸次本无愁可著，何为苦要酒兵攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其二","author":"张栻","text":"夜读韦编起欲从，门前流水落花空。\n春同心事应长在，月当灯光不用笼。\n吊古谁能嗟泽畔，高吟且欲效隆中。\n君诗似玉无瑕玷，岂有他山石可攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和 其三","author":"张栻","text":"市朝车马列云从，君有危楼出半空。\n但觉乾坤增老眼，不妨日月转空笼。\n花开花落关何事，江北江南只此中。\n互出新诗殊未艾，长城尚许短兵攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘胜因自襄阳过予渚宫于其归小诗赠别","author":"张栻","text":"肮脏宁多忤，栖迟久倦游。\n折肱谙世味，袖手惜良筹。\n日月隆中晚，风烟岘首愁。\n登临应慷慨，还解寄诗不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕善化秩满而归两诗赠行 其一","author":"张栻","text":"令尹三年政，湘民去息思。\n艰难救灾歉，忧瘁见云为。\n荐牍今交上，夷途去不疑。\n正须频顾省，御者可无辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕善化秩满而归两诗赠行 其二","author":"张栻","text":"伯氏相从旧，归来意若何。\n从渠笑方拙，还我自吟哦。\n圣有诗书在，人多岁月过。\n德门好兄弟，夜雨细研磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多景楼","author":"张栻","text":"畴昔南徐地，登临北固楼。\n平原迷故国，沧海接江流。\n木落烟莎晚，城孤鼓角秋。\n寄言鸥鹭侣，吾已具扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安国置酒敬简堂分韵得柳暗六春字 其一","author":"张栻","text":"桴鼓息荒村，袯襫盛南亩。\n永日省文书，呼客共樽酒。\n主人出尘姿，宛是灵和柳。\n行归帝所游，此地岂淹久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋湖亭","author":"张栻","text":"泽国今年秋气蚤，湖亭清晚独裴徊。\n翩翻荷盖随风舞，萧瑟松声带雨来。\n静处岂云身计得，吟边但觉岁华催。\n悠悠远思凭谁写，多病新来罢酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次陈择之游湖韵","author":"张栻","text":"落日游鱼上，青林白鸟过。\n稻香来隔岸，岩影占清波。\n招隐何年赋，寻幽此地多。\n晚凉容纵棹，听我采菱歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次赵漕赠王昭州韵","author":"张栻","text":"煌煌金节按江城，驿路梅花正小春。\n闻说争迎来满道，定将何术慰斯民。\n憩棠异日誇南国，怀橘归时拜寿亲。\n流泽会看均一路，要令治象复熙淳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤总管邢监庙约游城东酒间求诗为赋此","author":"张栻","text":"春事已如许，客愁空自多。\n梅花成莫逆，樽酒付亡何。\n楚楚邢郎子，眈眈老伏波。\n定应容我醉，耳热更高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自方广过高台","author":"张栻","text":"两寺清闻磬，群峰石作城。\n风生云影乱，猿啸月华明。\n香火远公社，江湖鸥鸟盟。\n是中俱不著，俯仰见平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长桥","author":"张栻","text":"西风吹短发，复此渡长桥。\n木落波空阔，亭孤影动摇。\n徘徊念今昔，领略到渔樵。\n傥有山中隐，凭谁为一招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过湘潭刘信叔旧居有感","author":"张栻","text":"北渚留行客，东陵忆旧侯。\n池莲半枯折，风叶正飕飗。\n事业留千载，英雄去一丘。\n平生许国志，岁晚讵悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿定叟弟","author":"张栻","text":"为邦和气满乡闾，袖手还家乐有馀。\n案上简编元好在，闲中日月更宽舒。\n功名且要身长健，寻尺何求计不疏。\n好泛菊英斟寿酒，扁舟吾欲赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"帐干周君桂林相从之旧己亥莫春出岭迂道相过临别求予言姑赋此","author":"张栻","text":"江北逢新雨，湘南忆旧游。\n能来慰岑寂，恨不小迟留。\n日月徒催老，巧名浪自愁。\n惟应编简乐，在己可深求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元晦十六日下山之韵","author":"张栻","text":"归袂随云起，篮舆趁雪明。\n山僧苦留客，世故却关情。\n小倚枯藤杖，聊听绝涧声。\n如何山下客，一笑已来迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元晦后洞山口晚赋","author":"张栻","text":"石裂长藤瘦，山围野路深。\n寒溪千古思，乔木四时阴。\n更得寻幽侣，何妨拥鼻吟。\n笑看云出岫，谁是此无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元晦择之有诗见怀","author":"张栻","text":"作别又如许，何当置我旁。\n卷舒书在手，展转月侵床。\n合志师千载，相思谩一方。\n临风三叹息，此意渺难量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和元晦赠上封长老","author":"张栻","text":"上方元自好，一榻有馀清。\n祇趁晨钟起，宁闻山鸟声。\n高僧足幽事，野客富诗情。\n试问峰头景，今朝作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人梦游西山","author":"张栻","text":"故人畴昔隐西峰，野寺幽房一径通。\n无复老僧谈旧事，空馀修竹满清风。\n梦中寻胜忘南北，句里论心岂异同。\n我欲壁间题唱和，他年留得诧南公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和正父游榕溪韵","author":"张栻","text":"隔岸高低露碧山，眼明便作故园看。\n直从榕影度轻舫，更傍溪光抚曲栏。\n鸿雁来希空怅望，梅花开早未初寒。\n喜君万里同情话，明月清风足佐欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和石通判酌白鹤泉","author":"张栻","text":"谈天终日口澜翻，来乞清甘醒舌根。\n满座松声闻金石，微澜鹤影漾瑶琨。\n淡中知味谁三咽，妙处相期岂一樽。\n有本自应来不竭，滥觞端可验龙门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宇文正甫探梅","author":"张栻","text":"天与孤清迥莫邻，祇应空谷伴幽人。\n千林扫迹愁无那，一点横梢眼便亲。\n顾影莫惊身易老，哦诗尚觉句能新。\n几多生意冰霜里，说与夭桃自在春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张晋彦游岳麓","author":"张栻","text":"斋舫凌烟浦，云屏入画图。\n日烘花炫昼，风定水明湖。\n布谷催春种，提壶劝客沽。\n湘中无限景，赋咏继三都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨教授 其二","author":"张栻","text":"客少从蒿长，居深懒户开。\n孤城岁云莫，瘦马子能来。\n长策怜葵向，新诗更雨催。\n相看前日事，此首忍重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨教授 其一","author":"张栻","text":"道在无今昔，才难有屈伸。\n青编知了意，白眼付时人。\n镜里颜容旧，胸中事业新。\n绝叹知味鲜，渠自说甘辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和定叟送行韵","author":"张栻","text":"旧别情何限，重逢意豁然。\n相看疑似梦，款语不成眠。\n但欲灯窗共，其如事役牵。\n固应回首处，祇在集云前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之看雪","author":"张栻","text":"岳背三冬雪，真同不夜城。\n野云何晃荡，涧水助空明。\n行橐多新句，青山有旧盟。\n堂堂身世事，渠谩说三生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和择之韵","author":"张栻","text":"旧说峰头寺，真成杖屦来。\n却寻泥路滑，更喜野云堆。\n寒积三冬雪，阳生九地雷。\n城中几亲友，为说看山回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和查仲文雪中即席所赋","author":"张栻","text":"方帽冲泥有客来，九衢俗眼莫惊猜。\n一樽相对十年外，两脚新从万里回。\n壮志未随衰鬓改，孤怀良为故人开。\n雪中细放梅花发，不用匆匆羯鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄仲秉喜雨","author":"张栻","text":"雨后清泉绕舍流，悬知耘耜遍南州。\n占相岁事端无恙，劳苦农人亦少休。\n好句收功经百鍊，弥旬不见便三秋。\n闲来只愿长丰稔，江海白鸥盟共求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄仲秉喜雨","author":"张栻","text":"雨凉窗户好，佳木正阴阴。\n畎亩忧时念，乾坤济物心。\n引泉聊自照，移竹更亲临。\n尚想皇华使，风前拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄漕雪中将至长沙","author":"张栻","text":"吾道元如砥，人间谩畏途。\n未容舟溯峡，且泛雪平湖。\n子孝宁投杼，天回看脱弧。\n不应从我懒，欲老豆麻区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定叟弟生辰","author":"张栻","text":"清秋记弧矢，举酒颂年长。\n别去今踰岁，情亲祇对床。\n韦编闲玩味，幕府小徜徉。\n刮目它时看，光晖映棣棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申过青草湖","author":"张栻","text":"已越重湖险，张帆胜顺流。\n乱云藏野寺，横网闹渔舟。\n物色湖南好，风霜岁晚谋。\n未知荒歉后，得似向来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"若海运使移节广东赋诗赠别予每过若海诸郎诵书于旁琅琅可喜为之重赋 其一","author":"张栻","text":"行止非人料，驱驰未席温。\n传闻选肤使，端为慰黎元。\n瘴岭农耕少，山城海气昏。\n唯勤凋瘵虑，此外更何言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗送陈仲思参佐广右幕府","author":"张栻","text":"旧说桂林好，君今幕府游。\n江山资暇日，梅雪类吾州。\n煮海何多说，安边更预谋。\n政应勤婉画，不用赋离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山","author":"张栻","text":"万顷洪涛里，巍然阅古今。\n云烟三岛接，花木四时深。\n乱石维舟住，西风倚槛吟。\n朝宗知不断，凄切此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后同周允升登雪观","author":"张栻","text":"一雨端能减百忧，肩舆径上最高楼。\n山容净洗无穷碧，江水新添自在流。\n已觉春随花片老，不应身似贾胡留。\n烟蓑风笠南山下，正好归欤看麦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太子詹事王公挽诗二首 其二","author":"张栻","text":"睿主龙飞日，如公旧学臣。\n忠言关国计，清节映廷绅。\n岁月身多外，江湖泽在民。\n当年遗直叹，千古更如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太子詹事王公挽诗二首 其一","author":"张栻","text":"大节元无玷，中心本不欺。\n排奸力扛鼎，忧国鬓成丝。\n方喜三旌召，俄兴一鉴悲。\n西风吹泪眼，夫岂哭吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某以四十字送详刑使君","author":"张栻","text":"拙守荆江上，无人共往还。\n能来慰牢落，话旧几间关。\n冬壑龙蛇蛰，风林虎豹斑。\n相期涵养力，且到古人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"某辱归父丈惠贶新诗谨次韵末章为别","author":"张栻","text":"淮海相从几岁年，南州雁不到西川。\n重逢影落烟沙外，却喜身如金石坚。\n莫叹武城资莞尔，且看平楚正苍然。\n剸繁自是君馀事，毫发难逃止水渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡丈广仲与范伯崇自岳市来同登绝顶举酒极谈得闻比日讲论之乐","author":"张栻","text":"久憩珠林寺，高轩自远来。\n携朋上乔岳，载酒到琼台。\n论道吟心乐，吟诗笑眼开。\n遥观松柏树，风韵有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追饯马宪","author":"张栻","text":"肤使行原隰，清风伴往还。\n诗情浑漫兴，雪意正相关。\n许国心何壮，忧民鬓易斑。\n留连三日语，解后十年间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送少隐兄赴兴元幕 其一","author":"张栻","text":"出手宁嫌晚，论心本不欺。\n五年江左客，万里故园思。\n肯枉洞庭棹，来寻棠棣诗。\n固知名义重，岂但慰朝饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送少隐兄赴兴元幕 其二","author":"张栻","text":"边塞连关陇，貔貅罢战征。\n幕中须预计，堂上乃奇兵。\n汉水追前策，秦原忆旧耕。\n书生亦多事，慷慨试经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外弟宇文挺臣二首 其二","author":"张栻","text":"漠漠漓江上，匆匆送客情。\n平原宵雨湿，绝壁野云横。\n世路多新辙，韦编有旧盟。\n中流屹砥柱，过浪岂能倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外弟宇文挺臣二首 其一","author":"张栻","text":"合族情尤重，论交意复深。\n还为万里别，未尽几年心。\n佳处应相忆，书来傥嗣音。\n及时须努力，莫待鬓华侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送甘可大","author":"张栻","text":"子陵溪水千年绿，犹忆登临日暮时。\n子去定能寻胜概，书来当复慰相思。\n简编有味宁论晚，得失从渠莫自疑。\n也学迂疏教似舅，不应空赋渭阳诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宇文正甫","author":"张栻","text":"重来能复几旬馀，临水登山又送渠。\n夜雨已知农事好，春寒未放小桃舒。\n眼前佳处应难尽，别后书来讵可疏。\n我亦相将归旧隐，杖藜时复访楼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送但能之守浔州","author":"张栻","text":"循吏古犹少，岭民今未苏。\n丁宁烦诏旨，推择得吾徒。\n根本谁深念，诗书计不迂。\n惟应敦此意，岂但应时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李崧老归闽二首 其二","author":"张栻","text":"公事妨开卷，遐征念索居。\n能来数月款，端为百忧纾。\n师友洛川上，人才元祐初。\n归来有新益，不惜几行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李崧老归闽二首 其一","author":"张栻","text":"历数勋贤后，如君到眼希。\n胸中蕴金石，笔下出珠玑。\n倾盖嗟何晚，临流又送归。\n他年傥相忆，寻我钓鱼矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李新州","author":"张栻","text":"清绝湘南地，乡间见老成。\n蔽棠方有望，折柳却关情。\n侧听舆人诵，还新月旦评。\n相望幸邻壤，犹得借馀明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]