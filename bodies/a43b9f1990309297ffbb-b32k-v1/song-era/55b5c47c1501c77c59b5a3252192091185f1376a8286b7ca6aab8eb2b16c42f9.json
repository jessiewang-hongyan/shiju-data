[{"title":"八月十四夜月用旧作韵呈诸友","author":"魏了翁","text":"鬓发成宣面欲黎，逢人耻诵故年诗。\n才看震象应知满，未睹乾爻已识亏。\n止处光明浑在里，偶然显晦谩随时。\n风光流转浑閒事，要与知心结久期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳日约同僚过蟆颐晚视新开横江堰","author":"魏了翁","text":"朏魄双交气候新，古今为乐属兹辰。\n兰堂坐上皆豪逸，韦曲水边多丽人。\n顾我未能真免俗，邀宾聊复共行春。\n却因游豫思民事，检校城东白虎津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与刘左史同别杨少卿于南郊舟中用宋兵部韵","author":"魏了翁","text":"玉龙老子访仙鹤，冲佑散人归瑞乌。\n俗事祇今长刺促，可人自昔费招呼。\n忧时恨不百子骏，背我宁堪二大夫。\n舣纁黄昏不成别，画成江上送行图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用宋兵部韵送刘左史","author":"魏了翁","text":"絷维不住谷中驹，爱恋徒占屋上乌。\n开汉楼前迎剑骑，临津门外罢传呼。\n宅家未忍忘贤传，衡宇胡为戒仆夫。\n阁束衣冠聊一笑，不为耐辱司空图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己未唱第后谢恩诗","author":"魏了翁","text":"圣皇学问富春秋，当宁宵衣渴壮猷。\n鹄立银袍天北阙，龙飞金榜殿西头。\n彤池缪对三千字，黄甲俄输一二筹。\n初学粗知存大体，纷更要洗洛阳羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马少卿挽诗","author":"魏了翁","text":"重葩殗叶露华浓，不忝家声得似公。\n言行端和今世楷，貌心醇质古人风。\n直将趋走二三节，换取宽閒五百弓。\n如此名卿缘手尽，同时更送竹溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹棱杨子金挽诗","author":"魏了翁","text":"气象古君子，渊源朝大夫。\n里门车下泽，客舍马青刍。\n霜柏寒逾劲，庭荆老不枯。\n只愁儿返哺，不及见飞乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从事郎致仕史挽诗","author":"魏了翁","text":"人为浮名若挂钩，夫君知命独休休。\n东都门外蚤辞禄，西岘山前不入州。\n告第书归泉壤底，满籯金在架签头。\n当年勇退称三老，此老胡宁不慭留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月十四次韵樊武仲喜雨","author":"魏了翁","text":"谁信夔夔解感神，嘤嘤赤子母心熏。\n为将一滴翻瓢水，散作千家举锸云。\n大化无端长寂寂，众形有欲自芸芸。\n更须尽挽天河水，亟与三边洗恶氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"支大监挽诗","author":"魏了翁","text":"四海李南纪，蚤从山斗韩。\n耻担兵部米，宁着大夫冠。\n人舐黄金笔，天颁白玉棺。\n平生一厚字，千古薄夫宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文彭州挽诗","author":"魏了翁","text":"二仲婵嫣起，清修自一家。\n践涂中险阻，宰郡晚光华。\n气燄奔金虏，威棱憺铁耶。\n料应九峰下，朝露泣姚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王处士挽诗","author":"魏了翁","text":"槿篱山下屋，桐帽水边村。\n遗子方寸地，传家廿四言。\n芳荪生夕秀，衰柳带秋昏。\n千古堂堂恨，青云落泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王宜人挽诗","author":"魏了翁","text":"门谱谁誇郡姓强，是家元自孝廉郎。\n长来但识诗书贵，老去不知簪珥香。\n吏部生涯瓶里粟，夫人宗事橐中装。\n他年点检挈庵稿，宁愧欧公志薛杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王宝谟挽诗 其三","author":"魏了翁","text":"昔我仕龟城，犹能友宁馨。\n记曾?别酒，俄遽隔泉扃。\n顷刻成三世，凄凉隔九龄。\n魂兮谁与作，吾友许公铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王宝谟挽诗 其二","author":"魏了翁","text":"泸江鲛夜泣，柳庙鹤秋飞。\n零露伤兰颖，凄风撼王徽。\n焄蒿恍兮惚，精爽是邪非。\n岂必存亡问，吾知全以归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王宝谟挽诗 其一","author":"魏了翁","text":"宁怀会稽绶，不遗帝城书。\n仕止四千石，年开八秩初。\n倾囷除旱魃，防岸免民鱼。\n欲识恩田广，衔哀到小胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王总卿生日 其二","author":"魏了翁","text":"浮云䆉稏卷晴畴，一目天隅尽好秋。\n路有醉人挑袯襫，边无嘶马趁兜鍪。\n开张叶气凭弧矢，收拾丰年报冕旒。\n小小经纶已如此，不应留滞古梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王总卿生日 其一","author":"魏了翁","text":"上到青天更上头，蜀人犹记旧星轺。\n安弦在昔犹危柱，挂壁于今倚大弨。\n棠树留春便野茇，桂花和月引仙瓢。\n风云不隔连天栈，门户三槐拂绛霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"计处士挽诗","author":"魏了翁","text":"我之外王父，早岁识殷州。\n落落双蓬鬓，萧萧一衲裘。\n天时四不出，人事百无忧。\n事业虽亡试，全归閟一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐府君挽诗 其二","author":"魏了翁","text":"大雅云亡久，流风尚典刑。\n赋登司马室，诗授伯鱼庭。\n不及瞻郎罢，犹能识宁馨。\n芜辞书琬琰，敢齿蔡邕铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐府君挽诗 其一","author":"魏了翁","text":"缣缃迂活计，屋壁老功夫。\n月暗乌声迥，霜寒雁影孤。\n江灵知孝子，天赋厚耆儒。\n剩馥多沾丐，于今道未臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐隐君挽诗","author":"魏了翁","text":"人畸天则偶，俗隘我常优。\n谩道蚿怜鳖，终成鹊避鸠。\n蹇驴花露晓，孤雁稻云秋。\n想见招魂曲，人人说少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯夫人挽诗","author":"魏了翁","text":"解道先天易，能哦击壤诗。\n只因居有习，毋谓女无仪。\n在姆师逡立，从夫妇得咨。\n暮年尤慰意，玉婿作门楣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史仓使约登齐山自弄水亭过清溪桥至壶天洞洞乃史新作或曰此即左史洞又至华盖洞翠微亭史仓索赋","author":"魏了翁","text":"自分宇宙有江山，独觉新年胜故年。\n水拍大堤人射地，路盘绝崄马行天。\n松萝苒苒开还密，洞谷谽谽断复穿。\n理道元来无隐尔，人从纸上看天渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史合州挽诗","author":"魏了翁","text":"昔忝东川使，知公才谞长。\n莫邪宁是利，薤本未为彊。\n横槊悲秋塞，凝香送夕阳。\n边关正多事，感慨卧龙冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史制干晦甫挽诗","author":"魏了翁","text":"菑川元自属公孙，竟策词场第一勋。\n理有是非宁挠夺，官无大小只忧勤。\n纷纷白地皆滩濑，豁豁青天亡片云。\n满腹诗书竟何用，泉台暧暧日西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史致政挽诗","author":"魏了翁","text":"口道先生易，躬行君子难。\n浮荣残梦觉，活计一般酸。\n日晚乌声急，风高雁影寒。\n行藏付千载，反覆要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月九日北山雍熙寺约同官","author":"魏了翁","text":"自从寒陆爽乾坤，律吕还宫岁换辰。\n历纪人正才九日，斗移天位已三春。\n销磨壮士姑随俗，牵引閒心苦为人。\n终愧时艰才力短，只将民命倚洪钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生日和辛江陵即席韵 其二","author":"魏了翁","text":"笑语声中别有天，巫云楚岫玉明船。\n冷风入坐酒无力，斜日媚空花欲然。\n猎猎旗风犹夏五，摇摇帆影立秋千。\n他时辇路追今梦，傥许陪公发未宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用张子益教授韵送虞退夫西归","author":"魏了翁","text":"子已江头戒棹郎，卬须何事未乘方。\n须看此意关时数，不为斯人自肺肠。\n白傅徒然泣商妇，毛生岂解出王樯。\n卬虽不敏真知得，为子临岐釂一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用李致政韵题临邛陈氏所居吕仙所留回道人来四字","author":"魏了翁","text":"负瓮城边閒日月，翻环门上几春秋。\n东阳谩识榴皮字，南郭曾偕柳树游。\n踏雪飞鸿痕偶在，寒潭过雁影无留。\n至人御气无今古，妙处疑同上下流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用蒋成甫韵贺虞退夫生子且以相名之","author":"魏了翁","text":"秦雍孙曾尚典刑，只将一念答天明。\n震雷殷地勾萌达，解雨鸣春涧谷声。\n阶玉正看联羯末，籯金安足拟贤成。\n相门为我成宅相，我欲将儿以相名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用樊武仲致政韵饯黄户部","author":"魏了翁","text":"七载赍身入楚乡，谁将平坂换羊肠。\n觉来亲友浑依旧，触处江山不改香。\n正引德星成胜集，更忻郎宿下垂光。\n人生行止时为大，膜外浮荣蚁穴王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲女挽诗","author":"魏了翁","text":"荆江春梦断，虞殡夜魂孤。\n未及陪宗室，应难祔舅姑。\n一时母从子，百岁妇随夫。\n此礼缘情制，临风老泪枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任重庆挽诗","author":"魏了翁","text":"诸任方衮衮，惜也大任君。\n曲突人谁信，扣阍天不闻。\n胆随豪满干，齿为愤穿龈。\n莫挽泉台恨，周箫咽涧云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次沧江韵 其二","author":"魏了翁","text":"野迥江空云意閒，清风唤客度东关。\n掺掺竹柏青垂地，炯炯宾朋玉立山。\n酒为心知一开口，话逢理到两舒颜。\n啸吟风月江头路，此意羲皇向上还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再次沧江韵 其一","author":"魏了翁","text":"夏畦初雨桔槔閒，读易幽人昼掩关。\n厚筑根基方考室，不辞卷撮要为山。\n剩栽晚岁松筠友，长伴沧江冰雪颜。\n门外斜阳迷客路，屋中行李去家还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"魏了翁","text":"芹宫日晚守祠斋，争见花如火齐堆。\n不复少年黄犊健，任令急景白驹催。\n繁红才伴栗留至，众绿又惊鶗鴂来。\n到会意时须命酒，莫论花谢与花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和颠字韵时方议开边","author":"魏了翁","text":"鼎象亨调戒在颠，或捐常馔美时鲜。\n鸷形不匿麇投麓，剑影虚张蛟绕船。\n壮观要还全盛日，图回须似中兴年。\n掩关雷雹惊春梦，忧国丹心只自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘少监挽诗 其二","author":"魏了翁","text":"天子龙飞日，东征与子同。\n俄将满船月，换却打头风。\n志尚观其始，规模识所终。\n人才眇然甚，胡不慭遗公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘少监挽诗 其一","author":"魏了翁","text":"端重嗤浮俗，深沈烛事几。\n上天陪将相，宥地赞枢机。\n辰告言犹在，朝回事已非。\n空贻郎罢叹，不见子行归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙夫人挽诗","author":"魏了翁","text":"庄重知为女，宽和解相夫。\n母慈均众子，妇道尽皇姑。\n春日鸣抟黍，秋风撼毕逋。\n尚迟彤管笔，宿草卧龟跗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宇文泸州挽诗 其二","author":"魏了翁","text":"风壑昂脩干，霜空突翠峰。\n介然疑苦硬，行处独从容。\n不忝南轩嗣，奚惭北学宗。\n巫阳招不复，暧暧日高舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宇文泸州挽诗 其一","author":"魏了翁","text":"笃信宁违俗，质行非近名。\n室无官烛泪，庖有甑尘生。\n吏不知厮卒，家毋役叟兵。\n兹犹馀事耳，彻底是真清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宇文枢密挽诗 其二","author":"魏了翁","text":"夷考公言行，真成肃悯孙。\n星枢绳懿武，月殿媲隆恩。\n契阔成三世，凄凉隔九原。\n壮夫襟上泪，并为两师垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宇文枢密挽诗 其一","author":"魏了翁","text":"人物眇然甚，天胡不慭公。\n北风鸣槭槭，西火乱蓬蓬。\n襄鄂谁专阃，江淮孰总戎。\n是应当馈叹，曩日镇江功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安宣抚生日 其一","author":"魏了翁","text":"知是皇家几世仁，天开人物作长城。\n元崇雅号济时相，景略真成间代英。\n天路旂常铺绩用，中原草木识威名。\n北征西略公馀事，应念同胞百万生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安宣抚生日 其二","author":"魏了翁","text":"疏戆烦公刮目看，肯持谀语祝加餐。\n千钧弩上机宁易，百尺竿头步转难。\n事遇快时聊复忍，民当急处略须宽。\n扫除荆棘栽梨枣，累璧重圭耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安总领生日 其一","author":"魏了翁","text":"犹记仙翁护玉关，版图半壁手提还。\n每惊荡潏风波后，多谢经纶父子间。\n元是烂柯观已熟，故应当局祇如閒。\n几人钱谷鞭中老，双鬓何曾点一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安总领生日 其二","author":"魏了翁","text":"祝公不作语啾啾，陛下凭公释顾忧。\n往误叵堪成铁错，后图犹可保金瓯。\n饮江共喜无胡马，屯渭悬知有木牛。\n虎也肤公康是似，愿歌江汉美宗周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都杜五一府君之葬某新有丧不得为文以侑虞殡命儿冲代赋","author":"魏了翁","text":"尚记维川死，今年又哭公。\n琴声辞夜月，书叶卧春风。\n儿女数行泪，亲朋十九空。\n我翁方念母，忍泪课儿冲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都教授史君挽诗","author":"魏了翁","text":"槁乾迂事业，讲授老功夫。\n日暮乌声急，山空鹤影孤。\n高谭霜皎洁，及物雨昭苏。\n已矣公何憾，于今道未臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱邵州挽诗","author":"魏了翁","text":"杏园犹记赏花同，忍看前旌照眼红。\n民命一丝悬晷刻，仁心触处作春风。\n棣华韡韡天伦厚，湑叶裳裳世泽隆。\n万事纷纷缘手尽，只将孝友诏无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次王万里愁霖","author":"魏了翁","text":"江声砧杵入层楼，预作人閒八月秋。\n虹外挂无穷远思，雁声鸣不断新愁。\n汉淮赤地不知里，巴蜀青天更上头。\n蹇我康时分无策，只祈一饱暂销忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次肩吾庆生日韵 其二","author":"魏了翁","text":"我友忧时发满梳，殷勤勉我用诗书。\n情知分义如何废，可使才能自有馀。\n气血渐衰多病后，创夷转甚数年初。\n梦魂惯识归来趣，长傍山椒撷稻疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次肩吾庆生日韵 其一","author":"魏了翁","text":"谩阅人间五十年，年来道远思悠然。\n一心可使乾坤位，五性元钟父母全。\n为己工夫浑间断，满头岁月浪推迁。\n更无益友相扶植，平地羊肠仆白颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次肩吾庆生日韵 其一","author":"魏了翁","text":"男儿生世果何事，卜士诗之闾史书。\n内美元非私正则，天彝岂但付胥馀。\n滔滔大化亘千古，职职群生同一初。\n此事年来才信得，从前浪走只成疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次肩吾庆生日韵 其二","author":"魏了翁","text":"山中兀兀不知年，但数前山䓞火然。\n人笑腰无金可佩，我忻胫与玉俱全。\n圣贤面目昼三接，简册期程日九迁。\n此事知心君有几，不妨相伴各童颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵丁大监见怀 其一","author":"魏了翁","text":"行藏去就各随时，敬怒嫌疏忍奋飞。\n正怕霜严天宇净，敢誇舟载月明归。\n生松有梦还公固，化鹤何心驻令威。\n独抱遗编看千古，昔人历历未应非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中秋风雨中约客叶元老有诗","author":"魏了翁","text":"长雨顽云处处山，浃旬浑不露天悭。\n鱼旟未兆心如醉，鸿雁关情鬓欲斑。\n月体晦明犹偶尔，酒肠舒惨亦浑閒。\n只将愚虑酬佳赠，未必骚情不破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王常博题赠江陵乐德佐 其二","author":"魏了翁","text":"三十有三载，好风吹又来。\n清坚霜后竹，冷澹雪边梅。\n世事忧千绪，家山肠九回。\n江头一樽酒，烟雨暗章台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王常博题赠江陵乐德佐 其一","author":"魏了翁","text":"僇馀甘远屏，分表得生还。\n夜雨滴归梦，晓霜彫醉颜。\n角巾吾故里，璞玉子荆山。\n又作无期别，扁舟上峡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政上刘舍人阁学","author":"魏了翁","text":"滔滔陆海与潘江，得似韩渠受籍泷。\n天下美官容易得，世间清论苦难降。\n龙随凡介便俦伍，鹤耸孤云谁等双。\n一马二童吾计决，山中花竹总麾幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见寄 其三","author":"魏了翁","text":"湖畔三顷秫，酿成聊独斟。\n积薪伤汲直，求旧感迟任。\n梦里牛山峻，吟边雁泊深。\n两乡明月夜，应照旧登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见寄 其二","author":"魏了翁","text":"怕放红楼目，浮云断复连。\n远看壶聚拓，近视室如县。\n耿耿自许国，悠悠谁讯天。\n天心那可识，拄颊看晴川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]