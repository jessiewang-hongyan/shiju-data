[{"title":"书直舍壁二首 其一","author":"陆游","text":"三黜愧公议，再来仍冷官。\n志无重奋发，身有转衰残。\n加饭支馀息，添衣禦早寒。\n归休应渐近，不是强心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书剑","author":"陆游","text":"书剑当年遍两川，归来垂钓镜湖边。\n老皆有死岂独我，士固多贫宁怨天。\n物外胜游携鹤去，琴中绝谱就僧传。\n莫言白首诗才尽，读罢犹能意爽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书南堂壁二首 其二","author":"陆游","text":"荒寒浅村步，隐翳小茅茨。\n偶逐渔樵住，都忘岁月移。\n闲惟接僧话，老始爱陶诗。\n耆齿犹须几，羸然敢自期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书南堂壁二首 其一","author":"陆游","text":"偶筑湖边舍，侵寻四十春。\n山丘未埋骨，诗酒尚关身。\n樵路霜侵屦，渔舟雨垫巾。\n忝蒙乡党敬，六圣有遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书南堂壁二首 其一","author":"陆游","text":"数间破屋住荒郊，暑雨时须自补茅。\n多病篇章无杰思，长闲樵牧有新交。\n荒唐但向先师愧，肮脏宁辞薄俗嘲。\n偶有会心成独笑，一林春笋放烟梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书南堂壁二首 其二","author":"陆游","text":"心溷元知面合团，愚公骨相却酸寒。\n云山万叠犹嫌浅，茆屋三间已觉宽。\n菜长何妨供小摘，花开聊得助幽欢。\n今朝忽有西村兴，著起芒鞋不作难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书室","author":"陆游","text":"客来莫笑席尘凝，静处工夫却少增。\n黑蚁常翻鲁壁简，瘦蛟时落越溪藤。\n尚能豪健如霜鹘，未遽衰残学冻蝇。\n更喜论文有儿子，夜窗相对短檠灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书室明暖终日婆娑其间倦则扶杖至小园戏作长句二首 其一","author":"陆游","text":"放翁老手竟超然，俗子何由与作缘。\n百榼旧曾誇席地，一窗今复幻壶天。\n梦回橙在屏风曲，雨霁梅迎拄杖前。\n吾爱吾庐得安卧，笑人思颍忆平泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书室明暖终日婆娑其间倦则扶杖至小园戏作长句二首 其二","author":"陆游","text":"美睡宜人胜按摩，江南十月气犹和。\n重帘不捲留香久，古砚微凹聚墨多。\n月上忽看梅影出，风高时送雁声过。\n一杯太淡君休笑，牛背吾方扣角歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书室独处欣然有咏","author":"陆游","text":"凿空学道本无师，歇尽狂心颇自奇。\n闲坐始知冬日永，高谈未觉耄年衰。\n治棺准备膏肓日，酿酒枝梧雨雪时。\n常笑祖龙痴到底，一生辛苦觅安期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书室独夜","author":"陆游","text":"忽忽新春过，愔愔一室幽。\n铜灯立雁趾，石鼎揭龙头。\n老愧人扶拜，贫无食足谋。\n退居消日月，太半付庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书屋壁二首 其一","author":"陆游","text":"筑室镜湖滨，于今四十春。\n放生鱼自乐，施食鸟常驯。\n土润观锄药，灯清论养真。\n桃源处处有，不独武陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书屋壁二首 其二","author":"陆游","text":"鸟道经行稳，巢居卧起宽。\n鹿衣裁短褐，龟屋制危冠。\n旧慕嵇中散，今师靖长官。\n蛟龙云雨上，未必胜泥蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适","author":"陆游","text":"畴昔花前醉放颠，即今不饮亦陶然。\n太平固自多遗老，独往何妨是斥仙。\n扶杖每观南亩馌，解衣时作北窗眠。\n人间贤俊方云集，我遇龙蛇岂厄年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适","author":"陆游","text":"细读养生主，长歌归去来。\n山僧借水品，溪父送琴材。\n病退稀求药，身闲日探梅。\n今宵喜无寐，岷下有书回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适二首 其一","author":"陆游","text":"老翁垂七十，其实似童儿。\n山果啼呼觅，乡傩喜笑随。\n群嬉累瓦塔，独立照盆池。\n更挟残书读，浑如上学时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适","author":"陆游","text":"架竹苫茅屋数椽，推开窗户即江天。\n微饥未遽愁长日，小疾何妨度厄年。\n孤鹤入秋偏警露，断山欲雨自生烟。\n囊中妙法君知否，买断清闲不用钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适二首 其二","author":"陆游","text":"心清绝欲早，才薄去官多。\n月下时闲钓，云边每浩歌。\n野堂青草覆，山市白驴过。\n也有成功处，新降百万魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适二首 其一","author":"陆游","text":"北崦千梢竹，东轩八尺床。\n遍行欣老健，熟睡领新凉。\n海石陈书几，陶诗贮药囊。\n时时一到眼，亦足傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适","author":"陆游","text":"万事罢经营，悠然心太平。\n甘餐随日足，美睡等闲成。\n处处佳风月，人人好弟兄。\n神仙不须学，券内有长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书适二首 其二","author":"陆游","text":"家食身无役，耆年力未衰。\n寓欢那待酒，随意或成诗。\n穷达元非我，冤亲竟是谁。\n惟嗟见事晚，枉却鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书逆旅壁","author":"陆游","text":"市远过三里，店孤无四邻。\n窄才容一客，久或住经旬。\n病妪求风药，樵儿馈爨薪。\n人情愈谙熟，来往不辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书悔","author":"陆游","text":"衣食须耕稼，无端浪出游。\n客途南北雁，世事雨晴鸠。\n蓬转何时已，灰寒善自谋。\n江湖千万里，何处欠渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋壁","author":"陆游","text":"烟水云山千万重，散人名号继吾宗。\n买雏养就冲霄鹤，拾子栽成偃盖松。\n父老年年同社酒，儿孙世世作春农。\n晚窗睡觉添幽事，卧听兰亭古寺钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋壁","author":"陆游","text":"幅巾短褐野人装，洗尽黄尘早暮忙。\n地僻渔扉常隐翳，身闲灵府自清凉。\n雨中郁郁垣衣绿，涧底纤纤石发长。\n老惫只思眠蹋壁，一尊到手又成狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋壁二首 其二","author":"陆游","text":"落魄人间不记年，晚营茆栋镜湖边。\n室空惟是四壁立，面瘦渐生双颊颧。\n地僻门无残客到，岁丰路有醉人眠。\n君看朝市红尘闹，始信吾曹是地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书巢冬夜待旦","author":"陆游","text":"扫叶拥阶寒犬行，编茆护栅老鸡鸣。\n风霜渐逼岁时晚，形影相依灯火明。\n史策千年愧豪杰，关河万里怆功名。\n固应死抱无穷恨，老病何由更请缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜","author":"陆游","text":"莫谓家贫厌旧醅，一尊聊对桂花开。\n天菑已过无蝗孽，海舶初通有药材。\n剩借凉风吹醉颊，况逢急雨洗浮埃。\n入秋腰脚增强健，山麓从今日日来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜三首 其三","author":"陆游","text":"满川秋穫重赪肩，拾穗儿童拥道边。\n夜夜江村无吠犬，家家市步有新船。\n夺攘不复忧山越，安乐浑疑是地仙。\n惟有衰翁最知达，避胡犹记建炎年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜三首 其一","author":"陆游","text":"水际柴荆键不开，野人相觅漫敲推。\n寒鸦阵黑疑云过，老木声酣认雨来。\n酒价日低常得醉，官租时办不劳催。\n平生未省如今乐，却笑傍观误见哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜二首 其一","author":"陆游","text":"乞得身归镜水滨，此生真作葛天民。\n眼明身健何妨老，饭白茶甘不觉贫。\n瓮酒又篘三斗熟，园花时报一枝新。\n挂冠更作黄冠计，多事常嫌贺季真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜二首 其二","author":"陆游","text":"已向烟霞著脚深，世间万事不关心。\n旧携鸦觜供锄药，新典鱼须用买琴。\n井上引藤初满架，池南移竹渐成阴。\n话行不必须今日，五百年间有赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜三首 其二","author":"陆游","text":"今年端的是丰穰，十里家家喜欲狂。\n俗美农夫知让畔，化行蚕妇不争桑。\n酒坊饮客朝成市，佛庙村伶夜作场。\n身是闲人新病愈，剩移霜菊待重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜二首 其二","author":"陆游","text":"十月东吴草未枯，村村耕牧可成图。\n岁收俭薄虽中熟，民得蠲除已小苏。\n家塾竞延师教子，里门罕见吏徵租。\n老昏不记唐年事，试问元和有此无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜二首 其一","author":"陆游","text":"宠辱元知不足惊，退居兀兀饯馀生。\n冰鱼可钓羹材足，霜稻方登籴价平。\n邻媪已安诸子养，园丁初葺数椽成。\n邻闾喜事吾曹共，一醉宁辞洗破觥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜","author":"陆游","text":"雨足郊原正得晴，地绵万里尽春耕。\n阴阴阡陌桑麻暗，轧轧房栊机杼鸣。\n亭鼓不闻知盗息，社钱易敛庆秋成。\n天公不负书生眼，留向人间看太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜","author":"陆游","text":"堪笑龟堂老更顽，天教白发看青山。\n家居禹庙兰亭路，诗在林逋魏野间。\n略计未尝三日醒，细推犹得半生闲。\n今年况展南湖面，朝借樵风暮可还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书喜","author":"陆游","text":"攲斜古屋枕江干，恩赐残骸许挂冠。\n杵臼有声聊足食，羊牛识路自归阑。\n不求客恕陶潜醉，肯受人怜范叔寒。\n儿辈渐还家暖热，预知灯火话团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书寓舍壁二首 其二","author":"陆游","text":"落佩颓冠惯放慵，经旬寓馆古临邛。\n西偏取路横穿竹，北向开门倒看松。\n醉后蹇驴归薄暮，闲来支枕睡高舂。\n鹄鸣山谷曾游处，剩欲扶犁学老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书寓舍壁二首 其一","author":"陆游","text":"天与痴顽不解愁，未埋病骨且闲游。\n山于拄杖横时看，路到芒鞋破处休。\n初拟烧丹住南岳，却因学剑客西州。\n秋风巾褐添萧爽，又作临邛十日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书愤二首 其二","author":"陆游","text":"镜里流年两鬓残，寸心自许尚如丹。\n衰迟罢试戎衣窄，悲愤犹争宝剑寒。\n远戍十年临的博，壮图万里战皋兰。\n关河自古无穷事，谁料如今袖手看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书愤","author":"陆游","text":"清汴逶迤贯旧京，宫墙春草几番生。\n剖心莫写孤臣愤，抉眼终看此虏平。\n天地固将容小丑，犬羊自惯渎齐盟。\n蓬窗老抱横行略，未敢随人说弭兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书愤","author":"陆游","text":"早岁那知世事艰，中原北望气如山。\n楼船夜雪瓜洲渡，铁马秋风大散关。\n塞上长城空自许，镜中衰鬓已先斑。\n出师一表真名世，千载谁堪伯仲间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书愤","author":"陆游","text":"山河自古有乖分，京洛腥膻实未闻。\n剧盗曾从宗父命，遗民犹望岳家军。\n上天悔祸终平虏，公道何人肯散群。\n白首自知疏报国，尚凭精意祝炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书愤二首 其一","author":"陆游","text":"白发萧萧卧泽中，祇凭天地鉴孤忠。\n阨穷苏武餐毡久，忧愤张巡嚼齿空。\n细雨春芜上林苑，颓垣夜月洛阳宫。\n壮心未与年俱老，死去犹能作鬼雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书道室壁","author":"陆游","text":"馀生天地一飞蓬，学道年来似有功。\n习气扫除空劫外，精神澡雪隐书中。\n种瓜溪父时时见，卖药壶公处处同。\n莫谓与人缘苦薄，相随拍手有儿童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意三首 其二","author":"陆游","text":"养生慕黄老，为治法唐虞。\n耆寿缘忧惧，危亡坐燕娱。\n大川宜利涉，蔓草戒难图。\n退士惟身虑，铭膺岂敢无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"疏慵久矣卧郊扉，暂出人间辄免归。\n梵志放花常恨晚，士师分鹿又成非。\n平生旧学宁当负，同志良箴亦重违。\n说与吾儿勤念此，负禾勿恨露沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意二首 其二","author":"陆游","text":"物我年来已两忘，萧然湖曲一茆堂。\n身闲自与俗子远，睡美不知秋夜长。\n馀禄正应齑瓮在，宿酲时卧酒垆傍。\n老人肘后长生药，检尽千金无此方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"帝命煌煌敕百神，方倾天汉洗胡尘。\n但须荆州一好汉，安用商山四老人。\n竹帛恐贻千古笑，江湖未愧百年身。\n此心欲与何人说，病足呻吟又过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意二首 其一","author":"陆游","text":"我本三生世外人，幻躯其实强冠巾。\n稍能闭户学种菜，时亦长歌行负薪。\n一醉却非身外事，百年终是冢中尘。\n君知梦境无根底，莫信人言想与因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"颔霜久矣不胜耘，残发今年白十分。\n忧国虽忘嫠妇纬，爱君敢进野人芹。\n床头酒滴空阶雨，炉面香横出岫云。\n已向人间齐物我，不教惊起白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意二首 其一","author":"陆游","text":"秋江菰菜喜新尝，盐酪亲调匕箸香。\n但有长腰吴下米，岂须细肋大官羊。\n青衫昔悔尘中老，白发今宜静处藏。\n一事尚须深自咎，街头儿女识韩康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"一鸣辄斥不鸣烹，祸福元知未易评。\n湖海凄凉身跌宕，杯觞豪举笔纵横。\n敢希二顷成高卧，但愿诸公致太平。\n波暖龙舟溯清汴，道边扶杖眼犹明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意三首 其一","author":"陆游","text":"策蹇若华驷，歠漓如上尊。\n人皆可尧舜，身自有乾坤。\n逢客亦共语，无人还闭门。\n千年道术裂，谁复见全浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意二首 其二","author":"陆游","text":"病眼犹堪阅世人，难将雪鬓著乌巾。\n囊中钱尽罢沽酒，涧底雨寒愁束薪。\n老子那辞徙牛屋，痴人自喜拜车尘。\n穷通要是儿嬉事，懒就山僧讲宿因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"万事马牛风，萧然破屋中。\n忍贫增力量，耐辱见神通。\n道进天魔散，心安客疾空。\n微言施鱼鸟，一一脱池笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意三首 其三","author":"陆游","text":"委顺天知我，经营鬼笑人。\n定知穷至死，敢恨病经旬。\n爱酒陶元亮，还乡贺季真。\n扁舟吾事毕，遗世亦遗身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"巢山远下湿，止酒谢中乾。\n粗得养生妙，孰能非意干。\n挂冠身始贵，屏药疾方安。\n自笑犹多事，时时把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意","author":"陆游","text":"养得山林气粗全，此怀无处不超然。\n日长琴弈茆檐下，岁晚江湖箬帽前。\n天上本令星主酒，俗间妄谓世无仙。\n今年茶比常年早，笑试西峰一掬泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书意示子孙","author":"陆游","text":"我阅人间久，深知理恶盈。\n孳孳训来裔，堇堇作儒生。\n仕勿卑曹掾，书才记姓名。\n茆茨不啻足，此外尽浮荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"襁负客淮颍，髧髦逢乱离。\n中原遂乖隔，北望每伤悲。\n泛渭题新赋，游嵩续旧诗。\n死生虽异世，此意未应移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"溪路人家尚阖扉，彊扶衰惫著征衣。\n百年朝露古所叹，一棹秋风吾欲归。\n楚客长号沽白璧，汉宫太息遣明妃。\n铄金销骨从来事，老矣何心践骇机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"投老羁孤久，临觞感慨频。\n关河疏旧友，风雨败新春。\n事固少如意，天终能胜人。\n所悲头上发，不与柳条新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"常记当年赋子虚，公卿交口荐相如。\n岂知鹤发残年叟，犹读蝇头细字书。\n出处幸逃千载笑，功名从负此心初。\n荒园落叶纷如积，日暮归来自荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"壮岁功名妄自期，晚途流落鬓成丝。\n临风画角晓三弄，酿雪野云寒四垂。\n金锁甲思酣战地，皂貂裘记远游时。\n此心炯炯空添泪，青史它年未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"衰颜非复昔年朱，几过黄公旧酒垆。\n成败只堪三太息，是非终付一胡卢。\n连天烟草迷归梦，动地风波历畏途。\n辛苦一生成底事，躬耕犹得补东隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]