[{"title":"有会而作","author":"范成大","text":"拙是天资懒是真，本来何用戒香薰。\n强阳气尽冥恩怨，杜德机深泯见闻。\n念动即时漂鬼国，心空随处走魔军。\n室中已自空诸有，休负天机与地文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀石湖旧隐","author":"范成大","text":"浩荡沙鸥久倦飞，摧颓枥马不胜鞿。\n官中风月常虚度，梦里关山或暂归。\n橘社十年霜欲饱，鲈江一雨水应肥。\n冷云著地塘蒲晚，谁为披蓑煖钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有怀龚养正","author":"范成大","text":"好在楚龚子，秋来情话稀。\n昨承书素说，行侍板舆归。\n烟水潮平棹，风霜岁晚衣。\n几时真访戴，莫待雪花霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感今昔二首 其二","author":"范成大","text":"飘风骤雨谩惊春，扫荡何烦臂屈伸。\n天识不衷宜不恕，神歆非类即非仁。\n休雠地下枯鱼骨，且斗尊前健犊身。\n静看可怜还可笑，香山宁是幸灾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有感今昔二首 其一","author":"范成大","text":"阳春白雪雅音希，俚耳冬烘辄笑嗤。\n麋见丽姬翻决骤，鸟闻韶乐却忧悲。\n烂奚轻薄人何敢，伏猎荒唐自不知。\n蚓窍蝇鸣莫嘲诮，彭亨菌蠢正当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次伯安推官赠别韵","author":"范成大","text":"交情弥岁竟匆匆，短棹归寻一亩宫。\n塞责文书容我懒，及时杯酒赖君同。\n披云峰顶城头月，揽秀堂前扇里风。\n千里音书慰离索，莫言天远费鳞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次胡经仲知丞赠别韵","author":"范成大","text":"先生有道抗浮云，拄颊看山意最真。\n霜鬓不堪痟首疾，翠蛾常作捧心颦。\n官如斯立蓝田小，家似渊明栗里贫。\n俯仰别来蓂荚换，只今谁与话情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次黄必先主簿同年赠别韵二首 其二","author":"范成大","text":"山郭官閒得烂游，弥年还往话绸缪。\n西园剥栗催奴课，东院寻梅劝客留。\n笔下修锋千首富，谈间和气两眉浮。\n别来怅望何时见，谩上重城谩上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次景琳录事赠别韵","author":"范成大","text":"放船鸣橹便秦吴，送别空烦长者车。\n宿雾锁山常羃羃，断云将雨忽疏疏。\n高城五岭花深处，短棹三江木落初。\n赖得溪流通尺素，蒲根仍有一双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子文","author":"范成大","text":"幻尘久已破狐涎，身世谁能料鼠肝。\n暮夜雨收千嶂出，晨朝风卷四维宽。\n我今无事不如梦，君岂有心犹觅安。\n但促小槽添压石，龙头珠滴夜珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子文雨后思归","author":"范成大","text":"断云将雨洗松篁，昨夜痴龙起蛰藏。\n人自无情孤乐事，天犹有意作新凉。\n尊前不见凌波袜，楼下空闻拜月香。\n万事安能尽如愿，且来相伴压糟床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子文客舍小楼","author":"范成大","text":"客里仍携一束书，闭门虹气自凌虚。\n未闻光范延珠履，谁向甘泉从玉车。\n散尽生涯千答布，收将文价百车渠。\n淹留且结西湖夏，同到秋风赋遂初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子永夜雨","author":"范成大","text":"办作长愁客，工哦苦雨吟。\n挑灯今夕意，欹枕故园心。\n漏屋疏疏滴，空檐细细斟。\n相过巷南北，屐齿怕泥深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子永雪后见赠","author":"范成大","text":"雪瓴待伴半阴晴，竟日檐冰溜雨声。\n九陌泥乾尘未动，南山石露塔犹明。\n稍闻吉语占农事，便觉归心胜宦情。\n想得秫田来岁好，瓦盆加酿灌愁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵太守出郊","author":"范成大","text":"晓装缇骑踏芳辰，江为安澜露浥尘。\n棨戟前驱留住月，笙箫后备带行春。\n鱼龙水面金杯满，鸾鹤山头綵笔新。\n闻道将军宽礼数，不辞酩酊吐车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵尹少稷察院九宫坛斋宿","author":"范成大","text":"草草驰三里，萧萧共一餐。\n吏方绵礼蕝，公自将诗坛。\n隙月窥床近，窗风刮坐寒。\n鸦鸣未忍散，端为四并难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王夷仲正字同游成氏园","author":"范成大","text":"秀岩堂上玉东西，把酒登临望眼迷。\n天宇四垂粘地近，海山一抹带潮低。\n绝知客好无尘事，聊记吾曾有醉题。\n倚赖群仙联姓字，他年谁敢一杴泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王浚明用时举苦热韵见赠","author":"范成大","text":"暑窗当午思昏昏，雷起千峰睡不闻。\n铄石谁能招楚魄，斲冰我欲访湘君。\n年华只合加餐饭，事业休工刺绣文。\n赖有两贤南北巷，岁寒幽谷共兰薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵平江韩子师侍郎见寄三首 其一","author":"范成大","text":"自古四愁湘水深，谁将城郭启山林。\n有情碧嶂团栾绕，无数朱楼缥缈临。\n蚺鼓揭天惊客坐，象鍪航海厌蛮琛。\n三千客路长安远，故旧书来直万金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵平江韩子师侍郎见寄三首 其二","author":"范成大","text":"灵泉杖屦浙江头，经济长怀尚典州。\n堂上读书朝气爽，台前呼月海光浮。\n交情尺素勤双鲤，笔力枯松挽万牛。\n已把三章翻乐府，为君击节变蛮讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵平江韩子师侍郎见寄三首 其三","author":"范成大","text":"前年冲雪过双溪，风帽泥鞯骑吹随。\n烂醉依前逢锦瑟，好音惟是欠黄鹂。\n功名未试玉璜玦，离别频倾金屈卮。\n畴昔北征烦吉梦，南征合有梦归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵正夫游王园会者六人","author":"范成大","text":"丘园窈窕复崎岖，草木生香景倍殊。\n花下百杯齐物我，云边一眼尽江湖。\n不知朱户趑趄者，能胜青山放浪无。\n六逸萧然真可画，为君题作竹溪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵边公辨","author":"范成大","text":"错落参旗罥竹梢，柴荆临水闭蓬蒿。\n春风吹晓玉蟾堕，秾露洗空银汉高。\n双鹊绕枝应也倦，一蛩吟壁已能豪。\n新秋只合添诗兴，莫学潘郎叹二毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年杨廷秀使君寄题石湖 其一","author":"范成大","text":"仪凰当瑞九韶成，何事栖鸾滞碧城。\n公退萧然真吏隐，文名藉甚更诗声。\n句从月胁天心得，笔与冰瓯雪椀清。\n书到石湖春亦到，平堤梅影縠纹生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年杨廷秀使君寄题石湖 其二","author":"范成大","text":"半世轻随出岫云，如今归作卧云人。\n小山有赋招游子，大块无私佚老身。\n禅版梦中千嶂晓，鬓丝风里万花春。\n新年社瓮鹅黄满，剩醉田头紫领巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵同年杨使君回自毗陵同泛石湖舟中见赠 其一","author":"范成大","text":"客舫中流下，人家夹岸看。\n洛花堆锦煖，吴藕镂冰寒。\n莫厌清欢暂，须知后会难。\n小诗烦本事，任秃綵毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵许季韶通判水乡席上","author":"范成大","text":"青山绿浦竹间明，彷佛苕溪好处行。\n解愠风来如故旧，催诗雨作要将迎。\n休兵幕府乌鸢乐，熟稻边城鼓笛声。\n摹写个中须綵笔，句成仍挟水云清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵许季韶通判雪观席上","author":"范成大","text":"把酒临风瑞露倾，琼浆何用谒云英。\n捲帘雨脚银丝挂，倚杖江头绿涨生。\n岭海一凉苏暑病，山林千籁试秋声。\n兹游奇绝忘羁宦，惭愧烟中短棹横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严子文见寄","author":"范成大","text":"雨云浓压屋山头，诗句端来写客忧。\n雷电已将金薤取，琼瑶难报木瓜投。\n无心我正铭三住，有意君堪话四休。\n何日寻春同步屧，先教啼鸟说来由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严子文旅中见赠","author":"范成大","text":"杯中畴昔共江天，倾座新诗报警联。\n海浦寸心空共月，京华双鬓各凋年。\n交情敢说同方友，句法甘从弟子员。\n有意数从文字饮，何须争著祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵即席","author":"范成大","text":"留连银烛照金荷，肠断华年一掷梭。\n月姊有情难独夜，天孙无赖早斜河。\n晶晶霜瓦寒生粟，衮衮风帏细涌波。\n鸹鹖晓啼鸣鹊散，许多佳景奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李子永见访二首 其二","author":"范成大","text":"有意能停棹，多情易忆家。\n清诗穿月胁，远梦绕天涯。\n雨蝶衣濡粉，秋蚊喙吐花。\n新凉宜小驻，谈笑有丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李子永见访二首 其一","author":"范成大","text":"混俗休超俗，居家似出家。\n有为皆影事，无念即生涯。\n莫觅安心法，翻成捏目花。\n作糜须谷粟，千劫漫炊砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨同年秘监见寄二首 其二","author":"范成大","text":"吾衰长愧接舆狂，忙里何心领燕香。\n尘土簿书憎铁研，水云蓑笠傲金章。\n论文无伴法孤起，访旧有情书数行。\n何日却同湖上醉，露帏宵幄为君张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨同年秘监见寄二首 其一","author":"范成大","text":"瘴云岚雨几时归，应把周南视九夷。\n旧说鬼神惊落笔，新传狐兔骇搴旗。\n韶江石老箫音在，庾岭梅残驿使迟。\n自古朱弦清庙具，莫贪鹏海看天池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈季邻户部旦过庵","author":"范成大","text":"宦游触处似悬匏，北岳南山想献嘲。\n指手百年休铸铁，盖头一把暂诛茅。\n玉京岁晚梧桐落，水国霜清橘柚包。\n飞锡已随归梦去，何人顶上鹊成巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宗伟阅番乐","author":"范成大","text":"十日閒愁昼掩关，起寻一笑共清欢。\n罢休诗社工夫淡，洗净书生气味酸。\n尽遣馀钱付桑落，莫随短梦到槐安。\n绣靴画鼓留花住，剩舞春风小契丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵宗伟温伯","author":"范成大","text":"冉冉流光迫岁馀，青林日夜向人疏。\n雨滋岩桂重堆粟，风折庭蕉又献书。\n逋客解兰思婉娩，先生弹铗厌清虚。\n一尘不立浑输我，即境心安是故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朋元久雨","author":"范成大","text":"谁酿愁䨧玉宇间，都缘梅子要斓斑。\n腾腾困思午犹梦，扰扰奔云风未还。\n休问满城骑马滑，不妨长日闭门闲。\n今朝晴色熹微似，乾鹊飞来语屋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵朋元游王氏园","author":"范成大","text":"联翩步屧翠微间，回首红尘自鲜欢。\n捲地雨添千涧急，拥门云锁两山盘。\n绝怜茶笋能留客，仍喜蛙声不在官。\n雪白杨梅消息未，重来应至麦秋寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵林子章阻浅留滞","author":"范成大","text":"客行端似未归云，指点璿杓几易辰。\n喜有风花黄作晕，似闻溪涨绿生鳞。\n我从走俗言无味，君已鸣文笔有神。\n绣段炳然空辱赠，急翻缇袭扫蛛尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚九日南楼宴集三首 其三","author":"范成大","text":"斯民邹鲁更丰年，雅道凄凉见此贤。\n万陇登禾新霁色，千村鸣柝旧寒烟。\n锵金绝世诗情妙，倚剑凌空隶墨鲜。\n珍重北窗山六六，使君名与汝俱传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚九日南楼宴集三首 其一","author":"范成大","text":"双旌暮捲小舂容，画栋云生笑语中。\n但觉山光侵酒绿，不知日脚染溪红。\n控临缥缈疑无地，指点虚无欲驭风。\n谁遣玉蟾催骑吹，归来人影在朦胧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚九日南楼宴集三首 其二","author":"范成大","text":"珠履参陪北海觞，仍邀拥节旧中郎。\n碧城香雾连天暝，黄叶霜风捲地凉。\n佳节转头论聚散，清波从古阅兴亡。\n明年重把茱萸醉，公在丛霄贡玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚元夕赏倅厅红梅三首 其二","author":"范成大","text":"真色生香绝世逢，烟光池面两溶溶。\n楚邻不待施朱好，虢国翻嫌傅粉浓。\n晴日暧云春照耀，温风霁月夜舂容。\n酒阑且驻纱笼看，慢破团团一壁龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚元夕赏倅厅红梅三首 其一","author":"范成大","text":"春入林梢一再风，破寒匀染费天工。\n虽然媚荡新妆别，只与横斜旧格同。\n午枕乍醒铅粉退，晓奁初罢蜡脂融。\n后来颜色休论似，夹路漫山取次红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡安抚元夕赏倅厅红梅三首 其三","author":"范成大","text":"司花一笑为谁开，知道朱幡得得来。\n疏影有情当洞户，蔫香无语堕空杯。\n风生翰墨留连看，月入笙歌次第催。\n来岁如今翻旧唱，五云丛里望三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑校书参议留别","author":"范成大","text":"年丰方共庆，岁晚客他之。\n吏事朝还暮，人生合复离。\n江山残梦破，风月片帆移。\n后会吾衰矣，桑榆一茧丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵胡邦衡秘监","author":"范成大","text":"斯言向来立，千古敢疵瑕。\n有命孤蓬转，何心劲箭加。\n人穷名满世，天定客还家。\n回首冥恩怨，虚空不著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵蚤蚊","author":"范成大","text":"羽虫么魔塞区寰，造化胡为弗疾顽。\n长养污泥草木处，纵横大地山河间。\n夜声雷动人力屈，秋喙花开天理还。\n但愿江湖无白鸟，何须金鼎铸神奸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵德庄吏部休沐","author":"范成大","text":"窈窕新堂好，委蛇夜直还。\n遥知欹帽发，正奈捲帘山。\n门外客姑去，窗前人对闲。\n谁能乌帽底，尘土涴朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵项丈雪诗","author":"范成大","text":"兜罗世界三千刹，重璧楼台十二城。\n云暗峨嵋封古色，日曛鳷鹊溜春声。\n莫将蕉叶评摩诘，且撚梅花慰广平。\n更忆缑山可怜夜，怯寒谁与伴调笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵唐幼度客中幼度相别数年复会于钱塘湖上","author":"范成大","text":"西湖冰泮绿生鳞，料峭东风欲中人。\n花片不禁寒食雨，鬓丝犹那涌金春。\n江山契阔诗情在，京洛追随客梦新。\n唤取歌声不愁思，为君吹水引杯频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵耿时举王直之夜坐","author":"范成大","text":"庭叶翻翻闹，灯花粟粟秾。\n关山千里雁，风雨满城钟。\n陇上新登谷，江头旧熄烽。\n今年吾计得，安稳读三冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩甘雨即日应祈","author":"范成大","text":"天遣贤侯惠此州，随车一雨缓千忧。\n药寮坐看云穿屋，莲棹归将叶盖头。\n三伏凉来那易得，百年饱外更何求。\n合词但祝为霖手，早侍薰弦十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩送示郡沼双莲图","author":"范成大","text":"珠渊玉水折方员，涌出双莲照酒边。\n压倒小湖三级草，增光后沼两重莲。\n苕华名字元相并，桃叶根株本自连。\n好把吴歈翻楚些，杨荷新曲胜当年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩喜雨","author":"范成大","text":"使君精祷动仙灵，月御俄从毕噣经。\n昨夜云头随皂盖，今朝雨脚挂青冥。\n池光拍岸浮州宅，湖面粘天涨洞庭。\n剩采吴歈歌岁事，传归击壤调中听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩提刑游金焦二山二首 其二","author":"范成大","text":"忆曾归自雪边州，帆落中?小系舟。\n食蛤坐来期汗漫，驾鸿飞去揖浮丘。\n卧游久矣无登览，辱赠跫然有唱酬。\n寂寞东皋舒啸后，为君濡笔赋临流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩提刑游金焦二山二首 其一","author":"范成大","text":"二山巉绝照南州，俯看千樯总芥舟。\n日脚镕金浮巨浸，波声翻雪撼高丘。\n钟闻两岸诗无敌，口吸西江话已酬。\n别有英雄怀古意，他年击楫誓中流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵袁起岩瑞麦此麦两岐山黄熟其间又出一青枝亦已秀实传记所未载也","author":"范成大","text":"民和神福固其宜，况有仁先四者施。\n吴稻即看收再熟，周牟先已秀双岐。\n蕙风半老黄金穗，梅雨重春绿玉枝。\n乐不可支聊发咏，田间日日是芳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵起岩喜雪","author":"范成大","text":"吹成一雪便吹残，风伯无端岂坐悭。\n夜报飞花平瓦垄，晓惊疏雨落檐间。\n休教冻解鱼龙水，更待诚通虎豹关。\n准拟姑苏台上看，春前三度老青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵温伯纳凉","author":"范成大","text":"日斜犹畏暑，吏退合偷閒。\n霞散红绡薄，溪回碧玉弯。\n伴人惟羽扇，娱客欠风鬟。\n且复哦新句，相嘲饭颗山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵温伯城上","author":"范成大","text":"闭户成痴坐，扶藜得意行。\n楼台浮霁色，市井碎春声。\n雪尽小桥出，烟消千嶂生。\n病多无脚力，遥羡落鸿轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]