[{"title":"答颐斋诗筒走寄 其三","author":"胡仲弓","text":"绿阴团里和吟声，幽事相关雨未晴。\n莫把越秦分异见，要知李杜是同盟。\n提壶沽酒墙头报，布谷催耕屋背鸣。\n满目云山犹好在，何时鸡黍荐藜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答颐斋诗筒走寄 其二","author":"胡仲弓","text":"剪烛西窗听雨声，晓天又弄半阴晴。\n黄金坞里知无分，紫翠楼前忍负盟。\n君有砖花占日影，我惭瓦釜答雷鸣。\n今朝茹素无清供，喜得邻分玉版羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"胡仲弓","text":"红紫秾时雨未晴，每将春事叹浮生。\n谁怜绣地愁如织，我欲笺天诉不平。\n半点苍苔犹有迹，一分流水去无情。\n东君更作风光主，蝶粉蜂黄莫浪争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋玳瑁鱼","author":"胡仲弓","text":"海灵如许巧，龟贝点成纹。\n背负十三卦，旁分四六文。\n壳中藏勺水，身后管梳云。\n贵介诸公蜕，何因得似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"集芳园","author":"胡仲弓","text":"园丁严锁钥，不许俗人看。\n梅落黄金弹，荷开碧玉盘。\n小舟维柳外，青磬出林端。\n猿鹤不相识，行吟独倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪亭夜吟","author":"胡仲弓","text":"系缆堤边江水平，风来细细袭衣轻。\n淡烟几抹沙痕暗，新月一钩天际明。\n锦绣围中搜野趣，笙歌丛里和吟声。\n酒阑不尽迟留意，后约须寻李杜盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"矮道人","author":"胡仲弓","text":"白发苍颜老，孩童三尺身。\n向来阳刺史，留得道州人。\n凫膝应难续，龟趺卒莫伸。\n朝家无岁贡，流落瘴江滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腰痛","author":"胡仲弓","text":"门前齐雪立，因被病相魔。\n堪佩金鱼否，能悬宝剑么。\n折非陶令懒，瘦似沈郎多。\n已办扬州鹤，其如十万何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颐斋再作催梅诗次韵","author":"胡仲弓","text":"但是南枝尽向阳，凝寒未许暗传香。\n水边疏影空浮月，岭外孤根浅带霜。\n北帝无因全漏泄，东君何事巧遮藏。\n好将羯鼓花前报，莫待狂风破麝囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颐斋诗筒急递次韵奉酬","author":"胡仲弓","text":"一日怀人三阅秋，白鸥飞去水悠悠。\n江山磨尽古今事，风雨送来天地愁。\n蜗喜自沿商隐壁，燕归错认仲宣楼。\n笛声只在栏干曲，须向西邻高处求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端砚","author":"胡仲弓","text":"中书为尚友，铁面迫人寒。\n易得乌龙角，难逢紫马肝。\n石英能比玉，歙好不如端。\n曾记文闱内，蒙君青眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔡司业争公议而去诗以送之","author":"胡仲弓","text":"此举朝廷系重轻，先生直以去为荣。\n但令天下无邪党，不愿吾曹有令名。\n模楷昔曾宗李氏，搢绅今尽说阳城。\n是非公论从来定，少待前头风浪平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲赴缘僧道","author":"胡仲弓","text":"身在尘缘外，如何更趁缘。\n僧堂清富贵，道院小神仙。\n饭饱休持钵，丹成莫卖钱。\n但能了生死，何必问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题天海风云之楼","author":"胡仲弓","text":"欲舣扁舟约月明，倚楼少待暮潮平。\n雁边有客关新恨，鸥外无人访旧盟。\n天地能容苍海阔，风波难与白云争。\n回头便踏尘埃路，莫忘山中此段清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题水竹居","author":"胡仲弓","text":"云根无觅处，藏在此山阿。\n地僻尘缘少，心清诗料多。\n竹虚元有节，水止故无波。\n甚欲投簪去，同君住薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题叶石轩学僧寮","author":"胡仲弓","text":"静坐求心印，传经续祖灯。\n因吟呈佛句，方悟在家僧。\n芸叶熏薝卜，枝辞剪葛藤。\n自从骂师后，无话可参承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题村居壁","author":"胡仲弓","text":"何处村居好，山边况水边。\n数间茅屋下，一带槿篱前。\n绕舍千竿竹，传家二顷田。\n但求安乐法，不必问流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题金粟洞","author":"胡仲弓","text":"谁信东南有此山，几回蜡屐只空还。\n乾坤超出浮尘外，世界深藏粒粟间。\n鹤不归来华表在，犀从飞去紫云閒。\n扪萝直上凌霄塔，见说微垣手可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题桃源图 其二","author":"胡仲弓","text":"图中想像晋桃源，问著桃源不敢言。\n只道乱来无境土，谁知静里有乾坤。\n年深莫辨烟霞迹，洞古犹粘苔藓痕。\n吟杖懒随刘阮去，漫寻春色到柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题桃源图 其一","author":"胡仲弓","text":"桃溪春水绿如苔，溪上红桃夹岸开。\n乳燕掠将芳草去，子鱼衔出落花来。\n田中黍稷随时艺，雨后桑麻绕舍栽。\n此日逢人休问语，生涯闻已半蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题通妙亭柱","author":"胡仲弓","text":"小亭存古意，雅称道家风。\n池水鸭头绿，山茶鹤顶红。\n内丹还九转，法鼓叩三通。\n若问希夷事，檐铃语未终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题崇福寺青山阁","author":"胡仲弓","text":"禅馀无一事，冷面看青山。\n明月几时有，白云终日閒。\n地虚尘不到，天远手难攀。\n直下看人境，纷纷醉梦间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题清泉院","author":"胡仲弓","text":"孤僧如槁木，住处远人烟。\n山有千年寺，名因一派泉。\n堂虚遗像暗，壁败野藤穿。\n法座空尘积，无人来叩禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄耑玉寒瘦藁","author":"胡仲弓","text":"几回吟杰句，破砚几遭焚。\n古道不复作，唐风犹可闻。\n寒于梅傲雪，瘦似竹侵云。\n近世无郊岛，诗人数到君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题窗间墨竹","author":"胡仲弓","text":"一寸毛锥当小锄，新篁移傍野人居。\n难栖天上鸣阳凤，且伴窗前剔蠹鱼。\n大节肯随风俯仰，数枝长带月扶疏。\n此君本是虚心物，那更形声总是虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题溪亭","author":"胡仲弓","text":"借得溪亭一解衣，忘机燕子去来飞。\n采桑女伴携篮过，罢钓儿郎荡桨归。\n嫩草正芳鹅鸭斗，浅潮初落蟹鱼肥。\n开门坐对真山水，不信人间有是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题潘庭坚响玉集后","author":"胡仲弓","text":"陛对端平日，雄文四海传。\n一登黄甲后，多在紫岩边。\n好客时招饮，贪诗夜废眠。\n寥寥三百载，先后两庭坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薄游","author":"胡仲弓","text":"薄游归较晚，清气满丘园。\n鸦噪盘林影，蛩声咽草根。\n吟肠思茗碗，醉眼迫冰盆。\n心迹两忘处，难同俗子论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠云谷道士","author":"胡仲弓","text":"身形如野鹤，飞去每离群。\n玉磬随缘定，金丹与众分。\n渴摇花上露，卧枕谷中云。\n传得九仙诀，修真好似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈通妙","author":"胡仲弓","text":"双成亲嘱咐，从此厌尘缘。\n天上黄冠侣，人间紫府仙。\n金炉行殿晓，玉磬古坛烟。\n待得蟠桃熟，重逢又几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠岩居僧","author":"胡仲弓","text":"清閒消不尽，方觉此身尊。\n洞古少行迹，山空多烧痕。\n静知心是佛，生与佛无恩。\n斋料从谁给，频齑野菜根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠神籁谈天","author":"胡仲弓","text":"曾将甲子问群生，来向人间说五行。\n眼底精神虽晦昧，胸中造化却分明。\n指推宝历八千数，时弄玉箫三四声。\n袖里百篇题品尽，何曾识得一公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠悟上人","author":"赵汝燧","text":"怪来趋向别，乃是拙庵孙。\n秋色添禅寂，松声夺俗喧。\n路行须避蚁，饭剩或呼猿。\n单钵随缘住，寻常懒出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠谭山人","author":"胡仲弓","text":"地僻人稀到，柴门镇日开。\n依山泥药灶，累石筑经台。\n野鹤连窠买，梅花间竹栽。\n世无真隐者，只此是蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骤雨","author":"胡仲弓","text":"神龙奋头角，顷刻致风雷。\n云逐溪南去，雨从山北来。\n炎凉分枕簟，洒落满楼台。\n物物皆沾足，馀膏及草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霸王庙","author":"胡仲弓","text":"慄悍攻城大不仁，拔山力尽误终身。\n当初不学古兵法，到了翻成霸罪人。\n未造汉时知有汉，岂堪秦后又生秦。\n咄嗟气象今何在，千古空留土木神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴 其二","author":"方岳","text":"梁武欲为佛，秦皇欲为仙。\n万乘犹不足，要与天齐年。\n人生几两屐，过眼如风烟。\n此心苦无已，忧患长烹煎。\n不见客斯逐，力诋争秦权。\n宁知咸阳市，父子更相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"一志","author":"胡仲弓","text":"念头才起处，此一常分明。\n其中有主帅，谈笑驱五兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日山拜姜相遗像","author":"胡仲弓","text":"别驾元来是重臣，穷通不足累其身。\n直言悟主成遗恨，劲节如公能几人。\n泉泻冢堂垂鹤泪，苔封碑石剥龙鳞。\n至今绘像丹青手，难写灵台一点真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月八日寄懒窠","author":"胡仲弓","text":"转盼重阳在眼前，客中岁月浪推迁。\n云飞千里家何处，雁过一声秋满天。\n节近最关萱草梦，囊空犹欠菊花钱。\n瞑心九日山头路，虽不登高亦惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子经昔有黄筌玉笋图故人陈众仲题诗其上后为人易去常追忆不已余往借观临之以归郑氏并识以诗","author":"胡仲弓","text":"春雷殷殷盎中鸣，箨龙惊起头角狞。\n斓斑裂土穿石出，长镵斸下津浮玉。\n山人嗜之比八珍，画师写生传千春。\n纤纤翠交烟雨湿，山人叹嗟山鬼泣。\n玉堂修撰富才情，歌诗赞画增晶英。\n春花欲语娇倚槛，蜀锦鲁缟光可鉴。\n无端五穷睹揶揄，巧偷当面输陶朱。\n我从借观弄毫素，座间一夕珠还浦。\n自知诗尽劣陈黄，无人豪夺君无藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小吴园","author":"胡仲弓","text":"临水开门径，关防俗子来。\n竹添当户笋，梅老靠墙枝。\n岚气侵衣袂，湖光媚酒卮。\n主人全谢客，时遣鹤相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中夜闻虎啸","author":"胡仲弓","text":"日落山色黄，樵夫不敢下。\n风号万壑哀，鸟雀亦惊怕。\n人谓斑将军，此地正争霸。\n数声地欲裂，咆哮直深夜。\n道人铁石心，惯听何足讶。\n若逢万户侯，羽镞不汝赦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中闻猿","author":"胡仲弓","text":"山人犹未去，空使山猿惊。\n迎风坐枯藤，吟作长短声。\n山猿汝何知，亦有故旧情。\n人兮不如猿，冷暖随时生。\n不见求友莺，乔木长嘤嘤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中值雨偶成","author":"胡仲弓","text":"山中云气多，忽合即为雨。\n垤鹳鸣一声，毒龙戏吞吐。\n翻手覆手间，纷纷不可数。\n彼苍难致诘，阴晴竟谁主。\n此雨只在山，何以泽下土。\n阿香推不来，借我霹雳斧。\n斫破太虚空，银河漏莫补。\n风云只片时，一施天下溥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行八韵","author":"胡仲弓","text":"山行有奇观，胜处每自省。\n振策响岩石，探入烟霞境。\n洗耳听泉声，缓步踏松影。\n幽鸟吟清风，尘梦忽唤醒。\n一僧从吾游，策蹇度峻岭。\n山家喜客来，呼儿瀹新茗。\n班荆坐茅檐，款话清昼永。\n何日遂归耕，来此谋二顷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山馆对月","author":"胡仲弓","text":"山寺闻晨钟，深省静中发。\n展转睡不成，推窗看明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不碍云山","author":"胡仲弓","text":"赢得工夫看好山，吟魂飞不到人间。\n白云本是无心物，才得身高便可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丑妇谣","author":"胡仲弓","text":"人知丑妇丑，不知丑妇妍。\n丑妇安乎丑，妇德或可全。\n荆钗与布裙，常坐纺织边。\n妍妇巧于人，玉貌长娟娟。\n妩媚及依阿，万态随方圆。\n丑者妍之实，妍者丑之端。\n丑者妍之德，妍者丑之贼。\n人皆恶其丑，我以丑为则。\n人皆爱其妍，我以妍为惑。\n丁宁丑妇人，莫效妍妇颦。\n欲保丑妇德，莫学妍妇色。\n人鉴不可欺，妍丑自明白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋望月呈诸友","author":"胡仲弓","text":"长空万里琉璃滑，冰轮碾上黄金阙。\n清光烁尽满天星，桂枝摇落蟾蜍活。\n故园此夕尽翘首，望杀阴精眼沥血。\n乌鹊绕树飞且鸣，世间昼夜无分别。\n诗人兀坐冰壶中，清气萧萧透毛骨。\n玉箫何处招凤凰，更抱琵琶对风拨。\n可人来赴今秋期，共举霞觞酌明月。\n醉边且尽今宵欢，后会相望隔闽越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云思","author":"胡仲弓","text":"出岫本无心，云在意亦在。\n松桧无高枝，舒卷何所碍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双髻山","author":"胡仲弓","text":"千古丫鬟高插天，淡妆浓抹傅云烟。\n眼前不见峨眉老，独有青山长少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"包家山看桃花","author":"胡仲弓","text":"春风吹到小桃根，便觉仙凡有路分。\n紫气直冲文德殿，綵霞隔断武陵源。\n锦官城向山头出，玉跸声从天上闻。\n一见圜丘怀故土，令人寂寞暗销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时月 其四","author":"胡仲弓","text":"冬月如御史，正色凝云端。\n风霜何凛凛，一见应胆寒。\n乌飞绕三匝，禁树相团栾。\n心术晦昧人，不敢抬头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时月 其一","author":"胡仲弓","text":"春月如处女，皎皎暮云间。\n婵娟不自衒，欲见乃许难。\n春云多变态，玉貌长端端。\n封姨扫尘匣，略与幽人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时月 其三","author":"胡仲弓","text":"秋月如翰林，标致清如许。\n天上白玉堂，子独于中处。\n夜直五云边，冰壶了无滓。\n几度醉归来，安用金莲炬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时月 其二","author":"胡仲弓","text":"夏月如循吏，见者皆欢颜。\n当此烈日馀，和气一夜还。\n龚黄久不作，元在青云间。\n欲往从之游，天高恐难攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题 其一","author":"胡仲弓","text":"成蹊虽无言，妩媚随东风。\n挺挺冰雪姿，所禀自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题 其二","author":"胡仲弓","text":"篇篇剔蠹鱼，字字编科斗。\n萤小无晶光，明月入我牖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石轩席上分韵得石字","author":"胡仲弓","text":"解衣坐虚窗，夜阑万籁寂。\n月出东南隅，照我楼半壁。\n对影欲起舞，袖短不成拍。\n浩歌慰心赏，欢声动金石。\n拊栏发长啸，清风生两腋。\n吟声鬼神悲，醉眼江湖窄。\n吾自乐吾生，光阴似过客。\n物我打一块，天地失形迹。\n山鹤从何来，点破春空碧。\n我欲从之游，八荒随所适。\n戛然鸣一声，云深何处觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次傅德用府教授韵","author":"胡仲弓","text":"一握乾坤尽在望，江山好处即家乡。\n古今万事云来去，身世百年亭短长。\n梦里有时曾化蝶，吟边得意亦亡羊。\n是非宠辱浑閒事，付与天公为较量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"光风霁月","author":"胡仲弓","text":"胸怀自洒落，风月特寓形。\n造物无尽藏，何假乎丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和颐斋见寄","author":"胡仲弓","text":"胸怀拍拍贮阳秋，万里江山思远悠。\n自笑半生行酒禁，可能一日免诗愁。\n图书围里谁分榻，风雨中间独倚楼。\n除却知心吾与汝，吟边何事冀旁求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后村来书有此心如珠有物蒙之之语芸居有诗再用前韵 其一","author":"胡仲弓","text":"襟抱天样宽，万象并包函。\n富贵一虫臂，此理君饱谙。\n直语苦如荼，回味留馀甘。\n吟诗秉史笔，未数司马谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后村来书有此心如珠有物蒙之之语芸居有诗再用前韵 其二","author":"胡仲弓","text":"男儿重意气，咄咄宁书空。\n笑人愧邓禹，抵掌随臧宫。\n信是心如珠，有物蒙其中。\n非珠亦非物，点雪付炉红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"存方寸地","author":"胡仲弓","text":"此心仅方寸，去天唯咫尺。\n欲付子孙耕，先自竭吾力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]