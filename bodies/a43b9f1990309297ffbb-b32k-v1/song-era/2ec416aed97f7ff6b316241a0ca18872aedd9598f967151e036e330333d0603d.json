[{"title":"二月初十日自荻浦绝湖三首 其一","author":"赵蕃","text":"二月风涛壮，扁舟性命轻。\n白头高浪接，青眼远山横。\n客子空怀怖，渔家自乐生。\n须渠一杯酒，助我五言城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二诗敬寄致政大夫先生 其二","author":"赵蕃","text":"不向芗林去，于今又四年。\n琴书故间止，草木想苍然。\n安否音书旷，飘零日月还。\n礼加如下榻，兴尽敢回船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二诗敬寄致政大夫先生 其一","author":"赵蕃","text":"每见清江使，常询向子平。\n徐行为山健，老眼对书明。\n世共尊耆旧，愚犹及老成。\n谁人要半道，愿与一门生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日","author":"赵蕃","text":"元日虽晴人日阴，梅花如积杏花深。\n未忧盈室无储粟，且恃春风洗破衾。\n莫怪物华常草草，定缘老态日骎骎。\n不须愤泣卞和玉，何有矜誇季子金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日立春","author":"赵蕃","text":"阴已至人日，雨仍当立春。\n梅花一开谢，草色半陈新。\n节物变风物，病身成老身。\n微吟终楚调，高兴属词人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日怀成父弟","author":"赵蕃","text":"人日雨连元日阴，杜陵时节已如今。\n苔迷草色闲多思，竹倚梅花瘦不禁。\n徵事还愆退之集，题诗漫有蜀州心。\n溪南有弟遥成隔，目断苍然暮色侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人日感怀因寄玉山亲旧并以示当涂溧阳诸表弟","author":"赵蕃","text":"唐人重人日，往往见于诗。\n孰谓风流远，聊须著语追。\n凭高纵无地，念远得忘思。\n欲寄江东弟，断肠梅满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"入夜应潭对岸作示成父","author":"赵蕃","text":"溪山风月两相当，痼疾真成得秘方。\n往日同舟但饶信，祇今去路落湖湘。\n贫离亲戚古所叹，归去田园老未忘。\n试遣溪头问酒价，扫沙聊得踞胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日五日雨","author":"赵蕃","text":"小雨新凉进，遥山翠霭分。\n稻粱先告病，粟麦晚收勋。\n助尔农人喜，嗟余课子勤。\n跨驴穷有相，琢句老无闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日夜雨九日不止","author":"赵蕃","text":"中夜忽闻雨，迟明殊未收。\n都缘数日热，变此一庭秋。\n不但梅当熟，从来夏或裘。\n可怜方止酒，何日畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日雨是日期成父来已而不至","author":"赵蕃","text":"一雨毋嫌骤，炎蒸得解围。\n桃笙疏不御，蕉萐顿忘挥。\n月暗萤偷照，风清虫趣机。\n所思期不至，还是掩荆扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月二十六日雨后呈沅陵教授","author":"赵蕃","text":"秋风比已凉如水，秋日还能热似焚。\n骤对碧云成突兀，忽看快雨洒缤纷。\n梧应留响中宵听，菊为韬香九日闻。\n排遣羁愁消底物，要君诗律张吾军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十二夜至十六夜皆无月赋诗三首 其三","author":"赵蕃","text":"已失连宵望，犹馀此夕谋。\n疏明时递见，暗淡幸空休。\n无复丹梯意，居然四壁幽。\n有怀千万种，都付一搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十二夜至十六夜皆无月赋诗三首 其二","author":"赵蕃","text":"雨后凉虽在，秋中月遂孤。\n未妨疏狡兔，端恐失遗珠。\n屡起瞻云汉，还成候挈壶。\n清羸祇益苦，庭树有栖乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十二夜至十六夜皆无月赋诗三首 其一","author":"赵蕃","text":"月向中秋俟，阴从一夕愆。\n望中孤老眼，暗里耸吟肩。\n灯婢深留照，桃笙冷废眠。\n思兮在何许，有梦隔山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一日简王进之","author":"赵蕃","text":"晓枕闻檐溜，閒筇立寺门。\n宿酲连卯酒，幽趣落无言。\n山色丹青湿，梅花璧玉温。\n谁能此乘兴，风味昔人存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月二十三日","author":"赵蕃","text":"正尔元无事，胡然不自聊。\n髯衰纷若雪，梅早缀如椒。\n太白倾残榼，方炉■柿樵。\n宦才成此味，隐莫待渠招。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十五日风大作偶成四十字","author":"赵蕃","text":"江南无此风，羸疾讵烦攻。\n异事真同飓，夸辞懒问雄。\n梅犹隐荆棘，菊已堕蒿蓬。\n坐拨寒灰尽，诗成欠得工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月大雷雨","author":"赵蕃","text":"疾雷惊万里，冻雨落三更。\n未暇寻洪范，谁能究五行。\n短檠无焰续，高枕待天明。\n钟省成深省，鸡声匪恶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十七日晨起简诸公","author":"赵蕃","text":"年多病暑苦亡聊，夏忽如秋意自消。\n竹屋纸窗宵摵摵，雨条风叶晓萧萧。\n凶年未易办五斗，乐处却思甘一瓢。\n几日诗筒似疏旷，意乘聊复一长谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十九日招老谢丈","author":"赵蕃","text":"再失重阳集，才能一笑期。\n儿童闯车马，鸟雀避茅茨。\n雨后橙初熟，霜前菊未衰。\n招邀幸临顾，倾饮莫相疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十九日雨中","author":"赵蕃","text":"帆来鸟去苏州句，落木长江老杜诗。\n得意写图那办此，惊人吐句或能之。\n长年役役愁肝肾，老态骎骎入鬓髭。\n寄谢樵夫与渔子，可怜日用不能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月一日同陈明叔修绝江游古城白泉","author":"赵蕃","text":"快阁呼舟渡碧江，举篙惊破白鸥双。\n谩云择胜心如渴，不待穷幽意已降。\n试遣折梅巡野圃，少须酌茗坐僧窗。\n欲将韵语题今日，笔力输君九鼎扛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月一日因出小憩快阁而归","author":"赵蕃","text":"昨宵已辨雪中灯，今日晴来聊记曾。\n病骨可堪风似刮，衰眸自喜句如冰。\n雁因就暖长为客，鱼为逃寒返坠罾。\n北去南来勿渠叹，身今淹泊岁还仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十九日雪三首 其三","author":"赵蕃","text":"蔽天才集雨，动地忽惊风。\n苧絮潜加力，杯觞稍费功。\n山川相映发，竹树失青葱。\n幼质知难久，茅檐溜已通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十九日雪三首 其二","author":"赵蕃","text":"犬吠非因盗，鸡鸣已后晨。\n穿窗残月在，布地落花匀。\n我亦惊霜鬓，谁能念曲身。\n久晴常畏病，逢雪更忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十九日雪三首 其一","author":"赵蕃","text":"岁是明朝尽，春犹半月迟。\n人言无复雪，天意肯违时。\n宿麦争萌达，遗蝗绝类滋。\n年丰如可待，吾岂病长饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十六日","author":"赵蕃","text":"水有萦纡何自来，竹能森爽为谁栽。\n山僧乞饭朝一出，幽子题诗日几回。\n故鹤未妨频有客，骑驴正尔独寻梅。\n得閒且尽幽居趣，顾我初无当世才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月初六夜梦客溧阳半月而未见晦庵梦中以见迟为并作诗谢之首句云平生知己晦庵老岁晚方怀见晚羞寐而诊曰羁于一官久去师门精神之感形见如此耶用其句赋诗一章寄上","author":"赵蕃","text":"平生知己晦庵老，岁晚方怀见晚羞。\n题诗寄公夏始盛，遣弟持书春又浮。\n谢安东山岂我舍，迂叟洛中常国忧。\n蟠桃结实动千载，朝菌不与晦朔谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月初四夜同吴资深陈明叔宿观山","author":"赵蕃","text":"一源何自发嵌空，漱月流风昼夜中。\n故有松声杂清越，独无梅影照玲珑。\n乡人但说观山寺，客子深怀太史公。\n好事陈吴不易得，冒寒襆被肯来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十八日分谒升德庙过江作","author":"赵蕃","text":"命有丛祠事，晨兴敢惮勤。\n渚沙微隐艇，山木总藏云。\n雨势纷未已，诗材恍见分。\n中流更回首，片片愧鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十三日逆风舟行甚迟","author":"赵蕃","text":"昨夜纵风几丧生，今朝溯水颇留行。\n细看汹涌收帆脚，孰若夷犹听桨声。\n客路了知难数傲，长年谓我勿多惊。\n世间迟速元同致，莫问到衢今几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十三夜使风","author":"赵蕃","text":"雪浪涌如山，乘风失溯滩。\n穷途虽粗慰，悸魄敢怀安。\n灯闪渔家迥，雁哀江渚寒。\n怪来诗语瘦，良欠酒杯宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十三夜秉文携诗见过","author":"赵蕃","text":"餐玉我无术，点金君有方。\n胡为仍各瘦，更复问何长。\n月好桥同步，诗佳袖取将。\n归来未成寐，看叶堕危黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五夜月","author":"赵蕃","text":"老至自多感，月圆仍此秋。\n又成愁里见，都白几分头。\n酒罄妨人醉，诗穷不易搜。\n径归掩关卧，还杂候虫幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五夜玩月有怀","author":"赵蕃","text":"四海中秋月，三衢上水船。\n栖迟犹故我，飘泊记今年。\n乌有空成句，无何不具钱。\n还家知不远，飞去苦无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日出迓客","author":"赵蕃","text":"逢迎非我事，且逐众人行。\n粗识郊原趣，因兹诗句成。\n黄华菜谁主，自唤鸟何名。\n忽忆来时路，还思去日程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日夜邀二刘饶钱同成父饮","author":"赵蕃","text":"籍甚中秋月，飘然四海兄。\n诗兼淡仍泊，酒任浊还清。\n柳映萧萧影，滩闻活活声。\n明年当此夕，击柝政重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六日雨中忆梅花","author":"赵蕃","text":"莫问帆迟速，且看山晦明。\n赋诗忘意索，图画得天成。\n白发应无种，流行讵有程。\n清霜可期至，郢树合争荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十日晚风雨大作","author":"赵蕃","text":"猎猎风声万马奔，我方愁绝坐黄昏。\n了无鼠辈窥厨冷，顾有狸奴同席温。\n静里顿能除妄想，病中还欲寄空门。\n四时鼎鼎催人老，篱菊销香梅返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月三日郑秀才惠菊植之晏斋窗前尊酒偶乏与稚子烹茶作重九","author":"赵蕃","text":"旋斫寒梢缚短篱，菊窠三两带花移。\n莫嗟已落重阳后，自是江南秋到迟。\n菊开便是东坡节，酒尽空哦清昼诗。\n竹隐异时寻故事，送花常忆郑当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月晨雨","author":"赵蕃","text":"昨夕斜阳照墟落，今晨细雨暗檐楹。\n田夫荷笠趋田去，织妇连机竞织声。\n畏馁但忧瓶粟罄，怕寒聊倚鬓丝明。\n古来名士多如此，底事于予亦么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四夜元衡见过","author":"赵蕃","text":"馀酲索寞政须驱，多谢君能佩酒壶。\n回首林园重摇落，岸巾风月且须臾。\n不须相对哀囚楚，何日扁舟俱下吴。\n雅意从来在松菊，放言不用属莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四夜月 其二","author":"赵蕃","text":"镜破何年合，珠沈几日还。\n空明歙溪石，行列婺州山。\n雁泊宵仍警，虫哀夜不閒。\n传呼语舟子，移楫近前湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四夜月 其一","author":"赵蕃","text":"既夕风犹进，凌空月故迟。\n明宵纵当满，今夕可乖期。\n少壮欣逢节，年侵意自悲。\n平生一杯酒，即事五言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十四夜用立春韵","author":"赵蕃","text":"旧雪犹连雪，新春未得春。\n烧灯当变节，圆月与俱新。\n邂逅成朋饮，飘流怆客身。\n还家重萧索，山鬼闯厨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又成父弟往馀干谒赵叔遂至池阳庐陵谒二周先生长句送行","author":"赵蕃","text":"归我山中未一年，两回题子送行篇。\n况今客路飞红叶，不比春风啼杜鹃。\n东阁翘材嗟久阔，长沙夜席已喧传。\n子行历聘应兄问，并谢江东有二天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又呈庆伯","author":"赵蕃","text":"下里又寒食，寒居犹去年。\n萧条花不见，牢落病仍缠。\n强起陪亲友，题诗未究宣。\n方欣好天色，云气复油然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又简张王臣","author":"赵蕃","text":"留落殊方少故人，岂其再见愈情亲。\n几因高论兴衰飒，频藉深杯慰苦辛。\n祇道朝天在长夏，那知奉檄又残春。\n未闻行日先惆怅，君复何忧慨此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安道中二首 其二","author":"赵蕃","text":"篱落未经霜，林园尚吐芳。\n豆花连豆角，榴朵映榴房。\n摇落虽兹候，敷荣未尔妨。\n我怀收柿栗，物色自凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万安道中二首 其一","author":"赵蕃","text":"雨小亦滑道，马迟元自佳。\n金章橘弄色，玉面茶吐花。\n科科初种菜，丛丛未收麻。\n人生皆有理，吾事独无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三日风果止早行","author":"赵蕃","text":"侧枕听风吹，撑篷避雨丝。\n不忘披败帙，何暇问朝炊。\n浪静川无迹，云行山不移。\n自知非画手，游戏一于诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二日同明叔过从礼观牡丹","author":"赵蕃","text":"新晴唤我出，负郭看花来。\n窈窕栏槛入，咄嗟尊俎开。\n嫣然同午醉，老矣怕春催。\n身羡双飞蝶，翩翩去却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月八日发舟后作","author":"赵蕃","text":"沙步行初改，津亭望且遥。\n青山出图画，白鹭立风标。\n境熟诗难就，愁深酒易消。\n云归还漠漠，雨静复萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其十","author":"赵蕃","text":"世奇粤水与湘山，此地元居楚粤间。\n尽日觅诗终莫就，有时游目不能还。\n骤来遥点雨初过，忽尔数峰云自閒。\n远碧近苍元互映，浅青深绿更相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其九","author":"赵蕃","text":"晚日微风坠镜平，中流直下縠纹生。\n烟云点缀多新态，鸥鸟逢迎殆宿盟。\n聚落近于边境接，村墟亦有戍楼横。\n虽然王化初无外，接畛农桑畔不争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其八","author":"赵蕃","text":"浦口江头艇子呼，有怀逸兴恐成孤。\n非斗邮传憎尘土，自爱江山入画图。\n峰势宛如神峻拔，瀑痕浑似笔浓枯。\n顾怜文力孱非敌，剩欲追摹忽已逋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其七","author":"赵蕃","text":"春今回首便天涯，留得芳英在物华。\n野色似云閒放犊，树阴如幄暗巢鸦。\n金钱满地空心草，紫绮漫郊苦菜花。\n试考方言助多识，欲传名字入诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其六","author":"赵蕃","text":"乾溪溪侧弹子洞，薄暮过之聊且休。\n志欲山林成独往，愧无名姓继三游。\n奇奇怪怪乏画手，凿凿磷磷宜枕流。\n岩岫水泉真两得，未容石井独吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其五","author":"赵蕃","text":"既雨得晴晴亦佳，笋舆终日度咿哑。\n蒙笼篁竹四三里，髣髴茅茨三五家。\n邻舍相闻亦鸡犬，田畴随事有桑麻。\n居夷何陋惭君子，不尔辞官学种畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其四","author":"赵蕃","text":"大麦初齐积渐黄，青青小麦更连冈。\n去冬屡雪有如此，今岁一丰端可望。\n负笼不须嗟甚苦，腰镰行且看争忙。\n太仓红腐憎泥土，亦复遥思饼饵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其三","author":"赵蕃","text":"马騣岭下源初发，鹅口山前渐可舟。\n一百八盘谁谓险，二十四溪何自游。\n深厉浅揭故数数，车烦马殆真悠悠。\n惜哉当此方倥偬，不然亦足供夷犹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十七日以檄出行赈贷旬日而复反自州门至老竹自老竹至鹅口复回老竹由乾溪上入浦口汎舟以归得诗十首 其二","author":"赵蕃","text":"闻道高原尚苦乾，未妨平陆欲生湍。\n眼中乍见扶藜出，耳畔未嗟啼鸟欢。\n汉诏当知本宽大，豳诗政复著艰难。\n尔能粗得饥肠实，我亦安辞脚力酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]