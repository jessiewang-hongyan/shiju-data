[{"title":"宿蓝畬寺","author":"赵蕃","text":"岭断仍分径，林纡更著行。\n畏人嫌俗驾，留客得僧房。\n脊记年何古，吾家句亦香。\n兹行经寺五，于此独难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄公择兼问讯季益二首 其二","author":"赵蕃","text":"孺子家何在，溪边百尺台。\n句追唐甫白，词鄙汉邹枚。\n此士诚高遁，诸公谩挽推。\n因过问消息，几日送诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄公择兼问讯季益二首 其一","author":"赵蕃","text":"忆昨分携地，阴风送酒杯。\n深嗟九日菊，未说一枝梅。\n我友多贫士，夫君况茂才。\n行藏苟无愧，流落未须哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄内及儿女二首 其二","author":"赵蕃","text":"幼子未识面，吾儿无用英。\n家虽以儒奋，身欲事农耕。\n水竹为居处，布荆令女行。\n超然老夫妇，脱粟配藜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄内及儿女二首 其一","author":"赵蕃","text":"谁令未得归，不解忍长饥。\n岁晏得无感，书来何况迟。\n雁闻伤北客，梅动是南枝。\n怅望山庵竹，青青独守墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王彦博","author":"赵蕃","text":"年来困奔走，事与素心违。\n岁晏草木肃，天高鸿雁微。\n故人天外别，尺素眼中稀。\n问我还乡旆，春风当与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄处州季侍御二首 其二","author":"赵蕃","text":"已上湘祠请，犹须汉腊期。\n侧听惟此雁，发兴在南枝。\n贫已长年事，官宁向老为。\n旧闻烟雨观，犹拟和公诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄处州季侍御二首 其一","author":"赵蕃","text":"自闻开幕府，几欲走邮筒。\n便有江湖役，仍遭贫病攻。\n想多为郡乐，亦复赋诗工。\n又最淮阳课，何时用弱翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄甘叔异户曹贾季承邓南季教授二首 其二","author":"赵蕃","text":"婺女牵牛皆粤分，郁林合浦属交州。\n偶逢人向渠阳去，为寄书从八桂求。\n率土溥天非不广，剑山带水祇供愁。\n明年阙下当皆集，谁序盛山今日游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄甘叔异户曹贾季承邓南季教授二首 其一","author":"赵蕃","text":"去年舟上曲江矶，招隐无人咏桂枝。\n常恨书题苦寥阔，不堪岁月重流离。\n谁云司户官虽小，旧说訾洲前所遗。\n登临想见日成赋，寄我何当为解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘伯山","author":"赵蕃","text":"魁梧任嘲剧，短少盖风流。\n邂逅为颐解，殷勤成刺投。\n遥知江夏阁，不减仲宣楼。\n颇愿相从去，湖南兵未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远丈二首 其二","author":"赵蕃","text":"水云痛饮玉光诗，胜践那容俗子知。\n此乐祇今宁梦见，临风空尔费怀思。\n苏门长啸谁能和，赤壁成功顾已迟。\n当日唱酬谁复与，皆云骥子好男儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘凝远丈二首 其一","author":"赵蕃","text":"清时二浙湖山主，合在公家不属人。\n求去非贪镜湖赐，归来便作许由邻。\n喜闻吾党有高退，顿使幽居忘贱贫。\n想见诗题硬黄纸，更无梦到软红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕谦益卿三首 其三","author":"赵蕃","text":"诲我肱三折，思君肠九回。\n尽忠真药石，欲报异琼瑰。\n交道孰云丧，古风今未颓。\n狂言喙三尺，百罚酒深杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕谦益卿三首 其二","author":"赵蕃","text":"一尉荒山里，高名四海中。\n初非大夫逐，定自溧阳穷。\n荐士犹王政，招魂已变风。\n怀今更思古，伫立晚江空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吕谦益卿三首 其一","author":"赵蕃","text":"多谢临湘尉，书来并枉诗。\n夜吟忘夕寐，晨诵愈朝饥。\n我亦穷耽此，君仍老嗜兹。\n虽然不相弃，竟尔欲奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄在伯二首 其二","author":"赵蕃","text":"成我中兴年，朝家政急贤。\n侍臣更论荐，东阁重招延。\n子去当兹日，才惟莫与先。\n习轩经济学，于此定为川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄在伯二首 其一","author":"赵蕃","text":"积雨旱凉天，南风下水船。\n江山浑未识，鱼稻不论钱。\n在路几何日，得诗多少篇。\n何当重相见，尊酒话蝉联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄孙从之","author":"赵蕃","text":"顾使斯人墨绶腰，不知谁合上丹霄。\n得非疲瘵要摩抚，是遣循良颁诏条。\n闻道过家犹数月，尚期论荐出公朝。\n过予不作一饭去，政倚相望非甚遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄成父并帖彦博审知 其一","author":"赵蕃","text":"贫贱分离苦，飘流日月除。\n重沽分岁酒，空展寄来书。\n祖印书齐架，章泉竹绕庐。\n生涯故在此，调护合何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄成父并帖彦博审知 其二","author":"赵蕃","text":"霜落湖边路，林疏溪上居。\n向来行载酒，今日问凭书。\n一饱异初计，五言真累渠。\n故人谁我念，烦为语王徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄汤司谏","author":"赵蕃","text":"自发袁州使，侵寻复暮春。\n何人话安否，官路政艰辛。\n章贡未归客，湘沅薄宦人。\n何当一倾盖，肯作白头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄克斋舅氏","author":"赵蕃","text":"不奉书题遂一年，书犹断绝况诗传。\n兴来亦复吟哦否，读罢何当疾痼痊。\n慷慨初无伏波志，忧愁枉类屈原迁。\n使来觅我当何处，水出牂牁若个边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴吏部三首 其三","author":"赵蕃","text":"梅逐轻冰泮，春从细草生。\n孤山应最早，假日想频行。\n竹阁思贤意，菊泉招隐情。\n柰渠歌鼓竞，使我鹭鸥惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴吏部三首 其二","author":"赵蕃","text":"元日送朝天，侵寻又一年。\n无诗供猥诵，有志辱哀怜。\n茅屋苍苔合，芳洲杜若搴。\n去留俱未遂，两鬓已苍然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴吏部三首 其一","author":"赵蕃","text":"捩眼看翱翔，经年尚省郎。\n诏除应迩日，传播未遐方。\n渺渺山连蜀，滔滔水接湘。\n有怀虽昼夜，其奈道涂长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄呈寿冈先生二首 其二","author":"赵蕃","text":"我爱清江郡，端如屋上乌。\n挂冠推二老，缝掖盛诸儒。\n吴蜀书难得，荆蛮病益癯。\n飞黄去腾踏，局趣效辕驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄呈寿冈先生二首 其一","author":"赵蕃","text":"竹户与松窗，当年拜老庞。\n鬓毛霜自满，文力鼎犹扛。\n我句何堪读，公诗旧所降。\n宁闻曹与郐，可并楚三江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀大声兄弟叔文老丈兼属三王叔侄二首 其二","author":"赵蕃","text":"今代河南客，当年吏部孙。\n青毡馀翰墨，白发念田园。\n邂逅成相识，飘零忍重论。\n三王如见问，寄谢勿辞烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀大声兄弟叔文老丈兼属三王叔侄二首 其一","author":"赵蕃","text":"听雨侵阶竹，归艎入槛荷。\n天晴龟曝背，人静鸟吟柯。\n挟册弟兄对，煮茶宾客过。\n居閒在此乐，余乃事奔波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀子进昆仲三首 其三","author":"赵蕃","text":"闻道筑堂名遂初，规模浑是退居图。\n藏书自有三万轴，种橘何多二百株。\n我似杜陵宁老蜀，君如张翰已归吴。\n诗成把酒遥相属，门外北风方怒呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀子进昆仲三首 其二","author":"赵蕃","text":"雁不归时闻有行，雁南飞处更关情。\n三年有句说还往，半载无书存死生。\n莫叹河山殊举目，会须童仆为欢迎。\n四方取友吾非乏，孰若君家贤弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀子进昆仲三首 其一","author":"赵蕃","text":"晚雨催寒著破裘，官梅应是动扬州。\n相思不见苏门隐，好在当年玉局游。\n拟向会稽探禹穴，却从吴会下扁舟。\n不须幸甚门亡恙，翻到旧诗容我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀在伯三首 其三","author":"赵蕃","text":"倏尔听鸣鴂，慨然悲众芳。\n春事且衰歇，吾行可相羊。\n问年踰不惑，嘐嘐斯谓狂。\n益矣多闻友，从之道阻长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀在伯三首 其二","author":"赵蕃","text":"我苦千里役，儿荒三月书。\n役苦殆委顿，书荒廑垦锄。\n夜雨倒湖水，春耕竞田庐。\n事贵在勇决，尔胡但居诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀在伯三首 其一","author":"赵蕃","text":"沅水与湘水，合流俱洞庭。\n如何君于我，乃隔影与形。\n沧江鸥鹭野，深林兰蕙馨。\n含章斯发发，遂性逐冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀伯瑞","author":"赵蕃","text":"四海今诗伯，三衢聊署曹。\n望之甘录录，桀溺病滔滔。\n有志躬蓑笠，宁能类桔槔。\n我交天下士，如子未多遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀畏知二首 其一","author":"赵蕃","text":"忆昨题诗岁且更，路长谁与附书行。\n登楼见说同王粲，为赋悬知似贾生。\n杜老性非真傲诞，元龙气自旧峥嵘。\n天寒万物皆收敛，惟有孤松独向荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀畏知二首 其二","author":"赵蕃","text":"共旅长安暑未徂，到家忽已秋风初。\n十诗道别心期远，千里相望魂梦疏。\n驿使梅来应寄我，衡阳雁渺更愁予。\n如君乃作诸侯客，顾使谁雠东观书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀畏知二首 其一","author":"赵蕃","text":"湘山峻刻湘流深，中有骚人愤世音。\n吊古自为吾辈事，宦游端识故人心。\n别来未有音书至，岁晚勿令霜露侵。\n闻道元戎今仲举，定除尘榻伴登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀畏知二首 其二","author":"赵蕃","text":"驰檄传闻思一来，溪头几立望樯桅。\n黄花又作霜前槁，白酒空留秋后醅。\n早岁交游今孰在，暮年林壑要深陪。\n世间名宦岂不好，只恐势移成溺灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀赵南纪二首 其二","author":"赵蕃","text":"自别匡庐去，名山不再逢。\n图看白鹿洞，诗咏紫霄峰。\n泉石难名状，烟云几许重。\n巾车君傥命，襆被我斯从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀赵南纪二首 其一","author":"赵蕃","text":"闻道君先我，论交我愧君。\n长沙辱倾盖，怀玉怅离群。\n怪底书多枉，情知义薄云。\n金兰虽甚笃，药石愿时分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀徐行仲","author":"赵蕃","text":"梦想西禅寺，春阴绕夏池。\n投枝语鸟雀，叩槛出鱼龟。\n用舍平生学，嬉娱即是诗。\n觅公端不晚，江涨即东之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李处州","author":"赵蕃","text":"近别遂累日，逢人空附书。\n虽能道所以，未辱报何如。\n千里江山外，一春风雨馀。\n梦成同泛宅，起欲命篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李宁卿","author":"赵蕃","text":"不寄来南录，但传多景诗。\n长安分袂后，湘水寄书时。\n我欲归三径，君方闻四驰。\n未知回首地，宁有盍簪期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李舒州 其二","author":"赵蕃","text":"剩欲题诗诗不成，遣人空复附书行。\n言边讵止寒温事，纸上胡能底里倾。\n以我向公深有托，知公于我未忘情。\n扶持未可言门户，老大相看祇弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄李舒州 其一","author":"赵蕃","text":"剩欲寄书兼寄诗，病馀殊觉不能支。\n西山南浦风前恨，皖水灊山天外思。\n四海旧知宁我识，百年深契舍公谁。\n自违门第秋重老，华发萧萧异别时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄进贤令程可久","author":"赵蕃","text":"博士湖边初拜公，后来超化信常通。\n一官何意偶同隶，千里长怀几望风。\n墨绶于今天下半，弦歌谁复古人中。\n双鱼敬遣问无恙，目极春江鸿堕空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈择之","author":"赵蕃","text":"几向图经问水源，未知蜀道远如天。\n书题无自寄鸿雁，鸟语不堪闻杜鹃。\n已自草堂参句法，更于锦里醉风烟。\n使行万里无空反，乞与新诗到处传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周允升","author":"赵蕃","text":"竟孤春碧醉梅前，犹喜囊中有和篇。\n雪后晚风衡岳路，雨馀秋色五溪边。\n一书寥阔忘重寄，小别侵寻过半年。\n赖是时从安道逸，有时共说伯仁贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周内翰","author":"赵蕃","text":"一自春风辱报书，后来安否定何如。\n江山我敢涪翁后，事业公真六一馀。\n百年半途过九十，千间大厦岂无庐。\n不知蹀躞天街马，孰愈崎岖经壑车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周文显二首 其二","author":"赵蕃","text":"白雪郢中少，青蝇楚国多。\n知音自古尔，谗口奈渠何。\n皎皎宁遭污，冥冥岂畏罗。\n秋风下庭叶，乃见贯时柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周文显二首 其一","author":"赵蕃","text":"我敬周夫子，安贫得士常。\n眇然居陋巷，隐若卧襄阳。\n应对昔为役，滞濡今阻方。\n虽惭寿陵步，犹拟旧君傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周昭礼","author":"赵蕃","text":"都城饮别四年馀，寥阔无因问起居。\n闻道客游犹往昔，不知生理比何如。\n谩从诗卷追还往，肯向书筒计密疏。\n折得梅花睇江水，驿程千万渺愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周畏知","author":"赵蕃","text":"书疏虽能数，飘零可奈何。\n每怀谈绪远，更益鬓丝多。\n治行今难及，声名保不磨。\n公宁免腾踏，我乃愿婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄周愚卿昆仲","author":"赵蕃","text":"四时佳节惟重九，况接君家鸿雁行。\n乃以病躯亲药石，坐妨山屐共壶觞。\n别来忽忽春逾仲，望极悠悠昼莫常。\n想见回头登眺地，清源云合鹭洲长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄审知并属彦博三首 其三","author":"赵蕃","text":"豫章稠众木，孔翠逐群飞。\n梁栋期终用，文章莫露机。\n枉为时俗忌，空使寸心违。\n语以王郎子，因来答是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄审知并属彦博三首 其二","author":"赵蕃","text":"地迥林逃斫，湖深水易平。\n邻多为圃住，门有趁虚行。\n游钓昔爱此，林庐曾属情。\n谁欤二亩乞，已矣一枝营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄审知并属彦博三首 其一","author":"赵蕃","text":"病榻论诗罢，僧舆趋驾归。\n倦书疏竹几，多梦绕湖扉。\n赤叶霜前坠，黄花雨后稀。\n直堪凋鬓发，何祇减腰围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄建宁韩尚书二首 其二","author":"赵蕃","text":"宰席犹虚位，尚书合赐环。\n进贤同拔茹，去佞已无山。\n诰命从天下，延登指日间。\n蕲公为大厦，我亦会欢颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄建宁韩尚书二首 其一","author":"赵蕃","text":"今代韩夫子，频年刺两州。\n官崇古常伯，地重汉诸侯。\n父老记茂宰，山川皆昔游。\n悬知里闾化，不待教条修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄明叔","author":"赵蕃","text":"闻道南池上，日来幽事多。\n株株摇弱柳，柄柄出擎荷。\n长夏端能好，新诗况可歌。\n无庸问凡楚，一以付无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄明叔且示逸远","author":"赵蕃","text":"别我已似久，起予当有诗。\n筠窗坐风雨，儿辈乐埙篪。\n归日近休日，春时盛此时。\n观山仍快阁，太史昔幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林运使三首 其三","author":"赵蕃","text":"忆昨登门误取知，再焉犹复似当时。\n已容尽醉尊中酒，更辱频询别后诗。\n落落有怀那得写，悠悠重见果何期。\n南山幸迩朝天路，准拟追随竹马儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林运使三首 其二","author":"赵蕃","text":"门第违离又一冬，素书寥阔便艰通。\n身随回雁辞湘水，官许骑驴看华峰。\n人笑半生耽落拓，自欣三径著疏慵。\n顾惭囊粟无功受，勤动终年是老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林运使三首 其一","author":"赵蕃","text":"番禺城下牂牁水，亦复分流过此州。\n使节长瞻万里外，尺书忽到五溪头。\n酸寒应念卑堪说，奇胜聊云旧所游。\n岭海滞公犹未召，蛮荒著我更何尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":49405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]