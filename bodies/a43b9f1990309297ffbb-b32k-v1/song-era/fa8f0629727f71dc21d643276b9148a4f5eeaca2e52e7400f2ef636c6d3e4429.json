[{"title":"借邻家瑞香","author":"钱时","text":"光风霁月瑞香盘，岁岁元宵锦作团。\n春到山家今几许，不妨邻舍借花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭顾平甫前韵","author":"钱时","text":"郊原几度踏春晴，此日空山草木春。\n泪尽两行悲不尽，眼前安得见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐山赤县距修门不二百里土风俭朴专务桑麻余甚乐之成二绝 其一","author":"钱时","text":"深深涧谷唐昌县，莽莽桑麻古歙风。\n但得长官能阜俗，不消此外别言功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐山赤县距修门不二百里土风俭朴专务桑麻余甚乐之成二绝 其二","author":"钱时","text":"每到西湖辄黯然，山川草木亦雕镌。\n如何咫尺唐山地，混沌犹存一罅天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐簿饷乌饭八月八日","author":"钱时","text":"红姜黑饭荐珍羞，愧尔瞿昙老比邱。\n先圣儿孙今满地，有人能记诞弥不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悯海棠","author":"钱时","text":"海棠前日满枝红，一夜飘飘卷地空。\n多少荣华驹过隙，莫教容易负东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雨","author":"钱时","text":"一路悭悭五日晴，晓来烟雨又笼春。\n蓬窗只是添诗句，烟雨何曾恼得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃村寄题三首 其三","author":"钱时","text":"处处桃花处处村，盎然天地一家春。\n不须更踏桃村路，只要桃村见主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃村寄题三首 其二","author":"钱时","text":"白云深处锦成堆，游子逢春定一来。\n会得四时春不断，桃村何日不花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃村寄题三首 其一","author":"钱时","text":"春入桃村烂熳红，纷纷来觅武陵踪。\n武陵不在千山外，只在先生一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烧香客","author":"钱时","text":"满路敲金插綵旗，此时心事即良知。\n回头肯向慈庭用，念念吾亲定不欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓶插月桂衮绣毬甚丽","author":"钱时","text":"月桂闹装红欲滴，绣毬圆簇白如霜。\n我无艳眼相酬答，付与庭花自在黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留青阳游九华寄袁仓使","author":"钱时","text":"元自与山无半面，昔人诗里旧相知。\n西风吹上千岩顶，竹杖芒鞋住几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起掇黄花数本焚香清坐二首 其二","author":"钱时","text":"碧玉枝头玉露漙，风霜晚节要人看。\n生香正色慇勤意，肯入冬窝共岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起掇黄花数本焚香清坐二首 其一","author":"钱时","text":"秋风雕鹗刷天涯，有底男儿只恋家。\n病后暂收文字眼，焚香清坐看黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真应庙","author":"钱时","text":"浪誇骑鹤上清都，滴露研朱自壮图。\n海内不蒙君子泽，独遗石碣溉丹湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"笑指轩","author":"钱时","text":"笑指岩前石怪奇，几人来此认桃溪。\n回头便是桃溪路，莫向儿曹指处迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷花入梅阴中","author":"钱时","text":"老梅临沼绿阴阴，一朵荷花透入林。\n不比世间红粉面，结交真有岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"起潜观心四绝词旨俱胜仍用非字奉酬以尽愚衷 其二","author":"钱时","text":"浑然天爵本无非，过眼荣华亦已微。\n忆得古人诗一句，锦城虽好不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"起潜观心四绝词旨俱胜仍用非字奉酬以尽愚衷 其四","author":"钱时","text":"雾霭溟濛山缥缈，江波浩荡雨霏微。\n头头总是吾家事，更要回归定失归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"起潜观心四绝词旨俱胜仍用非字奉酬以尽愚衷 其三","author":"钱时","text":"耻过如何更作非，观心须识动之微。\n一朝透脱无疆界，处处吾家不用归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"起潜观心四绝词旨俱胜仍用非字奉酬以尽愚衷 其一","author":"钱时","text":"休论人是与人非，会得观心过亦微。\n汎滥此生长似旅，天寒日暮是谁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"假山","author":"钱时","text":"终日劖镌弄假山，栽花种草尽班班。\n从前多少真山水，可笑傍人只等闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄家书有怀岁寒五友二首 其二","author":"钱时","text":"想得瑞香花日多，水仙消息又如何。\n篱边尚有馀香不，兰茁新芽长进么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄家书有怀岁寒五友二首 其一","author":"钱时","text":"坐拥云根兴未涯，江楼时复梦归家。\n庭前一点梅初破，近日新添几个花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","co