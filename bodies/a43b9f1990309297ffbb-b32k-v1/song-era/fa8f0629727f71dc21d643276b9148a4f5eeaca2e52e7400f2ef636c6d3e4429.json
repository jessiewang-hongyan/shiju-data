cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答振父","author":"钱时","text":"老生便作老生涯，不羡漫花顷刻花。\n身在山林心在国，太平风露是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢守和章及先天之旨","author":"钱时","text":"未消着眼到潜虚，那复谈经上石渠。\n会得先天无别旨，困眠饥饭更求馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"超然","author":"钱时","text":"结茅山顶得超然，莫也超然在外边。\n要识老夫行乐处，鸢飞鱼跃总吾天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道庵小憩","author":"钱时","text":"石径柴门屈曲通，拂檐疏竹弄微风。\n等闲光景无人管，两树金沙相对红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感蛙","author":"钱时","text":"翠蟾戛戛闹黄昏，反手为妖覆手祥。\n明月夜光遭按剑，可怜箕子学佯狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"数日不登蜀阜梅盛开二首 其二","author":"钱时","text":"一自梅边惹著春，山川草木顿精神。\n晚来风起香无际，认得香根有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"数日不登蜀阜梅盛开二首 其一","author":"钱时","text":"剩觉工夫通草圣，略无闲暇问花神。\n国香早是将春到，也趁梅花候主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭风玉与安素相应","author":"钱时","text":"的然同德定同声，鼓瑟吹竽尽未平。\n悬玉两窗非有约，如何风动一齐鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭观菊二首 其二","author":"钱时","text":"日融香煖闹枝头，绕砌回环看不休。\n莫把此花容易看，东篱无菊不成秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭观菊二首 其一","author":"钱时","text":"碧天无际细浮香，浅白深黄未著霜。\n莫恨花开秋向晚，晚秋方是好风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭晚步","author":"钱时","text":"单衣轻箑晚徘徊，嫩绿深红锦作堆。\n杨柳溪头风力软，腾腾飞絮过墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新亭薄暮","author":"钱时","text":"读罢羲经笑倚空，蜀溪溪上蜀溪翁。\n诗成断雨流云外，人在光风霁月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起","author":"钱时","text":"雨浥蒲风晚更凉，数花薝卜净生香。\n高眠深稳清无梦，尽觉人间白昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡起即事","author":"钱时","text":"梦破幽窗午漏长，岁寒心事只寻常。\n一声谷鸟穿林出，数点梅花满院香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜗牛","author":"钱时","text":"雨浥蜗牛绕砌行，与吾同乐本同生。\n挤排蛮触分疆界，可笑蒙庄自起争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉兴天庆观梁朝桧","author":"钱时","text":"五季干戈满地讧，山川草木亦酸风。\n如何偃蹇梁朝桧，独寿中吴雨露中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]