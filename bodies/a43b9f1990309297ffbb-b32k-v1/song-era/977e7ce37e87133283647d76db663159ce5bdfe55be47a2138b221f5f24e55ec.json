[{"title":"题武夷冲佑观一首","author":"王阮","text":"九摺湍溪九摺山，玉簪罗带互回环。\n若为脱得红尘网，来结疏茆一两间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题淡岩一首","author":"王阮","text":"浯溪已借元碑显，愚谷还因柳序称。\n独有淡岩人未识，故烦山谷到零陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题惠山泉一首","author":"王阮","text":"惠山泉似雪初消，不数松江第四桥。\n解挹清泠洗氛祲，何时再有李文饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题瑞昌良田寺览秀轩一首","author":"王阮","text":"无心轩冕难招我，到眼云山辄起予。\n不必凭栏更清赏，此身元在此山居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠尹氏子一首","author":"王阮","text":"有儿聪慧了群书，底用金门与石渠。\n幸甚先生矜小友，一言端以正其初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日有感一首","author":"王阮","text":"举国无人分智囊，满川龙血战玄黄。\n百年驯致文明地，一日尽为荆棘场。\n关辅渴思王镇恶，蜀人尤喜杜黄裳。\n小臣试草中兴颂，准拟还京奉上皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日独泛松江一首","author":"王阮","text":"松江牢落一舟归，中有人惊岁月违。\n太一自期莲叶是，白衣何恨菊花非。\n水收四面郊原阔，霜入千山草木稀。\n已分沧洲付吾道，便应从此下渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日途中有感一首","author":"王阮","text":"九日登高是故常，只今何事负年芳。\n紫萸欲佩凭谁系，黄菊无人只自香。\n开拓愁边须酒阵，包罗风景入诗囊。\n遥应亲老持杯夜，肴核横陈画烛光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日陪金市诸友登高阳山二首 其二","author":"王阮","text":"读书怀古恨难逢，不谓斯时乃有公。\n心自对谈名利外，士知增价品题中。\n一樽此地论文乐，三径何年结社同。\n待得尘踪去留决，别将消息寄东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日陪金市诸友登高阳山二首 其一","author":"王阮","text":"途穷已负菊花期，尚得诸公慰所思。\n不遣白衣持酒至，共将乌帽入风吹。\n紫萸秋浅浮觞少，黄叶山高策杖迟。\n却恨社中人阙一，未将汤饼共追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月过西林一首","author":"王阮","text":"似应沙鹭有前期，装点秋原景最宜。\n落雨败梧随沆瀣，牵风寒藻舞沦漪。\n流旋碧玉渠初满，剥尽黄花稻已衰。\n海里是非休苦恼，不如学取步兵痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日青龙道中一首","author":"王阮","text":"身倦寻春事，心怀结夏清。\n犹临曲水序，莫续丽人行。\n世态与吾异，生涯何日成。\n殷勤独相送，江上午潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳日雁叉阻风呈宋彦起一首","author":"王阮","text":"往来定是一年一，时节长逢三月三。\n天气未佳宜且住，树犹如此我何堪。\n花飞与客浑无与，酒好招人只自惭。\n安得惠风和畅景，与君方棹看淮南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广中二首 其二","author":"王阮","text":"南来风土已安之，事已当还敢故违。\n铜柱略无功可录，玉关空幸死前归。\n眼看馀剂怜犹在，力凭征鞍觉尚微。\n此去上还官印绶，却来传授祖师衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广中二首 其一","author":"王阮","text":"黑金不肯化青金，奉命来催胆水淋。\n山骨旧疑天凿透，沟流唯待雨来深。\n丹无九转如方士，政有三官出上林。\n却谢黄茅除白发，为酬平日做僧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广中南华寺一首","author":"王阮","text":"一水透南粤，高人忆老卢。\n如何拈不起，只为本来无。\n匍匐三千里，披攘五百徒。\n都来些子事，焉用尔区区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云居还值旱怀旧游寄杨文仲二首 其二","author":"王阮","text":"四野尽龟兆，一天常火云。\n夜凉清似水，昼旱气如焚。\n龙懒浑无用，天高寂不闻。\n我无田可虑，只虑众纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云居还值旱怀旧游寄杨文仲二首 其一","author":"王阮","text":"忆扶湘竹杖，共扣赵州关。\n山好不容住，水流今载还。\n却从天上下，似出镜中间。\n笑问杨夫子，何时再得闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农题吉祥寺一首","author":"王阮","text":"傍石寻幽径，穷原得梵城。\n潮声四面合，山色一团清。\n农合巡门劝，僧烦倒屣迎。\n明年吾更健，来伴此中耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长风沙次宋丈韵一首","author":"王阮","text":"已将身世等河沙，又泛春江看浪花。\n锦缆牙樯君送酒，蓑衣蒻笠我浮家。\n淹留日觉青春暮，飘泊风兼细雨斜。\n安得昆崙能探水，试教来奏小琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙午寒食题净土寺一首","author":"王阮","text":"方见繁红绣小园，已随流水泛前村。\n人于醽醁真无分，雨共鞦韆似有冤。\n投老故应诸事懒，问春能得几分存。\n不须便作匆匆散，更把松梅子细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰亭一首","author":"王阮","text":"金行中否野多遗，越禊诸贤不受羁。\n天朗气清书上巳，春行秋令纪当时。\n九原寂寞不可作，一水萦回或在兹。\n归去庐山定相问，为公关报紫霄知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日见桃一首","author":"王阮","text":"梅意犹藏萼，桃腮已放花。\n地疑时候恶，律恐统元差。\n寒涨渔舟水，春明道观霞。\n老来无赏玩，痴坐惜年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出丰城一首","author":"王阮","text":"摇摇旌旆出洪都，弥望田畴总废墟。\n羸马不前身突兀，耕夫相视笑轩渠。\n倚松茅屋斜开径，近水人家半卖鱼。\n蒲叶向冬犹未割，临风遥忆路温舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊访沈洞主一首","author":"王阮","text":"抖擞尘埃暂出郊，一藤先访羽人巢。\n风翻翠浪催禾穗，秋放殷红著树梢。\n万里家山怀五老，千年活计却三茅。\n明朝便好乘风去，不学浮屠更打包。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北固山望扬州怀古","author":"王阮","text":"北固城高万象秋，烟竿一缕认扬州。\n试乘绿涨三篙水，要见朱帘十里楼。\n泪湿宫衣朝雾重，愁熏塞草夕阳浮。\n隋堤旧事无人问，两两垂杨系客舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜时有感一首","author":"王阮","text":"篱边方对菊花黄，又报文移出草堂。\n三宿敢云桑下恋，四翁终愿橘中藏。\n泉萦去路常低咽，酒向离亭不肯香。\n圣代多才焉用我，明年重上乞身章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙门寺一首","author":"王阮","text":"傍石寻幽径，穷源得梵城。\n塔光侵地发，龙气逼山清。\n是处堪吾老，何年遂此生。\n霜林知客意，一夜战秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙舒朱献宾主汉阳簿弃官以归予亦不合丐去为赋一首","author":"王阮","text":"浪作鸾栖去，惊随鹤怨还。\n无心汉江水，有节皖公山。\n此事真堪话，诸公宁厚颜。\n嗟予亦兴尽，昨夜已投闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙塘久别乘月再到奉呈同社一首","author":"王阮","text":"龙塘畴昔擅云烟，破月重来倍爽然。\n浮玉北堂三万顷，扁舟西子二千年。\n青山识面争迎棹，白鹭知心不避船。\n华发翛翛更何往，一茅终在此桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"传舍中竹一首","author":"王阮","text":"浪蕊浮花不足看，岁寒独与此君观。\n箨龙满野今千变，翔凤何时下一餐。\n日对吏文潇洒在，天生官地保全难。\n明年我亦江湖去，尚祝同年乞钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游用前韵一首","author":"王阮","text":"十年不到此祇园，又为支郎暂出村。\n犬认行踪增踊跃，燕惊离恨苦埋冤。\n鬓边但觉新丝长，壁上惟馀旧墨存。\n但问桑麻添几许，世间万事不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春示陈元达一首","author":"王阮","text":"北陆藏冰后，东风入律和。\n梅因三弄少，麦赖六花多。\n簪盍思喧马，灯游羡闹蛾。\n躬耕吾不倦，其奈没田何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感再作三首 其三","author":"王阮","text":"石壁连绵静，松风自在清。\n只知有此乐，不谓老于行。\n室鵩从何入，山猿累尔惊。\n回天谁有力，祗愿效渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感再作三首 其二","author":"王阮","text":"顿觉衰残甚，难胜委寄隆。\n惊惶牛喘月，怅望马依风。\n忍看丹炉坏，终怜蕙帐空。\n明年花慢发，待我转来红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感再作三首 其一","author":"王阮","text":"出去梦中事，归来醉后醒。\n外贪垂老佚，中乐放心宁。\n花气窗前入，禽声枕上听。\n自怜无此分，明日又飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次陆务观韵寄王景文一首","author":"王阮","text":"朔风摇楚水，国步益艰辛。\n往事忽成梦，逆胡何日臣。\n凡今天下士，皆昔座中人。\n尚被中原发，烦君与正巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶教二首 其二","author":"王阮","text":"汩汩诚甘分，空空敢自珍。\n乐虽思泮水，愚恐累溪神。\n怨谤从馀子，称扬独故人。\n功名非我事，自是葛天民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵叶教二首 其一","author":"王阮","text":"但有形如槁，元无货可珍。\n四方长逆旅，一念即明神。\n漫仕缘将母，非材敢教人。\n无功叨廪禄，祗觉蠹吾民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵庸斋纳凉一首","author":"王阮","text":"招提竹钥不曾关，容我追凉突兀间。\n石甃阴生寒水玉，天灯烁散火云山。\n葛巾当昼何庸脱，葵扇非秋却暂闲。\n所愧岑参聊尔耳，强将诗与少陵班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次德和韵寄谈李二丈二首 其二","author":"王阮","text":"喜脱诸公忌，愁违李与谈。\n离群江以北，吊影楚之南。\n世故更千万，心朋只二三。\n果能容我与，终共结茆庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次德和韵寄谈李二丈二首 其一","author":"王阮","text":"心在淮山下，身行湘水中。\n喜抛馀子去，恨不故人同。\n旧隐劳征梦，浮名任化工。\n衡阳春渐暖，终欲伴归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池阳道中一首","author":"王阮","text":"日月狂风里，悠悠小艇还。\n绕身衣带水，堆眼剑铓山。\n岁月吾生老，烟尘客路艰。\n一天霜气重，今夜碧芦湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过东林吊沈文伯一首","author":"王阮","text":"苕霅虽幽事，燕云亦壮游。\n宁虞就日馆，不返度淮舟。\n死节千年在，私家万事休。\n重来联句地，清泪接溪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余门罗雀久矣今日池内有鸥戏为小诗呈叔夏一首","author":"王阮","text":"门冷人谁到，机忘物自知。\n旧来罗雀地，今是狎鸥池。\n身静红尘远，心闲白日迟。\n本来无事说，拈出戏为诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佚老堂二首 其二","author":"王阮","text":"摆落钓衡地，追寻汗漫期。\n马闲无用处，鸥玩不惊时。\n人朴山林古，天全日月迟。\n可无刘白伴，时献午桥诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佚老堂二首 其一","author":"王阮","text":"洛中九老后，林下一人高。\n此去自当佚，向来诚独劳。\n东湖归践履，南浦荐风骚。\n尚念匈奴在，家山未可褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庐山太平宫一首","author":"王阮","text":"贝阙岧峣不可攀，遥分绛节下人间。\n起元立道几千岁，择胜栖神第一山。\n膏雨应时丰绿野，真风与世养朱颜。\n山前老叟非仙骨，怅望丹崖藓篆斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庐江道中二首 其二","author":"王阮","text":"老大添身倦，飘零减性豪。\n路尘知旱苦，山瘦觉秋高。\n若有持衡分，惭无汗马劳。\n九原如可作，公瑾笑吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庐江道中二首 其一","author":"王阮","text":"处处云山异，时时气象同。\n官程严有限，王事冗无穷。\n晚色烘西日，霜威酿北风。\n人生真梦幻，底用苦匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投吏部汪书一首","author":"王阮","text":"铨选仍多弊，今年得伟人。\n衣冠归藻鉴，草芥倚阳春。\n冢宰天官贵，山公启事新。\n请收才杰士，预作凤池宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投周益公三首 其三","author":"王阮","text":"公相昔宜避，公闲今可从。\n分无先睹凤，情有后凋松。\n一瓣今拈出，三熏敢不恭。\n谁书御李事，为我赞登龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投周益公三首 其二","author":"王阮","text":"有锦虽当昼，无心侈赐铭。\n筇拖云际绿，箬戴雨中青。\n国老甘乡老，台星复客星。\n不须添入画，麟阁自图形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投周益公三首 其一","author":"王阮","text":"洛中九老后，林下一人闲。\n藓篆易钟鼎，泉声先佩环。\n禅从止水定，诗挽正风还。\n却为午桥惜，惜无螺浦山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧洲阁集句二首 其二","author":"王阮","text":"洲岛骤回合，冥冥菰蒲中。\n清流中落乌，遵渚有归鸿。\n水作青罗带，脚踏赤鲩公。\n蓬壶虽辽绝，长啸激清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧洲阁集句二首 其一","author":"王阮","text":"沧洲有奇趣，吾道付沧洲。\n树景中流见，船灯照岛幽。\n转思江海上，却著土山头。\n野水无人渡，乘桴学圣丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和戴倅韵寄苗侯一首","author":"王阮","text":"灵壁归师愤已平，黄河戍役又虚声。\n人言万事总由命，天设五材难去兵。\n国有典刑元老在，地无形势大江横。\n西风若得淮南信，烦致空山慰客情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奔牛闸遇使者议和一首","author":"王阮","text":"浩浩水千里，层层堤几重。\n谁为此过颡，曲障尔朝宗。\n浪散忽成雪，潭昏那见龙。\n浮山何足论，圣德务含容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏泛月一首","author":"王阮","text":"夜来谁共泛灵槎，飞上牵牛织女家。\n但觉满身天雨露，绝无一点世尘沙。\n秋将寒玉清风阵，月借镕银泼浪花。\n投晓归来互相告，等闲休向俗人誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌国偶成一首","author":"王阮","text":"诸邑皆山可夜驰，海中昌国力难施。\n风潮阻渡由天地，期会申严限日时。\n愿以老身从此免，忍将人命逼诸危。\n交门山下须臾死，肉食诸公知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舍弟挽余为灯火计已而余出夜梦其以诗来感叹赋一首","author":"王阮","text":"吴头望楚尾，两处各穷愁。\n万事吾皆失，三冬汝自修。\n人情千仞险，春事九分休。\n梦断依然处，天涯一钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊居即事一首","author":"王阮","text":"涉世足悔吝，杜门安退藏。\n谤从闲处省，乐向静中长。\n薜荔日缘壁，琅玕春透墙。\n近来无事作，浑以醉为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金市大水一首","author":"王阮","text":"日气方穿户，风潮忽及门。\n郊原雨脚密，窗牖浪花翻。\n船系家家屋，帆飞处处村。\n江南一羁客，微命托乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭题咏十一首 其一 宿灵佑观谢沈君","author":"王阮","text":"凤翅出沧溟，扁舟过洞庭。\n银河万顷白，螺髻两山青。\n凡隔幽墟洞，神传岳渎经。\n不须寻上界，只此是青冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭题咏十一首 其二 宿灵佑观谢沈君","author":"王阮","text":"水远通天上，山浮似海中。\n四围银色界，一簇画屏风。\n秋熟渔樵市，云连佛老宫。\n我来迷所指，多谢主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日寄舍弟一首","author":"王阮","text":"一从婚宦别家乡，又见西风雁作行。\n卧念昔言乘款段，梦寻新句得池塘。\n猿惊鹤怨草三尺，楚尾吴头天一方。\n归去儿童定相笑，秋容已上鬓边霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送沈侍郎二首 其一","author":"王阮","text":"献纳论思玉笋班，间因忠谠忤龙颜。\n一朝锦水连江水，万里何山与卞山。\n道大可能忘济世，名高那得镇投闲。\n天教一似苏门下，先到筠阳却诏还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":15075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]