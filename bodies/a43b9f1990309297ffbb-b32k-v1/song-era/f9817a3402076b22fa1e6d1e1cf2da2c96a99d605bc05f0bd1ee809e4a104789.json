[{"title":"春日过上天竺","author":"朱熹","text":"竺国古招提，飞甍碧瓦齐。\n林深忘日午，山迥觉天低。\n琪树殊方色，珍禽别院啼。\n沙门有文畅，啜茗漫留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙戊戌七月廿九日早发潭溪西登云谷取道芹溪友人丘子野留宿因题芹溪小隐以贻之作此以纪其事","author":"朱熹","text":"我来屏山下，奔走倦僮仆。\n亭亭日已中，冠中湿如沐。\n访我芹溪翁，解装留憩宿。\n茗碗瀹甘寒，温泉试新浴。\n抖擞神气清，散步支筇竹。\n芦峰在瞻望，隐隐见云谷。\n顿觉尘虑空，豁然洗心目。\n君居岘山西，高隐志不俗。\n窗几列琴书，庭皋富花木。\n往来数相过，主宾情意熟。\n开樽酌香醪，謦欬话衷曲。\n从容出妙句，满幅粲珠玉。\n邀约登赫曦，襟期伴幽独。\n兹游得良朋，道义推前夙。\n扁字为留题，深愧毛锥秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华盖石","author":"朱熹","text":"醉扶藜杖少盘桓，四远烟萝手自扪。\n此石至今无处问，祇因来自太微垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭德源","author":"朱熹","text":"景幽人迹少，惟有此源长。\n水接天池绿，花分绣谷香。\n僧闲多老大，寺古半荒凉。\n却怪寻山客，何由到上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山双剑峰二首 其一","author":"朱熹","text":"山神呵护宝云遮，俨若腾空两镆铘。\n光彩飞名镇千古，望中肝胆落奸邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐山双剑峰二首 其二","author":"朱熹","text":"双剑峰高削玉成，芒寒色淬晓霜清。\n脑脂压眼人高卧，谁斩天骄致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹤鸣峰","author":"朱熹","text":"不见山头夜鹤鸣，空遗山下瀑泉声。\n野人惆怅空无寐，一曲瑶琴分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"狮子峰","author":"朱熹","text":"石骨苔衣虽赋形，蹲空独逞忒狰狞。\n威尊百兽终何用，宁解当年吼一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登福山远眺","author":"朱熹","text":"迢迢百里外，望望皆闽山。\n皎日中天揭，浮云也有闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次牧马侯庙","author":"朱熹","text":"此日观风海上驰，殷勤父老远相随。\n野饶稻黍输王赋，地接扶桑拥帝基。\n云树葱茏神女宝，岗峦连抢圣侯祠。\n黄昏更上丰山望，四际天光蘸碧漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何君飞仙","author":"朱熹","text":"大地何人凿小空，翛然一榻卧相容。\n巨灵擘破三千丈，西竺飞来第二峰。\n出洞风来疑有虎，藏舟夜半忽乘龙。\n怪来索我题诗句，稽首何君六石供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇真观","author":"朱熹","text":"磴道千寻风满林，洞门无锁下秋荫。\n紫台凤去天关远，丹井龙归地轴深。\n野老寻真浑有意，道人谢客亦何心。\n一樽底处酬佳节，俯仰山林慨古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北双剑峰","author":"朱熹","text":"双剑名峰也逼真，品题拍拍满怀春。\n铅刀自别干将利，折槛应须表直臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿洪亭长家","author":"朱熹","text":"才到秋来气便高，雁声天地总寥寥。\n客怀今夜不成寐，风细月明江自潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对菊","author":"朱熹","text":"解印归来叹寂寥，黄花难觅旧根苗。\n祇缘三径荒凉后，移向洪门不姓陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题东屿书房","author":"朱熹","text":"书房在东屿，编简乱抽寻。\n曙色千山晓，寒灯午夜深。\n江湖勤会面，坐卧独观心。\n秋浦瓜期近，何当寄此吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其一","author":"朱熹","text":"一曲移舟采涧芹，市声只隔一江云。\n沙头唤渡人归晚，回首芦峰月一轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其二","author":"朱熹","text":"二曲溪边万木林，水环竹石四时清。\n渔歌棹入斜阳里，隔岸时闻一两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其三","author":"朱熹","text":"三曲舟行龙尾滩，推蓬把酒见南山。\n回头点检仙踪迹，万顷白云时自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其四","author":"朱熹","text":"四曲烟云锁小楼，寺临乔木古溪头。\n僧归林下柴门静，麋鹿衔花自在游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其五","author":"朱熹","text":"五曲峰峦列翠屏，白云深处隐仙亭。\n子期一去无消息，惟有乔松万古清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其六","author":"朱熹","text":"六曲溪环处士家，鼓楼楼下树槎枒。\n龙去潭空名不朽，惟见平汀涌白沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其七","author":"朱熹","text":"七曲灵祠近水滨，聚鱼石上跃金鳞。\n林凹路入桃源近，时有渔郎来问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其八","author":"朱熹","text":"八曲砚峰倚碧虚，泉流瀑布世间无。\n凭谁染就丹青笔，写出芹溪九曲图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芹溪九曲诗 其九","author":"朱熹","text":"九曲悠悠景最幽，巉岩峡石束寒流。\n源深自是舟难到，更有龙池在上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小均四景诗 其一","author":"朱熹","text":"晓起坐书斋，落花堆满径。\n只此是文章，挥毫有馀兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小均四景诗 其二","author":"朱熹","text":"古木被高荫，昼坐不知暑。\n会得古人心，开襟静无语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小均四景诗 其三","author":"朱熹","text":"蟋蟀鸣床头，夜眠不成寐。\n起阅案前书，西风拂庭桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小均四景诗 其四","author":"朱熹","text":"瑞雪飞琼瑶，梅花静相倚。\n独占三春魁，深涵太极理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水濂洞","author":"朱熹","text":"水濂幽谷我来游，拂面飞泉最醒眸。\n一片水帘遮洞口，何人捲得上帘钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题清虚庵来月轩","author":"朱熹","text":"夜吟唯觉月来迟，正忆先生独坐时。\n离绪几多无著处，不堪清气入诗脾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昙山题诗","author":"朱熹","text":"颓然见此山，一一皆天作。\n信手铭岩墙，所愿君不凿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方池","author":"朱熹","text":"武夷之境多神仙，我亦驻此临风轩。\n方池清夜堕碧玉，重帘白日垂洞门。\n暗泉涌地紫波动，微雨在藻金鱼翻。\n倚槛照影清见底，拄杖卓石寻无源。\n洗头玉女去不返，遗此丈八芙蓉盘。\n溪船明月泛九曲，出入紫微听潺湲。\n便欲此地觅真隐，何必商山求绮园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廓然亭","author":"朱熹","text":"迟留访隐古祠旁，眼底樛松老更苍。\n山得吾侪应改观，坐无恶客自生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游会稽东山","author":"朱熹","text":"江路经由数十回，无因到此为潮催。\n尝聆文靖曾游后，欲问蔷薇几度开。\n今日掣身推案去，暂时秉烛入山来。\n高僧不问谁家客，独计云轩自把怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题程烨程燧兄弟双桂书院","author":"朱熹","text":"君家构屋积玉堆，两种天香手自栽。\n清影一帘秋澹荡，任渠艳冶斗春开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21288,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丰城荣光书院","author":"朱熹","text":"一道荣光带碧山，天风吹雨渡云关。\n树浮空翠迷村坞，泉落飞虹泻石湾。\n赤岭豹栖朝气隐，剑潭龙起夜光寒。\n咿唔何处经年韵，多在湖东乔木间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21289,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆冈书院四景诗 其一","author":"朱熹","text":"卜筑隆冈远市朝，个中风景总堪描。\n溪云带雨来茅屋，涧水浮花出石桥。\n绿遍莎汀牛腹饱，青归麦垄鸟声娇。\n东邻西舍浑相似，半是渔人半是樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21290,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆冈书院四景诗 其二","author":"朱熹","text":"帘捲薰风半掩扉，五侯车马往来稀。\n绿杨门巷莺莺语，青草池塘燕燕飞。\n扫石围棋销白昼，解衣沽酒醉斜晖。\n山园莫道多寥落，梅子初黄杏子肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21291,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆冈书院四景诗 其三","author":"朱熹","text":"水绕荒村竹绕墙，俨然风景似柴桑。\n车缫白雪丝盈轴，铚刈黄云稻满场。\n几树斜晖枫叶赤，一篱疏雨菊花黄。\n东邻画鼓西邻笛，共庆丰年乐有常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21292,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆冈书院四景诗 其四","author":"朱熹","text":"土筑低墙草结庵，寻常爱客伴清谈。\n地炉有火汤初沸，布被无寒梦亦酣。\n风卷翠松鸣晚笛，雪飘疏竹响春蚕。\n闭门不管荣枯事，坐傍梅花读二南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21293,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德兴县叶元恺家题","author":"朱熹","text":"葱汤麦饭两相宜，葱暖丹田麦疗饥。\n莫道儒家风味薄，隔邻犹有未炊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21294,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过飞泉岭","author":"朱熹","text":"梯云石磴羊肠绕，转壑飞泉碧玉斜。\n一路风烟春淡泊，数声鸡犬野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21295,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游灵石","author":"朱熹","text":"百尺楼台九叠山，个中风景脱尘寰。\n危亭势枕苍霞古，灵石香沾碧藓斑。\n佳景每因劳企仰，胜游未及费跻攀。\n何当酬却诗书债，遂我浮生半日闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21296,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岱山岩访陈世德光同年","author":"朱熹","text":"一钱一剑出新州，五柳凭谁添酒筹。\n岱壑何嫌松共老，碧波偏向桂招游。\n不为身后百年计，自是人间第一流。\n我欲门前张雀网，先将车辙到山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21297,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送汪大猷归里","author":"朱熹","text":"濯濯才华耀禁林，翩然忽起故园心。\n九天得请恩方重，一舸东归春未深。\n照眼湖山非昨梦，及时诗酒合同襟。\n不应便作真狂客，讲殿行思听履音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21298,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汪端彦听雨轩","author":"朱熹","text":"诗问池堂春草梦，何如风雨对床诗。\n三薰三沐事斯语，难弟难兄此一时。\n为母静弹琴几曲，遣杯同举酒千卮。\n苏公感寓多游宦，岂不临风尚尔思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21299,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金榜山","author":"朱熹","text":"陈场老子读书处，金榜山前石室中。\n人去石存犹昨日，莺啼花落几春风。\n藏修洞口云空集，舒啸岩幽草自茸。\n应喜斯文今不泯，紫阳秉笔纪前功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21300,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南塘","author":"朱熹","text":"南塘旧是尚书宅，今作僧居水石清。\n半夜月明禅定后，松风犹带管弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21301,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏南岩","author":"朱熹","text":"南岩兜率境，形胜自天成。\n崖雨楹前下，山云殿后生。\n泉堪清病目，井可濯尘缨。\n五级峰头立，何须步玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21302,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽王德修","author":"朱熹","text":"不到湖潭二十年，湖潭依旧故山川。\n聊将杯酒奠青草，风雨萧萧忆昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21303,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙霞岭","author":"朱熹","text":"道出夷山乡思生，霞峰重叠面前迎。\n岭头云散丹梯耸，步到天衢眼更明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21304,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重过南塘吊徐一平先生","author":"朱熹","text":"不到南塘久，重来二十年。\n山如龟背厚，地与马鞍连。\n徐子旧书址，毛公新墓田。\n青松似相识，无语重凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21305,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访昂山支公故址","author":"朱熹","text":"支公肯与世相违，故结高堂在翠微。\n青菜漫随流水去，黄彪时逐暮云归。\n乔林挂月猿来啸，幽草生风鸟自飞。\n八万妙门能测度，个中独露祖师机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21306,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏一滴泉","author":"朱熹","text":"遥望南岩百尺岗，青山叠叠树苍苍。\n题诗壁上云生石，入定岩前石作房。\n一窍有灵通地脉，半空无雨滴天浆。\n鹅湖此去无多路，肯借山间结草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21307,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题景范庐","author":"朱熹","text":"非弃清明乐隐居，特因景范面鸳湖。\n观澜兴罢春风软，濯足歌残夜月孤。\n照貌不须临玉镜，洗心常得近冰壶。\n几回鱼跃鸢飞际，识破中庸率性图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21308,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书邵子尧夫游伊洛四首 其三","author":"朱熹","text":"秋日□秋禾黍边，农家富贵自丰年。\n一箪鸡黍一瓢饮，谁羡王侯食万钱。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21309,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访竹溪先生","author":"朱熹","text":"路逢个老翁，自负柴一束。\n乌巾插在腰，背手牵黄犊。\n借问何处居，指点破茅屋。\n午鸡啼短墙，麦饭方炊熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 天","author":"朱熹","text":"气体苍然故曰天，其中有理是为乾。\n浑然气理流行际，万物同根此一源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 鬼神","author":"朱熹","text":"鬼神即物以为名，屈则无形伸有形。\n一屈一伸端莫测，可窥二五运无停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 命二首 其一","author":"朱熹","text":"妙合之机不暂停，自然气化与流形。\n原于妙合名为命，即此而思得性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 命二首 其二","author":"朱熹","text":"静思二五生人物，新者如源旧者流。\n流自东之源不息，始终聚散即斯求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 性","author":"朱熹","text":"谓之性者无他义，只是苍天命理名。\n论性固当惟论理，谈空求理又非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 心","author":"朱熹","text":"性外初非更有心，只于理内别虚灵。\n虚灵妙用由斯出，故主吾身统性情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 情","author":"朱熹","text":"谓之情者无他思，只是吾心初动机。\n又把动时分析出，人当随发察其几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 意","author":"朱熹","text":"意乃情专所主时，志之所向定于斯。\n要须总验心情意，一发而俱性在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 道","author":"朱熹","text":"如何率性名为道，随事如由大路行。\n欲说道中条理具，又将理字别其名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 中庸","author":"朱熹","text":"过兼不及总非中，离却平常不是庸。\n庸字莫将容易看，只斯为道用无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 太极图","author":"朱熹","text":"性蔽其源学失真，异端投隙害弥深。\n推原气禀由无极，只此一图传圣心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 先天图二首 其一","author":"朱熹","text":"不待安排自整齐，只缘太极本如斯。\n试将万事依图看，先后乘除可理推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 先天图二首 其二","author":"朱熹","text":"乾坤复姤互推移，动静之间起至微。\n终日敛襟看不足，其中圆处是真机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 学","author":"朱熹","text":"轲死如何道乏人，缘知学字不分明。\n先除功利虚无习，尽把圣言身上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 体用","author":"朱熹","text":"体用如何是一源，用犹枝叶体犹根。\n当于发处原其本，体立于斯用乃存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]