ollection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晴","author":"张嵲","text":"时事任从儿辈说，新诗谁得老夫降。\n鬼名罢检秋堂静，卧看风枝动晚窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霁日暖飞虫蔽空甲子秋作","author":"张嵲","text":"秋霁无风日自曛，飞虫偪塞似屯云。\n老夫漂荡居夷久，祇恐乘空是廪君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种松二首 其二","author":"张嵲","text":"纷纷群木望秋零，独喜新松五鬣音。\n他年城郭人非旧，我始携锄斸茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种松二首 其一","author":"张嵲","text":"寿张种漆将为器，假用终能及里闾。\n我植青松期偃盖，苍然相对雪霜馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"张嵲","text":"日炙樱桃已半红，更薰花气满襟风。\n路傍谒舍蹲遗兽，应有荒坟在麦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"张嵲","text":"荦确南山路，丛筠冒水生。\n寒梅销落尽，犹有数花明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览镜","author":"张嵲","text":"览镜知予骨相屯，便当终与老农邻。\n议将此地为菟圃，种药栽花二十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵表之送梅并诗次韵四首 其四","author":"张嵲","text":"未忘一笑杯盘乐，终爱忘言气味长。\n多惭居士梅花供，举世何人解识香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵表之送梅并诗次韵四首 其三","author":"张嵲","text":"都缘老罢无筋力，不是萌心有爱憎。\n他时聊作逢场戏，分谤图知我亦曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵表之送梅并诗次韵四首 其二","author":"张嵲","text":"不著名身与句身，迥然超过亦无真。\n谁知终日腾腾者，便是当来本分人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵表之送梅并诗次韵四首 其一","author":"张嵲","text":"绿蓓繁时春欲暗，晓霜浓处信初来。\n今朝消息南枝露，知是微阳九地回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈忠玉兼寄尹梦得黄仲通并寄季通侄五首 其五","author":"张嵲","text":"君归多问尹夫子，病后新诗定益工。\n鸿雁南来书不到，想应全未废书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈忠玉兼寄尹梦得黄仲通并寄季通侄五首 其四","author":"张嵲","text":"南川解袂十年馀，环堵萧然颇自娱。\n生计荒馀莫深恨，归来犹得在枌榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈忠玉兼寄尹梦得黄仲通并寄季通侄五首 其三","author":"张嵲","text":"百年门户已萧然，每喜人传小阮贤。\n好遣仆童种榆槚，老夫行欲赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈忠玉兼寄尹梦得黄仲通并寄季通侄五首 其二","author":"张嵲","text":"少年浑欲不胜衣，丰下如今带十围。\n他日飞扬未轻料，卜居终欲近郊扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈忠玉兼寄尹梦得黄仲通并寄季通侄五首 其一","author":"张嵲","text":"当时分袂各丁年，南国相逢鬓已班。\n羡子还来觐丘陇，益令归梦绕金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":56462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]