provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"司马温公挽词五首 其一","author":"范祖禹","text":"伊吕为时耦，夷齐得圣清。\n精忠贯日月，至行格神明。\n微物沾仁泽，穷荒服德名。\n须知千载后，瞻仰重嵩衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴龙节传法院译经御筵","author":"范祖禹","text":"诞圣千年日，祈祥亿劫尊。\n秘言翻贝叶，胜事集祗园。\n宝盖天香住，银珰诏语温。\n曾无了义学，空愧酌尧樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多病","author":"范祖禹","text":"多病心牢落，惊秋鬓飒然。\n风乾桐叶地，雨冷菊花天。\n旧隐荒江汉，新居俯涧瀍。\n西都长梦想，何日赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙秀才下第暂还京口留别起居邀余和以赠行","author":"范祖禹","text":"翔鸾戢翼下层空，南浦归帆逐晓风。\n梦寐兰陔清露白，啸歌江国火云红。\n王畿结绶来无久，天汉乘槎去可通。\n莫为淹回销壮节，力行须与古人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"守岁","author":"范祖禹","text":"岁逐更筹尽，春随斗柄回。\n和风先傍柳，薄雪暗惊梅。\n坐对灯花结，欢吹酒蚁开。\n莫嗟华发短，且喜一年来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西街","author":"范祖禹","text":"西街春日永，辇道与天通。\n御水横银汉，仙桥挂綵虹。\n草荒平乐馆，花发上阳宫。\n扰扰都门路，轮蹄日向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到玉堂","author":"范祖禹","text":"旧庐风雨暗柴荆，丘壑元无绂冕情。\n一纪周南陪太史，八年书殿厕桓荣。\n陈编岂待伤麟止，藻思那能倚马成。\n空愧朱衣华发吏，玉堂三世见题名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张三十病愈久不相见以诗寄问","author":"范祖禹","text":"公干清漳卧，维摩净室居。\n作诗心在否，问法意何如。\n台榭花飞尽，池塘雨洗初。\n剧谈能强起，便欲驾柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李方叔馈潭笋","author":"范祖禹","text":"穿云斸石远林空，来涉烟波几万重。\n实比梧桐堪食凤，箨翻风雨便成龙。\n一枝未许尘鞍挂，千亩终留渭水封。\n陋巷菜羹知不称，君王玉食愿时供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李朝议挽词二首 其二","author":"范祖禹","text":"解组红尘外，忘机白日迟。\n烟霞随步武，松竹想风姿。\n沇水流清范，盘山厚福基。\n乡人应配社，犹恨不期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李朝议挽词二首 其一","author":"范祖禹","text":"美行商山老，高年渭水翁。\n政留循吏迹，家有古人风。\n操几门庭在，安车里巷空。\n子孙皆孝养，馀庆自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子开从驾朝谒景灵宫二首 其二","author":"范祖禹","text":"瑶池真气降东莱，营室新临渭北开。\n载见辟王遐迩至，思齐任姒肃雍来。\n龙胡尚泣遗弓剑，燧火俄惊变柳槐。\n谁识九重宵旰意，中天云汉望昭回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子开从驾朝谒景灵宫二首 其一","author":"范祖禹","text":"雨师汎洒霁光匀，华盖香风不起尘。\n亿兆欢呼真帝启，谋猷左右尽君陈。\n云随仙驭三山远，日出咸池六合新。\n一别都门变桑海，来瞻原庙祗悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子进千春院观桃花二首 其二","author":"范祖禹","text":"凤刹花光照碧霄，龙楼柳色暗朱桥。\n夸娥素月人疑近，姑射仙山路岂遥。\n琮玉温姿轻拂拂，鞠衣嘉色宛飘飘。\n都人莫怪芳华晚，如隔烟霞在泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子进千春院观桃花二首 其一","author":"范祖禹","text":"西度天津水见沙，轻风飞盖绿杨斜。\n相逢喜到千春寺，最后方开第一花。\n富媪英华当间出，东君照育想非赊。\n神仙高格黄裳色，安得深根植帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子进夏日忆宝上人","author":"范祖禹","text":"径藓铺苍锦，林花落绛趺。\n山光入户牖，云气起瓶盂。\n宴坐期三月，迷行有万途。\n寥寥方丈室，一物更应无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子瞻禁林锁院诏赐烛酒","author":"范祖禹","text":"晨入金华暮浴堂，声容不动笔奔忙。\n星间忽降龙衔耀，天上重分玉醴香。\n欲灺寒宵宫漏永，半酣归梦蜀山长。\n起看绛阙银河晓，山立千官拱未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和门下侍郎东省夜直寄左丞光禄","author":"范祖禹","text":"黄閤吁谟作帝龙，文昌纲辖振邦风。\n群才藻鉴归能哲，万事钧衡仰至公。\n连璧辉光时共美，断金情契昔相同。\n折冲千里精神壮，正似山河绕汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和门下相公从驾视学","author":"范祖禹","text":"尧天云汉炳文章，亲学严师款上庠。\n万乘及门先降辇，诸生望日俨成行。\n三雍盛典遵前训，千古元龟鉴逸王。\n儒服观光真幸会，为容深愧鲁高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和五十四翁登恩第后赠杨君章","author":"范祖禹","text":"力穑良农晚岁收，英名初喜动凝旒。\n光如剑气斗间没，文似河源天上流。\n莫叹黄金才易帚，安知布被不封侯。\n暮年烈士心方壮，双鹘抟风向九秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王都尉押高丽人燕射北园","author":"范祖禹","text":"天上星弧日射狼，副车衣袂得馀香。\n朔云曾落双雕羽，辽海将归万里航。\n酒滟尧觞宾已醉，春回汉苑漏初长。\n何郎拜舞恩波渥，花簇金鞍道路光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘莘老赠王圣美三子侄补试太学联中高等","author":"范祖禹","text":"风流江左并淮原，王氏衣冠不乏贤。\n文似三珠才竞爽，名如群玉气相连。\n九秋鸿雁方遵陆，万里骅骝始下鞭。\n白发星郎推雅量，似闻折屐喜成颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]