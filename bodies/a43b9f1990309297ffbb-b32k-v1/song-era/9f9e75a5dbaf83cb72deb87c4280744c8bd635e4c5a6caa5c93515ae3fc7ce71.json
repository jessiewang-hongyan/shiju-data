[{"title":"升堂颂古五十二首 其十八","author":"释怀深","text":"空王殿子几经秋，日晒风吹古路头。\n莫怪今朝聊点破，恐人一向外边修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十九","author":"释怀深","text":"暖日晒开地面冻，春风吹拆岭头梅。\n他知物物无遮障，自是时人眼不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十","author":"释怀深","text":"奔驰光景几翻春，何事临风一惨神。\n柳绿桃红依旧在，今年不见去年人。\n幸然明似镜，向用曲如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十一","author":"释怀深","text":"叶落归根万事休，来时无口句难酬。\n虚空忽尔翻筋斗，嚇倒云门六不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十二","author":"释怀深","text":"自惭无德继高踪，百事荒唐懒更慵。\n要死山今死未得，且将香火奉诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十三","author":"释怀深","text":"梦里移厨梦里来，梦中升座梦中斋。\n梦中生也梦中喜，梦里死事格里埋。\n万事不由人计较，一身休更巧安排。\n知梦里惺惺者，达磨西来□□鞋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十四","author":"释怀深","text":"瑞气氛氲锁梵宫，嵯峨宝塔倚高空。\n檐楹金碧光相照，尽落山僧一顿中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十五","author":"释怀深","text":"休休休，放下著，无量劫来灵性恶。\n只知贪爱黑如云，一段光明都昧却。\n休休休，放下著，浮生不用多图度。\n荣华富贵总成空，到头唯有无生乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十六","author":"释怀深","text":"年年今夜月华多，一点云生仗是魔。\n争似曹溪门下叟，一轮空月照婆婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十七","author":"释怀深","text":"宵灯烛斗荧煌，车马纵横彻晓忙。\n倒底不知灯是火，区区几个解回光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十八","author":"释怀深","text":"羚羊挂角时，个事绝毫釐。\n既能通一线，方便有高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其二十九","author":"释怀深","text":"二鼠侵藤真百苦，四蛇围井过千忧。\n忽然我断藤根子，道是千休与万休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十","author":"释怀深","text":"识得庐山五老峰，个中何地不相逢。\n舌头无骨随人转，熨斗煎茶铫不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十一","author":"释怀深","text":"溪头杨柳未堪折，岭上寒梅已过时。\n欲赠行人无所有，为君拈出岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十二","author":"释怀深","text":"祖师心印没遮藏，一句临时要厮当。\n莫谓座间人不识，台星炯炯照虚堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十三","author":"释怀深","text":"扫地泼水相公来，人人明镜挂高台。\n碧油幢下呵呵笑，青眼何妨特地开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十四","author":"释怀深","text":"寒山痴里放奸，布袋闹中打鬨。\n众生业识茫茫，几个眼睛定动。\n要知祖师妙门，毕竟不离日用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十五","author":"释怀深","text":"击鼓三通绝是非，本来无悟亦无迷。\n山僧不是多唇吻，谩把空拳嚇小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十六","author":"释怀深","text":"朝日忙忙打个球，生来念念不停流。\n若知落处无踪迹，始会云门六不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十七","author":"释怀深","text":"三十年来信脚行，一朝跳过是非坑。\n桃花岁岁随流水，一任傍人把路争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十八","author":"释怀深","text":"云笼大野，迦叶攒眉。\n雨洒长天，空生下泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其三十九","author":"释怀深","text":"风动心摇树，云生性起尘。\n不明今日事，昧却本来人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十","author":"释怀深","text":"道源不远，性海非遥。\n但向己求，莫从他觅。\n觅亦不得，得亦不真。\n修是他心，不如自性。\n自性清净，即是法身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十一","author":"释怀深","text":"生时水是冰，死时冰是水。\n若知无去来，只此两般是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十二","author":"释怀深","text":"般若无知，无所不知。\n般若无见，无所不见。\n无知之知，是为真知。\n无见之见，是为真见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十三","author":"释怀深","text":"兔子怀胎，蚌含明月，乘时正在中秋节。\n一颗明珠转玉盘，彻底无瑕光皎洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十四","author":"释怀深","text":"红日三竿高枕处，黄粮一钵饱斋时。\n分明千圣排肩立，不肯承当过在谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十五","author":"释怀深","text":"达磨西来，单传心印。\n不立文字，直指人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十六","author":"释怀深","text":"莫妄想，好参详，不知终日为谁忙。\n若知忙里真消息，一朵莲花生沸汤。\n休得也，便好休，百年浮幻水中沤。\n自家屋里天真佛，切忌区区向外求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十七","author":"释怀深","text":"祖师心印没多般，悟得无劳指一弹。\n剔起眉毛如不荐，春风依旧著人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十八","author":"释怀深","text":"一群六个贼，生生欺杀人。\n我今识汝也，不共你相亲。\n你若不服我，我则到处说。\n教人尽识汝，遣汝行路绝。\n你若背服我，我则不分别。\n共你一处住，同證无生灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其四十九","author":"释怀深","text":"忠孝一心清似水，功名千古重如山。\n碧幢红旆照春色，赢得高堂白昼闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其五十","author":"释怀深","text":"佛身无相，染净皆空。\n妙体湛然，悟迷俱妄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其五十一","author":"释怀深","text":"洞中春色四时好，云外峰峦一样高。\n用祝贤王龟鹤算，年年洗眼看蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"升堂颂古五十二首 其五十二","author":"释怀深","text":"才见开炉又闭炉，寒来暑往只须臾。\n庭前残雪方消尽，岭上春云已卷舒。\n满目更无心外法，几人曾悟髻中珠。\n祖师莫不叮咛语，自是时人见处粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其一","author":"释怀深","text":"头陀饮光，多闻庆喜。\n合掌擎拳，难兄难弟。\n一朝狭路两相逢，裂转双睛无处避。\n便向门前倒刹竿，丈夫自有冲天志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二","author":"释怀深","text":"不落与不昧，前后百丈语。\n毫发若参差，铁山横在路。\n岂不见蓝田，常年人射虎。\n初时一箭没其羽，子细看来元是石。\n再欲射时射不入，几乎惧杀李将军，千古令人空叹息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其三","author":"释怀深","text":"移身换步老天衣，不惜眉毛月个知。\n今日若明当日事，江南日暖鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其四","author":"释怀深","text":"云门舌上有龙泉，爱把金针黑处穿。\n要会衲僧巴鼻子，一条红线两人牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其五","author":"释怀深","text":"走下禅床行一转，看了如来五千卷。\n婆子年高眼尚明，夜深月下穿针线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其六","author":"释怀深","text":"大士讲经竟，挥案成注脚。\n一丸疗众病，不假驴驼药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其七","author":"释怀深","text":"曾到吃茶去，未到吃茶去。\n赵州老禅和，口刮心里苦。\n心里苦，直至如今无雪处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其八","author":"释怀深","text":"海水有时终见底，人生到死不知心。\n秀才若会翻身句，管取白衣入翰林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其九","author":"释怀深","text":"丰城宝剑沉埋久，一道寒光射斗牛。\n不是张华辨端的，只应千古枉淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十","author":"释怀深","text":"佳人十八正娇痴，一曲堂前舞柘枝。\n祇有五郎知雅态，更无人道柳如眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十一","author":"释怀深","text":"阿谁踏著雪峰踪，三世诸佛火燄中。\n赖有云门相暖热，火屋吹得满堂红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十二","author":"释怀深","text":"别面不如花有笑，离情难似竹无心。\n因入说著曹家女，引得相思病转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十三","author":"释怀深","text":"庞婆移转髻边梳，一段风流举世无。\n万事但将公道断，维那不用笔头书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十四","author":"释怀深","text":"长江辊底浪如银，秋日白蘋红蓼新。\n莫怪扁舟难到岸，行船由在把梢人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十五","author":"释怀深","text":"父子相逢臭味同，龙泉宝剑再磨砻。\n要明马祖当年喝，大地山河尽耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十六","author":"释怀深","text":"一条官路坦然平，无限游人取次行。\n莫谓地平无险处，须知平地有深坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十七","author":"释怀深","text":"一人会上竿，一人会穿井。\n伎俩虽不同，总是一般病。\n若人识得这般病，衲僧鼻孔都穿尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十八","author":"释怀深","text":"法身无相，法眼无瑕。\n因风吹火，借水献花。\n丝毫不立，万别千差。\n但看来年三二月，衔泥燕子入人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其十九","author":"释怀深","text":"檐头雨滴，阶前地湿。\n法法现成，人信不刃。\n更问如何，长江水急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十","author":"释怀深","text":"洞山麻三斤，斤两不谩人。\n语稀难问事，貌古易传神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十一","author":"释怀深","text":"处处绿杨堪系马，家家门道透长安。\n一条大路平如掌，自是时人措足难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十二","author":"释怀深","text":"蓦直去，蓦直去，草鞋跟断人无数。\n唱歌须是帝乡人，一个拍兮一个舞。\n舞得彻，勿多般，赵州婆子特用瞒。\n今古五台山下路，长松短桧耸云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十三","author":"释怀深","text":"马祖捧出菱花镜，王老亲拈白玉槌。\n一击当阳令瓦碎，此心能有几人知，两个分明是赤眉。\n风前月下扬家丑，笑倒灵山老古锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十四","author":"释怀深","text":"上庵竖起拳头，赵州左眼半斤。\n下庵竖起拳头，赵州右眼八两。\n君看陕府铁牛，何似嘉州大像。\n若谓总没诸讹，露柱灯笼合掌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十五","author":"释怀深","text":"云门一枚糊饼，天下衲僧咬嚼。\n若非铁作牙关，往往完圞吞却。\n吞时易，吐时难，莫道从来曲一般。\n踏看韶阳关捩子，方能平地起波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十六","author":"释怀深","text":"赵州门户，都无关锁。\n侍者粗心，当头蹉过。\n灵利沙弥，珍重便行。\n这里下一转语，夜深归堂向火。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十七","author":"释怀深","text":"赵州庭前柏，何似门外柳。\n大尽三十日，小尽二十九。\n更问事如何，合却□生口。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十八","author":"释怀深","text":"北斗藏身处，拟议即差讹。\n钻天新鹞子，不恋旧时窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其二十九","author":"释怀深","text":"终朝噇饭费工夫，不识灯笼是钵盂。\n多少三家村里汉，忙忙树上捉鲇鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古三十首 其三十","author":"释怀深","text":"髑髅里眼见犹在，枯木中龙声更狂。\n打破虚空光境尽，个中别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其一","author":"释怀深","text":"忆昔去年春，正当此时节。\n双拳打破太虚空，无限家风浑漏泄。\n人中狮子丧全成，月里麒麟斗角折。\n斗角折，金刚正眼难磨灭。\n千古令人诵不休，吹散红炉一点云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其二","author":"释怀深","text":"一回饮水一回噎，本自无情似有情。\n欲会个中端的意，木鸡啼作两般声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其三","author":"释怀深","text":"个事相承八百年，实无一法与人传。\n今朝欲报无传底，聊爇金炉一炷烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"因胜澄禅师下火","author":"释怀深","text":"这老子，斗时枯槁，不近人情。\n四海独孤标，一身无伴侣。\n虽则两提祖印，实无一法与人。\n闺门端坐冷啾啾，夜静独为鬼神说。\n任你傍人恶发，我心终未和同。\n有时开眼对青山，自笑满头生白发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人下火 其一","author":"释怀深","text":"初秋夏一时，衲僧多欲去。\n不搭陈梢船，便行泗州路。\n横担拄杖气如云，万水千山都不顾。\n昨日通川方上入，随例茫茫把不住。\n把不住，为君说个临歧句。\n枯木岩前差路多，剔起眉毛著眼觑。\n一身恍若风中烛，百岁端如水上沤。\n未到衲僧平稳处，临行那得不生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸禅人下火 其二","author":"释怀深","text":"浮生岸树井藤，毕竟终归败坏。\n这僧撩起便行，也是平生庆快。\n著上没底芒鞋，抛下这个皮袋。\n茶毗坛上火犹在，延寿堂中人又终。\n方言□身浑□□，□□□同一梦中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行者下火","author":"释怀深","text":"汝幼入空门，方年二十五。\n须发尚未除，幼身今日去。\n脱下布直裰，休问温州路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":2193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]