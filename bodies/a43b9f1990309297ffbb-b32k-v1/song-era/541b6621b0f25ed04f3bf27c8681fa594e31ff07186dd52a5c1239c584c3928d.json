[{"title":"丹霞见灵照女图赞","author":"释智愚","text":"冤有头，债有主。\n天然欲访庞翁，恰好撞著此女。\n揣尽家私，瓜甜蒂苦。\n因兹上下不和同，牛奶郎忙涂赤土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以文长老请赞","author":"释智愚","text":"天地不仁，出此妖怪。\n有偷营劫寨之机，无喜舍慈悲之戒。\n正脉将沉，法门凋瘵，如何嗣续松源派。\n大奸难后越精神，骂人嘴毒如蜂虿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元藏主游方","author":"释智愚","text":"骂詈瞿昙说脱空，年来分外恶情悰。\n吴山越水相逢著，放出蟭螟咬大虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺玉论师赴觉海","author":"释智愚","text":"妙旨惟从句外求，白云先见室中筹。\n海山深处多麟凤，此去横经一网收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方广寺","author":"释智愚","text":"云中玉磬无时响，木末金灯永夜明。\n胜地正缘人罕到，古今门户未尝扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"文宗问终南山蛤蜊瑞相图赞","author":"释智愚","text":"攧不开，扑不破。\n人言大士应身，我也疑他真个。\n终南山，相应和。\n喜动龙颜，百僚俱贺，谁知别有弥天过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无则都寺玉几写予梦影自散席后言音不相接者十二年今上径山请赞笔老墨涩勉而书之","author":"释智愚","text":"敬而远，亲而疏。\n明鉴灵腑，善定锁铢。\n凌霄高而众峰拱，海峤耸而蟾影孤。\n子归就父，吾不识渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本绍明知客请赞","author":"释智愚","text":"绍既明白，语不失宗。\n手头簸弄，金圈栗蓬。\n大唐国里无人会，又却乘流过海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本照禅者欲得数字径以述怀赠之","author":"释智愚","text":"世路多巇崄，无思不研穷。\n平生见诸老，今日自成翁。\n认字眼犹绽，过谭耳尚聋。\n任天行直道，休问马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"可禅人归江心","author":"释智愚","text":"每思槌拂恨难酬，孤屿寻归月正秋。\n堂上若呈圆相去，乃师应错骂双梼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生公讲台","author":"释智愚","text":"鳞皴瘦石笼寒藓，千石遗踪意转新。\n纵使天花来堕席，何如缄口过残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示惠灵为僧","author":"释智愚","text":"惠性何如见性通，要教灵验显吾宗。\n乘时飏下坠腰石，笑捧衣盂继祖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"光禅者请赞","author":"释智愚","text":"初而欣，久而厌。\n明月夜光，多逢按剑。\n但信得及，自有灵验。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆远俊长老请赞","author":"释智愚","text":"老不死，心未灰。\n触著恶发，青天怒雷。\n引得虎头燕颔，竞起丛林祸胎。\n点著便领，何其俊哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆藏主之南屏","author":"释智愚","text":"曾向殊方典竺坟，丛林有志张吾军。\n天寒岁晚重寻旧，莫负青鞋蹈冻云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李翱参药山图赞","author":"释智愚","text":"黑豆数无穷，青松盖不尽。\n癯然老比丘，即此吾无隐。\n更提云水曲周遮，添得傍人眼里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村乐图","author":"释智愚","text":"一年田地熟，赋外乐天真。\n便不打鼓笛，也是太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净覃藏主请赞","author":"释智愚","text":"容易肯人，难与共语。\n竹篦头惜之如金，禅床角委之如土。\n净覃知藏善知机，电光影里分宾主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和秉彝李君五偈 其四","author":"释智愚","text":"晓听君臣庆贺时，六街如昼不曾迷。\n普贤境界应垂问，手诏来时见紫泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崖泉应虚室","author":"释智愚","text":"天籁发中静，峰高远出云。\n有来非眼听，无处足心闻。\n蒲冷禅衣弊，窗虚月影分。\n大功终不宰，纵尔自云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳林古渡","author":"释智愚","text":"契翁来作济人舟，两岸青山浸碧流。\n舞棹舷歌不到处，知心惟有老岩头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庞居士阖家都去图赞","author":"释智愚","text":"神出鬼没，接响承虚。\n这一火络，邪法难扶。\n互将鱼目作明珠，笑倒西天碧眼胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弥藏主归潮阳","author":"释智愚","text":"穆穆丛林见老成，江湖约我复同盟。\n鳄乡未话腥风起，春雪初消好问程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"径山西寮众老郎请赞","author":"释智愚","text":"霜严气烈，山空月明。\n涵养有得，刬削不平。\n拈起则佛祖不识，放下也草木争荣。\n挨到凌霄八十四，谁知名重九重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧童","author":"释智愚","text":"烟暖溪头草正肥，尽教牛饱卧晴曦。\n捲桐又入深深坞，吹尽春风不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试剑石","author":"释智愚","text":"云骨深埋草莽中，竟传秦王试灵锋。\n旧痕尚带春苔绿，一罅能生偃草风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衍巩珙三禅德之国清","author":"释智愚","text":"谁知三隐寂寥中，因话寻盟别鹫峰。\n相送当门有脩竹，为君叶叶起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵王访赵州州不下禅床图赞","author":"释智愚","text":"坚不刚，柔不弱。\n七百甲子老翁，偏要用此一著。\n列土王来不下床，高风千古为标格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送茂侍者","author":"释智愚","text":"木叶辞柯霜气清，虎头戴角出禅扃。\n东西南北无人处，急急归来话此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送炳书记","author":"释智愚","text":"心镜频磨发渐斑，照临今古未尝闬。\n已知所得离文字，此去禅栖必有山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鄱阳复道者","author":"释智愚","text":"相逢道人漆双瞳，衣衫零落迎秋风。\n甘将百骸作泥土，冷笑万事如展蓬。\n当今祖道薄如纸，瓦缶雷鸣闹人耳。\n正音却作一线悬，两手枕胸泪如洗。\n行行不惜两茎眉，魔宫虎穴俱探窥。\n山穷桥断始得路，伎俩尽时方见伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徒弟宗璞建施水庵请赞","author":"释智愚","text":"等是垂慈，初无门户。\n璞玉既分兮可观，梵仪顿举兮难睹。\n凌霄峰顶看云人，普化堂中第一祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅宗镜录","author":"释智愚","text":"百卷非文字，精探海藏深。\n老胡三寸舌，镜主几生心。\n力破尘劳网，能销旷劫金。\n归原何所似，花底啭灵禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释智愚","text":"赵州八十方行脚，虚堂八十再住山。\n别有一机恢佛租，九重城里动龙颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其九十五","author":"释智愚","text":"野犴鸣，狮子吼。\n丧尽生涯，不容开口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其九十四","author":"释智愚","text":"客里谩牢落，天涯多故人。\n好怀无处写，旧话得重论。\n残雪未消石，梅英先破春。\n徘徊殊有约，来此续芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其九十一","author":"释智愚","text":"五逆闻雷慊慊然，寻常争敢与人宣。\n自从六十轻酬后，济北驴名不浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其八十九","author":"释智愚","text":"拟从险处放身时，那个商量不皱眉。\n不动毫芒亲到底，眼睛皮绽盖须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其八十二","author":"释智愚","text":"火炉头话几多般，自己同时作么观。\n直下起来呈两指，山河大地黑漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其七十六","author":"释智愚","text":"隔水何人歌竹枝，动人情思极幽微。\n夜深转入单于调，月朗风高听者稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其六十五","author":"释智愚","text":"百年犹恐没人知，名字仍将左胁题。\n入水入泥难放牧，仰山只得半边骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其六十二","author":"释智愚","text":"三文买个捞波子，摝蚬捞虾得几年。\n逆顺短长休要说，谁家屋里灶无烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其五十七","author":"释智愚","text":"春暖山桃次第红，翩翩蝴蝶斗芳丛。\n蓦然一阵狂风至，辊入花枝不见踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其四十八","author":"释智愚","text":"扶过断桥水，伴归明月村。\n只知途路远，不觉又黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其四十四","author":"释智愚","text":"不设陷阱，不挥雪刃。\n一箭穿杨，神目不瞬。\n翻思昔日李将军，射虎之机犹是钝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其四十三","author":"释智愚","text":"贝叶持来晓者疏，自称灵验世无如。\n依然还我唐人译，始有人知是梵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其三十四","author":"释智愚","text":"担板汉，没拘束。\n饿死首阳山，誓不食周粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其二十三","author":"释智愚","text":"抛来撒去互施呈，地狱门前鬼眼睛。\n觑破髑髅肝胆外，摩醯顶上复重明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其十七","author":"释智愚","text":"野水浮轻楫，暖烟生紫莼。\n晚来湖上望，多是罟鱼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其八","author":"释智愚","text":"石润非玉，水丽非金。\n大禹决而西溯，卞和泣而陆沈。\n美兮渺兮，错古砻今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其七","author":"释智愚","text":"玉箫吹彻凤凰台，古殿深沈晓未开。\n满地落花春已过，绿阴空锁旧莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古一百首 其五","author":"释智愚","text":"铁壁迸开云片片，黑出辊出月团团。\n就中明暗相陵处，天外出头谁解看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释智愚","text":"力在如今作用时，情存毫忽便成欺。\n谁知脩水千峰碧，尽入秋风一瘦藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释智愚","text":"一拳拳倒黄鹤楼，一趯趯反鹦鹉洲。\n有意气时添意气，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二十一","author":"释智愚","text":"百丈清规，千古洪范。\n藏之则虚空绝迹，用之则纲令森严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二十","author":"释智愚","text":"上元新节，处处烧灯，都城巷陌，市廛邸店。\n观者如堵，惟复灯来眼底，眼到灯边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十九","author":"释智愚","text":"四达皇皇，无边无表，因甚有新有旧。\n会得此去汉阳不远，不然黄鹤楼前鹦鹉洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十八","author":"释智愚","text":"老不禁寒，山边水边曝日。\n春归阆苑，长底短底从新。\n笙歌丛里贺年朝，锦绣筵中开寿域。\n衲僧门下别有条章，每日蒙头打坐。\n不知岁月易迁，直饶拶著不来，谁展钵盂吃饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十七","author":"释智愚","text":"年垂九十碍丛林，历尽风霜岁月深。\n妙蕴岂能超佛祖，寸衷端可格天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十五","author":"释智愚","text":"西天末叶，东土初枝。\n趑趄梁魏兮形影相吊，冷坐嵩少兮路径委蛇。\n将谓单传直指，谁知一握乱丝。\n骂底恨底患在为人之师。\n今则枝枯叶陨，敷茂何期。\n有屈明明无雪处，临风只可自嘘戏。\n聊陈菲供，来兮鉴诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十四","author":"释智愚","text":"一人高高峰顶立，一人深深海底行。\n不是与人难共住，大都缁素要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十三","author":"释智愚","text":"夫蛊者最灵通，不期而会，不约而同。\n拶著崖崩石裂，抛出金圈栗蓬。\n惊倒露柱，嚇煞灯笼。\n不知何处毒种，元来门里有虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十一","author":"释智愚","text":"一气潜回，百昌萌动。\n君子道长兮露柱咨参，小人道消兮灯笼作舞。\n义出丰年，道复太古。\n国师欢喜问如何，冬至寒食一百五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十","author":"释智愚","text":"平生好攻禅病，不知病是道源。\n要知道源端的，直须陆地行船。\n因思大唐裴相国作圆觉经一序，一字一义，耸动人天。\n又思本朝温国公制解禅颂六篇，一褒一贬，口业昭然。\n匪伊自绝夙种，佛亦不度无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其九","author":"释智愚","text":"观东震旦，有大乘根器，逾海越漠而来，远赴梁朝丹阙。\n一言契合，如春卷衣。\n北面折苇问津，信知桂谶不诬人。\n追思严讳，炊黍鲙芹。\n流水希声弦欲断，不知将底续芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其八","author":"释智愚","text":"秋风吹晓露，秋雨送秋炎。\n祖师门下客，无处不咨参。\n前程忽撞著个金口木舌汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其七","author":"释智愚","text":"诸人知处良遂知，良遂知处人不知。\n因思积雨花狼藉，空写愁肠说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其六","author":"释智愚","text":"天不文，地不理。\n忽去忽来，如月印水。\n岁月已往兮波旬得时，椁示双趺兮饮光增喜。\n悲兮喜兮，春风桃李。\n一以贯之，曾子曰唯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其五","author":"释智愚","text":"鸢飞戾天，鱼跃于渊。\n四夷拜舞，八表宣传，笑看红日上阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其四","author":"释智愚","text":"闹不如静，忙不如閒。\n静闹俱泯，谓之得理。\n归宗事理绝，日轮正当午。\n向道莫行山下路，果然猿叫断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其三","author":"释智愚","text":"吽㗶吒喇竭节，地转天回难辨别。\n不使松源省数钱，惯用衲僧锁口诀。\n同死不同生，特地成途辙，秋风影里重罗列。\n义断情忘四十年，何时待得龟成鳖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其一","author":"释智愚","text":"开端令节，万事从新。\n普贤磨墨，文殊把笔，书个事事大吉。\n从兹常住宽馀，扫除逋积。\n斗南长见老人星，五峰峨峨倚空碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十七","author":"释智愚","text":"秤锤捻得汁出，石人喝得汗流。\n临机应变，随分知羞，乘时推上五峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十六","author":"释智愚","text":"二月十五入寂，四月八日复生。\n虚空开笑口，大地绝人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]