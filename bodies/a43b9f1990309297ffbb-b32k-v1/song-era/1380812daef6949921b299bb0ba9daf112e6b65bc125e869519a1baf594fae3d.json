[{"title":"自遣","author":"文天祥","text":"诗馀眠白日，饮后坐清风。\n万事乘除里，平生宠辱中。\n心无随境变，意自与天通。\n莫笑邯郸梦，惺惺更是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至温州","author":"文天祥","text":"万里风霜鬓已丝，飘零回首壮心悲。\n罗浮山下雪来未，扬子江心月照谁。\n祇谓虎头非贵相，不图羝乳有归期。\n乘潮一到中川寺，暗读中兴第二碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行宫 其二","author":"文天祥","text":"怪底秦淮一水长，几多客泪洒斜阳。\n江流本是限南北，地气何曾减帝王。\n台沼渐荒基历落，莺花犹在意凄凉。\n青天毕竟有情否，旧月东来失女墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行宫 其一","author":"文天祥","text":"十里宫墙一聚尘，天津晚过客愁新。\n花啼杜宇归来血，树挂苍龙脱去鳞。\n福德傥存终有晋，秣陵未改已无秦。\n秋风禾黍空南北，见说铜驼会笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过邵伯镇","author":"文天祥","text":"今朝车马地，昔日战争场。\n我有扬州鹤，谁存邵伯棠。\n一湾流水小，数亩故城荒。\n回首江南路，青山断夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过梁门","author":"文天祥","text":"一一金瓯在，双双镇璧全。\n土花开旧国，风絮渡江船。\n南北分新统，江淮号极边。\n更和天堑失，回首惨啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过零丁洋","author":"文天祥","text":"辛苦遭逢起一经，干戈落落四周星。\n山河破碎风抛絮，身世飘摇雨打萍。\n皇恐滩头说皇恐，零丁洋里叹零丁。\n人生自古谁无死，留取丹心照汗青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乱礁洋","author":"文天祥","text":"海山仙子国，邂逅寄孤蓬。\n万象画图里，千崖玉界中。\n风摇春浪软，礁激暮潮雄。\n云气东南密，龙腾上碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初六日即事","author":"文天祥","text":"车马燕山闹，谁家早管弦。\n开门忽见雪，拥被不知年。\n箧破书犹在，炉残火复燃。\n偷桃昨日事，回首哭尧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别弟赴新昌","author":"文天祥","text":"十载从游久，诸公讲切精。\n天渊分理欲，内外一知行。\n立政须规范，修身是法程。\n对床小疏隔，恋恋弟兄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别里中诸友","author":"文天祥","text":"青山重回首，风雨暗啼猿。\n杨柳溪头钓，梅花石上尊。\n故人无复见，烈士尚谁言。\n长有归来梦，衣冠满故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别谢爱山 其一","author":"文天祥","text":"绿绮知音早，青灯对语迟。\n那知今雨别，又重故人思。\n山隔诗情远，云含客思悲。\n小楼今夜笛，莫向月中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别谢爱山 其二","author":"文天祥","text":"君今拂衣去，我独枕书眠。\n一片过林雨，数声当户蝉。\n情长空有恨，吟苦不成篇。\n后会知何日，西风老雁天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"文天祥","text":"去年伤北使，今日叹南驰。\n云湿山如动，天低雨欲垂。\n征夫行未已，游子去何之。\n正好王师出，崆峒麦熟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"文天祥","text":"船只时閒锁，城孤日闭关。\n惊心常有马，极目柰无山。\n出路相传险，行囊愈觉悭。\n归心风絮乱，无柰一身闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"文天祥","text":"痛哭辞京阙，微行访海门。\n久无鸡可听，新有虱堪扪。\n白发应多长，苍头少有存。\n但令身未死，随力报乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈小村","author":"文天祥","text":"万里飘零命羽轻，归来喜有故人迎。\n雷潜九地声元在，月暗千山魄再明。\n疑是仓公回已死，恍如羊祜说前生。\n夜阑相对真成梦，清酒浩歌双剑横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿朱约山八十三岁","author":"文天祥","text":"八十馀翁雪满颠，深衣大带耳垂肩。\n磻溪回首今三载，绛县论心又十年。\n归去来兮真富贵，美哉寿也活神仙。\n门前燕雀纷如雨，愧我白云深处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿朱约山八十韵","author":"文天祥","text":"翠袖琼楼八十翁，平安晓宇看孤鸿。\n五湖图里添彭祖，南极光中约祝融。\n日日青山醉春色，年年黄菊饱西风。\n鹰扬但愿无施处，臣老婆娑一钓蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张元帅谓予国已亡矣杀身以忠谁复书之予谓商非不亡夷齐自不食周粟人臣自尽其心岂论书与不书张为改容因成一诗","author":"文天祥","text":"高人名若浼，烈士死如归。\n智灭犹吞炭，商亡正采薇。\n岂因徼后福，其肯蹈危机。\n万古春秋义，悠悠双泪挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"快阁遇雨观澜","author":"文天祥","text":"一笑登临晚，江流接太虚。\n自惭云出岫，争讶雨随车。\n慷慨十围柳，周回千里鱼。\n故园堤好在，夜梦绕吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀中甫","author":"文天祥","text":"久要何落落，末路重依依。\n风雨连兵幕，泥涂满客衣。\n人间龙虎变，天外燕鸿违。\n死矣烦公传，北方人是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀赵清逸","author":"文天祥","text":"崖海真何地，驱来坐战场。\n家人半分合，国事决存亡。\n一死不足道，百忧何可当。\n故人髯似戟，起舞为君伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜架阁 其一","author":"文天祥","text":"仗节辞王室，悠悠万里辕。\n诸君皆雨别，一士独星言。\n啼鸟乱人意，落花销客魂。\n东坡爱巢谷，颇恨晚登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜架阁 其二","author":"文天祥","text":"昔趋魏公子，今事霍将军。\n世态炎凉甚，交情贵贱分。\n黄沙扬暮霭，黑海起朝氛。\n独与君携手，行吟看白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"来平馆","author":"文天祥","text":"憔悴江南客，萧条古郓州。\n雨声连五日，月色彻中流。\n万里山河梦，千年宇宙愁。\n欲鞭刘豫骨，烟草暗荒丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汶阳馆","author":"文彦博","text":"去岁营船隩，今朝馆汶阳。\n海空沙漠漠，河广草茫茫。\n家国哀千古，男儿慨四方。\n老槐秋雨暗，孤影照琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沈颐家","author":"文天祥","text":"孤舟霜月迥，晓起入柴门。\n断岸行簪影，荒畦落履痕。\n江山浑在眼，宇宙付无言。\n昨夜三更梦，春风满故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苍然亭","author":"文天祥","text":"风打船头系夕阳，亭前老子旧胡床。\n青牛过去关山动，白鹤归来城郭荒。\n忠节风流落尘土，英雄遗恨满沧浪。\n故园水月应无恙，江上新松几许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闲居和云屋道士","author":"文天祥","text":"一樽聊共此时心，文字追随落醉吟。\n仙子楼台脩竹外，行人冠盖画桥阴。\n一年芳草东风老，五月空江夜雨深。\n且作兰亭欢喜集，更论谁后又谁今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卖鱼湾","author":"文天祥","text":"风起千湾浪，潮生万顷沙。\n春红堆蟹子，晚白结盐花。\n故国何时讯，扁舟到处家。\n狼山青两点，极目是天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周苍崖入吾山作图诗赠之","author":"文天祥","text":"三生石上结因缘，袍笏横斜学米颠。\n渔父几忘山下路，仙人时访岭头船。\n乌猿白鹤无根树，淡月疏星一线天。\n为我醉呼添濛澒，倦来平卧看云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和中甫端午韵不依次","author":"文天祥","text":"黄茅古道外，羸马发南州。\n有客嗤齐鲁，何人念楚囚。\n岁年付流水，风雨满沧洲。\n手把菖蒲看，黑头非所求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和中斋韵 其二","author":"文天祥","text":"见说黄沙接五原，飘零只影向南辕。\n江山有恨销人骨，风雨无情断客魂。\n泪似空花千点落，鬓如硕果数根存。\n肉飞不起真堪叹，江水为笼海作樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和中斋韵 其一","author":"文天祥","text":"功业飘零五丈原，如今局促傍谁辕。\n俛首北去明妃泪，啼血南飞望帝魂。\n骨肉凋残唯我在，形容变尽只声存。\n洪流千古英雄恨，兰作行舟柳作樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人","author":"文天祥","text":"落落南冠过故都，近来我意亦忘吾。\n骑来驿马身如寄，遣去家书字亦无。\n景伯未囚先立后，嵇康纵死不为孤。\n江南只有归来梦，休问田园芜不芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱松坡","author":"文天祥","text":"学医未至大医王，笑杀年年折臂伤。\n屏里江山如出色，亭皋松菊已成行。\n细参不语禅三昧，静对无弦琴一张。\n多谢岭头诗寄我，满园梅意弄春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和朱衡守约山韵","author":"文天祥","text":"昔人一出正朋字，今我惭非行秘书。\n人样相看愿元祐，诗章甚雅突黄初。\n竞言汲戆犹须复，或谓颜愚亦可如。\n把酒对花姑勿论，春行后长莫妨徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和自山","author":"文天祥","text":"春晚伤为客，月明思见君。\n我方慕苏武，谁复从田文。\n龙背夹红日，雁声连白云。\n琵琶汉宫曲，马上不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和言字韵","author":"文天祥","text":"悠悠天地阔，世事与谁论。\n清夜为挥涕，白云空断魂。\n死生苏子节，贵贱翟公门。\n前辈如瓶戒，无言胜有言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人赋别 其二","author":"文天祥","text":"当年童子见，今见二毛翁。\n海月三秋别，江云一日同。\n鸥心驰舍北，龙尾曳天东。\n定有延和奏，南来寄一通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前人赋别 其一","author":"文天祥","text":"翠松三万顷，松雪著神仙。\n柳院催金钥，江花送玉鞭。\n晓岩云壁立，晚棹浪规圆。\n未了醉翁事，重寻颍上田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和故人韵 其二","author":"文天祥","text":"人情嗟愈变，世法合何如。\n气以心平定，才因意广疏。\n时行或时止，无咎亦无誉。\n第一严交际，琴绅敢不书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和故人韵 其一","author":"文天祥","text":"去岁湟中谷，医疮咸粜新。\n一言堪救药，三秩敢贪嗔。\n自是仁由己，休论哲保身。\n当时若瘖默，何面见乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡琴窗","author":"文天祥","text":"买得青山贵似金，瘦筇上下费沉吟。\n花开花落相关意，云去云来自在心。\n夜雨一江渔唱小，秋风两袖客愁深。\n夹堤密与栽杨柳，剩有行人待绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧安抚平林送行韵","author":"文天祥","text":"得失元来付塞翁，何心桃李问东风。\n人皆有喜荣三仕，我尚无文谢五穷。\n秘苑固知朋可正，畏途犹恐甲方衷。\n欲酬长者殷勤祝，坎止流行学四忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和萧秋屋韵","author":"文天祥","text":"芦花作雪照波流，黄叶声中一半秋。\n明月婵娟千里梦，扁舟汗漫五湖游。\n星辰活动惊歌笑，风露轻寒敌拍浮。\n赢得年年清赏处，山河全影入金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和龚使君韵","author":"文天祥","text":"淡和心事葛天民，回首归来清渭滨。\n长倩君宾孙子行，道原义仲辈流人。\n一生受用忘非是，万事升沉等故新。\n近日贞元朝士少，蒲轮有命出枫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韵送逸轩刘民章","author":"文天祥","text":"少日屠龙事已劳，送人千里发江涛。\n蓬莱地近风方细，阊阖门开日正高。\n春里看花须款款，雨中剪韭且陶陶。\n金吾已办长安月，双凤扶云立海鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜","author":"文天祥","text":"秋光连夜色，万里客凄凄。\n落木空山杳，孤云故国迷。\n衾寒霜正下，灯晚月平西。\n梦过重成梦，千门鸡乱啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"文天祥","text":"淡烟枫叶路，细雨蓼花时。\n宿雁半江画，寒蛩四壁诗。\n少年成老大，吾道付逶迟。\n终有剑心在，闻鸡坐欲驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜起","author":"文天祥","text":"梦破东窗月半明，此身虽在只堪惊。\n一春花里离人泪，万里灯前故国情。\n龙去想应回海岛，雁飞犹未出江城。\n客愁多似西山雨，一任萧条白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝应道中","author":"文天祥","text":"天阔抟南雁，淮途长北驱。\n甘棠成传舍，细柳作康衢。\n田海随时变，山河往日殊。\n征袍共衮绣，夜壁一灯孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚辰四十五岁","author":"文天祥","text":"东风昨夜忽相过，天地无情柰老何。\n千载方来那有尽，百年未半已为多。\n君传南海长生药，我爱西山饿死歌。\n泡影生来随自在，悠悠不管世间魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建康","author":"文天祥","text":"金陵古会府，南渡旧陪京。\n山势犹盘礴，江流已变更。\n健儿徙幽土，新鬼哭台城。\n一片清溪月，偏于客有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所怀","author":"文天祥","text":"世途嗟孔棘，行役苦期频。\n良马比君子，清风来故人。\n相看千里月，空负一年春。\n便有桃源路，吾当少避秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所怀","author":"文天祥","text":"万里青山两鬓华，老臣无国又无家。\n乾坤局促笼中鸟，风雪飘零粪上花。\n岁晚江空人已逝，天寒日短路何赊。\n书生不作纲常计，闻是东门已种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂庆成诗 其二","author":"文天祥","text":"清庙严更夜未央，珠星璧月璨殊光。\n香飘黄道移天步，烛引红纱转殿廊。\n祼荐交神诸室醉，骏奔执豆庶羞芳。\n都人报道君王喜，净睹和銮入建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂庆成诗 其四","author":"文天祥","text":"皇心寅畏格皇天，旱岁俄书大有年。\n报本愈严阳馆祀，庆成复第从臣篇。\n祠官瑞纪灵光烛，太史星占贯索捐。\n黼座正中图贡上，万方归德更乾乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂庆成诗 其三","author":"文天祥","text":"淳熙稽古再明禋，制作规模汶上新。\n未植羽旄朝万国，首将玉币荐三神。\n灵车欲下天先雨，御幄虚张帝在茵。\n熙事告成中外贺，与民同乐霈恩均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂庆成诗 其一","author":"文天祥","text":"晓移天仗入思成，雨脚先驱御路清。\n虹影倒垂云气卷，日轮飞上衮衣明。\n韶音九奏真游格，酌献三行福酒倾。\n景命有开知未艾，万年孙子庆纯精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明堂庆成恭进诗","author":"文天祥","text":"于皇艺祖德乘乾，圣主宣光奕叶前。\n运再庚申皇建极，祀同癸亥数参天。\n中严外办三千礼，累洽重熙四十年。\n愿赞帝心长对越，至忱功用贯垓埏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗山长存叟兄弟来谢宴山中","author":"文天祥","text":"天开盘谷隐，春到浣溪家。\n一水楼台影，满山桃李花。\n春风寄横笛，夜月拟乘槎。\n政好逢佳客，江空北斗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"英德道中","author":"文天祥","text":"海近山如沃，杼深屋半芜。\n乾坤正风雨，轩冕总泥途。\n自叹鸢肩薄，谁怜鹤影孤。\n少年狂不醒，夜夜梦伊吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵驿 其二","author":"文天祥","text":"万里金瓯失壮图，衮衣颠倒落泥涂。\n空流杜宇声中血，半脱骊龙颔下须。\n老去秋风吹我恶，梦回寒月照人孤。\n千年成败俱尘土，消得人间说丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵驿 其一","author":"文天祥","text":"草合离宫转夕晖，孤云飘泊复何依。\n山河风景元无异，城郭人民半已非。\n满地芦花和我老，旧家燕子傍谁飞。\n从今别却江南日，化作啼鹃带血归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨雪","author":"文天祥","text":"秋色金台路，殷殷半马蹄。\n因风随作雪，有雨便成泥。\n过眼惊新梦，伤心忆旧题。\n江云愁万叠，遗恨鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南安军","author":"文天祥","text":"梅花南北路，风雨湿征衣。\n出岭谁同出，归乡如不归。\n山河千古在，城郭一时非。\n饥死真吾志，梦中行采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]