[{"title":"江仲嘉行邑将归见寄绝句次韵 其六","author":"程俱","text":"诗城端欲据天山，酒户犹能敌饮仙。\n幽事相关公事了，如屏千嶂翠连绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江仲嘉行邑将归见寄绝句次韵 其七","author":"程俱","text":"闻说人间有阆风，飞霞无路欲谁从。\n只今华发惊衰态，却羡苍松独耐冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江仲嘉行邑将归见寄绝句次韵 其八","author":"程俱","text":"君知曹子幻奇功，法界由来一性风。\n等是少年誇狡狯，杖端聊挂蕊珠宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶翰林令画僧作偃松于石林堂壁有诗余次韵 其一","author":"程俱","text":"试驱毛颍沐方诸，盘礴经营惨澹初。\n莫作世间虚妄见，笔端三昧入无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶翰林令画僧作偃松于石林堂壁有诗余次韵 其二","author":"程俱","text":"当年溜雨三千尺，回首丘山力万牛。\n故作轮囷攲绝壁，苦心苍节俯清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶翰林令画僧作偃松于石林堂壁有诗余次韵 其三","author":"程俱","text":"人间境物无非画，笔下丹青却是诗。\n流出胸中无尽藏，翰林词笔是良师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叶翰林令画僧作偃松于石林堂壁有诗余次韵 其四","author":"程俱","text":"眼中突兀蓝田馆，前日空山秽不治。\n聊遣上人供幻事，戏将方丈纳仇池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄谢叶翰林见招 其一","author":"程俱","text":"风流刺史从英游，况复西湖菡萏秋。\n授简岂堪陪兔苑，举鞭聊欲醉荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄谢叶翰林见招 其二","author":"程俱","text":"白雪词章胜远游，胸中清鉴有阳秋。\n玉堂正要如椽笔，肯使经年借一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题许徽猷韩干二马","author":"程俱","text":"并辔长途骋二龙，紫骝飞度玉花骢。\n何年照影瑶池暮，露鬣风鬉惨澹中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观大洪淳公送觉上人颂演为四首 其一","author":"程俱","text":"异类潜行未兆前，个中谁辨正中偏。\n沈沈海底三更月，杳杳长空万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观大洪淳公送觉上人颂演为四首 其二","author":"程俱","text":"昂藏头角耸摩天，玉马嘶风曲调全。\n却向大洪山顶上，一声惊散野狐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观大洪淳公送觉上人颂演为四首 其三","author":"程俱","text":"回途莫守寒岩草，岩前枯木春风到。\n玉颜年少满头霜，花落花开不知老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观大洪淳公送觉上人颂演为四首 其四","author":"程俱","text":"耕破威音那畔田，向来荒草不知年。\n铁牛闲卧无人唤，回首芃芃绿满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潜老秋日山中 其一","author":"程俱","text":"夜漏初添数刻长，毛尘何足较牛羊。\n道人一念三祗劫，春草秋花自在香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潜老秋日山中 其二","author":"程俱","text":"箨龙变化九天去，草木如空冀北群。\n竹林之游宁复得，邈若山河怀五君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和潜老秋日山中 其三","author":"程俱","text":"琅玕摧空一叶下，尘鉴出柙南山高。\n卧看微云澹河汉，佳句不复推亭皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三峰草堂 其一","author":"程俱","text":"庭前双梧一亩阴，禅房萧森花木深。\n清霜脱叶空山响，梦觉寒窗松月林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三峰草堂 其二","author":"程俱","text":"雨洗千山翠欲浮，稻畦松涧已争流。\n朝来风急凝云尽，历历钟声过五州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观元章帖有寄王宝文绝句戏和","author":"程俱","text":"好奇不减猗犴叟，放论犹嫌石户农。\n怪底西山增爽气，佳城萧瑟閟滕公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其一","author":"程俱","text":"二纪重来一苇杭，脱身兵火走风霜。\n安知老境今如此，满眼旌旗两鬓苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其二","author":"程俱","text":"北固山头竖白旗，西津渡口仆姑飞。\n将军笑引三千骑，洗马鹅翎问道归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其三","author":"程俱","text":"江汉长哦向渺茫，白沙朱雀正相望。\n东巡百万临瓜步，拭目中兴望我皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其四","author":"程俱","text":"拜表时时上阁开，九重葱郁信佳哉。\n天旋地转会有日，填咽都门龙御回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其五","author":"程俱","text":"瑶台侍臣不可作，严谷道人今也亡。\n扶黎三径非无约，一笑凌云有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避寇仪真六绝句 其六","author":"程俱","text":"茅茨低小对青山，准拟馀年向此闲。\n南望青山是黄鹤，欲凭黄鹤寄书还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟仪真江上连日风雨作六言遣闷 其一","author":"程俱","text":"汹汹风号万窍，冥冥雨暗长江。\n午梦归寻三径，南山恰对书窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟仪真江上连日风雨作六言遣闷 其二","author":"程俱","text":"常寂光遍一切，胜义谛即世间。\n正自纵横五位，不妨透脱三关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟仪真江上连日风雨作六言遣闷 其三","author":"程俱","text":"韦杜去天尺五，鲲鹏击水三千。\n作意公能活国，馀生我得安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟仪真江上连日风雨作六言遣闷 其四","author":"程俱","text":"上流下流兵渡，江南江北人归。\n寒尽春至梁苑，天旋日转皇畿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题太守钱侍郎所藏薛少保独鹤图和韵三首 其一","author":"程俱","text":"紫青之骥下阊阖，昂然野态犹高骞。\n矫如乔松欲仙去，袂耸霞外双眉轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe4