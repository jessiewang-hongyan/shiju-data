[{"title":"奉饯万安赞府兄长之官 其三","author":"姚勉","text":"吾族年来亦自奇，两年两度报瓜时。\n班行笑我难安脚，州县输君省皱眉。\n学不济时非有用，官能及物尽堪为。\n山林肥遁方深密，梦入春池但寄诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉题吕氏宜老堂","author":"姚勉","text":"此堂清不著珠玑，只要双亲佚老宜。\n春酒尽堪眉寿介，斑衣长似乳时嬉。\n妇垂鹤发陪姑纬，翁撚银髯课子诗。\n饱饮菊花潭上水，鸡窠犹自拜孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招友人凤山观雪","author":"姚勉","text":"霜风才办两朝晴，怪听敲窗又雨声。\n一夜忽生虚室白，六花已与短檐平。\n酒斟销帐真成俗，兴尽扁舟且未清。\n想得凤山高处好，试来著屐水精城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放生池纳凉晚归","author":"姚勉","text":"湖面轻烟起，前山渐不分。\n钟声连寺答，人语隔船闻。\n吟客衣生月，归僧笠带云。\n及城门未掩，灯火已纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郁孤台九日","author":"姚勉","text":"天风吹上郁孤台，太守登高领客来。\n地近九霄星斗大，秋涵八景水云开。\n吟成一径黄花笑，召节欢传紫诏催。\n琴鹤自随千古事，兴来且与尽馀杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客中遇雨","author":"姚勉","text":"名缰驱远役，挈挈未遑安。\n春只雨中过，花从客里看。\n水声添昨夜，风力尽馀寒。\n但喜前程阔，不愁行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思家信不至","author":"姚勉","text":"又是秋风入芰荷，尚无黄耳到如何。\n慈亲想自精神健，娇女应添智慧多。\n踪迹自嗟成漫浪，利名底苦欲奔波。\n几时了却胸中事，只傍南溪理钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事","author":"姚勉","text":"行野醒春困，看山立昼晴。\n鸠啼青樾破，鹭匝绿秧行。\n物到忘机乐，人因远俗清。\n觅诗无断句，敲板午茶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"姚勉","text":"明明月影带河流，雁在天边鹤在洲。\n四壁蛩催幽梦觉，满囊萤助读书油。\n金茎露点三更冷，银汉星移万里秋。\n醉倚不堪回首处，双清风月尽淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送万仲荣赴省","author":"姚勉","text":"梅梢枯处忽东风，魁压千花一点红。\n欢喜马头飞雪处，安排龙首綵云中。\n内讧外阻忧方大，东拄西撑策已穷。\n试了南宫趋北阙，好输鲠论发天聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王元高兄弟东上 其二","author":"姚勉","text":"去去龙门客又新，一鞭猛过禹涛春。\n伫观极论陈三策，切莫潜兵救八人。\n沂国素无温饱志，梅溪不作谄谀臣。\n二难兄弟当如此，及第归来喜拜亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王元高兄弟东上 其一","author":"姚勉","text":"前岁亲从月殿回，素娥引领到瑶台。\n桂枝指点教先折，仙籍披陈看后来。\n恰见拱辰名字接，一如公序弟兄魁。\n预将消息而今报，好作百花头上梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王仲安归武昌","author":"姚勉","text":"武昌洲畔去，端不为鱼肥。\n要起初平石，同娱莱子衣。\n夜长秋雨急，天阔白云飞。\n何日鹊乌喜，北风鸿雁归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王希圣归兴国赴举","author":"姚勉","text":"之子趣装归，占黄已在眉。\n雕虫观暇日，荐鹗信秋期。\n喜有传衣钵，惭无助鼓旗。\n捷书来报我，端的菊花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王新恩赴省","author":"姚勉","text":"老泉坡颍成名了，曾应君家木假山。\n父与子偕升礼部，弟随兄去入贤关。\n龙驱万马空如洗，凤挟双雏逸莫攀。\n早早归来荣昼锦，绿衣争映綵衣斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同窗赵章甫上舍入京 其一","author":"姚勉","text":"正谊群英自蔼然，喜君已是著先鞭。\n翼抟北海三千里，身在西雍尺五天。\n学舍快升优褐上，酒楼莫恋软红边。\n双亲教子相期切，成取功名趁妙年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同窗赵章甫上舍入京 其二","author":"姚勉","text":"一别西湖又见春，梦魂长是绕湖滨。\n为烦竹阁揩题墨，更向梅花道故人。\n槐市旧游休复问，龙门佳客尚能新。\n明年傥共昕庭对，愿过当时蔡与陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别张倅","author":"姚勉","text":"满襟霁月皎无尘，爱客宁嫌客过频。\n倚竹题诗惊思妙，傍花寻柳见情真。\n如今南浦伤行客，此处西湖有主人。\n与著三年端的约，孤山同访早梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别赵倅","author":"姚勉","text":"宝婺星边太白仙，驭风飞下锦河边。\n朅来尽散阳春脚，归去独撑明月船。\n名重题舆千里郡，诏催步履八花砖。\n只愁此后民艰食，谁与邦民作食天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈县尉之太和新任","author":"姚勉","text":"古来尉自号神仙，况是栖身快阁天。\n好向盘根施利器，如登熟路著先鞭。\n可知岂患无知己，自爱应能不爱钱。\n近世末僚卿相少，愿储远业继前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈新恩赴殿试","author":"姚勉","text":"桂花香满月轮秋，稳送鹏程万里游。\n身近清光瞻帝座，手携多士上瀛洲。\n戊申奏对规模阔，庚戌抡魁气数周。\n陈亮自来天下选，老年更好作龙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送罗道甫归庐陵应举","author":"姚勉","text":"西风满路桂枝香，催整登云步月装。\n群辈总皆推德行，三年稔已听文章。\n琅琅议论须披腹，琐琐功名只探囊。\n捷了早来谈杰作，耸闻鸣凤瑞朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑编修子四省元 其二","author":"姚勉","text":"著身书带草堂中，得与郎君砚席同。\n能学鸣蝉宜赋好，不求野鹜自书工。\n壮怀直拟联龙虎，别恨休惊背燕鸿。\n他日东山香宇宙，格斋方不负诚翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑编修子四省元 其一","author":"姚勉","text":"文章得印天尝靳，家世传灯古亦疏。\n幸甚迁能紬石室，惜哉昶亦误银车。\n君今自是人龙子，名复高横荐鹗书。\n读饱邺侯三万轴，放高通德旧门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送洪右司去官","author":"姚勉","text":"恋陟怀迁怕去官，近时君子退如难。\n中书堂拂高风袖，神武门留太华冠。\n此举直堪惊醉梦，斯人端是障狂澜。\n先生真正平斋子，凛凛清标万古寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡教授之沅水任 其二","author":"姚勉","text":"近闻沅水路，今亦是风寒。\n忠信如先教，边陲尽易安。\n勿云师可去，甘与国辞难。\n文武能兼尽，功名更好看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送胡教授之沅水任 其一","author":"姚勉","text":"君今鸣木铎，名与芷俱香。\n后夜月千里，美人天一方。\n往追湖学躅，更挈楚臣芳。\n了却皋比事，归来振鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵佥判美任 其二","author":"姚勉","text":"底事三年里，才膺两荐书。\n邦侯辨宝晚，使者设罗疏。\n知己初何计，能官自有馀。\n汉庭今欠者，子政与朱虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵佥判美任 其一","author":"姚勉","text":"佐幕此三年，邦人尽说贤。\n吏寒清夜月，民暖小春天。\n祖帐旗交綵，归装石压船。\n甘棠在何许，积粟市桥边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵判县美任改除阆倅","author":"姚勉","text":"仁如爱日洁冰壶，鞭不曾施岂用蒲。\n吏服官清羞鬻狱，民怜邑窘竞输租。\n甘棠舍在春常满，行李船空月亦无。\n展骥分州犹未称，合于紫禁著飞凫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梁新恩梦雷归乡","author":"姚勉","text":"昼锦赋归欤，梅花万里馀。\n同盟难此别，后会定何如。\n袍绿为亲寿，编青课弟书。\n燕山今再有，五桂耀乡闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送童子敬赴省","author":"姚勉","text":"满望飞腾几许年，一闻充赋喜如颠。\n金经炉冶锋方锐，木饱风霜节始坚。\n此去稳登云里路，定知荣冠籍中仙。\n近闻上蔡鸬洲合，一似前年锦水连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡守劝驾乐语","author":"姚勉","text":"主人合作紫薇郎，引领群仙觐玉皇。\n满袖风云生羽翮，排空牛斗避光芒。\n锦江家谶声名在，金榜巍科姓字香。\n典贡春官来岁事，芝香趣下瑞芝堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡守宴状元乐语","author":"姚勉","text":"几多文士踏槐黄，实出伦魁在瑞阳。\n千古河连留地谶，一声胪唱破天荒。\n金钗笑拥龙头客，宝篆浓薰燕寝香。\n方国荐贤蒙上赏，匪晨有诏下芝堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻吴山钟","author":"姚勉","text":"举世昏昏醉梦中，一声震撼自天宫。\n鳌呿大海三山动，狮吼危巅万兽空。\n待漏早朝惊假寐，求衣宵起寤宸聪。\n须臾浊雾都收敛，唤出扶桑皎日红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽十尊长居士","author":"姚勉","text":"聘君今已矣，月入少微星。\n又失宗盟长，空悲族谱亭。\n生刍嗟莫致，歌薤若为听。\n只喜阴功在，三槐已绿庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽杨玉溪","author":"姚勉","text":"蜀道艰难又几年，锦城断础带凄烟。\n从今井络亏全势，只恨坤舆失巨贤。\n山有蛾眉空积雪，国无峻柱可擎天。\n英魂楚楚能知否，应在青城作浪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽赵制机","author":"姚勉","text":"见说襄阳堕甑时，公尝前此料危机。\n伤心汉岘疆重拓，回首羊邹事已非。\n安得筹边书日报，谁能荐士剡天飞。\n当年子羽知吴玠，尚作西撑一柱巍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后久不到湖上晚与客到断桥","author":"姚勉","text":"病后久不出，未知湖上秋。\n偶逢佳客至，小作断桥游。\n荷暗仍香岸，柳疏犹舞楼。\n相期明月夜，更此放扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄邹希圣兄弟","author":"姚勉","text":"槐花又向此秋黄，槐未黄时趁早忙。\n龙到水高冲浪化，鹏因风厚贴云翔。\n棠金镞取霜筠健，越砥磨开电剑光。\n努力晨窗并夜案，天庭已动桂枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题上饶周仪仲西畴","author":"姚勉","text":"闻君负北郭，筑室扁西畴。\n绿水人家晓，黄云穑事秋。\n吾生如有此，外物更何求。\n堪卜东邻否，耕馀著钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题陈肩夔云锦窗","author":"姚勉","text":"八窗面面受新凉，万盖盈盈拥靓妆。\n倩得天孙云杼轴，织成骚客锦衣裳。\n雨翻绿净盘中玉，风搅红娇镜底香。\n个里搜诗最奇绝，吐为黼黻五文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题陈肩夔兄弟梦草堂","author":"姚勉","text":"谢池草句本无奇，千古流传五字诗。\n祇是可人醒枕席，许多生意在埙篪。\n信渠风雨听眠处，快甚江山得助时。\n顾我此怀今已矣，羡君兄弟撚吟髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题武安节推同年万君定翁露香堂","author":"姚勉","text":"尽将心事写成碑，大要操修在不欺。\n此一瓣香前辈似，只三个字老天知。\n素瓶贮豆应先满，匹马携琴料自随。\n吾榜得人今又盛，会排介甫击升之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨兴","author":"姚勉","text":"晨兴未梳盥，此兴亦何清。\n看竹钩帘坐，浇花绕径行。\n葛巾聊复正，尘事即时生。\n安得箪瓢足，扃门遂野情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦太夫人如平生","author":"姚勉","text":"山鹿随麋乐，林乌反哺慈。\n伤心惟梦里，有母似儿时。\n爱子平生念，思亲隔世悲。\n松楸霜露冷，北望泪交颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳道中","author":"姚勉","text":"翠驾凋零尽，芒鞋响叶声。\n晴江潮后绿，寒日竹间清。\n曝背翁微睡，挑包僧自行。\n离京才一日，便觉惬幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游感山题甘露台","author":"姚勉","text":"讲师曾此雨天花，台筑山椒几岁华。\n一盖云松擎羽葆，四盘江水走龙蛇。\n好教绝顶崚嶒出，莫放浓阴荟蔚遮。\n应有醍醐馀味在，僧房试觅一杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上隐者所居","author":"姚勉","text":"家计松梅竹，日程琴酒棋。\n呼猿僧到处，放鹤客来时。\n壁上皆苏字，窗门只白诗。\n卜邻心已决，未得买山资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登北高峰","author":"姚勉","text":"秋风吹鬓影，凉意足登山。\n人立晴林杪，猿啼霜雾间。\n好山多佛占，浮世只僧閒。\n我亦耽奇者，禅扉日叩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登四圣观月桂亭有感","author":"姚勉","text":"将军休战伐，居士号清凉。\n亭创烟萝古，山深月桂香。\n梦魂犹朔漠，风景已钱塘。\n往事都休问，钟声又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中积雨","author":"姚勉","text":"才起程时雪絮春，雪馀又是雨兼旬。\n肩舆聊复能安稳，步屧其如受苦辛。\n楮贱米穷尝世味，风餐露宿鍊官身。\n一朝傥有青云上，莫忘泥耕水耨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道傍水阁","author":"姚勉","text":"一川澄不动，山色浸分明。\n噪晚鸦寒甚，窥鱼鹭瘦生。\n人家江阁好，天下钓翁清。\n想此幽居者，何知有利名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新婚致语","author":"姚勉","text":"珠帘绣幕蔼祥烟，合卺嘉盟缔百年。\n律底春回寒谷暖，堂间夜会德星贤。\n綵軿牛女欢云汉，华屋神仙艳洞天。\n玉润冰清更奇绝，明年联步璧池边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新晴散步","author":"姚勉","text":"晴晓芳蹊润，幽寻得自怡。\n露粘行草蝶，风舞罥花丝。\n竹静闻邻话，林虚度客棋。\n意行无伴侣，池上只莺知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪山堂玩月","author":"姚勉","text":"前山杳霭翠烟凝，几点疏星隔岸灯。\n不是飞来千里月，如何照彻一壶冰。\n天开图画无穷趣，人在林峦最上层。\n动智静仁须有得，栏干莫只等閒凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题华严寺","author":"姚勉","text":"萧寺恭拈一瓣香，汉宫遥上万年觞。\n庚申再造皇基远，甲子新开御历长。\n万物总归春宇宙，八荒都入寿封疆。\n小臣政此朝天阙，葵藿倾心仰太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题朱氏梅芳书院","author":"姚勉","text":"玉梅苍竹拥冰壶，中有扬雄宅一区。\n地占清虚开境界，人从确实作工夫。\n穷经得趣床横易，体道存心壁画图。\n格物致知功用大，的传愿继考亭朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题百花林书堂","author":"姚勉","text":"书堂静占百花林，蜀锦香浮一径阴。\n杨柳软风吹雨醒，海棠轻雾拥春深。\n盈樽有酒供清醉，满眼皆诗足胜吟。\n冰雪相看人更好，竹君梅友岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西湖竹阁寺 其二","author":"姚勉","text":"千古清风白乐天，昔时曾此饱谈禅。\n自从西阁无吟迹，惟有东坡嗣旧传。\n来往祇应湖上寺，听闻误说海中仙。\n我来再拜祠堂下，笑摘岩花荐井泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西湖竹阁寺 其一","author":"姚勉","text":"入门才见万琅玕，便觉玲珑日影寒。\n峰势近环檐外立，湖光更好竹中看。\n烟霞古淡僧容瘦，风露清高鹤梦残。\n已占两亭凉坐足，再须登阁倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钓台","author":"姚勉","text":"等閒伸脚动天文，须信乾坤系此身。\n天上有星犹是客，汉庭何事肯为臣。\n祇当泉石容真隐，安可文书役故人。\n岂但云台高不似，钓台草木至今春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题胡景颜双清堂","author":"姚勉","text":"石滩江上一诗仙，家住双清小有天。\n句里出奇超象外，人閒无事到吟边。\n读骚长在滋兰畹，好客多留种秫田。\n见说尚参颜乐处，今时谁似若人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题族子霆伯西征录","author":"姚勉","text":"閒味西征录，霜橙嚼鲙齑。\n俊声压湖北，诗派接江西。\n镇日心相忆，何时手重携。\n相期一樽酒，重与叩云溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题道士碧潭","author":"姚勉","text":"幽人何处倚渔竿，百顷清潭浸碧寒。\n不动一波疑水定，中涵万象觉天宽。\n山将螺髻堆铜镜，月借玻瓈现玉盘。\n莫作窈深无底看，是间应有卧龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠月堂徐相士","author":"姚勉","text":"衡门选龙首，摸索未容易。\n龙首许黄扉，却亦非难事。\n济物乃素心，好爵岂予志。\n时来亦不辞，焉用早谀媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]