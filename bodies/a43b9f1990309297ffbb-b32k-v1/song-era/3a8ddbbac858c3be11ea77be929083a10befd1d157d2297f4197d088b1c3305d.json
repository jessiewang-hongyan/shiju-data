[{"title":"偈颂七十八首 其十八","author":"释正觉","text":"谁将活眼窥空劫，我道宗枝染浩春。\n头角峥嵘藏不得，青原门下有祥麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十三","author":"释正觉","text":"一盘黑白互交罗，生杀其中细琢磨。\n樵人疑著当头著，不觉腰閒烂斧柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十四","author":"释正觉","text":"寒灰发焰旧家风，恰恰当人受用中。\n片雪飞来炉上尽，通身无像不同功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十一","author":"释正觉","text":"半夜谁传无尽灯，黄梅席上许卢能。\n虚明自照非心力，分付丛林了事僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十七","author":"释正觉","text":"云敛长空风日和，太平樵牧共高歌。\n衲僧饭饱无佗事，密密机前弄玉梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十七","author":"释正觉","text":"本源无风波，真界绝涯畛。\n木人步月归，转侧功勋尽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六","author":"释正觉","text":"一亘清虚夜正央，桂宫老兔冷喷霜。\n混融明暗无分处，谁辨个中偏正方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十五","author":"释正觉","text":"功勋密处转身难，转后家风又觉宽。\n黯黯旧山青落眼，涣然霜雪洗蓑寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○八","author":"释正觉","text":"萧然一念未萌初，露柱怀胎辨得无。\n风扫馀云月未上，霁虚廓净绝方隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十五","author":"释正觉","text":"去时还复似来时，明月芦华夜不迷。\n转棹又归何处去，秋光目断水天低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九九","author":"释正觉","text":"一灯分耀百千灯，个事宗家谁也曾。\n少室相传断臂可，黄梅分付坠腰能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十八","author":"释正觉","text":"劫火炎炎是事灰，劫空空处有灵台。\n更无妍丑成痕垢，妍丑俱从个里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一一","author":"释正觉","text":"凡圣通同共一家，寂光田地看生涯。\n而今选佛心空去，自有丘园开觉华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○一","author":"释正觉","text":"曾到家山里许看，星河濯月霁天寒。\n个时失却娘生口，始信从来鼻孔宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十二","author":"释正觉","text":"柳线垂金莺语滑，华棚张锦蝶飞忙。\n见闻里许通消息，谁得先生点铁方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六三","author":"释正觉","text":"须知风动心摇树，果见云生性起尘。\n雨霖霖兮日杲杲，点头弥勒解分身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五","author":"释正觉","text":"来来去去山中人，识得青山便是身。\n青山是身身是我，更于何处著根尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九七","author":"释正觉","text":"清白传家雪月光，玉壶中有转身方。\n情乾识尽功勋断，不觉全身入帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七一","author":"释正觉","text":"老大丛林快说禅，不将禅拄口皮边。\n谷深山远空无像，何处人呼应不圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二七","author":"释正觉","text":"一枝秀出栴檀林，想见馨香慰众心。\n不负老兄开凿力，当风子和鹤鸣阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四二","author":"释正觉","text":"轻烟羃羃衲僧家，节物迎春气象华。\n流水落华无限意，游山消息付长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二八","author":"释正觉","text":"影略门前倒刹竿，个中消息授传难。\n玲珑侍者能相委，盘走明珠珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三九","author":"释正觉","text":"明月芦华四望连，转身人上合同船。\n借功自有旁参事，历历机头看正偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其十四","author":"释正觉","text":"开炉岁岁是今朝，暖气潜通称我曹。\n可惜丹霞烧木佛，翻令院主堕眉毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十五","author":"释正觉","text":"衲僧舌头真个自由，浑仑里许没锥钩。\n轮扁斲工不授子，庖丁游刃无全牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八四","author":"释正觉","text":"莫向枯龟版上钻，衲僧开口见心肝。\n莲华荷叶出未出，做尽工夫转觉难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十八","author":"释正觉","text":"直到劫空明自己，有无不堕超生死。\n夜船载月钓沧浪，清白传家只如此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十一","author":"释正觉","text":"苏秦尝佩六国印，许由还厌一瓢风。\n了无佗相能通变，可笑僧繇画志公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○○","author":"释正觉","text":"闻说英雄苦战争，四方歧路自难行。\n而今踏著长安道，始信家邦久太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十一","author":"释正觉","text":"凛凛将军令已行，八荒四海要澄清。\n提来剑气干牛斗，洗荡氛埃见太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一二","author":"释正觉","text":"三千世界出弹指，百亿庄严集化身。\n寿域无疆同道久，河沙劫数一成春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七九","author":"释正觉","text":"泥泥水水一年农，收拾将来碓下舂。\n炊软香分千钵饭，肚皮参饱放颓慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十八","author":"释正觉","text":"吾家日日选场开，及第心空有大才。\n莫把桂枝零碎折，为佗和月抱将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九五","author":"释正觉","text":"香林腊月火烧山，关楗如今透底难。\n无碍机锋能自在，虚空挥剑不成瘢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十六","author":"释正觉","text":"空劫威音前，别有一壶天。\n御楼观射猎，不是刈茅田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十七","author":"释正觉","text":"华鸟不来空过春，牛头山上懒慵人。\n自心净故元无作，放下许多閒苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九一","author":"释正觉","text":"玉女依稀夜动机，锦丝历历吐梭脐。\n水天湛碧全功堕，雪月寒清一色迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十七","author":"释正觉","text":"皓然雪月净无埃，一色功中更放开。\n唤起牧童蓑底梦，白牛鼻孔拽教回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斜川道上望庐山三绝 其一","author":"释正觉","text":"真味酣心倚瘦筇，萧骚风啸一蹊松。\n无人共语圆通境，笑看云吞石耳峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斜川道上望庐山三绝 其三","author":"释正觉","text":"水从乌石山前转，人在斜川岸上行。\n寂漠柴桑古祠下，我来无酒酹渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斜川道上望庐山三绝 其二","author":"释正觉","text":"青山放足溪转腰，蓑翁理网儿摇舠。\n先生畴日骑鱼去，岸上人家谁姓陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"符十五郎求颂 其二","author":"释正觉","text":"圆虚里许得真游，离水犀通一点秋。\n机应无私登鸟道，妙同明月静随流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪窦中岩夜坐","author":"释正觉","text":"哀猿叫落中岩月，野客吟残夜半灯。\n此景此时谁会得，白云深处坐禅僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善应不触","author":"释正觉","text":"出门云水任茫茫，相应相酬许当行。\n一切时无第二念，雪峰于此谢灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登清凉三山亭","author":"释正觉","text":"絮风花雨一春残，未厌兹亭夜倚阑。\n隐隐三山抱江月，清凉境界露松寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真求赞 其六","author":"释正觉","text":"槁寒初不展家风，默默神游透劫空。\n百草头边兴化事，自然秋色水天同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其五","author":"释正觉","text":"服像中情将有得，江湖底事勿相忘。\n橘洲白鸟秋成伍，渔火莼羹蓬底香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其一","author":"释正觉","text":"未能老养卧林麓，要乞优恩除发须。\n濯足沧浪岁寒事，终来清友石菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其三","author":"释正觉","text":"嘤嘤鸟鸣如客情，行行柳眼向人青。\n投心旧友春成物，汲水前溪月下瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其二","author":"释正觉","text":"挽衣苦怪不我住，怀事乞成今乃时。\n雷动定知开蛰户，春寒无要勒华枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其四","author":"释正觉","text":"梦里结忧三变事，觉来还喜一成春。\n莺华时节洗衰落，不信馀寒犹著人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩山老人告行作六偈送之 其六","author":"释正觉","text":"应缘分影来池月，游世无心出岫云。\n适意归来尖屋底，蔬畦还与力锄勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一知殿化佛殿僧堂中灯油求颂","author":"释正觉","text":"佛灯谁我续光明，果若莲开大梦醒。\n香草有心持洁白，兰膏无脚湛寒青。\n默耕化外那知夜，真照壶中不觉冥。\n家世儿孙传底事，从教辉耀显门庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一禅人化盐求颂","author":"释正觉","text":"泥沙淘洗浪煎乾，一片照人冰雪寒。\n意得试莲浮卤力，默知随箸入蔬盘。\n万家婉婉能相助，众口调和信不难。\n无像有神聊勘过，圆通眼在舌头端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一禅人出丐求颂","author":"释正觉","text":"一霎山前春雨乾，丛林气韵洗衰寒。\n水明玉兔随征棹，线重金鳞上钓竿。\n午钵莫嫌分饭甑，千僧无念集蒲团。\n化机妙应头头准，手眼通身不著谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月朔与法上人南谷行 其一","author":"释正觉","text":"拖策鸣林游兴浓，要将丘壑醉青瞳。\n黄华尚媚秋馀日，锦树那禁霜后风。\n转岫蛇行岐屈曲，断崖虹卧水丁东。\n谁悭剧味平生事，分付饮茶谈笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元后二日过谦师庵","author":"释正觉","text":"横溪一径两山分，深翠茏葱竹日昏。\n流水漱冰寒有骨，閒云敛霁雪无根。\n应容野毳来投饭，不管春眠往扣门。\n窗几薰炉摇篆字，龟床麈语对清温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与天池信长老","author":"释正觉","text":"晚岁丛林闹苇麻，可中著眼辨龙蛇。\n行当五路我能事，坐断孤峰渠作家。\n佛法从来如嚼蜡，朋俦此去似团沙。\n音书不寄思惟尽，千里同风却较些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与传道者","author":"释正觉","text":"残毳编衣裹槁形，胸中底事独醒醒。\n亡机冲应用时妙，活眼冷窥虚处灵。\n语秀锦云春片段，气清梅雪晓零星。\n而今功尽牛头懒，华鸟不来风扫庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与充维那","author":"释正觉","text":"机梭未动若为颜，一点虚灵入道环。\n明月光中窥自己，白云影外到家山。\n金鳌转侧夜潮落，玉马嘶鸣春信还。\n得手应心无不可，脱然时事岂相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与因典座","author":"释正觉","text":"胸中行脚事分明，亲见芙蓉缀晚英。\n黑马踏霜元不迹，白鱼吹水了无声。\n投机曾弄无须锁，出手相扶折脚铛。\n去米去沙还未可，要须偏正并头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与孙宣教","author":"释正觉","text":"作别江头五载馀，海边相访未嫌迂。\n山林意与世几绝，丘壑姿逢秋更癯。\n约我道耕新活计，辍君诗战老工夫。\n儿婚女嫁谁家事，居士有心从马驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与观禅者","author":"释正觉","text":"豁净虚通入觉场，体前一段本来光。\n孤禅恰恰如担板，默照明明似面墙。\n秋光芦华两岸雪，夜寒桂月一船霜。\n迢迢象外行归路，雁字低低正夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与李居士","author":"释正觉","text":"枯禅胸底洗馀纷，一点虚明湛若存。\n刹刹尘尘成净土，华华叶叶发灵根。\n无心颇肖云为润，有照浑如月破昏。\n舒卷纵横俱在我，个人真得总持门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与诺侍者","author":"释正觉","text":"梦回茶碗手亲扶，雅意沩山转道枢。\n自唤主人酬一诺，谁违尊者应三呼。\n死生到日还能否，辜负当年是有无。\n妙得古人行履处，了无些事作工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与辅禅人","author":"释正觉","text":"方游捋遍虎髭须，空劫壶中探有无。\n风月满头功未转，江山入骨病难扶。\n针投芥粒机非爽，弦续鸾胶道不枯。\n归去丛林看仪羽，丹山出处九包雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与黄道友","author":"释正觉","text":"人头膏火底心休，来预林俦默默游。\n犀晕成时月魄夜，雁行断处霁容秋。\n百年分付三椽下，万象峥嵘一指头。\n归去懒融无伎俩，庵前华鸟莫相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与楷知仓","author":"释正觉","text":"米坊能者较些些，七百僧中独作家。\n半夜传来衣有据，机前收得镜无瑕。\n祖师只么闲舂碓，若子如今莫撒沙。\n古井先秋念枯冷，金绳钓出玉虾蟆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与福州满禅人","author":"释正觉","text":"而今别后记丁宁，曹洞家风句未形。\n月满凤林寒不梦，年深龟壳灼犹灵。\n沈沈莫触蛇头毒，的的须明犀角星。\n便与放开聊展手，那时相见望州亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与演侍者","author":"释正觉","text":"白鸥定怪盟事寒，杖藜投社不多难。\n苇风华雪秋著岸，船月蓬霜夜转滩。\n丘壑身心徒役梦，江湖臭味赋游般。\n它时衣外传来物，唤得回头倒刹竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与辨庵主","author":"释正觉","text":"夹山钩上得芳鳞，不作当年棒喝嗔。\n直向劫前分手眼，端能化外拨机轮。\n是须眉底有筋汉，方契寰中无舌人。\n彻照自宗知细密，任从天下乐忻忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久上人出丐乞颂","author":"释正觉","text":"孤禅抖擞起僧毡，挂钵寒藤著瘦肩。\n破夜无私看霁月，开华不染出泥莲。\n底心众事水云饿，何处人家粥饭缘。\n寄语毗耶老居士，相投莫怪唤春眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卫进可寺丞腊月二十九日招我以蔬饭从容胜集其居之西一堂榜曰六湛意六处休复同一湛然且求语因作偈云","author":"释正觉","text":"风澜未作见灵源，六处亡功体湛存。\n诸法性空方得座，一弹指响顿开门。\n寒梅篱落春能早，野雪棂窗夜不昏。\n万像森罗心印印，根尘超豁妙无痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]