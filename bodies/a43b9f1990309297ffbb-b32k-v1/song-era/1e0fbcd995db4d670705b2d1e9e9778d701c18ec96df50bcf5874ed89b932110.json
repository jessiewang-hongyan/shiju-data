[{"title":"句 其一","author":"郭祥正","text":"明月随人渡流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"郭祥正","text":"欲寻铁索排桥处，只有杨花惨客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"郭祥正","text":"我爱临漳郡，地兼山海秀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临漳台","author":"郭祥正","text":"长风吹海作寒雾，往往六月披重袍。\n仙鱼通印胜鸮炙，荔子丹艳疑蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鸡笼山","author":"郭祥正","text":"神仙之府名鸡笼，千寻翠玉擎寒空。\n秀色凌风入城郭，半衔晓日金濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"郭祥正","text":"老鹤唳风□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"郭祥正","text":"唯欠子瞻诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"郭祥正","text":"落日疏云催晚景，残花美酒送闲心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈伯育","text":"与君分两石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题阮希圣东湖 其一","author":"刘浚","text":"四面溪山列画屏，一堂新创有馀清。\n湖光隔断红尘路，疑在金鳌顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题阮希圣东湖 其二","author":"刘浚","text":"轮啼白日竞匆匆，谁向闲中静养蒙。\n珍重先生高卧处，一窗黄卷是家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题阮希圣东湖 其三","author":"刘浚","text":"两堤杨柳先春绿，十里芙蓉入夏香。\n自得湖山供啸傲，会稽何独羡知章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示寂偈","author":"释真如","text":"昨夜三更，风雷忽作。\n云散长空，前溪月落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"范子奇","text":"宠命光辉出九重，夕郎捧诏未央宫。\n辍从近侍优耆德，暂殿名邦抚浙东。\n道过故乡观昼绣，政成载路播仁风。\n岂惟越俗欣渐惠，即看延登起茂功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承诸公酌别西郊分韵赋诗得戎字","author":"范子奇","text":"西戎未解严，置帅滥及蒙。\n自揣非长才，尚使制羌戎。\n仰赖庙堂算，庶几或成功。\n此行春已晚，柳丝华正红。\n联辔向名圃，四筵皆钜公。\n高韵薄虹霓，笑谈生清风。\n顾予实何似，有愧参其中。\n遽然千里别，不辞一樽空。\n浮云聚与散，临歧西复东。\n无以报礼意，举目攀飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄苏子瞻","author":"章惇","text":"君方阳羡卜新居，我亦吴门葺旧庐。\n身外浮云轻土苴，眼前陈迹付籧篨。\n涧声山色苍云上，花影溪光罨画馀。\n他日扁舟约来往，共将诗酒狎樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽桐竹","author":"章惇","text":"种竹期龙至，栽桐待凤来。\n他年跨辽海，经此一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢刘子先赠酒","author":"章惇","text":"洞霄宫里一闲人，东府西枢老旧臣。\n多谢姑苏贤太守，殷勤分送洞庭春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题李邦直蒙江初雪图","author":"章惇","text":"江头微雪北风骗，忆泊武昌舟尾时。\n潮来浪打船欲破，拥被醉眠人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日赴玉津园宴","author":"章惇","text":"南园高宴宠师臣，盛事仍随节物新。\n劝饯满倾仙室酒，赐花分得汉宫春。\n三朝主眷优元弼，五福天教萃一身。\n自惜云龙如此少，因公重感涕沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎丘次韵","author":"章惇","text":"阖闾城外小层峦，瘦竹寒松数里间。\n并岸逢僧知近寺，入门凿石渐登山。\n纯钩剑化空池在，幽独诗成白日闲。\n游客幸无官事束，何须斋舫敛昏还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒲宗孟游虎丘因书钱塘旧游","author":"章惇","text":"传闻城角舣行舟，自拥笙歌选胜游。\n偶为寒江阻潮汐，再容清赏属林丘。\n燕回吴苑风和雪，梦断钱塘月满楼。\n尽把苏杭好烟景，醉吟将去诧东州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过石醋铺","author":"章惇","text":"瘴霭潜消瑞气和，梅峰千里阔烟萝。\n人逢杂堠虽云远，路在好山宁厌多。\n啼鸟丛篁传木杪，瀑泉碎玉激岩阿。\n欲留征驭迟迟去，公檄催人不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫阁","author":"章惇","text":"我生山水乡，习得山中乐。\n每观唐人诗，梦寐思紫阁。\n欲为秦山行，常苦道路邈。\n君言旧曾游，使我心踊跃。\n我今既西来，而子滞天角。\n云山空在眼，诗酒乖侑酢。\n谁题壁间诗，岁久墨色薄。\n人生定能几，当此感离索。\n积霭浮青春，落日满岩壑。\n骊龙俨将驾，顾我犹淹泊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅山歌","author":"章惇","text":"开梅山，开梅山，梅山万仞摩星躔。\n扪萝鸟道十步九曲折，时有僵木横崖巅。\n肩摩直下视南岳，回首蜀道犹平川。\n人家迤逦见板屋，火耕硗多畬田。\n穿堂之鼓堂壁悬，两头击鼓歌声传。\n长藤酌酒跪而饮，何物爽口盐为先。\n白巾裹髻衣错结，野花山果青垂肩。\n如今丁口渐繁息，世界虽异如桃源。\n熙宁天子圣虑远，命将传檄令开边。\n给牛贷种使开恳，植桑种稻输缗钱。\n不持寸刃得地一千里，王道荡荡尧为天。\n大开庠序明礼教，抚柔新俗威无专。\n小臣作诗备雅乐，梅山之崖诗可镌。\n此诗可勒不可泯，颂声千古长潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"章惇","text":"每闻同列进，不觉寸心忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"章惇","text":"自奉鸾台直，叨随陟降踪。\n共陈尊圣嗣，屡请罢军容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释智本","text":"满口道不出，句句甚分明。\n满目觑不见，山山叠乱青。\n鼓声犹不会，何况是钟鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释智本","text":"祖翁卓卓荦荦，儿孙龌龌龊龊。\n有处藏头，没处露角。\n借问衲僧，如何摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释智本","text":"牙如刀剑面如铁，眼放电光光不歇。\n手把蒺藜一万斤，等闲敲落天边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释智本","text":"头戴须弥山，脚踏四大海。\n呼吸起风雷，动用生五彩。\n若能识得渠，一任岁月改。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"珙禅师","text":"三十年来握箭弓，三平才到擘开胸。\n半个圣人终不得，大颠弦外几时逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答大通偈","author":"释慈辩","text":"黑相白相，担枷过状。\n了不了兮，无风起浪。\n若问究竟事如何，洞庭山在太湖上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释应圆","text":"寒气将残春日到，无索泥牛皆?跳。\n筑著昆崙鼻孔头，触倒须弥成粪扫。\n牧童儿，鞭弃了。\n懒吹无孔笛，拍手呵呵笑。\n归来兮归去来，烟霞深处和衣倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释仲易","text":"一二三四五，升堂击法鼓。\n蔟蔟齐上来，一一面相睹。\n秋色满虚庭，秋风动寰宇。\n更问祖师禅，雪峰到投子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释绍先","text":"团不聚，拨不散，日晒不乾，水浸不烂。\n等闲挂在太虚中，一任傍人冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"宗禅师","text":"一不做，二不休。\n捩转鼻孔，捺下云头。\n禾山解打盐官鼓，僧繇不写戴嵩牛。\n庐陵米，投子油，雪峰依旧辊双毬。\n夜来风送衡阳信，寒雁一声霜月幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"丁讽","text":"我来自北几千里，景陵一到心怡然。\n人淳讼简公事少，屡游星馆时留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游潜山","author":"李师道","text":"肩舆转关随俯仰，不忧弱水澄方丈。\n细雾萦盘上白云，刚风肃肃天森爽。\n夏木阴浓四月寒，涧流触石鸣惊湍。\n到身已喜在福地，肯问玄都何处坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归云祠","author":"杜符卿","text":"寂照三乘法，冥通万佛心。\n传灯光祖印，演教茂禅林。\n莲座华成雨，云庵施侧金。\n因怀会稽绂，兰梵许登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"林东乔","text":"心爱民田远，车行石径中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广教院","author":"赵植","text":"列嶂倚天环佛界，乱流穿石度僧房。\n林泉尽日无穷趣，车马长年有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张微","text":"人家橘柚间，钟梵云烟侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏波岩","author":"崔静","text":"古木缠溪出乱根，四时香火庙空存。\n人家晓聚凫鸭乱，水怪夜翻星斗浑。\n灵洞仙游门自锁，阴崖龙去石生痕。\n幸同轩从乘馀兴，酣醉清时酒一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次逢原秋夜见寄","author":"满执中","text":"病对园林万事空，肯将寂寞感涂穷。\n消磨壮愤诗书外，破碎闲愁笑傲中。\n霜苦乱虫清叫夜，梦寒孤竹冷敲风。\n思君别有悲秋意，不为南湖一钓篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石屏路","author":"满执中","text":"石屏月如水，石壁云不动。\n闲中攲枕卧，天地同一梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明月溪","author":"满执中","text":"月出溪水清，月落溪水黑。\n茫茫溪上人，笑与月为客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"了了堂","author":"满执中","text":"虚堂跨云巅，白云在林杪。\n绝顶不可穷，了了非了了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅琊溪","author":"满执中","text":"岩下桃花红，溪流碧如玉。\n逋翁隔云歌，不是人间曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曾黯","text":"水合双江急，山逢百窍深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"民谣","author":"许醇","text":"龙阳古昔惟荒野，石险山深甲天下。\n始闻魏将征蜀时，阁道通行有来者。\n缘崖傍涧萦居止，风景宁将他郡比。\n地稀平陆少稻梁，菽麦荞糜而已矣。\n此土瘠薄不出谷，税廪不踰三百斛。\n我朝设官屯戍兵，供亿常于左绵督。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程给事知越州","author":"张炎民","text":"威名尝使虏人惊，杖节还朝欲请缨。\n三绝文章留丽正，一麾江海去承明。\n夕闱入对虚青琐，昼锦行归耀绛旌。\n秋雨鲈莼厨膳美，晓风铙鼓使船轻。\n鉴湖云水关心久，蓬阁烟峦照眼清。\n西省自应论出守，未容全慰吏民情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正觉寺清风轩","author":"蔡觌","text":"海风拍枕灯初暗，山雨打窗人正寒。\n料得此轩秋更好，怒涛推月上阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将进酒歌","author":"萧介夫","text":"劝君莫累黑山土，累得黑山竟何补。\n劝君莫勒燕然石，勒得燕然又何益。\n百年岁月能几何，萤烛光中都瞬息。\n我今安得万丈梯，腾腾直上天街墀。\n剪拆金乌翅，戳下玉兔蹄。\n使玉兔不能走，金乌不得飞。\n然后举泰山为肉林，东海为酒池。\n君不见吴王台下秋风悲，金谷园中春草衰。\n不如相逢且饮酒，齐声拍掌大唱金缕衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"廖平","text":"岂是齐安无一事，自缘太守有馀才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"郭知章","text":"一门十捧乡老书，四子五折东堂桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙莘老题召伯斗野亭","author":"张琬","text":"维舟得古寺，望远天四平。\n晴日晖晖散，晚风泠泠清。\n危亭下瞰野，层阁高连甍。\n起望斗与牛，淮海相奔倾。\n往来谁百年，今昔我平生。\n悠悠何所寓，台上多化城。\n与其逐影死，宁似不鸣烹。\n咄哉应有止，老矣将安行。\n中庭柜子落，丈室霜月明。\n此意竟萧条，犹然笑安荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南楼寺","author":"张琬","text":"仙去不留丹灶药，诗成惟记御园柑。\n休誇巨镇来天北，且得奇峰在岭南。\n已见二楼开石路，可无双鲤起龙潭。\n政当九月黄茅里，喜作清商洗瘴岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凫山庙二首 其一","author":"练毖","text":"仙人丹成去不返，至今庙貌留名山。\n嗟予俯仰随缰锁，尘土驱驰止汗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凫山庙二首 其二","author":"练毖","text":"云烟深处路萦纡，元是真人旧隐居。\n我亦放情丘壑者，官闲时得命篮舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"靖节祠堂","author":"李亨伯","text":"道出古柴桑，渊明祠有堂。\n春逢杨柳绿，秋及菊花黄。\n有酒尊居右，无弦琴在床。\n清名百世下，庐岳共存亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"董乂","text":"使宇高连徐邈洞，人家都食武昌鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"董乂","text":"云影万重连鄂渚，风帆一日到浔阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"董乂","text":"数封天子诏，两代帝王师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令江夏时作","author":"楼常","text":"不老长生世所稀，要持阴德定镃基。\n能行方寸无欺处，方是平生踏道时。\n长以仁思登恺弟，莫教深刻失便宜。\n行年七十看将近，见尽人间事可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归云洞","author":"陈毅","text":"云道无心亦爱山，雨馀时向此中还。\n而今天下焦枯甚，只恐苍龙未放闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"决涧院","author":"陈毅","text":"远归沧海通舟楫，近洗山僧一片心。\n留与卧龙成窟穴，等闲飞去也为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题慧悟禅师上方","author":"余弼","text":"孤峰牢落几何年，台殿于今插半天。\n已是精蓝誇绝徼，更将宝塔在危巅。\n烟霞色任阴晴变，钟磬声随上下传。\n珍重老僧无别境，一生幽趣只山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题竹轩","author":"黄远","text":"隐隐招提地，幽轩无点埃。\n惟栽紫竹种，相伴白云堆。\n疏影月移转，清声风送来。\n居常稀俗客，贝叶此勤开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过华清宫","author":"杜常","text":"行尽江南数十程，晓风残月入华清。\n朝元阁上西风急，都入长杨作雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨晨霁","author":"杜常","text":"桕叶青青栎叶红，高低相倚弄秋风。\n夜来雨后轻尘敛，绣出骊山岭上宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"温泉","author":"杜常","text":"已去开元四百年，此泉犹自响潺潺。\n也知不愤当时事，长作悲声恨禄山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"骊山","author":"杜常","text":"渔阳烽燧起云间，玉辇苍黄下此山。\n何事君王自神武，区区南渡鹿头关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"杜常","text":"江声聒破刺史眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]