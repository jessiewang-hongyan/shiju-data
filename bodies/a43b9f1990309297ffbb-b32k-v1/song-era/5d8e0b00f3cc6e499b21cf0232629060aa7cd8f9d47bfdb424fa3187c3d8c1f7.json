[{"title":"次韵子瞻临皋新葺南堂五绝 其二","author":"苏辙","text":"旅食三年已是家，堂成非陋亦非华。\n何方道士知人意，授与炉中一粒砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻临皋新葺南堂五绝 其三","author":"苏辙","text":"北牖清风正满床，东坡野菜漫充肠。\n华池自有醍醐味，丈室仍闻薝卜香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻临皋新葺南堂五绝 其四","author":"苏辙","text":"邻人渐熟容赊酒，故客亲留为种蔬。\n住稳不论归有日，船通何患出无车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻临皋新葺南堂五绝 其五","author":"苏辙","text":"客去知公醉欲眠，酒醒寒月堕江烟。\n床头复有三升蜜，贫困相资恐是天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠三局能师二绝 其二","author":"苏辙","text":"旅食江干秋复春，归耕未遂不胜贫。\n凭师细考何年月，可买山田养病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临川陈宪大夫挽词二首 其二","author":"苏辙","text":"五月扁舟忆过门，哀怜逐客为招魂。\n开樽不惜清泉洁，挥汗相看白雨翻。\n病起清言惊苦瘦，归休尺牍尚相存。\n秋风洒涕松楸外，谈笑犹疑对竹轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孔毅父封君挽词二首 其二","author":"苏辙","text":"别日笑言重，归来药饵忧。\n钟歌掩不试，贝叶乱谁收。\n恨极囊封在，情多垄木稠。\n埋文应自作，一一记徽猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上高息轩起亭二绝 其二","author":"苏辙","text":"溪父起收罾下鲤，山翁起卖焙中茶。\n长官亦与人俱起，笑拥黄紬放早衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中贾大夫相访因游中宫僧舍二首 其二","author":"苏辙","text":"东邻修竹野僧家，乱柳枯桑一径斜。\n逐客惯曾迂短策，使君何事驻高牙。\n萧条已似连村坞，邂逅应容设晚茶。\n惭愧病夫无气力，隔墙空听吏兵哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽兰花 其二","author":"苏辙","text":"珍重幽兰开一枝，清香耿耿听犹疑。\n定应欲较香高下，故取群芳竞发时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾子宣郡太挽词二首 其二","author":"苏辙","text":"安舆遍西北，丹旐历江湖。\n存没终无憾，哀荣两得俱。\n新封崇马鬣，馀福荐浮图。\n家法蘋蘩在，空堂始一虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王适一百五日太平寺看花二绝 其二","author":"苏辙","text":"小槛明窗曾不住，闲花芳草遣谁栽。\n但须匹马寻幽胜，携取清樽到处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻留别三首 其二","author":"苏辙","text":"野人性似修行僧，长愿幽居近林麓。\n南迁无计脱簪组，西归谁为栽松竹。\n头上白云即飞盖，耳畔清泉当鸣玉。\n洛川犹是冠盖林，更愿高飞逐黄鹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻留别三首 其三","author":"苏辙","text":"东西南北无住身，羯末封胡四男子。\n彫锼不遣治章句，烂熳先令饱文字。\n疏慵嗟我厉之人，生子夜中惟恐似。\n传家粗足不愿馀，同驾柴车还我里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠医僧鉴清二绝 其二","author":"苏辙","text":"门人久作开堂老，庭桧看成合抱围。\n他日浴堂归洗背，回头还解放光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"勉子瞻失干子二首 其二","author":"苏辙","text":"破甑不复顾，彼无爱甑心。\n弃璧负赤子，始验爱子深。\n诚知均非我，胡为有不能。\n一从三界游，久被百物侵。\n朝与喜怒交，莫与宠辱临。\n四物皆不胜，生死独未曾。\n不经大火烧，孰为真黄金。\n弃置父子恩，长住旃檀林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中风雪五绝 其二","author":"苏辙","text":"晓风吹浪作银山，夜雪争妍布玉田。\n风力渐衰波更恶，通宵撼我正安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中风雪五绝 其三","author":"苏辙","text":"拥缆埋蓬不见船，船窗一点莫灯然。\n幽人永夜歌黄竹，赖有丹砂暖寸田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中风雪五绝 其四","author":"苏辙","text":"浊醪粗饭不成欢，白浪飞花雪作团。\n窗外时来一双鸭，沉浮笑我不禁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中风雪五绝 其五","author":"苏辙","text":"江面澄清雪未融，扁舟荡漾水无踪。\n篙师不用匆匆去，遍看庐山群玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书庐山刘顗宫苑屋壁三绝 其三","author":"苏辙","text":"肩舆已弃蹑风骓，旧物仍存杨柳枝。\n一曲清歌近尤好，五陵故态未全衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初到绩溪视事三日出城南谒二祠游石照偶成四小诗呈诸同官 石照二首 其二","author":"苏辙","text":"雨开石照正新磨，鸟度猿攀野客过。\n忽见尘容应笑我，年来底事白须多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复病三首 其二","author":"苏辙","text":"寒作埋冰雪，热攻投火汤。\n今生那有此，宿业未应亡。\n委顺一无损，力争徒自伤。\n颓然付一榻，是处得清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复病三首 其三","author":"苏辙","text":"一病五十日，复尔当解官。\n不才归亦乐，无食去犹难。\n黾勉人应笑，低徊意已阑。\n旧师摩诘老，把卷静中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答琳长老寄幽兰白朮黄精三本二绝 其二","author":"苏辙","text":"老僧似识众生病，久在山中养药苗。\n白朮黄精远相寄，知非象马费柔调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初闻得校书郎示同官三绝 其二","author":"苏辙","text":"百家小邑万重山，惭愧斯民爱长官。\n粳稻如云梨枣熟，暂留聊复为加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初闻得校书郎示同官三绝 其三","author":"苏辙","text":"病后浊醪都少味，老来欢意苦无多。\n临行寂寞空相对，不作新诗奈客何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其二","author":"苏辙","text":"承平终不处，付托重艰难。\n统接神孙正，人依圣母安。\n桥山封剑佩，原庙见衣冠。\n万国缠哀处，嵩阳桧柏寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其三","author":"苏辙","text":"取士忘疏贱，量书废寝兴。\n刍言本何益，玉殿最先登。\n日角依俙想，尧言涕泗称。\n龙髯远莫及，零泪冻成冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟过严陵滩将谒祠登台舟人夜解及明已远至桐庐望桐君山寺缥缈可爱遂以小舟游之二绝 其二","author":"苏辙","text":"严公钓濑不容看，犹喜桐君有故山。\n多病未须寻药录，从今学取衲僧閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张惕山人即昔所谓惠思师也余旧识之于京师忽来相访茫然不复省徐自言其故戏作二小诗赠之 其二","author":"苏辙","text":"听诵长江近章句，喜逢澄观已冠巾。\n醉吟挥弄清潮水，谁信从前戒律人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复赋河冰四绝 其二","author":"苏辙","text":"春来归梦剧飞凫，夜半流澌拥舳舻。\n似胜去年彭蠡口，雪封庐岳浪翻湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复赋河冰四绝 其三","author":"苏辙","text":"朝来县令借长船，仍遣千夫上下牵。\n不惜琼瑶分众手，贪看雪片满河壖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"复赋河冰四绝 其四","author":"苏辙","text":"轻纨破碎佩环流，颠倒锵鸣乱触舟。\n解绋投篙曾不顾，不知何处拥汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答孔平仲惠蕉布二绝 其二","author":"苏辙","text":"灯笼白葛扇裁纨，身似山僧不似官。\n更得双蕉缝直掇，都人浑作道人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李诚之待制挽词二首 其二","author":"苏辙","text":"济南风物在西湖，湖上逢公初下车。\n谈笑樽前伏齐虏，旌旗门外听除书。\n一封未奏先焚草，三黜归来便种蔬。\n泪落西堂歌酒地，杉松空见岁寒馀。","collection":"宋","notice