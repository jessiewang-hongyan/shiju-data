[{"title":"次韵李参政见寄 其一","author":"魏了翁","text":"自失鸥边约，应羞鹤上人。\n竹荒青翼短，书远墨题亲。\n世事方尝胆，时贤谩饮醇。\n国疑谁为嗣，公子急振振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见谢游龙鹤山诗 其二","author":"魏了翁","text":"有鸟云飞鱼跃渊，圣贤见处自天悬。\n流阴卒卒谩空过，斯道寥寥谁适传。\n人境恰逢如择地，主宾良晤岂非天。\n二章发我无穷思，不慊遗编对圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见谢游龙鹤山诗 其一","author":"魏了翁","text":"北山尝乞草堂灵，娓娓高谈析理精。\n泼眼溪光无间断，入怀月色太鲜明。\n寒毛络石清可数，暝霭蒸山浓欲倾。\n相对悠然无语处，古今成败一空枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见遗生日 其三","author":"魏了翁","text":"幸有鹤山房，图书绕梦香。\n况惭闻道浅，何苦为人忙。\n五斗米非分，三间茅可长。\n何当重操几，同踏古松冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政见遗生日 其二","author":"魏了翁","text":"月暗书中色，霜彫镜里年。\n滔滔时易失，落落意难传。\n信己终违俗，随人谩辱先。\n输他南阁老，攲玉弄寒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李参政李提刑见和雁湖观梅","author":"魏了翁","text":"春事何须羯鼓催，好春全看未花时。\n雨馀庭院湖光湿，人倚阑干夕暝迟。\n正会意时俄起起，到忘言处谩期期。\n雁湖饮散人归后，曾问梅花复几枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵泸帅范郎中再和所送李季允韵见寄 其一","author":"魏了翁","text":"人老边关未得师，行违久速只安时。\n令随天阔风遥岭，语挟春来草梦池。\n旧垒无华閒睥睨，新机有句到侏离。\n孤衷耿耿无人会，只傍天公作己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵泸帅范郎中再和所送李季允韵见寄 其二","author":"魏了翁","text":"新阳拆地唤春归，生意绵绵重此时。\n青女卷寒还朔易，朱轮驾暖出咸池。\n恩流未渗鱼犹涸，禁网虽疏雉或离。\n抚事伤时无限意，冯梅折寄故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵苏和甫雨后观梅","author":"魏了翁","text":"岁寒宾友伴萧萧，客气无根已尽凋。\n疏影照人骚梦冷，清香彻骨醉痕销。\n话逢理到春生坐，饮为心知月满瓢。\n更祝天公多雨麦，时携乐酒酹芳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知常德袁尊固监丞送别四诗 其四","author":"魏了翁","text":"夕阳舂处是吾家，水绕山环路转赊。\n蹙蹙四方浑未定，茫茫大化渺无涯。\n归来已恨十年晚，老去空嗟两鬓华。\n各愿及时崇令德，万钟于我本何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知常德袁尊固监丞送别四诗 其一","author":"魏了翁","text":"试把行藏为子评，只知尽分敢徼名。\n出如有益殷三聘，用不能行鲁两生。\n此道古人如饮食，后来灶婢或猜惊。\n子云亦号知书者，犹把商山作采荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知常德袁尊固监丞送别四诗 其三","author":"魏了翁","text":"别来岁月尔滔滔，流落天涯忽此遭。\n万木辞荣秋意澹，百川归壑岸容高。\n笑看海上两蜗角，閒秃山中千兔毫。\n若向颜曾得消息，直须奴仆命离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知常德袁尊固监丞送别四诗 其二","author":"魏了翁","text":"孔训元无实对名，只言为己与求人。\n能知管仲不为谅，便识殷贤都是仁。\n义利两涂消处长，古今一理屈中伸。\n自从圣学寥寥后，千百年谁信得真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范少才在峡中寄李季允 其二","author":"魏了翁","text":"大明临照职方州，汉沔江淮澹若油。\n剪薙荆榛开跸路，护持杞梓耸岑楼。\n朝纲人为诸公喜，国体谁知志士愁。\n谠议胡公不可作，奉常今说有黄侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵范少才在峡中寄李季允 其一","author":"魏了翁","text":"蜀艇云奔下固陵，一壶浮峡便千金。\n子来我往才交臂，人涉卬须又苦心。\n北向虽无一矢发，西风不受半尘侵。\n是非得丧今休问，喜见戈枪卧绿沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵费同叔解嘲 其一","author":"魏了翁","text":"乞得身来作外臣，冲然肺腑自韶钧。\n咸酸独觉水中味，形影相依镜里真。\n入户方闻夫子乐，近前孰试相君嗔。\n昊天明旦司游衍，环堵严于百万人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵费同叔解嘲 其二","author":"魏了翁","text":"低头涸辙问波臣，沃以嘉言力万钧。\n逆耳倒言诚爱助，解嘲谢谤返离真。\n若微君告谁能及，幸不吾欺乃敢嗔。\n彼是纷纷姑勿道，所期终诲作全人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵监试潼川提刑张兵部有怀家山木犀","author":"魏了翁","text":"形安宇泰即吾乡，花解随人到处黄。\n何事归心起张翰，有来妙语出君房。\n荣枯境里自殊观，造化机中无别香。\n不见儋州安乐法，随花随客作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄侍郎生子","author":"魏了翁","text":"未用占呱泣，悬知头角疏。\n芝兰庭殖殖，梧竹厦渠渠。\n虎子驱黄犊，禽儿驾小车。\n乃翁何以遗，行李五车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵遂宁府宴贡士即席赋 其二","author":"魏了翁","text":"谁把浮华变古风，颓波衮衮日奔冲。\n人情容易随流去，此道分明触处逢。\n学似董晁犹有累，文过元白愧无宗。\n诸君自此皆升矣，更向根基厚自封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵遂宁府宴贡士即席赋 其一","author":"魏了翁","text":"过尽一春花信风，鱼天鼓浪送蒙冲。\n凤翰有目争先睹，牛角无人叹不逢。\n选试谩称新汉使，作成端属旧春宗。\n鹿鸣剩作中和曲，嶉送飞黄出蚁封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞万州见寄除夕江村饯腊 其二","author":"魏了翁","text":"处士西城落照边，春风吹袂意泠然。\n閒中受用封千户，圣处功夫禄九迁。\n竹外缓觞留急景，沙头饱饭看丰年。\n诗来发我无穷思，拟上沧江别看天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞万州见寄除夕江村饯腊 其一","author":"魏了翁","text":"非我江山许我赊，有涯生事不无涯。\n雨添饼饵村村秀，风作羹胹树树花。\n行玉盘中看物化，缕银幡里感年华。\n初春心事谁人解，梦落沧江处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞万州沧江海棠","author":"魏了翁","text":"维摩老子菌生庵，门外沧江绿正涵。\n夜雨村村拆花柳，春风日日长桑蚕。\n晚妆才记海棠睡，朝色俄看禁药酣。\n造化新功镇如此，抚诗往往发余惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞永康读易有作","author":"魏了翁","text":"室中万象本宽閒，门户何曾顷刻关。\n未始有时观太极，不终止处认兼山。\n人文自昔先牺昊，天赋云谁不孔颜。\n有志未能今得友，从今迷路傥知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞永康谢余过沧江","author":"魏了翁","text":"雨馀云簇数峰奇，公子江头客款扉。\n白舫青帘乱平渺，黄鸡浊酒话清微。\n稻畦千顷睟生色，竹日一川摇静晖。\n坐久东山初月上，恍疑赤壁旧时矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵虞永康题沧江书院","author":"魏了翁","text":"解后沧江半日閒，一川风物闯柴关。\n正从逝处识流水，更向静时观远山。\n有咏皆春谁与点，无时不学子睎颜。\n相逢一笑忘言处，月堕波心不记还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵□丞兄闻丁卯十一月三日朝报 其一","author":"魏了翁","text":"龙章晨下九重关，帝敕元凶出羽山。\n揭日行空破昏闇，乘风纵燎绝神奸。\n须看文正昭陵日，孰与忠宣元祐间。\n更愿和平培治体，儒臣千岁侍天颜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵□丞兄闻丁卯十一月三日朝报 其二","author":"魏了翁","text":"傥来得丧本无关，或为鸿毛加太山。\n纵昔尹鼯宁有损，及今投裔枉为奸。\n公私界分分明甚，狂圣途程念虑间。\n初学粗知真富贵，从今克复愿睎颜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江州司马安君挽诗","author":"魏了翁","text":"当年风雨脊令原，共挈凶颅奏凯旋。\n弄破峨眉山月影，慵移湓浦荻花船。\n浮云都似梦中觉，妙句犹于身后传。\n肠断美人湘水隔，凭鸿寄泪识新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约任千载大卿同王万里杨仲博汎湖任赋二诗和其韵 其一","author":"魏了翁","text":"满目亲朋似故乡，梦邪非梦梦何长。\n春风坐上白云屦，玉鉴光中明月珰。\n酒到湖山嫌逊避，话逢气类省称量。\n谢家内集如斯否，一味诗书无别香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"约任千载大卿同王万里杨仲博汎湖任赋二诗和其韵 其二","author":"魏了翁","text":"翠舫青帘白玉舟，风轻日淡相兹游。\n芙蓉覆地锦衾烂，杨柳雕空印篆缪。\n月上酒痕浑未觉，山撩诗思浩难酬。\n颇怜此会何时又，相伴江湖归去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自长宁阡过灵泉兄墓爇黄经从隈支以归","author":"魏了翁","text":"晨策犯层巅，危如峭壁缘。\n溪明人在地，路绝马行天。\n松倚露云立，稻依霜雨眠。\n不知岁年晚，抚事亦悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟至合江度周卿以诗相迓次韵","author":"魏了翁","text":"雨满长空水拍畴，荔香松色倚江流。\n半窗灯火千年梦，万里风波一叶舟。\n谩道班卿若仙去，谁知谢傅正同忧。\n西归待我期相告，横被风师三日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观南堤","author":"魏了翁","text":"吏报南郊役事休，好风吹袂到江头。\n长堤饮水马非马，叠石护田牛戴牛。\n处处女筐蚕望岁，村村社鼓麦祈秋。\n守臣不办康时策，只把农夫作己忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许侍郎同饮郊外王氏亭分韵得风字","author":"魏了翁","text":"万绿成帷涨晚空，不知门外几番风。\n月拖树影阑干角，烛挟花阴酒盏中。\n饮隽青山如有问，曲终远意浩无穷。\n登临此地知多少，气味应难似此同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许侍郎挽诗 其二","author":"魏了翁","text":"近事君知不，王心莫与宁。\n融风薄台里，秋雨暗前星。\n鸿集稻粱少，虎嘷川谷腥。\n人才关世道，敛涕为公铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许侍郎挽诗 其一","author":"魏了翁","text":"杏园春接袂，蓬省夜分灯。\n权相不吾以，贵人惟子憎。\n虽云殊爵位，均不愧交朋。\n顾影追前事，悠然涕满膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎头狼尾滩避险出陆至谭晋仲故居有谢公昌国刘公德脩薛公仲章诗用谢韵有赋 其二","author":"魏了翁","text":"纷纷操罟入山林，我自终朝不获禽。\n远物只知肥遁利，穷幽不问浚恒深。\n毕逋啼日满荒戍，款段行云供醉吟。\n宇宙穷空岁迟暮，平沙独立数寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎头狼尾滩避险出陆至谭晋仲故居有谢公昌国刘公德脩薛公仲章诗用谢韵有赋 其一","author":"魏了翁","text":"尚记翩然下帝傍，七年才入屈公乡。\n山衔西日去家近，风递北氛吹袂凉。\n新事感伤心力短，旧交零落话头长。\n况堪刘薛吾师友，黄壤堂堂閟夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐安郡向夫人挽诗","author":"魏了翁","text":"祥符名相裔，元祐宰臣孙。\n展也晋秦匹，烂其韩姞门。\n世纷冰似冷，壸范玉如温。\n千古峨眉月，争辉北客魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何府君挽诗 其一","author":"魏了翁","text":"林泉间富贵，缣素老功夫。\n古树檠苍干，脩庭拥碧梧。\n只安车下泽，不侈骑传呼。\n轧轧成都道，还家日未晡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余既赋诗坐客请以唐人家花车斜韵同赋醉中作五十六言","author":"魏了翁","text":"人生偶被浮名误，往往贪程不识家。\n醉眼乱穿青草屐，狂心长恋碧桃花。\n举头大道平如掌，入鬓韶光转似车。\n是乃吾忧今赠子，情亲语直字欺斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别东叔西叔二兄于遂宁门外","author":"魏了翁","text":"毕逋枝上晓光和，日日庭闱盼树柯。\n风送骊歌惊短梦，云拖鸠雨湿长坡。\n母心念子无时足，王事催人不奈何。\n但祝爱身崇令德，长教此意得天多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席和丁夔帅送行诗韵 其二","author":"魏了翁","text":"眼明织翠剪新诗，勉我当今尚可为。\n知觉斯民知觉我，溺饥天下溺饥谁。\n志亨不管身穷达，谊正宁论效疾迟。\n倒尽玉瓶谈未了，沙头忍泪与君辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席和丁夔帅送行诗韵 其一","author":"魏了翁","text":"人生行止莫非天，去国重来十七年。\n学自孔颜期有是，道非尧舜敢陈前。\n忧时正念梁瓯缺，视己当如赵璧全。\n若得时清身不辱，尽教人道是登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴府君挽诗","author":"魏了翁","text":"笃信宁违俗，徐行不竞时。\n与人交乐易，处世事平夷。\n甚矣古常者，伤哉今已而。\n龙山春夜月，长照凤皇枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应提刑以十五日和韵见示再次韵","author":"魏了翁","text":"大圆垂象晓群黎，犹送昨宵畏满诗。\n要看天行嫌位亢，若言人事恶功亏。\n升于正处元为利，坎到盈中乃识时。\n疑我冰轮公赐厚，敢申馀义副襟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张大著以韩持国绿樽红妓事再和见戏复次韵 其二","author":"魏了翁","text":"壮心十五亦狂颠，十五年来洗濯鲜。\n负郭元无三亩宅，浮家安有五湖船。\n焚香读易谢来况，饮绿围红回长年。\n不是柳桃曾作恼，安知世味有妍怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张大著以韩持国绿樽红妓事再和见戏复次韵 其一","author":"魏了翁","text":"世路羊肠几覆颠，如君操行雪朝鲜。\n书胸满贮宣和库，学力要装元祐船。\n剩喜孟龙来并世，肯呼祢鹗与忘年。\n闭门笄珥无膏沐，不作倾城冯小怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张运判挽诗","author":"魏了翁","text":"悃愊汉循吏，咨询周使臣。\n知心三坐主，报国两门人。\n綵绣方趋户，丝麻已在身。\n至今寒食路，孺慕镇如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张运判之母吕宜人挽诗 其二","author":"魏了翁","text":"锦乡閒日月，象服俨山河。\n富贵吾无羡，平反尔几何。\n相依在岁晚，不竞得天多。\n欲报无终极，悲风振蓼莪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张运判之母吕宜人挽诗 其一","author":"魏了翁","text":"昔在伤皇辟，子行犹不归。\n嫠居言有则，丧事礼无违。\n轲母三迁教，莱儿七十衣。\n至今霜月夜，松竹带芳徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张隆州挽诗","author":"魏了翁","text":"行马门阑宰胄巍，高冠长佩独委蛇。\n紫微自有申公学，太史还从从祖知。\n静嘿无非蒙力处，功夫全在不欺时。\n故家遗俗寥寥甚，忍听虞歌薤露悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张隐君挽诗","author":"魏了翁","text":"触事无非学，非儒果误身。\n体中识天地，笔底定君臣。\n安乐堂前月，希夷枕上春。\n是应家有子，不止活千人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李池州和韵见寄再赋以答之","author":"魏了翁","text":"晨策随乌瞰屋山，面前咫尺隔同年。\n邛人自爱橘中乐，晋客惊逢洞里天。\n行傍輶轩心半醉，坐看戟卫眼双穿。\n西风一夕惊龙睡，撼取明珠出九渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李怀安挽诗","author":"魏了翁","text":"乡邑赖蓍龟，天胡不慭遗。\n与人交乐易，处世事平夷。\n甚矣古常者，伤哉今已而。\n抚时怀牧守，忍泪读刘碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李制置生日 其一","author":"魏了翁","text":"玉堂人住玉堂山，公论推排授将坛。\n朔垒令严精采异，甘泉烽息顾忧宽。\n北边旧叹无颇牧，西贼今闻有范韩。\n夏屋不知几崇广，唤回春燕下林端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李制置生日 其二","author":"魏了翁","text":"披荆重立小朝廷，风递南薰入扇巾。\n大势已冯天祚宋，中兴更赖岳生申。\n扶持命脉还吾蜀，消息精神运此身。\n人愿武公归入相，我祈河内且留恂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政见招游龙鹤山归途有作 其二","author":"魏了翁","text":"乱涧穿云十里閒，好风吹袂出重山。\n潺潺流水半归壑，唧唧候虫皆闭关。\n兴念岁时惊变态，静观物化识回环。\n并溪的皪梅花树，已带明年春事还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政见招游龙鹤山归途有作 其一","author":"魏了翁","text":"上有高峰树倚天，下临深涧水生烟。\n陶镕泉石山中相，舒卷云霞地上仙。\n松色呼儿开后槛，笋舆为客过前川。\n不因同落天涯久，那得岩扉共此缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政约客访西郊海棠予以斋禁不与","author":"魏了翁","text":"十日花期九日斋，相园红锦烂成堆。\n不将小雨轻阴驻，刚把和风暖日催。\n诗笔都随许昌去，春光不待牧之来。\n要知荣悴适然耳，明日荼蘼芍药开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":32289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]