[{"title":"偈颂一百四十二首 其三十三","author":"释广闻","text":"一法若有，山河大地平沈。\n万法若无，森罗万像显焕。\n旧岁今宵去，去去实不去。\n新年明日来，来来实不来。\n一法万法，新年旧年。\n大地全收，千差一举。\n绝去来，没回互。\n回时更相涉，不尔依位住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十四","author":"释广闻","text":"云从龙，风从虎，圣人作而万物睹。\n须弥槌，虚空鼓，而以音声为佛事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十五","author":"释广闻","text":"百灯千灯，从一灯起。\n有处动地放光，无处放光动地。\n问讯灯明如来，惯打者般行市。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十六","author":"释广闻","text":"五日不升堂，三八不入室。\n供是众人办，饭是借米吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十七","author":"释广闻","text":"炎炎普热，纷纷下雪。\n百丈耳聋，黄檗吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十八","author":"释广闻","text":"新年头，旧年尾。\n第一句下明宗旨，三世诸佛不知有。\n是第二句，狸奴白牯却知有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其三十九","author":"释广闻","text":"风潇潇，雨潇潇。\n黑漫漫，明皎皎。\n过去灯明佛，面皮厚多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十","author":"释广闻","text":"向下转去，谁不知有。\n向上转去，如十日并照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十一","author":"释广闻","text":"六祖不会，谁云卞璧无瑕颣。\n达磨不识，生铁蒺藜当面掷。\n碓捣磨磨，风吹日炙，无位真人汗滴滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十二","author":"释广闻","text":"唯一坚密身，一切尘中现。\n近见不如远闻，千闻不如一见。\n西风一阵来，落叶两三片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十三","author":"释广闻","text":"青天白日，闹市人多。\n鸟道玄途，龙门客少。\n目前机，顶门窍，一语不来，三十年后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十四","author":"释广闻","text":"用东山暗号，虎头戴角出荒草。\n唱少林一曲，六六不成三十六。\n看不足，听不足，断弦须是鸾胶续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十五","author":"释广闻","text":"日南长至，第一义谛。\n未举先行，讨甚巴鼻。\n鲇鱼上竹竿，一日一万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十六","author":"释广闻","text":"十字街头，大圆觉海。\n逐色随声，家风落赖。\n讨甚西天样子，一任东倒西擂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十七","author":"释广闻","text":"九旬过半，见成公案。\n明眼衲僧，打叠不办。\n万寿枣子浑仑吞，打鼓普请诸人看。\n看看，睦州担板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十八","author":"释广闻","text":"祖师不来，曹溪路上生深棘。\n善财别后，楼阁门前草自青。\n直下穿过髑髅，换却眼睛。\n欲入洪波里，须是弄潮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其四十九","author":"释广闻","text":"钟声才动鼓声催，看取如今是甚时。\n闹浩浩中静悄悄，须臾小立是便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十","author":"释广闻","text":"善行无辙迹，善系无绳缚。\n二大老突出本分钳锤，不劳馀刃。\n丛林后世，追风捕影。\n要见古人，远之远矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十一","author":"释广闻","text":"识得一，万事毕，上下四维无等匹。\n张公醉倒街头，元是李公吃酒，置之莫问。\n拽占波国与新罗国斗额，是何境界。\n举头天外看，谁是我般人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十二","author":"释广闻","text":"真正举扬，人荒道绝。\n随家丰俭，尺短寸长。\n衲僧门下有价数，没商量。\n一夜落花雨，满城流水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十三","author":"释广闻","text":"尽山河大地，只作一句道却。\n普使有情无情，同向句下明宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十四","author":"释广闻","text":"从上以来，无不知有，因甚被渠一把把定。\n不把定，裂破重关，行摩竭令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十五","author":"释广闻","text":"千圣头边，星移斗换。\n八面绝遮拦，打鼓普请看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十六","author":"释广闻","text":"过去一年复一年，未来一日是一日。\n拶到力尽神疲，依旧正好著力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十七","author":"释广闻","text":"默默，无上菩提从此得。\n了了，金鸡一拍扶桑晓。\n衲僧门下，二俱漏逗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十八","author":"释广闻","text":"不用低头，思量难得。\n物有定价，钱是足陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其五十九","author":"释广闻","text":"菊花开时是重阳，又言九日是重阳。\n西风无帽落，西风索索。\n南山何处是，南山苍苍。\n恁么也得，不恁么也得。\n仰面不见天，低头不见地。\n谁知远烟浪，别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十","author":"释广闻","text":"适间从僧堂中来，人人如白衣拜相。\n少间从法堂下去，个个如昼锦还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十一","author":"释广闻","text":"天地与我同根，万物与我一体。\n竖四横三，横三竖四。\n全无巴鼻，讨甚巴鼻，阳气发时无硬地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十二","author":"释广闻","text":"河清海晏，天平地成，佛手遮不得。\n凿井而饮，耕田而食，帝力何有哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十三","author":"释广闻","text":"雪窦雪寒，雪山雪寒。\n悟与未悟时，大地铁一团，不妨北斗面南看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十四","author":"释广闻","text":"含珠林上碧崔嵬，曾入仁皇梦里来。\n今日恩从九天下，无边刹海走风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十五","author":"释广闻","text":"达磨九年面壁，不敢正眼觑著。\n神光三拜而立，至竟何曾踏著。\n觑著踏著，彩石渡头看，陈年断贯索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十六","author":"释广闻","text":"说心说性，说玄说妙，雪窦者里是小家恶口。\n学佛学法，学禅学道，诸人分上是鹘突布衫。\n秦不收，汉不管。\n閒来石上从头数，得到清平有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十七","author":"释广闻","text":"贞女不著嫁时衣，好儿不使分时财。\n只如一夏九十日，切忌坐在者里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十八","author":"释广闻","text":"一番两番新雨过，前村后村年已熟。\n试问蒲团上打坐，何如催人打禾谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其六十九","author":"释广闻","text":"难难，几何般。\n时节难，道路难。\n贫穷布施难，富贵学道难。\n难难，达磨不会，大难大难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十","author":"释广闻","text":"物理有代谢，时节不相饶。\n西家君子道长，东家小人道消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十一","author":"释广闻","text":"了了了，家近扶桑最先照。\n知知知，一双红杏换消梨。\n莫莫莫，金鸡啄破琉璃壳。\n住住住，凤栖不在梧桐树。\n过者四重关了，五里牌在郭门外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十三","author":"释广闻","text":"放出焦尾大虫，咬杀南山猛虎。\n动地号悲风，白日无行路。\n笑中摆手出长安，拶得虚空筋骨露，流水落花拦不住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十四","author":"释广闻","text":"天平地平，河满井满。\n临济口门窄，德山棒头短。\n铁蒺藜，黄金弹。\n直下来也，急著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十五","author":"释广闻","text":"二千年前旧公案，九十日夏过一半。\n雪窦道得十成，犹亏一半。\n诸人全身担荷，未搆一半。\n灵利汉不赴两头不住中间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十六","author":"释广闻","text":"咄咄咄，力□希。\n大慈知处，雪窦不知。\n雪窦知处，大慈不知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十七","author":"释广闻","text":"极小同大，极大同小。\n官路行人少，私酒醉人多。\n风前三三两两，不妨水云自若。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十八","author":"释广闻","text":"飞雪亭前水，妙高声顶云。\n云有出山势，水无投涧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其七十九","author":"释广闻","text":"你若坐时我须立，我若立时你须坐。\n黄面老瞿昙，透者些不过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十","author":"释广闻","text":"用毗卢正印，揭仲尼日月。\n一字不著画，八字无两丿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十一","author":"释广闻","text":"善言言者，言所不能言。\n善迹迹者，迹所不能迹。\n明眼衲僧，撞墙撞壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十二","author":"释广闻","text":"大机圆应，大用现前。\n斩新日月，特地乾坤，知恩方解报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十三","author":"释广闻","text":"多子塔前，平分半座。\n险崖句里，水泄不通，风从虎兮云从龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十四","author":"释广闻","text":"五月五，天中节。\n尽大地人，无不向门头户底咒土书符。\n育王门下，身心一如，身外无馀。\n四明山色开画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十五","author":"释广闻","text":"人间九月又九日，善财去后无消息。\n何止门前草自青，黄花满地成狼藉。\n六祖不会，达磨不识。\n大藏小藏，尽从者里流出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十六","author":"释广闻","text":"入山还出山，铁壁复铁壁。\n衲僧门下，不消一击。\n黄面瞿昙，散宅亡家。\n尽大地人，眼横鼻直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十七","author":"释广闻","text":"六殊胜地，无越此山极殊胜。\n八吉祥中，唯有今朝最吉祥。\n于殊胜中显殊胜，于吉祥中显吉祥。\n万年千载寿，一瓣九天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十八","author":"释广闻","text":"控佛祖大机，廓人天正眼，便恁么去。\n入得育王门，要见育王人，远之又远。\n试看海上明公秀，何似堂中首座简。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其八十九","author":"释广闻","text":"牛头横说竖说，不知有向上关棙。\n兴化在大觉棒下，见临济先师于黄檗处吃棒底道理。\n狮子咬人，韩獹遂块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十","author":"释广闻","text":"雪峰辊毬，秘魔擎杈。\n德山行棒，临济下喝，诸大老何用许多气力。\n山僧寻常只是因风吹火，今日失利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十一","author":"释广闻","text":"行罗汉慈，破劫贼故。\n行菩萨慈，安众生故。\n行如来慈，续慧命故。\n行平等慈，又且如何。\n岭云海月俱耕遍，拽耙拖犁卒未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十二","author":"释广闻","text":"达磨面壁，云门念七。\n玉本无瑕，彫文丧德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十三","author":"释广闻","text":"画龙看头，画蛇看尾。\n雪山冷坐六年，此处无金二两。\n少林面壁九年，俗人沽酒三升。\n向道莫行山下路，果然猿叫断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十四","author":"释广闻","text":"南屏山高，西湖水急。\n还闻偃溪水声么，从者里入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十五","author":"释广闻","text":"坐断天下人舌头，诸佛不知。\n捩转天下人鼻孔，达磨不识。\n人天俨临，皇帝有敕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十六","author":"释广闻","text":"建立法幢，扶持法社。\n左之右之，风流儒雅。\n全卷全舒珠走盘，正法眼藏增高价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十七","author":"释广闻","text":"彩仪仙仗五云间，只作先皇旧日看。\n莫道空馀弓剑在，威风凛凛逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十八","author":"释广闻","text":"吾佛广大华藏海，法随法行随建立。\n此宝华王狮子座，上有宝盖从天垂。\n古来宝积长者子，手持此盖同供佛。\n佛以智慧威神力，一一宝盖合为一。\n南山去天尺五近，王城不异毗耶城。\n彼时心即此时心，以此庄严作佛事。\n綵幢宝幡杂金碧，间见层出生光辉。\n犹如微风吹萎花，而复更雨新好者。\n仰观三千大千界，于此盖中悉充遍。\n一一世界既亦尔，线蹊针孔无不然。\n岂止一佛与二佛，尽十方佛现其中。\n广长舌相炽然说，万法一法靡不周。\n皇上心与佛心通，皇上寿与南山齐。\n无负此恩与此盖，臣心有如此山尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其九十九","author":"释广闻","text":"如来禅祖师意，一不成二不是。\n直下拶得行，转得身吐得气。\n又何待鳌山店上，古佛庙前，方始瞥地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○○","author":"释广闻","text":"十字街头石幢子，无你遮护处。\n一声江上侍郎来，无你回避处。\n衲僧家朝出暮入，脚前脚后也须子细。\n忽然筑著磕著，净慈拄杖别有分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○一","author":"释广闻","text":"六年冷坐，九年面壁。\n碓捣东南，磨推西北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○二","author":"释广闻","text":"风不鸣条，雨不破块。\n尘尘刹刹全彰，总是大人境界。\n北极高照南山外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○三","author":"释广闻","text":"税阇黎用影身术，老曹山用缚虎机。\n且道那里是他吃酒处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百四十二首 其一○四","author":"释广闻","text":"人有南北，道无南北。\n上中下座，虚空逼塞。\n其中有一人半人肯去，说甚开粥相待。\n南山别甑炊香，未为分外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]