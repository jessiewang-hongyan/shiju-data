[{"title":"端平三年春帖子词 其五 皇帝閤","author":"洪咨夔","text":"东风送喜上天颜，吉语飞来井轸间。\n榆塞雪消鸣镝静，柳营月暖击刁闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其二 皇帝閤","author":"洪咨夔","text":"冰天寒色饯，旸谷霁华宾。\n生意乾坤满，宸襟一点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其三 皇帝閤","author":"洪咨夔","text":"宽大朝廷诏，中和郡国诗。\n欲求跻庆历，先使见淳熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其四 皇帝閤","author":"洪咨夔","text":"唤仗紫宸披晓霭，退朝清燕坐晴霏。\n简编有味炉熏永，铃索无声漏箭稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其六 皇帝閤","author":"洪咨夔","text":"麦苗培秀腊前雪，稻种浸芽春后晴。\n野老田夫观治象，便从新岁贺升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其一 皇帝閤","author":"洪咨夔","text":"和凤东风转，携龙北斗回。\n人间遒铎振，天上兽樽开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其五 贵妃閤","author":"洪咨夔","text":"万年枝上綵裁绿，千叶花头酥点红。\n镜绶囊丝相映烛，探先半月庆流虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其一 贵妃閤","author":"洪咨夔","text":"梅试催妆粉，兰披入梦香。\n迎春占北斗，受福拜东皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其四 贵妃閤","author":"洪咨夔","text":"鳷鹊雪残笼霁景，鵁鶄波暖飏纹漪。\n宫中不用催行乐，草木群生各自熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其二 贵妃閤","author":"洪咨夔","text":"象应轩龙次，恩承帝座光。\n燕坛风澹荡，蚕馆日舒长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端平三年春帖子词 其三 贵妃閤","author":"洪咨夔","text":"春透蓬莱碧玉壶，晴窗恭侍宝奎敷。\n从容玩画家人卦，取次题箴列女图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭 其二","author":"洪咨夔","text":"晴雷碾破白云窝，无数林华衮下坡。\n好把辘轳翻转着，昆崙顶上卷黄河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭 其一","author":"洪咨夔","text":"壮杉耄桧护嵌空，飞堕蜿蜒白玉虹。\n莫道隔凡元有柱，胡麻流出石矼东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鄱江楼晚望","author":"洪咨夔","text":"暮雨才收未炙灯，苍鹥掠破岸阴澄。\n须臾认得船头竹，始信渔人挂起罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"槿花","author":"洪咨夔","text":"露径风篱取次芳，朝荣暮悴付流光。\n一秋朵朵红相续，比着人情大段长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潭毒关","author":"洪咨夔","text":"倚天翠壁夹黄流，伛偻呕哑挽上舟。\n今古英雄愁绝处，夕阳筹笔驿东头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李参政范殿撰大散关诗后","author":"洪咨夔","text":"秦关老月几亏盈，长照诗人白发明。\n一死一生沤起灭，未应于此见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题钟春伯所示周昉明皇对弈图","author":"洪咨夔","text":"宝栏十二午阴移，思入云霄落子迟。\n当局早知提醒着，危机应不堕蛾眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠小儿医","author":"洪咨夔","text":"忍饥觅句孟东野，守寂草玄杨子云。\n囊有遗书无与读，两家恨不早逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石室朱修行 其二","author":"洪咨夔","text":"落叶堆中折脚铛，白云煮尽又还生。\n洞门黄鹤婆娑舞，留得松风待月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石室朱修行 其一","author":"洪咨夔","text":"响泉一派落天风，人在浮云柳絮中。\n亭午柴关犹未启，碧玲珑底拒霜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠洪子需 其二","author":"洪咨夔","text":"楼倚晴空月满湖，一尘飞不到庭除。\n虞初九百浑高阁，且读人间本分书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠洪子需 其一","author":"洪咨夔","text":"莫恃青春两颊红，年来我已鬓如蓬。\n盘洲野处源流在，早挹文名尉若翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徽州叶司理送冬笋","author":"洪咨夔","text":"冻雪晴边白柄镵，浴泥扶出锦绷衫。\n定知王谢家苗裔，风味生来便不凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙酉六月十九日应诏言事九月一日去国一首","author":"洪咨夔","text":"黑风吹雨出长安，破帽骚骚怯暮寒。\n不得之乎成一事，却因而已失三官。\n人心天理推详易，世路交情点检难。\n白发老人经事惯，教儿只作博投看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁亥岁朝把笔","author":"洪咨夔","text":"鸡唤璇杓一夜东，长天绀碧静无风。\n年华老子欢娱里，春事儿曹翰墨中。\n脱雪荠芽盘饤绿，晞阳椒蕾酒行红。\n赭袍亲上慈明册，正想千官会汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"洪咨夔","text":"好个牵牛织女天，凄其独夜不成眠。\n柳家细婢何能问，太尉粗人祗自怜。\n比翼难磨终古恨，妩眉未了宿生缘。\n新凉如水谁消得，平等天公也解偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日复口","author":"洪咨夔","text":"凉边未放菊花斑，莫作重阳节物看。\n就网买鱼风露重，推篷举酒水天宽。\n箭头岁月离弦易，局面功名下着难。\n惭愧竟陵江上叟，采菰捣黍鬓毛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日阅武预观军容退而纪事","author":"洪咨夔","text":"遨头不管菊花寒，簇队晨登上将坛。\n戏马台前千古事，筹边楼下万人看。\n弓声浏亮秋风劲，旗采精明宿雨乾。\n后部铙歌归较晚，雪西烽火报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九月四日过增口道中","author":"洪咨夔","text":"秋光拍塞小村墟，高下人家意自如。\n屋底四蚕抽蛹细，墙头三桂着花疏。\n握儿早秫酒无限，杓子晚菘齑有馀。\n大似元丰年界好，天应容我老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九州山僧房","author":"洪咨夔","text":"路突亭依石，林凹渚见沙。\n嵚危几岣嵝，深蔚似琅琊。\n客倦惊寒思，僧闲忘岁华。\n两窗风露影，一树枇杷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月二十七游仙洞次壁间韵","author":"洪咨夔","text":"点脚地维绝，举头天语闻。\n瀑泉飞响雪，洞石涌崩云。\n缥缈追元放，低回揖郭文。\n神清知好在，烟锁绿苔纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八阵图","author":"洪咨夔","text":"负卦龟藏尾，鸣皋鹤引吭。\n纵横中左右，奇正锐圆方。\n石挟孤忠在，江输宿恨长。\n无人同领会，搔首立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月晦过巫山 其二","author":"洪咨夔","text":"客里年华老，船头日色曛。\n天寒催雨雪，地远隔飞云。\n为吏徒三尺，于民未一分。\n重惭豪杰士，度外立奇勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月晦过巫山 其一","author":"洪咨夔","text":"巫峡逢初度，平生一段奇。\n江山襟抱写，岁月鬓毛知。\n神女翻旗下，冯夷叠鼓随。\n直须豪举酒，捩柂不妨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次及甫渚宫","author":"洪咨夔","text":"南楼风物远，西郭市声连。\n蝇虎寒窗搏，蜗牛败壁缘。\n怀人乔木外，吊古折荷边。\n富贵今安在，樵归唤渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和忆可庵","author":"洪咨夔","text":"耐翁流庆遍仍来，随处烝尝荐笋苔。\n但认白云飞一点，便胜黄犊走千回。\n屋山早露柤梨熟，墓道秋风菊桂开。\n父子相从归展省，岂无野水为添杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又塔院","author":"洪咨夔","text":"僧伽传法处，阿育放光时。\n到顶直无缝，透心横有枝。\n梅间诗凤咮，竹里酒鸱夷。\n醉上危层去，空明渺所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又敬和还家","author":"洪咨夔","text":"丧家知似狗，生子望如狼。\n过尽灯花影，空馀汗竹香。\n菊肥人自瘦，发短虑何长。\n霜蟹新篘酒，由来苦易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又敬和还家自喜","author":"洪咨夔","text":"溪山鱼鸟识车尘，风日温明试小春。\n黄帽青鞋安乐法，芋魁豆荚太平人。\n接篱倒着情怀放，蓬沓逢迎气味真。\n儿亦梦牵潭上菊，和香细嚼胜猩唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又敬和寓舍","author":"洪咨夔","text":"借得卢仝屋数间，不为太窄不为宽。\n胸中鹏背三千里，膜外羊肠百八盘。\n薜荔水中摽本远，菖蒲石上见花难。\n粗茶粝饭随缘过，等作须弥芥子看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又答孙正叔","author":"洪咨夔","text":"万里西风雁影斜，平安书到鲁家沙。\n遣愁白堕须行瓮，报喜乌邪又满车。\n老屋打头思钓隐，健舻衔尾认诗家。\n道旁啁哳儿童说，有脚阳春向浣花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又答景扬","author":"洪咨夔","text":"朝家久设礼为罗，小寄禅窗共讲磨。\n红锦障泥飞騕袅，黄金宝校琢盘陀。\n冰齑荐饭乡风古，雪汁烹茶雅道多。\n领取单传心法去，会将佛祖一时呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三日兄弟侍老人展墓归和尊韵","author":"洪咨夔","text":"云淡风柔霁色轻，泷冈阡上气和明。\n莫思旧日遨头出，且试新年便面行。\n饱饭即为君子泰，浊醪不失圣人清。\n一翁二季春无尽，更愿诸孙向老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳呈子有","author":"洪咨夔","text":"隔水梨花豪放尽，安排鼠耳到庭槐。\n十分春事杜门过，百色老怀中酒来。\n闻丽人行头辄掉，见兰亭帖眼还开。\n碧衫玉唾酴醾晚，更倩诗翁着句催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夕阳","author":"洪咨夔","text":"百丈岗头路，沧凉步夕阳。\n石芒轻放屦，草荚紧牵裳。\n深紫猴楂熟，疏红马蓼荒。\n牧儿良得意，吹笛下牛羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大人和云楼底雪千峰楼头着寓翁梅方开萼绿桃已亚枝红斟浅偏劳劝眠迟不受烘锦城春在眼何暇问蚕丛时四川李制置以荣州见辟辞之也某因用前韵","author":"洪咨夔","text":"寄榻高寒地，收心懒散翁。\n鸡鸣虚室白，鸦起小窗红。\n古操尘弦拂，新诗冻研烘。\n桃梅芳意觉，不是去年丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雪前三日钟冠之约余侍老人行山舟发后洪入杜坞自郑盖庵过阆山趋翔凤山菁山遍览杨坟秀园遂至何山道场山乘兴薄吴兴访玉湖书院水晶境界而归自戊子至庚子阴晴相半胜处辄徘徊赋诗饮酒伟哉观也数诗见后 出阆山","author":"洪咨夔","text":"无雨又无日，此行天相之。\n荒园遗木老，古隧得峰奇。\n霜晚蔬犹剑，风温茗已旗。\n行厨何用许，胜处可忘饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雪前三日钟冠之约余侍老人行山舟发后洪入杜坞自郑盖庵过阆山趋翔凤山菁山遍览杨坟秀园遂至何山道场山乘兴薄吴兴访玉湖书院水晶境界而归自戊子至庚子阴晴相半胜处辄徘徊赋诗饮酒伟哉观也数诗见后 翔凤山资福寺","author":"洪咨夔","text":"听雨客无寐，放晴山有灵。\n禅关深紫翠，勋庙肃丹青。\n鳌负摩云碣，龙扶拱日屏。\n真如无尽意，石涧水泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小雪前三日钟冠之约余侍老人行山舟发后洪入杜坞自郑盖庵过阆山趋翔凤山菁山遍览杨坟秀园遂至何山道场山乘兴薄吴兴访玉湖书院水晶境界而归自戊子至庚子阴晴相半胜处辄徘徊赋诗饮酒伟哉观也数诗见后 谨和老人凤口遇雨","author":"洪咨夔","text":"狂暖酿成雨，逆风摇断桡。\n寂谈王舍卫，闷想郁台萧。\n游兴孤芒屩，归期数翠翘。\n推篷占霁色，木末散声招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中菰生米父老谓丰年之祥用子有韵","author":"洪咨夔","text":"秋风菰黍黑，山崦罕闻之。\n产瑞摇银海，占丰滟玉池。\n芃芃粳合穗，袅袅穄分枝。\n却忆官张望，尝新荐一匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山房藏书万三千卷子有赋诗用韵","author":"洪咨夔","text":"门巷萧然雀可罗，藏山万卷自研磨。\n懒寻玉女登西岳，甘伴金仙坐补陀。\n书带草长尘虑少，钵昙花放道缘多。\n酒肴问字如相过，引道松间不用呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中春中浣后一日老人挈累下西市寓舍越三日某行感而赋诗呈友人 其二","author":"洪咨夔","text":"吐气韶华里，关心晓哢边。\n鹧鸪天性在，杜宇世情然。\n怒笋和泥煮，殷花蘸乳煎。\n须君来共此，已办杖头钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中春中浣后一日老人挈累下西市寓舍越三日某行感而赋诗呈友人 其一","author":"洪咨夔","text":"血气危频复，头颅老数奇。\n家如缘角鼠，身是脱筒龟。\n草树春离列，云山晚蔽亏。\n意行随所到，不必问何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋秭归岸下","author":"洪咨夔","text":"出蜀趋吴第一州，夕凉随意系扁舟。\n十分人鲊瓮头月，一片水晶宫里秋。\n夜气长存号老鹤，天机自动舞潜虬。\n得归到处皆佳思，不问西风解白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋楚东对月次曹提管韵","author":"洪咨夔","text":"西风一笑话绸缪，白露横江滴滴秋。\n天没遮栏金饼上，水无边际玉绳收。\n扶将太白酣方适，唤起冯夷舞未休。\n今夕明年应更好，夜潮来处倚危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月五日集英殿策士从官待宣于内军器库廊","author":"洪咨夔","text":"汉廷与目策英豪，投钓知谁首掣鳌。\n百日红连纶阁迥，万年枝拂禁城高。\n内廊坐永风生席，辇路归迟月映袍。\n西抹东涂浑忘却，一絇短雪不堪搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝农呈丘帅 其一","author":"洪咨夔","text":"劭耕好语落西畴，父老逢迎笑点头。\n销甲事农官有术，卖薪沽酒我何忧。\n黄金深椀频倾倒，白布长衫迭献酬。\n飒飒雨华随后乘，安排麦陇十分秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝农呈丘帅 其二","author":"洪咨夔","text":"南楼健目略江皋，淅蔌风沙响鬓毛。\n草色不随壕岸断，柳梢恰与女墙高。\n碧幢红旆三边帅，羽扇纶巾一世豪。\n坐上捷书来猎猎，官军破贼战方鏖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"午困","author":"洪咨夔","text":"故人书断故山离，义重惟穷到处随。\n无米胸中元自杵，不蚕鬓底却能丝。\n消梅乞与嘲盐贵，苦笋烹来怪酱迟。\n亡可柰何安若命，午窗赢得睡便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太一宫斋祭呈司封吴舍人","author":"洪咨夔","text":"宝钥轰霄启玉晨，风恬雪霁净无尘。\n东皇太一紫坛晓，世界大千青陆春。\n藜杖流光环佩集，锋旗敛影豆笾陈。\n乐歌须仗甘泉笔，斧藻天家泰道新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大行皇太后挽词二首 其二","author":"陈师道","text":"扶日行黄道，乘云上紫微。\n忧劳形末命，恭俭见陈衣。\n布德开刑网，和戎戢武威。\n要知怀惠处，行路涕交挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太庙致斋","author":"洪咨夔","text":"风雨残春晚作晴，宝山深静勃鸠鸣。\n云收翠戟龙文润，日透金铺兽面明。\n蚕出火时桑正沃，秧抽颖处麦还成。\n在天列圣孙谋远，流福人间酿太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开济堂","author":"洪咨夔","text":"鱼复平沙涨夕阴，红旗影底老蛟吟。\n穷今亘古三分恨，托地撑天一寸心。\n过雨断云闲绝壁，凉风归鸟急平林。\n江山难着醒时眼，有酒如渑放手斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"引镜","author":"洪咨夔","text":"水白深还黑，山黄远自青。\n纷然无定色，何者是真形。\n不坏只太极，长存惟六经。\n莫疑晨镜里，黳漆换星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方氏棣华桂丛亭各一首 其一","author":"洪咨夔","text":"一忍来百顺，寸私生万殊。\n能思根共出，自爱鄂相扶。\n夜雨平生约，春风尽日娱。\n几家燃豆泣，知愧脊令无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方氏棣华桂丛亭各一首 其二","author":"洪咨夔","text":"天上广寒种，人间方寸栽。\n田三和气溢，窦十庆源开。\n色阅风霜在，香包月露来。\n八窗秋竞爽，堪覆掌中杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水仙","author":"洪咨夔","text":"万卉净如扫，风霜犹典刑。\n睟容闲整整，姱节矫亭亭。\n几滑铜熏鼎，窗明石砚屏。\n窈深人不到，香触梦魂醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":39629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]