nce":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其八 烂熳二十八枝","author":"宋伯仁","text":"经纬出天机，画檐斜挂箅。\n可惜巧于蚕，无补人间世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十七 烂熳二十八枝","author":"宋伯仁","text":"新绿小池沼，田田浮翠钱。\n雨中珠万颗，巧妇其能穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十二 烂熳二十八枝","author":"宋伯仁","text":"足下一封书，子卿归自虏。\n虽曰诳单于，孤忠传万古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二十七 烂熳二十八枝","author":"宋伯仁","text":"万里收纤云，一钩悬碧落。\n缺圆无定时，人间几愁乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十一 烂熳二十八枝","author":"宋伯仁","text":"花香专引蝶，非蝶亦飞来。\n顾影不知耻，良为贪者哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其二十八 烂熳二十八枝","author":"宋伯仁","text":"无心出岫时，山腰横一抹。\n为霖覆手间，岂容留旱魃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e0