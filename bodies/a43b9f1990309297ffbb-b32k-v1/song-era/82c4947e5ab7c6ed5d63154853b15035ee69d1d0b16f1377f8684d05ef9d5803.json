15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其一 就实六枝","author":"宋伯仁","text":"羽翼汉家了，忘形天地间。\n个中有真乐，奚必拘商山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其四 蓓蕾四枝","author":"宋伯仁","text":"爬沙走江海，惯识风波恶。\n东君为主张，显戮逃砧镬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其三 蓓蕾四枝","author":"宋伯仁","text":"献颂侈春朝，争期千岁寿。\n凌寒傲岁时，自与冰霜久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明插柳","author":"宋伯仁","text":"清明是处插垂杨，院宇深深绿翠藏。\n心地不为尘俗累，不簪杨柳也何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔人","author":"宋伯仁","text":"不求豪富不求官，衣钵相传一钓竿。\n醉展绿蓑眠便得，满城风雨自春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬万花园","author":"宋伯仁","text":"细柳营基锁绿苔，万花新种小亭台。\n芙蓉喜见江南客，故向西风一夜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓目 其一","author":"宋伯仁","text":"暖风轻拨绣帘开，放入双双紫燕来。\n燕子似于人有旧，细衔花片落妆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓目 其二","author":"宋伯仁","text":"昼景逢春渐渐长，博山添爇半匙香。\n梅花一片娇无力，自趁晴风过粉墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散愁四首 其四","author":"宋伯仁","text":"旋买犁锄学种田，一声长啸霅溪边。\n微茫白水山如画，好个江南万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散愁四首 其三","author":"宋伯仁","text":"清贫如水尽无妨，只愿伊周立庙堂。\n扶起太平千载脉，且随农父乐耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散愁四首 其二","author":"宋伯仁","text":"小楼呼酒揖青山，翠碧珑璁一笑间。\n山若有情应问我，如何犹似野人閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散愁四首 其一","author":"宋伯仁","text":"著意功名四十年，柳花空满鬓丝边。\n男儿无补朝廷事，有愧饥餐困即眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棋","author":"宋伯仁","text":"乱鸦飞鹭势纵横，对面机心岂易萌。\n一著错时都是错，宁无冷眼看输赢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上","author":"宋伯仁","text":"一泓寒玉浸青山，妆点楼台夕照间。\n歌管满船春未懒，惜无人伴白鸥闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上新晴","author":"宋伯仁","text":"湖边膏雨弄晴时，桃杏红争锦一机。\n杨柳也如新及第，向人争舞绿罗衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼花","author":"宋伯仁","text":"莫讶重栽聚八仙，几经边警亦堪怜。\n珠帘十里春狼籍，且把天香作旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"愁","author":"宋伯仁","text":"愁怀难画亦难诗，惟有流莺暗得知。\n我亦无言莺不语，柳边相看立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简施芸隐","author":"宋伯仁","text":"雪后东风作峭寒，客怀零乱客眉攒。\n杭州虽近西湖月，宁似湖州把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓼花","author":"宋伯仁","text":"秋到梧桐我未宜，蓼花何事已先知。\n朝来数点西风雨，喜见深红四五枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲醉者","author":"宋伯仁","text":"李白日斟三百盏，醉时宁记脱朝靴。\n一千八十万杯酒，百岁消磨未是多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲燕","author":"宋伯仁","text":"年来乳燕亦堪羞，不学杨花得自由。\n飞过几家门户去，直须寻见最高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中登楼","author":"宋伯仁","text":"明主何尝弃浩然，杯中有物且随缘。\n倚楼心事谁消遣，一点飞禽落钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写梅者","author":"宋伯仁","text":"学画梅花又学诗，不须频说见钱迟。\n知音自有和羹手，祇恐知音未得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丁家村","author":"宋伯仁","text":"不满十来家，门闾半以柴。\n日烘兰入鼻，风掠草侵鞋。\n土酒融春兴，行歌放客怀。\n何须高买屋，一一近天街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上存耕先生赵大资","author":"宋伯仁","text":"清朝登用旧英耆，圣主忧民展皱眉。\n万寓已绵千岁脉，十年新改一盘棋。\n吟髭雪映尧黄屋，讲厦春生汉玉卮。\n补衮日增磐石重，诗人喜见太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久坐","author":"宋伯仁","text":"坐久如忘世，松窗日未斜。\n营巢鸦噪树，作梦蝶眠花。\n易课推三画，医方录数家。\n瓶笙声未绝，更点土山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨","author":"宋伯仁","text":"暗数春来雨，曾无两日晴。\n树连山莫辨，桥与水俱平。\n闭户惟便懒，逢人且问耕。\n海棠花落尽，憔悴几流莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书座右","author":"宋伯仁","text":"蛮触小功名，须教一念轻。\n受恩知报饭，临事贵惩羹。\n寿域惟仁宅，心田以道耕。\n泰然忘物我，无使狎鸥惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书座左","author":"宋伯仁","text":"天地一蘧庐，吾身自卷舒。\n翁能从失马，子亦岂知鱼。\n谨独甘居漏，安贫且饭疏。\n昨非今未是，宁不赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]