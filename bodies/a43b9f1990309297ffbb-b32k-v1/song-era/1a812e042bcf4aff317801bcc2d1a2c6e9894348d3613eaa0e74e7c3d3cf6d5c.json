[{"title":"早岁","author":"赵蕃","text":"早岁耽诗老不工，但馀多难似诗穷。\n忽来数纸丁宁甚，恍忆他时缱绻同。\n幕府十年公勿厌，风霜满面我思东。\n几因江发蛮夷涨，欲问渔翁借短篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行五首 其五","author":"赵蕃","text":"落月挂林高，溪行屡著篙。\n不令惊水宿，频觉送鸡号。\n此趋今成熟，吾生毋乃劳。\n何能永谢去，自学小舟操。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行五首 其四","author":"赵蕃","text":"茅屋鸡初递，枫林月半残。\n滩倾惊枕仄，露下觉衾寒。\n客子愁无那，舟人语未阑。\n兰溪今夜泊，须酒慰艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行五首 其三","author":"赵蕃","text":"蓐食催束担，候月不待鸡。\n始焉星垂野，转已雾寒溪。\n苇杭悸攲侧，鸡栖困攀跻。\n何可数道路，无为厌蒿藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行五首 其二","author":"赵蕃","text":"万石湖南港，杨林湖北潭。\n不胜摇橹倦，顾欲使风贪。\n凛凛岩墙戒，悠悠鸩毒耽。\n频能愧沙鸟，数可傲征帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行五首 其一","author":"赵蕃","text":"前迈不待晓，昔归何苦稽。\n挂帆欣暂逸，薄险悸深挤。\n试问危行水，何如稳杖藜。\n梅花好调护，春事有端倪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早行示同舟","author":"赵蕃","text":"了了晴山见，纷纷宿雾空。\n樵归妇腰斧，渔罢叟收筒。\n但取登临适，何须吟啸工。\n平生钓台路，明日与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早过兴福寺","author":"赵蕃","text":"谒客因过寺，无车且借驴。\n晴岚四填拥，我意一凋疏。\n僧劝茱萸饮，身能瘴疠祛。\n宁堪久居此，曷日遂归与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早过桐江与峡江甚近也","author":"赵蕃","text":"雾尽山容出，风微水面平。\n檄书重此役，诗卷足平生。\n船小炊无灶，滩长去有程。\n尝评峡江似，江水亦桐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早作","author":"赵蕃","text":"鸡送山窗月，钟残攲枕眠。\n栉疏知鬓秃，肘见觉裘穿。\n觅句无新意，翻书有旧缘。\n纵违幽事喜，差免俗尘煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早作","author":"赵蕃","text":"萧萧初对雨，滟滟急看晴。\n远树孤烟出，旷陂春水生。\n不关形役累，自作野田行。\n独愧龙钟者，犹驱觳觫耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早饭大明寺因题","author":"赵蕃","text":"晨起浑疑晚，山晴尚踏泥。\n花边花鸭卧，竹里竹鸡啼。\n问店欣逢寺，命车仍杖藜。\n松篁犹有径，桃李得无蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早到超果寺示成父且约归日携家来游","author":"赵蕃","text":"雾里看花喜未昏，竹园啼鸟爱频言。\n土膏稚麦如争长，水脉清流却变浑。\n负郭无如此山寺，携家更拟泛溪村。\n卜居苦欲规佳处，佳处都归祇树园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早起登览有怀山居","author":"赵蕃","text":"日出早烟消，舟行不待招。\n乍明村市坞，初露远山椒。\n胜处宜规隐，浮生只浪飘。\n章泉在何许，绕堑碧萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早醉","author":"赵蕃","text":"晨起倦乌巾，还倾老瓦盆。\n自知中了了，人谓日昏昏。\n迤逦溪山别，披纷雁鹜喧。\n春风得亡赖，幽趣与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早题","author":"赵蕃","text":"夜雨晓犹湿，晓天晴未分。\n澄波静如练，秀野绿于云。\n禽语无殊听，乡音有异闻。\n要知皆可隐，鸟兽讵同群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有以灵寿杖为贶周旋累年忽尔摧折感而赋之","author":"赵蕃","text":"度岭且万里，友于凡几年。\n忽惊同拉朽，何敢恃扶颠。\n跻胜亡行具，结趺聊坐禅。\n山南与山北，从此罢蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次毕叔文见贻二首 其二","author":"赵蕃","text":"寂寞吾知贵，纷华世所荣。\n常评败素紫，孰愈浊缨清。\n爵禄心无食，山林志有盟。\n幽居自空谷，哲妇乃倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次毕叔文见贻二首 其一","author":"赵蕃","text":"山川略吴楚，岁月涉春秋。\n为米愧元亮，乘舟思子猷。\n黑貂尘土重，白鬓雪霜稠。\n志合成三益，诗来减四愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次季奕见怀","author":"赵蕃","text":"雨脚何其厚，云头不易空。\n病怜山叟甚，诗喜故人通。\n慰藉殷勤里，吟哦怅望中。\n地炉无热火，林屋但鸣风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子肃怀远斋并以见及","author":"赵蕃","text":"如公人物表，上下孰分床。\n但有官成集，初无智作囊。\n所嗟人契阔，不为雨悲凉。\n顾我端何幸，新诗获夜光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子肃秋日感兴兼怀公择二首 其二","author":"赵蕃","text":"秋尽谁无狐貉思，一年行矣又垂垂。\n顾惭志行如山立，敢为推迁作浪悲。\n贫贱已知安少壮，功名何有望衰迟。\n长安此际尤萧索，坐念故人应窘炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子肃秋日感兴兼怀公择二首 其一","author":"赵蕃","text":"炎冷财分覆手间，化机于尔见深悭。\n归欤君钓荆溪水，已矣我耕怀玉山。\n几羡脩翎辞世网，绝怜骏足老天闲。\n区区莫有穷途叹，了了要从初地还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子耕去秋临安归途见过于玉山智门寺之作","author":"赵蕃","text":"不但乘舟亦跨鞍，道长无地问平安。\n相逢只谩分襟速，既别方知聚首难。\n海内忘形今有几，天隅独在若为宽。\n夜过林寺犹前日，诗到还成隔岁看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元衡忆上饶见示七言","author":"赵蕃","text":"避兵俱落信州溪，为客岂知湖外期。\n远役不应因米屈，秋风政尔怅鲈时。\n故人已寄招魂作，吾子重歌隐士诗。\n回首天寒又霜雪，可教猿鹤苦凄悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王进之雨中见怀并示诗卷","author":"赵蕃","text":"落落穷居无与徒，几思短李及辛迂。\n别时尚欲题书寄，近处何须折简呼。\n笔下烟云宁取异，胸中丘壑本来殊。\n年侵病剧浑忘却，今日因君整旧模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王驹父","author":"赵蕃","text":"谁欤觅我更贻诗，欲报翻惭思苦迟。\n自古结交真有道，可能随俗似凡儿。\n功名有命宁须此，贫贱从吾欲怨谁。\n我亦与君俱白发，世间冷煖要当知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叶德章见示","author":"赵蕃","text":"穷冬未省见梅班，故里何繇报竹安。\n归意宁须卜以决，衰颜不待镜频看。\n交情谢子来今雨，节物娱予后苦寒。\n独苦更怜终漫兴，不如骫骳得天欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘先生送行并令诸友及子侄同赋","author":"赵蕃","text":"斗食缀散吏，幽栖还故山。\n平生读书志，欠此历年闲。\n马倦政长路，鹭饥方浅弯。\n吾师与吾友，高处若为攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵毕叔文牡丹","author":"赵蕃","text":"春来不雨即冲风，纸贵冲阳欠此工。\n未问姚黄并魏紫，但思涧碧与山红。\n敲门惠我枉新作，展卷想君恰绕丛。\n旧事与谁谈洛下，倦游聊尔话黔中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵在伯对雪见示","author":"赵蕃","text":"初迷庭砌与墙阴，旋著遥山及远林。\n飘洒故看朝已积，缤纷更觉昼弥深。\n东都皎皎关门卧，鲁国寥寥振履音。\n作气再衰三则竭，强拈愁笔和高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵在伯夏夜独坐见怀之作","author":"赵蕃","text":"暑气侵人抵病中，阙然求旧管城公。\n相逢共说山中月，有赠忽来天未风。\n君向离骚熟兰芷，我于尔雅昧鱼虫。\n纵令酒盏能频把，孰若诗筒得屡通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵孙温叟问讯之韵","author":"赵蕃","text":"拊髀尝闻问牧颇，祇今时势定如何。\n要知绝恶思除本，莫为轻降信倒戈。\n幕府似公犹不用，官曹如我政宜诃。\n兵传家法檄愈疾，不但有诗皆可歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵师契早过东园","author":"赵蕃","text":"旧说东西圃，新知上下池。\n山亭犹有记，水馆独无碑。\n疏凿由今守，登临要子诗。\n倦游吾老矣，况复思多迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵师契诗中及赈贷事","author":"赵蕃","text":"督赋停勾赤，开仓体诏黄。\n旧唯优附郭，近乃略诸乡。\n天意终深恤，人谋岂尽长。\n要须梅雨歇，快放麦风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵成父","author":"赵蕃","text":"山经立壁动危情，路入悬崖作峭行。\n雨露正昏当昼黑，瀑泉倒泻助波惊。\n万无一理可至寇，十有九家空避兵。\n愧子远来端有意，更开诗箧对灯檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵成父舟中","author":"赵蕃","text":"久客日复日，穷冬冰复冰。\n知还怜倦鸟，侧翅耻饥鹰。\n搔发伤今老，沿塘记昔曾。\n舒忧足行卷，教谄谢书縢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严从礼兼简明叔","author":"赵蕃","text":"晚风吹雨过前湾，载酒谁欤起病颜。\n政尔交游能不乏，故知酬唱未令悭。\n只今冲口从俱录，异日芜词合细删。\n如我论材真款段，两君骏足本天闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯瑞见示并怀叔骥和叔","author":"赵蕃","text":"世情易作风沙散，我辈端知雪柏坚。\n不以翱翔鸿鹄与，遂忘寂寞鹭鸥边。\n往来苕霅浑疑梦，邂逅潇湘重足怜。\n何日笑呼贤伯仲，持螯剥芡大人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯瑞叔骥常字韵","author":"赵蕃","text":"来往区区莫谩忙，转头还是俗相妨。\n题诗见子留人意，作客如家自我常。\n休叹清明仍值雨，好于元巳趁还乡。\n布衾木枕犹堪质，要似当年人姓阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何叔信","author":"赵蕃","text":"苔藓斑斑过雨廊，菱荷猎猎晚秋乡。\n庐山大似要元亮，江夏安能隐戴良。\n酒遇诸豪君可敌，诗逢二妙我无长。\n昔何勇锐今何怯，畅叙深孤咏与觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何叔信书斋梅花","author":"赵蕃","text":"坐对窗中帙，起寻檐外花。\n因之观物化，藉以发天葩。\n一笑故无恙，百年终匪他。\n端殊苦心士，志失鬓先华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何叔信刘元之魏昭父","author":"赵蕃","text":"往事悠悠谁悼屈，土风往往但争舟。\n儿童助勇竞拍手，鸥鹭惊飞皆落流。\n倦客归心思鹢首，壮年科第慕龙头。\n诗中具见飘飘意，如我将搴杜若洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵佥判丈","author":"赵蕃","text":"芳游忽忽未多谐，芳事匆匆已覆杯。\n可恨海棠经雨尽，尚馀芍药殿春开。\n公能有意巾车出，我亦乘闲步屧来。\n倚杖看花从迫窄，未妨随处一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴仲权镒见简","author":"赵蕃","text":"今代风骚将，先生合冠军。\n几年求识面，数刻遂离群。\n江急舟难驻，风回橹细闻。\n还家经醉卧，斜日对炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵希登送行之什","author":"赵蕃","text":"频年颇觉困邅屯，勇意归寻寂寞滨。\n去日屡移虽怕别，积霖成潦政迷津。\n浮生聚散不终免，一语丁宁惟爱身。\n来岁入关须早计，要期过我待王春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张王臣既晴复雨欲去尚留见示且以识别二首 其二","author":"赵蕃","text":"我住难期夏，君归岂待秋。\n投章同缟带，共敝愈轻裘。\n浩浩群属玉，阴阴黄栗留。\n叙行如有寄，伺处觅孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张王臣既晴复雨欲去尚留见示且以识别二首 其一","author":"赵蕃","text":"逾月能连雨，今晨少散阴。\n病宽游子念，愁豁老农心。\n始虑春成旱，那知夏苦淫。\n举头问白日，恇怯一何深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李子永","author":"赵蕃","text":"词源谁可障东之，今代谪仙仍有诗。\n戏调犹能出平澹，意加每辄造瑰奇。\n白头不用论新贵，黄卷惟应保素知。\n我恨从公十年晚，公宁于我亦深期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李子永见贻","author":"赵蕃","text":"何能辛苦叹人穷，况复经行觅句工。\n平日相思在天末，今年远别遂湘中。\n饥寒似我谁驱迫，人物如公孰长雄。\n蕙帐山人久寂寞，曾何台省欠诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李商叟见示","author":"赵蕃","text":"路熟江郊不待寻，每来真得慰余心。\n新诗自作弹丸羡，旧帖不教鱼蠹侵。\n莫叹高山与流水，难迷美玉及精金。\n频年浪作江湖走，从此冰溪得并吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵远斋夜饮舒啸之作并呈坐间诸公","author":"赵蕃","text":"偶上坡亭底用扶，登临于此记公初。\n不胜酒敌先齐败，粗有诗资皆楚馀。\n出处绝知难逆计，从游常恐易成疏。\n啸挥边骑数君事，我自欲安陶令庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵远斋春雨有感","author":"赵蕃","text":"春今著物几陈新，未抵新诗得许荣。\n韩子虽云誉东野，侯生终竟愧弥明。\n已知林下栖迟计，何处人间宠辱惊。\n更欲从公问归宿，夜深风雨四山倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈县丞谢送笋","author":"赵蕃","text":"官曹常恐废书勋，赖是相看有竹君。\n送笋但知修岁例，辱诗还喜继前闻。\n馋涎肯为口腹计，幽处要期风月分。\n我事且然成忤俗，奈何君复露奇文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叔骥兼呈伯瑞二首 其二","author":"赵蕃","text":"贻我五字句，清诗曷以酬。\n端知檄愈疾，未信酒忘忧。\n多难屡濒死，诸兄虚见收。\n病驹叨席秣，顾影益增羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵叔骥兼呈伯瑞二首 其一","author":"赵蕃","text":"晚作临邛客，相如真倦游。\n又成悲卒岁，及此问归舟。\n共隐期他日，相逢记此州。\n江湖有来雁，可以谢书不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵周钦止送别","author":"赵蕃","text":"不见送将归，惟闻远别离。\n身今成老大，官岂计高卑。\n萧寺已移酒，便人还枉诗。\n临风三复罢，有恨落无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和仲留别之什","author":"赵蕃","text":"政怯离忧致感伤，要烦杯酒洗苍茫。\n湖山已负二楼胜，风雨还并一笑妨。\n邂逅苦为轻此别，漂流重见定何方。\n人归帝所门非邃，江出岷山道苦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和叔并呈叔鱼","author":"赵蕃","text":"望望吴楚隔，悠悠兄弟思。\n经行偶来过，喜极为成诗。\n二父已名世，诸郎皆好辞。\n谁云前辈远，未觉此风衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和答斯远入城见迎诗 其二","author":"赵蕃","text":"四海岂不广，一身何所归。\n倦游成白首，知已固黄扉。\n愧我尚斗食，如君犹褐衣。\n长年恨相远，晚岁得相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和答斯远入城见迎诗 其一","author":"赵蕃","text":"往辱携诗送，今劳入郭迎。\n交情如许厚，俗眼亦增明。\n冬仲溪宜涸，滩长路失平。\n要归归已近，物物系吾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和答斯远见过","author":"赵蕃","text":"旧书零落不能收，漫说当年寒具油。\n归至未成三径扫，契深重叙百年游。\n交情要是乐莫乐，世态从渠浮自浮。\n雨薄云开冬似暖，一杯相与共扶头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵审知十七夜","author":"赵蕃","text":"风月当佳可易捐，共须重立虎溪边。\n天于变化自奇手，人欲追摹真强怜。\n牢落朱弦千载下，凄凉青鬓十年前。\n放歌莫作商声发，惊起沙头鸥鹭眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵审知见示梅花长句","author":"赵蕃","text":"春入孤山今主谁，空留四海旧传诗。\n平生我亦有成约，病起骤欣逢好枝。\n欲向园林穷胜处，不堪风雨苦淹时。\n忽来绝唱惊寒眼，势比南朝更崛奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵审知寄来二首 其二","author":"赵蕃","text":"书去愁难悉，诗来造愈奇。\n为言僧可寓，为念橐空垂。\n鸣鴂惊时晚，羁鸿暂水湄。\n逆风仍上水，日月是难期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵审知寄来二首 其一","author":"赵蕃","text":"一日复一日，何胜一万周。\n有山皆崒崒，无水不悠悠。\n为我谋归策，将诗说旧游。\n山林与城市，吾亦任乘流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]