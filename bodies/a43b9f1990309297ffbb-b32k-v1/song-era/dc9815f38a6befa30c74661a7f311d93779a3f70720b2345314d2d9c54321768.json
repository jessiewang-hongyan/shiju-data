[{"title":"送周奉议赴吴江 其三","author":"黄裳","text":"一官方解浚桥南，欲试弦歌岂为贪。\n便得洞庭山下去，公馀谁共擘霜柑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏赠席上侍人","author":"黄裳","text":"遮藏不得鬓边霜，空忆扬州一觉长。\n不学牧之狂可笑，紫云宜赠紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑中 其一","author":"黄裳","text":"幽怀无处对秋阴，数叠云峰压翠岑。\n安得水边开一阁，莲花风信满衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暑中 其二","author":"黄裳","text":"炎空方喜雨初过，閒坐又怜风乍来。\n偶得瑞莲传好信，清思应到雪天梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松轩对雨有感","author":"黄裳","text":"田无数亩难回首，士少高风易折腰。\n古往人非秋自老，松轩吟对雨潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上閒赋 其一","author":"黄裳","text":"谁家弦管度前汀，宛似湘江昔有灵。\n一曲未终船已远，白云空点数峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上閒赋 其二","author":"黄裳","text":"烟雨为容似带愁，愁中犹解写人忧。\n数峰出没如何画，寺在波心且舣舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上閒赋 其三","author":"黄裳","text":"想缘仙划与神刓，有是湖光有是山。\n一处一游都几日，也应偷尽九春閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上閒赋 其四","author":"黄裳","text":"源出灵山分外青，若从葛坞更须灵。\n谁知天乐逢真景，难向人间作画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上閒赋 其五","author":"黄裳","text":"筛雨龙山淡淡烟，水帘遥在数峰前。\n问言居士庵何处，为指中洲有陆莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐通直守连州 其一","author":"黄裳","text":"回头犹见折腰时，才到朝班便得麾。\n谁合相从公外乐，玉鳞新出使君池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐通直守连州 其二","author":"黄裳","text":"得官荣与故乡看，初佩鱼符日下还。\n内相远孙真太守，海南佳郡是连山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵芝僧房 其一","author":"黄裳","text":"千顷烟波一亩池，柳堤收得小涟漪。\n谁家堤外寻幽去，渐渐歌声入渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵芝僧房 其二","author":"黄裳","text":"小径悠悠接水天，薰风谁对远师莲。\n吟看尤为湖山好，未肯忘怀便入禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游灵芝僧房 其三","author":"黄裳","text":"翠栏清浅柳如帷，帷外烟光远可窥。\n夜榻晚窗谁是伴，暑风秋月最相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李大夫 其一","author":"黄裳","text":"父子辞荣海上还，二车皆是汉郎官。\n夜来列宿尤光彩，为向溪南隐处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李大夫 其二","author":"黄裳","text":"银鱼慵佩入樊笼，万累相捐万虑空。\n逼岁归来何事晚，荔枝牵率过薰风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李大夫 其三","author":"黄裳","text":"演仙山足退来荣，更继高风适此生。\n一叶轻舟篷上雨，三江攲枕与谁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠致政李大夫 其四","author":"黄裳","text":"世情相失道情浓，语默行藏信意中。\n清退楼前溪一曲，剡川明月剡川风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花 其一","author":"黄裳","text":"香色相生静入观，化工谁怕剪金难。\n秋光欲尽花尤好，都作时情九日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花 其二","author":"黄裳","text":"红尘事事有兴废，黄菊年年无古今。\n意静气清时候好，醉归明日更相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花 其三","author":"黄裳","text":"手把黄花为惜香，况逢真率未尝忙。\n神仙多是无心得，可向桃源作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花 其四","author":"黄裳","text":"葛巾尤有酦醅浓，岂是堤防落帽风。\n我未醉时君莫去，且来闲坐菊丛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂 其一","author":"黄裳","text":"一隅不见古扬州，惟有平山尚自留。\n且看江南山色好，莫缘花月起闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂 其二","author":"黄裳","text":"水涵群影去悠悠，楼有三千转首休。\n想见经游人与物，而今知我梦扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谷林亭","author":"黄裳","text":"竹也中虚谷也虚，两虚相得闹中无。\n月来风动时尤好，那更高人也自如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀井","author":"黄裳","text":"地行仙迹世难知，极数高人出数时。\n隐显自通淮与蜀，兴亡谁管晋兼隋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济朝议守长乐 其一","author":"黄裳","text":"翁子归来第八人，越王家国再逢春。\n悠悠千骑溪南路，今日荣誇到剑津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济朝议守长乐 其二","author":"黄裳","text":"侯王权势腰三印，省寺光阴梦七秋。\n龙虎有人犹扫迹，政风行听海边讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济朝议守长乐 其三","author":"黄裳","text":"三山胜概烟云外，万户清酤鼓乐中。\n待看使君游刃处，始誇濒海有天宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济朝议守长乐 其四","author":"黄裳","text":"两街香案使君来，万瓦青烟洞府开。\n勿剪绿榕阴尽处，七门南直钓龙台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送公济朝议守长乐 其五","author":"黄裳","text":"海渚信来鱼市白，林梢光动酒帘青。\n鳌头须学成都守，莫对三山我独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还乡简清臣潜夫 其一","author":"黄裳","text":"别来交友问如何，松已成林屈指多。\n且喜断金人尚健，一能清爽一平和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还乡简清臣潜夫 其二","author":"黄裳","text":"梦中常作水南游，山北烟霞物外秋。\n好是老僧今在否，我来还上望仙楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还乡简清臣潜夫 其三","author":"黄裳","text":"乘兴拿舟过水南，问禅閒试野僧参。\n望中皆是栖真处，山有云峰剑有潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘教授之官豫江 其一","author":"黄裳","text":"守官何处豫江边，职事无尘我慨然。\n一样清虚谁画得，倚栏人静水中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘教授之官豫江 其二","author":"黄裳","text":"草草挥毫已可传，昔年场屋合争先。\n何时寄我南来信，阁外溪山有几联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日有感","author":"黄裳","text":"桃李娇春总不知，风情惟与道相宜。\n堂前杨柳青丝软，吟看无人独自垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看山亭 其一","author":"黄裳","text":"雨洗烟笼十数峰，两亭相望两山中。\n北来吟了南来醉，花木迎人一径通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看山亭 其二","author":"黄裳","text":"两边红绿路深深，叠怪堆奇出翠岑。\n莫道非真窥得破，能侵天巧似无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和蒋枢密送侍者归","author":"黄裳","text":"谩来非为利名场，随侍还寻野径香。\n静极恐生天上梦，不妨吟入帝云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有客对酌","author":"黄裳","text":"花间人面是谁家，何似才华对物华。\n百五时应来合醉，三千宾客不须誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西归亭","author":"黄裳","text":"衣法传来几度春，少林堂上悄无闻。\n两忘养就空兼色，独步西归一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欧冶池","author":"黄裳","text":"人随梦电几回见，剑逐云雷何处寻。\n惟有越山池尚在，夜来明月古犹今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈季甫","author":"黄裳","text":"閒于孤鹤淡于秋，纵落忙中亦自由。\n受道已知君有质，感人深处急回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓元孚 其一","author":"黄裳","text":"京尘随暑远，洛水得秋多。\n爽气乘归兴，孤舟看一梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓元孚 其二","author":"黄裳","text":"左选官期远，南归客路长。\n觐亲时正好，黄菊百年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓元孚 其三","author":"黄裳","text":"识先游刃易，命晚折腰劳。\n华省当年梦，行看置此曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中闻友人围棋","author":"黄裳","text":"瑞雪天时醉怨迟，笑君棋局雪中围。\n轩花汗漫丰年事，不是嫌春故故飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人见问久不作诗","author":"黄裳","text":"幽情寄态动风骚，大巧如春未奈何。\n莫怪近来诗句少，只嫌吟后客情多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李潜夫","author":"黄裳","text":"去去仙舟住处閒，吴王台下虎邱山。\n日边孤客遥相忆，聚散空悲梦往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶感","author":"黄裳","text":"泡影浮生梦幻身，十年南北寄红尘。\n穷通有命归与好，风月相期满剑津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"流沟山","author":"黄裳","text":"清见林泉意已开，知音曾有魏王来。\n两忘更得栖神地，不染人间一点埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟行感旧","author":"黄裳","text":"曾向兰陵起一舟，湖山佳处有朋游。\n歌声月下俄相失，秦与潇湘各自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次友人月夜楼上之韵","author":"黄裳","text":"满楼清景泻斯干，肝胆初醒世虑閒。\n谁见谪仙歌与舞，但留诗句落云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛南湖 其一","author":"黄裳","text":"菡萏香中画舫轻，新红相照亦多情。\n似迎学士来归院，花烛前头朵朵明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛南湖 其二","author":"黄裳","text":"雨过圆荷万点星，云开银汉眼前明。\n难逢此景休归去，更待天西片月生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人垂钓","author":"黄裳","text":"壮后幽情转更长，尘劳空忆芰荷乡。\n自由池上垂纶客，应是回头笑我忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成四绝书寄子坚道契 其一","author":"黄裳","text":"皆有前缘志自通，大云山下偶相逢。\n春来拿得龙双角，走下昆崙第一峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成四绝书寄子坚道契 其二","author":"黄裳","text":"相见参来道已通，五城曾拆紫芝封。\n自从龙虎归根后，花簇云攒白玉峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成四绝书寄子坚道契 其三","author":"黄裳","text":"袖中自有青龙剑，世上谁无白虎经。\n秘诀未尝留一字，不劳终日诵黄庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成四绝书寄子坚道契 其四","author":"黄裳","text":"尘中自适能无我，方外相知喜有君。\n静看古今搔首处，五湖风月万山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽辞 其一","author":"黄裳","text":"奔逸三王后，忧勤七闰间。\n生灵千载会，造化一朝閒。\n空致盘中露，应寻海上山。\n凤凰人恐到，不趁御龙还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽辞 其二","author":"黄裳","text":"一息捐朝野，春秋日正中。\n月明宫怨满，天远世缘空。\n勇智贻王业，文章绍帝风。\n生民瞻不及，终日向遗弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽辞 其三","author":"黄裳","text":"集英春又到，閒了万年觞。\n晓鼓催攒殿，悲风助挽郎。\n帝符归有道，仙仗去无方。\n谁念频回首，诸生泪两行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽辞 其四","author":"黄裳","text":"图治心方壮，追班世忽非。\n鼎中龙蜿蜿，陵上柏依依。\n物外音何悄，人间梦亦稀。\n少阳来侍宴，天意已知微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽辞 其五","author":"黄裳","text":"忽自明庭去，风高帝所寒。\n有期修玉检，无处觅仙丹。\n与子基图远，开天数度宽。\n锦标何以报，空展赐诗看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哲宗皇帝挽辞 其一","author":"黄裳","text":"忽追班入未央宫，急问宸游早御风。\n流俗岂知尘念断，故嫔休叹爱缘空。\n还元精爽留天下，复土声灵在虏中。\n来自武夷归去否，幔亭闻说好如嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哲宗皇帝挽辞 其二","author":"黄裳","text":"数行空下侍臣班，十六回春一梦阑。\n天意预形传国玺，人生难望返魂丹。\n银河寂寂星垣暗，金阙冥冥羽卫寒。\n月色满宫谁怅望，春来无处接回鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哲宗皇帝挽辞 其三","author":"黄裳","text":"何事骑龙不可攀，衣冠空自在人寰。\n诏遗夷夏秋容动，言付公卿玉几閒。\n能使抱弓号百姓，岂劳求药问三山。\n元符事业谁相似，两汉须看凤露间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈宪肃皇太后挽辞 其一","author":"黄裳","text":"懿范存遗诏，香尘守浣衣。\n中天扶日上，西邸引龙归。\n方慰人寰望，那知辇路非。\n仁恩和夜月，千古在慈闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈宪肃皇太后挽辞 其二","author":"黄裳","text":"相门阴德远，天妹俪周文。\n还政前期速，求贤内助勤。\n仙丹犹访道，金阙已乘云。\n紫极空回首，虞号惨日曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈宪肃皇太后挽辞 其三","author":"黄裳","text":"听断帘方捲，遗留事已传。\n继承知有后，建立许谁先。\n救弊趋中道，论功列上仙。\n九重空怨慕，霜露凤台前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈皇后挽辞 其一","author":"黄裳","text":"梦中怀日有谁知，莫恨真人下降迟。\n会合裕陵同祔处，因缘潜邸独飞时。\n九霄重引真仙仗，四海初传大母仪。\n怅望凤台山下去，东郊无计上金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈皇后挽辞 其二","author":"黄裳","text":"平日未沾天下养，芳春先弃域中游。\n昔从内令任思顺，今起东?舜解忧。\n衣在果闻成赭色，书存尤喜见银钩。\n懿围故事谁攀得，再幸仁皇御九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钦慈皇后挽辞 其三","author":"黄裳","text":"已传龙德与承休，果在丹台不可留。\n新册却埋千古玉，旧恩重起六宫秋。\n尊开围步松云远，荣到支陵雨露忧。\n三十六宫休说恨，谁知先作裕陵游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾鲁公挽辞","author":"黄裳","text":"曾侍前星在玉霄，兢为元老立清朝。\n重游西府羁群虏，危坐东台鉴庶僚。\n扰扰万缘留事业，悠悠千载想风标。\n传家已有蓬莱客，何患于门到寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":52825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]