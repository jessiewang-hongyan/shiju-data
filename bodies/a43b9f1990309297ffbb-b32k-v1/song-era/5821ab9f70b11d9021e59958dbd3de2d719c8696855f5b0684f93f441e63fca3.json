[{"title":"桔槔","author":"韦骧","text":"露井无穷惠，机心在桔槔。\n浅深皆应取，俯仰不为劳。\n固免羸瓶悔，全胜短绠操。\n如何翻鄙笑，抱瓮自孤高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投壶格","author":"韦骧","text":"古来壶矢乐，今日亦钧情。\n庆马谁亡法，论筹自有评。\n较能分胜负，按数计亏盈。\n好是摧机中，收功特地轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花铁书镇","author":"韦骧","text":"铁尺平如砥，银花贴软枝。\n成由巧匠手，持以镇书为。\n弹压全繄尔，推迁实在台。\n不能柔绕指，方册最相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雕狐图","author":"韦骧","text":"戢翼下云中，惊狐计遂穷。\n笔端传击搏，座上感英雄。\n猛势看如活，妖魂觉已空。\n推奸当若此，不独画为空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏影","author":"韦骧","text":"所赋一何钧，悠悠各一身。\n行藏宁逆物，进退本由人。\n向晦都忘累，逢明固任真。\n含沙尚能祸，辨早莫因循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏声","author":"韦骧","text":"寂寞曾非迹，能闻乃辨声。\n于人缘有感，在物本无情。\n涛怒中秋盛，雷威百里惊。\n更论空谷答，至理自相倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈后主","author":"韦骧","text":"绮阁宝为床，庭花曲韵长。\n三妃惑沈湎，十客助骄荒。\n不作强邻备，还罹独足殃。\n胡颜犹侍饮，更献请封章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方竹杖","author":"韦骧","text":"钧是龙孙种，怜方与众殊。\n既能同劲直，还自表廉隅。\n雨露恩虽一，风霜迹更孤。\n端人以为杖，气类雅相符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访隐","author":"韦骧","text":"暂出纷嚣外，相寻寂寞乡。\n扫门风竹影，扑座露花香。\n白玉为琴轸，丹砂贮药囊。\n疑年閒试问，甲子亦都忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏烟","author":"韦骧","text":"漠漠复霏霏，因风任所之。\n山家晨起后，渔舍晚归时。\n散远连云没，飘斜误鸟随。\n更堪萦旅思，怅望碧江湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探后园桃花二首 其一","author":"韦骧","text":"忆对残花邀客醉，留连花下惜芳辰。\n而今只待微红露，便向枝头觅旧春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探后园桃花二首 其二","author":"韦骧","text":"藉草开樽往兴深，摇花落盏十分斟。\n当时已有今年约，肯放花残负赏心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上桃","author":"韦骧","text":"数本临溪岸，春多色更夭。\n暗香穿水腻，细蕊入风娇。\n枝卧侵微草，红繁蔽小桥。\n武陵迷客路，与此不相辽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"多景楼","author":"韦骧","text":"尽道人间占胜游，天将多景遗斯楼。\n江山远顾穷千里，风月平分入两州。\n日日高明疑后夜，年年潇洒觉先秋。\n不知今古登临客，消却尘怀几斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕景纯以梅花盛开见寄","author":"韦骧","text":"晓寒虽在有春催，坐想庭梅烂漫开。\n滞迹方愁冰蕊过，清风还喜玉音来。\n传芳酷重裁云手，比美遥评傅粉腮。\n归见馀花须共醉，相宜况有水精杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和灯夕见寄","author":"韦骧","text":"瞥来海国未言旋，歘见新春换旧年。\n佳节阻陪千骑乐，元宵空想万灯燃。\n民声喧溢丰时岁，酒价飞腾要市廛。\n多谢高情不遐弃，清诗相寄宝珠圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春思五首 其一","author":"韦骧","text":"庭前弱柳黄金线，池畔新苔绿玉钱。\n可是燕鸿恋韶景，犹将健羽度晴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春思五首 其二","author":"韦骧","text":"香心夭艳尚包藏，蜂蝶优游苦未忙。\n何处纸鸢飞白昼，几家归燕认雕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春思五首 其三","author":"韦骧","text":"青烟拂拂扑晴晖，帘幕无风永日垂。\n不恨离人归不早，只疑春色故相欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春思五首 其四","author":"韦骧","text":"近来碧瓦减朝霜，春意垂垂满众芳。\n未睹花光照庭榭，且看草色绕池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春思五首 其五","author":"韦骧","text":"半惨半舒云外日，似无似有水边风。\n羁愁不为阳和减，只恐因春绿鬓空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游","author":"韦骧","text":"春游是处接纷华，寒食风光日欲斜。\n柳拂画桥嘶玉勒，草绵香陌度金车。\n云边蹴鞠声相远，花外鞦韆影半遮。\n莫羡少年多意思，随时行乐自无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归","author":"韦骧","text":"他乡蔽讼改新年，事竟归心顿释然。\n坐厌帘间窥昼景，行将马上看春天。\n无穷芳草含朝雾，几许初花倚暮烟。\n长陌风光应渐好，羁怀朝夕付金鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡仲远内翰出虢州刘龙图所寄诗因次其韵","author":"韦骧","text":"暂离翰苑出南州，匼匝金羁络马头。\n泉石清幽为己物，耕桑勤苦共民忧。\n笔驱滞事如飞电，语决尘缘似破沤。\n内閤旧交诗远寄，心期犹未许裴休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和仲远留题方锐长老方丈","author":"韦骧","text":"当知迷悟不相因，举手如何拂鉴尘。\n试问禅翁住方丈，近来多少晚参人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和仲远答锐长老二首 其一","author":"韦骧","text":"庭柏经霜色半黄，暂安禅室意阳阳。\n高怀洞见人间世，凫鹤纷纷自短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和仲远答锐长老二首 其二","author":"韦骧","text":"山前旌剑弄晴光，瞻谒裴回殿角香。\n却坐灵堂问禅伯，莫持迂论作金汤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周开祖赴阙引对","author":"韦骧","text":"君繇雁荡解官时，我亦琅邪受代归。\n邂逅故乡方道旧，逡巡行舸又成违。\n十年离合都如梦，千里冲蒙勿自欷。\n况是枫庭将奏课，好摅奇蕴动恩辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓温伯内翰九月七日约游北高峰","author":"韦骧","text":"幸奉清游入翠微，阴云漏日照旌旗。\n登高预整孟嘉帽，访古閒寻白傅诗。\n桂子正传飘岝峉，菊英先喜泛琉璃。\n公归留宿湖山暮，恐误郊关竹马儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用别韵再和","author":"韦骧","text":"岱岳参天十八盘，当年旌旆许追攀。\n兹游况近重阳节，何幸还陪一日閒。\n陟巘舍车登岌岌，爱泉持酒听潺潺。\n玉堂健笔成高咏，欲和临池恨思悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和温伯道旧见寄","author":"韦骧","text":"忆随星骑按胶东，屡说馀杭气象雄。\n今日共为乡里庆，看公双拥旆旌红。\n回环山水仙壶外，高下楼台画幅中。\n剩把豪篇传美概，免教清话又成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和九日有怀见寄","author":"韦骧","text":"九日风光不可辜，更堪潇洒在江隅。\n兴如蓝水真能适，诗比齐山亦自娱。\n莫向三秋悲齿发，须将一醉等贤愚。\n酒阑忽忆胶东路，跋马随轩望上都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政孙朝请过故里为五老之会","author":"韦骧","text":"荣参天上列星躔，閒向人间作地仙。\n故里相逢十华鬓，一时同会五高年。\n图传略过商山叟，齿序几齐洛宅贤。\n有子奉觞公最美，绣衣使者綵衣鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡巨源郎中挽词三首 其一","author":"韦骧","text":"官荣符列宿，政术妙专城。\n未尽平生蕴，俄从长夜行。\n坦情归浩荡，爽气入清明。\n独有南州俗，空传遗爱声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡巨源郎中挽词三首 其二","author":"韦骧","text":"语论常惊座，精神迥照人。\n中途多坎壈，久疾遂湮沦。\n彷佛朱轮改，裴回画翣新。\n秋风入哀挽，行路亦伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"胡巨源郎中挽词三首 其三","author":"韦骧","text":"汲守卧犹治，冯郎发半华。\n冥鸿方避弋，美玉已埋砂。\n露湿铭旌重，风随挽绋斜。\n九原无甚恨，嗣子善传家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上简陈成伯学士","author":"韦骧","text":"除书何日到宣城，水驿迢迢引旆旌。\n千里讴谣犹在耳，双溪风月岂忘情。\n行庖荐玉淮鱼美，坐席浮香楚醴清。\n何幸旧游衰晚者，得随舟尾共修程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答所和","author":"韦骧","text":"苍茫云水度淮城，樯影联联注羽旌。\n汴泗幸随行舸末，潇湘况重故人情。\n晨征共济襟怀豁，夜泊交谈气味清。\n应有高篇思宛句，可无美酎继乌程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和见寄","author":"韦骧","text":"公到蓬瀛十五春，我犹碌碌似轻身。\n自忻今日旌轩遇，却忆当年研席亲。\n高论耸听多皦皦，孤衷懒叙且循循。\n试将辈学樽前数，白发相逢有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丹阳守许仲途朝议春深饮会即席二首 其一","author":"韦骧","text":"宝炉香穗战春寒，四座融怡极日欢。\n且乐杯觞随水曲，莫愁烟雨满江干。\n首题诗句争传咏，欲插花枝更细看。\n众客为公须一醉，何妨倒著接䍦冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和丹阳守许仲途朝议春深饮会即席二首 其二","author":"韦骧","text":"疑怪和风却暮寒，华堂宾主正酣欢。\n人间高会真难偶，身外浮名岂足干。\n绿蚁泛杯春可吸，红英近烛夜宜看。\n梁尘莫逐歌声转，只恐纷纷扑醉冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝酒","author":"韦骧","text":"二月已破三月来，青春白日映楼台。\n劝君更饮一杯酒，一月人生笑几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离丹阳","author":"韦骧","text":"人从北固山前去，云水苍茫日向西。\n今夜渡江何处宿，杨花落尽子规啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜花","author":"韦骧","text":"东风吹园杂花开，不忍虚掷委黄埃。\n且来相就饮一斗，渐老逢春能几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈成伯小饮","author":"韦骧","text":"布素平生友，如公乃达人。\n相逢临远水，累岁望清尘。\n万语难穷意，三杯且混真。\n鹏鹪各飞举，同是未归身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"韦骧","text":"百丈卷河滨，相欢席上人。\n香飘清近水，歌动净无尘。\n良会诚难必，开怀好任真。\n心期在他日，湖海共閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和陈成伯见寄集句三首","author":"韦骧","text":"两篇藻思敌青春，开拨尘昏向此身。\n道旧悠悠言易感，论心炯炯谊还亲。\n光阴似毂何难转，事物如环且谩循。\n白雪调高知寡和，强歌徒愧郢中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次柳子小饮呈成伯学士","author":"韦骧","text":"久客无佳思，长途有戒心。\n系舟偕择地，击柝互传音。\n西月光犹浅，南薰候已深。\n一樽虽冷落，所幸不孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石懿老大夫生日","author":"韦骧","text":"万石风流盛，中秋气序清。\n门弧当日庆，寿盏此时盈。\n庭下芝兰茂，腰间印绶荣。\n况高颐养术，龟鹤得长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别张枢言龙图二首 其一","author":"韦骧","text":"夔皋事业久声华，尚郁谋猷世所嗟。\n专阃收功全整暇，偃藩从请示优嘉。\n高谈耸服三千客，和气融怡十万家。\n不日九天飞诏下，行看騕袅蹴堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别张枢言龙图二首 其二","author":"韦骧","text":"政成西蜀肆高怀，乞得东吴盛府开。\n千里惨舒都在手，百城趋禀孰为才。\n恩宽疲瘵精神健，威慑奸憸胆气摧。\n下客拳拳唯慕谊，欲违旌戟更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈公武中散生日","author":"韦骧","text":"身作名卿早挂冠，饮冰清节久坚完。\n门弧远想当年庆，寿盏宜深此日欢。\n簪绂诜诜侍佳宴，弦匏苒苒战轻寒。\n葭莩敢以诗为献，唯祝公如卫武安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过金陵上仆射王舒公","author":"韦骧","text":"天眷皇图盛，真儒德性高。\n文章追孔孟，事业过伊皋。\n难进轻三币，功收变一陶。\n斗枢符斡运，主柄赞持操。\n万务繇吾揆，千龄庆所遭。\n邦财理丰本，民力较秋毫。\n惠遍农无乏，输均役不骚。\n保兵知警守，禄吏绝贪饕。\n信令朝廷重，伸威塞境牢。\n深谋压夷狄，侵地复岷洮。\n万里耕桑富，中原气象豪。\n河淤开亿顷，海贡集千艘。\n著义尊经典，更科待隽髦。\n养材从引类，设学派纷袍。\n试士先三尺，传师或六韬。\n进贤轻似汲，去弊勇如薅。\n化俗迁狙诈，乘时等凤翱。\n赤心全皦皦，鄙议过滔滔。\n表正销群靡，言深决众謟。\n郭崔奢自减，杨墨谬皆逃。\n勋烈轻铭鼎，光华外奏骜。\n台阶回远趾，仙观乞閒曹。\n异宠藏珍带，优恩避节旄。\n钟山归旧隐，槐府辍先劳。\n不宰经纶效，潜忘简策褒。\n烟云供啸咏，风月相游遨。\n古寺唯轻屣，秋溪只小舠。\n羹调梅敛实，旱救雨收膏。\n寰宇恬安枕，衣冠赋执翿。\n何时传入觐，群望慰嗷嗷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送范子镇承议同年宰清源","author":"韦骧","text":"愿君安虑宰清源，已雪南闽大狱冤。\n勿叹割鸡犹屈刃，当知容驷可高门。\n解舟兰水春沙浅，税鞅榆关夏木繁。\n所得最多公谊在，他年富贵岂须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书张侍郎生日","author":"韦骧","text":"薰风初泛舜弦声，崧岳储精王佐生。\n巨室当时庆弧矢，熙朝今日赞机衡。\n燕堂荣映台躔近，寿盏光浮昼景清。\n愿祝修龄如卫武，长挥相笔化隆平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迁居近局谢陈成伯假车惠茶","author":"韦骧","text":"冷官远室足间关，疲马羸兵倦往还。\n局左卜居甘迫窄，城东寓迹谢宽閒。\n短辕助载方衔惠，灵荈蠲烦愈厚颜。\n两腋风生家事少，并吟惭匪昔贤班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和答篇","author":"韦骧","text":"为困奔驰乃近迁，勿咍飞倦不知还。\n趁朝遂免三更起，归舍新添数刻閒。\n谩致鄙篇酬雅贶，却烦秀句解衰颜。\n高轩若许来惊座，陋室杯盘亦可班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和来篇","author":"韦骧","text":"已愧苍葭倚玉难，更惭投砾引珠还。\n卢生破屋居新稳，韩子豪篇语自閒。\n虽有清樽伫高躅，须期黄菊奉朱颜。\n自惟雅集犹淹缓，诗战雄师未必班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵达夫元夕礼闱锁宿","author":"韦骧","text":"元宵锁宿礼闱清，春意寒威两战争。\n月照楼台疑昼景，风传车马讶雷声。\n蹉跎自愧青云志，勤苦须怜皓首生。\n勿叹拘挛度良夕，共开精鉴选经明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杨久中将试进士","author":"韦骧","text":"双扉尽日关，旧观恍然还。\n进士将纷集，经生且暂閒。\n较材归俊杰，兀坐属疏顽。\n远想驹空谷，移文愧北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和锁宿即事","author":"韦骧","text":"金门拜敕望严宸，禁陌联镳傍早春。\n此日贡闱身亦与，昔年文阵意如新。\n为僚况偶群英集，投隙何妨雅论频。\n共念残科多滞士，归期缓指甲申旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示黄彦发欧阳勉甫道旧","author":"韦骧","text":"浮世难逢故旧并，贡闱风月可忘情。\n当年论事皆陈迹，此日评文亦浪名。\n荏苒光阴踰一纪，间关志气话平生。\n且将觞咏消閒隙，鹏鴳逍遥理自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和久中闻笛","author":"韦骧","text":"风摇古木影萧森，何处飘来暮笛音。\n杳杳迥如天上曲，悠悠不减陇头吟。\n未逢明月心犹恨，却忆残梅兴亦深。\n幽思萦回长不断，欲量应及数千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和达夫雪霁","author":"韦骧","text":"雪馀著处是琼瑶，惜向春风势易消。\n野色澄明经一洗，鸟声喧滑自相招。\n润通弱柳晴林媚，清逼归鸿云路遥。\n浩荡幽怀吟不尽，高楼斜日望寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈吴伯固同年","author":"韦骧","text":"白玉墀前共得仙，而今邂逅半华颠。\n评文我辨异同字，由义君持难易权。\n畏简不能成共酌，纾情莫惜寄新篇。\n上林春晚归鞭动，意思何如癸巳年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次前韵答所和诗","author":"韦骧","text":"裁句清如李谪仙，挥毫放浪近张颠。\n偶于贡部同官责，更向诗坛擅将权。\n戏笔谩追丹桂旧，报言还愧木瓜篇。\n一樽何处偕吟啸，浩兴犹堪逐少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]