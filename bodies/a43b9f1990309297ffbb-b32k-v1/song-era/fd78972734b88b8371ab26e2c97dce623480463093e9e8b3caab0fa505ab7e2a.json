[{"title":"忆后城览秀亭登望","author":"韦骧","text":"村落园林有几家，隔墙遥出拒霜花。\n自怜马上看秋色，不似城头览物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过查林","author":"韦骧","text":"路向山腰转，云从陇首飞。\n晓天初衣裌，村驿罕乘肥。\n览物惊秋老，论心悟境非。\n归期且宽计，雨雪或霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落日","author":"韦骧","text":"郊原爽气入衣巾，佳趣源源立马频。\n落日山川无限思，秋风江海未閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阐阳驿观中秋月","author":"韦骧","text":"却扫阴云藉晚风，十分圆月挂天东。\n中秋此夜光华盛，万国钧情喜玩同。\n何处楼台恨偏照，几家樽俎对寒空。\n自怜独宿荒山驿，浩兴长歌未易穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其一","author":"韦骧","text":"秋高征袂怯西风，寂寞邮亭倍旅悰。\n独有无心清夜月，更深山里也相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其二","author":"韦骧","text":"山馆萧条冷似冰，黄昏四壁但蛩声。\n无端更恶飞萤点，强起前檐斗月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其三","author":"韦骧","text":"归期尚远路程赊，已觉秋林菊渐花。\n莫怪临风多北望，琅邪山外寄吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其四","author":"韦骧","text":"求官穷僻本藏头，远冒风霜不自由。\n岂是有才如硕鼠，可能无术似蜗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其五","author":"韦骧","text":"纷纷贵贱别锱铢，义命由来共取诸。\n推己及人人所慕，不然何以称襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿坛石驿六首 其六","author":"韦骧","text":"独贤安敢辄咨嗟，靡盬当如载旧诗。\n回辔未堪期早晚，望云终日起亲思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"想庐山三首 其一","author":"韦骧","text":"昔年曾遇九江秋，引睇庐山不及游。\n行役今朝垂欲到，无端牵制又回辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"想庐山三首 其二","author":"韦骧","text":"访水寻山好已迂，胜游难必果何如。\n二林咫尺还淹兴，空读匡庐易览书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"想庐山三首 其三","author":"韦骧","text":"走遍江南二十州，庐山未到谩悠悠。\n故知尘事相邀阻，唯想他年取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"适江表","author":"韦骧","text":"水落山高古渡幽，马蹄轻健蹴溪流。\n朝行暮止三千里，叙旧逢新一十州。\n倦听乱蝉催落日，喜看黄菊助残秋。\n不才于世无禆补，强就奔驰祗自羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋十八夜雨望月阻兴","author":"韦骧","text":"赏过中秋才两夕，人心独待月华多。\n也知不惜饶光照，争奈閒云好事何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饶守游晋老席上偶成","author":"韦骧","text":"西风吹叶影悠悠，行役江城旅思收。\n名慕荆州欣一见，道经鄱水爱三秋。\n芙蓉欲蕊斜阳转，鸿雁初飞爽气浮。\n不用樽前苦相劝，斗筲唯恨怯觥筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答和篇","author":"韦骧","text":"落日山川晚鼓休，西风楼阁远烟收。\n清谈亹亹忘尘役，醁酒深深战暮秋。\n独恨去当霜草路，不能留见菊花浮。\n更惭健句酬衰唱，刻烛甘输第一筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和答并叙别","author":"韦骧","text":"风骞绣额炉香转，江照金樽宿霭收。\n尘客轻装渡寒水，主人佳句压清秋。\n自忘远驭瘏兼病，岂顾閒书沈与浮。\n回首高城空企望，驰情无算不堪筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龟峰 其一","author":"韦骧","text":"偶向尘劳得胜游，纵观三十六峰秋。\n巢云负月几千岁，欲问神龟不转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龟峰 其二","author":"韦骧","text":"龟凤猿鳌各定名，峰峰峭怪倚青冥。\n也知造物无情甚，凝结如何特肖形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别铅山杨公济","author":"韦骧","text":"征尘淟涊暮秋时，税鞅登堂暗浣衣。\n久别自怜心郁郁，相逢今喜语霏霏。\n池中尽谓蛟难畜，塞上行看马自归。\n落日西风满襟袖，临岐回首重瞻依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行赴云门驿","author":"韦骧","text":"石径踏羊肠，朦胧晓日光。\n久行情易厌，少事兴还长。\n林表霜枫赤，山根露菊黄。\n从来清冷趣，今日倍阳阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢简夫太博惠茶","author":"韦骧","text":"越岭掇春英，淮城惠不轻。\n一杯分爽气，千里想高情。\n啜与幽人共，烹宜庶子清。\n挥毫答珍贶，还愧玉川名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海陵按事","author":"韦骧","text":"小城幽趣远，海国暮寒多。\n委琐从谁遣，拘挛祗自诃。\n庭虚哀度雁，巷阒绝鸣珂。\n案牍萦仍外，陈编亦可磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其一 琅邪山门","author":"韦骧","text":"双鹤栖华表，仙山自此通。\n云霞自扃锁，尘土若为攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二 长松径","author":"韦骧","text":"十里开幽径，松阴互蔽亏。\n山翁心亦侈，步幛用青丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其三 净镜亭","author":"韦骧","text":"路转翚檐出，山回秀气多。\n亭名不须看，对镜已如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其四 翠微亭","author":"韦骧","text":"谢屐低前齿，登临势渐雄。\n岚光动衣袂，知在翠微中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其五 白云亭","author":"韦骧","text":"路作两岐分，亭多聚白云。\n无心本无恋，于此尚纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其六 醉翁亭","author":"韦骧","text":"醉翁虽已没，遗构在山阿。\n不比陶潜石，清时乐自多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其七 薛老桥","author":"韦骧","text":"流泉渟处阔，跨石石桥横。\n题柱无踪迹，茫然薛老名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其八 逊泉","author":"韦骧","text":"两窦涓涓泻，无何后却前。\n谁能来酌饮，回意学相先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其九 班春亭","author":"韦骧","text":"云木气氤氲，风光日日新。\n丰谣随五马，来此听班春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十 石流渠","author":"韦骧","text":"凿渠疏白石，绕槛走清泉。\n不为流觞醉，来当涤万缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十一 琅邪山","author":"韦骧","text":"晋王曾此隐，释子住何年。\n泉石无今古，图经有后先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十二 回马岭","author":"韦骧","text":"有意寻幽胜，跻攀固所怀。\n如今岭路稳，鞍马不须回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十三 开化寺","author":"韦骧","text":"架巘及依崖，轩窗次第开。\n等为方外客，于此更清怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十四 御书阁","author":"韦骧","text":"岌岌淩霄汉，风传宝阁香。\n三朝神翰在，奎壁夜交光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十五 阳冰篆","author":"韦骧","text":"笔力真奇伟，磨崖几百年。\n勿嫌人贵耳，此学世无传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十六 庶子泉","author":"韦骧","text":"宫相湮沦久，兹泉日夜生。\n泉存人不见，空复著虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十七 白龙泉","author":"韦骧","text":"殿角滀泓澄，源高登地灵。\n老僧来洗钵，不畏白龙腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十八 酴醾轩","author":"韦骧","text":"诘曲小轩斜，酴醾一架遮。\n春风零落后，浑似雨天花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其十九 寂乐亭","author":"韦骧","text":"踏石穿林去，披云就坐来。\n禅翁寂乐地，猿鸟肯相猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十 招隐堂","author":"韦骧","text":"小蹊回石角，缔构倚山腰。\n一片幽栖地，谁令便可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十一 归云洞","author":"韦骧","text":"石洞何年有，名传事或非。\n那知为雨后，却向此中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十二 清风亭","author":"韦骧","text":"松竹繁阴满，峰峦秀色并。\n暑风从此度，别是一般清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十三 大历井","author":"韦骧","text":"竹里藏深井，栏镌大历春。\n不知开凿后，几过鍊丹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十四 千佛塔","author":"韦骧","text":"砻石施丹雘，凌云势亦孤。\n如何千种相，并在一浮图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十五 石庵","author":"韦骧","text":"不独烟霞窟，天然石作庵。\n坐禅遗迹在，岩溜自香甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十六 晓光亭","author":"韦骧","text":"东面双峰缺，遐瞻万里平。\n朝朝沧海日，先向此中明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十七 了了堂","author":"韦骧","text":"了了还未了，都忘了始真。\n登堂知此意，方悟死前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十八 望日台","author":"韦骧","text":"曾有长安客，题为望日台。\n樵苏人不测，到此亦裴回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其二十九 石屏风","author":"韦骧","text":"造化非无意，都如图画中。\n犹嫌未奇怪，更出石屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其三十 会峰亭","author":"韦骧","text":"胜概当冲要，回环拥翠峦。\n烟云藏不得，如在掌中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其三十一 法华池","author":"韦骧","text":"会峰亭下路，斜带法华池。\n不待观池水，尘迷已顿离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅邪三十二咏 其三十二 东峰亭","author":"韦骧","text":"山中时节早，地势近春华。\n岁岁东风至，先看傍砌花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客舍早春","author":"韦骧","text":"早春晴霭乍悠悠，客舍深沈物趣幽。\n日薄草头初破甲，风旋鸟毳偶成毬。\n庭柯憔悴红犹远，池水澄明渌渐浮。\n隐吏近来多鞅掌，纾怀何处一登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栩栩亭","author":"韦骧","text":"碧崖高处筑遗基，缔构岧然得所依。\n境趣似仙探绝迹，登临如梦悟轻飞。\n路穿幽谷云霞密，势接丰山草木稀。\n欲识主公题榜意，不容纷扰累忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偃盖松","author":"韦骧","text":"摧折风霜久，犹传偃盖松。\n只凭文笔力，何必大夫封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓","author":"韦骧","text":"百舌穿林语未完，悠悠归梦忽惊残。\n心知庭外春霜重，裘压单衾觉晓寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海陵逢春","author":"韦骧","text":"海角春初至，林樊气未和。\n天寒梅发晚，沙近雁飞多。\n窗纸疏明玉，帘旌荡翠波。\n旅怀随日长，索莫不胜歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感兴","author":"韦骧","text":"富贵功名岂足邀，鹪鹏所得各逍遥。\n古今多少难齐事，烛理都如见睍消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观飞雁偶十有三","author":"韦骧","text":"肃羽度春晴，差肩足弟兄。\n何时别燕塞，此日类秦筝。\n应律声犹剩，排空字宛成。\n冥冥奚所滞，惆怅弋人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆梅二首 其一","author":"韦骧","text":"去年幽谷探寒梅，把酒曾将累句催。\n不意今年行海角，玉英开尽未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆梅二首 其二","author":"韦骧","text":"向来踏雪旧枝旁，指日相期折素香。\n可是去春吟太苦，闇招离别间清狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近元夕怀景纯少卿","author":"韦骧","text":"忆逐双旌下暮城，岁华垂尽魄哉生。\n瞬眸已见元宵月，归步犹淹累日程。\n远想笙箫同众乐，坐怜刀笔久相婴。\n驰情只有清辉共，更走诗筒代寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花","author":"韦骧","text":"烨烨银檠上，开荣歘尔新。\n芳心唯报喜，艳色不关春。\n翠幕障风稳，兰膏借润频。\n屡占皆取验，始信有花神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水精笔架","author":"韦骧","text":"璞琢穷工巧，书帷适用高。\n得邻辉宝墨，栖迹卧文毫。\n匪月光长在，非冰暑自逃。\n千金不论直，一字若为褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自宝丰镇移红蕉于永阳后圃","author":"韦骧","text":"为爱红蕉品格殊，移根千里涉崎岖。\n不知今岁秋阳里，能有丹心似旧无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风琴","author":"韦骧","text":"穴竹张弦耸碧空，不劳抑按任天风。\n莫誇有智藏声足，须信无心触处通。\n明月夜深飘更远，閒窗人静听何穷。\n知音弗辨山兼水，都在洪钧一噫中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁屏","author":"韦骧","text":"羽翮本云程，丹青入小屏。\n长年离远塞，尽日啄寒汀。\n暮角无惊势，春风悄去翎。\n几回疑繫帛，旅枕梦初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒","author":"韦骧","text":"檐霜重如雪，池水冷于冰。\n鸟舌生根涩，花心起怨憎。\n旅人尤倍觉，年少尚难胜。\n欲作新春饮，高楼未可登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"韦骧","text":"云霭结青冥，成阴重复轻。\n虽知养春色，终是惨人情。\n索莫初花态，踌躇去雁声。\n芳时不宜忽，紫陌待暄晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏马","author":"韦骧","text":"种格得房精，权奇岂易名。\n耳批秋竹薄，蹄蹴水云轻。\n徒受双羁制，谁知千里程。\n未为良乐遇，春陌自长鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏素扇","author":"韦骧","text":"不羡裁纨妙，唯怜入手轻。\n月从天上落，风向座中生。\n却暑期宣力，经秋任寡情。\n人心能似此，及物岂无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"火箸","author":"韦骧","text":"劲直不容偏，纤纤体并圆。\n附炎非曲致，执热藉双全。\n炽炭随方减，寒灰应手然。\n洪炉在调适，持此以为权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]