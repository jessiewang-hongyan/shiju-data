[{"title":"中秋西桥饮酒和卢申之韵","author":"赵肃远","text":"翠蘋风起落残红，秋月正圆秋气中。\n但怪肩吾轮桂长，未容文举酒樽空。\n帆归南浦潮回北，人散西桥斗转东。\n乌鹊高飞惊远目，误疑天际有来鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪寺用张令韵","author":"赵肃远","text":"重来寻野兴，淡月半松林。\n一寺俨如昨，双溪清到今。\n乱馀僧改貌，秋老客惊心。\n自觉身如寄，山林滋味深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬夜偕徐敬室自白石归","author":"赵肃远","text":"落叶溪边卸小舠，似游赤壁步临皋。\n溪声忽静霜将下，山意生寒月正高。\n举世梦酣庄氏蝶，此时心在屈平骚。\n梅花雅有幽期旧，特地吹香满客袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"赵肃远","text":"露滴甘泉事已休，欲穷多景漫登楼。\n云收北固千帆雨，雁带南淮万里秋。\n夜色和愁迷古渡，天风吹恨到神州。\n青山尚在英雄老，休说兴亡忆旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赤松观","author":"赵肃远","text":"入门苍翠合，地暖不知冬。\n羊化屋头石，鹤归山下松。\n溪清云影动，碑老藓痕封。\n帝者师何在，清游未许从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳王坟","author":"赵肃远","text":"来吊英雄骨尚香，一抔黄土当封疆。\n自从驻跸来吴会，谁更提兵入洛阳。\n殡阁有灯秋树暗，隧碑无字雨苔荒。\n寒鸦不识当时事，犹恋栖霞噪晓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程钜夫惠茶","author":"赵若恢","text":"卧病文园日正长，斜题远寄雨前枪。\n黄绫不羡龙团贵，紫笋还闻雀舌香。\n一砚落花人醉醒，半帘飞絮燕归忙。\n新泉活火松风细，何处黄州白玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西溪湖散步","author":"赵若盈","text":"远岫平林嶂夕阳，翻涛翠麦已蒸黄。\n此行莫谓无高兴，题品新诗入锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大泉洞","author":"赵若渚","text":"通羊几岩壑，兹洞如修航。\n泉声轰鼓激，涧气侵衣凉。\n临流网银鲫，舣棹觞桂浆。\n此中有真趣，其乐良未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"径山玉芝庵主源上人持痴绝老人语录求作行状留连踰月谈论铿锵音吐鸿畅众中之龙象也临别书二绝赠行 其一","author":"赵若琚","text":"暑入单絺雨压尘，扣门仍喜客来频。\n从容为说西来意，庭柏青青正可人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石鼓铺","author":"赵若槸","text":"山前山后杜鹃花，庄上黄鹂识谢家。\n欲问青帘溪上酒，行逢白发道边茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其二","author":"赵若槸","text":"可意黄鹂唤得醒，日移山影正当庭。\n飞花忽趁春风过，点破苔痕一片青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武夷茶","author":"赵若槸","text":"石乳沾馀润，云根石髓流。\n玉瓯浮动处，神入洞天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春词","author":"赵若槸","text":"玉钗香梦水东流，帘怯春寒寄暮钩。\n燕子不来花满地，一痕新月又西楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暮春","author":"赵若槸","text":"香透蜂房蝶梦残，一帘新雨又春阑。\n柳腰瘦得难禁舞，今夜春风莫更寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遇樵川林时中","author":"赵若槸","text":"建水樵川隔几重，相逢孰意大江东。\n客行芳草垂杨外，春在柔桑小麦中。\n细雨疏田流水碧，残霞拥树远林红。\n浮生聚散浑无定，有酒何妨一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事 其一","author":"赵若槸","text":"云散春山出，人闲白昼长。\n禽声答空谷，树影画斜阳。\n种果期秋实，浇花趁晚凉。\n行藏天已定，随分且徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绝句","author":"赵范","text":"半窗图画梅花月，一枕波涛松树风。\n不是客愁眠不得，此山诗在此香中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄萍乡密老","author":"赵鸣铎","text":"匹马飘然似转蓬，一年两度过湘东。\n襟间润带黄梅雨，枕上凉生苦楝风。\n亟亟穷途将底用，区区苟禄有何功。\n输他燕坐长厅老，默对浓香丈室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过越","author":"赵咨","text":"地有千岩与万津，霸图无计老青春。\n抱冰漫刷栖山耻，争奈倾吴是归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴下同年会诗","author":"赵彦卫","text":"雁塔寻盟信不违，二星联璧世间稀。\n高情念旧何其厚，□客亲仁得所依。\n节操刚方范孟博，□□酝藉谢玄晖。\n沙堤已筑催归骑，怪底朝来喜鹊飞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题兰亭帖","author":"赵彦卫","text":"生涯寄箪瓢，嗜古成传癖。\n胸蟠万卷书，禊帖究所出。\n三百七十五，异论溢编帙。\n更相自戈矛，又类相形色。\n我昔识诸老，高论聆侍侧。\n玉笔贵藏锋，真赝拚金锡。\n精神苟不具，徒尔致研席。\n搜访诸贤语，编类置丈室。\n使我心豁然，登山如得屐。\n妄意于斯文，庶可益涓滴。\n作诗谢来贶，持寄俟他日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽崔舍人 其一","author":"赵彦中","text":"直上青霄早，秋翎插健雕。\n心源九云梦，笔阵几嫖姚。\n视草含英凤，封章落贵貂。\n身前茂陵稿，及谒汉皇朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽崔舍人 其二","author":"赵彦中","text":"仙院分宵直，书庭接翼翔。\n情忘海夫臭，语借令君香。\n壮发犹藏葆，生刍已奠觞。\n修文平日事，地下亦为郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挈家来游饫山林之美款泉石之胜引睇莆阳扁画因慨思关河鼎沸版图之归无期当有任其咎者","author":"赵彦呐","text":"吏馀得得叩仙扃，萧散还吾自在身。\n到耳鸣蝉□更静，傍檐飞鸟亦相亲。\n层岩障日崖根险，危柱擎空□色新。\n应念中州方热恼，愿分清泚药斯民。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行松江闻鸡鸣犬吠","author":"赵彦肃","text":"循缘多熟境，溺法无要津。\n虑心屏百虑，犹是隔几尘。\n云边察飞翼，水底观跃鳞。\n闷杀鲁中叟，笑倒濠上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同友人访石室","author":"赵彦钮","text":"怪石嵯峨势若擎，天成斗室一蓬瀛。\n扫门常得风为帚，照夜从教月作灯。\n三伏人于冰上立，四时鸟在洞中鸣。\n来兹欲避人间世，啸傲烟霞豁性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潢河","author":"赵彦珖","text":"潢河绕出郡城楼，楼枕潢南城上头。\n天阔星连翼轸分，地长川带汉江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏台同年会次袁说友韵","author":"赵彦真","text":"杏园名胜与春违，落落晨星入望稀。\n百里我方欣际遇，二天公正许冯依。\n绣衣俱近云霄路，绮席聊分山水晖。\n已幸光华参末至，凤池行且看双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠蛟亭和巩栗斋韵","author":"赵彦假","text":"天下名洞天，有山必有水。\n馀杭山水窟，神仙所栖止。\n仙人乘云去，玉蛟留潭底。\n至今雷雨夕，蛟睡时惊起。\n爪劈岩石裂，石罅滴乳髓。\n涓涓泉流出，半垂白凤尾。\n风来琴筑响，月照缨络侈。\n曲折纳深池，彻底清且泚。\n筑亭当涧冲，木石相表里。\n翠壁润含烟，层峰去天咫。\n道人幻出奇，指顾犹未已。\n忽驱蛟走斗，瞬息八百里。\n怒气挟奔霆，草木为披靡。\n儿童惊震掉，面若槁灰死。\n达人本大观，谈笑自隐几。\n须臾群动息，静坐穷物理。\n水石本无心，相激一至此。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵彦彬","text":"自爱槛前山有意，谁云堂下水污人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵彦彬","text":"俸薄俭常足，官卑清自尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"赵彦逾","text":"春到皇都，日边已觉风光丽。\n异人名世。\n独禀阳和粹。\n福寿川增，行庆鸳行缀。\n笙歌重。\n几多珠翠。\n拚取今宵醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登般若台","author":"赵彦龄","text":"拨置文书强作閒，佩壶聊得共跻攀。\n归云不识游人意，遮尽江南一带山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题巾山","author":"赵彦龄","text":"一夜空山闻杜鹃，落花流水两茫然。\n凭栏不觉春归去，目极平芜绿际天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南峰精舍蓝光轩","author":"赵彦龄","text":"一溪带郭静潺湲，寺在溪旁碧岫巅。\n塔影远连空翠坞，钟声高入蔚蓝天。\n竹房僧定侵窗月，沙步人稀满树烟。\n刚被名缰挽归去，久居应作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴下同年会诗","author":"赵彦瑷","text":"引睇龙门念久违，自题雁塔会何稀。\n奔驰莲幕祇甘分，只尺星台喜有依。\n拱侍尊罍陪盛事，仰瞻刑政焕清晖。\n我公自有回天力，入佐明君看一飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇太子 其七","author":"赵彦端","text":"少阳拜赐少阳旁，黄菊红茱满寿觞。\n阳德重重在初四，不须九日是重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇太子 其三","author":"赵彦端","text":"明河楂上有仙翁，犯月撞星列碧穹。\n金阙东边银榜处，大书天地长男宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇太子 其三","author":"赵彦端","text":"光尧初御六龙天，上直参维大火躔。\n天意分明昌宋德，诞辰王世总丁年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿皇太子 其二","author":"赵彦端","text":"子晋吹笙未是仙，阿丕横槊少全篇。\n小吟青著梅梢句，一日东风四海传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰 其一","author":"杨万里","text":"日日龙楼问寝时，鸡人未动漏花迟。\n前星一点朝天帝，只有清台太史知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹","author":"赵彦端","text":"沉香亭北无消息，魏国姚家亦寂寥。\n不见君王殿中见，溪园堂下雨潇潇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其八","author":"赵彦端","text":"岂是栽松待茯苓，且图山色镇长青。\n他年行脚不归去，留与人间作画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其六","author":"赵彦端","text":"茆檐静坐千山月，竹户閒栖一片云。\n莫送往来名利客，阶前踏破绿苔纹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其五","author":"赵彦端","text":"一池荷叶衣无尽，数树松花食有馀。\n却被世人知住处，更移茆舍作深居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其三","author":"赵彦端","text":"老老山僧不下阶，双眉恰似雪分开。\n世人若问枯松树，我作沙弥亲见栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其二","author":"赵彦端","text":"临溪草草结茆堂，静坐安然一炷香。\n不是息心除妄想，都缘无事可思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠微山居八首 其一","author":"赵彦端","text":"閒来石上卧长松，百衲袈裟破又缝。\n今日不愁明日饭，生涯只在钵盂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉真台","author":"赵彦端","text":"春色无穷巷，农乡有太和。\n病嗟闻道晚，贫喜得闲多。\n草径供徐步，邻花获屡过。\n层台宜抗榭，谁与买烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑逢辰直阁迁新居 其二","author":"赵彦端","text":"生当带索守林庐，不合轻抛种树书。\n贺燕得公真是乐，弊貂将我竟何如。\n殊乡更觉邻为贵，晚岁深期烛有馀。\n上下床閒相去几，未知梦觉孰非欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张守 其一","author":"赵彦端","text":"堂堂天上张公子，龙剑分光自斗牛。\n海上忽归槎万里，云间未放月中秋。\n才为汉殿无双手，恩到闽山第一州。\n亦有人言识仙骨，只看何日议封留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张守 其二","author":"赵彦端","text":"鹓班新谒紫宸回，鱼佩初迎幕府开。\n百里故乡同昼锦，一年和气自春台。\n甘棠政美无留颂，泮水功成有异才。\n他日听传公不老，定知曾见武夷来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺皇孙平阳郡王十月十九日生辰","author":"杨万里","text":"前星炳焕领孙星，环拱中天日两轮。\n四叶重光同圣世，千秋佳节近生辰。\n本支秀茂旦复旦，典学熙明新又新。\n喜入威颜天一笑，寿觞分赐一枝椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昆山吕正之三男子连中神童科盖奇事也建康严别驾为之赋诗某因次其韵","author":"赵彦端","text":"畴昔从公杖屦閒，风乎嬉舞水云閒。\n千言自我一闻悟，十驾从渠九折艰。\n蚤岁道山应遍住，他年画戟许谁攀。\n何词可赠张童子，莫忘杨公阳翟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇安道中","author":"赵彦端","text":"风柳疏无力，秋花冷不香。\n客请随去燕，凉思起啼螀。\n地入闽山隘，天连越树长。\n年年捣衣石，为尔感征裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西隐","author":"赵彦端","text":"西风数客一阑干，秋色翛然得细看。\n潦水倍知寒事早，夕阳更觉晚山宽。\n小留待月钟无遽，半醉题诗烛未残。\n忆得向来幽独处，黄精未熟客衣单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与诸公会饮昆山放生池亭","author":"赵彦端","text":"初疑山遥遥，不知日车永。\n杖藜起衰病，适此氛翳屏。\n北山喜觌面，倒屣客不领。\n欢然呼断桥，快扫风柳影。\n扁舟载幽具，二面纳倒景。\n荷香已坐足，不待花破颖。\n潜鱼出银刀，盈月上金饼。\n琴间得新弄，棋醉有新警。\n长笛者谁欤，喧静同一境。\n行歌带亦适，还坐烛初耿。\n吾曹困重阴，湿处混蛙黾。\n忽逢天宇宽，况此星斗冷。\n酒为河朔倾，大胜汲寒井。\n诗成西园句，浩若转脩绠。\n君看万象色，回首森已暝。\n吾欢岂异兹，瓶罄勿三请。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵郑逢辰直阁迁新居 其一","author":"赵彦端","text":"早向承明倦直庐，萧然林下十年书。\n便名盘谷虽恶可，閒赋斜川岂不如。\n山拥北窗凉雨后，月生南浦夜潮馀。\n江湖必有从公者，风际挐音傥是欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观送迎有感","author":"赵彦端","text":"来车去马何纷纶，城西三日吹沙尘。\n道旁鹤立乱青紫，千骑夹毂弓刀陈。\n共誇官军势雄盛，腰下黄金大邦印。\n旧人桃李已成蹊，新尹号令风云驰。\n迎新争勤送争远，相劝行行畏天晚。\n西风折柳翠不禁，落日转旗红半掩。\n别筵泪粉犹沾衣，旌旗画戟重光辉。\n堂前昨夜语离燕，朝来贺厦成欢飞。\n江南陌上多芳草，长短亭边贵人老。\n君不见田间有客徒步归，年比使君白发少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"赵彦端","text":"杜陵先生诗万纸，剩欲题花无可拟。\n昭阳深殿睡东风，一日声名胜妃子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后饮水慧聚寺","author":"赵彦端","text":"雪后山更佳，冷松及脩竹。\n茫然枝上鸟，伴我梦亦熟。\n阴崖得寒乳，夜半胜酒渌。\n惜无同心人，共此一杯玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 集句","author":"赵彦端","text":"脉脉万重心，相望何时见。\n强半春寒去却来，野水差新燕。\n远负白头吟，坐惜红颜变。\n欲问平安无使来，日落庭花转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁","author":"赵彦端","text":"杏花风下。\n独立春寒夜。\n微雨度，疏星挂。\n晖晖浓艳出，袅袅繁枝亚。\n朱槛倚，轻罗醉里添还卸。\n寂寞情犹乍。\n怅望骖鸾驾。\n衣褪玉，香欺麝。\n一花拚一醉，杯重凭谁把。\n春去也，重帘翠幕人如画。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"赵彦端","text":"春日归来如许长。\n不知偿此意，几何觞。\n老人临酒兴犹狂。\n溪山主，终不道山王。\n一雨罢耕桑。\n平生欢喜处，是吾乡。\n与君花底共风光。\n春莫笑，花不似人香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五彩结同心 为渊卿寿","author":"赵彦端","text":"人间尘断，雨外风回，凉波自泛仙槎。\n非郭还非野，闲莺燕、时傍笑语清佳。\n铜壶花漏长如线，金铺碎、香暖檐牙。\n谁知道、东园五亩，种成国艳天葩。\n主人汉家龙种，正翩翩迥立，雪纻乌纱。\n歌舞承平旧，围红袖、诗兴自写春华。\n未知三斗朝天去，定何似、鸿宝丹砂。\n且一醉、朱颜相庆，共看玉井浮花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]