[{"title":"偈颂四十二首 其二十七","author":"释祖先","text":"夤缘于此得安闲，屈指三年一瞬间。\n好是今朝乘快便，又携藜杖过它山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十九","author":"释祖先","text":"世出世间希有事，显发须还过量人。\n出没卷舒惊世梦，蓬莱山色又重新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十五","author":"释祖先","text":"兴化打克宾，猛虎蓦腰骑。\n养子不及父，家门一世衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十六","author":"释祖先","text":"有问冬来事，京师出大黄。\n汉家勋业在，樊哙与张良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十五","author":"释祖先","text":"尧仁广被三千界，舜德长敷亿万年。\n珍重圣恩何以报，只凭一炷海檀烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十六","author":"释祖先","text":"鹧鸪啼处百花香，日暖风和春昼长。\n昨夜虚空开口笑，祥光瑞气满华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十九","author":"释祖先","text":"晓来鹊噪一声声，象驾峥嵘喜见临。\n款听琅琅终日语，异苗翻秀映丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王承务","author":"释祖先","text":"经年相别无他嘱，莫只波波意里求。\n病去药除消息尽，红尘堆里等閒游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄蒋山如一翁","author":"释祖先","text":"悠悠世路绝跻攀，卧看白云空往还。\n惟有同参一句子，肯将容易混尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖赞","author":"释祖先","text":"飏下采樵斧，直入堆坊舂。\n一脚踏到底，黄梅信息通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"本禅人请赞","author":"释祖先","text":"学道不根，参禅莽卤。\n似恁趣向乖疏，如何传灯继祖。\n本禅画出人前，转见和泥合土。\n就中更有些子誵讹，焦尾大虫元来是虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示禅人写华严经","author":"释祖先","text":"毗卢大经卷，尘识久埋藏。\n上人笔端力，掇出放毫光。\n笑他自城游历，自倒自起自忙。\n江天月晓，梦破斜阳。\n一印印定，无法商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示楞严座王","author":"释祖先","text":"见犹离见非真见，还尽八还无可还。\n木落霜天山骨露，不知谁识老瞿昙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释祖先","text":"梁皇殿前不能把定，少林山下风波愈盛。\n若解谨初护末，不到图形画影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周正字请赞亡母宜人王氏真","author":"释祖先","text":"画得十分，依前不是。\n端坐北堂，琅琅仁义。\n文殊罔明把手行，入定出定恣游戏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"性长老写师真请赞","author":"释祖先","text":"顽无所知，说无照对。\n弄假像真，遭人笑怪。\n花擘临济黄檗，佛法未梦见在。\n在在在，是处清风动天籁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十二","author":"释祖先","text":"天上月圆，人间月半。\n子细看来，从头错算。\n姮娥昨夜失金针，撼动玉楼寻不见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二","author":"释祖先","text":"客从南方来，报我天童老。\n撞破太虚空，全身入荒草。\n而今子细思量，令人哭不成哭笑不成笑，寥寥目断千峰晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十一","author":"释祖先","text":"寒食清明节，韶光映林樾。\n垄上标坟人，眼中流出血。\n生灭本无踪，时人当自决。\n君不见水潦曾经马师踏，直至而今笑不彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十一","author":"释祖先","text":"大小雪窦，错下名言。\n若人知得落著，许他吃著大虫胆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十","author":"释祖先","text":"达磨西来事，今人谩度量。\n天河争起浪，月桂不闻香。\n达磨西来事，今人谩度量。\n人贫智短，马瘦毛长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十四","author":"释祖先","text":"诸人知处良遂知，良遂知处人不知。\n王维已死无人画，留得青山对落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十三","author":"释祖先","text":"一夏九十日，今朝喜圆满。\n拈得巩县茶瓶，摵碎饶州瓷碗。\n冷笑布袋，平欺懒瓒。\n天堂不拘，地狱不管。\n空腹高心担片板，无端瞎却顶门眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十八","author":"释祖先","text":"大人具大见，大智得大用。\n胸中怀六合，掌内握乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十九","author":"释祖先","text":"百不知，百不会。\n似兀如痴，随群逐隧，谁云赵璧无瑕颣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四","author":"释祖先","text":"一夏九十日，今朝喜告毕。\n二千年前事，切忌更寻觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十七","author":"释祖先","text":"二千年前公案，今朝重为提撕。\n同住大光明藏，无修无證无为，脑后依前欠一槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十一","author":"释祖先","text":"只个垂垂白发僧，一生两度受皇恩。\n只凭少室无私句，地久天长祝圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十六","author":"释祖先","text":"种种性相义，我及十方佛。\n乃能知是事，昼见日，夜见月。\n坐卧经行，曾无间歇，吽吽，有甚交涉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十二","author":"释祖先","text":"办能开饭店，谁怕肚皮宽，说甚方便不方便。\n先入南湖门，次入南湖室。\n吞底热铁丸，吃底洋铜汁。\n本色人到来，沙糖更浇蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其八","author":"释祖先","text":"杨岐斗胜不斗劣，秀峰斗劣不斗胜。\n秀峰乍住没亲疏，个个尽怀沧海珠。\n满眼湖山看不足，释迦弥勒是他奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其五","author":"释祖先","text":"暑威尚炽，喜见新秋。\n潘阆倒骑驴子，梵志翻著袜头。\n堪悲堪笑，自唱自酬。\n有时乘好月，特地过沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十","author":"释祖先","text":"首夏初临，薰风乍扇。\n急景如梭，万化千变。\n惟有拄杖子，黑轮皴，没思算。\n解道厨库揖僧堂，三门朝佛殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十五","author":"释祖先","text":"一切数句非数句，与吾灵觉何交涉。\n字义炳然，当阳一决。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十二","author":"释祖先","text":"今朝五月端午，不用书符咒语。\n只将者个拄杖，用作降魔铁杵。\n楚大夫活捉狞龙，张天师倒骑猛虎。\n触翻东海鲤鱼，直得倾盆下雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十六","author":"释祖先","text":"心镜明鉴明无碍，豁然瑩彻周沙界。\n万象森罗不覆藏，一颗圆光非内外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其六","author":"释祖先","text":"大家共住吃茎齑，熟煮烂炊。\n粗餐易饱，细嚼难饥。\n泠淡没滋味，从来少人知，此意明明说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十七","author":"释祖先","text":"旧岁夜来去，去从何处去。\n新年今日来，来从何处来。\n既无来，又无去，铁壁银山成指注。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十四","author":"释祖先","text":"节届书云，阴极阳升。\n冰河发焰，枯木抽英。\n惟有拄杖子，依旧黑轮皴。\n不迁不变，无辱无荣。\n笑杀当年面壁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十四","author":"释祖先","text":"十五日已前明似镜，十五日已后黑如漆。\n正当十五日，莺迁乔木频频语，蝶恋芳丛对对飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其七","author":"释祖先","text":"今朝又见开炉，浩浩诸方暖热。\n卧龙冷落门庭，也要人前细说。\n夜静更阑炭也无，衲衣破处冰侵骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十四","author":"释祖先","text":"这僧问处，字义炳然。\n藏主无言，文不加点。\n还它老成人，扶持正法眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其二十八","author":"释祖先","text":"常独行，常独步。\n咄，莫来拦我毬门路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十三","author":"释祖先","text":"不是心，不是佛，不是物。\n忍俊不禁，为诸人做个瞥脱。\n流水暗销溪畔石，劝人除却是非难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三","author":"释祖先","text":"山润石含玉，林秀渊藏珠。\n珠玉两交辉，情穷意难极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其四十","author":"释祖先","text":"不坐空王殿，不挂本来衣。\n何须更恁么，切忌未生时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十八","author":"释祖先","text":"今朝五月端午节，千妖百怪尽消灭。\n艾虎桃符相耳语，摇头不肯向人说。\n无端被者主杖子，对众一时俱漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十","author":"释祖先","text":"智慧弓，坚固箭，射破虚空成两片。\n海门斜去两三行，惊起暮天沙上雁。\n牛头没，马头回，铁壁银山一拶开。\n上苑玉池方解冻，湖光潋滟映崔嵬。\n却笑普通年远事，不从葱岭带将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其十五","author":"释祖先","text":"插一茎草建梵刹，画出规模何太窄。\n争似亦庵新建立，容尽十方云水客。\n鹫岭风高，少林月白。\n光明寂照遍河沙，万古流辉有张拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十二","author":"释祖先","text":"卧病恰旬馀，气力无一铢。\n皮穿筋骨露，勉强且支梧。\n无盐无米，谁为分疏。\n拄杖子起来，泻出百斛明珠。\n各请点检仓库，毕竟是有是无。\n山僧不免随后念个苏噜苏噜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戢庵居士持寿像求赞","author":"释祖先","text":"似僧有发，似俗无尘。\n淡默自处，惟德与邻。\n曾向凤池亲圣训，更来鹿苑夺芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戢庵居士请赞济颠","author":"释祖先","text":"瞎堂之子，附马之后。\n出处行藏，一向漏逗。\n是圣是凡莫测，掣颠掣狂希有。\n一拳拳碎虚空，惊得须弥倒走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人请赞","author":"释祖先","text":"错错错，徒名邈。\n画得十成，欠蹄少角，一任天下人贬剥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终偈","author":"释祖先","text":"末后一句，已成忉怛。\n写出人前，千错万错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临济赞","author":"释祖先","text":"揎拳捋肘，只有一个。\n电卷星飞，抬头蹉过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其三","author":"释祖先","text":"岩头一拶，虚空迸裂。\n父子不传，神仙妙诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其九","author":"释祖先","text":"马祖升堂，百丈卷席。\n正令不行，拗曲作直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释祖先","text":"散诞不拘仪轨，街头走到街尾。\n逢人大笑呵呵，那个知渠肚里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其三十七","author":"释祖先","text":"黄檗山头吃棒，大愚肋下筑拳。\n佛法的的大意，犹隔十万八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释祖灯","text":"赵州眼放光，烁破四天下。\n钵盂上安柄，至今成话霸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其三十五","author":"释祖珍","text":"是处青山可垛跟，白云流水绕孤村。\n笑携拄杖出门去，三世谁知一口吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其三十四","author":"释祖珍","text":"陋巷闭门唯读书，了无尘果自如初。\n时来坐脱西窗下，惊起须弥绕太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其三十二","author":"释祖珍","text":"灵文一阅五千卷，感果当知越四禅。\n应笑毗耶方丈里，却容天女问因缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其三十","author":"释祖珍","text":"断除须发著僧衣，精进当遵古佛仪。\n一念不生亲领略，方知我法妙难思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其二十一","author":"释祖珍","text":"九夏斯临结集时，满堂云水复明谁。\n若言相见交肩过，未免依前落见知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"升堂颂古五十二首 其十七","author":"释怀深","text":"物物到心上，全心物自闲。\n古今城郭里，得者住如山。\n但愿清风生两腋，不愁无路到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其十九","author":"释祖珍","text":"飘空一叶两新收，暑退凉生万壑秋。\n贴肉汗衫才脱下，横吹木笛倒骑牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其十二","author":"释祖珍","text":"寻牛须访迹，学道访无心。\n迹在牛还在，无心道易寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其十","author":"释祖珍","text":"衰老百一堪，担头入闹篮。\n生涯何所有，弥勒是同龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其九","author":"释祖珍","text":"岩谷相从始晏然，又携瓶锡应时缘。\n奉川此去无多远，兴发何妨访戴船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其八","author":"释祖珍","text":"长年追逐走埃尘，嬴得闲名累此身。\n争似别峰峰顶上，一庵高卧与云邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其四","author":"释祖珍","text":"自惭疏拙百无能，下板长行粥饭僧。\n岂谓因缘有侥倖，千斤担子若为胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙湫拜诺矩罗尊者","author":"释祖珍","text":"十里松溪到上流，断崖千尺泻龙湫。\n谁言尊者心无著，冷眼长年看不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其三十三","author":"释祖珍","text":"蔡居士，昔也恁么来，今也恁么去。\n今昔两无殊，去来拟何处。\n住住，明明百草头，明明无生路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三十五首 其二十六","author":"释祖珍","text":"我所得智慧，微妙最第一。\n众生诸根钝，著乐痴所盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]