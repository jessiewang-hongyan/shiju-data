[{"title":"次韵姜光彦移居","author":"吕颐浩","text":"仕途忧患久相随，老去求闲遂燕私。\n陇笛不闻吹旧曲，彩笺时见赋新诗。\n清宵好月穿蓬户，落日凉风动桂枝。\n两鬓霜毛如旧少，按弦无意望钟期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵卢虞卿枢密见寄之什","author":"吕颐浩","text":"维扬初记接英躔，日月飞驰已十年。\n政路翱翔常在后，祠宫闲退蚤输先。\n欲陪清会时颙首，辱惠新诗思涌泉。\n幸有会稽栖隐地，约公归老钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登第后道中灯下读书","author":"吕颐浩","text":"十载灯前笔下耕，如今雁塔幸题名。\n他年若遂平生志，肯为长檠弃短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行次渑池道中","author":"吕颐浩","text":"十年两度到秦川，每忆东归意浩然。\n何况驱车度殽渑，眼前都是好风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"吕颐浩","text":"金风萧瑟动疏帘，细雨霏微拂画檐。\n篱菊半开家酿熟，自惭生理胜陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重和改元冬至","author":"吕颐浩","text":"至后光阴争一线，竹轩小阁兽炉新。\n捲帘剩放冬曦入，暖律浑如洞府春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题樊将军庙","author":"吕颐浩","text":"排危盛气冠英雄，逆耳忠言悟沛公。\n何事时人太求备，欲将瑕翳掩前功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"承乏河北东路不得为天平之游偶成小诗呈沈和中殿撰胡少汲龙图","author":"吕颐浩","text":"梦想天平紫府开，却嗟匏系在铜台。\n山灵有意憎尘俗，不许寻芳暂到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘圣可杨如晦贾习之三首 其一","author":"吕颐浩","text":"清晖堂下相从夜，见说崔桥自昔游。\n别后不知能几日，却来桥上系扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘圣可杨如晦贾习之三首 其二","author":"吕颐浩","text":"霜汀野岸清宵月，偏照蓬窗不寐人。\n遥想塞垣千里共，可怜名宦阻相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘圣可杨如晦贾习之三首 其三","author":"吕颐浩","text":"北山逋客今何在，西塞从军各未归。\n欲访草堂寻旧隐，恐教猿鹤谩依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新酒金橘寄李德升","author":"吕颐浩","text":"稻醅初熟鹅儿色，金橘方包弹子新。\n寄与乡朋供一醉，捧觞应笑独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟次魏村阻风","author":"吕颐浩","text":"扁舟深入水云乡，浩渺浑疑带远江。\n蓼岸阻风还度日，夕阳依约照篷窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真定城中闻莺声方响和贾明仲","author":"吕颐浩","text":"谁家方响闻莺声，恰似年时在帝京。\n宝马金鞍芳草路，却教潘鬓二毛生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦室","author":"吕颐浩","text":"丹心忧国梦魂间，祗恐清霄亦未闲。\n枕上几回游魏阙，觉来聊且看闽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰室","author":"吕颐浩","text":"秋兰馥郁有幽香，不谓无人不吐芳。\n最好移根来一室，试纫幽佩意何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双莲阁","author":"吕颐浩","text":"双莲争秀漾清波，雾卷烟收认两娥。\n枫落澄江秋欲尽，半池霜倒奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菖蒲涧","author":"吕颐浩","text":"溪荪得地恣芬芳，三尺挥空剑刃长。\n闻道仙人尝采掇，涧边栽植对朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题临济所居","author":"吕颐浩","text":"鸣钟列鼎心无累，茹糗羹藜乐亦全。\n解把穷通为一致，此生何处不超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄邑道中赠孙天予子礼三首 其一","author":"吕颐浩","text":"咸平岸下分襟日，襄邑亭前把臂时。\n十载光阴惊一梦，塞尘踏尽鬓如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄邑道中赠孙天予子礼三首 其二","author":"吕颐浩","text":"霜毛一别各毵毵，兴味年来老不堪。\n横槊赋诗休塞北，扁舟垂钓渐江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"襄邑道中赠孙天予子礼三首 其三","author":"吕颐浩","text":"弟兄交契比雷陈，白首相看意转亲。\n收拾壮怀同老去，江皋他日幸相邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圭沼","author":"吕颐浩","text":"凿沼因方类介圭，雨馀泉石转增辉。\n排空恨乏乘风术，去傍沧浪濯我衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂斋","author":"吕颐浩","text":"双桂亭亭傍竹斋，窗前会见紫花开。\n它时酿入椒浆后，香逐和羹满座来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二咏 其七 桂亭","author":"李纲","text":"团团双桂拂茅斋，虚幌疏棂尽日开。\n会待秋高风露下，清香飘泛月中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹亭","author":"吕颐浩","text":"此君潇洒绿筠抽，直干凌云碧翠浮。\n想见风枝陪宴坐，囊封草就告嘉猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"橘亭","author":"吕颐浩","text":"翠叶田田粲绿云，黄金苞实露华新。\n绕亭虽乏千株广，不羡当年万户人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荔枝亭","author":"吕颐浩","text":"水晶绛雪旧驰名，珍重移来近野亭。\n看取薰风炎暑际，丹苞万颗粲繁星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汝南县蒙溪亭二首 其一","author":"吕颐浩","text":"门外行人困郁蒸，不知萧寺有溪亭。\n暂铺冰簟闲伸展，一枕清风午梦醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题汝南县蒙溪亭二首 其二","author":"吕颐浩","text":"暑途白昼倦趋程，月暗泥深夜阻行。\n却羡野僧无一事，布衣蔬饭任平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"顷为河北东路常平厅事后有便坐厅两槛植竹春时仆别栽新竹去其旧本后二十年脩干森耸遂成茂林友人郭仲思尝为本路提刑寓此廨有书因回信寄一绝","author":"吕颐浩","text":"昔年官守在铜台，两槛疏篁手自栽。\n劲节浓阴还在否，清风应为故人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈元用游天台三首 其一","author":"吕颐浩","text":"出处何劳问大钧，如公材哭略铺陈。\n谈兵玉帐诗书帅，演诰纶闱侍从臣。\n万叠名山聊寓目，一方仙宅勿藏身。\n中原未复须留念，先入夷门渐入秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈元用游天台三首 其二","author":"吕颐浩","text":"山居犹不厌山行，石磴攲危步履轻。\n夹路不闻双阙在，幽岩应有五芝生。\n春寒未放迁莺啭，风暖先催布谷鸣。\n我欲营茅留俗驾，无赀谁寄孔方兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":62999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈元用游天台三首 其三","author":"吕颐浩","text":"前麾转綵陈旗红，二纪穷边一梦中。\n曾拥雕戈思却日，屡乘铁马听嘶风。\n谁怜老去三春病，自觉闲来万虑空。\n满路落花归雁后，勿令书疏不相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登巾子山寄怀韩嗣夫","author":"吕颐浩","text":"几年踪迹共飞沈，自渡江来幸盍簪。\n奉使久违常恨别，闲居无梦不相寻。\n勒功钟鼎经纶志，混迹渔樵老退心。\n篱菊正开家酿熟，一樽何日得同斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至天台马上口占","author":"吕颐浩","text":"东归顿觉马蹄轻，伫望天台景色新。\n遥想故园芳草盛，一番桃李又烘春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭传师宠寄闲居之什","author":"吕颐浩","text":"小隐丹丘郡，安闲世虑空。\n运筹边阃帅，昭代将家风。\n牙帐霜矛白，宾筵舞袖红。\n何时同把臂，醉伴钓鱼翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李德升老堂 其一","author":"吕颐浩","text":"腐儒才术本庸庸，祖业安能效太公。\n老去退休营小隐，闲来时幸濯清风。\n相从坦率形骸外，投分交游意气中。\n衰谢何堪抚鸣剑，梦魂犹拟灭羌戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李德升老堂 其二","author":"吕颐浩","text":"野堂岂意题佳句，强欲赓酬愧续貂。\n闲适更须驰厩马，访临无惜过溪桥。\n秋风南浦观垂钓，落日东山伴采樵。\n此乐有时惊自得，泥途何必羡烟霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次綦叔厚韵 其一","author":"吕颐浩","text":"佐时勋业愧先贤，迹退丹丘已二年。\n买得石田东郭外，盖成茅屋北山前。\n长林远水相萦带，翠岫奇峰更接连。\n多谢朋游念衰飒，寄题佳句已成编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次綦叔厚韵 其二","author":"吕颐浩","text":"心存魏阙岂能忘，揣分非才合退藏。\n此日燕休难报国，半生艰险忆垂堂。\n枕戈每叹身先老，览镜常嗟貌不扬。\n每今蘧庐聊偃息，会须恢复返吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次石迪功韵 其一","author":"吕颐浩","text":"枫庭累岁玷朝班，老荷宸恩得退闲。\n枥马虺隤休入驭，陇禽衰倦合知还。\n莫辞敛迹归南亩，幸免移文向北山。\n恢复中原乖素愿，梦魂时得到乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次石迪功韵 其二","author":"吕颐浩","text":"丹丘无限好山川，叠翠峰峦插暝烟。\n郊外幽居三岁换，天边明月几回圆。\n野堂半隐慵攲枕，健笔题诗思涌泉。\n小圃剩开桃李径，飞觞同醉待来年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪成季韵 其一","author":"吕颐浩","text":"壮岁勤劳不自量，退居栽植复何忙。\n静思身外功名误，老觉闲中气味长。\n雨后群山千叠翠，春回幽圃百花香。\n农人不识归休客，载酒相邀入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次洪成季韵 其二","author":"吕颐浩","text":"圣运中兴偶幸逢，经邦曾乏古人风。\n闭关退处喧嚣外，抚剑行吟感慨中。\n尚有素怀思报国，可怜幽梦欲平戎。\n新诗增重林泉价，倍见交情我与公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次潭州通判范寅秩韵 其一","author":"吕颐浩","text":"胡尘一动隔吾乡，旋向丹丘筑草堂。\n方效潜鱼游河渚，忽随飞雁到衡阳。\n雨馀南陌千峰翠，春日东郊百草香。\n身在湖湘归未得，梦魂时到旧居傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次潭州通判范寅秩韵 其二","author":"吕颐浩","text":"经纶无术致时康，何事连年住庙堂。\n退伴农夫耕晓月，闲陪渔父钓沧浪。\n壮怀衰谢休鸣剑，旧学荒芜耻面墙。\n别乘意勤贻雅什，续貂深愧不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次李泰发韵","author":"吕颐浩","text":"东郊半隐绕群峰，门外涓涓一水通。\n再岁依栖忻有幸，十年遭际叹无功。\n闲心不厌耕南亩，清梦犹思殄北戎。\n看去中原恢复后，麒麟图画首肤公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张全真参政韵 其一","author":"吕颐浩","text":"垂老归休荷圣恩，栽花种竹引儿孙。\n向来豪健风樯勇，老去光阴渴骥奔。\n往事不劳空咄咄，素怀犹欲济元元。\n天台山下柴荆路，白首栖迟学灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次张全真参政韵 其二","author":"吕颐浩","text":"青郊卜筑傍溪流，菡萏香中系小舟。\n脱去簪绅归畎亩，悟来□钓胜公侯。\n青云旧好何相厚，白雪新诗为宠留。\n又指湘潭问行路，一堂风月阻同游。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次朱通判敦儒韵 其一","author":"吕颐浩","text":"腐儒奋迹自耕耘，冒玷台衡力不任。\n版筑作霖乖素愿，山云出岫本无心。\n衰迟向老开三径，豪迈平时惜寸阴。\n蚤伏诗名压元白，细看佳句用工深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次朱通判敦儒韵 其二","author":"吕颐浩","text":"天台山下草堂深，樽酒时倍钓叟倾。\n屏迹分甘归畎亩，放怀谁复羡公卿。\n幽栖幸免牵荣辱，高遁何须隐姓名。\n洛浿词人通显后，愿来相访伴山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次仇待制韵 其一","author":"吕颐浩","text":"腐儒奋迹自山东，强欲区区效小忠。\n恢复中原虽有意，翼扶兴运怅无功。\n辞荣归去营三径，念昔何颜总百工。\n海不扬波边堠啸，伫闻飞牍奏肤功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次仇待制韵 其二","author":"吕颐浩","text":"韭违轩陛归临海，颇幸栖身田亩间。\n混迹每寻樵叟伴，放怀常羡钓翁闲。\n君恩深厚司留钥，野性彷徨恋故山。\n异日公成勋业后，巾车无惜过柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次郑顾道韵 其一","author":"吕颐浩","text":"南郊同赋出郊篇，二纪光阴速箭传。\n祠馆退归乖素志，帅藩承乏愧前贤。\n羸驱岂愿留湖外，清梦时惊到海壖。\n待得秋风归旧隐，黄鸡白酒养衰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次郑顾道韵 其二","author":"吕颐浩","text":"不读离骚不著书，竹篱环合野人居。\n开樽细酌山中酒，挂壁闲看卧雪图。\n出处似非还似是，宦名如有亦如无。\n故人意厚题佳句，岂为疏狂鄙接舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭思得之归德铺留题 其一","author":"吕颐浩","text":"马前山色入吟鞭，马上行人思涌泉。\n枫落吴江何足道，好诗今拟谢临川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭思得之归德铺留题 其二","author":"吕颐浩","text":"妙年题笔吐英辞，壮岁文章尽色丝。\n五字七言嫌浅俗，挥毫新制六言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵郭思得之归德铺留题 其三","author":"吕颐浩","text":"故园一别四经秋，倦宦东归念昔游。\n下马邮亭开病目，壁间依旧见银钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"吕颐浩","text":"草履便将为幸舄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵彦平叔见赠","author":"廖刚","text":"千年东序愧囊锥，浪学何生且一归。\n远道几烦黄耳走，故山今谢白云飞。\n燕游未许安仁里，梦想频惊在礼闱。\n争似钓台饱风月，一溪桃李自霏霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大学送余适正往洛中就馆","author":"廖刚","text":"少小各西东，天涯会两蓬。\n相看身未了，欲别意无穷。\n岁晚嵩山雪，天寒洛浦风。\n寂寥倚孤剑，应忆笑言同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代祖父次韵酬罗君宝见赠","author":"廖刚","text":"萧条门巷陋于颜，老去青春仅得闲。\n心画传家无计策，手谈留客谩机关。\n静思往事千年上，俯叹劳生一梦间。\n多谢光临无别意，为闻流水与高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵陈无伤春日书事","author":"廖刚","text":"百草千花巧趁春，爱春何独水边人。\n青门紫陌酒旗飏，丽日和风天气新。\n白玉少年长带佩，红蕖游女小腰身。\n自怜惯作金明客，坐对闲窗满席尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张敏叔江南僧舍送春之什","author":"廖刚","text":"使华綵旆明春江，江边佛国游清凉。\n柔桑菀菀丝成荫，落花寂寂红馀香。\n人间节物易流转，独有日月壶中长。\n高欢应笑杜陵客，典衣沽酒留风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题丁乐道分翠轩","author":"廖刚","text":"十亩清阴隔短墙，幽香端许借馀光。\n脩篁戛玉乱垂影，佳木屯云巧著行。\n隐几助成春草梦，卷帘饶占比窗凉。\n谁知靖节心源冷，独眄庭柯兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题诸宫 其一","author":"廖刚","text":"燕子无情语亦稀，春风池沼自涟漪。\n当年胜事归何许，苔没龟趺有旧碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题诸宫 其二","author":"廖刚","text":"画桥红去卷蛾眉，台榭遗踪草树迷。\n犹有天然无限意，一池春水浴凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题诸宫 其三","author":"廖刚","text":"蔓草春深绿更齐，玉鞭何处选芳菲。\n旧时锦绣丛中蝶，却傍疏篱野菜飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和陈几叟苦雨","author":"廖刚","text":"云雾阴阴阁太虚，雨馀蛙蚓上阶除。\n山颓井塌应无奈，大有人愁化作鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":63036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]