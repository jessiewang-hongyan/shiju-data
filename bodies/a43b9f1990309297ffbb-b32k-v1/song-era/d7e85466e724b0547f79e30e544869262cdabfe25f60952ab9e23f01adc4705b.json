[{"title":"送刘允叔还浙东","author":"刘过","text":"树倒群公尚不飞，先生于此独知几。\n杀身无益事成败，闭口不言心是非。\n吴渚莼鲈张翰去，鉴湖风月贺章归。\n从教血染长安市，一舸清风眠钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许阎二兄归岳阳","author":"刘过","text":"岳鄂旧游处，重来岁月更。\n联翩识吾友，邂逅慰平生。\n风送故人远，槐催举子惊。\n扁舟更珍重，万里莫留行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨伯子","author":"刘过","text":"天下少奇士，况乎吾一州。\n逢人问姓字，知子有源流。\n兰砌多黄口，蓬山半白头。\n诚斋知未可，唤作小坡休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送金陵胡抚干仲芳 其二","author":"刘过","text":"共醉百斛酒，千金一笑倾。\n寄情桃叶渡，吊古石头城。\n战守筹雄地，更番出戍兵。\n瓮天留不住，图略遂西征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送金陵胡抚干仲芳 其一","author":"刘过","text":"故家凋丧后，初识澹庵孙。\n玉树明庭角，冰澌吐话言。\n荆州得上幕，楚壤带中原。\n我欲附舟去，白鱼朱橘繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客剡溪","author":"刘过","text":"送客山阴路，春风散马蹄。\n纵观神禹穴，深入子猷溪。\n嫩草绿于染，珍禽娇已啼。\n去程千万里，步步有云梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜寄卢菊涧","author":"刘过","text":"见说卢夫子，诗成手自书。\n雪便金帐煖，云荫玉山居。\n椒叶储名酒，萍齑荐野蔬。\n夜寒裈犊鼻，应念马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽苏吏部","author":"刘过","text":"奕世徵文献，逢时仕学优。\n爱遗边郡在，官止外郎休。\n月黑新茔夜，溪横旧隐秋。\n从游老宾客，欲替二孤愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽拙庵杨居士 其一","author":"刘过","text":"前辈晨星似，如公抑又希。\n榆边游已倦，菊径晚方归。\n听雨兄同老，冲天子欲飞。\n伤心弹指顷，一梦故人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽拙庵杨居士 其二","author":"刘过","text":"尚忆龙蟠国，城西作客时。\n有山皆载酒，无日不赓诗。\n风雨交游散，江湖泪眼悲。\n百年心事在，只有凤雏知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盐官权学","author":"刘过","text":"人生百岁等欢悲，已判行藏任所之。\n笔砚重寻惊梦觉，课程聊复伴儿嬉。\n荒原傍海多閒趣，闭户观书有倦时。\n破帽尘埃今已矣，不妨更借蹇驴骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盐官借沈氏屋","author":"刘过","text":"借宅西头对短檠，一灯相对纸窗横。\n煨炉火活蹲鸱熟，沸鼎茶香蚯蚓鸣。\n万卷读书空老大，诸生盖世尽功名。\n依稀草木还乡去，便向夜深闻雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都中留随州李判官","author":"刘过","text":"幸自东南好，西归未可忙。\n茶添橄榄味，酒借蛤蜊香。\n绝品宜春醉，新烹趁日长。\n倒囊烦厚载，归遣北人尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒楼","author":"刘过","text":"夜上青楼去，如迷洞府深。\n妓歌千调曲，客杂五方音。\n藕白玲珑玉，柑黄磊落金。\n酣歌恣萧散，无复越中吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁塔寺呈轻老","author":"刘过","text":"树木有古意，轩窗多野情。\n断冈城一带，齐岸草丛生。\n醉骨风蝉蜕，病身沙鸟轻。\n惜无东野笔，琢句斗僧清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪赵丞饮东轩","author":"刘过","text":"冠盖如云许后陪，酒红医老上吾腮。\n转旋舞影乾坤窄，摇撼歌声风雨来。\n鱼网撒池莲叶老，龙涎熏坐桂花开。\n群娥捧劝同文字，商略西风更百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偕陈调翁龙山买舟待夜潮发","author":"刘过","text":"来逢春雨长鱼苗，去见秋风擘蟹螯。\n久矣归心到乡国，依然水宿伴渔舠。\n一天如许皆明月，二客所须惟浊醪。\n今夜四更潮有信，更须留眼看银涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄吕英父 其二","author":"刘过","text":"秋到家山冷不知，但惊风露入新诗。\n低头欲拜无东野，满耳惟闻说项斯。\n骨格昂藏云鹤瘦，吟哦凄断雪猿悲。\n文章已得真消息，三十科名未是迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄如皋叶尉","author":"刘过","text":"借马石庄去，天寒晓出门。\n乱岗行兔窟，数点入鸦村。\n欲醉酒力薄，如迷海气昏。\n客游无限事，端的向谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张都干蒙正","author":"刘过","text":"林深叶密绿阴繁，荷渐生芽蒲有根。\n心事蹉跎过岁月，故人落寞共乾坤。\n舟行莼菜水云浦，路入杨梅烟雨村。\n何日扣门寻子去，一樽聊对话黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄李侍郎","author":"刘过","text":"未照玉堂金炬莲，地官董正职尤专。\n常经要足邦中赋，胜算犹烦马上鞭。\n黄阁少须持紫橐，黑头早已继青毡。\n方今讲论肥民策，不数横流地上钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄周益公","author":"刘过","text":"猥贱诗难化，欢嚣语不齐。\n长途难短堠，小雨易深泥。\n逐利如争鹿，伤人类割鸡。\n心虽怀益国，梦亦畏江西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄桐庐程宰","author":"刘过","text":"路入严州去，桐庐得暂过。\n盘餐汤饼贱，机杼绮罗多。\n令尹哦诗治，居民酌酒歌。\n吏人公事少，门雀可张罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郭伯瞻","author":"刘过","text":"圣门力学钱公辅，盛世能书蔡伯喈。\n出处有时安义命，笑谈无我见襟怀。\n桂花香满山堂闹，秋气清连石洞偕。\n只好放教椽笔健，留将大字写磨崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄湖州赵侍郎","author":"刘过","text":"桑柘村村烟树浓，新秧刺水麦梳风。\n舟行苕霅双溪上，人在苏杭两郡中。\n鼓角丽声相旦暮，旌旗小队间青红。\n主人夙有神仙骨，合住水晶天上宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄程鹏飞","author":"刘过","text":"往事游边忆少年，未尝携刺五侯门。\n春风跃马汉南道，落日椎牛淮上村。\n科举未为暮年计，穷途不忍向人言。\n男儿慷慨头当断，未有人施可报恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄潘文叔","author":"刘过","text":"不随千骑过维扬，夜渡关山却一航。\n臭味偶同贫更好，功名有志老何伤。\n自甘商皓来东阁，敢怨陈登卧上床。\n欲击单于知力倦，归来且理旧诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒江华曾百里 其二","author":"刘过","text":"鬓发已皤非故吾，依然破帽老骑驴。\n江边游子断肠句，汉殿逐臣流涕书。\n父祖松楸三世冢，弟兄桑梓百年居。\n狐丘未死归心切，未有相如驷马车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒江华曾百里 其一","author":"刘过","text":"抠衣三十年前事，曾以诸生傍绛纱。\n一国所尊吾白下，双凫犹远令江华。\n时来馆学总馀事，老去衣冠怀故家。\n共怪我门郊岛外，狂生尚有一刘叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒苏州守","author":"刘过","text":"十年狂荡客征途，时为文章未剖符。\n引臂欲攀天上月，回身却碍日中乌。\n穷愁自是真男子，慷慨须投大丈夫。\n闻道使鱼鳌海阔，特将香饵钓姑苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒京口张守 其一","author":"刘过","text":"未识诸人名已侯，一麾应此滞徐州。\n谁知安石恐未免，欲借寇君何可留。\n遗爱与山同北固，平生作计岂东周。\n上方已听尚书履，声在星辰最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒京口张守 其二","author":"刘过","text":"危楼年少记登临，老矣重来力不禁。\n风月欲谈嫌许事，山川不险似人心。\n淡烟衰草乡关远，细雨黄花节序深。\n虽有小诗行乐处，世无知己为谁吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒易司谏 其二","author":"刘过","text":"十载长安五往来，立谈无语口慵开。\n懒看龌龊随时士，谁是艰难济世才。\n韦布岂无堪将相，庙堂未易贱蒿莱。\n上书欲谒平章去，光范门前肯自媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒淮西帅","author":"刘过","text":"家住徐城未卜还，归心正在杳冥间。\n东游吴魏三千里，西入成都一万山。\n解使愁肠能寸寸，空令泪眼已斑斑。\n此情不告英雄帅，说向儿曹总是閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中呈颜使君升坚 其二","author":"刘过","text":"阴阳舒惨刹那间，刺使天高见一斑。\n人物眼中如水鉴，世情身外不冰山。\n涤除瑕垢与掩匿，弹压风云俱涩悭。\n羔酒帐金输武库，煮茶萧寺等僧閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中呈颜使君升坚 其一","author":"刘过","text":"一冬所欠者雪耳，造物忽然如戏儿。\n清甚牧之江上郡，朗吟次仲馆中诗。\n试灯夜静疏梅落，卖剑村深小麦滋。\n多少使君调燮意，风流自有化工知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚山长栖阁","author":"刘过","text":"柳径参差小叶蓝，不知世有府潭潭。\n扬雄宅就巢枝一，去病家寒绕树三。\n从臾诸公时烂漫，劝酬终日酒醺酣。\n出门万里江边去，尘满征衫我甚惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨呈吴按察 其二","author":"刘过","text":"黄鹤山前雨乍过，城南草市乐如何。\n千金估客倡楼醉，一笛牧童牛背歌。\n江夏水生归未得，武昌鱼美价无多。\n掉船亦欲徜徉去，古井而今淡不波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨呈吴按察 其一","author":"刘过","text":"使君人物旧乌台，天听虽高力挽回。\n湖水欲平江为退，秋田未旱雨朱来。\n云随黄鹤游何许，风满南楼亦快哉。\n凉意入秋清可画，月岩知有桂花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓公坊","author":"刘过","text":"秋风渐渐正吹凉，似报归期未欲忙。\n寻路竹间深入寺，泊船沙外远依庄。\n小槽压酒珠红滴，新饭炊粳雪白香。\n更听夜来思远浦，军声十万似钱塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓东阳 其二","author":"刘过","text":"不学老无似，艰难却饱谙。\n远从陶靖节，来访杜征南。\n意到羹莼适，贫犹食荠甘。\n惜无庐可卧，尚绕鹊枝三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓东阳 其一","author":"刘过","text":"元帅东阳主，令君吾故人。\n可怜九华客，犹是一穷民。\n古者狂狷士，人间自在身。\n化工都不管，何地有阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游北墅","author":"刘过","text":"客里浮沈又一年，春风北墅故依然。\n路边花有香相引，涧下松无色可怜。\n仙鹤舞随人击筑，神鸦飞傍客归船。\n何须故扫霜前叶，却趁东风学晓烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游古山","author":"刘过","text":"信步作幽讨，有庵如此深。\n佛灯明老屋，秋日淡疏林。\n柏树祖师意，松楸老子心。\n十年弃坟墓，洒泪一悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩","author":"刘过","text":"风露凄然八月秋，瘦藤扶我到山头。\n僧居突兀飞鸿上，人迹依稀任鹿游。\n旧事已空流水在，闲情都付落花休。\n越王未是真尝胆，计出婵娟事可羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖口宰任伯厚挹清亭","author":"刘过","text":"正笑行役倦，登临心眼开。\n舒蕲千里见，蜀赣两江来。\n老觉树如此，凉生风快哉。\n主人方好客，不算酒行杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖口邂逅张伯丰同行","author":"刘过","text":"万里无人独自行，得君逆旅尉东征。\n联同骑马相先后，共作诗词迭唱赓。\n仆向洞庭和雪渡，船从湖口带冰撑。\n明年袍绿荆州去，遇有西人好寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登旷轩","author":"刘过","text":"去春曾与客，携手过桥来。\n寺阴松极美，坞深桃不开。\n红尘万里去，白首一年回。\n净洗旷轩眼，雪天閒看梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登凌云高处","author":"刘过","text":"摄衣更上一层楼，才到层霄最上头。\n方识乾坤真转毂，好知身世付虚舟。\n九秋草木岚烟湿，万里山川海气浮。\n更欲杖藜穷望眼，眼中何处认神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登清凉台寺","author":"刘过","text":"江南江北许多山，到处登临得凭栏。\n老木渐丹霜有信，怒涛冲岸水生寒。\n倦游半世乌三匝，往事千年指一弹。\n落日正西催上马，依依回首问长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简季文","author":"刘过","text":"衰鬓萧骚半欲丝，尚能随队作儿嬉。\n棋无杀意从人活，琴有仁声却自悲。\n落魄陈平归汉日，中伤张禄入秦时。\n诸公莫作狂夫看，恐是英雄未可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简能仁礼老","author":"刘过","text":"幻身到处等空虚，习气依然未扫除。\n柏树子边寻祖意，栴檀林下伴僧居。\n三千世界初无碍，十二时辰得自如。\n牛粪火堆煨芋熟，时时拾得懒残馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阙景初进纳长安相值于西采石话及家事因与对酌","author":"刘过","text":"未有还家策，故乡吾太和。\n龙洲沙石健，快阁水云多。\n场屋科名累，江湖岁月磨。\n茅柴一杯酒，相对奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中偶成","author":"刘过","text":"小院蒲萄月架东，舞腰忙趁鼓声雄。\n诗成綵笔分题后，人在金钗赌令中。\n秋叶冷吟风浩荡，晚林烘透日玲珑。\n腰间若佩滁州印，定有人呼作醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉中寄王子林","author":"刘过","text":"我头扶病醉岑岑，履历糟丘岁月深。\n行李随身惟一剑，对花买笑亦千金。\n离乡别去天涯泪，上冢凄其寒食心。\n风雨闭门无客过，炉香销尽夜沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题凤凰台","author":"刘过","text":"公子飘然有俊才，此台翻觉在尘埃。\n江淮浩渺洲渚没，凤鸟寂寥鸿雁来。\n时事不言惟拄笏，书生无用且衔杯。\n生平自厌胸中窄，万里霜天一日开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题禾川龙飞英疏荣阁","author":"刘过","text":"堂扁朱书字，何人可得之。\n三衙新统帅，六馆老宗师。\n文武无穷意，江山不尽诗。\n亲恩如可报，会有报君时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙华寺壁","author":"刘过","text":"春事梅边动，荒江信马行。\n久穷知远举，多瘦怯衣轻。\n今日龙华寺，昔时黄姥城。\n废兴吾已解，一醉万缘清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题池州一览亭","author":"刘过","text":"尘土中无绝妙词，不能重赋翠微诗。\n淋漓醉墨杨廷秀，慷慨悲吟杜牧之。\n岩壑尚多吾足倦，江山信美客归迟。\n夕阳鸦点城门闭，堤上鞭垂万柳丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题京口多景楼","author":"刘过","text":"壮观东南二百州，景于多处却多愁。\n江流千古英雄泪，山掩诸公富贵羞。\n北府只今唯有酒，中原在望莫登楼。\n西风战舰成何事，只送年年使客舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄文叔燕堂 其二","author":"刘过","text":"著屋图书里，四山楼观重。\n莼添张翰思，橘当李侯封。\n湖水自平淡，花枝多冶容。\n兴来诗已就，只可酒千钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄文叔燕堂 其一","author":"刘过","text":"仕宦不惬意，有家胡不归。\n林栖乌反哺，梁语燕于飞。\n鸥鹭忘之久，貂蝉贵者稀。\n但存慈母健，日日舞斑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龚山长栖阁","author":"刘过","text":"爱客龚山长，能容日日过。\n栽培初种竹，爱护乍生荷。\n堂对青山短，门关白日多。\n细听閒议论，不似我狂歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题雁汊峰东林寺","author":"刘过","text":"雁汊泊船去，岸头閒访僧。\n故人留少驻，俗子见何曾。\n佛屋擎天柱，心光续命灯。\n任渠狂到死，吾老慢腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题叠浪轩","author":"刘过","text":"僧房矮占一窗幽，不见当年叠浪浮。\n湖已为田知幻化，律更以教示精修。\n白莲何日还同社，顽石无时不点头。\n可惜能诗张孟辈，却无一字此间留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠乡人曹倅待聘为通州静海宰及施博士","author":"刘过","text":"茅苇连天昨已非，二年重到最堪悲。\n芹宫尚有肩吾在，花县犹存子建知。\n踯躅南飞三绕树，凄凉北望四愁诗。\n东风若不均披拂，荐福仍然又断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠术士","author":"刘过","text":"一性圆明俱是佛，四方落魄总成仙。\n逢人只可少说话，卖卜不须多觅钱。\n退一步行安乐法，道三个好喜欢缘。\n老夫亦欲挑包去，若要相寻在酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]