[{"title":"送清漳护戎王中立","author":"胡宿","text":"赋别匆匆涕泫然，七闽封堠接蛮烟。\n山长水远知何处，花落莺啼又几年。\n顾我青衫随吏牒，惜兄华发事戎旃。\n风波世路相逢少，肠断东归下濑船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕昭邻同年宰巫阳","author":"胡宿","text":"清蕊君宜妙一台，当年仙桂并枝开。\n楼逢春雪尝为曲，庙近朝云转费才。\n远字莫教双鲤断，归期偏望二凫来。\n巴猿蜀魄多离恨，犹喜圭田助酒材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李寺丞宰攸溪","author":"胡宿","text":"短李祠堂世阀馀，少年从学马融居。\n楼中质问无疑义，帐后传藏有默书。\n茂苑却寻花气歇，家山重上桂阴疏。\n弦歌莫叹浮湘远，才是青云举足初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题黄氏閒宴阁","author":"胡宿","text":"翚飞迢递拂秋槎，宴坐尘清道有芽。\n五叶对僧谈妙果，一枪留客试真茶。\n檐前暮景沈归鸟，窗外晨晖泛早霞。\n衍箧文多休寄傲，月间芳桂正窅窊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邃卿馆中晚入","author":"胡宿","text":"铜狄严扉大帝家，雨回天气湛春华。\n墙头落景半规日，楼外馀晖几叠霞。\n风近天渊闻斗鸭，烟开宫树见栖鸦。\n端门漏密长廊静，时见香英坠砌花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梅监丞宰山阴","author":"胡宿","text":"春半朱航拂水轻，季圭佳邑得时英。\n民淳定见蹊田默，岁稔仍占射的明。\n太史旧游书穴邃，右军残迹墨池平。\n何妨公外寻僧社，琴鹤相随雅有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送集贤李学士赴荆台","author":"胡宿","text":"蓬岛回风此再来，当年俱重辑宁才。\n芝随禁掖新泥熟，桃应仙源旧路开。\n金契旋闻临外阃，云屏仍是接中台。\n专城四十前贤事，期岁行归妙一台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子庄见求近诗以一阕为介","author":"胡宿","text":"半纶祗役谢英游，牒诉装怀思若抽。\n铜钵任敲何所得，铁盂虽缺岂销忧。\n楚囚操乐宁忘本，蜀客摛辞祇傍愁。\n强抉巴音还首鼠，知君诗户敌千侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张从事","author":"胡宿","text":"月毫挥檄愈头风，屈佐初宾位未充。\n金玉擅珍须席上，蛟龙为物起池中。\n丛云绚彩人歌舜，绵竹摛辞客荐雄。\n一乘追锋看赐对，虎贲千戟照琼宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"胡宿","text":"老矣求田鱼稻乡，儿孙常要在余旁。\n提篮买菜须灵照，举案齐眉只孟光。\n医国有方三折臂，扣关无路九回肠。\n紫芝白发秋风里，怅望商山绮与黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子高秦州从事","author":"胡宿","text":"雪里诗筒至自秦，仲宣佳句乐从军。\n谷莺渐喜迁高处，塞雁犹嗟失故群。\n北阙旧游孤似月，西州回望远如云。\n一枝春色无由寄，手弄梅花却自薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和曼卿馆中夜直","author":"胡宿","text":"右银台路逼仙盘，有客通中此宿官。\n钧奏暗惊天上近，霞杯难制月边寒。\n风来禁树龙传点，露下高梧凤戢翰。\n更听建章鱼钥动，水苍朝佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"远思","author":"胡宿","text":"一片平芜百尺楼，阑干横绝点清秋。\n三年字与燕鸿断，千里心随桂水流。\n空对霜葭惊远别，忍题云叶寄牢愁。\n骊驹不见西曛迫，目眩天涯片席收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邃卿寒直","author":"胡宿","text":"子门肃唱彻周庐，甲夜轻寒腊破初。\n树底倦飞还类鹊，斋中酣梦欲成鱼。\n三钟赋粟才无取，五饵干时策已疏。\n天禄旧来名寂寞，更堪窗雪照残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日山阳驿作","author":"胡宿","text":"飘泊年来憩下亭，雀罗秋静掩苔扃。\n拂窗红叶欺閒卧，倚槛黄花笑独醒。\n盛忆林泉羞白石，欲持香火访丹经。\n华阳小隐平生愿，可分区区事挈瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵宗道归辇下","author":"胡宿","text":"沿牒相逢楚水湄，竹林文酒此攀嵇。\n半毡未暖还伤别，一臂初交未解携。\n江浦呕哑风送橹，河桥勃窣柳垂堤。\n明年四月秦关到，洗眼扬州看马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送天章王待制再领陕州","author":"胡宿","text":"爱树重攀隔十春，召南遗俗至今淳。\n车边野鹿依明府，池上沙鸥识主人。\n太华远峰扪日驭，洪河高派落天津。\n壶浆竹马参歌舞，顿觉城中喜气新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏鹤","author":"胡宿","text":"独立青田刷羽仪，朱研丹顶雪裁衣。\n赋来自合凌清汉，仙去何曾识令威。\n松盖露寒应有恨，蓬山云断未成归。\n旧巢寄在三珠树，待与还丹作使飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旧将","author":"胡宿","text":"曾上燕然勒汉兵，白头麟阁见仪形。\n三朝自是山西将，百战曾焚老上廷。\n已奉列侯归北第，更筹深策破先零。\n弯弓击剑平生事，不许儿孙授一经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"胡宿","text":"孔雀南来燕子西，银河消息已惊迟。\n石城仙使飞三足，玉殿华灯焰九枝。\n暂掩星机同一笑，却披云幄重相离。\n杞天长在年梭疾，若比人间是远期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宛陵秋晚","author":"胡宿","text":"谁道江南好物华，江南今日抵天涯。\n秋风只解吹桐叶，暮雨还来打菊花。\n寒水答砧偏响亮，迥楼飘角更呕哑。\n举头试作长安望，惆怅青山绕郭斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海上","author":"胡宿","text":"天幕纷纭海水浮，日车东上恶埃收。\n金钩欲下灵鳌怖，铁网将沈宝树愁。\n自昔神仙尝有药，从来银阙不通舟。\n燕酣餐尽蟠桃熟，会约琴高控鲤游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日舟行","author":"胡宿","text":"箭激云樯五两轻，波光飞入射桃笙。\n山眉远映群鸥过，霞绮新和落照明。\n甘醴更无消暑意，文竿徒有羡鱼情。\n飘飖若得乘羊角，直待银潢上玉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕解元江阴礼席","author":"胡宿","text":"玉人仍是紫芝眉，五世嘉占得凤飞。\n果满车中潘令去，马盘楼下庾郎归。\n东床寄傲便便腹，北路腾装粲粲衣。\n九烛夜堂开喜宴，画鸾交扇接香帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送祝熙载赴金华主簿","author":"胡宿","text":"数路收才汉得人，物涂聊试半通纶。\n宸廷唱第瑶光近，仙简刊名玉字新。\n芳桂行吟关外月，香葩回梦苑中春。\n平时官下文移少，日涉閒园戏綵频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟","author":"胡宿","text":"瑟瑟凉波冷接空，恍疑云物画屏中。\n一篙海客乘槎水，两桨仙人取箭风。\n秋色暗欺荷盖紫，夕阳偷射桂旗红。\n长来此地无穷乐，珍重笭箵与钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王龙图硕赴荆南","author":"胡宿","text":"南部行台驻万兵，绣衣归路有光荣。\n鸣铙虎豹林中避，吹角蛟龙水底惊。\n湘树远从湖外出，峡云时向马前生。\n主人落笔多风调，应唱新辞遍郢城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈铎归吴兴","author":"胡宿","text":"六篇高论吐虹霓，报罢扁舟击汰归。\n地上麒麟须远到，天边鹰隼且卑飞。\n秋来苕下醪醅熟，寒去江头脍缕肥。\n莫叹隋和犹未售，玉蟾濡翰待君挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题雄州宴射亭","author":"胡宿","text":"北压三关气象雄，主人仍是紫髯翁。\n樽前乐按摩诃曲，塞外威生广莫风。\n龙向城头吟画角，雁从天末避雕弓。\n休论万里封侯事，静胜今为第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴江知县陈著作","author":"胡宿","text":"南望湖山画一屏，松江江水向人清。\n何如嵔?聊为活，况是潇湘谩得名。\n双桨有时青翰远，两衙无事素琴横。\n遥知惠政通和气，乳雉驯鸥自不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠华阳道士朱尊师","author":"胡宿","text":"却饵英芝养道芽，赤霄曾辗绛云车。\n眼看碧海成夷路，心记蟠桃结实花。\n东府灵方修白石，上清香饭给胡麻。\n两双条脱皆金玉，可是南山萼绿华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲夏有感","author":"胡宿","text":"误逐时英落彀中，拙艰为吏悄无悰。\n鶢鶋已享鸣钟赐，澼絖焉知裂地封。\n西北晚云长望阙，东南春亩久抛农。\n匆匆禹凿当年事，犹待神雷起蛰龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元禁乐","author":"胡宿","text":"此夜重城凤脑寒，放游车马接通阛。\n汉祠歌罢天坛冷，钧奏声沈帝所閒。\n红蜡枉残春色里，青楼空占月明间。\n仙壶定有寻芳处，公子雕鞍两两还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬离京师","author":"胡宿","text":"雪中愁买出关符，又著青衫事府趋。\n燕市有金还贵马，邓林无树可栖乌。\n鸱夷痛饮倾家酿，如意狂歌缺唾壶。\n朝野多欢天子圣，目瞻东阙步踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感旧","author":"胡宿","text":"万里青云未致身，马蹄空踏几年尘。\n曾迷玉洞花光老，却过金城柳色新。\n粉壁已沈题凤字，酒垆犹记姓黄人。\n坞中横吹偏多感，一涕阑干白角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落叶","author":"胡宿","text":"霜华昨夜拂秋林，翩落纷纷不自禁。\n清吹无时来槛底，紫苔相伴住墙阴。\n空馀倦鹊求枝宿，更剩残蜩抱朴吟。\n万物归根真趣在，却缘江月识禅心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞将","author":"胡宿","text":"曾从嫖姚立战功，胡雏犹畏紫髯翁。\n雕戈夜统千庐会，缇骑秋畋五柞宫。\n后殿拜恩金印重，北堂开宴玉壶空。\n从来敌国威名大，麾下多称黑槊公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公子","author":"胡宿","text":"北第当衢戟有衣，巾帷鲜媚仆如犀。\n万钱供箸鸣钟沸，三组垂腰佩玉低。\n座上赋鹦穷处士，楼前盘马小征西。\n去天尺五城南路，此去青云别有梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古别","author":"胡宿","text":"长道何年祖軷休，风帆不断岳阳楼。\n佳人挟瑟漳河晓，壮士悲歌易水秋。\n九帐青油徒自负，百壶芳醑岂消忧。\n至今长乐坡前水，不啻秦人怨陇头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"函谷关","author":"胡宿","text":"天开函谷壮关中，万古惊尘向此空。\n望气竟能知老子，弃繻何不识终童。\n谩持白马先生论，未抵鸣鸡下客功。\n符命已归如掌地，一丸曾误隗王东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"塞上","author":"胡宿","text":"汉家神箭定天山，烟火相望万里间。\n契利请盟金匕酒，将军归卧玉门关。\n云沈老上妖氛断，雪照回中探骑还。\n五饵已行王道胜，绝无刁斗至阗颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘夫人祠","author":"胡宿","text":"翠华独去苍梧野，红袖同沈楚水濆。\n休把兰汤招怨魄，空留竹泪忆明君。\n风前有恨啼湘瑟，天外无言拟峡云。\n不比石城双姊妹，帝家釐降有遗文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐客旧居","author":"胡宿","text":"鹄版飞书到此山，海簪重拾更弹冠。\n畹中纫佩荒兰叶，石上移文蠹藓瘢。\n蕙帐烟空胎化老，柏庭风起麝香寒。\n至今门外潺湲水，疑是幽人赋考槃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题公仪西溪","author":"胡宿","text":"山公休爱习家池，自有清光滟一溪。\n川上好风跳鰋鲤，波中晴日浴凫鹥。\n孤舟小屿閒如画，钓线轻缗静可携。\n更助吟毫无限思，落霞犹共夕阳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送庄贤良权之归旧隐","author":"胡宿","text":"过我东还鉴水湄，傥逢亲友话襟期。\n书钳纸尾丞真负，易在床头叔自痴。\n破廨数间将整整，践更三载且迟迟。\n督邮少屈吾衰矣，三径归来未有资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送向馆使赴陕郊","author":"胡宿","text":"陕服由来二伯居，使君新诏拥犀渠。\n门连象魏施行马，地控崤函佩左鱼。\n世德高华河里旧，土风淳厚召南馀。\n政成期月须严召，行见追锋走传车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送江宁监军李舍人归阙","author":"胡宿","text":"假节弥年去玉墀，星邮传诏紫芝泥。\n帐中密印交龙虎，麾下全军解水犀。\n仙阙归心春桨快，石城离思晚云低。\n宣平贵里天姻盛，竞爽行看对析圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送魏屯田出守山阳","author":"胡宿","text":"左台分契领东麾，入奏清厢几刻移。\n三采绶章秦服志，两轓朱色汉官仪。\n雌堂夕宴沈宾辖，绿野春耕驻使旗。\n盘错寄才知不久，英舆六尺待飞绥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和承旨尚书观春物欣盛之什 其一","author":"胡宿","text":"紫陌年光天上回，东风吹雪放新梅。\n燕鸿却背南云去，楚鸟还迎社日来。\n半绿萍醅浮腊脚，残红桃艳弄香腮。\n山公知有登高兴，樽下容谁献寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和承旨尚书观春物欣盛之什 其二","author":"胡宿","text":"书观春归雪意残，三竿初日照天关。\n鱼声稍喣芳塘面，鹊语频跳碧树间。\n渠落禁中听御水，阁凭空际数前山。\n柳黄梅白东郊近，未得携壶一日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江城春日","author":"胡宿","text":"暮春江色映芳菲，雨后清和满客衣。\n游骑自穿官柳去，落霞常伴彩桡归。\n锦鳞劈浪深深跃，翠羽迎风两两飞。\n因下短亭犹惜别，万枝香雪在蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张著作任蕲水","author":"胡宿","text":"家世南州擅席珍，斗城倾盖底相亲。\n诛茅三径原同闬，枕水双扉重作邻。\n翰墨初通文苑职，弦歌聊嗣武城人。\n楚词旧学精章句，未得金门荐买臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春卿学士登定力寺北阁兼寄绛倅富彦国监丞","author":"胡宿","text":"玉山偷暇访禅扉，洛社诸英昔所依。\n三凤同时翔仞去，二龙相继得标归。\n砚池终岁贪残墨，讲树经秋长旧围。\n更待碧纱笼美句，始惊韦布有光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李留后赴天平","author":"胡宿","text":"留印高提驾伏熊，郓城襟要此临戎。\n四封土俗弦歌盛，九叠霜天鼓角雄。\n风月静归谈笑内，山川遥入抚绥中。\n居多暇日溪堂胜，不废投壶与钓筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄浙漕晋卿李工部","author":"胡宿","text":"名臣分刺十三州，君在东南第一流。\n郡国成风皆自化，朝廷安枕更无忧。\n江湖莫作多时计，山水何妨暇日游。\n谁与二天相对饮，看看八月弄涛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送兵部陆学士赴漕闽中","author":"胡宿","text":"宣风一面得瓯闽，丹舸乘流破月痕。\n玉色暂辞当牖坐，衣香初隔止车门。\n帝台回望相竿远，仙峤重过射的存。\n曾颂天禧金石刻，定应宽利赋朝恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杜伟长学士赴漕河北","author":"胡宿","text":"甘陵孤垒起纤埃，趋诏东南武库来。\n天子此时知国器，生民从古寄贤才。\n神锋立断无留刃，筹笔先机有疾雷。\n行见司徒封露布，邺城歌舞夹行台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陆兵部赴漕湖南","author":"胡宿","text":"甘泉司计署名高，出拜行台帝綍褒。\n使节远笼三壤赋，官仪清坐七兵曹。\n时平汉斧宣威力，岁稔湘帆缮贡劳。\n秋晚洞庭山水秀，定知怀古费宫毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送御史蒋公赴漕江东","author":"胡宿","text":"簪笔天阶柱下官，孤风凛凛振台端。\n坐曹常佐甘泉计，奏事曾纡武帐冠。\n一日雕龙分使节，几年骢马避朝鞍。\n商功未是须贤地，荷橐行归侍玉銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送石舍人得告展省","author":"胡宿","text":"先贤富贵重夸乡，况复哀荣感履霜。\n三最诏书新予告，九原恩泽远生光。\n老人竞醉金钱少，稚子争牵玉佩长。\n荀令池头芳树在，栖鸡浴凤日相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送石舍人入西阁见紫薇花盛开","author":"胡宿","text":"西台重见紫薇花，天上时时好物华。\n人向药阶升禁掖，路从桃水入仙家。\n香英半落风前酒，高艳遥烘日际霞。\n却忆后斋浓睡觉，芝泥初熟午阴斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒蝉","author":"胡宿","text":"槁叶惊秋树幄稀，嘶蝉犹尚警寒枝。\n玉琴可要传深恨，珠露何妨剩荐饥。\n已伴风筝流远韵，更邀霜籁散馀悲。\n清漳病枕无悰久，月夕烦君住少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三衢道中马上口占","author":"胡宿","text":"短亭疏柳映鞦韆，马上人家谷雨前。\n几树枪旗茶靃靡，一溪鳞甲水潺湲。\n莺期别后闻馀哢，蚕候归来见小眠。\n可惜西湖湖上月，夜来虚过十分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张待诏知越州","author":"胡宿","text":"长安厩吏驭花骢，竹使遥分浙水东。\n远势早推贤相子，任诚真有古人风。\n稽山一镇居封内，阿阁三休耸禁中。\n长乐钟声偏怨别，何时同谒建章宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]