[{"title":"山上有白云","author":"邹登龙","text":"山上有白云，浮阴翳阳光。\n亭亭飒缤纷，出岫高飞翔。\n飞翔长在望，远匪千里隔。\n莫以秋风来，吹散无踪迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"从军行","author":"邹登龙","text":"年少良家子，投身事西北。\n金鸣斗马嘶，萧萧短兵发。\n夜战祁连山，断甲溅腥血。\n番部带箭降，番酋连阵没。\n勒功纪燕然，椎鼓归汉阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"关山月","author":"邹登龙","text":"行人十年归不得，夜上戍楼看明月。\n楼中星斗连太白，楼外关山雁飞绝。\n雁飞绝，归不得，镜里青蛾怨离别。\n前年出幽燕，明月何团圆。\n去年上祁连，明月复婵娟。\n月明照我长枕戈，胡儿未灭将柰何。\n凭谁寄书问常娥，征衲不来霜霰多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚怀愚斋赵叔愚壶山宋谦父","author":"邹登龙","text":"忽忽岁将暮，烈烈北风凉。\n霏霏雨素雪，皎皎南枝芳。\n懆懆念良友，茕茕在他乡。\n盈盈一水隔，迢迢道路长。\n悠悠无信音，戚戚重感伤。\n翩翩化双鹤，去去与同翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"巫山高","author":"邹登龙","text":"巫山巃嵷巫峡曲，一十二峰浅凝绿。\n老猿化石悬巅崖，矗矗陵云扫坛竹。\n九灵少女列仙从，佩玉鸣銮乘綵凤。\n飞魂走魄归瑶宫，紫箫吹断荆王梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步出城东门","author":"邹登龙","text":"步出城东门，与子各执手。\n遥望冢累累，悲风发陇首。\n长松自青青，枯根带骨朽。\n人生如朝露，嘉命那可久。\n世无王子乔，何诀以固寿。\n感慨徒悲伤，欢言且饮酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏怀","author":"邹登龙","text":"洪河相绵缠，嘉宅良可卜。\n苍松荫长蹊，丛梅馥四屋。\n过庭白水流，飞鸣漱寒玉。\n游目俯灵景，抱杖委繁俗。\n长吟畅幽怀，理琴展清曲。\n岂不企淩厉，而乃伤局促。\n吉士抗遐踪，幽幽聚灵族。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲","author":"邹登龙","text":"平湖淼淼莲风清，花开映日红妆明。\n一双鸂鶒忽飞去，为惊花底兰桡鸣。\n兰桡荡漾谁家女，云妥髻鬟黛眉妩。\n采采荷花满袖香，花深忘却来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青楼曲","author":"邹登龙","text":"青楼女儿十五六，翠掠云鬟妙装束。\n千金学舞拜部头，新来教得凉州曲。\n锦鞯少年被花恼，醉把金钗换香草。\n西风楼前秋雁飞，舞衣狼籍花颠倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜长曲","author":"邹登龙","text":"碧帘挂雨秋容老，寂寞江城暝烟草。\n流苏帐冷屏山低，蜜炬香销睡常早。\n梦惊离绪牵愁入，翠被寒侵泪花湿。\n思美人兮天一方，乌啼月落西风急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜怀菊山沈庄可","author":"邹登龙","text":"凉风动金旻，奄忽寒节至。\n百卉俱萎垂，梧桐亦飘坠。\n明月入我牖，展转不能寐。\n顾影重伤心，思君长下泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结客少年场","author":"邹登龙","text":"并儿任气侠，年少肝胆雄。\n锦臂金弹丸，银鞍玉花骢。\n腰插三尺剑，手开二石弓。\n轻生重大义，一战朔庭空。\n斩取戎王头，捷奏甘泉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪霁梅月曲","author":"邹登龙","text":"羌玄圃兮玉英，蹇冰轮兮太清。\n猗缟袂兮谁子，粲一笑兮倾城。\n倚横吹兮寄哀思，揽幽香兮补骚情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游仙","author":"邹登龙","text":"人命如朝露，寿非金石坚。\n安得傅六翮，飘飘凌紫烟。\n夕梦一道士，羽衣何翩跹。\n邀我与之去，同上扶桑巅。\n道遇青童君，授以东华篇。\n读之三百遍，忽若骨已仙。\n道士复谓我，玄诀未可传。\n赐我以琼浆，饮之享遐年。\n明发寂无睹，孤鹤翔九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹山","author":"邹毅","text":"白云深处到林丘，曹洞根深地更幽。\n圣隐岩前山杳杳，回龙亭下水悠悠。\n凉侵客枕秋风活，光抱禅关桂影秋。\n尘足未堪康乐屐，得閒聊伴省郎游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居寓兴","author":"邹輗","text":"花阴不正月将西，欲到溪边步懒移。\n坐对前山无一语，此心惟有古人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒毛竹间先生","author":"邹輗","text":"不辱其身不辱亲，要明圣学尽人伦。\n岂为媚世文章士，养就中和万古春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道谒朱晦庵先生 其一","author":"邹輗","text":"武夷洞前皎月生，归人近得坦途行。\n阴霾涤尽无纤翳，远彻乾坤一样明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道谒朱晦庵先生 其二","author":"邹輗","text":"野意凄凉远俗情，出门一笑乱山青。\n痴儿白昼犹鼾睡，可是无人会唤醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题读书林","author":"邹輗","text":"诸君著意读书林，好去鸢鱼个里寻。\n不必浪浮空记诵，且须识取各人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书刘定夫诗轴","author":"陆九渊","text":"人生不更涉，何由知险艰。\n观君一巨轴，奚啻百庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送德麟监院归天童和杨廷秀韵 其二","author":"陆九渊","text":"闻说淮民未免饥，春头已掘草根归。\n羡君稛载还山去，要挟星郎大字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送德麟监院归天童和杨廷秀韵 其一","author":"陆九渊","text":"尽道吾庐登陟难，上人得得到相看。\n莫言无物堪延待，也有茶浇舌本乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻莺","author":"陆九渊","text":"百喙吟春不暂停，长疑春意未丁宁。\n数声绿树黄鹂晓，如笑从前著意听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春出箭溪 其二","author":"陆九渊","text":"长蹊窈窕晴沙暖，绿树交加细草香。\n归去不缘吾兴尽，月明应得更褰裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春出箭溪 其一","author":"陆九渊","text":"晴云冉冉薄斜晖，春静衡门半掩扉。\n风入墙头丹杏晚，高枝频飐乱花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简朱干叔诸友","author":"陆九渊","text":"利名风浪日相催，青眼难于世上开。\n何事诸君冒艰险，杖藜来入白云堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝉","author":"陆九渊","text":"风露枯肠里，宫商两翼头。\n壮号森木晚，清啸茂林秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题达本庵","author":"陆九渊","text":"孩提无不爱其亲，不失其心即大人。\n从此劝君休外慕，悦亲端的在诚身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题慧照寺","author":"陆九渊","text":"春日重来慧照山，经年诗债不曾还。\n请君细数题名客，更有何人似我顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠画梅王文显","author":"陆九渊","text":"子作寒梢已逼真，不须向上更称神。\n由来绝艺知音少，只恐今人过古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过普宁寺","author":"陆九渊","text":"偶扶藜杖过南津，野寺长桥发兴新。\n暂就清溪照须鬓，不妨翠雾湿衣巾。\n山萦细栈疑无路，树络崩崖不压人。\n朝暮有程常卒卒，向因携酒上嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏侍长上郊行分韵得偕字","author":"陆九渊","text":"讲习岂无乐，钻磨未有涯。\n书非贵口诵，学必到心斋。\n酒可陶吾性，诗堪述所怀。\n谁言曾点志，吾得与之偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨廷秀送行","author":"陆九渊","text":"学粗知方耻为人，敢崇凶貌蚀诚真。\n义难阿世非忘世，智不谋身岂误身。\n逐遇宽恩犹得禄，归冲腊雪自生春。\n君诗正似清风快，及我征帆故起蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄司业喜雪","author":"陆九渊","text":"畴昔诗囊未破悭，琼瑰益自倍枵然。\n才华甘落诸公后，诚实徒居野老前。\n腊雪晚成春雪早，梅花静对雪花妍。\n从今长作丰登瑞，廪庾家家赡九年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨园四题 其四","author":"释居简","text":"直从平地矗崔嵬，南向群山斗次来。\n尽此半春留客醉，莫愁一日不花开。\n水从绿野前头绕，竹向芳菲缺处栽。\n目送断鸿天外去，问它更是几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张正应","author":"陆九渊","text":"海门昼夜吼奔雷，却立吴山亦壮哉。\n前殿神仙三岛邃，正门阊阖九天开。\n玉阶恭授大官赐，象简亲承御墨回。\n多少箪瓢蓬瓮士，输君留宿两宫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游湖分韵得西字","author":"陆九渊","text":"命驾不辞春径泥，少蓬高会帝城西。\n物非我辈终无赖，书笑蒙庄只强齐。\n天入湖光随广狭，山藏云气互高低。\n谁怜极目茭刍里，隐隐苍龙卧古堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹅湖和教授兄韵","author":"陆九渊","text":"墟墓兴哀宗庙钦，斯人千古不磨心。\n涓流积至沧溟水，拳石崇成泰华岑。\n易简工夫终久大，支离事业竟浮沈。\n欲知自下升高处，真伪先须辨古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"少时作","author":"陆九渊","text":"从来胆大胸膈宽，虎豹亿万虬龙千，从头收拾一口吞。\n有时此辈未妥帖，哮吼大嚼无毫全。\n朝饮渤澥水，暮宿昆崙巅。\n连山以为琴，长河为之弦。\n万古不传音，吾当为君宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉芝歌","author":"陆九渊","text":"灵华兮英英，芝质兮兰形。\n琼葩兮瑶实，冰叶兮雪茎。\n石室兮宛宛，苔茵兮菁菁。\n阴长松之偃蹇，带飞瀑之琮琤。\n实青端而黄表，眇中藏而不矜。\n匪自昭其明德，羌无愧兮畴能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访余昌言不遇留题","author":"陆九渊","text":"蹇驴清晓破平芜，来访故人村外居。\n门掩却寻山背路，堂虚惟阅案头书。\n不知车马从何往，借问僮奴归得无。\n留待西风日停午，只听松竹响萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应天山","author":"陆九渊","text":"我家应天山，山高数万丈。\n上开园池美，林壑千万状。\n山西有龙虎，烟霞耿相望。\n寒清漾微波，暖翠团层嶂。\n天光入行舟，野色随支杖。\n吾党二三子，幽赏穷清旷。\n引兴谷云边，题名岩石上。\n碧桃吹晓笙，白鹤惊春涨。\n一笑咏而归，千载应可尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送勾熙载赴浙西盐","author":"陆九渊","text":"平分浙江流，东境浮海角。\n其民仰鱼盐，久已困征榷。\n麦禾与桑麻，耕锄到峣埆。\n往岁比不登，场圃几濯濯。\n荒政劳庙谋，赈廪开数数。\n饥羸不待饱，共感君泽渥。\n仁哉覆育恩，所恶吏龌龊。\n教诏弥谆谆，听受祇藐藐。\n何知国与民，足己肆贪浊。\n流离且未还，已复事椎剥。\n按察殊未曾，圣主独先觉。\n重贻宵旰忧，顾盼求卓荦。\n君固岷峨英，怀抱富荆璞。\n迩来奏对语，朝阳鸣鷟鸑。\n锵然历帝聪，简记谅已确。\n外台适虚席，妙选出亲擢。\n此节岂轻受，委寄重山岳。\n除音九天下，众论靡瑕驳。\n揽辔首越山，青萍方在握。\n送君无杂言，当不负所学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽石子重","author":"陆九渊","text":"古重百里长，寄命谋托孤。\n今以京秩授，糜至无贤愚。\n州家督版帐，殿最视所输。\n况乃积弊久，宿负堆文符。\n老奸乘仓皇，阴拱为师模。\n民穷敛愈急，吏饱官自癯。\n天子为焦劳，宵旰思良图。\n高选部使者，庶使德意敷。\n石君在荐剡，闻者皆欢愉。\n不知何方民，凋瘵迟君苏。\n君丞固安日，岁旱当蠲租。\n县白如故事，守怒牢睢盱。\n赖君争之力，意得所请俞。\n揭数授里正，俾后不可渝。\n又尝宰尤溪，吏辈初窥?。\n首以财匮告，欲辟侵民途。\n君乃治税籍，弊蠹穷根株。\n简易以便民，上下交相孚。\n民自不忍负，岂复烦催驱。\n关征且损数，孰谓儒术迂。\n使家得此人，黄屋何忧虞。\n惜哉不及用，重使吾嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"疏山道中","author":"陆九渊","text":"村静蛙声幽，林芳鸟语警。\n山樊纷皓葩，陇麦摇青颖。\n离怀付西江，归心薄东岭。\n忽念饥歉忧，翻令发深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠化主","author":"陆九渊","text":"学佛居山林，往往仪状野。\n道人翩然来，礼节何尔雅。\n职事方悯悯，言论翻洒洒。\n安得冠其颠，公材岂云寡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子规","author":"陆九渊","text":"柳院竹斋茅店，云芜风树烟溪。\n听彻残阳晓月，不论巴蜀东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莺","author":"陆九渊","text":"巧啭风台急管，清逾石涧回溪。\n好去枝枝惊梦，无人心到辽西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道间示德甫德称","author":"陆九龄","text":"天地中间本自宽，何须特地起无端。\n更宜顿扫从前事，相与携筇一笑欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹅湖示同志","author":"陆九龄","text":"孩提知爱长知钦，古圣相传只此心。\n大抵有基方筑室，未闻无址可成岑。\n留情传注翻榛塞，著意精微转陆沉。\n珍重友朋勤切琢，须知至乐在于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与僧净璋","author":"陆九渊","text":"自从相见白云间，离聚常多会聚艰。\n两度逢迎当汝水，数年隔阔是曹山。\n客来濯足傍僧怪，病不烹茶侍者閒。\n不是故人寻旧隐，只应终日闭禅关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早过何郎","author":"陆九龄","text":"萧萧风雨晓篮舆，没胫泥深我仆痡。\n却忆去年苗欲槁，任从行李且虚徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月石","author":"陆九韶","text":"玉兔爱佳泉，饮泉化为石。\n规圆立山趾，万古终不息。\n应厌旧星躔，盈稀多缺夕。\n自从寄兹踪，表表无晦蚀。\n光彩虽暂埋，体素得不易。\n神物岂终潜，早晚照九域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试茗泉","author":"陆九韶","text":"邂逅成山行，往往有异景。\n奇峰争呈露，独不见试茗。\n逶迤即道周，澄泓得幽井。\n淆之不可浊，凝然如自省。\n龟蒙于越来，傥亦煮石鼎。\n岂为渴者甘，醉梦当一警。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸣玉泉","author":"陆九韶","text":"朅来坐幽亭，恍在昆山曲。\n清越声盈耳，群工琢良玉。\n又疑跻金阙，仙班佩相属。\n圆环碎琼琚，登降互击触。\n洒然襟袍爽，无处著利欲。\n不贪以为宝，对此景高躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子弟词 其二","author":"陆九韶","text":"听听听听听听听，衣食生身天付定。\n酒肉贪多折人寿，经营太甚违天命。\n定定定定定定定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子弟词 其四","author":"陆九韶","text":"凡闻声，须有省。\n照自心，察前境。\n若方驰骛速回光，悟得昨非由一顷。\n昔人五观一时领。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子弟词 其一","author":"陆九韶","text":"听听听听听听听，劳我以生天理定。\n若还惰懒必饥寒，莫到饥寒方怨命。\n虚空自有神明听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫子弟词 其三","author":"陆九韶","text":"听听听听听听听，好将孝弟酬身命。\n更将勤俭答天心，莫把妄思损真性。\n定定定定定定定，早猛省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跃马泉","author":"陆九韶","text":"灵泉蓄幽愤，跃石作良马。\n奔腾曳练驶，追风非汎驾。\n行健石有迹，气骄珠汗洒。\n何当奋厥志，万骑阴山下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄陵庙","author":"陆士规","text":"东风吹草绿离离，路入黄陵古庙西。\n帝子不知春又去，乱山无主鹧鸪啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇后阁春帖子","author":"陆升之","text":"内仗朝初退，朝曦满翠屏。\n砚池浑不冻，端为写兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"陆世良","text":"七相声名俱属此，尚期他日更添君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古意","author":"陆正","text":"结缡事君子，誓作形与影。\n人事多乖戾，彼此睽燕郢。\n尺书沉素鳞，啼鹃催逝景。\n妾命讵终薄，君心那得冷。\n开帘花扑面，泪落纷如绠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江城子","author":"陆汉广","text":"绿莺庭院燕莺啼。\n绣帘垂。\n瑞烟霏。\n一片笙箫，声过彩云低。\n疑是蕊宫仙子降，翻玉袖，舞瑶姬。\n冰姿玉质自清奇。\n看孙枝。\n列斑衣。\n画鼓新歌，喜映两疏眉。\n袖里蟠桃花露湿，应不惜，醉金卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湟川","author":"陆节","text":"从来瑰异产天涯，土物人风分外嘉。\n愿写湟川川上景，与君传入凤池誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":4300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]