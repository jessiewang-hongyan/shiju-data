[{"title":"偈颂十五首 其九","author":"释宝印","text":"说法不劳三寸舌，参禅惜取两茎眉。\n玉栏干畔青青柳，最好人间二月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其五","author":"释宝印","text":"前箭射人可，后箭射人深。\n钟先生没后，此道少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其一","author":"释宝印","text":"遍地残红春去也，拍天涨绿兴悠哉。\n道人觅甚安心法，达磨当时带不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其十八","author":"释宝印","text":"生铁铸就昆崙儿，眼耳鼻舌如泥块。\n西天此土谩纷纭，铁眼铜睛看不破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其十三","author":"释宝印","text":"李公要劝张公酒，却被张公罚一杯。\n珠绕团团休错会，还家拍手笑哈哈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其十","author":"释宝印","text":"不疑不彻不失，片片春风狼籍。\n至今江北江南，游子徒劳外觅。\n休外觅，明如杲日黑如漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其六","author":"释宝印","text":"临济惯白拈，普化惯掣颠。\n一场好笑具，后世作三玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其四","author":"释宝印","text":"竖起拂子封白纸，千里谁知有知己。\n行人莫与路为雠，四海五湖王化里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释宝印","text":"将心除妄妄难除，即妄明心道转迂。\n桶底趯穿无忌讳，等闲一步一芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释宝印","text":"日上月下，速如电毂。\n又是重新，一阳来复。\n湛不摇处，暖生寒谷。\n篱落梅华，枝枝粲玉。\n贺客街头，亚肩叠足。\n借婆裙子拜婆年，不识本来真面目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十四","author":"释宝印","text":"浮玉山头留不住，相携夜过长芦渡。\n识得诸方第一机，踏翻船子先归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十三","author":"释宝印","text":"胡张三，黑李四。\n不会禅，不识字。\n蓦然相见闹篮头，话尽平生各归去。\n十日雨，五日风，讴歌鼓舞乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十一","author":"释宝印","text":"律身行业凛冰霜，接物机关走雷电。\n七千馀指渴思浆，愿为重提正法眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十","author":"释宝印","text":"何似生，合取口，三世诸佛不知有。\n日午打三更，面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其八","author":"释宝印","text":"雨足敛烟云，山晴开锦绣。\n良哉信心人，知有向上窍。\n携家上崔嵬，法席为宏开。\n五百阿罗汉，掷锡与浮杯。\n赴供如云集，寿山增岌岌。\n次男慧性开，念念皆迪吉。\n径山不覆藏，言外要承当。\n风云重际会，归去侍清光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十","author":"释宝印","text":"今年月，去年月，四海九州同皎洁。\n去年人，今年人，鼻孔依前搭上唇。\n只道年年人与月，一回相见一回新。\n或修行，蔌供养，马师鼓起无风浪。\n争如此夜十分圆，人在妙峰孤顶上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其四","author":"释宝印","text":"便是犹陪句，如何已涉言。\n须知言句外，声色不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其二","author":"释宝印","text":"六月初一，烧空赤日。\n十字街头，雪深一尺。\n扫除不暇，回避不及。\n冻得东村廖胡子，半夜著鞋水上立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅林分韵得泽字","author":"释宝印","text":"江路岁峥嵘，酸风更萧瑟。\n发兴访梅花，主盟得诗伯。\n孤芳有馀妍，初不带脂泽。\n香度竹篱短，影摇溪水碧。\n同时饮中仙，著我林下客。\n春槽沸滴红，满坐喧举白。\n浇胸独茗碗，臭味曾不隔。\n公今日边去，陛下正前席。\n请看枝头春，中有和羹实。\n反骚试与题，不碍心铁石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓宿洞霄","author":"释宝印","text":"窈窕门前九锁山，琮琤石角千层水。\n白云影里阅群仙，风断木犀香未已。\n我从青城大面来，羽衣驾鹤欣相陪。\n五峰去此在咫尺，肯惜杖屦时徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其十二","author":"释宝印","text":"何必不必，金刀玉尺。\n甜者如檗，苦者如蜜。\n二十年来，无处雪屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其九","author":"释宝印","text":"忽然不然，如铗如钳。\n神仙秘诀，父子不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其八","author":"释宝印","text":"山之峨峨，水之汤汤。\n冷眼觑著，无处惭惶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其十二","author":"释宝印","text":"初三十一，中九下七。\n众眼难瞒，当机莫惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其七","author":"释宝印","text":"佛高一丈，魔高一丈。\n正觉山前，无风起浪。\n金山个里，佛魔俱丧。\n明星现时，且莫欺诳。\n无牛乳糜，有德山棒。\n为甚如此，真法供养。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十八首 其十六","author":"释宝印","text":"正月孟春犹寒，从头万种千般。\n昨夜虚空落地，和风搭在阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十五首 其六","author":"释宝印","text":"来也宫殿随身，去也笙歌满路。\n侍者白头如新，赵州倾盖如故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释宝印","text":"满屋挂碑光耿耿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康仙祠","author":"释宝玄","text":"南望青山十里赊，五云深处问琵琶。\n从知天子封侯庙，原是神仙卖药家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与应兄之西湖二绝 其二","author":"释宝昙","text":"它日西湖有此僧，年来怕见发鬅鬙。\n一双眸子清于水，想见新诗我不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与应兄之西湖二绝 其一","author":"释宝昙","text":"终日看山唤不回，却如山骨瘦归来。\n白头未老青鞋底，无限江南翠作堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与陈大监乞米","author":"释宝昙","text":"灶间三日怒饥面，老去一豪无木肠。\n走乞毗耶半炊玉，归来作舞绕绳床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹丘春夜感怀","author":"释宝昙","text":"雨歇花梢月正明，一川浑是杜鹃声。\n此身漂泊知何处，蝶与庄周梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上水道中闻莺","author":"释宝昙","text":"人间七月火云升，碧树黄鹂亦可人。\n哑咤一声行道外，不知身在故园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见牵牛花有感","author":"释宝昙","text":"篱落牵牛又著花，摘花心在鬓先华。\n故园红染姜丝在，安得缄封寄客槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出郭闻百舌","author":"释宝昙","text":"故园何事最关春，百舌枝头狎众禽。\n料得万花浑不睡，听渠说尽落星心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史太师入觐赐带以不知官高卑玉带悬金鱼为韵寄呈 其二","author":"释宝昙","text":"老不数汲黯，吾宁师子思。\n黄金复加璧，勿遣虞人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史魏公放鱼","author":"释宝昙","text":"试问恩波几许深，一湖浑是史君心。\n巨鳞细口重相见，雷电成龙去自今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平江灵岩","author":"释宝昙","text":"山断湖光迸一川，老师角黍过年年。\n春风步屧长尘静，只有钟鱼取次传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄晖山水","author":"释宝昙","text":"孤云起木末，翠岫插天半。\n一窗明暗中，乃有此遐观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴化存公作竹林新亭雪庵雪林二老同赋次韵 其一","author":"释宝昙","text":"西舍东邻杼轴空，道人满腹贮清风。\n竹林笑指归来路，约与禽鱼一饱同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴化存公作竹林新亭雪庵雪林二老同赋次韵 其二","author":"释宝昙","text":"年来幽事慰心期，已有溪云彷佛知。\n不似山南似山北，直须拄杖叩门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答吴仲登三绝 其三","author":"释宝昙","text":"屈指何人共此行，凉风佳月可怜生。\n天教两足为吾用，城市山林勿与争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答吴仲登三绝 其二","author":"释宝昙","text":"案上如山一束书，青灯岁月已无馀。\n从来笔同天人事，佛祖如何以货居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"成都信藏主求送行 其一","author":"释宝昙","text":"又得南方一信归，君臣父子却饶伊。\n五年乳窦峰前路，曾把虚空碎一槌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀山行","author":"释宝昙","text":"惯识春山笋蕨甜，祇今病枕亦馋涎。\n杖藜梦入僧窗去，饭饱茶香最可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次史魏公见招","author":"释宝昙","text":"几年全主又全宾，万里归来托此身。\n放出渠侬一头地，始知云月有闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次平元衡菖蒲 其二","author":"释宝昙","text":"细如毛发绿毵毵，寂寞无人共岁寒。\n万壑千岩风雨面，却宜六月坐中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次平元衡菖蒲 其一","author":"释宝昙","text":"祇许春水细有声，不容灯焰恼黄昏。\n是为白石清泉伴，乞与蒲团便垛根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馀姚江上","author":"释宝昙","text":"山入春江雨不收，江寒得傍翠云裘。\n谁家山影风帆转，误作梨花一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"花笑","author":"释宝昙","text":"爱花无处奈花羞，著个东风好诨休。\n不是笑花花自笑，一春几日得迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和史太师蜗室三首 其三","author":"释宝昙","text":"卧听花敷宝篆灰，坐看野马与尘埃。\n有时笑入棋声去，千骑雷奔挽不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和史太师蜗室三首 其二","author":"释宝昙","text":"伊雒閒人晚自贤，等将身世付蹄筌。\n春风犹有耆英会，未必饥餐困即眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和史太师蜗室三首 其一","author":"释宝昙","text":"帐暖窗寒不愿馀，一床翻覆旧时书。\n寸鳞尺渎寻常水，老子而今非故鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡仲方摄县喜雨三首 其三","author":"释宝昙","text":"罢琴听我一言田，民物如苗吏草然。\n中有丰年无限意，何须矫首问云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡仲方摄县喜雨三首 其二","author":"释宝昙","text":"群农已作触藩羊，人语车声日夜忙。\n肤寸出云从北海，十分好句属南昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡仲方摄县喜雨三首 其一","author":"释宝昙","text":"雨入黄梅故弄晴，群龙须我一投诚。\n此无尽藏君为主，大贝明珠我得倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵制干二绝句 其一","author":"释宝昙","text":"四十五里邻近寺，一十八盘容易山。\n竟日篮舆走风雨，七峰峰外见斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵制干二绝句 其二","author":"释宝昙","text":"今年贤弟去贪佛，平日阿兄真爱山。\n肯使道肥诗则瘦，王孙人物未斓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和简斋墨梅二首 其二","author":"释宝昙","text":"风物凋零欲尽年，此花黑瘦固应然。\n暗香疏影浑无赖，为我中分亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和简斋墨梅二首 其一","author":"释宝昙","text":"为怜玉色照前除，一室无因舍静姝。\n寄语客卿烦想像，万花困苦乞为奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和魏公洗砚","author":"释宝昙","text":"麝煤鼠尾要镌汝，颒面沃心谁似吾。\n老子胸中十万读，莫年相喣复相濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉川道中四绝 其二","author":"释宝昙","text":"弹指声中见弥勒，鼓琴安用识昭文。\n青山步障五百里，犹有赠行南北云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉川道中四绝 其四","author":"释宝昙","text":"摘星黄汉在何许，浅水平山容易过。\n未必山灵惯看客，勒回俗驾奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉川道中四绝 其三","author":"释宝昙","text":"夜宿樟林海边寺，海风吹梦五更寒。\n此身不似天涯近，枉作并州老泪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊分水","author":"释宝昙","text":"橹声伊轧诉东风，楚语吴歌落枕中。\n夜半潮头随月上，客帆和梦各西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画水仙梅山樊","author":"释宝昙","text":"生香故触人，异质偶同调。\n唤作黄家花，弟兄一语妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画石菖蒲","author":"释宝昙","text":"太湖与雁荡，相去二千里。\n六月吾几间，风雨一弹指。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊外即事","author":"释宝昙","text":"春水人家绿绕门，晚风榆柳自村村。\n一声牛背乌盐角，铁作行人也断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青奴","author":"释宝昙","text":"青奴初不下房栊，肌骨玲珑雪未中。\n八月华胥人自到，可怜尘壁卧西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒","author":"释宝昙","text":"别院东风料峭寒，春衫已试脱应难。\n黄昏却傍灯归去，缓约花期几日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舣舟南渡有怀","author":"释宝昙","text":"待得潮生已夕阳，药炉无火正凄凉。\n傍人笑指黄金骨，夜半应须解放光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茶香","author":"释宝昙","text":"绕瓯翻雪不须疑，到齿馀香亦解肥。\n鼻观舌根留不得，夜深还与梦魂飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送于制干二首 其二","author":"释宝昙","text":"一笑无烦论古今，就中首肯即吾真。\n君今正与司南合，直指何曾更问人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送于制干二首 其一","author":"释宝昙","text":"十年闲读古人书，不为山川货可居。\n便有风声生屐齿，王侯同在一丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐上人还玉峰二首 其二","author":"释宝昙","text":"西风已挂沐猴冠，人语溪声亦少宽。\n家有如山牛粪火，为君煨栗劝加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送隐上人还玉峰二首 其一","author":"释宝昙","text":"故山为我小迟留，枫落吴江冷不收。\n归去不知身是梦，青灯相对说它州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]