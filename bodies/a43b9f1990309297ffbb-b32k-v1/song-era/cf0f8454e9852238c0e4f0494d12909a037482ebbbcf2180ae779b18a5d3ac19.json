[{"title":"秋日游竹会寺","author":"吴龙翰","text":"修竹阴阴古道场，谁怜兵火地荒凉。\n晚山俱似佛头绿，秋草不如僧发长。\n白酒莫辞今日醉，黄花仍作去年香。\n禅翁留客殷勤甚，相对藤床话夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋崖先生招饮荷葭坞席上赋诗","author":"吴龙翰","text":"相公潭水清于玉，翠屏四面环书屋。\n石梯幽幽登苍崖，老树晴烟千顷绿。\n好花对人无俗姿，春色盈盈囿虚谷。\n归来庭院碧参差，八窗玲珑有脩竹。\n先生长啸临清流，茱萸辛夷香满洲。\n浪呼迪辈偕春游，绿醅深注碧玉瓯。\n我醉起舞相劝酬，愿祝先生相业侔伊周。\n运留侯帷幄之筹，横莱公野水之舟。\n莫负苍生望安石，东山高卧凌清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离怨","author":"吴龙翰","text":"杨柳如少年，春风吹得老。\n朝为白雪花，暮为浮萍草。\n明月照妾夫，夜夜关山道。\n明月分半光，照妾颜色好。\n空闺一十年，芳容秋叶槁。\n宝马嘶，妾夫归，对镜画眉双泪垂。\n前日夫误妾，今日妾误夫，妾貌不如夫去时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦淮 其一","author":"吴龙翰","text":"数里秦淮画轴开，唐人赏后宋人来。\n无边风月要酬答，一处旗亭买一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读家集","author":"吴龙翰","text":"吾家友堂翁，砚影双鬓寒。\n刻志钻书史，篝灯照夜阑。\n学术三代上，文章两汉间。\n胸次秋沆瀣，词吐玉琅玕。\n冤哉命压头，那复博一官。\n二埙策科第，亦不到金銮。\n友堂纷遗稿，几成汲冢残。\n江东兵燹馀，白璧喜重完。\n会当乞鸿笔，清名期不刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚舟过临平","author":"吴龙翰","text":"烟钟舂起夕阳愁，淼淼临平春事幽。\n惟有风蒲爱吟客，岸边缭乱绾行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓兴","author":"吴龙翰","text":"盈盈楼上仙家姝，绿波濯濯明芙渠。\n感君恩情玉连锁，罗襦系君双明珠。\n青琐玲珑春夜永，为君閒调相思引。\n琼树朝新璧月满，琴声未断肠先断。\n剪剪轻寒袭春笋，金猊喷香薰袖暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓感","author":"吴龙翰","text":"周家敦八议，姬旦衡何平。\n秦家尚苛法，四海怨商君。\n凤鸟时一鸣，枭鸟时一鸣。\n一鸣以为周，一鸣以为秦。\n法重灭尔族，德重润尔身。\n天帝厌杀伐，勿使伤阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登宣城郡楼仰谢公","author":"吴龙翰","text":"翠屏四面敞阑干，谢老诗情不说官。\n魂冷青山呼欲醒，吟声渗在石泉间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感兴 其三","author":"吴龙翰","text":"闭门逃俗客，携酒过禅关。\n灶古茶烟断，碑残雨藓瘢。\n秋僧行影瘦，夜鹤病翎寒。\n片月随人到，孤琴对佛弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"数年前有小词微雨后落花天娇态病恹恹怕人猜著是相思镇日不开帘宝钗横蝉鬓乱院宇待人归尽缓移莲步玉阑前纤手掐花钿兹月夜与客饮梅花下一姝歌前词复出笺徵余新作","author":"吴龙翰","text":"月夜梅花下，开樽谁主宾。\n梅花娇欲语，让我白头人。\n娉婷楼上女，无乃花中神。\n下楼款欢笑，莫惜抛千金。\n纤纤出素手，为我弹瑶琴。\n自言谙古调，妾心合君心。\n感君缠绵意，未弹先有情。\n妾佩明月光，妾衣云霞轻。\n共君骖白凤，一息超玉京。\n君看天帝女，嫁与牵牛星。\n天河万里长，鹊桥岁一陈。\n安得河水乾，夜夜长相亲。\n君能挽天河，一洗八极尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楼居狂吟 其八","author":"吴龙翰","text":"胸次玲珑著九垓，政须时复兴崔巍。\n楼高手可扪星斗，移掇天河入酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题国直先伯祖海潮赋后","author":"吴龙翰","text":"银山突兀苍海头，夜半鼓噪万貔貅。\n争雄角力转坤轴，旋磨尘世偕浮沤。\n朝朝暮暮自消长，谁言于此随海鳅。\n鸱革裹尸已尘土，未必怒怨卒未休。\n看公立论屈前辈，笔端有力挽万牛。\n孤峰绝崖气象古，亦复粲粲珊瑚钩。\n分明掘见阴阳根，判断造化之深幽。\n玄机发泄天帝嗔，此文正恐雷霆收。\n不然亦似画鸟迹，长夜鬼哭声啾啾。\n公自骑鲸去不返，满江明月芦花秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"吴龙翰","text":"花列千行彩袖，叶收万斛明珠。\n可惜坡仙不在，风情绝胜西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君怨","author":"吴龙翰","text":"汉家金屋贮娥眉，六宫何啻三千姬。\n中有一姬倾国色，可怜不到君王知。\n毛生笔下真少恩，玉颜黑子迷妍媸。\n君王按图不入眼，出身远嫁单于妻。\n盈盈泪眼边月照，萧萧愁鬓胡风吹。\n不忧死作龙城鬼，贞魂长在深宫里。\n犹胜男儿未贵时，咫尺金门如万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴龙翰","text":"一声欸乃烟波阔，千古离骚日明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴龙翰","text":"天地可呼归舴艋，利名不遣涴笭箵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴龙翰","text":"蜀儒为郡追任昉，歙士呼天借寇恂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢程钜夫学士","author":"吴仲轩","text":"抱疾经年久，何期徵诏临。\n芸窗书已蠹，竹径叶尤深。\n空返皇华使，难忘鸥鸟心。\n怀君虽感激，衰鬓不胜簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴传正","text":"从此天津南畔景，不教都属邵尧夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州 其一","author":"吴充","text":"风力号强明，三朝选寄荣。\n谁非千骑长，独就五羊城。\n仙殿图书掩，山阴父老迎。\n蓬莱登望好，太守擅诗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"召赴资政殿听读诗义感事","author":"吴充","text":"雪销鳷鹊御沟融，燕见殊恩缀上公。\n昼日乍惊三接宠，正风获听二南终。\n解颐共仰天颜喜，墙面裁容圣域通。\n午漏渐长知禹锡，侍臣何术补尧聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史院席上作","author":"吴充","text":"兰台开史局，玉斝赐君馀。\n宾友求三事，规摹本八书。\n汗青裁仿此，衰白盍归欤。\n诏许从容会，何妨醉上车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张君宰吴江","author":"吴充","text":"全吴风景好，之子去弦歌。\n夜犬惊胥少，秋鲈饷客多。\n县楼疑海蜃，衙鼓答江鼍。\n遥想晨凫下，长桥正绿波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州 其二","author":"吴充","text":"曾乘使君马，数上豫章楼。\n北阙领新命，西山追旧游。\n使星催县弩，乡月伴仙舟。\n却顾区区者，风波鬓已秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招题院静照堂","author":"吴充","text":"人说招题好，师从静照来。\n亲携玉堂句，徐叩荜门开。\n好事能如此，题诗岂易哉。\n明年得东守，系舸一徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"众乐亭","author":"吴充","text":"使君新自四明归，邀我同为众乐诗。\n山川可爱惜不见，昼想夕思心为罢。\n恍然神遇若有得，赍身乃在天之涯。\n涨海连空四无岸，天吴却坐鲛人观。\n以手挥弄日月丹，能令桑田变瀰漫。\n海边偶到山城中，山城二月多春风。\n牛羊闲暇夕阳晚，楼阁参差朝雾浓。\n一泓山溜佛头绿，环以翠屏屏六曲。\n人烟扰扰事嬉游，落花啼鸟更汀洲。\n中为台榭斗十二，上有藻井排文楸。\n旁人指点此何许，云是四明行乐处。\n此乐为民非为身，始是集贤钱使君。\n使君风韵谁之比，政事次公诗短李。\n醉凭熊轼劝耕畴，狂取螺杯翻舞袂。\n侬爱使君君勿归，诏书夺之知何为。\n闻侍玉皇香案侧，银台深阻无消息。\n意迷却悟坐空斋，忽省君诗昨日来。\n叠纸为君书所见，不知众乐诚然哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴充","text":"南郭迎天使，东郊诏隐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴充","text":"压角旧仪烦阁老，濡毫逋责费公移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回文暮春","author":"吴光","text":"娇声啭处藏鹦小，美睡浓时落日斜。\n桥拂柳溪深涨水，眼惊春雨过飞花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦阴","author":"吴光","text":"荒山乾没更节序，浊气拥地愁无边。\n非烟非雾不见日，欲雨欲雪难为天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"吴光","text":"轻雷入树惊花魄，白浪浮空涨水脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十","author":"吴光","text":"一轴尘埃古涩体，十年灯火短长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十二","author":"吴光","text":"道上飞来燕，帘间不避人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吴光","text":"半塘微涨聚红皱，几亩清阴锁碧鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"吴光","text":"冰看时俗薄，雨弄客愁多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"吴光","text":"蒹葭露滴思乡恨，芦荻风萦羁旅愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"吴光","text":"泉声如有语，山色自忘形。\n花觉青春半，山将白昼阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"吴光","text":"二天开佛日，一道羃卿云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"吴光","text":"花蕊有须浑带蜜，桑枝无叶已成衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"吴光","text":"笛弄一声横钓艇，月明千里上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"吴光","text":"农祥待白未为雪，春榜争魁欲放梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"吴光","text":"无苗何处寻黄犊，露地谁家觅白牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"吴光","text":"人情不似溪流水，不改当时枕上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"吴光","text":"日长人静闻风佩，雨久堂空生水衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴光","text":"檐头清响银匙动，阶下寒光玉碗翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"吴光","text":"檐花谢女雪，径扫沈郎钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴光","text":"也应只是寻常夜，未必如今分外圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"吴光","text":"写处似移墙上影，捲来如寄陇头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴光","text":"独鹤下随鸡饮啄，众星高共月徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"吴光","text":"月借窗移疏影转，风翻雪放一枝高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十三","author":"吴光","text":"朱唇不注晓妆薄，玉颊频啼夜雨翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十三","author":"吴光","text":"弹压京畿贤大尹，藩宣上国古贤侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"吴光","text":"梦过一年还是魇，心更万事竟成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又画尝醋翁","author":"吴则礼","text":"石先戏作忍酸相，未信从来尝醋难。\n头毛鬅鬙面白皱，老夫笑作婴儿看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又偶作寄夷白老","author":"吴则礼","text":"去年腊雪一尺围，著处梅花如许肥。\n道人定复有幻法，莫遣都梁万点飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁老画梅二首 其二","author":"吴则礼","text":"玄牝要饱知，六出端不死。\n妙高一瓣香，付与毛锥子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁老画梅二首 其一","author":"吴则礼","text":"疏影只横斜，羁臣真耄耋。\n观渠小开落，得此大梦觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太和道中雪作因与诸友下马索酒快饮率尔成诗","author":"吴则礼","text":"兴来下马索酒觞，雪打战袍殊未央。\n有底须寻戴安道，端怜吴语贺知章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少冯得蕙二本分一见供","author":"吴则礼","text":"春尽盱眙天水昏，一年幽事要人论。\n阿冯端起北湖想，故遣九荂来晤言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王持中读余近诗跋以五绝因次其韵 其二","author":"吴则礼","text":"羁臣未觉诗无敌，老境谁言思不群。\n自有阿持提律令，且看山衲度江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王持中读余近诗跋以五绝因次其韵 其四","author":"吴则礼","text":"摩挲饱腹看飞鸿，脱屐海门篷底风。\n君方著足登饭颗，嗟我老矣无由同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王持中读余近诗跋以五绝因次其韵 其三","author":"吴则礼","text":"我句如许一生过，君诗政应万人传。\n但言寒温置馀语，可是从来子敬贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王持中读余近诗跋以五绝因次其韵 其五","author":"吴则礼","text":"一钱无有但觅句，百事不闻知读书。\n投荒归来老将死，要听孤猿聊荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰皋煎茶","author":"吴则礼","text":"掠水纤纤紫燕斜，聊凭乌几伫幽花。\n今年未识云腴面，且拨去年官焙芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十五日饭于因胜","author":"吴则礼","text":"老子端有衲子缘，独喜时时听三下。\n莫向诸方说久参，白头且结淮南夏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归途口占","author":"吴则礼","text":"九年脚不踏梁宋，踽踽归来成腼颜。\n秃发羁臣端饱在，淮南天遣米如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏嘲壁上画轴","author":"吴则礼","text":"寒林淡墨人争看，对面奇峰孰会心。\n可是世人唯识假，只缘清景少人寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次子方题游春图韵","author":"吴则礼","text":"付与春风不复言，个中端有玉妃魂。\n凭君细说枭卢事，暂借生香到酒盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次公卷韵","author":"吴则礼","text":"故人已去逐飞蓬，醉墨新辞手自封。\n欲识暮年魂断处，从今不忍听霜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵道辅丈荆州吟四首 其四","author":"吴则礼","text":"散发南风书曲肱，衰疲真自笑无能。\n剧谈稍负茅檐月，强赋荆州学少陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵道辅丈荆州吟四首 其三","author":"吴则礼","text":"田园岁晚欲榛芜，短褐苍颜与世疏。\n华屋徒惊栖万卷，伤心投老已捐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵道辅丈荆州吟四首 其二","author":"吴则礼","text":"故人高枕闭柴荆，应恨平生谩一经。\n下榻每怜挥白羽，挽溪仍喜得红菱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵道辅丈荆州吟四首 其一","author":"吴则礼","text":"楚橘秋高千树黄，赤湖城畔晚烟长。\n风尘满地麒麟老，血汗无因污锦缰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]