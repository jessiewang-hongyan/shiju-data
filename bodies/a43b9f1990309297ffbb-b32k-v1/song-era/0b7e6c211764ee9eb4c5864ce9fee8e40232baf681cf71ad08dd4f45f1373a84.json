[{"title":"七夕","author":"舒岳祥","text":"河似琉璃底，水行空影中。\n槎浮应恍惚，星会恐朦胧。\n七月初七夜，一年须一逢。\n经躔那有此，吾欲问天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕呈正仲","author":"舒岳祥","text":"金风璧月清凉境，红蓼青蘋迤逦秋。\n漠漠蛛丝穿露重，微微萤火学星流。\n何年才子诬躔象，几度佳人候女牛。\n一局烂柯经数代，人间隔岁未悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月十五日竞传有铁骑八百来屠宁海人惧罹仙居祸僦船入海从鸱夷子游余在龙舒精舍事定而后闻之幸免奔窜深有羡于渔家之乐也作渔父一首","author":"舒岳祥","text":"年来避世羡渔郎，全载妻儿云水乡。\n隔苇鸣榔分细火，带苔收网晒斜阳。\n一丝寒雨鲈腮紫，半箔归潮蟹斗黄。\n欲逐鸱夷江海去，西风无奈稻花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月初四日赋紫薇花","author":"舒岳祥","text":"蹙罗红线紧，镕蜡粉须黄。\n野寺花开日，平畴稻熟香。\n曾陪红药省，相对紫薇郎。\n尚忆丝纶閤，新秋雨露凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七月望日避地省坑存思庵留题时章林出白石可为水晶有旨差路县官同金玉提举差夫取凿又宿兵守之吏卒旁午指予为上户求鸡羊酒米油铁无以应其求且不堪其屡也来避于此予念自丁丑之乱至此凡三避矣僧旧屋更新怅然有感因赋之","author":"舒岳祥","text":"去家无十里，过岭即他乡。\n避地身三到，伤时泪数行。\n高檐齐古树，新屋背斜阳。\n我欲相邻住，青山志未偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日与正仲子堂君英举酒于篆畦璋万二侄男庭坚仲容仲堪叔献季临与焉","author":"舒岳祥","text":"登高胜具何人有，重九佳名此日临。\n老眼已昏空怅望，壮心犹在惜销沉。\n天真呈露青山瘦，世故流离白发侵。\n汉水沈碑今出否，古来贤达共沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日观万堂小酌怀正仲及梅所鍊师","author":"舒岳祥","text":"极目冥鸿颢气初，人生快意食鲈鱼。\n剪来萸菊觞新酒，麾去蚊蝇俯旧书。\n骚雅刘郎今健否，清修周老近何如。\n篆畦雨里青蒿长，寂寞无人过草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日怀故人留燕京者","author":"舒岳祥","text":"青山淡伫半帘雨，碧树婵娟一院阴。\n醉舞狂歌前日事，微吟浅酌此时心。\n菊花尽晚秋有味，枫叶尚彊霜著林。\n万里故人关塞隔，宾鸿应有寄来音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月朔晨起忆故园晚易","author":"舒岳祥","text":"晚易图书烬，篆畦花木新。\n承平三世积，丧乱一朝贫。\n清晓凭栏意，空山袖手人。\n平生欲学杜，漂泊始成真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月初二日山中感兴","author":"舒岳祥","text":"山合风多急，江寒潮易残。\n艰虞浑未息，漂泊若为安。\n脱叶投沙井，吹花点石阑。\n故园归梦切，雪潦几时乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二老亭","author":"舒岳祥","text":"人与松俱老，因名二老亭。\n只惭吾发白，不及尔髯青。\n佚史应同传，幽图总写形。\n把杯长与对，我醉任渠醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"儿曹请赋草间黄花","author":"舒岳祥","text":"树头绿叶无花看，树下黄花带叶开。\n火化新钱忘铸字，金成小盏欠施台。\n贵人亭馆何曾识，野客园林不用栽。\n斗草儿曹求入咏，苍苔留坐独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十八日与潘少白刘君英草酌耕养堂时刘正仲以求免役入城予亦为群小见厄者也","author":"舒岳祥","text":"二子论秋夜，秋蛩是四邻。\n叶黄狐下陇，灯暗鼠欺人。\n借誉门多客，临危俗少亲。\n平生刘正仲，于此见情真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月二十五日闻布新条","author":"舒岳祥","text":"民命无魂鹿，烹庖几日休。\n纷纷浑未悟，炯炯为深忧。\n并和邻舂相，分渔步网收。\n聊为目前计，瓷椀汲新篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十九日得董正翁寺丞书兵疫后城中故旧十丧八九怆怀久之顾我已多幸矣","author":"舒岳祥","text":"黄菊一瓶酒，青山四壁书。\n吾年馀几许，天意复何如。\n寒日沙禽并，风霜野果疏。\n山城询故旧，十九是丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十五夜月","author":"舒岳祥","text":"此夜十分月，年时中半秋。\n华夷同一照，今古几多愁。\n颢气横空白，天光际海浮。\n儿时读书处，桂子落岩幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月初十日疟起行园","author":"舒岳祥","text":"疟鬼自与诗人谑，小儿狡狯弄炎凉。\n蔬肥夜雨园丁逸，果熟秋风稚子忙。\n枕臂閒思新药灶，扶头欲起候茶枪。\n故园青桂华如水，归汎天风浩荡香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月初三日五更梦觉追记","author":"舒岳祥","text":"林下青衫卸，尊前白发攲。\n少年行乐事，暮景感伤时。\n鍊药嫌长懒，观书悔已迟。\n惜花心性在，时复一吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十一月初三日夜有兴寻梅","author":"舒岳祥","text":"树下春来往，窗间月死生。\n寻梅何处好，随意自溪行。\n酒债应无数，灯花各有情。\n明朝江上路，风雪一诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十七日夜村市","author":"舒岳祥","text":"今岁梅谁待，因迟却未残。\n新泉生暗谷，远烧照前滩。\n圆景终难久，残灯未肯阑。\n沉吟思往事，犹自倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月十三日晒药有感","author":"舒岳祥","text":"卖药不二价，买书甘一贫。\n谁于无妄世，完此不赀身。\n酒熟狂连月，花香走四邻。\n因思少年事，默默自沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月初七日补缀旧诗寄正仲","author":"舒岳祥","text":"岁阑思饮酒，人老且捐书。\n春日将辉贲，阴风为扫除。\n花前看灯蟹，雪后坐庵鱼。\n有约君无负，墙根摘露蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十三日即事","author":"舒岳祥","text":"蒿欺菊丛瘦，蔓压橘枝低。\n应俗精神减，伤时梦寐迷。\n攲眠中夜雁，薄饭午时鸡。\n咄咄真堪怪，秋深杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十六夜月蚀既","author":"舒岳祥","text":"虾蟆新食月，金饼曲如钩。\n天道终还旧，书生自隐忧。\n星辰秋后烂，河汉夜深流。\n我欲骑鹏背，乘风阅九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十三日嫩晴薄寒山房新构书阁去年此日北兵入是夜自中心墺徙独山","author":"舒岳祥","text":"雾重月无色，夜来寒有情。\n墙根馀宿莽，木末弄初晴。\n去岁那知有，新冬得此生。\n拥炉谈往事，鸲鹆报三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月十八日闻雁","author":"舒岳祥","text":"一声空杳分千响，万里荒凉月正明。\n共说江南旧来处，还思沙漠远行程。\n如哀如怨知何事，相应相呼也有情。\n惊起芦花不成梦，江城应是报严更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月初七日山中感兴","author":"舒岳祥","text":"日暮空归里，时艰未到家。\n稼收迁野鼠，柿熟乱慈鸦。\n冬煖生芦笋，人閒对菊花。\n亡书何处补，无用自咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月初三日追记丙子岁以此日风雪中度平坑岭入马耳峰","author":"舒岳祥","text":"岁穷常鲜裕，人老更多悲。\n白日无閒客，青山有了时。\n乾坤马迹满，风雨鹤巢危。\n去岁来坑岭，移家度崄巇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月初五日夜闻鸡","author":"舒岳祥","text":"荒郊寒雁起，深夜早鸡鸣。\n木枕违安寝，绳床遣不平。\n风霜双鬓晚，岁月寸心惊。\n牛具孤忠在，鸥波万事轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜居","author":"舒岳祥","text":"丹青不用画吾庐，小小茅茨住近湖。\n欲探春风先插柳，要看雪景更栽芦。\n野船摇处沙成叠，海雁眠来草似铺。\n妆点个中新景致，藤冠布褐老癯儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又戏和正仲赋剪春罗","author":"舒岳祥","text":"昔时剪綵聊为假，今见裁罗却是真。\n叶底綵窠本机户，花边线草是针人。\n独客书斋思拆补，静姝绣阁学缝纫。\n晚花开遍幽畦草，石竹山丹及丽春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十九日立夏喜晴稍有自适意有自旧京来者问钱湖景物又复怅然","author":"舒岳祥","text":"黄梅青李夏方初，新绿池塘浴小凫。\n此日猫头削寒玉，他时鸿喙煮明珠。\n白头偷果从渠乐，绣眼穿花不我虞。\n更有长愁无遣处，只今细柳映新蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月二十三日效乐天体","author":"舒岳祥","text":"习习东风白苧裘，馀寒未尽滞清愁。\n柳疑楚舞腰偏细，莺学吴音舌更柔。\n好景良辰千古在，骚人墨客几时休。\n一年佳致惟春莫，可惜花飞人白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月三日欲过小园闻海棠未开剪韭独酌有怀","author":"舒岳祥","text":"寻芳自是少闲身，世故纷纷更咈人。\n一箸小园初韭脆，三杯荒舍晚醅新。\n云藏柳叶裁难断，月入梨花辨不真。\n每岁海棠时候近，今年寒重殿馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月之朔邑庠请仆升讲席说诗泮水正仲用前韵纪之因次其韵","author":"舒岳祥","text":"春服初成冠与童，聚观王式一衰翁。\n圆冠方屦还吾道，续衽钩边见古风。\n投戈犹待汉符赤，藏壁不随秦火红。\n宁可短衣充博士，莫令城旦属司空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三月六日黄雾四塞涉三日不散木叶屋瓦积尘皆泥粉因记所见","author":"舒岳祥","text":"故国乌头白，太空鸡子黄。\n蒲茸千顷麦，筠粉万株桑。\n错莫昏花眼，朦胧尘土肠。\n天河如可挽，洗出太阳光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与正仲同游故园","author":"舒岳祥","text":"向老工诗句，残春尽树花。\n君来相映发，吾得减咨嗟。\n著帽风前侧，挥毫醉后斜。\n避尘如避虎，篱外便云遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小酌送春","author":"舒岳祥","text":"春风元逐土牛来，欲去金钱买不回。\n莫道莺花抛白发，且将蚕豆伴青梅。\n落花流水辞梁苑，芳草斜阳上楚台。\n孝子不嫌闲寂坐，绿阴如屋两三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小窗一首寄帅初","author":"舒岳祥","text":"爱酒不嗜饮，行藏一小窗。\n斜阳屐樵磴，细雨笠渔矼。\n红树桥边独，青禽石上双。\n永怀草庐葛，来访鹿门庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"舒岳祥","text":"今日新晴好，东风散麦须。\n山泉中琴瑟，岩鸟合笙竽。\n总是太平曲，何劳击壤图。\n谁知花溅泪，杜老独嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山甫还峡石有怀书寄","author":"舒岳祥","text":"静者一为别，谁将幽抱同。\n行诗求谷友，买纸嘱溪翁。\n数点淡云树，一行遥海鸿。\n莫因寻薯蓣，深入万山丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山甫病中归峡作此问之","author":"舒岳祥","text":"山甫病归峡，僧言药有瘳。\n自怜三岁长，多白几分头。\n水鸟工吟夜，阴蛩苦话秋。\n诗人多病疟，彊饭更何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山甫游鄞访僧复归山房","author":"舒岳祥","text":"麦熟归小隐，诗名留远方。\n竹冠山霭重，棕屦石苔香。\n扫径怜新笋，临池玩旧芳。\n僧交非昔比，吾党惧行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"舒岳祥","text":"雀饮梅心雪，鱼吞水面云。\n山居差有味，世事不堪闻。\n野烧穷狸穴，晴霄转雁群。\n溪寒春未著，闰月压馀分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山斋观物","author":"舒岳祥","text":"自古诗人皆格物，山斋观物意如何。\n额涂金粉蜂归穴，腹吐银丝蟢布罗。\n鸡母载雏行啄黍，雀群欺燕坐争窠。\n纷纷扰扰为形役，閒补涪翁演雅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山斋夜坐","author":"舒岳祥","text":"新岁才三日，春风便不同。\n花前双鬓白，雪后一灯红。\n老去心无术，愁来佛亦空。\n吾儒真实在，千古获麟翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山斋排闷","author":"舒岳祥","text":"耳聋便稳睡，眼暗总迷云。\n树湿直如沃，花香不待焚。\n燕归知旧主，蜂坌有新君。\n莫怪今非昔，从他聚必分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山窗即事思正仲有寄","author":"舒岳祥","text":"相怜不相见，不见自情亲。\n野水僧无影，斜阳树半身。\n懒蜂偷柏蜜，饥雀啄窗尘。\n吟就怀人杳，书成访驿频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己丑正月二十四日避地盐楹入省坑存思庵和旧韵 其一","author":"舒岳祥","text":"到此于今四，情深即故乡。\n新松知改径，旧竹不依行。\n平施天犹病，周回日载阳。\n邻人馈鸡黍，厚意未能偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾山题客舍壁","author":"舒岳祥","text":"晓行风露清，夹径草虫鸣。\n虎近常行市，鸡啼早出城。\n路长终是到，世险自难平。\n学得王阳术，黄金可立成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中夜对月有省","author":"舒岳祥","text":"风开半村雨，月吐四更潮。\n静处常参省，从来本寂寥。\n天机双鹤唳，霜信一鸿飘。\n短发梳还痒，寒釭凝不摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋与山甫登楼小酌","author":"舒岳祥","text":"莫笑斯楼小，因高势自尊。\n江山图万井，烟树点千村。\n斫却月中桂，烹他海上鲲。\n乘槎八月半，与子探河源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事","author":"舒岳祥","text":"倚徙白头杖，哀伤赤子兵。\n斜封今不用，直指近方行。\n商鞅何妨徇，桑羊尽可烹。\n击蒙须用此，尺箠惜刑轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月间与正仲立耕养堂前见石榴一花吐初因以荆公诗并俗语作对云万绿一红十风五雨好作尺牍中时令语正仲云只作诗语亦佳别后因补成章以寄之","author":"舒岳祥","text":"石屏溪上晚风柔，深念沉思注易楼。\n好酒自能和性气，闲愁何必上眉头。\n十风五雨天常顺，万绿一红春更留。\n灶婢解炊新麦饭，提鱼仍就篆畦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月十一日山窗散愁","author":"舒岳祥","text":"平生志大孔文举，牢落依然不可羁。\n茨阖小窗巢燕子，菰蒲新雨试鹅儿。\n胸襟大闷书不读，口吻微吟人未知。\n安得一蓑江海去，持螯作鲙卧鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月甲申雨后凉气如秋","author":"舒岳祥","text":"蘋花消息入疏棂，六月何曾有此清。\n晚饭出门新雨过，深衣临水早蝉鸣。\n月西人影如鸿影，风里松声带鹤声。\n此意寂寥谁会得，沉沉默默自含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天门山","author":"舒岳祥","text":"烟树连天远，渔樵两地分。\n仙舟沧海路，僧锡石桥云。\n落日人行少，空村犬吠闻。\n谁知隐沦者，绝迹在人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆篆畦","author":"舒岳祥","text":"流水人千里，清风酒一尊。\n乌头何日白，鹤发几人存。\n石树根基壮，秋虫羽股繁。\n殷勤问来使，元亮欲归园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木芙蓉","author":"舒岳祥","text":"溪山潇洒最宜秋，缓步何须百尺楼。\n乱后见花如故旧，老来得酒更风流。\n幽荪暗折谁知处，好鸟一啼人举头。\n欲对黄花开口笑，茫然消息也堪愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水金莲","author":"舒岳祥","text":"波心隐隐金椎出，只道冯夷先导来。\n笑口渐开黄玉瓮，丹心初见小莲胎。\n步花想见江妃佩，烧烛那从水殿回。\n传记无闻今始著，莫嫌闲客少诗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水阁新成与潘胡二子小饮","author":"舒岳祥","text":"小有龟藏意，横陈燕息初。\n一间规画舫，数板束方渠。\n隐几时听雨，开窗即钓鱼。\n天寒须共饮，吾已久捐书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其十","author":"舒岳祥","text":"冬日山居好，能安始识閒。\n渔归溪口港，樵下屋头山。\n竹蛎含梅蕊，江鲈著玳斑。\n人生何所事，口腹最相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其九","author":"舒岳祥","text":"冬日山居好，不知年又穷。\n老人六十七，破衲两三重。\n未要迎新岁，聊须驻旧冬。\n明堂知未议，安用聘申公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其八","author":"舒岳祥","text":"冬日山居好，能閒乐自全。\n米丰平酒价，蔬贱减鱼钱。\n偶尔思前事，依然是少年。\n下帘高枕卧，门外北风颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日山居好十首 其七","author":"舒岳祥","text":"冬日山居好，先生猎较时。\n海陂寒网雁，岚市夜分麋。\n酒熟邻相聚，家贫盗不窥。\n偷生前进士，幸矣过耆颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]