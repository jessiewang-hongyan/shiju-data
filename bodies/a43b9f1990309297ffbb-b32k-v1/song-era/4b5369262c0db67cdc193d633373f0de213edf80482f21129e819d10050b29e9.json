[{"title":"初春二首 其一","author":"项安世","text":"时阔江空无片云，草枯木脱最愁人。\n东风小作撩人意，已觉人间无奈春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县廨海棠盛开二绝句 其二","author":"项安世","text":"美人宿酒未全醒，困倚妆台睡不成。\n一半醉颜无处画，似红如白最多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县廨海棠盛开二绝句 其一","author":"项安世","text":"梅蕊才开杏又红，今年春事太匆匆。\n堂前燕子归来到，双海棠花已满丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨","author":"项安世","text":"幸自蓬窗好，侬家企脚眠。\n雨声无赖得，相唤著愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿母生朝四首 其四","author":"项安世","text":"儿孙遥指菊花辰，自讼庵中庆诞人。\n也向此旬同此日，八千秋对八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿母生朝四首 其三","author":"项安世","text":"良辰好景占年年，画烛浓香醉玉船。\n天上月圆三夜后，人间春到万花边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿母生朝四首 其二","author":"项安世","text":"荪襦兰佩拥萱阶，绿发朱颜照酒杯。\n九十九洲春色里，老人星动寿筵开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿母生朝四首 其一","author":"项安世","text":"堂成初见画檐新，碧瓦翚飞上綵云。\n三尺宝台蒙锦帕，白狻猊顶翠氤氲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李中主书堂","author":"项安世","text":"楞伽有公择，娣弟如班宗。\n宜州黄宅相，馀韵更舂容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步上黄罴岭","author":"项安世","text":"牛头鹤弄漫虚传，未抵黄罴路刺天。\n曳杖徐行吾自乐，世间何地不平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈医送苔梅自云恨不能诗","author":"项安世","text":"但能为我送苔梅，何必新诗手自裁。\n若使能诗有奇句，无因送与冷官来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸阁 其一","author":"项安世","text":"也知无鬼瞰高明，纸阁中间万事轻。\n不愿人呼贵公子，只图身作富书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纸阁 其二","author":"项安世","text":"薄似秋云瑩似冰，清于寒士懒于僧。\n凭谁更得移蟾法，剪取光明不用灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还刘叔骥庐山诗卷 其一","author":"项安世","text":"刘家子骥我乡人，洞口桃花独问津。\n岁时他乡逢叔士，杏林花发小阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还刘叔骥庐山诗卷 其二","author":"项安世","text":"浔阳江上督邮谁，能使陶公去不疑。\n今代庐山非昔日，督邮能酒更能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风泊江州对岸","author":"项安世","text":"城下看山不见山，东风吹我过前滩。\n横陈庐阜沧波上，十二云鬟得细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风茅山港 其一","author":"项安世","text":"日日南风费挽牵，江神知我意悠然。\n小舟随水随风住，不羡千帆上水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阻风茅山港 其二","author":"项安世","text":"我非汲汲驰名者，何事区区逆浪间。\n三釜及亲须为米，可辞为客下茅山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡唱歌","author":"项安世","text":"莫歌鸡唱晓，老泪不禁弹。\n昔为祖士雅，今作杜齐安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卧病","author":"项安世","text":"廉纤小雨湿相欺，病客无悰昼掩扉。\n自转巫屏遮午枕，一窗寒梦绕亲闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵主簿韵赋桃花","author":"项安世","text":"曷日鲜晴后土乾，川原远近踏春寒。\n诗人不问花开落，为雨为霞总爱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵司户寻梅桐原庵 其二","author":"项安世","text":"桐原花下不容车，茅压疏檐竹绕闾。\n可惯传呼青影里，人声浩浩屋渠渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵司户寻梅桐原庵 其一","author":"项安世","text":"王孙宝马七香车，不似吟鞭跨蹇驴。\n少待绿阴青子下，与君扶杖转鸣渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜泊闻榔","author":"项安世","text":"昨夜天聪门外泊，不闻朝鼓只闻榔。\n三年一觉青云梦，始觉人间味许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忠州","author":"项安世","text":"耕凿林庐满四山，人家境象极宽閒。\n不妨五马云根住，小市孤城自掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松阳南岩夜归","author":"项安世","text":"走下南岩踏黑归，苍林拥径白光微。\n马湖桥上消摇甚，飞度前村露满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武陵江上渔舟","author":"项安世","text":"家居堤下土平檐，人在江中尺许船。\n正尔平生事方足，有人狂梦欲登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"炙背","author":"项安世","text":"偻坐前檐曝午曦，一襟和暖似春时。\n无因得共田夫比，直献君王更不疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台 其一","author":"项安世","text":"数仞山头一小亭，只消此地过平生。\n崎岖狭世才伸脚，已被刘郎卖作名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台 其二","author":"项安世","text":"君房足下竟成谀，只是韩歆已破除。\n岂有江湖钓竿手，为君台阁奉文书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中二绝句 其二","author":"项安世","text":"雨过山色青，风来水花白。\n不是风雨来，何因见颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中二绝句 其一","author":"项安世","text":"急雨暗洲渚，颠风吹客船。\n不知何世画，水墨水江天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中早行","author":"项安世","text":"春烟漠漠雨霏霏，山崦人家未启扉。\n刚把平生青箬笠，江南道上著征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临安道中见壁间书字云由左行者为四川驿路","author":"项安世","text":"只道成都路八千，谁知从此便西川。\n行人一见成深省，大道多歧稳著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亭午热甚过石子涧","author":"项安世","text":"一掬儿童数树凉，两三桅子野花香。\n荒山赤日相逢处，便是天台见石梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南岳路口怀胡氏兄弟 其一","author":"项安世","text":"奕奕神山照远天，美人家在此山前。\n待侬了却公家事，来借书堂十日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南岳路口怀胡氏兄弟 其二","author":"项安世","text":"虎逝龙亡不记年，旧巢双凤故依然。\n灵岩草木皆堪敬，莫作寻常到岳前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将往襄阳一日大雨","author":"项安世","text":"谁报江神我欲西，怕传新句落檀溪。\n江头一雨泥三尺，车没双轮马没蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡内三绝句 其三","author":"项安世","text":"千崖无树作炊烟，峡内为生也可怜。\n探水得柴如宝藏，卖茆成俗满村船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡内三绝句 其二","author":"项安世","text":"峡内居人种石田，种成卜瓠待江船。\n船头老妪悲声甚，只博茶盐不博钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡内三绝句 其一","author":"项安世","text":"峡内为生绝可怜，那知世上有平川。\n生身未识三冬雪，仰面惟看一席天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归二绝句 其一","author":"项安世","text":"永日消金鸭，暄风汎宝鸾。\n自从归意动，无复梦魂安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归二绝句 其二","author":"项安世","text":"艾叶翻翻白，榴花叠叠红。\n年华惊客枕，心事逐邮筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日途中五首 其五","author":"项安世","text":"微风急雪点微茫，渔浦江边上客航。\n逆水趁潮如顺水，他乡送客似离乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日途中五首 其四","author":"项安世","text":"湖海今年最倦游，春来新上浙西舟。\n天寒岁暮钱清路，又踏严州向婺州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日途中五首 其三","author":"项安世","text":"破艇冲风去似疑，短篷经雨漏如筛。\n无端更著连宵雨，大似波神得厮欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日途中五首 其二","author":"项安世","text":"一派清江两岸平，湿云将雨暗柴荆。\n十年一觉荆州梦，通济江头沌里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日途中五首 其一","author":"项安世","text":"未说离家日日晴，离家三日雨如倾。\n津头小吏询名氏，但道当年段墨卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春色三首 其三 芳草","author":"项安世","text":"堕粉瓢红迹已陈，却将春色付何人。\n东君老去都平施，绿幕连天一样新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春色三首 其二 垂杨","author":"项安世","text":"春风十九归桃李，白白红红得最多。\n未抵垂杨春最惜，娇娇袅袅奈渠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春色三首 其一 桃李","author":"项安世","text":"花因实盛村村有，树为花繁处处明。\n浩荡九州春色里，输他桃李最多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴二首 其二","author":"项安世","text":"烟花淡淡雨声息，云脚疏疏日影红。\n桃花作雨梨花雪，春在绿杨芳草中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴二首 其一","author":"项安世","text":"好风疏雨瀹红尘，收拾残花作翠阴。\n春色不随桃李去，一川浓绿正深深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晴步出东城","author":"项安世","text":"山北山南草渐青，去年双鬓只星星。\n春风不管游人老，又到江头白下亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀 其二","author":"项安世","text":"秋水迢迢诗思清，秋阳杲杲道心明。\n谁人得似秋光巧，画出山斋杖屦行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀 其一","author":"项安世","text":"有营何日得无悲，无欲无时不自宜。\n竹影一窗泉一曲，山斋非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆门十二背诗","author":"项安世","text":"瞿塘关里异乾坤，石狭山深日气昏。\n行过西陵天亦晚，浪平风暖下荆门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其二","author":"项安世","text":"二歌渔父寿杯宽，荆江亭下到临安。\n更将海水都斟却，浅得蓬莱始好看。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其六","author":"项安世","text":"六歌渔父寿诗声，一声声带竹枝情。\n大枝千岁不改色，小枝孙子满林生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其七","author":"项安世","text":"七歌渔父寿香堆，花雾深深拨不开。\n水边借得春风送，荷花吹上戟门来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其四","author":"项安世","text":"四曲渔人寿烛明，明在水云连处生。\n倚天若木朝朝艳，照海金波夜夜清。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":50999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其一","author":"项安世","text":"第一歌头缓缓催，且看渔父寿图来。\n天明转向牙旗外，六千里地绣屏开。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其三","author":"项安世","text":"三曲渔人献寿茶，新翻衢样织茶花。\n白雨纷纷下江海，翠浪滚滚开龙蛇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荆江渔父竹枝词九首和夔帅□侍郎韵为荆帅范侍郎寿 其九","author":"项安世","text":"九歌渔父好思量，愿得寿星朝帝乡。\n寿十二庙寸关尺，演亿万年元蔀章。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潘都干往临安","author":"项安世","text":"西子湖边桃叶青，潘郎归骑拂春星。\n金陵风景凭谁看，留得闲人住冶亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送襄阳冯主簿 其三","author":"项安世","text":"不随黄绶去仇栖，归著亲前五色衣。\n安得紫皇知此意，唤教霜凤带雏飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送襄阳冯主簿 其二","author":"项安世","text":"老子当年起垄间，岂知零落向华颠。\n秋风唤起神洲梦，犹忆平生戴与田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送襄阳冯主簿 其一","author":"项安世","text":"书来雍府不相忘，中有清诗小作行。\n一似岘南车上读，眼中行色有辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郢州道中见刺玫瑰花","author":"项安世","text":"酴醾雨后飘春雪，芍药风前散晚霞。\n一路繁香伴行客，只应多谢刺玫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九以枣糕饷孙司户","author":"项安世","text":"满城风雨近重阳，应为征廛堕渺茫。\n要看诗来压奇字，试拈公案示孙郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重午饷菜楚俗也邓抚干以诗来谢次韵答之三首 其三","author":"项安世","text":"蜀客登来屈子城，九歌重见笔纵横。\n不妨秋露浇春菜，只可从渠学独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重过习池","author":"项安世","text":"征鞍重过习家池，桥下泉声又索诗。\n待洗一杯春酒涴，为君吐出碧云词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳前一日大风雨","author":"项安世","text":"天公著意做重阳，风伯驱除特地忙。\n扫尽残花与红叶，放教篱菊占秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕谕铃下两绝句 其一","author":"项安世","text":"江边梅柳自知新，病里形容只向陈。\n春色不干枯木事，明朝贺岁莫通宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夕谕铃下两绝句 其二","author":"项安世","text":"莫将新岁便为新，綵仗春幡不动陈。\n未转东风犹是腊，明朝贺岁莫通宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顺风过湖二首 其二","author":"项安世","text":"维舟六日傍明山，待得风来始破颜。\n一抹平湖三十里，听渠微横未须关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顺风过湖二首 其一","author":"项安世","text":"帆影如酲左右倾，水声似战聒天鸣。\n傍人只道船行快，不道船中客更惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":51015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]