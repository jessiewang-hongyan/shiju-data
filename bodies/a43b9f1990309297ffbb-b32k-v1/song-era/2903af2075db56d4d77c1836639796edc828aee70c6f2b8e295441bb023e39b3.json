[{"title":"宫词 其八十","author":"王圭","text":"素英飘洒作宵寒，一寸金花烛泪残。\n连夜对香宣两府，平明谢雪到斋坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十四","author":"王圭","text":"新供御马可曾骑，青鬣连钱碧玉蹄。\n每到殿前祗侯驾，金鞍卸下不闻嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八","author":"王圭","text":"帘旌风捲绿波流，绣扇红鸾五綵楼。\n撮角茶床金钉校，暗花香印锦纹头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十","author":"王圭","text":"晚来东殿放笙歌，外院池亭得暂过。\n深炷炉香登月榭，栏干西角拜姮娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十五","author":"王圭","text":"宫人捧砚临香案，一幅春绡展素霞。\n玉箸弯环题御篆，风云金殿起龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其五","author":"王圭","text":"燕去燕来閒白昼，花开花落送黄昏。\n年年好景春风妒，梦里铅华湿泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十三","author":"王圭","text":"夕宴中秋醉广寒，阆风银阙锁三山。\n美人半夜歌明月，声在玉壶天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十七","author":"王圭","text":"后苑归来月上初，天歌吹引六鸾舆。\n春风料峭馀寒重，犹索金函览奏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其三十","author":"王圭","text":"石刻蛟螭扶绣柱，金盘龙凤走雕楹。\n万年枝上流莺啭，屏掩春山梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十七","author":"王圭","text":"三殿飞云禁钥开，风从天上送春来。\n诸藩玉帛朝元日，齐献南山万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十九","author":"王圭","text":"数骑红妆晓猎还，销金罗袜缕金环。\n佯佯走马穿花过，拂拭雕弓对御弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十五","author":"王圭","text":"六龙观稼奉宸游，齐贺丰年荐麦秋。\n后苑宴回卿相出，内官金合送来麰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十九","author":"王圭","text":"千年一偶圣人生，岂特河清海亦清。\n瑞应固宜流乐府，行看丝竹有新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十六","author":"王圭","text":"翡翠盘龙装绣额，真珠双凤蹙花球。\n时闻玉女牵帘笑，箭跃铜壶不算筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十七","author":"王圭","text":"帘摇翡翠金风晚，瓦湿鸳鸯玉露天。\n秋殿晓开重九宴，内人争贴菊花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十六","author":"王圭","text":"元夕星灯照露台，六宫歌吹出云来。\n夜深翠辇归金殿，十里回廊锦帐开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十四","author":"王圭","text":"新学琵琶曲破成，仙韶第一已知名。\n朱弦未落黄金拨，玉腕先闻动钏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十七","author":"王圭","text":"迢递金壶漏水长，轮更传点报君王。\n诸宫各进时新果，尽著龙床驻夜香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十四","author":"王圭","text":"玉兔何年上月宫，夜间捣药特无踪。\n神丹不老姮娥鬓，乞取刀圭驻玉容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十一","author":"王圭","text":"中宫赐雪玉成峰，滴露堆寒冷照空。\n三十六琐明月夜，姮娥浑在水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十二","author":"王圭","text":"内苑宫人学打球，青丝飞控紫骅骝。\n朝朝结束防宣唤，一样珍珠络辔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十八","author":"王圭","text":"殿下排场击土牛，君王玉仗久迟留。\n内人争卜宜春喜，夺得金泥各自收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十五","author":"王圭","text":"太尉洮岷破敌回，腰垂金带入关来。\n殿前献寿天颜喜，花覆千官拱御杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六","author":"王圭","text":"侍辇归来步玉阶，试穿金缕凤头鞋。\n阶前摘得宜男草，笑插黄金十二钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十四","author":"王圭","text":"博士当年教玉筝，六宫谁敢斗新声。\n如今旧曲无心理，宝柱一行秋雁横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其六十九","author":"王圭","text":"鼓角三声夜奏严，夕斋清庙宿重帘。\n殿前太尉横银仗，指点金盆御水添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一","author":"王圭","text":"花里宫莺晓未啼，千牛仗下报班齐。\n银袍五百趋龙尾，天子临轩赐御题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其二十二","author":"王圭","text":"两班齐贺玉关清，新奏熙州曲破成。\n画鼓连声催攧遍，内人多半未知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其四","author":"王圭","text":"碧桃花下试枰棋，误算筹先一着低。\n输却钿钗双翡翠，可胜重劝玉东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十二","author":"王圭","text":"丽日祥烟锁禁林，樱桃初熟杏成阴。\n年年翠辇来游幸，花落春宫一寸深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其八十八","author":"王圭","text":"崇文殿里胜蓬莱，绣柱扶天秘阁开。\n典籍校雠三殿外，图书多出禁中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十八","author":"王圭","text":"金鸡竿下龙旂动，万国华夷拜冕旒。\n十二门开传诏急，祥云捧日在楼头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十一","author":"王圭","text":"十年一住广寒宫，云恋歌声惯绕空。\n长爱惜花花下唱，袖和金缕怕春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九","author":"王圭","text":"临明一阵梨花雨，梦隔珊瑚斗帐明。\n后苑乐声催引驾，春衫初试觉身轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其九十","author":"王圭","text":"花外栏干压翠檐，水边金阁半垂帘。\n内砧敲月黄昏后，坐觉寒风一倍添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其一○○","author":"王圭","text":"沉烟摇碧透金铺，密下珠帘镇玉壶。\n近赐赵昌花雀障，却嫌崔白芰荷图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其十一","author":"王圭","text":"盆山高叠小蓬莱，桧柏屏风凤尾开。\n绿绕金阶春水阔，新分一派御沟来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宫词 其七十一","author":"王圭","text":"禁籞春来报踏青，御池波漾碧涟轻。\n内人争送鞦韆急，风隔桃花闻笑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思乡岭","author":"王圭","text":"晓入燕山雪满旌，归心常与雁南征。\n如何万里沙尘外，更在思乡岭上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程公辟刑部出守南昌","author":"王圭","text":"钟陵从昔号名州，绿发仙郎作郡侯。\n波送蛟龙归海上，云随旌旆落天头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮上阻雪寄梅公仪龙图","author":"王圭","text":"淮上惊波欲去难，更逢春雪下云端。\n思君一夜如千里，手把琼枝不奈寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越王楼","author":"王圭","text":"跨险盘危压古州，至今传号越王楼。\n山分冷翠侵檐滴，水擘寒声绕槛流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸斗岭","author":"王圭","text":"戴斗疆陲省识华，更凭重阜切天涯。\n安知玉殿开阊阖，日月星辰在帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十二 太上皇后阁","author":"王圭","text":"几年退乐紫房居，天下犹传还政书。\n玉案焚香读黄老，人间宫殿午阴初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十 太上皇后阁","author":"王圭","text":"浮云仙殿切昭回，甘露通宵滴玉杯。\n金锁才开团扇入，圣神天子问安来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其六 太上皇后阁","author":"王圭","text":"复道青槐合，雕盘碧李新。\n百灵扶绣户，不假艾为人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其五 太上皇后阁","author":"王圭","text":"宝缕千祥集，灵符百疫奔。\n天人无限福，未老见曾孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其四 太上皇后阁","author":"王圭","text":"有德名终大，无为福自延。\n更闻天子孝，荐术助长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其八 太上皇后阁","author":"王圭","text":"水风吹殿送微凉，竹叶金盘粽子香。\n试向跃龙门上望，不教车马胜南阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其九 太上皇后阁","author":"王圭","text":"钗头艾虎辟群邪，晓驾鲜云七宝车。\n宴罢瑶池红日晚，归来零乱满宫花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十一 太上皇后阁","author":"王圭","text":"平明三殿进觞初，玉女傍边捧道书。\n探得长生太清箓，同扶皇历万年馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其二 太上皇后阁","author":"王圭","text":"汉殿炎风少，轻凉已动衣。\n每来观织室，不许夜停机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其一 太上皇后阁","author":"王圭","text":"两仪坤载厚，四海母仪深。\n愿上菖花酒，年年圣子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其七 太上皇后阁","author":"王圭","text":"池边草色迎人绿，庭下榴花照地红。\n晓献瑶觞千万寿，鸣梢声入宝慈宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其六 夫人阁","author":"王圭","text":"后苑寻青趁午前，归来竞斗玉栏边。\n袖中独有香芸草，留与君王辟蠹编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其八 夫人阁","author":"王圭","text":"偶从选入侍仙都，歌舞常承玉殿呼。\n欲谢君恩却无语，心前笑指赤灵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其二 夫人阁","author":"王圭","text":"绕臂双条达，红纱昼梦惊。\n连吹紫云曲，不及晚妆成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其九 夫人阁","author":"王圭","text":"一样红裙试舞斜，阶前妒尽石榴花。\n明朝知是天中节，旋刻菖蒲好辟邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其四 夫人阁","author":"王圭","text":"画栱无尘乳燕飞，薰风时复度罗衣。\n君王避暑蓬莱殿，向晚笙歌簇辇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其三 夫人阁","author":"王圭","text":"绿艾初垂户，青菰已荐觞。\n人归宫殿午，偏觉昼阴长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其七 夫人阁","author":"王圭","text":"火云时节促金刀，旋捲珠帘剪绛绡。\n天上莫将尘世比，房栊都未觉炎歊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其一 夫人阁","author":"王圭","text":"金缕黄龙扇，兰芽翠釜汤。\n君王回浴殿，步辇自生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其九 皇后阁","author":"王圭","text":"夕然辟恶仙香度，朝结延年帝缕成。\n愿上玉宸千万寿，薰风常泛舜弦声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其四 皇后阁","author":"王圭","text":"五月炎风炽，忧勤紫掖中。\n催裁恤刑诏，晓下未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其七 皇后阁","author":"王圭","text":"君王未带赤灵符，亲结双龙献宝珠。\n更与宫娥花下看，工夫还似外边无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其五 皇后阁","author":"王圭","text":"侍儿清晓进仙裳，玉筦齐调奉帝觞。\n应有瑶箱旧时燕，直随歌舞到昭阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其一 皇后阁","author":"王圭","text":"玉作仙家殿，都无暑气侵。\n犹裁葵叶扇，常有爱君心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十 皇后阁","author":"王圭","text":"紫阁曈昽隐晓霞，瑶墀九御荐菖华。\n何人又进江心鉴，试与君王却众邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其三 皇后阁","author":"王圭","text":"金屋风光别，仍逢令节新。\n争传九子粽，皇祚续千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其六 皇后阁","author":"王圭","text":"君王初幸集灵台，碧藕催花海上开。\n见说一房皆百子，凤衔双蒂几时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其八 皇后阁","author":"王圭","text":"水晶宫殿晓风微，天女乘云献玉衣。\n谁把轻绡裁画扇，直疑双凤向人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其二 皇后阁","author":"王圭","text":"茧馆桑阴合，新丝已上机。\n忧勤不知暑，亲织衮龙衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其九 皇帝阁","author":"王圭","text":"御柳重重午影圆，薰风时泛舜琴弦。\n六宫竞进长生缕，天子垂衣一万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其四 皇帝阁","author":"王圭","text":"御醑璩杯白，仙风羽扇清。\n灵符不须进，汉垒已销兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其十 皇帝阁","author":"王圭","text":"禁幕无风日正亭，侍臣初赐玉盘冰。\n不知翠辇游何处，应在瑶台第一层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其一 皇帝阁","author":"王圭","text":"万里关山静，清阴满塞榆。\n如何金殿里，犹献辟兵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其二 皇帝阁","author":"王圭","text":"瑞日浮丹阙，仙云满玉舆。\n更传长命缕，宝历万年馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其八 皇帝阁","author":"王圭","text":"沈沈三殿燕华绅，云覆端门瑞气新。\n昼漏未移天正午，此时兼有日重轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午内中帖子词 其六 皇帝阁","author":"王圭","text":"波生碧海露晨曦，争剽菖蒲集御卮。\n见说太平无沴气，山中丛艾独生迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":12401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]