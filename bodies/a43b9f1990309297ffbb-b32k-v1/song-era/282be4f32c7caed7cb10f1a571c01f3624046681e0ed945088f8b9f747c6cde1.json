[{"title":"冲天楼","author":"傅梦得","text":"人生行乐是便宜，惯入深林细品题。\n有石两行如壁立，登楼一望觉天低。\n亭前秋意惊松露，山外湖光拍柳堤。\n此景欲吟吟不尽，夜深分付野猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后土祠琼花","author":"傅梦得","text":"朱阑遮护石为台，只说扬州地可栽。\n若与八仙同日语，因何九蕊有香来。\n此花堪咏奚须辩，自旧曾移不肯开。\n得得无双亭上望，临祠酹酒叶为杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼","author":"傅梦得","text":"自来京口足清游，天下闻名只此楼。\n山结人愁成北固，江和客泪向东流。\n痕留很石传千古，望断中原知几州。\n有景虽多非可乐，明朝准拟渡瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扬州竹西楼","author":"傅梦得","text":"自从骑鹤到，船泊画桥堤。\n新酒斟花露，高楼傍竹西。\n拭盘将蟹擘，拂壁把诗题。\n早过瓜洲渡，秋深怕马嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖","author":"傅梦得","text":"落魄江湖上，人疑是谪仙。\n四时逢酒醉，长日拥书眠。\n点鬓惟添雪，知心只有天。\n林泉难久困，未整钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖伟观","author":"傅梦得","text":"倚遍阑干指顾间，吟身恨不早生翰。\n几多风月闲中占，一望江湖眼界宽。\n胥浪掀天秋际阔，逋梅得月夜深寒。\n有时听得渔歌晚，惊起沙鸥雪一团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过兰亭","author":"傅梦得","text":"右军堂下过，尚有读书坛。\n水曲觞何在，池荒墨未乾。\n人多寻古迹，我亦渡寒滩。\n要把兰亭记，摩挲醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂虹桥","author":"傅梦得","text":"一舸西风到水乡，半痕残月浸沧浪。\n湖中有影浑如画，天下无桥似此长。\n题品垂虹多古作，去来征雁带秋霜。\n三高千古英灵在，经过祠前菊正黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郑松窗","author":"傅梦得","text":"相逢交未深，一笑便生春。\n松作四时友，窗无半点尘。\n诗囊为活计，廛隐着吟身。\n似此知音者，江湖能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金山寺","author":"傅梦得","text":"昨夜宿江口，客衣风已飘。\n两峰参塔顶，一寺裹山腰。\n水拍瓜洲渡，烟生扬子桥。\n寻花并问柳，端的在明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中","author":"傅梦得","text":"惟有闲中日最长，薰风拂拂透脩廊。\n半窗槐影侵书叶，一曲蝉声送夕阳。\n强把茶瓯醒困眼，久无诗债抖枯肠。\n何妨自取离骚读，且向斋炉爇晚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘","author":"傅梦得","text":"苍茫空阔海云开，浙水东西隔岸隈。\n我到龙山呼渡晚，谁从渔浦趁潮回。\n蓦惊塞雁声嘹呖，静看沙鸥独往来。\n山外中原皆在望，英雄谁肯便心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿镇江丹阳馆","author":"傅梦得","text":"暂泊喜天晴，丹阳住晚程。\n半窗留月色，隔岸送钟声。\n江绕金山寺，云生铁瓮城。\n片帆催早发，莫待暗潮平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"德清永兴寺","author":"傅梦得","text":"苍寒松竹满，此地称僧居。\n寺僻啼林鸟，廊空响木鱼。\n煮茶烧树叶，带雨剪园蔬。\n待了功名债，重来买地锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴寺","author":"傅梦得","text":"不到吴坟久，重来又七春。\n山峦如旧识，猿鹤复相亲。\n往事皆成梦，清游不厌频。\n倦行难唤酒，信步出湖滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠澄鉴","author":"傅梦得","text":"一见便忘形，生涯画作屏。\n心和秋水澈，眼带古铜青。\n客里江湖阔，人间笔砚灵。\n他年重会面，我亦鬓星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"许村","author":"傅梦得","text":"信步水之滨，闲中着此身。\n萧条僧寺近，来往客舟频。\n村酒难成醉，山花亦有春。\n人生要行乐，何苦恋京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"傅雱","text":"半淡半浓资眺望，似明似晦喜登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠何定远","author":"傅慎微","text":"故人何定远，造物不虚生。\n骨骼棱棱瘦，诗篇字字清。\n世皆尊道义，我独见忠诚。\n尊酒分携后，何时盖复倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十一日夜凉风骤至即事书怀三绝句 其一","author":"傅察","text":"凉飙此夕何佳哉，万里朱炎去不来。\n吹入离人多少恨，却将魂梦到阳台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十一日夜凉风骤至即事书怀三绝句 其二","author":"傅察","text":"萧萧初觉澹云轻，飒飒如闻转树声。\n收拾光辉浑在眼，应知骑省赋初成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十一日夜凉风骤至即事书怀三绝句 其三","author":"傅察","text":"窗外时闻一叶落，槐阴惊起几蝉鸣。\n秋风定是多情物，解作离肠欲断声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月十六夜对月","author":"傅察","text":"云捲天高鸟鹊飞，满庭槐影转风枝。\n可怜秋色谁分付，正是安仁作赋时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马上作","author":"傅察","text":"心逐轻波去，身随匹马归。\n据鞍挥泪尽，回首一依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无逸用前韵见谢复次韵三首 其三","author":"傅察","text":"鹏飞初不碍蒿蓬，自拟归休慕仲翁。\n况有仙姿标洞府，泠然禦寇已乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其二","author":"傅察","text":"前辈不可见，古道邈难寻。\n何时赤松子，相与归山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其三","author":"傅察","text":"折腰为五斗，我已愧渊明。\n共赴东林约，怅然怀友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其六","author":"傅察","text":"一世竞荣利，纷若空中花。\n蚤作田园计，人生会有涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其九","author":"傅察","text":"圣德覆天下，欢然万物春。\n北窗微笑傲，似是羲皇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其七","author":"傅察","text":"身游阛阓间，心在孤云杪。\n譬如登太山，颇觉天下小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其八","author":"傅察","text":"外慕亦无已，反身良有馀。\n乘流如可游，韫椟岂藏诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其一","author":"傅察","text":"南浦送微波，西山来远绿。\n日暮独盘旋，慨然抚孤竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其四","author":"傅察","text":"虚斋篆炉烟，兀然得禅寂。\n虽有锦绣肠，画饼安可食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杜无逸西园独坐九绝句 其五","author":"傅察","text":"亭亭涧底松，干凌雪霜孤。\n既无鸾凤翔，鸟雀来喧呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜无逸留别次韵三首 其三","author":"傅察","text":"一官塞北似飘蓬，邂逅威严霁弱翁。\n它日若陪林下客，亦能把钓待秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹三首 其三","author":"傅察","text":"半醉西施晕晓妆，天香一夜染衣裳。\n踌蹰欲画无穷意，笔法何人继赵昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹三首 其二","author":"傅察","text":"无奈狂风日日催，东君欲去复徘徊。\n应缘众卉羞相并，故遣妖姿最后开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹三首 其一","author":"傅察","text":"侍中宅畔千馀朵，兴庆池边四五枝。\n何似城南王处士，满园无数斗新奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思家","author":"傅察","text":"一别遽如许，归期可奈何。\n无心恋明月，有泪寄流波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻有游蔡氏园看牡丹诗戏作一绝呈季长","author":"傅察","text":"车骑雍容驻道傍，小园寻胜见花王。\n应知异日传佳句，处处人称黄四娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠二首 其二","author":"傅察","text":"欲识东君用意工，故将残叶衬轻红。\n可怜雨洗胭脂湿，只怕风吹翠幄空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠二首 其一","author":"傅察","text":"恰恰清明昨夜过，海棠幽独占春多。\n杜陵不是无心赋，才薄难工奈若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦觉","author":"傅察","text":"日永不可过，夜凉愁更多。\n蝉声嘶晚月，孤枕梦如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其八","author":"傅察","text":"撒盐乍可拟，刻楮竟难成。\n妍词觑天巧，应复召邹生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其七","author":"傅察","text":"春雷忽隐隐，春雪复纷纷。\n农夫戒及泽，荷锸已成云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其六","author":"傅察","text":"忽惊陋巷间，踏作琼瑶迹。\n坐闻郢中歌，妙句压元白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪九首 其五","author":"傅察","text":"黑云埋日车，厚雪镇坤轴。\n行路勿匆匆，包藏恐深谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七月二十五登舟","author":"傅察","text":"暂来征骑出阇闉，却棹扁舟下小津。\n飒飒西风如送客，萧萧晚雨欲留人。\n一年踪迹无停日，千里羁游又远亲。\n为问篙师从此去，定知几日到东秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五伯以诗见赠因次韵为谢","author":"傅察","text":"萧然颜巷复谁堪，竟日潜心到五三。\n载酒未妨从靖节，围棋端不羡羊昙。\n逢人倾倒群儿笑，落笔纵横四座惭。\n旧学青箱知未替，更将新律付诸男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次申教授直宿三首 其三","author":"傅察","text":"秋堂襆被有馀清，骤喜秋光泼眼明。\n帘外月华筛碎玉，床头萤火当长檠。\n直嫌唧唧秋虫响，且听琅琅弦诵声。\n善教尚烦留滞席，朝恩未许便归更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次申教授直宿三首 其二","author":"傅察","text":"扰扰浮名绊此身，相逢樽酒眼还明。\n君如俊鹘方抟翮，我似弯弓不受檠。\n弱植幸容依玉树，新诗尝喜掷金声。\n他时会致青云上，莫厌卑栖岁屡更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又次申教授直宿三首 其一","author":"傅察","text":"皎皎虚堂带月清，金风入律露华明。\n潘郎寓直生秋兴，韩子长歌忆短檠。\n惊鹊绕枝巢未稳，幽虫寻砌隐馀声。\n却嫌诗思撩归梦，数尽高城长短更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又挽词三首 其三","author":"傅察","text":"榆社聆风远，兰阶托契深。\n兴宗知有自，处贵独无心。\n陇柏晞朝露，庭槐长夏阴。\n如公更何恨，顾我尚沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又挽词三首 其二","author":"傅察","text":"遗子一经足，成家五福并。\n千钟欣禄养，万石仰荣名。\n日射铭旌字，风传衮铎声。\n摇知开吉地，不假问三生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又挽词三首 其一","author":"傅察","text":"萧叶蟠根大，于门结驷新。\n鹓行尊几杖，鹤骨离风尘。\n追挽倾朝绂，褒荣动帝宸。\n惟应两河道，犹想锦衣春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宁节后筵口号","author":"傅察","text":"流虹启圣际千年，湛露洪恩下九天。\n腾踏欢声来击壤，氤氲瑞色散非烟。\n已赓圣代中和颂，更草前贤封禅篇。\n四海岂知蒙帝力，春台此日倍熙然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天宁节前筵口号","author":"傅察","text":"天扶宝运世兴王，庆陋猗兰入画堂。\n千载后观周礼乐，万邦摇奉舜衣裳。\n北门骄子常输赆，南极老人方效祥。\n试向红云瞻魏阙，侍臣应上万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方量牧地次韵工曹王亚叟","author":"傅察","text":"朝廷庶事备成康，郡邑承风底事忙。\n要使幅员无旷土，始知冀北有留良。\n疏狂似我徒劳耳，术业如君讵易量。\n奔走幸容陪笑语，每观醉墨屡琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无逸用前韵见谢复次韵三首 其二","author":"傅察","text":"一麾聊复散馀波，才比淮阴益办多。\n千里宣威憺夏日，三年种德敛秋禾。\n如纶忽听颁新渥，勿药还欣已旧疴。\n却恐九重思治行，蒲轮它日竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无逸用前韵见谢复次韵三首 其一","author":"傅察","text":"藉藉声名自妙年，优优惠化咏来宣。\n宁誇衣锦光前牒，便拟挥金继昔贤。\n秀句屡同歌白雪，高标犹幸视青天。\n自惭不得陪驺御，空想馀风尚凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毛彦谟以其弟彦周出殡见索挽词谨赋一首","author":"傅察","text":"十年乡校叹蹉跎，一日皇恩尽网罗。\n别去谓宜登上第，归来还复遇沉痾。\n秋风但结原鸰恨，晓露空闻蒿里歌。\n荣愿未酬身已殁，平生稽古竟如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同工曹至临洛道中禾黍蔚然喜而作呈朱令","author":"傅察","text":"甘雨初匀岁事时，冥冥造物本无私。\n绿云捲地薰风细，翠浪翻天晓露滋。\n已见郊原深没马，预欣场圃积如坻。\n从来令尹忧民切，短句聊凭一解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次毛彦谟韵","author":"傅察","text":"平生贵异不谋身，率道恂恂范伯孙。\n巷有青衿来问道，家无赤脚可应门。\n抗章曾叩苍龙阙，谠议终开白兽樽。\n见说晚闻多妙教，悠悠浮世更堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵申泮宫直宿早秋四首 其四","author":"傅察","text":"泮宫深闭绛帷空，摇想佳人照绮栊。\n闲倚画屏怜永夜，懒摇纨扇引凉风。\n直疑令史归天上，犹想阳台入梦中。\n展转觉来无一事，日摇槐影桂窗东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵申泮宫直宿早秋四首 其三","author":"傅察","text":"一方明月落长空，万里馀辉锁玉栊。\n蝉韵啾啾来远木，槐云袅袅弄清风。\n共邀载酒陶彭泽，走访谈经戴侍中。\n景物萧然无限思，靓妆应许过墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵申泮宫直宿早秋四首 其二","author":"傅察","text":"皎皎清波满四空，疏林散影弄朦胧。\n援毫欲赋阳台梦，振袂欣乘玉宇风。\n已觉素秋来席上，却疑仙景落壶中。\n凌云未许攀仙桂，卧看冰轮没汉东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵申泮宫直宿早秋四首 其一","author":"傅察","text":"新秋爽气溢长空，弦诵低昂月映栊。\n济济青衿成鲁变，洋洋泮水咏洙风。\n群儒篆刻空章句，百氏纷纭赖折中。\n何日拔才空冀北，如今高誉满山东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵烹茶四首 其四","author":"傅察","text":"仰望群公若会仙，贪论茗饮未安眠。\n冥搜往往游尘外，得句时时在枕前。\n夜漏讴吟清彻骨，晴窗挥染净无烟。\n中秋风月佳辰近，应把云腴对竹煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵烹茶四首 其三","author":"傅察","text":"不但蠲烦起醉仙，能令古莽失多眠。\n春风乍拂千岩上，晓雨初沾百草前。\n绛缕缝囊包紫璧，玉尘凝盌照清烟。\n今人嗤点前人拙，未肯须依古法煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵烹茶四首 其二","author":"傅察","text":"吏隐从人号懒仙，一瓯常及日高眠。\n要令万卷浇胸次，便觉三山到眼前。\n客至不须樽有酒，家贫肯厌突无烟。\n清泉近在南山麓，珍味殊胜渭水煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵烹茶四首 其一","author":"傅察","text":"移种疑从紫府仙，世间凡草护芊眠。\n味高石蜜甘居下，效捷灵芝愧在前。\n玉?并标官焙印，月团犹带御炉烟。\n年来海宇皆知愧，却笑神农未解煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]