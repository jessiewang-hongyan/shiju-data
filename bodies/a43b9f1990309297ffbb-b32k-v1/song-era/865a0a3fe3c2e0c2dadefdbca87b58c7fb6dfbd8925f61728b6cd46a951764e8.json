[{"title":"偈颂一百四十一首 其一三○","author":"释师范","text":"九日当佳节，黄花处处新。\n相逢多醉客，少见独醒人。\n打草只要蛇惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十一","author":"释师范","text":"十字街头道得一句，三家村里使不著。\n三家村里道得一句，十字街头使不著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十一","author":"释师范","text":"我有一语，非甜非苦。\n既遇知音，如何通吐。\n夜来点得柳土獐，如今变成尾火虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十五","author":"释师范","text":"韶光烂熳时，百卉皆妍秀。\n处处有春风，村村自花柳。\n灵云眼里添钉，玄沙袖中出手。\n除非自解倒骑驴，一生不著随人后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○九","author":"释师范","text":"内空外空内外空，四大五蕴不可得，山河大地不可得。\n不可得亦不可得，舜若多神面皮黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二○","author":"释师范","text":"一年十二月，此月乃当尽。\n一月三十日，此日方起头。\n此日即是寻常日，那里是起头处。\n此月即是寻常月，那里是尽头处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三三","author":"释师范","text":"锦包特石，铁裹泥团。\n现成活计，格外乡谈。\n明眼衲僧会不得，月移梅影上栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九","author":"释师范","text":"一叶落，天下秋。\n一尘起，大地收。\n新罗打铁火星飞，烧著庐山罗汉院里王和尚脚指头。\n碛境庙大王忍痛不禁，直得通身汗流。\n起来道恩大难酬，笑倒沩山水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十九","author":"释师范","text":"无味乃真味，真味真无味。\n若知真味者，更不说真味。\n曾闻一饱忘百饥，今日山僧身便走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十一","author":"释师范","text":"佛法也不会，世法也不会。\n一夏九十日，瞎驴随大队。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十九","author":"释师范","text":"春日晴，黄莺鸣。\n山花似锦，汀草如茵。\n堪悲堪笑，公塘寨里王节级到处巡捕，自己不知不觉，打失一双眼睛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十一","author":"释师范","text":"一止一切止，一动一切动。\n入荒田不拣，信手拈来用。\n昨日有人从西川来，却得江东信。\n说道赵州亲见老南泉，镇州萝卜三斤重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三七","author":"释师范","text":"少林消息绝，大地一团铁。\n愁杀寒山子，无言倚寥泬，悲风流水声呜咽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十四","author":"释师范","text":"重阳九月九，个个尽知有。\n吃了茱萸茶，多是眉头皱。\n唯有陶靖节独欢颜，解道采菊东篱下，悠然见南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十","author":"释师范","text":"这老秃，无面目。\n不具些子慈悲，却有十分恶毒。\n喜亦不可近，怒尤不可触。\n我昔被渠禁害，逼得顽蛇生足。\n以至今日烧一炷香谩礼三拜，要且笑不成笑哭不成哭。\n此冤此恨若为伸，唵部临唵齿临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十八","author":"释师范","text":"王道平平，其寿绵绵。\n渔歌樵唱，共乐尧年。\n无为焉，无私焉，乾坤一统旧山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十八","author":"释师范","text":"轻如鸿毛轻，重若丘山重。\n安排不得处，信手拈来用。\n虽是死蛇，却要活弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○四","author":"释师范","text":"炎炎六月，飘风洒雪。\n百丈耳聋，黄檗吐舌。\n海阔山高谁与论，一回饮水一回噎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十二","author":"释师范","text":"阳春曲，无弦琴。\n声偃六律，韵排五音。\n月冷兮风清，山高兮水深，举世有谁知此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十七","author":"释师范","text":"人看人，火照火。\n无杂坏，忘彼我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三一","author":"释师范","text":"七佛已前，无消息处有消息，那个不知。\n七佛已后，有消息处无消息，是人不会。\n知不知，会不会，璞玉浑金，泥团土块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十七","author":"释师范","text":"今朝正月一，只是寻常日。\n就中殊异处，遍界铺银色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十三","author":"释师范","text":"今朝七月一，明朝七月二。\n一日是一日，几个知惭愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十七","author":"释师范","text":"行不动尘，语不动唇。\n现成行货，黄金白银。\n君不见洞山老，问佛直答麻三斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一一","author":"释师范","text":"形名未兆，文彩全彰。\n短者自短，长者自长。\n黄面瞿昙徒自说黄道黑，胡须达磨何须历魏游梁。\n长忆江南二三月，鹧鸪啼处百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十四","author":"释师范","text":"秋高增爽气，夜寒添夹被。\n草虫吟壁根，黄叶飘庭际。\n直得山僧展转返侧，喜而不寐。\n阿呵呵，伸脚元在缩脚里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三二","author":"释师范","text":"一年十二月，只馀此一月。\n此月极尽处，又见明年月。\n循环既无端，何劳强分别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十","author":"释师范","text":"这两个老冻侬，顽处似牛皮，烂处如坏絮。\n虽然各有机关，争奈浑无展处。\n只么低头懡㦬归，不知忘却来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一四","author":"释师范","text":"万籁声沉沉，虚堂夜寂寂。\n不见寒山子，未免空相忆。\n休相忆，元来在这里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三九","author":"释师范","text":"我与这老汉，本自无交涉。\n狭路偶相逢，欢喜成冤结。\n此结不可解，此冤不可雪。\n唵喷喷㗶㗶敕摄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三六","author":"释师范","text":"黄檗树头蜜果，破席袋里珠珍，愈藏愈显，日久日新。\n争似飏从闲壁角，听教人道不逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十二","author":"释师范","text":"击鼓升堂，大众云集。\n佛法有底商量，今日热如昨日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四","author":"释师范","text":"一个是一个，两个是两个。\n东土小释迦，西天胡达磨。\n卞璧骊珠成滞货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十七","author":"释师范","text":"语是谤，寂是诳。\n拟即乖，动即丧。\n明眼人，难近傍。\n绝尘情，忘伎俩。\n江西马大师，南岳让和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其二十八","author":"释师范","text":"一拽石，二搬土。\n三分甜，七分苦。\n粪箕拈起两肩担，飏下钁头无觅处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十二","author":"释师范","text":"正觉山前，双林树下。\n弄假像真，弄真像假。\n临风哮吼戴嵩牛，顾影嘶鸣韩干马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○二","author":"释师范","text":"名不得，状不得，复是何物。\n见得到，用得亲，不由别人。\n有时恁么，有时不恁么，无毛鹞子贴天飞，带角大虫当路卧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其五十五","author":"释师范","text":"秋江清浅时，白露和烟岛。\n支筇寂寞中，望断无人到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十六","author":"释师范","text":"前面是悬崖万仞，后面是荆棘丛林。\n两边烈焰火聚，于中如何转身。\n赵州老汉在青州，作一领布衫重七斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十一","author":"释师范","text":"云从龙，风从虎，圣人作而万物睹。\n雪峰辊三个木毬，禾山老一味打鼓。\n海水扬波，须弥作舞。\n皇天无亲，惟德是辅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一○一","author":"释师范","text":"来无所从，南高峰，北高峰。\n去无所至，东涧水，西涧水。\n幻泡忽灭，證得乌龟成白鳖。\n清风未已，须信高原元不死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十三","author":"释师范","text":"狸奴白牯，相共證明，大难大难。\n碧眼黄头，亦须莽卤。\n黄连甜，甘草苦，发机须是千钧弩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十六","author":"释师范","text":"去年梅，今岁柳。\n颜色馨香，依旧依旧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十九","author":"释师范","text":"一句子，墨漆黑。\n无把柄，有准则。\n碓捣东南，磨推西北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十","author":"释师范","text":"清寥寥，白滴滴。\n匙挑不上，针劄不入。\n是则是，须知花发不干春，切忌寒灰煨杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十五","author":"释师范","text":"临济为睦州所误，雪峰遭岩头毒手。\n没齿衔冤，万世不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十九","author":"释师范","text":"万别千差处，事同一家。\n事同一家时，万别千差。\n太白山前水磨日夜轮转不歇，乳峰寺里参退吃茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十八","author":"释师范","text":"东边有知事，西边有头首。\n山僧赢得倚栏干，尽日仰头看云走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十八","author":"释师范","text":"春日迟迟，春风浩浩。\n灵利衲僧，点即不到。\n唯有东村王大翁，放牛吃我溪边草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十五","author":"释师范","text":"信息既通，奉君尽忠。\n风从虎兮云从龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一三五","author":"释师范","text":"春色依依，花木芳菲。\n满眼满耳，绝毫绝釐。\n惟有子规知此意，一声声道不如归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二七","author":"释师范","text":"一处通，处处通，手头活落，脚下玲珑。\n常记南泉提起处，刈禾镰子快如风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十七","author":"释师范","text":"住亦无可说，去亦无可说。\n窦八布衫穿，金刚嚼生铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其九十三","author":"释师范","text":"拟即差，动即隔。\n忘伎俩，绝声色。\n两手揶揄懡㦬休，东村有个王大伯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十","author":"释师范","text":"寻常月是中秋月，中秋月是寻常月。\n看来真个只寻常，道是寻常又还别。\n别别，无物堪比伦，教我如何说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其四十六","author":"释师范","text":"迦叶擎拳，阿难合掌。\n黄面瞿昙，全无伎俩。\n新乳峰一时见了，却烧沉香供养。\n从教人道是罚是赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一四一","author":"释师范","text":"九旬今已满，那事竟如何。\n无为无事人，往往成蹉跎。\n育王敢道不蹉跎，少年曾决龙蛇阵，老倒还同稚子歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二二","author":"释师范","text":"春风浩浩，春雨绵绵。\n花凝晓露，柳带寒烟。\n造化无作而作，万法不然而然。\n达磨九年空面壁，善财走得脚皮穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十三","author":"释师范","text":"乳峰今日开炉，不会挑灰拨火。\n大家衲被幪头，只么团圞打座。\n不求诸圣，不重己灵。\n从他门外区区，世路扰扰红尘。\n夏了秋，秋了冬，冬了春，思量也是慕西秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十六","author":"释师范","text":"一不得收，二不得放。\n是则迦叶擎拳，非则阿难合掌，志公不是闲和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一○","author":"释师范","text":"拄杖子，难摸索。\n有时喜，有时恶。\n搅动沧溟，冲开碧落，何如普化摇铃铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十二","author":"释师范","text":"摩腾入汉，平地风波。\n达磨西来，重增殃祸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十五","author":"释师范","text":"客从远方来，遗我径寸璧。\n中有四个字，不必重拈出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一一九","author":"释师范","text":"一阳生，万汇生。\n正当生，作么生。\n群阴消殄，吾道大亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十","author":"释师范","text":"作家相见，有底凭据。\n迥无人处，聚头共语。\n寂子无端撼茶树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其十四","author":"释师范","text":"鹤唳于天，鱼跃于渊。\n涵波泳月兮悠悠，乘云驭风兮翩翩。\n时哉时哉，不可得而明焉，令人长忆老南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其八十八","author":"释师范","text":"今朝九月九，谈禅不开口。\n若是陶渊明，攒眉便回首。\n篱边黄菊正芬披，一枝两枝三枝四五六七枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十二","author":"释师范","text":"万木惊霜风，千林著秋色。\n堪笑寒山子，到处觅不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其七十五","author":"释师范","text":"面面相看，眼眼厮觑。\n衣外别传，有甚凭据。\n倒却门前刹竿著，凤栖不在梧桐树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其三十九","author":"释师范","text":"你不识我，我不识你。\n狭路相逢，脑门著地。\n仁者见之谓之仁，智者见之谓之智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其六十四","author":"释师范","text":"声前一句，不封不树。\n坐断舌头，如何通吐。\n昨日有人从天台来，却往径山去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百四十一首 其一二一","author":"释师范","text":"声前句，量外机。\n明历历，峭巍巍。\n举者既少，见者亦稀。\n抖擞多年穿破衲，褴毵一半逐云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]