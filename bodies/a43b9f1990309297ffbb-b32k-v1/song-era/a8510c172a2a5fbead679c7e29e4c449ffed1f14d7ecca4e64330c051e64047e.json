[{"title":"走笔和袁起岩元夕前一夜雪作","author":"杨万里","text":"天公极意办元宵，顷刻挼云作雪飘。\n茂苑长洲花剪玉，苏台香径砌成瑶。\n千灯剩喜开红药，两鬓还惊插素标。\n客子孤舟寒折骨，无端诗伯苦相撩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔送赵正则司户来访归觐亲庭","author":"杨万里","text":"捧檄亲庭归帽斜，肯临破屋玉川家。\n小留诗客三杯酒，试看山园几处花。\n君到东湖与南浦，时当芍药替金沙。\n却来书满参卿考，径泛银河犯斗槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔谢吉守赵判院分饷三山生荔子","author":"杨万里","text":"吾州五马住闽山，分我三山荔子丹。\n甘露落来鸡子大，晓风冻作水晶团。\n西川红锦无此色，南海绿罗犹带酸。\n不是今年天不暑，玉肤照得野人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"足痛无聊块坐读江西诗","author":"杨万里","text":"两脚遍云水，群书久网丝。\n却因三日痛，理得数编诗。\n不借双高挂，毋追一任欹。\n老来非爱病，不病亦何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛丑正月二十五日游蒲涧晚归","author":"杨万里","text":"桃李深酣日，池塘浅试春。\n霁晖摇远水，新暖软游人。\n生酒清无色，青梅脆有仁。\n烟钟能底急，催我入城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯五月送丘宗卿太博出守秀州二首 其二","author":"杨万里","text":"老矣渠怜我，超然我爱渠。\n论诗春雨夜，解手藕花初。\n梦只江湖去，情知伎俩疏。\n未应五马贵，不寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛卯五月送丘宗卿太博出守秀州二首 其一","author":"杨万里","text":"冯翊端谁可，丘迟肯去么。\n茧丝臣敢后，饥馑帝云何。\n身达当难免，能称未要多。\n但无田里叹，不必裤襦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥元日送章德茂自建康移帅江陵二首 其二","author":"杨万里","text":"西湖一别忽三年，白首相从岂偶然。\n到得我来恰君去，政当腊后与春前。\n醉馀犯雪追征帽，送了凭栏望去船。\n待把衣冠挂神武，看渠勋业上凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛亥元日送章德茂自建康移帅江陵二首 其一","author":"杨万里","text":"极知借寇未多时，道是徵黄有近期。\n不割半青江令宅，却飞大白习家池。\n湖山解语云来暮，淮水无情也去思。\n莫近乡关动归兴，轻黄一点上双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近节","author":"杨万里","text":"节里非无事，忙中自有闲。\n因风烦白鸟，折简唤青山。\n诗卷一两册，斋房三四间。\n兴来长得句，却道在尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故太师左丞相魏国文忠京公挽歌辞三首 其三","author":"杨万里","text":"柏府公峨豸，荆溪我把麾。\n闻风无半面，折简两相知。\n偕掾胶投漆，分襟云与泥。\n楼成扁山浦，洒泪欠题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故太师左丞相魏国文忠京公挽歌辞三首 其二","author":"杨万里","text":"镇蜀双清献，回天再子明。\n何曾动声色，一笑付权衡。\n临绝缘忧国，平生不近名。\n中兴贤相传，日月夺光精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故太师左丞相魏国文忠京公挽歌辞三首 其一","author":"杨万里","text":"孝庙深知己，今皇正宰官。\n一言能定国，二圣得重欢。\n立节山相似，容人海未宽。\n至今死诸葛，虏使胆犹寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故魏国夫人卢氏挽歌辞三首 其三","author":"杨万里","text":"素节勤仍俭，清风冷似冰。\n秋衣孟光布，夜绩敬姜灯。\n拱木霜何早，同茔雪政凝。\n郎君一夔足，再看九霄鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故魏国夫人卢氏挽歌辞三首 其二","author":"杨万里","text":"唐代崔家母，升堂乳阿姑。\n姑言吾报妇，孙孝妇如吾。\n此段前无古，夫人独与俱。\n祇看秦国语，更恐李唐无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"近故魏国夫人卢氏挽歌辞三首 其一","author":"杨万里","text":"胄出开元相，贤称魏国嫔。\n祇教纪彤管，不见转鸿钧。\n瓜葛春风里，蘋蘩南涧滨。\n古今书列女，仁孝几何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迓使客夜归四首 其四","author":"杨万里","text":"病身已怯九秋凉，也复移樽下砌傍。\n只爱杯中都是月，不知身上寸深霜。\n清愁旧觉天来远，寒夜新添岁样长。\n不是傍人俱欲睡，老人无睡亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迓使客夜归四首 其三","author":"杨万里","text":"起视青天分外青，满天一点更无星。\n忽惊平地化成水，乃是月华光满庭。\n笔下何知有前辈，醉中未肯赦空瓶。\n儿曹夜诵何书册，也遣先生细细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迓使客夜归四首 其二","author":"杨万里","text":"病后霜威不见饶，吟边月色苦相撩。\n重帘垂地寒犹入，画烛无风影自摇。\n谁遣尘埃空老去，何曾鸥鹭不吾招。\n坐来已是愁无奈，草露虫声政寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迓使客夜归四首 其一","author":"杨万里","text":"去时岸树日犹明，归到州桥月已升。\n水与天争一轮玉，市声人语两街灯。\n迎来送往须成雪，索笔题诗砚欲冰。\n净洗红尘烦碧酒，倦来不觉睡腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"连天观望春忆毗陵翟园","author":"杨万里","text":"中和节后社前时，春到园林最晚枝。\n弄水不冰携扇手，登台犹粟向风肌。\n鸟乌声里山光湿，花柳阴中日脚迟。\n北望翟园春正闹，海棠锦绕雪酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰五月十四日因哭小孙子蓬孙归志浩然","author":"杨万里","text":"宪孙哭了哭蓬孙，老眼元枯也湿巾。\n名宦何须深插脚，山林从此早抽身。\n祸无避处唯辞福，命不如渠强学人。\n吟了此诗还毁了，莫令一读一伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风乡口一日诘朝船进雨作再小泊雷江三首 其三","author":"杨万里","text":"山已多姿了，云仍太劣生。\n浓横半岭白，淡扫数峰青。\n照水影颠倒，迎曦时晦明。\n吾泓不孤杀，天赐碧瑶屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风乡口一日诘朝船进雨作再小泊雷江三首 其二","author":"杨万里","text":"幸自无多雨，其如不酽晴。\n响窗疏复密，晕水灭还生。\n燕竞波中影，山凝岛外情。\n残春只五日，留取作江行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风乡口一日诘朝船进雨作再小泊雷江三首 其一","author":"杨万里","text":"朔吹憎船进，东暾让雨行。\n云移青嶂动，鸦度白云明。\n淹泊宁吾愿，吟哦且客情。\n江边一株柳，憔悴似馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风泊黄浦","author":"杨万里","text":"回顾山阳北，前瞻宝应东。\n又逢翻手雨，更著打头风。\n不了行程债，从来赋命穷。\n客愁无诉处，摇指画船篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈安行舍人阁学挽词三首 其三","author":"杨万里","text":"我昔游璧水，公时宿石渠。\n重来十钻火，两省共周庐。\n小语趋丹陛，嘉招煮雪蔬。\n破心搜诔些，泪落不能书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈安行舍人阁学挽词三首 其二","author":"杨万里","text":"循吏今为冠，高文妙草麻。\n龚黄低一著，班左共三家。\n风度春无价，身名玉绝瑕。\n可怜人士泪，滴损紫薇花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈安行舍人阁学挽词三首 其一","author":"杨万里","text":"妫水祀百世，莆田生此公。\n贤如太丘长，忠似了斋翁。\n玉色犹山立，皇居折栋隆。\n孝宗最知己，交臂火城红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈商卿挽辞","author":"杨万里","text":"远绪传妫水，高风似太丘。\n萱堂鱼跃雪，兰砌鹗横秋。\n杖屦疏金谷，莺花冷玉舟。\n行看紫鸾纸，告第贲松楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈能之少卿殿撰挽诗","author":"杨万里","text":"玉立颂台上，风生宪府中。\n雪霜欺两鬓，日月照孤忠。\n荷橐相将紫，铭旌作么红。\n北堂萱草露，应洒碧梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭罢登山","author":"杨万里","text":"树远通莺响，花晴带雨痕。\n登山偶回首，隔水见前村。\n澹往孤无伴，清归笑不言。\n还家更迟著，松菊未应存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭罢登净远亭","author":"杨万里","text":"今岁寒应少，冬深气转和。\n都缘径差曲，添得步行多。\n柳色犹青在，霜威奈尔何。\n忽然双野鸭，飞下一池波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到龙山头","author":"杨万里","text":"影静长安道，凉风响辔衔。\n海天低到水，江日晚明帆。\n潮遣先驱壮，声吞绝岛巉。\n黄尘征袖满，却愧著朝衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周子及监簿挽诗二首 其二","author":"杨万里","text":"投老欣相得，论心恨较迟。\n披文流涕疏，分韵泛湖诗。\n天夺过逢乐，人兴殄瘁悲。\n何须金马客，解制玉楼辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周子及监簿挽诗二首 其一","author":"杨万里","text":"科目连双中，声名莫二渠。\n手曾攀折槛，客有泣辞车。\n速化非吾事，偷闲只古书。\n黑头黄壤去，有昊定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丁端叔喜雪","author":"杨万里","text":"天将一雪净乾坤，便恐汤泉亦不温。\n瑶草忽生无种子，梅花寒损要温存。\n清游未到先回棹，高卧何如且闭门。\n珍重故人贻妙语，追还正始最初元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人七夕","author":"杨万里","text":"爱月斜仍细，占星久未过。\n浪传商用事，正苦汗成河。\n蛛喜今宵缀，蝇憎昨日多。\n吾文那乞巧，诗或拟阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和马公弼夜雨","author":"杨万里","text":"一雨未辞泥至腰，新寒疠气喜全消。\n都人得此正希阔，远客幡然成寂寥。\n声在疏檐与黄叶，梦听禁漏近丹霄。\n愁心却被诗勾引，始觉君家我里遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尤延之见戏触藩之韵以寄之","author":"杨万里","text":"侬爱山行君水游，尊前风味独宜秋。\n文戈却日玉无价，器宝罗胸金欲流。\n欬唾清圜谈者诎，诗章精悍古人羞。\n子房莫笑身三尺，会看功成自择留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文远以作醮相疏","author":"杨万里","text":"涉夏天勤雨，今年定有秋。\n试思冲热出，何似带泥游。\n轩冕关庄子，江湖著魏牟。\n高人香火里，也到酒边不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文远叔行春","author":"杨万里","text":"行脚宜晴翠，看云恐夕黄。\n何村不花柳，此社要柴桑。\n一笑当谁领，同来得许忙。\n老怀翻作恶，不剩半分狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文明主簿叔见寄之韵二首 其二","author":"杨万里","text":"黄九陈三外，诸人总解诗。\n甘心休作许，苦语竟何为。\n所向公同我，何缘样入时。\n从来大小阮，一笑更谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和文明主簿叔见寄之韵二首 其一","author":"杨万里","text":"古声弹九寡，妙学足三多。\n十载才重见，百年当几何。\n入州非不肯，出伏即相过。\n安得看云语，金盆仄白河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王才臣","author":"杨万里","text":"新诗不但不饶侬，便恐阴何立下风。\n每与胜谈千古事，不知拨尽一炉红。\n生儿底巧翁何恨，得子销愁我未穷。\n剩欲苛留老三径，念渠何罪亦山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王才臣再病二首 其二","author":"杨万里","text":"诗瘦知春瘦，时乖抑命乖。\n病过三日雨，门掩半扉柴。\n不面何曾久，于心便有怀。\n端能暮出否，溪水减南涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王才臣再病二首 其一","author":"杨万里","text":"燕外将心远，莺边与耳谋。\n如何再卧病，对此两添愁。\n赤壁还坡老，黄楼只子由。\n二苏三赋在，一览病应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王元驹","author":"杨万里","text":"向来淮海说三秦，脚踏苏门最绝尘。\n莫道江山歇英气，如今文物有斯人。\n黄埃九陌谁知子，青竹千年独问津。\n未得相看已相识，只惭空叹蜀庄珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王司法雨中惠诗二首 其二","author":"杨万里","text":"无那诗愁著莫人，风颠雨急更昏昏。\n登临无地可散策，剥啄阿谁来叩门。\n安得与渠呼玉酒，醉馀同看落金盆。\n斋厨索寞如悬罄，惭愧酸寒遣一尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和司法张仲良醉中论诗二首 其一","author":"杨万里","text":"醉语醒犹记，来诗读转新。\n不缘朋好密，其奈客居贫。\n无乃阳秋误，云何鼠朴珍。\n端令和者寡，敢以速为神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和司法张仲良醉中论诗二首 其二","author":"杨万里","text":"相过宁嫌数，未行先畏辞。\n要宽千里别，犹费几篇诗。\n意得翻难售，声希只自奇。\n此生诗社里，三折或知医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良春晚即事五首 其四","author":"杨万里","text":"贫难聘欢伯，病敢跨连钱。\n梦岂花边到，春俄雨里迁。\n一犁关五秉，百箔候三眠。\n只有书生拙，穷年垦纸田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良春晚即事五首 其二","author":"杨万里","text":"春在已愁热，夏来还解凉。\n一年又如许，万事更须忙。\n情薄忘花减，心危愿岁穰。\n平生只坐懒，何药疗嵇康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良春晚即事五首 其三","author":"杨万里","text":"欲与东风说，休吹堕絮飞。\n吾行正无定，魂梦岂忘归。\n花暖能醺眼，山浓欲染衣。\n只嫌春已老，此景也应稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲良病中耽睡","author":"杨万里","text":"居士何曾病，群儿错见怜。\n对床正风雨，落纸忽云烟。\n欲夏花全退，犹寒柳尚眠。\n如何睡乡里，只是著诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘德脩用黄文叔韵赠行","author":"杨万里","text":"碧玉长篙黄篾篷，两淮烟月五湖风。\n金梭织锦烦诗匠，琼尺裁云补化工。\n去路江山随意绿，归时桃杏断肠红。\n岷峨二妙贻双璧，万丈光芒照病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和同年李子西通判","author":"杨万里","text":"走马看花拂绿杨，曲江同赏牡丹香。\n向来年少今俱老，君拜监州我作郎。\n北阙小迟苍玉佩，南征聊制芰荷裳。\n病身只作家山梦，径菊诗葩两就荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和同年梁韶州寺丞次张寄诗","author":"杨万里","text":"故人一别恰三年，谁与论诗更说禅。\n忽报一麾官岭外，寄来七字雪梅前。\n人惟南内班行旧，语带西湖山水鲜。\n安得对床吟至晓，旋烹山茗试溪泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和巩采若游蒲涧","author":"杨万里","text":"南中道是岛夷居，也有安期宅一区。\n屐齿苔痕犹故迹，霓旌鸾佩已清都。\n元戎解领三千骑，胜日来寻九节蒲。\n万壑松风和涧水，鸣琴漱玉自相娱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和庆长怀麻阳叔二诗 其二","author":"杨万里","text":"自幼仍投老，相欢不解愁。\n政缘湖外别，负却竹林秋。\n佳政真馀事，闻人说甚休。\n不应野水渡，横此济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和庆长怀麻阳叔二诗 其一","author":"杨万里","text":"旧雪才追送，新梅又作繁。\n欣逢上林雁，聊免管城冠。\n酒债多多在，诗盟久久寒。\n忽思十年事，有枕不能安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易公立投赠之句","author":"杨万里","text":"日者论文各少年，中间岁月似风旋。\n老来书册惟生睡，里许生涯未苦贤。\n好句撩人那得懒，胜流觅纸便争传。\n诗坛正欠风骚将，君合为真不用权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和余处恭赠方士阎都干","author":"杨万里","text":"河出昆崙江出岷，风吹不断浪花春。\n但看此水源无竭，底用玄谈谷有神。\n老健便为仙放杖，斧斤祗在袜生尘。\n东家自有仁山诀，方士何曾悟一真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴寺丞喜雪","author":"杨万里","text":"珠唾银钩赠一通，炯如密雪堕寒空。\n飞来数片不沾袖，剪出六花全是风。\n骨冷魂清残醉里，日光玉洁晚晴中。\n先生秀句今无敌，谁诵相如奏舜瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张功父送黄蔷薇并酒之韵","author":"杨万里","text":"海外蔷薇水，中州未得方。\n旋偷金掌露，浅染玉罗裳。\n已换桃花骨，何须贾氏香。\n更烦曲生辈，同访墨池杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]