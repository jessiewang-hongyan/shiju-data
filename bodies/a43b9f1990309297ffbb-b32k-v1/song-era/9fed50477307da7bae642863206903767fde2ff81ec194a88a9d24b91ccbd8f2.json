[{"title":"初春书怀七首 其二","author":"陆游","text":"耄及光阴古更稀，自今惟有数期颐。\n食观本草虽多事，醉读离骚自一奇。\n物外有人闲始见，山中可乐老方知。\n武陵好在桃千树，短棹相寻亦未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春书怀七首 其七","author":"陆游","text":"愚公不解计安危，行尽人间恶路岐。\n难似车登蛇退岭，险如舟过马当祠。\n平生忧患常难测，送老安闲敢自期。\n一事不成应有命，惟将知止报明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春书怀七首 其一","author":"陆游","text":"六十馀年慕古人，即今方近葛天民。\n见人各是元非恕，遇事皆安岂怨贫。\n小圃锄耰聊过日，扁舟烟雨尚关身。\n出门未觉龙钟在，禹庙兰亭又见春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春书怀七首 其六","author":"陆游","text":"纳禄贫如筮仕初，归来依旧卧蜗庐。\n半池墨沈临章草，一碗松肪读隐书。\n长镵仅供饥子美，清江不疗渴相如。\n耄期自许诗情在，雪里犹能跨蹇驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春书怀七首 其三","author":"陆游","text":"数掩芦藩并水居，一家全似业樵渔。\n春寒例谢常来客，老病犹贪未见书。\n驯雀正缘抛食惯，芳兰肯为碍门锄。\n药苗满钵无人共，赖有溪僧为破除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春书怀七首 其四","author":"陆游","text":"甫及初春日已长，偶同邻曲集山房。\n囊盛古墨靴纹皱，箬护新茶带胯方。\n老境不嫌来冉冉，流年直恐去堂堂。\n清泉冷浸疏梅蕊，共领人间第一香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春杂兴五首 其一","author":"陆游","text":"戏续春寒赋，闲赓午醉诗。\n煎茶小石鼎，酌酒古铜卮。\n曝日龟浮沼，营巢鹊堕枝。\n村深无客过，幽兴与谁期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春杂兴五首 其三","author":"陆游","text":"问途来野店，秣蹇憩山邮。\n何处无诗思，平生惯旅愁。\n翩翩下鸥鹭，点点散羊牛。\n传入王孙画，千金未易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春杂兴五首 其四","author":"陆游","text":"故岁愁听雨，新春剩得晴。\n暖催红蕊闹，涨入绿池平。\n游马行争路，华灯卖满城。\n江村独无事，户户及时耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春杂兴五首 其二","author":"陆游","text":"水长鸥初泛，山寒茗未芽。\n深林闻社鼓，落日照渔家。\n渡远呼船久，桥倾取路斜。\n客愁慵远眺，不是怯风沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春杂兴五首 其五","author":"陆游","text":"老病倦游陟，偶寻溪友期。\n残冰拥鱼笱，新暖入桑枝。\n山崦巨然画，烟村摩诘诗。\n何人为收拾，愧我不能奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春幽居二首 其二","author":"陆游","text":"小筑园林浅凿池，身闲随事得游嬉。\n幽花折得露犹湿，嘉木移来根不知。\n小蝶弄晴飞不去，珍禽喜静语多时。\n风光未忍轻抛掷，聊付诗囊与酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春幽居二首 其一","author":"陆游","text":"满榼芳醪手自携，陂湖南北埭东西。\n茂林处处见松鼠，幽圃时时闻竹鸡。\n零落断云斜鄣日，霏微过雨未成泥。\n老民不预人间事，但喜农畴渐可犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春探花有作","author":"陆游","text":"灯山昨梦叹匆匆，便恐新春过眼空。\n千缕未摇官柳绿，一梢初放海棠红。\n金羁络马闲游处，彩笔题诗半醉中。\n流落天涯何足道，年年常策探花功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春晚晴","author":"陆游","text":"雪尽冰消敛积威，参差碧瓦带斜晖。\n土膏渐释人东作，天气初和雁北归。\n小阁金船尝腊酒，华堂银烛制春衣。\n关心虽有寻梅梦，冷蕊幽香事已非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春欲散步畏寒而归","author":"陆游","text":"峭寒漠漠入重貂，酒力欺人凝不消。\n春困苦多无处卖，客魂欲断倩谁招。\n一溪水浅梅枝瘦，四野云酣雪意骄。\n欲到前村无奈懒，却寻归路度西桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春感怀","author":"陆游","text":"关河谢远游，岁月迫归休。\n敢恨骥伏枥，但思狐首丘。\n雪明窗误晓，霜点鬓惊秋。\n羁旅饶愁思，谁怜季子裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春感事二首 其一","author":"陆游","text":"马迹车声是处忙，经旬无客到龟堂。\n水初泛溢黏天绿，梅欲飘零特地香。\n世事纷纷人自老，岁华冉冉日初长。\n百钱不办旗亭醉，空爱鹅儿似酒黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春感事二首 其二","author":"陆游","text":"一树红梅已半残，破裘也复敌春寒。\n忍穷过日却差易，负愧终身良独难。\n活火静看茶鼎熟，清泉自注研池宽。\n人生乐处君知否，万事当从心所安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春遣兴","author":"陆游","text":"闲愁长与病相依，晨起梳头感发稀。\n春事鼎来风更恶，晨光已满雪犹飞。\n江梅有恨论年别，旅雁无情计日归。\n剩欲湖边踏青去，凭谁为解乱书围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春遣兴三首 其一","author":"陆游","text":"烂熟思来怕热官，退飞心地喜轻安。\n舍鱼正可取熊掌，食肉何须知马肝。\n放眼柳梢初暗动，褪花梅子已微酸。\n典衣剩作江头醉，莫谓天涯苦鲜欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春遣兴三首 其二","author":"陆游","text":"大隐悠悠未弃官，俸钱虽薄却心安。\n人方得意矜蜗角，天岂使予为鼠肝。\n佳日剧棋忘旅恨，短衣驰射压儒酸。\n小桃杨柳争时节，载酒江头罄一欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋四首 其二","author":"陆游","text":"藉草沾衣露，沿溪掠面风。\n桐凋无茂绿，莲老有疏红。\n小彴攲危度，邻园曲折通。\n新秋得强健，一笑莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋四首 其三","author":"陆游","text":"初夜月犹淡，入秋风已清。\n萤孤无远照，蝉断有遗声。\n命薄惭勋业，才疏负圣明。\n青鞋若耶路，亦足慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋","author":"陆游","text":"雨气排残暑，风声送早秋。\n拂窗闻叶落，绕井看萤流。\n卧起须人助，炊舂尚自谋。\n萧条岁将晚，百虑入搔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋","author":"陆游","text":"湿萤相逐照高栋，又见一年风露秋。\n流落江湖常踽踽，扫平河洛转悠悠。\n簿书终日了官事，尊酒何时宽客愁。\n拟倩天风吹梦去，浩歌起舞散花楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋四首 其一","author":"陆游","text":"生世元浮脆，人言七十稀。\n耄期今已及，气力固应微。\n食冷常忧过，追凉每念归。\n入秋才几日，卷簟换缣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋小疾效俳谐体","author":"陆游","text":"宿疢逢秋剧，衰容逐日添。\n专房一竹几，列屋万牙签。\n遣闷凭清圣，忘情付黑甜。\n晚来风月好，一笑捲疏帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋山中作","author":"陆游","text":"万里西风吹幅巾，即今真个是闲人。\n堆盘菱熟燕脂角，藉藻鲈新淡墨鳞。\n姥岭蹇驴寻雪径，娥江孤艇系烟津。\n飘然乐事真当勉，远付十年无此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋书感","author":"陆游","text":"流年冉冉不容追，馀息厌厌只自知。\n马革裹尸违壮志，鹿门采药卜幽期。\n林蝉委蜕仙何远，巢燕成雏去已迟。\n触事尔来多感慨，北窗闲赋早秋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋自述","author":"陆游","text":"平生偶有爱山僻，垂老常无沽酒资。\n破屋颓垣吾已矣，大冠长剑汝为谁。\n邮亭历历关河远，鬓发萧萧岁月移。\n残暑不禁随手过，东篱又近菊花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋即事二首 其一","author":"陆游","text":"帘栊雨过不胜清，秋气依依似有情。\n高栋尚馀双燕宿，短莎先放百虫鸣。\n挑灯剩欲开书帙，擘蟹时须近酒觥。\n却愧邻家常作苦，探租黄犊待寒耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋即事二首 其二","author":"陆游","text":"老来阅世苦匆匆，又见流年入鬓蓬。\n山径湿萤黏露草，井床病叶霣秋风。\n邻翁每共藜羹味，稚子能终汗简功。\n造物于人元不薄，未须抵掌叹囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋夜坐","author":"陆游","text":"徂岁又如许，吾生真若浮。\n露蝉鸣达晓，风叶堕先秋。\n野迥星辰大，天空河汉流。\n胡床幸亡恙，且复寄悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋夜赋二首 其二","author":"陆游","text":"炎熇犹末伏，清绝忽新秋。\n露气房栊冷，砧声岁月遒。\n悲蛩草根语，孤磷竹间流。\n闻道河南北，飞蝗暗百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋夜赋二首 其一","author":"陆游","text":"北斗垂欲尽，明河淡不流。\n低回半枕梦，萧瑟一窗秋。\n老益尊儒术，闲仍为国忧。\n孰云生死大，却已付悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋骤凉","author":"陆游","text":"我比严光胜一筹，不教俗眼识羊裘。\n沧波万顷江湖晚，渔唱一声天地秋。\n饮酒何尝能作病，登楼是处可消忧。\n名山海内知何限，准拟从今更烂游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"白白餈筒美，青青米果新。\n衰迟重时节，薄少遍乡邻。\n梅市花成幄，兰亭草作茵。\n极知欢意尽，强起伴游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其一","author":"陆游","text":"床有蒲团坐负墙，室无童子自烧香。\n人图作佛虽堪笑，我爱逃禅亦太狂。\n樱笋久忘晨入省，莼鲈犹喜老还乡。\n汗青未绝茶经笔，那暇投文吊战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"笋生遮狭径，溪涨入疏篱。\n渐及分秧候，还当煮茧时。\n雨昏鸡共懒，米尽鼠同饥。\n村巷无来客，清羸只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"淡霭轻飔入夏初，一窗新绿鸟相呼。\n出门易倦常归卧，著句难工但自娱。\n花径蝶闲无堕蕊，酒楼人散有空垆。\n闽川茶笼犹沾及，肺渴朝来顿欲苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"麦秀微寒后，梅黄细雨前。\n湖滩初集鹭，堤柳未鸣蝉。\n琴带轻阴润，巾因小醉偏。\n晚来幽兴极，又上钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其二","author":"陆游","text":"梅子生仁已带酸，楝花堕地尚微寒。\n室无长物惟空榻，头不加巾但小冠。\n蚕簇倚墙丝盎起，稻秧经雨水陂宽。\n郊原清润身差健，剩欲闲游一跨鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其二","author":"陆游","text":"江乡初夏暑犹轻，霁日园林有晚莺。\n聊置尊罍师北海，尽除屏障学东平。\n绿槐露湿单衣爽，红药风翻病眼明。\n每感流年成绝叹，白头自笑未忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"雨足移秧后，风和剥茧初。\n昏昏时就枕，贸贸却寻书。\n晚步身须杖，晨兴发废梳。\n满城车马客，谁复问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏二首 其一","author":"陆游","text":"新绿阴中燕子飞，数家烟火自相依。\n童誇犊健浮溪过，妇闵蚕饥负叶归。\n地暖小畦花汞长，泥融幽径药苗肥。\n却居乐事何堪数，一醉旗亭又典衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"已作梅黄雨，犹馀麦秀寒。\n穿林红练带，拔地碧琅玕。\n酒向愁边薄，衣从病后宽。\n所欣消渴减，乳酪正甘酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"陆游","text":"百叶盆榴照眼明，桐阴初密暑犹清。\n深深帘幕度香缕，寂寂房栊闻燕声。\n细煅诗联凭棐几，静思棋劫对楸枰。\n浣花光景应如昨，回首西州一怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏山中","author":"陆游","text":"又报东皇促驾归，醉中阙赋送春诗。\n佛瓶是处见红药，僧榻有时闻子规。\n野客款门聊倒屣，溪潭照影一轩眉。\n年光佳处惟初夏，儿女纷纷讵得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏书感","author":"陆游","text":"春与人俱老，花随梦已空。\n游蜂黏落蕊，轻燕接飞虫。\n桑悴知蚕起，牲肥赛麦丰。\n为农当自力，相戒勿匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏出游三首 其三","author":"陆游","text":"泥黦棕鞋雨垫巾，闲游又送一年春。\n长歌聊对圣贤酒，羸病极知朝暮人。\n废堞荒郊闲吊古，朱樱青杏正尝新。\n桃源自爱山川美，未必当时是避秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏出游三首 其一","author":"陆游","text":"早缘疏拙遂归耕，晚为沉绵得养生。\n药镵钓竿缘已熟，海村山市眼偏明。\n安西万里人何在，广武千年恨未平。\n但使莲峰归路稳，亦无闲手揖公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏出游三首 其二","author":"陆游","text":"平生与世旷周旋，惟有清游意独便。\n小灶炊菰山市口，束刍秣蹇海云边。\n春融恨欠舒长日，秋爽已悲摇落天。\n首夏清和真妙语，为君诵此一欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏北窗二首 其一","author":"陆游","text":"作墨无声紫玉池，年光又入放翁诗。\n风和柳岸吹绵后，雨足瓜畦引蔓时。\n病酒相如无奈渴，清言叔宝不胜羸。\n此生岂复功名事，付与城头画角悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏北窗二首 其二","author":"陆游","text":"水际柴荆昼不开，卧听微雨杂轻雷。\n春蚕满箔眠初起，社燕争巢去复来。\n海桧屈蟠依怪石，山榴零落点苍苔。\n一樽及此风光美，车下长坡底用推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏同桑甥世昌过邻家","author":"陆游","text":"空谷旧生涯，萧条只自嗟。\n妻馋嗔护笋，儿病失浇花。\n赤米老能饱，浊醪贫可赊。\n徵科幸差简，扶杖过邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴六首 其二","author":"陆游","text":"巾脱冠攲八尺床，竹阴槐影有馀凉。\n随风花堕残棋上，引睡书抛倦枕傍。\n水长沙鸥向人熟，雨馀巢燕哺雏忙。\n尚嫌未惬幽情在，又唤渔舟渡野塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴五首 其一","author":"陆游","text":"隐趣与谁论，深居湖上村。\n避兰宁改路，惜笋不开园。\n庭草饶生意，溪沙记涨痕。\n愁来时浅酌，随事有鸡豚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴五首 其四","author":"陆游","text":"移花得微雨，晒药遇新晴。\n闷里家书到，贫时籴价平。\n身方抱沉疾，天乃相馀生。\n莫恨村醪薄，灯前与细倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴六首 其六","author":"陆游","text":"终日颓然蠹简中，门前烟水浩无穷。\n百年等是一枯冢，四海应无两放翁。\n栗玉长枝挑苦笋，胭脂小把剪防风。\n地偏日永闲无事，拟著珍蔬谱一通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴五首 其二","author":"陆游","text":"避寂诸缘息，安贫百虑宽。\n懒如常抱疾，退似本无官。\n皎洁鹤翎扇，嵯峨龟屋冠。\n何劳问唐举，彻屋是清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴六首 其四","author":"陆游","text":"缪算狂言悔莫追，杜门省事不妨奇。\n攲倾淡墨诗成后，缥缈乌巾浴出时。\n筇杖闲行穿密筱，绳床移坐照清漪。\n眼边好景真须惜，渐近浮生结局时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴五首 其三","author":"陆游","text":"咄咄无穷事，腾腾暂寓身。\n月生知改朔，花尽觉经春。\n市鬨朝沽酒，巫歌夜乐神。\n兴来随众出，一笑不妨新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴六首 其一","author":"陆游","text":"老子今朝不用扶，雨凉百病一时苏。\n扇题杜牧故园赋，屏对王维初雪图。\n把钓溪头蹋湍濑，煎茶林下置风炉。\n个中莫谓无同赏，逋客能从折简呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂兴六首 其三","author":"陆游","text":"自断残年莫问天，吾侪何处不随缘。\n家贫却得身差健，夜短何妨昼熟眠。\n未历名山采灵药，且从同社乐丰年。\n卖丝粜麦偿逋负，犹有馀钱买钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂咏五首 其五","author":"陆游","text":"昔日江湖上，飘然无定居。\n频倾京口酒，亦食武昌鱼。\n北首心空壮，东归愤不摅。\n岂知牙齿落，送老一茆庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂咏五首 其二","author":"陆游","text":"病退身仍健，年侵趣更高。\n芳醪溢蛮榼，短褐束郿绦。\n本不营三窟，何由挫一毫。\n烟帆几时挂，长啸破秋涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]