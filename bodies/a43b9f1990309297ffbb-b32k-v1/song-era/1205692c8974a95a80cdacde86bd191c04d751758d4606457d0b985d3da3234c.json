[{"title":"先蚕六首 其六 送神用《祥安》。","author":"郊庙朝会歌辞","text":"神之功兮，四海所宗。\n占五帝兮，莫与比崇。\n倏往来兮，旌骑容容。\n恭明祀兮，万世无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先蚕六首 其三 奠币用《娭安》。","author":"郊庙朝会歌辞","text":"皇天降物，屡化若神。\n圣实先识，躬以教民。\n功被天下，为万世文。\n币以达志，庶几彻闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先蚕六首 其二 升降用《翊安》。","author":"郊庙朝会歌辞","text":"掩抑笙箫，铿谹金石。\n神来宴娭，嘉我休德。\n奉祀之臣，洗心翊翊。\n锡兹福禧，以惠四国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先蚕六首 其一 迎神用《明安》。","author":"郊庙朝会歌辞","text":"生民之朔，衣皮而群。\n惟圣有作，被冒以文。\n礼乐以成，贵贱以分。\n欲报之德，金石谐均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其十三","author":"郊庙朝会歌辞","text":"天心仁佑，坤德世昭。\n灼有慈范，著于累朝。\n俭以赞虞，勤以承尧。\n是用则效，共励夙宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其十二","author":"郊庙朝会歌辞","text":"光佑晏宁，惠慈燕喜。\n寿仁并崇，家邦均祉。\n懿文交举，壶册嗣美。\n维亿万年，爱敬惟似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其十一","author":"郊庙朝会歌辞","text":"象服之文，鹊巢之风。\n化以妇道，觐于内宫。\n采蘋涧滨，采藻涧中。\n夙夜在公，赞彼累功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其八","author":"郊庙朝会歌辞","text":"帝奉太室，后仪成之。\n帝养三宫，后志承之。\n德如关雎，盛如螽斯。\n宜君宜王，百世本支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其七","author":"郊庙朝会歌辞","text":"翚珩焕采，趋节风韶。\n陟降墄陛，奉将英瑶。\n辟道承薰，嫔仪扬翘。\n是敬是祗，德音孔昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其三","author":"郊庙朝会歌辞","text":"金晶丽辉，璧叶含春。\n赞夏之翼，绎虞之嫔。\n乐序韶亮，礼文藻新。\n辟公相成，物采彬彬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年皇后册宝十三首 其一","author":"郊庙朝会歌辞","text":"乾健坤顺，群生首资。\n日常月升，四时叶熙。\n帝嗣天历，后崇母仪。\n黼黻承晖，王化是基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十四","author":"郊庙朝会歌辞","text":"荣怀之庆，莫盛于斯。\n三宫四册，五叶一时。\n德阜而丰，福大而滋。\n子子孙孙，于时保之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其五","author":"郊庙朝会歌辞","text":"纯佑我宋，母仪四朝。\n拥翼孙谋，如虞承尧。\n仁覃函夏，喜浮庆霄。\n福禄万年，金玉孔昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十五","author":"郊庙朝会歌辞","text":"宋有明德，天保佑之。\n以寿继寿，以慈广慈。\n声文宣昭，福祉茂绥。\n神孙之休，燕及华夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十七","author":"郊庙朝会歌辞","text":"上帝有赫，百灵效祥。\n储祉垂恩，锡年降康。\n皇仪睟温，帝躬肃庄。\n三宫齐欢，地久天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其三","author":"郊庙朝会歌辞","text":"太任媚姜，涂山翼禹。\n慈祥曼衍，鸿仪迭举。\n宝章奕奕，祲宫俣俣。\n帝用将之，于彼宫所。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十三","author":"郊庙朝会歌辞","text":"文母曼寿，载锡之光。\n总集瑞命，宜君宜王。\n惠以仁显，慈以德彰。\n保佑子孙，受福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其九","author":"郊庙朝会歌辞","text":"缛仪既登，宝册既膺。\n喜洽祥流，云烝川增。\n天子万年，鸣玉慈庭。\n惠我无疆，诜诜绳绳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十二","author":"郊庙朝会歌辞","text":"尧门叠瑞，姒幄齐辉。\n重坤靖夷，丽册华徽。\n天子仁圣，礼文弗违。\n福寿康宁，同燕层闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十四","author":"郊庙朝会歌辞","text":"华鸾编玉，文螭液金。\n颂德摛英，扬徽嗣音。\n紫幄天开，翠华日临。\n岁岁年年，如周太任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十三","author":"郊庙朝会歌辞","text":"黼黻其文，金玉其相。\n永寿于万，合德无疆。\n福绪祥源，厥后克昌。\n天维格斯，祚我圣皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其八","author":"郊庙朝会歌辞","text":"徽光宣华，仁声流文。\n旷仪合沓，泰和絪缊。\n慈颜有喜，祚我圣君。\n珠宫含饴，坐阅来云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其七","author":"郊庙朝会歌辞","text":"曾孙致养，五福骈臻。\n太极所运，两仪三辰。\n辉光日新，启佑后人。\n永翼瑶图，亿万尧春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其四","author":"郊庙朝会歌辞","text":"东朝层邃，端闱靖深。\n列仗节銮，镂玉绳金。\n来奉来崇，载祗载钦。\n曾孙之庆，世世徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其一","author":"郊庙朝会歌辞","text":"天拥帝家，泽流子孙。\n三宫燕胥，四海崇尊。\n声谐韶濩，辉烛瑶琨。\n维皇缉熙，耀德乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十六","author":"郊庙朝会歌辞","text":"大安耽耽，兴庆崇崇。\n维皇之尊，与天比隆。\n非心閒燕，文命延鸿。\n欲报之恩，礼缛仪丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其六","author":"郊庙朝会歌辞","text":"神人和怿，天日淑清。\n王母来燕，必寿而名。\n琨庭璈音，五云佩声。\n勉勉我皇，遹昭厥成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二","author":"郊庙朝会歌辞","text":"祖后重寿，亲闱并崇。\n骈庆联休，申景铺鸿。\n叠璧交辉，多仪焕丛。\n亿万斯年，福禄攸同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十","author":"郊庙朝会歌辞","text":"天地清宁，日月华光。\n归尊慈极，嵩呼未央。\n庆函百嘉，寿跻八荒。\n上皇万岁，俾炽俾昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十一","author":"郊庙朝会歌辞","text":"三礼崇容，八銮警卫。\n有来辰仪，阐徽妫汭。\n璇宫肃雍，藻景澄霁。\n文子文孙，本支百世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其二十一","author":"郊庙朝会歌辞","text":"晨趋慈幄，佳气郁葱。\n受帝之祉，配天其崇。\n璧华金精，礼敷乐充。\n天子是若，欢声融融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十八","author":"郊庙朝会歌辞","text":"夏典稽瑞，禹玉含淳。\n追琢有章，温润孔纯。\n圣底于安，寿绵于仁。\n太上立德，自天其申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十九","author":"郊庙朝会歌辞","text":"父尊母亲，天涵地育。\n燕我翼子，景命有仆。\n得名得寿，如金如玉。\n子孙千亿，成其厚福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆元二年恭上太皇太后皇太后太上皇帝太上皇后尊号二十四首 其十","author":"郊庙朝会歌辞","text":"新庭靖安，祖后燕怡。\n有开圣谋，累崇天基。\n典章文明，声容葳蕤。\n御于邦家，曰寿曰慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至道元年册皇太子二首 其二","author":"郊庙朝会歌辞","text":"皇储既建，圣祚无疆。\n鸾旌列叙，鸡戟分行。\n前星有烂，瑞日重光。\n际天接圣，温文允臧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至道元年册皇太子二首 其一","author":"郊庙朝会歌辞","text":"主鬯之重，允属贤明。\n承华肇启，上嗣腾英。\n礼修乐举，育德开荣。\n一人元良，万邦以宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋初祀神州地祇三首 其三 送神用《静安》。","author":"郊庙朝会歌辞","text":"献奠云毕，纯嘏祁祁。\n威灵藏用，邈矣何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋初祀神州地祇三首 其二 奠玉币、酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"肸蚃储灵，肃恭用币。\n锵洋导和，洪休允契。\n嘉气云蒸，浃于华裔。\n式荐坤珍，聿符明世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其六 送神用《祥安》。","author":"郊庙朝会歌辞","text":"神之来矣，灵风肃然。\n云胡不留，归旐有翩。\n乃举旧典，岁以告虔。\n降福我邦，于万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其五 亚、终献用《惠安》。","author":"郊庙朝会歌辞","text":"日吉辰良，礼备乐作。\n精诚内孚，俎豆交错。\n升歌清越，侑此三爵。\n黎民不寒，幽显同乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其四 酌献用《美安》。","author":"郊庙朝会歌辞","text":"盛服承祀，出自公桑。\n衣不羽皮，利及万方。\n百味旨酒，有飶其香。\n神其歆止，洋洋在傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其三 奠币用《娱安》。","author":"郊庙朝会歌辞","text":"化日初长，时当暮春。\n蚕事方兴，惟后惟嫔。\n丝纩御冬，残生济人。\n敢忘报本，篚币是陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其二 初献盥洗、升殿用《翊安》。降同。","author":"郊庙朝会歌辞","text":"灵修戾止，诏以毛血。\n既盥而帨，尊爵蠲洁。\n金石谐宛，登降有节。\n宜顾宜飨，情文不越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祀先蚕六首 其一 迎神用《明安》。","author":"郊庙朝会歌辞","text":"功被寰宇，㒩虫之灵。\n有神司之，以生以成。\n典礼有初，祀事讲明。\n孔盖翠旌，降集于庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 送神用《理安》。","author":"郊庙朝会歌辞","text":"神灵降鉴，天地回旋。\n惟馨荐矣，既醉歆焉。\n诸宰斯彻，式礼莫愆。\n隤祉降祥，天子万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"币玉肃陈，笙簧具举。\n桂醑浮觞，琼羞溢俎。\n礼有三献，式和且序。\n神具醉止，庆流寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 宣明王位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"广大建祀，式崇其配。\n馨香在兹，清酒既载。\n穆穆有晖，洋洋如在。\n聿怀嘉庆，繄神之赉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 大辰位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"庶功备矣，休德昭明。\n天地酿和，郁鬯斯清。\n玉瓒以酌，瑶觞载盈。\n周流常羊，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"万汇攸成，四方宁谧。\n工祝致告，普存民力。\n乃荐斯牲，为俎孔硕。\n介以繁祉，式和民则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 商丘宣明王位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"恭惟火正，自陶唐氏。\n邑于商丘，配食辰祀。\n有功在民，有德在位。\n敢替典常，惟恭奉币。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 大辰位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"金行序晚，玉露晨清。\n齐戒丰洁，肃恭神明。\n嘉币惟量，嘉玉惟精。\n于以奠之，庶几来听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"猗与明坛，右平左墄。\n冕服斯皇，玉佩有节。\n陟降惟寅，匪徐匪疾。\n式崇大祀，礼文咸秩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 其四 降神用《高安》。","author":"郊庙朝会歌辞","text":"明明我后，重祭钦祠。\n有司肃事，式荐晨仪。\n礼惟其称，物惟其时。\n神之听之，福禄来为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 其三 降神用《高安》。","author":"郊庙朝会歌辞","text":"季秋之月，律中无射。\n农事备收，火功告毕。\n克禋克祀，有严有翼。\n风马云车，尚其来格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 其二 降神用《高安》。","author":"郊庙朝会歌辞","text":"火星之躔，有烨其光。\n表于辰位，伏于戌方。\n时和岁稔，仁显用藏。\n告尔万民，出纳有常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳火祀大辰十二首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"赫赫皇图，炎炎火德。\n侈神之赐，奄有方国。\n粢盛既丰，俎豆有飶。\n于万斯年，报祀无斁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟夏雩祀二首 其二 酌献用《感安》。","author":"郊庙朝会歌辞","text":"龙见而雩，神之来格。\n牺象精良，威灵赫奕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟夏雩祀二首 其一 太祖配坐奠币用《献安》。","author":"郊庙朝会歌辞","text":"昊天盖高，祀事为大。\n严配皇灵，亿福来介。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其二十","author":"郊庙朝会歌辞","text":"爱始于亲，圣尽伦兮。\n元子冠字，邦礼成兮。\n天步舒徐，皇心宁兮。\n家人之吉，亿万春兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十九","author":"郊庙朝会歌辞","text":"玄衮黼裳，垂徽永世。\n勉勉成德，是在元子。\n胙土南宾，厥旨孔懿。\n充一忠字，作百无愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十八","author":"郊庙朝会歌辞","text":"青社分封，前星启燄。\n繁弱绥章，厥光莫掩。\n容称其德，蓄学之验。\n芳誉敷华，大圭无玷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十七","author":"郊庙朝会歌辞","text":"皇王烝哉，令闻不已。\n燕翼有谋，冠醮有礼。\n百僚在庭，遹相厥事。\n颂声所同，嘉受帝祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十六","author":"郊庙朝会歌辞","text":"命服煌煌，跬步中度。\n庆辑皇闱，化行海宇。\n礼具乐成，惕若戒惧。\n宝璐厥躬，有秩斯祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十五","author":"郊庙朝会歌辞","text":"席于宾阶，礼义以兴。\n受爵执爵，多福以膺。\n匪惟服加，德加愈升。\n匪惟德加，寿加愈增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十四","author":"郊庙朝会歌辞","text":"善颂善祷，三加弥尊。\n爵弁峨峨，介圭温温。\n阳德方长，成德允存。\n燕及君亲，厥祉孔蕃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十三","author":"郊庙朝会歌辞","text":"冠醮之义，匪酬匪酌。\n于户之西，敬共以恪。\n金石相宣，冠醮相错。\n帝祉之受，施及家国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宝祐二年皇子冠二十首 其十二","author":"郊庙朝会歌辞","text":"复爻肇祥，震维标德。\n乃共皮弁，其仪不忒。\n体正色齐，维民之则。\n璇霄眷佑，国寿箕翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]