,"collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题放翁像二首 其二","author":"刘克庄","text":"诗倍太白子美，年高辕固伏生。\n却鹤膝枝身健，读蝇头书眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题放翁像二首 其一","author":"刘克庄","text":"三百篇寂寂久，九千首句句新。\n譬宗门中初祖，自过江后一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画六言一首","author":"刘克庄","text":"子猷无乘兴舟，越石有长啸楼。\n雪灭千山踪迹，月照几家乐愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题诚斋像二首 其二","author":"刘克庄","text":"平园左相亚传，澹庵资政端明。\n老先生活八十，中秘书了一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题诚斋像二首 其一","author":"刘克庄","text":"欧阳公屋畔人，吕东莱派外诗。\n海外咸推独步，江西横出一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题研六言四首 其四 第四砚","author":"刘克庄","text":"眼如胡僧之碧，口如老庞之吸。\n子云要伴玄草，添丁勿翻墨汁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题研六言四首 其三 第三砚","author":"刘克庄","text":"无驳杂者其色，不磷缁者其德。\n方岩求之不得，后村不求而获。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题研六言四首 其二 第二砚","author":"刘克庄","text":"其面固已晬然，其背贵不可言。\n宁捧以供李白，勿举以掷郑畋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题研六言四首 其一 第一砚","author":"刘克庄","text":"嘘呵肌理泉润，拊摩德性玉温。\n可谓无毫发恨，何曾犯斧凿痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵昌花一首","author":"刘克庄","text":"赵叟生长太平，以著色花擅名。\n自古良工独苦，于今墨画盛行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题桃源图一首","author":"刘克庄","text":"但记嬴二世尔，岂知晋太康耶。\n一境浑无租税，四时长有桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"儒释","author":"刘克庄","text":"鹅湖始若小异，虎溪岂必皆同。\n平亭晦庵子静，捏合渊明远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者陈达夫六言二首 其二","author":"刘克庄","text":"樗翁书题闲慢，万言不直豪芒。\n夺了巡官行货，搀他太卜牙郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者陈达夫六言二首 其一","author":"刘克庄","text":"昔有君平季主，今无韩慥林开。\n终日垂帷闭肆，或时戴笠盘街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谢子杰校勘六言三首 其三","author":"刘克庄","text":"功名随露电过，文字与星斗垂。\n吾评潞公五福，何如放翁万诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谢子杰校勘六言三首 其二","author":"刘克庄","text":"唤做呆子憨子，管他火星孛星。\n造物小儿则剧，先生大醉未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠谢子杰校勘六言三首 其一","author":"刘克庄","text":"高比伏生辕固，热瞒贾谊朱忠。\n我自号病居士，君无戏盲老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠碧眼相士六言二首 其二","author":"刘克庄","text":"荀卿子论心形，许负书说气色。\n我虽□□□□，□□看未成碧。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠碧眼相士六言二首 其一","author":"刘克庄","text":"耳白无盖世名，眼碧有奇中语。\n老夫定非醉翁，斯人莫是初祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一剪梅 其二 余赴广东，实之夜饯于风亭","author":"刘克庄","text":"束缊宵行十里强。\n挑得诗囊，抛了衣囊。\n天寒路滑马蹄僵，元是王郎，来送刘郎。\n酒酣耳热说文章。\n惊倒邻墙，推倒胡床。\n旁观拍手笑疏狂，疏又何妨，狂又何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一剪梅 其一 袁州解印","author":"刘克庄","text":"陌上行人怪府公。\n还是诗穷，还是文穷。\n下车上马太匆匆，来是春风，去是秋风。\n阶衔免得带兵农。\n嬉到昏钟，睡到斋钟。\n不消提岳与知宫，唤作山翁，唤作溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 雁","author":"刘克庄","text":"物微生处远，往还来、非但稻粱求。\n似爱长安日，怕阴山雪，善自为谋。\n个里幸无鸣镝，随意占沙洲。\n归兴何妨待，风景和柔。\n昔到衡阳回去，今随阳避地，遍海南头。\n与西川流寓，彼此各淹留。\n未得云中消息，登望乡台了又登楼。\n江天阔，几行草字，字字含愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其四 良翁礼部生日","author":"刘克庄","text":"开阁广延贤，负扆勤求旧。\n应念南宫老舍人，闲袖丝纶手。\n两制必当仁，五福无过寿。\n且喜新年不要□，天要开元祐。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其一 惜海棠","author":"刘克庄","text":"尽是手成持，合得天饶借。\n风雨于花有底雠，著意相陵藉。\n做暖逼教开，做冷催教谢。\n不负明年花下人，只负栽花者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子","author":"刘克庄","text":"自入玄门户，寂寂清虚做。\n静里披搜四假身，勘破尘行路。\n悟上还重悟，得得真闲趣。\n收住身中无价真，岂逐人情去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其五 曹守生朝十二月初六日","author":"刘克庄","text":"东圳宁馨儿，南国循良守。\n先把炉熏祝帝尧，次祝君侯寿。\n广致米商船，多酿兵厨酒。\n客有须眉似盖延，许至华堂否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其七 茉莉","author":"刘克庄","text":"老圃献花来，异域移根至。\n相对炎官火伞中，便有清凉意。\n淡薄古梳妆，娴雅仙标致。\n欲起涪翁再品花，压了山矾弟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其三","author":"刘克庄","text":"乱似盎中丝，密似风中絮。\n行遍茫茫禹迹来，底是无愁处。\n好客挽难留，俗事推难去。\n惟有翻身入醉乡，愁欲来无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其六 燕","author":"刘克庄","text":"已怪社愆期，尚喜巢如故。\n过了清明未肯来，莫被春寒误。\n常傍画檐飞，忽委空梁去。\n忘却王家与谢家，别有衔泥处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 其二","author":"刘克庄","text":"片片蝶衣轻，点点猩红小。\n道是天公不惜花，百种千般巧。\n朝见树头繁，暮见枝头少。\n道是天公果惜花，雨洗风吹了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六州歌头 其二 客赠牡丹","author":"刘克庄","text":"维摩病起，兀坐等枯株。\n清晨里，谁来问，是文殊。\n遣名姝。\n夺尽群花色，浴才出，酲初解，千万态，娇无力，困相扶。\n绝代佳人，不入金张室，却访吾庐。\n对茶铛禅榻，笑杀此翁臞。\n珠髻金壶。\n始消渠。\n忆承平日，繁华事，修成谱，写成图。\n奇绝甚，欧公记，蔡公书。\n古来无。\n一自京华隔，问姚魏、竟何如。\n多应是，彩云散，劫灰馀。\n野鹿衔将花去，休回首、河洛丘墟。\n漫伤春吊古，梦绕汉唐都。\n歌罢欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰阁","author":"刘克庄","text":"元规端委，得似幼舆丘壑。\n人言此辈宜高阁。\n几载种天随菊，采庞公药。\n龙尾道、难安汗脚。\n浮荣菌蕣，选甚庶官从橐。\n对床句、子真佳作。\n安用羡伊结驷，叹侬罗雀。\n呼便了、沽来共酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 其一 暮春","author":"刘克庄","text":"游人绝。\n绿阴满野芳菲歇。\n芳菲歇。\n养蚕天气，采茶时节。\n枝头杜宇啼成血。\n陌头杨柳吹成雪。\n吹成雪。\n淡烟微雨，江南三月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 其五","author":"刘克庄","text":"梅谢了。\n塞垣冻解鸿归早。\n鸿归早。\n凭伊问讯，大梁遗老。\n浙河西面边声悄。\n淮河北去炊烟少。\n炊烟少。\n宣和宫殿，冷烟衰草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 其二 上巳","author":"刘克庄","text":"修禊节。\n晋人风味终然别。\n终然别。\n当时宾主，至今清绝。\n等闲写就兰亭帖。\n岂知留与人闲说。\n人闲说。\n永和之岁，暮春之月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 其三","author":"刘克庄","text":"泥滑滑。\n一声声唤征鞍发。\n征鞍发。\n客亭杨柳，不禁攀折。\n荀郎衣上香初歇。\n萧郎心下书难说。\n书难说。\n霎时吹散，一生愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 其四","author":"刘克庄","text":"春酲薄。\n梦中球马豪如昨。\n豪如昨。\n月明横笛，晓寒吹角。\n古来成败难描摸。\n而今却悔当时错。\n当时错。\n铁衣犹在，不堪重著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其二 癸卯生日","author":"刘克庄","text":"病翁将耳顺，牙齿落、鬓毛疏。\n也惭愧君恩，放还田舍，免诣公车。\n儿时某丘某水，到如今、老矣可樵渔。\n宝马华轩无分，蹇驴破帽如初。\n浮名箕斗竟成虚。\n磨折总因渠。\n帝锡余别号，江湖聱叟，山泽仙臞。\n樽前未宜感慨，事犹须、看岁晏何如。\n卫武耄年作戒，伏生九十传书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其六 赵叟生日","author":"刘克庄","text":"郡人元未识，新太守、定何如。\n待说向诸贤，西桥人物，个个清臞。\n相将下车许久，但凝香之乐一些无。\n残漏几筹视事，浓油一盏观书。\n旁人徒见两轮朱。\n玉色未尝腴。\n有无穷阴骘，三农衣食，万衲钟鱼。\n尔侬迎新送旧，似君侯、清约更谁欤。\n欲举一杯寿酒，却愁破费兵厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其八 客赠牡丹","author":"刘克庄","text":"维摩居士室，晨有鹊、噪檐声。\n排闼者谁欤，冶容袨服，宝髻珠璎。\n疑是毗耶城里，那天魔、变作散花人。\n姑射神仙雪艳，开元妃子春酲。\n鄜延第一次西京。\n姚魏是知名。\n向欧九记中，思公屏上，描画难成。\n一自朝陵使去，赚洛阳、花鸟望升平。\n感慨桑榆暮景，抉挑草木微情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其四 丁未中秋","author":"刘克庄","text":"水亭凝望久，期不至、拟还差。\n隔翠幌银屏，新眉初画，半面犹遮。\n须臾淡烟薄霭，被西风扫尽不留些。\n失了白衣苍狗，夺回雪兔金蟆。\n乘云径到玉皇家。\n人世鼓三挝。\n试自判此生，更看几度，小住为佳。\n何须如钩似玦，便相将、只有半菱花。\n莫遣素娥知道，和他发也苍华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其七 己未生日","author":"刘克庄","text":"新来衰态见，书懒读，镜休看。\n笑量窄才悭，卷无警策，杯有留残。\n思量减些年甲，怎奈何、须与鬓难瞒。\n假使诏催上道，不如敕放还山。\n数年前乞挂衣冠。\n耄矣尚盘桓。\n且行歌拾穗，未应天上，解胜人间。\n仙家更无理会，至今传、都厕处刘安。\n莫怪是翁矍铄，止缘老子痴顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其一 寿王实之","author":"刘克庄","text":"瀛洲真学士，为底事、在红尘。\n为语触宫闱，沈香亭里，瞋谪仙人。\n为亲近君侧者，见万言策子惎刘蕡。\n为是尚方请剑，汉廷多惮朱云。\n君言往事勿重陈。\n且斗酒边身。\n也不会区区，算他甲子，记甚庚寅。\n尔曹譬如朝菌，又安知、老柏与灵椿。\n世上荣华难保，古来名节如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 其五 渔父词","author":"刘克庄","text":"海滨蓑笠叟，驼背曲、鹤形臞。\n定不是凡人，古来贤哲，多隐于渔。\n任公子、龙伯氏，思量来岛大上钩鱼。\n又说巨鳌吞饵，牵翻员峤方壶。\n磻溪老子雪眉须。\n肘后有丹书。\n被西伯载归，营丘茅土，牧野檀车。\n世间久无是事，问苔矶、痴坐待谁欤。\n只怕先生渴睡，钓竿拂著珊瑚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其四","author":"刘克庄","text":"平生酷爱渊明，偶然一出归来早。\n题诗信意，也书甲子，也书年号。\n陶侃孙儿，孟嘉甥子，疑狂疑傲。\n与柴桑樵牧，斜川鱼鸟，同盟后、归于好。\n除了登临吟啸。\n事如天、莫相咨报。\n田园闲静，市朝翻覆，回头堪笑。\n节序催人，东篱把菊，西风吹帽。\n做先生处士，一生一世，不论资考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其八","author":"刘克庄","text":"即令七十平头，岂能久作人间客。\n左车牙落，半分臂小，几茎须白。\n挟种树书，举障尘扇，著游山屐。\n任蛙蟆胜负，鱼龙变化，侬方在、华胥国。\n岛大功名官职。\n眼中花、须臾无迹。\n小儿破贼，二郎作相，有何奇特。\n同辈萧疏，且留铁汉，要摩铜狄。\n向宝钗楼里，天津桥上，月明横笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其十五 林中书生日六月十九日","author":"刘克庄","text":"鬳斋不是凡人，海山仙圣知来处。\n清英融结，佩瑶台月，饮金茎露。\n翰墨流行，禁中有本，御前停箸。\n向弘文馆里，薰风殿上，亲属和、微凉句。\n已被昭阳人妒。\n更那堪、鼎成龙去。\n曾传宝苑，曾将玉杵，付长生兔。\n地覆天翻，河清海浅，朱颜常驻。\n算给扶朝者，临雍拜者，下梢须做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其十四","author":"刘克庄","text":"病夫鬓秃颜苍，不堪持向清溪照。\n一生枘凿，壮夫瞋懦，通人嫌拗。\n让当行家，勒浯西颂，草淮南诏。\n幸脱离沮洳，浮游江海，悠然逝、毋吞钓。\n宴坐蒲团观妙。\n怪痴儿、舂粮求道。\n古人尚齿，迎他商皓，拜他庞老。\n鸠杖蒲轮，把身束缚，替人愁恼。\n煞为僧不了，下梢犹要，紫衣师号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其二","author":"刘克庄","text":"先生放逐方归，不如前辈抽身早。\n台郎旧秩，看来俗似，散人新号。\n起舞非狂，行吟非怨，高眠非傲。\n叹终南捷径，太行盘谷，用卿法、从吾好。\n闭了草庐长啸。\n后将军来时休报。\n床头书在，古人出处，今人非笑。\n制个淡词，呷些薄酒，野花簪帽。\n愿云台任满，又还因任，赛汾阳考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其十三","author":"刘克庄","text":"此翁饱阅人间，三生似是刘宾客。\n若论辈行，早陪韩柳，晚交元白。\n老矣安能，为人取履，与人争屐。\n叹酒泉郡远，醉乡路绝，今何处、堪开国。\n解去冰衔华职。\n遍空山、难寻行迹。\n道旁喘月，田间卧草，也胜郊特。\n宰相□□，周公留召，娄公容狄。\n喜时平身健，三行社饮，一声樵笛。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其十一","author":"刘克庄","text":"先生避谤山栖，戒门不纳高轩客。\n谁欤来者，吟诗张碧，诙谐侯白。\n礼数由他，谢郎著帽，王郎穿屐。\n且问花随柳，举杯邀月，那须预、人家国。\n香案旁边供职。\n鸟飞空、何曾留迹。\n臞翁铁汉，两贤安在，百夫之特。\n但愿王师，早俘颉利，早禽长狄。\n便太平无事，卖薪沽酒，骑牛腰笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 其五 辛亥安晚生朝","author":"刘克庄","text":"祁公一度貂蝉，先生三度貂蝉了。\n燔柴升辂，银蟾烛夜，金乌腾晓。\n喜动龙颜，瑞班虹玉，归功元老。\n纵擎天力倦，明农心切，先还取、中书考。\n末著留侯难办，算除非、烦他商皓。\n紫芝产遍，赤松待久，何时高蹈。\n人世无过，鱼羹饭美，布衾铭好。\n待角巾东路，蹇驴北阜，伴公游钓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 己亥自寿二首 其一","author":"刘克庄","text":"年年岁岁今朝，左弧悬罢浑无事。\n吾衰久矣，我辰安在，老之将至。\n懒写京书，怕看除目，败人佳思。\n把东篱掩定，北窗开了，悠然酌、颓然睡。\n客有过门投贽。\n道先生访华胥氏。\n谁能辛苦，陪他绮语，记他奇字。\n屈指先贤，戴花老监，岂其苗裔。\n待异时约取，宽夫彦国，入耆英会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 自和前二首 其三","author":"刘克庄","text":"病翁一榻萧然，不知世有欢娱事。\n雀罗庭院，载醪客去，催租人至。\n报答秋光，要些酒量，要些诗思。\n奈长鲸罢吸，寒蛩息响，茶瓯外、惟贪睡。\n穷巷幸无干贽。\n或相过、莫知谁氏。\n柴门草户，阙人守舍，任伊题字。\n自和山歌，国风之变，离骚之裔。\n待从今向去，年年强健，插花高会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":33722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]