[{"title":"句","author":"释居昱","text":"松声和雨听，山色带云看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月大风大水 其一","author":"释居简","text":"十日溪头鹢退飞，相逢那暇问雄雌。\n不如二月春风好，草木无情亦去思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白衣文简净人呈度牒","author":"释居简","text":"袖出天书喜动容，从来汗马不言功。\n长鞭未举追风去，回首相寻异类中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白荷花","author":"释居简","text":"数亩澄漪不用耕，移根玉井不曾耘。\n羽衣何处霓裳遍，翠盖参差踏水云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白莲雨后渐衰","author":"释居简","text":"晓池芳柄袅残馨，褪雨攲风鹭委翎。\n碧展一奁秋练练，似怜玉色镜中零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"安藏主","author":"释居简","text":"尽教佛性自瞒顸，终日如愚已自谩。\n不是较渠三十里，平生穿凿不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庵居即事","author":"释居简","text":"欲过东家怕渡桥，欲题黄叶怕随潮。\n经旬不踏门前路，陡顿苍苔绿色饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"矮僧求颂","author":"释居简","text":"见说矮人多计较，大家知道不曾藏。\n只将丈六金襕挂，莫与诸方论短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灞桥风雪图","author":"释居简","text":"桥滑驴僵噤不嘶，诗穷弗死反穷诗。\n华山也是吟疆土，更欲烦君写倒骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白马金砂洞","author":"释居简","text":"准拟朝餐洞口霞，更穷泓碧涨桃花。\n可曾石罅潴成玉，多是金边拣得沙。\n符说有灵寻汉篆，人因鉴止见胡麻。\n依稀似入天台路，不属刘家与阮家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鸡谢静讲师湖州旧馆","author":"释居简","text":"素羽剪零云，冠裁辰锦新。\n德如潮有信，雄压牝无晨。\n物化寤非蝶，蚁酣惊代邻。\n莫教风雨暝，缄口却羞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月大风大水 其二","author":"释居简","text":"零落茅茨水半扉，媪颦翁蹙小儿啼。\n老鸡不管丰凶事，独自将雏树上栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月廿七风雨大浸","author":"释居简","text":"左扼飞廉吭，右拊巽二背。\n谓云如何其，坐使六鹢退。\n亦有司雨工，絷如系单于。\n不卷油然云，自欲干剪屠。\n乡来不鸣条，块亦不曾破。\n卿云千点明，华月半天堕。\n衮衣徂东山，拔木仍偃禾。\n至今东山诗，千载犹咏歌。\n悠然启金縢，风反雨亦止。\n是中果何书，顷刻变天纪。\n流言久弗作，狐亦不复疑。\n至诚动真宰，风雨胡不知。\n风雨不我以，我稼已堕水。\n不知十日淫，滴碎田父心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白苧歌","author":"释居简","text":"经纱才上机，梭飞玉攕攕。\n怕君寻春迟，落机宽裁衫。\n春心乱如蓬，冉冉随春霏。\n芳径晓沾露，软尘红上衣。\n归来恨尘污，湔衣浣纱处。\n难湔芳露痕，易湔衣上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白藕花","author":"释居简","text":"一楮三年工，欲赋无三都。\n剪作千叶芳，出水渊不枯。\n照影秋湛染，摇柄春敷腴。\n夜老勺华月，侧此华玉壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白藕花寄袁状元仓使","author":"释居简","text":"澄练彻山脉，玉透山池沙。\n老火奋残烁，凛姿燉不瑕。\n方方秋一奁，弹压红万葩。\n安得濂溪叟，来赋东林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白蘋洲新楼曰溪山伟观","author":"释居简","text":"溪头烟煖蘋花春，岂独满渚亦满汀。\n春城绮绣艳溪曲，柔玉掺掺歌采蘋。\n采采芳鲜日将暮，玉盌琼盂旋分贮。\n水晶阙冷禁城宽，兰棹夷犹缓归去。\n乡来小亭横水浒，雨震风凌日榛莽。\n山鬼啸梁猿啸渚，寂寞风烟向谁诉。\n仙槎忽从银浦来，吟疆开拓搜吟才。\n眼前有句未暇著，只著画楼临水开。\n一双浮图笔插架，层级高低与楼亚。\n从来天巧不曾藏，纷纷俗眼空茫羊。\n赋此须还造楼手，大苏小杜相先后。\n柳恽才华更有馀，那堪一等爱楼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀三城","author":"释居简","text":"岁逢虎牛祸折萌，荡荡蜀道犹可评。\n嗾奸反正善其计，振槁拉枯徒尔勤。\n初虽覆杯可扑灭，终焉决海难为平。\n智人三尺眼前暗，明玉一玷磨弗晶。\n因仍扰扰不知了，残金欲灺连鞑人。\n武功夙著冲与寔，貂蝉贵欲兜牟成。\n孽成孤凤鸟不度，守有可死生无因。\n两公气节固相类，又类射虎飞将军。\n西和寅仲出儒素，开禧总饷先垂名。\n太丘是父有是子，冲楼跨灶前无伦。\n话头讲明有定见，不与奸谄相因循。\n犬戎日众我日寡，貔貅乍屈还乍信。\n贺兰饱鲜方醉醇，啮指不雠南霁云。\n恸哭秦庭不肯援，有严玉帐无分兵。\n借令空弮可持满，飞镝已尽风中鸣。\n三城父兄一时陷，况复骨肉怀亲亲。\n有生必死死有所，此死可羞尸素群。\n矜韬衒略谩蠢蠢，妒功嫉效徒逡逡。\n幸灾之迹弗容掩，不掉之尾何足云。\n乡来益昌倡大义，阿源流芳千载荣。\n胜天倘可恃人众，公道莫于行路听。\n后先忠节贯日星，野史孰愈良史真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"按曲图","author":"释居简","text":"八茧蚕抽独茧丝，舞衣嫌重要纤絺。\n君王自按霓裳曲，直到坡前驻马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咄庵","author":"释居简","text":"咄地一下，好肉剜疮。\n更安名字，雪上加霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂示学者","author":"释居静","text":"十门纲要掌中施，机会来时自有为。\n作者不须排位次，大都首尾是根基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"住东岩","author":"释居静","text":"月生一，东岩乍住增愁寂。\n红尘世路有多端，米面仓储无颗粒。\n崖为伴，泉为匹，飒飒清风来入室。\n山王土地暗中忙，云版钟鱼偷泪滴。\n世人莫道空守岩，亦有东篱打西壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游黄山","author":"释岩隐","text":"芒鞋踏遍翠微中，拭目群峰势插空。\n石罅迸泉珠跳白，山花落涧锦浮红。\n一天星澹猿啼晓，万壑云生虎啸风。\n药臼丹垆经世远，轩皇曾此驾飞虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释建","text":"兔马有角，牛羊无角。\n绝毫绝釐，如山如岳。\n针锋上师子翻身，藕窍中大鹏展翼。\n等闲突过北俱卢，日月星辰一时黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其二","author":"释弥光","text":"儿时曾向山前住，老大还归山上来。\n云外堂前逢蔡柳，大家拍掌笑咍咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和参政李汉老","author":"释弥光","text":"胡床稳坐已通津，何处更寻不二门。\n八苦起时全体现，不知谁解报深恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和学士吴元昭","author":"释弥光","text":"通身一穿金锁骨，正眼观来犹剩物。\n纵使当机觌面提，敢保居士犹未彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释弥光","text":"家家尽看野狐儿，见者虽多识者稀。\n百怪千妖俱扫迹，春风已到万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释弥光","text":"生铁铸就昆崙儿，头轻脚重肚皮大。\n明眼衲僧萨普吒，九十日中看不破。\n看不破，笑倒嵩山破灶堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释弥光","text":"一物不将来，两肩担不起。\n直下便承当，坐在屎窖里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其五","author":"释弥光","text":"和风习习，膏雨微微。\n洗开柳眼，秀出花枝。\n衲僧闻得呵呵笑，也是宗门第八机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其三","author":"释弥光","text":"一九与二九，相逢不出手。\n冻得鸱吻头，面南看北斗。\n诸禅人，晓不晓，地炉火冷莫嫌寒，更有樵夫赤脚走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其一","author":"释弥光","text":"一拶当机怒雷吼，惊起须弥藏北斗。\n洪波浩渺浪滔天，拈得鼻孔失却口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释弥光","text":"梦幻空花，何劳把捉。\n得失是非，一时放却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈五首 其四","author":"释弥光","text":"今朝腊月二十，衲僧门风壁立。\n进前拟问如何，劈面老拳箭疾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释择明","text":"从来家富小儿娇，偏向江头弄画桡。\n引得老爷把不住，又来船上助歌谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释择明","text":"赵老云收山岳露，茱萸雨过竹风清。\n谁家别馆池塘里，一对鸳鸯画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释择崇","text":"浪静风恬正好看，秋江澄澈碧天宽。\n渔人竞把丝轮掷，不见冰轮蘸水寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读庄子一受其成形不忘以待尽","author":"释择崇","text":"人生悉如此，谁悟此中玄。\n白日无私照，青山任意眠。\n松风来不断，泉石自相便。\n路出千峰上，云归竹径边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司空山歌","author":"释择崇","text":"司空山，在云外，时人到得方自在。\n我今随力幸登临，四顾巍巍无向背。\n绝遮拦，难比况，千山万山齐恃仰。\n九夏炎炎雪正飞，三冬飒飒华初放。\n春不荣，秋不落，隐隐昭昭倚寥廓。\n直下人间咫尺间，欲上之人难措脚。\n人迹绝，野境宽，触事无能懒散便。\n有时向日岩前坐，有时乘困日高眠。\n不学禅，不修道，只么腾腾恣颠倒。\n百种无求个野人，随分随缘能作造。\n不从他，不觅己，一句灵灵万缘里。\n自从识得祖师关，历历明明此为始。\n无妙名，无忌讳，来者向渠只么是。\n任你千般与万般，何曾出得个些子。\n分明说报知音，目炙风吹不用寻。\n须弥南畔相逢著，积翠台边旨更深。\n旨更深，谁会得，东村王老眼前黑。\n李四张三不信伊，问尽邻家转疑惑。\n转疑惑，不较多，为君吟作司空歌。\n宫商角徵任吹唱，角徵宫商争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释择崇","text":"金佛不度炉，穷源有处无。\n木佛不度火，浑崙咬不破。\n泥佛不度水，何处不是你。\n真佛屋里坐，赵州言是祸。\n水牯会耕田，黄牛能拽磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释择崇","text":"西山青，无谓情。\n洪井碧，无涓滴。\n西山人，见曷亲。\n西山事，无可似。\n若是灵利底举著便知，懵懂者付与德山临济。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释择崇","text":"柴鸣竹爆惊人耳，大洋海底红尘起。\n家犬声狞夜不休，陆地行船三万里。\n坚牢地神笑呵呵，须弥山王眼觑鼻。\n把我东行却向西，南山声应北山里。\n千手大悲开眼看，无量慈悲是谁底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹","author":"释择璘","text":"东君著力为渠裁，妙绝真姿不受埃。\n嗟我一观如梦幻，倚栏非为爱花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"释择璘","text":"双双白鹭坠青空，飞入花汀杂翠红。\n烟火一篷渔舍晚，归时荡漾小船风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花","author":"释择璘","text":"花老香微春始来，禁寒唯有雪相陪。\n无情谁为添愁怯，雨后风前亦可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏杜鹃花","author":"释择璘","text":"春老麦黄三月天，青山处处有啼鹃。\n悬崖几树深如血，照水晴花暖欲燃。\n三叹鹤林成梦寐，前生阆苑觅神仙。\n小山拄颊愁无奈，又怕声声聒夜眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄礼法师","author":"释择璘","text":"寺枕沧溟上，门长掩寂寥。\n定回花漏断，讲彻兽烟消。\n入槛泉声细，当轩岳色遥。\n何时会重席，南望路迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题思安清意太师幽远庵","author":"释择璘","text":"得意幽深触处真，何须丘壑密藏身。\n爱兹殊胜园林地，非彼等閒花木春。\n白昼杜门人莫到，清谈绝俗世难亲。\n纷纷闹市绕山脚，独有此中无点尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释择璘","text":"吊古有心怀短李，拂尘无力看丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送及禅人","author":"释明辩","text":"马面夜叉才稽首，牛头狱卒便擎拳。\n洞宾唱个陶甄理，脱壳乌龟飞上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送街坊","author":"释明辩","text":"贞女不著娘家服，丈夫岂假分时财。\n十杯五盏从何有，空奋双拳趁得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其十五","author":"释明辩","text":"住山身已老，世事任乖张。\n年来无侍者，客到自烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其十","author":"释明辩","text":"画得真如活，华间试展开。\n黄莺偷眼觑，不敢下枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其六","author":"释明辩","text":"不向东山久，蔷薇几度华。\n白云他自散，明月落谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其五","author":"释明辩","text":"弓强难结鸳鸯纽，御道那栽栗棘蓬。\n堪笑香严饶舌老，今年犹胜去年穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十六首 其三","author":"释明辩","text":"要得他家活计强，竿头须解倒拈枪。\n这边打鼓那边拍，引得瞿昙笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其三十二","author":"释明辩","text":"栗蓬吞得有何难，更教吐出又心酸。\n吞吐得来休嚼碎，南辰光射北辰寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其三十一","author":"释明辩","text":"试问人间有底忙，好将春事报春光。\n直饶日日花前醉，一季都来九十场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十九","author":"释明辩","text":"老将高提白玉鞭，双驹一策去翩翩。\n古今得失论量底，空看西山暮雨前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十八","author":"释明辩","text":"微酸梅子始生仁，莺老花残迹已陈。\n一夜南风移斗柄，明朝烟柳不关春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十七","author":"释明辩","text":"高安滩头百杂碎，象骨峰前眼搭痴。\n敢道鼓山无鼻孔，丛林千古笑嘻嘻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十六","author":"释明辩","text":"养得男儿要赌钱，浑身无有寸丝缠。\n是非窟里和身入，生灭门中满口宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十四","author":"释明辩","text":"六朝翻译传来妙，到头未悟当时窍。\n须信枝头老凤凰，春来翻作黄莺叫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十三","author":"释明辩","text":"打起黄莺儿，莫教枝上啼。\n几回惊妾梦，不得到辽西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其二十一","author":"释明辩","text":"玉鞭才举乾坤静，皇道私无显至尊。\n贵极銮舆才指斥，将军正令不容存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其十八","author":"释明辩","text":"脱略情尘老睦州，虎头虎尾一时收。\n芳草渡头韩干马，绿杨堤畔戴嵩牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其十五","author":"释明辩","text":"兜罗绵样硬赘头，河北风流老赵州。\n咸处著盐淡添水，轩头一笑更无休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其十四","author":"释明辩","text":"玉洞玄关道路长，蟠桃岂是等闲芳。\n遮藏不许人间见，只恐春风漏泄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十二首 其十三","author":"释明辩","text":"萝卜头禅聒噪人，霜刀累切了无痕。\n自古不通人咬嚼，只容衲子鹘崙吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]