[{"title":"和才叔次韵 其一","author":"许及之","text":"閒中宜可乐，病外复何愁。\n块坐疑三刖，朋来散百忧。\n琴弹欣改调，瓶罄喜归谋。\n岂复行藏计，终朝只倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和才叔次韵 其二","author":"许及之","text":"诗社久疏索，吟笺殊涩悭。\n遥怜疑落落，近喜复斑斑。\n柳密莺酬答，花深蝶往还。\n春光顿如许，人事苦相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵甄念八丈监簿诗","author":"许及之","text":"忆昔忘年旧，惟公不我遗。\n分携频问讯，握手屡哦诗。\n尘世千年梦，仙家一局棋。\n得閒闻健好，振古只如兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵广文锁试出院寄似","author":"许及之","text":"校文花事过，无句到苍苔。\n芍药翻新砌，酴醾浸古罍。\n竹枝歌唤起，春草梦惊回。\n亦许山中老，相容和朅来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同年会拜三茅不及与呈袁侍郎同年","author":"许及之","text":"地秘三茅胜，班高玉笋明。\n昔年同日喜，共拜一阳生。\n造化何劳补，弥文意自成。\n梅花开句眼，争得不关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄潘德久","author":"许及之","text":"新雨不可待，故人犹作疏。\n有方能煮字，无策与脂车。\n洒地亲霜簟，敲冰想玉壶。\n端能乘月过，重赋碧芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀郑仁叔 其一","author":"许及之","text":"近有河鱼疾，曾烦旧雨来。\n又成三日别，未觉百怀开。\n气合嗟同病，情亲忆把杯。\n西湖荷盖底，谁遣画船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀郑仁叔 其二","author":"许及之","text":"斗大楼居窄，林深客思长。\n雨凉欣破甑，风急凛垂堂。\n倚禄生涯拙，忧时鬓发苍。\n向来遮日手，祇合钓沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病足少苏次常之韵三首 其一","author":"许及之","text":"挛拳尊足苦，伸缩楚囚声。\n药甲新条在，医科旧贯盈。\n百年双脚健，万事一沤轻。\n独恨忘形友，终然少合并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病足少苏次常之韵三首 其二","author":"许及之","text":"休从詹尹卜，数亦不难通。\n寄禄逾三品，论才祇下中。\n器攲终必覆，药裹漫成丛。\n痼疾元来有，惟知酒有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病足少苏次常之韵三首 其三","author":"许及之","text":"蓝田纡古句，令我好怀开。\n未敢为琼报，何从引玉来。\n蒲萄江涨醁，桑落瓮留醅。\n柳市人归未，随潮蚤晚催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三次澄鳞韵喜闻捷音","author":"许及之","text":"昨夜灯花喜，今朝吉语新。\n犁庭真破竹，入境若无人。\n何力裨洪造，擎拳爇宝薰。\n从今愿诸将，献捷日频频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四次闻捷韵","author":"许及之","text":"身閒偏蚤起，边报逐朝新。\n诸将休轻敌，中原尚有人。\n定须申挞伐，安得杂莸薰。\n祇愧浑无补，空歌捷咏频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻捷五次转庵韵","author":"许及之","text":"周历绵绵远，汤盘日日新。\n恭闻哀痛诏，愤激老癃人。\n报答带仍砺，英雄沐更薰。\n衰年扶杖听，折屐敢辞频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"转庵催结局六次韵","author":"许及之","text":"汉仪重睹旧，秦暴尽更新。\n应是天亡敌，从知国有人。\n乾坤大开辟，华夏一陶薰。\n收到昆崙北，诗应快李频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和转庵与洪共之说诗谈禅之什","author":"许及之","text":"铛坐听清话，鼎来宜笑哗。\n诗谈五字律，禅说一枝花。\n未肯传衣钵，先须借齿牙。\n老婆心更切，黄檗正栽茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又再和转庵且置诗话聊答说禅之什","author":"许及之","text":"见性元非说，传心岂得哗。\n三更亲受法，五叶自开花。\n虽遇夺衣岭，终摇度橹牙。\n要知观自在，不异鸠盘茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又复次韵为酬答说禅偈言","author":"许及之","text":"密传当正受，谛听勿高哗。\n要结菩提果，须开顿悟花。\n祖师禅上阵，大将拥高牙。\n赴了斋时饭，大家同吃茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次外舅遣侍人韵","author":"许及之","text":"关中萧相国，江左管夷吾。\n人仰高山石，心宜赤水珠。\n登临捐妓女，书札付官奴。\n妙得安心法，绳床底用蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次外舅韵戏呈舍人叔丈","author":"许及之","text":"接栋兄过弟，忘怀汝与吾。\n缠头新办锦，买笑近量珠。\n怒释泥中婢，欢全膝下奴。\n使无驱豆法，亦合赌樗蒱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次外舅闻字即事韵","author":"许及之","text":"蘧瑗行年化，宣尼耳顺闻。\n声名昭白日，富贵薄浮云。\n天子方尝胆，中原未静氛。\n加餐为时起，礼乐不徒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵并呈舍人叔丈","author":"许及之","text":"过访邻墙近，歌呼隔屋闻。\n江收梅熟雨，川映蕊红云。\n把烛杯仍艳，交谈篆接氛。\n盘洲馀醉墨，吾亦欲云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次闻字韵","author":"许及之","text":"船屋香留润，衣篝冷却闻。\n晚山新见月，别浦宿藏云。\n岁月催人老，江湖净世氛。\n望中愁不极，收拾费诗云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德久","author":"许及之","text":"熟窥齐物论，懒赋畔牢愁。\n浮世梦槐国，虚名种橘侯。\n有身俱有患，无累即无求。\n不啻如今足，何如取次休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次转庵韵 其一","author":"许及之","text":"节中期乐事，座上欠嘉宾。\n雨帽何妨湿，云山自带颦。\n午晴开喜色，归月入怀新。\n有菊皆重九，无须更卜辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次转庵韵 其二","author":"许及之","text":"有约惟真率，相忘任主宾。\n拒霜方送喜，疏柳不争颦。\n近复关原旧，频看邸报新。\n吾侪何幸甚，投老得逢辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三次转庵韵仍招小饮","author":"许及之","text":"有径望三益，杜门无杂宾。\n只逢开口笑，绝胜捧心颦。\n一色黄华在，双投白酝新。\n速宜相尔汝，元不阔参辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金鱼久不浮游喜而有作","author":"许及之","text":"买得黄金鲫，投将白玉池。\n久晴虞涸辙，转壑漾深陂。\n每施龟鱼食，偏怀网罟疑。\n今晨水澄澈，梭影泛琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有喜真爱亭梅花开走笔呈转庵","author":"许及之","text":"小园饶胜事，僮仆竞欢哗。\n梅绽凌寒树，枝繁照水花。\n病身俄勿药，诗思顿萌芽。\n急报南邻友，新篘可当茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和转庵白莲","author":"许及之","text":"虚籁一声蝉，通宵月正悬。\n亭亭承露掌，历历涉波仙。\n夜色起香雾，晓光收玉烟。\n层冰不可致，清赋忆前年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诸葛忠叟初逢家垫池中产双莲求予扁榜并作五言勉诸甥","author":"许及之","text":"我爱濂溪说，君能喜种莲。\n一经初建塾，双实遽呈川。\n和气埙篪应，荣名棣萼联。\n勉旃成宅相，学也是家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"麝香萱","author":"许及之","text":"南薰吹麝馥，背树染鹅黄。\n里许香为德，中央色自庄。\n洛津行夕佩，仙掌洗晨妆。\n真为忘忧赏，看云恋故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"煮茗 其一","author":"许及之","text":"止酒身多病，添书日正长。\n睡魔推不去，茗碗熟难忘。\n鹊过飞樵堕，蜂喧落粉香。\n静中观物理，此乐未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"煮茗 其二","author":"许及之","text":"煮茗鸦窥井，哦诗蝶过垣。\n笋高垂箨瘦，梅落坠枝繁。\n白昼重闱静，新晴远市喧。\n境缘看渐熟，吾亦欲忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"显庵饷伊蒲索著语代简","author":"许及之","text":"却埽销长夏，来薰傍曲肱。\n辘轳金井水，沆瀣玉壶冰。\n避暑元无法，安心却粗能。\n破除香积饭，供给在家僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽故丈母莱国夫人沈氏三首 其一","author":"许及之","text":"北使复南迁，尚书大节全。\n长公身致相，冢妇世称贤。\n象服宜偕老，鱼轩遽溘先。\n哀伤动行路，谢傅况中年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽故丈母莱国夫人沈氏三首 其二","author":"许及之","text":"林泉当丝竹，丞相巧安贫。\n珍重承夫意，清修报主身。\n指千随嗜好，体一写姻亲。\n更有衔恩者，妻孥寄食频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽故丈母莱国夫人沈氏三首 其三","author":"许及之","text":"爱女终身托，婴儿半路遗。\n讣音非不达，忧思恐难支。\n已及黄泉见，应怜白首期。\n爱恩均罔极，泪尽挽歌词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元日登天长县城","author":"许及之","text":"元日登临一腐儒，感今怀昔愧微躯。\n此城曾是千秋县，有水呼为万岁湖。\n南渡向来纡翠驾，北征何日会京都。\n祖功宗德无边际，可恨长淮限一隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次常之元日复用韵","author":"许及之","text":"椒花祝处羽觞飞，第一春光勿愿违。\n已是浃旬弹指过，可堪维暮转头非。\n诗签络绎须盈袖，酒盏淋漓听满衣。\n老去寸阴尤爱惜，久拚带减沈郎围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日用常之韵寄才叔居甫","author":"许及之","text":"断肠梅作雪纷飞，似与金花巧胜违。\n此日共怜人日是，今春谁道我春非。\n閒中风月为莲社，醉里莺花即锦衣。\n题寄草堂须记取，莫孤绿绕惜红围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"人日","author":"许及之","text":"明当春日今人日，身到故乡胜异乡。\n巧胜耐寒元故事，青丝传菜旧风光。\n只将柏叶聊随酒，莫为梅花苦断肠。\n南北两园多种接，閒居从此有閒忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宣甫约元宵入城不至","author":"许及之","text":"春已兼旬未脱绵，积阴顿扫柳条烟。\n儿童戏放抟风鸽，老子惟看跕水鸢。\n剪綵试灯新乐事，逢场作戏旧丰年。\n诗翁不离陶溪隐，可是公房恋屋仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王宣甫以灯夕入城而予偶无佳思阻同游有诗为寒食之约次韵奉酬","author":"许及之","text":"落梅声里惜馀芳，孤负灯光与月光。\n偶以催租败佳思，阻随执事佐颜行。\n春风已入青丝鞚，好句终归古锦囊。\n能践清明重约否，须知岁月去堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕之明日久阴乍晴月色皎然","author":"许及之","text":"连阴乍霁自新元，细雨梅花自可怜。\n天意肯教人怅望，灯宵终放月团圆。\n儿童鼓舞几通夕，我辈欢呼竟不眠。\n老少相悬均此乐，去秋无此大丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵程判院春日","author":"许及之","text":"催得冬残是野梅，依然春傍柳边回。\n不知鬓影星星去，只道年光恰恰来。\n喜为农占秋有廪，懒于僧问劫经灰。\n历头且复从今数，笑口都能几度开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月晦日游木瓜园","author":"许及之","text":"亭成寄乐小裴回，野水粼粼傍酒杯。\n未有政声追召杜，敢将诗律继欧梅。\n春风已办催花絮，夜雨惟怜老菜台。\n百二十春今恰半，不须扁榜记曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢余伯益节推","author":"许及之","text":"鹊喜声频去复回，亭成报我趣衔杯。\n春风得意矜新柳，野水留春恋落梅。\n何处笙歌催院落，一时车马走舆台。\n搀先但得邦人乐，待约莺花殿后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢刘太丞","author":"许及之","text":"世事羊肠有几回，功名随意芥为杯。\n放教春色归繁杏，禁得东风是落梅。\n天上有人调玉烛，边头何地筑金台。\n朝廷仄席思耆旧，诏逐阳和蚤晚来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食日宿芜湖县廨","author":"许及之","text":"今年歧路足生涯，寒食芜湖感物华。\n少为颜公成且住，绝怜杜老叹无家。\n光风不禁吹香草，薄雾无端羃晚华。\n已是惜春那惜别，无多酌我怕周遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感春呈同社","author":"许及之","text":"静处聊将物理推，鸟啼花发苦因谁。\n留连春事惟红药，管当行人是子规。\n莫道柳绵无住相，也为萍絮媚清漪。\n如何饱食閒终日，不课离骚不赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月晦日袁起岩同年雨中集聚景园","author":"许及之","text":"湖上名园属内家，湖边有客误乘槎。\n风餐历历秦宫树，雨立亭亭汉节花。\n乐事坐来添晷刻，题名帖后带烟霞。\n春衫湿却它年话，合有新诗记物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵常之五日禁竞渡","author":"许及之","text":"仍年此足为吾病，举世谁人似我閒。\n思远楼前重禁渡，容成洞里独看山。\n交游雨绝梅还溽，赓倡星分稿自删。\n赖有松庐相慰藉，新篇时复到榆关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰上浣同德久子侄辈避暑退居即事","author":"许及之","text":"说著退居心已惬，湖山何况傍绳床。\n虽无瑟瑟松杉韵，自觉愔愔枕簟凉。\n茗碗亲来诗有思，藕花多处语犹香。\n一旬一日恩休沐，今日恩随日更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋纪实","author":"许及之","text":"官身不办游山具，只有茶铛与笔床。\n旋买鲈鱼供箸美，却携玉友待樽凉。\n同来稚子听情话，更有幽僧炷妙香。\n遥望画船云锦外，好风吹到笛声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬张岩卿七夕","author":"许及之","text":"星文人事古难磨，女织男耕力最多。\n河鼓有神司带犊，天孙垂象验飞梭。\n因依鸿烈成桥语，泛滥长生旧殿歌。\n伉俪流传钧是亵，玉川无赖太风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王宣甫秋夜书怀","author":"许及之","text":"静听高梧落甃声，遥闻丛雀转秋更。\n星随斗极看时改，露湿天河彻底清。\n老去心情惟药裹，病苏灯火惬书檠。\n故人忽起关河思，触拨深愁怒瘿生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈仲全秋怀","author":"许及之","text":"一夜炎歊破甑空，萧然秋思雨声中。\n江湖两鬓惊飞叶，岁月一身俱转蓬。\n我自由来为性癖，子今无乃坐诗穷。\n男儿穷达终相似，却是难教凿枘同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日次常之柳市秋怀韵","author":"许及之","text":"柳市留连爱别坰，归来诗与字俱清。\n閒居揫敛全生理，老境行藏见物情。\n恨把菊花随雨过，醉敲瓦缶作雷鸣。\n千年张翰风流句，却是生前不愿名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵才叔九日家宴阻访媚川","author":"许及之","text":"一秋天气属吟家，九日风光爱物华。\n对妇举杯胜俗客，逢辰得酒值黄花。\n大难富有成糜季，小异谁知落帽嘉。\n独坐媚川空怅望，半蟾分挂夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次才叔和龚司令九日韵","author":"许及之","text":"满院西风把菊天，官身閒暇亦悠然。\n恍思杜老浮舟日，绝胜彭城戏马年。\n岂待白衣开笑口，不妨乌帽庇华颠。\n却愁明发还多事，诗在龙山落照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日简德久","author":"许及之","text":"登高每恨尊无酒，近节今欣菊绕篱。\n风日正佳关气数，心情不分减年时。\n爱将雪鬓攲纱帽，惬把霜螯对酒卮。\n意到潘郎宁易败，催租端自不妨诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次转庵九日韵","author":"许及之","text":"窗前白白黄黄菊，门外疏疏短短篱。\n择胜任从追赏日，有年即是太平时。\n呼鹰戏马人千古，缀席浮舟酒一卮。\n五百年间张翰句，风流犹待谪仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日小饮用后山居士韵简转庵","author":"许及之","text":"连日欣晴卜暮霞，晨曦闪闪舞群鸦。\n时丰都市人多醉，节近重阳菊有花。\n万事悠然山正好，三杯可以我何加。\n自怜犹有童心在，爱把茱萸系绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用后山韵","author":"许及之","text":"懒惰无心赋落霞，醉馀吟笔大如鸦。\n但欣有酒酬佳节，犹胜无钱对菊花。\n小异孟嘉今老去，知非蘧瑗叹年加。\n登临无奈秋光好，归傍窗前月印纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日同从班诸公自南山过苏堤登宝叔塔","author":"许及之","text":"柳下芙蓉锦作裳，画船波底见秋光。\n登高自昔须吾辈，戏马从人上宝坊。\n白发未嫌纱帽黑，紫萸偏称菊花黄。\n常年风日无如此，争不从容入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":22110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]