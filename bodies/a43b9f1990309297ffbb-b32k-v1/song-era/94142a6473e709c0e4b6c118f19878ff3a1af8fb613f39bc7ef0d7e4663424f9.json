[{"title":"右司周炳仲亦用韵并和以谢之","author":"李曾伯","text":"谁将拙句彻名流，勾引春风入笔头。\n廊庙喜登端士用，田园盍为故人谋。\n曾芳草外思淮事，应海棠边念蜀游。\n细雨挑灯成朗诵，剧谈如共峡江舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁寿寺劭农登慈氏阁和李诚之柱间韵","author":"李曾伯","text":"持酒殷勤问尔农，忧时同此愿年丰。\n仓箱欲致崇墉积，耒耜宜加旷土功。\n水北有田均夜雨，岭南无地不春风。\n吾皇德化形扶杖，亲见儿嬉七十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁国道间即事","author":"李曾伯","text":"枫染酏颜菊亦酣，霜天风味饱相谙。\n马蹄去去江之北，雁影来来塞以南。\n云外数峰轻抹翠，雨馀一水碎挼蓝。\n肩舆催问谁家宿，落日西山已半含。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁国道间喜晴","author":"李曾伯","text":"怪得虚檐寂溜声，起来云淡月微明。\n只消一夜西风力，尽扫千山宿雾清。\n农舍少酬终岁望，客途拟过小春晴。\n枝禽亦似欣欣意，飞入烟林自在鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对厅致语口号","author":"李曾伯","text":"相对封人共祝尧，玉觞潋滟酒浮椒。\n千山佳气供红旆，一道仁声赖翠轺。\n南极仰祈天上寿，东风不隔海滨遥。\n恩浓湛露何为报，勉属清忠答圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归善权谢福岩","author":"李曾伯","text":"强健南游抱病还，鬓毛剥落足蹒跚。\n喜观云衲酬前约，莫听家僮说旧官。\n幸免如陵羞在陇，将期同愿老于盘。\n当家公案师拈出，更向三山石上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申春偶成","author":"李曾伯","text":"半世崎岖鬓已凋，元知官职忌之招。\n几番恶梦觉已晚，一片好心磨不消。\n枕上岂堪思往日，樽前更莫计明朝。\n此身若也填沟壑，犹有来生答圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊戌冬护军援庐濡自栅江入今日过之恍然如昨梦因成","author":"李曾伯","text":"隔江屯坞自孙吴，犹记孤军出此涂。\n阅十九年如梦觉，历千万里几驰驱。\n月沉荒垒马横塞，风捲寒沙雁宿芦。\n忆著当时身是胆，归休毋更老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"术士余云谷求诗和永国韵","author":"李曾伯","text":"心悟玄机妙不传，家虽谷口近平泉。\n且谈方外山林乐，休诧人间将相权。\n世事何如难逆睹，吾生已矣莫多缠。\n未能免俗聊相问，更活耕桑得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永州城南一士夫家可爱","author":"李曾伯","text":"二水城南路，谁人处士家。\n不为轩冕累，尽洗市廛华。\n庭立竹千个，墙留梅数花。\n吾庐归未得，对此重咨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用从军古云乐为韵贺杨觉甫制干 其四","author":"李曾伯","text":"国有金汤在，邻修玉帛云。\n夷侵由废雅，苗格自敷文。\n当宁形宵虑，公车以岁闻。\n便当从幕府，入校道山芸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用从军古云乐为韵贺杨觉甫制干 其一","author":"李曾伯","text":"海宇材能盛，风云气类从。\n一贤居上介，千里折遐冲。\n咨事须孙楚，论诗得正封。\n城东未为好，终不似乌龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用从军古云乐为韵贺杨觉甫制干 其二","author":"李曾伯","text":"明君切西顾，元帅作中军。\n宾客湖南上，人才冀北群。\n三鳣存绛帐，一鹗在青云。\n磊磊轩天地，诗书有隽勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用谈笑青油幕为韵贺吴叔永制机 其三","author":"李曾伯","text":"弟兄眉最白，人物眼常青。\n论事犹迎刃，谈兵若建瓴。\n吁谟皆上策，道德有强形。\n办却聊城矢，还书剑阁铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用谈笑青油幕为韵贺吴叔永制机 其四","author":"李曾伯","text":"唐边重秦陇，蜀鉴在江油。\n不易九鼎重，方兼四履忧。\n其间不容发，自此可前筹。\n局面西风异，从容夜观谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用谈笑青油幕为韵贺吴叔永制机 其一","author":"李曾伯","text":"取士虽多术，知人在片谈。\n文书今倚重，谋议许相参。\n饵陋贾生五，策明刘蜕三。\n坤舆方厚载，朋利得西南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲午七夕在京和朱子木韵","author":"李曾伯","text":"巫云一去付悠悠，堪笑星河老不休。\n天上凄凉两魂梦，人间阅历几春秋。\n销磨长恨诗难尽，领略良宵酒莫留。\n借我天槎试相问，拙人还与巧同不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲午中秋在魏塘值风雨","author":"李曾伯","text":"向来玩事每欣逢，老去相忘更客中。\n天下山河清影在，人间风雨此宵同。\n孤鸾夜泣菱花暗，老兔秋悲桂子空。\n料得嫦娥念摇落，不教无酒对征篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲午淮幕和萧应父赠郑允蹈韵 其二","author":"李曾伯","text":"客来远自洞庭滨，一笑相逢耳竞倾。\n把酒未须论后约，读书已恨欠前生。\n畴堪太乙青藜照，亦有丰城宝剑精。\n近在眼前休蹉却，君如未识问君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲申宁庙挽词 其二","author":"李曾伯","text":"自听山东诏，甘泉息夜烟。\n玺膺新玉帛，图贡旧山川。\n望切尧民日，忧形杞国天。\n中原尤感泣，不独老臣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲申宁庙挽词 其一","author":"李曾伯","text":"德化勤三纪，仁声溢九州。\n浣衣昭禹俭，昃食轸文忧。\n润色恢鸿业，艰难启燕谋。\n中兴宗汉庙，端自敬天休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰送淮东黎漕趋朝 其二","author":"李曾伯","text":"始焉来此学分弓，定计初筵画诺中。\n击楫少能思祖逖，同舟多赖有娄公。\n老怀不奈周南滞，佳客今成冀北空。\n天上故人如见问，为言憔悴已成翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲辰送淮东黎漕趋朝 其一","author":"李曾伯","text":"帘捲红楼拍手看，星轺迅步上鹓鸾。\n皇华节下留佳政，玉笋班中作好官。\n卿相致身时则易，忠贤得路古来难。\n端门待漏东风峭，尚忆屯边铁甲寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"礼湘山佛和别驾叔韵","author":"李曾伯","text":"自得湘南一派奇，禅舂元熟不须师。\n几千亿化如来相，五百年将再出时。\n翠壁云连秋树老，宝坊香静午斋迟。\n我来欲和因缘事，众衲丛中有解知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日雪","author":"李曾伯","text":"剪綵宁如剪水工，瑞烟融出玉龙松。\n重看腊白不为晚，未到昏黄犹见冬。\n多谢玉妃鞭白凤，为催青帝驾苍龙。\n天心端报丰年喜，一稔相期乐可封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春后登裴公亭时已解郡组","author":"李曾伯","text":"公馀赢得片时休，徙倚危亭豁倦眸。\n屹屹独存今岳阜，滔滔不尽古湘流。\n犹看雪意微茫在，顿觉春光骀荡浮。\n举酒莫论今古事，只将身世付沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏读靖康宸札有感","author":"李曾伯","text":"盟寻城下事方危，尚尔衰民益虏资。\n绐楚时曾无纪信，交秦计卒堕张仪。\n抗言玉铉吁何及，捐积琼林惜已迟。\n劫火既灰遗墨在，小臣唯有泪沾颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同罗季能章成父张子直登樊城制胜楼","author":"李曾伯","text":"避愁聊复上层楼，上到层楼转更愁。\n杳杳青烟榆夹塞，鳞鳞翠浪麦平畴。\n山连楚甸三千里，地隔中原四百州。\n立尽栏干谁领会，沧波渺处起沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因赋风筝与黄郎偶","author":"李曾伯","text":"竹君为骨楮君身，学得飞鸢羽样轻。\n出手能施千丈缕，举头可问九霄程。\n高穷寥旷宁无力，少假扶摇即有声。\n所惜峥嵘能几日，儿曹偻指已清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次蒋志父韵","author":"李曾伯","text":"中原百战徯来苏，浸喜衣冠复旧区。\n要得一行须老将，曾何千虑付狂夫。\n山川感慨诗难尽，烟火萧条酒尚无。\n若问西湖已芜没，望穷惟有几浮图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江陵和费察推九蕊瑞莲韵","author":"李曾伯","text":"喜对荆人一笑嫣，吾邦今见此嘉莲。\n脂容妩媚目疑幻，玉貌参差骨是仙。\n试把万葩千卉较，曾无一蒂九芳连。\n分明河洛中兴象，要竭精忠答上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"老态龙钟雪满头，黄花招我对清秋。\n东篱幸可安吾土，南服何堪典此州。\n莫忆风巾游汉渚，早呼雨笠访沧洲。\n明年把酒知何处，预约家僮酿蚁浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和 其二","author":"李曾伯","text":"最高楼上又层阑，目短元龙空海寰。\n栋宇地雄千嶂表，金汤天设两江间。\n西风障面曾筹檄，夜月胡床忆佩环。\n老去凭虚心辄悸，蜀城虽好不如还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和 其一","author":"李曾伯","text":"百尺城头著画阑，当年气欲压人寰。\n天机野马浮游外，世事沙鸥浩荡间。\n俗靡风颓畴底柱，功成身退盍循环。\n君看方册中前鉴，办取轻帆及早还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"才听鸣蜩叶底声，倏闻振羽草根吟。\n物情感我千丝鬓，时事萦人一片心。\n读易床头新课业，回文机上旧光阴。\n客怀休用嗟畴昔，更老那知得似今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"北帝东皇竞化工，六花吹满鬓毛松。\n谁令霓卫铺张晓，来与牛鞭断送冬。\n宝历明朝新纪凤，珠宫昨夜起骊龙。\n驱寒乞取酒泉郡，何必荆州万户封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"一壑冯夷宅，五丁盘古开。\n天将作甘澍，地岂著浮埃。\n梭化雷陂去，槎乘星渚来。\n犹疑真隐在，搜访莫徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"旅顿饭足饱，村帘酒莫赊。\n暮龄嗟客路，春事属山家。\n蕨长竹将笋，梅残李始花。\n问翁何处去，岭外有烟沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李曾伯","text":"不夜城头著此亭，东皇幻化一何神。\n相将莲炬催芳夕，来俾梅花作好春。\n自腊月前尤可喜，觉西风外已无尘。\n衔枚晓奏鹅池捷，为问和门有此人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至金泉登聚鹤楼","author":"李曾伯","text":"我住华亭惯识伊，九皋仙去逐云飞。\n北山久为悲空帐，赤壁还曾梦羽衣。\n姑和黄楼崔颢赋，为邀华表令威归。\n腰缠却笑扬州客，应对金泉愧子微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至清湘驿和己酉壁间韵","author":"李曾伯","text":"冰霜染得鬓毛深，又复钩辀听岭禽。\n老马已非筋力旧，好山重见面颜今。\n地饶风物皆春意，天念尘烦为午阴。\n转首十年成一梦，龙蛇满壁富新音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至颍州访故老","author":"李曾伯","text":"去汴五百里，通淮十八村。\n荒原王剪骨，废井伍奢魂。\n旧筑河南坞，新城塞北屯。\n百年遗爱在，六一故碑存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行铜陵道","author":"李曾伯","text":"夜报风姨息，晓乘波后平。\n江涵一镜净，山列两眉横。\n依约燃犀处，分明倒蔗生。\n徐行戒舟子，勿使白鸥惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行湘潭道","author":"李曾伯","text":"古驿湘潭道，人家松竹林。\n山连梅外远，春入柳边深。\n征骑虽欣霁，耕犁久望阴。\n貂裘嗟已敝，犹怯老寒侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过永州道间","author":"李曾伯","text":"雨欠农忧燥，风多客苦埃。\n犹寒莺未出，将社燕还来。\n桃放红凝脸，梅飘粉褪腮。\n春山如旧识，一笑病颜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过兴安塔寺僧以先世诗来偶赋","author":"李曾伯","text":"岭石水分脊，湖南山尽头。\n廛声通海远，塔影插天浮。\n香接宝坊界，星联铜柱州。\n祖孙凡几到，亦是宿缘不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过江陵寄陈次贾","author":"李曾伯","text":"担簦往解蜀山纷，归舸经行老几分。\n楚国喜誇新令尹，霸陵畴识故将军。\n相逢举酒酹江月，一笑携书访岫云。\n乞得身闲了无事，但知耕凿感吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过西海隘即事","author":"李曾伯","text":"江带湖襟护一堤，人烟落落柳依依。\n白鸥世界秋容澹，红蓼汀州水际肥。\n断岸马危迟弗骤，中流舟顺疾于飞。\n归来得自推敲了，更共登楼对夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过灵川县","author":"李曾伯","text":"去去灵川境，晴岚带暮烟。\n槟榔新满市，榕树老参天。\n舂委工于水，犁资手以佃。\n凄凉海天角，何事羽书传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过京山","author":"李曾伯","text":"总角嬉游处，重来转盼然。\n溪山犹昨日，朋友尽中年。\n旧话逢人说，新诗为客传。\n唤回风雨梦，犹记北窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过宜兴舟中见霅川诸山","author":"李曾伯","text":"八年不见此山青，一见殊增老眼明。\n鬓发已从霜露改，翠屏只在水天横。\n纤尘不染皆秋色，久间相于若世情。\n朝爽夕佳常领略，去来争似钓舟轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过忠州访酆都观 其二","author":"李曾伯","text":"迥绝尘埃表，宁无造物司。\n鹿驯贪客过，龙老恶人窥。\n丹去炉仍在，云生洞愈奇。\n归舟天尽际，杖履复何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过忠州访酆都观 其一","author":"李曾伯","text":"是山来自古，与世类相忘。\n雨染新苔翠，风吹老柏香。\n神仙多汉魏，祠像半隋唐。\n几许烟霞侣，相从老此乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过清湘洮阳驿和方孚若韵","author":"李曾伯","text":"问驿寻梅路渐深，壁间谁帖迈来禽。\n困诗感叹人才旧，投笔惭书岁月今。\n访古暂陪湘水浒，忧时远到雪山阴。\n牧羝持节畴能似，空倩宾鸿为寄音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过鄂渚登南楼","author":"李曾伯","text":"壮游几度上南楼，今度重来二十秋。\n俯仰之间只犹昨，登临何处是无愁。\n好山常在世青眼，此水如斯人白头。\n老兴未阑明月上，归欤笠泽有扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过愚溪","author":"李曾伯","text":"为底先生此水居，正缘不解学颜愚。\n身虽乐彼溪山似，名不期而天壤俱。\n往事勿言今已矣，当时岂意在兹乎。\n拟招故老穷佳胜，烟草萧萧宅一区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过樊城用刘清叔韵","author":"李曾伯","text":"古垒连边色，烟芜带夕阳。\n千年周翰祀，一瓣楚人香。\n楼堞新宏壮，丘墟几废荒。\n客怀明哲戒，飞梦绕吴乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过衡州值雨偶赋","author":"李曾伯","text":"行尽潇湘第几山，短舆轧轧费跻攀。\n柳边官驿堠十里，竹里人家屋数间。\n宿霭弄阴风料峭，春泥障路雨斓斑。\n韶华衮衮成虚掷，强托清吟解病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过衡阳晚宿","author":"李曾伯","text":"雨后春寒冽，山前夕照斜。\n身犹寻垒燕，声杂宿林鸦。\n过岭尚千里，隔村能几家。\n毋嫌茅店恶，窗下有梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻风黄盆口","author":"李曾伯","text":"三日江行两日风，短篷掀舞浪花中。\n危疑正贵须臾忍，静定将收造化功。\n休叹退飞犹六鹢，会看遇顺若孤鸿。\n挽回一息南薰力，稳送征樯秋浦东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏即事简炳仲","author":"李曾伯","text":"夏云方建汉旗赤，春事已如周辙东。\n几度炎凉经嫩绿，一番荣辱委残红。\n杜鹃岂为归心设，蝴蝶也无清梦通。\n万里天涯喜强健，剩开窗牖纳南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别权泸帅朱杞材太社","author":"李曾伯","text":"犹记冲寒溯峡来，相期偕至亦偕回。\n朝廷有诏许归老，藩岳无人值借才。\n顾我凋年嗟已矣，如君英略勉之哉。\n度泸要了经营事，心放公平手放开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劭农归游白龙洞","author":"李曾伯","text":"老龙昔未蜕，尝蛰此山中。\n霖雨春畴足，风云夜壑空。\n两崖高下倚，一径往来通。\n不愿千金剂，惟祈百谷丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿利州赵漕 其一","author":"李曾伯","text":"天禀银河一派清，蔼然中外播休声。\n金城方略今充国，斜谷规模旧孔明。\n屈久辔丝勤使指，再须班笋著宗英。\n九重侧席亲贤切，有诏西南起老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿利州赵漕 其二","author":"李曾伯","text":"几载星轺惠汉关，埴培寿脉一分宽。\n数丝鹤鬓因民白，一片鸥心为国丹。\n绿野高风虽独慕，黄花晚节正争看。\n勋名麟阁清芬在，且伴松椿傲岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":63813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]