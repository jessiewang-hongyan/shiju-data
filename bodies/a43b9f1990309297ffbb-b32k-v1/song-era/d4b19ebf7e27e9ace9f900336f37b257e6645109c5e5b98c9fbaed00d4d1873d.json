[{"title":"南濠","author":"方信孺","text":"经营犹记旧歌谣，来往舟人趁海潮。\n风物眼前何所似，扬州二十四红桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山广庆寺","author":"方信孺","text":"韦郎故地久萧条，只有泉声响夜潮。\n行客往来回首地，玉环无处觅娇娆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相对冈","author":"方信孺","text":"海门高并两峰寒，大艑轻帆自往还。\n安得百灵移一岛，却教尘世看三山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禺山","author":"方信孺","text":"禺山何事作番山，空有陂陀迹已漫。\n今日升堂听丝竹，沉香不见旧阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"药洲","author":"方信孺","text":"沙邱遗臭茂陵空，何物能成九转功。\n地下刘郎犹有愧，驾言聊作葛仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越台井","author":"方信孺","text":"古甃寒潮百尺清，伪王题品老佗营。\n渴来不饮盗泉水，特地翻为达磨名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顺庵","author":"方信孺","text":"词人自结一间茅，天上宸奎舞瘦蛟。\n见说鬼神犹卫护，瑞光前夜起山坳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"流杯池","author":"方信孺","text":"坳石天然印曲流，飞觞寂寞几春秋。\n山阴千古誇陈迹，此地何人记旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮邱山","author":"方信孺","text":"碧海何年已变田，空传双舄旧时仙。\n乘风欲挹浮邱袖，同访朱明别洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浴日亭","author":"方信孺","text":"亭倚蓬莱几许高，下临无地有惊涛。\n坡仙想得江山助，八语端为天下豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海山楼","author":"方信孺","text":"海山雨过月明时，自是南州一段奇。\n尘土只今无着处，可怜谁与更题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笔授轩","author":"方信孺","text":"制止遗踪底处寻，相传笔授此丛林。\n毗卢四万八千卷，正要墨池如许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资福寺罗汉阁","author":"方信孺","text":"千柱依然跨宝坊，庭前柏子久荒凉。\n明珠白璧无人识，赖有斯文万丈光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁柱","author":"方信孺","text":"崔嵬十二峙乾和，五柱何如马伏波。\n败堑颓垣今日见，想曾荆棘汉铜驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陵山","author":"方信孺","text":"龟趺无处问行踪，惆怅连江荔子红。\n铁铸崔嵬真大错，骊山铜柱久成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悬钟","author":"方信孺","text":"绝壁初无路可通，何人特地铸金钟。\n神仙底处应难诘，弹落馀声和涧松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清远峡","author":"方信孺","text":"昆崙截竹事空传，不见春潮送客船。\n只似蜀江江上路，两山中峡手巾天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清海军楼","author":"方信孺","text":"睥睨旁围百尺楼，翚飞缥缈接云浮。\n鲸波不动海山碧，弹压东南十四州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菖蒲观觉真寺","author":"方信孺","text":"千载仙居已渺茫，道山佛屋自相望。\n春花秋草年年事，却作游人歌舞场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩提树","author":"方信孺","text":"庭前双树尚依然，何处犹参无树禅。\n一自老卢归去后，年年长结万灯缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜鼓","author":"方信孺","text":"石鼓嵯峨尚有文，旧题铜鼓更无人。\n宝钗寂寞蛮花老，空和楚歌迎送神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄巢矶","author":"方信孺","text":"天下纵横辙迹环，舳舻不许度前湾。\n江神少为摧凶焰，要使留金六祖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"媚川都","author":"方信孺","text":"漭漭愁云吊媚川，蚌胎光彩夜连天。\n幽魂水底犹相泣，恨不生逢开宝年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景泰山七仙寺","author":"方信孺","text":"老衲诛茅昔小留，七仙阴为护岩幽。\n不将石履呈奇怪，安得西归好话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝汉台","author":"方信孺","text":"倔强难除结尚椎，筑台北望欲何为。\n大夫自载千金橐，谁念韩侯十万师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琵琶洲","author":"方信孺","text":"髣髴琵琶海上洲，年年常与水沉浮。\n客船昨夜西风起，应有江头商妇愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"番山","author":"方信孺","text":"城根片石久模糊，图记应须考国初。\n欲识番山真面目，至今东北号清虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"番塔","author":"方信孺","text":"半天缥缈认飞翚，一柱轮囷几十围。\n绝顶五更铃共语，金鸡风转片帆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葛仙翁炼丹石","author":"方信孺","text":"见说刀圭已解仙，宁须丹灶半人间。\n葛翁本是求勾漏，何意南来访此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越井冈","author":"方信孺","text":"万山衮衮尽东来，高处犹存百尺台。\n回首旧时张乐地，一杯重与酹苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越楼","author":"方信孺","text":"真珠市拥碧扶阑，十万人家着眼看。\n独恨登临最高处，举头犹不见长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鉴空阁","author":"方信孺","text":"右带灵洲左石门，何年飞阁倚晴云。\n南游不用看图画，曾向坡仙句里闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雷洞","author":"方信孺","text":"疑冢峥嵘此不封，麒麟彷佛是山中。\n后人未识藏雷穴，踏破苍苔古甃空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲍姑井","author":"方信孺","text":"为觅丹砂到海滨，空山废井已生尘。\n不将一滴苏焦槁，神艾虚传解活人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蕃人冢","author":"方信孺","text":"鲸波仅免葬吞舟，狐死犹能效首邱。\n目断苍茫三万里，千金虽在此生休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹤舒台","author":"方信孺","text":"危台老石寄层巅，鹤驾逢迎不记年。\n今日归来应一笑，山川城郭故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"方信孺","text":"石门元不锁，岩屋本无基。\n九夏花犹在，千年树倒垂。\n僧閒方定起，客到每归迟。\n甚欲眠莲叶，沿崖读断碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆远龙隐洞","author":"方信孺","text":"南山山北北山南，一洞中分路口三。\n飞鹤叫云声自远，懒龙悭雨睡方酣。\n襄公淡墨留苍壁，太史高风拂翠岚。\n百尺岩前清绝处，道人先我著茅庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西山凿池种白莲作","author":"方信孺","text":"池开新白遍天涯，未许东风擅一家。\n苍桂丛中苍桂树，碧莲峰里碧莲花。\n波光分破湖千顷，云影斜飞水一洼。\n待著栏干横浅绿，浮萍开处见鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还珠洞","author":"方信孺","text":"归舟多载小江春，重访东岩旧屐痕。\n插水峭崖犹有路，垂天怪石本无根。\n金华仙伯真知己，薏苡将军足断魂。\n安得北山公可作，倩渠移取向家园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏西山海棠","author":"方信孺","text":"真珠几颗最深红，点缀偏方造化工。\n好事何年移蜀种，美人清晓出吴宫。\n妖娆能得几时赏，零落才消一夜风。\n自有生香人不识，绣衾全覆锦熏笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌丹亭","author":"方信孺","text":"风驭来三峡，云章下九天。\n名山开窟宅，飞宇纳光躔。\n未见烟霞约，聊将岁月镌。\n神游谁复识，空诵白云篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清秀山","author":"方信孺","text":"寻遍洞天三十六，苍灵独闭此岩扉。\n旋除野草开新径，遮莫寒藤刺客衣。\n岁月偶同题壁字，烟霞似不放人归。\n把茅欲作开山主，已落瞿昙第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漓山云崖轩","author":"方信孺","text":"不用穷探费杖藜，隐然林壑挟城陴。\n曾遵月洞千岩上，更著云崖一段奇。\n拂拭轩窗容俎豆，发挥泉石借声诗。\n瞿昙颇似知人意，已约梅花带雪移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙隐岩 其二","author":"方信孺","text":"雨脚初收鱼尾霞，满溪流水半溪花。\n寻源曾识武陵洞，泛宅如浮苕水家。\n但得嵌空元有路，何如峭绝不容车。\n道人辛苦经云水，成塔从来是劫沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙隐岩 其一","author":"方信孺","text":"爱山那惜走千回，生怕前驱后骑催。\n石上参差鳞甲动，眼中在处画图开。\n骖鸾未办乘风去，浮鹢何妨载雨来。\n人事百年俱变灭，祇应题字不尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题学宫壁","author":"方信孺","text":"淮水原同泗水流，东家便是孔家丘。\n千年源委诗书泽，一日风雷变化秋。\n劫火不能移突兀，子衿正合勉藏修。\n相魁自昔称吴蔡，衣钵相传未肯休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九曜石","author":"方信孺","text":"九峰参立倚空明，好事传闻应列星。\n运石早知能赎罪，上书何必待缇萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风幡堂","author":"方信孺","text":"碓头一语便投机，若说风幡是落迟。\n今日堂中容百众，不知那个可传衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北七寺","author":"方信孺","text":"国清尊胜北山隅，證果报恩同一区。\n地藏荒芜并报国，尚馀悟性斗牛墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会仙观","author":"方信孺","text":"绰约长眉海上仙，久餐云母学长年。\n山中丹井今无恙，为吊南充谢自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"动石","author":"方信孺","text":"山中块石老僧言，一叱应知转法轮。\n元是世人心自动，请将消息问风幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵洲","author":"方信孺","text":"东南佳气盛衣冠，楼阁翚飞缥缈间。\n疑是落星湾上见，更须题作小金山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走珠石","author":"方信孺","text":"底事明珠解去来，当时合浦已堪猜。\n贾胡不省何年事，老石江头空绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金牛山","author":"方信孺","text":"金牛去后久凄凉，好景乾坤亦秘藏。\n沧海无穷月无尽，从今收拾入诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"珊瑚井","author":"方信孺","text":"可怪仙翁亦世情，珊瑚还许致殷勤。\n波神不是赵佗客，即是前身石季伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵佗疑冢","author":"方信孺","text":"漫说曹瞒七十馀，老佗疑冢更模糊。\n不知禹葬会稽处，也有累累如许无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒲涧","author":"方信孺","text":"拔宅谁能辨有无，涧边空记旧丹炉。\n世间自是多凡骨，何处犹寻九节蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞山","author":"方信孺","text":"西风搅桂树，落日明枫林。\n游子怀归期，予悲渺登临。\n虞山一何高，湘水一何深。\n英皇仅枯冢，寂寞薰兮琴。\n我欲奏古曲，俗耳更哇淫。\n古器不可见，聊作相思吟。\n相思长相思，相思无古今。\n一歌众鸟听，再歌万籁喑。\n推手君勿歌，有酒且孤斟。\n落落此时意，寥寥千载心。\n五弦毋庸绝，四海谁知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滴水岩","author":"方信孺","text":"天半飞涛六月寒，苍崖壁立互回环。\n从今好事能题品，列作南中第一山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题万岁寺","author":"方信孺","text":"磊磊洞庭石，渺渺苍梧云。\n客行离骚国，长歌酹湘君。\n湘君不可见，古庙藏江氛。\n空坛颇亡恙，谁为真将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"李师中","text":"春波饱微绿，斗柄涵虚明。\n方舟贯岩腹，鹅鹳相酬鸣。\n仰窥穹窿顶，宛转百怪呈。\n仅馀鳞甲碎，不见头角狞。\n下闯清泠渊，演迤万顷澄。\n但同鱼鸟参，勿遣蛟龙惊。\n抉苔抚奇篆，倚棹看题名。\n三将标殊勋，自与山不倾。\n谁与赘小筑，政恐山灵嗔。\n南洞更幽绝，仙佛依峥嵘。\n太虚可为室，岂复资栾楹。\n乳泉助茗盌，中有冰雪清。\n何须骖鸾去，此即白玉京。\n鼎来不速客，抱琴忽逢迎。\n爱此无弦曲，岩溜同一声。\n为君洗尘耳，唤我诗魂醒。\n祗恐白衣至，好句亡由成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写真求赞者 其三","author":"方信孺","text":"十年红紫□，容易怨春园。\n不向瓶中见，还从檐上看。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写真求赞者 其二","author":"方信孺","text":"行乐顿因人事懒，坐忘常觉世缘轻。\n琴清临水容鱼听，篁暖当筵学凤鸣。\n便道登仙岂欺我，芙蓉花绕桂林城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠写真求赞者 其一","author":"方信孺","text":"向□瓦砾怜□□，颇欲丹青结胜缘。\n大似欠渠佳句在，不妨时复系渔船。\n城东秀山不知数，城西新湖政自佳。\n一春车马欠行迹，万斛尘埃装我□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"方信孺","text":"曾榜武夷九曲，何如桂岭七星。\n水石小容螭隐，烟云长带龙腥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 再游龙隐岩，追和陶商翁韵","author":"方信孺","text":"碧洞青崖著雨，红泉白石生寒。\n朅来十月九湖山。\n人笑元郎太漫。\n绝壑偏宜叠鼓，夕阳休唤归鞍。\n兹游未必胜骖鸾。\n聊作湖南公案。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶","author":"方南山","text":"高低庭树晚风吹，脱叶应难恋旧枝。\n莫向秋深怨零落，春深还有绿阴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"方恬","text":"蹇驴昨日雪濛濛，破帽呼舟古渡风。\n吟得诗成还未吐，要留此景著胸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至杭都游湖上","author":"方恬","text":"春闱试罢且徘徊，十里荷花浑未开。\n笑指西湖且归去，閒时应待我重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遇昱岭","author":"方恬","text":"直上最高头，无人独少留。\n万山皆在下，千里入双眸。\n马傍松边立，云从脚底浮。\n倚天一长啸，红日满沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋雪","author":"方恬","text":"睡起眼光的铄，拥衾缩劲高吟。\n推转小窗惊看，松林翻作琼林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"方恬","text":"长驱笔阵浑无碍，扫尽春蚕食叶声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题竹轩","author":"方洵武","text":"劲节孤根得地深，清虚谁识子猷心。\n当时不是琅玕种，月下何由听凤琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宁国院十全堂","author":"方洵武","text":"卢扁不世出，死生非在人。\n草木孕妙理，金玉潜至神。\n用之固有序，品制非君臣。\n世之挟术者，不啻空中尘。\n悉以利自售，幽枉何由伸。\n韫公药之师，所得无非真。\n构堂备观寂，榜墨如堆云。\n再味维摩言，深悯芭蕉身。\n我病众生病，当推病之因。\n诸幻起诸妄，勿药常欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":9107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]