[{"title":"中说","author":"刘克庄","text":"先业归犹在，遗经读未终。\n岂无门弟子，私谥作文中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中?春祀二首 其二","author":"刘克庄","text":"归鞍常苦夕阳催，小憩聊分饮胙杯。\n万一得年如小父，尚堪十度扫松来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中?春祀二首 其一","author":"刘克庄","text":"少者游方老守闾，独携鱼菽荐幽墟。\n何时汝辈无行役，岁岁为翁策蹇驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰湖三首 其三","author":"刘克庄","text":"作桥聊结众生缘，不计全家落瘴烟。\n内翰翻身脱犀带，黄门劝妇助金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰湖三首 其二","author":"刘克庄","text":"小米侍郎生较晚，龙眠居士远难呼。\n不知若个丹青手，能写微澜玉塔图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰湖三首 其一","author":"刘克庄","text":"岷峨一老古来少，杭颍二湖天下无。\n帝恐先生晚牢落，南迁犹得管丰湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书小窗所见","author":"刘克庄","text":"干接枝分整复斜，随缘装点野人家。\n小窗有喜无人见，兰在林中出一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书山壁","author":"刘克庄","text":"斸地栽林自起坟，一灯精舍疏玄文。\n诗成莫洒酒家壁，题遍青山题白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其一","author":"刘克庄","text":"竭海夷山气力雄，只愁无术驻颜红。\n却须擘划千馀岁，多买丹砂置女僮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其二","author":"刘克庄","text":"因治陶朱术太精，世间无物足经营。\n更将郭璞书频看，只恐青山尽凿平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事三绝 其三","author":"刘克庄","text":"昨收边讯云蝗入，近得京书报哨回。\n放得子陵归钓濑，还他高密上云台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事三绝 其一","author":"刘克庄","text":"耳根闻得吴田熟，客自吴归乃不然。\n中户无粮支卒岁，上都有雪瑞来年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事三绝 其二","author":"刘克庄","text":"蜀相昔曾耕渭上，汉家今有籴湟中。\n唱筹但欲令边实，悬罄谁知虑国空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书第二考","author":"刘克庄","text":"遥领丛祠又一年，何功月请水衡钱。\n江南塞北虽无分，林下山间尚有缘。\n兵去未妨行酒令，印收不碍掌诗权。\n祇嫌海峤登临少，梦绕朱陵紫盖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书壁","author":"刘克庄","text":"綀衣蒲屦小纶巾，四壁清风一榻尘。\n谁谓先生贫到骨，百金新聘竹夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五言一首","author":"刘克庄","text":"驴多为令仆，蚁亦拜侯王。\n恰则封万户，俄然梦一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟生日五绝 其四","author":"刘克庄","text":"菰甘因辍送，荔熟亦均分。\n食指真欺我，脾神不似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟生日五绝 其五","author":"刘克庄","text":"平生老兄弟，岁晚共婆娑。\n苏氏推同叔，程家说二哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟生日五绝 其二","author":"刘克庄","text":"爵并开乡邑，官皆视大蓬。\n年龄高略似，须发黑难同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟生日五绝 其一","author":"刘克庄","text":"郎宿临初度，村翁喜欲颠。\n要知侬甲子，老弟已稀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟生日五绝 其三","author":"刘克庄","text":"我昔单栖久，君今半被空。\n天公将老寿，裨补两鳏翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟和前韵再得五首 其五","author":"刘克庄","text":"甫昔排阊阖，雄曾赋馺娑。\n而今行不得，切莫唤哥哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟和前韵再得五首 其四","author":"刘克庄","text":"秧马催予出，铜鱼羡子分。\n无莲照学士，有竹比封君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟和前韵再得五首 其三","author":"刘克庄","text":"荆花开渐少，瓜蔓摘几空。\n赖有长头子，相从秃鬓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓部弟和前韵再得五首 其二","author":"刘克庄","text":"莫放双眉皱，休嗟两鬓蓬。\n耆英图里看，若个弟兄同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":29388,"sha256":"18413bf73b9d113baa963a97950b84db1032d