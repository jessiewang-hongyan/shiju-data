[{"title":"次韵晦父喜雨诗","author":"曹彦约","text":"何处鸣鸠只好音，谁家孝妇有冤心。\n古来禋祀关仍叔，今日兵饥忆华歆。\n王制不堪乖用仂，春秋从此却书霖。\n君诗好似灵湫水，清绝无人测浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵清卿用使君鹿鸣韵见贻","author":"曹彦约","text":"甲戌家声仅有传，等閒膏泽下云天。\n苦无事业荣宗党，强把忠勤了岁年。\n往事纷纭几折角，后来奔轶要加鞭。\n得时自古无淹速，却与亨涂作寿仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄一之","author":"曹彦约","text":"芜尽田园学亦荒，衰年无复梦张阳。\n起予节里心期合，及此年时脚力强。\n万古推迁陵谷变，几人登览姓名香。\n欲追奔逸惭驽蹇，始信人间有乘黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵葛丞至节见邀踏雪","author":"曹彦约","text":"照人好语妙阳台，佳节相随七日来。\n甚欲去陪桃竹杖，可怜消尽豆秸灰。\n喜君天上星辰次，赠我人间锦绣堆。\n小试平章和气动，他年台鼎要盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江村散步","author":"曹彦约","text":"已落无边木，犹诛不尽茅。\n沙光迎远景，风力闹寒稍。\n牧处高低路，渔时远近郊。\n竹篱茅舍外，门闭可推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赋红梅四十字","author":"曹彦约","text":"雪月个高寒，求多意未阑。\n林逋五品服，宋璟九还丹。\n老友松筠健，贤宗鼎鼐酸。\n任渠蜂蝶闹，难作武陵看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟中连雨","author":"曹彦约","text":"客里逢连雨，龙公不贷人。\n一蓬遮晦朔，万虑入悲辛。\n忽忽淹吾道，堂堂送此春。\n谁欤讼风伯，挥扫鉴中尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"况子沿檄来归舟过淮右绣衣左国录赠行以诗因及衰朽次韵奉酬三首 其三","author":"曹彦约","text":"忆昨相逢是豫章，笑谈亲接齿牙香。\n如今但有心期在，不似当初脚力强。\n投老颇能安晚境，祝釐聊以报明王。\n简编未了平生债，冷淡犹能读老庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"况子沿檄来归舟过淮右绣衣左国录赠行以诗因及衰朽次韵奉酬三首 其二","author":"曹彦约","text":"金石为心锦作肠，案前合侍玉皇香。\n只因淮蔡须裴度，不为并州戏葛强。\n绣斧迩来新遣使，毡裘从此尽输王。\n功成远勒燕然石，閒却江西左氏庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"况子沿檄来归舟过淮右绣衣左国录赠行以诗因及衰朽次韵奉酬三首 其一","author":"曹彦约","text":"况也来从班马傍，泛舟千里尚醲香。\n庭虽过鲤元无异，桴偶乘由得问强。\n亲见治民如治眼，归谈勤贼定勤王。\n翻思父子寒如此，孤负珠玑富墨庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"序斋丁主簿挽章","author":"曹彦约","text":"诗礼彬彬到古风，月桥人物序斋中。\n郑公宅畔乡仍在，马氏台前帐已空。\n万事可堪评夜旦，九泉终不盖英雄。\n只今家学方如此，犹喜先生易未东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张行父大监出镇章贡舣舟来索诗","author":"曹彦约","text":"颇觉邅回甚，由来去就轻。\n坐曹虽冷淡，出位极精明。\n我老犹贪禄，君行已问程。\n虎头虽好郡，朝路忆峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日热甚中夜得雨","author":"曹彦约","text":"蛆蚁开新盎，鸡豚落社锅。\n草衰秋水净，木脱暮山多。\n颢气时应爽，骄阳老更苛。\n依然霖雨在，暑酷要消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎寺丞舅归舟","author":"曹彦约","text":"桂林使者赤松人，争得匡庐自在身。\n蝉蜕一官惊俗子，鹳鸣双橹压江神。\n人生到此方为乐，世路新来可具陈。\n开尽朱门无锁钥，满城桃李万家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨中买归舟","author":"曹彦约","text":"泛菊囊萸事已休，光阴无脚驶如流。\n更无出入消磨雨，只有悲凉断送秋。\n戴屋未停持伞手，买舟先办打篷头。\n悬知明镜重飞处，昵昵灯前问鄂州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨坐湖庄","author":"曹彦约","text":"泥泞政如许，出门安所之。\n龙公无倦日，老子有閒时。\n适意家常酒，忘怀独自棋。\n困来饶一睡，百虑本何思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵武赵使君挽章二首 其二","author":"曹彦约","text":"脱白同辛丑，苍黄共丙寅。\n京华誇俊逸，鄂渚话酸辛。\n谓上樵川最，还登要路津。\n邻墙摧一柱，岁晚倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵武赵使君挽章二首 其一","author":"曹彦约","text":"近代金枝里，何人桂籍传。\n祖孙三世盛，文武两科全。\n日月开宏业，山川哭盛年。\n天高无可问，有德在民编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈氏夫人挽章","author":"曹彦约","text":"受氏推玄女，来嫔得召南。\n躬行其诫七，礼尽所从三。\n孝养衣皆綵，权舆色已蓝。\n霜风吟木末，哀怨不能堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈伯量挽诗二首 其二","author":"曹彦约","text":"我晚惭初学，公才又壮年。\n同盟觉山寺，共饮玉溪泉。\n薄宦身常隔，高怀骨易仙。\n伤心风作恶，不助过湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈伯量挽诗二首 其一","author":"曹彦约","text":"朴茂开城府，师资足楷模。\n官卑虽晚境，子仕却亨途。\n不酒陈惊座，无金疏大夫。\n何人碑有道，老手看慈湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使君见示鹿鸣诗走笔奉和","author":"曹彦约","text":"眼明及见决科文，发策当书第一勋。\n八句催行歌白雪，一言合意定青云。\n君今去亦朝天上，主圣还须对夜分。\n遥想朱华传敕处，九重春色醉朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使君领客访湖庄分简斋茂林当日映群贤之句得群字","author":"曹彦约","text":"风流人物总能文，洗我榛芜久离群。\n意气扫除投老障，浩歌惊起住山云。\n风迎小队春三月，天与湖庄景十分。\n七子赋诗皆宠武，刳肠犹不报慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使君黄秘书上印有期闻严召已得好语赋唐律送之","author":"曹彦约","text":"五十莱衣宦海荣，每将忠谠报平生。\n暂分竹去宽宵旰，又赐环归近圣明。\n人物渺然须引类，东南竭矣愿休兵。\n功名自重囊中物，感悟从来看积诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和三十郎蜡梅韵","author":"曹彦约","text":"官黄新赐极恩荣，花不同梅与共名。\n颇谓寒中宜作伴，想因开早更为兄。\n世间何物疑真蜡，海上新来染碎琼。\n体得自香天分好，金涂铜砌却峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和西园胡季履见寄 其一","author":"曹彦约","text":"衣冠叶叶著师儒，创见皇家异代无。\n前事盛哉申国吕，近时继者武夷胡。\n累朝经学堪贻厥，三世名家列友于。\n莫道新来凋一萼，西园老柏更清癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和西园胡季履见寄 其二","author":"曹彦约","text":"百年几见弦三叹，万事相违臂一交。\n道合不知身隐见，诗来如见手推敲。\n我仪图此藏周庙，人实云何滞楚包。\n无奈庐山归梦急，遣书空报白云巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵振文太社邮筒远寄","author":"曹彦约","text":"天与容台掾，田园早得归。\n杯中宁有影，海上息忘机。\n世路閒身好，人生静者稀。\n更于萱草处，静看老莱衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和衮子冰诗","author":"曹彦约","text":"畏折绵霜已不胜，加工寒里立威棱。\n争明日月天无色，遏住江湖晓作层。\n欲倚为山忧晛见，不如吟柱得诗能。\n规恢可但滹沱事，只任贤能也中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉济驿次杜老送严公韵","author":"曹彦约","text":"奉济传芳久，当年折柳情。\n来赓工部句，去作锦官行。\n诗妙将安仿，吾衰及此荣。\n草堂修旧否，得见慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳德器远来见访袖出六年前所赋湖庄诗次韵答之","author":"曹彦约","text":"巴蜀归才子，江湖枉使车。\n久吟工部句，新寄子公书。\n面对花应笑，眉开柳为舒。\n苦无杯酒暇，人事正纷如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昌化朱浪潘子云汉臣季子也汉臣既物故持其季父圣与诗来因问堪村徐季登其健如昔昔戊戌省试后道出昌化馆于汉臣一日同访季登遇榜下第于渡口今三纪矣因子云告别有感前事作此章以饯之为我谢圣与兼简季登","author":"曹彦约","text":"朱浪山春啼杜鹃，溪南溪北刺舠船。\n人生几度年三十，世路重逢事百千。\n客已倦游今老矣，君须揖别故凄然。\n从容有问居閒意，为说湖庄水一川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明之亦和诗来复次前韵","author":"曹彦约","text":"当年莫逆尚忘年，今日霜蓬入鬓边。\n已歃花盟犹习惰，骤迎诗敌敢攻坚。\n依栖有幸乌南绕，会合难并蚁左旋。\n著我画图添李邵，丹青那复起龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中同官游野园","author":"曹彦约","text":"忙了三年乍得閒，便乘风雨看溪山。\n可怜过眼事多少，都不关心春往还。\n老至但惊霜上鬓，兴来聊复酒开颜。\n如今便作游人唤，更欲徜徉紫翠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后早行","author":"曹彦约","text":"鼓钲攒点担先行，未报平安睡已惊。\n灯火避明天弄晓，鸟乌无乐雨悭晴。\n唤来野渡水新涨，饱得晨炊烟自横。\n驿使岭头无一信，笋舆咿轧强贪程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨行宿高冈人家戏成口号","author":"曹彦约","text":"过了一坡更一坡，中间田道水成涡。\n雨来更骤担肩重，泥滑不休行步多。\n奈老杉松犹偃蹇，趋时桃李暂蹉跎。\n炊烟恋屋不肯出，夜宿人家烧薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨雪中岁享卧病不能陪位令诸子代拜","author":"曹彦约","text":"岁事无多世事忙，病夫终日卧藤床。\n雪积易消春已近，雨来无节昼偏长。\n朝仪尚想三回舞，岁享难持一瓣香。\n莫道盖棺便无事，义方犹欲训诸郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮良父弟横舟","author":"曹彦约","text":"簿书日月费消磨，华鄂归来乐事多。\n已涉一川舟自在，相安众口曲平和。\n人生正好乘流止，尘世相逢对酒歌。\n欲泛五湖真浪语，浮家犹足镇风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲友冯仪之运干挽章三首 其三","author":"曹彦约","text":"子也吾尝友，天乎独异渠。\n仕无通籍禄，家有厚斋书。\n讲说来匡鼎，风骚藉子虚。\n争荣森窦桂，训不负蕃畬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲友冯仪之运干挽章三首 其二","author":"曹彦约","text":"有学关时用，无心与物驰。\n已称黄发老，犹似綵衣时。\n世道空机阱，襟期自坦夷。\n只今风月夜，犹足想清规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"亲友冯仪之运干挽章三首 其一","author":"曹彦约","text":"闻道江西使，宾筵陨德星。\n失声归士友，短气动朝廷。\n屡选非无意，迟行若有灵。\n忍令清燕处，我辈尚谈经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弈棋戏作","author":"曹彦约","text":"人皆托物涤尘襟，我亦于棋了寸阴。\n散诞不知身老大，从容聊与世浮沉。\n诸君误作机关说，老子初无胜负心。\n收拾定应全局在，清风明月照书林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总领户部杨公挽诗 其二","author":"曹彦约","text":"赪尾劳民久，青天转粟艰。\n三年流马运，一笑狎鸥閒。\n天远才多阨，功深报肯悭。\n勒铭周伏柱，何恨掩丘山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总领户部杨公挽诗 其一","author":"曹彦约","text":"华显世儒业，循良今吏师。\n未应州县薄，能简庙堂知。\n沃辔歌周雅，含香问汉仪。\n经纶殊未展，曛景迫崦嵫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总领户部杨公挽诗 其三","author":"曹彦约","text":"二昆同唱第，短世不堪言。\n生晚欣亲炙，谦撝过抚存。\n里门重拥彗，秀野祇空园。\n零落西归藁，谁能作九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故丞相忠定赵沂公挽章三首 其三","author":"曹彦约","text":"谫谫群情便，峣峣俗眼惊。\n此身无利钝，于国要忠诚。\n得力平生学，求仁死后名。\n登门非雅素，持论略公平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故丞相忠定赵沂公挽章三首 其二","author":"曹彦约","text":"盐筴宽闽甚，兵权虑蜀多。\n闽民今可矣，蜀事竟如何。\n便好尸而祝，初无玷可磨。\n繄谁求径捷，行陆强风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故丞相忠定赵沂公挽章三首 其一","author":"曹彦约","text":"对策飞龙日，宗卿夙所期。\n时来人激烈，身定国危疑。\n一德三朝老，孤忠百世师。\n是非空贝锦，铭篆有钟彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故经略华文赵郎中崇宪挽章三首 其三","author":"曹彦约","text":"世路平平好，民庸处处高。\n入朝宁却步，及物自忘劳。\n系望人宗主，为仪国羽毛。\n修文才下寿，天亦负英豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故经略华文赵郎中崇宪挽章三首 其二","author":"曹彦约","text":"出处权轻重，几微见老成。\n我官浑漫浪，公道要分明。\n忠定名先正，奸谀魄自惊。\n翻思元祐事，千古欠哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故经略华文赵郎中崇宪挽章三首 其一","author":"曹彦约","text":"国是归宗相，儒科看嫡传。\n与时常落落，持论极拳拳。\n柄用无韩范，师承有涧瀍。\n衣冠何足论，父子世称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故邕管安抚李思永挽章三首 其三","author":"曹彦约","text":"念昔浮湘乐，论交一世豪。\n味同江左右，人忘品卑高。\n庇我渠渠屋，关心恋恋袍。\n延津龙化后，流水但空号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故邕管安抚李思永挽章三首 其二","author":"曹彦约","text":"义利明千古，躬行勇不疑。\n涧瀍穷正脉，张陆是吾师。\n仕与儒先会，官从党论卑。\n所施才一障，声闻彻华夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故邕管安抚李思永挽章三首 其一","author":"曹彦约","text":"发廪宁忧岁，防边不待秋。\n古来汉循吏，今说李成州。\n劲气横关陇，神光射斗牛。\n竹林天下士，一第可无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故殿撰侍郎赵公挽章三首 其三","author":"曹彦约","text":"早岁灯窗密，中年宦海遥。\n相看嗟落寞，晚复共渔樵。\n已矣耆英会，居然一叶凋。\n岂无朋友念，人物叹公朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故殿撰侍郎赵公挽章三首 其二","author":"曹彦约","text":"边锁求良牧，京华倚重臣。\n抚摩中有备，发擿静无尘。\n效著龙颜动，班疑豹尾真。\n讣闻遗憾见，进秩有明纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故殿撰侍郎赵公挽章三首 其一","author":"曹彦约","text":"惠国垂芳久，泸南锡第初。\n诗书今有此，衣钵正关渠。\n业大喧朝野，儒酸羡里闾。\n只言三桂盛，五桂尚权舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故殿撰修史李舍人挽章二首 其二","author":"曹彦约","text":"丁未慈恩盛，从容最后来。\n一从辞墨绶，三徙入乌台。\n记动时方好，持衡去不回。\n恩荣频出綍，晚遇有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故殿撰修史李舍人挽章二首 其一","author":"曹彦约","text":"四戒从谁得，忠勤与孝廉。\n本原来简册，膏润到闾阎。\n仕久机锋熟，时来智虑添。\n平生真售用，家法有森严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故福建提刑钟编修挽章二首 其二","author":"曹彦约","text":"江汉迎归客，潇湘问故人。\n锦衣新炫昼，绣使近行春。\n坐对长沙酒，空伤夜雨神。\n南楼风月下，霏屑易成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故福建提刑钟编修挽章二首 其一","author":"曹彦约","text":"问俗周方国，推贤汉吏师。\n立朝天有喜，仗节玉无疵。\n得自南轩学，亲承北面师。\n更无工部句，可继八哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春同伯中之栎田","author":"曹彦约","text":"涖卜他年正首丘，尚乘风日逐英游。\n平分正月春犹浅，断送元宵冷未休。\n藕断山钟黄檗外，枝分水转石榴头。\n卷帘隐几俱为乐，付与涪翁闷得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春至","author":"曹彦约","text":"闰后阳和乐不禁，还将动静印天心。\n借留腊意梅藏玉，指点春容柳转金。\n冗夺渐疏诗领略，情钟须索酒追寻。\n玉京山色䢼亭水，自与丝桐作赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春问湖庄","author":"曹彦约","text":"问讯湖庄事，经年意若何。\n为渠魂入梦，老我鬓添皤。\n雪霁春应好，山明水渐多。\n遣儿徵仆役，除道莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春到湖庄","author":"曹彦约","text":"饱绿匀杨柳，殷红茁海棠。\n将春到昌谷，及早下湖庄。\n祠事三年乐，边心万里长。\n新来和气好，吉报已占祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]