[{"title":"偈颂一百零一首 其五十六","author":"释慧性","text":"是句亦刬，非句亦刬。\n瞒瞒顸顸，生铁门限。\n如斯出世为人，瞎却衲僧正眼。\n子细捡点将来，也是徐六担板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十三","author":"释慧性","text":"久雨不晴，才晴又雨。\n阴阳交泰，万物得所。\n明明百草头，能为万象主。\n觌面相呈，切忌莽卤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十三","author":"释慧性","text":"摇唇鼓舌，展事投机。\n千佛出世，不通忏悔。\n焦巴焦巴，有叶无丫。\n长天秋水，孤鹜落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十一","author":"释慧性","text":"雪埋松径，梅著寒梢。\n露裸裸，赤洒洒，独孤标。\n寒山逢拾得，抚掌笑呵呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十九","author":"释慧性","text":"无作无为，无说无示。\n可以济群，类统万邦。\n同六虚，融三际，此是吾家第一义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十七","author":"释慧性","text":"毒蛇头上能揩痒，正是吾家跳灶儿。\n窃得这些穷伎俩，白拈手里觅便宜。\n万仞崖头独足立，头长三尺知是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十八","author":"释慧性","text":"风萧萧兮疏林叶落，月皎皎兮虎啸猿啼。\n或闻或见，或悟或迷。\n会与不会，脱体全提，鼻孔元是向下垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十六","author":"释慧性","text":"有结有解俱错，到底无绳自缚。\n一夏九十日终，个个眉须堕落。\n入水长人，填沟塞壑。\n相逢只解那斯祁，明眼衲僧休卜度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十二","author":"释慧性","text":"初三十一，中九下七。\n更不囊藏，当阳拈出。\n一气转洪钧，八方开寿域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十五","author":"释慧性","text":"云收天际，杲日当空。\n坐立俨然，如何通信。\n自是不归归便得，五湖烟浪有谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十","author":"释慧性","text":"大包无外，细入无间。\n内外绝瑕疵，古今无背面。\n森罗万象影中藏，四圣六凡光里现。\n分明常在诸人前，未审诸人见不见，铁壁银山通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二十一","author":"释慧性","text":"元宵正月半，是处金莲现。\n贪看灯明佛，蹉过新罗箭。\n闪电光中，聊通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十六","author":"释慧性","text":"雨过长空，檐头滴滴。\n觌面相呈，人信不及。\n信得及，万古长空元不湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十八","author":"释慧性","text":"兔马有角，牛羊无角。\n智不到处，切忌道著。\n拈得鼻孔还失却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十五","author":"释慧性","text":"杀人刀，活人剑，劈破虚空成两片。\n千妖百怪尽潜踪，万象森罗光影现。\n艾人与门神，端的见不见。\n拄杖子聊通一线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其二","author":"释慧性","text":"指天指地，有甚巴鼻。\n目顾四方，不知失利。\n累及后代儿孙，以此递相钝置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三","author":"释慧性","text":"电激雷奔，以毒攻毒。\n撒土抛沙，拗直作曲。\n个里翻身控角弓，谁能背手抽金镞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其六十四","author":"释慧性","text":"本犀花散一山秋，更约清风作胜游。\n笑傲幽香翻叶底，西来祖意在枝头。\n没回互，兴悠悠，辽天鼻孔齐穿却，更嫌何处不风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十七","author":"释慧性","text":"一即一切，一切即一。\n拈青玉峡，向焦螟眼中。\n撮大地来，如粟米粒。\n会则事同一家，不会则知我受屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其五十七","author":"释慧性","text":"瞿昙夜半见明星，碓觜挑开眼里筋。\n四十九年无畏说，至今错认定盘星。\n将头不猛，带累三军。\n曹溪波浪如相似，无限平人被陆沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十五","author":"释慧性","text":"庐山华藏太湖滨，碓觜挑开眼里筋。\n来趁寿宁炉灶热，大千独步见鹏程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十六","author":"释慧性","text":"郊原雨过，春日熙熙。\n桃红李白，发最上机。\n哑却口，落尽眉。\n就中一曲江南好，芦管迎风撩乱吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十一","author":"释慧性","text":"祖祢不了，儿孙遭累。\n祝著磕著，无处回避。\n不辞礼拜烧香，也要递相钝置。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其五","author":"释慧性","text":"放两抛三，瞒神謼鬼。\n换盆换盆，谁不识你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九","author":"释慧性","text":"天寒日短，三平二满。\n虎咬大虫，雄鸡生卵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四十七","author":"释慧性","text":"声前一句，十方显露。\n佛祖不知，衲僧罔措。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十","author":"释慧性","text":"点捡将来，罪过不少。\n只凭拄杖，一切靠倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其九十六","author":"释慧性","text":"智不是道，心不是佛。\n辊雪峰毬，舞道吾笏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十八","author":"释慧性","text":"独标万象，物外宣扬。\n天长地久，地久天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十三","author":"释慧性","text":"喝散白云，穿开碧落。\n须弥灯王，无处摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其十","author":"释慧性","text":"言发非声，舌头无骨。\n色前不物，狐狸恋窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞世","author":"释慧性","text":"七十八年，内空外空。\n撒手便行，万古清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天封寺","author":"释慧明","text":"华顶当空出，云霞宿殿庭。\n八荒同纳纳，一气转冥冥。\n日驭经檐过，天河俯槛听。\n长年苔径合，无客到岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无心道人梁长道以偈见寄次韵","author":"释慧空","text":"法从本有何曾有，心自元无不用无。\n试问大雄山下虎，何如千里踏人驹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四景 其二","author":"释慧空","text":"野阔烟迷树，江清水学天。\n白鸥盖具眼，终日老人边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四景 其三","author":"释慧空","text":"急雨近欲黑，斜晖远更明。\n倚楼谁氏子，兴与大江横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石门庵偶作","author":"释慧空","text":"百鍊黄金铸铁牛，十分高价与人酬。\n台前不有花含笑，应是东山一夏休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次游教授韵呈草堂老师 其二","author":"释慧空","text":"北郁之南瞻部洲，纵观谁是老人流。\n大千一网平收了，坐看儿童乱下钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次游教授韵呈草堂老师 其一","author":"释慧空","text":"霜发垂垂老不休，铁船无底更随流。\n儿孙莫讶得鱼少，盖谓翁翁是直钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵知微无外石门相会","author":"释慧空","text":"铁牛插翅快于鹘，石虎抬头惊倒人。\n笑把方山轻捩转，几多游子失关津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵韩伯修学士读楞严见寄","author":"释慧空","text":"琉璃瓮中走却鳖，惊起波斯一夜寻。\n天晓不知何所见，大悲菩萨是观音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别刘师美 其一","author":"释慧空","text":"世故熏人易变初，谁能变处即如如。\n相看有道遽难说，且可还家深读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别刘师美 其二","author":"释慧空","text":"十年倦客思深隐，江北江南千万峰。\n今后故人应念我，有书何处觅行踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟月","author":"释慧空","text":"圆时缺处何曾有，缺处圆时自俨然。\n举世尽随圆缺走，几人透出未生前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看洞山初和尚语","author":"释慧空","text":"两头蚯蚓呈三要，五眼胡孙念八还。\n老蚌吞除龙树月，瞎驴撞出赵州关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人化修上 其二","author":"释慧空","text":"尽谓黄龙山里龙，弥年翻去碧潭空。\n君行为报居人道，遐迩虽殊一雨同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人化修上 其一","author":"释慧空","text":"尔祖传家唯此钵，中虽无物不忧贫。\n持从闹市门头过，倒廪倾囷自有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送泽化士兼简云门延福二老 其一","author":"释慧空","text":"青蛇在握心方壮，赤骥追风路不遥。\n透得云门铁关过，海涛声撼洛阳桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送泽化士兼简云门延福二老 其二","author":"释慧空","text":"吉山何啻百弥卢，袖里携来一物无。\n前路逢人即拈出，不知谁是赤须胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送泽化士兼简云门延福二老 其三","author":"释慧空","text":"过了云门更好看，前头孤峻有姜山。\n三关一箭收功后，南海波斯念八还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送茶化士 其二","author":"释慧空","text":"五湖云水访山家，不问亲疏尽与茶。\n若省此茶来处者，出门风摆绿杨斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送茶化士 其一","author":"释慧空","text":"建溪深与吉山邻，胜气潜通不在陈。\n但看吉山茶椀里，雪花时现建溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫内翰五首 其五","author":"释慧空","text":"今者丛林走大声，不言无眼只无睛。\n愿公善保千钧重，莫管他家热椀鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫内翰五首 其四","author":"释慧空","text":"试问同参参底事，华亭秋晚水如天。\n离钩三寸无人会，风起芦花落钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫内翰五首 其三","author":"释慧空","text":"黄龙室内三关语，赵老青州一布衫。\n何事临分无别说，则川庞老是同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫内翰五首 其二","author":"释慧空","text":"一槌从使口如鼻，百炼谁知方入圆。\n莫怪野人高索价，从来佛祖不曾传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送莫内翰五首 其一","author":"释慧空","text":"惊世文章梦里花，出尘悟解眼中沙。\n怪来不打这鼓笛，亲见江西老作家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送照上人","author":"释慧空","text":"五华崷崒白云中，送尽行人是此峰。\n若问此峰何面目，但言瓶锡住经冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十九","author":"释慧空","text":"百书不如一归家，千闻不如一见面。\n既归归见复何为，解道德山无佛殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十七","author":"释慧空","text":"钱塘潮头来，成都药市集。\n叵叵汝州风，吹落毛僧笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其二","author":"释慧空","text":"宗师一等把宗纲，鲁祖垂慈太著忙。\n璞玉浑金虽定价，往来多是不相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其一","author":"释慧空","text":"不是风兮不是幡，祖师端的广南蛮。\n夜深趁得曹溪渡，失却番禺两岸山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十三","author":"释慧空","text":"古人悟处今人眼，善巧休为眼画眉。\n不见马头人厮扑，一拳打倒只临时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其五","author":"释慧空","text":"新妇骑驴阿家牵，潦倒禅翁雪满颠。\n不解炉头煨死火，客来偏爱出人前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其六","author":"释慧空","text":"杖林山下竹筋鞭，生长由来古佛先。\n一击眼睛才定动，又随烟雨过秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十八","author":"释慧空","text":"六国平来一瞬中，心王不动八方通。\n从前汗马无人见，只要重论盖代功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其五","author":"释慧空","text":"杖林山下竹筋鞭，六月行人口吐烟。\n曾在祝融峰顶见，十分月出在平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十一","author":"释慧空","text":"不是风幡不是心，曹溪一路尽平沈。\n俊鹰岂肯篱边立，直透青霄万万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其四","author":"释慧空","text":"藏身北斗道弥昌，三脚虾蟆著锦裆。\n多少病猫餐死鼠，日中抬首眼无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其七","author":"释慧空","text":"赵州老倒一禅和，勘破台山个老婆。\n笑倒石门庵内客，一条济水过新罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十五","author":"释慧空","text":"一等作野狐，堂堂大丈夫。\n徐行青草岸，踏破洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其九","author":"释慧空","text":"不是风兮不是幡，胡僧两耳带金环。\n分明有语无人会，又上高楼看远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其三","author":"释慧空","text":"楚王城畔水东流，淮海维扬是九州。\n芦管一声春梦破，斜阳还在树梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十","author":"释慧空","text":"不是幡兮不是风，毒蛇卧在酒杯中。\n寒山抚掌丰干笑，万里鸿沟属沛公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十二","author":"释慧空","text":"十智同真验作家，可中毫忽不容差。\n若无师子翻身句，现在徒将面自誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其十五","author":"释慧空","text":"桃花春暖尽情开，一见无疑颇俊哉。\n不是钓鱼船上客，无人把手上高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古 其三","author":"释慧空","text":"庐陵米价忽相酬，巨宋山河四百州。\n青草渡头韩干马，绿杨阴里戴嵩牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]