[{"title":"河传 送游君安解绵竹尉","author":"李吕","text":"琢成玉树。\n谁解著、云斤月斧。\n短箠羸骖，朴樕一怀尘土。\n叹雄图、伤别绪。\n主人不语花能语。\n苦欲留君、不是留君处。\n碧落紫霄，楼观参差烟雾。\n一樽空、鸿鹄举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花","author":"李吕","text":"一岁光阴寒共暑。\n一日光阴，只个朝还暮。\n有物分明能唤寤。\n晚钟晨角君听取。\n扰扰胶胶劳百虑。\n究竟思量，没个相干处。\n只有一般携得去。\n世人唤作闲家具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 和伯称","author":"李吕","text":"山雨喜开霁，爽气涤烦襟。\n晚秋丹叶飘坠，篱菊散黄金。\n徙倚关河凝望，回首光阴轻驶，倏忽二毛侵。\n须信人间世，莫放酒杯深。\n一星子，名与利，漫浮沈。\n塞翁祸福无定，此理古犹今。\n妙处只应亲到，外物从渠舒卷，出处我无心。\n袖手无新语，洗耳听清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春 叹老","author":"李吕","text":"射虎南山，断蛟北海，恍如梦中。\n念少年豪气，霜寒一剑，清时功业，月满雕弓。\n年去年来成底事，已一半消磨成老翁。\n那堪更，病为城绕，愁作兵攻。\n无悰。\n慵语西风。\n正独倚危阑送塞鸿。\n道酒能消遣，酒因病减，歌能消遣，歌为愁浓。\n大造不将炉冶去，□万卷诗书宁愤穷。\n都休问，且试弹绿绮，闲和秋虫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青玉案 春夜怀故人","author":"李吕","text":"参横月落闻街鼓。\n指杨柳、天边路。\n冷澹梨花啼玉箸。\n五云芝检，八花砖影，稳上鳌头去。\n吹箫台冷秦云暮。\n玉勒嘶风弄娇步。\n四雁峰前凭尺素。\n壁尘香减，绮窗风静，记得题诗处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙","author":"李吕","text":"家在宋墙东畔住，流莺时送芳音。\n窃香解佩两沈沈。\n都缘些子事，过却许多春。\n日上花梢初睡起，绣衣闲纵金针。\n错将黄晕压檀心。\n见人羞不语，偷把泪珠匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"李吕","text":"去岁天涯，一灯闲作幽窗伴。\n酒来须满。\n不待旁人劝。\n今岁天涯，又是年华晚。\n凄凉惯。\n问天不管。\n只我何曾管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令 其一 笑","author":"李吕","text":"眼尾。\n寄深意。\n一点兰膏红破蕊。\n钿窝浅浅双痕媚。\n背面银床斜倚。\n烛花先报今宵喜。\n管定知人心里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令 其二 饮","author":"李吕","text":"归晚。\n思何限。\n玉坠金偏云鬓乱。\n伤春谁作嬉游伴。\n只有飞来花片。\n几回愁映眉山远。\n总被东风惊散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令 其五 歌","author":"李吕","text":"含怨。\n两颦浅。\n羽髻云鬟低玉燕。\n绿沈香底金鹅扇。\n隐隐花枝轻颤。\n当筵不放红云转。\n正是玉壶春满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其二","author":"李吕","text":"堂成开宴日无空。\n景占四时中。\n画栋翚飞星汉，雕阑锁断花风。\n薰人和气，清谈四坐，雅量千钟。\n早晚催归天仗，往来还记溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 其一","author":"李吕","text":"展屏山色翠连空。\n潇洒冠闽中。\n背郭元无尘事，披襟时有清风。\n君侯雅致，临流句丽，爱月情钟。\n乐府直追欧老，堂名新自陶翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"李吕","text":"光拂星榆，轮高金掌，暮烟飘尽澄空。\n素娥幽恨，霜艳洗铅红。\n醉把摩云妙手，教纤翳、不点青铜。\n知多少，天高露冷，争占九秋风。\n歌钟。\n邀胜侣，园攀琼树，帘卷珠宫。\n算庾楼吟赏，今古应同。\n多谢秦娥绝唱，声声为、飘入云中。\n留仙住，莫教清影，容易转梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"李吕","text":"休休莫莫。\n当年不负西湖约。\n一枝初见横篱落。\n嚼蕊闻香，长是醉乡落魄。\n而今对酒空斟酌。\n老来多病情非昨。\n谁人伴我临东阁。\n冷淡吟怀，犹可追前作。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 谢人送牡丹","author":"李吕","text":"甲帐春风肯见分。\n夜陪清梦当炉熏。\n寻香若傍阑干晓，定见堆红越鄂君。\n雕玉佩，郁金裙。\n凭谁书叶寄朝云。\n兰芽九畹虽清绝，也要芳心伴小醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 寄情","author":"李吕","text":"脸上残霞酒半消，晚妆匀罢却无聊。\n金泥帐小教谁共？\n银字笙寒懒更调。\n人悄悄，漏迢迢，琐窗虚度可怜宵。\n一从恨满丁香结，几度春深豆蔻梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汉州妓项帕罗","author":"张俞","text":"蜀国佳人号细腰，东台御史惜妖娆。\n从今唤作杨台柳，舞尽春风万万条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戍山晚行","author":"李回","text":"羸马鞭不行，落日下孤戍。\n旅店隔前村，欲往未能住。\n少年事咿唔，老为微禄误。\n匡济谢菲才，驰驱失故步。\n一笑拥八驺，不疗烟霞痼。\n猿鹤惊且恐，吟断北山树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春","author":"李团湖","text":"六桂传家，三槐植庭，箕裘大儒。\n甚二郎意气，似同稷契，一时庆会，致主唐虞。\n百揆登庸，双亲未老，此乐人间还有无。\n那堪更、有棣华韡韡，听履亨衢。\n朝来天上传呼。\n便写作、衣冠盛事图。\n有声容备乐，传宣锡动，充庭牲饩，簇拥欢娱。\n整顿乾坤，巩安宗社，亦有臣功如此乎。\n中书考，愿年年此日，春满蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见山台","author":"李夷行","text":"□□□□□□□，纷纷红紫簇虚檐。\n山光不肯饶春色，故向花间出数尖。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李夷庚","text":"生公曾说法，听石尚孱顽。\n雁塔晴观海，松门夜闭山。\n林喧群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其一 扬州","author":"李好古","text":"壮东南、飞观切云高，峻堞缭波长。\n望蔽空楼橹，重关警柝，跨水飞梁。\n百万貔貅夜筑，形胜隐金汤。\n坐落诸蕃胆，扁榜安江。\n游子凭阑凄断，百年故国，飞鸟斜阳。\n恨当时肉食，一掷赌封疆。\n骨冷英雄何在，望荒烟、残戍触悲凉。\n无言处，西楼画角，风转牙樯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八声甘州 其二","author":"李好古","text":"古扬州、壮丽压长淮，形胜绝东南。\n问竹西歌吹，蜀冈何许，杨柳鬖鬖。\n行乐谁家年少，两两更三三。\n知我江南客，走马来看。\n过却长亭烟树，云山点点，烟浪漫漫。\n料桐花飞尽，夜合绕阑干。\n倦绣闲庭昼永，望天涯、芳草忆征鞍。\n平安使，吴笺谩遣，欲寄愁难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 和金焦","author":"李好古","text":"历历江南树，半在水云间。\n不须回首，且来著眼向淮山。\n过尽金山晕碧，望断焦山空翠，杨柳绕江边。\n此意无人会，独自久凭阑。\n夜吹箫，朝问法，记坡仙。\n只今何许，当时三峡倒词源。\n水调翻成新唱，高压风流前辈，使我百忧宽。\n有酒更如海，容我醉时眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其一","author":"李好古","text":"从来难剪是离愁。\n这些愁。\n几时休。\n才趁风樯，千里到扬州。\n见说苍茫云海外，天杳杳，水悠悠。\n男儿三十敝貂裘。\n强追游。\n梦魂羞。\n可解筹边，谈笑觅封侯。\n休傍塞垣酾酒去，伤望眼，怕层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 其二","author":"李好古","text":"平沙浅草接天长。\n路茫茫。\n几兴亡。\n昨夜波声，洗岸骨如霜。\n千古英雄成底事，徒感慨，谩悲凉。\n少年有意伏中行。\n馘名王。\n扫沙场。\n击楫中流，曾记泪沾裳。\n欲上治安双阙远，空怅望，过维扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 僧如梵摘阮","author":"李好古","text":"人物风流远。\n忆当年、江东跌宕，知音南阮。\n惯倚胡床闲寄傲，妥腹难凭琴桉。\n妙制拥、银蟾光满。\n千古不传谁好事，忽茂陵、金碗人间见。\n轻擘动，思无限。\n长安钗鬓春横乱。\n仿规模、红绦带拨，媚深情浅。\n安识高山流水趣，儿女空传恩怨。\n使得似、支郎萧散。\n听到三闾沈绝处，惨悲风、摇落寒江岸。\n不肠断，也肠断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"李好古","text":"为怯赪云挟暑飞。\n嫩凉故故著征衣。\n江风吹雨过楼西。\n未必男儿生不遇，时来咳唾是珠玑。\n功名终岂壮心迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二","author":"李好古","text":"瓜州渡口。\n恰恰城如斗。\n乱絮飞钱迎马首。\n也学玉关榆柳。\n面前直控金山。\n极知形胜东南。\n更愿诸公著意，休教忘了中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"李好古","text":"清淮北去。\n千里扬州路。\n过却瓜州杨柳树。\n烟水重重无数。\n柁楼才转前湾。\n云山万点江南。\n点点尽堪肠断，行人休望长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 垂丝海棠零落","author":"李好古","text":"东风一夜都吹损。\n昼长春殢佳人困。\n满地委香钿。\n人情谁肯怜。\n诗人犹爱惜。\n故故频收拾。\n云彩缕丝丝。\n娇娆忆旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"李好古","text":"纳红销翠春风里。\n精神一撮金莲底。\n不是睡杨妃。\n绿珠娇小儿。\n一般娇绝处。\n半带疏疏雨。\n不解吐繁香。\n却教人断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一","author":"李好古","text":"东园映叶梅如豆。\n西园扑地花铺绣。\n春水晓来深。\n日华娇漾金。\n带烟穿径竹。\n步入飞虹曲。\n何处早莺啼。\n曲桥西复西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"李好义","text":"花过雨。\n又是一番红素。\n燕子归来衔绣幕。\n旧巢无觅处。\n谁在玉楼歌舞。\n谁在玉关辛苦。\n若使胡尘吹得去。\n东风侯万户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 其二","author":"李好古","text":"平生英气，叹年来、都付山林泉石。\n不作云霄轩冕梦，只拟纶竿蓑笠。\n见说湖阴，飞飞鸥鹭，半是君曾识。\n梅花时节，试来相与寻觅。\n休谩汨没尘埃，浮生能几，镜里催华发。\n趁取尊前强健在，莫负花前倾碧。\n自遣长须，亲题短句，去约萧闲客。\n休教惆怅，梅花飞尽寒食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酹江月/念奴娇 其一","author":"李好古","text":"西风横荡，渐霜馀黄落，空山乔木。\n照水依然冰雪在，耿耿梅花幽独。\n抖擞征尘，扶携短策，步绕沧浪曲。\n怅然心事，浮生翻覆陵谷。\n试向商乐亭前，冷风台上，把酒招黄鹄。\n四十男儿当富贵，谁念漂零南北。\n百亩春耕，三间云卧，此计何时卜。\n功名休问，卖书归买黄犊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李如篪","text":"缫车篱落桑阴尽，土鼓乡亭稻叶青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林东乔东禅院","author":"李存贤","text":"野云闲带雨，林木静无风。\n村落一溪外，民田四望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"李安期","text":"江左君臣笔力雄，一为宫体便移风。\n始知姬旦无才思，祇把豳诗咏女功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋白鹭","author":"李安期","text":"渔父家风不设罾，锦鳞为饭水为羹。\n银袍祇当蓑衣著，自在江湖过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李尧俞","text":"岭阳山水奇，第一称湟州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子陵二首 其二","author":"李师中","text":"社稷功名出隐沦，天高听远亦应闻。\n庞眉一去无人问，七里商山但白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子陵二首 其一","author":"李师中","text":"阿谀顺旨为深戒，远比夷齐气更豪。\n半夜光芒侵帝座，有谁曾似客星高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假守睢阳吕愿中叔恭机宜祥符刘襄子思通守鄱阳朱良弼国辅经属建安陈廷杰朝彦因祈晴乘兴游中隐岩留题以记胜游","author":"吕愿中","text":"坎止流行但信缘，峤南风景异山川。\n偶因乘兴穿山腹，始悟壶中别有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云","author":"李师中","text":"归来不觉山川小，出去岂知天地宽。\n大抵无心自无累，亦如君子所居安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙隐岩","author":"李师中","text":"轩冕傥来仍假借，功名难立更因循。\n非才不系苍生望，收取林泉自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过严关有感 其二","author":"李师中","text":"四年岭外得生还，自顾无功但愧颜。\n欲识君恩至深处，严关便是玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麦积山","author":"李师中","text":"路入青松翠霭间，斜阳倒影入溪湾。\n此中猿鹤休相笑，谢傅东归自有山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客有写真者见予因以三诗赠之 其三","author":"李师中","text":"难逢古鉴明忠腹，长似骚人带病容。\n几向清溪曾照见，万寻岩壑一青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客有写真者见予因以三诗赠之 其二","author":"李师中","text":"文命力能平水土，阿衡功亦格皇天。\n形容不上麒麟阁，当日君臣任自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭陵挽词","author":"李师中","text":"尧民丧考无生意，杞国忧天有坏时。\n闻道宗祧归圣嗣，一时收泪贺重熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"李师中","text":"燕子知时节，还寻旧宇归。\n新人方按曲，不许傍帘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩魏公席上为官妓贾爱卿作","author":"李师中","text":"愿得貔貅十万兵，犬戎巢穴一时平。\n归来不用封侯印，只问君王乞爱卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颍国庞公挽词","author":"李师中","text":"独立无朋但任真，不持身势掩君亲。\n若将坤体论臣道，公是朝廷第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉祐三年九月受命来岭外七年十一月得请知济州感恩顾己喜不自胜留诗四章以志岁月 其四","author":"李师中","text":"出岫白云犹缭绕，离群飞鸟尚鸣悲。\n四年人去宁无憾，况是梅花满树时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉祐三年九月受命来岭外七年十一月得请知济州感恩顾己喜不自胜留诗四章以志岁月 其一","author":"李师中","text":"镇抚四夷吾道在，可怜壮志日因循。\n四年尽瘁今归去，不负斯民只负身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉祐三年九月受命来岭外七年十一月得请知济州感恩顾己喜不自胜留诗四章以志岁月 其三","author":"李师中","text":"乞得衰身出瘴烟，一麾仍许视于蕃。\n家园在望松楸近，自问如何报上恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉祐三年九月受命来岭外七年十一月得请知济州感恩顾己喜不自胜留诗四章以志岁月 其二","author":"李师中","text":"侵地还来开境远，贡琛上去革音初。\n但无俘馘充归献，辜负君恩死有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":59999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天目山","author":"李师中","text":"坏壁摩娑少旧题，高情应怪赏音稀。\n烟霞正自无今古，云水从教远是非。\n丹井金龙藏洞府，杞丛花犬荡霞扉。\n登临未学神仙事，老树閒看独鸟归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自和","author":"李师中","text":"翠壁凌云耸，禅□面水开。\n岩高□□□，地胜隔尘埃。\n□□檐前□，江□□□来。\n□□无限景，得意几徘徊。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李明叔理定道中","author":"李师中","text":"幽居日日数归程，已写华严两帙经。\n门外初寒江气白，岭头多雨晓痕青。\n曾逢饭颗嘲山笠，应载鸱夷笑井瓶。\n客土相思空引望，天涯风景似新亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送桂州安抚余靖侍郎还京 其一","author":"李师中","text":"诏从东海付南麾，戎乘前驱上将威。\n异俗已传吾父至，斯文更咏我公归。\n岁时职贡还朱绂，昼日恩光赐衮衣。\n昔往今来亦何速，长亭杨柳尚依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送桂州安抚余靖侍郎还京 其二","author":"李师中","text":"拜命南来得老臣，肃将庙略制妖氛。\n淮西将吏尊儒帅，并土儿童认使君。\n新赐锦衣光照日，旧行棠树茂如云。\n应怜孤宦潮阳守，憔悴无人与上闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐州太守","author":"李师中","text":"时属艰危应有系，天于名教岂无心。\n大都狂贼终须灭，未杀忠臣祸不深。\n太尉有灵朱泚败，中丞传旨禄山擒。\n曾谁鼓舞康州事，儿女常情泪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]