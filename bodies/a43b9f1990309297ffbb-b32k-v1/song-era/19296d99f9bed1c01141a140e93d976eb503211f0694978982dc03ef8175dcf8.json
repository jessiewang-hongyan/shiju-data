[{"title":"寒食感怀次韵吴英叔","author":"朱弁","text":"疾风甚雨老难禁，岭外无饧谁解吟。\n双鬓客尘谙世变，两眉乡思尽愁侵。\n榆钱何处迎新火，杏粥频年系此心。\n落日高城魂易断，天临牛斗五湖深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食","author":"朱弁","text":"清明六到客愁边，双鬓星星只自怜。\n兵气尚缠巢凤阁，节旄巳落牧羊天。\n纸钱灰入松楸梦，饧粥香随榆柳烟。\n北向雁来寒雾隔，音书不比上林传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题云馆二星集后","author":"朱弁","text":"绝域山川饱所经，客蓬岁晚任飘零。\n词源未得窥三峡，使节何容比二星。\n萝茑施松惭弱质，蒹葭倚玉怪殊形。\n齐名李杜吾安敢，千载公言有汗青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜","author":"朱弁","text":"秋夜虽渐永，未抵客愁长。\n秋月虽巳圆，不照寸心方。\n将心贮此愁，莫作万斛量。\n为月怜此夜，谁共千里光。\n空令还家梦，欲趁征鸿翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别百一侄寄念二兄","author":"朱弁","text":"昔我别汝父，见汝立扶床。\n汝今已婚宦，我须宜俱苍。\n向来青云器，不佩紫罗囊。\n竹林我未孤，玉树汝非常。\n青衫初一尉，远在子真乡。\n念将东南归，拜我溱洧傍。\n上能论道义，次犹及文章。\n自惭老仍僻，何以相激昂。\n日暮嵩云飞，秋高塞鸿翔。\n了知还家梦，先汝渡江航。\n迢迢建业水，高台下凤凰。\n鼻祖有故庐，勿令草树荒。\n我欲种松菊，继此百年芳。\n汝归约我兄，晚岁同耕桑。\n请策葛陂龙，来寻金华羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葡萄","author":"朱弁","text":"葡萄产西域，汉使斸根回。\n自到中原后，先从上苑栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴十三年自云中奉使回送伴至虹县以舟入万安湖","author":"朱弁","text":"云中六闰食无鱼，清夜时时梦斲鲈。\n离汶未逾千里道，度淮先泛万象湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕厅设醮","author":"朱弁","text":"春容先督府，月色满江城。\n灯赏无仙梦，斋居绝市声。\n两年忧旱虐，八郡望秋成。\n凭藉刚风力，青章达九清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕","author":"朱弁","text":"立马行歌隘市门，卖薪携子出前村。\n声翻宝界金鳌动，光夺琼楼玉兔昏。\n守舍呻吟宜老病，通宵奔走付儿孙。\n潘郎岂是无情思，点检霜髭愧绿尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栽花","author":"朱弁","text":"种柳五年高出屋，攀条坐爱春阴绿。\n环池又栽数品花，蜀葵玫瑰与石竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"朱弁","text":"花到上林开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"朱弁","text":"平生所爱曾莫倦，天遣花王慰吾愿。\n姚黄三月开洛阳，曾观一尺春风面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"朱弁","text":"万顷玻璃一叶船，冲芦曳藻入苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"延平江上呈吴国华先生","author":"陈渊","text":"青山如伟人，可望不可制。\n屹然瞰碧流，龙翔虎豹视。\n春风何时来，草木舞深翠。\n禽鸟暖相依，飞鸣得真意。\n谁言静无作，坐致无边利。\n愿言斩茅茨，结室傍荟蔚。\n且要观此身，功业亦细事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山驿见周东老题诗和之","author":"陈渊","text":"尘劳千种祇纷纷，之子归来始一春。\n掉舌不知何处去，又还携剑出南闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立我轩","author":"陈渊","text":"是身犹逆旅，真吾所寄耳。\n若人问真吾，本空何可拟。\n立我物必随，我应为物使。\n捐物更求我，是以物为已。\n文章镜面尘，富贵路傍屣。\n胡为认而有，展转迷不已。\n此迷自何得，定以有我起。\n达人齐万变，视彼犹视此。\n隤然天地间，形稿心如水。\n独有长存者，万劫不能死。\n夷齐与盗蹠，趣操定谁美。\n是非傥难分，物我那相訾。\n君怀经济心，题榜故云尔。\n我乏异俗才，诗言亦其理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人独酌二绝 其一","author":"陈渊","text":"共矜春色尽衔杯，文字红裙各有侪。\n何似西园闲处士，一杯花下畏人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人独酌二绝 其二","author":"陈渊","text":"休论身外千端事，且醉花前一榻风。\n举盏但能邀皓月，隔篱何必唤邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邻有张生者病革势不可救忽梦医人邓舜臣言万病圆如说服之遂安感而作诗","author":"陈渊","text":"医王脱超如蜕蝉，幻身变灭成飞烟。\n百年薪尽火犹传，直驱神马穷青天。\n自从和扁不少延，冀北万疋今萧然。\n挟方储药人摩肩，闲花野卉纷争妍。\n昨梦宵蝶正蹁跹，忽忽神遇高人前。\n旧交量见意终圆，相顾眼笑如忘年。\n因言疠疫兴哀怜，语我妙药醒沉绵。\n唯有岐婆世所贤，此物病极犹能痊。\n觉来揽衣视星躔，明月堕落遥山巅。\n挑灯草简便求旃，十粒入手收淮蠙。\n平明攻疾才下咽，顿活始信真天全。\n先生爱习不忍捐，尚念故国多凡缘。\n祇应造物相留连，闵此众万劫火煎。\n故令丹成犹未仙，妙畀神力司阴权。\n世间愚术谋相先，不计性命徒论钱。\n谁能如公心不偏，此诗义直何当宣。\n付与末俗惩轻悁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇安分水岭","author":"陈渊","text":"已见江南草木菲，笋舆愁下乱山围。\n但将双泪凭西注，寄语江神稳送归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"离紫溪驿","author":"陈渊","text":"小风吹面雨廉纤，轻薄衣裳懒更添。\n一线离情裁不断，暮云将过粤山尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山","author":"陈渊","text":"欲留无计去还悲，渐远闽山物象非。\n家在天南今北首，忍看归鸟背人飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信州禅月院晚眺","author":"陈渊","text":"一觉华胥日又曛，晚来愁绪乱纷纷。\n角声对起重城近，吹动灵山万叠云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中初晴","author":"陈渊","text":"碧玉空江漾晓晖，水光浮簟影交飞。\n酒昏头重慵扶起，卧看蛟龙上客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登睦州环峰亭","author":"陈渊","text":"月照空山杜宇啼，唤归渔艇夜天低。\n那堪又是双溪水，独上危楼十二梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊姑苏凭汇亭候同行不至","author":"陈渊","text":"扁舟系岸五六日，草屦绕亭千百回。\n欲行无计住不可，梦想万事心如摧。\n燕雀飞鸣意自适，翩翩檐外相往来。\n乃知荆棘殊不恶，培风万里真劳哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李仲虎召伯相遇","author":"陈渊","text":"区区千里为浮名，小隐终惭郑子真。\n双阙几时瞻北极，万山无处望南闽。\n尊前壮士今如梦，胯下真王迹已尘。\n共俯淮流追往事，玉蟾依旧水粼粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月二十二日秋举失利出门用中相饯夜步河上留别","author":"陈渊","text":"太平今日古无邻，触目郊原事事新。\n年少自应迷鼓吹，野人终是厌埃尘。\n忘怀处世思同俗，有事关心不为身。\n药石有能医久痼，此生宁复怨垂纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱塘过廖次山以诗见赠次韵","author":"陈渊","text":"往来江海两年馀，自怪乡音已变吴。\n樽酒每思难会面，客乡何意复趋隅。\n雨寒君未瞻天竺，水涸吾妨适镜湖。\n幸此徘徊缓分袂，笑谈犹得对冰壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵欲游西湖阻雨","author":"陈渊","text":"去年赏西湖，薄暑扳跻难。\n同游幸胜士，酒沃衣巾斑。\n今岁来钱塘，腊雨扁舟寒。\n友朋适四集，局蹙樊笼间。\n此生分林泉，造物犹余悭。\n未为登岳祷，且作访戴还。\n无私本天理，敢怨阴云顽。\n向来旱蝗恶，征赋亦未宽。\n宁令风作雪，要看麦堆山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧山觉苑寺雪后杜门","author":"陈渊","text":"雪融檐溜如秋霖，古寺掩关无足音。\n诗书废放道眼净，钟鼓杳隔禅房深。\n老僧劝坐媒以火，茶鼎静听苍蝇吟。\n胸中激梗造澄澈，一念不作千忧沉。\n浮生半日未易得，邂逅胜境聊安心。\n明日孤帆落何许，岁晚浊醪谁共斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱清待潮","author":"陈渊","text":"江潮来去自有时，扁舟阁浅心如飞。\n岸容霜竹青照眼，春信雪梅香扑衣。\n天寒鄞江道路阻，岁晏钱清风俗非。\n故园回首二千里，落日看尽行云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱清过堰","author":"陈渊","text":"小风吹树寒流止，始觉西江潮正起。\n须臾倒卷縠纹来，已没岸痕犹未已。\n江流自下河自高，逆上更堪行罔水。\n九牛回首竹索细，十丈沙泥拒舟底。\n舟师绝叫鼙鼓喧，观者骈肩汗如洗。\n未经破碎亦偶然，得造涟漪真幸尔。\n世间何事非人力，计久终须倚天理。\n他年我欲治河源，要使黄流贯清泚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萧山雪中寄季修","author":"陈渊","text":"南雪一尺馀，兹事岂常有。\n直恐春气融，不忍加以帚。\n我友隔十里，无人共觞酒。\n披衣坐短篷，吟苦千呵手。\n疾风穿帘幕，阴雾低窗牖。\n思君欲乘兴，奈此衣见肘。\n吾生为已疏，未即学耕耦。\n要令天下肥，自以一身后。\n三登今告祥，此意亦云偶。\n端能歌丰年，击壤和田叟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过鉴湖","author":"陈渊","text":"稽山霸业已芜没，贺老鉴湖今几时。\n当年乞得亦清绝，不道后日知谁尸。\n人生底物乃吾有，谬辱君赐宁非痴。\n游人依旧逐胜赏，歌舞自昔皆尘泥。\n荷枯苇折洲渚出，深处不变清琉璃。\n汪汪万顷挠不浊，坐令我忆牛医儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季修欲之仰山预作诗送之","author":"陈渊","text":"飘零今日海东偏，见子奔驰不自怜。\n洛社求师霜入屦，仰山寻隐草连天。\n白云南望家虽近，璧水东来计已然。\n赖有从前息心地，不令尘土化流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病减枕上五首 其一","author":"陈渊","text":"阶草无期日自生，独馀贫病破元正。\n春风一种生生意，谁道年来也世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病减枕上五首 其二","author":"陈渊","text":"飘零古寺倚江边，高卧春风百病缠。\n造化小儿真戏我，不令歌酒趁新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病减枕上五首 其三","author":"陈渊","text":"多情春梦草生池，起欲寻芳力尚疲。\n未解维摩无一语，故应习气欲题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病减枕上五首 其四","author":"陈渊","text":"尘埃子石蒙蛛网，残落霜毫暗藓纹。\n未把语言为戏剧，新年不作送穷文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病减枕上五首 其五","author":"陈渊","text":"三釜承亲计已疏，万钟行道竟何如。\n安贫未赴阇黎饭，信命宁裁宰相书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季脩有诗求公晦颜公书元次山碑铭既而公晦和成使病者亦赋之","author":"陈渊","text":"英雄仙去形骸薧，空有遗铭卧荒草。\n谁将后事付平原，石刻长随天不老。\n古来笔法多神逸，断碣尘埃谁复扫。\n顾无清议蔼人间，末技纵工何足道。\n往年好古搜奇迹，百过曾看争坐稿。\n直词无复假军容，僣逆知公能辩早。\n教儿祇欲传家法，挥金可笑欧阳媪。\n岂知名义重丘山，遗屦终令鲁人宝。\n此碑文墨两奇伟，千载漫郎犹有考。\n当时谈笑傲豺狼，首领不求明哲保。\n至今心画落银钩，逸若骅骝初脱皂。\n先生年来好收书，兼爱此翁忠有馀。\n岂惟笔力求深造，定要声名不减渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"季脩舍舟趋诸暨谒刘元成独泛钱清江有怀其人","author":"陈渊","text":"人远牛羊暮，春深草树滋。\n野桥低映水，溪岸曲萦篱。\n风雨江湖思，乾坤杖屦疑。\n论心竟谁是，短棹欲何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻许景受上书被召二首 其一","author":"陈渊","text":"九万须凭负翼风，男儿端不为贫穷。\n当时三顾应虚出，毕竟论功要有终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻许景受上书被召二首 其二","author":"陈渊","text":"男儿出处欲如神，莫谩将身过许人。\n今日万人看中鹄，挟弓持矢且逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻公晦叔往廉州以诗送之","author":"陈渊","text":"宗之潇洒玉为颜，叔夜粗疏万事宽。\n天与海边尝瘴疠，意令他日惯艰难。\n功名自古谁能必，忠孝于今众所观。\n志士杀身当不顾，小人怀土但求安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观猎","author":"陈渊","text":"苍鹰黄犬五花骢，木落风高箭上弓。\n三穴若能搜狡兔，九天方可下冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登奔牛堰山亭","author":"陈渊","text":"桑阴浓处已深春，小市喧呼迥不闻。\n谁与山头共游戏，静看禽鸟斗纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒满处冲归以诗赠之","author":"陈渊","text":"八年重见各蹉跎，把酒论文奈别何。\n行止未应经扫地，是非安用辩倾河。\n阳春属和从来少，流水知音不必多。\n妙语惊人慵举似，归来如学病维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲见和复次韵二首 其一","author":"陈渊","text":"高谈无补自风波，毕竟平生意若何。\n万里误游梁苑囿，三年悔寄楚山河。\n轩裳气味情终可，林壑风流兴已多。\n赖有故人真远器，会看鹏翼九天摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲见和复次韵二首 其二","author":"陈渊","text":"岁月空惊去若波，樗材浑欲树无何。\n人情不似春生草，末学方矜水灌河。\n顾我嵚崎徒意广，如君飘逸患才多。\n周南纵复嗟留滞，未便悬头学揣摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲又和颇及佛理亦次韵答之","author":"陈渊","text":"相逢虽许借馀波，此理而今更问何。\n便合形骸同槁木，不须文墨骋悬河。\n五千遗教元非实，三万藏书亦太多。\n此外别传应有路，顿根无物可渐摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲为栖神导气之术每晓起得意成诗前后四首次其韵 其一","author":"陈渊","text":"功名亦误人，自古谁能了。\n老大欲退藏，少壮知几少。\n彤墀班已齐，宿鸟尚木杪。\n岂无山林心，路长天杳杳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲为栖神导气之术每晓起得意成诗前后四首次其韵 其二","author":"陈渊","text":"少时自树立，劲气干云霄。\n一枕梦初觉，万古心何寥。\n年来畏祸机，自悟空峣峣。\n小穷不必送，真隐谁能招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲为栖神导气之术每晓起得意成诗前后四首次其韵 其三","author":"陈渊","text":"交斗存龙虎，经申学熊鸟。\n婴儿检奔放，姹女栖窈窕。\n神仙岂无术，自为志已湫。\n晨兴一炷香，吾意穷三藐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"处冲为栖神导气之术每晓起得意成诗前后四首次其韵 其四","author":"陈渊","text":"朝气爽不昏，清净天无霞。\n善恶两相融，世虑遗尘沙。\n疏钟下残月，馀响递幽遐。\n了失去来心，淤泥出荷茄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕","author":"陈渊","text":"衰榆弱柳未经霜，已见飘零片片黄。\n雨后晚风生户牖，莫将灯火汗清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕三首 其一","author":"陈渊","text":"北里南邻锦绣陈，万端千叠日初晴。\n收藏犊鼻何须挂，不与人间斗独清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕三首 其二","author":"陈渊","text":"天上银蟾曲似钩，人间箫鼓万家浮。\n从来世事俱儿戏，不独秦娥乞巧楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕三首 其三","author":"陈渊","text":"信马随车力不胜，聊将觞豆乐交朋。\n青楼乞巧真儿女，我亦如今拙未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕闺意戏范济美三首 其一","author":"陈渊","text":"衡阳新雁几时归，惆怅佳人万事非。\n蓬首西风还拜月，夜凉赢得露沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕闺意戏范济美三首 其二","author":"陈渊","text":"经年不复到庭除，又见秋风柳欲疏。\n看罢巧楼归小阁，床头重捡近来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕闺意戏范济美三首 其三","author":"陈渊","text":"祝君樽酒醉罗裳，此夜应须石作肠。\n幸自书生恶滋味，那堪千里羡牛郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵范济美秋雨感怀","author":"陈渊","text":"一别剑溪水，三换京尘秋。\n夜听空阶雨，岁月惊如流。\n岂不念故国，水清山亦幽。\n蝼蚁有微情，未忍追浮丘。\n平生老苍交，夫子贤其尤。\n穷经三十年，一字不见收。\n赖有管城公，落纸无全牛。\n他时恐不免，速达吾所羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]