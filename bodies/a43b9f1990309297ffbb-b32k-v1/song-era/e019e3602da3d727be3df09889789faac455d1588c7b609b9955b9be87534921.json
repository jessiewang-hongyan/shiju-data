[{"title":"挽宜人李氏 其二","author":"曾丰","text":"僧戒阿谁受，法仪何处迎。\n两回经梦境，三叹悟人生。\n食已难为强，衣犹不惮更。\n得非禅力重，去住自由情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宜人李氏 其一","author":"曾丰","text":"养成中馈德，留与后人言。\n翰墨其馀事，诗书盖上根。\n不徒为大母，犹复见曾孙。\n萧瑟堂前意，青葱雨后萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽饶伯馀室氏曾夫人 其二","author":"曾丰","text":"始托得其地，中伤乖所天。\n心犹持七戒，教不废三迁。\n大本中孚卦，繁文内则篇。\n区区彤史笔，未足远其传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽饶伯馀室氏曾夫人 其一","author":"曾丰","text":"归相起家翁，缫纫奋妇庸。\n初心光四教，末愿满三从。\n已已溪毛荐，行行马鬣封。\n断机迟后效，黄纸贲青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽孺人雷氏","author":"曾丰","text":"箕帚当人室，缫纫起我家。\n所羞轑釜尔，其惮下机邪。\n剪髻户盈屦，断丝书满车。\n天何夺之速，不待服褕霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行","author":"曾丰","text":"已离南康县，不知何处村。\n荒郊霜洒道，野店犬应门。\n市尾人声闹，津头水气昏。\n云开双髻出，髣髴月梳痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涂汉英学诗二十馀年矣挟近作来示赏叹之次俾更印可诸公间","author":"曾丰","text":"三厄五穷能养诗，养之成熟气混夷。\n不知胸次是三代，可与笔端为四时。\n收拾性情归大朴，发挥风月出多仪。\n勘符容有一未合，更把大通相转移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涉夏归途","author":"曾丰","text":"一意贪归百事忘，其如耳目触吾旁。\n女桑醉日多相靡，孙竹骄风半自强。\n蝼蝈无稽言语泛，蜻蜓罔念性情狂。\n鸤鸠占尽世间拙，未害云为蹈大方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"真阳峡","author":"曾丰","text":"嶂合含元气，岩呀吐太阴。\n崖根连地入，石笋与天侵。\n尧舜成陈迹，英韶寄古音。\n黄巢徒堰水，遗臭到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秩升得朝散告归","author":"曾丰","text":"名似龙肝尔，实如鸡肋然。\n言之为下汗，爱者至垂涎。\n儿辈喜忘寐，臧徒舞欲颠。\n未深知我意，再拜贺于前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"致敬五公祠堂","author":"曾丰","text":"五公稷契益皋夔，朝迹才安辄复危。\n始信君非雠格处，皆缘国是有摇时。\n高山日矫行人首，乔木时颦故老眉。\n莫道落南非美事，也多添得永州碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读六一先生碑亭记","author":"曾丰","text":"六一先生自不磨，太丘兴卜植僵多。\n牛羊莫犯墓茔者，风雨其如阡表何。\n器识谁能三世合，规摹可复百年过。\n丰碑幸出老彭手，读罢宁容不一哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"都下卧中","author":"曾丰","text":"屋密风传冷，窗虚月漏明。\n九衢朝马动，四壁候虫鸣。\n街吏高呵道，衙官急杀更。\n人行吾尚卧，自分利名轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高德成访予义宁留久之告归赋两长韵 其二","author":"曾丰","text":"足轻横桂易潇湘，背负唐瓢李贺臧。\n何者江山非痛快，孰云杖屦是乾忙。\n马迁南历靡遗记，陆贾北归元俭装。\n徒折梅花寄消息，家人眉岂不空黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"假守晋康出郊劝农 其二","author":"曾丰","text":"小队近郊初省春，杯盘绵蕝意殷勤。\n叮咛通国老和少，黾勉及时耕且耘。\n卖剑尔行移尔俗，买山吾退了吾文。\n试于农圃相寻认，果是康州旧使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"假守晋康出郊劝农 其一","author":"曾丰","text":"笑下篮舆上画船，百千诗具已遮前。\n川通诸海滔滔是，鱼跃于渊圉圉然。\n云出山头犹阁雨，风行水面不停烟。\n囊中随意乱收拾，容了劝农归细编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿上望之桂楼","author":"曾丰","text":"重屋峥嵘据道周，浪行良劝小淹留。\n星无匿彩天澄夜，云不遗瑕月粲秋。\n金气方张犹重杀，物华已结未多收。\n老来姑置行藏事，它日其怀独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿南海神祠东廊候月烹茶次闻雷","author":"曾丰","text":"祠宇眈眈海岸头，况逢冷夜更清秋。\n风前尘外笛三弄，饭后月中茶一瓯。\n借我孤舟随水住，乘时一棹与天浮。\n旧谈八月流槎事，岂料予来傍女牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄广东提干田子真","author":"曾丰","text":"初悔投身落海涯，拥车犹幸袭踪来。\n畏途机械鹿貙虎，晏岁风霜松竹梅。\n分首二年眉惯郁，举头千里眼佣开。\n江山不隔往还梦，一梦醒时闷一回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄孙学长孝思","author":"曾丰","text":"短檠方册不增穷，穷到无锥文字工。\n与我心同如印印，使人意快似风风。\n江山信笔机之熟，天地忘怀气所充。\n耆旧录中书隐德，其他无以易庞公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄临汀推官卢伯寿 其二","author":"曾丰","text":"都下灯前别酒阑，我归江国子闽关。\n鲤鱼不赐书来去，蝴蝶犹将梦往还。\n抵掌伊吾灰壮志，折腰彭泽汗衰颜。\n十年以后来相问，收拾俸馀归买山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄临汀推官卢伯寿 其一","author":"曾丰","text":"解官赴调出临川，倒指侵寻十二年。\n文学背时招白眼，功名迂路得华颠。\n胸中要与天相似，分内姑安理自然。\n素业更须频点检，有无可以上青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄殿院谢艮斋 其四","author":"曾丰","text":"河鼓聘天孙，昭君未出村。\n非关媒不善，自是命难婚。\n无貌倾人国，何颜倚市门。\n随缘幽阁里，刺绣度朝昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄殿院谢艮斋 其三","author":"曾丰","text":"汩汩孤蓬转，迢迢五岭来。\n故人饶鹤发，新论凛乌台。\n千里夜间月，一枝春首梅。\n使行无好寄，书到莫慵回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄殿院谢艮斋 其二","author":"曾丰","text":"稳著云霄步，高峨獬豸冠。\n简霜凝处冷，奸胆落边寒。\n奋臂有馀勇，撄鳞不苦难。\n平生功业意，莫到晚年阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄殿院谢艮斋 其一","author":"曾丰","text":"元祐乌台士，江西董白须。\n节因父母立，名与道乡俱。\n耆旧流风远，衣冠后辈孤。\n此公今复奋，吾道得相扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄衡阳尉徐智伯 其三","author":"曾丰","text":"衡阳容有雁，岭表得无梅。\n半岁人南北，中宵梦往来。\n灯为输喜使，酒作嫁愁媒。\n莫决敲门句，几经改作推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄衡阳尉徐智伯 其二","author":"曾丰","text":"刺眼县门柳，萦心家圃梅。\n懒为彭泽住，羞见督邮来。\n藉有汤行聘，要无石作媒。\n吾非痴谢令，自去不须推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄衡阳尉徐智伯 其一","author":"曾丰","text":"千古南昌尉，神仙人姓梅。\n久归天上去，重谪世间来。\n照乘无人市，倾城不自媒。\n稳乘高士毂，自有郑庄推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇安叶簿之先大夫易学得于天而未传于人余窃于执事闻焉幸矣敢以相期之意并赋长句呈似","author":"曾丰","text":"梦与神游会自然，乃翁于易发先天。\n东周以上更三圣，南渡而来第一传。\n入室饱参谁舍瑟，过庭精意自忘筌。\n勾稽小诎论思具，行侍玉皇香案前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常山道中","author":"曾丰","text":"闽广江湖人造朝，水行陆出路迢迢。\n谁知鸥鹭为高尚，我与江山是久要。\n多诈青云犹见诱，少恩白发不相饶。\n往哉粗办老焉计，三径一丘归自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得广州俸米供给麻券授家人","author":"曾丰","text":"陶潜营五斗，王绩办三升。\n醉饱曾无几，驱驰已不胜。\n犹须糊汝口，未果枕吾肱。\n有可供饥渴，休官岂不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春告游人","author":"曾丰","text":"春初弄色取知音，旁午尊前献孔壬。\n紫守不坚红更怯，风来无度雨仍侵。\n莺狂犹妄起羞口，蝶老未知求放心。\n解道不如归去语，得非知礼识机禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春客路","author":"曾丰","text":"流水绿相沸，落花红自纷。\n乾坤容盎盎，草木意芸芸。\n布谷声通俗，提壶语带文。\n杜鹃相告处，益有激而云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晨霜客路","author":"曾丰","text":"卧骇窗纱已报明，篮舆札札破霜行。\n踏开冻淖琼浆溜，摇动凝梢玉屑倾。\n山色喜人犹念旧，鸟声冤客不留情。\n从今得檄莫嫌出，后集诗犹编未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望始兴","author":"曾丰","text":"指似始兴县，西南天一隅。\n荆管今郁积，山水故盘纡。\n在昔多名士，同时九大夫。\n更添张相国，画作十贤图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其三","author":"曾丰","text":"受命于天已背时，形模骨相岁寒姿。\n馨香事业清风觉，枯淡生涯皓月知。\n檐下横窗谁领略，溪边照水自娱嬉。\n岭南驿使虽相爱，送入京华岂所宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其二","author":"曾丰","text":"万物无先我得春，谁言骨立相之屯。\n御风栩栩臞仙骨，立雪亭亭苦佛身。\n不放乔松为独行，犹容修竹作同人。\n彼矜香色自孤者，不道未离香色尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅 其一","author":"曾丰","text":"太清储气置南荒，非我閒生谁足当。\n瘦可以风饶道骨，白难为月饱神光。\n宁教大庾有山色，莫管长安无国香。\n驿使借令不相外，孤芬未必合群芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅月客庙山厌润思霁","author":"曾丰","text":"云漫山若没，海涨地如沉。\n人已苦卑湿，天犹容众阴。\n非关河伯滥，自是雨师淫。\n上有太阳在，何当一照临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欲入脩门未果且留妙山逆旅书所见呈富阳大夫陈晃国","author":"曾丰","text":"诗肩重与毂尘摩，旁县孤村邀我过。\n晏昼江山开调远，晴宵星月照临多。\n眼为幻使不由我，心与空俱无复它。\n百里一轮大圆镜，发奁开幭鉴如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"深冬积暖乍寒","author":"曾丰","text":"冬令将终尚未霜，伏阴犹强逊愆阳。\n连旬逗暖日骄放，半夜邀寒风怒张。\n虫不开关平引退，木无背本隐归藏。\n道消固自有时长，世事那由得汝忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"淳熙丙午与閤皂化士彭正夫道人五羊相别开禧乙丑复会于五羊赠二长韵 其二","author":"曾丰","text":"抗尘骑气两虚舟，久别重逢幸小留。\n自分末留轻著脚，相期初度急回头。\n我尝黄奶真无味，若种丹田乃有秋。\n所向殊途所归一，他游无以易天游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"章贡解舟雨作江涨","author":"曾丰","text":"风伯始恶发，雷师随怒张。\n雨从来处黑，江到涨时黄。\n稳稳过皇恐，徐徐下豫章。\n不逢天借力，安敢夜乘航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续赴罗少卿饭坐上点和前韵","author":"曾丰","text":"孤吟成锢疾，旅坐失牢愁。\n昼气溟银海，春风沸玉舟。\n诙谐狂后出，汗漫醉中游。\n已忘行藏事，从渠自倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续演雅","author":"曾丰","text":"临川战战渴饮水，行道迟迟饱食牛。\n促织贪为先具计，提壶欠作豫防谋。\n知风鹊备全无患，报雨鸠言半不酬。\n惟有海鸥忘物我，何思何虑任沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续演雅","author":"曾丰","text":"徐行俟命退风鹢，决起乘时迁木莺。\n秋隼巧为非义取，夜蛩工作不平鸣。\n行归寡悔蚁知雨，言至数穷鸠唤晴。\n惟有冥鸿自高上，兹其不可得而名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒扶胥南海庙","author":"曾丰","text":"南海大都会，扶胥拱圣王。\n卜灵终自显，两庙屹相望。\n香火夤缘在，河沙劫数长。\n昌黎韩子记，相与作存亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"逸圃","author":"曾丰","text":"莫空劳晚景，宁小负清时。\n天下复何事，汉阴殊不知。\n桔槔时俯仰，畬插几盈亏。\n吾策未为得，渠言得策谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴贡院呈彭国寿","author":"曾丰","text":"名士江西少，广文胸次高。\n欠人扶此道，得子慰吾曹。\n学问揉圭角，功名添二毛。\n宜春文艺传，它日蜀王褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴贡院彭国寿以诗见示次韵奉酬","author":"曾丰","text":"共阅文场幸小休，燕斋还我旧天游。\n青灯影里消除夜，黄菊杯中渐送秋。\n此念在家身在客，吾行非去坐非留。\n诸公往往离怀恶，曾悟乘流过坎不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄侍郎元章题处士何熙绩所居曰肥遁熙绩又结生墓而铭之予题其墓曰大归遗之诗焉","author":"曾丰","text":"圭荜逸民宅，羊鹑处士衣。\n人才于古有，天命与时违。\n初不厌肥遁，终何辞大归。\n初终两题目，君自一其机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厨鸡窜房中张元辅怜而赋诗余不能自已亦为一篇","author":"曾丰","text":"惊栖潜避影，啄怯暗吞声。\n似惜千金命，而逃五鼎烹。\n肋枯那便齿，皮瘠不宜羹。\n肉食非吾事，从今戒杀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳陈大夫遣二吏抄俚文用写道寓于文之意还以请益","author":"曾丰","text":"道固无方实以书，要于书悟道之虚。\n雷风水火易经始，草木鱼虫诗绪馀。\n万理所归为宝藏，一真之外是蘧庐。\n俚编道欲相磋切，不道亡筌自得鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"散步后园","author":"曾丰","text":"簿书不放出公门，饭罢舂容步后园。\n燕子方归犹认主，竹君未老已生孙。\n姚王泣雨泪含怨，望帝啼风声带冤。\n新旧两重公案在，一依诗律与平反。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬简堂观莲","author":"曾丰","text":"冰壶涌出水仙妆，镜里风生净土香。\n白表质成花受彩，黄钟理具蕊含章。\n翩翩仰面枝分盖，??斋头子共房。\n见说濂溪爱之酷，色尘于我自相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑夜露坐","author":"曾丰","text":"出坐日初曛，归眠夜欲分。\n竹浓犹漏月，风横不容云。\n雾露气相薄，星辰天自文。\n更深群动息，地籁可相闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡海后自北流县过鬼门关","author":"曾丰","text":"抽身龙伯国，著脚鬼门关。\n每每经从处，皇皇崄阻閒。\n不支生所忽，有立出于艰。\n顺境成人少，天初不是悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡海谒两伏波将军祠","author":"曾丰","text":"长安百二汉山河，更遣南征两伏波。\n自计有何饶社稷，相寻无已枉干戈。\n一时夸大心难制，千载英雄迹未磨。\n逐客乞灵几前辈，丰碑费我小摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游乌石寺","author":"曾丰","text":"缥缈崖悬屋，峥嵘柍亘天。\n我疑家玉帝，谁道宅金仙。\n钟鼓风雷上，星辰灯火前。\n眼高胸次大，沙界眇三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游齐觉寺 其二","author":"曾丰","text":"不谓僧游息，犹容俗往还。\n薰炉烟缕缕，茗椀雨班班。\n剟坐移门外，携樽置竹间。\n小诗题岁月，多助得江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游齐觉寺 其一","author":"曾丰","text":"筑寺依横峤，开门对远汀。\n闻之心已渴，见者眼皆醒。\n水泻鸭头绿，山排螺髻青。\n他无避地处，得此可忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游南山","author":"曾丰","text":"氤氲犹积气，肤寸忽层阴。\n甘雨新来足，青山旧隐深。\n随缘酬万物，闻早遂初心。\n彭泽曹溪意，亭前无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游春集未成再赋呈赵司法","author":"曾丰","text":"我来已作一年痴，敢问诸公几许时。\n客里酒杯初到口，风前花片半辞枝。\n尚馀魏紫姚黄在，安用桃红李白为。\n公事相寻无了日，得闲莫更负春期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游淡岩 其二","author":"曾丰","text":"谽谺万状眼中奇，四顾三叹天下稀。\n秦帝诏方宣美意，徵君心已悟危机。\n追随谈姓俱韬晦，邂逅涪翁并发挥。\n却羡桃源人更会，和名和姓袭鸿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游淡岩 其一","author":"曾丰","text":"混沌谁将窍凿穿，巨灵留巧与人传。\n坎中著脚疑无地，缺处回头却有天。\n穴虎将风时出啸，渊龙挟雨夜归眠。\n瑶台琼室人难住，佛未来时必是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]