[{"title":"和项平父送别 其三","author":"孙应时","text":"前途事业自登山，高下相悬进一关。\n莫倚陂陀能迤逦，可无尺寸怯跻攀。\n我来正作三年计，君别何当万里还。\n办取相逢须刮目，转头清镜欲苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和项平父送别 其二","author":"孙应时","text":"长江风景旧闻知，雪里经行亦大奇。\n官舍荒凉乏松竹，边城清晏少文移。\n有时怀古登临久，自省无才职分卑。\n白日闭门还独笑，读书吾亦太营私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和真长送别","author":"孙应时","text":"吴市当年梅子真，不堪万里久辞亲。\n故无分寸酬知己，尚有平生不负人。\n锦里风光馀别恨，镜湖云水送閒身。\n感君恋恋勤相记，岁暮长途知苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景孟山行","author":"孙应时","text":"翛然身在妙高峰，下有雷霆走白龙。\n已觉仙风换肌骨，更无尘土到心胸。\n悠悠今古三千劫，莽莽山川几万重。\n云北云南一长啸，为留馀响振岩松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和景孟宿山中","author":"孙应时","text":"倦行白雨翠云中，投宿禅房听晓钟。\n弹压山川诗未老，留连岩壑兴何浓。\n回看尘世频三叹，上彻天关更几重。\n径欲乘风此仙去，时时笙鹤下前峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾舜卿","author":"孙应时","text":"晚风吹散雨垂垂，一榻萧然枕独攲。\n秋燕悄如当去客，夜虫还是可怜时。\n我怀松菊归难早，君趁莼鲈喜可知。\n已叹曲高如白雪，更烦墨妙写乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答叶无咎","author":"孙应时","text":"百年一梦欲谁何，底事容心强揣摩。\n便续渊明归去引，不题工部醉时歌。\n故山已恐鹤相怨，陋巷何妨雀可罗。\n多谢诗仙唤愁醒，簿书丛里少婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答吴斗南见寄解其自疑之意","author":"孙应时","text":"白狗黄牛系缆时，东归应念我西悲。\n置之偶尔何须道，去矣飘然故一奇。\n末路人情随手别，丈夫心事有天知。\n君看子濯平生友，可把逢蒙待庾斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答吴斗南赏木芙蓉见怀","author":"孙应时","text":"曾向荆州一笑同，淋漓江汉酒千钟。\n夹城云盖迎珠履，满眼霜花照玉容。\n万里壮游前日事，十年此会几时重。\n忆君席上多新作，醉笔如飞纸不供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答吴尉俞灏商卿见赠因用韵送行","author":"孙应时","text":"去去瀛洲蜕骨仙，旧游还似九江传。\n尘埃下视三千界，文字勤追二百年。\n宦达有时聊尔耳，才难自古不其然。\n临分更吐平生话，有底閒愁到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答张衡仲 其二","author":"孙应时","text":"我方开竹径，公肯屈篮舆。\n别去梦犹见，诗来锦不如。\n乾坤愁思里，风月醉眠馀。\n会卜溪桥畔，邻墙小结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答张衡仲 其一","author":"孙应时","text":"志略周公瑾，才名陆敬舆。\n可怜空老大，不敢问何如。\n松菊閒吟外，风波噩梦馀。\n诸公自台省，吾复爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答陈传朋 其一","author":"孙应时","text":"羁愁阅寒暑，归梦耿晨昏。\n本意营三釜，何如老一村。\n齿牙从世议，顶踵尚君恩。\n多谢知心友，相过得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答陈传朋 其二","author":"孙应时","text":"别来如一日，话著又三冬。\n信断悲鳞羽，情亲忆駏蛩。\n非君诗律妙，奈我客愁浓。\n叹息青云器，谁能识仲容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答胡用之","author":"孙应时","text":"浪喜功名少壮时，发今种种更奚为。\n穷通信我心如铁，谤誉从渠口胜碑。\n息驾便应追靖节，弄弦宁复待钟期。\n烛湖孤屿烟波上，他日重过细说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答赵生师白见寄 其二","author":"孙应时","text":"田可躬耕溪可渔，此身属我不关渠。\n养生谁学嵇中散，避谤吾非陆敬舆。\n风月满怀高士传，江山到眼故人书。\n相思千里无多恨，珍重清诗玉不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和答赵生师白见寄 其一","author":"孙应时","text":"休论吾昔与吾今，窗下婆娑有学林。\n会意书非求甚解，无弦琴岂要知音。\n是中截断谈天口，何处寻来立雪心。\n永日春风莺百啭，幽人踵息正深深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和甄云卿诗 其一","author":"孙应时","text":"旰食延英责太平，小臣忧国思茫冥。\n千秋鉴在开元录，十渐书留贞观屏。\n莫笑戆愚如汲黯，无宁龌龊似陶青。\n何时再见东都会，万国衣冠拱帝庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和简叔","author":"孙应时","text":"乳燕鸣鸠恼醉眠，起临芳草思芊绵。\n花残柳暗春归日，云薄风轻雨后天。\n酒户已缘愁顿减，诗坛宁复勇争先。\n只因归老渔樵舍，不梦佳人玳瑁筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和简叔游张园","author":"孙应时","text":"赋归堂上忆春山，点笔题诗傍石栏。\n老子如今已陈迹，故人谁与共追欢。\n青灯客舍一杯酒，细雨江城二月寒。\n多谢相过同太息，百年身世梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊","author":"孙应时","text":"病暑迎秋苦恨迟，秋来唤起楚人悲。\n一江风雨无眠夜，万里关山独往时。\n奉檄不知翻远别，倚门应已念归期。\n荻花枫叶添情绪，看得明朝两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妻兄张伯高来访横河感旧与拜先君墓下有作次韵 其二","author":"孙应时","text":"荜门生计只初年，乔岳终难起一拳。\n小槛清风黄卷里，扁舟碧水白鸥前。\n同寻杖屦曾行处，肯谒松楸独泫然。\n人事无穷今几变，空山落日自孤烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昆山龚立道作栖闲堂取李太白题龚处士别墅诗曰龚子栖闲地都无人世喧故以为名尝托范叔刚求诗于予予许之闰八月十九日立道复自以书来为成八句","author":"孙应时","text":"一丘一壑尘埃外，三沐三薰清净身。\n别墅只今唐处士，高风当日汉君宾。\n打门未肯容惊梦，载酒谁能径卜邻。\n千里题诗寄心赏，多惭不是谪仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杭都旅舍腊日感事","author":"孙应时","text":"三年腊日常为客，愁绝梅花独自看。\n万里尘沙走西蜀，九衢风雪卧长安。\n生来可是儒冠误，老去偏知世路难。\n安得长閒伴溪叟，醉歌时掣钓鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山 其一","author":"孙应时","text":"北上武担寺，南临蜀锦园。\n风烟带城郭，禾黍半江村。\n今古本同梦，废兴那复论。\n惟应一坡竹，可共洗心言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山 其二","author":"孙应时","text":"小饮不成醉，清谈多所欣。\n秋声摇落日，野色乱寒云。\n心事长千载，腰围更几分。\n西风丛桂发，倚槛得相闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山感事 其四","author":"孙应时","text":"襟怀能坦坦，色笑更欣欣。\n似道黄叔度，草玄扬子云。\n归舟真已具，别袂不能分。\n岁月愁边雁，飞鸣报客闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山感事 其一","author":"孙应时","text":"归心极江海，秋梦著丘园。\n鸥鹭白蘋渚，牛羊黄叶村。\n古人真已远，世事渺难论。\n想见陶元亮，觞来不得言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山感事 其二","author":"孙应时","text":"客里愁如积，朝来意亦欣。\n鸣阶无宿雨，度隙有归云。\n且免泥盈尺，犹祈岁十分。\n中原念淮浙，不忍话传闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武担山感事 其三","author":"孙应时","text":"身不入莲社，意非同漆园。\n閒来阅风物，归去老山村。\n气味故相许，渊源须细论。\n灯前秋夜永，未可付忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范叔刚以诗送豆粥次韵答之","author":"孙应时","text":"平生画饼复炊沙，空有饥肠不受嗟。\n多谢殷勤饷时节，顿忘憔悴客京华。\n卖书未卜来同往，厚意何时报有加。\n为说痴人不堪饱，更思春酌对檐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客思","author":"孙应时","text":"竟作西江去，其如客思何。\n无情秋色老，不尽楚山多。\n且赋南蛮句，休怀下里歌。\n平生一柱观，明日得经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书事","author":"孙应时","text":"老与春无分，慵于世转疏。\n不陪年少饮，久绝故人书。\n笔研蛛丝底，家山蝶梦馀。\n海棠花正发，风雨定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日自警","author":"孙应时","text":"春风吹尽一川冰，野色山光弄晚晴。\n节物荣枯能几许，人生寒暑正堪惊。\n百围松桧秋毫壮，千丈罗纨尺寸成。\n饱食安眠欲何用，徬徨终夜月华明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭湖","author":"孙应时","text":"明湖纳宇宙，春思满楼台。\n沙鸟一行去，风帆千里来。\n平生眼今饱，落日首重回。\n会趁江山约，还愁白发催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爰亚夫自涪陵以小舟追路相送及予于枥木观下同至万州游岑公洞其归也作七言送之","author":"孙应时","text":"不辞一舸下三州，送我能为信宿留。\n腹有琅玕元自润，气兼熊豹不妨遒。\n清尊近对江云湿，乌帽高寻洞卉秋。\n莫负武夷当日语，几披尺素泪横流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日书怀","author":"孙应时","text":"宦情都漠漠，愁思正悠悠。\n黄叶白蘋渚，清风明月楼。\n归欤想彭泽，老矣欠菟裘。\n行止君休问，吾生不系舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨旬日偶成","author":"孙应时","text":"积雨断行迹，满门秋草深。\n老禾眠水底，野菌出墙阴。\n懒负读书眼，閒多忧国心。\n夜长幽梦短，清耳听虫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨复将害稼 其一","author":"孙应时","text":"颇怪秋频雨，兼疑暑顿凉。\n岁方祈有駜，梦岂误无羊。\n敢与朝廷议，唯观宇宙康。\n由来誇上瑞，不必颂芝房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨复将害稼 其二","author":"孙应时","text":"废圃馀荒径，扶筇独往来。\n未愁风脱叶，生怕雨添苔。\n得与民心乐，何妨笑口开。\n神龙应念我，落日首重回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓","author":"孙应时","text":"高叶明初日，偏林澹远烟。\n晴空如滉漾，秋气更暄妍。\n睡足小窗净，心清浮虑捐。\n与人同乐意，忧国见丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史同叔知池州 其二","author":"孙应时","text":"人地维垣后，功名治郡初。\n细寻循吏传，少辍子云书。\n铃閤閒无奈，江山兴有馀。\n由来形胜地，保障定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送史同叔知池州 其一","author":"孙应时","text":"弄水亭无恙，青溪古画图。\n民风最淳朴，郡计足枝梧。\n汉玺行褒召，潘舆且燕娱。\n平生故人意，未改岁寒无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送司马大亨赴遂昌宰","author":"孙应时","text":"蒲璧邦家重，苍山道路深。\n剸裁知唾手，拊字勉劳心。\n通鉴家传学，迂书坐右箴。\n故人情谊重，赠别比南金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外侄莫幼明还里疗疾","author":"孙应时","text":"爱子天资静，能来读我书。\n积痾无自苦，小别未云疏。\n外物人难必，良师古有馀。\n吴松春万顷，一览意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘苏州诚之帅夔门 其一","author":"孙应时","text":"卧辙违吴会，开帆指蜀门。\n江关自奇险，节制故雄尊。\n一吐遐方气，勤宣圣主恩。\n归来对宣室，献纳伫司存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘苏州诚之帅夔门 其二","author":"孙应时","text":"了了八阵碛，巍巍三峡堂。\n竹枝歌感慨，曲米醉淋浪。\n今古英雄思，风流翰墨场。\n公行秋水落，稳稳上瞿唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别袁公四诗 其一","author":"孙应时","text":"几年静镇绝喧嚣，百吏承风服教条。\n惠养疲羸深保障，搜延英俊盛旌招。\n忧先储粟千仓满，威詟边烽万里消。\n已揭成规在藩屏，政须人望押班朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别袁公四诗 其二","author":"孙应时","text":"露门劝学首群公，石室还来复古风。\n垂世文章崔蔡右，济时勋业管萧中。\n持平愿取乘舟势，纳约先看补衮功。\n力巩皇图知有道，先生心事与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别袁公四诗 其三","author":"孙应时","text":"绝代风流士骏奔，感公封植到孤根。\n云章假宠腾天路，宝画分辉照荜门。\n末学有心期卒业，不材无地可酬恩。\n从今礼数千官隔，知复何时奉一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别袁公四诗 其四","author":"孙应时","text":"南风一夜涨痕吹，江岫排空送衮衣。\n万里直愁知己远，百年长恨此公稀。\n眼看蜀柂沙边起，心逐吴云峡外飞。\n流水高山有殊遇，此生何地不瞻依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别常叔度知县 其二","author":"孙应时","text":"一朝倾盖更倾心，颇畏人惊语太深。\n乍可陶庐烦送酒，难堪偃室傍鸣琴。\n君今此去班群玉，我亦何言托断金。\n啼鴂飞花春又了，萧萧风雨卧山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别常叔度知县 其一","author":"孙应时","text":"一廛谁问野人居，三径重迂长者车。\n不讶经年忘造请，应怜畏影正逃虚。\n举头凫舄双飞去，送目鹏霄万里初。\n青琐黄扉对宫烛，相思肯寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别常叔度知县 其三","author":"孙应时","text":"世缘伤巧亦伤多，万古浮云瞬息过。\n唯有平心供日用，妙于养气发天和。\n细看局度兼诸老，谁道人才各一科。\n卓鲁从来公辅器，攀辕卧辙奈君何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别惟肖赞府","author":"孙应时","text":"如椽老笔健文章，枉对槐间雁鹜行。\n只共低头了官事，忽惊举手劝离觞。\n百年可落尘埃梦，一瓣曾薰知见香。\n珍重平生安乐法，穷通何地不徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别舜卿少府 其一","author":"孙应时","text":"官似南昌隐，人传东野诗。\n才优解牛刃，笔妙画沙锥。\n谈笑千人敌，飞胜万里期。\n大门香一炷，他日看扬眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送别舜卿少府 其二","author":"孙应时","text":"人道琴川上，年来聚德星。\n端能几日月，已复散云萍。\n老我头先白，期君眼最青。\n时能遣佳句，千时慰林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张清叔主簿","author":"孙应时","text":"客路虽萍梗，心交真弟兄。\n悬知有时别，何忍独先行。\n綵服黄花酒，青云白玉京。\n寒蝉正凄切，回首得忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送司马尊古赴平江户掾","author":"孙应时","text":"文献传家旧，功名发轫初。\n荣华劝行色，珍重别吾庐。\n老丑浑无赖，殷勤独未疏。\n西来多雁字，数寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李文授知括苍","author":"孙应时","text":"中兴尚有名臣子，江表能馀正始音。\n拟赞经纶须老手，更分符竹此何心。\n麒麟阁上风云旧，烟雨楼前山水深。\n世事由来偶然耳，公馀端不废清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏赞府梵满秩","author":"孙应时","text":"今日崔斯立，先门苏少公。\n九流清似镜，一坐凛生风。\n倾盖难为别，挥毫记所蒙。\n琳琅谁具荐，早献大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陆华父归越","author":"孙应时","text":"四海桐江陆使君，阿咸诗律更通神。\n时无势力能推毂，独使文章老斲轮。\n万卷诗书堪遗子，千岩风月未全贫。\n青鞋布袜云门路，鸡黍容吾叩主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明守黄子由尚书赴召","author":"孙应时","text":"灯火笙歌别海壖，诏书归觐九重天。\n已将清净安齐国，不使声名减颍川。\n题品人才看赞赞，扶持皇极在平平。\n文星旧与文昌亚，今贯三台更炳然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡婿晋远赴嘉兴酒官 其一","author":"孙应时","text":"逃暑吾无地，将家子在涂。\n随宜简人事，莫久住行都。\n最肯加餐否，刚能却酒无。\n功名殊未晚，爱惜万金躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡婿晋远赴嘉兴酒官 其二","author":"孙应时","text":"名世非科目，传家岂搢绅。\n纷纷一炊梦，鼎鼎百年身。\n看取无穷事，何如不朽人。\n侯翁虽龃龉，此话故情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵仲礼入朝为大理寺簿 其三","author":"孙应时","text":"忠孝吾根柢，功名古绪馀。\n月云无染著，镜象本空虚。\n不必相同异，何妨小阔疏。\n达庵今宦达，味此意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":37500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]