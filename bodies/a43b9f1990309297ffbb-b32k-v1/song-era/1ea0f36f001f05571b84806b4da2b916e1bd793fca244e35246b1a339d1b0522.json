[{"title":"得至郢州寄知郡朝议","author":"彭汝砺","text":"襄阳曾赋赠行诗，邂逅扁舟得所期。\n胜迹好寻梅福宅，真游稍记习家池。\n郢中白雪今谁和，汉上仙槎恰是时。\n冰酒直须多准备，寄声先报主人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄和仲","author":"彭汝砺","text":"日月其除如掷梭，老来衰疾转添多。\n苦心不祇荼毒似，短发无如霜雪何。\n毕竟行藏浑有定，寻常聚散亦非它。\n欲知日暮相思意，牛首山前湖水波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉怀深父学士友兄 其一","author":"彭汝砺","text":"泛泛公舟何所之，江湖不似月相随。\n关西夫子吾所畏，河上丈人今所思。\n蓬发白如相别日，菊花黄似去年时。\n看花欲饮竟无味，不是贫家缺酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉怀深父学士友兄 其二","author":"彭汝砺","text":"看山更饱更无厌，野色虽寒亦不嫌。\n风作浪头高突兀，云埋雨脚细廉纤。\n一双远岸钓鱼艇，三尺近村沽酒帘。\n海上浮舟忆彭蠡，门前栽柳旧陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉和施禽鱼食复赓一章","author":"彭汝砺","text":"南方有国号清凉，人好禽鱼性亦良。\n在藻日分香积饭，衔花时绕净明床。\n濠梁孰谓安知乐，大泽吾能不乱行。\n但得养鱼如养己，相濡仍不似相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上寄广汉屯田丈","author":"彭汝砺","text":"白首扁舟西复东，沧江时对百花丛。\n山光缥缈云霄外，水气溟濛烟霭中。\n似酒鹅儿随暮雨，于飞燕子语春风。\n一杯欲饮终无绪，想望邻家鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和瑛师","author":"彭汝砺","text":"江湖日夜著东流，水上乾坤一点浮。\n隔浦云山随客步，近村花竹慰人愁。\n同舟自有林宗在，结社还须惠远游。\n酒兴正酣归更懒，坐看凉月上沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兵部敏叔颁示佳句谨依原韵","author":"彭汝砺","text":"遍瀰川泽压冈峦，万室清明更可观。\n麦上早春谁漏泄，梅边穷腊自凋残。\n阴阳顺适天时好，高下均平地泽宽。\n岁岁丰登今以始，都人切勿怨祁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次去华学士韵","author":"彭汝砺","text":"九衢尘土暴秋阳，宫殿深沉早自凉。\n庭柏染霜千丈碧，篱花著雨一番黄。\n天边河汉波澜阔，海上蓬莱日月光。\n文物岂惟淹汉魏，太平久矣四三皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时弟","author":"彭汝砺","text":"日夜风前听好音，书来一读一伤心。\n泪摇眼尾催花发，愁结眉头见雪侵。\n秋径自栽彭泽菊，夜堂时奏武城琴。\n事多不废看书否，白首知君惜寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送祖道朝奉","author":"彭汝砺","text":"二月同舟出宋都，转头即是十年馀。\n可怜老大犹为客，莫怪寻常不作书。\n蜡屐阮孚人不会，鲈鱼张翰子何如。\n寄声莫污清风地，留与先生作隐居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吴县丞","author":"彭汝砺","text":"四十青衫似老翁，作官不似作诗工。\n身追鸿鹄云霄外，手缚鲸鲵波浪中。\n俊敏今非无李白，沉深古自有扬雄。\n和声直可奏宗庙，叹息无人知爨桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叶亨仲","author":"彭汝砺","text":"太学声名二十年，词场少以一当千。\n王良仅可使执辔，祖逖岂容争着鞭。\n文字莫愁蒙酱瓿，功名欲看勒燕然。\n故人相见如相问，为说萧条雪满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月七日出城西见河中资政侍郎遇中叔联骑入池南门行东北隅以归各赋一首","author":"彭汝砺","text":"一过西城首一回，经年欲往限尘埃。\n蔷薇露湿春犹在，杨柳烟深晓未开。\n雨后波光浮渤澥，云中山色隐蓬莱。\n与君驰马竞东北，也道曾来池上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和美叔学士","author":"彭汝砺","text":"早日清明气郁葱，翠舆朝出建章宫。\n光回鹭羽云霄外，翠滴荷衣雨露中。\n苦爱平心似崔郾，预愁启事愧山公。\n酬诗自笑才悭涩，不似清微长养风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和彦常侍郎","author":"彭汝砺","text":"濯濯威灵赫赫光，天颜咫尺在岩廊。\n图功未肯兄三古，较艺何嫌弟寸长。\n鼓舞雷风驰汉诏，昭回云汉见尧章。\n酒樽更有论文乐，一笑令人万事忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和彦常侍郎","author":"彭汝砺","text":"天上九重开禁闼，云间千步见修廊。\n仙源水近漂花急，化国人闲爱日长。\n较艺过旬窥锦绣，赋诗终日听韶章。\n时沾好赐终何报，自许馀忠老未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送池须文长官","author":"彭汝砺","text":"龙渊虎穴少穷探，老大生涯一剑镡。\n曲沼鸳鸯多白发，雕笼鹦鹉久青衫。\n能知令尹三无愠，正似嵇康七不堪。\n见说明朝好天色，鹏程从此稳图南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘生适中初业儒稍能文词气勇而不暴甚得乡士人心连蹇不得志以医游四方元祐七年来京师予与乔给事公权丰侍郎相之荐于朝入翰林为医官孙待制传师帅渭辟以从予哀生之志未得而喜其得贤主人以归也作是诗以送之","author":"彭汝砺","text":"短衣瘦马去从军，辛苦知君祇为贫。\n丝绶戏拈五两去，桂华志取一枝春。\n持书关内大丞相，寄语渭滨贤主人。\n种种别时双鬓发，萧条今日总如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋和父赴代州教授","author":"彭汝砺","text":"十年场屋饱声名，落笔从容一坐倾。\n馀泽未能沾万物，绪言聊复启诸生。\n青衫簿领当时态，白首诗书足义荣。\n得失已知君不恤，春风谈笑入边城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰湖 其一","author":"彭汝砺","text":"漫漫平湖十里赊，南州今作画图誇。\n波澜雨过鱼儿出，草木春归荔子花。\n山近冷光摇几席，地平馀润入桑麻。\n使君恩德还如水，长满罗浮十万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰湖 其二","author":"彭汝砺","text":"仙阁玲珑高出云，画桥缥缈净无尘。\n满分江海千年润，平占蓬瀛十里春。\n照浦蠙珠应自复，随舟鸥鸟会相亲。\n使君爱物能如此，闾巷当时合借恂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和深父学士","author":"彭汝砺","text":"故人气分比松筠，凌雨霜风转更新。\n暇日莫辞三斗酒，浮云便是百年身。\n今来古往祇如此，弟唱兄酬莫厌频。\n雪霁拥炉须酩酊，月明分手更逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和侯利建运使朝请","author":"彭汝砺","text":"当年置酒岘山亭，公作新诗我载赓。\n疾病尚怜忧似醉，文章还看美如英。\n伤哉无复老莱戏，久矣不闻韶乐声。\n饥鹄欲飞嗟已老，谬烦江汉借修程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判朝奉宋丈 其一","author":"彭汝砺","text":"尘事如毛日日生，故园久拟问归程。\n飞鹏怒薄扶摇上，病骥饥寻巀嵲行。\n绿野尽头迷汉水，白云深处是樊城。\n私怀借问何其似，祇看摇摇车上旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判朝奉宋丈 其二","author":"彭汝砺","text":"未忍田间老此生，衰迟已觉怯修程。\n频频彼似鸒斯党，踽踽吾非杕杜行。\n云影昼迷芝岭路，水声夜到凤林城。\n仆夫不见人忧思，未晓匆匆已抗旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再呈通判承议 其一","author":"彭汝砺","text":"山边置酒水边行，鱼鸟于人各有情。\n终世果能著几屐，此时聊可濯吾缨。\n启期拍手誇三乐，渔父张颐笑独清。\n四海一舟归未得，低徊长恐负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再呈通判承议 其二","author":"彭汝砺","text":"南头如送北头迎，祇有溪山不世情。\n少日激昂投耒耜，老年辛苦畏簪缨。\n长松根脚龙蛇蛰，老鹤精神玉雪清。\n会得无生浑自足，还容款曲问长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈通判朝奉宋丈 其一","author":"彭汝砺","text":"昨日南阳今淅川，驰驱不敢恨华颠。\n久披褐布是居士，时着斑衣犹少年。\n系屧记寻幽径竹，泛舟忆近碧池莲。\n笑君与我浑相似，目病鳏鳏夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈通判朝奉宋丈 其二","author":"彭汝砺","text":"经时山川浪跋履，半夜衣裳时倒颠。\n尘土最能催白首，风波祇会送流年。\n寂寥彭泽门栽柳，萧洒东林社结莲。\n语及故乡归未得，看云步月欲忘眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持正率和中丞诸公喜雨 其一","author":"彭汝砺","text":"昊天旋日照宸忧，灵雨崇朝遍舜州。\n云起山川初一点，水倾河汉欲交流。\n欢愉散入舆人诵，润泽浑供万物求。\n遥想玉山禾粒熟，来仪还见凤凰秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持正率和中丞诸公喜雨 其二","author":"彭汝砺","text":"盛德无烦百姓忧，分明灵贶厚齐州。\n精神散接诸天远，润泽横随四海流。\n玉色晬温知有喜，渊衷澄寂本无求。\n史官屡得丰年事，还记熙宁第十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄深之学士子开侍郎","author":"彭汝砺","text":"万国承平道更尊，君王取士夙临轩。\n雕虫立废贾马赋，发策跂闻晁董言。\n兰艾同荣春霭霭，鱼龙欲化海浑浑。\n风流想见东华路，夹道传呼看状元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时在集英幕中呈诸公学士","author":"彭汝砺","text":"衰病从来饭亦慵，不堪锁宿似南宫。\n夜凉月满重帘外，春雨花开一梦中。\n轩陛直言尊董氏，朝廷故事问胡公。\n文章久怪无新语，议论初欣有古风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其一","author":"彭汝砺","text":"大府池台能近郭，邻家花木巧当颜。\n丛篁著雨初成径，巨石浮烟恰是山。\n御气即能驰碧落，战文谁敢敌黄间。\n乐天自得三无愠，易地何殊五不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其二","author":"彭汝砺","text":"先生亡子众推贤，号慕今犹似恸颜。\n西竺尝言空是色，南华亦笑泽藏山。\n由来世事无穷处，毕竟人生在几间。\n看著江流长泛泛，可言逝水不知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其三","author":"彭汝砺","text":"日华苒苒在波澜，水色依依照面颜。\n汉上仙槎浮八月，海中金阙隐三山。\n芙蓉开席成阴处，杨柳维舟倒影间。\n景物向人情不浅，频将风月送公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其四","author":"彭汝砺","text":"清香一炷意超然，万事无缘更动颜。\n野鸟衔花来丈室，烟萝招月出遥山。\n居方不碍游方内，住世还如出世间。\n却笑晚年贪著事，野边湖外夜忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其五","author":"彭汝砺","text":"南阳五月饱偷安，报政无闻祇汗颜。\n平日髡钳盈狴犴，丰年盗贼出丘山。\n簿书细碎晨昏事，弦诵寂寥庠序间。\n但见颍川多凤集，仍知合浦有珠还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其六","author":"彭汝砺","text":"岂有微功答谬恩，尚思荣禄慰慈颜。\n心诚似水知宗海，事责如蚊欲负山。\n资性仅同中以下，行能未及二之间。\n木桃每屈言为赠，祇恐琼瑶未足还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其七","author":"彭汝砺","text":"南阳虽好远江干，襄沔归来失病颜。\n雨霁远浮清汉水，云归深见上方山。\n伤心蜀主君臣际，回首庞公父子间。\n薄暮楼头待明月，笛声时见钓舟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其八","author":"彭汝砺","text":"起照青铜已鬓斑，早衰不似旧容颜。\n尘埃苒苒行其野，霜雪纷纷陟彼山。\n稍忆辍耕栖垄上，不堪待罪久行间。\n阳台自笑云无定，华表应疑鹤未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和范学士韵 其九","author":"彭汝砺","text":"风雨先催十月寒，顾瞻言迈祇悲颜。\n二天旧泽流淮水，五色新文照楚山。\n我病欲归虏使重，君行合在侍臣间。\n颍川莫厌次公去，宣室方思贾谊还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘舍人","author":"彭汝砺","text":"剪綵微茫比丝发，雕金焜晃映蝉貂。\n鹓鸾破晓趋丹禁，雨露迎春下九霄。\n花映上尊非索寞，雪侵馀鬓自萧条。\n读书终日不知味，恰似在齐闻舜韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和执中寄师厚同年 其一","author":"彭汝砺","text":"千载风云庆一逢，枯荣相望百年中。\n雪霜松桧材先老，泥土骅骝路未通。\n颜子奚惭一箪食，阮生不是哭途穷。\n春游取次吟花药，枉负灯窗翰墨功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和执中寄师厚同年 其二","author":"彭汝砺","text":"日暮相忘城上亭，云深祇见数峰青。\n傅岩可独为霖雨，荀里还归聚德星。\n汉水溯风增浩荡，兰花着雨长芳馨。\n啸吟久不过诸葛，丰度今谁似九龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招执中看酴醾","author":"彭汝砺","text":"恰是酴醾初盛时，清香终日在尘衣。\n参差正对金沙拆，散漫更为蝴蝶飞。\n日暖绿云长闇淡，春深白雪更霏微。\n急来相就花前醉，看尽此花春欲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄正夫判官","author":"彭汝砺","text":"数竿严濑钓鱼纶，一幅渊明漉酒巾。\n天上旧传公子贵，汉阴今见丈人真。\n登山临水能胥宇，问舍求田待卜邻。\n欲作独清无已甚，时将数字寄埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宗文先辈","author":"彭汝砺","text":"夫子声名二十年，尘埃叹息欲华颠。\n相如旧有凌云赋，靖节今无种秫田。\n南国寂寥归见雁，北风悲壮屡闻蝉。\n思量世事真如幻，合置穷愁顿酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子仲都官徐孺亭","author":"彭汝砺","text":"已矣斯人不可从，风流今见一亭中。\n云藏洲渚秋长碧，日在波澜晚更红。\n旱岁会为岩际雨，贪夫亦畏海濒风。\n于今未见如公比，叹息陈蕃榻亦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颖叔寄佛印 其一","author":"彭汝砺","text":"有客寄诗南雍州，清新全占岘山秋。\n官名便据非常宠，文学元居第一流。\n云近蛟龙朝丈室，夜寒星月宿重楼。\n知公有勇断鳌足，到彼不须骑虎头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颖叔寄佛印 其二","author":"彭汝砺","text":"忆留铁瓮城经夏，却泛金山寺看秋。\n钟梵去随沧海远，楼台低涌大江流。\n波澜隐约开龙国，烟雾分明见蜃楼。\n他日上方容听法，不应疑我皱眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又寄佛印","author":"彭汝砺","text":"神仙苒苒在蓬壶，更得诗来慰索居。\n天上楼台开佛国，日边香火读天书。\n篮舆独往公今尔，蜡屐他时我亦如。\n彼是此非无足问，悠悠同是一空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中久雨","author":"彭汝砺","text":"我征徂西今复东，分明身世如飘蓬。\n岁华便是百年半，日气恰当三伏中。\n山谷无情频送雨，园林何事急招风。\n浮生所遇皆知分，未用纷纷论色空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"滩上","author":"彭汝砺","text":"片帆逆水过溪山，吾贱能谙世路难。\n小雨作云迷涧谷，急风吹雪上波澜。\n草根已定春来意，梅蕊犹含腊后寒。\n渐老岂能支道路，扁舟欲去老渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送正孺","author":"彭汝砺","text":"离筵冰冻樽中酒，行路雪沾身上衣。\n游子思乡梦先到，老人惜别涕交挥。\n昔年终军弃繻去，今日买臣怀绶归。\n昼绣奚为公不乐，祇应愁见白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答执中见和","author":"彭汝砺","text":"枉费山公席上珍，看书转忆笑言亲。\n旧时香积厨中饭，新得金莲社里人。\n传语簿书聊借日，寄声风雨莫催春。\n须容饱饫先生馔，可便闲防异姓宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和伯钧节推","author":"彭汝砺","text":"昔年相见蜀山隈，落落知君匪众材。\n白发今时俱老大，青山何日盍归来。\n烟尘草草驰军檄，风雨匆匆把酒杯。\n万事欲言终不尽，诗成悽怆有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东流寄天保弟","author":"彭汝砺","text":"湖山高下绿参差，目断东流此一时。\n日久不闻鸿雁信，春来初见棠棣诗。\n草根二月蒌蒿熟，沙外数家杨柳垂。\n恰是去年相送处，酒樽还忆数追随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄君时弟","author":"彭汝砺","text":"正直多疑势易孤，官情时态近何如。\n应知秋后无穷事，未得冬来第一书。\n忆汝愁闻洞庭雁，作诗欲寄武昌鱼。\n江湖此别何其久，日月居诸又岁除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"使辽","author":"彭汝砺","text":"北行未始过陈桥，仗节今朝使大辽。\n寒日拥云初漠漠，急风招雪晚萧萧。\n江湖梦寐时之楚，象魏精诚日望尧。\n孤驿夜深谁可语，青灯黄卷慰无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古北口杨太尉庙","author":"彭汝砺","text":"将军百战死嵚岑，祠庙岩岩古到今。\n万里胡人犹破胆，百年壮士独伤心。\n遗灵半夜雨如雹，馀恨长时日为阴。\n驿舍怆怀心欲碎，不须更听鼓鼙音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎北口始闻鸡","author":"彭汝砺","text":"雪馀天色更清明，野店忽闻鸡一声。\n地里山川从禹画，人情风俗近燕京。\n渔阳父老尚垂涕，燕颔将军谁请缨。\n容覆不分南与北，方知圣德与天平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]