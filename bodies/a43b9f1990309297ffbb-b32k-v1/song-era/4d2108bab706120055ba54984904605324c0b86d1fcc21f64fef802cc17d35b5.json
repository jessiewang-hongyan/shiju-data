[{"title":"偈颂一百六十首 其三十五","author":"释宗杲","text":"身口意清净，是名佛出世。\n身口意不净，是名佛灭度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其三十二","author":"释宗杲","text":"才方改岁贺新年，今朝又是二月一。\n入所證处没商量，摩诃般若波罗蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十九","author":"释宗杲","text":"腊月十五天降雪，为瑞为祥无空阙。\n文殊露出广长舌，普贤大士得一橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其一三六","author":"释宗杲","text":"三转法轮于大千，其轮本来常清净。\n天人得道此为证，三宝于是现世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十四","author":"释宗杲","text":"月生一，铁轮天子寰中敕。\n月生二，丰干骑虎入闹市。\n月生三，蟭螟眼里巨鳌翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十三","author":"释宗杲","text":"德山棒，临济喝，今日为君重拈掇。\n天何高，地何阔，休向粪扫堆上更添搕掩。\n换却骨，洗却肠，径山退身三步，许尔诸人商量。\n红粉易成端正女，无钱难作好儿郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十二","author":"释宗杲","text":"颠倒想生生死续，颠倒想灭生死绝。\n生死绝处涅槃空，涅槃空处眼中屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13525,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十一","author":"释宗杲","text":"稽首能度诸世间，无量殊胜福德聚。\n金轮统御四天下，普施群生安隐乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13526,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其二十","author":"释宗杲","text":"径山无寸土庄田，今夏随宜结众缘。\n慵论道，懒谈禅，拄杖挑来个个圆。\n不用息心除妄想。\n大家吃饭了瞳眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13527,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十九","author":"释宗杲","text":"今朝正是四月八，净饭王宫生悉达。\n吐水九龙天外来，捧足七莲从地发。\n点胸点肋独称尊，大口开张自矜伐。\n都卢往世七旬馀，四十九年恣忉怛。\n赖有云门老跛师，一棒当时要打杀。\n人人尽道报佛恩，将此深心奉尘刹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13528,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十八","author":"释宗杲","text":"今朝又是四月一，那事全然没消息。\n衲僧皮草久不乾，且喜日头东畔出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13529,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十六","author":"释宗杲","text":"眼空宇宙浑无物，大坐当轩孰敢窥。\n选佛追官俱已了，同途把手不同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13530,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十四","author":"释宗杲","text":"转山河大地归自己则易，转自己归山河大地则难。\n有人道得不难不易句，却来径山手里请捧吃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13531,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十二","author":"释宗杲","text":"买铁得真金，求雨得瑞雪。\n五峰玉琢成，千树银华结。\n龙王降吉祥，普贤呈丑拙。\n三世如来秘密门，今日一时都漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13532,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十一","author":"释宗杲","text":"正朝把笔，万事皆吉。\n应时纳祜，庆无不宜。\n若作世谛，流布平地。\n吃交更在佛法，商量眉须堕落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13533,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其十","author":"释宗杲","text":"出队半个月，眼不见鼻孔。\n失却祖师禅，拾得个骨董。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13534,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其九","author":"释宗杲","text":"不用安排，切莫造作。\n造作安排，无绳自缚。\n不安排，不造作，善财弹指登楼阁。\n秘魔放下手中叉，普化入市摇铃铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13535,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其七","author":"释宗杲","text":"眼不自见，刀不自割。\n吃饭济饥，饮水定渴。\n临济德山特地迷，枉费精神施棒喝。\n除却棒，拈却喝，孟八郎汉，如何止遏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13536,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其六","author":"释宗杲","text":"今朝八月十有五，顾兔天边谁不睹。\n若非东土小释迦，放过长沙这老虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13537,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百六十首 其三","author":"释宗杲","text":"这个川藞直，自来好打鬨。\n闹处便入头，恶静而喜动。\n前年今日始归家，今日前年路不差。\n一回饮水一回噎，一瓣栴檀一碗茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13538,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十","author":"释宗杲","text":"觉空空，觉空空。\n觉觉觉空，空空亦空。\n欲识无穷好消息，都卢只在此轩中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13539,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十五","author":"释宗杲","text":"莫恋净洁处，净处使人困。\n莫恋快活卜，快活使人狂。\n如水之任器，随方圆短长。\n放下不放下，更请细思量。\n三界与万法，匪归何有乡。\n若只便恁么，此事大乖张。\n为报许居士，家亲作祸殃。\n豁开千圣眼，不须频祷禳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13540,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十四","author":"释宗杲","text":"只欠■地一下尔，若得■地一下了。\n儒即释，释即儒。\n僧即俗，俗即僧。\n凡即圣，圣即凡。\n我即尔，尔即我。\n天即地，地即天。\n波即水，水即波。\n酥酪醍醐搅成一味，瓶盘钗钏镕成一金。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13541,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十三","author":"释宗杲","text":"无上大涅槃，圆明常寂照。\n凡愚谓之死，外道执为断。\n诸求一乘入，目以为无作。\n尽属情所计，六十二见本。\n妄立虚假名，何为真实义。\n唯有过量人，通达无取舍。\n以知五蕴法，及以蕴中我。\n外现众色像，一一音声相。\n平等如梦幻，不起凡圣见。\n不作涅槃解，二边三际断。\n常应诸根用，而不起用想。\n分别一切法，不起分别想。\n劫火烧海底，风鼓山相击。\n真常寂灭乐，涅槃相如是。\n吾今彊言说，令汝舍邪见。\n汝勿随言解，许汝知少分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13542,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其九","author":"释宗杲","text":"恶念既不生，善念常相续。\n诸波罗密门，一切自具足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13543,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其六","author":"释宗杲","text":"无诸比丘名近悦，为母王氏请普说。\n妙喜便登曲录床，忉忉怛怛恣饶舌。\n从来法本离言诠，不假思量与分别。\n说甚地狱及天堂，四圣六凡俱泯绝。\n纵有魔王欲作难，金刚宝剑当头截。\n王氏养子要参禅，只这一念永不灭。\n弹指顿明诸法门，释迦弥勒齐超越。\n还如涂毒鼓当轩，一击闻之皆脑裂。\n无边烦恼悉蠲除，夙业旧殃汤沃雪。\n末后一句为重宣，凝然万里一条铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13544,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其四","author":"释宗杲","text":"女流中有大丈夫，示现其身化其类。\n以戒定慧解脱法，摄彼贪欲瞋恚痴。\n虽处于中作佛事，如风行空无所依。\n过去未来及现在，尘沙诸佛及菩萨。\n异口同音发是言，善哉奇特世希有。\n心源清净无忧喜，不作无喜无忧想。\n逢场作戏随世缘，而于世缘无所著。\n六月火云烧碧空，雷声忽震三千界。\n销除热恼获清凉，是彼丈夫诞时节。\n我说此偈助光明，普施法界诸女人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其一","author":"释宗杲","text":"普提宿将坐重围，劫外时闻木马嘶。\n寸刃不施魔胆碎，望风先已竖降旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寂音尊者赞","author":"释宗杲","text":"头如杓，面如楪。\n口无舌，说无竭。\n是而非，同而别。\n种空华，抽暗楔。\n死木蛇，活如蝎。\n击涂毒，脑门裂。\n是阿谁，甘露灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄归宗华侄禅师","author":"释宗杲","text":"坐断金轮第一峰，千妖百怪自潜踪。\n年来又得真消息，说道杨岐正脉通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩居士赞","author":"释宗杲","text":"冷坐毗耶城，百病一时发。\n不得文殊来，几乎无合杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪峰空长老求赞","author":"释宗杲","text":"慧空抓著吾痒处，吾尝劄著伊痛处。\n痛处痒，痒处痛，不与千圣同途，岂与衲僧共用。\n莫言扫帚竹里无钱筒，蒿枝丛林无梁栋。\n虽然家丑不可外扬，也要诸方眼目定动。\n而今各自不得已，一任画出这般不唧溜底老冻■。\n但将悬向壁角落头，使来者瞻之仰之。\n昼夜六时烧兜楼婆毕力迦沈水栴檀之香，作七代祖翁之供。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄智通居士善住庵","author":"释宗杲","text":"善住庵中人，从来无所住。\n只这无住心，便是安身处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其二","author":"释仁勇","text":"天上无弥勒，地下无弥勒。\n打破太虚空，如何寻不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"储大夫请赞","author":"释宗杲","text":"云门妙喜真，云台居士画。\n利钝不相资，展向虚堂挂。\n妙利中钝，钝得颟顸。\n云台钝中利，利得脱酒。\n如今利钝都挂壁，师子翻身绝踪迹。\n踪迹无，便涂糊，一时分付诸大夫。\n唵摩尼达里悉利苏卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"富枢密妙高堂","author":"释宗杲","text":"妙高堂，随所至。\n榜未悬，落第二。\n似猛焰，藏蚊蚋。\n拟承当，生妄计。\n德云师，安有作。\n在别峰，亦宽廓。\n住佛地，何所吒。\n我作铭，任图度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普明琳和尚赞","author":"释宗杲","text":"触处无碍，得大自在。\n达磨脊梁，释迦脑盖。\n夫是之谓普明老人，敢与诸尘作对者也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普融平和尚赞","author":"释宗杲","text":"示无作相，击涂毒鼓。\n行无缘恶，诛佛诛祖。\n如是见得普融，妙喜未敢相许。\n直下来也，如龙似虎。\n一槌打破太虚空，至今一缺无人补。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人求赞 其三","author":"释宗杲","text":"上无片瓦盖头，下无卓锥之地。\n赤骨?个浑身，与人争甚闲气。\n些子无明不奈何，说甚祖师西来意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人求赞 其一","author":"释宗杲","text":"咄哉灭胡种，面目真可恶。\n过桥便拆桥，得路便塞路。\n虽欲彊柔和，毕竟触人怒。\n万事类如此，谁敢相亲附。\n乞儿囊本空，常誇敌国富。\n闻说阎罗王，未免生怕怖。\n休更放大言，嫌佛不肯做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答刘安抚","author":"释宗杲","text":"毛锥子上通消息，争似亡言绝见知。\n后夜一轮空界月，清光千里共依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢紫岩居士","author":"释宗杲","text":"紫岩分惠建溪茗，妙喜答以青州衫。\n得人一牛还一马，前三三与后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"超宗道人请赞","author":"释宗杲","text":"一条白棒，佛祖俱打。\n超宗禅人，大胆不怕。\n画我来乞赞，鬼门上帖卦。\n三十年后此话大行，任一切人钻龟打瓦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"释迦出山相赞","author":"释宗杲","text":"正觉山前折却本，三七日内心头闷。\n却来鹿苑讨便宜，好与拽翻椎一顿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡知县小庵","author":"释宗杲","text":"此庵非小亦非大，堪笑石头空捏怪。\n不知法界即此庵，彊谓此庵含法界。\n而今欲识住庵人，万象之中独露身。\n妙喜为写此庵榜，要与太虚为近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡郎中请赞","author":"释宗杲","text":"赋性暴，举止傲，说甚禅，谈甚道。\n有个没意智呆郎，随例妄想颠倒。\n蔡郎中还见么，若也当面讳却，便是监主自盗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡宣教请赞","author":"释宗杲","text":"手里指东画西，口中胡说乱道。\n一生惯打葛藤，天真不属做造。\n有个蔡正卿，时时来著到。\n水流湿，火就燥，马面团圞随人所好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡宣教请赞","author":"释宗杲","text":"咄哉无知，半憨半痴。\n黑豆换人眼睛，十分爱讨便宜。\n一朝死入地狱，定堕镬汤泥犁。\n佛也救尔不得，任尔凤林吒之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德光禅人求赞","author":"释宗杲","text":"有德必有光，其光无间隔。\n名实要相称，非青黄赤白。\n参彻佛祖顶?禅，不是等闲相诳嚇。\n我所参得底只要涅槃堂里用，且不听杜撰禅师三千八百画。\n吾为作證明，他年将作轨格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧日雅和尚赞","author":"释宗杲","text":"嵌嵌枯枯，磊磊落落。\n喑呜叱咤，万人气索。\n宴坐胡床，倾湫倒岳。\n秉杀活剑，解生死缚。\n不堕尘缘，宁居寂寞。\n豁开济北，三要三玄。\n提持关西，末后一著。\n慧日之影沈姑溪，泥牛触折祥麟角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕴闻禅人求赞","author":"释宗杲","text":"蕴闻闻自性，自性离闻蕴。\n吾真亦复然，迥超千圣顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遵璞禅人求赞","author":"释宗杲","text":"临济烧黄檗禅版，香严哭沩山拄杖。\n云门村叟效颦，颦也作这般伎俩。\n咄。\n传来铁钵盛猫饭，磨衲袈裟入墨盆。\n祖翁活计那坏了，不知将底付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圜悟和尚赞三首 其三","author":"释宗杲","text":"这老汉无置锥之地而不贫，有无价之宝而不富。\n睹众善而不欣，遇诸恶而不怖。\n一著当阳全提，要且秋毫不露。\n有时石火里藏身，却向电影中回互。\n塞却临济三玄门，截断岩头末后句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圜悟和尚赞三首 其二","author":"释宗杲","text":"风雷为舌，虚空为口。\n应群生机，作师子吼。\n眼光烁破四天下，惊起法身藏北斗。\n个是杨岐嫡孙，喝下须弥倒走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圜悟和尚赞三首 其一","author":"释宗杲","text":"道大德备之词，赞师之真。\n此处无金二两，俗人酤酒三升。\n超佛越祖之谈，赞师之禅。\n削圆方竹杖，鞔却紫茸毡。\n无可论，无可说，正是守著系驴橛。\n那堪更言七坐道场三奉诏旨，大似郑州出曹门，且喜没交涉。\n降此之外，毕竟如何。\n江南两浙，春寒秋热。\n寄语诸方，不要饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"魏侍郎净心阁","author":"释宗杲","text":"伟哉广大寂灭心，譬如虚空不分别。\n拟心求净即染污，况复比伦诸佛土。\n又如梦中所见物，所见虽有不可取。\n如是通达无有疑，净心心义炳然现。\n是义现矣难测量，超诸色相离言说。\n过去未来现在世，佛及菩萨与声闻。\n一切含识有情类，平等于义如实了。\n善哉奇特过量人，只以此阁演是义。\n演已便息随所缘，亦与梦中无差别。\n我以父母所生口，说此无上妙伽陀。\n庄严广大寂灭心，为诸来者作饶益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又同尘庵","author":"释宗杲","text":"尘无自性，揽真成立。\n拟和其光，同亦俱失。\n外既匪宽，内亦不窒。\n是义非虚，亦复非实。\n庵中主人，如玉处石。\n作如是观，千载一息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用宣禅人求赞","author":"释宗杲","text":"宣传吾真，吾为宣说。\n眨上眉毛，大巧若拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云端和尚赞二首 其二","author":"释宗杲","text":"饥餐渴饮，闲坐困眠。\n赤手杀人，血溅梵天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白云端和尚赞二首 其一","author":"释宗杲","text":"少处更减，多处又添。\n达磨不会，却反西天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示周子充写华严经","author":"释宗杲","text":"总别同异，成坏行布。\n圆融无碍，尘人众刹。\n非宽刹入，众尘非隘。\n居士笔端，宣畅果海。\n因源自在，我今说偈。\n赞扬同證，一真法界。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李参政转物庵","author":"释宗杲","text":"若能转物，即同如来。\n咄哉瞿昙，诳諕痴呆。\n物无自性，我亦非有。\n转者为谁，徒劳心手。\n知无自性，复是何物。\n瞥起情尘，扪空揣骨。\n此庵无作，住者何人。\n具顶门眼，试辨疏亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨岐和尚赞","author":"释宗杲","text":"异类中行，拖犁拽耙。\n栗棘金圈，是何言话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄冯楫居士会药山问石头见性成佛公案偈","author":"释宗杲","text":"梵语唐言，打成一块。\n咄哉俗人，得此三昧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画髑髅颂","author":"释宗杲","text":"即此形骸，便是其人。\n一灵皮袋，皮袋一灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵州和尚赞","author":"释宗杲","text":"庭柏无根，虚空有骨。\n十分鲁钝，似辽天鹘。\n热至乘凉，寒烧榾柮。\n夫是之谓，赵州古佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]