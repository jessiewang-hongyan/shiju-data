[{"title":"岭后山庄","author":"蒲寿宬","text":"感慨重来岁月深，手栽松柏已成林。\n万山自此无南北，一水长流不古今。\n先训丁宁犹在耳，老吾寂寞自沾襟。\n君恩已遂祈閒请，莘野归耕是本心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招枯崖悟上人住山","author":"蒲寿宬","text":"山僧如病鹤，意气独离群。\n思共孤峰月，閒分半榻云。\n井华晨起汲，瀑布夜深闻。\n相向无言说，窗间草木欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画船","author":"蒲寿宬","text":"世路羊肠姑已之，扁舟我欲问冰夷。\n祗因吏部酷好酒，岂是鸡林要售诗。\n万事不如潮有信，寸心唯赖月相知。\n斜风细雨休归去，此政老翁沉醉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行有感","author":"蒲寿宬","text":"鸡犬不鸣何处村，颓檐破壁问谁门。\n蓬蒿满地田园在，瓦砾如山井臼存。\n青草髑髅疑是梦，白头老父泣无言。\n咨诹邻旧多为鬼，倚杖徘徊堪断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴偶成柬枯崖","author":"蒲寿宬","text":"砌藓频侵绿，野花相避红。\n不知昏与昼，惟见雨和风。\n有酒为寒尽，无诗非景穷。\n地炉煨芋火，时约老僧同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"种麦","author":"蒲寿宬","text":"荒林僻左地，时已及来牟。\n颇学鸦种麦，可怜人代牛。\n莫言耒耜苦，且愿甲兵休。\n来岁如旋磨，机轮向瀑流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵委顺寄诗山中因次韵","author":"蒲寿宬","text":"欲言谁与共，冉冉日还斜。\n绕郭多春树，隔江生暮霞。\n满堤吹柳絮，一舸汎桃花。\n唯爱鳊鱼美，垂缗傍古槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纠之官莆阳","author":"蒲寿宬","text":"荷橐蔼诸孙，英英列戟门。\n能声家有谱，清识郡无冤。\n松影旌旗道，梅花玉雪村。\n亲庭两驿便，时得问凉暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送使君赵寺丞泰先生","author":"蒲寿宬","text":"别郡安知寄此州，攀辕合借我公留。\n求仁而得又何怨，蔽美岂其为好修。\n花径怕风宜落絮，秧田足雨恐妨牟。\n春归谁识春心苦，才说思春欲白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送择斋先生徐大监赴建仓","author":"蒲寿宬","text":"帝命元臣选外台，南州声望久崔嵬。\n仓箱早办九年集，原隰欣迎四牡来。\n父老此时方见日，吏饕平昼忽惊雷。\n锦衣翠节乡邦重，耿耿文星照上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送枯崖悟上人省觐三山","author":"蒲寿宬","text":"遍踏长松影，行吟入画屏。\n秋江一叶渡，落日数峰青。\n白发干新梦，黄花制晚龄。\n片云何日会，重约在林扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送清老弟归荆湖幕","author":"蒲寿宬","text":"驱车出闽峤，微宦历江湖。\n沙塞马蹄疾，水天鸿影孤。\n楚天时卧鼓，蜀道日飞刍。\n万里戎旃客，何当表丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳","author":"蒲寿宬","text":"黄花浑似旧，白发忽惊新。\n争说参军帽，谁怜处士巾。\n折腰宁不辱，有酒未为贫。\n绝爱南山色，相看意转真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻蟋蟀有感","author":"蒲寿宬","text":"煎煎促谁织，机杼咽空林。\n何处露丛下，入人秋思深。\n清灯一线泪，孤枕百年心。\n此意知谁会，悠然太古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仁山杨先生","author":"蒲寿宬","text":"滴尽艰难泪，肝肠铁似顽。\n忍教师道绝，还向我翁潸。\n命也吾何憾，天乎识固悭。\n平生修洁意，千载此西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吕秘书","author":"蒲寿宬","text":"玉阶空忆去，破屋古梅旁。\n犹讶黯言直，不磨迁史良。\n葵心犹白发，槐梦落黄粱。\n最后龙门客，恩深涕泗滂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石隐老屿上人","author":"蒲寿宬","text":"已约岩头同数宿，如何消息竟茫然。\n抱琴有意弹明月，采药无心到绝巅。\n不过虎溪安得笑，偶逢醉石便攲眠。\n山林此乐而今少，一日相从是宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄老溪上人","author":"蒲寿宬","text":"已知山是石，挂起碧筇条。\n家在黄梅树，门当独木桥。\n寡交因犬恶，默坐听蝉调。\n同道何时过，心慵不见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄何我轩","author":"蒲寿宬","text":"十年不见此髯翁，笑我而今鬓亦蓬。\n几度因诗亲水部，一回看剑泣山公。\n无心尘世云移岫，极目仙壶浪拍空。\n痛饮剧谈非是梦，寸丹长与荔枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄径山书记悟上人","author":"蒲寿宬","text":"人间传妙语，尘外更深藏。\n寝食因吟废，形骸欲坐忘。\n瘦林秋见鹤，断磬夜闻螀。\n出定生幽思，窗虚月在廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄思溪老藏叟珍上人","author":"蒲寿宬","text":"万折苕溪水，精庐若个边。\n菰菱时入供，包锡暮行船。\n月朗无云夜，雕横欲雪天。\n了知身是客，莫负故山缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄胡苇航料院","author":"蒲寿宬","text":"别来梅正谢，愁坐柳成阴。\n救世有何策，图名非本心。\n万言难复古，一语傥医今。\n已向山中老，因风怀所钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼亡","author":"蒲寿宬","text":"百岁期偕老，半生尘梦讹。\n方谐委畚事，忍作鼓盆歌。\n野水悲蘋藻，秋风泣薜萝。\n青灯课子诵，此意念君多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦故人郭推官元用诗以奠之","author":"蒲寿宬","text":"鸡絮才陈泪已倾，故人旌旐尚禅扃。\n尘中愧我头空白，梦里逢君眼更青。\n束发论交真意气，伤心无语负幽冥。\n求铭敢后朋侪事，况复原头有鹡鸰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山暮景","author":"蒲寿宬","text":"青山寒似削，黄叶扫仍飞。\n落日行人急，痴风过翼稀。\n老鸡寻旧杙，野犬吠缁衣。\n独倚枯藤立，柴门候牧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷九曲","author":"蒲寿宬","text":"紫缦红裀事有根，绿函金锁蜕犹存。\n无缘得到千岩顶，试问而今几代孙。\n汉祀昔曾陈玉脯，晋人方始识桃源。\n不因大隐屏中老，未易抽簪扣洞门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游鼓山题天风海涛亭","author":"蒲寿宬","text":"翛翛白发倚栏干，笑仰高峰巾袂仙。\n但见烟霞相远近，不知宇宙有中边。\n宦途人在非凡境，客里身游极乐天。\n自叹情怀今潦倒，重来未识是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋枸杞","author":"蒲寿宬","text":"神草如蓬世不知，壁间墙角自离离。\n辛盘空芼仙人杖，药斧惟寻地骨皮。\n千岁未逢朱孺子，四时堪供陆天随。\n霜晨忽讶春樱熟，閒摘殷红绕断篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪堂春日即事","author":"蒲寿宬","text":"抵是此溪山，须将旧眼看。\n鸥飞绿不染，鸟没翠如攒。\n雨过岩峦净，潮来天地宽。\n莫浮茅屋去，犬吠拍栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午","author":"蒲寿宬","text":"鬓符腰艾去纷纷，荷叶荷花匝水滨。\n思远楼前虽有曲，若邪溪畔岂无人。\n莫将楚恨悲儿女，聊把骚章托鬼神。\n浊酒满壶渔父笑，江边鸥鹭正相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江心寺诗","author":"蒲寿宬","text":"闻说东瓯胜，兹游心颇降。\n江心浮一寺，水面立双幢。\n路绝帆当户，潮回月漾窗。\n悠悠怀古思，把酒酹渔釭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题纯阳洞","author":"蒲寿宬","text":"路入松萝去，閒眠石顶云。\n半宵忽闻虎，六月不飞蚊。\n烟郭多年画，晴畴破衲纹。\n世无俱绝粒，持钵不如耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金粟洞","author":"蒲寿宬","text":"天风吹绝顶，小立思生豪。\n遥海望无际，众风疑避高。\n龙留神骨去，犀敛夜光韬。\n惟爱瑶池水，寻云学种桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题海云楼下一碧万顷亭","author":"蒲寿宬","text":"倚阑心目净，万顷一磨铜。\n欲画画不得，托言言更穷。\n阴晴山远近，日夜水西东。\n此意知谁会，鸥边独钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅窗啸月图","author":"蒲寿宬","text":"梅花纸帐梦，耿耿欲宵残。\n何处幽人啸，一窗明月寒。\n素光流肺腑，清响动岩峦。\n拥膝无言语，归来意自欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题深省庵","author":"蒲寿宬","text":"结草为庵寄一枝，钟鱼聊复事清规。\n野蔬入供无人识，古柏为香有佛知。\n频去饮泉非为渴，偶来坐石忽忘饥。\n常谈且接头陀伴，欲说上乘空费辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠无庵道人风鉴","author":"蒲寿宬","text":"采霞以为食，搴云以为衣。\n饱煖无所为，骑风去如飞。\n閒将电作镜，照见人精微。\n欲说不得说，天机本无机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠日者王谈天","author":"蒲寿宬","text":"问天天不言，君更欲谈天。\n只且话明日，岂须穷百年。\n已灵机石事，犹梦蚁柯边。\n为扣希夷老，如何尚爱眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴仰云","author":"蒲寿宬","text":"云巾羽扇得真如，不用羞惭非故吾。\n入手千般休说巧，转头一著不为愚。\n尘中羁绊无还有，物外逍遥有若无。\n我若忘机曾悟此，烟波鸥鹭是吾徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠洪都高士萧野鹤","author":"蒲寿宬","text":"自从华表去蹁跹，縠顶丹深不计年。\n万里孤光中夜月，一声清唳九重天。\n偶然梦觉思辽海，不是饥驱向野田。\n赤壁秋高风露下，无心曾唤老坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠隐者","author":"蒲寿宬","text":"自是山林僻，何心与世疏。\n土铛三合米，竹牖半床书。\n月树迷归鹤，沙泉数过鱼。\n无人觅巢许，不必更深居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 汉中牟令鲁恭","author":"蒲寿宬","text":"吾爱鲁仲康，治效多致祥。\n害稼螟犬牙，中牟了无伤。\n掾惊雉驯扰，儿念雏方将。\n河南有府尹，其美乃播扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 汉堂邑令钟离意","author":"蒲寿宬","text":"吾爱钟离意，锦制与人异。\n荒县民无庐，茅竹毕缮事。\n亦有多怖人，憯憯惑祸祟。\n祝土矢乃尽，神谴不敢避。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 汉密令卓茂","author":"蒲寿宬","text":"吾爱卓子康，作邑非寻常。\n口不及人恶，抚字若弗遑。\n礼律乃并用，化嚚以为良。\n解马以与人，不较人自偿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 汉雍丘令刘矩","author":"蒲寿宬","text":"吾爱刘淑方，礼逊以化彊。\n谆谆耳提训，语味深且长。\n忿恚为可忍，莫入鸣弦堂。\n讼者各感去，从今无他肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 齐山阴令傅琰","author":"蒲寿宬","text":"吾爱传季圭，为事求端倪。\n群愚亦智诈，不辨袪厥迷。\n感深卖针媪，腼以食豆鸡。\n一县称神明，鼠辈榛其蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 唐鲁山令元德秀","author":"蒲寿宬","text":"吾爱元紫芝，卓尔不可移。\n盗虎孰小大，许囚虎归尸。\n音乐第胜负，蔿于遭殊知。\n岁满何所为，柴车一缣随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七爱诗赠程乡令赵君 魏邺令西门豹","author":"蒲寿宬","text":"吾爱西门豹，其事深可效。\n波神岂荒淫，巫言亦机巧。\n大妪去不来，小妪足踸踔。\n豪长涕叩头，从此识政教。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"蒲寿宬","text":"芙蓉披靡秋水寒，吴姝越艳芳思单。\n漫把黄花事佳节，黄花不入歌舞欢。\n昔人戏马足强健，今我无酒空巑岏。\n黄花无言不可诘，青山落日明归翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日贵客入山地狭不足以容歌舞故作","author":"蒲寿宬","text":"莫歌乱我蛩，莫舞践我菊。\n歌不入此耳，舞适局汝足。\n蛩吟今古心，菊老贫贱屋。\n斟菊听我蛩，绝胜人间曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日简留松涧","author":"蒲寿宬","text":"瀼瀼白露坠，独起行绕篱。\n岂泥兹晨游，偶谐昔人期。\n白衣已缥缈，幅巾自淋漓。\n举杯泛寒荣，何以慰所思。\n登山极野望，涕泗空涟洏。\n戚戚霜叶语，雁过鸣声悲。\n参军尔何事，帽侧无人知。\n莫轻一时谑，贻此千载嗤。\n餐英饮沆瀣，政坐骚人痴。\n起酹彭泽翁，此意堪语谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又渔父词二首 其一","author":"蒲寿宬","text":"白水塘边白鹭飞，龙湫山下鲫鱼肥。\n攲雨笠，着云衣。\n玄真不见又空归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又题纯阳洞","author":"蒲寿宬","text":"十里扪藤萝，千崖插虚碧。\n仰觉云汉低，俯见尘市窄。\n小山走委蛇，远水别支脉。\n身骑鹪鹩枝，目眇大鹏翮。\n更有千载人，幽岩蜕空魄。\n朝蹑一片云，夜啸百丈石。\n我疑真人去，留此守剑舄。\n道人既无心，何事苦著迹。\n我有一壶酒，起舞酹仙伯。\n松槿虽殊途，宇宙同作客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万壑清流","author":"蒲寿宬","text":"旨哉哲人语，有道亲为传。\n清流出万壑，千载此两贤。\n谁倾六月雪，洗我一片天。\n妙趣不可极，如此山中泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上舶使监丞王会溪","author":"蒲寿宬","text":"抗意欲窥奇，栖潜在郡帙。\n犹疑瓮为天，岂信盲问日。\n清晨非梦寐，见此五色笔。\n寒光动斗牛，馀照堕圭荜。\n目前千古在，吾故一日失。\n至道涵深纯，大雅藏僩瑟。\n怀兹泉石心，贲之林野质。\n百年岂不短，万羡从此毕。\n倘云可与语，敢惮行以膝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与石岩方常簿游白水塘观龙湫","author":"蒲寿宬","text":"孤灯照不寐，独起行绕床。\n命驾欲千里，千里债已偿。\n可怜太拙计，弗学时世妆。\n癖嗜镌聱牙，拄彼枯肾肠。\n柴桑赋移居，取友胜面墙。\n奇文与疑义，相与窥抑扬。\n愿给薪水役，怀此一瓣香。\n自分参也鲁，或笑道士狂。\n吁嗟古之人，踽踽而凉凉。\n我不欲富贵，修短由上苍。\n齐奴尔何事，彭祖今何方。\n庄周蝶体态，淳于蚁侯王。\n龙湫一瞬息，珠琲万斛强。\n汎汎莲叶舟，淼淼白水塘。\n薜荔为我衣，芙蓉为我裳。\n握石为我饴，采菊为我粻。\n兴怀自千载，有酒且一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子别母呈所翁陈先生","author":"蒲寿宬","text":"子别母，欲别牵衣意何苦。\n母有众儿俱母怜，儿无别母儿谁乳。\n海恶宁匪蛟，山饕莫如虎。\n小大不相弃，高深自为扈。\n万古天地中，何得如母所。\n披絮成踟蹰，履霜正凄楚。\n不见城上乌，相随八九子。\n反哺何足云，慈乌乃如此。\n引翼且莫高，短翅将千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中井","author":"蒲寿宬","text":"乾元肇初气，坤母乃六之。\n谁明爻象意，凿出混沌奇。\n所以击壤民，饮水源不知。\n空山有古甃，夜气方归时。\n明月照我牖，独起携军持。\n一瓢饮沆瀣，凉意生肝脾。\n下以浇丹田，上以滋华池。\n潇然脱尘土，举身入希夷。\n神人授我诀，欲以疗我饥。\n归来煮白石，精馔琼为糜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己卯六月十一日书石室壁","author":"蒲寿宬","text":"晏坐图画出，银屏列郡山。\n几案空水接，舟楫窗窦间。\n清风荡炎瘴，异趣起懦顽。\n梦随白鸥去，静看飞鸟还。\n夜深忽闻笛，何处明月湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中庭步月","author":"蒲寿宬","text":"月光被中庭，竹影弄幽色。\n潇潇一幅素，洒洒数茎墨。\n忽然风动处，惟有月写得。\n此画应入神，无言自心识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书会溪郴阳瀑布图后三首 其三","author":"蒲寿宬","text":"千山六月火，可使金石然。\n怀兹水一滴，想彼心千年。\n愿君倒天瓢，流泽无中边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书会溪郴阳瀑布图后三首 其二","author":"蒲寿宬","text":"楚山亦瘴疠，湘水多幽灵。\n高飙雷电激，尽日霰雪零。\n涤去热恼肠，清风自泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书会溪郴阳瀑布图后三首 其一","author":"蒲寿宬","text":"山椒斫寒翠，涧曲披玄图。\n写此一派润，化作万顷腴。\n谁知田中禾，粒粒心上珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书草屋壁","author":"蒲寿宬","text":"天地无终穷，万物乃刍狗。\n勿誇杏为梁，何如瓮作牖。\n昔闻巢氏民，仁义亦奚有。\n蠢蠢不识知，居居自醇厚。\n今来丰屋士，文法困绳纽。\n力竞蝜蝂虫，计生养狙叟。\n谁家甲第巍入云，何人鹑衣不掩肘。\n岂知鬼瞰因高明，安得春阳到穷蔀。\n蜗庐能几何，蛮触胜亦负。\n忆我柴桑翁，荒宅十馀亩。\n草屋八九间，柴门五株柳。\n野水滋粳?，春畦足葱韭。\n永日为琴书，停云念亲友。\n仪秦枉饶舌，施龙漫多口。\n白衣苍狗安可知，不夷不惠自可否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]