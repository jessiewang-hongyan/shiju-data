[{"title":"题义门胡氏华林书院","author":"宋琪","text":"贤良肄业文方盛，孝友传家族更豪。\n旌表特恩门第贵，御书新赐姓名高。\n谋孙有后荣非数，待士无疏众岂劳。\n我想华林终未到，只因气概属仙曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋灯","author":"宋翔","text":"景景照幽房，荧荧吐焰长。\n昔年江上女，曾向乞馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴乐府","author":"宋翔","text":"天意回，皇母归。\n戢烽燧，敞宫闱，朝阳赫奕明鞠衣。\n惟皇之孝，惟母之慈。\n陈仙仗，荐寿卮。\n从之冢后与庶妃，奏之九成与咸池。\n沓珍瑞，骈福祺，山陬水裔咸熙熙。\n惟天之象，与帝之宜。\n千万年，无穷期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次唐彦猷顾亭林韵","author":"宋辉","text":"昔时高士宅，今日梵王居。\n楼影衔山远，钟声隔岸疏。\n风流嗟往事，精爽閟遗墟。\n回首乌衣巷，凋零兵火馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宋道","text":"自笑颠狂便归去，并无穿系买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和祖无择九日登袁州宜春台","author":"宋摅","text":"登高佳节喜重来，会客依随五马开。\n帽落秋风随意适，杯迎露菊趁时催。\n东篱幸有主人席，绛帐那逢上客陪。\n欲报君恩话归去，不妨尊酒论文才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石臼洞","author":"宋煜","text":"清泉一派水潺潺，石穴端然一臼安。\n洗药炼丹仙已去，只留踪迹与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱子庵","author":"宋煜","text":"仙人自昔好楼居，怪石棱层倚碧虚。\n见说通天中有路，世间何处觅飙车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹符","author":"宋煜","text":"仙篆元非世俗书，笔端会把鬼神驱。\n当年笔迹今何在，洞客争传竹叶符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁桥峰","author":"宋煜","text":"拄杖何年掷向空，云端隐约化晴虹。\n此桥端的通霄汉，谁与同游访月宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遗衣坛","author":"宋煜","text":"驾鹤乘鸾归紫府，仙凡从此不相干。\n要传当日飞升事，收拾遗衣为结坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题朱明洞","author":"宋煜","text":"涧流一一抱峰回，面面林峦锦帐开。\n我品洞天居第七，只应题作小蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄野人庵","author":"宋煜","text":"淮南鸡犬上云端，底事先生独世间。\n上界应嫌官府足，不如平地且骖鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝴蝶洞","author":"宋煜","text":"阴深古木护涟漪，洞里藏春人不知。\n不是桃源深有路，如向蝴蝶满璚枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵栖岩","author":"宋蒙","text":"巀巀嶪嶪山如簇，磊磊落落石如屋。\n上有绿树之阴阴，下有寒溜之涔涔。\n通天有窦十馀丈，游子扪萝来复往。\n是中端合巢神仙，桃花流水何杳然。\n我来正值春风暮，似笑贤劳又还去。\n准拟酾酒聊从容，对此坐想飞来峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夔冬暖雪不到地唯山高处尽白它皆霏雨而已","author":"宋肇","text":"密下斜飞片片愁，不堪飘泊向西州。\n思家对雪诚何味，只与群山斗白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三峡堂 其二","author":"宋肇","text":"初寻磴道踏雪烟，渐引茅檐屋数椽。\n江影动摇波面日，山光隐见峡中天。\n放怀樽酒凭栏客，回首弦歌趁市船。\n要与舟人同此乐，移花种竹满檐前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡口","author":"宋肇","text":"万里西南路，瞿唐据上游。\n峡分山对立，江合水争流。\n蛟鳄从来患，风波自古愁。\n几时飞两桨，归去幔帆秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"宋肇","text":"古道遥临水，荒城早闭门。\n乱山衔落照，归鸟下空园。\n江口渔人舫，崖腰桑树村。\n客愁何可奈，有酒莫空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三峡堂 其一","author":"宋肇","text":"林峦十里上巉岩，飞槛初凭缥缈间。\n夔子风烟依白帝，夜郎耕稼接乌蛮。\n砌横乱石遥临涧，门对高峰近带山。\n咫尺惊湍吁莫测，每来登此念乡关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋对月用昌黎赠张功曹韵呈同官","author":"王十朋","text":"水精为鉴金为波，挂空影写山与河。\n清光此夜十分好，有酒有客宜高歌。\n去年今日行役苦，浪叟溪边宿逢雨。\n传闻蜀道如天高，崖悬壁绝哀猿号。\n波横剑戟不易上，陆有虎豹何由逃。\n江山旧恃白帝险，风俗犹带乌蛮臊。\n驱驰两月到西塞，梦寐万里还东皋。\n嗅梅踏雪巴子里，路入鬼门欣不死。\n飞飞倦鸟惟思还，玉笋岂是粗官班。\n馀生但愿闲及酒，虚名宁顾触与蛮。\n良宵佳客十有五，云放月入尊罍间。\n颓然老子兴不浅，韩诗坡句聊追攀。\n君不见天宝云霓羽衣歌，人间乐舞难同科，遗音犹在悲凉多。\n有酒且饮遑恤他，不饮如此良夜何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白帝城","author":"宋肇","text":"江雨霏霏白帝城，秋草未枯春草生。\n古来战垒如云横，万里瞿塘断人行。\n至今三峡路峥嵘，时清不见更屯兵。\n荒凉废堞没春耕，但见牛羊日西平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜鹃","author":"宋肇","text":"暖云无定半阴晴，茅屋纸窗深复明。\n乔木参天竹千茎，巴山欲晓风露清。\n杜鹃飞鸣绕江城，鱼复四月江水生。\n林花落尽空含情，瀼东瀼西朝暮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题太平兴国宫","author":"宋德之","text":"殷勤此别几时还，结足应须岩洞间。\n卒岁在家贫亦好，何人似我老来闲。\n九天使者邀归艇，五岳丈人分半山。\n已是南回行脚了，归休稳坐听潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宋德之","text":"昔人豪侈徒为尔，得似章华田舍翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"宋德广","text":"好风吹月过楼西。\n楼前人影稀。\n杜鹃啼断绿杨枝。\n行人知不知。\n红叶字，断肠诗。\n从今懒再题。\n后园零落淡胭脂。\n似君初去时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题洞岩","author":"宋禧","text":"翠岩仙洞白云深，蹑石扪萝一访寻。\n真驭不逢山色映，涧风吹袂冷森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巡历属部留题青帝观","author":"宋禧","text":"按部到天孙，因过清静轩。\n山尖覆云盖，石罅迸松根。\n危磴关河路，远林桑柘村。\n闲邀羽人话，洞究五千言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题涪陵郡","author":"宋翰","text":"锦绣洲犹在，熊罴梦已无。\n文风齐两蜀，仙迹接三都。\n白石从天设，青崖见地图。\n荔枝妃子圃，不复曩时输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"宋翰","text":"襟分楚泽三千里，曲奏湘妃五十弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 咏鱼篮观音","author":"寿涯禅师","text":"深愿弘慈无缝罅。\n乘时走入众生界。\n窈窕丰姿都没赛。\n提鱼卖。\n堪笑马郎来纳败。\n清冷露湿金襽坏。\n茜裙不把珠缨盖。\n特地掀来呈捏怪。\n牵人爱。\n还尽许多菩萨债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺墅","author":"岑全","text":"荒村车马惊鸾鹤，散骑茅堂见杜兰。\n冰玉自甘山水味，慢劳甲第赐长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题韩干马","author":"岑津","text":"左辅周垣隐白沙，龙媒绝种进天家。\n骄嘶玉勒怜丰草，渴饮冰泉带落花。\n西狩还经千里栈，东巡会驾五云车。\n权奇灭没犹惊电，漫许拳毛世特誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇 玉清宫","author":"巫山神女","text":"紫云绛霭，高拥瑶砌。\n晓光中、无限剖列。\n肃整天仙队。\n又有殊音欲举。\n声还止，朝罢时，亦有清香飘世。\n玉驾才兴，高上真仙尽退。\n有琼花如雪，散漫飞空里。\n玉女金童，捧丹文、传仙诲。\n抚诸仙，早起劳卿过耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇 蓬莱景","author":"巫山神女","text":"山染青螺缥渺，人间难陟。\n有珍珠光照，昼夜无休息。\n仙景无极。\n欲言时。\n汝等何知。\n且修心，要观游，亦非。\n大段难易。\n下俯浮生，尚自争名逐利。\n岂不省，来岁扰扰兵戈起。\n天惨云愁，念时衰如何是。\n使我辈、终日蓬宫下泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇 归","author":"巫山神女","text":"吾归矣。\n仙宫久离。\n洞户无人管之。\n专俟吾归。\n欲要开金燧。\n千万频修己。\n言讫无忘之。\n哩啰哩。\n此去无由再至。\n事冗难言，尔辈须能自会。\n汝之言，还便是如吾意。\n大抵方寸平平，无忧耳。\n虽改易之。\n愁何畏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇 王母宫食蟠桃","author":"巫山神女","text":"方结实累累。\n翠枝交映，蟠桃颗颗，仙味真香美。\n遂命双成，持灵刀割来，耳服一粒，令我延年万岁。\n堪笑东方，便启私心盗饵。\n使宫中仙伴，递互相尤殢。\n无奈双成，向王母高陈之。\n遂指方，偷了蟠桃是你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇","author":"巫山神女","text":"瑶阙琼宫，高枕巫山十二。\n睹瞿塘、千载滟滟云涛沸。\n异景无穷好，闲吟满酌金卮。\n忆前时。\n楚襄王，曾来梦中相会。\n吾正鬓乱钗横，敛霞衣云缕。\n向前低揖。\n问我仙职。\n桃杏遍开，绿草萋萋铺地。\n燕子来时，向巫山、朝朝行雨暮行云，有闲时，只恁画堂高枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇 劝人","author":"巫山神女","text":"再启诸公，百岁还如电急。\n高名显位瞬息尔。\n泛水轻沤，霎那间、难久立。\n画烛当风里。\n安能久之。\n速往茅峰割爱，休名避世。\n等功成、须有上真相引指。\n放死求生，施良药、功无比。\n千万记。\n此个奇方第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇","author":"巫山神女","text":"绕绕云梯，上彻青霄霞外。\n与诸仙同饮，镇长春醉。\n虎啸猿吟，碧桃香异风飘细。\n希奇。\n想人间难识，这般滋味。\n姮娥奏乐箫韶，有仙音异品，自然清脆。\n遏住行云不敢飞。\n空凝滞。\n好是波澜澄湛，一溪香水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇","author":"巫山神女","text":"显焕明霞，万丈祥云高布，望仙官衣带，曳曳临香砌。\n玉兽齐焚，满高穹、盘龙势。\n大帝起。\n玉女金童遍侍。\n奉敕宣言，甚荷诸仙厚意。\n复回奏，感恩顿首皆躬袂。\n奏毕还宫，尚依然云霞密，奇更异。\n非我君，何闻耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜奴娇","author":"巫山神女","text":"光阴奇。\n扶桑宫里。\n日月常昼，风物鲜明可爱。\n无阴晦。\n大帝频銮于瑶池。\n朱阑外，乘凤飞。\n教主开颜命醉。\n宝乐齐吹。\n尽是琼姿天妓。\n每三杯，须用圣母亲来揖。\n异果名花几千般，香盈袂。\n意欲归。\n却乘鸾车凤翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茅山书院谒侯处士像","author":"巫伋","text":"斋粮资讲舍，遗像拜山中。\n不尚神仙术，特存儒者风。\n斯文真未丧，吾道岂终穷。\n为忆皋比拥，庭前古木丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙","author":"希叟","text":"燕堂秋未老。\n正木犀香散，芙蓉红小。\n门阑瑞烟绕。\n望银河月暗，寿星偏照。\n碧霞道要。\n有真人、亲传最妙。\n况桃源旧约，重寻鬓发，胜如年少。\n缥缈。\n六铢衣降，九转丹成，五云齐到。\n十洲三岛。\n神仙路，终须到。\n对芝兰玉树，宝杯交劝，何惜玉山醉倒。\n看乘鸾跨鹤，归来洞天未晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"应子和","text":"蜡炬短烧红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"应子和","text":"两岸夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"应子和","text":"风过落花红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁荡归兴","author":"应节严","text":"倚云绝巘极跻攀，力倦何能跨鹤还。\n回首乘鸾千尺上，举头踞虎万寻间。\n石坛胜地留仙住，玉府浮云伴客閒。\n秀水名山观不尽，放吟骚客兴何悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 梅","author":"应次蘧","text":"雪意娇春，腊前妆点春风面。\n粉痕冰片。\n一笑重相见。\n倚竹偎松，谁道罗浮远。\n寒更转。\n楚骚为伴。\n韵绕香篝暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题罗汉洞","author":"应材","text":"石磴巍峨捉膝行，行时不觉看时惊。\n纵教良匠描难就，自是天工造化成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游它山","author":"应枢","text":"登陆由来说四明，它山胜地久驰名。\n龙眠巨堰两崖下，鳄吼奔流一水清。\n瑶阁钟鸣群动息，金轮鼓奏百旦惊。\n后来水政谁研究，肯与云涛更主盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎","author":"应法孙","text":"宿雾楼台湿。\n晓清初、花明柳润，燕飞莺集。\n旧约重来歌舞地，留得艳香娇色。\n又梦草、东风吹碧。\n午困腾腾春欲醉，对文楸、玉子无心拾。\n看蝶舞，傍花立。\n酒痕未醒愁先入。\n记年时、翠楼寒浅，宝笙慵吸。\n想驻马河桥分别，恨轻竹风帆烟笠。\n早尘暗、华堂帘隙。\n倚尽黄昏人独自，望江南回雁归云急。\n凭付与，锦笺墨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霓裳中序第一","author":"应法孙","text":"愁云翠万叠。\n露柳残蝉空抱叶。\n帘卷流苏宝结。\n乍庭户嫩凉，阑干微月。\n玉纤胜雪。\n委素纨、尘锁香箧。\n思前事、莺期燕约，寂寞向谁说。\n悲切。\n漏签声咽。\n渐寒灺、兰缸未灭。\n良宵长是闲别。\n恨酒凝红绡，纷涴瑶玦。\n镜盟鸾影缺。\n吹笛西风数阕。\n无言久，和衣成梦，睡损缕金蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 江路野梅香","author":"应傃","text":"横斜淡月黄昏，漏泄早春消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"应傃","text":"嘉木灌丛春意好，可怜不种紫荆花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"它山堰","author":"应煟","text":"十里犹闻震地雷，海神惊惧勒潮回。\n游人只爱山川好，一饱因谁惠得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张一斋","text":"忘却芦花丛里宿，起来误作雪天吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月八日偶成 其三","author":"张九成","text":"庭院无端作许寒，好花无处压栏竿。\n东君今岁知何意，勒住群花不得看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月八日偶成 其二","author":"张九成","text":"春寒渗渗越常年，桃李枝间尚悄然。\n数日长阴君莫叹，人人道是养花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月五日","author":"张九成","text":"阴阴帘幕作轻寒，蔌蔌花飞已满栏。\n困思不忺尝美酒，却怜山色倚栏看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月六日出城","author":"张九成","text":"春来多病懒寻山，送客今朝漫出关。\n杨柳江头无限思，欲携樽酒煖衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕","author":"张九成","text":"前年元夕宴谯门，万朵红灯闹早春。\n谁谓今宵顿寥落，长天独拥一冰轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵","author":"张九成","text":"万叠灯山辊绣毬，怕寒骑马著驼裘。\n要看十里红莲满，须上谯门最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十二日偶成 其一","author":"张九成","text":"閒居百事不关心，只有多情尚苦吟。\n午睡觉来何所乐，邻鸡一唱柳垂阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡","author":"张九成","text":"深杏小桃暄午昼，游丝飞絮搅长空。\n觉来一枕轩窗静，燕子双双西又东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆天竺桂","author":"张九成","text":"湖上北山天竺寺，满山桂子月中秋。\n黄英六出非凡种，肯许天香过别州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆北轩菊","author":"张九成","text":"长忆故园秋色好，满篱霜菊炫宫黄。\n无聊却向横江畔，笑倚西风觅暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丙寅正月","author":"张九成","text":"常年正月未全春，春色今年辄去人。\n试上小楼南北望，红英满地绿粼粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]