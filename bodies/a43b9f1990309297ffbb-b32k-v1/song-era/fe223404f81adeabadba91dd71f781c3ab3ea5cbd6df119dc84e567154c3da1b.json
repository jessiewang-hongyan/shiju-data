[{"title":"和张文潜晚春 其一","author":"徐积","text":"留春是芳草，送春宜柳花。\n日长花正乱，谁倚阑干斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张文潜晚春 其二","author":"徐积","text":"问花开何迟，问花底急飞。\n人閒惜花少，阆苑等花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张文潜晚春 其三","author":"徐积","text":"易贮千寻水，难藏一点春。\n也须几杯酒，还似送行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张文潜晚春 其四","author":"徐积","text":"渡水衣须扱，穿林手自披。\n经春脚力软，但恐上山迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二老寄朱广微 其一","author":"徐积","text":"二老相思又隔年，僧窗閒坐复何缘。\n吟翁最好盐城住，时把歌诗付酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二老寄朱广微 其二","author":"徐积","text":"寄声切问朱监利，对面勤询刘贵池。\n或见广东程使者，为言收得寄来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曾子开","author":"徐积","text":"扬子江头风正寒，行人莫叹渡头难。\n江头杨柳岂常在，但向江头洗眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送慎彦邻","author":"徐积","text":"只知北海鹏将化，不谓丹山凤正栖。\n却忆吴江桥上月，共君长啸入云霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈舒信道","author":"徐积","text":"淮干风起木枝摇，颔下瓷瓯一尺高。\n我是折薪扶耒手，中丞且莫笑粗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈张敏叔","author":"徐积","text":"子善居官事可宗，淮西声誉接淮东。\n皆知所识明无敌，两主斯文敏有功。\n丽赋总应输老匠，清诗恰好送秋风。\n便乘急棹辞谯守，酌酒仍吟塞上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠探花郎","author":"黄裳","text":"探花车骑似游龙，未入桃源先阆风。\n衫上十分新染翠，衣间一点半开红。\n身如骥子无双俊，人报鳌山第几宫。\n便是醉仙何处去，上林园在五云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕秘校","author":"徐积","text":"淮上诗盟不可寻，诗筒来往负初心。\n风花雪月虽无限，留待他年共子吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠余进士","author":"徐积","text":"江南风物清温好，关内河山气势雄。\n更看蜀中山水秀，一时兼取作吟翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王潜圣","author":"徐积","text":"谁言急景似飞梭，我把光阴欲快磨。\n却想残春笑君处，无何有路觅君多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答范君锡","author":"徐积","text":"有人惠我一枝花，五彩妆成千万葩。\n蜀纸写诗酬国艳，吴瓶汲水贮香霞。\n半酣酒色从人赠，尽带春风入我家。\n醉倒吟翁君不见，儿童偷与插乌纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上胡先生","author":"徐积","text":"昨夜重思太古音，确然独抱一张琴。\n因何不听吾夫子，枉被雕虫累到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和潘朝奉","author":"徐积","text":"大人高调我旁酬，韵欲更时更少留。\n待学鸾歌声已嗄，将追骥乘老而遒。\n晓随帆去云连海，莫望潮来月满洲。\n须道诗翁非世俗，年家情义几时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其一","author":"徐积","text":"董子书帏正寂寥，阮君何事顾吾曹。\n两篇有若双琼赠，八句多于一字褒。\n莫恨潘安头早白，须知郢客调弥高。\n鸾凰岂是尘埃物，待看青云振羽毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其二","author":"徐积","text":"王子如今未梦刀，不须感慨论官曹。\n寝郎悟意犹为相，鄠尉知名固可褒。\n嗟尔岁华何太速，顾予儒业若为高。\n四诗已有重笺意，肯学区区郑与毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其三","author":"徐积","text":"东平心事本雄豪，何必才名独慕曹。\n学比今儒醇且奥，诗如古义刺而褒。\n邹之夫子诚堪叹，霸者将军未足高。\n贤杰固当谋远到，莫论山岳与鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其四","author":"徐积","text":"能建功名是俊豪，区区时辈乃儿曹。\n班超投笔宁无志，樊哙横行谢见褒。\n兵法每羞孙膑诈，将才惟爱武侯高。\n他年不负东平约，待假偏师入不毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其五","author":"徐积","text":"我谓君才似楚骚，文章自可作清曹。\n但持古道徐而待，莫顾时人毁与褒。\n水以源深流自远，竹因根老节弥高。\n如今且作东山卧，万事纷纷比一毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其六","author":"徐积","text":"东平夫子困徒劳，又著青衫诣选曹。\n州县颇闻舆论屈，朝廷当用诏书褒。\n囊中莫把诗编去，辇下方虞纸价高。\n曼倩若教为近侍，舍人须愧古无毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其七","author":"徐积","text":"方今天子急贤时，不信王通愿已违。\n梅福九江虽好遁，陶公八翮亦难飞。\n世排韩愈为文僻，客顾扬生载酒稀。\n多谢好诗来赠我，晓斋歌诵暮而归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其八","author":"徐积","text":"汾上儒生又续诗，阳春巴调本相违。\n聊因扣角摅深愤，安得摩天逞快飞。\n陶氏弄琴乖俗甚，井丹持刺出门稀。\n有时入市谋甘脆，怀橘携壶即便归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其九","author":"徐积","text":"太平儒者好吟诗，鼓腹而歌事岂违。\n顾我才华常患少，喜君辞翰动而飞。\n不忧陋巷箪瓢罄，惟恐兰亭唱和稀。\n更约山翁同一醉，梅花将谢燕将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕秘校 其十","author":"徐积","text":"吾道穷通自有时，功名岂便与心违。\n摩天未逐溟鹏奋，敛翅尚如篱鶠飞。\n鸣凤卜迟君莫笑，玉山醉倒事何稀。\n梅花将谢剩沽酒，待向花前倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠蔡子骧二子","author":"徐积","text":"凤子能双举，新从日下回。\n日边是云雾，却带越书来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答崔汝弼","author":"徐积","text":"忽对苍髯叟，谁吟老柳枝。\n岂无解印日，兼是省官时。\n子实安于命，吾何戏以诗。\n如能少施设，亦可慰余思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答魏老 其一","author":"徐积","text":"满面春风醉落晖，满头红艳带花归。\n醉眠自有风流格，不是无人为解衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答魏老 其二","author":"徐积","text":"一片山中云自飞，葛巾有酒琴无徽。\n陶公自是秋风客，不见黄花未肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杨存中","author":"徐积","text":"出郭人来又换诗，七香官酒杏花枝。\n我诗却恐春风惜，莫使春风度度知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢张先生出示铁笛","author":"徐积","text":"南阳张老本仙才，铁笛其形亦怪哉。\n辄莫片时吹便已，凤凰非独待箫来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其一","author":"徐积","text":"身虽老矣心弥壮，义必为之世所谙。\n新著绣衣行殿内，又骑骢马使淮南。\n升堂避席非常礼，就室迂身共燕谈。\n更问熊熊与老老，应咍稚女拜而参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其二","author":"徐积","text":"一从缙笏垂绅后，所至官曹不苟拘。\n皓首积成高世义，赤心倾在逆鳞书。\n温如冬日人之望，严载秋霜使者车。\n以爱以威无不济，恩从城市入田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其三","author":"徐积","text":"衰翁大半白髭须，活到明年六十馀。\n未死须为治河说，此生难就赈饥书。\n西庵共坐诸僧榻，南郭亲逢大使车。\n记得偶同诗韵否，淮东使者亦嗟歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其四","author":"徐积","text":"老身如坐白云山，人日登高我自閒。\n莫道此心无乐事，未知何日有愁颜。\n月将寒影投书幌，菊遣秋香过竹关。\n悔不醉时篱下卧，和花和蕊一时攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其五","author":"徐积","text":"闭门老子卧游山，心去穿云身自閒。\n平地散仙曾有号，坐曹为吏亦何颜。\n吟诗著屐都无齿，探月开门更不关。\n酒后爱逢花后发，花枝好向醉中攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其六","author":"徐积","text":"老怀秋思各思山，绿发儿童事事閒。\n感物但搔头上雪，呼人莫笑镜中颜。\n篮舆自可来尝酒，芒屐犹能去渡关。\n玉井有花高百尺，秦王宫女许谁攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其七","author":"徐积","text":"三叹枉教陪一唱，诗仙争肯伴樵夫。\n金刀刮尽尘埃气，玉水洗成冰雪肤。\n涸胃已惭搜思竭，乾喉兼觉出群粗。\n馀篇只等功成后，留和棹歌寻五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其八","author":"徐积","text":"两人外迹本相疏，何故孤孤为病夫。\n未报已惭公面目，有情顾入我肌肤。\n将身荷负嫌躯小，引臂镌镕要骨粗。\n尽力吟哦吟不尽，此时寒雨满淮湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上林殿院次公 其九","author":"徐积","text":"林氏家藏万帙书，五船便可当五车。\n别顾客舟施坐榻，更谋官舫作行厨。\n写时教子烘青竹，读处呼童捉蠹鱼。\n悔不早知都借取，终身挟策灌园蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄顾龙图","author":"徐积","text":"龙图莫怪白须翁，依旧閒吟閒笑中。\n未有梅花充信物，但将竹简换诗筒。\n子如行路真无巧，我信居山养有功。\n气类相从应得士，并州兼有傅元通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张子中","author":"徐积","text":"时辈区区耳尽聋，姓张夫子在关中。\n孤松节操乖今俗，独凤文章得古风。\n至宝却须三献捷，病鸾终看一飞雄。\n儒家自是诗书将，又况潜心郭令公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过故乡","author":"徐积","text":"不似严生乞会稽，一身名义总无非。\n何须佩印如金斗，若论还乡胜锦衣。\n行处眼前新事满，坐来门外故人稀。\n有时载酒寻闾巷，认得当年老父归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少年行","author":"徐积","text":"车马朝游去，笙歌暮宴归。\n绣帏初睡起，红日上帘衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠李通直","author":"徐积","text":"昨见君家父祖碑，德功俱茂节多奇。\n初终义正今难有，积累源深后可知。\n但得名为骐骥子，何须身到凤凰池。\n其先付予皆良法，随所居官任设施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄范君锡","author":"徐积","text":"人事大难知，悲欢与合离。\n忽惊残腊尽，还忆去年时。\n对雪我无酒，招沽子有诗。\n春深相赠物，花共绿杨枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崔汝弼 其一","author":"徐积","text":"黄艳花前白颔翁，忆君诗思入霜风。\n如今相去犹未远，明年把酒望江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崔汝弼 其二","author":"徐积","text":"除却行吾义，其他任自然。\n胸中清水溜，颔下白毛鲜。\n别我未逾月，思君似隔年。\n北轩翁在此，曾醉菊花边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崔汝弼 其三","author":"徐积","text":"不见吾崔子，南城两度春。\n应从湘水梦，来就泮宫人。\n壮气胸中旧，衰毛颔下新。\n明年六十六，望子过淮滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崔汝弼 其四","author":"徐积","text":"数幅长沙纸，慇勤为写怀。\n知公富情义，念我老形骸。\n处世日无几，归耕计未谐。\n若论身后事，贱骨要深埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄裴守","author":"徐积","text":"高丽亭下张帆日，引首将心送画船。\n本恨无因到夔国，谁知有梦向澶渊。\n情逾旧物非徒尔，义等高山合使然。\n料得政成公事少，冬温常在北堂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠卢君常","author":"徐积","text":"人世情怀已索然，幸无不义入黄泉。\n不须永诀行相见，六十三翁能几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君向潇湘我向秦","author":"徐积","text":"我望秦关方整驾，子如湘水欲登舟。\n马嘶山坞谁家宿，缆系江枫何处留。\n垄上耕随残月去，日边帆带落霞收。\n灞陵古恨骚人意，歌向樽前不易酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄朱广微","author":"徐积","text":"两官本是好吟翁，云出山来鹤入笼。\n记得僧轩閒坐否，无人到处水边鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答白云之句 其一","author":"徐积","text":"我是白云云是我，自知云我不须分。\n时人若问山翁意，看取山头一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答白云之句 其二","author":"徐积","text":"朝共白云行，暮共白云归。\n眠时云亦眠，以云为寝衣。\n白云白云常在身，有时忽共白云分。\n君看天外逍遥物，便是山翁身上云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菊花","author":"徐积","text":"为汝花中开最孤，诗翁何惜屡提壶。\n却应有意酬青眼，浑似倾心向白须。\n击铜钵时吟更好，掷金钱后醉相娱。\n杨妃只有黄裙在，且问风霜留得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示诸君","author":"徐积","text":"古俗今时不用分，只将虚实判浇淳。\n养心有要先除伪，入德无难只用真。\n此道若从为得路，他歧如往是迷津。\n我曹好尚虽迂阔，最爱山夫共野人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妾薄命 其一","author":"徐积","text":"偷把罗衣裛泪痕，落花江上泣青春。\n空将凤管题君怨，自是蛾眉累汝身。\n翠黛不须匀绿鬓，红膏休更点朱唇。\n自然彼此无心妒，犹恐多言巧中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妾薄命 其二","author":"徐积","text":"春深江浦流还涨，雨后山花落更多。\n举目未言先有泪，当樽欲唱不成歌。\n心知自古皆如此，事到如今不奈何。\n莫向夕阳楼上望，几人遗恨满烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妾薄命 其三","author":"徐积","text":"将身误入楚王宫，负却家山事总空。\n枕上无言吟夜雨，花前有泪洒春风。\n假饶醉饱朱门内，岂似寒饥漏屋中。\n更有文君作奔妾，争如寂寞嫁梁鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妾薄命 其四","author":"徐积","text":"女子恩雠事可知，我曹何用吊吴姬。\n如斯才貌如斯苦，也似贤人被妒时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玺书长句","author":"徐积","text":"随船父老踏青莎，人各持杯奈醉何。\n谣俗恋恩成太息，吟翁乐义合长歌。\n皆知察物严而恕，谁似当官正不阿。\n东汉武威任郡守，至今高义耸峨峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑶真诗 其一","author":"徐积","text":"此花所在宜开馆，彼玉维瑶合比君。\n每到黄昏成淡月，却临晓后作团云。\n人閒伪采何如质，物里孤芳自胜群。\n应笑马嵬坡下女，太真为号系黄裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑶真诗 其二","author":"徐积","text":"不知记得瑶林否，故国曾陪阆苑春。\n色貌易分浑是正，性情虽辨总归真。\n红尘世上无双物，白雪宫中第几人。\n若问谁何名玉女，一般严静敌霜神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏慎郎中园木香","author":"徐积","text":"仙子霓裳曳绀霞，琼姬仍坐碧云车。\n谁言十日春归去，犹有春风在慎家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天下风流无绿杨","author":"徐积","text":"天下风流无绿杨，半遮妆面出宫墙。\n客醉任铺红锦段，马嘶争系紫丝缰。\n上东门外我回首，长乐坡头谁断肠。\n最好春深山下路，乱花薰与一身香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谁把閒愁付绿杨","author":"徐积","text":"谁把閒愁付绿杨，我疑浑是别离肠。\n每教啼鸟呼春色，更共平芜送夕阳。\n山下人行云惨惨，渡头船去水茫茫。\n高楼亦有思归客，莫望天涯寻故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]