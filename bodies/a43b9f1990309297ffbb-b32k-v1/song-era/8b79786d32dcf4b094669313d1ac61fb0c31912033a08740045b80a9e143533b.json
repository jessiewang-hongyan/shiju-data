[{"title":"五老 其三 老农","author":"宋伯仁","text":"齿发俱无背已驼，雨耕摩破几青蓑。\n高皇庆寿推恩诏，暗读全文忘不多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老 其四 老渔","author":"宋伯仁","text":"短发衰髯一棹船，白头波浪几掀天。\n儿孙各占芦花住，网得鲈鱼即酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老 其一 老儒","author":"宋伯仁","text":"壮年期佐汉中兴，岂谓蟠螭睡不醒。\n可惜满床廷对稿，白头翻录道家经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老 其五 老女","author":"宋伯仁","text":"著破箱中欲嫁衣，翠颦何止只忧葵。\n春来偷摘斑斑发，泪湿菱花只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无事","author":"宋伯仁","text":"日日溪头看好山，尘嚣无一可相关。\n梅花未必能如我，花谢花开未得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题","author":"宋伯仁","text":"落花帘箔雨垂垂，重念长亭折柳时。\n人在一犁春水外，此情唯有鹁鸠知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水边闻雁","author":"宋伯仁","text":"芦花新有雁，四面水连天。\n清净非人世，吾诗咏不全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归渡柴墟江口","author":"宋伯仁","text":"白头浪里叶舟轻，全靠樯桅寄死生。\n唯有青山无一事，不忧风雨不忧晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧同官张法曹","author":"宋伯仁","text":"熬波同看楚天秋，多少艰难说未休。\n今日共依湖柳住，梦中犹怕踏边头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉泉寺金鱼","author":"宋伯仁","text":"金鳞韬隐已多时，寺壁重泥又有诗。\n龙若久怀霖雨志，不应蟠屈小方池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"买笺纸","author":"宋伯仁","text":"丁宁黄帽入苏州，吉利桥边泊小舟。\n买得吴笺才可去，诗成免得向人求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"农家","author":"宋伯仁","text":"茅屋三间槿作篱，白头婆子葺冬衣。\n儿童饱饭黄昏后，短笛横吹唤不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寻孙花翁","author":"宋伯仁","text":"东风吹雨湿西湖，未许苏堤酒剩酤。\n试向花翁问花讯，不知花似去年无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏作","author":"宋伯仁","text":"青梅黄尽雨无多，柳影重重午日过。\n忽听隔篱人语笑，采莲艇子上新河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州骑鹤楼","author":"宋伯仁","text":"醉倚阑干独黯然，淮南不比数年前。\n只宜跨鹤翩然去，休说腰缠十万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早秋","author":"宋伯仁","text":"秋天一饷晚风凉，笑语人传早稻香。\n楼上醉时帘半捲，愁添客鬓两苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"宋伯仁","text":"窗户清清半掩门，小儿揩泪立黄昏。\n几多心事无人问，独看梅花月半痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"羊角埂晚行","author":"宋伯仁","text":"葛裙蒲履帽乌纱，迤逦乘凉到水涯。\n数寺晚钟声未歇，满身明月看荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中九日","author":"宋伯仁","text":"巴得重阳未到家，短篷根底忆黄花。\n乌纱不为西风舞，空与同舟说孟嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西津渡","author":"宋伯仁","text":"掀天雪浪镇三边，亿万王师未必然。\n可惜大江如旧日，苦无人著祖生鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖晚归 其二","author":"宋伯仁","text":"风力尖纤酒力微，重添脱下薄绵衣。\n心忙愈觉苏堤远，趁得渔船载得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖晚归 其一","author":"宋伯仁","text":"一轮红日倚青山，只在湖光数里间。\n听得画船人说道，钱塘门到夜深关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观书","author":"宋伯仁","text":"一篝灯影夜窗寒，静展青编子细看。\n会得圣贤千古意，不须场屋苦求官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观寺中盂兰盆会有叹","author":"宋伯仁","text":"欣欣来认祖先名，梵杵丁东月二更。\n满地纸钱香篆冷，更无真哭两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访高菊涧","author":"宋伯仁","text":"可惜吴中不见君，短篷空载一溪云。\n知君已到孤山下，日日梅花酒半醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问梅","author":"宋伯仁","text":"痴风衮衮送寒来，竹里人家总未开。\n唯有老岩心事苦，瘦筇敲雪问梅腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别友人","author":"宋伯仁","text":"菊花村晚雁来天，同住兰舟未十年。\n今日送君须尽醉，离人独上洞庭船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别妻","author":"宋伯仁","text":"又买扁舟又客游，泪痕羞染黑貂裘。\n西风庭户从潇索，莫把黄花当我愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨","author":"宋伯仁","text":"冻雨潇潇未肯晴，洒窗声似煮茶声。\n山童酤得邻家酒，炒栗炉头独自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江四桥","author":"宋伯仁","text":"不独吴江第四桥，风波处处险如潮。\n人心但得平如水，浪自滔天橹自摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忘机","author":"宋伯仁","text":"我以沤为我，沤为我即沤。\n非沤亦非我，机事两忘不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村","author":"宋伯仁","text":"又是江南割稻天，家家儿女笑相牵。\n芙蓉占断清溪水，独许渔人醉舣船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村田乐","author":"宋伯仁","text":"打稻天如二月天，满村和气乐丰年。\n田翁烂醉身如舞，两个儿童策上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村姑二首 其二","author":"宋伯仁","text":"底事蹉跎二八年，嫁时装著未周旋。\n年年织得新丝绢，又被家翁作税钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村姑二首 其一","author":"宋伯仁","text":"翠鬟双妥未梳头，纺纬车边坐欲羞。\n几度采桑归较晚，阿娘疑看落花愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村学究","author":"宋伯仁","text":"八九顽童一草庐，土朱勤点七言书。\n晚听学长吹樵笛，国子先生殆不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸鹞","author":"宋伯仁","text":"弄假如真舞碧空，吹嘘全在一丝风。\n唯惭尺五天将近，犹在儿童掌握中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远访友人不值","author":"宋伯仁","text":"寒食花枝插满头，长亭搔首晚悠悠。\n灞陵老子无人识，别是天涯一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和浙东童仓使建昌家圃梅花玉雪亭诗三首 其三","author":"宋伯仁","text":"黄昏约略酒醒时，塞管何烦特地吹。\n是则调羹消息早，不妨留伴月钩垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和浙东童仓使建昌家圃梅花玉雪亭诗三首 其二","author":"宋伯仁","text":"云绕疏篱水绕亭，主人清处著梅清。\n虽然借得坡翁意，人与梅花更有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和浙东童仓使建昌家圃梅花玉雪亭诗三首 其一","author":"宋伯仁","text":"要识生涯便有涯，暗香丛里作人家。\n纷纷红紫休相角，别是春风一样花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"宋伯仁","text":"柏香烟里瀹山茶，穷似烧丹道士家。\n窗纸渐明寒月上，一肱清梦入梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学馆閒题","author":"宋伯仁","text":"据见定时俱是足，苦思量处便成痴。\n请君打退閒烦恼，啜粥烹茶细和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中远望","author":"宋伯仁","text":"山匝浓云水匝天，秋容黯淡荻花边。\n潇湘八景谁收去，留下波心小钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勉吟者","author":"宋伯仁","text":"诗不穷人穷乃工，蹇驴宜立灞桥风。\n安排两个推敲字，岂在梨花院落中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴","author":"宋伯仁","text":"风淡帘栊花弄影，雨馀池馆燕争泥。\n春光去就轻如叶，一任声声杜宇啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残菊","author":"宋伯仁","text":"黄华十月愈风流，不把重阳作话头。\n昨夜满林霜似雪，笑他红叶冷飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看邸报","author":"宋伯仁","text":"朝家日日有迁除，休说人才愧国初。\n岩穴几多茅盖屋，安知不是孔明庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋田小立","author":"宋伯仁","text":"两间茅屋是谁家，浅水汀洲舞荻花。\n牧笛数声红日晚，自惭身世客天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋花","author":"宋伯仁","text":"凤儿花杂雁来红，更有鸡冠弄紫茸。\n可笑倚阑人醉后，只将青眼看芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送马廿七秀才归小枯村","author":"宋伯仁","text":"轻轻飞絮扑花枝，喜傍兰亭说旧诗。\n君去小枯应为我，细看山带晚晴时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻角","author":"宋伯仁","text":"晓角经秋每厌听，那堪和月在边城。\n从来只说梅花引，未识梅花曲外声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦吟","author":"宋伯仁","text":"竞病推敲欲呕心，何如危坐拆桐阴。\n新蝉咽咽知人意，学我年来抱膝吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凉","author":"宋伯仁","text":"不拟西风一顿凉，看看凉近木樨香。\n人家未得征夫信，蚤有砧声怯雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日 其二","author":"宋伯仁","text":"泓泓圆碧漾新荷，猎猎斜风颤绿莎。\n农事正忙三月后，野田齐唱插秧歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日 其一","author":"宋伯仁","text":"满庭新绿午阴阴，风弄疏帘雨弄晴。\n窗下岸书眠一觉，不知人世有公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日 其三","author":"宋伯仁","text":"数点沙鸥掠野塘，雨声初歇水微茫。\n桥边十里荷花荡，输与渔人卧晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"家书","author":"宋伯仁","text":"未得还乡泪欲珠，一书封了又踌躇。\n家人会得征夫意，门外西风即是书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扇","author":"宋伯仁","text":"师璋今有几家同，名重蒲葵价亦穹。\n髹柄但誇千缕骨，不知曾未掩西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶梅","author":"宋伯仁","text":"南枝斜插古军持，瘦影参差落砚池。\n莫道人家窗户暖，等閒忘却陇头时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留春","author":"宋伯仁","text":"春事无多始得晴，江头才有丽人行。\n柳丝绾住东风脚，落尽桃花去未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离维扬","author":"宋伯仁","text":"不为鲈鱼忆故乡，只缘心事近重阳。\n鬓丝添得三分白，空被黄花笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷包鲊","author":"宋伯仁","text":"买得荷包酒旋沽，荷包惜不是鲈鱼。\n鲈鱼不见张翰辈，自向沧波隐处居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读林可山西湖衣钵","author":"宋伯仁","text":"梅花花下月黄昏，独自行歌掩竹门。\n只道梅花全属我，不知和靖有仍孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得石刻戏书","author":"宋伯仁","text":"兰亭墨妙总非真，石鼓遗文字亦湮。\n更有断崖刊诅楚，辽哉千载笑亡秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春二首 其二","author":"宋伯仁","text":"绿阴阴里惜韶华，自缚筠梢扫落花。\n可笑游人心未懒，杜鹃啼处拨琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春二首 其一","author":"宋伯仁","text":"风甃残花满地红，别离樽俎谩匆匆。\n春光未肯收心去，却在荼蘼细影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春溪行","author":"宋伯仁","text":"青山数里一溪横，片片花边舞燕轻。\n耕遍水田新雨足，晴天晓色柳风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚凉","author":"宋伯仁","text":"两两蝉声送夕阳，竹阴移绿上藤床。\n黄昏急雨无多子，喜得今宵梦亦凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅兰","author":"宋伯仁","text":"清标同插古军持，清似西山冻馁时。\n嚼蕊弄香无说处，屈平和靖已何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其九 大开一十四枝","author":"宋伯仁","text":"郏鄏至汾阴，重名垂不朽。\n天下望调羹，有谁能著手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十四 大开一十四枝","author":"宋伯仁","text":"相见是非多，但旁观便了。\n庶无人共知，鼻孔长多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十二 大开一十四枝","author":"宋伯仁","text":"一声长啸处，霜月凄林扉。\n与鹤每相问，贵人胡未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其五 大开一十四枝","author":"宋伯仁","text":"九华并六角，流传名不同。\n无如慰黎庶，为我扬仁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其八 大开一十四枝","author":"宋伯仁","text":"仙掌在何处，徒成千载羞。\n唯有故园菊，沾濡当九秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其四 大开一十四枝","author":"宋伯仁","text":"五更山外鸣，斗低残月小。\n唤起利名人，仆仆浑无了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十 大开一十四枝","author":"宋伯仁","text":"堂下杂?鼗，如钟而罄腹。\n夫子闻于齐，三月不知肉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其十一 大开一十四枝","author":"宋伯仁","text":"麀鹿同呦呦，山林风雨秋。\n姑苏台上月，子胥曾约游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其五 大蕊八枝","author":"宋伯仁","text":"中尊严祀典，鬯未祼而实。\n将祼而实彝，礼文知有秩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花喜神谱 其四 大蕊八枝","author":"宋伯仁","text":"曳颈吟松梢，何异扬州鹤。\n胡为鹤未成，苦被玄裳错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]