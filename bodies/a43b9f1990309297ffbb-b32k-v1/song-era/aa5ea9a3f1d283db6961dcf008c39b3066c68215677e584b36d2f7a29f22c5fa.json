[{"title":"上虞相行春口号十首 其七","author":"王质","text":"云空玉宇降重重，匣面双蟠小戏龙。\n夹路繁花香到骨，不如天上紫芝封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其八","author":"王质","text":"暗黄退柳绿厌厌，长与行人驻别筵。\n傅说归朝天下雨，不如休系相公船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其九","author":"王质","text":"娇风悄悄日晶晶，只见花光不见尘。\n行过津头旗转脚，万波吹动碧鳞鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其十","author":"王质","text":"遥指吴天背蜀云，峡波小绿作微皴。\n西州寒食清明了，犹见檀心上苑春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效竹枝体有感四首 其一","author":"王质","text":"来时梅花绕路旁，祇今压枝梅子黄。\n回思孤径踏斜月，冉冉马头迎晓香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效竹枝体有感四首 其二","author":"王质","text":"石桥直下桨双横，落叶渐低湖水生。\n归心欲寄潮头去，潮头不肯过湓城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效竹枝体有感四首 其三","author":"王质","text":"斜风急雨暮潇潇，更与客怀增寂寥。\n树头梅子未全熟，莫来窗下打芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"效竹枝体有感四首 其四","author":"王质","text":"江南烟雨梅子肥，稻针刺水青离离。\n江南风物亦如此，所恨情怀非昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即事","author":"王质","text":"桃李阴阴子满枝，春心密意两忘机。\n无何一点流莺过，惊动杨花簌簌飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊荻港二首 其一","author":"王质","text":"落日人家已半扉，隔篱问答语声微。\n桑枝亚路蝉争噪，一似南村割稻归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊荻港二首 其二","author":"王质","text":"野火参差度暗光，萧萧蒲稗自生凉。\n夜深云上无星斗，古树阴沈觉许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次虞枢密九日登高韵","author":"王质","text":"满拟重阳醉菊觞，花时多已过重阳。\n年来莫是无知己，未遇渊明不肯香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问王稚川借其父承可诗二首 其一","author":"王质","text":"侍郎墓槚已苍苍，万古江河一锦囊。\n杜老平生怜骥子，不将衣钵付他郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问王稚川借其父承可诗二首 其二","author":"王质","text":"百代风流集豫章，娟娟各自作时妆。\n谁知索虎钩鲸手，传到黄家便到王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐起赠范西叔何子方","author":"王质","text":"浓淡云中月吐吞，寒枝惊叶动乌蹲。\n青荧一点无人对，赖有西风为掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠李时雍","author":"王质","text":"平生饱识世间愁，牢落江南尽处州。\n插架有禾三百把，与君来往亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集秦国文恭公句寿胡正仲四首 其一","author":"王质","text":"绛霄别有大罗天，钧奏声沈帝所闲。\n岁晚政成丹诏下，水苍朝佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集秦国文恭公句寿胡正仲四首 其二","author":"王质","text":"玉蟾濡翰待君挥，五世嘉占得凤飞。\n朝野多驩天子圣，便应调鼎向黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集秦国文恭公句寿胡正仲四首 其三","author":"王质","text":"君在东南第一流，绿绨膺检出神州。\n举头试作长安望，昨夜灵槎近斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集秦国文恭公句寿胡正仲四首 其四","author":"王质","text":"三殿觚棱照綵霓，星邮传诏紫芝泥。\n休论万里封侯事，此去青云别有梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其一","author":"王质","text":"此州斗大故为悭，金印如之足解颜。\n他日低头看屈肘，亦思王老住胡湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其二","author":"王质","text":"元素当年会子瞻，山三百叠故依然。\n风流文采徐杨并，所欠宾朋似往年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其三","author":"王质","text":"君玉风标世所希，日临小阁瞰清池。\n君来已隔元丰梦，鹭静鱼寒尚往时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其四","author":"王质","text":"一陈一叶此横飞，飞到清霄总不迟。\n东海月轮今又满，履綦安稳上丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其五","author":"王质","text":"吾知昭德眼通明，君与渠家最有情。\n何况蜚声满黄阁，定应倒屣笑相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其六","author":"王质","text":"君到长安见侍郎，定咨老子鬓毛苍。\n为言薜荔藤边事，一局棋收又一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其七","author":"王质","text":"文康伯仲见昌黎，传到云孙又过之。\n君见小坡应记忆，近香亭下啜茶时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其八","author":"王质","text":"东望苕溪想月卿，尚怀泉石养精神。\n倘于归雁亭边见，为道阳关有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其九","author":"王质","text":"宝溪同社两齐年，一落江湖一上天。\n试问吾兄应好在，何时再拜玉阶前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐圣可十首 其十","author":"王质","text":"卷雪楼前欲放船，沧浪亭上且扶肩。\n他时一月同千里，江汉吴淞共拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠画工","author":"王质","text":"我无头上进贤冠，祇带儒生一味酸。\n愿向笔端求蒻笠，桃花春水把渔竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄峡石老人","author":"王质","text":"白沙渡口见须眉，袖角槎牙出好诗。\n愿得扬舲秋水去，共看明月堕琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题大浩寺","author":"王质","text":"漫山竹树结清深，古殿荒寒一两灯。\n但有菜根随粥饭，老夫请作住持僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题真如寺","author":"王质","text":"旧红新绿都如许，尘世何曾有定春。\n晚渡野航冲雨去，今朝佳处总吾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月下看古碑唐贞元间物也","author":"王质","text":"泥土相缠四百年，摩挲十在九彫残。\n明朝叉手东西去，更有谁人月下看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题李白笠钓图","author":"王质","text":"龙子梅妆钓笠前，脱靴豪气总萧然。\n一丝来往茫茫碧，不记开元后几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其一","author":"王质","text":"栗里柴桑事事无，但言吾亦爱吾庐。\n扫开秋草门前路，恐有观潮访后湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其二","author":"王质","text":"深衣缁缘古风标，不用横飞上九皋。\n且伴寒泉荐秋菊，水仙王亦是吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其三","author":"王质","text":"蒲稗蒹葭密拥门，无风亦自有秋声。\n烟尘齐鲁今何在，下雉阳新有两生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其四","author":"王质","text":"山澹云浓间有无，数牛鸣外接匡庐。\n甘楼亦有鸱夷老，左右盆山即五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其五","author":"王质","text":"瘦水微皴渐复槽，秋枫脱叶下江皋。\n王杨卢骆青冥上，不废江河废尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题窦伯山小隐诗六首 其六","author":"王质","text":"秋草空繁不识名，秋蒲虽脱尚能声。\n君行爱护青鞋底，行到山空恐路生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题薛公肃西湖问梅图二首 其一","author":"王质","text":"茅屋荒寒篝影昏，口心相应共花论。\n山桥野渡香凌乱，君在江南我剑门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题薛公肃西湖问梅图二首 其二","author":"王质","text":"人眼心花总不昏，细从烟外月中论。\n孤山疏影横斜处，今有珠楼锁翠门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中题石母洞前潭中玉犀石","author":"王质","text":"玉犀玉犀是何物，白玉麟蹄水晶骨。\n珠宫贝阙不胜寒，夜来走出蛟龙窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄制干坐上题墨竹扇","author":"王质","text":"自有清风风不吹，虽无明月月相随。\n此君不可无一日，奈有霜寒露冷时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄少誉绿萼梅","author":"王质","text":"绿毛么凤仰衔花，不在山椒即水涯。\n昔日鬓边能似此，春愁磨尽总成华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问查元章觅龙团茶","author":"王质","text":"戏龙顿断天门锁，来蛰公家片段箱。\n恐有堕髯收不尽，觅来惊起雁凫行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵谢元章惠茶二首 其一","author":"王质","text":"吾夜轻行过故乡，不知箭栝与车箱。\n清风一点吹灵府，梦断江南白鹭行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵谢元章惠茶二首 其二","author":"王质","text":"白日腾腾睡醉乡，尘丝撩乱罥巾箱。\n从令易趁翻书课，满眼精神下五行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁丞盖岭长松三首 其一","author":"王质","text":"强名呼作大夫官，亘古摩空不免冠。\n但惜五封遭一点，宁如深岭撼风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁丞盖岭长松三首 其二","author":"王质","text":"露边稚叶亦堪餐，霜后皴皮更可冠。\n抚此盘旋不忧晚，但忧栗里酒樽寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和袁丞盖岭长松三首 其三","author":"王质","text":"百滩飞度半云端，波浪声雄不湿冠。\n亸袖垂鞭徐进马，市尘无此雪风寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李无变与诸公出郊访王彦博","author":"王质","text":"病来无力胜鞍马，不得兰亭共一觞。\n射雉如皋犹不笑，散花方丈锦千张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李无变求诗","author":"王质","text":"十年惨淡经营处，一点青荧灯火知。\n平日诗从天外得，只今天外总无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和秋日即事韵二首 其一","author":"王质","text":"駮駮山苍杂水红，不如冷眼看秋风。\n北鸿已望江南起，飞过榆林月正中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和秋日即事韵二首 其二","author":"王质","text":"初枫叶外数行飞，瘦竹竿头一点黐。\n浮世危机总如此，青蛇飞处且相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"千叶梅","author":"王质","text":"一枝独立众芳先，小翠长红一任妍。\n缟袂仙人来阅世，向来手眼故千千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"王质","text":"我不疏君君自疏，此君于我定何如。\n中庭明月常常在，卷地风来不扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"合欢扇","author":"王质","text":"明月虽圆有缺时，合欢安有百年期。\n故令六六深宫女，泪落君前自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九华扇","author":"王质","text":"玉斧修成玉兔宫，萧萧无日不秋风。\n九华紫翠腾空起，取次拈来在掌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纱扇","author":"王质","text":"八字回环字字精，一规孤月半铢轻。\n只应来自鲛人室，风动犹闻细浪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄鹄扇","author":"王质","text":"摩尽青云到紫微，玉城风露冷霏霏。\n政令同落生绡上，亦胜空梁一燕飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹扇二首 其一","author":"王质","text":"脱尽龙儿锦绣衣，一枝变化作千丝。\n泠然不受人间暑，谁道清风有歇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹扇二首 其二","author":"王质","text":"老龙飞去葛家陂，尚有龙儿戏锦衣。\n只恐世尘吹不尽，世尘吹尽听龙归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白羽扇二首 其一","author":"王质","text":"昔卧隆中今渭湄，真龙长御快风飞。\n出关吹碎儿郎胆，安用军师更指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白羽扇二首 其二","author":"王质","text":"鼎足三雄各立时，卧龙腾起向西飞。\n渭川波尽摇明月，百万貔貅听指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七宝扇","author":"王质","text":"七宝薰开万窍风，灵犀一点与天通。\n婆娑吹动红炉雪，总在清凉世界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六角扇二首 其一","author":"王质","text":"一自昭陵掩閟都，龙跳虎卧世间疏。\n如今纵有千金璧，不博当年十字书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六角扇二首 其二","author":"王质","text":"昔日兰亭畅惠风，至今不与庶人同。\n百金五字都休问，修竹清湍在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒲葵扇","author":"王质","text":"轻蒲猎猎野风秋，吹上蟾宫白玉楼。\n想见东山红粉里，超然惟有此风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道经","author":"王质","text":"端拱主人无语句，台舆仆隶闹喧阗。\n希声绝想忘言处，海水墨山书不全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栗里华阳窝辞 移南村辞","author":"王质","text":"多柴多桑兮繁阴，栗熟兮山前山后而多闻。\n有人兮素心，林密林疏兮溪山自为秋春。\n不见兮相思，相思兮起下床而揽衣。\n南畴兮嘉穟，北牖兮新葵。\n转南村兮西庐，夫岂众芳兮要之。\n何所独无芳草兮，惟吾宇其增菲。\n纷有此内美兮，奚适而非良期。\n勿知太元兮，又焉知义熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栗里华阳窝辞 去彭泽辞","author":"王质","text":"西田下噀兮将荒，胡不归。\n彭泽洵美兮，唯柴桑其是思。\n米五斗兮何薄，带一束兮何卑。\n乾坤莽苍兮，怀有道之无期。\n山隩兮江冲，鱼龙波涛兮，芦人渔子犹怔忡。\n朝上英兮暮下雄，山林自有豪杰兮，白银水精之飞龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栗里华阳窝辞 游斜川辞","author":"王质","text":"风物兮美且闲，矫鸥驰鲂兮各适所天。\n南阜兮斜川，川虽斜兮心不然。\n二邻三曲兮为谁，刘即周兮祖谢羊庞皆从而命之。\n闹沙奔兮烟瞀，回峰转兮云䎖。\n上下湓浦兮，无乃丹阳之桀人。\n不恨庐山之弗秀兮，恨庐山之弗深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栗里华阳窝辞 穫西田下噀辞","author":"王质","text":"平畴兮交远风，良苗兮怀新新。\n欲升兮未升，猿鸟兮悲吟。\n饶霜露兮深山，风气兮先城郭而生寒。\n堇不苦兮将辞其实，难倍伊蓰周兮又奚著而奚作。\n青山白莲兮辽辽邈邈，矧玉台兮金阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]