[{"title":"秋意","author":"胡仲弓","text":"淅淅西风响败栏，棕榈一夜战声乾。\n壮心肯逐悲秋老，自剔青灯把剑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵庸斋为程生作梅窗二字因为之赋","author":"胡仲弓","text":"作赋何如宋广平，吟诗谁是老逋清。\n庸翁不喜诗兼赋，写与閒人作美名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁仲圭归合沙","author":"胡仲弓","text":"去秋曾作送行诗，又见贞人话别离。\n杨柳柔条未堪折，梅花聊赠岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人","author":"胡仲弓","text":"才到离亭泪满衣，云山千里梦相随。\n石州一曲阳关酒，窨约归来是几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅村归三山 其一","author":"胡仲弓","text":"此别重逢知几秋，梅花虽老更风流。\n东君未漏春消息，罚与人间作蹇修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅村归三山 其二","author":"胡仲弓","text":"独笑坐鞍自课诗，江云雨树两依依。\n客怀生怕西风恶，才入秋来便赋归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨 其一","author":"胡仲弓","text":"君居楚尾妾吴头，咫尺天涯作许愁。\n多谢有情江上月，夜深分照两家楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨 其二","author":"胡仲弓","text":"别后妆台镜懒开，倚门日日望书来。\n西风吹过衡阳雁，雁已归回郎未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺情","author":"胡仲弓","text":"宝镜愁看泪脸红，银瓶冷落若为容。\n梦魂不怕关山险，飞过巫山十二峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻西事有感","author":"胡仲弓","text":"春水方生秋又残，上流无处避风寒。\n杜鹃飞向东南去，怕见如今蜀道难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"胡仲弓","text":"月明独倚异乡楼，北望天涯几许愁。\n故国不归人意老，无情汴水自东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和皇帝宸翰四绝句 其三","author":"胡仲弓","text":"放鹤山中访野梅，南枝开了北枝开。\n花神不作趋时态，也待鸾舆亲幸来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和皇帝宸翰四绝句 其二","author":"胡仲弓","text":"中兴盛事记磨崖，上有千年苔藓花。\n世变几经流水去，山边犹有漫郎家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和皇帝宸翰四绝句 其一","author":"胡仲弓","text":"凭高望杀旧山川，万里云迷不尽天。\n汴水流经淮泗去，更无人买北归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恭和皇帝宸翰四绝句 其四","author":"胡仲弓","text":"御沟镇日水潺潺，安得流红到世间。\n三十六宫新雨露，春风长绕八盘山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓来","author":"胡仲弓","text":"晓来对雪看唐诗，自暖茅柴酒一卮。\n绝胜五陵贵公子，销金帐下饮羔儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓枕听禽言","author":"胡仲弓","text":"山鸟不知名，窗前作意鸣。\n自言还自答，终始一般声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源图","author":"胡仲弓","text":"误入仙源不记春，花间一见喜津津。\n可怜尘迹空遗恨，一树桃花经几秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秘书省墨竹","author":"胡仲弓","text":"写出此君真面目，笔端造化少人知。\n我疑与可今犹在，安得东坡共赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秣陵","author":"胡仲弓","text":"山自青青水自流，五云犹绕帝王州。\n谁将千幅鹅溪绢，画出东南一片秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读后村梅花百咏","author":"胡仲弓","text":"曾被梅花累十春，孤山踪迹断知闻。\n百篇依旧相嘲弄，却恐梅花又怕君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读杜牧之诗","author":"胡仲弓","text":"风流不减晋诸贤，涌出胸中万斛泉。\n吟到秦淮商女句，令人忆杀杜樊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谈星陈炎发求诗","author":"胡仲弓","text":"从来此物最瞒人，术好多为造物嗔。\n若把天机全泄漏，罚教甘石一生贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘潮图","author":"胡仲弓","text":"吴缣半幅浪如堆，开卷晴窗殷地雷。\n一见野人心目爽，中秋曾看夜潮来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄方南湖","author":"胡仲弓","text":"风雨中间奔客程，征衣湿尽尚悭晴。\n可人不见空惆怅，拍拍一湖春水平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄越友","author":"胡仲弓","text":"偶向津头买钓蓑，怀人只隔一烟波。\n扁舟欲渡长江去，奈此西湖明月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄意三绝 其一","author":"胡仲弓","text":"燕楼犹在月明中，还却明珠泪掩红。\n青鸟不来云路隔，碧桃无复旧春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄意三绝 其三","author":"胡仲弓","text":"井底银瓶事已非，鸳鸯打散鸭惊飞。\n千金莫试秋胡妇，持向青楼买笑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄意三绝 其二","author":"胡仲弓","text":"尘满胡床泪满衣，深闺寂寂锁相思。\n一春幽恨无人共，手撚梨花肠断时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题春谷监簿","author":"胡仲弓","text":"敲碎吟扉杳不闻，数声犬吠谷中云。\n几番欲去重回首，立尽斜阳不见君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徘徊花","author":"胡仲弓","text":"独擅春花掩众芳，蔷薇水洗内家妆。\n可怜清气无收拾，惹得閒人衣袖香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"断桥观钓","author":"胡仲弓","text":"一竿明月一丝风，心在烟波渺渺中。\n浮世只消如此过，何因得似钓鱼翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春","author":"胡仲弓","text":"万红千紫已摧残，留得荼蘼一架看。\n燕子不知人意懒，飞来帘里诉春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚梅次韵 其二","author":"胡仲弓","text":"年少丛中最老成，春风一点尚留情。\n先生早晚调羹去，说与群儿莫浪争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚梅次韵 其一","author":"胡仲弓","text":"准拟和羹滋味成，如何尚带隔年英。\n春风可是无分别，遣放夭桃相并生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚静","author":"胡仲弓","text":"当日濂翁此读书，自编小说爱芙蕖。\n方池静植香清远，便拟蓬莱小石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥庙","author":"胡仲弓","text":"黄绢碑残香草生，当时泪眼不曾晴。\n至今流水声呜咽，犹是曹娥哀怨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"胡仲弓","text":"天地有生意，验之阳气回。\n所以霜雪中，春风先及梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花盛开有粉蝶冲寒而至","author":"胡仲弓","text":"翩翩拍舞下瑶阶，知是东君间谍来。\n深入粉香人不见，花心摇落却飞回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅坡席上次韵牡丹 其二","author":"胡仲弓","text":"不学时妆添酒晕，休将风景对茶前。\n沈香亭北空回首，目断关河万里天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅坡席上次韵牡丹 其一","author":"胡仲弓","text":"为甚花神受气偏，却来南地逞春妍。\n鞓红未数青州种，粉白犹疑洛浦仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅答","author":"胡仲弓","text":"多谢东君为主张，十分霜雪十分香。\n开时已办和羹料，肯作风流时世装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梦中","author":"胡仲弓","text":"忽思十数年前事，只似今朝昨日间。\n堪叹梦中犹有梦，浮生能得几时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野烧","author":"胡仲弓","text":"朝见樵人纵斧斤，暮看野火拥红云。\n棘丛怕有芝兰种，莫把芝兰一例焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中有感","author":"胡仲弓","text":"闾阎愁叹不堪闻，风雪如何更作嗔。\n白玉楼台银步障，只宜富贵不宜贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪磴","author":"胡仲弓","text":"石磴不可攀，前头有积雪。\n安得冰玉人，对此清高节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景阳宫井","author":"胡仲弓","text":"隋师已迫长江浒，玉树庭花曲未终。\n千古龙鸾有遗恨，胭脂井上至今红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"侨寄山居霍然几月凡见之于目闻之于耳者辄缀成绝句名之曰田园杂兴非敢比石湖聊以写一时闲适之趣云尔 其八","author":"王志道","text":"漠漠轻烟护鹊巢，杨花无赖矗天高。\n粼粼白水秧畴满，省却年时灌溉劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暑中杂兴 其六","author":"方岳","text":"平生多可曹修士，说我唐诗最逼真。\n不道蹇驴风雪里，何如黄犊过比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"棋诗","author":"胡仲弓","text":"局面年来竟未安，一番下著一番难。\n祇今黑白无分别，输与傍人袖手观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游九日山","author":"胡仲弓","text":"散策来游九日山，松风细细袭人寒。\n菊花过了重阳节，自是登高兴未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游小身岩","author":"胡仲弓","text":"千古岩隈迹未尘，几多斧凿幻全身。\n金身丈六犹言小，绝倒侏儒世上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游天竺灵隐三绝 其三","author":"胡仲弓","text":"冷泉亭角坐移时，试看孤峰飞不飞。\n峰自不飞人自醉，暮鸦栖了更忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游天竺灵隐三绝 其一","author":"胡仲弓","text":"游山此是第三回，天竺禅门八字开。\n已断此生休佞佛，又随人去乞灵来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游天竺灵隐三绝 其二","author":"胡仲弓","text":"呼猿才了复临流，洗出胸中一派秋。\n泉石世间真富贵，几生修得到巢由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游水乐烟霞二洞三绝 其一","author":"胡仲弓","text":"此是游山第二回，天风吹断洞云开。\n人生到处须行乐，不为寻梅亦自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游水乐烟霞二洞三绝 其二","author":"胡仲弓","text":"爱山分席坐松阴，草草杯盘慰赏心。\n水乐不鸣天籁寂，数声幽鸟和清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游水乐烟霞二洞三绝 其三","author":"胡仲弓","text":"象鼻峰前得少留，烟霞风景记来游。\n等閒拂石题名姓，惹得青云上笔头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游瑞源访修上人","author":"胡仲弓","text":"羡师尽得山林趣，顾我初无朝市心。\n欲把山林换朝市，市朝未必似山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖边","author":"胡仲弓","text":"湖边春色浓于酒，醉尽东西南北人。\n独有诗翁清到底，一生醒眼看青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琼花","author":"胡仲弓","text":"洁白全无一点瑕，玉皇敕赐上皇家。\n花神不敢轻分拆，天下应无第二花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意亭","author":"胡仲弓","text":"主人心地阔，以意名其亭。\n长携一樽酒，坐对前山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感怀","author":"胡仲弓","text":"曾将敝帚弃墙阴，十载尘埃懒重寻。\n今日携来扫花径，老夫安得不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞香花","author":"胡仲弓","text":"生处多应散紫芝，清香端的与梅期。\n梅花刚被人描画，却是清香人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡猫","author":"胡仲弓","text":"瓶中斗粟鼠窃尽，床上狸奴睡不知。\n无奈家人犹爱护，买鱼和饭养如儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午","author":"胡仲弓","text":"画舸纵横湖水滨，綵丝角黍斗时新。\n年年此日人皆醉，能吊醒魂有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠凉","author":"胡仲弓","text":"千章古木影萧森，未必山林如许深。\n才见眼前成绿暗，一年又负种花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翡翠","author":"胡仲弓","text":"毛羽生来便属人，悔将体段斗精神。\n寄言翡翠休惊讶，但是文章尽累身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其五 一线天","author":"胡仲弓","text":"许大乾坤满世间，管窥蠡测已为难。\n谁将一线通天窍，输与高人著眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其六 云卧","author":"胡仲弓","text":"来寻高处卧吟身，泉石中间避世尘。\n莫把白云都占断，也分一半与閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其七 平远","author":"胡仲弓","text":"万里江山万里天，沙平雁落远相连。\n西风吹断云衣细，一叶飞来是钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其十 极目","author":"胡仲弓","text":"万仞岗头著此身，乾坤围里尽红尘。\n欲知山水有穷处，却是离娄看得真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其二 柳塘","author":"胡仲弓","text":"翠眉低拂效宫颦，近水亭台剩得春。\n千古渊明扶不起，一枝赠与折腰人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其四 掬清","author":"胡仲弓","text":"止水中间别有天，濯缨人去自清涟。\n明珠万斛归尘土，不及山中一掬泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其一 深省","author":"胡仲弓","text":"鲸音千里送惊涛，偏为人间破睡魔。\n待得耳根清静后，觉来醒处已无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其三 寒岩","author":"胡仲弓","text":"境于胜处筑新岩，中有仙翁换骨函。\n门户本来无锁钥，白云从此不须缄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其八 跨鳌","author":"胡仲弓","text":"惊涛日夜战喧豗，危甚瞿塘滟滪堆。\n稳把一竿临碧水，三神山上钓鳌来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题冯中郎庙","author":"胡仲弓","text":"论将功中可策勋，至今香火密如云。\n生时不遇孝文帝，定有何人肯荐君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题刘氏东陵图","author":"胡仲弓","text":"昔日青门喜种瓜，尚遗种子在天涯。\n如今落在刘郎手，刘邵原来自一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]