:{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚步","author":"家铉翁","text":"闭门自要身心敛，出户方知天地宽。\n晚步中庭人不识，道余痴想白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者图 其四","author":"家铉翁","text":"平地何年生怪石，天教隐者作渔隈。\n莫言昔日磻溪事，恐被山灵发笑咍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者图 其三","author":"家铉翁","text":"诗人偏爱渔人乐，渔乐诗情一样奇。\n欸乃数声烟雨外，非宫非徵自成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者图 其二","author":"家铉翁","text":"微吟缓策过桥来，天际轻阴日未斜。\n指点前村竹深处，更寻钓叟问生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中玩易偶成","author":"家铉翁","text":"道如大路人能见，德有輶伦识者稀。\n四望皓然都洁净，洁中还要辨精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹见庞居士图 其一","author":"家铉翁","text":"团栾共坐说无生，家话只堪儿女听。\n谁遣老禅来入社，迎门笑语是轰霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李氏敬聚堂 其四","author":"家铉翁","text":"闻君出宰山水县，家教所推民俗淳。\n田里定知耕逊畔，市廛安得讼分人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李氏敬聚堂 其五","author":"家铉翁","text":"枝叶皆从一本生，源源本本是天伦。\n易经著义交相爱，相忍何如相爱亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李氏敬聚堂 其一","author":"家铉翁","text":"千载河间旧典刑，诗书习气至今存。\n故家乔木知谁在，五世同居是义门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李氏敬聚堂 其六","author":"家铉翁","text":"人言尔祖玉蕴石，传到儿孙蓝出青。\n眼底桐枝多秀色，早令授业各专经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠隐者忘机 其二","author":"家铉翁","text":"万古周流此一机，何尝丝发涉人为。\n不须苦用忘忘意，认取存存不息时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 东城春早","author":"家铉翁","text":"阳回冰底见云堆，春意东来梅已知。\n待得东城花柳放，早春已是得春迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 冰岸水灯","author":"家铉翁","text":"华灯万炬照沉渊，移得星辰下九天。\n莫言燃犀当日事，川灵今夜亦欢然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 戍楼残照","author":"家铉翁","text":"卢龙久已属神州，谁认歌楼作戍楼。\n莫说关头兴废事，江山犹有石郎羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 西园秋暮","author":"家铉翁","text":"九九中间易道在，天心惟许菊花知。\n一年好景君须识，都在西园把菊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 沙堤风柳","author":"家铉翁","text":"突兀长堤一望问，几人东去复西还。\n堤边日日办迎送，风自翩翻柳自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 客船晚烟","author":"家铉翁","text":"去棹来帆一聚尘，个中那复有诗情。\n晚来应是卢仝过，留得茶烟一抹横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲸川八景 莲塘雨声","author":"家铉翁","text":"赢得荷风伴晚凉，夜阑急雨到陂塘。\n茅檐似减三分暑，鼻观俄然失却香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登瀛台","author":"家铉翁","text":"此地无山喜有台，南瞻北眺两宜哉。\n衰翁无事日倾倒，佳客何人时一来。\n孤鹤飞鸣知我在，征鸿嘹唳为谁哀。\n老来万事如归宿，不为忧愁强把杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登瀛台和昔人韵二首","author":"家铉翁","text":"屋角东边十仞台，龙蟠虎踞亦奇哉。\n四时长是几案物，九日仍烦杖屦来。\n乐事无穷谁共管，孤云在望我堪哀。\n梦随鸿鹄南飞去，岑下长号酹一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前岁上元与赵任卿寓临安追逐甚乐今年同在建溪任卿先赴郡席小雪忽作且知早筵遂散独坐无聊因得二诗却寄 其二","author":"家铉翁","text":"沙河红烛暮争然，花市清箫夜彻天。\n客舍风光如昨梦，帝城歌酒又经年。\n老僧强作琉璃供，上客先逢玳瑁筵。\n不许裴郎同夜饮，新妆月底为谁妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"前岁上元与赵任卿寓临安追逐甚乐今年同在建溪任卿先赴郡席小雪忽作且知早筵遂散独坐无聊因得二诗却寄 其一","author":"家铉翁","text":"山城灯火已萧然，扫巷游人更雪天。\n厌听落梅翻永夜，喜看飞絮卜丰年。\n狂随戏蝶装罗髻，巧逐纤腰上舞筵。\n明日瑶阶对琼树，会须微月与争妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽刘文蔚 其一","author":"家铉翁","text":"五年瀛下寄閒身，耐久交朋喜有君。\n竟日坐谈唯在道，有时游戏亦论文。\n高风每欲追鹏运，雅志那能混鹜群。\n留得浩然英气在，便将生死付朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":52856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]