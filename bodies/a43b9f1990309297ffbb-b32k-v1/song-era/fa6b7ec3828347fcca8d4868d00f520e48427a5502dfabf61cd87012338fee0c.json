[{"title":"重午斋宿读蔡迨文编以酒馈之 其二","author":"韩元吉","text":"沈香亭上未传宣，斗酒挥毫自百篇。\n研雪新蒲瓯弄碧，遥知独酌意悠然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乘潮遇顺风","author":"韩元吉","text":"忠信平生自可期，江神于我定相知。\n顺风鼓棹潮如席，世事由来却险巇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"俸金既尽家人问所质物戏答","author":"韩元吉","text":"十载栖迟櫑具客，一生憔悴扊扅歌。\n典衣不为沽春酒，平昔无诗博饭箩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪道中五首 其五","author":"韩元吉","text":"抱琴不作王门客，晋代高风只此人。\n故老底须三上疏，竹林诸子未天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪道中五首 其四","author":"韩元吉","text":"心随天末江波远，愁似沙津柳带长。\n向晚飞花度墙影，半晴烟雨发山光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪道中五首 其三","author":"韩元吉","text":"平潮恰恰乱蛙鸣，断送江南春雨晴。\n绿縠细看桑眼破，紫茸还见草心生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪道中五首 其二","author":"韩元吉","text":"戴家家住此溪头，买酒寻春得胜游。\n夹岸杨花浑似雪，不应兴尽便回舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡溪道中五首 其一","author":"韩元吉","text":"拟赋归田未有田，春风聊泛剡溪船。\n青山满眼留侬住，处士茅茨阿那边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖仲惠梅花数枝 其三","author":"韩元吉","text":"江上春风几日回，一枝先傍小堂开。\n恨无冷艳连天白，已有生香特地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖仲惠梅花数枝 其二","author":"韩元吉","text":"莫问南枝与北枝，幽香先与小春期。\n直从的皪寒梢数，看到飘零似雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖仲惠梅花数枝 其四","author":"韩元吉","text":"剩买青春不费钱，眼明江静月争妍。\n诗人每负梅花债，屈指今年第一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晖仲惠梅花数枝 其一","author":"韩元吉","text":"霜馀不用怨年华，已有寒梅一两花。\n眼冷故知春意动，瓦瓶终日看横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽梅","author":"韩元吉","text":"人将妆额半凌晨，天与仙风自绝尘。\n岁晚相逢有如此，为君传取雪中真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浙江观潮","author":"韩元吉","text":"江翻海涌势难平，鳌掷鹏鶱自不停。\n端为君王洗兵马，参旗井钺万雷霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海门斜照","author":"韩元吉","text":"云梦悬知八九吞，银山万叠涨天门。\n长江日落鱼龙舞，古寺烟深鸟雀喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狼山","author":"韩元吉","text":"天外奇峰认九华，路人指点是狼牙。\n他年刻石题车马，会遣山前属汉家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"航弟自广润省坟金华作二绝句送之 其一","author":"韩元吉","text":"族绪彫零不计年，户曹一眷更萧然。\n恨无收敛冠巾计，送汝安心稳坐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读周瑜传","author":"韩元吉","text":"年来三十过平头，笑却周郎却自羞。\n但得小乔歌一曲，未须辛苦向荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁镜赠仲俨","author":"韩元吉","text":"石门江畔雁山前，芥室遥知更豁然。\n百鍊精明真是铁，不妨照破野狐禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶兴四首 其四","author":"韩元吉","text":"爱水仙成百计栽，三年一笑渐能开。\n金银岂是吾家物，借我虚名付酒台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶兴四首 其三","author":"韩元吉","text":"江南菊少开金色，只有霜葩杂御黄。\n乞得黄花真爱惜，明年剩种压群芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶兴四首 其二","author":"韩元吉","text":"小园无数菊花开，准拟花残便见梅。\n不恨无花正无酒，敲门谁送一樽来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶兴四首 其一","author":"韩元吉","text":"桂花飘尽菊花黄，闲对芳丛静爱香。\n堂下草深须一丈，会看春意满池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿石桥闻水声","author":"韩元吉","text":"野桥曲折渡千回，古寺悬知水面开。\n一夜寒声喧客枕，却疑风雨转山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼老琼二首 其二","author":"韩元吉","text":"江水东流湖水西，水边花落梦回时。\n南屏山下风吹土，犹作萧萧暮雨垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼老琼二首 其一","author":"韩元吉","text":"歌舞相从六换年，秦筝已断不能弦。\n荷花满眼垂杨绿，肠断清宵月正圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨兴","author":"韩元吉","text":"北窗松竹夜萧骚，诗就呼儿进浊醪。\n睡美不知新雨足，晓来南涧水声高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望灵寿致拜祖茔","author":"韩元吉","text":"白马冈前眼渐开，黄龙府外首空回。\n慇勤父老如相识，只问天兵早晚来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐静山二首 其二","author":"韩元吉","text":"海上蟠桃手自栽，红尘一堕隔蓬莱。\n风帆弱水无由到，乞我当年渡海杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐静山二首 其一","author":"韩元吉","text":"山锁松行一径遥，峰回楼殿更岧峣。\n飞来双鹤知何处，只有泉声下碧霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渡河有感","author":"韩元吉","text":"衮衮河流到底黄，谁言一苇便能杭。\n伤心击楫无人会，举酒回头酹太行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答人问易","author":"韩元吉","text":"阴阳妙用表三才，却问阴阳底许来。\n若识阴阳由动静，何人更作有无猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫极观二首 其二","author":"韩元吉","text":"杨柳花飞杏子新，园林无地可留春。\n却寻风雨江边路，惭愧烟霞物外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫极观二首 其一","author":"韩元吉","text":"小雨轻云却解晴，菰蒲冲浪过船声。\n已无桃李占春事，浓绿满山风更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢陈秀才送诗","author":"韩元吉","text":"偶因借得官书读，小札于君一向疏。\n忽寄江湖诗百纸，梅花担上雪晴初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪山堂次韵","author":"韩元吉","text":"溪岸人家高下居，绕溪云树杂烟芜。\n故应曲水传佳句，还喜青松入画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅二首 其二","author":"韩元吉","text":"未惬篱东染御黄，天香特地剪蜂房。\n应怜雪里昭君怨，洗尽铅华试佛妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅二首 其一","author":"韩元吉","text":"白璧黄金取意裁，极知变态自江梅。\n风流一样香仍好，共趁春前腊后开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅二首 其二","author":"韩元吉","text":"影落寒塘月照时，梦为蝴蝶绕高枝。\n画工欲画无穷意，不道幽人圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨梅二首 其一","author":"韩元吉","text":"西北佳人绝代姿，倾城倾国未为奇。\n自然冰雪生颜色，不用人间朱粉施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题张几仲所藏醉道士图","author":"韩元吉","text":"何须坐客总能文，呼酒相逢日暮云。\n醉倒尽如狂道士，夜归谁问故将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕山道中见桃花","author":"韩元吉","text":"今日风横车少尘，卷帷聊看塞垣春。\n已惊漠漠花经眼，也有濛濛絮扑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕亚之置酒再用前韵","author":"韩元吉","text":"乌鹊无声夜向阑，空庭插竹巧谁看。\n长生殿里金钗暖，百子池边五缕寒。\n梦破清风吹雨脚，醉馀新月上林端。\n閒来不辨论时节，剩喜秋花共夕餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日独酌","author":"韩元吉","text":"茱萸满把半青红，强拟登临少客同。\n碧树池塘秋色里，黄花时节雨声中。\n官閒觅句能消日，酒薄看山尚怯风。\n高李故人今健否，一樽怀古意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九华道中","author":"韩元吉","text":"行人脚底不生尘，绝壁仙凡路已分。\n一水奔腾崖覆雪，九峰罗立岫填云。\n谪仙才大三千首，国老谋深十万军。\n莫对青山叹华发，丹砂未就又论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与苏训直约游招隐寺 其一","author":"韩元吉","text":"十日春晴未放梅，篮舆端为看山来。\n路寻绝壑空流水，寺倚苍岩只废台。\n处士尚馀三亩宅，野僧合买万松栽。\n故知佳兴难为败，上尽西峰眼界开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与苏训直约游招隐寺 其二","author":"韩元吉","text":"鼙鼓初归塞上师，京江酒美胜年时。\n春来逆旅真无事，身到名山合有诗。\n石底于菟穷作穴，泉间科斗闹成池。\n荒寒景色君休问，后日应怀此客随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行 其一","author":"韩元吉","text":"意适都忘远，行歌未觉劳。\n崎岖一径入，上下数峰高。\n嫩白怜新菊，轻红讶小桃。\n归来情兴动，风叶乱萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山桥","author":"韩元吉","text":"倚杖溪桥暮雨垂，春寒空翠著人衣。\n凌空怪石如旗竖，喷壑清泉作练飞。\n乘兴正须随地饮，醉狂聊共插花归。\n从教拍手儿童笑，要是山深客到稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰乐楼","author":"韩元吉","text":"今岁西湖上，经行始此回。\n轻烟认花柳，细雨识楼台。\n春半已多日，官閒能自来。\n情知欠樽酒，倚杖且徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕再用韵","author":"韩元吉","text":"瑶山直上玉梯横，不用银花散火城。\n著柳共看飞絮动，打窗浑作乱蚊声。\n路寻鸾鹤天疑近，石壅鲸鲵观易京。\n便拟乘风跨沧海，更须新月趁潮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夔以诗留别用韵示之 其一","author":"韩元吉","text":"密竹疏松一水边，高舂自占曲肱眠。\n心如古井真无浪，迹似寒灰岂复然。\n舌在未应甘寂寞，地偏犹可小回旋。\n春风又绿池塘草，清梦从今只惠连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夔以诗留别用韵示之 其二","author":"韩元吉","text":"渊明绕屋树扶疏，大似蓬蒿仲蔚居。\n老矣强营三径菊，閒来未厌五车书。\n诗成叹我同招隐，赋就须君敌子虚。\n努力青云家世事，他年簪笔待严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝耕至赤松山","author":"韩元吉","text":"谬误君恩再领州，名山犹幸复春游。\n苦无羽客追元放，尚有群儿识细侯。\n麦穗雨晴迷野岸，桃花风急满溪流。\n隔林布谷如相应，更酌丹泉为少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尹少稷挽词二首 其二","author":"韩元吉","text":"今代贤良策，中兴未一陈。\n文章如汉士，家世亦齐人。\n遇合嗟云晚，忠嘉慨莫伸。\n朔风吹墓草，毁誉付千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尹少稷挽词二首 其一","author":"韩元吉","text":"蚤擅奇童誉，中蜚处士声。\n谈锋粲开阖，笔力妙纵横。\n主圣由言悟，官清以谏名。\n故交零落尽，老泪与河倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方务德侍郎挽词二首 其二","author":"韩元吉","text":"上圣询黄发，清时慨莫留。\n居中二千石，典外十三州。\n禁闼多闳议，筹帏裕远猷。\n交亲半天下，注海泪空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方务德侍郎挽词二首 其一","author":"韩元吉","text":"壮岁分符节，飞腾四十春。\n吁嗟循吏传，无复老成人。\n三辅勤劳旧，西清宠数新。\n青山问何许，犹与谢公邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛平仲挽词二首 其二","author":"韩元吉","text":"蚤岁闻嘉誉，论交鬓已丝。\n长言虽面隔，千里但心期。\n故垒生刍奠，尘编幼妇辞。\n倚天长剑在，欲挂漫兴悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"毛平仲挽词二首 其一","author":"韩元吉","text":"奥学穷千古，奇文擅两都。\n功名一杯酒，身世五车书。\n未奏扬雄赋，长怀仲举舆。\n溪塘岩下水，岂羡石为渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王中奉汉老挽词","author":"韩元吉","text":"符节光华二十春，壮猷曾不侍严宸。\n栖心香火才同社，放意溪山幸卜邻。\n再世簪缨宜衮衮，一门兰玉尚诜诜。\n霜清三港追随地，丹旐飘然泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"令防得女招饮以病不往走笔戏之","author":"韩元吉","text":"平生诸女重吾贫，敢意君家亦效颦。\n丑恶未妨攘盗贼，长成难议卜比邻。\n遥怜四十称郎罢，岂惜千金办主人。\n美酒尚须留待我，明年应见玉麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其六","author":"韩元吉","text":"忆罢仪曹试，登门语更亲。\n故怀如昨日，一醉赏馀春。\n佳句犹沾墨，遗编竟掩尘。\n烟云变朝暮，感慨独伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其五","author":"韩元吉","text":"翰墨通家旧，吁嗟大父时。\n追随千里驾，酬唱百篇诗。\n小器惭非远，孤童误见奇。\n慇勤授简意，敢负昔年期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其四","author":"韩元吉","text":"精舍湖山外，天开万石林。\n五车娱晚岁，一壑遂初心。\n激水穿岩窦，栽花绕涧阴。\n佳名端不朽，挥泪记登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其三","author":"韩元吉","text":"宦达平生早，高年及引归。\n安车荣绛节，黄发遽衰衣。\n未致生刍奠，俄惊薤露晞。\n孝心天地恻，相望两灵帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其二","author":"韩元吉","text":"望实诸公右，文章百代师。\n匡时存诏令，谋国见丞疑。\n易识悲麟意，难追吐凤辞。\n门生满天下，谁继蔡邕碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶少保挽词六首 其一","author":"韩元吉","text":"奥学馀家法，宏材迈古风。\n剸烦樽俎上，禦侮笑谈中。\n勋业中兴殿，规模大驾宫。\n哀闻父老泣，遗爱六州同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶梦锡丞相挽词二首 其二","author":"韩元吉","text":"味道苏仙井，言归鬓尚青。\n仅周新甲子，还仰旧仪刑。\n秘殿欣疏宠，华钟待勒铭。\n追随樽酒地，愁绝最高亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶梦锡丞相挽词二首 其一","author":"韩元吉","text":"制邑腾嘉誉，升平遂一州。\n雍容持从橐，慷慨动宸旒。\n相业看调鼎，兵机久运筹。\n勋庸元未究，湖海泪空流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用前韵以小春茶饷子象","author":"韩元吉","text":"仙花不用恼诗人，亦有灵芽特地春。\n数朵娇花真绰约，一瓯酽白更清新。\n眼明共识西都艳，齿冷应怀北苑珍。\n佳茗奇葩堪并赏，须公品第入陶钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春感怀","author":"韩元吉","text":"南北驱驰老病身，不堪节物更催人。\n梅梢白白犹藏腊，蔬甲青青便作春。\n铁马渐欣边塞静，土牛还祝岁时新。\n圣朝文物从兹始，元日郊丘得上辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记建安大水","author":"韩元吉","text":"孤城雨脚暮云平，不觉鱼龙自满庭。\n托命已甘同木偶，置身端亦似羸瓶。\n浮家却羡鸱夷子，弄月常忧太白星。\n当日乘槎便仙去，故人应罪曲江灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]