[{"title":"送交代倅车晏十一鲁望","author":"张伯玉","text":"鲁望江南客，风骚猎将坛。\n高吟得意处，清韵逼人寒。\n场屋声华旧，襟灵渤澥宽。\n闺门尽羔雁，庭野列芝兰。\n僶勉来新定，淹留就小官。\n酒论浩劫饮，山欲上天看。\n待月高峰寺，听猿七里滩。\n入云移翠簜，凿石引鸣湍。\n一日交符去，芳风善继难。\n红尘久离阔，白首此相欢。\n留方医鹤膝，贶别遗渔竿。\n虎杏宁知用，松筠幸未残。\n路长分骥騄，火烈辨琅玕。\n沙际多平仲，鸰原有谢安。\n卷舒知自得，不用苦弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐苏七太守通判晏鲁望远寄倡和之什辄伸记美","author":"张伯玉","text":"桐君圃外州，树石最清幽。\n水截三吴秀，山当百粤秋。\n岩坰无俗土，宅舍有高楼。\n画隼真才望，题舆雅唱酬。\n滩声环醉枕，鹭影入茶瓯。\n蚤晚陪清躅，梯云奉俊游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐官满先寄杭州资政侍郎","author":"张伯玉","text":"海角千家郡，天南一水涯。\n倦游惭梗泛，多滞喜瓜时。\n弱羽诚难振，危根只自持。\n几门尝际遇，百步亦参差。\n万壑喷霆雾，千峰出险巇。\n牢愁客星见，孤节涧松知。\n贺厦宁无托，披云幸有期。\n鲁堂金石地，商欲再言诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌龙寺祈雨回马上口占","author":"张伯玉","text":"官曹苦羁束，祈灵得幽便。\n夹路松披纷，蹑石烟分练。\n迎轩玉泉响，鸣驺沙鸟散。\n晓日破霜阴，前峰蔼葱茜。\n逶迤步高阁，窈窕出云汉。\n坐来清思生，语馀疏磬缓。\n方将尘滓涤，还忧簿书乱。\n偃旆拂归鞯，回首青猿断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王敦城","author":"张伯玉","text":"晋氏开霸图，潜飞入坚壁。\n梦日有馀祥，留鞭无旧迹。\n虽矜钱凤计，终堕太真策。\n不作忠良臣，高城有何益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出七里泷口望桐庐县","author":"张伯玉","text":"泷口波自平，沧洲分两溪。\n辛勤下百粤，乍出天一涯。\n近入桐庐市，潮水滥中泜。\n不闻湍濑声，沙鸟浩然飞。\n物我两俱适，吾亦浩然归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉泉祈雨","author":"张伯玉","text":"南州富潨射，万壑纵奔濑。\n兹泉一何高，夐与寥廓对。\n邈非猿鸟到，迅恐岩磝碎。\n霜落天地清，玉立江海外。\n人区未蒙泽，蛟龙兹有待。\n浅石谅难渟，当与云涨会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙门岩","author":"张伯玉","text":"未到子陵台，先见龙门石。\n万物镇群峰，闯然耸双壁。\n清泉界中道，亢若高门辟。\n樵童走深径，渔户掩沈碧。\n白首钓鱼郎，不知有行客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"会稽山","author":"张伯玉","text":"稽山何崔嵬，奠此东南区。\n群山状趋附，万壑流萦纡。\n畴昔大禹来，简计天下书。\n诸侯率麇至，万玉争凫趋。\n防风独强梁，后至行趑趄。\n天威不可舍，败骨盈高车。\n至今憔悴烟，惨澹藏封隅。\n遂令百世后，尊王无异图。\n乃知圣人心，赏罚尽贻谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同孝叔游玉泉","author":"张伯玉","text":"石磴松阴一化城，泉源疑透古瑶京。\n僧知到耳此根静，客来洗心诸虑清。\n星记祥光重璧合，蓝田霁色暮烟生。\n潺湲似识君将去，相送出山多别情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后庵试茶","author":"张伯玉","text":"郡僻好藏身，心閒久无事。\n前轩饱食罢，后庵取茶试。\n岩边启茶钥，溪畔涤茶器。\n小灶松火然，深铛雪花沸。\n瓯中尽馀绿，物外有深意。\n滥官来此游，时得拂尘累。\n莫笑后庵茶，閒中好滋味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"州宅","author":"陈公辅","text":"万叠湖山烟水滨，朱门画戟间松筠。\n登临不踏红尘路，燕寝长居紫府春。\n昼静欲骖风外驾，夜寒疑是月中身。\n我惭白首方怀绂，犹得蓬莱作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至睦州泊新安江口","author":"张伯玉","text":"前岁过此州，手持七闽节。\n虽远更惮劳，揽辔迟明发。\n回瞻七里滩，何日榜舟歇。\n幸得满三年，解符下瓯粤。\n却到新安江，依然旧澄澈。\n敛巾照江水，无白可添发。\n州人多故吏，罗立皆磬折。\n问我此去心，复有何施设。\n兴言顾诸老，谢尔相慰说。\n此度归来心，可共严陵说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饭芝川村舍","author":"张伯玉","text":"嫩苗苒苒头角秀，柔桑袅袅阴影轻。\n茆檐饭起上马去，一声雨后黄鹂鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明月泉","author":"张伯玉","text":"至今千丈松，犹伴数岩雪。\n不见纤尘飞，寒泉皓明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经大洋吴氏别业","author":"张伯玉","text":"渐老故人少，与君兹晤言。\n方山共邻里，好畤旧田园。\n溪色寒生枕，松阴翠入轩。\n犹怜巾子在，相对举清尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘","author":"张伯玉","text":"东客从来过虎丘，橘花渡口维扁舟。\n阖闾宫殿不可见，但对古塔寒飕飗。\n忆昔夫差全胜日，水犀十万横吴钩。\n楚山既掘荆人冢，越岭仍将句践囚。\n岂谓西施能破国，谁知麋鹿上台游。\n唯有吴王在时月，夜深闲照剑池头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送清溪郑中舍官满还京","author":"张伯玉","text":"郑宰金闺彦，年来解绂归。\n囊装轻剑在，场屋故人稀。\n水馆酒初罢，霜江帆欲飞。\n无烦重回首，行矣近天晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐江口见雪","author":"张伯玉","text":"无诸地无霜，从古困炎热。\n晓出桐江口，喜见群峰雪。\n酌酒高帆下，归思满寥泬。\n从今不系舟，泛泛老清澈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄毛都官","author":"张伯玉","text":"寄问副车毛国镇，别来风味久如何。\n蓬莱阁上谁同饮，宛委山前几番歌。\n应向兰亭摛彩笔，曾教西子画清蛾。\n若还问我今何似，比著前春醉更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得越","author":"张伯玉","text":"尺一除书与会稽，陋儒何以报天辉。\n岂惟大幕张红旆，更得全家住翠微。\n千骑晚随龙节去，一帆春送鹢舟飞。\n支离莫道攘空臂，乞得越州金印归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清思堂昼坐","author":"张伯玉","text":"堂上萧然昼户开，澹松疏竹荫苍苔。\n白云无事不肯出，幽鸟有时还自来。\n何处覆车迷径路，几人缓颊走尘埃。\n支离得意谁知我，自对庭花引一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清思堂晓雪初霁望飞来山","author":"张伯玉","text":"密雪晓初霁，朝阳霭融融。\n隐几高堂上，坐对飞来峰。\n梵塔倚天半，楼台出烟中。\n岧然金银阙，瑰碧交玲珑。\n渐转皎日高，杳杳闻疏钟。\n天和发秀彩，灏气如腾虹。\n况予世虑疏，久矣渟心胸。\n更临物外趣，愈觉万缘空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游大禹寺回马上口占","author":"张伯玉","text":"永日跻云峰，向晚下秋巘。\n却望碧城中，楼台翠烟满。\n前旌拥归骑，缓辔徐驭隐。\n旷望写予心，平波海天远。\n顾予畴昔志，本以锄犁挽。\n敢望麋鹿资，遘此云龙旦。\n金门容窃步，玉殿叨灵眷。\n复此千骑来，日逐纷华战。\n平生知退意，长畏岁月晚。\n行当引初服，还把芰荷剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登乌龙山寺阁","author":"张伯玉","text":"桐川本无尘，况此幽阁迥。\n万木含秋声，一轩与天净。\n前峰翠分滴，后谷语相应。\n槛下江云归，檐前古雪凝。\n岩僧对游客，湛若寒冰瑩。\n百虑缘心空，独饭随疏磬。\n嗟余本林壑，谬与世纷竞。\n一作市朝人，几伤麋鹿性。\n旧山别来久，萝蔓锁幽径。\n长恐客沈深，未得归期定。\n息中来此境，时觉襟韵胜。\n犹愧招隐心，聊为小山咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓬莱阁閒望写怀","author":"张伯玉","text":"越绝开华国，姚虞启后昆。\n昔闻句允霸，今作帝王藩。\n地得东南重，山侔岳渎尊。\n平湖来万壑，翠袖列千门。\n市井鱼盐合，居人组绣繁。\n牙旗开物表，州宅倚云根。\n六郡趋麟节，三峰出雉垣。\n秦游前事废，禹画旧书存。\n雁鹜来还去，鲸波吐复吞。\n菱歌秋溆远，江信暮潮浑。\n石古寒松偃，楼危昼霭昏。\n冷光浓可截，秀色净无痕。\n露袅还堤柳，风飞列寺幡。\n深林藏杞梓，芳径杂兰荪。\n巧笑花争艳，嬉游玉斗温。\n画船雕鹢迅，绛袖绮霞翻。\n有意皆行乐，无忧可莳萱。\n乡惟知俎豆，士亦贲丘樊。\n巨舶联艘至，交衢百货蕃。\n敲冰呈巧手，织素竞交鸳。\n丽圃红柑亚，通畦紫芋蹲。\n茶先春入焙，笋带雪黏盆。\n异萼随时坼，清香触处喷。\n吴趋惭种蠡，楚些陋湘沅。\n往事图难尽，前修孰可援。\n风流王与谢，唱和白兼元。\n顾我栖儒窦，胡为属使鞬。\n迂疏非吏法，蹇浅是辞源。\n谬览先生策，谁调伯氏埙。\n剪裁迷幅尺，追琢昧玙璠。\n学术何曾取，名场辄屡奔。\n技甘同鼫鼠，化敢望溟鲲。\n将幕闲留滞，乌台误选抡。\n埋轮惭避俗，折槛畏当轩。\n坎壈人奚顾，羁孤舌但扪。\n爱书疑有癖，怕事欲无言。\n薪米支离叟，蹄盂炙毂髡。\n一为华省吏，三驾使君轓。\n蹭蹬慵成性，龙钟病愈惛。\n因怀邸中绂，来访道山园。\n税鞅红尘外，班条碧海垠。\n披襟澄沆瀣，缓带涤潺湲。\n乐岁欢康洽，高黉礼让敦。\n南宫罗俊彦，东箭蔼瑶琨。\n退食求凋弊，吹毛析滞冤。\n庖刀怯馀刃，櫑剑喜平反。\n重禄容虚受，期民肯惮烦。\n问贤思水薤，教俗养鸡豚。\n䆉稏西成稻，逍遥北海樽。\n吏符多鹤立，僚友尽鸿骞。\n讵听棠阴颂，聊祛缿讼諠。\n行歌齐击壤，坐啸比啼猿。\n洞邃宜招隐，时清耻叫阍。\n嗫嚅挥醉笔，伛偻曝晴暾。\n蹑险赍长屐，寻幽叱短辕。\n穷通方自适，语默且休论。\n厌把诗筒发，欣逢酒帟掀。\n桔槔肥果茹，竹马戏儿孙。\n以此为官业，何由报主恩。\n冰霜徒励操，渊谷可惊魂。\n蕙帐羞逋客，庭貆鄙素餐。\n行当解簪绂，归老白云村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鉴湖晚归","author":"张伯玉","text":"会稽太守无事时，缓带长作渔樵嬉。\n大航平榻引宾从，谈笑晚从湖上归。\n湖边居人望簇簇，湖岸花木情依依。\n环峰晻霭天四垂，渌水荡漾双红旗。\n城头叠角已平西，船上樽酒含馀辉。\n冷风徐引江鹄飞，白云回首清猿啼。\n渔讴菱棹烟火微，使人却厌千骑随。\n归来楼阁上灯后，时觉天风清满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠范吏部","author":"张伯玉","text":"海天东下越王州，碧城缭绕环山丘。\n春晴紫翠堆绮屋，日暮烟雨藏朱楼。\n禹祠花底金穴峻，贺老门前银汉秋。\n何当独把钓竿手，笑拥一艘东去游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张伯玉","text":"红梅花下一樽酒，抛掷清香是负伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其三","author":"张伯寿","text":"家住清湘云外窟，肯随玉笋同班。\n竹林风味正相联。\n独高霜外节，微露管中斑。\n吏隐丛祠聊寄傲，胸襟半是湖山。\n此君端可助跻攀。\n支颐供鹤立，拱膝看鳌翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其四","author":"张伯寿","text":"龙首凤池家鼎贵，庆传仙李芬芳。\n凛然冰雪照闺房。\n诞弥当此日，佳气满华堂。\n锦袖新封开大国，诏书急欲徵黄。\n莫辞沉醉九霞觞。\n蟠桃看子实，地久与天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二","author":"张伯寿","text":"吴越家声传铁券，当年功指山河。\n公侯衮衮后来多。\n休符钟俊杰，气宇禀冲和。\n磊落胸襟清庙器，鹏程背可天摩。\n他时帝里笑鸣珂。\n双椿犹鹤算，二女已鸾坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一","author":"张伯寿","text":"天上姮娥元不老，人间紫府长春。\n朱颜鹤发更清新。\n观音常自在，水月净无尘。\n有子飘飘麟阁像，有孙庭下诜诜。\n他年看取递成名。\n进封加上国，荣拜太夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其五","author":"张伯寿","text":"瑞气薰城春色早，光生帘幕飞浮。\n五陵应是产风流。\n冰清兼玉润，轩冕一时游。\n已得长生元妙术，庄椿不数春秋。\n徐卿一醉百无忧。\n但知从此去，衮衮出公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其六","author":"张伯寿","text":"爆竹声残天未晓，金炉细爇沉烟。\n儿孙戏彩映芳鲜。\n共倾元日酒，同祝大椿年。\n我愿儿孙如我寿，高低富贵随缘。\n不须厚禄与多田。\n诗书为世业，清白是家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄沈菊山","author":"张伯垓","text":"八十乾淳老，生涯半子虚。\n久无朝士馈，空有故人书。\n诗道穷方进，尘缘老尽除。\n茫茫天壤阔，谁复是知予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题椿桂堂","author":"张伯垓","text":"进士从来荣一第，至比梯云仰攀桂。\n弟兄罕见五枝芳，昔说窦郎今莫氏。\n莫氏一门真可荣，二难三秀众美并。\n见闻叹羡不易及，往往笞儿亲短檠。\n堂下荷衣戏成伍，堂上椿龄奉慈母。\n母夫人是月中娥，种得森森桂如许。\n飞腾从此上天衢，岂但森森月桂如。\n更看勋名相炤耀，连珠光彩夺星榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"张伯威","text":"壶中别景绝尘埃，不是山灵閟不开。\n午夜月华冬夜雪，为无人向此时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题双峰显祖院","author":"张伯常","text":"煖脉匀青地上苔，拂尘题柱记花开。\n海风一夜吹山雨，却送春寒入寺来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿难老堂","author":"张伯常","text":"漆园秋净夜堂虚，偶伴横林隐者居。\n纸绉白云垂帐厚，荻筛明月下帘疏。\n玉棋子夺三军令，金剪刀翻数体书。\n疏广拂衣惭不早，芰荷舟舫草茅芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"性地颂 其四","author":"张伯端","text":"一物含闻见觉知，盖诸尘境显其机。\n灵常一物尚非有，四者凭何作所依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"性地颂 其五","author":"张伯端","text":"不移一步到西天，端坐诸方在目前。\n项后有光犹是幻，云生足下未为仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"性地颂 其二","author":"张伯端","text":"如来妙体遍河沙，万象森罗无障遮。\n会得圆通真法眼，始知三界是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其四","author":"张伯端","text":"释氏教人修极乐，亦缘极乐是金方。\n大都色相惟兹实，馀二非真谩度量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其二","author":"张伯端","text":"投胎夺舍及移居，旧住名为四果徒。\n若解降龙并伏虎，真金起屋几时枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句 其一","author":"张伯端","text":"饶君了悟真如性，未免抛身却入身。\n何似更兼修大药，顿超无漏作真人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六十四","author":"张伯端","text":"修行混俗且和光，圆即圆兮方即方。\n显晦逆从人莫测，教人争得见行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六十三","author":"张伯端","text":"祸福由来互倚伏，还如影响相随逐。\n若能转此生杀机，返掌之间灾变福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六十二","author":"张伯端","text":"须将死户为生户，莫执生门号死门。\n若会杀机明返覆，始知害里却生恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六十一","author":"张伯端","text":"未鍊还丹须急鍊，鍊了还须知止足。\n若也持盈未已心，不免一朝遭殆辱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其六十","author":"张伯端","text":"了了心猿方寸机，三千功行与天齐。\n自然有鼎烹龙虎，何必担家恋子妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十九","author":"张伯端","text":"饶君聪慧过颜闵，不遇师传莫强猜。\n只为丹经无口诀，教君何处结灵胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十八","author":"张伯端","text":"阴符宝字逾三百，道德灵文止五千。\n今古上仙无限数，尽于此处达真诠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十七","author":"张伯端","text":"三才相盗食其时，此是神仙道德机。\n万化既安诸虑息，百骸俱理證无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十六","author":"张伯端","text":"大药修之有易难，也知由我亦由天。\n若非积行施功德，动有群魔作障缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十五","author":"张伯端","text":"赫赤金丹一日成，古仙垂语实堪听。\n若言九载三年者，尽是推延款日程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十四","author":"张伯端","text":"药逢气类方成象，道合希夷即自然。\n一粒金丹吞入腹，始知我命不由天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十三","author":"张伯端","text":"敲竹唤龟吞玉芝，鼓琴招凤饮刀圭。\n近来透体金光现，不与常人话此规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十二","author":"张伯端","text":"欧冶亲传铸剑方，莫耶金水配柔刚。\n鍊成便会知人意，万里诛妖一电光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十一","author":"张伯端","text":"万物芸芸各返根，返根复命即长存。\n知常返本人难会，妄作招凶众所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句六十四首 其五十","author":"张伯端","text":"不识阳精及主宾，知他那个是疏亲。\n房中空闭尾闾穴，误杀阎浮多少人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":53287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]