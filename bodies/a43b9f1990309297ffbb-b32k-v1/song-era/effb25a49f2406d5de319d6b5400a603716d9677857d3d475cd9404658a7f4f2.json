[{"title":"会稽智印大师可升复为僧正因寄","author":"赵抃","text":"突兀浮图烈燄焚，入云千尺一朝新。\n闻师领众非辜罢，今复如初慰越人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁子正哀词二首 其一","author":"赵抃","text":"一节循循见始终，平常心有古人风。\n临行却笑庞居士，何用当庭探日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁子正哀词二首 其二","author":"赵抃","text":"函中赤轴谁能捲，壁上孤琴已绝弦。\n付与儿孙有清德，临风何必更潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天台蛇洞","author":"赵抃","text":"道猷宴坐卓一锡，萧然屏去群魔迹。\n大蛇开口合不得，始知三昧通神力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内照庵","author":"赵抃","text":"山老榜庵名内照，掩扉默坐徒观妙。\n欲知毕竟事何如，无量寿光悬两曜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿漫岭","author":"赵抃","text":"昨朝初泛临海舟，今暮已登漫岭驿。\n秋风阁雨波不扬，风伯江神俱有力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因海印行感旧寄蜀中故人","author":"赵抃","text":"我车出蜀十年强，感旧情怀未尽忘。\n有问老衰师为道，心如冰雪鬓如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和二苏题白鹤观二首 其一","author":"赵抃","text":"黄衣道士骨朽矣，白鹤仙翁诗宛然。\n君傥不能来一顾，壁间磨灭有谁传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和二苏题白鹤观二首 其二","author":"赵抃","text":"不逢棋酒与莺花，古观高吟字字嘉。\n好事独来终日赏，诸翁争去著诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其一 高斋","author":"赵抃","text":"轩外长溪溪外山，捲帘空旷水云间。\n高斋有问如何乐，清夜安眠白昼閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其二 水月阁","author":"赵抃","text":"池阁孤清瞰碧流，太虚怀抱物华秋。\n圆蟾默有中宵约，几点閒云为我收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其三 放鱼","author":"赵抃","text":"鱼不能言似可哀，竭池千数竞徘徊。\n瀫江深处呼僮放，羡尔优游得所哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其四 双松","author":"赵抃","text":"少时亲手植双松，昼爱层阴夜听风。\n今日岁寒踰五纪，也应心似主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其五 竹轩","author":"赵抃","text":"暑威何处称疏慵，百本修篁小槛东。\n时遣清风送消息，此君都在不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其六 柳轩","author":"赵抃","text":"动入和风静惹烟，翠条疏处露池莲。\n林中尽是能吟物，春有黄鹂夏有蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其七 归欤亭","author":"赵抃","text":"密径修筠郊外居，小亭随意榜归欤。\n等閒早暮携筇到，池沼东头是旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其八 濯缨亭","author":"赵抃","text":"亭上秋登远目明，灈缨诚不是虚名。\n晴波一片如铺练，浮石江心彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其九 负郭田","author":"赵抃","text":"累岁辞荣得帝俞，老来天幸更谁如。\n腰间已解黄金印，归有田耕二顷馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"退居十咏 其十 望南山","author":"赵抃","text":"乌巨东西气候秋，子湖冈陇暮云浮。\n欲观古佛丛林地，只用凭栏一举头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常山县公姚存哀词二首 其一","author":"赵抃","text":"爪期终代促装前，常遗吾书索赠言。\n今日却成哀挽句，霜风江上送灵幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常山县公姚存哀词二首 其二","author":"赵抃","text":"威惠三年邑政优，平生志业未经酬。\n嗟嗟故里松楸老，先陇归陪地下游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄灵隐圆明禅师","author":"赵抃","text":"故人相别岁时多，日欲为书奈懒何。\n犹喜个中无间断，西轩云岫碧嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐木为鱼寄名山主","author":"赵抃","text":"森森乔木得诸邻，雾锁云埋不记春。\n报得看看鳞角就，为君惊起梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景仁寄超化长老","author":"赵抃","text":"千里无书信却通，瀫江南畔石桥东。\n春来消息谁传去，落尽林花一夜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁日示众","author":"赵抃","text":"今年年是去年年，此处何曾有变迁。\n穿耳胡僧曾说破，梅花落尽柳生烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠远上人壁","author":"赵抃","text":"烧香运水及煎茶，谁识庐山惠远家。\n社客若来高著眼，不须平地觅莲花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登真岩","author":"赵抃","text":"殿阁凌空锁翠岚，雪晴春色在松杉。\n芝骈羽驾归何处，留得双乌宿旧岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九峰岩","author":"赵抃","text":"龙丘石室人难继，安正书堂世莫登。\n但见烟萝最高处，九峰排列一层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引流联句","author":"赵抃","text":"别派从江垠，邀流入农畎。\n淙淙来源深，㶁㶁度沟浅。\n园穿萧艾芟，堑断荆綦剪。\n疏功浃长长，溉利和步远。\n田观疑泽潴，坎听类瓴建。\n北溟归凿池，幽岳漾装巘。\n泻埤纹湍驶，回湾波细转。\n过窦石眼窥，经虚土口吮。\n浮行值落叶，浸长逢生藓。\n孤鹤眼怪觇，纤鱼鬣跳展。\n中沈无秽淤，底净有纹■。\n映苇色莫分，喧琴韵难辨。\n增霖人闹蛙，涵月夜惊犬。\n侵篁鞭起萌，逼水低垂菌。\n怜黄浇菊篱，惜紫沃兰畹。\n吏咨窑甓甃，童戏芒车卷。\n灌携令手劳，漱掬致腰俛。\n庭秋临加凉，轩夏尚消烜。\n我矜近济能，僮贺遥汲免。\n贮戺埋巨甔，归厨架修笕。\n供掏饭盎粮，给澳羹鼎脔。\n调药修臼饵，煎茶试罗荈。\n坐客频泛觞，蹲儿屡洗砚。\n聆寒心脱烦，挹冷酒除湎。\n壅挑筇步随，静看髭吟撚。\n高怀造文摅，清兴团诗遣。\n瑰章非俗成，怪句自幽选。\n涌词波翻瀛，绵意绪抽茧。\n书丹字隶行，款碣石磨琬。\n题为引流篇，记耳非自衒。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游武夷山","author":"赵抃","text":"武夷之山千万峰，溪水诘曲流其中。\n喷云涌雪可□楫，一棹无览仙人踪。\n白鹤昂昂写峭壁，雕虎长□□清风。\n悬崖蜕骨造化外，绝壑驾船神鬼功。\n寒岩鼎灶失鸡犬，盘石松椿腾蛟龙。\n行行自喜浣尘俗，萧散玉羽超樊笼。\n当年此日是高会，左仙右仙曲未终。\n紫星飘然天上去，曾孙虹桥路已穷。\n我生丹心涵太冲，欲脱缰锁追鸿蒙。\n上邀轩辕宴玄圃，手摘日月相游从。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青州闻雷","author":"赵抃","text":"退食公堂自凭几，不动不摇心似水。\n霹雳一声透顶门，惊起从前自家底。\n举头苍苍喜复喜，刹刹尘尘无不是。\n中下之人不得闻，妙用神通而已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题高斋","author":"赵抃","text":"腰佩黄金已退藏，个中消息也寻常。\n时人要识高斋老，只是柯村赵四郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"歙砚诗","author":"赵抃","text":"君家歙溪边，自采歙溪石。\n刓磨清泉根，刳斩紫虬脊。\n罗纹洗瑩致，蛾眉隐纤直。\n叩声清而长，触手生汗液。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应梦游","author":"赵抃","text":"龙穴藏身稳，泉源抚掌清。\n红尘人绝虑，白日世长生。\n我分谙冲寂，谁能顾利名。\n梦中休指笑，又作洞霄行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒广慈大师诗颂 其一","author":"赵抃","text":"乞得乡州乐矣哉，雪峰安静此徘徊。\n浙江莫谓音书隔，一日潮声两度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒广慈大师诗颂 其二","author":"赵抃","text":"大空西山小空东，侍者神通未知穷。\n庵来不言还作么，数珠提起□裴公。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重游龙井","author":"赵抃","text":"湖山深处梵王家，半纪重来两鬓华。\n珍重老师迎意厚，龙泓亭上点龙茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥","author":"赵抃","text":"晓登山阁一炉香，瞻企神僧到上方。\n人度石桥何所畏，如来原是世津梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题甘棠楼","author":"赵抃","text":"阑干十二压仙瀛，占得龙峰作画屏。\n林映远笼千里月，湖光寒照一天星。\n望来瀑布真霜练，飞过沙禽半雪翎。\n人赏不知春已老，隔桥依旧柳青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绣川湖","author":"赵抃","text":"东南山水闻之久，未省人曾说义乌。\n万顷波涛惊客眼，始知中有绣川湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上赵少师","author":"徐积","text":"义高德厚贤在躬，进荣退美光初终。\n越有神明相元功，疾忧之外康宁中。\n乃眷乃顾爰徂东，徒御虽寡人望雄。\n其高可仰厚可宗，兹行允美江淮风。\n父老相呼告儿童，三朝无事繄厥忠。\n公谋公惠世所蒙，肆安于贾田安农。\n温衣蔽体食饱胸，小攘大窃消奸凶。\n州牢县狱囚多空，欢心和气成年丰。\n汝曹虽騃念所从，汝心汝貌加爱恭。\n薪蒸勿采米勿舂，亟歌屡舞驰省公。\n有人昔与公车逢，汝阴颍尾洛与嵩。\n山有迹兮水有踪，水之鹤兮山之松。\n一朝赐号逍遥翁，马资仆费官与供。\n汝曹努力吾老癃，公若再来勤筑宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又题祠馆","author":"赵抃","text":"德泽涵濡得二难，百年祠馆见遗安。\n苍苍一片坟台石，留在行人下马看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题石龙山","author":"赵抃","text":"石龙山顶拔巍颠，我此登临骨凛然。\n直上更无容足地，速回犹在夕阳天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东报恩寺","author":"赵抃","text":"松撼寒声竹锁阴，梵宫潇洒称行吟。\n庭前花意自荣落，门外山光同古今。\n夜榻近轩孤月满，晓锄寻药乱云深。\n中间若了休休事，不信欢愁解到心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题瑞岩圣寿寺","author":"赵抃","text":"宝界香园接翠微，此焉空寂远尘机。\n寒冰扣晓人无垢，古剑藏秋谷有辉。\n水石潺顽迷客径，松云洒落护禅扉。\n我来笑被名缰锁，斜日匆匆策马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵抃","text":"马寻旧路知归去，龟放长淮不再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"赵抃","text":"乍辞龙尾道，来刺虎头城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"赵抃","text":"灵山一片云边雨，每为熙朝作岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引流联句","author":"赵扬","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"引流联句","author":"赵抗","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"王照","text":"回首高斋拭泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"信相院慧灯","author":"范镇","text":"行乐到萧寺，像殿何煌煌。\n僧年过九十，细话灯焰长。\n方忆髫龀时，初离父母乡。\n是时循旧迹，昼夜不暂忘。\n自事膏火来，日就与月将。\n始卒未尝暗，眉发皆如霜。\n禦风设绛纱，求福兼异香。\n寒村会织女，借馀坐如匡。\n陋巷苦志士，凿壁偷邻光。\n太息日已暮，百结忡心肠。\n类此事亿万，聊书成短章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送程端明再镇成都","author":"范镇","text":"成都一都会，千里带坤维。\n自昔公坐啸，至今人去思。\n朝廷慎东注，方面要安绥。\n遂尔重藩屏，因之职殿帷。\n龙光出剑匣，讴颂走江湄。\n晓雪离都驭，春风入境旗。\n壶浆故父老，竹成旧童儿。\n叠足相欢跃，同心仰福禧。\n邦人顾若此，邑子更何其。\n会讲中和化，重为乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游昭觉寺","author":"范镇","text":"炎蒸无处避，此地忽如寒。\n松砌行无际，石房禅自安。\n鸳鸯秋沼涨，蝙蝠晚庭宽。\n登眺见田舍，衡茅半不完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净众寺新禅院","author":"范镇","text":"金寺西郊外，一来烦恼摅。\n凡逢似仙境，鲜不属僧居。\n岸绿见翘鹭，溪清无隐鱼。\n残阳已周览，欲去几踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武侯庙柏","author":"范镇","text":"满叶是清霜，培根无沃土。\n耻作秦皇松，宁为冯异树。\n英灵自有风，荫蔚长如雨。\n可怜青青姿，不知人事古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题张少愚屋壁","author":"范镇","text":"高隐郫城下，平地仍径还。\n门开值冠盖，帘卷为江山。\n沛雨人间待，浮云天外閒。\n泥封诏不起，明夕奉慈颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送罗胜卿同年提举玉局观","author":"范镇","text":"匹马西归去，知君得意偏。\n人情重乡里，官职更神仙。\n晓后无衙喏，旬头有俸钱。\n何须驾白鹤，辛苦上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送罗郎中登管勾玉局观","author":"范镇","text":"五门门里观，松桧日萧疏。\n道话忘心境，仙歌作步虚。\n坛场高突兀，廊庑四纡馀。\n世事多纷扰，君心定了如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩太丞同守成都次韵 其一","author":"范镇","text":"盛府佳招贵，严宸雅寄深。\n舆题仲举坐，阙挂子牟心。\n汉竹分新契，潘花过旧阴。\n当年百里骥，方此试骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩太丞同守成都次韵 其二","author":"范镇","text":"近境连桑陌，先游盛竹林。\n并将怀旧意，持作惠时心。\n藻思春生笔，清机月满襟。\n成风锦江曲，迥上玉山岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩太丞同守成都次韵 其三","author":"范镇","text":"春色草将深，春寒柳未阴。\n青天指行栈，渌水荡离襟。\n后乘何为托，前旌喻此心。\n南枝倦飞翼，凭为寄归音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲远龙图见邀学射之游先寄五十六言","author":"范镇","text":"几年魂梦寄西州，春晚归逢学射游。\n十里香风尘不动，半山晴日雨初收。\n指撝武弁呈飞骑，次第红妆数胜筹。\n夹道绮罗瞻望处，管弦旌旆拥遨头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和阎寺丞海云寺","author":"范镇","text":"春日金田驩且哗，始因民俗好纷奢。\n管弦齐奏喧闻野，莺燕高飞不在花。\n雕槛凭时见城郭，回廊行处有烟霞。\n方塘灵石从来信，不独当年太守誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登崇圣阁","author":"范镇","text":"金地环回半锦城，累年斤斧不停声。\n远村民舍烟未起，满寺僧筵钟尽鸣。\n栏槛高低资眺览，市廛言笑尚分明。\n阿房昔日徒虚语，壮丽应亏此画楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和提刑海棠","author":"范镇","text":"不知真宰是谁专，生得韶光此树偏。\n吟笔偶遗工部意，赋词今识翰林权。\n风翻翠幕晨香入，霞照危墙夕影连。\n移植上园如得地，芳名应在紫薇先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和成都吴仲庶见寄来韵 其一","author":"范镇","text":"岁华今缓昔如流，旧日樊笼可自由。\n官事了时无尽极，人生安处且閒休。\n愚忠皎皎丹心老，归思绵绵两鬓秋。\n纵使海棠时节过，急行须及浣花游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和成都吴仲庶见寄来韵 其二","author":"范镇","text":"濯锦江深惠泽流，西人都未究踪由。\n耕畴拥耒春还动，织户鸣机夜不休。\n讲德定应劳四子，富民须合用千秋。\n凤凰台上需贤久，却恐龟城作暂游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和成都吴仲庶见寄来韵 其三","author":"范镇","text":"山横双剑水双流，栖北巢南去未由。\n三尺素琴弹浩浩，一炉丹药咏休休。\n白岩霜重红梨晓，银砾烟深紫芋秋。\n每夜梦魂归处路，只应明月见神游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题曹山人墅居","author":"范镇","text":"桥外浣花溪水通，山人高隐在其中。\n一江丝竹喧天沸，争及松篁半日风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":38070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]