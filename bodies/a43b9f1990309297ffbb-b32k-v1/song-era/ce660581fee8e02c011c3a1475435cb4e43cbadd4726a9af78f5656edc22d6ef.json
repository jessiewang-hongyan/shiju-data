[{"title":"春日田园杂兴","author":"姜霖","text":"老盆倾酒试新尝，社鼓村村闹夕阳。\n麦陇风微牛睡稳，芹塘泥滑燕归忙。\n半村飞雨断烟湿，一径落花流水香。\n鼎贵安知此中意，徒能学犬吠村庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"东必曾","text":"噀绿郊原春事深，治生幽趣豁尘襟。\n声声禽语耕人意，种种花开老圃心。\n桑叶渐舒梯欲整，麦苗暗长路难寻。\n日长虽有荷锄倦，薄暮归来常醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"朱孟翁","text":"饾饤蔬槃已竹萌，如何布谷未催耕？\n牧儿懒散骑牛过，游子牵连信马行。\n秧际窥鱼翘白鹭，花间捎蝶下黄莺。\n东风岁岁添新绿，独我霜髯多几茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"赵必拆","text":"一段佳山水，芳时事正妍。\n犊耕青烧雨，鹤卧碧桃烟。\n社老邀尝煮，邻僧伴摘鲜。\n莫嫌陶令拙，农圃得馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"许元发","text":"片云岂是出山时，曾被东风误一吹。\n归意不烦啼鴂劝，閒情只许落花知。\n桑麻穷巷扉常掩，烟火空林黍自炊。\n栗里辋川非谬计，晴窗仔细味渠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"洪贵叔","text":"弃官杜甫罹天宝，辞令陶潜叹义熙。\n暖日浣溪仍旧迹，春风栗里只前时。\n苗生阡陌培嘉种，花绕林塘发故枝。\n佳兴二公能领会，可能胸次太多诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"朱释老","text":"家山万象春归好，诗笔拈来感物情。\n泉脉动时毋待灌，土膏起处正宜耕。\n无穷怀抱风和畅，不尽形容雨发生。\n试问封侯万里客，何如守拙晋渊明？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"李萼","text":"村居只是旧衣冠，北墅南园熟往还。\n雨外泥深牛觳觫，花边风暖鸟间关。\n躬耕自得莘郊乐，日涉谁知陶径閒。\n只说桑麻元自好，不须释耒叹时艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"蔡潭","text":"云过催花雨，风收困麦烟。\n一锄天地里，三月翠红边。\n朝市虽无梦，郊墟似有缘。\n种瓜何代叟，岂识趣熙然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"陈舜道","text":"春来非是爱吟诗，诗是田园乐兴时。\n清入吟怀花月照，红生笑面柳风吹。\n村声荡耳乌盐角，社酒柔情玉练槌。\n閒闷閒愁侬不省，春来非是爱吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"吴㻦","text":"野水浑边戏乳鹅，疏篱缺处晒耕蓑。\n草青随意牛羊卧，门静无人燕雀多。\n夫倦倚犁需妇馌，翁欢击壤和孙歌。\n新来别有营生计，又喜巡檐住蜜窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"黄景昌","text":"野色摇春麦正肥，烟村閒寂往还稀。\n未多桑叶蚕初浴，更小茅茨燕亦飞。\n行市绿蛆花泼眼，卧依黄犊草侵衣。\n数声桐角归来晚，杨柳移阴月半扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴三首","author":"戴东老","text":"饮了椒盘收了灯，翁携稚子步新晴。\n茅柴初熟胜腊酝，莱菔久齑宜晚羹。\n伏卵鸡留上春种，出栏牛试吉辰耕。\n去年官赋今年罢，寂甚柴门犬吠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凌波辞赋水仙花","author":"彭九万","text":"岁芳兮婉冉悲，江空兮兰枻归。\n人婵媛兮何来迟，憺风魂兮佩谁思。\n素衣兮俨黄里，玉襦兮明翠被。\n明波渟渟兮渺愁予，含香怀春兮中心苦。\n昔遗褋兮今契阔，伫佳期兮窅修绝。\n幻尘缘兮蹇中忧，时既晏兮不可留。\n汎云軿兮水裔，糺余瑟兮难理。\n人奚归兮路苍茫，湘有皋兮春绿起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵太史","author":"艾性夫","text":"轻柔杨柳挟春妍，孤梗梅花结雪缘。\n此是乾坤大消息，相逢切莫说流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"朱浚","text":"西风落叶长安梦，晚节寒花老圃心。\n玉帐分兵赋采薇，梅华吹雪上戎衣。\n将军意气中流楫。\n丞相功名采石矶。\n金寒霜气山无虎，剑动星光水有龙。\n皇帝当年第九春，宫符仍诏刻麒麟。\n军咨祭酒金台夜，国子先生铁璧人。\n落花水煖千船聚，芳草春深一鹤归。\n米车已过尘迷路，渔网才收月满船。\n海燕故人意，杜鹃游子心。\n故里千山隔，终年一字无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其一","author":"梁相","text":"膏雨初晴布谷啼，村村景物正熙熙。\n谁知农圃无穷乐，自与莺花有旧期。\n彭泽归来惟种柳，石湖老去最能诗。\n桃红李白新秧绿，问著东风总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其二","author":"梁相","text":"麦畴连草色，蔬径带芜痕。\n布谷叫残雨，杏花开半村。\n吾生老农圃，世事付儿孙。\n但遇芳菲景，高歌酒满尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题岳王墓","author":"韩信同","text":"妖星坠地芒角赤，剑龙悲吼国萧瑟。\n中原王气挽不回，将军一死如毛掷。\n秦家小儿真戏剧，播弄造化摇枢极。\n指雠为亲忠且逆，只手上遮天眼碧。\n九重茫茫隔天日，无由下烛臣愚直。\n臣愚万死不足惜，国耻未湔犹愤激。\n古坟埋冤血空沥，风雨年年土花蚀。\n我恐精忠埋不得，白日英魂土中泣。\n请将衰骨斲出荒苔痕，献作吾王补天石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽言 其一","author":"梁栋","text":"脱却布裤，贫家能有几尺布！\n寒机剪尽无可裁，可人不来廉叔度。\n脱却布裤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽言 其二","author":"梁栋","text":"不如归去，锦宫宫殿迷烟树。\n天津桥上两三声，叫破中原无住处！\n不如归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽言 其三","author":"梁栋","text":"提葫芦，今年酒贱频频沽。\n众人皆醉我亦醉，哀哉谁问醒三闾！\n提葫芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四禽言 其四","author":"梁栋","text":"行不得也哥哥，湖南湖北秋水多。\n九疑山前叫虞舜，奈此乾坤无路何！\n行不得也哥哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登大茅峰","author":"梁栋","text":"杖藜绝顶穷追寻，青山世路争岖嵚。\n碧云遮断天外眼，春风吹老人间心。\n大龙上天宝剑化，小龙入海明珠沈。\n无人更守玄帝鼎，有客欲问秦皇金。\n巅崖谁念受辛苦，古洞未易潜幽深。\n神光不破幽暗恼，山鬼空作离骚吟。\n我来俯仰一慷慨，山川良昔人民今。\n安得长松撑日月，华阳世界收层阴。\n长啸一声下山去，草木为我留清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其一","author":"魏新之","text":"农圃谁言与世违，韶华正恐属柴扉。\n天机花外闻幽哢，野色牛边睨落晖。\n膏雨平分秧水白，光风小聚药苗肥。\n行歌隐隐前村暖，忽省深山有蕨薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴二首 其二","author":"魏新之","text":"野景入时务，东风斸满锄。\n笛声牛出后，酒味燕来初。\n谷种天心在，桑枝帝泽馀。\n红尘几飞鞚，肯信有农书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水村歌","author":"钱仲鼎","text":"舟摇摇兮，风袅袅兮。\n波鳞鳞兮，鸥翩翩兮。\n扣舷渔歌兮，孰知其他兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"草堂","author":"吴龙翰","text":"苍烟落日草堂深，浅浅寒侵白玉簪。\n等客不来童睡去，自摇脩竹和新吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝盖山诗刻","author":"赵永嘉","text":"青山吐出白龙开，我是地仙赵秀才。\n嘉善有鱼餐得去，永嘉有虎唤能来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其一","author":"贾云华","text":"两行清泪语前流，千里佳期一夕休！\n倚柱寻思倍懊恨，寂寥灯下不胜愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其二","author":"贾云华","text":"相见时难别亦难，寒潮惟带夕阳还。\n钿蝉金雁皆零落，离别烟波伤玉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其三","author":"贾云华","text":"倚栏无语倍伤情，乡思撩人拨不平。\n寂寞閒庭春又晚，杏花零落过清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其四","author":"贾云华","text":"自从消瘦减容光，云雨巫山枉断肠。\n独宿空房泪如雨，秋宵只为一人长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其五","author":"贾云华","text":"纱窗日落渐黄昏，春梦无心只似云。\n万里关山音信断，将身何处更逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其六","author":"贾云华","text":"一身憔悴对花眠，零落残魂倍黯然。\n人面不知何处去，悠悠生死别经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其七","author":"贾云华","text":"真成薄命久寻思，宛转蛾眉能几时。\n汉水楚云千万里，留君不住益凄其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其八","author":"贾云华","text":"魂归冥漠魄归泉，却恨青蛾误少年。\n三尺孤坟何处是？\n每逢寒食一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其九","author":"贾云华","text":"物换星移几度秋，鸟啼花落水空流。\n人间何事堪惆怅，贵贱同归土一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"集唐绝句十首 其十","author":"贾云华","text":"一封书寄数行啼，莫动哀吟易惨悽。\n古往今来只如此，几多红粉委黄泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"仙村人","text":"芳草东郊外，疏篱野老家。\n平畴一尺水，小圃百般花。\n青箬閒耕雨，红裙斗采茶。\n村村寒食近，插柳遍檐牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"东湖散人","text":"物色天成画不如，东风又到野人庐。\n蜜蜂辛苦供常课，科斗纵横学古书。\n小雨杏花村问酒，澹烟杨柳巷巾车。\n汀洲水暖芦芽长，更买扁舟伴老渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"感兴吟","text":"儿结蓑衣妇浣纱，暖风疏雨趱桑麻。\n金桃接种连花蕊，紫竹移根带笋芽。\n椎鼓踏歌朝祭社，卖薪挑菜晚回家。\n前村犬吠无他事，不是搜盐定榷茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"九山人","text":"轩裳一梦断尘寰，桑柘阴阴静掩关。\n种秫已非彭泽县，采薇何必首阳山。\n因怜社鼓刚催老，转觉儒冠不负閒。\n君看浣花台上燕，芹泥虽好亦知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"桑柘区","text":"粟爵瓜官懒觊觎，生涯云水与烟腴。\n晚风一笛麦秧陇，春雨半锄桑柘区。\n可是樊迟宜请学，肯教陶亮叹将芜。\n斜阳芳草关情处，更把新诗吊石湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"草堂后人","text":"桑眼已开芳昼长，西畴东墅足相羊。\n麦风初暖燕争垒，林雨忽晴蛙满塘。\n野老新衣逢社喜，山妻椎髻为蚕忙。\n纷纷游骑踏花去，谁识吾家旧草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日田园杂兴","author":"君瑞","text":"白粉墙头红杏花，竹枪篱下种丝瓜。\n厨烟乍熟抽心菜，篝火新乾捲叶茶。\n草地雨长应易垦，秧田水足不须车。\n白头翁妪閒无事，对坐花阴到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄子诗","author":"章某","text":"九十衰翁七十儿，此时那可两分离。\n客乡已是三年别，人世应无百岁期。\n春雁北飞频送目，夕阳西下几颦眉。\n何如及早成归计，莫待山榴开满枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"周煇","text":"捲帘试约东君问，花信风来第几番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绿头鸭","author":"贺铸","text":"玉人家，画楼珠箔临津。\n托微风、彩箫流怨，断肠马上曾闻。\n宴堂开、艳妆丛里，调琴思，认歌颦。\n麝蜡烟浓，玉莲漏短，更衣不待酒初醺。\n绣屏掩、枕鸳相就，香气渐暾暾。\n回廊影，疏钟淡月，几许消魂？\n翠钗分、银笺封泪，舞鞋从此生尘。\n任兰舟、载将离恨，转南浦、背西曛。\n记取明年，蔷薇谢后，佳期应未误行云。\n凤城远、楚梅香嫩，先寄一枝春。\n青门外，只凭芳草，寻访郎君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶作 其十八","author":"杨简","text":"道心非动静，学者何难易。\n痴云欲扫除，迅霆无异拟。\n无妄而微疾，勿药斯有喜。\n一轮秋月明，云为岂思虑。\n太极奚可图，可图非太极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小梅花二首 其二 将进酒","author":"贺铸","text":"六国扰。\n三秦埽。\n初谓商山遗四老。\n驰单车。\n致缄书。\n裂荷焚芰，接武曳长裾。\n高阳真得杯中趣。\n身到醉乡安稳处。\n生忘形。\n死忘名。\n二豪侍侧，刘伶初未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾秋壑故第 其一","author":"无名氏","text":"楼台突兀起城围，正是襄阳失援时。\n王气已随檀板歇，仁风空逐玉箫悲。\n姓名不上忠臣传，家庙空遗御赐碑。\n万死莫酬亡国恨，故园荒草正离离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贾秋壑故第 其二","author":"无名氏","text":"当年谁敢此经过，相国门前卫士多。\n诸葛功名今已矣，周公事业竟如何。\n雕梁画栋藏鼷鼠，花础芸阶长薜萝。\n误国误人还自误，空留遗迹在山阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水宿","author":"杨应登","text":"水宿逢今雨，春归反故园。\n圣朝臣巳老，往事客何言。\n乞米分邻里，看书到子孙。\n苍茫不可会，一笑了清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵梅州","author":"杨应登","text":"江城雁叫天如水，寒色苍苍草木死。\n哀歌未断月东出，有才无命可流涕。\n今我不乐思梅州，束带深衣百僚底。\n天下规矩见卓绝，龙章麟角诸公子。\n白头时节得蛮府，归来闭门呼不起。\n惆怅平生狗马病，风后力牧长已矣。\n为公问酒日日酤，薰天富贵忧患始。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留题白龙山","author":"赵发","text":"访梅那复怕山寒，隙地原来有大观。\n云护数峰排汉表，春回万翠长林端。\n摩挲泉石襟期净，登眺楼台眼界宽。\n刷羽上林今有日，乔迁我欲快鸣翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过广陵值早春","author":"黄庭坚","text":"春风十里珠帘捲，彷佛三生杜牧之。\n红药梢头初茧栗，扬州风动鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雾凇","author":"曾巩","text":"园林日出静无风，雾凇花开树树同。\n记得集贤深殿里，舞人齐插玉珑璁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"朱淑真","text":"金井西风梧叶稀，穿针楼上月光微。\n天孙也赴今宵约，不赐人间巧样机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日观峰","author":"范致中","text":"岱岳东南第一观，青天高耸碧㠝岏。\n若教飞上峰头立，应见阳乌浴未乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"萝菔","author":"刘子翚","text":"密壤穿根蒂，风霜亦饱经。\n如何纯白质，近蒂却微青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大舟","author":"王令","text":"大舟无风船不举，小舟傍入青冥去。\n舟中渔子呼且歌，夜半斗鱼谁得多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"阙名","text":"根露苍龙脊骨寒，叶盘丹凤尾梢端。\n风雷未化秋塘影，鱼鳖长猜是钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香花 其一","author":"阙名","text":"庐阜当年春睡浓，花名从此擅春工。\n紫葩四迸呈鲜粉，如爇仙香透锦笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香花 其二","author":"阙名","text":"拿花簇粉烘晴日，蔼有浓香透远风。\n六曲阑干凝睇处，锦笼真似玉为笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"失题","author":"卢元赞","text":"初疑广寒修月手，酿此欲作长春酒。\n又疑青女未归家，抟香弄粉为此花。\n要知风韵太超绝，清影亭亭半遮月。\n微风不动香更繁，沈水未灰金博山。\n我来已落春去后，尚觉有香栖鼻端。\n年年欲占馀春住，早开却被嫣红妒。\n从今着意问春工，借与姮娥奔月路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉簪花","author":"方广德","text":"不信搔头花㡳重，数茎秋濯露溶溶。\n腰憎荆玉生前折，影比崔娘月下逢。\n摘去何人怜素腕，插来是处映秋容。\n薄愁莫减冰霜骨，十二金钗好向从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]