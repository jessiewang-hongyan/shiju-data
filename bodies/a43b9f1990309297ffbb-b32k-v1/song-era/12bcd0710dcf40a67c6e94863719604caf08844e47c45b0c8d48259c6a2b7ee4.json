[{"title":"次韵侯宣州利建招致政汪大夫","author":"苏辙","text":"社瓮壶浆接四邻，肩舆拄杖试红尘。\n惯眠林下三竿日，来看城中万井春。\n世上升沉无限事，樽前强健不资身。\n经过已足知公政，长见车中有老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵侯宣城题叠嶂楼","author":"苏辙","text":"小邑来时路，宣城最近邻。\n楼台百年旧，花竹一番新。\n登览春深日，凝思病后身。\n何时对樽酒，重为洗埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":54,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵姚孝孙判官见还岐梁唱和诗集","author":"苏辙","text":"伯氏文章岂敢知，岐梁偶有往还诗。\n自怜兄力能兼弟，谁肯埙终不听篪。\n西虢春游池百顷，南溪秋入竹千枝。\n恨君曾是关中吏，属和追陪失此时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":55,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文安国纪梦","author":"黄庭坚","text":"道人偶许俗人知，法喜非妻解养儿。\n夜久金茎添沆瀣，室虚璧月映琉璃。\n远来醉侠匆匆去，近出诗仙句句奇。\n独怪区区践绳墨，相逢未省角巾敧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵姜应明黄檗山中见寄","author":"苏辙","text":"垂老闲居味更深，此身随世任浮沉。\n北窗未厌曲肱卧，西洛能传拥鼻吟。\n疋马徬徨犹寄食，敝裘安乐信无心。\n我今漂泊还相似，同愧高僧支道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柳子玉见赠","author":"苏辙","text":"壮心衰尽愧当年，刻意为文日几千。\n老去读书聊度岁，春来多睡苦便毡。\n梦归似雁长飞去，才短如蚕只自缠。\n唯有闻诗尚思和，可能时寄最高篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柳子玉郎中见寄","author":"苏辙","text":"新年始是识君初，顾我尘埃正满裾。\n谈辩未容朝夕听，情亲空愧往还书。\n久闻笔阵无前敌，更拟诗坛托后车。\n待得入城应少暇，相从有约定何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柳见答","author":"苏辙","text":"桂酒无人寄豫章，羁愁牢落遣谁当。\n烹煎崖蜜真牵强，惭愧山蜂久蓄藏。\n江上鲙鲈橙正熟，山头吹帽菊初香。\n漂流异日俱陈迹，笑说过从想未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":60,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵柳真公闲居春日","author":"苏辙","text":"春寒渐欲减衣绵，雨势冥冥水拍天。\n一局无言消日永，新诗得意许人传。\n惜花田地应慵扫，护笋藩篱可细编。\n好事报君知我喜，同官欲到得闲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵洞山克文长老","author":"苏辙","text":"无地容锥卓，年来转觉贫。\n偶知珠在手，一任甑生尘。\n窜逐非关性，颠狂却甚真。\n此心谁复识，试语洞山人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":62,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵赵至节推首夏","author":"苏辙","text":"首夏寻芳也未迟，绕园红紫尚菲菲。\n无心与物真皆可，有酒逢人劝莫违。\n梦逐杨花无限思，身惭啼鸟不如归。\n官居寂寞如僧舍，海燕怜贫故入扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵唐觐送姜应明谒新昌杜簿","author":"苏辙","text":"夫子虽穷气浩然，轻蓑短笠傲江天。\n薄游到处唯耽酒，归去无心苦问田。\n泮上讲官殊不俗，山中老簿亦疑仙。\n相从未足还辞去，欲向曹溪更问禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":64,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵徐正权谢示闵子庙记及惠纸","author":"苏辙","text":"西溪秋思日盈笺，幕府拘愁学久骞。\n记庙终惭无好句，酹坟犹喜有前篇。\n屏除笔砚真良计，写寄交游畏妄传。\n吴纸赠君君莫怪，耕耘废罢有闲田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵偶成","author":"苏辙","text":"交情淡泊久弥新，吏役萦缠日益纷。\n香火社中真避世，簿书丛里强论文。\n樽罍正及明蟾夜，舟楫来随早雁群。\n世俗如君今有几，真将富贵等浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":66,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵黄大临秀才见寄","author":"苏辙","text":"故人聚散霜前叶，往事眇茫风际烟。\n游宦一生非有己，隐居万事不由天。\n崎岖槛阱方谋食，啸傲山林肯计年。\n赖已将心问卢老，相逢他日笑风颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵傅宏推官义方亭","author":"苏辙","text":"居近古城心自幽，箪瓢足用更何求。\n莺飞旋趁春风出，龙卧终闻莫雨搜。\n科第联翩收甲乙，乡闾惊怪问因由。\n隐君淡泊无人识，长夏一衫冬一裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":68,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景仁饮宋温之南轩二首 其一","author":"苏辙","text":"白发迎新岁，皤然国老更。\n感时能细说，对酒任徐行。\n画轴高分品，诗词妙入评。\n疏狂先醉倒，应许恃乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":69,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景仁饮宋温之南轩二首 其二","author":"苏辙","text":"饮阑瓶已罄，话久仆须更。\n高会良难得，危言岂易行。\n归休便老计，得失任台评。\n犹有青编在，它年不世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵景仁招宋温之职方小饮","author":"苏辙","text":"高人两无事，相见辄倾怀。\n时以酒相命，何妨心自斋。\n灯期飞雪乱，春候苦寒乖。\n不就颓然醉，难堪风且霾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":71,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾子开舍人四月一二日扈从二首 其一","author":"苏辙","text":"万人齐仗足声匀，翠辇徐行不动尘。\n夹道欢呼通老稚，从官杂遝数徐陈。\n旌旗稍放龙蛇卷，旒冕初看日月新。\n天遣雨师先洒道，农夫不复误占辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵曾子开舍人四月一二日扈从二首 其二","author":"苏辙","text":"衣冠双日款蓬莱，帘脱琼钩扇不开。\n清晓逮惊三殿启，翠华遥自九天来。\n晨光稍稍侵黄盖，瑞雾霏霏著禁槐。\n千两翟车观礼罢，归时满载德风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":73,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵温守李钧见寄兼简毛大夫","author":"苏辙","text":"梁苑相从簿领中，清风相逐画船东。\n婆娑江海凌云鹤，饮啄笼樊失渚鸿。\n别后丹砂迷旧诀，愁来白发变衰翁。\n此间诗老仍勍敌，正忆高吟酒盏空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程相公以柳湖久涸辄引蔡水溉注感而成咏二首 其二","author":"苏辙","text":"老鱼呴鬣困无津，凿破灵河涨旧濆。\n明月还从沙渚见，红尘却傍柳堤分。\n急泉垂下长虹尾，駴浪飞来白鹭群。\n范蠡如闻应更爱，解摇双桨入西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程相公以柳湖久涸辄引蔡水溉注感而成咏二首 其一","author":"苏辙","text":"鳞鳞沙脚出平湖，一喷珠玑碧有馀。\n依旧镜中横紫阁，却从天外望仙闾。\n粉花又结青莲子，金尾还跳赤鲤鱼。\n自惜支离苦为病，重来应共酒杯疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答人见寄","author":"苏辙","text":"对案青山云气腾，天将隙地养无能。\n窗扉迎署梅将溜，虚市无人冷欲冰。\n寂默忘言惭社燕，毰毸困睡比春鹰。\n深知大府容衰病，复值年来蚕麦登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":77,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答人槛竹","author":"苏辙","text":"猗猗元自直，落落不须扶。\n密节风吹展，清阴月共铺。\n丛长傲霜雪，根瘦耻泥涂。\n更种愁无地，应须剪碧芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答孔武仲","author":"苏辙","text":"白发青衫不记年，相逢一笑暂欣然。\n诵诗亹亹锯木屑，展卷骎骎下水船。\n未肯尺寻分枉直，日知凿枘有方圆。\n闲官更似扬州学，犹得昏昏昼日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":79,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵道潜见寄","author":"苏辙","text":"萧萧华发映衰容，惭愧高僧叹不逢。\n游宦终身空处处，尘埃何日退重重。\n已甘憔悴鸡群鹤，犹胜劬劳旱岁龙。\n回首不堪膏火热，试求甘露洒青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":80,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵道潜南康见寄","author":"苏辙","text":"一叶追随鱼与龙，红粳白酒幸年丰。\n也知山色遥相待，苦畏君诗欲见攻。\n乘兴风帆终日去，寻幽蜡屐及春同。\n请君先入开先寺，待濯清溪看玉虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":81,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵韩宗弼太祝送游太山","author":"苏辙","text":"羡君官局最优游，笑我区区学问囚。\n今日登临成独往，终年勤苦粗相酬。\n春深绿野初开绣，云解青山半脱裘。\n回首红尘读书处，煮茶留客小亭幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":82,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵筠守毛维瞻司封观修城三首 其一","author":"苏辙","text":"北垣荆棘旧成堆，留待公来次第开。\n车马已通城下路，榛芜尽付冶家灰。\n异时碧瓦千门合，应记红旌百度来。\n自笑裨谌便旷野，肩舆飞盖许追陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":83,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵筠守毛维瞻司封观修城三首 其二","author":"苏辙","text":"拨弃案头文字堆，晓晴山色四门开。\n究怀民事老虽壮，俯首山城心已灰。\n荆棘烧残桑柘出，狐狸去尽犬鸡来。\n规模先遣通蹊隧，后乘应容众客陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":84,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵筠守毛维瞻司封观修城三首 其三","author":"苏辙","text":"山脚侵城起阜堆，绕城徼道斩新开。\n闉阇半坏惊潮信，隍壑初深见劫灰。\n蚁聚千夫曾几日，鳞差万瓦看将来。\n史君才力轻山郡，朝论行闻急召陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":85,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汝南示三子","author":"苏辙","text":"此生赖有三男子，到处来看老病翁。\n饮食粗便鱼稻足，音尘不隔马牛风。\n道场莫问何方是，舍宅元依毕竟空。\n且尔不归归亦得，汝曹免复走西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":86,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江州五咏 其一 射蛟浦","author":"苏辙","text":"万骑巡游遍，千帆破浪轻。\n射蛟江水赤，教战越人惊。\n山转楼船影，岸摧连弩声。\n祈招无为赋，酣寝尽平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":87,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江州五咏 其三 庾楼","author":"苏辙","text":"元规情不薄，上客有殷生。\n夜半酒将罢，公来坐不惊。\n舞翻江月迥，谈落麈毛轻。\n尘世风流尽，高楼空此名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":88,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州萧丞相楼二首 其一","author":"苏辙","text":"绕郭青峰睥睨屯，入城流水縠文翻。\n楼成始觉江山胜，人去方知德业尊。\n坐久浮云霾后岭，酒醒飞雪变前村。\n我来邂逅公归国，犹喜登临共一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":89,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池州萧丞相楼二首 其二","author":"苏辙","text":"丞相风流直至今，朱栏仍对旧山林。\n奔驰轩冕终何有，跌宕图书意最深。\n松绕城头风瑟缩，江浮山外气阴森。\n三年不起南迁想，应有前人识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":90,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自黄州还江州","author":"苏辙","text":"身浮一叶返湓城，凌犯风涛日夜行。\n把酒独斟从睡重，还家渐近觉身轻。\n岸回樊口依稀见，日出庐山紫翠横。\n家在庾公楼下泊，舟人遥指岸如赪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":91,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至池州赠陈鼎秀才","author":"苏辙","text":"淮阳学舍旧相依，常诵曹溪第一机。\n却到江西心有悟，回看过去事皆非。\n孤舟远适身如寄，二顷躬耕道自肥。\n欲看齐山君去否，闲中徒侣近来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":92,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西成","author":"苏辙","text":"野老端相庆，西成仅十分。\n寒来多酿酒，客过预留饙。\n近事姑求饱，远忧要浪闻。\n一壶真有理，终日得醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":93,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观大阅","author":"苏辙","text":"承平郡国减兵屯，唯有留都一万人。\n票姚将军思出塞，从横幕府讳和亲。\n旌旗不动风将转，部曲无声马亦驯。\n八阵且留遗法在，未须亲试革车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":94,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过毛国镇夜饮","author":"苏辙","text":"风格照人华省郎，江山绕郭古仙乡。\n漫传铅鼎八百岁，未比金钗十二行。\n不动歌声人已醉，旋闻诗句夜初长。\n簿书拨尽知馀力，道院清虚顷未尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":95,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过王介同年墓","author":"苏辙","text":"平生使气坐生风，徐叩方知学有功。\n应奉读书无复忘，虞翻忤物自甘穷。\n埋根射策久弥奋，投老为邦悍莫攻。\n坟木未须惊已拱，少年我亦作衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":96,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过侄寄椰冠","author":"苏辙","text":"衰发秋来半是丝，幅巾缁撮强为仪。\n垂空旋取海棕子，束发装成老法师。\n变化密移人不悟，坏成相续我心知。\n茅檐竹屋南溟上，亦似当年廊庙时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":97,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问蔡肇求李公麟画观音德云","author":"苏辙","text":"好事桓灵宝，多才顾长康。\n何尝为人画，但可设奇将。\n久聚要当散，能分慰所望。\n清新二大士，畀我夜烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":98,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴晴不定简唐觐秘校并敖吴二君五首 其五","author":"苏辙","text":"二子薪中楚，相携泮上游。\n齑盐聊度日，爻象久忘忧。\n寂寞君何病，驱驰我自羞。\n何时采芹处，永日看凫鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":99,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴晴不定简唐觐秘校并敖吴二君五首 其四","author":"苏辙","text":"西邻豫章客，病骨瘦栾栾。\n清夜眠孤枕，终朝饱一箪。\n雨多愁不出，讲罢未应餐。\n约我晴相过，门前泥欲乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴晴不定简唐觐秘校并敖吴二君五首 其三","author":"苏辙","text":"涨江方断渡，小棹信轻生。\n贫贱谁怜汝，漂浮空自惊。\n一官终窃食，何计早归耕。\n忽发骚人恨，凄凉久未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴晴不定简唐觐秘校并敖吴二君五首 其二","author":"苏辙","text":"蚕眠初上簇，麦熟正磨镰。\n云气重重合，江流夜夜添。\n荐饥人甚困，多病我仍兼。\n欲就桥南宿，单衣莫雨沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阴晴不定简唐觐秘校并敖吴二君五首 其一","author":"苏辙","text":"积雨春连夏，新晴忽复阴。\n江痕涨犹在，梅气润相侵。\n蕉纻还须脱，图书渐不禁。\n江南旧风俗，愁绝北来心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余居高安三年每晨入莫出辄过圣寿访聪长老谒方子明浴头笑语移刻而归岁月既久作一诗记之","author":"苏辙","text":"朝来卖酒江南市，日莫归为江北人。\n禅老未嫌参请数，渔舟空怪往来频。\n每惭菜饭分斋钵，时乞香泉洗病身。\n世味渐消婚嫁了，幅巾绛褐许相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初成遗老斋二首 其二","author":"苏辙","text":"旧说颍川宜老人，朱樱斑笋养闲身。\n无心已绝衣冠念，有眼不遭车马尘。\n青简自书遗老传，白须仍写去年真。\n斋成谩作笑谈主，已是萧然一世宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初成遗老斋二首 其一","author":"苏辙","text":"花时懒出伴游人，暑雨深藏养病身。\n新宅丁丁厌斤斧，旧书寂寂卷埃尘。\n久将生事累诸子，顿敛浮根付一真。\n遗老斋成谋宴坐，澹然无语接来宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初成遗老斋待月轩藏书室三首 其一 遗老斋","author":"苏辙","text":"老人身世两相遗，绿竹青松自蔽亏。\n已喜形骸今我有，枉将名字与人知。\n往还但许邻家父，问讯才通说法师。\n燕坐萧然便终日，客来不识我为谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初成遗老斋待月轩藏书室三首 其二 待月轩","author":"苏辙","text":"轩前无物但长空，孤月忽来东海东。\n圆满定从何处得，清明许与众人同。\n怜渠生死未能免，顾我盈亏略已通。\n夜久客寒要一饮，油然细酌意无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初成遗老斋待月轩藏书室三首 其三 藏书室","author":"苏辙","text":"读书旧破十年功，老病茫然万卷空。\n插架都将付诸子，闭关犹得养衰翁。\n案头萤火从乾死，窗里飞蝇久未通。\n自见老卢真面目，平生事业有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到绩溪视事三日出城南谒二祠游石照偶成四小诗呈诸同官 汪王庙","author":"苏辙","text":"石门南出众山巅，沃壤清溪自一川。\n老令旧谙田事乐，春耕正及雨晴天。\n可怜鞭挞终无补，早向丛祠乞有年。\n归告仇梅省文字，麦苗含穗欲蚕眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到绩溪视事三日出城南谒二祠游石照偶成四小诗呈诸同官 梓桐庙","author":"苏辙","text":"行年五十治丘民，初学催科愧庙神。\n无限青山不容隐，却看黄卷自怜贫。\n雨馀岭上云披絮，石浅溪头水蹙鳞。\n指点县城如手大，门前五柳正摇春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初得南园","author":"苏辙","text":"倒囊仅得千竿竹，扫地初开一亩宫。\n千里故园魂梦里，百年生事寂寥中。\n晏家不愿诸侯赐，颜氏终成陋巷风。\n洗竹移花吾事了，子孙他日记衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初葺遗老斋二首 其二","author":"苏辙","text":"为留十步南墙竹，莫怪门前鸟雀多。\n陋巷何妨似颜子，势家应未夺萧何。\n诗书懒惰何曾读，气息调匀不用呵。\n多病从来少宾客，杜门今复几人过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初葺遗老斋二首 其一","author":"苏辙","text":"髭须浑白已经岁，腰痛春来日又多。\n一味安闲犹有碍，却令朝谒拟如何。\n筑居定作子孙计，好事久遭僧佛呵。\n尤愧白家履道宅，十年成就饱经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"县中诸花多交代江君所栽牡丹已过芍药方盛偶寄小诗","author":"苏辙","text":"偶来山邑便成家，惭愧潘生满县花。\n想见清樽槛边饮，尚留佳句壁间誇。\n根株未老年年好，艳色方秾日日加。\n闻道北游无意味，春深河上足风沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴冲卿夫人秦国挽词二首 其二","author":"苏辙","text":"雅颂成章早，春秋发论长。\n风规留叔向，文采似中郎。\n览古明兴废，临危喜激昂。\n南迁初不恨，李杜得从滂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]