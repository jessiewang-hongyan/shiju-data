[{"title":"偈颂七十八首 其四十一","author":"释正觉","text":"五九四十五，春风吹断前山雨。\n行云归去复何心，转背飘然无觅处。\n无觅处，知不知，坐断十方还是谁。\n东弗于代郁单越，西瞿耶尼阎浮提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十二","author":"释正觉","text":"习习春风，丝丝春雨。\n一等沾濡，十方周普。\n甘草得之甜，黄连得之苦。\n天意发丛林，檐声闹窗户。\n古德尝云己不迷，等闲教坏人男女。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十九","author":"释正觉","text":"内若不动，外必不乱，个是丛林知有汉。\n而今识得不为冤，自家兵马何须战。\n心因不生境缘断，体若虚空勿崖岸。\n霜天皎月上中峰，一段光明洗痴暗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十九","author":"释正觉","text":"赵州道有，赵州道无。\n狗子佛性，天下分疏。\n面赤不如语直，心真莫怪言粗。\n七百甲子老禅伯，驴粪逢人换眼珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十一","author":"释正觉","text":"麟龙不为瑞，珠璧不为贵。\n衲僧眼豁开，彻见生死蒂。\n生死蒂，第一义。\n诸佛心，祖师鼻。\n少林传灯，灵山授记。\n随高随下，何此何彼。\n假诸因缘，神通游戏。\n有时五教三乘，有时三德六味。\n有时屋里主财，有时门头了事。\n处处清白家风，人人见成活计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十","author":"释正觉","text":"百骸俱溃散，一物镇长灵。\n白云功尽青山秀，青山路转白云迎。\n不曾死，不曾生。\n金绳拽转泥牛鼻，半夜驱来海上耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其十四","author":"释正觉","text":"心不能缘，口不能议。\n直须退步荷担，切忌当头触讳。\n风月寒清古渡头，夜船拨转琉璃地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十五","author":"释正觉","text":"佛病法病，佛药法药。\n本色衲僧，俱不染著。\n遇饭开口，要行移脚。\n自是现成，谁能造作。\n言满天下无口过，行满天下无怨恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二","author":"释正觉","text":"同声相应，同气相求。\n同风千里，不隔丝头。\n脱尽情尘消息在，芦花江上月明秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其五十四","author":"释正觉","text":"恰恰无绫缝，明明不覆藏。\n鹫岭岂传迦叶，少林那付神光。\n现成处处合头句，具足人人知见香。\n虚空说法森罗听，不挂唇皮解举扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十一","author":"释正觉","text":"一言尽十方，万卷该不得。\n一步周八弦，驷马追不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其二十三","author":"释正觉","text":"云在青天水在瓶，几人错认定盘星。\n药山八字轰开也，恰到而今话大行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其四十七","author":"释正觉","text":"祇解恁么去，沙禽夜宿沧洲树。\n不解恁么来，石笋穿开古路苔。\n莫道鲲鲸无羽翼，今日亲从鸟道回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十四","author":"释正觉","text":"掣鼓夺旗，往往光影里走作。\n停机息杼，往往死水里浸却。\n衲僧家，稳下脚。\n没窠臼，莫栖泊。\n月树不啼猿，云巢无宿鹤。\n玄微及尽类难齐，千手大悲难摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其六十八","author":"释正觉","text":"寒岩异草，坐著成功。\n明月白云，步时分影。\n幽洞不拘关锁意，纵横那涉两头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其七十","author":"释正觉","text":"芝麻压得油，粳米炊得饭，还我丛林饱参汉。\n衲僧履道贵平怀，何必临机争转换。\n活计自然，家风成现。\n顺水便风，归舟到岸。\n寒山拾得笑呵呵，此心分付知音辨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十八首 其三十六","author":"释正觉","text":"云从龙，风从虎。\n雪峰辊毬，禾山打鼓。\n意不立玄，机不停午。\n恰恰相当用不穷，道吾觑破乐神舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八六","author":"释正觉","text":"地藏栽田做活计，南泉镰子能收刈。\n日用平怀稳便休，自然颗糁无遗弃。\n无遗弃，不容易。\n你也莫亏我，我也不亏你。\n两家宾主平，四棱齐塌地。\n风不鸣条，雨不破块，个是丛林饱参底。\n牧来纯熟水牯牛，检点将来堕随类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五七","author":"释正觉","text":"尘尘三昧，彼彼不外。\n千峰向岳，百川赴海。\n更无一法不如来，只个堂堂观自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四五","author":"释正觉","text":"吸尽西江向汝道，马师家风不草草。\n截流一棹破烟寒，天水同秋清渺渺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○七","author":"释正觉","text":"不起一念，向道须弥。\n舌头一脔肉，口唇两边皮。\n云门得用妙如许，不落是非知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十一","author":"释正觉","text":"深明无底，灵异无根。\n案山行尽，不见有家。\n识浪沥乾，不见有己。\n石女掣开金锁钥，木人拨动玉轮机。\n方信道从佛口生，法化生得佛法分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二二","author":"释正觉","text":"十月朔，风雨肇寒天意作。\n丛席地炉今日开，免烧木佛无斟酌。\n丹霞将错就错，院主眉须堕落。\n如聋如盲大家翁，搅扰杀你不要恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三十","author":"释正觉","text":"只个家风，八面玲珑。\n斗柄横而河淡，梦鹤起而巢空。\n功中退步就位，位里移身借功。\n灵灵了了处同中有异，湛湛澄澄处异中有同。\n随宜也机轮宛转，妙应也关捩虚通。\n佛子住此地，即是佛受用。\n经行及坐卧，常在于其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五六","author":"释正觉","text":"来问此经低声，大千卷自尘中出，三世佛从口里生。\n天得一以清，地得一以宁，空无依兮谷不盈。\n摩诃般若波罗密，落日渔樵歌太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十四","author":"释正觉","text":"长者长法身，短者短法身。\n虚空已是色，大地却非尘。\n觑得破阿那律祖，放得稳舜若多神。\n飘飘闲戏白鸥水，栩栩梦游蝴蝶春。\n拶头拶面推来也，眼里无筋一世贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三五","author":"释正觉","text":"一阳生，万物潜萌。\n隐隐有像，寥寥未形。\n蚌肠含妙蕴，犀角晕通星。\n密密用，细细行，本智虚融与理冥。\n露地白牛肥腻饱，拥蓑人驾雪山耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其六十八","author":"释正觉","text":"不可得一，不可得异，我如是也彼如是。\n两茎眉现燄光身，百草头扬祖师意。\n归云谁使就青山，落华自得随流水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十五","author":"释正觉","text":"一句超然，良马影鞭。\n道出语默，理合方圆。\n运斤之妙，宾主可怜。\n斲轮之伎，父子不传。\n莫将爻象兮相求龟壳，才落是非兮底事驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二○五","author":"释正觉","text":"一雨沾濡，诸根萌动。\n青黄各成其姿，长短各随其用。\n绵绵也妙有机丝，混混也廓无棱缝。\n若人问我如何，敢道不快漆桶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其三","author":"释正觉","text":"恁么去底错，恁么去底亲。\n错时错到底，亲时亲见真。\n相识满天下，知心能几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一九六","author":"释正觉","text":"若恁么，也难得，清光浩荡无瑕隙。\n人言千里本同风，我道十方浑一色。\n浑一色，须转侧。\n才转侧，透关隔。\n透关隔，酬尔平生今脱白。\n侬家龟鹤自成仙，昨夜龙门无宿客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二六","author":"释正觉","text":"王老师，足意气，是是非非荡情谓。\n倚天照雪烂光芒，扫尽搀抢千万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十三","author":"释正觉","text":"渊默之津，皓然之色。\n混处功齐，细看转侧。\n昆仑脱手黄金绳，鼻孔累垂收不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五五","author":"释正觉","text":"寻常撞搕，当面讳却。\n可怜傅大师，处处失楼阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一三二","author":"释正觉","text":"不即不离，非取非舍。\n自东自西，谁上谁下。\n委曲也顺俗亡功，蓦直也应真不借。\n珠中有火君须信，休向天边问太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一四","author":"释正觉","text":"归根得旨，叶落知秋。\n拈得鼻孔，失却舌头。\n照彻三世佛之顶?，把定历代祖之襟喉。\n玉井涵碧，冰壶断流。\n诸法空寂为之座，是须坐处不停囚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十","author":"释正觉","text":"三界唯心，唯心三界，一切法空观自在。\n处处光明处处身，者回泡幻同无碍。\n吐云如山，吞川如海，了无毛发居其外。\n万象森罗尽我家，只个虚空肚皮大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一八九","author":"释正觉","text":"九月又重阳，菊华依旧黄。\n渊明是醉不是酒，荡荡游心于大方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四六","author":"释正觉","text":"白云之宾青山伴，位里借功看互换。\n无底合盘转手擎，穿心碗子通身饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二十","author":"释正觉","text":"舌头一脔肉，口唇两片皮。\n其间无固必，分外莫猜疑。\n赵州古佛，云门圣师，历历机头不挂丝。\n自然桃李成蹊去，那是春风作意吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一○五","author":"释正觉","text":"寿等南山，位崇北斗。\n机运象先，体同道久。\n明逾日月兮普及幽深，德合乾坤兮廓无前后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十七","author":"释正觉","text":"无事题取一首，我侬不落他人后。\n略略绰绰思大口，醇醇酽酽白家酒。\n醉中犹道未沾唇，被人问著还打手。\n不打手，三年一闰，冬后数九。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一二三","author":"释正觉","text":"深深处，细细行。\n隐隐时，密密觑。\n若能恁么彻根彻，源旁参回互宛转。\n虚玄不触尊贵机，横梭度针露线穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一五","author":"释正觉","text":"当处出生，当处灭尽。\n三世如来，相授此印。\n石人放意卧烟寒，玉女摇头看晓信。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其九十九","author":"释正觉","text":"饮乾巨海，推倒须弥，廓大灵通更是谁。\n馨香秀林栴檀枝，哮吼出屈师子儿。\n三千界现一弹指，八万门开双用眉。\n知不知，为不为。\n道满十处兮心超亿劫，影流万象兮气分二仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六七","author":"释正觉","text":"静沉沉，明荡荡，雪满十方，云迷四向。\n一色影里是谁坐著功勋，百尺竿头阿你变通伎俩。\n恁么时须辨几微，恁么处须明的当。\n趁不去露地白牛，透得过流河香象。\n彻见其源，如指诸掌。\n恁么尽去也无法可传，恁么却来也有人相亮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十三","author":"释正觉","text":"正昼热，深夜凉，冰壶谁复到中央。\n身心直许摩云月，脾肺都将洗雪霜。\n莫守一色处，莫坐万年床。\n玉人转侧机梭动，细辨里头偏正方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其四十六","author":"释正觉","text":"去也五年，分疏不下，一句元无缝罅。\n只知推过商量，谁信分明酬价。\n玲珑底相知，莽卤底相讶。\n宁可与晓事人相骂，不可共不晓事人说话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一五二","author":"释正觉","text":"笊篱木杓，钱贯井索。\n受用见成，家风廓落。\n生涯放得信缘看，佛法更于何处著。\n不用安排只么从，自然心地常安乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十一","author":"释正觉","text":"佛身光明了无垢，性水清净常不浑。\n降生沐浴吉祥事，要以大开功德门。\n哆哆和和增口业，胶胶缀缀添尘结。\n大家净洗佛浑身，彻底洞然明皎洁。\n长时诸佛洗我身，今日众僧洗我佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一七○","author":"释正觉","text":"三寸舌，两片唇，无始时来赚杀人。\n解弄不教圭角露，阿谁参见跛云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十四","author":"释正觉","text":"身里出门，门里出身。\n白云能作客，明月解随人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一六八","author":"释正觉","text":"三世诸佛不知有，忉忉怛怛扬家丑。\n狸奴白牯却知有，跛跛挈挈能自守。\n弄鳖鼻兮忆南山，透法身兮藏北斗。\n风飘白雪岭头梅，春撚金丝堤上柳。\n天童也要不沾唇，三盏清源白家酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十二","author":"释正觉","text":"时行即行卓然何倚，时止即止廓尔独灵。\n历万变而不我求功，住一如而不我藏用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十一","author":"释正觉","text":"踏破草鞋赤脚走，拄杖头上挑日月。\n智门真得祖家风，放出云门广长舌。\n大智如愚，大功若拙，用尽工夫参不彻。\n莫于平地上增堆，休向虚空里钉橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一四四","author":"释正觉","text":"桃华浪里振脩鳞，一跃龙门看化身。\n谛了十方三世事，无始的的自家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十","author":"释正觉","text":"唯只一真心，三缘坐断谁升沉。\n遂成十法界，六道轮回自障碍。\n不见一法即如来，方得名为观自在。\n见怪不怪，其怪自坏。\n灵从何来，圣亦何在。\n拄杖敲时灶堕摧，一片虚明绝中外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其五十六","author":"释正觉","text":"钓尽沧波月一钩，月低烟树夜维舟。\n寒鸡抖擞呼天晓，笑对春风百草柔。\n中外夷犹，纵横自由。\n志公不是閒和尚，刀尺相将拄杖头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十八","author":"释正觉","text":"不展事，不投机。\n不徇缘，不答话。\n个是出格，辙脱窠臼。\n平生肝胆向人倾，相识犹如不相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一六","author":"释正觉","text":"雪峰之子，德山之孙，葛藤牵转难穷根。\n截断众流见源底，相应函盖同乾坤。\n长长短短无节奏，绵绵密密忒鹘仑。\n随波逐浪恁么去，上船便到家前门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七十七","author":"释正觉","text":"不是心，不是物。\n非天非人，非僧非俗。\n南北东西莫我寻，长短方圆莫我测。\n牛饮星河，兔眠月窟，彻底灵明破昏塞。\n末山超拔兮顶相不形，铁磨变通兮舌头无骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其一一八","author":"释正觉","text":"冰鉴净，玉壶寒。\n一亘清处抬脚易，十分明白转身难。\n混身转却舌头短，转却浑身鼻孔宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其二","author":"释正觉","text":"妙存湛湛不为无，真照灵灵不为有。\n更向其间退步看，白云断处青山瘦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其八十七","author":"释正觉","text":"父母所生眼，悉见三千界，拈却案山谁我碍。\n直饶全象无全牛，未免依前还碍塞。\n衲僧家，真庆快。\n物我虚空，混成一块。\n更于何处著根尘，祇个堂堂观自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二百零五首 其七","author":"释正觉","text":"吸尽西江向汝道，马师不肯落荒草。\n三千刹海一成秋，明月珊瑚冷相照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]