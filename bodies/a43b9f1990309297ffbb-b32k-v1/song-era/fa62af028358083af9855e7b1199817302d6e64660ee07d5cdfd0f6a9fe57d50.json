[{"title":"送周介之同年赴德化宰","author":"陈傅良","text":"民社须吾党，江湖足此情。\n不堪秋暑近，欲趁莫潮平。\n拙宦成华发，忧时自短檠。\n君看庐阜石，千载尚垂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周鲁山辰州法曹","author":"陈傅良","text":"团栾妻子是谁家，独被饥驱天一涯。\n远地岂无人晤语，长才能免世惊嗟。\n好于书作千年计，勿为官驱两鬓华。\n为问湖南似湖北，逾年吾亦访丹砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送孟延昌归兰溪","author":"陈傅良","text":"典同周命士，律协汉诸郎。\n师友今千载，妻孥各一方。\n发从何处白，菊有去年黄。\n惜别无多语，关雎三断章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送林叔全秩满归四明","author":"陈傅良","text":"三年绝境兴谁同，鸡叫桑巅犬巷中。\n但欲户庭多暇日，不将鞭朴奏肤公。\n相期霄汉抟风翮，每见灯花缀玉虫。\n此去逢人台阁上，丁宁莫道止斋翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范大著文叔知彭州","author":"陈傅良","text":"中书世禄今无几，唐鉴家声世不多。\n安得有人贤若此，忽闻去国意如何。\n同朝最是头先白，知己还愁语太苛。\n尽欲读书三万卷，蓬莱未必似岷峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范东叔归帅潼川","author":"陈傅良","text":"楚山黄落洞庭波，背却鸡人问钓蓑。\n归思甚于三峡壮，才名空自十年多。\n曩游记得青灯在，后会愁如白发何。\n我更有怀言不尽，故将短韵代长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑少卿景望知建宁 其五","author":"陈傅良","text":"屏废诚愚分，牢愁更索居。\n若逢知己问，犹解课儿书。\n地僻门长闭，年饥菜自锄。\n相望无一字，不是故情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑丈赴建宁五首 其二","author":"叶适","text":"有志虽身健，开心在岁寒。\n一时诸老尽，多见大名难。\n湖海方连旱，瓯闽适少宽。\n为州人不乏，千万强加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑少卿景望知建宁 其四","author":"陈傅良","text":"海内言华萼，谁名动搢绅。\n岂无当世志，能忍十年贫。\n酒兴新来减，交情老更亲。\n公馀如促膝，剩把古书陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑丈赴建宁五首 其一","author":"叶适","text":"过家乡里敬，将母士夫荣。\n得失从人论，行藏独自明。\n百年中古少，一笑万金轻。\n廉士吾何敢，新茶可撷英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑主簿泰兴解官归四明","author":"陈傅良","text":"师友于今说郑乡，亲庭分付旧行藏。\n但知职分宜栖棘，尽把声名属憩棠。\n一字未曾缘荐墨，扁舟才可著诗囊。\n问津渔浦多西笑，独为莱衣味更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送洪子端还乡","author":"陈傅良","text":"将相三陈后，文章两汉馀。\n英标还有此，天意定何如。\n海内相离合，年来半毁誉。\n未知贪尚友，孰与邺侯书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送倪正甫侍郎贺正","author":"陈傅良","text":"雪蘖冰芽又复春，中原□睹属车尘。\n欢呼汉节从天下，愕立胡儿夹道陈。\n老去独惭□偃蹇，君行决意问经纶。\n顾瞻河洛关心处，应记幽燕用事人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁诚之尉慈溪 其二","author":"陈傅良","text":"诗律吾将问，心期孰与亲。\n明朝当异县，永夜更怀人。\n尚友逢三益，明农识大臣。\n可无相问讯，勿道鬓毛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁诚之尉慈溪 其一","author":"陈傅良","text":"徐刘文采后，邹鲁典刑间。\n为母求三釜，令人见一班。\n时平无事立，地僻得官闲。\n好索梅花笑，题诗海上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送雪庵瑾禅师还山","author":"陈傅良","text":"五马逢迎甚阔疏，满朝问讯近何如。\n诸公极有迟留意，一日连收竟别书。\n佛法盛衰千劫后，人生老壮百年馀。\n向来游旧今亡恙，愿得斯人尚起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄元吉","author":"陈傅良","text":"荷君来意固非轻，曾未深交意便倾。\n语到七篇无欠少，学从三画已分明。\n每怀前此伤标置，颇欲从今近老成。\n为谢荆门三益友，何时尊酒话生平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曾继先赴山阴路钤","author":"陈傅良","text":"胡髯白尽犹强饭，髀肉添多未跨鞍。\n不向胡沙亲矢石，却来桥冢护衣冠。\n归舟自此长相背，荐墨于今尚未乾。\n只恐燕然他日事，独无名字可同刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢怀英道士归庐山 其二","author":"陈傅良","text":"一别忘年月，重来失故初。\n美髯今几尺，衔袖竟何书。\n勋业诸公在，衰迟半世馀。\n许身无补报，吾亦欲樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢怀英道士归庐山 其一","author":"陈傅良","text":"场屋收馀策，匡庐寄一瓢。\n款门如有欲，委币辄难招。\n菜甲留终夕，蒲团共小桥。\n崆峒他日问，应记说神霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瑞安尉林叔全尊人还乡","author":"陈傅良","text":"论交海内略飘零，最晚相看却有情。\n不以一经誇鲁谚，自于二子识徐卿。\n橘香剩与蜂衙晚，麦信急催鸠唤晴。\n天气正佳归恰好，莫将愁思为空名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送缙云叶正初兼简杜伯高","author":"陈傅良","text":"我固阅人非草草，君于前辈亦拳拳。\n经师未数郯夫子，笔力方窥李谪仙。\n所恨尚于收第晚，将诗空与背时传。\n频年不信灯花报，报得人来亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送德远弟赴省","author":"陈傅良","text":"科名虽细事，文字要新功。\n方拙存家学，丰腴与众同。\n江湖多我友，台省半诸公。\n为道贫非病，连檐有芥菘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潘德久之官建康","author":"陈傅良","text":"平生不解通毛刺，万事无能改鬓华。\n岂是襟怀堪逆旅，直须诗句可名家。\n老为宾客从戎幕，强使妻孥理帽纱。\n不有将军宽礼数，新愁却恐堕江花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳日寄瑞安留宰留宰以是日宴新第人并见招不及赴","author":"陈傅良","text":"落帽沾衣总失真，追随萸菊亦劳神。\n酒无肴核依然好，家有溪山岂是贫。\n沆瀣从空来夜气，青冥随处际秋旻。\n不知此是登高否，为问慈恩塔上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳和朱直方韵","author":"陈傅良","text":"衰老登临得并家，绝胜十载向天涯。\n直须与世为陶令，谨勿令人识孟嘉。\n蓝水悲吟空雅健，牛山醉墨谩攲斜。\n谁知竹叶虽无分，一笑何妨菊自花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻沈元诚归自临漳喜而奉寄","author":"陈傅良","text":"荔圃班班熟，蚝房个个肥。\n我虽缘此误，公亦为何归。\n吏事生衣垢，家山减带围。\n不无华衮字，卿月更光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除浙西宪舟过钓台有感","author":"陈傅良","text":"一再登临万事非，裹头还已雪垂垂。\n敢论笔力今无恨，欲附碑阴始不疑。\n台阁有人堪共政，江山如此且随宜。\n论功汉鼎吾何有，自是风流百代师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭吕大著至明招寺简潘叔度","author":"陈傅良","text":"小雨崇朝过，深秋薄海清。\n故人期不至，乔木眼偏明。\n欲往还何日，堪论久此情。\n侯芭幸无恙，应就太玄名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽尤延之尚书 其四","author":"陈傅良","text":"壮岁从游两鬓霜，重来函丈各堪伤。\n那知卒业今无及，极悔论心昨未尝。\n相约归期须次第，独存病骨更凄凉。\n他年赖有门生记，托在碑阴永不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽尤延之尚书 其一","author":"陈傅良","text":"自为师说竟谁宗，每事持平属此翁。\n有志政须名节是，斯文非独语言工。\n要令举世人材出，合在前朝行辈中。\n安得长年留把柁，后来各与一帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽尤延之尚书 其三","author":"陈傅良","text":"向来诸老独岿然，羸不胜衣万事便。\n灯下细书批敕字，雪边先著趁朝鞭。\n岂应无故令身健，却止功名与世传。\n遗奏定留封禅藁，凭谁吹送九重天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽王兴之提刑","author":"陈傅良","text":"四海王詹事，传家有象贤。\n宦情尘滓外，风谊典刑边。\n遗爱依前郑，群居得少连。\n生平才乐此，一梦涕潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽东阳郭德谊","author":"陈傅良","text":"簪绂何能贵，声名幸自脩。\n凡今为我友，几半与君游。\n翰墨千年托，松梧一夜秋。\n令人怀昔日，烱烱梦丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽包颙叟 其二","author":"陈傅良","text":"翁子看时辈，平生不妄贤。\n独于公有诔，惟恐世无传。\n他日须深刻，吾诗可附联。\n草黄松柏秃，名与石岿然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽包颙叟 其一","author":"陈傅良","text":"樵牧常事席，篇觞早策功。\n有怀随事见，不耻与人同。\n我故奇诸子，年来识此翁。\n待看稽古力，乔木已悲风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽木奉议 其二","author":"陈傅良","text":"盛事无虚得，玄襟可自知。\n遍观同辈行，谁似暮年时。\n衮冕趋椒殿，箫韶送玉卮。\n又宜天一笑，独此有遗悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽刘端木司户","author":"陈傅良","text":"十年共语昨来非，长忆初年握手时。\n身世自怜心炯炯，功名犹恐论卑卑。\n民彝亘古非芜没，学者如公好器资。\n缓辔徐行逢九轨，可堪倏忽九原悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴明可给事 其二","author":"陈傅良","text":"忆上诸生谒，公方薄恙侵。\n欣然蒙絮帽，恨不醉花阴。\n自说看人熟，相期晚岁深。\n半天苍岭雪，回首为沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽吴明可给事 其一","author":"陈傅良","text":"诸老俱沦落，流风日转移。\n独怀忧国意，长说渡江时。\n姓字谁如此，功名早不疑。\n却收湖海气，燕坐雪垂颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宋岩老参议 其一","author":"陈傅良","text":"居然是是亦非非，错处稠中定不疑。\n万事过人旁袖手，一生从众自观颐。\n肯为壮县虽尝试，略见周行已逆知。\n尽日杜门佳客至，小槽亲校酒醇漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽宋岩老参议 其二","author":"陈傅良","text":"少小修藏近市朝，亦非著意混渔樵。\n不为禦寇犹争席，好说渊明更折腰。\n一饭重违凡子约，千金终却故人招。\n送车几两交相唁，我独难忘最久要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张子由母","author":"陈傅良","text":"又是君王上玉卮，未央雨露湛垂垂。\n版舆此去还无恙，芝检重来更不疑。\n四世团栾能有几，百年澌尽亦堪悲。\n里中诸母今谁在，听说承平祐圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张材卿知郡","author":"陈傅良","text":"貂蝉不逮老端明，世济谁如好弟兄。\n能著青衫偕计吏，却将白发去边城。\n夜魂俄断凝香寝，秋泪仍兼曳履声。\n万石君家同一传，嗣书应更有公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张春卿尚书 其二","author":"陈傅良","text":"论建回天力，生平与众同。\n居常焚谏草，人自避乘骢。\n朝誉多张仲，家声近鲁公。\n挽辞吾不愧，收入汗青中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张春卿尚书 其一","author":"陈傅良","text":"怀抱今遗直，身名古象贤。\n路车陈左塾，笙磬在东悬。\n再世星辰上，三年雨露边。\n崎岖空老去，有识共潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽沈次卿学正","author":"陈傅良","text":"洛学传当代，家声属此翁。\n一生无世味，万事与人同。\n恨不师前郑，欣尝客阿戎。\n宜铭千古意，岂在语言工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽沈虞卿侍郎 其二","author":"陈傅良","text":"嗜古真成癖，摩挲笑眼开。\n断编遗汲冢，名篆出秦台。\n□□缘应尽，云山唤不回。\n凄凉子云宅，问字有谁来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽沈虞卿侍郎 其一","author":"陈傅良","text":"官重元非好，思閒乐有馀。\n生儿早传业，课女夜抄书。\n时事方关念，归怀不遂初。\n经纶缘未了，天意盍留渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽周宣义","author":"陈傅良","text":"无酒浇陈草，将诗刻隧碑。\n遗名从此在，真意竟谁知。\n教子还馀事，周人亦有时。\n忆尝从夜话，欲去更迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林承信","author":"陈傅良","text":"重交宁问田安在，急义固于官不知。\n膴仕幸多花萼好，幽栖宜与竹林期。\n床头周易吾将老，案上楞严晚得师。\n此意自应天予后，峄阳未琢长孙枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林致贤提举","author":"陈傅良","text":"一经韦氏学，五桂窦仪家。\n每耻乡评过，深惩履道华。\n人方贵全璧，事已堕空花。\n褒衮来黄阁，千年置齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽族叔父 其二","author":"陈傅良","text":"我怀终古恨，不及奉觞时。\n满眼看诸弟，何心赋此诗。\n牛羊来蛰蛰，丘墓去累累。\n亦有千钟养，曾无一字碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽族叔父 其一","author":"陈傅良","text":"松竹深围屋，□莲剩种鱼。\n所愁宾客少，不问稻粱馀。\n尽日□相语，盈门手自书。\n吾儿有名字，万事听何如。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽婺女何茂宏","author":"陈傅良","text":"劝驾尝连萼，应门忽二毛。\n竟于时不偶，吾更晚相遭。\n宿草堪挥泪，丰碑忍泚毫。\n送车今几两，谁最恋绨袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽楼朝奉 其一","author":"陈傅良","text":"裘马朋簪盛，绯鱼筦库卑。\n行藏公论在，然否寸心知。\n岁晏曾三接，民功仅一麾。\n空馀华衮字，有恨盖棺时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽楼朝奉 其二","author":"陈傅良","text":"九寺方连茹，专城又夹河。\n晚看诸子好，孰与一门多。\n薄海皆惊叹，亨衢忽荐瘥。\n大连同厚夜，其柰少连何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽潘才叔母","author":"陈傅良","text":"剥啄唯深夜，门前杙小船。\n有儿能自致，此母已堪传。\n竹院前闻熟，桓楹大字悬。\n病怀嗟不及，健笔附诸贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽薛季益尚书 其一","author":"陈傅良","text":"遍试江淮声藉藉，久劳荆蜀鬓苍苍。\n同时半已登槐棘，卒岁才能足稻粱。\n遗藁不为他日计，佳城尚及此丘藏。\n岂无后作多文胜，今我怀人泪欲滂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂阳劝农","author":"陈傅良","text":"雨耨风耕病汝多，谁将一一手摩挲。\n幸因奉令来循垄，恨不分劳去荷蓑。\n凉德未知年熟不，微官其奈月桩何。\n殷勤父老曾无补，待放腰镰与醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病馀久不趋郡且迁仙岩书院于屋西有怀同志","author":"陈傅良","text":"欲往如天际，相期忽岁华。\n山空明独树，江晚暗连葭。\n作屋皆三益，藏书可万家。\n岂无人裹饭，躬自灌园芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈同甫","author":"陈傅良","text":"古来材大难为用，纳纳乾坤著几人。\n但把鸡豚燕同社，莫将鹅鸭恼比邻。\n世非文字将安托，身与儿孙竟孰亲。\n一语解纷吾岂敢，祇应行道亦酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢景英参议","author":"陈傅良","text":"故人不见吾何适，欲见其人已异乡。\n魂梦半年皆草草，鬓毛一别益苍苍。\n筹边淮海何迟暮，乘障湖湘亦阻长。\n及此居闲宜问讯，题书须待满林霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题翁诚之慈溪县尉厅无我亭","author":"陈傅良","text":"星月明当户，乌鸢下傍人。\n小亭长独立，通国自相亲。\n置尉缘求盗，居官已丧真。\n须知三尺外，敲榜亦深仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题薛象先新楼","author":"陈傅良","text":"矮檐风雨送蜗牛，有客来誇百尺楼。\n阖郡台池皆下瞰，背城湖海亦全收。\n清时未放徒高卧，半世何为故倦游。\n解尽橐金君计决，月明长笛起渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼刘谦之知录","author":"陈傅良","text":"海内多吾友，飘零今几人。\n相忘尤堕泪，欲诔辄伤神。\n才力矜馀地，心期耻后尘。\n溘然无一语，愁杀白头亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]