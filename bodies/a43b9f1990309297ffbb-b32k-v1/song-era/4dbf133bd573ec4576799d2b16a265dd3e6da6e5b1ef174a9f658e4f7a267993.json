59a283ba061d3","dynasty":"宋"}},{"title":"柬龚立道","author":"周南","text":"不课木奴千树入，却夸蠹简百年馀。\n先生不要金花帖，只借耕田觅饭书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其一","author":"周南","text":"三朝备福尊寿乐，七秩脩龄古更稀。\n问寝龙楼家法在，鸡鸣步辇过慈帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其三","author":"周南","text":"濯龙宫馆漏声徐，閒把黄庭味道腴。\n侍女不持珠玉玩，争传文母浣衣图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其一","author":"周南","text":"迟日回苍陆，祥霏下庆霄。\n灵椿储寿嘏，宝册迨琼瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其三","author":"周南","text":"内殿家人礼，猩袍奉玉卮。\n椒盘勤盥馈，百世有孙支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其二","author":"周南","text":"当年三殿瑶池会，天仗将回乐未央。\n献岁东朝还大内，仙韶迟上万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇太后閤春帖子 其二","author":"周南","text":"官梅犹注萼，御柳渐垂丝。\n太母如任姒，深居宝俭慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其一","author":"周南","text":"路寝朝元早，条风应律初。\n八荒跻寿域，一札下宽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其一","author":"周南","text":"晓漏催班拱至尊，千官绮胜簇金幡。\n紫皇恭俭忧民切，未祝椒盘祝兽樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其二","author":"周南","text":"玉烛天时正，金穰岁兆丰。\n华封遥上祝，圣德与天通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其三","author":"周南","text":"禁籞希临幸，宵衣戒未明。\n馀閒寓弧矢，劝讲只儒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其三","author":"周南","text":"万里长城汉有人，羽书渐少捷书频。\n君王轸念春寒重，更解貂裘赐将臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"皇帝閤春帖子 其二","author":"周南","text":"玉宇朝来变好春，都传塞上已和亲。\n中天日月无私照，万国耕桑雨露均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重赋三高 其二","author":"周南","text":"儿女呻吟岁又穷，也应无语对西风。\n向来一箸鲈鱼意，赢得寒亭四壁空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重赋三高 其一","author":"周南","text":"著就农夫谷不收，江湖著我系虚舟。\n渔樵拍手应相笑，不得长鲸取次休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重赋三高 其三","author":"周南","text":"千金孰与此身多，惭愧君王用已过。\n乞得头颅江海去，一生辛苦几渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瓶中花","author":"周南","text":"清晓铜瓶沃井华，青葱绿玉紫兰芽。\n鬓毛白尽心情在，不分看花学养花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读唐诗 其二","author":"周南","text":"自分馀工督小儿，更抄两卷晚唐诗。\n勾消日力跏趺坐，欲写凄凉神已疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读唐诗 其一","author":"周南","text":"一日勾消两卷诗，趁忙抄得是灯时。\n隔窗一鬨狂风雨，无数啁啾冻雀儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读唐诗 其三","author":"周南","text":"一般生态几人描，砑尽吴笺秃尽毫。\n却是晚唐工状物，手调烟露染天膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中赋落梅","author":"周南","text":"一段幽奇破腊忙，只将迟暮了年光。\n从教篱落飘零尽，也胜房栊半面妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酌第四桥水有怀陆羽","author":"周南","text":"未必茶瓯胜酒醒，且将衰发戴寒星。\n太湖西与松江接，不碍幽人第水经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄友人","author":"周南","text":"生前何事苦收身，身后浮名底样荣。\n只得太湖三万顷，与君亭下作真清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"筇竹杖","author":"周南","text":"四十龙钟欠一年，不应鹤骨会乘轩。\n杖头无用燃藜烛，倚向荒畦印屐痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜鹊 其一","author":"周南","text":"檐牙唤起前时梦，远信凭君便有期。\n岁暮柴门今事少，寒暄音问不须知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食怀游诚之","author":"周南","text":"清溪寒食水瀰漫，忆在齐山约共观。\n便著窄衫鞭马去，路傍惊讶是文官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山寺","author":"周南","text":"山寺清明蛱蝶飞，中庭古佛供琉璃。\n僧房也有追游市，瓦狗泥车诳小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游石湖","author":"周南","text":"晓日曈眬水雾开，自吹清管过湖来。\n阖闾城下青青草，又染裙腰上舞台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":25483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]