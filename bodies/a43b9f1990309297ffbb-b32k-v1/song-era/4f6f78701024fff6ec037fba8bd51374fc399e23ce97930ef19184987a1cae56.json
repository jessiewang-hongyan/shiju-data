[{"title":"送吴主簿之官","author":"韩淲","text":"上饶有路达松阳，江浙邻封只异乡。\n几载玉峰超雾重，一朝苍岭惠云长。\n决科意气能相过，随世功名合自彊。\n高士不为何太甚，且稽丝粟恐民伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送孟元立之官行都酒所","author":"韩淲","text":"行色西风入帝城，新凉吹稻雨开晴。\n月明茅店五更梦，潮上溪船千里程。\n老觉依依人去住，闲思一一我经行。\n功名意气云霄路，冠剑锵然佩玉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送成季 其一","author":"韩淲","text":"经月红尘共小楼，西风吹梦绕湖流。\n文场两地还趋走，客路他乡有去留。\n壮日功名看辇路，老年心绪喜沧洲。\n北关门外一杯酒，潮水庙山滩上舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送成季 其二","author":"韩淲","text":"秋日烘林岩桂花，笋舆应过野人家。\n青山路口望乌石，绿水渡头行白沙。\n里社游从情最乐，弟兄团聚兴无涯。\n重阳天气君归去，剩醉芳尊咏物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送庄贤良自钟山归镜山","author":"韩淲","text":"邂逅薰风醉酒壶，秋声俄已到菰蒲。\n扁舟西笑游钟阜，捃载东还入镜湖。\n尚友更思狂客不，爱闲时过放翁无。\n壮心老矣诗情在，满眼云山道转孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾鸿甫著作还朝","author":"韩淲","text":"进退非关我重轻，乡来何屡乞青城。\n西风又上蓬山去，指日须为政地行。\n卫霍功名思灭敌，成康时世欲持平。\n西湖之上烟波阔，回首能令眼倍明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送耿宰属浙漕秋试","author":"韩淲","text":"倾壶玉涧金波委，天地中间惜九秋。\n跬步往来空踯躅，何心出处试绸缪。\n柯山风叶无樵斧，湍石烟蓑有钓舟。\n鸿雁初飞吴越冷，震风堆雪卷潮头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲至罢归","author":"韩淲","text":"才得公来又见归，浙江瀰眇越山微。\n岸花汀草依然是，官柳宫槐顿尔非。\n朝路往还从旧少，诗家识赏至今稀。\n西兴渡口斜晖里，尽好风帆桨棹飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送温尉赴调","author":"韩淲","text":"富春山下赏花时，夜半潮生醉不知。\n人事变迁惊易老，岁华荏苒叹多奇。\n风声野树吹残叶，雪意江梅发好枝。\n且喜弹冠天上去，旧登临处为题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送章抚干兼寄皇甫襄阳","author":"韩淲","text":"薰风幕府上隆中，想见旌旗照日烽。\n绝塞江山元自若，故都京洛岂难通。\n古今只有时艰阻，贤否宁无志不同。\n羊陆规模亦深远，因言为我寄元戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"折南豅早梅送周国正","author":"韩淲","text":"送客逢花小棹飞，折来谁与岁寒期。\n老身不忍看千树，明眼须容荐一枝。\n意象春融知玩索，咏歌物妙想舒迟。\n孤高比玉人之德，公岂寻香逐色思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送伯皋入书院","author":"韩淲","text":"江湖契阔四年别，涧谷经行五日留。\n扑扑落梅啼鸟换，离离荒草昔人愁。\n馀寒漫自青山老，稍霁当同绿水游。\n不羡章泉能荐祢，却忻半隐得依刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送施知院洪帅","author":"韩淲","text":"便好槐庭听报麻，少迟江右建高牙。\n使华仕路应争羡，昼绣乡闾合共誇。\n别院笙歌开祖席，满城桃李正飞花。\n不知谁下陈蕃榻，且看儿童竹马遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送辛帅三山","author":"韩淲","text":"暂著鹓行却建牙，此身何地不为家。\n闽山又作年时梦，吴会分明眼底花。\n舒卷壮怀公自笑，往来行李士争誇。\n棠阴应有邦人望，笳鼓西风拥帅华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送余解元再往吴中","author":"韩淲","text":"西湖浙右多佳士，为我春风各寄声。\n睡阁有閒当领略，癯庵因过试经行。\n终年离索非人事，它日相思不世情。\n更是吴王旧池馆，桃红李白草初生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈同甫丈赴省","author":"韩淲","text":"平生四海几过从，晚向闽山访海翁。\n又见稼轩趋召节，却随举子赴南宫。\n风云变态高情表，岁月侵寻醉眼中。\n可是龙川便真隐，乘时勋业尚须公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐仙游赴省","author":"韩淲","text":"得隽春风有世科，西湖花柳奈君何。\n会逢旧治经行久，相与陈人笑语多。\n快睹挥毫明礼乐，不须制锦更弦歌。\n开禧正以才经济，台阁中间要讲磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送耿师干得閤门","author":"韩淲","text":"羽仪上閤拱清班，天近红云咫尺间。\n礼集会朝驰北阙，祥开寿节颂南山。\n龙鸾鞭扇随分合，鹓鹭衣冠得往还。\n休沐定从湖寺去，人生谁不有忙閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送余运管入浙","author":"韩淲","text":"日边护漕建台深，荣路长才入壮心。\n正是规恢要多士，须知汲引有知音。\n向来除夜尝同赋，此别何时复盍簪。\n好上鸳行参剑佩，为言风雪老山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送上饶韩宰官满归东阳","author":"韩淲","text":"三年制锦见能贤，秩满归来宝婺边。\n族阔是非无不尔，位高翻覆有如然。\n莫因别派妨随牒，且念前闻稳著鞭。\n北客相家今几许，堂堂忠献自凌烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"光庭得节同彦章置酒江亭作别","author":"韩淲","text":"青山吴越晚潮天，领客登临合醉眠。\n且抱风流寻酒盏，更移襟度入诗编。\n雁行未许归舟速，凤阙犹看使节旋。\n处士一星人物表，往来书剑本超然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送沅陵宋令之官","author":"韩淲","text":"雪残沙软草芽肥，梅萼翻檐柳拂堤。\n山色翠连盘瓠石，水声清接武陵溪。\n要看抚字归谈笑，且与经行试品题。\n我亦钱塘江上去，书林猿鹤共凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送双井三哥","author":"韩淲","text":"清暑钱塘舶趠风，潮随帆影度空濛。\n不妨放浪江山外，应笑驱驰朝市中。\n年少绿衣宜养志，时平黄卷合书功。\n南来桐树彫零甚，喜子清扬趣不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵清江","author":"韩淲","text":"少劳吟笔赋催科，抚字心存政自和。\n莫道折杨无俗韵，要思于蔿有奇歌。\n时秋凉冷遽如许，客子宦游将奈何。\n看即双凫候飞舄，清江江上一婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送孟五六哥","author":"韩淲","text":"惜别经年事已非，悔于涂炭坐朝衣。\n放身沧海未为失，满目青山胡不归。\n零落交游难聚集，凄凉族绪易因依。\n有来少住为佳尔，老我逃虚甘息机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送芮玉山","author":"韩淲","text":"苕溪秋碧卞峰浓，莼菜鲈鱼兴味中。\n制锦归来应自适，角巾行往与谁同。\n才华便合为时用，士论须知得誉隆。\n留取棠阴在岩邑，为公频到咏仁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王寺簿倅秩满回蕲 其一","author":"韩淲","text":"涧头连雨水还平，岸草纵横日日生。\n过眼空林惟鸟影，惊心匝地转蛙声。\n病多止酒慵寻句，老矣焚香喜诵经。\n见说玉溪王别驾，二年官满又将行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王寺簿倅秩满回蕲 其二","author":"韩淲","text":"百年驻跸在东南，薄宦浮生士所谙。\n进退何心空自了，别离满眼我难堪。\n救时事业终须做，随世功名亦喜谈。\n命也奈何天咫尺，鸾台凤阁本潭潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王寺簿倅秩满回蕲 其三","author":"韩淲","text":"淮山何处是蕲春，想见家林猿鹤新。\n合上烟霄输壮志，却分风月又闲身。\n极知归去无多日，细数交游有几人。\n江左夷吾谁得似，急乘温诏起经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盖稀之作乌程县","author":"韩淲","text":"十年重入长安市，常把西林倒载人。\n少为弦歌看抚字，莫须杯酒话酸辛。\n三贤久觉两无有，千首何如一已真。\n秃发顾予皆老矣，朝家更化孰知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑中卿池阳倅贰","author":"韩淲","text":"九华秀出明秋浦，暑雨吹凉树色新。\n弹压江山非俗辈，平分风月有诗人。\n经行古寺心情别，放步空村语笑亲。\n安得酒边看近作，白头青眼话鲈莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱宗卿得当涂守","author":"韩淲","text":"垂上甘泉玉笋班，又看均逸贺朱幡。\n当涂自是号名郡，近北还知出异恩。\n西望雪堂应坐啸，东连钟阜要蕃宣。\n名卿所至人皆仰，青镜从渠霜鬓繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱敬之监簿求泉南添差倅去泊灵芝","author":"韩淲","text":"经筵虽旧事犹新，似续中朝入荐绅。\n便赋泉山六百石，重光唐石八千春。\n从来力量非他意，到了工夫只此身。\n六月灵芝湖上寺，风凉相与洗车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"何学谕随黄守靖州","author":"韩淲","text":"雨凉吹动木犀天，莫遣清愁棹酒船。\n独拥琴书去何处，又随符竹到穷边。\n区区事业皆身外，往往情怀只眼前。\n指点潇湘在图画，有诗无负好风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"成外归秣陵","author":"韩淲","text":"看了三山白鹭洲，归来难老更何愁。\n弟兄旧隐家风在，子侄世科官业脩。\n鱼计亭深云坞口，青毡堂迥水塘头。\n何时容我陪情话，华发清樽事事幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵七哥归并呈乃翁","author":"韩淲","text":"前时秋熟不能留，愧此常生间阔愁。\n见说长翁游隔郡，欣从重客到吾州。\n阿咸唁戚因迂步，诸友适来如合谋。\n居士闻斯须大笑，閒中离合等浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石尉归杭 其一","author":"韩淲","text":"吴越青山日日潮，鱼龙出没浪花骄。\n乾坤莽荡盘今古，贤否交驰迫市朝。\n我有诗书心自得，人无风月意难消。\n三年尉满归天路，柳色争春梅未飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石尉归杭 其二","author":"韩淲","text":"孤山梅与玉溪梅，溪上山根岁岁开。\n归到乡关须领略，相逢官路且裴徊。\n无非共醉穷冬景，其奈他吟处士来。\n篱落园林浮动处，定应回首我尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文叔解官东归","author":"韩淲","text":"一帆风雨转吴头，家在稽山事事幽。\n小试鸣琴还满去，等闲结绶亦何求。\n政声赢得多推美，学力须知转好脩。\n我与君心似相密，别离无计可消愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钟亲昆仲回四明 其一","author":"韩淲","text":"一棹拖篷过甬东，潮平波面夕阳红。\n极知我辈焚舟举，更喜君家制锦功。\n枫叶未残秋淡荡，桂花犹共月朦胧。\n相逢莫恨相离别，连璧应抟九万风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钟亲昆仲回四明 其二","author":"韩淲","text":"浮生车马易西东，邂逅相看醉颊红。\n失喜却愁诗作祟，推愁犹喜酒书功。\n秋老水风吹浩荡，夜深山月照朦胧。\n年来墨客惊无几，四座当回正始风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"文叔赴部班引复回建康","author":"韩淲","text":"俯循常调到行都，薄宦犹烦五荐书。\n久历男邦虽不较，更临郡县待何如。\n春风吹鬓秦淮老，夏日移家越岭居。\n且以酒浇君磊块，相逢谁道故人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘簿檄自安仁回泊天宁","author":"韩淲","text":"玉石村前捧檄来，冰溪兰若小徘徊。\n因僧定可了禅悦，与俗何能辜雅怀。\n秋到山林风未脱，凉生絺绤雨须催。\n遥知有句曾吟不，想象章泉更乐哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十六日昌甫归章泉水","author":"韩淲","text":"城郭山林每相望，独醒那忍共春酲。\n眼前人事忙如戏，脚底花时过若惊。\n从宦索居良易与，新知故态岂难评。\n朅来数日还归去，隐地应多怨鹤迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至除帑辖后移居","author":"韩淲","text":"骎骎得路又迁居，广厦夷涂不奈渠。\n贾岛并州虽客舍，陶潜栗里祇吾庐。\n推敲终久诚无恙，拣择须臾便有馀。\n但愿朝回饱吃饭，时能唐突过黄初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送合州青阳道人","author":"韩淲","text":"灵元一点结胎胞，识取阴阳气象交。\n具体无过乾六画，施功全自震初爻。\n玉池金室归真境，紫府丹台近乐郊。\n更有些儿玄牝物，青城山顶约诛茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同游山前道院访晋陵道士","author":"韩淲","text":"閒思羽客约诗人，觅遍幽窗到竹阴。\n天近地严扃宝笈，道通仙隐得清琴。\n因成行去凭虚望，不见归来何许寻。\n珍重同游先写句，薰风城市有山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别灵耀寺同舍","author":"韩淲","text":"分明共学要工夫，欲话离情一句无。\n肯把闲愁消日月，从教身世老江湖。\n晴云野岫明霜树，寒日平川湿露芜。\n去去杜门思益友，只今搔首更踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别子似","author":"韩淲","text":"眼底年华此一时，相逢意气得追随。\n清风朗月閒倾酒，流水高山漫赋诗。\n我已衰迟君莫问，君宜光大我深知。\n人间万事邯郸梦，海内交游不记谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别许叔开胡彦道并呈曾正中","author":"韩淲","text":"连天风雪滞行舟，更为亲朋一日留。\n搜索新诗供大笑，旋沽浊酒洗离愁。\n江横水馆渔村静，山锁僧房茅舍幽。\n抖擞三年尘土梦，片帆西上玉溪头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯皋过筠阳甚惜其行","author":"韩淲","text":"知君又尔去筠阳，山路穷冬正雪霜。\n华发相看俱老大，清言谁复共平章。\n梅花破暖开何处，枫叶凋寒落异乡。\n雁影翩翩鸥烱烱，惜无馀地问行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵太社出示夕月斋宫所作次韵报之","author":"韩淲","text":"年时过我涧之南，寂寞宽閒所共堪。\n此道吾侪非自苦，人情物态是谁谙。\n灰心纵惜形容变，糊口犹图齿颊甘。\n且和湖边夕月句，老生无奈只常谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋倅 其一","author":"韩淲","text":"见说空堂舍盖公，秋深得雨庆时丰。\n唤回旧观十年外，聚集清流一座中。\n台映玉峰归独鹤，城依冰水下孤鸿。\n只消满把篱边菊，宾主风流意已通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宋倅 其二","author":"韩淲","text":"海内交游不数公，又吟名胜句何丰。\n锦囊忽到溪山下，绣段争看涧谷中。\n落拓自惊随野马，凄凉何止听宾鸿。\n高斋容我陪珠履，不信穷途有路通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵元要陪仓使张园","author":"韩淲","text":"春閒有客伴遨头，应喜园亭处处幽。\n晴日暖风花影外，清歌妙舞酒船浮。\n牢笼好景开诗胆，爱惜流光入醉眸。\n珍重苏门两君子，至今人物尚同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所寄 其一","author":"韩淲","text":"别后连绵好句来，朗哦深视百千回。\n穷通身外庸何恨，生死人间信可哀。\n公既爱閒常隐几，我方疮楚未持杯。\n涧梅点点从教白，春到章泉花自催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所寄 其二","author":"韩淲","text":"飞舞醯鸡只瓮天，何知老壮与穷坚。\n于今之世宜咸若，从古之贤定复然。\n荷尽菊残非一日，草深地僻几多年。\n吟窗明暗霜须雪，苟亦无言岂舍旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫所寄 其三","author":"韩淲","text":"催景阴阳长短宵，天回星纪又玄枵。\n霜寒草野真无恶，雨湿禾场正不聊。\n薄晚固宜山色远，经冬犹未水痕销。\n私家一饱官何恤，寂寂閒中岁月飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其一","author":"韩淲","text":"香来桂树丛生处，招隐其如怀玉东。\n白发满头唯我独，清诗脱手几人同。\n影摇明净云间月，声滴幽微雨后风。\n秋以此花相劳苦，世涂谁拙又谁工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其二","author":"韩淲","text":"故人北客今多少，但愿上下常相随。\n比时一出得聚首，此日独居还和诗。\n我家父祖不相见，君家兄弟诚所思。\n玉溪屈指已三世，霜风落叶吹疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其三","author":"韩淲","text":"既贫且病是今年，容貌音声亦变迁。\n纵起步趋终倦矣，讷于言语每颓然。\n秋凉颇似如人意，月好翻能搅我眠。\n试把闲情和佳句，瑞峰何处入章泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其四","author":"韩淲","text":"秋来风叶已纷披，景到怀人意可知。\n时泰果能同道泰，行危何必更身危。\n独怜水后浑休说，相与山间是寄诗。\n空眄庭柯又如许，彼陶终是得颜怡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其五","author":"韩淲","text":"我圃虽荒亦有梅，云何也会待春回。\n寻香逐色从头数，弄蕊攀条著眼催。\n老境隙光真野马，新年律琯已飞灰。\n一枝千树俱能尔，莫负尊前得句来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]