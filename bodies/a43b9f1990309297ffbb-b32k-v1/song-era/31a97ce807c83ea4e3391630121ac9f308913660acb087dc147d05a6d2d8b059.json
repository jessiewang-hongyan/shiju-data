[{"title":"六代祖师赞 其五","author":"释文礼","text":"黄梅再来，青松依旧。\n前身后身，一场逗漏。\n七百高僧总作家，唯有南能不唧?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松源和尚赞","author":"释文礼","text":"耳根聩兀如鸱，项颈缩拗如驴，有问东却答西。\n未尝许可，说甚传持。\n临行三转语，自起一团疑。\n几多吞不下，背后乱针锥。\n咬定牙关供死款，铁牛耕破舌头皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂七贤女游尸陀林","author":"释文礼","text":"七珍八宝任君需，三物从来的是无。\n若向无中拈得出，不须见佛问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其五十","author":"释文礼","text":"树凋叶落聊伸问，体露金风错指踪。\n带累儿孙无豹变，等閒落在草窠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十一","author":"释文礼","text":"四方八面没边疆，暴雨狂风无处藏。\n古庙里头休亸避，移舟别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十八","author":"释文礼","text":"山边水边待月明，暂向人间借路行。\n如今还向山边去，只有湖水无行路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其三十四","author":"释文礼","text":"家常添钵绕村行，蓦地一声无厌生。\n化主分明嫌少在，篱门掩却强惺惺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十九","author":"释文礼","text":"上等接人，了无回互。\n据坐堂堂，是何谓度。\n帅王用处若轩昂，为渠拽倒破禅床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十八","author":"释文礼","text":"不知兀坐常轮转，空下禅床绕一遭。\n背面却言亏一半，老婆恶业自家招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十七","author":"释文礼","text":"泥佛金佛木佛，度水度火度炉。\n妙体本来无处所，莫将真佛强涂糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其二十六","author":"释文礼","text":"若陈见面太悬殊，云水重新诳惑渠。\n谩说当时曾省悟，却将鱼目当明珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十三","author":"释文礼","text":"堕脱知何处，凭君子细看。\n潮来无别浦，木落见他山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十二","author":"释文礼","text":"日面佛，月面佛。\n西岩树色含烟，东谷华光映日。\n仰视莫穷，俯看已老。\n一时分付主林神，明眼衲僧无处讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其十","author":"释文礼","text":"不是风兮不是幡，将军骑马出潼关。\n安南塞北都归了，时复挑灯把剑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释文礼","text":"黄钟才起时，九数从头数。\n相将幽谷莺啼，次第雕梁燕语。\n田父祭勾芒，丛祠敲社鼓。\n农父狎牛郎，村姑教蚕妇。\n光阴老尽世间人，冬至寒食一百五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其五","author":"释文礼","text":"夜明帘外，宝鉴台前。\n元无兼带，岂有偏圆。\n古渡无人霜月冷，芦花风静鹭鸶眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其三","author":"释文礼","text":"众生本不曾迷，夜阑鸡向五更啼。\n诸佛本不曾悟，秋清雁度长空去。\n西窗昨夜月华明，凉飙已到梧桐树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其一","author":"释文礼","text":"震忽雷，飞闪电。\n夜叉头，菩萨面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十三首 其四十五","author":"释文礼","text":"有句无句，如藤倚树。\n回避无门，毒蛇当路。\n树倒藤枯，句归何处。\n明眼衲僧，一场罔措。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其四","author":"释文礼","text":"七尺单前，一蒲团地。\n横亘十方，竖穷三际。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂五首 其二","author":"释文礼","text":"万松关迥，九陇烟横。\n谷风传响，涧水流声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释文礼","text":"施为动静凭谁力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"释文兆","text":"河分岗势司空曙，春入烧痕刘长卿。\n不是师兄偷古句，古人诗句犯师兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巴峡闻猿","author":"释文兆","text":"倚棹望云际，寥寥出峡清。\n心如无一事，愁不在三声。\n带露诸峰迥，悬空片月明。\n何人同此听，彻晓得诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吊屈原呈王内翰","author":"释文兆","text":"抱清谁可群，委质在湘濆。\n今日不同楚，无人更似君。\n沧波沈夜魄，古庙聚寒云。\n吊罢踟蹰处，渔歌忍独闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上书怀寄希昼","author":"释文兆","text":"扁舟宿江上，脉脉兴何穷。\n吴楚十年客，蒹葭一夜风。\n东林秋信断，南越石房空。\n向此都忘寐，君应与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽圃","author":"释文兆","text":"远与村桥接，深春积雨时。\n兰芳人未采，花发蝶先知。\n草密封闲径，林疏露短篱。\n别来锄久废，身老恨归迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送史馆李学士任和州","author":"释文兆","text":"事主惟公直，承恩赴历阳。\n舟浮淮水远，路绕楚山长。\n馆谒僧侵月，郊迎吏蹋霜。\n下车难久滞，飞诏即徵黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宇昭师","author":"释文兆","text":"相见又相别，无言感倍兴。\n诸峰微下雪，一路独行僧。\n午饭烟村磬，宵吟石屋灯。\n他方人请住，又得继南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送惟凤师之终南","author":"释文兆","text":"终南关内见，寒翠叠空虚。\n明代谁招隐，深秋自卜居。\n宵晴吟洞月，日晓饭溪蔬。\n此后嫌名出，应无入阙书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送简长师之洛","author":"释文兆","text":"动静非常态，超然西去心。\n水期经洛听，云约到嵩吟。\n斋访烟村远，禅依竹寺深。\n祇应风雅道，相府是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莎庭","author":"释文兆","text":"苒苒从莎长，凄凉雨乍晴。\n穷秋閒客步，落日乱蛩鸣。\n近接苔阶迥，遥连竹径平。\n杖痕兼鹤迹，来往自纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿西山精舍","author":"释文兆","text":"西山乘兴宿，静称寂寥心。\n一径杉松老，三更雨雪深。\n草堂僧语息，云阁磬声沈。\n未遂长栖此，双峰晓待寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄行肇上人","author":"释文兆","text":"诗禅同所尚，邂逅在长安。\n为客闲相似，趋时懒一般。\n分题秋阁迥，对坐夜堂寒。\n未遂归山计，流年鬓已乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄保暹师","author":"释文兆","text":"近闻高静趣，犹寄广陵居。\n夜会听琴阻，秋期看月疏。\n几成归越梦，久绝入梁书。\n四释分题处，年来一榻虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠天柱山盺禅老","author":"释文兆","text":"几年天柱居，韬光外浮世。\n禅心混沌先，诗思云霞际。\n山雪涤茶铛，溪泉濯祖毳。\n富德鄙利徒，贵道轻权势。\n竹牖晴长开，松扉夜不闭。\n霜严庭树萎，雨暴龛灯翳。\n红叶遇寒烧，白头逢暖剃。\n终期为近邻，清话素相契。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食野步","author":"释文坦","text":"寒食出重闉，郊原忽怆神。\n人悲新旧冢，花落古今春。\n名位空标史，贤愚尽委尘。\n斜阳回首处，垄木噪鸦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释文或","text":"十年弓剑为谁苦，万里山河不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释文准","text":"老胡彻底老婆心，为阿难陀意转深。\n韩干马嘶青草渡，戴嵩牛卧绿杨阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其六","author":"释文准","text":"四月人家麦正收，连绵阴雨不能休。\n沿溪处处生深草，饱杀南泉水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其四","author":"释文准","text":"祖师关棙子，幽隐罕人知。\n不是悟心者，如何举向伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其一","author":"释文准","text":"寒来暑往古今同，万别十差不碍空。\n昨夜铁牛头角露，满庭松柏撼秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其七","author":"释文准","text":"日昳未，法身清净绝方比。\n乾坤遐迩尽东西，千山万山翠相倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其五","author":"释文准","text":"禺中巳，龙象须观第一义。\n若向其中觅是非，见解何曾有李二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其十","author":"释文准","text":"黄昏戌，楼上鸣钟已落日。\n行人旅店宿长途，花上游蜂罢采蜜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其八","author":"释文准","text":"晡时申，由来大道绝疏亲。\n阳和九月百花发，须信壶中别有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其一","author":"释文准","text":"鸡鸣丑，念佛起来懒开口。\n上楼敲磬两三声，惊散飞禽方丈后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其四","author":"释文准","text":"食时辰，更无一法可当情。\n千里出山云有色，一源投涧水无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其九","author":"释文准","text":"日入酉，净室焚香孤坐久。\n忽然月上满东窗，照我床头瑞香斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其二","author":"释文准","text":"平旦寅，当人有道事须亲。\n不闻先圣有慈训，莫认狂痴作近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其三","author":"释文准","text":"日出卯，大道分明莫外讨。\n日月纵横在目前，逢原左右拈来草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其六","author":"释文准","text":"日南午，理事相谙更相互。\n三门拈向灯笼头，休问他家觅归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其十二","author":"释文准","text":"半夜子，梦里分明被人使。\n连宵合药到天光，起来何处有白芷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二时颂 其十一","author":"释文准","text":"人定亥，老鼠此时正无碍。\n忽然灯灭寝堂前，床前咬我靸鞋袋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其二","author":"释文准","text":"尔图我真，又求我赞。\n我真我赞，两重公案。\n家丑不外扬，己德不自谈。\n寄之以数，六九五十三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送云侍者","author":"释文准","text":"鸟窼吹布毛，老婆为侍者。\n今古道虽同，宾峰不然也。\n二月三月时，和风满天下。\n是处百华开，远近山如画。\n歧路春禽喧，高岩春水泻。\n头头三昧门，虚明周大野。\n好个真消息，书送汝归舍。\n衲僧末后句，嘘是何言欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送利监收","author":"释文准","text":"开眼合眼，道契寰中。\n东行西行，禅非物外。\n大仰插锹叉手，靴里动指头。\n南泉把镰刈茅，谁人知此意。\n今也道不及古，僧僧解数满肚。\n但寻雪月风华，失却昔年活路。\n不能返照回光，法界毗卢全露。\n阿呵阿，笑倒利头陀，风前月下啰哩啰。\n深夜处分诸火客，你看甚么火色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释文准","text":"之乎者也，衲僧鼻孔，大头向下。\n若也不会，问取东林王大姐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其六","author":"释文准","text":"行路难，行路难，最难难是过台山。\n唯有赵州公验正，昂头掉臂总闲闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其七","author":"释文准","text":"好笑提婆达多，入捺落十小劫波。\n然得三禅妙乐，吹布毛须还鸟窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释文准","text":"今朝腊月十，夜来天落雪。\n群峰极目高低白，绿竹青松难辨别。\n必是来年蚕麦熟，张公李公皆忻悦。\n皆忻悦，鼓腹讴歌笑不彻。\n把得云箫缭乱吹，依稀有如杨柳枝。\n又不觉手之舞之，足之蹈之，左之右之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释文准","text":"五九四十五，圣人作而万物睹。\n秦时?轹钻头尖，汉祖殿前攀哙怒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十二","author":"释文准","text":"天道运行，节气频更。\n五日为候，十日为旬。\n三十日为月，十二月为年。\n一日一日，因循因循。\n五九尽，又逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十一","author":"释文准","text":"今朝腊月十五，切忌葛藤露布。\n者事直下分明，当处超佛越祖。\n便与么去，苦苦。\n寒山子能莽齿，十年归不得，忘却来时路。\n呵呵呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其十","author":"释文准","text":"八月中秋天凉，芙蓉花发题目禅房。\n老胡大道分明在，不必诸方问短长。\n短不是短，长不是长。\n短长不是处，是道非思量。\n思量不及，文彩愈彰。\n秋山兮秋云片片，秋江兮秋水洋洋。\n风悲兰社，天澹沧浪。\n欲言言不及，林下好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其七","author":"释文准","text":"鸡鸣丑，三四五六七八九。\n象骨峰头木马嘶，新丰洞口石牛吼。\n山之前，水之后，吴道僧繇画不就。\n断头船子下南康，彷佛天明到湖口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其五","author":"释文准","text":"高吟大笑意猖狂，潘阆骑驴出故乡。\n惊起暮天沙上雁，海门斜去两三行。\n古人道，不看经，不念佛，看经念佛是何物。\n自从识得转经人，龙藏圣贤都一拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其三","author":"释文准","text":"夜雨敛重云，晓鸿鸣寥沈。\n可怜祖师意，头头都漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈十二首 其二","author":"释文准","text":"八月九月天，白露寒露节。\n门外在处山，秋风落黄叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠奇松头歌","author":"释文准","text":"种松道者道情孤，往个茅庵事事无。\n屋内锄头三两柄，烟熏一只醋葫芦。\n问渠禅，回首指山前。\n问渠道，戴个箬笠去锄草。\n再三再四再问渠，拍手呵呵笑欲倒。\n却言昔日老云门，参见睦州陈长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其三","author":"释文准","text":"我已是妄，尔更妄写。\n妄我妄写，两重虚假。\n欲传吾真，须泯见闻。\n声色不碍，相似十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其一","author":"释文准","text":"我若自赞，云居罗汉。\n我若自毁，无主饿鬼。\n赞之不欣，毁之不嗔。\n毁誉不动，东鲁西秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释文准","text":"我脚驴脚，放过一著。\n庞公笊篱，清平木杓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释文准","text":"我手佛手，十八十九。\n云散月明，痴人夜走。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]