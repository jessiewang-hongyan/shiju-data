[{"title":"上章休致奉诏不允感恩书怀","author":"杨万里","text":"纳禄惟愁晚，蒙恩未听辞。\n猖狂思再渎，感恋独多时。\n但有花开日，无非饮醉时。\n白头何所用，满与插花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下元日诣会庆节所道场呈余处恭尚书","author":"杨万里","text":"琳宫朝谒早追趋，漏尽铜壶杀点初。\n半缕碧云横界月，一规银镜裂成梳。\n自拈沉水祈天寿，散作非烟满玉虚。\n已被新寒欺病骨，柳阴偏隔日光疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与长孺共读东坡诗前用唐律后用进退格 其二","author":"杨万里","text":"枉看平生多少书，分明便是蠹书鱼。\n万签过眼还休去，一字经心恰似无。\n急读何如徐读妙，共看更胜独看渠。\n曲生冷笑仍相劝，惜取残零觅句须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与长孺共读东坡诗前用唐律后用进退格 其一","author":"杨万里","text":"急性平生不少徐，读书不喜喜观书。\n十行俱下未心醒，两目顿昏还月馀。\n偶与儿曹翻故纸，共看诗句煮春蔬。\n问来却是东坡集，久别相逢味胜初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与长孺共读杜诗","author":"杨万里","text":"病身兀兀脑岑岑，偶到儿曹文字林。\n一卷杜诗揉欲烂，两人齐读味初深。\n斲肝枉却期千载，漏眼谁曾更再寻。\n笔底奸雄死犹毒，莫将饶舌泄渠心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与侯子云溪上晚步","author":"杨万里","text":"人入溪园自掩门，溪流新落两三痕。\n杖藜紫菊霜风径，送眼丹枫夕照村。\n行住忽然忘近远，阴晴未肯定寒暄。\n多时不出今聊出，牧子樵儿一笑喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨妨于农收因访子上有叹","author":"杨万里","text":"君能过我意殊倾，我每看君脚便轻。\n若为泥涂断还往，端令老病底心情。\n未霜杨柳秋犹碧，既雨芙蓉晚更明。\n旱岁嫌晴不嫌熟，今年教熟不教晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之永和小憩资寿寺","author":"杨万里","text":"石子密铺径，竹茎疏作行。\n不缘憩驺仆，几失此山房。\n佛像看都好，林花静自香。\n未须清兴尽，归更借僧床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千叶水仙花","author":"杨万里","text":"薤叶葱根两不差，重蕤风味独清嘉。\n薄揉肪玉围金钿，浅染鹅黄剩素纱。\n台盏元非千叶种，丰容要是小莲花。\n向来山谷相看日，知是它家是当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小箬舟中望月","author":"杨万里","text":"偶于古柳系春船，云放千峰月满川。\n跳入广寒宫里坐，下看碧玉镜中天。\n斯须万象都成雪，遮莫三更且未眠。\n归到金陵入官府，梦中说梦也无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小箬岭望见灵山","author":"杨万里","text":"青鞋紫陌倦黄埃，送眼灵山一快哉。\n碧玉熏炉天半立，青莲花萼雾中开。\n宿云准拟偷将去，晓日殷勤唤出来。\n欲琢新诗镵绝壁，梯空上去御风回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山丹花","author":"杨万里","text":"春去无芳可得寻，山丹最晚出云林。\n柿红一色明罗袖，金粉群虫集宝簪。\n花似鹿葱还耐久，叶如芍药不多深。\n青泥瓦斛移山蘤，聊著书窗伴小吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村二首 其二","author":"杨万里","text":"歇处何防更歇些，宿头未到日头斜。\n风烟绿水青山国，篱落紫茄黄豆家。\n雨足一年生事了，我行三日去程赊。\n老夫不是如今错，初识陶泓计已差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山村二首 其一","author":"杨万里","text":"一搭山村一搭奇，不堪风物索新诗。\n稻花雪白糁柳絮，柘子猩红团荔枝。\n行者自愁居者乐，晴时即热雨时泥。\n问知桐汭多程在，未说宣城与贵池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"杨万里","text":"鬓秃犹云少，书多却道穷。\n柴门疏竹处，茅屋万山中。\n幽梦时能忆，闲题底要工。\n不知蝉报夏，为复自吟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶","author":"杨万里","text":"树子团团映碧岑，初看唤作木犀林。\n谁将金粟银丝脍，簇饤朱红菜椀心。\n春早横招桃李妒，岁寒不受雪霜侵。\n题诗毕竟输坡老，叶厚有棱花色深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己丑上元后晚望","author":"杨万里","text":"雪里晴偏好，寒馀暖尚轻。\n山烟春自起，野烧暮方明。\n又是元宵过，端令病骨惊。\n遣愁聊觅句，得句却愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"已过胥口将近钓台","author":"杨万里","text":"睡起衣襟乱，头巾百摺痕。\n帆端风色紧，船底水声喧。\n胥口冤馀浪，严滩钓处村。\n因行还访古，故老莫能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马郎中母蒋夫人挽章","author":"杨万里","text":"文物馀三径，芝兰秀五常。\n鱼轩来粉省，象服去黄堂。\n此母今谁似，清名死不亡。\n一生令吏部，废却蓼莪章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐四首 其四","author":"杨万里","text":"初闻一犬两犬声，次第远近鸡都鸣。\n今夕明朝何日了，南村北巷几人行。\n忽思春雨宿茅店，最苦仆夫催去程。\n是时懒起惜残睡，如今不眠愁独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐四首 其三","author":"杨万里","text":"暗虫夜啼不肯停，直从黄昏啼到明。\n不知讨论底事著，为复怨嗟谁子生。\n至竟通宵千万语，真实只是两三声。\n唧唧唧唧复唧唧，此外何言君试听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐四首 其二","author":"杨万里","text":"非关枕上爱哦诗，聊复销愁片子时。\n老眼强眠终不梦，空肠暗响诉长饥。\n翻来覆去体都痛，乍暗忽明灯为谁。\n只道昼长无那著，夜长难奈不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐四首 其一","author":"杨万里","text":"老来只愿酒难醒，酒力才醒梦便惊。\n露滴新寒欺病骨，宦游如梦记平生。\n深山五鼓鸡吹角，落月一窗鹅打更。\n等待晓光雕好句，晓光未白句先成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中元日午","author":"杨万里","text":"雨馀赤日尚如炊，亭午青阴不肯移。\n蜂过无花绝粮道，蚁行有水遏归师。\n今朝道是中元节，天气过于初伏时。\n小圃追凉还得热，焚香清坐读唐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中元前贺余处恭尚书祷雨沛然沾足","author":"杨万里","text":"数点飘萧供晚清，二更倾泻到天明。\n雷驱云气如旋磨，雨遍山村却入城。\n簟面顿无秋后暑，檐牙最爱梦中声。\n尚书幸有为霖手，偏洒江东作么生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋与诸子果饮","author":"杨万里","text":"几年今夕一番逢，千古何人此兴同。\n酒入银河波底月，笛吹玉桂树梢风。\n莫言秋色无多巧，净洗清光也费工。\n老子病来浑不饮，如何频报绿尊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋无月至十七日晓晴","author":"杨万里","text":"劣到中秋云便兴，中秋过了却成晴。\n雾横平野村村白，日上疏林叶叶明。\n岁事不应如许早，朝来已觉嫩寒生。\n春吟不似秋吟好，觅句新来分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋后一夕登清心阁二首 其二","author":"杨万里","text":"秋夜真成昼，西山却在东。\n吹高半轮月，正赖一襟风。\n清景今年过，何人此兴同。\n青天忽成纸，似欲借诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋后一夕登清心阁二首 其一","author":"杨万里","text":"昨夜云为祟，今宵月始妍。\n如何一日隔，便减半分圆。\n影里偏宜竹，光中不剩天。\n客来休遣去，我醉正无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋雨过月出","author":"杨万里","text":"欲遣清风扫乱云，先将一雨净游尘。\n今年大作中秋事，月色何孤我辈人。\n照却八方还剩在，看来千古许清新。\n不眠不惜明朝补，报答孤光醉是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前一夕玩月","author":"杨万里","text":"月拟来宵好，吾先今夕遭。\n才升半壁许，已复一轮高。\n迁坐明相就，群飞影得逃。\n望秋惟有此，彻夜敢辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前一夕雨中登双溪叠嶂已而月出二首 其二","author":"杨万里","text":"双溪叠嶂旧知名，投老初登眼不醒。\n一雨飞来四天黑，乱云遮断万峰青。\n急呼月色开秋色，夺得昭亭与敬亭。\n自笑诗翁犹狡狯，不饶山鬼弄精灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前一夕雨中登双溪叠嶂已而月出二首 其一","author":"杨万里","text":"州在三峰最上头，上头高处更高楼。\n都将万壑千岩景，堆作双溪叠嶂秋。\n晚雨才收山尽出，暮天似水月如流。\n敬亭堪喜还堪恨，领得风光揽得愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前一夕携酒与子仁侄登多稼亭","author":"杨万里","text":"月忽飞来堕我傍，我还飞入月中央。\n如何桂树许多影，不隔冰轮些子光。\n自古中秋多苦事，非风即雨断人肠。\n醉来不信寒欺酒，露湿杯盘冻作霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋前两日别刘彦纯彭仲庄于白马山下","author":"杨万里","text":"匆匆离合梦非梦，续续谈谐眠不眠。\n莫道对床容易著，试思分手几何年。\n长亭更放金荷浅，后夜谁同璧月圆。\n要得长随二三友，不知由我定由天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋病中不饮二首后一首用辘轳体 其二","author":"杨万里","text":"无风无雨并无云，今岁中秋尽十分。\n毕竟冰轮谁为转，碾穿玉宇不生痕。\n坐看儿辈纷然饮，也遣先生半欲醺。\n自是清樽负明月，不关明月负清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋病中不饮二首后一首用辘轳体 其一","author":"杨万里","text":"去年两浙浙西州，今夕南溪溪上头。\n满著玻瓈一盆水，洗开玉镜十分秋。\n病来不饮非无酒，老去追驩总是愁。\n自笑独醒仍苦咏，枯肠雷转不禁搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丰山小憩","author":"杨万里","text":"归路元无远，行人倦自迟。\n野香寒蝶聚，秋色老枫知。\n得得逢清荫，休休憩片时。\n江山岂无意，邀我觅新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为王监簿先生求近诗","author":"杨万里","text":"林下诗中第一仙，西风吹到日轮边。\n杜陵野客还惊市，国子先生小著鞭。\n拈出老谋开宇宙，本来清尚只云泉。\n新篇未许儿童诵，但得真传敢浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书黄庐陵伯庸诗卷","author":"杨万里","text":"句法何曾问外人，单传山谷当家春。\n截来云锦花无样，倒写珠胎海亦贫。\n汗竹香中翻墨汁，扶桑梢上挂头巾。\n诗名官职看双美，向道儒冠不误身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月一日过贵溪舟中苦热","author":"杨万里","text":"半月阴凉天气佳，今朝新暑不饶些。\n一生怕热长逢热，千里还家未到家。\n入却船来那得出，恰方日午几时斜。\n劝君莫爱高官职，行路难时却怨嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更入宣城诣天庆观朝谒","author":"杨万里","text":"晓雾双溪水，秋风百舫桥。\n行穿子城过，却望女墙遥。\n落月能相伴，疏钟似见招。\n小亭憩山半，换马上岧峣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从丁家洲避风行小港出荻港大江三首 其三","author":"杨万里","text":"芦挥麈尾话清秋，柳弄腰支舞绿洲。\n引得江风颠入骨，戏抛波浪过于楼。\n十程拟作一程快，一日翻成十日留。\n未到大江愁未到，大江到了更添愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从丁家洲避风行小港出荻港大江三首 其二","author":"杨万里","text":"荻篱萧洒织来新，茅屋横斜画不真。\n乾地种禾那用水，湿芦经火自成薪。\n岛居莫笑三百里，菜把活它千万人。\n白浪打天风动地，何曾惊著一微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从丁家洲避风行小港出荻港大江三首 其一","author":"杨万里","text":"蓼岸藤湾隔尽人，大江小汊绕成轮。\n围蔬放荻不争地，种柳坚堤非买春。\n匏瓠放教俱上屋，渔樵相倚自成邻。\n夜来更下西风雪，荞麦梢头万玉尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从范至能参政游石湖精舍坐间走笔二首 其二","author":"杨万里","text":"震泽分波入，垂虹隔水看。\n何须小风起，生怕牡丹寒。\n政坐诸峰好，端令落笔难。\n催人理归棹，落日许无端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从范至能参政游石湖精舍坐间走笔二首 其一","author":"杨万里","text":"孤塔鸥边迥，千岩镜里看。\n折花倩人插，摘叶护窗寒。\n不是无相识，相从却是难。\n归舟望精舍，已在白云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从提举黄元章登齐山寺后上清岩翠微亭望郡城左清溪右大江盖绝境云","author":"杨万里","text":"西山落日浴长江，并贯清溪作一光。\n千嶂围来天四合，孤城涌出水中央。\n楼台玉塔云间见，杨柳金堤镜里长。\n客子要穷秋浦眼，翠微亭上上清旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以六一泉煮双井茶","author":"杨万里","text":"鹰爪新茶蟹眼汤，松风鸣雪兔毫霜。\n细参六一泉中味，故有涪翁句子香。\n日铸建溪当退舍，落霞秋水梦还乡。\n何时归上滕王阁，自看风炉自煮尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以糟蟹洞庭甘送丁端叔端叔有诗因和其韵","author":"杨万里","text":"斗州只解寄鹅毛，鼎肉何曾馈百牢。\n驱使木奴供露颗，催科郭索献霜螯。\n乡封万户只名醉，天作一丘都是糟。\n却被新诗太清绝，唤将雪虐更风饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日癸卯占云大熟","author":"杨万里","text":"造物今年印，司花昨夜交。\n雪留芦荻脚，日到瑞香梢。\n白叟占嘉应，青精看满抄。\n游丝也驩喜，不住舞蟏蛸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十四日病起喜雨闻莺与大儿议秋凉一出游山三首 其三","author":"杨万里","text":"暑气朝来扫地空，南风毕竟让西风。\n秋生楚尾吴头外，凉杀天涯地角中。\n万叠山连千涧水，双行缠伴一郫筒。\n初程道是穷忙著，且宿东山东复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十四日病起喜雨闻莺与大儿议秋凉一出游山三首 其二","author":"杨万里","text":"病势初来敌颇强，排山倒海也难当。\n老夫笑把东西玉，竖子难藏上下肓。\n酒阵时闻报三捷，诗坛元不费单枪。\n夜来梦入清凉国，风月冰人别是乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十四日病起喜雨闻莺与大儿议秋凉一出游山三首 其一","author":"杨万里","text":"末伏将催中伏休，匆匆送夏又迎秋。\n暑中竹色风仍雨，病里莺声喜破愁。\n大熟十年无此作，微生一饱更何求。\n急须剩踏莲花曲，药玉新船待拍浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十八日立秋送客夜归雨作","author":"杨万里","text":"青天赤日更黄埃，迎送纷纷正往来。\n一夜炎蒸无计奈，三更风雨领秋回。\n人生作么禁寒暑，世事何如付酒杯。\n遮莫髯间点霜雪，何曾笔下减琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月将晦夜出凝归门","author":"杨万里","text":"暑里街头可久停，今宵无月也宵征。\n一天星点明归路，十里荷香送出城。\n山轿声声柔橹紧，葛衣眼眼野风清。\n五更月出还家了，不早相期作伴行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午过乌东","author":"杨万里","text":"险尽涂初坦，寒轻日向中。\n稻云迟雨碧，荞雪早霜红。\n五日再行役，二年三鞠躬。\n只言弃官久，却与在官同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午热憩忠义渡","author":"杨万里","text":"秋阳嗔我紧追程，急泊临流一短亭。\n摘索风巾些子倦，苍茫水枕霎时醒。\n单牌双堠头都白，万壑千岩眼强青。\n不及溪边老亭父，一生卧护竹窗棂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午睡起","author":"杨万里","text":"过雨馀秋暑，移床拣午凉。\n小风吹醉面，凛气忽如霜。\n日脚何曾动，桐阴有底忙。\n倦来聊作睡，睡起更苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩方虚坐睡","author":"杨万里","text":"午暑残偏力，长亭歇未行。\n睡乡蝇俶扰，诗阵笔专征。\n今夕南吾枕，何时北我旌。\n不应菊花酒，儿女不同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩堆钱岭","author":"杨万里","text":"蚤作难为饭，前途又苦饥。\n尘劳正未了，眠食且随宜。\n小憩那思去，追程得更迟。\n馆人只冷眼，还为惜奔驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩褚家方清风亭二首 其二","author":"杨万里","text":"莫道迎春好，迎春是送春。\n可怜一条路，知老几多人。\n坦绿偏宜袜，飘红并可絪。\n青帘好消息，今日榨头新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"午憩褚家方清风亭二首 其一","author":"杨万里","text":"此老忒疏放，与春无怨私。\n何须寒食日，恰是别家时。\n荒店两三只，野花千万枝。\n前山有底恨，也学客间眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壬寅岁朝发石塔寺","author":"杨万里","text":"晓钟梦裹苦相呼，强裹乌纱照白须。\n只有铜炉烧柏子，更无玉盏泻屠酥。\n佛桑解吐四时艳，铁树还如九节蒲。\n省得一朝疲造请，却教终日走长涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":68723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]