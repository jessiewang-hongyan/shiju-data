[{"title":"次韵李元老柬王令周簿喜雨 其二","author":"陈棣","text":"山色云容泼墨深，随车甘澍湿衣襟。\n神龙应祷方施力，虐魃为殃漫有心。\n洗出筼筜无滞暑，养成䆉稏有馀阴。\n他年德政君须记，能遣骄阳化作霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苏守金橘","author":"陈棣","text":"孤根移植自秋山，长养潜私刺史天。\n青女染成金色浅，冯夷剖出蚌胎圆。\n惭非甘吉曾同传，耻与杨卢议并肩。\n况有词章传乐府，佳名从此入新编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈公藻局中即事时推排物力不得往来","author":"陈棣","text":"料峭轻寒春寂寥，雨馀庭竹静萧萧。\n一池芳草翠欲合，数点残梅雪未消。\n寸步思君成瘦悴，片文怡我足欢谣。\n相过政恐还惊座，恶客从来不待招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈季陵主簿秋雨","author":"陈棣","text":"一雨庭芜便许凉，扫除旱魃化骄阳。\n微添远水罗襟润，已觉疏苗玉粒香。\n乐岁可期宽吏责，谫才无取为诗忙。\n萧萧枕簟偏宜睡，梦入华胥正渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈季陵觅酒二首 其二","author":"陈棣","text":"山远谁怜眉黛愁，水明遥忆眼波秋。\n久抛大白犹閒事，却对短檠真拙谋。\n楚佩纫香尘未暗，巫云赋梦语多浮。\n扊扅政恐闺人怨，曾效当年拥髻不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈季陵觅酒二首 其一","author":"陈棣","text":"西风曾未入梧楸，已有骚人怨凛秋。\n草赋未为伧父语，破愁宜召曲生谋。\n君方负笈金陵去，我欲乘桴沧海浮。\n后夜月明应好在，一樽能为辍行不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陶几道喜雨","author":"陈棣","text":"环佩来从十二峰，飞廉清道驾丰隆。\n已占月魄离星次，欲采民谣咏雨濛。\n健笔输君三峡峻，新凉许我一樽同。\n豚蹄斗酒无多诮，神报邦人亦已丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅花四首 其四","author":"陈棣","text":"爱花长苦恼天君，政恐因花赋洛神。\n江上风霜方破腊，岭头冰雪已回春。\n故人远信来千里，浪蕊凡香隔一尘。\n天与孤高超世俗，肯将剩馥乞蜂臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅花四首 其三","author":"陈棣","text":"镂玉凝酥若未匀，南枝髣髴露天真。\n横陈月下无双影，占断人间第一春。\n屈子浪吟兰畹佩，韩公羞卜杏花邻。\n广平见谓心如铁，翻学高唐草赋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅花四首 其二","author":"陈棣","text":"冻合千林暖未回，一枝先见腊前梅。\n寒溪淡月凭谁赏，冷蕊疏香不自媒。\n赖有此君为伴侣，略无凡卉作舆台。\n攲危百折江头路，应为多情得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梅花四首 其一","author":"陈棣","text":"得得寻梅已觉迟，凭栏空赋惜花诗。\n流传远信人千里，漏泄春工雪一枝。\n照水丰容妃子浴，傍山瘦影伯夷饥。\n最怜清绝牵情处，月落参横画角悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喜雨","author":"陈棣","text":"雨气侵人襟袖凉，诗愁恼起沈东阳。\n诘朝秧马催田畯，昨夜雷车动阿香。\n鸠妇岂知忧旱去，商羊聊亦为时忙。\n芙蓉秋水须佳句，妙意宜搜到渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵喜雨兼简彝老","author":"陈棣","text":"此身阅世一浮沤，无地安巢拙胜鸠。\n击节闻君歌喜雨，裹粮知我迫填沟。\n凉宵自足庄生梦，丰岁仍宽子美忧。\n遥想高人禅寂处，娟娟窗竹不胜幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵鲁尧卿病起 其二","author":"陈棣","text":"一区聊寄古墙阴，灯火萧条语夜深。\n强对简编聊适意，欲参佛祖问安心。\n青衫有约还轻别，白发无期苦见寻。\n咫尺佳时修禊事，兰亭老笔为君临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵鲁尧卿病起 其一","author":"陈棣","text":"河阳桃李未成阴，已觉栽培用意深。\n病起暂同中酒味，诗来还有惜花心。\n养全浩气虹千丈，瘦减清标玉一寻。\n春待吾侪共行乐，莫言无暇倦登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汝平诸公见和复用韵二首 其二","author":"陈棣","text":"新诗敏捷雨翻盆，樽酒何时与细论。\n拟把铅刀侔巨阙，却惭布鼓过雷门。\n天心月胁形容遍，春蚓秋蛇体势存。\n但得唱酬为老伴，此生道眼未容浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汝平诸公见和复用韵二首 其一","author":"陈棣","text":"鹅黄快泻映金盆，白堕湘酃岂并论。\n酩酊不妨寻醉侣，鞠躬底事入公门。\n杯觞往往陪嘲谑，笔札时时荷记存。\n指日看君乘障去，好将韬略靖羌浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观曹寿卿上舍诗轴题其后 其二","author":"陈棣","text":"欲观骚雅继周南，虎子应须虎穴探。\n策蹇冲寒将类贾，避堂舍盖愿同参。\n书能泣鬼世谁信，诗解穷人我自谙。\n但得低头拜东野，此心依约已先甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观曹寿卿上舍诗轴题其后 其一","author":"陈棣","text":"君诗字字敌双南，直把骊珠取次探。\n李杜盟寒谁共主，曹刘机浅不须参。\n囊中句好缘多爱，天外心归计饱谙。\n读罢长编知隽永，自然齿颊带馀甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别墅芍药盛开沈公辟有诗见嘲次韵代柬 其一","author":"陈棣","text":"谁为东君得意忙，尚留红药殿群芳。\n脸霞得酒生朝晕，衣翠笼纱弄晚妆。\n剩馥倚风来蝶翅，残膏和露到蜂房。\n惜花极力搜佳句，瘦损东阳笑沈郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别墅芍药盛开沈公辟有诗见嘲次韵代柬 其二","author":"陈棣","text":"翰林忆昔咏孤芳，自合移根向玉堂。\n贵客亲陪天女手，侍臣应带御炉香。\n花前未许退之醉，江上空嗟子美狂。\n一夜殷红飘落尽，不堪寂寞对霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵目","author":"陈棣","text":"思穷烟浪阔，目断暮云层。\n旧赏去何有，新诗得未曾。\n披章如对景，搜句懒挑灯。\n酬唱惭非敌，君千我百能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芳园","author":"陈棣","text":"勋业尊朝著，园池近日光。\n雕栏红玉列，羽盖碧荷张。\n草薙难滋蔓，花开宁久长。\n当年金谷地，榛棘断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈镇江生辰 其一","author":"陈棣","text":"协气盘空兆吉祥，挺生英杰辅明昌。\n依乘圣际风云久，游戏人间日月长。\n落落词华天黼黻，堂堂仪矩国辉光。\n烟桡破浪来何事，敬为宗盟一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈镇江生辰 其三","author":"陈棣","text":"着物薰然一气和，温温眉宇得春多。\n腰黄眼赤浑閒事，柳绿花红奈乐何。\n旧事几经铜狄话，佳词惯听雪儿歌。\n一杯何以为公寿，愿借长江万里波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈镇江生辰 其二","author":"陈棣","text":"力致功名上要途，忠嘉屡奉玉音俞。\n持荷久侍甘泉橐，剖竹仍分刺史符。\n抚字雅闻閒燕寝，经纶先已定规模。\n久虚左辖宁无谓，天子畴庸正用儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"使君馈食戏少蒙教授","author":"陈棣","text":"朝来食指非常动，果报兵厨已割烹。\n醇德且多从事酒，珍庖特异小人羹。\n虎头食肉方灰念，羊脚蹴蔬应震惊。\n归遗细君真得计，随缘灯火任卿卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚申日戏题","author":"陈棣","text":"多情节物苦撩人，用事葩华巧斗新。\n老去唯愁添甲子，年来不独畏庚申。\n身閒淡淡心机静，梦好齁齁鼻息匀。\n政使三彭肆簧舌，冰壶贮月本无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客舍久雨无酒戏柬沈泰叔","author":"陈棣","text":"秋来泞淖几曾乾，旅邸盘旋寻丈间。\n拟仗神功击阳石，却疑天漏类阴山。\n已甘从事经年别，未放管城终日閒。\n欲课新诗强消遣，客情无赖语还悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客舍春晚","author":"陈棣","text":"晼晚春归婺女城，轻阴浅绿绕长亭。\n禽声劝客年年恨，草色随人处处青。\n为米未容陶令去，餔糟敢笑屈原醒。\n诗成错莫浑无事，满院杨花昼掩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴五首 其五","author":"陈棣","text":"料峭寒犹薄，阴云带晚烟。\n雨催惊蛰候，风作勒花天。\n日永消香篆，愁浓逼酒船。\n为君借馀景，收拾赋新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴五首 其四","author":"陈棣","text":"鸭绿前溪涨，鹅黄远柳垂。\n微波卷罗带，细叶展颦眉。\n爱酒常歌颂，伤春更赋诗。\n东君无限思，全在野桃枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴五首 其三","author":"陈棣","text":"桃李漫芬芳，终然委路旁。\n踏青心欲醉，举白兴何长。\n梦觉池塘绿，诗成草木香。\n懒追时俗好，独立倚苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴五首 其二","author":"陈棣","text":"地僻近烟萝，门无车马过。\n林深宜雨急，野旷觉春多。\n草软游人醉，莺娇姹女歌。\n颠狂江上兴，可奈少陵何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日杂兴五首 其一","author":"陈棣","text":"春色遽如许，春愁一望赊。\n帘低宜著燕，柳暗欲藏鸦。\n鸠妇催疏雨，蜂臣趁落花。\n只愁清景促，无计驻曦车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成三首 其三","author":"陈棣","text":"陋巷逢春日，生涯亦足誇。\n堆钱聚榆荚，积絮扑杨花。\n旌旆千行竹，笙歌两部蛙。\n凭谁为商榷，何似五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成三首 其二","author":"陈棣","text":"雨后春逾丽，平堤涨绿波。\n侵人花气酿，刺眼麦芒多。\n舴艋閒蓑笠，鞦韆醉绮罗。\n光阴难把玩，秀句与消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成三首 其一","author":"陈棣","text":"东君驰驿骑，万里一宵通。\n柳眼凝晴碧，桃腮泣露红。\n丙鳞安浅濑，乙羽怯柔风。\n莫向高城望，愁生阿堵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春来","author":"陈棣","text":"春来底物最先知，冻蝶痴蜂便欲飞。\n好雨应时生地脉，迅雷剖蛰震天威。\n光风艳艳翔空阔，和气骎骎发细微。\n解道苍苔红药句，令人却忆谢玄晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨","author":"陈棣","text":"春雨止复作，无聊终日閒。\n殷红悲着地，浅绿暗归山。\n云幕久蒙润，风扉每日关。\n愁端与诗思，容易减朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独觉","author":"陈棣","text":"檐滴萧萧静，微凉午睡宜。\n莺簧有馀韵，蚁穴不多时。\n篆烬回风灭，花阴晚日移。\n觉来无一事，追梦续新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑舜举赴阙 其二","author":"陈棣","text":"束装西啸指长安，正是新春快活天。\n酒病诗愁应有梦，鸟啼花发正争妍。\n君空冀北今行矣，我滞周南岂偶然。\n东閤他时访遗逸，为言憔悴鹤溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑舜举赴阙 其五","author":"陈棣","text":"备员无补见丝毫，幸喜为官似马曹。\n每许芜音持布鼓，更容劣技试铅刀。\n兼收屡赐百金诺，借重终期一字褒。\n廊庙他时应有待，誓将么么寄钧陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑舜举赴阙 其三","author":"陈棣","text":"籍甚声名著日边，英辞健笔许谁先。\n置之华省星曹上，付以赤墀香案前。\n好向从班光玉笋，伫膺蜜炬照金莲。\n此行何啻登仙去，愿拜车尘为执鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑舜举赴阙 其四","author":"陈棣","text":"暂绾桐川刺史章，优优布政汉循良。\n凤衔初下新颁诏，鸡舌曾闻旧赐香。\n前席久虚思见贾，玺书增宠果徵黄。\n从今定展调元手，小试专城见雨旸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦暑","author":"陈棣","text":"试作西风想，烦襟郁嫩凉。\n李沉寒玉碧，瓜泛浅金黄。\n羽扇徒挥雪，纱厨不贮香。\n白醪虽可漉，染指敢先尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽中书舍人叶公三首 其三","author":"陈棣","text":"久厌承明直，遐宣使驿风。\n乘轺循浙右，持斧肃江东。\n共徯锋车召，俄惊夜壑空。\n传家宜令子，济物有阴功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽中书舍人叶公三首 其二","author":"陈棣","text":"遍历清华地，星辰纪未周。\n雄文藏凤阁，直笔著螭头。\n闻望高簪绂，论思动冕旒。\n从班无跬步，底事却回辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽中书舍人叶公三首 其一","author":"陈棣","text":"博学该群籍，飞声蔼上庠。\n巍科曾叠贯，要路遂横翔。\n策府登清选，铨曹得望郎。\n九重方简在，一鉴遽云亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽内兄余聘可三首 其三","author":"陈棣","text":"去去松茔路，愁闻薤露诗。\n齐眉乖妇约，华发重亲悲。\n被酒清狂后，论文慷慨时。\n伤心栖止地，无复见形仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽内兄余聘可三首 其二","author":"陈棣","text":"结发事铅椠，终身尺寸功。\n矫情多病后，饮恨不言中。\n户有三珠秀，家愁五盗穷。\n空山埋玉树，肠断白杨风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽内兄余聘可三首 其一","author":"陈棣","text":"中外六兄弟，相逢丱角中。\n追随万里远，忧乐半生同。\n胜韵谈飞屑，高怀气吐虹。\n纷纷身外事，回首万缘空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽主簿吴宁侯三首 其三","author":"陈棣","text":"忆昔荆湖日，童心懵未开。\n七年勤仰止，一字有从来。\n模范瞻如在，音仪挽不回。\n依归今已矣，些语写馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽主簿吴宁侯三首 其二","author":"陈棣","text":"昔我先君子，时称鉴裁公。\n知君非介绍，虚馆授儿童。\n倒屣迎王粲，登门得孔融。\n他年记先友，孰不仰清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽主簿吴宁侯三首 其一","author":"陈棣","text":"德行追前辈，声华擅一乡。\n游心终艺圃，得隽屡文场。\n小试栖鸾政，连飞荐鹗章。\n伤嗟台阁地，不许暂翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽处士吴德载二首 其二","author":"陈棣","text":"范蠡操赢日，相如病渴时。\n瓶罂虽屡罄，砭剂已难施。\n薤露鸰原惨，松茔雁序悲。\n更嗟垂白叟，泣送宁馨儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽处士吴德载二首 其一","author":"陈棣","text":"忆昔知公日，东嘉逆旅中。\n游从三月久，谈笑一樽同。\n却暑瓜盘绿，烹鲜鲙箸红。\n伤心栖止地，万事转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽处士富公二首 其二","author":"陈棣","text":"家富仓箱积，陶朱伯仲间。\n禔身郭有道，教子窦燕山。\n钱鏄周贫匮，刀圭起病孱。\n悬知公不死，学道透玄关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽处士富公二首 其一","author":"陈棣","text":"庆历元臣后，勋名泰华高。\n当年遗德泽，流裔尽英豪。\n继世誇荣耀，唯公隐寂寥。\n潜辉传野史，犹足见清标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽丞相祁国公三首 其三","author":"陈棣","text":"强壮登黄阁，斑衣衮绣成。\n飞声追丙魏，有子继韦平。\n舟楫川方济，龙蛇梦倏惊。\n天胡啬遐寿，举世但哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽丞相祁国公三首 其二","author":"陈棣","text":"宠极心弥小，名尊貌愈恭。\n勋华双辅翼，槐鼎四登庸。\n海宇熙春物，边陲罢夕烽。\n了无能致绩，颂笔漫形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽丞相祁国公三首 其一","author":"陈棣","text":"斧扆求良弼，钧衡得伟人。\n文章照黼黻，勋业见经纶。\n化洽编氓阜，时调宝历新。\n方祈永霖雨，俄复跨箕辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽江公三首 其三","author":"陈棣","text":"忆昔羁栖日，唯公迹分亲。\n呼卢银烛夜，琢句锦囊春。\n棋敌争先劲，弓号命中频。\n向来行乐地，无复见斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽江公三首 其二","author":"陈棣","text":"世路方巇险，高情与众殊。\n一官聊戏剧，三径肯荒芜。\n富乐身蒹有，功名累独无。\n丰碑谁秉笔，持此较贤愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽江公三首 其一","author":"陈棣","text":"彩笔传家学，春华饰妙词。\n品题风鉴远，论议月评推。\n柳岸阴将合，濠亭迹半隳。\n治家有遗训，留付宁馨儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张世英母夫人","author":"陈棣","text":"异乡萍梗寄生涯，朝露俄惊叹落花。\n蒿里歌传风正惨，萱堂香冷月空斜。\n魂归故国三千里，地卜高原一万家。\n明日送车应击毂，不堪阁泪听边笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]