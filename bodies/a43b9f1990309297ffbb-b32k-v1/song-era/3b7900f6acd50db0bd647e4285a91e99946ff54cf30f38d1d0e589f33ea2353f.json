[{"title":"句","author":"王子俊","text":"并舍者谁清可喜，各家之竹翠相交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏练川","author":"王子昭","text":"吴淞江上流来水，鸭绿粼粼漾清泚。\n东风无力蔼清光，一片縠纹吹不起。\n夜来雨涨三尺深，鵁鶄鸂鶒争浮沉。\n芹芽迸土抽白玉，柳线拂浪摇青金。\n锦袍先生乘一舸，此处恍然天上坐。\n閒听渔郎唱棹歌，遥指奇峰三四朵。\n堤旁有人新结庐，轩窗瞰水宜幽居。\n村童唤渡去沽酒，野叟就船来买鱼。\n风清月淡堪娱乐，笑掬沧浪缨可濯。\n何须寻访武陵溪，不必思吞云梦泽。\n下流香水正迟迟，草边得句何新奇。\n地灵人杰萃斯景，尚传灵运严维诗。\n桃花浪暖鱼游处，三十六鳞欲飞举。\n有龙若向此中蟠，早为苍生作霖雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其三","author":"王子容","text":"蓬海移春，卿云约月，庆传王母骖鸾。\n九仙福地，不减玉龟山。\n况是莱儿绣斧，都衬得、彩舞斓斑。\n瑶觞举，平反一笑，功行足三十。\n木天。\n来瑞节，行封两国，宫锦蝉联。\n更孙枝满座，兰畹芝田。\n中诏肩舆上殿，称万寿，椒掖欢颜。\n黄钟数，从新九九，巧历演长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一 寿京尹","author":"王子容","text":"台衮筹边，京师蒙福，两淮谈笑尘清。\n正銗筒无讼，桴鼓亦稀鸣。\n阅武分弓角射，催春事、亲劝农耕。\n何须待，寻花问柳，小队出郊坰。\n功名。\n今已就，九重近天，好去辞荣。\n算人间极贵，何似长生。\n刺占梅山日月，观二妙，玉纹抨。\n休辞醉，洛阳花信，香到露华亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二","author":"王子容","text":"瑞霭腾空，长庚入梦，挺生名世真贤。\n荐膺宸眷，移镇日华边。\n千里民谣载路，薰和气、俱作春妍。\n须知道，西湖草木，亦自肃成权。\n黄堂。\n开雅宴，酒浮云液，歌倚湘弦。\n□赐金增秩，入侍甘泉。\n且向露桃花底，拚沉醉，频举觥船。\n祈难老，鬓随柳绿，官共早莺迁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆盈盈题玉女池二首 其二","author":"王山","text":"柳条黄尽杏梢新，山翠无非昔日春。\n花色笑风春似醉，寂寥惟少赏花人。\n忆昔闲妆淡纻衣，一枝红拂牡丹徽。\n无端不入襄王梦，为雨为云到处飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆盈盈题玉女池二首 其一","author":"王山","text":"浮世繁华一梦休，登临因忆昔年游。\n人归依旧野花笑，玉冷几经坟树秋。\n风月过情须感慨，江山多恨即迟留。\n如今纵拟誇才思，事往情多特地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊盈盈三首 其三","author":"王山","text":"小巷朱桥花又春，洞房何事不归云。\n二年前过曾携手，今日重来忽见坟。\n香魄已飞天上去，凤箫犹似月中闻。\n纵然却入襄王梦，会向阳台忆使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊盈盈三首 其二","author":"王山","text":"弦绝秦筝镜任尘，细腰休舞凤凰茵。\n一枝浓艳埋香土，万颗珍珠湿袖巾。\n行雨不归魂梦断，落花难伴绮罗春。\n汉皇甲帐当年意，纵有芳魂不似真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊盈盈三首 其一","author":"王山","text":"烛花红死睡初醒，一枕孤怀病客情。\n海上有山应大梦，人间无路可长生。\n乾坤意入凭栏阔，风月人归似旧情。\n汉殿香销春寂寂，夕阳无语下西城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中作","author":"王山","text":"绛阙琳宫锁乱霞，长生未晓弃繁华。\n断无方朔人间信，远阻麻姑洞里家。\n历劫易翻沧海水，浓春难谢碧桃花。\n紫台树稳瑶池阔，凤懒龙娇日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答盈盈","author":"王山","text":"东风艳艳桃李松，花园春入屠酥浓。\n龙脑透缕鲛绡红，鸳鸯十二罗芙蓉。\n盈盈初见十五六，眉试青膏鬓垂绿。\n道字不正娇满怀，学得襄阳大堤曲。\n阿母偏怜掌上看，自此风流难管束。\n莺啄含桃未咽时，便会郎时风动竹。\n日高一丈罗窗晚，啼鸟压花新睡短。\n腻云纤指摆还偏，半被可怜留翠暖。\n淡黄衫袖仙衣轻，红玉栏干妆粉浅。\n酒痕落腮梅忍寒，春羞入眼横波艳。\n一缕未消山枕红，斜睇整衣移步懒。\n才如韩寿潘安亚，掷果窃香心暗嫁。\n小花静院酒阑珊，别有私言银烛下。\n帘声浪皱金泥额，六尺牙床罗帐窄。\n钗横啼笑两不分，历尽风期腰一搦。\n若教飞上九天歌，一声自可倾人国。\n娇多必是春工与，有能动人情几许。\n前年按舞使君筵，睡起忍羞头不举。\n凤凰箫冷曲成迟，凝醉桃花过风雨。\n阿盈阿盈听我语，劝君休向阳台住。\n一生纵得楚王怜，宋玉才多谁解赋。\n洛阳无限青楼女，袖笼红牙金凤缕。\n春衫粉面谁家郎，只把黄金买歌舞。\n就中薄倖五陵儿，一日冷心玉如土。\n云零雨落正堪悲，空入他人梦来去。\n浣花溪上海棠湾，薛涛朱户皆金镮。\n韦皋笔逸玳瑁落，张佑盏滑琉璃乾。\n压倒念奴价百倍，兴来奇怪生毫端。\n醉眸觑纸聊一扫，落花飞雪声漫漫。\n梦得见之为改观，乐天更敢寻常看。\n花间不肯下翠幕，竟日烜赫罗雕鞍。\n扫眉涂粉迨七十，老大始顶菖蒲冠。\n至今愁人锦江口，秋蛩露草孤坟寒。\n盈盈大雅真可惜，尔身此后不可得。\n满天风月独倚阑，醉岸浓云呼佚墨。\n久之不见予心忆，高城去天无几尺。\n斜阳衡山云半红，远水无风天一碧。\n望眼空遥沈翠翼，银河易阔天南北。\n瘦尽休文带眼移，忍向小楼清泪滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招六贤之歌","author":"王巳","text":"矩矱兮姱美，风节兮凌厉。\n鹤媒兮一空，宇宙兮莫穷。\n六贤去兮不复返，魂漂摇兮渺何在。\n飞扬千里兮层冰峨峨，雄虺九首兮壶蜂繁多。\n挟飞仙兮同游，揖清献兮并辀。\n俯幽兰兮延伫，褰杜衡兮实处。\n援北斗兮椒浆，聊徜徉兮此堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古鹤","author":"王中立","text":"天地之间一古儒，醒来不记醉中书。\n旁人错比神仙字，只恐神仙字不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遗閒閒赵公","author":"王中立","text":"寄与閒閒傲浪仙，枉随诗酒堕凡缘。\n黄尘遮断来时路，不到蓬山五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王中立","text":"醉袖舞嫌天地窄，诗情狂压海山平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖 其一","author":"王云","text":"湖景甲东城，亭台相照清。\n地分春色早，波动日华生。\n绝胜新图展，涵虚古鉴明。\n绿杨烟岸侧，风约钓舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖 其二","author":"王云","text":"三月前头二月天，湖亭雄绝富韶妍。\n石形卓砌虎蹲岸，樯影浸波龙卧渊。\n向日鲜明花曝锦，随风零乱柳飞绵。\n春来此地堪行乐，谁共赏心张雅筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李都官道堂","author":"王云","text":"高挂朝冠返故乡，静延真侣创新堂。\n不容閒草依阶砌，已许归云宿栋梁。\n爱客定须添酒病，惜春应未减诗狂。\n肯同阮巷分南北，松竹交阴隔藓墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠大仰齐禅师","author":"王云","text":"大仰古名刹，师居二纪中。\n本无一法说，须信万缘空。\n体与大虚合，心将诸祖同。\n唐来三百载，不坠释迦风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠仰山简老","author":"王云","text":"简师飞锡地，天外集云峰。\n挐石松根瘦，歆窗竹影浓。\n山寒侵坏衲，涧响杂疏钟。\n客问西来意，无言凭短筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张氏钟秀阁","author":"王云","text":"卜筑■郊扉，登临野趣宜。\n鸥边春浪间，草外碧云低。\n画忆王摩诘，诗渐杜拾遗。\n徘徊半楼月，残夜水明时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王云","text":"经夏地无暑，未寒泉有冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王云","text":"为怜绿叶四时在，不可朱阑一日无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沁园春","author":"王云焕","text":"四十君王，三百载间，兴亡一家。\n叹幕府峰高，生涯社燕，胭脂井暗，富贵飞花。\n山骨呈羞，江声带恨，磨尽英雄岁月赊。\n君知否，是枋头灞上，著数全差。\n倚空长剑吁嗟。\n奈争战年来似乱麻。\n但苍陵古冢，白杨啼鴂，荒园废沼，青草鸣蛙。\n旗盖东南，风涛天堑，难比兴亡隙地些。\n休凝伫，望长安路杳，夕照愁鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王亢","text":"地接荆门形势远，气连吴会物华秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑氏馆中书事","author":"王介","text":"今年移砚席，又上白云边。\n夜气清于水，春愁薄似烟。\n庭前松已脑，门外柳应绵。\n尤喜安床处，更深无杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫","author":"王介","text":"飘飘辽鹤去难寻，野客重来叹复吟。\n许迈林中丹灶冷，郭文山上白云深。\n南陵事迹都非昔，北岭归期直到今。\n珍重玉京无限意，待将功节养高岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张晋彦秋日","author":"王从","text":"地迥高楼目，天寒故国心。\n江鸥无万里，云木自千寻。\n门掩斜阳下，人归落叶深。\n风前怅何许，入耳越乡吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王从","text":"尘心依水净，归鬓与山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"王从","text":"临春惨不舒，盖国空自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"王从","text":"身闲更得凭陵酒，花早殊非爱惜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王从","text":"凉风回远笛，暝色带归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王从","text":"落木森犹力，寒山淡欲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"王从","text":"一番风雨催寒食，千里莺花想故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王从","text":"堕蕊尽教输燕子，嫩寒犹及占梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"王从","text":"秋生列岫云尤薄，泉漱悬崖路更悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"王从叔","text":"风中柳絮水中萍。\n聚散两无情。\n斜阳路上短长亭。\n今朝第几程。\n何限事，可怜生。\n能消几度春。\n别时言语总伤心。\n何曾一字真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南柯子/南歌子 苦雨","author":"王从叔","text":"碧树留云湿，青山似笠低。\n鹧鸪啼罢竹鸡啼。\n不晓天天何意、要梅肥。\n昨日穿新葛，今朝御夹衣。\n思家怀抱政难为。\n只恐归来憔悴、却羞归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭君怨","author":"王从叔","text":"门外春风几度。\n马上行人何处。\n休更卷朱帘。\n草连天。\n立尽海棠花月。\n飞到荼香雪。\n莫怪梦难成。\n梦无凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋蕊香 用清真韵","author":"王从叔","text":"薄薄罗衣乍暖，红入酒痕潮面。\n絮花舞倦带娇眼。\n昨夜平堤水浅。\n故人信断风筝线。\n误归燕。\n梦魂不怕山路远。\n无奈棋声隔院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 梅","author":"王从叔","text":"水月精神玉雪胎。\n乾坤清气化生来。\n断桥流水领春回。\n昨夜醉眠苔上石，天香冉冉下瑶台。\n起来窗外见花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"王从益","text":"风驭去难留，将期汗漫游。\n入辞丹陛晓，重卧赤城秋。\n枕畔红霞合，门前瀑布流。\n龙车款太帝，鹤信寄浮丘。\n醉引青鸾曲，闲披白鹿裘。\n夜来胡蝶梦，先已到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夔州歌简晁子西","author":"王从道","text":"白帝夔州万古城，全蜀东门下相控。\n瞿唐滟滪势崭绝，赤甲白盐光澒洞。\n峡雨关云朝莫征，烟叶水花洲渚共。\n少陵冥寞减光辉，山川草木今谁讽。\n明知风物待组织，可笑可笑浪嘲弄。\n逸亭野老泛舟来，迥立苍茫游览纵。\n旋提燕拂呵物象，试吐清音激鸾凤。\n江头一见晁广文，客里倡酬无乃奉。\n天生之子映昭代，与我突出万人众。\n古来道合事襟期，有作正须行雅颂。\n下瞰一隅会万景，岂无江灵为供送。\n请君作诗如画图，收拾形容未宜空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中闻九里香花","author":"王以宁","text":"不见江梅三百日，声断紫箫愁梦长。\n何许绿裙红帔客，御风来献返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其一 裴公亭怀古","author":"王以宁","text":"岁晚橘洲上，老叶舞愁红。\n西山光翠，依旧影落酒杯中。\n人在子亭高处，下望长沙城郭，猎猎酒帘风。\n远水湛寒碧，独钓绿蓑翁。\n怀往事，追昨梦，转头空。\n孙郎前日，豪健颐指五都雄。\n起拥奇才剑客，十万银戈赤帻，歌鼓壮军容。\n何似裴相国，谈道老圭峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 其二 呈汉阳使君","author":"王以宁","text":"大别我知友，突兀起西州。\n十年重见，依旧秀色照清眸。\n常记鲒埼狂客，邀我登楼雪霁，杖策拥羊裘。\n山吐月千仞，残夜水明楼。\n黄粱梦，未觉枕，几经秋。\n与君邂逅，相逐飞步碧山头。\n举酒一觞今古，叹息英雄骨冷，清泪不能收。\n鹦鹉更谁赋，遗恨满芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其二","author":"王以宁","text":"白石读书房，世有斗南人杰。\n一段素襟清韵，似玉壶冰雪。\n仙家赤酒荐交梨，道眼况超越。\n来往十州三岛，跨一轮新月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其一","author":"王以宁","text":"诗客少微家，世有斗南人杰。\n一段素襟清韵，似玉壶冰雪。\n怀中卿相饱经纶，况是好时节。\n我有太平歌颂，待形容贤业。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆双椿/浣溪沙 汪周佐夫妇五月六日同生","author":"王以宁","text":"问政山头景气嘉。\n仙家绿酒荐菖芽。\n仙郎玉女共乘槎。\n学士文章舒锦绣，夫人冠帔烂云霞。\n寿香来是道人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二","author":"王以宁","text":"云收天碧。\n渐风高露冷，群喧初寂。\n远浦归舟荒渡口，搴篷横棹堤侧。\n一带澄江，十分蟾影，千里寒光白。\n襟怀迎爽，有人独步携策。\n遥想帘卷琼楼，凭阑凝望，此意知何极。\n声断秦箫双凤驾，凌厉飞仙同籍。\n问汉乘槎，采珠临海，往事空踪迹。\n莫辞吟赏，终宵清景难得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其一 淮上雪","author":"王以宁","text":"天工何意，碎琼珰玉佩，书空千尺。\n箬笠蓑衫扁舟下，淮口烟林如织。\n飞观嶙峋，子亭突兀，影浸澄淮碧。\n纶巾鹤氅，是谁独笑携策。\n遥想易水燕山，有人方醉赏，六花如席。\n云重天低酣歌罢，胆壮乾坤犹窄。\n射雉归来，铁鳞十万，踏碎千山白。\n紫箫声断，唤回春满南陌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其三","author":"王以宁","text":"晚烟凝碧。\n渐渔村山市，人归寂寂。\n有客飞舟还顾访，应讶纶巾敧侧。\n得意忘年，推诚投分，高论追元白。\n英标逸气，笑予穷抱真策。\n兴尽又复言归，秋风分袂，浩荡思无极。\n咫尺昭山明翠壁，那知中隐咸籍。\n说梦难听，闭门寻梦，肯念栖萍迹。\n浪吟狂醉，几时还共重得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二","author":"王以宁","text":"此理循环如引锯，春来百草菲菲。\n道人一笑悟前非。\n功名真长物，夕霭与朝霏。\n梦褥清孙今禄隐，漫郎自许风期。\n江楼景物得旬时。\n平芜三百里，天阔夕阳迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一 和子安","author":"王以宁","text":"眼看西园红与紫，年来几度芳菲。\n吾生四十渐知非。\n祗思青箬笠，江上雨霏霏。\n饮酒但知寻夏季，不须远慕安期。\n丹成仙去是何时。\n龟藏何必学，春日正迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 李左司生日","author":"王以宁","text":"未折江南柳，先开陇上梅。\n绿情红意到根荄。\n昨夜春随和气、已归来。\n忠力扶昌运，冲和保圣胎。\n阳功阴德好栽培。\n他日骑鲸仙路、指蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 张国泰生日","author":"王以宁","text":"快雨疏风六月凉。\n貂蝉人著彩衣裳。\n肃然心拜玉炉香。\n相国趣还调鼎鼐，潘舆指日下潇湘。\n秋来江上接归航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二 寿赵倅","author":"王以宁","text":"艾胜迎薰寿缕长。\n碧篘酒泛绿蒲香。\n万家喜气在都梁。\n小阁幽轩新料理，舞衫歌扇且传觞。\n看君飞步上明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 张金志洗儿","author":"王以宁","text":"招福宫中第几真。\n餐花辟谷小夫人。\n天翁新与玉麒麟。\n我识外家西府相，玉壶冰雪照青春。\n小郎风骨已凌云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 舣舟洪江步下","author":"王以宁","text":"起看船头蜀锦张。\n沙汀红叶舞斜阳。\n杖拿惊起睡鸳鸯。\n木落群山雕玉□，霜和冷月浸澄江。\n疏篷今夜梦潇湘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲","author":"王以宁","text":"往事闲思人共怕。\n十年塞上烟尘亚。\n百万铁衣驰铁马。\n都弄罢。\n八风断送归莲社。\n卖药得钱休教化。\n归来醉卧蜗牛舍。\n一颗明珠元不夜。\n非待借。\n神光穿透诸天下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":11494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]