[{"title":"宿石岊馆二首 其二","author":"朱熹","text":"停骖石岊馆，解缆清江滨。\n中流棹歌发，天风水生鳞。\n名都固多才，我来友其仁。\n兹焉同舟济，讵止胡越亲。\n舞雩谅非远，春服亦已成。\n相期岂今夕，岁晚无缁磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏岩桂二首 其一","author":"朱熹","text":"亭亭岩下桂，岁晚独芬芳。\n叶密千层绿，花开万点黄。\n天香生净想，云影护仙妆。\n谁识王孙意，空吟招隐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏岩桂二首 其二","author":"朱熹","text":"露浥黄金蕊，风生碧玉枝。\n千林向摇落，此树独华滋。\n木末难同调，篱边不并时。\n攀援香满袖，叹息共心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵芮察院送□宝文赴浙漕二首 其一","author":"朱熹","text":"远俗何劳问，威名旧已孚。\n百城方仰泽，一节遽还都。\n圣主勤脩政，今年决破胡。\n期公宁馈挽，注想在谋谟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵芮察院送□宝文赴浙漕二首 其二","author":"朱熹","text":"考卜川清旷，端居柰乐何。\n风云一以便，岁月不胜多。\n节传无淹驾，林园得屡过。\n功名从迫逐，志业岂蹉跎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽梁文靖公二首 其一","author":"朱熹","text":"擢第初龙首，登庸再凤池。\n心期讵温饱，身任必安危。\n几岁调娱政，今年殄瘁诗。\n恭惟衮敛意，不尽鉴亡悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽梁文靖公二首 其二","author":"朱熹","text":"疏宠无前比，腾章又夙心。\n极知求士切，端为爱君深。\n卤簿寒笳远，尘埃断藁侵。\n空令杀公掾，衰涕满寒襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽周侍郎二首 其一","author":"朱熹","text":"德量推容物，才猷足济时。\n阴功覃远徼，馀算饱雄师。\n行李淹星岁，还乡感羽仪。\n一朝成殄瘁，九牧共伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽周侍郎二首 其二","author":"朱熹","text":"忆昔趋丹阙，看公上玉除。\n民饥深献纳，主圣极欷歔。\n解手寒江阔，惊心夜壑虚。\n朅来空老泪，无地别輀车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽董安人二首 其一","author":"朱熹","text":"雅望推前辈，承爱赖女师。\n闺门传懿范，汤沐盛恩私。\n万里骖鸾去，千秋宰树悲。\n自应铭妇德，谁与篆丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽董安人二首 其二","author":"朱熹","text":"令尹古循吏，郡君今胜流。\n平生馀事业，晚岁极熏脩。\n穗帐真成梦，灵辰竟不留。\n遗风被箫挽，未觉九泉幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题霜杰集","author":"朱熹","text":"先生人物魏晋间，题诗便欲倾天悭。\n向来无地识眉宇，今日天遣窥波澜。\n平生尚友陶彭泽，未肯轻为折腰客。\n胸中合处不作难，霜下风姿自奇特。\n小儒阅阀金匮书，不滞周南滞海隅。\n枌榆连阴一见晚，何当挽袖凌空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢吴公济菖蒲","author":"朱熹","text":"翠羽纷披一尺长，带烟和雨过书堂。\n知君别有臞仙种，容易难教出洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"易二首 其一","author":"朱熹","text":"立卦生爻事有因，两仪四象已前陈。\n须知三绝韦编者，不是寻行数墨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"易二首 其二","author":"朱熹","text":"潜心虽出重爻后，著眼何妨未画前。\n识得两仪根太极，此时方好绝韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客来二首 其一","author":"朱熹","text":"客来何处觅红云，唯见风前万点春。\n心赏未妨随处好，绿杨阴里换纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客来二首 其二","author":"朱熹","text":"怅望君家岭上云，便携佳友去寻春。\n论诗剧饮无他意，未管残红落佩巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题沈公雅卜居图","author":"朱熹","text":"往者仲长子，高情世无俦。\n一朝谢尘躅，卜筑娱清幽。\n茅屋八九间，下有良田畴。\n后檐果垂实，前庭树相樛。\n胜日宾友来，琴觞共舒忧。\n言论覈幽妙，理乱穷端由。\n至今一卷书，凛然昭千秋。\n沈侯经济业，夙尚本林丘。\n谈笑出幻境，寤言蹑斯游。\n仰睇白石岗，俯濯青瑶流。\n旷然宇宙外，邈矣将焉求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武林","author":"朱熹","text":"春风不放桃花笑，阴雨能生客子愁。\n只我无心可愁得，西湖风月弄扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐庐舟中见山寺","author":"朱熹","text":"一山云水拥禅居，万里江楼绕屋除。\n行色匆匆吾正尔，春风处处子何如。\n江湖此去随沤鸟，粥饭何时共木鱼。\n孤塔向人如有意，他年来借一蘧蒢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读尤美轩诗卷谨赋一篇寄呈伯时季路二兄","author":"朱熹","text":"我闻洞岩幽，结友事临眺。\n浮言妨胜践，怅望空永啸。\n归来眩奇语，更欲穷䆗窱。\n却寻两翁意，宴坐得观照。\n鸣泉俯淙琤，穹石仰苍峭。\n共与前创古，三叹遗墨妙。\n神游恍不隔，仁宅忻有要。\n回首鹿门期，寒云生远峤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熹次延之年兄韵敬题绍德庵真如轩写呈伯时季路二兄","author":"朱熹","text":"先生可是爱吾庐，来往邻庵几闰馀。\n柏下竟开千岁室，竹间犹插万签书。\n悲凉共识临风处，游戏谁知落笔初。\n寄语山灵勤守护，莫将题柱比相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"益公道人相见信安道温陵旧游出示近诗因次其韵 其一","author":"朱熹","text":"别来几度见归鸿，岁月悠悠一梦中。\n莫道相望湖海阔，争知千里不同风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"益公道人相见信安道温陵旧游出示近诗因次其韵 其二","author":"朱熹","text":"一身千里伴征鸿，北去南来羁旅中。\n珍重故人相认得，新诗重举旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次益老韵","author":"朱熹","text":"乾坤极处无今古，道术多岐自短长。\n傥有新思还告我，不应无雁到衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日","author":"朱熹","text":"一雨生凉杜若洲，月波微漾绿溪流。\n茅檐归去无尘土，淡薄闲花绕舍秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放船二首 其一","author":"朱熹","text":"浩荡清江水，依微绿树风。\n解维春雨外，弭棹夕阳中。\n江草生新径，岩花点旧丛。\n诗翁不愁思，逸兴莽何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放船二首 其二","author":"朱熹","text":"畴昔清溪峡，船头戏彩翰。\n十年空往事，一梦记前滩。\n陡绝垂苍壁，澄虚列翠峦。\n今宵诗卷里，重得纵遐观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与一维那","author":"朱熹","text":"当年事幽讨，结友穷名山。\n曾逢许斧子，去采玉芝还。\n归来坐空房，神清骨毛寒。\n起视尘中人，一见了肺肝。\n探囊出刀圭，生死毫釐间。\n相逢瘴海秋，遗我黄金丹。\n高堂得听瑩，班衣有馀欢。\n谢师无言说，古井生波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上广文","author":"朱熹","text":"广文何事创楼居，收拾家藏理蠹馀。\n尚有简编充栋宇，拟陈车马大门闾。\n移床客去邀明月，送酒人来递异书。\n纵使清贫无长物，犹胜四壁似相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"考试感事戏作","author":"朱熹","text":"海邑三年吏，勤劳不为身。\n但令官事了，从遣黠儿嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题米仓壁","author":"朱熹","text":"度量无私本至公，寸心贪得意何穷。\n若教老子庄周见，剖斗除衡付一空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题安隐壁","author":"朱熹","text":"征车少憩林间寺，试问南枝开未开。\n日暮天寒无酒饮，不须空唤莫愁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梵天方丈壁","author":"朱熹","text":"输尽王租生理微，野僧行乞暮还归。\n山空日落无钟鼓，只有虚堂蝙蝠飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月五日海上遇风雨作","author":"朱熹","text":"疾风吹雨满征衫，陆走川行两不堪。\n尘事萦人心事远，濯缨何必在江潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两绝句送顺之南归 其一","author":"朱熹","text":"门前三径长蒿莱，愧予慇勤千里来。\n校罢遗书却归去，此心元自不曾灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两绝句送顺之南归 其二","author":"朱熹","text":"几年江海事幽寻，遍兴云僧话此心。\n今日肯来论旧学，岁寒犹恐雪霜侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈讲师","author":"朱熹","text":"闻道山中客，年来鬓欲皤。\n静便三径小，贫觉一身多。\n且喜诗无病，从教睡作魔。\n故人今领众，犹足慰蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别陈讲师","author":"朱熹","text":"几年劳梦想，今日慰登临。\n况入芝兰室，又闻金玉音。\n与君连夜语，尽我一生心。\n此外成华发，无因得重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登閤皂山 其一","author":"朱熹","text":"叠叠层峦锁閟宫，我来旧地访灵踪。\n葛仙去后无丹灶，弟子今成白发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登閤皂山 其二","author":"朱熹","text":"一派泠泠台下水，半空漠漠岭头云。\n祖师成道冲天去，只有无穷受箓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送单应之往閤山 其一","author":"朱熹","text":"杖头挑月入烟萝，城郭尘埃柰尔何。\n若到名山高著眼，洞天深处异人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送单应之往閤山 其二","author":"朱熹","text":"回首名山我旧游，曾将风袂挹浮丘。\n如今不及台边水，长向山前山后流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李道士归玉笥三首 其一","author":"朱熹","text":"偶随云去伴云归，笑指清都在翠微。\n为我中间留一榻，他年去著薜萝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李道士归玉笥三首 其二","author":"朱熹","text":"玉笥山连都水坑，拂云楼殿对峥嵘。\n君归后夜无馀事，卧听寒泉落涧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李道士归玉笥三首 其三","author":"朱熹","text":"莫惜临行酒一杯，看君上马古城隈。\n相望两地无多远，频寄音书与雁来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赤城观","author":"朱熹","text":"落日空山秋气清，泠泠古木乱蝉鸣。\n仙人一去鹤不返，剑客重来丹已成。\n静对竹炉烟缕直，细看月窟桂华生。\n此身旧有蓬瀛约，玉简归来问姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"尤溪县学观大阁","author":"朱熹","text":"令尹弦歌不下堂，叱嗟层观丽扶桑。\n朱甍碧瓦临无地，散帙投壶乐未央。\n得意溪山供徙倚，忘情鱼鸟共徜徉。\n应观物我同根处，剖破藩篱即大方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月上休日游卧龙玉渊三峡用山谷惊鹿须要野学盟鸥本愿秋江分韵得鸥字","author":"朱熹","text":"匡庐霜天后，不见云气浮。\n木叶红已疏，山颜转清幽。\n向闻有绝壑，乃在卧龙湫。\n及此遂一往，幸无烟景愁。\n隮攀欲其深，泉石固所求。\n况有百尺崖，喷雪飞寒流。\n幽岑自回抱，直下鸣青璆。\n便可洗我耳，枕石忘所忧。\n精神共虚廓，方物皆悠悠。\n所恨非独往，不能恣夷犹。\n仰叹云间鹤，俯羡谷中鸥。\n先生先我来，结屋阳冈头。\n虚名付忠武，灭迹慕巢由。\n是间颇足居，不田亦平畴。\n野人种椒橘，崖蜜易岁收。\n西源有老翁，卷舌藏戈矛。\n似学辟世士，乃欲邀圣丘。\n先生且无然，但作一月留。\n俟我有决计，它时卜从游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次周师温游书堂韵兼简坐上诸同志","author":"朱熹","text":"畴昔因来行水馀，依依唯认昔人居。\n新堂已幸经重构，旧事难追更特书。\n所愿弦歌闻十室，休誇文字赋三都。\n同来况有濂溪裔，心印相传尽未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西源居士斸寄秋兰小诗为谢","author":"朱熹","text":"知有幽芳近水开，故攀危磴斸苍苔。\n却怜病客空斋冷，带雨和烟远寄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡兴乐江望祝融次择之韵","author":"朱熹","text":"江头晓渡野云遮，惆望山岐映暮霞。\n人值风波几千里，济川舟楫我侬誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岳后步月","author":"朱熹","text":"清光冰魄浩无边，桂影扶疏吐玉娟。\n人在峰头遥指望，举杯对影夜无眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自上封下福岩道傍访李邺侯书堂山路榛合不可往矣遂赋此","author":"朱熹","text":"山道榛芜大道荒，令人瞻望邺侯堂。\n怀贤空白悲今昔，泪滴西风恨夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题南台","author":"朱熹","text":"步入招提境，云间有古台。\n管弦山鸟弄，琼玖雪花开。\n方外人稀到，山头势更巍。\n登临思不尽，何日再重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将下山有作","author":"朱熹","text":"芒鞋踏破万重山，五日淹留在此间。\n行客归来山下望，却疑身自九天还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王晦叔寄德瑩弟韵 其一","author":"朱熹","text":"闻道君归湘水东，经行长在白云中。\n诗成天柱峰头月，酒醒朱陵洞里风。\n旧学难酬香一瓣，流年谁管鬓双蓬。\n书来为指誵误处，不涉言诠不落空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王晦叔寄德瑩弟韵 其二","author":"朱熹","text":"试上闽山望楚天，雁飞欲断势还连。\n凭将袖里数行字，与问云间双髻仙。\n我访旧游终有日，君归故里定何年。\n祇今心事同千里，静对箪瓢独喟然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏红白莲","author":"朱熹","text":"红白莲花共一塘，两般颜色一般香。\n宫娥梳洗争先后，半是浓妆半淡妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒二徐先生墓","author":"朱熹","text":"道学传千古，东瓯说二徐。\n门清一壶水，家富五车书。\n但喜青毡在，何忧白屋居。\n我怀人已远，挥泪表丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠内弟程允夫三首 其一","author":"朱熹","text":"外家人物有吾子，我乃平生未见尝。\n文字只今多可喜，江湖他日莫相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠内弟程允夫三首 其二","author":"朱熹","text":"故家归来云树长，向来辛苦梦家乡。\n行藏正尔未坚快，又见春风登俊良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠内弟程允夫三首 其三","author":"朱熹","text":"我忆当年诸老翁，经纶事业久参同。\n只今零落三星晓，未厌栖迟一亩宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹","author":"朱熹","text":"潇潇凌霜雪，浓翠异三湘。\n疏影月移壁，寒声风满堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题魏府藏赵公饮器","author":"朱熹","text":"赵公饮器魏府藏，我思两公爱甘棠。\n惟魏子孙实无斁，敬奉其盈如升克。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘虚谷","author":"朱熹","text":"细读还丹一百篇，先生信笔亦多言。\n玄机谩向经书觅，至理端于目睫存。\n二马果能为我驭，五芽应自长家园。\n明朝驾鹤登山去，此话更从谁与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠傅得一","author":"朱熹","text":"到处逢人说傅颠，相看知是几生前。\n直携北斗倾天汉，去年龙宫第二仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"追和李士举徐氏山居韵","author":"朱熹","text":"山岫孤云意自闲，不妨王事似连环。\n解鞍盘礴忘归去，碧涧修筠似故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽崔嘉彦二首 其一","author":"朱熹","text":"关陕遗耆老，天资得勇多。\n双瞳光射日，寸舌辩倾河。\n居俯三江近，邻从五老过。\n庐空人不见，猿鹤奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽崔嘉彦二首 其二","author":"朱熹","text":"林下相从旧，回头一十年。\n君论金鼎诀，我赋白云篇。\n泉石无闲意，丹砂结世缘。\n康山空葬骨，已作洞中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]