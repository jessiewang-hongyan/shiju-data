[{"title":"梅花五首 其一","author":"刘克庄","text":"髣髴瑶姬拥仗来，茆檐化作玉楼台。\n平明绕砌圆残梦，元是梅花数树开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其五","author":"刘克庄","text":"金榜朱扉此帝居，旧游恍似梦清都。\n可怜白首充修撰，到了藏山一字无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其二","author":"刘克庄","text":"锡山落在暮云边，几载无书寄老仙。\n公艺九龄余望八，梦商史稿觉悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其六","author":"刘克庄","text":"径畈山栖谢宦情，竹溪巷处闭柴荆。\n然藜曾伴刘中垒，起蕝谁招鲁两生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其三","author":"刘克庄","text":"加璧年高公误矣，免冠发秃上怜之。\n悬知黄鹄飞难返，独恨青牛去稍迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其一","author":"刘克庄","text":"学士朋来似堵墙，共看老笔出提纲。\n绣鞯张盖传呼宠，不比倡优蓄子长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其七","author":"刘克庄","text":"久轩虽贵尚儒癯，商略斯人似蔡谟。\n给札曾来为学士，拂衣不爱作司徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦与尤木石论史感旧七绝句 其四","author":"刘克庄","text":"眼昏渐觉聚萤难，闲杀兰台旧史官。\n纵使青藜重下照，细书如蚁不能看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦馆宿二首 其二","author":"刘克庄","text":"罡风误送到蓬莱，昔种琪花今已开。\n僮鹤来迎俱叹息，老仙又老似前回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦馆宿二首 其一","author":"刘克庄","text":"花木扶疏月露清，昔人来此比登瀛。\n不知做得神仙未，身在乔松顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深村","author":"刘克庄","text":"身老深村负岁华，青苔径里是贫家。\n晚风一阵无端急，不为山人惜柚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深溪驿","author":"刘克庄","text":"苔满朱扉半阖开，更无人迹独徘徊。\n湘江临别如相语，早买扁舟出岭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔梁","author":"刘克庄","text":"浅溪忽涨寻常水，朽树犹开千百花。\n有酒可沽鱼可买，造门莫问是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理发二首 其二","author":"刘克庄","text":"昔笑聪秃首，如韩戏观师。\n若聪今见我，汝亦有几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理发二首 其一","author":"刘克庄","text":"种种一何短，青青无复垂。\n可怜髡髦子，不见指冠时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移居二首 其二","author":"刘克庄","text":"邻曲无还往，何由有别情。\n惟应小窗月，长记读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移居二首 其一","author":"刘克庄","text":"庭下蔷薇树，花开玉雪毬。\n主人明日去，相对似含愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绿珠","author":"刘克庄","text":"畏死仕新室，轻生谢季伦。\n细评投阁者，大愧坠楼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船子和尚遗迹在华亭朱泾之间圭上人即其所诛茅名西亭精舍介竹溪求诗于余寄题三绝 其一","author":"刘克庄","text":"诚和尚昔挂孤帆，圭上人今架小庵。\n老去身无安顿处，挑包便拟作禅参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船子和尚遗迹在华亭朱泾之间圭上人即其所诛茅名西亭精舍介竹溪求诗于余寄题三绝 其三","author":"刘克庄","text":"万顷烟波百尺丝，禅家宗旨有谁知。\n自嫌固陋如高叟，却为僧笺把钓诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船子和尚遗迹在华亭朱泾之间圭上人即其所诛茅名西亭精舍介竹溪求诗于余寄题三绝 其二","author":"刘克庄","text":"自昔吴僧标致清，经禅之外有诗名。\n士衡止在东家住，恨不同听鹤唳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萍乡","author":"刘克庄","text":"闻说萍乡县，家家有绢机。\n荒年丝价贵，未敢议寒衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒墓五首 其五","author":"刘克庄","text":"鬓毛雪尽难重绿，烧地春来又再青。\n但出郭门行十里，新丘大半是余铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒墓五首 其四","author":"刘克庄","text":"庵里僧应行脚去，龛中佛也为眉嚬。\n炎炎昔有□□者，寂寂今无上冢人。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒墓五首 其三","author":"刘克庄","text":"先君遗令有馀哀，自扫苍苔酹一杯。\n八十孤孙头尽白，未知更得几回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒墓五首 其二","author":"刘克庄","text":"尼父常言讳徵在，释迦说法向摩耶。\n僧伽端的□□姓，络秀何须有外家。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒墓五首 其一","author":"刘克庄","text":"甘霖长濑四五尺，宿雾缄山三两重。\n惭愧□□□□策，年年来为母浇松。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐者","author":"刘克庄","text":"宁采箕山钓颍滨，放勋天大不能臣。\n渔郎未必知年代，先有逃尧次避秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雀","author":"刘克庄","text":"恰见趋燕市，俄闻集兔园。\n雕笼驯养者，谁到翟公门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆头","author":"刘克庄","text":"雨雪萧萧驿堠长，不堪流潦入车箱。\n抚州城外黄泥路，即是人间小太行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄田人家别墅缭山种海棠为赋二绝 其一","author":"刘克庄","text":"万红扶路笑相迎，彷佛前身石曼卿。\n若向花中论富贵，芙蓉城劣海棠城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄田人家别墅缭山种海棠为赋二绝 其二","author":"刘克庄","text":"海棠妙处有谁知，全在胭脂乍染时。\n试问玉环堪比否，玉环犹自觉离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄檗道中崖居者","author":"刘克庄","text":"种竹成林橘满园，牛归童子掩篱门。\n主人虽不知名氏，想见孤高可与言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨口号九首呈潘侯 其八","author":"刘克庄","text":"扶杖追凉看稻花，不烦轧轧踏沟车。\n残年无以酬公上，长作输租第一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨口号九首呈潘侯 其七","author":"刘克庄","text":"蔬是侬家野八珍，小畦自灌极艰辛。\n清晨卧听檐声喜，馀惠分沾抱瓮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨口号九首呈潘侯 其五","author":"刘克庄","text":"火伞朱旗总叱开，新凉稍自白蘋回。\n世人枉了嗔风伯，到底烦渠送雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨口号九首呈潘侯 其四","author":"刘克庄","text":"昨日旸乌赤似金，朝来忽化作甘霖。\n老农失喜逢人说，滴滴来从太守心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","poin