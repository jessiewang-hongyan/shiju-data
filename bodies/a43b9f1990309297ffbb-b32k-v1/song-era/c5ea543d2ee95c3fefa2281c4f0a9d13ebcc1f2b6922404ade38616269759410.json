[{"title":"还丹复命篇 五言十六首 其十五","author":"薛道光","text":"饮了灵丹药，纯阳自在人。\n洞明常寂照，蓬岛镇长春。\n去就浑无系，纵世已绝尘。\n但知周甲子，不在守庚申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 五言十六首 其十六","author":"薛道光","text":"访道复寻真，优游四海宾。\n外多含忍辱，内省任邅迍。\n为厌人间事，忻逢紫府宾。\n一言亲点化，玉洞碧桃春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其一","author":"薛道光","text":"万物皆从一气生，天清地浊禀生成。\n真龙真虎才交媾，一鼎红铅鍊甲庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二","author":"薛道光","text":"阴阳配合法君臣，动静相兼气血精。\n壬癸位中男击浪，丙丁岩畔女嚬呻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其三","author":"薛道光","text":"龙虎一交相眷恋，坎离才媾便成胎。\n溶溶一掬乾坤髓，著意求他啜取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其四","author":"薛道光","text":"方以类聚物群分，两畔两秤共一斤。\n戊己宫中藏水火，小心调理武和文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其五","author":"薛道光","text":"离宫有象藏真水，坎户无形隐赤龙。\n时节正时须急采，莫教芽蘖隘黄宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其六","author":"薛道光","text":"三十辐兮同一毂，金木才逢二气交。\n六十卦分朝与暮，一阳萌处发初爻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其七","author":"薛道光","text":"阴里十三言有象，阳中六七觅无踪。\n抽添运用须防谨，认取根源祖与宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其八","author":"薛道光","text":"恍惚之中寻有物，杳冥之内吸真精。\n真精便是长生药，须假黄婆养育成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其九","author":"薛道光","text":"六百篇中仔细推，潜藏飞跃探幽微。\n亲疏回互相谙悉，盗取七星南斗机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十","author":"薛道光","text":"阴鼎阳炉至道根，五行和合土为尊。\n时人若要长生药，祇向华池觅魄魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十一","author":"薛道光","text":"圣人传药不传火，从来火候少人知。\n莫将大道为儿戏，须共神仙仔细推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十二","author":"薛道光","text":"火候抽添思绝尘，一爻看过一爻生。\n阴文阳武依加减，一颗还丹火里成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十三","author":"薛道光","text":"咽津纳气固形全，须藉乾坤真汞铅。\n至道不繁人自昧，五金八石是虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十四","author":"薛道光","text":"二气本因儿产母，夺来鼎内及其时。\n夫欢妇合黄金室，一载胎生一个儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十五","author":"薛道光","text":"识得阴阳要妙因，鍊成金液离凡尘。\n淘澄不是寻常事，姹女婴儿两要真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十六","author":"薛道光","text":"驱回北斗转天罡，手握南辰入洞房。\n否泰爻中天地合，兔鸡沐浴要潜藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十七","author":"薛道光","text":"水晶宫里翠娥娇，一段风光破寂寥。\n夺得兔乌精与髓，急须收拾鼎中烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十八","author":"薛道光","text":"屏除人我守丹房，转觉光阴气味长。\n荣辱不随尘外客，但于金鼎鍊铅霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其十九","author":"薛道光","text":"虎髓龙精气象全，依法修来火候煎。\n直待阴消成至宝，便知平地隐神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十","author":"薛道光","text":"些小天机论气精，吕公曾道别无真。\n神仙不肯分明说，说与分明笑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十一","author":"薛道光","text":"九还七返定三才，开辟抽添尽藉媒。\n四象包含归戊己，精勤十月产婴孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十二","author":"薛道光","text":"迩来活计不胜清，一亩沙田手自耕。\n晴雨共资春气力，不愁苗稼不滋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十三","author":"薛道光","text":"归根复命复元真，气入四肢精养神。\n神气若还俱不散，混同尘世一闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十四","author":"薛道光","text":"一物浮浮浑有无，堪迎秋露滴真珠。\n烟花柳陌头头是，秽浊馨香任所需。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十五","author":"薛道光","text":"我今收得长生法，年年海上觅知音。\n不知谁是知音者，试把狂言著意寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十六","author":"薛道光","text":"几年勤苦觅仙俦，不做神仙未肯休。\n缘合自然成大道，岂教凡辈觅踪由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十七","author":"薛道光","text":"父母生来真一气，无形无影卒难寻。\n要知黑白通玄妙，魂魄相投产紫金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十八","author":"薛道光","text":"上善之基妙最深，华池神水定深沉。\n神功运火抽添处，鍊己持心莫放心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其二十九","author":"薛道光","text":"东西南北要精通，交感阴阳雌与雄。\n火候直须牢稳审，吹嘘全藉巽宫风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还丹复命篇 七言三十首 其三十","author":"薛道光","text":"天地相交由否泰，屯蒙气候互相通。\n一夫一妇资天地，三女三男合始终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又诗一首","author":"薛道光","text":"拂掠廛中碍眼尘，休将大道付人情。\n堪矜自古神仙辈，持故如愚不作声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"王黼","text":"巧将千嶂遮晴日，借得三眠作翠帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"盛子充","text":"竹筒牙签日满前，何妨心醉六经眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滁州希真堂并蒂菊","author":"梅执礼","text":"前辈风流扫地空，秋香无复伍春红。\n旋培数本当幽砌，忽作双英满翠丛。\n可但断金私雨露，故应连璧傲霜风。\n得来称瑞毋轻剪，留此甘棠寿醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和四年东阳梅某出守蕲州以五月十九日斋宿山谷黎明奉亲朝谒真源万寿宫少休五云寺赋此","author":"梅执礼","text":"灊高夙所仰，妙想嗟未圆。\n邂逅一麾出，安舆奉华颠。\n骎骎涉胜境，获缔香火缘。\n徘徊庆基殿，稽首颂尧年。\n徐步俯松杪，幽寻值灵篇。\n轩窗散急雨，四座屯霏烟。\n向来玉京梦，了了堕目前。\n恍疑鸡犬资，今在第几天。\n平生修无怍，自视应得仙。\n孺子审可教，凡躯伫加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"梅执礼","text":"有令可干难闭户，无人堪访懒移舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访道者","author":"杜崟","text":"洞门深锁白云横，幡影坛高夕照明。\n落叶满阶人语寂，翩然野鹤啄棋枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题澹山岩","author":"李公彦","text":"地灵欲借一握天，神剜鬼划无留坚。\n欻然豃豁空而圆，阳乌飞景光自穿。\n古藤绕石翠欲牵，石果垂结纷如拳。\n中有岩宝吐细泉，六月客坐寒入肩。\n昔闻修蟒何蜿蜒，诛茅判木不敢前。\n谁令结此殊胜缘，化作宝坊可栖禅。\n我非贵客来尘軿，训狐挟狡声亦先。\n飞上岩前枯树颠，唤起山丁夜不眠。\n涪翁有笔大如椽，七字要与山俱传。\n续貂顾我不著便，千古一笑夔怜蚿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其一","author":"释守珣","text":"兜罗绵手指天地，绀目重瞳顾四维。\n七步周行浑属我，一生卖弄小孩儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二","author":"释守珣","text":"瞿罢身心如泥，女子肝肠似铁。\n文殊贪寻锅子，罔明由来著楔。\n历观大地众生，不解闭门作活。\n不动干戈建太平，雨过青山如黛泼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三","author":"释守珣","text":"涅槃一路同来往，寸步宁亏达本乡。\n鹙子黠儿轻借便，由如哑子吃生姜。\n月上女，太无良，不涂红粉自风光。\n金锁玄关留不住，百尺竿头信脚行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其四","author":"释守珣","text":"帝子游春不逐他，相邀诸姊入尸陀。\n死人堆里出身路，拨动烟尘见也么。\n灵利汉，不消多。\n回头踏著自家底，洞云深处旧烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其五","author":"释守珣","text":"百万人天普请看，头陀末上独开颜。\n堪笑衣穿瘦骨露，一肩授手搭金襕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其六","author":"释守珣","text":"难兄难弟问来端，百衲金襕递代传。\n弟应兄呼成底事，免认刹竿头指天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其七","author":"释守珣","text":"展阵开旗便要赢，谁知御驾不亲征。\n把定锵旗收阵脚，直向熊峰不出兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其八","author":"释守珣","text":"三拜勤劬雪到腰，觅心无处强相饶。\n神光冷地思量著，始觉春来雪自消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其九","author":"释守珣","text":"老大不堪用，约去了还来。\n伸脚缩脚里，贪程启快哉。\n有娘生面无爷姓，趁得昙华五叶开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十","author":"释守珣","text":"不是风兮不是幡，几人北斗面南看。\n祖师直下无窼臼，眼绽皮穿较不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十一","author":"释守珣","text":"倚灶为灵自不灵，灵踪断处一堆尘。\n野老不来敲祭鼓，打正因邪别是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十二","author":"释守珣","text":"坐禅成佛心中病，作镜磨砖眼里华。\n一掣牢关金锁断，等闲信步便归家。\n马驹子，实堪誇。\n自从胡乱后，著处是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十三","author":"释守珣","text":"庐陵米价若为酬，入市知行趣自由。\n借问年来何所直，大宋山河四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十四","author":"释守珣","text":"即心是佛一家风，马祖声传四海中。\n灵利衲僧才一顾，娘生赋性出天聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十五","author":"释守珣","text":"近日尊位复如何，日面月面哩来啰。\n自从舞得三台后，拍拍元来总是歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十六","author":"释守珣","text":"野鸭群飞势莫留，瞥然一过已高秋。\n和声搊著平生痛，短绠毋劳系鼻头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十八","author":"释守珣","text":"要得狸奴觌面酬，浑如钳口锁咽喉。\n一刀两段从公断，直得悲风动地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其十九","author":"释守珣","text":"犀牛扇子用多年，历掌清机授手传。\n头角不全收拾取，雨馀风月满长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十","author":"释守珣","text":"红轮决定沉西去，未委魂灵往那方。\n踏得故乡田地稳，本来面目露堂堂。\n人只在，不曾亡。\n率陀天上非人世，须知别有好商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十一","author":"释守珣","text":"贪观天上月，失却手中桡。\n石臼山下路，归计转迢遥。\n觌面光辉日，拍手笑吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十二","author":"释守珣","text":"老倒丹霞烧木佛，院主眉须刚突出。\n罪过从来作底当，谁道千虚不博实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十三","author":"释守珣","text":"三种佳名一个过，邀君把手上高坡。\n时人自没登山力，空负当年一曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十四","author":"释守珣","text":"连天野火了无涯，起处犹来辨作家。\n眼里瞳人双翳尽，面前遍界绝空华。\n道吾老，也堪誇。\n汲水僧归林下寺，待船人立渡头沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十五","author":"释守珣","text":"孰云天地与同根，事角争如理见亲。\n一槛庭花浑己物，满天风月与谁论。\n堪笑南泉老作，犹来因语识人。\n可怜陆亘大夫，对面埋没家珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十六","author":"释守珣","text":"青青庭柏指西来，赵老门风八字开。\n岁寒枝有深深意，谁把灵根著处栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十七","author":"释守珣","text":"张公末醉李公扶，从此嘉声满道途。\n却被金刚开口笑，谁能爱你护身符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十八","author":"释守珣","text":"见成公案便相当，秤则称兮斗则量。\n非较非年三十棒，至今平步也翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其二十九","author":"释守珣","text":"终日看天不举头，桃花烂熳始抬眸。\n饶君便有遮天网，到得牢关即便休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三十","author":"释守珣","text":"无寒暑处洞山语，多少禅人迷处所。\n寒时向火热乘凉，一生免得避寒暑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三十一","author":"释守珣","text":"捲则浑崙无缝，舒则八面生光。\n百千诸佛，同处一方。\n转机轮于掌握，奋大用于当场。\n非独三十年后，面前薝卜馨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三十二","author":"释守珣","text":"残羹馊饭，无处安著。\n换手搥胸，劈头盖却。\n两个无孔铁槌，一样无绳自缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三十三","author":"释守珣","text":"发足超方，地头亲到。\n遇著险峻道途，杀活杖子变豹。\n米仓大路平如砥，未免漆桶里著到。\n不搽红粉也风流，大抵还他肌骨好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古四十首 其三十四","author":"释守珣","text":"无孔笛子两头吹，韵出青霄彻九维。\n可怜一对冤家种，人人鼻孔大头垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":3856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]