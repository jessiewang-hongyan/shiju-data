[{"title":"纪愁","author":"俞桂","text":"可笑无诗纪四愁，强将欢伯解吾忧。\n夜长明月纱窗冷，分得寒蛩一半秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"习气","author":"俞桂","text":"习气于诗却未除，尽教人笑治生疏。\n功夫若到穷吟地，虽是居贫富不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过湖","author":"俞桂","text":"舟移别岸水纹开，日暖风香正落梅。\n山色濛濛横画轴，白鸥飞处带诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋","author":"俞桂","text":"火老金柔暑告残，乘凉正好望西山。\n秋声来处无寻觅，只作窗前竹叶间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"俞桂","text":"薄薄轻轻寒露雨，微微飒飒早秋风。\n小舟办了松江去，占取三高作钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"俞桂","text":"暑赫练襟汗欲流，倩谁唤得一天秋。\n无人共订吟边句，独有蝉声叫树头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"俞桂","text":"吹落杨花春事了，小池新绿雨添痕。\n育蚕时节寒犹在，村落人家半掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"俞桂","text":"阴云酿雨勒花迟，梅已飘残到杏枝。\n好是池塘清梦处，勾吟春草入新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吟诗","author":"俞桂","text":"渔溪僻好只吟诗，此意还须识者知。\n自古岛郊贫彻骨，诗逢穷处始为奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日","author":"俞桂","text":"今朝社日寒犹力，燕子还寻五柳家。\n宰肉不沾吾分薄，强斟聋酒度年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叶广文韵","author":"俞桂","text":"入得春来物物饶，翻思湖上短长桥。\n去年寒食闲游处，曾把扁舟系柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"居官","author":"俞桂","text":"幸喜居官事不多，庭空吏散雀堪罗。\n近来转觉诗朋少，谁肯高轩为我过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松江","author":"俞桂","text":"荷叶翻风暑气微，看山露冷湿征衣。\n垂虹夜静三高月，只照渔溪一舸归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松江","author":"俞桂","text":"香飘菡萏短篷中，水色山光一样同。\n行止又非人所料，今年两度上垂虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枫桥寺","author":"俞桂","text":"湖水相连月照天，雁声嘹呖搅人眠。\n昔年曾到枫桥宿，石岸傍边系小船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苔钱","author":"俞桂","text":"庭砌方圆出化钧，何须抵死论钱神。\n贫家阿堵新添富，买断西湖风月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘","author":"俞桂","text":"突兀浮图插翠微，吴王事迹总成非。\n寺僧未晚山门闭，不放闲云一片飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"述己","author":"俞桂","text":"落落功名鬓久斑，重游京国又何颜。\n早知寸禄荣家晚，悔不当初便入山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲 其二","author":"张至龙","text":"拗落圆房响钏金，背人细数子藏深。\n不嫌到手多尖刺，祇怕伤人有苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采莲曲","author":"俞桂","text":"画艇将归笑语频，鸳鸯对对起还沉。\n妾心先自怀郎苦，怕嚼莲心苦转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"俞桂","text":"不爱三公汉禄荣，一丝风月许多清。\n只将节义高千古，岂钓人间利共名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中遣愁","author":"俞桂","text":"花已开时人正愁，花簪头上使人羞。\n一春可厌无晴日，下却珠帘懒凭楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后","author":"俞桂","text":"雨后新晴日转西，桑间犹有拙鸠啼。\n十分愁意无人管，红蓼黄芦水满溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南跄跧上人之平江","author":"俞桂","text":"青浦相逢恰二年，今宵再会亦前缘。\n诗囊和月横挑去，稳泛枫桥夜半船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事","author":"俞桂","text":"羲驭舒徐日正迟，园林已觉杏花稀。\n半晴半雨春无准，燕怯轻寒不耐飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事 其一","author":"俞桂","text":"春入侯家春事深，日长庭院又沉沉。\n客中不耐如丝雨，搅起思家寸寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日即事 其二","author":"俞桂","text":"春光满目是吴头，水碧琉璃拍岸流。\n忆著去年桃叶渡，相思无限使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春归 其二","author":"俞桂","text":"晴天气淑浓如酒，引得狂蜂路亦迷。\n独立栏干凝望处，卖花人在画桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春归 其一","author":"俞桂","text":"青青结子在梅梢，方见春来夏已交。\n认得主人双燕子，香泥衔去理新巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春咏","author":"俞桂","text":"尽日看诗只掩扉，出门细雨怕沾衣。\n杏花已露胭脂色，燕子如何却未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鞦韆 其一","author":"张炜","text":"吾今两鬓已成丝，每每逢春独自悲。\n最恨鞦韆无力上，风流不比少年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日","author":"俞桂","text":"芙蓉未拆桂香浮，落日西风雁过楼。\n一雨空阶深夜滴，十分秋是十分愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"俞桂","text":"唤醒归舟是早秋，水光云影两悠悠。\n西风不管梧桐怨，一叶吹来一叶愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"俞桂","text":"月华如水净无尘，千里相思总一心。\n络纬篱边吟不彻，做成秋意十分深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人至松江","author":"俞桂","text":"西风萧瑟入船窗，送客离愁酒满缸。\n要记此时分袂处，暮烟细雨过松江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送春","author":"俞桂","text":"作恶情怀是别离，老夫懒作送春诗。\n东君归去无踪迹，试问垂杨便可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨 其一","author":"俞桂","text":"凤帏晓起鬓?松，枕肉初生酒晕红。\n一把柳丝挪在手，沉吟无语对春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闺怨 其二","author":"俞桂","text":"谁怜人去锁朱楼，终日凭栏只带愁。\n燕子也知人薄倖，飞来略不傍帘钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首夏","author":"俞桂","text":"槐幄阴阴蔽绿扉，池抽荷叶落蔷薇。\n梁间紫燕新雏弱，来傍檐前旋学飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中即事","author":"俞桂","text":"青青梅子已添肥，犊角新抽晚笋迟。\n茶罢日长消睡处，案头一卷乐天诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中即事","author":"俞桂","text":"重梅过了犹悭雨，幸有南薰在翠槐。\n燕子亦于贫者薄，今年全不见飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏昼","author":"俞桂","text":"轻摇羽扇著轻纱，闲汲清泉自煮茶。\n缘是夏来无甚雨，小池犹未有荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家园","author":"俞桂","text":"眺望西山在目中，更须宽展竹篱通。\n残梅尚守清廉节，不嫁东君昨夜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"俞桂","text":"海棠袅袅弄胭脂，雨入枝头睡正宜。\n最是高人有遗恨，杜陵因甚却无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"俞桂","text":"吹来一叶报秋知，玉露金风正及时。\n戴了凉巾披野服，桂花香里看唐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"俞桂","text":"短发萧萧满镜秋，家居但觉岁时流。\n两年不见西湖面，笑我寒盟是白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄书","author":"俞桂","text":"岁月逡巡笑故吾，人生南北隔江湖。\n楼头约取衡阳雁，寄得一行书信无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀","author":"俞桂","text":"一番旧事总成空，莫使相思梦里逢。\n惆怅阳台云共雨，阳台今隔几千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明","author":"俞桂","text":"朝来阁雨喜新晴，枝上绵蛮调好声。\n佳节莫将虚过了，人生赢得几清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓京二首 其二","author":"俞桂","text":"车马滔滔厌软红，湖边秋意属西风。\n木犀初放荷花老，买个船儿学钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓京二首 其一","author":"俞桂","text":"一官濩落笑如初，只合空山去读书。\n不稼不渔无活计，谩将名氏玷公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"提干渔溪","author":"俞桂","text":"不涉惊涛心自稳，柳阴阴处著孤舟。\n的知世路多机阱，一线閒名付直钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上闲步","author":"俞桂","text":"一番雨过一番春，芒竹闲行踏软尘。\n城里不知春色早，湖边杨柳已撩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊八前四日","author":"俞桂","text":"天气晴和又作阴，老来畏冷自难禁。\n馀霙待伴留痕在，殊动骚人访戴心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新竹","author":"俞桂","text":"傍墙穿过邻家竹，爱护新篁数十竿。\n剪伐莫令童仆辈，老夫日日要来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪流","author":"俞桂","text":"云脚才行又复开，一声隐隐只空雷。\n家僮忽报溪流涨，知是前村落雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠云间陆琴士","author":"俞桂","text":"地僻居闲绝可人，殷勤过我抱桐君。\n声中知有辽天鹤，弹散华亭一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨","author":"俞桂","text":"踰月留京国，春光总不知。\n可伤连夜雨，好似暮秋时。\n有客来无酒，逢人只说诗。\n官中闻闭籴，应是细民饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"俞桂","text":"僻性止耽书，村中谩寓居。\n心惟求事省，身合与名疏。\n木叶秋风起，蛩吟夜雨初。\n吾生今晚矣，不必问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书斋","author":"俞桂","text":"野草沿庭砌，清闲日掩扉。\n晚凉疏雨过，落叶觉蝉稀。\n天籁自鸣竹，砧声谁捣衣。\n僧寮不过此，何必扣玄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘露寺","author":"俞桂","text":"占断淮南势，西风入鬓毛。\n一江流不尽，多景最为高。\n斜日迷烟树，孤帆送客舠。\n兴怀人物少，今古等秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石笋峰","author":"俞桂","text":"异种休参玉版禅，崭然一角立层巅。\n远尖自抱云根壮，叠藓谁疑雨箨缠。\n梦里三生空过眼，胸中千亩漫流涎。\n此龙难入宁僧谱，出土摩霄是几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次下竺僧韵","author":"俞桂","text":"朝市软红尘，山林气味深。\n放怀随野鹤，过耳任春禽。\n石涧鸣泉玉，松钗坠日阴。\n隐居无个事，存养读书心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次坦庵兄韵","author":"俞桂","text":"便中蒙赐墨，得句胜如书。\n暂尔两年别，俄然春暮馀。\n梦驰情不间，心迩迹何疏。\n自省吾今老，湖山缚屋居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"俞桂","text":"步入侵云岭，亭高路恰平。\n池边幽树占，水底细沙明。\n无友诗难咏，逢僧话转清。\n此中真胜地，林寂鸟无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"俞桂","text":"欲访飞来景，湖头赁小船。\n白云侵岭下，翠树傍泉边。\n入寺人须到，深林影自圆。\n山居相去近，夜坐学参禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"垂虹","author":"俞桂","text":"松江一景是虹桥，欲约骚人钓巨鳌。\n吴越封疆知几梦，古今人物壮三高。\n雪天斫鲙莎烟冷，秋月渔歌剑气豪。\n收拾琉璃千万顷，尽为醽醁汲波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"性拙","author":"俞桂","text":"性拙难为巧，年来阴屡经。\n身闲诗谩赋，心静梦能灵。\n富贵如朝露，英雄几晓星。\n寻思世间事，日影过中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虎丘","author":"俞桂","text":"两寺今为一，因秦虎占丘。\n鹤飞王剑化，鸟宿古坟愁。\n石与泉流接，池通海水浮。\n十奇多胜槩，不及尽追游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚湖上","author":"俞桂","text":"花事已成休，都人懒出游。\n水添烟浪阔，山带夕阳愁。\n柳树鸣黄鸟，沙堤卧白鸥。\n不辞归路远，何必买扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春暮寄友人","author":"俞桂","text":"日煖梨花雪，风吹杨柳绵。\n春踰三月半，梦忆十年前。\n诗借莺声和，书无雁字传。\n东君还似旧，吾鬓叹皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"看先叔祖青松居士仓使诗","author":"俞桂","text":"儒冠每笑拙身谋，春日因何桂玉留。\n南浦未思芳草恨，西湖正为落梅愁。\n四灵去矣今如在，诸老萧然事已休。\n衣钵青松谁继续，家鸡还复可搜求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日即事","author":"俞桂","text":"宿有骚人兴，休教世俗知。\n郊墟聊晚眺，风月入秋宜。\n愁极惟凭酒，囊空却剩诗。\n更长人不睡，灯火可亲时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋咏","author":"俞桂","text":"吟轴捲还开，行歌兴尽回。\n买花浇换叶，开径扫苍苔。\n巾学凉纱样，衣从薄苧裁。\n潘郎羞鬓白，多是为秋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"俞桂","text":"秋夜多愁思，虚堂风露凉。\n观书灯可近，欲睡漏初长。\n蛩响频催织，萤飞烁有光。\n雨梢窗外过，散入稻花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日遣怀","author":"俞桂","text":"老大今无用，吟诗了白头。\n百年如电影，万事付沙鸥。\n性淡偏宜静，居贫动是愁。\n人情难似旧，门外水长流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏晨偶作","author":"俞桂","text":"蚕事行将了，农家刈麦初。\n雨悭林少笋，水涩港无鱼。\n因病尝惩酒，偷闲懒答书。\n今年身愈老，事事觉全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟霞石壁","author":"俞桂","text":"山深入翠微，寺僻掩幽扉。\n景别金仙地，人忘尘世机。\n石滋崖雨滴，龙出洞云飞。\n结屋同僧处，何须赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":36447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]