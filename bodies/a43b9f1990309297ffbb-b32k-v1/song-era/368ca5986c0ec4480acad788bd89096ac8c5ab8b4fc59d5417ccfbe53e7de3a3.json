[{"title":"感皇恩 其一","author":"程大昌","text":"七十在前头，难言未老。\n只是中间有些好。\n鬒云虽瘦，未有一根华皓。\n都缘心地静，无忧恼。\n此际生朝，梅花献笑。\n似向天边得新报。\n孙枝秀雅，已挂恩袍春草。\n定从欢喜处，添年考。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其二","author":"程大昌","text":"池馆足名花，四时蔫馥。\n就里梅春春到速。\n周遭松竹，任是雪霜长绿。\n总堪供寿乐，翻新曲。\n别向心田，有般奇木。\n依约灵椿共标目。\n八千换历，才当一番春复。\n莫辞春起处，醅浮玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感皇恩 其二 代妹答","author":"程大昌","text":"画舸白蘋洲，如归故里。\n老幼欢迎僮婢喜。\n较量心事，岁岁春风弧矢。\n今年称寿处，尤欢美。\n嫁得黔娄，苦耽书史。\n文字流传曾贵纸。\n便同黼黻，何似实头龟紫。\n天公闻此语，应怜许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韵令 硕人生日","author":"程大昌","text":"是男是女，都有官称。\n孙儿仕也登。\n时新衣著，不待经营。\n寒时火匮，春里花亭。\n星辰上履，我只唤卿卿。\n寿开八秩，两鬓全青。\n颜红步武轻。\n定知前面，大有年龄。\n芝兰玉树，更愿充庭。\n为询王母，桃颗几时赪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"程大昌","text":"著庭谨护箨龙儿，养就坚高抗雪姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"程大昌","text":"戏作风枝斜，垂恼玉堂宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"程大昌","text":"有底滑稽堪羡处，金莲烛里话穷酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梅山广文先生","author":"程中山","text":"谁谓梅山耄，胸中耿耿存。\n五言非小垒，一艺可专门。\n年老人皆敬，名高道自尊。\n群儿誇疾走，先长不堪论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梅山顾君际","author":"家性存","text":"门掩桑舆昼，炉寒郊岛灰。\n山荒无应下，梅瘦等春开。\n宇宙归诗眼，功名入酒杯。\n思君三日雨，有梦付潮来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹溪为旌城汪伯溱赋","author":"程介","text":"先生溪上种修竹，呼吸溪光餐竹绿。\n自应不同此君医，冰雪之胸元不俗。\n我欲相从竹溪中，已办青蓑黄篾篷。\n卧听肃肃摇清风，一洗满怀尘土空。\n祇愁一夕风雷起，变化飞龙葛陂水。\n凌云去去固无心，莫忘溪头舞烟雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登晒蓑台","author":"程以南","text":"晒蓑台子上，载酒共跻攀。\n竟日何妨醉，看云终是閒。\n千丝平岸柳，一发别州山。\n颇亦关乡念，春深未得閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见方虚谷后自述","author":"程以南","text":"清泠空想离骚国，至理难穷太极图。\n知有老人圮下履，恨无鸿宝枕中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"程以南","text":"欲居东西瀼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游涪溪 其一","author":"程以谦","text":"忆昔经行三十秋，重来创见古东楼。\n涪溪天造浑无恙，铁锁云横欲断流。\n两客后来谁更重，一樽今日意慵浮。\n怀人万古高山仰，剩喜夤缘得再游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游涪溪 其二","author":"程以谦","text":"重忆□都扰扰时，自怜解事作痴儿。\n风声鹤唳从渠骇，斗折蛇行笑我危。\n地险向来誇峻国，天诛□许恃滇池。\n毡裘未省相知否，更欲凭君一问之。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观黄山仙人药臼","author":"程元岳","text":"药臼空遗千载名，丹成人向九天行。\n我来欲觅刀圭剂，只听寒泉佩玉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和竹坞过曹柘岭","author":"程元岳","text":"浮邱千载尚相闻，解辔精蓝月未曛。\n一霎阴晴一霎雨，几重山水几重云。\n轻簧啭处闻求友，浓绿丛边对此君。\n更有山灵呈状巧，殢人花木亦欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游黄山次韵","author":"程元岳","text":"谩宿林间夜对床，钟鱼衍度几星霜。\n月高花影频开画，风动松声自鼓簧。\n人事悬知春日好，禅心不作少年狂。\n重来为称裴公约，万绿阴中醅酒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云岩","author":"程元岳","text":"直上云严绝顶峰，始知尘世有仙踪。\n悬崖藓润经年雨，满地花飘昨夜风。\n日月往来苍翠杪，烟霞舒卷画图中。\n琼台礼罢笙箫歇，万壑松声自羽宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入青城山门诗 其一","author":"程公许","text":"入山佳气异他山，翠逻周遭几复关。\n流水白云无尽藏，莫教容易到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又雨霁登楼","author":"程公许","text":"雨霁凭栏物色佳，鬅鬙叠嶂敛烟霾。\n羁愁要著谁陶写，且把昏眵为一揩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又省闱锁宿十月十三日夜月独酌 其一","author":"程公许","text":"霜月铺银滟瓦沟，忆曾尽醉作中秋。\n侵天围棘孤吟夜，且著红炉为暖愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又省闱锁宿十月十三日夜月独酌 其二","author":"程公许","text":"两月重来月又圆，寺钟惊梦五更残。\n此情谁遣啼鸦觉，飞过东墙代诉寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三湖","author":"程公许","text":"官柳三千詑蜀州，天涯流浪得重游。\n苦无东阁梅花句，小为西湖竹色留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三溪阴雨青山一峰穹秀可爱","author":"程公许","text":"山色溪流共蔚蓝，此中有句为谁参。\n老蛟喷雾舒还敛，依旧搀空碧玉簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元即事四首 其四","author":"程公许","text":"不用长檠换短檠，一窗图史任纵横。\n定知太乙青藜杖，合向书边分外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元即事四首 其三","author":"程公许","text":"懒慢无才可热官，良辰何以博亲欢。\n翻思田舍朋簪盍，浊酒青灯语夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元即事四首 其二","author":"程公许","text":"昭觉芙蕖万炬红，马蹄无处避香风。\n胜游似梦难重省，最忆琼酥点缀工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元即事四首 其一","author":"程公许","text":"放灯时节快晴天，红杏梢头璧月圆。\n物色似嫌人意懒，故撩吟思着风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小诗柬道传觅花栽","author":"程公许","text":"分我幽园花数栽，沧洲三径斸蒿莱。\n殷勤雨露亲培植，小待春风共一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其六","author":"程公许","text":"未能手剑血长鲸，只合瓜田老邵平。\n斗粟驱人成底事，漫将吟啸寄高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其七","author":"程公许","text":"凿池取月未伤廉，何必莲峰诧藕船。\n少待清渠通绿溜，醉歌绿幰鉴明蠲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其八","author":"程公许","text":"北风眯目涨烟尘，寒勒花容也自颦。\n袖手何能供草檄，等閒题遍锦江春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其二","author":"程公许","text":"一时花木斩新栽，露萼烟苞逐渐开。\n好事人人能爱惜，莫教容易拥蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其三","author":"程公许","text":"小筑分明是隐沦，何妨随分乐青春。\n诸君莫笑茅茨陋，野意萧疏更觉真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小圃茅亭初成即事十绝句 其四","author":"程公许","text":"诗情不惯吏尘嚣，心事偏耽野趣幽。\n纵使酒尊空北海，客来一笑也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192