[{"title":"题忠毅姚公庙 其三","author":"林宋伟","text":"岁岁蒸尝九月期，西风笳鼓万人悲。\n山边走马神旗闪，父老齐呼太尉来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题忠毅姚公庙 其四","author":"林宋伟","text":"两日经行旧战场，却来祠下谒堂堂。\n偷生诸将今何在，万古英灵独耿光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝农即事和厉寺正韵 其一","author":"林宋伟","text":"春将新绿满郊原，喜逐双旌晓出关。\n初度麦畦行诘曲，却穿竹径俯潺湲。\n阴阴霁色催归骑，猎猎溪风醒醉颜。\n父老欢呼随幼稚，隔途争看使车还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝农即事和厉寺正韵 其二","author":"林宋伟","text":"我不归耕却劝耕，下车且伴老农行。\n莱苗已过花才盛，桑叶方开葚早生。\n此去耕牛无暇日，新年啼鸟总欢声。\n定符贤守丰年愿，甘返田园老太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"林宋伟","text":"韩非老子俱同传，乞与时人子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"胡镗","text":"贫居三不往，薄宦两无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗意","author":"陈琰","text":"惨淡轻萦似画图，神游物外有还无。\n灞桥雪里清应苦，饭颗山头人亦癯。\n敏掣鲸鱼当碧幽，随象网索玄珠出。\n□尘解悟天机妙，一字何劳撚断须。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗思","author":"陈琰","text":"本与名言绝，乾坤钟气清。\n静中取拾得，閒里琢磨成。\n美刺明时化，幽微索至精。\n不曾亲悟入，似隔万重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栅口致喜亭咏怀 其一","author":"刘宗","text":"经年多病少逢迎，投老归来称野情。\n闭户且教防俗客，拥书终自笑浮生。\n怪人鸿雁呼群起，浴水鵁鶄傍母轻。\n几点疏萤独来往，鬓丝禅榻落花声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"栅口致喜亭咏怀 其二","author":"刘宗","text":"天末凉风吹白云，渐看长昼少炎氛。\n满庭慈竹秋阴合，夹岸枯荷夜雨闻。\n漂泊乡关新避寇，荒唐客梦旧从军。\n起来极目西山望，故里松楸怅夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白莲花","author":"高子凤","text":"地产枝莲异，莲宫自此兴。\n殊祥天不靳，奇艳雪堪陵。\n魄化疑吴女，碑传有蜀僧。\n何当寻胜概，吟断佛前灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松泽西亭 其一","author":"高子凤","text":"松泽亭前山色幽，洙泾渡口荻花秋。\n离钩三寸无人会，一棹东西独未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松泽西亭 其二","author":"高子凤","text":"野水閒云无定踪，一生空棹月明中。\n锦鳞才得翻船去，堪笑家风彻底穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":32999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松泽西亭 其三","author":"高子凤","text":"西亭无处认遗基，烟月空馀旧唱辞。\n欲问辞中端的意，渚花堤柳可能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松泽西亭 其四","author":"高子凤","text":"劈口两桡无剩法，点头三下不容声。\n谢师付授从今了，一段风流画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33001,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松泽西亭 其五","author":"高子凤","text":"隔水遥山数朵青，送人依旧泊閒亭。\n此舟未信无重过，门枕蘋汀夜不扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33002,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题杨补之墨梅卷","author":"高子凤","text":"篱根玉瘦两三枝，为绕吟香夜不归。\n安得密林千亩月，仰眠吹笛看花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33003,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽李仲通","author":"古田里人","text":"久矣厌尘世，逃名云水间。\n五湖正觅地，一曲歌沧浪。\n风雨晚来急，笠蓑时下忙。\n钓龙手中竹，分付与儿郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33004,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙脊滩","author":"沈安义","text":"龙脊滩头春已归，旧章重举到江湄。\n玉箫金缕民风乐，麦陇桑畴农事熙。\n犹记去年来把酒，又还今日再题诗。\n桃花三月归帆过，此地红涛渐渺瀰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33005,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"城山国清塘","author":"李丑父","text":"平田一水自萦回，喜见兹塘亦壮哉。\n夏潦久收犹浩渺，壶山近看更崔巍。\n刺船葑蓼中边去，唤月烟岚外面来。\n见说艾轩诗句好，不逢墨迹重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33006,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"李丑父","text":"诸生幸不笑韩愈，官长何因骂郑虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33007,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冲虚观","author":"彭耜","text":"天风吹衣霞飕飕，叱驭从南来罗浮。\n何谓玉笥捣药鸟，亦于石楼喧夜愁。\n仙翁定知野人到，道观聊为朝真留。\n一粒刀圭吾不与，大椿那有八千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33008,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"彭耜","text":"判事有花皆可录，谏书无草岂求名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33009,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"包真人","text":"待吾了却人间事，然后相从面紫罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33010,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉溪雪夜","author":"严粲","text":"雪霁天夜白，月上江空明。\n饮散客就船，万籁沈三更。\n谁家竹篱岸，摸索疏枝横。\n不著色与香，令我毛骨清。\n醉魂乘沆瀣，看舞婆罗城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33011,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"独往","author":"严粲","text":"一径历纡馀，独往未到处。\n岂曰岩泉幽，心閒即真趣。\n萧萧松有声，依依花自开。\n樵翁向我笑，问我何从来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33012,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭君怨","author":"严粲","text":"欲洗铅华净，那须画手工。\n玉颜翻自误，不似旧图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33013,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄炳","author":"严粲","text":"未尽连床话，匆匆又语离。\n襟期无限事，书寄若为辞。\n昔别已十载，重逢还几时。\n孤舟明夜月，何处照相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33014,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望彭蠡","author":"严粲","text":"万壑气交会，今知楚泽雄。\n水明才辨树，雾合忽迷空。\n远浦沈初月，孤舟乱去鸿。\n阑干已愁思，渔唱入蘋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33015,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚","author":"严粲","text":"向来得意在烟霞，失脚黄尘负岁华。\n过却海棠浑不省，梦中犹自咏梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33016,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋入","author":"严粲","text":"秋入蘋风白浪生，痴云未放楚天晴。\n青山湖水知何处，中有斜阳一段明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33017,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阳关图","author":"严粲","text":"人人肠断渭城歌，谁独持竿面碧波。\n可是无情如木石，祇应此地别离多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33018,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜与张辑论诗","author":"严粲","text":"凉露初长夜，纤云净尽时。\n几人还对月，与客共论诗。\n苦思常难稳，閒题或更奇。\n不应誇末俗，准拟古人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33019,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自乐平阅视渡舟取道太阳渡宿地藏院","author":"严粲","text":"康山问民涉，阳渡平地讼。\n朅来招提宿，疏峰结飞栋。\n研丹启囊书，点勘自成讽。\n佛香触深悟，僧茗来清供。\n阳颓岚气生，鸿没天宇空。\n向来山中乐，忽忽岂其梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33020,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘谷图","author":"严粲","text":"声利争驰毫末间，几人能得健时閒。\n不须展画相撩弄，昨夜秋风忆故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33021,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"见梅","author":"严粲","text":"绝怜生意上寒枝，几度巡檐错恨迟。\n数点疏花人未见，窗间早被月明知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33022,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春归","author":"严粲","text":"抵死连宵雨不休，今朝晴景莫登楼。\n杜鹃啼得春归了，风里杨花点点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33023,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荐福寺","author":"严粲","text":"石径秋痕苔藓深，谁将清气润脩林。\n戴公堤上古时月，几度凉宵照苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33024,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招提游 其一","author":"严粲","text":"幽寻惬所适，兰若白石静。\n天籁鸣松壑，古意满苔径。\n清泉醒客心，啼鸟唤僧定。\n留连不能去，玩月归路永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33025,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招提游 其二","author":"严粲","text":"烦抱忽如遗，僧境得清胜。\n花发岩洞幽，云生窗户冷。\n来骖树阴直，归棹川光暝。\n遗思山苍苍，半空闻夕磬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拾橡亭为黄炳赋","author":"严粲","text":"世上危机富贵身，由来著意鬼神嗔。\n到头钟鼎谁消得，正要山中拾橡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林和靖祠","author":"严粲","text":"白云人已矣，古屋自苍苔。\n林下误疑鹤，水边空见梅。\n市人携酒至，歌女棹船回。\n检点幽栖处，湖光似向来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元上人见访","author":"严粲","text":"昔子青青佩，重逢怪衲衣。\n樊笼留不住，云水静相依。\n习气馀诗句，枯禅堕佛机。\n东湖自尘外，还带夕阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆张辑","author":"严粲","text":"畏景如焚客路尘，寂寥山店独吟身。\n多情唯有别时月，低傍茅檐巧趁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿石潭寺寄黄炳","author":"严粲","text":"昨夜湖心共泊船，一天星露宿寒烟。\n朝来极目无洲渚，知采蘋花何处边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"画梅兰竹石","author":"严粲","text":"正忆吟窗占竹坡，风烟触眼奈愁何。\n梅兰只作从前瘦，石上苍苔别后多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春恨","author":"严粲","text":"马上东风吹酒醒，空将春恨到江亭。\n飞香寂寞无寻处，烟映晚山深浅青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庐陵黄炳筑亭所居侯山扁以赤松子自号赤松亭长之官鄂渚为赋诗","author":"严粲","text":"仙人遗世不曾愁，但欲相期汗漫游。\n亭长祇今閒未得，南楼孤啸望神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雾中早行","author":"严粲","text":"行人模糊画中影，高树夭矫空际云。\n楼台几处半隐见，三岛梦断犹纷纭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋思","author":"严粲","text":"风落叶间残点雨，月窥窗下不眠人。\n秋清一片无谁领，并作诗愁入鬓新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松雪","author":"严粲","text":"阴崖未知晴，松雪自在白。\n可恨晚风颠，飞寒乱苔石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宴坐画图","author":"严粲","text":"京尘倦来归，故山喜还璧。\n淡交松桂在，昔别猿鹤忆。\n晚知閒味深，甘为幽讨惑。\n尚念身在山，佳处恐未识。\n看山须全境，一览尽目力。\n伊谁有巨轴，亭亭挂空碧。\n吾闻古灵匠，能事略翰墨。\n盘礴溟涬初，太素含黼饰。\n妙手斡玄微，鍊此石五色。\n天机一呈露，真宰惜不得。\n写出万古愁，苍茫思何极。\n烟村带远市，云树出峭壁。\n有人閒倚栏，飞鸟亦自适。\n俗间重小景，局促无奇特。\n五日十日画，大类宋楮刻。\n谁会悠然心，醉来眠对客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酴醾","author":"严粲","text":"东风暖迸龙蛇起，丽日晴烘玉雪香。\n可惜开时春向晚，不教桃李见清芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客里","author":"严粲","text":"客里何知度岁华，春风香却一番花。\n山行转处闻鸡犬，杨柳阴阴卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纪梦","author":"严粲","text":"烟岛空濛一鹤飞，天风满袖自吟诗。\n觉来犹似非人世，花影栏干月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张辑游宣城","author":"严粲","text":"君抚渊明底样琴，肯于弦上要知音。\n相逢尘事不挂口，别去清愁总上心。\n听雨夜床孤旧约，看云秋壑想幽寻。\n他年跨鹤相过否，应笑浮名雪满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中见茶花","author":"严粲","text":"朝来露湿欲寒天，谁赏幽芳古道边。\n风味十分留贡焙，浮花正自不须妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"巧夕添丁","author":"严粲","text":"书来知有喜，客梦应维熊。\n久作庭闱别，遥知笑语同。\n充闾非我愿，钓濑是家风。\n莫学天孙巧，朱愚肖乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶洲","author":"严粲","text":"琵琶古怨犹凄清，何年一抹横烟汀。\n人言随波高下如浮萍，神鳌背负能亭亭。\n不知水仙宫殿碧皎洁，玉弦遥映云锦屏。\n胡沙万里音尘绝，独与鹦鹉愁青冥。\n天际归舟认髣髴，江头寒月伤伶仃。\n悄然夜久天籁起，往往恍惚游百灵。\n秋风袅袅兮水泠泠，俗耳筝笛兮谁能听。\n我眼如耳耳如鼻，妙处不言心独醒。\n钧天住奏三千龄，石钟水乐遗林坰，岂有宝器终飘零。\n一朝詄荡开天扃，帝命下取呵六丁。\n陶梭共起变化随雷霆，古馀山色空青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池阳道中","author":"严粲","text":"脱叶舞风过别岸，湿云含雨上晴天。\n脩途喜借晚凉得，幽鸟一声生翠烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽陈邵武","author":"严粲","text":"前辈闻如此，今人见未多。\n难将通介论，不在语言科。\n胄监开华近，樵川借抚摩。\n乡评最期望，一梦只南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜投荒店戏成","author":"严粲","text":"唤起吹松火，开门问带嗔。\n随行曾有米，同伴几何人。\n乱秆铺添荐，残篱拾作薪。\n夜寒难得酒，烦扣隔山邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"被檄乐平至鸣溪渡有山与南丰军山同名者予昔从岭庵谢先生梦得游先生于湖畏友也豪于诗悦军山之峭拔畅其吟怀自昭武徙家于市山筑室曰西窗以朝夕对焉尝命余记之余时从西窗樽酒论文为乐如是者十载今先生已矣感而赋诗","author":"严粲","text":"江西绝顶插晴空，此地山名偶自同。\n唤起西窗十年梦，一樽何处酹诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重到地藏院","author":"严粲","text":"泥泞行良苦，青山且眼前。\n题诗如昨日，倒指已三年。\n僧榻寒宵雨，渔村落照烟。\n薄游聊复尔，终拟老林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张辑","author":"严粲","text":"不见吾张辑，新诗何处吟。\n身留江介远，秋入夜凉深。\n灯影还家梦，蛩声倦客心。\n归来及嘉节，细把菊花斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"建德县梅山寺","author":"严粲","text":"公退逢长日，清游到宝坊。\n山围露天小，径绕引溪长。\n苔壁晴云湿，松轩暑月凉。\n钟声半归路，回首暮苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叨第后日者自谓奇中索诗","author":"严粲","text":"儿时意气谩骑鲸，几向栏干袖手凭。\n今日逢君成一笑，却惭窗下读书灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风雨宿湖心","author":"严粲","text":"渺渺平湖四接天，孤舟曾系夜来船。\n持鞭又逐风尘去，却忆秋篷听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴","author":"严粲","text":"滑路愁骑马，晴天好放船。\n水纹摇倒壁，花影弄澄川。\n梦寐驱驰在，光阴少壮迁。\n心期犹浩荡，搔首白鸥前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中夜雪","author":"严粲","text":"落帆侵夜色，客思正悽悽。\n风撼潇湘覆，云连宇宙低。\n洒篷吹乍急，攲枕听还迷。\n懒惰无清兴，谁人访剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"严粲","text":"纤巧逐时新，谁将大雅陈。\n天孙古机锦，笑杀世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送戴式之","author":"严粲","text":"自小寻诗出，江湖今白头。\n应嫌少陵读，不似子长游。\n风雨夜愁枕，莺花春醉楼。\n吟边消息好，怀古问沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茅舍","author":"严粲","text":"村居远城市，独木渡塘坳。\n迸笋补篱竹，落松添屋茅。\n童归携酒榼，客至得盐包。\n随分山中好，低檐燕有巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":33059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]