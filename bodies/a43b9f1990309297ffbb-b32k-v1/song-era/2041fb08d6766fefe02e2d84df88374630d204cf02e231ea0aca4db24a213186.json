[{"title":"颂古三十一首 其十六","author":"释梵琮","text":"闹里轻轻飏碌砖，衲僧鼻孔一时穿。\n掀天笑罢归来矣，打著南边动北边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十五","author":"释梵琮","text":"跃出南山鳖鼻蛇，引他闲汉竞随邪。\n万人丛里交肩过，唯是亲儿识得爷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十四","author":"释梵琮","text":"倾山红炉铁弹圆，轻轻拨著骨毛寒。\n红光直透青霄外，塞壑填沟无处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十三","author":"释梵琮","text":"草里伤人血溅流，等闲解著毒蛇头。\n炎炎恶风冲天上，赫日光中结蜃楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十二","author":"释梵琮","text":"撒出骊珠光烱烱，劈开美玉洞无痕。\n几回贱卖无人买，堪笑乞儿孤此恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十一","author":"释梵琮","text":"臭口才开露贼身，看看平地惹埃尘。\n傍观不解深藏舌，也作黏牙缀齿人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十","author":"释梵琮","text":"怪雨狂风势欲倾，阴垂六合见云腾。\n一条瀑布岩前落，界破青山千万层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其九","author":"释梵琮","text":"水牯牛儿也可誇，鼻绳拽断卧烟霞。\n蓦然痒处轻抓著，便向人前露尾巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其七","author":"释梵琮","text":"一回见面不相瞒，便把当台古镜看。\n暗里照君还照我，清光一片逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其六","author":"释梵琮","text":"临风索笑傲冰霜，吐露春光漏泄香。\n两岸断桥人不渡，一川疏影横斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其五","author":"释梵琮","text":"急水滩头把钓竿，洪波汹涌暮江寒。\n锦鳞也解随钩上，一吸沧溟彻底乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其四","author":"释梵琮","text":"淡红浓绿暗纷纷，是处人家开竹门。\n堪叹往来游玩者，不知身已过花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三","author":"释梵琮","text":"一日高名及第归，野花啼鸟尽迎随。\n娘生面目浑如旧，祇有青衫异昔时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二","author":"释梵琮","text":"旧鞋线断口头开，床下埋藏满面埃。\n信手拈来著得著，人前拖去又拖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其一","author":"释梵琮","text":"谩将淡墨画垂杨，袅袅腰枝百尺长。\n寄语行人不须看，一回看著断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其二","author":"释梵琮","text":"傍庵来往路相通，步步相随蹑去踪。\n山远年深人不到，一溪流水质长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其九十二","author":"释梵琮","text":"把定风光末上开，纷纷如雪点苍苔。\n清香飘处多真实，真实中藏调鼎才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十七","author":"释梵琮","text":"煨火芋头四五块，傍林茅屋两三间。\n道人若欲来相访，定是忙忙赶出山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十一","author":"释梵琮","text":"三十馀年住率庵，庵中无物可相参。\n有时南北东西去，白话闲嘈恣放憨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十七","author":"释梵琮","text":"正月已过二月来，百草头边次第开。\n昨夜东君行正令，无言桃李舞三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十一","author":"释梵琮","text":"千峰顶上披衣坐，百草头边是道场。\n喝散白云无一点，赤心片片报君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十五","author":"释梵琮","text":"云居九月半，月向掌中圆。\n觅之亡影象，用之亡正偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十二","author":"释梵琮","text":"新罗僧问答新罗，飞骑将军意气多。\n夺贼鎗来骑贼马，不劳馀刃罢干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其三十","author":"释梵琮","text":"上方一夜开香积，天晓堂中吃雪团。\n信手拈来当面掷，不知谁识为人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十九","author":"释梵琮","text":"袈裟拈得喜轻便，一片閒云拥半肩。\n莫怪逢人频抖擞，借婆裙子拜婆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十八","author":"释梵琮","text":"钟声披起郁多罗，信手拈来不在多。\n堪笑当年明上座，狼忙驰逐太奔波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其二十三","author":"释梵琮","text":"岁除无物可相延，四壁深围满屋烟。\n几度拨开还自问，柴头尽处是新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十九","author":"释梵琮","text":"强言一物扬家丑，引得傍观入座来。\n笑里和盘轻掇转，七峰岌嶪舞三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其十六","author":"释梵琮","text":"仙居多异草，圣地绝凡踪。\n秋风动鳞甲，生蛇化活龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其九","author":"释梵琮","text":"老观当场阐大机，逢人赤手为提持。\n若能直下知端的，佛海波澜无尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其五","author":"释梵琮","text":"湖上一片云，明月为知己。\n却被清风吹，吹入深山里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常禅师荷衣沼","author":"释梵琮","text":"遇物合人仰祖风，弊衣遗在一池中。\n秋风吹破春风补，不犯清波一线功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庵中夏","author":"释梵琮","text":"草中得路便藏身，不入他家水牯群。\n弹指一声为号令，低头问讯当慇勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩赞","author":"释梵琮","text":"手提拂子坐胡床，眼似流星鬓似霜。\n开不二门长示疾，却将好肉剜成疮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒山拾得赞","author":"释梵琮","text":"寒拾相逢便拍肩，双收双放笑掀天。\n古今一片闲田地，露出寻常茗帚边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢无用和尚惠鞋","author":"释梵琮","text":"信手裁成任短长，密通一线透中央。\n看来只是旧时底，著了何妨到处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三教图赞","author":"释梵琮","text":"六耳不同谋，相看已漏泄。\n都来只三人，證龟却成鳖。\n者也之乎，无为寂灭。\n养家一般，道路各别。\n别不别，掉棒打落天边月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月了残经","author":"释梵琮","text":"待月了残经，文义何曾有。\n分付与痴儿，黄叶卷在手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因学者问生死到来如何抵当答以四偈 其四","author":"释梵琮","text":"生死到来何抵当，月明静夜共商量。\n荷华荷叶通消息，一阵风来一阵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释梵琮","text":"因贩私盐，无端过界。\n撞著梁王，不勘自败。\n狼藉官场，遭人笑怪。\n匾檐脱却两头，至今全无买卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拄杖歌","author":"释梵琮","text":"拄杖子，最超绝。\n到头到尾黑鳞皴，凛凛风生坚似铁。\n同我行，共我歇。\n恣纵横，任拖拽。\n搅动碧潭龙，打落天边月。\n有时拄到千峰顶，千峰万峰俱迸裂。\n有时撺入荒草中，潜藏影迹难分别。\n芭蕉有屈无人雪，大随提起重漏泄。\n而今老大懒扶持，信手拗来成两橛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草鞋歌","author":"释梵琮","text":"村里人，有意知，就手织成最容易。\n长短大小在目前，密用工夫多快利。\n草窠里面跳出来，结却绳头有巴鼻。\n牢束跟，紧在耳。\n掷地作金声，举步离泥水。\n著入千山与万山，把定脚头并脚尾。\n赵州尽力戴不起，玄沙吃绊趯著指。\n拖来拖去底头穿，轻轻飏在粪里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送浙翁禅师住径山","author":"释梵琮","text":"古路滑如苔，衲僧忘故步。\n人从天台来，却住径山去。\n家丑向外扬，生铁被虫蠹。\n一陈落华风，吹作送行句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十八","author":"释梵琮","text":"桃花开了杏花开，陈陈香风扑鼻来。\n零落尽随流水去，更无一片点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十六","author":"释梵琮","text":"髑髅遍野难遮掩，碍寒行人转见垂。\n从此一面看验后，也须拙地为深埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十三","author":"释梵琮","text":"柳色重重翠作堆，豁开三径不纡回。\n门前祇是旧时底，付与渊明归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十二","author":"释梵琮","text":"逆水张帆过海门，漫天烟雾暗昏昏。\n举头便见扶桑国，休把南针定晓分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十","author":"释梵琮","text":"拿得大家些子本，门前铺席恣开张。\n到头滞货同行市，价数高低两不争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其八","author":"释梵琮","text":"乞儿无缕又无褴，馊饭残羹勿处檐。\n拈起多年破席袋，人前更不惧羞惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其三","author":"释梵琮","text":"东山水上行，乾元利贞亨。\n譊讹一个字，才子竞头争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四首 其一","author":"释梵琮","text":"德山托钵话，低头得人怕。\n三家村里人，醉后胡厮骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十九","author":"释梵琮","text":"也大奇，也大奇，住个庵儿最好嬉。\n两个儿童忽相打，中间一攧少人知。\n却愁骑马滑，故作泛舟归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十八","author":"释梵琮","text":"今朝十月半，批判旧公案。\n达磨不会单传，夫子不会一贯。\n老聃不会无为，洞宾不会煅炼。\n长老不会说禅，衲僧不会穿线。\n万象光中容易度，一毫头上最难逢。\n半夜玉兔怀胎，天明金鸡生卵。\n养得凤凰儿，百鸟不敢看。\n踏折梧桐枝，飞去天崖畔。\n招手唤归来，云中得相伴。\n饮啄皆自然，一切总成见。\n凤凰儿，凤凰儿，被阎老子索饭钱。\n如何支遣，但对他点头三下，依实供款。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其九十一","author":"释梵琮","text":"衲僧家，达己灵。\n有通变，解逢迎。\n世人既已浊，不可自言清。\n世人既已醉，不可自言醒。\n和光同尘去，头头总见成。\n岂不见昔年党太尉，无分无晓最分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其九十","author":"释梵琮","text":"今朝正月半，万物尽更新。\n衲僧无一物，何物当慇勤。\n银烛高煇天上月，灯花开遍洞中春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十九","author":"释梵琮","text":"今朝正月一，万事从头吉。\n和气暖如春，世味甜如蜜。\n日月往复来，光阴不相失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十八","author":"释梵琮","text":"除夜无可分岁，炉中烧些木榾。\n臭烟冲著鼻孔，面热忽然喷嚏。\n残年钝闷，到此消除。\n新岁佛法，从此吉利。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十六","author":"释梵琮","text":"屋角岩花烂熳，林间春色温和。\n处处儿童采蕨，纷纷幽鸟营窠。\n祖意西来没消息，树头百舌语犹多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十五","author":"释梵琮","text":"蹉女自惭多丑拙，看头上雪成堆。\n春来思得一回嫁，却请东君为作媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十四","author":"释梵琮","text":"我有个火头，作事多伶俐。\n饱饭携锄头，庵前去锄地。\n寸草不留踪，善恶无忌讳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十三","author":"释梵琮","text":"入山住庵时，全身在荒草。\n狐狸交尾巴，屋头逐魂叫。\n闻者皆寒心，见者生烦恼。\n我有安心方，韩信放铁鹞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十二","author":"释梵琮","text":"住个庵儿最孤绝，炉中火种浑如灭。\n谩遣儿童采燥柴，信手拈来得一橛。\n打一吹，光皎洁。\n通身暖，满屋热，炎炎奔驰无门歇。\n夜深狼藉烧人衣，等闲拈出安火诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其八十","author":"释梵琮","text":"因参佛照师，问我本来面。\n日日要下语，夜夜思量遍。\n伎俩做得尽，恰好一年半。\n至今三十年，又何曾梦见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十八","author":"释梵琮","text":"诗中有禅，东湖湖上浪滔天，一叶扁舟破晓烟。\n禅中有诗，手把乌藤出门去，落花流水不相知。\n禅与诗何所为断，送二翁出门去，得闲唱个哩啰囄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十五","author":"释梵琮","text":"即心即佛，狗咬枯骨。\n非心非佛，牛溲马浡。\n不是心，不是佛，不是物，伏惟万福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十四","author":"释梵琮","text":"尘起一毫，沤生全潮。\n如海之深，似天之高。\n明明了了，历历昭昭。\n风飒飒，雨萧萧。\n光路宕，赤条条。\n无生国，路不遥。\n豁开功德藏，提起般若刀。\n百宝光中垂雨露，五须弥顶溪波涛。\n还源无别旨，今日与明朝。\n云间孙子开炉熬，林下一声婆饼焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十三","author":"释梵琮","text":"山中上元节，天上野云收。\n豁开广寒殿，清光射斗牛。\n姮娥与灯正，耿耿相应酬。\n一点难瞒处，灯毬挂树头。\n笼中看走马，林下恣闲游。\n吹灭旧纸撚，泼翻投子油。\n暗中有路明如日，露柱相逢笑不休。\n既能明似镜，何用曲如钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十二","author":"释梵琮","text":"新年已十日，十日在家乡。\n到家一句子，哑子吃生姜。\n眉毛上?跳，鼻孔里论量。\n针小眼大，尺短寸长。\n云霞飞片片，流水自茫茫。\n剪断五色线，补作春衣裳。\n知有者全身披搭，不知有者且莫轻狂。\n莫莫莫莫，老僧与汝安心方。\n雪消春自至，事过心清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其七十","author":"释梵琮","text":"合眼是旧岁，开眼是新年。\n新旧交参处，分明在目前。\n梅花香喷雪，杨柳冷含烟。\n年头佛法无多子，一句单提妙不传。\n红日照开银世界，春风织出锦山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十九","author":"释梵琮","text":"君子道长，出生万象。\n小人道消，近火先焦。\n晷运推移，漏泄天机。\n日南长至，吉无不利。\n添一线长，别有商量。\n但见皇风成一片，不知何处有封疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九十三首 其六十七","author":"释梵琮","text":"开炉无可做，大家团团坐。\n坐久却成劳，拨动炉中火。\n火星忽迸散，内外俱照破。\n一声寒雁叫长空，云中道人正高卧。\n蓦忽翻身吐气来，且吃胡饼十数个。\n食饱多伤心，切忌向净地上屙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]