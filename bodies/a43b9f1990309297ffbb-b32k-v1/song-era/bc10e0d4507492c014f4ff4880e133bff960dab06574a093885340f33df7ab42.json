[{"title":"冬夜李仲玉寓所","author":"张埴","text":"门关晡半掩，鸟雀远相呼。\n星宿生圭窦，春风在石炉。\n不胜亲友念，有恨岁年徂。\n坐久四邻静，寒灯势颇孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合江亭","author":"张埴","text":"踏到城隅路尽头，烝湘两水忽交流。\n炉薰不断征蛮祀，碣墨空遗责楚羞。\n石鼓无声山落木，朱陵未觉月生洲。\n冷吟绿净不得句，手搅天风更上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此心过酬韵","author":"张埴","text":"雨馀玉带已浮杯，未办庞眉一笑陪。\n春向五更抛我去，君从何处看花来。\n商丘大夏三十魄，白水青松大小回。\n此去政须笼短帽，瑶阶领鹤恣徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江涨和韵","author":"张埴","text":"浦溆蛟龙穴，波澜风雨声。\n天如粘梦泽，江似覆湓城。\n此地居三孝，何人汩五行。\n囊中无白璧，不得用吾情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟寄雪平诸兄弟及叔侄辈 其二","author":"张埴","text":"桑田成海海成田，迂阔重来每自怜。\n北道主人今似月，西江回首远如天。\n青山千里复千里，白发一年多一年。\n渺渺西风吹薄袂，能于骨肉不凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟寄雪平诸兄弟及叔侄辈 其一","author":"张埴","text":"八字山前一幅巾，可堪垂白向漂沦。\n平生梦寐在诸老，近者传闻失某人。\n社日鸡豚新雨泪，秋风鸿雁旧天伦。\n所期林下无穷意，护竹培花陆续春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杜园九日红梅主人以为瑞彭潜心索赋","author":"张埴","text":"鞠后西风醉饮醇，酝香酿影夺初春。\n几年江县依缘旧，一笑孙枝造化新。\n钿翠半偏如意误，钥鱼晓放守宫人。\n是谁不识花为瑞，分寸跻攀及太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛未寇莱公祠","author":"张埴","text":"脱去朝衣出禁天，武陵山色识瓢仙。\n匆匆岁月十数字，黯黯风烟二百年。\n自古难全唯晚节，至今犹洌是寒泉。\n几人拭目宣公笔，惆怅春秋法凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和彭秋宇四月所唐律","author":"张埴","text":"冁声铁聚杯湖上，霍地金舂镜石前。\n凤至祗知成二老，龙眠不作可千年。\n南楼暂阻诗同赋，东郭还存履未穿。\n一段江湖真活计，阿戎肯教第三联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜枕","author":"张埴","text":"春风陈榻下，夜月庾楼前。\n叠叠鸣檛落，翻翻警枕眠。\n祗能攲待旦，何有梦飞天。\n此意谁能解，如流二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉韵酬谢","author":"张埴","text":"得失无常所未论，相辉辈行几人存。\n小山政自惭为弟，老瓦何期饮到孙。\n橘盎且还诸老乐，梅花尤是丈人尊。\n向谁谓我翻公案，持向风流觅一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"果泉来馆中","author":"张埴","text":"渤海刀将卖，延陵剑又来。\n未莎霜后鞠，已蘤腊前梅。\n有客吟今雨，何人爱古罍。\n长裾青剡剡，不但旅颜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨过玄妙池观莲","author":"张埴","text":"门外似攻蠹，几间如绝机。\n飙车何处去，汗马是谁归。\n此日炎炎极，吾身往往非。\n有时同白羽，无语立红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康","author":"张埴","text":"彭泽鳞鳞水，匡庐漠漠烟。\n朝昏鱼作市，伏腊蚌为田。\n不共刘伶酒，惟同范蠡船。\n膊山千八百，恨未脱珉镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日武昌南楼","author":"张埴","text":"客上高楼春已非，山花无语野禽啼。\n未论老子从前事，且看涪翁以后题。\n汴水悠悠云尽处，襄州漠漠月明西。\n登临岂是为行乐，试倚长风听鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭登陆池楼","author":"张埴","text":"成陆成池嘘吸间，是谁梦里得其端。\n茫乎世界虚空立，到此人生束缚宽。\n潮色龙边涂月湿，卿心雁外抱云寒。\n明朝又踏桃源去，所可忧兮行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周叔恭远游","author":"张埴","text":"过眼不知骑马几，低头何啻问鸡三。\n旧游巷陌春风扫，新插田畴夏雨甘。\n白首学从无季子，青山招隐有淮南。\n人生共落三千界，未去嗔痴且去贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读陈公孟等伏阙书","author":"张埴","text":"世故相驱入市蓝，无情公用亦难堪。\n温乎此岂神人肯，群也其如祖父惭。\n午夜天狐摇北斗，东风雨射满江南。\n青山白叠仙吟处，岂不酣酣战阿三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄贤斋","author":"张埴","text":"自从一掺去三千，尺宅抛来喜中年。\n每叹圣贤风泯矣，可怜母子日萧然。\n悠悠兰老离骚国，渺渺花开阳艳川。\n九月不能应十月，挂书一束放翁船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅溪徙居吾乡北山下 其二","author":"张埴","text":"故人为籴罢，薄日杖藜明。\n天外飞鸿影，山中落木声。\n一枝栖月静，万事付云轻。\n只指梅花畔，留桥略彴行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅溪徙居吾乡北山下 其三","author":"张埴","text":"午夜贪泥饮，深村认路归。\n千岐纷莫辨，一隙炯相辉。\n秋日无莼美，春风有蕨薇。\n人生皆寓尔，惟勿此心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊后","author":"张埴","text":"重来风已落，寒叶集荒阶。\n竖子欺人老，先生笑道乖。\n便寻梅寄陇，无救橘逾淮。\n明日过法去，窊尊倒入怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠白团扇","author":"张埴","text":"藤经剡雪通姿晢，筠度湘秋刮骨清。\n两洁不容尘有污，一圆还与世无争。\n生来肖貌难为遁，老去挥毫岂足名。\n林下好风差自快，忍歌桃叶若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝阳前对红蓼","author":"张埴","text":"不更江上伴渔翁，独特移根一亩宫。\n人见空空当北面，谁知节节受西风。\n云衣不使通身绿，露惨能令满意红。\n却笑曾看齐物论，夜来灯火事匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洪山馆","author":"张埴","text":"山行成兴尽，泥饮得情亲。\n五月瓜盘美，殊乡雨话真。\n青云生此屋，白发长吾人。\n阑外浮图立，堂堂似上宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游桃川宫","author":"张埴","text":"瞿老亭存树插天，靖风扶醉坐云颠。\n黔中历历何千状，晋后纷纷又几年。\n扣木不知渠是圣，入桃亦认我为仙。\n山林摇落秋声起，两袂清寒一冁然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登白帝城楼","author":"张埴","text":"春取花归去，纷纷擘柳绵。\n千年汉城郭，万里禹山川。\n西雨生新浸，东晖隔薄烟。\n客愁如峡草，生下楚台前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答吴子登","author":"张埴","text":"闲随川上弄晴漪，归饮无何政谓宜。\n云去但惊山朵朵，月明空想佩离离。\n高楼长笛无人听，一日三秋有我诗。\n此意悠悠浮剑外，绿阴深处祇莺知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答彭秉山","author":"张埴","text":"万里夷夏范我驱，如鸱百发一无虚。\n却呼赤手烹双鲤，便计长竿上六鱼。\n此去重看黄鹤赋，所惭未识古蒙书。\n吟身只倚春风健，道不能颇盍不蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答曾清甫 其二","author":"张埴","text":"曲不闻中散，枰犹对弈愁。\n相忘君象小，忍记妇眉愁。\n周版新编齿，秦箕旧会头。\n白云知识远，跨海结成楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答曾清甫 其一","author":"张埴","text":"看花都是梦，听雨甚于秋。\n白石年年烂，黄金日日愁。\n有馀刍一束，不足橘千头。\n我醉如眠尔，何须百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解舟下石匮","author":"张埴","text":"枫兰行楚水，标柱压蛮烟。\n香火崇双庙，茅茨入半川。\n故人及涯返，去路与天连。\n鹿鹿皆前分，悠悠又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"解苍然亭","author":"张埴","text":"苍然亭下棹歌声，十里重湖第一程。\n岂要老来游汗漫，试扶孙去看升平。\n晴空云退青山朗，晚渚风生白鸟轻。\n历□旧游班目睫，日呼颖辈识经行。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬长沙邓寿甫","author":"张埴","text":"泉翁上下数千年，精力平生涑水然。\n白发满头犹未了，青灯与影每相怜。\n书成不与无金谷，宝秘惟知有木天。\n两夜秋窗风雨暗，老人也有可炊烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬刘和叔","author":"张埴","text":"儿时说伯亦吾羞，章甫何知不世谋。\n延伫群龙开日月，可堪两鸟聒春秋。\n十年谩说江湖尔，末路唯求饱暖休。\n心事黄花同□皦，何当篱下话从头。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬黄帝锡见和","author":"张埴","text":"龙髯初一振，人尽息其机。\n池静朱华出，山凉白鸟归。\n酒能无已已，诗岂去非非。\n仰面楚天远，浮云似白衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬谢谦山所寄","author":"张埴","text":"老逐群儿去聚沙，不知桃子结西华。\n归来乡井半鬼录，依旧湖山一会家。\n白盖年深蜗浼浼，绿阴人静鹊槎槎。\n江流依旧皆明德，解见南涯媒北涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠神目刘正卿","author":"张埴","text":"手撚花须送去春，绿阴溪曲喜逢君。\n相看时日愁千种，试说今年老几分。\n马喙信于人罕见，豺声顾不世多闻。\n长吟莫谢寥寥意，飞过南山自看云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"歜节南司洲驿","author":"张埴","text":"年年漂泊得康强，美景良辰每不忘。\n千丈木兰从梦见，一瓢菖歜在淮香。\n人生慷慨黄金短，天下升平白发长。\n回首石桥正惆怅，小儿满口日凉凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄樊口郑石谷","author":"张埴","text":"春日曾交问，炎天不欲书。\n亦惭吾事谬，岂愿后人疏。\n古有嗤章甫，今无购子虚。\n极思樊口酒，共煮井头鱼。\n露白蒹葭冷，江清潦水除。\n年华已如此，又可膏吾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月初四夜池上","author":"张埴","text":"池南夜观天，斗柄长离离。\n其间第四星，此点光犹痴。\n流空万萤火，照我双鬓丝。\n相待沧海月，坐到三更时。\n须臾众色尽，造化一事奇。\n手中公瑾扇，皎然相发挥。\n风翻头上巾，舞过池影西。\n惟有鸡冠两树花，一笑如受缠头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下青峰","author":"张埴","text":"仆仆淮头路，一年西复东。\n春风前赤壁，冬日下青峰。\n括揭叫天曙，蒹葭行梦中。\n君无矜矍铄，我政愧龙钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园桃熟","author":"张埴","text":"老子庐东信手栽，今经乱后实累累。\n天风暗拽云裳褪，晓日浓潮酒脸回。\n向上可怜无佞处，从旁只恐有偷来。\n清晨笑摘枝头熟，且献千年王母杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小绝句 其二","author":"张埴","text":"人言头上白，皆自愁中得。\n拍手笑沙鸥，满身都是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小斋睡起","author":"张埴","text":"受用本分内，三间老茅斋。\n岂无日如火，但有书能埋。\n开门乌桕影，盎水泼入怀。\n所期健拄杖，而相软麻鞋。\n旧雨来人处，青苔生土阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书后村诗卷","author":"张埴","text":"我看后村诗，未许后生到。\n油然真意兴，流出好怀抱。\n蜂蝶林中花，牛羊原上草。\n孤村来午馌，小涧生新潦。\n扶孙行更健，阻雨归不早。\n买鱼船迸滩，畏虎樵争道。\n客多待荷花，田少种粳稻。\n木龙有造化，野鹤无烦恼。\n中秋月到笛，九日鞠上帽。\n东舍帘酥胸，西邻绩鬼貌。\n剖开床头瓮，浇沃腹中稿。\n对灯舞僛僛，抚几歌浩浩。\n明朝复何事，随意足幽讨。\n墙下负暄宜，腊前得白好。\n金穰心愿遂，木刻足迹扫。\n此乐政无价，吾诗尤是宝。\n清风百世下，持以见郊岛。\n持以见郊岛，岂不一绝倒。\n岂不一绝倒，来迎玉山老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对木犀","author":"张埴","text":"楚山秋色半凄凉，谁与炊成万粟黄。\n明月尚在天上本，西风未了世间香。\n猝然甚有惭羊脾，老矣何曾识蟹肠。\n若得一株红照几，白头今夕醉柴桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"由新田归故家","author":"张埴","text":"七月景炎炎，金神令初驰。\n辰哨掩村墟，挈家向山薇。\n左手掖慈母，右手招妻儿。\n小人俱世役，谁能抱朝饥。\n举头赤日高，茧足荒山垂。\n慰老忽喘息，抚婴母啼悲。\n吞声各偷生，莫问厉阶谁。\n纷纷事轻逞，枭獍忍若为。\n性命不直土，杀戮以当戏。\n鬼妾充所欢，皇颜色戚怡。\n恢恢不罩渠，何辜及林池。\n今经用戏地，满目腥风吹。\n少陵归草堂，曾叱群小非。\n嗟哉夫何言，收拾聊此归。\n此归实天幸，团栾如去时。\n墙西老桂色，屋南佳鞠姿。\n一笑浑未忘，主人旧须眉。\n东巷去问安，茗椀重酒卮。\n北邻了残穫，戒妇中宵炊。\n穹昊由此正，礼乐傥可期。\n悠悠风尘中，宁不剩四支。\n未识衣裳化，何年及茅茨。\n昕昏有为命，啜水当如饴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用还答得淳","author":"张埴","text":"白头复何事，又是岁寒来。\n方为狙谋芧，俄欣雀应梅。\n晨光搽户牖，春意酿盆罍。\n次第湖山境，烟云大划开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘元翁索赋雩都孙氏梅轩","author":"张埴","text":"冰天叫镝交西湖，断桥鹤去迷烟芜。\n清时水月日入弄，欷歔三十馀年无。\n秋声一夜生寥廓，晨门喜堕云中啄。\n江南所少非秀才，谁信泰山今不索。\n庭前皴树占百弓，相与岁寒为春风。\n嚼烂楚人二十五，对花一笑千愁空。\n世间佳境本有数，更有玉堂在何处。\n大庾曾长老瞒欺，旁皇不敢窥门户。\n主人轩上即送申，飞香射影到幅巾。\n雪龙背上暗摸索，何如满身也带梨花树下云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚樊口解舟","author":"张埴","text":"武昌夏口之山川，天寒不见吹箫船。\n短篷推枕酒半醒，斑斑雨里茸茸烟。\n沙头白鸟闭目立，上下掠火交乌鸢。\n修蛇赴壑了弗顾，苟且一白春风前。\n我亦长吟上汉水，夜来参到梅花禅。\n一枝似铁忍寒冷，一枝如玉生温妍。\n老人无以饯岁事，只掉此舌为辰筵。\n江湖落魄又五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有遗搔痒之具曰不求人又曰婆指甲约相赋","author":"张埴","text":"阿婆此指甲，昆吾国生长。\n当年三五时，搯花记月上。\n纤纤成老大，却作爬沙状。\n故人远持赠，慈意有著放。\n想翁乍得之，未悟为何贶。\n把玩至一再，丑妇能俱丧。\n信手弹三声，铮然送妍响。\n卯醺未全快，午偃到半饷。\n溽绉垢能寸，美曝背如盎。\n是时可柄用，于人无俯仰。\n名之必可言，翁亦费亭当。\n长吟出肺肝，闻者重惆怅。\n人生七尺外，凡物皆是长。\n维此金石交，百年相倚仗。\n痴儿麻姑爪，忍痛不忍痒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江汉","author":"张埴","text":"桃花门外三月头，有美人兮眇中洲。\n泛呼木兰寂无语，举手相招老白鸥。\n白鸥见人头上笠，洒洒西江雨痕湿。\n足知心事两相忘，翻然飞出青蘋立。\n日斜何许一笛愁，西州回首望东州。\n春风吹水柳花落，不见鹤归江上楼。\n楼前青青草尺许，中有能言两鹦鹉。\n声声浑不说他人，祗谓祢衡骂黄祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西州访旧诸公皆沿檄去偕江一父过郎官湖赋此","author":"张埴","text":"一池汉水秀可餐，十年借我江南看。\n阴山夜半黑风起，此水与我心都寒。\n可惜野狐不革面，当来栖凤俱生翰。\n湖亭谢荷著句稳，霜月记忆浮杯宽。\n端期岁晚同不朽，报答地主老郎官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山庄居","author":"张埴","text":"樵路交行石，人家半住云。\n向来披野服，曾到醉山樽。\n虎迹沿坡见，鸡啼隔树闻。\n白头离乱日，只认是桃源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤壁矶","author":"张埴","text":"秋清亦足发，弄水俯晴川。\n顾影非坡月，昂首是梵天。\n人才三国后，边信十年前。\n吹笛归樊口，芦花落满船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡冠花 其二","author":"张埴","text":"众卉在篱下，惆怅秋光同。\n老农面寸垢，满口封培功。\n吾亦事吾事，买菊浇寒筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡冠花 其一","author":"张埴","text":"墙东鸡冠树，倾艳为高红。\n旁出数十枝，犹欲助其雄。\n赪容夺朝日，桀气矜晚风。\n俨如斗胜归，欢昂出筠笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汉东先生韵六首 其六","author":"张埴","text":"举矢欲向天狼时，草木零落美人迟。\n中年新知旧别意，悲乐相忘荃独宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汉东先生韵六首 其五","author":"张埴","text":"一枰胜负何有心，往往局外多堪吟。\n今人未晤烂柯意，祗道岁月青山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汉东先生韵六首 其四","author":"张埴","text":"凌明放龙去饮泉，何事此牧不在天。\n山中锄芝亦不恶，未入一班输群仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汉东先生韵六首 其三","author":"张埴","text":"?来黄鹤问故里，养得白鸦在玄田。\n人生擘划千古岁，碧桃开向母楼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]