[{"title":"建溪桃花","author":"蔡襄","text":"何物山桃不自羞，欲乘风力占溪流。\n仙源明有重来路，莫下横波碍客舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杭州过璘上人花圃","author":"蔡襄","text":"封培剪剥夺天工，栏下长年见万红。\n投老暗知心力少，自开还落信春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画生李维写予像今已十年对鉴观之因题其侧","author":"蔡襄","text":"清眸绿发十年前，朴野风神不易传。\n今日青铜莫相照，白髭垂颔面双颧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经林逋旧居二首 其二","author":"蔡襄","text":"山色凝岚水色清，山云长与水云平。\n先生来举持竿手，钓得人间亢俗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经林逋旧居二首 其一","author":"蔡襄","text":"修竹无多宅一区，先生曾此隐西湖。\n诗言不喜书封禅，亦有馀书补世无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南剑州芋阳铺见腊月桃花","author":"蔡襄","text":"可笑夭桃耐雪风，山家墙外见疏红。\n为君持酒一相向，生意虽殊寂寞同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴京留题山庄西壁","author":"蔡襄","text":"禁林京尹荷恩光，三上螭头乞郡章。\n贫薄奉亲须仰禄，此心安敢系轩裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"蔡襄","text":"东风吹雨湿鞦韆，红点棠梨烂欲然。\n拟买芳华赠年少，紫榆春浅未成钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春潮","author":"蔡襄","text":"纳纳春潮草际生，商船鸣橹趁潮行。\n封书欲寄天涯意，海水风涛不计程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昭陵行","author":"蔡襄","text":"宫人上临候昏钟，帘外香烟烛影红。\n庭柏飞霜陵漏永，可怜今夜月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"段家堤西望晚山","author":"蔡襄","text":"月下西山千万重，日光山气郁葱笼。\n鲛绡数幅须移得，惆怅如今无画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉州北藏院见初荷华","author":"蔡襄","text":"初华才过小荷身，晓露沾红点点匀。\n莫为愁心偏倚望，清江元有未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泉州安静堂","author":"蔡襄","text":"庭松永昼啭春禽，天气初晴又半阴。\n惆怅此生多病恼，正看行乐独伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洛阳诗帖 其二","author":"蔡襄","text":"洛阳风景实堪珍，到此经今三纪春。\n无限欢娱荣乐事，一时回施少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日","author":"蔡襄","text":"城头蔓草受新霜，天外孤鸿叫夕阳。\n送客情怀枫树老，著人襟袖菊花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登郡楼二首 其二","author":"蔡襄","text":"落叶随飞鸟，疏砧答暮蝉。\n悠悠戍楼角，悽切万家传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登郡楼二首 其一","author":"蔡襄","text":"秋水已复漕，秋风初怒号。\n天容霜后净，山势北来高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送驯鹿与东禅长老","author":"蔡襄","text":"二年驯扰傍山家，欲领东还道路赊。\n送汝给孤园里去，此生长伴大牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张处士二首 其二","author":"蔡襄","text":"梁园尘土著人腥，不似淮山照眼明。\n爱君心迹曾无系，一片孤云去就轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张处士二首 其一","author":"蔡襄","text":"垂垂秋雨没鞯泥，经昼门前无马嘶。\n乘静因题送行什，江南归思已凄迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻雁","author":"蔡襄","text":"霜风吹雁入南云，千里征人枕上闻。\n欲问梁园近消息，月沈星转五更分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻福昌院春日一川花卉最盛 其二","author":"蔡襄","text":"山前溪上最宜春，千树夭桃一雨新。\n争得扁舟随水去，乱花深处问秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阁下昼眠","author":"蔡襄","text":"急雨初收宫殿明，红薇花落暑风清。\n忽传午正惊残梦，寂寂西轩喜鹊声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐公以公累出知濠州","author":"蔡襄","text":"湛湛清渠风力微，濠梁行客布帆归。\n到官应过庄生庙，试问鹪鹏两是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐虞部以龙尾石砚邀予第品仍授来使持还书府","author":"蔡襄","text":"玉质纯苍理致精，锋芒都尽墨无声。\n相如间道还持去，肯要秦人十五城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桃杏园 其一","author":"蔡襄","text":"上有繁葩下落英，红波动荡逐风行。\n夕阳开处犹光艳，何况今宵值月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泰灵园书事 其一","author":"蔡襄","text":"槛外珍丛叨下泉，祥符天子泰灵仙。\n忽逢野老临池水，自剪残花趁岁钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泰灵园书事 其二","author":"蔡襄","text":"上元天仗款琳房，灵圃遥传玉殿香。\n要识年年桃李色，不关春力是恩光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离钱塘","author":"蔡襄","text":"迎潮小舸满旗风，回首津亭暮霭中。\n惆怅今宵归去梦，迢迢直至海门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读宿州天庆观门扉仙篆有感","author":"蔡襄","text":"玉骨霞衣帝所游，案前香气与星浮。\n无端醉语落尘土，一过人间四十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"通源驿别颜茂才","author":"蔡襄","text":"跃马东来不记时，酒醒寒色入征衣。\n垂杨官道连天去，落日邮亭别我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱唐题壁","author":"蔡襄","text":"绰约新娇生眼底，侵寻旧事上眉尖。\n问君别后愁多少，得似春潮夜夜添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿扬州","author":"蔡襄","text":"瓜洲堰埭阻行桡，更等江头后信潮。\n独背残灯数归路，风传寒柝夜迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿海边寺","author":"蔡襄","text":"潮头欲上风先至，海面初明日近来。\n怪得寺南多语笑，蜑船争送早鱼回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿渔梁驿","author":"蔡襄","text":"庭树疏疏河汉低，瓦沟霜白月平西。\n寒鸦不奈单栖苦，落泊惊飞到晓啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿黄檗听彬长老谭禅","author":"蔡襄","text":"一圆灵寂本清真，谁向苍浪更问津。\n欲说西来无见处，奈何言句亦前尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄南海李龙图求素馨含笑花","author":"蔡襄","text":"二草曾观岭外图，开时尝与暑风俱。\n使君已自怜清分，分得新条过海无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄钱塘春游诗呈南阳郭待制","author":"蔡襄","text":"一春游揽足诗歌，寄与南阳语思多。\n若忆钱塘曾到处，西湖仍是旧烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚色","author":"蔡襄","text":"晚色在何处，楼高天宇低。\n閒云无去住，归燕自东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望春词","author":"蔡襄","text":"霏霏细雨勒梅黄，一望春容十断肠。\n平芜古柳青青遍，独使潘郎两鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作","author":"蔡襄","text":"白玉楼台第一天，琪花风静彩鸾眠。\n谁人得似秦台女，吹彻云箫上紫烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其十","author":"蔡襄","text":"白马寺前冠盖盛，送行宾友尽英豪。\n耿丞血染边场草，留得声名日月高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其九","author":"蔡襄","text":"履道园池竹万竿，竹间池际笋斑斓。\n当时酒所誇文战，今日谁登上将坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其八","author":"蔡襄","text":"草白霜晴鹘眼开，原头游骑四边来。\n枯丛鸦鹊休惊噪，日暮分持走兔回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其七","author":"蔡襄","text":"名花百种结春芳，天与秾华更与香。\n每忆月陂堤下路，便开图画觅姚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其六","author":"蔡襄","text":"韩王宅里酒千垆，范帅园中花万株。\n行乐主人今已矣，春风还似旧时无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其五","author":"蔡襄","text":"霜后丹枫照曲堤，酒阑明月下前溪。\n石楼夜半云中笑，惊起沙禽过水西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其四","author":"蔡襄","text":"庙下春行香雾合，观中朝茹药牙尖。\n故人别后无消息，荒草生坟白露沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其三","author":"蔡襄","text":"过雨池塘凉气早，落花门户乱红多。\n松亭石上题名处，谁剥莓苔看在么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其二","author":"蔡襄","text":"修竹萧萧曲槛前，清泉㶁㶁小池边。\n琴中一弄履霜操，人静当庭月正圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游洛中十首 其一","author":"蔡襄","text":"天际乌云含雨重，楼前红日照山明。\n嵩阳居士今安否，青眼看人万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨园小部","author":"蔡襄","text":"倾宫晨起传轻妆，山殿生风夏日长。\n小部新声落天上，无人知是荔枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜雀妓","author":"蔡襄","text":"十五烧香穗帐前，几多幽怨入危弦。\n谁知千载台倾后，何处西陵有墓田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铨舍后轩","author":"蔡襄","text":"秋栏疏索水荭花，坐见花边日向斜。\n莫问幽人超世诀，即心无累是仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"蔡襄","text":"六年守郡在天涯，冬暖无因见雪华。\n今日复看千里白，强怜寒色作诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中不见女几山","author":"蔡襄","text":"宜阳南路是仙山，雪拥云埋杳霭间。\n洗眼来看无处觅，不知可复在尘寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九鲤湖","author":"蔡襄","text":"何岭巍峨欲插天，回头人与白云连。\n桃花不点寻常路，从此依稀度九仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登清风楼","author":"蔡襄","text":"郭外清溪溪外山，溪云飞上破山颜。\n晴明天气琉璃色，何处峰头带雨还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答葛公绰","author":"蔡襄","text":"山堂争似草堂清，俗事随人百种名。\n赖有四窗春茗在，瓯中时看白云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"蔡襄","text":"何事苍苔数点红，晓来花片落春风。\n可怜春色兼花尽，今古此情无处穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩玉汝山堂会别梅花已盛至苏州示谕水乡天寒未开","author":"蔡襄","text":"遥知画舫舣江隈，寒勒梅花未得开。\n唯有山堂红烛下，至今繁艳傍尊罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楚州闻晚角有怀","author":"蔡襄","text":"钦天门外警场开，画角千枝叠鼓催。\n今日淮边孤垒畔，晚风时送数声来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福州宁越门外石桥看西山晚照","author":"蔡襄","text":"宁越门前路，归鞍驻石梁。\n西山气色好，晚日正相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉禾郡偶书","author":"蔡襄","text":"尽道瑶池琼树新，仙源寻到不逢人。\n陈王也作惊鸿赋，未必当时见洛神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐辛丑蒙召还京二月八日道过陆氏之门因观小栏花卉","author":"蔡襄","text":"风色微和日昼明，小栏花卉新芽生。\n行人不是爱春物，一见芳丛似有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花洞","author":"蔡襄","text":"洞里花开无定期，落红曾见逐泉飞。\n仙人应向青山口，管却春花不与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其三","author":"蔡襄","text":"径尺规圆比雪霜，昔人何事恨秋凉。\n珍藏箧笥未为失，更有明年夏日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其八","author":"蔡襄","text":"老去将携只要轻，况临炎暑绕风清。\n儿童爱把承檐溜，未识山家质素情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其七","author":"蔡襄","text":"堂阴壁罅蚊蚋都，指麾西向先驱除。\n山翁一夜稳眠睡，若或论功谁胜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其二","author":"蔡襄","text":"野老寻山剪白云，欲将清吹助南薰。\n不堪便面张京兆，恰称能书王右军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其四","author":"蔡襄","text":"武侯白羽麾三军，帐前甲马生风云。\n怜君才地亦疏薄，相过书林至夜分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其九","author":"蔡襄","text":"不掩歌唇向画堂，不须名笔作花房。\n直应携去林泉好，转觉林泉兴味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其六","author":"蔡襄","text":"滉白新笺卷线棱，刮青纤竹缠红藤。\n可怜子夜书帷下，一片圆光得未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漳州白莲僧宗要见遗纸扇每扇各书一首 其五","author":"蔡襄","text":"薄似蒲葵质更圆，忽疑明月落尊前。\n南堂暑气生烦浊，一座清凉直几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉后","author":"蔡襄","text":"醉后归来月满衣，重重花影帽檐攲。\n行人路畔犹相笑，未似山翁倒接䍦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题建造寺奉先院","author":"蔡襄","text":"日照溪山生翠光，春深花草杂幽香。\n登临谁会迟留意，门外尘埃去路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题金山寺","author":"蔡襄","text":"画梁诗板暗流尘，水石鱼龙万句新。\n谁识高僧最深意，慈航长护过江人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题渔溪驿","author":"蔡襄","text":"昔年同向腊中回，曾绕栏干折早梅。\n今日独来攀旧树，风翻黄叶下苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凝祥池上晚归","author":"蔡襄","text":"绿径阴阴落景微，杨花零乱上人衣。\n长烟似爱沧波面，风色虽豪不肯飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":28706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]