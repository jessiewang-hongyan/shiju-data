[{"title":"集英殿春宴教坊词致语口号","author":"苏轼","text":"万人歌舞乐芳辰，长养恩深第四春。\n令下风雷常有信，时来草木岂知仁。\n璿玑已正三阶泰，玉琯初知九奏均。\n更欲年年同此乐，故应相继得元臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋日致语口号","author":"苏轼","text":"娲皇得道自神仙，金母长生不计年。\n甲子会逢三朔旦，岁星行看两周天。\n消兵渐觉腰无犊，种德方知福有田。\n彤管何人书后会，椒花椿颂一时编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵倅成伯母生日致语口号","author":"苏轼","text":"今朝寿酒泛黄花，郁郁葱葱气满家。\n愿得唐儿舞一曲，莫嫌国小向长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食宴提刑致语口号","author":"苏轼","text":"云间画鼓叠春雷，千骑寻芳戏马台。\n半道已逢山简醉，万人争看谪仙来。\n淮西按部威尤凛，历下怀仁首重回。\n还把去年留客意，折花临水更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄楼致语口号","author":"苏轼","text":"一新柱石壮严闉，更值西风落帽辰。\n不用游从誇燕子，直将气燄压波神。\n山川尚绕当时国，城郭犹飘广陌尘。\n谁凭阑干赏风月，使君留意在斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王氏生日致语口号","author":"苏轼","text":"罗浮山下已三春，松笋穿阶昼掩门。\n太白犹逃水仙洞，紫箫来问玉华君。\n天容水色聊同夜，发泽肤光自鉴人。\n万户春风为子寿，坐看沧海起扬尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严颜碑","author":"苏轼","text":"先主反刘璋，兵意颇不义。\n孔明古豪杰，何乃为此事。\n刘璋固庸主，谁为死不二。\n严子独何贤，谈笑傲砧几。\n国亡君已执，嗟子死谁为。\n何人刻山石，使我空涕泪。\n吁嗟断头将，千古为病悸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永安宫","author":"苏轼","text":"千古陵谷变，故宫安得存。\n徘徊问耆老，惟有永安门。\n游人杂楚蜀，车马晚喧喧。\n不见重楼好，谁知昔日尊。\n吁嗟蜀先主，兵败此亡魂。\n只应法正死，使公去遭燔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏作贾梁道诗，并引","author":"苏轼","text":"嵇绍似康为有子，郗超叛鉴是无孙。\n如今更恨贾梁道，不杀公闾杀子元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲子由","author":"苏轼","text":"堆几尽埃简，攻之如蠹虫。\n谁知圣人意，不尽书籍中。\n曲尽弦犹在，器成机见空。\n妙哉斲轮手，堂下笑桓公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题永叔会老堂","author":"苏轼","text":"三朝出处共雍容，岁晚交情见二公。\n乘兴不辞千里远，放怀还喜一樽同。\n嘉谋定国垂青史，盛事传家有素风。\n自顾尘缨犹未濯，九霄终日羡冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题徐氏花园二首 其一","author":"苏轼","text":"莫寻群玉山头路，莫看刘郎观里花。\n但解闭门留我住，主人休问是谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题徐氏花园二首 其二","author":"苏轼","text":"退之身外无穷事，子美樽前欲尽花。\n更有多情君未识，不随柳絮落人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵隐寺戏赠开轩李居士","author":"苏轼","text":"推倒垣墙也不难，一轩复作两轩看。\n若教从此成千里，巧历如今也被谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱道人有诗云「直须认取主人翁」，作两绝戏之 其一","author":"苏轼","text":"首断故应无断者，冰销那复有冰知。\n主人若苦令侬认，认主人人竟是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱道人有诗云「直须认取主人翁」，作两绝戏之 其二","author":"苏轼","text":"有主还须更有宾，不如无镜自无尘。\n只从半夜安心后，失却当前觉痛人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵成伯家有丽人，仆忝乡人，不肯开樽，徒吟春雪美句，次韵一笑","author":"苏轼","text":"绣帘朱户未曾开，谁见梅花落镜台。\n试问高吟三十韵，何如低唱两三杯。\n莫言衰鬓聊相映，须得纤腰与共回。\n知道文君隔青琐，梁园赋客肯言才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成伯家宴，造坐无由，辄欲效颦而酒已尽，入夜，不欲烦扰，戏作小诗，求数酌而已","author":"苏轼","text":"道士令严难继和，僧伽帽小却空回。\n隔篱不唤邻翁饮，抱瓮须防吏部来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成伯席上赠所出妓川人杨姐","author":"苏轼","text":"坐来真个好相宜，深注唇儿浅画眉。\n须信杨家佳丽种，洛川自有浴妃池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和成伯大雨中会客解嘲","author":"苏轼","text":"乐事难并真实语，坐排用意多乖误。\n兴来取次或成欢，瓦钩却胜黄金注。\n我生祸患久不择，肯为一时风雨阻！\n天公变化岂有常，明月行看照归路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泗州过仓中刘景文老兄戏赠一绝","author":"苏轼","text":"既聚伏波米，还数魏舒筹。\n应笑苏夫子，侥倖得湖州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵回文三首 其一","author":"苏轼","text":"春机满织回文锦，粉泪挥残露井桐。\n人远寄情书字小，柳丝低日晚庭空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵回文三首 其二","author":"苏轼","text":"红笺短写空深恨，锦句新翻欲断肠。\n风叶落残惊梦蝶，戍边回雁寄情郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵回文三首 其三","author":"苏轼","text":"羞云敛惨伤春暮，细缕诗成织意深。\n头畔枕屏山掩恨，日昏尘暗玉窗琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"数日前，梦一僧出二镜求诗，僧以镜置日中，其影甚异，其一如芭蕉，其一如莲花，梦中与作诗","author":"苏轼","text":"君家有二镜，光景如湛卢。\n或长如芭蕉，或圆如芙蕖。\n飞电著子壁，明月入我庐。\n月下合三璧，日月跳明珠。\n问子是非我，我是非文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠人","author":"苏轼","text":"别后休论信息疏，仙凡自古亦殊途。\n蓬山路远人难到，霜柏威高道转孤。\n旧赏未应忘楚国，新诗闻已满皇都。\n谁怜泽畔行吟者，目断长安貌欲枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子由","author":"苏轼","text":"厌暑多应一向慵，银钩秀句益疏通。\n也知堆案文书满，未暇开轩砚墨中。\n湖面新荷空照水，城头高柳漫摇风。\n吏曹不是尊贤事，谁把前言语化工？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题沈君琴","author":"苏轼","text":"若言琴上有琴声，放在匣中何不鸣？\n若言声在指头上，何不于君指上听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洗儿戏作","author":"苏轼","text":"人皆养子望聪明，我被聪明误一生。\n惟愿孩儿愚且鲁，无灾无难到公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠江州景德长老","author":"苏轼","text":"白足高僧解达观，安排春事满幽栏。\n不须天女来相试，总把空花眼里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"半山亭","author":"苏轼","text":"登岭势巍巍，莲峰太华齐。\n凭栏红日早，回首白云低。\n松柏月中老，猿猴物外啼。\n禅师吟绝后，千古指人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"常山赠刘镃","author":"苏轼","text":"刘侯年少日，骏马拊便面。\n援弓雁自落，不待白羽贯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送范德孺","author":"苏轼","text":"渐觉东风料峭寒，青蒿黄韭试春盘。\n遥想庆州千嶂里，暮云衰草雪漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"获鬼章二十韵","author":"苏轼","text":"青唐有逋寇，白首已穷妖。\n窃据临洮郡，潜通讲渚桥。\n庙谋周召虎，边帅汉班超。\n坚垒千兵破，连航一炬烧。\n擒奸从窟穴，奏捷上烟霄。\n诡异人图像，欢娱路载谣。\n干诛非一事，伐叛自先朝。\n取道经陵寝，前期告庙祧。\n西来闻几日，面缚见今朝。\n二圣临云陛，千官溢海潮。\n载囚车轣辘，失主马萧条。\n横拜如蹲犬，胡装尚衣貂。\n理卿辞具服，译长舌初调。\n缓死恩殊厚，求生尾屡摇。\n慈仁逢太母，宽厚戴唐尧。\n赤手真擒虎，和羹未赐枭。\n藁街虚授首，东市偶全腰。\n困兽何须杀，遗雏或可招。\n威声西振夏，武节北通辽。\n帝道有强弱，天时或长消。\n羌情防报复，军胜忌矜骄。\n慎重关西将，奇功勿再要。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵子由题《憩寂图》后","author":"苏轼","text":"东坡虽是湖州派，竹石风流各一时。\n前世画师今姓李，不妨还作辋川诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李伯时《渊明东篱图》","author":"苏轼","text":"彼哉嵇、阮曹，终以明自膏。\n靖节固昭旷，归来侣蓬蒿。\n新霜著疏柳，大风起江涛。\n东篱理黄菊，意不在芳醪。\n白衣挈壶至，径醉还游遨。\n悠然见南山，意与秋气高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄鲁直书伯时画王摩诘","author":"苏轼","text":"前身陶彭泽，后身韦苏州。\n欲觅王右丞，还向五字求。\n诗人与画手，兰菊芳春秋。\n又恐两皆是，分身来入流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄夷仲茶磨","author":"苏轼","text":"前人初用茗饮时，煮之无问叶与骨。\n寖穷厥味臼始用，复计其初碾方出。\n计尽功极至于磨，信哉智者能创物。\n破槽折杵向墙角，亦其遭遇有伸屈。\n岁久讲求知处所，佳者出自衡山窟。\n巴蜀石工强镌凿，理疏性软良可咄。\n予家江阳远莫致，尘土何人为披拂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱四寄其弟和","author":"苏轼","text":"老来日月似车轮，此去知逢几个春。\n昨夜冰花犹作柱，晓来梅子已生人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后醉中","author":"苏轼","text":"病为兀兀安身物，酒作逢逢入脑声。\n堪笑钱塘十万户，官家付与老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢曹子方惠新茶","author":"苏轼","text":"陈植文华斗石高，景宗诗句复称豪。\n数奇不得封龙额，禄仕何妨似马曹。\n囊简久藏科斗字，剑锋新瑩鸊鹈膏。\n南州山水能为助，更有英辞胜《广骚》。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"此君轩","author":"苏轼","text":"云幢烟节十洲人，犀甲檀枪百万军。\n翳荟丛生何足道，此君真是此君君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"参寥惠杨梅","author":"苏轼","text":"新居未换一根椽，只有杨梅不直钱。\n莫共金家斗甘苦，参寥不是老婆禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚客兴","author":"苏轼","text":"草满池塘霜送梅，疏林野色近楼台。\n天围故越侵云尽，潮上孤城带月回。\n客梦冷随枫叶断，愁心低逐雁行来。\n流年又喜经重九，可意黄花是处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴三首 其一","author":"苏轼","text":"野鸟游鱼信往还，此身同寄水云间。\n谁家晚吹残红叶，一夜归心满旧山。\n可慰摧颓仍健食，比来通脱屡酡颜。\n年华岂是催人老，双鬓无端只自斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴三首 其二","author":"苏轼","text":"故里依然一梦前，相携重上钓鱼船。\n尝陪大幕全陈迹，谬忝承明愧昔年。\n报国无成空白首，退耕何处有名田。\n黄鸡白酒云山约，此计当时已浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海康书事十首 其五","author":"秦观","text":"粤女市无常，所至辄成区。\n一日三四迁，处处售虾鱼。\n青裙脚不袜，臭味猿与狙。\n孰云风土恶，白州生绿珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋兴三首 其三","author":"苏轼","text":"浴凤池边星斗光，宴馀香满上书囊。\n楼前夜月低韦曲，云里车声出未央。\n去国何年双鬓雪，黄花重见一枝霜。\n伤心无限厌厌梦，长似秋宵一倍长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书辩才白云堂壁","author":"苏轼","text":"不辞清晓扣松扉，却值支公久不归。\n山鸟不鸣天欲雪，卷帘惟见白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖二首 其一","author":"苏轼","text":"乘槎远引神仙客，万里清风上海涛。\n回首不知沙界小，飘衣犹觉色尘高。\n须弥有顶低垂日，兜率无根下戴鳌。\n释梵茫然齐劫火，飞云不觉醉陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观湖二首 其二","author":"苏轼","text":"朝阳照水红光开，玉涛银浪相徘徊。\n山分宿雾尽宽远，云驾高风驰送来。\n升霞彩色攲残火，及物气燄明纤埃。\n可怜极大不知已，浮生野马悠悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉题信夫方丈","author":"苏轼","text":"鹤作精神松作筋，阶庭兰玉一时春。\n愿君且住三千岁，长与东坡作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庞公","author":"苏轼","text":"襄阳庞公少检束，白发不髡亦不俗。\n世所奔趋我独弃，我已有馀彼不足。\n鹿门有月树下行，虎溪无风舟上宿。\n不识当时捕鱼客，但爱长康画金粟。\n杜口如今不复言，庞公为人不曲局。\n东西有人问老翁，为道明灯照华屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书","author":"苏轼","text":"五言七言正儿戏，三行两行亦偶尔。\n我性不饮只解醉，正如春风弄群卉。\n四十年来同幻事，老去何须别愚智。\n古人不住亦不灭，我今不作亦不止。\n寄语悠悠世上人，浪生浪死一埃尘。\n洗墨无池笔无冢，聊尔作戏悦我神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三萼牡丹","author":"苏轼","text":"风雨何年别，留真向此邦。\n至今遗恨在，巧过不成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"美哉一首送韦城主簿欧阳君","author":"苏轼","text":"美哉水，洋洋乎，我怀先生，送之子于城隅。\n洋洋乎，美哉水，我送之子，至于新渡。\n念彼嵩雒，眷焉西顾，之子于迈，至于白马。\n白马旧邦，其构维新，邦人流涕，画舫之孙。\n相其口髯，尚克似之，先生遗民，之子往字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻潮阳吴子野出家","author":"苏轼","text":"予昔少年日，气盖里闾侠。\n自言似剧孟，叩门知缓急。\n千金已散尽，白首空四壁。\n烈士叹暮年，老骥悲伏枥。\n妻孥真敝屣，脱弃何足惜。\n四大犹幻座，衣冠矧外物。\n一朝发无上，愿老灵山宅。\n世事子如何，禅心久空寂。\n世间出世间，此道无两得。\n故应入枯槁，习气要除拂。\n丈夫生岂易，趣舍志匪石。\n当为狮子吼，佛法无南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被命南迁，途中寄定武同僚","author":"苏轼","text":"人事千头及万头，得时何喜失时忧。\n只知紫绶三公贵，不觉黄粱一梦游。\n适见恩纶临定武，忽遭分职赴英州。\n南行若到江干侧，休宿浔阳旧酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"散郎亭","author":"苏轼","text":"法花下有散郎亭，老树荒崖如有情。\n欢戚已随时事去，壁间只有古人名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柏家渡","author":"苏轼","text":"柏家渡西日欲落，青山上下猿鸟乐。\n欲因新月望吴云，遥看北斗挂南岳。\n一梦愔愔四十秋，古人不死终未休。\n草舍萧条谁与语，香风吹过白蘋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清远舟中寄耘老","author":"苏轼","text":"小寒初度梅花岭，万壑千岩背人境。\n清远聊为泛宅行，一梦分明堕乡井。\n觉来满眼是湖山，鸭绿波摇凤凰影。\n海陵居士无云梯，岁晚结庐苕水湄。\n山腰自悬苍玉佩，野马不受黄金羁。\n门前车盖猎猎走，笑倚清流数鬓丝。\n汀洲相见春风起，白蘋吹花覆苕水。\n万里飘蓬未得归，目断沧浪泪如洗。\n北雁南来遗素书，苦言大浸没我庐。\n清斋十日不然鼎，曲突往往巢龟鱼。\n今年玉粒贱如水，青铜欲买囊已虚。\n人生百年如寄耳，七十朱颜能有几？\n有子休论贤与愚，倪生枉欲带经锄。\n天南看取东坡叟，可是平生废读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠州灵惠院，壁间画一仰面向天醉僧，云是蜀僧隐峦所作，题诗于其下","author":"苏轼","text":"直视无前气吐虹，五湖三岛在胸中。\n相逢莫怪不相揖，只见山僧不见公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠包安静先生茶二首 其一","author":"苏轼","text":"皓色生瓯面，堪称雪见羞。\n东坡调诗腹，今夜睡应休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠包安静先生茶二首 其二","author":"苏轼","text":"建茶三十片，不审味如何。\n奉赠包居士，僧房战睡魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过海得子由书","author":"苏轼","text":"经过废来久，有弟忽相求。\n门外三竿日，江关一叶秋。\n萧疏悲白发，漫浪散穷愁。\n世事江声外，吾生幸自休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过黎君郊居","author":"苏轼","text":"半园荒草没佳蔬，煮得占禾半是藷。\n万事思量都是错，不如还叩仲尼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":77291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]