[{"title":"得杭州郑资政书","author":"宋祁","text":"误抛荷橐别云裘，天赐疏慵卧治州。\n辕下已疲犹恋主，道边宁死不为钩。\n风波路恶惊危涕，蓬葆年侵变黑头。\n独喜故人恩契厚，冷灰遗甑远相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼祚禅师二首 其二","author":"宋祁","text":"击电传心要，浮沤厌世喧。\n一床空病室，五叶谶诸孙。\n风惨萎花坠，尘流旧鉴昏。\n导师宁怛化，缁侣自销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼祚禅师二首 其一","author":"宋祁","text":"两股飞神锡，千金供住园。\n吹毛曾有问，得髓更无言。\n兰紫恩袍异，莲香社侣繁。\n双林今奄忽，泪目送风幡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"探题得小桥","author":"宋祁","text":"寻幽路穷处，略彴跨回溪。\n一水虹相映，双华鹤自栖。\n浅痕过钓艇，斜势截横堤。\n弭节谁凭望，秋光遍水西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"敝俗","author":"宋祁","text":"陶姚民屋富，梁魏敝风存。\n士阙游乡校，人争倚市门。\n椎埋时结客，博掩竞成喧。\n谁与迁荼堇，移甘膴膴原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚冬行园","author":"宋祁","text":"官舍同山舍，萧然日杖藜。\n饥鸥守冰沼，寒荠犯蔬畦。\n霜逼晴空迥，霞牵晚照低。\n城鸦栖已定，无事莫惊啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚发 其一","author":"宋祁","text":"候鼓遥喧岸，行舟逆上湍。\n轻烟著波面，斜月罢林端。\n飒沓凫鹥乱，苍茫葭苇寒。\n致君何所惮，便道许之官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚发 其二","author":"宋祁","text":"晓濑虽能迅，寒波不复扬。\n林声散栖鸟，堤影度风樯。\n兹岁方云暮，吾行未遽央。\n病身非汲黯，安敢薄淮阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚归僦庑","author":"宋祁","text":"驱车广陌阴，极望散烦襟。\n霞破天逾净，烟生树始深。\n掺喧侵暝鼓，练急向寒砧。\n却入颜生巷，穷栖似故林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春有感","author":"宋祁","text":"试上高台望绿芜，一春芳意向人疏。\n残花半落红无几，新笋争长绿有馀。\n底处流霞残别酌，即时油壁欠来车。\n不须更向昆池去，便有胡僧话劫初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春至自襄阳","author":"宋祁","text":"刀头归约月残时，棐几流尘满兔枝。\n阴地雨蛙欺鼓吹，后园烟茗老枪旗。\n风回曲榭花英聚，泉喷坳堂藓晕移。\n卧看屋梁周粟饱，不嫌五管号支离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋月夕","author":"宋祁","text":"万里冰轮转斗城，薄帷开望暝寒轻。\n金从佛国初移地，玉与仙家便作京。\n乾鹊绕枝经下苑，汉刀持夜发连营。\n谢郎莫恼修然意，欲把纤云点太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋北园二首 其二","author":"宋祁","text":"午阴初转歇馀喧，暂到高斋一凭轩。\n蒲芡因依残涨沼，枣梨狼藉晚秋园。\n轻凉著衽如堪掇，静境留人自不烦。\n须信吏中逢隐趣，随宜鲑菜伴芳樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋北园二首 其一","author":"宋祁","text":"寂寥台榭使君家，日涉中园到日斜。\n林下归心纷似叶，菊前衰鬓晚于花。\n支离粟饱宁无愧，漫漶书成未足誇。\n犹有一杯相伴在，判从鶗鴂耗年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋客庑","author":"宋祁","text":"凉叶日幡幡，西风振旅魂。\n客来聊解榻，童小未应门。\n蝉噪专林响，蜗移乱壁痕。\n缺然禽鹿性，持底报君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋集晏太尉西园 其一","author":"宋祁","text":"邂逅翘材客，乘秋共涉园。\n浅葩欢所媚，寒日醉中暄。\n目远鸿堪送，林深鹊自翻。\n长年无所嗜，惟有不空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋集晏太尉西园 其二","author":"宋祁","text":"造适衔杯醑，情来念物华。\n乔柯寒自籁，荒菊晚犹花。\n滚滚飘谈麈，焞焞下日车。\n归驺侵暝鼓，无复避堤沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚夏北轩","author":"宋祁","text":"螟崦霞霏罢，严城鼓叠通。\n梧阴破阶月，筵吹乱林风。\n浩露来无际，明河望若空。\n玉绳低影处，知是建章宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚夏高斋看雨","author":"宋祁","text":"云族穷天雨足垂，繁声凉阵挫炎威。\n圆荷万盖翻珠琲，绿稻千畦洒佛衣。\n迎浪孺鱼衔藻掷，迎风雏燕入楼飞。\n原田润浃吾农乐，籉笠纷纷晚未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"宋祁","text":"危栏真可倚，极目尽高原。\n双堠驿边道，孤烟山下村。\n高风生树响，寒水落溪痕。\n坐见斜阳尽，归鸦满翅昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚晴","author":"宋祁","text":"积晦澄天宇，浮凉湛物华。\n远雷犹送电，残照即成霞。\n贺燕翻空迥，倾梧叠影斜。\n披襟无内热，宁忆郑生瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨赴书局","author":"宋祁","text":"上直蓬山远，轻轩截九逵。\n晓光衔睥睨，秋色静罘罳。\n渐觉苏裘敝，行嗟潘领衰。\n鹪鹩自有志，不羡帝梧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望月","author":"宋祁","text":"早月始娟娟，西南寥泬天。\n魄中藏暗树，轮外上虚弦。\n傍汉含银浅，过云漏叶鲜。\n遥知今夜鹊，犹得稳枝眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙亭书所见 其二","author":"宋祁","text":"南国冬无雪，居然气候迷。\n柔蔬傲霜甲，幽鸟逆春啼。\n神鼓声无歇，樵歌韵不齐。\n举头看白日，还过太山西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙亭书所见 其一","author":"宋祁","text":"危轩冠层堞，永日付登临。\n寒雁犹能阵，乔柯自不林。\n溪流横趣岛，樵路侧依岑。\n西北虽堪望，浮云易作阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙亭晚眺","author":"宋祁","text":"日晏来凭槛，要知刀笔休。\n晚云山曲岪，粗饭客稽留。\n未觉清言减，犹堪大白浮。\n狂歌谁击节，只是自摇头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望仙亭置酒看雪","author":"宋祁","text":"雪压春期蔽曙空，凭高把酒思无穷。\n光侵病鬓都成白，寒著酡颜久未红。\n淮浒乱迷珠罅月，柳园狂误絮时风。\n使君醉笔惭妍唱，半落巴人下里中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望汉江","author":"宋祁","text":"西导岷源阔，南浮楚望开。\n弄珠嫌蚌隐，投璧让蛟回。\n岸翠山烟逼，波红日影来。\n万艘徒扰扰，谁是济川材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梁子材宰叶州郑县","author":"宋祁","text":"岁满林光会计期，天缗还赏动慈帷。\n贪荣寿母咳兰养，不过忠臣坂道危。\n云表晨凫翻舄影，斋中夜鹤应琴丝。\n未妨休沐邀清赏，市雾峰莲共蔽亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦野亭在景陵集仙王君为郡日所创","author":"宋祁","text":"州堞巑岏迥势回，一翚斜翥四轩开。\n晴光猎草雄风度，晓气浮江赤日来。\n望极长天閒倚杵，醉残严角暝休梅。\n须知故楚多馀感，剩费登高作赋才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欲栖乌","author":"宋祁","text":"湘竿风急未成栖，御史台前见落晖。\n桂冷欲依秦氏宿，柳深先望白门归。\n迎秋别恨填银汉，未夜啼声怨玉徽。\n怅望西楼圭月满，惜君犹更向南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮祠谢雨","author":"宋祁","text":"雨罢天披雾，杓回夜向晨。\n烟芜出郊路，灯火侍祠人。\n破月斜衔桂，倾河淡扫银。\n三时此修报，惭负驾崧轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明","author":"宋祁","text":"晓日东南欲照梁，藏鸦密柳暗横塘。\n行庖束蜜停晨爨，别馆熏衣冷夜香。\n陌上鲜风横去幰，阳滨翠潋泛行觞。\n独嗟楚客流芳晚，淹卧愔愔带眼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日集西园","author":"宋祁","text":"日日西园春思催，携觞结客上高台。\n正缘从事青州至，更许书生洛下来。\n早叶已成花半落，新巢未定燕千回。\n芳辰物物皆堪爱，并作高阳倒载媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晖亭","author":"宋祁","text":"亭外大江流，亭前万里舟。\n春波赋别地，秋水送归愁。\n客路风烟阔，年光日月遒。\n瑶华何所为，从古伴离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渊宗郎中移利州路漕","author":"宋祁","text":"列驺传鬨避轺车，天角横参帐饮馀。\n即日前驱催负弩，几旬论报罢移书。\n赐山故冶流钱外，烧栈新邮转粟初。\n使选愈华身尚远，喜荣嗟滞两何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渑池道中","author":"宋祁","text":"月枢残白伴征轮，雪岭萧萧久垫巾。\n此去崤函天设险，古来京洛地多尘。\n翠含山气犹疑夜，紫动林梢已放春。\n自笑衰翁应分定，宠光行役两平均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盛谏议赴维扬","author":"宋祁","text":"汉家规地遍青蒲，绣扆恩深拜命初。\n朱画车轓频出守，仙移院额别修书。\n贡图星橘兼苞柚，宴箸金齑和鲙鱼。\n奉计不应三满岁，荷囊法许从雕舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移病还台凡阅半岁乃愈始到家园视园夫治畦植花因成自叹二首 其二","author":"宋祁","text":"卧治无功赐告回，骤叨鸣履上中台。\n壶公天壤非真死，蒙叟轩裳是傥来。\n经灌早蔬扶陇出，失刊园蕊犯檐开。\n此身疏拙真丘壑，不是当年王佐才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移病还台凡阅半岁乃愈始到家园视园夫治畦植花因成自叹二首 其一","author":"宋祁","text":"十年独漉走天涯，耗尽流光得鬓华。\n犹喜此身随社燕，拟将何面对林花。\n牢骚续罢文谁读，块垒浇平酒自赊。\n旧隐不须相掉罄，要须归种邵平瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章判官诜赴吴兴幕","author":"宋祁","text":"素领潘郎滞进阶，东南沿牒得卿材。\n隋河鼓枻波成箭，越驿蒸衣雨是梅。\n客咏南风蒱齿胜，食无寒具画厨开。\n政馀底处邀真赏，洲上风蘋若下醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章靖冯公哀词 其二","author":"宋祁","text":"读易三编断，当朝万事知。\n由来不语怪，何意遂无儿。\n酒德欢长绝，书林藁尚遗。\n异时逢玉尺，方为阮咸悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章靖冯公哀词 其四","author":"宋祁","text":"风旌引素辕，歌绋远犹喧。\n此路成千古，何人叹九原。\n未亡钟淑俪，不朽寄空言。\n兄子今为后，春秋无馁魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章靖冯公哀词 其一","author":"宋祁","text":"华殿推名学，南宫重亚卿。\n心无二何佞，身有两龚清。\n归沐宾綦鲜，幽通笔思精。\n邦人为公恨，不见相承平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章靖冯公哀词 其三","author":"宋祁","text":"睆箦绵疴革，中楹奠梦还。\n蕝仪犹在野，书副即藏山。\n友酹生刍洁，君恩刻印颁。\n一朝交臂失，宁复易睎颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"累夕大风","author":"宋祁","text":"乘秋万窍怒，拂野恣离披。\n祭鸟东门酒，鸣鸢上将旗。\n有谁樵旦暮，无客赋雄雌。\n何用呼号甚，枯桑了不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"续抒感怀","author":"宋祁","text":"出案屯营卧治州，黄云三结塞垣秋。\n敦诗未必真谋帅，有恨何妨老不侯。\n百虑参差非壮境，一樽寥落但边愁。\n此时自跃知无愧，万物炉中许见收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒四陵下宫","author":"宋祁","text":"四陵烟柏蔽团晖，晓束朝绅拜庙闱。\n台下俗无西向射，寝中人护月游衣。\n垂髯上汉龙难见，耘野连天鸟自飞。\n酹毕驱车循故道，经时回望怅依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野望","author":"宋祁","text":"皋壤一摇落，年华此向阑。\n雪云从北暝，霜日带西寒。\n浆酒喧神鼓，风毛送猎鞍。\n去邦犹未远，差认汉宫盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐几","author":"宋祁","text":"空斋隐几度流光，濩落由来我所长。\n枉许是非同喻马，不知书簺两亡羊。\n空名更甚浮云薄，代事都无半捶强。\n心誓前贤六百石，异时初服返东冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夕","author":"宋祁","text":"恩华绵帝宇，花出瑞王年。\n阴魄交光地，风霙杂下天。\n盐波熬巨浸，缟顷界中田。\n有客方愁卧，先时履欲穿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄孝基归上饶","author":"宋祁","text":"街徼曙鼕喧，行人岸舣船。\n杓星背城隐，萍日过江圆。\n雾晦书囊竹，尘昏剑室莲。\n他时汉廷用，未减贾生年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄花道","author":"宋祁","text":"驿道云山里，悠悠千骑行。\n猿禽互啼啸，崖岭各阴晴。\n树合天疑窄，川回地忽平。\n锦官何日到，菖叶已催耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄泌昆仲归江西","author":"宋祁","text":"爨樵殚楚桂，裘掖厌京尘。\n别路双黄鹄，还家两玉人。\n书园飘竹粉，乡树老梨津。\n电韵盈归褚，中州赏有真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄注昆仲赴举","author":"宋祁","text":"君家日下有高名，骥子双驰嗣世灵。\n沧海赋毫多洒白，南山书简偏蒸青。\n县歌酒釂催鸣鹿，学舍綀寒乱散萤。\n昆玉林枝期帝问，差肩唱第迩尧蓂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄垍勾建昌簿","author":"宋祁","text":"灵风彻宴卮，十幅曙帆飞。\n路入江山国，人兼綵绣衣。\n草堂空岫幌，偃室听琴徽。\n谁识无双誉，新从日下归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"博州骆太保","author":"宋祁","text":"关榆秋舞折胶风，坐啸边陴忆九重。\n宴榭绿醅春沸蚁，连营清角暮吟龙。\n幕中镂管閒陈檄，塞下兜零罢汉烽。\n计日民谣諠魏阙，褒功仙劄武泥封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜屯田凌员外至","author":"宋祁","text":"昔岁裁诗送为郡，今年把袂喜还台。\n遒妍赋笔悲秋罢，寂寞衣囊被谤回。\n劲节肯凋霜外叶，惊湍须畏岸前堆。\n抚尘旧友今皆在，笑口何妨为数开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜仲微学士直右史","author":"宋祁","text":"殿栋洪纷冒紫霏，新闻再拜上丹墀。\n日高中禁仙香馥，辇度横街赭伞移。\n宝校对呈天厩马，轻兵看阅羽林儿。\n因君此际磨坳墨，偏忆当年第二螭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜杨德华见过感旧成咏","author":"宋祁","text":"曾见乌衣赌佩囊，再逢何遽二毛郎。\n病姿故有灵光在，牡齿翻随屈产长。\n河里笛声频感慨，江南花树剩凄凉。\n酒垆便有生平隔，已濯华缨未易狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"宋祁","text":"阴霞袭晓混层晖，雨势连天泱泱垂。\n泼火正投寒食日，催耕并及杏花时。\n波生客浦扬舲远，润逼宵挝作掺迟。\n把酒命宾聊一笑，吾农喜罢及吾私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜得当涂叶学士手笔","author":"宋祁","text":"随岸秋风惨别袪，峥嵘岁晏得双鱼。\n定因南浦传能赋，却到西河问索居。\n夜月连江金液动，晓山围国钿螺疏。\n端倪欲报怀人恨，滴尽瑶蟾尚有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜","author":"宋祁","text":"孤客伤时晏，遥帷对夜分。\n虚轮抱初月，侧阵捲归云。\n霜蕙披寒颖，陂凫叫暝群。\n村砧与营杵，不寐最先闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜与伯氏晏坐","author":"宋祁","text":"对拥圆炉坐，萧然念变衰。\n树鸣馀叶乱，灯战暗花危。\n樽酒伯仲雅，园荆兄弟枝。\n陶陶且相乐，低月半遥帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒夜始长","author":"宋祁","text":"四海秋风晚，千门夜刻长。\n梧桐老空井，蟋蟀近人床。\n暗烛勤垂烬，离鸿短趁行。\n生平江海志，耿耿未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食日送李公佐归汉东","author":"宋祁","text":"有客改南辕，春郊驻祖筵。\n樽寒禁火国，风暖浴沂天。\n茂草平无际，残花惨更妍。\n鹿鸣偕计近，簪盍约初年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食假中作","author":"宋祁","text":"九门烟树蔽春廛，小雨初晴泼火前。\n草色引开盘马地，箫声催暖卖饧天。\n萦丝早絮轻无著，弄袖和风细可怜。\n鳌署侍臣贪出沐，珉麋珠馅愧颁宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":47556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]