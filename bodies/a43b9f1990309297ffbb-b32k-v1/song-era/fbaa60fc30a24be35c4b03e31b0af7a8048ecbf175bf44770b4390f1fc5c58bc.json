[{"title":"朝堂斋宿","author":"梅尧臣","text":"玉属陪祠日，宫庐寓宿时。\n钟来建章远，月过羽林迟。\n寒入清绫被，风牵翠凤旗。\n贾生谁复召，安问鬼神为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"温成皇后挽词","author":"梅尧臣","text":"巩洛园陵启，函关卤部闻。\n素车迎紫气，灵袜度青云。\n歌欲传长恨，人将问少君。\n明年贺元日，无复绣衣薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游园晚归马上希深命赋","author":"梅尧臣","text":"兴尽夕阳天，言归跃杏鞯。\n新阴六街树，远目万家烟。\n歌咽楼千尺，吟馀月一弦。\n花间有游妓，醉去堕金钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游响山","author":"梅尧臣","text":"久忆门前胜，聊乘逸兴游。\n寒篙进溪曲，古木暗城头。\n鸟过空潭响，船随碧濑流。\n梅花三叠罢，烟火起沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登瓜步山二首 其二","author":"梅尧臣","text":"山上浓云合，江南暴雨来。\n将归林下岭，中路遇风雷。\n心速湾犹远，行迟伴屡催。\n舟师添系缆，儿女望人回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登瓜步山二首 其一","author":"梅尧臣","text":"瓜步山头庙，堂因魏武兴。\n亡归从赤壁，事去忆西陵。\n军井藏云杪，林根拥石棱。\n微风认江水，细甲几千层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登许昌城望西湖","author":"梅尧臣","text":"试望许西偏，湖光浸晓烟。\n岸痕添宿雨，草色际平田。\n夏木阴犹薄，朱荷出未圆。\n人闲绿波静，幽鹭插头眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登采石山上广济寺","author":"梅尧臣","text":"船从山下过，直上见僧轩。\n系缆当矶石，缘崖到寺门。\n短篱遮竹瀁，危路踏松根。\n却看沧江底，帆归烟外昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程文简公挽词三首 其三","author":"梅尧臣","text":"阙塞秋云冷，伊川苦雾阴。\n薤歌金铎碎，蒿里石宫深。\n燃漆为长夜，栽松作茂林。\n空留旧冠剑，家庙四时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程文简公挽词三首 其二","author":"梅尧臣","text":"将相荣难及，唐虞世已遭。\n名将官愈大，节固位同高。\n哀悼王朝辍，镌埋史笔操。\n空山伊水外，松柏冷萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程文简公挽词三首 其一","author":"梅尧臣","text":"尝预岩廊政，终为社稷臣。\n作藩安旧俗，饮酒得贤人。\n葬礼铙箫咽，明仪币马陈。\n泉堂一经掩，原上只麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答江十邻几","author":"梅尧臣","text":"蔡州虽非遐，作书素所懒。\n春风领燕来，得君词款款。\n燕回须在秋，此报莫言缓。\n何日见嵇康，重弹广陵散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答来上人春日即事","author":"梅尧臣","text":"南国三衣客，王城一见春。\n花明驰道远，雨涨御沟新。\n茗忆山中物，云怀岭上邻。\n如何异乡感，却出解空人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答陈五进士遗山水枕屏","author":"梅尧臣","text":"妙画能成趣，溪山迥得君。\n渔舟长映浦，岩树半藏云。\n征雁无时没，横桥有处分。\n数峰来枕席，曾不愧移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答高判官知唐店夜饮","author":"梅尧臣","text":"露宿勤王客，相从月下来。\n黄流何日涨，绿酒暂时开。\n风定灯花烂，天高斗柄回。\n醉言多脱略，吾党不须猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缑山子晋祠 会善寺","author":"梅尧臣","text":"杳蔼随龙节，萦纡历宝山。\n琉璃开净界，薜荔启禅关。\n煮茗石泉上，清吟云壑间。\n峰端生片雨，稍促画轮还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊日出猎因游梅山兰若","author":"梅尧臣","text":"我与二三骑，争驰孤戍旁。\n逐麋逢野寺，息马据胡床。\n鹰想支公好，人思灞上狂。\n归来何薄暮，烟火照溪光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊日雪","author":"梅尧臣","text":"风毛随校腊，浩浩古原沙。\n寒入弓声健，阴藏兔径赊。\n马头迷玉勒，鹰背落梅花。\n少壮心空在，悠然感岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊酒","author":"梅尧臣","text":"汲井辘轳鸣，寒泉碧瓮盛。\n欲为三伏美，方俟十旬清。\n梦忆黄公舍，徒闻韦氏名。\n熟时梅杏小，独饮效渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊笋","author":"梅尧臣","text":"南冈深竹养，下有鹧鸪鸣。\n破腊初挑箘，誇新欲比琼。\n荐盘香更美，案酒味偏清。\n马援当时见，曾将禹贡评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊脯","author":"梅尧臣","text":"畋猎得封兽，割鲜为腶脩。\n易甘非爱日，不败任经秋。\n可用资宾豆，何妨鄙荐?。\n考之新月录，美脆胜庖牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"董著作尝为参谋归话西事","author":"梅尧臣","text":"子说颇骁勇，筑城收汉疆。\n提兵无百骑，偷路执生羌。\n大将罪专辄，举军皆感伤。\n归来出万死，羸马亦摧藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛙","author":"梅尧臣","text":"陂蛙怒目生，科斗亦纵横。\n自得君王揖，能为鼓吹声。\n越人尝入馔，秦客不须惊。\n谁解缘明月，徒誇两股轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛟","author":"梅尧臣","text":"桥边三尺剑，江上六钧弧。\n汉武帝何处，周将军已无。\n织绡深有室，泣泪自为珠。\n谁为九渊害，人犹能尔图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢人惠茶","author":"梅尧臣","text":"山色已惊溪上雷，火前那及两旗开。\n采芽几日始能就，碾月一罂初寄来。\n以酪为奴名价重，将云比脚味甘回。\n更劳谁致中?水，况复颜生不解杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢永叔答述旧之作和禹玉","author":"梅尧臣","text":"天下才名罕有双，今逢陆海与潘江。\n笔生造化多多办，声满华夷一一降。\n金带系袍回禁署，翠娥持烛侍吟窗。\n人间荣贵无如此，谁爱区区拥节幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢晏相公","author":"梅尧臣","text":"刻意向诗笔，行将三十年。\n尝经长者目，未及古人肩。\n昔慕荀文若，多称王仲宣。\n今惭此微贱，重辱相君怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢紫微以画鹭二轴为寄","author":"梅尧臣","text":"白鹭画双素，粉毫幽趣多。\n翘沙依折苇，刷羽对衰荷。\n浦思悬秋壁，江情忆钓蓑。\n因君远相寄，诗咏对沧波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"集英殿赐百官宴以雨放","author":"梅尧臣","text":"春来无点雨，三月始闻雷。\n晓殿鸣檐急，群公罢食回。\n燕迎风翅健，马踏雾泥开。\n晚觉微阳透，飞光上绿槐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩子华约游园上马后雨作遂归","author":"梅尧臣","text":"谁约玩春物，狂风云骤开。\n摆丛多落蕊，蔽路足昏埃。\n逆水燕迎雨，将生鹅怕雷。\n嵇康今转懒，骑马半途回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩子华吴长文石昌言三舍人见访","author":"梅尧臣","text":"当时载酒客，共过草玄人。\n今日一寒士，能来三侍臣。\n竹门容大马，金络照诸邻。\n鸡瘦莫为具，阮家依旧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韩玉汝遗澄心纸二轴初得此物欧阳永叔又得于宋次道又得于君伯氏子华今则四矣","author":"梅尧臣","text":"三得澄心纸，吾尝再有诗。\n粗能条本末，不复语兴衰。\n堪入右军迹，惭无幼妇辞。\n君家兄弟意，将此比乌丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颍上得鲤鱼为脍怀馀姚谢师厚","author":"梅尧臣","text":"青蓑潭上老，赪尾网中鱼。\n买作秋盘脍，还思远客书。\n越齑橙熟久，楚饭稻舂初。\n虽去故乡远，不嫌为馔疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颍水","author":"梅尧臣","text":"颍水苦流瀑，浅平秋与冬。\n岸深开地势，底碧写天容。\n道枉随湾去，村遥近日逢。\n迷鱼是潭曲，宁见窟蛟龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲁山山行","author":"梅尧臣","text":"适与野情惬，千山高复低。\n好峰随处改，幽径独行迷。\n霜落熊升树，林空鹿饮溪。\n人家在何许，云外一声鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感春之际以病止酒水丘有简云时雨乍晴物景鲜丽疑其未是止酒时因成短章奉答","author":"梅尧臣","text":"东风固无迹，何处见春归。\n土逐草心坼，雨兼花片飞。\n虽怜柔甲长，只恐艳条稀。\n君但惜晴景，休言止酒非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新开坟路","author":"梅尧臣","text":"古径约城斜，锄荒可过车。\n直穿深筱去，不比绕村赊。\n伐树侵篱脚，裨塍掘涧沙。\n欲为兰若处，松柏属吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新沼竹轩","author":"梅尧臣","text":"作轩仍见竹，潇洒排青幢。\n斜乌与落月，静影昼寒窗。\n光没影亦没，激水自淙淙。\n夜深犹读易，谁更忆清江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新秋雨夜西斋文会","author":"梅尧臣","text":"夜色际阴霾，灯青谢客斋。\n梧桐生静思，络纬动秋怀。\n小酌宁辞醉，清言不厌谐。\n谁怜何水部，吟苦怨空阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新茧","author":"梅尧臣","text":"露柘林初静，烟梯不复收。\n春蚕吐丝足，工女忌寒休。\n翠薄时方献，清泉绪未抽。\n闺中能自巧，绣作玉钗头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新笋","author":"梅尧臣","text":"挑笋春雷后，晴坡过雨时。\n何言江外早，已比洛阳迟。\n园客自偷卖，主人那得知。\n徒令养新竹，待与作藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新韵曾子进早春","author":"梅尧臣","text":"新雷岁旦发声严，冰管寒销细滴檐。\n花甲将看枝上坼，蛇鳞不复地中潜。\n黄河分派来应早，白首归朝意自恬。\n强欲拟君为秀句，便无才思似江淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新霁望岐笠山","author":"梅尧臣","text":"北望直百里，峨峨千仞青。\n断虹迎日尽，飞雨带龙腥。\n阴壑烟云畜，阳崖草木灵。\n登临终不厌，时许到兹亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新燕","author":"梅尧臣","text":"前时春社毕，今日燕来飞。\n将补旧巢缺，不嫌贫屋归。\n衔泥和草梗，侧翅过柴扉。\n岂比惊丸雀，迎人欲拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬杨愈太丞之寿州见别","author":"梅尧臣","text":"畴昔西州谢法曹，声名籍甚我徒劳。\n升沉一府已荒冢，憔悴两人犹二毛。\n眼见荣华能几日，心知富贵只秋毫。\n淮南鱼美香粳滑，饱去清吟岂不高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷秘校入阙拟官时将登舟过辇下","author":"梅尧臣","text":"与君先后发，同走向京华。\n羡跃青骊去，将乘乌榜赊。\n著鞭辞宿雨，渡水踏春沙。\n闻道求为县，应当学种花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颖公遗碧霄峰茗","author":"梅尧臣","text":"到山春已晚，何更有新茶。\n峰顶应多雨，天寒始发芽。\n采时林狖静，蒸处石泉嘉。\n持作衣囊秘，分来五柳家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧元复院枕流轩","author":"梅尧臣","text":"寺外寒流驶，开轩静者栖。\n浅深看藻荇，出没爱凫鹥。\n一悟此中趣，万缘皆可齐。\n谁来惊节物，岸木长春荑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧可真东归因谒范苏州","author":"梅尧臣","text":"姑苏台畔去，云壑付清机。\n野策过寒水，山童护衲衣。\n松门正投宿，竹笠带馀晖。\n谁爱杼山句，使君应姓韦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘉祐己亥岁旦永叔内翰","author":"梅尧臣","text":"阶前去年雪，镜里旧时人。\n不觉应销尽，相看只似新。\n屠酥先尚幼，綵胜又宜春。\n独爱开封尹，钟陵请去频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"廖秀才归衡山县","author":"梅尧臣","text":"千里倦为客，秋归乌榜轻。\n过林湘橘暗，收潦楚江清。\n晚泊亲鸥鹭，残芳袭杜蘅。\n长沙几日到，天际见高城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暝","author":"梅尧臣","text":"杳杳钟初发，昏昏户闭时。\n巢禽投树尽，疲马入城迟。\n醉唱眠茅屋，晓光透槿篱。\n荷锄休带月，亭长竖毛眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端明李侍郎挽歌三首 其三","author":"梅尧臣","text":"秋树无黄鸟，蝉声亦自哀。\n素车新陇去，白马旧宾来。\n薤上朝阳露，池中岁劫灰。\n短长何足较，嗣子有高才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端明李侍郎挽歌三首 其二","author":"梅尧臣","text":"官岂不为达，其如望未充。\n敏辞倾一代，发问诎三公。\n厌向承明直，思行邵伯风。\n嗟嗟玉树折，埋没彼蒿宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端明李侍郎挽歌三首 其一","author":"梅尧臣","text":"少年为侍从，名誉竟轩腾。\n每吐胸中凤，宁容笔上蝇。\n受釐延汉室，被谤过周陵。\n今日泉宫启，师臣礼秩增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠竹亭","author":"梅尧臣","text":"种竹几千个，结亭三四椽。\n游人多寂静，啼鸟亦留连。\n酒有陶公爱，林希阮氏贤。\n我来归路远，跃马古城边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝇","author":"梅尧臣","text":"乘炎出何许，人意以微看。\n怒剑休追逐，疑屏漫指弹。\n与蚊更昼夜，共蜜上杯盘。\n自有坚冰在，能令畏不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝉","author":"梅尧臣","text":"柳上一声蝉，沙头千里船。\n行经朝雨后，思乱暑风前。\n物趣时时改，人情忽忽迁。\n感新犹感旧，更复几多年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"褐山矶上港中泊","author":"梅尧臣","text":"风恶舟难进，聊依浦里村。\n岸潮生蓼节，滩浪聚芦根。\n日脚看看雨，江心渐渐昏。\n篙师知蟹窟，取以助清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潘乐二君对雪寄声似欲予赋适方知之走笔奉呈","author":"梅尧臣","text":"南方今见雪，北客定思家。\n任冻不欺酒，竞春先著花。\n楼高休厌上，山近未应遮。\n谁问穷居日，西窗压竹斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澄虚阁","author":"梅尧臣","text":"箘圃隔嚣纷，闲来衣练裙。\n槛边生静意，水底见微云。\n斜照回晴景，幽芳袭薄薰。\n主人多赋咏，不减沈休文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蕲州广济刘主簿","author":"梅尧臣","text":"相识虽非久，相亲似旧年。\n论文君岂后，尚齿我惭先。\n惯狎吴儿水，将浮楚客船。\n安知不离恨，高柳正鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题姑苏邵氏园居","author":"梅尧臣","text":"积水夫差国，閒居鲁叟心。\n石科云起润，城角竹连阴。\n燕入池塘晚，花开岛屿深。\n应当效疏傅，不惜橐中金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题松林院","author":"梅尧臣","text":"静邃无尘地，青荧续焰灯。\n木鱼传饭鼓，山衲见归僧。\n野色寒多雾，溪痕夜阁冰。\n吾非谢康乐，独往亦何能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题腊药","author":"梅尧臣","text":"颓颜早觉衰，乃藉药扶持。\n及此季冬日，预脩来岁宜。\n鼎成无犬见，蜜炼有蜂知。\n借问月中兔，长年何所为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题滕学士九华山书堂","author":"梅尧臣","text":"处山方畏浅，曾慕结深庐。\n要与云峰近，宁将野客疏。\n涧苗来入俎，林鸟或窥书。\n何事轻兹乐，而从出塞车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤","author":"梅尧臣","text":"何时别辽海，俛啄杂庭鹍。\n去作仙人驾，来乘卫国轩。\n云中晴引唳，松上旧能言。\n但说长千岁，予非学羡门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"橐驼","author":"梅尧臣","text":"鸣驼出西域，衔尾自连连。\n汉驿凌云去，胡人踏雪牵。\n常时识风候，过碛辨沙泉。\n老觉肉封侧，犹蒙锦帕鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕","author":"梅尧臣","text":"一避吴宫火，千年楚屋春。\n翅迎风雨健，声入户庭频。\n掠水过长渚，衔虫落覆尘。\n休将汉皇后，故故比轻身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":67766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]