[{"title":"蝶恋花","author":"范成大","text":"春涨一篙添水面。\n芳草鹅儿，绿满微风岸。\n画舫夷犹湾百转。\n横塘塔近依前远。\n江国多寒农事晚。\n村北村南，谷雨才耕遍。\n秀麦连冈桑叶贱。\n看看尝面收新茧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 海棠","author":"范成大","text":"马蹄尘扑。\n春风得意笙歌逐。\n款门不问谁家竹。\n只拣红妆，高处烧银烛。\n碧鸡坊里花如屋。\n燕王宫下花成谷。\n不须悔唱关山曲。\n只为海棠，也合来西蜀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"范成大","text":"栖乌飞绝。\n绛河绿雾星明灭。\n烧香曳簟眠清樾。\n花久影吹笙，满地淡黄月。\n好风碎竹声如雪。\n昭华三弄临风咽。\n鬓丝撩乱纶巾折。\n凉满北窗，休共软红说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 元夕","author":"范成大","text":"春城胜绝。\n暮林风舞催花发。\n垂云卷尽添空阔。\n吹上新年，美满十分月。\n红蕖影下勾丝抹。\n老来牵强随时节。\n无人知道心情别。\n惟有蛾儿，惊见鬓边雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"范成大","text":"雪晴风作。\n松梢片片轻鸥落。\n玉楼天半褰珠箔。\n一笛梅花，吹裂冻云幕。\n去年小猎漓山脚。\n弓刀湿遍犹横槊。\n今年翻怕貂裘薄。\n寒似去年，人比去年觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其六 鞓红","author":"范成大","text":"猩唇鹤顶太赤，榴萼梅腮弄黄。\n带眼一般官样，祇愁瘦损东阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"范成大","text":"荡漾西湖采绿蘋。\n扬鞭南埭衮红尘。\n桃花暖日茸茸笑，杨柳光风浅浅颦。\n章贡水，郁孤云。\n多情争似桂江春。\n崔徽卷轴瑶姬梦，纵有相逢不是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 席上作","author":"范成大","text":"楼观青红倚快晴。\n惊看陆地涌蓬瀛。\n南园花影笙歌地，东岭松风鼓角声。\n山绕水，水萦城。\n柳边沙外古今情。\n坐中更有挥毫客，一段风流画不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"范成大","text":"绣户当年瑞气充。\n紫阳驾鹤下天风。\n万山秀色浑钟尽，六月炎光一洗空。\n蕉叶满，彩衣重。\n刻符持节尽人雄。\n坐中金母欣馀庆，劝醉周公劝鲁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一","author":"范成大","text":"休舞银貂小契丹。\n满堂宾客尽关山。\n从今袅袅盈盈处，谁复端端正正看。\n模泪易，写愁难。\n潇湘江上竹枝斑。\n碧云日暮无书寄，寥落烟中一雁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"范成大","text":"仗下仪容笔下文。\n天风驾鹤住仙真。\n榴花三日迎端午，蕉叶千春纪诞辰。\n经国志，立朝身。\n暂烦高手活吴民。\n明朝莫遣书丹篆，怕引新符刻玉麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四 雪梅","author":"范成大","text":"压蕊拈须粉作团。\n疏香辛苦颤朝寒。\n须知风月寻常见，不似层层带雪看。\n春髻重，晓眉弯。\n一枝斜并缕金幡。\n酒红不解东风冻，惊怪钗头玉燕乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"范成大","text":"嫩绿重重看得成。\n曲栏幽槛小红英。\n酴醾架上蜂儿闹，杨柳行间燕子轻。\n春婉娩，客飘零。\n残花浅酒片时清。\n一杯且买明朝事，送了斜阳月又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角","author":"范成大","text":"少年豪纵。\n袍锦团花凤。\n曾是京城游子，驰宝马、飞金鞚。\n旧游浑似梦。\n鬓点吴霜重。\n多少燕情莺意，都泻入、玻璃瓮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 梅","author":"范成大","text":"晚晴风歇，一夜春威折。\n脉脉花疏天淡，云来去，数枝雪。\n胜绝，愁亦绝。\n此情谁共说。\n惟有两行低雁，知人倚、画楼月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"范成大","text":"上覆白玉盂，下盛白玉盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"范成大","text":"横枝对菊开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"范成大","text":"可怜世上金和宝，借尔闲看七十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题鼎州甘泉寺","author":"范讽","text":"平仲酌泉回北望，谓之礼佛向南行。\n烟岚翠锁门前路，转使高僧厌宠荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范讽","text":"惟有南山与君眼，相逢不改旧时情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江湖伟观","author":"范希禹","text":"望断菰蒲烟水乡，凭高不尽意苍茫。\n神州北去山川远，王气南来天地长。\n晴见白云归竺国，夜看红日上扶桑。\n游人自拥笙歌醉，谁为梅花酹一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明水寺","author":"范应铃","text":"环山清浅一溪水，夹径高低十里松。\n烟锁石门疑路断，斜阳影里忽闻钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金鸡城","author":"范应铃","text":"梦里家山竹里钟，金鸡山下快掀篷。\n垂杨不隔池楼月，宿酒吹残杨柳风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 和持国","author":"范纯仁","text":"腊后春前暖律催。\n日和风软欲开梅。\n公方结客寻佳景，我亦忘形趁酒杯。\n添歌管，续尊罍。\n更阑烛短未能回。\n清欢莫待相期约，乘兴来时便可来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙庭观","author":"范良龚","text":"我昔遨游周八极，玉京金阙俱经历。\n翩然骑凤下瑶池，如与双成获相识。\n双成侍燕王母旁，道貌方瞳照人碧。\n玉笙吹彻奉琼觞，范子从旁丐馀沥。\n东方曼倩谓余言，汝亦名在地仙籍。\n凤城南望好溪山，此是元君故仙宅。\n琉璃槃上存金鼎，鼎内丹砂如琥珀。\n汝能服食早归来，与予同是逍遥客。\n我时贪醉蟠桃春，不记当年说仙迹。\n一朝酒醒人世非，盘碎丹飞杳难觅。\n香风堂上久徘徊，苏李题诗挂空壁。\n孤云野鹤谩兴怨，我独摩挲问金狄。\n世人劝我舐丹鼎，我亦何尝苦营役。\n丈夫自有大还丹，得道不分今与昔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢","author":"范周","text":"美兰堂昼永，晏清暑、晚迎凉。\n控水槛风帘，千花竞拥，一朵偏双。\n银塘。\n尽倾醉眼，讶湘娥、倦倚两霓裳。\n依约凝情鉴里，并头宫面高妆。\n莲房。\n露脸盈盈，无语处、恨何长。\n有翡翠怜红，鸳鸯妒影，俱断柔肠。\n凄凉。\n芰荷暮雨，褪娇红、换紫结秋房。\n堪把丹青对写，凤池归去携将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宝鼎现","author":"范周","text":"夕阳西下，暮霭红隘，香风罗绮。\n乘丽景、华灯争放，浓焰烧空连锦砌。\n睹皓月、浸严城如画，花影寒笼绛蕊。\n渐掩映、芙蓉万顷，迤逦齐开秋水。\n太守无限行歌意。\n拥麾幢、光动珠翠。\n倾万井、歌台舞榭，瞻望朱轮骈鼓吹。\n控宝马、耀貔貅千骑。\n银烛交光数里。\n似乱簇、寒星万点，拥入蓬壶影里。\n宴阁多才，环艳粉、瑶簪珠履。\n恐看看、丹诏催奉，宸游燕侍。\n便趁早、占通宵醉。\n缓引笙歌妓。\n任画角、吹老寒梅，月落西楼十二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南源寺","author":"范季随","text":"懒逐儿曹载酒行，朅来萧寺作清明。\n江湖万里此身健，风雨一春今日晴。\n露地野花双戏蝶，并湖烟树独啼莺。\n挂冠神武何时见，只合深藏讳姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范生","author":"韩驹","text":"万里投殊俗，馀生老一丘。\n尚怜之子秀，能慰此翁愁。\n只欲连墙住，胡为下邑留。\n黄尘诗思尽，乞与四山秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首 其三","author":"范宗尹","text":"古寺山环合，崎岖路仅通。\n一庵寒闭户，群木夜号风。\n幽胜穷探尽，尘劳洗涤空。\n兹游恐不再，聊记小诗中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首 其二","author":"范宗尹","text":"晓出城东路，寻僧聊避喧。\n宿云开岭岫，晚稻没川原。\n村暗桑枝合，林红柿子繁。\n日斜僮仆困，共喜到山门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题石桥","author":"范宗尹","text":"古木森森白昼昏，瀑泉飞处两山分。\n石梁跨谷欣初睹，茗椀浮花信旧闻。\n行古向来悲一跌，洁身此去欲三薰。\n至人傥有矜怜意，便与提携出世纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首 其一","author":"范宗尹","text":"丈人古君子，清德肖冰玉。\n仕宦三十载，一饱犹仰禄。\n驱车向金阙，此行何太速。\n家山岂不恋，陶令瓶无粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游大有空明洞","author":"范宗尹","text":"暂到山中礼法坛，空明云气逼面寒。\n当年孤鹤是何处，遥想天风坠羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题雁荡山","author":"范宗尹","text":"一径入幽谷，随山几萦盘。\n云树深蓊蔚，石溪响潺湲。\n我来春色晚，山花亦何繁。\n好鸟不知名，向人自关关。\n遗我发兴新，探讨忘疲艰。\n龙湫信奇绝，飞泉落云间。\n快泻万斛珠，溅沫霜雪寒。\n尊者所经行，草木不可芟。\n敢将尘土足，濯此清泠湾。\n晚投野僧家，山作碧玉环。\n高堂极虚明，可寄须臾闲。\n此行端为山，山穷我当还。\n明朝驱车去，依然随尘寰。\n胜处未易忘，神游清夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游虎丘","author":"范宜","text":"山奇水秀碧交加，倚遍阑干眼力赊。\n阁跨剑池飞突兀，路盘石壁转攲斜。\n日移高塔桥边影，风送疏钟岭外家。\n杰出人间清胜地，老僧终日卧烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游南雁荡","author":"范旻","text":"尘劳最是爱山居，借得丹台半日馀。\n黄雪糁来松径满，白云飞去洞门虚。\n扫苔有客题诗句，滴露无人校道书。\n何日结巢依石室，早从湖海赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄宣义大师英公","author":"范杲","text":"西游久不得师书，睹物相思展篆图。\n情厚未忘莲社约，分深曾伴橘洲居。\n青云作阵宜长卧，白酒资吟莫破除。\n见说近来挥彩笔，字皆飞动有功夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范杲","text":"千里版图来浙右，一声金鼓下河东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 庆杨平","author":"范炎","text":"襟韵何如，文雅风流，王谢辈人。\n问传家何物，多书插架，放怀无可，有酒盈樽。\n一咏一谈，悠然高致，似醉当年曲水春。\n还知否，壮胸中万卷，笔下千军。\n门前我有佳宾。\n但明月、清风更此君。\n喜西庐息驾，心间胜日，东皇倚杖，目送行云。\n闻道君王，玉堂佳处，欲诏长杨奏赋孙。\n功名看，一枝丹桂，两树灵椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送程给事知越州","author":"范育","text":"雍容青琐汉儒臣，出牧东南七郡民。\n秘府内分龙节贵，故乡朝看锦衣新。\n湖山动色迎诗老，牛酒均欢慰路人。\n岂愧能名循吏后，应留美化大江滨。\n相逢日下黄门省，回首风前画鹢津。\n未省行春周泽国，即听鸣玉上枫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"韦曲","author":"范育","text":"竹巷松门堆白沙，老农犹指相君家。\n林塘卜筑今谁问，谱牒名流空自嗟。\n万簇晴山开玉案，一溪春水满晴沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺李昉","author":"范质","text":"翰苑重求李谪仙，词锋颖利胜龙泉。\n朝趋建礼霞烘日，夜直承明月印天。\n圣主重知缘国士，相公多喜为同年。\n青春才子金门贵，蜀锦袍新夺日鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诫儿侄八百字","author":"范质","text":"去年初释褐，一命列蓬丘。\n青袍春草色，白纻弃如仇。\n适会龙飞庆，王泽天下流。\n尔得六品阶，无乃太为优。\n凡登进士第，四选升校雠。\n历官十五考，叙阶与尔俦。\n如何志未满，意欲凌云游。\n若言品位卑，寄书来我求。\n省之再三叹，不觉泪盈眸。\n吾家本寒素，门地寡公侯。\n先子有令德，乐道尚优游。\n生逢世多僻，委顺信沈浮。\n仕宦不喜达，吏隐同庄周。\n积善有馀庆，清白为贻谋。\n伊余奉家训，孜孜务进修。\n夙夜事勤肃，言行思悔尤。\n出门择交友，防慎畏薰莸。\n省躬常惧玷，恐掇庭闱羞。\n童年志于学，不惰为箕裘。\n二十中甲科，赪尾化为虬。\n三十入翰苑，步武向瀛洲。\n四十登宰辅，貂冠侍冕旒。\n备位行一纪，将何助帝猷。\n即非救旱雨，岂是济川舟。\n天子未遐弃，日益素餐忧。\n黄河润千里，草木皆浸渍。\n吾宗凡九人，继踵升官次。\n门内无白丁，森森朱绿紫。\n鹓行洎内职，亚尹州从事。\n府掾监省官，高低皆清美。\n悉由侥倖升，不因资考至。\n朝廷悬爵秩，命之曰公器。\n才者禄及身，功者赏于世。\n非才及非功，安得专厚利。\n寒衣内府帛，饥食太仓米。\n不蚕复不穑，未尝勤四体。\n虽然一家荣，岂塞众人议。\n颙颙十目窥，龊龊千人指。\n借问尔与吾，如何不自愧。\n戒尔学立身，莫若先孝弟。\n怡怡奉亲长，不敢生骄易。\n战战复兢兢，造次必于是。\n戒尔学干禄，莫若勤道艺。\n尝闻诸格言，学而优则仕。\n不患人不知，惟患学不至。\n戒尔远耻辱，恭则近乎礼。\n自卑而尊人，先彼而后己。\n相鼠与茅鸱，宜鉴诗人刺。\n戒尔勿旷放，旷放非端士。\n周孔垂名教，齐梁尚清议。\n南朝称八达，千载秽青史。\n戒尔勿嗜酒，狂药非佳味。\n能移谨厚性，化为凶险类。\n古今倾败者，历历皆可记。\n戒尔勿多言，多言者众忌。\n苟不慎枢机，灾危从此始。\n是非毁誉间，适足为身累。\n举世重交游，拟结金兰契。\n忿怨容易生，风波当时起。\n所以君子心，汪汪淡如水。\n举世好承奉，昂昂增意气。\n不知承奉者，以尔为玩戏。\n所以古人疾，蘧蒢与戚施。\n举世重任侠，俗呼为气义。\n为人赴急难，往往陷刑死。\n所以马援书，殷勤戒诸子。\n举世贱清素，奉身好华侈。\n肥马衣轻裘，扬扬过闾里。\n虽得市童怜，还为识者鄙。\n我本羁旅臣，遭逢尧舜理。\n位重才不充，戚戚怀忧畏。\n深渊与薄冰，蹈之唯恐坠。\n尔曹当悯我，勿使增罪戾。\n闭门敛踪迹，缩首避名势。\n名势不久居，毕竟何足恃。\n物盛必有衰，有隆还有替。\n速成不坚牢，亟走多颠踬。\n灼灼园中花，早发还先萎。\n迟迟涧畔松，郁郁含晚翠。\n赋命有疾徐，青云难力致。\n寄语谢诸郎，躁进徒为耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范彦辉","text":"何当日月明，痛洗苍生病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题织女祠","author":"范某","text":"商飙初至月埋轮，乌鹊桥边绰约身。\n闻道佳期唯一夕，因何朝暮对斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范某","text":"疑有仙人真影在，故垂百尺水晶帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"麻姑山","author":"范柔中","text":"岚迎晓日碧烟收，霜薄风清胜会游。\n虎驾不来空紫府，真人应接又瀛洲。\n岩前野草冬犹秀，亭下飞泉冻亦流。\n他日卜邻深有意，竟须平步揖浮丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿苑禅寺","author":"范洁","text":"晋远风流八百年，虎溪无复社中贤。\n爱斯吐月吞风屋，有此开花结子莲。\n直使渊明通耿介，亦教灵运费攀援。\n知师戒洁方投社，欲对松窗设榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水纹扇","author":"范祖禹","text":"剪出潇湘一片秋，动摇君手向空流。\n微风自有云涛气，梦入江天一钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同安诞日赋小诗祝延","author":"范祖禹","text":"海上蟠桃方结子，月中仙桂欲生枝。\n须知阴德多馀庆，仁者从来与寿宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吏部彭侍郎召会冯少师园亭即席赋诗","author":"范祖禹","text":"门生犹记凿龙登，载酒东堂命友朋。\n终日清谈陪几杖，赤松况是坐禅僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过朝天岭二首 其二","author":"范祖禹","text":"地拆天开此险成，飘萧毛发壮心惊。\n人间行路难如此，叹息何时险阻平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过朝天岭二首 其一","author":"范祖禹","text":"夜上朝天晓不极，举头唯见苍苍色。\n回看初日半轮明，下视嘉陵千丈黑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二十五春日见寄五首 其五","author":"范祖禹","text":"流水家家入，脩篁处处同。\n城南履道宅，白傅有遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二十五春日见寄五首 其四","author":"范祖禹","text":"白日春台上，欢娱莫诉杯。\n飞花留客醉，啼鸟近人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二十五春日见寄五首 其三","author":"范祖禹","text":"潇洒幽栖地，山岚日夕昏。\n松风吹绿绮，溪月湛清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二十五春日见寄五首 其二","author":"范祖禹","text":"莫恨生华发，唯须不负春。\n风光无老少，祗属有情人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二十五春日见寄五首 其一","author":"范祖禹","text":"绰约花无语，间关鸟自吟。\n及时须赏玩，风雨不能禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游李少师园十题 和张二十五游白龙溪甘水谷郊居杂咏七首 其三","author":"范祖禹","text":"南窗高卧看云生，日暮回风动紫荆。\n鼓吹不须过野坞，青蛙雨后自能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游李少师园十题 和张二十五游白龙溪甘水谷郊居杂咏七首 其一","author":"范祖禹","text":"君家潇洒住园林，更入青山径路深。\n唯有白云为得侣，祗应流水是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]