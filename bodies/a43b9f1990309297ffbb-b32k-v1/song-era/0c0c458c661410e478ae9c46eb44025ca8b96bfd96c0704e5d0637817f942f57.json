[{"title":"除夜寄罗评事同年 其二","author":"王禹称","text":"除夜在天涯，共君同忆归。\n梦中倾寿酒，堂下著斑衣。\n腊雪通宵舞，梅花到处飞。\n更堪洞庭宿，愁思倍依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜寄罗评事同年 其一","author":"王禹称","text":"岁暮洞庭山，知君思浩然。\n年侵晓色尽，人枕夜涛眠。\n移棹灯摇浪，开窗雪满天。\n无因一乘兴，同醉太湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饶州马殿院频寄黑髭药服数千丸斑白未减作诗以报之","author":"王禹称","text":"两州迢递隔长江，寄药知君念老郎。\n妙术远惭周柱史，衰容争奈汉冯唐。\n未除凡骨无仙分，欲断愁根有醉乡。\n多羡绣衣须鬓黑，满身唯带柏台霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭闻种山人表谢急徵不赴荣侍因成拙句仰纪高风","author":"王禹称","text":"未赴吾君凤诏徵，蒲轮何似板舆荣。\n自期物外长无事，谁觉人间已有名。\n饵朮肯尝钟鼎味，纫兰应笑佩环声。\n洛南迁客堪羞死，犹望量移近帝城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅次新安","author":"王禹称","text":"迁客乍离群，秋砧不忍闻。\n回头恋红药，失脚下青云。\n尚假金貂冕，犹残柱国勋。\n此身未敢死，会拟报明君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别仲咸 其一","author":"王禹称","text":"二年商岭赖知音，惜别难藏泪满襟。\n头白忽抛攀桂伴，道消休话拔茅心。\n科名偶得同年分，交契都因谪宦深。\n唱和诗章收拾取，两家留与子孙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别仲咸 其二","author":"王禹称","text":"世网婴缠不自由，可怜匏系又萍流。\n忽从清洛南边郡，移向黄河北岸州。\n命薄我甘闲副使，道孤君是假诸侯。\n解梁去此无多地，时寄新诗慰客愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中书事上集贤钱侍郎 其二","author":"王禹称","text":"妻儿惯蔬素，仆马任龙钟。\n一榻浑无物，孤琴对病容。\n风翻帘影乱，旱减井痕重。\n幽寂谁为伴，扶行赖瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中书事上集贤钱侍郎 其三","author":"王禹称","text":"食贫当岁旱，朝退百端忧。\n典笏逢休假，焚香愿有秋。\n病饥浑厌肉，瘦冷未更裘。\n梦见山村兴，披蓑钓乱流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中书事上集贤钱侍郎 其一","author":"王禹称","text":"力疾奉期谒，归来倦送迎。\n老为儒术误，瘦爱道装轻。\n罗药幽香散，移琴细韵生。\n晨餐渐有味，笋蕨倍关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中书事上集贤钱侍郎 其四","author":"王禹称","text":"郎署领制诰，十年未上坡。\n冯唐空潦倒，卫绾是谁何。\n犹赖紫垣直，聊遮白发多。\n归田未有计，村树绿婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中书事上集贤钱侍郎 其五","author":"王禹称","text":"日日奉朝请，病多仍食贫。\n揶揄应有鬼，夷俟岂无人。\n凤阁十年笔，乌纱九陌尘。\n集仙知己在，应为指迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起至幽谷二首 其二","author":"王禹称","text":"□□□□□□家，中有流泉一道斜。\n列壑攒峰□□窕，茂林修竹翠交加。\n雨侵怪石苔生晕，水满平田稻放花。\n乘兴偶来心更适，归时灯火欲栖鸦。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起至幽谷二首 其一","author":"王禹称","text":"□□漳滨几晦明，起扶藜杖试闲行。\n清泉□□□□□，□□□□□可惊。\n万壑松声□□□，□□□□□□□。\n□□□起沧洲趣，便欲投簪此濯缨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起思归 其二","author":"王禹称","text":"四十为郎非不偶，况曾提笔直瀛洲。\n明时遇主谁甘退，白发侵人自合休。\n梦得蹉跎因出郡，薛能诗什耻监州。\n春来病起思归甚，未敢飞章达冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起思归 其一","author":"王禹称","text":"年来多病转思山，终日呻吟簿籍间。\n叔夜养生休著论，陶潜难死只因闲。\n又移郡印三年调，未报君恩两鬓斑。\n安得便归田里去，松篁泉石掩柴关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病假","author":"王禹称","text":"小郡虽无事，常时亦有劳。\n坐衙衫强著，判案笔须操。\n眼病因求假，身闲更觉高。\n何当长似此，归去老蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赁宅","author":"王禹称","text":"萍流匏系任行藏，惟指无何是我乡。\n左宦只抛红药案，僦居犹住玉泉坊。\n白公渭北眠村舍，杜甫瀼西赁草堂。\n未有吾庐莫惆怅，古来贤达尽茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赁宅","author":"王禹称","text":"老病形容日日衰，十年赁宅住京师。\n阁栖凤鸟容三入，巢宿鹪鹩欠一枝。\n壁挂图书多不久，砌栽芦苇亦频移。\n人生荣贱须知分，会买茅庵映槿篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高闲","author":"王禹称","text":"谪官滁上欲何为，唯把高闲度岁时。\n费尽俸钱因合药，忙于公事是吟诗。\n京中吏去慵传信，江外僧来与撰碑。\n更待吾家婚嫁了，解龟休致未全迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶置小园因题 其二","author":"王禹称","text":"偶营菜圃为盘飧，淮渎祠前水北村。\n泉响静连衙鼓响，柴门深近子城门。\n濛濛细雨春蔬甲，亹亹寒流老树根。\n从此商于地图上，画工添个舍人园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶置小园因题 其一","author":"王禹称","text":"十亩春畦两眼泉，置来应得弄潺湲。\n三年谪宦供厨菜，数月朝行赁宅钱。\n空愧先师轻学圃，未如平子便归田。\n此身久畜耕山计，不敢抛官为左迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唱和暂停霖淫复作因书四韵呈仲咸兼简宋从事","author":"王禹称","text":"山云漠漠雨霏霏，正是骚人唱和时。\n谪宦惭无贾生赋，愁霖合有谢公诗。\n已妨步月尘凝榭，恐误登高菊满篱。\n且喜宾筵得同道，不为篇什欲何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商州进士张齐说将赴春闱以诗别冯中允冯君酬和予亦次韵继之","author":"王禹称","text":"风雪骑驴去入关，试期难伴贰车闲。\n桃花好跃三门浪，芝草休寻六里山。\n锡宴待吟春烂漫，旧房从锁石孱颜。\n明年得意归来日，不见麻衣泣玉班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堂前井","author":"王禹称","text":"公署在山上，凿泉深且清。\n一杯水溜满，六月火云生。\n利物诚堪拜，投钱恶近名。\n饮之何以报，官况与诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄丰阳喻长官","author":"王禹称","text":"七十年华鬓未霜，道情偏称宰丰阳。\n早衙请印无仇览，夜榻围棋祇孟光。\n庭户万重岚气润，盘餐数饤药苗香。\n犹言彭泽终归去，门柳青青槛菊黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄冯舍人","author":"王禹称","text":"转轮争合滞才华，急诏重乘上汉查。\n继我已吟红药树，劝君曾赋海棠花。\n词随健笔光纶诰，诗落成都灿绮霞。\n应笑同时东观客，商于憔悴似长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄宁陵陈长官","author":"王禹称","text":"吏隐宁陵县，琴堂枕古河。\n家山隔江远，风雨过船多。\n假日亲寻药，公庭自种莎。\n相逢如旧识，执手动劳歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄田舍人","author":"王禹称","text":"出处升沉不足悲，羡君操履是男儿。\n左迁郡印辞纶阁，直谏书囊在殿帷。\n未有佥谐徵贾谊，可无章疏雪微之。\n朝行孤立知音少，闲步苍苔一泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汶阳田告处士","author":"王禹称","text":"汶水年来涨绿波，先生居此兴如何。\n门连别浦闲垂饵，宅枕平沙好种莎。\n治水共谁言鲧禹，著书空自继丘轲。\n可怜垂白无人问，却伴渔翁著钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄状元孙学士","author":"王禹称","text":"久居台阁多忧畏，欲荐贤才涉比周。\n灰死寸心甘不动，雪侵双鬓未能休。\n封章事寝空腾谤，制诰词荒益自羞。\n唯爱君家棣华榜，登科记上并龙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄秀州冯十八礼丞同年","author":"王禹称","text":"君从婺女典嘉兴，我自滁阳到广陵。\n同被雪霜侵两鬓，独嗟官职是三丞。\n郡斋新养华亭鹤，乡信时逢建业僧。\n愿作入朝西道主，只看黄霸诏书徵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄杭州西湖昭庆寺华严社主省常上人","author":"王禹称","text":"梦幻吾身是偶然，劳生四十又三年。\n任誇西掖吟红药，何似东林种白莲。\n入定雪龛灯焰直，讲经霜殿磬声圆。\n谪官不得馀杭郡，空寄高僧结社篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄砀山主簿朱九龄","author":"王禹称","text":"闲思蓬岛会群仙，二百同年最少年。\n利市襕衫抛白纻，风流名纸写红笺。\n歌楼夜宴停银烛，柳巷春泥污锦鞯。\n今日折腰尘土里，共君追想好凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄郓城萧处士","author":"王禹称","text":"收藏家谱恐人寻，雨笠烟蓑自称心。\n夜踏月华三径小，晓耕秋色一犁深。\n庭园纵窄犹栽药，活计虽贫不卖琴。\n应笑区区未名客，九衢尘土满衣襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄金乡张赞善","author":"王禹称","text":"年少辞荣自古稀，朝衣不著著斑衣。\n北堂侍膳侵星起，南亩催耕冒雨归。\n种竹野塘春笋脆，采兰幽涧露牙肥。\n伊予自是徒劳者，未得同寻旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陕府通判孙状元兼简令弟秀才","author":"王禹称","text":"商山留滞再经年，咫尺无由见状元。\n会赦未教归北阙，高歌应合遇东园。\n寸心谩道如弦直，两鬓难禁似雪繁。\n兄弟相知情未改，著书呼取屈原魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鱼台主簿傅翱","author":"王禹称","text":"健羡鱼台景最奇，鲍参军到语多时。\n波平绿野悬鱼网，木脱空城露酒旗。\n锦掷鲜鳞红拨剌，雪翘寒鹭白䙰褷。\n仍誇县尹风骚客，应有秋来唱和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄毗陵刘博士","author":"王禹称","text":"毗陵古郡接江堧，赴任琴书共一船。\n下岸且寻甘露寺，到城先问惠山泉。\n秋蟾吐槛供吟兴，野鹤偎床伴醉眠。\n官散道孤诗格老，算应双鬓更皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄海州副使田舍人","author":"王禹称","text":"系即匏瓜转即蓬，可怜踪迹与君同。\n眼前有酒长须醉，身外除诗尽是空。\n闲采紫芝饥可疗，欲浮沧海道应穷。\n声名官职相磨折，休忆西垣药树红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄商州冯十八仲咸同年","author":"王禹称","text":"迁客秋来捧诏还，故人多怪鬓毛斑。\n重为东掖垣中士，犹梦西晖亭下山。\n静算宦途皆是命，老思身计不如闲。\n何时相约同归隐，水竹萧萧并掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献仆射相公 其二","author":"王禹称","text":"圣君宵旰念生民，重命甘盘秉国钧。\n引马但传三刻漏，喘牛休问四时春。\n羹和旧鼎黄金铉，雪压新堤白玉尘。\n应念前年献诗客，谪官无俸不胜贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献仆射相公 其一","author":"王禹称","text":"三朝文匠百僚师，再秉洪钧七政齐。\n一道白麻来玉署，两条红烛上沙堤。\n池波尚浴当时凤，省树犹存旧日鸡。\n炉冶正开无弃物，应怜折剑在尘泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献润州赵舍人 其一","author":"王禹称","text":"南徐城古树苍苍，衙府楼台尽枕江。\n甘露钟声清醉榻，海门山色滴吟窗。\n直庐久负题红叶，出镇何妨拥碧幢。\n闻说秋来自高尚，道装筇竹鹤成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献润州赵舍人 其二","author":"王禹称","text":"记言彩笔罢摛华，郡阁高闲似道家。\n琴院坐听江寺磬，郡楼吟见海山霞。\n春园遗母亲烧笋，夜榻留僧自煮茶。\n应笑陶潜未归去，折腰奔走在泥沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄献翰林宋舍人","author":"王禹称","text":"金鼎盐梅偶未和，位高犹说野情多。\n宫墙月上开琴匣，道院风清响药罗。\n留客旋烧含露笋，倩僧教种耐霜莎。\n孤寒知有为霖望，未忍江头钓渌波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄潘处士","author":"王禹称","text":"卖药先生白布衣，书来方信在京师。\n减君炉里烧丹术，助我山中买酒资。\n闲似野云终不仕，闭如笼鹤已多时。\n飘飘又去黄河北，更负中条几首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄潘阆处士","author":"王禹称","text":"烂醉狂歌出上都，秋风时节忆鲈鱼。\n江城卖药长将鹤，古寺看碑不下驴。\n一片野心云出岫，几茎吟发雪侵梳。\n算应冷笑文场客，岁岁求人荐子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题义门胡氏华林书院","author":"王禹称","text":"水阁山斋架碧虚，亭亭华表映门闾。\n力田岁取千箱稻，好事家藏万卷书。\n旋对杯盘烧野笋，别开池沼养溪鱼。\n吾生未有林泉计，空愧妨贤卧直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赞宁上人","author":"王禹称","text":"支公兼有董狐才，史传修成乙夜开。\n天子远酬丹诏去，高僧不出白云来。\n眉毫久别应垂雪，心印休传本似灰。\n若念重瞳欲相见，未妨西上一浮杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳化二年八月晦日夜梦于上前赋诗既寤唯省一句云九日山州见菊花间一日有商于贰车之命实以十月三日到郡重阳已过残菊尚多意梦已徵矣今忽然一岁又逼登高追续前诗句因成四韵","author":"王禹称","text":"节近登高忽叹嗟，经年憔悴别京华。\n贰车何处搔蓬鬓，九日山州见菊花。\n梦里荣衰安足道，眼前杯酒且须赊。\n商于邹鲁虽迢递，大底携家即是家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日独酌","author":"王禹称","text":"一郡官闲唯副使，一年冷节是清明。\n春来春去何时尽，闲恨闲愁触处生。\n漆燕黄鹂誇舌健，柳花榆荚斗身轻。\n脱衣换得商山酒，笑把离骚独自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"硖石县旅舍","author":"王禹称","text":"霜乾红叶飞，迁客思凄凄。\n处险人垂瘿，登山马跙蹄。\n篱荒蛬韵苦，云冻雁行低。\n此夕应无寐，何烦报晓鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移入官舍偶题四韵呈仲咸","author":"王禹称","text":"赁舍喧卑谪宦情，同年邀我住公庭。\n不离鍊药煎茶屋，便坐吟诗看雪厅。\n苔径乍行侵屐绿，竹窗初卧满床青。\n使君公署虽宏敞，未见南山翠似屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阌乡县留题陶氏林亭","author":"王禹称","text":"年来恩例得量移，祇合高歌不合悲。\n消长盈虚存大易，东南西北有先师。\n未抛轩冕终妨道，偶见林泉且赋诗。\n何事阌乡住三日，吟情难舍竹边池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中看梅花因书诗酒之兴","author":"王禹称","text":"冬来滁上兴何长，唯把吟情入醉乡。\n雪片引诗胜玉帛，梅花劝酒似嫔嫱。\n凝眸未厌频频落，拥鼻还怜细细香。\n谪宦老郎无一物，清贫犹且放怀狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪霁霜晴独寻山径菊花犹盛感而赋诗","author":"王禹称","text":"狼藉金钱撒野塘，几丛无力卧斜阳。\n争偷暖律输桃李，独亚寒枝负雪霜。\n谁惜晚芳同我折，自怜孤艳袭人香。\n幽怀远慕陶彭泽，且撷残英泛一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中春值偶题","author":"王禹称","text":"御柳差差拂禁墙，菲才何事直仙乡。\n坐闻鸡唱皇宫近，睡枕鱼须白日长。\n帘挂藓庭微雨霁，研添桐井落花香。\n春风老尽诗情淡，翻卷青编独绕廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪贻仲咸","author":"王禹称","text":"半冬无雪懒吟诗，薄暮纷纷喜可知。\n衣上惹来看不足，竹边听处立多时。\n光迷曙色侵窗早，片舞寒空到地迟。\n今日使君吟望好，一车飞絮醉褰帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食","author":"王禹称","text":"寒食江都郡，青旗卖楚醪。\n楼台藏绿柳，篱落露红桃。\n妓女穿轻屐，笙歌泛小舠。\n史君慵不出，愁坐读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食出城马上偶作","author":"王禹称","text":"欲报君亲与愿违，今年寒食任芳菲。\n八音遏密因山后，双泪滂沱拜墓归。\n艳冶桃花迎马笑，轻狂榆荚扑人飞。\n宦途时态更谙尽，犹愧妨贤直紫微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓直偶题","author":"王禹称","text":"两朝书命愧无才，谩逐词臣侍玉阶。\n病似相如多避事，拙于方朔少诙谐。\n命奇只合先休退，道在何妨更卷怀。\n白首犹期议封禅，一随銮辂见燔柴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠山寺留题","author":"王禹称","text":"吟入惠山山下寺，古泉闲挹味何嘉。\n好抛此日陶潜米，学煮当年陆羽茶。\n犹负片心眠水石，略开尘眼识烟霞。\n劳生未了还东去，孤棹寒篷宿浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]