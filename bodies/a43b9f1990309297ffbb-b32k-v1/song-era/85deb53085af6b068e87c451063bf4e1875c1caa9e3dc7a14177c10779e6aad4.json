[{"title":"择之诵所赋拟吕子进元宵诗因用元韵二首 其一","author":"朱熹","text":"何处元宵好，山房入定僧。\n往来衣上月，明暗佛前灯。\n实际徒劳说，空华讵可凭。\n还教知此意，妙用一时兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之诵所赋拟吕子进元宵诗因用元韵二首 其二","author":"朱熹","text":"何处元宵好，寒龛独寐人。\n月窗同皎皎，灯镜自尘尘。\n静鉴通天地，潜思妙鬼神。\n却怜迷路子，狂走闹城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之梧竹二首并呈季通 其一","author":"朱熹","text":"竹坞深深处，檀栾绕舍青。\n暑风成惨淡，寒月助清泠。\n客去空尘榻，诗来拓采棂。\n此君同一笑，午梦顿能醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵择之梧竹二首并呈季通 其二","author":"朱熹","text":"永日长梧下，清阴小院幽。\n自怜风袅袅，客赋雨浏浏。\n作别今千里，相思欲九秋。\n更怜同社友，复此误淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之寄示深卿唱和乌石南湖佳句辄次元韵三首 其一","author":"朱熹","text":"未识南湖景，遥欣二子游。\n赏心并胜日，妙语逼清秋。\n剩欲携书卷，相将买钓舟。\n微吟归去晚，杜若满汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之寄示深卿唱和乌石南湖佳句辄次元韵三首 其二","author":"朱熹","text":"平湖渺空阔，积水暮生寒。\n但见绿千顷，不知深几竿。\n人间元迫隘，世路足艰难。\n若了沧洲趣，无劳正眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之寄示深卿唱和乌石南湖佳句辄次元韵三首 其三","author":"朱熹","text":"年来年去为谁忙，三伏炎蒸忽变凉。\n阅世谩劳心悁悁，怀人空得鬓苍苍。\n诗篇眼界何终极，道学心期未遽央。\n安得追寻二三子，舞雩风月共徜徉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小诗奉送择之仁友赴漕台之招后篇喜赵公之得士而不敢致私怨焉然别怀黯然不能成章亦足以见区区也二首 其一","author":"朱熹","text":"之子论交久，深衷两自知。\n提携方有赖，离索遽成悲。\n圣处应无数，书来肯见私。\n临分莫惆怅，努力共心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小诗奉送择之仁友赴漕台之招后篇喜赵公之得士而不敢致私怨焉然别怀黯然不能成章亦足以见区区也二首 其二","author":"朱熹","text":"珍重东台老，英声旧所闻。\n能怀吐哺意，岂但枉书勤。\n得士看如许，持心定不群。\n愿言推此志，清浊见朋分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"择之贤友归途左顾示以四明酬唱焕烂盈编三复咏叹想见聚游之乐辄用黄山即事之韵赋呈择之兼怀子重老兄顺之贤友","author":"朱熹","text":"十年身卧白云堆，已分黄尘断往回。\n不是幽人遗俗去，肯寻流水渡关来。\n三秋风月从头说，千里湖山觌面开。\n久欲过逢须一快，岂知劳结倍难裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜闻择之诵师曾题画绝句遐想高致偶成小诗","author":"朱熹","text":"一幅潇湘不易求，新诗谁遣送闲愁。\n遥知水远天长外，更有离骚极目秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次林扩之开善避暑韵二首 其一","author":"朱熹","text":"炎官虐焰遍山村，也到萧萧柳下门。\n水玉秋菰那可得，羡君行处午阴繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次林扩之开善避暑韵二首 其二","author":"朱熹","text":"山斋几日旱尘昏，欲拂朱弦已惮烦。\n凉意感君持寄我，雨声花思满胸存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林熙之诗五首 其一","author":"朱熹","text":"君行往返一千里，过我屏山山下村。\n浊酒寒灯静相对，论心直欲到忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林熙之诗五首 其二","author":"朱熹","text":"仁体难明君所疑，欲求直截转支离。\n圣言妙缊无穷意，涵泳从容只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林熙之诗五首 其三","author":"朱熹","text":"天理生生本不穷，要从知觉验流通。\n若知体用元无间，始笑前来说异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林熙之诗五首 其四","author":"朱熹","text":"十年灯火与君同，谁道年来西复东。\n不学世情云雨手，从教人事马牛风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送林熙之诗五首 其五","author":"朱熹","text":"古镜重磨要古方，眼明偏与日争光。\n明明直照吾家路，莫指并州作故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪用韩昌黎韵同彭应之作","author":"朱熹","text":"既有阳春曲，那无白雪谣。\n连天飞不断，著地煖还销。\n未掩高人户，难齐衲子腰。\n稍开银世界，渐长玉枝条。\n兴尽愁烟艇，行迷认野桥。\n酒肠浑欲冻，吟笔为谁摇。\n残腊成三白，馀寒又一朝。\n香随梅蕊落，轻伴柳花飘。\n神女羞捐佩，鲛人敢献绡。\n东皇应好事，避舍亦相饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次彭应之餐雪韵","author":"朱熹","text":"雪水瀹清茗，自谓绝世清。\n终然犯烟火，况复劳煎烹。\n岂如午霁馀，探此竹外楹。\n柘浆发甘和，宝盌凝寒晶。\n心胸既清凉，齿颊亦锵鸣。\n吞腥期永谢，饮玉希长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次彭应之鱼乐亭韵","author":"朱熹","text":"亭前活水破轻冰，渐见游鯈傍石棱。\n老子自知鱼乐处，不须庄惠与同登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与刘德明祝济之胡子宽晚步偶成","author":"朱熹","text":"雨罢寒逾劲，霜威正凛然。\n不知荒径湿，行到野桥边。\n旷望情何极，徘徊意莫传。\n清波涵众影，日落暗晴川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘德明彦集祝弟以夏云多奇峰为韵赋诗戏成五绝 其一","author":"朱熹","text":"出山几何时，归来便长夏。\n端居心不怡，散策长林下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘德明彦集祝弟以夏云多奇峰为韵赋诗戏成五绝 其二","author":"朱熹","text":"为客厌城市，还家辞世纷。\n朝昏何所见，但有四山云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘德明彦集祝弟以夏云多奇峰为韵赋诗戏成五绝 其三","author":"朱熹","text":"闭门事幽讨，岁月忽已多。\n客来无可问，与君共弦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘德明彦集祝弟以夏云多奇峰为韵赋诗戏成五绝 其四","author":"朱熹","text":"干时本已懒，胸次况亡奇。\n若问中林趣，婆娑祇自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘德明彦集祝弟以夏云多奇峰为韵赋诗戏成五绝 其五","author":"朱熹","text":"炎蒸不可柰，云气满前峰。\n向夕风吹尽，微闻远寺钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙洲新亭熹名以昼寒紫微张公为书其额判院刘丈乃出新句辄次高韵二首 其一","author":"朱熹","text":"闻说藤萝外，神龙旧所蟠。\n擘开千丈峡，写尽一襟寒。\n赏寄三杯酒，归投六尺竿。\n若无诗律好，清绝不成欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙洲新亭熹名以昼寒紫微张公为书其额判院刘丈乃出新句辄次高韵二首 其二","author":"朱熹","text":"悄茜非人境，寒蝉夏已稠。\n阳崖惊素雪，午扇怯清秋。\n共说新亭好，真堪妙墨留。\n赏心元不厌，仙梦肯来游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昼寒","author":"朱熹","text":"行穿危磴尽，林表见孤亭。\n涧泻千寻白，峰回四面青。\n尘襟元落落，风腋自泠泠。\n一醉今何许，无心赋独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次判院丈昼寒亭韵有怀平父","author":"朱熹","text":"把酒怀人处，幽寻记往时。\n新亭劳指顾，胜践阙追随。\n为报层檐出，莫忧浮柱攲。\n惟应旧飞雪，想象合心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次判院丈清湍之什","author":"朱熹","text":"明灭青罗带，周遭碧玉环。\n孤亭感陈迹，茂树喜重攀。\n爽气琴尊外，泉声枕簟间。\n诗成无写处，绝壁藓痕斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游密庵分韵赋诗得还字","author":"朱熹","text":"我行得佳友，胜日寻名山。\n春山既妍秀，清溪亦潺湲。\n行行造禅扉，小憩腰脚顽。\n穷探意未已，理策重跻攀。\n入谷翳蒙密，俯涧随泓湾。\n谁将百尺绡，挂此长林间。\n雄声殷地厚，洪源泻天悭。\n伟哉奇特观，偿此一日闲。\n所恨境过清，悄怆暮当还。\n顾步三叹息，人生何苦艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游密庵分韵赋诗得绝字","author":"朱熹","text":"闽乡饶奇山，仙洲故称杰。\n巍然一峰高，复与众山绝。\n传闻极目处，天水远明灭。\n万里倏往还，三光下罗列。\n我来发孤兴，径欲跻嵽嵲。\n病骨竟支离，何当攀去辙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵宿密庵","author":"朱熹","text":"忽作经宵别，胸奇莫与陈。\n暮归誇得句，寒苦顿生春。\n道义知无斁，文章自有真。\n它年应共说，此日自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游密庵","author":"朱熹","text":"弱龄慕丘壑，兹山屡游盘。\n朝隮青冥外，暮陟浮云端。\n晴岚染襟裾，水石清肺肝。\n俯仰未云已，岁月如飞翰。\n中年尘雾牵，引脰空长叹。\n旷岁一登历，心期殊未阑。\n矧此亲友集，笑谈有馀欢。\n结架迫弯埼，徙倚临奔湍。\n共惜前古秘，今为后来观。\n落景丽云木，回风馥秋兰。\n林昏景益佳，怅然抚归鞍。\n谅哉故山好，莫遣兹盟寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游昼寒以茂林脩竹清流激湍分韵赋诗得竹字","author":"朱熹","text":"仙洲几千仞，下有云一谷。\n道人何年来，借地结茅屋。\n想应厌尘网，寄此媚幽独。\n架亭俯清湍，开径玩飞瀑。\n交游得名胜，还往有篇牍。\n杖屦或鼎来，共此岩下宿。\n夜灯照奇语，晓策散游目。\n茗椀共甘寒，兰皋荐清馥。\n至今壁间字，来者必三读。\n再拜仰高山，?然心神肃。\n我生虽已后，久此寄斋粥。\n孤兴屡呻吟，群游几追逐。\n十年落尘土，尚幸不远复。\n新凉有佳期，几日戒征轴。\n宵兴出门去，急雨遍原陆。\n入谷尚轻埃，解装已银竹。\n虚空一瞻望，远思翻蹙恧。\n袒跣亟跻攀，冠巾如膏沐。\n云泉增旧观，怒响震寒木。\n深寻得新赏，一篑今再覆。\n同来况才彦，行酒屡更仆。\n从容出妙句，珠贝烂盈匊。\n后生更亹亹，俊语非碌碌。\n吾缨不复洗，已失尘万斛。\n所恨老无奇，千毫真浪秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻季通德明诸友入山以诗迎之仍请先往观瀑布","author":"朱熹","text":"胜友南窗底，看书老岁华。\n不因寒瀑响，肯到野僧家。\n古径开能久，新亭去岂赊。\n跻攀那可缓，寂寞有雄夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次观瀑布韵","author":"朱熹","text":"快泻苍崖一道泉，白龙飞下郁蓝天。\n空山有此真奇观，倚杖来看思凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和季通昼寒韵","author":"朱熹","text":"万壑争流处，千年树石幽。\n危亭因我作，胜日为君留。\n酒笑红裙醉，诗惭杂佩酬。\n尚嫌心境窄，更约九垓游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谒忠显刘公墓下","author":"朱熹","text":"理乱由来今古同，覆车那肯戒前踪。\n纷纷误国人无数，不昧丹心独此公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次季通昼寒亭韵二首 其一","author":"朱熹","text":"不信高怀与世殊，清游试问与谁俱。\n相将静听潺湲水，洗涤尘襟肯自污。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次季通昼寒亭韵二首 其二","author":"朱熹","text":"山行前后有光辉，扑扑浮岚翠染衣。\n直到仙洲奇绝处，昼寒亭下玉龙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饮清湍亭石上小醉再登昼寒","author":"朱熹","text":"水边今日共传杯，多谢殷勤数子来。\n三伏炎蒸那有此，百年怀抱顿能开。\n云山合匝还生雾，雪涧崩腾怒吼雷。\n却恨苍屏遮远日，凌风直欲跨蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次清湍亭韵二首 其一","author":"朱熹","text":"上下青山今白头，穿云入坞未能休。\n因君去觅仙洲路，却叹周南独滞留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次清湍亭韵二首 其二","author":"朱熹","text":"仄径穿林欲造天，未妨停策听涓涓。\n知君便有刀头意，莫忘仙洲涧底泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春大雪邀刘圭甫诸兄游天湖","author":"朱熹","text":"同云被四野，寒气惨悲凉。\n回风一以定，密雪来飘扬。\n时当冬候穷，开岁五日彊。\n蓬巷无与适，陟此琼台冈。\n宾友既追随，儿童亦携将。\n攀跻得冢顶，徙倚聊彷徨。\n俯视千里空，仰看万鹤翔。\n远迷乱峰翠，近失平林苍。\n偃薄瑩神骨，咀咽清肝肠。\n朗咏招隐作，悲吟黄竹章。\n古人不可见，来者谁能量。\n且复记兹日，他年亦难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次圭父游将军岩韵二首 其一","author":"朱熹","text":"极目危岑杳霭间，谁将层栋压巑岏。\n瘦筇上上莫辞远，绝境行行得细观。\n眢井尚馀茅绖处，考槃无复硕人宽。\n倦来拂石支拳睡，万壑吟风午梦阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次圭父游将军岩韵二首 其二","author":"朱熹","text":"陈迹真成俯仰间，回头犹认碧巑岏。\n更烦地主殷勤意，得尽云山表里观。\n景晏共愁归路远，年侵独负酒杯宽。\n明朝觅句酬珠玉，剩喜诗情却未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"圭父约为金斗之游次韵献疑聊发一笑","author":"朱熹","text":"几日春风未破寒，远峰晴露玉巑岏。\n不成蜡屐携筇去，且复钩窗拄颊观。\n闻道追游当作意，故应期日尚能宽。\n阴崖冻合无垂练，却恐诗翁兴易阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次彦集经营别墅之作","author":"朱熹","text":"回北成南指顾间，要令华敞对巑岏。\n家山信有千岩拥，云月何妨两处观。\n杰阁已资邻筑胜，新基还见缭墙宽。\n老仙鹤骨殊萧爽，归兴从今岂易阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦集圭父择之同饮白云精舍以醉酒饱德为韵熹分得饱字醉中走笔奉呈","author":"朱熹","text":"奔趋名利场，祸福急相绞。\n夜窗一反侧，肤垢纷两爪。\n岂知亲朋集，晚食聊一饱。\n心期共悠悠，文字各稍稍。\n华烛既屡更，诗肠亦频搅。\n寒更尽渠深，孤讽宁至卯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘圭甫和人梅花韵","author":"朱熹","text":"意行欲遍江村路，恰到诗人断魂处。\n梅花未肯笑春风，蔓草何须怨零露。\n归来四壁无馀声，俯槛祇有寒塘青。\n美人邂逅一笑粲，倒影的皪疏枝横。\n寸心久矣遗纷杂，不但老禅斋夏腊。\n此时悢悢欲何言，本根落落几难合。\n走遍诸君诗卷中，西湖东阁病还同。\n划然长笑惊梦破，碧云散尽山丛丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬圭父末利之作","author":"朱熹","text":"玉蕊琅玕树，天香知见薰。\n露寒清透骨，风定远含芬。\n爽致销繁暑，高情谢晓云。\n遥怜河朔饮，那得醉时闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬圭父白莲之作","author":"朱熹","text":"忽传夔府句，并送远公莲。\n翠盖临风迥，冰华浥露鲜。\n舞衣清缟袂，倒景烂珠躔。\n想象芙蓉阙，冥冥绝世缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次圭父观鱼韵","author":"朱熹","text":"平生三伏断追游，谁唤来穿涧树幽。\n初讶网横天影破，忽惊人蹴浪花浮。\n鸣榔不用齐吴榜，鼓枻何须学楚讴。\n便有金盘堆白雪，却怜清泚向东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉同黄子厚赋白芙蓉呈刘彦集平父","author":"朱熹","text":"湛湛曲池水，晓含风露清。\n田田绿罗盖，粲粲白玉英。\n澹然绝世姿，不与秾艳并。\n俯鉴冰雪影，讵怀儿女情。\n山中徒淹留，堂下空目成。\n独有忘机客，相看两无营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观洪遵双陆谱有感呈刘平甫范仲宣二兄","author":"朱熹","text":"近从新谱识枭卢，拟唤安阳旧博徒。\n只恐分阴闲过了，更教人诮牧猪奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘彦集木犀韵三首 其一","author":"朱熹","text":"众芳摇落九秋期，横出天香第一枝。\n莫似寒梅太孤绝，更交遥夜笛中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘彦集木犀韵三首 其二","author":"朱熹","text":"仙衣才试郁金黄，便觉秋风满院芳。\n定观极知先透彻，通心岂是故迎将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘彦集木犀韵三首 其三","author":"朱熹","text":"秋到寒岩桂树丛，小山吟罢思悲翁。\n不妨更作淹留计，占取人间十里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄谢刘彦集菖蒲之贶二首 其一","author":"朱熹","text":"君家兰杜久萋萋，近养菖蒲绿未齐。\n乞与幽人伴岑寂，小窗风露日低迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄谢刘彦集菖蒲之贶二首 其二","author":"朱熹","text":"泉清石瘦碧纤长，秋露悬珠炯夜光。\n个里无穷闲造化，别来谁与共平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"公济惠山蔬四种并以佳篇来贶因次其韵 ?","author":"朱熹","text":"灵草生何许，风泉古涧傍。\n褰裳勤采撷，枝箸嚏芳香。\n冷入玄根閟，春归翠颖长。\n遥知拈起处，全体露其常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]