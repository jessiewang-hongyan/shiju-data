[{"title":"书事","author":"朱熹","text":"重门掩昼静，寂无人境喧。\n严程事云已，端居秋向残。\n超摇捐外虑，幽默与谁言。\n即此自为乐，何用脱笼樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八月十七夜月","author":"朱熹","text":"忽忽秋逾半，清辉万里同。\n遥知竹林夜，共赏碧云空。\n寂寞盈尊酒，凄凉满院风。\n寒塘空自绿，不似小园东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆斋中二首 其一","author":"朱熹","text":"高斋一远眺，西南见秋山。\n景翳夕阴起，竹密幽禽还。\n赏惬虑方融，理会心自闲。\n谁料今为客，寥落一窗间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆斋中二首 其二","author":"朱熹","text":"蟋蟀乱秋草，故园风露深。\n何因不归去，坐使百忧侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕","author":"朱熹","text":"秋风桂花发，夕露寒螀吟。\n岁月坐悠远，江湖亦阻深。\n纷思宁复整，离忧信难任。\n终遣谁为侣，独此澹冲襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦山中故人","author":"朱熹","text":"风雨萧萧已送愁，不堪怀抱更离忧。\n故人只在千岩里，桂树无端一夜秋。\n把袖追欢劳梦寐，举杯相属暂绸缪。\n觉来却是天涯客，檐响潺潺泻未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀子厚","author":"朱熹","text":"中夏辞故里，涉秋未停车。\n宾友坐离阔，田园想榛芜。\n感兹风露朝，起望一烦纡。\n眷彼忘言子，郁郁西斋居。\n俯饮苍涧流，仰咏古人书。\n名应里闾荐，心岂荣利俱。\n琅然抚枯桐，幽韵泉谷虚。\n褰裳欲往听，乖隔靡所如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南安道中","author":"朱熹","text":"晓涧淙流急，秋山寒气深。\n高蝉多远韵，茂树有馀阴。\n烟火居民少，荒蹊草露侵。\n悠悠秋稼晚，寥落岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"垂涧藤","author":"朱熹","text":"寒泉下碧涧，古木垂苍藤。\n荫此万里流，闲花自层层。\n何人赏幽致，白发岩中僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临流石","author":"朱熹","text":"偃蹇西涧滨，枵然似枯木。\n下有幽泉鸣，上有苍苔绿。\n来往定何人，山空此遗躅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悬崖水","author":"朱熹","text":"秋天林薄疏，翠壁呈清晓。\n迢递泻寒泉，下有深潭悄。\n时飘桂叶来，寻源路殊杳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"穿林径","author":"朱熹","text":"屈曲上云端，似向崖阴断。\n行闻山鸟鸣，下与泉声乱。\n去去不知疲，幽林自成玩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日","author":"朱熹","text":"故国音书阻一方，天涯此日思茫茫。\n风烟岁晚添离恨，湖海尊前即大荒。\n薄宦驱人向愁悴，旧游惟我最颠狂。\n细思万石亭前事，辜负黄花满帽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"督役城楼","author":"朱熹","text":"天高无游气，林景澹馀晖。\n感此霜露节，但伤风土非。\n季秋时序温，百卉不复腓。\n祗役郊原上，暄风一吹衣。\n仕身谅无补，课督渐饥羸。\n还忆故园日，策杖田中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再至作","author":"朱熹","text":"荒城一骋望，落景丽谯门。\n隐隐钟犹度，依依岚欲昏。\n风霜非故里，禾黍但秋原。\n极目归来晚，兹怀谁与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚望","author":"朱熹","text":"禾黍弥平野，凄凉故国秋。\n清霜凝碧树，落日翳层丘。\n览物知时变，为农觉岁遒。\n不堪从吏役，憔悴欲归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苧溪道中","author":"朱熹","text":"秋山有红树，忽忆野田中。\n禾黍收将尽，氛埃晚欲空。\n登原悲落景，倚杖怯高风。\n更有寒塘水，应将此处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十月朔旦怀先陇作","author":"朱熹","text":"十月气候变，独怀霜露悽。\n僧庐寄楸槚，馈奠失兹时。\n竹柏翳阴冈，华林敞神扉。\n汛扫托群隶，瞻护烦名缁。\n封茔谅久安，千里一歔欷。\n持身慕前烈，衔训倘在斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词二首 其一","author":"朱熹","text":"扉景廓天津，空同无员方。\n丹晨舞七气，朵秀东渟房。\n餐吐碧琳华，仰噏飞霞浆。\n竦辔绝冥外，眄目抚大荒。\n策我绿轩軿，上际于浪沧。\n神钧亦寥朗，晻霭晨风翔。\n养翮尘波里，纵神非有亡。\n一乐无终永，千春讵能当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词二首 其二","author":"朱熹","text":"褰裳八度外，竦辔霄上游。\n轩观随云起，偃驾东渟丘。\n丹荑耀琼冈，三素粲曾幽。\n蹑景遗尘波，偶想即虚柔。\n盼目娱真际，不喜亦不忧。\n宴罢三椿期，颠徊翳沧流。\n千载何足道，太空自然畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"民安道中","author":"朱熹","text":"祗役东原路，长风海气阴。\n苍茫生远思，憭慄起寒襟。\n午泊僧寮静，昏投县郭深。\n拙勤终不补，谁使漫劳心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西郊纵步","author":"朱熹","text":"西郊一游步，极目是秋山。\n积水群峰碧，清霜枫树丹。\n故园心不展，投策讵能闲。\n且适平生意，无令双鬓斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄黄子衡","author":"朱熹","text":"远宦去乡井，终日无一欢。\n援琴不能操，临觞起长叹。\n我友客京都，肃肃云天翰。\n别去今几时，各在天一端。\n有酒不同斟，中情谁与宣。\n裁诗一问讯，重使心思传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"濯足万里流","author":"朱熹","text":"褰裳缘碧涧，濯足憩清幽。\n却拂千岩石，聊乘万里流。\n氛埃随脱屣，步武欲横秋。\n极目沧江晚，烟波殊未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤鹤思太清","author":"朱熹","text":"孤鹤悲秋晚，凌风绝太清。\n一为栖苑客，空有叫群声。\n夭矫千年质，飘飖万里情。\n九皋无枉路，从遣碧云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与诸同寮谒奠北山过白岩小憩","author":"朱熹","text":"联车涉修坂，览物穷山川。\n疏林汎朝景，翠岭含云烟。\n祠殿何沈邃，古木郁苍然。\n明灵自安宅，牲酒告恭虔。\n肸蚃理潜通，神虬亦蜿蜒。\n既欣岁事举，重喜景物妍。\n解带憩精庐，尊酌且留连。\n纵谈遗名迹，烦虑绝拘牵。\n迅晷谅难留，归轸忽已骞。\n苍苍暮色起，反旆东城阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀山田作二首 其一 冬日","author":"朱熹","text":"郊园多所乐，况此岁云暮。\n寒色澹遥空，清霜变红树。\n欲舒林表望，讵识尘中趣。\n向晚寂无人，氤氲欲成雾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀山田作二首 其二 梅花","author":"朱熹","text":"冰溪流已咽，阴岭寒方结。\n忽值早梅春，未恐芳心歇。\n的皪终自妍，殷勤为谁折。\n千里寄相思，相思政愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨二首 其一","author":"朱熹","text":"拥衾独宿听寒雨，声在荒庭竹树间。\n万里故园今夜永，遥知风雪满前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨二首 其二","author":"朱熹","text":"故山风雪深寒夜，只有梅花独自香。\n此日无人问消息，不应憔悴损年芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将理西斋","author":"朱熹","text":"欲理西斋居，厌兹尘境扰。\n发地得幽芳，斸石依寒筱。\n闲暇一题诗，怀冲独观眇。\n偶此惬高情，公门何日了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题金元鼎同年长泰面山亭","author":"朱熹","text":"抗心尘境外，结宇临秋山。\n乘高一骋望，表里穷遐观。\n众崿互攒列，连冈莽萦环。\n阳崖烟景舒，阴壑悲风寒。\n碧草晚未凋，林薄已复丹。\n仙人吴门子，岁晚当来还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬至阴雨","author":"朱熹","text":"愆阳值岁晏，忽复层阴结。\n一雨散霏微，千林共骚屑。\n端居遗簿领，远意怀幽洁。\n旷虑守微痾，殊方感新节。\n岂伊田庐念，丘垄心摧折。\n还登东领冈，瞻伫何由歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20173,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安溪道中泉石奇甚绝类建剑间山水佳处也","author":"朱熹","text":"驱车陟连冈，振辔出林莽。\n雾露晓方除，日照川如掌。\n行行遵曲岸，水石穷幽赏。\n地偏寒筱多，涧激淙流响。\n祗役未忘倦，心神暂萧爽。\n感兹怀故山，何日税征鞅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20174,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留安溪三日按事未竟","author":"朱熹","text":"县郭四依山，清流下如驶。\n居民烟火少，市列无行次。\n岚阴常至午，阳景犹氛翳。\n向夕悲风多，游子不遑寐。\n我来亦何事，吏乘古所记。\n奉檄正淹留，何当语归计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20175,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"安溪书事","author":"朱熹","text":"清溪流不极，夕雾起岚阴。\n虚邑带寒水，悲风号远林。\n涵山日欲晦，窥阁景方沉。\n极目无遗眺，空令愁寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20176,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花两绝句 其一","author":"朱熹","text":"溪上寒梅应已开，故人不寄一枝来。\n天涯岂是无芳物，为尔无心向酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20177,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花两绝句 其二","author":"朱熹","text":"幽壑潺湲小水通，茅茨烟雨竹篱空。\n梅花乱发篱边树，似倚寒枝恨朔风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20178,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柚花","author":"朱熹","text":"春融百卉茂，素荣敷绿枝。\n淑郁丽芳远，悠飏风日迟。\n南国富嘉树，骚人留恨词。\n空斋对日夕，愁绝鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20179,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病告斋居作","author":"朱熹","text":"层阴霭已布，小雨时漂洒。\n独卧一窗间，有怀无与写。\n高居生远兴，春物弥平野。\n虑旷景方融，事远情无舍。\n聊寄兹日闲，尘劳等虚假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20180,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感事有叹","author":"朱熹","text":"荣华难久恃，代谢安可量。\n宿昔堂上饮，今归荒草乡。\n高台一以倾，穗帐施空房。\n繁弦既阙奏，缓舞亦辍行。\n桃李自妍华，春风自飘扬。\n恋幄靡遗思，更衣有馀芳。\n身徂名亦灭，事往恨空长。\n寄语繁华子，古今同一伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20181,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日","author":"朱熹","text":"凉气集幽树，清阴生广庭。\n偶兹憩烦燠，忽忆郊园行。\n婉娩碧草滋，迢递玄蝉鸣。\n官曹且休暇，自适幽居情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20182,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜叹","author":"朱熹","text":"秋风淅沥鸣清商，秋草未死啼寒螀。\n幽人幽人起晤叹，仰视河汉天中央。\n河汉西流去不息，人生辛苦何终极。\n苍山万叠云气深，去鍊形魂生羽翼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20183,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茅舍独饮","author":"朱熹","text":"出身从吏役，驱车涉穷山。\n日落阴景晦，天高风气寒。\n岂无斗酒资，独酌谁为欢。\n一杯且复醉，百念中阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20184,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿传舍见月","author":"朱熹","text":"空堂寒夜月华清，独宿凄凉梦不成。\n欲向阶前舞凌乱，手持杯酒为谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20185,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄诸同寮","author":"朱熹","text":"把酒江头烟雨时，遥知江树已芳菲。\n应怜倦客荒茅里，落尽梅花未得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登罗汉峰","author":"朱熹","text":"休暇曹事简，登高恣窥临。\n徜徉偶此地，旷望披尘襟。\n落日瞰远郊，暮色生寒阴。\n欢娱未云已，更欲穷幽寻。\n行披茂树尽，豁见沧溟深。\n恨无双飞翼，往诣蓬山岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登面山亭","author":"朱熹","text":"新亭夙所闻，登眺遂兹日。\n极目但苍茫，前瞻如有失。\n烟鬟稍呈露，众岭方含郁。\n长啸天风来，云散空宇碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双髻峰","author":"朱熹","text":"绝壑藤萝贮翠烟，水声幽咽乱峰前。\n行人但说青山好，肠断云间双髻仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涉涧水作","author":"朱熹","text":"幽谷溅溅小水通，细穿危石认行踪。\n回头自爱情岚好，却立滩头数乱峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试院即事","author":"朱熹","text":"端居惜春晚，庭树绿已深。\n重门掩昼静，高馆正阴沈。\n披衣步前除，悟物怀贞心。\n澹泊方自适，好鸟鸣高林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借王嘉叟所藏赵祖文画孙兴公天台赋凝思幽岩朗咏长川一幅有契于心因作此诗二首 其一","author":"朱熹","text":"翩然乘孤鹤，往至苍崖巅。\n上有桂树林，下有清泠渊。\n洗心咏太素，汎景窥灵诠。\n栖身托岁暮，毕此岩中缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借王嘉叟所藏赵祖文画孙兴公天台赋凝思幽岩朗咏长川一幅有契于心因作此诗二首 其二","author":"朱熹","text":"山空四无人，涧树生凉秋。\n杖策忘所适，水木娱清幽。\n散发尘外飙，濯足清瑶流。\n静啸长林内，举翮仍丹丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其一 天门冬","author":"朱熹","text":"高萝引蔓长，插楥垂碧丝。\n西窗夜来雨，无人领幽姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其二 红蕉","author":"朱熹","text":"弱植不自持，芳根为谁好。\n虽微九秋干，丹心中自保。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其三 扶留","author":"朱熹","text":"根节含露辛，苕颖扶楥绿。\n蛮中灵草多，夏永清阴足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其四 竹","author":"朱熹","text":"种竹官墙阴，经年但憔悴。\n故园新绿多，宿干转苍翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其五 榴花","author":"朱熹","text":"窈窕安榴花，乃是西邻树。\n坠萼可怜人，风吹落幽户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其六 萱草一","author":"朱熹","text":"春条拥深翠，夏花明夕阴。\n北堂罕悴物，独尔澹冲襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其七 萱草二","author":"朱熹","text":"西窗萱草丛，昔是何人种。\n移向北堂前，诸孙时绕弄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其八 独觉","author":"朱熹","text":"端居春向残，夏气已清穆。\n睡起悄无人，风惊满窗绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂记草木九首 其九 浇花","author":"朱熹","text":"晨起独行园，花药发奇颖。\n犹嫌坠露稀，更汲寒泉井。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观黄德美延平春望两图为赋二首 其一","author":"朱熹","text":"川流汇南奔，山豁类天辟。\n层甍丽西崖，朝旦群峰碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观黄德美延平春望两图为赋二首 其二","author":"朱熹","text":"方舟越大江，凌风下飞阁。\n仙子去不还，苍屏倚寥廓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祠事斋居听雨呈刘子晋","author":"朱熹","text":"刀笔常时箧笥盈，斋祠今喜骨毛清。\n与君此日俱无事，共爱寒阶滴雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王季山赴龙溪","author":"朱熹","text":"故人千石令，便道此之官。\n契阔三秋永，逢迎一笑欢。\n田园知不远，谣俗问非难。\n已想躬玄默，鸣弦亦罢弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"之德化宿剧头铺夜闻杜宇","author":"朱熹","text":"王事贤劳只自嗤，一官今是五年期。\n如何独宿荒山夜，更拥寒衾听子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵傅丈题吕少卫教授藏书阁","author":"朱熹","text":"西楼谁与共闲居，茂树婆娑清昼馀。\n大隐祇今同一壑，行吟非昔似三闾。\n揣摩心事惟黄卷，料理家传亦素书。\n更凿寒泉供漱石，世纷不拟问焉如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次旬父韵","author":"朱熹","text":"五字何人寄，锵鸣满袖金。\n剧知多暇日，谁与共幽寻。\n簿领淹穷海，莺花绕故林。\n功名终好在，且莫负初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次祝泽之表兄韵","author":"朱熹","text":"裸裎相向但悠悠，信道乾坤日夜浮。\n此去安心知有法，向来示病不难瘳。\n优游静室闲窗底，放浪东阡南陌头。\n万事何由到怀抱，夕阳芳草自春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]