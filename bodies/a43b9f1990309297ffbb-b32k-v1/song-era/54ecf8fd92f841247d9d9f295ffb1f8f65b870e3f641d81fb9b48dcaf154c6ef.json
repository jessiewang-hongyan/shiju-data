[{"title":"题禁中黄石榴二首 其二","author":"曹勋","text":"安石开花比御衣，绉红繁绿不能奇。\n上林别有娇黄贵，如剪冰绡衬玉肌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题禁中黄石榴二首 其一","author":"曹勋","text":"榴花昔染猩猩血，薝卜丛中今斗新。\n何事司花与纯素，不同妖艳污天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题谯干钓雪图","author":"曹勋","text":"四山飞雪正漫漫，蓑笠何人把钓竿。\n六月披图方执热，风随玉麈不胜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题潮州黄岗驿","author":"曹勋","text":"旱作颠风日日吹，冬来浑似麦秋时。\n土人尚畏生炎瘴，北客闻时泪可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"襄事毕次旧题韵","author":"曹勋","text":"坎临四正峙重峦，前直平田一顷宽。\n中有佳城揖东注，万松深密障朝寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居","author":"郑起","text":"久欲谋归力不任，浮云踪迹谩巢林。\n功名未入屠龙手，贫贱常怀买鹤心。\n月下开门微雨过，楼头闻笛二更深。\n世间万事俱陈迹，空倚西风阅古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月","author":"曹勋","text":"三月春如年少时，了知造化最儿嬉。\n智行无事柳飞絮，道发自然花满枝。\n锦绣园林添富贵，神仙院落斗清奇。\n老夫长似春三月，游戏人间不皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十日","author":"杨万里","text":"才看桃李锦成围，忽便园林绿作堆。\n远草将人双眼去，飞花引蝶过墙来。\n簿书节里无多著，怀抱朝来得好开。\n已是七分春去了，何须鸟语苦相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其八","author":"曹勋","text":"客路逢寒食，欣同不系舟。\n闲中聊适性，要地固抽头。\n不作扬州梦，何能贾客留。\n壮怀今断断，世事任悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其七","author":"曹勋","text":"客路逢寒食，禾秧出已齐。\n清溪三汊浅，白鹭一行低。\n禊饮心何在，茅峰路恐迷。\n随时随有乐，何处不幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其六","author":"曹勋","text":"客路逢寒食，浙西春事稀。\n日华藏暖景，天气未单衣。\n歌棹喧椎鼓，桃花巧映扉。\n空收麰麦粉，药病岂心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其五","author":"曹勋","text":"客路逢寒食，山光触处新。\n取鱼多样网，舣岸几州人。\n默尔非无住，超然得任真。\n今年卦气尽，四顾欲何亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其四","author":"曹勋","text":"客路逢寒食，光阴亦可惊。\n如何介子节，再过阖庐城。\n列岫遥逾碧，群芳晚更明。\n饭馀风力壮，掀舞小舟轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其三","author":"曹勋","text":"客路逢寒食，犹寻禦腊衣。\n群芳须暖景，昽日尚寒晖。\n馀力求闲早，劳生昨梦非。\n荠花浑似雪，蝴蝶梦中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其二","author":"曹勋","text":"客路逢寒食，清明未到家。\n起居须药饵，饮食任鱼虾。\n水净垂垂柳，风迟艳艳花。\n兴来随处乐，不复问年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上塘值清明八首 其一","author":"曹勋","text":"客路逢寒食，划船闹水干。\n娇云易得雨，暴冷不成寒。\n白水连天去，繁桃触目看。\n朝来有家信，稚子报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与李先生学士","author":"曹勋","text":"先生声彻大明宫，顾肯驰驱与俗同。\n但得琴书娱白日，何须鞭帽犯朝风。\n未容倦客寻源去，应谓斯人底死穷。\n它日云林陪杖屦，款承愿辈嗫嚅翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与曾侍郎","author":"曹勋","text":"里巷风和递晓驺，高轩见顾识英猷。\n挥犀唾玉闻乡语，对酒看花话旧游。\n殊喜故家青玉案，方承大问翠云裘。\n愿持相业天钧上，箕颍重为第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久别黄虚中忽会又别二诗道意 其二","author":"曹勋","text":"蘋满烟沙柳满洲，绿荷风软转船头。\n归篷亟作恁么去，许事肯令如是休。\n自有文章追洛下，莫缘誉处厌糟丘。\n君能坐致钱流地，行达通明十二旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久别黄虚中忽会又别二诗道意 其一","author":"曹勋","text":"汪汪陂量有家声，文擅区中世典刑。\n别去十年头已白，相逢一日眼犹青。\n君裁短后姑假道，我访内丹殊不经。\n萝月风棂传古锦，无令簿领困周星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨三首 其三","author":"曹勋","text":"一旬连夜雨，人物困泥中。\n竹树侵书暗，横流趁路通。\n灶烟薪更湿，檐溜耳难聪。\n润逼衣襟重，何时日照东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨三首 其二","author":"曹勋","text":"蚀馀仍苦雨，犹尔晦阳晖。\n浩浩陂三尺，家家水半扉。\n汩陈非佛意，昏垫盖天机。\n祈恳须冥造，当仁要达微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久雨三首 其一","author":"曹勋","text":"五月正阳月，何尝与雨期。\n浃旬檐溜注，深夕水声驰。\n古屋床床漏，苔墙堵堵隳。\n子桑谁复饷，勾漏政须医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小三侄远持兄嫂之命见访于荒寒寂寞中将归二诗为别 其一","author":"曹勋","text":"投老台山麓，松篁筑靓幽。\n行年今七十，抚事几春秋。\n但喜亲情话，难忘为小留。\n山川烦跋履，事事见操修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小三侄远持兄嫂之命见访于荒寒寂寞中将归二诗为别 其二","author":"曹勋","text":"不见小阮久，相看情甚温。\n肯来成宅相，端可大吾门。\n暖日长江路，梅花细雨村。\n真成好兄弟，言谢却忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园午集坐间呈处和瞻明诸友","author":"曹勋","text":"共向花时笑语频，不须七七倩花神。\n中郎棋战投机捷，阁老诗坛著语新。\n暖景迟迟莺唤友，落英寂寂草成茵。\n牡丹芍药开非晚，更约同游浩荡春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中","author":"曹勋","text":"告老吾君得挂冠，交亲犹肯问平安。\n连天秋色雁已过，满槛竹声风逗寒。\n对客杯盘心共醉，催人节物岁将阑。\n但知适意山林去，不觉山头行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中二首 其二","author":"曹勋","text":"人间久矣倦迎逢，归路牛羊带夕舂。\n千点梅沉山店月，一溪烟咽寺楼钟。\n穷犹羞涩巉岩面，老自平夷磊磈胸。\n曾笑古人多晚谬，草庵虽小幸相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中二首 其一","author":"曹勋","text":"山中从事亦贤劳，安得眠云独自高。\n两席地栽青紫芥，一株树接碧红桃。\n春风多可移花性，夜雨无声入土膏。\n那办工夫到诗句，溪灯穿屋未编茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四","author":"曹勋","text":"山中四序景，巧供晨夕间。\n茶瓯不少辍，诗魔常畏闲。\n生计付风雨，年华寄毛颜。\n支筇正独立，栖禽相与还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十一","author":"曹勋","text":"雨急怨春晚，花残独稔香。\n燕巢方稳密，蝶翅觉凄凉。\n引睡漫支枕，销闲时炷香。\n新晴故晚照，芳草留斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十九","author":"曹勋","text":"冷趁西风便，云趋南国深。\n相舂闻野唱，漂絮击溪砧。\n小立迟残照，闲愁倦寸心。\n新亭有耆旧，应共惜花阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十六","author":"曹勋","text":"林泉久自得，窗户向深幽。\n不复嫌村酒，何能有客愁。\n夕阳烘远水，飞絮挟轻鸥。\n杖屦归从晚，柴门月一钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十八","author":"曹勋","text":"平生有知旧，相望顿以疏。\n卧念十日雨，谁寄一行书。\n景已来白雁，诗漫如黄初。\n不忘剡溪棹，且策雪中驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十五","author":"曹勋","text":"寂历斜阳岸，高低犹涨痕。\n轻舟随浪稳，远水带烟昏。\n野色几番换，乔林何处村。\n情怀了无事，安得易销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十六","author":"曹勋","text":"平日为饱役，方抛世网婴。\n买鱼沽市酝，借姓过州城。\n老脱尘中境，心游物外清。\n寒溪行不尽，端为濯衣缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十八","author":"曹勋","text":"秋色遂将半，游云时淡浓。\n水光影䆉稏，秀色增芙蓉。\n斸地种三径，钩窗来五峰。\n新晴何以卜，一意听晨钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十一","author":"曹勋","text":"得闲一何乐，佳处先徜徉。\n每扣隐逸士，屡过清静坊。\n地僻干戈远，年丰禾稻香。\n访我亦何所，南涧与东冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十五","author":"曹勋","text":"寂历秋风晚，闲庭落叶深。\n天高晴日澹，山净暮烟沉。\n疾病无时已，年华有底侵。\n两行南去雁，一片北归心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十七","author":"曹勋","text":"连日山村雨，牛羊都在栏。\n低田渍积水，卧穗铺新寒。\n气逼琴丝润，香传岩桂丹。\n天光惜垄亩，应放月团团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十四","author":"曹勋","text":"老去情怀懒，翛然只此翁。\n闲窗千里月，修竹一帘风。\n事与孤鸿远，心将止水同。\n故人如问讯，痴坐正观空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仆至赤城英侍者见访好语澜翻喜以成诗","author":"曹勋","text":"闲中忙事厌营营，款段扬鞭访赤城。\n问法未经双涧路，弥天先见万年英。\n繁阴成幄暑风薄，好草传香朝雨晴。\n杖屦何妨留一宿，松间语旧有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双溪云老寄示佳句及新茶用来韵为谢","author":"曹勋","text":"老去光阴不问春，只思麋鹿与为群。\n每求书附风前雁，便想山深日暮云。\n铅椠尘劳应念我，诗章棋局久思君。\n新茶仍副清新句，碌碌粗官愧少文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天台宰祈雨有感","author":"曹勋","text":"炎风踰月炽穹苍，稼穑如云已变黄。\n令尹为民躬血恳，神龙奋雨破骄阳。\n高低禾颖芃芃秀，垄亩风回细细香。\n自尔屡丰应课最，西成先可贺仓箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆梅","author":"曹勋","text":"江云暗江路，曾向玉川家。\n冷入参差玉，香随的皪花。\n照溪回夜色，冒雪冠春华。\n犹记西窗伴，寒枝片月斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无锡得次子诗促归","author":"曹勋","text":"老大心情不外求，得闲欢喜且闲休。\n每思尘土年华老，欲接神仙汗漫游。\n三月不知春烂熳，五旬却值雨飞浮。\n催归又诵吾儿句，便且呼童上小舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王元龙惠新制辄依末后耘田韵叙谢","author":"曹勋","text":"雕章琢句茂家声，如阅龙跳读快晴。\n秀韵凌虚天外立，春熙及物坐中生。\n只应翳凤游八极，但觉仪韶闻九成。\n愿看浯溪擅文学，要收功业付耆英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风雨惊春","author":"曹勋","text":"一年春事急如流，每被颠风断送休。\n锦瑟华筵常漫度，杏园景物只供愁。\n须知胜践何曾阙，自是青春不少留。\n遍倚栏干望归路，落花飞絮思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐未央","author":"曹勋","text":"孝武初封禅，萝图宝历新。\n开边擢卫霍，儒术用平津。\n礼乐追三统，钦承奉百神。\n嵩呼膺万寿，欢乐讵容陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"出关","author":"曹勋","text":"笋舆清晓出都门，便喜松声到处闻。\n可但佳游今止止，试寻旧友只纷纷。\n卑栖故传吴楚语，高意自同鸾鹤群。\n且乐退身无挂碍，满襟尘土逐春云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其七","author":"曹勋","text":"金柔火老转清商，已近蟾华冉冉光。\n尚有微云遗暑湿，不妨森木作新凉。\n壶中自有洞天阔，物外每同春日长。\n愿得身藏箕斗内，白蘋红蓼水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其六","author":"曹勋","text":"雨后秋风十日阴，罗衣初觉晓寒侵。\n清愁强欲亲欢伯，瘦骨何能举聚针。\n碧玉丽词残照晚，青楼秀色暮云深。\n中郎好句传茅屋，端比逃虚喜足音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其五","author":"曹勋","text":"归涂只欲自治荒，久习田间兴益长。\n插稻方能骑秧马，触藩遽复叹羝羊。\n乍为事夺愧俯仰，却得公来时举扬。\n更待凉风下天末，醉看墨妙写淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其四","author":"曹勋","text":"向来小筑久锄荒，更觉闲中日月长。\n山脚孤烟迷市井，冈头斜照下牛羊。\n乘槎未喜闲侵汉，骑鹤何求再上扬。\n简寂新诗清有素，雨随击节助浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其三","author":"曹勋","text":"长歌山水五风霜，翠竹青松是巨防。\n每谓肉身求净观，犹胜饭袋绕诸方。\n因风老叶闲粘网，久雨新苔巧占墙。\n何以待宾馀旧贯，一香一饭一胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其二","author":"曹勋","text":"老境光阴怯雨霜，怕寒窒隙似猜防。\n养生饱悟风中烛，卜宅闲寻肘后方。\n明世渔樵终混迹，故山猿鹤怨循墙。\n天台肯约它年隐，半岭松风殷夜床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"台城杂诗七首 其一","author":"曹勋","text":"卜筑城隅久罢休，数椽忽得水西头。\n四围竹色缭寒碧，一径杉风留素秋。\n门外水天分棐几，天边桂子入帘钩。\n指踪尽得神仙客，更乞佳名为榜不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"处和有诗欲过小圃","author":"曹勋","text":"小园花木暖成围，况复轩窗倚翠微。\n一槛海棠云锦展，四边山色晓烟飞。\n春风烂熳何妨醉，浊酒淋漓任满衣。\n甚喜鸣珂肯相访，济川暂舣绿苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊子正月廿一日雪及半尺","author":"曹勋","text":"晚讶争鸣白项鸦，梅风随夜冷窗纱。\n忽惊寒透多年被，不儗潜飞六出花。\n历乱已应藏月桂，模糊无处认山茶。\n朝来多怪寻芳客，都向东风卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用李参政韵并录寄舟峰师四首 其四","author":"曹勋","text":"海色琉璃照我肝，何疑飞电掣晴岩。\n山留画鹢风从怒，珠炯翔龙夜亦衔。\n莲社经徒能摘句，玉川茶兴自开缄。\n从来筏喻今饶益，杯渡须知鄙铁帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用李参政韵并录寄舟峰师四首 其三","author":"曹勋","text":"昔年壮气激肠肝，锦带吴钩鄙隐岩。\n喜试轻裘裁白纻，笑追落日试重衔。\n愁随草色人千里，谁附文期信一缄。\n会待腥膻扫巢穴，舳舻北首挂征帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用李参政韵并录寄舟峰师四首 其二","author":"曹勋","text":"世间群盗脍人肝，避地方图水石岩。\n客有绿林嗟路阻，书无黄耳欲何衔。\n雨推溪柳金方重，春入江梅玉半缄。\n永念陆趋今弗获，垂云安得倚天帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用李参政韵并录寄舟峰师四首 其一","author":"曹勋","text":"峙玉层冰瑩肺肝，秉钧风节素岩岩。\n交河谕旨师无战，榆塞宣恩俗旧衔。\n成算已功休大树，洞章咏志发幐缄。\n斯篇疾读林宗意，快甚长风破浪帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵书田间晚步","author":"曹勋","text":"寓居萧寺憩衰迟，得酒宁论浊与醨。\n闲里风光常自喜，暑中人事弃如遗。\n一溪烟水渔乡后，万叠苍山月上时。\n竹杖芒鞋田岸久，稻花细细岁丰姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵言归","author":"曹勋","text":"梅风欲转白蘋洲，一笑忘怀接胜流。\n公已吉祥求止止，我方奔走觅休休。\n故山应有猿鹤怨，壮节但随蒲柳秋。\n荐读公诗固三叹，从今可但破牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵酬陈判官","author":"曹勋","text":"刺桐花发照人明，三看薰风舞绛英。\n海近鱼肥随米贱，山高溪净照人清。\n久闻射策先黄甲，何意栖鸾尚赤城。\n顾我婆娑老林下，看君事业映簪缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]