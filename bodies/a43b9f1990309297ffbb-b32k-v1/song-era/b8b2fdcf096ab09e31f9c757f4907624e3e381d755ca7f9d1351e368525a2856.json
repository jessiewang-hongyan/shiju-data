[{"title":"断桥春望","author":"王镃","text":"拾翠车閒辇路尘，山南山北杜鹃春。\n谁家庭院东风里，飞出桃花不见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晨起","author":"王镃","text":"青山云影乱交加，漱齿泉香带落花。\n自扫丹房看候火，旋添异草养灵砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花三首 其三","author":"王镃","text":"野水桥边折得看，花头开尽雪痕乾。\n刚风摇动仙云坠，一夜香深玉骨寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花三首 其二","author":"王镃","text":"溪心印影月朦胧，树剥霜皮一半空。\n只见开时冰雪冻，不知花里有春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花三首 其一","author":"王镃","text":"茅屋寂寂烟冥冥，纸帐晓眠人未起。\n天风吹动笛声寒，春满江南冰雪里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中见","author":"王镃","text":"鹤发老人携紫竹，往来花下歌春曲。\n春去春来花自开，一声杜宇巴山绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨花","author":"王镃","text":"一身娇韵倚东风，骨腻肌香易粉融。\n好向晓光垂露看，杨妃梳洗出唐宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深春 其一","author":"王镃","text":"夹泥花上燕巢边，翠箔桑空蚕又眠。\n天气才晴风候别，坐看盆藕出双钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"深春 其二","author":"王镃","text":"燕子来时春又休，暖风吹绿上枝头。\n绣帘不隔荼蘼月，香影无人自入楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父吟","author":"王镃","text":"竹丝篮里白鱼肥，日落江头换酒归。\n只恐明朝江雪冻，老妻连夜补蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜二首 其二","author":"王镃","text":"落在空中似雨飞，成花因被紧风吹。\n销金帐掩红娇处，暖护歌声醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜二首 其一","author":"王镃","text":"松屋篝灯伴夜阑，闭门不管雪花寒。\n调朱旋滴梅瓶水，读过唐诗再点看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜凉","author":"王镃","text":"吹笛何人在小楼，夜深不下玉帘钩。\n凉风敲落梧桐叶，片片飞来尽是秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑夕三首 其三","author":"王镃","text":"夜深月晒碧荷香，傍水亭台易得凉。\n更剪遮窗蕉叶去，放教山影入藤床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑夕三首 其二","author":"王镃","text":"枕石云边睡一场，藓花泉洞碧松香。\n朱门正役风车苦，不识山中有此凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑夕三首 其一","author":"王镃","text":"草蚊声歇树鸣螀，碧汉无人夜气凉。\n起向翠炉更宿炭，一丝沉水有残香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楮衾","author":"王镃","text":"霜藤捣出杵声乾，软白同绵一样看。\n春借梅花香入梦，雪深茅屋不知寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十五","author":"王镃","text":"灵液长流满地香，洞中多是散仙房。\n金炉煮就金精汁，欲献元君未敢尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十四","author":"王镃","text":"三尸魄重药难医，一个丹瓢一剑飞。\n历尽大罗天下路，无人肯吃又藏归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十三","author":"王镃","text":"华山九节玉菖蒲，千度秋风叶不枯。\n洞里久餐松乳餍，秦人还识此根无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十二","author":"王镃","text":"金光倒射玉楼台，海上仙人采药回。\n花下閒谈尸解事，葛翁忽跨白驴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十一","author":"王镃","text":"游遍蓬莱到水都，龙宫书请注龙书。\n月明长啸独归去，海上行乘赤鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十","author":"王镃","text":"偶巡三岛过瀛洲，閒把新绛系海虬。\n忽报词臣当直日，灵风吹到五云楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十九","author":"王镃","text":"朝罢群仙退玉墀，天风吹绉六铢衣。\n左慈閒戏神仙术，五色霞杯绕洞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十八","author":"王镃","text":"看了金书看水流，刚风吹鬓不知秋。\n碧瞳仙过天河去，戏擘云衣作綵舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十七","author":"王镃","text":"夜半瑶宫上会开，龙车声轧凤飞来。\n演穷灵宝玄元法，大梵天仙带月回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十六","author":"王镃","text":"全家童女在云边，都是人间得道仙。\n甲子无穷春不老，研金写尽蕊珠篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十五","author":"王镃","text":"西母瑶池宫殿高，夜明帘捲玉丝绦。\n隔云听得东方笑，三度曾偷碧树桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十四","author":"王镃","text":"昨夜三清醮罢迟，步虚声逐翠云飞。\n小仙自向人间去，留得青词袖里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十三","author":"王镃","text":"懒向东溟钓碧波，醉时自唱太平歌。\n银竿插在灵河畔，閒把龙须作玉蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十二","author":"王镃","text":"珊瑚老树百花开，玉色灵泉滴翠崖。\n弹罢瑶琴黄鹤至，紫泥湿透藕丝鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十一","author":"王镃","text":"玉蕊亭边集翠娥，琅璈声和万年歌。\n月斜酒散天风冷，鸾鹤翩跹渡绛河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其十","author":"王镃","text":"醉归紫府月流光，霞色仙衣散异香。\n閒把玉箫吹一曲，九天风露欲飞霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其九","author":"王镃","text":"扁上金书洞府名，沉沉珠树綵云轻。\n碧桃风捲箫声去，弄玉乘鸾看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其八","author":"王镃","text":"绿鬓毛姑翠羽衣，口中犹自说秦时。\n琼丝小筥无人见，藏有麟洲五色芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其七","author":"王镃","text":"瑶阶晴日弄轻红，扫地湘童立晓风。\n金锁沉沉春洞寂，玉琴声出落花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其六","author":"王镃","text":"百万仙兵护帝车，宝光云篆自成书。\n庞刘元在天医院，雷祖时差过玉虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其五","author":"王镃","text":"龙楼凤阁起霞光，阙下排班待玉皇。\n惟有栾巴来得晚，满身犹带酒痕香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其四","author":"王镃","text":"月斜天路晓风清，缥缈云开见玉城。\n无数小仙参阙罢，相逢只是说长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其三","author":"王镃","text":"宝花如雨落龙楼，上界遥观下界秋。\n金凤一声天欲晓，银河光趁月西流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二","author":"王镃","text":"金钟三响紫微宫，玉树烟飘辇路风。\n彩凤已衔仙诏去，九天朝罢五云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其一","author":"王镃","text":"紫云缭绕玉城开，张许真人入奏台。\n大帝正签雷雨事，宝函捧出又回来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其三十三","author":"王镃","text":"月娥树上赤花香，羽帐琼楼子夜长。\n玉兔白蛙身不老，水银一臼结玄霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其三十二","author":"王镃","text":"修成功行满三千，或在人间或在天。\n留下九还丹一粒，城南老树得升仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其三十一","author":"王镃","text":"天花子落月中楼，香满三千世界秋。\n下有老人常斫树，至今玉斧不曾修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其三十","author":"王镃","text":"龙脑包薰满洞香，韩湘酒熟在瑶缸。\n几番醉怕春云暖，閒却鲛绡紫石窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十九","author":"王镃","text":"仙令王乔面玉墀，天香薰透绿荷衣。\n谁知脚底青丝舄，化作双凫傍日飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十八","author":"王镃","text":"金甲雷丁出巽宫，丹幢翠节拥灵童。\n五更飞去雌雄剑，一夜盐池碧水红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十七","author":"王镃","text":"飞佩乘风海上游，麟洲有路透炎州。\n仙人养就千年鼠，时采长毛织火裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游仙词三十三首 其二十六","author":"王镃","text":"天诏旌阳上玉宫，功成鸡犬亦无踪。\n独留铁柱难飞去，要锁东溟老毒龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上","author":"王镃","text":"万红飞尽雨如烟，心事伤春哭杜鹃。\n游子不来弦管歇，画船空系柳丝边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上晚望","author":"王镃","text":"酒醒湖光生嫩凉，卧船吹笛藕花香。\n游人尽逐莺花去，一片閒情在夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖边夏日即事","author":"王镃","text":"榴花掩映在楼台，面面轩窗照水开。\n一路翠萍分未合，采莲船去钓船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫极宫","author":"王镃","text":"拜章台上月如霜，云湿阑干面面凉。\n道士醮归秋夜净，满身薰得紫藤香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"裁衣曲","author":"王镃","text":"烧罢心香午夜阑，玉纤轻捻剪刀寒。\n衣成恐不如郎意，独著灯前照影看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢靳石门道箓见访","author":"王镃","text":"石门仙人云霞裳，飘飘飞佩来山房。\n松间看鹤不相见，灵风满路馥天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感事","author":"王镃","text":"海门烟树晓青青，梦断英雄唤不醒。\n多少骷髅山下泪，定随潮转浙江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪村即事二首 其二","author":"王镃","text":"春深水暖鳜鱼肥，腰筥山童采蕨归。\n一路蜜蜂声不断，刺花开遍野蔷薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪村即事二首 其一","author":"王镃","text":"村村绿树起青烟，隔岸行人叫渡船。\n昨夜不知何处雨，水推枯叶出溪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪村晚望","author":"王镃","text":"宿鹭分行落照边，村藏深树远吹烟。\n天然诗句无人识，划记寒沙抄一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睡海棠","author":"王镃","text":"费尽胭脂捻得成，杨妃醉后越娉婷。\n定应梦著三郎事，吹老春风不肯醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜀葵","author":"王镃","text":"片片川罗湿露凉，染红才了染鹅黄。\n花根疑是忠臣骨，开出倾心向太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春即事","author":"王镃","text":"卖花声断雨濛濛，怯酒情怀易得中。\n燕子自来还自去，胭脂吹老海棠风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜻蜓","author":"王镃","text":"轻绡剪翅约秋霜，点水低飞恋野塘。\n忽趁游蜂过墙去，可怜不识百花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏雪寻梅","author":"王镃","text":"探春绕遍玉阑干，香暗冰痕屐齿寒。\n怕有花头遭冻损，枝枝呵手掐来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题友人诗集","author":"王镃","text":"学诗玄妙似参禅，又似凡人去学仙。\n吟得悟时皮骨换，一天风露响灵蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕","author":"王镃","text":"野棠开后忽飞来，又趁秋风海上回。\n到国依栖应有梦，巢空月落旧楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠星士","author":"王镃","text":"我命梅花好与同，生来清苦雪霜中。\n易堂有历曾推算，才得春风运便通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠棋士","author":"王镃","text":"我为诗穷子亦穷，两穷相遇说飘蓬。\n记从活处寻高著，莫泥区区死局中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠雷相士","author":"王镃","text":"心事分明说与君，功名已付峡西云。\n只须相我穷吟骨，清比唐人得几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"露荷","author":"王镃","text":"满湖云气晓生寒，蘸影蒸香润石阑。\n万斛银珠无用处，翠盘擎到日光乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中","author":"王镃","text":"荣枯皆定数，枉作送穷吟。\n有色非真画，无腔是古琴。\n青松秦世事，黄菊晋人心。\n尘外烟萝客，相寻入远林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中述怀柬详议梅涧四弟","author":"王镃","text":"春入青山伴白云，市朝新事不曾闻。\n心无利欲愁都散，路有仙凡悟便分。\n夜月蕉花秦世梦，寒烟草子宋时坟。\n抽丁不到空林客，自采枫香礼斗君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"王镃","text":"屋头藓树蜕鸣蛩，池上沟泉凿石通。\n香老蒲花春洞影，凉生槲叶午窗风。\n泥瓶开酒留樵客，箬笠穿云访药翁。\n虽是一贫清似水，定无徭役到山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居即事 其一","author":"王镃","text":"选定唐诗手自编，醒时消遣醉时眠。\n家家云气山藏雨，处处蛙啼水满田。\n松树倒生临涧影，竹根斜挂过墙鞭。\n客来无可延清话，旋摘新茶瓦鼎煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居即事 其二","author":"王镃","text":"閒居却笑俗人忙，又欲移门向野塘。\n午爨松脂粘斧腻，晓行云气湿衣凉。\n长生瑶草成丹药，万岁灵藤结紫香。\n林下知心时有月，黄昏相伴入藜床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀","author":"王镃","text":"处世功名莫躁为，识时机变在防危。\n吉凶有数曾参易，胜负无心不著棋。\n事向直中多骨突，人于财上重交知。\n后车能悟前车覆，箴警何须座右碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尹绿坡閒吟所","author":"王镃","text":"苔痕分路见人家，犬护篱根卧落花。\n一片林塘诗境界，四时花果隐生涯。\n锄山拣日春栽药，汲水和云夜煮茶。\n耕录有文须点看，旋摇松露入朱砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]