[{"title":"野菊涧","author":"曾协","text":"泠泠清涨濯秋芳，采撷堪供九日觞。\n为乞晓瓶真沆瀣，不应眉寿独南阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游罨画溪 其三","author":"曾协","text":"罨画声名远近知，水光花影巧相宜。\n不知此去几多日，重见斓斑似旧时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游罨画溪 其二","author":"曾协","text":"罨画溪头事已空，桑条都逐运斤风。\n东君绿遍当时岸，只欠低垂照水红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游罨画溪 其一","author":"曾协","text":"春去无踪绿满堤，空移征棹过涟漪。\n自惊朱墨抽身晚，不及青红倒影时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫岩杂咏 飞瀑","author":"曾协","text":"欲作银河落，支筇仰面看。\n会须雷电散，已觉逼人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫岩杂咏 坳池","author":"曾协","text":"峭绝崩云处，泓澄忽此逢。\n宁知一勺水，清润入千峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫岩杂咏 留烟","author":"曾协","text":"暝色苍然至，浮烟漫不分。\n小留岩窦底，为伴宿檐云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫岩杂咏 溅石","author":"曾协","text":"淅沥排炎暑，潺湲弄晚晴。\n不知来远近，常作对床声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡足轩","author":"曾协","text":"落尽庭花日未西，枝间栩栩定为谁。\n遥知城市纷纷际，正是幽人睡足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"督几先画","author":"曾协","text":"北固江山自有馀，不分清景到绳枢。\n凭君笔底真三昧，幻出云烟入坐隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题留烟亭","author":"曾协","text":"漠漠萦空漫不收，只应此地占清幽。\n云烟本是无心物，亦为山人重挽留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题零陵郡治环翠亭","author":"曾协","text":"铃索无声讼牒稀，雨馀四野竞扶犁。\n小亭独坐心无事，满地绿阴山鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凝香径","author":"曾协","text":"白葛乌纱一径长，心清草木自成香。\n何须炉里烟成缕，不用衣间紫作囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醒心亭","author":"曾协","text":"主人谁与解春酲，百斛香醪一小亭。\n兀兀泠泠俱可乐，醒来还醉醉还醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"薝卜林","author":"曾协","text":"可人浓翠护微黄，宝树森森自著行。\n居士饭馀无一事，坐来还印寂然香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卫公堂二首 其二","author":"曾协","text":"寥寥相望两邦君，冰雪襟怀锦绣文。\n身见共誇新令尹，名高犹榜故将军。\n神交顿觉千年近，心远初无一间分。\n只有玄谈探佛海，坐倾端复掩前闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卫公堂二首 其一","author":"曾协","text":"卫公精爽故依然，陈迹凄凉不记年。\n亭远谩传曾起草，楼高无复见筹边。\n新铭初勒风烟上，旧观都忘岁月迁。\n从此南徐矜胜概，美谈留与后生传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王叔武示和人雪诗次韵二首 其二","author":"曾协","text":"回瞻一色暮云垂，痴雀相看冻不飞。\n地辟烂银窥佛界，班连万玉想天威。\n轻明照日千山静，寒碧浮江一棹归。\n见说孤吟清到骨，知君不羡妓成围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王叔武示和人雪诗次韵二首 其一","author":"曾协","text":"天上琼花次第垂，且教微霰向尘飞。\n玉糅重见娇飞燕，鹤舞初疑老令威。\n农事预知三径乐，钓舟遥忆五湖归。\n梦回陡觉衾裯薄，应是迷空一尺围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王叔武示忠州张使君德远近诗次韵三首 其三","author":"曾协","text":"安心今得法，问道旧名庵。\n雅致追庞老，高风数泐潭。\n远公容入社，弥勒本同龛。\n寄语邦人道，丛林始罢参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王叔武示忠州张使君德远近诗次韵三首 其二","author":"曾协","text":"妙理居言外，高怀见酒边。\n无心千里奉，有意一灯传。\n柏树谁能指，虚空莫问年。\n炉香聊闭閤，何处觅心田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王叔武示忠州张使君德远近诗次韵三首 其一","author":"曾协","text":"垂绅立朝著，智略胜吾丘。\n列戟分名郡，儿童说细侯。\n卷舒谁挂碍，中外且嬉游。\n闻说淮南守，天边又拜州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人上平江徐侍郎五首 其五","author":"曾协","text":"哦诗献寿信知难，门馆材多不可攀。\n敢曳长裾居客右，祇容滥吹列行间。\n为陵便恐轻深谷，若砺还应誓泰山。\n千载通明宫殿里，常看冠佩压清班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人上平江徐侍郎五首 其四","author":"曾协","text":"巍峨冠冕耸精神，好傍轩墀对紫宸。\n一德拟推黄帝筴，纪年还数绛人旬。\n悬知紫诏驰三节，肯使朱轓驻两轮。\n闻说邦人称寿处，香云低覆玉嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人上平江徐侍郎五首 其三","author":"曾协","text":"双旌来自日华边，帝遣衔恩下九天。\n膏泽已周家十万，道途不叹驿三千。\n封疆旧占江湖阔，驩颂新从里巷传。\n可是圣朝私此地，教将和气作丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人上平江徐侍郎五首 其二","author":"曾协","text":"汉朝法从让严徐，却数群公总不如。\n千载流芳传竹简，一言偃革见囊书。\n由来东海传高阁，复见甘泉载后车。\n富贵功名两相似，昆丘元自产璠玙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代人上平江徐侍郎五首 其一","author":"曾协","text":"秋到人间敛曲尘，于门初见矞星辰。\n须知宇内风云合，况是天边雨露新。\n盛德可容窥底蕴，殊功端自见经纶。\n不应久袖安邦手，运指从教转大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代常州请平江郑侍郎","author":"曾协","text":"接壤西东似犬牙，一时迎送使君车。\n应怜壮岁棠阴在，未觉神京驿路赊。\n飞观惯看凉月挂，层楼将见瑞云遮。\n当筵莫诉杯行速，两地春光作一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正卿借韵招同社候雨霁访梅次韵","author":"曾协","text":"看梅常拟到参横，最爱微霜堕太清。\n轻棹幽探烦结约，繁花乱点要晴明。\n直须香里同扶杖，莫问尊前几举觥。\n谁向诗盟最先歃，定知一座自公倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次沈韵","author":"曾协","text":"独将春信报天涯，岂是无情定有知。\n巧占岁寒怜韵胜，冥搜诗句愧辞枝。\n松篁有约成三友，桃李争功彼一时。\n珍重休文三昧手，尽回佳处入清诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵二首呈士秀 其二","author":"曾协","text":"锦囊惠我句增奇，赏会应须得子期。\n万顷渊深连渤澥，千寻巉刻对峨眉。\n心游旧简几忘食，家有名园不暇窥。\n谁报诗人春到了，屋山应有候禽知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵二首呈士秀 其一","author":"曾协","text":"相逢此日胜平生，不厌支筇数送迎。\n乐地共欣三径就，诗坛仍见一军惊。\n风飘柳线曾经染，雪著梅梢分外清。\n光景唤人无计奈，剩烦佳句破愁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有翼有诗督真率第二会次韵","author":"曾协","text":"满眼春光处处山，妨人行乐几多端。\n绝怜玄圃一步地，便胜香山八节滩。\n莫放赏心闲里过，拟将物化静中观。\n未开桃李留春事，可是芳苞不耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次赵有翼简徐圣可元韵","author":"曾协","text":"已向幽居赋晚晴，欲经绝壁访神清。\n不忧五柳荒松菊，敢叹三闾带杜蘅。\n□无风月三千首，赖有丝桐一再行。\n谁似孔庭能父子，继挥高韵思如倾。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翁士秀见赠二首 其二","author":"曾协","text":"兴来蹑履便追随，共约乘风汗漫期。\n述作正须陶令手，利名不上紫芝眉。\n名高似斗谁能挹，量大如渊不可窥。\n老去故交今绝少，高情倾盖乐新知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵翁士秀见赠二首 其一","author":"曾协","text":"川原积岁阻交情，佳客常思置驿迎。\n花县论心尊俎乐，竹宫识面岁时惊。\n久知书作征南癖，更觉诗同东野清。\n却敛櫜鞬真退舍，君才屹立五言城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢郑仲南惠诗二首 其二","author":"曾协","text":"腰组归来且打乖，阖庐才可著吾侪。\n可堪佳客寻衰迹，更著新诗起壮怀。\n枉对青山记排闼，好当红药咏翻阶。\n一从悟得惊人句，自悔枚皋赋似俳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵谢郑仲南惠诗二首 其一","author":"曾协","text":"毫端万态斗森严，山比崇高粟比纤。\n学博自应前辈似，才多真可万人兼。\n心传家法书仍在，腹有成章笔未拈。\n雄辩纵横皆正论，却羞季子尚飞钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李懋之壶中斋请赋诗","author":"曾协","text":"山川吞尽一壶中，未见先生芥蒂胸。\n要识广输藏粟粒，且将谈笑举针锋。\n橘中载酒初无碍，花里行车足有容。\n可但大千归眼界，网尘从此现重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈正卿示探梅诗次韵","author":"曾协","text":"数点微明已露奇，解颜相见却先知。\n携壶拟醉无穷树，走马来看第一枝。\n照水意闲真我辈，酿寒云重正花时。\n自从亲识春风面，不信良工画有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈正卿重梅次韵","author":"曾协","text":"恰占春工一倍奇，休言造化总无私。\n香罗剪透因稠叠，瑴玉裁成却附离。\n爱玩枝头无限思，题评笔下若为辞。\n开时纵晚春犹早，底事游蜂圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵衮臣挽诗二首 其二","author":"曾协","text":"幼年耆旧识东床，壮岁名喧翰墨场。\n老去里闾推闻望，向来士子诵文章。\n芊绵宿草悲春尽，牢落佳城怨夜长。\n赖有集贤多故旧，笔端三绝刻琳琅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邵衮臣挽诗二首 其一","author":"曾协","text":"轩冕初期咳唾收，一官白首叹淹留。\n已嗟游宦骞腾晚，遽遣功名取次休。\n中寿不令周甲子，遗编曾拟传春秋。\n未应埋没随黄壤，定作骑鲸汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈晞颜董漕湖南过零陵用简斋韵见赠次韵谢之又赋一篇述怀 其二","author":"曾协","text":"平生志不在赢馀，久拟挥毫赋遂初。\n莫问倚墙空甔石，但令盈几足琴书。\n幸存茅屋幽堪隐，况有清溪近可渔。\n剩欲抽簪访松菊，要凭突兀看扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈晞颜董漕湖南过零陵用简斋韵见赠次韵谢之又赋一篇述怀 其一","author":"曾协","text":"笔到钟王意有馀，诗章高古过黄初。\n班行未上论思地，远使聊宣宽大书。\n乞与丰年均饱煖，更申严令绝侵渔。\n肯迂使节存支郡，咫尺犹嫌会面疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王雅州见赠","author":"曾协","text":"怀人俄复几春秋，三舍相望见末由。\n千骑前驱催首路，九重侧席纳嘉谋。\n茅茨至陋何堪顾，蘋藻虽微尚可羞。\n准拟扫除迎上客，玉蕤阴底列觥筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史志道侍郎 其三","author":"曾协","text":"兴来小渡唤方舟，霁色天教足胜游。\n但觉赏心追昔事，不知飞诏下皇州。\n班行便觉九天近，登览何辞一日留。\n悬想他时百僚上，亦思清景几回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史志道侍郎 其一","author":"曾协","text":"经行荦确看嶙峋，曳履枝筇蹑后尘。\n自是高怀元落落，向来喜色见津津。\n宜搜今古风流远，得助江山句法新。\n好逐秋风上霄汉，却留盛事付州人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和史志道侍郎 其二","author":"曾协","text":"簿书堆案阻寻幽，想像高人物外游。\n自昔品题多北客，故知物象胜中州。\n云经乱石馀膏润，烟过悬崖自去留。\n暂俯澄潭倚苍壁，已疑身世在鳌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李粹伯","author":"曾协","text":"万事知公一发轻，尚怜花草唤愁生。\n酒边意气来酣战，笔下文章要主盟。\n绝唱共惊神有助，擅场将见敌无争。\n总输老子工藏拙，饱食安眠百不营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈晞颜春尽思归二首 其二","author":"曾协","text":"小白长红几番飞，清诗端为解愁围。\n莫贪藉草寻幽事，须念留花苦待归。\n杜酒政须常在手，沈腰元自不胜衣。\n织成春恨无穷尽，谁遣天孙不下机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈晞颜春尽思归二首 其一","author":"曾协","text":"坐阅荣枯鸟过空，青冥谁解指行踪。\n柳边初见莺调舌，树底俄惊鹿养茸。\n称副闲身清昼永，装添静境绿阴浓。\n宫桃正倚东风醉，也逐回沟出九重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和俞几先喜雨二首 其二","author":"曾协","text":"自嗤宦况局寒蝉，已觉归心决大川。\n勿使山灵长谢客，幸馀溪友旧忘年。\n无心欲羡千钟禄，有意初谋二顷田。\n雨足年丰无一事，春蚕将老只思眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和俞几先喜雨二首 其一","author":"曾协","text":"万人望岁正艰难，坐对盘餐泚在颜。\n沿溯谩谈舟楫利，圃畦未放桔槔闲。\n欢呼甘雨今朝足，准拟丰年旧观还。\n眼里尘氛扫除尽，扑人空翠绕西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒋子尚","author":"曾协","text":"偶随舶趠上淮州，忽见霜凝尚此留。\n屡指云天谈故国，几从烟水理归舟。\n自知客子惊残岁，赖有斯人破旅愁。\n他日西窗剪银烛，巴山却话梦中游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和韩子文","author":"曾协","text":"寄迹惊殊县，论诗得胜流。\n更容参往返，不恨此淹留。\n绝唱终三叠，长谣拟四愁。\n同游有陶谢，莫赋仲宣楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和裘父见赠二首 其二","author":"曾协","text":"乡关重见慰馀年，踉蹡迎门喜欲颠。\n先遣好诗陈曲折，更搜馀论尽中边。\n尚勤药石论臣佐，莫向杯觞近圣贤。\n杜口不言穷达事，知君客疾不难痊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和裘父见赠二首 其一","author":"曾协","text":"平生传业志诗书，常耻朱门衒绮襦。\n作意文场旋阁笔，强颜宦路亦分符。\n骎骎春意回平野，戛戛篮舆入画图。\n但恐相思劳小阮，想从烟际望重湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜饮枕流次日以诗记陈迹","author":"曾协","text":"水轩幽会六人同，夜色苍茫蜡炬红。\n淅淅好风天似水，纷纷高论气如虹。\n罚筹猬起觞无算，醉骨山颓榼屡空。\n却坐胡床看月上，对人楼殿有无中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昔先君子与司直兄相知文字间诸孤悬隔各未相闻一旦裘父侄惠然见访共道家庭旧好抚今念昔慨然伤怀因成小诗呈裘父","author":"曾协","text":"传业悬知臭味同，许时踪迹马牛风。\n莫誇今夕为何夕，不见吾翁对若翁。\n道旧几惊心欲折，问年俱恨鬓成蓬。\n只应饱学非同调，满箧新诗字字工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俞义仲挽诗","author":"曾协","text":"适意平生水竹居，雌黄在手为藏书。\n久看英子声名早，常恐良朋过往疏。\n方喜安舆迎綵袖，忽惊平陌走丧车。\n青松翠柏新阡路，常使行人泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总司官饯董少卿","author":"曾协","text":"蚤闻天诏下江津，元是君王自赏音。\n阔步稳登霄汉路，借留难副士民心。\n缓歌共有留连意，别酒休辞潋滟斟。\n三节踵来公去后，空馀离恨一江深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵有翼招同社出游次韵","author":"曾协","text":"总道无情却有情，撩人幽事不胜清。\n拟同骚仆从长吉，不遣橘奴觅李衡。\n四山浓淡要题品，百卉后先宜按行。\n登览不忧风雨迫，挥戈须驻日西倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送向兄荆父帅维扬二首 其二","author":"曾协","text":"大父曾开刺史天，固应陈迹尚依然。\n邦人却怪家风在，故老今推宅相贤。\n仗钺秉旄仍置使，轻裘缓带更安边。\n须知此日分忧重，更觉光荣掩后前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送向兄荆父帅维扬二首 其一","author":"曾协","text":"宠数频烦色愈温，耐官丞相克家孙。\n川原迤逦提封阔，旌纛森严上将尊。\n心识古人风节似，望知前辈典刑存。\n春风草绿长淮净，眼看频流雨露恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张忠州使君八兄二首 其二","author":"曾协","text":"东阁如公不挽留，又飘征袖入西州。\n四方谩说多奇士，千骑才教占上头。\n那得长绳萦去棹，不堪淋雨助离愁。\n长江自古常东注，莫遣仙舟得溯流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]