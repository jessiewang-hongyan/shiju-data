[{"title":"送东上人","author":"释道璨","text":"上头上面得人憎，少见生狞个样僧。\n莫道无又轻放过，病来无力举乌藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛野鹤子侄过洛阳秋壑制使","author":"释道璨","text":"笙鹤孤云宿子围，写诗阿买已能诗。\n旧时先友今谁贵，红叶花开有牧之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起和徐处士并寄致轩二首 其二","author":"释道璨","text":"读易年深眼易花，尚馀心力到诗家。\n日长更有幽忧病，临罢兰亭品建茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起和徐处士并寄致轩二首 其一","author":"释道璨","text":"卧闻开到碧桃花，病起情怀属自家。\n报到春风无可得，呼童洗鼎煮新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读陆云西志供定城墓有感书呈子勉总干三首 其三","author":"释道璨","text":"一艇东来公已仙，午天花柳为谁妍。\n深培根本存生意，把握春风有阿连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读陆云西志供定城墓有感书呈子勉总干三首 其二","author":"释道璨","text":"到家差晚两眉颦，直气轮囷吐未伸。\n却恨青山埋骨早，不教眼见洛阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读陆云西志供定城墓有感书呈子勉总干三首 其一","author":"释道璨","text":"汲水伤多井水浑，刈葵放手损葵根。\n不能误国宁归去，无愧忠宣直下孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十二","author":"释道璨","text":"北人偶与南人会，借问如何吃荔枝。\n口未开时先话堕，香甜二字且酬伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十六","author":"释道璨","text":"篷底攲眠醉复醒，君山只在两眉青。\n浑家不管兴亡事，一味和云看洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十三","author":"释道璨","text":"京师出大黄，价直极相当。\n未曾识道地，枉自费商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其十二","author":"释道璨","text":"堂奥虽深无锁钥，包容大地与山河。\n草窠里辊人多少，唤不回头争奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其三","author":"释道璨","text":"一言已出驷难追，道了如何悔得来。\n冷地被人相讦露，牙关咬定口慵开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其六","author":"释道璨","text":"夺得胡儿马便休，何须抵死觅封侯。\n草鞋直挂龙床角，争似山间煨芋头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其二","author":"释道璨","text":"心心急要入岩隈，不合谈禅信口开。\n引得王臣多爱重，遮回又被捉将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其五","author":"释道璨","text":"睚到虚空粉碎时，空花一任眼前飞。\n若还别觅安心法，客路漫漫何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十二","author":"释道璨","text":"释迦弥勒是他奴，二十年来心胆粗。\n甘与魔王为眷属，休将恶语张荼糊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其八","author":"释道璨","text":"箭穿杨叶未为亲，透得金尘有几人。\n多谢汾阳曾说破，重阳九日菊花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十二首 其十","author":"释道璨","text":"土木场中辊一回，平生己眼豁然开。\n广寒宫殿无关钥，撞破髑髅归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其十五","author":"释道璨","text":"漏尽夜沉沉，山房风露深。\n无云生岭上，有月落波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十八首 其五","author":"释道璨","text":"自小离家住日边，去家只道路三千。\n从人问得来时路，回首元来在目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"商山四皓赞","author":"释道璨","text":"橘大天地窄，眼高秦汉小。\n一片隐沦心，商山青未了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄无闻知侍者","author":"释道璨","text":"手把黄花语后期，孤山雪后早梅时。\n春风不管人无信，又要吹香上北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题高大清东村","author":"释道璨","text":"浮花浪蕊易飘零，看著桑麻眼便青。\n荷锸归来春昼永，案头重读相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼延庆教僧","author":"释道璨","text":"灯火青青照夜堂，诵经辛苦早年亡。\n白莲花发秋池上，谁住池边旧日房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山问竹","author":"释道璨","text":"坐对青青仔细看，别来且喜尚平安。\n山中岁晚风霜恶，不易孤标耐得寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"超师房","author":"释道璨","text":"岩桂花开满院香，青莎叶底有鸣螀。\n人家只在西林住，鸡犬声中又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"释道璨","text":"青青岸草绿于袍，雨后江流数尺高。\n庭院日长春睡足，幽兰花底读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摘茶","author":"释道璨","text":"拈一旗兮放一鎗，多从枝叶上抟量。\n全身入草全身出，那个师僧无寸长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题水墨草虫","author":"释道璨","text":"蜻蜓低傍豆花飞，络纬无声抱竹枝。\n忆得西湖烟雨里，小园清晓独行时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题物初蕙兰","author":"释道璨","text":"花短秋意长，神清颜色少。\n笔端有西风，国香来未了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题信国墨梅","author":"释道璨","text":"太耐冰霜老玉关，北风满面不知寒。\n无边生意天难泄，春色教人纸上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠相士","author":"释道璨","text":"面如生铁铸昆崙，有底荣枯到你论。\n谩说青青亭畔竹，春风几个有儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠禅客","author":"释道璨","text":"空拳打入长蛇阵，杀气连云战更酣。\n辊到了无交涉处，牛头向北马头南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖除夜","author":"释道璨","text":"又来上国看新元，细嚼梅花咽冷泉。\n阿母在家年六十，孤儿为客路三千。\n身居东海沧波上，心在西山落照边。\n碧户朱门杨柳岸，不知归日是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和山泉喜雪","author":"释道璨","text":"高下随风自在吹，纵横万里急还迟。\n园林顷刻生春意，天地中间有此奇。\n深入重城垂缚处，不持寸刃令行时。\n夜来竹外生盈尺，冻损梅花人未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和云壑","author":"释道璨","text":"纷纷世事几昏明，仙计还山又未成。\n欲学种松消永日，不徒煨芋博虚名。\n云开衡岳鹏程阔，秋入鄱阳雁影清。\n也欲摩挲病来眼，春风暖处望前旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓讲书","author":"释道璨","text":"杨柳阴阴水一涯，无边天地入窗纱。\n土阶过雨苔生润，竹径无人草自花。\n圣处工夫期我立，吟边生活赖成家。\n夜来梦泛沧浪水，两袖清风钓岸沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯叔炎梅桂二首 其二","author":"释道璨","text":"风露透枝叶，团团翠满坡。\n但教秋思足，不必月明多。\n骚在谁招隐，山空自放歌。\n故家射科手，折取莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯叔炎梅桂二首 其一","author":"释道璨","text":"色香俱第一，知己是华光。\n风味嫌肤浅，精神贵敛藏。\n一生虽抱独，千古却流芳。\n若论调羹事，还他一日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君泽谢主簿","author":"释道璨","text":"掉臂纷纷桃李场，声名暴耀急收藏。\n春风未解瞻颜色，落月长思满屋梁。\n大学十年心独苦，天门一疏日争光。\n弟兄千载诗书泽，染得人间草木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴山泉知府","author":"释道璨","text":"乱来谁访古，杖屦竹边闻。\n小立真堪画，閒谈亦自文。\n长翁千载语，中允百年坟。\n寂寞庐山下，幽寻独有君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨在轩剂院","author":"释道璨","text":"箭下曾亲一鹄来，一蓑风雨霅川回。\n近诗不逐唐声变，燕服多依晋样裁。\n竹屋逢僧閒煮茗，梅边领客惯行杯。\n终当夜直金鸾去，要试平生倚马才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈东庐提干","author":"释道璨","text":"发白为忧时，思家日念归。\n涉春问行李，隔岁理征衣。\n夜雨翻书屋，秋风把钓矶。\n叮咛旧僮仆，拂拭藓痕微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和春谷赵泉使贺端斋赵宪使喜雪","author":"释道璨","text":"蕊宫仙子下明湖，剪水桃花更滴酥。\n洁白十分天下瑞，光明一片剡溪图。\n园林春到何嫌早，阊阖云开不待呼。\n方寸去天才尺五，笑他上界觅玄都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和恕斋吴提刑秋阳庵居","author":"释道璨","text":"截断人间名利尘，横塘深碧护新坟。\n昏明不定霜天月，开合无心竹屋云。\n风雨对床差可喜，乾坤万事不堪闻。\n栽松种竹閒功课，却为忧时一半分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致轩赵使君午日读骚","author":"释道璨","text":"君王爱不均，不信问江滨。\n却是一江水，能知千载人。\n仲连宁蹈海，百里忍之秦。\n先死依兰芷，还他不二臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致轩送余魁","author":"释道璨","text":"眉睫功名气，笔端天地春。\n孰知心念苦，祇与圣贤亲。\n味淡有真乐，眼高无古人。\n金鸾行夜直，坐听漏声频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和菊隐陈知县西庵有感","author":"释道璨","text":"轻云卷雨过檐牙，杨柳池塘合乱蛙。\n四壁月华春夜永，一年风物此时嘉。\n诗当淡处工差退，心到平时语不誇。\n睡眼醒来人不见，杏花散影满窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢君泽题弋阳桃花寺并吊郑盘翁","author":"释道璨","text":"一曲清溪十二阑，分明常在画中安。\n千年药灶和云暖，五色丹光彻夜寒。\n魂梦不来怀好友，山居能久是苍官。\n葛翁颜色红如染，不信桃花树上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和谢君直新除史馆检阅","author":"释道璨","text":"久矣常峨豸角冠，未应上缀史臣班。\n名高自是难推去，才大如何爱得閒。\n斋阁不须垂绛帐，精神留取上蓬山。\n散人梦落沧浪外，白鸟冥冥去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和腾可赵司户","author":"释道璨","text":"可人久别喜逢迎，分坐南窗晓放晴。\n竹所多时无此乐，梅兄一笑让渠清。\n字如晋样神饶韵，诗比唐人语更精。\n隽永韦编有真味，更须分我一杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺恕斋除兵部侍郎","author":"释道璨","text":"面无老色气精明，南海归来住未成。\n不道山中无宰相，要从恕上做功名。\n云屯万骑西风急，月浸三更夜柝清。\n谋国定知有长算，胡雏不树向南旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送松冈黄提干","author":"释道璨","text":"人物如公岂久淹，极和平处极森严。\n无心为禄长思去，直道从人肯避嫌。\n学务躬行惟恐失，贫于未仕不言廉。\n书边大有閒田地，有口从今只学钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭冯深居常簿","author":"释道璨","text":"泛宅江湖上，萧萧两鬓皤。\n祇知衣可典，不厌客来多。\n文富家安有，名高实若何。\n身前身后事，令我起悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致轩赵使君领客及妻子入山即事原韵","author":"释道璨","text":"戴家湖上宅，近市有山林。\n雨足四郊润，云低尽日阴。\n竹疏和翠减，松老受春深。\n留得行窝住，楼头午漏沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪山泉登芝山和文正公旧韵","author":"释道璨","text":"培塿视崔巍，眼高如许哉。\n举头天在上，四面景皆来。\n渐老成多病，看山又一回。\n尽供诗世界，霁色为君开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞 其二","author":"释道璨","text":"明皎皎，暗昏昏。\n未曾举首，烁破面门。\n若更停机停思，苦哉弥勒世尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞 其二","author":"释道璨","text":"如屿兮媚川，如山兮倚天。\n大哉圆通之道，民无得而名焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒拾赞 其二","author":"释道璨","text":"淡墨磨虚空，秃笔蘸沧海。\n点污天台山，是他这一对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月窟","author":"释道璨","text":"凿开浑沌窍，豁见天地根。\n举瓢酌桂浆，引足蹈昆崙。\n湛然一精明，身外无乾坤。\n我欲从之游，云深入无门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水月轩","author":"释道璨","text":"江水清无底，江月明如洗。\n开轩浥清明，道人清若此。\n春风不摇江面波，春云不载江头雨。\n天地无尘夜未央，照影轩中惟自许。\n我来风雨夜漫漫，水月俱忘无表里。\n笑拍阑干问阿师，水在月兮月在水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙巢海棠洞","author":"释道璨","text":"领客坐花阴，饮客酌花露。\n先生自家春，八荒一牖户。\n凄其望前修，一枝阅世故。\n鹤车来不来，东风吹日暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰溪夜泊","author":"释道璨","text":"我泛浙西船，夜泊兰溪岸。\n篷窗坐不眠，县鼓鸣夜半。\n桥上趁墟人，往来彻清旦。\n办此朝夕劳，不博一日饭。\n复毡睡正煖，闭户有人嫌夜短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"半身达磨赞","author":"释道璨","text":"毒药医不活，风雪冻不死。\n自己欠一半，说甚传宗旨。\n天自天，地自地，枉自东游十万里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吕洞宾赞","author":"释道璨","text":"提起绦头，垂下衣袖。\n信脚阔步行，亲见黄龙后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦","author":"释道璨","text":"我不识灵溪，梦向溪边去。\n溪绕屋头流，桥通溪上路。\n轩窗水面开，水清石无数。\n煮茶僧请诗，茶香竹当户。\n花笺晕浅红，霜毫脱毛兔。\n引笔信手书，波峭含韵度。\n置笔喜语客，眼明失沉痼。\n梦觉秋满床，残月挂庭树。\n病眩二十年，万花舞深雾。\n梦中能楷书，以我心念故。\n人生孰非梦，百年等是寓。\n便欲驱车去，傍溪缚茅住。\n但恐秋雨来，溪深不可渡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其一","author":"释道璨","text":"头小面狭，眼横鼻直。\n难亲易忘，易见难识。\n刚道笑翁手脚缓慢，无准痴绝，尺寸短窄。\n视秦山乔岳不过一拳，视长江大河不过一滴。\n西天此土要横行，有祖以来无此僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞 其二","author":"释道璨","text":"读书不识字，行脚不会禅。\n有拳爷不识，有口佛不吞。\n惟康第一莫学他，学他陷汝到黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞 其一","author":"释道璨","text":"声以眼闻，色以耳见。\n下与众生同一悲仰，上与诸佛同一悲愿。\n大海枯，磐石烂，我此大心方了办。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过舅氏宅","author":"释道璨","text":"墙头杨柳老无枝，门外新泥淤旧泥。\n因看儿童骑竹马，忆曾随母北归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴太清有远役以诗寄别次韵","author":"释道璨","text":"宇宙入八窗，芙蓉制衣裳。\n两眼挂万古，深柱书传香。\n笔端肤寸合，要作天下凉。\n馀事亦演雅，簸弄正未妨。\n颠倒走百怪，陆离罗众芳。\n气焰压牛斗，何止万丈光。\n笑他儿女曹，白道空茫茫。\n秋风三尺剑，尘土压下方。\n斫却月中桂，及此鬓未苍。\n我欲援北斗，酌以椒桂浆。\n文章于此道，太山一毫芒。\n洙泗到伊洛，波澜正泱泱。\n多少溯流人，褰裳复回翔。\n孰知方寸间，一苇直可航。\n勉哉吴夫子，此事当毋忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":21257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]