[{"title":"送王秀才下第随侍东去","author":"宋庠","text":"春色乡枌老，波声客棹催。\n林乌贪夕哺，都鹢怨风摧。\n处晦囊中颖，加餐案上杯。\n重来期岁晏，飞藻右邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送令狐揆南游","author":"宋庠","text":"楚泽离愁不避春，柳梢梅萼送行人。\n绿波易荡销魂水，紫陌难遮拂面尘。\n道困秦仪犹掉舌，歧多杨阮始沾巾。\n剑缑髀肉无穷恨，羞向耕畴独问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送外门朱秀才见访都下却归安陆旧隐","author":"宋庠","text":"白发游梁晚，青山念楚归。\n魂销虽得别，战胜却成肥。\n障日都门盖，迎烟涧路衣。\n试寻南圃树，今长几多围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送石舍人赐告还乡","author":"宋庠","text":"内史清班近侍臣，过家恩告曰俞新。\n邮中别夜星催晓，殿里归年树约春。\n几日词垣栖健笔，九秋朝橐冒征尘。\n西州归马欢迎处，定有临邛负弩人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送龙图燕待制出守梓潼","author":"宋庠","text":"宝构沈沈夕雾迷，儒林俊老出分麾。\n中天秘牒河龙负，上路鸣铙笮马驰。\n香袭宠鞶惊放兽，野连丰芋蔽蹲鸱。\n潼江肯学淮阳卧，仙液真腴壮寿祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙记堂出宰归安","author":"宋庠","text":"当年璧马上荆台，曾识长离婉婉来。\n巧智忍随司马宦，沈酣终屈广都才。\n莼鲈荐俎朝丰馔，稻蟹藏波岁绝灾。\n乡梓汀蘋鸡犬地，孙郎藻思若为裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送孙刑部领漕并部","author":"宋庠","text":"百舍星文动使轩，汉家初赐办装钱。\n犀株卫帐并儿勇，鹄发迎涂绛老贤。\n岁稔万箱资转粟，时平三策罢开边。\n中宸图旧恩方渥，几日从容武帐前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送安陆朱通判赴召兼过许田别墅","author":"宋庠","text":"绿绨珍检九天来，绶笥腾装拂簿埃。\n铃阁饯歌鹍瑟怨，璧田仙里驷门开。\n厨书久汗南山竹，征袂浓薰北使梅。\n岁晚林光催奉计，五云城阙倚瑶魁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送庆州安化元处宗主簿","author":"宋庠","text":"黄绶荣新牒，华颠惜美材。\n越心枝上远，羌思笛中来。\n烽烬和星落，刀环伴月开。\n寄言栖棘地，鸾翮少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送廷评沈先辈宰江山兼过吉席","author":"宋庠","text":"东阳世系出翘英，刮目神肤两共清。\n洛纸文雄钱万选，郤堂科美佛千名。\n春风适馆仙軿密，海曲夸乡县绶轻。\n上最三年归路稳，中阿芳意满菁菁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送齐进士奉章阙下","author":"宋庠","text":"倾坐仙姿掩石麟，奉章车府应观宾。\n谢庭早占芝兰族，禹会初陪玉帛臣。\n削牍西清催笔距，赐衣中禁换袍银。\n东归待看荣乡品，年似终童禄及亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送伯中尚书学士归阙","author":"宋庠","text":"故人同省复同班，且喜先归奉帝銮。\n居守乍抛留宅钥，造朝重拂宝梁冠。\n仙楹夕霭通飙驭，秘庑晨晖转露盘。\n我有寸心空恋主，扪膺难把向君看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送馀姚顾尉","author":"宋庠","text":"昔意青霞远，新恩黄绶荣。\n官同吴市隐，赋压楚乡平。\n天霁晨帆驶，潮回夜艑轻。\n千岩胜游近，且莫弃尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李秘校赴太平法掾","author":"宋庠","text":"沈臂惊秋肉减分，晓波衰柳对离群。\n臣饥枉索中都米，卿事犹参下国军。\n三袭赋台抛苑雪，一廛乡树辨江云。\n坐曹少茹徒劳叹，南阙干霄迟献文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏寺丞宰广德","author":"宋庠","text":"早捧诸侯檄，新登九列丞。\n庇身聊制锦，受命更怀冰。\n浦药薰行棹，江禾压翠塍。\n高楼如可望，西北一长凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宗弟秘校壬赴建州理掾","author":"宋庠","text":"补吏唐资浅，游方汉牒遥。\n贪荣亲及禄，讵悔俊沈僚。\n葛咏同根庇，松期晚岁凋。\n曾孙柔俗美，前识缿筒销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送明州章从事","author":"宋庠","text":"东国有嘉招，归心越绝遥。\n几程淮蚌月，一信海鳅潮。\n莲渚熏谈席，霞天认赋标。\n时平军版息，丽藻入云谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苗郎中出漕江西","author":"宋庠","text":"几夕烧熏歇被绫，东南使部望前旌。\n武泥给板言如綍，汉庾临波粟似京。\n露橘千头丰岁籍，江鲈百尾饫盘鲭。\n计筹暂尔烦经画，囊橐行看用老成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送英州理掾朱舅","author":"宋庠","text":"远补参卿掾，来过乞墅甥。\n秋悲先雁引，晓涕伴参横。\n薏子期蠲疾，梅花幸寄声。\n片言无异俗，阴德在乡闳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送两浙转运道卿学士二首 其二","author":"宋庠","text":"新岁邮中问，残冬湖外书。\n欢同烹鲤日，情是断金馀。\n泽节行台峻，天垣右席虚。\n不应周吏课，朝绂企归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送两浙转运道卿学士二首 其一","author":"宋庠","text":"彼美闺台彦，胡为江海行。\n真贪子舍养，不厌使轺轻。\n茂草姑苏苑，苍山越绝城。\n莫因羊酪味，终拟笑诸伧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送将作监丞张唐卿通理陕州","author":"宋庠","text":"春风秘殿翳华芝，亲见枚皋作赋时。\n秀色并开棠树萼，隽科先赏桂林枝。\n汉邮给传蕃恩告，蜀醑浮觞荐寿祺。\n几日陕郊迎郡副，车前悬弩杂军麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送总阁学士守秦亭二首 其二","author":"宋庠","text":"绿图层阁倚昭回，瑞鴳惊飞诏押开。\n关内赵张人续誉，禁中颇牧帝怜才。\n垂鞶虎绶朝装出，夹毂蛇矛使仗来。\n坐镇平时文檄简，赤囊边琐有轻埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送贵溪尉周懿文","author":"宋庠","text":"津亭理棹拂朝霞，试补东溪县道赊。\n旅突倦供樵客桂，官符贪及戍时瓜。\n蟾生海岸空弦湿，天倚山城一盖斜。\n岁晚私书无惮数，轻邮不禁岭头花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵奉礼","author":"宋庠","text":"日出东郊郢路分，斑骓嘶断怅离群。\n汉庭习蕝仙曹远，楚驿攀梅使绶薰。\n蚁酎百壶凝桂溢，鹄歌三阕转珠闻。\n登临如赋兰台事，十二峰前尽有云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送晏延平宰邑分宁兼过乡墅","author":"宋庠","text":"铜纽腰新绶，乌衣省故庐。\n乡无夜行谚，楹有世藏书。\n楚潦兰浮楫，潘园板御舆。\n蚩蚩吴俗美，庖刃一投虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送资政侍读侍郎西赴陕郊","author":"宋庠","text":"君欲归休未得休，再持符节定西侯。\n深严殿籍恩图旧，蔽芾棠歌野续讴。\n洛浦神仙观送客，崤陵风雨避传驺。\n高怀莫作衰年调，公府重来尚黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送高邮叶尉","author":"宋庠","text":"佛塔千名榜，铨台再调符。\n空登拔萃目，未免没阶趋。\n爨桂方辞洛，羹莼尚及吴。\n振淹知孔迩，华萼映鸿都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送巢县梅主簿","author":"宋庠","text":"吴邑神仙系，梁台英俊游。\n官从鸾棘试，材俟蚁封求。\n堂桂叨联籍，陔兰庆奉羞。\n行行离恨苦，淮月一弦秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送巢邑孙簿兼过江南家墅","author":"宋庠","text":"楚客才多不奈秋，长安赴集苦淹留。\n半纶绶采缁尘化，十幅帆阴素潦收。\n离恨枉能宽带眼，归期犹喜咏刀头。\n督租勾簿真沈俊，终冀梁台一召邹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送常熟钱尉","author":"宋庠","text":"吏最三年集，僚英一尉沈。\n清壶人映玉，勋券庙藏金。\n夕馆淮蟾度，春篙楚汰深。\n王孙情几许，芳草遍天浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"宋庠","text":"飞锡眷瑶琴，行行望海阴。\n香花上都供，猿鸟故岩心。\n午钵凝斋剂，晨舟载梵音。\n庭柯旧桂子，依约半春林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送职方张员外领荆湖北漕","author":"宋庠","text":"粉闼仙郎鬓未秋，懿文精力允佥求。\n新荣亳忌祠神馆，更按乔卿露冕州。\n楚匦贡茅纷骑置，蜀艘移粟蔽江流。\n富人缓役承平士，肯学研桑苦运筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄秀才归淮西","author":"宋庠","text":"骊驹黄鹄两成歌，即席愁颜惨未酡。\n旧客仙坛红绕杏，怨魂春水绿生波。\n缔交英域银袍丽，宴族诗庭玉树多。\n简牍三千行自鬻，汉家鳌阙郁嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄昱赴太平州理掾","author":"宋庠","text":"闽录家声茂，唐铨吏格平。\n新资掾三语，旧榜佛千名。\n月苦乡魂极，春寒酒意轻。\n高材难偶俗，慎勿对参卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送紫微夏舍人徙治洪州","author":"宋庠","text":"方底丁宁细札书，豫章都会冠全吴。\n垂腰三品龟衔绶，卫帐千兵虎刻符。\n药省树翻抛赐笔，练江波静见还珠。\n西山五色多仙饵，铃阁无声道有腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舒州怀宁尉孙景先省严亲后赴职","author":"宋庠","text":"乡书曾擅秀，父任此为郎。\n却捧三铨檄，归称百岁觞。\n淮山瞻晓堠，皖浦转春樯。\n无累徒劳叹，廉车伫荐章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蒋御史领江东运使","author":"宋庠","text":"几日都亭避宪骢，使台分节按江东。\n朝端旧简飞霜白，关外连艘饷粟红。\n晨鼓叠喧鸡埭月，暝帆遥卸雀桁风。\n先秋若有离怀咏，剩取芳筠作信筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢沂进士","author":"宋庠","text":"坦床仙格照琼筵，归待兰陔补逸篇。\n别路云霞交友阔，庆门酥酪弟兄贤。\n春郊送目车流水，夕馆迷魂月上弦。\n续食定知西笑近，马生词赋贾生年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢煜赴无为主簿","author":"宋庠","text":"怀檄倦游都，劳劳舣客舻。\n秋渠沿莨荡，春坞见濡须。\n秫齐添宾酌，兰苕入养厨。\n明年献文地，南阙倚星榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送集贤盛谏议出牧维扬","author":"宋庠","text":"江海多年滞轼熊，书林谏霤得儒宗。\n宽条一劄仙泥熟，慈宴千觞湛露浓。\n迎舸蔽川交画鹢，队笳横浦细吟龙。\n轻扬俗改方图旧，两马行催诏传封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送颍阴张主簿","author":"宋庠","text":"早服英雄彀，胡为州县劳。\n荆璆不自鬻，郢雪向谁高。\n月鼓千声叠，霜风万窍号。\n行行星聚国，芳尺慰同袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送殿丞杨备通理睦州","author":"宋庠","text":"引籍淹闺序，监州得海壖。\n贪随涛鹭驿，倦趁火城天。\n织纻吴侬富，垂纶汉客贤。\n遥知怀我处，霜月暝楼边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送虞部杨员外出牧池州","author":"宋庠","text":"郎署新闻一进阶，汉家临遣重州台。\n人持泽节龙形出，路建风旟隼翼开。\n千顷江禾年有瑞，万盆吴茧俗丰财。\n吟窗剩赏云峰翠，即是踰期报政回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谭秘校赴江陵理曹掾先过衡阳别墅","author":"宋庠","text":"吾彀飞名早，卿军补掾新。\n还家雁峰地，趋府鹤袍人。\n树色围荆垒，江声泻蜀津。\n无轻束矢讼，阴德及斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送静海高簿","author":"宋庠","text":"城阙曙乌啼，行人叹解携。\n旧欢苹鹿散，新意棘鸾栖。\n淮月涵孤蚌，江云杂断霓。\n漉沙应搆赋，春澥正平堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观春物有感","author":"宋庠","text":"河桥烟北寂寥城，山圃虽春气尚清。\n戏蝶有时飞自远，野禽终日语无情。\n露痕浥浥添花重，风意沾沾助絮轻。\n看遍物华还自看，乾坤同是一浮生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃观稻","author":"宋庠","text":"谁取霜禾种，来依郡圃栽。\n芒随虎掌熟，畦作佛袍开。\n自应蝉鸣候，应无蟹齧灾。\n公庖丰甑饭，知免拾颜煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃洗心亭宴坐对春物因书所见","author":"宋庠","text":"尽昼山楹坐，居然外物身。\n野葵能向日，怖鸽解投人。\n万萼融朱蜡，平芜识绀茵。\n须知无事处，堪养不才臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃秋日二首 其二","author":"宋庠","text":"累榭孤城侧，空陂八月凉。\n高云收雨意，淡日作秋光。\n叶落风蝉坞，巢空社燕梁。\n变衰从此始，何术奈群芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃秋日二首 其一","author":"宋庠","text":"闰去秋归早，开轩洒病襟。\n晓风凌羽扇，商气袭瑶琴。\n竹雨无情碧，荷烟底事深。\n萧萧差可赏，只是恨年深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡圃海棠初开追忆学士院玉堂后西轩此花最盛置酒有感","author":"宋庠","text":"昔作瀛洲赏，今逢汶水春。\n可怜无并色，来对始衰人。\n温树遥知汉，仙桃尚记秦。\n临樽如旧识，争忍判芳辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡斋无讼春物寂然书所见","author":"宋庠","text":"阁铃无响昼辉迟，短发山巾尽日攲。\n战蚁群行开蛰后，暝禽相语欲栖时。\n遥通窦水添新溜，密数庭花记落枝。\n讼息宽条恩莫报，晚年馀有白云期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重展西湖二首 其二","author":"宋庠","text":"西北云波逗异津，两陂相合到城闉。\n桥横断岸才通舫，路转新洲不踏尘。\n倒影剩容霞底日，暖光平展鉴中春。\n摧颓病守时无用，堪与鸥鹇作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重展西湖二首 其一","author":"宋庠","text":"绿鸭东陂已可怜，更因云窦注西田。\n凿开鱼鸟忘情地，展尽江河极目天。\n向夕旧滩都浸月，过寒新树便留烟。\n使君直欲称渔叟，愿赐閒州不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻安道舍为邻火所焚","author":"宋庠","text":"里旅闻遗燎，连甍委夕煨。\n初无徙薪智，枉被及鱼灾。\n勺水宁堪救，三车谅未摧。\n天知君自足，聊复寄灵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻胡明远记室将至","author":"宋庠","text":"昔叹都门别，今闻陇坂还。\n风烟背秦塞，陵邑过周关。\n松老忘年契，朱衰玩日颜。\n须君述征赋，方验此涂艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"候月台","author":"宋庠","text":"平昔词林伯，尝为右辅来。\n庾公偏爱月，薛县未倾台。\n镵石云根断，临波水腹开。\n良宵时弭盖，方信谢庄才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌景阳寺丞与韩综监簿蔡襄秀才雪夕会饮联诗数十韵以相示因成诗句","author":"宋庠","text":"岁籥愁云暮，朋簪夕宴开。\n贤如颍川聚，兴是剡溪来。\n泻酒蟾波溜，雕章烛刻催。\n三英知绝拟，况复是平台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭子正直讲","author":"宋庠","text":"頍弁王门客，横经胄席师。\n频扬四巡颂，屡析六身疑。\n寂寞终嘲白，侏儒讵信饥。\n一朝嗟溘尽，福善亦予欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夕雨霁","author":"宋庠","text":"积晦连空卷，繁蒸此夜收。\n峰催云去夏，圭伴月迎秋。\n树老残烟入，庭虚爽气留。\n长康惟半黠，孤咏费冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恩忝西掖垣","author":"宋庠","text":"贤路尘消箧谤残，萧萧衰鬓得生还。\n久叨鸱尾三重阁，却趁蛾眉五日班。\n伤翼再来仍绕树，行云何处不思山。\n坐挥拙笔无文甚，正被中郎笑拙艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋中焚香宴坐","author":"宋庠","text":"耳界千声外，炉薰一室中。\n妙心那有住，真意本无空。\n香饭凝盂白，天花蔽席红。\n閒观色身相，方信幻人工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋居有感","author":"宋庠","text":"气逐薰弦动，春随毕雨残。\n蠹桃攲废井，新李碍游冠。\n处晦垂辕骥，干时上坂丸。\n无人怜仲叔，平日忆猪肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晏岁","author":"宋庠","text":"晏岁无情晚，阴飙昨夜闻。\n芳条临槛劲，短日转楼曛。\n苔石收苍晕，冰溪叠素纹。\n蒿兰虽异种，霜至若为分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓入謻门趋殿中马上作","author":"宋庠","text":"钥出驰宫路，更馀送晓筹。\n露盘先得日，温树未知秋。\n烟幕昏朱里，风旂飏綵斿。\n鸣鞘历宣室，应为□神休。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]