[{"title":"贵溪道中四绝 其一","author":"郑刚中","text":"人见寒云冻欲垂，喧呼争愿玉花飞。\n谁知万里征途上，季子囊中未有衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵元信近来得小鬟歌曲便须熟寐此还是有所得否予戏成此偈","author":"郑刚中","text":"清歌声里便高眠，古老诗中借一联。\n猿抱子归青嶂里，鸟啼花落碧岩前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵知监惠牡丹二首 其二","author":"郑刚中","text":"远冲岚雾香如故，再照春阳色转红。\n亲手满瓶添净水，一时回献梵王宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵知监惠牡丹二首 其一","author":"郑刚中","text":"太守分花春满盘，谓从郴岭剪来看。\n恩宽罪大方流涕，渠敢伸眉向牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何元英出峡三绝 其三","author":"郑刚中","text":"壮士椎牛进酒卮，五年不享鲙鲈肥。\n君如亦有垂涎兴，准备轻蓑随我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送何元英出峡三绝 其一","author":"郑刚中","text":"呼儿携妇裹书编，月色滩声共一船。\n回首已游三峡水，此行那不谓登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送季平道中四绝 其二","author":"郑刚中","text":"与君今夜宿邮亭，迟晓东西各去程。\n记取短桥携手处，明朝都似梦初惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送季平道中四绝 其三","author":"郑刚中","text":"田夫击鼓祀田神，盘案相呼尽欲醺。\n我愿四郊无犬吠，常令此辈乐耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送季平道中四绝 其一","author":"郑刚中","text":"霜风落叶小寒天，去客依依马不鞭。\n我最平生苦离别，可能相送不悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送季平道中四绝 其四","author":"郑刚中","text":"野蝶成团夹路飞，秋郊此景最佳时。\n寒梨霜杮浑无叶，绿橘黄橙半压枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻百舌","author":"郑刚中","text":"圆吭百舌语千般，岂是春来不耐闲。\n为见幽人无与语，故来相对作闲关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骨肉闻已至广安而连日有雨甚念之戏成绝句","author":"郑刚中","text":"行人未到雨潇潇，最苦酴醾叶尽飘。\n风雨不遮春去路，障泥空滞马蹄骄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栽竹种红蕉后数日阻雨不见赋小诗","author":"郑刚中","text":"瘦竹犯寒扶直节，蕉花垂老抱丹心。\n小园半月隔风雨，搔首相望空苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桂阳本觉院以屯将兵住持舜长老于前山松竹深处结草庵居之求诗拟而不与","author":"郑刚中","text":"咫尺楼台是上方，问师何事此中藏。\n解颐谓我随缘好，不欠中庭一炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌霪雨踰月负郭皆浸祷祠之后仓廪保全居民复业运使国博喜而赋诗辄成三绝句以报来贶 其一","author":"郑刚中","text":"一月山前雨带风，拍天江水涨惊洪。\n朝来莫怪波澜静，收向诗翁笔势中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌霪雨踰月负郭皆浸祷祠之后仓廪保全居民复业运使国博喜而赋诗辄成三绝句以报来贶 其三","author":"郑刚中","text":"朝廷德泽遍封畿，避水人家即日归。\n独愧因漂如木偶，未还田舍理柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"益昌霪雨踰月负郭皆浸祷祠之后仓廪保全居民复业运使国博喜而赋诗辄成三绝句以报来贶 其二","author":"郑刚中","text":"千仓积粟栋崔嵬，夜浸洪流亦殆哉。\n不是脂膏天所惜，岂应水到却平回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"离家","author":"郑刚中","text":"我有君恩未报身，勿因云出念行人。\n闭帘小閤团团坐，尔辈何妨暖到春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荷花","author":"郑刚中","text":"美艳向人花灼灼，青圆如鉴叶田田。\n月明徙倚阑干处，细得真香忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34244,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诸暨道中遇雪","author":"郑刚中","text":"乱花催腊舞江干，村酒沽来岂问酸。\n仙女云间休剪水，孤松岭上不知寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34245,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读兰台诗","author":"郑刚中","text":"天遣长庚下碧空，再将太白作坡翁。\n不然安得四十九，还宿浔阳太极宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34246,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读光明经舍身品","author":"郑刚中","text":"摩诃萨埵真奇特，虎口捐身资福德。\n却有同时畏避人，后来亦自成弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34247,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒尽","author":"郑刚中","text":"落花无夜雨，孤坐减春愁。\n黑白瓶俱罄，谁能为我谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34248,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高补之十月旦生朝一绝","author":"郑刚中","text":"明光览赋为终篇，政恐前身是汉贤。\n何似高门挂弧矢，汉家此日恰新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34249,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"郑刚中","text":"身名蹭蹬原无况，杯酒流行强自宽。\n夜半穷阎闭梅雨，昏昏灯火泪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34250,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"郑刚中","text":"芭蕉嫩绿小开叶，茉莉香幽疏著花。\n虽设柴门多避客，如今端的似僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34251,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"郑刚中","text":"未抱床头酒瓮乾，莫来楼上倚阑干。\n浓云垂地捲不起，细草连天都是寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34252,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶成","author":"郑刚中","text":"乱寻花木傍山栽，虽有柴门未必开。\n过眼利名休挽我，年来心地已如灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34253,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题窗间","author":"郑刚中","text":"一骑山行岂是侯，霸陵要自莫呵休。\n蒙恩君欲知轻重，曾督坤维六十州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34254,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿长芦寺下四绝 其三","author":"郑刚中","text":"建邺春江水拍天，趁潮先发六宫船。\n何时彤笔严清禁，缥缈金铺生瑞烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34255,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿长芦寺下四绝 其一","author":"郑刚中","text":"北风吹水拍船头，晚泊长芦祗欲愁。\n试遣长髯伺烟际，望中李郭亦来不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34256,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿长芦寺下四绝 其二","author":"郑刚中","text":"来帆风饱自行快，去桨浪高知进难。\n舟子勿生淹泊恨，偶然迟速我殊安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34257,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿长芦寺下四绝 其四","author":"郑刚中","text":"风伯清尘过浙西，随春万骑拥旌旗。\n野人不识巡方意，警跸还忧为虏移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34258,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿撞抗刘家店","author":"郑刚中","text":"虺尵老马踏深泥，投宿村坊灯火微。\n休问客衣何似冷，床前犹有雪花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34259,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿鹤岩二绝 其一","author":"郑刚中","text":"巍然山骨自天成，上与穹苍斗极平。\n安得衲衣烧柏子，不闻山下是非声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34260,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿鹤岩二绝 其二","author":"郑刚中","text":"岩头一望万家低，已觉尘寰不整齐。\n此祗人间最高处，况游物外照群迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34261,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴信叟","author":"郑刚中","text":"闻说吴郎入汉中，扫除亭榭祝东风。\n三年不与故人醉，留取数枝桃杏红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34262,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"郑刚中","text":"默坐观书久不言，为梅驱我到诗边。\n月明孤影瘦如画，晓起数枝清欲仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34263,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"郑刚中","text":"拟求冰雪向刘叉，琢作方壶不带霞。\n要把露华和月贮，将归书室浸梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34264,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花三绝 其三","author":"郑刚中","text":"水边寂寞一枝梅，君谓高标好似谁。\n洁白不甘芜秽没，屈原孤立佩兰时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花三绝 其一","author":"郑刚中","text":"温温玉质傲天贞，俯视凡花出后尘。\n静对寒林守孤寂，有颜氏子独甘贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花三绝 其二","author":"郑刚中","text":"树老根危雪满巅，令人颇忆鲁公贤。\n同时柔脆皆僵仆，正色清芬独凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明前十日大雪二首 其二","author":"郑刚中","text":"南山春晏蕨生芽，怪得清寒数倍加。\n一雪洗将红紫去，高低林树试瑶花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清明前十日大雪二首 其一","author":"郑刚中","text":"五花素色逼窗檐，纸帐重将布被添。\n天为韶阳太妖冶，故令剪水作清严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移司道中四绝 其二","author":"郑刚中","text":"鱼惊鼓吹寒犹出，乌避旌旗去肯留。\n顾我才疏何所用，空将行李慁清幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移司道中四绝 其四","author":"郑刚中","text":"随车千骑铁成围，诸将前驱辨鼓旗。\n不似东阳村舍畔，芒鞋踏雨看山时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移司道中四绝 其一","author":"郑刚中","text":"危梯破雪入河池，今日还辕岁一期。\n道是得归元未是，却移边角利州吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿净轩","author":"郑刚中","text":"小小轩窗冷逼人，竹无俗韵水无尘。\n正如芦苇潇湘浦，不见樊然花柳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翌日赵守转以酴醾惠予用前韵谢之 其二","author":"郑刚中","text":"染露檀心嫌粉白，数花欲作鹅儿色。\n圃中不为客分春，使君自有分春力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花","author":"郑刚中","text":"露染黄金一样圆，风来香在短篱边。\n虽然不解将春买，未与痴人当赌钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萧山老儒余志宁求拙庵诗为赋之","author":"郑刚中","text":"纸窗竹屋闭幽深，古木檐头对好阴。\n大巧家风祗如此，世人何苦用机心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"随凤翔有何日在堤霜后路乱飞榆柳踏平沙之句今至堤上复用前韵","author":"郑刚中","text":"沐雨抗尘几万里，劳生令我忆山家。\n秋风小艇浮棋局，野色侵帘水见沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中度冯公岭二绝 其一","author":"郑刚中","text":"雪积云腾昼杳冥，万山玉立不胜清。\n举头祗恐是尺五，松柏已为环佩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中度冯公岭二绝 其二","author":"郑刚中","text":"琪花风乱欲成团，度岭人言路已漫。\n我斥征夫第前迈，山翁不畏雪霜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后观月","author":"郑刚中","text":"风高天阔净无尘，万瓦生光冷射人。\n不见晓来迷晚雪，但看霜月益精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸿沟","author":"郑刚中","text":"天下共知归汉德，东西那可限鸿沟。\n虽令羽割大河水，分得人心两处不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸿渐后宦游广中有诗云不羡黄金盏不羡白玉杯不羡朝入省不羡暮入台千羡万羡长江水曾向章华亭下来予自章台谪广右荆渚间巡尉督迫良遽窃赋小诗","author":"郑刚中","text":"自讼缧囚深负罪，不须醉尉苦相催。\n有如陆羽须惊羡，我向章华亭下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅经干以所业一编出示戏赠一绝","author":"郑刚中","text":"万里一身同影到，自馀无物与偕来。\n箧中骤富人休怪，新得明珠十一枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅推官劝农七绝句拟和其五 山家","author":"郑刚中","text":"蓬蒿深处有人家，户外蛛丝网露华。\n数树芭蕉乾未得，长官亲自见生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅推官劝农七绝句拟和其五 劝农回","author":"郑刚中","text":"五马萧萧不醉归，祗从阡陌捲旌旗。\n今朝故为劝农出，未与诸君泛酒池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅推官劝农七绝句拟和其五 出郭","author":"郑刚中","text":"偶因官事出郊坰，更向春时得好晴。\n山鸟自应知客意，不须相背苦飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅推官劝农七绝句拟和其五 田父","author":"郑刚中","text":"老人听读劝农章，扶杖兴言意味长。\n但愿门前少呼唤，自然工力到耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅推官劝农七绝句拟和其五 登岭","author":"郑刚中","text":"一握天边两角云，岭头都见岭南春。\n莫怀小鲁东山意，祗是早来平地人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食日","author":"郑刚中","text":"休日文书得少闲，试寻高处凭阑干。\n落花芳草不胜恨，细雨斜风都是寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"就寝","author":"郑刚中","text":"夜坐苍颜得酒红，困来头重触屏风。\n径趋布被灯花落，梦在春寒细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡胡源口二绝 其二","author":"郑刚中","text":"梨枣迎霜压树黄，盖茅新屋渐成行。\n人情喜见兵戈息，路上时闻酒瓮香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡胡源口二绝 其一","author":"郑刚中","text":"暂出箯舆上小航，眼明重喜见江乡。\n梦魂孤寄浪头宿，一夜随潮入富阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登乌奴","author":"郑刚中","text":"金壶皤腹贮春醪，路入山堂脚脚高。\n但得远尘宽俗鞅，不须临下见秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前种小梅树今年未著花但春来绿阴乱眼每过之必徘徊注视冀叶间或青圆如豆也成二十八言","author":"郑刚中","text":"水边移得竹边栽，树小条新花未开。\n绿叶参差须细看，尚疑低处有青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窘匮中复大雨殊忧闷闻诸僮聚食笑语为赋一绝","author":"郑刚中","text":"建瓴败屋方倾雨，垂罄空囊正念饥。\n渐见炊烟多笑语，可怜僮仆太无知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊梅","author":"郑刚中","text":"缟衣仙子变新装，浅染春前一样黄。\n不肯皎然争腊雪，只将孤艳付幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中四绝 其四","author":"郑刚中","text":"寒意无多晓色交，云随疏雨又还消。\n山行全似三春日，林际一声婆饼焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中四绝 其二","author":"郑刚中","text":"水渌沙明不见泥，寒烟漠漠树垂垂。\n渔人不识闲中趣，辍网咨嗟望使旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中四绝 其三","author":"郑刚中","text":"败箧冲霜思往岁，旧游如梦慨平生。\n鬓华已逐心事老，溪水祗如前日清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道中四绝 其一","author":"郑刚中","text":"过雨山间云出没，夕阳天际鸟浮沈。\n男儿马上志四海，不是寻常客子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道旁赠梅花","author":"郑刚中","text":"一枝横出小桥东，凡木旁边迥不同。\n未肯临风吐香粉，先将蓓蕾试轻红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":34301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]